-------------------------------------------------------------------------------
  adamtest.adam - The program module of adamtest.exe, Adam's test runner

  Named adamtest because the exe takes the main module's name. It hands
  the command line to Adam.Testbed.Runner and ends the process with its
  exit code (RunTests returns first, so every object it made is released).
*******************************************************************************/

module exe adamtest;

// Adam's own std (bin\res\libs\std) and the compiler's units (src\: the runner reads a test
// with Adam's own lexer): $R: is the project root (projects\adamtest, the folder holding
// project.toml), so the build works from any folder. adam.exe finds the std beside itself
// on its own; the line is for pcpp, which builds the generated copy until PLAN-SELFHOST S6z
@addmodulepath "$R:../../bin/res/libs/std";
@addmodulepath "$R:../../src";

import System.Runtime, Adam.Testbed.Runner;

begin
  Halt(RunTests());
end.
