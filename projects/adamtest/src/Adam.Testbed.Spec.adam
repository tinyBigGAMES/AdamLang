  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  Adam.Testbed.Spec.adam - A test file's spec: its @@test block and its
  report markers

  The form is PaskalCPP's (ref\testsuite.md), cut to what Adam runs today:

    one @@test ... @@end inside a block comment, each first on its line
    (prose that names them is no block), then a line each:
      kind check | error | cli | run | dep | manual
                                 required: check = adam check reports no
                                 error (exit 0); error = its markers say
                                 which reports come (exit 1); cli = adam
                                 run with args, output and exit code
                                 compared; run = adam build reports no
                                 error (exit 0, its reports checked as
                                 check's), then the exe it wrote is run
                                 with args, output and exit code compared;
                                 dep = built as run builds, only as
                                 another test's dependency (never picked,
                                 run or counted on its own); manual = a
                                 file a person checks by hand in the
                                 editor (the language server's features,
                                 its steps in its comments): listed by
                                 -list, never run (PaskalCPP's); its
                                 markers say what the editor shows, it
                                 takes no other key
      deps id id ...             the ids of run or dep tests built into
                                 the output root before this test runs,
                                 their own deps first (a cli test's adam
                                 then finds what they built: their .acu)
                                 (PaskalCPP's deps; the graph's mistakes
                                 are TR codes, before anything runs)
      args "a" "b"               cli / run only: adam's (cli) or the exe's
                                 (run) arguments, quoted (\" and \\
                                 inside); <DIR> = the test's folder
                                 (an x86_64-linux-gnu program's own
                                 name for it), <SRC> = that folder as
                                 adam names it in what it compiles (a
                                 source place a program prints),
                                 <BIN> = the adam.exe's folder,
                                 <OUT> = the output root,
                                 <SYS> = the system DLL folder the
                                 linker searches,
                                 <CELL> = the run cell, <triple>/<mode>
                                 (a build's exe: <OUT>/bin/<CELL>/),
                                 <ADAM> = the adam exe run (-adam)
      exitcode N                 cli / run only (default 0)
      levels debug safe ...      run only: the optimization levels the
                                 test is built at (adam build -opt
                                 <level>, each in its own cell) and run
                                 at, one expect for all (none: one build
                                 with no -opt, the debug cell)
      targets <triple> ...       run only: the targets the test is built
                                 for (adam build -t <triple>) and run on,
                                 each in its own cell, in order, one
                                 expect for all (none: x86_64-windows-gnu
                                 alone, no -t); x86_64-windows-gnu and
                                 x86_64-linux-gnu, each once; a target
                                 whose programs this host cannot run
                                 (x86_64-linux-gnu on Windows with no WSL)
                                 is built and not run: said under the
                                 test's PASS, never a fail
      runs <triple> ...          run / cli only: the test's own program
                                 (a cli test's adam: build -r) runs
                                 programs of these targets (System.Process'
                                 RunELF for x86_64-linux-gnu), the triples
                                 as targets takes them; on a host that
                                 cannot run one the test is not run: said
                                 under its PASS, never a fail
      warnings allow             an unmarked hint or warning passes
      | text                     cli / run only: one expected output line
                                 (<ADAM>, <DIR>, <SRC>, <BIN>, <OUT>, <SYS>,
                                 <CELL> as in args)
      ir| text                   run only: the test is built with
      ir <level>| text           --emit-ir, and its .ir (beside the exe)
                                 must hold the line, the ir lines found
                                 in their order (each after the one
                                 before: two equal ir lines are two
                                 .ir lines); a line matches the .ir's
                                 line whole or its text before the
                                 "  ; place" Dump puts after it, the
                                 blanks around each left out; <NUM>
                                 matches any decimal number (an id
                                 that moves: f<NUM>); with a
                                 level, only that level's build is
                                 checked (one the test is built at)
      -- note                    ignored

    report markers, in a line comment: LEVEL CODE[@column][: text], LEVEL
    one of HINT, WARN, ERROR, FATAL, several per comment (each after its
    own //), on the line the report is at; or in a block comment whose text
    starts with //, for a line no line comment can end

  Comments are found with Adam's own lexer: the bytes between two tokens
  are blanks and comments only, so a line or block comment opener there
  opens a comment and never one inside a string. The lexer's own reports
  are the test's business (adam check reports them), so they are kept
  apart and dropped.

  Every mistake in a spec is one report at the mistake (TB codes).
*******************************************************************************/

module unit Adam.Testbed.Spec;

import System.SysUtils, Adam.Core.Common, Adam.Core.Messages, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics, Adam.Compiler.Lexer;

public const
  ADAM_ERR_TESTBED_001: string = "TB0001";   // no @@test block
  ADAM_ERR_TESTBED_002: string = "TB0002";   // a second @@test block
  ADAM_ERR_TESTBED_003: string = "TB0003";   // a @@test block with no @@end in its comment
  ADAM_ERR_TESTBED_004: string = "TB0004";   // a key the spec does not know
  ADAM_ERR_TESTBED_005: string = "TB0005";   // no kind, or a kind that is none
  ADAM_ERR_TESTBED_006: string = "TB0006";   // a key the test's kind does not take
  ADAM_ERR_TESTBED_007: string = "TB0007";   // a value its key does not take
  ADAM_ERR_TESTBED_008: string = "TB0008";   // a key given twice
  ADAM_ERR_TESTBED_009: string = "TB0009";   // a malformed report marker
  ADAM_ERR_TESTBED_010: string = "TB0010";   // markers the test's kind does not allow
  ADAM_ERR_TESTBED_011: string = "TB0011";   // an ir line's level the test is not built at

const
  // The lexer's own reports are dropped: a budget no test file reaches, so it never stops
  ADAM_TESTBED_LEX_BUDGET: int64 = 1000000;

  // A report code's length: two capitals, four digits (LX0004)
  ADAM_TESTBED_CODE_LENGTH: int64 = 6;

public const
  // The targets a test runs on (a targets line's words): the first is every test's when its
  // spec has no targets line
  ADAM_TESTBED_TRIPLE_WINDOWS: string = "x86_64-windows-gnu";
  ADAM_TESTBED_TRIPLE_LINUX: string = "x86_64-linux-gnu";

public type
  // What a test does with adam (see the header)
  TestKind = choices(Unset, Check, Error, CLI, Run, Dep, Manual);

  // One report a test expects: its level as adam prints it (Diagnostics' words), its code,
  // its line, its column (0 = any) and its text ("" = any)
  ReportMarker = record
    Level: string;
    Code: string;
    Line: int32;
    Column: int32;
    Message: string;
  end;

  ReportMarkerArray = array of ReportMarker;

  // A test file's spec (see the header). DepsLine / DepsColumn: where its deps line is (the
  // runner's graph mistakes are reported there; 1, 1 when it names none). Levels: the levels
  // line's names, each a level's (OptLevelOfName), in order; none when it has no levels line.
  // Targets: the targets line's triples, in order; none when it has no targets line. Runs:
  // the runs line's, the same way.
  // IRExpect: the ir lines' texts in order, IRLevels beside them each one's level name (""
  // for every level the test is built at)
  TestSpec = record
    Kind: TestKind;
    Args: StringArray;
    Levels: StringArray;
    Targets: StringArray;
    Runs: StringArray;
    ExitCode: int32;
    Expect: StringArray;
    IRExpect: StringArray;
    IRLevels: StringArray;
    WarningsAllow: bool;
    Markers: ReportMarkerArray;
    Deps: StringArray;
    DepsLine: int32;
    DepsColumn: int32;
  end;

type
  // One comment found between two tokens: its bytes [StartAt, StopAt)
  FoundComment = record
    StartAt: int64;
    StopAt: int64;
    IsBlock: bool;
  end;

  FoundCommentArray = array of FoundComment;

// The kind as a spec writes it
public func TestKindText(const AKind: TestKind): string;
begin
  if AKind = TestKind.Check then
    return "check";
  end;
  if AKind = TestKind.Error then
    return "error";
  end;
  if AKind = TestKind.CLI then
    return "cli";
  end;
  if AKind = TestKind.Run then
    return "run";
  end;
  if AKind = TestKind.Dep then
    return "dep";
  end;
  if AKind = TestKind.Manual then
    return "manual";
  end;
  return "unset";
end;

// True when ALevel (Diagnostics' words) stops a build: Error or Fatal
public func IsErrorLevel(const ALevel: string): bool;
begin
  return (ALevel = ADAM_MSG_DIAGNOSTICS_ERROR) or (ALevel = ADAM_MSG_DIAGNOSTICS_FATAL);
end;

// Reports one spec mistake (an Error, ACode, ATemplate filled with AArgs) at byte AAt of ASource
func DoReport(const AReports: ref Diagnostics; const ASource: ref SourceText; const AAt: int64;
  const ACode: string; const ATemplate: string; const AArgs: MessageArgs);
begin
  AReports.Add(Severity.Error, ACode, ASource.PlaceOf(AAt), ATemplate, AArgs);
end;

// True when the byte AByte is a decimal digit
func DoIsDigit(const AByte: int64): bool;
begin
  return (AByte >= 0x30) and (AByte <= 0x39);
end;

// True when the byte AByte is a capital letter
func DoIsCapital(const AByte: int64): bool;
begin
  return (AByte >= 0x41) and (AByte <= 0x5A);
end;

// The number of blank bytes (at or below a space) AText starts with
func DoLeadingBlanks(const AText: string): int64;
var
  LI: int64;
begin
  LI := 0;
  while (LI < len(AText)) and (uint8(AText[LI]) <= 0x20) do
    LI := LI + 1;
  end;
  return LI;
end;

// The offset of the first AWord in AText at or after AFrom that starts its line (only blanks
// before it on its line, or AText's start); -1 when there is none. @@test and @@end count only
// there, so prose that names them is never taken for them
func DoIndexOfLineStart(const AWord: string; const AText: string; const AFrom: int64): int64;
var
  LAt: int64;
  LBack: int64;
  LByte: int64;
  LLineStart: bool;
begin
  LAt := IndexOf(AWord, AText, AFrom);
  while LAt >= 0 do
    LLineStart := true;
    LBack := LAt - 1;
    while LLineStart and (LBack >= 0) do
      LByte := int64(uint8(AText[LBack]));
      if (LByte = 0x0A) or (LByte = 0x0D) then
        // Reached the line's start with only blanks passed
        LBack := -1;
      else
        if LByte > 0x20 then
          LLineStart := false;
        end;
        LBack := LBack - 1;
      end;
    end;
    if LLineStart then
      return LAt;
    end;
    LAt := IndexOf(AWord, AText, LAt + 1);
  end;
  return -1;
end;

// Adds the comment [AStart, AStop) to AComments
func DoAddComment(var AComments: FoundCommentArray; const AStart: int64; const AStop: int64;
  const AIsBlock: bool);
var
  LCount: int64;
begin
  LCount := len(AComments);
  setlength(AComments, LCount + 1);
  AComments[LCount].StartAt := AStart;
  AComments[LCount].StopAt := AStop;
  AComments[LCount].IsBlock := AIsBlock;
end;

// The comments in the gap [AStart, AEnd) between two tokens. Only blanks and comments stand
// there (the lexer skipped them), so a // or a /* in it opens a comment. A block comment that
// is not closed (the lexer's LX0003) ends at the gap's end
func DoScanGap(const ASource: ref SourceText; const AStart: int64; const AEnd: int64;
  var AComments: FoundCommentArray);
var
  LAt: int64;
  LStop: int64;
begin
  LAt := AStart;
  while LAt < AEnd do
    if (ASource.ByteAt(LAt) = 0x2F) and (ASource.ByteAt(LAt + 1) = 0x2F) then
      // A line comment runs to its line's end
      LStop := LAt + 2;
      while (LStop < AEnd) and (ASource.ByteAt(LStop) <> 0x0A) and
        (ASource.ByteAt(LStop) <> 0x0D) do
        LStop := LStop + 1;
      end;
      DoAddComment(AComments, LAt, LStop, false);
      LAt := LStop;
    else
      if (ASource.ByteAt(LAt) = 0x2F) and (ASource.ByteAt(LAt + 1) = 0x2A) then
        // A block comment runs past its first '*/' (comments do not nest)
        LStop := LAt + 2;
        while (LStop < AEnd) and
          not ((ASource.ByteAt(LStop) = 0x2A) and (ASource.ByteAt(LStop + 1) = 0x2F)) do
          LStop := LStop + 1;
        end;
        if LStop < AEnd then
          LStop := LStop + 2;
        end;
        DoAddComment(AComments, LAt, LStop, true);
        LAt := LStop;
      else
        LAt := LAt + 1;
      end;
    end;
  end;
end;

// Every comment of ASource, in order: the gaps between its tokens, scanned
func DoFindComments(const ASource: ref SourceText; var AComments: FoundCommentArray);
var
  LReports: ref Diagnostics;
  LLexer: ref Lexer;
  LTokens: TokenList;
  LAt: int64;
  LI: int64;
begin
  setlength(AComments, 0);
  LReports := ref Diagnostics(ADAM_TESTBED_LEX_BUDGET);
  LLexer := ref Lexer(ASource, LReports);
  LTokens := LLexer.ReadAll();
  LAt := ASource.FirstLineStart;
  for LI := 0 to LTokens.Count - 1 do
    DoScanGap(ASource, LAt, LTokens.Items[LI].StartOffset, AComments);
    if LTokens.Items[LI].EndOffset > LAt then
      LAt := LTokens.Items[LI].EndOffset;
    end;
  end;
end;

// A marker word's level as adam prints it (Diagnostics' words); "" when AWord is none
func DoLevelOf(const AWord: string): string;
begin
  if AWord = "HINT" then
    return ADAM_MSG_DIAGNOSTICS_HINT;
  end;
  if AWord = "WARN" then
    return ADAM_MSG_DIAGNOSTICS_WARNING;
  end;
  if AWord = "ERROR" then
    return ADAM_MSG_DIAGNOSTICS_ERROR;
  end;
  if AWord = "FATAL" then
    return ADAM_MSG_DIAGNOSTICS_FATAL;
  end;
  return "";
end;

// True when AText starts with a report code: two capitals, then four digits
func DoStartsWithCode(const AText: string): bool;
var
  LI: int64;
begin
  if len(AText) < ADAM_TESTBED_CODE_LENGTH then
    return false;
  end;
  for LI := 0 to ADAM_TESTBED_CODE_LENGTH - 1 do
    if LI < 2 then
      if not DoIsCapital(int64(uint8(AText[LI]))) then
        return false;
      end;
    else
      if not DoIsDigit(int64(uint8(AText[LI]))) then
        return false;
      end;
    end;
  end;
  return true;
end;

// Reads a marker's tail ATail (what follows its level word: CODE[@column][: text]) into
// AMarker; false when it is malformed
func DoReadMarkerTail(const ATail: string; var AMarker: ReportMarker): bool;
var
  LAt: int64;
  LColumn: int64;
  LRest: string;
begin
  if not DoStartsWithCode(ATail) then
    return false;
  end;
  AMarker.Code := Substring(ATail, 0, ADAM_TESTBED_CODE_LENGTH);
  LAt := ADAM_TESTBED_CODE_LENGTH;
  AMarker.Column := 0;
  if (LAt < len(ATail)) and (ATail[LAt] = '@') then
    LAt := LAt + 1;
    LColumn := 0;
    if (LAt >= len(ATail)) or not DoIsDigit(int64(uint8(ATail[LAt]))) then
      return false;
    end;
    while (LAt < len(ATail)) and DoIsDigit(int64(uint8(ATail[LAt]))) do
      LColumn := LColumn * 10 + (int64(uint8(ATail[LAt])) - 0x30);
      if LColumn > 2147483647 then
        return false;
      end;
      LAt := LAt + 1;
    end;
    AMarker.Column := int32(LColumn);
  end;
  AMarker.Message := "";
  LRest := Trim(Substring(ATail, LAt, len(ATail) - LAt));
  if LRest = "" then
    return true;
  end;
  if LRest[0] <> ':' then
    return false;
  end;
  AMarker.Message := Trim(Substring(LRest, 1, len(LRest) - 1));
  return true;
end;

// Reads one marker segment ASegment (the text after one //, trimmed) on line ALine. A segment
// that does not start with a marker word and a blank is comment text: nothing. A malformed
// marker is TB0009 at AAt
func DoReadMarker(const ASegment: string; const ALine: int32; const ASource: ref SourceText;
  const AAt: int64; const AReports: ref Diagnostics; var ASpec: TestSpec);
var
  LSpace: int64;
  LMarker: ReportMarker;
  LCount: int64;
begin
  LSpace := IndexOf(" ", ASegment, 0);
  if LSpace < 0 then
    // A level word alone is a marker with nothing after it
    if DoLevelOf(ASegment) <> "" then
      DoReport(AReports, ASource, AAt, ADAM_ERR_TESTBED_009, ADAM_MSG_TESTBED_SPEC_BAD_MARKER,
        NoArgs().Str(ASegment));
    end;
    return;
  end;
  LMarker.Level := DoLevelOf(Substring(ASegment, 0, LSpace));
  if LMarker.Level = "" then
    return;
  end;
  if not DoReadMarkerTail(Trim(Substring(ASegment, LSpace + 1, len(ASegment) - LSpace - 1)),
    LMarker) then
    DoReport(AReports, ASource, AAt, ADAM_ERR_TESTBED_009, ADAM_MSG_TESTBED_SPEC_BAD_MARKER,
      NoArgs().Str(ASegment));
    return;
  end;
  LMarker.Line := ALine;
  LCount := len(ASpec.Markers);
  setlength(ASpec.Markers, LCount + 1);
  ASpec.Markers[LCount] := LMarker;
end;

// Reads the markers in AText (a comment's text after its first //) on line ALine: one segment
// before each further //
func DoReadMarkers(const AText: string; const ALine: int32; const ASource: ref SourceText;
  const AAt: int64; const AReports: ref Diagnostics; var ASpec: TestSpec);
var
  LFrom: int64;
  LNext: int64;
  LDone: bool;
begin
  LFrom := 0;
  LDone := false;
  while not LDone do
    LNext := IndexOf("//", AText, LFrom);
    if LNext < 0 then
      DoReadMarker(Trim(Substring(AText, LFrom, len(AText) - LFrom)), ALine, ASource, AAt,
        AReports, ASpec);
      LDone := true;
    else
      DoReadMarker(Trim(Substring(AText, LFrom, LNext - LFrom)), ALine, ASource, AAt, AReports,
        ASpec);
      LFrom := LNext + 2;
    end;
  end;
end;

// Reads AText as one or more quoted values (\" and \\ inside) into AValues; false when it is
// not that
func DoReadQuoted(const AText: string; var AValues: StringArray): bool;
var
  LAt: int64;
  LValue: string;
  LClosed: bool;
  LByte: int64;
  LCount: int64;
begin
  setlength(AValues, 0);
  LAt := DoLeadingBlanks(AText);
  while LAt < len(AText) do
    if AText[LAt] <> '"' then
      return false;
    end;
    LAt := LAt + 1;
    LValue := "";
    LClosed := false;
    while (LAt < len(AText)) and not LClosed do
      LByte := int64(uint8(AText[LAt]));
      if LByte = 0x5C then
        // A backslash takes only " and \ after it
        if LAt + 1 >= len(AText) then
          return false;
        end;
        LByte := int64(uint8(AText[LAt + 1]));
        if (LByte <> 0x22) and (LByte <> 0x5C) then
          return false;
        end;
        LValue := LValue + Substring(AText, LAt + 1, 1);
        LAt := LAt + 2;
      else
        if LByte = 0x22 then
          LClosed := true;
        else
          LValue := LValue + Substring(AText, LAt, 1);
        end;
        LAt := LAt + 1;
      end;
    end;
    if not LClosed then
      return false;
    end;
    // A value ends at a blank or the end
    if (LAt < len(AText)) and (uint8(AText[LAt]) > 0x20) then
      return false;
    end;
    LCount := len(AValues);
    setlength(AValues, LCount + 1);
    AValues[LCount] := LValue;
    LAt := LAt + DoLeadingBlanks(Substring(AText, LAt, len(AText) - LAt));
  end;
  return len(AValues) > 0;
end;

// Reads AText as an exit code (a whole number in int32's range) into AValue; false when it is
// not one
func DoReadExitCode(const AText: string; var AValue: int32): bool;
var
  LValue: int64;
begin
  if not TryStrToInt(AText, LValue) then
    return false;
  end;
  if (LValue < -2147483648) or (LValue > 2147483647) then
    return false;
  end;
  AValue := int32(LValue);
  return true;
end;

// Reads AText as words split at blanks (a test id each) onto AValues; false when it holds none
func DoReadWords(const AText: string; var AValues: StringArray): bool;
var
  LAt: int64;
  LStart: int64;
  LCount: int64;
begin
  LAt := 0;
  while LAt < len(AText) do
    LAt := LAt + DoLeadingBlanks(Substring(AText, LAt, len(AText) - LAt));
    LStart := LAt;
    while (LAt < len(AText)) and (uint8(AText[LAt]) > 0x20) do
      LAt := LAt + 1;
    end;
    if LAt > LStart then
      LCount := len(AValues);
      setlength(AValues, LCount + 1);
      AValues[LCount] := Substring(AText, LStart, LAt - LStart);
    end;
  end;
  return len(AValues) > 0;
end;

// The levels line's value AText into ALevels: one or more words, each a level's name (exact
// case: debug safe fast small), none given twice; false (ALevels empty) otherwise
func DoReadLevels(const AText: string; var ALevels: StringArray): bool;
var
  LWords: StringArray;
  LLevel: OptLevel;
  LI: int64;
  LJ: int64;
begin
  setlength(ALevels, 0);
  setlength(LWords, 0);
  if not DoReadWords(AText, LWords) then
    return false;
  end;
  for LI := 0 to len(LWords) - 1 do
    LLevel := OptLevel.Debug;
    if not OptLevelOfName(LWords[LI], LLevel) then
      return false;
    end;
    for LJ := 0 to LI - 1 do
      if LWords[LJ] = LWords[LI] then
        return false;
      end;
    end;
  end;
  ALevels := LWords;
  return true;
end;

// The targets line's value AText into ATargets: one or more words, each a triple a test runs
// on (ADAM_TESTBED_TRIPLE_WINDOWS, ADAM_TESTBED_TRIPLE_LINUX), none given twice; false
// (ATargets empty) otherwise
func DoReadTargets(const AText: string; var ATargets: StringArray): bool;
var
  LWords: StringArray;
  LI: int64;
  LJ: int64;
begin
  setlength(ATargets, 0);
  setlength(LWords, 0);
  if not DoReadWords(AText, LWords) then
    return false;
  end;
  for LI := 0 to len(LWords) - 1 do
    if (LWords[LI] <> ADAM_TESTBED_TRIPLE_WINDOWS) and (LWords[LI] <> ADAM_TESTBED_TRIPLE_LINUX) then
      return false;
    end;
    for LJ := 0 to LI - 1 do
      if LWords[LJ] = LWords[LI] then
        return false;
      end;
    end;
  end;
  ATargets := LWords;
  return true;
end;

// Reads one spec line ALine whose first byte is at AAt. AKeys holds the keys already given,
// each between bars (|kind|args|)
func DoReadSpecLine(const ALine: string; const AAt: int64; const ASource: ref SourceText;
  const AReports: ref Diagnostics; var ASpec: TestSpec; var AKeys: string);
var
  LText: string;
  LTextAt: int64;
  LSpace: int64;
  LKey: string;
  LValue: string;
  LCount: int64;
  LBar: int64;
  LLevelName: string;
  LLevel: OptLevel;
begin
  LText := Trim(ALine);
  LTextAt := AAt + DoLeadingBlanks(ALine);
  if (LText = "") or StartsStr("--", LText) then
    return;
  end;

  // ir| text, ir <level>| text: one line the build's .ir must hold (one blank after the bar is
  // the separator; the level, when given, a level's name)
  if StartsStr("ir|", LText) or StartsStr("ir ", LText) then
    LBar := IndexOf("|", LText, 0);
    if LBar < 0 then
      DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007, ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
        NoArgs().Str(LText).Str("ir").Str(ADAM_MSG_TESTBED_SPEC_WANT_IR));
      return;
    end;
    LLevelName := Trim(Substring(LText, 2, LBar - 2));
    if LLevelName <> "" then
      LLevel := OptLevel.Debug;
      if not OptLevelOfName(LLevelName, LLevel) then
        DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
          ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
          NoArgs().Str(LLevelName).Str("ir").Str(ADAM_MSG_TESTBED_SPEC_WANT_IR));
        return;
      end;
    end;
    LValue := Substring(LText, LBar + 1, len(LText) - LBar - 1);
    if StartsStr(" ", LValue) then
      LValue := Substring(LValue, 1, len(LValue) - 1);
    end;
    LCount := len(ASpec.IRExpect);
    setlength(ASpec.IRExpect, LCount + 1);
    setlength(ASpec.IRLevels, LCount + 1);
    ASpec.IRExpect[LCount] := LValue;
    ASpec.IRLevels[LCount] := LLevelName;
    return;
  end;

  // | text: one expected output line (one blank after the bar is the separator)
  if LText[0] = '|' then
    LValue := Substring(LText, 1, len(LText) - 1);
    if StartsStr(" ", LValue) then
      LValue := Substring(LValue, 1, len(LValue) - 1);
    end;
    LCount := len(ASpec.Expect);
    setlength(ASpec.Expect, LCount + 1);
    ASpec.Expect[LCount] := LValue;
    return;
  end;

  LSpace := IndexOf(" ", LText, 0);
  if LSpace < 0 then
    LKey := LText;
    LValue := "";
  else
    LKey := Substring(LText, 0, LSpace);
    LValue := Trim(Substring(LText, LSpace + 1, len(LText) - LSpace - 1));
  end;
  if IndexOf("|" + LKey + "|", AKeys, 0) >= 0 then
    DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_008, ADAM_MSG_TESTBED_SPEC_KEY_TWICE,
      NoArgs().Str(LKey));
    return;
  end;

  if LKey = "kind" then
    if LValue = "check" then
      ASpec.Kind := TestKind.Check;
    else
      if LValue = "error" then
        ASpec.Kind := TestKind.Error;
      else
        if LValue = "cli" then
          ASpec.Kind := TestKind.CLI;
        else
          if LValue = "run" then
            ASpec.Kind := TestKind.Run;
          else
            if LValue = "dep" then
              ASpec.Kind := TestKind.Dep;
            else
              if LValue = "manual" then
                ASpec.Kind := TestKind.Manual;
              else
                DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_005,
                  ADAM_MSG_TESTBED_SPEC_BAD_KIND, NoArgs().Str(LValue));
                return;
              end;
            end;
          end;
        end;
      end;
    end;
  else
    if LKey = "args" then
      if not DoReadQuoted(LValue, ASpec.Args) then
        DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
          ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
          NoArgs().Str(LValue).Str(LKey).Str(ADAM_MSG_TESTBED_SPEC_WANT_QUOTED));
        return;
      end;
    else
      if LKey = "exitcode" then
        if not DoReadExitCode(LValue, ASpec.ExitCode) then
          DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
            ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
            NoArgs().Str(LValue).Str(LKey).Str(ADAM_MSG_TESTBED_SPEC_WANT_NUMBER));
          return;
        end;
      else
        if LKey = "warnings" then
          if LValue <> "allow" then
            DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
              ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
              NoArgs().Str(LValue).Str(LKey).Str(ADAM_MSG_TESTBED_SPEC_WANT_ALLOW));
            return;
          end;
          ASpec.WarningsAllow := true;
        else
          if LKey = "deps" then
            if not DoReadWords(LValue, ASpec.Deps) then
              DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
                ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
                NoArgs().Str(LValue).Str(LKey).Str(ADAM_MSG_TESTBED_SPEC_WANT_IDS));
              return;
            end;
            ASpec.DepsLine := ASource.LineOf(LTextAt);
            ASpec.DepsColumn := ASource.ColumnOf(LTextAt);
          else
            if LKey = "levels" then
              if not DoReadLevels(LValue, ASpec.Levels) then
                DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
                  ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
                  NoArgs().Str(LValue).Str(LKey).Str(ADAM_MSG_TESTBED_SPEC_WANT_LEVELS));
                return;
              end;
            else
              if LKey = "targets" then
                if not DoReadTargets(LValue, ASpec.Targets) then
                  DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
                    ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
                    NoArgs().Str(LValue).Str(LKey).Str(ADAM_MSG_TESTBED_SPEC_WANT_TARGETS));
                  return;
                end;
              else
                if LKey = "runs" then
                  if not DoReadTargets(LValue, ASpec.Runs) then
                    DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
                      ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
                      NoArgs().Str(LValue).Str(LKey).Str(ADAM_MSG_TESTBED_SPEC_WANT_TARGETS));
                    return;
                  end;
                else
                  DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_004,
                    ADAM_MSG_TESTBED_SPEC_UNKNOWN_KEY, NoArgs().Str(LKey));
                  return;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
  AKeys := AKeys + LKey + "|";
end;

// Reads the @@test block in AComment (its "@@test" at byte ATestAt): each line up to "@@end".
// A second block is TB0002, one with no "@@end" TB0003. ASpecAt gets ATestAt for the first
func DoReadSpecBlock(const ASource: ref SourceText; const AComment: FoundComment;
  const ATestAt: int64; const AReports: ref Diagnostics; var ASpec: TestSpec;
  var ASpecAt: int64; var AKeys: string);
var
  LText: string;
  LEnd: int64;
  LStop: int64;
  LAt: int64;
  LLineEnd: int64;
begin
  if ASpecAt >= 0 then
    DoReport(AReports, ASource, ATestAt, ADAM_ERR_TESTBED_002, ADAM_MSG_TESTBED_SPEC_TWICE,
      NoArgs());
    return;
  end;
  ASpecAt := ATestAt;
  LText := ASource.Slice(AComment.StartAt, AComment.StopAt);
  LEnd := DoIndexOfLineStart("@@end", LText, ATestAt - AComment.StartAt + 6);
  if LEnd < 0 then
    DoReport(AReports, ASource, ATestAt, ADAM_ERR_TESTBED_003, ADAM_MSG_TESTBED_SPEC_NO_END,
      NoArgs());
    return;
  end;
  LStop := AComment.StartAt + LEnd;
  LAt := ATestAt + 6;
  while LAt < LStop do
    LLineEnd := LAt;
    while (LLineEnd < LStop) and (ASource.ByteAt(LLineEnd) <> 0x0A) and
      (ASource.ByteAt(LLineEnd) <> 0x0D) do
      LLineEnd := LLineEnd + 1;
    end;
    DoReadSpecLine(ASource.Slice(LAt, LLineEnd), LAt, ASource, AReports, ASpec, AKeys);
    // Past the newline: CR LF, LF or CR
    LAt := LLineEnd;
    if (ASource.ByteAt(LAt) = 0x0D) and (ASource.ByteAt(LAt + 1) = 0x0A) then
      LAt := LAt + 2;
    else
      LAt := LAt + 1;
    end;
  end;
end;

// A block comment's text: what is between its /* and */
func DoBlockBody(const ASource: ref SourceText; const AComment: FoundComment): string;
var
  LBody: string;
begin
  LBody := ASource.Slice(AComment.StartAt + 2, AComment.StopAt);
  if EndsStr("*/", LBody) then
    LBody := Substring(LBody, 0, len(LBody) - 2);
  end;
  return LBody;
end;

// Reads the markers of one comment that is no @@test block into ASpec's: a line comment, or a
// block whose text starts with //; any other block holds none
func DoReadCommentMarkers(const ASource: ref SourceText; const AComment: FoundComment;
  const AReports: ref Diagnostics; var ASpec: TestSpec);
var
  LBody: string;
begin
  if not AComment.IsBlock then
    DoReadMarkers(ASource.Slice(AComment.StartAt + 2, AComment.StopAt),
      ASource.LineOf(AComment.StartAt), ASource, AComment.StartAt, AReports, ASpec);
    return;
  end;
  LBody := Trim(DoBlockBody(ASource, AComment));
  if StartsStr("//", LBody) then
    DoReadMarkers(Substring(LBody, 2, len(LBody) - 2), ASource.LineOf(AComment.StartAt),
      ASource, AComment.StartAt, AReports, ASpec);
  end;
end;

// Reads one comment: a block holding "@@test" is the spec; a line comment, or a block whose
// text starts with //, holds markers
func DoReadComment(const ASource: ref SourceText; const AComment: FoundComment;
  const AReports: ref Diagnostics; var ASpec: TestSpec; var ASpecAt: int64; var AKeys: string);
var
  LTest: int64;
begin
  if AComment.IsBlock then
    LTest := DoIndexOfLineStart("@@test", DoBlockBody(ASource, AComment), 0);
    if LTest >= 0 then
      DoReadSpecBlock(ASource, AComment, AComment.StartAt + 2 + LTest, AReports, ASpec, ASpecAt,
        AKeys);
      return;
    end;
  end;
  DoReadCommentMarkers(ASource, AComment, AReports, ASpec);
end;

// The levels ASpec's test is built at, as its levels line names them ("debug" without one),
// joined by ", "
func DoBuiltLevels(const ASpec: TestSpec): string;
begin
  if len(ASpec.Levels) = 0 then
    return OptLevelName(OptLevel.Debug);
  end;
  return JoinStrings(ASpec.Levels, ", ");
end;

// True when ALevelName is "" (every level) or a level ASpec's test is built at (no levels
// line: debug alone)
func DoBuiltAt(const ASpec: TestSpec; const ALevelName: string): bool;
var
  LI: int64;
begin
  if ALevelName = "" then
    return true;
  end;
  if len(ASpec.Levels) = 0 then
    return ALevelName = OptLevelName(OptLevel.Debug);
  end;
  for LI := 0 to len(ASpec.Levels) - 1 do
    if ASpec.Levels[LI] = ALevelName then
      return true;
    end;
  end;
  return false;
end;

// The checks the whole spec needs once read: a kind, keys and markers that kind takes
func DoCheckSpec(const ASource: ref SourceText; const ASpecAt: int64; const AKeys: string;
  const AReports: ref Diagnostics; const ASpec: TestSpec);
var
  LI: int64;
  LErrors: int64;
begin
  if ASpec.Kind = TestKind.Unset then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_005, ADAM_MSG_TESTBED_SPEC_NO_KIND,
      NoArgs());
    return;
  end;
  if (ASpec.Kind <> TestKind.CLI) and (ASpec.Kind <> TestKind.Run) then
    if IndexOf("|args|", AKeys, 0) >= 0 then
      DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
        NoArgs().Str("args").Str(TestKindText(ASpec.Kind)));
    end;
    if IndexOf("|exitcode|", AKeys, 0) >= 0 then
      DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
        NoArgs().Str("exitcode").Str(TestKindText(ASpec.Kind)));
    end;
    if len(ASpec.Expect) > 0 then
      DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
        NoArgs().Str("|").Str(TestKindText(ASpec.Kind)));
    end;
  end;
  // A manual test is never run: nothing is built before it
  if (ASpec.Kind = TestKind.Manual) and (IndexOf("|deps|", AKeys, 0) >= 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
      NoArgs().Str("deps").Str(TestKindText(ASpec.Kind)));
  end;
  // A run test alone is built at levels (a dep is built once, at debug, for its dependents)
  if (ASpec.Kind <> TestKind.Run) and (IndexOf("|levels|", AKeys, 0) >= 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
      NoArgs().Str("levels").Str(TestKindText(ASpec.Kind)));
  end;
  // A run test alone is built for targets (a dep is built for the first, for its dependents)
  if (ASpec.Kind <> TestKind.Run) and (IndexOf("|targets|", AKeys, 0) >= 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
      NoArgs().Str("targets").Str(TestKindText(ASpec.Kind)));
  end;
  // A run test's own program, or a cli test's adam (build -r), may run others' (runs)
  if (ASpec.Kind <> TestKind.Run) and (ASpec.Kind <> TestKind.CLI) and
    (IndexOf("|runs|", AKeys, 0) >= 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
      NoArgs().Str("runs").Str(TestKindText(ASpec.Kind)));
  end;
  // ir lines read a run test's .ir; a level one names is a level the test is built at (no
  // levels line: debug alone)
  if (ASpec.Kind <> TestKind.Run) and (len(ASpec.IRExpect) > 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
      NoArgs().Str("ir|").Str(TestKindText(ASpec.Kind)));
  end;
  if ASpec.Kind = TestKind.Run then
    for LI := 0 to len(ASpec.IRLevels) - 1 do
      if not DoBuiltAt(ASpec, ASpec.IRLevels[LI]) then
        DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_011,
          ADAM_MSG_TESTBED_SPEC_IR_LEVEL, NoArgs().Str(ASpec.IRLevels[LI])
          .Str(DoBuiltLevels(ASpec)));
      end;
    end;
  end;
  LErrors := 0;
  for LI := 0 to len(ASpec.Markers) - 1 do
    if IsErrorLevel(ASpec.Markers[LI].Level) then
      LErrors := LErrors + 1;
    end;
  end;
  if (ASpec.Kind = TestKind.Check) and (LErrors > 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_010, ADAM_MSG_TESTBED_SPEC_CHECK_ERROR,
      NoArgs());
  end;
  if (ASpec.Kind = TestKind.Run) and (LErrors > 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_010, ADAM_MSG_TESTBED_SPEC_RUN_ERROR,
      NoArgs());
  end;
  if (ASpec.Kind = TestKind.Dep) and (LErrors > 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_010, ADAM_MSG_TESTBED_SPEC_DEP_ERROR,
      NoArgs());
  end;
  if (ASpec.Kind = TestKind.Error) and (LErrors = 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_010, ADAM_MSG_TESTBED_SPEC_ERROR_NONE,
      NoArgs());
  end;
  if (ASpec.Kind = TestKind.CLI) and (len(ASpec.Markers) > 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_010, ADAM_MSG_TESTBED_SPEC_CLI_MARKER,
      NoArgs());
  end;
end;

// Reads the spec of the test file APath, whose bytes are AText, into ASpec: its @@test block
// and its report markers. Every mistake is one report into AReports at the mistake; true when
// there is none
public func ReadSpec(const APath: string; const AText: string; const AReports: ref Diagnostics;
  var ASpec: TestSpec): bool;
var
  LSource: ref SourceText;
  LComments: FoundCommentArray;
  LI: int64;
  LErrors: int64;
  LSpecAt: int64;
  LKeys: string;
begin
  LErrors := AReports.ErrorCount;
  ASpec.Kind := TestKind.Unset;
  setlength(ASpec.Args, 0);
  setlength(ASpec.Levels, 0);
  setlength(ASpec.Targets, 0);
  setlength(ASpec.Runs, 0);
  ASpec.ExitCode := 0;
  setlength(ASpec.Expect, 0);
  setlength(ASpec.IRExpect, 0);
  setlength(ASpec.IRLevels, 0);
  ASpec.WarningsAllow := false;
  setlength(ASpec.Markers, 0);
  setlength(ASpec.Deps, 0);
  ASpec.DepsLine := 1;
  ASpec.DepsColumn := 1;

  LSource := ref SourceText(APath, AText);
  DoFindComments(LSource, LComments);
  LSpecAt := -1;
  LKeys := "|";
  for LI := 0 to len(LComments) - 1 do
    DoReadComment(LSource, LComments[LI], AReports, ASpec, LSpecAt, LKeys);
  end;
  if LSpecAt < 0 then
    DoReport(AReports, LSource, LSource.FirstLineStart, ADAM_ERR_TESTBED_001,
      ADAM_MSG_TESTBED_SPEC_NONE, NoArgs());
    return false;
  end;
  DoCheckSpec(LSource, LSpecAt, LKeys, AReports, ASpec);
  return AReports.ErrorCount = LErrors;
end;

// Reads the report markers of the file APath, whose bytes are AText, into AMarkers: a
// fixture a test imports, which holds markers and no spec (an @@test block in it is no
// marker and is skipped). Every malformed marker is one report into AReports at it (TB0009);
// true when there is none
public func ReadMarkers(const APath: string; const AText: string; const AReports: ref Diagnostics;
  var AMarkers: ReportMarkerArray): bool;
var
  LSource: ref SourceText;
  LComments: FoundCommentArray;
  LSpec: TestSpec;
  LI: int64;
  LErrors: int64;
begin
  LErrors := AReports.ErrorCount;
  setlength(LSpec.Markers, 0);
  LSource := ref SourceText(APath, AText);
  DoFindComments(LSource, LComments);
  for LI := 0 to len(LComments) - 1 do
    DoReadCommentMarkers(LSource, LComments[LI], AReports, LSpec);
  end;
  AMarkers := LSpec.Markers;
  return AReports.ErrorCount = LErrors;
end;

// The dotted unit name at the token AAt of ATokens (an identifier, then '.' identifier pairs)
// with the index past it in ANext; "" (ANext = AAt) when no identifier is at AAt
func DoDottedName(const ATokens: TokenList; const AAt: int64; var ANext: int64): string;
var
  LParts: StringArray;
  LAt: int64;
  LCount: int64;
begin
  ANext := AAt;
  if (AAt >= ATokens.Count) or (ATokens.Items[AAt].Kind <> TokenKind.Identifier) then
    return "";
  end;
  setlength(LParts, 1);
  LParts[0] := ATokens.Items[AAt].Text;
  LAt := AAt + 1;
  while (LAt + 1 < ATokens.Count) and (ATokens.Items[LAt].Kind = TokenKind.Dot) and
    (ATokens.Items[LAt + 1].Kind = TokenKind.Identifier) do
    LCount := len(LParts);
    setlength(LParts, LCount + 1);
    LParts[LCount] := ATokens.Items[LAt + 1].Text;
    LAt := LAt + 2;
  end;
  ANext := LAt;
  return JoinStrings(LParts, ".");
end;

// The module name of the source AText (APath: its file) in AModule ("" when it has no module
// clause) and the units its import clauses name, in order, in AImports: how the runner finds
// the fixtures a test uses. Read with Adam's own lexer, its reports dropped (DoFindComments');
// an import in an inactive @ifdef branch is read as any other
public func ReadModuleNames(const APath: string; const AText: string; var AModule: string;
  var AImports: StringArray);
var
  LSource: ref SourceText;
  LReports: ref Diagnostics;
  LLexer: ref Lexer;
  LTokens: TokenList;
  LI: int64;
  LNext: int64;
  LFrom: int64;
  LName: string;
  LCount: int64;
  LInClause: bool;
begin
  AModule := "";
  setlength(AImports, 0);
  LSource := ref SourceText(APath, AText);
  LReports := ref Diagnostics(ADAM_TESTBED_LEX_BUDGET);
  LLexer := ref Lexer(LSource, LReports);
  LTokens := LLexer.ReadAll();
  LI := 0;
  while LI < LTokens.Count do
    LNext := LI + 1;
    if (LTokens.Items[LI].Kind = TokenKind.KwModule) and (AModule = "") then
      // module <kind> <name>;
      AModule := DoDottedName(LTokens, LI + 2, LNext);
    end;
    if LTokens.Items[LI].Kind = TokenKind.KwImport then
      // import <name>, <name> ... ;
      LNext := LI + 1;
      LInClause := true;
      while LInClause do
        LFrom := LNext;
        LName := DoDottedName(LTokens, LFrom, LNext);
        if LName = "" then
          LInClause := false;
        else
          LCount := len(AImports);
          setlength(AImports, LCount + 1);
          AImports[LCount] := LName;
          if (LNext < LTokens.Count) and (LTokens.Items[LNext].Kind = TokenKind.Comma) then
            LNext := LNext + 1;
          else
            LInClause := false;
          end;
        end;
      end;
    end;
    LI := LNext;
  end;
end;

end.
