-------------------------------------------------------------------------------
  Adam.Testbed.Spec.adam - A test file's spec: its @@test block and its
  report markers

  The form is PaskalCPP's (ref\testsuite.md), cut to what Adam runs today:

    one @@test ... @@end inside a block comment, each first on its line
    (prose that names them is no block), then a line each:
      kind check | error | cli | run
                                 required: check = adam check reports no
                                 error (exit 0); error = its markers say
                                 which reports come (exit 1); cli = adam
                                 run with args, output and exit code
                                 compared; run = adam build reports no
                                 error (exit 0, its reports checked as
                                 check's), then the exe it wrote is run
                                 with args, output and exit code compared
      args "a" "b"               cli / run only: adam's (cli) or the exe's
                                 (run) arguments, quoted (\" and \\
                                 inside); <DIR> = the test's folder,
                                 <BIN> = the adam.exe's folder,
                                 <OUT> = the output root,
                                 <SYS> = the system DLL folder the
                                 linker searches
      exitcode N                 cli / run only (default 0)
      warnings allow             an unmarked hint or warning passes
      | text                     cli / run only: one expected output line
                                 (<DIR>, <BIN>, <OUT>, <SYS> as in args)
      -- note                    ignored

    report markers, in a line comment: LEVEL CODE[@column][: text], LEVEL
    one of HINT, WARN, ERROR, FATAL, several per comment (each after its
    own //), on the line the report is at; or in a block comment whose text
    starts with //, for a line no line comment can end

  Comments are found with Adam's own lexer: the bytes between two tokens
  are blanks and comments only, so a line or block comment opener there
  opens a comment and never one inside a string. The lexer's own reports
  are the test's business (adam check reports them), so they are kept
  apart and dropped.

  Every mistake in a spec is one report at the mistake (TB codes).
*******************************************************************************/

module unit Adam.Testbed.Spec;

import System.SysUtils, Adam.Core.Messages, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics,
  Adam.Compiler.Lexer;

public const
  ADAM_ERR_TESTBED_001: string = "TB0001";   // no @@test block
  ADAM_ERR_TESTBED_002: string = "TB0002";   // a second @@test block
  ADAM_ERR_TESTBED_003: string = "TB0003";   // a @@test block with no @@end in its comment
  ADAM_ERR_TESTBED_004: string = "TB0004";   // a key the spec does not know
  ADAM_ERR_TESTBED_005: string = "TB0005";   // no kind, or a kind that is none
  ADAM_ERR_TESTBED_006: string = "TB0006";   // a key the test's kind does not take
  ADAM_ERR_TESTBED_007: string = "TB0007";   // a value its key does not take
  ADAM_ERR_TESTBED_008: string = "TB0008";   // a key given twice
  ADAM_ERR_TESTBED_009: string = "TB0009";   // a malformed report marker
  ADAM_ERR_TESTBED_010: string = "TB0010";   // markers the test's kind does not allow

const
  // The lexer's own reports are dropped: a budget no test file reaches, so it never stops
  ADAM_TESTBED_LEX_BUDGET: int64 = 1000000;

  // A report code's length: two capitals, four digits (LX0004)
  ADAM_TESTBED_CODE_LENGTH: int64 = 6;

public type
  // What a test does with adam (see the header)
  TestKind = choices(Unset, Check, Error, Cli, Run);

  // One report a test expects: its level as adam prints it (Diagnostics' words), its code,
  // its line, its column (0 = any) and its text ("" = any)
  ReportMarker = record
    Level: string;
    Code: string;
    Line: int32;
    Column: int32;
    Message: string;
  end;

  ReportMarkerArray = array of ReportMarker;

  // A test file's spec (see the header)
  TestSpec = record
    Kind: TestKind;
    Args: StringArray;
    ExitCode: int32;
    Expect: StringArray;
    WarningsAllow: bool;
    Markers: ReportMarkerArray;
  end;

type
  // One comment found between two tokens: its bytes [StartAt, StopAt)
  FoundComment = record
    StartAt: int64;
    StopAt: int64;
    IsBlock: bool;
  end;

  FoundCommentArray = array of FoundComment;

// The kind as a spec writes it
public routine TestKindText(const AKind: TestKind): string;
begin
  if AKind = TestKind.Check then
    return "check";
  end;
  if AKind = TestKind.Error then
    return "error";
  end;
  if AKind = TestKind.Cli then
    return "cli";
  end;
  if AKind = TestKind.Run then
    return "run";
  end;
  return "unset";
end;

// True when ALevel (Diagnostics' words) stops a build: Error or Fatal
public routine IsErrorLevel(const ALevel: string): bool;
begin
  return (ALevel = ADAM_MSG_DIAGNOSTICS_ERROR) or (ALevel = ADAM_MSG_DIAGNOSTICS_FATAL);
end;

// Reports one spec mistake (an Error, ACode, ATemplate filled with AArgs) at byte AAt of ASource
routine DoReport(const AReports: ref Diagnostics; const ASource: ref SourceText; const AAt: int64;
  const ACode: string; const ATemplate: string; const AArgs: MessageArgs);
begin
  AReports.Add(Severity.Error, ACode, ASource.PlaceOf(AAt), ATemplate, AArgs);
end;

// True when the byte AByte is a decimal digit
routine DoIsDigit(const AByte: int64): bool;
begin
  return (AByte >= 0x30) and (AByte <= 0x39);
end;

// True when the byte AByte is a capital letter
routine DoIsCapital(const AByte: int64): bool;
begin
  return (AByte >= 0x41) and (AByte <= 0x5A);
end;

// The number of blank bytes (at or below a space) AText starts with
routine DoLeadingBlanks(const AText: string): int64;
var
  LI: int64;
begin
  LI := 0;
  while (LI < len(AText)) and (uint8(AText[LI]) <= 0x20) do
    LI := LI + 1;
  end;
  return LI;
end;

// The offset of the first AWord in AText at or after AFrom that starts its line (only blanks
// before it on its line, or AText's start); -1 when there is none. @@test and @@end count only
// there, so prose that names them is never taken for them
routine DoIndexOfLineStart(const AWord: string; const AText: string; const AFrom: int64): int64;
var
  LAt: int64;
  LBack: int64;
  LByte: int64;
  LLineStart: bool;
begin
  LAt := IndexOf(AWord, AText, AFrom);
  while LAt >= 0 do
    LLineStart := true;
    LBack := LAt - 1;
    while LLineStart and (LBack >= 0) do
      LByte := int64(uint8(AText[LBack]));
      if (LByte = 0x0A) or (LByte = 0x0D) then
        // Reached the line's start with only blanks passed
        LBack := -1;
      else
        if LByte > 0x20 then
          LLineStart := false;
        end;
        LBack := LBack - 1;
      end;
    end;
    if LLineStart then
      return LAt;
    end;
    LAt := IndexOf(AWord, AText, LAt + 1);
  end;
  return -1;
end;

// Adds the comment [AStart, AStop) to AComments
routine DoAddComment(var AComments: FoundCommentArray; const AStart: int64; const AStop: int64;
  const AIsBlock: bool);
var
  LCount: int64;
begin
  LCount := len(AComments);
  setlength(AComments, LCount + 1);
  AComments[LCount].StartAt := AStart;
  AComments[LCount].StopAt := AStop;
  AComments[LCount].IsBlock := AIsBlock;
end;

// The comments in the gap [AStart, AEnd) between two tokens. Only blanks and comments stand
// there (the lexer skipped them), so a // or a /* in it opens a comment. A block comment that
// is not closed (the lexer's LX0003) ends at the gap's end
routine DoScanGap(const ASource: ref SourceText; const AStart: int64; const AEnd: int64;
  var AComments: FoundCommentArray);
var
  LAt: int64;
  LStop: int64;
begin
  LAt := AStart;
  while LAt < AEnd do
    if (ASource.ByteAt(LAt) = 0x2F) and (ASource.ByteAt(LAt + 1) = 0x2F) then
      // A line comment runs to its line's end
      LStop := LAt + 2;
      while (LStop < AEnd) and (ASource.ByteAt(LStop) <> 0x0A) and
        (ASource.ByteAt(LStop) <> 0x0D) do
        LStop := LStop + 1;
      end;
      DoAddComment(AComments, LAt, LStop, false);
      LAt := LStop;
    else
      if (ASource.ByteAt(LAt) = 0x2F) and (ASource.ByteAt(LAt + 1) = 0x2A) then
        // A block comment runs past its first '*/' (comments do not nest)
        LStop := LAt + 2;
        while (LStop < AEnd) and
          not ((ASource.ByteAt(LStop) = 0x2A) and (ASource.ByteAt(LStop + 1) = 0x2F)) do
          LStop := LStop + 1;
        end;
        if LStop < AEnd then
          LStop := LStop + 2;
        end;
        DoAddComment(AComments, LAt, LStop, true);
        LAt := LStop;
      else
        LAt := LAt + 1;
      end;
    end;
  end;
end;

// Every comment of ASource, in order: the gaps between its tokens, scanned
routine DoFindComments(const ASource: ref SourceText; var AComments: FoundCommentArray);
var
  LReports: ref Diagnostics;
  LLexer: ref Lexer;
  LTokens: TokenList;
  LAt: int64;
  LI: int64;
begin
  setlength(AComments, 0);
  LReports := ref Diagnostics(ADAM_TESTBED_LEX_BUDGET);
  LLexer := ref Lexer(ASource, LReports);
  LTokens := LLexer.ReadAll();
  LAt := ASource.FirstLineStart;
  for LI := 0 to LTokens.Count - 1 do
    DoScanGap(ASource, LAt, LTokens.Items[LI].StartOffset, AComments);
    if LTokens.Items[LI].EndOffset > LAt then
      LAt := LTokens.Items[LI].EndOffset;
    end;
  end;
end;

// A marker word's level as adam prints it (Diagnostics' words); "" when AWord is none
routine DoLevelOf(const AWord: string): string;
begin
  if AWord = "HINT" then
    return ADAM_MSG_DIAGNOSTICS_HINT;
  end;
  if AWord = "WARN" then
    return ADAM_MSG_DIAGNOSTICS_WARNING;
  end;
  if AWord = "ERROR" then
    return ADAM_MSG_DIAGNOSTICS_ERROR;
  end;
  if AWord = "FATAL" then
    return ADAM_MSG_DIAGNOSTICS_FATAL;
  end;
  return "";
end;

// True when AText starts with a report code: two capitals, then four digits
routine DoStartsWithCode(const AText: string): bool;
var
  LI: int64;
begin
  if len(AText) < ADAM_TESTBED_CODE_LENGTH then
    return false;
  end;
  for LI := 0 to ADAM_TESTBED_CODE_LENGTH - 1 do
    if LI < 2 then
      if not DoIsCapital(int64(uint8(AText[LI]))) then
        return false;
      end;
    else
      if not DoIsDigit(int64(uint8(AText[LI]))) then
        return false;
      end;
    end;
  end;
  return true;
end;

// Reads a marker's tail ATail (what follows its level word: CODE[@column][: text]) into
// AMarker; false when it is malformed
routine DoReadMarkerTail(const ATail: string; var AMarker: ReportMarker): bool;
var
  LAt: int64;
  LColumn: int64;
  LRest: string;
begin
  if not DoStartsWithCode(ATail) then
    return false;
  end;
  AMarker.Code := Substring(ATail, 0, ADAM_TESTBED_CODE_LENGTH);
  LAt := ADAM_TESTBED_CODE_LENGTH;
  AMarker.Column := 0;
  if (LAt < len(ATail)) and (ATail[LAt] = '@') then
    LAt := LAt + 1;
    LColumn := 0;
    if (LAt >= len(ATail)) or not DoIsDigit(int64(uint8(ATail[LAt]))) then
      return false;
    end;
    while (LAt < len(ATail)) and DoIsDigit(int64(uint8(ATail[LAt]))) do
      LColumn := LColumn * 10 + (int64(uint8(ATail[LAt])) - 0x30);
      if LColumn > 2147483647 then
        return false;
      end;
      LAt := LAt + 1;
    end;
    AMarker.Column := int32(LColumn);
  end;
  AMarker.Message := "";
  LRest := Trim(Substring(ATail, LAt, len(ATail) - LAt));
  if LRest = "" then
    return true;
  end;
  if LRest[0] <> ':' then
    return false;
  end;
  AMarker.Message := Trim(Substring(LRest, 1, len(LRest) - 1));
  return true;
end;

// Reads one marker segment ASegment (the text after one //, trimmed) on line ALine. A segment
// that does not start with a marker word and a blank is comment text: nothing. A malformed
// marker is TB0009 at AAt
routine DoReadMarker(const ASegment: string; const ALine: int32; const ASource: ref SourceText;
  const AAt: int64; const AReports: ref Diagnostics; var ASpec: TestSpec);
var
  LSpace: int64;
  LMarker: ReportMarker;
  LCount: int64;
begin
  LSpace := IndexOf(" ", ASegment, 0);
  if LSpace < 0 then
    // A level word alone is a marker with nothing after it
    if DoLevelOf(ASegment) <> "" then
      DoReport(AReports, ASource, AAt, ADAM_ERR_TESTBED_009, ADAM_MSG_TESTBED_SPEC_BAD_MARKER,
        NoArgs().Str(ASegment));
    end;
    return;
  end;
  LMarker.Level := DoLevelOf(Substring(ASegment, 0, LSpace));
  if LMarker.Level = "" then
    return;
  end;
  if not DoReadMarkerTail(Trim(Substring(ASegment, LSpace + 1, len(ASegment) - LSpace - 1)),
    LMarker) then
    DoReport(AReports, ASource, AAt, ADAM_ERR_TESTBED_009, ADAM_MSG_TESTBED_SPEC_BAD_MARKER,
      NoArgs().Str(ASegment));
    return;
  end;
  LMarker.Line := ALine;
  LCount := len(ASpec.Markers);
  setlength(ASpec.Markers, LCount + 1);
  ASpec.Markers[LCount] := LMarker;
end;

// Reads the markers in AText (a comment's text after its first //) on line ALine: one segment
// before each further //
routine DoReadMarkers(const AText: string; const ALine: int32; const ASource: ref SourceText;
  const AAt: int64; const AReports: ref Diagnostics; var ASpec: TestSpec);
var
  LFrom: int64;
  LNext: int64;
  LDone: bool;
begin
  LFrom := 0;
  LDone := false;
  while not LDone do
    LNext := IndexOf("//", AText, LFrom);
    if LNext < 0 then
      DoReadMarker(Trim(Substring(AText, LFrom, len(AText) - LFrom)), ALine, ASource, AAt,
        AReports, ASpec);
      LDone := true;
    else
      DoReadMarker(Trim(Substring(AText, LFrom, LNext - LFrom)), ALine, ASource, AAt, AReports,
        ASpec);
      LFrom := LNext + 2;
    end;
  end;
end;

// Reads AText as one or more quoted values (\" and \\ inside) into AValues; false when it is
// not that
routine DoReadQuoted(const AText: string; var AValues: StringArray): bool;
var
  LAt: int64;
  LValue: string;
  LClosed: bool;
  LByte: int64;
  LCount: int64;
begin
  setlength(AValues, 0);
  LAt := DoLeadingBlanks(AText);
  while LAt < len(AText) do
    if AText[LAt] <> '"' then
      return false;
    end;
    LAt := LAt + 1;
    LValue := "";
    LClosed := false;
    while (LAt < len(AText)) and not LClosed do
      LByte := int64(uint8(AText[LAt]));
      if LByte = 0x5C then
        // A backslash takes only " and \ after it
        if LAt + 1 >= len(AText) then
          return false;
        end;
        LByte := int64(uint8(AText[LAt + 1]));
        if (LByte <> 0x22) and (LByte <> 0x5C) then
          return false;
        end;
        LValue := LValue + Substring(AText, LAt + 1, 1);
        LAt := LAt + 2;
      else
        if LByte = 0x22 then
          LClosed := true;
        else
          LValue := LValue + Substring(AText, LAt, 1);
        end;
        LAt := LAt + 1;
      end;
    end;
    if not LClosed then
      return false;
    end;
    // A value ends at a blank or the end
    if (LAt < len(AText)) and (uint8(AText[LAt]) > 0x20) then
      return false;
    end;
    LCount := len(AValues);
    setlength(AValues, LCount + 1);
    AValues[LCount] := LValue;
    LAt := LAt + DoLeadingBlanks(Substring(AText, LAt, len(AText) - LAt));
  end;
  return len(AValues) > 0;
end;

// Reads AText as an exit code (a whole number in int32's range) into AValue; false when it is
// not one
routine DoReadExitCode(const AText: string; var AValue: int32): bool;
var
  LValue: int64;
begin
  if not TryStrToInt(AText, LValue) then
    return false;
  end;
  if (LValue < -2147483648) or (LValue > 2147483647) then
    return false;
  end;
  AValue := int32(LValue);
  return true;
end;

// Reads one spec line ALine whose first byte is at AAt. AKeys holds the keys already given,
// each between bars (|kind|args|)
routine DoReadSpecLine(const ALine: string; const AAt: int64; const ASource: ref SourceText;
  const AReports: ref Diagnostics; var ASpec: TestSpec; var AKeys: string);
var
  LText: string;
  LTextAt: int64;
  LSpace: int64;
  LKey: string;
  LValue: string;
  LCount: int64;
begin
  LText := Trim(ALine);
  LTextAt := AAt + DoLeadingBlanks(ALine);
  if (LText = "") or StartsStr("--", LText) then
    return;
  end;

  // | text: one expected output line (one blank after the bar is the separator)
  if LText[0] = '|' then
    LValue := Substring(LText, 1, len(LText) - 1);
    if StartsStr(" ", LValue) then
      LValue := Substring(LValue, 1, len(LValue) - 1);
    end;
    LCount := len(ASpec.Expect);
    setlength(ASpec.Expect, LCount + 1);
    ASpec.Expect[LCount] := LValue;
    return;
  end;

  LSpace := IndexOf(" ", LText, 0);
  if LSpace < 0 then
    LKey := LText;
    LValue := "";
  else
    LKey := Substring(LText, 0, LSpace);
    LValue := Trim(Substring(LText, LSpace + 1, len(LText) - LSpace - 1));
  end;
  if IndexOf("|" + LKey + "|", AKeys, 0) >= 0 then
    DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_008, ADAM_MSG_TESTBED_SPEC_KEY_TWICE,
      NoArgs().Str(LKey));
    return;
  end;

  if LKey = "kind" then
    if LValue = "check" then
      ASpec.Kind := TestKind.Check;
    else
      if LValue = "error" then
        ASpec.Kind := TestKind.Error;
      else
        if LValue = "cli" then
          ASpec.Kind := TestKind.Cli;
        else
          if LValue = "run" then
            ASpec.Kind := TestKind.Run;
          else
            DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_005,
              ADAM_MSG_TESTBED_SPEC_BAD_KIND, NoArgs().Str(LValue));
            return;
          end;
        end;
      end;
    end;
  else
    if LKey = "args" then
      if not DoReadQuoted(LValue, ASpec.Args) then
        DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
          ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
          NoArgs().Str(LValue).Str(LKey).Str(ADAM_MSG_TESTBED_SPEC_WANT_QUOTED));
        return;
      end;
    else
      if LKey = "exitcode" then
        if not DoReadExitCode(LValue, ASpec.ExitCode) then
          DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
            ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
            NoArgs().Str(LValue).Str(LKey).Str(ADAM_MSG_TESTBED_SPEC_WANT_NUMBER));
          return;
        end;
      else
        if LKey = "warnings" then
          if LValue <> "allow" then
            DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_007,
              ADAM_MSG_TESTBED_SPEC_BAD_VALUE,
              NoArgs().Str(LValue).Str(LKey).Str(ADAM_MSG_TESTBED_SPEC_WANT_ALLOW));
            return;
          end;
          ASpec.WarningsAllow := true;
        else
          DoReport(AReports, ASource, LTextAt, ADAM_ERR_TESTBED_004,
            ADAM_MSG_TESTBED_SPEC_UNKNOWN_KEY, NoArgs().Str(LKey));
          return;
        end;
      end;
    end;
  end;
  AKeys := AKeys + LKey + "|";
end;

// Reads the @@test block in AComment (its "@@test" at byte ATestAt): each line up to "@@end".
// A second block is TB0002, one with no "@@end" TB0003. ASpecAt gets ATestAt for the first
routine DoReadSpecBlock(const ASource: ref SourceText; const AComment: FoundComment;
  const ATestAt: int64; const AReports: ref Diagnostics; var ASpec: TestSpec;
  var ASpecAt: int64; var AKeys: string);
var
  LText: string;
  LEnd: int64;
  LStop: int64;
  LAt: int64;
  LLineEnd: int64;
begin
  if ASpecAt >= 0 then
    DoReport(AReports, ASource, ATestAt, ADAM_ERR_TESTBED_002, ADAM_MSG_TESTBED_SPEC_TWICE,
      NoArgs());
    return;
  end;
  ASpecAt := ATestAt;
  LText := ASource.Slice(AComment.StartAt, AComment.StopAt);
  LEnd := DoIndexOfLineStart("@@end", LText, ATestAt - AComment.StartAt + 6);
  if LEnd < 0 then
    DoReport(AReports, ASource, ATestAt, ADAM_ERR_TESTBED_003, ADAM_MSG_TESTBED_SPEC_NO_END,
      NoArgs());
    return;
  end;
  LStop := AComment.StartAt + LEnd;
  LAt := ATestAt + 6;
  while LAt < LStop do
    LLineEnd := LAt;
    while (LLineEnd < LStop) and (ASource.ByteAt(LLineEnd) <> 0x0A) and
      (ASource.ByteAt(LLineEnd) <> 0x0D) do
      LLineEnd := LLineEnd + 1;
    end;
    DoReadSpecLine(ASource.Slice(LAt, LLineEnd), LAt, ASource, AReports, ASpec, AKeys);
    // Past the newline: CR LF, LF or CR
    LAt := LLineEnd;
    if (ASource.ByteAt(LAt) = 0x0D) and (ASource.ByteAt(LAt + 1) = 0x0A) then
      LAt := LAt + 2;
    else
      LAt := LAt + 1;
    end;
  end;
end;

// Reads one comment: a block holding "@@test" is the spec; a line comment, or a block whose
// text starts with //, holds markers
routine DoReadComment(const ASource: ref SourceText; const AComment: FoundComment;
  const AReports: ref Diagnostics; var ASpec: TestSpec; var ASpecAt: int64; var AKeys: string);
var
  LBody: string;
  LTest: int64;
begin
  if not AComment.IsBlock then
    DoReadMarkers(ASource.Slice(AComment.StartAt + 2, AComment.StopAt),
      ASource.LineOf(AComment.StartAt), ASource, AComment.StartAt, AReports, ASpec);
    return;
  end;
  LBody := ASource.Slice(AComment.StartAt + 2, AComment.StopAt);
  if EndsStr("*/", LBody) then
    LBody := Substring(LBody, 0, len(LBody) - 2);
  end;
  LTest := DoIndexOfLineStart("@@test", LBody, 0);
  if LTest >= 0 then
    DoReadSpecBlock(ASource, AComment, AComment.StartAt + 2 + LTest, AReports, ASpec, ASpecAt,
      AKeys);
    return;
  end;
  LBody := Trim(LBody);
  if StartsStr("//", LBody) then
    DoReadMarkers(Substring(LBody, 2, len(LBody) - 2), ASource.LineOf(AComment.StartAt),
      ASource, AComment.StartAt, AReports, ASpec);
  end;
end;

// The checks the whole spec needs once read: a kind, keys and markers that kind takes
routine DoCheckSpec(const ASource: ref SourceText; const ASpecAt: int64; const AKeys: string;
  const AReports: ref Diagnostics; const ASpec: TestSpec);
var
  LI: int64;
  LErrors: int64;
begin
  if ASpec.Kind = TestKind.Unset then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_005, ADAM_MSG_TESTBED_SPEC_NO_KIND,
      NoArgs());
    return;
  end;
  if (ASpec.Kind <> TestKind.Cli) and (ASpec.Kind <> TestKind.Run) then
    if IndexOf("|args|", AKeys, 0) >= 0 then
      DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
        NoArgs().Str("args").Str(TestKindText(ASpec.Kind)));
    end;
    if IndexOf("|exitcode|", AKeys, 0) >= 0 then
      DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
        NoArgs().Str("exitcode").Str(TestKindText(ASpec.Kind)));
    end;
    if len(ASpec.Expect) > 0 then
      DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_006, ADAM_MSG_TESTBED_SPEC_KEY_KIND,
        NoArgs().Str("|").Str(TestKindText(ASpec.Kind)));
    end;
  end;

  LErrors := 0;
  for LI := 0 to len(ASpec.Markers) - 1 do
    if IsErrorLevel(ASpec.Markers[LI].Level) then
      LErrors := LErrors + 1;
    end;
  end;
  if (ASpec.Kind = TestKind.Check) and (LErrors > 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_010, ADAM_MSG_TESTBED_SPEC_CHECK_ERROR,
      NoArgs());
  end;
  if (ASpec.Kind = TestKind.Run) and (LErrors > 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_010, ADAM_MSG_TESTBED_SPEC_RUN_ERROR,
      NoArgs());
  end;
  if (ASpec.Kind = TestKind.Error) and (LErrors = 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_010, ADAM_MSG_TESTBED_SPEC_ERROR_NONE,
      NoArgs());
  end;
  if (ASpec.Kind = TestKind.Cli) and (len(ASpec.Markers) > 0) then
    DoReport(AReports, ASource, ASpecAt, ADAM_ERR_TESTBED_010, ADAM_MSG_TESTBED_SPEC_CLI_MARKER,
      NoArgs());
  end;
end;

// Reads the spec of the test file APath, whose bytes are AText, into ASpec: its @@test block
// and its report markers. Every mistake is one report into AReports at the mistake; true when
// there is none
public routine ReadSpec(const APath: string; const AText: string; const AReports: ref Diagnostics;
  var ASpec: TestSpec): bool;
var
  LSource: ref SourceText;
  LComments: FoundCommentArray;
  LI: int64;
  LErrors: int64;
  LSpecAt: int64;
  LKeys: string;
begin
  LErrors := AReports.ErrorCount;
  ASpec.Kind := TestKind.Unset;
  setlength(ASpec.Args, 0);
  ASpec.ExitCode := 0;
  setlength(ASpec.Expect, 0);
  ASpec.WarningsAllow := false;
  setlength(ASpec.Markers, 0);

  LSource := ref SourceText(APath, AText);
  DoFindComments(LSource, LComments);
  LSpecAt := -1;
  LKeys := "|";
  for LI := 0 to len(LComments) - 1 do
    DoReadComment(LSource, LComments[LI], AReports, ASpec, LSpecAt, LKeys);
  end;
  if LSpecAt < 0 then
    DoReport(AReports, LSource, LSource.FirstLineStart, ADAM_ERR_TESTBED_001,
      ADAM_MSG_TESTBED_SPEC_NONE, NoArgs());
    return false;
  end;
  DoCheckSpec(LSource, LSpecAt, LKeys, AReports, ASpec);
  return AReports.ErrorCount = LErrors;
end;

end.
