  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  Adam.Testbed.Runner.adam - adamtest's command line: collects the tests,
  runs each through adam.exe, compares, reports

    adamtest <ids / globs> | -all | -failed | -list [glob]
             [-root <dir>]... [-adam <exe>] | -h

  A test is a .adam file under a root (default: Adam's repo\bin\res\tests;
  -root, repeatable, replaces it), fixtures\ folders skipped. Its id is
  <folder>.<stem>, the folders below the root joined by dots; a file
  directly in a root takes the root folder's name. A glob takes * and ?.

  Each test's spec (Adam.Testbed.Spec) says what runs: check and error run
  `adam check <file>` and match adam's reports against the markers (an
  unmarked report fails, a marker nobody reported fails); cli runs adam with
  the spec's args and compares exit code and output lines; run runs `adam
  build <file> -o <output root>`, matches its reports as check does, then
  runs the exe it wrote and compares as cli does. adam runs in the
  output root (Adam's repo\bin\output), so nothing lands beside a test.
  A fixture the test uses (a unit in the test folder's fixtures\ whose
  module its imports name, or a used fixture's do) may hold markers too:
  its reports are matched against them, and every one is required once
  the run compiled it from source (a check parses every source; before
  each build its .acu in the output root is deleted, so the build
  compiles it again and its reports always come).
  Output is compared as lines: LF ends, trailing blanks and trailing empty
  lines dropped; every line is compared, a built program's [Heap] as
  any other (adam prints its own only with --heap); the first difference
  is shown. In args and | lines <DIR> is the test's folder, <BIN> the folder of
  the adam.exe run (what adam's $P: names), <OUT> the output root, <SYS> the
  system DLL folder the linker searches (SystemDir), all in '/' form, <CELL>
  the run cell (<triple>/<mode>: a build's exe is <OUT>/bin/<CELL>/), <ADAM>
  the adam exe run (-adam, else the one beside adamtest); <NUM>
  in a | or ir line matches any decimal number there (a time, which
  differs between runs; an ir id). adam's own check and build run
  with --quiet: its reports only.

  A test's deps (PaskalCPP's) are run or dep tests built into the output
  root, or cli tests run there (an adam command that writes what the test
  then uses, as adam cimport's unit; its exit and lines compared as when
  it runs as its own row), before it runs, their own deps first; the
  first that fails fails the test, its reasons under its id. A dep test
  is never picked on its own, not by -all, -failed or its id. Every spec is read once after the
  tests are collected and the graph is checked before anything is listed
  or runs: a dep naming no test (TR0010), one that builds nothing
  (TR0011), deps that go round (TR0012, the whole chain), a dep test no
  test names (TR0013), and a dep's own spec mistakes; any is exit 1.

  The ids that failed are kept in the output root's adamtest.failed for
  -failed. Exit codes as PaskalCPP's testbed: 0 every test passed, 1 a test
  failed, 2 a command line mistake (TR codes, printed with the usage).

  The default folders are the repo's release layout: adamtest.exe and
  adam.exe side by side in bin\, the tests in bin\res\tests, the builds in
  bin\output (PLAN-SELFHOST S6a moved them with the sources).
*******************************************************************************/

module unit Adam.Testbed.Runner;

import System.SysUtils, System.IO, Adam.Core.Common, Adam.Core.Messages,
  Adam.Compiler.SourceText, Adam.Compiler.Diagnostics, Adam.Testbed.Spec;

public const
  ADAM_ERR_TESTBED_101: string = "TR0001";   // the usage (a Hint)
  ADAM_ERR_TESTBED_102: string = "TR0002";   // an option adamtest does not know
  ADAM_ERR_TESTBED_103: string = "TR0003";   // an option with no value after it
  ADAM_ERR_TESTBED_104: string = "TR0004";   // nothing named to run
  ADAM_ERR_TESTBED_105: string = "TR0005";   // a glob no test matches
  ADAM_ERR_TESTBED_106: string = "TR0006";   // adam.exe is not there
  ADAM_ERR_TESTBED_107: string = "TR0007";   // a root that cannot be read
  ADAM_ERR_TESTBED_108: string = "TR0008";   // -failed with nothing kept
  ADAM_ERR_TESTBED_109: string = "TR0009";   // a test file that cannot be read
  ADAM_ERR_TESTBED_110: string = "TR0010";   // a dep that names no test
  ADAM_ERR_TESTBED_111: string = "TR0011";   // a dep that is no run, dep or cli test
  ADAM_ERR_TESTBED_112: string = "TR0012";   // deps that go round
  ADAM_ERR_TESTBED_113: string = "TR0013";   // a dep test no test names

  // adamtest's exit codes
  ADAM_TESTBED_EXIT_PASSED: int32 = 0;
  ADAM_TESTBED_EXIT_FAILED: int32 = 1;
  ADAM_TESTBED_EXIT_USAGE: int32 = 2;

const
  // The release layout, from adamtest.exe's folder (see the header)
  ADAM_TESTBED_DEFAULT_ROOT: string = "$P:res/tests";
  ADAM_TESTBED_DEFAULT_ADAM: string = "$P:adam" + ADAM_EXT_COFF_EXE;
  ADAM_TESTBED_OUTPUT_ROOT: string = "$P:output";

  ADAM_TESTBED_FAILED_FILE: string = "adamtest.failed";
  ADAM_TESTBED_FIXTURES: string = "fixtures";
  ADAM_TESTBED_CHECK: string = "check";
  // Every check and build adamtest runs prints only its reports (no banner, no status
  // line): only the reports are compared
  ADAM_TESTBED_QUIET: string = "--quiet";
  // A run test's build: the command and its output option (its exe ends in Common's
  // ADAM_EXT_COFF_EXE: win64 only, as every Adam run; the runner is a tool beside the
  // compiler, not a phase above the parts)
  ADAM_TESTBED_BUILD: string = "build";
  ADAM_TESTBED_OUTPUT_OPTION: string = "-o";
  // A run test's build at one of its spec's levels: adam's -opt and the level's name
  ADAM_TESTBED_LEVEL_OPTION: string = "-opt";
  // A test with ir lines is built with adam's --emit-ir, its .ir read beside its exe; an ir
  // line matches a .ir line whole or the text before the place Dump puts after it
  ADAM_TESTBED_EMIT_IR: string = "--emit-ir";
  ADAM_TESTBED_IR_PLACE: string = "  ; ";
  // The output root's part adam build writes every exe to, split by triple and mode
  // (<output>\bin\<triple>\<mode>\, SU2.5), and the triple every test runs on: the first
  // target's (every Adam run is win64 today, as the exe's ending above); the mode is the
  // build's level's (debug unless a levels line names others). The cell is <CELL> in a
  // spec, so no row spells a triple
  ADAM_TESTBED_BIN_DIR: string = "bin";
  // The output root's part a lib's static library goes to, split as bin is, and its name's
  // start (M8d: <output>\lib\<triple>\<mode>\lib<stem>.a, a dep lib's stand-in for its exe)
  ADAM_TESTBED_LIB_DIR: string = "lib";
  ADAM_TESTBED_LIB_PREFIX: string = "lib";
  // The output root's part each compiled unit's .acu goes to, split as bin is
  // (<output>\acu\<triple>\<mode>\<Unit>.acu): a marked fixture's is deleted before each
  // build, so the build compiles it from source and its reports come (DoColdFixtures)
  ADAM_TESTBED_ACU_DIR: string = "acu";
  ADAM_TESTBED_TRIPLE: string = "x86_64-windows-gnu";
  ADAM_TESTBED_DIR_HOLE: string = "<DIR>";
  ADAM_TESTBED_BIN_HOLE: string = "<BIN>";
  ADAM_TESTBED_OUT_HOLE: string = "<OUT>";
  ADAM_TESTBED_SYS_HOLE: string = "<SYS>";
  ADAM_TESTBED_CELL_HOLE: string = "<CELL>";
  ADAM_TESTBED_ADAM_HOLE: string = "<ADAM>";
  // In an expected line: any decimal number there (digits, a '.' and digits after it, as a
  // time is printed): what differs between runs
  ADAM_TESTBED_NUM_HOLE: string = "<NUM>";
  ADAM_TESTBED_BUDGET: int64 = 100;
  // Between two ids of a cycle's chain (TR0012)
  ADAM_TESTBED_CHAIN_ARROW: string = " -> ";
  // A cycle walk's marks: not seen, on the path, done
  ADAM_TESTBED_GRAPH_NEW: int64 = 0;
  ADAM_TESTBED_GRAPH_PATH: int64 = 1;
  ADAM_TESTBED_GRAPH_DONE: int64 = 2;

  // The exit codes adam check gives a clean and a failing program
  ADAM_TESTBED_CHECK_CLEAN: int32 = 0;
  ADAM_TESTBED_CHECK_ERRORS: int32 = 1;

type
  // One test file: its id and its full path ('/' form); from its spec (DoReadGraph): whether
  // it reads with no mistake, its kind, its deps and where they are (DepsLine / DepsColumn)
  FoundTest = record
    Id: string;
    Path: string;
    SpecOk: bool;
    Kind: TestKind;
    Deps: StringArray;
    DepsLine: int32;
    DepsColumn: int32;
  end;

  FoundTestArray = array of FoundTest;

  // A fixture a test uses (its import clauses name its module, or a used fixture's do) that
  // holds report markers: its path as adam prints it ('/' form, resolved), its module name,
  // the units it imports, its markers, and Required: whether this run compiled it from
  // source, so each marker needs its report (a check parses every source; a build its .acu
  // proves it, DoBuiltFixtures)
  MarkedFile = record
    Path: string;
    Module: string;
    Imports: StringArray;
    Markers: ReportMarkerArray;
    Required: bool;
  end;

  MarkedFileArray = array of MarkedFile;

  // What the command line asks for
  RunRequest = record
    Roots: StringArray;
    AdamExe: string;
    Masks: StringArray;
    RunAll: bool;
    RunFailed: bool;
    ListOnly: bool;
    ShowHelp: bool;
  end;

  // What a test's holes are filled with, all '/' form: <DIR> the test's folder, <BIN> the
  // folder of the adam.exe run, <OUT> the output root, <SYS> the system DLL folder the
  // linker searches after the library paths (Adam.Coff.Exports LibraryPaths: SystemDir),
  // <CELL> the run cell's part of a bin / lib / acu path (<triple>/<mode>, DoCellOf), <ADAM>
  // the adam exe adamtest runs (-adam, else the one beside it): a row that runs adam itself
  // names it, so it runs the compiler under test
  TestHoles = record
    Adam: string;
    Dir: string;
    Bin: string;
    Out: string;
    Sys: string;
    Cell: string;
  end;

// Appends AText to AList
routine DoAddString(var AList: StringArray; const AText: string);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := AText;
end;

// The run cell a test builds and runs in at ALevel, as a path part: <triple>/<mode>
// (ADAM_TESTBED_TRIPLE, the level's mode: debug, release_safe ...)
routine DoCellOf(const ALevel: OptLevel): string;
begin
  return ADAM_TESTBED_TRIPLE + "/" + OptLevelMode(ALevel);
end;

// APath with every '\' as '/' (how adam prints a path, and how <DIR> / <BIN> / <OUT> /
// <SYS> / <CELL> read)
routine DoSlashes(const APath: string): string;
begin
  return ReplaceStr(APath, "\\", "/");
end;

// Prints one line
routine DoPrint(const AText: string);
begin
  println("{}", AText);
end;

// Reports the usage into AReports (a Hint with no place)
routine DoUsage(const AReports: ref Diagnostics);
begin
  AReports.Add(Severity.Hint, ADAM_ERR_TESTBED_101, NoPlace(), ADAM_MSG_TESTBED_USAGE, NoArgs());
end;

// One command line mistake into AReports (an Error with no place), the usage after it, all
// printed: ADAM_TESTBED_EXIT_USAGE
routine DoMistake(const AReports: ref Diagnostics; const ACode: string; const ATemplate: string;
  const AArgs: MessageArgs): int32;
begin
  AReports.Add(Severity.Error, ACode, NoPlace(), ATemplate, AArgs);
  DoUsage(AReports);
  AReports.PrintAll();
  return ADAM_TESTBED_EXIT_USAGE;
end;

// Reads the command line into ARequest; false after a mistake reported into AReports
routine DoReadArgs(const AReports: ref Diagnostics; var ARequest: RunRequest): bool;
var
  LIndex: int32;
  LArg: string;
begin
  setlength(ARequest.Roots, 0);
  ARequest.AdamExe := ADAM_TESTBED_DEFAULT_ADAM;
  setlength(ARequest.Masks, 0);
  ARequest.RunAll := false;
  ARequest.RunFailed := false;
  ARequest.ListOnly := false;
  ARequest.ShowHelp := paramcount() < 1;
  LIndex := 1;
  while LIndex <= paramcount() do
    LArg := paramstr(LIndex);
    if (LArg = "-h") or (LArg = "--help") then
      ARequest.ShowHelp := true;
    else
      if LArg = "-all" then
        ARequest.RunAll := true;
      else
        if LArg = "-failed" then
          ARequest.RunFailed := true;
        else
          if LArg = "-list" then
            ARequest.ListOnly := true;
          else
            if (LArg = "-root") or (LArg = "-adam") then
              // Both take the next argument as their value
              if LIndex + 1 > paramcount() then
                AReports.Add(Severity.Error, ADAM_ERR_TESTBED_103, NoPlace(),
                  ADAM_MSG_TESTBED_NEEDS_VALUE, NoArgs().Str(LArg));
                return false;
              end;
              LIndex := LIndex + 1;
              if LArg = "-root" then
                DoAddString(ARequest.Roots, paramstr(LIndex));
              else
                ARequest.AdamExe := paramstr(LIndex);
              end;
            else
              if StartsStr("-", LArg) then
                AReports.Add(Severity.Error, ADAM_ERR_TESTBED_102, NoPlace(),
                  ADAM_MSG_TESTBED_UNKNOWN_OPTION, NoArgs().Str(LArg));
                return false;
              end;
              DoAddString(ARequest.Masks, LArg);
            end;
          end;
        end;
      end;
    end;
    LIndex := LIndex + 1;
  end;
  return true;
end;

// Adds the tests in ADir and below to ATests: a file's id is AFilePrefix.<stem>; a folder's
// files take ASubPrefix<folder> (fixtures\ folders skipped)
routine DoCollectFolder(const ADir: string; const AFilePrefix: string; const ASubPrefix: string;
  var ATests: FoundTestArray);
var
  LFiles: StringArray;
  LDirs: StringArray;
  LI: int64;
  LName: string;
  LCount: int64;
begin
  if GetFiles(ADir, LFiles) then
    for LI := 0 to len(LFiles) - 1 do
      LName := LFiles[LI];
      if EndsStr(ADAM_EXT_SOURCE, LName) then
        LCount := len(ATests);
        setlength(ATests, LCount + 1);
        ATests[LCount].Id := AFilePrefix + "." +
          Substring(LName, 0, len(LName) - len(ADAM_EXT_SOURCE));
        ATests[LCount].Path := ADir + "/" + LName;
      end;
    end;
  end;
  if GetDirectories(ADir, LDirs) then
    for LI := 0 to len(LDirs) - 1 do
      if LDirs[LI] <> ADAM_TESTBED_FIXTURES then
        DoCollectFolder(ADir + "/" + LDirs[LI], ASubPrefix + LDirs[LI],
          ASubPrefix + LDirs[LI] + ".", ATests);
      end;
    end;
  end;
end;

// A process's output AText as lines (see the header): LF ends, trailing blanks and trailing
// empty lines dropped. Every line is kept: adam prints its own heap report only with --heap,
// and a program's [Heap] report is compared as any line (DESIGN sec 8)
routine DoOutputLines(const AText: string): StringArray;
var
  LParts: StringArray;
  LLines: StringArray;
  LI: int64;
  LLine: string;
begin
  setlength(LLines, 0);
  LParts := SplitString(AText, "\n");
  for LI := 0 to len(LParts) - 1 do
    LLine := TrimRight(LParts[LI]);
    DoAddString(LLines, LLine);
  end;
  while (len(LLines) > 0) and (LLines[len(LLines) - 1] = "") do
    setlength(LLines, len(LLines) - 1);
  end;
  return LLines;
end;

// True when AWord is a report level as adam prints it
routine DoIsLevel(const AWord: string): bool;
begin
  return (AWord = ADAM_MSG_DIAGNOSTICS_HINT) or (AWord = ADAM_MSG_DIAGNOSTICS_WARNING) or
    IsErrorLevel(AWord);
end;

// Reads "<Level> <CODE>: <text>" into AReport's level, code and text; false when ARest is not
routine DoReadReportTail(const ARest: string; var AReport: ReportMarker): bool;
var
  LSpace: int64;
  LColon: int64;
begin
  LSpace := IndexOf(" ", ARest, 0);
  if LSpace < 0 then
    return false;
  end;
  LColon := IndexOf(": ", ARest, LSpace + 1);
  if LColon < 0 then
    return false;
  end;
  AReport.Level := Substring(ARest, 0, LSpace);
  if not DoIsLevel(AReport.Level) then
    return false;
  end;
  AReport.Code := Substring(ARest, LSpace + 1, LColon - LSpace - 1);
  AReport.Message := Substring(ARest, LColon + 2, len(ARest) - LColon - 2);
  return true;
end;

// Reads one line adam printed into AReport and APath: "<path>(<line>,<column>): <tail>", or
// "<tail>" for a report with no place (APath "", line and column 0). False when the line is
// no report
routine DoReadReport(const ALine: string; var APath: string; var AReport: ReportMarker): bool;
var
  LSpace: int64;
  LClose: int64;
  LOpen: int64;
  LComma: int64;
  LValue: int64;
begin
  APath := "";
  AReport.Line := 0;
  AReport.Column := 0;

  // A line that starts with a level word is a report with no place
  LSpace := IndexOf(" ", ALine, 0);
  if (LSpace > 0) and DoIsLevel(Substring(ALine, 0, LSpace)) then
    return DoReadReportTail(ALine, AReport);
  end;

  LClose := IndexOf("): ", ALine, 0);
  if LClose < 0 then
    return false;
  end;
  // The place's '(' is the last one before its "): " (a path may hold its own)
  LOpen := LClose - 1;
  while (LOpen >= 0) and (ALine[LOpen] <> '(') do
    LOpen := LOpen - 1;
  end;
  if LOpen <= 0 then
    return false;
  end;
  LComma := IndexOf(",", ALine, LOpen);
  if (LComma < 0) or (LComma > LClose) then
    return false;
  end;
  if not TryStrToInt(Substring(ALine, LOpen + 1, LComma - LOpen - 1), LValue) then
    return false;
  end;
  AReport.Line := int32(LValue);
  if not TryStrToInt(Substring(ALine, LComma + 1, LClose - LComma - 1), LValue) then
    return false;
  end;
  AReport.Column := int32(LValue);
  APath := Substring(ALine, 0, LOpen);
  return DoReadReportTail(Substring(ALine, LClose + 3, len(ALine) - LClose - 3), AReport);
end;

// AMarker as a spec writes it: LEVEL CODE[@column][: text] with adam's level word
routine DoMarkerText(const AMarker: ReportMarker): string;
var
  LText: string;
begin
  LText := AMarker.Level + " " + AMarker.Code;
  if AMarker.Column > 0 then
    LText := LText + "@" + IntToStr(int64(AMarker.Column));
  end;
  if AMarker.Message <> "" then
    LText := LText + ": " + AMarker.Message;
  end;
  return LText;
end;

// True when the report AReport (at APath) is what AMarker expects in the file AMarkerPath
routine DoMatches(const AReport: ReportMarker; const APath: string; const AMarker: ReportMarker;
  const AMarkerPath: string): bool;
begin
  if (APath <> AMarkerPath) or (AReport.Level <> AMarker.Level) or (AReport.Code <> AMarker.Code) or
    (AReport.Line <> AMarker.Line) then
    return false;
  end;
  if (AMarker.Column <> 0) and (AReport.Column <> AMarker.Column) then
    return false;
  end;
  return (AMarker.Message = "") or (AReport.Message = AMarker.Message);
end;

// Matches adam's report lines ALines against the markers of ASpec (the test file ATestPath)
// and of AFixtures (each at its own path): every report needs its own marker (an unmarked
// hint or warning passes under warnings allow) and every marker its report, a fixture's only
// when it is Required. Each mismatch is one line in ADetails
routine DoCompareReports(const ALines: StringArray; const ATestPath: string; const ASpec: TestSpec;
  const AFixtures: MarkedFileArray; var ADetails: StringArray);
var
  LMarkers: ReportMarkerArray;
  LFileOf: Int64Array;
  LUsed: array of bool;
  LI: int64;
  LJ: int64;
  LK: int64;
  LCount: int64;
  LFound: int64;
  LPath: string;
  LMarkerPath: string;
  LReport: ReportMarker;
begin
  // Every marker in one list, LFileOf its fixture's index beside it (-1: the test's own)
  setlength(LMarkers, len(ASpec.Markers));
  setlength(LFileOf, len(ASpec.Markers));
  for LJ := 0 to len(ASpec.Markers) - 1 do
    LMarkers[LJ] := ASpec.Markers[LJ];
    LFileOf[LJ] := -1;
  end;
  for LK := 0 to len(AFixtures) - 1 do
    LCount := len(LMarkers);
    setlength(LMarkers, LCount + len(AFixtures[LK].Markers));
    setlength(LFileOf, LCount + len(AFixtures[LK].Markers));
    for LJ := 0 to len(AFixtures[LK].Markers) - 1 do
      LMarkers[LCount + LJ] := AFixtures[LK].Markers[LJ];
      LFileOf[LCount + LJ] := LK;
    end;
  end;
  setlength(LUsed, len(LMarkers));
  for LJ := 0 to len(LUsed) - 1 do
    LUsed[LJ] := false;
  end;
  for LI := 0 to len(ALines) - 1 do
    if not DoReadReport(ALines[LI], LPath, LReport) then
      DoAddString(ADetails, NoArgs().Str(ALines[LI]).Fill(ADAM_MSG_TESTBED_STRANGE));
    else
      LFound := -1;
      LJ := 0;
      while (LFound < 0) and (LJ < len(LMarkers)) do
        if LFileOf[LJ] < 0 then
          LMarkerPath := ATestPath;
        else
          LMarkerPath := AFixtures[LFileOf[LJ]].Path;
        end;
        if not LUsed[LJ] and DoMatches(LReport, LPath, LMarkers[LJ], LMarkerPath) then
          LFound := LJ;
        end;
        LJ := LJ + 1;
      end;
      if LFound >= 0 then
        LUsed[LFound] := true;
      else
        if not (ASpec.WarningsAllow and not IsErrorLevel(LReport.Level)) then
          DoAddString(ADetails, NoArgs().Str(ALines[LI]).Fill(ADAM_MSG_TESTBED_UNEXPECTED));
        end;
      end;
    end;
  end;
  for LJ := 0 to len(LMarkers) - 1 do
    if not LUsed[LJ] then
      if LFileOf[LJ] < 0 then
        DoAddString(ADetails, NoArgs().Int(int64(LMarkers[LJ].Line))
          .Str(DoMarkerText(LMarkers[LJ])).Fill(ADAM_MSG_TESTBED_MISSING));
      else
        if AFixtures[LFileOf[LJ]].Required then
          DoAddString(ADetails, NoArgs().Str(ExtractFileName(AFixtures[LFileOf[LJ]].Path))
            .Int(int64(LMarkers[LJ].Line)).Str(DoMarkerText(LMarkers[LJ]))
            .Fill(ADAM_MSG_TESTBED_MISSING_IN));
        end;
      end;
    end;
  end;
end;

// The .acu a build at ALevel in AOutRoot writes for the unit AModule (DoCellOf's cell)
routine DoAcuOf(const AOutRoot: string; const AModule: string; const ALevel: OptLevel): string;
begin
  return AOutRoot + "/" + ADAM_TESTBED_ACU_DIR + "/" + DoCellOf(ALevel) + "/" + AModule +
    ADAM_EXT_ACU;
end;

// Reads the marked fixtures ATest uses into AFixtures (see MarkedFile): the units in its
// folder's fixtures\ whose module its import clauses name, or a used fixture's do, kept when
// they hold a marker. A malformed marker is a report into AReports (TB0009); a fixture that
// cannot be read is no fixture the test uses (adam reports the import)
routine DoReadFixtures(const ATest: FoundTest; const AReports: ref Diagnostics;
  var AFixtures: MarkedFileArray);
var
  LDir: string;
  LFiles: StringArray;
  LText: string;
  LModule: string;
  LImports: StringArray;
  LNeeded: StringArray;
  LFound: MarkedFileArray;
  LTexts: StringArray;
  LUsed: array of bool;
  LMarkers: ReportMarkerArray;
  LI: int64;
  LJ: int64;
  LK: int64;
  LCount: int64;
begin
  setlength(AFixtures, 0);
  LDir := ExtractFileDir(ATest.Path) + "/" + ADAM_TESTBED_FIXTURES;
  if (not DirectoryExists(LDir)) or (not GetFiles(LDir, LFiles)) then
    return;
  end;
  // Every fixture's module and imports, read once
  setlength(LFound, 0);
  setlength(LTexts, 0);
  for LI := 0 to len(LFiles) - 1 do
    if EndsStr(ADAM_EXT_SOURCE, LFiles[LI]) and ReadAllText(LDir + "/" + LFiles[LI], LText) then
      ReadModuleNames(LDir + "/" + LFiles[LI], LText, LModule, LImports);
      if LModule <> "" then
        LCount := len(LFound);
        setlength(LFound, LCount + 1);
        LFound[LCount].Path := LDir + "/" + LFiles[LI];
        LFound[LCount].Module := LModule;
        LFound[LCount].Imports := LImports;
        setlength(LFound[LCount].Markers, 0);
        LFound[LCount].Required := false;
        DoAddString(LTexts, LText);
      end;
    end;
  end;
  if (len(LFound) = 0) or (not ReadAllText(ATest.Path, LText)) then
    return;
  end;
  // The test's imports, then each used fixture's, walked once each: LNeeded only grows
  ReadModuleNames(ATest.Path, LText, LModule, LNeeded);
  setlength(LUsed, len(LFound));
  for LJ := 0 to len(LUsed) - 1 do
    LUsed[LJ] := false;
  end;
  LK := 0;
  while LK < len(LNeeded) do
    for LJ := 0 to len(LFound) - 1 do
      if not LUsed[LJ] and (LFound[LJ].Module = LNeeded[LK]) then
        LUsed[LJ] := true;
        for LI := 0 to len(LFound[LJ].Imports) - 1 do
          DoAddString(LNeeded, LFound[LJ].Imports[LI]);
        end;
      end;
    end;
    LK := LK + 1;
  end;
  for LJ := 0 to len(LFound) - 1 do
    if LUsed[LJ] then
      ReadMarkers(LFound[LJ].Path, LTexts[LJ], AReports, LMarkers);
      if len(LMarkers) > 0 then
        LCount := len(AFixtures);
        setlength(AFixtures, LCount + 1);
        AFixtures[LCount] := LFound[LJ];
        // adam prints a file's path as it resolved it, '/' form
        AFixtures[LCount].Path := DoSlashes(ResolvePath(LFound[LJ].Path));
        AFixtures[LCount].Markers := LMarkers;
      end;
    end;
  end;
end;

// Deletes each fixture of AFixtures' .acu a build at ALevel in AOutRoot would take (the output
// root is adamtest's own), so the build compiles it from source and reports what it holds
routine DoColdFixtures(var AFixtures: MarkedFileArray; const AOutRoot: string;
  const ALevel: OptLevel);
var
  LI: int64;
  LAcu: string;
begin
  for LI := 0 to len(AFixtures) - 1 do
    AFixtures[LI].Required := false;
    LAcu := DoAcuOf(AOutRoot, AFixtures[LI].Module, ALevel);
    if FileExists(LAcu) then
      DeleteFile(LAcu);
    end;
  end;
end;

// After a build at ALevel that DoColdFixtures prepared: a fixture whose .acu is there again
// was compiled from source by it, so its markers are Required
routine DoBuiltFixtures(var AFixtures: MarkedFileArray; const AOutRoot: string;
  const ALevel: OptLevel);
var
  LI: int64;
begin
  for LI := 0 to len(AFixtures) - 1 do
    AFixtures[LI].Required := FileExists(DoAcuOf(AOutRoot, AFixtures[LI].Module, ALevel));
  end;
end;

// True when AChar is a decimal digit
routine DoIsDigit(const AChar: char): bool;
begin
  return (AChar >= '0') and (AChar <= '9');
end;

// The length of the decimal number at AAt in AText: digits, then '.' and digits when they
// follow; 0 when no digit starts there
routine DoNumberLength(const AText: string; const AAt: int64): int64;
var
  LEnd: int64;
  LAfter: int64;
begin
  LEnd := AAt;
  while (LEnd < len(AText)) and DoIsDigit(AText[LEnd]) do
    LEnd := LEnd + 1;
  end;
  if LEnd = AAt then
    return 0;
  end;
  if (LEnd < len(AText)) and (AText[LEnd] = '.') then
    LAfter := LEnd + 1;
    while (LAfter < len(AText)) and DoIsDigit(AText[LAfter]) do
      LAfter := LAfter + 1;
    end;
    // A '.' with no digit after it ends the number before it
    if LAfter > LEnd + 1 then
      LEnd := LAfter;
    end;
  end;
  return LEnd - AAt;
end;

// True when AGot is the expected line AWant, each <NUM> in AWant standing for one decimal
// number (DoNumberLength) and everything else matched byte for byte
routine DoLineMatches(const AGot: string; const AWant: string): bool;
var
  LFrom: int64;
  LAt: int64;
  LHole: int64;
  LText: string;
  LCount: int64;
begin
  LFrom := 0;
  LAt := 0;
  LHole := IndexOf(ADAM_TESTBED_NUM_HOLE, AWant, LFrom);
  while LHole >= 0 do
    // The literal text before the hole, then one number in its place
    LText := Substring(AWant, LFrom, LHole - LFrom);
    if Substring(AGot, LAt, len(LText)) <> LText then
      return false;
    end;
    LAt := LAt + len(LText);
    LCount := DoNumberLength(AGot, LAt);
    if LCount = 0 then
      return false;
    end;
    LAt := LAt + LCount;
    LFrom := LHole + len(ADAM_TESTBED_NUM_HOLE);
    LHole := IndexOf(ADAM_TESTBED_NUM_HOLE, AWant, LFrom);
  end;
  return Substring(AGot, LAt, len(AGot) - LAt) = Substring(AWant, LFrom, len(AWant) - LFrom);
end;

// Compares adam's output lines AGot with the spec's AWant (holes already filled; a <NUM>
// hole matched by DoLineMatches): the first difference is one line in ADetails
routine DoCompareLines(const AGot: StringArray; const AWant: StringArray;
  var ADetails: StringArray);
var
  LI: int64;
begin
  LI := 0;
  while (LI < len(AGot)) and (LI < len(AWant)) do
    if not DoLineMatches(AGot[LI], AWant[LI]) then
      DoAddString(ADetails, NoArgs().Int(LI + 1).Str(AGot[LI]).Str(AWant[LI])
        .Fill(ADAM_MSG_TESTBED_LINE_DIFF));
      return;
    end;
    LI := LI + 1;
  end;
  if LI < len(AGot) then
    DoAddString(ADetails, NoArgs().Int(LI + 1).Str(AGot[LI]).Fill(ADAM_MSG_TESTBED_LINE_EXTRA));
    return;
  end;
  if LI < len(AWant) then
    DoAddString(ADetails, NoArgs().Int(LI + 1).Str(AWant[LI]).Fill(ADAM_MSG_TESTBED_LINE_SHORT));
  end;
end;

// The holes of the test ATest run through AAdam in AOutRoot (AOutRoot is '/' form already),
// built at ALevel (its <CELL>)
routine DoHolesOf(const ATest: FoundTest; const AAdam: string; const AOutRoot: string;
  const ALevel: OptLevel): TestHoles;
var
  LHoles: TestHoles;
begin
  LHoles.Adam := DoSlashes(AAdam);
  LHoles.Dir := DoSlashes(ExtractFileDir(ATest.Path));
  LHoles.Bin := DoSlashes(ExtractFileDir(AAdam));
  LHoles.Out := AOutRoot;
  LHoles.Sys := DoSlashes(SystemDir());
  LHoles.Cell := DoCellOf(ALevel);
  return LHoles;
end;

// AText with every <ADAM>, <DIR>, <BIN>, <OUT>, <SYS> and <CELL> filled from AHoles
routine DoFilled(const AText: string; const AHoles: TestHoles): string;
var
  LText: string;
begin
  LText := ReplaceStr(AText, ADAM_TESTBED_ADAM_HOLE, AHoles.Adam);
  LText := ReplaceStr(LText, ADAM_TESTBED_DIR_HOLE, AHoles.Dir);
  LText := ReplaceStr(LText, ADAM_TESTBED_BIN_HOLE, AHoles.Bin);
  LText := ReplaceStr(LText, ADAM_TESTBED_OUT_HOLE, AHoles.Out);
  LText := ReplaceStr(LText, ADAM_TESTBED_SYS_HOLE, AHoles.Sys);
  LText := ReplaceStr(LText, ADAM_TESTBED_CELL_HOLE, AHoles.Cell);
  return LText;
end;

// The spec's expected lines with their holes filled, compared as adam's output is
routine DoWantedLines(const ASpec: TestSpec; const AHoles: TestHoles): StringArray;
var
  LLines: StringArray;
  LI: int64;
begin
  setlength(LLines, 0);
  for LI := 0 to len(ASpec.Expect) - 1 do
    DoAddString(LLines, TrimRight(DoFilled(ASpec.Expect[LI], AHoles)));
  end;
  while (len(LLines) > 0) and (LLines[len(LLines) - 1] = "") do
    setlength(LLines, len(LLines) - 1);
  end;
  return LLines;
end;

// The exe a run or dep test ATest builds at ALevel: <stem>.exe in AOutRoot's bin part for
// that level's cell, where adam build puts it (<output>\bin\<triple>\<mode>\, SU2.5)
routine DoExeOf(const ATest: FoundTest; const AOutRoot: string; const ALevel: OptLevel): string;
begin
  return AOutRoot + "/" + ADAM_TESTBED_BIN_DIR + "/" + DoCellOf(ALevel) + "/" +
    ChangeFileExt(ExtractFileName(ATest.Path), ADAM_EXT_COFF_EXE);
end;

// The static library a lib test ATest's build writes for ALevel's cell (M8d): lib<stem>.a
// in the output root's lib part
routine DoLibOf(const ATest: FoundTest; const AOutRoot: string; const ALevel: OptLevel): string;
begin
  return AOutRoot + "/" + ADAM_TESTBED_LIB_DIR + "/" + DoCellOf(ALevel) + "/" +
    ADAM_TESTBED_LIB_PREFIX + ChangeFileExt(ExtractFileName(ATest.Path), ADAM_EXT_AR);
end;

// Builds the run or dep test ATest (spec ASpec): `adam build <file> -o <AOutRoot>` in
// AOutRoot (with `-opt <ALevel>` when AGiveLevel: a levels line's build; else no -opt, the
// debug cell), its reports matched as check's (exit 0), its exe (DoExeOf, any old one
// deleted first) written; a dep's dll (a dll module's build, M8a: the exe's name with
// ADAM_EXT_COFF_DLL, any old one deleted first) stands for its exe, and so does a dep's lib
// (a lib module's build, M8d: lib<stem>.a in the lib part, DoLibOf). Every way it fails is
// a line in ADetails; true when the exe (or a dep's dll or lib) was written
routine DoBuildExe(const ATest: FoundTest; const ASpec: TestSpec; var AFixtures: MarkedFileArray;
  const AAdam: string; const AOutRoot: string; const ALevel: OptLevel; const AGiveLevel: bool;
  var ADetails: StringArray): bool;
var
  LExe: string;
  LDll: string;
  LLib: string;
  LArgs: StringArray;
  LOutput: string;
  LExit: uint32;
begin
  LExe := DoExeOf(ATest, AOutRoot, ALevel);
  if FileExists(LExe) then
    DeleteFile(LExe);
  end;
  LDll := ChangeFileExt(LExe, ADAM_EXT_COFF_DLL);
  if (ASpec.Kind = TestKind.Dep) and FileExists(LDll) then
    DeleteFile(LDll);
  end;
  LLib := DoLibOf(ATest, AOutRoot, ALevel);
  if (ASpec.Kind = TestKind.Dep) and FileExists(LLib) then
    DeleteFile(LLib);
  end;
  setlength(LArgs, 0);
  DoAddString(LArgs, ADAM_TESTBED_BUILD);
  DoAddString(LArgs, ADAM_TESTBED_QUIET);
  DoAddString(LArgs, ATest.Path);
  DoAddString(LArgs, ADAM_TESTBED_OUTPUT_OPTION);
  DoAddString(LArgs, AOutRoot);
  if AGiveLevel then
    DoAddString(LArgs, ADAM_TESTBED_LEVEL_OPTION);
    DoAddString(LArgs, OptLevelName(ALevel));
  end;
  // ir lines: the .ir written beside the exe (any old one deleted first)
  if len(ASpec.IrExpect) > 0 then
    DoAddString(LArgs, ADAM_TESTBED_EMIT_IR);
    if FileExists(ChangeFileExt(LExe, ADAM_EXT_IR)) then
      DeleteFile(ChangeFileExt(LExe, ADAM_EXT_IR));
    end;
  end;
  DoColdFixtures(AFixtures, AOutRoot, ALevel);
  LOutput := "";
  LExit := 0;
  if not RunProcess(AAdam, LArgs, AOutRoot, LOutput, LExit) then
    DoAddString(ADetails, NoArgs().Str(AAdam).Fill(ADAM_MSG_TESTBED_CANNOT_RUN));
    return false;
  end;
  DoBuiltFixtures(AFixtures, AOutRoot, ALevel);
  // adam prints the main module's path as it resolved it, '/' form
  DoCompareReports(DoOutputLines(LOutput), DoSlashes(ResolvePath(ATest.Path)), ASpec,
    AFixtures, ADetails);
  if int32(LExit) <> ADAM_TESTBED_CHECK_CLEAN then
    DoAddString(ADetails, NoArgs().Int(int64(int32(LExit))).Fill(ADAM_MSG_TESTBED_BUILD_EXIT));
    return false;
  end;
  if (ASpec.Kind = TestKind.Dep) and (FileExists(LDll) or FileExists(LLib)) then
    return true;
  end;
  if not FileExists(LExe) then
    DoAddString(ADetails, NoArgs().Str(LExe).Fill(ADAM_MSG_TESTBED_NO_EXE));
    return false;
  end;
  return true;
end;

// True when the .ir line AGot is AWant, the blanks around each left out: whole, or its text
// before the place Dump put after it; a <NUM> in AWant matches any decimal number there (an
// id that moves when the runtime gains a routine: f<NUM>)
routine DoIrLineMatches(const AGot: string; const AWant: string): bool;
var
  LPlace: int64;
begin
  if DoLineMatches(Trim(AGot), Trim(AWant)) then
    return true;
  end;
  LPlace := IndexOf(ADAM_TESTBED_IR_PLACE, AGot, 0);
  return (LPlace >= 0) and DoLineMatches(Trim(Substring(AGot, 0, LPlace)), Trim(AWant));
end;

// The ir lines of ASpec that ALevel's build is checked against (each one with no level or
// with ALevel's) looked for in the .ir the build wrote beside AExe, in order: each after
// the line where the one before was found (two equal ir lines are two .ir lines). The
// first one not found (or no .ir) is a line in ADetails, naming the line its search
// started at
routine DoCompareIr(const ASpec: TestSpec; const AExe: string; const ALevel: OptLevel;
  var ADetails: StringArray);
var
  LPath: string;
  LText: string;
  LLines: StringArray;
  LAt: int64;
  LStart: int64;
  LFound: bool;
  LI: int64;
begin
  LPath := ChangeFileExt(AExe, ADAM_EXT_IR);
  LText := "";
  if not ReadAllText(LPath, LText) then
    DoAddString(ADetails, NoArgs().Str(LPath).Fill(ADAM_MSG_TESTBED_NO_EXE));
    return;
  end;
  LLines := DoOutputLines(LText);
  LAt := 0;
  for LI := 0 to len(ASpec.IrExpect) - 1 do
    if (ASpec.IrLevels[LI] = "") or (ASpec.IrLevels[LI] = OptLevelName(ALevel)) then
      LFound := false;
      LStart := LAt;
      while (not LFound) and (LAt < len(LLines)) do
        if DoIrLineMatches(LLines[LAt], ASpec.IrExpect[LI]) then
          LFound := true;
        end;
        // past the line just looked at: the next ir line is looked for after a match
        LAt := LAt + 1;
      end;
      if not LFound then
        DoAddString(ADetails, NoArgs().Str(LPath).Str(ASpec.IrExpect[LI]).Int(LStart + 1)
          .Fill(ADAM_MSG_TESTBED_IR_MISSING));
        return;
      end;
    end;
  end;
end;

// Runs the run test ATest (spec ASpec) at ALevel: built by DoBuildExe (-opt when
// AGiveLevel), its .ir checked when it has ir lines (DoCompareIr), then its exe run in
// AOutRoot with the spec's args, its exit code and output lines compared. Every way it
// fails is a line in ADetails
routine DoRunBuiltAt(const ATest: FoundTest; const ASpec: TestSpec;
  var AFixtures: MarkedFileArray; const AAdam: string; const AOutRoot: string;
  const ALevel: OptLevel; const AGiveLevel: bool; var ADetails: StringArray);
var
  LHoles: TestHoles;
  LExe: string;
  LArgs: StringArray;
  LI: int64;
  LOutput: string;
  LExit: uint32;
begin
  if not DoBuildExe(ATest, ASpec, AFixtures, AAdam, AOutRoot, ALevel, AGiveLevel, ADetails) then
    return;
  end;
  LHoles := DoHolesOf(ATest, AAdam, AOutRoot, ALevel);
  LExe := DoExeOf(ATest, AOutRoot, ALevel);
  if len(ASpec.IrExpect) > 0 then
    DoCompareIr(ASpec, LExe, ALevel, ADetails);
  end;
  setlength(LArgs, 0);
  for LI := 0 to len(ASpec.Args) - 1 do
    DoAddString(LArgs, DoFilled(ASpec.Args[LI], LHoles));
  end;
  LOutput := "";
  LExit := 0;
  if not RunProcess(LExe, LArgs, AOutRoot, LOutput, LExit) then
    DoAddString(ADetails, NoArgs().Str(LExe).Fill(ADAM_MSG_TESTBED_CANNOT_RUN));
    return;
  end;
  if int32(LExit) <> ASpec.ExitCode then
    DoAddString(ADetails, NoArgs().Int(int64(int32(LExit))).Int(int64(ASpec.ExitCode))
      .Fill(ADAM_MSG_TESTBED_EXIT));
  end;
  // The exe's own [Heap] report is compared as any other line (DESIGN sec 8)
  DoCompareLines(DoOutputLines(LOutput), DoWantedLines(ASpec, LHoles), ADetails);
end;

// Runs the run test ATest (spec ASpec): once with no -opt in the debug cell when its spec
// names no levels, else once per level it names (-opt <level>, that level's cell), in order,
// each against the same expect; a level's failures are its lines in ADetails, each led by
// the level's name ([fast] ...)
routine DoRunBuilt(const ATest: FoundTest; const ASpec: TestSpec; var AFixtures: MarkedFileArray;
  const AAdam: string; const AOutRoot: string; var ADetails: StringArray);
var
  LLevel: OptLevel;
  LLevelDetails: StringArray;
  LI: int64;
  LJ: int64;
begin
  if len(ASpec.Levels) = 0 then
    DoRunBuiltAt(ATest, ASpec, AFixtures, AAdam, AOutRoot, OptLevel.Debug, false, ADetails);
    return;
  end;
  for LI := 0 to len(ASpec.Levels) - 1 do
    // the spec reader took only levels' names (DoReadLevels), so every name is found
    LLevel := OptLevel.Debug;
    if OptLevelOfName(ASpec.Levels[LI], LLevel) then
      setlength(LLevelDetails, 0);
      DoRunBuiltAt(ATest, ASpec, AFixtures, AAdam, AOutRoot, LLevel, true, LLevelDetails);
      for LJ := 0 to len(LLevelDetails) - 1 do
        DoAddString(ADetails, NoArgs().Str(ASpec.Levels[LI]).Str(LLevelDetails[LJ])
          .Fill(ADAM_MSG_TESTBED_AT_LEVEL));
      end;
    end;
  end;
end;

// Runs the test ATest whose spec is ASpec through AAdam in AOutRoot; every way it fails is a
// line in ADetails (none: it passed)
routine DoRunSpec(const ATest: FoundTest; const ASpec: TestSpec; var AFixtures: MarkedFileArray;
  const AAdam: string; const AOutRoot: string; var ADetails: StringArray);
var
  LHoles: TestHoles;
  LArgs: StringArray;
  LI: int64;
  LOutput: string;
  LExit: uint32;
  LWantExit: int32;
  LTestPath: string;
begin
  if ASpec.Kind = TestKind.Run then
    DoRunBuilt(ATest, ASpec, AFixtures, AAdam, AOutRoot, ADetails);
    return;
  end;
  // A dep test is only built (never picked on its own: DoRunPicked)
  if ASpec.Kind = TestKind.Dep then
    DoBuildExe(ATest, ASpec, AFixtures, AAdam, AOutRoot, OptLevel.Debug, false, ADetails);
    return;
  end;
  LHoles := DoHolesOf(ATest, AAdam, AOutRoot, OptLevel.Debug);
  setlength(LArgs, 0);
  if ASpec.Kind = TestKind.Cli then
    for LI := 0 to len(ASpec.Args) - 1 do
      DoAddString(LArgs, DoFilled(ASpec.Args[LI], LHoles));
    end;
    LWantExit := ASpec.ExitCode;
  else
    DoAddString(LArgs, ADAM_TESTBED_CHECK);
    DoAddString(LArgs, ADAM_TESTBED_QUIET);
    DoAddString(LArgs, ATest.Path);
    LWantExit := ADAM_TESTBED_CHECK_CLEAN;
    if ASpec.Kind = TestKind.Error then
      LWantExit := ADAM_TESTBED_CHECK_ERRORS;
    end;
  end;

  LOutput := "";
  LExit := 0;
  if not RunProcess(AAdam, LArgs, AOutRoot, LOutput, LExit) then
    DoAddString(ADetails, NoArgs().Str(AAdam).Fill(ADAM_MSG_TESTBED_CANNOT_RUN));
    return;
  end;
  if int32(LExit) <> LWantExit then
    DoAddString(ADetails, NoArgs().Int(int64(int32(LExit))).Int(int64(LWantExit))
      .Fill(ADAM_MSG_TESTBED_EXIT));
  end;
  if ASpec.Kind = TestKind.Cli then
    DoCompareLines(DoOutputLines(LOutput), DoWantedLines(ASpec, LHoles), ADetails);
  else
    // adam prints the main module's path as it resolved it, '/' form; a check parses every
    // source, so each used fixture's markers need their reports
    LTestPath := DoSlashes(ResolvePath(ATest.Path));
    for LI := 0 to len(AFixtures) - 1 do
      AFixtures[LI].Required := true;
    end;
    DoCompareReports(DoOutputLines(LOutput), LTestPath, ASpec, AFixtures, ADetails);
  end;
end;

// Reads the spec of ATest into ASpec, its mistakes into AReports (TR0009 when the file cannot
// be read); true when it reads with no mistake
routine DoReadTestSpec(const ATest: FoundTest; const AReports: ref Diagnostics;
  var ASpec: TestSpec): bool;
var
  LText: string;
begin
  if not ReadAllText(ATest.Path, LText) then
    // No spec: nothing of an earlier one is left in ASpec
    ASpec.Kind := TestKind.Unset;
    setlength(ASpec.Deps, 0);
    ASpec.DepsLine := 1;
    ASpec.DepsColumn := 1;
    AReports.Add(Severity.Error, ADAM_ERR_TESTBED_109, PlaceAt(ATest.Path, 1, 1),
      ADAM_MSG_TESTBED_CANNOT_READ, NoArgs());
    return false;
  end;
  return ReadSpec(ATest.Path, LText, AReports, ASpec);
end;

// Reads every test's spec once (its mistakes are reported when the test runs, a dep's by
// DoCheckGraph) and keeps on it what the dependency graph needs: SpecOk, Kind, Deps and
// where they are
routine DoReadGraph(var ATests: FoundTestArray);
var
  LI: int64;
  LReports: ref Diagnostics;
  LSpec: TestSpec;
begin
  for LI := 0 to len(ATests) - 1 do
    LReports := ref Diagnostics(ADAM_TESTBED_BUDGET);
    ATests[LI].SpecOk := DoReadTestSpec(ATests[LI], LReports, LSpec);
    ATests[LI].Kind := LSpec.Kind;
    ATests[LI].Deps := LSpec.Deps;
    ATests[LI].DepsLine := LSpec.DepsLine;
    ATests[LI].DepsColumn := LSpec.DepsColumn;
  end;
end;

// Where ATest's deps line is: its graph mistakes are reported there
routine DoDepsPlace(const ATest: FoundTest): SourcePlace;
begin
  return PlaceAt(ATest.Path, ATest.DepsLine, ATest.DepsColumn);
end;

// The index of the test whose id is AId in ATests; -1 when there is none
routine DoFindTest(const ATests: FoundTestArray; const AId: string): int64;
var
  LI: int64;
begin
  for LI := 0 to len(ATests) - 1 do
    if ATests[LI].Id = AId then
      return LI;
    end;
  end;
  return -1;
end;

// True when a test of kind AKind can be another test's dep: run and dep tests build into the
// output root, a cli test runs adam there (adam cimport writing the unit a run test imports);
// check and error tests make nothing a test can use
routine DoIsDepKind(const AKind: TestKind): bool;
begin
  return (AKind = TestKind.Run) or (AKind = TestKind.Dep) or (AKind = TestKind.Cli);
end;

// The test a dependency AId names when it can be built or run for another test: its index, or
// -1 when DoCheckGraph reports that edge (no such test, a kind that makes nothing) or the
// dep's own spec mistake. The graph checks after the edges follow only these, so one mistake
// gets one report
routine DoBuildableDep(const ATests: FoundTestArray; const AId: string): int64;
var
  LJ: int64;
begin
  LJ := DoFindTest(ATests, AId);
  if LJ < 0 then
    return -1;
  end;
  if not ATests[LJ].SpecOk then
    return -1;
  end;
  if not DoIsDepKind(ATests[LJ].Kind) then
    return -1;
  end;
  return LJ;
end;

// True when some test of ATests names the test at AIndex in its deps
routine DoIsNamedDep(const ATests: FoundTestArray; const AIndex: int64): bool;
var
  LI: int64;
  LK: int64;
begin
  for LI := 0 to len(ATests) - 1 do
    for LK := 0 to len(ATests[LI].Deps) - 1 do
      if ATests[LI].Deps[LK] = ATests[AIndex].Id then
        return true;
      end;
    end;
  end;
  return false;
end;

// A dep's spec mistakes: a test that is a dep (its kind, or named in some test's deps) is
// never run on its own, so its spec's reports go into AReports here
routine DoCheckDepSpecs(const ATests: FoundTestArray; const AReports: ref Diagnostics);
var
  LI: int64;
  LSpec: TestSpec;
begin
  for LI := 0 to len(ATests) - 1 do
    if not ATests[LI].SpecOk and ((ATests[LI].Kind = TestKind.Dep) or
      DoIsNamedDep(ATests, LI)) then
      DoReadTestSpec(ATests[LI], AReports, LSpec);
    end;
  end;
end;

// Every edge: a dep that names no test is TR0010, one whose test makes nothing a test can
// use (check, error) TR0011, both at the naming test's deps line
routine DoCheckDepEdges(const ATests: FoundTestArray; const AReports: ref Diagnostics);
var
  LI: int64;
  LK: int64;
  LJ: int64;
  LDep: string;
begin
  for LI := 0 to len(ATests) - 1 do
    for LK := 0 to len(ATests[LI].Deps) - 1 do
      LDep := ATests[LI].Deps[LK];
      LJ := DoFindTest(ATests, LDep);
      if LJ < 0 then
        AReports.Add(Severity.Error, ADAM_ERR_TESTBED_110, DoDepsPlace(ATests[LI]),
          ADAM_MSG_TESTBED_DEP_UNKNOWN, NoArgs().Str(LDep));
      else
        if ATests[LJ].SpecOk and not DoIsDepKind(ATests[LJ].Kind) then
          AReports.Add(Severity.Error, ADAM_ERR_TESTBED_111, DoDepsPlace(ATests[LI]),
            ADAM_MSG_TESTBED_DEP_NOT_BUILT,
            NoArgs().Str(LDep).Str(TestKindText(ATests[LJ].Kind)));
        end;
      end;
    end;
  end;
end;

// Depth first from the test at AIndex over the buildable edges. AMarks: ADAM_TESTBED_GRAPH_*;
// APath: the indexes on the walk. An edge back onto the path is a cycle, TR0012 once with
// its whole chain, at the deps line of the test whose edge closes it
routine DoCycleVisit(const ATests: FoundTestArray; const AIndex: int64; var AMarks: Int64Array;
  var APath: Int64Array; const AReports: ref Diagnostics);
var
  LK: int64;
  LJ: int64;
  LP: int64;
  LStart: int64;
  LChain: string;
begin
  AMarks[AIndex] := ADAM_TESTBED_GRAPH_PATH;
  setlength(APath, len(APath) + 1);
  APath[len(APath) - 1] := AIndex;
  for LK := 0 to len(ATests[AIndex].Deps) - 1 do
    LJ := DoBuildableDep(ATests, ATests[AIndex].Deps[LK]);
    if LJ >= 0 then
      if AMarks[LJ] = ADAM_TESTBED_GRAPH_PATH then
        // The chain: from LJ's place on the path to its end, then LJ again
        LStart := 0;
        for LP := 0 to len(APath) - 1 do
          if APath[LP] = LJ then
            LStart := LP;
          end;
        end;
        LChain := "";
        for LP := LStart to len(APath) - 1 do
          LChain := LChain + ATests[APath[LP]].Id + ADAM_TESTBED_CHAIN_ARROW;
        end;
        LChain := LChain + ATests[LJ].Id;
        AReports.Add(Severity.Error, ADAM_ERR_TESTBED_112, DoDepsPlace(ATests[AIndex]),
          ADAM_MSG_TESTBED_DEP_CYCLE, NoArgs().Str(LChain));
      else
        if AMarks[LJ] = ADAM_TESTBED_GRAPH_NEW then
          DoCycleVisit(ATests, LJ, AMarks, APath, AReports);
        end;
      end;
    end;
  end;
  setlength(APath, len(APath) - 1);
  AMarks[AIndex] := ADAM_TESTBED_GRAPH_DONE;
end;

// Every cycle once (TR0012): a cycle is a mistake found before anything runs, so no run
// walks a cyclic chain
routine DoCheckCycles(const ATests: FoundTestArray; const AReports: ref Diagnostics);
var
  LMarks: Int64Array;
  LPath: Int64Array;
  LI: int64;
begin
  setlength(LMarks, len(ATests));
  for LI := 0 to len(ATests) - 1 do
    LMarks[LI] := ADAM_TESTBED_GRAPH_NEW;
  end;
  setlength(LPath, 0);
  for LI := 0 to len(ATests) - 1 do
    if LMarks[LI] = ADAM_TESTBED_GRAPH_NEW then
      DoCycleVisit(ATests, LI, LMarks, LPath, AReports);
    end;
  end;
end;

// A dep test is never run for itself: one no test names is dead (TR0013, at its file)
routine DoCheckOrphans(const ATests: FoundTestArray; const AReports: ref Diagnostics);
var
  LI: int64;
begin
  for LI := 0 to len(ATests) - 1 do
    if (ATests[LI].Kind = TestKind.Dep) and not DoIsNamedDep(ATests, LI) then
      AReports.Add(Severity.Error, ADAM_ERR_TESTBED_113, PlaceAt(ATests[LI].Path, 1, 1),
        ADAM_MSG_TESTBED_DEP_UNUSED, NoArgs().Str(ATests[LI].Id));
    end;
  end;
end;

// The dependency graph of ATests checked before anything runs (PaskalCPP's DoCheckDeps ..
// DoCheckOrphans): every mistake into AReports; true when there is none
routine DoCheckGraph(const ATests: FoundTestArray; const AReports: ref Diagnostics): bool;
var
  LErrors: int64;
begin
  LErrors := AReports.ErrorCount;
  DoCheckDepSpecs(ATests, AReports);
  DoCheckDepEdges(ATests, AReports);
  DoCheckCycles(ATests, AReports);
  DoCheckOrphans(ATests, AReports);
  return AReports.ErrorCount = LErrors;
end;

// Post order from the test at AIndex: a dep's own deps first, each once (the graph is
// acyclic: DoCheckGraph)
routine DoChainVisit(const ATests: FoundTestArray; const AIndex: int64; var AChain: Int64Array);
var
  LK: int64;
  LJ: int64;
  LP: int64;
  LSeen: bool;
begin
  for LK := 0 to len(ATests[AIndex].Deps) - 1 do
    LJ := DoFindTest(ATests, ATests[AIndex].Deps[LK]);
    LSeen := LJ < 0;
    for LP := 0 to len(AChain) - 1 do
      if AChain[LP] = LJ then
        LSeen := true;
      end;
    end;
    if not LSeen then
      DoChainVisit(ATests, LJ, AChain);
      setlength(AChain, len(AChain) + 1);
      AChain[len(AChain) - 1] := LJ;
    end;
  end;
end;

// Builds every dep of the test at AIndex, direct or not, in build order, into AOutRoot (a cli
// dep runs as its own row does, its exit and lines compared). The first that fails stops it:
// each of its reasons is a line in ADetails under its id; true when every dep was made
routine DoBuildDeps(const ATests: FoundTestArray; const AIndex: int64; const AAdam: string;
  const AOutRoot: string; var ADetails: StringArray): bool;
var
  LChain: Int64Array;
  LI: int64;
  LK: int64;
  LReports: ref Diagnostics;
  LSpec: TestSpec;
  LDepDetails: StringArray;
  LDep: FoundTest;
  LFixtures: MarkedFileArray;
  LMade: bool;
begin
  setlength(LChain, 0);
  DoChainVisit(ATests, AIndex, LChain);
  for LI := 0 to len(LChain) - 1 do
    LDep := ATests[LChain[LI]];
    // Its spec read clean in DoReadGraph (DoCheckGraph holds that); read again for the
    // markers and the rest its build is matched against
    LReports := ref Diagnostics(ADAM_TESTBED_BUDGET);
    DoReadTestSpec(LDep, LReports, LSpec);
    DoReadFixtures(LDep, LReports, LFixtures);
    setlength(LDepDetails, 0);
    // A cli dep failed when any reason came; a build when DoBuildExe says so (its reports'
    // reasons alone never failed a dep build)
    if LSpec.Kind = TestKind.Cli then
      DoRunSpec(LDep, LSpec, LFixtures, AAdam, AOutRoot, LDepDetails);
      LMade := len(LDepDetails) = 0;
    else
      LMade := DoBuildExe(LDep, LSpec, LFixtures, AAdam, AOutRoot, OptLevel.Debug, false,
        LDepDetails);
    end;
    if not LMade then
      for LK := 0 to len(LDepDetails) - 1 do
        DoAddString(ADetails,
          NoArgs().Str(LDep.Id).Str(LDepDetails[LK]).Fill(ADAM_MSG_TESTBED_DEP_FAILED));
      end;
      return false;
    end;
  end;
  return true;
end;

// Runs the test at AIndex of ATests (its deps built first) and prints its result: PASS, or
// FAIL with every reason under it. True when it passed
routine DoRunTest(const ATests: FoundTestArray; const AIndex: int64; const AAdam: string;
  const AOutRoot: string): bool;
var
  LReports: ref Diagnostics;
  LSpec: TestSpec;
  LDetails: StringArray;
  LI: int64;
  LTest: FoundTest;
  LFixtures: MarkedFileArray;
begin
  LTest := ATests[AIndex];
  setlength(LDetails, 0);
  LReports := ref Diagnostics(ADAM_TESTBED_BUDGET);
  // A fixture's malformed marker is a spec mistake as the test's own (TB0009 at it)
  if DoReadTestSpec(LTest, LReports, LSpec) then
    DoReadFixtures(LTest, LReports, LFixtures);
    if (LReports.Count = 0) and DoBuildDeps(ATests, AIndex, AAdam, AOutRoot, LDetails) then
      DoRunSpec(LTest, LSpec, LFixtures, AAdam, AOutRoot, LDetails);
    end;
  end;
  if (LReports.Count = 0) and (len(LDetails) = 0) then
    DoPrint(NoArgs().Str(LTest.Id).Fill(ADAM_MSG_TESTBED_PASS));
    return true;
  end;
  DoPrint(NoArgs().Str(LTest.Id).Fill(ADAM_MSG_TESTBED_FAIL));
  LReports.PrintAll();
  for LI := 0 to len(LDetails) - 1 do
    DoPrint(NoArgs().Str(LDetails[LI]).Fill(ADAM_MSG_TESTBED_DETAIL));
  end;
  return false;
end;

// The ids -failed runs: the lines of the output root's adamtest.failed
routine DoFailedIds(const AFailedFile: string): StringArray;
var
  LText: string;
  LParts: StringArray;
  LIds: StringArray;
  LI: int64;
begin
  setlength(LIds, 0);
  if ReadAllText(AFailedFile, LText) then
    LParts := SplitString(LText, "\n");
    for LI := 0 to len(LParts) - 1 do
      if Trim(LParts[LI]) <> "" then
        DoAddString(LIds, Trim(LParts[LI]));
      end;
    end;
  end;
  return LIds;
end;

// True when AId is picked by ARequest: -all, or one of its masks
routine DoPicked(const AId: string; const ARequest: RunRequest): bool;
var
  LI: int64;
begin
  if ARequest.RunAll then
    return true;
  end;
  for LI := 0 to len(ARequest.Masks) - 1 do
    if MatchesGlob(AId, ARequest.Masks[LI]) then
      return true;
    end;
  end;
  return false;
end;

// The first of ARequest's masks no test in ATests matches; "" when every one matches one
routine DoUnmatchedMask(const ATests: FoundTestArray; const ARequest: RunRequest): string;
var
  LI: int64;
  LJ: int64;
  LHit: bool;
begin
  for LI := 0 to len(ARequest.Masks) - 1 do
    LHit := false;
    LJ := 0;
    while not LHit and (LJ < len(ATests)) do
      LHit := MatchesGlob(ATests[LJ].Id, ARequest.Masks[LI]);
      LJ := LJ + 1;
    end;
    if not LHit then
      return ARequest.Masks[LI];
    end;
  end;
  return "";
end;

// -list: every picked test (every test when no mask is named) with its kind (DoReadGraph's),
// and its deps on a line under it when it names any
routine DoList(const ATests: FoundTestArray; const ARequest: RunRequest);
var
  LI: int64;
  LK: int64;
  LDeps: string;
begin
  for LI := 0 to len(ATests) - 1 do
    if (len(ARequest.Masks) = 0) or DoPicked(ATests[LI].Id, ARequest) then
      DoPrint(NoArgs().Str(ATests[LI].Id).Str(TestKindText(ATests[LI].Kind))
        .Fill(ADAM_MSG_TESTBED_LIST));
      if len(ATests[LI].Deps) > 0 then
        LDeps := "";
        for LK := 0 to len(ATests[LI].Deps) - 1 do
          if LK > 0 then
            LDeps := LDeps + " ";
          end;
          LDeps := LDeps + ATests[LI].Deps[LK];
        end;
        DoPrint(NoArgs().Str(LDeps).Fill(ADAM_MSG_TESTBED_LIST_DEPS));
      end;
    end;
  end;
end;

// Collects the tests of every root in ARequest into ATests; a root that cannot be read is a
// mistake: its path ("" when every root reads)
routine DoCollect(const ARequest: RunRequest; var ATests: FoundTestArray): string;
var
  LI: int64;
  LRoot: string;
begin
  setlength(ATests, 0);
  for LI := 0 to len(ARequest.Roots) - 1 do
    LRoot := DoSlashes(ResolvePath(ARequest.Roots[LI]));
    while EndsStr("/", LRoot) do
      LRoot := Substring(LRoot, 0, len(LRoot) - 1);
    end;
    if (LRoot = "") or not DirectoryExists(LRoot) then
      return ARequest.Roots[LI];
    end;
    DoCollectFolder(LRoot, ExtractFileName(LRoot), "", ATests);
  end;
  return "";
end;

// Runs the picked tests of ATests, prints the summary, keeps the failed ids in AFailedFile:
// ADAM_TESTBED_EXIT_PASSED or ADAM_TESTBED_EXIT_FAILED
routine DoRunPicked(const ATests: FoundTestArray; const ARequest: RunRequest; const AAdam: string;
  const AOutRoot: string; const AFailedFile: string): int32;
var
  LI: int64;
  LPassed: int64;
  LFailed: int64;
  LFailedIds: string;
begin
  LPassed := 0;
  LFailed := 0;
  LFailedIds := "";
  for LI := 0 to len(ATests) - 1 do
    // A dep test is built only for the tests that name it, never picked on its own
    if (ATests[LI].Kind <> TestKind.Dep) and DoPicked(ATests[LI].Id, ARequest) then
      if DoRunTest(ATests, LI, AAdam, AOutRoot) then
        LPassed := LPassed + 1;
      else
        LFailed := LFailed + 1;
        LFailedIds := LFailedIds + ATests[LI].Id + "\n";
      end;
    end;
  end;
  WriteAllText(AFailedFile, LFailedIds);
  DoPrint(NoArgs().Int(LPassed).Int(LFailed).Int(LPassed + LFailed).Fill(ADAM_MSG_TESTBED_SUMMARY));
  if LFailed > 0 then
    return ADAM_TESTBED_EXIT_FAILED;
  end;
  return ADAM_TESTBED_EXIT_PASSED;
end;

// Runs adamtest's command line (see the header): the exit code for the process
public routine RunTests(): int32;
var
  LReports: ref Diagnostics;
  LRequest: RunRequest;
  LTests: FoundTestArray;
  LOutRoot: string;
  LFailedFile: string;
  LAdam: string;
  LBad: string;
begin
  LReports := ref Diagnostics(ADAM_TESTBED_BUDGET);
  if not DoReadArgs(LReports, LRequest) then
    DoUsage(LReports);
    LReports.PrintAll();
    return ADAM_TESTBED_EXIT_USAGE;
  end;
  if LRequest.ShowHelp then
    DoUsage(LReports);
    LReports.PrintAll();
    return ADAM_TESTBED_EXIT_PASSED;
  end;

  if len(LRequest.Roots) = 0 then
    DoAddString(LRequest.Roots, ADAM_TESTBED_DEFAULT_ROOT);
  end;
  LBad := DoCollect(LRequest, LTests);
  if LBad <> "" then
    return DoMistake(LReports, ADAM_ERR_TESTBED_107, ADAM_MSG_TESTBED_NO_ROOT, NoArgs().Str(LBad));
  end;
  // The deps graph is checked before anything is listed or runs: a mistake in it is the
  // suite's, so nothing runs (exit 1, as a failed test)
  DoReadGraph(LTests);
  if not DoCheckGraph(LTests, LReports) then
    LReports.PrintAll();
    return ADAM_TESTBED_EXIT_FAILED;
  end;
  if LRequest.ListOnly then
    DoList(LTests, LRequest);
    return ADAM_TESTBED_EXIT_PASSED;
  end;

  LOutRoot := DoSlashes(ResolvePath(ADAM_TESTBED_OUTPUT_ROOT));
  ForceDirectories(LOutRoot);
  LFailedFile := LOutRoot + "/" + ADAM_TESTBED_FAILED_FILE;
  if LRequest.RunFailed then
    LRequest.Masks := DoFailedIds(LFailedFile);
    if len(LRequest.Masks) = 0 then
      return DoMistake(LReports, ADAM_ERR_TESTBED_108, ADAM_MSG_TESTBED_NO_FAILED,
        NoArgs().Str(LFailedFile));
    end;
  end;
  if not LRequest.RunAll and (len(LRequest.Masks) = 0) then
    return DoMistake(LReports, ADAM_ERR_TESTBED_104, ADAM_MSG_TESTBED_NOTHING, NoArgs());
  end;
  if not LRequest.RunAll then
    LBad := DoUnmatchedMask(LTests, LRequest);
    if LBad <> "" then
      return DoMistake(LReports, ADAM_ERR_TESTBED_105, ADAM_MSG_TESTBED_NO_MATCH,
        NoArgs().Str(LBad));
    end;
  end;

  LAdam := ResolvePath(LRequest.AdamExe);
  if (LAdam = "") or not FileExists(LAdam) then
    return DoMistake(LReports, ADAM_ERR_TESTBED_106, ADAM_MSG_TESTBED_NO_ADAM,
      NoArgs().Str(LRequest.AdamExe));
  end;
  return DoRunPicked(LTests, LRequest, LAdam, LOutRoot, LFailedFile);
end;

end.
