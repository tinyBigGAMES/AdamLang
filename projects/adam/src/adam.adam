-------------------------------------------------------------------------------
  adam.adam - The program module of adam.exe

  Named adam because the exe takes the main module's name. It hands the
  command line to Adam.Driver.CLI and ends the process with its exit code
  (`return E;` sets ExitCode, BNF sec 5: RunCommandLine returns first, so
  every object it made is released before the teardowns run).
*******************************************************************************/

module exe adam;

// Adam's own std (bin\res\libs\std: System.SysUtils, System.Windows) and the compiler's units
// (src\): $R: is the project root (projects\adam, the folder holding project.toml), so the
// build works from any folder. adam.exe finds the std beside itself on its own; that line is
// for pcpp, which builds the generated copy until PLAN-SELFHOST S6z
@addmodulepath "$R:../../bin/res/libs/std";
@addmodulepath "$R:../../src";

// The exe's version resource and icon (BNF sec 2): the version and the identity from
// Adam.Core.Common, written there only; the Adam logo icon is res\assets' (his file). A
// PE's own resources: the linux adam is an ELF, which has neither, and shows no window
@ifdef TARGET_X86_64_WINDOWS_GNU
@addverinfo on;
@vimajor ADAM_MAJOR_VERSION;
@viminor ADAM_MINOR_VERSION;
@vipatch ADAM_PATCH_VERSION;
@viproductname ADAM_PRODUCT_NAME;
@videscription ADAM_CLI_DESCRIPTION;
@vifilename ADAM_COMPILER_EXE;
@vicompanyname ADAM_COMPANY_NAME;
@vicopyright ADAM_COPYRIGHT;
@exeicon ADAM_LOGO_ICON;
@endif

import Adam.Core.Common, Adam.Driver.Compiler, Adam.Driver.CLI;

const
  ADAM_CLI_DESCRIPTION: string = ADAM_PRODUCT_NAME + " CLI";

begin
  // This compiler's sources name it in every .acu it writes (ACU2): adam built from the same
  // sources on any host shares the shared cache, any change to them is another compiler
  SetCompilerSource(sourcehash());
  return RunCommandLine();
end.
