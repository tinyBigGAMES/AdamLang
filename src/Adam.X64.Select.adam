-------------------------------------------------------------------------------
  Adam.X64.Select.adam - x86_64 instruction selection (DESIGN sec 6)

  SelectFunction  one SSA function (Adam.Backend.Ssa) -> its machine code
                  (Adam.X64.Machine) over virtual registers. Every SSA value
                  gets one virtual register of its type's class (general,
                  or vector for the floats), except the ones every user
                  folds (below): a constant, slot, data address, offset,
                  shift, multiply or compare some selected instruction
                  reads as a register gets one, the others make no code.

  Folding (PLAN-ADAM M6 O19), the same at every level, each exact to the
  machine. An address (a load's, a store's, an atomic's, an offset's own
  lea) is an AddressPlan: a base (a register value, a slot, a funclet's
  parent slot, a data blob rip-relative) plus an index times 1, 2, 4 or 8
  (an offset by `shl k` (k <= 3) or `mul` 1 / 2 / 4 / 8 folds its scale)
  plus a displacement (constant offsets, below 2^30), through chains of
  offsets. A constant right operand that fits the instruction is its
  immediate (add, sub, and, or, xor, imul, cmp, a shift's count, a store's
  value, a call's argument, a ret's value, a phi's edge copy), and a constant
  left operand of add, sub, and, or, xor or a shift is moved into the result
  as an immediate (no register of its own); 0 compared is
  test, 0 moved into a register is xor (zero, where no flags are live); a
  multiply by 3, 5 or 9 is a lea, by 2^k a shl; a division or remainder by
  a constant other than 0, 1, -1 and the least value (unsigned: 2 up to
  2^(W-1) - 1) is a multiply by its magic number (Hacker's Delight 10-1 /
  10-2, Granlund-Montgomery) and shifts. A compare a branch of its block
  alone reads is fused into that branch: cmp / test / ucomis and the jcc of
  its condition (a float's = and <> keep their setcc pair). At fast a
  diamond or triangle whose arms are bare jumps into a join of 1 to
  ADAM_X64_SELECT_CMOV_PHIS integer phis (no arm a scope's first, last or
  target block) is no jump: the false values moved into temporaries, the
  flags, a cmov of each true value (a setcc for a 1 / 0 pair), the phis
  given them, a jump to the join; its arms make no machine block.

  Calls and the function's own parameters and result follow the ABI part's
  CallLayout (Adam.Backend.Parts): registers are named as the ABI names them
  and numbered by Adam.X64.Registers. At a call the stack arguments are written
  into the outgoing area first, then the register arguments, so a register
  written for the call is live only up to it; the call reads those
  registers and writes the ABI's volatile set. The parameters are copied
  out of their places at the start of the entry block, before anything can
  change them.

  A phi's value arrives by copies on each edge into its block, in two steps
  (every operand into a fresh register first, then each phi from its own),
  so phis that read each other see the values from before the edge. The
  copies of a jump go before the jump; a branch's edge into a block with
  phis gets a block of its own (an edge block holding the copies and a jump
  on), so the copies never run on the other edge.

  A funclet (a guard's finally run while its parent's frame unwinds: IR
  Parent) reaches its parent's slots from a frame base: its frame parameter
  copied after its parameters, rounded down as a realigned parent rounds its
  stack pointer; a parent slot is memory at the base plus the offset the
  parent's generated code gives it (FunctionCode.SlotOffsetOf), its address
  made there when it is used as a value. Every slot records its SSA slot
  (MachineFunction.SetSlotSource), so the generated code can name them.

  A malformed SSA function (the driver verifies before selecting) raises.
*******************************************************************************/

module unit Adam.X64.Select;

import System.SysUtils, Adam.Core.Common, Adam.Core.Containers, Adam.Backend.Ssa,
  Adam.Backend.Parts, Adam.X64.Registers, Adam.X64.Machine;

public const
  // Raised (an invariant broken) by an SSA function selection cannot take
  ADAM_X64_SELECT_FAULT_NO_BLOCKS: string = "X64 select: a function with no blocks: ";
  ADAM_X64_SELECT_FAULT_VOID: string = "X64 select: a void value at i";
  ADAM_X64_SELECT_FAULT_NO_VALUE: string = "X64 select: no value for i";
  ADAM_X64_SELECT_FAULT_THREAD_FORM: string = "X64 select: a thread-local model not generated yet at i";
  ADAM_X64_SELECT_FAULT_NO_REGISTER: string = "X64 select: the arch has no register '";
  ADAM_X64_SELECT_FAULT_PARAM_PLACE: string = "X64 select: a parameter outside the entry block at i";
  ADAM_X64_SELECT_FAULT_VARARGS: string = "X64 select: varargsstart in a function that is not variadic at i";
  ADAM_X64_SELECT_FAULT_ARGS: string = "X64 select: the arguments do not fit the callee at i";
  ADAM_X64_SELECT_FAULT_PHI_EDGE: string = "X64 select: a phi with no operand from b";
  ADAM_X64_SELECT_FAULT_NO_TARGET: string = "X64 select: no block of this function: b";
  ADAM_X64_SELECT_FAULT_PARENT: string =
    "X64 select: a value of another function that is no slot of a funclet's laid out parent: i";
  // The register a shift's count is in (the SDM's shl / shr / sar r/m, cl)
  ADAM_X64_SELECT_SHIFT_COUNT: string = "rcx";
  // A float32's / float64's sign bit, the mask a negation xors in (IEEE 754: -0.0 from
  // +0.0, a NaN's payload kept)
  ADAM_X64_SELECT_SIGN32: int64 = 0x80000000;
  ADAM_X64_SELECT_SIGN64: int64 = -0x7FFFFFFFFFFFFFFF - 1;
  // 2^63 as a float32's / float64's bits: where a float to uint64 conversion leaves the
  // signed range (cvttss2si / cvttsd2si stop at 2^63 - 1)
  ADAM_X64_SELECT_TWO63_32: int64 = 0x5F000000;
  ADAM_X64_SELECT_TWO63_64: int64 = 0x43E0000000000000;
  // The registers a division works in (the SDM's idiv / div r/m: the dividend rdx:rax, the
  // quotient into rax, the remainder into rdx)
  ADAM_X64_SELECT_DIVIDEND: string = "rax";
  ADAM_X64_SELECT_REMAINDER: string = "rdx";
  // The registers the byte string ops work in (the SDM's rep movsb / rep stosb: the
  // destination rdi, the source rsi, the count rcx, the byte stored al)
  ADAM_X64_SELECT_STRING_DEST: string = "rdi";
  ADAM_X64_SELECT_STRING_SOURCE: string = "rsi";
  ADAM_X64_SELECT_STRING_COUNT: string = "rcx";
  ADAM_X64_SELECT_STRING_BYTE: string = "rax";
  // The registers the atomics work in (the SDM's lock cmpxchg r/m, r compares with rax: the
  // value travels there for every atomic, and a cas's new value in rcx)
  ADAM_X64_SELECT_ATOMIC_VALUE: string = "rax";
  ADAM_X64_SELECT_ATOMIC_NEW: string = "rcx";
  // The largest displacement an address plan folds (2^30: room left for the frame offset
  // a slot adds before the encoder's 32-bit field), and how many offsets deep it looks
  ADAM_X64_SELECT_DISP_LIMIT: int64 = 0x40000000;
  ADAM_X64_SELECT_PLAN_DEPTH: int64 = 8;
  // The most phis a cmov diamond selects (each a mov and a cmov in the branch's block)
  ADAM_X64_SELECT_CMOV_PHIS: int64 = 4;
  // A 4-byte / 8-byte integer's least value (a signed division by it stays a division);
  // the 4-byte one written -0x7FFFFFFF - 1: 0x80000000 is a uint32 literal (BNF's literal
  // typing), its negation uint32 2147483648, which made every immediate fail DoImmFits
  ADAM_X64_SELECT_LEAST32: int64 = -0x7FFFFFFF - 1;
  ADAM_X64_SELECT_LEAST64: int64 = -0x7FFFFFFFFFFFFFFF - 1;

// The bytes of a value of AType; raises for void (AInstr: the instruction it is the type of)
routine DoWidth(const AType: IrType; const AInstr: int64): int64;
begin
  if AType = IrType.Void then
    raise(ADAM_X64_SELECT_FAULT_VOID + IntToStr(AInstr));
  end;
  if (AType = IrType.Bool) or (AType = IrType.Int8) or (AType = IrType.UInt8) then
    return 1;
  end;
  if (AType = IrType.Int16) or (AType = IrType.UInt16) then
    return 2;
  end;
  if (AType = IrType.Int32) or (AType = IrType.UInt32) or (AType = IrType.Float32) then
    return 4;
  end;
  return 8;
end;

// True for the types a vector register holds
routine DoIsVector(const AType: IrType): bool;
begin
  return (AType = IrType.Float32) or (AType = IrType.Float64);
end;

// AIfTrue when ACondition holds, else AIfFalse
routine DoPickOp(const ACondition: bool; const AIfTrue: X64Op; const AIfFalse: X64Op): X64Op;
begin
  if ACondition then
    return AIfTrue;
  end;
  return AIfFalse;
end;

// AIfTrue when ACondition holds, else AIfFalse
routine DoPickWidth(const ACondition: bool; const AIfTrue: int64; const AIfFalse: int64): int64;
begin
  if ACondition then
    return AIfTrue;
  end;
  return AIfFalse;
end;

// The flags condition a cmp leaves for APredicate: a signed order is less / greater, an
// unsigned one below / above (the SDM's Jcc / SETcc table); a float's after ucomiss /
// ucomisd: above / above or equal for every order, < and <= compared with the operands
// swapped (DoFloatCompare), since below would hold on a NaN; = / <> are completed by the
// parity flag there
routine DoCondOf(const APredicate: IrPredicate): X64Cond;
begin
  match APredicate of
    IrPredicate.Equal: return X64Cond.Equal;
    IrPredicate.NotEqual: return X64Cond.NotEqual;
    IrPredicate.SLess: return X64Cond.Less;
    IrPredicate.SLessEqual: return X64Cond.LessOrEqual;
    IrPredicate.SGreater: return X64Cond.Greater;
    IrPredicate.SGreaterEqual: return X64Cond.GreaterOrEqual;
    IrPredicate.ULess: return X64Cond.Below;
    IrPredicate.ULessEqual: return X64Cond.BelowOrEqual;
    IrPredicate.UGreater: return X64Cond.Above;
    IrPredicate.UGreaterEqual: return X64Cond.AboveOrEqual;
    IrPredicate.FEqual: return X64Cond.Equal;
    IrPredicate.FNotEqual: return X64Cond.NotEqual;
    IrPredicate.FLess: return X64Cond.Above;
    IrPredicate.FLessEqual: return X64Cond.AboveOrEqual;
    IrPredicate.FGreater: return X64Cond.Above;
    IrPredicate.FGreaterEqual: return X64Cond.AboveOrEqual;
  end;
  return X64Cond.Equal;
end;

// The class of the virtual register that holds a value of AType
routine DoClassOf(const AType: IrType): RegClass;
begin
  if DoIsVector(AType) then
    return RegClass.Vector;
  end;
  return RegClass.General;
end;

// True when AValue fits the immediate of an AWidth-byte operation as the encoder takes it:
// 1 and 2 bytes signed or unsigned, 4 bytes int32 or uint32, 8 bytes int32 (sign-extended)
routine DoImmFits(const AValue: int64; const AWidth: int64): bool;
begin
  if AWidth = 1 then
    return (AValue >= -128) and (AValue <= 255);
  end;
  if AWidth = 2 then
    return (AValue >= -32768) and (AValue <= 65535);
  end;
  if AWidth = 4 then
    return (AValue >= ADAM_X64_SELECT_LEAST32) and (AValue <= 0xFFFFFFFF);
  end;
  return (AValue >= ADAM_X64_SELECT_LEAST32) and (AValue <= 0x7FFFFFFF);
end;

// The condition that holds exactly when ACond does not (the encoding pairs them)
routine DoInvert(const ACond: X64Cond): X64Cond;
begin
  match ACond of
    X64Cond.Overflow: return X64Cond.NoOverflow;
    X64Cond.NoOverflow: return X64Cond.Overflow;
    X64Cond.Below: return X64Cond.AboveOrEqual;
    X64Cond.AboveOrEqual: return X64Cond.Below;
    X64Cond.Equal: return X64Cond.NotEqual;
    X64Cond.NotEqual: return X64Cond.Equal;
    X64Cond.BelowOrEqual: return X64Cond.Above;
    X64Cond.Above: return X64Cond.BelowOrEqual;
    X64Cond.Sign: return X64Cond.NoSign;
    X64Cond.NoSign: return X64Cond.Sign;
    X64Cond.Parity: return X64Cond.NoParity;
    X64Cond.NoParity: return X64Cond.Parity;
    X64Cond.Less: return X64Cond.GreaterOrEqual;
    X64Cond.GreaterOrEqual: return X64Cond.Less;
    X64Cond.LessOrEqual: return X64Cond.Greater;
    X64Cond.Greater: return X64Cond.LessOrEqual;
  end;
  return X64Cond.Equal;
end;

// True for the ops selection may fold into their users and make no code for (see the
// header): constants, slots, data addresses, offsets, shifts and multiplies (an address's
// index), compares (a branch's flags); each is pure, so one no user reads is dropped
routine DoIsFoldable(const AOp: IrOp): bool;
begin
  return (AOp = IrOp.Constant) or (AOp = IrOp.Slot) or (AOp = IrOp.Address) or
    (AOp = IrOp.Offset) or (AOp = IrOp.Shl) or (AOp = IrOp.Mul) or (AOp = IrOp.Compare);
end;

// The magic number and shift of a signed ABits-bit division by AD, 2 <= |AD| < 2^(ABits -
// 1) (Hacker's Delight 10-1): AMagic the multiplier as a signed ABits-bit value; the
// quotient is the high half of n * AMagic, plus n when AD > 0 > AMagic, minus n when AD <
// 0 < AMagic, shifted right arithmetically by AShift, plus 1 when that is negative. The
// arithmetic is unsigned and never leaves 64 bits (|nc| and |d| below 2^(ABits - 1))
routine DoSignedMagic(const AD: int64; const ABits: int64; var AMagic: int64;
  var AShift: int64);
var
  LTwo: uint64;
  LAd: uint64;
  LT: uint64;
  LAnc: uint64;
  LQ1: uint64;
  LR1: uint64;
  LQ2: uint64;
  LR2: uint64;
  LDelta: uint64;
  LP: int64;
begin
  LTwo := uint64(1) shl uint64(ABits - 1);
  if AD < 0 then
    LAd := uint64(0 - AD);
  else
    LAd := uint64(AD);
  end;
  // t = 2^(W-1) + (d < 0), |nc| = t - 1 - t mod |d|
  LT := LTwo;
  if AD < 0 then
    LT := LT + 1;
  end;
  LAnc := LT - 1 - LT mod LAd;
  LP := ABits - 1;
  LQ1 := LTwo div LAnc;
  LR1 := LTwo - LQ1 * LAnc;
  LQ2 := LTwo div LAd;
  LR2 := LTwo - LQ2 * LAd;
  // p up until 2^p / |nc| reaches |d| - 2^p mod |d|: q1 = 2^p / |nc|, q2 = 2^p / |d|
  while true do
    LP := LP + 1;
    LQ1 := LQ1 * 2;
    LR1 := LR1 * 2;
    if LR1 >= LAnc then
      LQ1 := LQ1 + 1;
      LR1 := LR1 - LAnc;
    end;
    LQ2 := LQ2 * 2;
    LR2 := LR2 * 2;
    if LR2 >= LAd then
      LQ2 := LQ2 + 1;
      LR2 := LR2 - LAd;
    end;
    LDelta := LAd - LR2;
    if not ((LQ1 < LDelta) or ((LQ1 = LDelta) and (LR1 = 0))) then
      leave;
    end;
  end;
  AMagic := ReadLowBits(int64(LQ2 + 1), ABits, true);
  if AD < 0 then
    AMagic := ReadLowBits(0 - AMagic, ABits, true);
  end;
  AShift := LP - ABits;
end;

// The magic number and shift of an unsigned ABits-bit division by AD, 2 <= AD < 2^(ABits
// - 1) (Hacker's Delight 10-2): with AAdd false the quotient is the high half of n * AMagic
// shifted right by AShift; with AAdd true it is ((n - hi) shr 1 + hi) shr (AShift - 1).
// AMagic holds the ABits-bit multiplier's bits; every step wraps at ABits bits (LMask)
routine DoUnsignedMagic(const AD: uint64; const ABits: int64; var AMagic: int64;
  var AShift: int64; var AAdd: bool);
var
  LTwo: uint64;
  LMask: uint64;
  LNc: uint64;
  LQ1: uint64;
  LR1: uint64;
  LQ2: uint64;
  LR2: uint64;
  LDelta: uint64;
  LP: int64;
begin
  LTwo := uint64(1) shl uint64(ABits - 1);
  LMask := LTwo + (LTwo - 1);
  AAdd := false;
  // nc = 2^W - 1 - (2^W - d) mod d
  LNc := LMask - ((LMask - AD + 1) mod AD);
  LP := ABits - 1;
  LQ1 := LTwo div LNc;
  LR1 := LTwo - LQ1 * LNc;
  LQ2 := (LTwo - 1) div AD;
  LR2 := (LTwo - 1) - LQ2 * AD;
  while true do
    LP := LP + 1;
    if LR1 >= LNc - LR1 then
      LQ1 := (LQ1 * 2 + 1) & LMask;
      LR1 := (LR1 * 2 - LNc) & LMask;
    else
      LQ1 := (LQ1 * 2) & LMask;
      LR1 := (LR1 * 2) & LMask;
    end;
    if LR2 + 1 >= AD - LR2 then
      if LQ2 >= LTwo - 1 then
        AAdd := true;
      end;
      LQ2 := (LQ2 * 2 + 1) & LMask;
      LR2 := (LR2 * 2 + 1 - AD) & LMask;
    else
      if LQ2 >= LTwo then
        AAdd := true;
      end;
      LQ2 := (LQ2 * 2) & LMask;
      LR2 := (LR2 * 2 + 1) & LMask;
    end;
    LDelta := AD - 1 - LR2;
    if not ((LP < 2 * ABits) and ((LQ1 < LDelta) or ((LQ1 = LDelta) and (LR1 = 0)))) then
      leave;
    end;
  end;
  AMagic := int64((LQ2 + 1) & LMask);
  AShift := LP - ABits;
end;

type
  // Where an address plan's base is (see the header): an SSA value in its register, a
  // slot of the function, a funclet's parent slot (off its frame base), a data blob
  // (rip-relative: no index)
  PlanBase = choices(Value, Slot, Parent, Blob);

  // How a multiply is selected (Selector.DoMulForm): imul by a register, imul by an
  // immediate, lea of x + x * (c - 1) for c 3 / 5 / 9, shl for c 2^k
  MulForm = choices(Register, Immediate, Lea, Shift);

  // One address as a memory place (see the header): Base the SSA id of the value, slot,
  // parent slot or data address; Index the SSA id of the index value (-1: none) times
  // Scale; Disp the displacement
  AddressPlan = object
    BaseKind: PlanBase;
    Base: int64;
    Index: int64;
    Scale: int64;
    Disp: int64;

    init(const ABaseKind: PlanBase; const ABase: int64);
    begin
      self.BaseKind := ABaseKind;
      self.Base := ABase;
      self.Index := -1;
      self.Scale := 0;
      self.Disp := 0;
    end;

    // ADisp added to the displacement
    method AddDisp(const ADisp: int64);
    begin
      self.Disp := self.Disp + ADisp;
    end;

    // The index AIndex times AScale; a data blob's base becomes its address in a register
    // (rip-relative memory takes no index)
    method SetIndex(const AIndex: int64; const AScale: int64);
    begin
      if self.BaseKind = PlanBase.Blob then
        self.BaseKind := PlanBase.Value;
      end;
      self.Index := AIndex;
      self.Scale := AScale;
    end;
  end;

  // One function's selection (see the header; per SSA id maps are System.SysUtils'
  // Int64Array / BoolArray)
  Selector = object
    hidden FModule: ref IrModule;
    hidden FRegisterTable: ref X64Registers;
    hidden FAbi: ref AbiPart;
    hidden FFunction: ref IrFunction;
    hidden FMachine: ref MachineFunction;
    hidden FOwnLayout: ref CallLayout;
    // A variadic function's homes and first variadic argument (nil for any other)
    hidden FOwnVarargs: ref VarargsLayout;
    hidden FVolatile: ref Int64List;
    // SSA instruction id -> its virtual register (-1: none), its slot (-1: no slot), and
    // whether some selected instruction reads it as a register (1; 0: not, or only folded:
    // DoMarkReads). Maps sized to the function (DoClearMaps), never to the module
    hidden FVRegOf: ref Int64Map;
    hidden FSlotOf: ref Int64Map;
    hidden FUsedAsValue: ref Int64Map;
    // SSA block id -> its machine block (-1: a block of another function)
    hidden FBlockOf: ref Int64Map;
    // The SSA block being selected, and the machine block instructions go into
    hidden FSource: int64;
    hidden FCurrent: int64;
    // The function's id; a funclet's generated parent (nil for any other function), each
    // parent slot's offset in the parent's frame by its SSA id (-1: none), the parent slots
    // the funclet uses, and the register its frame base is in (-1: none)
    hidden FFunctionId: int64;
    hidden FParent: ref FunctionCode;
    hidden FParentAt: ref Int64Map;
    hidden FParentSlots: ref Int64List;
    hidden FFrameBase: int64;
    // True from a tail call's jump to the IR ret after it: the jump has left the function,
    // the ret makes nothing (DoTailJump, DoRet)
    hidden FTailDone: bool;
    // SSA id -> how many operand references name it, and the last instruction naming it
    // (DoScan); a compare fused into its branch (1); an SSA block -> how many jump and branch
    // edges reach it
    hidden FUseCount: ref Int64Map;
    hidden FUserOf: ref Int64Map;
    hidden FFused: ref Int64Map;
    hidden FPredCount: ref Int64Map;
    // The cmov diamonds (see the header): an arm block that makes no machine block (1); a
    // branch's block -> its join, and the blocks the join's phis name for the true and the
    // false edge (the arm, or the branch's block itself for a triangle's direct edge)
    hidden FAbsorbed: ref Int64Map;
    hidden FDiamondJoin: ref Int64Map;
    hidden FDiamondTrue: ref Int64Map;
    hidden FDiamondFalse: ref Int64Map;

    init(const AModule: ref IrModule; const AAbi: ref AbiPart; const AParent: ref FunctionCode);
    begin
      self.FModule := AModule;
      self.FRegisterTable := ref X64Registers();
      self.FAbi := AAbi;
      self.FSource := 0;
      self.FCurrent := 0;
      self.FFunctionId := 0;
      self.FParent := AParent;
      self.FParentSlots := ref Int64List();
      self.FFrameBase := -1;
      self.FTailDone := false;
    end;

    // The arch's number of the register the ABI names AName; raises for a name it lacks
    hidden method DoPhysical(const AName: string): int64;
    var
      LNumber: int64;
    begin
      LNumber := self.FRegisterTable.NumberOf(AName);
      if LNumber < 0 then
        raise(ADAM_X64_SELECT_FAULT_NO_REGISTER + AName + "'");
      end;
      return LNumber;
    end;

    // A new operand naming the virtual register of SSA value AId; raises for no value
    hidden method DoVReg(const AId: int64): ref MachineOperand;
    begin
      if not self.FModule.IsInstr(AId) then
        raise(ADAM_X64_SELECT_FAULT_NO_VALUE + IntToStr(AId));
      end;
      if self.FVRegOf.Find(AId) < 0 then
        raise(ADAM_X64_SELECT_FAULT_NO_VALUE + IntToStr(AId));
      end;
      return VirtualOperand(self.FVRegOf.Find(AId));
    end;

    // The machine block of SSA block ABlock; raises for a block that is not this function's
    hidden method DoMachineBlock(const ABlock: int64): int64;
    begin
      if not self.FModule.IsBlock(ABlock) then
        raise(ADAM_X64_SELECT_FAULT_NO_TARGET + IntToStr(ABlock));
      end;
      if self.FBlockOf.Find(ABlock) < 0 then
        raise(ADAM_X64_SELECT_FAULT_NO_TARGET + IntToStr(ABlock));
      end;
      return self.FBlockOf.Find(ABlock);
    end;

    // A new instruction at the end of the current machine block
    hidden method DoEmit(const AOp: X64Op; const AWidth: int64; const ANode: int64): ref MachineInstr;
    var
      LInstr: ref MachineInstr;
    begin
      LInstr := ref MachineInstr(AOp, AWidth, ANode);
      self.FMachine.BlockAt(self.FCurrent).AddInstr(LInstr);
      return LInstr;
    end;

    // A new two-operand instruction (ADest first) at the end of the current machine block
    hidden method DoEmitPair(const AOp: X64Op; const AWidth: int64; const ADest: ref MachineOperand;
      const ASource: ref MachineOperand; const ANode: int64);
    var
      LInstr: ref MachineInstr;
    begin
      LInstr := self.DoEmit(AOp, AWidth, ANode);
      LInstr.AddOperand(ADest);
      LInstr.AddOperand(ASource);
    end;

    // A move of a value of AType from ASource to ADest (AInstr: the SSA instruction whose
    // type it is, for a fault)
    hidden method DoCopy(const AType: IrType; const ADest: ref MachineOperand;
      const ASource: ref MachineOperand; const AInstr: int64; const ANode: int64);
    begin
      if AType = IrType.Float32 then
        self.DoEmitPair(X64Op.MovSS, 0, ADest, ASource, ANode);
        return;
      end;
      if AType = IrType.Float64 then
        self.DoEmitPair(X64Op.MovSD, 0, ADest, ASource, ANode);
        return;
      end;
      self.DoEmitPair(X64Op.Mov, DoWidth(AType, AInstr), ADest, ASource, ANode);
    end;

    // True when AId is an instruction of this function of kind AKind
    hidden const method DoIsOwnKind(const AId: int64; const AKind: IrOp): bool;
    begin
      if not self.FModule.IsInstr(AId) then
        return false;
      end;
      if self.FModule.InstrAt(AId).Kind <> AKind then
        return false;
      end;
      return self.FModule.BlockAt(self.FModule.InstrAt(AId).Block).Owner = self.FFunctionId;
    end;

    // True when AId is a constant of this function a general register can hold (not a
    // float): what an immediate is made of
    hidden const method DoIsImmConstant(const AId: int64): bool;
    begin
      return self.DoIsOwnKind(AId, IrOp.Constant) and
        not DoIsVector(self.FModule.InstrAt(AId).ValueType);
    end;

    // True when operand AIndex of AInstr is an integer constant an AWidth-byte operation
    // takes as its immediate
    hidden const method DoImmAt(const AInstr: ref IrInstr; const AIndex: int64;
      const AWidth: int64): bool;
    begin
      if not self.DoIsImmConstant(AInstr.Operands[AIndex]) then
        return false;
      end;
      return DoImmFits(self.FModule.InstrAt(AInstr.Operands[AIndex]).Imm, AWidth);
    end;

    // True when the store AInstr writes a constant value as an immediate (a float's bits
    // too: mov of 4 or 8 bytes)
    hidden const method DoStoreImm(const AInstr: ref IrInstr): bool;
    var
      LValue: ref IrInstr;
    begin
      if not self.DoIsOwnKind(AInstr.Operands[1], IrOp.Constant) then
        return false;
      end;
      LValue := self.FModule.InstrAt(AInstr.Operands[1]);
      return DoImmFits(LValue.Imm, DoWidth(LValue.ValueType, AInstr.Operands[1]));
    end;

    // True when the call argument AId goes into its place as an immediate (an integer
    // constant fitting its own width: a register takes any, a stack place a sign-extended
    // 32-bit one)
    hidden const method DoArgImm(const AId: int64): bool;
    begin
      if not self.DoIsImmConstant(AId) then
        return false;
      end;
      return DoImmFits(self.FModule.InstrAt(AId).Imm,
        DoWidth(self.FModule.InstrAt(AId).ValueType, AId));
    end;

    // The plan of address AAddress taken whole: its slot, a funclet's parent slot, a data
    // blob of this function's, else the value in its register
    hidden const method DoLeafPlan(const AAddress: int64): ref AddressPlan;
    begin
      if self.FModule.IsInstr(AAddress) then
        if self.FSlotOf.Find(AAddress) >= 0 then
          return ref AddressPlan(PlanBase.Slot, AAddress);
        end;
        if self.FParentAt.Find(AAddress) >= 0 then
          return ref AddressPlan(PlanBase.Parent, AAddress);
        end;
        if self.DoIsOwnKind(AAddress, IrOp.Address) then
          return ref AddressPlan(PlanBase.Blob, AAddress);
        end;
      end;
      return ref AddressPlan(PlanBase.Value, AAddress);
    end;

    // The index APart (an offset's int64 byte count) makes: a shl of a 64-bit value by 0..3
    // or a mul of one by 1 / 2 / 4 / 8 is that value times the scale (both wrap at 64 bits,
    // as the address computation does), anything else itself times 1
    hidden const method DoIndexOf(const APart: int64; var AIndex: int64; var AScale: int64);
    var
      LPart: ref IrInstr;
      LFactor: int64;
    begin
      AIndex := APart;
      AScale := 1;
      if not (self.DoIsOwnKind(APart, IrOp.Shl) or self.DoIsOwnKind(APart, IrOp.Mul)) then
        return;
      end;
      LPart := self.FModule.InstrAt(APart);
      if not self.DoIsOwnKind(LPart.Operands[1], IrOp.Constant) then
        return;
      end;
      if DoIsVector(LPart.ValueType) or
        (DoWidth(self.FModule.InstrAt(LPart.Operands[0]).ValueType, LPart.Operands[0]) <> 8) then
        return;
      end;
      LFactor := self.FModule.InstrAt(LPart.Operands[1]).Imm;
      if LPart.Kind = IrOp.Shl then
        if (LFactor < 0) or (LFactor > 3) then
          return;
        end;
        LFactor := 1 shl LFactor;
      end;
      if (LFactor = 1) or (LFactor = 2) or (LFactor = 4) or (LFactor = 8) then
        AIndex := LPart.Operands[0];
        AScale := LFactor;
      end;
    end;

    // APart (an offset's byte count) added to APlan: a constant to the displacement while
    // it stays below ADAM_X64_SELECT_DISP_LIMIT, else an index while it has none; false
    // when it takes neither (APlan unchanged)
    hidden const method DoAddPart(const APlan: ref AddressPlan; const APart: int64): bool;
    var
      LImm: int64;
      LIndex: int64;
      LScale: int64;
    begin
      if self.DoIsOwnKind(APart, IrOp.Constant) then
        LImm := self.FModule.InstrAt(APart).Imm;
        if (LImm > -ADAM_X64_SELECT_DISP_LIMIT) and (LImm < ADAM_X64_SELECT_DISP_LIMIT) and
          (APlan.Disp + LImm > -ADAM_X64_SELECT_DISP_LIMIT) and
          (APlan.Disp + LImm < ADAM_X64_SELECT_DISP_LIMIT) then
          APlan.AddDisp(LImm);
          return true;
        end;
      end;
      if APlan.Index >= 0 then
        return false;
      end;
      self.DoIndexOf(APart, LIndex, LScale);
      APlan.SetIndex(LIndex, LScale);
      return true;
    end;

    // The plan of the offset AId (see the header): its base's plan (an own offset's, at
    // most ADAM_X64_SELECT_PLAN_DEPTH deep, else the base whole) with its byte count added;
    // when the base's plan takes no more, the base whole with it
    hidden const method DoPlanOffset(const AId: int64; const ADepth: int64): ref AddressPlan;
    var
      LInstr: ref IrInstr;
      LPlan: ref AddressPlan;
    begin
      LInstr := self.FModule.InstrAt(AId);
      if (ADepth < ADAM_X64_SELECT_PLAN_DEPTH) and
        self.DoIsOwnKind(LInstr.Operands[0], IrOp.Offset) then
        LPlan := self.DoPlanOffset(LInstr.Operands[0], ADepth + 1);
      else
        LPlan := self.DoLeafPlan(LInstr.Operands[0]);
      end;
      if self.DoAddPart(LPlan, LInstr.Operands[1]) then
        return LPlan;
      end;
      // A leaf has no index yet: this always takes it
      LPlan := self.DoLeafPlan(LInstr.Operands[0]);
      self.DoAddPart(LPlan, LInstr.Operands[1]);
      return LPlan;
    end;

    // The plan of address AAddress: an own offset's, else the address whole
    hidden const method DoPlanOf(const AAddress: int64): ref AddressPlan;
    begin
      if self.DoIsOwnKind(AAddress, IrOp.Offset) then
        return self.DoPlanOffset(AAddress, 0);
      end;
      return self.DoLeafPlan(AAddress);
    end;

    // The values APlan reads as registers (its value base, its index) added to AList
    hidden const method DoPlanReads(const APlan: ref AddressPlan; const AList: ref Int64List);
    begin
      if APlan.BaseKind = PlanBase.Value then
        AList.Add(APlan.Base);
      end;
      if APlan.Index >= 0 then
        AList.Add(APlan.Index);
      end;
    end;

    // APlan as a memory operand: a slot, a funclet's parent slot off its frame base, a data
    // blob rip-relative, or the base value's register, each at its displacement, with its
    // index register times its scale
    hidden method DoMemoryOf(const APlan: ref AddressPlan): ref MachineOperand;
    var
      LMemory: ref MachineOperand;
    begin
      if APlan.BaseKind = PlanBase.Slot then
        LMemory := SlotMemory(self.FSlotOf.Find(APlan.Base), APlan.Disp);
      else
        if APlan.BaseKind = PlanBase.Parent then
          LMemory := RegisterMemory(self.FFrameBase, true,
            self.FParentAt.Find(APlan.Base) + APlan.Disp);
        else
          if APlan.BaseKind = PlanBase.Blob then
            LMemory := RipMemory(SymbolClass.Data,
              self.FModule.DataAt(self.FModule.InstrAt(APlan.Base).Link).Symbol, "");
            LMemory.Disp := APlan.Disp;
          else
            LMemory := RegisterMemory(self.DoVReg(APlan.Base).Reg, true, APlan.Disp);
          end;
        end;
      end;
      if APlan.Index >= 0 then
        return IndexedMemory(LMemory, self.DoVReg(APlan.Index).Reg, true, APlan.Scale);
      end;
      return LMemory;
    end;

    // The memory a load, a store or an atomic at SSA address AAddress goes through: its plan
    hidden method DoAddressOf(const AAddress: int64): ref MachineOperand;
    begin
      return self.DoMemoryOf(self.DoPlanOf(AAddress));
    end;

    // AOperand recorded once as a parent slot of a funclet (FParentAt, FParentSlots) when it
    // is defined in another function (Verify lets a funclet use its parent's slots alone):
    // its offset is the one the parent's frame gave it
    hidden method DoParentSlot(const AOperand: int64);
    var
      LOffset: int64;
    begin
      if not self.FModule.IsInstr(AOperand) then
        return;
      end;
      if (self.FParentAt.Find(AOperand) >= 0) or
        (self.FModule.BlockAt(self.FModule.InstrAt(AOperand).Block).Owner = self.FFunctionId) then
        return;
      end;
      if (self.FParent = nil) or (self.FModule.InstrAt(AOperand).Kind <> IrOp.Slot) then
        raise(ADAM_X64_SELECT_FAULT_PARENT + IntToStr(AOperand) + " in " + self.FFunction.Symbol);
      end;
      LOffset := self.FParent.SlotOffsetOf(AOperand);
      if LOffset < 0 then
        raise(ADAM_X64_SELECT_FAULT_PARENT + IntToStr(AOperand) + " in " + self.FFunction.Symbol);
      end;
      self.FParentAt.Put(AOperand, LOffset);
      self.FParentSlots.Add(AOperand);
    end;

    // Every slot of the function in SSA order, each value's references and last user, each
    // block's jump and branch edges; then the compares fused into their branch, at fast the
    // cmov diamonds, and which values selected instructions read as registers (DoMarkReads)
    hidden method DoScan();
    var
      LBlocks: ref Int64List;
      LInstrs: ref Int64List;
      LInstr: ref IrInstr;
      LI: int64;
      LJ: int64;
      LK: int64;
      LOperand: int64;
    begin
      LBlocks := self.FFunction.Blocks;
      for LI := 0 to LBlocks.Count - 1 do
        LInstrs := self.FModule.BlockAt(LBlocks[LI]).Instrs;
        for LJ := 0 to LInstrs.Count - 1 do
          LInstr := self.FModule.InstrAt(LInstrs[LJ]);
          if LInstr.Kind = IrOp.Slot then
            self.FSlotOf.Put(LInstrs[LJ], self.FMachine.AddSlot(LInstr.Imm, LInstr.Align));
            self.FMachine.SetSlotSource(self.FSlotOf.Find(LInstrs[LJ]), LInstrs[LJ]);
          end;
          for LK := 0 to LInstr.Operands.Count - 1 do
            LOperand := LInstr.Operands[LK];
            self.DoParentSlot(LOperand);
            self.FUseCount.Put(LOperand, self.FUseCount.Find(LOperand) + 1);
            self.FUserOf.Put(LOperand, LInstrs[LJ]);
          end;
          if (LInstr.Kind = IrOp.Jump) or (LInstr.Kind = IrOp.Branch) then
            for LK := 0 to LInstr.Targets.Count - 1 do
              self.FPredCount.Put(LInstr.Targets[LK], self.FPredCount.Find(LInstr.Targets[LK]) + 1);
            end;
          end;
        end;
      end;
      self.DoFindFused();
      if self.FModule.Level = OptLevel.Fast then
        self.DoFindDiamonds();
      end;
      self.DoMarkReads();
    end;

    // True when the compare AInstr can set the flags a jcc reads by itself: an integer one,
    // or a float order (a float's = and <> need two conditions: DoFloatCompare)
    hidden const method DoFusable(const AInstr: ref IrInstr): bool;
    var
      LPredicate: IrPredicate;
    begin
      if not DoIsVector(self.FModule.InstrAt(AInstr.Operands[0]).ValueType) then
        return true;
      end;
      LPredicate := AInstr.Predicate;
      return (LPredicate = IrPredicate.FLess) or (LPredicate = IrPredicate.FLessEqual) or
        (LPredicate = IrPredicate.FGreater) or (LPredicate = IrPredicate.FGreaterEqual);
    end;

    // The compares fused into their branch (FFused, see the header): read once, by the
    // branch ending their own block, as its condition
    hidden method DoFindFused();
    var
      LBlocks: ref Int64List;
      LInstrs: ref Int64List;
      LInstr: ref IrInstr;
      LUser: ref IrInstr;
      LI: int64;
      LJ: int64;
    begin
      LBlocks := self.FFunction.Blocks;
      for LI := 0 to LBlocks.Count - 1 do
        LInstrs := self.FModule.BlockAt(LBlocks[LI]).Instrs;
        for LJ := 0 to LInstrs.Count - 1 do
          LInstr := self.FModule.InstrAt(LInstrs[LJ]);
          if (LInstr.Kind <> IrOp.Compare) or (self.FUseCount.Find(LInstrs[LJ]) <> 1) then
            skip;
          end;
          LUser := self.FModule.InstrAt(self.FUserOf.Find(LInstrs[LJ]));
          if (LUser.Kind = IrOp.Branch) and (LUser.Block = LInstr.Block) and
            (LUser.Operands[0] = LInstrs[LJ]) and self.DoFusable(LInstr) then
            self.FFused.Put(LInstrs[LJ], 1);
          end;
        end;
      end;
    end;

    // True when SSA block ABlock is a scope's first, last or target block (its machine
    // block must exist: Adam.X64.Arch's DoScopesOf)
    hidden const method DoIsScopeEdge(const ABlock: int64): bool;
    var
      LPosition: int64;
      LI: int64;
    begin
      LPosition := self.FFunction.Blocks.IndexOf(ABlock);
      for LI := 0 to self.FFunction.ScopeCount() - 1 do
        if (self.FFunction.ScopeFirst(LI) = LPosition) or
          (self.FFunction.ScopeLast(LI) = LPosition) or
          (self.FFunction.ScopeTarget(LI) = LPosition) then
          return true;
        end;
      end;
      return false;
    end;

    // True when SSA block ABlock can be a cmov diamond's arm: not the entry, no scope edge,
    // reached by one edge, its one instruction a jump
    hidden const method DoIsArm(const ABlock: int64): bool;
    var
      LInstrs: ref Int64List;
    begin
      if (ABlock = self.FFunction.Blocks[0]) or self.DoIsScopeEdge(ABlock) or
        (self.FPredCount.Find(ABlock) <> 1) or (self.FAbsorbed.Find(ABlock) = 1) then
        return false;
      end;
      LInstrs := self.FModule.BlockAt(ABlock).Instrs;
      return (LInstrs.Count = 1) and (self.FModule.InstrAt(LInstrs[0]).Kind = IrOp.Jump);
    end;

    // The block the arm ABlock jumps to
    hidden const method DoArmTarget(const ABlock: int64): int64;
    begin
      return self.FModule.InstrAt(self.FModule.BlockAt(ABlock).Instrs[0]).Targets[0];
    end;

    // The phis SSA block ABlock starts with
    hidden const method DoPhisOf(const ABlock: int64): ref Int64List;
    var
      LInstrs: ref Int64List;
      LPhis: ref Int64List;
      LJ: int64;
    begin
      LInstrs := self.FModule.BlockAt(ABlock).Instrs;
      LPhis := ref Int64List();
      for LJ := 0 to LInstrs.Count - 1 do
        if self.FModule.InstrAt(LInstrs[LJ]).Kind = IrOp.Phi then
          LPhis.Add(LInstrs[LJ]);
        end;
      end;
      return LPhis;
    end;

    // The operand of APhi on the edge from AFrom
    hidden const method DoPhiValue(const APhi: int64; const AFrom: int64): int64;
    var
      LPhi: ref IrInstr;
    begin
      LPhi := self.FModule.InstrAt(APhi);
      return LPhi.Operands[LPhi.Targets.IndexOf(AFrom)];
    end;

    // True when AJoin can be a cmov diamond's join for the edges from ATrue and AFalse: 1
    // to ADAM_X64_SELECT_CMOV_PHIS phis, each an integer naming both edges
    hidden const method DoIsJoin(const AJoin: int64; const ATrue: int64; const AFalse: int64): bool;
    var
      LPhis: ref Int64List;
      LPhi: ref IrInstr;
      LJ: int64;
    begin
      LPhis := self.DoPhisOf(AJoin);
      if (LPhis.Count = 0) or (LPhis.Count > ADAM_X64_SELECT_CMOV_PHIS) then
        return false;
      end;
      for LJ := 0 to LPhis.Count - 1 do
        LPhi := self.FModule.InstrAt(LPhis[LJ]);
        if DoIsVector(LPhi.ValueType) or (LPhi.Targets.IndexOf(ATrue) < 0) or
          (LPhi.Targets.IndexOf(AFalse) < 0) then
          return false;
        end;
      end;
      return true;
    end;

    // The cmov diamonds of the function (fast; see the header): a branch's block whose two
    // targets are arms jumping to one join (a diamond), or one target the join and the
    // other an arm jumping to it (a triangle)
    hidden method DoFindDiamonds();
    var
      LBlocks: ref Int64List;
      LInstrs: ref Int64List;
      LBranch: ref IrInstr;
      LBlock: int64;
      LTrue: int64;
      LFalse: int64;
      LJoin: int64;
      LTrueFrom: int64;
      LFalseFrom: int64;
      LI: int64;
    begin
      LBlocks := self.FFunction.Blocks;
      for LI := 0 to LBlocks.Count - 1 do
        LBlock := LBlocks[LI];
        LInstrs := self.FModule.BlockAt(LBlock).Instrs;
        if LInstrs.Count = 0 then
          skip;
        end;
        LBranch := self.FModule.InstrAt(LInstrs[LInstrs.Count - 1]);
        if (LBranch.Kind <> IrOp.Branch) or (LBranch.Targets[0] = LBranch.Targets[1]) then
          skip;
        end;
        LTrue := LBranch.Targets[0];
        LFalse := LBranch.Targets[1];
        LJoin := -1;
        LTrueFrom := LTrue;
        LFalseFrom := LFalse;
        if self.DoIsArm(LTrue) and self.DoIsArm(LFalse) and
          (self.DoArmTarget(LTrue) = self.DoArmTarget(LFalse)) then
          LJoin := self.DoArmTarget(LTrue);
        else
          if self.DoIsArm(LFalse) and (self.DoArmTarget(LFalse) = LTrue) then
            LJoin := LTrue;
            LTrueFrom := LBlock;
          else
            if self.DoIsArm(LTrue) and (self.DoArmTarget(LTrue) = LFalse) then
              LJoin := LFalse;
              LFalseFrom := LBlock;
            end;
          end;
        end;
        if (LJoin < 0) or (LJoin = LBlock) then
          skip;
        end;
        if not self.DoIsJoin(LJoin, LTrueFrom, LFalseFrom) then
          skip;
        end;
        self.FDiamondJoin.Put(LBlock, LJoin);
        self.FDiamondTrue.Put(LBlock, LTrueFrom);
        self.FDiamondFalse.Put(LBlock, LFalseFrom);
        if LTrueFrom <> LBlock then
          self.FAbsorbed.Put(LTrueFrom, 1);
        end;
        if LFalseFrom <> LBlock then
          self.FAbsorbed.Put(LFalseFrom, 1);
        end;
      end;
    end;

    // How a diamond's phi with ATrue on its true edge and AFalse on its false edge is set:
    // 0 a cmov, 1 a setcc of the condition (1 / 0), 2 a setcc of its inverse (0 / 1)
    hidden const method DoSetForm(const ATrue: int64; const AFalse: int64): int64;
    var
      LTrue: int64;
      LFalse: int64;
    begin
      if not (self.DoIsImmConstant(ATrue) and self.DoIsImmConstant(AFalse)) then
        return 0;
      end;
      LTrue := self.FModule.InstrAt(ATrue).Imm;
      LFalse := self.FModule.InstrAt(AFalse).Imm;
      if (LTrue = 1) and (LFalse = 0) then
        return 1;
      end;
      if (LTrue = 0) and (LFalse = 1) then
        return 2;
      end;
      return 0;
    end;

    // True when operand AK of the phi APhi is not copied on its edge as a register: an
    // integer constant (an immediate there), or an edge a cmov diamond selects (DoDiamond)
    hidden const method DoPhiSkips(const APhi: ref IrInstr; const AK: int64): bool;
    var
      LFrom: int64;
    begin
      if self.DoIsImmConstant(APhi.Operands[AK]) then
        return true;
      end;
      LFrom := APhi.Targets[AK];
      return (self.FAbsorbed.Find(LFrom) = 1) or (self.FDiamondJoin.Find(LFrom) = APhi.Block);
    end;

    // How the multiply AInstr is selected (MulForm): an integer one by a constant 3 / 5 / 9
    // a lea, by 2^k a shl, by one fitting imul's immediate (at 4 bytes for a 1-byte one)
    // that; anything else imul by a register
    hidden const method DoMulForm(const AInstr: ref IrInstr): MulForm;
    var
      LFactor: int64;
      LWidth: int64;
    begin
      if DoIsVector(AInstr.ValueType) or not self.DoIsImmConstant(AInstr.Operands[1]) then
        return MulForm.Register;
      end;
      LFactor := self.FModule.InstrAt(AInstr.Operands[1]).Imm;
      if (LFactor = 3) or (LFactor = 5) or (LFactor = 9) then
        return MulForm.Lea;
      end;
      if (LFactor > 1) and ((LFactor & (LFactor - 1)) = 0) then
        return MulForm.Shift;
      end;
      LWidth := DoWidth(AInstr.ValueType, AInstr.Operands[1]);
      if DoImmFits(LFactor, DoPickWidth(LWidth = 1, 4, LWidth)) then
        return MulForm.Immediate;
      end;
      return MulForm.Register;
    end;

    // True when the division or remainder AInstr goes by its constant divisor's magic number
    // (see the header): 4 or 8 bytes; signed by anything but 0, 1, -1 and the least value
    // (a fault, itself, the MIN div -1 fault, a quotient of 0 or 1), unsigned by 2 up to
    // 2^(W-1) - 1 (the canonical constant: a uint32's zero-extended, a uint64's bits)
    hidden const method DoMagicFits(const AInstr: ref IrInstr): bool;
    var
      LDivisor: int64;
      LWidth: int64;
    begin
      if not self.DoIsImmConstant(AInstr.Operands[1]) then
        return false;
      end;
      LDivisor := self.FModule.InstrAt(AInstr.Operands[1]).Imm;
      LWidth := DoWidth(AInstr.ValueType, AInstr.Operands[1]);
      if (LWidth <> 4) and (LWidth <> 8) then
        return false;
      end;
      if (AInstr.Kind = IrOp.SDiv) or (AInstr.Kind = IrOp.SRem) then
        return (LDivisor <> 0) and (LDivisor <> 1) and (LDivisor <> -1) and
          (LDivisor <> DoPickWidth(LWidth = 4, ADAM_X64_SELECT_LEAST32, ADAM_X64_SELECT_LEAST64));
      end;
      if LWidth = 4 then
        return (LDivisor >= 2) and (LDivisor < 0x80000000);
      end;
      return LDivisor >= 2;
    end;

    // The values the compare AInstr reads as registers (its flags: DoCompareFlags) added to
    // AList
    hidden const method DoCompareReads(const AInstr: ref IrInstr; const AList: ref Int64List);
    var
      LType: IrType;
    begin
      AList.Add(AInstr.Operands[0]);
      LType := self.FModule.InstrAt(AInstr.Operands[0]).ValueType;
      if DoIsVector(LType) or not self.DoImmAt(AInstr, 1, DoWidth(LType, AInstr.Operands[0])) then
        AList.Add(AInstr.Operands[1]);
      end;
    end;

    // The values the branch AInstr reads as registers added to AList: its fused compare's
    // operands or its bool, and a cmov diamond's values (not a setcc pair's constants)
    hidden const method DoBranchReads(const AInstr: ref IrInstr; const AList: ref Int64List);
    var
      LPhis: ref Int64List;
      LTrue: int64;
      LFalse: int64;
      LJoin: int64;
      LJ: int64;
    begin
      if self.FFused.Find(AInstr.Operands[0]) = 1 then
        self.DoCompareReads(self.FModule.InstrAt(AInstr.Operands[0]), AList);
      else
        AList.Add(AInstr.Operands[0]);
      end;
      LJoin := self.FDiamondJoin.Find(AInstr.Block);
      if LJoin < 0 then
        return;
      end;
      LPhis := self.DoPhisOf(LJoin);
      for LJ := 0 to LPhis.Count - 1 do
        LTrue := self.DoPhiValue(LPhis[LJ], self.FDiamondTrue.Find(AInstr.Block));
        LFalse := self.DoPhiValue(LPhis[LJ], self.FDiamondFalse.Find(AInstr.Block));
        if self.DoSetForm(LTrue, LFalse) = 0 then
          AList.Add(LTrue);
          AList.Add(LFalse);
        end;
      end;
    end;

    // The values instruction AId reads as registers once selected, added to AList (what its
    // selection below names by DoVReg: folded operands, immediates and plan parts not)
    hidden const method DoReadsOf(const AId: int64; const AList: ref Int64List);
    var
      LInstr: ref IrInstr;
      LKind: IrOp;
      LFirst: int64;
      LK: int64;
    begin
      LInstr := self.FModule.InstrAt(AId);
      LKind := LInstr.Kind;
      if LKind = IrOp.Load then
        self.DoPlanReads(self.DoPlanOf(LInstr.Operands[0]), AList);
        return;
      end;
      if LKind = IrOp.Store then
        self.DoPlanReads(self.DoPlanOf(LInstr.Operands[0]), AList);
        if not self.DoStoreImm(LInstr) then
          AList.Add(LInstr.Operands[1]);
        end;
        return;
      end;
      if IsAtomicOp(LKind) then
        self.DoPlanReads(self.DoPlanOf(LInstr.Operands[0]), AList);
        for LK := 1 to LInstr.Operands.Count - 1 do
          AList.Add(LInstr.Operands[LK]);
        end;
        return;
      end;
      if LKind = IrOp.Offset then
        self.DoPlanReads(self.DoPlanOffset(AId, 0), AList);
        return;
      end;
      if (LKind = IrOp.Add) or (LKind = IrOp.Sub) or (LKind = IrOp.BitAnd) or
        (LKind = IrOp.BitOr) or (LKind = IrOp.BitXor) then
        // Either integer operand may be an immediate (DoArithmetic / the bit ops)
        if DoIsVector(LInstr.ValueType) or
          not self.DoImmAt(LInstr, 0, DoWidth(LInstr.ValueType, AId)) then
          AList.Add(LInstr.Operands[0]);
        end;
        if DoIsVector(LInstr.ValueType) or
          not self.DoImmAt(LInstr, 1, DoWidth(LInstr.ValueType, AId)) then
          AList.Add(LInstr.Operands[1]);
        end;
        return;
      end;
      if LKind = IrOp.Mul then
        AList.Add(LInstr.Operands[0]);
        if self.DoMulForm(LInstr) = MulForm.Register then
          AList.Add(LInstr.Operands[1]);
        end;
        return;
      end;
      if (LKind = IrOp.Shl) or (LKind = IrOp.Shr) or (LKind = IrOp.Sar) then
        // The value shifted may be an immediate (DoShift)
        if not self.DoImmAt(LInstr, 0, DoWidth(LInstr.ValueType, AId)) then
          AList.Add(LInstr.Operands[0]);
        end;
        if not self.DoIsImmConstant(LInstr.Operands[1]) then
          AList.Add(LInstr.Operands[1]);
        end;
        return;
      end;
      if (LKind = IrOp.SDiv) or (LKind = IrOp.UDiv) or (LKind = IrOp.SRem) or
        (LKind = IrOp.URem) then
        AList.Add(LInstr.Operands[0]);
        if not self.DoMagicFits(LInstr) then
          AList.Add(LInstr.Operands[1]);
        end;
        return;
      end;
      if LKind = IrOp.Compare then
        self.DoCompareReads(LInstr, AList);
        return;
      end;
      if LKind = IrOp.Branch then
        self.DoBranchReads(LInstr, AList);
        return;
      end;
      if LKind = IrOp.Phi then
        for LK := 0 to LInstr.Operands.Count - 1 do
          if not self.DoPhiSkips(LInstr, LK) then
            AList.Add(LInstr.Operands[LK]);
          end;
        end;
        return;
      end;
      if LKind = IrOp.Ret then
        if (LInstr.Operands.Count > 0) and not self.DoIsImmConstant(LInstr.Operands[0]) then
          AList.Add(LInstr.Operands[0]);
        end;
        return;
      end;
      if (LKind = IrOp.Call) or (LKind = IrOp.CallExternal) or (LKind = IrOp.CallIndirect) then
        LFirst := 0;
        if LKind = IrOp.CallIndirect then
          // A calli's target
          AList.Add(LInstr.Operands[0]);
          LFirst := 1;
        end;
        for LK := LFirst to LInstr.Operands.Count - 1 do
          if not self.DoArgImm(LInstr.Operands[LK]) then
            AList.Add(LInstr.Operands[LK]);
          end;
        end;
        return;
      end;
      for LK := 0 to LInstr.Operands.Count - 1 do
        AList.Add(LInstr.Operands[LK]);
      end;
    end;

    // Which values selected instructions read as registers (FUsedAsValue), to a fixed point:
    // every instruction that is not foldable is selected; a foldable one is once one of
    // them reads it (its own reads then count too); one nothing reads makes no code
    hidden method DoMarkReads();
    var
      LBlocks: ref Int64List;
      LInstrs: ref Int64List;
      LWork: ref Int64List;
      LReads: ref Int64List;
      LValue: int64;
      LI: int64;
      LJ: int64;
      LK: int64;
    begin
      LWork := ref Int64List();
      LBlocks := self.FFunction.Blocks;
      for LI := 0 to LBlocks.Count - 1 do
        if self.FAbsorbed.Find(LBlocks[LI]) = 1 then
          skip;
        end;
        LInstrs := self.FModule.BlockAt(LBlocks[LI]).Instrs;
        for LJ := 0 to LInstrs.Count - 1 do
          if not DoIsFoldable(self.FModule.InstrAt(LInstrs[LJ]).Kind) then
            LWork.Add(LInstrs[LJ]);
          end;
        end;
      end;
      LK := 0;
      while LK < LWork.Count do
        LReads := ref Int64List();
        self.DoReadsOf(LWork[LK], LReads);
        LK := LK + 1;
        for LI := 0 to LReads.Count - 1 do
          LValue := LReads[LI];
          if (not self.FModule.IsInstr(LValue)) or (self.FUsedAsValue.Find(LValue) = 1) then
            skip;
          end;
          self.FUsedAsValue.Put(LValue, 1);
          if DoIsFoldable(self.FModule.InstrAt(LValue).Kind) and
            (self.FModule.BlockAt(self.FModule.InstrAt(LValue).Block).Owner = self.FFunctionId) then
            LWork.Add(LValue);
          end;
        end;
      end;
    end;

    // True when instruction AId makes no code: foldable and read by nothing selected
    hidden const method DoIsFolded(const AId: int64): bool;
    begin
      return DoIsFoldable(self.FModule.InstrAt(AId).Kind) and (self.FUsedAsValue.Find(AId) <> 1);
    end;

    // A virtual register for every value of the function a selected instruction reads or
    // that is selected itself (see the header: a folded one gets none)
    hidden method DoAssign();
    var
      LBlocks: ref Int64List;
      LInstrs: ref Int64List;
      LInstr: ref IrInstr;
      LI: int64;
      LJ: int64;
    begin
      LBlocks := self.FFunction.Blocks;
      for LI := 0 to LBlocks.Count - 1 do
        LInstrs := self.FModule.BlockAt(LBlocks[LI]).Instrs;
        for LJ := 0 to LInstrs.Count - 1 do
          LInstr := self.FModule.InstrAt(LInstrs[LJ]);
          if (LInstr.ValueType <> IrType.Void) and not self.DoIsFolded(LInstrs[LJ]) then
            self.FVRegOf.Put(LInstrs[LJ], self.FMachine.NewVReg(DoClassOf(LInstr.ValueType)));
          end;
        end;
      end;
      // A funclet's parent slot used as a value: its address, made from the frame base
      for LI := 0 to self.FParentSlots.Count - 1 do
        if self.FUsedAsValue.Find(self.FParentSlots[LI]) = 1 then
          self.FVRegOf.Put(self.FParentSlots[LI], self.FMachine.NewVReg(RegClass.General));
        end;
      end;
    end;

    // A funclet's frame base (FFrameBase), after its parameters: its frame parameter
    // (FrameValue) in a register of its own, rounded down as its parent's realigned frame
    // rounds the stack pointer (FrameLayout.Realign), so the parent's slot at offset N is
    // at base + N; then each parent slot used as a value gets that address
    hidden method DoFrameBase();
    var
      LNode: int64;
      LId: int64;
      LI: int64;
    begin
      LNode := self.FFunction.Node;
      self.FFrameBase := self.FMachine.NewVReg(RegClass.General);
      self.DoEmitPair(X64Op.Mov, DoWidth(IrType.Pointer, 0), VirtualOperand(self.FFrameBase),
        self.DoVReg(self.FFunction.FrameValue), LNode);
      if self.FParent.Frame.Realign > 0 then
        self.DoEmitPair(X64Op.BitAnd, DoWidth(IrType.Pointer, 0), VirtualOperand(self.FFrameBase),
          ImmediateOperand(0 - self.FParent.Frame.Realign), LNode);
      end;
      for LI := 0 to self.FParentSlots.Count - 1 do
        LId := self.FParentSlots[LI];
        if self.FVRegOf.Find(LId) >= 0 then
          self.DoEmitPair(X64Op.Lea, DoWidth(IrType.Pointer, LId), self.DoVReg(LId),
            RegisterMemory(self.FFrameBase, true, self.FParentAt.Find(LId)), LNode);
        end;
      end;
    end;

    // A variadic function's homes (FOwnVarargs): each argument register stored at its place
    // in the incoming area, first of all (no copy has used a register yet), so the variadic
    // arguments it carried sit beside the stacked ones
    hidden method DoHomes();
    var
      LHome: ref Location;
      LI: int64;
    begin
      if self.FOwnVarargs = nil then
        return;
      end;
      for LI := 0 to self.FOwnVarargs.HomeCount - 1 do
        LHome := self.FOwnVarargs.HomeAt(LI);
        self.DoEmitPair(X64Op.Mov, DoWidth(IrType.UInt64, 0), IncomingMemory(LHome.EntryOffset),
          PhysicalOperand(self.DoPhysical(LHome.RegisterName)), self.FFunction.Node);
      end;
    end;

    // Each parameter copied out of its register or its incoming place, at the start of the
    // entry block (after a variadic function's homes: DoHomes)
    hidden method DoParameters();
    var
      LInstrs: ref Int64List;
      LInstr: ref IrInstr;
      LPlace: ref Location;
      LJ: int64;
      LId: int64;
    begin
      self.DoHomes();
      LInstrs := self.FModule.BlockAt(self.FFunction.Blocks[0]).Instrs;
      for LJ := 0 to LInstrs.Count - 1 do
        LId := LInstrs[LJ];
        LInstr := self.FModule.InstrAt(LId);
        if LInstr.Kind = IrOp.Parameter then
          LPlace := self.FOwnLayout.ArgAt(LInstr.Imm);
          if LPlace.Kind = LocationKind.Register then
            self.DoCopy(LInstr.ValueType, self.DoVReg(LId),
              PhysicalOperand(self.DoPhysical(LPlace.RegisterName)), LId, LInstr.Node);
          else
            self.DoCopy(LInstr.ValueType, self.DoVReg(LId), IncomingMemory(LPlace.EntryOffset),
              LId, LInstr.Node);
          end;
        end;
      end;
      if self.FFunction.Parent <> 0 then
        self.DoFrameBase();
      end;
    end;

    // AValue into the register ADest at AWidth bytes: 0 by zero (xor: where selection puts
    // a value in, no flags are live), anything else by a mov of the immediate
    hidden method DoLoadImm(const AWidth: int64; const ADest: ref MachineOperand;
      const AValue: int64; const ANode: int64);
    var
      LZero: ref MachineInstr;
    begin
      if AValue = 0 then
        LZero := self.DoEmit(X64Op.Zero, 0, ANode);
        LZero.AddOperand(ADest);
        return;
      end;
      self.DoEmitPair(X64Op.Mov, AWidth, ADest, ImmediateOperand(AValue), ANode);
    end;

    // A constant some selected instruction reads as a register: its value moved in (0 by
    // zero); a float's bits go through a general register
    hidden method DoConstant(const AId: int64; const AInstr: ref IrInstr);
    var
      LWidth: int64;
      LBits: int64;
    begin
      LWidth := DoWidth(AInstr.ValueType, AId);
      if not DoIsVector(AInstr.ValueType) then
        self.DoLoadImm(LWidth, self.DoVReg(AId), AInstr.Imm, AInstr.Node);
        return;
      end;
      LBits := self.FMachine.NewVReg(RegClass.General);
      self.DoEmitPair(X64Op.Mov, LWidth, VirtualOperand(LBits), ImmediateOperand(AInstr.Imm),
        AInstr.Node);
      if AInstr.ValueType = IrType.Float32 then
        self.DoEmitPair(X64Op.MovD, 0, self.DoVReg(AId), VirtualOperand(LBits), AInstr.Node);
      else
        self.DoEmitPair(X64Op.MovQ, 0, self.DoVReg(AId), VirtualOperand(LBits), AInstr.Node);
      end;
    end;

    // The calling thread's copy of the thread-local blob AInstr names, by the ABI's model
    // (ThreadLocalFacts). IndexedBlock: the module's 4-byte index (zero-extended), the
    // thread's table of copies at BlockOffset in the thread register's segment, the
    // module's entry in it (index times a pointer's size), then the variable's section
    // offset (SecRel32) from that entry. ThreadPointer (linux64's) is not generated yet:
    // the arch's fault
    hidden method DoThreadAddress(const AId: int64; const AInstr: ref IrInstr);
    var
      LFacts: ref ThreadLocalFacts;
      LPointer: int64;
      LIndex: int64;
      LBlock: int64;
      LSize: int64;
    begin
      LFacts := self.FAbi.ThreadLocal();
      if LFacts.Form <> ThreadLocalForm.IndexedBlock then
        raise(ADAM_X64_SELECT_FAULT_THREAD_FORM + IntToStr(AId));
      end;
      LPointer := DoWidth(IrType.Pointer, AId);
      LIndex := self.FMachine.NewVReg(RegClass.General);
      LBlock := self.FMachine.NewVReg(RegClass.General);
      LSize := self.FMachine.NewVReg(RegClass.General);
      self.DoEmitPair(X64Op.Mov, 4, VirtualOperand(LIndex),
        RipMemory(SymbolClass.Data, LFacts.IndexSymbol, ""), AInstr.Node);
      self.DoEmitPair(X64Op.Mov, LPointer, VirtualOperand(LBlock),
        SegmentMemory(LFacts.ThreadRegister, LFacts.BlockOffset), AInstr.Node);
      self.DoEmitPair(X64Op.Mov, LPointer, VirtualOperand(LSize), ImmediateOperand(LPointer),
        AInstr.Node);
      self.DoEmitPair(X64Op.IMul, LPointer, VirtualOperand(LIndex), VirtualOperand(LSize),
        AInstr.Node);
      self.DoEmitPair(X64Op.Add, LPointer, VirtualOperand(LBlock), VirtualOperand(LIndex),
        AInstr.Node);
      self.DoEmitPair(X64Op.Mov, LPointer, VirtualOperand(LBlock), RegisterMemory(LBlock, true, 0),
        AInstr.Node);
      self.DoEmitPair(X64Op.Lea, LPointer, self.DoVReg(AId),
        SectionOffsetMemory(LBlock, true, self.FModule.DataAt(AInstr.Link).Symbol), AInstr.Node);
    end;

    // A slot used as a value: its address
    hidden method DoSlot(const AId: int64; const AInstr: ref IrInstr);
    begin
      if self.FVRegOf.Find(AId) >= 0 then
        self.DoEmitPair(X64Op.Lea, DoWidth(IrType.Pointer, AId), self.DoVReg(AId),
          SlotMemory(self.FSlotOf.Find(AId), 0), AInstr.Node);
      end;
    end;

    // The scalar op of the float add / sub / mul / fdiv AInstr (SS for a float32, SD for a
    // float64)
    hidden const method DoFloatOp(const AInstr: ref IrInstr): X64Op;
    var
      LSingle: bool;
    begin
      LSingle := AInstr.ValueType = IrType.Float32;
      if AInstr.Kind = IrOp.Sub then
        if LSingle then
          return X64Op.SubSS;
        end;
        return X64Op.SubSD;
      end;
      if AInstr.Kind = IrOp.Mul then
        if LSingle then
          return X64Op.MulSS;
        end;
        return X64Op.MulSD;
      end;
      if AInstr.Kind = IrOp.FDiv then
        if LSingle then
          return X64Op.DivSS;
        end;
        return X64Op.DivSD;
      end;
      if LSingle then
        return X64Op.AddSS;
      end;
      return X64Op.AddSD;
    end;

    // A float add / sub / mul / fdiv: the left operand moved into the result, the right one
    // combined into it (addss .. divsd; IEEE 754 does the rest: inf, NaN, no trap)
    hidden method DoFloatArith(const AId: int64; const AInstr: ref IrInstr);
    begin
      self.DoCopy(AInstr.ValueType, self.DoVReg(AId), self.DoVReg(AInstr.Operands[0]), AId,
        AInstr.Node);
      self.DoEmitPair(self.DoFloatOp(AInstr), 0, self.DoVReg(AId), self.DoVReg(AInstr.Operands[1]),
        AInstr.Node);
    end;

    // A float neg: the sign bit flipped (xorps with the mask ADAM_X64_SELECT_SIGN32 / 64,
    // moved in through a general register as a constant is), so -(+0.0) is -0.0 and a NaN
    // keeps its payload, as C's unary minus
    hidden method DoFloatNegate(const AId: int64; const AInstr: ref IrInstr);
    var
      LBits: int64;
      LMask: int64;
    begin
      LBits := self.FMachine.NewVReg(RegClass.General);
      LMask := self.FMachine.NewVReg(RegClass.Vector);
      if AInstr.ValueType = IrType.Float32 then
        self.DoEmitPair(X64Op.Mov, 4, VirtualOperand(LBits),
          ImmediateOperand(ADAM_X64_SELECT_SIGN32), AInstr.Node);
        self.DoEmitPair(X64Op.MovD, 0, VirtualOperand(LMask), VirtualOperand(LBits), AInstr.Node);
      else
        self.DoEmitPair(X64Op.Mov, 8, VirtualOperand(LBits),
          ImmediateOperand(ADAM_X64_SELECT_SIGN64), AInstr.Node);
        self.DoEmitPair(X64Op.MovQ, 0, VirtualOperand(LMask), VirtualOperand(LBits), AInstr.Node);
      end;
      self.DoCopy(AInstr.ValueType, self.DoVReg(AId), self.DoVReg(AInstr.Operands[0]), AId,
        AInstr.Node);
      self.DoEmitPair(X64Op.XorPS, 0, self.DoVReg(AId), VirtualOperand(LMask), AInstr.Node);
    end;

    // Operand AIndex of AInstr as an AWidth-byte op's source: its immediate when it is an
    // integer constant the op takes (DoImmAt), else its register
    hidden method DoRightOf(const AInstr: ref IrInstr; const AIndex: int64;
      const AWidth: int64): ref MachineOperand;
    begin
      if self.DoImmAt(AInstr, AIndex, AWidth) then
        return ImmediateOperand(self.FModule.InstrAt(AInstr.Operands[AIndex]).Imm);
      end;
      return self.DoVReg(AInstr.Operands[AIndex]);
    end;

    // add / sub: the left operand moved into the result, the right one (an immediate when
    // it fits) added or subtracted; a float's goes to DoFloatArith
    hidden method DoArithmetic(const AId: int64; const AInstr: ref IrInstr);
    var
      LOp: X64Op;
      LWidth: int64;
    begin
      if DoIsVector(AInstr.ValueType) then
        self.DoFloatArith(AId, AInstr);
        return;
      end;
      LOp := X64Op.Add;
      if AInstr.Kind = IrOp.Sub then
        LOp := X64Op.Sub;
      end;
      LWidth := DoWidth(AInstr.ValueType, AId);
      // A constant left operand goes into the result as an immediate (DoReadsOf: no vreg)
      self.DoCopy(AInstr.ValueType, self.DoVReg(AId), self.DoRightOf(AInstr, 0, LWidth), AId,
        AInstr.Node);
      self.DoEmitPair(LOp, LWidth, self.DoVReg(AId), self.DoRightOf(AInstr, 1, LWidth),
        AInstr.Node);
    end;

    // An offset some selected instruction reads as a register: lea of its plan (see the
    // header), base + index * scale + displacement in one instruction
    hidden method DoOffset(const AId: int64; const AInstr: ref IrInstr);
    begin
      self.DoEmitPair(X64Op.Lea, DoWidth(IrType.Pointer, AId), self.DoVReg(AId),
        self.DoMemoryOf(self.DoPlanOffset(AId, 0)), AInstr.Node);
    end;

    // An integer mul by its form (DoMulForm): lea of x + x * 2 / 4 / 8 (at 4 bytes for a
    // 1-byte one: lea has no 1-byte form, the low byte is the same), shl by k for 2^k, imul
    // by the immediate or the register (imul has no 1-byte form: a 1-byte mul runs at 4
    // bytes, the product's low byte the same)
    hidden method DoMultiply(const AId: int64; const AInstr: ref IrInstr);
    var
      LForm: MulForm;
      LWidth: int64;
      LFactor: int64;
      LShift: int64;
      LLeft: int64;
    begin
      LForm := self.DoMulForm(AInstr);
      LWidth := DoWidth(AInstr.ValueType, AId);
      if LForm = MulForm.Lea then
        LFactor := self.FModule.InstrAt(AInstr.Operands[1]).Imm;
        LLeft := self.DoVReg(AInstr.Operands[0]).Reg;
        self.DoEmitPair(X64Op.Lea, DoPickWidth(LWidth = 1, 4, LWidth), self.DoVReg(AId),
          IndexedMemory(RegisterMemory(LLeft, true, 0), LLeft, true, LFactor - 1), AInstr.Node);
        return;
      end;
      self.DoCopy(AInstr.ValueType, self.DoVReg(AId), self.DoVReg(AInstr.Operands[0]), AId,
        AInstr.Node);
      if LForm = MulForm.Shift then
        LFactor := self.FModule.InstrAt(AInstr.Operands[1]).Imm;
        LShift := 0;
        while LFactor > 1 do
          LFactor := LFactor shr 1;
          LShift := LShift + 1;
        end;
        self.DoEmitPair(X64Op.Shl, LWidth, self.DoVReg(AId), ImmediateOperand(LShift), AInstr.Node);
        return;
      end;
      LWidth := DoPickWidth(LWidth = 1, 4, LWidth);
      if LForm = MulForm.Immediate then
        self.DoEmitPair(X64Op.IMul, LWidth, self.DoVReg(AId),
          ImmediateOperand(self.FModule.InstrAt(AInstr.Operands[1]).Imm), AInstr.Node);
        return;
      end;
      self.DoEmitPair(X64Op.IMul, LWidth, self.DoVReg(AId), self.DoVReg(AInstr.Operands[1]),
        AInstr.Node);
    end;

    // mul / and / or / xor: and / or / xor the left operand moved into the result, the right
    // one (an immediate when it fits) combined into it; an integer mul goes to DoMultiply, a
    // float's mul to DoFloatArith
    hidden method DoCombine(const AId: int64; const AInstr: ref IrInstr);
    var
      LOp: X64Op;
      LWidth: int64;
    begin
      if DoIsVector(AInstr.ValueType) then
        self.DoFloatArith(AId, AInstr);
        return;
      end;
      if AInstr.Kind = IrOp.Mul then
        self.DoMultiply(AId, AInstr);
        return;
      end;
      LOp := X64Op.BitXor;
      if AInstr.Kind = IrOp.BitAnd then
        LOp := X64Op.BitAnd;
      end;
      if AInstr.Kind = IrOp.BitOr then
        LOp := X64Op.BitOr;
      end;
      LWidth := DoWidth(AInstr.ValueType, AId);
      // A constant left operand goes into the result as an immediate (DoReadsOf: no vreg)
      self.DoCopy(AInstr.ValueType, self.DoVReg(AId), self.DoRightOf(AInstr, 0, LWidth), AId,
        AInstr.Node);
      self.DoEmitPair(LOp, LWidth, self.DoVReg(AId), self.DoRightOf(AInstr, 1, LWidth),
        AInstr.Node);
    end;

    // shl / shr / sar: the left operand moved into the result, then the shift by an
    // immediate count (a constant's low byte: the hardware masks it as it masks cl) or by
    // rcx: the count moved into rcx (the hardware reads cl and masks it to the width, as
    // clang's code relies on; the count moves at its own width); rcx stays live from its
    // mov to the shift, so allocation gives neither a scratch there
    hidden method DoShift(const AId: int64; const AInstr: ref IrInstr);
    var
      LOp: X64Op;
      LCount: ref MachineOperand;
      LCountId: int64;
    begin
      LOp := X64Op.Shl;
      if AInstr.Kind = IrOp.Shr then
        LOp := X64Op.Shr;
      end;
      if AInstr.Kind = IrOp.Sar then
        LOp := X64Op.Sar;
      end;
      // A constant left operand (1 shl n) goes into the result as an immediate (DoReadsOf)
      self.DoCopy(AInstr.ValueType, self.DoVReg(AId),
        self.DoRightOf(AInstr, 0, DoWidth(AInstr.ValueType, AId)), AId, AInstr.Node);
      if self.DoIsImmConstant(AInstr.Operands[1]) then
        self.DoEmitPair(LOp, DoWidth(AInstr.ValueType, AId), self.DoVReg(AId),
          ImmediateOperand(self.FModule.InstrAt(AInstr.Operands[1]).Imm & 0xFF), AInstr.Node);
        return;
      end;
      LCountId := AInstr.Operands[1];
      LCount := PhysicalOperand(self.DoPhysical(ADAM_X64_SELECT_SHIFT_COUNT));
      self.DoCopy(self.FModule.InstrAt(LCountId).ValueType, LCount, self.DoVReg(LCountId),
        LCountId, AInstr.Node);
      self.DoEmitPair(LOp, DoWidth(AInstr.ValueType, AId), self.DoVReg(AId), LCount, AInstr.Node);
    end;

    // A shift AOp of the AWidth-byte register ADest by the immediate ACount (none for 0)
    hidden method DoShiftBy(const AOp: X64Op; const AWidth: int64; const ADest: ref MachineOperand;
      const ACount: int64; const ANode: int64);
    begin
      if ACount > 0 then
        self.DoEmitPair(AOp, AWidth, ADest, ImmediateOperand(ACount), ANode);
      end;
    end;

    // A division or remainder by a constant through its magic number (DoSignedMagic /
    // DoUnsignedMagic, see their notes): the magic into rax, imul / mul wide by the dividend
    // (rax its implicit use, rax and rdx its implicit defs, so allocation gives neither as a
    // scratch from the mov to the high half's copy), the high half copied out of rdx into a
    // fresh register and corrected there into the quotient; a remainder is the dividend
    // minus the quotient times the divisor (imul's immediate when it fits, else a register:
    // the low bits are the same signed or unsigned). Exact for every dividend, no fault
    hidden method DoMagicDivide(const AId: int64; const AInstr: ref IrInstr);
    var
      LSigned: bool;
      LAdd: bool;
      LWidth: int64;
      LBits: int64;
      LDivisor: int64;
      LMagic: int64;
      LShift: int64;
      LRax: int64;
      LRdx: int64;
      LDividend: ref MachineOperand;
      LQuotient: ref MachineOperand;
      LTemp: ref MachineOperand;
      LFactor: ref MachineOperand;
      LWide: ref MachineInstr;
      LNode: int64;
    begin
      LNode := AInstr.Node;
      LSigned := (AInstr.Kind = IrOp.SDiv) or (AInstr.Kind = IrOp.SRem);
      LWidth := DoWidth(AInstr.ValueType, AId);
      LBits := LWidth * 8;
      LDivisor := self.FModule.InstrAt(AInstr.Operands[1]).Imm;
      LRax := self.DoPhysical(ADAM_X64_SELECT_DIVIDEND);
      LRdx := self.DoPhysical(ADAM_X64_SELECT_REMAINDER);
      LDividend := self.DoVReg(AInstr.Operands[0]);
      LQuotient := VirtualOperand(self.FMachine.NewVReg(RegClass.General));
      LAdd := false;
      if LSigned then
        DoSignedMagic(LDivisor, LBits, LMagic, LShift);
      else
        DoUnsignedMagic(uint64(LDivisor), LBits, LMagic, LShift, LAdd);
      end;
      self.DoEmitPair(X64Op.Mov, LWidth, PhysicalOperand(LRax), ImmediateOperand(LMagic), LNode);
      LWide := self.DoEmit(DoPickOp(LSigned, X64Op.IMulWide, X64Op.MulWide), LWidth, LNode);
      LWide.AddOperand(LDividend);
      LWide.ImplicitUses.Add(LRax);
      LWide.ImplicitDefs.Add(LRax);
      LWide.ImplicitDefs.Add(LRdx);
      self.DoEmitPair(X64Op.Mov, LWidth, LQuotient, PhysicalOperand(LRdx), LNode);
      if LSigned then
        // q = hi (+ n when d > 0 > M, - n when d < 0 < M) sar s, plus 1 when negative
        if (LDivisor > 0) and (LMagic < 0) then
          self.DoEmitPair(X64Op.Add, LWidth, LQuotient, LDividend, LNode);
        end;
        if (LDivisor < 0) and (LMagic > 0) then
          self.DoEmitPair(X64Op.Sub, LWidth, LQuotient, LDividend, LNode);
        end;
        self.DoShiftBy(X64Op.Sar, LWidth, LQuotient, LShift, LNode);
        LTemp := VirtualOperand(self.FMachine.NewVReg(RegClass.General));
        self.DoEmitPair(X64Op.Mov, LWidth, LTemp, LQuotient, LNode);
        self.DoShiftBy(X64Op.Shr, LWidth, LTemp, LBits - 1, LNode);
        self.DoEmitPair(X64Op.Add, LWidth, LQuotient, LTemp, LNode);
      else
        if LAdd then
          // q = ((n - hi) shr 1 + hi) shr (s - 1)
          LTemp := VirtualOperand(self.FMachine.NewVReg(RegClass.General));
          self.DoEmitPair(X64Op.Mov, LWidth, LTemp, LDividend, LNode);
          self.DoEmitPair(X64Op.Sub, LWidth, LTemp, LQuotient, LNode);
          self.DoShiftBy(X64Op.Shr, LWidth, LTemp, 1, LNode);
          self.DoEmitPair(X64Op.Add, LWidth, LTemp, LQuotient, LNode);
          self.DoShiftBy(X64Op.Shr, LWidth, LTemp, LShift - 1, LNode);
          LQuotient := LTemp;
        else
          self.DoShiftBy(X64Op.Shr, LWidth, LQuotient, LShift, LNode);
        end;
      end;
      if (AInstr.Kind = IrOp.SDiv) or (AInstr.Kind = IrOp.UDiv) then
        self.DoEmitPair(X64Op.Mov, LWidth, self.DoVReg(AId), LQuotient, LNode);
        return;
      end;
      if DoImmFits(LDivisor, LWidth) then
        LFactor := ImmediateOperand(LDivisor);
      else
        LFactor := VirtualOperand(self.FMachine.NewVReg(RegClass.General));
        self.DoEmitPair(X64Op.Mov, LWidth, LFactor, ImmediateOperand(LDivisor), LNode);
      end;
      self.DoEmitPair(X64Op.IMul, LWidth, LQuotient, LFactor, LNode);
      self.DoEmitPair(X64Op.Mov, LWidth, self.DoVReg(AId), LDividend, LNode);
      self.DoEmitPair(X64Op.Sub, LWidth, self.DoVReg(AId), LQuotient, LNode);
    end;

    // sdiv / udiv / srem / urem (32 or 64 bits, Ssa's rule): the dividend moved into rax,
    // rdx filled from it (cdq / cqo for a signed division; for an unsigned one a mov of 0,
    // which writes rdx without reading it, so rdx is never live into the block), then idiv /
    // div by the divisor, then the quotient (rax) or the remainder (rdx) moved into the
    // result. rax and rdx are the cqo's and the division's implicit registers, so allocation
    // gives neither as a scratch from the dividend's mov to the result's. A zero divisor and
    // MIN div -1 fault as the hardware does (DESIGN sec 6: clang's code, no check). A
    // constant divisor DoMagicFits takes goes to DoMagicDivide
    hidden method DoDivide(const AId: int64; const AInstr: ref IrInstr);
    var
      LSigned: bool;
      LWidth: int64;
      LRax: int64;
      LRdx: int64;
      LOp: X64Op;
      LInstr: ref MachineInstr;
    begin
      if self.DoMagicFits(AInstr) then
        self.DoMagicDivide(AId, AInstr);
        return;
      end;
      LSigned := (AInstr.Kind = IrOp.SDiv) or (AInstr.Kind = IrOp.SRem);
      LWidth := DoWidth(AInstr.ValueType, AId);
      LRax := self.DoPhysical(ADAM_X64_SELECT_DIVIDEND);
      LRdx := self.DoPhysical(ADAM_X64_SELECT_REMAINDER);
      self.DoCopy(AInstr.ValueType, PhysicalOperand(LRax), self.DoVReg(AInstr.Operands[0]), AId,
        AInstr.Node);
      if LSigned then
        LInstr := self.DoEmit(X64Op.Cqo, LWidth, AInstr.Node);
        LInstr.ImplicitUses.Add(LRax);
        LInstr.ImplicitDefs.Add(LRdx);
        LOp := X64Op.IDiv;
      else
        self.DoEmitPair(X64Op.Mov, 4, PhysicalOperand(LRdx), ImmediateOperand(0), AInstr.Node);
        LOp := X64Op.UDiv;
      end;
      LInstr := self.DoEmit(LOp, LWidth, AInstr.Node);
      LInstr.AddOperand(self.DoVReg(AInstr.Operands[1]));
      LInstr.ImplicitUses.Add(LRax);
      LInstr.ImplicitUses.Add(LRdx);
      LInstr.ImplicitDefs.Add(LRax);
      LInstr.ImplicitDefs.Add(LRdx);
      if (AInstr.Kind = IrOp.SDiv) or (AInstr.Kind = IrOp.UDiv) then
        self.DoCopy(AInstr.ValueType, self.DoVReg(AId), PhysicalOperand(LRax), AId, AInstr.Node);
      else
        self.DoCopy(AInstr.ValueType, self.DoVReg(AId), PhysicalOperand(LRdx), AId, AInstr.Node);
      end;
    end;

    // copy / fill: the destination moved into rdi (and the source into rsi for a copy), the
    // byte count into rcx, al zeroed for a fill, then rep movsb / rep stosb. The four are
    // the string op's implicit registers, live from their movs to it, so allocation gives
    // none of them as a scratch there; rdi and rsi are callee-saved, so writing them makes
    // the prologue save them (Adam.X64.Allocate). The ABI keeps the direction flag clear
    hidden method DoBytes(const AId: int64; const AInstr: ref IrInstr);
    var
      LDest: int64;
      LSource: int64;
      LCount: int64;
      LByte: int64;
      LInstr: ref MachineInstr;
    begin
      LSource := -1;
      LByte := -1;
      LDest := self.DoPhysical(ADAM_X64_SELECT_STRING_DEST);
      LCount := self.DoPhysical(ADAM_X64_SELECT_STRING_COUNT);
      self.DoCopy(IrType.Pointer, PhysicalOperand(LDest), self.DoVReg(AInstr.Operands[0]), AId,
        AInstr.Node);
      if AInstr.Kind = IrOp.Copy then
        LSource := self.DoPhysical(ADAM_X64_SELECT_STRING_SOURCE);
        self.DoCopy(IrType.Pointer, PhysicalOperand(LSource), self.DoVReg(AInstr.Operands[1]),
          AId, AInstr.Node);
      end;
      self.DoEmitPair(X64Op.Mov, 8, PhysicalOperand(LCount), ImmediateOperand(AInstr.Imm),
        AInstr.Node);
      if AInstr.Kind = IrOp.Copy then
        LInstr := self.DoEmit(X64Op.RepMovsb, 0, AInstr.Node);
        LInstr.ImplicitUses.Add(LSource);
        LInstr.ImplicitDefs.Add(LSource);
      else
        // mov eax, 0 writes all of rax, so al is 0
        LByte := self.DoPhysical(ADAM_X64_SELECT_STRING_BYTE);
        self.DoEmitPair(X64Op.Mov, 4, PhysicalOperand(LByte), ImmediateOperand(0), AInstr.Node);
        LInstr := self.DoEmit(X64Op.RepStosb, 0, AInstr.Node);
        LInstr.ImplicitUses.Add(LByte);
      end;
      LInstr.ImplicitUses.Add(LDest);
      LInstr.ImplicitUses.Add(LCount);
      LInstr.ImplicitDefs.Add(LDest);
      LInstr.ImplicitDefs.Add(LCount);
    end;

    // The atomics (sequentially consistent, x86-TSO): atomicload is a plain mov (aligned 4 /
    // 8 bytes, and every atomic store is an xchg, so a load needs no fence); the others move
    // the value into rax first. atomicadd: lock xadd [P], rax leaves the old value in rax;
    // atomicswap / atomicstore: xchg [P], rax (a full barrier); atomiccas: the expected
    // value in rax, the new one in rcx, lock cmpxchg [P], rcx, then sete. rax (and rcx) are
    // live from their movs to the atomic, so allocation gives neither as a scratch there
    hidden method DoAtomic(const AId: int64; const AInstr: ref IrInstr);
    var
      LRax: int64;
      LRcx: int64;
      LType: IrType;
      LWidth: int64;
      LOp: X64Op;
      LInstr: ref MachineInstr;
      LSet: ref MachineInstr;
    begin
      if AInstr.Kind = IrOp.AtomicLoad then
        self.DoCopy(AInstr.ValueType, self.DoVReg(AId), self.DoAddressOf(AInstr.Operands[0]),
          AId, AInstr.Node);
        return;
      end;
      LRax := self.DoPhysical(ADAM_X64_SELECT_ATOMIC_VALUE);
      LType := self.FModule.InstrAt(AInstr.Operands[1]).ValueType;
      LWidth := DoWidth(LType, AInstr.Operands[1]);
      self.DoCopy(LType, PhysicalOperand(LRax), self.DoVReg(AInstr.Operands[1]), AId, AInstr.Node);
      if AInstr.Kind = IrOp.AtomicCas then
        LRcx := self.DoPhysical(ADAM_X64_SELECT_ATOMIC_NEW);
        self.DoCopy(LType, PhysicalOperand(LRcx), self.DoVReg(AInstr.Operands[2]), AId,
          AInstr.Node);
        LInstr := self.DoEmit(X64Op.LockCmpxchg, LWidth, AInstr.Node);
        LInstr.AddOperand(self.DoAddressOf(AInstr.Operands[0]));
        LInstr.AddOperand(PhysicalOperand(LRcx));
        LInstr.ImplicitUses.Add(LRax);
        LInstr.ImplicitDefs.Add(LRax);
        LSet := self.DoEmit(X64Op.SetCC, 0, AInstr.Node);
        LSet.Cond := X64Cond.Equal;
        LSet.AddOperand(self.DoVReg(AId));
        self.DoEmitPair(X64Op.MovZX8, 4, self.DoVReg(AId), self.DoVReg(AId), AInstr.Node);
        return;
      end;
      LOp := X64Op.Xchg;
      if AInstr.Kind = IrOp.AtomicAdd then
        LOp := X64Op.LockXadd;
      end;
      LInstr := self.DoEmit(LOp, LWidth, AInstr.Node);
      LInstr.AddOperand(self.DoAddressOf(AInstr.Operands[0]));
      LInstr.AddOperand(PhysicalOperand(LRax));
      LInstr.ImplicitDefs.Add(LRax);
      if AInstr.Kind <> IrOp.AtomicStore then
        self.DoCopy(AInstr.ValueType, self.DoVReg(AId), PhysicalOperand(LRax), AId, AInstr.Node);
      end;
    end;

    // neg / not: the operand moved into the result, negated or complemented there; a float's
    // neg goes to DoFloatNegate
    hidden method DoNegate(const AId: int64; const AInstr: ref IrInstr);
    var
      LOp: X64Op;
      LInstr: ref MachineInstr;
    begin
      if DoIsVector(AInstr.ValueType) then
        self.DoFloatNegate(AId, AInstr);
        return;
      end;
      LOp := X64Op.Neg;
      if AInstr.Kind = IrOp.BitNot then
        LOp := X64Op.BitNot;
      end;
      self.DoCopy(AInstr.ValueType, self.DoVReg(AId), self.DoVReg(AInstr.Operands[0]), AId,
        AInstr.Node);
      LInstr := self.DoEmit(LOp, DoWidth(AInstr.ValueType, AId), AInstr.Node);
      LInstr.AddOperand(self.DoVReg(AId));
    end;

    // A jcc of ACond to the machine block AOnTrue, then a jmp to AOnFalse, at ANode
    hidden method DoSplit(const ACond: X64Cond; const AOnTrue: int64; const AOnFalse: int64;
      const ANode: int64);
    var
      LJump: ref MachineInstr;
    begin
      LJump := self.DoEmit(X64Op.Jcc, 0, ANode);
      LJump.Cond := ACond;
      LJump.AddOperand(BlockOperand(AOnTrue));
      self.DoJumpMachine(AOnFalse, ANode);
    end;

    // A jmp to the machine block ATarget, at ANode
    hidden method DoJumpMachine(const ATarget: int64; const ANode: int64);
    var
      LJump: ref MachineInstr;
    begin
      LJump := self.DoEmit(X64Op.Jmp, 0, ANode);
      LJump.AddOperand(BlockOperand(ATarget));
    end;

    // A float constant of AType (Float32 / Float64) from its bits ABits, in a new vector vreg
    // (moved in through a general one, as DoConstant does)
    hidden method DoFloatBits(const AType: IrType; const ABits: int64; const ANode: int64): int64;
    var
      LBits: int64;
      LValue: int64;
    begin
      LBits := self.FMachine.NewVReg(RegClass.General);
      LValue := self.FMachine.NewVReg(RegClass.Vector);
      if AType = IrType.Float32 then
        self.DoEmitPair(X64Op.Mov, 4, VirtualOperand(LBits), ImmediateOperand(ABits), ANode);
        self.DoEmitPair(X64Op.MovD, 0, VirtualOperand(LValue), VirtualOperand(LBits), ANode);
      else
        self.DoEmitPair(X64Op.Mov, 8, VirtualOperand(LBits), ImmediateOperand(ABits), ANode);
        self.DoEmitPair(X64Op.MovQ, 0, VirtualOperand(LValue), VirtualOperand(LBits), ANode);
      end;
      return LValue;
    end;

    // A convert from or to a float: float32 <-> float64 (cvtss2sd / cvtsd2ss), from an
    // integer (DoIntToFloat), to an integer (DoFloatToInt)
    hidden method DoFloatConvert(const AId: int64; const AInstr: ref IrInstr);
    var
      LFrom: IrType;
    begin
      LFrom := self.FModule.InstrAt(AInstr.Operands[0]).ValueType;
      if DoIsVector(LFrom) and DoIsVector(AInstr.ValueType) then
        self.DoEmitPair(DoPickOp(LFrom = IrType.Float32, X64Op.CvtSS2SD, X64Op.CvtSD2SS), 0,
          self.DoVReg(AId), self.DoVReg(AInstr.Operands[0]), AInstr.Node);
        return;
      end;
      if DoIsVector(AInstr.ValueType) then
        self.DoIntToFloat(AId, AInstr, LFrom);
        return;
      end;
      self.DoFloatToInt(AId, AInstr, LFrom);
    end;

    // An integer of AFrom (or a bool) to a float, rounded to nearest as C does: cvtsi2ss /
    // cvtsi2sd read a signed 4 or 8-byte integer, so int32 / int64 go in as they are, int8 /
    // int16 sign-extended to 4 bytes, bool / uint8 / uint16 zero-extended to 4, uint32 moved
    // at 4 (which zeroes the top half) and read at 8; uint64 is DoUnsignedToFloat's
    hidden method DoIntToFloat(const AId: int64; const AInstr: ref IrInstr; const AFrom: IrType);
    var
      LOp: X64Op;
      LSource: ref MachineOperand;
      LWide: int64;
    begin
      LOp := DoPickOp(AInstr.ValueType = IrType.Float32, X64Op.CvtSI2SS, X64Op.CvtSI2SD);
      LSource := self.DoVReg(AInstr.Operands[0]);
      if (AFrom = IrType.Int32) or (AFrom = IrType.Int64) then
        self.DoEmitPair(LOp, DoPickWidth(AFrom = IrType.Int64, 8, 4), self.DoVReg(AId), LSource,
          AInstr.Node);
        return;
      end;
      if AFrom = IrType.UInt64 then
        self.DoUnsignedToFloat(AId, AInstr, LOp);
        return;
      end;
      LWide := self.FMachine.NewVReg(RegClass.General);
      if AFrom = IrType.UInt32 then
        self.DoEmitPair(X64Op.Mov, 4, VirtualOperand(LWide), LSource, AInstr.Node);
        self.DoEmitPair(LOp, 8, self.DoVReg(AId), VirtualOperand(LWide), AInstr.Node);
        return;
      end;
      if (AFrom = IrType.Int8) or (AFrom = IrType.Int16) then
        self.DoEmitPair(DoPickOp(AFrom = IrType.Int8, X64Op.MovSX8, X64Op.MovSX16), 4,
          VirtualOperand(LWide), LSource, AInstr.Node);
      else
        // bool, uint8, uint16
        self.DoEmitPair(DoPickOp(DoWidth(AFrom, AInstr.Operands[0]) = 1, X64Op.MovZX8,
          X64Op.MovZX16), 4, VirtualOperand(LWide), LSource, AInstr.Node);
      end;
      self.DoEmitPair(LOp, 4, self.DoVReg(AId), VirtualOperand(LWide), AInstr.Node);
    end;

    // A uint64 to a float by AOp (cvtsi2ss / cvtsi2sd), C's rounding kept: below 2^63 (the
    // sign bit clear) it converts as the int64 it equals; above, it is halved with its low
    // bit or'ed back in (so the halving rounds as the whole would: round to odd), converted,
    // and doubled (exact). Two machine blocks after a test of the sign, joined in a third
    // where the function goes on
    hidden method DoUnsignedToFloat(const AId: int64; const AInstr: ref IrInstr; const AOp: X64Op);
    var
      LSource: ref MachineOperand;
      LSmall: int64;
      LBig: int64;
      LJoin: int64;
      LHalf: int64;
      LLow: int64;
      LCount: ref MachineOperand;
    begin
      LSource := self.DoVReg(AInstr.Operands[0]);
      LSmall := self.FMachine.AddBlock(self.FSource);
      LBig := self.FMachine.AddBlock(self.FSource);
      LJoin := self.FMachine.AddBlock(self.FSource);
      self.DoEmitPair(X64Op.Test, 8, LSource, LSource, AInstr.Node);
      self.DoSplit(X64Cond.Sign, LBig, LSmall, AInstr.Node);
      self.FCurrent := LSmall;
      self.DoEmitPair(AOp, 8, self.DoVReg(AId), LSource, AInstr.Node);
      self.DoJumpMachine(LJoin, AInstr.Node);
      self.FCurrent := LBig;
      LHalf := self.FMachine.NewVReg(RegClass.General);
      LLow := self.FMachine.NewVReg(RegClass.General);
      LCount := PhysicalOperand(self.DoPhysical(ADAM_X64_SELECT_SHIFT_COUNT));
      self.DoEmitPair(X64Op.Mov, 8, VirtualOperand(LHalf), LSource, AInstr.Node);
      self.DoEmitPair(X64Op.Mov, 4, LCount, ImmediateOperand(1), AInstr.Node);
      self.DoEmitPair(X64Op.Shr, 8, VirtualOperand(LHalf), LCount, AInstr.Node);
      self.DoEmitPair(X64Op.Mov, 8, VirtualOperand(LLow), LSource, AInstr.Node);
      self.DoEmitPair(X64Op.BitAnd, 8, VirtualOperand(LLow), ImmediateOperand(1), AInstr.Node);
      self.DoEmitPair(X64Op.BitOr, 8, VirtualOperand(LHalf), VirtualOperand(LLow), AInstr.Node);
      self.DoEmitPair(AOp, 8, self.DoVReg(AId), VirtualOperand(LHalf), AInstr.Node);
      self.DoEmitPair(DoPickOp(AOp = X64Op.CvtSI2SS, X64Op.AddSS, X64Op.AddSD), 0,
        self.DoVReg(AId), self.DoVReg(AId), AInstr.Node);
      self.DoJumpMachine(LJoin, AInstr.Node);
      self.FCurrent := LJoin;
    end;

    // A float of AFrom to an integer, truncated toward zero as C does (a value the type
    // cannot hold is C's undefined behavior: the hardware's result stands): cvttss2si /
    // cvttsd2si at 4 bytes for a result of 4 bytes or less (its low bytes), at 8 for uint32
    // (0 .. 2^32 - 1 fit the int64 it reads) and int64; uint64 is DoFloatToUnsigned's
    hidden method DoFloatToInt(const AId: int64; const AInstr: ref IrInstr; const AFrom: IrType);
    var
      LOp: X64Op;
      LTo: IrType;
    begin
      LOp := DoPickOp(AFrom = IrType.Float32, X64Op.CvtTSS2SI, X64Op.CvtTSD2SI);
      LTo := AInstr.ValueType;
      if LTo = IrType.UInt64 then
        self.DoFloatToUnsigned(AId, AInstr, AFrom, LOp);
        return;
      end;
      self.DoEmitPair(LOp, DoPickWidth((LTo = IrType.UInt32) or (LTo = IrType.Int64), 8, 4),
        self.DoVReg(AId), self.DoVReg(AInstr.Operands[0]), AInstr.Node);
    end;

    // A float of AFrom to a uint64 by AOp (cvttss2si / cvttsd2si), as C converts it: below
    // 2^63 it is the int64 truncation; from 2^63 up, 2^63 is taken off first (exact) and
    // the sign bit set in the result. Two machine blocks after a ucomis against 2^63
    // (`above or equal`: a NaN takes the small path), joined in a third
    hidden method DoFloatToUnsigned(const AId: int64; const AInstr: ref IrInstr;
      const AFrom: IrType; const AOp: X64Op);
    var
      LSource: ref MachineOperand;
      LLimit: int64;
      LSmall: int64;
      LBig: int64;
      LJoin: int64;
      LLess: int64;
      LSign: int64;
    begin
      LSource := self.DoVReg(AInstr.Operands[0]);
      if AFrom = IrType.Float32 then
        LLimit := self.DoFloatBits(AFrom, ADAM_X64_SELECT_TWO63_32, AInstr.Node);
      else
        LLimit := self.DoFloatBits(AFrom, ADAM_X64_SELECT_TWO63_64, AInstr.Node);
      end;
      LSmall := self.FMachine.AddBlock(self.FSource);
      LBig := self.FMachine.AddBlock(self.FSource);
      LJoin := self.FMachine.AddBlock(self.FSource);
      self.DoEmitPair(DoPickOp(AFrom = IrType.Float32, X64Op.UComiSS, X64Op.UComiSD), 0, LSource,
        VirtualOperand(LLimit), AInstr.Node);
      self.DoSplit(X64Cond.AboveOrEqual, LBig, LSmall, AInstr.Node);
      self.FCurrent := LSmall;
      self.DoEmitPair(AOp, 8, self.DoVReg(AId), LSource, AInstr.Node);
      self.DoJumpMachine(LJoin, AInstr.Node);
      self.FCurrent := LBig;
      LLess := self.FMachine.NewVReg(RegClass.Vector);
      LSign := self.FMachine.NewVReg(RegClass.General);
      self.DoCopy(AFrom, VirtualOperand(LLess), LSource, AInstr.Operands[0], AInstr.Node);
      self.DoEmitPair(DoPickOp(AFrom = IrType.Float32, X64Op.SubSS, X64Op.SubSD), 0,
        VirtualOperand(LLess), VirtualOperand(LLimit), AInstr.Node);
      self.DoEmitPair(AOp, 8, self.DoVReg(AId), VirtualOperand(LLess), AInstr.Node);
      self.DoEmitPair(X64Op.Mov, 8, VirtualOperand(LSign), ImmediateOperand(ADAM_X64_SELECT_SIGN64),
        AInstr.Node);
      self.DoEmitPair(X64Op.BitXor, 8, self.DoVReg(AId), VirtualOperand(LSign), AInstr.Node);
      self.DoJumpMachine(LJoin, AInstr.Node);
      self.FCurrent := LJoin;
    end;

    // convert: to a type no wider, a mov of the result's width (the low bytes; a ptr and a
    // 64-bit integer move as they are); wider, an extension by the source's signedness:
    // movsx from int8 / int16 (32 bits, 64 for a 64-bit result), movsxd from int32,
    // movzx from bool / uint8 / uint16 (32 bits: the top half zeroes), a 32-bit mov from
    // uint32 (it zeroes the top half)
    hidden method DoConvert(const AId: int64; const AInstr: ref IrInstr);
    var
      LFrom: IrType;
      LFromWidth: int64;
      LWidth: int64;
      LSource: ref MachineOperand;
    begin
      LFrom := self.FModule.InstrAt(AInstr.Operands[0]).ValueType;
      if DoIsVector(LFrom) or DoIsVector(AInstr.ValueType) then
        self.DoFloatConvert(AId, AInstr);
        return;
      end;
      LFromWidth := DoWidth(LFrom, AInstr.Operands[0]);
      LWidth := DoWidth(AInstr.ValueType, AId);
      LSource := self.DoVReg(AInstr.Operands[0]);
      if LWidth <= LFromWidth then
        self.DoEmitPair(X64Op.Mov, LWidth, self.DoVReg(AId), LSource, AInstr.Node);
        return;
      end;
      if (LFrom = IrType.Int8) or (LFrom = IrType.Int16) then
        self.DoEmitPair(DoPickOp(LFrom = IrType.Int8, X64Op.MovSX8, X64Op.MovSX16),
          DoPickWidth(LWidth = 8, 8, 4), self.DoVReg(AId), LSource, AInstr.Node);
        return;
      end;
      if LFrom = IrType.Int32 then
        self.DoEmitPair(X64Op.MovSXD, 8, self.DoVReg(AId), LSource, AInstr.Node);
        return;
      end;
      if LFrom = IrType.UInt32 then
        self.DoEmitPair(X64Op.Mov, 4, self.DoVReg(AId), LSource, AInstr.Node);
        return;
      end;
      // bool, uint8, uint16
      self.DoEmitPair(DoPickOp(LFromWidth = 1, X64Op.MovZX8, X64Op.MovZX16), 4, self.DoVReg(AId),
        LSource, AInstr.Node);
    end;

    // A setcc of ACond into ADest (its low byte), at ANode
    hidden method DoSetCond(const ACond: X64Cond; const ADest: ref MachineOperand;
      const ANode: int64);
    var
      LSet: ref MachineInstr;
    begin
      LSet := self.DoEmit(X64Op.SetCC, 0, ANode);
      LSet.Cond := ACond;
      LSet.AddOperand(ADest);
    end;

    // A float compare (ucomiss / ucomisd; an unordered pair, a NaN in it, sets ZF, PF and
    // CF all three): an order is `above` / `above or equal` (CF and ZF clear: DoCondOf),
    // with the operands swapped for < and <=, so a NaN gives false as C does; = is ZF set
    // and PF clear (sete and setnp, anded), <> ZF clear or PF set (setne or setp), so a NaN
    // is unequal to everything, itself included. The bool then movzx'd to 4 bytes, as
    // DoCompare
    hidden method DoFloatCompare(const AId: int64; const AInstr: ref IrInstr);
    var
      LOp: X64Op;
      LFirst: int64;
      LSecond: int64;
      LParity: int64;
    begin
      LOp := DoPickOp(self.FModule.InstrAt(AInstr.Operands[0]).ValueType = IrType.Float32,
        X64Op.UComiSS, X64Op.UComiSD);
      LFirst := AInstr.Operands[0];
      LSecond := AInstr.Operands[1];
      if (AInstr.Predicate = IrPredicate.FLess) or (AInstr.Predicate = IrPredicate.FLessEqual) then
        LFirst := AInstr.Operands[1];
        LSecond := AInstr.Operands[0];
      end;
      self.DoEmitPair(LOp, 0, self.DoVReg(LFirst), self.DoVReg(LSecond), AInstr.Node);
      self.DoSetCond(DoCondOf(AInstr.Predicate), self.DoVReg(AId), AInstr.Node);
      if (AInstr.Predicate = IrPredicate.FEqual) or (AInstr.Predicate = IrPredicate.FNotEqual) then
        LParity := self.FMachine.NewVReg(RegClass.General);
        if AInstr.Predicate = IrPredicate.FEqual then
          self.DoSetCond(X64Cond.NoParity, VirtualOperand(LParity), AInstr.Node);
          self.DoEmitPair(X64Op.BitAnd, 1, self.DoVReg(AId), VirtualOperand(LParity), AInstr.Node);
        else
          self.DoSetCond(X64Cond.Parity, VirtualOperand(LParity), AInstr.Node);
          self.DoEmitPair(X64Op.BitOr, 1, self.DoVReg(AId), VirtualOperand(LParity), AInstr.Node);
        end;
      end;
      self.DoEmitPair(X64Op.MovZX8, 4, self.DoVReg(AId), self.DoVReg(AId), AInstr.Node);
    end;

    // The flags of the compare AInstr, at ANode, and the condition its predicate holds on
    // (DoCondOf): an integer one's operands compared at their width (test of the left with
    // itself against 0: the same flags as cmp with 0; cmp with the right's immediate when
    // it fits), a float order's by ucomiss / ucomisd (the operands swapped for < and <=:
    // DoFloatCompare's rule)
    hidden method DoCompareFlags(const AInstr: ref IrInstr; const ANode: int64): X64Cond;
    var
      LLeft: int64;
      LRight: int64;
      LType: IrType;
      LWidth: int64;
    begin
      LLeft := AInstr.Operands[0];
      LRight := AInstr.Operands[1];
      LType := self.FModule.InstrAt(LLeft).ValueType;
      if DoIsVector(LType) then
        if (AInstr.Predicate = IrPredicate.FLess) or (AInstr.Predicate = IrPredicate.FLessEqual) then
          LLeft := AInstr.Operands[1];
          LRight := AInstr.Operands[0];
        end;
        self.DoEmitPair(DoPickOp(LType = IrType.Float32, X64Op.UComiSS, X64Op.UComiSD), 0,
          self.DoVReg(LLeft), self.DoVReg(LRight), ANode);
        return DoCondOf(AInstr.Predicate);
      end;
      LWidth := DoWidth(LType, LLeft);
      if self.DoImmAt(AInstr, 1, LWidth) and (self.FModule.InstrAt(LRight).Imm = 0) then
        self.DoEmitPair(X64Op.Test, LWidth, self.DoVReg(LLeft), self.DoVReg(LLeft), ANode);
      else
        self.DoEmitPair(X64Op.Cmp, LWidth, self.DoVReg(LLeft), self.DoRightOf(AInstr, 1, LWidth),
          ANode);
      end;
      return DoCondOf(AInstr.Predicate);
    end;

    // cmp: the flags (DoCompareFlags), setcc of the predicate's condition into the result's
    // low byte, then movzx of that byte into the result at 4 bytes, so the whole register is
    // defined (a bool is read at its 1 byte, but a register written in part keeps a
    // dependency on its old value); a float's is DoFloatCompare's
    hidden method DoCompare(const AId: int64; const AInstr: ref IrInstr);
    begin
      if DoIsVector(self.FModule.InstrAt(AInstr.Operands[0]).ValueType) then
        self.DoFloatCompare(AId, AInstr);
        return;
      end;
      self.DoSetCond(self.DoCompareFlags(AInstr, AInstr.Node), self.DoVReg(AId), AInstr.Node);
      self.DoEmitPair(X64Op.MovZX8, 4, self.DoVReg(AId), self.DoVReg(AId), AInstr.Node);
    end;

    // The signature the ABI part lays the call AInstr of ASignature out by, its arguments the
    // operands from AFirst on: ASignature itself, or for a variadic one the call site's (its
    // parameters, then each extra operand's type, marked variadic: Win64 copies a float in a
    // register slot into the integer register too)
    hidden method DoCallSignature(const AInstr: ref IrInstr; const ASignature: ref IrSignature;
      const AFirst: int64): ref IrSignature;
    var
      LSite: ref IrSignature;
      LI: int64;
    begin
      if not ASignature.Variadic then
        return ASignature;
      end;
      LSite := ref IrSignature(ASignature.ResultType);
      LSite.Variadic := true;
      for LI := 0 to ASignature.ParamCount - 1 do
        LSite.AddParam(ASignature.ParamTypes[LI]);
      end;
      for LI := AFirst + ASignature.ParamCount to AInstr.Operands.Count - 1 do
        LSite.AddParam(self.FModule.InstrAt(AInstr.Operands[LI]).ValueType);
      end;
      return LSite;
    end;

    // True when the call AInstr, laid out as ALayout, leaves as a jump: marked a tail call
    // (Adam.Opt.Tail), in a function that is no funclet and not variadic (its incoming area
    // holds its own variadic arguments), the callee's stack arguments fitting in this
    // function's own incoming area (they are written there: the callee finds them at the
    // entry offsets this function found its own at)
    hidden method DoTailFits(const AInstr: ref IrInstr; const ALayout: ref CallLayout): bool;
    begin
      if not AInstr.Tail then
        return false;
      end;
      if (self.FFunction.Parent <> 0) or (self.FOwnVarargs <> nil) then
        return false;
      end;
      return ALayout.OutgoingBytes <= self.FOwnLayout.OutgoingBytes;
    end;

    // A general register the ABI calls volatile and no argument of the tail call takes
    // (AUses: the arguments' registers), the last such in its list; raises for none
    hidden method DoTailRegister(const AUses: ref Int64List): int64;
    var
      LReg: int64;
      LI: int64;
    begin
      for LI := self.FVolatile.Count - 1 downto 0 do
        LReg := self.FVolatile[LI];
        if (LReg < ADAM_X64_FIRST_XMM) and (AUses.IndexOf(LReg) < 0) then
          return LReg;
        end;
      end;
      raise(ADAM_X64_SELECT_FAULT_NO_REGISTER + "a tail call's target'");
    end;

    // A tail call's jump to ATarget, the arguments already in their places (AUses: their
    // registers): a target in a virtual register (calli) moved first into a volatile
    // general register no argument takes (its spill's frame is released before the jump);
    // in a function with scopes a nop first (DoRet's rule); then the jump, which the
    // allocator puts the epilogue before, as before a ret; the IR ret after it makes nothing
    hidden method DoTailJump(const AInstr: ref IrInstr; const ATarget: ref MachineOperand;
      const AUses: ref Int64List);
    var
      LTarget: ref MachineOperand;
      LJump: ref MachineInstr;
      LReg: int64;
    begin
      LTarget := ATarget;
      if ATarget.Kind = OperandKind.VirtualReg then
        LReg := self.DoTailRegister(AUses);
        self.DoEmitPair(X64Op.Mov, DoWidth(IrType.Pointer, 0), PhysicalOperand(LReg), ATarget,
          AInstr.Node);
        LTarget := PhysicalOperand(LReg);
      end;
      if self.FFunction.ScopeCount() > 0 then
        self.DoEmit(X64Op.Nop, 0, AInstr.Node);
      end;
      LJump := self.DoEmit(X64Op.TailJmp, 0, AInstr.Node);
      LJump.AddOperand(LTarget);
      LJump.ImplicitUses := AUses;
      self.FTailDone := true;
    end;

    // A call to a routine of ASignature at ATarget, its arguments the IR operands from AFirst
    // on (a calli's operand 0 is its target): the arguments into their places (the stack
    // ones first; a register one's shadow too: movq of a float's bits), the call, the result
    // out of its register. A tail call the ABI allows (DoTailFits) puts its stack arguments
    // in this function's incoming area instead and jumps (DoTailJump): no outgoing area, no
    // result to take
    hidden method DoCall(const AId: int64; const AFullSignature: ref IrSignature;
      const ATarget: ref MachineOperand; const AFirst: int64);
    var
      LInstr: ref IrInstr;
      LSignature: ref IrSignature;
      LLayout: ref CallLayout;
      LPlace: ref Location;
      LCall: ref MachineInstr;
      LUses: ref Int64List;
      LStack: ref MachineOperand;
      LTail: bool;
      LReg: int64;
      LShadow: int64;
      LArg: int64;
      LI: int64;
    begin
      LInstr := self.FModule.InstrAt(AId);
      LSignature := self.DoCallSignature(LInstr, AFullSignature, AFirst);
      if LInstr.Operands.Count <> AFirst + LSignature.ParamCount then
        raise(ADAM_X64_SELECT_FAULT_ARGS + IntToStr(AId));
      end;
      LLayout := self.FAbi.LayoutCall(LSignature);
      LTail := self.DoTailFits(LInstr, LLayout);
      if not LTail then
        if LLayout.OutgoingBytes > self.FMachine.OutgoingBytes then
          self.FMachine.OutgoingBytes := LLayout.OutgoingBytes;
        end;
        self.FMachine.MakesCalls := true;
      end;
      for LI := 0 to LLayout.ArgCount - 1 do
        LPlace := LLayout.ArgAt(LI);
        if LPlace.Kind = LocationKind.Stack then
          if LTail then
            LStack := IncomingMemory(LPlace.EntryOffset);
          else
            LStack := OutgoingMemory(LPlace.CallOffset);
          end;
          LArg := LInstr.Operands[AFirst + LI];
          if self.DoArgImm(LArg) then
            // A constant argument stored as the immediate (DoArgImm: it fits)
            self.DoEmitPair(X64Op.Mov, DoWidth(self.FModule.InstrAt(LArg).ValueType, LArg),
              LStack, ImmediateOperand(self.FModule.InstrAt(LArg).Imm), LInstr.Node);
          else
            self.DoCopy(LSignature.ParamTypes[LI], LStack, self.DoVReg(LArg), AId, LInstr.Node);
          end;
        end;
      end;
      LUses := ref Int64List();
      for LI := 0 to LLayout.ArgCount - 1 do
        LPlace := LLayout.ArgAt(LI);
        if LPlace.Kind = LocationKind.Register then
          LReg := self.DoPhysical(LPlace.RegisterName);
          LArg := LInstr.Operands[AFirst + LI];
          if self.DoArgImm(LArg) then
            self.DoLoadImm(DoWidth(self.FModule.InstrAt(LArg).ValueType, LArg),
              PhysicalOperand(LReg), self.FModule.InstrAt(LArg).Imm, LInstr.Node);
          else
            self.DoCopy(LSignature.ParamTypes[LI], PhysicalOperand(LReg), self.DoVReg(LArg), AId,
              LInstr.Node);
          end;
          LUses.Add(LReg);
          // A float's bits into its slot's integer register too (a variadic call)
          if LPlace.ShadowName <> "" then
            LShadow := self.DoPhysical(LPlace.ShadowName);
            self.DoEmitPair(X64Op.MovQ, 0, PhysicalOperand(LShadow),
              self.DoVReg(LInstr.Operands[AFirst + LI]), LInstr.Node);
            LUses.Add(LShadow);
          end;
        end;
      end;
      if LTail then
        self.DoTailJump(LInstr, ATarget, LUses);
        return;
      end;
      LCall := self.DoEmit(X64Op.Call, 0, LInstr.Node);
      LCall.AddOperand(ATarget);
      LCall.ImplicitUses := LUses;
      for LI := 0 to self.FVolatile.Count - 1 do
        LCall.ImplicitDefs.Add(self.FVolatile[LI]);
      end;
      if LInstr.ValueType <> IrType.Void then
        self.DoCopy(LInstr.ValueType, self.DoVReg(AId),
          PhysicalOperand(self.DoPhysical(LLayout.ResultAt.RegisterName)), AId, LInstr.Node);
      end;
    end;

    // A call to a function of the module (rel32 to its symbol), to an external (through
    // its import address), or through a routine value (calli: the register holding it)
    hidden method DoCallInstr(const AId: int64; const AInstr: ref IrInstr);
    var
      LFunction: ref IrFunction;
      LExternal: ref IrExternal;
    begin
      if AInstr.Kind = IrOp.Call then
        LFunction := self.FModule.FunctionAt(AInstr.Link);
        self.DoCall(AId, LFunction.Signature, SymbolOperand(SymbolClass.Code, LFunction.Symbol), 0);
        return;
      end;
      if AInstr.Kind = IrOp.CallIndirect then
        self.DoCall(AId, self.FModule.SignatureAt(AInstr.Link), self.DoVReg(AInstr.Operands[0]), 1);
        return;
      end;
      LExternal := self.FModule.ExternalAt(AInstr.Link);
      self.DoCall(AId, LExternal.Signature,
        ImportMemory(LExternal.Symbol, LExternal.Library, LExternal.Node), 0);
    end;

    // codeaddr: lea of the function's symbol, rip-relative; importaddr: its import entry's
    // value (the address the loader wrote there), rip-relative
    hidden method DoCodeAddress(const AId: int64; const AInstr: ref IrInstr);
    var
      LExternal: ref IrExternal;
    begin
      if AInstr.Kind = IrOp.CodeAddress then
        self.DoEmitPair(X64Op.Lea, DoWidth(IrType.Pointer, AId), self.DoVReg(AId),
          RipMemory(SymbolClass.Code, self.FModule.FunctionAt(AInstr.Link).Symbol, ""), AInstr.Node);
        return;
      end;
      LExternal := self.FModule.ExternalAt(AInstr.Link);
      self.DoEmitPair(X64Op.Mov, DoWidth(IrType.Pointer, AId), self.DoVReg(AId),
        ImportMemory(LExternal.Symbol, LExternal.Library, LExternal.Node), AInstr.Node);
    end;

    // varargsstart: lea of the first variadic argument's place in the incoming area (the
    // homes put the register ones there: DoHomes); raises in a function that is not
    // variadic (Verify refuses it)
    hidden method DoVarargsStart(const AId: int64; const AInstr: ref IrInstr);
    begin
      if self.FOwnVarargs = nil then
        raise(ADAM_X64_SELECT_FAULT_VARARGS + IntToStr(AId));
      end;
      self.DoEmitPair(X64Op.Lea, DoWidth(IrType.Pointer, AId), self.DoVReg(AId),
        IncomingMemory(self.FOwnVarargs.FirstAt), AInstr.Node);
    end;

    // ret: the value (if any) into the result register, then the return. In a function with
    // scopes (a frame handler), a nop first: the OS's unwinder takes a frame whose return
    // address points at an epilogue (the allocator puts it before the ret) as already leaving
    // and never calls its handler, so a call ending the function's code must return to
    // something else (MSVC's and LLVM's call / nop rule). After a tail call's jump
    // (FTailDone) nothing: the jump has left the function
    hidden method DoRet(const AId: int64; const AInstr: ref IrInstr);
    var
      LRet: ref MachineInstr;
      LReg: int64;
    begin
      if self.FTailDone then
        self.FTailDone := false;
        return;
      end;
      LReg := -1;
      if AInstr.Operands.Count > 0 then
        LReg := self.DoPhysical(self.FOwnLayout.ResultAt.RegisterName);
        if self.DoIsImmConstant(AInstr.Operands[0]) then
          // A constant result moved in as the immediate (a register takes any)
          self.DoLoadImm(DoWidth(self.FFunction.Signature.ResultType, AId), PhysicalOperand(LReg),
            self.FModule.InstrAt(AInstr.Operands[0]).Imm, AInstr.Node);
        else
          self.DoCopy(self.FFunction.Signature.ResultType, PhysicalOperand(LReg),
            self.DoVReg(AInstr.Operands[0]), AId, AInstr.Node);
        end;
      end;
      if self.FFunction.ScopeCount() > 0 then
        self.DoEmit(X64Op.Nop, 0, AInstr.Node);
      end;
      LRet := self.DoEmit(X64Op.Ret, 0, AInstr.Node);
      if LReg >= 0 then
        LRet.ImplicitUses.Add(LReg);
      end;
    end;

    // True when SSA block ABlock starts with phis (its edges carry copies)
    hidden method DoHasPhis(const ABlock: int64): bool;
    var
      LInstrs: ref Int64List;
      LJ: int64;
    begin
      LInstrs := self.FModule.BlockAt(ABlock).Instrs;
      for LJ := 0 to LInstrs.Count - 1 do
        if self.FModule.InstrAt(LInstrs[LJ]).Kind = IrOp.Phi then
          return true;
        end;
      end;
      return false;
    end;

    // The copies of the edge AFrom -> ATo into the current block: every phi's operand from
    // AFrom into a fresh register, then each phi from its own (see the header)
    hidden method DoEdgeCopies(const AFrom: int64; const ATo: int64);
    var
      LInstrs: ref Int64List;
      LPhis: ref Int64List;
      LTemps: Int64Array;
      LPhi: ref IrInstr;
      LJ: int64;
      LK: int64;
    begin
      LInstrs := self.FModule.BlockAt(ATo).Instrs;
      LPhis := ref Int64List();
      for LJ := 0 to LInstrs.Count - 1 do
        if self.FModule.InstrAt(LInstrs[LJ]).Kind = IrOp.Phi then
          LPhis.Add(LInstrs[LJ]);
        end;
      end;
      setlength(LTemps, LPhis.Count);
      for LJ := 0 to LPhis.Count - 1 do
        LPhi := self.FModule.InstrAt(LPhis[LJ]);
        LK := LPhi.Targets.IndexOf(AFrom);
        if LK < 0 then
          raise(ADAM_X64_SELECT_FAULT_PHI_EDGE + IntToStr(AFrom) + " at i" + IntToStr(LPhis[LJ]));
        end;
        LTemps[LJ] := self.FMachine.NewVReg(DoClassOf(LPhi.ValueType));
        if self.DoIsImmConstant(LPhi.Operands[LK]) then
          // An integer constant moved in as the immediate (no flags are live on an edge)
          self.DoLoadImm(DoWidth(LPhi.ValueType, LPhis[LJ]), VirtualOperand(LTemps[LJ]),
            self.FModule.InstrAt(LPhi.Operands[LK]).Imm, LPhi.Node);
        else
          self.DoCopy(LPhi.ValueType, VirtualOperand(LTemps[LJ]), self.DoVReg(LPhi.Operands[LK]),
            LPhis[LJ], LPhi.Node);
        end;
      end;
      for LJ := 0 to LPhis.Count - 1 do
        LPhi := self.FModule.InstrAt(LPhis[LJ]);
        self.DoCopy(LPhi.ValueType, self.DoVReg(LPhis[LJ]), VirtualOperand(LTemps[LJ]),
          LPhis[LJ], LPhi.Node);
      end;
    end;

    // A jump from the current block to SSA block ATarget, with the edge's copies
    hidden method DoJumpTo(const ATarget: int64; const ANode: int64);
    var
      LJump: ref MachineInstr;
      LBlock: int64;
    begin
      LBlock := self.DoMachineBlock(ATarget);
      self.DoEdgeCopies(self.FSource, ATarget);
      LJump := self.DoEmit(X64Op.Jmp, 0, ANode);
      LJump.AddOperand(BlockOperand(LBlock));
    end;

    // Where a branch from the current SSA block to ATarget goes: ATarget's machine block, or
    // for a block with phis a new edge block (the copies, then a jump on)
    hidden method DoBranchTarget(const ATarget: int64; const ANode: int64): int64;
    var
      LEdge: int64;
      LSaved: int64;
    begin
      if not self.DoHasPhis(ATarget) then
        return self.DoMachineBlock(ATarget);
      end;
      LEdge := self.FMachine.AddBlock(0);
      self.FMachine.BlockAt(LEdge).EdgeFrom := self.FSource;
      self.FMachine.BlockAt(LEdge).EdgeTo := ATarget;
      LSaved := self.FCurrent;
      self.FCurrent := LEdge;
      self.DoJumpTo(ATarget, ANode);
      self.FCurrent := LSaved;
      return LEdge;
    end;

    // The flags of the branch condition ACond, at ANode, and the condition a jcc to its true
    // target takes: a fused compare's own (DoCompareFlags), else the bool tested (non-zero)
    hidden method DoFlagsOf(const ACond: int64; const ANode: int64): X64Cond;
    var
      LWidth: int64;
    begin
      if self.FFused.Find(ACond) = 1 then
        return self.DoCompareFlags(self.FModule.InstrAt(ACond), ANode);
      end;
      LWidth := DoWidth(self.FModule.InstrAt(ACond).ValueType, ACond);
      self.DoEmitPair(X64Op.Test, LWidth, self.DoVReg(ACond), self.DoVReg(ACond), ANode);
      return X64Cond.NotEqual;
    end;

    // branch: the flags (DoFlagsOf), a jcc to the then target, a jump to the else one; a
    // cmov diamond's is DoDiamond's
    hidden method DoBranch(const AInstr: ref IrInstr);
    var
      LThen: int64;
      LElse: int64;
      LJump: ref MachineInstr;
      LCond: X64Cond;
    begin
      if self.FDiamondJoin.Find(AInstr.Block) >= 0 then
        self.DoDiamond(AInstr);
        return;
      end;
      LThen := self.DoBranchTarget(AInstr.Targets[0], AInstr.Node);
      LElse := self.DoBranchTarget(AInstr.Targets[1], AInstr.Node);
      LCond := self.DoFlagsOf(AInstr.Operands[0], AInstr.Node);
      LJump := self.DoEmit(X64Op.Jcc, 0, AInstr.Node);
      LJump.Cond := LCond;
      LJump.AddOperand(BlockOperand(LThen));
      LJump := self.DoEmit(X64Op.Jmp, 0, AInstr.Node);
      LJump.AddOperand(BlockOperand(LElse));
    end;

    // A cmov diamond's branch (see the header): each join phi's false value moved into a
    // temporary of its own (4 bytes for a narrower one: cmov has no 1-byte form, the low
    // bytes are the same), the flags, a cmov of its true value (a 1 / 0 pair: a setcc of
    // the condition or its inverse, then movzx), then each phi given its temporary (all
    // temporaries first: a phi may be another's value), a jump to the join. Nothing between
    // the flags and the last cmov changes them
    hidden method DoDiamond(const AInstr: ref IrInstr);
    var
      LPhis: ref Int64List;
      LPhi: ref IrInstr;
      LTemps: Int64Array;
      LTrues: Int64Array;
      LForms: Int64Array;
      LJoin: int64;
      LFalse: int64;
      LWidth: int64;
      LCond: X64Cond;
      LMove: ref MachineInstr;
      LJ: int64;
    begin
      LJoin := self.FDiamondJoin.Find(AInstr.Block);
      LPhis := self.DoPhisOf(LJoin);
      setlength(LTemps, LPhis.Count);
      setlength(LTrues, LPhis.Count);
      setlength(LForms, LPhis.Count);
      for LJ := 0 to LPhis.Count - 1 do
        LPhi := self.FModule.InstrAt(LPhis[LJ]);
        LTrues[LJ] := self.DoPhiValue(LPhis[LJ], self.FDiamondTrue.Find(AInstr.Block));
        LFalse := self.DoPhiValue(LPhis[LJ], self.FDiamondFalse.Find(AInstr.Block));
        LForms[LJ] := self.DoSetForm(LTrues[LJ], LFalse);
        LTemps[LJ] := self.FMachine.NewVReg(RegClass.General);
        if LForms[LJ] = 0 then
          LWidth := DoWidth(LPhi.ValueType, LPhis[LJ]);
          self.DoEmitPair(X64Op.Mov, DoPickWidth(LWidth < 4, 4, LWidth), VirtualOperand(LTemps[LJ]),
            self.DoVReg(LFalse), AInstr.Node);
        end;
      end;
      LCond := self.DoFlagsOf(AInstr.Operands[0], AInstr.Node);
      for LJ := 0 to LPhis.Count - 1 do
        LPhi := self.FModule.InstrAt(LPhis[LJ]);
        if LForms[LJ] = 0 then
          LWidth := DoWidth(LPhi.ValueType, LPhis[LJ]);
          LMove := self.DoEmit(X64Op.CMov, DoPickWidth(LWidth < 4, 4, LWidth), AInstr.Node);
          LMove.Cond := LCond;
          LMove.AddOperand(VirtualOperand(LTemps[LJ]));
          LMove.AddOperand(self.DoVReg(LTrues[LJ]));
        else
          if LForms[LJ] = 1 then
            self.DoSetCond(LCond, VirtualOperand(LTemps[LJ]), AInstr.Node);
          else
            self.DoSetCond(DoInvert(LCond), VirtualOperand(LTemps[LJ]), AInstr.Node);
          end;
          self.DoEmitPair(X64Op.MovZX8, 4, VirtualOperand(LTemps[LJ]), VirtualOperand(LTemps[LJ]),
            AInstr.Node);
        end;
      end;
      for LJ := 0 to LPhis.Count - 1 do
        LPhi := self.FModule.InstrAt(LPhis[LJ]);
        self.DoCopy(LPhi.ValueType, self.DoVReg(LPhis[LJ]), VirtualOperand(LTemps[LJ]), LPhis[LJ],
          AInstr.Node);
      end;
      self.DoJumpMachine(self.DoMachineBlock(LJoin), AInstr.Node);
    end;

    // One SSA instruction into the current machine block. A parameter was copied at the
    // entry (DoParameters); a phi's value arrives by its edges' copies (DoEdgeCopies); a
    // folded instruction (DoIsFolded) makes nothing
    hidden method DoInstr(const AId: int64);
    var
      LInstr: ref IrInstr;
      LValue: ref IrInstr;
    begin
      if self.DoIsFolded(AId) then
        return;
      end;
      LInstr := self.FModule.InstrAt(AId);
      match LInstr.Kind of
        IrOp.Constant: self.DoConstant(AId, LInstr);
        IrOp.Slot: self.DoSlot(AId, LInstr);
        IrOp.Parameter:
          if self.FSource <> self.FFunction.Blocks[0] then
            raise(ADAM_X64_SELECT_FAULT_PARAM_PLACE + IntToStr(AId));
          end;
        IrOp.Load:
          self.DoCopy(LInstr.ValueType, self.DoVReg(AId), self.DoAddressOf(LInstr.Operands[0]),
            AId, LInstr.Node);
        IrOp.Store:
          LValue := self.FModule.InstrAt(LInstr.Operands[1]);
          if self.DoStoreImm(LInstr) then
            // A constant stored as the immediate (a float's bits too)
            self.DoEmitPair(X64Op.Mov, DoWidth(LValue.ValueType, AId),
              self.DoAddressOf(LInstr.Operands[0]), ImmediateOperand(LValue.Imm), LInstr.Node);
          else
            self.DoCopy(LValue.ValueType, self.DoAddressOf(LInstr.Operands[0]),
              self.DoVReg(LInstr.Operands[1]), AId, LInstr.Node);
          end;
        IrOp.Add, IrOp.Sub: self.DoArithmetic(AId, LInstr);
        IrOp.Offset: self.DoOffset(AId, LInstr);
        IrOp.Address:
          self.DoEmitPair(X64Op.Lea, DoWidth(IrType.Pointer, AId), self.DoVReg(AId),
            RipMemory(SymbolClass.Data, self.FModule.DataAt(LInstr.Link).Symbol, ""), LInstr.Node);
        IrOp.Call, IrOp.CallExternal, IrOp.CallIndirect: self.DoCallInstr(AId, LInstr);
        IrOp.CodeAddress, IrOp.ImportAddress: self.DoCodeAddress(AId, LInstr);
        IrOp.VarargsStart: self.DoVarargsStart(AId, LInstr);
        IrOp.ThreadAddress: self.DoThreadAddress(AId, LInstr);
        IrOp.Ret: self.DoRet(AId, LInstr);
        IrOp.Jump: self.DoJumpTo(LInstr.Targets[0], LInstr.Node);
        IrOp.Branch: self.DoBranch(LInstr);
        // Control never reaches here (a noreturn call ended the block): ud2 keeps that
        // call's return address inside the function for the unwinder
        IrOp.Unreachable: self.DoEmit(X64Op.Ud2, 0, LInstr.Node);
        // An @breakpoint's line: one nop, its address the debugger's (DESIGN sec 9)
        IrOp.Mark: self.DoEmit(X64Op.Nop, 0, LInstr.Node);
        IrOp.Phi: return;
        IrOp.Convert: self.DoConvert(AId, LInstr);
        IrOp.Mul, IrOp.BitAnd, IrOp.BitOr, IrOp.BitXor: self.DoCombine(AId, LInstr);
        IrOp.Neg, IrOp.BitNot: self.DoNegate(AId, LInstr);
        IrOp.Shl, IrOp.Shr, IrOp.Sar: self.DoShift(AId, LInstr);
        IrOp.SDiv, IrOp.UDiv, IrOp.SRem, IrOp.URem: self.DoDivide(AId, LInstr);
        IrOp.FDiv: self.DoFloatArith(AId, LInstr);
        IrOp.Compare: self.DoCompare(AId, LInstr);
        IrOp.Copy, IrOp.Fill: self.DoBytes(AId, LInstr);
        IrOp.AtomicAdd, IrOp.AtomicSwap, IrOp.AtomicCas, IrOp.AtomicLoad, IrOp.AtomicStore:
          self.DoAtomic(AId, LInstr);
      end;
    end;

    // The per-id maps, empty (every id "none"): they grow with the function's own ids, so
    // selecting one function costs its size, never the module's
    hidden method DoClearMaps();
    begin
      self.FVRegOf := ref Int64Map(-1);
      self.FSlotOf := ref Int64Map(-1);
      self.FUsedAsValue := ref Int64Map(0);
      self.FParentAt := ref Int64Map(-1);
      self.FBlockOf := ref Int64Map(-1);
      self.FUseCount := ref Int64Map(0);
      self.FUserOf := ref Int64Map(-1);
      self.FFused := ref Int64Map(0);
      self.FPredCount := ref Int64Map(0);
      self.FAbsorbed := ref Int64Map(0);
      self.FDiamondJoin := ref Int64Map(-1);
      self.FDiamondTrue := ref Int64Map(-1);
      self.FDiamondFalse := ref Int64Map(-1);
    end;

    // The machine code of SSA function AFunction (see the header)
    method Run(const AFunction: int64): ref MachineFunction;
    var
      LBlocks: ref Int64List;
      LInstrs: ref Int64List;
      LVolatile: StringArray;
      LI: int64;
      LJ: int64;
    begin
      self.FFunction := self.FModule.FunctionAt(AFunction);
      self.FFunctionId := AFunction;
      LBlocks := self.FFunction.Blocks;
      if LBlocks.Count = 0 then
        raise(ADAM_X64_SELECT_FAULT_NO_BLOCKS + self.FFunction.Symbol);
      end;
      if (self.FFunction.Parent <> 0) and ((self.FParent = nil) or (self.FParent.Frame = nil)) then
        raise(ADAM_X64_SELECT_FAULT_PARENT + IntToStr(self.FFunction.FrameValue) + " in " +
          self.FFunction.Symbol);
      end;
      self.FMachine := ref MachineFunction(self.FFunction.Symbol, self.FFunction.Node);
      self.FMachine.Internal := self.FFunction.Internal;
      self.FOwnLayout := self.FAbi.LayoutCall(self.FFunction.Signature);
      self.FOwnVarargs := nil;
      if self.FFunction.Signature.Variadic then
        self.FOwnVarargs := self.FAbi.LayoutVarargs(self.FFunction.Signature);
      end;
      self.FVolatile := ref Int64List();
      LVolatile := self.FAbi.Volatile();
      for LI := 0 to len(LVolatile) - 1 do
        self.FVolatile.Add(self.DoPhysical(LVolatile[LI]));
      end;
      self.DoClearMaps();
      self.DoScan();
      self.DoAssign();
      // A cmov diamond's arm makes no machine block (its branch jumps past it)
      for LI := 0 to LBlocks.Count - 1 do
        if self.FAbsorbed.Find(LBlocks[LI]) <> 1 then
          self.FBlockOf.Put(LBlocks[LI], self.FMachine.AddBlock(LBlocks[LI]));
        end;
      end;
      self.FSource := LBlocks[0];
      self.FCurrent := self.FBlockOf.Find(LBlocks[0]);
      self.DoParameters();
      for LI := 0 to LBlocks.Count - 1 do
        if self.FAbsorbed.Find(LBlocks[LI]) = 1 then
          skip;
        end;
        self.FSource := LBlocks[LI];
        self.FCurrent := self.FBlockOf.Find(LBlocks[LI]);
        LInstrs := self.FModule.BlockAt(LBlocks[LI]).Instrs;
        for LJ := 0 to LInstrs.Count - 1 do
          self.DoInstr(LInstrs[LJ]);
        end;
      end;
      return self.FMachine;
    end;
  end;

// The machine code of function AFunction of AModule, calls and parameters laid out by AAbi,
// registers numbered by Adam.X64.Registers (see the header); AParent a funclet's generated
// parent (nil for any other function), whose frame offsets its parent slots take; raises for
// a malformed function and for a register AAbi names that x86_64 lacks
public routine SelectFunction(const AModule: ref IrModule; const AFunction: int64;
  const AAbi: ref AbiPart; const AParent: ref FunctionCode): ref MachineFunction;
var
  LSelector: ref Selector;
begin
  LSelector := ref Selector(AModule, AAbi, AParent);
  return LSelector.Run(AFunction);
end;

end.
