-------------------------------------------------------------------------------
  Adam.Debug.Console.adam - the console Adam's debugger runs in (M11a D4)

  IsDebugConsole    standard input and output are both a console (the
                    program shares it: DebugOutputMode.Inherit)
  BreakKeysOn       the console's Ctrl+C / Ctrl+Break taken by the debugger
                    (counted, never the end of adam) until BreakKeysOff
  TakeBreakKey      true once per press counted since the last take; a
                    DebugRuntime's pause check (SetPauseCheck) while the
                    program runs, the prompt's "read again" while it waits

  Target-neutral: the OS's console calls are the platform part's (picked by
  the triple this compiler was built for, as System.Console picks its
  own); a linux64 one takes SIGINT the same way.
*******************************************************************************/

module unit Adam.Debug.Console;

// Only the host part of an OS this console has one for: the debugger runs on Windows today
@ifdef TARGET_X86_64_WINDOWS_GNU
import Adam.Debug.Console.Win64;
@endif

// True when standard input and output are both a console (false on a host with no part)
public func IsDebugConsole(): bool;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return DebugConsolePlatformIsConsole();
@else
  return false;
@endif
end;

// The console's break keys taken (see the header); false when the OS refused, nothing
// changed then
public func BreakKeysOn(): bool;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return DebugConsolePlatformBreakKeysOn();
@else
  return false;
@endif
end;

// The console's break keys given back to the console
public func BreakKeysOff();
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  DebugConsolePlatformBreakKeysOff();
@endif
end;

// True once per break key counted since the last take
public func TakeBreakKey(): bool;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return DebugConsolePlatformTakeBreakKey();
@else
  return false;
@endif
end;

end.
