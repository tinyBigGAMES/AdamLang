  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  Adam.Driver.CLI.adam - adam's command line

  RunCommandLine reads argv through the paramcount / paramstr intrinsics and
  drives one Adam.Driver.Compiler. Everything the command line knows is in
  two tables, and both the reader and the help read only them:

    DoCommandTable   every command: its word, its one positional argument
                     (a file or a help topic) as the help writes it, its
                     summary, its examples
    DoOptionTable    every option: its short and long forms, the value it
                     takes ("" = a flag), its summary, the commands it
                     belongs to (none listed = every command); DoApply is
                     its handler, by its CliOption

  A new command or option is one more table entry (and its handler): the
  reader, the help's rows and columns and the mistakes follow from it. The
  targets are Adam.Target.Registry's: -t (a name or a triple) is checked
  against it, and the help of adam and of every command that takes -t lists
  what it holds (the default marked), so a target added there reaches the
  command line by itself; no target is named in any text here.

  The line: options anywhere, a value-taking option takes the next argument
  whatever it is; the first other argument is the command, the next its
  positional argument. No command: adam's help. -h / --help: the help of the
  command given, else adam's. The banner (adam's name and version) comes
  first unless --no-banner is given.

  On a console that takes VT sequences (System.Windows' EnableConsoleColor)
  the banner, the help (HelpOut) and every report's severity word
  (Diagnostics.SetColor) are in color; piped or redirected, every line is
  plain text, byte for byte what the rows compare.

  A command line mistake is one Error with no place (CL codes, texts in
  Adam.Core.Messages) ending in the help to see, reported into the compile's
  own Diagnostics, so every line adam prints has one form. Exit codes:
  ADAM_DRIVER_EXIT_OK / ADAM_DRIVER_EXIT_ERRORS from the compile (the help
  is ADAM_DRIVER_EXIT_OK), ADAM_CLI_EXIT_USAGE for a mistake. CL0001 (the
  old one-line usage) is retired: its number is not reused.
*******************************************************************************/

module unit Adam.Driver.CLI;

import System.SysUtils, System.Windows, Adam.Core.Common, Adam.Core.Messages, Adam.Target,
  Adam.Target.Registry, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics, Adam.Driver.Compiler;

exported const
  ADAM_ERR_CLI_002: string = "CL0002";   // not a command
  ADAM_ERR_CLI_003: string = "CL0003";   // a command with no file
  ADAM_ERR_CLI_004: string = "CL0004";   // one positional argument too many
  ADAM_ERR_CLI_005: string = "CL0005";   // not an option (of the command given)
  ADAM_ERR_CLI_006: string = "CL0006";   // help of what is not a command
  ADAM_ERR_CLI_007: string = "CL0007";   // an option with no value after it
  ADAM_ERR_CLI_008: string = "CL0008";   // an option given twice
  ADAM_ERR_CLI_009: string = "CL0009";   // -t names no target the registry has

  // The commands, as the user types them
  ADAM_CLI_BUILD: string = "build";
  ADAM_CLI_CHECK: string = "check";
  ADAM_CLI_HELP: string = "help";

  // The options, as the user types them
  ADAM_CLI_OUTPUT_SHORT: string = "-o";
  ADAM_CLI_OUTPUT_LONG: string = "--output";
  ADAM_CLI_TARGET_SHORT: string = "-t";
  ADAM_CLI_TARGET_LONG: string = "--target";
  ADAM_CLI_NO_BANNER_LONG: string = "--no-banner";
  ADAM_CLI_HELP_SHORT: string = "-h";
  ADAM_CLI_HELP_LONG: string = "--help";

  // The program's own name, what an option outside any command belongs to
  ADAM_CLI_PROGRAM: string = "adam";

  // The help's indent and the gap between its two columns
  ADAM_CLI_INDENT: string = "  ";
  ADAM_CLI_GAP: string = "  ";

  // The exit code of a command line mistake (no compile ran)
  ADAM_CLI_EXIT_USAGE: int32 = 2;

type
  // adam's commands
  CliCommand = choices(Build, Check, Help);

  // What a command's one positional argument is
  CliPositional = choices(File, Topic);

  // adam's options, each one's handler picked by it (DoApply)
  CliOption = choices(Output, Target, NoBanner, Help);

  // The commands an option belongs to
  CliCommandArray = array of CliCommand;

  // One command, as the reader and the help see it
  CommandSpec = record
    Id: CliCommand;
    Word: string;
    Positional: CliPositional;
    Argument: string;
    Summary: string;
    Examples: StringArray;
  end;

  // Every command, in the order the help lists them
  CommandTable = array of CommandSpec;

  // One option, as the reader and the help see it
  OptionSpec = record
    Id: CliOption;
    Short: string;
    Long: string;
    Value: string;
    Summary: string;
    Commands: CliCommandArray;
  end;

  // Every option, in the order the help lists them
  OptionTable = array of OptionSpec;

  // One command line, as read: Command an index into the command table (-1 = none given);
  // TargetText what -t gave as typed, TargetTriple the triple of the registry's target it
  // names
  CliRequest = record
    Command: int64;
    Positional: string;
    Output: string;
    TargetText: string;
    TargetTriple: string;
    NoBanner: bool;
    WantHelp: bool;
  end;

// Adds AText at the end of AList
routine DoAddString(var AList: StringArray; const AText: string);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := AText;
end;

// Adds ACommand at the end of AList
routine DoAddCommandId(var AList: CliCommandArray; const ACommand: CliCommand);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := ACommand;
end;

// A command with no examples yet
routine DoCommand(const AId: CliCommand; const AWord: string; const APositional: CliPositional;
  const AArgument: string; const ASummary: string): CommandSpec;
var
  LSpec: CommandSpec;
begin
  LSpec.Id := AId;
  LSpec.Word := AWord;
  LSpec.Positional := APositional;
  LSpec.Argument := AArgument;
  LSpec.Summary := ASummary;
  setlength(LSpec.Examples, 0);
  return LSpec;
end;

// Adds ASpec at the end of ATable
routine DoAddCommand(var ATable: CommandTable; const ASpec: CommandSpec);
var
  LCount: int64;
begin
  LCount := len(ATable);
  setlength(ATable, LCount + 1);
  ATable[LCount] := ASpec;
end;

// Every command (see the header)
routine DoCommandTable(): CommandTable;
var
  LTable: CommandTable;
  LSpec: CommandSpec;
begin
  setlength(LTable, 0);

  LSpec := DoCommand(CliCommand.Build, ADAM_CLI_BUILD, CliPositional.File, ADAM_MSG_CLI_ARG_FILE,
    ADAM_MSG_CLI_HELP_BUILD);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_BUILD);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_BUILD_OUTPUT);
  DoAddCommand(LTable, LSpec);

  LSpec := DoCommand(CliCommand.Check, ADAM_CLI_CHECK, CliPositional.File, ADAM_MSG_CLI_ARG_FILE,
    ADAM_MSG_CLI_HELP_CHECK);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_CHECK);
  DoAddCommand(LTable, LSpec);

  LSpec := DoCommand(CliCommand.Help, ADAM_CLI_HELP, CliPositional.Topic, ADAM_MSG_CLI_ARG_COMMAND,
    ADAM_MSG_CLI_HELP_HELP);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_HELP);
  DoAddCommand(LTable, LSpec);

  return LTable;
end;

// An option that belongs to every command until commands are added to it
routine DoOption(const AId: CliOption; const AShort: string; const ALong: string;
  const AValue: string; const ASummary: string): OptionSpec;
var
  LSpec: OptionSpec;
begin
  LSpec.Id := AId;
  LSpec.Short := AShort;
  LSpec.Long := ALong;
  LSpec.Value := AValue;
  LSpec.Summary := ASummary;
  setlength(LSpec.Commands, 0);
  return LSpec;
end;

// Adds ASpec at the end of ATable
routine DoAddOption(var ATable: OptionTable; const ASpec: OptionSpec);
var
  LCount: int64;
begin
  LCount := len(ATable);
  setlength(ATable, LCount + 1);
  ATable[LCount] := ASpec;
end;

// Every option (see the header)
routine DoOptionTable(): OptionTable;
var
  LTable: OptionTable;
  LSpec: OptionSpec;
begin
  setlength(LTable, 0);

  LSpec := DoOption(CliOption.Output, ADAM_CLI_OUTPUT_SHORT, ADAM_CLI_OUTPUT_LONG,
    ADAM_MSG_CLI_ARG_DIR, ADAM_MSG_CLI_HELP_OUTPUT);
  DoAddCommandId(LSpec.Commands, CliCommand.Build);
  DoAddOption(LTable, LSpec);

  LSpec := DoOption(CliOption.Target, ADAM_CLI_TARGET_SHORT, ADAM_CLI_TARGET_LONG,
    ADAM_MSG_CLI_ARG_TARGET, ADAM_MSG_CLI_HELP_TARGET);
  DoAddCommandId(LSpec.Commands, CliCommand.Build);
  DoAddCommandId(LSpec.Commands, CliCommand.Check);
  DoAddOption(LTable, LSpec);

  DoAddOption(LTable, DoOption(CliOption.NoBanner, "", ADAM_CLI_NO_BANNER_LONG, "",
    ADAM_MSG_CLI_HELP_NO_BANNER));

  DoAddOption(LTable, DoOption(CliOption.Help, ADAM_CLI_HELP_SHORT, ADAM_CLI_HELP_LONG, "",
    ADAM_MSG_CLI_HELP_HELP_OPTION));

  return LTable;
end;

// The index of the command whose word is AWord in ATable; -1 when there is none
routine DoFindCommand(const ATable: CommandTable; const AWord: string): int64;
var
  LI: int64;
begin
  for LI := 0 to len(ATable) - 1 do
    if ATable[LI].Word = AWord then
      return LI;
    end;
  end;
  return -1;
end;

// The index of the option written AArg (its short or its long form) in ATable; -1 when there
// is none
routine DoFindOption(const ATable: OptionTable; const AArg: string): int64;
var
  LI: int64;
begin
  for LI := 0 to len(ATable) - 1 do
    if (ATable[LI].Long = AArg) or ((ATable[LI].Short <> "") and (ATable[LI].Short = AArg)) then
      return LI;
    end;
  end;
  return -1;
end;

// True when AArg is written as an option: it starts with '-'
routine DoIsOption(const AArg: string): bool;
begin
  if len(AArg) = 0 then
    return false;
  end;
  return AArg[0] = '-';
end;

// True when AOption belongs to ACommand (an option that lists no command belongs to every one)
routine DoBelongs(const AOption: OptionSpec; const ACommand: CliCommand): bool;
var
  LI: int64;
begin
  if len(AOption.Commands) = 0 then
    return true;
  end;
  for LI := 0 to len(AOption.Commands) - 1 do
    if AOption.Commands[LI] = ACommand then
      return true;
    end;
  end;
  return false;
end;

// True when AOption belongs to every command
routine DoBelongsToAll(const AOption: OptionSpec): bool;
begin
  return len(AOption.Commands) = 0;
end;

// The index in argv of the command: the first argument that is neither an option nor a
// value-taking option's value. 0 when the line has none
routine DoCommandAt(const AOptions: OptionTable): int32;
var
  LIndex: int32;
  LArg: string;
  LOption: int64;
begin
  LIndex := 1;
  while LIndex <= paramcount() do
    LArg := paramstr(LIndex);
    if not DoIsOption(LArg) then
      return LIndex;
    end;
    LOption := DoFindOption(AOptions, LArg);
    if (LOption >= 0) and (AOptions[LOption].Value <> "") then
      LIndex := LIndex + 2;
    else
      LIndex := LIndex + 1;
    end;
  end;
  return 0;
end;

// True when the line gives --no-banner as an option (never as another option's value), read
// before the line is checked so the banner leads even a mistake's line
routine DoWantsNoBanner(const AOptions: OptionTable): bool;
var
  LIndex: int32;
  LOption: int64;
begin
  LIndex := 1;
  while LIndex <= paramcount() do
    LOption := DoFindOption(AOptions, paramstr(LIndex));
    if LOption < 0 then
      LIndex := LIndex + 1;
    else
      if AOptions[LOption].Id = CliOption.NoBanner then
        return true;
      end;
      if AOptions[LOption].Value <> "" then
        LIndex := LIndex + 2;
      else
        LIndex := LIndex + 1;
      end;
    end;
  end;
  return false;
end;

// The help a mistake points to: `adam help <command>` for the command at ACommand in ACommands,
// `adam help` when ACommand is -1
routine DoSee(const ACommands: CommandTable; const ACommand: int64): string;
begin
  if ACommand < 0 then
    return ADAM_MSG_CLI_SEE_ANY;
  end;
  return NoArgs().Str(ACommands[ACommand].Word).Fill(ADAM_MSG_CLI_SEE);
end;

// Reports one command line mistake into AReports: an Error with no place, ACode, ATemplate
// filled with AArgs
routine DoReport(const AReports: ref Diagnostics; const ACode: string; const ATemplate: string;
  const AArgs: MessageArgs);
begin
  AReports.Add(Severity.Error, ACode, NoPlace(), ATemplate, AArgs);
end;

// DoReport, then false: what a reader returns on a mistake
routine DoMistake(const AReports: ref Diagnostics; const ACode: string; const ATemplate: string;
  const AArgs: MessageArgs): bool;
begin
  DoReport(AReports, ACode, ATemplate, AArgs);
  return false;
end;

// Every target the registry has, as a mistake lists them: name (triple), comma separated
routine DoTargetList(): string;
var
  LTargets: TargetList;
  LItems: StringArray;
  LI: int64;
begin
  LTargets := AllTargets();
  setlength(LItems, 0);
  for LI := 0 to len(LTargets) - 1 do
    DoAddString(LItems, NoArgs().Str(LTargets[LI].TargetName()).Str(LTargets[LI].Triple())
      .Fill(ADAM_MSG_CLI_TARGET_ITEM));
  end;
  return JoinStrings(LItems, ", ");
end;

// The target -t gave (ARequest.TargetText, a name or a triple) checked against the registry,
// its triple put into ARequest.TargetTriple; nothing given: nothing to check. ASee names the
// help in a mistake. A target the registry lacks: reported (CL0009), false
routine DoReadTarget(const AReports: ref Diagnostics; var ARequest: CliRequest;
  const ASee: string): bool;
var
  LTarget: ref Target;
begin
  if ARequest.TargetText = "" then
    return true;
  end;
  LTarget := FindTargetNamed(ARequest.TargetText);
  if LTarget = nil then
    return DoMistake(AReports, ADAM_ERR_CLI_009, ADAM_MSG_CLI_BAD_TARGET,
      NoArgs().Str(ARequest.TargetText).Str(DoTargetList()).Str(ASee));
  end;
  ARequest.TargetTriple := LTarget.Triple();
  return true;
end;

// Option AId's handler: AValue (the argument after a value-taking option, else "") put into
// ARequest
routine DoApply(var ARequest: CliRequest; const AId: CliOption; const AValue: string);
begin
  if AId = CliOption.Output then
    ARequest.Output := AValue;
  end;
  if AId = CliOption.Target then
    ARequest.TargetText := AValue;
  end;
  if AId = CliOption.NoBanner then
    ARequest.NoBanner := true;
  end;
  if AId = CliOption.Help then
    ARequest.WantHelp := true;
  end;
end;

// Reads the option at AIndex (written as an option) into ARequest and moves AIndex past it
// (and its value). ACommandWord / ASee name the command given (else adam) and its help in a
// mistake; ASeen holds the options already given. A mistake: reported, false
routine DoReadOption(const ACommands: CommandTable; const AOptions: OptionTable;
  const AReports: ref Diagnostics; var ARequest: CliRequest; const ACommandWord: string;
  const ASee: string; var ASeen: BoolArray; var AIndex: int32): bool;
var
  LArg: string;
  LOption: int64;
  LBelongs: bool;
  LValue: string;
begin
  LArg := paramstr(AIndex);
  LOption := DoFindOption(AOptions, LArg);
  LBelongs := false;
  if LOption >= 0 then
    if ARequest.Command >= 0 then
      LBelongs := DoBelongs(AOptions[LOption], ACommands[ARequest.Command].Id);
    else
      LBelongs := DoBelongsToAll(AOptions[LOption]);
    end;
  end;
  if not LBelongs then
    return DoMistake(AReports, ADAM_ERR_CLI_005, ADAM_MSG_CLI_UNKNOWN_OPTION,
      NoArgs().Str(LArg).Str(ACommandWord).Str(ASee));
  end;
  if ASeen[LOption] then
    return DoMistake(AReports, ADAM_ERR_CLI_008, ADAM_MSG_CLI_OPTION_TWICE,
      NoArgs().Str(LArg).Str(ASee));
  end;
  ASeen[LOption] := true;
  LValue := "";
  if AOptions[LOption].Value <> "" then
    // A value-taking option takes the next argument, whatever it is
    if AIndex = paramcount() then
      return DoMistake(AReports, ADAM_ERR_CLI_007, ADAM_MSG_CLI_NO_VALUE,
        NoArgs().Str(LArg).Str(AOptions[LOption].Value).Str(ASee));
    end;
    LValue := paramstr(AIndex + 1);
    AIndex := AIndex + 2;
  else
    AIndex := AIndex + 1;
  end;
  DoApply(ARequest, AOptions[LOption].Id, LValue);
  return true;
end;

// Reads the whole command line into ARequest (see the header). A mistake: reported into
// AReports, false
routine DoRead(const ACommands: CommandTable; const AOptions: OptionTable;
  const AReports: ref Diagnostics; var ARequest: CliRequest): bool;
var
  LCommandAt: int32;
  LCommandWord: string;
  LSee: string;
  LSeen: BoolArray;
  LIndex: int32;
  LArg: string;
  LI: int64;
begin
  ARequest.Command := -1;
  ARequest.Positional := "";
  ARequest.Output := "";
  ARequest.TargetText := "";
  ARequest.TargetTriple := "";
  ARequest.NoBanner := false;
  ARequest.WantHelp := false;

  // The command first: what every option and argument after it is checked against
  LCommandAt := DoCommandAt(AOptions);
  LCommandWord := ADAM_CLI_PROGRAM;
  if LCommandAt > 0 then
    ARequest.Command := DoFindCommand(ACommands, paramstr(LCommandAt));
    if ARequest.Command < 0 then
      return DoMistake(AReports, ADAM_ERR_CLI_002, ADAM_MSG_CLI_UNKNOWN_COMMAND,
        NoArgs().Str(paramstr(LCommandAt)));
    end;
    LCommandWord := ACommands[ARequest.Command].Word;
  end;
  LSee := DoSee(ACommands, ARequest.Command);

  setlength(LSeen, len(AOptions));
  for LI := 0 to len(LSeen) - 1 do
    LSeen[LI] := false;
  end;
  LIndex := 1;
  while LIndex <= paramcount() do
    LArg := paramstr(LIndex);
    if LIndex = LCommandAt then
      LIndex := LIndex + 1;
    else
      if DoIsOption(LArg) then
        if not DoReadOption(ACommands, AOptions, AReports, ARequest, LCommandWord, LSee, LSeen,
          LIndex) then
          return false;
        end;
      else
        // Every argument after the command that is no option is its one positional argument
        if ARequest.Positional <> "" then
          return DoMistake(AReports, ADAM_ERR_CLI_004, ADAM_MSG_CLI_EXTRA_ARG,
            NoArgs().Str(LCommandWord).Str(LArg).Str(ARequest.Positional).Str(LSee));
        end;
        ARequest.Positional := LArg;
        LIndex := LIndex + 1;
      end;
    end;
  end;

  if (ARequest.Command >= 0) and not ARequest.WantHelp then
    if (ACommands[ARequest.Command].Positional = CliPositional.File) and
      (ARequest.Positional = "") then
      return DoMistake(AReports, ADAM_ERR_CLI_003, ADAM_MSG_CLI_NO_FILE,
        NoArgs().Str(LCommandWord).Str(LCommandWord).Str(LSee));
    end;
  end;
  return DoReadTarget(AReports, ARequest, LSee);
end;

// AText with blanks after it up to AWidth bytes (every help text is ASCII, so a byte is a
// column); AText itself when it is that wide already
routine DoPad(const AText: string; const AWidth: int64): string;
begin
  if len(AText) >= AWidth then
    return AText;
  end;
  return AText + StringOfChar(' ', AWidth - len(AText));
end;

// The wider of AWidth and AOther: a help column grows to its widest entry
routine DoWider(const AWidth: int64; const AOther: int64): int64;
begin
  if AOther > AWidth then
    return AOther;
  end;
  return AWidth;
end;

type
  // Where the banner and the help go: stdout, in color on a console that takes VT sequences
  // (headings bold, the left column and the examples cyan: Adam.Core.Common's sequences),
  // plain when piped or redirected. Every column is padded before it is colored, so a
  // colored help lines up as a plain one
  HelpOut = object
    hidden FColor: bool;

    init(const AColor: bool);
    begin
      self.FColor := AColor;
    end;

    // AText in the VT color AColor when this output takes color, else AText itself
    hidden const method DoPaint(const AText: string; const AColor: string): string;
    begin
      if not self.FColor or (AText = "") then
        return AText;
      end;
      return AColor + AText + ADAM_COLOR_RESET;
    end;

    // Prints AText as one line
    const method Line(const AText: string);
    begin
      println("{}", AText);
    end;

    // Prints a heading (a section's name, the banner) as one line
    const method Heading(const AText: string);
    begin
      self.Line(self.DoPaint(AText, ADAM_COLOR_BOLD));
    end;

    // Prints one row: ALeft padded to AWidth, then ARight
    const method Row(const ALeft: string; const ARight: string; const AWidth: int64);
    begin
      self.Line(ADAM_CLI_INDENT + self.DoPaint(DoPad(ALeft, AWidth), ADAM_COLOR_CYAN) +
        ADAM_CLI_GAP + ARight);
    end;

    // Prints one example command line, indented
    const method Example(const AText: string);
    begin
      self.Line(ADAM_CLI_INDENT + self.DoPaint(AText, ADAM_COLOR_CYAN));
    end;
  end;

// A command's left column: its word and its positional argument
routine DoCommandLeft(const ASpec: CommandSpec): string;
begin
  if ASpec.Argument = "" then
    return ASpec.Word;
  end;
  return ASpec.Word + " " + ASpec.Argument;
end;

// An option's left column: its short form (when it has one), its long form, its value
routine DoOptionLeft(const ASpec: OptionSpec): string;
var
  LText: string;
begin
  LText := ASpec.Long;
  if ASpec.Short <> "" then
    LText := ASpec.Short + ", " + LText;
  end;
  if ASpec.Value <> "" then
    LText := LText + " " + ASpec.Value;
  end;
  return LText;
end;

// The word of the command AId in ACommands
routine DoCommandWord(const ACommands: CommandTable; const AId: CliCommand): string;
var
  LI: int64;
begin
  for LI := 0 to len(ACommands) - 1 do
    if ACommands[LI].Id = AId then
      return ACommands[LI].Word;
    end;
  end;
  return "";
end;

// An option's right column in adam's own help: its summary, and the commands it belongs to
// when it does not belong to every one
routine DoOptionRightAll(const ACommands: CommandTable; const ASpec: OptionSpec): string;
var
  LWords: StringArray;
  LI: int64;
begin
  if DoBelongsToAll(ASpec) then
    return ASpec.Summary;
  end;
  setlength(LWords, 0);
  for LI := 0 to len(ASpec.Commands) - 1 do
    DoAddString(LWords, DoCommandWord(ACommands, ASpec.Commands[LI]));
  end;
  return NoArgs().Str(ASpec.Summary).Str(JoinStrings(LWords, ", ")).Fill(ADAM_MSG_CLI_ONLY_FOR);
end;

// The banner into AOut: adam's name and version, a blank line after it
routine DoBanner(const AOut: ref HelpOut);
begin
  AOut.Heading(NoArgs().Str(ADAM_VERSION_STR).Fill(ADAM_MSG_CLI_BANNER));
  AOut.Line("");
end;

// Prints into AOut the examples of every command in ACommands from AFirst to ALast, under
// their heading (nothing when there are none)
routine DoPrintExamples(const AOut: ref HelpOut; const ACommands: CommandTable;
  const AFirst: int64; const ALast: int64);
var
  LI: int64;
  LJ: int64;
  LAny: bool;
begin
  LAny := false;
  for LI := AFirst to ALast do
    for LJ := 0 to len(ACommands[LI].Examples) - 1 do
      if not LAny then
        AOut.Heading(ADAM_MSG_CLI_HEAD_EXAMPLES);
        LAny := true;
      end;
      AOut.Example(ACommands[LI].Examples[LJ]);
    end;
  end;
  if LAny then
    AOut.Line("");
  end;
end;

// The width of the widest target name the registry has
routine DoTargetsWidth(): int64;
var
  LTargets: TargetList;
  LWidth: int64;
  LI: int64;
begin
  LTargets := AllTargets();
  LWidth := 0;
  for LI := 0 to len(LTargets) - 1 do
    LWidth := DoWider(LWidth, len(LTargets[LI].TargetName()));
  end;
  return LWidth;
end;

// Prints into AOut every target the registry has under its heading, the name in a left
// column AWidth wide, its triple beside it (the default one marked), a blank line after
routine DoPrintTargets(const AOut: ref HelpOut; const AWidth: int64);
var
  LTargets: TargetList;
  LI: int64;
  LTriple: string;
begin
  LTargets := AllTargets();
  AOut.Heading(ADAM_MSG_CLI_HEAD_TARGETS);
  for LI := 0 to len(LTargets) - 1 do
    LTriple := LTargets[LI].Triple();
    if LTargets[LI].IsDefault() then
      LTriple := NoArgs().Str(LTriple).Fill(ADAM_MSG_CLI_TARGET_DEFAULT);
    end;
    AOut.Row(LTargets[LI].TargetName(), LTriple, AWidth);
  end;
  AOut.Line("");
end;

// True when the command ACommand takes the option that names a target (its help then lists
// the targets)
routine DoTakesTarget(const AOptions: OptionTable; const ACommand: CliCommand): bool;
var
  LI: int64;
begin
  for LI := 0 to len(AOptions) - 1 do
    if (AOptions[LI].Id = CliOption.Target) and DoBelongs(AOptions[LI], ACommand) then
      return true;
    end;
  end;
  return false;
end;

// adam's own help into AOut: the usage, every command, every option, every target, every
// example
routine DoHelpAll(const AOut: ref HelpOut; const ACommands: CommandTable;
  const AOptions: OptionTable);
var
  LWidth: int64;
  LI: int64;
begin
  // One left column for every list, as wide as their widest entry
  LWidth := DoTargetsWidth();
  for LI := 0 to len(ACommands) - 1 do
    LWidth := DoWider(LWidth, len(DoCommandLeft(ACommands[LI])));
  end;
  for LI := 0 to len(AOptions) - 1 do
    LWidth := DoWider(LWidth, len(DoOptionLeft(AOptions[LI])));
  end;

  AOut.Heading(ADAM_MSG_CLI_HEAD_USAGE);
  AOut.Line(ADAM_CLI_INDENT + ADAM_MSG_CLI_USAGE_ANY);
  AOut.Line("");
  AOut.Heading(ADAM_MSG_CLI_HEAD_COMMANDS);
  for LI := 0 to len(ACommands) - 1 do
    AOut.Row(DoCommandLeft(ACommands[LI]), ACommands[LI].Summary, LWidth);
  end;
  AOut.Line("");
  AOut.Heading(ADAM_MSG_CLI_HEAD_OPTIONS);
  for LI := 0 to len(AOptions) - 1 do
    AOut.Row(DoOptionLeft(AOptions[LI]), DoOptionRightAll(ACommands, AOptions[LI]), LWidth);
  end;
  AOut.Line("");
  DoPrintTargets(AOut, LWidth);
  DoPrintExamples(AOut, ACommands, 0, len(ACommands) - 1);
  AOut.Line(ADAM_MSG_CLI_MORE);
end;

// The help of the command at ACommand into AOut: its usage, its summary, its options, the
// targets (when it takes -t), its examples
routine DoHelpCommand(const AOut: ref HelpOut; const ACommands: CommandTable;
  const AOptions: OptionTable; const ACommand: int64);
var
  LSpec: CommandSpec;
  LWidth: int64;
  LI: int64;
begin
  LSpec := ACommands[ACommand];
  LWidth := 0;
  if DoTakesTarget(AOptions, LSpec.Id) then
    LWidth := DoTargetsWidth();
  end;
  for LI := 0 to len(AOptions) - 1 do
    if DoBelongs(AOptions[LI], LSpec.Id) then
      LWidth := DoWider(LWidth, len(DoOptionLeft(AOptions[LI])));
    end;
  end;

  AOut.Heading(ADAM_MSG_CLI_HEAD_USAGE);
  if LSpec.Argument = "" then
    AOut.Line(ADAM_CLI_INDENT + NoArgs().Str(LSpec.Word).Fill(ADAM_MSG_CLI_USAGE_COMMAND));
  else
    AOut.Line(ADAM_CLI_INDENT + NoArgs().Str(LSpec.Word).Str(LSpec.Argument)
      .Fill(ADAM_MSG_CLI_USAGE_COMMAND_ARG));
  end;
  AOut.Line("");
  AOut.Line(LSpec.Summary);
  AOut.Line("");
  AOut.Heading(ADAM_MSG_CLI_HEAD_OPTIONS);
  for LI := 0 to len(AOptions) - 1 do
    if DoBelongs(AOptions[LI], LSpec.Id) then
      AOut.Row(DoOptionLeft(AOptions[LI]), AOptions[LI].Summary, LWidth);
    end;
  end;
  AOut.Line("");
  if DoTakesTarget(AOptions, LSpec.Id) then
    DoPrintTargets(AOut, LWidth);
  end;
  DoPrintExamples(AOut, ACommands, ACommand, ACommand);
end;

// Runs the command line ARequest read: a help printed into AOut, or the compile it asks for
// run and its reports printed. The exit code
routine DoRun(const AOut: ref HelpOut; const ACompiler: ref Compiler;
  const ACommands: CommandTable; const AOptions: OptionTable; const ARequest: CliRequest): int32;
var
  LSpec: CommandSpec;
  LTopic: int64;
begin
  if ARequest.Command < 0 then
    DoHelpAll(AOut, ACommands, AOptions);
    return ADAM_DRIVER_EXIT_OK;
  end;
  if ARequest.WantHelp then
    DoHelpCommand(AOut, ACommands, AOptions, ARequest.Command);
    return ADAM_DRIVER_EXIT_OK;
  end;
  LSpec := ACommands[ARequest.Command];
  if LSpec.Id = CliCommand.Help then
    if ARequest.Positional = "" then
      DoHelpAll(AOut, ACommands, AOptions);
      return ADAM_DRIVER_EXIT_OK;
    end;
    LTopic := DoFindCommand(ACommands, ARequest.Positional);
    if LTopic < 0 then
      DoReport(ACompiler.Reports, ADAM_ERR_CLI_006, ADAM_MSG_CLI_HELP_UNKNOWN,
        NoArgs().Str(ARequest.Positional));
      ACompiler.PrintReports();
      return ADAM_CLI_EXIT_USAGE;
    end;
    DoHelpCommand(AOut, ACommands, AOptions, LTopic);
    return ADAM_DRIVER_EXIT_OK;
  end;
  if ARequest.TargetTriple <> "" then
    ACompiler.SetTarget(ARequest.TargetTriple);
  end;
  if LSpec.Id = CliCommand.Check then
    ACompiler.Check(ARequest.Positional);
  else
    ACompiler.Build(ARequest.Positional, ARequest.Output);
  end;
  ACompiler.PrintReports();
  return ACompiler.ExitCode();
end;

// Runs adam's command line (see the header): the exit code for the process
exported routine RunCommandLine(): int32;
var
  LCompiler: ref Compiler;
  LCommands: CommandTable;
  LOptions: OptionTable;
  LRequest: CliRequest;
  LColor: bool;
  LOut: ref HelpOut;
begin
  // Color only on a console that takes VT sequences; piped or redirected, every line is
  // plain (what a file, another program and adamtest read)
  LColor := EnableConsoleColor();
  LOut := ref HelpOut(LColor);
  LCompiler := ref Compiler();
  LCompiler.Reports.SetColor(LColor);
  LCommands := DoCommandTable();
  LOptions := DoOptionTable();
  if not DoWantsNoBanner(LOptions) then
    DoBanner(LOut);
  end;
  if not DoRead(LCommands, LOptions, LCompiler.Reports, LRequest) then
    LCompiler.PrintReports();
    return ADAM_CLI_EXIT_USAGE;
  end;
  return DoRun(LOut, LCompiler, LCommands, LOptions, LRequest);
end;

end.
