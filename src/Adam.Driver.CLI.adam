-------------------------------------------------------------------------------
  Adam.Driver.CLI.adam - adam's command line

  RunCommandLine reads argv through the paramcount / paramstr intrinsics
  (paramstr(1) is the command) and drives one Adam.Driver.Compiler:

    adam build <file> [-o <dir>]
                        the program whose main module is <file> built:
                        the front end, then its exe generated into <dir>
                        (Adam.Driver.Compiler.Build says where without it);
                        its diagnostics printed
    adam check <file>   the front end on the program whose main module is
                        <file>; its diagnostics printed
    adam help           the banner and the usage (also -h, --help, or no
                        argument at all)

  A command takes exactly one file; -o takes the next argument as its
  folder, once (CL0007 with none after it, CL0008 a second time).

  A command line mistake is a diagnostic with no place (CL codes, texts in
  Adam.Core.Messages), reported into the compile's own Diagnostics and
  followed by the usage (a Hint, CL0001), so every line adam prints has one
  form. Exit codes: ADAM_DRIVER_EXIT_OK / ADAM_DRIVER_EXIT_ERRORS from the
  compile, ADAM_CLI_EXIT_USAGE for a command line mistake.
*******************************************************************************/

module unit Adam.Driver.CLI;

import Adam.Core.Common, Adam.Core.Messages, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics,
  Adam.Driver.Compiler;

exported const
  ADAM_ERR_CLI_001: string = "CL0001";
  ADAM_ERR_CLI_002: string = "CL0002";
  ADAM_ERR_CLI_003: string = "CL0003";
  ADAM_ERR_CLI_004: string = "CL0004";
  ADAM_ERR_CLI_005: string = "CL0005";
  ADAM_ERR_CLI_006: string = "CL0006";
  ADAM_ERR_CLI_007: string = "CL0007";   // an option with no value after it
  ADAM_ERR_CLI_008: string = "CL0008";   // an option given twice

  // The commands, as the user types them
  ADAM_CLI_BUILD: string = "build";
  ADAM_CLI_CHECK: string = "check";
  ADAM_CLI_HELP: string = "help";

  // build's output folder option
  ADAM_CLI_OUTPUT: string = "-o";

  // The program's own name, what an option outside any command belongs to
  ADAM_CLI_PROGRAM: string = "adam";

  // The exit code of a command line mistake (no compile ran)
  ADAM_CLI_EXIT_USAGE: int32 = 2;

// True when AArg asks for the help: help, -h or --help
routine DoIsHelp(const AArg: string): bool;
begin
  return (AArg = ADAM_CLI_HELP) or (AArg = "-h") or (AArg = "--help");
end;

// True when AArg is written as an option: it starts with '-'
routine DoIsOption(const AArg: string): bool;
begin
  if len(AArg) = 0 then
    return false;
  end;
  return AArg[0] = '-';
end;

// Prints the banner: adam's name and version
routine DoBanner();
begin
  println("{}", NoArgs().Str(ADAM_VERSION_STR).Fill(ADAM_MSG_CLI_BANNER));
end;

// Reports the usage into AReports: a Hint with no place (CL0001)
routine DoUsage(const AReports: ref Diagnostics);
begin
  AReports.Add(Severity.Hint, ADAM_ERR_CLI_001, NoPlace(), ADAM_MSG_CLI_USAGE, NoArgs());
end;

// Reports one command line mistake into ACompiler's reports (an Error with no place: ACode,
// ATemplate filled with AArgs), the usage after it, prints them: ADAM_CLI_EXIT_USAGE
routine DoMistake(const ACompiler: ref Compiler; const ACode: string; const ATemplate: string;
  const AArgs: MessageArgs): int32;
begin
  ACompiler.Reports.Add(Severity.Error, ACode, NoPlace(), ATemplate, AArgs);
  DoUsage(ACompiler.Reports);
  ACompiler.PrintReports();
  return ADAM_CLI_EXIT_USAGE;
end;

// The help: the banner, then the usage: ADAM_DRIVER_EXIT_OK
routine DoHelp(const ACompiler: ref Compiler): int32;
begin
  DoBanner();
  DoUsage(ACompiler.Reports);
  ACompiler.PrintReports();
  return ADAM_DRIVER_EXIT_OK;
end;

// The arguments after the command ACommand: exactly one file into AFile and, when
// ATakesOutput, at most one -o and the folder after it into AOutput. A mistake is reported
// and printed (DoMistake), its exit code put into AExit, and false returned
routine DoReadArgs(const ACompiler: ref Compiler; const ACommand: string;
  const ATakesOutput: bool; var AFile: string; var AOutput: string; var AExit: int32): bool;
var
  LIndex: int32;
  LArg: string;
  LOutputSeen: bool;
begin
  AFile := "";
  AOutput := "";
  LOutputSeen := false;
  LIndex := 2;
  while LIndex <= paramcount() do
    LArg := paramstr(LIndex);
    if ATakesOutput and (LArg = ADAM_CLI_OUTPUT) then
      // -o takes the next argument, whatever it is, as its folder
      if LIndex = paramcount() then
        AExit := DoMistake(ACompiler, ADAM_ERR_CLI_007, ADAM_MSG_CLI_NO_VALUE,
          NoArgs().Str(LArg));
        return false;
      end;
      if LOutputSeen then
        AExit := DoMistake(ACompiler, ADAM_ERR_CLI_008, ADAM_MSG_CLI_OPTION_TWICE,
          NoArgs().Str(LArg).Str(paramstr(LIndex + 1)).Str(AOutput));
        return false;
      end;
      LOutputSeen := true;
      AOutput := paramstr(LIndex + 1);
      LIndex := LIndex + 2;
    else
      if DoIsOption(LArg) then
        AExit := DoMistake(ACompiler, ADAM_ERR_CLI_005, ADAM_MSG_CLI_UNKNOWN_OPTION,
          NoArgs().Str(LArg).Str(ACommand));
        return false;
      end;
      if AFile <> "" then
        AExit := DoMistake(ACompiler, ADAM_ERR_CLI_004, ADAM_MSG_CLI_EXTRA_FILE,
          NoArgs().Str(ACommand).Str(LArg).Str(AFile));
        return false;
      end;
      AFile := LArg;
      LIndex := LIndex + 1;
    end;
  end;
  if AFile = "" then
    AExit := DoMistake(ACompiler, ADAM_ERR_CLI_003, ADAM_MSG_CLI_NO_FILE,
      NoArgs().Str(ACommand).Str(ACommand));
    return false;
  end;
  return true;
end;

// `adam check <file>`: the front end runs on the file and its reports are printed: the
// compile's exit code
routine DoCheck(const ACompiler: ref Compiler): int32;
var
  LFile: string;
  LOutput: string;
  LExit: int32;
begin
  LExit := ADAM_CLI_EXIT_USAGE;
  if not DoReadArgs(ACompiler, ADAM_CLI_CHECK, false, LFile, LOutput, LExit) then
    return LExit;
  end;
  ACompiler.Check(LFile);
  ACompiler.PrintReports();
  return ACompiler.ExitCode();
end;

// `adam build <file> [-o <dir>]`: the file built (Adam.Driver.Compiler.Build) and its
// reports printed: the compile's exit code
routine DoBuild(const ACompiler: ref Compiler): int32;
var
  LFile: string;
  LOutput: string;
  LExit: int32;
begin
  LExit := ADAM_CLI_EXIT_USAGE;
  if not DoReadArgs(ACompiler, ADAM_CLI_BUILD, true, LFile, LOutput, LExit) then
    return LExit;
  end;
  ACompiler.Build(LFile, LOutput);
  ACompiler.PrintReports();
  return ACompiler.ExitCode();
end;

// Runs adam's command line (see the header): the exit code for the process
exported routine RunCommandLine(): int32;
var
  LCompiler: ref Compiler;
  LCommand: string;
begin
  LCompiler := ref Compiler();
  if paramcount() < 1 then
    return DoHelp(LCompiler);
  end;
  LCommand := paramstr(1);
  if DoIsHelp(LCommand) then
    if paramcount() > 1 then
      return DoMistake(LCompiler, ADAM_ERR_CLI_006, ADAM_MSG_CLI_HELP_EXTRA,
        NoArgs().Str(LCommand).Str(paramstr(2)));
    end;
    return DoHelp(LCompiler);
  end;
  if LCommand = ADAM_CLI_BUILD then
    return DoBuild(LCompiler);
  end;
  if LCommand = ADAM_CLI_CHECK then
    return DoCheck(LCompiler);
  end;
  if DoIsOption(LCommand) then
    return DoMistake(LCompiler, ADAM_ERR_CLI_005, ADAM_MSG_CLI_UNKNOWN_OPTION,
      NoArgs().Str(LCommand).Str(ADAM_CLI_PROGRAM));
  end;
  return DoMistake(LCompiler, ADAM_ERR_CLI_002, ADAM_MSG_CLI_UNKNOWN_COMMAND,
    NoArgs().Str(LCommand));
end;

end.
