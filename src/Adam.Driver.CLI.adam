  Mozilla Public License, v. 2.0. If a copy of the MPL
  was not distributed with this file, You can obtain one
  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  Adam.Driver.CLI.adam - adam's command line

  RunCommandLine reads argv through the paramcount / paramstr intrinsics and
  drives one Adam.Driver.Compiler. Everything the command line knows is in
  two tables, and both the reader and the help read only them:

    DoCommandTable   every command: its word, its one positional argument
                     (a file; a file or a project folder; a help topic) as
                     the help writes it, its summary, its examples
    DoOptionTable    every option: its short and long forms, the value it
                     takes ("" = a flag), its summary, the commands it
                     belongs to (none listed = every command); DoApply is
                     its handler, by its CliOption

  build's argument is a main module's file, or a project folder whose
  project.toml names the main module (none given: the current folder),
  never one searched for above it, as PaskalCPP's build [<folder>]: no
  project.toml there is CL0013 (exit 2), one that does not load its PJ
  reports (exit 1). check takes a file only. init takes two arguments, the
  new project's name and its type (PaskalCPP's init <name> <exe|dll|lib>):
  one missing is CL0015, a type that is not exe, dll or lib CL0016 (both
  exit 2); Adam.Driver.Project's Scaffold makes the project in the working
  folder (its PJ reports, exit 1) and two status lines say where and how to
  build it (not under --quiet). pack takes a project folder as build does
  (PaskalCPP's pack [<folder>], built into adam: no packer program): the
  project's assets folder zipped by System.CustomIO's ZipDirectoryContents
  into <name>.rez in its output folder (one archive for every target and
  mode), with its pack password; every project build copies it beside the
  exe it writes, and pack updates each copy an earlier build left; no
  assets folder is CL0017, the archive's folder, the archive itself or a
  copy CL0018 / CL0019 / CL0021 (exit 1); each entry, the count, the
  archive and each updated copy are printed (not under --quiet).

  A new command or option is one more table entry (and its handler): the
  reader, the help's rows and columns and the mistakes follow from it. The
  targets are Adam.Target.Registry's: -t (a name or a triple) is checked
  against it, and the help of adam and of every command that takes -t lists
  what it holds (the default marked), so a target added there reaches the
  command line by itself; no target is named in any text here.

  The line: options anywhere, a value-taking option takes the next argument
  whatever it is; the first other argument is the command, the next its
  positional argument. No command: adam's help. -h / --help: the help of the
  command given, else adam's. The banner (adam's name and version, its
  copyright and its link, all Adam.Core.Common's identity) comes first unless
  --no-banner is given. In the help, a command's argument and an option's
  value are placeholders: each list's names in a column of their own, the
  placeholders lined up after it. A '--' ends adam's own arguments: every one
  after it is the program's, for build -r, which runs the exe it wrote in
  the folder it landed in, on adam's own console (System.Windows'
  RunAttached), adam's exit code then the program's.

  On a console that takes VT sequences (System.Console's EscapesEnabled)
  the banner, the help (HelpOut) and every report's severity word
  (Diagnostics.SetColor) are in color; piped or redirected, every line is
  plain text, byte for byte what the rows compare.

  A build never looks hung (CliPhases): on such a console the running
  phase's line is drawn in place and redrawn as each step starts (the unit
  and its step: `Lowering 12/68 Adam.Opt.Gvn: optimize ... 23s`) and each
  second by a ticker task, then overwritten by the phase's final line;
  piped, redirected or under --quiet only the final lines print.

  A command line mistake is one Error with no place (CL codes, texts in
  Adam.Core.Messages) ending in the help to see, reported into the compile's
  own Diagnostics, so every line adam prints has one form. Exit codes:
  ADAM_DRIVER_EXIT_OK / ADAM_DRIVER_EXIT_ERRORS from the compile (the help
  is ADAM_DRIVER_EXIT_OK), ADAM_CLI_EXIT_USAGE for a mistake. CL0001 (the
  old one-line usage) is retired: its number is not reused.
*******************************************************************************/

module unit Adam.Driver.CLI;

import System.SysUtils, System.Windows, System.Runtime, System.CustomIO, System.Console,
  Adam.Core.Common,
  Adam.Core.Messages, Adam.Target, Adam.Target.Registry, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics, Adam.Acu.Format, Adam.Driver.Project, Adam.Driver.Compiler;

public const
  ADAM_ERR_CLI_002: string = "CL0002";   // not a command
  ADAM_ERR_CLI_003: string = "CL0003";   // a command with no file
  ADAM_ERR_CLI_004: string = "CL0004";   // one positional argument too many
  ADAM_ERR_CLI_005: string = "CL0005";   // not an option (of the command given)
  ADAM_ERR_CLI_006: string = "CL0006";   // help of what is not a command
  ADAM_ERR_CLI_007: string = "CL0007";   // an option with no value after it
  ADAM_ERR_CLI_008: string = "CL0008";   // an option given twice
  ADAM_ERR_CLI_009: string = "CL0009";   // -t names no target the registry has
  ADAM_ERR_CLI_010: string = "CL0010";   // '--' (the program's arguments) without -r
  ADAM_ERR_CLI_011: string = "CL0011";   // -r: the exe could not be started
  ADAM_ERR_CLI_012: string = "CL0012";   // -r: the exe's target does not run on this machine
  ADAM_ERR_CLI_013: string = "CL0013";   // build <folder>: no project.toml in that folder
  ADAM_ERR_CLI_014: string = "CL0014";   // build <folder>: the folder cannot be resolved
  ADAM_ERR_CLI_015: string = "CL0015";   // init: the name or the type is missing
  ADAM_ERR_CLI_016: string = "CL0016";   // init: the type is not exe, dll or lib
  ADAM_ERR_CLI_017: string = "CL0017";   // pack: the project has no assets folder
  ADAM_ERR_CLI_018: string = "CL0018";   // pack: the archive's folder cannot be made
  ADAM_ERR_CLI_019: string = "CL0019";   // pack: the archive cannot be written
  ADAM_ERR_CLI_020: string = "CL0020";   // -opt names no optimization level
  ADAM_ERR_CLI_021: string = "CL0021";   // pack: a copy beside a built exe cannot be updated

  // The commands, as the user types them
  ADAM_CLI_BUILD: string = "build";
  ADAM_CLI_CHECK: string = "check";
  ADAM_CLI_INIT: string = "init";
  ADAM_CLI_PACK: string = "pack";
  ADAM_CLI_HELP: string = "help";

  // The options, as the user types them
  ADAM_CLI_OUTPUT_SHORT: string = "-o";
  ADAM_CLI_OUTPUT_LONG: string = "--output";
  ADAM_CLI_TARGET_SHORT: string = "-t";
  ADAM_CLI_TARGET_LONG: string = "--target";
  ADAM_CLI_OPTIMIZE_SHORT: string = "-opt";
  ADAM_CLI_OPTIMIZE_LONG: string = "--optimize";
  ADAM_CLI_NO_BANNER_LONG: string = "--no-banner";
  ADAM_CLI_QUIET_SHORT: string = "-q";
  ADAM_CLI_QUIET_LONG: string = "--quiet";
  ADAM_CLI_HEAP_LONG: string = "--heap";
  ADAM_CLI_EMIT_IR_LONG: string = "--emit-ir";
  // The compiler's own build (build-adam passes it on every stage): never public, in no
  // option table and no help; the build is a release one at safe unless -opt names another
  // level (no leak tracker, site stores or site table), its other self-build paths to come
  ADAM_CLI_SELF_BUILD_LONG: string = "--adam-self-build";
  ADAM_CLI_HELP_SHORT: string = "-h";
  ADAM_CLI_HELP_LONG: string = "--help";
  ADAM_CLI_RUN_SHORT: string = "-r";
  ADAM_CLI_RUN_LONG: string = "--run";

  // What ends adam's own arguments: every one after it is the program's (-r)
  ADAM_CLI_ARGS_SEPARATOR: string = "--";

  // The program's own name, what an option outside any command belongs to
  ADAM_CLI_PROGRAM: string = "adam";

  // The help's indent and the gap between its two columns
  ADAM_CLI_INDENT: string = "  ";
  ADAM_CLI_GAP: string = "  ";

  // The exit code of a command line mistake (no compile ran)
  ADAM_CLI_EXIT_USAGE: int32 = 2;

type
  // adam's commands
  CliCommand = choices(Build, Check, Init, Pack, Help);

  // What a command's positional arguments are: a main module's file (required), a main
  // module's file or a project folder (none: the current folder), a help topic, a new
  // project's name and type (two, both required), a project folder (none: the current
  // folder)
  CliPositional = choices(File, Project, Topic, NewProject, Folder);

  // adam's options, each one's handler picked by it (DoApply)
  CliOption = choices(Output, Target, Optimize, Run, EmitIr, NoBanner, Quiet, Heap, Help);

  // The commands an option belongs to
  CliCommandArray = array of CliCommand;

  // One command, as the reader and the help see it
  CommandSpec = record
    Id: CliCommand;
    Word: string;
    Positional: CliPositional;
    Argument: string;
    Summary: string;
    Examples: StringArray;
  end;

  // Every command, in the order the help lists them
  CommandTable = array of CommandSpec;

  // One option, as the reader and the help see it
  OptionSpec = record
    Id: CliOption;
    Short: string;
    Long: string;
    Value: string;
    Summary: string;
    Commands: CliCommandArray;
  end;

  // Every option, in the order the help lists them
  OptionTable = array of OptionSpec;

  // One command line, as read: Command an index into the command table (-1 = none given);
  // TargetText what -t gave as typed, TargetTriple the triple of the registry's target it
  // names; LevelText what -opt gave as typed, Level the level it names when LevelGiven; Run
  // -r given, RunArgs the arguments after '--' (the program's own); TypeText init's second
  // argument (the project type as typed), "" for every other command
  CliRequest = record
    Command: int64;
    Positional: string;
    TypeText: string;
    Output: string;
    TargetText: string;
    TargetTriple: string;
    LevelText: string;
    Level: OptLevel;
    LevelGiven: bool;
    Run: bool;
    RunArgs: StringArray;
    // --emit-ir was given: the build writes <stem>.ir beside its exe
    EmitIr: bool;
    NoBanner: bool;
    Quiet: bool;
    Heap: bool;
    WantHelp: bool;
    // --adam-self-build was given (ADAM_CLI_SELF_BUILD_LONG)
    SelfBuild: bool;
  end;

  // What adam pack's progress routine (DoPackEntry) keeps: whether it prints each entry
  // (not under --quiet) and how many entries were written
  PackState = record
    Quiet: bool;
    Entries: int64;
  end;

// Adds AText at the end of AList
routine DoAddString(var AList: StringArray; const AText: string);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := AText;
end;

// Adds ACommand at the end of AList
routine DoAddCommandId(var AList: CliCommandArray; const ACommand: CliCommand);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := ACommand;
end;

// A command with no examples yet
routine DoCommand(const AId: CliCommand; const AWord: string; const APositional: CliPositional;
  const AArgument: string; const ASummary: string): CommandSpec;
var
  LSpec: CommandSpec;
begin
  LSpec.Id := AId;
  LSpec.Word := AWord;
  LSpec.Positional := APositional;
  LSpec.Argument := AArgument;
  LSpec.Summary := ASummary;
  setlength(LSpec.Examples, 0);
  return LSpec;
end;

// Adds ASpec at the end of ATable
routine DoAddCommand(var ATable: CommandTable; const ASpec: CommandSpec);
var
  LCount: int64;
begin
  LCount := len(ATable);
  setlength(ATable, LCount + 1);
  ATable[LCount] := ASpec;
end;

// Every command (see the header)
routine DoCommandTable(): CommandTable;
var
  LTable: CommandTable;
  LSpec: CommandSpec;
begin
  setlength(LTable, 0);

  LSpec := DoCommand(CliCommand.Build, ADAM_CLI_BUILD, CliPositional.Project,
    ADAM_MSG_CLI_ARG_PROJECT, ADAM_MSG_CLI_HELP_BUILD);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_BUILD);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_BUILD_OUTPUT);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_BUILD_PROJECT);
  DoAddCommand(LTable, LSpec);

  LSpec := DoCommand(CliCommand.Check, ADAM_CLI_CHECK, CliPositional.File, ADAM_MSG_CLI_ARG_FILE,
    ADAM_MSG_CLI_HELP_CHECK);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_CHECK);
  DoAddCommand(LTable, LSpec);

  LSpec := DoCommand(CliCommand.Init, ADAM_CLI_INIT, CliPositional.NewProject,
    ADAM_MSG_CLI_ARG_NEW_PROJECT, ADAM_MSG_CLI_HELP_INIT);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_INIT);
  DoAddCommand(LTable, LSpec);

  LSpec := DoCommand(CliCommand.Pack, ADAM_CLI_PACK, CliPositional.Folder, ADAM_MSG_CLI_ARG_FOLDER,
    ADAM_MSG_CLI_HELP_PACK);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_PACK);
  DoAddCommand(LTable, LSpec);

  LSpec := DoCommand(CliCommand.Help, ADAM_CLI_HELP, CliPositional.Topic, ADAM_MSG_CLI_ARG_COMMAND,
    ADAM_MSG_CLI_HELP_HELP);
  DoAddString(LSpec.Examples, ADAM_MSG_CLI_EXAMPLE_HELP);
  DoAddCommand(LTable, LSpec);

  return LTable;
end;

// An option that belongs to every command until commands are added to it
routine DoOption(const AId: CliOption; const AShort: string; const ALong: string;
  const AValue: string; const ASummary: string): OptionSpec;
var
  LSpec: OptionSpec;
begin
  LSpec.Id := AId;
  LSpec.Short := AShort;
  LSpec.Long := ALong;
  LSpec.Value := AValue;
  LSpec.Summary := ASummary;
  setlength(LSpec.Commands, 0);
  return LSpec;
end;

// Adds ASpec at the end of ATable
routine DoAddOption(var ATable: OptionTable; const ASpec: OptionSpec);
var
  LCount: int64;
begin
  LCount := len(ATable);
  setlength(ATable, LCount + 1);
  ATable[LCount] := ASpec;
end;

// Every option (see the header)
routine DoOptionTable(): OptionTable;
var
  LTable: OptionTable;
  LSpec: OptionSpec;
begin
  setlength(LTable, 0);

  LSpec := DoOption(CliOption.Output, ADAM_CLI_OUTPUT_SHORT, ADAM_CLI_OUTPUT_LONG,
    ADAM_MSG_CLI_ARG_DIR, ADAM_MSG_CLI_HELP_OUTPUT);
  DoAddCommandId(LSpec.Commands, CliCommand.Build);
  DoAddOption(LTable, LSpec);

  LSpec := DoOption(CliOption.Target, ADAM_CLI_TARGET_SHORT, ADAM_CLI_TARGET_LONG,
    ADAM_MSG_CLI_ARG_TARGET, ADAM_MSG_CLI_HELP_TARGET);
  DoAddCommandId(LSpec.Commands, CliCommand.Build);
  DoAddCommandId(LSpec.Commands, CliCommand.Check);
  DoAddOption(LTable, LSpec);

  LSpec := DoOption(CliOption.Optimize, ADAM_CLI_OPTIMIZE_SHORT, ADAM_CLI_OPTIMIZE_LONG,
    ADAM_MSG_CLI_ARG_LEVEL, ADAM_MSG_CLI_HELP_OPTIMIZE);
  DoAddCommandId(LSpec.Commands, CliCommand.Build);
  DoAddCommandId(LSpec.Commands, CliCommand.Check);
  DoAddOption(LTable, LSpec);

  LSpec := DoOption(CliOption.Run, ADAM_CLI_RUN_SHORT, ADAM_CLI_RUN_LONG, "",
    ADAM_MSG_CLI_HELP_RUN);
  DoAddCommandId(LSpec.Commands, CliCommand.Build);
  DoAddOption(LTable, LSpec);

  LSpec := DoOption(CliOption.EmitIr, "", ADAM_CLI_EMIT_IR_LONG, "", ADAM_MSG_CLI_HELP_EMIT_IR);
  DoAddCommandId(LSpec.Commands, CliCommand.Build);
  DoAddOption(LTable, LSpec);

  DoAddOption(LTable, DoOption(CliOption.NoBanner, "", ADAM_CLI_NO_BANNER_LONG, "",
    ADAM_MSG_CLI_HELP_NO_BANNER));

  DoAddOption(LTable, DoOption(CliOption.Quiet, ADAM_CLI_QUIET_SHORT, ADAM_CLI_QUIET_LONG, "",
    ADAM_MSG_CLI_HELP_QUIET));

  // --heap only in a debug adam: a release build tracks no heap (debug-only machinery), so it
  // has no report to print and neither shows nor takes the option
@ifdef DEBUG
  DoAddOption(LTable, DoOption(CliOption.Heap, "", ADAM_CLI_HEAP_LONG, "", ADAM_MSG_CLI_HELP_HEAP));
@endif

  DoAddOption(LTable, DoOption(CliOption.Help, ADAM_CLI_HELP_SHORT, ADAM_CLI_HELP_LONG, "",
    ADAM_MSG_CLI_HELP_HELP_OPTION));

  return LTable;
end;

// The index of the command whose word is AWord in ATable; -1 when there is none
routine DoFindCommand(const ATable: CommandTable; const AWord: string): int64;
var
  LI: int64;
begin
  for LI := 0 to len(ATable) - 1 do
    if ATable[LI].Word = AWord then
      return LI;
    end;
  end;
  return -1;
end;

// The index of the option written AArg (its short or its long form) in ATable; -1 when there
// is none
routine DoFindOption(const ATable: OptionTable; const AArg: string): int64;
var
  LI: int64;
begin
  for LI := 0 to len(ATable) - 1 do
    if (ATable[LI].Long = AArg) or ((ATable[LI].Short <> "") and (ATable[LI].Short = AArg)) then
      return LI;
    end;
  end;
  return -1;
end;

// True when AArg is written as an option: it starts with '-'
routine DoIsOption(const AArg: string): bool;
begin
  if len(AArg) = 0 then
    return false;
  end;
  return AArg[0] = '-';
end;

// True when AOption belongs to ACommand (an option that lists no command belongs to every one)
routine DoBelongs(const AOption: OptionSpec; const ACommand: CliCommand): bool;
var
  LI: int64;
begin
  if len(AOption.Commands) = 0 then
    return true;
  end;
  for LI := 0 to len(AOption.Commands) - 1 do
    if AOption.Commands[LI] = ACommand then
      return true;
    end;
  end;
  return false;
end;

// True when AOption belongs to every command
routine DoBelongsToAll(const AOption: OptionSpec): bool;
begin
  return len(AOption.Commands) = 0;
end;

// The index in argv of the first '--' (what ends adam's own arguments); 0 when the line has
// none
routine DoSeparatorAt(): int32;
var
  LIndex: int32;
begin
  for LIndex := 1 to paramcount() do
    if paramstr(LIndex) = ADAM_CLI_ARGS_SEPARATOR then
      return LIndex;
    end;
  end;
  return 0;
end;

// The last index in argv adam reads as its own: the one before '--', else the last
routine DoLastArg(): int32;
var
  LSeparator: int32;
begin
  LSeparator := DoSeparatorAt();
  if LSeparator > 0 then
    return LSeparator - 1;
  end;
  return paramcount();
end;

// The index in argv of the command: the first argument that is neither an option nor a
// value-taking option's value. 0 when the line has none
routine DoCommandAt(const AOptions: OptionTable): int32;
var
  LIndex: int32;
  LArg: string;
  LOption: int64;
begin
  LIndex := 1;
  while LIndex <= DoLastArg() do
    LArg := paramstr(LIndex);
    if not DoIsOption(LArg) then
      return LIndex;
    end;
    LOption := DoFindOption(AOptions, LArg);
    if (LOption >= 0) and (AOptions[LOption].Value <> "") then
      LIndex := LIndex + 2;
    else
      LIndex := LIndex + 1;
    end;
  end;
  return 0;
end;

// True when the line gives --no-banner or --quiet as an option (never as another option's
// value), read before the line is checked so the banner leads even a mistake's line
routine DoWantsNoBanner(const AOptions: OptionTable): bool;
var
  LIndex: int32;
  LOption: int64;
begin
  LIndex := 1;
  while LIndex <= DoLastArg() do
    LOption := DoFindOption(AOptions, paramstr(LIndex));
    if LOption < 0 then
      LIndex := LIndex + 1;
    else
      // --quiet prints no banner either
      if (AOptions[LOption].Id = CliOption.NoBanner) or (AOptions[LOption].Id = CliOption.Quiet) then
        return true;
      end;
      if AOptions[LOption].Value <> "" then
        LIndex := LIndex + 2;
      else
        LIndex := LIndex + 1;
      end;
    end;
  end;
  return false;
end;

// The help a mistake points to: `adam help <command>` for the command at ACommand in ACommands,
// `adam help` when ACommand is -1
routine DoSee(const ACommands: CommandTable; const ACommand: int64): string;
begin
  if ACommand < 0 then
    return ADAM_MSG_CLI_SEE_ANY;
  end;
  return NoArgs().Str(ACommands[ACommand].Word).Fill(ADAM_MSG_CLI_SEE);
end;

// Reports one command line mistake into AReports: an Error with no place, ACode, ATemplate
// filled with AArgs
routine DoReport(const AReports: ref Diagnostics; const ACode: string; const ATemplate: string;
  const AArgs: MessageArgs);
begin
  AReports.Add(Severity.Error, ACode, NoPlace(), ATemplate, AArgs);
end;

// DoReport, then false: what a reader returns on a mistake
routine DoMistake(const AReports: ref Diagnostics; const ACode: string; const ATemplate: string;
  const AArgs: MessageArgs): bool;
begin
  DoReport(AReports, ACode, ATemplate, AArgs);
  return false;
end;

// Every target the registry has, as a mistake lists them: name (triple), comma separated
routine DoTargetList(): string;
var
  LTargets: TargetList;
  LItems: StringArray;
  LI: int64;
begin
  LTargets := AllTargets();
  setlength(LItems, 0);
  for LI := 0 to len(LTargets) - 1 do
    DoAddString(LItems, NoArgs().Str(LTargets[LI].TargetName()).Str(LTargets[LI].Triple())
      .Fill(ADAM_MSG_CLI_TARGET_ITEM));
  end;
  return JoinStrings(LItems, ", ");
end;

// The target -t gave (ARequest.TargetText, a name or a triple) checked against the registry,
// its triple put into ARequest.TargetTriple; nothing given: nothing to check. ASee names the
// help in a mistake. A target the registry lacks: reported (CL0009), false
routine DoReadTarget(const AReports: ref Diagnostics; var ARequest: CliRequest;
  const ASee: string): bool;
var
  LTarget: ref Target;
begin
  if ARequest.TargetText = "" then
    return true;
  end;
  LTarget := FindTargetNamed(ARequest.TargetText);
  if LTarget = nil then
    return DoMistake(AReports, ADAM_ERR_CLI_009, ADAM_MSG_CLI_BAD_TARGET,
      NoArgs().Str(ARequest.TargetText).Str(DoTargetList()).Str(ASee));
  end;
  ARequest.TargetTriple := LTarget.Triple();
  return true;
end;

// The level -opt gave (ARequest.LevelText, exact case) into ARequest.Level and LevelGiven;
// nothing given: nothing to check. ASee names the help in a mistake. No level's name:
// reported (CL0020, a retired spelling naming its new one), false
routine DoReadLevel(const AReports: ref Diagnostics; var ARequest: CliRequest;
  const ASee: string): bool;
var
  LLevel: OptLevel;
begin
  if ARequest.LevelText = "" then
    return true;
  end;
  LLevel := OptLevel.Debug;
  if OptLevelOfName(ARequest.LevelText, LLevel) then
    ARequest.Level := LLevel;
    ARequest.LevelGiven := true;
    return true;
  end;
  if OptLevelOfRetiredName(ARequest.LevelText, LLevel) then
    return DoMistake(AReports, ADAM_ERR_CLI_020, ADAM_MSG_CLI_RETIRED_LEVEL,
      NoArgs().Str(ARequest.LevelText).Str(OptLevelName(LLevel)).Str(ASee));
  end;
  return DoMistake(AReports, ADAM_ERR_CLI_020, ADAM_MSG_CLI_BAD_LEVEL,
    NoArgs().Str(ARequest.LevelText).Str(OptLevelNames()).Str(ASee));
end;

// Option AId's handler: AValue (the argument after a value-taking option, else "") put into
// ARequest
routine DoApply(var ARequest: CliRequest; const AId: CliOption; const AValue: string);
begin
  if AId = CliOption.Output then
    ARequest.Output := AValue;
  end;
  if AId = CliOption.Target then
    ARequest.TargetText := AValue;
  end;
  if AId = CliOption.Optimize then
    ARequest.LevelText := AValue;
  end;
  if AId = CliOption.Run then
    ARequest.Run := true;
  end;
  if AId = CliOption.EmitIr then
    ARequest.EmitIr := true;
  end;
  if AId = CliOption.NoBanner then
    ARequest.NoBanner := true;
  end;
  if AId = CliOption.Quiet then
    ARequest.Quiet := true;
  end;
  if AId = CliOption.Heap then
    ARequest.Heap := true;
  end;
  if AId = CliOption.Help then
    ARequest.WantHelp := true;
  end;
end;

// Reads the option at AIndex (written as an option) into ARequest and moves AIndex past it
// (and its value). ACommandWord / ASee name the command given (else adam) and its help in a
// mistake; ASeen holds the options already given. A mistake: reported, false
routine DoReadOption(const ACommands: CommandTable; const AOptions: OptionTable;
  const AReports: ref Diagnostics; var ARequest: CliRequest; const ACommandWord: string;
  const ASee: string; var ASeen: BoolArray; var AIndex: int32): bool;
var
  LArg: string;
  LOption: int64;
  LBelongs: bool;
  LValue: string;
begin
  LArg := paramstr(AIndex);
  LOption := DoFindOption(AOptions, LArg);
  LBelongs := false;
  if LOption >= 0 then
    if ARequest.Command >= 0 then
      LBelongs := DoBelongs(AOptions[LOption], ACommands[ARequest.Command].Id);
    else
      LBelongs := DoBelongsToAll(AOptions[LOption]);
    end;
  end;
  if not LBelongs then
    return DoMistake(AReports, ADAM_ERR_CLI_005, ADAM_MSG_CLI_UNKNOWN_OPTION,
      NoArgs().Str(LArg).Str(ACommandWord).Str(ASee));
  end;
  if ASeen[LOption] then
    return DoMistake(AReports, ADAM_ERR_CLI_008, ADAM_MSG_CLI_OPTION_TWICE,
      NoArgs().Str(LArg).Str(ASee));
  end;
  ASeen[LOption] := true;
  LValue := "";
  if AOptions[LOption].Value <> "" then
    // A value-taking option takes the next argument, whatever it is (never '--')
    if AIndex = DoLastArg() then
      return DoMistake(AReports, ADAM_ERR_CLI_007, ADAM_MSG_CLI_NO_VALUE,
        NoArgs().Str(LArg).Str(AOptions[LOption].Value).Str(ASee));
    end;
    LValue := paramstr(AIndex + 1);
    AIndex := AIndex + 2;
  else
    AIndex := AIndex + 1;
  end;
  DoApply(ARequest, AOptions[LOption].Id, LValue);
  return true;
end;

// The arguments after '--' into ARequest.RunArgs, as given: they are the program's (-r), so
// '--' without -r is a mistake (CL0010, ASee the help to see). A mistake: reported, false
routine DoReadRunArgs(const AReports: ref Diagnostics; var ARequest: CliRequest;
  const ASee: string): bool;
var
  LSeparator: int32;
  LIndex: int32;
begin
  LSeparator := DoSeparatorAt();
  if LSeparator = 0 then
    return true;
  end;
  if not ARequest.Run then
    return DoMistake(AReports, ADAM_ERR_CLI_010, ADAM_MSG_CLI_ARGS_WITHOUT_RUN,
      NoArgs().Str(ASee));
  end;
  for LIndex := LSeparator + 1 to paramcount() do
    DoAddString(ARequest.RunArgs, paramstr(LIndex));
  end;
  return true;
end;

// True when the command ARequest names takes two positional arguments (init)
routine DoTakesTwo(const ACommands: CommandTable; const ARequest: CliRequest): bool;
begin
  if ARequest.Command < 0 then
    return false;
  end;
  return ACommands[ARequest.Command].Positional = CliPositional.NewProject;
end;

// Takes AArg as the command's next positional argument: the first is Positional, init's
// second its TypeText. One more than the command takes: CL0004, reported, false
routine DoAddPositional(const ACommands: CommandTable; const AReports: ref Diagnostics;
  var ARequest: CliRequest; const ACommandWord: string; const ASee: string;
  const AArg: string): bool;
begin
  if ARequest.Positional = "" then
    ARequest.Positional := AArg;
    return true;
  end;
  if not DoTakesTwo(ACommands, ARequest) then
    return DoMistake(AReports, ADAM_ERR_CLI_004, ADAM_MSG_CLI_EXTRA_ARG,
      NoArgs().Str(ACommandWord).Str(AArg).Str(ARequest.Positional).Str(ASee));
  end;
  if ARequest.TypeText = "" then
    ARequest.TypeText := AArg;
    return true;
  end;
  return DoMistake(AReports, ADAM_ERR_CLI_004, ADAM_MSG_CLI_EXTRA_ARG_TWO,
    NoArgs().Str(ACommandWord).Str(AArg).Str(ARequest.TypeText).Str(ASee));
end;

// The command's positional arguments, once all are read: a file the command needs (CL0003),
// init's name and type both given (CL0015) and the type exe, dll or lib (CL0016). A mistake:
// reported, false
routine DoCheckPositionals(const ACommands: CommandTable; const AReports: ref Diagnostics;
  const ARequest: CliRequest; const ACommandWord: string; const ASee: string): bool;
var
  LKind: ModuleKind;
begin
  if (ACommands[ARequest.Command].Positional = CliPositional.File) and
    (ARequest.Positional = "") then
    return DoMistake(AReports, ADAM_ERR_CLI_003, ADAM_MSG_CLI_NO_FILE,
      NoArgs().Str(ACommandWord).Str(ACommandWord).Str(ASee));
  end;
  if not DoTakesTwo(ACommands, ARequest) then
    return true;
  end;
  if ARequest.TypeText = "" then
    return DoMistake(AReports, ADAM_ERR_CLI_015, ADAM_MSG_CLI_INIT_ARGS,
      NoArgs().Str(ACommandWord).Str(ACommandWord).Str(ASee));
  end;
  if not ProjectKindFromText(ARequest.TypeText, LKind) then
    return DoMistake(AReports, ADAM_ERR_CLI_016, ADAM_MSG_CLI_INIT_BAD_TYPE,
      NoArgs().Str(ARequest.TypeText).Str(ASee));
  end;
  return true;
end;

// Reads the whole command line into ARequest (see the header). A mistake: reported into
// AReports, false
routine DoRead(const ACommands: CommandTable; const AOptions: OptionTable;
  const AReports: ref Diagnostics; var ARequest: CliRequest): bool;
var
  LCommandAt: int32;
  LCommandWord: string;
  LSee: string;
  LSeen: BoolArray;
  LIndex: int32;
  LArg: string;
  LI: int64;
begin
  ARequest.Command := -1;
  ARequest.Positional := "";
  ARequest.TypeText := "";
  ARequest.Output := "";
  ARequest.TargetText := "";
  ARequest.TargetTriple := "";
  ARequest.LevelText := "";
  ARequest.Level := OptLevel.Debug;
  ARequest.LevelGiven := false;
  ARequest.Run := false;
  setlength(ARequest.RunArgs, 0);
  ARequest.EmitIr := false;
  ARequest.NoBanner := false;
  ARequest.Quiet := false;
  ARequest.Heap := false;
  ARequest.WantHelp := false;
  ARequest.SelfBuild := false;

  // The command first: what every option and argument after it is checked against
  LCommandAt := DoCommandAt(AOptions);
  LCommandWord := ADAM_CLI_PROGRAM;
  if LCommandAt > 0 then
    ARequest.Command := DoFindCommand(ACommands, paramstr(LCommandAt));
    if ARequest.Command < 0 then
      return DoMistake(AReports, ADAM_ERR_CLI_002, ADAM_MSG_CLI_UNKNOWN_COMMAND,
        NoArgs().Str(paramstr(LCommandAt)));
    end;
    LCommandWord := ACommands[ARequest.Command].Word;
  end;
  LSee := DoSee(ACommands, ARequest.Command);

  setlength(LSeen, len(AOptions));
  for LI := 0 to len(LSeen) - 1 do
    LSeen[LI] := false;
  end;
  LIndex := 1;
  while LIndex <= DoLastArg() do
    LArg := paramstr(LIndex);
    if (LIndex = LCommandAt) or (LArg = ADAM_CLI_SELF_BUILD_LONG) then
      // the hidden switch is taken here, before the option table (which never shows it)
      if LArg = ADAM_CLI_SELF_BUILD_LONG then
        ARequest.SelfBuild := true;
      end;
      LIndex := LIndex + 1;
    else
      if DoIsOption(LArg) then
        if not DoReadOption(ACommands, AOptions, AReports, ARequest, LCommandWord, LSee, LSeen,
          LIndex) then
          return false;
        end;
      else
        // Every argument after the command that is no option is a positional argument
        if not DoAddPositional(ACommands, AReports, ARequest, LCommandWord, LSee, LArg) then
          return false;
        end;
        LIndex := LIndex + 1;
      end;
    end;
  end;

  if (ARequest.Command >= 0) and not ARequest.WantHelp then
    if not DoCheckPositionals(ACommands, AReports, ARequest, LCommandWord, LSee) then
      return false;
    end;
  end;
  if not DoReadRunArgs(AReports, ARequest, LSee) then
    return false;
  end;
  if not DoReadLevel(AReports, ARequest, LSee) then
    return false;
  end;
  return DoReadTarget(AReports, ARequest, LSee);
end;

// AText with blanks after it up to AWidth bytes (every help text is ASCII, so a byte is a
// column); AText itself when it is that wide already
routine DoPad(const AText: string; const AWidth: int64): string;
begin
  if len(AText) >= AWidth then
    return AText;
  end;
  return AText + StringOfChar(' ', AWidth - len(AText));
end;

// The wider of AWidth and AOther: a help column grows to its widest entry
routine DoWider(const AWidth: int64; const AOther: int64): int64;
begin
  if AOther > AWidth then
    return AOther;
  end;
  return AWidth;
end;

type
  // Where the banner and the help go: stdout, in color on a console that takes VT sequences
  // (headings bold, the left column's names and the examples cyan, placeholders green, the
  // link yellow: Adam.Core.Common's sequences), plain when piped or redirected. Every column
  // is padded before it is colored, so a colored help lines up as a plain one
  HelpOut = object
    hidden FColor: bool;

    init(const AColor: bool);
    begin
      self.FColor := AColor;
    end;

    // AText in the VT color AColor when this output takes color, else AText itself
    hidden const method DoPaint(const AText: string; const AColor: string): string;
    begin
      if not self.FColor or (AText = "") then
        return AText;
      end;
      return AColor + AText + ADAM_COLOR_RESET;
    end;

    // Prints AText as one line
    const method Line(const AText: string);
    begin
      println("{}", AText);
    end;

    // Prints a heading (a section's name, the banner) as one line
    const method Heading(const AText: string);
    begin
      self.Line(self.DoPaint(AText, ADAM_COLOR_BOLD));
    end;

    // Prints AText (a link) as one line
    const method Link(const AText: string);
    begin
      self.Line(self.DoPaint(AText, ADAM_COLOR_YELLOW));
    end;

    // APlaceholder (what the user types in its place: <file>, [options]) in its own color
    const method Placeholder(const APlaceholder: string): string;
    begin
      return self.DoPaint(APlaceholder, ADAM_COLOR_GREEN);
    end;

    // Prints one row: AName in a column ANameWidth wide and APlaceholder after it ("" = none:
    // AName alone), the two together padded to AWidth, then ARight
    const method Row(const AName: string; const ANameWidth: int64; const APlaceholder: string;
      const AWidth: int64; const ARight: string);
    begin
      if APlaceholder = "" then
        self.Line(ADAM_CLI_INDENT + self.DoPaint(DoPad(AName, AWidth), ADAM_COLOR_CYAN) +
          ADAM_CLI_GAP + ARight);
      else
        self.Line(ADAM_CLI_INDENT + self.DoPaint(DoPad(AName, ANameWidth), ADAM_COLOR_CYAN) + " " +
          self.Placeholder(DoPad(APlaceholder, AWidth - ANameWidth - 1)) + ADAM_CLI_GAP + ARight);
      end;
    end;

    // Prints one example command line, indented
    const method Example(const AText: string);
    begin
      self.Line(ADAM_CLI_INDENT + self.DoPaint(AText, ADAM_COLOR_CYAN));
    end;
  end;

// The width a row's left side takes: AName, then APlaceholder after a column ANameWidth wide
// ("" = none: AName alone)
routine DoLeftWidth(const AName: string; const ANameWidth: int64; const APlaceholder: string): int64;
begin
  if APlaceholder = "" then
    return len(AName);
  end;
  return DoWider(ANameWidth, len(AName)) + 1 + len(APlaceholder);
end;

// An option's name in the help: its short form (when it has one), then its long form
routine DoOptionFlags(const ASpec: OptionSpec): string;
begin
  if ASpec.Short <> "" then
    return ASpec.Short + ", " + ASpec.Long;
  end;
  return ASpec.Long;
end;

// The word of the command AId in ACommands
routine DoCommandWord(const ACommands: CommandTable; const AId: CliCommand): string;
var
  LI: int64;
begin
  for LI := 0 to len(ACommands) - 1 do
    if ACommands[LI].Id = AId then
      return ACommands[LI].Word;
    end;
  end;
  return "";
end;

// An option's right column in adam's own help: its summary, and the commands it belongs to
// when it does not belong to every one
routine DoOptionRightAll(const ACommands: CommandTable; const ASpec: OptionSpec): string;
var
  LWords: StringArray;
  LI: int64;
begin
  if DoBelongsToAll(ASpec) then
    return ASpec.Summary;
  end;
  setlength(LWords, 0);
  for LI := 0 to len(ASpec.Commands) - 1 do
    DoAddString(LWords, DoCommandWord(ACommands, ASpec.Commands[LI]));
  end;
  return NoArgs().Str(ASpec.Summary).Str(JoinStrings(LWords, ", ")).Fill(ADAM_MSG_CLI_ONLY_FOR);
end;

// The banner into AOut: adam's name and version, its copyright, its link (Adam.Core.Common's
// identity), a blank line after it
routine DoBanner(const AOut: ref HelpOut);
begin
  AOut.Heading(NoArgs().Str(ADAM_PRODUCT_NAME).Str(ADAM_VERSION_STR).Fill(ADAM_MSG_CLI_BANNER));
  AOut.Line(NoArgs().Str(ADAM_COPYRIGHT).Fill(ADAM_MSG_CLI_BANNER_COPYRIGHT));
  AOut.Link(ADAM_URL);
  AOut.Line("");
end;

// Prints into AOut the examples of every command in ACommands from AFirst to ALast, under
// their heading (nothing when there are none)
routine DoPrintExamples(const AOut: ref HelpOut; const ACommands: CommandTable;
  const AFirst: int64; const ALast: int64);
var
  LI: int64;
  LJ: int64;
  LAny: bool;
begin
  LAny := false;
  for LI := AFirst to ALast do
    for LJ := 0 to len(ACommands[LI].Examples) - 1 do
      if not LAny then
        AOut.Heading(ADAM_MSG_CLI_HEAD_EXAMPLES);
        LAny := true;
      end;
      AOut.Example(ACommands[LI].Examples[LJ]);
    end;
  end;
  if LAny then
    AOut.Line("");
  end;
end;

// The width of the widest target name the registry has
routine DoTargetsWidth(): int64;
var
  LTargets: TargetList;
  LWidth: int64;
  LI: int64;
begin
  LTargets := AllTargets();
  LWidth := 0;
  for LI := 0 to len(LTargets) - 1 do
    LWidth := DoWider(LWidth, len(LTargets[LI].TargetName()));
  end;
  return LWidth;
end;

// Prints into AOut every target the registry has under its heading, the name in a left
// column AWidth wide, its triple beside it (the default one marked), a blank line after
routine DoPrintTargets(const AOut: ref HelpOut; const AWidth: int64);
var
  LTargets: TargetList;
  LI: int64;
  LTriple: string;
begin
  LTargets := AllTargets();
  AOut.Heading(ADAM_MSG_CLI_HEAD_TARGETS);
  for LI := 0 to len(LTargets) - 1 do
    LTriple := LTargets[LI].Triple();
    if LTargets[LI].IsDefault() then
      LTriple := NoArgs().Str(LTriple).Fill(ADAM_MSG_CLI_TARGET_DEFAULT);
    end;
    AOut.Row(LTargets[LI].TargetName(), 0, "", AWidth, LTriple);
  end;
  AOut.Line("");
end;

// True when the command ACommand takes the option that names a target (its help then lists
// the targets)
routine DoTakesTarget(const AOptions: OptionTable; const ACommand: CliCommand): bool;
var
  LI: int64;
begin
  for LI := 0 to len(AOptions) - 1 do
    if (AOptions[LI].Id = CliOption.Target) and DoBelongs(AOptions[LI], ACommand) then
      return true;
    end;
  end;
  return false;
end;

// True when the help being printed lists AOption: adam's own help (AAll) lists every option,
// a command's help the ones that belong to ACommand
routine DoListed(const AOption: OptionSpec; const AAll: bool; const ACommand: CliCommand): bool;
begin
  return AAll or DoBelongs(AOption, ACommand);
end;

// The width of the widest command word in ACommands: the column their arguments line up after
routine DoWordWidth(const ACommands: CommandTable): int64;
var
  LWidth: int64;
  LI: int64;
begin
  LWidth := 0;
  for LI := 0 to len(ACommands) - 1 do
    LWidth := DoWider(LWidth, len(ACommands[LI].Word));
  end;
  return LWidth;
end;

// The width of the widest flags of the options listed (DoListed): the column their values
// line up after
routine DoFlagWidth(const AOptions: OptionTable; const AAll: bool; const ACommand: CliCommand): int64;
var
  LWidth: int64;
  LI: int64;
begin
  LWidth := 0;
  for LI := 0 to len(AOptions) - 1 do
    if DoListed(AOptions[LI], AAll, ACommand) then
      LWidth := DoWider(LWidth, len(DoOptionFlags(AOptions[LI])));
    end;
  end;
  return LWidth;
end;

// AWidth grown to the widest left side of the options listed (DoListed), their values after a
// flag column AFlagWidth wide
routine DoOptionsWidth(const AOptions: OptionTable; const AAll: bool; const ACommand: CliCommand;
  const AFlagWidth: int64; const AWidth: int64): int64;
var
  LWidth: int64;
  LI: int64;
begin
  LWidth := AWidth;
  for LI := 0 to len(AOptions) - 1 do
    if DoListed(AOptions[LI], AAll, ACommand) then
      LWidth := DoWider(LWidth, DoLeftWidth(DoOptionFlags(AOptions[LI]), AFlagWidth,
        AOptions[LI].Value));
    end;
  end;
  return LWidth;
end;

// adam's own help into AOut: the usage, every command, every option, every target, every
// example
routine DoHelpAll(const AOut: ref HelpOut; const ACommands: CommandTable;
  const AOptions: OptionTable);
var
  LWordWidth: int64;
  LFlagWidth: int64;
  LWidth: int64;
  LI: int64;
begin
  // Words and flags each in a column of their own, their placeholders lined up after it; one
  // left column for every list, as wide as its widest entry (CliCommand.Help: AAll ignores it)
  LWordWidth := DoWordWidth(ACommands);
  LFlagWidth := DoFlagWidth(AOptions, true, CliCommand.Help);
  LWidth := DoTargetsWidth();
  for LI := 0 to len(ACommands) - 1 do
    LWidth := DoWider(LWidth, DoLeftWidth(ACommands[LI].Word, LWordWidth, ACommands[LI].Argument));
  end;
  LWidth := DoOptionsWidth(AOptions, true, CliCommand.Help, LFlagWidth, LWidth);

  AOut.Heading(ADAM_MSG_CLI_HEAD_USAGE);
  AOut.Line(ADAM_CLI_INDENT + NoArgs().Str(AOut.Placeholder(ADAM_MSG_CLI_ARG_ANY_COMMAND))
    .Str(AOut.Placeholder(ADAM_MSG_CLI_ARG_OPTIONS)).Fill(ADAM_MSG_CLI_USAGE_ANY));
  AOut.Line("");
  AOut.Heading(ADAM_MSG_CLI_HEAD_COMMANDS);
  for LI := 0 to len(ACommands) - 1 do
    AOut.Row(ACommands[LI].Word, LWordWidth, ACommands[LI].Argument, LWidth,
      ACommands[LI].Summary);
  end;
  AOut.Line("");
  AOut.Heading(ADAM_MSG_CLI_HEAD_OPTIONS);
  for LI := 0 to len(AOptions) - 1 do
    AOut.Row(DoOptionFlags(AOptions[LI]), LFlagWidth, AOptions[LI].Value, LWidth,
      DoOptionRightAll(ACommands, AOptions[LI]));
  end;
  AOut.Line("");
  DoPrintTargets(AOut, LWidth);
  DoPrintExamples(AOut, ACommands, 0, len(ACommands) - 1);
  AOut.Line(ADAM_MSG_CLI_MORE);
end;

// The help of the command at ACommand into AOut: its usage, its summary, its options, the
// targets (when it takes -t), its examples
routine DoHelpCommand(const AOut: ref HelpOut; const ACommands: CommandTable;
  const AOptions: OptionTable; const ACommand: int64);
var
  LSpec: CommandSpec;
  LFlagWidth: int64;
  LWidth: int64;
  LI: int64;
begin
  LSpec := ACommands[ACommand];
  LWidth := 0;
  if DoTakesTarget(AOptions, LSpec.Id) then
    LWidth := DoTargetsWidth();
  end;
  LFlagWidth := DoFlagWidth(AOptions, false, LSpec.Id);
  LWidth := DoOptionsWidth(AOptions, false, LSpec.Id, LFlagWidth, LWidth);

  AOut.Heading(ADAM_MSG_CLI_HEAD_USAGE);
  if LSpec.Argument = "" then
    AOut.Line(ADAM_CLI_INDENT + NoArgs().Str(LSpec.Word)
      .Str(AOut.Placeholder(ADAM_MSG_CLI_ARG_OPTIONS)).Fill(ADAM_MSG_CLI_USAGE_COMMAND));
  else
    AOut.Line(ADAM_CLI_INDENT + NoArgs().Str(LSpec.Word).Str(AOut.Placeholder(LSpec.Argument))
      .Str(AOut.Placeholder(ADAM_MSG_CLI_ARG_OPTIONS)).Fill(ADAM_MSG_CLI_USAGE_COMMAND_ARG));
  end;
  AOut.Line("");
  AOut.Line(LSpec.Summary);
  AOut.Line("");
  AOut.Heading(ADAM_MSG_CLI_HEAD_OPTIONS);
  for LI := 0 to len(AOptions) - 1 do
    if DoBelongs(AOptions[LI], LSpec.Id) then
      AOut.Row(DoOptionFlags(AOptions[LI]), LFlagWidth, AOptions[LI].Value, LWidth,
        AOptions[LI].Summary);
    end;
  end;
  AOut.Line("");
  if DoTakesTarget(AOptions, LSpec.Id) then
    DoPrintTargets(AOut, LWidth);
  end;
  DoPrintExamples(AOut, ACommands, ACommand, ACommand);
end;

// AMilliseconds as seconds with two decimals, rounded down ("0.42", "12.05")
routine DoSeconds(const AMilliseconds: int64): string;
var
  LHundredths: int64;
  LFraction: string;
begin
  LHundredths := (AMilliseconds mod 1000) div 10;
  LFraction := IntToStr(LHundredths);
  if LHundredths < 10 then
    LFraction := "0" + LFraction;
  end;
  return IntToStr(AMilliseconds div 1000) + "." + LFraction;
end;

var
  // Set as the process ends (DoLiveQuit, an exit handler): a ticker still running stops at its
  // next wake and draws nothing more, so an exit (Halt) never waits on it
  GLiveQuit: int32;

// The exit handler CliPhases registers when it draws live: the ticker's stop at any exit
routine DoLiveQuit();
begin
  atomicstore(GLiveQuit, 1);
end;

type
  // The phase lines: one line per phase as it ends, printed into an output with the time
  // since the phase before it ended (the first: since the listener was made). On a console
  // that takes VT sequences (Live) the running phase's line is drawn in place too: its text
  // (the phase, the unit and step it is at) and its whole seconds, redrawn as each step
  // starts and each second (Tick, a ticker task's), overwritten by the final line. Every
  // write to the screen is made holding FLine, so the ticker and the compile never mix
  CliPhases = object(PhaseListener)
    hidden FOut: ref HelpOut;
    hidden FLast: int64;
    hidden FLive: bool;
    hidden FLine: mutex;
    // The running phase's live text ("" while none runs), whether a live line is on the
    // screen, and whether the compile is over (Finish: nothing is drawn after it)
    hidden FText: string;
    hidden FShown: bool;
    hidden FDone: bool;
    // Held by the compile while it runs (DoCompileLive): the ticker sleeps on it and stops
    // once it is free
    Hold: mutex;

    init(const AOut: ref HelpOut);
    begin
      self.FOut := AOut;
      self.FLast := TickCountMs();
      self.FLive := EscapesEnabled();
      self.FText := "";
      self.FShown := false;
      self.FDone := false;
      if self.FLive then
        AtExit(DoLiveQuit);
      end;
    end;

    // True when the running phase is drawn in place (a console that takes VT sequences)
    const method Live(): bool;
    begin
      return self.FLive;
    end;

    // The phase line's arguments before its seconds, filled into its template
    hidden const method DoText(const APhase: BuildPhase; const AFirst: int64;
      const ASecond: int64; const AText: string; const ASeconds: string): string;
    begin
      if APhase = BuildPhase.Parse then
        return NoArgs().Int(AFirst).Int(ASecond).Str(ASeconds).Fill(ADAM_MSG_CLI_PHASE_PARSE);
      end;
      if APhase = BuildPhase.Analyze then
        return NoArgs().Str(ASeconds).Fill(ADAM_MSG_CLI_PHASE_ANALYZE);
      end;
      if APhase = BuildPhase.Lower then
        return NoArgs().Int(AFirst).Int(ASecond).Str(ASeconds).Fill(ADAM_MSG_CLI_PHASE_LOWER);
      end;
      if APhase = BuildPhase.Generate then
        return NoArgs().Int(AFirst).Str(ASeconds).Fill(ADAM_MSG_CLI_PHASE_GENERATE);
      end;
      // BuildPhase.Link
      return NoArgs().Str(ExtractFileName(AText)).Int(AFirst).Str(ASeconds)
        .Fill(ADAM_MSG_CLI_PHASE_LINK);
    end;

    // The running phase's own word (Parsing, Analyzing ...)
    hidden const method DoLiveWord(const APhase: BuildPhase): string;
    begin
      if APhase = BuildPhase.Parse then
        return ADAM_MSG_CLI_LIVE_PARSE;
      end;
      if APhase = BuildPhase.Analyze then
        return ADAM_MSG_CLI_LIVE_ANALYZE;
      end;
      if APhase = BuildPhase.Lower then
        return ADAM_MSG_CLI_LIVE_LOWER;
      end;
      if APhase = BuildPhase.Generate then
        return ADAM_MSG_CLI_LIVE_GENERATE;
      end;
      return ADAM_MSG_CLI_LIVE_LINK;
    end;

    // A unit step's own word (lower, optimize, generate, write)
    hidden const method DoStepWord(const AStep: BuildStep): string;
    begin
      if AStep = BuildStep.Lower then
        return ADAM_MSG_CLI_STEP_LOWER;
      end;
      if AStep = BuildStep.Optimize then
        return ADAM_MSG_CLI_STEP_OPTIMIZE;
      end;
      if AStep = BuildStep.Generate then
        return ADAM_MSG_CLI_STEP_GENERATE;
      end;
      return ADAM_MSG_CLI_STEP_WRITE;
    end;

    // AText cut to the terminal's width less one column (by display columns), so the live
    // line never wraps: a wrapped line is not redrawn in place
    hidden const method DoFit(const AText: string): string;
    var
      LLimit: int64;
      LColumns: int64;
      LIndex: int64;
      LStart: int64;
    begin
      LLimit := int64(GetTerminalWidth()) - 1;
      if DisplayWidth(AText) <= LLimit then
        return AText;
      end;
      LColumns := 0;
      LIndex := 0;
      while LIndex < len(AText) do
        LStart := LIndex;
        DecodeUtf8Char(AText, LIndex);
        LColumns := LColumns + DisplayWidth(Substring(AText, LStart, LIndex - LStart));
        if LColumns > LLimit then
          return Substring(AText, 0, LStart);
        end;
      end;
      return AText;
    end;

    // The live line drawn again (its text and the whole seconds since its phase started) in
    // place of the one on the screen; held FLine is the caller's
    hidden method DoDraw();
    var
      LSeconds: int64;
    begin
      if (self.FText = "") or self.FDone or (atomicload(GLiveQuit) <> 0) then
        return;
      end;
      LSeconds := (TickCountMs() - self.FLast) div 1000;
      WriteText(CsiCr + CsiClearLine +
        self.DoFit(NoArgs().Str(self.FText).Int(LSeconds).Fill(ADAM_MSG_CLI_LIVE_LINE)));
      self.FShown := true;
    end;

    // The live line on the screen (if any) erased, the cursor at its start; held FLine is the
    // caller's
    hidden method DoErase();
    begin
      if self.FShown then
        WriteText(CsiCr + CsiClearLine);
        self.FShown := false;
      end;
    end;

    // The live text set to AText and drawn
    hidden method DoShow(const AText: string);
    begin
      lock (self.FLine) do
        self.FText := AText;
        self.DoDraw();
      end;
    end;

    override method PhaseStarted(const APhase: BuildPhase);
    begin
      if self.FLive then
        self.DoShow(self.DoLiveWord(APhase));
      end;
    end;

    override method StepStarted(const APhase: BuildPhase; const AStep: BuildStep;
      const ADone: int64; const ATotal: int64; const AUnit: string);
    var
      LWord: string;
    begin
      if not self.FLive then
        return;
      end;
      LWord := self.DoLiveWord(APhase);
      if AStep = BuildStep.Program then
        self.DoShow(NoArgs().Str(LWord).Fill(ADAM_MSG_CLI_LIVE_PROGRAM));
        return;
      end;
      if AStep = BuildStep.Merge then
        self.DoShow(NoArgs().Str(LWord).Int(ADone).Int(ATotal).Str(AUnit)
          .Fill(ADAM_MSG_CLI_LIVE_MERGE));
        return;
      end;
      // A unit compiled during Parse (a stale import) is not counted among the build's units
      if ATotal = 0 then
        self.DoShow(NoArgs().Str(LWord).Str(AUnit).Str(self.DoStepWord(AStep))
          .Fill(ADAM_MSG_CLI_LIVE_IMPORT));
        return;
      end;
      self.DoShow(NoArgs().Str(LWord).Int(ADone).Int(ATotal).Str(AUnit)
        .Str(self.DoStepWord(AStep)).Fill(ADAM_MSG_CLI_LIVE_UNIT));
    end;

    override method PhaseEnded(const APhase: BuildPhase; const AFirst: int64;
      const ASecond: int64; const AText: string);
    var
      LNow: int64;
    begin
      lock (self.FLine) do
        LNow := TickCountMs();
        self.DoErase();
        self.FText := "";
        self.FOut.Line(self.DoText(APhase, AFirst, ASecond, AText, DoSeconds(LNow - self.FLast)));
        // Seen as the phase ends even when stdout is a file or a pipe (a build's log)
        FlushOutput();
        self.FLast := LNow;
      end;
    end;

    // The ticker's one wait (its task, DoTick): sleeps until the running phase's next whole
    // second, or until Hold is free (the compile is over); redraws the live line on waking
    // while the compile runs. False once the ticker is to stop
    method Tick(): bool;
    var
      LWait: int64;
      LGo: bool;
    begin
      if atomicload(GLiveQuit) <> 0 then
        return false;
      end;
      lock (self.FLine) do
        LWait := 1000 - ((TickCountMs() - self.FLast) mod 1000);
      end;
      LGo := true;
      trylock (self.Hold) wait LWait do
        LGo := false;
      else
        lock (self.FLine) do
          self.DoDraw();
        end;
      end;
      return LGo and (atomicload(GLiveQuit) = 0);
    end;

    // The compile is over: a live line still on the screen (a phase an error ended) erased,
    // nothing drawn after this
    method Finish();
    begin
      lock (self.FLine) do
        self.DoErase();
        self.FText := "";
        self.FDone := true;
      end;
    end;
  end;

// The ticker task of a live CliPhases: one Tick after another until it says stop
routine DoTick(const APhases: ref CliPhases);
begin
  while APhases.Tick() do
  end;
end;

// The compile ARequest asks for: AMain checked (ACheck) or built into ARequest.Output
routine DoCompile(const ACompiler: ref Compiler; const ACheck: bool; const APath: string;
  const AOutput: string);
begin
  if ACheck then
    ACompiler.Check(APath);
  else
    ACompiler.Build(APath, AOutput);
  end;
end;

// The compile as DoCompile runs it, with the live phase line when APhases draws one (not nil
// and Live): the compile holds APhases.Hold while it runs, a ticker task redraws the line
// each second meanwhile and stops once Hold is free; the live line is erased at the end on
// every way out (Finish), before any report prints
routine DoCompileLive(const APhases: ref CliPhases; const ACompiler: ref Compiler;
  const ACheck: bool; const APath: string; const AOutput: string);
var
  LTicker: task;
begin
  if (APhases = nil) or not APhases.Live() then
    DoCompile(ACompiler, ACheck, APath, AOutput);
    return;
  end;
  lock (APhases.Hold) do
    LTicker := async DoTick(APhases);
    guard
      DoCompile(ACompiler, ACheck, APath, AOutput);
    finally
      APhases.Finish();
    end;
  end;
  await LTicker;
end;

// -r: the exe the build wrote (ACompiler.ExePath), run in the folder it landed in with
// ARequest.RunArgs on adam's own stdin / stdout / stderr; adam's lines are flushed first, so a
// pipe has them ahead of the program's. The program's exit code. Reports made here print on
// their own (the build's printed already): an exe that cannot start is CL0011 and
// ADAM_DRIVER_EXIT_ERRORS; a target this machine does not run (not the registry's default,
// the host's own) is CL0012, a warning, and the build's exit code, nothing run
routine DoRunExe(const ACompiler: ref Compiler; const ARequest: CliRequest): int32;
var
  LFirst: int64;
  LExitCode: uint32;
begin
  LFirst := ACompiler.Reports.Count;
  if ACompiler.PickedTarget.Triple() <> DefaultTriple() then
    ACompiler.Reports.Add(Severity.Warning, ADAM_ERR_CLI_012, NoPlace(), ADAM_MSG_CLI_RUN_FOREIGN,
      NoArgs().Str(ACompiler.ExePath).Str(ACompiler.PickedTarget.TargetName()));
    ACompiler.Reports.PrintFrom(LFirst);
    return ACompiler.ExitCode();
  end;
  FlushOutput();
  if not RunAttached(ACompiler.ExePath, ARequest.RunArgs, ExtractFileDir(ACompiler.ExePath),
    LExitCode) then
    DoReport(ACompiler.Reports, ADAM_ERR_CLI_011, ADAM_MSG_CLI_RUN_FAILED,
      NoArgs().Str(ACompiler.ExePath));
    ACompiler.Reports.PrintFrom(LFirst);
    return ADAM_DRIVER_EXIT_ERRORS;
  end;
  return int32(LExitCode);
end;

// The project folder ARequest.Positional names (none given: the current folder), resolved,
// in ADir: it must hold a project.toml, never one searched for above it (PaskalCPP's build /
// pack [<folder>]). ADAM_DRIVER_EXIT_OK, else ADAM_CLI_EXIT_USAGE with the reports printed:
// the folder cannot be resolved (CL0014) or holds no project.toml (CL0013)
routine DoProjectFolder(const ACompiler: ref Compiler; const ACommands: CommandTable;
  const ARequest: CliRequest; var ADir: string): int32;
begin
  if ARequest.Positional = "" then
    ADir := ResolvePath(".");
  else
    ADir := ResolvePath(ARequest.Positional);
  end;
  if ADir = "" then
    DoReport(ACompiler.Reports, ADAM_ERR_CLI_014, ADAM_MSG_CLI_BAD_PROJECT_DIR,
      NoArgs().Str(ARequest.Positional).Str(DoSee(ACommands, ARequest.Command)));
    ACompiler.PrintReports();
    return ADAM_CLI_EXIT_USAGE;
  end;
  if not FileExists(ResolvePath(ADAM_PROJECT_FILE_NAME, ADir)) then
    DoReport(ACompiler.Reports, ADAM_ERR_CLI_013, ADAM_MSG_CLI_NO_PROJECT,
      NoArgs().Str(ADAM_PROJECT_FILE_NAME).Str(ADir).Str(DoSee(ACommands, ARequest.Command)));
    ACompiler.PrintReports();
    return ADAM_CLI_EXIT_USAGE;
  end;
  return ADAM_DRIVER_EXIT_OK;
end;

// build's main module in AMain: ARequest.Positional when it is no folder (a file, read as
// before); else the main module of the project whose project.toml is in that folder
// (DoProjectFolder). ADAM_DRIVER_EXIT_OK, else the exit code with the reports printed:
// DoProjectFolder's mistakes, or a project.toml that does not load (its PJ reports,
// ADAM_DRIVER_EXIT_ERRORS)
routine DoBuildMain(const ACompiler: ref Compiler; const ACommands: CommandTable;
  const ARequest: CliRequest; var AMain: string): int32;
var
  LDir: string;
  LCode: int32;
  LProject: ref Project;
begin
  AMain := ARequest.Positional;
  if (AMain <> "") and not DirectoryExists(AMain) then
    return ADAM_DRIVER_EXIT_OK;
  end;
  LCode := DoProjectFolder(ACompiler, ACommands, ARequest, LDir);
  if LCode <> ADAM_DRIVER_EXIT_OK then
    return LCode;
  end;
  // Read once with no reports for its main module: the build reads it again and reports
  // what it says, so each report is printed once. One that does not load is read again into
  // the reports to say why
  LProject := ref Project(nil);
  if not LProject.Load(LDir) then
    LProject := ref Project(ACompiler.Reports);
    if not LProject.Load(LDir) then
      ACompiler.PrintReports();
      return ADAM_DRIVER_EXIT_ERRORS;
    end;
  end;
  AMain := LProject.MainPath();
  return ADAM_DRIVER_EXIT_OK;
end;

// adam init <name> <type>: the new project in the working folder (Adam.Driver.Project's
// Scaffold, its reports into the compile's Diagnostics), then, not under --quiet, where it
// was made and how to build it. ADAM_DRIVER_EXIT_OK, else ADAM_DRIVER_EXIT_ERRORS with the
// reports printed
routine DoInit(const AOut: ref HelpOut; const ACompiler: ref Compiler;
  const ARequest: CliRequest): int32;
var
  LKind: ModuleKind;
  LProject: ref Project;
begin
  // DoRead has checked the type: a type it turned away never gets here
  if not ProjectKindFromText(ARequest.TypeText, LKind) then
    return ADAM_CLI_EXIT_USAGE;
  end;
  LProject := ref Project(ACompiler.Reports);
  if not LProject.Scaffold("", ARequest.Positional, LKind) then
    ACompiler.PrintReports();
    return ADAM_DRIVER_EXIT_ERRORS;
  end;
  if not ARequest.Quiet then
    AOut.Line(NoArgs().Str(ProjectKindText(LKind)).Str(ARequest.Positional)
      .Str(LProject.Root).Fill(ADAM_MSG_CLI_INIT_DONE));
    AOut.Line(NoArgs().Str(ARequest.Positional).Fill(ADAM_MSG_CLI_INIT_NEXT));
  end;
  return ADAM_DRIVER_EXIT_OK;
end;

// adam pack's progress routine (System.CustomIO's ZipProgress): each entry counted once, on
// its first call, and printed indented unless quiet; AUserData is the pack's PackState
routine DoPackEntry(const AUserData: ptr; const AEntry: string; const APercent: int32;
  const ANewFile: bool);
var
  LState: ptr to PackState;
begin
  if not ANewFile then
    return;
  end;
  LState := ptr to PackState(AUserData);
  LState^.Entries := LState^.Entries + 1;
  if not LState^.Quiet then
    println("{}", NoArgs().Str(AEntry).Fill(ADAM_MSG_CLI_PACK_ENTRY));
  end;
end;

// The loaded project's assets folder, checked (CL0017 when it is not there), in AAssets and
// its archive's path, its folder made (CL0018 when it cannot be), in ARez: <name>.rez in the
// output folder itself (Project.RezPath), one archive for every target and mode, which each
// build copies beside its exe. False, reported
routine DoPackPaths(const ACompiler: ref Compiler; const AProject: ref Project;
  var AAssets: string; var ARez: string): bool;
var
  LFolder: string;
begin
  AAssets := AProject.AssetsPath();
  ARez := AProject.RezPath();
  if (AAssets = "") or not DirectoryExists(AAssets) then
    DoReport(ACompiler.Reports, ADAM_ERR_CLI_017, ADAM_MSG_CLI_PACK_NO_ASSETS,
      NoArgs().Str(ResolvePath(ADAM_PROJECT_ASSETS_DIR, AProject.Root)));
    return false;
  end;
  LFolder := ExtractFileDir(ARez);
  if (ARez = "") or not ForceDirectories(LFolder) then
    DoReport(ACompiler.Reports, ADAM_ERR_CLI_018, ADAM_MSG_CLI_PACK_FOLDER,
      NoArgs().Str(AProject.OutputPath()));
    return false;
  end;
  return true;
end;

// The archive ARez adam pack just wrote, copied over every older copy a build left beside
// its exe (CopyRez): each <output>\bin\<triple>\<mode>\ folder already holding <name>.rez, so
// a program built before the pack opens the new assets with no rebuild; each one printed
// unless AQuiet. No bin folder yet: nothing to update. False, reported (CL0021), when a copy
// cannot be written
routine DoPackRefresh(const AOut: ref HelpOut; const ACompiler: ref Compiler;
  const ARez: string; const AQuiet: bool): bool;
var
  LBin: string;
  LTriples: StringArray;
  LModes: StringArray;
  LTripleDir: string;
  LDir: string;
  LCopy: string;
  LI: int64;
  LJ: int64;
begin
  LBin := ResolvePath(ADAM_OUTPUT_BIN_DIR, ExtractFileDir(ARez));
  if (LBin = "") or not GetDirectories(LBin, LTriples) then
    return true;
  end;
  for LI := 0 to len(LTriples) - 1 do
    LTripleDir := ResolvePath(LTriples[LI], LBin);
    if GetDirectories(LTripleDir, LModes) then
      for LJ := 0 to len(LModes) - 1 do
        LDir := ResolvePath(LModes[LJ], LTripleDir);
        if FileExists(ResolvePath(ExtractFileName(ARez), LDir)) then
          if not CopyRez(ARez, LDir, LCopy) then
            DoReport(ACompiler.Reports, ADAM_ERR_CLI_021, ADAM_MSG_CLI_PACK_COPY,
              NoArgs().Str(ARez).Str(LCopy));
            return false;
          end;
          if not AQuiet then
            AOut.Line(NoArgs().Str(LCopy).Fill(ADAM_MSG_CLI_PACK_UPDATED));
          end;
        end;
      end;
    end;
  end;
  return true;
end;

// adam pack [<folder>]: the assets folder of the project whose project.toml is in that folder
// (DoProjectFolder) zipped into its <name>.rez in the output folder (DoPackPaths) with its
// pack password, by System.CustomIO's ZipDirectoryContents (deflated, ZipCrypto unless the
// password is empty, entries named below assets/). Not under --quiet: the start, each entry,
// the count and the archive written (PaskalCPP's AssetPacker lines), then each older copy
// beside a built exe updated (DoPackRefresh). ADAM_DRIVER_EXIT_OK, else DoProjectFolder's
// mistakes (exit 2) or ADAM_DRIVER_EXIT_ERRORS with the reports printed: a project.toml that
// does not load (its PJ reports), no assets folder, the archive's folder, the archive itself
// (CL0019, ZipLastError's reason) or a copy beside an exe (CL0021)
routine DoPack(const AOut: ref HelpOut; const ACompiler: ref Compiler;
  const ACommands: CommandTable; const ARequest: CliRequest): int32;
var
  LDir: string;
  LCode: int32;
  LProject: ref Project;
  LAssets: string;
  LRez: string;
  LState: PackState;
  LFirst: int64;
begin
  LCode := DoProjectFolder(ACompiler, ACommands, ARequest, LDir);
  if LCode <> ADAM_DRIVER_EXIT_OK then
    return LCode;
  end;
  LProject := ref Project(ACompiler.Reports);
  if not LProject.Load(LDir) or not DoPackPaths(ACompiler, LProject, LAssets, LRez) then
    ACompiler.PrintReports();
    return ADAM_DRIVER_EXIT_ERRORS;
  end;
  // project.toml's warnings (an unknown key) before the pack's own lines; a failure below
  // prints only what it adds
  ACompiler.PrintReports();
  LFirst := ACompiler.Reports.Count;
  if not ARequest.Quiet then
    AOut.Line(NoArgs().Str(LAssets).Str(LRez).Fill(ADAM_MSG_CLI_PACK_START));
  end;
  LState.Quiet := ARequest.Quiet;
  LState.Entries := 0;
  if not ZipDirectoryContents(LRez, LAssets, LProject.Password, "", DoPackEntry,
    addr of LState) then
    DoReport(ACompiler.Reports, ADAM_ERR_CLI_019, ADAM_MSG_CLI_PACK_FAILED,
      NoArgs().Str(LAssets).Str(LRez).Str(ZipLastError()));
    ACompiler.Reports.PrintFrom(LFirst);
    return ADAM_DRIVER_EXIT_ERRORS;
  end;
  if not ARequest.Quiet then
    AOut.Line(NoArgs().Int(LState.Entries).Fill(ADAM_MSG_CLI_PACK_COUNT));
    AOut.Line(NoArgs().Str(LRez).Fill(ADAM_MSG_CLI_PACK_DONE));
  end;
  if not DoPackRefresh(AOut, ACompiler, LRez, ARequest.Quiet) then
    ACompiler.Reports.PrintFrom(LFirst);
    return ADAM_DRIVER_EXIT_ERRORS;
  end;
  return ADAM_DRIVER_EXIT_OK;
end;

// Runs the command line ARequest read: a help printed into AOut, or the compile it asks for
// run and its reports printed. The exit code
routine DoRun(const AOut: ref HelpOut; const ACompiler: ref Compiler;
  const ACommands: CommandTable; const AOptions: OptionTable; const ARequest: CliRequest): int32;
var
  LSpec: CommandSpec;
  LTopic: int64;
  LStart: int64;
  LPhases: ref CliPhases;
  LCode: int32;
  LMain: string;
begin
  if ARequest.Command < 0 then
    DoHelpAll(AOut, ACommands, AOptions);
    return ADAM_DRIVER_EXIT_OK;
  end;
  if ARequest.WantHelp then
    DoHelpCommand(AOut, ACommands, AOptions, ARequest.Command);
    return ADAM_DRIVER_EXIT_OK;
  end;
  LSpec := ACommands[ARequest.Command];
  if LSpec.Id = CliCommand.Help then
    if ARequest.Positional = "" then
      DoHelpAll(AOut, ACommands, AOptions);
      return ADAM_DRIVER_EXIT_OK;
    end;
    LTopic := DoFindCommand(ACommands, ARequest.Positional);
    if LTopic < 0 then
      DoReport(ACompiler.Reports, ADAM_ERR_CLI_006, ADAM_MSG_CLI_HELP_UNKNOWN,
        NoArgs().Str(ARequest.Positional));
      ACompiler.PrintReports();
      return ADAM_CLI_EXIT_USAGE;
    end;
    DoHelpCommand(AOut, ACommands, AOptions, LTopic);
    return ADAM_DRIVER_EXIT_OK;
  end;
  if LSpec.Id = CliCommand.Init then
    return DoInit(AOut, ACompiler, ARequest);
  end;
  if LSpec.Id = CliCommand.Pack then
    return DoPack(AOut, ACompiler, ACommands, ARequest);
  end;
  if ARequest.TargetTriple <> "" then
    ACompiler.SetTarget(ARequest.TargetTriple);
  end;
  // A line per phase as it ends (not under --quiet); made here so the first phase's time
  // starts with the compile
  LPhases := nil;
  if not ARequest.Quiet then
    LPhases := ref CliPhases(AOut);
    ACompiler.SetListener(LPhases);
  end;
  if LSpec.Id = CliCommand.Check then
    DoCompileLive(LPhases, ACompiler, true, ARequest.Positional, "");
    ACompiler.PrintReports();
    return ACompiler.ExitCode();
  end;
  LStart := TickCountMs();
  LCode := DoBuildMain(ACompiler, ACommands, ARequest, LMain);
  if LCode <> ADAM_DRIVER_EXIT_OK then
    return LCode;
  end;
  DoCompileLive(LPhases, ACompiler, false, LMain, ARequest.Output);
  ACompiler.PrintReports();
  // The status line: a build that wrote its exe says so, the main module (as given, or the
  // project's) and the exe as written, with the time it took (not under --quiet)
  if not ARequest.Quiet and (ACompiler.ExePath <> "") then
    AOut.Line(NoArgs().Str(LMain).Str(ACompiler.ExePath)
      .Str(DoSeconds(TickCountMs() - LStart)).Fill(ADAM_MSG_CLI_BUILT));
  end;
  // -r: the program runs once its exe is written (a failed build never runs it)
  if ARequest.Run and (ACompiler.ExePath <> "") then
    return DoRunExe(ACompiler, ARequest);
  end;
  return ACompiler.ExitCode();
end;

// Runs adam's command line (see the header): the exit code for the process
public routine RunCommandLine(): int32;
var
  LCompiler: ref Compiler;
  LCommands: CommandTable;
  LOptions: OptionTable;
  LRequest: CliRequest;
  LColor: bool;
  LOut: ref HelpOut;
begin
  // adam's own heap report only with --heap (System.Runtime's one public routine)
  SetHeapReport(false);
  // Color only on a console that takes VT sequences; piped or redirected, every line is
  // plain (what a file, another program and adamtest read)
  LColor := EscapesEnabled();
  LOut := ref HelpOut(LColor);
  LCompiler := ref Compiler();
  LCompiler.Reports.SetColor(LColor);
  LCommands := DoCommandTable();
  LOptions := DoOptionTable();
  if not DoWantsNoBanner(LOptions) then
    DoBanner(LOut);
  end;
  if not DoRead(LCommands, LOptions, LCompiler.Reports, LRequest) then
    LCompiler.PrintReports();
    return ADAM_CLI_EXIT_USAGE;
  end;
  if LRequest.Heap then
    SetHeapReport(true);
  end;
  LCompiler.SetEmitIr(LRequest.EmitIr);
  // The build's level, set before the front end runs (every file's DEBUG / RELEASE /
  // RELEASE_<LEVEL> define reads it): -opt's, else the compiler's own build at safe, else the
  // main module's @optimize decides
  if LRequest.LevelGiven then
    LCompiler.SetLevel(LRequest.Level);
  else
    if LRequest.SelfBuild then
      LCompiler.SetLevel(OptLevel.Safe);
    end;
  end;
  return DoRun(LOut, LCompiler, LCommands, LOptions, LRequest);
end;

end.
