-------------------------------------------------------------------------------
  Adam.CImport.Macros.adam - `adam cimport`'s macros (M9f; DESIGN sec 15):
  a #define as the Adam constant or routine it means

  MacroEvaluator  one import's macros, each read as the input ends
                  (Evaluate): its expansion (Preprocessor.ExpandMacro)
                  parsed as a C expression and typed by C's rules on the
                  target. Told the routines the unit binds (AddCallee),
                  which a function-like macro may call
  MacroResult     what a macro is: a constant (its MacroValue: an integer,
                  a float, a string or a struct's compound literal, with
                  its C type), a routine (its parameters' types, its
                  body's Adam expression, its C result type), nothing to
                  bind (an empty #define: a guard or a flag) or not
                  bindable, Why the reason (a CI0001 by name)

  An object-like macro is a constant when its body is one of C's constant
  expressions: an integer constant typed by its suffix and base (C's list:
  int, long, long long for a decimal; the unsigned ones between for hex /
  octal / binary; clang's unsigned long long for a decimal past long long),
  a character constant (int, the target's char signedness), a float
  constant (double; f float; l long double, which Adam has no type for),
  adjacent string literals (u8 or plain: a `string` const; L / u / U are
  not), an enum constant (its enum's integer type), sizeof / _Alignof of a
  type or an expression (size_t, from the target's __SIZE_TYPE__), casts
  to an integer, _Bool or float type (the value converted as C converts
  it), a compound literal (T){..} of a struct whose fields are numbers
  (positional or .name = designated, the rest 0), clang's __builtin_inf /
  __builtin_huge_val / __builtin_nan("") (f for float: math.h's INFINITY,
  HUGE_VAL, NAN; written as Adam's constant 1.0 / 0.0 and 0.0 / 0.0, as is
  any infinite or NaN value), and C's operators with
  the usual arithmetic conversions; ?: && || evaluate only the arm C
  evaluates. A signed value that overflows its type, a division by zero
  or a shift outside the type is not a constant (C's rule; unsigned
  arithmetic wraps). A pointer constant ((void *)0) has no Adam const.

  A function-like macro is an Adam routine when its body is an expression
  Adam can say: a parameter takes the type of the parameter of a bound
  routine it is passed to whole (parentheses allowed), the first such use.
  A parameter nothing types is a type parameter of the routine, which is
  then generic (M9k, BNF sec 10): the parameters one operator or ?: joins
  share one; its operators work in that type (a constant beside it is
  written bare, so it takes the type; / is div, % mod, a comparison an
  Adam bool), a cast or a bound routine's argument converts it as Adam's
  cast does, and the result is that type where the body computes one.
  Mixing it with a typed run-time value or a float, or reading a field,
  an element, a pointee or the size of it is reported: C's conversion
  there depends on the argument's type, which only a use knows. The body
  may use a typed parameter as C's operators do (each operand converted to C's common type with an Adam type cast
  where the type changes, comparisons and && || ! as Adam bools, / as div
  on integers, % as mod), call bound routines (each argument converted to
  its parameter's type; a string literal for a char pointer, 0 for any
  pointer as nil) and fold every constant part, but sizeof of a type the
  unit names, which is Adam's size() of it (the routine then says the same
  on every target). A void call is a routine
  with no result. A variadic macro, # / ## left in the body, a name that
  is no parameter, constant or bound routine
  are reported by name with the reason, never dropped silently.

  An expression also reads places (M9j2: a function-like macro's body and,
  through BeginBody / AddLocal / ExpressionAt, a translated routine's): a
  parameter or a local, a field by -> and . (a const container's field is
  const), an element by [] of a typed pointer or an array, a dereference
  by *; & takes a place's address (Adam's addr of), = and the compound
  assignments, ++ and -- write one (Adam's assignment expressions: Adam's
  compound form where it computes as C's does, else X := T(X op v) when X
  has no side effect). A pointer is tested against nil (its truth, !,
  && ||, == and != with another pointer or a null pointer constant, which
  is nil there). clang's bit builtins are Adam's bit intrinsics
  (__builtin_bswap16 / 32 / 64 byteswap; clz, ctz, popcount and their l /
  ll forms leadingzeros, trailingzeros, popcount; a constant folded; in a
  macro each types a parameter passed to it whole); __builtin_add_overflow
  and __builtin_mul_overflow over unsigned operands no wider than the
  unsigned type their result points to are plain Adam (the wrapped value
  stored, the overflow compared). A macro's parameter is the caller's own
  expression in C: assigning it, stepping it or taking its address has no
  routine form.
*******************************************************************************/

module unit Adam.CImport.Macros;

import System.SysUtils, Adam.Core.Containers, Adam.Core.Messages, Adam.Compiler.Diagnostics,
  Adam.Target,
  Adam.CImport.Spec, Adam.CImport.Lexer, Adam.CImport.Preprocessor, Adam.CImport.CTypes,
  Adam.CImport.Parser;

public const
  // The lowest int64 and its text (the literal 9223372036854775808 is past int64)
  ADAM_CIMPORT_MACRO_INT64_MIN: int64 = -9223372036854775807 - 1;
  ADAM_CIMPORT_MACRO_INT64_MIN_TEXT: string = "-9223372036854775807 - 1";
  ADAM_CIMPORT_MACRO_INT64_MAX: uint64 = 9223372036854775807u;
  // clang's builtin names (its floating constants are read, DoFloatBuiltin)
  ADAM_CIMPORT_MACRO_BUILTIN: string = "__builtin_";
  // sizeof's type as the target's predefines name it
  ADAM_CIMPORT_MACRO_SIZE_TYPE: string = "__SIZE_TYPE__";
  // Not looked up yet (sizeof's type)
  ADAM_CIMPORT_MACRO_UNKNOWN: int64 = -2;

public type
  // What a macro's expression is: a constant integer, float, string bytes (Text) or a
  // compound literal's field inits (Literal: Adam text "f: v, .."), or, in a function-like
  // macro, Adam text evaluated at run time (Runtime) or a void call (Void)
  MacroValueKind = choices(Int, Float, Text, Literal, Runtime, Void);

  // One typed expression: its C type (TypeId), an Int's bits (by its type's signedness), a
  // Float's value and its literal's text when one literal gave it (Spelling, suffix off), a
  // Text's bytes / a Literal's inits / a Runtime's Adam text; IsBool: the Runtime text is an
  // Adam bool (a comparison, && || !, a _Bool)
  MacroValue = record
    Kind: MacroValueKind;
    TypeId: int64;
    Value: int64;
    Real: float64;
    Text: string;
    Spelling: string;
    IsBool: bool;
    // a place (a parameter or local, a field, an element, a dereference): assigned, stepped or
    // its address taken; Root the parameter (a macro's) or local (a body's) whose own storage
    // it is, -1 when it is reached through a pointer
    IsPlace: bool;
    Root: int64;
    // an assignment's or a step's Adam text as a statement (Text holds it in parentheses)
    Bare: string;
    // a value of a type parameter (M9k): computed from parameters no bound routine types and
    // constants alone, the index + 1 of such a parameter in its group (DoJoin); TypeId then
    // int, which no decision on it reads. 0 for a value of its C type
    Generic: int64;
  end;

  // What a macro is (see the header): Bound false with Why "" when it binds nothing (an empty
  // body); IsRoutine with its parameters' Adam names and C types and its Body (Value: the
  // body's type in TypeId, Kind Void for none)
  MacroResult = record
    Bound: bool;
    Why: string;
    IsRoutine: bool;
    Value: MacroValue;
    Params: StringArray;
    ParamTypes: Int64Array;
    Body: string;
    // the header files of the routines its body calls (AddCallee's AFile), so the writer
    // imports a [uses] unit a call needs
    Files: Int64Array;
    // a generic routine's type parameters (M9k: one per group of untyped parameters, none for
    // a plain one), each parameter's type as one of them ("" for ParamTypes' C type) and the
    // result's ("" for Value.TypeId's)
    TypeParams: StringArray;
    ParamTypeText: StringArray;
    ResultTypeText: string;
  end;

// The name of a macro routine's type parameter AIndex of ACount (M9k): T for a lone one,
// else T1, T2 ..; a '_' added while it is one of the routine's parameter names AParams (case
// aside)
routine DoTypeParamName(const AIndex: int64; const ACount: int64; const AParams: StringArray):
  string;
var
  LName: string;
  LClash: bool;
  LI: int64;
begin
  LName := "T";
  if ACount > 1 then
    LName := "T" + IntToStr(AIndex + 1);
  end;
  LClash := true;
  while LClash do
    LClash := false;
    for LI := 0 to len(AParams) - 1 do
      if LowerCase(AParams[LI]) = LowerCase(LName) then
        LClash := true;
      end;
    end;
    if LClash then
      LName := LName + "_";
    end;
  end;
  return LName;
end;

// A C name as an Adam name in place: an Adam keyword with a trailing '_' (AD.5), as the
// binding writer writes a field or parameter
routine DoLocalName(const ACName: string): string;
begin
  if IsAdamName(ACName) then
    return ACName;
  end;
  return ACName + "_";
end;

// The value of a C digit in base ABase; -1 when AChar is none
routine DoDigit(const AChar: char; const ABase: int64): int64;
var
  LValue: int64;
begin
  LValue := -1;
  if (AChar >= '0') and (AChar <= '9') then
    LValue := int64(AChar) - int64('0');
  end;
  if (AChar >= 'a') and (AChar <= 'f') then
    LValue := int64(AChar) - int64('a') + 10;
  end;
  if (AChar >= 'A') and (AChar <= 'F') then
    LValue := int64(AChar) - int64('A') + 10;
  end;
  if LValue >= ABase then
    return -1;
  end;
  return LValue;
end;

// The bytes of a C character / string literal's body ABody (between its quotes), its
// escapes taken as clang takes them in a narrow literal (\u / \U as UTF-8); false for a
// malformed escape
routine DoDecode(const ABody: string; var ABytes: Int64Array): bool;
var
  LCount: int64;
  LAt: int64;
  LByte: int64;
  LCode: int64;
  LDigits: int64;
  LWant: int64;
  LChar: char;
begin
  setlength(ABytes, len(ABody));
  LCount := 0;
  LAt := 0;
  while LAt < len(ABody) do
    LChar := ABody[LAt];
    LAt := LAt + 1;
    if (LChar <> '\\') or (LAt >= len(ABody)) then
      ABytes[LCount] := int64(uint8(LChar));
      LCount := LCount + 1;
      skip;
    end;
    LChar := ABody[LAt];
    LAt := LAt + 1;
    LByte := int64(uint8(LChar));
    match LChar of
      'n': LByte := 10;
      't': LByte := 9;
      'r': LByte := 13;
      'a': LByte := 7;
      'b': LByte := 8;
      'f': LByte := 12;
      'v': LByte := 11;
      'e': LByte := 27;
      'x':
        LByte := 0;
        LDigits := 0;
        while (LAt < len(ABody)) and (DoDigit(ABody[LAt], 16) >= 0) do
          LByte := (LByte * 16 + DoDigit(ABody[LAt], 16)) & 255;
          LAt := LAt + 1;
          LDigits := LDigits + 1;
        end;
        if LDigits = 0 then
          return false;
        end;
      '0', '1', '2', '3', '4', '5', '6', '7':
        LByte := DoDigit(LChar, 8);
        LDigits := 1;
        while (LDigits < 3) and (LAt < len(ABody)) and (DoDigit(ABody[LAt], 8) >= 0) do
          LByte := LByte * 8 + DoDigit(ABody[LAt], 8);
          LAt := LAt + 1;
          LDigits := LDigits + 1;
        end;
        LByte := LByte & 255;
      'u', 'U':
        LWant := 4;
        if LChar = 'U' then
          LWant := 8;
        end;
        LCode := 0;
        LDigits := 0;
        while (LDigits < LWant) and (LAt < len(ABody)) and (DoDigit(ABody[LAt], 16) >= 0) do
          LCode := LCode * 16 + DoDigit(ABody[LAt], 16);
          LAt := LAt + 1;
          LDigits := LDigits + 1;
        end;
        if (LDigits < LWant) or (LCode > 1114111) then
          return false;
        end;
        // UTF-8: one to four bytes
        if LCode < 128 then
          LByte := LCode;
        else
          if LCode < 2048 then
            ABytes[LCount] := 192 | (LCode >> 6);
            LCount := LCount + 1;
          else
            if LCode < 65536 then
              ABytes[LCount] := 224 | (LCode >> 12);
              ABytes[LCount + 1] := 128 | ((LCode >> 6) & 63);
              LCount := LCount + 2;
            else
              ABytes[LCount] := 240 | (LCode >> 18);
              ABytes[LCount + 1] := 128 | ((LCode >> 12) & 63);
              ABytes[LCount + 2] := 128 | ((LCode >> 6) & 63);
              LCount := LCount + 3;
            end;
          end;
          LByte := 128 | (LCode & 63);
        end;
    else
    end;
    ABytes[LCount] := LByte;
    LCount := LCount + 1;
  end;
  setlength(ABytes, LCount);
  return true;
end;

// One byte of a string as Adam literal text: printable ASCII as itself (\ and " escaped),
// \n \t \r, any other byte a three-digit octal escape (never read on into a next digit)
routine DoByteText(const AByte: int64): string;
begin
  match AByte of
    10: return "\\n";
    9: return "\\t";
    13: return "\\r";
    92: return "\\\\";
    34: return "\\\"";
  else
  end;
  if (AByte >= 32) and (AByte < 127) then
    return StringOfChar(char(uint8(AByte)), 1);
  end;
  return "\\" + StringOfChar(char(uint8(int64('0') + ((AByte >> 6) & 7))), 1) +
    StringOfChar(char(uint8(int64('0') + ((AByte >> 3) & 7))), 1) +
    StringOfChar(char(uint8(int64('0') + (AByte & 7))), 1);
end;

// The Adam string literal of the bytes ABytes (the bytes are one string's, never a C
// string's text, so a C escape never reaches Adam's reading of it)
routine DoStringText(const ABytes: Int64Array): string;
var
  LOut: ref TextBuilder;
  LI: int64;
begin
  LOut := ref TextBuilder();
  LOut.Add("\"");
  for LI := 0 to len(ABytes) - 1 do
    LOut.Add(DoByteText(ABytes[LI]));
  end;
  LOut.Add("\"");
  return LOut.Text();
end;

// True when AText (a float's text) reads as an Adam float literal and not an integer one
routine DoHasFloatMark(const AText: string): bool;
begin
  return (IndexOf(".", AText, 0) >= 0) or (IndexOf("e", AText, 0) >= 0) or
    (IndexOf("E", AText, 0) >= 0) or (IndexOf("p", AText, 0) >= 0) or
    (IndexOf("P", AText, 0) >= 0);
end;

// AText in parentheses when it starts with a '-' (a negative constant beside an operator)
routine DoOperand(const AText: string): string;
begin
  if StartsStr("-", AText) then
    return "(" + AText + ")";
  end;
  return AText;
end;

public type
  // One import's macros (see the header)
  MacroEvaluator = object
    hidden FPre: ref Preprocessor;
    hidden FParser: ref CParser;
    hidden FTypes: ref CTypeTable;
    hidden FTarget: ref Target;
    // a fundamental kind's type (by CKindText, its id + 1)
    hidden FBuiltins: ref StringIdMap;
    // every enum constant: its value and its enum's integer type
    hidden FEnumIds: ref StringIdMap;
    hidden FEnumValues: Int64Array;
    hidden FEnumTypes: Int64Array;
    // the routines a macro may call: C name -> slot + 1, the Adam name, the function type
    hidden FCalleeIds: ref StringIdMap;
    hidden FCalleeNames: StringArray;
    hidden FCalleeTypes: Int64Array;
    hidden FCalleeFiles: Int64Array;
    hidden FCalleeCount: int64;
    // the files of the routines the macro being evaluated calls (MacroResult.Files)
    hidden FCalled: Int64Array;
    hidden FCalledCount: int64;
    // the types the unit names: "t<typedef decl>" / "r<record>" -> slot + 1, the Adam name
    hidden FTypeNameIds: ref StringIdMap;
    hidden FTypeNames: StringArray;
    hidden FTypeNameCount: int64;
    hidden FSizeType: int64;
    // one evaluation: its tokens, the cursor, the first reason it fails, a function-like
    // macro's parameters and their types, how deep in an arm C does not evaluate
    hidden FToks: PpTokenArray;
    hidden FPos: int64;
    hidden FWhy: string;
    hidden FFunction: bool;
    hidden FParams: StringArray;
    hidden FParamTypes: Int64Array;
    // each parameter's group (a union-find parent: itself for a group's first): the untyped
    // parameters an operator joins share one type parameter
    hidden FGroups: Int64Array;
    hidden FDead: int64;
    // a body's locals (BeginBody: its parameters first, then AddLocal): the C name, the Adam
    // name (one per body: Adam's locals share their routine's scope), the type, written
    // (assigned, stepped or its address taken: 1); the Adam names a body took
    hidden FBody: bool;
    hidden FLocalNames: StringArray;
    hidden FLocalAdam: StringArray;
    hidden FLocalTypes: Int64Array;
    hidden FLocalWritten: Int64Array;
    hidden FLocalCount: int64;
    hidden FLocalTaken: ref StringIdMap;
    // calls, assignments and steps read so far: a part whose reading leaves it unchanged has
    // no side effect
    hidden FEffects: int64;
    // the pointer type to each type (DoPointerTo, one per pointee)
    hidden FPointers: ref Int64Map;

    init(const APre: ref Preprocessor; const AParser: ref CParser);
    var
      LEnum: CEnum;
      LCount: int64;
      LI: int64;
      LJ: int64;
    begin
      self.FPre := APre;
      self.FParser := AParser;
      self.FTypes := AParser.Types();
      self.FTarget := self.FTypes.TargetOf();
      self.FBuiltins := ref StringIdMap(0);
      self.FEnumIds := ref StringIdMap(0);
      self.FCalleeIds := ref StringIdMap(0);
      self.FCalleeCount := 0;
      self.FTypeNameIds := ref StringIdMap(0);
      self.FTypeNameCount := 0;
      self.FSizeType := ADAM_CIMPORT_MACRO_UNKNOWN;
      self.FDead := 0;
      self.FBody := false;
      self.FLocalCount := 0;
      self.FLocalTaken := ref StringIdMap(0);
      self.FEffects := 0;
      self.FPointers := ref Int64Map(-1);
      LCount := 0;
      for LI := 0 to self.FTypes.EnumCount - 1 do
        LCount := LCount + len(self.FTypes.EnumAt(LI).Names);
      end;
      setlength(self.FEnumValues, LCount);
      setlength(self.FEnumTypes, LCount);
      LCount := 0;
      for LI := 0 to self.FTypes.EnumCount - 1 do
        LEnum := self.FTypes.EnumAt(LI);
        if not LEnum.Complete then
          skip;
        end;
        for LJ := 0 to len(LEnum.Names) - 1 do
          self.FEnumValues[LCount] := LEnum.Values[LJ];
          self.FEnumTypes[LCount] := self.DoBuiltin(LEnum.Underlying);
          LCount := LCount + 1;
          self.FEnumIds.Put(LEnum.Names[LJ], LCount);
        end;
      end;
    end;

    // The routine ACName (its function type ATypeId, declared in the header file AFile) bound
    // as AAdamName, by this unit or a [uses] unit: a function-like macro may call it
    method AddCallee(const ACName: string; const AAdamName: string; const ATypeId: int64;
      const AFile: int64);
    begin
      if self.FCalleeCount = len(self.FCalleeNames) then
        setlength(self.FCalleeNames, self.FCalleeCount * 2 + 16);
        setlength(self.FCalleeTypes, len(self.FCalleeNames));
        setlength(self.FCalleeFiles, len(self.FCalleeNames));
      end;
      self.FCalleeNames[self.FCalleeCount] := AAdamName;
      self.FCalleeTypes[self.FCalleeCount] := ATypeId;
      self.FCalleeFiles[self.FCalleeCount] := AFile;
      self.FCalleeCount := self.FCalleeCount + 1;
      self.FCalleeIds.Put(ACName, self.FCalleeCount);
    end;

    // The typedef ADecl (a declaration index) the unit names AAdamName: sizeof of it in a
    // function-like macro is Adam's size(), the same on every target
    method AddTypedefName(const ADecl: int64; const AAdamName: string);
    begin
      self.DoAddTypeName("t" + IntToStr(ADecl), AAdamName);
    end;

    // The record ARecord (an index in the type table) the unit names AAdamName (as
    // AddTypedefName)
    method AddRecordName(const ARecord: int64; const AAdamName: string);
    begin
      self.DoAddTypeName("r" + IntToStr(ARecord), AAdamName);
    end;

    // ---- a body (M9j2; a translated static / inline routine, M9j3) ---------------------------

    // Starts a body whose parameters are AParams (C names) of the types ATypes: each its
    // local (AddLocal); the files called so far forgotten (CalledFiles)
    method BeginBody(const AParams: StringArray; const ATypes: Int64Array);
    var
      LI: int64;
    begin
      self.FBody := true;
      self.FFunction := true;
      setlength(self.FParams, 0);
      setlength(self.FParamTypes, 0);
      self.FLocalCount := 0;
      self.FLocalTaken := ref StringIdMap(0);
      self.FCalledCount := 0;
      self.FEffects := 0;
      for LI := 0 to len(AParams) - 1 do
        self.AddLocal(AParams[LI], ATypes[LI]);
      end;
    end;

    // The local ACName of the type ATypeId, known from here to its scope's end (EndScope);
    // its index. Its Adam name is DoLocalName's, made unique in the body (Adam's locals share
    // their routine's scope): name_2, name_3 .. after the first
    method AddLocal(const ACName: string; const ATypeId: int64): int64;
    var
      LName: string;
    begin
      if self.FLocalCount = len(self.FLocalNames) then
        setlength(self.FLocalNames, self.FLocalCount * 2 + 8);
        setlength(self.FLocalAdam, len(self.FLocalNames));
        setlength(self.FLocalTypes, len(self.FLocalNames));
        setlength(self.FLocalWritten, len(self.FLocalNames));
      end;
      LName := self.TakeName(ACName);
      self.FLocalNames[self.FLocalCount] := ACName;
      self.FLocalAdam[self.FLocalCount] := LName;
      self.FLocalTypes[self.FLocalCount] := ATypeId;
      self.FLocalWritten[self.FLocalCount] := 0;
      self.FLocalCount := self.FLocalCount + 1;
      return self.FLocalCount - 1;
    end;

    // ACName as an Adam name the body has not taken (DoLocalName's, then name_2, name_3 ..),
    // taken now: a local's (AddLocal) or a type the body declares (M9j3)
    method TakeName(const ACName: string): string;
    var
      LName: string;
      LNumber: int64;
    begin
      LName := DoLocalName(ACName);
      LNumber := 1;
      while self.FLocalTaken.Find(LName) > 0 do
        LNumber := LNumber + 1;
        LName := DoLocalName(ACName) + "_" + IntToStr(LNumber);
      end;
      self.FLocalTaken.Put(LName, 1);
      return LName;
    end;

    // How many calls, assignments and steps were read so far: an expression read without
    // changing it has no side effect (an expression statement that does nothing, M9j3)
    const method Effects(): int64;
    begin
      return self.FEffects;
    end;

    // Where the current scope starts (EndScope ends it)
    const method ScopeMark(): int64;
    begin
      return self.FLocalCount;
    end;

    // The locals added since AMark (ScopeMark) are known no more
    method EndScope(const AMark: int64);
    begin
      self.FLocalCount := AMark;
    end;

    // The Adam name of the local AIndex
    const method LocalName(const AIndex: int64): string;
    begin
      return self.FLocalAdam[AIndex];
    end;

    // True when the local AIndex is assigned, stepped or has its address taken
    const method LocalWritten(const AIndex: int64): bool;
    begin
      return self.FLocalWritten[AIndex] <> 0;
    end;

    // The C expression (an assignment expression) at APos of AToks as the body reads it:
    // AValue (its Text Adam), APos past it; false (Why the reason) when Adam cannot say it
    method ExpressionAt(const AToks: PpTokenArray; var APos: int64; var AValue: MacroValue): bool;
    begin
      self.FToks := AToks;
      self.FPos := APos;
      self.FWhy := "";
      self.FDead := 0;
      if not self.DoAssign(AValue) then
        if self.FWhy = "" then
          self.FWhy := ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR;
        end;
        return false;
      end;
      APos := self.FPos;
      return true;
    end;

    // Why the last ExpressionAt, ValueAs or TestText failed
    const method Why(): string;
    begin
      return self.FWhy;
    end;

    // AValue converted as C converts it to the type ATypeId (an assignment, an initializer, a
    // return); "" (Why the reason) when Adam has no form for the conversion
    method ValueAs(const AValue: MacroValue; const ATypeId: int64): string;
    var
      LText: string;
    begin
      LText := self.DoArgText(AValue, ATypeId);
      if (LText = "") and (self.FWhy = "") then
        self.FWhy := ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR;
      end;
      return LText;
    end;

    // AValue tested as C tests a condition (a number against 0, a pointer against nil) as an
    // Adam bool; "" (Why the reason) when it is neither
    method TestText(const AValue: MacroValue): string;
    begin
      if not self.DoIsTestable(AValue) then
        self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        return "";
      end;
      return self.DoBoolText(AValue);
    end;

    // AValue as an expression statement's text (an assignment or a step without its
    // parentheses)
    const method StatementText(const AValue: MacroValue): string;
    begin
      if AValue.Bare <> "" then
        return AValue.Bare;
      end;
      return AValue.Text;
    end;

    // The header files of the routines the body called so far (MacroResult.Files' list)
    const method CalledFiles(): Int64Array;
    var
      LFiles: Int64Array;
      LI: int64;
    begin
      setlength(LFiles, self.FCalledCount);
      for LI := 0 to self.FCalledCount - 1 do
        LFiles[LI] := self.FCalled[LI];
      end;
      return LFiles;
    end;

    hidden method DoAddTypeName(const AKey: string; const AAdamName: string);
    begin
      if self.FTypeNameCount = len(self.FTypeNames) then
        setlength(self.FTypeNames, self.FTypeNameCount * 2 + 16);
      end;
      self.FTypeNames[self.FTypeNameCount] := AAdamName;
      self.FTypeNameCount := self.FTypeNameCount + 1;
      self.FTypeNameIds.Put(AKey, self.FTypeNameCount);
    end;

    // The Adam name the unit gives the type ATypeId (a typedef's name or a record, as
    // written, qualifiers aside); "" when it names none
    hidden const method DoTypeNameOf(const ATypeId: int64): string;
    var
      LType: CType;
      LSlot: int64;
    begin
      LType := self.FTypes.Item(ATypeId);
      LSlot := 0;
      if LType.Kind = CTypeKind.Named then
        LSlot := self.FTypeNameIds.Find("t" + IntToStr(LType.Index));
      end;
      if LType.Kind = CTypeKind.Record then
        LSlot := self.FTypeNameIds.Find("r" + IntToStr(LType.Index));
      end;
      if LSlot <= 0 then
        return "";
      end;
      return self.FTypeNames[LSlot - 1];
    end;

    // ---- types -----------------------------------------------------------------------------

    // The type of the fundamental kind AKind (one per kind, made once)
    hidden method DoBuiltin(const AKind: CTypeKind): int64;
    var
      LId: int64;
    begin
      LId := self.FBuiltins.Find(CKindText(AKind));
      if LId > 0 then
        return LId - 1;
      end;
      LId := self.FTypes.Add(AKind, ADAM_CIMPORT_NONE);
      self.FBuiltins.Put(CKindText(AKind), LId + 1);
      return LId;
    end;

    // The kind a value of type AId computes as: a typedef looked through, an enum its integer
    // type
    hidden method DoKindOf(const AId: int64): CTypeKind;
    var
      LType: CType;
    begin
      LType := self.FTypes.Item(self.FTypes.Resolved(AId));
      if LType.Kind = CTypeKind.Enum then
        return self.FTypes.EnumAt(LType.Index).Underlying;
      end;
      return LType.Kind;
    end;

    // The size in bytes of the fundamental kind AKind on the target
    hidden method DoSize(const AKind: CTypeKind): int64;
    begin
      return self.FTarget.BuiltinSize(BuiltinName(AKind));
    end;

    hidden method DoSigned(const AKind: CTypeKind): bool;
    begin
      match AKind of
        CTypeKind.SChar, CTypeKind.Short, CTypeKind.Int, CTypeKind.Long, CTypeKind.LongLong:
          return true;
        CTypeKind.Char:
          return self.FTarget.CharSigned();
      else
      end;
      return false;
    end;

    // C's integer conversion rank
    hidden method DoRank(const AKind: CTypeKind): int64;
    begin
      match AKind of
        CTypeKind.Bool: return 1;
        CTypeKind.Char, CTypeKind.SChar, CTypeKind.UChar: return 2;
        CTypeKind.Short, CTypeKind.UShort: return 3;
        CTypeKind.Int, CTypeKind.UInt: return 4;
        CTypeKind.Long, CTypeKind.ULong: return 5;
      else
      end;
      return 6;
    end;

    hidden method DoUnsignedOf(const AKind: CTypeKind): CTypeKind;
    begin
      match AKind of
        CTypeKind.Int: return CTypeKind.UInt;
        CTypeKind.Long: return CTypeKind.ULong;
        CTypeKind.LongLong: return CTypeKind.ULongLong;
      else
      end;
      return AKind;
    end;

    // True for the integer kinds an Adam constant can have (no __int128)
    hidden method DoIsInteger(const AKind: CTypeKind): bool;
    begin
      return IsIntegerKind(AKind) and (BuiltinName(AKind) <> "");
    end;

    hidden method DoIsFloat(const AKind: CTypeKind): bool;
    begin
      return (AKind = CTypeKind.Float) or (AKind = CTypeKind.Double);
    end;

    // C's integer promotion: a kind below int's rank is int (every value fits)
    hidden method DoPromote(const AKind: CTypeKind): CTypeKind;
    begin
      if self.DoRank(AKind) < 4 then
        return CTypeKind.Int;
      end;
      return AKind;
    end;

    // The usual arithmetic conversions of two integer kinds
    hidden method DoCommon(const A: CTypeKind; const B: CTypeKind): CTypeKind;
    var
      LA: CTypeKind;
      LB: CTypeKind;
      LSigned: CTypeKind;
      LUnsigned: CTypeKind;
    begin
      LA := self.DoPromote(A);
      LB := self.DoPromote(B);
      if LA = LB then
        return LA;
      end;
      if self.DoSigned(LA) = self.DoSigned(LB) then
        if self.DoRank(LA) >= self.DoRank(LB) then
          return LA;
        end;
        return LB;
      end;
      if self.DoSigned(LA) then
        LSigned := LA;
        LUnsigned := LB;
      else
        LSigned := LB;
        LUnsigned := LA;
      end;
      if self.DoRank(LUnsigned) >= self.DoRank(LSigned) then
        return LUnsigned;
      end;
      if self.DoSize(LSigned) > self.DoSize(LUnsigned) then
        return LSigned;
      end;
      return self.DoUnsignedOf(LSigned);
    end;

    // AValue's bits as the integer kind AKind holds them (cut to its size, sign-extended for
    // a signed one; a _Bool 0 or 1)
    hidden method DoWrap(const AValue: int64; const AKind: CTypeKind): int64;
    var
      LBits: int64;
      LValue: int64;
    begin
      if AKind = CTypeKind.Bool then
        return int64(AValue <> 0);
      end;
      LBits := self.DoSize(AKind) * 8;
      if (LBits <= 0) or (LBits >= 64) then
        return AValue;
      end;
      LValue := AValue & ((int64(1) << LBits) - 1);
      if self.DoSigned(AKind) and (((LValue >> (LBits - 1)) & 1) <> 0) then
        LValue := LValue - (int64(1) << LBits);
      end;
      return LValue;
    end;

    // True when AValue (exact) is a value of the signed kind AKind
    hidden method DoFitsSigned(const AValue: int64; const AKind: CTypeKind): bool;
    var
      LBits: int64;
    begin
      LBits := self.DoSize(AKind) * 8;
      if LBits >= 64 then
        return true;
      end;
      return (AValue >= 0 - (int64(1) << (LBits - 1))) and (AValue < (int64(1) << (LBits - 1)));
    end;

    // True when the unsigned AValue is at most the largest value of the kind AKind
    hidden method DoFitsKind(const AValue: uint64; const AKind: CTypeKind): bool;
    var
      LBits: int64;
    begin
      LBits := self.DoSize(AKind) * 8;
      if self.DoSigned(AKind) then
        LBits := LBits - 1;
      end;
      if LBits >= 64 then
        return true;
      end;
      return AValue <= (uint64(1) << uint64(LBits)) - 1u;
    end;

    // sizeof's type: the target's __SIZE_TYPE__ read as a type name; ADAM_CIMPORT_NONE when
    // the predefines give none
    hidden method DoSizeType(): int64;
    var
      LMacro: PpMacro;
      LPos: int64;
      LI: int64;
    begin
      if self.FSizeType <> ADAM_CIMPORT_MACRO_UNKNOWN then
        return self.FSizeType;
      end;
      self.FSizeType := ADAM_CIMPORT_NONE;
      for LI := 0 to self.FPre.MacroCount() - 1 do
        LMacro := self.FPre.MacroAt(LI);
        if LMacro.Active and (LMacro.Name = ADAM_CIMPORT_MACRO_SIZE_TYPE) then
          LPos := 0;
          self.FSizeType := self.FParser.TypeNameIn(LMacro.Body, LPos);
          if LPos <> len(LMacro.Body) then
            self.FSizeType := ADAM_CIMPORT_NONE;
          end;
        end;
      end;
      return self.FSizeType;
    end;

    // ---- values ----------------------------------------------------------------------------

    // The first reason the evaluation fails kept; always false (a parse step's result)
    hidden method DoFail(const AWhy: string): bool;
    begin
      if self.FWhy = "" then
        self.FWhy := AWhy;
      end;
      return false;
    end;

    // A fault C forgives where it does not evaluate (?: && ||'s other arm): false (AWhy) only
    // where it is evaluated
    hidden method DoFault(const AWhy: string): bool;
    begin
      if self.FDead > 0 then
        return true;
      end;
      return self.DoFail(AWhy);
    end;

    hidden method DoInt(const AValue: int64; const AKind: CTypeKind): MacroValue;
    var
      LValue: MacroValue;
    begin
      LValue.Kind := MacroValueKind.Int;
      LValue.TypeId := self.DoBuiltin(AKind);
      LValue.Value := AValue;
      LValue.Real := 0.0;
      LValue.Text := "";
      LValue.Spelling := "";
      LValue.IsBool := false;
      LValue.IsPlace := false;
      LValue.Root := -1;
      LValue.Bare := "";
      LValue.Generic := 0;
      return LValue;
    end;

    hidden method DoFloat(const AReal: float64; const AKind: CTypeKind): MacroValue;
    var
      LValue: MacroValue;
    begin
      LValue := self.DoInt(0, AKind);
      LValue.Kind := MacroValueKind.Float;
      LValue.Real := AReal;
      if AKind = CTypeKind.Float then
        LValue.Real := float64(float32(AReal));
      end;
      return LValue;
    end;

    hidden method DoRuntime(const AText: string; const ATypeId: int64; const ABool: bool):
      MacroValue;
    var
      LValue: MacroValue;
    begin
      LValue := self.DoInt(0, CTypeKind.Int);
      LValue.Kind := MacroValueKind.Runtime;
      LValue.TypeId := ATypeId;
      LValue.Text := AText;
      LValue.IsBool := ABool;
      return LValue;
    end;

    // True when AValue is a number (an integer or float constant)
    hidden method DoIsNumber(const AValue: MacroValue): bool;
    begin
      return (AValue.Kind = MacroValueKind.Int) or (AValue.Kind = MacroValueKind.Float);
    end;

    // True when AValue computes as a number (a constant one, or run-time text of a number
    // type)
    hidden method DoIsArithmetic(const AValue: MacroValue): bool;
    var
      LKind: CTypeKind;
    begin
      if self.DoIsNumber(AValue) then
        return true;
      end;
      if AValue.Kind <> MacroValueKind.Runtime then
        return false;
      end;
      if AValue.IsBool then
        return true;
      end;
      LKind := self.DoKindOf(AValue.TypeId);
      return self.DoIsInteger(LKind) or self.DoIsFloat(LKind);
    end;

    // The kind AValue computes as (a run-time bool's C type is its own: int or _Bool)
    hidden method DoValueKind(const AValue: MacroValue): CTypeKind;
    begin
      return self.DoKindOf(AValue.TypeId);
    end;

    // The number AValue converted to the arithmetic kind AKind as C converts it; false (the
    // reason kept) when a float does not fit the integer kind
    hidden method DoConvert(var AValue: MacroValue; const AKind: CTypeKind): bool;
    var
      LFrom: CTypeKind;
      LReal: float64;
    begin
      LFrom := self.DoValueKind(AValue);
      if AValue.Kind = MacroValueKind.Int then
        if self.DoIsFloat(AKind) then
          if self.DoSigned(LFrom) or (AValue.Value >= 0) then
            LReal := float64(AValue.Value);
          else
            LReal := float64(uint64(AValue.Value));
          end;
          AValue := self.DoFloat(LReal, AKind);
          return true;
        end;
        AValue := self.DoInt(self.DoWrap(AValue.Value, AKind), AKind);
        return true;
      end;
      if AValue.Kind = MacroValueKind.Float then
        if self.DoIsFloat(AKind) then
          if AKind <> LFrom then
            AValue.Spelling := "";
          end;
          LReal := AValue.Real;
          AValue := self.DoFloat(LReal, AKind);
          return true;
        end;
        // a float to an integer: truncated; a value the kind does not hold is no constant
        if AKind = CTypeKind.Bool then
          AValue := self.DoInt(int64(AValue.Real <> 0.0), AKind);
          return true;
        end;
        if not (AValue.Real > -9223372036854775808.0) or not (AValue.Real < 9223372036854775808.0) then
          return self.DoFault(NoArgs().Str(CKindText(AKind)).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_OVERFLOW));
        end;
        LReal := AValue.Real;
        AValue := self.DoInt(int64(LReal), AKind);
        if self.DoSigned(AKind) and not self.DoFitsSigned(AValue.Value, AKind) then
          return self.DoFault(NoArgs().Str(CKindText(AKind)).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_OVERFLOW));
        end;
        AValue.Value := self.DoWrap(AValue.Value, AKind);
        return true;
      end;
      return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
    end;

    // The Adam text of the constant AValue (see the header); "" (the reason kept) when Adam
    // has no literal for it
    hidden method DoConstText(const AValue: MacroValue): string;
    var
      LKind: CTypeKind;
      LText: string;
      LSuffix: string;
    begin
      LKind := self.DoValueKind(AValue);
      if AValue.Kind = MacroValueKind.Int then
        if LKind = CTypeKind.Bool then
          if AValue.Value <> 0 then
            return "true";
          end;
          return "false";
        end;
        if LKind = CTypeKind.Char then
          if (AValue.Value & 255) = 39 then
            return "'\\''";
          end;
          return "'" + DoByteText(AValue.Value & 255) + "'";
        end;
        if self.DoSigned(LKind) then
          if AValue.Value = ADAM_CIMPORT_MACRO_INT64_MIN then
            return ADAM_CIMPORT_MACRO_INT64_MIN_TEXT;
          end;
          return IntToStr(AValue.Value);
        end;
        if uint64(AValue.Value) > ADAM_CIMPORT_MACRO_INT64_MAX then
          return UIntToStr(uint64(AValue.Value)) + "u";
        end;
        return UIntToStr(uint64(AValue.Value));
      end;
      if AValue.Kind = MacroValueKind.Float then
        LText := AValue.Spelling;
        if LText = "" then
          LText := FloatToStr(AValue.Real);
        end;
        // no Adam literal is an infinity or a NaN: the constant division that is one
        LSuffix := "";
        if LKind = CTypeKind.Float then
          LSuffix := "f";
        end;
        if IndexOf("nan", LowerCase(LText), 0) >= 0 then
          return "0.0" + LSuffix + " / 0.0" + LSuffix;
        end;
        if IndexOf("inf", LowerCase(LText), 0) >= 0 then
          if AValue.Real < 0.0 then
            return "-1.0" + LSuffix + " / 0.0" + LSuffix;
          end;
          return "1.0" + LSuffix + " / 0.0" + LSuffix;
        end;
        if not DoHasFloatMark(LText) then
          LText := LText + ".0";
        end;
        if LKind = CTypeKind.Float then
          LText := LText + "f";
        end;
        return LText;
      end;
      // a string's (and a compound literal's) Adam text is made when it is read
      return AValue.Text;
    end;

    // AValue as Adam text of the arithmetic kind AKind: a constant converted and written, a
    // run-time value cast where its kind is another (a bool as 0 / 1)
    hidden method DoArithText(const AValue: MacroValue; const AKind: CTypeKind): string;
    var
      LValue: MacroValue;
    begin
      if self.DoIsNumber(AValue) then
        LValue := AValue;
        if not self.DoConvert(LValue, AKind) then
          return "";
        end;
        return DoOperand(self.DoConstText(LValue));
      end;
      if AKind = CTypeKind.Bool then
        return self.DoBoolText(AValue);
      end;
      // a type parameter's value is of a type only its instance knows: always cast
      if AValue.IsBool or (AValue.Generic > 0) or (self.DoValueKind(AValue) <> AKind) then
        return BuiltinName(AKind) + "(" + AValue.Text + ")";
      end;
      return AValue.Text;
    end;

    // AValue as an Adam bool's text (C's test against 0)
    hidden method DoBoolText(const AValue: MacroValue): string;
    begin
      if self.DoIsNumber(AValue) then
        if ((AValue.Kind = MacroValueKind.Int) and (AValue.Value <> 0)) or
          ((AValue.Kind = MacroValueKind.Float) and (AValue.Real <> 0.0)) then
          return "true";
        end;
        return "false";
      end;
      if AValue.IsBool then
        return AValue.Text;
      end;
      if self.DoIsPointer(AValue) then
        return "(" + AValue.Text + " <> nil)";
      end;
      return "(" + AValue.Text + " <> 0)";
    end;

    // True when AValue is a run-time pointer (nil a null pointer constant)
    hidden method DoIsPointer(const AValue: MacroValue): bool;
    begin
      return (AValue.Kind = MacroValueKind.Runtime) and
        (self.FTypes.Item(self.FTypes.Resolved(AValue.TypeId)).Kind = CTypeKind.Pointer);
    end;

    // True when C tests AValue as a condition (a number, or a pointer against nil)
    hidden method DoIsTestable(const AValue: MacroValue): bool;
    begin
      return self.DoIsArithmetic(AValue) or self.DoIsPointer(AValue);
    end;

    // True when the type AId is const (itself or a typedef name it is reached through)
    hidden method DoIsConst(const AId: int64): bool;
    var
      LId: int64;
    begin
      LId := AId;
      while true do
        if self.FTypes.Item(LId).IsConst then
          return true;
        end;
        if self.FTypes.Item(LId).Kind <> CTypeKind.Named then
          leave;
        end;
        LId := self.FTypes.Item(LId).Base;
      end;
      return false;
    end;

    // The type pointer to ABase (one per pointee)
    hidden method DoPointerTo(const ABase: int64): int64;
    var
      LId: int64;
    begin
      LId := self.FPointers.Find(ABase);
      if LId >= 0 then
        return LId;
      end;
      LId := self.FTypes.Add(CTypeKind.Pointer, ABase);
      self.FPointers.Put(ABase, LId);
      return LId;
    end;

    // AText as the operand of a postfix operator (-> . [] ^): as it is when it is a name, a
    // postfix chain on one (a call, a field, an element, a dereference) or a group in
    // parentheses; else in parentheses
    hidden method DoGroup(const AText: string): string;
    var
      LDepth: int64;
      LChar: char;
      LI: int64;
    begin
      LDepth := 0;
      for LI := 0 to len(AText) - 1 do
        LChar := AText[LI];
        if (LChar = '(') or (LChar = '[') then
          LDepth := LDepth + 1;
          skip;
        end;
        if (LChar = ')') or (LChar = ']') then
          LDepth := LDepth - 1;
          skip;
        end;
        if LDepth > 0 then
          skip;
        end;
        if ((LChar >= 'a') and (LChar <= 'z')) or ((LChar >= 'A') and (LChar <= 'Z')) or
          ((LChar >= '0') and (LChar <= '9')) or (LChar = '_') or (LChar = '.') or
          (LChar = '^') then
          skip;
        end;
        // -> only, never a minus or a comparison
        if (LChar = '-') and (LI > 0) and (LI + 1 < len(AText)) and (AText[LI + 1] = '>') then
          skip;
        end;
        if (LChar = '>') and (LI > 0) and (AText[LI - 1] = '-') then
          skip;
        end;
        return "(" + AText + ")";
      end;
      return AText;
    end;

    // True when the constant AValue is not 0
    hidden method DoTrue(const AValue: MacroValue): bool;
    begin
      if AValue.Kind = MacroValueKind.Float then
        return AValue.Real <> 0.0;
      end;
      return AValue.Value <> 0;
    end;

    // ---- tokens ----------------------------------------------------------------------------

    hidden method DoTok(): PpToken;
    var
      LTok: PpToken;
    begin
      if self.FPos < len(self.FToks) then
        return self.FToks[self.FPos];
      end;
      LTok.Kind := PpKind.EndOfFile;
      LTok.Text := "";
      LTok.File := -1;
      LTok.Line := 0;
      LTok.Column := 0;
      LTok.Space := false;
      LTok.LineStart := true;
      LTok.Hide := 0;
      return LTok;
    end;

    hidden method DoIs(const AText: string): bool;
    var
      LTok: PpToken;
    begin
      LTok := self.DoTok();
      return ((LTok.Kind = PpKind.Punct) or (LTok.Kind = PpKind.Identifier)) and
        (LTok.Text = AText);
    end;

    hidden method DoNext();
    begin
      if self.FPos < len(self.FToks) then
        self.FPos := self.FPos + 1;
      end;
    end;

    hidden method DoExpect(const AText: string): bool;
    begin
      if self.DoIs(AText) then
        self.DoNext();
        return true;
      end;
      return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
    end;

    // The type name the body's token at FPos starts (TypeNameIn), ADAM_CIMPORT_NONE when none
    // does: a function-like macro's parameter is its argument wherever it stands, never a
    // type word, even one spelled as a C keyword (SDL_DEFINE_AUDIO_FORMAT's `signed`)
    hidden method DoTypeNameHere(): int64;
    begin
      if (self.FPos < len(self.FToks)) and ((self.DoParamIndex(self.FToks[self.FPos].Text) >= 0) or
        (self.DoLocalIndex(self.FToks[self.FPos].Text) >= 0)) then
        return ADAM_CIMPORT_NONE;
      end;
      return self.FParser.TypeNameIn(self.FToks, self.FPos);
    end;

    // The parameter AName's index; -1 when it is none (or the macro is object-like)
    hidden method DoParamIndex(const AName: string): int64;
    var
      LI: int64;
    begin
      if not self.FFunction then
        return -1;
      end;
      for LI := 0 to len(self.FParams) - 1 do
        if self.FParams[LI] = AName then
          return LI;
        end;
      end;
      return -1;
    end;

    // The body's local AName known here (the innermost); -1 when it is none
    hidden method DoLocalIndex(const AName: string): int64;
    var
      LI: int64;
    begin
      if not self.FBody then
        return -1;
      end;
      for LI := self.FLocalCount - 1 downto 0 do
        if self.FLocalNames[LI] = AName then
          return LI;
        end;
      end;
      return -1;
    end;

    // ---- expressions (C's grammar) ---------------------------------------------------------

    // An assignment expression: a conditional one, or a place, an assignment operator and an
    // assignment expression
    hidden method DoAssign(var AValue: MacroValue): bool;
    var
      LTok: PpToken;
      LRight: MacroValue;
      LBefore: int64;
      LPure: bool;
    begin
      LBefore := self.FEffects;
      if not self.DoExpr(AValue) then
        return false;
      end;
      LTok := self.DoTok();
      if (LTok.Kind <> PpKind.Punct) or not self.DoIsAssignOp(LTok.Text) then
        return true;
      end;
      LPure := self.FEffects = LBefore;
      self.DoNext();
      if not self.DoAssign(LRight) then
        return false;
      end;
      return self.DoAssignTo(LTok.Text, LPure, AValue, LRight);
    end;

    hidden method DoIsAssignOp(const AText: string): bool;
    begin
      match AText of
        "=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>=":
          return true;
      else
      end;
      return false;
    end;

    // AValue as a place that is written (assigned, stepped, its address taken): false (the
    // reason kept) when it is none, or is a macro's parameter itself (its caller's own
    // expression in C); a body's local is marked written
    hidden method DoWrite(const AValue: MacroValue): bool;
    begin
      if not AValue.IsPlace then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_NO_PLACE);
      end;
      if AValue.Root >= 0 then
        if not self.FBody then
          return self.DoFail(NoArgs().Str(self.FParams[AValue.Root]).Fill(
            ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_PARAM_PLACE));
        end;
        self.FLocalWritten[AValue.Root] := 1;
      end;
      return true;
    end;

    // The value of an assignment or a step of the place ATarget, written AText
    hidden method DoStored(const ATarget: MacroValue; const AText: string): MacroValue;
    var
      LValue: MacroValue;
    begin
      LValue := self.DoRuntime("(" + AText + ")", ATarget.TypeId,
        self.DoKindOf(ATarget.TypeId) = CTypeKind.Bool);
      LValue.Bare := AText;
      return LValue;
    end;

    // AValue AOp ARight for the assignment operator AOp; APure: AValue has no side effect
    // (see the header)
    hidden method DoAssignTo(const AOp: string; const APure: bool; var AValue: MacroValue;
      const ARight: MacroValue): bool;
    var
      LTarget: MacroValue;
      LValue: MacroValue;
      LOp: string;
      LKind: CTypeKind;
      LRightKind: CTypeKind;
      LText: string;
    begin
      if not self.DoWrite(AValue) then
        return false;
      end;
      self.FEffects := self.FEffects + 1;
      LTarget := AValue;
      if AOp = "=" then
        LText := self.DoArgText(ARight, LTarget.TypeId);
        if LText = "" then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
        AValue := self.DoStored(LTarget, LTarget.Text + " := " + LText);
        return self.FWhy = "";
      end;
      LOp := Substring(AOp, 0, len(AOp) - 1);
      LKind := self.DoKindOf(LTarget.TypeId);
      if not (self.DoIsInteger(LKind) or self.DoIsFloat(LKind)) or (LKind = CTypeKind.Bool) or
        not self.DoIsArithmetic(ARight) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      LRightKind := self.DoValueKind(ARight);
      // Adam's own compound form where it computes as C's does: a shift (its count not
      // converted); + - * & | of integers (C's result cut to the target equals the value cut
      // first); any other where the operands meet at the target's own type
      LText := "";
      if (LOp = "<<") or (LOp = ">>") then
        if self.DoIsFloat(LKind) or self.DoIsFloat(LRightKind) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
        LText := self.DoArithText(ARight, self.DoPromote(LRightKind));
      else
        if self.DoIsInteger(LKind) and not self.DoIsFloat(LRightKind) and ((LOp = "+") or
          (LOp = "-") or (LOp = "*") or (LOp = "&") or (LOp = "|")) then
          LText := self.DoArithText(ARight, LKind);
        end;
        if (LText = "") and (LOp <> "^") and not ((LOp = "/") and self.DoIsInteger(LKind)) and
          (self.DoArmsKind(LTarget, ARight) = LKind) then
          LText := self.DoArithText(ARight, LKind);
        end;
      end;
      if self.FWhy <> "" then
        return false;
      end;
      if LText <> "" then
        AValue := self.DoStored(LTarget, LTarget.Text + " " + AOp + " " + LText);
        return true;
      end;
      // X := T(X op v): X is read again, so it may have no side effect
      if not APure then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_TWICE);
      end;
      LValue := LTarget;
      if not self.DoApply(LOp, LValue, ARight) then
        return false;
      end;
      LText := self.DoArgText(LValue, LTarget.TypeId);
      if LText = "" then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      AValue := self.DoStored(LTarget, LTarget.Text + " := " + LText);
      return self.FWhy = "";
    end;

    // ++ / -- (AOp) of the place AValue, before it (APrefix: the new value) or after it
    hidden method DoStep(const AOp: string; const APrefix: bool; var AValue: MacroValue): bool;
    var
      LKind: CTypeKind;
    begin
      if not self.DoWrite(AValue) then
        return false;
      end;
      LKind := self.DoKindOf(AValue.TypeId);
      if not self.DoIsInteger(LKind) or (LKind = CTypeKind.Bool) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      self.FEffects := self.FEffects + 1;
      if APrefix then
        AValue := self.DoStored(AValue, AOp + AValue.Text);
      else
        AValue := self.DoStored(AValue, AValue.Text + AOp);
      end;
      return true;
    end;

    // A postfix expression: a primary, then -> . [] ++ -- in turn
    hidden method DoPostfix(var AValue: MacroValue): bool;
    var
      LTok: PpToken;
      LIndex: MacroValue;
      LName: string;
    begin
      if not self.DoPrimary(AValue) then
        return false;
      end;
      while true do
        LTok := self.DoTok();
        if LTok.Kind <> PpKind.Punct then
          leave;
        end;
        if (LTok.Text = "->") or (LTok.Text = ".") then
          self.DoNext();
          if self.DoTok().Kind <> PpKind.Identifier then
            return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
          end;
          LName := self.DoTok().Text;
          self.DoNext();
          if not self.DoMember(LTok.Text = "->", LName, AValue) then
            return false;
          end;
          skip;
        end;
        if LTok.Text = "[" then
          self.DoNext();
          if not self.DoAssign(LIndex) then
            return false;
          end;
          if not self.DoExpect("]") then
            return false;
          end;
          if not self.DoIndex(LIndex, AValue) then
            return false;
          end;
          skip;
        end;
        if (LTok.Text = "++") or (LTok.Text = "--") then
          self.DoNext();
          if not self.DoStep(LTok.Text, false, AValue) then
            return false;
          end;
          skip;
        end;
        leave;
      end;
      return true;
    end;

    // How a report names a struct or union: its tag, else its kind
    hidden method DoRecordSpelling(const ARecord: CRecord): string;
    begin
      if ARecord.Tag <> "" then
        return ARecord.Tag;
      end;
      if ARecord.IsUnion then
        return "union";
      end;
      return "struct";
    end;

    // AValue's field AName (AArrow: through the pointer AValue, ->); the field of a const
    // struct or union is const
    hidden method DoMember(const AArrow: bool; const AName: string; var AValue: MacroValue): bool;
    var
      LType: CType;
      LRecord: CRecord;
      LConst: bool;
      LTypeId: int64;
      LText: string;
      LPlace: bool;
      LRoot: int64;
      LFound: int64;
      LI: int64;
    begin
      if AValue.Generic > 0 then
        return self.DoGenericUse(AValue);
      end;
      if AValue.Kind <> MacroValueKind.Runtime then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      LType := self.FTypes.Item(self.FTypes.Resolved(AValue.TypeId));
      LConst := self.DoIsConst(AValue.TypeId);
      if AArrow then
        if LType.Kind <> CTypeKind.Pointer then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_DEREF);
        end;
        LConst := self.DoIsConst(LType.Base);
        LType := self.FTypes.Item(self.FTypes.Resolved(LType.Base));
      end;
      if LType.Kind <> CTypeKind.Record then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      LRecord := self.FTypes.RecordAt(LType.Index);
      LFound := -1;
      if LRecord.Complete then
        for LI := 0 to len(LRecord.Fields) - 1 do
          if LRecord.Fields[LI].Name = AName then
            LFound := LI;
          end;
        end;
      end;
      if LFound < 0 then
        return self.DoFail(NoArgs().Str(AName).Str(self.DoRecordSpelling(LRecord)).Fill(
          ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_FIELD));
      end;
      LTypeId := LRecord.Fields[LFound].TypeId;
      if LConst then
        LTypeId := self.FTypes.Qualified(LTypeId, true, false, false);
      end;
      if AArrow then
        LText := self.DoGroup(AValue.Text) + "->" + DoLocalName(AName);
        LPlace := true;
        LRoot := -1;
      else
        LText := self.DoGroup(AValue.Text) + "." + DoLocalName(AName);
        LPlace := AValue.IsPlace;
        LRoot := AValue.Root;
      end;
      AValue := self.DoRuntime(LText, LTypeId, self.DoKindOf(LTypeId) = CTypeKind.Bool);
      AValue.IsPlace := LPlace;
      AValue.Root := LRoot;
      return true;
    end;

    // AValue[AIndex]: an element of a typed pointer or an array (of a const array, const)
    hidden method DoIndex(const AIndex: MacroValue; var AValue: MacroValue): bool;
    var
      LType: CType;
      LElement: int64;
      LKind: CTypeKind;
      LText: string;
      LPlace: bool;
      LRoot: int64;
    begin
      if AValue.Generic > 0 then
        return self.DoGenericUse(AValue);
      end;
      if AValue.Kind <> MacroValueKind.Runtime then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_DEREF);
      end;
      LType := self.FTypes.Item(self.FTypes.Resolved(AValue.TypeId));
      if (LType.Kind <> CTypeKind.Pointer) and (LType.Kind <> CTypeKind.Array) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_DEREF);
      end;
      LElement := LType.Base;
      LKind := self.FTypes.Item(self.FTypes.Resolved(LElement)).Kind;
      if (LKind = CTypeKind.Void) or (LKind = CTypeKind.Function) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_DEREF);
      end;
      if not self.DoIsArithmetic(AIndex) or self.DoIsFloat(self.DoValueKind(AIndex)) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      LText := self.DoGroup(AValue.Text) + "[" +
        self.DoArithText(AIndex, self.DoPromote(self.DoValueKind(AIndex))) + "]";
      if LType.Kind = CTypeKind.Pointer then
        LPlace := true;
        LRoot := -1;
      else
        if self.DoIsConst(AValue.TypeId) then
          LElement := self.FTypes.Qualified(LElement, true, false, false);
        end;
        LPlace := AValue.IsPlace;
        LRoot := AValue.Root;
      end;
      AValue := self.DoRuntime(LText, LElement, self.DoKindOf(LElement) = CTypeKind.Bool);
      AValue.IsPlace := LPlace;
      AValue.Root := LRoot;
      return self.FWhy = "";
    end;

    // *AValue: what a typed pointer points to (Adam's P^; of an array its first element)
    hidden method DoDeref(var AValue: MacroValue): bool;
    var
      LType: CType;
      LKind: CTypeKind;
      LZero: MacroValue;
      LBase: int64;
    begin
      if AValue.Generic > 0 then
        return self.DoGenericUse(AValue);
      end;
      if AValue.Kind <> MacroValueKind.Runtime then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_DEREF);
      end;
      LType := self.FTypes.Item(self.FTypes.Resolved(AValue.TypeId));
      if LType.Kind = CTypeKind.Array then
        LZero := self.DoInt(0, CTypeKind.Int);
        return self.DoIndex(LZero, AValue);
      end;
      if LType.Kind <> CTypeKind.Pointer then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_DEREF);
      end;
      LBase := LType.Base;
      LKind := self.FTypes.Item(self.FTypes.Resolved(LBase)).Kind;
      if (LKind = CTypeKind.Void) or (LKind = CTypeKind.Function) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_DEREF);
      end;
      AValue := self.DoRuntime(self.DoGroup(AValue.Text) + "^", LBase,
        self.DoKindOf(LBase) = CTypeKind.Bool);
      AValue.IsPlace := true;
      AValue.Root := -1;
      return true;
    end;

    // &AValue: the place's address (Adam's addr of), a pointer to its type
    hidden method DoAddress(var AValue: MacroValue): bool;
    begin
      if not self.DoWrite(AValue) then
        return false;
      end;
      AValue := self.DoRuntime("addr of " + AValue.Text, self.DoPointerTo(AValue.TypeId), false);
      return true;
    end;

    // A pointer operand of == / != as Adam text: a pointer's own, nil for a null pointer
    // constant (an integer constant 0); "" for anything else
    hidden method DoPointerSide(const AValue: MacroValue): string;
    begin
      if self.DoIsPointer(AValue) then
        return AValue.Text;
      end;
      if (AValue.Kind = MacroValueKind.Int) and (AValue.Value = 0) then
        return "nil";
      end;
      return "";
    end;

    // True when the pointers A and B compare in Adam: one pointee, one of them void
    hidden method DoComparable(const A: MacroValue; const B: MacroValue): bool;
    var
      LA: CType;
      LB: CType;
    begin
      if not self.DoIsPointer(A) or not self.DoIsPointer(B) then
        return true;
      end;
      LA := self.FTypes.Item(self.FTypes.Resolved(A.TypeId));
      LB := self.FTypes.Item(self.FTypes.Resolved(B.TypeId));
      if (self.FTypes.Item(self.FTypes.Resolved(LA.Base)).Kind = CTypeKind.Void) or
        (self.FTypes.Item(self.FTypes.Resolved(LB.Base)).Kind = CTypeKind.Void) then
        return true;
      end;
      return self.DoSamePointee(LA.Base, LB.Base) or self.DoSamePointee(LB.Base, LA.Base);
    end;

    // AValue == / != ARight (AOp) where a side is a pointer: an Adam bool
    hidden method DoPointerCompare(const AOp: string; var AValue: MacroValue;
      const ARight: MacroValue): bool;
    var
      LLeft: string;
      LRight: string;
      LAdam: string;
    begin
      LLeft := self.DoPointerSide(AValue);
      LRight := self.DoPointerSide(ARight);
      if (LLeft = "") or (LRight = "") or not self.DoComparable(AValue, ARight) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      LAdam := " = ";
      if AOp = "!=" then
        LAdam := " <> ";
      end;
      AValue := self.DoRuntime("(" + LLeft + LAdam + LRight + ")", self.DoBuiltin(CTypeKind.Int),
        true);
      return true;
    end;

    // ---- type parameters (M9k) -------------------------------------------------------------

    // The group of the parameter AParam (its union-find root)
    hidden method DoGroupOf(const AParam: int64): int64;
    var
      LParam: int64;
    begin
      LParam := AParam;
      while self.FGroups[LParam] <> LParam do
        // path halving: each step also points the parameter at its grandparent
        self.FGroups[LParam] := self.FGroups[self.FGroups[LParam]];
        LParam := self.FGroups[LParam];
      end;
      return LParam;
    end;

    // One group for the type parameter values' groups A and B (their Generic): the lower
    // parameter's root stays, so the type parameters come in the parameters' order
    hidden method DoJoin(const A: int64; const B: int64);
    var
      LA: int64;
      LB: int64;
    begin
      LA := self.DoGroupOf(A - 1);
      LB := self.DoGroupOf(B - 1);
      if LA < LB then
        self.FGroups[LB] := LA;
      end;
      if LB < LA then
        self.FGroups[LA] := LB;
      end;
    end;

    // The run-time AText of a type parameter's value, of the group AGeneric (Generic's
    // encoding)
    hidden method DoGenericValue(const AText: string; const AGeneric: int64): MacroValue;
    var
      LValue: MacroValue;
    begin
      LValue := self.DoRuntime(AText, self.DoBuiltin(CTypeKind.Int), false);
      LValue.Generic := AGeneric;
      return LValue;
    end;

    // false with the reason a field, an element, a pointee, the size, a pointer cast or a
    // variadic argument of the type parameter's value AValue has no form: its C type is the
    // use's
    hidden method DoGenericUse(const AValue: MacroValue): bool;
    begin
      return self.DoFail(NoArgs().Str(self.FParams[AValue.Generic - 1]).Fill(
        ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_GENERIC_USE));
    end;

    // AOther, an operand beside the type parameter's value AGeneric, as Adam text: an integer
    // constant written bare, so it takes the type parameter's type at each instance (a _Bool
    // or char one as its promoted int); "" with the reason for anything else (a typed run-time
    // value, a float: C converts the two by the argument's type, which only a use knows)
    hidden method DoBesideText(const AOther: MacroValue; const AGeneric: MacroValue): string;
    var
      LValue: MacroValue;
    begin
      if AOther.Kind = MacroValueKind.Int then
        LValue := AOther;
        if not self.DoConvert(LValue, self.DoPromote(self.DoValueKind(LValue))) then
          return "";
        end;
        return DoOperand(self.DoConstText(LValue));
      end;
      self.DoFail(NoArgs().Str(self.FParams[AGeneric.Generic - 1]).Str(
        CKindText(self.DoValueKind(AOther))).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_GENERIC_MIX));
      return "";
    end;

    // AValue := AValue op ARight, one side or both a type parameter's value (see the header):
    // two of them join one group, one beside an integer constant keeps its group; the result
    // is the type parameter's (a comparison an Adam bool of C's int). A shift keeps its left
    // operand's type: a typed one shifted by a type parameter's value is that type promoted,
    // as C's, and a type parameter's value is shifted by any integer count
    hidden method DoGenericApply(const AOp: string; var AValue: MacroValue;
      const ARight: MacroValue): bool;
    var
      LLeft: string;
      LRight: string;
      LAdam: string;
      LText: string;
      LKind: CTypeKind;
      LGeneric: int64;
      LShift: bool;
    begin
      LShift := (AOp = "<<") or (AOp = ">>");
      LAdam := AOp;
      match AOp of
        "^": LAdam := "xor";
        "==": LAdam := "=";
        "!=": LAdam := "<>";
        "/": LAdam := "div";
        "%": LAdam := "mod";
      else
      end;
      if LShift and (AValue.Generic = 0) then
        if self.DoIsFloat(self.DoValueKind(AValue)) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
        LKind := self.DoPromote(self.DoValueKind(AValue));
        LLeft := self.DoArithText(AValue, LKind);
        // a constant shifted by a run-time count is typed, so the result is
        if self.DoIsNumber(AValue) then
          LLeft := BuiltinName(LKind) + "(" + LLeft + ")";
        end;
        AValue := self.DoRuntime("(" + LLeft + " " + LAdam + " " + ARight.Text + ")",
          self.DoBuiltin(LKind), false);
        return self.FWhy = "";
      end;
      LGeneric := AValue.Generic;
      LLeft := AValue.Text;
      LRight := ARight.Text;
      if (AValue.Generic > 0) and (ARight.Generic > 0) then
        // a shift's count is no operand of its type
        if not LShift then
          self.DoJoin(AValue.Generic, ARight.Generic);
        end;
      else
        if AValue.Generic = 0 then
          LGeneric := ARight.Generic;
          LLeft := self.DoBesideText(AValue, ARight);
        else
          if LShift and (ARight.Kind = MacroValueKind.Runtime) and
            not self.DoIsFloat(self.DoValueKind(ARight)) then
            LRight := self.DoArithText(ARight, self.DoPromote(self.DoValueKind(ARight)));
          else
            LRight := self.DoBesideText(ARight, AValue);
          end;
        end;
        if (LLeft = "") or (LRight = "") then
          return false;
        end;
      end;
      LText := "(" + LLeft + " " + LAdam + " " + LRight + ")";
      if (AOp = "==") or (AOp = "!=") or (AOp = "<") or (AOp = ">") or (AOp = "<=") or
        (AOp = ">=") then
        AValue := self.DoRuntime(LText, self.DoBuiltin(CTypeKind.Int), true);
        return self.FWhy = "";
      end;
      AValue := self.DoGenericValue(LText, LGeneric);
      return self.FWhy = "";
    end;

    // ACond ? AThen : AElse with an arm a type parameter's value: two of them join one group,
    // one beside an integer constant keeps its group; the type parameter's type
    hidden method DoGenericArms(var ACond: MacroValue; const AThen: MacroValue;
      const AElse: MacroValue): bool;
    var
      LThen: string;
      LElse: string;
      LGeneric: int64;
    begin
      LGeneric := AThen.Generic;
      LThen := AThen.Text;
      LElse := AElse.Text;
      if (AThen.Generic > 0) and (AElse.Generic > 0) then
        self.DoJoin(AThen.Generic, AElse.Generic);
      else
        if AThen.Generic = 0 then
          LGeneric := AElse.Generic;
          LThen := self.DoBesideText(AThen, AElse);
        else
          LElse := self.DoBesideText(AElse, AThen);
        end;
        if (LThen = "") or (LElse = "") then
          return false;
        end;
      end;
      ACond := self.DoGenericValue("(" + self.DoBoolText(ACond) + " ? " + LThen + " : " + LElse +
        ")", LGeneric);
      return self.FWhy = "";
    end;

    hidden method DoExpr(var AValue: MacroValue): bool;
    var
      LThen: MacroValue;
      LElse: MacroValue;
      LKind: CTypeKind;
      LTaken: bool;
    begin
      if not self.DoBinary(0, AValue) then
        return false;
      end;
      if not self.DoIs("?") then
        return true;
      end;
      self.DoNext();
      if self.DoIsNumber(AValue) then
        LTaken := self.DoTrue(AValue);
        if not LTaken then
          self.FDead := self.FDead + 1;
        end;
        if not self.DoAssign(LThen) then
          return false;
        end;
        if not LTaken then
          self.FDead := self.FDead - 1;
        end;
        if not self.DoExpect(":") then
          return false;
        end;
        if LTaken then
          self.FDead := self.FDead + 1;
        end;
        if not self.DoExpr(LElse) then
          return false;
        end;
        if LTaken then
          self.FDead := self.FDead - 1;
        end;
        if not self.DoIsNumber(LThen) or not self.DoIsNumber(LElse) then
          return self.DoArmsText(AValue, LThen, LElse);
        end;
        LKind := self.DoArmsKind(LThen, LElse);
        if LTaken then
          AValue := LThen;
        else
          AValue := LElse;
        end;
        return self.DoConvert(AValue, LKind);
      end;
      if not self.DoAssign(LThen) then
        return false;
      end;
      if not self.DoExpect(":") then
        return false;
      end;
      if not self.DoExpr(LElse) then
        return false;
      end;
      return self.DoArmsText(AValue, LThen, LElse);
    end;

    // The common kind of two arithmetic arms
    hidden method DoArmsKind(const AThen: MacroValue; const AElse: MacroValue): CTypeKind;
    var
      LThen: CTypeKind;
      LElse: CTypeKind;
    begin
      LThen := self.DoValueKind(AThen);
      LElse := self.DoValueKind(AElse);
      if self.DoIsFloat(LThen) or self.DoIsFloat(LElse) then
        if (LThen = CTypeKind.Double) or (LElse = CTypeKind.Double) then
          return CTypeKind.Double;
        end;
        return CTypeKind.Float;
      end;
      return self.DoCommon(LThen, LElse);
    end;

    // ACond ? AThen : AElse evaluated at run time (Adam's ?:, both arms of their common kind)
    hidden method DoArmsText(var ACond: MacroValue; const AThen: MacroValue;
      const AElse: MacroValue): bool;
    var
      LKind: CTypeKind;
      LText: string;
    begin
      if not self.DoIsTestable(ACond) or not self.DoIsArithmetic(AThen) or
        not self.DoIsArithmetic(AElse) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      if (AThen.Generic > 0) or (AElse.Generic > 0) then
        return self.DoGenericArms(ACond, AThen, AElse);
      end;
      LKind := self.DoArmsKind(AThen, AElse);
      LText := "(" + self.DoBoolText(ACond) + " ? " + self.DoArithText(AThen, LKind) + " : " +
        self.DoArithText(AElse, LKind) + ")";
      ACond := self.DoRuntime(LText, self.DoBuiltin(LKind), false);
      return self.FWhy = "";
    end;

    // The binding strength of the binary operator at the cursor (C's: 1 || .. 10 * / %); 0
    // for none
    hidden method DoPrecedence(): int64;
    var
      LTok: PpToken;
    begin
      LTok := self.DoTok();
      if LTok.Kind <> PpKind.Punct then
        return 0;
      end;
      match LTok.Text of
        "||": return 1;
        "&&": return 2;
        "|": return 3;
        "^": return 4;
        "&": return 5;
        "==", "!=": return 6;
        "<", ">", "<=", ">=": return 7;
        "<<", ">>": return 8;
        "+", "-": return 9;
        "*", "/", "%": return 10;
      end;
      return 0;
    end;

    // A binary expression whose operators bind tighter than AMin (precedence climbing); the
    // right side of && / || C does not evaluate when the left one decides
    hidden method DoBinary(const AMin: int64; var AValue: MacroValue): bool;
    var
      LPrec: int64;
      LOp: string;
      LRight: MacroValue;
      LDead: bool;
    begin
      if not self.DoUnary(AValue) then
        return false;
      end;
      while true do
        LPrec := self.DoPrecedence();
        if LPrec <= AMin then
          leave;
        end;
        LOp := self.DoTok().Text;
        self.DoNext();
        LDead := false;
        if self.DoIsNumber(AValue) and (((LOp = "&&") and not self.DoTrue(AValue)) or
          ((LOp = "||") and self.DoTrue(AValue))) then
          LDead := true;
          self.FDead := self.FDead + 1;
        end;
        if not self.DoBinary(LPrec, LRight) then
          return false;
        end;
        if LDead then
          self.FDead := self.FDead - 1;
        end;
        if not self.DoApply(LOp, AValue, LRight) then
          return false;
        end;
      end;
      return true;
    end;

    // AValue := AValue op ARight (see the header)
    hidden method DoApply(const AOp: string; var AValue: MacroValue; const ARight: MacroValue):
      bool;
    var
      LKind: CTypeKind;
      LLeft: MacroValue;
      LRight: MacroValue;
      LFloat: bool;
      LCompare: bool;
      LAdam: string;
    begin
      if (AOp = "&&") or (AOp = "||") then
        if not self.DoIsTestable(AValue) or not self.DoIsTestable(ARight) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
      else
        if ((AOp = "==") or (AOp = "!=")) and (self.DoIsPointer(AValue) or self.DoIsPointer(ARight)) then
          return self.DoPointerCompare(AOp, AValue, ARight);
        end;
        if not self.DoIsArithmetic(AValue) or not self.DoIsArithmetic(ARight) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
        if (AValue.Generic > 0) or (ARight.Generic > 0) then
          return self.DoGenericApply(AOp, AValue, ARight);
        end;
      end;
      if (AOp = "&&") or (AOp = "||") then
        if self.DoIsNumber(AValue) and self.DoIsNumber(ARight) then
          if AOp = "&&" then
            AValue := self.DoInt(int64(self.DoTrue(AValue) and self.DoTrue(ARight)), CTypeKind.Int);
          else
            AValue := self.DoInt(int64(self.DoTrue(AValue) or self.DoTrue(ARight)), CTypeKind.Int);
          end;
          return true;
        end;
        LAdam := " and ";
        if AOp = "||" then
          LAdam := " or ";
        end;
        AValue := self.DoRuntime("(" + self.DoBoolText(AValue) + LAdam + self.DoBoolText(ARight) +
          ")", self.DoBuiltin(CTypeKind.Int), true);
        return true;
      end;
      LCompare := (AOp = "==") or (AOp = "!=") or (AOp = "<") or (AOp = ">") or (AOp = "<=") or
        (AOp = ">=");
      LFloat := self.DoIsFloat(self.DoValueKind(AValue)) or self.DoIsFloat(self.DoValueKind(ARight));
      if LFloat and ((AOp = "%") or (AOp = "<<") or (AOp = ">>") or (AOp = "&") or (AOp = "|") or
        (AOp = "^")) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      if (AOp = "<<") or (AOp = ">>") then
        // a shift's type is its left operand's, promoted
        LKind := self.DoPromote(self.DoValueKind(AValue));
      else
        LKind := self.DoArmsKind(AValue, ARight);
      end;
      if self.DoIsNumber(AValue) and self.DoIsNumber(ARight) then
        LLeft := AValue;
        LRight := ARight;
        if (AOp = "<<") or (AOp = ">>") then
          if not self.DoConvert(LLeft, LKind) or
            not self.DoConvert(LRight, self.DoPromote(self.DoValueKind(LRight))) then
            return false;
          end;
        else
          if not self.DoConvert(LLeft, LKind) or not self.DoConvert(LRight, LKind) then
            return false;
          end;
        end;
        if LFloat then
          return self.DoFoldFloat(AOp, LKind, LLeft.Real, LRight.Real, AValue);
        end;
        return self.DoFoldInt(AOp, LKind, LLeft.Value, LRight, AValue);
      end;
      // at run time: both sides of the common kind, the operator as Adam spells it
      LAdam := AOp;
      match AOp of
        "^": LAdam := "xor";
        "==": LAdam := "=";
        "!=": LAdam := "<>";
        "/":
          if not LFloat then
            LAdam := "div";
          end;
        "%": LAdam := "mod";
      else
      end;
      if (AOp = "<<") or (AOp = ">>") then
        AValue := self.DoRuntime("(" + self.DoArithText(AValue, LKind) + " " + LAdam + " " +
          self.DoArithText(ARight, self.DoPromote(self.DoValueKind(ARight))) + ")",
          self.DoBuiltin(LKind), false);
        return self.FWhy = "";
      end;
      AValue := self.DoRuntime("(" + self.DoArithText(AValue, LKind) + " " + LAdam + " " +
        self.DoArithText(ARight, LKind) + ")", self.DoBuiltin(LKind), LCompare);
      if LCompare then
        AValue.TypeId := self.DoBuiltin(CTypeKind.Int);
      end;
      return self.FWhy = "";
    end;

    // A float operator on two constants of the float kind AKind
    hidden method DoFoldFloat(const AOp: string; const AKind: CTypeKind; const A: float64;
      const B: float64; var AValue: MacroValue): bool;
    begin
      match AOp of
        "+": AValue := self.DoFloat(A + B, AKind);
        "-": AValue := self.DoFloat(A - B, AKind);
        "*": AValue := self.DoFloat(A * B, AKind);
        "/": AValue := self.DoFloat(A / B, AKind);
        "==": AValue := self.DoInt(int64(A = B), CTypeKind.Int);
        "!=": AValue := self.DoInt(int64(A <> B), CTypeKind.Int);
        "<": AValue := self.DoInt(int64(A < B), CTypeKind.Int);
        ">": AValue := self.DoInt(int64(A > B), CTypeKind.Int);
        "<=": AValue := self.DoInt(int64(A <= B), CTypeKind.Int);
        ">=": AValue := self.DoInt(int64(A >= B), CTypeKind.Int);
      else
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      return true;
    end;

    // An integer operator on A and ARight (both converted: of AKind, a shift's count its own
    // promoted kind); a signed result past its kind, a division by zero or a shift outside
    // the kind is no constant
    hidden method DoFoldInt(const AOp: string; const AKind: CTypeKind; const A: int64;
      const ARight: MacroValue; var AValue: MacroValue): bool;
    var
      LSigned: bool;
      LB: int64;
      LBits: int64;
      LResult: int64;
      LUA: uint64;
      LUB: uint64;
      LOverflow: bool;
    begin
      LSigned := self.DoSigned(AKind);
      LB := ARight.Value;
      LBits := self.DoSize(AKind) * 8;
      LUA := uint64(A);
      LUB := uint64(LB);
      LOverflow := false;
      LResult := 0;
      match AOp of
        "==": LResult := int64(A = LB);
        "!=": LResult := int64(A <> LB);
        "<", ">", "<=", ">=":
          if LSigned then
            match AOp of
              "<": LResult := int64(A < LB);
              ">": LResult := int64(A > LB);
              "<=": LResult := int64(A <= LB);
              ">=": LResult := int64(A >= LB);
            end;
          else
            match AOp of
              "<": LResult := int64(LUA < LUB);
              ">": LResult := int64(LUA > LUB);
              "<=": LResult := int64(LUA <= LUB);
              ">=": LResult := int64(LUA >= LUB);
            end;
          end;
          AValue := self.DoInt(LResult, CTypeKind.Int);
          return true;
        "&": LResult := A & LB;
        "|": LResult := A | LB;
        "^": LResult := A xor LB;
        "<<", ">>":
          // the count is of its own kind: negative only when that kind is signed
          if (self.DoSigned(self.DoValueKind(ARight)) and (LB < 0)) or (LUB >= uint64(LBits)) then
            if not self.DoFault(NoArgs().Str(IntToStr(LB)).Str(CKindText(AKind)).Fill(
              ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_SHIFT)) then
              return false;
            end;
            LUB := 0u;
          end;
          if AOp = "<<" then
            LResult := int64(LUA << LUB);
          else
            if LSigned then
              LResult := A >> int64(LUB);
            else
              LResult := int64(LUA >> LUB);
            end;
          end;
        "+":
          LResult := int64(LUA + LUB);
          if LSigned and (LBits >= 64) then
            LOverflow := (((A xor LResult) & (LB xor LResult)) < 0);
          end;
        "-":
          LResult := int64(LUA - LUB);
          if LSigned and (LBits >= 64) then
            LOverflow := (((A xor LB) & (A xor LResult)) < 0);
          end;
        "*":
          LResult := int64(LUA * LUB);
          if LSigned and (LBits >= 64) and (A <> 0) then
            LOverflow := ((A = -1) and (LB = ADAM_CIMPORT_MACRO_INT64_MIN)) or
              ((LB = -1) and (A = ADAM_CIMPORT_MACRO_INT64_MIN)) or
              ((LResult div A) <> LB);
          end;
          if LSigned and (LBits < 64) then
            // both fit 32 bits: the exact product fits 64
            LResult := A * LB;
          end;
        "/", "%":
          if LB = 0 then
            if not self.DoFault(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_DIVIDE) then
              return false;
            end;
            AValue := self.DoInt(0, AKind);
            return true;
          end;
          if LSigned then
            if (A = ADAM_CIMPORT_MACRO_INT64_MIN) and (LB = -1) and (LBits >= 64) then
              LOverflow := true;
              LResult := A;
            else
              if AOp = "/" then
                LResult := A div LB;
              else
                LResult := A mod LB;
              end;
            end;
          else
            if AOp = "/" then
              LResult := int64(LUA div LUB);
            else
              LResult := int64(LUA mod LUB);
            end;
          end;
      else
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      if LSigned and (LBits < 64) and not self.DoFitsSigned(LResult, AKind) and
        (AOp <> "<<") and (AOp <> "&") and (AOp <> "|") and (AOp <> "^") then
        LOverflow := true;
      end;
      if LOverflow then
        if not self.DoFault(NoArgs().Str(CKindText(AKind)).Fill(
          ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_OVERFLOW)) then
          return false;
        end;
      end;
      AValue := self.DoInt(self.DoWrap(LResult, AKind), AKind);
      return true;
    end;

    // A unary expression: - + ~ !, sizeof / _Alignof, a cast, a compound literal, a primary
    hidden method DoUnary(var AValue: MacroValue): bool;
    var
      LTok: PpToken;
      LTypeId: int64;
      LKind: CTypeKind;
      LOperand: MacroValue;
      LSave: int64;
    begin
      LTok := self.DoTok();
      if (LTok.Kind = PpKind.Punct) and ((LTok.Text = "*") or (LTok.Text = "&") or
        (LTok.Text = "++") or (LTok.Text = "--")) then
        self.DoNext();
        if not self.DoUnary(AValue) then
          return false;
        end;
        if LTok.Text = "*" then
          return self.DoDeref(AValue);
        end;
        if LTok.Text = "&" then
          return self.DoAddress(AValue);
        end;
        return self.DoStep(LTok.Text, true, AValue);
      end;
      if (LTok.Kind = PpKind.Punct) and ((LTok.Text = "-") or (LTok.Text = "+") or
        (LTok.Text = "~") or (LTok.Text = "!")) then
        self.DoNext();
        if not self.DoUnary(AValue) then
          return false;
        end;
        if (LTok.Text = "!") and self.DoIsPointer(AValue) then
          AValue := self.DoRuntime("(not " + self.DoBoolText(AValue) + ")",
            self.DoBuiltin(CTypeKind.Int), true);
          return true;
        end;
        if not self.DoIsArithmetic(AValue) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
        if LTok.Text = "!" then
          if self.DoIsNumber(AValue) then
            AValue := self.DoInt(int64(not self.DoTrue(AValue)), CTypeKind.Int);
            return true;
          end;
          AValue := self.DoRuntime("(not " + self.DoBoolText(AValue) + ")",
            self.DoBuiltin(CTypeKind.Int), true);
          return true;
        end;
        if AValue.Generic > 0 then
          // in the type parameter's own type
          if LTok.Text <> "+" then
            AValue := self.DoGenericValue("(" + LTok.Text + AValue.Text + ")", AValue.Generic);
          end;
          AValue.IsPlace := false;
          AValue.Root := -1;
          return true;
        end;
        LKind := self.DoValueKind(AValue);
        if not self.DoIsFloat(LKind) then
          LKind := self.DoPromote(LKind);
        else
          if LTok.Text = "~" then
            return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
          end;
        end;
        if LTok.Text = "+" then
          if self.DoIsNumber(AValue) then
            return self.DoConvert(AValue, LKind);
          end;
          AValue := self.DoRuntime(self.DoArithText(AValue, LKind), self.DoBuiltin(LKind), false);
          return true;
        end;
        if self.DoIsNumber(AValue) then
          if not self.DoConvert(AValue, LKind) then
            return false;
          end;
          if AValue.Kind = MacroValueKind.Float then
            AValue.Real := 0.0 - AValue.Real;
            if AValue.Spelling <> "" then
              AValue.Spelling := "-" + AValue.Spelling;
            end;
            return true;
          end;
          if LTok.Text = "~" then
            AValue := self.DoInt(self.DoWrap(~AValue.Value, LKind), LKind);
            return true;
          end;
          LOperand := AValue;
          return self.DoFoldInt("-", LKind, 0, LOperand, AValue);
        end;
        AValue := self.DoRuntime("(" + LTok.Text + self.DoArithText(AValue, LKind) + ")",
          self.DoBuiltin(LKind), false);
        return self.FWhy = "";
      end;
      if (LTok.Kind = PpKind.Identifier) and ((LTok.Text = "sizeof") or
        (LTok.Text = "_Alignof") or (LTok.Text = "alignof") or (LTok.Text = "__alignof__") or
        (LTok.Text = "__alignof")) then
        self.DoNext();
        return self.DoSizeof(LTok.Text = "sizeof", AValue);
      end;
      if self.DoIs("(") then
        LSave := self.FPos;
        self.DoNext();
        LTypeId := self.DoTypeNameHere();
        if LTypeId <> ADAM_CIMPORT_NONE then
          if not self.DoExpect(")") then
            return false;
          end;
          if self.DoIs("{") then
            return self.DoCompound(LTypeId, AValue);
          end;
          if not self.DoUnary(AValue) then
            return false;
          end;
          return self.DoCast(LTypeId, AValue);
        end;
        self.FPos := LSave;
      end;
      return self.DoPostfix(AValue);
    end;

    // sizeof (ASize) or _Alignof of a type name in parentheses or of an expression's type
    // (never evaluated): size_t. In a function-like macro, sizeof of a type the unit names is
    // Adam's size() of it (run-time text, so the routine says the same on every target: the
    // unit's records lay out as C's), not this target's number
    hidden method DoSizeof(const ASize: bool; var AValue: MacroValue): bool;
    var
      LTypeId: int64;
      LSizeType: int64;
      LSize: int64;
      LSave: int64;
      LOperand: MacroValue;
      LName: string;
    begin
      LTypeId := ADAM_CIMPORT_NONE;
      if self.DoIs("(") then
        LSave := self.FPos;
        self.DoNext();
        LTypeId := self.DoTypeNameHere();
        if LTypeId <> ADAM_CIMPORT_NONE then
          if not self.DoExpect(")") then
            return false;
          end;
        else
          self.FPos := LSave;
        end;
      end;
      LSize := -1;
      if LTypeId = ADAM_CIMPORT_NONE then
        self.FDead := self.FDead + 1;
        if not self.DoUnary(LOperand) then
          return false;
        end;
        self.FDead := self.FDead - 1;
        if LOperand.Generic > 0 then
          return self.DoGenericUse(LOperand);
        end;
        if LOperand.Kind = MacroValueKind.Text then
          LSize := LOperand.Value + 1;
          if not ASize then
            LSize := 1;
          end;
        else
          LTypeId := LOperand.TypeId;
        end;
      end;
      if LSize < 0 then
        if ASize then
          LSize := self.FTypes.SizeOf(LTypeId);
        else
          LSize := self.FTypes.AlignOf(LTypeId);
        end;
      end;
      if LSize < 0 then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_NO_SIZE);
      end;
      LSizeType := self.DoSizeType();
      if LSizeType = ADAM_CIMPORT_NONE then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_SIZE_TYPE);
      end;
      LName := "";
      if ASize and self.FFunction and (LTypeId <> ADAM_CIMPORT_NONE) then
        LName := self.DoTypeNameOf(LTypeId);
      end;
      if LName <> "" then
        AValue := self.DoRuntime(BuiltinName(self.DoKindOf(LSizeType)) + "(size(" + LName + "))",
          LSizeType, false);
        return true;
      end;
      AValue := self.DoInt(LSize, self.DoKindOf(LSizeType));
      AValue.TypeId := LSizeType;
      return true;
    end;

    // (ATypeId) AValue: an integer, _Bool or float type takes the value as C converts it
    // (the type kept: a typedef's name types the constant); a pointer has no Adam const, but
    // in a function-like macro's body a run-time pointer (or pointer-wide integer) becomes
    // Adam's pointer cast (DoPointerCast)
    hidden method DoCast(const ATypeId: int64; var AValue: MacroValue): bool;
    var
      LKind: CTypeKind;
      LType: CType;
      LText: string;
    begin
      LType := self.FTypes.Item(self.FTypes.Resolved(ATypeId));
      LKind := self.DoKindOf(ATypeId);
      if (LType.Kind = CTypeKind.Void) and (AValue.Kind = MacroValueKind.Runtime) then
        AValue.Kind := MacroValueKind.Void;
        AValue.TypeId := ATypeId;
        return true;
      end;
      if (LType.Kind = CTypeKind.Pointer) and (AValue.Generic > 0) then
        return self.DoGenericUse(AValue);
      end;
      if LType.Kind = CTypeKind.Pointer then
        // a null pointer constant in a routine's body is nil
        if self.FFunction and (AValue.Kind = MacroValueKind.Int) and (AValue.Value = 0) then
          AValue := self.DoRuntime("nil", ATypeId, false);
          return true;
        end;
        if self.FFunction and (AValue.Kind = MacroValueKind.Runtime) then
          return self.DoPointerCast(ATypeId, AValue);
        end;
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_POINTER);
      end;
      if LKind = CTypeKind.LongDouble then
        return self.DoFail(NoArgs().Str(CKindText(LKind)).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_TYPE));
      end;
      if not (self.DoIsInteger(LKind) or self.DoIsFloat(LKind)) or
        not self.DoIsArithmetic(AValue) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      if self.DoIsNumber(AValue) then
        if not self.DoConvert(AValue, LKind) then
          return false;
        end;
        AValue.TypeId := ATypeId;
        return true;
      end;
      LText := self.DoArithText(AValue, LKind);
      AValue := self.DoRuntime(LText, ATypeId, LKind = CTypeKind.Bool);
      return self.FWhy = "";
    end;

    // (ATypeId) AValue for the pointer type ATypeId and a run-time AValue: `ptr to [const] T(..)`
    // (BNF sec 6's pointer cast; `ptr(..)` for void *), T a builtin or a type the unit names.
    // What it takes is what Adam's cast takes: a pointer, or an integer of pointer width; a
    // cast that drops the pointee's const has no Adam form (SM0265)
    hidden method DoPointerCast(const ATypeId: int64; var AValue: MacroValue): bool;
    var
      LTarget: CType;
      LPointee: CType;
      LSource: CType;
      LName: string;
      LText: string;
      LSourceConst: bool;
    begin
      LTarget := self.FTypes.Item(self.FTypes.Resolved(ATypeId));
      LPointee := self.FTypes.Item(LTarget.Base);
      LSource := self.FTypes.Item(self.FTypes.Resolved(AValue.TypeId));
      LSourceConst := false;
      if LSource.Kind = CTypeKind.Pointer then
        LSourceConst := self.FTypes.Item(LSource.Base).IsConst;
      else
        if not self.DoIsInteger(LSource.Kind) or (self.DoSize(LSource.Kind) <> 8) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_POINTER);
        end;
      end;
      if LSourceConst and not LPointee.IsConst then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_CONST_DROP);
      end;
      if self.FTypes.Item(self.FTypes.Resolved(LTarget.Base)).Kind = CTypeKind.Void then
        if LPointee.IsConst then
          LText := "ptr to const(" + AValue.Text + ")";
        else
          LText := "ptr(" + AValue.Text + ")";
        end;
        AValue := self.DoRuntime(LText, ATypeId, false);
        return true;
      end;
      LName := self.DoTypeNameOf(LTarget.Base);
      if LName = "" then
        LName := BuiltinName(LPointee.Kind);
      end;
      if LName = "" then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_POINTER);
      end;
      if LPointee.IsConst then
        LText := "ptr to const " + LName + "(" + AValue.Text + ")";
      else
        LText := "ptr to " + LName + "(" + AValue.Text + ")";
      end;
      AValue := self.DoRuntime(LText, ATypeId, false);
      return true;
    end;

    // (ATypeId){ .. }: a struct's compound literal as an Adam record literal's field inits,
    // each a constant number converted to its field's type (.name = designators; the fields
    // not given 0)
    hidden method DoCompound(const ATypeId: int64; var AValue: MacroValue): bool;
    var
      LType: CType;
      LRecord: CRecord;
      LTexts: StringArray;
      LInit: MacroValue;
      LKind: CTypeKind;
      LOut: ref TextBuilder;
      LField: int64;
      LI: int64;
      LJ: int64;
      LWhy: string;
    begin
      LType := self.FTypes.Item(self.FTypes.Resolved(ATypeId));
      LWhy := NoArgs().Str(self.DoTypeSpelling(ATypeId)).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_RECORD);
      if LType.Kind <> CTypeKind.Record then
        return self.DoFail(LWhy);
      end;
      LRecord := self.FTypes.RecordAt(LType.Index);
      if not LRecord.Complete or LRecord.IsUnion or LRecord.HasBitfields or LRecord.HasFlexible then
        return self.DoFail(LWhy);
      end;
      setlength(LTexts, len(LRecord.Fields));
      for LI := 0 to len(LRecord.Fields) - 1 do
        LKind := self.DoKindOf(LRecord.Fields[LI].TypeId);
        if (LRecord.Fields[LI].Name = "") or not (self.DoIsInteger(LKind) or self.DoIsFloat(LKind)) then
          return self.DoFail(LWhy);
        end;
        LTexts[LI] := "";
      end;
      self.DoNext();
      LField := 0;
      while not self.DoIs("}") do
        if self.DoIs(".") then
          self.DoNext();
          LField := -1;
          for LJ := 0 to len(LRecord.Fields) - 1 do
            if LRecord.Fields[LJ].Name = self.DoTok().Text then
              LField := LJ;
            end;
          end;
          if LField < 0 then
            return self.DoFail(LWhy);
          end;
          self.DoNext();
          if not self.DoExpect("=") then
            return false;
          end;
        end;
        if LField >= len(LRecord.Fields) then
          return self.DoFail(LWhy);
        end;
        if not self.DoExpr(LInit) then
          return false;
        end;
        if not self.DoIsNumber(LInit) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
        if not self.DoConvert(LInit, self.DoKindOf(LRecord.Fields[LField].TypeId)) then
          return false;
        end;
        LInit.TypeId := LRecord.Fields[LField].TypeId;
        LTexts[LField] := self.DoConstText(LInit);
        if LTexts[LField] = "" then
          return false;
        end;
        LField := LField + 1;
        if not self.DoIs(",") then
          leave;
        end;
        self.DoNext();
      end;
      if not self.DoExpect("}") then
        return false;
      end;
      LOut := ref TextBuilder();
      for LI := 0 to len(LRecord.Fields) - 1 do
        if LI > 0 then
          LOut.Add(", ");
        end;
        if LTexts[LI] = "" then
          LInit := self.DoInt(0, CTypeKind.Int);
          if not self.DoConvert(LInit, self.DoKindOf(LRecord.Fields[LI].TypeId)) then
            return false;
          end;
          LInit.TypeId := LRecord.Fields[LI].TypeId;
          LTexts[LI] := self.DoConstText(LInit);
        end;
        LOut.Add(DoLocalName(LRecord.Fields[LI].Name) + ": " + LTexts[LI]);
      end;
      AValue := self.DoInt(0, CTypeKind.Int);
      AValue.Kind := MacroValueKind.Literal;
      AValue.TypeId := ATypeId;
      AValue.Text := LOut.Text();
      return true;
    end;

    // How a report names the type AId: a typedef's name, a tag, else C's kind word
    hidden method DoTypeSpelling(const AId: int64): string;
    var
      LType: CType;
    begin
      LType := self.FTypes.Item(AId);
      if LType.Kind = CTypeKind.Record then
        return self.FTypes.RecordAt(LType.Index).Tag;
      end;
      return CKindText(LType.Kind);
    end;

    // A primary expression: ( expr ), a number, a character constant, adjacent strings, a
    // parameter, an enum constant, a call of a bound routine
    hidden method DoPrimary(var AValue: MacroValue): bool;
    var
      LTok: PpToken;
      LId: int64;
      LParam: int64;
    begin
      LTok := self.DoTok();
      if self.DoIs("(") then
        self.DoNext();
        if not self.DoAssign(AValue) then
          return false;
        end;
        return self.DoExpect(")");
      end;
      match LTok.Kind of
        PpKind.Number:
          self.DoNext();
          return self.DoNumber(LTok.Text, AValue);
        PpKind.CharConst:
          self.DoNext();
          return self.DoCharConst(LTok.Text, AValue);
        PpKind.StringLit:
          return self.DoStrings(AValue);
        PpKind.Identifier:
          LParam := self.DoParamIndex(LTok.Text);
          if LParam >= 0 then
            self.DoNext();
            if self.FParamTypes[LParam] = ADAM_CIMPORT_NONE then
              // no bound routine types it: a value of a type parameter (DoRoutine)
              AValue := self.DoGenericValue(DoLocalName(LTok.Text), LParam + 1);
              AValue.IsPlace := true;
              AValue.Root := LParam;
              return true;
            end;
            AValue := self.DoRuntime(DoLocalName(LTok.Text), self.FParamTypes[LParam], false);
            if self.DoKindOf(AValue.TypeId) = CTypeKind.Bool then
              AValue.IsBool := true;
            end;
            AValue.IsPlace := true;
            AValue.Root := LParam;
            return true;
          end;
          LParam := self.DoLocalIndex(LTok.Text);
          if LParam >= 0 then
            self.DoNext();
            AValue := self.DoRuntime(self.FLocalAdam[LParam], self.FLocalTypes[LParam],
              self.DoKindOf(self.FLocalTypes[LParam]) = CTypeKind.Bool);
            AValue.IsPlace := true;
            AValue.Root := LParam;
            return true;
          end;
          if StartsStr(ADAM_CIMPORT_MACRO_BUILTIN, LTok.Text) then
            return self.DoBuiltinCall(LTok.Text, AValue);
          end;
          LId := self.FEnumIds.Find(LTok.Text);
          if LId > 0 then
            self.DoNext();
            AValue := self.DoInt(self.FEnumValues[LId - 1], self.DoKindOf(self.FEnumTypes[LId - 1]));
            return true;
          end;
          LId := self.FCalleeIds.Find(LTok.Text);
          if self.FFunction and (LId > 0) then
            self.DoNext();
            if self.DoIs("(") then
              return self.DoCall(LId - 1, LTok.Text, AValue);
            end;
          end;
          if self.FFunction then
            return self.DoFail(NoArgs().Str(LTok.Text).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_NAME_ROUTINE));
          end;
          return self.DoFail(NoArgs().Str(LTok.Text).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_NAME));
      else
      end;
      return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
    end;

    // A clang builtin at its name: the overflow ones, the bit ones, else a floating constant
    hidden method DoBuiltinCall(const AName: string; var AValue: MacroValue): bool;
    var
      LKind: CTypeKind;
    begin
      if (AName = "__builtin_add_overflow") or (AName = "__builtin_mul_overflow") then
        return self.DoOverflowBuiltin(AName, AValue);
      end;
      LKind := self.DoBitParam(AName);
      if LKind <> CTypeKind.Void then
        return self.DoBitBuiltin(AName, LKind, AValue);
      end;
      return self.DoFloatBuiltin(AName, AValue);
    end;

    // The type of the bit builtin AName's operand (its unsigned type); Void when AName is none
    hidden method DoBitParam(const AName: string): CTypeKind;
    begin
      match AName of
        "__builtin_bswap16":
          return CTypeKind.UShort;
        "__builtin_bswap32", "__builtin_clz", "__builtin_ctz", "__builtin_popcount":
          return CTypeKind.UInt;
        "__builtin_clzl", "__builtin_ctzl", "__builtin_popcountl":
          return CTypeKind.ULong;
        "__builtin_bswap64", "__builtin_clzll", "__builtin_ctzll", "__builtin_popcountll":
          return CTypeKind.ULongLong;
      else
      end;
      return CTypeKind.Void;
    end;

    // The bit builtin AName (its operand of the kind AKind) as Adam's bit intrinsic: bswap's
    // result its operand's type, the counts' int; a constant folded (a zero's count its width,
    // as Adam's)
    hidden method DoBitBuiltin(const AName: string; const AKind: CTypeKind; var AValue: MacroValue):
      bool;
    var
      LArg: MacroValue;
      LIntrinsic: string;
      LResult: CTypeKind;
      LBits: int64;
      LBits64: uint64;
      LValue: uint64;
      LOut: uint64;
      LCount: int64;
      LI: int64;
    begin
      LIntrinsic := "popcount";
      LResult := CTypeKind.Int;
      if StartsStr("__builtin_bswap", AName) then
        LIntrinsic := "byteswap";
        LResult := AKind;
      end;
      if StartsStr("__builtin_clz", AName) then
        LIntrinsic := "leadingzeros";
      end;
      if StartsStr("__builtin_ctz", AName) then
        LIntrinsic := "trailingzeros";
      end;
      self.DoNext();
      if not self.DoExpect("(") then
        return false;
      end;
      if not self.DoAssign(LArg) then
        return false;
      end;
      if not self.DoExpect(")") then
        return false;
      end;
      if not self.DoIsArithmetic(LArg) or self.DoIsFloat(self.DoValueKind(LArg)) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      if not self.DoIsNumber(LArg) then
        AValue := self.DoRuntime(LIntrinsic + "(" + self.DoArithText(LArg, AKind) + ")",
          self.DoBuiltin(LResult), false);
        return self.FWhy = "";
      end;
      if not self.DoConvert(LArg, AKind) then
        return false;
      end;
      LBits := self.DoSize(AKind) * 8;
      LBits64 := uint64(LBits);
      LValue := uint64(LArg.Value);
      LOut := 0u;
      LCount := 0;
      for LI := 0 to LBits - 1 do
        if ((LValue >> uint64(LI)) & 1u) <> 0u then
          LCount := LCount + 1;
        end;
      end;
      if LIntrinsic = "byteswap" then
        for LI := 0 to LBits div 8 - 1 do
          LOut := (LOut << 8u) | ((LValue >> uint64(LI * 8)) & 255u);
        end;
        AValue := self.DoInt(self.DoWrap(int64(LOut), AKind), AKind);
        return true;
      end;
      if LIntrinsic = "leadingzeros" then
        LCount := 0;
        LI := LBits - 1;
        while (LI >= 0) and (((LValue >> uint64(LI)) & 1u) = 0u) do
          LCount := LCount + 1;
          LI := LI - 1;
        end;
      end;
      if LIntrinsic = "trailingzeros" then
        LCount := 0;
        while (uint64(LCount) < LBits64) and (((LValue >> uint64(LCount)) & 1u) = 0u) do
          LCount := LCount + 1;
        end;
      end;
      AValue := self.DoInt(LCount, CTypeKind.Int);
      return true;
    end;

    // An operand of an overflow builtin whose result is of the unsigned kind AKind: its Adam
    // text of AKind; "" when it is no unsigned value no wider than AKind (a constant: no
    // negative one, none past AKind)
    hidden method DoOverflowOperand(const AValue: MacroValue; const AKind: CTypeKind): string;
    var
      LKind: CTypeKind;
    begin
      LKind := self.DoValueKind(AValue);
      if AValue.Kind = MacroValueKind.Int then
        if self.DoSigned(LKind) and (AValue.Value < 0) then
          return "";
        end;
        if not self.DoFitsKind(uint64(AValue.Value), AKind) then
          return "";
        end;
        return self.DoArithText(AValue, AKind);
      end;
      if (AValue.Kind <> MacroValueKind.Runtime) or AValue.IsBool or not self.DoIsInteger(LKind) or
        self.DoSigned(LKind) or (LKind = CTypeKind.Bool) or (self.DoSize(LKind) > self.DoSize(AKind)) then
        return "";
      end;
      return self.DoArithText(AValue, AKind);
    end;

    // __builtin_add_overflow / __builtin_mul_overflow (AName) as plain Adam (see the header):
    // the wrapped value stored through its third operand, true when it overflowed
    hidden method DoOverflowBuiltin(const AName: string; var AValue: MacroValue): bool;
    var
      LA: MacroValue;
      LB: MacroValue;
      LR: MacroValue;
      LBefore: int64;
      LWhy: string;
      LPointee: int64;
      LKind: CTypeKind;
      LAText: string;
      LBText: string;
      LName: string;
      LPlace: string;
      LValue: string;
      LText: string;
    begin
      self.DoNext();
      if not self.DoExpect("(") then
        return false;
      end;
      LBefore := self.FEffects;
      if not self.DoAssign(LA) or not self.DoExpect(",") or not self.DoAssign(LB) or
        not self.DoExpect(",") or not self.DoAssign(LR) or not self.DoExpect(")") then
        return false;
      end;
      // the operands are read more than once
      if self.FEffects <> LBefore then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_TWICE);
      end;
      LWhy := NoArgs().Str(AName).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_OVERFLOW_BUILTIN);
      if not self.DoIsPointer(LR) then
        return self.DoFail(LWhy);
      end;
      LPointee := self.FTypes.Item(self.FTypes.Resolved(LR.TypeId)).Base;
      LKind := self.DoKindOf(LPointee);
      if self.DoIsConst(LPointee) or not self.DoIsInteger(LKind) or self.DoSigned(LKind) or
        (LKind = CTypeKind.Bool) then
        return self.DoFail(LWhy);
      end;
      LAText := self.DoOverflowOperand(LA, LKind);
      LBText := self.DoOverflowOperand(LB, LKind);
      if (LAText = "") or (LBText = "") or (self.FWhy <> "") then
        return self.DoFail(LWhy);
      end;
      LName := BuiltinName(LKind);
      LPlace := self.DoGroup(LR.Text) + "^";
      if AName = "__builtin_add_overflow" then
        LValue := LAText + " + " + LBText;
      else
        LValue := LAText + " * " + LBText;
      end;
      // below int's rank Adam computes in int: the value cut back to the result's type
      if self.DoPromote(LKind) <> LKind then
        LValue := LName + "(" + LValue + ")";
      else
        LValue := "(" + LValue + ")";
      end;
      if AName = "__builtin_add_overflow" then
        // the wrapped sum is below an operand exactly when it overflowed
        LText := "((" + LPlace + " := " + LValue + ") < " + LAText + ")";
      else
        // the wrapped product divided by a nonzero operand is the other exactly when it did not
        LText := "((" + LAText + " <> 0) ? ((" + LPlace + " := " + LValue + ") div " + LAText +
          " <> " + LBText + ") : ((" + LPlace + " := " + LName + "(0)) <> " + LName + "(0)))";
      end;
      self.FEffects := self.FEffects + 1;
      AValue := self.DoRuntime(LText, self.DoBuiltin(CTypeKind.Bool), true);
      return true;
    end;

    // clang's floating constants (__builtin_inf / huge_val / nan, f for float): the infinity
    // or, of an empty payload, the quiet NaN C's <math.h> defines INFINITY / NAN by; the long
    // double forms have no Adam type; any other __builtin_ is no constant Adam can say
    hidden method DoFloatBuiltin(const AName: string; var AValue: MacroValue): bool;
    var
      LBase: string;
      LKind: CTypeKind;
      LNan: bool;
      LPayload: MacroValue;
      LZero: float64;
      LForms: array[0..2] of string;
      LI: int64;
    begin
      // each form's three spellings: double, float (f), long double (l)
      LKind := CTypeKind.Void;
      LNan := false;
      LForms[0] := "inf";
      LForms[1] := "huge_val";
      LForms[2] := "nan";
      for LI := 0 to 2 do
        LBase := ADAM_CIMPORT_MACRO_BUILTIN + LForms[LI];
        if AName = LBase then
          LKind := CTypeKind.Double;
        end;
        if AName = LBase + "f" then
          LKind := CTypeKind.Float;
        end;
        if AName = LBase + "l" then
          LKind := CTypeKind.LongDouble;
        end;
        if (LKind <> CTypeKind.Void) and (LI = 2) then
          LNan := true;
        end;
        if LKind <> CTypeKind.Void then
          leave;
        end;
      end;
      if LKind = CTypeKind.Void then
        return self.DoFail(NoArgs().Str(AName).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_NAME));
      end;
      if LKind = CTypeKind.LongDouble then
        return self.DoFail(NoArgs().Str(CKindText(CTypeKind.LongDouble)).Fill(
          ADAM_MSG_CIMPORT_WRITER_WHY_TYPE));
      end;
      self.DoNext();
      if not self.DoExpect("(") then
        return false;
      end;
      if LNan then
        // the payload: only "" (a quiet NaN) has one meaning on every target
        if not self.DoStrings(LPayload) then
          return false;
        end;
        if (LPayload.Kind <> MacroValueKind.Text) or (LPayload.Value <> 0) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
      end;
      if not self.DoExpect(")") then
        return false;
      end;
      // the value computed, as C does: 1 / 0 an infinity, 0 / 0 a NaN
      LZero := 0.0;
      if LNan then
        AValue := self.DoFloat(LZero / LZero, LKind);
      else
        AValue := self.DoFloat(1.0 / LZero, LKind);
      end;
      return true;
    end;

    // An integer or float constant's value and type (see the header)
    hidden method DoNumber(const AText: string; var AValue: MacroValue): bool;
    var
      LLast: char;
      LReal: float64;
      LText: string;
      LKind: CTypeKind;
    begin
      if self.DoIntLiteral(AText, AValue) then
        return true;
      end;
      if self.FWhy <> "" then
        return false;
      end;
      // a float: its suffix decides its type
      LText := AText;
      LKind := CTypeKind.Double;
      LLast := LText[len(LText) - 1];
      if (LLast = 'f') or (LLast = 'F') then
        if not StartsStr("0x", LowerCase(LText)) or (IndexOf("p", LowerCase(LText), 0) >= 0) then
          LKind := CTypeKind.Float;
          LText := Substring(LText, 0, len(LText) - 1);
        end;
      else
        if (LLast = 'l') or (LLast = 'L') then
          return self.DoFail(NoArgs().Str(CKindText(CTypeKind.LongDouble)).Fill(
            ADAM_MSG_CIMPORT_WRITER_WHY_TYPE));
        end;
      end;
      if LKind = CTypeKind.Float then
        if not TryStrToFloat32(LText, LReal) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
      else
        if not TryStrToFloat(LText, LReal) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
      end;
      AValue := self.DoFloat(LReal, LKind);
      AValue.Spelling := LText;
      return true;
    end;

    // An integer constant (C's prefixes, ' separators, the u / l / ll suffixes and
    // Microsoft's i64) typed by C's list (see the header); false when AText is none (a float),
    // or (the reason kept) when no C integer type holds it
    hidden method DoIntLiteral(const AText: string; var AValue: MacroValue): bool;
    var
      LEnd: int64;
      LAt: int64;
      LBase: int64;
      LDigit: int64;
      LValue: uint64;
      LUnsigned: bool;
      LLongs: int64;
      LSuffix: string;
      LKinds: array[0..5] of CTypeKind;
      LCount: int64;
      LI: int64;
    begin
      LAt := 0;
      LBase := 10;
      if (len(AText) > 2) and (AText[0] = '0') and ((AText[1] = 'x') or (AText[1] = 'X')) then
        LBase := 16;
        LAt := 2;
      else
        if (len(AText) > 2) and (AText[0] = '0') and ((AText[1] = 'b') or (AText[1] = 'B')) then
          LBase := 2;
          LAt := 2;
        else
          // octal: its leading 0 is one of its digits (0u is 0)
          if (len(AText) > 1) and (AText[0] = '0') then
            LBase := 8;
          end;
        end;
      end;
      // a decimal's e / f are a float's (1e5, 1f is none); a hex one's digits run on
      if (LBase <> 16) and ((IndexOf("e", LowerCase(AText), 0) >= 0) or
        (IndexOf(".", AText, 0) >= 0)) then
        return false;
      end;
      if (LBase = 16) and ((IndexOf(".", AText, 0) >= 0) or (IndexOf("p", LowerCase(AText), 0) >= 0)) then
        return false;
      end;
      // the digits run to the suffix (u / l / ll / i64 in any case)
      LEnd := LAt;
      while (LEnd < len(AText)) and ((DoDigit(AText[LEnd], 16) >= 0) or (AText[LEnd] = '\'')) do
        if (LBase <> 16) and (DoDigit(AText[LEnd], 10) < 0) and (AText[LEnd] <> '\'') then
          leave;
        end;
        LEnd := LEnd + 1;
      end;
      if LEnd = LAt then
        return false;
      end;
      LSuffix := LowerCase(Substring(AText, LEnd, len(AText) - LEnd));
      LValue := 0u;
      while LAt < LEnd do
        if AText[LAt] = '\'' then
          LAt := LAt + 1;
          skip;
        end;
        LDigit := DoDigit(AText[LAt], LBase);
        if LDigit < 0 then
          return false;
        end;
        if LValue > (18446744073709551615u - uint64(LDigit)) div uint64(LBase) then
          return self.DoFail(NoArgs().Str(AText).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_TOO_LARGE));
        end;
        LValue := LValue * uint64(LBase) + uint64(LDigit);
        LAt := LAt + 1;
      end;
      LUnsigned := false;
      LLongs := 0;
      if LSuffix = "i64" then
        LLongs := 2;
      else
        if LSuffix = "ui64" then
          LUnsigned := true;
          LLongs := 2;
        else
          if IndexOf("u", LSuffix, 0) >= 0 then
            LUnsigned := true;
            LSuffix := ReplaceStr(LSuffix, "u", "");
          end;
          if LSuffix = "l" then
            LLongs := 1;
          else
            if LSuffix = "ll" then
              LLongs := 2;
            else
              if LSuffix <> "" then
                return false;
              end;
            end;
          end;
        end;
      end;
      // C's list of types for the constant, the first holding the value is its type
      LCount := 0;
      if LLongs = 0 then
        if not LUnsigned then
          LKinds[LCount] := CTypeKind.Int;
          LCount := LCount + 1;
        end;
        if LUnsigned or (LBase <> 10) then
          LKinds[LCount] := CTypeKind.UInt;
          LCount := LCount + 1;
        end;
      end;
      if LLongs <= 1 then
        if not LUnsigned then
          LKinds[LCount] := CTypeKind.Long;
          LCount := LCount + 1;
        end;
        if LUnsigned or (LBase <> 10) then
          LKinds[LCount] := CTypeKind.ULong;
          LCount := LCount + 1;
        end;
      end;
      if not LUnsigned then
        LKinds[LCount] := CTypeKind.LongLong;
        LCount := LCount + 1;
      end;
      // clang: a decimal past long long is unsigned long long (with a warning)
      LKinds[LCount] := CTypeKind.ULongLong;
      LCount := LCount + 1;
      for LI := 0 to LCount - 1 do
        if self.DoFitsKind(LValue, LKinds[LI]) then
          AValue := self.DoInt(int64(LValue), LKinds[LI]);
          return true;
        end;
      end;
      return self.DoFail(NoArgs().Str(AText).Fill(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_TOO_LARGE));
    end;

    // A character constant: an int of its bytes (a multi-character one big-endian, as clang),
    // a single byte by the target's char signedness; a prefixed one has no Adam const
    hidden method DoCharConst(const AText: string; var AValue: MacroValue): bool;
    var
      LBytes: Int64Array;
      LValue: int64;
      LI: int64;
    begin
      if not StartsStr("'", AText) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_WIDE);
      end;
      if not DoDecode(Substring(AText, 1, len(AText) - 2), LBytes) or (len(LBytes) = 0) then
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      LValue := 0;
      for LI := 0 to len(LBytes) - 1 do
        LValue := ((LValue << 8) | (LBytes[LI] & 255)) & 4294967295;
      end;
      if len(LBytes) = 1 then
        if self.FTarget.CharSigned() and (LValue > 127) then
          LValue := LValue - 256;
        end;
      else
        LValue := self.DoWrap(LValue, CTypeKind.Int);
      end;
      AValue := self.DoInt(LValue, CTypeKind.Int);
      return true;
    end;

    // Adjacent string literals as one string's bytes (plain or u8; L / u / U have no Adam
    // const)
    hidden method DoStrings(var AValue: MacroValue): bool;
    var
      LBytes: Int64Array;
      LAll: Int64Array;
      LCount: int64;
      LText: string;
      LQuote: int64;
      LI: int64;
    begin
      LCount := 0;
      setlength(LAll, 0);
      while self.DoTok().Kind = PpKind.StringLit do
        LText := self.DoTok().Text;
        LQuote := IndexOf("\"", LText, 0);
        if (LQuote < 0) or ((LQuote > 0) and (Substring(LText, 0, LQuote) <> "u8")) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_WIDE);
        end;
        if not DoDecode(Substring(LText, LQuote + 1, len(LText) - LQuote - 2), LBytes) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
        setlength(LAll, LCount + len(LBytes));
        for LI := 0 to len(LBytes) - 1 do
          LAll[LCount + LI] := LBytes[LI];
        end;
        LCount := LCount + len(LBytes);
        self.DoNext();
      end;
      AValue := self.DoInt(0, CTypeKind.Char);
      AValue.Kind := MacroValueKind.Text;
      AValue.Text := DoStringText(LAll);
      // sizeof's count: the bytes (the literal's text holds escapes)
      AValue.Value := LCount;
      return true;
    end;

    // A call of the bound routine ACallee (C name ACName) at its '(': each argument converted
    // to its parameter's type (see the header)
    hidden method DoCall(const ACallee: int64; const ACName: string; var AValue: MacroValue):
      bool;
    var
      LType: CType;
      LArgs: StringArray;
      LArg: MacroValue;
      LCount: int64;
      LText: string;
      LBool: bool;
    begin
      LType := self.FTypes.Item(self.FTypes.Resolved(self.FCalleeTypes[ACallee]));
      self.DoNext();
      LCount := 0;
      setlength(LArgs, len(LType.Params) + 4);
      while not self.DoIs(")") do
        if not self.DoAssign(LArg) then
          return false;
        end;
        if LCount >= len(LArgs) then
          setlength(LArgs, LCount * 2);
        end;
        if LCount < len(LType.Params) then
          LArgs[LCount] := self.DoArgText(LArg, LType.Params[LCount].TypeId);
        else
          if not LType.Variadic then
            LArgs[LCount] := "";
          else
            LArgs[LCount] := self.DoVarArgText(LArg);
          end;
        end;
        if (LArgs[LCount] = "") and (self.FWhy = "") and (LCount < len(LType.Params)) then
          return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
        end;
        LCount := LCount + 1;
        if not self.DoIs(",") then
          leave;
        end;
        self.DoNext();
      end;
      if not self.DoExpect(")") then
        return false;
      end;
      if self.FWhy <> "" then
        return false;
      end;
      if (LCount < len(LType.Params)) or ((LCount > len(LType.Params)) and not LType.Variadic) then
        return self.DoFail(NoArgs().Str(ACName).Int(LCount).Int(len(LType.Params)).Fill(
          ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_ARGS));
      end;
      setlength(LArgs, LCount);
      // a call may have a side effect
      self.FEffects := self.FEffects + 1;
      LText := self.FCalleeNames[ACallee] + "(" + JoinStrings(LArgs, ", ") + ")";
      if self.FCalledCount = len(self.FCalled) then
        setlength(self.FCalled, self.FCalledCount * 2 + 8);
      end;
      self.FCalled[self.FCalledCount] := self.FCalleeFiles[ACallee];
      self.FCalledCount := self.FCalledCount + 1;
      LBool := self.DoKindOf(LType.Base) = CTypeKind.Bool;
      AValue := self.DoRuntime(LText, LType.Base, LBool);
      if self.FTypes.Item(self.FTypes.Resolved(LType.Base)).Kind = CTypeKind.Void then
        AValue.Kind := MacroValueKind.Void;
      end;
      return true;
    end;

    // AArg as the argument of a parameter of type AParamId (or the value an assignment, an
    // initializer or a return converts): a number converted to it, a pointer one the
    // parameter's own type (any pointer for a void one; an array its first element's
    // address) or nil (a constant 0), a string literal for a char pointer, a struct or union
    // of its own type; "" (the reason kept) when C's conversion has no Adam form here
    hidden method DoArgText(const AArg: MacroValue; const AParamId: int64): string;
    var
      LParam: CType;
      LArg: CType;
      LBase: CTypeKind;
      LKind: CTypeKind;
      LVoid: bool;
    begin
      LParam := self.FTypes.Item(self.FTypes.Resolved(AParamId));
      if LParam.Kind = CTypeKind.Pointer then
        if (AArg.Kind = MacroValueKind.Int) and (AArg.Value = 0) then
          return "nil";
        end;
        if (AArg.Kind = MacroValueKind.Runtime) and (AArg.Text = "nil") then
          return "nil";
        end;
        if AArg.Kind = MacroValueKind.Text then
          LBase := self.DoKindOf(LParam.Base);
          if (LBase = CTypeKind.Char) or (LBase = CTypeKind.SChar) or (LBase = CTypeKind.UChar) then
            return AArg.Text;
          end;
          return "";
        end;
        if AArg.Kind <> MacroValueKind.Runtime then
          return "";
        end;
        LArg := self.FTypes.Item(self.FTypes.Resolved(AArg.TypeId));
        LVoid := self.FTypes.Item(self.FTypes.Resolved(LParam.Base)).Kind = CTypeKind.Void;
        if (LArg.Kind = CTypeKind.Pointer) and (self.DoSamePointee(LArg.Base, LParam.Base) or
          (LVoid and (self.DoIsConst(LParam.Base) or not self.DoIsConst(LArg.Base)))) then
          return AArg.Text;
        end;
        if (LArg.Kind = CTypeKind.Array) and (self.DoSamePointee(LArg.Base, LParam.Base) or
          (LVoid and (self.DoIsConst(LParam.Base) or not self.DoIsConst(LArg.Base)))) then
          return "addr of " + self.DoGroup(AArg.Text) + "[0]";
        end;
        return "";
      end;
      LKind := self.DoKindOf(AParamId);
      if not (self.DoIsInteger(LKind) or self.DoIsFloat(LKind)) or not self.DoIsArithmetic(AArg) then
        if (AArg.Kind = MacroValueKind.Runtime) and (AArg.TypeId = AParamId) then
          return AArg.Text;
        end;
        LArg := self.FTypes.Item(self.FTypes.Resolved(AArg.TypeId));
        if (AArg.Kind = MacroValueKind.Runtime) and (LParam.Kind = CTypeKind.Record) and
          (LArg.Kind = CTypeKind.Record) and (LArg.Index = LParam.Index) then
          return AArg.Text;
        end;
        return "";
      end;
      return self.DoArithText(AArg, LKind);
    end;

    // A variadic argument: C's default promotions (float to double, small integers to int)
    hidden method DoVarArgText(const AArg: MacroValue): string;
    var
      LKind: CTypeKind;
    begin
      if AArg.Generic > 0 then
        self.DoGenericUse(AArg);
        return "";
      end;
      if AArg.Kind = MacroValueKind.Text then
        return AArg.Text;
      end;
      if not self.DoIsArithmetic(AArg) then
        if AArg.Kind = MacroValueKind.Runtime then
          return AArg.Text;
        end;
        return "";
      end;
      LKind := self.DoValueKind(AArg);
      if LKind = CTypeKind.Float then
        LKind := CTypeKind.Double;
      end;
      if not self.DoIsFloat(LKind) then
        LKind := self.DoPromote(LKind);
      end;
      return self.DoArithText(AArg, LKind);
    end;

    // True when pointees A and B are one type to Adam (typedefs looked through; a pointer to
    // a non-const one passes for a pointer to its const one, as in C)
    hidden method DoSamePointee(const A: int64; const B: int64): bool;
    var
      LA: CType;
      LB: CType;
    begin
      LA := self.FTypes.Item(self.FTypes.Resolved(A));
      LB := self.FTypes.Item(self.FTypes.Resolved(B));
      if LA.IsConst and not LB.IsConst then
        return false;
      end;
      if LA.Kind <> LB.Kind then
        return false;
      end;
      match LA.Kind of
        CTypeKind.Record, CTypeKind.Enum: return LA.Index = LB.Index;
        CTypeKind.Pointer: return self.DoSamePointee(LA.Base, LB.Base);
        CTypeKind.Array, CTypeKind.Function: return self.FTypes.Resolved(A) = self.FTypes.Resolved(B);
      else
      end;
      return true;
    end;

    // ---- one macro -------------------------------------------------------------------------

    // Each parameter passed whole (parentheses allowed) to a bound routine takes that
    // parameter's type, its first such use (to a bit builtin, its operand's unsigned type)
    hidden method DoTypeParams();
    var
      LTok: PpToken;
      LType: CType;
      LBit: CTypeKind;
      LCount: int64;
      LCallee: int64;
      LDepth: int64;
      LArg: int64;
      LStart: int64;
      LFirst: int64;
      LLast: int64;
      LParam: int64;
      LI: int64;
      LJ: int64;
    begin
      for LI := 0 to len(self.FToks) - 2 do
        LTok := self.FToks[LI];
        LCallee := 0;
        LBit := CTypeKind.Void;
        if LTok.Kind = PpKind.Identifier then
          LCallee := self.FCalleeIds.Find(LTok.Text);
          if LCallee = 0 then
            LBit := self.DoBitParam(LTok.Text);
          end;
        end;
        if ((LCallee = 0) and (LBit = CTypeKind.Void)) or (self.FToks[LI + 1].Text <> "(") or
          (self.FToks[LI + 1].Kind <> PpKind.Punct) then
          skip;
        end;
        LCount := 1;
        if LCallee > 0 then
          LType := self.FTypes.Item(self.FTypes.Resolved(self.FCalleeTypes[LCallee - 1]));
          LCount := len(LType.Params);
        end;
        LDepth := 0;
        LArg := 0;
        LStart := LI + 2;
        for LJ := LI + 2 to len(self.FToks) - 1 do
          LTok := self.FToks[LJ];
          if (LTok.Kind = PpKind.Punct) and ((LTok.Text = "(") or (LTok.Text = "[") or
            (LTok.Text = "{")) then
            LDepth := LDepth + 1;
            skip;
          end;
          if (LTok.Kind = PpKind.Punct) and (LDepth > 0) and ((LTok.Text = ")") or
            (LTok.Text = "]") or (LTok.Text = "}")) then
            LDepth := LDepth - 1;
            skip;
          end;
          if (LTok.Kind <> PpKind.Punct) or (LDepth > 0) or ((LTok.Text <> ",") and
            (LTok.Text <> ")")) then
            skip;
          end;
          // the argument LStart .. LJ - 1, its outer parentheses off
          LFirst := LStart;
          LLast := LJ - 1;
          while (LLast - LFirst >= 2) and (self.FToks[LFirst].Text = "(") and
            (self.FToks[LLast].Text = ")") do
            LFirst := LFirst + 1;
            LLast := LLast - 1;
          end;
          if (LFirst = LLast) and (LArg < LCount) then
            LParam := self.DoParamIndex(self.FToks[LFirst].Text);
            if (LParam >= 0) and (self.FParamTypes[LParam] = ADAM_CIMPORT_NONE) then
              if LCallee > 0 then
                self.FParamTypes[LParam] := LType.Params[LArg].TypeId;
              else
                self.FParamTypes[LParam] := self.DoBuiltin(LBit);
              end;
            end;
          end;
          LArg := LArg + 1;
          LStart := LJ + 1;
          if LTok.Text = ")" then
            leave;
          end;
        end;
      end;
    end;

    // What the macro in the preprocessor's slot AIndex is (see the header)
    method Evaluate(const AIndex: int64): MacroResult;
    var
      LMacro: PpMacro;
      LResult: MacroResult;
      LValue: MacroValue;
      LOk: bool;
      LI: int64;
    begin
      LMacro := self.FPre.MacroAt(AIndex);
      LResult.Bound := false;
      LResult.Why := "";
      LResult.IsRoutine := LMacro.Kind = MacroKind.Function;
      LResult.Body := "";
      setlength(LResult.Params, 0);
      setlength(LResult.ParamTypes, 0);
      setlength(LResult.Files, 0);
      setlength(LResult.TypeParams, 0);
      setlength(LResult.ParamTypeText, 0);
      LResult.ResultTypeText := "";
      self.FCalledCount := 0;
      self.FWhy := "";
      self.FDead := 0;
      self.FPos := 0;
      self.FBody := false;
      self.FLocalCount := 0;
      self.FEffects := 0;
      self.FFunction := LResult.IsRoutine;
      self.FParams := LMacro.Params;
      setlength(self.FParamTypes, len(LMacro.Params));
      setlength(self.FGroups, len(LMacro.Params));
      for LI := 0 to len(LMacro.Params) - 1 do
        self.FParamTypes[LI] := ADAM_CIMPORT_NONE;
        self.FGroups[LI] := LI;
      end;
      if LResult.IsRoutine and LMacro.Variadic then
        LResult.Why := ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_VARIADIC;
        return LResult;
      end;
      self.FToks := self.FPre.ExpandMacro(AIndex);
      if len(self.FToks) = 0 then
        return LResult;
      end;
      if LResult.IsRoutine then
        self.DoTypeParams();
      end;
      LOk := self.DoAssign(LValue);
      if LOk and (self.FPos < len(self.FToks)) then
        LOk := self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      if LOk and not LResult.IsRoutine and ((LValue.Kind = MacroValueKind.Runtime) or
        (LValue.Kind = MacroValueKind.Void)) then
        LOk := self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      if LOk and LResult.IsRoutine then
        LOk := self.DoRoutine(LValue, LResult);
      end;
      if LOk and not LResult.IsRoutine and (LValue.Kind <> MacroValueKind.Literal) and
        (LValue.Kind <> MacroValueKind.Text) then
        LValue.Text := self.DoConstText(LValue);
        LOk := LValue.Text <> "";
      end;
      if not LOk then
        LResult.Why := self.FWhy;
        if LResult.Why = "" then
          LResult.Why := ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR;
        end;
        return LResult;
      end;
      LResult.Bound := true;
      LResult.Value := LValue;
      setlength(LResult.Files, self.FCalledCount);
      for LI := 0 to self.FCalledCount - 1 do
        LResult.Files[LI] := self.FCalled[LI];
      end;
      return LResult;
    end;

    // A function-like macro's body AValue as its routine: each parameter's type (an untyped
    // one's type parameter: one per group, in the parameters' order), the body's Adam
    // expression and its type (a comparison's int; a type parameter's value its own)
    hidden method DoRoutine(var AValue: MacroValue; var AResult: MacroResult): bool;
    var
      LSlots: Int64Array;
      LCount: int64;
      LRoot: int64;
      LI: int64;
    begin
      setlength(AResult.Params, len(self.FParams));
      for LI := 0 to len(self.FParams) - 1 do
        AResult.Params[LI] := DoLocalName(self.FParams[LI]);
      end;
      AResult.ParamTypes := self.FParamTypes;
      setlength(AResult.ParamTypeText, len(self.FParams));
      setlength(LSlots, len(self.FParams));
      LCount := 0;
      for LI := 0 to len(self.FParams) - 1 do
        AResult.ParamTypeText[LI] := "";
        LSlots[LI] := -1;
      end;
      for LI := 0 to len(self.FParams) - 1 do
        if self.FParamTypes[LI] = ADAM_CIMPORT_NONE then
          LRoot := self.DoGroupOf(LI);
          if LSlots[LRoot] < 0 then
            LSlots[LRoot] := LCount;
            LCount := LCount + 1;
          end;
        end;
      end;
      setlength(AResult.TypeParams, LCount);
      for LI := 0 to LCount - 1 do
        AResult.TypeParams[LI] := DoTypeParamName(LI, LCount, AResult.Params);
      end;
      for LI := 0 to len(self.FParams) - 1 do
        if self.FParamTypes[LI] = ADAM_CIMPORT_NONE then
          AResult.ParamTypeText[LI] := AResult.TypeParams[LSlots[self.DoGroupOf(LI)]];
        end;
      end;
      if AValue.Generic > 0 then
        AResult.ResultTypeText := AResult.TypeParams[LSlots[self.DoGroupOf(AValue.Generic - 1)]];
      end;
      match AValue.Kind of
        MacroValueKind.Int, MacroValueKind.Float:
          AResult.Body := self.DoConstText(AValue);
        MacroValueKind.Runtime, MacroValueKind.Void:
          AResult.Body := AValue.Text;
          // a void body is a statement: an assignment or a step without its parentheses
          if (AValue.Kind = MacroValueKind.Void) and (AValue.Bare <> "") then
            AResult.Body := AValue.Bare;
          end;
          if AValue.IsBool and (self.DoKindOf(AValue.TypeId) <> CTypeKind.Bool) then
            AResult.Body := BuiltinName(self.DoKindOf(AValue.TypeId)) + "(" + AValue.Text + ")";
          end;
      else
        return self.DoFail(ADAM_MSG_CIMPORT_WRITER_WHY_MACRO_EXPR);
      end;
      return AResult.Body <> "";
    end;
  end;

end.
