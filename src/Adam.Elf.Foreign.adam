-------------------------------------------------------------------------------
  Adam.Elf.Foreign.adam - ELF objects taken into a link: a unit's own object
  whole, a static library's members pulled in by undefined symbol, merged
  into the SectionSet (DESIGN sec 7, PLAN-LINUX64 LX3a)

  ElfForeignLinker  one link's ELF objects. Every layout fact is the System
                 V gABI's (sections, symbols, groups, SHF_LINK_ORDER) with
                 elf.h's names (std System.Elf); the relocation types are the
                 arch's (Adam.Elf.Writer's ElfMachine); .eh_frame is the LSB's
                 (length, CIE id 0 / the FDE's offset back to its CIE).
                 AddObject  a unit's object (Adam.Backend.Generate's
                            GenerateObject) loaded whole; its GOT references
                            to a name its import list holds (pairs of
                            NUL-ended library and name, in the Info section
                            the caller names) bind to that import, as its
                            own set had it
                 AddArchive a static library (GNU ar, Adam.Backend.Archive),
                            read whole; its symbol index's first member of a
                            name wins, earlier libraries first
                 Run        the set's Undefined symbols (id order) and every
                            loaded member's strong undefined references
                            pull the member the index names (GNU ld's rule:
                            a weak reference pulls nothing, a weak
                            definition is not replaced by a pulled member),
                            then every loaded object is merged
                 MergeObjects  the AddObject objects merged, nothing searched
                 WeakOnly   a name only weak references reached (the linker
                            resolves it to 0 when nothing defines it)
  Loading a member: its machine checked; a COMDAT group (SHT_GROUP,
  GRP_COMDAT) is kept when it is the first of its signature (the set
  defining the signature already, an earlier unit's copy, counts as first):
  else its members are dropped and its names reach the kept copy's;
  non-ALLOC sections (debug, .comment, .llvm_addrsig, SHF_EXCLUDE: a unit's
  Info), notes and the tables are dropped; a global or GNU-unique symbol is
  a strong definition (two are EF0003, an earlier unit's in the set
  included), a weak one is kept only while no strong one is seen; a common
  symbol is a definition of zeroed storage (st_value its alignment, the
  largest size).
  Merging a loaded object, in load order:
    sections  each kept section a new set section, its name made unique,
              its bytes copied; its kind by its flags (TLS thread-local,
              EXECINSTR code, NOBITS zeroed, WRITE data, else read-only);
              its group name the output one (DoGroupOf: .text.* .text,
              .rodata.* .rodata, .data.rel.ro.* .data.rel.ro, .data.*
              .data, .bss.* .bss, .tdata.* .tdata, .tbss.* .tbss; an init /
              fini array's ".init_array$<priority>", five digits, 65536 for
              none, so the linker sorts them as GNU ld does; any other name
              its own); Removable (gc-sections) unless it is an init / fini
              / preinit array or a C identifier's name (__start_ / __stop_
              reach it); SHF_LINK_ORDER is Associate with its sh_link's;
              one named with ADAM_ELF_TOMBSTONE_SUFFIX (a unit's line
              table, Adam.Elf.Writer) a Tombstone one: its relocation to a
              section of a discarded COMDAT copy (a generic instance an
              earlier unit defined first) names the tombstone target (an
              empty Removable section nothing keeps), so the field reads 0
              as one for removed code (Adam.Elf.Linker), never the kept
              copy's code (another unit's rows)
    eh_frame  a foreign .eh_frame (one section of many records, no
              LINK_ORDER) cut into one piece per FDE: a copy of its CIE then
              the FDE, its CIE offset made the piece's, Associate with the
              section its start's relocation names (an FDE of a section not
              kept is left out); a unit's pieces are already so (LINK_ORDER)
    symbols   each name this object wins defined in the set; a local
              symbol (a section's) reached through its section's base
              symbol (internal), its value in the addend
    relocs    the arch's: none skipped; pc-relative S + A - P a Rel32 with A
              + 4; R_64 an Abs64; GOT-relative a Rel32 (A + 4) to a slot:
              a unit's import, else a local GOT slot (8 bytes, Removable, in
              .got, an Abs64 of the symbol: GNU ld keeps a slot when it does
              not relax, which is always correct); DTPOFF32 a SecRel32
              (a TpOff32 in code: its local-dynamic base is the thread
              pointer once relaxed, GNU ld's rule), TPOFF32 a TpOff32
              (local-exec)
    tls       a C object's thread-local accesses relaxed to local-exec, as
              GNU ld relaxes them in an exe (LX3d2; the arch's byte forms,
              ElfMachine): a general-dynamic one (TLSGD, then its call of
              __tls_get_addr, the next relocation) rewritten in place, its
              TPOFF32 field a TpOff32 (A + 4), the call's relocation
              dropped; a local-dynamic one (TLSLD + its call) rewritten to
              load the thread pointer, no relocation; an initial-exec load
              (GOTTPOFF) made an immediate, a TpOff32 (A + 4). A sequence of
              another form (bytes not the arch's, no call after it) is
              EF0004
  Every report is at the node of the reference that pulled the object in (a
  unit's own: its unit's node, or the declaration its name map gives).

  Reported, the link failed after it: a library that cannot be read (EF0001)
  or is no archive (AR codes, Adam.Backend.Archive) or holds a damaged
  object (EO0001, Adam.Elf.Reader); an object built for another machine or
  of another file type (EF0002); a second strong definition (EF0003); what
  Adam does not link (EF0004): another relocation type, a thread-local
  access in a form it cannot relax, a global absolute
  symbol, an IFUNC, a section aligned past the page, a 64-bit .eh_frame
  record; a damaged object (EF0005: an import list cut short, a relocation
  past its section, an .eh_frame record past its section, an FDE whose CIE
  is not there, a group with no signature); a reference to a section the
  link dropped (EF0006: a discarded COMDAT copy's local). Nothing raises.
*******************************************************************************/

module unit Adam.Elf.Foreign;

import System.SysUtils, System.IO, Adam.Core.Containers, Adam.Core.Messages,
  Adam.Compiler.SourceText, Adam.Compiler.Diagnostics, Adam.Compiler.AST, Adam.Backend.Sections,
  Adam.Backend.Archive, Adam.Elf.Writer, Adam.Elf.Reader, System.Elf;

public const
  // Reported (see the header)
  ADAM_ERR_ELF_FOREIGN_001: string = "EF0001";   // a static library that cannot be read
  ADAM_ERR_ELF_FOREIGN_002: string = "EF0002";   // another machine or file type
  ADAM_ERR_ELF_FOREIGN_003: string = "EF0003";   // a second definition
  ADAM_ERR_ELF_FOREIGN_004: string = "EF0004";   // something adam does not link
  ADAM_ERR_ELF_FOREIGN_005: string = "EF0005";   // a damaged object
  ADAM_ERR_ELF_FOREIGN_006: string = "EF0006";   // a reference to a dropped section
  // The output group of a local GOT slot, and what a slot's and a section base's set names
  // start / end with (no C name holds '#')
  ADAM_ELF_FOREIGN_GOT: string = ".got";
  ADAM_ELF_FOREIGN_GOT_PREFIX: string = ".got#";
  ADAM_ELF_FOREIGN_BASE_SUFFIX: string = "#base";
  // The set symbol a tombstoned relocation names (DoTombstoneTarget: a relocation of a
  // Tombstone section to a discarded COMDAT copy's section), defined in an empty Removable
  // section nothing keeps, so the field reads 0 (the linker's tombstone)
  ADAM_ELF_FOREIGN_TOMBSTONE_SYMBOL: string = "__adam_tombstone_target";
  ADAM_ELF_FOREIGN_TOMBSTONE_SECTION: string = ".rodata#__adam_tombstone_target";
  ADAM_ELF_FOREIGN_TOMBSTONE_GROUP: string = ".rodata";
  ADAM_ELF_FOREIGN_MARK: string = "#";
  // The .eh_frame section (by name; clang types it SHT_X86_64_UNWIND, gcc SHT_PROGBITS)
  ADAM_ELF_FOREIGN_EH_FRAME: string = ".eh_frame";
  // The output names of the init / fini arrays, the mark before their sort key, the key of
  // an array with no priority (after every priority, GNU ld's order) and its digits
  ADAM_ELF_FOREIGN_INIT_ARRAY: string = ".init_array";
  ADAM_ELF_FOREIGN_FINI_ARRAY: string = ".fini_array";
  ADAM_ELF_FOREIGN_PREINIT_ARRAY: string = ".preinit_array";
  ADAM_ELF_FOREIGN_ORDER_MARK: string = "$";
  ADAM_ELF_FOREIGN_NO_PRIORITY: string = "65536";
  ADAM_ELF_FOREIGN_PRIORITY_DIGITS: int64 = 5;
  // An .eh_frame record's length that says a 64-bit record follows
  ADAM_ELF_FOREIGN_EH_64: int64 = 0xFFFFFFFF;
  // A key packs two indexes in one map value: the outer times this, plus the inner, plus 1
  ADAM_ELF_FOREIGN_KEY_SPAN: int64 = 0x100000000;
  // A slot's, a 32-bit field's and a 64-bit field's bytes
  ADAM_ELF_FOREIGN_SLOT_SIZE: int64 = 8;
  ADAM_ELF_FOREIGN_FIELD_32: int64 = 4;
  // The report budget of the scratch reads of a member's symbol index check
  ADAM_ELF_FOREIGN_READ_BUDGET: int64 = 1;

type
  // One static library: its file, its bytes, the archive read, which entries are loaded
  ElfArchive = object
    FilePath: string;
    Bytes: ByteArray;
    Contents: ArchiveContents;
    Loaded: BoolArray;

    init(const AFilePath: string);
    begin
      self.FilePath := AFilePath;
    end;
  end;

  // One object loaded (see the header): the object read and the buffer its offsets are in,
  // its archive (-1: a unit's own), how reports name it, the node that pulled it in, its
  // load number (unique set names); per section whether it is kept, whether it is an
  // .eh_frame to cut, its set section (0 none) and its base symbol (0 not made yet); a
  // unit's name map and import list (a name -> its index + 1 in ImportLibraries / ImportNames)
  ElfMerge = object
    Source: ElfObjectData;
    Bytes: ByteArray;
    Archive: int64;
    ObjectLabel: string;
    Node: int64;
    Serial: int64;
    Kept: BoolArray;
    EhFrame: BoolArray;
    SetSection: Int64Array;
    BaseSymbol: Int64Array;
    Nodes: ref StringIdMap;
    ImportOf: ref StringIdMap;
    ImportLibraries: StringArray;
    ImportNames: StringArray;

    init(const AArchive: int64; const AObjectLabel: string; const ANode: int64;
      const ASerial: int64);
    begin
      self.Archive := AArchive;
      self.ObjectLabel := AObjectLabel;
      self.Node := ANode;
      self.Serial := ASerial;
      self.Nodes := nil;
      self.ImportOf := ref StringIdMap(0);
    end;

    // The node a reference of this object to the symbol AName is at: the one Nodes holds
    // for it, else Node
    const method NodeOf(const AName: string): int64;
    var
      LNode: int64;
    begin
      if self.Nodes <> nil then
        LNode := self.Nodes.Find(AName);
        if LNode <> 0 then
          return LNode;
        end;
      end;
      return self.Node;
    end;
  end;

// AOuter and AInner packed in one map value (see ADAM_ELF_FOREIGN_KEY_SPAN)
func DoKey(const AOuter: int64; const AInner: int64): int64;
begin
  return AOuter * ADAM_ELF_FOREIGN_KEY_SPAN + AInner + 1;
end;

func DoKeyOuter(const AKey: int64): int64;
begin
  return (AKey - 1) div ADAM_ELF_FOREIGN_KEY_SPAN;
end;

func DoKeyInner(const AKey: int64): int64;
begin
  return (AKey - 1) mod ADAM_ELF_FOREIGN_KEY_SPAN;
end;

// True when AFlags (an sh_flags word) holds AFlag
func DoHasFlag(const AFlags: int64; const AFlag: uint64): bool;
begin
  return (AFlags & int64(AFlag)) <> 0;
end;

// True when AName is a C identifier (a letter or '_' first, then letters, digits, '_'):
// the section names a linker makes __start_ / __stop_ symbols for
public func ElfIsCIdentifier(const AName: string): bool;
var
  LC: char;
  LI: int64;
begin
  if len(AName) = 0 then
    return false;
  end;
  for LI := 0 to len(AName) - 1 do
    LC := AName[LI];
    if not (((LC >= 'a') and (LC <= 'z')) or ((LC >= 'A') and (LC <= 'Z')) or (LC = '_') or
      ((LI > 0) and (LC >= '0') and (LC <= '9'))) then
      return false;
    end;
  end;
  return true;
end;

// True when AName is APrefix or starts with APrefix and a '.'
func DoIsNamed(const AName: string; const APrefix: string): bool;
begin
  return (AName = APrefix) or StartsStr(APrefix + ".", AName);
end;

// AText's digits padded with '0' on the left to ADAM_ELF_FOREIGN_PRIORITY_DIGITS
func DoPadded(const AText: string): string;
var
  LText: string;
begin
  LText := AText;
  while len(LText) < ADAM_ELF_FOREIGN_PRIORITY_DIGITS do
    LText := "0" + LText;
  end;
  return LText;
end;

// The output group of an init / fini array named AName whose plain name is APlain: APlain,
// the order mark, its priority (the digits after APlain + '.') or the no-priority key
func DoArrayGroup(const AName: string; const APlain: string): string;
begin
  if len(AName) > len(APlain) + 1 then
    return APlain + ADAM_ELF_FOREIGN_ORDER_MARK +
      DoPadded(Substring(AName, len(APlain) + 1, len(AName) - len(APlain) - 1));
  end;
  return APlain + ADAM_ELF_FOREIGN_ORDER_MARK + ADAM_ELF_FOREIGN_NO_PRIORITY;
end;

// The output group a section named AName of type AType goes in (see the header)
public func ElfGroupOf(const AName: string; const AType: int64): string;
begin
  if (AType = int64(SHT_INIT_ARRAY)) or DoIsNamed(AName, ADAM_ELF_FOREIGN_INIT_ARRAY) then
    return DoArrayGroup(AName, ADAM_ELF_FOREIGN_INIT_ARRAY);
  end;
  if (AType = int64(SHT_FINI_ARRAY)) or DoIsNamed(AName, ADAM_ELF_FOREIGN_FINI_ARRAY) then
    return DoArrayGroup(AName, ADAM_ELF_FOREIGN_FINI_ARRAY);
  end;
  if (AType = int64(SHT_PREINIT_ARRAY)) or DoIsNamed(AName, ADAM_ELF_FOREIGN_PREINIT_ARRAY) then
    return ADAM_ELF_FOREIGN_PREINIT_ARRAY;
  end;
  // .data.rel.ro before .data: the longer prefix first
  if DoIsNamed(AName, ".data.rel.ro") then
    return ".data.rel.ro";
  end;
  if DoIsNamed(AName, ".text") then
    return ".text";
  end;
  if DoIsNamed(AName, ".rodata") then
    return ".rodata";
  end;
  if DoIsNamed(AName, ".data") then
    return ".data";
  end;
  if DoIsNamed(AName, ".bss") then
    return ".bss";
  end;
  if DoIsNamed(AName, ".tdata") then
    return ".tdata";
  end;
  if DoIsNamed(AName, ".tbss") then
    return ".tbss";
  end;
  if DoIsNamed(AName, ".gcc_except_table") then
    return ".gcc_except_table";
  end;
  return AName;
end;

public type
  // One link's ELF objects (see the header)
  ElfForeignLinker = object
    hidden FSet: ref SectionSet;
    hidden FMachine: ref ElfMachine;
    hidden FTree: ref SyntaxTree;
    hidden FDiagnostics: ref Diagnostics;
    hidden FFailed: bool;
    hidden FArchives: array of ref ElfArchive;
    hidden FMerges: array of ref ElfMerge;
    hidden FLoads: int64;
    // A name -> the archive entry its index names first (DoKey(archive, entry))
    hidden FMemberOf: ref StringIdMap;
    // A name -> the loaded definition that wins (DoKey(merge, symbol)); a name whose winner
    // is weak or common -> 1 (FWeakDefined / FCommon); the common's largest size
    hidden FDefinedBy: ref StringIdMap;
    hidden FWeakDefined: ref StringIdMap;
    hidden FCommon: ref StringIdMap;
    hidden FCommonSize: ref StringIdMap;
    // A COMDAT signature -> 1 once a kept copy is loaded
    hidden FGroups: ref StringIdMap;
    // A name a weak / a strong reference reached -> 1; the names in the set before Run
    hidden FWeakRefs: ref StringIdMap;
    hidden FStrongRefs: ref StringIdMap;
    // The needed names not looked at yet
    hidden FNeeds: StringArray;
    hidden FNeedCount: int64;

    init(const ASet: ref SectionSet; const AMachine: ref ElfMachine; const ATree: ref SyntaxTree;
      const ADiagnostics: ref Diagnostics);
    begin
      self.FSet := ASet;
      self.FMachine := AMachine;
      self.FTree := ATree;
      self.FDiagnostics := ADiagnostics;
      self.FFailed := false;
      self.FLoads := 0;
      self.FMemberOf := ref StringIdMap(0);
      self.FDefinedBy := ref StringIdMap(0);
      self.FWeakDefined := ref StringIdMap(0);
      self.FCommon := ref StringIdMap(0);
      self.FCommonSize := ref StringIdMap(0);
      self.FGroups := ref StringIdMap(0);
      self.FWeakRefs := ref StringIdMap(0);
      self.FStrongRefs := ref StringIdMap(0);
      self.FNeedCount := 0;
    end;

    // Where the AST node ANode is: NoPlace with no tree or no node
    hidden const method DoPlace(const ANode: int64): SourcePlace;
    begin
      if (self.FTree = nil) or (ANode = 0) then
        return NoPlace();
      end;
      return self.FTree[ANode].Place;
    end;

    // Reports ACode at ANode's place; the link has failed
    hidden method DoReport(const ACode: string; const ANode: int64; const ATemplate: string;
      const AArgs: MessageArgs);
    begin
      self.FDiagnostics.Add(Severity.Error, ACode, self.DoPlace(ANode), ATemplate, AArgs);
      self.FFailed := true;
    end;

    // AMerge reported damaged (EF0005) for the reason AReason
    hidden method DoDamaged(const AMerge: ref ElfMerge; const AReason: string);
    begin
      self.DoReport(ADAM_ERR_ELF_FOREIGN_005, AMerge.Node, ADAM_MSG_ELF_FOREIGN_DAMAGED,
        NoArgs().Str(AMerge.ObjectLabel).Str(AReason));
    end;

    // AMerge reported holding AWhat, which Adam does not link (EF0004)
    hidden method DoUnlinked(const AMerge: ref ElfMerge; const AWhat: string);
    begin
      self.DoReport(ADAM_ERR_ELF_FOREIGN_004, AMerge.Node, ADAM_MSG_ELF_FOREIGN_UNLINKED,
        NoArgs().Str(AMerge.ObjectLabel).Str(AWhat));
    end;

    // AName put on the needs list
    hidden method DoNeed(const AName: string);
    begin
      if self.FNeedCount >= len(self.FNeeds) then
        setlength(self.FNeeds, self.FNeedCount * 2 + 16);
      end;
      self.FNeeds[self.FNeedCount] := AName;
      self.FNeedCount := self.FNeedCount + 1;
    end;

    // The static library AFilePath (named first by the reference at ANode) read whole, its
    // index's names kept where no earlier library has them; false after a report
    method AddArchive(const AFilePath: string; const ANode: int64): bool;
    var
      LArchive: ref ElfArchive;
      LIndex: int64;
      LS: int64;
      LSymbol: ArchiveSymbol;
    begin
      LArchive := ref ElfArchive(AFilePath);
      if not ReadAllBytes(AFilePath, LArchive.Bytes) then
        self.DoReport(ADAM_ERR_ELF_FOREIGN_001, ANode, ADAM_MSG_ELF_FOREIGN_UNREADABLE,
          NoArgs().Str(AFilePath));
        return false;
      end;
      if not ReadArchiveContents(LArchive.Bytes, AFilePath, self.DoPlace(ANode),
        self.FDiagnostics, LArchive.Contents) then
        self.FFailed := true;
        return false;
      end;
      setlength(LArchive.Loaded, len(LArchive.Contents.Entries));
      for LS := 0 to len(LArchive.Contents.Entries) - 1 do
        LArchive.Loaded[LS] := false;
      end;
      LIndex := len(self.FArchives);
      setlength(self.FArchives, LIndex + 1);
      self.FArchives[LIndex] := LArchive;
      for LS := 0 to len(LArchive.Contents.Symbols) - 1 do
        LSymbol := LArchive.Contents.Symbols[LS];
        if self.FMemberOf.Find(LSymbol.SymbolName) = 0 then
          self.FMemberOf.Put(LSymbol.SymbolName, DoKey(LIndex, LSymbol.Member));
        end;
      end;
      return true;
    end;

    // AMerge's import list from its section named AImportsName (see the header); EF0005 for
    // a list cut short
    hidden method DoImportList(const AMerge: ref ElfMerge; const AImportsName: string);
    var
      LSection: ElfSection;
      LLibrary: string;
      LName: string;
      LAt: int64;
      LEnd: int64;
      LNul: int64;
      LCount: int64;
      LI: int64;
    begin
      for LI := 1 to len(AMerge.Source.Sections) - 1 do
        LSection := AMerge.Source.Sections[LI];
        if (LSection.SectionName = AImportsName) and (LSection.DataAt > 0) then
          LAt := LSection.DataAt;
          LEnd := LSection.DataAt + LSection.DataSize;
          while LAt < LEnd do
            // a library then a name, each NUL-ended
            LNul := ArchiveNulAt(AMerge.Bytes, LAt, LEnd);
            if LNul < 0 then
              self.DoDamaged(AMerge, NoArgs().Str(AImportsName).Int(LAt - LSection.DataAt).Fill(
                ADAM_MSG_ELF_FOREIGN_REASON_IMPORT_LIST));
              return;
            end;
            LLibrary := ArchiveText(AMerge.Bytes, LAt, LNul - LAt);
            LAt := LNul + 1;
            LNul := ArchiveNulAt(AMerge.Bytes, LAt, LEnd);
            if LNul < 0 then
              self.DoDamaged(AMerge, NoArgs().Str(AImportsName).Int(LAt - LSection.DataAt).Fill(
                ADAM_MSG_ELF_FOREIGN_REASON_IMPORT_LIST));
              return;
            end;
            LName := ArchiveText(AMerge.Bytes, LAt, LNul - LAt);
            LAt := LNul + 1;
            LCount := len(AMerge.ImportNames);
            setlength(AMerge.ImportLibraries, LCount + 1);
            setlength(AMerge.ImportNames, LCount + 1);
            AMerge.ImportLibraries[LCount] := LLibrary;
            AMerge.ImportNames[LCount] := LName;
            AMerge.ImportOf.Put(LName, LCount + 1);
          end;
          return;
        end;
      end;
    end;

    // The signature of the group section AGroup of AMerge: its sh_info symbol's name; ""
    // after EF0005
    hidden method DoSignature(const AMerge: ref ElfMerge; const AGroup: int64): string;
    var
      LInfo: int64;
    begin
      LInfo := AMerge.Source.Sections[AGroup].Info;
      if (LInfo <= 0) or (LInfo >= len(AMerge.Source.Symbols)) or
        (AMerge.Source.Symbols[LInfo].SymbolName = "") then
        self.DoDamaged(AMerge, NoArgs().Int(AGroup).Fill(ADAM_MSG_ELF_FOREIGN_REASON_SIGNATURE));
        return "";
      end;
      return AMerge.Source.Symbols[LInfo].SymbolName;
    end;

    // Which of AMerge's sections are kept (see the header): COMDAT groups chosen, the ones
    // an image never holds dropped, the .eh_frame to cut marked
    hidden method DoChoose(const AMerge: ref ElfMerge);
    var
      LCount: int64;
      LSection: ElfSection;
      LGroupKept: BoolArray;
      LSignature: string;
      LSymbol: int64;
      LI: int64;
    begin
      LCount := len(AMerge.Source.Sections);
      setlength(AMerge.Kept, LCount);
      setlength(AMerge.EhFrame, LCount);
      setlength(AMerge.SetSection, LCount);
      setlength(AMerge.BaseSymbol, LCount);
      setlength(LGroupKept, LCount);
      for LI := 0 to LCount - 1 do
        AMerge.Kept[LI] := false;
        AMerge.EhFrame[LI] := false;
        AMerge.SetSection[LI] := 0;
        AMerge.BaseSymbol[LI] := 0;
        LGroupKept[LI] := true;
      end;
      // a COMDAT group kept when its signature is new to the link
      for LI := 1 to LCount - 1 do
        LSection := AMerge.Source.Sections[LI];
        if (LSection.SectionType = int64(SHT_GROUP)) and
          ((LSection.GroupFlags & int64(GRP_COMDAT)) <> 0) then
          LSignature := self.DoSignature(AMerge, LI);
          if LSignature = "" then
            return;
          end;
          LSymbol := self.FSet.FindSymbol(LSignature);
          if (self.FGroups.Find(LSignature) <> 0) or
            ((LSymbol <> 0) and (self.FSet.SymbolAt(LSymbol).Kind = SymbolKind.Defined)) then
            LGroupKept[LI] := false;
          else
            self.FGroups.Put(LSignature, 1);
          end;
        end;
      end;
      for LI := 1 to LCount - 1 do
        LSection := AMerge.Source.Sections[LI];
        if DoHasFlag(LSection.Flags, SHF_ALLOC) and (not DoHasFlag(LSection.Flags, SHF_EXCLUDE)) and
          (LSection.SectionType <> int64(SHT_NOTE)) and (LSection.SectionType <> int64(SHT_GROUP)) and
          ((LSection.Group = 0) or LGroupKept[LSection.Group]) then
          AMerge.Kept[LI] := true;
          if ((LSection.SectionName = ADAM_ELF_FOREIGN_EH_FRAME) or
            (LSection.SectionType = int64(SHT_X86_64_UNWIND))) and
            (not DoHasFlag(LSection.Flags, SHF_LINK_ORDER)) then
            AMerge.EhFrame[LI] := true;
          end;
        end;
      end;
      // a LINK_ORDER section goes with its partner: dropped with it
      for LI := 1 to LCount - 1 do
        LSection := AMerge.Source.Sections[LI];
        if AMerge.Kept[LI] and DoHasFlag(LSection.Flags, SHF_LINK_ORDER) then
          if (LSection.Link <= 0) or (LSection.Link >= LCount) or (not AMerge.Kept[LSection.Link]) then
            AMerge.Kept[LI] := false;
          end;
        end;
      end;
    end;

    // AMerge's definitions registered (see the header): a strong one over a weak one, two
    // strong EF0003, commons by their largest size; its references put on the needs list
    // (a strong one) or noted (a weak one)
    hidden method DoRegister(const AMerge: ref ElfMerge; const AIndex: int64);
    var
      LSymbol: ElfSymbol;
      LKey: int64;
      LSet: int64;
      LStrong: bool;
      LWeakKnown: bool;
      LI: int64;
    begin
      for LI := AMerge.Source.FirstGlobal to len(AMerge.Source.Symbols) - 1 do
        LSymbol := AMerge.Source.Symbols[LI];
        if (LSymbol.SymbolName = "") or (LSymbol.Bind = int64(STB_LOCAL)) then
          skip;
        end;
        if LSymbol.SectionIndex = int64(SHN_UNDEF) then
          if LSymbol.Bind = int64(STB_WEAK) then
            self.FWeakRefs.Put(LSymbol.SymbolName, 1);
          else
            self.FStrongRefs.Put(LSymbol.SymbolName, 1);
            self.DoNeed(LSymbol.SymbolName);
          end;
          skip;
        end;
        if LSymbol.SectionIndex = int64(SHN_ABS) then
          self.DoUnlinked(AMerge, NoArgs().Str(LSymbol.SymbolName).Fill(
            ADAM_MSG_ELF_FOREIGN_FORM_ABSOLUTE));
          skip;
        end;
        if LSymbol.SymbolType = int64(STT_GNU_IFUNC) then
          self.DoUnlinked(AMerge, NoArgs().Str(LSymbol.SymbolName).Fill(
            ADAM_MSG_ELF_FOREIGN_FORM_IFUNC));
          skip;
        end;
        // a symbol of a dropped section (a discarded COMDAT copy): the kept copy defines it
        if (LSymbol.SectionIndex <> int64(SHN_COMMON)) and
          ((LSymbol.SectionIndex <= 0) or (LSymbol.SectionIndex >= len(AMerge.Kept)) or
          (not AMerge.Kept[LSymbol.SectionIndex])) then
          skip;
        end;
        LStrong := (LSymbol.Bind <> int64(STB_WEAK)) and (LSymbol.SectionIndex <> int64(SHN_COMMON));
        // the set's own definition (a unit's) is strong
        LSet := self.FSet.FindSymbol(LSymbol.SymbolName);
        if (LSet <> 0) and (self.FSet.SymbolAt(LSet).Kind <> SymbolKind.Undefined) then
          if LStrong and (self.FSet.SymbolAt(LSet).Kind = SymbolKind.Defined) then
            self.DoReport(ADAM_ERR_ELF_FOREIGN_003, AMerge.NodeOf(LSymbol.SymbolName),
              ADAM_MSG_ELF_FOREIGN_TWICE, NoArgs().Str(LSymbol.SymbolName).Str(AMerge.ObjectLabel));
          end;
          skip;
        end;
        LKey := self.FDefinedBy.Find(LSymbol.SymbolName);
        if LKey = 0 then
          self.FDefinedBy.Put(LSymbol.SymbolName, DoKey(AIndex, LI));
          if not LStrong then
            self.FWeakDefined.Put(LSymbol.SymbolName, 1);
          end;
          if LSymbol.SectionIndex = int64(SHN_COMMON) then
            self.FCommon.Put(LSymbol.SymbolName, 1);
            self.FCommonSize.Put(LSymbol.SymbolName, LSymbol.SymbolSize + 1);
          end;
          skip;
        end;
        LWeakKnown := self.FWeakDefined.Find(LSymbol.SymbolName) <> 0;
        if LStrong and LWeakKnown then
          // a strong definition replaces a weak or common one
          self.FDefinedBy.Put(LSymbol.SymbolName, DoKey(AIndex, LI));
          self.FWeakDefined.Put(LSymbol.SymbolName, 0);
          self.FCommon.Put(LSymbol.SymbolName, 0);
          skip;
        end;
        if LStrong then
          self.DoReport(ADAM_ERR_ELF_FOREIGN_003, AMerge.NodeOf(LSymbol.SymbolName),
            ADAM_MSG_ELF_FOREIGN_TWICE, NoArgs().Str(LSymbol.SymbolName).Str(AMerge.ObjectLabel));
          skip;
        end;
        // a second common keeps the first's place, the larger size
        if (LSymbol.SectionIndex = int64(SHN_COMMON)) and (self.FCommon.Find(LSymbol.SymbolName) <> 0) and
          (LSymbol.SymbolSize + 1 > self.FCommonSize.Find(LSymbol.SymbolName)) then
          self.FCommonSize.Put(LSymbol.SymbolName, LSymbol.SymbolSize + 1);
        end;
      end;
    end;

    // The object ABytes (its ASize bytes at AStart), read under ALabel at ANode as the
    // archive AArchive's member (-1: a unit's own), loaded: read, its machine and type
    // checked, its sections chosen, its names registered; nil after a report
    hidden method DoLoad(const ABytes: ByteArray; const AStart: int64; const ASize: int64;
      const AArchive: int64; const ALabel: string; const ANode: int64): ref ElfMerge;
    var
      LMerge: ref ElfMerge;
      LIndex: int64;
    begin
      self.FLoads := self.FLoads + 1;
      LMerge := ref ElfMerge(AArchive, ALabel, ANode, self.FLoads);
      LMerge.Bytes := ABytes;
      if not ReadElfObject(ABytes, AStart, ASize, ALabel, self.DoPlace(ANode), self.FDiagnostics,
        LMerge.Source) then
        self.FFailed := true;
        return nil;
      end;
      if (LMerge.Source.Machine <> self.FMachine.Machine) or
        (LMerge.Source.FileType <> int64(ET_REL)) then
        self.DoReport(ADAM_ERR_ELF_FOREIGN_002, ANode, ADAM_MSG_ELF_FOREIGN_MACHINE,
          NoArgs().Str(ALabel).Str(HexText(LMerge.Source.Machine)).Int(LMerge.Source.FileType).Str(
          HexText(self.FMachine.Machine)));
        return nil;
      end;
      LIndex := len(self.FMerges);
      setlength(self.FMerges, LIndex + 1);
      self.FMerges[LIndex] := LMerge;
      self.DoChoose(LMerge);
      self.DoRegister(LMerge, LIndex);
      return LMerge;
    end;

    // The unit object ABytes (ALabel, at ANode; a reference to a name ANodes holds at that
    // node; its import list in its section named AImportsName) loaded whole (see the
    // header); false after a report
    method AddObject(const ABytes: ByteArray; const ALabel: string; const ANode: int64;
      const ANodes: ref StringIdMap; const AImportsName: string): bool;
    var
      LMerge: ref ElfMerge;
    begin
      LMerge := self.DoLoad(ABytes, 0, len(ABytes), -1, ALabel, ANode);
      if LMerge = nil then
        return false;
      end;
      LMerge.Nodes := ANodes;
      self.DoImportList(LMerge, AImportsName);
      return not self.FFailed;
    end;

    // The archive member the key AKey (DoKey(archive, entry)) names loaded once, at ANode
    hidden method DoLoadMember(const AKey: int64; const ANode: int64);
    var
      LArchive: ref ElfArchive;
      LEntry: ArchiveEntry;
      LMember: int64;
    begin
      LArchive := self.FArchives[DoKeyOuter(AKey)];
      LMember := DoKeyInner(AKey);
      if LArchive.Loaded[LMember] then
        return;
      end;
      LArchive.Loaded[LMember] := true;
      LEntry := LArchive.Contents.Entries[LMember];
      self.DoLoad(LArchive.Bytes, LEntry.DataAt, LEntry.Size, DoKeyOuter(AKey),
        ExtractFileName(LArchive.FilePath) + "(" + LEntry.EntryName + ")", ANode);
    end;

    // Every needed name bound (see the header): the set's or a loaded object's definition,
    // else the member the index names (loaded: its own needs join the list)
    hidden method DoSearch();
    var
      LName: string;
      LSet: int64;
      LKey: int64;
      LNode: int64;
      LAt: int64;
      LId: int64;
    begin
      for LId := 1 to self.FSet.SymbolCount - 1 do
        if (self.FSet.SymbolAt(LId).Kind = SymbolKind.Undefined) and
          (not self.FSet.SymbolAt(LId).GroupStart) and
          (self.FSet.FindSymbol(self.FSet.SymbolAt(LId).SymbolName) = LId) then
          self.FStrongRefs.Put(self.FSet.SymbolAt(LId).SymbolName, 1);
          self.DoNeed(self.FSet.SymbolAt(LId).SymbolName);
        end;
      end;
      LAt := 0;
      while (LAt < self.FNeedCount) and (not self.FFailed) do
        LName := self.FNeeds[LAt];
        LAt := LAt + 1;
        LSet := self.FSet.FindSymbol(LName);
        if (LSet <> 0) and (self.FSet.SymbolAt(LSet).Kind <> SymbolKind.Undefined) then
          skip;
        end;
        if self.FDefinedBy.Find(LName) <> 0 then
          skip;
        end;
        LKey := self.FMemberOf.Find(LName);
        if LKey <> 0 then
          LNode := 0;
          if LSet <> 0 then
            LNode := self.FSet.SymbolAt(LSet).Node;
          end;
          self.DoLoadMember(LKey, LNode);
        end;
      end;
    end;

    // The set section of AMerge's section AIndex made (see the header): its unique name, its
    // kind, group, removal facts and bytes
    hidden method DoSection(const AMerge: ref ElfMerge; const AIndex: int64);
    var
      LSection: ElfSection;
      LKind: SectionKind;
      LAlign: int64;
      LId: int64;
      LBytes: ByteArray;
      LGroup: string;
    begin
      LSection := AMerge.Source.Sections[AIndex];
      LAlign := LSection.Align;
      if LAlign < 1 then
        LAlign := 1;
      end;
      if (not IsPowerOfTwo(LAlign)) or (LAlign > self.FMachine.PageSize) then
        self.DoUnlinked(AMerge, NoArgs().Str(LSection.SectionName).Int(LAlign).Int(
          self.FMachine.PageSize).Fill(ADAM_MSG_ELF_FOREIGN_FORM_ALIGN));
        return;
      end;
      // the strongest fact last: TLS over EXECINSTR over NOBITS over WRITE
      LKind := SectionKind.ReadOnly;
      if DoHasFlag(LSection.Flags, SHF_WRITE) then
        LKind := SectionKind.Data;
      end;
      if LSection.SectionType = int64(SHT_NOBITS) then
        LKind := SectionKind.Zeroed;
      end;
      if DoHasFlag(LSection.Flags, SHF_EXECINSTR) then
        LKind := SectionKind.Code;
      end;
      if DoHasFlag(LSection.Flags, SHF_TLS) then
        LKind := SectionKind.ThreadLocal;
      end;
      LId := self.FSet.AddSection(LSection.SectionName + ADAM_ELF_FOREIGN_MARK + AMerge.ObjectLabel +
        ADAM_ELF_FOREIGN_MARK + IntToStr(AMerge.Serial) + "." + IntToStr(AIndex), LKind, LAlign);
      AMerge.SetSection[AIndex] := LId;
      LGroup := ElfGroupOf(LSection.SectionName, LSection.SectionType);
      self.FSet.SectionAt(LId).GroupName := LGroup;
      // gc-sections: the arrays and C identifier sections are roots
      self.FSet.SectionAt(LId).Removable := not (StartsStr(ADAM_ELF_FOREIGN_INIT_ARRAY, LGroup) or
        StartsStr(ADAM_ELF_FOREIGN_FINI_ARRAY, LGroup) or (LGroup = ADAM_ELF_FOREIGN_PREINIT_ARRAY) or
        (ElfIsCIdentifier(LGroup) and (not DoHasFlag(LSection.Flags, SHF_LINK_ORDER))));
      // a unit's line table: what it names keeps nothing, a dropped copy's field reads 0
      self.FSet.SectionAt(LId).Tombstone := EndsStr(ADAM_ELF_TOMBSTONE_SUFFIX, LSection.SectionName);
      if (LKind = SectionKind.Zeroed) or (LSection.SectionType = int64(SHT_NOBITS)) then
        self.FSet.SectionAt(LId).PutZeros(LSection.DataSize);
        return;
      end;
      if LSection.DataSize > 0 then
        setlength(LBytes, LSection.DataSize);
        CopyBytes(addr of LBytes[0], addr of AMerge.Bytes[LSection.DataAt], LSection.DataSize);
        self.FSet.SectionAt(LId).PutBytes(LBytes);
      end;
    end;

    // The internal symbol at offset 0 of AMerge's kept section AIndex (made once)
    hidden method DoBase(const AMerge: ref ElfMerge; const AIndex: int64): int64;
    var
      LId: int64;
    begin
      if AMerge.BaseSymbol[AIndex] = 0 then
        LId := self.FSet.DefineSymbol(self.FSet.SectionAt(AMerge.SetSection[AIndex]).SectionName +
          ADAM_ELF_FOREIGN_BASE_SUFFIX, AMerge.SetSection[AIndex], 0, AMerge.Node);
        self.FSet.MakeInternal(LId);
        AMerge.BaseSymbol[AIndex] := LId;
      end;
      return AMerge.BaseSymbol[AIndex];
    end;

    // The names AMerge won defined in the set; a common one in zeroed storage of its own
    hidden method DoDefine(const AMerge: ref ElfMerge; const AIndex: int64);
    var
      LSymbol: ElfSymbol;
      LKey: int64;
      LAlign: int64;
      LSize: int64;
      LId: int64;
      LI: int64;
    begin
      for LI := AMerge.Source.FirstGlobal to len(AMerge.Source.Symbols) - 1 do
        LSymbol := AMerge.Source.Symbols[LI];
        if (LSymbol.SymbolName = "") or (LSymbol.SectionIndex = int64(SHN_UNDEF)) or
          (LSymbol.Bind = int64(STB_LOCAL)) then
          skip;
        end;
        LKey := self.FDefinedBy.Find(LSymbol.SymbolName);
        if LKey <> DoKey(AIndex, LI) then
          skip;
        end;
        if LSymbol.SectionIndex = int64(SHN_COMMON) then
          LAlign := LSymbol.SymbolValue;
          if (LAlign < 1) or (not IsPowerOfTwo(LAlign)) then
            LAlign := 1;
          end;
          LSize := self.FCommonSize.Find(LSymbol.SymbolName) - 1;
          LId := self.FSet.AddSection(".bss" + ADAM_ELF_FOREIGN_MARK + LSymbol.SymbolName,
            SectionKind.Zeroed, LAlign);
          self.FSet.SectionAt(LId).GroupName := ".bss";
          self.FSet.SectionAt(LId).Removable := true;
          self.FSet.SectionAt(LId).PutZeros(LSize);
          self.FSet.DefineSymbol(LSymbol.SymbolName, LId, 0, AMerge.NodeOf(LSymbol.SymbolName));
          skip;
        end;
        if (LSymbol.SymbolValue < 0) or
          (LSymbol.SymbolValue > self.FSet.SectionAt(AMerge.SetSection[LSymbol.SectionIndex]).Size()) then
          self.DoDamaged(AMerge, NoArgs().Str(LSymbol.SymbolName).Fill(
            ADAM_MSG_ELF_FOREIGN_REASON_PAST_SECTION));
          skip;
        end;
        self.FSet.DefineSymbol(LSymbol.SymbolName, AMerge.SetSection[LSymbol.SectionIndex],
          LSymbol.SymbolValue, AMerge.NodeOf(LSymbol.SymbolName));
      end;
    end;

    // The set symbol and addend a relocation of AMerge to its symbol record ASymbol with
    // addend AAddend reaches into ATarget / AAddendOut: a local through its section's base
    // (its value added), a name by name; false after a report (a section the link dropped)
    hidden method DoTarget(const AMerge: ref ElfMerge; const ASymbol: int64; const AAddend: int64;
      var ATarget: int64; var AAddendOut: int64): bool;
    var
      LSymbol: ElfSymbol;
    begin
      LSymbol := AMerge.Source.Symbols[ASymbol];
      AAddendOut := AAddend;
      if (LSymbol.Bind = int64(STB_LOCAL)) or (LSymbol.SymbolName = "") then
        if (LSymbol.SectionIndex <= 0) or (LSymbol.SectionIndex >= len(AMerge.Kept)) or
          (not AMerge.Kept[LSymbol.SectionIndex]) or (AMerge.SetSection[LSymbol.SectionIndex] = 0) then
          self.DoReport(ADAM_ERR_ELF_FOREIGN_006, AMerge.Node, ADAM_MSG_ELF_FOREIGN_DROPPED,
            NoArgs().Str(AMerge.ObjectLabel).Str(LSymbol.SymbolName).Int(LSymbol.SectionIndex));
          return false;
        end;
        ATarget := self.DoBase(AMerge, LSymbol.SectionIndex);
        AAddendOut := AAddend + LSymbol.SymbolValue;
        return true;
      end;
      ATarget := self.FSet.FindSymbol(LSymbol.SymbolName);
      if ATarget = 0 then
        ATarget := self.FSet.ReferSymbol(LSymbol.SymbolName, AMerge.NodeOf(LSymbol.SymbolName));
      end;
      return true;
    end;

    // The local GOT slot of the set symbol ATarget plus AAddend (made once per link: its own
    // Removable 8-byte data section in .got, an Abs64 of the target); the slot's symbol
    hidden method DoGotSlot(const ATarget: int64; const AAddend: int64; const ANode: int64): int64;
    var
      LName: string;
      LId: int64;
      LSlot: int64;
    begin
      LName := ADAM_ELF_FOREIGN_GOT_PREFIX + self.FSet.SymbolAt(ATarget).SymbolName + "+" +
        IntToStr(AAddend);
      LSlot := self.FSet.FindSymbol(LName);
      if LSlot <> 0 then
        return LSlot;
      end;
      LId := self.FSet.AddSection(LName, SectionKind.Data, ADAM_ELF_FOREIGN_SLOT_SIZE);
      self.FSet.SectionAt(LId).GroupName := ADAM_ELF_FOREIGN_GOT;
      self.FSet.SectionAt(LId).Removable := true;
      self.FSet.SectionAt(LId).PutZeros(ADAM_ELF_FOREIGN_SLOT_SIZE);
      self.FSet.AddReloc(LId, 0, RelocKind.Abs64, ATarget, AAddend);
      LSlot := self.FSet.DefineSymbol(LName, LId, 0, ANode);
      self.FSet.MakeInternal(LSlot);
      return LSlot;
    end;

    // The set's tombstone target (ADAM_ELF_FOREIGN_TOMBSTONE_SYMBOL), made the first time
    hidden method DoTombstoneTarget(): int64;
    var
      LId: int64;
      LSection: int64;
    begin
      LId := self.FSet.FindSymbol(ADAM_ELF_FOREIGN_TOMBSTONE_SYMBOL);
      if LId <> 0 then
        return LId;
      end;
      LSection := self.FSet.AddSection(ADAM_ELF_FOREIGN_TOMBSTONE_SECTION, SectionKind.ReadOnly, 1);
      self.FSet.SectionAt(LSection).GroupName := ADAM_ELF_FOREIGN_TOMBSTONE_GROUP;
      self.FSet.SectionAt(LSection).Removable := true;
      return self.FSet.DefineSymbol(ADAM_ELF_FOREIGN_TOMBSTONE_SYMBOL, LSection, 0, 0);
    end;

    // True when AMerge's symbol record ASymbol is defined in a section of its object the link
    // left out (a discarded COMDAT copy's), by any binding
    hidden const method DoInDroppedSection(const AMerge: ref ElfMerge; const ASymbol: int64): bool;
    var
      LIndex: int64;
    begin
      LIndex := AMerge.Source.Symbols[ASymbol].SectionIndex;
      return (LIndex > 0) and (LIndex < len(AMerge.Kept)) and (not AMerge.Kept[LIndex]);
    end;

    // AMerge's relocation AReloc, its field at AOffset of the set section ASetSection,
    // added to the set by the arch's types (see the header); false after a report
    hidden method DoReloc(const AMerge: ref ElfMerge; const AReloc: ElfReloc; const ASetSection: int64;
      const AOffset: int64): bool;
    var
      LTarget: int64;
      LAddend: int64;
      LKind: RelocKind;
      LName: string;
      LImport: int64;
      LSlot: int64;
      LType: int64;
      LGot: bool;
    begin
      LType := AReloc.RelocType;
      if LType = self.FMachine.RelocNone then
        return true;
      end;
      LGot := self.FMachine.HoldsType(self.FMachine.GotRelTypes, LType);
      LKind := RelocKind.Rel32;
      if (not LGot) and (not self.FMachine.HoldsType(self.FMachine.PcRelTypes, LType)) then
        if LType = self.FMachine.RelocAbs64 then
          LKind := RelocKind.Abs64;
        else
          if LType = self.FMachine.RelocTpOff32 then
            LKind := RelocKind.TpOff32;
          else
            if LType <> self.FMachine.RelocDtpOff32 then
              self.DoUnlinked(AMerge, NoArgs().Int(LType).Str(
                self.FSet.SectionAt(ASetSection).SectionName).Fill(ADAM_MSG_ELF_FOREIGN_FORM_RELOC));
              return false;
            end;
            LKind := RelocKind.SecRel32;
            // in code: a local-dynamic access, its base the thread pointer once relaxed
            if self.FSet.SectionAt(ASetSection).Kind = SectionKind.Code then
              LKind := RelocKind.TpOff32;
            end;
          end;
        end;
      end;
      if (AOffset < 0) or (AOffset + RelocWidth(LKind) > self.FSet.SectionAt(ASetSection).Size()) then
        self.DoDamaged(AMerge, NoArgs().Str(self.FSet.SectionAt(ASetSection).SectionName).Int(
          AReloc.Offset).Fill(ADAM_MSG_ELF_FOREIGN_REASON_RELOC_PLACE));
        return false;
      end;
      // a unit's GOT reference to its import: the import's slot
      if LGot then
        LName := AMerge.Source.Symbols[AReloc.SymbolIndex].SymbolName;
        LImport := AMerge.ImportOf.Find(LName);
        if (LImport <> 0) and (AMerge.Source.Symbols[AReloc.SymbolIndex].SectionIndex = int64(SHN_UNDEF)) then
          LSlot := self.FSet.ImportSymbol(AMerge.ImportLibraries[LImport - 1],
            AMerge.ImportNames[LImport - 1], AMerge.NodeOf(LName));
          self.FSet.AddReloc(ASetSection, AOffset, RelocKind.Rel32, LSlot,
            AReloc.Addend + ADAM_ELF_FOREIGN_FIELD_32);
          return true;
        end;
      end;
      // a Tombstone section's (a unit's line table's) field for code of a COMDAT copy left out
      // reads 0 (the kept copy's code is another unit's, its rows not these)
      if self.FSet.SectionAt(ASetSection).Tombstone and
        self.DoInDroppedSection(AMerge, AReloc.SymbolIndex) then
        LTarget := self.DoTombstoneTarget();
        LAddend := 0;
      else
        if not self.DoTarget(AMerge, AReloc.SymbolIndex, AReloc.Addend, LTarget, LAddend) then
          return false;
        end;
      end;
      if LGot then
        // the slot holds the target (its own addend); the field reaches the slot
        LSlot := self.DoGotSlot(LTarget, LAddend - AReloc.Addend, AMerge.Node);
        self.FSet.AddReloc(ASetSection, AOffset, RelocKind.Rel32, LSlot,
          AReloc.Addend + ADAM_ELF_FOREIGN_FIELD_32);
        return true;
      end;
      if LKind = RelocKind.Rel32 then
        // S + A - P is S + (A + 4) - (P + 4)
        LAddend := LAddend + ADAM_ELF_FOREIGN_FIELD_32;
      end;
      self.FSet.AddReloc(ASetSection, AOffset, LKind, LTarget, LAddend);
      return true;
    end;

    // True when the bytes at AAt of the set section ASection are ABytes
    hidden const method DoBytesAre(const ASection: int64; const AAt: int64; const ABytes: ByteArray): bool;
    var
      LSection: ref Section;
      LI: int64;
    begin
      LSection := self.FSet.SectionAt(ASection);
      if (AAt < 0) or (AAt + len(ABytes) > LSection.Size()) then
        return false;
      end;
      for LI := 0 to len(ABytes) - 1 do
        if LSection.Bytes[AAt + LI] <> ABytes[LI] then
          return false;
        end;
      end;
      return true;
    end;

    // ABytes written over the set section ASection at AAt
    hidden method DoPatch(const ASection: int64; const AAt: int64; const ABytes: ByteArray);
    var
      LI: int64;
    begin
      for LI := 0 to len(ABytes) - 1 do
        self.FSet.SectionAt(ASection).Patch8(AAt + LI, uint64(ABytes[LI]));
      end;
    end;

    // The index of AByte in ABytes; -1 none
    hidden const method DoIndexOf(const ABytes: ByteArray; const AByte: uint8): int64;
    var
      LI: int64;
    begin
      for LI := 0 to len(ABytes) - 1 do
        if ABytes[LI] = AByte then
          return LI;
        end;
      end;
      return -1;
    end;

    // True when AMerge's relocation AIndex (below AEnd) is a pc-relative call field at
    // AOffset of the arch's __tls_get_addr
    hidden const method DoIsTlsCall(const AMerge: ref ElfMerge; const AIndex: int64; const AEnd: int64;
      const AOffset: int64): bool;
    var
      LReloc: ElfReloc;
    begin
      if AIndex >= AEnd then
        return false;
      end;
      LReloc := AMerge.Source.Relocs[AIndex];
      return (LReloc.Offset = AOffset) and self.FMachine.HoldsType(self.FMachine.PcRelTypes,
        LReloc.RelocType) and
        (AMerge.Source.Symbols[LReloc.SymbolIndex].SymbolName = self.FMachine.TlsGetAddr);
    end;

    // AMerge's thread-local relocation AIndex (below AEnd, of the set section ASetSection)
    // relaxed to local-exec (see the header); AUsed the relocations it took (2 with the
    // call); false after a report
    hidden method DoRelaxTls(const AMerge: ref ElfMerge; const AIndex: int64; const AEnd: int64;
      const ASetSection: int64; var AUsed: int64): bool;
    var
      LReloc: ElfReloc;
      LTarget: int64;
      LAddend: int64;
      LStart: int64;
      LField: int64;
      LRex: int64;
      LOp: int64;
      LModRm: int64;
      LDone: bool;
    begin
      LReloc := AMerge.Source.Relocs[AIndex];
      LField := LReloc.Offset;
      AUsed := 1;
      LDone := false;
      if LReloc.RelocType = self.FMachine.RelocTlsGd then
        // the sequence: TlsGdBefore, the TLSGD field, TlsGdAfter, the call's field
        LStart := LField - len(self.FMachine.TlsGdBefore);
        if self.DoBytesAre(ASetSection, LStart, self.FMachine.TlsGdBefore) and
          self.DoBytesAre(ASetSection, LField + ADAM_ELF_FOREIGN_FIELD_32, self.FMachine.TlsGdAfter) and
          self.DoIsTlsCall(AMerge, AIndex + 1, AEnd, LField + ADAM_ELF_FOREIGN_FIELD_32 +
          len(self.FMachine.TlsGdAfter)) and (LStart + len(self.FMachine.TlsGdLe) =
          LField + ADAM_ELF_FOREIGN_FIELD_32 * 2 + len(self.FMachine.TlsGdAfter)) then
          if not self.DoTarget(AMerge, LReloc.SymbolIndex, LReloc.Addend + ADAM_ELF_FOREIGN_FIELD_32,
            LTarget, LAddend) then
            return false;
          end;
          self.DoPatch(ASetSection, LStart, self.FMachine.TlsGdLe);
          self.FSet.AddReloc(ASetSection, LStart + self.FMachine.TlsGdLeAt, RelocKind.TpOff32,
            LTarget, LAddend);
          AUsed := 2;
          LDone := true;
        end;
      end;
      if LReloc.RelocType = self.FMachine.RelocTlsLd then
        // the sequence: TlsLdBefore, the TLSLD field, TlsLdAfter, the call's field
        LStart := LField - len(self.FMachine.TlsLdBefore);
        if self.DoBytesAre(ASetSection, LStart, self.FMachine.TlsLdBefore) and
          self.DoBytesAre(ASetSection, LField + ADAM_ELF_FOREIGN_FIELD_32, self.FMachine.TlsLdAfter) and
          self.DoIsTlsCall(AMerge, AIndex + 1, AEnd, LField + ADAM_ELF_FOREIGN_FIELD_32 +
          len(self.FMachine.TlsLdAfter)) and (LStart + len(self.FMachine.TlsLdLe) =
          LField + ADAM_ELF_FOREIGN_FIELD_32 * 2 + len(self.FMachine.TlsLdAfter)) then
          self.DoPatch(ASetSection, LStart, self.FMachine.TlsLdLe);
          AUsed := 2;
          LDone := true;
        end;
      end;
      if (LReloc.RelocType = self.FMachine.RelocGotTpOff) and (LField >= 3) and
        (LField + ADAM_ELF_FOREIGN_FIELD_32 <= self.FSet.SectionAt(ASetSection).Size()) then
        // the instruction: a REX prefix, an opcode, a rip-relative ModRM, the field
        LRex := self.DoIndexOf(self.FMachine.GotTpOffRex, self.FSet.SectionAt(ASetSection).Bytes[LField - 3]);
        LOp := self.DoIndexOf(self.FMachine.GotTpOffOps, self.FSet.SectionAt(ASetSection).Bytes[LField - 2]);
        LModRm := int64(self.FSet.SectionAt(ASetSection).Bytes[LField - 1]);
        if (LRex >= 0) and (LOp >= 0) and ((LModRm & self.FMachine.ModRmRipMask) = self.FMachine.ModRmRip) then
          if not self.DoTarget(AMerge, LReloc.SymbolIndex, LReloc.Addend + ADAM_ELF_FOREIGN_FIELD_32,
            LTarget, LAddend) then
            return false;
          end;
          self.FSet.SectionAt(ASetSection).Patch8(LField - 3, uint64(self.FMachine.GotTpOffRexLe[LRex]));
          self.FSet.SectionAt(ASetSection).Patch8(LField - 2, uint64(self.FMachine.GotTpOffOpsLe[LOp]));
          self.FSet.SectionAt(ASetSection).Patch8(LField - 1, uint64(self.FMachine.ModRmDirect |
            ((LModRm shr self.FMachine.ModRmRegShift) & self.FMachine.ModRmRegMask)));
          self.FSet.AddReloc(ASetSection, LField, RelocKind.TpOff32, LTarget, LAddend);
          LDone := true;
        end;
      end;
      if not LDone then
        self.DoUnlinked(AMerge, NoArgs().Int(LReloc.RelocType).Str(
          self.FSet.SectionAt(ASetSection).SectionName).Int(LField).Fill(ADAM_MSG_ELF_FOREIGN_FORM_TLS));
        return false;
      end;
      return true;
    end;

    // True when AType is one of the arch's thread-local types DoRelaxTls relaxes
    hidden const method DoIsTlsType(const AType: int64): bool;
    begin
      return (AType = self.FMachine.RelocTlsGd) or (AType = self.FMachine.RelocTlsLd) or
        (AType = self.FMachine.RelocGotTpOff);
    end;

    // The 32-bit little-endian word at AAt of AMerge's buffer
    hidden const method DoWord(const AMerge: ref ElfMerge; const AAt: int64): int64;
    begin
      return int64(GetLe(AMerge.Bytes, AAt, ADAM_ELF_FOREIGN_FIELD_32));
    end;

    // The section of AMerge a relocation's symbol record ASymbol is in (a local's, or a
    // name it defines in a kept section); 0 for none
    hidden const method DoSectionOfSymbol(const AMerge: ref ElfMerge; const ASymbol: int64): int64;
    var
      LSymbol: ElfSymbol;
    begin
      LSymbol := AMerge.Source.Symbols[ASymbol];
      if (LSymbol.SectionIndex <= 0) or (LSymbol.SectionIndex >= len(AMerge.Kept)) or
        (LSymbol.SectionIndex = int64(SHN_COMMON)) then
        return 0;
      end;
      if not AMerge.Kept[LSymbol.SectionIndex] then
        return 0;
      end;
      return LSymbol.SectionIndex;
    end;

    // AMerge's foreign .eh_frame AIndex cut into pieces (see the header): each FDE whose
    // function's section is kept a piece of its CIE and itself, Associate with that section
    hidden method DoEhFrame(const AMerge: ref ElfMerge; const AIndex: int64);
    var
      LSection: ElfSection;
      LCieOf: ref Int64Map;
      LAt: int64;
      LLength: int64;
      LEnd: int64;
      LId: int64;
      LCie: int64;
      LCieEnd: int64;
      LCieSize: int64;
      LTarget: int64;
      LPiece: int64;
      LBytes: ByteArray;
      LReloc: ElfReloc;
      LR: int64;
      LBegin: int64;
    begin
      LSection := AMerge.Source.Sections[AIndex];
      LCieOf := ref Int64Map(0);
      LAt := 0;
      while LAt + ADAM_ELF_FOREIGN_FIELD_32 <= LSection.DataSize do
        LLength := self.DoWord(AMerge, LSection.DataAt + LAt);
        if LLength = 0 then
          leave;
        end;
        if LLength = ADAM_ELF_FOREIGN_EH_64 then
          self.DoUnlinked(AMerge, NoArgs().Str(LSection.SectionName).Fill(
            ADAM_MSG_ELF_FOREIGN_FORM_EH_64));
          return;
        end;
        LEnd := LAt + ADAM_ELF_FOREIGN_FIELD_32 + LLength;
        if (LEnd > LSection.DataSize) or (LLength < ADAM_ELF_FOREIGN_FIELD_32) or
          ((LLength mod ADAM_ELF_FOREIGN_FIELD_32) <> 0) then
          self.DoDamaged(AMerge, NoArgs().Str(LSection.SectionName).Int(LAt).Fill(
            ADAM_MSG_ELF_FOREIGN_REASON_EH_RECORD));
          return;
        end;
        LId := self.DoWord(AMerge, LSection.DataAt + LAt + ADAM_ELF_FOREIGN_FIELD_32);
        if LId = 0 then
          // a CIE: where it ends, by where it starts
          LCieOf.Put(LAt, LEnd + 1);
          LAt := LEnd;
          skip;
        end;
        LCie := LAt + ADAM_ELF_FOREIGN_FIELD_32 - LId;
        LCieEnd := LCieOf.Find(LCie) - 1;
        if LCieEnd <= 0 then
          self.DoDamaged(AMerge, NoArgs().Str(LSection.SectionName).Int(LAt).Fill(
            ADAM_MSG_ELF_FOREIGN_REASON_EH_CIE));
          return;
        end;
        // the function: the section of the relocation at the FDE's start field
        LTarget := 0;
        for LR := LSection.RelocFirst to LSection.RelocFirst + LSection.RelocCount - 1 do
          if AMerge.Source.Relocs[LR].Offset = LAt + 2 * ADAM_ELF_FOREIGN_FIELD_32 then
            LTarget := self.DoSectionOfSymbol(AMerge, AMerge.Source.Relocs[LR].SymbolIndex);
          end;
        end;
        if (LTarget <> 0) and (AMerge.SetSection[LTarget] <> 0) then
          LCieSize := LCieEnd - LCie;
          LPiece := self.FSet.AddSection(LSection.SectionName + ADAM_ELF_FOREIGN_MARK +
            AMerge.ObjectLabel + ADAM_ELF_FOREIGN_MARK + IntToStr(AMerge.Serial) + "." +
            IntToStr(AIndex) + "." + IntToStr(LAt), SectionKind.ReadOnly, ADAM_ELF_FOREIGN_FIELD_32);
          self.FSet.SectionAt(LPiece).GroupName := ADAM_ELF_FOREIGN_EH_FRAME;
          self.FSet.SectionAt(LPiece).Removable := true;
          self.FSet.SectionAt(LPiece).Associate := AMerge.SetSection[LTarget];
          setlength(LBytes, LCieSize + (LEnd - LAt));
          CopyBytes(addr of LBytes[0], addr of AMerge.Bytes[LSection.DataAt + LCie], LCieSize);
          CopyBytes(addr of LBytes[LCieSize], addr of AMerge.Bytes[LSection.DataAt + LAt], LEnd - LAt);
          // the FDE's offset back to its CIE: now the piece's start
          PutLe(LBytes, LCieSize + ADAM_ELF_FOREIGN_FIELD_32,
            uint64(LCieSize + ADAM_ELF_FOREIGN_FIELD_32), ADAM_ELF_FOREIGN_FIELD_32);
          self.FSet.SectionAt(LPiece).PutBytes(LBytes);
          for LR := LSection.RelocFirst to LSection.RelocFirst + LSection.RelocCount - 1 do
            LReloc := AMerge.Source.Relocs[LR];
            LBegin := -1;
            if (LReloc.Offset >= LCie) and (LReloc.Offset < LCieEnd) then
              LBegin := LReloc.Offset - LCie;
            end;
            if (LReloc.Offset >= LAt) and (LReloc.Offset < LEnd) then
              LBegin := LReloc.Offset - LAt + LCieSize;
            end;
            if LBegin >= 0 then
              if not self.DoReloc(AMerge, LReloc, LPiece, LBegin) then
                return;
              end;
            end;
          end;
        end;
        LAt := LEnd;
      end;
    end;

    // AMerge (the AIndex-th loaded) merged into the set (see the header)
    hidden method DoMerge(const AMerge: ref ElfMerge; const AIndex: int64);
    var
      LSection: ElfSection;
      LCount: int64;
      LUsed: int64;
      LEnd: int64;
      LI: int64;
      LR: int64;
    begin
      LCount := len(AMerge.Source.Sections);
      for LI := 1 to LCount - 1 do
        if AMerge.Kept[LI] and (not AMerge.EhFrame[LI]) then
          self.DoSection(AMerge, LI);
        end;
      end;
      if self.FFailed then
        return;
      end;
      for LI := 1 to LCount - 1 do
        LSection := AMerge.Source.Sections[LI];
        if (AMerge.SetSection[LI] <> 0) and DoHasFlag(LSection.Flags, SHF_LINK_ORDER) then
          self.FSet.SectionAt(AMerge.SetSection[LI]).Associate := AMerge.SetSection[LSection.Link];
        end;
      end;
      self.DoDefine(AMerge, AIndex);
      for LI := 1 to LCount - 1 do
        if AMerge.SetSection[LI] <> 0 then
          LSection := AMerge.Source.Sections[LI];
          LR := LSection.RelocFirst;
          LEnd := LSection.RelocFirst + LSection.RelocCount;
          while LR < LEnd do
            LUsed := 1;
            if self.DoIsTlsType(AMerge.Source.Relocs[LR].RelocType) then
              // a thread-local access relaxed, with the call that may follow it
              if not self.DoRelaxTls(AMerge, LR, LEnd, AMerge.SetSection[LI], LUsed) then
                return;
              end;
            else
              if not self.DoReloc(AMerge, AMerge.Source.Relocs[LR], AMerge.SetSection[LI],
                AMerge.Source.Relocs[LR].Offset) then
                return;
              end;
            end;
            LR := LR + LUsed;
          end;
        end;
      end;
      for LI := 1 to LCount - 1 do
        if AMerge.Kept[LI] and AMerge.EhFrame[LI] then
          self.DoEhFrame(AMerge, LI);
        end;
      end;
    end;

    // Every loaded object merged, in load order
    hidden method DoMergeAll();
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FMerges) - 1 do
        if self.FFailed then
          return;
        end;
        self.DoMerge(self.FMerges[LI], LI);
      end;
    end;

    // The AddObject objects merged into the set, nothing searched; false after a report
    method MergeObjects(): bool;
    begin
      if not self.FFailed then
        self.DoMergeAll();
      end;
      return not self.FFailed;
    end;

    // The libraries searched for what the set and the loaded objects need, then every
    // loaded object merged (see the header); false after a report
    method Run(): bool;
    begin
      if not self.FFailed then
        self.DoSearch();
      end;
      if not self.FFailed then
        self.DoMergeAll();
      end;
      return not self.FFailed;
    end;

    // True when only weak references reached AName (no strong one: the set's or a loaded
    // object's)
    const method WeakOnly(const AName: string): bool;
    begin
      return (self.FWeakRefs.Find(AName) <> 0) and (self.FStrongRefs.Find(AName) = 0);
    end;
  end;

end.
