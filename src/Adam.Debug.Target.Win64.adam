-------------------------------------------------------------------------------
  Adam.Debug.Target.Win64.adam - Adam.Debug.Target's part for
  x86_64-windows-gnu (M11a D1)

  Win64DebugTarget keeps DebugTarget's rules (its header) over the Win32
  debugging API (System.Windows.Debug, the one unit it reaches Windows by):
  CreateProcessW under DEBUG_ONLY_THIS_PROCESS in a process group of its
  own (a console's Ctrl+C is the debugger's, which pauses it: Adam.Debug.
  Repl), then WaitForDebugEvent /
  ContinueDebugEvent on the caller's own thread. No thread of its own: an
  event it does not hold on (a thread's start or end, an unload, the
  program's own first-chance exception) is continued as it is taken, and
  in Pipes mode the output pipe is read between waits (NextEvent waits in
  slices of ADAM_DEBUG_WIN64_SLICE_MS while a pipe is open), so the program
  never blocks on a full pipe.

  Terminal mode: a pseudo console (CreatePseudoConsole over two plain
  pipes, nothing inherited) is the program's console, named by a
  STARTUPINFOEXW attribute list; its output pipe is read as Pipes' is
  (VT text), WriteInput writes its input pipe, ResizeTerminal resizes it.
  At the program's end it is closed on a task while this thread reads its
  output to the pipe's break (an older Windows' ClosePseudoConsole waits
  for that drain), so its last screen comes before ProcessExited.

  Steps: the trap flag (EFlags TF) gives one instruction, then a single-step
  exception on that thread. Getting past a patch: its byte put back, the
  other threads suspended, TF; the single step puts the int3 in again and
  resumes them (a user's step at a patch is the same single step, then its
  Step stop). A pause is DebugBreakProcess: Windows starts a thread in the
  program that hits an int3; the Pause stop names the main thread (the one
  a user means), Resume continues the break thread's event.

  The CONTEXT block is read and written in a buffer aligned here to 16
  bytes; DebugContext.Raw keeps its 1232 bytes as read.
*******************************************************************************/

module unit Adam.Debug.Target.Win64;

import System.SysUtils, System.Runtime, System.Windows, System.Windows.Debug, Adam.Core.Common,
  Adam.Core.Messages, Adam.Compiler.Diagnostics, Adam.Debug.Target;

const
  // The int3 a patch writes
  ADAM_DEBUG_WIN64_INT3: uint8 = 0xCC;
  // The bytes an x86_64 instruction takes at most (a call's return address lies within them)
  ADAM_DEBUG_WIN64_INSTRUCTION_MAX: uint64 = 15;
  // How long one wait for a debug event lasts while the output pipe is open (ms): the pipe is
  // read between waits (pcpp's output poll)
  ADAM_DEBUG_WIN64_SLICE_MS: uint32 = 10;
  // The bytes one ReadFile of the output pipe takes at most
  ADAM_DEBUG_WIN64_PIPE_CHUNK: uint32 = 4096;
  // The long-path prefix GetFinalPathNameByHandleW writes before a drive path
  ADAM_DEBUG_WIN64_LONG_PREFIX: string = "\\\\?\\";
  ADAM_DEBUG_WIN64_LONG_UNC_PREFIX: string = "\\\\?\\UNC\\";

  // The general registers in DebugContext.Registers' order
  ADAM_DEBUG_WIN64_REGISTERS: string =
    "rax rbx rcx rdx rsi rdi rbp rsp r8 r9 r10 r11 r12 r13 r14 r15 rip eflags";

type
  // One int3 patch: where, the byte it hides, how many adds it has
  Win64Patch = record
    Address: uint64;
    Original: uint8;
    Count: int64;
  end;

  Win64PatchArray = array of Win64Patch;
  Win64EventArray = array of DebugEvent;

public type
  // A CONTEXT in a buffer aligned to ADAM_WINDOWS_CONTEXT_ALIGN: Block points into Bytes
  // (Adam.Debug.Symbols.Win64 walks a stack in one too)
  Win64ContextBuffer = record
    Bytes: ByteArray;
    Block: ptr to CONTEXT;
  end;

// A CONTEXT buffer: ABuffer.Block points at its first 16-byte aligned byte, every byte zero
public routine Win64MakeContextBuffer(var ABuffer: Win64ContextBuffer);
var
  LAddress: int64;
begin
  setlength(ABuffer.Bytes, ADAM_WINDOWS_CONTEXT_SIZE + ADAM_WINDOWS_CONTEXT_ALIGN);
  LAddress := AlignUp(int64(uint64(addr of ABuffer.Bytes[0])), ADAM_WINDOWS_CONTEXT_ALIGN);
  ABuffer.Block := ptr to CONTEXT(uint64(LAddress));
end;

// The CONTEXT at ABlock as a DebugContext: the four roles, the general registers in
// ADAM_DEBUG_WIN64_REGISTERS' order, the block's bytes as Raw (the one decoder: a thread's
// registers as GetContext reads them and a frame's as a stack walk unwinds them)
public routine Win64ReadContext(const ABlock: ptr to const CONTEXT;
  var AContext: DebugContext);
begin
  AContext.Pc := ABlock^.Rip;
  AContext.Sp := ABlock^.Rsp;
  AContext.Fp := ABlock^.Rbp;
  AContext.Flags := uint64(ABlock^.EFlags);
  setlength(AContext.Registers, 18);
  AContext.Registers[0] := ABlock^.Rax;
  AContext.Registers[1] := ABlock^.Rbx;
  AContext.Registers[2] := ABlock^.Rcx;
  AContext.Registers[3] := ABlock^.Rdx;
  AContext.Registers[4] := ABlock^.Rsi;
  AContext.Registers[5] := ABlock^.Rdi;
  AContext.Registers[6] := ABlock^.Rbp;
  AContext.Registers[7] := ABlock^.Rsp;
  AContext.Registers[8] := ABlock^.R8;
  AContext.Registers[9] := ABlock^.R9;
  AContext.Registers[10] := ABlock^.R10;
  AContext.Registers[11] := ABlock^.R11;
  AContext.Registers[12] := ABlock^.R12;
  AContext.Registers[13] := ABlock^.R13;
  AContext.Registers[14] := ABlock^.R14;
  AContext.Registers[15] := ABlock^.R15;
  AContext.Registers[16] := ABlock^.Rip;
  AContext.Registers[17] := uint64(ABlock^.EFlags);
  setlength(AContext.Raw, ADAM_WINDOWS_CONTEXT_SIZE);
  CopyBytes(addr of AContext.Raw[0], ptr to const uint8(uint64(ABlock)),
    ADAM_WINDOWS_CONTEXT_SIZE);
end;

// The bytes of AText that end on a whole UTF-8 character (a lead byte without all of its
// continuation bytes is left for the next read)
routine DoWholeUtf8(const AText: string): int64;
var
  LAt: int64;
  LBack: int64;
  LByte: uint8;
  LNeed: int64;
begin
  LAt := len(AText) - 1;
  LBack := 0;
  while (LAt >= 0) and (LBack < 3) and ((uint8(AText[LAt]) & 0xC0) = 0x80) do
    LAt := LAt - 1;
    LBack := LBack + 1;
  end;
  if LAt < 0 then
    return len(AText);
  end;
  LByte := uint8(AText[LAt]);
  LNeed := 1;
  // The three lead forms are disjoint: at most one holds
  if (LByte & 0xE0) = 0xC0 then
    LNeed := 2;
  end;
  if (LByte & 0xF0) = 0xE0 then
    LNeed := 3;
  end;
  if (LByte & 0xF8) = 0xF0 then
    LNeed := 4;
  end;
  if LBack + 1 < LNeed then
    return LAt;
  end;
  return len(AText);
end;

// The full path of the file AFile is open on (a module's image), as System.IO spells paths;
// "" when Windows cannot tell
routine DoHandlePath(const AFile: uint64): string;
var
  LBox: own DebugWideBox;
  LLength: uint32;
  LPath: string;
begin
  if (AFile = 0) or (AFile = INVALID_HANDLE_VALUE) then
    return "";
  end;
  LBox := own DebugWideBox();
  LLength := GetFinalPathNameByHandleW(AFile, LBox.Data, ADAM_WINDOWS_DEBUG_TEXT_MAX, 0);
  if (LLength = 0) or (LLength > ADAM_WINDOWS_DEBUG_TEXT_MAX) then
    return "";
  end;
  LPath := WideToUtf8(LBox.Data, int32(LLength));
  if StartsStr(ADAM_DEBUG_WIN64_LONG_UNC_PREFIX, LPath) then
    LPath := "\\\\" + Substring(LPath, len(ADAM_DEBUG_WIN64_LONG_UNC_PREFIX),
      len(LPath) - len(ADAM_DEBUG_WIN64_LONG_UNC_PREFIX));
  else
    if StartsStr(ADAM_DEBUG_WIN64_LONG_PREFIX, LPath) then
      LPath := Substring(LPath, len(ADAM_DEBUG_WIN64_LONG_PREFIX),
        len(LPath) - len(ADAM_DEBUG_WIN64_LONG_PREFIX));
    end;
  end;
  return WinResolvePath(LPath);
end;

// ClosePseudoConsole as a task runs it (DoCloseTerminal)
routine DoClosePseudoConsole(const AConsole: uint64);
begin
  ClosePseudoConsole(AConsole);
end;

// A module file handle Windows gave the debugger, closed (0 / invalid: none)
routine DoCloseFile(const AFile: uint64);
begin
  if (AFile <> 0) and (AFile <> INVALID_HANDLE_VALUE) then
    CloseHandle(AFile);
  end;
end;

public type
  // DebugTarget on Win64 (see the header)
  Win64DebugTarget = object(DebugTarget)
    // The process (CreateProcessW's handle, closed at the end) and its ids
    hidden FProcess: uint64;
    hidden FProcessId: uint32;
    hidden FMainThreadId: uint32;
    hidden FImageBase: uint64;
    hidden FEntryAddress: uint64;
    hidden FImagePath: string;
    hidden FResolvedPath: string;
    // Started and not yet ended / ended and its ProcessExited queued
    hidden FRunning: bool;
    hidden FExited: bool;
    // The threads, oldest first, and their handles (Windows' own: never closed here)
    hidden FThreadIds: DebugThreadIdArray;
    hidden FThreadHandles: DebugWordArray;
    hidden FPatches: Win64PatchArray;
    // The event the program is held on: its thread, the status Resume continues it with,
    // whether it is a stop and the thread a stop's resume kind applies to
    hidden FHeld: bool;
    hidden FHeldThreadId: uint32;
    hidden FHeldStatus: uint32;
    hidden FHeldIsStop: bool;
    hidden FStopThreadId: uint32;
    // The loader's breakpoint was taken (the Entry stop); a Pause was asked
    hidden FEntrySeen: bool;
    hidden FPauseAsked: bool;
    // The patch a thread is stepping over (its byte put back until the single step)
    hidden FStepOverActive: bool;
    hidden FStepOverThreadId: uint32;
    hidden FStepOverAddress: uint64;
    // Threads whose next single step is a user's Step; threads suspended for a step-over
    hidden FUserSteps: DebugThreadIdArray;
    hidden FSuspended: DebugWordArray;
    // The output pipe's read end (0 = none) and the bytes read that end mid character
    hidden FPipeRead: uint64;
    // Terminal mode: the pseudo console (an HPCON, 0 = none) and its input pipe's write end
    hidden FPseudoConsole: uint64;
    hidden FTerminalInput: uint64;
    hidden FPending: string;
    // Events taken and not yet handed out, FQueueHead the next
    hidden FQueue: Win64EventArray;
    hidden FQueueHead: int64;

    override method Start(): bool;
    var
      LApplication: own DebugWideBox;
      LCommandLine: own DebugWideBox;
      LDirectory: own DebugWideBox;
      LNulName: own DebugWideBox;
      LAttributes: SECURITY_ATTRIBUTES;
      LStartup: STARTUPINFOW;
      LInfo: PROCESS_INFORMATION;
      LWrite: uint64;
      LNul: uint64;
      LCommand: string;
      LWindowsPath: string;
      LI: int64;
      LStarted: bool;
      LError: uint32;
      LStartupEx: STARTUPINFOEXW;
      LList: ByteArray;
      LFlags: uint32;
    begin
      if self.FRunning or self.FExited then
        self.DoError(ADAM_ERR_DEBUG_003, ADAM_MSG_DEBUG_STARTED, NoArgs());
        return false;
      end;
      self.FResolvedPath := WinResolvePath(self.FProgramPath);
      if (self.FResolvedPath = "") or (not WinFileExists(self.FResolvedPath)) then
        self.DoError(ADAM_ERR_DEBUG_001, ADAM_MSG_DEBUG_NO_PROGRAM,
          NoArgs().Str(self.FProgramPath));
        return false;
      end;

      // The application full (no search), the command line with it quoted as argv[0], the
      // program's own folder as its working folder
      LWindowsPath := ReplaceStr(self.FResolvedPath, "/", "\\");
      LCommand := QuoteArg(LWindowsPath);
      for LI := 0 to len(self.FProgramArgs) - 1 do
        LCommand := LCommand + " " + QuoteArg(self.FProgramArgs[LI]);
      end;
      LApplication := own DebugWideBox();
      LCommandLine := own DebugWideBox();
      LDirectory := own DebugWideBox();
      if (not Utf8ToWide(LWindowsPath, LApplication.Data)) or
        (not Utf8ToWide(LCommand, LCommandLine.Data)) or
        (not Utf8ToWide(ExtractFileDir(LWindowsPath), LDirectory.Data)) then
        self.DoError(ADAM_ERR_DEBUG_002, ADAM_MSG_DEBUG_START_FAILED,
          NoArgs().Str(self.FProgramPath).Str(WinErrorText(ERROR_FILENAME_EXCED_RANGE)));
        return false;
      end;

      LWrite := 0;
      LNul := 0;
      LStartup.cb := uint32(size(STARTUPINFOW));
      LStartup.dwFlags := STARTF_USESTDHANDLES;
      if self.FOutputMode = DebugOutputMode.Pipes then
        // stdout and stderr share one pipe (written order kept); its read end stays here,
        // not inherited; stdin is NUL
        LAttributes.nLength := uint32(size(SECURITY_ATTRIBUTES));
        LAttributes.bInheritHandle := 1;
        if CreatePipe(self.FPipeRead, LWrite, LAttributes, 0) = 0 then
          self.DoError(ADAM_ERR_DEBUG_002, ADAM_MSG_DEBUG_START_FAILED,
            NoArgs().Str(self.FProgramPath).Str(WinLastErrorText()));
          return false;
        end;
        SetHandleInformation(self.FPipeRead, HANDLE_FLAG_INHERIT, 0);
        LNulName := own DebugWideBox();
        Utf8ToWide("NUL", LNulName.Data);
        LNul := CreateFileW(LNulName.Data, GENERIC_READ,
          FILE_SHARE_READ | FILE_SHARE_WRITE, LAttributes, OPEN_EXISTING,
          0, 0);
        if LNul = INVALID_HANDLE_VALUE then
          LNul := 0;
        end;
        LStartup.hStdInput := LNul;
        LStartup.hStdOutput := LWrite;
        LStartup.hStdError := LWrite;
      else
        if self.FOutputMode = DebugOutputMode.Inherit then
          // This process's own standard handles, handed on as the program's
          LStartup.hStdInput := GetStdHandle(STD_INPUT_HANDLE);
          LStartup.hStdOutput := GetStdHandle(STD_OUTPUT_HANDLE);
          LStartup.hStdError := GetStdHandle(STD_ERROR_HANDLE);
        end;
        // Terminal: no standard handles of this process's (stdout may be a protocol): the
        // pseudo console is the program's console
      end;

      LFlags := DEBUG_ONLY_THIS_PROCESS | NORMAL_PRIORITY_CLASS | CREATE_NEW_PROCESS_GROUP;
      if self.FOutputMode = DebugOutputMode.Terminal then
        if not self.DoCreateTerminal(LList) then
          return false;
        end;
        LStartupEx.StartupInfo := LStartup;
        LStartupEx.StartupInfo.cb := uint32(size(STARTUPINFOEXW));
        LStartupEx.lpAttributeList := ptr(addr of LList[0]);
        LStarted := CreateProcessW(LApplication.Data, LCommandLine.Data, nil, nil, 0,
          LFlags | EXTENDED_STARTUPINFO_PRESENT, nil, LDirectory.Data, LStartupEx.StartupInfo,
          LInfo) <> 0;
        LError := GetLastError();
        DeleteProcThreadAttributeList(ptr(addr of LList[0]));
        if not LStarted then
          self.DoCloseTerminal();
        end;
      else
        LStarted := CreateProcessW(LApplication.Data, LCommandLine.Data, nil, nil, 1, LFlags,
          nil, LDirectory.Data, LStartup, LInfo) <> 0;
        LError := GetLastError();
      end;
      // Only the program holds the pipe's write end and NUL now
      if LWrite <> 0 then
        CloseHandle(LWrite);
      end;
      if LNul <> 0 then
        CloseHandle(LNul);
      end;
      if not LStarted then
        self.DoClosePipe();
        self.DoError(ADAM_ERR_DEBUG_002, ADAM_MSG_DEBUG_START_FAILED,
          NoArgs().Str(self.FProgramPath).Str(WinErrorText(LError)));
        return false;
      end;
      // The main thread's handle comes again with its CREATE_PROCESS event (Windows' own)
      CloseHandle(LInfo.hThread);
      self.FProcess := LInfo.hProcess;
      self.FProcessId := LInfo.dwProcessId;
      self.FMainThreadId := LInfo.dwThreadId;
      self.FRunning := true;
      return true;
    end;

    override method NextEvent(var AEvent: DebugEvent; const ATimeoutMs: uint32): bool;
    var
      LRaw: DEBUG_EVENT;
      LStart: int64;
      LWait: uint32;
      LLeft: int64;
      LError: uint32;
    begin
      if self.DoDequeue(AEvent) then
        return true;
      end;
      if (not self.FRunning) or self.FHeld then
        // Ended, or held until Resume: only output may still come
        self.DoDrainOutput(false);
        return self.DoDequeue(AEvent);
      end;
      LStart := WinTickCountMs();
      while true do
        LWait := ATimeoutMs;
        if (self.FPipeRead <> 0) and (LWait > ADAM_DEBUG_WIN64_SLICE_MS) then
          LWait := ADAM_DEBUG_WIN64_SLICE_MS;
        end;
        if WaitForDebugEvent(LRaw, LWait) <> 0 then
          // What the program wrote before this event (it is frozen now) comes before it
          self.DoDrainOutput(false);
          self.DoDispatch(LRaw);
        else
          LError := GetLastError();
          if LError <> ERROR_SEM_TIMEOUT then
            self.DoLost(LError);
            return self.DoDequeue(AEvent);
          end;
        end;
        self.DoDrainOutput(false);
        if self.DoDequeue(AEvent) then
          return true;
        end;
        if self.FHeld or (not self.FRunning) then
          return false;
        end;
        if ATimeoutMs <> ADAM_DEBUG_WAIT_FOREVER then
          LLeft := int64(ATimeoutMs) - (WinTickCountMs() - LStart);
          if LLeft <= 0 then
            return false;
          end;
        end;
      end;
    end;

    override method Resume(const AKind: ResumeKind): bool;
    var
      LKind: ResumeKind;
    begin
      if not self.FHeld then
        self.DoError(ADAM_ERR_DEBUG_003, ADAM_MSG_DEBUG_NOT_HELD, NoArgs());
        return false;
      end;
      if self.FHeldIsStop then
        LKind := AKind;
        if self.FHeldStatus <> DBG_CONTINUE then
          // The program's own exception goes on to the program: no step of ours
          LKind := ResumeKind.Continue;
        end;
        self.DoApplyResume(self.FStopThreadId, LKind);
      end;
      return self.DoContinue();
    end;

    override method Pause(): bool;
    begin
      if (not self.FRunning) or self.FHeld or self.FExited then
        return false;
      end;
      self.FPauseAsked := true;
      if DebugBreakProcess(self.FProcess) = 0 then
        self.FPauseAsked := false;
        self.DoError(ADAM_ERR_DEBUG_008, ADAM_MSG_DEBUG_PAUSE_FAILED,
          NoArgs().Str(WinLastErrorText()));
        return false;
      end;
      return true;
    end;

    override method Terminate();
    begin
      if (not self.FRunning) or self.FExited then
        return;
      end;
      TerminateProcess(self.FProcess, ADAM_DEBUG_TERMINATE_EXIT_CODE);
      if self.FHeld then
        // Nothing of ours is to run any more: no step-over, no user step
        self.FStepOverActive := false;
        setlength(self.FUserSteps, 0);
        self.DoResumeOthers();
        self.DoContinue();
      end;
    end;

    override const method IsHeld(): bool;
    begin
      return self.FHeld;
    end;

    override const method IsRunning(): bool;
    begin
      return self.FRunning or (self.FQueueHead < len(self.FQueue));
    end;

    override const method Threads(): DebugThreadIdArray;
    begin
      return self.FThreadIds;
    end;

    override const method RegisterNames(): StringArray;
    begin
      return SplitString(ADAM_DEBUG_WIN64_REGISTERS, " ");
    end;

    override method GetContext(const AThreadId: uint32; var AContext: DebugContext): bool;
    var
      LHandle: uint64;
      LBuffer: Win64ContextBuffer;
      LBlock: ptr to CONTEXT;
    begin
      if not self.DoThreadHandle(AThreadId, LHandle) then
        self.DoError(ADAM_ERR_DEBUG_004, ADAM_MSG_DEBUG_NO_THREAD, NoArgs().Int(int64(AThreadId)));
        return false;
      end;
      Win64MakeContextBuffer(LBuffer);
      LBlock := LBuffer.Block;
      LBlock^.ContextFlags := CONTEXT_ALL;
      if GetThreadContext(LHandle, ptr(LBlock)) = 0 then
        self.DoError(ADAM_ERR_DEBUG_005, ADAM_MSG_DEBUG_CONTEXT_READ,
          NoArgs().Int(int64(AThreadId)).Str(WinLastErrorText()));
        return false;
      end;
      Win64ReadContext(LBlock, AContext);
      return true;
    end;

    override method SetContext(const AThreadId: uint32; const AContext: DebugContext): bool;
    var
      LHandle: uint64;
      LBuffer: Win64ContextBuffer;
      LBlock: ptr to CONTEXT;
    begin
      if not self.DoThreadHandle(AThreadId, LHandle) then
        self.DoError(ADAM_ERR_DEBUG_004, ADAM_MSG_DEBUG_NO_THREAD, NoArgs().Int(int64(AThreadId)));
        return false;
      end;
      if (len(AContext.Raw) <> ADAM_WINDOWS_CONTEXT_SIZE) or (len(AContext.Registers) <> 18) then
        self.DoError(ADAM_ERR_DEBUG_005, ADAM_MSG_DEBUG_CONTEXT_SHAPE,
          NoArgs().Int(int64(AThreadId)));
        return false;
      end;
      Win64MakeContextBuffer(LBuffer);
      LBlock := LBuffer.Block;
      CopyBytes(ptr to uint8(uint64(LBlock)), addr of AContext.Raw[0], ADAM_WINDOWS_CONTEXT_SIZE);
      // The general registers first, then the four by role over them (a caller changes either)
      LBlock^.Rax := AContext.Registers[0];
      LBlock^.Rbx := AContext.Registers[1];
      LBlock^.Rcx := AContext.Registers[2];
      LBlock^.Rdx := AContext.Registers[3];
      LBlock^.Rsi := AContext.Registers[4];
      LBlock^.Rdi := AContext.Registers[5];
      LBlock^.Rbp := AContext.Registers[6];
      LBlock^.Rsp := AContext.Registers[7];
      LBlock^.R8 := AContext.Registers[8];
      LBlock^.R9 := AContext.Registers[9];
      LBlock^.R10 := AContext.Registers[10];
      LBlock^.R11 := AContext.Registers[11];
      LBlock^.R12 := AContext.Registers[12];
      LBlock^.R13 := AContext.Registers[13];
      LBlock^.R14 := AContext.Registers[14];
      LBlock^.R15 := AContext.Registers[15];
      LBlock^.Rip := AContext.Registers[16];
      LBlock^.EFlags := uint32(AContext.Registers[17]);
      if AContext.Pc <> AContext.Registers[16] then
        LBlock^.Rip := AContext.Pc;
      end;
      if AContext.Sp <> AContext.Registers[7] then
        LBlock^.Rsp := AContext.Sp;
      end;
      if AContext.Fp <> AContext.Registers[6] then
        LBlock^.Rbp := AContext.Fp;
      end;
      if AContext.Flags <> AContext.Registers[17] then
        LBlock^.EFlags := uint32(AContext.Flags);
      end;
      LBlock^.ContextFlags := CONTEXT_ALL;
      if SetThreadContext(LHandle, ptr(LBlock)) = 0 then
        self.DoError(ADAM_ERR_DEBUG_005, ADAM_MSG_DEBUG_CONTEXT_WRITE,
          NoArgs().Int(int64(AThreadId)).Str(WinLastErrorText()));
        return false;
      end;
      return true;
    end;

    override method ReadMemory(const AAddress: uint64; const ASize: int64;
      var ABytes: ByteArray): bool;
    begin
      if not self.PeekMemory(AAddress, ASize, ABytes) then
        self.DoError(ADAM_ERR_DEBUG_006, ADAM_MSG_DEBUG_READ_FAILED,
          NoArgs().Int(ASize).Str(IntToHex(AAddress, 16)).Str(WinLastErrorText()));
        return false;
      end;
      return true;
    end;

    override method PeekMemory(const AAddress: uint64; const ASize: int64;
      var ABytes: ByteArray): bool;
    var
      LI: int64;
      LAt: uint64;
    begin
      if not self.DoReadRaw(AAddress, ASize, ABytes) then
        return false;
      end;
      // A patched byte reads as the byte it hides
      for LI := 0 to len(self.FPatches) - 1 do
        LAt := self.FPatches[LI].Address;
        if (LAt >= AAddress) and (LAt - AAddress < uint64(ASize)) then
          ABytes[int64(LAt - AAddress)] := self.FPatches[LI].Original;
        end;
      end;
      return true;
    end;

    override method WriteMemory(const AAddress: uint64; const ABytes: ByteArray): bool;
    var
      LI: int64;
      LAt: uint64;
      LOk: bool;
    begin
      if len(ABytes) = 0 then
        return true;
      end;
      LOk := self.DoWriteRaw(AAddress, addr of ABytes[0], len(ABytes));
      if not LOk then
        self.DoError(ADAM_ERR_DEBUG_006, ADAM_MSG_DEBUG_WRITE_FAILED,
          NoArgs().Int(len(ABytes)).Str(IntToHex(AAddress, 16)).Str(WinLastErrorText()));
      end;
      // A patch inside keeps its int3; the byte written is what it hides now (a patch lifted
      // for a step-over stays lifted until its single step)
      for LI := 0 to len(self.FPatches) - 1 do
        LAt := self.FPatches[LI].Address;
        if (LAt >= AAddress) and (LAt - AAddress < uint64(len(ABytes))) then
          self.FPatches[LI].Original := ABytes[int64(LAt - AAddress)];
          if not (self.FStepOverActive and (self.FStepOverAddress = LAt)) then
            self.DoWriteCode(LAt, ADAM_DEBUG_WIN64_INT3);
          end;
        end;
      end;
      return LOk;
    end;

    override method AddPatch(const AAddress: uint64): bool;
    var
      LIndex: int64;
      LBytes: ByteArray;
      LPatch: Win64Patch;
      LCount: int64;
    begin
      LIndex := self.DoPatchIndex(AAddress);
      if LIndex >= 0 then
        self.FPatches[LIndex].Count := self.FPatches[LIndex].Count + 1;
        return true;
      end;
      if (not self.DoReadRaw(AAddress, 1, LBytes)) or
        (not self.DoWriteCode(AAddress, ADAM_DEBUG_WIN64_INT3)) then
        self.DoError(ADAM_ERR_DEBUG_007, ADAM_MSG_DEBUG_PATCH_FAILED,
          NoArgs().Str(IntToHex(AAddress, 16)).Str(WinLastErrorText()));
        return false;
      end;
      LPatch.Address := AAddress;
      LPatch.Original := LBytes[0];
      LPatch.Count := 1;
      LCount := len(self.FPatches);
      setlength(self.FPatches, LCount + 1);
      self.FPatches[LCount] := LPatch;
      return true;
    end;

    override method RemovePatch(const AAddress: uint64): bool;
    var
      LIndex: int64;
      LI: int64;
      LLifted: bool;
    begin
      LIndex := self.DoPatchIndex(AAddress);
      if LIndex < 0 then
        return false;
      end;
      if self.FPatches[LIndex].Count > 1 then
        self.FPatches[LIndex].Count := self.FPatches[LIndex].Count - 1;
        return true;
      end;
      // A patch lifted for a step-over holds its byte already
      LLifted := self.FStepOverActive and (self.FStepOverAddress = AAddress);
      if (not LLifted) and
        (not self.DoWriteCode(AAddress, self.FPatches[LIndex].Original)) then
        self.DoError(ADAM_ERR_DEBUG_007, ADAM_MSG_DEBUG_PATCH_FAILED,
          NoArgs().Str(IntToHex(AAddress, 16)).Str(WinLastErrorText()));
        return false;
      end;
      for LI := LIndex to len(self.FPatches) - 2 do
        self.FPatches[LI] := self.FPatches[LI + 1];
      end;
      setlength(self.FPatches, len(self.FPatches) - 1);
      return true;
    end;

    override const method IsPatched(const AAddress: uint64): bool;
    begin
      return self.DoPatchIndex(AAddress) >= 0;
    end;

    override method ForgetPatch(const AAddress: uint64): bool;
    var
      LIndex: int64;
      LI: int64;
    begin
      LIndex := self.DoPatchIndex(AAddress);
      if LIndex < 0 then
        return false;
      end;
      if self.FStepOverActive and (self.FStepOverAddress = AAddress) then
        self.FStepOverActive := false;
      end;
      for LI := LIndex to len(self.FPatches) - 2 do
        self.FPatches[LI] := self.FPatches[LI + 1];
      end;
      setlength(self.FPatches, len(self.FPatches) - 1);
      return true;
    end;

    // Windows tells paths apart without case (System.Windows' rule)
    override const method SameFile(const APathA: string; const APathB: string): bool;
    begin
      return WinSamePath(APathA, APathB);
    end;

    // A PE image a program loads: the .dll extension (Adam's own dll builds and the OS's)
    override const method IsLibraryImage(const APath: string): bool;
    begin
      return LowerCase(ExtractFileExt(APath)) = ADAM_EXT_COFF_DLL;
    end;

    // Windows' own separator (a '/' a resolved path carries made a '\')
    override const method NativePath(const APath: string): string;
    begin
      return ReplaceStr(APath, "/", "\\");
    end;

    // x86_64's call pushes the address after itself: the stack one word lower, that word
    // within an instruction's reach past the call, and the program counter elsewhere
    override method CallReturn(const ABefore: DebugContext; const AAfter: DebugContext;
      var AReturn: uint64): bool;
    var
      LBytes: ByteArray;
      LWord: uint64;
      LI: int64;
    begin
      AReturn := 0;
      if (AAfter.Sp + 8 <> ABefore.Sp) or (not self.PeekMemory(AAfter.Sp, 8, LBytes)) then
        return false;
      end;
      LWord := 0;
      for LI := 7 downto 0 do
        LWord := (LWord << 8) | uint64(LBytes[LI]);
      end;
      if (LWord <= ABefore.Pc) or (LWord > ABefore.Pc + ADAM_DEBUG_WIN64_INSTRUCTION_MAX) or
        ((AAfter.Pc > ABefore.Pc) and (AAfter.Pc <= LWord)) then
        return false;
      end;
      AReturn := LWord;
      return true;
    end;

    override const method ProcessId(): uint32;
    begin
      return self.FProcessId;
    end;

    override const method MainThreadId(): uint32;
    begin
      return self.FMainThreadId;
    end;

    override const method ImageBase(): uint64;
    begin
      return self.FImageBase;
    end;

    override const method EntryAddress(): uint64;
    begin
      return self.FEntryAddress;
    end;

    override const method ImagePath(): string;
    begin
      return self.FImagePath;
    end;

    // One debug event handled: queued, then held on or continued
    hidden method DoDispatch(const ARaw: DEBUG_EVENT);
    var
      LEvent: DebugEvent;
    begin
      match ARaw.dwDebugEventCode of
        EXCEPTION_DEBUG_EVENT:
          self.DoException(ARaw);
        CREATE_PROCESS_DEBUG_EVENT:
          self.FImageBase := ARaw.u.CreateProcessInfo.lpBaseOfImage;
          self.FEntryAddress := ARaw.u.CreateProcessInfo.lpStartAddress;
          self.DoAddThread(ARaw.dwThreadId, ARaw.u.CreateProcessInfo.hThread);
          self.FImagePath := DoHandlePath(ARaw.u.CreateProcessInfo.hFile);
          if self.FImagePath = "" then
            self.FImagePath := self.FResolvedPath;
          end;
          DoCloseFile(ARaw.u.CreateProcessInfo.hFile);
          LEvent.Kind := DebugEventKind.ProcessStarted;
          LEvent.ThreadId := ARaw.dwThreadId;
          LEvent.Address := self.FImageBase;
          LEvent.ModulePath := self.FImagePath;
          self.DoHold(LEvent, ARaw.dwThreadId, false);
        CREATE_THREAD_DEBUG_EVENT:
          self.DoAddThread(ARaw.dwThreadId, ARaw.u.CreateThread.hThread);
          LEvent.Kind := DebugEventKind.ThreadStarted;
          LEvent.ThreadId := ARaw.dwThreadId;
          LEvent.Address := ARaw.u.CreateThread.lpStartAddress;
          self.DoQueue(LEvent);
          self.DoContinueEvent(ARaw.dwThreadId, DBG_CONTINUE);
        EXIT_THREAD_DEBUG_EVENT:
          self.DoThreadGone(ARaw.dwThreadId);
          LEvent.Kind := DebugEventKind.ThreadExited;
          LEvent.ThreadId := ARaw.dwThreadId;
          LEvent.ExitCode := ARaw.u.ExitThread.dwExitCode;
          self.DoQueue(LEvent);
          self.DoContinueEvent(ARaw.dwThreadId, DBG_CONTINUE);
        LOAD_DLL_DEBUG_EVENT:
          LEvent.Kind := DebugEventKind.ModuleLoaded;
          LEvent.ThreadId := ARaw.dwThreadId;
          LEvent.Address := ARaw.u.LoadDll.lpBaseOfDll;
          LEvent.ModulePath := DoHandlePath(ARaw.u.LoadDll.hFile);
          DoCloseFile(ARaw.u.LoadDll.hFile);
          self.DoHold(LEvent, ARaw.dwThreadId, false);
        UNLOAD_DLL_DEBUG_EVENT:
          LEvent.Kind := DebugEventKind.ModuleUnloaded;
          LEvent.ThreadId := ARaw.dwThreadId;
          LEvent.Address := ARaw.u.UnloadDll.lpBaseOfDll;
          self.DoQueue(LEvent);
          self.DoContinueEvent(ARaw.dwThreadId, DBG_CONTINUE);
        EXIT_PROCESS_DEBUG_EVENT:
          self.DoProcessGone(ARaw);
      else
        // OUTPUT_DEBUG_STRING, RIP: nothing a user of Adam's debugger is shown
        self.DoContinueEvent(ARaw.dwThreadId, DBG_CONTINUE);
      end;
    end;

    // An exception event: the Entry stop, a patch, a step, a pause, or the program's own
    hidden method DoException(const ARaw: DEBUG_EVENT);
    var
      LCode: uint32;
      LAddress: uint64;
      LFirst: bool;
      LThreadId: uint32;
    begin
      LCode := ARaw.u.Exception.ExceptionRecord.ExceptionCode;
      LAddress := ARaw.u.Exception.ExceptionRecord.ExceptionAddress;
      LFirst := ARaw.u.Exception.dwFirstChance <> 0;
      LThreadId := ARaw.dwThreadId;
      if LCode = EXCEPTION_BREAKPOINT then
        if not self.FEntrySeen then
          // The loader's breakpoint: the program's code has not run yet
          self.FEntrySeen := true;
          self.DoStop(DebugStopReason.Entry, LThreadId, LThreadId, LAddress, 0, LFirst,
            DBG_CONTINUE);
          return;
        end;
        if self.DoPatchIndex(LAddress) >= 0 then
          // Our int3: the program counter goes back onto it (Resume steps over it)
          self.DoSetPc(LThreadId, LAddress);
          self.DoStop(DebugStopReason.Breakpoint, LThreadId, LThreadId, LAddress, 0, LFirst,
            DBG_CONTINUE);
          return;
        end;
        if self.FPauseAsked then
          self.FPauseAsked := false;
          self.DoStop(DebugStopReason.Pause, self.FMainThreadId, LThreadId, LAddress, 0, LFirst,
            DBG_CONTINUE);
          return;
        end;
      end;
      if LCode = EXCEPTION_SINGLE_STEP then
        if self.FStepOverActive and (self.FStepOverThreadId = LThreadId) then
          // Past the patch: its int3 goes back in, the other threads run again
          self.FStepOverActive := false;
          self.DoRepatch(self.FStepOverAddress);
          self.DoResumeOthers();
          if self.DoTakeUserStep(LThreadId) then
            self.DoStop(DebugStopReason.Step, LThreadId, LThreadId, LAddress, 0, LFirst,
              DBG_CONTINUE);
          else
            self.DoContinueEvent(LThreadId, DBG_CONTINUE);
          end;
          return;
        end;
        if self.DoTakeUserStep(LThreadId) then
          self.DoStop(DebugStopReason.Step, LThreadId, LThreadId, LAddress, 0, LFirst,
            DBG_CONTINUE);
          return;
        end;
      end;
      // The program's own: its first chance is its own to handle; the second is the stop
      if LFirst then
        self.DoContinueEvent(LThreadId, DBG_EXCEPTION_NOT_HANDLED);
        return;
      end;
      self.DoStop(DebugStopReason.Exception, LThreadId, LThreadId, LAddress, LCode, false,
        DBG_EXCEPTION_NOT_HANDLED);
    end;

    // The process ended: its last output, then ProcessExited; everything of it closed
    hidden method DoProcessGone(const ARaw: DEBUG_EVENT);
    var
      LEvent: DebugEvent;
    begin
      self.DoDrainOutput(false);
      self.DoContinueEvent(ARaw.dwThreadId, DBG_CONTINUE);
      // Gone for good once continued: the pipe's write end with it, so the rest is read whole
      WaitForSingleObject(self.FProcess, INFINITE);
      self.DoCloseTerminal();
      self.DoDrainOutput(true);
      LEvent.Kind := DebugEventKind.ProcessExited;
      LEvent.ExitCode := ARaw.u.ExitProcess.dwExitCode;
      self.DoQueue(LEvent);
      self.DoFinish();
    end;

    // The program can no longer be debugged (AError from a wait or a continue): reported,
    // ended, its ProcessExited queued
    hidden method DoLost(const AError: uint32);
    var
      LEvent: DebugEvent;
      LExitCode: uint32;
    begin
      self.DoError(ADAM_ERR_DEBUG_009, ADAM_MSG_DEBUG_LOOP_FAILED, NoArgs().Str(WinErrorText(AError)));
      TerminateProcess(self.FProcess, ADAM_DEBUG_TERMINATE_EXIT_CODE);
      WaitForSingleObject(self.FProcess, INFINITE);
      LExitCode := ADAM_DEBUG_TERMINATE_EXIT_CODE;
      GetExitCodeProcess(self.FProcess, LExitCode);
      self.DoCloseTerminal();
      self.DoDrainOutput(true);
      LEvent.Kind := DebugEventKind.ProcessExited;
      LEvent.ExitCode := LExitCode;
      self.DoQueue(LEvent);
      self.DoFinish();
    end;

    // Everything of the ended process closed and forgotten (its events still queued)
    hidden method DoFinish();
    begin
      self.DoCloseTerminal();
      self.DoClosePipe();
      if self.FProcess <> 0 then
        CloseHandle(self.FProcess);
        self.FProcess := 0;
      end;
      self.FRunning := false;
      self.FExited := true;
      self.FHeld := false;
      self.FStepOverActive := false;
      setlength(self.FThreadIds, 0);
      setlength(self.FThreadHandles, 0);
      setlength(self.FUserSteps, 0);
      setlength(self.FSuspended, 0);
      setlength(self.FPatches, 0);
    end;

    // A stop queued and held on: AReported is the thread the event names, AHeldThread the
    // one whose debug event Resume continues with AStatus
    hidden method DoStop(const AReason: DebugStopReason; const AReported: uint32;
      const AHeldThread: uint32; const AAddress: uint64; const ACode: uint32;
      const AFirst: bool; const AStatus: uint32);
    var
      LEvent: DebugEvent;
    begin
      LEvent.Kind := DebugEventKind.Stopped;
      LEvent.Reason := AReason;
      LEvent.ThreadId := AReported;
      LEvent.Address := AAddress;
      LEvent.ExceptionCode := ACode;
      LEvent.FirstChance := AFirst;
      self.DoHold(LEvent, AHeldThread, true);
      self.FHeldStatus := AStatus;
      self.FStopThreadId := AReported;
    end;

    // AEvent queued and the program held on AThreadId's debug event until Resume
    hidden method DoHold(const AEvent: DebugEvent; const AThreadId: uint32; const AIsStop: bool);
    begin
      self.DoQueue(AEvent);
      self.FHeld := true;
      self.FHeldThreadId := AThreadId;
      self.FHeldStatus := DBG_CONTINUE;
      self.FHeldIsStop := AIsStop;
    end;

    // The held event continued; false (reported, the program ended) when Windows refuses
    hidden method DoContinue(): bool;
    begin
      self.FHeld := false;
      return self.DoContinueEvent(self.FHeldThreadId, self.FHeldStatus);
    end;

    // AThreadId's debug event continued with AStatus; false (reported, the program ended)
    // when Windows refuses
    hidden method DoContinueEvent(const AThreadId: uint32; const AStatus: uint32): bool;
    begin
      if ContinueDebugEvent(self.FProcessId, AThreadId, AStatus) = 0 then
        self.DoLost(GetLastError());
        return false;
      end;
      return true;
    end;

    // A stopped thread made ready to go on as AKind says: past a patch at its program counter
    // first (see the header), the trap flag set for a user's Step
    hidden method DoApplyResume(const AThreadId: uint32; const AKind: ResumeKind);
    var
      LHandle: uint64;
      LBuffer: Win64ContextBuffer;
      LBlock: ptr to CONTEXT;
      LIndex: int64;
      LTrap: bool;
      LCount: int64;
    begin
      if not self.DoThreadHandle(AThreadId, LHandle) then
        return;
      end;
      Win64MakeContextBuffer(LBuffer);
      LBlock := LBuffer.Block;
      LBlock^.ContextFlags := CONTEXT_ALL;
      if GetThreadContext(LHandle, ptr(LBlock)) = 0 then
        self.DoError(ADAM_ERR_DEBUG_005, ADAM_MSG_DEBUG_CONTEXT_READ,
          NoArgs().Int(int64(AThreadId)).Str(WinLastErrorText()));
        return;
      end;
      LTrap := false;
      LIndex := self.DoPatchIndex(LBlock^.Rip);
      if LIndex >= 0 then
        if self.DoWriteCode(LBlock^.Rip, self.FPatches[LIndex].Original) then
          self.FStepOverActive := true;
          self.FStepOverThreadId := AThreadId;
          self.FStepOverAddress := LBlock^.Rip;
          self.DoSuspendOthers(AThreadId);
          LTrap := true;
        else
          self.DoError(ADAM_ERR_DEBUG_007, ADAM_MSG_DEBUG_PATCH_FAILED,
            NoArgs().Str(IntToHex(LBlock^.Rip, 16)).Str(WinLastErrorText()));
        end;
      end;
      if AKind = ResumeKind.Step then
        LTrap := true;
        LCount := len(self.FUserSteps);
        setlength(self.FUserSteps, LCount + 1);
        self.FUserSteps[LCount] := AThreadId;
      end;
      if not LTrap then
        return;
      end;
      LBlock^.EFlags := LBlock^.EFlags | ADAM_WINDOWS_TRAP_FLAG;
      if SetThreadContext(LHandle, ptr(LBlock)) = 0 then
        self.DoError(ADAM_ERR_DEBUG_005, ADAM_MSG_DEBUG_CONTEXT_WRITE,
          NoArgs().Int(int64(AThreadId)).Str(WinLastErrorText()));
        // No single step will come: the patch goes back in now, nothing waits for it
        if self.FStepOverActive and (self.FStepOverThreadId = AThreadId) then
          self.FStepOverActive := false;
          self.DoRepatch(self.FStepOverAddress);
          self.DoResumeOthers();
        end;
        self.DoTakeUserStep(AThreadId);
      end;
    end;

    // AThreadId's program counter set to AAddress (back onto a patch it just ran)
    hidden method DoSetPc(const AThreadId: uint32; const AAddress: uint64);
    var
      LHandle: uint64;
      LBuffer: Win64ContextBuffer;
      LBlock: ptr to CONTEXT;
    begin
      if not self.DoThreadHandle(AThreadId, LHandle) then
        return;
      end;
      Win64MakeContextBuffer(LBuffer);
      LBlock := LBuffer.Block;
      LBlock^.ContextFlags := CONTEXT_ALL;
      if GetThreadContext(LHandle, ptr(LBlock)) <> 0 then
        LBlock^.Rip := AAddress;
        if SetThreadContext(LHandle, ptr(LBlock)) <> 0 then
          return;
        end;
      end;
      self.DoError(ADAM_ERR_DEBUG_005, ADAM_MSG_DEBUG_CONTEXT_WRITE,
        NoArgs().Int(int64(AThreadId)).Str(WinLastErrorText()));
    end;

    // The int3 put back at AAddress after a step-over, when the patch is still wanted
    hidden method DoRepatch(const AAddress: uint64);
    begin
      if self.DoPatchIndex(AAddress) < 0 then
        return;
      end;
      if not self.DoWriteCode(AAddress, ADAM_DEBUG_WIN64_INT3) then
        self.DoError(ADAM_ERR_DEBUG_007, ADAM_MSG_DEBUG_PATCH_FAILED,
          NoArgs().Str(IntToHex(AAddress, 16)).Str(WinLastErrorText()));
      end;
    end;

    // Every thread but AThreadId suspended (a step-over runs it alone)
    hidden method DoSuspendOthers(const AThreadId: uint32);
    var
      LI: int64;
      LCount: int64;
    begin
      for LI := 0 to len(self.FThreadIds) - 1 do
        if self.FThreadIds[LI] <> AThreadId then
          if SuspendThread(self.FThreadHandles[LI]) <> ADAM_WINDOWS_THREAD_FAILED then
            LCount := len(self.FSuspended);
            setlength(self.FSuspended, LCount + 1);
            self.FSuspended[LCount] := self.FThreadHandles[LI];
          end;
        end;
      end;
    end;

    // The threads DoSuspendOthers suspended, resumed
    hidden method DoResumeOthers();
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FSuspended) - 1 do
        ResumeThread(self.FSuspended[LI]);
      end;
      setlength(self.FSuspended, 0);
    end;

    // True (and taken off the list) when AThreadId's single step is a user's Step
    hidden method DoTakeUserStep(const AThreadId: uint32): bool;
    var
      LI: int64;
      LJ: int64;
    begin
      for LI := 0 to len(self.FUserSteps) - 1 do
        if self.FUserSteps[LI] = AThreadId then
          for LJ := LI to len(self.FUserSteps) - 2 do
            self.FUserSteps[LJ] := self.FUserSteps[LJ + 1];
          end;
          setlength(self.FUserSteps, len(self.FUserSteps) - 1);
          return true;
        end;
      end;
      return false;
    end;

    hidden method DoAddThread(const AThreadId: uint32; const AHandle: uint64);
    var
      LCount: int64;
    begin
      LCount := len(self.FThreadIds);
      setlength(self.FThreadIds, LCount + 1);
      setlength(self.FThreadHandles, LCount + 1);
      self.FThreadIds[LCount] := AThreadId;
      self.FThreadHandles[LCount] := AHandle;
    end;

    // AThreadId ended: off the list, its step-over finished (the patch back in, the others
    // resumed) and its user step dropped
    hidden method DoThreadGone(const AThreadId: uint32);
    var
      LI: int64;
      LJ: int64;
    begin
      if self.FStepOverActive and (self.FStepOverThreadId = AThreadId) then
        self.FStepOverActive := false;
        self.DoRepatch(self.FStepOverAddress);
        self.DoResumeOthers();
      end;
      self.DoTakeUserStep(AThreadId);
      for LI := 0 to len(self.FThreadIds) - 1 do
        if self.FThreadIds[LI] = AThreadId then
          for LJ := LI to len(self.FThreadIds) - 2 do
            self.FThreadIds[LJ] := self.FThreadIds[LJ + 1];
            self.FThreadHandles[LJ] := self.FThreadHandles[LJ + 1];
          end;
          setlength(self.FThreadIds, len(self.FThreadIds) - 1);
          setlength(self.FThreadHandles, len(self.FThreadHandles) - 1);
          return;
        end;
      end;
    end;

    hidden const method DoThreadHandle(const AThreadId: uint32; var AHandle: uint64): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FThreadIds) - 1 do
        if self.FThreadIds[LI] = AThreadId then
          AHandle := self.FThreadHandles[LI];
          return true;
        end;
      end;
      return false;
    end;

    // The patch at AAddress' index, -1 for none
    hidden const method DoPatchIndex(const AAddress: uint64): int64;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FPatches) - 1 do
        if self.FPatches[LI].Address = AAddress then
          return LI;
        end;
      end;
      return -1;
    end;

    // ASize bytes at AAddress as they are in the process (patches not hidden)
    hidden method DoReadRaw(const AAddress: uint64; const ASize: int64; var ABytes: ByteArray): bool;
    var
      LRead: uint64;
    begin
      setlength(ABytes, ASize);
      if ASize <= 0 then
        return true;
      end;
      LRead := 0;
      return (ReadProcessMemory(self.FProcess, AAddress, ptr(addr of ABytes[0]), uint64(ASize),
        LRead) <> 0) and (LRead = uint64(ASize));
    end;

    // ACount bytes from ASource written at AAddress, the page made writable for it and put
    // back, the instruction cache flushed (code is written so)
    hidden method DoWriteRaw(const AAddress: uint64; const ASource: ptr to const;
      const ACount: int64): bool;
    var
      LOld: uint32;
      LUnused: uint32;
      LWritten: uint64;
      LProtected: bool;
      LOk: bool;
    begin
      LOld := 0;
      LProtected := VirtualProtectEx(self.FProcess, AAddress, uint64(ACount),
        PAGE_EXECUTE_READWRITE, LOld) <> 0;
      LWritten := 0;
      LOk := (WriteProcessMemory(self.FProcess, AAddress, ASource, uint64(ACount),
        LWritten) <> 0) and (LWritten = uint64(ACount));
      if LProtected then
        LUnused := 0;
        VirtualProtectEx(self.FProcess, AAddress, uint64(ACount), LOld, LUnused);
      end;
      if LOk then
        FlushInstructionCache(self.FProcess, AAddress, uint64(ACount));
      end;
      return LOk;
    end;

    // One code byte written (a patch's int3, or the byte it hides)
    hidden method DoWriteCode(const AAddress: uint64; const AValue: uint8): bool;
    var
      LByte: ByteArray;
    begin
      setlength(LByte, 1);
      LByte[0] := AValue;
      return self.DoWriteRaw(AAddress, addr of LByte[0], 1);
    end;

    hidden method DoQueue(const AEvent: DebugEvent);
    var
      LCount: int64;
    begin
      LCount := len(self.FQueue);
      setlength(self.FQueue, LCount + 1);
      self.FQueue[LCount] := AEvent;
    end;

    // The oldest queued event taken into AEvent; false when none is left (the queue then
    // starts empty again)
    hidden method DoDequeue(var AEvent: DebugEvent): bool;
    begin
      if self.FQueueHead >= len(self.FQueue) then
        setlength(self.FQueue, 0);
        self.FQueueHead := 0;
        return false;
      end;
      AEvent := self.FQueue[self.FQueueHead];
      self.FQueueHead := self.FQueueHead + 1;
      return true;
    end;

    // What the output pipe holds now read and queued as Output events, whole UTF-8 characters
    // only (the rest waits for its bytes); AAll: read to the pipe's end (the program is gone),
    // the last bytes queued as they are, the pipe closed
    hidden method DoDrainOutput(const AAll: bool);
    var
      LBuffer: ByteArray;
      LAvailable: uint32;
      LWant: uint32;
      LRead: uint32;
      LI: int64;
      LCut: int64;
      LOld: int64;
      LEvent: DebugEvent;
    begin
      if self.FPipeRead = 0 then
        return;
      end;
      setlength(LBuffer, int64(ADAM_DEBUG_WIN64_PIPE_CHUNK));
      while true do
        LAvailable := 0;
        if PeekNamedPipe(self.FPipeRead, nil, 0, nil, LAvailable, nil) = 0 then
          leave;
        end;
        if LAvailable = 0 then
          leave;
        end;
        LWant := LAvailable;
        if LWant > ADAM_DEBUG_WIN64_PIPE_CHUNK then
          LWant := ADAM_DEBUG_WIN64_PIPE_CHUNK;
        end;
        LRead := 0;
        if ReadFile(self.FPipeRead, ptr(addr of LBuffer[0]), LWant, LRead, nil) = 0 then
          leave;
        end;
        // Grown once per read, then filled (no append per byte)
        LOld := len(self.FPending);
        setlength(self.FPending, LOld + int64(LRead));
        for LI := 0 to int64(LRead) - 1 do
          self.FPending[LOld + LI] := char(LBuffer[LI]);
        end;
      end;
      if AAll then
        LCut := len(self.FPending);
      else
        LCut := DoWholeUtf8(self.FPending);
      end;
      if LCut > 0 then
        LEvent.Kind := DebugEventKind.Output;
        LEvent.OutputText := Substring(self.FPending, 0, LCut);
        self.DoQueue(LEvent);
        self.FPending := Substring(self.FPending, LCut, len(self.FPending) - LCut);
      end;
      if AAll then
        self.DoClosePipe();
      end;
    end;

    // Terminal mode's pseudo console made (FPseudoConsole, FTerminalInput, FPipeRead its
    // output) and AList the attribute list naming it. False (reported, nothing left open) when
    // the OS refuses
    hidden method DoCreateTerminal(var AList: ByteArray): bool;
    var
      LSecurity: SECURITY_ATTRIBUTES;
      LInputRead: uint64;
      LOutputWrite: uint64;
      LSize: COORD;
      LResult: int32;
      LListSize: uint64;
    begin
      // Two plain pipes, nothing inheritable: the program reaches only the pseudo console,
      // which keeps its own copies of the ends it is given
      LSecurity.nLength := uint32(size(SECURITY_ATTRIBUTES));
      LSecurity.bInheritHandle := 0;
      LInputRead := 0;
      LOutputWrite := 0;
      if (CreatePipe(LInputRead, self.FTerminalInput, LSecurity, 0) = 0) or
        (CreatePipe(self.FPipeRead, LOutputWrite, LSecurity, 0) = 0) then
        self.DoError(ADAM_ERR_DEBUG_002, ADAM_MSG_DEBUG_START_FAILED,
          NoArgs().Str(self.FProgramPath).Str(WinLastErrorText()));
        DoCloseFile(LInputRead);
        self.DoCloseTerminal();
        self.DoClosePipe();
        return false;
      end;
      LSize.X := int16(TerminalSide(self.FTerminalCols, ADAM_DEBUG_TERMINAL_COLS));
      LSize.Y := int16(TerminalSide(self.FTerminalRows, ADAM_DEBUG_TERMINAL_ROWS));
      LResult := CreatePseudoConsole(LSize, LInputRead, LOutputWrite, 0, self.FPseudoConsole);
      CloseHandle(LInputRead);
      CloseHandle(LOutputWrite);
      if LResult <> 0 then
        self.FPseudoConsole := 0;
        self.DoError(ADAM_ERR_DEBUG_002, ADAM_MSG_DEBUG_START_FAILED,
          NoArgs().Str(self.FProgramPath).Str(WinErrorText(uint32(LResult))));
        self.DoCloseTerminal();
        self.DoClosePipe();
        return false;
      end;
      LListSize := 0;
      InitializeProcThreadAttributeList(nil, 1, 0, LListSize);
      setlength(AList, int64(LListSize));
      if (len(AList) = 0) or
        (InitializeProcThreadAttributeList(ptr(addr of AList[0]), 1, 0, LListSize) = 0) or
        (UpdateProcThreadAttribute(ptr(addr of AList[0]), 0, PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE,
        ptr(self.FPseudoConsole), 8, nil, nil) = 0) then
        self.DoError(ADAM_ERR_DEBUG_002, ADAM_MSG_DEBUG_START_FAILED,
          NoArgs().Str(self.FProgramPath).Str(WinLastErrorText()));
        self.DoCloseTerminal();
        self.DoClosePipe();
        return false;
      end;
      return true;
    end;

    // The pseudo console closed: on a task, while this thread reads its output to the pipe's
    // break (it writes out what it holds first), the bytes kept for the last drain; then its
    // input pipe. Nothing when there is none
    hidden method DoCloseTerminal();
    var
      LConsole: uint64;
      LCloser: task;
      LBuffer: ByteArray;
      LRead: uint32;
      LOld: int64;
      LI: int64;
    begin
      if self.FPseudoConsole <> 0 then
        LConsole := self.FPseudoConsole;
        self.FPseudoConsole := 0;
        LCloser := async DoClosePseudoConsole(LConsole);
        if self.FPipeRead <> 0 then
          setlength(LBuffer, int64(ADAM_DEBUG_WIN64_PIPE_CHUNK));
          while true do
            LRead := 0;
            if (ReadFile(self.FPipeRead, ptr(addr of LBuffer[0]), ADAM_DEBUG_WIN64_PIPE_CHUNK,
              LRead, nil) = 0) or (LRead = 0) then
              leave;
            end;
            LOld := len(self.FPending);
            setlength(self.FPending, LOld + int64(LRead));
            for LI := 0 to int64(LRead) - 1 do
              self.FPending[LOld + LI] := char(LBuffer[LI]);
            end;
          end;
        end;
        await LCloser;
      end;
      if self.FTerminalInput <> 0 then
        CloseHandle(self.FTerminalInput);
        self.FTerminalInput := 0;
      end;
    end;

    override method WriteInput(const AText: string): bool;
    var
      LDone: int64;
      LWritten: uint32;
    begin
      if (self.FTerminalInput = 0) or (self.FPseudoConsole = 0) then
        return false;
      end;
      LDone := 0;
      while LDone < len(AText) do
        LWritten := 0;
        if (WriteFile(self.FTerminalInput, ptr(addr of AText[LDone]),
          uint32(len(AText) - LDone), LWritten, nil) = 0) or (LWritten = 0) then
          return false;
        end;
        LDone := LDone + int64(LWritten);
      end;
      return true;
    end;

    override method ResizeTerminal(const ACols: int32; const ARows: int32): bool;
    var
      LSize: COORD;
    begin
      if self.FPseudoConsole = 0 then
        return false;
      end;
      self.FTerminalCols := TerminalSide(ACols, ADAM_DEBUG_TERMINAL_COLS);
      self.FTerminalRows := TerminalSide(ARows, ADAM_DEBUG_TERMINAL_ROWS);
      LSize.X := int16(self.FTerminalCols);
      LSize.Y := int16(self.FTerminalRows);
      return ResizePseudoConsole(self.FPseudoConsole, LSize) = 0;
    end;

    hidden method DoClosePipe();
    begin
      if self.FPipeRead <> 0 then
        CloseHandle(self.FPipeRead);
        self.FPipeRead := 0;
      end;
    end;
  end;

end.
