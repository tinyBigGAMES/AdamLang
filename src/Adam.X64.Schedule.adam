-------------------------------------------------------------------------------
  Adam.X64.Schedule.adam - list scheduling in blocks (PLAN-ADAM M6 O21)

  ScheduleFunction  one selected MachineFunction (Adam.X64.Select), the
                    instructions of each block reordered in place before it
                    is allocated (Adam.X64.Allocate), at fast only
                    (Adam.X64.Arch). It runs over the virtual registers, so
                    no register the allocator picks adds a false dependency.

  regions         a block is cut into regions at its barriers, each barrier
                  kept in its place: a call, push / pop, rep movsb / stosb,
                  the atomics, nop, movaps, a prologue instruction, and the
                  run of closing instructions at the block's end (jcc, jmp,
                  ret, a tail call's jump, ud2); a run past
                  ADAM_X64_SCHEDULE_REGION instructions is cut there too, so
                  the work per block stays linear in its length
  dependencies    inside a region the order of two instructions is kept when
                  they touch one register (virtual or physical, implicit
                  ones included: a read after a write, a write after a read,
                  a write after a write); when they access memory that may
                  be one place, one of them writing (a slot meets only
                  itself, a data symbol only itself, the incoming and the
                  outgoing area only themselves, a place through a register
                  or a segment everything); and when one may fault (a
                  division, an access through a register) and the other
                  writes memory or may fault too, so a fault sees exactly
                  the stores it saw before (a handler reads the slots). The
                  flags: a reader (jcc, setcc, cmov) stays after the writer
                  it reads, every other writer stays out of that span, and
                  the region's last writer stays its last (a jcc after the
                  region may read it); a writer nothing reads moves freely
                  between those. Before a block's closing jcc the writer it
                  reads goes right before it (the compare and branch pair
                  the hardware fuses) unless the region reads it too
  order           a list scheduler over a one-issue cycle model with a
                  latency per op (ADAM_X64_SCHEDULE_LOAD more for a memory
                  read). Of the instructions whose inputs are ready by the
                  current cycle it takes, first, one that reads a physical
                  register and writes none (it ends a fixed interval), then
                  the plain ones, last the ones writing a physical register
                  (they start one: an argument's or a division's register is
                  set as late as it can be); among those the one with the
                  longest path to the region's end. Once
                  ADAM_X64_SCHEDULE_PRESSURE values the region wrote wait
                  for a later reader, it takes the instruction that frees
                  the most of them instead, so the allocator is not handed
                  more live values than the order it was given. Every tie
                  goes to the original order: the output is deterministic.
*******************************************************************************/

module unit Adam.X64.Schedule;

import System.SysUtils, Adam.Core.Containers, Adam.X64.Registers, Adam.X64.Machine;

public const
  // The most instructions one region holds (a longer run is cut: see the header)
  ADAM_X64_SCHEDULE_REGION: int64 = 256;
  // The values waiting for a later reader past which the scheduler frees registers first
  ADAM_X64_SCHEDULE_PRESSURE: int64 = 10;
  // The cycles a memory read adds to its instruction
  ADAM_X64_SCHEDULE_LOAD: int64 = 4;
  // The cycles of the slow ops (every other op takes one): integer multiply, integer
  // division, float add / subtract / multiply, float division, a conversion, a move between
  // a general and a vector register or a float compare
  ADAM_X64_SCHEDULE_MUL: int64 = 3;
  ADAM_X64_SCHEDULE_DIV: int64 = 26;
  ADAM_X64_SCHEDULE_FLOAT: int64 = 4;
  ADAM_X64_SCHEDULE_FLOAT_DIV: int64 = 14;
  ADAM_X64_SCHEDULE_CONVERT: int64 = 5;
  ADAM_X64_SCHEDULE_CROSS: int64 = 2;
  // Raised (an invariant broken): a register number the function does not have; a region
  // no order finishes (a dependency cycle)
  ADAM_X64_SCHEDULE_FAULT_REGISTER: string = "X64 schedule: no register ";
  ADAM_X64_SCHEDULE_FAULT_STUCK: string = "X64 schedule: a dependency cycle in block ";

const
  // An instruction's rank (see the header): it reads a physical register and writes none,
  // it touches none, it writes one
  ADAM_X64_SCHEDULE_RANK_ENDS: int64 = 0;
  ADAM_X64_SCHEDULE_RANK_PLAIN: int64 = 1;
  ADAM_X64_SCHEDULE_RANK_STARTS: int64 = 2;

type
  // What a memory place is, for the may-meet rule (see the header)
  PlaceClass = choices(Slot, Incoming, Outgoing, Data, Unknown);

  // One memory access of an instruction: its place and whether it reads / writes it
  MemoryAccess = object
    Place: PlaceClass;
    // Slot: the slot's index; Data: the symbol
    SlotIndex: int64;
    SymbolName: string;
    Reads: bool;
    Writes: bool;

    init(const APlace: PlaceClass);
    begin
      self.Place := APlace;
      self.SlotIndex := 0;
      self.SymbolName := "";
      self.Reads := false;
      self.Writes := false;
    end;
  end;

  AccessArray = array of ref MemoryAccess;
  InstrArray = array of ref MachineInstr;
  ScheduleLists = array of ref Int64List;

// True for the ops that read the flags: jcc, setcc, cmov
routine DoReadsFlags(const AOp: X64Op): bool;
begin
  return (AOp = X64Op.Jcc) or (AOp = X64Op.SetCC) or (AOp = X64Op.CMov);
end;

// True for the ops that leave the flags as they were (every other op may write them: the
// integer arithmetic, the compares, the divisions, zero, a call)
routine DoKeepsFlags(const AOp: X64Op): bool;
begin
  return (AOp = X64Op.Mov) or (AOp = X64Op.MovD) or (AOp = X64Op.MovQ) or
    (AOp = X64Op.MovSS) or (AOp = X64Op.MovSD) or (AOp = X64Op.MovAps) or (AOp = X64Op.Lea) or
    X64OpIsScalarArith(AOp) or X64OpIsFloatConvert(AOp) or X64OpIsExtend(AOp) or
    (AOp = X64Op.BitNot) or (AOp = X64Op.SetCC) or (AOp = X64Op.CMov) or (AOp = X64Op.Cqo) or
    (AOp = X64Op.Xchg) or (AOp = X64Op.Nop) or (AOp = X64Op.Jmp) or (AOp = X64Op.Jcc) or
    (AOp = X64Op.Push) or (AOp = X64Op.Pop) or (AOp = X64Op.RepMovsb) or
    (AOp = X64Op.RepStosb);
end;

// True for an instruction that stays in its place and ends a region (see the header)
routine DoIsBarrier(const AInstr: ref MachineInstr): bool;
var
  LOp: X64Op;
begin
  LOp := AInstr.Op;
  return AInstr.Prologue or (LOp = X64Op.Call) or (LOp = X64Op.Jcc) or X64OpCloses(LOp) or
    (LOp = X64Op.Push) or (LOp = X64Op.Pop) or (LOp = X64Op.RepMovsb) or
    (LOp = X64Op.RepStosb) or X64OpIsAtomic(LOp) or (LOp = X64Op.Nop) or (LOp = X64Op.MovAps);
end;

// True for an instruction of a block's closing run (see the header)
routine DoIsClosing(const AInstr: ref MachineInstr): bool;
begin
  return (AInstr.Op = X64Op.Jcc) or X64OpCloses(AInstr.Op);
end;

// The cycles AOp takes before its result is ready, its memory read aside
routine DoLatencyOf(const AOp: X64Op): int64;
begin
  if (AOp = X64Op.IMul) or X64OpIsWideMul(AOp) then
    return ADAM_X64_SCHEDULE_MUL;
  end;
  if X64OpIsDivide(AOp) then
    return ADAM_X64_SCHEDULE_DIV;
  end;
  if (AOp = X64Op.DivSS) or (AOp = X64Op.DivSD) then
    return ADAM_X64_SCHEDULE_FLOAT_DIV;
  end;
  if X64OpIsScalarArith(AOp) and (AOp <> X64Op.XorPS) then
    return ADAM_X64_SCHEDULE_FLOAT;
  end;
  if X64OpIsFloatConvert(AOp) then
    return ADAM_X64_SCHEDULE_CONVERT;
  end;
  if (AOp = X64Op.MovD) or (AOp = X64Op.MovQ) or X64OpIsFloatCompare(AOp) then
    return ADAM_X64_SCHEDULE_CROSS;
  end;
  return 1;
end;

// The place of the memory operand AOperand (see the header)
routine DoAccessOf(const AOperand: ref MachineOperand): ref MemoryAccess;
var
  LAccess: ref MemoryAccess;
begin
  if AOperand.Base = MemoryBase.Slot then
    LAccess := ref MemoryAccess(PlaceClass.Slot);
    LAccess.SlotIndex := AOperand.SlotIndex;
    return LAccess;
  end;
  if AOperand.Base = MemoryBase.Incoming then
    return ref MemoryAccess(PlaceClass.Incoming);
  end;
  if AOperand.Base = MemoryBase.Outgoing then
    return ref MemoryAccess(PlaceClass.Outgoing);
  end;
  if AOperand.Base = MemoryBase.RipSymbol then
    LAccess := ref MemoryAccess(PlaceClass.Data);
    LAccess.SymbolName := AOperand.SymbolName;
    return LAccess;
  end;
  return ref MemoryAccess(PlaceClass.Unknown);
end;

// True when accesses AA and AB may be one place and one of them writes (see the header)
routine DoMayMeet(const AA: ref MemoryAccess; const AB: ref MemoryAccess): bool;
begin
  if not AA.Writes and not AB.Writes then
    return false;
  end;
  if (AA.Place = PlaceClass.Unknown) or (AB.Place = PlaceClass.Unknown) then
    return true;
  end;
  if AA.Place <> AB.Place then
    return false;
  end;
  if AA.Place = PlaceClass.Slot then
    return AA.SlotIndex = AB.SlotIndex;
  end;
  if AA.Place = PlaceClass.Data then
    return AA.SymbolName = AB.SymbolName;
  end;
  return true;
end;

// AKey added to AList unless it is there
routine DoAddKey(const AList: ref Int64List; const AKey: int64);
begin
  if AList.IndexOf(AKey) < 0 then
    AList.Add(AKey);
  end;
end;

type
  // One function's scheduler (see the header): the register state per key (a virtual
  // register's number, a physical register's number after them) and one region at a time
  Scheduler = object
    hidden FFunction: ref MachineFunction;
    hidden FVRegs: int64;
    hidden FKeys: int64;
    hidden FBlockIndex: int64;
    // Per key, set at its first touch in a region: its last writer there (-1: none), its
    // readers since, its reads left in the region, whether a value written into it waits
    // for one of them; the keys the region touched
    hidden FMarked: BoolArray;
    hidden FLastWriter: Int64Array;
    hidden FReaders: ScheduleLists;
    hidden FUsesLeft: Int64Array;
    hidden FOpen: BoolArray;
    hidden FTouched: ref Int64List;
    // The region: its instructions; per instruction the keys it reads and writes, its
    // memory accesses (FAccess from FAccessFrom up to FAccessTo), whether it writes memory
    // and whether it may fault, its latency, rank and longest path to the region's end;
    // the edges (successors with their latencies) and each one's predecessors left
    hidden FRegion: InstrArray;
    hidden FCount: int64;
    hidden FReadKeys: ScheduleLists;
    hidden FWriteKeys: ScheduleLists;
    hidden FAccess: AccessArray;
    hidden FAccessCount: int64;
    hidden FAccessFrom: Int64Array;
    hidden FAccessTo: Int64Array;
    hidden FWritesMemory: BoolArray;
    hidden FFaults: BoolArray;
    hidden FLatency: Int64Array;
    hidden FRank: Int64Array;
    hidden FHeight: Int64Array;
    hidden FSuccs: ScheduleLists;
    hidden FSuccLatency: ScheduleLists;
    hidden FPredsLeft: Int64Array;

    init(const AFunction: ref MachineFunction);
    var
      LRegisters: ref X64Registers;
      LK: int64;
    begin
      self.FFunction := AFunction;
      LRegisters := ref X64Registers();
      self.FVRegs := AFunction.VRegCount;
      self.FKeys := self.FVRegs + LRegisters.Count();
      self.FBlockIndex := 0;
      setlength(self.FMarked, self.FKeys);
      setlength(self.FLastWriter, self.FKeys);
      setlength(self.FReaders, self.FKeys);
      setlength(self.FUsesLeft, self.FKeys);
      setlength(self.FOpen, self.FKeys);
      for LK := 0 to self.FKeys - 1 do
        self.FMarked[LK] := false;
        self.FLastWriter[LK] := -1;
        self.FUsesLeft[LK] := 0;
        self.FOpen[LK] := false;
      end;
      self.FTouched := ref Int64List();
      self.FCount := 0;
      self.FAccessCount := 0;
    end;

    // The key of register AReg (virtual when AVirtual); raises for a number it has not
    hidden const method DoKey(const AReg: int64; const AVirtual: bool): int64;
    var
      LKey: int64;
    begin
      if AVirtual then
        LKey := AReg;
      else
        LKey := self.FVRegs + AReg;
      end;
      if (AReg < 0) or (LKey >= self.FKeys) then
        raise(ADAM_X64_SCHEDULE_FAULT_REGISTER + IntToStr(AReg));
      end;
      return LKey;
    end;

    // Key AKey's state set fresh at its first touch in the region
    hidden method DoTouch(const AKey: int64);
    begin
      if not self.FMarked[AKey] then
        self.FMarked[AKey] := true;
        self.FLastWriter[AKey] := -1;
        self.FReaders[AKey] := ref Int64List();
        self.FUsesLeft[AKey] := 0;
        self.FOpen[AKey] := false;
        self.FTouched.Add(AKey);
      end;
    end;

    // The keys AInstr reads into AReads and writes into AWrites, each once: its register
    // operands, its memory places' bases and indexes (read), its implicit registers
    hidden method DoKeysOf(const AInstr: ref MachineInstr; const AReads: ref Int64List;
      const AWrites: ref Int64List);
    var
      LOperand: ref MachineOperand;
      LVirtual: bool;
      LK: int64;
    begin
      for LK := 0 to AInstr.OperandCount - 1 do
        LOperand := AInstr.OperandAt(LK);
        if (LOperand.Kind = OperandKind.VirtualReg) or (LOperand.Kind = OperandKind.PhysicalReg) then
          LVirtual := LOperand.Kind = OperandKind.VirtualReg;
          if X64OperandReads(AInstr, LK) then
            DoAddKey(AReads, self.DoKey(LOperand.Reg, LVirtual));
          end;
          if X64OperandWrites(AInstr, LK) then
            DoAddKey(AWrites, self.DoKey(LOperand.Reg, LVirtual));
          end;
        end;
        if LOperand.Kind = OperandKind.Memory then
          if LOperand.Base = MemoryBase.Register then
            DoAddKey(AReads, self.DoKey(LOperand.Reg, LOperand.BaseVirtual));
          end;
          if LOperand.Scale > 0 then
            DoAddKey(AReads, self.DoKey(LOperand.IndexReg, LOperand.IndexVirtual));
          end;
        end;
      end;
      for LK := 0 to AInstr.ImplicitUses.Count - 1 do
        DoAddKey(AReads, self.DoKey(AInstr.ImplicitUses[LK], false));
      end;
      for LK := 0 to AInstr.ImplicitDefs.Count - 1 do
        DoAddKey(AWrites, self.DoKey(AInstr.ImplicitDefs[LK], false));
      end;
    end;

    // AAccess added to the region's accesses
    hidden method DoAddAccess(const AAccess: ref MemoryAccess);
    begin
      if self.FAccessCount = len(self.FAccess) then
        setlength(self.FAccess, self.FAccessCount * 2 + 8);
      end;
      self.FAccess[self.FAccessCount] := AAccess;
      self.FAccessCount := self.FAccessCount + 1;
    end;

    // The memory accesses of region instruction AIndex (a lea's place is no access), whether
    // it writes memory and whether it may fault (see the header)
    hidden method DoAccessesOf(const AIndex: int64);
    var
      LInstr: ref MachineInstr;
      LOperand: ref MachineOperand;
      LAccess: ref MemoryAccess;
      LK: int64;
    begin
      LInstr := self.FRegion[AIndex];
      self.FAccessFrom[AIndex] := self.FAccessCount;
      self.FWritesMemory[AIndex] := false;
      self.FFaults[AIndex] := X64OpIsDivide(LInstr.Op);
      if LInstr.Op <> X64Op.Lea then
        for LK := 0 to LInstr.OperandCount - 1 do
          LOperand := LInstr.OperandAt(LK);
          if LOperand.Kind = OperandKind.Memory then
            LAccess := DoAccessOf(LOperand);
            LAccess.Writes := (LK = 0) and X64OpWritesDest(LInstr.Op);
            // A place it neither writes nor names as read is taken as read
            LAccess.Reads := (LK > 0) or X64OpReadsDest(LInstr.Op) or not LAccess.Writes;
            if LAccess.Writes then
              self.FWritesMemory[AIndex] := true;
            end;
            if (LOperand.Base = MemoryBase.Register) then
              self.FFaults[AIndex] := true;
            end;
            self.DoAddAccess(LAccess);
          end;
        end;
      end;
      self.FAccessTo[AIndex] := self.FAccessCount;
    end;

    // True when region instruction AFrom (before ATo) and ATo keep their order for memory or
    // a fault (see the header)
    hidden const method DoMemoryOrdered(const AFrom: int64; const ATo: int64): bool;
    var
      LA: int64;
      LB: int64;
    begin
      if self.FFaults[ATo] and (self.FFaults[AFrom] or self.FWritesMemory[AFrom]) then
        return true;
      end;
      if self.FFaults[AFrom] and self.FWritesMemory[ATo] then
        return true;
      end;
      for LA := self.FAccessFrom[AFrom] to self.FAccessTo[AFrom] - 1 do
        for LB := self.FAccessFrom[ATo] to self.FAccessTo[ATo] - 1 do
          if DoMayMeet(self.FAccess[LA], self.FAccess[LB]) then
            return true;
          end;
        end;
      end;
      return false;
    end;

    // An edge: region instruction ATo after AFrom, its result ALatency cycles later
    hidden method DoEdge(const AFrom: int64; const ATo: int64; const ALatency: int64);
    begin
      if AFrom <> ATo then
        self.FSuccs[AFrom].Add(ATo);
        self.FSuccLatency[AFrom].Add(ALatency);
        self.FPredsLeft[ATo] := self.FPredsLeft[ATo] + 1;
      end;
    end;

    // Every flag writer in APending before AProducer (the flags' last writer): the producer
    // stays the last of them
    hidden method DoPinProducer(const APending: ref Int64List; const AProducer: int64);
    var
      LI: int64;
    begin
      for LI := 0 to APending.Count - 1 do
        if APending[LI] <> AProducer then
          self.DoEdge(APending[LI], AProducer, 0);
        end;
      end;
    end;

    // The region's facts per instruction (keys, accesses, latency, rank)
    hidden method DoFacts();
    var
      LInstr: ref MachineInstr;
      LRank: int64;
      LI: int64;
      LK: int64;
    begin
      setlength(self.FReadKeys, self.FCount);
      setlength(self.FWriteKeys, self.FCount);
      setlength(self.FAccessFrom, self.FCount);
      setlength(self.FAccessTo, self.FCount);
      setlength(self.FWritesMemory, self.FCount);
      setlength(self.FFaults, self.FCount);
      setlength(self.FLatency, self.FCount);
      setlength(self.FRank, self.FCount);
      setlength(self.FHeight, self.FCount);
      setlength(self.FSuccs, self.FCount);
      setlength(self.FSuccLatency, self.FCount);
      setlength(self.FPredsLeft, self.FCount);
      self.FAccessCount := 0;
      for LI := 0 to self.FCount - 1 do
        LInstr := self.FRegion[LI];
        self.FReadKeys[LI] := ref Int64List();
        self.FWriteKeys[LI] := ref Int64List();
        self.FSuccs[LI] := ref Int64List();
        self.FSuccLatency[LI] := ref Int64List();
        self.FPredsLeft[LI] := 0;
        self.FHeight[LI] := 0;
        self.DoKeysOf(LInstr, self.FReadKeys[LI], self.FWriteKeys[LI]);
        self.DoAccessesOf(LI);
        self.FLatency[LI] := DoLatencyOf(LInstr.Op);
        for LK := self.FAccessFrom[LI] to self.FAccessTo[LI] - 1 do
          if self.FAccess[LK].Reads then
            self.FLatency[LI] := DoLatencyOf(LInstr.Op) + ADAM_X64_SCHEDULE_LOAD;
          end;
        end;
        LRank := ADAM_X64_SCHEDULE_RANK_PLAIN;
        for LK := 0 to self.FReadKeys[LI].Count - 1 do
          if self.FReadKeys[LI][LK] >= self.FVRegs then
            LRank := ADAM_X64_SCHEDULE_RANK_ENDS;
          end;
        end;
        for LK := 0 to self.FWriteKeys[LI].Count - 1 do
          if self.FWriteKeys[LI][LK] >= self.FVRegs then
            LRank := ADAM_X64_SCHEDULE_RANK_STARTS;
          end;
        end;
        self.FRank[LI] := LRank;
      end;
    end;

    // The register edges (see the header); counts each key's reads in the region
    hidden method DoRegisterEdges();
    var
      LKey: int64;
      LWriter: int64;
      LI: int64;
      LK: int64;
      LJ: int64;
    begin
      for LI := 0 to self.FCount - 1 do
        for LK := 0 to self.FReadKeys[LI].Count - 1 do
          LKey := self.FReadKeys[LI][LK];
          self.DoTouch(LKey);
          LWriter := self.FLastWriter[LKey];
          if LWriter >= 0 then
            self.DoEdge(LWriter, LI, self.FLatency[LWriter]);
          end;
          self.FReaders[LKey].Add(LI);
          self.FUsesLeft[LKey] := self.FUsesLeft[LKey] + 1;
        end;
        for LK := 0 to self.FWriteKeys[LI].Count - 1 do
          LKey := self.FWriteKeys[LI][LK];
          self.DoTouch(LKey);
          LWriter := self.FLastWriter[LKey];
          if LWriter >= 0 then
            self.DoEdge(LWriter, LI, 0);
          end;
          for LJ := 0 to self.FReaders[LKey].Count - 1 do
            self.DoEdge(self.FReaders[LKey][LJ], LI, 0);
          end;
          self.FLastWriter[LKey] := LI;
          self.FReaders[LKey] := ref Int64List();
        end;
      end;
    end;

    // The memory and fault edges (see the header)
    hidden method DoMemoryEdges();
    var
      LI: int64;
      LJ: int64;
    begin
      for LI := 1 to self.FCount - 1 do
        if self.FFaults[LI] or (self.FAccessTo[LI] > self.FAccessFrom[LI]) then
          for LJ := 0 to LI - 1 do
            if self.FFaults[LJ] or (self.FAccessTo[LJ] > self.FAccessFrom[LJ]) then
              if self.DoMemoryOrdered(LJ, LI) then
                self.DoEdge(LJ, LI, 1);
              end;
            end;
          end;
        end;
      end;
    end;

    // The flags edges (see the header): the readers since the latest writer (the open
    // group), the readers of the group before (every writer until the next group's writer
    // follows them), the writers since that group, and the latest writer; returns the
    // region's last writer (-1: none)
    hidden method DoFlagsEdges(): int64;
    var
      LReaders: ref Int64List;
      LPrevReaders: ref Int64List;
      LPending: ref Int64List;
      LProducer: int64;
      LOp: X64Op;
      LI: int64;
      LJ: int64;
    begin
      LReaders := ref Int64List();
      LPrevReaders := ref Int64List();
      LPending := ref Int64List();
      LProducer := -1;
      for LI := 0 to self.FCount - 1 do
        LOp := self.FRegion[LI].Op;
        if DoReadsFlags(LOp) then
          if LReaders.Count = 0 then
            // A group opens: the writer it reads stays the last of the writers since the
            // group before
            self.DoPinProducer(LPending, LProducer);
            LPending := ref Int64List();
          end;
          if LProducer >= 0 then
            self.DoEdge(LProducer, LI, 1);
          end;
          LReaders.Add(LI);
        end;
        if not DoKeepsFlags(LOp) then
          if LReaders.Count > 0 then
            LPrevReaders := LReaders;
            LReaders := ref Int64List();
          end;
          for LJ := 0 to LPrevReaders.Count - 1 do
            self.DoEdge(LPrevReaders[LJ], LI, 0);
          end;
          LPending.Add(LI);
          LProducer := LI;
        end;
      end;
      // The region's last writer stays its last: what follows the region may read it
      self.DoPinProducer(LPending, LProducer);
      return LProducer;
    end;

    // Each instruction's longest path to the region's end (every edge goes forward)
    hidden method DoHeights();
    var
      LHeight: int64;
      LI: int64;
      LK: int64;
    begin
      for LI := self.FCount - 1 downto 0 do
        LHeight := self.FLatency[LI];
        for LK := 0 to self.FSuccs[LI].Count - 1 do
          if self.FSuccLatency[LI][LK] + self.FHeight[self.FSuccs[LI][LK]] > LHeight then
            LHeight := self.FSuccLatency[LI][LK] + self.FHeight[self.FSuccs[LI][LK]];
          end;
        end;
        self.FHeight[LI] := LHeight;
      end;
    end;

    // The values region instruction AIndex frees (its last reads of a virtual register)
    // less the ones it makes wait (a virtual register it writes that a later instruction
    // reads, not already waiting)
    hidden const method DoFreed(const AIndex: int64): int64;
    var
      LKey: int64;
      LLeft: int64;
      LFreed: int64;
      LK: int64;
    begin
      LFreed := 0;
      for LK := 0 to self.FReadKeys[AIndex].Count - 1 do
        LKey := self.FReadKeys[AIndex][LK];
        if (LKey < self.FVRegs) and (self.FUsesLeft[LKey] = 1) then
          LFreed := LFreed + 1;
        end;
      end;
      for LK := 0 to self.FWriteKeys[AIndex].Count - 1 do
        LKey := self.FWriteKeys[AIndex][LK];
        if (LKey < self.FVRegs) and not self.FOpen[LKey] then
          LLeft := self.FUsesLeft[LKey];
          if self.FReadKeys[AIndex].IndexOf(LKey) >= 0 then
            LLeft := LLeft - 1;
          end;
          if LLeft > 0 then
            LFreed := LFreed - 1;
          end;
        end;
      end;
      return LFreed;
    end;

    // True when region instruction AA goes before AB, both free to go at cycle ACycle
    // (AReadyAt: when each one's inputs are ready), APressed when the waiting values reach
    // ADAM_X64_SCHEDULE_PRESSURE (see the header)
    hidden const method DoBefore(const AA: int64; const AB: int64; const AReadyAt: Int64Array;
      const ACycle: int64; const APressed: bool): bool;
    var
      LReadyA: bool;
      LReadyB: bool;
      LFreedA: int64;
      LFreedB: int64;
    begin
      if APressed then
        LFreedA := self.DoFreed(AA);
        LFreedB := self.DoFreed(AB);
        if LFreedA <> LFreedB then
          return LFreedA > LFreedB;
        end;
        if self.FRank[AA] <> self.FRank[AB] then
          return self.FRank[AA] < self.FRank[AB];
        end;
        return AA < AB;
      end;
      LReadyA := AReadyAt[AA] <= ACycle;
      LReadyB := AReadyAt[AB] <= ACycle;
      if LReadyA and not LReadyB then
        return true;
      end;
      if LReadyB and not LReadyA then
        return false;
      end;
      if not LReadyA and (AReadyAt[AA] <> AReadyAt[AB]) then
        return AReadyAt[AA] < AReadyAt[AB];
      end;
      if self.FRank[AA] <> self.FRank[AB] then
        return self.FRank[AA] < self.FRank[AB];
      end;
      if self.FHeight[AA] <> self.FHeight[AB] then
        return self.FHeight[AA] > self.FHeight[AB];
      end;
      return AA < AB;
    end;

    // The region's order (see the header), as region instruction numbers
    hidden method DoOrder(): ref Int64List;
    var
      LOrder: ref Int64List;
      LReadyAt: Int64Array;
      LDone: BoolArray;
      LCycle: int64;
      LWaiting: int64;
      LBest: int64;
      LIssue: int64;
      LKey: int64;
      LSucc: int64;
      LI: int64;
      LK: int64;
    begin
      setlength(LReadyAt, self.FCount);
      setlength(LDone, self.FCount);
      for LI := 0 to self.FCount - 1 do
        LReadyAt[LI] := 0;
        LDone[LI] := false;
      end;
      LOrder := ref Int64List();
      LCycle := 0;
      LWaiting := 0;
      while LOrder.Count < self.FCount do
        LBest := -1;
        for LI := 0 to self.FCount - 1 do
          if not LDone[LI] and (self.FPredsLeft[LI] = 0) then
            if LBest < 0 then
              LBest := LI;
            else
              if self.DoBefore(LI, LBest, LReadyAt, LCycle,
                LWaiting >= ADAM_X64_SCHEDULE_PRESSURE) then
                LBest := LI;
              end;
            end;
          end;
        end;
        if LBest < 0 then
          raise(ADAM_X64_SCHEDULE_FAULT_STUCK + IntToStr(self.FBlockIndex));
        end;
        LDone[LBest] := true;
        LOrder.Add(LBest);
        // One instruction issues per cycle, once its inputs are ready
        LIssue := LCycle;
        if LReadyAt[LBest] > LIssue then
          LIssue := LReadyAt[LBest];
        end;
        LCycle := LIssue + 1;
        for LK := 0 to self.FSuccs[LBest].Count - 1 do
          LSucc := self.FSuccs[LBest][LK];
          if LIssue + self.FSuccLatency[LBest][LK] > LReadyAt[LSucc] then
            LReadyAt[LSucc] := LIssue + self.FSuccLatency[LBest][LK];
          end;
          self.FPredsLeft[LSucc] := self.FPredsLeft[LSucc] - 1;
        end;
        // The values waiting for a later reader: a last read frees one, a write a later
        // instruction reads makes one wait
        for LK := 0 to self.FReadKeys[LBest].Count - 1 do
          LKey := self.FReadKeys[LBest][LK];
          if LKey < self.FVRegs then
            self.FUsesLeft[LKey] := self.FUsesLeft[LKey] - 1;
            if (self.FUsesLeft[LKey] = 0) and self.FOpen[LKey] then
              self.FOpen[LKey] := false;
              LWaiting := LWaiting - 1;
            end;
          end;
        end;
        for LK := 0 to self.FWriteKeys[LBest].Count - 1 do
          LKey := self.FWriteKeys[LBest][LK];
          if (LKey < self.FVRegs) and (self.FUsesLeft[LKey] > 0) and not self.FOpen[LKey] then
            self.FOpen[LKey] := true;
            LWaiting := LWaiting + 1;
          end;
        end;
      end;
      return LOrder;
    end;

    // Instructions AFrom up to ATo of AAll (one region) added to ABlock in their scheduled
    // order; AFeedsJump when the block's closing jcc follows the region: the flag writer it
    // reads goes right before it (the pair the hardware fuses), unless an instruction in
    // the region reads that writer's flags too; the keys the region touched made fresh for
    // the next one
    hidden method DoRegion(const AAll: InstrArray; const AFrom: int64; const ATo: int64;
      const ABlock: ref MachineBlock; const AFeedsJump: bool);
    var
      LOrder: ref Int64List;
      LProducer: int64;
      LI: int64;
    begin
      self.FCount := ATo - AFrom;
      if self.FCount < 2 then
        for LI := AFrom to ATo - 1 do
          ABlock.AddInstr(AAll[LI]);
        end;
        return;
      end;
      setlength(self.FRegion, self.FCount);
      for LI := 0 to self.FCount - 1 do
        self.FRegion[LI] := AAll[AFrom + LI];
      end;
      self.DoFacts();
      self.DoRegisterEdges();
      self.DoMemoryEdges();
      LProducer := self.DoFlagsEdges();
      if AFeedsJump and (LProducer >= 0) then
        if self.FSuccs[LProducer].Count = 0 then
          // Every other instruction before it: with no successor it closes no cycle, and its
          // height is its latency before DoHeights reads it (these edges run backward)
          for LI := 0 to self.FCount - 1 do
            self.DoEdge(LI, LProducer, 0);
          end;
          self.FHeight[LProducer] := self.FLatency[LProducer];
        end;
      end;
      self.DoHeights();
      LOrder := self.DoOrder();
      for LI := 0 to LOrder.Count - 1 do
        ABlock.AddInstr(self.FRegion[LOrder[LI]]);
      end;
      for LI := 0 to self.FTouched.Count - 1 do
        self.FMarked[self.FTouched[LI]] := false;
      end;
      self.FTouched := ref Int64List();
    end;

    // Block ABlockIndex's instructions scheduled region by region (see the header)
    method ScheduleBlock(const ABlockIndex: int64);
    var
      LBlock: ref MachineBlock;
      LAll: InstrArray;
      LCount: int64;
      LTail: int64;
      LStart: int64;
      LFeedsJump: bool;
      LI: int64;
    begin
      LBlock := self.FFunction.BlockAt(ABlockIndex);
      LCount := LBlock.InstrCount;
      if LCount < 3 then
        return;
      end;
      self.FBlockIndex := ABlockIndex;
      setlength(LAll, LCount);
      for LI := 0 to LCount - 1 do
        LAll[LI] := LBlock.InstrAt(LI);
      end;
      // The closing run stays at the end as it is
      LTail := LCount;
      while LTail > 0 do
        if not DoIsClosing(LAll[LTail - 1]) then
          leave;
        end;
        LTail := LTail - 1;
      end;
      LBlock.Clear();
      LStart := 0;
      for LI := 0 to LTail - 1 do
        if DoIsBarrier(LAll[LI]) then
          self.DoRegion(LAll, LStart, LI, LBlock, false);
          LBlock.AddInstr(LAll[LI]);
          LStart := LI + 1;
        else
          if (LI - LStart) = ADAM_X64_SCHEDULE_REGION then
            self.DoRegion(LAll, LStart, LI, LBlock, false);
            LStart := LI;
          end;
        end;
      end;
      LFeedsJump := false;
      if LTail < LCount then
        LFeedsJump := LAll[LTail].Op = X64Op.Jcc;
      end;
      self.DoRegion(LAll, LStart, LTail, LBlock, LFeedsJump);
      for LI := LTail to LCount - 1 do
        LBlock.AddInstr(LAll[LI]);
      end;
    end;
  end;

// AMachine (selected, not yet allocated) with every block's instructions list-scheduled in
// place (see the header)
public routine ScheduleFunction(const AMachine: ref MachineFunction);
var
  LScheduler: ref Scheduler;
  LB: int64;
begin
  LScheduler := ref Scheduler(AMachine);
  for LB := 0 to AMachine.BlockCount - 1 do
    LScheduler.ScheduleBlock(LB);
  end;
end;

end.
