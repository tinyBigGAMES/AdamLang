-------------------------------------------------------------------------------
  Adam.Win64.Unwind.adam - Windows x64 unwind data (DESIGN sec 6)

  The Windows x64 ABI part's unwind sections: Adam.Backend.Unwind's tables
  (UNWIND_INFO, RUNTIME_FUNCTION and the scope tables) in Microsoft's .xdata
  and .pdata, where the OS's unwinder finds them through the image's
  exception directory.

  UnwindFunction  writes one function's (TableUnwind under these names)
*******************************************************************************/

module unit Adam.Win64.Unwind;

import Adam.Backend.Sections, Adam.Backend.Parts, Adam.Backend.Unwind;

public const
  // The two sections (Microsoft's names)
  ADAM_WIN64_UNWIND_XDATA: string = ".xdata";
  ADAM_WIN64_UNWIND_PDATA: string = ".pdata";

// ACode's unwind data written into ASections as its own .xdata and .pdata pieces
// (TableUnwind); returns what was written (nothing for a bare leaf)
public routine UnwindFunction(const ACode: ref FunctionCode; const ASections: ref SectionSet):
  ref UnwindEntry;
begin
  return TableUnwind(ACode, ASections, ADAM_WIN64_UNWIND_XDATA, ADAM_WIN64_UNWIND_PDATA);
end;

end.
