-------------------------------------------------------------------------------
  Adam.Elf.Dynamic.adam - what a dynamically linked ELF64 exe holds beside its
  code (PLAN-LINUX64 LX3b, H3; research kb_elf_dynamic.md, kb_glibc_floor.md)

  Every layout fact is the System V gABI's or the GNU symbol versioning's
  (Elf64_Sym, the SysV hash table, Elf64_Verneed / Elf64_Vernaux, the
  version symbol table) with elf.h's names (std System.Elf); nothing here
  knows an address: Adam.Elf.Linker lays the bytes out and writes .rela.dyn
  and .dynamic.

  SharedTable   a shared C runtime's version table (glibc.abi, the ABI's
                CRuntimeFacts.SharedTable): one line per symbol `<name>
                <version> <file> <F|O>` (F a routine, O data), '#' lines and
                empty ones skipped; each symbol bound as GNU ld binds it when
                linking against the glibc floor the table was made for
                (scripts\linux\glibc_table.py). Load is false at a line that
                is not of that form (its number in BadLine)
  DynamicImports  the exe's imports in .dynsym order (index 1 up; Add, in
                first-need order), then Build: .dynstr ("" first, then each
                needed file, the names, the versions, each text once),
                .dynsym (the null symbol, then each import undefined:
                STB_GLOBAL or STB_WEAK, STT_FUNC or STT_OBJECT, value and
                size 0: every reference reads its slot, so no import needs a
                canonical address in the exe), .hash (DT_HASH: GNU ld's
                bucket count for the symbol count, the ELF hash, every
                symbol chained), .gnu.version (0 for the null symbol, then
                each import's Vernaux index), .gnu.version_r (one Verneed per
                file in first-need order, its Vernaux per version in
                first-need order, indexes from 2; vna_hash the ELF hash of
                the version); Needed the files in that order (DT_NEEDED,
                each a Verneed file: the loader checks every one is loaded), by
                .dynstr offset and NeededFiles by name
  CountFrameRecords / BuildFrameIndex  .eh_frame_hdr (the LSB's
                PT_GNU_EH_FRAME: version 1, eh_frame_ptr pcrel | sdata4,
                fde_count udata4, the table datarel | sdata4: each FDE's
                initial location and address less the header's, sorted by
                location): an .eh_frame's records walked (a length, 0xFFFFFFFF
                then a 64-bit one; a zero length its end), a CIE's "z"
                augmentation read for its R (the FDE pointer encoding; P and
                L skipped, S / B none), an FDE's initial location decoded by
                it (absptr, udata2 / 4 / 8, sdata2 / 4 / 8; absolute or
                pcrel). False at a record it cannot read (its offset in
                ABad): another encoding, an FDE naming no CIE, a record past
                the end
  Deterministic: every list in the order given; no time, no path.
*******************************************************************************/

module unit Adam.Elf.Dynamic;

import System.SysUtils, Adam.Core.Common, Adam.Core.Containers, System.Elf;

public const
  // The record sizes (Elf64_Sym, Elf64_Rela, Elf64_Dyn, Elf64_Verneed, Elf64_Vernaux, a
  // versym entry, a hash word) and .eh_frame_hdr's header and table entry
  ADAM_ELF_DYNAMIC_SYM: int64 = 24;
  ADAM_ELF_DYNAMIC_RELA: int64 = 24;
  ADAM_ELF_DYNAMIC_DYN: int64 = 16;
  ADAM_ELF_DYNAMIC_VERNEED: int64 = 16;
  ADAM_ELF_DYNAMIC_VERNAUX: int64 = 16;
  ADAM_ELF_DYNAMIC_VERSYM: int64 = 2;
  ADAM_ELF_DYNAMIC_WORD: int64 = 4;
  ADAM_ELF_DYNAMIC_HDR_HEAD: int64 = 12;
  ADAM_ELF_DYNAMIC_HDR_ENTRY: int64 = 8;

const
  // A table line's routine / data mark, its comment mark
  ADAM_ELF_DYNAMIC_ROUTINE: string = "F";
  ADAM_ELF_DYNAMIC_DATA: string = "O";
  ADAM_ELF_DYNAMIC_COMMENT: string = "#";
  // A shared library's file name: lib<name>.so.<n>
  ADAM_ELF_DYNAMIC_LIB_PREFIX: string = "lib";
  ADAM_ELF_DYNAMIC_SO_MARK: string = ADAM_EXT_ELF_SO + ".";
  // GNU ld's SysV hash bucket counts (elflink.c elf_buckets): the last one not past the
  // symbol count
  ADAM_ELF_DYNAMIC_BUCKETS: array[0..15] of int64 = [1, 3, 17, 37, 67, 97, 131, 197, 263,
    521, 1031, 2053, 4099, 8209, 16411, 32771];
  // The first Vernaux index (0 local, 1 global are the gABI's)
  ADAM_ELF_DYNAMIC_FIRST_VERSION: int64 = 2;
  // .eh_frame: the extended length mark, a CIE's id; the DWARF pointer encodings (the
  // format's low nibble, the application's bits, omit)
  ADAM_ELF_DYNAMIC_EXTENDED: int64 = 0xFFFFFFFF;
  ADAM_ELF_DYNAMIC_PE_OMIT: int64 = 0xFF;
  ADAM_ELF_DYNAMIC_PE_ABSPTR: int64 = 0x00;
  ADAM_ELF_DYNAMIC_PE_UDATA2: int64 = 0x02;
  ADAM_ELF_DYNAMIC_PE_UDATA4: int64 = 0x03;
  ADAM_ELF_DYNAMIC_PE_UDATA8: int64 = 0x04;
  ADAM_ELF_DYNAMIC_PE_ULEB128: int64 = 0x01;
  ADAM_ELF_DYNAMIC_PE_SLEB128: int64 = 0x09;
  ADAM_ELF_DYNAMIC_PE_SDATA2: int64 = 0x0A;
  ADAM_ELF_DYNAMIC_PE_SDATA4: int64 = 0x0B;
  ADAM_ELF_DYNAMIC_PE_SDATA8: int64 = 0x0C;
  ADAM_ELF_DYNAMIC_PE_PCREL: int64 = 0x10;
  ADAM_ELF_DYNAMIC_PE_FORMAT: int64 = 0x0F;
  ADAM_ELF_DYNAMIC_PE_APPLY: int64 = 0x70;
  // .eh_frame_hdr's version and encodings: pcrel | sdata4, udata4, datarel | sdata4
  ADAM_ELF_DYNAMIC_HDR_VERSION: int64 = 1;
  ADAM_ELF_DYNAMIC_HDR_FRAME_ENC: int64 = 0x1B;
  ADAM_ELF_DYNAMIC_HDR_COUNT_ENC: int64 = 0x03;
  ADAM_ELF_DYNAMIC_HDR_TABLE_ENC: int64 = 0x3B;
  // A sort key's index bits (an FDE's place in the list below its location)
  ADAM_ELF_DYNAMIC_KEY_SHIFT: int64 = 24;
  ADAM_ELF_DYNAMIC_I32_HALF: int64 = 0x80000000;

// The ELF hash of AText (the gABI's: h = (h << 4) + c, the top nibble folded in)
public routine ElfHash(const AText: string): int64;
var
  LHash: int64;
  LTop: int64;
  LI: int64;
begin
  LHash := 0;
  for LI := 0 to len(AText) - 1 do
    LHash := (LHash shl 4) + int64(uint8(AText[LI]));
    LTop := LHash & 0xF0000000;
    if LTop <> 0 then
      LHash := LHash xor (LTop shr 24);
    end;
    // h &= ~g: the top nibble cleared, g being those bits
    LHash := LHash & 0x0FFFFFFF;
  end;
  return LHash;
end;

public type
  // A shared C runtime's version table (see the header)
  SharedTable = object
    hidden FIndex: ref StringIdMap;
    Names: StringArray;
    Versions: StringArray;
    Files: StringArray;
    IsData: BoolArray;
    BadLine: int64;

    init();
    begin
      self.FIndex := ref StringIdMap(0);
      setlength(self.Names, 0);
      setlength(self.Versions, 0);
      setlength(self.Files, 0);
      setlength(self.IsData, 0);
      self.BadLine := 0;
    end;

    // The table's text read in (see the header); false at a malformed line
    method Load(const AText: string): bool;
    var
      LLines: StringArray;
      LParts: StringArray;
      LLine: string;
      LCount: int64;
      LI: int64;
    begin
      LLines := SplitString(AText, "\n");
      setlength(self.Names, len(LLines));
      setlength(self.Versions, len(LLines));
      setlength(self.Files, len(LLines));
      setlength(self.IsData, len(LLines));
      LCount := 0;
      for LI := 0 to len(LLines) - 1 do
        LLine := Trim(LLines[LI]);
        if (LLine = "") or StartsStr(ADAM_ELF_DYNAMIC_COMMENT, LLine) then
          skip;
        end;
        LParts := SplitString(LLine, " ");
        if (len(LParts) <> 4) or (LParts[0] = "") or (LParts[1] = "") or (LParts[2] = "") or
          ((LParts[3] <> ADAM_ELF_DYNAMIC_ROUTINE) and (LParts[3] <> ADAM_ELF_DYNAMIC_DATA)) then
          self.BadLine := LI + 1;
          return false;
        end;
        self.Names[LCount] := LParts[0];
        self.Versions[LCount] := LParts[1];
        self.Files[LCount] := LParts[2];
        self.IsData[LCount] := LParts[3] = ADAM_ELF_DYNAMIC_DATA;
        self.FIndex.Put(LParts[0], LCount + 1);
        LCount := LCount + 1;
      end;
      setlength(self.Names, LCount);
      setlength(self.Versions, LCount);
      setlength(self.Files, LCount);
      setlength(self.IsData, LCount);
      return true;
    end;

    // AName's entry (-1 none)
    const method Find(const AName: string): int64;
    begin
      return self.FIndex.Find(AName) - 1;
    end;

    // True when some symbol's file is the shared library ALibrary names (lib<name>.so.<n>)
    const method HoldsLibrary(const ALibrary: string): bool;
    var
      LPrefix: string;
      LI: int64;
    begin
      LPrefix := ADAM_ELF_DYNAMIC_LIB_PREFIX + ALibrary + ADAM_ELF_DYNAMIC_SO_MARK;
      for LI := 0 to len(self.Files) - 1 do
        if StartsStr(LPrefix, self.Files[LI]) then
          return true;
        end;
      end;
      return false;
    end;
  end;

  // An exe's imports and the tables they make (see the header)
  DynamicImports = object
    Names: StringArray;
    Versions: StringArray;
    Files: StringArray;
    IsData: BoolArray;
    IsWeak: BoolArray;
    // Built: the tables, the needed files' .dynstr offsets, the Verneed count
    DynStr: ByteArray;
    DynSym: ByteArray;
    Hash: ByteArray;
    VerSym: ByteArray;
    VerNeed: ByteArray;
    Needed: Int64Array;
    NeededFiles: StringArray;
    NeedCount: int64;
    hidden FStrings: ref StringIdMap;

    init();
    begin
      setlength(self.Names, 0);
      setlength(self.Versions, 0);
      setlength(self.Files, 0);
      setlength(self.IsData, 0);
      setlength(self.IsWeak, 0);
      setlength(self.Needed, 0);
      setlength(self.NeededFiles, 0);
      self.NeedCount := 0;
      self.FStrings := ref StringIdMap(0);
    end;

    // The import count (.dynsym holds one more: the null symbol)
    const method Count(): int64;
    begin
      return len(self.Names);
    end;

    // One import added; its .dynsym index
    method Add(const AName: string; const AVersion: string; const AFile: string;
      const AIsData: bool; const AIsWeak: bool): int64;
    var
      LAt: int64;
    begin
      LAt := len(self.Names);
      setlength(self.Names, LAt + 1);
      setlength(self.Versions, LAt + 1);
      setlength(self.Files, LAt + 1);
      setlength(self.IsData, LAt + 1);
      setlength(self.IsWeak, LAt + 1);
      self.Names[LAt] := AName;
      self.Versions[LAt] := AVersion;
      self.Files[LAt] := AFile;
      self.IsData[LAt] := AIsData;
      self.IsWeak[LAt] := AIsWeak;
      return LAt + 1;
    end;

    // AText's offset in .dynstr (added the first time)
    hidden method DoString(const AText: string): int64;
    var
      LAt: int64;
      LI: int64;
    begin
      LAt := self.FStrings.Find(AText);
      if LAt <> 0 then
        return LAt - 1;
      end;
      LAt := len(self.DynStr);
      setlength(self.DynStr, LAt + len(AText) + 1);
      for LI := 0 to len(AText) - 1 do
        self.DynStr[LAt + LI] := uint8(AText[LI]);
      end;
      self.DynStr[LAt + len(AText)] := 0;
      self.FStrings.Put(AText, LAt + 1);
      return LAt;
    end;

    // The files in first-need order, and per file its versions in first-need order
    hidden method DoFiles(var AFiles: StringArray; var AVersions: array of StringArray);
    var
      LFileOf: ref StringIdMap;
      LSeen: ref StringIdMap;
      LFile: int64;
      LAt: int64;
      LI: int64;
    begin
      LFileOf := ref StringIdMap(0);
      LSeen := ref StringIdMap(0);
      setlength(AFiles, 0);
      setlength(AVersions, 0);
      for LI := 0 to len(self.Names) - 1 do
        LFile := LFileOf.Find(self.Files[LI]);
        if LFile = 0 then
          LFile := len(AFiles) + 1;
          setlength(AFiles, LFile);
          setlength(AVersions, LFile);
          AFiles[LFile - 1] := self.Files[LI];
          setlength(AVersions[LFile - 1], 0);
          LFileOf.Put(self.Files[LI], LFile);
        end;
        if LSeen.Find(self.Files[LI] + " " + self.Versions[LI]) = 0 then
          LSeen.Put(self.Files[LI] + " " + self.Versions[LI], 1);
          LAt := len(AVersions[LFile - 1]);
          setlength(AVersions[LFile - 1], LAt + 1);
          AVersions[LFile - 1][LAt] := self.Versions[LI];
        end;
      end;
    end;

    // The tables made (see the header)
    method Build();
    var
      LFiles: StringArray;
      LVersions: array of StringArray;
      LIndexOf: ref StringIdMap;
      LSymbols: int64;
      LBuckets: int64;
      LBucket: int64;
      LAt: int64;
      LNext: int64;
      LIndex: int64;
      LInfo: int64;
      LCount: int64;
      LF: int64;
      LV: int64;
      LI: int64;
    begin
      setlength(self.DynStr, 0);
      self.FStrings := ref StringIdMap(0);
      self.DoString("");
      self.DoFiles(LFiles, LVersions);
      setlength(self.Needed, len(LFiles));
      self.NeededFiles := LFiles;
      for LF := 0 to len(LFiles) - 1 do
        self.Needed[LF] := self.DoString(LFiles[LF]);
      end;
      LSymbols := len(self.Names) + 1;
      // .dynsym
      setlength(self.DynSym, LSymbols * ADAM_ELF_DYNAMIC_SYM);
      for LAt := 0 to len(self.DynSym) - 1 do
        self.DynSym[LAt] := 0;
      end;
      for LI := 0 to len(self.Names) - 1 do
        LAt := (LI + 1) * ADAM_ELF_DYNAMIC_SYM;
        LInfo := int64(STB_GLOBAL) shl 4;
        if self.IsWeak[LI] then
          LInfo := int64(STB_WEAK) shl 4;
        end;
        if self.IsData[LI] then
          LInfo := LInfo | int64(STT_OBJECT);
        else
          LInfo := LInfo | int64(STT_FUNC);
        end;
        PutLe(self.DynSym, LAt, uint64(self.DoString(self.Names[LI])), 4);
        self.DynSym[LAt + 4] := uint8(LInfo);
      end;
      // .gnu.version_r: one Verneed per file, its Vernaux per version (indexes from 2)
      LIndexOf := ref StringIdMap(0);
      LCount := 0;
      for LF := 0 to len(LFiles) - 1 do
        LCount := LCount + 1 + len(LVersions[LF]);
      end;
      setlength(self.VerNeed, LCount * ADAM_ELF_DYNAMIC_VERNEED);
      for LAt := 0 to len(self.VerNeed) - 1 do
        self.VerNeed[LAt] := 0;
      end;
      LAt := 0;
      LIndex := ADAM_ELF_DYNAMIC_FIRST_VERSION;
      for LF := 0 to len(LFiles) - 1 do
        LNext := ADAM_ELF_DYNAMIC_VERNEED + len(LVersions[LF]) * ADAM_ELF_DYNAMIC_VERNAUX;
        if LF = len(LFiles) - 1 then
          LNext := 0;
        end;
        PutLe(self.VerNeed, LAt, uint64(VER_NEED_CURRENT), 2);
        PutLe(self.VerNeed, LAt + 2, uint64(len(LVersions[LF])), 2);
        PutLe(self.VerNeed, LAt + 4, uint64(self.Needed[LF]), 4);
        PutLe(self.VerNeed, LAt + 8, uint64(ADAM_ELF_DYNAMIC_VERNEED), 4);
        PutLe(self.VerNeed, LAt + 12, uint64(LNext), 4);
        LAt := LAt + ADAM_ELF_DYNAMIC_VERNEED;
        for LV := 0 to len(LVersions[LF]) - 1 do
          LNext := ADAM_ELF_DYNAMIC_VERNAUX;
          if LV = len(LVersions[LF]) - 1 then
            LNext := 0;
          end;
          PutLe(self.VerNeed, LAt, uint64(ElfHash(LVersions[LF][LV])), 4);
          PutLe(self.VerNeed, LAt + 4, 0, 2);
          PutLe(self.VerNeed, LAt + 6, uint64(LIndex), 2);
          PutLe(self.VerNeed, LAt + 8, uint64(self.DoString(LVersions[LF][LV])), 4);
          PutLe(self.VerNeed, LAt + 12, uint64(LNext), 4);
          LIndexOf.Put(LFiles[LF] + " " + LVersions[LF][LV], LIndex);
          LIndex := LIndex + 1;
          LAt := LAt + ADAM_ELF_DYNAMIC_VERNAUX;
        end;
      end;
      self.NeedCount := len(LFiles);
      // .gnu.version
      setlength(self.VerSym, LSymbols * ADAM_ELF_DYNAMIC_VERSYM);
      PutLe(self.VerSym, 0, 0, 2);
      for LI := 0 to len(self.Names) - 1 do
        PutLe(self.VerSym, (LI + 1) * ADAM_ELF_DYNAMIC_VERSYM,
          uint64(LIndexOf.Find(self.Files[LI] + " " + self.Versions[LI])), 2);
      end;
      // .hash: nbucket, nchain, the buckets, the chains
      LBuckets := ADAM_ELF_DYNAMIC_BUCKETS[0];
      for LI := 0 to len(ADAM_ELF_DYNAMIC_BUCKETS) - 1 do
        LBuckets := ADAM_ELF_DYNAMIC_BUCKETS[LI];
        if (LI = len(ADAM_ELF_DYNAMIC_BUCKETS) - 1) or (LSymbols < ADAM_ELF_DYNAMIC_BUCKETS[LI + 1]) then
          leave;
        end;
      end;
      setlength(self.Hash, (2 + LBuckets + LSymbols) * ADAM_ELF_DYNAMIC_WORD);
      for LAt := 0 to len(self.Hash) - 1 do
        self.Hash[LAt] := 0;
      end;
      PutLe(self.Hash, 0, uint64(LBuckets), 4);
      PutLe(self.Hash, 4, uint64(LSymbols), 4);
      for LI := 1 to LSymbols - 1 do
        LBucket := (2 + ElfHash(self.Names[LI - 1]) mod LBuckets) * ADAM_ELF_DYNAMIC_WORD;
        // the symbol heads its bucket, the old head next in its chain
        PutLe(self.Hash, (2 + LBuckets + LI) * ADAM_ELF_DYNAMIC_WORD, GetLe(self.Hash, LBucket, 4), 4);
        PutLe(self.Hash, LBucket, uint64(LI), 4);
      end;
    end;
  end;

// The unsigned LEB128 at AAt of ABytes; AAt moved past it
routine DoUleb(const ABytes: ByteArray; var AAt: int64): int64;
var
  LValue: int64;
  LShift: int64;
  LByte: int64;
begin
  LValue := 0;
  LShift := 0;
  repeat
    LByte := int64(ABytes[AAt]);
    AAt := AAt + 1;
    if LShift < 63 then
      LValue := LValue | ((LByte & 0x7F) shl LShift);
    end;
    LShift := LShift + 7;
  until (LByte & 0x80) = 0;
  return LValue;
end;

// The bytes an encoded pointer of AEncoding's format takes (0 for a LEB128 or one not read)
routine DoEncodedSize(const AEncoding: int64): int64;
var
  LFormat: int64;
begin
  LFormat := AEncoding & ADAM_ELF_DYNAMIC_PE_FORMAT;
  if LFormat = ADAM_ELF_DYNAMIC_PE_ABSPTR then
    return 8;
  end;
  if (LFormat = ADAM_ELF_DYNAMIC_PE_UDATA2) or (LFormat = ADAM_ELF_DYNAMIC_PE_SDATA2) then
    return 2;
  end;
  if (LFormat = ADAM_ELF_DYNAMIC_PE_UDATA4) or (LFormat = ADAM_ELF_DYNAMIC_PE_SDATA4) then
    return 4;
  end;
  if (LFormat = ADAM_ELF_DYNAMIC_PE_UDATA8) or (LFormat = ADAM_ELF_DYNAMIC_PE_SDATA8) then
    return 8;
  end;
  return 0;
end;

// The pointer of AEncoding at AAt of ABytes (the field's address AAddress, for pcrel) into
// AValue; false for an encoding not read (see the header)
routine DoReadEncoded(const ABytes: ByteArray; const AAt: int64; const AAddress: int64;
  const AEncoding: int64; var AValue: int64): bool;
var
  LFormat: int64;
  LApply: int64;
  LSize: int64;
  LRaw: int64;
begin
  LFormat := AEncoding & ADAM_ELF_DYNAMIC_PE_FORMAT;
  LApply := AEncoding & ADAM_ELF_DYNAMIC_PE_APPLY;
  LSize := DoEncodedSize(AEncoding);
  if (LSize = 0) or ((LApply <> 0) and (LApply <> ADAM_ELF_DYNAMIC_PE_PCREL)) or
    ((AEncoding & 0x80) <> 0) or (AAt + LSize > len(ABytes)) then
    return false;
  end;
  LRaw := int64(GetLe(ABytes, AAt, LSize));
  // the signed formats widened from their size
  if (LFormat = ADAM_ELF_DYNAMIC_PE_SDATA2) and (LRaw >= 0x8000) then
    LRaw := LRaw - 0x10000;
  end;
  if (LFormat = ADAM_ELF_DYNAMIC_PE_SDATA4) and (LRaw >= ADAM_ELF_DYNAMIC_I32_HALF) then
    LRaw := LRaw - 2 * ADAM_ELF_DYNAMIC_I32_HALF;
  end;
  AValue := LRaw;
  if LApply = ADAM_ELF_DYNAMIC_PE_PCREL then
    AValue := AAddress + LRaw;
  end;
  return true;
end;

// One record of ABytes at AAt (ending at AEnd): its length field's size into AHead and its
// size past that into ASize; false past the end. A zero length (the list's end) gives 0
routine DoRecord(const ABytes: ByteArray; const AAt: int64; const AEnd: int64;
  var AHead: int64; var ASize: int64): bool;
begin
  if AAt + 4 > AEnd then
    return false;
  end;
  AHead := 4;
  ASize := int64(GetLe(ABytes, AAt, 4));
  if ASize = ADAM_ELF_DYNAMIC_EXTENDED then
    if AAt + 12 > AEnd then
      return false;
    end;
    AHead := 12;
    ASize := int64(GetLe(ABytes, AAt + 4, 8));
  end;
  return (ASize = 0) or ((ASize >= 4) and (AAt + AHead + ASize <= AEnd));
end;

// The FDE records in the .eh_frame bytes ABytes (see the header); -1 at one it cannot walk
public routine CountFrameRecords(const ABytes: ByteArray): int64;
var
  LAt: int64;
  LHead: int64;
  LSize: int64;
  LCount: int64;
begin
  LAt := 0;
  LCount := 0;
  while LAt < len(ABytes) do
    if not DoRecord(ABytes, LAt, len(ABytes), LHead, LSize) then
      return -1;
    end;
    if LSize = 0 then
      leave;
    end;
    if GetLe(ABytes, LAt + LHead, 4) <> uint64(0) then
      LCount := LCount + 1;
    end;
    LAt := LAt + LHead + LSize;
  end;
  return LCount;
end;

// The FDE pointer encoding of the CIE at AAt of ABytes (its record's id field at AId): its
// "z" augmentation's R, absptr with none; false for one it cannot read
routine DoCieEncoding(const ABytes: ByteArray; const AId: int64; const AEnd: int64;
  var AEncoding: int64): bool;
var
  LAt: int64;
  LVersion: int64;
  LAugment: int64;
  LLength: int64;
  LDataEnd: int64;
  LChar: uint8;
  LI: int64;
begin
  AEncoding := ADAM_ELF_DYNAMIC_PE_ABSPTR;
  LAt := AId + 4;
  LVersion := int64(ABytes[LAt]);
  LAt := LAt + 1;
  // the augmentation string's bytes: ABytes[LAugment .. LAugment + LLength)
  LAugment := LAt;
  while (LAt < AEnd) and (ABytes[LAt] <> 0) do
    LAt := LAt + 1;
  end;
  LLength := LAt - LAugment;
  LAt := LAt + 1;
  if (LLength = 0) or (LAt >= AEnd) then
    return LLength = 0;
  end;
  if ABytes[LAugment] <> uint8('z') then
    return false;
  end;
  // code alignment, data alignment (a LEB128 either sign: its bytes skipped alike), the
  // return address register (a byte in version 1)
  DoUleb(ABytes, LAt);
  DoUleb(ABytes, LAt);
  if LVersion = 1 then
    LAt := LAt + 1;
  else
    DoUleb(ABytes, LAt);
  end;
  LDataEnd := DoUleb(ABytes, LAt);
  LDataEnd := LAt + LDataEnd;
  if LDataEnd > AEnd then
    return false;
  end;
  for LI := 1 to LLength - 1 do
    LChar := ABytes[LAugment + LI];
    if LChar = uint8('R') then
      AEncoding := int64(ABytes[LAt]);
      return true;
    end;
    if LChar = uint8('L') then
      LAt := LAt + 1;
      skip;
    end;
    if LChar = uint8('P') then
      // its encoding, then the personality pointer in it
      if DoEncodedSize(int64(ABytes[LAt])) = 0 then
        return false;
      end;
      LAt := LAt + 1 + DoEncodedSize(int64(ABytes[LAt]));
      skip;
    end;
    if (LChar <> uint8('S')) and (LChar <> uint8('B')) then
      return false;
    end;
  end;
  return true;
end;

// .eh_frame_hdr for the .eh_frame whose bytes are ABytes[AAt .. AAt + ASize) at AAddress,
// the header at AHdrAddress (see the header) into AHdr; false at a record it cannot read
// (its offset from AAt in ABad)
public routine BuildFrameIndex(const ABytes: ByteArray; const AAt: int64; const ASize: int64;
  const AAddress: int64; const AHdrAddress: int64; var AHdr: ByteArray; var ABad: int64): bool;
var
  LCies: ref Int64Map;
  LKeys: Int64Array;
  LFdes: Int64Array;
  LLocs: Int64Array;
  LEnd: int64;
  LAt: int64;
  LHead: int64;
  LSize: int64;
  LId: int64;
  LCie: int64;
  LEncoding: int64;
  LLoc: int64;
  LCount: int64;
  LIndex: int64;
  LI: int64;
begin
  LCies := ref Int64Map(-1);
  LEnd := AAt + ASize;
  LAt := AAt;
  LCount := 0;
  setlength(LFdes, 0);
  setlength(LLocs, 0);
  ABad := 0;
  while LAt < LEnd do
    ABad := LAt - AAt;
    if not DoRecord(ABytes, LAt, LEnd, LHead, LSize) then
      return false;
    end;
    if LSize = 0 then
      leave;
    end;
    LId := LAt + LHead;
    if GetLe(ABytes, LId, 4) = uint64(0) then
      if not DoCieEncoding(ABytes, LId, LId + LSize, LEncoding) then
        return false;
      end;
      LCies.Put(LAt, LEncoding);
    else
      // the CIE pointer counts back from its own field
      LCie := LId - int64(GetLe(ABytes, LId, 4));
      LEncoding := LCies.Find(LCie);
      if (LEncoding < 0) or
        (not DoReadEncoded(ABytes, LId + 4, AAddress + (LId + 4 - AAt), LEncoding, LLoc)) then
        return false;
      end;
      setlength(LFdes, LCount + 1);
      setlength(LLocs, LCount + 1);
      LFdes[LCount] := AAddress + (LAt - AAt);
      LLocs[LCount] := LLoc;
      LCount := LCount + 1;
    end;
    LAt := LId + LSize;
  end;
  // sorted by location: each key the location less the header's (biased to be positive)
  // above the FDE's index
  setlength(LKeys, LCount);
  for LI := 0 to LCount - 1 do
    LKeys[LI] := ((LLocs[LI] - AHdrAddress + ADAM_ELF_DYNAMIC_I32_HALF) shl ADAM_ELF_DYNAMIC_KEY_SHIFT) | LI;
  end;
  SortInt64s(LKeys);
  setlength(AHdr, ADAM_ELF_DYNAMIC_HDR_HEAD + LCount * ADAM_ELF_DYNAMIC_HDR_ENTRY);
  AHdr[0] := uint8(ADAM_ELF_DYNAMIC_HDR_VERSION);
  AHdr[1] := uint8(ADAM_ELF_DYNAMIC_HDR_FRAME_ENC);
  AHdr[2] := uint8(ADAM_ELF_DYNAMIC_HDR_COUNT_ENC);
  AHdr[3] := uint8(ADAM_ELF_DYNAMIC_HDR_TABLE_ENC);
  PutLe(AHdr, 4, uint64(AAddress - (AHdrAddress + 4)), 4);
  PutLe(AHdr, 8, uint64(LCount), 4);
  for LI := 0 to LCount - 1 do
    LIndex := LKeys[LI] & ((1 shl ADAM_ELF_DYNAMIC_KEY_SHIFT) - 1);
    PutLe(AHdr, ADAM_ELF_DYNAMIC_HDR_HEAD + LI * ADAM_ELF_DYNAMIC_HDR_ENTRY,
      uint64(LLocs[LIndex] - AHdrAddress), 4);
    PutLe(AHdr, ADAM_ELF_DYNAMIC_HDR_HEAD + LI * ADAM_ELF_DYNAMIC_HDR_ENTRY + 4,
      uint64(LFdes[LIndex] - AHdrAddress), 4);
  end;
  return true;
end;

end.
