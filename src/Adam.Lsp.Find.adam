-------------------------------------------------------------------------------
  Adam.Lsp.Find.adam - what a place in a document names (M11b L3)

  FindAt reads the last check's tree (AA.2: nothing re-derived) for the
  name at a byte offset of the document the check had as its main module:
  a declaration's own name (it means itself), a use (a name, a member after
  '.' / '->', a named type, a record literal's field, a property
  accessor's field: its ResolvedDecl), an import or a dotted prefix naming
  a unit (ResolvedUnit: the unit's module), a module's own name. A use of
  a generic's instance means the instance's copy (its places are the
  template's). The word the cursor is in wins; the smallest one when names
  nest (a dotted type in a call), one that means something over one that
  means nothing. A cursor just after a word finds it too.

  DeclarationRange gives where a declaration's name is in its file's text
  (an LspDocument of that file): its name place, else (a unit read from an
  .acu keeps no name place) the name found from its first token on.
*******************************************************************************/

module unit Adam.Lsp.Find;

import System.SysUtils, Adam.Compiler.SourceText, Adam.Compiler.AST, Adam.Lsp.Document;

public type
  // What FindAt found: Found false for nothing; Use the node at the place, Decl the
  // declaration it means (a unit name: the unit's module; 0 when the check resolved
  // nothing), [WordStart, WordEnd) the name's bytes in the document
  LspTarget = record
    Found: bool;
    Use: int64;
    Decl: int64;
    WordStart: int64;
    WordEnd: int64;
  end;

// True for a byte of a name
routine DoIsNameByte(const AChar: char): bool;
begin
  return ((AChar >= 'A') and (AChar <= 'Z')) or ((AChar >= 'a') and (AChar <= 'z')) or
    ((AChar >= '0') and (AChar <= '9')) or (AChar = '_') or (int32(AChar) >= 0x80);
end;

// The length of the name at AOffset of AText (0: none there)
routine DoWordLength(const AText: string; const AOffset: int64): int64;
var
  LAt: int64;
begin
  LAt := AOffset;
  while (LAt >= 0) and (LAt < len(AText)) and DoIsNameByte(AText[LAt]) do
    LAt := LAt + 1;
  end;
  return LAt - AOffset;
end;

// The declaration a use of ADecl means: a generic instance's copy (role Instance), else ADecl
public routine MeantDeclaration(const ATree: ref SyntaxTree; const ADecl: int64): int64;
var
  LCopy: int64;
begin
  if (ADecl <> 0) and (ATree[ADecl].Kind = NodeKind.GenericInstance) then
    LCopy := ATree.FirstOf(ADecl, NodeRole.Instance);
    if LCopy <> 0 then
      return LCopy;
    end;
  end;
  return ADecl;
end;

type
  // One search (see the header)
  LspFinder = object
    hidden FDocument: ref LspDocument;
    hidden FTree: ref SyntaxTree;
    hidden FFile: string;
    hidden FOffset: int64;
    hidden FBest: LspTarget;

    init(const ADocument: ref LspDocument; const ATree: ref SyntaxTree; const AOffset: int64);
    begin
      self.FDocument := ADocument;
      self.FTree := ATree;
      self.FFile := "";
      self.FOffset := AOffset;
      self.FBest.Found := false;
      self.FBest.Use := 0;
      self.FBest.Decl := 0;
      self.FBest.WordStart := 0;
      self.FBest.WordEnd := 0;
    end;

    method Run(const AModule: int64): LspTarget;
    begin
      if (self.FTree <> nil) and (AModule <> 0) then
        self.FFile := self.FTree[AModule].Place.FileName;
        self.DoWalk(AModule);
      end;
      return self.FBest;
    end;

    // AId and every node below it looked at (a generic's instances and a write summary
    // repeat or have no places: not walked)
    hidden method DoWalk(const AId: int64);
    var
      LI: int64;
      LChild: int64;
      LRole: NodeRole;
    begin
      self.DoNode(AId);
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LChild := self.FTree.ChildAt(AId, LI);
        LRole := self.FTree.RoleOf(LChild);
        if (LRole <> NodeRole.Instance) and (LRole <> NodeRole.Effects) and
          (self.FTree[LChild].Kind <> NodeKind.GenericInstance) then
          self.DoWalk(LChild);
        end;
      end;
    end;

    // The name AId has at the place, if any
    hidden method DoNode(const AId: int64);
    var
      LNode: ref Node;
      LAt: int64;
    begin
      LNode := self.FTree[AId];
      match LNode.Kind of
        NodeKind.Module:
          self.DoName(AId, LNode.AtName(), len(LNode.Text), AId);
        NodeKind.Import:
          self.DoName(AId, LNode.Place, len(LNode.Text), LNode.ResolvedUnit);
        NodeKind.VarDecl, NodeKind.ConstDecl, NodeKind.TypeDecl, NodeKind.RoutineDecl,
        NodeKind.ForwardRoutine, NodeKind.ForwardType, NodeKind.Param, NodeKind.GenericParam,
        NodeKind.FieldDecl, NodeKind.EmbedDecl, NodeKind.MethodDecl, NodeKind.PropertyDecl,
        NodeKind.ChoiceValue:
          self.DoName(AId, LNode.AtName(), 0, AId);
        NodeKind.NamedType:
          self.DoName(AId, LNode.Place, len(LNode.Text), MeantDeclaration(self.FTree,
            LNode.ResolvedDecl));
        NodeKind.NameExpression, NodeKind.MemberExpression:
          if LNode.ResolvedUnit <> 0 then
            // A dotted prefix naming a unit: each name of its operand chain names it
            LAt := AId;
            while (LAt <> 0) and ((self.FTree[LAt].Kind = NodeKind.NameExpression) or
              (self.FTree[LAt].Kind = NodeKind.MemberExpression)) do
              self.DoName(LAt, self.FTree[LAt].AtName(), 0, LNode.ResolvedUnit);
              LAt := self.FTree.FirstOf(LAt, NodeRole.Operand);
            end;
          else
            self.DoName(AId, LNode.AtName(), 0, MeantDeclaration(self.FTree, LNode.ResolvedDecl));
          end;
        NodeKind.FieldInit:
          self.DoName(AId, LNode.AtName(), 0, MeantDeclaration(self.FTree, LNode.ResolvedDecl));
        NodeKind.PropertyRead, NodeKind.PropertyWrite:
          // Only an accessor naming a field has a name place (its first token is read / write)
          if not LNode.NamePlace.IsNone() then
            self.DoName(AId, LNode.NamePlace, 0, MeantDeclaration(self.FTree, LNode.ResolvedDecl));
          end;
      else
      end;
    end;

    // The name of AUse at APlace, ALength bytes (0: the word there), meaning ADecl: kept when
    // the offset is in it and it beats the best so far (see the header)
    hidden method DoName(const AUse: int64; const APlace: SourcePlace; const ALength: int64;
      const ADecl: int64);
    var
      LStart: int64;
      LLength: int64;
      LBestLength: int64;
      LInside: bool;
      LBestInside: bool;
    begin
      if APlace.IsNone() or (APlace.FileName <> self.FFile) then
        return;
      end;
      LStart := self.FDocument.OffsetOfPlace(int64(APlace.Line), int64(APlace.Column));
      LLength := ALength;
      if LLength <= 0 then
        LLength := DoWordLength(self.FDocument.Text, LStart);
      end;
      if (LLength <= 0) or (self.FOffset < LStart) or (self.FOffset > LStart + LLength) then
        return;
      end;
      LInside := self.FOffset < LStart + LLength;
      if self.FBest.Found then
        // A word the cursor is inside beats one it is just after; then the smaller; then
        // one that means something
        LBestInside := self.FOffset < self.FBest.WordEnd;
        if LBestInside and not LInside then
          return;
        end;
        if LInside = LBestInside then
          LBestLength := self.FBest.WordEnd - self.FBest.WordStart;
          if LLength > LBestLength then
            return;
          end;
          if (LLength = LBestLength) and ((ADecl = 0) or (self.FBest.Decl <> 0)) then
            return;
          end;
        end;
      end;
      self.FBest.Found := true;
      self.FBest.Use := AUse;
      self.FBest.Decl := ADecl;
      self.FBest.WordStart := LStart;
      self.FBest.WordEnd := LStart + LLength;
    end;
  end;

// The name at the byte AOffset of ADocument in the tree ATree, whose module AModule was read
// from ADocument's text (see the header)
public routine FindAt(const ADocument: ref LspDocument; const ATree: ref SyntaxTree;
  const AModule: int64; const AOffset: int64): LspTarget;
var
  LFinder: ref LspFinder;
begin
  LFinder := ref LspFinder(ADocument, ATree, AOffset);
  return LFinder.Run(AModule);
end;

// The last dotted part of AText (a name with no '.' itself)
routine DoLastPart(const AText: string): string;
var
  LAt: int64;
begin
  LAt := len(AText) - 1;
  while (LAt >= 0) and (AText[LAt] <> '.') do
    LAt := LAt - 1;
  end;
  return Substring(AText, LAt + 1, len(AText) - LAt - 1);
end;

// Where the declaration ADecl's name is in ADocument (the text of its file): [AStart, AEnd);
// false when ADecl has no place there
public routine DeclarationRange(const ATree: ref SyntaxTree; const ADecl: int64;
  const ADocument: ref LspDocument; var AStart: int64; var AEnd: int64): bool;
var
  LNode: ref Node;
  LPlace: SourcePlace;
  LName: string;
  LLimit: int64;
  LAt: int64;
begin
  AStart := 0;
  AEnd := 0;
  if (ADecl = 0) or (ADocument = nil) then
    return false;
  end;
  LNode := ATree[ADecl];
  LPlace := LNode.AtName();
  if LPlace.IsNone() then
    return false;
  end;
  AStart := ADocument.OffsetOfPlace(int64(LPlace.Line), int64(LPlace.Column));
  if LNode.Kind = NodeKind.Module then
    LName := LNode.Text;
  else
    LName := DoLastPart(LNode.Text);
  end;
  if LNode.NamePlace.IsNone() and (LName <> "") then
    // No name place (an .acu's node): the name from its first token on, within its bytes
    LLimit := AStart + (LNode.EndOffset - LNode.StartOffset);
    LAt := IndexOf(LName, ADocument.Text, AStart);
    while (LAt >= 0) and (LAt <= LLimit) do
      if ((LAt = 0) or not DoIsNameByte(ADocument.Text[LAt - 1])) and
        ((LAt + len(LName) >= len(ADocument.Text)) or
        not DoIsNameByte(ADocument.Text[LAt + len(LName)])) then
        AStart := LAt;
        leave;
      end;
      LAt := IndexOf(LName, ADocument.Text, LAt + 1);
    end;
  end;
  if (LName <> "") and (Substring(ADocument.Text, AStart, len(LName)) = LName) then
    AEnd := AStart + len(LName);
  else
    AEnd := AStart + DoWordLength(ADocument.Text, AStart);
  end;
  return true;
end;

end.
