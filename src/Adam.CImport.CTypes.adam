  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  Adam.CImport.CTypes.adam - `adam cimport`'s C type model (M9c; DESIGN
  sec 15): the types Adam.CImport.Parser reads, and their layout as the
  target lays them out

  CTypeKind     what a type is: one of C's fundamental types (clang's builtin
                __builtin_va_list among them, its shape the target's), a pointer, an
                array, a function, a struct / union (Record), an enum, or a
                typedef's name (Named, which keeps the name the header wrote)
  CType         one type: its kind, its qualifiers, what it is built on
                (Base: a pointer's target, an array's element, a function's
                result, a typedef's type), an array's Count (-1: no size),
                a record's / enum's / typedef's Index, a function's Params
  CRecord       a struct or union: its tag ("" for none), its fields, its
                layout once complete; Complete false for one only declared
                (struct foo;)
  CEnum         an enum: its tag, its constants and their values, the
                integer type that holds them (C's rule as clang applies it on
                a GNU target: int when every value fits, unsigned int when
                every one is >= 0 and fits, else long long / unsigned)
  CTypeTable    every type of one import, appended (no interning: a type is
                its index), with SizeOf / AlignOf / LayoutRecord asking the
                target part for every fact (AT.2): a fundamental type is the
                Adam builtin it is (BuiltinName) and the target sizes that
                builtin; C's long is clong, so the data model is the target's

  A type with no size here (void, a function, an incomplete record, an
  array with no size, long double, __int128, _Complex: facts no target
  method gives yet) has SizeOf -1; the binding writer reports what it
  cannot bind by name (CI), never drops it silently. Records are laid out
  naturally (each field at its alignment, the size rounded up to the
  largest); a record with a bitfield or a flexible array member is marked
  and left unlaid (Laid false), its layout is M9e's.
*******************************************************************************/

module unit Adam.CImport.CTypes;

import System.SysUtils, Adam.Target;

public const
  // A growable list's first storage, doubled each time it is full
  ADAM_CIMPORT_CTYPES_FIRST: int64 = 64;
  // No index: a type with no base, a record's or enum's slot not set
  ADAM_CIMPORT_NONE: int64 = -1;

public type
  // What a type is (see the header)
  CTypeKind = choices(Void, Bool, Char, SChar, UChar, Short, UShort, Int, UInt, Long, ULong,
    LongLong, ULongLong, Int128, UInt128, Float, Double, LongDouble, Complex, VaList, Pointer, Array,
    Function, Record, Enum, Named);

  // One parameter of a function type; Name "" when the header gives none
  CParam = record
    Name: string;
    TypeId: int64;
  end;

  CParamArray = array of CParam;

  // One type (see the header)
  CType = record
    Kind: CTypeKind;
    IsConst: bool;
    IsVolatile: bool;
    IsAtomic: bool;
    Base: int64;
    Count: int64;
    Index: int64;
    Params: CParamArray;
    Variadic: bool;
    // f() in C before C23: the parameters are not given
    NoPrototype: bool;
  end;

  CTypeArray = array of CType;

  // One field of a record: Name "" for an anonymous member; BitWidth -1 when it is no
  // bitfield; Offset in bytes once the record is laid out; where the header declares it
  CField = record
    Name: string;
    TypeId: int64;
    BitWidth: int64;
    Offset: int64;
    File: int32;
    Line: int32;
    Column: int32;
  end;

  CFieldArray = array of CField;

  // A struct or union (see the header)
  CRecord = record
    Tag: string;
    IsUnion: bool;
    Complete: bool;
    Fields: CFieldArray;
    Laid: bool;
    HasBitfields: bool;
    HasFlexible: bool;
    Size: int64;
    Alignment: int64;
    File: int32;
    Line: int32;
    Column: int32;
  end;

  CRecordArray = array of CRecord;

  // An enum (see the header); Underlying is the fundamental kind that holds its values
  CEnum = record
    Tag: string;
    Complete: bool;
    Names: StringArray;
    Values: Int64Array;
    Underlying: CTypeKind;
    File: int32;
    Line: int32;
    Column: int32;
  end;

  CEnumArray = array of CEnum;

// The Adam builtin a fundamental kind is (BNF sec 4): C's long is clong (its size the target's
// data model), plain char char (its signedness the target's); "" for a kind no builtin is
public routine BuiltinName(const AKind: CTypeKind): string;
begin
  match AKind of
    CTypeKind.Bool: return "bool";
    CTypeKind.Char: return "char";
    CTypeKind.SChar: return "int8";
    CTypeKind.UChar: return "uint8";
    CTypeKind.Short: return "int16";
    CTypeKind.UShort: return "uint16";
    CTypeKind.Int: return "int32";
    CTypeKind.UInt: return "uint32";
    CTypeKind.Long: return "clong";
    CTypeKind.ULong: return "culong";
    CTypeKind.LongLong: return "int64";
    CTypeKind.ULongLong: return "uint64";
    CTypeKind.Float: return "float32";
    CTypeKind.Double: return "float64";
  else
  end;
  return "";
end;

// C's own spelling of a fundamental kind (a report names the type as the header writes it)
public routine CKindText(const AKind: CTypeKind): string;
begin
  match AKind of
    CTypeKind.Void: return "void";
    CTypeKind.Bool: return "_Bool";
    CTypeKind.Char: return "char";
    CTypeKind.SChar: return "signed char";
    CTypeKind.UChar: return "unsigned char";
    CTypeKind.Short: return "short";
    CTypeKind.UShort: return "unsigned short";
    CTypeKind.Int: return "int";
    CTypeKind.UInt: return "unsigned int";
    CTypeKind.Long: return "long";
    CTypeKind.ULong: return "unsigned long";
    CTypeKind.LongLong: return "long long";
    CTypeKind.ULongLong: return "unsigned long long";
    CTypeKind.Int128: return "__int128";
    CTypeKind.UInt128: return "unsigned __int128";
    CTypeKind.Float: return "float";
    CTypeKind.Double: return "double";
    CTypeKind.LongDouble: return "long double";
    CTypeKind.Complex: return "_Complex";
    CTypeKind.VaList: return "__builtin_va_list";
  else
  end;
  return "";
end;

// True when AKind is one of C's integer kinds (an enum's values and a bitfield's type)
public routine IsIntegerKind(const AKind: CTypeKind): bool;
begin
  return (AKind >= CTypeKind.Bool) and (AKind <= CTypeKind.UInt128);
end;

public type
  // Every type of one import (see the header)
  CTypeTable = object
    hidden FTarget: ref Target;
    hidden FTypes: CTypeArray;
    hidden FTypeCount: int64;
    hidden FRecords: CRecordArray;
    hidden FRecordCount: int64;
    hidden FEnums: CEnumArray;
    hidden FEnumCount: int64;

    init(const ATarget: ref Target);
    begin
      self.FTarget := ATarget;
      self.FTypeCount := 0;
      self.FRecordCount := 0;
      self.FEnumCount := 0;
    end;

    property TypeCount: int64 read FTypeCount;

    // The target the types are laid out for
    const method TargetOf(): ref Target;
    begin
      return self.FTarget;
    end;
    property RecordCount: int64 read FRecordCount;
    property EnumCount: int64 read FEnumCount;

    // A new type of AKind on ABase (ADAM_CIMPORT_NONE for none), unqualified; its index
    method Add(const AKind: CTypeKind; const ABase: int64): int64;
    var
      LType: CType;
    begin
      if self.FTypeCount = len(self.FTypes) then
        if self.FTypeCount = 0 then
          setlength(self.FTypes, ADAM_CIMPORT_CTYPES_FIRST);
        else
          setlength(self.FTypes, self.FTypeCount * 2);
        end;
      end;
      LType.Kind := AKind;
      LType.IsConst := false;
      LType.IsVolatile := false;
      LType.IsAtomic := false;
      LType.Base := ABase;
      LType.Count := ADAM_CIMPORT_NONE;
      LType.Index := ADAM_CIMPORT_NONE;
      LType.Variadic := false;
      LType.NoPrototype := false;
      self.FTypes[self.FTypeCount] := LType;
      self.FTypeCount := self.FTypeCount + 1;
      return self.FTypeCount - 1;
    end;

    // A copy of the type AId with the qualifiers added; AId itself when none is new
    method Qualified(const AId: int64; const AConst: bool; const AVolatile: bool;
      const AAtomic: bool): int64;
    var
      LType: CType;
      LId: int64;
    begin
      LType := self.FTypes[AId];
      if (LType.IsConst or not AConst) and (LType.IsVolatile or not AVolatile) and
        (LType.IsAtomic or not AAtomic) then
        return AId;
      end;
      LId := self.Add(LType.Kind, LType.Base);
      LType.IsConst := LType.IsConst or AConst;
      LType.IsVolatile := LType.IsVolatile or AVolatile;
      LType.IsAtomic := LType.IsAtomic or AAtomic;
      self.FTypes[LId] := LType;
      return LId;
    end;

    // The type AId
    const method Item(const AId: int64): CType;
    begin
      return self.FTypes[AId];
    end;

    // AType in place of the type AId (a function's parameters, an array's count)
    method Put(const AId: int64; const AType: CType);
    begin
      self.FTypes[AId] := AType;
    end;

    // A new record (struct or union), incomplete, with no fields; its index
    method AddRecord(const ATag: string; const AUnion: bool; const AFile: int32;
      const ALine: int32; const AColumn: int32): int64;
    var
      LRecord: CRecord;
    begin
      if self.FRecordCount = len(self.FRecords) then
        if self.FRecordCount = 0 then
          setlength(self.FRecords, ADAM_CIMPORT_CTYPES_FIRST);
        else
          setlength(self.FRecords, self.FRecordCount * 2);
        end;
      end;
      LRecord.Tag := ATag;
      LRecord.IsUnion := AUnion;
      LRecord.Complete := false;
      LRecord.Laid := false;
      LRecord.HasBitfields := false;
      LRecord.HasFlexible := false;
      LRecord.Size := -1;
      LRecord.Alignment := -1;
      LRecord.File := AFile;
      LRecord.Line := ALine;
      LRecord.Column := AColumn;
      self.FRecords[self.FRecordCount] := LRecord;
      self.FRecordCount := self.FRecordCount + 1;
      return self.FRecordCount - 1;
    end;

    // The record AIndex
    const method RecordAt(const AIndex: int64): CRecord;
    begin
      return self.FRecords[AIndex];
    end;

    // ARecord in place of the record AIndex
    method PutRecord(const AIndex: int64; const ARecord: CRecord);
    begin
      self.FRecords[AIndex] := ARecord;
    end;

    // A new enum, incomplete, with no constants; its index
    method AddEnum(const ATag: string; const AFile: int32; const ALine: int32;
      const AColumn: int32): int64;
    var
      LEnum: CEnum;
    begin
      if self.FEnumCount = len(self.FEnums) then
        if self.FEnumCount = 0 then
          setlength(self.FEnums, ADAM_CIMPORT_CTYPES_FIRST);
        else
          setlength(self.FEnums, self.FEnumCount * 2);
        end;
      end;
      LEnum.Tag := ATag;
      LEnum.Complete := false;
      LEnum.Underlying := CTypeKind.Int;
      LEnum.File := AFile;
      LEnum.Line := ALine;
      LEnum.Column := AColumn;
      self.FEnums[self.FEnumCount] := LEnum;
      self.FEnumCount := self.FEnumCount + 1;
      return self.FEnumCount - 1;
    end;

    // The enum AIndex
    const method EnumAt(const AIndex: int64): CEnum;
    begin
      return self.FEnums[AIndex];
    end;

    // AEnum in place of the enum AIndex
    method PutEnum(const AIndex: int64; const AEnum: CEnum);
    begin
      self.FEnums[AIndex] := AEnum;
    end;

    // The type AId with every typedef name looked through (a Named type's own type, its
    // qualifiers kept on the result's report only)
    const method Resolved(const AId: int64): int64;
    var
      LId: int64;
    begin
      LId := AId;
      while self.FTypes[LId].Kind = CTypeKind.Named do
        LId := self.FTypes[LId].Base;
      end;
      return LId;
    end;

    // The size in bytes of the type AId as the target lays it out; -1 when it has none
    // (see the header)
    method SizeOf(const AId: int64): int64;
    var
      LType: CType;
      LElement: int64;
      LRecord: CRecord;
    begin
      LType := self.FTypes[self.Resolved(AId)];
      match LType.Kind of
        CTypeKind.Pointer: return self.FTarget.PointerSize();
        CTypeKind.VaList:
          if self.FTarget.VaListIsPointer() then
            return self.FTarget.PointerSize();
          end;
          return -1;
        CTypeKind.Array:
          if LType.Count < 0 then
            return -1;
          end;
          LElement := self.SizeOf(LType.Base);
          if LElement < 0 then
            return -1;
          end;
          return LElement * LType.Count;
        CTypeKind.Record:
          self.LayoutRecord(LType.Index);
          LRecord := self.FRecords[LType.Index];
          if not LRecord.Laid then
            return -1;
          end;
          return LRecord.Size;
        CTypeKind.Enum:
          return self.FTarget.BuiltinSize(BuiltinName(self.FEnums[LType.Index].Underlying));
      else
      end;
      if BuiltinName(LType.Kind) = "" then
        return -1;
      end;
      return self.FTarget.BuiltinSize(BuiltinName(LType.Kind));
    end;

    // The alignment in bytes of the type AId; -1 when it has no size
    method AlignOf(const AId: int64): int64;
    var
      LType: CType;
      LRecord: CRecord;
    begin
      LType := self.FTypes[self.Resolved(AId)];
      match LType.Kind of
        CTypeKind.Pointer: return self.FTarget.PointerAlign();
        CTypeKind.VaList:
          if self.FTarget.VaListIsPointer() then
            return self.FTarget.PointerAlign();
          end;
          return -1;
        CTypeKind.Array: return self.AlignOf(LType.Base);
        CTypeKind.Record:
          self.LayoutRecord(LType.Index);
          LRecord := self.FRecords[LType.Index];
          if not LRecord.Laid then
            return -1;
          end;
          return LRecord.Alignment;
        CTypeKind.Enum:
          return self.FTarget.BuiltinAlign(BuiltinName(self.FEnums[LType.Index].Underlying));
      else
      end;
      if BuiltinName(LType.Kind) = "" then
        return -1;
      end;
      return self.FTarget.BuiltinAlign(BuiltinName(LType.Kind));
    end;

    // The record AIndex laid out (see the header), once: each field at its alignment (a
    // union's at 0), the size the end rounded up to the largest alignment. Left unlaid when it
    // is incomplete, has a bitfield or a flexible array member, or a field has no size
    method LayoutRecord(const AIndex: int64);
    var
      LRecord: CRecord;
      LOffset: int64;
      LSize: int64;
      LAlign: int64;
      LFieldSize: int64;
      LFieldAlign: int64;
      LI: int64;
    begin
      LRecord := self.FRecords[AIndex];
      if LRecord.Laid or not LRecord.Complete or LRecord.HasBitfields or LRecord.HasFlexible then
        return;
      end;
      LOffset := 0;
      LSize := 0;
      LAlign := 1;
      for LI := 0 to len(LRecord.Fields) - 1 do
        LFieldSize := self.SizeOf(LRecord.Fields[LI].TypeId);
        LFieldAlign := self.AlignOf(LRecord.Fields[LI].TypeId);
        if (LFieldSize < 0) or (LFieldAlign <= 0) then
          return;
        end;
        if LFieldAlign > LAlign then
          LAlign := LFieldAlign;
        end;
        if LRecord.IsUnion then
          LRecord.Fields[LI].Offset := 0;
          if LFieldSize > LSize then
            LSize := LFieldSize;
          end;
        else
          LOffset := AlignUp(LOffset, LFieldAlign);
          LRecord.Fields[LI].Offset := LOffset;
          LOffset := LOffset + LFieldSize;
          LSize := LOffset;
        end;
      end;
      LRecord.Size := AlignUp(LSize, LAlign);
      LRecord.Alignment := LAlign;
      LRecord.Laid := true;
      self.FRecords[AIndex] := LRecord;
    end;

    // The enum AIndex's underlying kind set from its values (see the header)
    method SetEnumUnderlying(const AIndex: int64);
    var
      LEnum: CEnum;
      LNegative: bool;
      LFitsInt: bool;
      LFitsUInt: bool;
      LI: int64;
    begin
      LEnum := self.FEnums[AIndex];
      LNegative := false;
      LFitsInt := true;
      LFitsUInt := true;
      for LI := 0 to len(LEnum.Values) - 1 do
        if LEnum.Values[LI] < 0 then
          LNegative := true;
        end;
        if (LEnum.Values[LI] < -2147483648) or (LEnum.Values[LI] > 2147483647) then
          LFitsInt := false;
        end;
        if (LEnum.Values[LI] < 0) or (LEnum.Values[LI] > 4294967295) then
          LFitsUInt := false;
        end;
      end;
      LEnum.Underlying := CTypeKind.ULongLong;
      if LNegative then
        LEnum.Underlying := CTypeKind.LongLong;
      end;
      if LFitsUInt then
        LEnum.Underlying := CTypeKind.UInt;
      end;
      if LFitsInt then
        LEnum.Underlying := CTypeKind.Int;
      end;
      self.FEnums[AIndex] := LEnum;
    end;
  end;

end.
