-------------------------------------------------------------------------------
  Adam.Elf.Reader.adam - an ELF64 object read: its sections, relocations and
  symbols (DESIGN sec 7: a unit's compiled object, and the foreign objects
  a static library's members are; PLAN-LINUX64 LX2b)

  Every layout fact is the System V gABI's (ELF header, section header,
  symbol table, relocation entries, section groups, extended section
  numbering) with elf.h's names and values (std System.Elf); the record
  sizes are Adam.Elf.Writer's.

  ReadElfObject  the bytes of one object, a slice of a larger buffer (an
                 archive member's data) -> its e_type, e_machine and
                 e_flags; its sections in section index order (index 0 the
                 null section): the name (from the section name table), the
                 type, flags, address, the data's place in the buffer and
                 its size (an SHT_NOBITS section's size, with no place),
                 link, info, alignment, entry size, its relocations (every
                 SHT_RELA section that names it in sh_info; an allocated one,
                 SHF_ALLOC, is an image's loader relocations against its
                 .dynsym, the gABI's sh_info 0, and patches no section: read
                 as data alone, LX3b), and the group
                 (an SHT_GROUP section's index) it is a member of; a group
                 section's flags word; its relocations (the section they
                 patch, offset, symbol index, type, addend); its symbol
                 table (SHT_SYMTAB), one entry per record: name, value,
                 size, binding, type, visibility, the section index (an
                 SHN_XINDEX one read from SHT_SYMTAB_SHNDX; SHN_ABS /
                 SHN_COMMON kept as they are), and the index of its first
                 non-local symbol (the table's sh_info). Extended numbering
                 is read: e_shnum 0 takes the count from section 0's
                 sh_size, e_shstrndx SHN_XINDEX the index from its sh_link.

  Nothing raises but a slice outside the buffer (a caller's bug): bytes that
  are no ELF64 little-endian object, a header or table past the object's
  end, a section header size that is not 64, a section name or symbol name
  the string table does not hold, a section whose data runs past the end,
  a symbol table or relocation section whose entries are not 24 bytes, a
  link or info naming a section the object lacks, two symbol tables, two
  relocation sections for one section, a relocation to a symbol past the
  table, a symbol in a section the object lacks, or a group naming one are
  reported (EO0001) at the place the caller gives, under the label it names
  the object by, and false is returned. What the object holds is the
  linker's to judge: its type, its machine, the relocation types and the
  symbol forms it links.
*******************************************************************************/

module unit Adam.Elf.Reader;

import System.SysUtils, Adam.Core.Messages, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics,
  Adam.Elf.Writer, System.Elf;

public const
  // Reported (see the header)
  ADAM_ERR_ELF_READER_001: string = "EO0001";   // a damaged object
  // Raised (see the header)
  ADAM_ELF_READER_FAULT_SLICE: string = "ELF reader: a slice outside its buffer: ";
  // The ELF header's fields read (Elf64_Ehdr)
  ADAM_ELF_READER_TYPE_AT: int64 = 16;
  ADAM_ELF_READER_MACHINE_AT: int64 = 18;
  ADAM_ELF_READER_SHOFF_AT: int64 = 40;
  ADAM_ELF_READER_FLAGS_AT: int64 = 48;
  ADAM_ELF_READER_SHENTSIZE_AT: int64 = 58;
  ADAM_ELF_READER_SHNUM_AT: int64 = 60;
  ADAM_ELF_READER_SHSTRNDX_AT: int64 = 62;
  // A section header's fields (Elf64_Shdr)
  ADAM_ELF_READER_SH_TYPE_AT: int64 = 4;
  ADAM_ELF_READER_SH_FLAGS_AT: int64 = 8;
  ADAM_ELF_READER_SH_ADDR_AT: int64 = 16;
  ADAM_ELF_READER_SH_OFFSET_AT: int64 = 24;
  ADAM_ELF_READER_SH_SIZE_AT: int64 = 32;
  ADAM_ELF_READER_SH_LINK_AT: int64 = 40;
  ADAM_ELF_READER_SH_INFO_AT: int64 = 44;
  ADAM_ELF_READER_SH_ALIGN_AT: int64 = 48;
  ADAM_ELF_READER_SH_ENTSIZE_AT: int64 = 56;
  // A symbol's fields (Elf64_Sym)
  ADAM_ELF_READER_ST_INFO_AT: int64 = 4;
  ADAM_ELF_READER_ST_OTHER_AT: int64 = 5;
  ADAM_ELF_READER_ST_SHNDX_AT: int64 = 6;
  ADAM_ELF_READER_ST_VALUE_AT: int64 = 8;
  ADAM_ELF_READER_ST_SIZE_AT: int64 = 16;
  // A relocation's fields (Elf64_Rela): r_info, r_addend
  ADAM_ELF_READER_R_INFO_AT: int64 = 8;
  ADAM_ELF_READER_R_ADDEND_AT: int64 = 16;

public type
  // One section (see the header); its index is its place in the object's Sections
  ElfSection = record
    SectionName: string;
    SectionType: int64;
    Flags: int64;
    Address: int64;
    // The data's offset in the buffer (0: none, SHT_NOBITS or empty) and sh_size
    DataAt: int64;
    DataSize: int64;
    Link: int64;
    Info: int64;
    Align: int64;
    EntrySize: int64;
    // Its relocations: the first one's index in the object's Relocs, and how many
    RelocFirst: int64;
    RelocCount: int64;
    // The SHT_GROUP section it is a member of (0: none); a group section's flags word
    Group: int64;
    GroupFlags: int64;
  end;

  ElfSectionArray = array of ElfSection;

  // One relocation (see the header): the section it patches, r_offset, the symbol index
  // and type of r_info, r_addend
  ElfReloc = record
    Section: int64;
    Offset: int64;
    SymbolIndex: int64;
    RelocType: int64;
    Addend: int64;
  end;

  ElfRelocArray = array of ElfReloc;

  // One symbol table record (see the header); Bind / SymbolType st_info's halves,
  // Visibility st_other's low 2 bits
  ElfSymbol = record
    SymbolName: string;
    SymbolValue: int64;
    SymbolSize: int64;
    Bind: int64;
    SymbolType: int64;
    Visibility: int64;
    SectionIndex: int64;
  end;

  ElfSymbolArray = array of ElfSymbol;

  // One object read (see the header)
  ElfObjectData = record
    FileType: int64;
    Machine: int64;
    Flags: int64;
    Sections: ElfSectionArray;
    Relocs: ElfRelocArray;
    Symbols: ElfSymbolArray;
    FirstGlobal: int64;
  end;

type
  // Where one object is in the buffer while it is read, and how a report names it
  ReadContext = object
    Start: int64;
    Size: int64;
    ObjectLabel: string;
    Place: SourcePlace;

    init(const AStart: int64; const ASize: int64; const AObjectLabel: string;
      const APlace: SourcePlace);
    begin
      self.Start := AStart;
      self.Size := ASize;
      self.ObjectLabel := AObjectLabel;
      self.Place := APlace;
    end;
  end;

// The ACount-byte little-endian value at AAt in ABytes
routine DoGet(const ABytes: ByteArray; const AAt: int64; const ACount: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, ACount));
end;

// True when the ACount bytes at AAt (an offset from the object's start) lie inside it
routine DoFits(const AContext: ref ReadContext; const AAt: int64; const ACount: int64): bool;
begin
  if (ACount < 0) or (AAt < 0) or (AAt > AContext.Size) then
    return false;
  end;
  return ACount <= AContext.Size - AAt;
end;

// Reports the object damaged for AReason (EO0001): false
routine DoDamaged(const AContext: ref ReadContext; const ADiagnostics: ref Diagnostics;
  const AReason: string): bool;
begin
  ADiagnostics.Add(Severity.Error, ADAM_ERR_ELF_READER_001, AContext.Place,
    ADAM_MSG_ELF_READER_DAMAGED, NoArgs().Str(AContext.ObjectLabel).Str(AReason));
  return false;
end;

// The NUL-ended name at AOffset in the string table section ATable into AText (one block
// copy): false when the offset or the name's end lies outside the table
routine DoTableName(const ABytes: ByteArray; const AObject: ElfObjectData; const ATable: int64;
  const AOffset: int64; var AText: string): bool;
var
  LAt: int64;
  LEnd: int64;
  LNul: int64;
begin
  AText := "";
  if (AOffset < 0) or (AOffset >= AObject.Sections[ATable].DataSize) then
    return false;
  end;
  LAt := AObject.Sections[ATable].DataAt + AOffset;
  LEnd := AObject.Sections[ATable].DataAt + AObject.Sections[ATable].DataSize;
  LNul := LAt;
  while (LNul < LEnd) and (ABytes[LNul] <> 0) do
    LNul := LNul + 1;
  end;
  if LNul >= LEnd then
    return false;
  end;
  if LNul > LAt then
    AText := StringFromC(ptr to const char(addr of ABytes[LAt]), LNul - LAt);
  end;
  return true;
end;

// True when AIndex names a section of AObject past the null section
routine DoIsSection(const AObject: ElfObjectData; const AIndex: int64): bool;
begin
  return (AIndex > 0) and (AIndex < len(AObject.Sections));
end;

// The ELF header (e_ident checked; e_type, e_machine, e_flags into AObject) and the section
// header table: every section header read (no names yet) into AObject.Sections; the section
// name table's index into ANames. False after a report
routine DoReadHeaders(const ABytes: ByteArray; const AContext: ref ReadContext;
  const ADiagnostics: ref Diagnostics; var AObject: ElfObjectData; var ANames: int64): bool;
var
  LBase: int64;
  LTable: int64;
  LCount: int64;
  LAt: int64;
  LI: int64;
  LSection: ElfSection;
begin
  LBase := AContext.Start;
  if not DoFits(AContext, 0, ADAM_ELF_HEADER_SIZE) then
    if (AContext.Size >= 4) and (ABytes[LBase] = ELFMAG0) and (ABytes[LBase + 1] = ELFMAG1) and
      (ABytes[LBase + 2] = ELFMAG2) and (ABytes[LBase + 3] = ELFMAG3) then
      return DoDamaged(AContext, ADiagnostics, ADAM_MSG_ELF_READER_REASON_HEADER);
    end;
    return DoDamaged(AContext, ADiagnostics, ADAM_MSG_ELF_READER_REASON_NOT_ELF);
  end;
  if (ABytes[LBase] <> ELFMAG0) or (ABytes[LBase + 1] <> ELFMAG1) or
    (ABytes[LBase + 2] <> ELFMAG2) or (ABytes[LBase + 3] <> ELFMAG3) or
    (ABytes[LBase + EI_CLASS] <> ELFCLASS64) or (ABytes[LBase + EI_DATA] <> ELFDATA2LSB) or
    (int64(ABytes[LBase + EI_VERSION]) <> int64(EV_CURRENT)) then
    return DoDamaged(AContext, ADiagnostics, ADAM_MSG_ELF_READER_REASON_NOT_ELF);
  end;
  AObject.FileType := DoGet(ABytes, LBase + ADAM_ELF_READER_TYPE_AT, 2);
  AObject.Machine := DoGet(ABytes, LBase + ADAM_ELF_READER_MACHINE_AT, 2);
  AObject.Flags := DoGet(ABytes, LBase + ADAM_ELF_READER_FLAGS_AT, 4);
  LTable := DoGet(ABytes, LBase + ADAM_ELF_READER_SHOFF_AT, 8);
  LCount := DoGet(ABytes, LBase + ADAM_ELF_READER_SHNUM_AT, 2);
  ANames := DoGet(ABytes, LBase + ADAM_ELF_READER_SHSTRNDX_AT, 2);
  if LTable = 0 then
    // No section header table: nothing to read
    setlength(AObject.Sections, 0);
    ANames := 0;
    return true;
  end;
  if DoGet(ABytes, LBase + ADAM_ELF_READER_SHENTSIZE_AT, 2) <> ADAM_ELF_SECTION_HEADER_SIZE then
    return DoDamaged(AContext, ADiagnostics, ADAM_MSG_ELF_READER_REASON_ENTRY_SIZE);
  end;
  if not DoFits(AContext, LTable, ADAM_ELF_SECTION_HEADER_SIZE) then
    return DoDamaged(AContext, ADiagnostics, ADAM_MSG_ELF_READER_REASON_SECTIONS);
  end;
  // Extended numbering: the count in section 0's sh_size, the name table's index in its
  // sh_link
  if LCount = 0 then
    LCount := DoGet(ABytes, LBase + LTable + ADAM_ELF_READER_SH_SIZE_AT, 8);
  end;
  if ANames = int64(SHN_XINDEX) then
    ANames := DoGet(ABytes, LBase + LTable + ADAM_ELF_READER_SH_LINK_AT, 4);
  end;
  if (LCount < 0) or (LCount > (AContext.Size - LTable) div ADAM_ELF_SECTION_HEADER_SIZE) then
    return DoDamaged(AContext, ADiagnostics, ADAM_MSG_ELF_READER_REASON_SECTIONS);
  end;
  setlength(AObject.Sections, LCount);
  for LI := 0 to LCount - 1 do
    LAt := LBase + LTable + LI * ADAM_ELF_SECTION_HEADER_SIZE;
    LSection.SectionName := "";
    LSection.SectionType := DoGet(ABytes, LAt + ADAM_ELF_READER_SH_TYPE_AT, 4);
    LSection.Flags := DoGet(ABytes, LAt + ADAM_ELF_READER_SH_FLAGS_AT, 8);
    LSection.Address := DoGet(ABytes, LAt + ADAM_ELF_READER_SH_ADDR_AT, 8);
    LSection.DataAt := DoGet(ABytes, LAt + ADAM_ELF_READER_SH_OFFSET_AT, 8);
    LSection.DataSize := DoGet(ABytes, LAt + ADAM_ELF_READER_SH_SIZE_AT, 8);
    LSection.Link := DoGet(ABytes, LAt + ADAM_ELF_READER_SH_LINK_AT, 4);
    LSection.Info := DoGet(ABytes, LAt + ADAM_ELF_READER_SH_INFO_AT, 4);
    LSection.Align := DoGet(ABytes, LAt + ADAM_ELF_READER_SH_ALIGN_AT, 8);
    LSection.EntrySize := DoGet(ABytes, LAt + ADAM_ELF_READER_SH_ENTSIZE_AT, 8);
    LSection.RelocFirst := 0;
    LSection.RelocCount := 0;
    LSection.Group := 0;
    LSection.GroupFlags := 0;
    if LI = 0 then
      // The null section: its fields hold the extended counts, never data
      LSection.SectionType := int64(SHT_NULL);
      LSection.DataSize := 0;
    end;
    if (LSection.SectionType = int64(SHT_NOBITS)) or (LSection.SectionType = int64(SHT_NULL)) then
      LSection.DataAt := 0;
    else
      if not DoFits(AContext, LSection.DataAt, LSection.DataSize) then
        return DoDamaged(AContext, ADiagnostics,
          NoArgs().Int(LI).Fill(ADAM_MSG_ELF_READER_REASON_DATA));
      end;
      // The data's place in the buffer, not in the object
      LSection.DataAt := LBase + LSection.DataAt;
    end;
    AObject.Sections[LI] := LSection;
  end;
  if (LCount > 0) and (not DoIsSection(AObject, ANames)) then
    return DoDamaged(AContext, ADiagnostics,
      NoArgs().Int(ANames).Fill(ADAM_MSG_ELF_READER_REASON_NAMES));
  end;
  return true;
end;

// Every section's name from the section name table ANames; false after a report
routine DoReadNames(const ABytes: ByteArray; const AContext: ref ReadContext;
  const ADiagnostics: ref Diagnostics; const ANames: int64; var AObject: ElfObjectData): bool;
var
  LTable: int64;
  LI: int64;
  LOffset: int64;
  LName: string;
begin
  if len(AObject.Sections) = 0 then
    return true;
  end;
  if AObject.Sections[ANames].SectionType <> int64(SHT_STRTAB) then
    return DoDamaged(AContext, ADiagnostics,
      NoArgs().Int(ANames).Fill(ADAM_MSG_ELF_READER_REASON_NAMES));
  end;
  // Each header's sh_name (its first field): the name's offset in the name table
  LTable := AContext.Start + DoGet(ABytes, AContext.Start + ADAM_ELF_READER_SHOFF_AT, 8);
  for LI := 1 to len(AObject.Sections) - 1 do
    LOffset := DoGet(ABytes, LTable + LI * ADAM_ELF_SECTION_HEADER_SIZE, 4);
    if not DoTableName(ABytes, AObject, ANames, LOffset, LName) then
      return DoDamaged(AContext, ADiagnostics,
        NoArgs().Int(LI).Fill(ADAM_MSG_ELF_READER_REASON_SECTION_NAME));
    end;
    AObject.Sections[LI].SectionName := LName;
  end;
  return true;
end;

// Checks a table section AIndex holds whole entries of AEntry bytes: false after a report
routine DoCheckEntries(const AContext: ref ReadContext; const ADiagnostics: ref Diagnostics;
  const AObject: ElfObjectData; const AIndex: int64; const AEntry: int64): bool;
var
  LSection: ElfSection;
begin
  LSection := AObject.Sections[AIndex];
  if (LSection.EntrySize <> AEntry) or (LSection.DataSize mod AEntry <> 0) then
    return DoDamaged(AContext, ADiagnostics, NoArgs().Int(AIndex).Int(LSection.EntrySize)
      .Int(AEntry).Fill(ADAM_MSG_ELF_READER_REASON_ENTRIES));
  end;
  return true;
end;

// Reports that section AIndex links the section ALinked the object lacks: false
routine DoBadLink(const AContext: ref ReadContext; const ADiagnostics: ref Diagnostics;
  const AIndex: int64; const ALinked: int64): bool;
begin
  return DoDamaged(AContext, ADiagnostics,
    NoArgs().Int(AIndex).Int(ALinked).Fill(ADAM_MSG_ELF_READER_REASON_LINK));
end;

// The symbol table (one SHT_SYMTAB at most; its SHT_SYMTAB_SHNDX for SHN_XINDEX symbols)
// into AObject.Symbols; false after a report
routine DoReadSymbols(const ABytes: ByteArray; const AContext: ref ReadContext;
  const ADiagnostics: ref Diagnostics; var AObject: ElfObjectData): bool;
var
  LTable: int64;
  LShndx: int64;
  LStrings: int64;
  LCount: int64;
  LAt: int64;
  LInfo: int64;
  LI: int64;
  LSymbol: ElfSymbol;
  LName: string;
  LReserved: bool;
begin
  LTable := 0;
  LShndx := 0;
  for LI := 1 to len(AObject.Sections) - 1 do
    if AObject.Sections[LI].SectionType = int64(SHT_SYMTAB) then
      if LTable <> 0 then
        return DoDamaged(AContext, ADiagnostics, ADAM_MSG_ELF_READER_REASON_TWO_SYMTABS);
      end;
      LTable := LI;
    end;
    if AObject.Sections[LI].SectionType = int64(SHT_SYMTAB_SHNDX) then
      LShndx := LI;
    end;
  end;
  setlength(AObject.Symbols, 0);
  AObject.FirstGlobal := 0;
  if LTable = 0 then
    return true;
  end;
  if not DoCheckEntries(AContext, ADiagnostics, AObject, LTable, ADAM_ELF_SYMBOL_SIZE) then
    return false;
  end;
  LStrings := AObject.Sections[LTable].Link;
  if (not DoIsSection(AObject, LStrings)) or
    (AObject.Sections[LStrings].SectionType <> int64(SHT_STRTAB)) then
    return DoBadLink(AContext, ADiagnostics, LTable, LStrings);
  end;
  LCount := AObject.Sections[LTable].DataSize div ADAM_ELF_SYMBOL_SIZE;
  if (LShndx <> 0) and (AObject.Sections[LShndx].DataSize < LCount * ADAM_ELF_WORD_SIZE) then
    return DoDamaged(AContext, ADiagnostics,
      NoArgs().Int(LShndx).Fill(ADAM_MSG_ELF_READER_REASON_DATA));
  end;
  AObject.FirstGlobal := AObject.Sections[LTable].Info;
  setlength(AObject.Symbols, LCount);
  for LI := 0 to LCount - 1 do
    LAt := AObject.Sections[LTable].DataAt + LI * ADAM_ELF_SYMBOL_SIZE;
    if not DoTableName(ABytes, AObject, LStrings, DoGet(ABytes, LAt, 4), LName) then
      setlength(AObject.Symbols, LI);
      return DoDamaged(AContext, ADiagnostics,
        NoArgs().Int(LI).Fill(ADAM_MSG_ELF_READER_REASON_SYMBOL_NAME));
    end;
    LInfo := int64(ABytes[LAt + ADAM_ELF_READER_ST_INFO_AT]);
    LSymbol.SymbolName := LName;
    LSymbol.Bind := LInfo shr 4;
    LSymbol.SymbolType := LInfo & 0xF;
    LSymbol.Visibility := int64(ABytes[LAt + ADAM_ELF_READER_ST_OTHER_AT]) & 3;
    LSymbol.SectionIndex := DoGet(ABytes, LAt + ADAM_ELF_READER_ST_SHNDX_AT, 2);
    LSymbol.SymbolValue := DoGet(ABytes, LAt + ADAM_ELF_READER_ST_VALUE_AT, 8);
    LSymbol.SymbolSize := DoGet(ABytes, LAt + ADAM_ELF_READER_ST_SIZE_AT, 8);
    // A reserved index other than SHN_XINDEX (SHN_ABS, SHN_COMMON, a processor's or an
    // OS's) is kept as it is
    LReserved := LSymbol.SectionIndex >= int64(SHN_LORESERVE);
    if LSymbol.SectionIndex = int64(SHN_XINDEX) then
      LReserved := false;
      if LShndx = 0 then
        setlength(AObject.Symbols, LI);
        return DoDamaged(AContext, ADiagnostics, NoArgs().Int(LI).Int(LSymbol.SectionIndex)
          .Fill(ADAM_MSG_ELF_READER_REASON_SYMBOL_SECTION));
      end;
      LSymbol.SectionIndex := DoGet(ABytes, AObject.Sections[LShndx].DataAt +
        LI * ADAM_ELF_WORD_SIZE, ADAM_ELF_WORD_SIZE);
    end;
    // A section index the object lacks (SHN_UNDEF and the reserved ones apart)
    if (not LReserved) and (LSymbol.SectionIndex <> int64(SHN_UNDEF)) and
      (not DoIsSection(AObject, LSymbol.SectionIndex)) then
      setlength(AObject.Symbols, LI);
      return DoDamaged(AContext, ADiagnostics, NoArgs().Int(LI).Int(LSymbol.SectionIndex)
        .Fill(ADAM_MSG_ELF_READER_REASON_SYMBOL_SECTION));
    end;
    AObject.Symbols[LI] := LSymbol;
  end;
  return true;
end;

// True when the section AIndex of AObject holds link-time relocations: an SHT_RELA section
// that is not loaded (an allocated one is an image's loader relocations, see the header)
routine DoIsLinkRela(const AObject: ElfObjectData; const AIndex: int64): bool;
begin
  return (AObject.Sections[AIndex].SectionType = int64(SHT_RELA)) and
    ((AObject.Sections[AIndex].Flags & int64(SHF_ALLOC)) = 0);
end;

// Every link-time SHT_RELA section's relocations into AObject.Relocs, in section index
// order, each section's tied to the section it patches; false after a report
routine DoReadRelocs(const ABytes: ByteArray; const AContext: ref ReadContext;
  const ADiagnostics: ref Diagnostics; var AObject: ElfObjectData): bool;
var
  LCount: int64;
  LI: int64;
  LJ: int64;
  LTarget: int64;
  LFirst: int64;
  LN: int64;
  LAt: int64;
  LInfo: int64;
  LReloc: ElfReloc;
begin
  LCount := 0;
  for LI := 1 to len(AObject.Sections) - 1 do
    if DoIsLinkRela(AObject, LI) then
      if not DoCheckEntries(AContext, ADiagnostics, AObject, LI, ADAM_ELF_RELA_SIZE) then
        return false;
      end;
      LCount := LCount + AObject.Sections[LI].DataSize div ADAM_ELF_RELA_SIZE;
    end;
  end;
  setlength(AObject.Relocs, LCount);
  LFirst := 0;
  for LI := 1 to len(AObject.Sections) - 1 do
    if DoIsLinkRela(AObject, LI) then
      LTarget := AObject.Sections[LI].Info;
      if not DoIsSection(AObject, LTarget) then
        setlength(AObject.Relocs, LFirst);
        return DoBadLink(AContext, ADiagnostics, LI, LTarget);
      end;
      if AObject.Sections[LTarget].RelocCount <> 0 then
        setlength(AObject.Relocs, LFirst);
        return DoDamaged(AContext, ADiagnostics,
          NoArgs().Int(LTarget).Fill(ADAM_MSG_ELF_READER_REASON_TWO_RELAS));
      end;
      LN := AObject.Sections[LI].DataSize div ADAM_ELF_RELA_SIZE;
      AObject.Sections[LTarget].RelocFirst := LFirst;
      AObject.Sections[LTarget].RelocCount := LN;
      for LJ := 0 to LN - 1 do
        LAt := AObject.Sections[LI].DataAt + LJ * ADAM_ELF_RELA_SIZE;
        LInfo := DoGet(ABytes, LAt + ADAM_ELF_READER_R_INFO_AT, 8);
        LReloc.Section := LTarget;
        LReloc.Offset := DoGet(ABytes, LAt, 8);
        // r_info: the symbol index in the high 32 bits, the type in the low 32
        LReloc.SymbolIndex := (LInfo shr 32) & 0xFFFFFFFF;
        LReloc.RelocType := LInfo & 0xFFFFFFFF;
        LReloc.Addend := DoGet(ABytes, LAt + ADAM_ELF_READER_R_ADDEND_AT, 8);
        if LReloc.SymbolIndex >= len(AObject.Symbols) then
          setlength(AObject.Relocs, LFirst + LJ);
          return DoDamaged(AContext, ADiagnostics, NoArgs().Int(LTarget).Int(LReloc.SymbolIndex)
            .Fill(ADAM_MSG_ELF_READER_REASON_RELOC_SYMBOL));
        end;
        AObject.Relocs[LFirst + LJ] := LReloc;
      end;
      LFirst := LFirst + LN;
    end;
  end;
  return true;
end;

// Every SHT_GROUP section's flags word, and its members' Group; false after a report
routine DoReadGroups(const ABytes: ByteArray; const AContext: ref ReadContext;
  const ADiagnostics: ref Diagnostics; var AObject: ElfObjectData): bool;
var
  LI: int64;
  LJ: int64;
  LMember: int64;
  LSection: ElfSection;
begin
  for LI := 1 to len(AObject.Sections) - 1 do
    LSection := AObject.Sections[LI];
    if LSection.SectionType = int64(SHT_GROUP) then
      if not DoCheckEntries(AContext, ADiagnostics, AObject, LI, ADAM_ELF_WORD_SIZE) then
        return false;
      end;
      if LSection.DataSize < ADAM_ELF_WORD_SIZE then
        return DoDamaged(AContext, ADiagnostics,
          NoArgs().Int(LI).Fill(ADAM_MSG_ELF_READER_REASON_DATA));
      end;
      AObject.Sections[LI].GroupFlags := DoGet(ABytes, LSection.DataAt, ADAM_ELF_WORD_SIZE);
      for LJ := 1 to LSection.DataSize div ADAM_ELF_WORD_SIZE - 1 do
        LMember := DoGet(ABytes, LSection.DataAt + LJ * ADAM_ELF_WORD_SIZE, ADAM_ELF_WORD_SIZE);
        if not DoIsSection(AObject, LMember) then
          return DoDamaged(AContext, ADiagnostics,
            NoArgs().Int(LI).Int(LMember).Fill(ADAM_MSG_ELF_READER_REASON_GROUP));
        end;
        AObject.Sections[LMember].Group := LI;
      end;
    end;
  end;
  return true;
end;

// The object in the ASize bytes at AStart of ABytes, named ALabel in a report at APlace,
// read into AObject (see the header): true when it is read whole; else the fault is reported
// into ADiagnostics (EO0001) and false returned. Raises for a slice outside ABytes
public routine ReadElfObject(const ABytes: ByteArray; const AStart: int64; const ASize: int64;
  const ALabel: string; const APlace: SourcePlace; const ADiagnostics: ref Diagnostics;
  var AObject: ElfObjectData): bool;
var
  LContext: ref ReadContext;
  LNames: int64;
begin
  if (AStart < 0) or (ASize < 0) or (AStart + ASize > len(ABytes)) then
    raise(ADAM_ELF_READER_FAULT_SLICE + ALabel + " " + IntToStr(AStart) + " " + IntToStr(ASize));
  end;
  AObject.FileType := 0;
  AObject.Machine := 0;
  AObject.Flags := 0;
  AObject.FirstGlobal := 0;
  setlength(AObject.Sections, 0);
  setlength(AObject.Relocs, 0);
  setlength(AObject.Symbols, 0);
  LContext := ref ReadContext(AStart, ASize, ALabel, APlace);
  LNames := 0;
  if not DoReadHeaders(ABytes, LContext, ADiagnostics, AObject, LNames) then
    return false;
  end;
  if not DoReadNames(ABytes, LContext, ADiagnostics, LNames, AObject) then
    return false;
  end;
  if not DoReadSymbols(ABytes, LContext, ADiagnostics, AObject) then
    return false;
  end;
  if not DoReadRelocs(ABytes, LContext, ADiagnostics, AObject) then
    return false;
  end;
  return DoReadGroups(ABytes, LContext, ADiagnostics, AObject);
end;

end.
