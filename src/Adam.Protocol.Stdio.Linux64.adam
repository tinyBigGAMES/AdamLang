  Adam.Protocol.Stdio.Linux64.adam - Adam.Protocol.Stdio's x86_64-linux-gnu
  part over std System.Linux: read / write on descriptors 0 and 1 (a call a
  signal broke off asked again), poll with no wait for HasPending
*******************************************************************************/

module unit Adam.Protocol.Stdio.Linux64;

import System.Linux;

const
  // The most one read / write moves (as the Win64 part: well under the kernel's own cap)
  ADAM_STDIO_CHUNK: int64 = 0x40000000;

// Up to ASize bytes of standard input into ABuffer: how many (0: its end, or it failed)
public func StdioPlatformRead(const ABuffer: ptr; const ASize: int64): int64;
var
  LAsk: int64;
  LRead: int64;
begin
  LAsk := ASize;
  if LAsk > ADAM_STDIO_CHUNK then
    LAsk := ADAM_STDIO_CHUNK;
  end;
  LRead := read(STDIN_FILENO, ABuffer, uint64(LAsk));
  // A signal breaking the read off asks again
  while (LRead < 0) and (CErrno() = EINTR) do
    LRead := read(STDIN_FILENO, ABuffer, uint64(LAsk));
  end;
  if LRead < 0 then
    return 0;
  end;
  return LRead;
end;

// ASize bytes from ABuffer to standard output, all of them; false when it is gone
public func StdioPlatformWrite(const ABuffer: ptr to const; const ASize: int64): bool;
var
  LDone: int64;
  LAsk: int64;
  LWritten: int64;
begin
  LDone := 0;
  while LDone < ASize do
    LAsk := ASize - LDone;
    if LAsk > ADAM_STDIO_CHUNK then
      LAsk := ADAM_STDIO_CHUNK;
    end;
    LWritten := write(STDOUT_FILENO, ptr(uint64(ABuffer) + uint64(LDone)),
      uint64(LAsk));
    if (LWritten < 0) and (CErrno() = EINTR) then
      LWritten := 0;
    else
      if LWritten <= 0 then
        return false;
      end;
    end;
    LDone := LDone + LWritten;
  end;
  return true;
end;

// True when standard input has bytes waiting or its read ends at once: a pipe with some in
// it or broken (POLLHUP / POLLERR), a file (always ready); a terminal never, as on win64
public func StdioPlatformHasPending(): bool;
var
  LPoll: pollfd;
  LCount: int32;
begin
  if isatty(STDIN_FILENO) = 1 then
    return false;
  end;
  LPoll.fd := STDIN_FILENO;
  LPoll.events := POLLIN;
  LPoll.revents := 0;
  LCount := poll(addr of LPoll, 1, 0);
  while (LCount < 0) and (CErrno() = EINTR) do
    LCount := poll(addr of LPoll, 1, 0);
  end;
  return (LCount > 0) and (LPoll.revents <> 0);
end;

end.
