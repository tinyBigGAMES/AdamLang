-------------------------------------------------------------------------------
  Adam.Coff.Format.adam - the COFF / PE format part (DESIGN sec 7)

  CoffFormat    the FormatPart (Adam.Backend.Parts) of COFF objects and PE32+
                images: a section of each kind is the one the PE/COFF spec
                names (code .text, constants .rdata, data .data, zeroed
                .bss); an object is written by Adam.Coff.Writer for the
                arch its CoffMachine describes (Adam.Backend.Targets
                composes the pair); an exe is linked by Adam.Coff.Linker,
                its DLLs searched in the build's folders, then the system's
                (Adam.Coff.Exports.LibraryPaths); a dll's import library is
                lib<name>.dll.a (Adam.Coff.Archive's WriteImportArchive); a
                debug build's debug information is CodeView (.debug$S /
                .debug$T, Adam.Pdb.CodeView, for the arch's CvTarget)
  CoffCodeViewText  an object's debug sections read back as CodeViewText (the
                rows' view): each with the first symbol of the section it
                goes with, its relocations by their symbols' names
*******************************************************************************/

module unit Adam.Coff.Format;

import System.SysUtils, System.Runtime, Adam.Core.Common, Adam.Core.Containers, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics, Adam.Compiler.AST,
  Adam.Backend.Ssa, Adam.Backend.Sections, Adam.Backend.Parts, Adam.Backend.DebugInfo, Adam.Coff.Writer, Adam.Coff.Reader, Adam.Coff.Exports,
  Adam.Coff.Foreign, Adam.Coff.Linker, Adam.Coff.Archive, Adam.Pdb.CodeView, System.Collections,
  System.Windows;

const
  // The report budget of ReadSection's scratch Diagnostics: only whether the read worked counts
  ADAM_COFF_READ_BUDGET: int64 = 1;
  // Raised (a compiler bug) by WriteStaticLibrary for a member that is no object it reads
  ADAM_COFF_FAULT_MEMBER: string = "Coff.Format: a static library member is no object: ";

public const
  // The format's name
  ADAM_COFF_FORMAT_NAME: string = "coff";
  // The sections, by kind
  ADAM_COFF_SECTION_CODE: string = ".text";
  ADAM_COFF_SECTION_READONLY: string = ".rdata";
  ADAM_COFF_SECTION_DATA: string = ".data";
  ADAM_COFF_SECTION_ZEROED: string = ".bss";
  // Thread-local data: a `.tls` group member the linker lays between its `.tls` start
  // marker (suffix "", made before any foreign object's `.tls$`) and its `.tls$ZZZ` end
  // marker: the image's `.tls` section, the TLS directory's raw data (Adam.Coff.Linker)
  ADAM_COFF_SECTION_THREAD_LOCAL: string = ".tls$ADAM";
  // The compiler's own data (a compiled unit's header and tree): LNK_INFO | LNK_REMOVE, a
  // short name (8 bytes at most: no string table entry)
  ADAM_COFF_SECTION_INFO: string = ".adam";
  // A unit object's import list (ImportListName; an Info section: LNK_INFO | LNK_REMOVE)
  ADAM_COFF_SECTION_IMPORTS: string = ".adamimp";
  // The C start list (StartListGroupOf, M8d): the table's start bound, its entries (C++'s
  // and a lib's initializers: what mingw-w64's and MSVC's startup run, _initterm's
  // __xc_a .. __xc_z) and its end bound; one `.CRT` group, laid in suffix order
  ADAM_COFF_SECTION_START_FIRST: string = ".CRT$XCA";
  ADAM_COFF_SECTION_START_ENTRY: string = ".CRT$XCU";
  ADAM_COFF_SECTION_START_LAST: string = ".CRT$XCZ";
  // The C TLS callback list's user entries (M8d2: C's __xl_a .. __xl_z, the loader's TLS
  // callbacks; mingw-w64's tlssup lists `.CRT$XL*` and Adam's linker does too)
  ADAM_COFF_SECTION_THREAD_CALLBACK: string = ".CRT$XLC";

public type
  // COFF / PE (see the header)
  CoffFormat = object(FormatPart)
    // The arch's Machine field and relocation types
    Machine: ref CoffMachine;

    init(const AMachine: ref CoffMachine);
    begin
      self.Machine := AMachine;
    end;

    override method FormatName(): string;
    begin
      return ADAM_COFF_FORMAT_NAME;
    end;

    override method SectionNameOf(const AKind: SectionKind): string;
    begin
      match AKind of
        SectionKind.Code: return ADAM_COFF_SECTION_CODE;
        SectionKind.ReadOnly: return ADAM_COFF_SECTION_READONLY;
        SectionKind.Data: return ADAM_COFF_SECTION_DATA;
        SectionKind.Zeroed: return ADAM_COFF_SECTION_ZEROED;
        SectionKind.ThreadLocal: return ADAM_COFF_SECTION_THREAD_LOCAL;
        SectionKind.Info: return ADAM_COFF_SECTION_INFO;
        SectionKind.Debug: return ADAM_CV_SECTION_SYMBOLS;
      end;
      return "";
    end;

    override method ExeExtension(): string;
    begin
      return ADAM_EXT_COFF_EXE;
    end;

    override method DllExtension(): string;
    begin
      return ADAM_EXT_COFF_DLL;
    end;

    override method DebugFileExtension(): string;
    begin
      return ADAM_EXT_COFF_PDB;
    end;

    // GNU's import archive name, lib<name>.dll.a
    override method ImportLibraryName(const AModuleName: string): string;
    begin
      return ADAM_EXPORTS_LIB_PREFIX + AModuleName + ADAM_EXT_COFF_DLL_IMPORT;
    end;

    // Adam.Coff.Archive's WriteImportArchive, for this arch's Machine
    override method WriteImportLibrary(const ADllName: string; const ANames: StringArray;
      const AData: BoolArray): ByteArray;
    begin
      return WriteImportArchive(ADllName, ANames, AData, self.Machine);
    end;

    // CodeView (Adam.Pdb.CodeView) for the arch's CvTarget
    override method WriteDebugInfo(const ASections: ref SectionSet; const ADebug: ref DebugModule);
    begin
      WriteCodeView(ASections, ADebug, self.Machine.CodeView);
    end;

    override method WriteObject(const ASections: ref SectionSet): ByteArray;
    begin
      return WriteCoffObject(ASections, self.Machine);
    end;

    // Read by Adam.Coff.Reader; its report of a damaged object stays in a scratch
    // Diagnostics (the caller only needs to know the section is not there)
    override method ReadSection(const ABytes: ByteArray; const AName: string;
      var ASection: ByteArray): bool;
    var
      LScratch: ref Diagnostics;
      LObject: CoffObjectData;
      LI: int64;
      LSection: CoffSection;
    begin
      setlength(ASection, 0);
      LScratch := ref Diagnostics(ADAM_COFF_READ_BUDGET);
      if not ReadCoffObject(ABytes, 0, len(ABytes), AName, NoPlace(), LScratch, LObject) then
        return false;
      end;
      for LI := 0 to len(LObject.Sections) - 1 do
        LSection := LObject.Sections[LI];
        if LSection.SectionName = AName then
          // One block copy (ReadCoffObject checked the data lies inside ABytes)
          setlength(ASection, LSection.DataSize);
          if LSection.DataSize > 0 then
            CopyBytes(addr of ASection[0], addr of ABytes[LSection.DataAt], LSection.DataSize);
          end;
          return true;
        end;
      end;
      return false;
    end;

    // Read by Adam.Coff.Reader as ReadSection reads (its report kept in a scratch
    // Diagnostics); the section's raw data overwritten where the object holds it
    override method ReplaceSection(var ABytes: ByteArray; const AName: string;
      const ASection: ByteArray): bool;
    var
      LScratch: ref Diagnostics;
      LObject: CoffObjectData;
      LI: int64;
      LSection: CoffSection;
    begin
      LScratch := ref Diagnostics(ADAM_COFF_READ_BUDGET);
      if not ReadCoffObject(ABytes, 0, len(ABytes), AName, NoPlace(), LScratch, LObject) then
        return false;
      end;
      for LI := 0 to len(LObject.Sections) - 1 do
        LSection := LObject.Sections[LI];
        if LSection.SectionName = AName then
          if LSection.DataSize <> len(ASection) then
            return false;
          end;
          // One block copy (ReadCoffObject checked the data lies inside ABytes)
          if LSection.DataSize > 0 then
            CopyBytes(addr of ABytes[LSection.DataAt], addr of ASection[0], LSection.DataSize);
          end;
          return true;
        end;
      end;
      return false;
    end;

    override method ImportListName(): string;
    begin
      return ADAM_COFF_SECTION_IMPORTS;
    end;

    // GNU's static archive name, lib<name>.a
    override method StaticLibraryName(const AModuleName: string): string;
    begin
      return ADAM_EXPORTS_LIB_PREFIX + AModuleName + ADAM_EXT_AR;
    end;

    // Adam.Coff.Archive's WriteArchive over AObjects, each member named by its object's
    // name and the GNU object ending (.o), its index entries its defined external symbols
    // (storage class external, in a section or absolute) in its symbol table's order
    override method WriteStaticLibrary(const AObjects: ObjectFileArray): ByteArray;
    var
      LMembers: ArchiveInputArray;
      LScratch: ref Diagnostics;
      LObject: CoffObjectData;
      LSymbol: CoffSymbol;
      LDefines: StringArray;
      LName: string;
      LCount: int64;
      LI: int64;
      LJ: int64;
    begin
      setlength(LMembers, len(AObjects));
      for LI := 0 to len(AObjects) - 1 do
        LScratch := ref Diagnostics(ADAM_COFF_READ_BUDGET);
        LName := AObjects[LI].MemberName + ADAM_EXT_COFF_OBJ;
        if not ReadCoffObject(AObjects[LI].Bytes, 0, len(AObjects[LI].Bytes), LName, NoPlace(),
          LScratch, LObject) then
          raise(ADAM_COFF_FAULT_MEMBER + LName);
        end;
        setlength(LDefines, len(LObject.Symbols));
        LCount := 0;
        for LJ := 0 to len(LObject.Symbols) - 1 do
          LSymbol := LObject.Symbols[LJ];
          if (not LSymbol.IsAux) and (LSymbol.StorageClass = IMAGE_SYM_CLASS_EXTERNAL) and
            (LSymbol.SectionNumber <> 0) then
            LDefines[LCount] := LSymbol.SymbolName;
            LCount := LCount + 1;
          end;
        end;
        setlength(LDefines, LCount);
        LMembers[LI].MemberName := LName;
        LMembers[LI].Bytes := AObjects[LI].Bytes;
        LMembers[LI].Defines := LDefines;
      end;
      return WriteArchive(LMembers);
    end;

    override method ReadStaticLibrary(const ABytes: ByteArray; var AObjects: ObjectFileArray): bool;
    var
      LArchive: ArchiveData;
      LScratch: ref Diagnostics;
      LMember: ArchiveMember;
      LCount: int64;
      LI: int64;
    begin
      setlength(AObjects, 0);
      LScratch := ref Diagnostics(ADAM_COFF_READ_BUDGET);
      if not ReadArchive(ABytes, "", NoPlace(), LScratch, LArchive) then
        return false;
      end;
      setlength(AObjects, len(LArchive.Members));
      LCount := 0;
      for LI := 0 to len(LArchive.Members) - 1 do
        LMember := LArchive.Members[LI];
        if LMember.Kind = MemberKind.CoffObject then
          // WriteStaticLibrary's member names end in the object ending it added
          if not EndsStr(ADAM_EXT_COFF_OBJ, LMember.MemberName) then
            setlength(AObjects, 0);
            return false;
          end;
          AObjects[LCount].MemberName := Substring(LMember.MemberName, 0,
            len(LMember.MemberName) - len(ADAM_EXT_COFF_OBJ));
          setlength(AObjects[LCount].Bytes, LMember.Size);
          if LMember.Size > 0 then
            CopyBytes(addr of AObjects[LCount].Bytes[0], addr of ABytes[LMember.DataAt],
              LMember.Size);
          end;
          LCount := LCount + 1;
        end;
        if LMember.Kind = MemberKind.ShortImport then
          setlength(AObjects, 0);
          return false;
        end;
      end;
      setlength(AObjects, LCount);
      return true;
    end;

    override method StartListGroupOf(const APlace: StartListPlace): string;
    begin
      match APlace of
        StartListPlace.None: return "";
        StartListPlace.First: return ADAM_COFF_SECTION_START_FIRST;
        StartListPlace.Entry: return ADAM_COFF_SECTION_START_ENTRY;
        StartListPlace.Last: return ADAM_COFF_SECTION_START_LAST;
        StartListPlace.ThreadCallback: return ADAM_COFF_SECTION_THREAD_CALLBACK;
      end;
      return "";
    end;

    // Through Adam.Coff.Foreign's whole-object merge (ForeignLinker.AddObject), the
    // object's `__imp_` references bound by its ADAM_COFF_SECTION_IMPORTS list
    override method MergeObject(const ASections: ref SectionSet; const ABytes: ByteArray;
      const ALabel: string; const ANode: int64; const ANodes: ref StringIdMap;
      const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics): bool;
    var
      LForeign: ref ForeignLinker;
    begin
      LForeign := ref ForeignLinker(ASections, self.Machine, ATree, ADiagnostics);
      if not LForeign.AddObject(ABytes, ALabel, ANode, ANodes, ADAM_COFF_SECTION_IMPORTS) then
        return false;
      end;
      return LForeign.MergeObjects();
    end;

    override method LinkExe(const ASections: ref SectionSet; const AEntry: string;
      const AThreadCallback: string; const AAddedPaths: StringArray; const ARuntime: ref CRuntimeFacts;
      const ASettings: ref ExeSettings; const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics;
      var ALibraries: StringArray; var ADebugFile: ByteArray): ByteArray;
    begin
      return LinkImage(ASections, self.Machine, AEntry, AThreadCallback, LibraryPaths(AAddedPaths),
        ARuntime, ASettings, ATree, ADiagnostics, ALibraries, ADebugFile);
    end;
  end;

// The name of the first symbol AObject defines in its section ANumber (1-based; its
// COMDAT symbol, not the section's own); "" when none does
routine DoFirstSymbolIn(const AObject: CoffObjectData; const ANumber: int64): string;
var
  LI: int64;
begin
  for LI := 0 to len(AObject.Symbols) - 1 do
    if (not AObject.Symbols[LI].IsAux) and (AObject.Symbols[LI].SectionNumber = ANumber) and
      (AObject.Symbols[LI].SymbolName <> AObject.Sections[ANumber - 1].SectionName) then
      return AObject.Symbols[LI].SymbolName;
    end;
  end;
  return "";
end;

// The debug sections (.debug$S / .debug$T) of the COFF object ABytes for AMachine as
// Adam.Pdb.CodeView's CodeViewText, each with the first symbol of the section it goes with
// and its relocations by their symbols' names (a relocation of another type, or of a
// symbol the object lacks, as "?"); "" when ABytes is no object of AMachine
public routine CoffCodeViewText(const ABytes: ByteArray; const AMachine: ref CoffMachine): string;
var
  LScratch: ref Diagnostics;
  LObject: CoffObjectData;
  LViews: ref List<ref CvSectionView>;
  LView: ref CvSectionView;
  LSection: CoffSection;
  LBytes: ByteArray;
  LPartner: string;
  LReloc: CoffReloc;
  LTarget: string;
  LI: int64;
  LR: int64;
begin
  LScratch := ref Diagnostics(ADAM_COFF_READ_BUDGET);
  if not ReadCoffObject(ABytes, 0, len(ABytes), ADAM_CV_SECTION_SYMBOLS, NoPlace(), LScratch,
    LObject) then
    return "";
  end;
  if LObject.Machine <> AMachine.Machine then
    return "";
  end;
  LViews := ref List<ref CvSectionView>();
  for LI := 0 to len(LObject.Sections) - 1 do
    LSection := LObject.Sections[LI];
    if (LSection.SectionName <> ADAM_CV_SECTION_SYMBOLS) and
      (LSection.SectionName <> ADAM_CV_SECTION_TYPES) then
      skip;
    end;
    setlength(LBytes, LSection.DataSize);
    if LSection.DataSize > 0 then
      CopyBytes(addr of LBytes[0], addr of ABytes[LSection.DataAt], LSection.DataSize);
    end;
    LPartner := "";
    if (LSection.Associated > 0) and (LSection.Associated <= len(LObject.Sections)) then
      LPartner := DoFirstSymbolIn(LObject, LSection.Associated);
    end;
    LView := ref CvSectionView(LSection.SectionName, LPartner, LBytes);
    for LR := 0 to LSection.RelocCount - 1 do
      LReloc := LObject.Relocs[LSection.RelocFirst + LR];
      LTarget := "?";
      if ((LReloc.RelocType = AMachine.RelocSecRel32) or (LReloc.RelocType = AMachine.RelocSection))
        and (LReloc.SymbolIndex >= 0) and (LReloc.SymbolIndex < len(LObject.Symbols)) then
        LTarget := LObject.Symbols[LReloc.SymbolIndex].SymbolName;
      end;
      LView.AddReloc(LReloc.Offset, LTarget);
    end;
    LViews.Add(LView);
  end;
  return CodeViewText(LViews);
end;

end.
