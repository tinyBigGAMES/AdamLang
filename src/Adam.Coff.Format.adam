-------------------------------------------------------------------------------
  Adam.Coff.Format.adam - the COFF / PE format part (DESIGN sec 7)

  CoffFormat    the FormatPart (Adam.Backend.Parts) of COFF objects and PE32+
                images: a section of each kind is the one the PE/COFF spec
                names (code .text, constants .rdata, data .data, zeroed
                .bss); an object is written by Adam.Coff.Writer for the
                arch its CoffMachine describes (Adam.Backend.Targets
                composes the pair); an exe is linked by Adam.Coff.Linker,
                its DLLs searched in the build's folders, then the system's
                (Adam.Coff.Exports.LibraryPaths)
*******************************************************************************/

module unit Adam.Coff.Format;

import System.SysUtils, Adam.Core.Containers, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics, Adam.Compiler.AST,
  Adam.Backend.Sections, Adam.Backend.Parts, Adam.Coff.Writer, Adam.Coff.Reader, Adam.Coff.Exports,
  Adam.Coff.Foreign, Adam.Coff.Linker;

const
  // The report budget of ReadSection's scratch Diagnostics: only whether the read worked counts
  ADAM_COFF_READ_BUDGET: int64 = 1;

public const
  // The format's name
  ADAM_COFF_FORMAT_NAME: string = "coff";
  // The sections, by kind
  ADAM_COFF_SECTION_CODE: string = ".text";
  ADAM_COFF_SECTION_READONLY: string = ".rdata";
  ADAM_COFF_SECTION_DATA: string = ".data";
  ADAM_COFF_SECTION_ZEROED: string = ".bss";
  // Thread-local data: a `.tls` group member the linker lays between its `.tls` start
  // marker (suffix "", made before any foreign object's `.tls$`) and its `.tls$ZZZ` end
  // marker: the image's `.tls` section, the TLS directory's raw data (Adam.Coff.Linker)
  ADAM_COFF_SECTION_THREAD_LOCAL: string = ".tls$ADAM";
  // The compiler's own data (a compiled unit's header and tree): LNK_INFO | LNK_REMOVE, a
  // short name (8 bytes at most: no string table entry)
  ADAM_COFF_SECTION_INFO: string = ".adam";
  // A unit object's import list (ImportListName; an Info section: LNK_INFO | LNK_REMOVE)
  ADAM_COFF_SECTION_IMPORTS: string = ".adamimp";
  // A PE exe's file name ending
  ADAM_COFF_EXE_EXTENSION: string = ".exe";

public type
  // COFF / PE (see the header)
  CoffFormat = object(FormatPart)
    // The arch's Machine field and relocation types
    Machine: ref CoffMachine;

    init(const AMachine: ref CoffMachine);
    begin
      self.Machine := AMachine;
    end;

    override method FormatName(): string;
    begin
      return ADAM_COFF_FORMAT_NAME;
    end;

    override method SectionNameOf(const AKind: SectionKind): string;
    begin
      match AKind of
        SectionKind.Code: return ADAM_COFF_SECTION_CODE;
        SectionKind.ReadOnly: return ADAM_COFF_SECTION_READONLY;
        SectionKind.Data: return ADAM_COFF_SECTION_DATA;
        SectionKind.Zeroed: return ADAM_COFF_SECTION_ZEROED;
        SectionKind.ThreadLocal: return ADAM_COFF_SECTION_THREAD_LOCAL;
        SectionKind.Info: return ADAM_COFF_SECTION_INFO;
      end;
      return "";
    end;

    override method ExeExtension(): string;
    begin
      return ADAM_COFF_EXE_EXTENSION;
    end;

    override method WriteObject(const ASections: ref SectionSet): ByteArray;
    begin
      return WriteCoffObject(ASections, self.Machine);
    end;

    // Read by Adam.Coff.Reader; its report of a damaged object stays in a scratch
    // Diagnostics (the caller only needs to know the section is not there)
    override method ReadSection(const ABytes: ByteArray; const AName: string;
      var ASection: ByteArray): bool;
    var
      LScratch: ref Diagnostics;
      LObject: CoffObjectData;
      LI: int64;
      LJ: int64;
      LSection: CoffSection;
    begin
      setlength(ASection, 0);
      LScratch := ref Diagnostics(ADAM_COFF_READ_BUDGET);
      if not ReadCoffObject(ABytes, 0, len(ABytes), AName, NoPlace(), LScratch, LObject) then
        return false;
      end;
      for LI := 0 to len(LObject.Sections) - 1 do
        LSection := LObject.Sections[LI];
        if LSection.SectionName = AName then
          setlength(ASection, LSection.DataSize);
          for LJ := 0 to LSection.DataSize - 1 do
            ASection[LJ] := ABytes[LSection.DataAt + LJ];
          end;
          return true;
        end;
      end;
      return false;
    end;

    // Read by Adam.Coff.Reader as ReadSection reads (its report kept in a scratch
    // Diagnostics); the section's raw data overwritten where the object holds it
    override method ReplaceSection(var ABytes: ByteArray; const AName: string;
      const ASection: ByteArray): bool;
    var
      LScratch: ref Diagnostics;
      LObject: CoffObjectData;
      LI: int64;
      LJ: int64;
      LSection: CoffSection;
    begin
      LScratch := ref Diagnostics(ADAM_COFF_READ_BUDGET);
      if not ReadCoffObject(ABytes, 0, len(ABytes), AName, NoPlace(), LScratch, LObject) then
        return false;
      end;
      for LI := 0 to len(LObject.Sections) - 1 do
        LSection := LObject.Sections[LI];
        if LSection.SectionName = AName then
          if LSection.DataSize <> len(ASection) then
            return false;
          end;
          for LJ := 0 to LSection.DataSize - 1 do
            ABytes[LSection.DataAt + LJ] := ASection[LJ];
          end;
          return true;
        end;
      end;
      return false;
    end;

    override method ImportListName(): string;
    begin
      return ADAM_COFF_SECTION_IMPORTS;
    end;

    // Through Adam.Coff.Foreign's whole-object merge (ForeignLinker.AddObject), the
    // object's `__imp_` references bound by its ADAM_COFF_SECTION_IMPORTS list
    override method MergeObject(const ASections: ref SectionSet; const ABytes: ByteArray;
      const ALabel: string; const ANode: int64; const ANodes: ref StringIdMap;
      const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics): bool;
    var
      LForeign: ref ForeignLinker;
    begin
      LForeign := ref ForeignLinker(ASections, self.Machine, ATree, ADiagnostics);
      if not LForeign.AddObject(ABytes, ALabel, ANode, ANodes, ADAM_COFF_SECTION_IMPORTS) then
        return false;
      end;
      return LForeign.MergeObjects();
    end;

    override method LinkExe(const ASections: ref SectionSet; const AEntry: string;
      const AThreadCallback: string; const AAddedPaths: StringArray; const ARuntime: ref CRuntimeFacts;
      const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics;
      var ALibraries: StringArray): ByteArray;
    begin
      return LinkImage(ASections, self.Machine, AEntry, AThreadCallback, LibraryPaths(AAddedPaths),
        ARuntime, ATree, ADiagnostics, ALibraries);
    end;
  end;

end.
