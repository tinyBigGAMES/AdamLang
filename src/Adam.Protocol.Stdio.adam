-------------------------------------------------------------------------------
  Adam.Protocol.Stdio.adam - the process's standard input and output as a
  ProtocolChannel (M11a D5): adam dap's (later adam lsp's) channel to the
  editor that started it

  Bytes go straight to the OS's handles, never through C's buffered stdio
  (stdout is the protocol: nothing else may be written to it). HasPending:
  a pipe with bytes in it, a file not at its end; a console never (a read
  of it would wait for a line). Target-neutral: the OS's calls are the
  platform part's, picked by the triple this compiler was built for.
*******************************************************************************/

module unit Adam.Protocol.Stdio;

import Adam.Protocol.Transport
@ifdef TARGET_X86_64_WINDOWS_GNU
  , Adam.Protocol.Stdio.Win64
@endif
  ;

public type
  // The process's standard input and output (see the header)
  StdioChannel = object(ProtocolChannel)
    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    begin
@ifdef TARGET_X86_64_WINDOWS_GNU
      return StdioPlatformRead(ABuffer, ASize);
@else
      return 0;
@endif
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    begin
@ifdef TARGET_X86_64_WINDOWS_GNU
      return StdioPlatformWrite(ABuffer, ASize);
@else
      return false;
@endif
    end;

    override method HasPending(): bool;
    begin
@ifdef TARGET_X86_64_WINDOWS_GNU
      return StdioPlatformHasPending();
@else
      return false;
@endif
    end;
  end;

end.
