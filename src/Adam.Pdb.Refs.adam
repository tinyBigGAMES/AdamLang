-------------------------------------------------------------------------------
  Adam.Pdb.Refs.adam - where a CodeView record holds its type and id indices

  A linker merging objects' CodeView into one PDB rewrites every type index
  and id index a record holds (an object's own indices become the PDB's).
  Which bytes those are is a fact of the record's kind alone; this unit is
  that fact for every kind a C / C++ compiler's objects hold (LLVM's
  TypeIndexDiscovery, cvinfo.h's layouts), Adam's own included:

  CvIndexSpace       the stream an index names: Types (TPI) or Ids (IPI)
  CvRef              one index field: its byte offset in the record (a
                     4-byte index) and its space
  CvTypeRefs         a type or id record's index fields (LF_*: pointers,
                     procedures, methods, argument lists, field lists and
                     their members, arrays, classes / structures / unions /
                     enums / interfaces, bitfields, modifiers, method lists,
                     vftables; the ids LF_FUNC_ID, LF_MFUNC_ID, LF_BUILDINFO,
                     LF_SUBSTR_LIST, LF_STRING_ID, LF_UDT_SRC_LINE,
                     LF_UDT_MOD_SRC_LINE); false for a leaf it does not know
                     (a type server's, a precompiled header's) or a record
                     cut short
  CvSymbolRefs       a symbol record's index fields (S_*); false the same way
  CvIsIdLeaf         a leaf kind is an id record (it goes to the IPI)
  CvNumericSize      a numeric leaf's byte count (its kind and its value)
  CvOpensScope       a symbol kind opens a scope (its parent and end fields
  CvClosesScope      set in a PDB), closes the innermost one
  CvSegmentAt        where a symbol kind's address keeps its section number
                     (the linker writes 0 for a section the link removed)

  Offsets are from the record's start (its 2-byte length, then its 2-byte
  kind or leaf); nothing here raises: a foreign object's bytes are input.
*******************************************************************************/

module unit Adam.Pdb.Refs;

import System.SysUtils, System.Collections, Adam.Pdb.CodeView;

const
  // A pointer's mode bits (its attributes' bits 5..7) and the modes of a pointer to a
  // member (data, function): those name the member's class too
  ADAM_CV_REFS_POINTER_MODE_SHIFT: int64 = 5;
  // A method's property (its attributes' bits 2..4): an introducing virtual one has a
  // virtual base offset after its type
  ADAM_CV_REFS_METHOD_PROP_SHIFT: int64 = 2;

public type
  // The stream an index names: a type (TPI) or an id (IPI)
  CvIndexSpace = choices(Types, Ids);

  // One index field of a record: its offset (a 4-byte index there) and its space
  CvRef = record
    At: int64;
    Space: CvIndexSpace;
  end;

// The AWidth-byte little-endian value at AAt of ABytes; -1 past AEnd
func DoField(const ABytes: ByteArray; const AAt: int64; const AWidth: int64;
  const AEnd: int64): int64;
begin
  if (AAt < 0) or (AAt + AWidth > AEnd) or (AEnd > len(ABytes)) then
    return -1;
  end;
  return int64(GetLe(ABytes, AAt, AWidth));
end;

// The offset past the NUL-ended name at AAt of ABytes (before AEnd); -1 when it does not
// end there
func DoPastName(const ABytes: ByteArray; const AAt: int64; const AEnd: int64): int64;
var
  LAt: int64;
begin
  if AAt < 0 then
    return -1;
  end;
  LAt := AAt;
  while (LAt < AEnd) and (LAt < len(ABytes)) do
    if ABytes[LAt] = 0 then
      return LAt + 1;
    end;
    LAt := LAt + 1;
  end;
  return -1;
end;

// The byte count of the numeric leaf at AAt of ABytes (its 2-byte kind and its value,
// before AEnd); -1 for a kind it does not know or one past AEnd
public func CvNumericSize(const ABytes: ByteArray; const AAt: int64; const AEnd: int64): int64;
var
  LKind: int64;
  LSize: int64;
  LPast: int64;
begin
  LKind := DoField(ABytes, AAt, 2, AEnd);
  if LKind < 0 then
    return -1;
  end;
  if LKind < LF_NUMERIC then
    return 2;
  end;
  LSize := -1;
  if LKind = LF_CHAR then
    LSize := 1;
  end;
  if (LKind = LF_SHORT) or (LKind = LF_USHORT) or (LKind = LF_REAL16) then
    LSize := 2;
  end;
  if (LKind = LF_LONG) or (LKind = LF_ULONG) or (LKind = LF_REAL32) then
    LSize := 4;
  end;
  if LKind = LF_REAL48 then
    LSize := 6;
  end;
  if (LKind = LF_QUADWORD) or (LKind = LF_UQUADWORD) or
    (LKind = LF_REAL64) or (LKind = LF_COMPLEX32) or (LKind = LF_DATE) then
    LSize := 8;
  end;
  if LKind = LF_REAL80 then
    LSize := 10;
  end;
  if (LKind = LF_REAL128) or (LKind = LF_OCTWORD) or
    (LKind = LF_UOCTWORD) or (LKind = LF_COMPLEX64) or
    (LKind = LF_DECIMAL) then
    LSize := 16;
  end;
  if LKind = LF_COMPLEX80 then
    LSize := 20;
  end;
  if LKind = LF_COMPLEX128 then
    LSize := 32;
  end;
  if LKind = LF_VARSTRING then
    // a 2-byte length, then that many bytes
    LSize := DoField(ABytes, AAt + 2, 2, AEnd);
    if LSize < 0 then
      return -1;
    end;
    LSize := LSize + 2;
  end;
  if LKind = LF_UTF8STRING then
    LPast := DoPastName(ABytes, AAt + 2, AEnd);
    if LPast < 0 then
      return -1;
    end;
    LSize := LPast - AAt - 2;
  end;
  if (LSize < 0) or (AAt + 2 + LSize > AEnd) then
    return -1;
  end;
  return 2 + LSize;
end;

// True when a record of leaf ALeaf is an id record (a PDB's IPI stream)
public func CvIsIdLeaf(const ALeaf: int64): bool;
begin
  return (ALeaf = LF_FUNC_ID) or (ALeaf = LF_MFUNC_ID) or
    (ALeaf = LF_BUILDINFO) or (ALeaf = LF_SUBSTR_LIST) or
    (ALeaf = LF_STRING_ID) or (ALeaf = LF_UDT_SRC_LINE) or
    (ALeaf = LF_UDT_MOD_SRC_LINE);
end;

// The index field at AAt of a record ASize bytes long, of space ASpace, added to ARefs;
// false when it is past the record
func DoRef(const ARefs: ref List<CvRef>; const AAt: int64; const ASpace: CvIndexSpace;
  const ASize: int64): bool;
var
  LRef: CvRef;
begin
  if (AAt < 4) or (AAt + 4 > ASize) then
    return false;
  end;
  LRef.At := AAt;
  LRef.Space := ASpace;
  ARefs.Add(LRef);
  return true;
end;

// The ACount 4-byte indices from AAt of a record ASize bytes long, of space ASpace
func DoRefRun(const ARefs: ref List<CvRef>; const AAt: int64; const ACount: int64;
  const ASpace: CvIndexSpace; const ASize: int64): bool;
var
  LI: int64;
begin
  if (ACount < 0) or (AAt + 4 * ACount > ASize) then
    return false;
  end;
  for LI := 0 to ACount - 1 do
    if not DoRef(ARefs, AAt + 4 * LI, ASpace, ASize) then
      return false;
    end;
  end;
  return true;
end;

// The member of a field list at AAt of ARecord: its index fields added, AAt moved past it;
// false for a member it does not know or one cut short
func DoMember(const ARecord: ByteArray; var AAt: int64; const ARefs: ref List<CvRef>): bool;
var
  LSize: int64;
  LLeaf: int64;
  LNumeric: int64;
  LProperty: int64;
  LNameAt: int64;
begin
  LSize := len(ARecord);
  LLeaf := DoField(ARecord, AAt, 2, LSize);
  if (LLeaf = LF_BCLASS) or (LLeaf = LF_BINTERFACE) then
    // attributes 2, the base class 4, its offset
    LNumeric := CvNumericSize(ARecord, AAt + 8, LSize);
    if (LNumeric < 0) or not DoRef(ARefs, AAt + 4, CvIndexSpace.Types, LSize) then
      return false;
    end;
    AAt := AAt + 8 + LNumeric;
    return true;
  end;
  if (LLeaf = LF_VBCLASS) or (LLeaf = LF_IVBCLASS) then
    // attributes 2, the base class 4, the virtual base pointer's type 4, two offsets
    LNumeric := CvNumericSize(ARecord, AAt + 12, LSize);
    if LNumeric < 0 then
      return false;
    end;
    LProperty := CvNumericSize(ARecord, AAt + 12 + LNumeric, LSize);
    if (LProperty < 0) or not DoRefRun(ARefs, AAt + 4, 2, CvIndexSpace.Types, LSize) then
      return false;
    end;
    AAt := AAt + 12 + LNumeric + LProperty;
    return true;
  end;
  if (LLeaf = LF_INDEX) or (LLeaf = LF_VFUNCTAB) or
    (LLeaf = LF_FRIENDCLS) then
    // padding 2, the type 4
    if not DoRef(ARefs, AAt + 4, CvIndexSpace.Types, LSize) then
      return false;
    end;
    AAt := AAt + 8;
    return true;
  end;
  if LLeaf = LF_ENUMERATE then
    // attributes 2, the value, the name
    LNumeric := CvNumericSize(ARecord, AAt + 4, LSize);
    if LNumeric < 0 then
      return false;
    end;
    AAt := DoPastName(ARecord, AAt + 4 + LNumeric, LSize);
    return AAt > 0;
  end;
  if LLeaf = LF_MEMBER then
    // attributes 2, the type 4, the offset, the name
    LNumeric := CvNumericSize(ARecord, AAt + 8, LSize);
    if (LNumeric < 0) or not DoRef(ARefs, AAt + 4, CvIndexSpace.Types, LSize) then
      return false;
    end;
    AAt := DoPastName(ARecord, AAt + 8 + LNumeric, LSize);
    return AAt > 0;
  end;
  if (LLeaf = LF_STMEMBER) or (LLeaf = LF_METHOD) or
    (LLeaf = LF_NESTTYPE) or (LLeaf = LF_FRIENDFCN) then
    // attributes / count / padding 2, the type (a method's: its method list) 4, the name
    if not DoRef(ARefs, AAt + 4, CvIndexSpace.Types, LSize) then
      return false;
    end;
    AAt := DoPastName(ARecord, AAt + 8, LSize);
    return AAt > 0;
  end;
  if LLeaf = LF_ONEMETHOD then
    // attributes 2, the type 4, an introducing virtual one's base offset 4, the name
    if not DoRef(ARefs, AAt + 4, CvIndexSpace.Types, LSize) then
      return false;
    end;
    LProperty := (DoField(ARecord, AAt + 2, 2, LSize) shr ADAM_CV_REFS_METHOD_PROP_SHIFT) & 7;
    LNameAt := AAt + 8;
    if (LProperty = CV_MTintro) or (LProperty = CV_MTpureintro) then
      LNameAt := AAt + 12;
    end;
    AAt := DoPastName(ARecord, LNameAt, LSize);
    return AAt > 0;
  end;
  return false;
end;

// The field list ARecord's members' index fields
func DoFieldList(const ARecord: ByteArray; const ARefs: ref List<CvRef>): bool;
var
  LAt: int64;
begin
  LAt := 4;
  while LAt < len(ARecord) do
    // LF_PAD bytes between members
    if ARecord[LAt] >= uint8(LF_PAD0) then
      LAt := LAt + 1;
      skip;
    end;
    if not DoMember(ARecord, LAt, ARefs) then
      return false;
    end;
  end;
  return true;
end;

// The method list ARecord's entries' index fields: attributes 2, padding 2, the type 4, an
// introducing virtual one's base offset 4
func DoMethodList(const ARecord: ByteArray; const ARefs: ref List<CvRef>): bool;
var
  LAt: int64;
  LProperty: int64;
begin
  LAt := 4;
  while LAt < len(ARecord) do
    if not DoRef(ARefs, LAt + 4, CvIndexSpace.Types, len(ARecord)) then
      return false;
    end;
    LProperty := (DoField(ARecord, LAt, 2, len(ARecord)) shr ADAM_CV_REFS_METHOD_PROP_SHIFT) & 7;
    LAt := LAt + 8;
    if (LProperty = CV_MTintro) or (LProperty = CV_MTpureintro) then
      LAt := LAt + 4;
    end;
  end;
  return LAt = len(ARecord);
end;

// An id record ARecord of leaf ALeaf: its index fields; false for a leaf that is no id
func DoIdRefs(const ARecord: ByteArray; const ALeaf: int64; const ARefs: ref List<CvRef>): bool;
var
  LSize: int64;
begin
  LSize := len(ARecord);
  if ALeaf = LF_FUNC_ID then
    // the parent scope (an id, 0 none), the function's type
    return DoRef(ARefs, 4, CvIndexSpace.Ids, LSize) and DoRef(ARefs, 8, CvIndexSpace.Types, LSize);
  end;
  if ALeaf = LF_MFUNC_ID then
    // the class, the method's type
    return DoRefRun(ARefs, 4, 2, CvIndexSpace.Types, LSize);
  end;
  if ALeaf = LF_BUILDINFO then
    // a 2-byte count, then that many string ids
    return DoRefRun(ARefs, 6, DoField(ARecord, 4, 2, LSize), CvIndexSpace.Ids, LSize);
  end;
  if ALeaf = LF_SUBSTR_LIST then
    return DoRefRun(ARefs, 8, DoField(ARecord, 4, 4, LSize), CvIndexSpace.Ids, LSize);
  end;
  if ALeaf = LF_STRING_ID then
    // its substring list (0 none), the text
    return DoRef(ARefs, 4, CvIndexSpace.Ids, LSize);
  end;
  if ALeaf = LF_UDT_SRC_LINE then
    // the UDT, its source file's string id, the line
    return DoRef(ARefs, 4, CvIndexSpace.Types, LSize) and DoRef(ARefs, 8, CvIndexSpace.Ids, LSize);
  end;
  if ALeaf = LF_UDT_MOD_SRC_LINE then
    // the UDT, its source file's /names offset (no index), the line, the module
    return DoRef(ARefs, 4, CvIndexSpace.Types, LSize);
  end;
  return false;
end;

// The type or id record ARecord's index fields into ARefs (cleared first); false for a
// leaf it does not know or a record cut short
public func CvTypeRefs(const ARecord: ByteArray; const ARefs: ref List<CvRef>): bool;
var
  LSize: int64;
  LLeaf: int64;
  LMode: int64;
begin
  ARefs.Clear();
  LSize := len(ARecord);
  LLeaf := DoField(ARecord, 2, 2, LSize);
  if LLeaf < 0 then
    return false;
  end;
  if CvIsIdLeaf(LLeaf) then
    return DoIdRefs(ARecord, LLeaf, ARefs);
  end;
  if (LLeaf = LF_VTSHAPE) or (LLeaf = LF_LABEL) then
    return true;
  end;
  if (LLeaf = LF_MODIFIER) or (LLeaf = LF_BITFIELD) then
    return DoRef(ARefs, 4, CvIndexSpace.Types, LSize);
  end;
  if LLeaf = LF_POINTER then
    // the referent 4, attributes 4; a pointer to a member then names its class
    if not DoRef(ARefs, 4, CvIndexSpace.Types, LSize) then
      return false;
    end;
    LMode := (DoField(ARecord, 8, 4, LSize) shr ADAM_CV_REFS_POINTER_MODE_SHIFT) & 7;
    if (LMode = CV_PTR_MODE_PMEM) or (LMode = CV_PTR_MODE_PMFUNC) then
      return DoRef(ARefs, 12, CvIndexSpace.Types, LSize);
    end;
    return true;
  end;
  if LLeaf = LF_PROCEDURE then
    // the result 4, calling convention 1, attributes 1, parameter count 2, the arguments 4
    return DoRef(ARefs, 4, CvIndexSpace.Types, LSize) and DoRef(ARefs, 12, CvIndexSpace.Types, LSize);
  end;
  if LLeaf = LF_MFUNCTION then
    // the result, the class, this (4 each), convention / attributes / count 4, the
    // arguments 4, this' adjustment 4
    return DoRefRun(ARefs, 4, 3, CvIndexSpace.Types, LSize) and
      DoRef(ARefs, 20, CvIndexSpace.Types, LSize);
  end;
  if LLeaf = LF_ARGLIST then
    return DoRefRun(ARefs, 8, DoField(ARecord, 4, 4, LSize), CvIndexSpace.Types, LSize);
  end;
  if LLeaf = LF_FIELDLIST then
    return DoFieldList(ARecord, ARefs);
  end;
  if LLeaf = LF_METHODLIST then
    return DoMethodList(ARecord, ARefs);
  end;
  if (LLeaf = LF_ARRAY) or (LLeaf = LF_VFTABLE) then
    // an array's element and index types; a vftable's class and the one it overrides
    return DoRefRun(ARefs, 4, 2, CvIndexSpace.Types, LSize);
  end;
  if (LLeaf = LF_CLASS) or (LLeaf = LF_STRUCTURE) or
    (LLeaf = LF_INTERFACE) then
    // count 2, properties 2, the field list, the derived list, the vtable shape (4 each)
    return DoRefRun(ARefs, 8, 3, CvIndexSpace.Types, LSize);
  end;
  if LLeaf = LF_UNION then
    return DoRef(ARefs, 8, CvIndexSpace.Types, LSize);
  end;
  if LLeaf = LF_ENUM then
    // count 2, properties 2, the underlying type, the field list
    return DoRefRun(ARefs, 8, 2, CvIndexSpace.Types, LSize);
  end;
  // LF_TYPESERVER2, LF_PRECOMP, LF_ENDPRECOMP and anything unknown
  return false;
end;

// The symbol record ARecord's index fields into ARefs (cleared first); false for a kind
// it does not know or a record cut short
public func CvSymbolRefs(const ARecord: ByteArray; const ARefs: ref List<CvRef>): bool;
var
  LSize: int64;
  LKind: int64;
begin
  ARefs.Clear();
  LSize := len(ARecord);
  LKind := DoField(ARecord, 2, 2, LSize);
  if LKind < 0 then
    return false;
  end;
  if (LKind = S_GPROC32) or (LKind = S_LPROC32) or
    (LKind = S_LPROC32_DPC) then
    // parent, end, next, size, debug start, debug end (4 each), then the type
    return DoRef(ARefs, 28, CvIndexSpace.Types, LSize);
  end;
  if (LKind = S_GPROC32_ID) or (LKind = S_LPROC32_ID) or
    (LKind = S_LPROC32_DPC_ID) then
    // the same layout, the function's id
    return DoRef(ARefs, 28, CvIndexSpace.Ids, LSize);
  end;
  if (LKind = S_REGREL32) or (LKind = S_BPREL32) then
    // the offset 4, then the type
    return DoRef(ARefs, 8, CvIndexSpace.Types, LSize);
  end;
  if (LKind = S_GDATA32) or (LKind = S_LDATA32) or
    (LKind = S_GTHREAD32) or (LKind = S_LTHREAD32) or
    (LKind = S_GMANDATA) or (LKind = S_LMANDATA) or
    (LKind = S_UDT) or (LKind = S_COBOLUDT) or
    (LKind = S_CONSTANT) or (LKind = S_MANCONSTANT) or
    (LKind = S_REGISTER) or (LKind = S_LOCAL) or
    (LKind = S_FILESTATIC) then
    // the type first
    return DoRef(ARefs, 4, CvIndexSpace.Types, LSize);
  end;
  if LKind = S_BUILDINFO then
    return DoRef(ARefs, 4, CvIndexSpace.Ids, LSize);
  end;
  if (LKind = S_INLINESITE) or (LKind = S_INLINESITE2) then
    // parent, end, then the inlined function's id
    return DoRef(ARefs, 12, CvIndexSpace.Ids, LSize);
  end;
  if (LKind = S_CALLSITEINFO) or (LKind = S_HEAPALLOCSITE) then
    // offset 4, section 2, padding / length 2, then the type
    return DoRef(ARefs, 12, CvIndexSpace.Types, LSize);
  end;
  if (LKind = S_CALLEES) or (LKind = S_CALLERS) or
    (LKind = S_INLINEES) then
    // a count, then that many function ids (a callers / callees list then its counts)
    return DoRefRun(ARefs, 8, DoField(ARecord, 4, 4, LSize), CvIndexSpace.Ids, LSize);
  end;
  if (LKind = S_END) or (LKind = S_PROC_ID_END) or
    (LKind = S_INLINESITE_END) or (LKind = S_OBJNAME) or
    (LKind = S_COMPILE) or (LKind = S_COMPILE2) or
    (LKind = S_COMPILE3) or (LKind = S_ENVBLOCK) or
    (LKind = S_FRAMEPROC) or (LKind = S_BLOCK32) or
    (LKind = S_LABEL32) or (LKind = S_THUNK32) or
    (LKind = S_TRAMPOLINE) or (LKind = S_SEPCODE) or
    (LKind = S_SECTION) or (LKind = S_COFFGROUP) or
    (LKind = S_EXPORT) or (LKind = S_FRAMECOOKIE) or
    (LKind = S_UNAMESPACE) or (LKind = S_ANNOTATION) or
    (LKind = S_ARMSWITCHTABLE) or (LKind = S_POGODATA) or
    (LKind = S_DEFRANGE) or (LKind = S_DEFRANGE_SUBFIELD) or
    (LKind = S_DEFRANGE_REGISTER) or (LKind = S_DEFRANGE_FRAMEPOINTER_REL) or
    (LKind = S_DEFRANGE_SUBFIELD_REGISTER) or
    (LKind = S_DEFRANGE_FRAMEPOINTER_REL_FULL_SCOPE) or
    (LKind = S_DEFRANGE_REGISTER_REL) then
    // no index
    return true;
  end;
  return false;
end;

// True when a symbol of AKind opens a scope (its parent and end fields set in a PDB)
public func CvOpensScope(const AKind: int64): bool;
begin
  return (AKind = S_GPROC32) or (AKind = S_LPROC32) or
    (AKind = S_GPROC32_ID) or (AKind = S_LPROC32_ID) or
    (AKind = S_LPROC32_DPC) or (AKind = S_LPROC32_DPC_ID) or
    (AKind = S_BLOCK32) or (AKind = S_THUNK32) or
    (AKind = S_INLINESITE) or (AKind = S_INLINESITE2) or
    (AKind = S_SEPCODE);
end;

// True when a symbol of AKind closes the innermost scope
public func CvClosesScope(const AKind: int64): bool;
begin
  return (AKind = S_END) or (AKind = S_PROC_ID_END) or
    (AKind = S_INLINESITE_END);
end;

// The offset of the 2-byte section number of a symbol of AKind's address (after its
// 4-byte offset); -1 for a kind with no address of its own
public func CvSegmentAt(const AKind: int64): int64;
begin
  if (AKind = S_GPROC32) or (AKind = S_LPROC32) or
    (AKind = S_GPROC32_ID) or (AKind = S_LPROC32_ID) or
    (AKind = S_LPROC32_DPC) or (AKind = S_LPROC32_DPC_ID) then
    // parent, end, next, size, debug start, debug end, type (4 each), offset 4
    return 36;
  end;
  if (AKind = S_GDATA32) or (AKind = S_LDATA32) or
    (AKind = S_GTHREAD32) or (AKind = S_LTHREAD32) then
    // type 4, offset 4
    return 12;
  end;
  if (AKind = S_BLOCK32) or (AKind = S_THUNK32) then
    // parent, end, then a block's length / a thunk's next, offset (4 each)
    return 20;
  end;
  if AKind = S_LABEL32 then
    return 8;
  end;
  return -1;
end;

end.
