-------------------------------------------------------------------------------
  Adam.Debug.Targets.adam - the debug targets Adam has (M11a D1)

  DebugTargetFor    a new DebugTarget for a triple's programs; nil when this
                    adam cannot debug them (a part runs on its own OS only)
  DebugSymbolsFor   a new DebugSymbols for a triple's debug information; nil
                    as DebugTargetFor
  KnownDebugTargets the triples it can debug, as a message lists them

  The one place a triple's debugger part is picked (as Adam.Backend.Targets
  picks a backend's parts): a new OS is one more entry in DebugTargetFor.
*******************************************************************************/

module unit Adam.Debug.Targets;

// A part reaches its OS's own calls, so only the part of the OS this compiler runs on is
// linked in (picked by the triple it was built for, as System.IO picks its platform unit)
import Adam.Debug.Target, Adam.Debug.Symbols
@ifdef TARGET_X86_64_WINDOWS_GNU
  , Adam.Debug.Target.Win64, Adam.Debug.Symbols.Win64
@endif
  ;

public const
  // The triple whose programs Win64DebugTarget debugs
  ADAM_DEBUG_WIN64_TRIPLE: string = "x86_64-windows-gnu";

// A new DebugTarget for ATriple's programs (normalized, arch-os-abi); nil when Adam has none
public func DebugTargetFor(const ATriple: string): ref DebugTarget;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  if ATriple = ADAM_DEBUG_WIN64_TRIPLE then
    return ref Win64DebugTarget();
  end;
@endif
  return nil;
end;

// A new DebugSymbols for ATriple's programs' debug information; nil when Adam has none
public func DebugSymbolsFor(const ATriple: string): ref DebugSymbols;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  if ATriple = ADAM_DEBUG_WIN64_TRIPLE then
    return ref Win64DebugSymbols();
  end;
@endif
  return nil;
end;

// The triples Adam debugs, comma separated, as a message lists them
public func KnownDebugTargets(): string;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return ADAM_DEBUG_WIN64_TRIPLE;
@else
  return "";
@endif
end;

end.
