-------------------------------------------------------------------------------
  Adam.X64.Layout.adam - machine cleanup and block layout (PLAN-ADAM M6 O20)

  LayoutFunction  one allocated MachineFunction (Adam.X64.Allocate) cleaned
                  and laid out in place, before it is encoded
                  (Adam.X64.Encode), at every level, in this order:

  moves           a move of a register into itself goes (mov.8 r, r; movss
                  / movsd / movaps x, x; a mov.4 r, r zeroes the top half,
                  so it goes only when the last write of r before it in
                  its block already did (a 4-byte write or zero), or when
                  after it, in its block, r is read through its low 4
                  bytes only until something writes all of r); of two
                  moves in a row of one kind (mov.8, or
                  movsd) where the second undoes the first (a, b then b, a;
                  a store of a register into a place then its reload from
                  there, or the load then the store back) the second goes,
                  unless the register is the place's base. Prologue
                  instructions and instructions with implicit registers
                  stay.
  placement       unless AKeepOrder (a function with scopes: their byte
                  ranges take its machine blocks in their SSA order,
                  Adam.X64.Arch), the blocks are put in a reverse postorder
                  from the entry. Its walk takes a block's successors that
                  leave a loop the block is in, and the ones ending in ud2
                  (a raise path: a noreturn call), before the others, so a
                  loop's body follows its header and the path out comes
                  after it. Then the blocks ending in ud2 go last (the
                  entry stays first), and the blocks the walk does not
                  reach after them, in their order. A loop is the blocks
                  that reach a back edge's source (a jump to a block the
                  first walk still has open) without passing its target,
                  the header. A function with a block that does not end in
                  a jmp, ret, tail call or ud2 (it falls through) keeps its
                  order.
  threading       with placement, when every block is closed: a jmp / jcc
                  to a trampoline (a block that is one jmp) names where
                  the chain of trampolines lands; a trampoline (not the
                  entry) nothing names any more is emptied (control never
                  reaches it: it encodes to nothing)
  jumps           in the final order, a jmp to the next block goes, and jcc
                  c A; jmp B with A the next block becomes jcc !c B (the
                  next block: the next one holding an instruction)
  alignment       at fast (AAlignLoops) a loop header (a block jumped to
                  from itself or a block after it, the entry aside) starts
                  at an ADAM_X64_LAYOUT_LOOP_ALIGN boundary
                  (MachineBlock.Align: the encoder pads with nops)
*******************************************************************************/

module unit Adam.X64.Layout;

import System.SysUtils, Adam.Core.Containers, Adam.X64.Machine;

public const
  // A loop header's alignment at fast (one instruction fetch block)
  ADAM_X64_LAYOUT_LOOP_ALIGN: int64 = 16;

type
  // One list per block (successors, predecessors, loops)
  BlockLists = array of ref Int64List;

// True for a physical register operand
func DoIsRegister(const AOperand: ref MachineOperand): bool;
begin
  return AOperand.Kind = OperandKind.PhysicalReg;
end;

// True for a memory operand off a physical register alone (no index, symbol or segment)
func DoIsPlainMemory(const AOperand: ref MachineOperand): bool;
begin
  return (AOperand.Kind = OperandKind.Memory) and (AOperand.Base = MemoryBase.Register) and
    not AOperand.BaseVirtual and (AOperand.Scale = 0) and (AOperand.DispSymbol = "") and
    (AOperand.Segment = "");
end;

// True when AA and AB are one plain memory place (DoIsPlainMemory)
func DoSamePlace(const AA: ref MachineOperand; const AB: ref MachineOperand): bool;
begin
  return DoIsPlainMemory(AA) and DoIsPlainMemory(AB) and (AA.Reg = AB.Reg) and
    (AA.Disp = AB.Disp);
end;

// True for an instruction cleanup may take out: no prologue instruction, no implicit
// register, two operands
func DoIsPlainMove(const AInstr: ref MachineInstr): bool;
begin
  if AInstr.Prologue or (AInstr.ImplicitUses.Count > 0) or (AInstr.ImplicitDefs.Count > 0) or
    (AInstr.OperandCount <> 2) then
    return false;
  end;
  return ((AInstr.Op = X64Op.Mov) and (AInstr.Width = 8)) or (AInstr.Op = X64Op.MovSD) or
    (AInstr.Op = X64Op.MovSS) or (AInstr.Op = X64Op.MovAps);
end;

// True for a move of a register into itself (see the header)
func DoIsSelfMove(const AInstr: ref MachineInstr): bool;
begin
  if not DoIsPlainMove(AInstr) then
    return false;
  end;
  return DoIsRegister(AInstr.OperandAt(0)) and DoIsRegister(AInstr.OperandAt(1)) and
    (AInstr.OperandAt(0).Reg = AInstr.OperandAt(1).Reg);
end;

// True when AB, right after AA, moves back what AA moved (see the header)
func DoUndoes(const AA: ref MachineInstr; const AB: ref MachineInstr): bool;
var
  LADst: ref MachineOperand;
  LASrc: ref MachineOperand;
  LBDst: ref MachineOperand;
  LBSrc: ref MachineOperand;
begin
  if not DoIsPlainMove(AA) or not DoIsPlainMove(AB) or (AA.Op <> AB.Op) or
    (AA.Width <> AB.Width) or ((AA.Op <> X64Op.Mov) and (AA.Op <> X64Op.MovSD)) then
    return false;
  end;
  LADst := AA.OperandAt(0);
  LASrc := AA.OperandAt(1);
  LBDst := AB.OperandAt(0);
  LBSrc := AB.OperandAt(1);
  if DoIsRegister(LADst) and DoIsRegister(LASrc) and DoIsRegister(LBDst) and
    DoIsRegister(LBSrc) then
    return (LADst.Reg = LBSrc.Reg) and (LASrc.Reg = LBDst.Reg);
  end;
  // A store then its reload: the register still holds what the place holds
  if DoIsPlainMemory(LADst) and DoIsRegister(LASrc) and DoIsRegister(LBDst) and
    DoSamePlace(LADst, LBSrc) then
    return (LASrc.Reg = LBDst.Reg) and (LASrc.Reg <> LADst.Reg);
  end;
  // A load then its store back: the place still holds what the register holds
  if DoIsRegister(LADst) and DoIsPlainMemory(LASrc) and DoSamePlace(LASrc, LBDst) and
    DoIsRegister(LBSrc) then
    return (LADst.Reg = LBSrc.Reg) and (LADst.Reg <> LASrc.Reg);
  end;
  return false;
end;

// True for a mov.4 of a register into itself (no prologue, no implicit register): it only
// zeroes the register's top half
func DoIsZeroingSelfMove(const AInstr: ref MachineInstr): bool;
begin
  if AInstr.Prologue or (AInstr.ImplicitUses.Count > 0) or (AInstr.ImplicitDefs.Count > 0) or
    (AInstr.OperandCount <> 2) or (AInstr.Op <> X64Op.Mov) or (AInstr.Width <> 4) then
    return false;
  end;
  return DoIsRegister(AInstr.OperandAt(0)) and DoIsRegister(AInstr.OperandAt(1)) and
    (AInstr.OperandAt(0).Reg = AInstr.OperandAt(1).Reg);
end;

// True for the 4-byte ops whose implicit registers they write as 4-byte values: the wide
// multiplies and divisions (edx:eax), cdq (edx), xchg / lock xadd (the register). Lock
// cmpxchg is not one: a cmpxchg that stores leaves rax unwritten
func DoWritesImplicit32(const AOp: X64Op): bool;
begin
  return (AOp = X64Op.IMulWide) or (AOp = X64Op.MulWide) or (AOp = X64Op.IDiv) or
    (AOp = X64Op.UDiv) or (AOp = X64Op.Cqo) or (AOp = X64Op.Xchg) or (AOp = X64Op.LockXadd);
end;

// True when AInstr writes physical register AReg: as its first operand, or implicitly
func DoWritesRegister(const AInstr: ref MachineInstr; const AReg: int64): bool;
begin
  if (AInstr.OperandCount > 0) and X64OperandWrites(AInstr, 0) and
    DoIsRegister(AInstr.OperandAt(0)) and (AInstr.OperandAt(0).Reg = AReg) then
    return true;
  end;
  return AInstr.ImplicitDefs.IndexOf(AReg) >= 0;
end;

// True when AInstr's write of physical register AReg zeroes its top half: a general
// register written by a 4-byte op (x86_64 zero-extends every 32-bit write: mov, lea, the
// arithmetic, shifts, cmov, movzx / movsx, movd, cvt*2si) or by zero (xor r32, r32), or a
// 4-byte op's implicit 32-bit write (DoWritesImplicit32)
func DoZeroesTop(const AInstr: ref MachineInstr; const AReg: int64): bool;
begin
  if (AInstr.OperandCount > 0) and X64OperandWrites(AInstr, 0) and
    DoIsRegister(AInstr.OperandAt(0)) and (AInstr.OperandAt(0).Reg = AReg) then
    return (AInstr.Op = X64Op.Zero) or (AInstr.Width = 4);
  end;
  return (AInstr.Width = 4) and DoWritesImplicit32(AInstr.Op) and
    (AInstr.ImplicitDefs.IndexOf(AReg) >= 0);
end;

// True when the mov.4 r, r at AIndex of ABlock (DoIsZeroingSelfMove) changes nothing: the
// last instruction before it in the block that writes r already zeroed r's top half (none
// in the block: what a predecessor left is not known, so it stays)
func DoTopAlreadyZero(const ABlock: ref MachineBlock; const AIndex: int64): bool;
var
  LReg: int64;
  LI: int64;
begin
  LReg := ABlock.InstrAt(AIndex).OperandAt(0).Reg;
  LI := AIndex - 1;
  while LI >= 0 do
    if DoWritesRegister(ABlock.InstrAt(LI), LReg) then
      return DoZeroesTop(ABlock.InstrAt(LI), LReg);
    end;
    LI := LI - 1;
  end;
  return false;
end;

// True when memory operand AOperand addresses through physical register AReg (its base or
// its index)
func DoAddressesWith(const AOperand: ref MachineOperand; const AReg: int64): bool;
begin
  if AOperand.Kind <> OperandKind.Memory then
    return false;
  end;
  if (AOperand.Base = MemoryBase.Register) and not AOperand.BaseVirtual and
    (AOperand.Reg = AReg) then
    return true;
  end;
  return (AOperand.Scale > 0) and not AOperand.IndexVirtual and (AOperand.IndexReg = AReg);
end;

// True when AInstr reads physical register AReg; ALowOnly set to whether every read takes
// only its low 4 bytes: a register operand of a 1, 2 or 4-byte op, an address of a lea of
// 4 bytes or less (its low bits come from the low bits alone), an implicit read of a
// 4-byte wide multiply / division / cdq, or a shift's count (cl)
func DoReadsRegister(const AInstr: ref MachineInstr; const AReg: int64;
  var ALowOnly: bool): bool;
var
  LOperand: ref MachineOperand;
  LReads: bool;
  LK: int64;
begin
  LReads := false;
  ALowOnly := true;
  for LK := 0 to AInstr.OperandCount - 1 do
    LOperand := AInstr.OperandAt(LK);
    if DoIsRegister(LOperand) and (LOperand.Reg = AReg) and X64OperandReads(AInstr, LK) then
      LReads := true;
      if (AInstr.Width < 1) or (AInstr.Width > 4) then
        ALowOnly := false;
      end;
    end;
    if DoAddressesWith(LOperand, AReg) then
      LReads := true;
      if (AInstr.Op <> X64Op.Lea) or (AInstr.Width > 4) then
        ALowOnly := false;
      end;
    end;
  end;
  if AInstr.ImplicitUses.IndexOf(AReg) >= 0 then
    LReads := true;
    if not (((AInstr.Width = 4) and DoWritesImplicit32(AInstr.Op)) or
      (AInstr.Op = X64Op.Shl) or (AInstr.Op = X64Op.Shr) or (AInstr.Op = X64Op.Sar)) then
      ALowOnly := false;
    end;
  end;
  return LReads;
end;

// True when the mov.4 r, r at AIndex of ABlock (DoIsZeroingSelfMove) is dead the other
// way: after it, in its block, r is read only through its low 4 bytes (DoReadsRegister)
// until an instruction writes all of r (a 4 or 8-byte write, zero, or an implicit write
// such as a call's clobber); a 1 or 2-byte write keeps the top, and the block's end
// (r may be live out) keeps the move
func DoTopNeverRead(const ABlock: ref MachineBlock; const AIndex: int64): bool;
var
  LInstr: ref MachineInstr;
  LReg: int64;
  LLowOnly: bool;
  LI: int64;
begin
  LReg := ABlock.InstrAt(AIndex).OperandAt(0).Reg;
  for LI := AIndex + 1 to ABlock.InstrCount - 1 do
    LInstr := ABlock.InstrAt(LI);
    if DoReadsRegister(LInstr, LReg, LLowOnly) and not LLowOnly then
      return false;
    end;
    if DoWritesRegister(LInstr, LReg) then
      if (LInstr.OperandCount > 0) and X64OperandWrites(LInstr, 0) and
        DoIsRegister(LInstr.OperandAt(0)) and (LInstr.OperandAt(0).Reg = LReg) then
        return (LInstr.Op = X64Op.Zero) or (LInstr.Width >= 4);
      end;
      // An implicit write: a call's clobber, or a 4 / 8-byte one (a wide multiply's /
      // division's rdx:rax, xchg / xadd's register); lock cmpxchg writes rax only when the
      // compare fails, a 1 or 2-byte xchg / xadd only the low bytes
      if LInstr.Op = X64Op.LockCmpxchg then
        return false;
      end;
      return (LInstr.Op = X64Op.Call) or (LInstr.Width >= 4);
    end;
  end;
  return false;
end;

// The moves of every block cleaned (see the header)
func DoMoves(const AMachine: ref MachineFunction);
var
  LBlock: ref MachineBlock;
  LB: int64;
  LI: int64;
begin
  for LB := 0 to AMachine.BlockCount - 1 do
    LBlock := AMachine.BlockAt(LB);
    LI := 0;
    while LI < LBlock.InstrCount do
      if DoIsSelfMove(LBlock.InstrAt(LI)) or
        (DoIsZeroingSelfMove(LBlock.InstrAt(LI)) and
        (DoTopAlreadyZero(LBlock, LI) or DoTopNeverRead(LBlock, LI))) then
        LBlock.RemoveAt(LI);
      else
        if (LI > 0) and DoUndoes(LBlock.InstrAt(LI - 1), LBlock.InstrAt(LI)) then
          LBlock.RemoveAt(LI);
        else
          LI := LI + 1;
        end;
      end;
    end;
  end;
end;

// True for a block whose last instruction is ud2 (a raise path)
func DoIsCold(const ABlock: ref MachineBlock): bool;
begin
  return (ABlock.InstrCount > 0) and (ABlock.InstrAt(ABlock.InstrCount - 1).Op = X64Op.Ud2);
end;

// True when every block ends in an instruction that closes it (nothing falls through)
func DoAllClosed(const AMachine: ref MachineFunction): bool;
var
  LBlock: ref MachineBlock;
  LB: int64;
begin
  for LB := 0 to AMachine.BlockCount - 1 do
    LBlock := AMachine.BlockAt(LB);
    if (LBlock.InstrCount = 0) or not X64OpCloses(LBlock.InstrAt(LBlock.InstrCount - 1).Op) then
      return false;
    end;
  end;
  return true;
end;

// Each block's successors: the blocks its jumps name, in the order they name them
func DoSuccessors(const AMachine: ref MachineFunction): BlockLists;
var
  LSuccs: BlockLists;
  LBlock: ref MachineBlock;
  LInstr: ref MachineInstr;
  LB: int64;
  LI: int64;
  LK: int64;
begin
  setlength(LSuccs, AMachine.BlockCount);
  for LB := 0 to AMachine.BlockCount - 1 do
    LSuccs[LB] := ref Int64List();
    LBlock := AMachine.BlockAt(LB);
    for LI := 0 to LBlock.InstrCount - 1 do
      LInstr := LBlock.InstrAt(LI);
      for LK := 0 to LInstr.OperandCount - 1 do
        if (LInstr.OperandAt(LK).Kind = OperandKind.BlockRef) and
          (LSuccs[LB].IndexOf(LInstr.OperandAt(LK).Block) < 0) then
          LSuccs[LB].Add(LInstr.OperandAt(LK).Block);
        end;
      end;
    end;
  end;
  return LSuccs;
end;

// A depth-first walk from the entry over ASuccs (each block's successors in the order the
// walk takes them): the blocks in postorder into APost, and every back edge (to a block the
// walk still has open) into ABackFrom / ABackTo
func DoWalk(const ASuccs: BlockLists; const ACount: int64; const APost: ref Int64List;
  const ABackFrom: ref Int64List; const ABackTo: ref Int64List);
var
  LState: Int64Array;
  LStack: Int64Array;
  LNext: Int64Array;
  LDepth: int64;
  LTop: int64;
  LS: int64;
  LB: int64;
begin
  // 0: not seen, 1: open (on the walk's stack), 2: done
  setlength(LState, ACount);
  setlength(LStack, ACount);
  setlength(LNext, ACount);
  for LB := 0 to ACount - 1 do
    LState[LB] := 0;
  end;
  LStack[0] := 0;
  LNext[0] := 0;
  LDepth := 1;
  LState[0] := 1;
  while LDepth > 0 do
    LTop := LStack[LDepth - 1];
    if LNext[LDepth - 1] < ASuccs[LTop].Count then
      LS := ASuccs[LTop].Items[LNext[LDepth - 1]];
      LNext[LDepth - 1] := LNext[LDepth - 1] + 1;
      if LState[LS] = 0 then
        LState[LS] := 1;
        LStack[LDepth] := LS;
        LNext[LDepth] := 0;
        LDepth := LDepth + 1;
      else
        if LState[LS] = 1 then
          ABackFrom.Add(LTop);
          ABackTo.Add(LS);
        end;
      end;
    else
      LState[LTop] := 2;
      APost.Add(LTop);
      LDepth := LDepth - 1;
    end;
  end;
end;

// Each block's loops (the headers of the loops it is in), from the back edges ABackFrom /
// ABackTo: a loop is its header and the blocks that reach the back edge's source without
// passing the header (over APreds)
func DoLoops(const APreds: BlockLists; const ACount: int64; const ABackFrom: ref Int64List;
  const ABackTo: ref Int64List): BlockLists;
var
  LLoops: BlockLists;
  LWork: ref Int64List;
  LHead: int64;
  LB: int64;
  LP: int64;
  LE: int64;
  LK: int64;
begin
  setlength(LLoops, ACount);
  for LB := 0 to ACount - 1 do
    LLoops[LB] := ref Int64List();
  end;
  for LE := 0 to ABackFrom.Count - 1 do
    LHead := ABackTo.Items[LE];
    if LLoops[LHead].IndexOf(LHead) < 0 then
      LLoops[LHead].Add(LHead);
    end;
    LWork := ref Int64List();
    if LLoops[ABackFrom.Items[LE]].IndexOf(LHead) < 0 then
      LLoops[ABackFrom.Items[LE]].Add(LHead);
      LWork.Add(ABackFrom.Items[LE]);
    end;
    // A worklist read from the front as it grows: each block entered once
    LK := 0;
    while LK < LWork.Count do
      LB := LWork.Items[LK];
      LK := LK + 1;
      for LP := 0 to APreds[LB].Count - 1 do
        if LLoops[APreds[LB].Items[LP]].IndexOf(LHead) < 0 then
          LLoops[APreds[LB].Items[LP]].Add(LHead);
          LWork.Add(APreds[LB].Items[LP]);
        end;
      end;
    end;
  end;
  return LLoops;
end;

// True when going from block AFrom to block ATo leaves a loop AFrom is in (ALoops)
func DoLeaves(const ALoops: BlockLists; const AFrom: int64; const ATo: int64): bool;
var
  LI: int64;
begin
  for LI := 0 to ALoops[AFrom].Count - 1 do
    if ALoops[ATo].IndexOf(ALoops[AFrom].Items[LI]) < 0 then
      return true;
    end;
  end;
  return false;
end;

// The blocks placed (see the header)
func DoPlace(const AMachine: ref MachineFunction);
var
  LCount: int64;
  LSuccs: BlockLists;
  LPreds: BlockLists;
  LLoops: BlockLists;
  LOrdered: BlockLists;
  LPost: ref Int64List;
  LBackFrom: ref Int64List;
  LBackTo: ref Int64List;
  LOrder: ref Int64List;
  LPlaced: BoolArray;
  LS: int64;
  LB: int64;
  LI: int64;
begin
  LCount := AMachine.BlockCount;
  if (LCount < 3) or not DoAllClosed(AMachine) then
    return;
  end;
  LSuccs := DoSuccessors(AMachine);
  setlength(LPreds, LCount);
  for LB := 0 to LCount - 1 do
    LPreds[LB] := ref Int64List();
  end;
  for LB := 0 to LCount - 1 do
    for LI := 0 to LSuccs[LB].Count - 1 do
      LPreds[LSuccs[LB].Items[LI]].Add(LB);
    end;
  end;
  // The first walk finds the back edges, so the loops
  LPost := ref Int64List();
  LBackFrom := ref Int64List();
  LBackTo := ref Int64List();
  DoWalk(LSuccs, LCount, LPost, LBackFrom, LBackTo);
  LLoops := DoLoops(LPreds, LCount, LBackFrom, LBackTo);
  // The second walk takes the successors that leave a loop or raise first: the ones taken
  // first end up last in reverse postorder
  setlength(LOrdered, LCount);
  for LB := 0 to LCount - 1 do
    LOrdered[LB] := ref Int64List();
    for LI := 0 to LSuccs[LB].Count - 1 do
      LS := LSuccs[LB].Items[LI];
      if DoIsCold(AMachine.BlockAt(LS)) or DoLeaves(LLoops, LB, LS) then
        LOrdered[LB].Add(LS);
      end;
    end;
    for LI := 0 to LSuccs[LB].Count - 1 do
      LS := LSuccs[LB].Items[LI];
      if not DoIsCold(AMachine.BlockAt(LS)) and not DoLeaves(LLoops, LB, LS) then
        LOrdered[LB].Add(LS);
      end;
    end;
  end;
  LPost := ref Int64List();
  LBackFrom := ref Int64List();
  LBackTo := ref Int64List();
  DoWalk(LOrdered, LCount, LPost, LBackFrom, LBackTo);
  // Reverse postorder, the raise paths after the rest (the entry first, whatever it ends
  // in), then the blocks the walk did not reach
  setlength(LPlaced, LCount);
  for LB := 0 to LCount - 1 do
    LPlaced[LB] := false;
  end;
  LOrder := ref Int64List();
  for LI := LPost.Count - 1 downto 0 do
    LB := LPost.Items[LI];
    if (LB = 0) or not DoIsCold(AMachine.BlockAt(LB)) then
      LOrder.Add(LB);
      LPlaced[LB] := true;
    end;
  end;
  for LI := LPost.Count - 1 downto 0 do
    LB := LPost.Items[LI];
    if not LPlaced[LB] then
      LOrder.Add(LB);
      LPlaced[LB] := true;
    end;
  end;
  for LB := 0 to LCount - 1 do
    if not LPlaced[LB] then
      LOrder.Add(LB);
      LPlaced[LB] := true;
    end;
  end;
  AMachine.ReorderBlocks(LOrder);
end;

// The condition that holds exactly when ACond does not
func DoInverse(const ACond: X64Cond): X64Cond;
begin
  match ACond of
    X64Cond.Overflow: return X64Cond.NoOverflow;
    X64Cond.NoOverflow: return X64Cond.Overflow;
    X64Cond.Below: return X64Cond.AboveOrEqual;
    X64Cond.AboveOrEqual: return X64Cond.Below;
    X64Cond.Equal: return X64Cond.NotEqual;
    X64Cond.NotEqual: return X64Cond.Equal;
    X64Cond.BelowOrEqual: return X64Cond.Above;
    X64Cond.Above: return X64Cond.BelowOrEqual;
    X64Cond.Sign: return X64Cond.NoSign;
    X64Cond.NoSign: return X64Cond.Sign;
    X64Cond.Parity: return X64Cond.NoParity;
    X64Cond.NoParity: return X64Cond.Parity;
    X64Cond.Less: return X64Cond.GreaterOrEqual;
    X64Cond.GreaterOrEqual: return X64Cond.Less;
    X64Cond.LessOrEqual: return X64Cond.Greater;
    X64Cond.Greater: return X64Cond.LessOrEqual;
  end;
end;

// True for a jump (jmp or jcc) whose one operand is a block
func DoIsBlockJump(const AInstr: ref MachineInstr): bool;
begin
  return ((AInstr.Op = X64Op.Jmp) or (AInstr.Op = X64Op.Jcc)) and (AInstr.OperandCount = 1) and
    (AInstr.OperandAt(0).Kind = OperandKind.BlockRef);
end;

// True for a block that is one jmp to a block and nothing else (a trampoline)
func DoIsTrampoline(const ABlock: ref MachineBlock): bool;
begin
  return (ABlock.InstrCount = 1) and (ABlock.InstrAt(0).Op = X64Op.Jmp) and
    DoIsBlockJump(ABlock.InstrAt(0));
end;

// Where a jump to block ABlock lands in the end: through every trampoline in a row; a
// chain that comes back round (a jmp to itself, trampolines naming each other) lands on
// ABlock itself
func DoLanding(const AMachine: ref MachineFunction; const ABlock: int64): int64;
var
  LAt: int64;
  LSteps: int64;
begin
  LAt := ABlock;
  LSteps := 0;
  while DoIsTrampoline(AMachine.BlockAt(LAt)) do
    LAt := AMachine.BlockAt(LAt).InstrAt(0).OperandAt(0).Block;
    LSteps := LSteps + 1;
    if (LAt = ABlock) or (LSteps > AMachine.BlockCount) then
      return ABlock;
    end;
  end;
  return LAt;
end;

// The jumps threaded (see the header): every jmp / jcc to a trampoline names where the
// chain lands; a trampoline (not the entry) no operand names any more is emptied. Only
// when every block is closed: then no block falls into another, and an emptied block is
// one control never reaches
func DoThread(const AMachine: ref MachineFunction);
var
  LBlock: ref MachineBlock;
  LInstr: ref MachineInstr;
  LLandings: array of int64;
  LNamed: array of int64;
  LTarget: int64;
  LB: int64;
  LI: int64;
  LK: int64;
begin
  if not DoAllClosed(AMachine) then
    return;
  end;
  // Every block's landing first, over the jumps as they stand
  setlength(LLandings, AMachine.BlockCount);
  for LB := 0 to AMachine.BlockCount - 1 do
    LLandings[LB] := DoLanding(AMachine, LB);
  end;
  setlength(LNamed, AMachine.BlockCount);
  for LB := 0 to AMachine.BlockCount - 1 do
    LNamed[LB] := 0;
  end;
  for LB := 0 to AMachine.BlockCount - 1 do
    LBlock := AMachine.BlockAt(LB);
    for LI := 0 to LBlock.InstrCount - 1 do
      LInstr := LBlock.InstrAt(LI);
      if DoIsBlockJump(LInstr) then
        LTarget := LLandings[LInstr.OperandAt(0).Block];
        if LTarget <> LInstr.OperandAt(0).Block then
          LInstr.SetOperand(0, BlockOperand(LTarget));
        end;
      end;
      // Every block operand counts as naming its block, a jump's or not
      for LK := 0 to LInstr.OperandCount - 1 do
        if LInstr.OperandAt(LK).Kind = OperandKind.BlockRef then
          LNamed[LInstr.OperandAt(LK).Block] := LNamed[LInstr.OperandAt(LK).Block] + 1;
        end;
      end;
    end;
  end;
  for LB := 1 to AMachine.BlockCount - 1 do
    LBlock := AMachine.BlockAt(LB);
    if DoIsTrampoline(LBlock) and (LNamed[LB] = 0) then
      LBlock.RemoveAt(0);
    end;
  end;
end;

// The first block from ABlock on that holds an instruction (where control falling into
// ABlock ends up: an empty block encodes to nothing); the block count past the last
func DoFilledFrom(const AMachine: ref MachineFunction; const ABlock: int64): int64;
var
  LB: int64;
begin
  LB := ABlock;
  while (LB < AMachine.BlockCount) and (AMachine.BlockAt(LB).InstrCount = 0) do
    LB := LB + 1;
  end;
  return LB;
end;

// True for a jump (jmp or jcc) that lands where falling out of block ABlock lands: its
// block, or the next filled one (DoFilledFrom), is the one after ABlock's
func DoJumpsToNext(const AMachine: ref MachineFunction; const AInstr: ref MachineInstr;
  const ABlock: int64): bool;
var
  LNext: int64;
begin
  if not DoIsBlockJump(AInstr) then
    return false;
  end;
  LNext := DoFilledFrom(AMachine, ABlock + 1);
  return (LNext < AMachine.BlockCount) and
    (DoFilledFrom(AMachine, AInstr.OperandAt(0).Block) = LNext);
end;

// The jumps to the next block taken out (see the header)
func DoJumps(const AMachine: ref MachineFunction);
var
  LBlock: ref MachineBlock;
  LLast: ref MachineInstr;
  LPrev: ref MachineInstr;
  LCount: int64;
  LB: int64;
begin
  for LB := 0 to AMachine.BlockCount - 2 do
    LBlock := AMachine.BlockAt(LB);
    LCount := LBlock.InstrCount;
    if LCount > 0 then
      LLast := LBlock.InstrAt(LCount - 1);
      if DoJumpsToNext(AMachine, LLast, LB) and (LLast.Op = X64Op.Jmp) then
        LBlock.RemoveAt(LCount - 1);
      else
        if (LCount > 1) and (LLast.Op = X64Op.Jmp) and DoIsBlockJump(LLast) then
          LPrev := LBlock.InstrAt(LCount - 2);
          if DoJumpsToNext(AMachine, LPrev, LB) and (LPrev.Op = X64Op.Jcc) then
            // jcc c next; jmp B -> jcc !c B, falling into next
            LPrev.Cond := DoInverse(LPrev.Cond);
            LPrev.SetOperand(0, BlockOperand(LLast.OperandAt(0).Block));
            LBlock.RemoveAt(LCount - 1);
          end;
        end;
      end;
    end;
  end;
end;

// Every loop header aligned (see the header)
func DoAlignLoops(const AMachine: ref MachineFunction);
var
  LBlock: ref MachineBlock;
  LInstr: ref MachineInstr;
  LTarget: int64;
  LB: int64;
  LI: int64;
  LK: int64;
begin
  for LB := 0 to AMachine.BlockCount - 1 do
    LBlock := AMachine.BlockAt(LB);
    for LI := 0 to LBlock.InstrCount - 1 do
      LInstr := LBlock.InstrAt(LI);
      for LK := 0 to LInstr.OperandCount - 1 do
        if LInstr.OperandAt(LK).Kind = OperandKind.BlockRef then
          LTarget := LInstr.OperandAt(LK).Block;
          if (LTarget > 0) and (LTarget <= LB) then
            AMachine.BlockAt(LTarget).Align := ADAM_X64_LAYOUT_LOOP_ALIGN;
          end;
        end;
      end;
    end;
  end;
end;

// AMachine (allocated, not yet encoded) cleaned and laid out in place (see the header)
public func LayoutFunction(const AMachine: ref MachineFunction; const AKeepOrder: bool;
  const AAlignLoops: bool);
begin
  DoMoves(AMachine);
  if not AKeepOrder then
    DoPlace(AMachine);
    DoThread(AMachine);
  end;
  DoJumps(AMachine);
  if AAlignLoops then
    DoAlignLoops(AMachine);
  end;
end;

end.
