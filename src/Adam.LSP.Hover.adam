-------------------------------------------------------------------------------
  Adam.LSP.Hover.adam - a declaration as a hover shows it (M11b L3)

  HoverMarkdown: the declaration's heading in an adam fence, then its doc
  comment (Adam.LSP.Docs) as a paragraph of its own. The heading:
    routine, method, init / copy / done, operator, forward, module: its
    text as written from its first token to the ';' that ends its heading
    (outside brackets), blanks run into one space; const: `const` and that
    text;
    property: its text up to its first accessor, then each accessor's word
    and the field it names (`property P: int32 read FN; write FN`; one with
    a body or a heading of its own: its word alone);
    type: `type` and its first line (`type Point = record`); extend: its
    first line (`extend Vector2`);
    var / field / parameter: `var X: T` / `X: T` with the type's text
    (Adam.Compiler.Types TypeText: the resolved type, an instance's own), a
    field's `hidden` and a parameter's mode (`const` / `var`) as written;
    embed `embed X: T`; a choice value `Type.Value`; a type parameter its
    name.
  The text is that of the declaration's own file (an LSPDocument); with
  none, a heading needing it is its kind's word and its name.
  A declaration in another file than the one hovered in ends with that
  file's name in italics, a paragraph of its own (pcpp's).

  WordHoverMarkdown (HK1): what the language itself defines, from the
  Lexer's one tables (the docs reference reads the same rows, AD.15): an
  intrinsic (its spelling and Signature, IntrinsicRow's Doc), a keyword or
  builtin type word (KeywordDoc), a directive (DirectiveRow's Doc) and a
  context word no name of the check claims (ContextWordDoc), each ending
  with what it is in italics. The word is the Lexer's token at the place,
  so a word in a comment or a string is none.*******************************************************************************/

module unit Adam.LSP.Hover;

import System.SysUtils, System.IO, Adam.Core.Containers, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics, Adam.Compiler.Lexer, Adam.Compiler.AST, Adam.Compiler.Types,
  Adam.LSP.Document, Adam.LSP.Docs;

const
  ADAM_LSP_HOVER_FENCE: string = "```adam";
  ADAM_LSP_HOVER_FENCE_END: string = "```";
  // The report budget of the scratch Diagnostics WordHoverMarkdown's Lexer reports into (its
  // reports are the diagnostics' business, dropped here)
  ADAM_LSP_HOVER_BUDGET: int64 = 1000;
  // What a word the language defines is, the last line of its hover
  ADAM_LSP_HOVER_INTRINSIC: string = "*intrinsic*";
  ADAM_LSP_HOVER_KEYWORD: string = "*keyword*";
  ADAM_LSP_HOVER_TYPE_WORD: string = "*builtin type*";
  ADAM_LSP_HOVER_DIRECTIVE: string = "*directive*";
  ADAM_LSP_HOVER_CONTEXT_WORD: string = "*context word*";

// HeadingText's text from AStart, stopping at AEnd at the latest
func DoHeadingText(const ADocument: ref LSPDocument; const AStart: int64; const AEnd: int64;
  const AOneLine: bool): string;
var
  LText: string;
  LAt: int64;
  LDepth: int64;
  LOut: ref TextBuilder;
  LBlank: bool;
  LChar: char;
  LStop: int64;
begin
  LText := ADocument.Text;
  LOut := ref TextBuilder();
  LAt := AStart;
  LDepth := 0;
  LBlank := false;
  LStop := AEnd;
  if LStop > len(LText) then
    LStop := len(LText);
  end;
  while LAt < LStop do
    LChar := LText[LAt];
    if (LChar = ';') and (LDepth = 0) then
      leave;
    end;
    if AOneLine and ((LChar = '\n') or (LChar = '\r')) then
      leave;
    end;
    if (LChar = '/') and (LAt + 1 < len(LText)) and (LText[LAt + 1] = '/') then
      // A comment to the line's end
      while (LAt < LStop) and (LText[LAt] <> '\n') do
        LAt := LAt + 1;
      end;
      LBlank := true;
      skip;
    end;
    if (LChar = ' ') or (LChar = '\t') or (LChar = '\n') or (LChar = '\r') then
      LBlank := true;
    else
      if LBlank and (LOut.Count > 0) then
        LOut.Add(" ");
      end;
      LBlank := false;
      if (LChar = '(') or (LChar = '[') then
        LDepth := LDepth + 1;
      end;
      if ((LChar = ')') or (LChar = ']')) and (LDepth > 0) then
        LDepth := LDepth - 1;
      end;
      LOut.Add(Substring(LText, LAt, 1));
    end;
    LAt := LAt + 1;
  end;
  return LOut.Text();
end;

// The heading text of ADocument from AStart: up to the ';' that ends it outside brackets (or
// the end of its first line when AOneLine), a line comment dropped, blanks run into one space
// (a hover's heading, an outline's detail)
public func HeadingText(const ADocument: ref LSPDocument; const AStart: int64;
  const AOneLine: bool): string;
begin
  return DoHeadingText(ADocument, AStart, len(ADocument.Text), AOneLine);
end;

// A property's heading (see the header): AStart the offset of its first token
func DoPropertyText(const ATree: ref SyntaxTree; const AProperty: int64;
  const ADocument: ref LSPDocument; const AStart: int64): string;
var
  LI: int64;
  LChild: int64;
  LKind: NodeKind;
  LFirst: int64;
  LText: string;
  LParts: string;
  LField: int64;
begin
  // The heading up to its first accessor, the accessors from the tree after it
  LFirst := -1;
  LParts := "";
  for LI := 0 to ATree.ChildCount(AProperty) - 1 do
    LChild := ATree.ChildAt(AProperty, LI);
    LKind := ATree[LChild].Kind;
    if (LKind = NodeKind.PropertyRead) or (LKind = NodeKind.PropertyWrite) then
      if LFirst < 0 then
        LFirst := ATree[LChild].StartOffset;
      end;
      if LParts <> "" then
        LParts := LParts + "; ";
      end;
      if LKind = NodeKind.PropertyRead then
        LParts := LParts + "read";
      else
        LParts := LParts + "write";
      end;
      // Only an accessor naming a field has a name place (its first token is read / write)
      LField := ATree[LChild].ResolvedDecl;
      if not ATree[LChild].NamePlace.IsNone() and (LField <> 0) then
        LParts := LParts + " " + ATree[LField].Text;
      end;
    end;
  end;
  if LFirst < 0 then
    return HeadingText(ADocument, AStart, false);
  end;
  LText := DoHeadingText(ADocument, AStart, LFirst, false);
  return LText + " " + LParts;
end;

// The heading of ADecl as a hover shows it (see the header); also adam --dev-docs'
public func DeclarationText(const ATree: ref SyntaxTree; const ADecl: int64;
  const ADocument: ref LSPDocument): string;
var
  LNode: ref Node;
  LStart: int64;
  LOwner: int64;
begin
  LNode := ATree[ADecl];
  match LNode.Kind of
    NodeKind.VarDecl:
      return "var " + LNode.Text + ": " + TypeText(ATree, LNode.ResolvedType);
    NodeKind.FieldDecl:
      if LNode.HasFlag(NodeFlag.Hidden) then
        return "hidden " + LNode.Text + ": " + TypeText(ATree, LNode.ResolvedType);
      end;
      return LNode.Text + ": " + TypeText(ATree, LNode.ResolvedType);
    NodeKind.Param:
      if LNode.HasFlag(NodeFlag.ConstParam) then
        return "const " + LNode.Text + ": " + TypeText(ATree, LNode.ResolvedType);
      end;
      if LNode.HasFlag(NodeFlag.VarParam) then
        return "var " + LNode.Text + ": " + TypeText(ATree, LNode.ResolvedType);
      end;
      return LNode.Text + ": " + TypeText(ATree, LNode.ResolvedType);
    NodeKind.EmbedDecl:
      return "embed " + LNode.Text + ": " + TypeText(ATree, LNode.ResolvedType);
    NodeKind.GenericParam:
      return LNode.Text;
    NodeKind.ChoiceValue:
      LOwner := ATree.ParentOf(ADecl);
      while (LOwner <> 0) and (ATree[LOwner].Kind <> NodeKind.TypeDecl) do
        LOwner := ATree.ParentOf(LOwner);
      end;
      if LOwner = 0 then
        return LNode.Text;
      end;
      return ATree[LOwner].Text + "." + LNode.Text;
  else
  end;
  if ADocument = nil then
    return Trim(LowerCase(NodeKindText(LNode.Kind)) + " " + LNode.Text);
  end;
  LStart := ADocument.OffsetOfPlace(int64(LNode.Place.Line), int64(LNode.Place.Column));
  if (LNode.Kind = NodeKind.TypeDecl) or (LNode.Kind = NodeKind.ForwardType) then
    return "type " + HeadingText(ADocument, LStart, true);
  end;
  // An extend's first line (`extend Vector2`, `extend List<T>`): its members follow it,
  // no ';' ends its heading; its place is its 'extend'
  if LNode.Kind = NodeKind.ExtendDecl then
    return HeadingText(ADocument, LStart, true);
  end;
  if LNode.Kind = NodeKind.ConstDecl then
    return "const " + HeadingText(ADocument, LStart, false);
  end;
  if LNode.Kind = NodeKind.PropertyDecl then
    return DoPropertyText(ATree, ADecl, ADocument, LStart);
  end;
  return HeadingText(ADocument, LStart, false);
end;

// The hover of the declaration ADecl of ATree asked in the file AFromPath, ADocument the text
// of the declaration's file (nil: none; see the header)
public func HoverMarkdown(const ATree: ref SyntaxTree; const ADecl: int64;
  const ADocument: ref LSPDocument; const AFromPath: string): string;
var
  LText: string;
  LDoc: string;
  LFile: string;
begin
  LText := ADAM_LSP_HOVER_FENCE + "\n" + DeclarationText(ATree, ADecl, ADocument) + "\n" +
    ADAM_LSP_HOVER_FENCE_END;
  LDoc := DocMarkdown(ATree[ADecl].DocText);
  if LDoc <> "" then
    LText := LText + "\n\n" + LDoc;
  end;
  // Declared in another file: its name
  LFile := ATree[ADecl].Place.FileName;
  if (LFile <> "") and not SamePath(LFile, AFromPath) then
    LText := LText + "\n\n*" + ExtractFileName(LFile) + "*";
  end;
  return LText;
end;

// A hover of a word the language defines: AHeading in an adam fence, ADoc, then AWhat
func DoWordMarkdown(const AHeading: string; const ADoc: string; const AWhat: string): string;
var
  LText: string;
begin
  LText := ADAM_LSP_HOVER_FENCE + "\n" + AHeading + "\n" + ADAM_LSP_HOVER_FENCE_END;
  if ADoc <> "" then
    LText := LText + "\n\n" + ADoc;
  end;
  return LText + "\n\n" + AWhat;
end;

// The hover of the intrinsic AIntrinsic (not None; see the header): its spelling and the
// arguments it takes (Signature; print / println, whose arguments follow their format: `(..)`)
public func IntrinsicHoverMarkdown(const AIntrinsic: Intrinsic): string;
var
  LRow: IntrinsicInfo;
  LArgs: string;
begin
  LRow := IntrinsicRow(AIntrinsic);
  LArgs := LRow.Signature;
  if LArgs = "" then
    LArgs := "(..)";
  end;
  return DoWordMarkdown(LRow.Spelling + LArgs, LRow.Doc, ADAM_LSP_HOVER_INTRINSIC);
end;

// The hover of the word the language defines at AOffset of ADocument (see the header): the
// Lexer's token there (one a cursor is in, else one it is just after) when it is a keyword, a
// directive or, when AFree (no name of the check claims it), a context word; its Markdown
// into AMarkdown, its bytes into [AStart, AEnd); false when it is none of them
public func WordHoverMarkdown(const ADocument: ref LSPDocument; const AOffset: int64;
  const AFree: bool; var AMarkdown: string; var AStart: int64; var AEnd: int64): bool;
var
  LSource: ref SourceText;
  LScratch: ref Diagnostics;
  LLexer: ref Lexer;
  LTokens: TokenList;
  LToken: ref Token;
  LFound: ref Token;
  LI: int64;
  LDirective: Directive;
  LWord: ContextWord;
  LWhat: string;
begin
  LSource := ref SourceText(ADocument.Path, ADocument.Text);
  LScratch := ref Diagnostics(ADAM_LSP_HOVER_BUDGET);
  LLexer := ref Lexer(LSource, LScratch);
  LTokens := LLexer.ReadAll();
  LFound := nil;
  for LI := 0 to LTokens.Count - 1 do
    LToken := LTokens[LI];
    if (LToken.Kind = TokenKind.EndOfFile) or (LToken.StartOffset > AOffset) then
      leave;
    end;
    // The token the cursor is in wins over the one it is just after
    if AOffset < LToken.EndOffset then
      LFound := LToken;
      leave;
    end;
    if AOffset = LToken.EndOffset then
      LFound := LToken;
    end;
  end;
  if LFound = nil then
    return false;
  end;
  AStart := LFound.StartOffset;
  AEnd := LFound.EndOffset;
  if IsKeywordKind(LFound.Kind) then
    LWhat := ADAM_LSP_HOVER_KEYWORD;
    if IsTypeWordKind(LFound.Kind) then
      LWhat := ADAM_LSP_HOVER_TYPE_WORD;
    end;
    AMarkdown := DoWordMarkdown(KindText(LFound.Kind), KeywordDoc(LFound.Kind), LWhat);
    return true;
  end;
  if LFound.Kind = TokenKind.Directive then
    if not DirectiveOf(LFound.Text, LDirective) then
      return false;
    end;
    AMarkdown := DoWordMarkdown(DirectiveText(LDirective), DirectiveRow(LDirective).Doc,
      ADAM_LSP_HOVER_DIRECTIVE);
    return true;
  end;
  if AFree and (LFound.Kind = TokenKind.Identifier) then
    for LWord := ContextWord.Abstract to ContextWord.Yield do
      if IsContextWord(LFound.Text, LWord) then
        AMarkdown := DoWordMarkdown(ContextWordText(LWord), ContextWordDoc(LWord),
          ADAM_LSP_HOVER_CONTEXT_WORD);
        return true;
      end;
    end;
  end;
  return false;
end;

end.
