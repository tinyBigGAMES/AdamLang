-------------------------------------------------------------------------------
  Adam.CImport.LayoutProbe.adam - `adam cimport`'s layout proof (M9g; DESIGN
  sec 15): the C file that checks a `.C` unit's records against the headers

  WriteLayoutProbe writes <unit>.layout.c's text from the AST of the unit
  adam cimport wrote, checked by Adam's own front end (Compiler.CheckUnit):
  for every struct and union the writer bound with its body
  (CUnitWriter.Probes), _Static_assert of its size, its alignment and each
  byte field's offset (anonymous members' fields through them; a bitfield
  has no offsetof) as Adam lays the record out on the target. The file
  includes the spec's headers after its defines and undefines, as the import
  read them, so a C compiler given the spec's include folders and the
  target's system headers (scripts\adam\m9_layout.cmd: zig cc
  -c -target <triple>, dev-side only, never a test's tool) stops
  at the first record Adam lays out another way. A record or field the
  unit does not hold (a writer fault) is a _Static_assert(0, ..) naming it:
  the proof fails, never passes in silence. The text is deterministic: no
  time, no path of the machine, the unit's order.
*******************************************************************************/

module unit Adam.CImport.LayoutProbe;

import System.SysUtils, Adam.Core.Common, Adam.Core.Containers, Adam.Target, Adam.Compiler.AST,
  Adam.Compiler.SourceText, Adam.Compiler.Scopes, Adam.Compiler.Types, Adam.Compiler.Layout,
  Adam.CImport.Spec, Adam.CImport.Writer;

// The field AName of the body (or anonymous part) ABody, through its anonymous parts (a
// field's ResolvedOffset is from the start of the named type, as offsetof reads it); 0 when
// it has none
func DoFieldIn(const ATree: ref SyntaxTree; const ABody: int64; const AName: string): int64;
var
  LI: int64;
  LMember: int64;
  LKind: NodeKind;
  LFound: int64;
begin
  for LI := 0 to ATree.CountOf(ABody, NodeRole.Member) - 1 do
    LMember := ATree.NthOf(ABody, NodeRole.Member, LI);
    LKind := ATree[LMember].Kind;
    if (LKind = NodeKind.FieldDecl) and (ATree[LMember].Text = AName) and
      not IsUnnamedField(ATree, LMember) then
      return LMember;
    end;
    if (LKind = NodeKind.AnonRecord) or (LKind = NodeKind.AnonOverlay) then
      LFound := DoFieldIn(ATree, LMember, AName);
      if LFound <> 0 then
        return LFound;
      end;
    end;
  end;
  return 0;
end;

// The type declaration of the unit AModule named AName that has a body (a record declared
// `forward type` first has two declarations: the forward one has none); 0 when none
func DoTypeNamed(const ATree: ref SyntaxTree; const AModule: int64; const AName: string): int64;
var
  LI: int64;
  LDecl: int64;
begin
  for LI := 0 to ATree.CountOf(AModule, NodeRole.Declaration) - 1 do
    LDecl := ATree.NthOf(AModule, NodeRole.Declaration, LI);
    if (ATree[LDecl].Kind = NodeKind.TypeDecl) and (ATree[LDecl].Text = AName) and
      (BodyOf(ATree, LDecl) <> 0) then
      return LDecl;
    end;
  end;
  return 0;
end;

// One _Static_assert line: ACondition, its message AWhat
func DoAssert(const ACondition: string; const AWhat: string): string;
begin
  return "_Static_assert(" + ACondition + ", \"" + AWhat + "\");\n";
end;

// The checks of the record AProbe: its size, its alignment and each byte field's offset as
// ATarget lays out the Adam type the unit AModule gives it
func DoRecordChecks(const ATree: ref SyntaxTree; const ATarget: ref Target;
  const AModule: int64; const AProbe: ProbeRecord): string;
var
  LDecl: int64;
  LBody: int64;
  LField: int64;
  LSize: int64;
  LAlign: int64;
  LText: ref TextBuilder;
  LI: int64;
begin
  LDecl := DoTypeNamed(ATree, AModule, AProbe.AdamName);
  LBody := BodyOf(ATree, LDecl);
  LSize := -1;
  LAlign := -1;
  if LBody <> 0 then
    LSize := TypeSize(ATree, ATarget, LDecl);
    LAlign := TypeAlign(ATree, ATarget, LDecl);
  end;
  if (LBody = 0) or (LSize < 0) or (LAlign <= 0) then
    return DoAssert("0", AProbe.AdamName + ": not laid out in the Adam unit");
  end;
  LText := ref TextBuilder();
  LText.Add(DoAssert("sizeof(" + AProbe.CSpelling + ") == " + IntToStr(LSize),
    AProbe.AdamName + ": Adam's size"));
  LText.Add(DoAssert("_Alignof(" + AProbe.CSpelling + ") == " + IntToStr(LAlign),
    AProbe.AdamName + ": Adam's alignment"));
  for LI := 0 to len(AProbe.CFields) - 1 do
    LField := DoFieldIn(ATree, LBody, AProbe.AdamFields[LI]);
    if LField = 0 then
      LText.Add(DoAssert("0", AProbe.AdamName + "." + AProbe.AdamFields[LI] +
        ": not in the Adam unit"));
      skip;
    end;
    LText.Add(DoAssert("offsetof(" + AProbe.CSpelling + ", " + AProbe.CFields[LI] + ") == " +
      IntToStr(ATree[LField].ResolvedOffset), AProbe.AdamName + "." + AProbe.AdamFields[LI] +
      ": Adam's offset"));
  end;
  return LText.Text();
end;

// <unit>.layout.c's text (see the header): the unit AModule of ATree, checked for ATriple,
// written from ASpec, its bound records AProbes
public func WriteLayoutProbe(const ATree: ref SyntaxTree; const ATarget: ref Target;
  const AModule: int64; const ASpec: ref ImportSpec; const ATriple: string;
  const AProbes: ProbeRecordArray): string;
var
  LOut: ref TextBuilder;
  LDefines: SpecDefineArray;
  LUndefines: StringArray;
  LI: int64;
begin
  LOut := ref TextBuilder();
  // the header in // lines (C99), as the unit's own: no */ to end a comment it is quoted in
  LOut.Add("// " + ASpec.UnitName + ADAM_EXT_LAYOUT_PROBE + " - written by adam cimport for " +
    ATriple + "\n// from " + ExtractFileName(ForwardSlashes(ASpec.FileName)) +
    ": the layout proof of " + ASpec.UnitName + ",\n" +
    "// every record it binds as Adam lays it out. Compile it only\n" +
    "// (zig cc -c -target " + ATriple + ", the spec's include folders as -I):\n" +
    "// a record C lays out another way stops at its _Static_assert. Do not edit.\n\n");
  LDefines := ASpec.DefinesFor(ATriple);
  for LI := 0 to len(LDefines) - 1 do
    LOut.Add("#define " + LDefines[LI].Name + " " + LDefines[LI].Value + "\n");
  end;
  LUndefines := ASpec.UndefinesFor(ATriple);
  for LI := 0 to len(LUndefines) - 1 do
    LOut.Add("#undef " + LUndefines[LI] + "\n");
  end;
  for LI := 0 to len(ASpec.Headers) - 1 do
    LOut.Add("#include <" + ASpec.Headers[LI].Text + ">\n");
  end;
  // offsetof, after the spec's own headers (they are read as the import read them)
  LOut.Add("#include <stddef" + ADAM_EXT_C_HEADER + ">\n");
  for LI := 0 to len(AProbes) - 1 do
    LOut.Add("\n" + DoRecordChecks(ATree, ATarget, AModule, AProbes[LI]));
  end;
  return LOut.Text();
end;

end.
