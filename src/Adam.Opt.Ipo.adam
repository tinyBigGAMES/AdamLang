-------------------------------------------------------------------------------
  Adam.Opt.Ipo.adam - interprocedural optimization (PLAN-ADAM M6 O17)

  The passes that change more than one function: run by OptimizeModule
  (Adam.Opt.Pipeline) once every function went through the level's list,
  over the whole module (one unit: its internal functions are its object's
  alone, so every reference to one is in this module).

  A function is CALL-ONLY when nothing but its direct calls reach it: it is
  defined and internal, no funclet, not variadic, not the entry, the frame
  handler or the thread callback, no scope's handler, its address never
  taken (no CodeAddress), its symbol in no data blob's address word. Only a
  call-only function's signature may change: every caller is in sight.

  OptimizeInterprocedural, one round:
    merge (small)    call-only functions with no scopes whose bodies are
                     equal instruction for instruction (operands and
                     targets at the same places, a self call matching a
                     self call) and whose signatures and noreturn agree:
                     the calls of the later one call the earlier one (no
                     address is taken, so no routine value can tell)
    constant args    a parameter every call passes the same constant (one
                     type, one value) becomes that constant in the body
    dead args        a parameter no instruction of the body uses (the
                     constant ones among them) leaves the signature and
                     every call's operands; the others are renumbered
    unused results   a result no call uses: the function returns nothing
                     (its rets lose their value, its calls are void)
                     (never a result place's: its callers read the place)
    removal          what no root reaches goes (DropUnreferenced)
  It returns the functions it changed that still have code, ascending:
  OptimizeModule runs its cleanup passes over them (the constants folded,
  the arguments callers no longer pass left dead for adce) and calls it
  again, a few rounds at most.

  DropUnreferenced: the roots are every defined function that is not
  internal, the entry, the frame handler, the thread callback and every
  function a data blob's address word names; a reached function reaches
  the functions it calls, takes the address of, or has as a scope's
  handler (its funclets, its filters). Every other defined function is
  dropped as Lowering drops a body copy it cannot use: declared, no blocks,
  no scopes, no parent (so VerifyFunction never meets it as a funclet);
  that takes the internal body copies of other units' routines once the
  inliner is done with them, and the funclet of a guard simplifycfg
  dropped (his OK 2026-11-11). Generate makes nothing for them.
*******************************************************************************/

module unit Adam.Opt.Ipo;

import System.SysUtils, Adam.Core.Common, Adam.Core.Containers, Adam.Backend.Ssa;

public const
  // The most look-alike functions (same signature, block and instruction counts) one
  // bucket compares a function against (merge, small): a body is compared with each
  ADAM_IPO_MERGE_BUCKET: int64 = 16;

// Removal (see the header): every defined function no root reaches dropped (declared, no
// blocks, no scopes, no parent), a declared function's body copy among them no longer
// its InlineBody; true when one was
public func DropUnreferenced(const AModule: ref IrModule): bool;
var
  LFunction: ref IrFunction;
  LBlock: ref IrBlock;
  LInstr: ref IrInstr;
  LNamed: ref StringIdMap;
  LData: ref IrData;
  LWork: ref Int64List;
  LLive: BoolArray;
  LChanged: bool;
  LAt: int64;
  LF: int64;
  LD: int64;
  LB: int64;
  LK: int64;
begin
  LNamed := ref StringIdMap(0);
  for LD := 1 to AModule.DataCount - 1 do
    LData := AModule.DataAt(LD);
    for LK := 0 to LData.AddressCount - 1 do
      LNamed.Put(LData.AddressSymbol(LK), 1);
    end;
  end;
  setlength(LLive, AModule.FunctionCount);
  LWork := ref Int64List();
  for LF := 1 to AModule.FunctionCount - 1 do
    LFunction := AModule.FunctionAt(LF);
    if LFunction.Declared then
      skip;
    end;
    if (not LFunction.Internal) or (LF = AModule.Entry) or (LF = AModule.FrameHandler) or
      (LF = AModule.ThreadCallback) or (LNamed.Find(LFunction.Symbol) <> 0) then
      LLive[LF] := true;
      LWork.Add(LF);
    end;
  end;
  // what a reached function calls, takes the address of, or has as a scope's handler
  LAt := 0;
  while LAt < LWork.Count do
    LFunction := AModule.FunctionAt(LWork[LAt]);
    LAt := LAt + 1;
    for LK := 0 to LFunction.ScopeCount() - 1 do
      LF := LFunction.ScopeHandler(LK);
      if AModule.IsFunction(LF) and not LLive[LF] then
        LLive[LF] := true;
        LWork.Add(LF);
      end;
    end;
    for LB := 0 to LFunction.Blocks.Count - 1 do
      LBlock := AModule.BlockAt(LFunction.Blocks[LB]);
      for LK := 0 to LBlock.Instrs.Count - 1 do
        LInstr := AModule.InstrAt(LBlock.Instrs[LK]);
        if ((LInstr.Kind = IrOp.Call) or (LInstr.Kind = IrOp.CodeAddress)) and
          AModule.IsFunction(LInstr.Link) then
          if not LLive[LInstr.Link] then
            LLive[LInstr.Link] := true;
            LWork.Add(LInstr.Link);
          end;
        end;
      end;
    end;
  end;
  LChanged := false;
  for LF := 1 to AModule.FunctionCount - 1 do
    LFunction := AModule.FunctionAt(LF);
    if LFunction.Declared or LLive[LF] then
      skip;
    end;
    LFunction.Declared := true;
    LFunction.Blocks := ref Int64List();
    LFunction.ClearScopes();
    AModule.SetParent(LF, 0);
    LFunction.FrameValue := 0;
    LFunction.InlineBody := 0;
    LChanged := true;
  end;
  // a body copy dropped is no declared function's InlineBody any more
  for LF := 1 to AModule.FunctionCount - 1 do
    LFunction := AModule.FunctionAt(LF);
    if (LFunction.InlineBody <> 0) and AModule.FunctionAt(LFunction.InlineBody).Declared then
      LFunction.InlineBody := 0;
    end;
  end;
  return LChanged;
end;

type
  // One round over one module (see the header)
  IpoRun = object
    hidden FModule: ref IrModule;
    hidden FLevel: OptLevel;
    // Every instruction of a defined function that is some instruction's operand
    hidden FUsed: BoolArray;
    // Per function id: the direct calls of it (instruction ids), in module order
    hidden FSites: array of ref Int64List;
    // Per function id: reached by its direct calls alone (see the header)
    hidden FCallOnly: BoolArray;
    // Per function id: changed by this round
    hidden FTouched: BoolArray;
    // The symbols data blobs' address words name (a function named there is a root)
    hidden FNamed: ref StringIdMap;

    init(const AModule: ref IrModule; const ALevel: OptLevel);
    var
      LData: ref IrData;
      LD: int64;
      LA: int64;
    begin
      self.FModule := AModule;
      self.FLevel := ALevel;
      self.FNamed := ref StringIdMap(0);
      for LD := 1 to AModule.DataCount - 1 do
        LData := AModule.DataAt(LD);
        for LA := 0 to LData.AddressCount - 1 do
          self.FNamed.Put(LData.AddressSymbol(LA), 1);
        end;
      end;
      setlength(self.FTouched, AModule.FunctionCount);
    end;

    // True when AFunction is a root of the module (see the header): code another object,
    // the OS or a data blob may reach
    hidden const method DoIsRoot(const AFunction: int64): bool;
    var
      LFunction: ref IrFunction;
    begin
      LFunction := self.FModule.FunctionAt(AFunction);
      if LFunction.Declared then
        return false;
      end;
      if not LFunction.Internal then
        return true;
      end;
      if (AFunction = self.FModule.Entry) or (AFunction = self.FModule.FrameHandler) or
        (AFunction = self.FModule.ThreadCallback) then
        return true;
      end;
      return self.FNamed.Find(LFunction.Symbol) <> 0;
    end;

    // The use marks, the call sites and the call-only marks, from the module as it stands
    hidden method DoCollect();
    var
      LFunction: ref IrFunction;
      LBlock: ref IrBlock;
      LInstr: ref IrInstr;
      LCount: int64;
      LHandler: int64;
      LF: int64;
      LB: int64;
      LK: int64;
      LO: int64;
    begin
      LCount := self.FModule.FunctionCount;
      setlength(self.FUsed, 0);
      setlength(self.FUsed, self.FModule.InstrCount);
      setlength(self.FSites, 0);
      setlength(self.FSites, LCount);
      setlength(self.FCallOnly, 0);
      setlength(self.FCallOnly, LCount);
      for LF := 1 to LCount - 1 do
        LFunction := self.FModule.FunctionAt(LF);
        self.FSites[LF] := ref Int64List();
        self.FCallOnly[LF] := (not LFunction.Declared) and (LFunction.Parent = 0) and
          (not LFunction.Signature.Variadic) and (not self.DoIsRoot(LF));
      end;
      for LF := 1 to LCount - 1 do
        LFunction := self.FModule.FunctionAt(LF);
        if LFunction.Declared then
          skip;
        end;
        for LK := 0 to LFunction.ScopeCount() - 1 do
          LHandler := LFunction.ScopeHandler(LK);
          if self.FModule.IsFunction(LHandler) then
            self.FCallOnly[LHandler] := false;
          end;
        end;
        for LB := 0 to LFunction.Blocks.Count - 1 do
          LBlock := self.FModule.BlockAt(LFunction.Blocks[LB]);
          for LK := 0 to LBlock.Instrs.Count - 1 do
            LInstr := self.FModule.InstrAt(LBlock.Instrs[LK]);
            for LO := 0 to LInstr.Operands.Count - 1 do
              if self.FModule.IsInstr(LInstr.Operands[LO]) then
                self.FUsed[LInstr.Operands[LO]] := true;
              end;
            end;
            if (LInstr.Kind = IrOp.Call) and self.FModule.IsFunction(LInstr.Link) then
              self.FSites[LInstr.Link].Add(LBlock.Instrs[LK]);
            end;
            if (LInstr.Kind = IrOp.CodeAddress) and self.FModule.IsFunction(LInstr.Link) then
              self.FCallOnly[LInstr.Link] := false;
            end;
          end;
        end;
      end;
    end;

    // The function AId's call (an instruction) is in changed
    hidden method DoTouchCaller(const AId: int64);
    begin
      self.FTouched[self.FModule.BlockAt(self.FModule.InstrAt(AId).Block).Owner] := true;
    end;

    // True when AFunction is call-only, defined and has at least one call
    hidden const method DoHasCallers(const AFunction: int64): bool;
    begin
      return self.FCallOnly[AFunction] and (self.FSites[AFunction].Count > 0);
    end;

    // How many instructions AFunction's blocks hold
    hidden const method DoInstrCount(const AFunction: int64): int64;
    var
      LFunction: ref IrFunction;
      LCount: int64;
      LB: int64;
    begin
      LFunction := self.FModule.FunctionAt(AFunction);
      LCount := 0;
      for LB := 0 to LFunction.Blocks.Count - 1 do
        LCount := LCount + self.FModule.BlockAt(LFunction.Blocks[LB]).Instrs.Count;
      end;
      return LCount;
    end;

    // True when the operand AOperandA of AFunctionA and AOperandB of AFunctionB stand at
    // the same place (AOrderA / AOrderB: each instruction's place in its function, -1:
    // not its); one outside both is the same instruction
    hidden const method DoSameOperand(const AOperandA: int64; const AOperandB: int64;
      const AOrderA: ref Int64Map; const AOrderB: ref Int64Map): bool;
    var
      LPlaceA: int64;
      LPlaceB: int64;
    begin
      LPlaceA := AOrderA.Find(AOperandA);
      LPlaceB := AOrderB.Find(AOperandB);
      if (LPlaceA < 0) or (LPlaceB < 0) then
        return (LPlaceA < 0) and (LPlaceB < 0) and (AOperandA = AOperandB);
      end;
      return LPlaceA = LPlaceB;
    end;

    // True when instruction AIdA of AFunctionA does what AIdB of AFunctionB does: one kind,
    // type, immediate, alignment, predicate and tail mark, operands and targets at the
    // same places (AOrderA / AOrderB, ABlocksA / ABlocksB: block positions), the same
    // link (a function's call or address of itself matching the other's of itself)
    hidden const method DoSameInstr(const AFunctionA: int64; const AIdA: int64;
      const AFunctionB: int64; const AIdB: int64; const AOrderA: ref Int64Map;
      const AOrderB: ref Int64Map; const ABlocksA: ref Int64Map;
      const ABlocksB: ref Int64Map): bool;
    var
      LA: ref IrInstr;
      LB: ref IrInstr;
      LK: int64;
    begin
      LA := self.FModule.InstrAt(AIdA);
      LB := self.FModule.InstrAt(AIdB);
      if (LA.Kind <> LB.Kind) or (LA.ValueType <> LB.ValueType) or (LA.Imm <> LB.Imm) or
        (LA.Align <> LB.Align) or (LA.Predicate <> LB.Predicate) or (LA.Tail <> LB.Tail) then
        return false;
      end;
      if (LA.Operands.Count <> LB.Operands.Count) or (LA.Targets.Count <> LB.Targets.Count) then
        return false;
      end;
      if LA.Link <> LB.Link then
        if not (((LA.Kind = IrOp.Call) or (LA.Kind = IrOp.CodeAddress)) and
          (LA.Link = AFunctionA) and (LB.Link = AFunctionB)) then
          return false;
        end;
      end;
      for LK := 0 to LA.Operands.Count - 1 do
        if not self.DoSameOperand(LA.Operands[LK], LB.Operands[LK], AOrderA, AOrderB) then
          return false;
        end;
      end;
      for LK := 0 to LA.Targets.Count - 1 do
        if ABlocksA.Find(LA.Targets[LK]) <> ABlocksB.Find(LB.Targets[LK]) then
          return false;
        end;
      end;
      return true;
    end;

    // AOrder: each instruction of AFunction its place (in block order), ABlocks: each
    // block its position
    hidden const method DoPlaces(const AFunction: int64; const AOrder: ref Int64Map;
      const ABlocks: ref Int64Map);
    var
      LFunction: ref IrFunction;
      LBlock: ref IrBlock;
      LPlace: int64;
      LB: int64;
      LK: int64;
    begin
      LFunction := self.FModule.FunctionAt(AFunction);
      LPlace := 0;
      for LB := 0 to LFunction.Blocks.Count - 1 do
        ABlocks.Put(LFunction.Blocks[LB], LB);
        LBlock := self.FModule.BlockAt(LFunction.Blocks[LB]);
        for LK := 0 to LBlock.Instrs.Count - 1 do
          AOrder.Put(LBlock.Instrs[LK], LPlace);
          LPlace := LPlace + 1;
        end;
      end;
    end;

    // True when AFunctionA and AFunctionB (one signature, one block and instruction
    // count: their bucket's) have equal bodies, instruction for instruction
    hidden const method DoSameBody(const AFunctionA: int64; const AFunctionB: int64): bool;
    var
      LFunctionA: ref IrFunction;
      LFunctionB: ref IrFunction;
      LBlockA: ref IrBlock;
      LBlockB: ref IrBlock;
      LOrderA: ref Int64Map;
      LOrderB: ref Int64Map;
      LBlocksA: ref Int64Map;
      LBlocksB: ref Int64Map;
      LB: int64;
      LK: int64;
    begin
      LFunctionA := self.FModule.FunctionAt(AFunctionA);
      LFunctionB := self.FModule.FunctionAt(AFunctionB);
      if (LFunctionA.Blocks.Count <> LFunctionB.Blocks.Count) or
        (LFunctionA.NoReturn <> LFunctionB.NoReturn) or
        (LFunctionA.Signature.Text() <> LFunctionB.Signature.Text()) then
        return false;
      end;
      for LB := 0 to LFunctionA.Blocks.Count - 1 do
        if self.FModule.BlockAt(LFunctionA.Blocks[LB]).Instrs.Count <>
          self.FModule.BlockAt(LFunctionB.Blocks[LB]).Instrs.Count then
          return false;
        end;
      end;
      LOrderA := ref Int64Map(-1);
      LOrderB := ref Int64Map(-1);
      LBlocksA := ref Int64Map(-1);
      LBlocksB := ref Int64Map(-1);
      self.DoPlaces(AFunctionA, LOrderA, LBlocksA);
      self.DoPlaces(AFunctionB, LOrderB, LBlocksB);
      for LB := 0 to LFunctionA.Blocks.Count - 1 do
        LBlockA := self.FModule.BlockAt(LFunctionA.Blocks[LB]);
        LBlockB := self.FModule.BlockAt(LFunctionB.Blocks[LB]);
        for LK := 0 to LBlockA.Instrs.Count - 1 do
          if not self.DoSameInstr(AFunctionA, LBlockA.Instrs[LK], AFunctionB,
            LBlockB.Instrs[LK], LOrderA, LOrderB, LBlocksA, LBlocksB) then
            return false;
          end;
        end;
      end;
      return true;
    end;

    // Every call of AFrom calls ATo instead (AFrom then has none: removal takes it)
    hidden method DoRedirect(const AFrom: int64; const ATo: int64);
    var
      LSites: ref Int64List;
      LK: int64;
    begin
      LSites := self.FSites[AFrom];
      for LK := 0 to LSites.Count - 1 do
        self.FModule.InstrAt(LSites[LK]).Link := ATo;
        self.FSites[ATo].Add(LSites[LK]);
      end;
      self.FSites[AFrom] := ref Int64List();
    end;

    // Merge (small): each call-only function with no scopes whose body equals an earlier
    // one's in its bucket is called as that one; true when one was
    hidden method DoMerge(): bool;
    var
      LBuckets: ref StringIdMap;
      LLists: array of ref Int64List;
      LList: ref Int64List;
      LFunction: ref IrFunction;
      LKey: string;
      LAt: int64;
      LKept: int64;
      LChanged: bool;
      LF: int64;
      LK: int64;
    begin
      LChanged := false;
      LBuckets := ref StringIdMap(0);
      setlength(LLists, 0);
      for LF := 1 to self.FModule.FunctionCount - 1 do
        LFunction := self.FModule.FunctionAt(LF);
        if (not self.DoHasCallers(LF)) or (LFunction.ScopeCount() > 0) then
          skip;
        end;
        LKey := LFunction.Signature.Text() + "|" + IntToStr(LFunction.Blocks.Count) + "|" +
          IntToStr(self.DoInstrCount(LF));
        LAt := LBuckets.Find(LKey);
        if LAt = 0 then
          setlength(LLists, len(LLists) + 1);
          LLists[len(LLists) - 1] := ref Int64List();
          LAt := len(LLists);
          LBuckets.Put(LKey, LAt);
        end;
        LList := LLists[LAt - 1];
        LKept := 0;
        for LK := 0 to LList.Count - 1 do
          if self.DoSameBody(LList[LK], LF) then
            LKept := LList[LK];
            leave;
          end;
        end;
        if LKept <> 0 then
          self.DoRedirect(LF, LKept);
          LChanged := true;
        else
          if LList.Count < ADAM_IPO_MERGE_BUCKET then
            LList.Add(LF);
          end;
        end;
      end;
      return LChanged;
    end;

    // Constant args: each parameter of a call-only function every call passes the same
    // constant (one type, one value) made that constant in the body (its parameter
    // instructions become the constant in place); true when one was
    hidden method DoConstantArgs(): bool;
    var
      LFunction: ref IrFunction;
      LEntry: ref IrBlock;
      LSites: ref Int64List;
      LFirst: ref IrInstr;
      LArg: ref IrInstr;
      LInstr: ref IrInstr;
      LSame: bool;
      LChanged: bool;
      LF: int64;
      LP: int64;
      LK: int64;
    begin
      LChanged := false;
      for LF := 1 to self.FModule.FunctionCount - 1 do
        if not self.DoHasCallers(LF) then
          skip;
        end;
        LFunction := self.FModule.FunctionAt(LF);
        LSites := self.FSites[LF];
        LEntry := self.FModule.BlockAt(LFunction.Blocks[0]);
        for LP := 0 to LFunction.Signature.ParamCount - 1 do
          LFirst := self.FModule.InstrAt(self.FModule.InstrAt(LSites[0]).Operands[LP]);
          if LFirst.Kind <> IrOp.Constant then
            skip;
          end;
          LSame := true;
          for LK := 1 to LSites.Count - 1 do
            LArg := self.FModule.InstrAt(self.FModule.InstrAt(LSites[LK]).Operands[LP]);
            if (LArg.Kind <> IrOp.Constant) or (LArg.ValueType <> LFirst.ValueType) or
              (LArg.Imm <> LFirst.Imm) then
              LSame := false;
              leave;
            end;
          end;
          if not LSame then
            skip;
          end;
          for LK := 0 to LEntry.Instrs.Count - 1 do
            LInstr := self.FModule.InstrAt(LEntry.Instrs[LK]);
            if (LInstr.Kind = IrOp.Parameter) and (LInstr.Imm = LP) then
              LInstr.Kind := IrOp.Constant;
              LInstr.Imm := LFirst.Imm;
              self.FTouched[LF] := true;
              LChanged := true;
            end;
          end;
        end;
      end;
      return LChanged;
    end;

    // Dead args: each parameter of a call-only function no instruction of its body uses
    // (none left: a constant one) out of its signature and every call's operands, the
    // others renumbered; true when one went
    hidden method DoDeadArgs(): bool;
    var
      LFunction: ref IrFunction;
      LEntry: ref IrBlock;
      LInstr: ref IrInstr;
      LCall: ref IrInstr;
      LSignature: ref IrSignature;
      LInstrs: ref Int64List;
      LOperands: ref Int64List;
      LKeep: BoolArray;
      LNewIndex: Int64Array;
      LCount: int64;
      LKept: int64;
      LChanged: bool;
      LF: int64;
      LP: int64;
      LK: int64;
    begin
      LChanged := false;
      for LF := 1 to self.FModule.FunctionCount - 1 do
        if not self.DoHasCallers(LF) then
          skip;
        end;
        LFunction := self.FModule.FunctionAt(LF);
        LCount := LFunction.Signature.ParamCount;
        if LCount = 0 then
          skip;
        end;
        LEntry := self.FModule.BlockAt(LFunction.Blocks[0]);
        setlength(LKeep, 0);
        setlength(LKeep, LCount);
        for LK := 0 to LEntry.Instrs.Count - 1 do
          LInstr := self.FModule.InstrAt(LEntry.Instrs[LK]);
          if (LInstr.Kind = IrOp.Parameter) and self.FUsed[LEntry.Instrs[LK]] then
            LKeep[LInstr.Imm] := true;
          end;
        end;
        // a result's place stays parameter 0 (IrSignature.ResultPlace: the ABI reads it)
        if LFunction.Signature.ResultPlace then
          LKeep[0] := true;
        end;
        // the kept ones' new indexes and the new signature (each its type and aggregate)
        setlength(LNewIndex, LCount);
        LSignature := ref IrSignature(LFunction.Signature.ResultType);
        LSignature.ResultPlace := LFunction.Signature.ResultPlace;
        LKept := 0;
        for LP := 0 to LCount - 1 do
          LNewIndex[LP] := -1;
          if LKeep[LP] then
            LNewIndex[LP] := LKept;
            LSignature.AddParamFrom(LFunction.Signature, LP);
            LKept := LKept + 1;
          end;
        end;
        if LKept = LCount then
          skip;
        end;
        LFunction.Signature := LSignature;
        // the entry block without the dropped parameters' instructions (none has a use)
        LInstrs := ref Int64List();
        for LK := 0 to LEntry.Instrs.Count - 1 do
          LInstr := self.FModule.InstrAt(LEntry.Instrs[LK]);
          if LInstr.Kind = IrOp.Parameter then
            if not LKeep[LInstr.Imm] then
              skip;
            end;
            LInstr.Imm := LNewIndex[LInstr.Imm];
          end;
          LInstrs.Add(LEntry.Instrs[LK]);
        end;
        LEntry.Instrs := LInstrs;
        // every call without the dropped arguments
        for LK := 0 to self.FSites[LF].Count - 1 do
          LCall := self.FModule.InstrAt(self.FSites[LF][LK]);
          LOperands := ref Int64List();
          for LP := 0 to LCount - 1 do
            if LKeep[LP] then
              LOperands.Add(LCall.Operands[LP]);
            end;
          end;
          LCall.Operands := LOperands;
          self.DoTouchCaller(self.FSites[LF][LK]);
        end;
        self.FTouched[LF] := true;
        LChanged := true;
      end;
      return LChanged;
    end;

    // Unused results: a call-only function whose result no call uses returns nothing (its
    // rets lose their value, its calls are void); true when one did
    hidden method DoUnusedResults(): bool;
    var
      LFunction: ref IrFunction;
      LBlock: ref IrBlock;
      LRet: ref IrInstr;
      LSites: ref Int64List;
      LUsed: bool;
      LChanged: bool;
      LF: int64;
      LK: int64;
    begin
      LChanged := false;
      for LF := 1 to self.FModule.FunctionCount - 1 do
        if not self.DoHasCallers(LF) then
          skip;
        end;
        LFunction := self.FModule.FunctionAt(LF);
        if LFunction.Signature.ResultType = IrType.Void then
          skip;
        end;
        // a result place's function hands its place back (IrSignature.ResultPlace): its
        // callers read the result from the place they passed, never from the call's value,
        // and the ABI part takes the result from the address its rets return
        if LFunction.Signature.ResultPlace then
          skip;
        end;
        LSites := self.FSites[LF];
        LUsed := false;
        for LK := 0 to LSites.Count - 1 do
          if self.FUsed[LSites[LK]] then
            LUsed := true;
            leave;
          end;
        end;
        if LUsed then
          skip;
        end;
        LFunction.Signature.ResultType := IrType.Void;
        for LK := 0 to LFunction.Blocks.Count - 1 do
          LBlock := self.FModule.BlockAt(LFunction.Blocks[LK]);
          LRet := self.FModule.InstrAt(LBlock.Instrs[LBlock.Instrs.Count - 1]);
          if LRet.Kind = IrOp.Ret then
            LRet.Operands := ref Int64List();
          end;
        end;
        for LK := 0 to LSites.Count - 1 do
          self.FModule.InstrAt(LSites[LK]).ValueType := IrType.Void;
          self.DoTouchCaller(LSites[LK]);
        end;
        self.FTouched[LF] := true;
        LChanged := true;
      end;
      return LChanged;
    end;

    // The round (see the header); the functions it changed that still have code, ascending
    method Run(): ref Int64List;
    var
      LTouched: ref Int64List;
      LF: int64;
    begin
      self.DoCollect();
      if self.FLevel = OptLevel.Small then
        if self.DoMerge() then
          self.DoCollect();
        end;
      end;
      // constant args before dead args: a parameter made constant is then one no
      // instruction uses (the use marks are of the instructions, not the parameters)
      self.DoConstantArgs();
      self.DoDeadArgs();
      self.DoUnusedResults();
      DropUnreferenced(self.FModule);
      LTouched := ref Int64List();
      for LF := 1 to self.FModule.FunctionCount - 1 do
        if self.FTouched[LF] and not self.FModule.FunctionAt(LF).Declared then
          LTouched.Add(LF);
        end;
      end;
      return LTouched;
    end;
  end;

// One interprocedural round over AModule at ALevel (see the header): merge (small),
// constant args, dead args, unused results, removal; the functions it changed that still
// have code, ascending (OptimizeModule's cleanup passes run over them)
public func OptimizeInterprocedural(const AModule: ref IrModule;
  const ALevel: OptLevel): ref Int64List;
var
  LRun: ref IpoRun;
begin
  LRun := ref IpoRun(AModule, ALevel);
  return LRun.Run();
end;

end.
