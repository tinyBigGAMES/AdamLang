-------------------------------------------------------------------------------
  Adam.Coff.Resources.adam - the resources a PE32+ image carries: the
  version resource, an icon, the .rsrc section that holds them (BNF sec 2)

  Every layout fact is Microsoft's: the "PE Format" page (The .rsrc
  Section: Resource Directory Table, Resource Directory Entries, Resource
  Directory String, Resource Data Entry), the Version Information
  structures (VS_VERSIONINFO, VS_FIXEDFILEINFO, StringFileInfo,
  StringTable, String, VarFileInfo, Var) and the icon file and group
  structures (ICONDIR / ICONDIRENTRY, GRPICONDIR / GRPICONDIRENTRY).

  ImageResource   one resource: its type id, its name (a text name, else an
                  id), its language, its bytes
  VersionResource the RT_VERSION resource of an ExeSettings: VS_VERSIONINFO
                  with its VS_FIXEDFILEINFO (file and product version
                  major.minor.patch.0, VOS_NT_WINDOWS32, VFT_APP or a
                  dll's VFT_DLL), one
                  StringTable 040904B0 (US English, UTF-16) holding
                  CompanyName, FileDescription, FileVersion, InternalName
                  (the file name without its extension), LegalCopyright,
                  OriginalFilename, ProductName, ProductVersion (pcpp's set
                  but its URL Comments, which Adam has no directive for), and
                  the VarFileInfo Translation 0x0409 / 1200; id 1, neutral
                  language
  IconResources   an .ico file's images as RT_ICON resources (ids 1..n, in
                  the file's order) and their RT_GROUP_ICON named MAINICON
                  (the name the shell takes as the exe's icon, pcpp's),
                  neutral language; IconFault says what keeps a file from
                  being one
  ResourceSection the .rsrc bytes of a resource list given in the
                  directory's order (by type id, then named before id, names
                  ascending, ids ascending): the type, name and language
                  directories, the name strings, the data entries, each
                  resource's bytes at 8; with the offsets of the data
                  entries' OffsetToData fields, which hold each resource's
                  offset in the section until the linker adds the section's
                  RVA (the field is an RVA)
  Raised (a compiler bug): a list out of the directory's order, a name that
  is no ASCII text.
*******************************************************************************/

module unit Adam.Coff.Resources;

import System.SysUtils, Adam.Backend.Parts, Adam.Coff.Spec;

public const
  // The resource types (winuser.h's RT_ICON, RT_GROUP_ICON, RT_VERSION), the neutral
  // language, the version resource's id, the icon group's name
  ADAM_RESOURCE_ICON_GROUP_NAME: string = "MAINICON";

const
  // A directory table's header, an entry, a data entry; an entry's high bit (a name string,
  // or a subdirectory); a resource's bytes aligned at
  ADAM_RESOURCE_TABLE_SIZE: int64 = 16;
  ADAM_RESOURCE_ENTRY_SIZE: int64 = 8;
  ADAM_RESOURCE_DATA_SIZE: int64 = 16;
  ADAM_RESOURCE_HIGH_BIT: int64 = 0x80000000;
  ADAM_RESOURCE_DATA_ALIGN: int64 = 8;
  // VS_FIXEDFILEINFO: its size, signature, structure version, flags mask, VOS_NT_WINDOWS32,
  // VFT_APP, VFT_DLL (M8c); a node's wType (binary data, text); the StringTable's key, the Translation pair
  ADAM_VERSION_FIXED_SIZE: int64 = 52;
  ADAM_VERSION_BINARY: int64 = 0;
  ADAM_VERSION_TEXT: int64 = 1;
  ADAM_VERSION_TABLE_KEY: string = "040904B0";
  ADAM_VERSION_LANGUAGE: int64 = 0x0409;
  ADAM_VERSION_CODEPAGE: int64 = 1200;
  ADAM_VERSION_ALIGN: int64 = 4;
  // ICONDIR (reserved, type 1, count), an ICONDIRENTRY, a GRPICONDIRENTRY
  ADAM_ICON_DIR_SIZE: int64 = 6;
  ADAM_ICON_ENTRY_SIZE: int64 = 16;
  ADAM_ICON_GROUP_ENTRY_SIZE: int64 = 14;
  ADAM_ICON_TYPE: int64 = 1;
  // Raised (see the header)
  ADAM_RESOURCE_FAULT_ORDER: string = "Resources: a resource out of the directory's order: ";
  ADAM_RESOURCE_FAULT_NAME: string = "Resources: a resource name that is no ASCII text: ";

public type
  // One resource (see the header): NameText "" for one named by NameId
  ImageResource = object
    TypeId: int64;
    NameId: int64;
    NameText: string;
    Language: int64;
    Bytes: ByteArray;

    init(const ATypeId: int64; const ANameId: int64; const ANameText: string;
      const ALanguage: int64; const ABytes: ByteArray);
    begin
      self.TypeId := ATypeId;
      self.NameId := ANameId;
      self.NameText := ANameText;
      self.Language := ALanguage;
      self.Bytes := ABytes;
    end;
  end;

  ImageResourceList = array of ref ImageResource;

  // What keeps an icon file from being one (None: it is): no ICONDIR (too short, a reserved
  // or type field that is not 0 / 1), no image (a count of 0), an entry or an image past the
  // file's end (or an image of no bytes)
  IconFault = choices(None, NoDirectory, NoImage, PastEnd);

// How many UTF-16 units AText is (a code point past the BMP two), its NUL not counted
routine WideUnits(const AText: string): int64;
var
  LIndex: int64;
  LCount: int64;
begin
  LIndex := 0;
  LCount := 0;
  while LIndex < len(AText) do
    if DecodeUtf8Char(AText, LIndex) >= 0x10000 then
      LCount := LCount + 2;
    else
      LCount := LCount + 1;
    end;
  end;
  return LCount;
end;

type
  // One VS_VERSIONINFO written in two passes (see VersionResource): the first (Writing false)
  // only counts its bytes, the second writes them into Bytes, sized by the first
  VersionWriter = object
    Bytes: ByteArray;
    At: int64;
    Writing: bool;

    init();
    begin
      self.At := 0;
      self.Writing := false;
    end;

    // The 16-bit AValue at At
    method PutWord(const AValue: int64);
    begin
      if self.Writing then
        PutLe(self.Bytes, self.At, uint64(AValue), 2);
      end;
      self.At := self.At + 2;
    end;

    // The 32-bit AValue at At
    method PutDword(const AValue: int64);
    begin
      if self.Writing then
        PutLe(self.Bytes, self.At, uint64(AValue), 4);
      end;
      self.At := self.At + 4;
    end;

    // AText as UTF-16 with its NUL at At
    method PutWide(const AText: string);
    var
      LIndex: int64;
      LCode: int64;
    begin
      LIndex := 0;
      while LIndex < len(AText) do
        LCode := int64(DecodeUtf8Char(AText, LIndex));
        if LCode >= 0x10000 then
          // A code point past the BMP: its surrogate pair, high first
          LCode := LCode - 0x10000;
          self.PutWord(0xD800 + (LCode shr 10));
          self.PutWord(0xDC00 + (LCode & 0x3FF));
        else
          self.PutWord(LCode);
        end;
      end;
      self.PutWord(0);
    end;

    // Zero bytes to the next 32-bit boundary from the resource's start
    method Align();
    begin
      while (self.At mod ADAM_VERSION_ALIGN) <> 0 do
        if self.Writing then
          self.Bytes[self.At] := 0;
        end;
        self.At := self.At + 1;
      end;
    end;

    // A node's header (wLength left 0 until EndNode, wValueLength AValueLength, wType AKind,
    // szKey AKey, the padding after it): where the node starts
    method BeginNode(const AValueLength: int64; const AKind: int64; const AKey: string): int64;
    var
      LStart: int64;
    begin
      self.Align();
      LStart := self.At;
      self.PutWord(0);
      self.PutWord(AValueLength);
      self.PutWord(AKind);
      self.PutWide(AKey);
      self.Align();
      return LStart;
    end;

    // The node that starts at AStart ends here: its wLength (its bytes, children included,
    // its trailing padding not)
    method EndNode(const AStart: int64);
    begin
      if self.Writing then
        PutLe(self.Bytes, AStart, uint64(self.At - AStart), 2);
      end;
    end;

    // One String of the StringTable: AKey and its value AValue (wValueLength its UTF-16
    // units, the NUL counted)
    method PutString(const AKey: string; const AValue: string);
    var
      LStart: int64;
    begin
      LStart := self.BeginNode(WideUnits(AValue) + 1, ADAM_VERSION_TEXT, AKey);
      self.PutWide(AValue);
      self.EndNode(LStart);
    end;

    // The whole VS_VERSIONINFO of ASettings (see the header)
    method Run(const ASettings: ref ExeSettings);
    var
      LRoot: int64;
      LFile: int64;
      LTable: int64;
      LVars: int64;
      LVar: int64;
      LHigh: int64;
      LLow: int64;
      LVersion: string;
      LFileType: int64;
    begin
      self.At := 0;
      // the file's kind: a dll's (ExeSettings.Dll) is VFT_DLL, every other image's VFT_APP
      LFileType := VFT_APP;
      if ASettings.Dll then
        LFileType := VFT_DLL;
      end;
      LHigh := (ASettings.VersionMajor shl 16) | ASettings.VersionMinor;
      LLow := ASettings.VersionPatch shl 16;
      LVersion := IntToStr(ASettings.VersionMajor) + "." + IntToStr(ASettings.VersionMinor) + "." +
        IntToStr(ASettings.VersionPatch) + ".0";
      LRoot := self.BeginNode(ADAM_VERSION_FIXED_SIZE, ADAM_VERSION_BINARY, "VS_VERSION_INFO");
      // VS_FIXEDFILEINFO: the file and the product version the same, no flags, no date
      self.PutDword(VS_FFI_SIGNATURE);
      self.PutDword(VS_FFI_STRUCVERSION);
      self.PutDword(LHigh);
      self.PutDword(LLow);
      self.PutDword(LHigh);
      self.PutDword(LLow);
      self.PutDword(VS_FFI_FILEFLAGSMASK);
      self.PutDword(0);
      self.PutDword(VOS_NT_WINDOWS32);
      self.PutDword(LFileType);
      self.PutDword(0);
      self.PutDword(0);
      self.PutDword(0);
      LFile := self.BeginNode(0, ADAM_VERSION_TEXT, "StringFileInfo");
      LTable := self.BeginNode(0, ADAM_VERSION_TEXT, ADAM_VERSION_TABLE_KEY);
      self.PutString("CompanyName", ASettings.CompanyName);
      self.PutString("FileDescription", ASettings.Description);
      self.PutString("FileVersion", LVersion);
      self.PutString("InternalName", ChangeFileExt(ASettings.FileName, ""));
      self.PutString("LegalCopyright", ASettings.Copyright);
      self.PutString("OriginalFilename", ASettings.FileName);
      self.PutString("ProductName", ASettings.ProductName);
      self.PutString("ProductVersion", LVersion);
      self.EndNode(LTable);
      self.EndNode(LFile);
      LVars := self.BeginNode(0, ADAM_VERSION_TEXT, "VarFileInfo");
      LVar := self.BeginNode(4, ADAM_VERSION_BINARY, "Translation");
      self.PutWord(ADAM_VERSION_LANGUAGE);
      self.PutWord(ADAM_VERSION_CODEPAGE);
      self.EndNode(LVar);
      self.EndNode(LVars);
      self.EndNode(LRoot);
    end;
  end;

// The RT_VERSION resource's bytes for ASettings (see the header)
public routine VersionResource(const ASettings: ref ExeSettings): ref ImageResource;
var
  LWriter: ref VersionWriter;
begin
  LWriter := ref VersionWriter();
  LWriter.Run(ASettings);
  setlength(LWriter.Bytes, LWriter.At);
  LWriter.Writing := true;
  LWriter.Run(ASettings);
  return ref ImageResource(RT_VERSION, VS_VERSION_INFO, "",
    LANG_NEUTRAL, LWriter.Bytes);
end;

// The ACount bytes of ABytes from AFrom
routine DoSlice(const ABytes: ByteArray; const AFrom: int64; const ACount: int64): ByteArray;
var
  LSlice: ByteArray;
  LI: int64;
begin
  setlength(LSlice, ACount);
  for LI := 0 to ACount - 1 do
    LSlice[LI] := ABytes[AFrom + LI];
  end;
  return LSlice;
end;

// The icon file AIcon's images appended to AList as RT_ICON resources (ids 1..n) and their
// RT_GROUP_ICON MAINICON after them (see the header); what keeps it from being an icon file
// (nothing appended then)
public routine IconResources(const AIcon: ByteArray; var AList: ImageResourceList): IconFault;
var
  LCount: int64;
  LI: int64;
  LEntry: int64;
  LSize: int64;
  LOffset: int64;
  LGroup: ByteArray;
  LAt: int64;
  LK: int64;
  LFirst: int64;
begin
  if len(AIcon) < ADAM_ICON_DIR_SIZE then
    return IconFault.NoDirectory;
  end;
  if (GetLe(AIcon, 0, 2) <> 0) or (int64(GetLe(AIcon, 2, 2)) <> ADAM_ICON_TYPE) then
    return IconFault.NoDirectory;
  end;
  LCount := int64(GetLe(AIcon, 4, 2));
  if LCount = 0 then
    return IconFault.NoImage;
  end;
  if ADAM_ICON_DIR_SIZE + ADAM_ICON_ENTRY_SIZE * LCount > len(AIcon) then
    return IconFault.PastEnd;
  end;
  // Every entry checked before anything is appended
  for LI := 0 to LCount - 1 do
    LEntry := ADAM_ICON_DIR_SIZE + ADAM_ICON_ENTRY_SIZE * LI;
    LSize := int64(GetLe(AIcon, LEntry + 8, 4));
    LOffset := int64(GetLe(AIcon, LEntry + 12, 4));
    if (LSize = 0) or (LOffset + LSize > len(AIcon)) then
      return IconFault.PastEnd;
    end;
  end;
  // GRPICONDIR: the ICONDIR's six bytes, then per image its ICONDIRENTRY with the image's
  // resource id in place of its file offset (14 bytes)
  setlength(LGroup, ADAM_ICON_DIR_SIZE + ADAM_ICON_GROUP_ENTRY_SIZE * LCount);
  for LK := 0 to ADAM_ICON_DIR_SIZE - 1 do
    LGroup[LK] := AIcon[LK];
  end;
  LFirst := len(AList);
  setlength(AList, LFirst + LCount + 1);
  for LI := 0 to LCount - 1 do
    LEntry := ADAM_ICON_DIR_SIZE + ADAM_ICON_ENTRY_SIZE * LI;
    LSize := int64(GetLe(AIcon, LEntry + 8, 4));
    LOffset := int64(GetLe(AIcon, LEntry + 12, 4));
    AList[LFirst + LI] := ref ImageResource(RT_ICON, LI + 1, "", LANG_NEUTRAL,
      DoSlice(AIcon, LOffset, LSize));
    LAt := ADAM_ICON_DIR_SIZE + ADAM_ICON_GROUP_ENTRY_SIZE * LI;
    for LK := 0 to 11 do
      LGroup[LAt + LK] := AIcon[LEntry + LK];
    end;
    PutLe(LGroup, LAt + 12, uint64(LI + 1), 2);
  end;
  AList[LFirst + LCount] := ref ImageResource(RT_GROUP_ICON, 0,
    ADAM_RESOURCE_ICON_GROUP_NAME, LANG_NEUTRAL, LGroup);
  return IconFault.None;
end;

// -1, 0 or 1 as AFirst's name sorts before, with or after ASecond's in their type's directory:
// a named entry before an id one, names ascending (ordinal), ids ascending
routine DoNameOrder(const AFirst: ref ImageResource; const ASecond: ref ImageResource): int64;
begin
  if (AFirst.NameText <> "") and (ASecond.NameText = "") then
    return -1;
  end;
  if (AFirst.NameText = "") and (ASecond.NameText <> "") then
    return 1;
  end;
  if AFirst.NameText <> "" then
    if AFirst.NameText < ASecond.NameText then
      return -1;
    end;
    if AFirst.NameText > ASecond.NameText then
      return 1;
    end;
    return 0;
  end;
  if AFirst.NameId < ASecond.NameId then
    return -1;
  end;
  if AFirst.NameId > ASecond.NameId then
    return 1;
  end;
  return 0;
end;

// A directory table's header at AAt of ABytes: ANamed name entries, AIds id entries
routine DoTable(var ABytes: ByteArray; const AAt: int64; const ANamed: int64; const AIds: int64);
begin
  // Characteristics, TimeDateStamp and the version stay 0 (deterministic)
  PutLe(ABytes, AAt + 12, uint64(ANamed), 2);
  PutLe(ABytes, AAt + 14, uint64(AIds), 2);
end;

// The .rsrc bytes of AList (see the header); ADataFields the offsets of its data entries'
// OffsetToData fields
public routine ResourceSection(const AList: ImageResourceList; var ADataFields: Int64Array): ByteArray;
var
  LBytes: ByteArray;
  LTypes: int64;
  LI: int64;
  LK: int64;
  LAt: int64;
  LTypeAt: Int64Array;
  LTypeOf: Int64Array;
  LTypeFirst: Int64Array;
  LTypeCount: Int64Array;
  LTypeNamed: Int64Array;
  LNameAt: Int64Array;
  LStringAt: Int64Array;
  LDataEntryAt: Int64Array;
  LDataAt: int64;
  LBlobAt: Int64Array;
  LType: int64;
  LEntry: int64;
  LCode: int64;
  LResource: ref ImageResource;
begin
  setlength(ADataFields, len(AList));
  // The types, each a run of AList (the list is in the directory's order)
  LTypes := 0;
  setlength(LTypeOf, len(AList));
  setlength(LTypeFirst, len(AList));
  setlength(LTypeCount, len(AList));
  setlength(LTypeNamed, len(AList));
  for LI := 0 to len(AList) - 1 do
    LResource := AList[LI];
    if (LTypes = 0) or (LTypeOf[LTypes - 1] <> LResource.TypeId) then
      if (LTypes > 0) and (LTypeOf[LTypes - 1] > LResource.TypeId) then
        raise(ADAM_RESOURCE_FAULT_ORDER + IntToStr(LResource.TypeId));
      end;
      LTypeOf[LTypes] := LResource.TypeId;
      LTypeFirst[LTypes] := LI;
      LTypeCount[LTypes] := 0;
      LTypeNamed[LTypes] := 0;
      LTypes := LTypes + 1;
    else
      if DoNameOrder(AList[LI - 1], LResource) >= 0 then
        raise(ADAM_RESOURCE_FAULT_ORDER + IntToStr(LResource.TypeId));
      end;
    end;
    LTypeCount[LTypes - 1] := LTypeCount[LTypes - 1] + 1;
    if LResource.NameText <> "" then
      LTypeNamed[LTypes - 1] := LTypeNamed[LTypes - 1] + 1;
    end;
  end;
  // The places: the root table, the types' tables, the names' tables (one language entry
  // each), the name strings, the data entries, the resources' bytes
  LAt := ADAM_RESOURCE_TABLE_SIZE + ADAM_RESOURCE_ENTRY_SIZE * LTypes;
  setlength(LTypeAt, LTypes);
  for LI := 0 to LTypes - 1 do
    LTypeAt[LI] := LAt;
    LAt := LAt + ADAM_RESOURCE_TABLE_SIZE + ADAM_RESOURCE_ENTRY_SIZE * LTypeCount[LI];
  end;
  setlength(LNameAt, len(AList));
  for LI := 0 to len(AList) - 1 do
    LNameAt[LI] := LAt;
    LAt := LAt + ADAM_RESOURCE_TABLE_SIZE + ADAM_RESOURCE_ENTRY_SIZE;
  end;
  setlength(LStringAt, len(AList));
  for LI := 0 to len(AList) - 1 do
    LStringAt[LI] := 0;
    if AList[LI].NameText <> "" then
      LStringAt[LI] := LAt;
      // Its length (UTF-16 units) and its units, no NUL
      LAt := LAt + 2 + 2 * len(AList[LI].NameText);
    end;
  end;
  LAt := AlignUp(LAt, ADAM_VERSION_ALIGN);
  setlength(LDataEntryAt, len(AList));
  for LI := 0 to len(AList) - 1 do
    LDataEntryAt[LI] := LAt;
    LAt := LAt + ADAM_RESOURCE_DATA_SIZE;
  end;
  setlength(LBlobAt, len(AList));
  for LI := 0 to len(AList) - 1 do
    LAt := AlignUp(LAt, ADAM_RESOURCE_DATA_ALIGN);
    LBlobAt[LI] := LAt;
    LAt := LAt + len(AList[LI].Bytes);
  end;
  setlength(LBytes, LAt);
  for LI := 0 to LAt - 1 do
    LBytes[LI] := 0;
  end;
  // The root: one id entry per type, its subdirectory
  DoTable(LBytes, 0, 0, LTypes);
  for LI := 0 to LTypes - 1 do
    LEntry := ADAM_RESOURCE_TABLE_SIZE + ADAM_RESOURCE_ENTRY_SIZE * LI;
    PutLe(LBytes, LEntry, uint64(LTypeOf[LI]), 4);
    PutLe(LBytes, LEntry + 4, uint64(ADAM_RESOURCE_HIGH_BIT | LTypeAt[LI]), 4);
  end;
  // Each type: one entry per name (named first), its language subdirectory
  for LType := 0 to LTypes - 1 do
    DoTable(LBytes, LTypeAt[LType], LTypeNamed[LType], LTypeCount[LType] - LTypeNamed[LType]);
    for LK := 0 to LTypeCount[LType] - 1 do
      LI := LTypeFirst[LType] + LK;
      LEntry := LTypeAt[LType] + ADAM_RESOURCE_TABLE_SIZE + ADAM_RESOURCE_ENTRY_SIZE * LK;
      if AList[LI].NameText <> "" then
        PutLe(LBytes, LEntry, uint64(ADAM_RESOURCE_HIGH_BIT | LStringAt[LI]), 4);
      else
        PutLe(LBytes, LEntry, uint64(AList[LI].NameId), 4);
      end;
      PutLe(LBytes, LEntry + 4, uint64(ADAM_RESOURCE_HIGH_BIT | LNameAt[LI]), 4);
    end;
  end;
  for LI := 0 to len(AList) - 1 do
    LResource := AList[LI];
    // Each name: its one language entry, its data entry (no high bit)
    DoTable(LBytes, LNameAt[LI], 0, 1);
    LEntry := LNameAt[LI] + ADAM_RESOURCE_TABLE_SIZE;
    PutLe(LBytes, LEntry, uint64(LResource.Language), 4);
    PutLe(LBytes, LEntry + 4, uint64(LDataEntryAt[LI]), 4);
    // The name string (ASCII: one UTF-16 unit per byte)
    if LResource.NameText <> "" then
      PutLe(LBytes, LStringAt[LI], uint64(len(LResource.NameText)), 2);
      for LK := 0 to len(LResource.NameText) - 1 do
        LCode := int64(uint8(LResource.NameText[LK]));
        if LCode >= 128 then
          raise(ADAM_RESOURCE_FAULT_NAME + LResource.NameText);
        end;
        PutLe(LBytes, LStringAt[LI] + 2 + 2 * LK, uint64(LCode), 2);
      end;
    end;
    // The data entry: the bytes' offset (the linker adds the section's RVA), their size;
    // CodePage and Reserved 0
    PutLe(LBytes, LDataEntryAt[LI], uint64(LBlobAt[LI]), 4);
    PutLe(LBytes, LDataEntryAt[LI] + 4, uint64(len(LResource.Bytes)), 4);
    ADataFields[LI] := LDataEntryAt[LI];
    LDataAt := LBlobAt[LI];
    for LK := 0 to len(LResource.Bytes) - 1 do
      LBytes[LDataAt + LK] := LResource.Bytes[LK];
    end;
  end;
  return LBytes;
end;

end.
