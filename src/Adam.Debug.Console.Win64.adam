-------------------------------------------------------------------------------
  Adam.Debug.Console.Win64.adam - the console Adam's debugger runs in, on
  x86_64-windows-gnu (M11a D4)

  Adam.Debug.Console's platform part: whether standard input and output are
  both a console (GetConsoleMode takes them), and the console's Ctrl+C /
  Ctrl+Break taken by a handler of this unit's while the debugger runs. The
  handler runs on a thread of the OS's, so it only counts the key (one
  atomicadd): the debugger takes the count from its own thread (a running
  program paused, a prompt shown again). The program debugged is in a
  process group of its own (Adam.Debug.Target.Win64), so the key is never
  its. Reaches Windows only through System.Windows.Debug.
*******************************************************************************/

module unit Adam.Debug.Console.Win64;

import System.Windows, System.Windows.Debug;

var
  // The Ctrl+C / Ctrl+Break presses the handler counted and nobody took yet
  GBreakKeys: int64;
  // True while the handler is the console's
  GBreakKeysOn: bool;

// The console's handler (see the header): a Ctrl+C or Ctrl+Break counted and handled (adam
// goes on); any other event (the window closed, a log off) left to the next handler
func clink DoConsoleCtrl(ACtrlType: uint32): int32;
var
  LOld: int64;
begin
  if (ACtrlType <> CTRL_C_EVENT) and
    (ACtrlType <> CTRL_BREAK_EVENT) then
    return 0;
  end;
  LOld := atomicadd(GBreakKeys, 1);
  return 1;
end;

// True when the standard handle AWhich is a console
func DoIsConsole(const AWhich: uint32): bool;
var
  LHandle: uint64;
  LMode: uint32;
begin
  LHandle := GetStdHandle(AWhich);
  if (LHandle = 0) or (LHandle = INVALID_HANDLE_VALUE) then
    return false;
  end;
  // GetConsoleMode fails on anything that is not a console: a pipe, a file, NUL
  LMode := 0;
  return GetConsoleMode(LHandle, LMode) <> 0;
end;

// True when standard input and standard output are both a console
public func DebugConsolePlatformIsConsole(): bool;
begin
  return DoIsConsole(STD_INPUT_HANDLE) and
    DoIsConsole(STD_OUTPUT_HANDLE);
end;

// The handler made the console's (the count starts at 0); false when Windows refused it,
// the console's own handling (Ctrl+C ends adam) then left as it was
public func DebugConsolePlatformBreakKeysOn(): bool;
begin
  atomicstore(GBreakKeys, 0);
  if GBreakKeysOn then
    return true;
  end;
  GBreakKeysOn := SetConsoleCtrlHandler(DoConsoleCtrl, 1) <> 0;
  return GBreakKeysOn;
end;

// The handler taken off again (nothing when it is not on)
public func DebugConsolePlatformBreakKeysOff();
begin
  if GBreakKeysOn then
    SetConsoleCtrlHandler(DoConsoleCtrl, 0);
    GBreakKeysOn := false;
  end;
  atomicstore(GBreakKeys, 0);
end;

// True when a key was counted since the last take (every one counted is taken)
public func DebugConsolePlatformTakeBreakKey(): bool;
begin
  return atomicswap(GBreakKeys, 0) > 0;
end;

end.
