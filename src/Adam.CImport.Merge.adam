-------------------------------------------------------------------------------
  Adam.CImport.Merge.adam - one `.C` unit for several targets (LX0c): the
  units `adam cimport` writes for each target of a spec's `targets` merged
  into one text

  MergeTargetTexts takes the unit's text for each target (the same spec,
  imported once per target; lines ended by LF) and gives one text that is,
  for every target, exactly its own once the conditional directives are
  resolved: the lines every target has are written once, in order; where
  the targets differ, each target's own lines stand in a branch of
  @ifdef TARGET_<triple> / @elseif TARGET_<triple> / @endif (BNF sec 2:
  a conditional directive may stand anywhere; TargetSymbol names the
  target), a target whose lines there are none has no branch. The lines
  common to all are found by Myers' O((N + M) D) diff in linear space (the
  middle snake, divide and conquer: no table of N x M), the first target
  against the second, what they share against the third, and so on, so
  the targets' order is the spec's and the text is deterministic.
*******************************************************************************/

module unit Adam.CImport.Merge;

import System.SysUtils, Adam.Compiler.Conditionals;

type
  // The pairs of matched lines a diff finds, in order: line AtA[i] of the first text is line
  // AtB[i] of the second (Count of them; the arrays grow by doubling)
  LineMatches = record
    AtA: Int64Array;
    AtB: Int64Array;
    Count: int64;
  end;

  // Myers' furthest-reaching x per diagonal, forward and reverse (Offset = diagonal 0's index)
  SnakeState = record
    Forward: Int64Array;
    Reverse: Int64Array;
    Offset: int64;
  end;

  // A middle snake: from (X, Y) to (U, V), relative to its range, on a path of D differences
  MiddleSnake = record
    X: int64;
    Y: int64;
    U: int64;
    V: int64;
    D: int64;
  end;

  LineArrays = array of StringArray;
  PositionArrays = array of Int64Array;

// The match (AAt, ABt) added at the end of AMatches
routine DoAddMatch(var AMatches: LineMatches; const AAt: int64; const ABt: int64);
var
  LSize: int64;
begin
  if AMatches.Count = len(AMatches.AtA) then
    LSize := len(AMatches.AtA) * 2;
    if LSize < 64 then
      LSize := 64;
    end;
    setlength(AMatches.AtA, LSize);
    setlength(AMatches.AtB, LSize);
  end;
  AMatches.AtA[AMatches.Count] := AAt;
  AMatches.AtB[AMatches.Count] := ABt;
  AMatches.Count := AMatches.Count + 1;
end;

// The middle snake of A[AA0 .. AA1) against B[AB0 .. AB1), both not empty (Myers 1986, sec
// 4b): the forward and the reverse search run a step each until their paths overlap; the
// snake of the overlapping step is the middle of a shortest edit path, its D the path's
// length. AState's arrays are sized here for the range
routine DoMiddleSnake(const A: StringArray; const B: StringArray; const AA0: int64;
  const AA1: int64; const AB0: int64; const AB1: int64; var AState: SnakeState): MiddleSnake;
var
  LN: int64;
  LM: int64;
  LDelta: int64;
  LOdd: bool;
  LMax: int64;
  LOff: int64;
  LD: int64;
  LK: int64;
  LC: int64;
  LX: int64;
  LY: int64;
  LXs: int64;
  LYs: int64;
  LSnake: MiddleSnake;
begin
  LN := AA1 - AA0;
  LM := AB1 - AB0;
  LDelta := LN - LM;
  LOdd := (LDelta mod 2) <> 0;
  LMax := (LN + LM + 1) div 2;
  LOff := LMax + 1;
  if len(AState.Forward) < 2 * LMax + 3 then
    setlength(AState.Forward, 2 * LMax + 3);
    setlength(AState.Reverse, 2 * LMax + 3);
  end;
  AState.Offset := LOff;
  AState.Forward[LOff + 1] := 0;
  AState.Reverse[LOff + 1] := 0;
  LSnake.X := 0;
  LSnake.Y := 0;
  LSnake.U := 0;
  LSnake.V := 0;
  LSnake.D := 0;
  for LD := 0 to LMax do
    // forward: diagonal k = x - y, from the start
    LK := -LD;
    while LK <= LD do
      if (LK = -LD) or ((LK <> LD) and (AState.Forward[LOff + LK - 1] <
        AState.Forward[LOff + LK + 1])) then
        LX := AState.Forward[LOff + LK + 1];
      else
        LX := AState.Forward[LOff + LK - 1] + 1;
      end;
      LY := LX - LK;
      LXs := LX;
      LYs := LY;
      while (LX < LN) and (LY < LM) and (A[AA0 + LX] = B[AB0 + LY]) do
        LX := LX + 1;
        LY := LY + 1;
      end;
      AState.Forward[LOff + LK] := LX;
      // the reverse diagonal of k is delta - k; an odd delta overlaps on a forward step
      LC := LDelta - LK;
      if LOdd and (LC >= -(LD - 1)) and (LC <= LD - 1) then
        if AState.Forward[LOff + LK] + AState.Reverse[LOff + LC] >= LN then
          LSnake.X := LXs;
          LSnake.Y := LYs;
          LSnake.U := LX;
          LSnake.V := LY;
          LSnake.D := 2 * LD - 1;
          return LSnake;
        end;
      end;
      LK := LK + 2;
    end;
    // reverse: diagonal c = x' - y' of the reversed texts, from the end
    LC := -LD;
    while LC <= LD do
      if (LC = -LD) or ((LC <> LD) and (AState.Reverse[LOff + LC - 1] <
        AState.Reverse[LOff + LC + 1])) then
        LX := AState.Reverse[LOff + LC + 1];
      else
        LX := AState.Reverse[LOff + LC - 1] + 1;
      end;
      LY := LX - LC;
      LXs := LX;
      LYs := LY;
      while (LX < LN) and (LY < LM) and (A[AA1 - 1 - LX] = B[AB1 - 1 - LY]) do
        LX := LX + 1;
        LY := LY + 1;
      end;
      AState.Reverse[LOff + LC] := LX;
      LK := LDelta - LC;
      if not LOdd and (LK >= -LD) and (LK <= LD) then
        if AState.Forward[LOff + LK] + AState.Reverse[LOff + LC] >= LN then
          LSnake.X := LN - LX;
          LSnake.Y := LM - LY;
          LSnake.U := LN - LXs;
          LSnake.V := LM - LYs;
          LSnake.D := 2 * LD;
          return LSnake;
        end;
      end;
      LC := LC + 2;
    end;
  end;
  // never reached: a path of at most N + M differences always overlaps by step LMax
  raise("Adam.CImport.Merge: no middle snake");
end;

// The matched lines of A[AA0 .. AA1) and B[AB0 .. AB1) added to AMatches in order: the common
// head and tail taken first, then the middle snake splits what is left in two (each with
// fewer differences), each diffed the same way
routine DoDiffRange(const A: StringArray; const B: StringArray; const AA0: int64;
  const AA1: int64; const AB0: int64; const AB1: int64; var AState: SnakeState;
  var AMatches: LineMatches);
var
  LA0: int64;
  LB0: int64;
  LTail: int64;
  LA1: int64;
  LB1: int64;
  LSnake: MiddleSnake;
  LI: int64;
begin
  LA0 := AA0;
  LB0 := AB0;
  while (LA0 < AA1) and (LB0 < AB1) and (A[LA0] = B[LB0]) do
    DoAddMatch(AMatches, LA0, LB0);
    LA0 := LA0 + 1;
    LB0 := LB0 + 1;
  end;
  LTail := 0;
  while (LA0 < AA1 - LTail) and (LB0 < AB1 - LTail) and
    (A[AA1 - 1 - LTail] = B[AB1 - 1 - LTail]) do
    LTail := LTail + 1;
  end;
  LA1 := AA1 - LTail;
  LB1 := AB1 - LTail;
  if (LA0 < LA1) and (LB0 < LB1) then
    LSnake := DoMiddleSnake(A, B, LA0, LA1, LB0, LB1, AState);
    if LSnake.D > 1 then
      DoDiffRange(A, B, LA0, LA0 + LSnake.X, LB0, LB0 + LSnake.Y, AState, AMatches);
      for LI := 0 to LSnake.U - LSnake.X - 1 do
        DoAddMatch(AMatches, LA0 + LSnake.X + LI, LB0 + LSnake.Y + LI);
      end;
      DoDiffRange(A, B, LA0 + LSnake.U, LA1, LB0 + LSnake.V, LB1, AState, AMatches);
    else
      // one difference or none: the shorter range is the longer one with a line less, so
      // walking both and stepping over the longer's odd line finds every match
      LI := 0;
      while (LA0 + LI < LA1) and (LB0 < LB1) do
        if A[LA0 + LI] = B[LB0] then
          DoAddMatch(AMatches, LA0 + LI, LB0);
          LB0 := LB0 + 1;
          LI := LI + 1;
        else
          if LA1 - LA0 > LB1 - LB0 then
            LI := LI + 1;
          else
            LB0 := LB0 + 1;
          end;
        end;
      end;
    end;
  end;
  for LI := 0 to LTail - 1 do
    DoAddMatch(AMatches, LA1 + LI, LB1 + LI);
  end;
end;

// The matched lines of A and B (a longest common subsequence), in order
routine DoDiff(const A: StringArray; const B: StringArray): LineMatches;
var
  LMatches: LineMatches;
  LState: SnakeState;
begin
  setlength(LMatches.AtA, 0);
  setlength(LMatches.AtB, 0);
  LMatches.Count := 0;
  setlength(LState.Forward, 0);
  setlength(LState.Reverse, 0);
  LState.Offset := 0;
  DoDiffRange(A, B, 0, len(A), 0, len(B), LState, LMatches);
  return LMatches;
end;

// ALine added at the end of AOut (ACount lines in it; it grows by doubling)
routine DoAddLine(var AOut: StringArray; var ACount: int64; const ALine: string);
var
  LSize: int64;
begin
  if ACount = len(AOut) then
    LSize := len(AOut) * 2;
    if LSize < 256 then
      LSize := 256;
    end;
    setlength(AOut, LSize);
  end;
  AOut[ACount] := ALine;
  ACount := ACount + 1;
end;

// The lines of every target from its AFrom up to (not with) its AUpTo into AOut: as they are
// when every target has the same lines there, else each target that has any in its own
// @ifdef / @elseif TARGET_<triple> branch, ended by @endif
routine DoAddHunks(const ATriples: StringArray; const ALines: LineArrays;
  const AFrom: Int64Array; const AUpTo: Int64Array; var AOut: StringArray; var ACount: int64);
var
  LSame: bool;
  LFirst: bool;
  LK: int64;
  LI: int64;
  LWord: string;
begin
  LSame := true;
  for LK := 1 to len(ALines) - 1 do
    if AUpTo[LK] - AFrom[LK] <> AUpTo[0] - AFrom[0] then
      LSame := false;
    else
      for LI := 0 to AUpTo[0] - AFrom[0] - 1 do
        if ALines[LK][AFrom[LK] + LI] <> ALines[0][AFrom[0] + LI] then
          LSame := false;
        end;
      end;
    end;
  end;
  if LSame then
    for LI := AFrom[0] to AUpTo[0] - 1 do
      DoAddLine(AOut, ACount, ALines[0][LI]);
    end;
    return;
  end;
  LFirst := true;
  for LK := 0 to len(ALines) - 1 do
    if AUpTo[LK] > AFrom[LK] then
      LWord := "@elseif ";
      if LFirst then
        LWord := "@ifdef ";
      end;
      DoAddLine(AOut, ACount, LWord + TargetSymbol(ATriples[LK]));
      for LI := AFrom[LK] to AUpTo[LK] - 1 do
        DoAddLine(AOut, ACount, ALines[LK][LI]);
      end;
      LFirst := false;
    end;
  end;
  if not LFirst then
    DoAddLine(AOut, ACount, "@endif");
  end;
end;

// One text from ATexts, the unit written for each target of ATriples (the same order, lines
// ended by LF): for each target exactly its own text once the conditional directives are
// resolved (see the header). One text is given back as it is
public routine MergeTargetTexts(const ATriples: StringArray; const ATexts: StringArray): string;
var
  LLines: LineArrays;
  LCommon: StringArray;
  LPos: PositionArrays;
  LNewCommon: StringArray;
  LNewPos: PositionArrays;
  LMatches: LineMatches;
  LFrom: Int64Array;
  LUpTo: Int64Array;
  LOut: StringArray;
  LCount: int64;
  LTargets: int64;
  LK: int64;
  LJ: int64;
  LI: int64;
begin
  LTargets := len(ATexts);
  if LTargets = 1 then
    return ATexts[0];
  end;
  setlength(LLines, LTargets);
  for LK := 0 to LTargets - 1 do
    LLines[LK] := SplitString(ATexts[LK], "\n");
  end;
  // the lines every target has, and where each is in each target's text
  LCommon := LLines[0];
  setlength(LPos, 1);
  setlength(LPos[0], len(LCommon));
  for LI := 0 to len(LCommon) - 1 do
    LPos[0][LI] := LI;
  end;
  for LK := 1 to LTargets - 1 do
    LMatches := DoDiff(LCommon, LLines[LK]);
    setlength(LNewCommon, LMatches.Count);
    setlength(LNewPos, LK + 1);
    for LJ := 0 to LK do
      setlength(LNewPos[LJ], LMatches.Count);
    end;
    for LI := 0 to LMatches.Count - 1 do
      LNewCommon[LI] := LCommon[LMatches.AtA[LI]];
      for LJ := 0 to LK - 1 do
        LNewPos[LJ][LI] := LPos[LJ][LMatches.AtA[LI]];
      end;
      LNewPos[LK][LI] := LMatches.AtB[LI];
    end;
    LCommon := LNewCommon;
    LPos := LNewPos;
  end;
  // each common line after the hunks that lead to it
  setlength(LFrom, LTargets);
  setlength(LUpTo, LTargets);
  for LK := 0 to LTargets - 1 do
    LFrom[LK] := 0;
  end;
  setlength(LOut, 0);
  LCount := 0;
  for LI := 0 to len(LCommon) - 1 do
    for LK := 0 to LTargets - 1 do
      LUpTo[LK] := LPos[LK][LI];
    end;
    DoAddHunks(ATriples, LLines, LFrom, LUpTo, LOut, LCount);
    DoAddLine(LOut, LCount, LCommon[LI]);
    for LK := 0 to LTargets - 1 do
      LFrom[LK] := LPos[LK][LI] + 1;
    end;
  end;
  for LK := 0 to LTargets - 1 do
    LUpTo[LK] := len(LLines[LK]);
  end;
  DoAddHunks(ATriples, LLines, LFrom, LUpTo, LOut, LCount);
  setlength(LOut, LCount);
  return JoinStrings(LOut, "\n");
end;

end.
