-------------------------------------------------------------------------------
  Adam.LSP.Server.adam - Adam's language server (M11b, adam lsp)

  Serves the Language Server Protocol over a ProtocolTransport (adam lsp's
  is the process's stdin / stdout, a row's a channel of its own). RunLSP
  serves until "exit" or the end of the input: exit code 0 after shutdown,
  else 1.

  JSON-RPC 2.0, one message at a time on one thread (pcpp's). Every request
  gets one response. Before initialize a request is refused
  (ServerNotInitialized), a notification dropped ("exit" kept); a second
  initialize, and any request after shutdown, is InvalidRequest; an unknown
  request MethodNotFound ($/ ones too), an unknown notification ignored.
  A message that is no JSON is a ParseError, one that is no JSON-RPC
  message an InvalidRequest (id null when its id cannot be read); a
  response to a request of the server's own is taken quietly. A
  notification's bad params, and a message with a bad header, are told to
  the client as an error window/logMessage.

  initialize: positionEncoding the first of the client's
  capabilities.general.positionEncodings it takes (utf-16, utf-8, utf-32),
  utf-16 without a list (LSP's default); textDocumentSync open / close and
  incremental changes.

  The target: the client's triple (initializationOptions.target at
  initialize, settings.target in workspace/didChangeConfiguration: an
  editor's toolbar) stands in for the main module's target where it names
  no @target, as a build's -t under --defaults (Compiler.SetDefaultTarget);
  "" = none (the built-in default). A triple Adam has no target for is told
  to the client (window/logMessage) and the target kept. A changed target
  checks every open document again.

  Documents (didOpen / didChange / didClose): the buffers the client holds,
  each an LSPDocument; its path is the URI's file resolved as the front end
  reads it ("" for a URI naming no file: never checked).

  Diagnostics on idle: a document that changed is marked; once no message
  is waiting (the transport's HasPending) every marked one is checked, so a
  run of changes is one check. A check is the build's own front end
  (Compiler.CheckDocument: module paths, project, target) on the document
  as its main module, every open buffer given in place of its file
  (Compiler.GiveText), each import with a current .acu taken from it (the
  std's from the shared cache: a check is never a parse of every source). The document gets its own file's reports (and those
  with no place); an imported file that is not open gets its errors (a
  unit's hints and warnings are not the user's to act on there); an open
  one speaks for itself through its own check. What a document's check
  published before and not now is cleared; what was published is kept by
  file, not by the URI's spelling (a closed import goes out under the
  server's URI of its path, the client's own once it is open: one file,
  DoSameFile). A report's range starts at its
  place and runs over the word there (one character else).

  Watched files: with a client that takes registrations
  (capabilities.workspace.didChangeWatchedFiles.dynamicRegistration), the
  server watches what on the disk its checks read (Compiler.DiskPaths: the
  modules' files, the paths their directives name, project.toml), the open
  documents' files left out: one client/registerCapability of
  workspace/didChangeWatchedFiles, a watcher per path (its globPattern the
  path itself), sent again whenever the set changes (the new one before the
  old one's client/unregisterCapability). Each kept check keeps a stamp of
  those paths (a file's write time and size, a folder's files, an open
  document's file as its buffer), taken against the time the check began
  (NowNanos): a path written while it ran, or in the 2 s before it began
  (ADAM_LSP_STAMP_RACY_NS: a file system's coarser clock), leaves the stamp
  unknown.
  didChangeWatchedFiles marks for the next idle only the open documents
  whose stamp is unknown or differs now; a refresh with nothing changed
  (the client's one as each watcher starts) re-checks nothing.

  hover / definition (Adam.LSP.Find, Adam.LSP.Hover; checked first as
  semanticTokens): the name at the position in the last check's tree; a
  hover is its declaration's heading and doc comment as Markdown over the
  name's range, a definition the Location of the declaration's name (a
  unit's: its module's name), in its file's text (an open buffer, else the
  text the check read, else the disk). A hover with no declaration that
  has a place is a word the language defines (HK1, Adam.LSP.Hover
  WordHoverMarkdown: an intrinsic, a keyword, a directive, a free context
  word). Nothing there (or not open): null.

  semanticTokens/full (Adam.LSP.Tokens): a document changed since its last
  check is checked first (its diagnostics published), so the colours are of
  the text the client holds; each document keeps its last check's tree. A
  document that is not open has none (null). initialize names the legend
  and, in capabilities.experimental.adamWords, the Lexer's keyword,
  builtin type and context words (an editor's instant colouring).

  documentSymbol (Adam.LSP.Outline; checked first as semanticTokens): the
  document's module as one entry, its imports, declarations, sections and
  tests below it, each with its own entries (a type's members, a routine's
  local types); its range the whole declaration, its
  selectionRange the name. Not open, or no tree (untitled:): null.

  workspace/symbol (Adam.LSP.Outline): the entries of every module in the
  open documents' last checks (each file once, the open documents by URI,
  a check's modules in its tree's order; the std and runtime units a
  document imports too), every one whose name holds the query's characters
  in order (case aside; "" every one), imports left out; a module no open
  document holds gives only what it makes public (OutlineIsPublic: its
  internals are no user's to find). Each with its file's Location of its
  name and, below the module, its container's name.

  completion (Adam.LSP.Complete; checked first as semanticTokens): the
  items at the position, the context from the buffer's tokens, the names
  from the last check's tree; triggered by '.' and '>' (a '>' that is no
  '->' gives none). Not open: null; nothing to list: an empty list.

  inlayHint (Adam.LSP.Hints; checked first as semanticTokens): a `name:`
  Parameter hint before each call argument starting in the range (its end
  exclusive), the names of the signature the check bound the call to.
  Not open, or no tree: null; no range: -32602.

  call hierarchy (Adam.LSP.Calls): prepareCallHierarchy the routine
  declared or used at the position (definition's rule, a forward its full
  routine, a generic instance the template) as one CallHierarchyItem (the
  outline's name, kind, detail and ranges; data its key: file, line and
  byte column of its name's place), null when none; incomingCalls /
  outgoingCalls over every module of the open documents' last checks (each
  file once, as workspace/symbol): the item's callers grouped by caller (a
  call outside every routine: its module) / the routines it calls grouped
  by routine, each with the callee names' ranges in the caller's file
  (one per place: a generic's instances repeat their template's calls).
  The item is found again by its data (else by its selectionRange start);
  an item with neither: -32602.

  formatting / rangeFormatting (Adam.LSP.Format; checked first as
  semanticTokens): the TextEdits that format the buffer (the options' LSP
  keys and the editor's adam.* ones over the defaults), a range only those
  whose gap starts in it. A buffer the check found a lexer / conditional /
  parser error in, or one whose result would not read back the same, is
  not formatted: an empty list and a window/showMessage warning. Not open,
  or no tree: null; no URI (no range for a range request): -32602.

  Prior art: PaskalCPP.LSP.Server / Diagnostics (CONCEPT: the lifecycle,
  the request rules, the owner-based publish; GEOMETRY rejected: Adam's
  types, System.JSON.Ext).
*******************************************************************************/

module unit Adam.LSP.Server;

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Core.Common, Adam.Core.Messages,
  Adam.Compiler.Diagnostics, Adam.Protocol.Transport, Adam.Driver.Compiler, Adam.LSP.URI,
  Adam.LSP.Document, Adam.Compiler.Lexer, Adam.LSP.Tokens, Adam.Compiler.AST, Adam.LSP.Find,
  Adam.LSP.Hover, Adam.LSP.Outline, Adam.LSP.Complete, Adam.LSP.Hints, Adam.LSP.Calls,
  Adam.LSP.Format, Adam.Target.Registry;

public const
  // RunLSP's exit codes: "exit" after shutdown / any other end
  ADAM_LSP_EXIT_SHUTDOWN: int32 = 0;
  ADAM_LSP_EXIT_NO_SHUTDOWN: int32 = 1;
  ADAM_LSP_JSONRPC: string = "2.0";
  // JSON-RPC's and LSP's error codes
  ADAM_LSP_ERROR_PARSE: int64 = -32700;
  ADAM_LSP_ERROR_INVALID_REQUEST: int64 = -32600;
  ADAM_LSP_ERROR_METHOD_NOT_FOUND: int64 = -32601;
  ADAM_LSP_ERROR_INVALID_PARAMS: int64 = -32602;
  ADAM_LSP_ERROR_NOT_INITIALIZED: int64 = -32002;
  // DiagnosticSeverity
  ADAM_LSP_SEVERITY_ERROR: int64 = 1;
  ADAM_LSP_SEVERITY_WARNING: int64 = 2;
  ADAM_LSP_SEVERITY_HINT: int64 = 4;
  // MessageType (window/logMessage)
  ADAM_LSP_MESSAGE_ERROR: int64 = 1;
  ADAM_LSP_MESSAGE_WARNING: int64 = 2;
  // TextDocumentSyncKind
  ADAM_LSP_SYNC_INCREMENTAL: int64 = 2;
  // A diagnostic's source, the server's name
  ADAM_LSP_SOURCE: string = "adam";
  ADAM_LSP_SERVER_NAME: string = "adam";
  // capabilities.experimental's key of Adam's word lists
  ADAM_LSP_WORDS_KEY: string = "adamWords";
  // PositionEncodingKind
  ADAM_LSP_ENCODING_UTF8: string = "utf-8";
  ADAM_LSP_ENCODING_UTF16: string = "utf-16";
  ADAM_LSP_ENCODING_UTF32: string = "utf-32";
  // The methods
  ADAM_LSP_INITIALIZE: string = "initialize";
  ADAM_LSP_SHUTDOWN: string = "shutdown";
  ADAM_LSP_EXIT: string = "exit";
  ADAM_LSP_DID_OPEN: string = "textDocument/didOpen";
  ADAM_LSP_DID_CHANGE: string = "textDocument/didChange";
  ADAM_LSP_DID_CLOSE: string = "textDocument/didClose";
  // The client's target (see the header): the notification and where each message holds it
  ADAM_LSP_DID_CHANGE_CONFIGURATION: string = "workspace/didChangeConfiguration";
  ADAM_LSP_INIT_TARGET: string = "initializationOptions.target";
  ADAM_LSP_SETTINGS_TARGET: string = "settings.target";
  ADAM_LSP_PUBLISH_DIAGNOSTICS: string = "textDocument/publishDiagnostics";
  ADAM_LSP_LOG_MESSAGE: string = "window/logMessage";
  ADAM_LSP_SHOW_MESSAGE: string = "window/showMessage";
  ADAM_LSP_SEMANTIC_FULL: string = "textDocument/semanticTokens/full";
  ADAM_LSP_HOVER: string = "textDocument/hover";
  ADAM_LSP_DEFINITION: string = "textDocument/definition";
  ADAM_LSP_DOCUMENT_SYMBOL: string = "textDocument/documentSymbol";
  ADAM_LSP_WORKSPACE_SYMBOL: string = "workspace/symbol";
  ADAM_LSP_COMPLETION: string = "textDocument/completion";
  ADAM_LSP_INLAY_HINT: string = "textDocument/inlayHint";
  ADAM_LSP_PREPARE_CALLS: string = "textDocument/prepareCallHierarchy";
  ADAM_LSP_INCOMING_CALLS: string = "callHierarchy/incomingCalls";
  ADAM_LSP_OUTGOING_CALLS: string = "callHierarchy/outgoingCalls";
  ADAM_LSP_FORMATTING: string = "textDocument/formatting";
  ADAM_LSP_RANGE_FORMATTING: string = "textDocument/rangeFormatting";
  // The report code prefixes of the phases a formatting needs clean (the Lexer, the
  // conditional filter, the Parser: a Semantics report does not stop it)
  ADAM_LSP_FORMAT_LEXER: string = "LX";
  ADAM_LSP_FORMAT_CONDITIONALS: string = "CD";
  ADAM_LSP_FORMAT_PARSER: string = "PR";
  // InlayHintKind of a parameter name
  ADAM_LSP_HINT_PARAMETER: int64 = 2;
  // completion's trigger characters ('>' for '->'), and the InsertTextFormat of a snippet
  ADAM_LSP_TRIGGER_DOT: string = ".";
  ADAM_LSP_TRIGGER_ARROW: string = ">";
  ADAM_LSP_INSERT_SNIPPET: int64 = 2;
  // The key of the array a result is made under (a JSON holds an object at its root)
  ADAM_LSP_ITEMS_KEY: string = "items";
  // A hover's MarkupKind
  ADAM_LSP_MARKUP_MARKDOWN: string = "markdown";

  // The watched files (client/registerCapability): the client's capability that says it
  // takes them, and the ids of the server's registrations and of its requests
  ADAM_LSP_DID_CHANGE_WATCHED: string = "workspace/didChangeWatchedFiles";
  ADAM_LSP_REGISTER_CAPABILITY: string = "client/registerCapability";
  ADAM_LSP_UNREGISTER_CAPABILITY: string = "client/unregisterCapability";
  ADAM_LSP_WATCH_CAPABILITY: string =
    "capabilities.workspace.didChangeWatchedFiles.dynamicRegistration";
  ADAM_LSP_WATCH_ID: string = "adam-watch-";
  ADAM_LSP_WATCH_REGISTER_ID: string = "adam-watch-reg-";
  ADAM_LSP_WATCH_UNREGISTER_ID: string = "adam-watch-unreg-";
  // A disk stamp's first line (DoDiskStamp): "" is no stamp (unknown), so even a check that
  // read no path has a stamp that is not ""; then one line per path, its kind's word after it
  ADAM_LSP_STAMP_HEAD: string = "stamp";
  ADAM_LSP_STAMP_BUFFER: string = "|buffer";
  ADAM_LSP_STAMP_FILE: string = "|file|";
  ADAM_LSP_STAMP_FOLDER: string = "|folder";
  ADAM_LSP_STAMP_UNREADABLE: string = "|unreadable";
  ADAM_LSP_STAMP_NONE: string = "|none";
  // The window before a check's start in which a path's write time leaves its stamp unknown
  // (git's "racily clean"): a file system stamps a write from a coarser or another host's
  // clock (a timer tick, FAT's 2 s, a WSL or network drive), so a write the check may have
  // missed can show a time a little before the check began
  ADAM_LSP_STAMP_RACY_NS: int64 = 2000000000;

type
  // Where the session is: before initialize, serving, after shutdown
  LSPState = choices(Uninitialized, Running, Shutdown);

  // The reports of one check about one file (indexes into the check's reports)
  LSPReportGroup = record
    FileName: string;
    Reports: Int64Array;
  end;

  LSPReportGroupArray = array of LSPReportGroup;

  // One entry of a call hierarchy answer: the other end's key and item, the calls' callee
  // ranges [Starts, Ends) in Document (the caller's file)
  LSPCallGroup = object
    Key: string;
    Item: JSON;
    Document: ref LSPDocument;
    Starts: Int64Array;
    Ends: Int64Array;

    init(const AKey: string; const AItem: JSON; const ADocument: ref LSPDocument);
    begin
      self.Key := AKey;
      self.Item := AItem;
      self.Document := ADocument;
    end;
  end;

  LSPCallGroupArray = array of ref LSPCallGroup;

// AText added at the end of AList
func DoAppend(var AList: StringArray; const AText: string);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := AText;
end;

// AValue added at the end of AList
func DoAppendIndex(var AList: Int64Array; const AValue: int64);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := AValue;
end;

// The index of AText in AList (exact text); -1 when it is not there
func DoIndexOf(const AList: StringArray; const AText: string): int64;
var
  LI: int64;
begin
  for LI := 0 to len(AList) - 1 do
    if AList[LI] = AText then
      return LI;
    end;
  end;
  return -1;
end;

// AList without its item at AIndex, the others in their order
func DoRemoveAt(var AList: StringArray; const AIndex: int64);
var
  LI: int64;
begin
  for LI := AIndex to len(AList) - 2 do
    AList[LI] := AList[LI + 1];
  end;
  setlength(AList, len(AList) - 1);
end;

// True when AChar is part of a word (a name, a number): what a report's range runs over
func DoIsWordByte(const AChar: char): bool;
begin
  return ((AChar >= 'A') and (AChar <= 'Z')) or ((AChar >= 'a') and (AChar <= 'z')) or
    ((AChar >= '0') and (AChar <= '9')) or (AChar = '_');
end;

// The bytes a report's range covers from the byte offset AOffset of AText: the word there,
// else the one character there; 0 at a line's end or the text's
func DoRangeLength(const AText: string; const AOffset: int64): int64;
var
  LAt: int64;
  LCode: uint32;
begin
  if (AOffset < 0) or (AOffset >= len(AText)) then
    return 0;
  end;
  if (AText[AOffset] = '\n') or (AText[AOffset] = '\r') then
    return 0;
  end;
  LAt := AOffset;
  if DoIsWordByte(AText[LAt]) then
    while (LAt < len(AText)) and DoIsWordByte(AText[LAt]) do
      LAt := LAt + 1;
    end;
    return LAt - AOffset;
  end;
  LCode := DecodeUTF8Char(AText, LAt);
  return LAt - AOffset;
end;

// AList as a JSON array under AKey of AJSON
func DoAddList(var AJSON: JSON; const AKey: string; const AList: StringArray);
var
  LI: int64;
begin
  AJSON.BeginArray(AKey);
  for LI := 0 to len(AList) - 1 do
    AJSON.Add(AList[LI]);
  end;
  AJSON.EndArray();
end;

// The PositionEncodingKind AEncoding is written as
func DoEncodingText(const AEncoding: LSPEncoding): string;
begin
  if AEncoding = LSPEncoding.UTF8 then
    return ADAM_LSP_ENCODING_UTF8;
  end;
  if AEncoding = LSPEncoding.UTF32 then
    return ADAM_LSP_ENCODING_UTF32;
  end;
  return ADAM_LSP_ENCODING_UTF16;
end;

// True when the URIs AFirst and ASecond name the same file: the same text, or file URIs whose
// paths the OS takes for one file (a client's file:///c%3A/x and the server's file:///C:/x)
func DoSameFile(const AFirst: string; const ASecond: string): bool;
var
  LFirst: string;
  LSecond: string;
begin
  if AFirst = ASecond then
    return true;
  end;
  if not (URIToPath(AFirst, LFirst) and URIToPath(ASecond, LSecond)) then
    return false;
  end;
  return SamePath(LFirst, LSecond);
end;

// The DiagnosticSeverity of ALevel
func DoSeverity(const ALevel: Severity): int64;
begin
  if ALevel = Severity.Hint then
    return ADAM_LSP_SEVERITY_HINT;
  end;
  if ALevel = Severity.Warning then
    return ADAM_LSP_SEVERITY_WARNING;
  end;
  return ADAM_LSP_SEVERITY_ERROR;
end;

// No reports (a clear's)
func DoNoIndexes(): Int64Array;
var
  LNone: Int64Array;
begin
  setlength(LNone, 0);
  return LNone;
end;

// A message to send: jsonrpc first, the rest added by the caller
func DoNewMessage(): JSON;
var
  LMessage: JSON;
begin
  LMessage.Add("jsonrpc", ADAM_LSP_JSONRPC);
  return LMessage;
end;

// The position AOffset of ADocument as an LSP Position object
func DoPosition(const ADocument: ref LSPDocument; const AOffset: int64;
  const AEncoding: LSPEncoding): JSON;
var
  LJSON: JSON;
  LLine: int64;
  LCharacter: int64;
begin
  ADocument.PositionAt(AOffset, AEncoding, LLine, LCharacter);
  LJSON.Add("line", LLine);
  LJSON.Add("character", LCharacter);
  return LJSON;
end;

// The bytes [AStart, AEnd) of ADocument as an LSP Range object
func DoRangeOf(const ADocument: ref LSPDocument; const AStart: int64; const AEnd: int64;
  const AEncoding: LSPEncoding): JSON;
var
  LJSON: JSON;
begin
  LJSON.Add("start", DoPosition(ADocument, AStart, AEncoding));
  LJSON.Add("end", DoPosition(ADocument, AEnd, AEncoding));
  return LJSON;
end;

// The LSP Diagnostic of AReport, placed in ADocument's text: its range from its place over the
// word there (DoRangeLength), severity, code, source and message
func DoDiagnostic(const ADocument: ref LSPDocument; const AReport: ref Diagnostic;
  const AEncoding: LSPEncoding): JSON;
var
  LItem: JSON;
  LRange: JSON;
  LOffset: int64;
begin
  LOffset := ADocument.OffsetOfPlace(int64(AReport.Line), int64(AReport.Column));
  LRange.Add("start", DoPosition(ADocument, LOffset, AEncoding));
  LRange.Add("end", DoPosition(ADocument, LOffset + DoRangeLength(ADocument.Text, LOffset),
    AEncoding));
  LItem.Add("range", LRange);
  LItem.Add("severity", DoSeverity(AReport.Level));
  if AReport.Code <> "" then
    LItem.Add("code", AReport.Code);
  end;
  LItem.Add("source", ADAM_LSP_SOURCE);
  LItem.Add("message", AReport.Text());
  return LItem;
end;

// The index of the group of AGroups keyed AKey; -1 when none is
func DoGroupIndex(const AGroups: LSPCallGroupArray; const AKey: string): int64;
var
  LI: int64;
begin
  for LI := 0 to len(AGroups) - 1 do
    if AGroups[LI].Key = AKey then
      return LI;
    end;
  end;
  return -1;
end;

// True when AValue is in AList
func DoHasIndex(const AList: Int64Array; const AValue: int64): bool;
var
  LI: int64;
begin
  for LI := 0 to len(AList) - 1 do
    if AList[LI] = AValue then
      return true;
    end;
  end;
  return false;
end;

type
  // The server's session (see the header)
  LSPServer = object
    hidden FTransport: ref ProtocolTransport;
    // Module paths every check adds after the compiler's own (a row's: the std beside it)
    hidden FModulePaths: StringArray;
    hidden FState: LSPState;
    hidden FEncoding: LSPEncoding;
    hidden FDocuments: array of ref LSPDocument;
    // The URIs of the documents changed since their last check
    hidden FDirty: StringArray;
    // What the checks published, by URI: the document whose check did (its owner)
    hidden FPublishedUris: StringArray;
    hidden FPublishedOwners: StringArray;
    // Each checked document's last check, by URI (its tree for the requests on positions)
    hidden FCheckUris: StringArray;
    hidden FChecks: array of ref Compiler;
    // Each kept check's disk stamp, taken as it was kept (DoDiskStamp; "" = unknown: a path
    // was written while the check ran), by the same index as FCheckUris
    hidden FCheckStamps: StringArray;
    hidden FExitWanted: bool;
    hidden FExitCode: int32;
    // The watched files: the client takes registrations (initialize), the set registered
    // last (its paths one per line, "" for none) and its registration's number
    hidden FWatchCanRegister: bool;
    hidden FWatchText: string;
    hidden FWatchSerial: int64;
    // The client's target triple ("" = none): the main module's where it names no @target
    hidden FTarget: string;

    init(const ATransport: ref ProtocolTransport; const AModulePaths: StringArray);
    begin
      self.FTransport := ATransport;
      self.FModulePaths := AModulePaths;
      self.FState := LSPState.Uninitialized;
      self.FEncoding := LSPEncoding.UTF16;
      self.FExitWanted := false;
      self.FExitCode := ADAM_LSP_EXIT_NO_SHUTDOWN;
      self.FWatchCanRegister := false;
      self.FWatchText := "";
      self.FWatchSerial := 0;
      self.FTarget := "";
    end;

    // Serves the transport until "exit" or the end of its input: an ADAM_LSP_EXIT_* code
    method Serve(): int32;
    var
      LBody: string;
      LRead: ProtocolRead;
    begin
      while not self.FExitWanted do
        LRead := self.FTransport.ReadMessage(LBody);
        if LRead = ProtocolRead.Message then
          self.DoHandleMessage(LBody);
        else
          if LRead = ProtocolRead.Malformed then
            self.DoLog(NoArgs().Fill(ADAM_MSG_LSP_MALFORMED));
          else
            // The input ended with no "exit": the client is gone
            self.DoRequestExit();
          end;
        end;
        // Idle: the documents changed are checked once no message waits
        if (not self.FExitWanted) and (self.FState = LSPState.Running) and
          (len(self.FDirty) > 0) and not self.FTransport.HasPending() then
          self.DoFlushDiagnostics();
        end;
      end;
      return self.FExitCode;
    end;

    // -- Messages out

    // AMessage (made by DoNewMessage) sent; a client that cannot be written to ends the
    // session
    hidden method DoSend(const AMessage: JSON);
    begin
      if not self.FTransport.WriteMessage(AMessage.ToString()) then
        self.DoRequestExit();
      end;
    end;

    // The response to the request AId with AResult (null when AIsNull)
    hidden method DoResult(const AId: JSON; const AResult: JSON; const AIsNull: bool);
    var
      LMessage: JSON;
    begin
      LMessage := DoNewMessage();
      LMessage.Add("id", AId);
      if AIsNull then
        LMessage.AddNull("result");
      else
        LMessage.Add("result", AResult);
      end;
      self.DoSend(LMessage);
    end;

    // An error response of ACode saying AMessage to the request AId (id null when not
    // AHasId: an id that could not be read)
    hidden method DoError(const AId: JSON; const AHasId: bool; const ACode: int64;
      const AMessage: string);
    var
      LMessage: JSON;
      LError: JSON;
    begin
      LMessage := DoNewMessage();
      if AHasId then
        LMessage.Add("id", AId);
      else
        LMessage.AddNull("id");
      end;
      LError.Add("code", ACode);
      LError.Add("message", AMessage);
      LMessage.Add("error", LError);
      self.DoSend(LMessage);
    end;

    // An error window/logMessage saying AMessage
    hidden method DoLog(const AMessage: string);
    var
      LMessage: JSON;
      LParams: JSON;
    begin
      LMessage := DoNewMessage();
      LMessage.Add("method", ADAM_LSP_LOG_MESSAGE);
      LParams.Add("type", ADAM_LSP_MESSAGE_ERROR);
      LParams.Add("message", AMessage);
      LMessage.Add("params", LParams);
      self.DoSend(LMessage);
    end;

    // A warning window/showMessage saying AMessage (the user sees it)
    hidden method DoShowWarning(const AMessage: string);
    var
      LMessage: JSON;
      LParams: JSON;
    begin
      LMessage := DoNewMessage();
      LMessage.Add("method", ADAM_LSP_SHOW_MESSAGE);
      LParams.Add("type", ADAM_LSP_MESSAGE_WARNING);
      LParams.Add("message", AMessage);
      LMessage.Add("params", LParams);
      self.DoSend(LMessage);
    end;

    // The notification AMethod's params were not what it takes
    hidden method DoBadParams(const AMethod: string);
    begin
      self.DoLog(NoArgs().Str(AMethod).Fill(ADAM_MSG_LSP_BAD_PARAMS));
    end;

    hidden method DoRequestExit();
    begin
      self.FExitWanted := true;
      if self.FState = LSPState.Shutdown then
        self.FExitCode := ADAM_LSP_EXIT_SHUTDOWN;
      else
        self.FExitCode := ADAM_LSP_EXIT_NO_SHUTDOWN;
      end;
    end;

    // -- Messages in

    hidden method DoHandleMessage(const ABody: string);
    var
      LMessage: JSON;
      LId: JSON;
      LParams: JSON;
      LHasId: bool;
      LIdGood: bool;
      LVersion: string;
      LMethod: string;
      LNone: JSON;
    begin
      if not JSON.TryFromString(ABody, LMessage) then
        self.DoError(LNone, false, ADAM_LSP_ERROR_PARSE, NoArgs().Fill(ADAM_MSG_LSP_PARSE_ERROR));
        return;
      end;
      // A batch (an array) is not LSP's
      if not LMessage.IsObject() then
        self.DoError(LNone, false, ADAM_LSP_ERROR_INVALID_REQUEST,
          NoArgs().Fill(ADAM_MSG_LSP_INVALID_REQUEST));
        return;
      end;
      // An id that is neither a number nor a string is answered with id null
      LHasId := LMessage.Has("id", true);
      LId := LMessage.Get("id", true);
      LIdGood := LHasId and (LId.IsNumber() or LId.IsString());
      LVersion := "";
      if not (LMessage.TryGetString("jsonrpc", LVersion, true) and
        (LVersion = ADAM_LSP_JSONRPC)) then
        self.DoError(LId, LIdGood, ADAM_LSP_ERROR_INVALID_REQUEST,
          NoArgs().Fill(ADAM_MSG_LSP_INVALID_REQUEST));
        return;
      end;
      if not LMessage.TryGetString("method", LMethod, true) then
        // A response to a request of the server's (the watchers' registrations): taken
        // quietly, nothing waits for it
        if LHasId and (LMessage.Has("result", true) or LMessage.Has("error", true)) then
          return;
        end;
        self.DoError(LId, LIdGood, ADAM_LSP_ERROR_INVALID_REQUEST,
          NoArgs().Fill(ADAM_MSG_LSP_INVALID_REQUEST));
        return;
      end;
      // No params: a missing value, every read of it false
      LParams := LMessage.Get("params", true);
      if not LHasId then
        self.DoNotification(LMethod, LParams);
        return;
      end;
      if not LIdGood then
        self.DoError(LId, false, ADAM_LSP_ERROR_INVALID_REQUEST,
          NoArgs().Fill(ADAM_MSG_LSP_INVALID_REQUEST));
        return;
      end;
      self.DoRequest(LId, LMethod, LParams);
    end;

    hidden method DoRequest(const AId: JSON; const AMethod: string; const AParams: JSON);
    var
      LNone: JSON;
    begin
      // The lifecycle's rules first
      if self.FState = LSPState.Shutdown then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_REQUEST,
          NoArgs().Fill(ADAM_MSG_LSP_SHUT_DOWN));
        return;
      end;
      if (AMethod = ADAM_LSP_INITIALIZE) and (self.FState <> LSPState.Uninitialized) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_REQUEST,
          NoArgs().Fill(ADAM_MSG_LSP_ALREADY_INITIALIZED));
        return;
      end;
      if (AMethod <> ADAM_LSP_INITIALIZE) and (self.FState = LSPState.Uninitialized) then
        self.DoError(AId, true, ADAM_LSP_ERROR_NOT_INITIALIZED,
          NoArgs().Fill(ADAM_MSG_LSP_NOT_INITIALIZED));
        return;
      end;
      if AMethod = ADAM_LSP_INITIALIZE then
        self.DoResult(AId, self.DoInitialize(AParams), false);
        self.FState := LSPState.Running;
        return;
      end;
      if AMethod = ADAM_LSP_SHUTDOWN then
        self.FState := LSPState.Shutdown;
        self.DoResult(AId, LNone, true);
        return;
      end;
      if AMethod = ADAM_LSP_SEMANTIC_FULL then
        self.DoSemanticTokens(AId, AParams);
        return;
      end;
      if (AMethod = ADAM_LSP_HOVER) or (AMethod = ADAM_LSP_DEFINITION) then
        self.DoPositionRequest(AId, AMethod, AParams);
        return;
      end;
      if AMethod = ADAM_LSP_DOCUMENT_SYMBOL then
        self.DoDocumentSymbol(AId, AParams);
        return;
      end;
      if AMethod = ADAM_LSP_WORKSPACE_SYMBOL then
        self.DoWorkspaceSymbol(AId, AParams);
        return;
      end;
      if AMethod = ADAM_LSP_COMPLETION then
        self.DoCompletion(AId, AParams);
        return;
      end;
      if AMethod = ADAM_LSP_INLAY_HINT then
        self.DoInlayHint(AId, AParams);
        return;
      end;
      if AMethod = ADAM_LSP_PREPARE_CALLS then
        self.DoPrepareCalls(AId, AParams);
        return;
      end;
      if (AMethod = ADAM_LSP_INCOMING_CALLS) or (AMethod = ADAM_LSP_OUTGOING_CALLS) then
        self.DoCalls(AId, AMethod, AParams);
        return;
      end;
      if (AMethod = ADAM_LSP_FORMATTING) or (AMethod = ADAM_LSP_RANGE_FORMATTING) then
        self.DoFormatting(AId, AMethod, AParams);
        return;
      end;
      // Unknown requests, $/ ones too, fail
      self.DoError(AId, true, ADAM_LSP_ERROR_METHOD_NOT_FOUND,
        NoArgs().Str(AMethod).Fill(ADAM_MSG_LSP_METHOD_NOT_FOUND));
    end;

    hidden method DoNotification(const AMethod: string; const AParams: JSON);
    begin
      if AMethod = ADAM_LSP_EXIT then
        self.DoRequestExit();
        return;
      end;
      // Dropped before initialize and after shutdown
      if self.FState <> LSPState.Running then
        return;
      end;
      if AMethod = ADAM_LSP_DID_OPEN then
        self.DoDidOpen(AParams);
        return;
      end;
      if AMethod = ADAM_LSP_DID_CHANGE then
        self.DoDidChange(AParams);
        return;
      end;
      if AMethod = ADAM_LSP_DID_CLOSE then
        self.DoDidClose(AParams);
        return;
      end;
      if AMethod = ADAM_LSP_DID_CHANGE_WATCHED then
        self.DoDidChangeWatched();
        return;
      end;
      if AMethod = ADAM_LSP_DID_CHANGE_CONFIGURATION then
        self.DoDidChangeConfiguration(AParams);
        return;
      end;
      // "initialized", $/ notifications and unknown ones need nothing
    end;

    // -- Lifecycle

    hidden method DoInitialize(const AParams: JSON): JSON;
    var
      LResult: JSON;
    begin
      self.FEncoding := self.DoNegotiateEncoding(AParams);
      // Watchers are registered only with a client that says it takes them (a value that
      // is no boolean reads as no)
      if not AParams.TryGetBoolean(ADAM_LSP_WATCH_CAPABILITY, self.FWatchCanRegister) then
        self.FWatchCanRegister := false;
      end;
      // No document is open yet: what it changes needs no check
      self.DoTakeTarget(AParams, ADAM_LSP_INIT_TARGET, ADAM_LSP_INITIALIZE);
      LResult.BeginObject("capabilities");
      LResult.Add("positionEncoding", DoEncodingText(self.FEncoding));
      LResult.BeginObject("textDocumentSync");
      LResult.Add("openClose", true);
      LResult.Add("change", ADAM_LSP_SYNC_INCREMENTAL);
      LResult.EndObject();
      LResult.BeginObject("semanticTokensProvider");
      LResult.BeginObject("legend");
      DoAddList(LResult, "tokenTypes", TokenTypeNames());
      DoAddList(LResult, "tokenModifiers", TokenModifierNames());
      LResult.EndObject();
      LResult.Add("full", true);
      LResult.EndObject();
      LResult.Add("hoverProvider", true);
      LResult.Add("definitionProvider", true);
      LResult.Add("documentSymbolProvider", true);
      LResult.Add("workspaceSymbolProvider", true);
      LResult.BeginObject("completionProvider");
      LResult.BeginArray("triggerCharacters");
      LResult.Add(ADAM_LSP_TRIGGER_DOT);
      LResult.Add(ADAM_LSP_TRIGGER_ARROW);
      LResult.EndArray();
      LResult.Add("resolveProvider", false);
      LResult.EndObject();
      LResult.Add("inlayHintProvider", true);
      LResult.Add("callHierarchyProvider", true);
      LResult.Add("documentFormattingProvider", true);
      LResult.Add("documentRangeFormattingProvider", true);
      LResult.BeginObject("experimental");
      LResult.BeginObject(ADAM_LSP_WORDS_KEY);
      DoAddList(LResult, "keywords", ReservedWords(false));
      DoAddList(LResult, "types", ReservedWords(true));
      DoAddList(LResult, "contextWords", ContextWords());
      LResult.EndObject();
      LResult.EndObject();
      LResult.EndObject();
      LResult.BeginObject("serverInfo");
      LResult.Add("name", ADAM_LSP_SERVER_NAME);
      LResult.Add("version", AdamVersionText());
      LResult.EndObject();
      return LResult;
    end;

    // The client lists encodings by preference: the first one taken; without a list UTF-16,
    // which every client takes
    hidden const method DoNegotiateEncoding(const AParams: JSON): LSPEncoding;
    var
      LList: JSON;
      LItems: array of JSON;
      LI: int64;
      LName: string;
    begin
      if not AParams.TryGetArray("capabilities.general.positionEncodings", LList) then
        return LSPEncoding.UTF16;
      end;
      LItems := LList.Items();
      for LI := 0 to len(LItems) - 1 do
        // An entry that is no string names no encoding
        if LItems[LI].IsString() then
          LName := LItems[LI].AsString();
          if LName = ADAM_LSP_ENCODING_UTF16 then
            return LSPEncoding.UTF16;
          end;
          if LName = ADAM_LSP_ENCODING_UTF8 then
            return LSPEncoding.UTF8;
          end;
          if LName = ADAM_LSP_ENCODING_UTF32 then
            return LSPEncoding.UTF32;
          end;
        end;
      end;
      return LSPEncoding.UTF16;
    end;

    // -- Documents

    // The index of the open document for the URI AURI; -1 when none is. The same text matches
    // first; else the file AURI names as the OS compares paths (DoSameFile's rule), since a
    // client may open a file under one spelling of its URI and ask under another (Monaco's
    // bridge opens file:///c%3a/... lowercased and asks with the model's own case)
    hidden const method DoDocumentIndex(const AURI: string): int64;
    var
      LI: int64;
      LPath: string;
    begin
      for LI := 0 to len(self.FDocuments) - 1 do
        if self.FDocuments[LI].URI = AURI then
          return LI;
        end;
      end;
      if not URIToPath(AURI, LPath) then
        return -1;
      end;
      LPath := ResolvePath(LPath);
      for LI := 0 to len(self.FDocuments) - 1 do
        if (self.FDocuments[LI].Path <> "") and SamePath(self.FDocuments[LI].Path, LPath) then
          return LI;
        end;
      end;
      return -1;
    end;

    // The open document of the URI AURI (DoDocumentIndex); nil when none is
    hidden const method DoFind(const AURI: string): ref LSPDocument;
    var
      LAt: int64;
    begin
      LAt := self.DoDocumentIndex(AURI);
      if LAt < 0 then
        return nil;
      end;
      return self.FDocuments[LAt];
    end;

    // The open document whose file is APath (as the OS compares paths); nil when none is
    hidden const method DoOpenFor(const APath: string): ref LSPDocument;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FDocuments) - 1 do
        if (self.FDocuments[LI].Path <> "") and SamePath(self.FDocuments[LI].Path, APath) then
          return self.FDocuments[LI];
        end;
      end;
      return nil;
    end;

    // The document of AURI is checked at the next idle
    hidden method DoMarkDirty(const AURI: string);
    begin
      if DoIndexOf(self.FDirty, AURI) < 0 then
        DoAppend(self.FDirty, AURI);
      end;
    end;

    hidden method DoDidOpen(const AParams: JSON);
    var
      LURI: string;
      LText: string;
      LVersion: int64;
      LPath: string;
      LDocument: ref LSPDocument;
      LI: int64;
      LCount: int64;
      LOld: string;
      LAt: int64;
    begin
      if not (AParams.TryGetString("textDocument.uri", LURI) and
        AParams.TryGetString("textDocument.text", LText)) then
        self.DoBadParams(ADAM_LSP_DID_OPEN);
        return;
      end;
      // Optional here: none is version 0
      LVersion := 0;
      AParams.TryGetInt64("textDocument.version", LVersion);
      // The path the front end reads it as; a URI that names no file has none (never checked)
      LPath := "";
      if URIToPath(LURI, LPath) then
        LPath := ResolvePath(LPath);
      end;
      LDocument := ref LSPDocument(LURI, LPath, LVersion, LText);
      // A second didOpen of the same file (any spelling of its URI) replaces the buffer; what
      // was kept under the old spelling goes with the old buffer
      LI := self.DoDocumentIndex(LURI);
      if LI >= 0 then
        LOld := self.FDocuments[LI].URI;
        if LOld <> LURI then
          LAt := DoIndexOf(self.FDirty, LOld);
          if LAt >= 0 then
            DoRemoveAt(self.FDirty, LAt);
          end;
          self.DoDropCheck(LOld);
        end;
        self.FDocuments[LI] := LDocument;
        self.DoMarkDirty(LURI);
        return;
      end;
      LCount := len(self.FDocuments);
      setlength(self.FDocuments, LCount + 1);
      self.FDocuments[LCount] := LDocument;
      self.DoMarkDirty(LURI);
    end;

    // The byte offset of the position at APath of AValue in ADocument into AOffset; false when
    // it is no position
    hidden const method DoOffsetAt(const ADocument: ref LSPDocument; const AValue: JSON;
      const APath: string; var AOffset: int64): bool;
    var
      LLine: int64;
      LCharacter: int64;
    begin
      AOffset := 0;
      if not (AValue.TryGetInt64(APath + ".line", LLine) and
        AValue.TryGetInt64(APath + ".character", LCharacter)) then
        return false;
      end;
      AOffset := ADocument.OffsetAt(LLine, LCharacter, self.FEncoding);
      return true;
    end;

    hidden method DoDidChange(const AParams: JSON);
    var
      LURI: string;
      LDocument: ref LSPDocument;
      LChanges: JSON;
      LItems: array of JSON;
      LRange: JSON;
      LText: string;
      LStart: int64;
      LEnd: int64;
      LVersion: int64;
      LBad: bool;
      LI: int64;
    begin
      LURI := "";
      LDocument := nil;
      if AParams.TryGetString("textDocument.uri", LURI) then
        LDocument := self.DoFind(LURI);
      end;
      if LDocument = nil then
        self.DoBadParams(ADAM_LSP_DID_CHANGE);
        return;
      end;
      // Changes apply in order, each to the text the one before left. One that cannot be read
      // (no text, a range whose ends are no positions) stops the list: the changes after it
      // are relative to a text the buffer no longer holds, so neither they nor the new version
      // are taken
      LBad := false;
      if AParams.TryGetArray("contentChanges", LChanges) then
        LItems := LChanges.Items();
        for LI := 0 to len(LItems) - 1 do
          if not LItems[LI].TryGetString("text", LText) then
            LBad := true;
            leave;
          end;
          if not LItems[LI].TryGetObject("range", LRange) then
            LDocument.ReplaceAll(LText);
          else
            // Both ends from the text before this change
            if not (self.DoOffsetAt(LDocument, LRange, "start", LStart) and
              self.DoOffsetAt(LDocument, LRange, "end", LEnd)) then
              LBad := true;
              leave;
            end;
            LDocument.Replace(LStart, LEnd, LText);
          end;
        end;
      end;
      // The text changed whatever the version says (marked under the URI the buffer is kept by)
      self.DoMarkDirty(LDocument.URI);
      if LBad then
        self.DoBadParams(ADAM_LSP_DID_CHANGE);
        return;
      end;
      if AParams.TryGetInt64("textDocument.version", LVersion) then
        LDocument.SetVersion(LVersion);
      end;
    end;

    hidden method DoDidClose(const AParams: JSON);
    var
      LURI: string;
      LI: int64;
      LCount: int64;
      LNone: StringArray;
      LAt: int64;
    begin
      if not AParams.TryGetString("textDocument.uri", LURI) then
        self.DoBadParams(ADAM_LSP_DID_CLOSE);
        return;
      end;
      // The URI the buffer is kept by (a client may close under another spelling of it): the
      // buffer, its dirty mark, its check and what it published are all keyed by that one
      LAt := self.DoDocumentIndex(LURI);
      if LAt >= 0 then
        LURI := self.FDocuments[LAt].URI;
      end;
      LCount := 0;
      for LI := 0 to len(self.FDocuments) - 1 do
        if self.FDocuments[LI].URI <> LURI then
          self.FDocuments[LCount] := self.FDocuments[LI];
          LCount := LCount + 1;
        end;
      end;
      setlength(self.FDocuments, LCount);
      LAt := DoIndexOf(self.FDirty, LURI);
      if LAt >= 0 then
        DoRemoveAt(self.FDirty, LAt);
      end;
      self.DoDropCheck(LURI);
      // What the closed document's checks published goes, its own URI too (an import that
      // was this buffer is read from its file again at the next check)
      setlength(LNone, 0);
      self.DoClearOwned(LURI, LNone);
      LAt := self.DoPublishedIndex(LURI);
      if LAt >= 0 then
        self.DoPublish(LURI, -1, nil, nil, DoNoIndexes());
        DoRemoveAt(self.FPublishedUris, LAt);
        DoRemoveAt(self.FPublishedOwners, LAt);
      end;
      // Its file is no buffer now: watched when a check still reads it
      self.DoUpdateWatchers();
    end;

    // -- Watched files

    // The target at APath of AParams (see the header) taken; true when it changed. No key there:
    // unchanged; no string, or a triple Adam has no target for: told (AMethod's bad params),
    // unchanged
    hidden method DoTakeTarget(const AParams: JSON; const APath: string;
      const AMethod: string): bool;
    var
      LTriple: string;
    begin
      if not AParams.Has(APath) then
        return false;
      end;
      if not AParams.TryGetString(APath, LTriple) then
        self.DoBadParams(AMethod);
        return false;
      end;
      if (LTriple <> "") and (FindTarget(LTriple) = nil) then
        self.DoBadParams(AMethod);
        return false;
      end;
      if LTriple = self.FTarget then
        return false;
      end;
      self.FTarget := LTriple;
      return true;
    end;

    // workspace/didChangeConfiguration: a changed target checks every open document again
    hidden method DoDidChangeConfiguration(const AParams: JSON);
    var
      LI: int64;
    begin
      if not self.DoTakeTarget(AParams, ADAM_LSP_SETTINGS_TARGET,
        ADAM_LSP_DID_CHANGE_CONFIGURATION) then
        return;
      end;
      for LI := 0 to len(self.FDocuments) - 1 do
        self.DoMarkDirty(self.FDocuments[LI].URI);
      end;
    end;

    // workspace/didChangeWatchedFiles: something a check read may have changed on the disk.
    // An open document is checked again at the next idle (each check replaces what it
    // published before) only when what its last check rests on is not as it was then: no
    // kept check, an unknown stamp, or its paths' stamp now differs (DoDiskStamp). The
    // client sends one whenever a watched path starts (its first stat) with no change named,
    // so an unchanged disk re-checks nothing
    hidden method DoDidChangeWatched();
    var
      LAt: int64;
      LI: int64;
    begin
      for LI := 0 to len(self.FDocuments) - 1 do
        LAt := DoIndexOf(self.FCheckUris, self.FDocuments[LI].URI);
        if (LAt < 0) or (self.FCheckStamps[LAt] = "") or
          (self.DoDiskStamp(self.FChecks[LAt].DiskPaths(), -1) <> self.FCheckStamps[LAt]) then
          self.DoMarkDirty(self.FDocuments[LI].URI);
        end;
      end;
    end;

    // One path's line of a disk stamp (DoDiskStamp) into ALine: an open document's file is
    // its buffer (a check reads the buffer, not the disk); a file its write time and size; a
    // folder its files' names and write times; else none. False when a file there was written
    // within ADAM_LSP_STAMP_RACY_NS before AStart or after it (AStart < 0: no such guard), so
    // the check may not have seen it
    hidden const method DoPathStamp(const APath: string; const AStart: int64;
      var ALine: string): bool;
    var
      LNames: StringArray;
      LTime: int64;
      LRacy: int64;
      LI: int64;
    begin
      LRacy := AStart - ADAM_LSP_STAMP_RACY_NS;
      if self.DoOpenFor(APath) <> nil then
        ALine := APath + ADAM_LSP_STAMP_BUFFER;
        return true;
      end;
      if FileExists(APath) then
        LTime := FileWriteTime(APath);
        if (AStart >= 0) and (LTime >= LRacy) then
          return false;
        end;
        ALine := APath + ADAM_LSP_STAMP_FILE + IntToStr(LTime) + "|" + IntToStr(FileSize(APath));
        return true;
      end;
      if DirectoryExists(APath) then
        if not GetFiles(APath, LNames) then
          ALine := APath + ADAM_LSP_STAMP_UNREADABLE;
          return true;
        end;
        ALine := APath + ADAM_LSP_STAMP_FOLDER;
        for LI := 0 to len(LNames) - 1 do
          LTime := FileWriteTime(APath + "/" + LNames[LI]);
          if (AStart >= 0) and (LTime >= LRacy) then
            return false;
          end;
          ALine := ALine + "|" + LNames[LI] + ":" + IntToStr(LTime);
        end;
        return true;
      end;
      ALine := APath + ADAM_LSP_STAMP_NONE;
      return true;
    end;

    // The disk stamp of APaths (a check's DiskPaths): ADAM_LSP_STAMP_HEAD, then each path's
    // line (DoPathStamp); "" (unknown) when one was written around or after AStart, the time
    // the check began (NowNanos, FileWriteTime's clock; AStart < 0: no such guard). Two stamps of
    // the same paths are the same text exactly when nothing they name changed
    hidden const method DoDiskStamp(const APaths: StringArray; const AStart: int64): string;
    var
      LText: string;
      LLine: string;
      LI: int64;
    begin
      LText := ADAM_LSP_STAMP_HEAD;
      for LI := 0 to len(APaths) - 1 do
        LLine := "";
        if not self.DoPathStamp(APaths[LI], AStart, LLine) then
          return "";
        end;
        LText := LText + "\n" + LLine;
      end;
      return LText;
    end;

    // The watched set: every kept check's DiskPaths once (SamePath), the open documents'
    // files left out (their buffers speak), sorted, so the same set reads as the same text.
    // A changed set is registered (one watcher per path, its globPattern the path itself:
    // a file, or a folder and what is under it) BEFORE the old one is unregistered: a path
    // in both keeps its running watcher, so a change between the two is not missed. Only
    // with a client that takes registrations (initialize)
    hidden method DoUpdateWatchers();
    var
      LSet: StringArray;
      LPaths: StringArray;
      LText: string;
      LOldSerial: int64;
      LHadOld: bool;
      LParams: JSON;
      LUnregister: JSON;
      LI: int64;
      LJ: int64;
      LK: int64;
      LSeen: bool;
    begin
      if not self.FWatchCanRegister then
        return;
      end;
      setlength(LSet, 0);
      for LI := 0 to len(self.FChecks) - 1 do
        LPaths := self.FChecks[LI].DiskPaths();
        for LJ := 0 to len(LPaths) - 1 do
          if self.DoOpenFor(LPaths[LJ]) = nil then
            LSeen := false;
            for LK := 0 to len(LSet) - 1 do
              if SamePath(LSet[LK], LPaths[LJ]) then
                LSeen := true;
                leave;
              end;
            end;
            if not LSeen then
              DoAppend(LSet, LPaths[LJ]);
            end;
          end;
        end;
      end;
      SortStrings(LSet);
      LText := JoinStrings(LSet, "\n");
      if LText = self.FWatchText then
        return;
      end;
      LOldSerial := self.FWatchSerial;
      LHadOld := self.FWatchText <> "";
      self.FWatchText := LText;
      if len(LSet) > 0 then
        self.FWatchSerial := self.FWatchSerial + 1;
        LParams.BeginArray("registrations");
        LParams.BeginObject();
        LParams.Add("id", ADAM_LSP_WATCH_ID + IntToStr(self.FWatchSerial));
        LParams.Add("method", ADAM_LSP_DID_CHANGE_WATCHED);
        LParams.BeginObject("registerOptions");
        LParams.BeginArray("watchers");
        for LI := 0 to len(LSet) - 1 do
          LParams.BeginObject();
          LParams.Add("globPattern", LSet[LI]);
          LParams.EndObject();
        end;
        LParams.EndArray();
        LParams.EndObject();
        LParams.EndObject();
        LParams.EndArray();
        self.DoSendRequest(ADAM_LSP_WATCH_REGISTER_ID + IntToStr(self.FWatchSerial),
          ADAM_LSP_REGISTER_CAPABILITY, LParams);
      end;
      if LHadOld then
        // "unregisterations" is the protocol's own spelling (LSP 3.17)
        LUnregister.BeginArray("unregisterations");
        LUnregister.BeginObject();
        LUnregister.Add("id", ADAM_LSP_WATCH_ID + IntToStr(LOldSerial));
        LUnregister.Add("method", ADAM_LSP_DID_CHANGE_WATCHED);
        LUnregister.EndObject();
        LUnregister.EndArray();
        self.DoSendRequest(ADAM_LSP_WATCH_UNREGISTER_ID + IntToStr(LOldSerial),
          ADAM_LSP_UNREGISTER_CAPABILITY, LUnregister);
      end;
    end;

    // A request of the server's own, AMethod with AParams under the id AId (the client's
    // response is taken quietly: DoHandleMessage)
    hidden method DoSendRequest(const AId: string; const AMethod: string; const AParams: JSON);
    var
      LMessage: JSON;
    begin
      LMessage := DoNewMessage();
      LMessage.Add("id", AId);
      LMessage.Add("method", AMethod);
      LMessage.Add("params", AParams);
      self.DoSend(LMessage);
    end;

    // -- Diagnostics

    // Every document changed since its last check, checked (the marks cleared first)
    hidden method DoFlushDiagnostics();
    var
      LUris: StringArray;
      LI: int64;
      LDocument: ref LSPDocument;
    begin
      LUris := self.FDirty;
      setlength(self.FDirty, 0);
      for LI := 0 to len(LUris) - 1 do
        LDocument := self.DoFind(LUris[LI]);
        if LDocument <> nil then
          self.DoCheckRun(LDocument);
        end;
      end;
      self.DoUpdateWatchers();
    end;

    // ADocument checked and its diagnostics published (see the header)
    hidden method DoCheckRun(const ADocument: ref LSPDocument);
    var
      LCompiler: ref Compiler;
      LMain: Int64Array;
      LGroups: LSPReportGroupArray;
      LKept: Int64Array;
      LSeen: StringArray;
      LFile: string;
      LText: string;
      LTarget: ref LSPDocument;
      LI: int64;
      LJ: int64;
      LGroup: int64;
      LStart: int64;
    begin
      // Before anything is read: a path written from here on may be one this check missed
      LStart := NowNanos();
      LCompiler := ref Compiler();
      setlength(LMain, 0);
      setlength(LGroups, 0);
      setlength(LSeen, 0);
      if ADocument.Path <> "" then
        // The client's target where the document names no @target (see the header)
        if self.FTarget <> "" then
          LCompiler.SetDefaultTarget(self.FTarget);
        end;
        for LI := 0 to len(self.FModulePaths) - 1 do
          LCompiler.AddModulePath(self.FModulePaths[LI]);
        end;
        // Every open buffer stands in for its file
        for LI := 0 to len(self.FDocuments) - 1 do
          if self.FDocuments[LI].Path <> "" then
            LCompiler.GiveText(self.FDocuments[LI].Path, self.FDocuments[LI].Text);
          end;
        end;
        LCompiler.CheckDocument(ADocument.Path);
        // The reports by file: one with no file is the document's
        for LI := 0 to LCompiler.Reports.Count - 1 do
          LFile := LCompiler.Reports.Items[LI].FileName;
          if (LFile = "") or SamePath(LFile, ADocument.Path) then
            DoAppendIndex(LMain, LI);
          else
            LGroup := -1;
            for LJ := 0 to len(LGroups) - 1 do
              if SamePath(LGroups[LJ].FileName, LFile) then
                LGroup := LJ;
                leave;
              end;
            end;
            if LGroup < 0 then
              LGroup := len(LGroups);
              setlength(LGroups, LGroup + 1);
              LGroups[LGroup].FileName := LFile;
              setlength(LGroups[LGroup].Reports, 0);
            end;
            DoAppendIndex(LGroups[LGroup].Reports, LI);
          end;
        end;
      end;
      // The document itself
      self.DoPublish(ADocument.URI, ADocument.Version, ADocument, LCompiler.Reports, LMain);
      DoAppend(LSeen, ADocument.URI);
      // The imported files that are not open: their errors
      for LI := 0 to len(LGroups) - 1 do
        if self.DoOpenFor(LGroups[LI].FileName) = nil then
          setlength(LKept, 0);
          for LJ := 0 to len(LGroups[LI].Reports) - 1 do
            if LCompiler.Reports.Items[LGroups[LI].Reports[LJ]].IsError() then
              DoAppendIndex(LKept, LGroups[LI].Reports[LJ]);
            end;
          end;
          if len(LKept) > 0 then
            LText := "";
            LCompiler.LoadedText(LGroups[LI].FileName, LText);
            // A client never shows a file's BOM: positions count from after it
            if StartsStr(ADAM_LSP_DOCUMENT_BOM, LText) then
              LText := Substring(LText, len(ADAM_LSP_DOCUMENT_BOM),
                len(LText) - len(ADAM_LSP_DOCUMENT_BOM));
            end;
            LTarget := ref LSPDocument(PathToURI(LGroups[LI].FileName), LGroups[LI].FileName, -1,
              LText);
            self.DoPublish(LTarget.URI, -1, LTarget, LCompiler.Reports, LKept);
            DoAppend(LSeen, LTarget.URI);
          end;
        end;
      end;
      // What this owner published before and not now is cleared
      self.DoClearOwned(ADocument.URI, LSeen);
      for LI := 0 to len(LSeen) - 1 do
        self.DoSetOwner(LSeen[LI], ADocument.URI);
      end;
      // The tree a document that names a file got: the requests on it read this one
      if ADocument.Path <> "" then
        self.DoKeepCheck(ADocument.URI, LCompiler, LStart);
      end;
    end;

    // -- The kept checks

    // ACompiler kept as the last check of AURI (one before it dropped), with the disk stamp of
    // what it read (DoDiskStamp, guarded by AStart: the time the check began)
    hidden method DoKeepCheck(const AURI: string; const ACompiler: ref Compiler;
      const AStart: int64);
    var
      LAt: int64;
      LCount: int64;
      LStamp: string;
    begin
      LStamp := self.DoDiskStamp(ACompiler.DiskPaths(), AStart);
      LAt := DoIndexOf(self.FCheckUris, AURI);
      if LAt >= 0 then
        self.FChecks[LAt] := ACompiler;
        self.FCheckStamps[LAt] := LStamp;
        return;
      end;
      DoAppend(self.FCheckUris, AURI);
      DoAppend(self.FCheckStamps, LStamp);
      LCount := len(self.FChecks);
      setlength(self.FChecks, LCount + 1);
      self.FChecks[LCount] := ACompiler;
    end;

    // The last check of AURI; nil when it has none
    hidden const method DoCheckOf(const AURI: string): ref Compiler;
    var
      LAt: int64;
    begin
      LAt := DoIndexOf(self.FCheckUris, AURI);
      if LAt < 0 then
        return nil;
      end;
      return self.FChecks[LAt];
    end;

    // AURI's last check dropped (its document closed)
    hidden method DoDropCheck(const AURI: string);
    var
      LAt: int64;
      LI: int64;
    begin
      LAt := DoIndexOf(self.FCheckUris, AURI);
      if LAt < 0 then
        return;
      end;
      DoRemoveAt(self.FCheckUris, LAt);
      DoRemoveAt(self.FCheckStamps, LAt);
      for LI := LAt to len(self.FChecks) - 2 do
        self.FChecks[LI] := self.FChecks[LI + 1];
      end;
      setlength(self.FChecks, len(self.FChecks) - 1);
    end;

    // ADocument as its last check left it: checked now when it changed since (the
    // diagnostics published as at an idle)
    hidden method DoCurrentCheck(const ADocument: ref LSPDocument): ref Compiler;
    var
      LAt: int64;
    begin
      LAt := DoIndexOf(self.FDirty, ADocument.URI);
      if LAt >= 0 then
        DoRemoveAt(self.FDirty, LAt);
        self.DoCheckRun(ADocument);
        self.DoUpdateWatchers();
      end;
      return self.DoCheckOf(ADocument.URI);
    end;

    // -- Requests on documents

    // textDocument/semanticTokens/full (see the header)
    hidden method DoSemanticTokens(const AId: JSON; const AParams: JSON);
    var
      LURI: string;
      LDocument: ref LSPDocument;
      LCheck: ref Compiler;
      LData: Int64Array;
      LResult: JSON;
      LNone: JSON;
      LI: int64;
    begin
      if not AParams.TryGetString("textDocument.uri", LURI) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(ADAM_LSP_SEMANTIC_FULL).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LDocument := self.DoFind(LURI);
      if LDocument = nil then
        self.DoResult(AId, LNone, true);
        return;
      end;
      LCheck := self.DoCurrentCheck(LDocument);
      if LCheck = nil then
        LData := SemanticTokens(LDocument, nil, 0, self.FEncoding);
      else
        LData := SemanticTokens(LDocument, LCheck.Tree, LCheck.MainModule, self.FEncoding);
      end;
      LResult.BeginArray("data");
      for LI := 0 to len(LData) - 1 do
        LResult.Add(LData[LI]);
      end;
      LResult.EndArray();
      self.DoResult(AId, LResult, false);
    end;

    // The text of the file APath as an LSPDocument (its BOM dropped): the open buffer, else
    // the text ACheck read, else the disk; nil when none can be had
    hidden method DoDocumentFor(const ACheck: ref Compiler; const APath: string): ref LSPDocument;
    var
      LOpen: ref LSPDocument;
      LText: string;
    begin
      LOpen := self.DoOpenFor(APath);
      if LOpen <> nil then
        return LOpen;
      end;
      LText := "";
      if not ACheck.LoadedText(APath, LText) then
        if not ReadAllText(APath, LText) then
          return nil;
        end;
      end;
      if StartsStr(ADAM_LSP_DOCUMENT_BOM, LText) then
        LText := Substring(LText, len(ADAM_LSP_DOCUMENT_BOM), len(LText) - len(ADAM_LSP_DOCUMENT_BOM));
      end;
      return ref LSPDocument(PathToURI(APath), APath, -1, LText);
    end;

    // An LSP Range of [AStart, AEnd) in ADocument
    hidden const method DoRange(const ADocument: ref LSPDocument; const AStart: int64;
      const AEnd: int64): JSON;
    var
      LRange: JSON;
    begin
      LRange.Add("start", DoPosition(ADocument, AStart, self.FEncoding));
      LRange.Add("end", DoPosition(ADocument, AEnd, self.FEncoding));
      return LRange;
    end;

    // A hover with no declaration that has a place (Adam.LSP.Hover WordHoverMarkdown): an
    // intrinsic ATarget means, else the word the language defines at AOffset; else null
    hidden method DoWordHover(const AId: JSON; const ADocument: ref LSPDocument;
      const ACheck: ref Compiler; const ATarget: LSPTarget; const AOffset: int64);
    var
      LIntrinsic: Intrinsic;
      LMarkdown: string;
      LStart: int64;
      LEnd: int64;
      LResult: JSON;
      LContents: JSON;
      LNone: JSON;
    begin
      LMarkdown := "";
      LStart := 0;
      LEnd := 0;
      LIntrinsic := Intrinsic.None;
      if ATarget.Found then
        LIntrinsic := ACheck.Tree.IntrinsicOfDecl(ATarget.Decl);
      end;
      if LIntrinsic <> Intrinsic.None then
        LMarkdown := IntrinsicHoverMarkdown(LIntrinsic);
        LStart := ATarget.WordStart;
        LEnd := ATarget.WordEnd;
      else
        if not WordHoverMarkdown(ADocument, AOffset, not ATarget.Found, LMarkdown, LStart,
          LEnd) then
          self.DoResult(AId, LNone, true);
          return;
        end;
      end;
      LContents.Add("kind", ADAM_LSP_MARKUP_MARKDOWN);
      LContents.Add("value", LMarkdown);
      LResult.Add("contents", LContents);
      LResult.Add("range", self.DoRange(ADocument, LStart, LEnd));
      self.DoResult(AId, LResult, false);
    end;

    // textDocument/hover and textDocument/definition (see the header)
    hidden method DoPositionRequest(const AId: JSON; const AMethod: string; const AParams: JSON);
    var
      LURI: string;
      LDocument: ref LSPDocument;
      LCheck: ref Compiler;
      LOffset: int64;
      LTarget: LSPTarget;
      LDecl: int64;
      LDeclDocument: ref LSPDocument;
      LStart: int64;
      LEnd: int64;
      LResult: JSON;
      LContents: JSON;
      LNone: JSON;
    begin
      LOffset := 0;
      if not AParams.TryGetString("textDocument.uri", LURI) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(AMethod).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LDocument := self.DoFind(LURI);
      if LDocument = nil then
        self.DoResult(AId, LNone, true);
        return;
      end;
      if not self.DoOffsetAt(LDocument, AParams, "position", LOffset) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(AMethod).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LCheck := self.DoCurrentCheck(LDocument);
      if LCheck = nil then
        self.DoResult(AId, LNone, true);
        return;
      end;
      LTarget := FindAt(LDocument, LCheck.Tree, LCheck.MainModule, LOffset);
      LDecl := LTarget.Decl;
      if (not LTarget.Found) or (LDecl = 0) or LCheck.Tree[LDecl].Place.IsNone() then
        // No declaration with a place: a word the language defines (HK1), for a hover
        if AMethod = ADAM_LSP_HOVER then
          self.DoWordHover(AId, LDocument, LCheck, LTarget, LOffset);
          return;
        end;
        self.DoResult(AId, LNone, true);
        return;
      end;
      LDeclDocument := self.DoDocumentFor(LCheck, LCheck.Tree[LDecl].Place.FileName);
      if AMethod = ADAM_LSP_HOVER then
        LContents.Add("kind", ADAM_LSP_MARKUP_MARKDOWN);
        LContents.Add("value", HoverMarkdown(LCheck.Tree, LDecl, LDeclDocument,
          LDocument.Path));
        LResult.Add("contents", LContents);
        LResult.Add("range", self.DoRange(LDocument, LTarget.WordStart, LTarget.WordEnd));
        self.DoResult(AId, LResult, false);
        return;
      end;
      if not DeclarationRange(LCheck.Tree, LDecl, LDeclDocument, LStart, LEnd) then
        self.DoResult(AId, LNone, true);
        return;
      end;
      LResult.Add("uri", LDeclDocument.URI);
      LResult.Add("range", self.DoRange(LDeclDocument, LStart, LEnd));
      self.DoResult(AId, LResult, false);
    end;

    // -- Symbols

    // The entry AId of ATree (its file's text ADocument) appended to the array AJSON is
    // making as a DocumentSymbol, its entries as its children
    hidden method DoAddSymbol(var AJSON: JSON; const ATree: ref SyntaxTree; const AId: int64;
      const ADocument: ref LSPDocument);
    var
      LStart: int64;
      LEnd: int64;
      LNameStart: int64;
      LNameEnd: int64;
      LChildren: Int64Array;
      LDetail: string;
      LI: int64;
    begin
      LStart := 0;
      LEnd := 0;
      LNameStart := 0;
      LNameEnd := 0;
      if not OutlineRanges(ATree, AId, ADocument, LStart, LEnd, LNameStart, LNameEnd) then
        return;
      end;
      AJSON.BeginObject();
      AJSON.Add("name", OutlineName(ATree, AId));
      LDetail := OutlineDetail(ATree, AId, ADocument);
      if LDetail <> "" then
        AJSON.Add("detail", LDetail);
      end;
      AJSON.Add("kind", OutlineKind(ATree, AId));
      AJSON.Add("range", self.DoRange(ADocument, LStart, LEnd));
      AJSON.Add("selectionRange", self.DoRange(ADocument, LNameStart, LNameEnd));
      LChildren := OutlineChildren(ATree, AId);
      if len(LChildren) > 0 then
        AJSON.BeginArray("children");
        for LI := 0 to len(LChildren) - 1 do
          self.DoAddSymbol(AJSON, ATree, LChildren[LI], ADocument);
        end;
        AJSON.EndArray();
      end;
      AJSON.EndObject();
    end;

    // textDocument/documentSymbol (see the header)
    hidden method DoDocumentSymbol(const AId: JSON; const AParams: JSON);
    var
      LURI: string;
      LDocument: ref LSPDocument;
      LCheck: ref Compiler;
      LItems: JSON;
      LNone: JSON;
    begin
      if not AParams.TryGetString("textDocument.uri", LURI) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(ADAM_LSP_DOCUMENT_SYMBOL).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LDocument := self.DoFind(LURI);
      if LDocument = nil then
        self.DoResult(AId, LNone, true);
        return;
      end;
      LCheck := self.DoCurrentCheck(LDocument);
      if (LCheck = nil) or (LCheck.MainModule = 0) then
        self.DoResult(AId, LNone, true);
        return;
      end;
      LItems.BeginArray(ADAM_LSP_ITEMS_KEY);
      self.DoAddSymbol(LItems, LCheck.Tree, LCheck.MainModule, LDocument);
      LItems.EndArray();
      self.DoResult(AId, LItems.Get(ADAM_LSP_ITEMS_KEY), false);
    end;

    // The entry AId of ATree (its file's text ADocument) appended to the array AJSON as a
    // SymbolInformation when its name matches AQuery (AContainer its container's name, ""
    // none); its entries after it (an import is no symbol; APublicOnly: only what another
    // module sees, entries and all)
    hidden method DoAddWorkspaceSymbol(var AJSON: JSON; const ATree: ref SyntaxTree;
      const AId: int64; const ADocument: ref LSPDocument; const AContainer: string;
      const AQuery: string; const APublicOnly: bool);
    var
      LStart: int64;
      LEnd: int64;
      LNameStart: int64;
      LNameEnd: int64;
      LName: string;
      LChildren: Int64Array;
      LI: int64;
    begin
      LStart := 0;
      LEnd := 0;
      LNameStart := 0;
      LNameEnd := 0;
      if ATree[AId].Kind = NodeKind.Import then
        return;
      end;
      if APublicOnly and not OutlineIsPublic(ATree, AId) then
        return;
      end;
      if not OutlineRanges(ATree, AId, ADocument, LStart, LEnd, LNameStart, LNameEnd) then
        return;
      end;
      LName := OutlineName(ATree, AId);
      if MatchesQuery(LName, AQuery) then
        AJSON.BeginObject();
        AJSON.Add("name", LName);
        AJSON.Add("kind", OutlineKind(ATree, AId));
        AJSON.BeginObject("location");
        AJSON.Add("uri", ADocument.URI);
        AJSON.Add("range", self.DoRange(ADocument, LNameStart, LNameEnd));
        AJSON.EndObject();
        if AContainer <> "" then
          AJSON.Add("containerName", AContainer);
        end;
        AJSON.EndObject();
      end;
      LChildren := OutlineChildren(ATree, AId);
      for LI := 0 to len(LChildren) - 1 do
        self.DoAddWorkspaceSymbol(AJSON, ATree, LChildren[LI], ADocument, LName, AQuery,
          APublicOnly);
      end;
    end;

    // workspace/symbol (see the header)
    hidden method DoWorkspaceSymbol(const AId: JSON; const AParams: JSON);
    var
      LQuery: string;
      LUris: StringArray;
      // The modules' files done, as URIs (DoSeenFile)
      LSeen: StringArray;
      LDocument: ref LSPDocument;
      LCheck: ref Compiler;
      LModuleDocument: ref LSPDocument;
      LModule: int64;
      LFile: string;
      LItems: JSON;
      LI: int64;
      LJ: int64;
    begin
      if not AParams.TryGetString("query", LQuery) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(ADAM_LSP_WORKSPACE_SYMBOL).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      // The open documents of a file, by URI: an answer does not depend on the open order
      for LI := 0 to len(self.FDocuments) - 1 do
        if self.FDocuments[LI].Path <> "" then
          DoAppend(LUris, self.FDocuments[LI].URI);
        end;
      end;
      SortStrings(LUris);
      LItems.BeginArray(ADAM_LSP_ITEMS_KEY);
      for LI := 0 to len(LUris) - 1 do
        LDocument := self.DoFind(LUris[LI]);
        LCheck := self.DoCurrentCheck(LDocument);
        if LCheck <> nil then
          for LJ := 0 to LCheck.Tree.ChildCount(ADAM_AST_PROGRAM) - 1 do
            LModule := LCheck.Tree.ChildAt(ADAM_AST_PROGRAM, LJ);
            LFile := LCheck.Tree[LModule].Place.FileName;
            if (LCheck.Tree[LModule].Kind = NodeKind.Module) and (LFile <> "") and
              not self.DoSeenFile(LSeen, PathToURI(LFile)) then
              DoAppend(LSeen, PathToURI(LFile));
              LModuleDocument := self.DoDocumentFor(LCheck, LFile);
              if LModuleDocument <> nil then
                self.DoAddWorkspaceSymbol(LItems, LCheck.Tree, LModule, LModuleDocument, "",
                  LQuery, self.DoOpenFor(LFile) = nil);
              end;
            end;
          end;
        end;
      end;
      LItems.EndArray();
      self.DoResult(AId, LItems.Get(ADAM_LSP_ITEMS_KEY), false);
    end;

    // -- Completion

    // textDocument/completion (see the header)
    hidden method DoCompletion(const AId: JSON; const AParams: JSON);
    var
      LURI: string;
      LDocument: ref LSPDocument;
      LCheck: ref Compiler;
      LOffset: int64;
      LTrigger: string;
      LContext: LSPCompletionContext;
      LItems: LSPCompletions;
      LResult: JSON;
      LNone: JSON;
      LI: int64;
    begin
      LOffset := 0;
      if not AParams.TryGetString("textDocument.uri", LURI) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(ADAM_LSP_COMPLETION).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LDocument := self.DoFind(LURI);
      if LDocument = nil then
        self.DoResult(AId, LNone, true);
        return;
      end;
      if not self.DoOffsetAt(LDocument, AParams, "position", LOffset) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(ADAM_LSP_COMPLETION).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LCheck := self.DoCurrentCheck(LDocument);
      LContext := CompletionContextAt(LDocument, LOffset);
      LTrigger := "";
      if not AParams.TryGetString("context.triggerCharacter", LTrigger) then
        LTrigger := "";
      end;
      if (LTrigger = ADAM_LSP_TRIGGER_ARROW) and not LContext.HasQualifier then
        // a '>' that is no '->': nothing to list
        LContext.HasList := false;
      end;
      if LCheck <> nil then
        LItems := CompletionsAt(LDocument, LCheck.Tree, LCheck.MainModule, LOffset, LContext);
      end;
      LResult.Add("isIncomplete", false);
      LResult.BeginArray("items");
      for LI := 0 to len(LItems) - 1 do
        LResult.BeginObject();
        LResult.Add("label", LItems[LI].Text);
        LResult.Add("kind", LItems[LI].Kind);
        if LItems[LI].Detail <> "" then
          LResult.Add("detail", LItems[LI].Detail);
        end;
        LResult.Add("sortText", LItems[LI].SortText);
        if LItems[LI].InsertText <> "" then
          LResult.Add("insertText", LItems[LI].InsertText);
          if LItems[LI].IsSnippet then
            LResult.Add("insertTextFormat", ADAM_LSP_INSERT_SNIPPET);
          end;
        end;
        LResult.EndObject();
      end;
      LResult.EndArray();
      self.DoResult(AId, LResult, false);
    end;

    // -- Inlay hints

    // textDocument/inlayHint (see the header)
    hidden method DoInlayHint(const AId: JSON; const AParams: JSON);
    var
      LURI: string;
      LDocument: ref LSPDocument;
      LCheck: ref Compiler;
      LFirst: int64;
      LLast: int64;
      LHints: LSPHints;
      LItems: JSON;
      LNone: JSON;
      LI: int64;
    begin
      LFirst := 0;
      LLast := 0;
      if not AParams.TryGetString("textDocument.uri", LURI) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(ADAM_LSP_INLAY_HINT).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LDocument := self.DoFind(LURI);
      if LDocument = nil then
        self.DoResult(AId, LNone, true);
        return;
      end;
      if not (self.DoOffsetAt(LDocument, AParams, "range.start", LFirst) and
        self.DoOffsetAt(LDocument, AParams, "range.end", LLast)) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(ADAM_LSP_INLAY_HINT).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LCheck := self.DoCurrentCheck(LDocument);
      if (LCheck = nil) or (LCheck.MainModule = 0) then
        self.DoResult(AId, LNone, true);
        return;
      end;
      LHints := CallHints(LDocument, LCheck.Tree, LCheck.MainModule, LFirst, LLast);
      LItems.BeginArray(ADAM_LSP_ITEMS_KEY);
      for LI := 0 to len(LHints) - 1 do
        LItems.BeginObject();
        LItems.Add("position", DoPosition(LDocument, LHints[LI].Offset, self.FEncoding));
        LItems.Add("label", LHints[LI].Text);
        LItems.Add("kind", ADAM_LSP_HINT_PARAMETER);
        LItems.Add("paddingRight", true);
        LItems.EndObject();
      end;
      LItems.EndArray();
      self.DoResult(AId, LItems.Get(ADAM_LSP_ITEMS_KEY), false);
    end;

    // -- Formatting

    // The FormattingOptions of AParams (LSP's keys + the editor's adam.* ones) over the
    // defaults: a missing or mistyped key keeps its default, the numbers clamped
    hidden const method DoFormatOptions(const AParams: JSON): LSPFormatOptions;
    var
      LOptions: LSPFormatOptions;
      LPairs: array of JSONPair;
      LKey: string;
      LValue: JSON;
      LI: int64;
    begin
      LOptions := FormatDefaults();
      LPairs := AParams.Get("options").Pairs();
      for LI := 0 to len(LPairs) - 1 do
        LKey := LPairs[LI].NodeName;
        LValue := LPairs[LI].Value;
        if LValue.IsNumber() then
          if LKey = "tabSize" then
            LOptions.IndentSize := LValue.AsInt64();
          else
            if LKey = "adam.maxBlankLines" then
              LOptions.MaxBlankLines := LValue.AsInt64();
            else
              if LKey = "adam.maxLineLength" then
                LOptions.MaxLineLength := LValue.AsInt64();
              end;
            end;
          end;
          skip;
        end;
        if not LValue.IsBoolean() then
          skip;
        end;
        if LKey = "insertSpaces" then
          LOptions.UseTabs := not LValue.AsBoolean();
        else
          if LKey = "trimTrailingWhitespace" then
            LOptions.TrimTrailingWhitespace := LValue.AsBoolean();
          else
            if LKey = "insertFinalNewline" then
              LOptions.FinalNewline := LValue.AsBoolean();
            else
              if LKey = "adam.spaceAroundAssign" then
                LOptions.SpaceAroundAssign := LValue.AsBoolean();
              else
                if LKey = "adam.spaceAroundOperators" then
                  LOptions.SpaceAroundOperators := LValue.AsBoolean();
                else
                  if LKey = "adam.spaceAfterComma" then
                    LOptions.SpaceAfterComma := LValue.AsBoolean();
                  else
                    if LKey = "adam.spaceBeforeColon" then
                      LOptions.SpaceBeforeColon := LValue.AsBoolean();
                    else
                      if LKey = "adam.spaceAfterColon" then
                        LOptions.SpaceAfterColon := LValue.AsBoolean();
                      end;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
      ClampFormat(LOptions);
      return LOptions;
    end;

    // True when ACheck reported no lexer / conditional / parser error about APath's file
    // (a report with no file is the document's)
    hidden const method DoSyntaxClean(const ACheck: ref Compiler; const APath: string): bool;
    var
      LReport: ref Diagnostic;
      LI: int64;
    begin
      for LI := 0 to ACheck.Reports.Count - 1 do
        LReport := ACheck.Reports.Items[LI];
        if not LReport.IsError() then
          skip;
        end;
        if (LReport.FileName <> "") and not SamePath(LReport.FileName, APath) then
          skip;
        end;
        if StartsStr(ADAM_LSP_FORMAT_LEXER, LReport.Code) or
          StartsStr(ADAM_LSP_FORMAT_CONDITIONALS, LReport.Code) or
          StartsStr(ADAM_LSP_FORMAT_PARSER, LReport.Code) then
          return false;
        end;
      end;
      return true;
    end;

    // textDocument/formatting and /rangeFormatting (see the header)
    hidden method DoFormatting(const AId: JSON; const AMethod: string; const AParams: JSON);
    var
      LURI: string;
      LDocument: ref LSPDocument;
      LCheck: ref Compiler;
      LFrom: int64;
      LTo: int64;
      LRange: bool;
      LResult: LSPFormatResult;
      LEdit: LSPFormatEdit;
      LItems: JSON;
      LNone: JSON;
      LI: int64;
    begin
      LFrom := 0;
      LTo := 0;
      LRange := AMethod = ADAM_LSP_RANGE_FORMATTING;
      if not AParams.TryGetString("textDocument.uri", LURI) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(AMethod).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LDocument := self.DoFind(LURI);
      if LDocument = nil then
        self.DoResult(AId, LNone, true);
        return;
      end;
      if LRange then
        if not (self.DoOffsetAt(LDocument, AParams, "range.start", LFrom) and
          self.DoOffsetAt(LDocument, AParams, "range.end", LTo)) then
          self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
            NoArgs().Str(AMethod).Fill(ADAM_MSG_LSP_BAD_PARAMS));
          return;
        end;
      else
        LTo := len(LDocument.Text) + 1;
      end;
      // The tree of this buffer as it stands (no file: no tree)
      LCheck := self.DoCurrentCheck(LDocument);
      if (LCheck = nil) or (LCheck.MainModule = 0) then
        self.DoResult(AId, LNone, true);
        return;
      end;
      LResult := FormatSource(LDocument.Text, LCheck.Tree, LCheck.MainModule,
        self.DoSyntaxClean(LCheck, LDocument.Path), self.DoFormatOptions(AParams));
      // A refusal is an empty result and a warning the user sees, not an error
      if LResult.Refusal = LSPFormatRefusal.Syntax then
        self.DoShowWarning(NoArgs().Fill(ADAM_MSG_LSP_FORMAT_SYNTAX));
      else
        if LResult.Refusal = LSPFormatRefusal.Verify then
          self.DoShowWarning(NoArgs().Fill(ADAM_MSG_LSP_FORMAT_VERIFY));
        end;
      end;
      // A range keeps the edits whose gap starts inside it
      LItems.BeginArray(ADAM_LSP_ITEMS_KEY);
      for LI := 0 to len(LResult.Edits) - 1 do
        LEdit := LResult.Edits[LI];
        if (LEdit.StartOffset < LFrom) or (LEdit.StartOffset >= LTo) then
          skip;
        end;
        LItems.BeginObject();
        LItems.Add("range", DoRangeOf(LDocument, LEdit.StartOffset, LEdit.EndOffset,
          self.FEncoding));
        LItems.Add("newText", LEdit.NewText);
        LItems.EndObject();
      end;
      LItems.EndArray();
      self.DoResult(AId, LItems.Get(ADAM_LSP_ITEMS_KEY), false);
    end;

    // -- Call hierarchy

    // The CallHierarchyItem of the routine (or module) AId of ACheck's tree into AItem (see
    // the header); false when it has no place in a text that can be had
    hidden method DoCallItem(const ACheck: ref Compiler; const AId: int64; var AItem: JSON): bool;
    var
      LKey: string;
      LDocument: ref LSPDocument;
      LStart: int64;
      LEnd: int64;
      LNameStart: int64;
      LNameEnd: int64;
      LDetail: string;
    begin
      LStart := 0;
      LEnd := 0;
      LNameStart := 0;
      LNameEnd := 0;
      LKey := CallKey(ACheck.Tree, AId);
      if LKey = "" then
        return false;
      end;
      LDocument := self.DoDocumentFor(ACheck, ACheck.Tree[AId].Place.FileName);
      if LDocument = nil then
        return false;
      end;
      if not OutlineRanges(ACheck.Tree, AId, LDocument, LStart, LEnd, LNameStart, LNameEnd) then
        return false;
      end;
      AItem.Add("name", OutlineName(ACheck.Tree, AId));
      AItem.Add("kind", OutlineKind(ACheck.Tree, AId));
      LDetail := OutlineDetail(ACheck.Tree, AId, LDocument);
      if LDetail <> "" then
        AItem.Add("detail", LDetail);
      end;
      AItem.Add("uri", LDocument.URI);
      AItem.Add("range", self.DoRange(LDocument, LStart, LEnd));
      AItem.Add("selectionRange", self.DoRange(LDocument, LNameStart, LNameEnd));
      AItem.BeginObject("data");
      AItem.Add("key", LKey);
      AItem.EndObject();
      return true;
    end;

    // textDocument/prepareCallHierarchy (see the header)
    hidden method DoPrepareCalls(const AId: JSON; const AParams: JSON);
    var
      LURI: string;
      LDocument: ref LSPDocument;
      LCheck: ref Compiler;
      LOffset: int64;
      LTarget: LSPTarget;
      LRoutine: int64;
      LItem: JSON;
      LItems: JSON;
      LNone: JSON;
    begin
      LOffset := 0;
      if not AParams.TryGetString("textDocument.uri", LURI) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(ADAM_LSP_PREPARE_CALLS).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LDocument := self.DoFind(LURI);
      if LDocument = nil then
        self.DoResult(AId, LNone, true);
        return;
      end;
      if not self.DoOffsetAt(LDocument, AParams, "position", LOffset) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(ADAM_LSP_PREPARE_CALLS).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LCheck := self.DoCurrentCheck(LDocument);
      if LCheck = nil then
        self.DoResult(AId, LNone, true);
        return;
      end;
      LTarget := FindAt(LDocument, LCheck.Tree, LCheck.MainModule, LOffset);
      LRoutine := 0;
      if LTarget.Found then
        LRoutine := CallRoutineOf(LCheck.Tree, LTarget.Decl);
      end;
      if (LRoutine = 0) or not self.DoCallItem(LCheck, LRoutine, LItem) then
        self.DoResult(AId, LNone, true);
        return;
      end;
      LItems.BeginArray(ADAM_LSP_ITEMS_KEY);
      LItems.Add(LItem);
      LItems.EndArray();
      self.DoResult(AId, LItems.Get(ADAM_LSP_ITEMS_KEY), false);
    end;

    // The key of the item of a call hierarchy request's AParams into AKey: its data's, else
    // the place of its selectionRange's start in its file ("" when that is no file a text
    // can be had of: nothing matches); false when the item has neither
    hidden method DoCallKeyOf(const AParams: JSON; var AKey: string): bool;
    var
      LURI: string;
      LPath: string;
      LText: string;
      LLine: int64;
      LCharacter: int64;
      LOffset: int64;
      LDocument: ref LSPDocument;
    begin
      AKey := "";
      LLine := 0;
      LCharacter := 0;
      LPath := "";
      if AParams.TryGetString("item.data.key", AKey) and (AKey <> "") then
        return true;
      end;
      AKey := "";
      if not (AParams.TryGetString("item.uri", LURI) and
        AParams.TryGetInt64("item.selectionRange.start.line", LLine) and
        AParams.TryGetInt64("item.selectionRange.start.character", LCharacter)) then
        return false;
      end;
      if not URIToPath(LURI, LPath) then
        return true;
      end;
      LPath := ResolvePath(LPath);
      // The client counted the position over the open buffer, else the disk text
      LDocument := self.DoOpenFor(LPath);
      if LDocument = nil then
        LText := "";
        if not ReadAllText(LPath, LText) then
          return true;
        end;
        if StartsStr(ADAM_LSP_DOCUMENT_BOM, LText) then
          LText := Substring(LText, len(ADAM_LSP_DOCUMENT_BOM), len(LText) - len(ADAM_LSP_DOCUMENT_BOM));
        end;
        LDocument := ref LSPDocument(LURI, LPath, -1, LText);
      end;
      LOffset := LDocument.OffsetAt(LLine, LCharacter, self.FEncoding);
      // A place's line and byte column, 1-based
      LDocument.PositionAt(LOffset, LSPEncoding.UTF8, LLine, LCharacter);
      AKey := CallKeyAt(LDocument.Path, LLine + 1, LCharacter + 1);
      return true;
    end;

    // A new group of AGroups for the other end AEnd (key AKey) of calls in the file ACallFile
    // of ACheck: its index; -1 when its item or its file's text cannot be had
    hidden method DoAddGroup(var AGroups: LSPCallGroupArray; const ACheck: ref Compiler;
      const AEnd: int64; const AKey: string; const ACallFile: string): int64;
    var
      LItem: JSON;
      LDocument: ref LSPDocument;
      LCount: int64;
    begin
      if not self.DoCallItem(ACheck, AEnd, LItem) then
        return -1;
      end;
      LDocument := self.DoDocumentFor(ACheck, ACallFile);
      if LDocument = nil then
        return -1;
      end;
      LCount := len(AGroups);
      setlength(AGroups, LCount + 1);
      AGroups[LCount] := ref LSPCallGroup(AKey, LItem, LDocument);
      return LCount;
    end;

    // callHierarchy/incomingCalls and callHierarchy/outgoingCalls (see the header)
    hidden method DoCalls(const AId: JSON; const AMethod: string; const AParams: JSON);
    var
      LKey: string;
      LIncoming: bool;
      LUris: StringArray;
      // The modules' files done, as URIs (DoSeenFile)
      LSeen: StringArray;
      LDocument: ref LSPDocument;
      LCheck: ref Compiler;
      LModule: int64;
      LFile: string;
      LSites: LSPCallSites;
      LEnd: int64;
      LEndKey: string;
      LGroups: LSPCallGroupArray;
      LAt: int64;
      LStart: int64;
      LStop: int64;
      LCount: int64;
      LItems: JSON;
      LI: int64;
      LJ: int64;
      LK: int64;
    begin
      LKey := "";
      LStart := 0;
      LStop := 0;
      if not self.DoCallKeyOf(AParams, LKey) then
        self.DoError(AId, true, ADAM_LSP_ERROR_INVALID_PARAMS,
          NoArgs().Str(AMethod).Fill(ADAM_MSG_LSP_BAD_PARAMS));
        return;
      end;
      LIncoming := AMethod = ADAM_LSP_INCOMING_CALLS;
      // The open documents of a file, by URI: an answer does not depend on the open order
      for LI := 0 to len(self.FDocuments) - 1 do
        if self.FDocuments[LI].Path <> "" then
          DoAppend(LUris, self.FDocuments[LI].URI);
        end;
      end;
      SortStrings(LUris);
      for LI := 0 to len(LUris) - 1 do
        LDocument := self.DoFind(LUris[LI]);
        LCheck := self.DoCurrentCheck(LDocument);
        if (LCheck <> nil) and (LKey <> "") then
          for LJ := 0 to LCheck.Tree.ChildCount(ADAM_AST_PROGRAM) - 1 do
            LModule := LCheck.Tree.ChildAt(ADAM_AST_PROGRAM, LJ);
            LFile := LCheck.Tree[LModule].Place.FileName;
            if (LCheck.Tree[LModule].Kind = NodeKind.Module) and (LFile <> "") and
              not self.DoSeenFile(LSeen, PathToURI(LFile)) then
              DoAppend(LSeen, PathToURI(LFile));
              LSites := CallSites(LCheck.Tree, LModule);
              for LK := 0 to len(LSites) - 1 do
                // Incoming: the item's callers, by caller; outgoing: its calls, by routine
                if LIncoming then
                  if CallKey(LCheck.Tree, LSites[LK].Target) <> LKey then
                    skip;
                  end;
                  LEnd := LSites[LK].Caller;
                else
                  if CallKey(LCheck.Tree, LSites[LK].Caller) <> LKey then
                    skip;
                  end;
                  LEnd := LSites[LK].Target;
                end;
                LEndKey := CallKey(LCheck.Tree, LEnd);
                LAt := DoGroupIndex(LGroups, LEndKey);
                if LAt < 0 then
                  LAt := self.DoAddGroup(LGroups, LCheck, LEnd, LEndKey,
                    LCheck.Tree[LSites[LK].Call].Place.FileName);
                end;
                // One range per place: a generic's instances repeat their template's calls
                if (LAt >= 0) and CallSiteRange(LCheck.Tree, LSites[LK].Call, LGroups[LAt].Document,
                  LStart, LStop) and not DoHasIndex(LGroups[LAt].Starts, LStart) then
                  LCount := len(LGroups[LAt].Starts);
                  setlength(LGroups[LAt].Starts, LCount + 1);
                  setlength(LGroups[LAt].Ends, LCount + 1);
                  LGroups[LAt].Starts[LCount] := LStart;
                  LGroups[LAt].Ends[LCount] := LStop;
                end;
              end;
            end;
          end;
        end;
      end;
      LItems.BeginArray(ADAM_LSP_ITEMS_KEY);
      for LI := 0 to len(LGroups) - 1 do
        LItems.BeginObject();
        if LIncoming then
          LItems.Add("from", LGroups[LI].Item);
        else
          LItems.Add("to", LGroups[LI].Item);
        end;
        LItems.BeginArray("fromRanges");
        for LJ := 0 to len(LGroups[LI].Starts) - 1 do
          LItems.Add(self.DoRange(LGroups[LI].Document, LGroups[LI].Starts[LJ],
            LGroups[LI].Ends[LJ]));
        end;
        LItems.EndArray();
        LItems.EndObject();
      end;
      LItems.EndArray();
      self.DoResult(AId, LItems.Get(ADAM_LSP_ITEMS_KEY), false);
    end;

    // The index of the published entry for the same file as AURI (DoSameFile); -1 when none
    hidden const method DoPublishedIndex(const AURI: string): int64;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FPublishedUris) - 1 do
        if DoSameFile(self.FPublishedUris[LI], AURI) then
          return LI;
        end;
      end;
      return -1;
    end;

    // AURI is published by AOwner's check: it takes the place of an entry for the same file
    // under another spelling (a closed import's URI, then the client's own once it is open)
    hidden method DoSetOwner(const AURI: string; const AOwner: string);
    var
      LAt: int64;
    begin
      LAt := self.DoPublishedIndex(AURI);
      if LAt >= 0 then
        self.FPublishedUris[LAt] := AURI;
        self.FPublishedOwners[LAt] := AOwner;
        return;
      end;
      DoAppend(self.FPublishedUris, AURI);
      DoAppend(self.FPublishedOwners, AOwner);
    end;

    // True when ASeen holds a URI of the same file as AURI
    hidden const method DoSeenFile(const ASeen: StringArray; const AURI: string): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(ASeen) - 1 do
        if DoSameFile(ASeen[LI], AURI) then
          return true;
        end;
      end;
      return false;
    end;

    // Every file AOwner's checks published that is not in ASeen cleared and forgotten
    hidden method DoClearOwned(const AOwner: string; const ASeen: StringArray);
    var
      LI: int64;
    begin
      LI := 0;
      while LI < len(self.FPublishedUris) do
        if (self.FPublishedOwners[LI] = AOwner) and
          not self.DoSeenFile(ASeen, self.FPublishedUris[LI]) then
          self.DoPublish(self.FPublishedUris[LI], -1, nil, nil, DoNoIndexes());
          DoRemoveAt(self.FPublishedUris, LI);
          DoRemoveAt(self.FPublishedOwners, LI);
        else
          LI := LI + 1;
        end;
      end;
    end;

    // textDocument/publishDiagnostics for AURI: the reports AIndexes of AReports, placed in
    // ADocument's text; AVersion < 0 no version (a file that is not open, a clear); ADocument
    // nil a clear (no diagnostics)
    hidden method DoPublish(const AURI: string; const AVersion: int64;
      const ADocument: ref LSPDocument; const AReports: ref Diagnostics;
      const AIndexes: Int64Array);
    var
      LMessage: JSON;
      LItem: JSON;
      LI: int64;
    begin
      LMessage := DoNewMessage();
      LMessage.Add("method", ADAM_LSP_PUBLISH_DIAGNOSTICS);
      LMessage.BeginObject("params");
      LMessage.Add("uri", AURI);
      if AVersion >= 0 then
        LMessage.Add("version", AVersion);
      end;
      LMessage.BeginArray("diagnostics");
      if ADocument <> nil then
        for LI := 0 to len(AIndexes) - 1 do
          LItem := DoDiagnostic(ADocument, AReports.Items[AIndexes[LI]], self.FEncoding);
          LMessage.Add(LItem);
        end;
      end;
      LMessage.EndArray();
      LMessage.EndObject();
      self.DoSend(LMessage);
    end;
  end;

// Serves the Language Server Protocol over ATransport (see the header) until "exit" or the end
// of its input, each check adding AModulePaths after the compiler's own: an ADAM_LSP_EXIT_*
// code
public func RunLSP(const ATransport: ref ProtocolTransport;
  const AModulePaths: StringArray): int32;
var
  LServer: ref LSPServer;
begin
  LServer := ref LSPServer(ATransport, AModulePaths);
  return LServer.Serve();
end;

end.
