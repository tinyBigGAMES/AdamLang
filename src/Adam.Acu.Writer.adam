-------------------------------------------------------------------------------
  Adam.Acu.Writer.adam - a checked unit's .acu payload (DESIGN sec 3)

  WriteAcuPayload  the payload (Adam.Acu.Format's layout) of one Module node
                   of a checked tree: the header the caller filled (its
                   Imports made here, from the unit's import clauses and the
                   other units its records reference, each with its interface
                   hash from the caller's list), then the unit's slice of the
                   tree with every Resolved* field
  AcuInterfaceHash the unit's interface hash (Adam.Acu.Format's header): the
                   same records over its public part, id-free and place-free

  The slice: the Module node and everything under it, in tree order; then,
  as the slice's links reach them, each derived type (a child of the derived
  types node) or a node no module holds, copied in with the subtree it heads.
  A link to the system scope or to another unit is written by name
  (AcuPathOf), never by id. Strings are pooled; nothing depends on an address,
  a hash order or a node id: a derived type's key keeps only its id-free tag
  (Adam.Compiler.Types' KeyTagOf), so a unit writes the same slice in every
  program that compiles it (DESIGN sec 5).
*******************************************************************************/

module unit Adam.Acu.Writer;

import System.SysUtils, Adam.Core.Containers, Adam.Compiler.SourceText,
  Adam.Compiler.Literals, Adam.Compiler.AST, Adam.Compiler.Scopes, Adam.Compiler.Types,
  Adam.Acu.Format;

const
  // Raised (an invariant broken): the node handed over is no Module node
  ADAM_ACU_WRITER_FAULT_MODULE: string = "Acu.Writer: no Module node: #";
  // Raised (an invariant broken): a unit the payload references has no interface hash
  ADAM_ACU_WRITER_FAULT_HASH: string = "Acu.Writer: no interface hash for the unit ";

type
  // One payload being written (see the header)
  AcuSliceWriter = object
    hidden FTree: ref SyntaxTree;
    hidden FModule: int64;
    // The slice: a node's slice index is its position here + 1
    hidden FSlice: ref NodeList;
    // A tree id's slice index (0: not in the slice)
    hidden FIndex: ref Int64Map;
    // The string pool: a text's id is its position in FPool + 1 ("" is 0)
    hidden FStrings: ref StringIdMap;
    hidden FPool: StringArray;
    // The nodes' records, written once the slice is complete
    hidden FBody: ref AcuBuffer;
    // The other units the records reference, in the order first referenced
    hidden FReferenced: StringArray;
    // The interface hash's records (AInterface, see AcuInterfaceHash): every text inline,
    // a reference to the unit's own node by AcuPathOf, no place, no source offset
    hidden FInterface: bool;
    // The interface's paths made so far: a node's is FPaths[FPathIndex.Find(node) - 1] (a
    // declaration is referenced many times, its path made once)
    hidden FPathIndex: ref Int64Map;
    hidden FPaths: StringArray;
    // A new node (Node's init): a record writes only the fields that differ from its
    // (AcuField), the reader keeps the rest as the tree's Add made them
    hidden FDefault: ref Node;

    init(const ATree: ref SyntaxTree; const AModule: int64; const AInterface: bool);
    begin
      self.FTree := ATree;
      self.FModule := AModule;
      self.FInterface := AInterface;
      self.FDefault := ref Node();
      self.FPathIndex := ref Int64Map(0);
      setlength(self.FPaths, 0);
      self.FSlice := ref NodeList();
      self.FIndex := ref Int64Map(0);
      self.FStrings := ref StringIdMap();
      setlength(self.FPool, 0);
      self.FBody := ref AcuBuffer();
      setlength(self.FReferenced, 0);
    end;

    // AName appended to ANames when not in it yet
    hidden const method DoAddName(var ANames: StringArray; const AName: string);
    var
      LI: int64;
    begin
      for LI := 0 to len(ANames) - 1 do
        if ANames[LI] = AName then
          return;
        end;
      end;
      setlength(ANames, len(ANames) + 1);
      ANames[len(ANames) - 1] := AName;
    end;

    // AId and its subtree into the slice, a parent before its children
    hidden method DoCollect(const AId: int64);
    var
      LI: int64;
    begin
      self.FSlice.Add(AId);
      self.FIndex.Put(AId, self.FSlice.Count);
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        self.DoCollect(self.FTree.ChildAt(AId, LI));
      end;
    end;

    // The top of the subtree that holds AId below the program or the derived types node
    hidden const method DoTopOf(const AId: int64): int64;
    var
      LAt: int64;
      LParent: int64;
    begin
      LAt := AId;
      LParent := self.FTree.ParentOf(LAt);
      while (LParent <> 0) and (LParent <> ADAM_AST_PROGRAM) and (LParent <> ADAM_AST_DERIVED) do
        LAt := LParent;
        LParent := self.FTree.ParentOf(LAt);
      end;
      return LAt;
    end;

    // A link of the slice to ALink: a derived type, or a node no module holds, is copied in
    // with the subtree it heads; a fixed node, the slice's own, the system scope's and another
    // unit's are written by reference
    hidden method DoReach(const ALink: int64);
    begin
      if ALink <= ADAM_AST_DERIVED then
        return;
      end;
      if self.FIndex.Find(ALink) <> 0 then
        return;
      end;
      if ModuleOf(self.FTree, ALink) <> 0 then
        return;
      end;
      if self.FTree.IsAncestor(ADAM_AST_SYSTEM, ALink) then
        return;
      end;
      self.DoCollect(self.DoTopOf(ALink));
    end;

    // Every link of the slice followed, the slice growing as copies join it (each new node's
    // links are followed in turn)
    hidden method DoReachAll();
    var
      LI: int64;
      LNode: ref Node;
    begin
      LI := 0;
      while LI < self.FSlice.Count do
        LNode := self.FTree[self.FSlice[LI]];
        self.DoReach(LNode.ResolvedDecl);
        self.DoReach(LNode.ResolvedUnit);
        self.DoReach(LNode.ResolvedJump);
        self.DoReach(LNode.ResolvedType);
        self.DoReach(LNode.ResolvedConvert);
        self.DoReach(LNode.ResolvedEmbed);
        self.DoReach(LNode.ResolvedCallee);
        self.DoReach(LNode.ResolvedInstance);
        LI := LI + 1;
      end;
    end;

    // True when AId or a node above it in the unit declares generic parameters: its bodies are
    // part of what an importer instantiates
    hidden const method DoInGeneric(const AId: int64): bool;
    var
      LAt: int64;
    begin
      LAt := AId;
      while (LAt <> 0) and (LAt <> self.FModule) do
        if self.FTree.CountOf(LAt, NodeRole.GenericParam) > 0 then
          return true;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // AId and its subtree into the interface's slice, a parent before its children, the
    // locals and body of a routine left out unless AGeneric (see AcuInterfaceHash)
    hidden method DoCollectInterface(const AId: int64; const AGeneric: bool);
    var
      LI: int64;
      LChild: int64;
      LRole: NodeRole;
    begin
      if self.FIndex.Find(AId) <> 0 then
        return;
      end;
      self.FSlice.Add(AId);
      self.FIndex.Put(AId, self.FSlice.Count);
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LChild := self.FTree.ChildAt(AId, LI);
        LRole := self.FTree.RoleOf(LChild);
        // a release build inlines routines across units (Adam.Opt.Inline, from a body
        // copy lowered in the importer): every body is then interface, so an importer is
        // compiled again when a body it may have inlined changes
        if AGeneric or (not self.FTree.IsDebugBuild()) or
          ((LRole <> NodeRole.Local) and (LRole <> NodeRole.Body)) then
          self.DoCollectInterface(LChild, AGeneric);
        end;
      end;
    end;

    // A link of the interface's slice to ALink: a node of the unit (a private declaration a
    // public one reaches) joins with its subtree, a derived type or a node no module holds
    // with the subtree it heads; a fixed node, the system scope's and another unit's stay
    // references
    hidden method DoReachInterface(const ALink: int64);
    begin
      // The unit's own Module node stays a reference (its path is ""): taken in, it would
      // bring every private declaration with it
      if (ALink <= ADAM_AST_DERIVED) or (ALink = self.FModule) or
        (self.FIndex.Find(ALink) <> 0) then
        return;
      end;
      if self.FTree.IsAncestor(ADAM_AST_SYSTEM, ALink) then
        return;
      end;
      if ModuleOf(self.FTree, ALink) = self.FModule then
        self.DoCollectInterface(ALink, self.DoInGeneric(ALink));
        return;
      end;
      if ModuleOf(self.FTree, ALink) <> 0 then
        return;
      end;
      self.DoCollectInterface(self.DoTopOf(ALink), true);
    end;

    // The interface's slice: the unit's public declarations (the runtime's facts the tree
    // keeps too, for the runtime), then every node they reach, as DoReachAll grows the slice
    hidden method DoCollectPublic();
    var
      LI: int64;
      LChild: int64;
      LKind: RuntimeRoutine;
      LNode: ref Node;
    begin
      for LI := 0 to self.FTree.ChildCount(self.FModule) - 1 do
        LChild := self.FTree.ChildAt(self.FModule, LI);
        if (self.FTree.RoleOf(LChild) = NodeRole.Declaration) and
          self.FTree[LChild].HasFlag(NodeFlag.Public) then
          self.DoCollectInterface(LChild, self.DoInGeneric(LChild));
        end;
      end;
      if self.FTree.Runtime = self.FModule then
        for LKind := RuntimeRoutine.StrRelease to ADAM_AST_RUNTIME_LAST do
          self.DoReachInterface(self.FTree.RuntimeRoutineOf(LKind));
        end;
        self.DoReachInterface(self.FTree.VarKind);
        self.DoReachInterface(self.FTree.AllocSite);
      end;
      LI := 0;
      while LI < self.FSlice.Count do
        LNode := self.FTree[self.FSlice[LI]];
        self.DoReachInterface(LNode.ResolvedDecl);
        self.DoReachInterface(LNode.ResolvedUnit);
        self.DoReachInterface(LNode.ResolvedJump);
        self.DoReachInterface(LNode.ResolvedType);
        self.DoReachInterface(LNode.ResolvedConvert);
        self.DoReachInterface(LNode.ResolvedEmbed);
        self.DoReachInterface(LNode.ResolvedCallee);
        self.DoReachInterface(LNode.ResolvedInstance);
        LI := LI + 1;
      end;
    end;

    // The pool id of AText (0 for ""), pooled on first use
    hidden method DoString(const AText: string): int64;
    var
      LId: int64;
    begin
      if AText = "" then
        return 0;
      end;
      LId := self.FStrings.Find(AText);
      if LId = 0 then
        setlength(self.FPool, len(self.FPool) + 1);
        self.FPool[len(self.FPool) - 1] := AText;
        LId := len(self.FPool);
        self.FStrings.Put(AText, LId);
      end;
      return LId;
    end;

    // A text field: its pool id, or (the interface's records) the text inline
    hidden method DoPutString(const AText: string);
    begin
      if self.FInterface then
        self.FBody.PutText(AText);
        return;
      end;
      self.FBody.PutVar(uint64(self.DoString(AText)));
    end;

    hidden method DoPutKind(const AKind: AcuRefKind);
    begin
      self.FBody.Put8(uint64(int32(AKind)));
    end;

    // AcuPathOf of the unit's node ALink below the unit's Module node, made once per node
    hidden method DoPathOf(const ALink: int64): string;
    var
      LIndex: int64;
    begin
      LIndex := self.FPathIndex.Find(ALink);
      if LIndex = 0 then
        setlength(self.FPaths, len(self.FPaths) + 1);
        self.FPaths[len(self.FPaths) - 1] := AcuPathOf(self.FTree, ALink, self.FModule);
        LIndex := len(self.FPaths);
        self.FPathIndex.Put(ALink, LIndex);
      end;
      return self.FPaths[LIndex - 1];
    end;

    // A reference to ALink (see Adam.Acu.Format's header)
    hidden method DoPutRef(const ALink: int64);
    var
      LLocal: int64;
      LModule: int64;
    begin
      if ALink = 0 then
        self.DoPutKind(AcuRefKind.None);
        return;
      end;
      // The interface's records name the unit's own node by its path: an id-free name that
      // stays when a private declaration comes or goes
      if self.FInterface and ((ALink = self.FModule) or
        (ModuleOf(self.FTree, ALink) = self.FModule)) then
        self.DoPutKind(AcuRefKind.Local);
        self.DoPutString(self.DoPathOf(ALink));
        return;
      end;
      LLocal := self.FIndex.Find(ALink);
      if LLocal <> 0 then
        self.DoPutKind(AcuRefKind.Local);
        self.FBody.PutVar(uint64(LLocal));
        return;
      end;
      if ALink <= ADAM_AST_DERIVED then
        self.DoPutKind(AcuRefKind.Fixed);
        self.FBody.PutVar(uint64(ALink));
        return;
      end;
      if self.FTree.IsAncestor(ADAM_AST_SYSTEM, ALink) then
        self.DoPutKind(AcuRefKind.System);
        self.DoPutString(AcuPathOf(self.FTree, ALink, ADAM_AST_SYSTEM));
        return;
      end;
      // DoReachAll copied in every other node: what is left is another unit's
      LModule := ModuleOf(self.FTree, ALink);
      self.DoAddName(self.FReferenced, self.FTree[LModule].Text);
      self.DoPutKind(AcuRefKind.Foreign);
      self.DoPutString(self.FTree[LModule].Text);
      self.DoPutString(AcuPathOf(self.FTree, ALink, LModule));
    end;

    // A literal's fault in one encoding: its reason, then 1 for a warning
    hidden method DoPutFault(const AFault: EncodingFault);
    begin
      self.DoPutString(AFault.Reason);
      self.FBody.PutBool(AFault.IsWarning);
    end;

    // A UTF-16 text: its unit count (var), then each unit (var: one byte below 128)
    hidden method DoPutWide(const AWide: wstring);
    var
      LI: int64;
    begin
      self.FBody.PutVar(uint64(len(AWide)));
      for LI := 0 to len(AWide) - 1 do
        self.FBody.PutVar(uint64(uint16(AWide[LI])));
      end;
    end;

    // A node's flags as a mask: bit n is the flag numbered n
    hidden const method DoFlagsMask(const AFlags: NodeFlags): uint64;
    var
      LMask: uint64;
      LFlag: NodeFlag;
    begin
      LMask := 0;
      // NodeFlag's first value to the last one a compiled unit keeps (a value appended
      // before Compiled moves this bound); Compiled is a build's own state, never written
      for LFlag := NodeFlag.Public to NodeFlag.OpenEnd do
        if LFlag in AFlags then
          LMask := LMask | (uint64(1) shl uint64(int32(LFlag)));
        end;
      end;
      return LMask;
    end;

    // True when the folded constants AValue and AOther differ in any part (the float by
    // its bits: -0.0 is not 0.0)
    hidden const method DoConstDiffers(const AValue: ConstValue; const AOther: ConstValue): bool;
    begin
      return (AValue.Kind <> AOther.Kind) or (AValue.Bits <> AOther.Bits) or
        (Float64ToBits(AValue.Float) <> Float64ToBits(AOther.Float)) or
        (AValue.Text <> AOther.Text);
    end;

    // A folded constant: its kind, its bits, its float's bits (u64), its text
    hidden method DoPutConst(const AValue: ConstValue);
    begin
      self.FBody.PutVar(uint64(int32(AValue.Kind)));
      self.FBody.PutVar(AValue.Bits);
      self.FBody.Put64(Float64ToBits(AValue.Float));
      self.DoPutString(AValue.Text);
    end;

    // One level of a placeholder's spec, its fields in FormatSpec's order
    hidden method DoPutSpec(const ASpec: FormatSpec);
    begin
      self.DoPutString(ASpec.Fill);
      self.FBody.PutVar(uint64(int32(ASpec.Align)));
      self.FBody.PutVar(uint64(int32(ASpec.Sign)));
      self.FBody.PutBool(ASpec.Alternate);
      self.FBody.PutBool(ASpec.ZeroPad);
      self.FBody.PutSigned(int64(ASpec.Width));
      self.FBody.PutSigned(int64(ASpec.WidthArgument));
      self.FBody.PutSigned(int64(ASpec.Precision));
      self.FBody.PutSigned(int64(ASpec.PrecisionArgument));
      self.FBody.PutBool(ASpec.Localized);
      self.FBody.PutBool(ASpec.ClearBrackets);
      self.DoPutString(ASpec.Presentation);
    end;

    // A print / println / FormatStr format as Semantics read it: its items (each its text,
    // its argument and its specs by level), its tail, whether it is known only at run time
    hidden method DoPutFormat(const APlan: FormatPlan);
    var
      LI: int64;
      LJ: int64;
    begin
      self.FBody.PutVar(uint64(len(APlan.Items)));
      for LI := 0 to len(APlan.Items) - 1 do
        self.DoPutString(APlan.Items[LI].Text);
        self.FBody.PutSigned(int64(APlan.Items[LI].Argument));
        self.FBody.PutVar(uint64(len(APlan.Items[LI].Specs)));
        for LJ := 0 to len(APlan.Items[LI].Specs) - 1 do
          self.DoPutSpec(APlan.Items[LI].Specs[LJ]);
        end;
      end;
      self.DoPutString(APlan.Tail);
      self.FBody.PutBool(APlan.AtRunTime);
    end;

    // True when AField's bit is set in AMask
    hidden const method DoHas(const AMask: uint64; const AField: AcuField): bool;
    begin
      return (AMask & AcuFieldBit(AField)) <> 0;
    end;

    // The record of the node AId: its structure (parent, role), place and range, then the
    // mask of the fields after them that differ from a new node's (FDefault) and only those,
    // in Node's order (see Adam.Acu.Format's AcuField), its format last when it has one
    hidden method DoPutNode(const AId: int64);
    var
      LNode: ref Node;
      LDefault: ref Node;
      LText: string;
      LFlags: uint64;
      LMask: uint64;
    begin
      LNode := self.FTree[AId];
      LDefault := self.FDefault;
      self.FBody.PutVar(uint64(int32(LNode.Kind)));
      self.DoPutRef(self.FTree.ParentOf(AId));
      self.FBody.PutVar(uint64(int32(self.FTree.RoleOf(AId))));
      // Where the node is written is no fact an importer reads: a line added above a public
      // declaration keeps the interface's hash
      if not self.FInterface then
        self.DoPutString(LNode.Place.FileName);
        self.FBody.PutSigned(int64(LNode.Place.Line));
        self.FBody.PutSigned(int64(LNode.Place.Column));
        self.FBody.PutSigned(LNode.StartOffset);
        self.FBody.PutSigned(LNode.EndOffset);
      end;

      // A derived type's key holds the writing tree's node ids: only its id-free tag is
      // written (InternCopies rebuilds the key), so a unit writes the same bytes in every
      // program that compiles it
      if self.FTree.ParentOf(AId) = ADAM_AST_DERIVED then
        LText := KeyTagOf(self.FTree, AId);
      else
        LText := LNode.Text;
      end;
      LFlags := self.DoFlagsMask(LNode.Flags);

      // The mask: each field that is not as a new node has it
      LMask := 0;
      if LText <> LDefault.Text then
        LMask := LMask | AcuFieldBit(AcuField.Text);
      end;
      if LNode.Decoded <> LDefault.Decoded then
        LMask := LMask | AcuFieldBit(AcuField.Decoded);
      end;
      if len(LNode.DecodedWide) <> len(LDefault.DecodedWide) then
        LMask := LMask | AcuFieldBit(AcuField.DecodedWide);
      end;
      if (LNode.NarrowFault.Reason <> LDefault.NarrowFault.Reason) or
        (LNode.NarrowFault.IsWarning <> LDefault.NarrowFault.IsWarning) then
        LMask := LMask | AcuFieldBit(AcuField.NarrowFault);
      end;
      if (LNode.WideFault.Reason <> LDefault.WideFault.Reason) or
        (LNode.WideFault.IsWarning <> LDefault.WideFault.IsWarning) then
        LMask := LMask | AcuFieldBit(AcuField.WideFault);
      end;
      if LNode.ResolvedPath <> LDefault.ResolvedPath then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedPath);
      end;
      if LNode.Op <> LDefault.Op then
        LMask := LMask | AcuFieldBit(AcuField.Op);
      end;
      if LFlags <> self.DoFlagsMask(LDefault.Flags) then
        LMask := LMask | AcuFieldBit(AcuField.Flags);
      end;
      if LNode.Module <> LDefault.Module then
        LMask := LMask | AcuFieldBit(AcuField.Module);
      end;
      if LNode.IntValue <> LDefault.IntValue then
        LMask := LMask | AcuFieldBit(AcuField.IntValue);
      end;
      if LNode.Suffix <> LDefault.Suffix then
        LMask := LMask | AcuFieldBit(AcuField.Suffix);
      end;
      if LNode.ResolvedDecl <> LDefault.ResolvedDecl then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedDecl);
      end;
      if LNode.ResolvedUnit <> LDefault.ResolvedUnit then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedUnit);
      end;
      if LNode.ResolvedJump <> LDefault.ResolvedJump then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedJump);
      end;
      if LNode.ResolvedType <> LDefault.ResolvedType then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedType);
      end;
      if LNode.ResolvedConvert <> LDefault.ResolvedConvert then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedConvert);
      end;
      if LNode.ResolvedEmbed <> LDefault.ResolvedEmbed then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedEmbed);
      end;
      if LNode.ResolvedCallee <> LDefault.ResolvedCallee then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedCallee);
      end;
      if self.DoConstDiffers(LNode.ResolvedConst, LDefault.ResolvedConst) then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedConst);
      end;
      if LNode.ResolvedLinkage <> LDefault.ResolvedLinkage then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedLinkage);
      end;
      if LNode.ResolvedSymbol <> LDefault.ResolvedSymbol then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedSymbol);
      end;
      if LNode.ResolvedSize <> LDefault.ResolvedSize then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedSize);
      end;
      if LNode.ResolvedAlign <> LDefault.ResolvedAlign then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedAlign);
      end;
      if LNode.ResolvedOffset <> LDefault.ResolvedOffset then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedOffset);
      end;
      if LNode.ResolvedBitOffset <> LDefault.ResolvedBitOffset then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedBitOffset);
      end;
      if LNode.ResolvedBitWidth <> LDefault.ResolvedBitWidth then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedBitWidth);
      end;
      if LNode.ResolvedSlot <> LDefault.ResolvedSlot then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedSlot);
      end;
      if LNode.ResolvedInstance <> LDefault.ResolvedInstance then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedInstance);
      end;
      if LNode.ResolvedFormat <> LDefault.ResolvedFormat then
        LMask := LMask | AcuFieldBit(AcuField.ResolvedFormat);
      end;
      self.FBody.PutVar(LMask);

      // The fields the mask names, in its order
      if self.DoHas(LMask, AcuField.Text) then
        self.DoPutString(LText);
      end;
      if self.DoHas(LMask, AcuField.Decoded) then
        self.DoPutString(LNode.Decoded);
      end;
      if self.DoHas(LMask, AcuField.DecodedWide) then
        self.DoPutWide(LNode.DecodedWide);
      end;
      if self.DoHas(LMask, AcuField.NarrowFault) then
        self.DoPutFault(LNode.NarrowFault);
      end;
      if self.DoHas(LMask, AcuField.WideFault) then
        self.DoPutFault(LNode.WideFault);
      end;
      if self.DoHas(LMask, AcuField.ResolvedPath) then
        self.DoPutString(LNode.ResolvedPath);
      end;
      if self.DoHas(LMask, AcuField.Op) then
        self.FBody.PutVar(uint64(int32(LNode.Op)));
      end;
      if self.DoHas(LMask, AcuField.Flags) then
        self.FBody.PutVar(LFlags);
      end;
      if self.DoHas(LMask, AcuField.Module) then
        self.FBody.PutVar(uint64(int32(LNode.Module)));
      end;
      if self.DoHas(LMask, AcuField.IntValue) then
        self.FBody.PutVar(LNode.IntValue);
      end;
      if self.DoHas(LMask, AcuField.Suffix) then
        self.DoPutString(LNode.Suffix);
      end;
      if self.DoHas(LMask, AcuField.ResolvedDecl) then
        self.DoPutRef(LNode.ResolvedDecl);
      end;
      if self.DoHas(LMask, AcuField.ResolvedUnit) then
        self.DoPutRef(LNode.ResolvedUnit);
      end;
      if self.DoHas(LMask, AcuField.ResolvedJump) then
        self.DoPutRef(LNode.ResolvedJump);
      end;
      if self.DoHas(LMask, AcuField.ResolvedType) then
        self.DoPutRef(LNode.ResolvedType);
      end;
      if self.DoHas(LMask, AcuField.ResolvedConvert) then
        self.DoPutRef(LNode.ResolvedConvert);
      end;
      if self.DoHas(LMask, AcuField.ResolvedEmbed) then
        self.DoPutRef(LNode.ResolvedEmbed);
      end;
      if self.DoHas(LMask, AcuField.ResolvedCallee) then
        self.DoPutRef(LNode.ResolvedCallee);
      end;
      if self.DoHas(LMask, AcuField.ResolvedConst) then
        self.DoPutConst(LNode.ResolvedConst);
      end;
      if self.DoHas(LMask, AcuField.ResolvedLinkage) then
        self.FBody.PutVar(uint64(int32(LNode.ResolvedLinkage)));
      end;
      if self.DoHas(LMask, AcuField.ResolvedSymbol) then
        self.DoPutString(LNode.ResolvedSymbol);
      end;
      if self.DoHas(LMask, AcuField.ResolvedSize) then
        self.FBody.PutSigned(LNode.ResolvedSize);
      end;
      if self.DoHas(LMask, AcuField.ResolvedAlign) then
        self.FBody.PutSigned(LNode.ResolvedAlign);
      end;
      if self.DoHas(LMask, AcuField.ResolvedOffset) then
        self.FBody.PutSigned(LNode.ResolvedOffset);
      end;
      if self.DoHas(LMask, AcuField.ResolvedBitOffset) then
        self.FBody.PutSigned(int64(LNode.ResolvedBitOffset));
      end;
      if self.DoHas(LMask, AcuField.ResolvedBitWidth) then
        self.FBody.PutSigned(int64(LNode.ResolvedBitWidth));
      end;
      if self.DoHas(LMask, AcuField.ResolvedSlot) then
        self.FBody.PutSigned(int64(LNode.ResolvedSlot));
      end;
      if self.DoHas(LMask, AcuField.ResolvedInstance) then
        self.DoPutRef(LNode.ResolvedInstance);
      end;
      if self.DoHas(LMask, AcuField.ResolvedFormat) then
        self.DoPutFormat(self.FTree.FormatOf(AId));
      end;
    end;

    // The runtime unit's facts the tree keeps (each routine the generated code calls, VarKind,
    // GAllocSite): written by the runtime's payload alone
    hidden method DoPutRuntime();
    var
      LKind: RuntimeRoutine;
    begin
      self.FBody.PutBool(self.FTree.Runtime = self.FModule);
      if self.FTree.Runtime <> self.FModule then
        return;
      end;
      // RuntimeRoutine's first to its last value (ADAM_AST_RUNTIME_LAST)
      for LKind := RuntimeRoutine.StrRelease to ADAM_AST_RUNTIME_LAST do
        self.DoPutRef(self.FTree.RuntimeRoutineOf(LKind));
      end;
      self.DoPutRef(self.FTree.VarKind);
      self.DoPutRef(self.FTree.AllocSite);
    end;

    // The names of the units the module's import clauses name, in order, then every other
    // unit the records reference (the runtime's names, in scope with no import), in the
    // order first referenced: what the unit needs in the tree before its payload is read.
    // Called once the records are written
    hidden const method DoImports(): StringArray;
    var
      LNames: StringArray;
      LI: int64;
      LUnit: int64;
    begin
      setlength(LNames, 0);
      for LI := 0 to self.FTree.CountOf(self.FModule, NodeRole.Import) - 1 do
        LUnit := self.FTree[self.FTree.NthOf(self.FModule, NodeRole.Import, LI)].ResolvedUnit;
        if LUnit <> 0 then
          self.DoAddName(LNames, self.FTree[LUnit].Text);
        end;
      end;
      for LI := 0 to len(self.FReferenced) - 1 do
        self.DoAddName(LNames, self.FReferenced[LI]);
      end;
      return LNames;
    end;

    // The interface hash of AName in AHashes (raises when it has none: every unit a
    // payload references is in the tree, its hash made by the caller)
    hidden const method DoHashOf(const AHashes: AcuUnitHashArray; const AName: string): uint64;
    var
      LI: int64;
    begin
      for LI := 0 to len(AHashes) - 1 do
        if AHashes[LI].UnitName = AName then
          return AHashes[LI].Hash;
        end;
      end;
      raise(ADAM_ACU_WRITER_FAULT_HASH + AName);
    end;

    // The interface hash (see AcuInterfaceHash): the records of the interface's slice
    method RunInterface(): uint64;
    var
      LI: int64;
    begin
      if self.FTree[self.FModule].Kind <> NodeKind.Module then
        raise(ADAM_ACU_WRITER_FAULT_MODULE + IntToStr(self.FModule));
      end;
      self.DoCollectPublic();
      self.FBody.Put32(uint64(self.FSlice.Count));
      for LI := 0 to self.FSlice.Count - 1 do
        self.DoPutNode(self.FSlice[LI]);
      end;
      return self.FBody.Hash();
    end;

    // The payload (see Adam.Acu.Format's header) with AHeader's fields, its Imports made here
    // and each one's interface hash taken from AHashes
    method Run(const AHeader: AcuHeader; const AHashes: AcuUnitHashArray): ByteArray;
    var
      LOut: ref AcuBuffer;
      LI: int64;
      LImports: StringArray;
    begin
      if self.FTree[self.FModule].Kind <> NodeKind.Module then
        raise(ADAM_ACU_WRITER_FAULT_MODULE + IntToStr(self.FModule));
      end;
      // The slice complete before a record is written: a reference is Local only for a node
      // the slice holds
      self.DoCollect(self.FModule);
      self.DoReachAll();
      self.FBody.Put32(uint64(self.FSlice.Count));
      for LI := 0 to self.FSlice.Count - 1 do
        self.DoPutNode(self.FSlice[LI]);
      end;
      self.DoPutRuntime();

      LOut := ref AcuBuffer();
      for LI := 0 to len(ADAM_ACU_MAGIC) - 1 do
        LOut.Put8(uint64(uint8(ADAM_ACU_MAGIC[LI])));
      end;
      LOut.Put32(uint64(ADAM_ACU_FORMAT_VERSION));
      LOut.PutText(AHeader.CompilerVersion);
      LOut.Put64(AHeader.CompilerId);
      LOut.PutText(AHeader.Triple);
      LOut.PutText(AHeader.Mode);
      LOut.PutText(AHeader.Defines);
      LOut.PutText(AHeader.UnitName);
      LOut.PutText(AHeader.SourcePath);
      LOut.Put64(uint64(AHeader.SourceSize));
      LOut.Put64(uint64(AHeader.SourceTime));
      LOut.Put64(AHeader.SourceHash);
      LOut.Put64(AHeader.ProjectKey);
      LOut.Put64(AHeader.InterfaceHash);
      LImports := self.DoImports();
      LOut.Put32(uint64(len(LImports)));
      for LI := 0 to len(LImports) - 1 do
        LOut.PutText(LImports[LI]);
        LOut.Put64(self.DoHashOf(AHashes, LImports[LI]));
      end;
      LOut.Put32(uint64(len(self.FPool)));
      for LI := 0 to len(self.FPool) - 1 do
        LOut.PutText(self.FPool[LI]);
      end;
      LOut.PutBuffer(self.FBody);
      return LOut.Bytes();
    end;
  end;

// The .acu payload of the Module node AModule of the checked tree ATree (see the header):
// AHeader's fields, each import's interface hash from AHashes (every unit of the tree)
public routine WriteAcuPayload(const ATree: ref SyntaxTree; const AModule: int64;
  const AHeader: AcuHeader; const AHashes: AcuUnitHashArray): ByteArray;
var
  LWriter: ref AcuSliceWriter;
begin
  LWriter := ref AcuSliceWriter(ATree, AModule, false);
  return LWriter.Run(AHeader, AHashes);
end;

// The interface hash (Adam.Acu.Format's header) of the Module node AModule of the checked
// tree ATree: FNV-1a 64 of the records of its public declarations (for the runtime, also
// the routines, VarKind and AllocSite the tree keeps), each with its subtree but for the
// locals and body of a routine not generic itself or inside a generic, then of every node
// they reach in the unit, a derived type or a node no module holds, in the order reached
// (a release build keeps every routine's locals and body: its importers may inline it).
// Each record as the payload's, but every text inline, a reference to the unit's own node
// by AcuPathOf (a derived one by its place in that order), no place, no source offset: the
// same in every tree that compiles the unit, and unmoved by what no importer reads
public routine AcuInterfaceHash(const ATree: ref SyntaxTree; const AModule: int64): uint64;
var
  LWriter: ref AcuSliceWriter;
begin
  LWriter := ref AcuSliceWriter(ATree, AModule, true);
  return LWriter.RunInterface();
end;

end.
