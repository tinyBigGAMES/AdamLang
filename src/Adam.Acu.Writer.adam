-------------------------------------------------------------------------------
  Adam.Acu.Writer.adam - a checked unit's .acu payload (DESIGN sec 3)

  WriteAcuPayload  the payload (Adam.Acu.Format's layout) of one Module node
                   of a checked tree: the header the caller filled (its
                   Imports made here, from the unit's import clauses and the
                   other units its records reference), then the unit's slice
                   of the tree with every Resolved* field

  The slice: the Module node and everything under it, in tree order; then,
  as the slice's links reach them, each derived type (a child of the derived
  types node) or a node no module holds, copied in with the subtree it heads.
  A link to the system scope or to another unit is written by name
  (AcuPathOf), never by id. Strings are pooled; nothing depends on an address
  or a hash order: one tree always writes the same bytes (DESIGN sec 5).
*******************************************************************************/

module unit Adam.Acu.Writer;

import System.SysUtils, Adam.Core.Containers, Adam.Compiler.SourceText,
  Adam.Compiler.Literals, Adam.Compiler.AST, Adam.Compiler.Scopes, Adam.Acu.Format;

const
  // Raised (an invariant broken): the node handed over is no Module node
  ADAM_ACU_WRITER_FAULT_MODULE: string = "Acu.Writer: no Module node: #";

type
  // One payload being written (see the header)
  AcuSliceWriter = object
    hidden FTree: ref SyntaxTree;
    hidden FModule: int64;
    // The slice: a node's slice index is its position here + 1
    hidden FSlice: ref NodeList;
    // A tree id's slice index (0: not in the slice)
    hidden FIndex: ref Int64Map;
    // The string pool: a text's id is its position in FPool + 1 ("" is 0)
    hidden FStrings: ref StringIdMap;
    hidden FPool: StringArray;
    // The nodes' records, written once the slice is complete
    hidden FBody: ref AcuBuffer;
    // The other units the records reference, in the order first referenced
    hidden FReferenced: StringArray;

    init(const ATree: ref SyntaxTree; const AModule: int64);
    begin
      self.FTree := ATree;
      self.FModule := AModule;
      self.FSlice := ref NodeList();
      self.FIndex := ref Int64Map(0);
      self.FStrings := ref StringIdMap();
      setlength(self.FPool, 0);
      self.FBody := ref AcuBuffer();
      setlength(self.FReferenced, 0);
    end;

    // AName appended to ANames when not in it yet
    hidden const method DoAddName(var ANames: StringArray; const AName: string);
    var
      LI: int64;
    begin
      for LI := 0 to len(ANames) - 1 do
        if ANames[LI] = AName then
          return;
        end;
      end;
      setlength(ANames, len(ANames) + 1);
      ANames[len(ANames) - 1] := AName;
    end;

    // AId and its subtree into the slice, a parent before its children
    hidden method DoCollect(const AId: int64);
    var
      LI: int64;
    begin
      self.FSlice.Add(AId);
      self.FIndex.Put(AId, self.FSlice.Count);
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        self.DoCollect(self.FTree.ChildAt(AId, LI));
      end;
    end;

    // The top of the subtree that holds AId below the program or the derived types node
    hidden const method DoTopOf(const AId: int64): int64;
    var
      LAt: int64;
      LParent: int64;
    begin
      LAt := AId;
      LParent := self.FTree.ParentOf(LAt);
      while (LParent <> 0) and (LParent <> ADAM_AST_PROGRAM) and (LParent <> ADAM_AST_DERIVED) do
        LAt := LParent;
        LParent := self.FTree.ParentOf(LAt);
      end;
      return LAt;
    end;

    // A link of the slice to ALink: a derived type, or a node no module holds, is copied in
    // with the subtree it heads; a fixed node, the slice's own, the system scope's and another
    // unit's are written by reference
    hidden method DoReach(const ALink: int64);
    begin
      if ALink <= ADAM_AST_DERIVED then
        return;
      end;
      if self.FIndex.Find(ALink) <> 0 then
        return;
      end;
      if ModuleOf(self.FTree, ALink) <> 0 then
        return;
      end;
      if self.FTree.IsAncestor(ADAM_AST_SYSTEM, ALink) then
        return;
      end;
      self.DoCollect(self.DoTopOf(ALink));
    end;

    // Every link of the slice followed, the slice growing as copies join it (each new node's
    // links are followed in turn)
    hidden method DoReachAll();
    var
      LI: int64;
      LNode: ref Node;
    begin
      LI := 0;
      while LI < self.FSlice.Count do
        LNode := self.FTree[self.FSlice[LI]];
        self.DoReach(LNode.ResolvedDecl);
        self.DoReach(LNode.ResolvedUnit);
        self.DoReach(LNode.ResolvedJump);
        self.DoReach(LNode.ResolvedType);
        self.DoReach(LNode.ResolvedConvert);
        self.DoReach(LNode.ResolvedEmbed);
        self.DoReach(LNode.ResolvedCallee);
        self.DoReach(LNode.ResolvedInstance);
        LI := LI + 1;
      end;
    end;

    // The pool id of AText (0 for ""), pooled on first use
    hidden method DoString(const AText: string): int64;
    var
      LId: int64;
    begin
      if AText = "" then
        return 0;
      end;
      LId := self.FStrings.Find(AText);
      if LId = 0 then
        setlength(self.FPool, len(self.FPool) + 1);
        self.FPool[len(self.FPool) - 1] := AText;
        LId := len(self.FPool);
        self.FStrings.Put(AText, LId);
      end;
      return LId;
    end;

    hidden method DoPutString(const AText: string);
    begin
      self.FBody.Put32(uint64(self.DoString(AText)));
    end;

    hidden method DoPutKind(const AKind: AcuRefKind);
    begin
      self.FBody.Put8(uint64(int32(AKind)));
    end;

    // A reference to ALink (see Adam.Acu.Format's header)
    hidden method DoPutRef(const ALink: int64);
    var
      LLocal: int64;
      LModule: int64;
    begin
      if ALink = 0 then
        self.DoPutKind(AcuRefKind.None);
        return;
      end;
      LLocal := self.FIndex.Find(ALink);
      if LLocal <> 0 then
        self.DoPutKind(AcuRefKind.Local);
        self.FBody.Put32(uint64(LLocal));
        return;
      end;
      if ALink <= ADAM_AST_DERIVED then
        self.DoPutKind(AcuRefKind.Fixed);
        self.FBody.Put8(uint64(ALink));
        return;
      end;
      if self.FTree.IsAncestor(ADAM_AST_SYSTEM, ALink) then
        self.DoPutKind(AcuRefKind.System);
        self.DoPutString(AcuPathOf(self.FTree, ALink, ADAM_AST_SYSTEM));
        return;
      end;
      // DoReachAll copied in every other node: what is left is another unit's
      LModule := ModuleOf(self.FTree, ALink);
      self.DoAddName(self.FReferenced, self.FTree[LModule].Text);
      self.DoPutKind(AcuRefKind.Foreign);
      self.DoPutString(self.FTree[LModule].Text);
      self.DoPutString(AcuPathOf(self.FTree, ALink, LModule));
    end;

    // A literal's fault in one encoding: its reason, then 1 for a warning
    hidden method DoPutFault(const AFault: EncodingFault);
    begin
      self.DoPutString(AFault.Reason);
      self.FBody.PutBool(AFault.IsWarning);
    end;

    // A UTF-16 text: its unit count (u32), then each unit (u16)
    hidden method DoPutWide(const AWide: wstring);
    var
      LI: int64;
    begin
      self.FBody.Put32(uint64(len(AWide)));
      for LI := 0 to len(AWide) - 1 do
        self.FBody.Put16(uint64(uint16(AWide[LI])));
      end;
    end;

    // A node's flags as a mask: bit n is the flag numbered n
    hidden method DoPutFlags(const AFlags: NodeFlags);
    var
      LMask: uint64;
      LFlag: NodeFlag;
    begin
      LMask := 0;
      // NodeFlag's first value to the last one a compiled unit keeps (a value appended
      // before Compiled moves this bound); Compiled is a build's own state, never written
      for LFlag := NodeFlag.Public to NodeFlag.TakesSelf do
        if LFlag in AFlags then
          LMask := LMask | (uint64(1) shl uint64(int32(LFlag)));
        end;
      end;
      self.FBody.Put64(LMask);
    end;

    // A folded constant: its kind, its bits, its float's bits, its text
    hidden method DoPutConst(const AValue: ConstValue);
    begin
      self.FBody.Put8(uint64(int32(AValue.Kind)));
      self.FBody.Put64(AValue.Bits);
      self.FBody.Put64(Float64ToBits(AValue.Float));
      self.DoPutString(AValue.Text);
    end;

    // One level of a placeholder's spec, its fields in FormatSpec's order
    hidden method DoPutSpec(const ASpec: FormatSpec);
    begin
      self.DoPutString(ASpec.Fill);
      self.FBody.Put8(uint64(int32(ASpec.Align)));
      self.FBody.Put8(uint64(int32(ASpec.Sign)));
      self.FBody.PutBool(ASpec.Alternate);
      self.FBody.PutBool(ASpec.ZeroPad);
      self.FBody.Put32(uint64(int64(ASpec.Width)));
      self.FBody.Put32(uint64(int64(ASpec.WidthArgument)));
      self.FBody.Put32(uint64(int64(ASpec.Precision)));
      self.FBody.Put32(uint64(int64(ASpec.PrecisionArgument)));
      self.FBody.PutBool(ASpec.Localized);
      self.FBody.PutBool(ASpec.ClearBrackets);
      self.DoPutString(ASpec.Presentation);
    end;

    // A print / println / FormatStr format as Semantics read it: its items (each its text,
    // its argument and its specs by level), its tail, whether it is known only at run time
    hidden method DoPutFormat(const APlan: FormatPlan);
    var
      LI: int64;
      LJ: int64;
    begin
      self.FBody.Put32(uint64(len(APlan.Items)));
      for LI := 0 to len(APlan.Items) - 1 do
        self.DoPutString(APlan.Items[LI].Text);
        self.FBody.Put32(uint64(int64(APlan.Items[LI].Argument)));
        self.FBody.Put32(uint64(len(APlan.Items[LI].Specs)));
        for LJ := 0 to len(APlan.Items[LI].Specs) - 1 do
          self.DoPutSpec(APlan.Items[LI].Specs[LJ]);
        end;
      end;
      self.DoPutString(APlan.Tail);
      self.FBody.PutBool(APlan.AtRunTime);
    end;

    // The record of the node AId: its structure (parent, role), place and range, what the
    // parser read, every Resolved* field in Node's order, and its format when it has one
    hidden method DoPutNode(const AId: int64);
    var
      LNode: ref Node;
    begin
      LNode := self.FTree[AId];
      self.FBody.Put16(uint64(int32(LNode.Kind)));
      self.DoPutRef(self.FTree.ParentOf(AId));
      self.FBody.Put16(uint64(int32(self.FTree.RoleOf(AId))));
      self.DoPutString(LNode.Place.FileName);
      self.FBody.Put32(uint64(int64(LNode.Place.Line)));
      self.FBody.Put32(uint64(int64(LNode.Place.Column)));
      self.FBody.Put64(uint64(LNode.StartOffset));
      self.FBody.Put64(uint64(LNode.EndOffset));

      self.DoPutString(LNode.Text);
      self.DoPutString(LNode.Decoded);
      self.DoPutWide(LNode.DecodedWide);
      self.DoPutFault(LNode.NarrowFault);
      self.DoPutFault(LNode.WideFault);
      self.DoPutString(LNode.ResolvedPath);
      self.FBody.Put16(uint64(int32(LNode.Op)));
      self.DoPutFlags(LNode.Flags);
      self.FBody.Put8(uint64(int32(LNode.Module)));
      self.FBody.Put64(LNode.IntValue);
      self.DoPutString(LNode.Suffix);

      self.DoPutRef(LNode.ResolvedDecl);
      self.DoPutRef(LNode.ResolvedUnit);
      self.DoPutRef(LNode.ResolvedJump);
      self.DoPutRef(LNode.ResolvedType);
      self.DoPutRef(LNode.ResolvedConvert);
      self.DoPutRef(LNode.ResolvedEmbed);
      self.DoPutRef(LNode.ResolvedCallee);
      self.DoPutConst(LNode.ResolvedConst);
      self.FBody.Put8(uint64(int32(LNode.ResolvedLinkage)));
      self.DoPutString(LNode.ResolvedSymbol);
      self.FBody.Put64(uint64(LNode.ResolvedSize));
      self.FBody.Put64(uint64(LNode.ResolvedAlign));
      self.FBody.Put64(uint64(LNode.ResolvedOffset));
      self.FBody.Put32(uint64(int64(LNode.ResolvedBitOffset)));
      self.FBody.Put32(uint64(int64(LNode.ResolvedBitWidth)));
      self.FBody.Put32(uint64(int64(LNode.ResolvedSlot)));
      self.DoPutRef(LNode.ResolvedInstance);
      self.FBody.PutBool(LNode.ResolvedFormat <> 0);
      if LNode.ResolvedFormat <> 0 then
        self.DoPutFormat(self.FTree.FormatOf(AId));
      end;
    end;

    // The runtime unit's facts the tree keeps (each routine the generated code calls, VarKind,
    // GAllocSite): written by the runtime's payload alone
    hidden method DoPutRuntime();
    var
      LKind: RuntimeRoutine;
    begin
      self.FBody.PutBool(self.FTree.Runtime = self.FModule);
      if self.FTree.Runtime <> self.FModule then
        return;
      end;
      // RuntimeRoutine's first to its last value (a value appended to it moves this bound)
      for LKind := RuntimeRoutine.StrRelease to RuntimeRoutine.NilOwnerFail do
        self.DoPutRef(self.FTree.RuntimeRoutineOf(LKind));
      end;
      self.DoPutRef(self.FTree.VarKind);
      self.DoPutRef(self.FTree.AllocSite);
    end;

    // The names of the units the module's import clauses name, in order, then every other
    // unit the records reference (the runtime's names, in scope with no import), in the
    // order first referenced: what the unit needs in the tree before its payload is read.
    // Called once the records are written
    hidden const method DoImports(): StringArray;
    var
      LNames: StringArray;
      LI: int64;
      LUnit: int64;
    begin
      setlength(LNames, 0);
      for LI := 0 to self.FTree.CountOf(self.FModule, NodeRole.Import) - 1 do
        LUnit := self.FTree[self.FTree.NthOf(self.FModule, NodeRole.Import, LI)].ResolvedUnit;
        if LUnit <> 0 then
          self.DoAddName(LNames, self.FTree[LUnit].Text);
        end;
      end;
      for LI := 0 to len(self.FReferenced) - 1 do
        self.DoAddName(LNames, self.FReferenced[LI]);
      end;
      return LNames;
    end;

    // The payload (see Adam.Acu.Format's header) with AHeader's fields, its Imports made here
    method Run(const AHeader: AcuHeader): ByteArray;
    var
      LOut: ref AcuBuffer;
      LI: int64;
      LImports: StringArray;
    begin
      if self.FTree[self.FModule].Kind <> NodeKind.Module then
        raise(ADAM_ACU_WRITER_FAULT_MODULE + IntToStr(self.FModule));
      end;
      // The slice complete before a record is written: a reference is Local only for a node
      // the slice holds
      self.DoCollect(self.FModule);
      self.DoReachAll();
      self.FBody.Put32(uint64(self.FSlice.Count));
      for LI := 0 to self.FSlice.Count - 1 do
        self.DoPutNode(self.FSlice[LI]);
      end;
      self.DoPutRuntime();

      LOut := ref AcuBuffer();
      for LI := 0 to len(ADAM_ACU_MAGIC) - 1 do
        LOut.Put8(uint64(uint8(ADAM_ACU_MAGIC[LI])));
      end;
      LOut.Put32(uint64(ADAM_ACU_FORMAT_VERSION));
      LOut.PutText(AHeader.CompilerVersion);
      LOut.Put64(AHeader.CompilerId);
      LOut.PutText(AHeader.Triple);
      LOut.PutText(AHeader.Mode);
      LOut.PutText(AHeader.UnitName);
      LOut.PutText(AHeader.SourcePath);
      LOut.Put64(uint64(AHeader.SourceSize));
      LOut.Put64(uint64(AHeader.SourceTime));
      LOut.Put64(AHeader.SourceHash);
      LOut.Put64(AHeader.ProjectKey);
      LImports := self.DoImports();
      LOut.Put32(uint64(len(LImports)));
      for LI := 0 to len(LImports) - 1 do
        LOut.PutText(LImports[LI]);
      end;
      LOut.Put32(uint64(len(self.FPool)));
      for LI := 0 to len(self.FPool) - 1 do
        LOut.PutText(self.FPool[LI]);
      end;
      LOut.PutBuffer(self.FBody);
      return LOut.Bytes();
    end;
  end;

// The .acu payload of the Module node AModule of the checked tree ATree (see the header)
public routine WriteAcuPayload(const ATree: ref SyntaxTree; const AModule: int64;
  const AHeader: AcuHeader): ByteArray;
var
  LWriter: ref AcuSliceWriter;
begin
  LWriter := ref AcuSliceWriter(ATree, AModule);
  return LWriter.Run(AHeader);
end;

end.
