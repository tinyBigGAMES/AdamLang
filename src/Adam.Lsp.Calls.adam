-------------------------------------------------------------------------------
  Adam.Lsp.Calls.adam - the call hierarchy's facts (M11b L6)

  CallRoutineOf: the routine a declaration stands for in the hierarchy: a
  routine or method itself, a forward its full routine (the forward's
  ResolvedDecl), a generic instance (and its copy) the template; anything
  else none. CallSites: every call of a module the check bound to a
  routine (the callee's ResolvedDecl as CallRoutineOf reads it), each with
  its caller: the routine, method, init / copy / done or operator it is in,
  else the module (its block, initialize / finalize, tests); a generic's
  instances are walked (their copies' callers read as the template).
  CallKey: what one routine is across checks and instances: its file and
  its name's place (an instance's copy keeps the template's places, so it
  is the template); CallKeyAt the same from a file, line and byte column.
  CallSiteRange: a call's callee name (a member's last name) in its
  file's text.

  Prior art: PaskalCPP.LSP.Calls (CONCEPT: sites with their caller, the
  module as the caller outside routines, keys by the name's place; GEOMETRY
  rejected: node ids of Adam's tree).
*******************************************************************************/

module unit Adam.Lsp.Calls;

import System.SysUtils, Adam.Compiler.SourceText, Adam.Compiler.AST, Adam.Lsp.Document;

public type
  // One call: Caller the routine-like declaration it is in (or the module), Target the
  // routine it runs (CallRoutineOf), Call the CallExpression
  LspCallSite = record
    Caller: int64;
    Target: int64;
    Call: int64;
  end;

  LspCallSites = array of LspCallSite;

// True for a byte of a name
routine DoIsNameByte(const AChar: char): bool;
begin
  return ((AChar >= 'A') and (AChar <= 'Z')) or ((AChar >= 'a') and (AChar <= 'z')) or
    ((AChar >= '0') and (AChar <= '9')) or (AChar = '_') or (int32(AChar) >= 0x80);
end;

// True for a declaration that is the caller of the calls inside it
routine DoIsCaller(const AKind: NodeKind): bool;
begin
  return (AKind = NodeKind.RoutineDecl) or (AKind = NodeKind.MethodDecl) or
    (AKind = NodeKind.InitDecl) or (AKind = NodeKind.CopyDecl) or
    (AKind = NodeKind.DoneDecl) or (AKind = NodeKind.OperatorDecl);
end;

// The routine ADecl stands for in the hierarchy (see the header); 0 when none
public routine CallRoutineOf(const ATree: ref SyntaxTree; const ADecl: int64): int64;
var
  LDecl: int64;
  LParent: int64;
  LKind: NodeKind;
begin
  LDecl := ADecl;
  if LDecl = 0 then
    return 0;
  end;
  if ATree[LDecl].Kind = NodeKind.GenericInstance then
    LDecl := ATree[LDecl].ResolvedDecl;
  else
    LParent := ATree.ParentOf(LDecl);
    if (LParent <> 0) and (ATree[LParent].Kind = NodeKind.GenericInstance) and
      (ATree.RoleOf(LDecl) = NodeRole.Instance) then
      LDecl := ATree[LParent].ResolvedDecl;
    end;
  end;
  if LDecl = 0 then
    return 0;
  end;
  if (ATree[LDecl].Kind = NodeKind.ForwardRoutine) and (ATree[LDecl].ResolvedDecl <> 0) then
    LDecl := ATree[LDecl].ResolvedDecl;
  end;
  LKind := ATree[LDecl].Kind;
  if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
    (LKind = NodeKind.MethodDecl) then
    return LDecl;
  end;
  return 0;
end;

// The key of the file AFile's name place at ALine / AColumn (see the header)
public routine CallKeyAt(const AFile: string; const ALine: int64; const AColumn: int64): string;
begin
  return AFile + "|" + IntToStr(ALine) + ":" + IntToStr(AColumn);
end;

// The key of the declaration (or module) AId (see the header); "" when it has no place
public routine CallKey(const ATree: ref SyntaxTree; const AId: int64): string;
var
  LPlace: SourcePlace;
begin
  LPlace := ATree[AId].AtName();
  if LPlace.IsNone() then
    return "";
  end;
  return CallKeyAt(LPlace.FileName, int64(LPlace.Line), int64(LPlace.Column));
end;

// The callee of the call ACall, parentheses skipped (0: none)
routine DoCalleeOf(const ATree: ref SyntaxTree; const ACall: int64): int64;
var
  LCallee: int64;
begin
  LCallee := ATree.FirstOf(ACall, NodeRole.Callee);
  while (LCallee <> 0) and (ATree[LCallee].Kind = NodeKind.ParenExpression) do
    LCallee := ATree.FirstOf(LCallee, NodeRole.Operand);
  end;
  return LCallee;
end;

// Where the call ACall's callee name is in ADocument (its file's text): [AStart, AEnd);
// false when it has no place there
public routine CallSiteRange(const ATree: ref SyntaxTree; const ACall: int64;
  const ADocument: ref LspDocument; var AStart: int64; var AEnd: int64): bool;
var
  LCallee: int64;
  LPlace: SourcePlace;
begin
  AStart := 0;
  AEnd := 0;
  LCallee := DoCalleeOf(ATree, ACall);
  if (LCallee = 0) or (ADocument = nil) then
    return false;
  end;
  LPlace := ATree[LCallee].AtName();
  if LPlace.IsNone() then
    return false;
  end;
  AStart := ADocument.OffsetOfPlace(int64(LPlace.Line), int64(LPlace.Column));
  AEnd := AStart;
  while (AEnd < len(ADocument.Text)) and DoIsNameByte(ADocument.Text[AEnd]) do
    AEnd := AEnd + 1;
  end;
  return true;
end;

type
  // One collection (see the header)
  LspSiteFinder = object
    hidden FTree: ref SyntaxTree;
    hidden FCaller: int64;
    hidden FSites: LspCallSites;

    init(const ATree: ref SyntaxTree);
    begin
      self.FTree := ATree;
      self.FCaller := 0;
      setlength(self.FSites, 0);
    end;

    method Run(const AModule: int64): LspCallSites;
    begin
      if (self.FTree <> nil) and (AModule <> 0) then
        self.FCaller := AModule;
        self.DoWalk(AModule);
      end;
      return self.FSites;
    end;

    // AId and every node below it looked at, a routine-like declaration the caller of the
    // calls inside it (a write summary has no places: not walked)
    hidden method DoWalk(const AId: int64);
    var
      LI: int64;
      LChild: int64;
      LOuter: int64;
      LCaller: int64;
    begin
      if self.FTree[AId].Kind = NodeKind.CallExpression then
        self.DoCall(AId);
      end;
      LOuter := self.FCaller;
      if DoIsCaller(self.FTree[AId].Kind) then
        // an instance's copy of a routine reads as the template
        LCaller := CallRoutineOf(self.FTree, AId);
        if LCaller = 0 then
          LCaller := AId;
        end;
        self.FCaller := LCaller;
      end;
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LChild := self.FTree.ChildAt(AId, LI);
        if self.FTree.RoleOf(LChild) <> NodeRole.Effects then
          self.DoWalk(LChild);
        end;
      end;
      self.FCaller := LOuter;
    end;

    // The call ACall kept when the check bound it to a routine
    hidden method DoCall(const ACall: int64);
    var
      LCallee: int64;
      LTarget: int64;
      LCount: int64;
    begin
      LCallee := DoCalleeOf(self.FTree, ACall);
      if (LCallee = 0) or ((self.FTree[LCallee].Kind <> NodeKind.NameExpression) and
        (self.FTree[LCallee].Kind <> NodeKind.MemberExpression)) then
        return;
      end;
      LTarget := CallRoutineOf(self.FTree, self.FTree[LCallee].ResolvedDecl);
      if LTarget = 0 then
        return;
      end;
      LCount := len(self.FSites);
      setlength(self.FSites, LCount + 1);
      self.FSites[LCount].Caller := self.FCaller;
      self.FSites[LCount].Target := LTarget;
      self.FSites[LCount].Call := ACall;
    end;
  end;

// Every call of the module AModule of ATree bound to a routine, with its caller (see the
// header), in tree order
public routine CallSites(const ATree: ref SyntaxTree; const AModule: int64): LspCallSites;
var
  LFinder: ref LspSiteFinder;
begin
  LFinder := ref LspSiteFinder(ATree);
  return LFinder.Run(AModule);
end;

end.
