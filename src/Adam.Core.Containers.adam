-------------------------------------------------------------------------------
  Adam.Core.Containers.adam - the compiler's containers, over System.Collections'
  generic ones (PLAN-ADAM M10h, AD.8)

  Int64List   List<int64>: the ids the AST and the backend's IR hand out
              (nodes, instructions, blocks, functions) in the order added;
              the AST names it NodeList
  IdMap<K>    a map from K (any type with hash(X) and '=', BNF sec 7) to an
              int64 id or value, a value the map was made with (init)
              standing for "none": Find answers it for a key the map does not
              hold, so a caller asks once instead of Has then Get. Unlike
              System.Collections' Map (insertion-ordered, keys removable, an
              index over dense entries) it is one open-addressed table
              (linear probing, a power-of-two size kept at most half full,
              each key's hash stored), keys never removed: the backend's hot
              lookups probe one place, not an index and then an entry
  StringIdMap IdMap<string> made with 0: the backend's names (sections,
              symbols, imports) found without a scan
  Int64Map    IdMap<int64>: the backend's per-function facts keyed by a
              module-wide id (an instruction's vreg, a block's machine
              block), sized to the function, so a function's work never grows
              with the module
  TextBuilder a text built by appending in place, O(n) for n bytes
*******************************************************************************/

module unit Adam.Core.Containers;

import System.SysUtils, System.Collections;

public const
  // A text builder's first storage, doubled each time it is full
  ADAM_CONTAINERS_FIRST_CAPACITY: int64 = 4;
  // An id map's first table, doubled each time it would be more than half full
  ADAM_CONTAINERS_FIRST_TABLE: int64 = 16;
  // The bit an id map sets in every stored key hash, so none is the empty place's 0
  ADAM_CONTAINERS_HASH_TAKEN: uint64 = 0x8000000000000000;

public type
  // A list of int64 values, in the order added
  Int64List = List<int64>;

  // A map from K to an int64 id or value; a key it does not hold reads as the missing value
  // the map was made with (see the header)
  IdMap<K> = object
    hidden FKeys: array of K;
    hidden FValues: array of int64;
    // Each place's key hash with its top bit set (DoHash), 0 for an empty place: a probe
    // compares a key only where its hash matches, a grow places the keys by their stored
    // hashes (no key hashed again)
    hidden FHashes: array of uint64;
    hidden FCount: int64;
    hidden FMissing: int64;

    // An empty map whose Find answers AMissing for a key it does not hold
    init(const AMissing: int64);
    begin
      self.FCount := 0;
      self.FMissing := AMissing;
    end;

    // How many keys the map holds
    property Count: int64 read FCount;

    // AKey's hash as a place stores it: hash(X) (BNF sec 7) with the top bit set, so it is
    // never the empty place's 0
    hidden const method DoHash(const AKey: K): uint64;
    begin
      return hash(AKey) | ADAM_CONTAINERS_HASH_TAKEN;
    end;

    // The place holding AKey (its stored hash AHash), or the empty one where it would go;
    // the table is not empty and has an empty place (kept at most half full)
    hidden const method DoPlace(const AKey: K; const AHash: uint64): int64;
    var
      LMask: int64;
      LPlace: int64;
    begin
      LMask := len(self.FHashes) - 1;
      LPlace := int64(AHash & uint64(LMask));
      // linear probing: the next place until AKey's or an empty one
      while self.FHashes[LPlace] <> uint64(0) do
        if (self.FHashes[LPlace] = AHash) and (self.FKeys[LPlace] = AKey) then
          return LPlace;
        end;
        LPlace := (LPlace + 1) & LMask;
      end;
      return LPlace;
    end;

    // The table at twice its size (the first table when there is none), every key moved to
    // the place its stored hash gives
    hidden method DoGrow();
    var
      LOldKeys: array of K;
      LOldValues: array of int64;
      LOldHashes: array of uint64;
      LSize: int64;
      LMask: int64;
      LPlace: int64;
      LI: int64;
    begin
      LOldKeys := self.FKeys;
      LOldValues := self.FValues;
      LOldHashes := self.FHashes;
      LSize := len(LOldHashes) * 2;
      if LSize < ADAM_CONTAINERS_FIRST_TABLE then
        LSize := ADAM_CONTAINERS_FIRST_TABLE;
      end;
      setlength(self.FKeys, 0);
      setlength(self.FValues, 0);
      setlength(self.FHashes, 0);
      setlength(self.FKeys, LSize);
      setlength(self.FValues, LSize);
      setlength(self.FHashes, LSize);
      LMask := LSize - 1;
      for LI := 0 to len(LOldHashes) - 1 do
        if LOldHashes[LI] <> uint64(0) then
          // the keys are distinct, so the first empty place of the probe line is the one
          LPlace := int64(LOldHashes[LI] & uint64(LMask));
          while self.FHashes[LPlace] <> uint64(0) do
            LPlace := (LPlace + 1) & LMask;
          end;
          self.FKeys[LPlace] := LOldKeys[LI];
          self.FValues[LPlace] := LOldValues[LI];
          self.FHashes[LPlace] := LOldHashes[LI];
        end;
      end;
    end;

    // The value of AKey; the map's missing value when it does not hold AKey
    const method Find(const AKey: K): int64;
    var
      LPlace: int64;
    begin
      if self.FCount = 0 then
        return self.FMissing;
      end;
      LPlace := self.DoPlace(AKey, self.DoHash(AKey));
      if self.FHashes[LPlace] = uint64(0) then
        return self.FMissing;
      end;
      return self.FValues[LPlace];
    end;

    // Maps AKey to AValue (in place of a value it had)
    method Put(const AKey: K; const AValue: int64);
    var
      LHash: uint64;
      LPlace: int64;
    begin
      if (self.FCount + 1) * 2 > len(self.FHashes) then
        self.DoGrow();
      end;
      LHash := self.DoHash(AKey);
      LPlace := self.DoPlace(AKey, LHash);
      if self.FHashes[LPlace] = uint64(0) then
        self.FKeys[LPlace] := AKey;
        self.FHashes[LPlace] := LHash;
        self.FCount := self.FCount + 1;
      end;
      self.FValues[LPlace] := AValue;
    end;
  end;

  // A map from string keys to ids, 0 for none (made with StringIdMap(0))
  StringIdMap = IdMap<string>;

  // A map from int64 keys to int64 values, its missing value given when it is made
  Int64Map = IdMap<int64>;

  // A text built by appending, in place: the storage doubles when it is full, so building n
  // bytes costs O(n) (LText := LText + part copies the text so far on every part: O(n^2))
  TextBuilder = object
    hidden FText: string;
    hidden FCount: int64;

    init();
    begin
      self.FText := "";
      self.FCount := 0;
    end;

    // The bytes appended so far
    property Count: int64 read FCount;

    // Appends AText at the end
    method Add(const AText: string);
    var
      LNeed: int64;
      LSize: int64;
      LI: int64;
    begin
      LNeed := self.FCount + len(AText);
      if LNeed > len(self.FText) then
        LSize := len(self.FText) * 2;
        if LSize < ADAM_CONTAINERS_FIRST_CAPACITY then
          LSize := ADAM_CONTAINERS_FIRST_CAPACITY;
        end;
        if LSize < LNeed then
          LSize := LNeed;
        end;
        setlength(self.FText, LSize);
      end;
      for LI := 0 to len(AText) - 1 do
        self.FText[self.FCount + LI] := AText[LI];
      end;
      self.FCount := LNeed;
    end;

    // The text appended so far
    const method Text(): string;
    begin
      return Substring(self.FText, 0, self.FCount);
    end;
  end;

end.
