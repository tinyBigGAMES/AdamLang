-------------------------------------------------------------------------------
  Adam.Core.Containers.adam - hand-written containers (until M10's generics)

  Int64List   a growable list of int64 values in the order added: the ids
              the AST and the backend's IR hand out (nodes, instructions,
              blocks, functions); the AST names it NodeList
  StringIdMap a map from string keys to ids (0 is none): the backend's
              names (sections, symbols, imports) found without a scan.
              Open addressing over a power-of-two table, kept at most half
              full; a key is never removed
*******************************************************************************/

module unit Adam.Core.Containers;

import System.SysUtils;

exported const
  // Raised (an invariant broken) by an index outside a list
  ADAM_CONTAINERS_FAULT_INDEX: string = "Int64List: no index ";
  // A list's first storage, doubled each time it is full
  ADAM_CONTAINERS_FIRST_CAPACITY: int64 = 4;
  // A map's first table, doubled each time it would be more than half full
  ADAM_CONTAINERS_FIRST_TABLE: int64 = 16;
  // Raised (an invariant broken) by an id of 0 put into a map (0 means none)
  ADAM_CONTAINERS_FAULT_NO_ID: string = "StringIdMap: id 0 for key ";

// The 64-bit hash of AKey's bytes: each byte xor-ed into a 5-bit rotation of the hash so
// far, then the high bits folded down (the table index is taken from the low bits)
exported routine StringHash(const AKey: string): uint64;
var
  LHash: uint64;
  LI: int64;
begin
  LHash := 0;
  for LI := 0 to len(AKey) - 1 do
    LHash := ((LHash shl uint64(5)) | (LHash shr uint64(59))) xor uint64(uint8(AKey[LI]));
  end;
  LHash := LHash xor (LHash shr uint64(31));
  LHash := LHash xor (LHash shr uint64(17));
  return LHash;
end;

exported type
  // A list of int64 values, in the order added
  Int64List = object
    hidden FItems: array of int64;
    hidden FCount: int64;

    init();
    begin
      self.FCount := 0;
    end;

    property Count: int64 read FCount;

    // The value at AIndex (0-based); raises outside 0 .. Count - 1
    property Items[AIndex: int64]: int64
      read
      begin
        if (AIndex < 0) or (AIndex >= self.FCount) then
          raise(ADAM_CONTAINERS_FAULT_INDEX + IntToStr(AIndex));
        end;
        return self.FItems[AIndex];
      end;
      default;

    // Adds AValue at the end (the storage doubles when it is full)
    method Add(const AValue: int64);
    begin
      if self.FCount = len(self.FItems) then
        if self.FCount = 0 then
          setlength(self.FItems, ADAM_CONTAINERS_FIRST_CAPACITY);
        else
          setlength(self.FItems, self.FCount * 2);
        end;
      end;
      self.FItems[self.FCount] := AValue;
      self.FCount := self.FCount + 1;
    end;

    // Puts AValue at AIndex in place of the value there; raises outside the list
    method Put(const AIndex: int64; const AValue: int64);
    begin
      if (AIndex < 0) or (AIndex >= self.FCount) then
        raise(ADAM_CONTAINERS_FAULT_INDEX + IntToStr(AIndex));
      end;
      self.FItems[AIndex] := AValue;
    end;

    // Takes the last value off the list and returns it; raises when it is empty
    method RemoveLast(): int64;
    begin
      if self.FCount = 0 then
        raise(ADAM_CONTAINERS_FAULT_INDEX + IntToStr(-1));
      end;
      self.FCount := self.FCount - 1;
      return self.FItems[self.FCount];
    end;

    // The index of the first AValue in the list; -1 when it is not there
    const method IndexOf(const AValue: int64): int64;
    var
      LI: int64;
    begin
      for LI := 0 to self.FCount - 1 do
        if self.FItems[LI] = AValue then
          return LI;
        end;
      end;
      return -1;
    end;
  end;

  // A map from string keys to ids (see the header)
  StringIdMap = object
    hidden FKeys: array of string;
    hidden FIds: array of int64;
    hidden FCount: int64;

    init();
    begin
      self.FCount := 0;
    end;

    // How many keys the map holds
    property Count: int64 read FCount;

    // The table index holding AKey, or the empty one where it would go; the table is not
    // empty and has an empty place (it is kept at most half full). An empty place has id 0
    hidden const method DoIndex(const AKey: string): int64;
    var
      LMask: int64;
      LIndex: int64;
    begin
      LMask := len(self.FIds) - 1;
      LIndex := int64(StringHash(AKey) & uint64(LMask));
      // Linear probing: the next place until AKey or an empty place
      while (self.FIds[LIndex] <> 0) and (self.FKeys[LIndex] <> AKey) do
        LIndex := (LIndex + 1) & LMask;
      end;
      return LIndex;
    end;

    // The table at twice its size (the first table when there is none), every key moved
    hidden method DoGrow();
    var
      LOldKeys: array of string;
      LOldIds: array of int64;
      LSize: int64;
      LI: int64;
      LIndex: int64;
    begin
      LOldKeys := self.FKeys;
      LOldIds := self.FIds;
      LSize := len(LOldIds) * 2;
      if LSize < ADAM_CONTAINERS_FIRST_TABLE then
        LSize := ADAM_CONTAINERS_FIRST_TABLE;
      end;
      setlength(self.FKeys, 0);
      setlength(self.FIds, 0);
      setlength(self.FKeys, LSize);
      setlength(self.FIds, LSize);
      for LI := 0 to len(LOldIds) - 1 do
        if LOldIds[LI] <> 0 then
          LIndex := self.DoIndex(LOldKeys[LI]);
          self.FKeys[LIndex] := LOldKeys[LI];
          self.FIds[LIndex] := LOldIds[LI];
        end;
      end;
    end;

    // The id of AKey; 0 when the map does not hold it
    const method Find(const AKey: string): int64;
    begin
      if self.FCount = 0 then
        return 0;
      end;
      return self.FIds[self.DoIndex(AKey)];
    end;

    // Maps AKey to AId (in place of an id it had); raises for AId 0 (0 means none)
    method Put(const AKey: string; const AId: int64);
    var
      LIndex: int64;
    begin
      if AId = 0 then
        raise(ADAM_CONTAINERS_FAULT_NO_ID + "'" + AKey + "'");
      end;
      if (self.FCount + 1) * 2 > len(self.FIds) then
        self.DoGrow();
      end;
      LIndex := self.DoIndex(AKey);
      if self.FIds[LIndex] = 0 then
        self.FKeys[LIndex] := AKey;
        self.FCount := self.FCount + 1;
      end;
      self.FIds[LIndex] := AId;
    end;
  end;

end.
