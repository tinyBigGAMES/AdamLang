-------------------------------------------------------------------------------
  Adam.Target.Registry.adam - The targets Adam has

  The one list of Target implementations (Adam.Target). Every question of
  which targets exist is asked here: whether a triple names one (an
  @target's check in Adam.Compiler.Conditionals, the Driver's pick), which
  one a build has when nothing names one (DefaultTriple), what a user typed
  (FindTargetNamed: a name or a triple, the command line's -t), and the list
  a message or the help names (AllTargets, KnownTriples). A new target is
  one more entry in DoCandidates, nothing else above its own parts: the
  command line and its help take it from here.
*******************************************************************************/

module unit Adam.Target.Registry;

import Adam.Target, Adam.Target.Win64;

exported type
  // Every Target Adam has, made fresh (a compile owns the one it picks)
  TargetList = array of ref Target;

// Every target, in the order a message lists them
routine DoCandidates(): TargetList;
var
  LList: TargetList;
begin
  setlength(LList, 1);
  LList[0] := ref Win64Target();
  return LList;
end;

// The Target whose triple is ATriple (normalized, arch-os-abi); nil when Adam has none
exported routine FindTarget(const ATriple: string): ref Target;
var
  LList: TargetList;
  LI: int64;
begin
  LList := DoCandidates();
  for LI := 0 to len(LList) - 1 do
    if LList[LI].Triple() = ATriple then
      return LList[LI];
    end;
  end;
  return nil;
end;

// The Target a user wrote as AText: its short name or its triple; nil when Adam has none
exported routine FindTargetNamed(const AText: string): ref Target;
var
  LList: TargetList;
  LI: int64;
begin
  LList := DoCandidates();
  for LI := 0 to len(LList) - 1 do
    if (LList[LI].TargetName() = AText) or (LList[LI].Triple() = AText) then
      return LList[LI];
    end;
  end;
  return nil;
end;

// Every target, in the order a message or the help lists them
exported routine AllTargets(): TargetList;
begin
  return DoCandidates();
end;

// The triple of the target a build has when nothing names one: the target that says it is
// the default (the registry holds exactly one; the first target if none said so)
exported routine DefaultTriple(): string;
var
  LList: TargetList;
  LI: int64;
begin
  LList := DoCandidates();
  for LI := 0 to len(LList) - 1 do
    if LList[LI].IsDefault() then
      return LList[LI].Triple();
    end;
  end;
  return LList[0].Triple();
end;

// The triples of every target, comma separated, as a message lists them
exported routine KnownTriples(): string;
var
  LList: TargetList;
  LI: int64;
  LText: string;
begin
  LList := DoCandidates();
  LText := "";
  for LI := 0 to len(LList) - 1 do
    if LI > 0 then
      LText := LText + ", ";
    end;
    LText := LText + LList[LI].Triple();
  end;
  return LText;
end;

end.
