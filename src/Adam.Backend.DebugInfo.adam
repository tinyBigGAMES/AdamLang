-------------------------------------------------------------------------------
  Adam.Backend.DebugInfo.adam - a debug build's debug information, target-
  neutral (DESIGN sec 9, M7)

  DebugModule      what a debugger needs of one generated module, built by
                   Generate for a debug build from the tree and each
                   function's generated FunctionCode, written by the format
                   part (COFF: CodeView, later ELF: DWARF); no format's word
                   in it:
    files          the source files its rows name (full paths), by index
    functions      each generated function: its symbol, its Adam name (the
                   module, an object type's name for a method, the routine),
                   its code's bytes, where its prologue ends, its frame base
                   ("" the stack pointer after the prologue; a realigned
                   frame's register by the arch part's name), its line rows
                   (code offset from its symbol, line, column, file; a run
                   of one place merged), its parameters and locals (each at
                   its frame slot's offset from the frame base, with its
                   type); a funclet names its parent function's symbol
    globals        each module variable the module places: its symbol, its
                   Adam name, its type, thread-local or not
    types          every type a variable or a field reaches, by index (0:
                   none): scalars, pointers, static arrays, records /
                   overlays / objects with their fields, choices with their
                   values, routine types; any other Adam type (string,
                   wstring, a dynamic array, a set, ref / own / weak, a
                   task, a sequence, an interface) an Opaque type of its
                   Adam name and size, which the debugger formats by name
  DebugInfoMaker   builds a DebugModule: Add(irfunction, code) per
                   generated function, AddGlobals once, then Module
  Text             the module as text, one line per item (the rows' view;
                   AFileFilter keeps one file's functions and globals)
*******************************************************************************/

module unit Adam.Backend.DebugInfo;

import System.SysUtils, System.Collections, Adam.Core.Containers, Adam.Target,
  Adam.Compiler.SourceText, Adam.Compiler.AST, Adam.Compiler.Scopes, Adam.Compiler.Types,
  Adam.Compiler.Layout, Adam.Backend.Ssa, Adam.Backend.Parts;

public type
  // What a debug type is (see the header)
  DebugTypeKind = choices(Signed, Unsigned, Float, Boolean, Char, WideChar, Pointer,
    StaticArray, Record, Overlay, Object, Choices, Routine, Opaque);

  // A field of a record, overlay or object type: its name, byte offset, type and, for a
  // bitfield, its bit offset in the unit at Offset and its width (0: not a bitfield)
  DebugField = object
    FieldName: string;
    Offset: int64;
    TypeId: int64;
    BitOffset: int64;
    BitWidth: int64;

    init(const AFieldName: string; const AOffset: int64; const ATypeId: int64);
    begin
      self.FieldName := AFieldName;
      self.Offset := AOffset;
      self.TypeId := ATypeId;
      self.BitOffset := 0;
      self.BitWidth := 0;
    end;
  end;

  // A choices type's value: its name and number
  DebugValue = object
    ValueName: string;
    Number: int64;

    init(const AValueName: string; const ANumber: int64);
    begin
      self.ValueName := AValueName;
      self.Number := ANumber;
    end;
  end;

  // One debug type (see the header). Target: a pointer's target or a static array's
  // element (0: untyped / unknown); Count: a static array's elements
  DebugType = object
    Kind: DebugTypeKind;
    TypeName: string;
    Size: int64;
    Target: int64;
    Count: int64;
    Fields: ref List<ref DebugField>;
    Values: ref List<ref DebugValue>;

    init(const AKind: DebugTypeKind; const ATypeName: string; const ASize: int64);
    begin
      self.Kind := AKind;
      self.TypeName := ATypeName;
      self.Size := ASize;
      self.Target := 0;
      self.Count := 0;
      self.Fields := ref List<ref DebugField>();
      self.Values := ref List<ref DebugValue>();
    end;
  end;

  // A parameter or a local of a function: its name, its slot's offset from the function's
  // frame base, its type
  DebugVariable = object
    VariableName: string;
    IsParam: bool;
    Offset: int64;
    TypeId: int64;

    init(const AVariableName: string; const AIsParam: bool; const AOffset: int64;
      const ATypeId: int64);
    begin
      self.VariableName := AVariableName;
      self.IsParam := AIsParam;
      self.Offset := AOffset;
      self.TypeId := ATypeId;
    end;
  end;

  // A line row: the code from Offset (from the function's symbol) to the next row is the
  // place Line, Column of file FileIndex
  DebugLine = object
    Offset: int64;
    Line: int64;
    Column: int64;
    FileIndex: int64;

    init(const AOffset: int64; const ALine: int64; const AColumn: int64; const AFileIndex: int64);
    begin
      self.Offset := AOffset;
      self.Line := ALine;
      self.Column := AColumn;
      self.FileIndex := AFileIndex;
    end;
  end;

  // One generated function (see the header). FileIndex / Line: its declaration's place
  // (-1 / 0: none); ParentSymbol: a funclet's parent's symbol ("" none)
  DebugFunction = object
    Symbol: string;
    AdamName: string;
    ParentSymbol: string;
    ByteCount: int64;
    PrologueEnd: int64;
    FrameBase: string;
    FileIndex: int64;
    Line: int64;
    Lines: ref List<ref DebugLine>;
    Variables: ref List<ref DebugVariable>;

    init(const ASymbol: string);
    begin
      self.Symbol := ASymbol;
      self.AdamName := ASymbol;
      self.ParentSymbol := "";
      self.ByteCount := 0;
      self.PrologueEnd := 0;
      self.FrameBase := "";
      self.FileIndex := -1;
      self.Line := 0;
      self.Lines := ref List<ref DebugLine>();
      self.Variables := ref List<ref DebugVariable>();
    end;
  end;

  // A module variable the module places (see the header)
  DebugGlobal = object
    Symbol: string;
    AdamName: string;
    TypeId: int64;
    ThreadLocal: bool;
    FileIndex: int64;
    Line: int64;

    init(const ASymbol: string; const AAdamName: string; const ATypeId: int64);
    begin
      self.Symbol := ASymbol;
      self.AdamName := AAdamName;
      self.TypeId := ATypeId;
      self.ThreadLocal := false;
      self.FileIndex := -1;
      self.Line := 0;
    end;
  end;

  // A module's debug information (see the header); Types[0] is the none type
  DebugModule = object
    Files: StringArray;
    Functions: ref List<ref DebugFunction>;
    Globals: ref List<ref DebugGlobal>;
    Types: ref List<ref DebugType>;

    init();
    begin
      setlength(self.Files, 0);
      self.Functions := ref List<ref DebugFunction>();
      self.Globals := ref List<ref DebugGlobal>();
      self.Types := ref List<ref DebugType>();
      self.Types.Add(ref DebugType(DebugTypeKind.Opaque, "", 0));
    end;
  end;

// The name of AKind as Text writes it
public routine DebugTypeKindText(const AKind: DebugTypeKind): string;
begin
  match AKind of
    DebugTypeKind.Signed: return "signed";
    DebugTypeKind.Unsigned: return "unsigned";
    DebugTypeKind.Float: return "float";
    DebugTypeKind.Boolean: return "bool";
    DebugTypeKind.Char: return "char";
    DebugTypeKind.WideChar: return "wchar";
    DebugTypeKind.Pointer: return "pointer";
    DebugTypeKind.StaticArray: return "array";
    DebugTypeKind.Record: return "record";
    DebugTypeKind.Overlay: return "overlay";
    DebugTypeKind.Object: return "object";
    DebugTypeKind.Choices: return "choices";
    DebugTypeKind.Routine: return "routine";
    DebugTypeKind.Opaque: return "opaque";
  end;
  return "";
end;

public type
  // Builds a DebugModule (see the header)
  DebugInfoMaker = object
    hidden FTree: ref SyntaxTree;
    hidden FTarget: ref Target;
    hidden FModule: ref DebugModule;
    // FModule.Files' index + 1 by full path
    hidden FFileIds: ref StringIdMap;
    // A debug type's index by its canonical AST type
    hidden FTypeIds: ref Int64Map;

    init(const ATree: ref SyntaxTree; const ATarget: ref Target);
    begin
      self.FTree := ATree;
      self.FTarget := ATarget;
      self.FModule := ref DebugModule();
      self.FFileIds := ref StringIdMap(0);
      self.FTypeIds := ref Int64Map(0);
    end;

    property Module: ref DebugModule read FModule;

    // The file index of AFile (a full path), added on its first ask
    hidden method DoFileIndex(const AFile: string): int64;
    var
      LId: int64;
    begin
      LId := self.FFileIds.Find(AFile);
      if LId <> 0 then
        return LId - 1;
      end;
      setlength(self.FModule.Files, len(self.FModule.Files) + 1);
      self.FModule.Files[len(self.FModule.Files) - 1] := AFile;
      self.FFileIds.Put(AFile, len(self.FModule.Files));
      return len(self.FModule.Files) - 1;
    end;

    // The kind of a scalar or pointer class (Opaque for any other)
    hidden const method DoScalarKind(const AClass: TypeClass): DebugTypeKind;
    begin
      match AClass of
        TypeClass.SignedInt: return DebugTypeKind.Signed;
        TypeClass.UnsignedInt: return DebugTypeKind.Unsigned;
        TypeClass.Float: return DebugTypeKind.Float;
        TypeClass.Boolean: return DebugTypeKind.Boolean;
        TypeClass.Char: return DebugTypeKind.Char;
        TypeClass.WideChar: return DebugTypeKind.WideChar;
        TypeClass.Pointer: return DebugTypeKind.Pointer;
        TypeClass.UntypedPointer: return DebugTypeKind.Pointer;
        TypeClass.StaticArray: return DebugTypeKind.StaticArray;
        TypeClass.RecordType: return DebugTypeKind.Record;
        TypeClass.OverlayType: return DebugTypeKind.Overlay;
        TypeClass.ObjectType: return DebugTypeKind.Object;
        TypeClass.ChoicesType: return DebugTypeKind.Choices;
        TypeClass.RoutineType: return DebugTypeKind.Routine;
      else
        // every other Adam type is formatted by its name (see the header)
      end;
      return DebugTypeKind.Opaque;
    end;

    // The fields of the aggregate AType (its body's field members, and an object's parent
    // part as a field "parent") added to ADebug
    hidden method DoFields(const AType: int64; const ADebug: ref DebugType);
    var
      LBody: int64;
      LMember: int64;
      LParent: int64;
      LField: ref DebugField;
      LI: int64;
    begin
      LBody := BodyOf(self.FTree, AType);
      if LBody = 0 then
        return;
      end;
      LParent := self.FTree.FirstOf(LBody, NodeRole.Parent);
      if (LParent <> 0) and (self.FTree[LParent].ResolvedDecl <> 0) then
        ADebug.Fields.Add(ref DebugField("parent", self.FTree[LParent].ResolvedOffset,
          self.TypeOf(DeclaredTypeOf(self.FTree, self.FTree[LParent].ResolvedDecl))));
      end;
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if self.FTree[LMember].Kind <> NodeKind.FieldDecl then
          skip;
        end;
        LField := ref DebugField(self.FTree[LMember].Text, self.FTree[LMember].ResolvedOffset,
          self.TypeOf(VariableTypeOf(self.FTree, LMember)));
        if self.FTree[LMember].ResolvedBitWidth > 0 then
          LField.BitOffset := int64(self.FTree[LMember].ResolvedBitOffset);
          LField.BitWidth := int64(self.FTree[LMember].ResolvedBitWidth);
        end;
        ADebug.Fields.Add(LField);
      end;
    end;

    // The values of the choices type AType added to ADebug
    hidden method DoValues(const AType: int64; const ADebug: ref DebugType);
    var
      LBody: int64;
      LValue: int64;
      LI: int64;
    begin
      LBody := BodyOf(self.FTree, AType);
      if LBody = 0 then
        return;
      end;
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LValue := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if self.FTree[LValue].ResolvedConst.Kind = ConstKind.Signed then
          ADebug.Values.Add(ref DebugValue(self.FTree[LValue].Text,
            int64(self.FTree[LValue].ResolvedConst.Bits)));
        end;
      end;
    end;

    // The debug type of the canonical AST type AType (0: none), added on its first ask: its
    // index is kept before its fields are, so a type reaching itself through a pointer
    // takes that index
    method TypeOf(const AType: int64): int64;
    var
      LId: int64;
      LClass: TypeClass;
      LDebug: ref DebugType;
    begin
      if AType = 0 then
        return 0;
      end;
      LId := self.FTypeIds.Find(AType);
      if LId <> 0 then
        return LId;
      end;
      LClass := ClassOf(self.FTree, AType);
      LDebug := ref DebugType(self.DoScalarKind(LClass), TypeText(self.FTree, AType),
        TypeSize(self.FTree, self.FTarget, AType));
      LId := self.FModule.Types.Count;
      self.FModule.Types.Add(LDebug);
      self.FTypeIds.Put(AType, LId);
      match LDebug.Kind of
        DebugTypeKind.Pointer:
          // an untyped ptr's target stays 0
          LDebug.Target := self.TypeOf(TargetOf(self.FTree, AType));
        DebugTypeKind.StaticArray:
          LDebug.Target := self.TypeOf(TargetOf(self.FTree, AType));
          LDebug.Count := ArrayCount(self.FTree, self.FTarget, AType);
        DebugTypeKind.Record, DebugTypeKind.Overlay, DebugTypeKind.Object:
          self.DoFields(AType, LDebug);
        DebugTypeKind.Choices:
          self.DoValues(AType, LDebug);
      else
        // a scalar, a routine type or an opaque type has no parts
      end;
      return LId;
    end;

    // The Adam name of the declaration ADecl: its module's name, an object type's name for
    // a method, then its own, dot-joined
    hidden const method DoAdamName(const ADecl: int64): string;
    var
      LName: string;
      LAt: int64;
    begin
      LName := self.FTree[ADecl].Text;
      LAt := self.FTree.ParentOf(ADecl);
      while LAt <> 0 do
        if self.FTree[LAt].Kind = NodeKind.TypeDecl then
          LName := self.FTree[LAt].Text + "." + LName;
        end;
        if self.FTree[LAt].Kind = NodeKind.Module then
          return self.FTree[LAt].Text + "." + LName;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return LName;
    end;

    // True when ANode is a routine's own declaration (a routine, a method, an operator, an
    // init / copy / done): a function made for it takes its Adam name and place
    hidden const method DoIsRoutineNode(const ANode: int64): bool;
    var
      LKind: NodeKind;
    begin
      if ANode = 0 then
        return false;
      end;
      LKind := self.FTree[ANode].Kind;
      return (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.MethodDecl) or
        (LKind = NodeKind.OperatorDecl) or (LKind = NodeKind.InitDecl) or
        (LKind = NodeKind.CopyDecl) or (LKind = NodeKind.DoneDecl);
    end;

    // ACode's rows into AFunction's (a run of one place merged)
    hidden method DoLines(const ACode: ref FunctionCode; const AFunction: ref DebugFunction);
    var
      LPlace: SourcePlace;
      LLast: ref DebugLine;
      LFile: int64;
      LLastName: string;
      LI: int64;
    begin
      LFile := -1;
      LLastName := "";
      LLast := nil;
      for LI := 0 to ACode.PlaceCount() - 1 do
        LPlace := self.FTree[ACode.PlaceNodeAt(LI)].Place;
        if LPlace.IsNone() then
          skip;
        end;
        if (LFile < 0) or (LPlace.FileName <> LLastName) then
          LLastName := LPlace.FileName;
          LFile := self.DoFileIndex(LLastName);
        end;
        if (LLast <> nil) and (LLast.Line = int64(LPlace.Line)) and
          (LLast.Column = int64(LPlace.Column)) and (LLast.FileIndex = LFile) then
          skip;
        end;
        LLast := ref DebugLine(ACode.PlaceStartAt(LI), int64(LPlace.Line), int64(LPlace.Column),
          LFile);
        AFunction.Lines.Add(LLast);
      end;
    end;

    // The parameters and locals of the IR function AIr (every slot made at a parameter's
    // or a variable's declaration, once each) at their offsets in ACode's frame
    hidden method DoVariables(const AModule: ref IrModule; const AIr: ref IrFunction;
      const ACode: ref FunctionCode; const AFunction: ref DebugFunction);
    var
      LSeen: ref Int64Map;
      LBlock: ref IrBlock;
      LInstr: ref IrInstr;
      LKind: NodeKind;
      LOffset: int64;
      LB: int64;
      LI: int64;
    begin
      LSeen := ref Int64Map(0);
      for LB := 0 to AIr.Blocks.Count - 1 do
        LBlock := AModule.BlockAt(AIr.Blocks.Items[LB]);
        for LI := 0 to LBlock.Instrs.Count - 1 do
          LInstr := AModule.InstrAt(LBlock.Instrs.Items[LI]);
          if (LInstr.Kind <> IrOp.Slot) or (LInstr.Node = 0) or (LSeen.Find(LInstr.Node) <> 0) then
            skip;
          end;
          LKind := self.FTree[LInstr.Node].Kind;
          if (LKind <> NodeKind.Param) and (LKind <> NodeKind.VarDecl) then
            skip;
          end;
          LOffset := ACode.SlotOffsetOf(LBlock.Instrs.Items[LI]);
          if LOffset < 0 then
            skip;
          end;
          LSeen.Put(LInstr.Node, 1);
          AFunction.Variables.Add(ref DebugVariable(self.FTree[LInstr.Node].Text,
            LKind = NodeKind.Param, LOffset,
            self.TypeOf(VariableTypeOf(self.FTree, LInstr.Node))));
        end;
      end;
    end;

    // The generated function ACode of AModule's IR function AIr added (see the header)
    method Add(const AModule: ref IrModule; const AIr: ref IrFunction; const ACode: ref FunctionCode);
    var
      LFunction: ref DebugFunction;
      LPlace: SourcePlace;
    begin
      LFunction := ref DebugFunction(ACode.Symbol);
      LFunction.ByteCount := ACode.ByteCount;
      if ACode.StepCount > 0 then
        LFunction.PrologueEnd := ACode.StepAt(ACode.StepCount - 1).EndsAt;
      end;
      if (ACode.Frame <> nil) and (ACode.Frame.Realign > 0) then
        LFunction.FrameBase := ACode.Frame.FrameRegister;
      end;
      if ACode.ParentCode <> nil then
        LFunction.ParentSymbol := ACode.ParentCode.Symbol;
      else
        if self.DoIsRoutineNode(AIr.Node) then
          LFunction.AdamName := self.DoAdamName(AIr.Node);
        end;
        if AIr.Node <> 0 then
          LPlace := self.FTree[AIr.Node].Place;
          if not LPlace.IsNone() then
            LFunction.FileIndex := self.DoFileIndex(LPlace.FileName);
            LFunction.Line := int64(LPlace.Line);
          end;
        end;
        self.DoVariables(AModule, AIr, ACode, LFunction);
      end;
      self.DoLines(ACode, LFunction);
      self.FModule.Functions.Add(LFunction);
    end;

    // Every module variable AModule places (a blob of a variable's declaration, not
    // declared by another unit) added, in the module's order
    method AddGlobals(const AModule: ref IrModule);
    var
      LBlob: ref IrData;
      LGlobal: ref DebugGlobal;
      LPlace: SourcePlace;
      LD: int64;
    begin
      for LD := 1 to AModule.DataCount - 1 do
        LBlob := AModule.DataAt(LD);
        if LBlob.Declared or (LBlob.Node = 0) or (LBlob.StartList <> StartListPlace.None) then
          skip;
        end;
        if self.FTree[LBlob.Node].Kind <> NodeKind.VarDecl then
          skip;
        end;
        LGlobal := ref DebugGlobal(LBlob.Symbol, self.DoAdamName(LBlob.Node),
          self.TypeOf(VariableTypeOf(self.FTree, LBlob.Node)));
        LGlobal.ThreadLocal := LBlob.ThreadLocal;
        LPlace := self.FTree[LBlob.Node].Place;
        if not LPlace.IsNone() then
          LGlobal.FileIndex := self.DoFileIndex(LPlace.FileName);
          LGlobal.Line := int64(LPlace.Line);
        end;
        self.FModule.Globals.Add(LGlobal);
      end;
    end;
  end;

// The type AId of AModule as Text writes it ("-" for none)
routine DoTypeRef(const AModule: ref DebugModule; const AId: int64): string;
begin
  if AId = 0 then
    return "-";
  end;
  return IntToStr(AId) + ":" + AModule.Types.Items[AId].TypeName;
end;

// AModule as text (see the header): AFileFilter "" every function and global, else only
// those declared in a file of that name (the name alone, no folder), and the types they
// reach listed in full
public routine DebugInfoText(const AModule: ref DebugModule; const AFileFilter: string): string;
var
  LText: ref TextBuilder;
  LFunction: ref DebugFunction;
  LGlobal: ref DebugGlobal;
  LType: ref DebugType;
  LLine: ref DebugLine;
  LVariable: ref DebugVariable;
  LField: ref DebugField;
  LUsed: ref Int64Map;
  LKeep: BoolArray;
  LBase: string;
  LI: int64;
  LJ: int64;
begin
  LText := ref TextBuilder();
  setlength(LKeep, len(AModule.Files));
  for LI := 0 to len(AModule.Files) - 1 do
    LKeep[LI] := (AFileFilter = "") or (ExtractFileName(AModule.Files[LI]) = AFileFilter);
  end;
  LUsed := ref Int64Map(0);
  for LI := 0 to AModule.Functions.Count - 1 do
    LFunction := AModule.Functions.Items[LI];
    if (LFunction.FileIndex < 0) or (not LKeep[LFunction.FileIndex]) then
      skip;
    end;
    // the stack pointer after the prologue when no register holds the frame
    LBase := LFunction.FrameBase;
    if LBase = "" then
      LBase := "sp";
    end;
    LText.Add("function " + LFunction.AdamName + " at " +
      ExtractFileName(AModule.Files[LFunction.FileIndex]) + "(" + IntToStr(LFunction.Line) +
      ") prologue " + BoolToStr(LFunction.PrologueEnd > 0) + " frame " + LBase + "\n");
    for LJ := 0 to LFunction.Variables.Count - 1 do
      LVariable := LFunction.Variables.Items[LJ];
      if LVariable.IsParam then
        LText.Add("  param ");
      else
        LText.Add("  local ");
      end;
      LText.Add(LVariable.VariableName + ": " + DoTypeRef(AModule, LVariable.TypeId) + " at +" +
        IntToStr(LVariable.Offset) + "\n");
      LUsed.Put(LVariable.TypeId, 1);
    end;
    for LJ := 0 to LFunction.Lines.Count - 1 do
      LLine := LFunction.Lines.Items[LJ];
      if LKeep[LLine.FileIndex] then
        LText.Add("  line " + IntToStr(LLine.Line) + "," + IntToStr(LLine.Column) + "\n");
      end;
    end;
  end;
  for LI := 0 to AModule.Globals.Count - 1 do
    LGlobal := AModule.Globals.Items[LI];
    if (LGlobal.FileIndex < 0) or (not LKeep[LGlobal.FileIndex]) then
      skip;
    end;
    LText.Add("global " + LGlobal.AdamName + ": " + DoTypeRef(AModule, LGlobal.TypeId) + "\n");
    LUsed.Put(LGlobal.TypeId, 1);
  end;
  // the types the shown items reach, through targets and fields (indices only grow from
  // a type to what it reaches, but a pointer back may point lower: loop to a fixed point)
  for LI := AModule.Types.Count - 1 downto 1 do
    if LUsed.Find(LI) <> 0 then
      LType := AModule.Types.Items[LI];
      LUsed.Put(LType.Target, 1);
      for LJ := 0 to LType.Fields.Count - 1 do
        LUsed.Put(LType.Fields.Items[LJ].TypeId, 1);
      end;
    end;
  end;
  for LI := 1 to AModule.Types.Count - 1 do
    if LUsed.Find(LI) = 0 then
      skip;
    end;
    LType := AModule.Types.Items[LI];
    LText.Add("type " + IntToStr(LI) + " " + LType.TypeName + " " + DebugTypeKindText(LType.Kind) +
      " size " + IntToStr(LType.Size));
    if (LType.Kind = DebugTypeKind.Pointer) or (LType.Kind = DebugTypeKind.StaticArray) then
      LText.Add(" of " + DoTypeRef(AModule, LType.Target));
    end;
    if LType.Kind = DebugTypeKind.StaticArray then
      LText.Add(" count " + IntToStr(LType.Count));
    end;
    LText.Add("\n");
    for LJ := 0 to LType.Fields.Count - 1 do
      LField := LType.Fields.Items[LJ];
      LText.Add("  field " + LField.FieldName + ": " + DoTypeRef(AModule, LField.TypeId) + " at +" +
        IntToStr(LField.Offset));
      if LField.BitWidth > 0 then
        LText.Add(" bits " + IntToStr(LField.BitOffset) + ":" + IntToStr(LField.BitWidth));
      end;
      LText.Add("\n");
    end;
    for LJ := 0 to LType.Values.Count - 1 do
      LText.Add("  value " + LType.Values.Items[LJ].ValueName + " = " +
        IntToStr(LType.Values.Items[LJ].Number) + "\n");
    end;
  end;
  return LText.Text();
end;

end.
