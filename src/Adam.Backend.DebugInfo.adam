-------------------------------------------------------------------------------
  Adam.Backend.DebugInfo.adam - a debug build's debug information, target-
  neutral (DESIGN sec 9, M7)

  DebugModule      what a debugger needs of one generated module, built by
                   Generate for a debug build from the tree and each
                   function's generated FunctionCode, written by the format
                   part (COFF: CodeView, later ELF: DWARF); no format's word
                   in it:
    files          the source files its rows name (full paths), by index
    functions      each generated function: its symbol, its Adam name (the
                   module, an object type's name for a method, the routine),
                   its code's bytes, where its prologue ends, its frame base
                   ("" the stack pointer after the prologue; a realigned
                   frame's register by the arch part's name), its line rows
                   (code offset from its symbol, line, column, file; a run
                   of one place merged; the code before its body, the
                   prologue and the setup of its own locals and hidden
                   slots, is its declaration line's, so its first row past
                   that line is its first statement), its marks
                   (each @breakpoint's nop, as a line row), its parameters
                   and locals (each at its frame slot's offset from the
                   frame base, with its type); a funclet names its parent
                   function's symbol
    globals        each module variable the module places: its symbol, its
                   Adam name, its type, thread-local or not
    types          every type a variable or a field reaches, by index (0:
                   none): scalars, pointers, static arrays, records /
                   overlays / objects with their fields, choices with their
                   values, routine types; any other Adam type (string,
                   wstring, a dynamic array, a set, ref / own / weak, a
                   task, a sequence, an interface) an Opaque type of its
                   Adam name and size whose first field names its form
                   (Adam.Core.Common's ADAM_DEBUG_FORM_*: typed a pointer
                   to its element when it has one; a set's members next,
                   one bit each), which the debugger formats by it
  (built by Adam.Backend.DebugMaker's DebugInfoMaker; below Adam.Backend.Parts,
  so the format part's WriteDebugInfo takes it)
  Text             the module as text, one line per item (the rows' view;
                   AFileFilter keeps one file's functions and globals)
*******************************************************************************/

module unit Adam.Backend.DebugInfo;

import System.SysUtils, System.Collections, Adam.Core.Containers;

public type
  // What a debug type is (see the header)
  DebugTypeKind = choices(Signed, Unsigned, Float, Boolean, Char, WideChar, Pointer,
    StaticArray, Record, Overlay, Object, Choices, Routine, Opaque);

  // A field of a record, overlay or object type: its name, byte offset, type and, for a
  // bitfield, its bit offset in the unit at Offset and its width (0: not a bitfield)
  DebugField = object
    FieldName: string;
    Offset: int64;
    TypeId: int64;
    BitOffset: int64;
    BitWidth: int64;

    init(const AFieldName: string; const AOffset: int64; const ATypeId: int64);
    begin
      self.FieldName := AFieldName;
      self.Offset := AOffset;
      self.TypeId := ATypeId;
      self.BitOffset := 0;
      self.BitWidth := 0;
    end;
  end;

  // A choices type's value: its name and number
  DebugValue = object
    ValueName: string;
    Number: int64;

    init(const AValueName: string; const ANumber: int64);
    begin
      self.ValueName := AValueName;
      self.Number := ANumber;
    end;
  end;

  // One debug type (see the header). Target: a pointer's target or a static array's
  // element (0: untyped / unknown); Count: a static array's elements
  DebugType = object
    Kind: DebugTypeKind;
    TypeName: string;
    // The name no other type of the program shares: a declared type's module-qualified
    // Adam name (Module.Point), else TypeName (a debugger matches a type across objects
    // by it)
    UniqueName: string;
    Size: int64;
    Target: int64;
    Count: int64;
    Fields: ref List<ref DebugField>;
    Values: ref List<ref DebugValue>;

    init(const AKind: DebugTypeKind; const ATypeName: string; const ASize: int64);
    begin
      self.Kind := AKind;
      self.TypeName := ATypeName;
      self.UniqueName := ATypeName;
      self.Size := ASize;
      self.Target := 0;
      self.Count := 0;
      self.Fields := ref List<ref DebugField>();
      self.Values := ref List<ref DebugValue>();
    end;
  end;

  // A parameter or a local of a function: its name, its slot's offset from the function's
  // frame base, its type
  DebugVariable = object
    VariableName: string;
    IsParam: bool;
    Offset: int64;
    TypeId: int64;

    init(const AVariableName: string; const AIsParam: bool; const AOffset: int64;
      const ATypeId: int64);
    begin
      self.VariableName := AVariableName;
      self.IsParam := AIsParam;
      self.Offset := AOffset;
      self.TypeId := ATypeId;
    end;
  end;

  // A line row: the code from Offset (from the function's symbol) to the next row is the
  // place Line, Column of file FileIndex
  DebugLine = object
    Offset: int64;
    Line: int64;
    Column: int64;
    FileIndex: int64;

    init(const AOffset: int64; const ALine: int64; const AColumn: int64; const AFileIndex: int64);
    begin
      self.Offset := AOffset;
      self.Line := ALine;
      self.Column := AColumn;
      self.FileIndex := AFileIndex;
    end;
  end;

  // One generated function (see the header). FileIndex / Line: its declaration's place
  // (-1 / 0: none); ParentSymbol: a funclet's parent's symbol ("" none)
  DebugFunction = object
    Symbol: string;
    AdamName: string;
    ParentSymbol: string;
    ByteCount: int64;
    PrologueEnd: int64;
    FrameBase: string;
    FileIndex: int64;
    Line: int64;
    Lines: ref List<ref DebugLine>;
    // Each @breakpoint's nop: its offset and place
    Marks: ref List<ref DebugLine>;
    Variables: ref List<ref DebugVariable>;

    init(const ASymbol: string);
    begin
      self.Symbol := ASymbol;
      self.AdamName := ASymbol;
      self.ParentSymbol := "";
      self.ByteCount := 0;
      self.PrologueEnd := 0;
      self.FrameBase := "";
      self.FileIndex := -1;
      self.Line := 0;
      self.Lines := ref List<ref DebugLine>();
      self.Marks := ref List<ref DebugLine>();
      self.Variables := ref List<ref DebugVariable>();
    end;
  end;

  // A module variable the module places (see the header)
  DebugGlobal = object
    Symbol: string;
    AdamName: string;
    TypeId: int64;
    ThreadLocal: bool;
    FileIndex: int64;
    Line: int64;

    init(const ASymbol: string; const AAdamName: string; const ATypeId: int64);
    begin
      self.Symbol := ASymbol;
      self.AdamName := AAdamName;
      self.TypeId := ATypeId;
      self.ThreadLocal := false;
      self.FileIndex := -1;
      self.Line := 0;
    end;
  end;

  // A module's debug information (see the header); Types[0] is the none type
  DebugModule = object
    Files: StringArray;
    Functions: ref List<ref DebugFunction>;
    Globals: ref List<ref DebugGlobal>;
    Types: ref List<ref DebugType>;

    init();
    begin
      setlength(self.Files, 0);
      self.Functions := ref List<ref DebugFunction>();
      self.Globals := ref List<ref DebugGlobal>();
      self.Types := ref List<ref DebugType>();
      self.Types.Add(ref DebugType(DebugTypeKind.Opaque, "", 0));
    end;
  end;

// The name of AKind as Text writes it
public routine DebugTypeKindText(const AKind: DebugTypeKind): string;
begin
  match AKind of
    DebugTypeKind.Signed: return "signed";
    DebugTypeKind.Unsigned: return "unsigned";
    DebugTypeKind.Float: return "float";
    DebugTypeKind.Boolean: return "bool";
    DebugTypeKind.Char: return "char";
    DebugTypeKind.WideChar: return "wchar";
    DebugTypeKind.Pointer: return "pointer";
    DebugTypeKind.StaticArray: return "array";
    DebugTypeKind.Record: return "record";
    DebugTypeKind.Overlay: return "overlay";
    DebugTypeKind.Object: return "object";
    DebugTypeKind.Choices: return "choices";
    DebugTypeKind.Routine: return "func";
    DebugTypeKind.Opaque: return "opaque";
  end;
  return "";
end;

// The type AId of AModule as Text writes it ("-" for none)
routine DoTypeRef(const AModule: ref DebugModule; const AId: int64): string;
begin
  if AId = 0 then
    return "-";
  end;
  return IntToStr(AId) + ":" + AModule.Types.Items[AId].TypeName;
end;

// AModule as text (see the header): AFileFilter "" every function and global, else only
// those declared in a file of that name (the name alone, no folder), and the types they
// reach listed in full
public routine DebugInfoText(const AModule: ref DebugModule; const AFileFilter: string): string;
var
  LText: ref TextBuilder;
  LFunction: ref DebugFunction;
  LGlobal: ref DebugGlobal;
  LType: ref DebugType;
  LLine: ref DebugLine;
  LVariable: ref DebugVariable;
  LField: ref DebugField;
  LUsed: ref Int64Map;
  LKeep: BoolArray;
  LBase: string;
  LI: int64;
  LJ: int64;
begin
  LText := ref TextBuilder();
  setlength(LKeep, len(AModule.Files));
  for LI := 0 to len(AModule.Files) - 1 do
    LKeep[LI] := (AFileFilter = "") or (ExtractFileName(AModule.Files[LI]) = AFileFilter);
  end;
  LUsed := ref Int64Map(0);
  for LI := 0 to AModule.Functions.Count - 1 do
    LFunction := AModule.Functions.Items[LI];
    if (LFunction.FileIndex < 0) or (not LKeep[LFunction.FileIndex]) then
      skip;
    end;
    // the stack pointer after the prologue when no register holds the frame
    LBase := LFunction.FrameBase;
    if LBase = "" then
      LBase := "sp";
    end;
    LText.Add("function " + LFunction.AdamName + " at " +
      ExtractFileName(AModule.Files[LFunction.FileIndex]) + "(" + IntToStr(LFunction.Line) +
      ") prologue " + BoolToStr(LFunction.PrologueEnd > 0) + " frame " + LBase + "\n");
    for LJ := 0 to LFunction.Variables.Count - 1 do
      LVariable := LFunction.Variables.Items[LJ];
      if LVariable.IsParam then
        LText.Add("  param ");
      else
        LText.Add("  local ");
      end;
      LText.Add(LVariable.VariableName + ": " + DoTypeRef(AModule, LVariable.TypeId) + " at +" +
        IntToStr(LVariable.Offset) + "\n");
      LUsed.Put(LVariable.TypeId, 1);
    end;
    for LJ := 0 to LFunction.Lines.Count - 1 do
      LLine := LFunction.Lines.Items[LJ];
      if LKeep[LLine.FileIndex] then
        LText.Add("  line " + IntToStr(LLine.Line) + "," + IntToStr(LLine.Column) + "\n");
      end;
    end;
    for LJ := 0 to LFunction.Marks.Count - 1 do
      LText.Add("  mark line " + IntToStr(LFunction.Marks.Items[LJ].Line) + "\n");
    end;
  end;
  for LI := 0 to AModule.Globals.Count - 1 do
    LGlobal := AModule.Globals.Items[LI];
    if (LGlobal.FileIndex < 0) or (not LKeep[LGlobal.FileIndex]) then
      skip;
    end;
    LText.Add("global " + LGlobal.AdamName + ": " + DoTypeRef(AModule, LGlobal.TypeId) + "\n");
    LUsed.Put(LGlobal.TypeId, 1);
  end;
  // the types the shown items reach, through targets and fields (indices only grow from
  // a type to what it reaches, but a pointer back may point lower: loop to a fixed point)
  for LI := AModule.Types.Count - 1 downto 1 do
    if LUsed.Find(LI) <> 0 then
      LType := AModule.Types.Items[LI];
      LUsed.Put(LType.Target, 1);
      for LJ := 0 to LType.Fields.Count - 1 do
        LUsed.Put(LType.Fields.Items[LJ].TypeId, 1);
      end;
    end;
  end;
  for LI := 1 to AModule.Types.Count - 1 do
    if LUsed.Find(LI) = 0 then
      skip;
    end;
    LType := AModule.Types.Items[LI];
    LText.Add("type " + IntToStr(LI) + " " + LType.TypeName + " " + DebugTypeKindText(LType.Kind) +
      " size " + IntToStr(LType.Size));
    if (LType.Kind = DebugTypeKind.Pointer) or (LType.Kind = DebugTypeKind.StaticArray) then
      LText.Add(" of " + DoTypeRef(AModule, LType.Target));
    end;
    if LType.Kind = DebugTypeKind.StaticArray then
      LText.Add(" count " + IntToStr(LType.Count));
    end;
    LText.Add("\n");
    for LJ := 0 to LType.Fields.Count - 1 do
      LField := LType.Fields.Items[LJ];
      LText.Add("  field " + LField.FieldName + ": " + DoTypeRef(AModule, LField.TypeId) + " at +" +
        IntToStr(LField.Offset));
      if LField.BitWidth > 0 then
        LText.Add(" bits " + IntToStr(LField.BitOffset) + ":" + IntToStr(LField.BitWidth));
      end;
      LText.Add("\n");
    end;
    for LJ := 0 to LType.Values.Count - 1 do
      LText.Add("  value " + LType.Values.Items[LJ].ValueName + " = " +
        IntToStr(LType.Values.Items[LJ].Number) + "\n");
    end;
  end;
  return LText.Text();
end;

end.
