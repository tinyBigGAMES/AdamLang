-------------------------------------------------------------------------------
  Adam.Compiler.Types.adam - the type rule, once (used by Semantics, later the
  backend and the language server)

  A type is a node id, its canonical node: a builtin type is its declaration
  in the system scope; a record, object, interface, overlay, choices or set
  type is its TypeDecl (types are nominal); an alias is the type it names
  (transparent); every other type (a pointer, an array, an owner, a routine
  type, nil) is a derived node under the derived types (ADAM_AST_DERIVED),
  made the first time it is asked for and the same node every time after.

  A derived node: Kind the kind of type, Text its key (equal keys, equal
  types), ResolvedType the type it is made over (a pointer's target, an
  array's or an owner's element, a routine type's return type), ResolvedDecl
  the type expression or routine it was first made from (a static array's
  bounds, a routine type's parameters are read there), flag ConstTarget on a
  ptr to const.

  CanonicalOf writes the canonical type of a type expression into its
  ResolvedType (once). ConvertsImplicitly is BNF sec 6's "no hidden
  conversions" rule over two types; a constant that fits is Semantics' (it
  knows the expression). CommonArithmetic is the usual arithmetic
  conversions (BNF sec 6, PLAN-ARITH).
*******************************************************************************/

module unit Adam.Compiler.Types;

import System.SysUtils, Adam.Compiler.SourceText, Adam.Compiler.AST, Adam.Compiler.Scopes;

public const
  // How deep alias chains, parent chains and nested type expressions are followed (a
  // cycle stops there: its type is unknown)
  ADAM_TYPES_MAX_DEPTH: int64 = 64;

public type
  // What a type is, by its canonical node
  TypeClass = choices(
    Unknown, SignedInt, UnsignedInt, Float, Boolean, Char, WideChar, Text, WideText,
    UntypedPointer, Varargs, Pointer, StaticArray, DynamicArray, RecordType, ObjectType,
    InterfaceType, OverlayType, ChoicesType, SetType, RoutineType, OwnType, RefType,
    WeakType, NilType);

  // How print / println writes a value of a type (PrintFormOf)
  PrintForm = choices(
    Unknown, Unprintable, Integer, Boolean, Char, Float, Text, WideText, WideChar, CText,
    WideCText, Address, Choice, Range);

// The class of the builtin type named AName
routine DoBuiltinClass(const AName: string): TypeClass;
begin
  if (AName = "int8") or (AName = "int16") or (AName = "int32") or (AName = "int64") then
    return TypeClass.SignedInt;
  end;
  if (AName = "uint8") or (AName = "uint16") or (AName = "uint32") or (AName = "uint64") then
    return TypeClass.UnsignedInt;
  end;
  if (AName = "float32") or (AName = "float64") then
    return TypeClass.Float;
  end;
  if AName = "bool" then
    return TypeClass.Boolean;
  end;
  if AName = "char" then
    return TypeClass.Char;
  end;
  if AName = "wchar" then
    return TypeClass.WideChar;
  end;
  if AName = "string" then
    return TypeClass.Text;
  end;
  if AName = "wstring" then
    return TypeClass.WideText;
  end;
  if AName = "ptr" then
    return TypeClass.UntypedPointer;
  end;
  if AName = "varargs" then
    return TypeClass.Varargs;
  end;
  return TypeClass.Unknown;
end;

// The class of the body of a declared type (its TypeOf child's kind)
routine DoBodyClass(const AKind: NodeKind): TypeClass;
begin
  match AKind of
    NodeKind.RecordType: return TypeClass.RecordType;
    NodeKind.ObjectType: return TypeClass.ObjectType;
    NodeKind.InterfaceType: return TypeClass.InterfaceType;
    NodeKind.OverlayType: return TypeClass.OverlayType;
    NodeKind.ChoicesType: return TypeClass.ChoicesType;
    NodeKind.SetType: return TypeClass.SetType;
  else
    // any other body is an alias: never a canonical node
  end;
  return TypeClass.Unknown;
end;

// The class of the canonical type AType (Unknown for 0 and for a node that is no type)
public routine ClassOf(const ATree: ref SyntaxTree; const AType: int64): TypeClass;
var
  LKind: NodeKind;
  LBody: int64;
begin
  if AType = 0 then
    return TypeClass.Unknown;
  end;
  LKind := ATree[AType].Kind;
  if LKind = NodeKind.BuiltinTypeDecl then
    return DoBuiltinClass(ATree[AType].Text);
  end;
  if LKind = NodeKind.TypeDecl then
    LBody := ATree.FirstOf(AType, NodeRole.TypeOf);
    if LBody = 0 then
      return TypeClass.Unknown;
    end;
    return DoBodyClass(ATree[LBody].Kind);
  end;
  if ATree.ParentOf(AType) <> ADAM_AST_DERIVED then
    return TypeClass.Unknown;
  end;
  if LKind = NodeKind.ArrayType then
    if StartsStr("dyn:", ATree[AType].Text) then
      return TypeClass.DynamicArray;
    end;
    return TypeClass.StaticArray;
  end;
  match LKind of
    NodeKind.PointerType: return TypeClass.Pointer;
    NodeKind.RoutineType: return TypeClass.RoutineType;
    NodeKind.OwnType: return TypeClass.OwnType;
    NodeKind.RefType: return TypeClass.RefType;
    NodeKind.WeakType: return TypeClass.WeakType;
    NodeKind.NilLiteral: return TypeClass.NilType;
  else
    // no other kind is made under the derived types
  end;
  return TypeClass.Unknown;
end;

// True for both integer classes
public routine IsIntegerClass(const AClass: TypeClass): bool;
begin
  return (AClass = TypeClass.SignedInt) or (AClass = TypeClass.UnsignedInt);
end;

// True for the integer classes and Float (the arithmetic operands)
public routine IsNumericClass(const AClass: TypeClass): bool;
begin
  return IsIntegerClass(AClass) or (AClass = TypeClass.Float);
end;

// True for the classes a pointer value has (typed, untyped, nil)
public routine IsPointerClass(const AClass: TypeClass): bool;
begin
  return (AClass = TypeClass.Pointer) or (AClass = TypeClass.UntypedPointer) or
    (AClass = TypeClass.NilType);
end;

// True when a value of AType travels as itself where C++ linkage passes a const parameter
// (BNF sec 3, PaskalCPP's TPCTypeExpr.IsScalarOrPointer): every builtin but string and
// wstring, a pointer, a routine value, a choices value; anything else binds by const
// reference. An unknown type is no scalar
public routine IsScalarOrPointer(const ATree: ref SyntaxTree; const AType: int64): bool;
var
  LClass: TypeClass;
begin
  LClass := ClassOf(ATree, AType);
  if (LClass = TypeClass.SignedInt) or (LClass = TypeClass.UnsignedInt) or (LClass = TypeClass.Float) or
    (LClass = TypeClass.Boolean) or (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) or
    (LClass = TypeClass.Varargs) then
    return true;
  end;
  return IsPointerClass(LClass) or (LClass = TypeClass.RoutineType) or (LClass = TypeClass.ChoicesType);
end;

// The width in bits of an integer builtin AType; 0 for any other type
public routine IntBits(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LName: string;
begin
  if not IsIntegerClass(ClassOf(ATree, AType)) then
    return 0;
  end;
  LName := ATree[AType].Text;
  if (LName = "int8") or (LName = "uint8") then
    return 8;
  end;
  if (LName = "int16") or (LName = "uint16") then
    return 16;
  end;
  if (LName = "int32") or (LName = "uint32") then
    return 32;
  end;
  return 64;
end;

// The width in bits of a float builtin AType; 0 for any other type
public routine FloatBits(const ATree: ref SyntaxTree; const AType: int64): int64;
begin
  if ClassOf(ATree, AType) <> TypeClass.Float then
    return 0;
  end;
  if ATree[AType].Text = "float32" then
    return 32;
  end;
  return 64;
end;

// The builtin type named AName (its system declaration); 0 when there is none
public routine BuiltinType(const ATree: ref SyntaxTree; const AName: string): int64;
var
  LFound: int64;
begin
  LFound := FindSystem(ATree, AName);
  if (LFound <> 0) and (ATree[LFound].Kind = NodeKind.BuiltinTypeDecl) then
    return LFound;
  end;
  return 0;
end;

// The type a derived AType is made over (a pointer's target, an array's or an owner's
// element, a routine type's return type); 0 for any other type
public routine TargetOf(const ATree: ref SyntaxTree; const AType: int64): int64;
begin
  if AType = 0 then
    return 0;
  end;
  if ATree.ParentOf(AType) <> ADAM_AST_DERIVED then
    return 0;
  end;
  return ATree[AType].ResolvedType;
end;

// True when AType is a ptr to const
public routine IsConstTarget(const ATree: ref SyntaxTree; const AType: int64): bool;
begin
  if AType = 0 then
    return false;
  end;
  return ATree[AType].HasFlag(NodeFlag.ConstTarget);
end;

// The body of the declared type AType (its RecordType, ObjectType, ... node); 0 for any
// type that is no TypeDecl
public routine BodyOf(const ATree: ref SyntaxTree; const AType: int64): int64;
begin
  if (AType = 0) or (ATree[AType].Kind <> NodeKind.TypeDecl) then
    return 0;
  end;
  return ATree.FirstOf(AType, NodeRole.TypeOf);
end;

// The derived type with key AKey, made under the derived types the first time it is
// asked for: AKind its kind, AOver the type it is made over, ASource the node it is
// first made from, AConst a ptr to const
routine DoIntern(const ATree: ref SyntaxTree; const AKind: NodeKind; const AKey: string;
  const AOver: int64; const ASource: int64; const AConst: bool): int64;
var
  LI: int64;
  LChild: int64;
  LId: int64;
begin
  for LI := 0 to ATree.ChildCount(ADAM_AST_DERIVED) - 1 do
    LChild := ATree.ChildAt(ADAM_AST_DERIVED, LI);
    if ATree[LChild].Text = AKey then
      return LChild;
    end;
  end;
  LId := ATree.AddChild(ADAM_AST_DERIVED, NodeRole.DerivedType, AKind, NoPlace(), 0, 0);
  ATree[LId].Text := AKey;
  ATree[LId].ResolvedType := AOver;
  ATree[LId].ResolvedDecl := ASource;
  if AConst then
    ATree[LId].AddFlag(NodeFlag.ConstTarget);
  end;
  return LId;
end;

// The type of nil (it converts to every pointer, owner, routine and interface type)
public routine NilTypeOf(const ATree: ref SyntaxTree): int64;
begin
  return DoIntern(ATree, NodeKind.NilLiteral, "nil", 0, 0, false);
end;

// ptr to ATarget (ptr to const ATarget when AConst); ASource the node asking for it
public routine PointerTo(const ATree: ref SyntaxTree; const ATarget: int64; const AConst: bool;
  const ASource: int64): int64;
var
  LKey: string;
begin
  if AConst then
    LKey := "ptrc:" + IntToStr(ATarget);
  else
    LKey := "ptr:" + IntToStr(ATarget);
  end;
  return DoIntern(ATree, NodeKind.PointerType, LKey, ATarget, ASource, AConst);
end;

// array of AElement (a dynamic array); ASource the node asking for it
public routine DynamicArrayOf(const ATree: ref SyntaxTree; const AElement: int64;
  const ASource: int64): int64;
begin
  return DoIntern(ATree, NodeKind.ArrayType, "dyn:" + IntToStr(AElement), AElement, ASource, false);
end;

// own / ref / weak AElement (AKind OwnType, RefType or WeakType); ASource the node
// asking for it
public routine OwnerOf(const ATree: ref SyntaxTree; const AKind: NodeKind; const AElement: int64;
  const ASource: int64): int64;
var
  LKey: string;
begin
  if AKind = NodeKind.OwnType then
    LKey := "own:";
  else
    if AKind = NodeKind.RefType then
      LKey := "ref:";
    else
      LKey := "weak:";
    end;
  end;
  return DoIntern(ATree, AKind, LKey + IntToStr(AElement), AElement, ASource, false);
end;

// The integer constant AExpr spells, read without folding (M1.10 folds the rest into
// ResolvedConst, read first): a literal, a signed or parenthesized one, a const's
// initializer. Its sign into ANegative, its magnitude into AMagnitude; false when it is
// no such constant
routine DoConstInt(const ATree: ref SyntaxTree; const AExpr: int64; const ADepth: int64;
  var ANegative: bool; var AMagnitude: uint64): bool;
var
  LNode: ref Node;
  LSigned: int64;
  LDecl: int64;
begin
  if (AExpr = 0) or (ADepth > ADAM_TYPES_MAX_DEPTH) then
    return false;
  end;
  LNode := ATree[AExpr];
  if LNode.ResolvedConst.Kind = ConstKind.Signed then
    LSigned := int64(LNode.ResolvedConst.Bits);
    ANegative := LSigned < 0;
    if ANegative then
      // -(v + 1) + 1: the magnitude of the lowest int64 too
      AMagnitude := uint64(-(LSigned + 1)) + 1;
    else
      AMagnitude := uint64(LSigned);
    end;
    return true;
  end;
  if LNode.ResolvedConst.Kind = ConstKind.Unsigned then
    ANegative := false;
    AMagnitude := LNode.ResolvedConst.Bits;
    return true;
  end;
  if LNode.Kind = NodeKind.IntLiteral then
    ANegative := false;
    AMagnitude := LNode.IntValue;
    return true;
  end;
  if LNode.Kind = NodeKind.ParenExpression then
    return DoConstInt(ATree, ATree.FirstOf(AExpr, NodeRole.Operand), ADepth + 1, ANegative,
      AMagnitude);
  end;
  if (LNode.Kind = NodeKind.UnaryExpression) and
    ((LNode.Op = OperatorKind.Plus) or (LNode.Op = OperatorKind.Negate)) then
    if not DoConstInt(ATree, ATree.FirstOf(AExpr, NodeRole.Operand), ADepth + 1, ANegative,
      AMagnitude) then
      return false;
    end;
    if (LNode.Op = OperatorKind.Negate) and (AMagnitude <> 0) then
      ANegative := not ANegative;
    end;
    return true;
  end;
  if LNode.Kind = NodeKind.NameExpression then
    LDecl := LNode.ResolvedDecl;
    if (LDecl <> 0) and (ATree[LDecl].Kind = NodeKind.ConstDecl) then
      return DoConstInt(ATree, ATree.FirstOf(LDecl, NodeRole.Initializer), ADepth + 1,
        ANegative, AMagnitude);
    end;
  end;
  return false;
end;

// The integer constant AExpr spells (see DoConstInt)
public routine ConstIntOf(const ATree: ref SyntaxTree; const AExpr: int64; var ANegative: bool;
  var AMagnitude: uint64): bool;
begin
  ANegative := false;
  AMagnitude := 0;
  return DoConstInt(ATree, AExpr, 0, ANegative, AMagnitude);
end;

// The text of an integer constant's sign and magnitude
public routine ConstIntText(const ANegative: bool; const AMagnitude: uint64): string;
begin
  if ANegative then
    return "-" + UIntToStr(AMagnitude);
  end;
  return UIntToStr(AMagnitude);
end;

// The largest magnitude a value of the integer type AType may have: for a negative value
// when ANegative (0 for an unsigned type)
public routine IntLimit(const ATree: ref SyntaxTree; const AType: int64; const ANegative: bool): uint64;
var
  LBits: int64;
  LSigned: bool;
  LHalf: uint64;
begin
  LBits := IntBits(ATree, AType);
  if LBits = 0 then
    return 0;
  end;
  LSigned := ClassOf(ATree, AType) = TypeClass.SignedInt;
  LHalf := uint64(1) shl uint64(LBits - 1);
  if LSigned then
    if ANegative then
      return LHalf;
    end;
    return LHalf - 1;
  end;
  if ANegative then
    return 0;
  end;
  // 2^bits - 1 written as half - 1 + half, so 64 bits does not overflow
  return (LHalf - 1) + LHalf;
end;

// True when the integer constant (ANegative, AMagnitude) is a value of the integer type
// AType
public routine IntFits(const ATree: ref SyntaxTree; const AType: int64; const ANegative: bool;
  const AMagnitude: uint64): bool;
begin
  if IntBits(ATree, AType) = 0 then
    return false;
  end;
  if AMagnitude = 0 then
    return true;
  end;
  return AMagnitude <= IntLimit(ATree, AType, ANegative);
end;

// The type a ForwardType AForward declares: its TypeDecl of the same name in the same
// scope; 0 when the scope holds none
routine DoForwardTarget(const ATree: ref SyntaxTree; const AForward: int64): int64;
var
  LScope: int64;
  LI: int64;
  LChild: int64;
begin
  LScope := ATree.ParentOf(AForward);
  if LScope = 0 then
    return 0;
  end;
  for LI := 0 to ATree.ChildCount(LScope) - 1 do
    LChild := ATree.ChildAt(LScope, LI);
    if (ATree[LChild].Kind = NodeKind.TypeDecl) and (ATree[LChild].Text = ATree[AForward].Text) then
      return LChild;
    end;
  end;
  return 0;
end;

forward routine DoCanonical(const ATree: ref SyntaxTree; const AExpr: int64; const ADepth: int64): int64;

// The canonical type the declaration ADecl declares (a builtin, a TypeDecl, a forward
// type); 0 for any other declaration or a broken alias
routine DoDeclared(const ATree: ref SyntaxTree; const ADecl: int64; const ADepth: int64): int64;
var
  LKind: NodeKind;
  LBody: int64;
begin
  if (ADecl = 0) or (ADepth > ADAM_TYPES_MAX_DEPTH) then
    return 0;
  end;
  LKind := ATree[ADecl].Kind;
  if LKind = NodeKind.BuiltinTypeDecl then
    return ADecl;
  end;
  if LKind = NodeKind.ForwardType then
    return DoDeclared(ATree, DoForwardTarget(ATree, ADecl), ADepth + 1);
  end;
  if LKind <> NodeKind.TypeDecl then
    return 0;
  end;
  LBody := ATree.FirstOf(ADecl, NodeRole.TypeOf);
  if LBody = 0 then
    return 0;
  end;
  if DoBodyClass(ATree[LBody].Kind) <> TypeClass.Unknown then
    return ADecl;
  end;
  return DoCanonical(ATree, LBody, ADepth + 1);
end;

// The canonical type the declaration ADecl declares (see DoDeclared)
public routine DeclaredTypeOf(const ATree: ref SyntaxTree; const ADecl: int64): int64;
begin
  return DoDeclared(ATree, ADecl, 0);
end;

// True when the scope of the routine (or forward) AId declares more than one routine of
// its name: the overloads, which have C++ linkage whatever is written (BNF sec 4; forwards
// out, recovered ones out). The one rule: Symbols links by it, a routine type keys by it
public routine IsOverloadedRoutine(const ATree: ref SyntaxTree; const AId: int64): bool;
var
  LScope: int64;
  LI: int64;
  LChild: int64;
  LCount: int64;
begin
  LScope := ATree.ParentOf(AId);
  LCount := 0;
  for LI := 0 to ATree.ChildCount(LScope) - 1 do
    LChild := ATree.ChildAt(LScope, LI);
    if (ATree[LChild].Kind = NodeKind.RoutineDecl) and
      (not ATree[LChild].HasFlag(NodeFlag.Recovered)) and
      (ATree[LChild].Text = ATree[AId].Text) then
      LCount := LCount + 1;
      if LCount > 1 then
        return true;
      end;
    end;
  end;
  return false;
end;

// True when the signature ASig has C++ linkage: `cpplink` written, or a routine / forward
// declaration that is overloaded (IsOverloadedRoutine); anything else has C linkage
// (`clink` written or no word: one linkage, BNF sec 4). The one rule for a signature's
// linkage before Symbols names it: the type key, its text and its mangling read it
public routine IsCppSignature(const ATree: ref SyntaxTree; const ASig: int64): bool;
var
  LKind: NodeKind;
begin
  if ATree[ASig].HasFlag(NodeFlag.Cpplink) then
    return true;
  end;
  LKind := ATree[ASig].Kind;
  if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) then
    return IsOverloadedRoutine(ATree, ASig);
  end;
  return false;
end;

// The key of a routine signature ASig (a routine, method or forward declaration or a
// routine type): linkage (x for C++, by the linkage the signature has: IsCppSignature),
// each parameter's mode and type, variadic, the return type
routine DoRoutineKey(const ATree: ref SyntaxTree; const ASig: int64; const ADepth: int64;
  var AReturn: int64): string;
var
  LKey: string;
  LI: int64;
  LParam: int64;
  LReturn: int64;
begin
  LKey := "rt";
  if IsCppSignature(ATree, ASig) then
    LKey := LKey + "x";
  end;
  LKey := LKey + "(";
  for LI := 0 to ATree.CountOf(ASig, NodeRole.Param) - 1 do
    LParam := ATree.NthOf(ASig, NodeRole.Param, LI);
    if LI > 0 then
      LKey := LKey + ",";
    end;
    if ATree[LParam].HasFlag(NodeFlag.VarParam) then
      LKey := LKey + "v";
    else
      if ATree[LParam].HasFlag(NodeFlag.ConstParam) then
        LKey := LKey + "c";
      end;
    end;
    LKey := LKey + IntToStr(DoCanonical(ATree, ATree.FirstOf(LParam, NodeRole.TypeOf), ADepth + 1));
  end;
  if ATree[ASig].HasFlag(NodeFlag.Variadic) then
    LKey := LKey + ",...";
  end;
  LReturn := ATree.FirstOf(ASig, NodeRole.ReturnType);
  AReturn := 0;
  if LReturn <> 0 then
    AReturn := DoCanonical(ATree, LReturn, ADepth + 1);
  end;
  return LKey + "):" + IntToStr(AReturn);
end;

// The routine type of the signature ASig (equal signatures, one type)
routine DoRoutineType(const ATree: ref SyntaxTree; const ASig: int64; const ADepth: int64): int64;
var
  LKey: string;
  LReturn: int64;
begin
  LReturn := 0;
  LKey := DoRoutineKey(ATree, ASig, ADepth, LReturn);
  return DoIntern(ATree, NodeKind.RoutineType, LKey, LReturn, ASig, false);
end;

// The routine type of the signature ASig (a routine, method or forward declaration or a
// routine type expression)
public routine RoutineTypeOf(const ATree: ref SyntaxTree; const ASig: int64): int64;
begin
  if ASig = 0 then
    return 0;
  end;
  return DoRoutineType(ATree, ASig, 0);
end;

// The static array of AElement the ArrayType expression ASource writes: its bounds' values
// in the key when both are integer constants, else the expression itself names it
routine DoStaticArray(const ATree: ref SyntaxTree; const ASource: int64; const AElement: int64): int64;
var
  LLowNeg: bool;
  LLowMag: uint64;
  LHighNeg: bool;
  LHighMag: uint64;
  LKey: string;
begin
  LLowNeg := false;
  LLowMag := 0;
  LHighNeg := false;
  LHighMag := 0;
  if ConstIntOf(ATree, ATree.FirstOf(ASource, NodeRole.LowBound), LLowNeg, LLowMag) and
    ConstIntOf(ATree, ATree.FirstOf(ASource, NodeRole.HighBound), LHighNeg, LHighMag) then
    LKey := "arr[" + ConstIntText(LLowNeg, LLowMag) + ".." + ConstIntText(LHighNeg, LHighMag) + "]:";
  else
    LKey := "arr#" + IntToStr(ASource) + ":";
  end;
  return DoIntern(ATree, NodeKind.ArrayType, LKey + IntToStr(AElement), AElement, ASource, false);
end;

// The canonical type of the type expression AExpr, written into its ResolvedType once;
// 0 when it names no type (an unresolved name, an error, a cycle)
routine DoCanonical(const ATree: ref SyntaxTree; const AExpr: int64; const ADepth: int64): int64;
var
  LKind: NodeKind;
  LType: int64;
  LElement: int64;
begin
  if (AExpr = 0) or (ADepth > ADAM_TYPES_MAX_DEPTH) then
    return 0;
  end;
  if ATree[AExpr].ResolvedType <> 0 then
    return ATree[AExpr].ResolvedType;
  end;
  LKind := ATree[AExpr].Kind;
  LType := 0;
  if LKind = NodeKind.BuiltinTypeName then
    LType := BuiltinType(ATree, ATree[AExpr].Text);
  end;
  if LKind = NodeKind.NamedType then
    LType := DoDeclared(ATree, ATree[AExpr].ResolvedDecl, ADepth + 1);
  end;
  if LKind = NodeKind.RoutineType then
    LType := DoRoutineType(ATree, AExpr, ADepth + 1);
  end;
  if (LKind = NodeKind.PointerType) or (LKind = NodeKind.ArrayType) or
    (LKind = NodeKind.OwnType) or (LKind = NodeKind.RefType) or (LKind = NodeKind.WeakType) then
    LElement := DoCanonical(ATree, ATree.FirstOf(AExpr, NodeRole.Element), ADepth + 1);
    if LElement <> 0 then
      if LKind = NodeKind.PointerType then
        LType := PointerTo(ATree, LElement, ATree[AExpr].HasFlag(NodeFlag.ConstTarget), AExpr);
      else
        if LKind = NodeKind.ArrayType then
          if ATree.FirstOf(AExpr, NodeRole.LowBound) = 0 then
            LType := DynamicArrayOf(ATree, LElement, AExpr);
          else
            LType := DoStaticArray(ATree, AExpr, LElement);
          end;
        else
          LType := OwnerOf(ATree, LKind, LElement, AExpr);
        end;
      end;
    end;
  end;
  if LType <> 0 then
    ATree[AExpr].ResolvedType := LType;
  end;
  return LType;
end;

// The canonical type of the type expression AExpr (see DoCanonical)
public routine CanonicalOf(const ATree: ref SyntaxTree; const AExpr: int64): int64;
begin
  return DoCanonical(ATree, AExpr, 0);
end;

// True when the parameter AParam binds by reference under ALinkage (BNF sec 3, the one
// rule, PaskalCPP's TPCParam.IsPassedByReference): var always; no mode never; const under
// C linkage never (the C ABI), under C++ linkage when its type is no scalar or pointer
public routine PassedByReference(const ATree: ref SyntaxTree; const AParam: int64;
  const ALinkage: Linkage): bool;
var
  LTypeExpr: int64;
begin
  if ATree[AParam].HasFlag(NodeFlag.VarParam) then
    return true;
  end;
  if (not ATree[AParam].HasFlag(NodeFlag.ConstParam)) or (ALinkage <> Linkage.Cpp) then
    return false;
  end;
  LTypeExpr := ATree.FirstOf(AParam, NodeRole.TypeOf);
  if LTypeExpr = 0 then
    return false;
  end;
  return not IsScalarOrPointer(ATree, CanonicalOf(ATree, LTypeExpr));
end;

// The parent type of the record or object AType (its Parent child, canonical); 0 when it
// has none
public routine ParentTypeOf(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LBody: int64;
  LParent: int64;
begin
  LBody := BodyOf(ATree, AType);
  if LBody = 0 then
    return 0;
  end;
  LParent := ATree.FirstOf(LBody, NodeRole.Parent);
  if LParent = 0 then
    return 0;
  end;
  return CanonicalOf(ATree, LParent);
end;

// True when ABase is a parent of AType, any number of levels up (a type is not its own)
public routine IsBaseOf(const ATree: ref SyntaxTree; const ABase: int64; const AType: int64): bool;
var
  LAt: int64;
  LDepth: int64;
begin
  if (ABase = 0) or (AType = 0) then
    return false;
  end;
  LAt := ParentTypeOf(ATree, AType);
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    if LAt = ABase then
      return true;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return false;
end;

// The member AName of the aggregate AAggregate: its own members, then the members of its
// anonymous records and overlays (they belong to it); 0 when none
routine DoMemberIn(const ATree: ref SyntaxTree; const AAggregate: int64; const AName: string;
  const ADepth: int64): int64;
var
  LI: int64;
  LChild: int64;
  LFound: int64;
begin
  if ADepth > ADAM_TYPES_MAX_DEPTH then
    return 0;
  end;
  for LI := 0 to ATree.CountOf(AAggregate, NodeRole.Member) - 1 do
    LChild := ATree.NthOf(AAggregate, NodeRole.Member, LI);
    if ATree[LChild].Text = AName then
      return LChild;
    end;
    if (ATree[LChild].Kind = NodeKind.AnonRecord) or (ATree[LChild].Kind = NodeKind.AnonOverlay) then
      LFound := DoMemberIn(ATree, LChild, AName, ADepth + 1);
      if LFound <> 0 then
        return LFound;
      end;
    end;
  end;
  return 0;
end;

// The member AName of the declared type AType (a field, method, property, embed, choice
// value, operator), its parents searched after it; 0 when none holds it
public routine MemberOf(const ATree: ref SyntaxTree; const AType: int64; const AName: string): int64;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LFound: int64;
begin
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return 0;
    end;
    LFound := DoMemberIn(ATree, LBody, AName, 0);
    if LFound <> 0 then
      return LFound;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return 0;
end;

// The default property of the declared type AType (BNF sec 4: `default`, reached by
// X[i]): the first indexed property flagged DefaultProperty among its own members, then
// its parents', nearest level first; 0 when none (a plain property is never a default)
public routine DefaultPropertyOf(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LChild: int64;
begin
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return 0;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Member) - 1 do
      LChild := ATree.NthOf(LBody, NodeRole.Member, LI);
      if (ATree[LChild].Kind = NodeKind.PropertyDecl) and
        ATree[LChild].HasFlag(NodeFlag.DefaultProperty) and
        (ATree.FirstOf(LChild, NodeRole.Param) <> 0) then
        return LChild;
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return 0;
end;

// True when the object type AType is final (no type may extend it)
public routine IsFinalType(const ATree: ref SyntaxTree; const AType: int64): bool;
var
  LBody: int64;
begin
  LBody := BodyOf(ATree, AType);
  return (LBody <> 0) and ATree[LBody].HasFlag(NodeFlag.Final);
end;

// True when AType is polymorphic (BNF sec 6, is / as): an interface, or an object with a
// virtual or override method or property, or one that implements an interface, its own
// or a parent's
public routine IsPolymorphic(const ATree: ref SyntaxTree; const AType: int64): bool;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LChild: int64;
begin
  if ClassOf(ATree, AType) = TypeClass.InterfaceType then
    return true;
  end;
  if ClassOf(ATree, AType) <> TypeClass.ObjectType then
    return false;
  end;
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return false;
    end;
    if ATree.CountOf(LBody, NodeRole.Implements) > 0 then
      return true;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Member) - 1 do
      LChild := ATree.NthOf(LBody, NodeRole.Member, LI);
      if ((ATree[LChild].Kind = NodeKind.MethodDecl) or (ATree[LChild].Kind = NodeKind.PropertyDecl)) and
        (ATree[LChild].HasFlag(NodeFlag.Virtual) or ATree[LChild].HasFlag(NodeFlag.Override)) then
        return true;
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return false;
end;

// True when the object type AType, or a level above it, names the interface AInterface
// (or an interface descended from it) after implements
public routine Implements(const ATree: ref SyntaxTree; const AType: int64;
  const AInterface: int64): bool;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LNamed: int64;
begin
  if (AType = 0) or (AInterface = 0) then
    return false;
  end;
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return false;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Implements) - 1 do
      LNamed := CanonicalOf(ATree, ATree.NthOf(LBody, NodeRole.Implements, LI));
      if (LNamed = AInterface) or IsBaseOf(ATree, AInterface, LNamed) then
        return true;
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return false;
end;

// True when AAncestor is a level above AType: a parent (any number of levels up) or an
// interface AType implements. A type is not its own ancestor
public routine IsAncestorOf(const ATree: ref SyntaxTree; const AAncestor: int64;
  const AType: int64): bool;
begin
  if IsBaseOf(ATree, AAncestor, AType) then
    return true;
  end;
  return (ClassOf(ATree, AAncestor) = TypeClass.InterfaceType) and
    (ClassOf(ATree, AType) = TypeClass.ObjectType) and Implements(ATree, AType, AAncestor);
end;

// True when a reference to a value of AFrom (a var or const parameter, a pointer's
// target) may stand for one of AReach: the same type, or AReach an ancestor of it (a
// record's base, an object's parent, an interface it implements)
public routine ReachesAs(const ATree: ref SyntaxTree; const AFrom: int64;
  const AReach: int64): bool;
begin
  if (AFrom = 0) or (AReach = 0) or (AFrom = AReach) then
    return true;
  end;
  return IsAncestorOf(ATree, AReach, AFrom);
end;

// The member AName an object or record AType reaches through an embed (BNF sec 4: an
// embed's members are reached as the object's own), at any level of AType: the member in
// AMember, the embed holding it in AEmbed; ASecond the embed of a second level-equal
// holder (0 when the name is reached through one embed only). False when no embed holds
// AName. A member AType declares itself, or a parent does, is MemberOf's and wins
public routine EmbedMemberOf(const ATree: ref SyntaxTree; const AType: int64;
  const AName: string; var AMember: int64; var AEmbed: int64; var ASecond: int64): bool;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LChild: int64;
  LFound: int64;
begin
  AMember := 0;
  AEmbed := 0;
  ASecond := 0;
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return AMember <> 0;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Member) - 1 do
      LChild := ATree.NthOf(LBody, NodeRole.Member, LI);
      if ATree[LChild].Kind = NodeKind.EmbedDecl then
        LFound := MemberOf(ATree, CanonicalOf(ATree, ATree.FirstOf(LChild, NodeRole.TypeOf)), AName);
        if LFound <> 0 then
          if AMember = 0 then
            AMember := LFound;
            AEmbed := LChild;
          else
            if ASecond = 0 then
              ASecond := LChild;
            end;
          end;
        end;
      end;
    end;
    // The nearest level that reaches the name decides it
    if AMember <> 0 then
      return true;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return AMember <> 0;
end;

// True when the property AProperty has an abstract read or write accessor
public routine HasAbstractAccessor(const ATree: ref SyntaxTree; const AProperty: int64): bool;
var
  LRead: int64;
  LWrite: int64;
begin
  LRead := ATree.FirstOf(AProperty, NodeRole.Read);
  LWrite := ATree.FirstOf(AProperty, NodeRole.Write);
  return ((LRead <> 0) and ATree[LRead].HasFlag(NodeFlag.Abstract)) or
    ((LWrite <> 0) and ATree[LWrite].HasFlag(NodeFlag.Abstract));
end;

// The first abstract method, or property with an abstract accessor, of the object type
// AType or a level above that no level at or below it declares again; 0 when it has none
// (it can be built)
public routine AbstractMemberOf(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LChild: int64;
begin
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return 0;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Member) - 1 do
      LChild := ATree.NthOf(LBody, NodeRole.Member, LI);
      // The nearest declaration of the name (MemberOf searches AType first) is this
      // abstract one: nothing below it gave a body
      if (ATree[LChild].Kind = NodeKind.MethodDecl) and ATree[LChild].HasFlag(NodeFlag.Abstract) and
        (MemberOf(ATree, AType, ATree[LChild].Text) = LChild) then
        return LChild;
      end;
      if (ATree[LChild].Kind = NodeKind.PropertyDecl) and
        (MemberOf(ATree, AType, ATree[LChild].Text) = LChild) and
        (HasAbstractAccessor(ATree, LChild)) then
        return LChild;
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return 0;
end;

// True when the declared type AType (or a parent of it) declares an operator spelled
// AText
public routine DeclaresOperator(const ATree: ref SyntaxTree; const AType: int64;
  const AText: string): bool;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LChild: int64;
begin
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return false;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Member) - 1 do
      LChild := ATree.NthOf(LBody, NodeRole.Member, LI);
      if (ATree[LChild].Kind = NodeKind.OperatorDecl) and (ATree[LChild].Text = AText) then
        return true;
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return false;
end;

// The element type of the set type ASet written as `set of T`; 0 for a range set (its
// bounds' type is the element type: Semantics types them) and for any other type
public routine SetElementOf(const ATree: ref SyntaxTree; const ASet: int64): int64;
var
  LBody: int64;
begin
  LBody := BodyOf(ATree, ASet);
  if (LBody = 0) or (ATree[LBody].Kind <> NodeKind.SetType) then
    return 0;
  end;
  return CanonicalOf(ATree, ATree.FirstOf(LBody, NodeRole.Element));
end;

// The integer types below int32 promote to int32 (C++'s integer promotion); any other
// type stays
public routine Promoted(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LBits: int64;
begin
  LBits := IntBits(ATree, AType);
  if (LBits > 0) and (LBits < 32) then
    return BuiltinType(ATree, "int32");
  end;
  return AType;
end;

// The type two arithmetic operands of types AFirst and ASecond meet at (the usual
// arithmetic conversions, BNF sec 6): a float when either is one (float64 when either is
// float64), else the promoted integers: the same type, the wider of one signedness, the
// unsigned one when it is at least as wide as the signed one, else the signed one
public routine CommonArithmetic(const ATree: ref SyntaxTree; const AFirst: int64;
  const ASecond: int64): int64;
var
  LA: int64;
  LB: int64;
  LBitsA: int64;
  LBitsB: int64;
  LClassA: TypeClass;
  LClassB: TypeClass;
begin
  if (FloatBits(ATree, AFirst) = 64) or (FloatBits(ATree, ASecond) = 64) then
    return BuiltinType(ATree, "float64");
  end;
  if (FloatBits(ATree, AFirst) = 32) or (FloatBits(ATree, ASecond) = 32) then
    return BuiltinType(ATree, "float32");
  end;
  LA := Promoted(ATree, AFirst);
  LB := Promoted(ATree, ASecond);
  if LA = LB then
    return LA;
  end;
  LBitsA := IntBits(ATree, LA);
  LBitsB := IntBits(ATree, LB);
  LClassA := ClassOf(ATree, LA);
  LClassB := ClassOf(ATree, LB);
  if LClassA = LClassB then
    if LBitsA >= LBitsB then
      return LA;
    end;
    return LB;
  end;
  // One signed, one unsigned
  if LClassA = TypeClass.UnsignedInt then
    if LBitsA >= LBitsB then
      return LA;
    end;
    return LB;
  end;
  if LBitsB >= LBitsA then
    return LB;
  end;
  return LA;
end;

// True when the owner AFrom (of class AFromClass) converts to the owner ATo (BNF sec 4,
// owner type): an own to an own, and to a ref, of its object or of a polymorphic ancestor
// (the owner frees it through that ancestor); a ref to a ref, and to a weak, of its object
// or of any ancestor. Nothing else: a weak reaches a ref only through lock(W)
routine DoOwnerConverts(const ATree: ref SyntaxTree; const AFrom: int64;
  const AFromClass: TypeClass; const ATo: int64; const AToClass: TypeClass): bool;
var
  LFromTarget: int64;
  LToTarget: int64;
begin
  LFromTarget := TargetOf(ATree, AFrom);
  LToTarget := TargetOf(ATree, ATo);
  if AFromClass = TypeClass.OwnType then
    if (AToClass <> TypeClass.OwnType) and (AToClass <> TypeClass.RefType) then
      return false;
    end;
    if LFromTarget = LToTarget then
      return true;
    end;
    return IsAncestorOf(ATree, LToTarget, LFromTarget) and IsPolymorphic(ATree, LToTarget);
  end;
  if AFromClass = TypeClass.RefType then
    if (AToClass <> TypeClass.RefType) and (AToClass <> TypeClass.WeakType) then
      return false;
    end;
    return ReachesAs(ATree, LFromTarget, LToTarget);
  end;
  return false;
end;

// True when a value of AFrom converts to ATo with no cast (BNF sec 6, no hidden
// conversions): integer widening (an unsigned to a wider signed), an integer to a float
// that holds every value (16 bits to float32, 32 to float64), float32 to float64, nil to
// a pointer, owner, routine or interface type, a ptr to T to a ptr to const T, to the
// untyped ptr (not from a ptr to const) and to a ptr to an ancestor of T (a base, a
// parent, an interface it implements), a record to its base, an object that is not
// polymorphic to its parent, an owner as DoOwnerConverts says. The same type, or an
// unknown one (0, already reported), converts
public routine ConvertsImplicitly(const ATree: ref SyntaxTree; const AFrom: int64;
  const ATo: int64): bool;
var
  LFrom: TypeClass;
  LTo: TypeClass;
  LFromTarget: int64;
  LToTarget: int64;
begin
  if (AFrom = ATo) or (AFrom = 0) or (ATo = 0) then
    return true;
  end;
  LFrom := ClassOf(ATree, AFrom);
  LTo := ClassOf(ATree, ATo);
  if IsIntegerClass(LFrom) and IsIntegerClass(LTo) then
    if LFrom = LTo then
      return IntBits(ATree, ATo) >= IntBits(ATree, AFrom);
    end;
    if (LFrom = TypeClass.UnsignedInt) and (LTo = TypeClass.SignedInt) then
      return IntBits(ATree, ATo) > IntBits(ATree, AFrom);
    end;
    return false;
  end;
  if IsIntegerClass(LFrom) and (LTo = TypeClass.Float) then
    if FloatBits(ATree, ATo) = 64 then
      return IntBits(ATree, AFrom) <= 32;
    end;
    return IntBits(ATree, AFrom) <= 16;
  end;
  if (LFrom = TypeClass.Float) and (LTo = TypeClass.Float) then
    return FloatBits(ATree, AFrom) <= FloatBits(ATree, ATo);
  end;
  if LFrom = TypeClass.NilType then
    return (LTo = TypeClass.Pointer) or (LTo = TypeClass.UntypedPointer) or
      (LTo = TypeClass.OwnType) or (LTo = TypeClass.RefType) or (LTo = TypeClass.WeakType) or
      (LTo = TypeClass.RoutineType) or (LTo = TypeClass.InterfaceType);
  end;
  if (LFrom = TypeClass.Pointer) and (LTo = TypeClass.UntypedPointer) then
    return not IsConstTarget(ATree, AFrom);
  end;
  if (LFrom = TypeClass.Pointer) and (LTo = TypeClass.Pointer) then
    if IsConstTarget(ATree, AFrom) and (not IsConstTarget(ATree, ATo)) then
      return false;
    end;
    LFromTarget := TargetOf(ATree, AFrom);
    LToTarget := TargetOf(ATree, ATo);
    return ReachesAs(ATree, LFromTarget, LToTarget);
  end;
  if (LFrom = TypeClass.RecordType) and (LTo = TypeClass.RecordType) then
    return IsBaseOf(ATree, ATo, AFrom);
  end;
  if (LFrom = TypeClass.ObjectType) and (LTo = TypeClass.ObjectType) then
    // A polymorphic object never reaches its parent by value (it would be cut down:
    // SM0428, which Semantics reports in place of SM0200)
    return IsBaseOf(ATree, ATo, AFrom) and (not IsPolymorphic(ATree, AFrom));
  end;
  return DoOwnerConverts(ATree, AFrom, LFrom, ATo, LTo);
end;

// The spelling of a bound or other small constant expression in a type's text: a
// literal, a name, a dotted name, a signed one; "..." for anything longer
routine DoBoundText(const ATree: ref SyntaxTree; const AExpr: int64): string;
var
  LKind: NodeKind;
begin
  if AExpr = 0 then
    return "...";
  end;
  LKind := ATree[AExpr].Kind;
  if (LKind = NodeKind.IntLiteral) or (LKind = NodeKind.CharLiteral) or
    (LKind = NodeKind.NameExpression) then
    return ATree[AExpr].Text;
  end;
  if LKind = NodeKind.MemberExpression then
    return DoBoundText(ATree, ATree.FirstOf(AExpr, NodeRole.Operand)) + "." + ATree[AExpr].Text;
  end;
  if LKind = NodeKind.UnaryExpression then
    return ATree[AExpr].Text + DoBoundText(ATree, ATree.FirstOf(AExpr, NodeRole.Operand));
  end;
  return "...";
end;

forward routine DoTypeText(const ATree: ref SyntaxTree; const AType: int64; const ADepth: int64): string;

// The text of the routine signature ASig: routine [clink|cpplink](params)[: return]; cpplink
// whenever it has C++ linkage (IsCppSignature: an overload too), clink only as written
routine DoRoutineText(const ATree: ref SyntaxTree; const ASig: int64; const ADepth: int64): string;
var
  LText: string;
  LI: int64;
  LParam: int64;
  LReturn: int64;
begin
  LText := "routine";
  if IsCppSignature(ATree, ASig) then
    LText := LText + " cpplink";
  else
    if ATree[ASig].HasFlag(NodeFlag.Clink) then
      LText := LText + " clink";
    end;
  end;
  LText := LText + "(";
  for LI := 0 to ATree.CountOf(ASig, NodeRole.Param) - 1 do
    LParam := ATree.NthOf(ASig, NodeRole.Param, LI);
    if LI > 0 then
      LText := LText + "; ";
    end;
    if ATree[LParam].HasFlag(NodeFlag.VarParam) then
      LText := LText + "var ";
    end;
    if ATree[LParam].HasFlag(NodeFlag.ConstParam) then
      LText := LText + "const ";
    end;
    LText := LText + DoTypeText(ATree, CanonicalOf(ATree, ATree.FirstOf(LParam, NodeRole.TypeOf)),
      ADepth + 1);
  end;
  if ATree[ASig].HasFlag(NodeFlag.Variadic) then
    if ATree.CountOf(ASig, NodeRole.Param) > 0 then
      LText := LText + "; ";
    end;
    LText := LText + "...";
  end;
  LText := LText + ")";
  LReturn := ATree.FirstOf(ASig, NodeRole.ReturnType);
  if LReturn <> 0 then
    LText := LText + ": " + DoTypeText(ATree, CanonicalOf(ATree, LReturn), ADepth + 1);
  end;
  return LText;
end;

// The text of AType as a message writes it (see TypeText)
routine DoTypeText(const ATree: ref SyntaxTree; const AType: int64; const ADepth: int64): string;
var
  LKind: NodeKind;
  LOver: string;
  LSource: int64;
begin
  if AType = 0 then
    return "?";
  end;
  if ADepth > ADAM_TYPES_MAX_DEPTH then
    return "...";
  end;
  LKind := ATree[AType].Kind;
  if (LKind = NodeKind.BuiltinTypeDecl) or (LKind = NodeKind.TypeDecl) then
    return ATree[AType].Text;
  end;
  if ATree.ParentOf(AType) <> ADAM_AST_DERIVED then
    return "?";
  end;
  LSource := ATree[AType].ResolvedDecl;
  if LKind = NodeKind.NilLiteral then
    return "nil";
  end;
  if LKind = NodeKind.RoutineType then
    return DoRoutineText(ATree, LSource, ADepth + 1);
  end;
  LOver := DoTypeText(ATree, ATree[AType].ResolvedType, ADepth + 1);
  if LKind = NodeKind.PointerType then
    if IsConstTarget(ATree, AType) then
      return "ptr to const " + LOver;
    end;
    return "ptr to " + LOver;
  end;
  if LKind = NodeKind.OwnType then
    return "own " + LOver;
  end;
  if LKind = NodeKind.RefType then
    return "ref " + LOver;
  end;
  if LKind = NodeKind.WeakType then
    return "weak " + LOver;
  end;
  if ClassOf(ATree, AType) = TypeClass.DynamicArray then
    return "array of " + LOver;
  end;
  return "array[" + DoBoundText(ATree, ATree.FirstOf(LSource, NodeRole.LowBound)) + ".." +
    DoBoundText(ATree, ATree.FirstOf(LSource, NodeRole.HighBound)) + "] of " + LOver;
end;

// The text of AType as a message writes it: a builtin's or a declared type's name, ptr to
// [const] T, array of T, array[lo..hi] of T, own / ref / weak T, routine(...): R, nil;
// "?" for an unknown type
public routine TypeText(const ATree: ref SyntaxTree; const AType: int64): string;
begin
  return DoTypeText(ATree, AType, 0);
end;

// How print / println writes a value of the canonical type AType (PaskalCPP's
// TPCTypeExpr.PrintForm, the one rule; SEM's SM0425 and SM0502, Lowering's forms): a
// pointer by its target (to char: its C string, CText; to wchar: its C string as UTF-8,
// WideCText; any other, and an untyped one, its address); a wchar (WideChar) and a wstring
// (WideText) as UTF-8; a routine value its address; a choices value its name; a set and a
// static or dynamic array element by element (Range, unprintable when its element is); a
// record, object, overlay or owner unprintable (print its fields); every other builtin as
// itself. An unknown type (0, an error already reported) is Unknown
public routine PrintFormOf(const ATree: ref SyntaxTree; const AType: int64): PrintForm;
var
  LClass: TypeClass;
  LTarget: TypeClass;
begin
  LClass := ClassOf(ATree, AType);
  match LClass of
    TypeClass.SignedInt, TypeClass.UnsignedInt: return PrintForm.Integer;
    TypeClass.Boolean: return PrintForm.Boolean;
    TypeClass.Char: return PrintForm.Char;
    TypeClass.Float: return PrintForm.Float;
    TypeClass.Text: return PrintForm.Text;
    TypeClass.WideText: return PrintForm.WideText;
    TypeClass.WideChar: return PrintForm.WideChar;
    TypeClass.UntypedPointer, TypeClass.NilType, TypeClass.RoutineType: return PrintForm.Address;
    TypeClass.ChoicesType: return PrintForm.Choice;
    TypeClass.RecordType, TypeClass.ObjectType, TypeClass.InterfaceType, TypeClass.OverlayType,
      TypeClass.OwnType, TypeClass.RefType, TypeClass.WeakType, TypeClass.Varargs:
      return PrintForm.Unprintable;
  else
    // the classes below look at what the type is made over
  end;
  if LClass = TypeClass.Pointer then
    LTarget := ClassOf(ATree, TargetOf(ATree, AType));
    if LTarget = TypeClass.Char then
      return PrintForm.CText;
    end;
    if LTarget = TypeClass.WideChar then
      return PrintForm.WideCText;
    end;
    return PrintForm.Address;
  end;
  if (LClass = TypeClass.StaticArray) or (LClass = TypeClass.DynamicArray) then
    if PrintFormOf(ATree, TargetOf(ATree, AType)) = PrintForm.Unprintable then
      return PrintForm.Unprintable;
    end;
    return PrintForm.Range;
  end;
  if LClass = TypeClass.SetType then
    return PrintForm.Range;
  end;
  return PrintForm.Unknown;
end;

end.
