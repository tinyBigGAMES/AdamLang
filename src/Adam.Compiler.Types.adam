-------------------------------------------------------------------------------
  Adam.Compiler.Types.adam - the type rule, once (used by Semantics, later the
  backend and the language server)

  A type is a node id, its canonical node: a builtin type is its declaration
  in the system scope; a record, object, interface, overlay, choices or set
  type is its TypeDecl (types are nominal); an alias is the type it names
  (transparent); every other type (a pointer, an array, an owner, a routine
  type, nil) is a derived node under the derived types (ADAM_AST_DERIVED),
  made the first time it is asked for and the same node every time after.

  A derived node: Kind the kind of type, Text its key (equal keys, equal
  types), ResolvedType the type it is made over (a pointer's target, an
  array's or an owner's element, a routine type's return type), flag
  ConstTarget on a ptr to const. A derived node owns every fact its key and
  its readers need, never a link into the module that first asked for it (an
  .acu copying it would import that module): a routine type owns its
  signature (Param children with their modes and canonical types, a
  ReturnType, the flags Variadic / Clink / Cpplink / TakesSelf) and a static
  array with integer constant bounds owns them (LowBound / HighBound, folded),
  ResolvedDecl the node itself, where the readers of a signature or of bounds
  read them; a static array whose bounds are no integer constants is its
  ArrayType expression's own type (its key names that expression): its
  ResolvedDecl is that expression. Every other derived node's ResolvedDecl is
  0.

  CanonicalOf writes the canonical type of a type expression into its
  ResolvedType (once). ConvertsImplicitly is BNF sec 6's "no hidden
  conversions" rule over two types; a constant that fits is Semantics' (it
  knows the expression). CommonArithmetic is the usual arithmetic
  conversions (BNF sec 6, PLAN-ARITH).
*******************************************************************************/

module unit Adam.Compiler.Types;

import System.SysUtils, Adam.Core.Containers, Adam.Compiler.SourceText, Adam.Compiler.AST,
  Adam.Compiler.Scopes;

public const
  // How deep alias chains, parent chains and nested type expressions are followed (a
  // cycle stops there: its type is unknown)
  ADAM_TYPES_MAX_DEPTH: int64 = 64;
  // How deep a message writes nested generic instances' type arguments (deeper ones are
  // <...>): an instance's text may double with each level (Pair<Pair<T, T>, Pair<T, T>>)
  ADAM_TYPES_INSTANCE_TEXT_DEPTH: int64 = 3;
  // What a generic's clink adapter's key adds to its instance's (InstanceKey, BNF sec 10)
  ADAM_TYPES_CLINK_KEY: string = ":clink";

const
  // A dynamic array's key starts so (ClassOf and InternCopies tell it from a static array's
  // by it; it is the key tag an .acu keeps: KeyTagOf)
  ADAM_TYPES_KEY_DYNAMIC: string = "dyn:";
  // A flexible array member's key starts so (array[0..] of T, M9e0b; an .acu keeps it too)
  ADAM_TYPES_KEY_FLEXIBLE: string = "flex:";
  // The type of nil's key (no node id in it)
  ADAM_TYPES_KEY_NIL: string = "nil";

public type
  // What a type is, by its canonical node
  TypeClass = choices(
    Unknown, SignedInt, UnsignedInt, Float, Boolean, Char, WideChar, Text, WideText,
    UntypedPointer, Varargs, Pointer, StaticArray, DynamicArray, RecordType, ObjectType,
    InterfaceType, OverlayType, ChoicesType, SetType, RoutineType, OwnType, RefType,
    WeakType, TaskType, SequenceType, Mutex, NilType, FlexibleArray, TypeParam);

  // How print / println writes a value of a type (PrintFormOf)
  PrintForm = choices(
    Unknown, Unprintable, Integer, Boolean, Char, Float, Text, WideText, WideChar, CText,
    WideCText, Address, Choice, Range);

// The class of the builtin type named AName
routine DoBuiltinClass(const AName: string): TypeClass;
begin
  if (AName = "int8") or (AName = "int16") or (AName = "int32") or (AName = "int64") then
    return TypeClass.SignedInt;
  end;
  if (AName = "uint8") or (AName = "uint16") or (AName = "uint32") or (AName = "uint64") then
    return TypeClass.UnsignedInt;
  end;
  if AName = "clong" then
    return TypeClass.SignedInt;
  end;
  if AName = "culong" then
    return TypeClass.UnsignedInt;
  end;
  if (AName = "float32") or (AName = "float64") then
    return TypeClass.Float;
  end;
  if AName = "bool" then
    return TypeClass.Boolean;
  end;
  if AName = "char" then
    return TypeClass.Char;
  end;
  if AName = "wchar" then
    return TypeClass.WideChar;
  end;
  if AName = "string" then
    return TypeClass.Text;
  end;
  if AName = "wstring" then
    return TypeClass.WideText;
  end;
  if AName = "ptr" then
    return TypeClass.UntypedPointer;
  end;
  if AName = "varargs" then
    return TypeClass.Varargs;
  end;
  if AName = "mutex" then
    return TypeClass.Mutex;
  end;
  return TypeClass.Unknown;
end;

// The class of the body of a declared type (its TypeOf child's kind)
routine DoBodyClass(const AKind: NodeKind): TypeClass;
begin
  match AKind of
    NodeKind.RecordType: return TypeClass.RecordType;
    NodeKind.ObjectType: return TypeClass.ObjectType;
    NodeKind.InterfaceType: return TypeClass.InterfaceType;
    NodeKind.OverlayType: return TypeClass.OverlayType;
    NodeKind.ChoicesType: return TypeClass.ChoicesType;
    NodeKind.SetType: return TypeClass.SetType;
  else
    // any other body is an alias: never a canonical node
  end;
  return TypeClass.Unknown;
end;

// The class of the canonical type AType (Unknown for 0 and for a node that is no type)
public routine ClassOf(const ATree: ref SyntaxTree; const AType: int64): TypeClass;
var
  LKind: NodeKind;
  LBody: int64;
begin
  if AType = 0 then
    return TypeClass.Unknown;
  end;
  LKind := ATree[AType].Kind;
  if LKind = NodeKind.BuiltinTypeDecl then
    return DoBuiltinClass(ATree[AType].Text);
  end;
  // a generic's type parameter in its template (BNF sec 10): opaque, judged per instance
  if LKind = NodeKind.GenericParam then
    return TypeClass.TypeParam;
  end;
  if LKind = NodeKind.TypeDecl then
    LBody := ATree.FirstOf(AType, NodeRole.TypeOf);
    if LBody = 0 then
      return TypeClass.Unknown;
    end;
    return DoBodyClass(ATree[LBody].Kind);
  end;
  if ATree.ParentOf(AType) <> ADAM_AST_DERIVED then
    return TypeClass.Unknown;
  end;
  if LKind = NodeKind.ArrayType then
    if StartsStr(ADAM_TYPES_KEY_DYNAMIC, ATree[AType].Text) then
      return TypeClass.DynamicArray;
    end;
    if StartsStr(ADAM_TYPES_KEY_FLEXIBLE, ATree[AType].Text) then
      return TypeClass.FlexibleArray;
    end;
    return TypeClass.StaticArray;
  end;
  // `ptr to const` with no type (M9h0) points at none: an untyped ptr, flagged ConstTarget
  if (LKind = NodeKind.PointerType) and (ATree[AType].ResolvedType = 0) then
    return TypeClass.UntypedPointer;
  end;
  match LKind of
    NodeKind.PointerType: return TypeClass.Pointer;
    NodeKind.RoutineType: return TypeClass.RoutineType;
    NodeKind.OwnType: return TypeClass.OwnType;
    NodeKind.RefType: return TypeClass.RefType;
    NodeKind.WeakType: return TypeClass.WeakType;
    NodeKind.TaskType: return TypeClass.TaskType;
    NodeKind.SequenceType: return TypeClass.SequenceType;
    NodeKind.NilLiteral: return TypeClass.NilType;
  else
    // no other kind is made under the derived types
  end;
  return TypeClass.Unknown;
end;

// True for both integer classes
public routine IsIntegerClass(const AClass: TypeClass): bool;
begin
  return (AClass = TypeClass.SignedInt) or (AClass = TypeClass.UnsignedInt);
end;

// True for the integer classes and Float (the arithmetic operands)
public routine IsNumericClass(const AClass: TypeClass): bool;
begin
  return IsIntegerClass(AClass) or (AClass = TypeClass.Float);
end;

// True for the classes a pointer value has (typed, untyped, nil)
public routine IsPointerClass(const AClass: TypeClass): bool;
begin
  return (AClass = TypeClass.Pointer) or (AClass = TypeClass.UntypedPointer) or
    (AClass = TypeClass.NilType);
end;

// True when a value of AType travels as itself where C++ linkage passes a const parameter
// (BNF sec 3, PaskalCPP's TPCTypeExpr.IsScalarOrPointer): every builtin but string and
// wstring, a pointer, a routine value, a choices value; anything else binds by const
// reference. An unknown type is no scalar
public routine IsScalarOrPointer(const ATree: ref SyntaxTree; const AType: int64): bool;
var
  LClass: TypeClass;
begin
  LClass := ClassOf(ATree, AType);
  if (LClass = TypeClass.SignedInt) or (LClass = TypeClass.UnsignedInt) or (LClass = TypeClass.Float) or
    (LClass = TypeClass.Boolean) or (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) or
    (LClass = TypeClass.Varargs) then
    return true;
  end;
  return IsPointerClass(LClass) or (LClass = TypeClass.RoutineType) or (LClass = TypeClass.ChoicesType);
end;

// The width in bits of clong / culong: the target's, as the Driver wrote it into ATree at
// the target pick. Without one (no target found: DR0004 is already reported, nothing is
// laid out or generated) the widest, so no range check adds an error of its own
routine DoCLongBits(const ATree: ref SyntaxTree): int64;
begin
  if ATree.CLongBits > 0 then
    return ATree.CLongBits;
  end;
  return 64;
end;

// The width in bits of an integer builtin AType; 0 for any other type
public routine IntBits(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LName: string;
begin
  if not IsIntegerClass(ClassOf(ATree, AType)) then
    return 0;
  end;
  LName := ATree[AType].Text;
  if (LName = "int8") or (LName = "uint8") then
    return 8;
  end;
  if (LName = "int16") or (LName = "uint16") then
    return 16;
  end;
  if (LName = "int32") or (LName = "uint32") then
    return 32;
  end;
  if (LName = "clong") or (LName = "culong") then
    return DoCLongBits(ATree);
  end;
  return 64;
end;

// The width in bits of a float builtin AType; 0 for any other type
public routine FloatBits(const ATree: ref SyntaxTree; const AType: int64): int64;
begin
  if ClassOf(ATree, AType) <> TypeClass.Float then
    return 0;
  end;
  if ATree[AType].Text = "float32" then
    return 32;
  end;
  return 64;
end;

// The builtin type named AName (its system declaration); 0 when there is none
public routine BuiltinType(const ATree: ref SyntaxTree; const AName: string): int64;
var
  LFound: int64;
begin
  LFound := FindSystem(ATree, AName);
  if (LFound <> 0) and (ATree[LFound].Kind = NodeKind.BuiltinTypeDecl) then
    return LFound;
  end;
  return 0;
end;

// The type a derived AType is made over (a pointer's target, an array's or an owner's
// element, a routine type's return type); 0 for any other type
public routine TargetOf(const ATree: ref SyntaxTree; const AType: int64): int64;
begin
  if AType = 0 then
    return 0;
  end;
  if ATree.ParentOf(AType) <> ADAM_AST_DERIVED then
    return 0;
  end;
  return ATree[AType].ResolvedType;
end;

// True when AType is a ptr to const
public routine IsConstTarget(const ATree: ref SyntaxTree; const AType: int64): bool;
begin
  if AType = 0 then
    return false;
  end;
  return ATree[AType].HasFlag(NodeFlag.ConstTarget);
end;

// The body of the declared type AType (its RecordType, ObjectType, ... node); 0 for any
// type that is no TypeDecl
public routine BodyOf(const ATree: ref SyntaxTree; const AType: int64): int64;
begin
  if (AType = 0) or (ATree[AType].Kind <> NodeKind.TypeDecl) then
    return 0;
  end;
  return ATree.FirstOf(AType, NodeRole.TypeOf);
end;

// The derived type with key AKey, made under the derived types the first time it is
// asked for: AKind its kind, AOver the type it is made over, ADecl its ResolvedDecl (0, or
// the ArrayType expression a static array of non-constant bounds belongs to), AConst a ptr
// to const
routine DoIntern(const ATree: ref SyntaxTree; const AKind: NodeKind; const AKey: string;
  const AOver: int64; const ADecl: int64; const AConst: bool): int64;
var
  LId: int64;
begin
  // found by its key in one step (SyntaxTree.DerivedFor), never by a walk of every type
  LId := ATree.DerivedFor(AKey);
  if LId <> 0 then
    return LId;
  end;
  LId := ATree.AddChild(ADAM_AST_DERIVED, NodeRole.DerivedType, AKind, NoPlace(), 0, 0);
  ATree[LId].Text := AKey;
  ATree.NoteDerived(AKey, LId);
  ATree[LId].ResolvedType := AOver;
  ATree[LId].ResolvedDecl := ADecl;
  if AConst then
    ATree[LId].AddFlag(NodeFlag.ConstTarget);
  end;
  return LId;
end;

// The derived types' keys, one routine per form (the makers and InternCopies build a key only
// here: equal keys, equal types)
routine DoPointerKey(const ATarget: int64; const AConst: bool): string;
begin
  if AConst then
    return "ptrc:" + IntToStr(ATarget);
  end;
  return "ptr:" + IntToStr(ATarget);
end;

routine DoDynamicKey(const AElement: int64): string;
begin
  return ADAM_TYPES_KEY_DYNAMIC + IntToStr(AElement);
end;

routine DoFlexibleKey(const AElement: int64): string;
begin
  return ADAM_TYPES_KEY_FLEXIBLE + IntToStr(AElement);
end;

routine DoOwnerKey(const AKind: NodeKind; const AElement: int64): string;
begin
  if AKind = NodeKind.OwnType then
    return "own:" + IntToStr(AElement);
  end;
  if AKind = NodeKind.RefType then
    return "ref:" + IntToStr(AElement);
  end;
  return "weak:" + IntToStr(AElement);
end;

routine DoTaskKey(const AResult: int64): string;
begin
  return "task:" + IntToStr(AResult);
end;

routine DoSequenceKey(const AElement: int64): string;
begin
  return "seq:" + IntToStr(AElement);
end;

// The type of nil (it converts to every pointer, owner, routine and interface type)
public routine NilTypeOf(const ATree: ref SyntaxTree): int64;
begin
  return DoIntern(ATree, NodeKind.NilLiteral, ADAM_TYPES_KEY_NIL, 0, 0, false);
end;

// The part of the derived type AType's key an .acu keeps: a key holds node ids, which differ
// with the tree that made it (one unit's .acu would differ with the program that wrote it),
// so only the dynamic and the flexible array's tags (ADAM_TYPES_KEY_DYNAMIC /
// ADAM_TYPES_KEY_FLEXIBLE: ClassOf and InternCopies read them) are kept, every other key is
// empty; InternCopies rebuilds each key from the bound fields
public routine KeyTagOf(const ATree: ref SyntaxTree; const AType: int64): string;
begin
  if (ATree[AType].Kind = NodeKind.ArrayType) and StartsStr(ADAM_TYPES_KEY_DYNAMIC, ATree[AType].Text) then
    return ADAM_TYPES_KEY_DYNAMIC;
  end;
  if (ATree[AType].Kind = NodeKind.ArrayType) and StartsStr(ADAM_TYPES_KEY_FLEXIBLE, ATree[AType].Text) then
    return ADAM_TYPES_KEY_FLEXIBLE;
  end;
  return "";
end;

// ptr to ATarget (ptr to const ATarget when AConst)
public routine PointerTo(const ATree: ref SyntaxTree; const ATarget: int64; const AConst: bool): int64;
begin
  return DoIntern(ATree, NodeKind.PointerType, DoPointerKey(ATarget, AConst), ATarget, 0, AConst);
end;

// array of AElement (a dynamic array)
public routine DynamicArrayOf(const ATree: ref SyntaxTree; const AElement: int64): int64;
begin
  return DoIntern(ATree, NodeKind.ArrayType, DoDynamicKey(AElement), AElement, 0, false);
end;

// The flexible array member type of AElement (array[0..] of AElement, M9e0b): no size of
// its own, AElement's alignment, its index from 0 with no high bound (Layout checks where
// it stands: only a record's last field)
public routine FlexibleArrayOf(const ATree: ref SyntaxTree; const AElement: int64): int64;
begin
  return DoIntern(ATree, NodeKind.ArrayType, DoFlexibleKey(AElement), AElement, 0, false);
end;

// True when the array type expression AExpr is the flexible form array[0..] of T (the
// parser's flag OpenEnd: a low bound, '..', then ']')
public routine IsFlexibleArrayExpr(const ATree: ref SyntaxTree; const AExpr: int64): bool;
begin
  return (ATree[AExpr].Kind = NodeKind.ArrayType) and ATree[AExpr].HasFlag(NodeFlag.OpenEnd);
end;

// own / ref / weak AElement (AKind OwnType, RefType or WeakType)
public routine OwnerOf(const ATree: ref SyntaxTree; const AKind: NodeKind; const AElement: int64): int64;
begin
  return DoIntern(ATree, AKind, DoOwnerKey(AKind, AElement), AElement, 0, false);
end;

// task AResult (BNF sec 4 task type): a handle to a call started by `async` whose result
// is an AResult; 0 for plain `task` (a call with no result)
public routine TaskOf(const ATree: ref SyntaxTree; const AResult: int64): int64;
begin
  return DoIntern(ATree, NodeKind.TaskType, DoTaskKey(AResult), AResult, 0, false);
end;

// sequence of AElement (BNF sec 4 sequence type, G1): a handle to a generator's run that
// hands out AElement values
public routine SequenceOf(const ATree: ref SyntaxTree; const AElement: int64): int64;
begin
  return DoIntern(ATree, NodeKind.SequenceType, DoSequenceKey(AElement), AElement, 0, false);
end;

// The integer constant AExpr spells, read without folding (M1.10 folds the rest into
// ResolvedConst, read first): a literal, a signed or parenthesized one, a const's
// initializer. Its sign into ANegative, its magnitude into AMagnitude; false when it is
// no such constant
routine DoConstInt(const ATree: ref SyntaxTree; const AExpr: int64; const ADepth: int64;
  var ANegative: bool; var AMagnitude: uint64): bool;
var
  LNode: ref Node;
  LSigned: int64;
  LDecl: int64;
begin
  if (AExpr = 0) or (ADepth > ADAM_TYPES_MAX_DEPTH) then
    return false;
  end;
  LNode := ATree[AExpr];
  if LNode.ResolvedConst.Kind = ConstKind.Signed then
    LSigned := int64(LNode.ResolvedConst.Bits);
    ANegative := LSigned < 0;
    if ANegative then
      // -(v + 1) + 1: the magnitude of the lowest int64 too
      AMagnitude := uint64(-(LSigned + 1)) + 1;
    else
      AMagnitude := uint64(LSigned);
    end;
    return true;
  end;
  if LNode.ResolvedConst.Kind = ConstKind.Unsigned then
    ANegative := false;
    AMagnitude := LNode.ResolvedConst.Bits;
    return true;
  end;
  if LNode.Kind = NodeKind.IntLiteral then
    ANegative := false;
    AMagnitude := LNode.IntValue;
    return true;
  end;
  if LNode.Kind = NodeKind.ParenExpression then
    return DoConstInt(ATree, ATree.FirstOf(AExpr, NodeRole.Operand), ADepth + 1, ANegative,
      AMagnitude);
  end;
  if (LNode.Kind = NodeKind.UnaryExpression) and
    ((LNode.Op = OperatorKind.Plus) or (LNode.Op = OperatorKind.Negate)) then
    if not DoConstInt(ATree, ATree.FirstOf(AExpr, NodeRole.Operand), ADepth + 1, ANegative,
      AMagnitude) then
      return false;
    end;
    if (LNode.Op = OperatorKind.Negate) and (AMagnitude <> 0) then
      ANegative := not ANegative;
    end;
    return true;
  end;
  if LNode.Kind = NodeKind.NameExpression then
    LDecl := LNode.ResolvedDecl;
    if (LDecl <> 0) and (ATree[LDecl].Kind = NodeKind.ConstDecl) then
      return DoConstInt(ATree, ATree.FirstOf(LDecl, NodeRole.Initializer), ADepth + 1,
        ANegative, AMagnitude);
    end;
  end;
  return false;
end;

// The integer constant AExpr spells (see DoConstInt)
public routine ConstIntOf(const ATree: ref SyntaxTree; const AExpr: int64; var ANegative: bool;
  var AMagnitude: uint64): bool;
begin
  ANegative := false;
  AMagnitude := 0;
  return DoConstInt(ATree, AExpr, 0, ANegative, AMagnitude);
end;

// The text of an integer constant's sign and magnitude
public routine ConstIntText(const ANegative: bool; const AMagnitude: uint64): string;
begin
  if ANegative then
    return "-" + UIntToStr(AMagnitude);
  end;
  return UIntToStr(AMagnitude);
end;

// The largest magnitude a value of the integer type AType may have: for a negative value
// when ANegative (0 for an unsigned type)
public routine IntLimit(const ATree: ref SyntaxTree; const AType: int64; const ANegative: bool): uint64;
var
  LBits: int64;
  LSigned: bool;
  LHalf: uint64;
begin
  LBits := IntBits(ATree, AType);
  if LBits = 0 then
    return 0;
  end;
  LSigned := ClassOf(ATree, AType) = TypeClass.SignedInt;
  LHalf := uint64(1) shl uint64(LBits - 1);
  if LSigned then
    if ANegative then
      return LHalf;
    end;
    return LHalf - 1;
  end;
  if ANegative then
    return 0;
  end;
  // 2^bits - 1 written as half - 1 + half, so 64 bits does not overflow
  return (LHalf - 1) + LHalf;
end;

// True when the integer constant (ANegative, AMagnitude) is a value of the integer type
// AType
public routine IntFits(const ATree: ref SyntaxTree; const AType: int64; const ANegative: bool;
  const AMagnitude: uint64): bool;
begin
  if IntBits(ATree, AType) = 0 then
    return false;
  end;
  if AMagnitude = 0 then
    return true;
  end;
  return AMagnitude <= IntLimit(ATree, AType, ANegative);
end;

// The type a ForwardType AForward declares: its TypeDecl of the same name in the same
// scope; 0 when the scope holds none
routine DoForwardTarget(const ATree: ref SyntaxTree; const AForward: int64): int64;
var
  LScope: int64;
  LI: int64;
  LChild: int64;
begin
  LScope := ATree.ParentOf(AForward);
  if LScope = 0 then
    return 0;
  end;
  for LI := 0 to ATree.ChildCount(LScope) - 1 do
    LChild := ATree.ChildAt(LScope, LI);
    if (ATree[LChild].Kind = NodeKind.TypeDecl) and (ATree[LChild].Text = ATree[AForward].Text) then
      return LChild;
    end;
  end;
  return 0;
end;

forward routine DoCanonical(const ATree: ref SyntaxTree; const AExpr: int64; const ADepth: int64): int64;

// The canonical type the declaration ADecl declares (a builtin, a TypeDecl, a forward
// type); 0 for any other declaration or a broken alias
routine DoDeclared(const ATree: ref SyntaxTree; const ADecl: int64; const ADepth: int64): int64;
var
  LKind: NodeKind;
  LBody: int64;
begin
  if (ADecl = 0) or (ADepth > ADAM_TYPES_MAX_DEPTH) then
    return 0;
  end;
  LKind := ATree[ADecl].Kind;
  // an instance's type parameter is bound: it means its type argument (a type alias, BNF
  // sec 10); a template's has no type until an instance binds it: what depends on it is
  // checked per instance, and an unknown type is silent (the template's other parts are
  // checked once, at the declaration)
  if LKind = NodeKind.GenericParam then
    if ATree[ATree.ParentOf(ADecl)].Kind = NodeKind.GenericInstance then
      return ATree[ADecl].ResolvedType;
    end;
    return 0;
  end;
  if LKind = NodeKind.BuiltinTypeDecl then
    return ADecl;
  end;
  if LKind = NodeKind.ForwardType then
    return DoDeclared(ATree, DoForwardTarget(ATree, ADecl), ADepth + 1);
  end;
  if LKind <> NodeKind.TypeDecl then
    return 0;
  end;
  LBody := ATree.FirstOf(ADecl, NodeRole.TypeOf);
  if LBody = 0 then
    return 0;
  end;
  if DoBodyClass(ATree[LBody].Kind) <> TypeClass.Unknown then
    return ADecl;
  end;
  return DoCanonical(ATree, LBody, ADepth + 1);
end;

// The canonical type the declaration ADecl declares (see DoDeclared)
public routine DeclaredTypeOf(const ATree: ref SyntaxTree; const ADecl: int64): int64;
begin
  return DoDeclared(ATree, ADecl, 0);
end;

// True when the scope of the routine (or forward) AId declares more than one routine of
// its name: the overloads, which have C++ linkage whatever is written (BNF sec 4; forwards
// out, recovered ones out). The one rule: Symbols links by it, a routine type keys by it
public routine IsOverloadedRoutine(const ATree: ref SyntaxTree; const AId: int64): bool;
var
  LScope: int64;
  LI: int64;
  LChild: int64;
  LCount: int64;
begin
  LScope := ATree.ParentOf(AId);
  LCount := 0;
  for LI := 0 to ATree.ChildCount(LScope) - 1 do
    LChild := ATree.ChildAt(LScope, LI);
    if (ATree[LChild].Kind = NodeKind.RoutineDecl) and
      (not ATree[LChild].HasFlag(NodeFlag.Recovered)) and
      (ATree[LChild].Text = ATree[AId].Text) then
      LCount := LCount + 1;
      if LCount > 1 then
        return true;
      end;
    end;
  end;
  return false;
end;

// True when the signature ASig has C++ linkage: `cpplink` written, a routine / forward
// declaration that is overloaded (IsOverloadedRoutine), or a type's operator (a C++
// member's function: Symbols mangles its operands by C++ linkage); anything else has C
// linkage (`clink` written or no word: one linkage, BNF sec 4). The one rule for a
// signature's linkage before Symbols names it: the type key, its text and its mangling
// read it
public routine IsCppSignature(const ATree: ref SyntaxTree; const ASig: int64): bool;
var
  LKind: NodeKind;
begin
  if ATree[ASig].HasFlag(NodeFlag.Cpplink) then
    return true;
  end;
  LKind := ATree[ASig].Kind;
  if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) then
    // a generic routine's instance is cpplink (its symbol is mangled, BNF sec 10), but for
    // its clink adapter (flagged Clink: Semantics' NameResolver.ClinkInstance)
    return IsOverloadedRoutine(ATree, ASig) or
      ((InstanceOf(ATree, ASig) <> 0) and not ATree[ASig].HasFlag(NodeFlag.Clink));
  end;
  return LKind = NodeKind.OperatorDecl;
end;

// True when the signature ASig takes its object as a hidden self (a method, an init, a
// copy, a done, a property's accessor): its routine type is never a plain routine's, whatever its
// parameters (a value of a routine type is called with exactly its parameters); a routine
// type made from one is flagged TakesSelf
public routine TakesSelf(const ATree: ref SyntaxTree; const ASig: int64): bool;
var
  LKind: NodeKind;
begin
  LKind := ATree[ASig].Kind;
  return (LKind = NodeKind.MethodDecl) or (LKind = NodeKind.InitDecl) or
    (LKind = NodeKind.CopyDecl) or (LKind = NodeKind.DoneDecl) or (LKind = NodeKind.PropertyRead) or
    (LKind = NodeKind.PropertyWrite) or ATree[ASig].HasFlag(NodeFlag.TakesSelf);
end;

// The key of a routine signature ASig (a routine, method or forward declaration or a
// routine type): rm for one that takes self (TakesSelf), else rt; linkage (x for C++, by
// the linkage the signature has: IsCppSignature), each parameter's mode and type,
// variadic, the return type
routine DoRoutineKey(const ATree: ref SyntaxTree; const ASig: int64; const ADepth: int64;
  var AReturn: int64): string;
var
  LKey: string;
  LI: int64;
  LParam: int64;
  LReturn: int64;
begin
  LKey := "rt";
  if TakesSelf(ATree, ASig) then
    LKey := "rm";
  end;
  if IsCppSignature(ATree, ASig) then
    LKey := LKey + "x";
  end;
  LKey := LKey + "(";
  for LI := 0 to ATree.CountOf(ASig, NodeRole.Param) - 1 do
    LParam := ATree.NthOf(ASig, NodeRole.Param, LI);
    if LI > 0 then
      LKey := LKey + ",";
    end;
    if ATree[LParam].HasFlag(NodeFlag.VarParam) then
      LKey := LKey + "v";
    else
      if ATree[LParam].HasFlag(NodeFlag.ConstParam) then
        LKey := LKey + "c";
      end;
    end;
    LKey := LKey + IntToStr(DoCanonical(ATree, ATree.FirstOf(LParam, NodeRole.TypeOf), ADepth + 1));
  end;
  if ATree[ASig].HasFlag(NodeFlag.Variadic) then
    LKey := LKey + ",...";
  end;
  LReturn := ATree.FirstOf(ASig, NodeRole.ReturnType);
  AReturn := 0;
  if LReturn <> 0 then
    AReturn := DoCanonical(ATree, LReturn, ADepth + 1);
  end;
  return LKey + "):" + IntToStr(AReturn);
end;

// A type expression a derived node owns under AParent in ARole (a parameter's type, a
// return type): a NamedType whose ResolvedType is the canonical type AType (CanonicalOf
// reads it there; 0 when the expression it stands for named no type)
routine DoOwnedType(const ATree: ref SyntaxTree; const AParent: int64; const ARole: NodeRole;
  const AType: int64);
var
  LId: int64;
begin
  LId := ATree.AddChild(AParent, ARole, NodeKind.NamedType, NoPlace(), 0, 0);
  ATree[LId].ResolvedType := AType;
end;

// The new routine type AType given its own copy of the signature ASig it was made from:
// each parameter (its kind and mode, its type canonical), the return type, the flags its
// key and its readers read (Variadic, Clink as written, Cpplink for C++ linkage,
// TakesSelf); its ResolvedDecl the node itself, where every reader of a routine type's
// signature reads it. A link into ASig's module would make every unit that copies the
// type import that module (Adam.Acu.Writer). No place and no parameter name is kept: the
// type is the same for every signature of its key (a name would be its first maker's, so a
// unit's .acu would differ with the program that wrote it); a message naming a parameter
// of a call through a routine value takes the name from the value's written type
// (Semantics' DoNamingSignature)
routine DoOwnSignature(const ATree: ref SyntaxTree; const AType: int64; const ASig: int64;
  const ADepth: int64);
var
  LI: int64;
  LParam: int64;
  LOwned: int64;
  LReturn: int64;
begin
  for LI := 0 to ATree.CountOf(ASig, NodeRole.Param) - 1 do
    LParam := ATree.NthOf(ASig, NodeRole.Param, LI);
    LOwned := ATree.AddChild(AType, NodeRole.Param, ATree[LParam].Kind, NoPlace(), 0, 0);
    if ATree[LParam].HasFlag(NodeFlag.VarParam) then
      ATree[LOwned].AddFlag(NodeFlag.VarParam);
    end;
    if ATree[LParam].HasFlag(NodeFlag.ConstParam) then
      ATree[LOwned].AddFlag(NodeFlag.ConstParam);
    end;
    DoOwnedType(ATree, LOwned, NodeRole.TypeOf,
      DoCanonical(ATree, ATree.FirstOf(LParam, NodeRole.TypeOf), ADepth + 1));
  end;
  LReturn := ATree.FirstOf(ASig, NodeRole.ReturnType);
  if LReturn <> 0 then
    DoOwnedType(ATree, AType, NodeRole.ReturnType, DoCanonical(ATree, LReturn, ADepth + 1));
  end;
  if ATree[ASig].HasFlag(NodeFlag.Variadic) then
    ATree[AType].AddFlag(NodeFlag.Variadic);
  end;
  if ATree[ASig].HasFlag(NodeFlag.Clink) then
    ATree[AType].AddFlag(NodeFlag.Clink);
  end;
  if IsCppSignature(ATree, ASig) then
    ATree[AType].AddFlag(NodeFlag.Cpplink);
  end;
  if TakesSelf(ATree, ASig) then
    ATree[AType].AddFlag(NodeFlag.TakesSelf);
  end;
  ATree[AType].ResolvedDecl := AType;
end;

// The routine type of the signature ASig (equal signatures, one type): a new one owns its
// signature (DoOwnSignature)
routine DoRoutineType(const ATree: ref SyntaxTree; const ASig: int64; const ADepth: int64): int64;
var
  LKey: string;
  LReturn: int64;
  LType: int64;
begin
  LReturn := 0;
  LKey := DoRoutineKey(ATree, ASig, ADepth, LReturn);
  LType := DoIntern(ATree, NodeKind.RoutineType, LKey, LReturn, 0, false);
  if ATree[LType].ResolvedDecl = 0 then
    DoOwnSignature(ATree, LType, ASig, ADepth);
  end;
  return LType;
end;

// The routine type of the signature ASig (a routine, method or forward declaration or a
// routine type expression)
public routine RoutineTypeOf(const ATree: ref SyntaxTree; const ASig: int64): int64;
begin
  if ASig = 0 then
    return 0;
  end;
  return DoRoutineType(ATree, ASig, 0);
end;

// The bounds of the array ASource (an ArrayType expression, or a static array that owns its
// bounds) when both are integer constants: each one's sign and magnitude (ConstIntOf)
routine DoConstBounds(const ATree: ref SyntaxTree; const ASource: int64; var ALowNeg: bool;
  var ALowMag: uint64; var AHighNeg: bool; var AHighMag: uint64): bool;
begin
  // the high bound's outputs are set even when the low one is no constant
  AHighNeg := false;
  AHighMag := 0;
  return ConstIntOf(ATree, ATree.FirstOf(ASource, NodeRole.LowBound), ALowNeg, ALowMag) and
    ConstIntOf(ATree, ATree.FirstOf(ASource, NodeRole.HighBound), AHighNeg, AHighMag);
end;

// The index family the bounds of the array ASource give it (see DoConstBounds): the low
// bound's type when it is a char, wchar or choices type (an index of that type, Semantics'
// DoIndexBoundType), 0 for an integer one. Part of the type: array[Color.A..Color.C] and
// array[0..2] are two types
routine DoBoundFamily(const ATree: ref SyntaxTree; const ASource: int64): int64;
var
  LType: int64;
  LClass: TypeClass;
begin
  LType := ATree[ATree.FirstOf(ASource, NodeRole.LowBound)].ResolvedType;
  LClass := ClassOf(ATree, LType);
  if (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) or (LClass = TypeClass.ChoicesType) then
    return LType;
  end;
  return 0;
end;

// The key of a static array of AElement bounded by the integer constants given, in the
// index family AFamily (DoBoundFamily; 0 for integers)
routine DoBoundsKey(const ALowNeg: bool; const ALowMag: uint64; const AHighNeg: bool;
  const AHighMag: uint64; const AFamily: int64; const AElement: int64): string;
var
  LKey: string;
begin
  LKey := "arr[" + ConstIntText(ALowNeg, ALowMag) + ".." + ConstIntText(AHighNeg, AHighMag);
  if AFamily <> 0 then
    LKey := LKey + "@" + IntToStr(AFamily);
  end;
  return LKey + "]:" + IntToStr(AElement);
end;

// The key of the static array of AElement ASource writes (see DoConstBounds): its bounds'
// values and index family when both are integer constants, else the expression itself
// names it
routine DoStaticKey(const ATree: ref SyntaxTree; const ASource: int64; const AElement: int64): string;
var
  LLowNeg: bool;
  LLowMag: uint64;
  LHighNeg: bool;
  LHighMag: uint64;
begin
  if DoConstBounds(ATree, ASource, LLowNeg, LLowMag, LHighNeg, LHighMag) then
    return DoBoundsKey(LLowNeg, LLowMag, LHighNeg, LHighMag, DoBoundFamily(ATree, ASource), AElement);
  end;
  return "arr#" + IntToStr(ASource) + ":" + IntToStr(AElement);
end;

forward routine DoBoundText(const ATree: ref SyntaxTree; const AExpr: int64): string;

// A bound a static array owns under AArray in ARole: the integer constant ANegative /
// AMagnitude as the parser writes one (an IntLiteral, under a Negate when negative), each
// node folded as Semantics folds it, so ConstIntOf and BoundValue read it as they read a
// written bound. In an index family (AFamily, DoBoundFamily) it is typed so and spelled as
// the written bound ASource is (a choice value's name: one per value); an integer bound is
// untyped (a visit types it) and spelled by its value. No place: the bound is the same for
// every source of its array's key
routine DoOwnBound(const ATree: ref SyntaxTree; const AArray: int64; const ARole: NodeRole;
  const ANegative: bool; const AMagnitude: uint64; const AFamily: int64; const ASource: int64);
var
  LParent: int64;
  LRole: NodeRole;
  LLiteral: int64;
  LNegate: int64;
  LValue: ConstValue;
begin
  LParent := AArray;
  LRole := ARole;
  if ANegative then
    LNegate := ATree.AddChild(AArray, ARole, NodeKind.UnaryExpression, NoPlace(), 0, 0);
    ATree[LNegate].Op := OperatorKind.Negate;
    ATree[LNegate].Text := "-";
    ATree[LNegate].ResolvedType := AFamily;
    LValue.Kind := ConstKind.Signed;
    // -(magnitude) in two's complement: the lowest int64 too
    LValue.Bits := (~AMagnitude) + 1;
    LValue.Float := 0.0;
    LValue.Text := "";
    ATree[LNegate].ResolvedConst := LValue;
    LParent := LNegate;
    LRole := NodeRole.Operand;
  end;
  LLiteral := ATree.AddChild(LParent, LRole, NodeKind.IntLiteral, NoPlace(), 0, 0);
  ATree[LLiteral].IntValue := AMagnitude;
  ATree[LLiteral].ResolvedType := AFamily;
  if (AFamily <> 0) and not ANegative then
    ATree[LLiteral].Text := DoBoundText(ATree, ASource);
  else
    ATree[LLiteral].Text := UIntToStr(AMagnitude);
  end;
  if AMagnitude > 0x7FFFFFFFFFFFFFFFu then
    LValue.Kind := ConstKind.Unsigned;
  else
    LValue.Kind := ConstKind.Signed;
  end;
  LValue.Bits := AMagnitude;
  LValue.Float := 0.0;
  LValue.Text := "";
  ATree[LLiteral].ResolvedConst := LValue;
end;

// The static array of AElement the ArrayType expression ASource writes. With integer
// constant bounds it is one type for every source of its bounds' values: a new one owns them
// (DoOwnBound), its ResolvedDecl the node itself, where every reader of a static array's
// bounds reads them. Any other bounds make it the expression's own type (its key names it),
// its ResolvedDecl that expression
routine DoStaticArray(const ATree: ref SyntaxTree; const ASource: int64; const AElement: int64): int64;
var
  LLowNeg: bool;
  LLowMag: uint64;
  LHighNeg: bool;
  LHighMag: uint64;
  LFamily: int64;
  LType: int64;
begin
  if not DoConstBounds(ATree, ASource, LLowNeg, LLowMag, LHighNeg, LHighMag) then
    return DoIntern(ATree, NodeKind.ArrayType, DoStaticKey(ATree, ASource, AElement), AElement,
      ASource, false);
  end;
  LFamily := DoBoundFamily(ATree, ASource);
  LType := DoIntern(ATree, NodeKind.ArrayType, DoBoundsKey(LLowNeg, LLowMag, LHighNeg, LHighMag,
    LFamily, AElement), AElement, 0, false);
  if ATree[LType].ResolvedDecl = 0 then
    DoOwnBound(ATree, LType, NodeRole.LowBound, LLowNeg, LLowMag, LFamily,
      ATree.FirstOf(ASource, NodeRole.LowBound));
    DoOwnBound(ATree, LType, NodeRole.HighBound, LHighNeg, LHighMag, LFamily,
      ATree.FirstOf(ASource, NodeRole.HighBound));
    ATree[LType].ResolvedDecl := LType;
  end;
  return LType;
end;

// The key of the generic ADecl's instance over the canonical types AArgs (the tree's
// instance map, SyntaxTree.InstanceFor: one instance per generic and argument list; a clink
// adapter's adds ADAM_TYPES_CLINK_KEY)
public routine InstanceKey(const ADecl: int64; const AArgs: ref NodeList): string;
var
  LKey: string;
  LI: int64;
begin
  LKey := IntToStr(ADecl);
  for LI := 0 to AArgs.Count - 1 do
    LKey := LKey + ":" + IntToStr(AArgs.Items[LI]);
  end;
  return LKey;
end;

type
  // The derived types and generic instances an .acu group brought in made canonical (see
  // InternCopies). FState holds a copy's and an instance's state: 0 neither, 3 not yet
  // interned, 1 in progress, 2 done (any state but 0 marks one); FInstanceOf each node of an
  // instance's subtree to its innermost instance; FMap a copy's canonical type and each
  // node of an instance merged into an equal one already in the tree to its counterpart
  CopyInterner = object
    hidden FTree: ref SyntaxTree;
    hidden FState: ref Int64Map;
    hidden FInstanceOf: ref Int64Map;
    hidden FMap: ref Int64Map;

    init(const ATree: ref SyntaxTree; const AMap: ref Int64Map);
    begin
      self.FTree := ATree;
      self.FMap := AMap;
      self.FState := ref Int64Map(0);
      self.FInstanceOf := ref Int64Map(0);
    end;

    // AId and its subtree marked as AInstance's (an enclosing instance marks first: a
    // nested one marks its own subtree after it)
    hidden method DoMarkInstance(const AId: int64; const AInstance: int64);
    var
      LI: int64;
    begin
      self.FInstanceOf.Put(AId, AInstance);
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        self.DoMarkInstance(self.FTree.ChildAt(AId, LI), AInstance);
      end;
    end;

    // The canonical node a loaded link ALink stands for: a node of a loaded instance once
    // the instance is interned (its counterpart when it was merged), a derived copy
    // interned, any other node as it is
    hidden method DoCanonicalLink(const ALink: int64): int64;
    var
      LInstance: int64;
      LTo: int64;
    begin
      if ALink <= 0 then
        return ALink;
      end;
      LInstance := self.FInstanceOf.Find(ALink);
      if LInstance <> 0 then
        self.DoInternInstance(LInstance);
        LTo := self.FMap.Find(ALink);
        if LTo <> 0 then
          return LTo;
        end;
        return ALink;
      end;
      if self.FState.Find(ALink) <> 0 then
        return self.DoInternCopy(ALink);
      end;
      return ALink;
    end;

    // The loaded subtree AFrom merged into the equal one AInto (the same generic over the
    // same arguments, so the same clone): each node mapped to its counterpart, children
    // paired in order; a nested instance or a write summary one side has and the other
    // lacks is left out of the pairing (a nested instance is interned on its own)
    hidden method DoMerge(const AFrom: int64; const AInto: int64);
    var
      LFrom: ref NodeList;
      LInto: ref NodeList;
      LI: int64;
    begin
      self.FMap.Put(AFrom, AInto);
      LFrom := ref NodeList();
      LInto := ref NodeList();
      self.DoPairable(AFrom, LFrom);
      self.DoPairable(AInto, LInto);
      LI := 0;
      while (LI < LFrom.Count) and (LI < LInto.Count) do
        self.DoMerge(LFrom.Items[LI], LInto.Items[LI]);
        LI := LI + 1;
      end;
    end;

    // AId's children DoMerge pairs: all but its nested instances and its write summary
    hidden method DoPairable(const AId: int64; const AList: ref NodeList);
    var
      LChild: int64;
      LI: int64;
    begin
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LChild := self.FTree.ChildAt(AId, LI);
        if (self.FTree[LChild].Kind <> NodeKind.GenericInstance) and
          (self.FTree.RoleOf(LChild) <> NodeRole.Effects) then
          AList.Add(LChild);
        end;
      end;
    end;

    // The loaded generic instance AInstance interned: its generic and its arguments made
    // canonical first, then its key; an instance of that key already in the tree takes its
    // place (every node of it merged into that one, DoMerge, and it detached), else it is
    // the tree's for the key, moved under its parent's counterpart when its parent was merged
    hidden method DoInternInstance(const AInstance: int64);
    var
      LArgs: ref NodeList;
      LGeneric: int64;
      LParam: int64;
      LClone: int64;
      LKey: string;
      LFound: int64;
      LParent: int64;
      LI: int64;
    begin
      if (self.FState.Find(AInstance) = 1) or (self.FState.Find(AInstance) = 2) then
        return;
      end;
      self.FState.Put(AInstance, 1);
      // an instance nested in another's clone: its generic is that clone's, the enclosing
      // instance interned first
      LGeneric := self.DoCanonicalLink(self.FTree[AInstance].ResolvedDecl);
      self.FTree[AInstance].ResolvedDecl := LGeneric;
      LArgs := ref NodeList();
      for LI := 0 to self.FTree.CountOf(AInstance, NodeRole.GenericParam) - 1 do
        LParam := self.FTree.NthOf(AInstance, NodeRole.GenericParam, LI);
        self.FTree[LParam].ResolvedType := self.DoCanonicalLink(self.FTree[LParam].ResolvedType);
        LArgs.Add(self.FTree[LParam].ResolvedType);
      end;
      LKey := InstanceKey(LGeneric, LArgs);
      LClone := self.FTree.FirstOf(AInstance, NodeRole.Instance);
      if (LClone <> 0) and self.FTree[LClone].HasFlag(NodeFlag.Clink) then
        LKey := LKey + ADAM_TYPES_CLINK_KEY;
      end;
      LFound := self.FTree.InstanceFor(LKey);
      if (LFound <> 0) and (LFound <> AInstance) then
        self.DoMerge(AInstance, LFound);
        self.FTree.Detach(AInstance);
      else
        self.FTree.AddInstance(LKey, AInstance);
        LParent := self.FTree.ParentOf(AInstance);
        if (LParent <> 0) and (self.FMap.Find(LParent) <> 0) then
          self.FTree.Detach(AInstance);
          self.FTree.Attach(self.FMap.Find(LParent), NodeRole.Instance, AInstance);
        end;
      end;
      self.FState.Put(AInstance, 2);
    end;

    // One copy's canonical type: its key's inputs made canonical first (DoCanonicalLink:
    // copies and instances interned), then its key rebuilt from its bound fields; an equal
    // derived type already in the tree is it, else the copy is attached under the derived
    // types with the rebuilt key
    hidden method DoInternCopy(const ACopy: int64): int64;
    var
      LNode: ref Node;
      LKey: string;
      LFound: int64;
      LI: int64;
      LParam: int64;
      LExpr: int64;
      LReturn: int64;
    begin
      if self.FState.Find(ACopy) = 2 then
        return self.FMap.Find(ACopy);
      end;
      if self.FState.Find(ACopy) = 1 then
        // A key that reaches itself: kept as the copy (Semantics reported its cycle when it ran)
        return ACopy;
      end;
      self.FState.Put(ACopy, 1);
      LNode := self.FTree[ACopy];
      LNode.ResolvedType := self.DoCanonicalLink(LNode.ResolvedType);
      if LNode.Kind = NodeKind.RoutineType then
        // DoRoutineKey reads each parameter's and the return's type expression's ResolvedType
        for LI := 0 to self.FTree.CountOf(LNode.ResolvedDecl, NodeRole.Param) - 1 do
          LParam := self.FTree.NthOf(LNode.ResolvedDecl, NodeRole.Param, LI);
          LExpr := self.FTree.FirstOf(LParam, NodeRole.TypeOf);
          if LExpr <> 0 then
            self.FTree[LExpr].ResolvedType := self.DoCanonicalLink(self.FTree[LExpr].ResolvedType);
          end;
        end;
        LExpr := self.FTree.FirstOf(LNode.ResolvedDecl, NodeRole.ReturnType);
        if LExpr <> 0 then
          self.FTree[LExpr].ResolvedType := self.DoCanonicalLink(self.FTree[LExpr].ResolvedType);
        end;
        LReturn := 0;
        LKey := DoRoutineKey(self.FTree, LNode.ResolvedDecl, 0, LReturn);
      else
        LKey := self.DoCopyKey(LNode);
      end;
      LFound := self.FTree.DerivedFor(LKey);
      if LFound <> 0 then
        self.FMap.Put(ACopy, LFound);
      else
        self.FMap.Put(ACopy, ACopy);
        LNode.Text := LKey;
        self.FTree.Attach(ADAM_AST_DERIVED, NodeRole.DerivedType, ACopy);
        self.FTree.NoteDerived(LKey, ACopy);
      end;
      self.FState.Put(ACopy, 2);
      return self.FMap.Find(ACopy);
    end;

    // The key of the copy ANode (no routine type), rebuilt from its bound fields as its
    // maker builds it
    hidden const method DoCopyKey(const ANode: ref Node): string;
    begin
      if ANode.Kind = NodeKind.PointerType then
        return DoPointerKey(ANode.ResolvedType, ANode.HasFlag(NodeFlag.ConstTarget));
      end;
      if ANode.Kind = NodeKind.ArrayType then
        if StartsStr(ADAM_TYPES_KEY_DYNAMIC, ANode.Text) then
          return DoDynamicKey(ANode.ResolvedType);
        end;
        if StartsStr(ADAM_TYPES_KEY_FLEXIBLE, ANode.Text) then
          return DoFlexibleKey(ANode.ResolvedType);
        end;
        return DoStaticKey(self.FTree, ANode.ResolvedDecl, ANode.ResolvedType);
      end;
      if (ANode.Kind = NodeKind.OwnType) or (ANode.Kind = NodeKind.RefType) or
        (ANode.Kind = NodeKind.WeakType) then
        return DoOwnerKey(ANode.Kind, ANode.ResolvedType);
      end;
      if ANode.Kind = NodeKind.TaskType then
        return DoTaskKey(ANode.ResolvedType);
      end;
      if ANode.Kind = NodeKind.SequenceType then
        return DoSequenceKey(ANode.ResolvedType);
      end;
      if ANode.Kind = NodeKind.NilLiteral then
        return ADAM_TYPES_KEY_NIL;
      end;
      // no other kind is made under the derived types (ClassOf): kept as it came
      return ANode.Text;
    end;

    // Every instance of AInstances (enclosing ones before nested ones) and every copy of
    // ACopies interned
    method Run(const ACopies: ref NodeList; const AInstances: ref NodeList);
    var
      LI: int64;
    begin
      for LI := 0 to ACopies.Count - 1 do
        self.FState.Put(ACopies[LI], 3);
      end;
      for LI := 0 to AInstances.Count - 1 do
        self.FState.Put(AInstances[LI], 3);
        self.DoMarkInstance(AInstances[LI], AInstances[LI]);
      end;
      for LI := 0 to AInstances.Count - 1 do
        self.DoInternInstance(AInstances[LI]);
      end;
      for LI := 0 to ACopies.Count - 1 do
        self.DoInternCopy(ACopies[LI]);
      end;
    end;
  end;

// The derived types and generic instances an .acu group brought in made canonical
// (ACopies: detached derived nodes whose links are bound to this tree, each the head of
// its copied subtree; AInstances: every GenericInstance the group read, its members' own
// and the ones a member carries from another unit, enclosing ones first): each derived
// copy's key rebuilt from its fields as its maker builds it, an equal derived type already
// in the tree taken in its place, a new one attached under the derived types; each
// instance's key made from its generic and canonical arguments, an instance of that key
// already in the tree taken in its place (the copy detached, M10f: every unit carries the
// instances it uses, one per key in a tree), a new one the tree's. AMap gets each copy's
// canonical type (itself when it was new) and each merged instance node its counterpart;
// the caller sends every link of the loaded nodes through it
public routine InternCopies(const ATree: ref SyntaxTree; const ACopies: ref NodeList;
  const AInstances: ref NodeList; const AMap: ref Int64Map);
var
  LInterner: ref CopyInterner;
begin
  LInterner := ref CopyInterner(ATree, AMap);
  LInterner.Run(ACopies, AInstances);
end;

// The canonical type of the type expression AExpr, written into its ResolvedType once;
// 0 when it names no type (an unresolved name, an error, a cycle)
routine DoCanonical(const ATree: ref SyntaxTree; const AExpr: int64; const ADepth: int64): int64;
var
  LKind: NodeKind;
  LType: int64;
  LElement: int64;
begin
  if (AExpr = 0) or (ADepth > ADAM_TYPES_MAX_DEPTH) then
    return 0;
  end;
  if ATree[AExpr].ResolvedType <> 0 then
    return ATree[AExpr].ResolvedType;
  end;
  LKind := ATree[AExpr].Kind;
  LType := 0;
  if LKind = NodeKind.BuiltinTypeName then
    LType := BuiltinType(ATree, ATree[AExpr].Text);
  end;
  if LKind = NodeKind.NamedType then
    LType := DoDeclared(ATree, ATree[AExpr].ResolvedDecl, ADepth + 1);
  end;
  if LKind = NodeKind.RoutineType then
    LType := DoRoutineType(ATree, AExpr, ADepth + 1);
  end;
  // a field's inline type (its own record or overlay, BNF sec 4, TODO 6) is a TypeDecl
  // standing as the type expression
  if LKind = NodeKind.TypeDecl then
    LType := DoDeclared(ATree, AExpr, ADepth + 1);
  end;
  // `ptr to const` with no type after it (M9h0): the untyped ptr to const, over none
  if (LKind = NodeKind.PointerType) and (ATree.FirstOf(AExpr, NodeRole.Element) = 0) and
    ATree[AExpr].HasFlag(NodeFlag.ConstTarget) then
    LType := PointerTo(ATree, 0, true);
  end;
  // task T over its result type, plain task over none (a result type that does not
  // resolve leaves no type)
  if LKind = NodeKind.TaskType then
    if ATree.FirstOf(AExpr, NodeRole.Element) = 0 then
      LType := TaskOf(ATree, 0);
    else
      LElement := DoCanonical(ATree, ATree.FirstOf(AExpr, NodeRole.Element), ADepth + 1);
      if LElement <> 0 then
        LType := TaskOf(ATree, LElement);
      end;
    end;
  end;
  // sequence of T over its element type (one that does not resolve leaves no type)
  if LKind = NodeKind.SequenceType then
    LElement := DoCanonical(ATree, ATree.FirstOf(AExpr, NodeRole.Element), ADepth + 1);
    if LElement <> 0 then
      LType := SequenceOf(ATree, LElement);
    end;
  end;
  if (LKind = NodeKind.PointerType) or (LKind = NodeKind.ArrayType) or
    (LKind = NodeKind.OwnType) or (LKind = NodeKind.RefType) or (LKind = NodeKind.WeakType) then
    LElement := DoCanonical(ATree, ATree.FirstOf(AExpr, NodeRole.Element), ADepth + 1);
    if LElement <> 0 then
      if LKind = NodeKind.PointerType then
        LType := PointerTo(ATree, LElement, ATree[AExpr].HasFlag(NodeFlag.ConstTarget));
      else
        if LKind = NodeKind.ArrayType then
          if ATree.FirstOf(AExpr, NodeRole.LowBound) = 0 then
            LType := DynamicArrayOf(ATree, LElement);
          else
            if IsFlexibleArrayExpr(ATree, AExpr) then
              LType := FlexibleArrayOf(ATree, LElement);
            else
              LType := DoStaticArray(ATree, AExpr, LElement);
            end;
          end;
        else
          LType := OwnerOf(ATree, LKind, LElement);
        end;
      end;
    end;
  end;
  if LType <> 0 then
    ATree[AExpr].ResolvedType := LType;
  end;
  return LType;
end;

// The canonical type of the type expression AExpr (see DoCanonical)
public routine CanonicalOf(const ATree: ref SyntaxTree; const AExpr: int64): int64;
begin
  return DoCanonical(ATree, AExpr, 0);
end;

// Declared below (it walks ParentTypeOf's chain): PassedByReference asks it first
public forward routine IsPolymorphic(const ATree: ref SyntaxTree; const AType: int64): bool;

// True when the parameter AParam binds by reference under ALinkage (BNF sec 3, the one
// rule, PaskalCPP's TPCParam.IsPassedByReference): var always; no mode never; const under
// C linkage never (the C ABI), under C++ linkage when its type is no scalar or pointer;
// a const interface under any linkage (BNF sec 4 O7: an interface is never a value, it
// is reached through var, const, ptr to, own or ref: its const is its itable word's
// address, I2); a const polymorphic object under any linkage too (it takes a descendant,
// BNF sec 6: a copy of its static type's bytes would cut off the descendant's fields that
// `as` and its virtual methods reach)
public routine PassedByReference(const ATree: ref SyntaxTree; const AParam: int64;
  const ALinkage: Linkage): bool;
var
  LTypeExpr: int64;
  LType: int64;
begin
  if ATree[AParam].HasFlag(NodeFlag.VarParam) then
    return true;
  end;
  if not ATree[AParam].HasFlag(NodeFlag.ConstParam) then
    return false;
  end;
  LTypeExpr := ATree.FirstOf(AParam, NodeRole.TypeOf);
  if LTypeExpr = 0 then
    return false;
  end;
  LType := CanonicalOf(ATree, LTypeExpr);
  if ClassOf(ATree, LType) = TypeClass.InterfaceType then
    return true;
  end;
  if (ClassOf(ATree, LType) = TypeClass.ObjectType) and IsPolymorphic(ATree, LType) then
    return true;
  end;
  if ALinkage <> Linkage.Cpp then
    return false;
  end;
  return not IsScalarOrPointer(ATree, LType);
end;

// The parent type of the record or object AType (its Parent child, canonical); 0 when it
// has none
public routine ParentTypeOf(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LBody: int64;
  LParent: int64;
begin
  LBody := BodyOf(ATree, AType);
  if LBody = 0 then
    return 0;
  end;
  LParent := ATree.FirstOf(LBody, NodeRole.Parent);
  if LParent = 0 then
    return 0;
  end;
  return CanonicalOf(ATree, LParent);
end;

// True when ABase is a parent of AType, any number of levels up (a type is not its own)
public routine IsBaseOf(const ATree: ref SyntaxTree; const ABase: int64; const AType: int64): bool;
var
  LAt: int64;
  LDepth: int64;
begin
  if (ABase = 0) or (AType = 0) then
    return false;
  end;
  LAt := ParentTypeOf(ATree, AType);
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    if LAt = ABase then
      return true;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return false;
end;

// The member AName of the aggregate AAggregate: its own members, then the members of its
// anonymous records and overlays (they belong to it); 0 when none
routine DoMemberIn(const ATree: ref SyntaxTree; const AAggregate: int64; const AName: string;
  const ADepth: int64): int64;
var
  LI: int64;
  LChild: int64;
  LFound: int64;
begin
  if ADepth > ADAM_TYPES_MAX_DEPTH then
    return 0;
  end;
  for LI := 0 to ATree.CountOf(AAggregate, NodeRole.Member) - 1 do
    LChild := ATree.NthOf(AAggregate, NodeRole.Member, LI);
    // an unnamed bitfield (`_`, M9e0c) is no member any name reaches
    if (ATree[LChild].Text = AName) and not IsUnnamedField(ATree, LChild) then
      return LChild;
    end;
    if (ATree[LChild].Kind = NodeKind.AnonRecord) or (ATree[LChild].Kind = NodeKind.AnonOverlay) then
      LFound := DoMemberIn(ATree, LChild, AName, ADepth + 1);
      if LFound <> 0 then
        return LFound;
      end;
    end;
  end;
  return 0;
end;

// The member AName of the declared type AType (a field, method, property, embed, choice
// value, operator), its parents searched after it; 0 when none holds it
public routine MemberOf(const ATree: ref SyntaxTree; const AType: int64; const AName: string): int64;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LFound: int64;
begin
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return 0;
    end;
    LFound := DoMemberIn(ATree, LBody, AName, 0);
    if LFound <> 0 then
      return LFound;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return 0;
end;

// The default property of the declared type AType (BNF sec 4: `default`, reached by
// X[i]): the first indexed property flagged DefaultProperty among its own members, then
// its parents', nearest level first; 0 when none (a plain property is never a default)
public routine DefaultPropertyOf(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LChild: int64;
begin
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return 0;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Member) - 1 do
      LChild := ATree.NthOf(LBody, NodeRole.Member, LI);
      if (ATree[LChild].Kind = NodeKind.PropertyDecl) and
        ATree[LChild].HasFlag(NodeFlag.DefaultProperty) and
        (ATree.FirstOf(LChild, NodeRole.Param) <> 0) then
        return LChild;
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return 0;
end;

// True when the object type AType is final (no type may extend it)
public routine IsFinalType(const ATree: ref SyntaxTree; const AType: int64): bool;
var
  LBody: int64;
begin
  LBody := BodyOf(ATree, AType);
  return (LBody <> 0) and ATree[LBody].HasFlag(NodeFlag.Final);
end;

// True when AType is polymorphic (BNF sec 6, is / as): an interface, or an object with a
// virtual or override method or property, or one that implements an interface, its own
// or a parent's
public routine IsPolymorphic(const ATree: ref SyntaxTree; const AType: int64): bool;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LChild: int64;
begin
  if ClassOf(ATree, AType) = TypeClass.InterfaceType then
    return true;
  end;
  if ClassOf(ATree, AType) <> TypeClass.ObjectType then
    return false;
  end;
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return false;
    end;
    if ATree.CountOf(LBody, NodeRole.Implements) > 0 then
      return true;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Member) - 1 do
      LChild := ATree.NthOf(LBody, NodeRole.Member, LI);
      if ((ATree[LChild].Kind = NodeKind.MethodDecl) or (ATree[LChild].Kind = NodeKind.PropertyDecl)) and
        (ATree[LChild].HasFlag(NodeFlag.Virtual) or ATree[LChild].HasFlag(NodeFlag.Override)) then
        return true;
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return false;
end;

// True when the object type AType, or a level above it, names the interface AInterface
// (or an interface descended from it) after implements
public routine Implements(const ATree: ref SyntaxTree; const AType: int64;
  const AInterface: int64): bool;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LNamed: int64;
begin
  if (AType = 0) or (AInterface = 0) then
    return false;
  end;
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return false;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Implements) - 1 do
      LNamed := CanonicalOf(ATree, ATree.NthOf(LBody, NodeRole.Implements, LI));
      if (LNamed = AInterface) or IsBaseOf(ATree, AInterface, LNamed) then
        return true;
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return false;
end;

// True when AAncestor is a level above AType: a parent (any number of levels up) or an
// interface AType implements. A type is not its own ancestor
public routine IsAncestorOf(const ATree: ref SyntaxTree; const AAncestor: int64;
  const AType: int64): bool;
begin
  if IsBaseOf(ATree, AAncestor, AType) then
    return true;
  end;
  return (ClassOf(ATree, AAncestor) = TypeClass.InterfaceType) and
    (ClassOf(ATree, AType) = TypeClass.ObjectType) and Implements(ATree, AType, AAncestor);
end;

// True when a reference to a value of AFrom (a var or const parameter, a pointer's
// target) may stand for one of AReach: the same type, or AReach an ancestor of it (a
// record's base, an object's parent, an interface it implements)
public routine ReachesAs(const ATree: ref SyntaxTree; const AFrom: int64;
  const AReach: int64): bool;
begin
  if (AFrom = 0) or (AReach = 0) or (AFrom = AReach) then
    return true;
  end;
  return IsAncestorOf(ATree, AReach, AFrom);
end;

// The embeds of every level of the chain of the object or record AType (BNF sec 4: an
// embed is a field of the level that declares it), added to AEmbeds in chain order (its
// own level first), each reached from the entry AFrom (EmbedMemberOf's entries; -1: AType
// is the accessed type itself)
routine DoChainEmbeds(const ATree: ref SyntaxTree; const AType: int64; const AFrom: int64;
  var AEmbeds: NodeList; var AFroms: NodeList);
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LChild: int64;
begin
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Member) - 1 do
      LChild := ATree.NthOf(LBody, NodeRole.Member, LI);
      if ATree[LChild].Kind = NodeKind.EmbedDecl then
        AEmbeds.Add(LChild);
        AFroms.Add(AFrom);
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
end;

// The embeds an EmbedMemberOf entry AEntry is reached through, outermost first, into
// APath (emptied first): the entry's own embed last, each one before it the embed whose
// type declares the next
routine DoEmbedPathOf(const AEmbeds: NodeList; const AFroms: NodeList;
  const AEntry: int64; var APath: NodeList);
var
  LInner: NodeList;
  LAt: int64;
  LI: int64;
begin
  APath.Clear();
  LAt := AEntry;
  while LAt >= 0 do
    LInner.Add(AEmbeds.Items[LAt]);
    LAt := AFroms.Items[LAt];
  end;
  // LInner holds the path innermost first
  for LI := LInner.Count - 1 downto 0 do
    APath.Add(LInner.Items[LI]);
  end;
end;

// The member AName an object or record AType reaches through its embeds (BNF sec 4: an
// embed's members are reached as the object's own). The embeds of every level of AType's
// chain are depth 1, the embeds of every level of their types' chains depth 2, and so
// on: the nearest depth that reaches the name decides it. The member in AMember; APath
// the embeds it is reached through, outermost first (Items[0] an embed of AType's chain,
// each next one an embed of the chain of the type before it); ASecond a second path at
// that depth (empty when one path reaches the name: two paths are SM0370 at the use).
// False when no embed holds AName. A member AType's chain declares itself is MemberOf's
// and wins. A type expanded at a nearer depth is not expanded again (what it reaches
// further is reached nearer through its first visit); two embeds of one type at one depth
// are both expanded, so a name both reach stays two paths
public routine EmbedMemberOf(const ATree: ref SyntaxTree; const AType: int64;
  const AName: string; var AMember: int64; var APath: NodeList; var ASecond: NodeList): bool;
var
  LEmbeds: NodeList;
  LFroms: NodeList;
  LExpanded: ref Int64Map;
  LStart: int64;
  LEnd: int64;
  LDepth: int64;
  LI: int64;
  LHit: int64;
  LFound: int64;
  LType: int64;
begin
  AMember := 0;
  APath.Clear();
  ASecond.Clear();
  // Every entry: an embed (LEmbeds) and the entry it was reached from (LFroms); the
  // entries of one depth are a run, the next depth's run follows it
  LExpanded := ref Int64Map(0);
  DoChainEmbeds(ATree, AType, -1, LEmbeds, LFroms);
  LExpanded.Put(AType, 1);
  LStart := 0;
  LDepth := 1;
  while (LStart < LEmbeds.Count) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LEnd := LEmbeds.Count;
    LHit := -1;
    for LI := LStart to LEnd - 1 do
      LFound := MemberOf(ATree, CanonicalOf(ATree, ATree.FirstOf(LEmbeds.Items[LI], NodeRole.TypeOf)), AName);
      if LFound <> 0 then
        if LHit < 0 then
          LHit := LI;
          AMember := LFound;
        else
          if ASecond.Count = 0 then
            DoEmbedPathOf(LEmbeds, LFroms, LI, ASecond);
          end;
        end;
      end;
    end;
    if LHit >= 0 then
      DoEmbedPathOf(LEmbeds, LFroms, LHit, APath);
      return true;
    end;
    // The next depth: the embeds of the chains of this depth's types, each type expanded
    // at one depth only (marked once the whole depth is expanded)
    for LI := LStart to LEnd - 1 do
      LType := CanonicalOf(ATree, ATree.FirstOf(LEmbeds.Items[LI], NodeRole.TypeOf));
      if (LType <> 0) and (LExpanded.Find(LType) = 0) then
        DoChainEmbeds(ATree, LType, LI, LEmbeds, LFroms);
      end;
    end;
    for LI := LStart to LEnd - 1 do
      LType := CanonicalOf(ATree, ATree.FirstOf(LEmbeds.Items[LI], NodeRole.TypeOf));
      if LType <> 0 then
        LExpanded.Put(LType, 1);
      end;
    end;
    LStart := LEnd;
    LDepth := LDepth + 1;
  end;
  return false;
end;

// The write accessor the property AProperty runs: its own, or for an override that
// restates its read only the write of the virtual property it overrides, the nearest level
// up that has one (BNF sec 4 property decl: the base's write runs); 0 when it has none
public routine PropertyWriteOf(const ATree: ref SyntaxTree; const AProperty: int64): int64;
var
  LAt: int64;
  LWrite: int64;
  LDepth: int64;
  LOwner: int64;
  LParent: int64;
begin
  LAt := AProperty;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LWrite := ATree.FirstOf(LAt, NodeRole.Write);
    if (LWrite <> 0) or (not ATree[LAt].HasFlag(NodeFlag.Override)) then
      return LWrite;
    end;
    // the member's declaring type: its body's TypeDecl
    LOwner := ATree.ParentOf(ATree.ParentOf(LAt));
    if (LOwner = 0) or (ATree[LOwner].Kind <> NodeKind.TypeDecl) then
      return 0;
    end;
    LParent := ParentTypeOf(ATree, DeclaredTypeOf(ATree, LOwner));
    if LParent = 0 then
      return 0;
    end;
    LAt := MemberOf(ATree, LParent, ATree[AProperty].Text);
    if (LAt <> 0) and (ATree[LAt].Kind <> NodeKind.PropertyDecl) then
      return 0;
    end;
    LDepth := LDepth + 1;
  end;
  return 0;
end;

// The abstract accessor of the property AProperty: its read when that is abstract, else
// its write when that is (an override's inherited write too: PropertyWriteOf); 0 when
// neither is
public routine AbstractAccessorOf(const ATree: ref SyntaxTree; const AProperty: int64): int64;
var
  LRead: int64;
  LWrite: int64;
begin
  LRead := ATree.FirstOf(AProperty, NodeRole.Read);
  if (LRead <> 0) and ATree[LRead].HasFlag(NodeFlag.Abstract) then
    return LRead;
  end;
  LWrite := PropertyWriteOf(ATree, AProperty);
  if (LWrite <> 0) and ATree[LWrite].HasFlag(NodeFlag.Abstract) then
    return LWrite;
  end;
  return 0;
end;

// True when the property AProperty has an abstract read or write accessor
// (AbstractAccessorOf)
public routine HasAbstractAccessor(const ATree: ref SyntaxTree; const AProperty: int64): bool;
begin
  return AbstractAccessorOf(ATree, AProperty) <> 0;
end;

// The first abstract method, or property with an abstract accessor, of the object type
// AType or a level above that no level at or below it declares again; 0 when it has none
// (it can be built)
public routine AbstractMemberOf(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LChild: int64;
begin
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return 0;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Member) - 1 do
      LChild := ATree.NthOf(LBody, NodeRole.Member, LI);
      // The nearest declaration of the name (MemberOf searches AType first) is this
      // abstract one: nothing below it gave a body
      if (ATree[LChild].Kind = NodeKind.MethodDecl) and ATree[LChild].HasFlag(NodeFlag.Abstract) and
        (MemberOf(ATree, AType, ATree[LChild].Text) = LChild) then
        return LChild;
      end;
      if (ATree[LChild].Kind = NodeKind.PropertyDecl) and
        (MemberOf(ATree, AType, ATree[LChild].Text) = LChild) and
        (HasAbstractAccessor(ATree, LChild)) then
        return LChild;
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return 0;
end;

// True when the declared type AType (or a parent of it) declares an operator spelled
// AText
public routine DeclaresOperator(const ATree: ref SyntaxTree; const AType: int64;
  const AText: string): bool;
var
  LAt: int64;
  LDepth: int64;
  LBody: int64;
  LI: int64;
  LChild: int64;
begin
  LAt := AType;
  LDepth := 0;
  while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
    LBody := BodyOf(ATree, LAt);
    if LBody = 0 then
      return false;
    end;
    for LI := 0 to ATree.CountOf(LBody, NodeRole.Member) - 1 do
      LChild := ATree.NthOf(LBody, NodeRole.Member, LI);
      if (ATree[LChild].Kind = NodeKind.OperatorDecl) and (ATree[LChild].Text = AText) then
        return true;
      end;
    end;
    LAt := ParentTypeOf(ATree, LAt);
    LDepth := LDepth + 1;
  end;
  return false;
end;

// The element type of the set type ASet written as `set of T`; 0 for a range set (its
// bounds' type is the element type: Semantics types them) and for any other type
public routine SetElementOf(const ATree: ref SyntaxTree; const ASet: int64): int64;
var
  LBody: int64;
begin
  LBody := BodyOf(ATree, ASet);
  if (LBody = 0) or (ATree[LBody].Kind <> NodeKind.SetType) then
    return 0;
  end;
  return CanonicalOf(ATree, ATree.FirstOf(LBody, NodeRole.Element));
end;

// The type a member of the set type ASet has: `set of T`'s T (SetElementOf), a range
// set's bounds' type (Semantics types every set range's bounds before anything else);
// 0 for any other type and before the bounds are typed
public routine SetMemberOf(const ATree: ref SyntaxTree; const ASet: int64): int64;
var
  LElement: int64;
  LBody: int64;
  LLow: int64;
begin
  LElement := SetElementOf(ATree, ASet);
  if LElement <> 0 then
    return LElement;
  end;
  LBody := BodyOf(ATree, ASet);
  if (LBody = 0) or (ATree[LBody].Kind <> NodeKind.SetType) then
    return 0;
  end;
  // a bound's ResolvedType is already a canonical type (the expression's), never a type
  // expression for CanonicalOf
  LLow := ATree.FirstOf(LBody, NodeRole.LowBound);
  if LLow = 0 then
    return 0;
  end;
  return ATree[LLow].ResolvedType;
end;

// The integer types below int32 promote to int32 (C++'s integer promotion); any other
// type stays
public routine Promoted(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LBits: int64;
begin
  LBits := IntBits(ATree, AType);
  if (LBits > 0) and (LBits < 32) then
    return BuiltinType(ATree, "int32");
  end;
  return AType;
end;

// C's integer conversion rank of the integer builtin AType: int8 1, int16 2, int32 3,
// clong 4, int64 5 (C's long long), each unsigned one as its signed one; 0 for any other
// type. clong ranks between int32 and int64 whatever its width on the target
routine DoIntRank(const ATree: ref SyntaxTree; const AType: int64): int64;
var
  LName: string;
begin
  if IntBits(ATree, AType) = 0 then
    return 0;
  end;
  LName := ATree[AType].Text;
  if (LName = "int8") or (LName = "uint8") then
    return 1;
  end;
  if (LName = "int16") or (LName = "uint16") then
    return 2;
  end;
  if (LName = "int32") or (LName = "uint32") then
    return 3;
  end;
  if (LName = "clong") or (LName = "culong") then
    return 4;
  end;
  return 5;
end;

// The unsigned builtin of the signed integer builtin ASigned's rank (C's corresponding
// unsigned type): uint32 for int32, culong for clong, uint64 for int64
routine DoUnsignedOf(const ATree: ref SyntaxTree; const ASigned: int64): int64;
var
  LName: string;
begin
  LName := ATree[ASigned].Text;
  if LName = "int32" then
    return BuiltinType(ATree, "uint32");
  end;
  if LName = "clong" then
    return BuiltinType(ATree, "culong");
  end;
  return BuiltinType(ATree, "uint64");
end;

// The type two arithmetic operands of types AFirst and ASecond meet at (the usual
// arithmetic conversions, BNF sec 6, by C's integer rank): a float when either is one
// (float64 when either is float64), else the promoted integers: the same type, the higher
// rank of one signedness; of mixed signedness the unsigned one when its rank is at least
// the signed one's, else the signed one when it is wider, else the signed one's unsigned
// type (C's rule: on a target where clong is 64 bits, clong and uint64 meet at uint64)
public routine CommonArithmetic(const ATree: ref SyntaxTree; const AFirst: int64;
  const ASecond: int64): int64;
var
  LA: int64;
  LB: int64;
  LClassA: TypeClass;
  LClassB: TypeClass;
  LUnsigned: int64;
  LSigned: int64;
begin
  if (FloatBits(ATree, AFirst) = 64) or (FloatBits(ATree, ASecond) = 64) then
    return BuiltinType(ATree, "float64");
  end;
  if (FloatBits(ATree, AFirst) = 32) or (FloatBits(ATree, ASecond) = 32) then
    return BuiltinType(ATree, "float32");
  end;
  LA := Promoted(ATree, AFirst);
  LB := Promoted(ATree, ASecond);
  if LA = LB then
    return LA;
  end;
  LClassA := ClassOf(ATree, LA);
  LClassB := ClassOf(ATree, LB);
  if LClassA = LClassB then
    if DoIntRank(ATree, LA) >= DoIntRank(ATree, LB) then
      return LA;
    end;
    return LB;
  end;
  // One signed, one unsigned
  if LClassA = TypeClass.UnsignedInt then
    LUnsigned := LA;
    LSigned := LB;
  else
    LUnsigned := LB;
    LSigned := LA;
  end;
  if DoIntRank(ATree, LUnsigned) >= DoIntRank(ATree, LSigned) then
    return LUnsigned;
  end;
  if IntBits(ATree, LSigned) > IntBits(ATree, LUnsigned) then
    return LSigned;
  end;
  return DoUnsignedOf(ATree, LSigned);
end;

// True when the owner AFrom (of class AFromClass) converts to the owner ATo (BNF sec 4,
// owner type): an own to an own, and to a ref, of its object or of a polymorphic ancestor
// (the owner frees it through that ancestor); a ref to a ref, and to a weak, of its object
// or of any ancestor. Nothing else: a weak reaches a ref only through lock(W)
routine DoOwnerConverts(const ATree: ref SyntaxTree; const AFrom: int64;
  const AFromClass: TypeClass; const ATo: int64; const AToClass: TypeClass): bool;
var
  LFromTarget: int64;
  LToTarget: int64;
begin
  LFromTarget := TargetOf(ATree, AFrom);
  LToTarget := TargetOf(ATree, ATo);
  if AFromClass = TypeClass.OwnType then
    if (AToClass <> TypeClass.OwnType) and (AToClass <> TypeClass.RefType) then
      return false;
    end;
    if LFromTarget = LToTarget then
      return true;
    end;
    return IsAncestorOf(ATree, LToTarget, LFromTarget) and IsPolymorphic(ATree, LToTarget);
  end;
  if AFromClass = TypeClass.RefType then
    if (AToClass <> TypeClass.RefType) and (AToClass <> TypeClass.WeakType) then
      return false;
    end;
    return ReachesAs(ATree, LFromTarget, LToTarget);
  end;
  return false;
end;

// True when a value of AFrom converts to ATo with no cast (BNF sec 6, no hidden
// conversions): integer widening (an unsigned to a wider signed), an integer to a float
// that holds every value (16 bits to float32, 32 to float64), float32 to float64, nil to
// a pointer, owner, routine or interface type, any pointer to the untyped ptr to const
// (M9h0), a ptr to T to a ptr to const T, to the
// untyped ptr (not from a ptr to const) and to a ptr to an ancestor of T (a base, a
// parent, an interface it implements), a record to its base, an object that is not
// polymorphic to its parent, an owner as DoOwnerConverts says. The same type, or an
// unknown one (0, already reported), converts
public routine ConvertsImplicitly(const ATree: ref SyntaxTree; const AFrom: int64;
  const ATo: int64): bool;
var
  LFrom: TypeClass;
  LTo: TypeClass;
  LFromTarget: int64;
  LToTarget: int64;
begin
  if (AFrom = ATo) or (AFrom = 0) or (ATo = 0) then
    return true;
  end;
  LFrom := ClassOf(ATree, AFrom);
  LTo := ClassOf(ATree, ATo);
  if IsIntegerClass(LFrom) and IsIntegerClass(LTo) then
    if LFrom = LTo then
      return IntBits(ATree, ATo) >= IntBits(ATree, AFrom);
    end;
    if (LFrom = TypeClass.UnsignedInt) and (LTo = TypeClass.SignedInt) then
      return IntBits(ATree, ATo) > IntBits(ATree, AFrom);
    end;
    return false;
  end;
  if IsIntegerClass(LFrom) and (LTo = TypeClass.Float) then
    if FloatBits(ATree, ATo) = 64 then
      return IntBits(ATree, AFrom) <= 32;
    end;
    return IntBits(ATree, AFrom) <= 16;
  end;
  if (LFrom = TypeClass.Float) and (LTo = TypeClass.Float) then
    return FloatBits(ATree, AFrom) <= FloatBits(ATree, ATo);
  end;
  if LFrom = TypeClass.NilType then
    return (LTo = TypeClass.Pointer) or (LTo = TypeClass.UntypedPointer) or
      (LTo = TypeClass.OwnType) or (LTo = TypeClass.RefType) or (LTo = TypeClass.WeakType) or
      (LTo = TypeClass.RoutineType) or (LTo = TypeClass.InterfaceType) or (LTo = TypeClass.TaskType);
  end;
  // the untyped ptr to const (M9h0) takes every pointer; the untyped ptr none of const
  if (LTo = TypeClass.UntypedPointer) and IsConstTarget(ATree, ATo) then
    return (LFrom = TypeClass.Pointer) or (LFrom = TypeClass.UntypedPointer);
  end;
  if (LFrom = TypeClass.Pointer) and (LTo = TypeClass.UntypedPointer) then
    return not IsConstTarget(ATree, AFrom);
  end;
  if (LFrom = TypeClass.Pointer) and (LTo = TypeClass.Pointer) then
    if IsConstTarget(ATree, AFrom) and (not IsConstTarget(ATree, ATo)) then
      return false;
    end;
    LFromTarget := TargetOf(ATree, AFrom);
    LToTarget := TargetOf(ATree, ATo);
    return ReachesAs(ATree, LFromTarget, LToTarget);
  end;
  if (LFrom = TypeClass.RecordType) and (LTo = TypeClass.RecordType) then
    return IsBaseOf(ATree, ATo, AFrom);
  end;
  if (LFrom = TypeClass.ObjectType) and (LTo = TypeClass.ObjectType) then
    // A polymorphic object never reaches its parent by value (it would be cut down:
    // SM0428, which Semantics reports in place of SM0200)
    return IsBaseOf(ATree, ATo, AFrom) and (not IsPolymorphic(ATree, AFrom));
  end;
  return DoOwnerConverts(ATree, AFrom, LFrom, ATo, LTo);
end;

// The spelling of a bound or other small constant expression in a type's text: a
// literal, a name, a dotted name, a signed one; "..." for anything longer
routine DoBoundText(const ATree: ref SyntaxTree; const AExpr: int64): string;
var
  LKind: NodeKind;
begin
  if AExpr = 0 then
    return "...";
  end;
  LKind := ATree[AExpr].Kind;
  if (LKind = NodeKind.IntLiteral) or (LKind = NodeKind.CharLiteral) or
    (LKind = NodeKind.NameExpression) then
    return ATree[AExpr].Text;
  end;
  if LKind = NodeKind.MemberExpression then
    return DoBoundText(ATree, ATree.FirstOf(AExpr, NodeRole.Operand)) + "." + ATree[AExpr].Text;
  end;
  if LKind = NodeKind.UnaryExpression then
    return ATree[AExpr].Text + DoBoundText(ATree, ATree.FirstOf(AExpr, NodeRole.Operand));
  end;
  return "...";
end;

forward routine DoTypeText(const ATree: ref SyntaxTree; const AType: int64; const ADepth: int64): string;

// The text of the routine signature ASig: routine [clink|cpplink](params)[: return]; cpplink
// whenever it has C++ linkage (IsCppSignature: an overload too), clink only as written
routine DoRoutineText(const ATree: ref SyntaxTree; const ASig: int64; const ADepth: int64): string;
var
  LText: string;
  LI: int64;
  LParam: int64;
  LReturn: int64;
begin
  LText := "routine";
  if IsCppSignature(ATree, ASig) then
    LText := LText + " cpplink";
  else
    if ATree[ASig].HasFlag(NodeFlag.Clink) then
      LText := LText + " clink";
    end;
  end;
  LText := LText + "(";
  for LI := 0 to ATree.CountOf(ASig, NodeRole.Param) - 1 do
    LParam := ATree.NthOf(ASig, NodeRole.Param, LI);
    if LI > 0 then
      LText := LText + "; ";
    end;
    if ATree[LParam].HasFlag(NodeFlag.VarParam) then
      LText := LText + "var ";
    end;
    if ATree[LParam].HasFlag(NodeFlag.ConstParam) then
      LText := LText + "const ";
    end;
    LText := LText + DoTypeText(ATree, CanonicalOf(ATree, ATree.FirstOf(LParam, NodeRole.TypeOf)),
      ADepth + 1);
  end;
  if ATree[ASig].HasFlag(NodeFlag.Variadic) then
    if ATree.CountOf(ASig, NodeRole.Param) > 0 then
      LText := LText + "; ";
    end;
    LText := LText + "...";
  end;
  LText := LText + ")";
  LReturn := ATree.FirstOf(ASig, NodeRole.ReturnType);
  if LReturn <> 0 then
    LText := LText + ": " + DoTypeText(ATree, CanonicalOf(ATree, LReturn), ADepth + 1);
  end;
  return LText;
end;

// The generic instance AInstance as its type is written: the generic's name, then its
// type arguments in <> (Pair<int32, string>)
routine DoInstanceText(const ATree: ref SyntaxTree; const AInstance: int64; const ADepth: int64): string;
var
  LText: string;
  LI: int64;
begin
  LText := ATree[ATree.FirstOf(AInstance, NodeRole.Instance)].Text + "<";
  if ADepth > ADAM_TYPES_INSTANCE_TEXT_DEPTH then
    return LText + "...>";
  end;
  for LI := 0 to ATree.CountOf(AInstance, NodeRole.GenericParam) - 1 do
    if LI > 0 then
      LText := LText + ", ";
    end;
    LText := LText + DoTypeText(ATree,
      ATree[ATree.NthOf(AInstance, NodeRole.GenericParam, LI)].ResolvedType, ADepth + 1);
  end;
  return LText + ">";
end;

// The text of AType as a message writes it (see TypeText)
routine DoTypeText(const ATree: ref SyntaxTree; const AType: int64; const ADepth: int64): string;
var
  LKind: NodeKind;
  LOver: string;
  LSource: int64;
begin
  if AType = 0 then
    return "?";
  end;
  if ADepth > ADAM_TYPES_MAX_DEPTH then
    return "...";
  end;
  LKind := ATree[AType].Kind;
  if (LKind = NodeKind.TypeDecl) and (InstanceOf(ATree, AType) <> 0) then
    return DoInstanceText(ATree, InstanceOf(ATree, AType), ADepth);
  end;
  if (LKind = NodeKind.BuiltinTypeDecl) or (LKind = NodeKind.TypeDecl) or
    (LKind = NodeKind.GenericParam) then
    return ATree[AType].Text;
  end;
  if ATree.ParentOf(AType) <> ADAM_AST_DERIVED then
    return "?";
  end;
  LSource := ATree[AType].ResolvedDecl;
  if LKind = NodeKind.NilLiteral then
    return "nil";
  end;
  if LKind = NodeKind.RoutineType then
    return DoRoutineText(ATree, LSource, ADepth + 1);
  end;
  if (LKind = NodeKind.TaskType) and (ATree[AType].ResolvedType = 0) then
    return "task";
  end;
  if (LKind = NodeKind.PointerType) and (ATree[AType].ResolvedType = 0) then
    return "ptr to const";
  end;
  LOver := DoTypeText(ATree, ATree[AType].ResolvedType, ADepth + 1);
  if LKind = NodeKind.TaskType then
    return "task " + LOver;
  end;
  if LKind = NodeKind.SequenceType then
    return "sequence of " + LOver;
  end;
  if LKind = NodeKind.PointerType then
    if IsConstTarget(ATree, AType) then
      return "ptr to const " + LOver;
    end;
    return "ptr to " + LOver;
  end;
  if LKind = NodeKind.OwnType then
    return "own " + LOver;
  end;
  if LKind = NodeKind.RefType then
    return "ref " + LOver;
  end;
  if LKind = NodeKind.WeakType then
    return "weak " + LOver;
  end;
  if ClassOf(ATree, AType) = TypeClass.DynamicArray then
    return "array of " + LOver;
  end;
  if ClassOf(ATree, AType) = TypeClass.FlexibleArray then
    return "array[0..] of " + LOver;
  end;
  return "array[" + DoBoundText(ATree, ATree.FirstOf(LSource, NodeRole.LowBound)) + ".." +
    DoBoundText(ATree, ATree.FirstOf(LSource, NodeRole.HighBound)) + "] of " + LOver;
end;

// True when the type AType holds a part no name resolved (0, or a type whose text is "?":
// DoTypeText), as a declaration that reported a fault (SM0003) leaves it, through a
// pointer, an own / ref / weak, an array, a task or a routine type's parameters and result
routine DoHasUnknown(const ATree: ref SyntaxTree; const AType: int64; const ADepth: int64): bool;
var
  LKind: NodeKind;
  LSig: int64;
  LI: int64;
  LReturn: int64;
begin
  if AType = 0 then
    return true;
  end;
  if ADepth > ADAM_TYPES_MAX_DEPTH then
    return false;
  end;
  LKind := ATree[AType].Kind;
  if (LKind = NodeKind.BuiltinTypeDecl) or (LKind = NodeKind.TypeDecl) or
    (LKind = NodeKind.NilLiteral) then
    return false;
  end;
  if ATree.ParentOf(AType) <> ADAM_AST_DERIVED then
    return true;
  end;
  if LKind = NodeKind.RoutineType then
    LSig := ATree[AType].ResolvedDecl;
    for LI := 0 to ATree.CountOf(LSig, NodeRole.Param) - 1 do
      if DoHasUnknown(ATree, CanonicalOf(ATree, ATree.FirstOf(ATree.NthOf(LSig, NodeRole.Param, LI),
        NodeRole.TypeOf)), ADepth + 1) then
        return true;
      end;
    end;
    LReturn := ATree.FirstOf(LSig, NodeRole.ReturnType);
    return (LReturn <> 0) and DoHasUnknown(ATree, CanonicalOf(ATree, LReturn), ADepth + 1);
  end;
  if (LKind = NodeKind.TaskType) and (ATree[AType].ResolvedType = 0) then
    return false;
  end;
  // `ptr to const` (M9h0) is over no type, and whole
  if (LKind = NodeKind.PointerType) and (ATree[AType].ResolvedType = 0) then
    return false;
  end;
  return DoHasUnknown(ATree, ATree[AType].ResolvedType, ADepth + 1);
end;

// True when AType holds a part no name resolved (DoHasUnknown): a fault reported where the
// type is written, so nothing judges a conversion to or from it again
public routine HasUnknownPart(const ATree: ref SyntaxTree; const AType: int64): bool;
begin
  return DoHasUnknown(ATree, AType, 0);
end;

// The text of AType as a message writes it: a builtin's or a declared type's name, ptr to
// [const] T, array of T, array[lo..hi] of T, own / ref / weak T, routine(...): R, nil;
// "?" for an unknown type
public routine TypeText(const ATree: ref SyntaxTree; const AType: int64): string;
begin
  return DoTypeText(ATree, AType, 0);
end;

// The text of the generic instance AInstance (a GenericInstance of a type, a routine or a
// method, BNF sec 10) as a message writes it: Name<A, B> (nested instances past
// ADAM_TYPES_INSTANCE_TEXT_DEPTH as <...>)
public routine InstanceText(const ATree: ref SyntaxTree; const AInstance: int64): string;
begin
  return DoInstanceText(ATree, AInstance, 0);
end;

// How print / println writes a value of the canonical type AType (PaskalCPP's
// TPCTypeExpr.PrintForm, the one rule; SEM's SM0425 and SM0502, Lowering's forms): a
// pointer by its target (to char: its C string, CText; to wchar: its C string as UTF-8,
// WideCText; any other, and an untyped one, its address); a wchar (WideChar) and a wstring
// (WideText) as UTF-8; a routine value its address; a choices value its name; a set and a
// static or dynamic array element by element (Range, unprintable when its element is); a
// record, object, overlay or owner unprintable (print its fields); every other builtin as
// itself. An unknown type (0, an error already reported) is Unknown
public routine PrintFormOf(const ATree: ref SyntaxTree; const AType: int64): PrintForm;
var
  LClass: TypeClass;
  LTarget: TypeClass;
begin
  LClass := ClassOf(ATree, AType);
  match LClass of
    TypeClass.SignedInt, TypeClass.UnsignedInt: return PrintForm.Integer;
    TypeClass.Boolean: return PrintForm.Boolean;
    TypeClass.Char: return PrintForm.Char;
    TypeClass.Float: return PrintForm.Float;
    TypeClass.Text: return PrintForm.Text;
    TypeClass.WideText: return PrintForm.WideText;
    TypeClass.WideChar: return PrintForm.WideChar;
    TypeClass.UntypedPointer, TypeClass.NilType, TypeClass.RoutineType: return PrintForm.Address;
    TypeClass.ChoicesType: return PrintForm.Choice;
    TypeClass.RecordType, TypeClass.ObjectType, TypeClass.InterfaceType, TypeClass.OverlayType,
      TypeClass.OwnType, TypeClass.RefType, TypeClass.WeakType, TypeClass.TaskType,
      TypeClass.SequenceType, TypeClass.Mutex, TypeClass.Varargs:
      return PrintForm.Unprintable;
  else
    // the classes below look at what the type is made over
  end;
  if LClass = TypeClass.Pointer then
    LTarget := ClassOf(ATree, TargetOf(ATree, AType));
    if LTarget = TypeClass.Char then
      return PrintForm.CText;
    end;
    if LTarget = TypeClass.WideChar then
      return PrintForm.WideCText;
    end;
    return PrintForm.Address;
  end;
  if (LClass = TypeClass.StaticArray) or (LClass = TypeClass.DynamicArray) then
    if PrintFormOf(ATree, TargetOf(ATree, AType)) = PrintForm.Unprintable then
      return PrintForm.Unprintable;
    end;
    return PrintForm.Range;
  end;
  if LClass = TypeClass.SetType then
    return PrintForm.Range;
  end;
  return PrintForm.Unknown;
end;

end.
