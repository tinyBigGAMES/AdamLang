-------------------------------------------------------------------------------
  Adam.Opt.Dce.adam - aggressive dead code elimination (PLAN-ADAM M6 O6)

  RemoveDeadCode is ADCE over one function in SSA form, in the control
  dependence form of Cytron, Ferrante, Rosen, Wegman and Zadeck: nothing is
  live until a root makes it so. A live instruction makes live its operands
  and its block; a live block makes live the terminator of every block it is
  control dependent on (the blocks whose branch decides whether it runs: the
  reverse graph's dominance frontier, walked up Adam.Opt.Analysis's
  post-dominators); a live phi makes live the terminator of each block it
  takes a value from. One worklist runs it to the fixed point.

  The roots are what the program does beyond computing values:
    - stores, copies, fills, every call (direct, external, indirect: a
      check's raise is a call), the atomics, ret, the parameters
    - a division that may fault: sdiv / udiv / srem / urem whose divisor is
      not a constant known not to (zero; -1 for a signed one, as the lowest
      value by -1 overflows): it stays and faults where the debug one does,
      as sccp leaves it
    - a load whose address the function does not know is valid (a slot's, a
      data blob's or a threadstatic's address, or one of them moved by a
      constant): a load that may fault stays
    - a slot a funclet reaches (a user in another function: it runs in this
      frame)
    - the terminator of a block that reaches no exit or whose post-dominator
      is the virtual exit, and of every block that leaves a loop: a loop is
      never removed, so a program that would run forever still does (O12's
      trip counts may prove one finite)
    - every instruction of a block the entry does not reach (sccp has
      emptied those to a bare ret; they stay as they are for O7)
  The unwind edges are edges of the graph the post-dominators are made over,
  so a block a raise may resume at is control dependent on the blocks that
  may raise into it.

  The function is then rewritten: each reached block keeps its live
  instructions in their order, and its terminator; a branch nothing live
  depends on becomes a jump to its block's nearest live post-dominator. The
  blocks it skipped are left unreached for O7 to drop: none of them gives a
  value to a phi that stays (that phi would have made the branch live), and
  a live phi always has a value for the jump's block (raised otherwise: a
  compiler bug). Blocks stay where they are (scope ranges name blocks by
  position).
*******************************************************************************/

module unit Adam.Opt.Dce;

import System.SysUtils, Adam.Core.Containers, Adam.Backend.Ssa, Adam.Opt.Analysis;

const
  // An instruction's mark in the live map: not live (the map's missing value), live
  ADAM_DCE_DEAD: int64 = 0;
  ADAM_DCE_LIVE: int64 = 1;
  // Raised (an invariant broken) by a dead branch whose block has no live
  // post-dominator, and by a jump made to a block whose live phi has no value for it
  ADAM_DCE_FAULT_NO_LIVE_POSTDOM: string = "Opt: adce found no live post-dominator of b";
  ADAM_DCE_FAULT_PHI_EDGE: string = "Opt: adce made a jump a live phi has no value for: b";

type
  // One list of block positions per block
  PositionLists = array of ref Int64List;

  // One function's dead code removal (see the header)
  DeadCodeRemover = object
    hidden FModule: ref IrModule;
    hidden FFunctionId: int64;
    hidden FAnalysis: ref FunctionAnalysis;
    hidden FCount: int64;
    // Each own instruction's block position (ADAM_OPT_NO_BLOCK: another function's)
    hidden FPositionOf: ref Int64Map;
    // Each instruction's mark, each block's liveness, the blocks each block is control
    // dependent on, the blocks whose terminator is a root, and the live values whose
    // operands are still to mark
    hidden FLive: ref Int64Map;
    hidden FLiveBlock: BoolArray;
    hidden FDeps: PositionLists;
    hidden FKeep: BoolArray;
    hidden FWork: ref Int64List;

    // The removal of AModule's function AFunction, AAnalysis its facts
    init(const AModule: ref IrModule; const AFunction: int64;
      const AAnalysis: ref FunctionAnalysis);
    begin
      self.FModule := AModule;
      self.FFunctionId := AFunction;
      self.FAnalysis := AAnalysis;
      self.FCount := AAnalysis.BlockCount;
      self.FPositionOf := ref Int64Map(ADAM_OPT_NO_BLOCK);
      self.FLive := ref Int64Map(ADAM_DCE_DEAD);
      self.FWork := ref Int64List();
      setlength(self.FLiveBlock, self.FCount);
      setlength(self.FDeps, self.FCount);
      setlength(self.FKeep, self.FCount);
    end;

    // Every own instruction's position; every block dead, depending on none, no root
    hidden method DoIndex();
    var
      LBlock: ref IrBlock;
      LI: int64;
      LK: int64;
    begin
      for LI := 0 to self.FCount - 1 do
        LBlock := self.FModule.BlockAt(self.FAnalysis.BlockAt(LI));
        for LK := 0 to LBlock.Instrs.Count - 1 do
          self.FPositionOf.Put(LBlock.Instrs[LK], LI);
        end;
        self.FLiveBlock[LI] := false;
        self.FDeps[LI] := ref Int64List();
        self.FKeep[LI] := false;
      end;
    end;

    // The terminator of the block at APosition (-1: it ends in none)
    hidden const method DoTerminatorOf(const APosition: int64): int64;
    var
      LBlock: ref IrBlock;
      LLast: int64;
    begin
      LBlock := self.FModule.BlockAt(self.FAnalysis.BlockAt(APosition));
      if LBlock.Instrs.Count = 0 then
        return -1;
      end;
      LLast := LBlock.Instrs[LBlock.Instrs.Count - 1];
      if not IsTerminator(self.FModule.InstrAt(LLast).Kind) then
        return -1;
      end;
      return LLast;
    end;

    // Each reached block's control dependences: for every edge A -> S, the blocks from S
    // up the post-dominators to A's ipdom (not it) depend on A (Ferrante, Ottenstein and
    // Warren); a block that reaches no exit ends its walk (its ipdom is none)
    hidden method DoControlDependence();
    var
      LSuccs: ref Int64List;
      LStop: int64;
      LRunner: int64;
      LA: int64;
      LK: int64;
    begin
      for LA := 0 to self.FCount - 1 do
        if self.FAnalysis.Reachable(LA) then
          LStop := self.FAnalysis.Ipdom(LA);
          LSuccs := self.FAnalysis.SuccsOf(LA);
          for LK := 0 to LSuccs.Count - 1 do
            LRunner := LSuccs[LK];
            while (LRunner >= 0) and (LRunner <> LStop) do
              if self.FDeps[LRunner].IndexOf(LA) < 0 then
                self.FDeps[LRunner].Add(LA);
              end;
              LRunner := self.FAnalysis.Ipdom(LRunner);
            end;
          end;
        end;
      end;
    end;

    // The blocks whose terminator is a root (see the header): one whose ipdom is the
    // virtual exit or none, and one with a target outside a loop it is in
    hidden method DoKeptControl();
    var
      LBody: ref Int64List;
      LTerminator: ref IrInstr;
      LTerm: int64;
      LTarget: int64;
      LPosition: int64;
      LI: int64;
      LL: int64;
      LK: int64;
    begin
      for LI := 0 to self.FCount - 1 do
        if self.FAnalysis.Reachable(LI) and (self.FAnalysis.Ipdom(LI) < 0) then
          self.FKeep[LI] := true;
        end;
      end;
      for LL := 0 to self.FAnalysis.LoopCount() - 1 do
        LBody := self.FAnalysis.LoopBlocks(LL);
        for LI := 0 to LBody.Count - 1 do
          LPosition := LBody[LI];
          LTerm := self.DoTerminatorOf(LPosition);
          if LTerm >= 0 then
            LTerminator := self.FModule.InstrAt(LTerm);
            for LK := 0 to LTerminator.Targets.Count - 1 do
              LTarget := self.FAnalysis.PositionOf(LTerminator.Targets[LK]);
              if LBody.IndexOf(LTarget) < 0 then
                self.FKeep[LPosition] := true;
              end;
            end;
          end;
        end;
      end;
    end;

    // True when the address AId is one the function knows is valid: a slot's, a data
    // blob's or a threadstatic's, or one of them moved by a constant
    hidden const method DoValidAddress(const AId: int64): bool;
    var
      LInstr: ref IrInstr;
    begin
      LInstr := self.FModule.InstrAt(AId);
      if LInstr.Kind = IrOp.Offset then
        if self.FModule.InstrAt(LInstr.Operands[1]).Kind <> IrOp.Constant then
          return false;
        end;
        LInstr := self.FModule.InstrAt(LInstr.Operands[0]);
      end;
      return (LInstr.Kind = IrOp.Slot) or (LInstr.Kind = IrOp.Address) or
        (LInstr.Kind = IrOp.ThreadAddress);
    end;

    // True when AInstr may fault (see the header): a division whose divisor is not a
    // constant known not to, a load whose address is not known valid
    hidden const method DoMayFault(const AInstr: ref IrInstr): bool;
    var
      LDivisor: ref IrInstr;
      LSigned: bool;
    begin
      if AInstr.Kind = IrOp.Load then
        return not self.DoValidAddress(AInstr.Operands[0]);
      end;
      LSigned := (AInstr.Kind = IrOp.SDiv) or (AInstr.Kind = IrOp.SRem);
      if (not LSigned) and (AInstr.Kind <> IrOp.UDiv) and (AInstr.Kind <> IrOp.URem) then
        return false;
      end;
      LDivisor := self.FModule.InstrAt(AInstr.Operands[1]);
      if (LDivisor.Kind <> IrOp.Constant) or (LDivisor.Imm = 0) then
        return true;
      end;
      // A constant's Imm is canonical (sign-extended for a signed type): a signed -1 is -1
      return LSigned and (LDivisor.Imm = -1);
    end;

    // True when a user of the value AId is another function's (a funclet's)
    hidden const method DoReachedElsewhere(const AId: int64): bool;
    var
      LUsers: ref Int64List;
      LK: int64;
    begin
      LUsers := self.FAnalysis.UsesOf(AId);
      for LK := 0 to LUsers.Count - 1 do
        if self.FPositionOf.Find(LUsers[LK]) = ADAM_OPT_NO_BLOCK then
          return true;
        end;
      end;
      return false;
    end;

    // True when the instruction AId at APosition is a root (see the header)
    hidden const method DoIsRoot(const AId: int64; const APosition: int64): bool;
    var
      LInstr: ref IrInstr;
      LKind: IrOp;
    begin
      if not self.FAnalysis.Reachable(APosition) then
        return true;
      end;
      LInstr := self.FModule.InstrAt(AId);
      LKind := LInstr.Kind;
      if (LKind = IrOp.Store) or (LKind = IrOp.Copy) or (LKind = IrOp.Fill) or
        (LKind = IrOp.Call) or (LKind = IrOp.CallExternal) or (LKind = IrOp.CallIndirect) or
        (LKind = IrOp.Ret) or (LKind = IrOp.Unreachable) or (LKind = IrOp.Parameter) or
        IsAtomicOp(LKind) then
        return true;
      end;
      if LKind = IrOp.Slot then
        return self.DoReachedElsewhere(AId);
      end;
      if IsTerminator(LKind) then
        return self.FKeep[APosition];
      end;
      return self.DoMayFault(LInstr);
    end;

    // The value AId marked live and queued, unless it is another function's (a parent's
    // slot a funclet reads) or live already
    hidden method DoMark(const AId: int64);
    begin
      if self.FPositionOf.Find(AId) = ADAM_OPT_NO_BLOCK then
        return;
      end;
      if self.FLive.Find(AId) = ADAM_DCE_LIVE then
        return;
      end;
      self.FLive.Put(AId, ADAM_DCE_LIVE);
      self.FWork.Add(AId);
    end;

    // The terminator of the block at APosition marked live
    hidden method DoMarkTerminator(const APosition: int64);
    var
      LTerm: int64;
    begin
      LTerm := self.DoTerminatorOf(APosition);
      if LTerm >= 0 then
        self.DoMark(LTerm);
      end;
    end;

    // The block at APosition live, and so the terminator of each block it depends on
    hidden method DoMarkBlock(const APosition: int64);
    var
      LDeps: ref Int64List;
      LK: int64;
    begin
      if self.FLiveBlock[APosition] then
        return;
      end;
      self.FLiveBlock[APosition] := true;
      LDeps := self.FDeps[APosition];
      for LK := 0 to LDeps.Count - 1 do
        self.DoMarkTerminator(LDeps[LK]);
      end;
    end;

    // The roots marked, then each live value's block, operands and (a phi's) incoming
    // blocks' terminators, until the worklist is empty
    hidden method DoSolve();
    var
      LBlock: ref IrBlock;
      LInstr: ref IrInstr;
      LFrom: int64;
      LId: int64;
      LI: int64;
      LK: int64;
    begin
      for LI := 0 to self.FCount - 1 do
        LBlock := self.FModule.BlockAt(self.FAnalysis.BlockAt(LI));
        for LK := 0 to LBlock.Instrs.Count - 1 do
          if self.DoIsRoot(LBlock.Instrs[LK], LI) then
            self.DoMark(LBlock.Instrs[LK]);
          end;
        end;
      end;
      while self.FWork.Count > 0 do
        LId := self.FWork.RemoveLast();
        LInstr := self.FModule.InstrAt(LId);
        self.DoMarkBlock(self.FPositionOf.Find(LId));
        for LK := 0 to LInstr.Operands.Count - 1 do
          self.DoMark(LInstr.Operands[LK]);
        end;
        if LInstr.Kind = IrOp.Phi then
          for LK := 0 to LInstr.Targets.Count - 1 do
            LFrom := self.FAnalysis.PositionOf(LInstr.Targets[LK]);
            if LFrom <> ADAM_OPT_NO_BLOCK then
              self.DoMarkTerminator(LFrom);
            end;
          end;
        end;
      end;
    end;

    // The nearest live post-dominator of the block at APosition (raised when none: the
    // last block of every post-dominator chain is live, a ret or a kept branch)
    hidden const method DoNearestLive(const APosition: int64): int64;
    var
      LAt: int64;
    begin
      LAt := self.FAnalysis.Ipdom(APosition);
      while LAt >= 0 do
        if self.FLiveBlock[LAt] then
          return LAt;
        end;
        LAt := self.FAnalysis.Ipdom(LAt);
      end;
      raise(ADAM_DCE_FAULT_NO_LIVE_POSTDOM + IntToStr(self.FAnalysis.BlockAt(APosition)));
    end;

    // The dead branch AInstr of the block at APosition made a jump to its nearest live
    // post-dominator (raised when a live phi there has no value for the block)
    hidden method DoMakeJump(const AInstr: ref IrInstr; const APosition: int64);
    var
      LTarget: ref IrBlock;
      LPhi: ref IrInstr;
      LOwn: int64;
      LTo: int64;
      LK: int64;
    begin
      LOwn := self.FAnalysis.BlockAt(APosition);
      LTo := self.FAnalysis.BlockAt(self.DoNearestLive(APosition));
      LTarget := self.FModule.BlockAt(LTo);
      for LK := 0 to LTarget.Instrs.Count - 1 do
        LPhi := self.FModule.InstrAt(LTarget.Instrs[LK]);
        if (LPhi.Kind = IrOp.Phi) and (self.FLive.Find(LTarget.Instrs[LK]) = ADAM_DCE_LIVE) and
          (LPhi.Targets.IndexOf(LOwn) < 0) then
          raise(ADAM_DCE_FAULT_PHI_EDGE + IntToStr(LOwn) + " to b" + IntToStr(LTo));
        end;
      end;
      AInstr.Kind := IrOp.Jump;
      AInstr.Operands := ref Int64List();
      AInstr.Targets := ref Int64List();
      AInstr.Targets.Add(LTo);
    end;

    // Each reached block rewritten (see the header): its live instructions and its
    // terminator kept in their order, a dead branch made a jump; true when anything changed
    hidden method DoRewrite(): bool;
    var
      LBlock: ref IrBlock;
      LInstr: ref IrInstr;
      LKept: ref Int64List;
      LChanged: bool;
      LId: int64;
      LI: int64;
      LK: int64;
    begin
      LChanged := false;
      for LI := 0 to self.FCount - 1 do
        if not self.FAnalysis.Reachable(LI) then
          skip;
        end;
        LBlock := self.FModule.BlockAt(self.FAnalysis.BlockAt(LI));
        LKept := ref Int64List();
        for LK := 0 to LBlock.Instrs.Count - 1 do
          LId := LBlock.Instrs[LK];
          if self.FLive.Find(LId) = ADAM_DCE_LIVE then
            LKept.Add(LId);
            skip;
          end;
          LInstr := self.FModule.InstrAt(LId);
          if IsTerminator(LInstr.Kind) then
            if LInstr.Kind = IrOp.Branch then
              self.DoMakeJump(LInstr, LI);
              LChanged := true;
            end;
            LKept.Add(LId);
            skip;
          end;
          // A dead value: dropped
          LChanged := true;
        end;
        LBlock.Instrs := LKept;
      end;
      return LChanged;
    end;

    // The removal (see the header); true when it changed the function
    method Run(): bool;
    begin
      self.DoIndex();
      self.DoControlDependence();
      self.DoKeptControl();
      self.DoSolve();
      return self.DoRewrite();
    end;
  end;

// The pass adce (see the header) over AModule's function AFunction, AAnalysis its facts
// made just before; true when it changed the function
public routine RemoveDeadCode(const AModule: ref IrModule; const AFunction: int64;
  const AAnalysis: ref FunctionAnalysis): bool;
var
  LRemover: ref DeadCodeRemover;
begin
  LRemover := ref DeadCodeRemover(AModule, AFunction, AAnalysis);
  return LRemover.Run();
end;

end.
