  was not distributed with this file, You can obtain one
  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  Adam.Compiler.Lexer.adam - Source bytes -> tokens (BNF sec 9)

  TokenKind     what a token is: a category (identifier, directive,
                literal, end of file, invalid) or the exact keyword or
                symbol. KindText names each one.
  ContextWord   a word with a meaning only where the grammar expects it,
                an identifier everywhere else (BNF sec 4 / 5 / 6). The one
                table: the Parser's checks read it (IsContextWord), the
                editor's and the language server's word lists list it
                (ContextWords); ContextWordText spells each one.
  Directive     a build or conditional directive (BNF sec 2). The one
                table, DirectiveRow: its spelling, whether it is conditional,
                its argument's shape (DirectiveShape), main module only, at
                most once, version info, which argument is a path, may stand
                in a body, its two value words; the Parser, Conditionals,
                Semantics, Lowering and the Driver read it (DirectiveOf,
                IsDirective), the docs list it.
  Intrinsic     a predeclared intrinsic routine (BNF sec 7, the asserts of
                sec 8; names, never keywords). The one table, IntrinsicRow:
                its spelling, a statement (no value) or a value, whether it
                takes a type argument (size, nameof, the runtime's thunk),
                its family (atomic, bit, assert), internal (a reserved
                compiler name, never listed), the signature SM0409 names
                (Semantics reports it from here). The AST declares each one
                from it and keeps it on the declaration (ResolvedIntrinsic),
                which Semantics, Folding and Lowering match on; the Parser,
                cimport and the Driver spell one through it (IntrinsicText,
                IntrinsicOf, IsIntrinsic), the docs list it.
  NumberParts   what a number literal's text holds, read by ReadNumber:
                integer or float, base, body, suffix, value, the problem
  Token         one token: its kind, its place (embedded SourcePlace), its
                physical byte range, its spelling (splices removed, a raw
                string's body kept physical), an integer's value and a
                literal's suffix
  TokenList     the tokens of one file, EndOfFile last
  DocLine       one `///` doc comment line the Lexer kept (BNF sec 9, doc
                comments): its place, its text (one space after `///` and
                trailing blanks dropped) and whether it is alone on its line;
                the Parser attaches them to declarations (DocText)
  Lexer         reads a SourceText token by token, reporting through
                Diagnostics. Every lexical error leaves an Invalid token
                over the bytes it covers: nothing is dropped silently.

  The keywords are PaskalCPP's own, without its C++ surface (cpp, cppstart,
  cppend), plus virtual, operator and default (BNF sec 4), and public (BNF
  row 20: it replaced PaskalCPP's exported, which is no keyword here). The object
  words (init, own, ref, is, as, ...) and the statement words (defer, yield,
  lock, parallel, ...) are context words (ContextWord): identifiers here.
  Literals follow C++'s forms: a number is read as one pp-number (digits,
  letters, separators, a sign after an exponent mark) and then checked,
  so `10q` is one bad literal, never a number and a name. Escapes are not
  decoded here (the parser's); there is no octal. A newline or a line
  splice follows SourceText's one rule.
*******************************************************************************/

module unit Adam.Compiler.Lexer;

import System.SysUtils, Adam.Core.Common, Adam.Core.Messages, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics;

public const
  ADAM_ERR_LEXER_001: string = "LX0001";   // a string or character literal not closed on its line
  ADAM_ERR_LEXER_002: string = "LX0002";   // a raw string not closed
  ADAM_ERR_LEXER_003: string = "LX0003";   // a block comment not closed
  ADAM_ERR_LEXER_004: string = "LX0004";   // a character that starts no token
  ADAM_ERR_LEXER_005: string = "LX0005";   // a malformed number
  ADAM_ERR_LEXER_006: string = "LX0006";   // an integer no integer type holds, a float no float64 holds
  ADAM_ERR_LEXER_007: string = "LX0007";   // a leading 0: no octal literals
  ADAM_ERR_LEXER_009: string = "LX0009";   // '@' with no directive name
  ADAM_ERR_LEXER_010: string = "LX0010";   // a raw string delimiter that is invalid or too long
  ADAM_ERR_LEXER_011: string = "LX0011";   // invalid UTF-8
  ADAM_ERR_LEXER_201: string = "LX0201";   // warning: blanks between '\' and its newline
  ADAM_ERR_LEXER_202: string = "LX0202";   // warning: '*' and '/' split by a splice
  ADAM_ERR_LEXER_203: string = "LX0203";   // warning: '/*' inside a block comment

  // The longest raw string delimiter, as C++
  ADAM_LEXER_MAX_DELIMITER: int64 = 16;
  ADAM_LEXER_INT64_MAX: uint64 = 9223372036854775807u;
  ADAM_LEXER_UINT64_MAX: uint64 = 18446744073709551615u;
  ADAM_LEXER_FLOAT64_MAX: float64 = 1.7976931348623157e308;

// The byte value of an ASCII character
func DoCode(const AChar: char): int32;
begin
  return int32(uint8(AChar));
end;

// True for '0'..'9'
func DoIsDigit(const AByte: int32): bool;
begin
  return (AByte >= DoCode('0')) and (AByte <= DoCode('9'));
end;

// True for a byte that starts an identifier: 'A'..'Z', 'a'..'z', '_'
func DoIsLetter(const AByte: int32): bool;
begin
  if (AByte >= DoCode('a')) and (AByte <= DoCode('z')) then
    return true;
  end;
  if (AByte >= DoCode('A')) and (AByte <= DoCode('Z')) then
    return true;
  end;
  return AByte = DoCode('_');
end;

// True for a byte an identifier may go on with
func DoIsWordByte(const AByte: int32): bool;
begin
  return DoIsLetter(AByte) or DoIsDigit(AByte);
end;

// True for a blank: space, tab (9), LF (10), VT (11), FF (12), CR (13)
func DoIsBlank(const AByte: int32): bool;
begin
  return (AByte = DoCode(' ')) or ((AByte >= 9) and (AByte <= 13));
end;

// True for LF or CR: the bytes a newline starts with
func DoIsNewline(const AByte: int32): bool;
begin
  return (AByte = 10) or (AByte = 13);
end;

// True for 'u' or 'U'
func DoIsUnsignedMark(const AByte: int32): bool;
begin
  return (AByte = DoCode('u')) or (AByte = DoCode('U'));
end;

// The byte at AIndex of AText as 0..255; -1 past either end
func DoTextByte(const AText: string; const AIndex: int64): int32;
begin
  if (AIndex < 0) or (AIndex >= len(AText)) then
    return -1;
  end;
  return int32(uint8(AText[AIndex]));
end;

// The value of AByte as a digit of ABase (2, 10 or 16); -1 when it is none
func DoDigitValue(const AByte: int32; const ABase: int32): int32;
var
  LValue: int32;
begin
  LValue := -1;
  if DoIsDigit(AByte) then
    LValue := AByte - DoCode('0');
  else
    if (AByte >= DoCode('a')) and (AByte <= DoCode('f')) then
      LValue := AByte - DoCode('a') + 10;
    else
      if (AByte >= DoCode('A')) and (AByte <= DoCode('F')) then
        LValue := AByte - DoCode('A') + 10;
      end;
    end;
  end;
  if LValue >= ABase then
    return -1;
  end;
  return LValue;
end;

// The digits of ABase from AAt, a separator ' allowed only between two of
// them. Returns the offset after them; ACount gets how many digits there
// were, ABadSeparator is set when a ' stands anywhere else
func DoScanDigits(const AText: string; const AAt: int64; const ABase: int32;
  var ACount: int64; var ABadSeparator: bool): int64;
var
  LAt: int64;
begin
  LAt := AAt;
  ACount := 0;
  while true do
    if DoDigitValue(DoTextByte(AText, LAt), ABase) >= 0 then
      ACount := ACount + 1;
      LAt := LAt + 1;
    else
      if DoTextByte(AText, LAt) <> DoCode('\'') then
        leave;
      end;
      if (ACount = 0) or (DoDigitValue(DoTextByte(AText, LAt + 1), ABase) < 0) then
        ABadSeparator := true;
      end;
      LAt := LAt + 1;
    end;
  end;
  return LAt;
end;

// True when AText[AFrom, ATo) holds a digit separator
func DoHasSeparator(const AText: string; const AFrom: int64; const ATo: int64): bool;
var
  LI: int64;
begin
  for LI := AFrom to ATo - 1 do
    if DoTextByte(AText, LI) = DoCode('\'') then
      return true;
    end;
  end;
  return false;
end;

// True for an integer size suffix: l L ll LL z Z
func DoIsSizeSuffix(const AText: string): bool;
begin
  return (AText = "l") or (AText = "L") or (AText = "ll") or (AText = "LL") or
    (AText = "z") or (AText = "Z");
end;

// True for an integer suffix (BNF int suffix): none; u or U with an optional
// size after it; a size with an optional u or U after it
func DoIsIntSuffix(const AText: string): bool;
var
  LLength: int64;
begin
  LLength := len(AText);
  if LLength = 0 then
    return true;
  end;
  if DoIsUnsignedMark(DoTextByte(AText, 0)) then
    return (LLength = 1) or DoIsSizeSuffix(Substring(AText, 1, LLength - 1));
  end;
  if DoIsUnsignedMark(DoTextByte(AText, LLength - 1)) then
    return DoIsSizeSuffix(Substring(AText, 0, LLength - 1));
  end;
  return DoIsSizeSuffix(AText);
end;

// True when an integer suffix holds u or U (the literal may be unsigned)
func DoHasUnsignedMark(const ASuffix: string): bool;
begin
  return DoIsUnsignedMark(DoTextByte(ASuffix, 0)) or
    DoIsUnsignedMark(DoTextByte(ASuffix, len(ASuffix) - 1));
end;

// True for a float suffix Adam takes: none (float64) or f / F (float32). Adam has no
// long double and no float16 (user 2026-11-03): l, L, f16 and F16 are refused by name
func DoIsFloatSuffix(const AText: string): bool;
begin
  return (AText = "") or (AText = "f") or (AText = "F");
end;

// True for C++23's other float suffixes: refused by name (F63), the message naming the
// two spellings Adam has
func DoIsRefusedFloatSuffix(const AText: string): bool;
begin
  return (AText = "l") or (AText = "L") or (AText = "f16") or (AText = "F16") or
    (AText = "f32") or (AText = "F32") or (AText = "f64") or (AText = "F64") or
    (AText = "f128") or (AText = "F128") or (AText = "bf16") or (AText = "BF16");
end;

// AText without its leading zeros and separators: the decimal a leading-0
// literal meant ("0" when nothing else is left)
func DoDropLeadingZeros(const AText: string): string;
var
  LAt: int64;
begin
  LAt := 0;
  while (DoTextByte(AText, LAt) = DoCode('0')) or (DoTextByte(AText, LAt) = DoCode('\'')) do
    LAt := LAt + 1;
  end;
  if LAt >= len(AText) then
    return "0";
  end;
  return Substring(AText, LAt, len(AText) - LAt);
end;

public type
  // What a token is. The categories first, then the symbols, then the
  // keywords from KwModule to KwLiteral (KeywordKind walks that range)
  TokenKind = choices(
    EndOfFile, Invalid, Identifier, Directive,
    IntLiteral, FloatLiteral, StringLiteral, CharLiteral,
    LParen, RParen, LBracket, RBracket, Comma, Semicolon, Colon, Assign,
    Dot, DotDot, Ellipsis, Caret, Question, Tilde, Bang, Arrow,
    Plus, PlusPlus, PlusAssign, Minus, MinusMinus, MinusAssign,
    Star, StarAssign, Slash, SlashAssign, Percent, PercentAssign,
    Amp, AmpAmp, AmpAssign, Pipe, PipePipe, PipeAssign,
    Equal, NotEqual, Less, LessEqual, Compare, ShiftLeft, ShiftLeftAssign,
    Greater, GreaterEqual, ShiftRight, ShiftRightAssign,
    KwModule, KwExe, KwDLL, KwLib, KwUnit, KwImport, KwInitialize, KwFinalize,
    KwBegin, KwEnd, KwVar, KwConst, KwType, KwFunc, KwForward, KwMethod,
    KwPublic, KwClink, KwCpplink, KwExternal, KwRecord, KwObject, KwOverlay,
    KwChoices, KwArray, KwOf, KwPtr, KwTo, KwSet, KwPacked, KwAlign,
    KwIf, KwThen, KwElse, KwWhile, KwDo, KwFor, KwDownto, KwRepeat, KwUntil,
    KwMatch, KwGuard, KwExcept, KwFinally, KwReturn, KwLeave, KwSkip,
    KwOr, KwAnd, KwXor, KwNot, KwIn, KwShl, KwShr, KwDiv, KwMod, KwAddr,
    KwTrue, KwFalse, KwNil, KwSelf, KwParent, KwVarargs, KwTest,
    KwInt8, KwInt16, KwInt32, KwInt64, KwUint8, KwUint16, KwUint32, KwUint64,
    KwClong, KwCulong, KwFloat32, KwFloat64, KwBool, KwChar, KwWchar, KwString, KwWstring,
    KwMutex, KwVirtual, KwOperator, KwThreadstatic, KwDefault, KwLiteral);

  // A context word: a word only where the grammar expects it, an identifier everywhere
  // else (`is := 1` is an assignment); never reserved. ContextWordText spells each one
  ContextWord = choices(
    Abstract, As, Async, Await, Copy, Defer, Done, Embed, Extend, Final, From, Hash, Hidden,
    Implements, Init, Interface, Is, Lock, Name, Noreturn, Override, Own, Parallel, Property, Read,
    Ref, Sequence, Static, Task, Trylock, Wait, Weak, Write, Yield);

  // A build or conditional directive (BNF sec 2); DirectiveRow gives its facts
  Directive = choices(
    Optimize, Subsystem, AddVerInfo, UnitTestMode, ViMajor, ViMinor, ViPatch, ViProductName,
    ViDescription, ViFileName, ViCompanyName, ViCopyright, ExeIcon, AddModulePath, OutputPath,
    Target, CopyDLL, LinkLibrary, AddLibraryPath, Breakpoint, Message, AddResData, Define, Undef,
    Ifdef, Ifndef, Elseif, Else, Endif);

  // What a directive takes (BNF sec 2): nothing, a name, a string, a severity and a
  // string (@message), a key and a path (@addresdata), an integer or a constant's name
  // (@vimajor / @viminor / @vipatch), a string or a constant's name (the five text @vi*,
  // @exeicon)
  DirectiveShape = choices(Bare, Name, Text, Message, KeyPath, NumberOrConst, TextOrConst);

  // One directive's facts (DirectiveRow): its spelling; Conditional for the seven the
  // Conditionals read before the parser; the shape of its argument; MainOnly when only the
  // main module may give it; Single when a module gives it at most once (@target and
  // @optimize are judged where Conditionals read them); Version for the @vi* (stamped only
  // with @addverinfo on); PathArgument the number of its argument that is a path (-1: none);
  // InBody when it may stand inside a routine's body; FirstValue / SecondValue the two
  // words a value directive takes ("" when it takes no such pair); Doc what it does, one
  // line of Markdown (a hover's text, the docs reference's Meaning; HK1)
  DirectiveInfo = record
    Spelling: string;
    Conditional: bool;
    Shape: DirectiveShape;
    MainOnly: bool;
    Single: bool;
    Version: bool;
    PathArgument: int64;
    InBody: bool;
    FirstValue: string;
    SecondValue: string;
    Doc: string;
  end;

  // A predeclared intrinsic (BNF sec 7 and the asserts of sec 8), in the grammar's order;
  // None: no intrinsic (every declaration but an intrinsic's). IntrinsicRow gives its facts
  Intrinsic = choices(
    None, Len, Size, UTF8, ParamCount, ParamStr, GetMem, ResizeMem, ExcCode, ExcMsg, Alive, Lock,
    Ready, AtomicAdd, AtomicSwap, AtomicCAS, AtomicLoad, ProjectPassword, FormatStr, Create,
    Destroy, FreeMem, SetLength, Raise, RaiseCode, Print, Println, AtomicStore, TestAssert,
    TestAssertTrue, TestAssertFalse, TestAssertNil, TestAssertNotNil, TestFail,
    TestAssertEqualInt, TestAssertEqualUInt, TestAssertEqualFloat, TestAssertEqualStr,
    TestAssertEqualBool, TestAssertEqualPtr, WorkerIndex, WorkerCount, Cancel, Cancelled, Pull,
    ByteSwap, LeadingZeros, TrailingZeros, PopCount, Hash, CThunk, NameOf, SourceHash);

  // The group an intrinsic's checks and lowering share: an atomic op (BNF sec 7, H4t2), a
  // bit op of one integer (M9j0), an assert the runtime runs (BNF sec 8), any other (Plain)
  IntrinsicFamily = choices(Plain, Atomic, Bit, Assert);

  // One intrinsic's facts (IntrinsicRow): its spelling; Statement when a call of it has no
  // value (BNF sec 7 memory / exception / io statements, atomicstore, cancel, the
  // asserts); TypeArgument when its argument may be a type (size, nameof, the runtime's
  // thunk); its family; Internal for a reserved compiler name no user writes (never
  // listed by an editor or the docs); Signature the arguments it takes as SM0409 names them
  // (Adam.Core.Messages' ADAM_MSG_SEMANTICS_SIG_*; "" for print / println, whose arguments
  // follow their format, SM0425); Doc what it does, one line of Markdown (a hover's text,
  // the docs reference's Meaning; HK1)
  IntrinsicInfo = record
    Spelling: string;
    Statement: bool;
    TypeArgument: bool;
    Family: IntrinsicFamily;
    Internal: bool;
    Signature: string;
    Doc: string;
  end;

  // What is wrong with a number literal (None: nothing)
  NumberProblem = choices(None, NoDigits, BadDigit, BadSeparator, HexFloatSeparator,
    NoHexExponent, NoExponentDigits, BadSuffix, RefusedSuffix, Octal, TooBigSigned,
    TooBig, FloatTooBig);

  // A number literal's text, read: integer or float, its base (2, 10, 16),
  // its body (the text before the suffix), its suffix, an integer's value,
  // the first problem found and, for an octal-looking one, the decimal it meant
  NumberParts = record
    IsFloat: bool;
    Base: int32;
    Body: string;
    Suffix: string;
    Value: uint64;
    Problem: NumberProblem;
    Meant: string;
  end;

// How a message or a row names AKind: a category in words, a symbol or a
// keyword as it is written
public func KindText(const AKind: TokenKind): string;
begin
  match AKind of
    TokenKind.EndOfFile: return "end of file";
    TokenKind.Invalid: return "invalid token";
    TokenKind.Identifier: return "identifier";
    TokenKind.Directive: return "directive";
    TokenKind.IntLiteral: return "integer literal";
    TokenKind.FloatLiteral: return "float literal";
    TokenKind.StringLiteral: return "string literal";
    TokenKind.CharLiteral: return "character literal";
    TokenKind.LParen: return "(";
    TokenKind.RParen: return ")";
    TokenKind.LBracket: return "[";
    TokenKind.RBracket: return "]";
    TokenKind.Comma: return ",";
    TokenKind.Semicolon: return ";";
    TokenKind.Colon: return ":";
    TokenKind.Assign: return ":=";
    TokenKind.Dot: return ".";
    TokenKind.DotDot: return "..";
    TokenKind.Ellipsis: return "...";
    TokenKind.Caret: return "^";
    TokenKind.Question: return "?";
    TokenKind.Tilde: return "~";
    TokenKind.Bang: return "!";
    TokenKind.Arrow: return "->";
    TokenKind.Plus: return "+";
    TokenKind.PlusPlus: return "++";
    TokenKind.PlusAssign: return "+=";
    TokenKind.Minus: return "-";
    TokenKind.MinusMinus: return "--";
    TokenKind.MinusAssign: return "-=";
    TokenKind.Star: return "*";
    TokenKind.StarAssign: return "*=";
    TokenKind.Slash: return "/";
    TokenKind.SlashAssign: return "/=";
    TokenKind.Percent: return "%";
    TokenKind.PercentAssign: return "%=";
    TokenKind.Amp: return "&";
    TokenKind.AmpAmp: return "&&";
    TokenKind.AmpAssign: return "&=";
    TokenKind.Pipe: return "|";
    TokenKind.PipePipe: return "||";
    TokenKind.PipeAssign: return "|=";
    TokenKind.Equal: return "=";
    TokenKind.NotEqual: return "<>";
    TokenKind.Less: return "<";
    TokenKind.LessEqual: return "<=";
    TokenKind.Compare: return "<=>";
    TokenKind.ShiftLeft: return "<<";
    TokenKind.ShiftLeftAssign: return "<<=";
    TokenKind.Greater: return ">";
    TokenKind.GreaterEqual: return ">=";
    TokenKind.ShiftRight: return ">>";
    TokenKind.ShiftRightAssign: return ">>=";
    TokenKind.KwModule: return "module";
    TokenKind.KwExe: return "exe";
    TokenKind.KwDLL: return "dll";
    TokenKind.KwLib: return "lib";
    TokenKind.KwUnit: return "unit";
    TokenKind.KwImport: return "import";
    TokenKind.KwInitialize: return "initialize";
    TokenKind.KwFinalize: return "finalize";
    TokenKind.KwBegin: return "begin";
    TokenKind.KwEnd: return "end";
    TokenKind.KwVar: return "var";
    TokenKind.KwConst: return "const";
    TokenKind.KwType: return "type";
    TokenKind.KwFunc: return "func";
    TokenKind.KwForward: return "forward";
    TokenKind.KwMethod: return "method";
    TokenKind.KwPublic: return "public";
    TokenKind.KwClink: return "clink";
    TokenKind.KwCpplink: return "cpplink";
    TokenKind.KwExternal: return "external";
    TokenKind.KwRecord: return "record";
    TokenKind.KwObject: return "object";
    TokenKind.KwOverlay: return "overlay";
    TokenKind.KwChoices: return "choices";
    TokenKind.KwArray: return "array";
    TokenKind.KwOf: return "of";
    TokenKind.KwPtr: return "ptr";
    TokenKind.KwTo: return "to";
    TokenKind.KwSet: return "set";
    TokenKind.KwPacked: return "packed";
    TokenKind.KwAlign: return "align";
    TokenKind.KwIf: return "if";
    TokenKind.KwThen: return "then";
    TokenKind.KwElse: return "else";
    TokenKind.KwWhile: return "while";
    TokenKind.KwDo: return "do";
    TokenKind.KwFor: return "for";
    TokenKind.KwDownto: return "downto";
    TokenKind.KwRepeat: return "repeat";
    TokenKind.KwUntil: return "until";
    TokenKind.KwMatch: return "match";
    TokenKind.KwGuard: return "guard";
    TokenKind.KwExcept: return "except";
    TokenKind.KwFinally: return "finally";
    TokenKind.KwReturn: return "return";
    TokenKind.KwLeave: return "leave";
    TokenKind.KwSkip: return "skip";
    TokenKind.KwOr: return "or";
    TokenKind.KwAnd: return "and";
    TokenKind.KwXor: return "xor";
    TokenKind.KwNot: return "not";
    TokenKind.KwIn: return "in";
    TokenKind.KwShl: return "shl";
    TokenKind.KwShr: return "shr";
    TokenKind.KwDiv: return "div";
    TokenKind.KwMod: return "mod";
    TokenKind.KwAddr: return "addr";
    TokenKind.KwTrue: return "true";
    TokenKind.KwFalse: return "false";
    TokenKind.KwNil: return "nil";
    TokenKind.KwSelf: return "self";
    TokenKind.KwParent: return "parent";
    TokenKind.KwVarargs: return "varargs";
    TokenKind.KwTest: return "test";
    TokenKind.KwInt8: return "int8";
    TokenKind.KwInt16: return "int16";
    TokenKind.KwInt32: return "int32";
    TokenKind.KwInt64: return "int64";
    TokenKind.KwUint8: return "uint8";
    TokenKind.KwUint16: return "uint16";
    TokenKind.KwUint32: return "uint32";
    TokenKind.KwUint64: return "uint64";
    TokenKind.KwClong: return "clong";
    TokenKind.KwCulong: return "culong";
    TokenKind.KwFloat32: return "float32";
    TokenKind.KwFloat64: return "float64";
    TokenKind.KwBool: return "bool";
    TokenKind.KwChar: return "char";
    TokenKind.KwWchar: return "wchar";
    TokenKind.KwString: return "string";
    TokenKind.KwWstring: return "wstring";
    TokenKind.KwMutex: return "mutex";
    TokenKind.KwVirtual: return "virtual";
    TokenKind.KwOperator: return "operator";
    TokenKind.KwThreadstatic: return "threadstatic";
    TokenKind.KwDefault: return "default";
    TokenKind.KwLiteral: return "literal";
  end;
end;

// The keyword AText spells, or Identifier. Every keyword is lowercase
// letters and digits, so a word starting otherwise is no keyword
public func KeywordKind(const AText: string): TokenKind;
var
  LFirst: int32;
  LKind: TokenKind;
begin
  LFirst := DoTextByte(AText, 0);
  if (LFirst < DoCode('a')) or (LFirst > DoCode('z')) then
    return TokenKind.Identifier;
  end;
  for LKind := TokenKind.KwModule to TokenKind.KwLiteral do
    if KindText(LKind) = AText then
      return LKind;
    end;
  end;
  return TokenKind.Identifier;
end;

// True for the word that makes a declaration public (BNF row 20): public
public func IsPublicWord(const AKind: TokenKind): bool;
begin
  return AKind = TokenKind.KwPublic;
end;

// True when AKind is a keyword (TokenKind's KwModule .. KwLiteral range)
public func IsKeywordKind(const AKind: TokenKind): bool;
begin
  return (AKind >= TokenKind.KwModule) and (AKind <= TokenKind.KwLiteral);
end;

// True when AKind is a builtin type word (the keywords KwInt8 .. KwWstring)
public func IsTypeWordKind(const AKind: TokenKind): bool;
begin
  return (AKind >= TokenKind.KwInt8) and (AKind <= TokenKind.KwWstring);
end;

// Adam's reserved words in the Lexer's order: the builtin type words when ATypes, else every
// other keyword (an editor's or a language server's word lists)
public func ReservedWords(const ATypes: bool): StringArray;
var
  LWords: StringArray;
  LKind: TokenKind;
  LCount: int64;
begin
  setlength(LWords, 0);
  for LKind := TokenKind.KwModule to TokenKind.KwLiteral do
    if IsTypeWordKind(LKind) = ATypes then
      LCount := len(LWords);
      setlength(LWords, LCount + 1);
      LWords[LCount] := KindText(LKind);
    end;
  end;
  return LWords;
end;

// What the keyword AKind is for, one line of Markdown (a hover's text, the docs
// reference's Meaning; HK1); "" for a kind that is no keyword
public func KeywordDoc(const AKind: TokenKind): string;
begin
  match AKind of
    TokenKind.KwModule:
      return "Starts every source file: `module exe Name;`, `module dll Name;`, `module lib Name;` or `module unit Name;` names the module and what it builds.";
    TokenKind.KwExe:
      return "A module kind: the module builds a program (an executable) and is the main module of its build.";
    TokenKind.KwDLL:
      return "A module kind: the module builds a shared library (a DLL on Windows, a shared object on Linux) exporting its `public` routines.";
    TokenKind.KwLib:
      return "A module kind: the module builds a static library (an archive) that other programs link.";
    TokenKind.KwUnit:
      return "A module kind: a unit, imported by other modules and compiled into the build of the program that imports it.";
    TokenKind.KwImport:
      return "Brings units into scope: `import System.SysUtils, System.IO;` makes their `public` declarations visible here.";
    TokenKind.KwInitialize:
      return "A module section run once when the program starts, before the main block, in import order.";
    TokenKind.KwFinalize:
      return "A module section run once when the program ends, in reverse import order, however it ends (return, Halt or an uncaught raise).";
    TokenKind.KwBegin:
      return "Opens a block of statements that `end` closes: a routine body, the main block or a nested block.";
    TokenKind.KwEnd:
      return "Closes a block, a type (`record .. end`) or a statement (`if .. end;`); the main block ends with `end.`";
    TokenKind.KwVar:
      return "Declares variables (`var LCount: int32;`); a `var` parameter is passed by reference, so the routine can change the caller's variable.";
    TokenKind.KwConst:
      return "Declares constants (`const ADAM_MAX: int32 = 10;`); a `const` parameter is read-only and passed with no copy; a `const method` leaves its object unchanged.";
    TokenKind.KwType:
      return "Declares types: `type Point = record X: int32; Y: int32; end;`";
    TokenKind.KwFunc:
      return "Declares a routine: `func Add(const A: int32; const B: int32): int32;`. Also a routine type `func(..)` and a func literal `func(..) begin .. end` (a closure).";
    TokenKind.KwForward:
      return "Announces a routine or a type declared further down, so code before it can name it: `forward func Later(): int32;`";
    TokenKind.KwMethod:
      return "Declares a routine of an object type, run on an object (`self`): `method Grow(const AStep: int32);`";
    TokenKind.KwPublic:
      return "Exports a declaration from its module (`public func`, `public type`, `public const`); without it a declaration is private to its module.";
    TokenKind.KwClink:
      return "C linkage: the routine uses its plain C name and the C calling convention, so C can call it or it binds a C function.";
    TokenKind.KwCpplink:
      return "C++ linkage: the routine gets a mangled (Itanium) symbol, so a C library's routine of the same name never clashes with it at link time.";
    TokenKind.KwExternal:
      return "Binds a declaration to a library's symbol: `external \"user32\";` after its heading (`name \"sym\"` binds another symbol name).";
    TokenKind.KwRecord:
      return "A value type of named fields, copied on assignment: `Point = record X: int32; Y: int32; end;`. It may declare operators.";
    TokenKind.KwObject:
      return "A type with fields, methods, properties and init / done; it may inherit (`object(Base)`) and implement interfaces, and is held by `own`, `ref` or `weak`.";
    TokenKind.KwOverlay:
      return "A type whose fields share one storage (C's `union`): `overlay I: int64; F: float64; end`";
    TokenKind.KwChoices:
      return "An enumeration: `Color = choices(Red, Green, Blue);`. A value is always written with its type: `Color.Red`.";
    TokenKind.KwArray:
      return "An array type: `array[0..9] of int32` (static) or `array of string` (dynamic, sized with `setlength`).";
    TokenKind.KwOf:
      return "Names an element type (`array of T`, `set of T`, `sequence of T`); also `match X of`.";
    TokenKind.KwPtr:
      return "A pointer type: `ptr to T` (typed), `ptr` (untyped), `ptr to const T` (a read-only target). `P^` is what P points to.";
    TokenKind.KwTo:
      return "In `ptr to T`, the type pointed to; in `for I := A to B do`, the loop counts up.";
    TokenKind.KwSet:
      return "A set type over a choices type or a small integer range: `set of Color`. Test a member with `in`.";
    TokenKind.KwPacked:
      return "Lays a record out with no padding between its fields; `packed(N)` aligns its fields to at most N bytes (C's `#pragma pack(N)`).";
    TokenKind.KwAlign:
      return "Sets a record's alignment in bytes: `record align(16) .. end`";
    TokenKind.KwIf:
      return "Runs its statements when the condition is true: `if X > 0 then .. else .. end;`";
    TokenKind.KwThen:
      return "Ends an `if` condition: `if X > 0 then`";
    TokenKind.KwElse:
      return "The other branch: of an `if`, of a `match` (no arm matched) or of a `trylock` (the mutex was not taken).";
    TokenKind.KwWhile:
      return "Repeats its statements while the condition is true, testing before each pass: `while X < 10 do .. end;`";
    TokenKind.KwDo:
      return "Starts the body of a `while`, `for`, `for .. in`, `lock` or `trylock`.";
    TokenKind.KwFor:
      return "A counted loop: `for I := 0 to 9 do .. end;` (`downto` counts down). `for X in Items do` walks an array, a string, a set or a sequence; `for parallel` runs the passes on worker threads.";
    TokenKind.KwDownto:
      return "In `for I := A downto B do`, the loop counts down.";
    TokenKind.KwRepeat:
      return "Repeats its statements until the condition is true, testing after each pass: `repeat .. until LDone;`";
    TokenKind.KwUntil:
      return "Ends a `repeat` loop with its stop condition.";
    TokenKind.KwMatch:
      return "Runs the arm whose label matches the value: `match K of 1, 2: .. 3..9: .. else .. end;`";
    TokenKind.KwGuard:
      return "Runs its statements under exception handling: `guard .. except .. finally .. end;`. `except` runs on a raise, `finally` always.";
    TokenKind.KwExcept:
      return "In a `guard`, the statements run when its body raised; `exccode()` and `excmsg()` read the exception.";
    TokenKind.KwFinally:
      return "In a `guard`, the statements that always run, whether its body raised or not.";
    TokenKind.KwReturn:
      return "Leaves the routine, giving its value when it has one: `return X;`. In an exe's main block `return N;` sets the exit code.";
    TokenKind.KwLeave:
      return "Leaves the innermost loop (C's `break`).";
    TokenKind.KwSkip:
      return "Goes on with the next pass of the innermost loop (C's `continue`).";
    TokenKind.KwOr:
      return "Logical or of two bools; bitwise or of two integers.";
    TokenKind.KwAnd:
      return "Logical and of two bools; bitwise and of two integers.";
    TokenKind.KwXor:
      return "Exclusive or: of two bools, or bit by bit of two integers.";
    TokenKind.KwNot:
      return "Logical not of a bool; bitwise not of an integer.";
    TokenKind.KwIn:
      return "Membership: `X in S` is true when X is a member of the set S. Also `for X in Items do`.";
    TokenKind.KwShl:
      return "Shifts an integer's bits left: `X shl 2`";
    TokenKind.KwShr:
      return "Shifts an integer's bits right: `X shr 2`";
    TokenKind.KwDiv:
      return "Integer division, the remainder dropped: `7 div 2` is 3.";
    TokenKind.KwMod:
      return "The remainder of an integer division: `7 mod 2` is 1.";
    TokenKind.KwAddr:
      return "`addr of X` is a pointer to X.";
    TokenKind.KwTrue:
      return "The bool value true.";
    TokenKind.KwFalse:
      return "The bool value false.";
    TokenKind.KwNil:
      return "The empty pointer: no object, no memory, no routine.";
    TokenKind.KwSelf:
      return "Inside a method, the object it runs on.";
    TokenKind.KwParent:
      return "Inside a method, the parent type's version of a member: `parent.init(..)`";
    TokenKind.KwVarargs:
      return "Reads the variable arguments of a routine declared with `...`: `varargs.count`, `varargs.next(int32)`, `varargs.get(I, T)`.";
    TokenKind.KwTest:
      return "A unit test after the module's `end.`: `test \"adds\" begin .. end;`, run by `@unitTestMode on;`";
    TokenKind.KwInt8:
      return "A signed 8-bit integer, -128 to 127.";
    TokenKind.KwInt16:
      return "A signed 16-bit integer, -32768 to 32767.";
    TokenKind.KwInt32:
      return "A signed 32-bit integer, -2147483648 to 2147483647.";
    TokenKind.KwInt64:
      return "A signed 64-bit integer.";
    TokenKind.KwUint8:
      return "An unsigned 8-bit integer, 0 to 255.";
    TokenKind.KwUint16:
      return "An unsigned 16-bit integer, 0 to 65535.";
    TokenKind.KwUint32:
      return "An unsigned 32-bit integer, 0 to 4294967295.";
    TokenKind.KwUint64:
      return "An unsigned 64-bit integer.";
    TokenKind.KwClong:
      return "C's `long`, sized by the target: 4 bytes on x86_64-windows-gnu, 8 on x86_64-linux-gnu.";
    TokenKind.KwCulong:
      return "C's `unsigned long`, sized by the target: 4 bytes on x86_64-windows-gnu, 8 on x86_64-linux-gnu.";
    TokenKind.KwFloat32:
      return "A 32-bit IEEE 754 float (C's `float`).";
    TokenKind.KwFloat64:
      return "A 64-bit IEEE 754 float (C's `double`).";
    TokenKind.KwBool:
      return "A truth value: `true` or `false`.";
    TokenKind.KwChar:
      return "One 8-bit character, a byte of UTF-8 text (C's `char`).";
    TokenKind.KwWchar:
      return "One 16-bit character, a UTF-16 code unit: an element of a wstring.";
    TokenKind.KwString:
      return "UTF-8 text, reference counted and copied on write; `len(S)` is its length.";
    TokenKind.KwWstring:
      return "UTF-16 text, reference counted and copied on write; `utf8(W)` gives it as a string.";
    TokenKind.KwMutex:
      return "A lock for `lock (M) do .. end;` and `trylock`: zero is unlocked, the thread holding it may take it again, never copied.";
    TokenKind.KwVirtual:
      return "A method or property that a descendant type may override.";
    TokenKind.KwOperator:
      return "Declares an operator of a record or object type: `operator +(const A: Vec; const B: Vec): Vec;`";
    TokenKind.KwThreadstatic:
      return "Declares module variables with one copy per thread: `threadstatic GCount: int64;`";
    TokenKind.KwDefault:
      return "Marks an indexed property as its object's default: `O[I]` reads it.";
    TokenKind.KwLiteral:
      return "A parameter mode: the argument must be a compile-time constant (a literal or a constant's name); it is passed as `const`.";
  else
  end;
  return "";
end;

// How the source spells AWord
public func ContextWordText(const AWord: ContextWord): string;
begin
  match AWord of
    ContextWord.Abstract: return "abstract";
    ContextWord.As: return "as";
    ContextWord.Async: return "async";
    ContextWord.Await: return "await";
    ContextWord.Copy: return "copy";
    ContextWord.Defer: return "defer";
    ContextWord.Done: return "done";
    ContextWord.Embed: return "embed";
    ContextWord.Extend: return "extend";
    ContextWord.Final: return "final";
    ContextWord.From: return "from";
    ContextWord.Hash: return "hash";
    ContextWord.Hidden: return "hidden";
    ContextWord.Implements: return "implements";
    ContextWord.Init: return "init";
    ContextWord.Interface: return "interface";
    ContextWord.Is: return "is";
    ContextWord.Lock: return "lock";
    ContextWord.Name: return "name";
    ContextWord.Noreturn: return "noreturn";
    ContextWord.Override: return "override";
    ContextWord.Own: return "own";
    ContextWord.Parallel: return "parallel";
    ContextWord.Property: return "property";
    ContextWord.Read: return "read";
    ContextWord.Ref: return "ref";
    ContextWord.Sequence: return "sequence";
    ContextWord.Static: return "static";
    ContextWord.Task: return "task";
    ContextWord.Trylock: return "trylock";
    ContextWord.Wait: return "wait";
    ContextWord.Weak: return "weak";
    ContextWord.Write: return "write";
    ContextWord.Yield: return "yield";
  end;
end;

// What the context word AWord is for, one line of Markdown (a hover's text, the docs
// reference's Meaning; HK1)
public func ContextWordDoc(const AWord: ContextWord): string;
begin
  match AWord of
    ContextWord.Abstract:
      return "A method or property accessor with no body here: every concrete descendant gives one.";
    ContextWord.As:
      return "Casts an object or interface to a type, checked when it runs: `LShape as Circle`";
    ContextWord.Async:
      return "Starts a call on another thread and gives its `task`: `LTask := async Work(1);`. `async begin .. end` runs a block.";
    ContextWord.Await:
      return "Waits for a task to end and gives its result: `LValue := await LTask;`";
    ContextWord.Copy:
      return "Declares an object type's copy routine, run when a value of it is copied: `copy(const AFrom: Box);`. Also `varargs.copy()`.";
    ContextWord.Defer:
      return "Runs a statement when its enclosing statement list ends, however it ends (return, leave, raise): `defer CloseFile(LF);`";
    ContextWord.Done:
      return "Declares an object type's teardown, run when the object is released: `done; begin .. end;`";
    ContextWord.Embed:
      return "Embeds a type's fields and members into an object type, reachable as its own: `embed Place: SourcePlace;`";
    ContextWord.Extend:
      return "Adds methods and operators to an existing type, a generic one too: `extend Vector2 .. end;`, `extend List<T> .. end;`";
    ContextWord.Final:
      return "An object type nothing may inherit from, or a virtual method or property no descendant may override.";
    ContextWord.From:
      return "In `yield from S;`, hands out every value of the sequence S.";
    ContextWord.Hash:
      return "`operator hash` gives a record or object type its hash for `hash(X)` and for Map / Set keys.";
    ContextWord.Hidden:
      return "Hides a member of an object type: only the type itself reaches it.";
    ContextWord.Implements:
      return "Lists the interfaces an object type implements: `object implements IShape`";
    ContextWord.Init:
      return "Declares an object type's initializer, run by `own T(..)`, `ref T(..)` or a value `T(..)`: `init(const ASize: int32);`";
    ContextWord.Interface:
      return "A type of method and property headings that object types implement, reached through any object that implements it.";
    ContextWord.Is:
      return "Tests an object's type when it runs: `if LShape is Circle then`";
    ContextWord.Lock:
      return "`lock (M) do .. end;` runs its statements holding the mutex M, released however they end.";
    ContextWord.Name:
      return "In an `external` clause, the library's symbol when it differs from the declaration's name: `external \"lib\" name \"sym\";`";
    ContextWord.Noreturn:
      return "Marks a routine that never returns (as `Halt`): what follows a call of it is unreachable.";
    ContextWord.Override:
      return "Replaces a virtual method or property of the parent type.";
    ContextWord.Own:
      return "An owning pointer: `own T` holds an object alone and frees it when it goes; `own T(..)` makes one.";
    ContextWord.Parallel:
      return "`for parallel I := 0 to N - 1 do .. end;` runs the passes on worker threads; `for parallel (W)` sets how many.";
    ContextWord.Property:
      return "Declares a property of an object type: `property Size: int32 read FSize; write FSize;`";
    ContextWord.Read:
      return "A property's getter: a field's name or a body.";
    ContextWord.Ref:
      return "A shared, counted pointer: `ref T` holds an object with others and frees it when the last one goes; `ref T(..)` makes one; `ref func(..)` is a closure type.";
    ContextWord.Sequence:
      return "A generator type: `sequence of T`, given by a func that yields its values, walked by `for .. in` or `pull`.";
    ContextWord.Static:
      return "A method called on its type, with no object: `static method FromFile(const APath: string): JSON;`, called as `JSON.FromFile(..)`.";
    ContextWord.Task:
      return "A call started by `async`: `task int32`. `await` gives its result; `ready`, `cancel` and `cancelled` act on it.";
    ContextWord.Trylock:
      return "`trylock (M) do .. else .. end;` takes the mutex M only when it is free, else runs the `else`.";
    ContextWord.Wait:
      return "In `trylock (M) wait N do`, waits up to N milliseconds for the mutex.";
    ContextWord.Weak:
      return "A watching pointer: `weak T` sees an object without keeping it alive; `alive(W)` tests it, `lock(W)` gives a `ref` to it.";
    ContextWord.Write:
      return "A property's setter: a field's name or a body.";
    ContextWord.Yield:
      return "In a sequence's func, hands out the next value: `yield X;`. `yield from S;` hands out all of S.";
  end;
end;

// True when AText is the context word AWord (the Parser's one way to test for one)
public func IsContextWord(const AText: string; const AWord: ContextWord): bool;
begin
  return AText = ContextWordText(AWord);
end;

// Adam's context words in ContextWord's order (an editor's or a language server's word lists)
public func ContextWords(): StringArray;
var
  LWords: StringArray;
  LWord: ContextWord;
  LCount: int64;
begin
  setlength(LWords, 0);
  for LWord := ContextWord.Abstract to ContextWord.Yield do
    LCount := len(LWords);
    setlength(LWords, LCount + 1);
    LWords[LCount] := ContextWordText(LWord);
  end;
  return LWords;
end;

// The facts of ADirective: the one directive table (BNF sec 2)
public func DirectiveRow(const ADirective: Directive): DirectiveInfo;
begin
  match ADirective of
    Directive.Optimize:
      return DirectiveInfo(Spelling: "@optimize", Conditional: false,
        Shape: DirectiveShape.Name, MainOnly: true, Single: false, Version: false,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The build's optimization level: `@optimize debug;` (or safe, fast, small). Only in the main module's prologue; `adam -opt` wins over it.");
    Directive.Subsystem:
      return DirectiveInfo(Spelling: "@subsystem", Conditional: false,
        Shape: DirectiveShape.Name, MainOnly: true, Single: true, Version: false,
        PathArgument: -1, InBody: false, FirstValue: "console", SecondValue: "gui",
        Doc: "A Windows exe's subsystem: `@subsystem console;` or `@subsystem gui;` (no console window).");
    Directive.AddVerInfo:
      return DirectiveInfo(Spelling: "@addverinfo", Conditional: false,
        Shape: DirectiveShape.Name, MainOnly: true, Single: true, Version: false,
        PathArgument: -1, InBody: false, FirstValue: "on", SecondValue: "off",
        Doc: "`@addverinfo on;` stamps the exe's version info from the `@vi*` directives (Windows).");
    Directive.UnitTestMode:
      return DirectiveInfo(Spelling: "@unitTestMode", Conditional: false,
        Shape: DirectiveShape.Name, MainOnly: true, Single: true, Version: false,
        PathArgument: -1, InBody: false, FirstValue: "on", SecondValue: "off",
        Doc: "`@unitTestMode on;` runs the test blocks instead of the main block; the exit code is the number of failed tests.");
    Directive.ViMajor:
      return DirectiveInfo(Spelling: "@vimajor", Conditional: false,
        Shape: DirectiveShape.NumberOrConst, MainOnly: true, Single: true, Version: true,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The version's major number (0 to 65535, or an integer constant's name), stamped with `@addverinfo on;`");
    Directive.ViMinor:
      return DirectiveInfo(Spelling: "@viminor", Conditional: false,
        Shape: DirectiveShape.NumberOrConst, MainOnly: true, Single: true, Version: true,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The version's minor number (0 to 65535, or an integer constant's name), stamped with `@addverinfo on;`");
    Directive.ViPatch:
      return DirectiveInfo(Spelling: "@vipatch", Conditional: false,
        Shape: DirectiveShape.NumberOrConst, MainOnly: true, Single: true, Version: true,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The version's patch number (0 to 65535, or an integer constant's name), stamped with `@addverinfo on;`");
    Directive.ViProductName:
      return DirectiveInfo(Spelling: "@viproductname", Conditional: false,
        Shape: DirectiveShape.TextOrConst, MainOnly: true, Single: true, Version: true,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The version info's product name (a string, or a string constant's name).");
    Directive.ViDescription:
      return DirectiveInfo(Spelling: "@videscription", Conditional: false,
        Shape: DirectiveShape.TextOrConst, MainOnly: true, Single: true, Version: true,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The version info's file description (a string, or a string constant's name).");
    Directive.ViFileName:
      return DirectiveInfo(Spelling: "@vifilename", Conditional: false,
        Shape: DirectiveShape.TextOrConst, MainOnly: true, Single: true, Version: true,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The version info's original file name (a string, or a string constant's name).");
    Directive.ViCompanyName:
      return DirectiveInfo(Spelling: "@vicompanyname", Conditional: false,
        Shape: DirectiveShape.TextOrConst, MainOnly: true, Single: true, Version: true,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The version info's company name (a string, or a string constant's name).");
    Directive.ViCopyright:
      return DirectiveInfo(Spelling: "@vicopyright", Conditional: false,
        Shape: DirectiveShape.TextOrConst, MainOnly: true, Single: true, Version: true,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The version info's copyright text (a string, or a string constant's name).");
    Directive.ExeIcon:
      return DirectiveInfo(Spelling: "@exeicon", Conditional: false,
        Shape: DirectiveShape.TextOrConst, MainOnly: true, Single: true, Version: false,
        PathArgument: 0, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The exe's icon, an icon file: its file icon on Windows, its window's icon on other targets.");
    Directive.AddModulePath:
      return DirectiveInfo(Spelling: "@addmodulepath", Conditional: false,
        Shape: DirectiveShape.Text, MainOnly: true, Single: false, Version: false,
        PathArgument: 0, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "Adds a folder where `import` finds units: `@addmodulepath \"$P:src\";`");
    Directive.OutputPath:
      return DirectiveInfo(Spelling: "@outputpath", Conditional: false,
        Shape: DirectiveShape.Text, MainOnly: true, Single: true, Version: false,
        PathArgument: 0, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The build's output folder; `adam -o` wins over it.");
    Directive.Target:
      return DirectiveInfo(Spelling: "@target", Conditional: false,
        Shape: DirectiveShape.Text, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "The build's target triple: `@target \"x86_64-linux-gnu\";`. `adam -t` wins over it.");
    Directive.CopyDLL:
      return DirectiveInfo(Spelling: "@copydll", Conditional: false,
        Shape: DirectiveShape.Text, MainOnly: false, Single: false, Version: false,
        PathArgument: 0, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "Copies a DLL beside the built program.");
    Directive.LinkLibrary:
      return DirectiveInfo(Spelling: "@linklibrary", Conditional: false,
        Shape: DirectiveShape.Text, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "Links a library by name: `@linklibrary \"user32\";`");
    Directive.AddLibraryPath:
      return DirectiveInfo(Spelling: "@addlibrarypath", Conditional: false,
        Shape: DirectiveShape.Text, MainOnly: false, Single: false, Version: false,
        PathArgument: 0, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "Adds a folder searched for `@linklibrary` and `external` libraries.");
    Directive.Breakpoint:
      return DirectiveInfo(Spelling: "@breakpoint", Conditional: false,
        Shape: DirectiveShape.Bare, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: true, FirstValue: "", SecondValue: "",
        Doc: "A breakpoint: the debugger stops here.");
    Directive.Message:
      return DirectiveInfo(Spelling: "@message", Conditional: false,
        Shape: DirectiveShape.Message, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: true, FirstValue: "", SecondValue: "",
        Doc: "Reports a message when the build reads it: `@message warn \"text\";` (hint, warn, error or fatal).");
    Directive.AddResData:
      return DirectiveInfo(Spelling: "@addresdata", Conditional: false,
        Shape: DirectiveShape.KeyPath, MainOnly: false, Single: false, Version: false,
        PathArgument: 1, InBody: false, FirstValue: "", SecondValue: "",
        Doc: "Builds a file into the binary under a key, read back when it runs with `FindResData`: `@addresdata \"logo\" \"$P:logo.png\";`");
    Directive.Define:
      return DirectiveInfo(Spelling: "@define", Conditional: true,
        Shape: DirectiveShape.Name, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: true, FirstValue: "", SecondValue: "",
        Doc: "Defines a name for the conditional directives: `@define FAST`");
    Directive.Undef:
      return DirectiveInfo(Spelling: "@undef", Conditional: true,
        Shape: DirectiveShape.Name, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: true, FirstValue: "", SecondValue: "",
        Doc: "Removes a defined name: `@undef FAST`");
    Directive.Ifdef:
      return DirectiveInfo(Spelling: "@ifdef", Conditional: true,
        Shape: DirectiveShape.Name, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: true, FirstValue: "", SecondValue: "",
        Doc: "Compiles what follows only when the name is defined: `@ifdef DEBUG .. @endif`");
    Directive.Ifndef:
      return DirectiveInfo(Spelling: "@ifndef", Conditional: true,
        Shape: DirectiveShape.Name, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: true, FirstValue: "", SecondValue: "",
        Doc: "Compiles what follows only when the name is not defined: `@ifndef TARGET_X86_64_WINDOWS_GNU .. @endif`");
    Directive.Elseif:
      return DirectiveInfo(Spelling: "@elseif", Conditional: true,
        Shape: DirectiveShape.Name, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: true, FirstValue: "", SecondValue: "",
        Doc: "In an `@ifdef` / `@ifndef`, the next branch, taken when its name is defined.");
    Directive.Else:
      return DirectiveInfo(Spelling: "@else", Conditional: true,
        Shape: DirectiveShape.Bare, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: true, FirstValue: "", SecondValue: "",
        Doc: "In an `@ifdef` / `@ifndef`, the branch taken when no other was.");
    Directive.Endif:
      return DirectiveInfo(Spelling: "@endif", Conditional: true,
        Shape: DirectiveShape.Bare, MainOnly: false, Single: false, Version: false,
        PathArgument: -1, InBody: true, FirstValue: "", SecondValue: "",
        Doc: "Ends an `@ifdef` / `@ifndef`.");
  end;
end;

// How the source spells ADirective ("@optimize")
public func DirectiveText(const ADirective: Directive): string;
begin
  return DirectiveRow(ADirective).Spelling;
end;

// The directive ASpelling names into ADirective; false for a spelling that names none
public func DirectiveOf(const ASpelling: string; var ADirective: Directive): bool;
var
  LDirective: Directive;
begin
  for LDirective := Directive.Optimize to Directive.Endif do
    if DirectiveText(LDirective) = ASpelling then
      ADirective := LDirective;
      return true;
    end;
  end;
  return false;
end;

// True when ASpelling is the directive ADirective
public func IsDirective(const ASpelling: string; const ADirective: Directive): bool;
begin
  return ASpelling = DirectiveText(ADirective);
end;

// The row of no intrinsic (Intrinsic.None): no spelling, a plain value
func DoNoIntrinsic(): IntrinsicInfo;
begin
  return IntrinsicInfo(Spelling: "", Statement: false, TypeArgument: false,
    Family: IntrinsicFamily.Plain, Internal: false, Signature: "", Doc: "");
end;

// The facts of AIntrinsic: the one intrinsic table (BNF sec 7, sec 8's asserts); None has
// no spelling
public func IntrinsicRow(const AIntrinsic: Intrinsic): IntrinsicInfo;
begin
  match AIntrinsic of
    Intrinsic.None:
      return DoNoIntrinsic();
    Intrinsic.Len:
      return IntrinsicInfo(Spelling: "len", Statement: false, TypeArgument: false,
        Family: IntrinsicFamily.Plain, Internal: false,
        Signature: ADAM_MSG_SEMANTICS_SIG_LENGTH,
        Doc: "The length of a string, a wstring or an array: `len(\"four\")` is 4.");
    Intrinsic.Size:
      return IntrinsicInfo(Spelling: "size", Statement: false, TypeArgument: true,
        Family: IntrinsicFamily.Plain, Internal: false,
        Signature: ADAM_MSG_SEMANTICS_SIG_TYPE,
        Doc: "The size of a type in bytes: `size(int64)` is 8.");
    Intrinsic.UTF8:
      return IntrinsicInfo(Spelling: "utf8", Statement: false, TypeArgument: false,
        Family: IntrinsicFamily.Plain, Internal: false,
        Signature: ADAM_MSG_SEMANTICS_SIG_WSTRING,
        Doc: "A wstring's text as a UTF-8 string.");
    Intrinsic.ParamCount:
      return IntrinsicInfo(Spelling: "paramcount", Statement: false, TypeArgument: false,
        Family: IntrinsicFamily.Plain, Internal: false,
        Signature: ADAM_MSG_SEMANTICS_SIG_NONE,
        Doc: "How many command-line arguments the program got, after its own name.");
    Intrinsic.ParamStr:
      return IntrinsicInfo(Spelling: "paramstr", Statement: false, TypeArgument: false,
        Family: IntrinsicFamily.Plain, Internal: false,
