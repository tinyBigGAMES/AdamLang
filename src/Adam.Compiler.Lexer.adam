    Intrinsic.ResizeMem:
      return IntrinsicInfo(Spelling: "resizemem", Statement: false, TypeArgument: false,
        Family: IntrinsicFamily.Plain, Internal: false,
        Signature: ADAM_MSG_SEMANTICS_SIG_POINTER_INT64,
