        Signature: ADAM_MSG_SEMANTICS_SIG_WEAK,
        Doc: "A `ref` to the object a `weak` watches, nil once it is gone.");
    Intrinsic.Ready:
      return IntrinsicInfo(Spelling: "ready", Statement: false, TypeArgument: false,
        Family: IntrinsicFamily.Plain, Internal: false,
        Signature: ADAM_MSG_SEMANTICS_SIG_TASK,
        Doc: "True once a task's call has ended (a result or an exception), without waiting.");
    Intrinsic.AtomicAdd:
      return IntrinsicInfo(Spelling: "atomicadd", Statement: false, TypeArgument: false,
