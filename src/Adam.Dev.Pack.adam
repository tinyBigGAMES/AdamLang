-------------------------------------------------------------------------------
  Adam.Dev.Pack.adam - adam --dev-pack <spec> (PLAN-LINUX64 PK4, his names
  2026-11-26): the zips a TOML pack spec describes, written by std
  System.Pack, a developer's job (never in the help, as --dev-build-adam).
  Adam's release zips (distro.toml) and its checkpoints (checkpoint.toml)
  are made this way on either host, with no Delphi tool: _distro.cmd and
  _checkpoint.cmd at the project root are one-line wrappers over it.

  Lines, as it goes: the spec; per archive [i/n] its output path, a count
  every ADAM_DEV_PACK_STEP entries while it is written (a big zip never
  looks hung), then its entries and bytes and whether a .sha256 / .minisig
  came with it; the last line PACK OK, or PACK FAILED - <reason> (the
  spec's line and column for a spec error) and false. A path below the
  spec's folder is shown relative to it (distro/Adam-0.1.0-....zip).
*******************************************************************************/

module unit Adam.Dev.Pack;

import System.SysUtils, System.IO, System.Pack, Adam.Core.Messages, Adam.Compiler.Diagnostics;

const
  // A progress line every so many entries of an archive
  ADAM_DEV_PACK_STEP: int64 = 500;

// One line, as it happens
func DoLine(const AText: string);
begin
  // "{}": the line is printed as it is, never read as a format (a path may hold braces)
  println("{}", AText);
  FlushOutput();
end;

// AText with every path below the folder AFolder (`/` between its parts) shown relative to it
func DoShort(const AText: string; const AFolder: string): string;
begin
  if AFolder = "" then
    return AText;
  end;
  return ReplaceStr(AText, AFolder + "/", "");
end;

// The last line of a failed run (PACK FAILED - AWhat, its paths below AFolder relative), then
// false
func DoFailed(const AWhat: string; const AFolder: string): bool;
begin
  DoLine(NoArgs().Str(DoShort(AWhat, AFolder)).Fill(ADAM_MSG_DEV_PACK_FAILED));
  return false;
end;

// Packer.Build's progress routine: a line every ADAM_DEV_PACK_STEP entries
func DoEntry(const AArchive: string; const AEntry: string; const AIndex: int64;
  const ACount: int64);
begin
  if (AIndex > 0) and ((AIndex mod ADAM_DEV_PACK_STEP) = 0) then
    DoLine(NoArgs().Int(AIndex).Int(ACount).Fill(ADAM_MSG_DEV_PACK_PROGRESS));
  end;
end;

// adam --dev-pack ASpec (see the header): true after PACK OK, false after PACK FAILED
public func DevPack(const ASpec: string): bool;
var
  LPacker: Packer;
  LFolder: string;
  LOutput: string;
  LExtras: string;
  LI: int64;
begin
  if ASpec = "" then
    return DoFailed(ADAM_MSG_DEV_PACK_NO_SPEC, "");
  end;
  DoLine(NoArgs().Str(ASpec).Fill(ADAM_MSG_DEV_PACK_SPEC));
  // The spec's folder as System.Pack spells every path it makes full: `/` between parts
  LFolder := ExtractFileDir(ReplaceStr(ResolvePath(ASpec), "\\", "/"));
  if not LPacker.LoadSpec(ASpec) then
    return DoFailed(LPacker.ErrorText(), LFolder);
  end;
  for LI := 0 to LPacker.ArchiveCount() - 1 do
    LOutput := LPacker.ArchiveOutput(LI);
    DoLine(NoArgs().Int(LI + 1).Int(LPacker.ArchiveCount()).Str(
      DoShort(LOutput, LFolder)).Fill(ADAM_MSG_DEV_PACK_ARCHIVE));
    if not LPacker.BuildArchive(LI, DoEntry) then
      return DoFailed(LPacker.ErrorText(), LFolder);
    end;
    LExtras := "";
    if FileExists(LOutput + ".sha256") then
      LExtras := LExtras + ADAM_MSG_DEV_PACK_WITH_SHA256;
    end;
    if FileExists(LOutput + ".minisig") then
      LExtras := LExtras + ADAM_MSG_DEV_PACK_WITH_MINISIG;
    end;
    DoLine(NoArgs().Int(LPacker.EntryCount(LI)).Int(FileSize(LOutput)).Str(LExtras).Fill(
      ADAM_MSG_DEV_PACK_WRITTEN));
  end;
  DoLine(ADAM_MSG_DEV_PACK_OK);
  return true;
end;

end.
