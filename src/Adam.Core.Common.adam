-------------------------------------------------------------------------------
  Adam.Core.Common.adam - The foundation's shared vocabulary

  The compiler's version and identity: the one place they are written. The
  version parts are integer constants (adam.exe's @vimajor / @viminor /
  @vipatch name them) and AdamVersionText joins them, so a bump touches one
  part only. The identity (product, company, copyright, URL) is what the
  banner prints and what adam.exe's version resource is stamped from (its
  @vi* directives name these constants); no part of Adam reads it back from
  a resource.

  ModuleKind    what a module builds (BNF sec 1): an exe, a dll, a lib, or a
                unit (source only, no artifact of its own). None = not known
                yet (a module whose header did not parse).
  OptLevel      a build's optimization level (DESIGN sec 5, BNF's @optimize):
                debug (no optimization, the default), safe (optimized, every
                check kept), fast (speed; index / range checks dropped), small
                (size; the same checks dropped). Its directive name, the
                retired spellings (release_safe ...) and the output cell mode
                (debug, release_safe ...) are written here only
  Bits*         the bit intrinsics' values (BNF sec 7, M9j0: byteswap,
                leadingzeros, trailingzeros, popcount) of an integer's bits
                at its width: the one computation Semantics' fold and the
                optimizer's both use
*******************************************************************************/

module unit Adam.Core.Common;

import System.SysUtils;

public const
  // The version parts (each 0..65535: a version resource holds them as 16-bit words)
  ADAM_MAJOR_VERSION: int32 = 0;
  ADAM_MINOR_VERSION: int32 = 1;
  ADAM_PATCH_VERSION: int32 = 0;

  // The prefix of every symbol the compiler makes (__adam_entry, __adam_test_<module>_<n>,
  // ...): no declaration in Adam source may start with it (SM0017), so none collides
  ADAM_RESERVED_PREFIX: string = "__adam";

  // What a debug build's debug information names for the debugger (DESIGN sec 9, M11a D3):
  // an @breakpoint's label in its routine (where the debugger's first breakpoints are), and
  // the first field of an Adam type the format has no kind for, ADAM_DEBUG_FORM_PREFIX +
  // its form; a form with an element (a dynamic array's, a set's, an owner's object) has
  // that field typed a pointer to it, a set's members follow as one-bit fields by name
  ADAM_DEBUG_BREAKPOINT_LABEL: string = "@breakpoint";
  // A source file under the compiler's own folder starts its name with this (the path token
  // that names that folder in a build, BNF sec 2): the debug information stays the same
  // wherever adam is installed; the debugger reads it from its own compiler's folder
  ADAM_DEBUG_PROGRAM_PREFIX: string = "$P:";
  ADAM_DEBUG_FORM_PREFIX: string = "__adam_form_";
  ADAM_DEBUG_FORM_STRING: string = "string";
  ADAM_DEBUG_FORM_WSTRING: string = "wstring";
  ADAM_DEBUG_FORM_ARRAY: string = "array";
  ADAM_DEBUG_FORM_SET: string = "set";
  ADAM_DEBUG_FORM_REF: string = "ref";
  ADAM_DEBUG_FORM_OWN: string = "own";
  ADAM_DEBUG_FORM_WEAK: string = "weak";
  ADAM_DEBUG_FORM_INTERFACE: string = "interface";
  ADAM_DEBUG_FORM_TASK: string = "task";
  ADAM_DEBUG_FORM_SEQUENCE: string = "sequence";
  ADAM_DEBUG_FORM_OTHER: string = "other";
  // A set's members the debug information names one by one at most (a larger set: its form
  // field alone)
  ADAM_DEBUG_SET_MEMBER_LIMIT: int64 = 256;

  // Adam's identity, written here only: the banner reads it, and an exe's version resource
  // (M8) is written from it; nothing reads it back from an exe
  ADAM_PRODUCT_NAME: string = "Adam™";
  ADAM_COMPANY_NAME: string = "tinyBigGAMES™ LLC";
  ADAM_COPYRIGHT: string = "Copyright © 2026-present " + ADAM_COMPANY_NAME;
  ADAM_URL: string = "https://adamlang.org";

  // The VT (ECMA-48 SGR) sequences adam colors its own console output with: no OS's, a
  // console that takes VT sequences reads them (System.Console's EscapesEnabled turns that
  // on); never written where output is piped
  ADAM_COLOR_RESET: string = "\e[0m";
  ADAM_COLOR_BOLD: string = "\e[1m";
  ADAM_COLOR_RED: string = "\e[91m";
  ADAM_COLOR_YELLOW: string = "\e[93m";
  ADAM_COLOR_GREEN: string = "\e[92m";
  ADAM_COLOR_CYAN: string = "\e[96m";

  // Every official file extension, written here only (his 2026-11-13); compared without case.
  // Adam's own files:
  ADAM_EXT_SOURCE: string = ".adam";
  ADAM_EXT_ACU: string = ".acu";
  ADAM_EXT_REZ: string = ".rez";
  ADAM_EXT_IR: string = ".ir";
  ADAM_EXT_TOML: string = ".toml";
  // An import spec adam cimport runs (M9): TOML under a name of its own (name.cimport.toml),
  // so editors still read it as TOML and adam knows it by its name
  ADAM_EXT_CIMPORT_SPEC: string = ".cimport" + ADAM_EXT_TOML;
  ADAM_EXT_ICON: string = ".ico";
  // The C header a dll or lib build writes for its C callers (M8g)
  ADAM_EXT_C_HEADER: string = ".h";
  // What clang defines before a file, per target (<triple>.predefines.h beside the system
  // headers, M9b): the importer's first input
  ADAM_EXT_C_PREDEFINES: string = ".predefines" + ADAM_EXT_C_HEADER;
  // A C source file: the layout probe adam cimport writes for a C compiler to check (M9g)
  ADAM_EXT_C_SOURCE: string = ".c";
  // The layout probe of a `.C` unit (<unit>.layout.c beside <unit>.adam, M9g)
  ADAM_EXT_LAYOUT_PROBE: string = ".layout" + ADAM_EXT_C_SOURCE;
  // A file being written, renamed over its target once whole
  ADAM_EXT_TEMP: string = ".tmp";
  // The target formats' files: read only by their format parts (AT.2), every phase above
  // asks the part (ExeExtension ...); linux64 adds its own beside them
  ADAM_EXT_COFF_EXE: string = ".exe";
  ADAM_EXT_COFF_DLL: string = ".dll";
  ADAM_EXT_COFF_LIB: string = ".lib";
  // A COFF image's debug file (a PDB, beside the exe / dll, M7d)
  ADAM_EXT_COFF_PDB: string = ".pdb";
  ADAM_EXT_AR: string = ".a";
  // A dll's import archive (name.dll.a)
  ADAM_EXT_COFF_DLL_IMPORT: string = ADAM_EXT_COFF_DLL + ADAM_EXT_AR;
  // An object file's name in a static library (a lib's members, M8d)
  ADAM_EXT_COFF_OBJ: string = ".o";
  // An ELF shared object (linux64's dll, lib<name>.so)
  ADAM_EXT_ELF_SO: string = ".so";
  // An ELF object file's name in a static library (a lib's members, PLAN-LINUX64 LX2b)
  ADAM_EXT_ELF_OBJ: string = ".o";
  // A shared C runtime's version table (glibc.abi: each symbol's version and shared
  // library, the ELF linker's, PLAN-LINUX64 LX3b)
  ADAM_EXT_SHARED_TABLE: string = ".abi";

  // The program files Adam ships, as their version resources name them (@vifilename)
  ADAM_COMPILER_EXE: string = "adam" + ADAM_EXT_COFF_EXE;
  ADAM_TESTER_EXE: string = "adamtest" + ADAM_EXT_COFF_EXE;
  // The Adam logo icon they carry (@exeicon): his file in bin\res\assets, $R: their
  // project folder (projects\adam, projects\adamtest)
  ADAM_LOGO_ICON: string = "$R:../../bin/res/assets/icons/adam" + ADAM_EXT_ICON;
  // The packaged editor (Electron) beside adam, one folder per host: res\editor\win-x64 for
  // the win64 host (res\editor\linux-x64 is the linux host's, used once the editor and
  // debugger run there); adam editor starts it, adam --dev-editor packs and stamps it
  ADAM_EDITOR_FOLDER: string = "$P:res/editor/win-x64";

  // The name of the runtime's companion static library a lib build writes beside its own
  // (M8d: the shared std and runtime units, libadamrt.a), which a C program links once for
  // every Adam lib it links
  ADAM_RUNTIME_LIBRARY: string = "adamrt";

public type
  // What a module builds (BNF sec 1 module kind)
  ModuleKind = choices(None, Exe, Dll, Lib, Unit);

  // A build's optimization level (BNF's @optimize, the -opt option)
  OptLevel = choices(Debug, Safe, Fast, Small);

// The compiler's version as text, major.minor.patch ("0.1.0"): what the banner prints and
// an .acu's header records
public routine AdamVersionText(): string;
begin
  return IntToStr(ADAM_MAJOR_VERSION) + "." + IntToStr(ADAM_MINOR_VERSION) + "." +
    IntToStr(ADAM_PATCH_VERSION);
end;

// The name ALevel is written with in @optimize and -opt: debug, safe, fast, small
public routine OptLevelName(const ALevel: OptLevel): string;
begin
  match ALevel of
    OptLevel.Debug: return "debug";
    OptLevel.Safe: return "safe";
    OptLevel.Fast: return "fast";
    OptLevel.Small: return "small";
  end;
  return "";
end;

// The level AName names (exact case) into ALevel; false when it names none
public routine OptLevelOfName(const AName: string; var ALevel: OptLevel): bool;
begin
  ALevel := OptLevel.Debug;
  if AName = "debug" then
    return true;
  end;
  if AName = "safe" then
    ALevel := OptLevel.Safe;
    return true;
  end;
  if AName = "fast" then
    ALevel := OptLevel.Fast;
    return true;
  end;
  if AName = "small" then
    ALevel := OptLevel.Small;
    return true;
  end;
  return false;
end;

// The level a retired spelling (release_safe, release_fast, release_small) became into
// ALevel; false when AName is no retired spelling
public routine OptLevelOfRetiredName(const AName: string; var ALevel: OptLevel): bool;
begin
  ALevel := OptLevel.Debug;
  if AName = "release_safe" then
    ALevel := OptLevel.Safe;
    return true;
  end;
  if AName = "release_fast" then
    ALevel := OptLevel.Fast;
    return true;
  end;
  if AName = "release_small" then
    ALevel := OptLevel.Small;
    return true;
  end;
  return false;
end;

// Every level's name, as an error lists the accepted ones: "debug, safe, fast, small"
public routine OptLevelNames(): string;
begin
  return OptLevelName(OptLevel.Debug) + ", " + OptLevelName(OptLevel.Safe) + ", " +
    OptLevelName(OptLevel.Fast) + ", " + OptLevelName(OptLevel.Small);
end;

// The output cell mode a build at ALevel is kept under (<kind>\<triple>\<mode>\) and a compiled
// unit's header records: debug, else release_ and the level's name
public routine OptLevelMode(const ALevel: OptLevel): string;
begin
  if ALevel = OptLevel.Debug then
    return OptLevelName(ALevel);
  end;
  return "release_" + OptLevelName(ALevel);
end;

// True when a build at ALevel keeps the index and range checks the language does not promise at
// every level (DESIGN sec 5: debug and safe keep every check; fast and small drop these)
public routine OptLevelKeepsIndexChecks(const ALevel: OptLevel): bool;
begin
  return (ALevel = OptLevel.Debug) or (ALevel = OptLevel.Safe);
end;

// The name of AKind, as a row or a dump prints it
public routine ModuleKindText(const AKind: ModuleKind): string;
begin
  match AKind of
    ModuleKind.None: return "None";
    ModuleKind.Exe: return "Exe";
    ModuleKind.Dll: return "Dll";
    ModuleKind.Lib: return "Lib";
    ModuleKind.Unit: return "Unit";
  end;
  return "";
end;

// The low AWidth bits (8, 16, 32 or 64) of ABits; the rest zero
routine DoLowBits(const ABits: uint64; const AWidth: int64): uint64;
begin
  if AWidth >= 64 then
    return ABits;
  end;
  return ABits & ((uint64(1) shl uint64(AWidth)) - uint64(1));
end;

// byteswap of the AWidth-bit value ABits: its AWidth / 8 low bytes in reverse order (a 1-byte
// value is itself)
public routine BitsByteSwap(const ABits: uint64; const AWidth: int64): uint64;
var
  LValue: uint64;
  LResult: uint64;
  LI: int64;
begin
  LValue := DoLowBits(ABits, AWidth);
  LResult := 0;
  for LI := 1 to AWidth div 8 do
    LResult := (LResult shl uint64(8)) | (LValue & uint64(0xFF));
    LValue := LValue shr uint64(8);
  end;
  return LResult;
end;

// leadingzeros of the AWidth-bit value ABits: its zero bits above its highest set one (AWidth
// for 0)
public routine BitsLeadingZeros(const ABits: uint64; const AWidth: int64): int64;
var
  LValue: uint64;
  LCount: int64;
  LBit: int64;
begin
  LValue := DoLowBits(ABits, AWidth);
  LCount := 0;
  LBit := AWidth - 1;
  while (LBit >= 0) and (((LValue shr uint64(LBit)) & uint64(1)) = uint64(0)) do
    LCount := LCount + 1;
    LBit := LBit - 1;
  end;
  return LCount;
end;

// trailingzeros of the AWidth-bit value ABits: its zero bits below its lowest set one (AWidth
// for 0)
public routine BitsTrailingZeros(const ABits: uint64; const AWidth: int64): int64;
var
  LValue: uint64;
  LCount: int64;
begin
  LValue := DoLowBits(ABits, AWidth);
  LCount := 0;
  while (LCount < AWidth) and (((LValue shr uint64(LCount)) & uint64(1)) = uint64(0)) do
    LCount := LCount + 1;
  end;
  return LCount;
end;

// popcount of the AWidth-bit value ABits: its set bits
public routine BitsPopCount(const ABits: uint64; const AWidth: int64): int64;
var
  LValue: uint64;
  LCount: int64;
begin
  LValue := DoLowBits(ABits, AWidth);
  LCount := 0;
  while LValue <> uint64(0) do
    // clears the lowest set bit
    LValue := LValue & (LValue - uint64(1));
    LCount := LCount + 1;
  end;
  return LCount;
end;

end.
