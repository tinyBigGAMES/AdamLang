-------------------------------------------------------------------------------
  Adam.Core.Common.adam - The foundation's shared vocabulary

  The compiler's version and identity: the one place they are written. The
  version parts are strings and ADAM_VERSION_STR is joined from them, so a
  bump touches one part only. The identity (product, company, copyright,
  URL) is what the banner prints and what M8's version resource is written
  from; no part of Adam reads it from a resource.

  ModuleKind    what a module builds (BNF sec 1): an exe, a dll, a lib, or a
                unit (source only, no artifact of its own). None = not known
                yet (a module whose header did not parse).
*******************************************************************************/

module unit Adam.Core.Common;

exported const
  ADAM_MAJOR_VERSION: string = "0";
  ADAM_MINOR_VERSION: string = "1";
  ADAM_PATCH_VERSION: string = "0";
  ADAM_VERSION_STR: string = ADAM_MAJOR_VERSION + "." + ADAM_MINOR_VERSION + "." + ADAM_PATCH_VERSION;

  // Adam's identity, written here only: the banner reads it, and an exe's version resource
  // (M8) is written from it; nothing reads it back from an exe
  ADAM_PRODUCT_NAME: string = "Adam™";
  ADAM_COMPANY_NAME: string = "tinyBigGAMES™ LLC";
  ADAM_COPYRIGHT: string = "Copyright © 2026-present " + ADAM_COMPANY_NAME;
  ADAM_URL: string = "https://adamlang.org";

  // The VT (ECMA-48 SGR) sequences adam colors its own console output with: no OS's, a
  // console that takes VT sequences reads them (System.Windows' EnableConsoleColor turns that
  // on); never written where output is piped
  ADAM_COLOR_RESET: string = "\e[0m";
  ADAM_COLOR_BOLD: string = "\e[1m";
  ADAM_COLOR_RED: string = "\e[91m";
  ADAM_COLOR_YELLOW: string = "\e[93m";
  ADAM_COLOR_GREEN: string = "\e[92m";
  ADAM_COLOR_CYAN: string = "\e[96m";

exported type
  // What a module builds (BNF sec 1 module kind)
  ModuleKind = choices(None, Exe, Dll, Lib, Unit);

// The name of AKind, as a row or a dump prints it
exported routine ModuleKindText(const AKind: ModuleKind): string;
begin
  match AKind of
    ModuleKind.None: return "None";
    ModuleKind.Exe: return "Exe";
    ModuleKind.Dll: return "Dll";
    ModuleKind.Lib: return "Lib";
    ModuleKind.Unit: return "Unit";
  end;
  return "";
end;

end.
