  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  Adam.Coff.Archive.adam - an ar archive read and written: a static lib (.a /
  .lib) or an import lib (.dll.a / import .lib), DESIGN sec 7

  Every layout fact is Microsoft's "PE Format" page (Archive (Library) File
  Format: Archive File Signature, Archive Member Headers, First Linker
  Member, Longnames Member; Import Library Format: Import Header), the same
  layout GNU ar writes for COFF (the fixtures of PLAN-ADAM M3.13 are zig's).

  ReadArchive   an archive's bytes -> its members in file order, each with
                its header's offset, its data's offset and size and its
                name (a special member's "/" or "//", else the name with its
                ending '/' dropped, a "/N" name read from the long-name
                table "//" up to its '/', LF or NUL), each classed: the
                symbol index (both linker members, "/"), the long-name
                table, a short import (its data starts 00 00 FF FF: the
                symbol, the DLL, the Machine, the ordinal / hint, the import
                type and the name type its Import Header holds) or a COFF
                object. Then the first linker member's symbol index
                (big-endian count and member header offsets, NUL-ended
                names), each symbol tied to the member whose header is at
                its offset. The second (MS) linker member holds the same
                symbols sorted; it is kept as a member and not read.
  ImportNameOf  the name a short import is imported by, by its name type.
  WriteArchive  members (a name, bytes, the symbols each defines) as an
                archive, laid out as MS's lib and llvm's COFF archives are:
                the signature, the first linker member (big-endian count,
                an offset per symbol, the names, in member order), the
                second linker member (the member count and offsets, the
                symbol count, a 16-bit member number per symbol and the
                names, sorted byte-wise), the long-name table when a name
                is over 15 bytes (each once, NUL-ended; the member's name
                field "/N"), then the members, each at an even offset (an
                LF pads). Deterministic: date, ids 0, mode 644 (AD.7).
  WriteImportArchive  a DLL's import library (M8b), llvm-dlltool's member
                set so link.exe, GNU ld and lld take it as Adam's linker
                does: the import descriptor object (__IMPORT_DESCRIPTOR_<dll
                stem>: the .idata$2 directory entry, its tables at the start
                of the image's .idata$4 and .idata$5, its name in .idata$6),
                the null import descriptor (__NULL_IMPORT_DESCRIPTOR,
                .idata$3), the null thunk (DEL <dll stem>_NULL_THUNK_DATA,
                the zero ends of .idata$5 and .idata$4), each a COFF object
                Adam.Coff.Writer writes from a SectionSet; then one short
                import per export, by name, its hint its place in the DLL's
                sorted name pointer table: a routine Code (defining its name
                and __imp_<name>), a variable Data (__imp_<name> only).

  Nothing raises: a file that is no archive, a header cut off or damaged, a
  long name the table does not hold, a symbol index cut off or pointing
  where no member starts, a short import that does not hold its two names
  are reported (AR codes) at the place the caller gives, and false is
  returned. Machine, version and time stamp are the linker's to check. The
  writer raises (a compiler bug) for a symbol two members define and for a
  field a member header cannot hold.
*******************************************************************************/

module unit Adam.Coff.Archive;

import System.SysUtils, Adam.Core.Messages, Adam.Core.Containers, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics, Adam.Backend.Sections, Adam.Coff.Writer, System.Windows;

public const
  // Reported (see the header)
  ADAM_ERR_ARCHIVE_001: string = "AR0001";   // a file that is no archive
  ADAM_ERR_ARCHIVE_002: string = "AR0002";   // a member header cut off or damaged
  ADAM_ERR_ARCHIVE_003: string = "AR0003";   // a long name the table does not hold
  ADAM_ERR_ARCHIVE_004: string = "AR0004";   // a symbol index cut off or pointing nowhere
  ADAM_ERR_ARCHIVE_005: string = "AR0005";   // a short import that does not hold its names

  // The archive signature, and a member header's size and fields (Archive Member Headers)
  ADAM_ARCHIVE_NAME_SIZE: int64 = 16;
  ADAM_ARCHIVE_SIZE_AT: int64 = 48;
  ADAM_ARCHIVE_SIZE_SIZE: int64 = 10;
  ADAM_ARCHIVE_END_AT: int64 = 58;
  // The special members' names
  ADAM_ARCHIVE_INDEX_NAME: string = "/";
  ADAM_ARCHIVE_TABLE_NAME: string = "//";
  // A short import's Import Header: its size, the offsets of its Ordinal/Hint and Type
  ADAM_ARCHIVE_IMPORT_HEADER: int64 = 20;
  ADAM_ARCHIVE_IMPORT_MACHINE_AT: int64 = 6;
  ADAM_ARCHIVE_IMPORT_HINT_AT: int64 = 16;
  ADAM_ARCHIVE_IMPORT_TYPE_AT: int64 = 18;
  // The rest of an Import Header the writer fills: Sig2 and its value, SizeOfData, the Type
  // field's import types and name type (Import Type, Import Name Type)
  ADAM_ARCHIVE_IMPORT_SIG2_AT: int64 = 2;
  ADAM_ARCHIVE_IMPORT_SIZE_AT: int64 = 12;
  ADAM_ARCHIVE_IMPORT_NAMING_SHIFT: int64 = 2;

  // Raised by the writer (see the header)
  ADAM_ARCHIVE_FAULT_SYMBOL_TWICE: string = "Archive writer: a symbol two members define: ";
  ADAM_ARCHIVE_FAULT_FIELD: string = "Archive writer: a member header field too long: ";
  // A member header's fields after its name (Archive Member Headers): Date, User ID and
  // Group ID, Mode (octal); the mode a member is written with
  ADAM_ARCHIVE_DATE_SIZE: int64 = 12;
  ADAM_ARCHIVE_ID_SIZE: int64 = 6;
  ADAM_ARCHIVE_MODE_SIZE: int64 = 8;
  ADAM_ARCHIVE_MEMBER_MODE: string = "644";
  // The longest name a member header holds itself (then its ending '/')
  ADAM_ARCHIVE_SHORT_NAME_MAX: int64 = 15;
  // An import library's objects (see the header): their sections, the descriptor's size and
  // alignment and its fields' offsets (Import Directory Table), a thunk's size (PE32+)
  ADAM_ARCHIVE_IDATA_ENTRY: string = ".idata$2";
  ADAM_ARCHIVE_IDATA_END: string = ".idata$3";
  ADAM_ARCHIVE_IDATA_LOOKUP: string = ".idata$4";
  ADAM_ARCHIVE_IDATA_ADDRESSES: string = ".idata$5";
  ADAM_ARCHIVE_IDATA_NAMES: string = ".idata$6";
  ADAM_ARCHIVE_DESCRIPTOR_SIZE: int64 = 20;
  ADAM_ARCHIVE_DESCRIPTOR_ALIGN: int64 = 4;
  ADAM_ARCHIVE_DESCRIPTOR_LOOKUP_AT: int64 = 0;
  ADAM_ARCHIVE_DESCRIPTOR_NAME_AT: int64 = 12;
  ADAM_ARCHIVE_DESCRIPTOR_ADDRESSES_AT: int64 = 16;
  ADAM_ARCHIVE_THUNK_SIZE: int64 = 8;
  // Their symbols: the descriptor's (then the DLL's stem), the null descriptor's, the null
  // thunk's (DEL, the stem, then the suffix), the descriptor's own name of its DLL's name
  ADAM_ARCHIVE_DESCRIPTOR_PREFIX: string = "__IMPORT_DESCRIPTOR_";
  ADAM_ARCHIVE_NULL_DESCRIPTOR: string = "__NULL_IMPORT_DESCRIPTOR";
  ADAM_ARCHIVE_NULL_THUNK_LEAD: int64 = 0x7F;
  ADAM_ARCHIVE_NULL_THUNK_SUFFIX: string = "_NULL_THUNK_DATA";
  ADAM_ARCHIVE_DLL_NAME_SYMBOL: string = "__adam_import_dll_name";

public type
  // What one member holds (see the header)
  MemberKind = choices(SymbolIndex, NameTable, CoffObject, ShortImport);

  // A short import's Import Type (its Type field's bits 0-1)
  ImportKind = choices(Code, Data, Constant, Reserved);

  // A short import's Import Name Type (its Type field's bits 2-4)
  ImportNaming = choices(Ordinal, Name, NoPrefix, Undecorate, ExportAs, Reserved);

  // One member (see the header); the Import* fields only for a ShortImport
  ArchiveMember = record
    Kind: MemberKind;
    MemberName: string;
    HeaderAt: int64;
    DataAt: int64;
    Size: int64;
    ImportSymbol: string;
    ImportDll: string;
    ImportMachine: int64;
    OrdinalHint: int64;
    Imported: ImportKind;
    Naming: ImportNaming;
  end;

  // An archive's members, in file order
  ArchiveMemberArray = array of ArchiveMember;

  // One symbol of the symbol index: its name and the member (an index into Members) that
  // defines it
  ArchiveSymbol = record
    SymbolName: string;
    Member: int64;
  end;

  // The symbol index's symbols, in its order
  ArchiveSymbolArray = array of ArchiveSymbol;

  // One archive read (see the header)
  ArchiveData = record
    Members: ArchiveMemberArray;
    Symbols: ArchiveSymbolArray;
  end;

  // One member WriteArchive writes: the name a linker reports it by, its bytes, the symbols
  // it defines (the symbol index's, in this order)
  ArchiveInput = record
    MemberName: string;
    Bytes: ByteArray;
    Defines: StringArray;
  end;

  // The members WriteArchive writes, in file order
  ArchiveInputArray = array of ArchiveInput;

// The ACount bytes at AAt in ABytes as text, each byte one char (one block copy)
routine DoText(const ABytes: ByteArray; const AAt: int64; const ACount: int64): string;
begin
  if ACount <= 0 then
    return "";
  end;
  return StringFromC(ptr to const char(addr of ABytes[AAt]), ACount);
end;

// The index of the first NUL byte in ABytes from AAt up to AEnd (not included); -1 when
// there is none
routine DoNulAt(const ABytes: ByteArray; const AAt: int64; const AEnd: int64): int64;
var
  LI: int64;
begin
  LI := AAt;
  while LI < AEnd do
    if ABytes[LI] = 0 then
      return LI;
    end;
    LI := LI + 1;
  end;
  return -1;
end;

// The big-endian 32-bit value at AAt in ABytes (the first linker member's numbers)
routine DoGetBe32(const ABytes: ByteArray; const AAt: int64): int64;
begin
  return (int64(ABytes[AAt]) shl 24) | (int64(ABytes[AAt + 1]) shl 16) |
    (int64(ABytes[AAt + 2]) shl 8) | int64(ABytes[AAt + 3]);
end;

// True when ABytes start with the archive signature
routine DoHasSignature(const ABytes: ByteArray): bool;
begin
  if len(ABytes) < len(IMAGE_ARCHIVE_START) then
    return false;
  end;
  return DoText(ABytes, 0, len(IMAGE_ARCHIVE_START)) = IMAGE_ARCHIVE_START;
end;

// Reports the member header at AAt in APath damaged for AReason (AR0002): false
routine DoBadHeader(const ADiagnostics: ref Diagnostics; const APlace: SourcePlace;
  const APath: string; const AAt: int64; const AReason: string): bool;
begin
  ADiagnostics.Add(Severity.Error, ADAM_ERR_ARCHIVE_002, APlace, ADAM_MSG_ARCHIVE_BAD_HEADER,
    NoArgs().Str(APath).Int(AAt).Str(AReason));
  return false;
end;

// Adds AMember at the end of AList
routine DoAddMember(var AList: ArchiveMemberArray; const AMember: ArchiveMember);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := AMember;
end;

// A member read from its header at AHeaderAt: ARawName its name field as written (blanks
// cut), its data right after the header, ASize bytes; classed by its name only (imports are
// found later)
routine DoMember(const ARawName: string; const AHeaderAt: int64; const ASize: int64): ArchiveMember;
var
  LMember: ArchiveMember;
begin
  LMember.Kind := MemberKind.CoffObject;
  if ARawName = ADAM_ARCHIVE_INDEX_NAME then
    LMember.Kind := MemberKind.SymbolIndex;
  end;
  if ARawName = ADAM_ARCHIVE_TABLE_NAME then
    LMember.Kind := MemberKind.NameTable;
  end;
  LMember.MemberName := ARawName;
  LMember.HeaderAt := AHeaderAt;
  LMember.DataAt := AHeaderAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR;
  LMember.Size := ASize;
  LMember.ImportSymbol := "";
  LMember.ImportDll := "";
  LMember.ImportMachine := 0;
  LMember.OrdinalHint := 0;
  LMember.Imported := ImportKind.Code;
  LMember.Naming := ImportNaming.Name;
  return LMember;
end;

// Reads every member header from the signature to the file's end into AArchive.Members
// (names as written); a header cut off or damaged is reported (AR0002): false
routine DoReadHeaders(const ABytes: ByteArray; const APath: string; const APlace: SourcePlace;
  const ADiagnostics: ref Diagnostics; var AArchive: ArchiveData): bool;
var
  LAt: int64;
  LSize: int64;
  LName: string;
begin
  LAt := len(IMAGE_ARCHIVE_START);
  while LAt < len(ABytes) do
    if LAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR > len(ABytes) then
      return DoBadHeader(ADiagnostics, APlace, APath, LAt, ADAM_MSG_ARCHIVE_REASON_CUT);
    end;
    LSize := 0;
    if not TryStrToInt(Trim(DoText(ABytes, LAt + ADAM_ARCHIVE_SIZE_AT, ADAM_ARCHIVE_SIZE_SIZE)),
      LSize) or (LSize < 0) then
      return DoBadHeader(ADiagnostics, APlace, APath, LAt, ADAM_MSG_ARCHIVE_REASON_SIZE);
    end;
    if (ABytes[LAt + ADAM_ARCHIVE_END_AT] <> 0x60) or (ABytes[LAt + ADAM_ARCHIVE_END_AT + 1] <> 0x0A) then
      return DoBadHeader(ADiagnostics, APlace, APath, LAt, ADAM_MSG_ARCHIVE_REASON_END);
    end;
    if LAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR + LSize > len(ABytes) then
      return DoBadHeader(ADiagnostics, APlace, APath, LAt, ADAM_MSG_ARCHIVE_REASON_DATA);
    end;
    LName := TrimRight(DoText(ABytes, LAt, ADAM_ARCHIVE_NAME_SIZE));
    DoAddMember(AArchive.Members, DoMember(LName, LAt, LSize));
    // The next header starts on an even offset
    LAt := LAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR + LSize;
    if LAt mod 2 = 1 then
      LAt := LAt + 1;
    end;
  end;
  return true;
end;

// AName without its one ending '/' (how a member's name field and a long name end)
routine DoDropSlash(const AName: string): string;
begin
  if EndsStr("/", AName) then
    return Substring(AName, 0, len(AName) - 1);
  end;
  return AName;
end;

// The index of the long-name table among AArchive.Members; -1 when it has none
routine DoTableIndex(const AArchive: ArchiveData): int64;
var
  LI: int64;
begin
  for LI := 0 to len(AArchive.Members) - 1 do
    if AArchive.Members[LI].Kind = MemberKind.NameTable then
      return LI;
    end;
  end;
  return -1;
end;

// The long name at AOffset in the long-name table AArchive.Members[ATable]: its bytes up to
// the first LF or NUL (or the table's end), its ending '/' dropped
routine DoLongName(const ABytes: ByteArray; const AArchive: ArchiveData; const ATable: int64;
  const AOffset: int64): string;
var
  LAt: int64;
  LEnd: int64;
begin
  LAt := AArchive.Members[ATable].DataAt + AOffset;
  LEnd := AArchive.Members[ATable].DataAt + AArchive.Members[ATable].Size;
  while (LAt < LEnd) and (ABytes[LAt] <> 0x0A) and (ABytes[LAt] <> 0) do
    LAt := LAt + 1;
  end;
  return DoDropSlash(DoText(ABytes, AArchive.Members[ATable].DataAt + AOffset,
    LAt - AArchive.Members[ATable].DataAt - AOffset));
end;

// Every object member's name as it is meant: a "/N" name read from the long-name table, any
// other its ending '/' dropped. A long name the table does not hold is reported (AR0003):
// false
routine DoResolveNames(const ABytes: ByteArray; const APath: string; const APlace: SourcePlace;
  const ADiagnostics: ref Diagnostics; var AArchive: ArchiveData): bool;
var
  LTable: int64;
  LI: int64;
  LRaw: string;
  LOffset: int64;
  LReason: string;
begin
  LTable := DoTableIndex(AArchive);
  for LI := 0 to len(AArchive.Members) - 1 do
    LRaw := AArchive.Members[LI].MemberName;
    if AArchive.Members[LI].Kind = MemberKind.CoffObject then
      LOffset := -1;
      // "/N": the long name at offset N of the table
      if StartsStr("/", LRaw) and TryStrToInt(Substring(LRaw, 1, len(LRaw) - 1), LOffset) then
        LReason := "";
        if LTable < 0 then
          LReason := ADAM_MSG_ARCHIVE_REASON_NO_TABLE;
        else
          if (LOffset < 0) or (LOffset >= AArchive.Members[LTable].Size) then
            LReason := ADAM_MSG_ARCHIVE_REASON_PAST_TABLE;
          end;
        end;
        if LReason <> "" then
          ADiagnostics.Add(Severity.Error, ADAM_ERR_ARCHIVE_003, APlace,
            ADAM_MSG_ARCHIVE_BAD_LONG_NAME, NoArgs().Str(APath)
            .Int(AArchive.Members[LI].HeaderAt).Str(LRaw).Str(LReason));
          return false;
        end;
        AArchive.Members[LI].MemberName := DoLongName(ABytes, AArchive, LTable, LOffset);
      else
        AArchive.Members[LI].MemberName := DoDropSlash(LRaw);
      end;
    end;
  end;
  return true;
end;

// The Import Type held in a short import's Type field ATypeField (bits 0-1)
routine DoImportKind(const ATypeField: int64): ImportKind;
var
  LBits: int64;
begin
  LBits := ATypeField & 3;
  if LBits = 0 then
    return ImportKind.Code;
  end;
  if LBits = 1 then
    return ImportKind.Data;
  end;
  if LBits = 2 then
    return ImportKind.Constant;
  end;
  return ImportKind.Reserved;
end;

// The Import Name Type held in a short import's Type field ATypeField (bits 2-4)
routine DoImportNaming(const ATypeField: int64): ImportNaming;
var
  LBits: int64;
begin
  LBits := (ATypeField shr 2) & 7;
  if LBits = 0 then
    return ImportNaming.Ordinal;
  end;
  if LBits = 1 then
    return ImportNaming.Name;
  end;
  if LBits = 2 then
    return ImportNaming.NoPrefix;
  end;
  if LBits = 3 then
    return ImportNaming.Undecorate;
  end;
  if LBits = 4 then
    return ImportNaming.ExportAs;
  end;
  return ImportNaming.Reserved;
end;

// True when the member AMember's data starts as a short import's does: 00 00 FF FF
routine DoIsShortImport(const ABytes: ByteArray; const AMember: ArchiveMember): bool;
begin
  if AMember.Size < 4 then
    return false;
  end;
  return (ABytes[AMember.DataAt] = 0) and (ABytes[AMember.DataAt + 1] = 0) and
    (ABytes[AMember.DataAt + 2] = 0xFF) and (ABytes[AMember.DataAt + 3] = 0xFF);
end;

// Every object member that is a short import read as one (its Import Header, then the
// NUL-ended symbol and DLL names); one too short to hold them is reported (AR0005): false
routine DoReadImports(const ABytes: ByteArray; const APath: string; const APlace: SourcePlace;
  const ADiagnostics: ref Diagnostics; var AArchive: ArchiveData): bool;
var
  LI: int64;
  LAt: int64;
  LEnd: int64;
  LSymbolEnd: int64;
  LDllEnd: int64;
  LType: int64;
begin
  for LI := 0 to len(AArchive.Members) - 1 do
    if (AArchive.Members[LI].Kind = MemberKind.CoffObject) and
      DoIsShortImport(ABytes, AArchive.Members[LI]) then
      LAt := AArchive.Members[LI].DataAt;
      LEnd := LAt + AArchive.Members[LI].Size;
      LSymbolEnd := -1;
      LDllEnd := -1;
      if AArchive.Members[LI].Size >= ADAM_ARCHIVE_IMPORT_HEADER then
        LSymbolEnd := DoNulAt(ABytes, LAt + ADAM_ARCHIVE_IMPORT_HEADER, LEnd);
      end;
      if LSymbolEnd >= 0 then
        LDllEnd := DoNulAt(ABytes, LSymbolEnd + 1, LEnd);
      end;
      if LDllEnd < 0 then
        ADiagnostics.Add(Severity.Error, ADAM_ERR_ARCHIVE_005, APlace, ADAM_MSG_ARCHIVE_BAD_IMPORT,
          NoArgs().Str(APath).Int(AArchive.Members[LI].HeaderAt));
        return false;
      end;
      AArchive.Members[LI].Kind := MemberKind.ShortImport;
      AArchive.Members[LI].ImportSymbol := DoText(ABytes, LAt + ADAM_ARCHIVE_IMPORT_HEADER,
        LSymbolEnd - LAt - ADAM_ARCHIVE_IMPORT_HEADER);
      AArchive.Members[LI].ImportDll := DoText(ABytes, LSymbolEnd + 1, LDllEnd - LSymbolEnd - 1);
      AArchive.Members[LI].ImportMachine :=
        int64(GetLe(ABytes, LAt + ADAM_ARCHIVE_IMPORT_MACHINE_AT, 2));
      AArchive.Members[LI].OrdinalHint := int64(GetLe(ABytes, LAt + ADAM_ARCHIVE_IMPORT_HINT_AT, 2));
      LType := int64(GetLe(ABytes, LAt + ADAM_ARCHIVE_IMPORT_TYPE_AT, 2));
      AArchive.Members[LI].Imported := DoImportKind(LType);
      AArchive.Members[LI].Naming := DoImportNaming(LType);
    end;
  end;
  return true;
end;

// Each member's index by the offset of its header (-1 for an offset where no member starts):
// a symbol's member found without a scan
routine DoMembersAt(const AArchive: ArchiveData): ref Int64Map;
var
  LMap: ref Int64Map;
  LI: int64;
begin
  LMap := ref Int64Map(-1);
  for LI := 0 to len(AArchive.Members) - 1 do
    LMap.Put(AArchive.Members[LI].HeaderAt, LI);
  end;
  return LMap;
end;

// Reports the symbol index damaged for AReason (AR0004): false
routine DoBadIndex(const ADiagnostics: ref Diagnostics; const APlace: SourcePlace;
  const APath: string; const AReason: string): bool;
begin
  ADiagnostics.Add(Severity.Error, ADAM_ERR_ARCHIVE_004, APlace, ADAM_MSG_ARCHIVE_BAD_INDEX,
    NoArgs().Str(APath).Str(AReason));
  return false;
end;

// The first linker member's symbols into AArchive.Symbols (none when the archive has no
// symbol index); one cut off or pointing where no member starts is reported (AR0004): false
routine DoReadIndex(const ABytes: ByteArray; const APath: string; const APlace: SourcePlace;
  const ADiagnostics: ref Diagnostics; var AArchive: ArchiveData): bool;
var
  LIndex: int64;
  LAt: int64;
  LEnd: int64;
  LCount: int64;
  LNameAt: int64;
  LNameEnd: int64;
  LI: int64;
  LOffset: int64;
  LMember: int64;
  LSymbol: ArchiveSymbol;
  LMembersAt: ref Int64Map;
begin
  LIndex := -1;
  LI := 0;
  while (LIndex < 0) and (LI < len(AArchive.Members)) do
    if AArchive.Members[LI].Kind = MemberKind.SymbolIndex then
      LIndex := LI;
    end;
    LI := LI + 1;
  end;
  if LIndex < 0 then
    return true;
  end;
  LAt := AArchive.Members[LIndex].DataAt;
  LEnd := LAt + AArchive.Members[LIndex].Size;
  if LAt + 4 > LEnd then
    return DoBadIndex(ADiagnostics, APlace, APath, ADAM_MSG_ARCHIVE_REASON_INDEX_CUT);
  end;
  LCount := DoGetBe32(ABytes, LAt);
  if LAt + 4 + LCount * 4 > LEnd then
    return DoBadIndex(ADiagnostics, APlace, APath, ADAM_MSG_ARCHIVE_REASON_INDEX_CUT);
  end;
  // The names follow the offsets, one NUL-ended name per offset, in the same order
  LNameAt := LAt + 4 + LCount * 4;
  LMembersAt := DoMembersAt(AArchive);
  setlength(AArchive.Symbols, LCount);
  for LI := 0 to LCount - 1 do
    LNameEnd := DoNulAt(ABytes, LNameAt, LEnd);
    if LNameEnd < 0 then
      // What was read before it stays (see ReadArchive)
      setlength(AArchive.Symbols, LI);
      return DoBadIndex(ADiagnostics, APlace, APath, ADAM_MSG_ARCHIVE_REASON_INDEX_CUT);
    end;
    LOffset := DoGetBe32(ABytes, LAt + 4 + LI * 4);
    LMember := LMembersAt.Find(LOffset);
    if LMember < 0 then
      setlength(AArchive.Symbols, LI);
      return DoBadIndex(ADiagnostics, APlace, APath,
        NoArgs().Int(LOffset).Fill(ADAM_MSG_ARCHIVE_REASON_INDEX_MEMBER));
    end;
    LSymbol.SymbolName := DoText(ABytes, LNameAt, LNameEnd - LNameAt);
    LSymbol.Member := LMember;
    AArchive.Symbols[LI] := LSymbol;
    LNameAt := LNameEnd + 1;
  end;
  return true;
end;

// True when ABytes start with the archive signature (!<arch> and LF): a file to read with
// ReadArchive
public routine IsArchive(const ABytes: ByteArray): bool;
begin
  return DoHasSignature(ABytes);
end;

// The name the short import AMember is imported by from its DLL, by its Import Name Type
// (PE Format "Import Name Type"): Name, the symbol as it is; NoPrefix, the symbol without one
// leading '?', '@' or '_'; Undecorate, that cut at its first '@'. "" when it is imported by
// no name read here: Ordinal (by its ordinal), ExportAs and Reserved
public routine ImportNameOf(const AMember: ArchiveMember): string;
var
  LName: string;
  LAt: int64;
begin
  if AMember.Naming = ImportNaming.Name then
    return AMember.ImportSymbol;
  end;
  if (AMember.Naming <> ImportNaming.NoPrefix) and (AMember.Naming <> ImportNaming.Undecorate) then
    return "";
  end;
  LName := AMember.ImportSymbol;
  if StartsStr("?", LName) or StartsStr("@", LName) or StartsStr("_", LName) then
    LName := Substring(LName, 1, len(LName) - 1);
  end;
  if AMember.Naming = ImportNaming.Undecorate then
    LAt := IndexOf("@", LName, 0);
    if LAt >= 0 then
      LName := Substring(LName, 0, LAt);
    end;
  end;
  return LName;
end;

// Reads the archive ABytes (the file APath, named in a report at APlace) into AArchive (see
// the header): true when it is read whole; else every fault is reported into ADiagnostics
// (AR codes) and false returned, AArchive holding what was read before it
public routine ReadArchive(const ABytes: ByteArray; const APath: string;
  const APlace: SourcePlace; const ADiagnostics: ref Diagnostics; var AArchive: ArchiveData): bool;
begin
  setlength(AArchive.Members, 0);
  setlength(AArchive.Symbols, 0);
  if not DoHasSignature(ABytes) then
    ADiagnostics.Add(Severity.Error, ADAM_ERR_ARCHIVE_001, APlace, ADAM_MSG_ARCHIVE_NO_SIGNATURE,
      NoArgs().Str(APath));
    return false;
  end;
  if not DoReadHeaders(ABytes, APath, APlace, ADiagnostics, AArchive) then
    return false;
  end;
  if not DoResolveNames(ABytes, APath, APlace, ADiagnostics, AArchive) then
    return false;
  end;
  if not DoReadImports(ABytes, APath, APlace, ADiagnostics, AArchive) then
    return false;
  end;
  return DoReadIndex(ABytes, APath, APlace, ADiagnostics, AArchive);
end;

// ---------------------------------------------------------------------------------------
// The writer (WriteArchive, WriteImportArchive; see the header)

// AText as bytes at AAt of ABytes, then blanks up to AWidth bytes (a member header's field)
routine DoPutField(var ABytes: ByteArray; const AAt: int64; const AText: string;
  const AWidth: int64);
var
  LI: int64;
begin
  if len(AText) > AWidth then
    raise(ADAM_ARCHIVE_FAULT_FIELD + AText);
  end;
  for LI := 0 to AWidth - 1 do
    if LI < len(AText) then
      ABytes[AAt + LI] := uint8(AText[LI]);
    else
      ABytes[AAt + LI] := uint8(0x20);
    end;
  end;
end;

// The member header at AAt: its name field AName, its data's size ASize; the special members
// (ASpecial: the linker members, the long-name table) leave date, ids and mode as GNU ar
// and llvm write them, every other member date 0, ids 0 and mode 644: no time stamp (AD.7)
routine DoPutHeader(var ABytes: ByteArray; const AAt: int64; const AName: string;
  const ASize: int64; const ASpecial: bool);
var
  LAt: int64;
begin
  LAt := AAt;
  DoPutField(ABytes, LAt, AName, ADAM_ARCHIVE_NAME_SIZE);
  LAt := LAt + ADAM_ARCHIVE_NAME_SIZE;
  if ASpecial and (AName = ADAM_ARCHIVE_TABLE_NAME) then
    // The long-name table: no date, ids or mode at all
    DoPutField(ABytes, LAt, "", ADAM_ARCHIVE_DATE_SIZE + 2 * ADAM_ARCHIVE_ID_SIZE +
      ADAM_ARCHIVE_MODE_SIZE);
  else
    DoPutField(ABytes, LAt, "0", ADAM_ARCHIVE_DATE_SIZE);
    DoPutField(ABytes, LAt + ADAM_ARCHIVE_DATE_SIZE, "0", ADAM_ARCHIVE_ID_SIZE);
    DoPutField(ABytes, LAt + ADAM_ARCHIVE_DATE_SIZE + ADAM_ARCHIVE_ID_SIZE, "0",
      ADAM_ARCHIVE_ID_SIZE);
    if ASpecial then
      DoPutField(ABytes, LAt + ADAM_ARCHIVE_DATE_SIZE + 2 * ADAM_ARCHIVE_ID_SIZE, "0",
        ADAM_ARCHIVE_MODE_SIZE);
    else
      DoPutField(ABytes, LAt + ADAM_ARCHIVE_DATE_SIZE + 2 * ADAM_ARCHIVE_ID_SIZE,
        ADAM_ARCHIVE_MEMBER_MODE, ADAM_ARCHIVE_MODE_SIZE);
    end;
  end;
  DoPutField(ABytes, AAt + ADAM_ARCHIVE_SIZE_AT, IntToStr(ASize), ADAM_ARCHIVE_SIZE_SIZE);
  ABytes[AAt + ADAM_ARCHIVE_END_AT] := uint8(0x60);
  ABytes[AAt + ADAM_ARCHIVE_END_AT + 1] := uint8(0x0A);
end;

// AValue as the big-endian 32-bit field at AAt of ABytes (the first linker member's numbers)
routine DoPutBe32(var ABytes: ByteArray; const AAt: int64; const AValue: int64);
begin
  ABytes[AAt] := uint8((AValue shr 24) & 255);
  ABytes[AAt + 1] := uint8((AValue shr 16) & 255);
  ABytes[AAt + 2] := uint8((AValue shr 8) & 255);
  ABytes[AAt + 3] := uint8(AValue & 255);
end;

// AText's bytes at AAt of ABytes, then a NUL; the offset after the NUL
routine DoPutNulEnded(var ABytes: ByteArray; const AAt: int64; const AText: string): int64;
begin
  if len(AText) > 0 then
    CopyBytes(addr of ABytes[AAt], ptr to const uint8(addr of AText[0]), len(AText));
  end;
  ABytes[AAt + len(AText)] := uint8(0);
  return AAt + len(AText) + 1;
end;

// ASize rounded up to even: a member's data is followed by one LF when its size is odd
routine DoPadded(const ASize: int64): int64;
begin
  return ASize + (ASize & 1);
end;

// The bytes of AMembers as an archive (see the header); raises (a compiler bug) for a
// symbol two members define and for a field a member header cannot hold
public routine WriteArchive(const AMembers: ArchiveInputArray): ByteArray;
var
  LBytes: ByteArray;
  LTableAt: ref StringIdMap;
  LTableSize: int64;
  LSymbolCount: int64;
  LStringsSize: int64;
  LMemberOf: ref StringIdMap;
  LSorted: StringArray;
  LHeaders: Int64Array;
  LFirstSize: int64;
  LSecondSize: int64;
  LFirstAt: int64;
  LSecondAt: int64;
  LNamesAt: int64;
  LAt: int64;
  LI: int64;
  LJ: int64;
  LK: int64;
  LN: int64;
  LName: string;
begin
  // The long-name table: each name over 15 bytes once, NUL-ended (MS's form; GNU ld and
  // Adam's reader take it too), at an offset kept one up (0 means none in a StringIdMap)
  LTableAt := ref StringIdMap(0);
  LTableSize := 0;
  LSymbolCount := 0;
  LStringsSize := 0;
  LMemberOf := ref StringIdMap(0);
  for LI := 0 to len(AMembers) - 1 do
    LName := AMembers[LI].MemberName;
    if (len(LName) > ADAM_ARCHIVE_SHORT_NAME_MAX) and (LTableAt.Find(LName) = 0) then
      LTableAt.Put(LName, LTableSize + 1);
      LTableSize := LTableSize + len(LName) + 1;
    end;
    for LJ := 0 to len(AMembers[LI].Defines) - 1 do
      if LMemberOf.Find(AMembers[LI].Defines[LJ]) <> 0 then
        raise(ADAM_ARCHIVE_FAULT_SYMBOL_TWICE + AMembers[LI].Defines[LJ]);
      end;
      // The member's number in the second linker member (from 1)
      LMemberOf.Put(AMembers[LI].Defines[LJ], LI + 1);
      LSymbolCount := LSymbolCount + 1;
      LStringsSize := LStringsSize + len(AMembers[LI].Defines[LJ]) + 1;
    end;
  end;
  // First linker member: the count, an offset per symbol, the names (all big-endian counts);
  // second (MS) linker member: the member count, an offset per member, the symbol count, a
  // 16-bit member number per symbol, the names sorted (all little-endian)
  LFirstSize := 4 + 4 * LSymbolCount + LStringsSize;
  LSecondSize := 4 + 4 * len(AMembers) + 4 + 2 * LSymbolCount + LStringsSize;
  // Every member's place: the special members first, then the members in their order
  LFirstAt := len(IMAGE_ARCHIVE_START);
  LSecondAt := LFirstAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR + DoPadded(LFirstSize);
  LNamesAt := LSecondAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR + DoPadded(LSecondSize);
  LAt := LNamesAt;
  if LTableSize > 0 then
    LAt := LAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR + DoPadded(LTableSize);
  end;
  setlength(LHeaders, len(AMembers));
  for LI := 0 to len(AMembers) - 1 do
    LHeaders[LI] := LAt;
    LAt := LAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR + DoPadded(len(AMembers[LI].Bytes));
  end;
  // Every byte no field writes is a pad LF
  setlength(LBytes, LAt);
  for LI := 0 to LAt - 1 do
    LBytes[LI] := uint8(0x0A);
  end;
  for LI := 0 to len(IMAGE_ARCHIVE_START) - 1 do
    LBytes[LI] := uint8(IMAGE_ARCHIVE_START[LI]);
  end;
  // The first linker member: symbols in member order
  DoPutHeader(LBytes, LFirstAt, ADAM_ARCHIVE_INDEX_NAME, LFirstSize, true);
  LAt := LFirstAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR;
  DoPutBe32(LBytes, LAt, LSymbolCount);
  LJ := LAt + 4;
  LK := LAt + 4 + 4 * LSymbolCount;
  for LI := 0 to len(AMembers) - 1 do
    for LN := 0 to len(AMembers[LI].Defines) - 1 do
      DoPutBe32(LBytes, LJ, LHeaders[LI]);
      LJ := LJ + 4;
      LK := DoPutNulEnded(LBytes, LK, AMembers[LI].Defines[LN]);
    end;
  end;
  // The second linker member: the names sorted byte-wise (what a linker binary-searches)
  DoPutHeader(LBytes, LSecondAt, ADAM_ARCHIVE_INDEX_NAME, LSecondSize, true);
  LAt := LSecondAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR;
  PutLe(LBytes, LAt, uint64(len(AMembers)), 4);
  for LI := 0 to len(AMembers) - 1 do
    PutLe(LBytes, LAt + 4 + 4 * LI, uint64(LHeaders[LI]), 4);
  end;
  LAt := LAt + 4 + 4 * len(AMembers);
  PutLe(LBytes, LAt, uint64(LSymbolCount), 4);
  setlength(LSorted, LSymbolCount);
  LK := 0;
  for LI := 0 to len(AMembers) - 1 do
    for LN := 0 to len(AMembers[LI].Defines) - 1 do
      LSorted[LK] := AMembers[LI].Defines[LN];
      LK := LK + 1;
    end;
  end;
  SortStrings(LSorted);
  LK := LAt + 4 + 2 * LSymbolCount;
  for LI := 0 to LSymbolCount - 1 do
    PutLe(LBytes, LAt + 4 + 2 * LI, uint64(LMemberOf.Find(LSorted[LI])), 2);
    LK := DoPutNulEnded(LBytes, LK, LSorted[LI]);
  end;
  // The long-name table
  if LTableSize > 0 then
    DoPutHeader(LBytes, LNamesAt, ADAM_ARCHIVE_TABLE_NAME, LTableSize, true);
    for LI := 0 to len(AMembers) - 1 do
      LName := AMembers[LI].MemberName;
      LJ := LTableAt.Find(LName);
      if LJ <> 0 then
        DoPutNulEnded(LBytes, LNamesAt + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR + LJ - 1, LName);
      end;
    end;
  end;
  // The members: a long name as "/" and its table offset, a short one with its ending '/'
  for LI := 0 to len(AMembers) - 1 do
    LName := AMembers[LI].MemberName;
    LJ := LTableAt.Find(LName);
    if LJ <> 0 then
      LName := ADAM_ARCHIVE_INDEX_NAME + IntToStr(LJ - 1);
    else
      LName := LName + "/";
    end;
    DoPutHeader(LBytes, LHeaders[LI], LName, len(AMembers[LI].Bytes), false);
    if len(AMembers[LI].Bytes) > 0 then
      CopyBytes(addr of LBytes[LHeaders[LI] + IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR],
        addr of AMembers[LI].Bytes[0], len(AMembers[LI].Bytes));
    end;
  end;
  return LBytes;
end;

// A member of the import library of the DLL ADllName: its name the DLL's, ABytes, defining
// ADefines
routine DoImportMember(const ADllName: string; const ABytes: ByteArray;
  const ADefines: StringArray): ArchiveInput;
var
  LMember: ArchiveInput;
begin
  LMember.MemberName := ADllName;
  LMember.Bytes := ABytes;
  LMember.Defines := ADefines;
  return LMember;
end;

// The one-name list AName
routine DoOneName(const AName: string): StringArray;
var
  LNames: StringArray;
begin
  setlength(LNames, 1);
  LNames[0] := AName;
  return LNames;
end;

// The two-name list AFirst, ASecond
routine DoTwoNames(const AFirst: string; const ASecond: string): StringArray;
var
  LNames: StringArray;
begin
  setlength(LNames, 2);
  LNames[0] := AFirst;
  LNames[1] := ASecond;
  return LNames;
end;

// The null thunk's name of the import library of ALibrary (the DLL's name without its
// ending): DEL, the library, _NULL_THUNK_DATA
routine DoNullThunkName(const ALibrary: string): string;
begin
  return char(uint8(ADAM_ARCHIVE_NULL_THUNK_LEAD)) + ALibrary + ADAM_ARCHIVE_NULL_THUNK_SUFFIX;
end;

// A new section of ASet named AName holding ASize zero bytes, aligned to AAlign: its id
routine DoZeroSection(const ASet: ref SectionSet; const AName: string; const ASize: int64;
  const AAlign: int64): int64;
var
  LId: int64;
begin
  LId := ASet.AddSection(AName, SectionKind.Data, AAlign);
  ASet.SectionAt(LId).PutZeros(ASize);
  return LId;
end;

// The import descriptor object of the DLL ADllName (ALibrary its name without its ending):
// .idata$2 the directory entry (its import lookup table at .idata$4's start, its name at
// .idata$6, its import address table at .idata$5's start), .idata$6 the DLL's name; it
// names the null descriptor and the null thunk, so a linker that takes it takes them too
routine DoDescriptorObject(const ADllName: string; const ALibrary: string;
  const AMachine: ref CoffMachine): ByteArray;
var
  LSet: ref SectionSet;
  LEntry: int64;
  LNames: int64;
  LName: int64;
  LLookup: int64;
  LAddresses: int64;
  LBytes: ByteArray;
begin
  LSet := ref SectionSet();
  LEntry := DoZeroSection(LSet, ADAM_ARCHIVE_IDATA_ENTRY, ADAM_ARCHIVE_DESCRIPTOR_SIZE,
    ADAM_ARCHIVE_DESCRIPTOR_ALIGN);
  LNames := LSet.AddSection(ADAM_ARCHIVE_IDATA_NAMES, SectionKind.Data, 2);
  setlength(LBytes, DoPadded(len(ADllName) + 1));
  LBytes[len(LBytes) - 1] := uint8(0);
  DoPutNulEnded(LBytes, 0, ADllName);
  LSet.SectionAt(LNames).PutBytes(LBytes);
  LSet.DefineSymbol(ADAM_ARCHIVE_DESCRIPTOR_PREFIX + ALibrary, LEntry, 0, 0);
  LName := LSet.DefineSymbol(ADAM_ARCHIVE_DLL_NAME_SYMBOL, LNames, 0, 0);
  LSet.MakeInternal(LName);
  LLookup := LSet.ReferGroupStart(ADAM_ARCHIVE_IDATA_LOOKUP);
  LAddresses := LSet.ReferGroupStart(ADAM_ARCHIVE_IDATA_ADDRESSES);
  LSet.ReferSymbol(ADAM_ARCHIVE_NULL_DESCRIPTOR, 0);
  LSet.ReferSymbol(DoNullThunkName(ALibrary), 0);
  LSet.AddReloc(LEntry, ADAM_ARCHIVE_DESCRIPTOR_LOOKUP_AT, RelocKind.Rva32, LLookup, 0);
  LSet.AddReloc(LEntry, ADAM_ARCHIVE_DESCRIPTOR_NAME_AT, RelocKind.Rva32, LName, 0);
  LSet.AddReloc(LEntry, ADAM_ARCHIVE_DESCRIPTOR_ADDRESSES_AT, RelocKind.Rva32, LAddresses, 0);
  return WriteCoffObject(LSet, AMachine);
end;

// The null import descriptor object: .idata$3, the zero entry that ends the import directory
routine DoNullDescriptorObject(const AMachine: ref CoffMachine): ByteArray;
var
  LSet: ref SectionSet;
  LEntry: int64;
begin
  LSet := ref SectionSet();
  LEntry := DoZeroSection(LSet, ADAM_ARCHIVE_IDATA_END, ADAM_ARCHIVE_DESCRIPTOR_SIZE,
    ADAM_ARCHIVE_DESCRIPTOR_ALIGN);
  LSet.DefineSymbol(ADAM_ARCHIVE_NULL_DESCRIPTOR, LEntry, 0, 0);
  return WriteCoffObject(LSet, AMachine);
end;

// The null thunk object of ALibrary: the zero slots that end its import address table
// (.idata$5) and its import lookup table (.idata$4)
routine DoNullThunkObject(const ALibrary: string; const AMachine: ref CoffMachine): ByteArray;
var
  LSet: ref SectionSet;
  LAddresses: int64;
begin
  LSet := ref SectionSet();
  LAddresses := DoZeroSection(LSet, ADAM_ARCHIVE_IDATA_ADDRESSES, ADAM_ARCHIVE_THUNK_SIZE,
    ADAM_ARCHIVE_THUNK_SIZE);
  DoZeroSection(LSet, ADAM_ARCHIVE_IDATA_LOOKUP, ADAM_ARCHIVE_THUNK_SIZE,
    ADAM_ARCHIVE_THUNK_SIZE);
  LSet.DefineSymbol(DoNullThunkName(ALibrary), LAddresses, 0, 0);
  return WriteCoffObject(LSet, AMachine);
end;

// The short import of AName from ADllName (Import Header, the name, the DLL's name): by
// name, its hint AHint (its place in the DLL's name pointer table), data (a variable) when
// AIsData, else code
routine DoShortImport(const ADllName: string; const AName: string; const AHint: int64;
  const AIsData: bool; const AMachine: ref CoffMachine): ByteArray;
var
  LBytes: ByteArray;
  LType: int64;
  LAt: int64;
begin
  setlength(LBytes, ADAM_ARCHIVE_IMPORT_HEADER + len(AName) + 1 + len(ADllName) + 1);
  for LAt := 0 to ADAM_ARCHIVE_IMPORT_HEADER - 1 do
    LBytes[LAt] := uint8(0);
  end;
  // Sig1 0, Sig2 0xFFFF, Version 0, Machine, TimeDateStamp 0 (AD.7), SizeOfData,
  // Ordinal/Hint, Type
  PutLe(LBytes, ADAM_ARCHIVE_IMPORT_SIG2_AT, uint64(IMPORT_OBJECT_HDR_SIG2), 2);
  PutLe(LBytes, ADAM_ARCHIVE_IMPORT_MACHINE_AT, uint64(AMachine.Machine), 2);
  PutLe(LBytes, ADAM_ARCHIVE_IMPORT_SIZE_AT,
    uint64(len(LBytes) - ADAM_ARCHIVE_IMPORT_HEADER), 4);
  PutLe(LBytes, ADAM_ARCHIVE_IMPORT_HINT_AT, uint64(AHint), 2);
  LType := IMPORT_OBJECT_CODE;
  if AIsData then
    LType := IMPORT_OBJECT_DATA;
  end;
  LType := LType | (IMPORT_OBJECT_NAME shl ADAM_ARCHIVE_IMPORT_NAMING_SHIFT);
  PutLe(LBytes, ADAM_ARCHIVE_IMPORT_TYPE_AT, uint64(LType), 2);
  LAt := DoPutNulEnded(LBytes, ADAM_ARCHIVE_IMPORT_HEADER, AName);
  DoPutNulEnded(LBytes, LAt, ADllName);
  return LBytes;
end;

// The import library of the DLL ADllName exporting ANames (ANames[i] a variable when
// AData[i]) for the arch AMachine describes (see the header): an archive (WriteArchive) of
// the import descriptor, the null import descriptor, the null thunk, then one short import
// per name in the DLL's name pointer table order (sorted byte-wise; each one's hint its
// place there); a routine defines its name and its __imp_ slot, a variable its slot alone
public routine WriteImportArchive(const ADllName: string; const ANames: StringArray;
  const AData: BoolArray; const AMachine: ref CoffMachine): ByteArray;
var
  LLibrary: string;
  LSorted: StringArray;
  LDataOf: ref StringIdMap;
  LMembers: ArchiveInputArray;
  LDefines: StringArray;
  LIsData: bool;
  LI: int64;
begin
  LLibrary := ChangeFileExt(ADllName, "");
  // The names sorted on a copy of their own (ANames stays as given); each one's kind by name
  // (1 code, 2 data: 0 is none in a StringIdMap)
  LDataOf := ref StringIdMap(0);
  setlength(LSorted, len(ANames));
  for LI := 0 to len(ANames) - 1 do
    LSorted[LI] := ANames[LI];
    if AData[LI] then
      LDataOf.Put(ANames[LI], 2);
    else
      LDataOf.Put(ANames[LI], 1);
    end;
  end;
  SortStrings(LSorted);
  setlength(LMembers, len(LSorted) + 3);
  LMembers[0] := DoImportMember(ADllName, DoDescriptorObject(ADllName, LLibrary, AMachine),
    DoOneName(ADAM_ARCHIVE_DESCRIPTOR_PREFIX + LLibrary));
  LMembers[1] := DoImportMember(ADllName, DoNullDescriptorObject(AMachine),
    DoOneName(ADAM_ARCHIVE_NULL_DESCRIPTOR));
  LMembers[2] := DoImportMember(ADllName, DoNullThunkObject(LLibrary, AMachine),
    DoOneName(DoNullThunkName(LLibrary)));
  for LI := 0 to len(LSorted) - 1 do
    LIsData := LDataOf.Find(LSorted[LI]) = 2;
    if LIsData then
      LDefines := DoOneName(ADAM_COFF_IMPORT_PREFIX + LSorted[LI]);
    else
      LDefines := DoTwoNames(LSorted[LI], ADAM_COFF_IMPORT_PREFIX + LSorted[LI]);
    end;
    LMembers[LI + 3] := DoImportMember(ADllName,
      DoShortImport(ADllName, LSorted[LI], LI, LIsData, AMachine), LDefines);
  end;
  return WriteArchive(LMembers);
end;

end.
