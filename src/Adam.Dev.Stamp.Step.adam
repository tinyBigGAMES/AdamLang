-------------------------------------------------------------------------------
  Adam.Dev.Stamp.Step.adam - the step a resource stamp failed at (M11a
  D5e2): below Adam.Dev.Stamp and its host parts, which both name it
*******************************************************************************/

module unit Adam.Dev.Stamp.Step;

public type
  // Which step of Adam.Dev.Stamp's StampResources failed (None: none did): the host has no
  // part, the program could not be read, its update not begun, a resource of its own not
  // deleted, one of the list's not added, the update not written
  StampStep = choices(None, NoPart, Read, Open, Delete, Add, Commit);

end.
