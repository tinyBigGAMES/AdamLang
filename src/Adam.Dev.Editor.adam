-------------------------------------------------------------------------------
  Adam.Dev.Editor.adam - adam --dev-editor (M11a D5e2): the editor built
  for the release beside adam.exe, a developer's job (never in the help, as
  pcpp's pcppdev --editor-asar / --verinfo)

  DevEditor, from adam.exe's folder (repo\bin):
    1 package.json of the editor's source (..\projects\editor) read and its
      version (Adam.Core.Common's), productName and about {product,
      copyright, url} (the About box, main.js app:info) set, and words
      {keywords, types} added: Adam's reserved words and builtin type words
      from Adam.Compiler.Lexer's own table (the editor's highlighter before
      the language server's semantic tokens, M11b)
    2 the source folder packed as res\editor\win-x64\resources\app.asar
      (Adam.Dev.Asar, that package.json in place of the file's), written
      beside it and put in place in one step; a resources\app folder is
      DV0004 (Electron loads it first: it would hide the archive)
    3 res\editor\win-x64\editor.exe stamped (Adam.Dev.Stamp): its version info
      (Adam.Coff.Resources' VersionResource: Adam's version, the editor's
      product and file names, the company and copyright) and the source's
      assets\icon.ico as its icon (IconResources)
  Each step reports into the Diagnostics given (DV codes, no place) and stops
  the job on an error; ALines gets the status lines. The editor must not be
  running (its exe is locked then: DV0007 says so).
*******************************************************************************/

module unit Adam.Dev.Editor;

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Core.Common, Adam.Core.Messages,
  Adam.Compiler.SourceText, Adam.Compiler.Diagnostics, Adam.Compiler.Lexer, Adam.Backend.Parts, Adam.Coff.Resources,
  Adam.Backend.Icon, Adam.Dev.Asar, Adam.Dev.Stamp, Adam.Dev.Stamp.Step;

public const
  ADAM_ERR_DEV_001: string = "DV0001";   // the editor's source folder is not there
  ADAM_ERR_DEV_002: string = "DV0002";   // its package.json cannot be read as a JSON object
  ADAM_ERR_DEV_003: string = "DV0003";   // the archive cannot be made or written
  ADAM_ERR_DEV_004: string = "DV0004";   // resources\app would hide the archive
  ADAM_ERR_DEV_005: string = "DV0005";   // editor.exe is not there
  ADAM_ERR_DEV_006: string = "DV0006";   // the icon is no icon file
  ADAM_ERR_DEV_007: string = "DV0007";   // editor.exe could not be stamped

  // The places, from adam.exe's folder (repo\bin)
  ADAM_DEV_EDITOR_SOURCE: string = "$P:../projects/editor";
  ADAM_DEV_EDITOR_RESOURCES: string = ADAM_EDITOR_FOLDER + "/resources";
  ADAM_DEV_EDITOR_EXE: string = ADAM_EDITOR_FOLDER + "/editor" + ADAM_EXT_COFF_EXE;
  // In the resources folder: the archive, the folder Electron would load first
  ADAM_DEV_EDITOR_ASAR: string = "app.asar";
  ADAM_DEV_EDITOR_UNPACKED: string = "app";
  // In the source folder: the package file (its name in the archive too), the icon
  ADAM_DEV_EDITOR_PACKAGE: string = "package.json";
  ADAM_DEV_EDITOR_ICON: string = "assets/icon" + ADAM_EXT_ICON;
  // The editor's names (its window, its version info)
  ADAM_DEV_EDITOR_PRODUCT: string = ADAM_PRODUCT_NAME + " Editor";
  ADAM_DEV_EDITOR_FILE: string = "editor" + ADAM_EXT_COFF_EXE;

// Reports AText (filled from AArgs) as an error with code ACode, then false
func DoFail(const AReports: ref Diagnostics; const ACode: string; const ATemplate: string;
  const AArgs: MessageArgs): bool;
begin
  AReports.Add(Severity.Error, ACode, NoPlace(), ATemplate, AArgs);
  return false;
end;

// AText's bytes
func DoBytes(const AText: string): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(AText));
  for LI := 0 to len(AText) - 1 do
    LBytes[LI] := uint8(AText[LI]);
  end;
  return LBytes;
end;

// The words object: Adam's reserved words and, apart, its builtin type words (the Lexer's
// ReservedWords)
func DoWords(): Json;
var
  LWords: Json;
  LList: StringArray;
  LI: int64;
begin
  LWords.BeginArray("keywords");
  LList := ReservedWords(false);
  for LI := 0 to len(LList) - 1 do
    LWords.Add(LList[LI]);
  end;
  LWords.EndArray();
  LWords.BeginArray("types");
  LList := ReservedWords(true);
  for LI := 0 to len(LList) - 1 do
    LWords.Add(LList[LI]);
  end;
  LWords.EndArray();
  return LWords;
end;

// Step 1: the source's package.json with this build's version, names and words, as bytes
func DoPackage(const AReports: ref Diagnostics; const ASource: string;
  var ABytes: ByteArray): bool;
var
  LPath: string;
  LPackage: Json;
  LAbout: Json;
begin
  LPath := ResolvePath(ADAM_DEV_EDITOR_PACKAGE, ASource);
  if (not LPackage.LoadFromFile(LPath)) or (not LPackage.IsObject()) then
    return DoFail(AReports, ADAM_ERR_DEV_002, ADAM_MSG_DEV_PACKAGE, NoArgs().Str(LPath));
  end;
  // Whatever the file says is replaced: the version and names are Adam.Core.Common's
  LPackage.Remove("version");
  LPackage.Add("version", AdamVersionText());
  LPackage.Remove("productName");
  LPackage.Add("productName", ADAM_DEV_EDITOR_PRODUCT);
  LAbout.Add("product", ADAM_DEV_EDITOR_PRODUCT);
  LAbout.Add("copyright", ADAM_COPYRIGHT);
  LAbout.Add("url", ADAM_URL);
  LPackage.Remove("about");
  LPackage.Add("about", LAbout);
  LPackage.Remove("words");
  LPackage.Add("words", DoWords());
  ABytes := DoBytes(LPackage.ToString());
  return true;
end;

// Step 2: the archive, put in place in one step
func DoArchive(const AReports: ref Diagnostics; const ASource: string;
  const APackage: ByteArray; var ALines: StringArray): bool;
var
  LResources: string;
  LAsar: string;
  LTemp: string;
  LReplace: AsarReplaceArray;
  LBytes: ByteArray;
  LCount: int64;
  LWhy: string;
begin
  LResources := ResolvePath(ADAM_DEV_EDITOR_RESOURCES);
  if DirectoryExists(ResolvePath(ADAM_DEV_EDITOR_UNPACKED, LResources)) then
    return DoFail(AReports, ADAM_ERR_DEV_004, ADAM_MSG_DEV_UNPACKED,
      NoArgs().Str(ResolvePath(ADAM_DEV_EDITOR_UNPACKED, LResources)));
  end;
  setlength(LReplace, 1);
  LReplace[0].Name := ADAM_DEV_EDITOR_PACKAGE;
  LReplace[0].Bytes := APackage;
  if not AsarFromFolder(ASource, LReplace, LBytes, LCount, LWhy) then
    if LWhy = "" then
      return DoFail(AReports, ADAM_ERR_DEV_003, ADAM_MSG_DEV_ARCHIVE_EMPTY, NoArgs().Str(ASource));
    end;
    return DoFail(AReports, ADAM_ERR_DEV_003, ADAM_MSG_DEV_ARCHIVE_READ, NoArgs().Str(LWhy));
  end;
  LAsar := ResolvePath(ADAM_DEV_EDITOR_ASAR, LResources);
  // A new archive's name while it is written (put in place by ReplaceFile)
  LTemp := LAsar + ADAM_EXT_TEMP;
  if (not WriteAllBytes(LTemp, LBytes)) or (not ReplaceFile(LTemp, LAsar)) then
    DeleteFile(LTemp);
    return DoFail(AReports, ADAM_ERR_DEV_003, ADAM_MSG_DEV_ARCHIVE_WRITE, NoArgs().Str(LAsar));
  end;
  setlength(ALines, len(ALines) + 1);
  ALines[len(ALines) - 1] := NoArgs().Int(LCount).Str(LAsar)
    .Int(int64(len(LBytes))).Str(AdamVersionText()).Fill(ADAM_MSG_DEV_PACKED);
  return true;
end;

// What AStep says went wrong, in words
func DoStepText(const AStep: StampStep): string;
begin
  match AStep of
    StampStep.None: return "";
    StampStep.NoPart: return ADAM_MSG_DEV_STEP_NO_PART;
    StampStep.Read: return ADAM_MSG_DEV_STEP_READ;
    StampStep.Open: return ADAM_MSG_DEV_STEP_OPEN;
    StampStep.Delete: return ADAM_MSG_DEV_STEP_DELETE;
    StampStep.Add: return ADAM_MSG_DEV_STEP_ADD;
    StampStep.Commit: return ADAM_MSG_DEV_STEP_COMMIT;
  end;
  return ADAM_MSG_DEV_STEP_READ;
end;

// Step 3: editor.exe's version info and icon
func DoStamp(const AReports: ref Diagnostics; const ASource: string;
  var ALines: StringArray): bool;
var
  LExe: string;
  LIconPath: string;
  LIcon: ByteArray;
  LSettings: ref ExeSettings;
  LList: ImageResourceList;
  LStep: StampStep;
  LCode: uint32;
begin
  LExe := ResolvePath(ADAM_DEV_EDITOR_EXE);
  if not FileExists(LExe) then
    return DoFail(AReports, ADAM_ERR_DEV_005, ADAM_MSG_DEV_NO_EXE, NoArgs().Str(LExe));
  end;
  LIconPath := ResolvePath(ADAM_DEV_EDITOR_ICON, ASource);
  setlength(LList, 0);
  if (not ReadAllBytes(LIconPath, LIcon)) or (IconResources(LIcon, LList) <> IconFault.None) then
    return DoFail(AReports, ADAM_ERR_DEV_006, ADAM_MSG_DEV_ICON, NoArgs().Str(LIconPath));
  end;
  LSettings := ref ExeSettings();
  LSettings.VersionInfo := true;
  LSettings.VersionMajor := int64(ADAM_MAJOR_VERSION);
  LSettings.VersionMinor := int64(ADAM_MINOR_VERSION);
  LSettings.VersionPatch := int64(ADAM_PATCH_VERSION);
  LSettings.ProductName := ADAM_DEV_EDITOR_PRODUCT;
  LSettings.Description := ADAM_DEV_EDITOR_PRODUCT;
  LSettings.FileName := ADAM_DEV_EDITOR_FILE;
  LSettings.CompanyName := ADAM_COMPANY_NAME;
  LSettings.Copyright := ADAM_COPYRIGHT;
  setlength(LList, len(LList) + 1);
  LList[len(LList) - 1] := VersionResource(LSettings);
  if not StampResources(LExe, LList, LStep, LCode) then
    return DoFail(AReports, ADAM_ERR_DEV_007, ADAM_MSG_DEV_STAMP,
      NoArgs().Str(LExe).Str(DoStepText(LStep)).Int(int64(LCode)));
  end;
  setlength(ALines, len(ALines) + 1);
  ALines[len(ALines) - 1] := NoArgs().Str(LExe).Str(AdamVersionText()).Fill(ADAM_MSG_DEV_STAMPED);
  return true;
end;

// adam --dev-editor (see the header): false after an error reported into AReports; ALines
// the status lines of the steps done
public func DevEditor(const AReports: ref Diagnostics; var ALines: StringArray): bool;
var
  LSource: string;
  LPackage: ByteArray;
begin
  setlength(ALines, 0);
  LSource := ResolvePath(ADAM_DEV_EDITOR_SOURCE);
  if (LSource = "") or not DirectoryExists(LSource) then
    return DoFail(AReports, ADAM_ERR_DEV_001, ADAM_MSG_DEV_NO_SOURCE,
      NoArgs().Str(ADAM_DEV_EDITOR_SOURCE));
  end;
  if not DoPackage(AReports, LSource, LPackage) then
    return false;
  end;
  if not DoArchive(AReports, LSource, LPackage, ALines) then
    return false;
  end;
  return DoStamp(AReports, LSource, ALines);
end;

end.
