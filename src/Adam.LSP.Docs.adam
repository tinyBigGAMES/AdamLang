-------------------------------------------------------------------------------
  Adam.LSP.Docs.adam - a `///` doc comment as Markdown (M11b L3)

  DocMarkdown turns a declaration's DocText (the Parser's: its doc lines
  joined by LF, BNF sec 9 doc comments) into what a hover shows. The body is
  Markdown as written; a tag at a line's start (after blanks) is a
  structured part, its text running on over the next lines until a blank
  doc line or another tag (rule 8):
    @param Name text   @returns text (@return)   @raises text
    @see Name          @deprecated text          @since text
    @example           (the lines after it, and its own rest, are Adam code)
  An unknown @word stays text, as written. The parts, each a paragraph:
  Deprecated, the summary, Parameters, Returns, Raises, Since, See also,
  Example (an adam fence, its common indent taken off).

  Prior art: PaskalCPP.LSP.Docs (CONCEPT and its output form adopted; an
  example ends at a blank doc line, as BNF sec 9 rule 8 says).
*******************************************************************************/

module unit Adam.LSP.Docs;

import System.SysUtils, System.Collections;

const
  ADAM_LSP_DOCS_FENCE: string = "```";
  ADAM_LSP_DOCS_LANGUAGE: string = "adam";

type
  // Where a doc line that carries no tag goes
  DocSection = choices(Summary, Param, Returns, Raises, See, Deprecated, Since, Example);

// AText joined to the last entry of AList (a tag's run going on), else a new entry
func DoRunOn(var AList: List<string>; const AText: string);
begin
  if AText = "" then
    return;
  end;
  if AList.Count = 0 then
    AList.Add(AText);
    return;
  end;
  if AList[AList.Count - 1] = "" then
    AList[AList.Count - 1] := AText;
  else
    AList[AList.Count - 1] := AList[AList.Count - 1] + " " + AText;
  end;
end;

// The entries of AList joined by ASeparator, trimmed
func DoJoin(const AList: List<string>; const ASeparator: string): string;
begin
  return Trim(JoinStrings(AList.ToArray(), ASeparator));
end;

// How many blanks AText starts with
func DoLead(const AText: string): int64;
var
  LAt: int64;
begin
  LAt := 0;
  while (LAt < len(AText)) and ((AText[LAt] = ' ') or (AText[LAt] = '\t')) do
    LAt := LAt + 1;
  end;
  return LAt;
end;

// The example's lines with the indent they all share taken off
func DoDedent(const ALines: List<string>): string;
var
  LIndent: int64;
  LI: int64;
  LOut: List<string>;
begin
  LIndent := -1;
  for LI := 0 to ALines.Count - 1 do
    if Trim(ALines[LI]) <> "" then
      if (LIndent < 0) or (DoLead(ALines[LI]) < LIndent) then
        LIndent := DoLead(ALines[LI]);
      end;
    end;
  end;
  if LIndent < 0 then
    return "";
  end;
  for LI := 0 to ALines.Count - 1 do
    if Trim(ALines[LI]) = "" then
      LOut.Add("");
    else
      LOut.Add(Substring(ALines[LI], LIndent, len(ALines[LI]) - LIndent));
    end;
  end;
  return JoinStrings(LOut.ToArray(), "\n");
end;

// The Markdown of the doc comment text ADocText ("" for none; see the header)
public func DocMarkdown(const ADocText: string): string;
var
  LLines: StringArray;
  LSummary: List<string>;
  LParamNames: List<string>;
  LParamTexts: List<string>;
  LReturns: List<string>;
  LRaises: List<string>;
  LSee: List<string>;
  LDeprecated: List<string>;
  LSince: List<string>;
  LExample: List<string>;
  LParts: List<string>;
  LItems: List<string>;
  LSection: DocSection;
  LI: int64;
  LLine: string;
  LTrimmed: string;
  LTag: string;
  LRest: string;
  LSpace: int64;
  LText: string;
begin
  if Trim(ADocText) = "" then
    return "";
  end;
  LLines := SplitString(ADocText, "\n");
  LSection := DocSection.Summary;
  for LI := 0 to len(LLines) - 1 do
    LLine := LLines[LI];
    LTrimmed := Trim(LLine);
    // A tag: '@' then a word at the line's start
    LTag := "";
    LRest := "";
    if StartsStr("@", LTrimmed) then
      LSpace := IndexOf(" ", LTrimmed, 0);
      if LSpace < 0 then
        LTag := Substring(LTrimmed, 1, len(LTrimmed) - 1);
      else
        LTag := Substring(LTrimmed, 1, LSpace - 1);
        LRest := Trim(Substring(LTrimmed, LSpace + 1, len(LTrimmed) - LSpace - 1));
      end;
    end;
    if LTag = "param" then
      // The first word names the parameter, the rest says what it is
      LSpace := IndexOf(" ", LRest, 0);
      if LSpace < 0 then
        LParamNames.Add(LRest);
        LParamTexts.Add("");
      else
        LParamNames.Add(Substring(LRest, 0, LSpace));
        LParamTexts.Add(Trim(Substring(LRest, LSpace + 1, len(LRest) - LSpace - 1)));
      end;
      LSection := DocSection.Param;
    else
      if (LTag = "returns") or (LTag = "return") then
        LReturns.Add(LRest);
        LSection := DocSection.Returns;
      else
        if LTag = "raises" then
          LRaises.Add(LRest);
          LSection := DocSection.Raises;
        else
          if LTag = "see" then
            LSee.Add(LRest);
            LSection := DocSection.See;
          else
            if LTag = "deprecated" then
              LDeprecated.Add(LRest);
              LSection := DocSection.Deprecated;
            else
              if LTag = "since" then
                LSince.Add(LRest);
                LSection := DocSection.Since;
              else
                if LTag = "example" then
                  if LRest <> "" then
                    LExample.Add(LRest);
                  end;
                  LSection := DocSection.Example;
                else
                  if LTrimmed = "" then
                    // A blank doc line ends a tag's run and parts the summary's paragraphs
                    LSection := DocSection.Summary;
                    LSummary.Add("");
                  else
                    if LSection = DocSection.Example then
                      // Code as written: an @word there is Adam's (a directive)
                      LExample.Add(LLine);
                    else
                      if LTag <> "" then
                        // An unknown @word is text and ends a tag's run
                        LSummary.Add(LLine);
                        LSection := DocSection.Summary;
                      else
                        match LSection of
                          DocSection.Param:
                            LParamTexts[LParamTexts.Count - 1] :=
                              Trim(LParamTexts[LParamTexts.Count - 1] + " " + LTrimmed);
                          DocSection.Returns: DoRunOn(LReturns, LTrimmed);
                          DocSection.Raises: DoRunOn(LRaises, LTrimmed);
                          DocSection.See: DoRunOn(LSee, LTrimmed);
                          DocSection.Deprecated: DoRunOn(LDeprecated, LTrimmed);
                          DocSection.Since: DoRunOn(LSince, LTrimmed);
                        else
                          LSummary.Add(LLine);
                        end;
                      end;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;

  // Each part a paragraph of its own
  if LDeprecated.Count > 0 then
    LParts.Add("**Deprecated:** " + DoJoin(LDeprecated, " "));
  end;
  LText := Trim(JoinStrings(LSummary.ToArray(), "\n"));
  if LText <> "" then
    LParts.Add(LText);
  end;
  if LParamNames.Count > 0 then
    LItems.Add("**Parameters**");
    for LI := 0 to LParamNames.Count - 1 do
      if LParamTexts[LI] = "" then
        LItems.Add("- `" + LParamNames[LI] + "`");
      else
        LItems.Add("- `" + LParamNames[LI] + "`: " + LParamTexts[LI]);
      end;
    end;
    LParts.Add(JoinStrings(LItems.ToArray(), "\n"));
  end;
  if LReturns.Count > 0 then
    LParts.Add("**Returns:** " + DoJoin(LReturns, " "));
  end;
  if LRaises.Count > 0 then
    LParts.Add("**Raises:** " + DoJoin(LRaises, " "));
  end;
  if LSince.Count > 0 then
    LParts.Add("**Since:** " + DoJoin(LSince, " "));
  end;
  if LSee.Count > 0 then
    LItems.Clear();
    for LI := 0 to LSee.Count - 1 do
      if Trim(LSee[LI]) <> "" then
        LItems.Add("`" + Trim(LSee[LI]) + "`");
      end;
    end;
    if LItems.Count > 0 then
      LParts.Add("**See also:** " + JoinStrings(LItems.ToArray(), ", "));
    end;
  end;
  if LExample.Count > 0 then
    LText := DoDedent(LExample);
    if LText <> "" then
      LParts.Add("**Example**\n" + ADAM_LSP_DOCS_FENCE + ADAM_LSP_DOCS_LANGUAGE + "\n" + LText +
        "\n" + ADAM_LSP_DOCS_FENCE);
    end;
  end;
  return JoinStrings(LParts.ToArray(), "\n\n");
end;

end.
