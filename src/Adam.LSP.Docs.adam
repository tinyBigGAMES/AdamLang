-------------------------------------------------------------------------------
  Adam.LSP.Docs.adam - a `///` doc comment as Markdown (M11b L3)

  DocPartsOf reads a declaration's DocText (the Parser's: its doc lines
  joined by LF, BNF sec 9 doc comments) into its parts (DocParts), the one
  reader of the tags; DocMarkdown makes them what a hover shows, and
  adam --dev-docs (Adam.Dev.Docs) hands them to docgen. The body is
  Markdown as written; a tag at a line's start (after blanks) is a
  structured part, its text running on over the next lines until a blank
  doc line or another tag (rule 8):
    @param Name text   @returns text (@return)   @raises text
    @see Name          @deprecated text          @since text
    @example           (the lines after it, and its own rest, are Adam code)
                       (one opening with a `code` span: that code, the
                       rest a note under the fence)
  An unknown @word stays text, as written. The parts, each a paragraph:
  Deprecated, the summary, Parameters, Returns, Raises, Since, See also,
  Example (an adam fence, its common indent taken off).

  Prior art: PaskalCPP.LSP.Docs (CONCEPT and its output form adopted; an
  example ends at a blank doc line, as BNF sec 9 rule 8 says).
*******************************************************************************/

module unit Adam.LSP.Docs;

import System.SysUtils, System.Collections;

const
  ADAM_LSP_DOCS_FENCE: string = "```";
  ADAM_LSP_DOCS_LANGUAGE: string = "adam";

type
  // Where a doc line that carries no tag goes
  DocSection = choices(Summary, Param, Returns, Raises, See, Deprecated, Since, Example);

// AText joined to the last entry of AList (a tag's run going on), else a new entry
func DoRunOn(var AList: List<string>; const AText: string);
begin
  if AText = "" then
    return;
  end;
  if AList.Count = 0 then
    AList.Add(AText);
    return;
  end;
  if AList[AList.Count - 1] = "" then
    AList[AList.Count - 1] := AText;
  else
    AList[AList.Count - 1] := AList[AList.Count - 1] + " " + AText;
  end;
end;

// The entries of AList joined by ASeparator, trimmed
func DoJoin(const AList: StringArray; const ASeparator: string): string;
begin
  return Trim(JoinStrings(AList, ASeparator));
end;

// How many blanks AText starts with
func DoLead(const AText: string): int64;
var
  LAt: int64;
begin
  LAt := 0;
  while (LAt < len(AText)) and ((AText[LAt] = ' ') or (AText[LAt] = '\t')) do
    LAt := LAt + 1;
  end;
  return LAt;
end;

// The example's lines with the indent they all share taken off
func DoDedent(const ALines: List<string>): string;
var
  LIndent: int64;
  LI: int64;
  LOut: List<string>;
begin
  LIndent := -1;
  for LI := 0 to ALines.Count - 1 do
    if Trim(ALines[LI]) <> "" then
      if (LIndent < 0) or (DoLead(ALines[LI]) < LIndent) then
        LIndent := DoLead(ALines[LI]);
      end;
    end;
  end;
  if LIndent < 0 then
    return "";
  end;
  for LI := 0 to ALines.Count - 1 do
    if Trim(ALines[LI]) = "" then
      LOut.Add("");
    else
      LOut.Add(Substring(ALines[LI], LIndent, len(ALines[LI]) - LIndent));
    end;
  end;
  return JoinStrings(LOut.ToArray(), "\n");
end;

// True when the example AText opens with a Markdown code span (a run of one or two
// backticks, closed by a run of the same length): the span's code in ACode, the text after
// it (trimmed, Markdown as written) in AProse. `@example `code` (note)`, the std's form,
// is the span's code fenced with its note under it; no span (a bare @example's lines, an
// unclosed run, a fence of three or more) is the fence's code as written
func DoExampleSpan(const AText: string; var ACode: string; var AProse: string): bool;
var
  LText: string;
  LRun: int64;
  LAt: int64;
  LClose: int64;
begin
  LText := Trim(AText);
  LRun := 0;
  while (LRun < len(LText)) and (LText[LRun] = '`') do
    LRun := LRun + 1;
  end;
  if (LRun = 0) or (LRun > 2) then
    return false;
  end;
  // The closing run: exactly LRun backticks (a longer run is the code's own)
  LClose := -1;
  LAt := LRun;
  while (LClose < 0) and (LAt < len(LText)) do
    if LText[LAt] = '`' then
      LClose := LAt;
      while (LAt < len(LText)) and (LText[LAt] = '`') do
        LAt := LAt + 1;
      end;
      if LAt - LClose <> LRun then
        LClose := -1;
      end;
    else
      LAt := LAt + 1;
    end;
  end;
  if LClose < 0 then
    return false;
  end;
  ACode := Trim(Substring(LText, LRun, LClose - LRun));
  if ACode = "" then
    return false;
  end;
  AProse := Trim(Substring(LText, LClose + LRun, len(LText) - LClose - LRun));
  return true;
end;

public type
  // A doc comment's parts (DocPartsOf; see the header): Summary the untagged Markdown
  // (paragraphs parted by a blank line, trimmed); each tag's entries in source order (a
  // @param's name and text at the same index); Example the @example's code (dedented; a
  // leading code span's code when it opens with one) and ExampleNote the text after that
  // span ("" when none)
  DocParts = record
    Summary: string;
    ParamNames: StringArray;
    ParamTexts: StringArray;
    Returns: StringArray;
    Raises: StringArray;
    See: StringArray;
    Deprecated: StringArray;
    Since: StringArray;
    Example: string;
    ExampleNote: string;
  end;

// The parts of the doc comment text ADocText (all empty for none; see the header)
public func DocPartsOf(const ADocText: string): DocParts;
var
  LDoc: DocParts;
  LLines: StringArray;
  LSummary: List<string>;
  LParamNames: List<string>;
  LParamTexts: List<string>;
  LReturns: List<string>;
  LRaises: List<string>;
  LSee: List<string>;
  LDeprecated: List<string>;
  LSince: List<string>;
  LExample: List<string>;
  LCode: string;
  LProse: string;
  LSection: DocSection;
  LI: int64;
  LLine: string;
  LTrimmed: string;
  LTag: string;
  LRest: string;
  LSpace: int64;
  LText: string;
begin
  LLines := SplitString(ADocText, "\n");
  LSection := DocSection.Summary;
  for LI := 0 to len(LLines) - 1 do
    LLine := LLines[LI];
    LTrimmed := Trim(LLine);
    // A tag: '@' then a word at the line's start
    LTag := "";
    LRest := "";
    if StartsStr("@", LTrimmed) then
      LSpace := IndexOf(" ", LTrimmed, 0);
      if LSpace < 0 then
        LTag := Substring(LTrimmed, 1, len(LTrimmed) - 1);
      else
        LTag := Substring(LTrimmed, 1, LSpace - 1);
        LRest := Trim(Substring(LTrimmed, LSpace + 1, len(LTrimmed) - LSpace - 1));
      end;
    end;
    if LTag = "param" then
      // The first word names the parameter, the rest says what it is
      LSpace := IndexOf(" ", LRest, 0);
      if LSpace < 0 then
        LParamNames.Add(LRest);
        LParamTexts.Add("");
      else
        LParamNames.Add(Substring(LRest, 0, LSpace));
        LParamTexts.Add(Trim(Substring(LRest, LSpace + 1, len(LRest) - LSpace - 1)));
      end;
      LSection := DocSection.Param;
    else
      if (LTag = "returns") or (LTag = "return") then
        LReturns.Add(LRest);
        LSection := DocSection.Returns;
      else
        if LTag = "raises" then
          LRaises.Add(LRest);
          LSection := DocSection.Raises;
        else
          if LTag = "see" then
            LSee.Add(LRest);
            LSection := DocSection.See;
          else
            if LTag = "deprecated" then
              LDeprecated.Add(LRest);
              LSection := DocSection.Deprecated;
            else
              if LTag = "since" then
                LSince.Add(LRest);
                LSection := DocSection.Since;
              else
                if LTag = "example" then
                  if LRest <> "" then
                    LExample.Add(LRest);
                  end;
                  LSection := DocSection.Example;
                else
                  if LTrimmed = "" then
                    // A blank doc line ends a tag's run and parts the summary's paragraphs
                    LSection := DocSection.Summary;
                    LSummary.Add("");
                  else
                    if LSection = DocSection.Example then
                      // Code as written: an @word there is Adam's (a directive)
                      LExample.Add(LLine);
                    else
                      if LTag <> "" then
                        // An unknown @word is text and ends a tag's run
                        LSummary.Add(LLine);
                        LSection := DocSection.Summary;
                      else
                        match LSection of
                          DocSection.Param:
                            LParamTexts[LParamTexts.Count - 1] :=
                              Trim(LParamTexts[LParamTexts.Count - 1] + " " + LTrimmed);
                          DocSection.Returns: DoRunOn(LReturns, LTrimmed);
                          DocSection.Raises: DoRunOn(LRaises, LTrimmed);
                          DocSection.See: DoRunOn(LSee, LTrimmed);
                          DocSection.Deprecated: DoRunOn(LDeprecated, LTrimmed);
                          DocSection.Since: DoRunOn(LSince, LTrimmed);
                        else
                          LSummary.Add(LLine);
                        end;
                      end;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;

  LDoc.Summary := Trim(JoinStrings(LSummary.ToArray(), "\n"));
  LDoc.ParamNames := LParamNames.ToArray();
  LDoc.ParamTexts := LParamTexts.ToArray();
  LDoc.Returns := LReturns.ToArray();
  LDoc.Raises := LRaises.ToArray();
  LDoc.See := LSee.ToArray();
  LDoc.Deprecated := LDeprecated.ToArray();
  LDoc.Since := LSince.ToArray();
  LDoc.Example := "";
  LDoc.ExampleNote := "";
  if LExample.Count > 0 then
    LText := DoDedent(LExample);
    if DoExampleSpan(LText, LCode, LProse) then
      // A code span and its note: the span's code, the note apart
      LDoc.Example := LCode;
      LDoc.ExampleNote := LProse;
    else
      LDoc.Example := LText;
    end;
  end;
  return LDoc;
end;

// The Markdown of the doc comment text ADocText ("" for none; see the header)
public func DocMarkdown(const ADocText: string): string;
var
  LDoc: DocParts;
  LParts: List<string>;
  LItems: List<string>;
  LText: string;
  LI: int64;
begin
  if Trim(ADocText) = "" then
    return "";
  end;
  LDoc := DocPartsOf(ADocText);
  // Each part a paragraph of its own
  if len(LDoc.Deprecated) > 0 then
    LParts.Add("**Deprecated:** " + DoJoin(LDoc.Deprecated, " "));
  end;
  if LDoc.Summary <> "" then
    LParts.Add(LDoc.Summary);
  end;
  if len(LDoc.ParamNames) > 0 then
    LItems.Add("**Parameters**");
    for LI := 0 to len(LDoc.ParamNames) - 1 do
      if LDoc.ParamTexts[LI] = "" then
        LItems.Add("- `" + LDoc.ParamNames[LI] + "`");
      else
        LItems.Add("- `" + LDoc.ParamNames[LI] + "`: " + LDoc.ParamTexts[LI]);
      end;
    end;
    LParts.Add(JoinStrings(LItems.ToArray(), "\n"));
  end;
  if len(LDoc.Returns) > 0 then
    LParts.Add("**Returns:** " + DoJoin(LDoc.Returns, " "));
  end;
  if len(LDoc.Raises) > 0 then
    LParts.Add("**Raises:** " + DoJoin(LDoc.Raises, " "));
  end;
  if len(LDoc.Since) > 0 then
    LParts.Add("**Since:** " + DoJoin(LDoc.Since, " "));
  end;
  if len(LDoc.See) > 0 then
    LItems.Clear();
    for LI := 0 to len(LDoc.See) - 1 do
      if Trim(LDoc.See[LI]) <> "" then
        LItems.Add("`" + Trim(LDoc.See[LI]) + "`");
      end;
    end;
    if LItems.Count > 0 then
      LParts.Add("**See also:** " + JoinStrings(LItems.ToArray(), ", "));
    end;
  end;
  if LDoc.Example <> "" then
    LText := "**Example**\n" + ADAM_LSP_DOCS_FENCE + ADAM_LSP_DOCS_LANGUAGE + "\n" +
      LDoc.Example + "\n" + ADAM_LSP_DOCS_FENCE;
    if LDoc.ExampleNote <> "" then
      LText := LText + "\n\n" + LDoc.ExampleNote;
    end;
    LParts.Add(LText);
  end;
  return JoinStrings(LParts.ToArray(), "\n\n");
end;

end.
