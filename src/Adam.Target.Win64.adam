-------------------------------------------------------------------------------
  Adam.Target.Win64.adam - x86_64-windows-gnu, the first target

  Win64Target   the Target interface (Adam.Target) for x86_64 Windows x64
                as clang lays it out for x86_64-windows-gnu (DESIGN sec 6):
                - Scalars: int8 uint8 bool char 1, int16 uint16 wchar 2,
                  int32 uint32 clong culong float32 4, int64 uint64 float64
                  ptr 8, each aligned to its size. A pointer is 8, aligned 8.
                  A mutex is 16, aligned 8.
                - C++ types (LLP64): int64 is long long, clong / culong are
                  long / unsigned long (C's long is 4 bytes), wchar is
                  wchar_t (16 bits on Windows), char is char, int8 signed
                  char.
                - How an aggregate crosses a call is the ABI part's
                  (Adam.Win64.Abi), never a fact here.
                - Bitfields by the MS rule (mingw's default, ms_struct).
                - Symbols by the Itanium C++ ABI, as clang writes them for
                  this triple.
*******************************************************************************/

module unit Adam.Target.Win64;

import Adam.Core.Common, Adam.Target;

public const
  // The triple this target builds for
  ADAM_TARGET_WIN64_TRIPLE: string = "x86_64-windows-gnu";
  // A pointer's size and alignment
  ADAM_TARGET_WIN64_POINTER: int64 = 8;
  // C's long (LLP64)
  ADAM_TARGET_WIN64_C_LONG: int64 = 4;
  // A mutex (BNF sec 4): System.Runtime's MutexWords, a state and a count (int32 each)
  // and the owner (a pointer-sized word), aligned as the owner
  ADAM_TARGET_WIN64_MUTEX_SIZE: int64 = 16;
  ADAM_TARGET_WIN64_MUTEX_ALIGN: int64 = 8;
  // The stack's alignment at a call (the Windows x64 ABI)
  ADAM_TARGET_WIN64_STACK_ALIGN: int64 = 16;
  // One argument's place, the stride between variadic arguments (the Windows x64 ABI)
  ADAM_TARGET_WIN64_VARIADIC_SLOT: int64 = 8;
  // The unit of this target's platform routines (over ucrtbase), under System.Runtime
  ADAM_TARGET_WIN64_RUNTIME_UNIT: string = "System.Runtime.Win64";

public type
  // x86_64-windows-gnu (see the header)
  Win64Target = object(Target)
    override method Triple(): string;
    begin
      return ADAM_TARGET_WIN64_TRIPLE;
    end;

    // The target a build has when nothing names one
    override method IsDefault(): bool;
    begin
      return true;
    end;

    override method BuiltinSize(const AName: string): int64;
    begin
      if (AName = "int8") or (AName = "uint8") or (AName = "bool") or (AName = "char") then
        return 1;
      end;
      if (AName = "int16") or (AName = "uint16") or (AName = "wchar") then
        return 2;
      end;
      if (AName = "int32") or (AName = "uint32") or (AName = "float32") then
        return 4;
      end;
      if (AName = "int64") or (AName = "uint64") or (AName = "float64") or (AName = "ptr") then
        return 8;
      end;
      if (AName = "clong") or (AName = "culong") then
        return ADAM_TARGET_WIN64_C_LONG;
      end;
      if AName = "mutex" then
        return ADAM_TARGET_WIN64_MUTEX_SIZE;
      end;
      return -1;
    end;

    // Every scalar is aligned to its size on this target; a mutex as its owner word
    override method BuiltinAlign(const AName: string): int64;
    begin
      if AName = "mutex" then
        return ADAM_TARGET_WIN64_MUTEX_ALIGN;
      end;
      return self.BuiltinSize(AName);
    end;

    override method PointerSize(): int64;
    begin
      return ADAM_TARGET_WIN64_POINTER;
    end;

    override method PointerAlign(): int64;
    begin
      return ADAM_TARGET_WIN64_POINTER;
    end;

    // 16 at every call (the Windows x64 ABI)
    override method StackAlign(): int64;
    begin
      return ADAM_TARGET_WIN64_STACK_ALIGN;
    end;

    // The Windows x64 ABI: every argument takes one 8-byte place (a register's home or a
    // stack place)
    override method VariadicSlotBytes(): int64;
    begin
      return ADAM_TARGET_WIN64_VARIADIC_SLOT;
    end;

    // A cursor: every variadic argument one place apart (VariadicSlotBytes)
    override method VarargsSave(): VarargsSaveFacts;
    var
      LFacts: VarargsSaveFacts;
    begin
      LFacts.Used := false;
      LFacts.ListBytes := 0;
      LFacts.ListAlign := 0;
      return LFacts;
    end;

    // LLP64: long stays 32 bits
    override method CLongSize(): int64;
    begin
      return ADAM_TARGET_WIN64_C_LONG;
    end;

    // MSVC's ABI: plain char is signed
    override method CharSigned(): bool;
    begin
      return true;
    end;

    // wchar_t is an unsigned 16-bit type on Windows
    override method WideCharSigned(): bool;
    begin
      return false;
    end;

    override method BuiltinCppType(const AName: string): string;
    begin
      if AName = "int8" then
        return "signed char";
      end;
      if AName = "uint8" then
        return "unsigned char";
      end;
      if AName = "int16" then
        return "short";
      end;
      if AName = "uint16" then
        return "unsigned short";
      end;
      if AName = "int32" then
        return "int";
      end;
      if AName = "uint32" then
        return "unsigned int";
      end;
      if AName = "int64" then
        return "long long";
      end;
      if AName = "uint64" then
        return "unsigned long long";
      end;
      if AName = "clong" then
        return "long";
      end;
      if AName = "culong" then
        return "unsigned long";
      end;
      if AName = "float32" then
        return "float";
      end;
      if AName = "float64" then
        return "double";
      end;
      if AName = "bool" then
        return "bool";
      end;
      if AName = "char" then
        return "char";
      end;
      if AName = "wchar" then
        return "wchar_t";
      end;
      return "";
    end;

    override method Bitfields(): BitfieldRule;
    begin
      return BitfieldRule.Microsoft;
    end;

    override method Mangling(): ManglingScheme;
    begin
      return ManglingScheme.Itanium;
    end;

    // System.Runtime.Win64: the platform routines over ucrtbase
    override method RuntimeUnit(): string;
    begin
      return ADAM_TARGET_WIN64_RUNTIME_UNIT;
    end;

    override method DllExtension(): string;
    begin
      return ADAM_EXT_COFF_DLL;
    end;

    // A PE import is reached through its __imp_ slot: C says so with dllimport
    override method CImportSpec(): string;
    begin
      return "__declspec(dllimport)";
    end;

    // A PE file's version resource
    override method HasVersionInfo(): bool;
    begin
      return true;
    end;

    // Win64's va_list is char *: each argument in an 8-byte place
    override method VaListIsPointer(): bool;
    begin
      return true;
    end;

    // x64's widest alignment: an SSE vector's 16 bytes (__BIGGEST_ALIGNMENT__)
    override method BiggestAlign(): int64;
    begin
      return 16;
    end;

    // A PE file's windows (gui) subsystem
    override method HasGuiSubsystem(): bool;
    begin
      return true;
    end;

    override method ProgramFormat(): ImageFormat;
    begin
      return ImageFormat.Pe;
    end;
  end;

end.
