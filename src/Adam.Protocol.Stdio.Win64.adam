  Adam.Protocol.Stdio.Win64.adam - Adam.Protocol.Stdio's x86_64-windows-gnu
  part over std System.Windows: ReadFile / WriteFile on the standard handles,
  GetFileType and PeekNamedPipe for HasPending
*******************************************************************************/

module unit Adam.Protocol.Stdio.Win64;

import System.Windows;

const
  // The most one ReadFile / WriteFile moves (their counts are 32-bit)
  ADAM_STDIO_CHUNK: int64 = 0x40000000;

// Up to ASize bytes of standard input into ABuffer: how many (0: its end, or it failed)
public routine StdioPlatformRead(const ABuffer: ptr; const ASize: int64): int64;
var
  LRead: uint32;
  LAsk: int64;
begin
  LAsk := ASize;
  if LAsk > ADAM_STDIO_CHUNK then
    LAsk := ADAM_STDIO_CHUNK;
  end;
  LRead := 0;
  if ReadFile(GetStdHandle(STD_INPUT_HANDLE), ABuffer, uint32(LAsk), LRead, nil) = 0 then
    return 0;
  end;
  return int64(LRead);
end;

// ASize bytes from ABuffer to standard output, all of them; false when it is gone
public routine StdioPlatformWrite(const ABuffer: ptr to const; const ASize: int64): bool;
var
  LHandle: uint64;
  LDone: int64;
  LAsk: int64;
  LWritten: uint32;
begin
  LHandle := GetStdHandle(STD_OUTPUT_HANDLE);
  LDone := 0;
  while LDone < ASize do
    LAsk := ASize - LDone;
    if LAsk > ADAM_STDIO_CHUNK then
      LAsk := ADAM_STDIO_CHUNK;
    end;
    LWritten := 0;
    if (WriteFile(LHandle, ptr(uint64(ABuffer) + uint64(LDone)), uint32(LAsk),
      LWritten, nil) = 0) or (LWritten = 0) then
      return false;
    end;
    LDone := LDone + int64(LWritten);
  end;
  return true;
end;

// True when standard input has bytes waiting: a pipe with some in it (a broken one too: its
// read ends at once), a file (its read never waits); a console or anything else false
public routine StdioPlatformHasPending(): bool;
var
  LHandle: uint64;
  LKind: uint32;
  LAvailable: uint32;
begin
  LHandle := GetStdHandle(STD_INPUT_HANDLE);
  LKind := GetFileType(LHandle);
  if LKind = FILE_TYPE_DISK then
    return true;
  end;
  if LKind <> FILE_TYPE_PIPE then
    return false;
  end;
  LAvailable := 0;
  if PeekNamedPipe(LHandle, nil, 0, nil, LAvailable, nil) = 0 then
    return true;
  end;
  return LAvailable > 0;
end;

end.
