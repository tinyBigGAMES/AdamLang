-------------------------------------------------------------------------------
  Adam.Compiler.SourceText.adam - Source bytes and places in them

  SourcePlace   a place in a .adam file: the file, the 1-based line and the
                1-based UTF-8 byte column. Tokens, AST nodes and diagnostics
                each embed one. Line 0 = the whole file; an empty file
                name = no place at all.
  SourceText    one file's bytes and its line table, and the ONE place the
                newline and line splice rules live (BNF sec 9, as clang):
                a newline is LF, CR LF or a lone CR; a splice is '\', any
                space / tab / VT / FF, then a newline, removed before
                tokenization except inside a raw string. Lines and columns
                stay physical. A UTF-8 BOM is skipped: line 1 starts after it.

  No file is read here: loading can fail, and a failure is reported, which
  is Diagnostics' (above this unit). The loader hands the bytes to init.
*******************************************************************************/

module unit Adam.Compiler.SourceText;

// APath with every '\' turned into '/': one spelling of a path everywhere (a place's file
// name, a path a report or a status line prints)
public func ForwardSlashes(const APath: string): string;
var
  LPath: string;
  LI: int64;
begin
  LPath := APath;
  for LI := 0 to len(LPath) - 1 do
    if LPath[LI] = '\\' then
      LPath[LI] := '/';
    end;
  end;
  return LPath;
end;

public type
  // A place in a .adam file (built empty: no place)
  SourcePlace = object
    hidden FFileName: string;
    hidden FLine: int32;
    hidden FColumn: int32;

    // No place: no file, line 0, column 0
    init();
    begin
      self.FFileName := "";
      self.FLine := 0;
      self.FColumn := 0;
    end;

    init(const AFileName: string; const ALine: int32; const AColumn: int32);
    begin
      self.FFileName := ForwardSlashes(AFileName);
      self.FLine := ALine;
      self.FColumn := AColumn;
    end;

    property FileName: string read FFileName;
    property Line: int32 read FLine;
    property Column: int32 read FColumn;

    // True when the place names no file
    const method IsNone(): bool;
    begin
      return self.FFileName = "";
    end;

    // True when the place is a whole file (a file, no line)
    const method IsWholeFile(): bool;
    begin
      return (self.FFileName <> "") and (self.FLine = 0);
    end;
  end;

  // Where each line starts: a byte offset per line, line 1 first
  LineStarts = array of int64;

  // One file's bytes, its line table and the newline / splice rules. Offsets
  // are 0-based byte offsets into the file; lines and columns are 1-based
  SourceText = object
    hidden FFileName: string;
    hidden FText: string;
    hidden FLineStarts: LineStarts;

    init(const AFileName: string; const AText: string);
    var
      LFirst: int64;
      LCount: int64;
      LAt: int64;
      LLength: int64;
      LLine: int64;
    begin
      self.FFileName := ForwardSlashes(AFileName);
      self.FText := AText;

      // Line 1 starts after a UTF-8 BOM
      LFirst := 0;
      if (self.ByteAt(0) = 0xEF) and (self.ByteAt(1) = 0xBB) and (self.ByteAt(2) = 0xBF) then
        LFirst := 3;
      end;

      // First pass counts the lines, so the table is allocated once
      LCount := 1;
      LAt := LFirst;
      while LAt < len(self.FText) do
        LLength := self.NewlineLength(LAt);
        if LLength > 0 then
          LCount := LCount + 1;
          LAt := LAt + LLength;
        else
          LAt := LAt + 1;
        end;
      end;

      // Second pass fills it: a line starts after each newline
      setlength(self.FLineStarts, LCount);
      self.FLineStarts[0] := LFirst;
      LLine := 1;
      LAt := LFirst;
      while LAt < len(self.FText) do
        LLength := self.NewlineLength(LAt);
        if LLength > 0 then
          LAt := LAt + LLength;
          self.FLineStarts[LLine] := LAt;
          LLine := LLine + 1;
        else
          LAt := LAt + 1;
        end;
      end;
    end;

    property FileName: string read FFileName;

    // The number of bytes, BOM included
    property ByteCount: int64
      read
      begin
        return len(self.FText);
      end;

    // The number of lines: one more than the newlines (an empty file has one)
    property LineCount: int32
      read
      begin
        return int32(len(self.FLineStarts));
      end;

    // Where line 1 starts: 3 after a UTF-8 BOM, else 0
    property FirstLineStart: int64
      read
      begin
        return self.FLineStarts[0];
      end;

    // The byte at AOffset as 0..255; -1 past either end, so a look-ahead
    // never needs its own bounds check
    const method ByteAt(const AOffset: int64): int32;
    begin
      if (AOffset < 0) or (AOffset >= len(self.FText)) then
        return -1;
      end;
      return int32(uint8(self.FText[AOffset]));
    end;

    // The physical bytes [AStart, AEnd), cut to the text
    const method Slice(const AStart: int64; const AEnd: int64): string;
    var
      LStart: int64;
      LEnd: int64;
      LText: string;
      LI: int64;
    begin
      LText := "";
      LStart := AStart;
      if LStart < 0 then
        LStart := 0;
      end;
      LEnd := AEnd;
      if LEnd > len(self.FText) then
        LEnd := len(self.FText);
      end;
      if LEnd <= LStart then
        return LText;
      end;
      setlength(LText, LEnd - LStart);
      for LI := LStart to LEnd - 1 do
        LText[LI - LStart] := self.FText[LI];
      end;
      return LText;
    end;

    // The length of the UTF-8 sequence whose lead byte is at AOffset, cut at
    // the end of the text; 0 past either end. A byte that leads nothing (a
    // continuation byte, C0 / C1, F5 and above) is 1: the lexer reports it
    const method UTF8Length(const AOffset: int64): int64;
    var
      LByte: int32;
      LLength: int64;
    begin
      LByte := self.ByteAt(AOffset);
      if LByte < 0 then
        return 0;
      end;
      LLength := 1;
      if (LByte >= 0xC2) and (LByte <= 0xDF) then
        LLength := 2;
      end;
      if (LByte >= 0xE0) and (LByte <= 0xEF) then
        LLength := 3;
      end;
      if (LByte >= 0xF0) and (LByte <= 0xF4) then
        LLength := 4;
      end;
      if AOffset + LLength > len(self.FText) then
        LLength := len(self.FText) - AOffset;
      end;
      return LLength;
    end;

    // The length of the newline at AOffset: 2 for CR LF, 1 for LF or a lone
    // CR, 0 when no newline starts there
    const method NewlineLength(const AOffset: int64): int64;
    var
      LByte: int32;
    begin
      LByte := self.ByteAt(AOffset);
      if LByte = 10 then
        return 1;
      end;
      if LByte = 13 then
        if self.ByteAt(AOffset + 1) = 10 then
          return 2;
        end;
        return 1;
      end;
      return 0;
    end;

    // Where the newline of the splice starting at AOffset is; -1 when no
    // splice starts there (no '\', the end after it, or something other
    // than space / tab / VT / FF before the newline). A splice whose newline
    // is not right after the '\' has whitespace in it (the lexer warns)
    const method SpliceNewlineOffset(const AOffset: int64): int64;
    var
      LAt: int64;
      LByte: int32;
    begin
      if self.ByteAt(AOffset) <> 92 then
        return -1;
      end;
      LAt := AOffset + 1;
      LByte := self.ByteAt(LAt);
      while (LByte = 32) or (LByte = 9) or (LByte = 11) or (LByte = 12) do
        LAt := LAt + 1;
        LByte := self.ByteAt(LAt);
      end;
      if self.NewlineLength(LAt) > 0 then
        return LAt;
      end;
      return -1;
    end;

    // The bytes of the splice starting at AOffset, '\' through its newline;
    // 0 when no splice starts there
    const method SpliceLength(const AOffset: int64): int64;
    var
      LNewlineAt: int64;
    begin
      LNewlineAt := self.SpliceNewlineOffset(AOffset);
      if LNewlineAt < 0 then
        return 0;
      end;
      return LNewlineAt + self.NewlineLength(LNewlineAt) - AOffset;
    end;

    // The first byte at or after AOffset that begins no splice: back-to-back
    // splices are all skipped
    const method Logical(const AOffset: int64): int64;
    var
      LAt: int64;
      LLength: int64;
    begin
      LAt := AOffset;
      LLength := self.SpliceLength(LAt);
      while LLength > 0 do
        LAt := LAt + LLength;
        LLength := self.SpliceLength(LAt);
      end;
      return LAt;
    end;

    // The logical byte after the one at AOffset. '\' is ASCII, so a splice
    // never cuts a UTF-8 sequence: a caller stepping a multi-byte character
    // steps its length, then calls Logical
    const method NextLogical(const AOffset: int64): int64;
    begin
      return self.Logical(AOffset + 1);
    end;

    // The text of [AStart, AEnd) with its splices removed. ARawQuoteAt is the
    // offset of a raw string's opening quote inside the range (-1: none):
    // from it on, the bytes stay physical, as clang keeps a raw body
    const method Spelling(const AStart: int64; const AEnd: int64;
      const ARawQuoteAt: int64): string;
    var
      LStart: int64;
      LEnd: int64;
      LLimit: int64;
      LText: string;
      LCount: int64;
      LAt: int64;
    begin
      LText := "";
      LStart := AStart;
      if LStart < 0 then
        LStart := 0;
      end;
      LEnd := AEnd;
      if LEnd > len(self.FText) then
        LEnd := len(self.FText);
      end;
      if LEnd <= LStart then
        return LText;
      end;
      LLimit := LEnd;
      if (ARawQuoteAt >= LStart) and (ARawQuoteAt < LEnd) then
        LLimit := ARawQuoteAt;
      end;

      // Logical bytes never outnumber physical ones: one allocation, cut after
      setlength(LText, LEnd - LStart);
      LCount := 0;
      LAt := self.Logical(LStart);
      while LAt < LLimit do
        LText[LCount] := self.FText[LAt];
        LCount := LCount + 1;
        LAt := self.NextLogical(LAt);
      end;

      // A raw string's part: the physical bytes from its quote to the end
      for LAt := LLimit to LEnd - 1 do
        LText[LCount] := self.FText[LAt];
        LCount := LCount + 1;
      end;
      setlength(LText, LCount);
      return LText;
    end;

    // The line AOffset is on (1-based). A newline's bytes are on the line
    // they end; an offset at or past the end is on the last line
    const method LineOf(const AOffset: int64): int32;
    var
      LLow: int64;
      LHigh: int64;
      LMid: int64;
    begin
      // Binary search: the last line whose start is at or before AOffset
      LLow := 0;
      LHigh := len(self.FLineStarts) - 1;
      while LLow < LHigh do
        LMid := (LLow + LHigh + 1) shr 1;
        if self.FLineStarts[LMid] <= AOffset then
          LLow := LMid;
        else
          LHigh := LMid - 1;
        end;
      end;
      return int32(LLow + 1);
    end;

    // Where line ALine (1-based) starts; -1 when there is no such line
    const method LineStart(const ALine: int32): int64;
    begin
      if (ALine < 1) or (int64(ALine) > len(self.FLineStarts)) then
        return -1;
      end;
      return self.FLineStarts[int64(ALine) - 1];
    end;

    // The 1-based UTF-8 byte column of AOffset on its line (1 inside a BOM)
    const method ColumnOf(const AOffset: int64): int32;
    var
      LStart: int64;
    begin
      LStart := self.LineStart(self.LineOf(AOffset));
      if AOffset < LStart then
        return 1;
      end;
      return int32(AOffset - LStart + 1);
    end;

    // The place of AOffset in this file: what a diagnostic or a token holds
    const method PlaceOf(const AOffset: int64): SourcePlace;
    var
      LPlace: SourcePlace(self.FFileName, self.LineOf(AOffset), self.ColumnOf(AOffset));
    begin
      return LPlace;
    end;
  end;

// A place: AFileName ('\' kept as '/'), ALine and AColumn (1-based, UTF-8 bytes)
public func PlaceAt(const AFileName: string; const ALine: int32;
  const AColumn: int32): SourcePlace;
var
  LPlace: SourcePlace(AFileName, ALine, AColumn);
begin
  return LPlace;
end;

// No place: a report about the compile as a whole
public func NoPlace(): SourcePlace;
var
  LPlace: SourcePlace;
begin
  return LPlace;
end;

end.
