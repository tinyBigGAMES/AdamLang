-------------------------------------------------------------------------------
  Adam.Lsp.Hints.adam - inlay hints (M11b L6)

  CallHints: the parameter names of the calls in a module's own file, each
  `name:` before the argument it binds, for the arguments starting in a byte
  range of the document, in text order. The names are read from the AST as
  the check left it (AA.2): CallSignature, the signature Semantics bound the
  call to: a routine or method (an overload set's member Semantics picked:
  the callee's ResolvedDecl; a generic instance's copy), else a routine
  value's routine type as its declaration spells it (an alias chain
  followed). An intrinsic, a type cast and anything unresolved name nothing;
  an argument past the last parameter (a variadic tail, too many) none; an
  argument that is the parameter's own name (`Pick(AValue)` for AValue)
  none, as the hint would only repeat it. A generic's instances are walked
  (the template's body is not checked): two instances over one call give
  one hint.

  Prior art: PaskalCPP.LSP.Hints (CONCEPT: the label, the order, the spelled
  as rule; GEOMETRY rejected: node ids; pcpp named an overload set only where
  its members agreed, clang picking: Adam's Semantics picks, so the picked
  member's names are given).
*******************************************************************************/

module unit Adam.Lsp.Hints;

import System.SysUtils, Adam.Compiler.SourceText, Adam.Compiler.AST, Adam.Compiler.Types,
  Adam.Lsp.Document, Adam.Lsp.Find;

public const
  // What a hint's label puts after the parameter's name
  ADAM_LSP_HINT_SUFFIX: string = ":";

public type
  // One hint: Offset the byte offset of the argument in the document, Text its label
  LspHint = record
    Offset: int64;
    Text: string;
  end;

  LspHints = array of LspHint;

// The node whose Param children name the parameters the call ACall binds (see the header);
// 0 when none does
public routine CallSignature(const ATree: ref SyntaxTree; const ACall: int64): int64;
var
  LCallee: int64;
  LDecl: int64;
  LKind: NodeKind;
  LExpr: int64;
  LDepth: int64;
begin
  LCallee := ATree.FirstOf(ACall, NodeRole.Callee);
  while (LCallee <> 0) and (ATree[LCallee].Kind = NodeKind.ParenExpression) do
    LCallee := ATree.FirstOf(LCallee, NodeRole.Operand);
  end;
  if (LCallee = 0) or ((ATree[LCallee].Kind <> NodeKind.NameExpression) and
    (ATree[LCallee].Kind <> NodeKind.MemberExpression)) then
    return 0;
  end;
  LDecl := MeantDeclaration(ATree, ATree[LCallee].ResolvedDecl);
  if LDecl = 0 then
    return 0;
  end;
  LKind := ATree[LDecl].Kind;
  if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
    (LKind = NodeKind.MethodDecl) then
    return LDecl;
  end;
  if (LKind <> NodeKind.VarDecl) and (LKind <> NodeKind.ConstDecl) and
    (LKind <> NodeKind.Param) and (LKind <> NodeKind.FieldDecl) and
    (LKind <> NodeKind.PropertyDecl) then
    return 0;
  end;
  // A routine value: its declared type, an alias chain followed to the routine type (a
  // cycle stops at the depth)
  LExpr := ATree.FirstOf(LDecl, NodeRole.TypeOf);
  LDepth := 0;
  while (LExpr <> 0) and (ATree[LExpr].Kind = NodeKind.NamedType) and
    (LDepth < ADAM_TYPES_MAX_DEPTH) do
    LDecl := ATree[LExpr].ResolvedDecl;
    if (LDecl = 0) or (ATree[LDecl].Kind <> NodeKind.TypeDecl) then
      return 0;
    end;
    LExpr := ATree.FirstOf(LDecl, NodeRole.TypeOf);
    LDepth := LDepth + 1;
  end;
  if (LExpr <> 0) and (ATree[LExpr].Kind = NodeKind.RoutineType) then
    return LExpr;
  end;
  return 0;
end;

// True when the argument AArgument is spelled as the parameter name AName (a bare name)
routine DoSpelledAs(const ATree: ref SyntaxTree; const AArgument: int64; const AName: string): bool;
begin
  return (ATree[AArgument].Kind = NodeKind.NameExpression) and (ATree[AArgument].Text = AName);
end;

type
  // One collection (see the header)
  LspHintFinder = object
    hidden FDocument: ref LspDocument;
    hidden FTree: ref SyntaxTree;
    hidden FFile: string;
    hidden FFirst: int64;
    hidden FLast: int64;
    hidden FHints: LspHints;

    init(const ADocument: ref LspDocument; const ATree: ref SyntaxTree; const AFirst: int64;
      const ALast: int64);
    begin
      self.FDocument := ADocument;
      self.FTree := ATree;
      self.FFile := "";
      self.FFirst := AFirst;
      self.FLast := ALast;
      setlength(self.FHints, 0);
    end;

    method Run(const AModule: int64): LspHints;
    begin
      if (self.FTree <> nil) and (AModule <> 0) then
        self.FFile := self.FTree[AModule].Place.FileName;
        self.DoWalk(AModule);
      end;
      return self.FHints;
    end;

    // AId and every node below it looked at (a write summary has no places: not walked)
    hidden method DoWalk(const AId: int64);
    var
      LI: int64;
      LChild: int64;
    begin
      if self.FTree[AId].Kind = NodeKind.CallExpression then
        self.DoCall(AId);
      end;
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LChild := self.FTree.ChildAt(AId, LI);
        if self.FTree.RoleOf(LChild) <> NodeRole.Effects then
          self.DoWalk(LChild);
        end;
      end;
    end;

    // The hints of the call ACall's arguments
    hidden method DoCall(const ACall: int64);
    var
      LSig: int64;
      LParams: int64;
      LI: int64;
      LArgument: int64;
      LPlace: SourcePlace;
      LName: string;
    begin
      LSig := CallSignature(self.FTree, ACall);
      if LSig = 0 then
        return;
      end;
      LParams := self.FTree.CountOf(LSig, NodeRole.Param);
      for LI := 0 to self.FTree.CountOf(ACall, NodeRole.Argument) - 1 do
        if LI >= LParams then
          // past the last parameter an argument binds to no name
          return;
        end;
        LArgument := self.FTree.NthOf(ACall, NodeRole.Argument, LI);
        LName := self.FTree[self.FTree.NthOf(LSig, NodeRole.Param, LI)].Text;
        LPlace := self.FTree[LArgument].Place;
        if (LName <> "") and (self.FTree[LArgument].Kind <> NodeKind.Error) and
          (not LPlace.IsNone()) and (LPlace.FileName = self.FFile) and
          not DoSpelledAs(self.FTree, LArgument, LName) then
          self.DoAdd(self.FDocument.OffsetOfPlace(int64(LPlace.Line), int64(LPlace.Column)),
            LName + ADAM_LSP_HINT_SUFFIX);
        end;
      end;
    end;

    // The hint ALabel at AOffset kept in text order when it is in the range and no hint is
    // there yet (an instance's copy of a call already given)
    hidden method DoAdd(const AOffset: int64; const ALabel: string);
    var
      LAt: int64;
      LI: int64;
      LCount: int64;
    begin
      if (AOffset < self.FFirst) or (AOffset >= self.FLast) then
        return;
      end;
      LCount := len(self.FHints);
      LAt := LCount;
      while (LAt > 0) and (self.FHints[LAt - 1].Offset >= AOffset) do
        LAt := LAt - 1;
      end;
      if (LAt < LCount) and (self.FHints[LAt].Offset = AOffset) then
        return;
      end;
      setlength(self.FHints, LCount + 1);
      for LI := LCount downto LAt + 1 do
        self.FHints[LI] := self.FHints[LI - 1];
      end;
      self.FHints[LAt].Offset := AOffset;
      self.FHints[LAt].Text := ALabel;
    end;
  end;

// The hints of the calls in the module AModule of ATree (read from ADocument's text) whose
// arguments start at a byte offset in [AFirst, ALast) of ADocument, in text order
public routine CallHints(const ADocument: ref LspDocument; const ATree: ref SyntaxTree;
  const AModule: int64; const AFirst: int64; const ALast: int64): LspHints;
var
  LFinder: ref LspHintFinder;
begin
  LFinder := ref LspHintFinder(ADocument, ATree, AFirst, ALast);
  return LFinder.Run(AModule);
end;

end.
