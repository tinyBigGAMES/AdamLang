  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  Adam.Compiler.Parser.adam - Tokens to the AST, one parser per file

  ParseProgram  parses the main module and, through the import clauses,
                every unit it reaches into the one SyntaxTree. Each module
                is a Module node under the program (the main module first,
                then the units in the order a parse of every source starts
                them, whichever came from a compiled form: DoProgramOrder);
                an Import holds the dotted name as written and the unit's
                module id (ResolvedUnit; 0 when it could not be loaded). A
                UnitLoader is asked for a unit's compiled form before its
                source is parsed

  BNF sec 1-2: the module header (kind, dotted name), the directive prologue
  (a Directive node per build directive, Text its spelling; its arguments
  are Argument children: a NameExpression, an IntLiteral or a StringLiteral,
  whose Text is its spelling, adjacent pieces joined by a blank), the one
  import clause, the initialize / finalize sections, the exe's begin body,
  the test blocks after 'end.'. Every string and char literal is decoded
  once (Adam.Compiler.Literals) into both encodings on its node (PR0009 /
  PR0021 / PR0054 / PR0064); a directive's string argument is narrow text:
  a path argument is resolved once into ResolvedPath (PR0022 / PR0065), the
  main module's @addmodulepath folders join the module paths before its
  import clause loads, and @linklibrary's or an external clause's library
  must have a name's shape (PR0055).

  BNF sec 6 expressions and sec 4 type expressions, the parts every
  declaration and statement holds: one routine per binding level of sec 6's
  table (assignment and ?: right associative, a relation non-chaining, the
  rest left associative), the prefix chain, the postfix chain, the
  primaries; type expressions (builtin, dotted named, ptr [to [const]],
  array, routine with its parameter list, own / ref / weak). Each builds its
  node with no parent and its caller attaches it (an operator's node is made
  once its left operand is read). own / ref / weak / is / as are words in
  context: an owner word only before a type head, 'is' / 'as' only before a
  type. Generic arguments are M10's (a '<' is less-than until then);
  intrinsic calls parse as calls until M1.7. ParseExpression and
  ParseTypeExpression parse a whole file as one fragment (the rows, the
  debugger's evaluate later).

  Recovery: nothing is dropped silently. Every span the parser skips is
  reported and leaves an Error node holding its byte range under the node
  it was skipped in. The parser keeps the rules that names, kinds and
  places decide (PR codes: PaskalCPP's number where the meaning is the
  same); a directive's VALUE (an @optimize level, a path that must exist,
  one directive given twice) is Semantics'.
*******************************************************************************/

module unit Adam.Compiler.Parser;

import System.SysUtils, System.Windows, Adam.Core.Common, Adam.Core.Containers, Adam.Core.Messages,
  Adam.Target, Adam.Target.Registry, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics,
  Adam.Compiler.SourceFiles, Adam.Compiler.Lexer, Adam.Compiler.Conditionals,
  Adam.Compiler.Literals, Adam.Compiler.AST;

public const
  ADAM_ERR_PARSER_001: string = "PR0001";   // expected X, found Y
  ADAM_ERR_PARSER_002: string = "PR0002";   // expected a module kind
  ADAM_ERR_PARSER_003: string = "PR0003";   // the module is not named as its file
  ADAM_ERR_PARSER_004: string = "PR0004";   // a unit as the main module
  ADAM_ERR_PARSER_005: string = "PR0005";   // not a build directive
  ADAM_ERR_PARSER_006: string = "PR0006";   // a directive's arguments do not fit its shape
  ADAM_ERR_PARSER_007: string = "PR0007";   // @message's severity
  ADAM_ERR_PARSER_008: string = "PR0008";   // a build directive outside the prologue
  ADAM_ERR_PARSER_009: string = "PR0009";   // a string literal with no value (a bad escape, no UTF-8)
  ADAM_ERR_PARSER_021: string = "PR0021";   // a string literal warning (an unknown escape), value kept
  ADAM_ERR_PARSER_022: string = "PR0022";   // a path directive's value cannot be resolved
  ADAM_ERR_PARSER_054: string = "PR0054";   // a char literal with no value (empty, too large, a bad escape)
  ADAM_ERR_PARSER_055: string = "PR0055";   // @linklibrary / external "..." is no library name's shape
  ADAM_ERR_PARSER_064: string = "PR0064";   // a char literal warning (an unknown escape), value kept
  ADAM_ERR_PARSER_065: string = "PR0065";   // a path directive uses $R: and the build has no project
  ADAM_ERR_PARSER_010: string = "PR0010";   // an import outside the one import clause
  ADAM_ERR_PARSER_011: string = "PR0011";   // an import cycle
  ADAM_ERR_PARSER_012: string = "PR0012";   // a unit's file not found
  ADAM_ERR_PARSER_013: string = "PR0013";   // an imported module that is not a unit
  ADAM_ERR_PARSER_014: string = "PR0014";   // a unit imported twice in the clause
  ADAM_ERR_PARSER_016: string = "PR0016";   // a begin body in a module that is not an exe
  ADAM_ERR_PARSER_017: string = "PR0017";   // an exe with no begin body
  ADAM_ERR_PARSER_018: string = "PR0018";   // initialize / finalize repeated or out of order
  ADAM_ERR_PARSER_019: string = "PR0019";   // a test block before the module's end
  ADAM_ERR_PARSER_020: string = "PR0020";   // tokens after the module's end
  ADAM_ERR_PARSER_023: string = "PR0023";   // a main-module-only directive in a unit
  ADAM_ERR_PARSER_026: string = "PR0026";   // a record / object / overlay / choices / set in a type expression
  ADAM_ERR_PARSER_025: string = "PR0025";   // a const / type block before a method's begin
  ADAM_ERR_PARSER_032: string = "PR0032";   // a record's prefix words out of order or repeated
  ADAM_ERR_PARSER_033: string = "PR0033";   // packed / align on an overlay or an object
  ADAM_ERR_PARSER_034: string = "PR0034";   // a member this aggregate does not take
  ADAM_ERR_PARSER_035: string = "PR0035";   // an empty choices type
  ADAM_ERR_PARSER_052: string = "PR0052";   // a guard with neither except nor finally
  ADAM_ERR_PARSER_053: string = "PR0053";   // a bare set (no range, no element type)
  ADAM_ERR_PARSER_057: string = "PR0057";   // public before a block among a body's declarations
  ADAM_ERR_PARSER_058: string = "PR0058";   // a word before an init / copy / done
  ADAM_ERR_PARSER_059: string = "PR0059";   // an init / copy with a result or '...'; a done with parameters or a result
  ADAM_ERR_PARSER_060: string = "PR0060";   // an interface method or accessor with a body or 'abstract'
  ADAM_ERR_PARSER_061: string = "PR0061";   // a property without read, an accessor of another shape, a var index
  ADAM_ERR_PARSER_062: string = "PR0062";   // an operator symbol a type cannot declare, or '...' on an operator
  ADAM_ERR_PARSER_038: string = "PR0038";   // comparisons do not chain
  ADAM_ERR_PARSER_039: string = "PR0039";   // the C forms '==' / '!='
  ADAM_ERR_PARSER_041: string = "PR0041";   // a cast with more than one argument
  ADAM_ERR_PARSER_042: string = "PR0042";   // nested too deeply
  ADAM_ERR_PARSER_063: string = "PR0063";   // an opener never closed before the end of the file
  ADAM_ERR_PARSER_066: string = "PR0066";   // a source file that cannot be read

const
  // How many levels of expressions and types one parse may nest: the parser's stack
  // bound (PaskalCPP's number)
  ADAM_PARSER_NEST_MAX: int64 = 256;

type
  // What a build directive takes (BNF sec 2): nothing, a name, an integer, a string, a
  // severity and a string (@message), a key and a path (@addresdata)
  DirectiveShape = choices(Bare, Name, Number, Text, Message, KeyPath);

  // Where a statement list ends besides 'end' and the end of the file (BNF sec 5): an
  // if's 'else', a repeat's 'until', a guard's 'except' / 'finally', the next match arm
  // (a label list followed by ':')
  StatementStop = choices(AtElse, AtUntil, AtExceptFinally, AtArm);
  StatementStops = set of StatementStop;

// AText between single quotes: a word or token as a message names it
routine DoQuoted(const AText: string): string;
begin
  return "'" + AText + "'";
end;

// The shape of the build directive ASpelling ("@optimize") and whether only the main
// module may give it; false for a spelling that is no build directive. @target is not
// main-only here: an imported module may repeat the main module's triple (Semantics
// compares them)
routine DoDirectiveShape(const ASpelling: string; var AShape: DirectiveShape;
  var AMainOnly: bool): bool;
begin
  AMainOnly := true;
  if (ASpelling = "@optimize") or (ASpelling = "@subsystem") or (ASpelling = "@addverinfo") or
    (ASpelling = "@unitTestMode") then
    AShape := DirectiveShape.Name;
    return true;
  end;
  if (ASpelling = "@vimajor") or (ASpelling = "@viminor") or (ASpelling = "@vipatch") then
    AShape := DirectiveShape.Number;
    return true;
  end;
  if (ASpelling = "@viproductname") or (ASpelling = "@videscription") or
    (ASpelling = "@vifilename") or (ASpelling = "@vicompanyname") or
    (ASpelling = "@vicopyright") or (ASpelling = "@exeicon") or
    (ASpelling = "@addmodulepath") or (ASpelling = "@outputpath") then
    AShape := DirectiveShape.Text;
    return true;
  end;
  AMainOnly := false;
  if (ASpelling = "@target") or (ASpelling = "@copydll") or (ASpelling = "@linklibrary") or
    (ASpelling = "@addlibrarypath") then
    AShape := DirectiveShape.Text;
    return true;
  end;
  if ASpelling = "@breakpoint" then
    AShape := DirectiveShape.Bare;
    return true;
  end;
  if ASpelling = "@message" then
    AShape := DirectiveShape.Message;
    return true;
  end;
  if ASpelling = "@addresdata" then
    AShape := DirectiveShape.KeyPath;
    return true;
  end;
  return false;
end;

// What a directive of AShape takes, as PR0006 names it
routine DoShapeText(const AShape: DirectiveShape): string;
begin
  match AShape of
    DirectiveShape.Bare:
      return ADAM_MSG_PARSER_SHAPE_NONE;
    DirectiveShape.Name:
      return ADAM_MSG_PARSER_SHAPE_NAME;
    DirectiveShape.Number:
      return ADAM_MSG_PARSER_SHAPE_INT;
    DirectiveShape.Text:
      return ADAM_MSG_PARSER_SHAPE_STRING;
    DirectiveShape.Message:
      return ADAM_MSG_PARSER_SHAPE_MESSAGE;
    DirectiveShape.KeyPath:
      return ADAM_MSG_PARSER_SHAPE_TWO_STRINGS;
  end;
  return "";
end;

// True for a severity @message takes
routine DoIsSeverity(const AText: string): bool;
begin
  return (AText = "hint") or (AText = "warn") or (AText = "error") or (AText = "fatal");
end;

// The module kind a kind keyword names; None for any other token
routine DoModuleKindOf(const AKind: TokenKind): ModuleKind;
begin
  match AKind of
    TokenKind.KwExe:
      return ModuleKind.Exe;
    TokenKind.KwDll:
      return ModuleKind.Dll;
    TokenKind.KwLib:
      return ModuleKind.Lib;
    TokenKind.KwUnit:
      return ModuleKind.Unit;
  else
    return ModuleKind.None;
  end;
end;

// A module kind as a message names it ("an exe")
routine DoKindPhrase(const AKind: ModuleKind): string;
begin
  match AKind of
    ModuleKind.Exe:
      return ADAM_MSG_PARSER_AN_EXE;
    ModuleKind.Dll:
      return ADAM_MSG_PARSER_A_DLL;
    ModuleKind.Lib:
      return ADAM_MSG_PARSER_A_LIB;
    ModuleKind.Unit:
      return ADAM_MSG_PARSER_A_UNIT;
  else
    return "";
  end;
end;

// True for a token a skip at module level stops at: one that starts a part of a module
routine DoIsSync(const AKind: TokenKind): bool;
begin
  match AKind of
    TokenKind.EndOfFile, TokenKind.Directive, TokenKind.KwImport, TokenKind.KwVar,
    TokenKind.KwThreadstatic,
    TokenKind.KwConst, TokenKind.KwType, TokenKind.KwRoutine, TokenKind.KwPublic,
    TokenKind.KwForward, TokenKind.KwInitialize, TokenKind.KwFinalize,
    TokenKind.KwBegin, TokenKind.KwEnd, TokenKind.KwTest:
      return true;
  else
    return false;
  end;
end;

// True for a word whose construct is closed by an 'end' (a body skipped whole keeps them
// balanced)
routine DoOpensEnd(const AKind: TokenKind): bool;
begin
  match AKind of
    TokenKind.KwBegin, TokenKind.KwIf, TokenKind.KwWhile, TokenKind.KwFor, TokenKind.KwMatch,
    TokenKind.KwGuard, TokenKind.KwRecord, TokenKind.KwObject, TokenKind.KwOverlay:
      return true;
  else
    return false;
  end;
end;

// The assignment operator AKind is (BNF sec 6 level 2); None for any other token
routine DoAssignOp(const AKind: TokenKind): OperatorKind;
begin
  match AKind of
    TokenKind.Assign: return OperatorKind.Assign;
    TokenKind.PlusAssign: return OperatorKind.AddAssign;
    TokenKind.MinusAssign: return OperatorKind.SubtractAssign;
    TokenKind.StarAssign: return OperatorKind.MultiplyAssign;
    TokenKind.SlashAssign: return OperatorKind.DivideAssign;
    TokenKind.PercentAssign: return OperatorKind.ModuloAssign;
    TokenKind.AmpAssign: return OperatorKind.BitAndAssign;
    TokenKind.PipeAssign: return OperatorKind.BitOrAssign;
    TokenKind.ShiftLeftAssign: return OperatorKind.ShiftLeftAssign;
    TokenKind.ShiftRightAssign: return OperatorKind.ShiftRightAssign;
  else
    return OperatorKind.None;
  end;
end;

// The adding operator AKind is (level 20: + - | xor); None for any other token
routine DoAddOp(const AKind: TokenKind): OperatorKind;
begin
  match AKind of
    TokenKind.Plus: return OperatorKind.Add;
    TokenKind.Minus: return OperatorKind.Subtract;
    TokenKind.Pipe: return OperatorKind.BitOr;
    TokenKind.KwXor: return OperatorKind.Xor;
  else
    return OperatorKind.None;
  end;
end;

// The shift operator AKind is (level 25: shl shr << >>); None for any other token
routine DoShiftOp(const AKind: TokenKind): OperatorKind;
begin
  match AKind of
    TokenKind.KwShl, TokenKind.ShiftLeft: return OperatorKind.ShiftLeft;
    TokenKind.KwShr, TokenKind.ShiftRight: return OperatorKind.ShiftRight;
  else
    return OperatorKind.None;
  end;
end;

// The multiplying operator AKind is (level 30: * / div mod % &; 'as' is read by the
// parser); None for any other token
routine DoMulOp(const AKind: TokenKind): OperatorKind;
begin
  match AKind of
    TokenKind.Star: return OperatorKind.Multiply;
    TokenKind.Slash: return OperatorKind.Divide;
    TokenKind.KwDiv: return OperatorKind.IntDivide;
    TokenKind.KwMod, TokenKind.Percent: return OperatorKind.Modulo;
    TokenKind.Amp: return OperatorKind.BitAnd;
  else
    return OperatorKind.None;
  end;
end;

// The operator AKind is at the left-associative level ALevel of BNF sec 6's table (6
// or, 8 and, 20 add, 25 shift, 30 mul); None when it is none of that level's
routine DoBinaryOp(const ALevel: int32; const AKind: TokenKind): OperatorKind;
begin
  if ALevel = 6 then
    if (AKind = TokenKind.KwOr) or (AKind = TokenKind.PipePipe) then
      return OperatorKind.LogicalOr;
    end;
    return OperatorKind.None;
  end;
  if ALevel = 8 then
    if (AKind = TokenKind.KwAnd) or (AKind = TokenKind.AmpAmp) then
      return OperatorKind.LogicalAnd;
    end;
    return OperatorKind.None;
  end;
  if ALevel = 20 then
    return DoAddOp(AKind);
  end;
  if ALevel = 25 then
    return DoShiftOp(AKind);
  end;
  if ALevel = 30 then
    return DoMulOp(AKind);
  end;
  return OperatorKind.None;
end;

// The prefix operator AKind is (level 35; 'addr' needs its 'of', read by the parser);
// None for any other token
routine DoPrefixOp(const AKind: TokenKind): OperatorKind;
begin
  match AKind of
    TokenKind.KwNot, TokenKind.Bang: return OperatorKind.LogicalNot;
    TokenKind.Minus: return OperatorKind.Negate;
    TokenKind.Plus: return OperatorKind.Plus;
    TokenKind.Tilde: return OperatorKind.BitNot;
    TokenKind.Star: return OperatorKind.Deref;
    TokenKind.Amp, TokenKind.KwAddr: return OperatorKind.AddressOf;
    TokenKind.PlusPlus: return OperatorKind.Increment;
    TokenKind.MinusMinus: return OperatorKind.Decrement;
  else
    return OperatorKind.None;
  end;
end;

// The operator a record or an object declares with symbol AKind (BNF sec 4 operator
// symbol); None for any other token (PR0062)
routine DoOperatorSymbol(const AKind: TokenKind): OperatorKind;
begin
  match AKind of
    TokenKind.Plus: return OperatorKind.Add;
    TokenKind.Minus: return OperatorKind.Subtract;
    TokenKind.Star: return OperatorKind.Multiply;
    TokenKind.Slash: return OperatorKind.Divide;
    TokenKind.KwDiv: return OperatorKind.IntDivide;
    TokenKind.KwMod: return OperatorKind.Modulo;
    TokenKind.Equal: return OperatorKind.Equal;
    TokenKind.NotEqual: return OperatorKind.NotEqual;
    TokenKind.Less: return OperatorKind.Less;
    TokenKind.LessEqual: return OperatorKind.LessEqual;
    TokenKind.Greater: return OperatorKind.Greater;
    TokenKind.GreaterEqual: return OperatorKind.GreaterEqual;
    TokenKind.KwIn: return OperatorKind.In;
  else
    return OperatorKind.None;
  end;
end;

// True for a builtin type word (BNF sec 4 builtin type, ptr, mutex and varargs included)
routine DoIsBuiltinType(const AKind: TokenKind): bool;
begin
  match AKind of
    TokenKind.KwInt8, TokenKind.KwInt16, TokenKind.KwInt32, TokenKind.KwInt64,
    TokenKind.KwUint8, TokenKind.KwUint16, TokenKind.KwUint32, TokenKind.KwUint64,
    TokenKind.KwClong, TokenKind.KwCulong,
    TokenKind.KwFloat32, TokenKind.KwFloat64, TokenKind.KwBool, TokenKind.KwChar,
    TokenKind.KwWchar, TokenKind.KwString, TokenKind.KwWstring, TokenKind.KwPtr,
    TokenKind.KwMutex, TokenKind.KwVarargs:
      return true;
  else
    return false;
  end;
end;

// True for a token an owner word must stand before to be one (a type head: a type name
// or a builtin type word, BNF sec 4 owner type)
routine DoIsTypeHead(const AKind: TokenKind): bool;
begin
  return (AKind = TokenKind.Identifier) or DoIsBuiltinType(AKind);
end;

// True for a token 'async' / 'await' must stand before to be the operator (BNF sec 6: a
// name or self starts its operand; an identifier async / await before anything else is a
// name)
routine DoIsTaskOperand(const AKind: TokenKind): bool;
begin
  return (AKind = TokenKind.Identifier) or (AKind = TokenKind.KwSelf);
end;

// True for a token a type expression starts with ('is' / 'as' are words in context:
// they need one after them)
routine DoStartsType(const AKind: TokenKind): bool;
begin
  return DoIsTypeHead(AKind) or (AKind = TokenKind.KwArray) or (AKind = TokenKind.KwRoutine);
end;

// True for a word that starts a type only a type block declares (PR0026 in a type
// expression)
routine DoIsDeclaredOnly(const AKind: TokenKind): bool;
begin
  match AKind of
    TokenKind.KwRecord, TokenKind.KwObject, TokenKind.KwOverlay, TokenKind.KwChoices,
    TokenKind.KwSet:
      return true;
  else
    return false;
  end;
end;

// True for a token no expression starts with: a closer, a separator, the end of the file,
// a word that starts a part of a module
routine DoEndsExpression(const AKind: TokenKind): bool;
begin
  match AKind of
    TokenKind.RParen, TokenKind.RBracket, TokenKind.Comma, TokenKind.Semicolon,
    TokenKind.Colon, TokenKind.DotDot:
      return true;
  else
    return DoIsSync(AKind);
  end;
end;

// The node the owner word AWord makes: in an expression (ANew) OwnNew / RefNew /
// WeakNew, in a type OwnType / RefType / WeakType. None for any other word
routine DoOwnerKind(const AWord: string; const ANew: bool): NodeKind;
begin
  if AWord = "own" then
    if ANew then
      return NodeKind.OwnNew;
    end;
    return NodeKind.OwnType;
  end;
  if AWord = "ref" then
    if ANew then
      return NodeKind.RefNew;
    end;
    return NodeKind.RefType;
  end;
  if AWord = "weak" then
    if ANew then
      return NodeKind.WeakNew;
    end;
    return NodeKind.WeakType;
  end;
  return NodeKind.None;
end;

// True for a member of varargs (BNF sec 6 varargs expr)
routine DoIsVarargsMember(const AText: string): bool;
begin
  return (AText = "count") or (AText = "next") or (AText = "get") or (AText = "reset") or
    (AText = "copy") or (AText = "kind");
end;

// The spelling of the closer AKind (')' or ']')
routine DoCloserText(const AKind: TokenKind): string;
begin
  if AKind = TokenKind.RBracket then
    return "]";
  end;
  return ")";
end;

public type
  // Where a unit's compiled form comes from, asked before its source is parsed (the
  // Driver's: the unit's .acu, DESIGN sec 3). This one has none: every unit is parsed
  UnitLoader = object
    // True when the unit AName, whose source is the file APath, has a current compiled
    // form; AImports then the units it needs in the tree first, in its order. Asked as often
    // as the parser needs, it changes nothing
    virtual method HasUnit(const AName: string; const APath: string;
      var AImports: StringArray): bool;
    begin
      setlength(AImports, 0);
      return false;
    end;

    // The compiled form HasUnit found for AName appended to the tree, its imports there
    // already or members of the same group (loaded since the last FinishUnits): its Module
    // node, attached by FinishUnits; 0 after an error told at APlace (the import that needs
    // it)
    virtual method LoadUnit(const AName: string; const APlace: SourcePlace): int64;
    begin
      return 0;
    end;

    // Every unit LoadUnit appended since the last call attached and bound as one group;
    // false after an error told
    virtual method FinishUnits(): bool;
    begin
      return true;
    end;
  end;

type
  // What the parse of one program shares across its files: the tree, the diagnostics,
  // the sources, the modules parsed so far by name, and the names being parsed now (the
  // chain of importers, for a cycle); the build's target triple (settled by the main
  // module's conditional filter, then handed to every import), and the command line's
  // override / default for it ("" = none; the CLI sets them, M1.11); the unit loader asked
  // before an imported unit's source is parsed (nil: every unit is parsed), with what
  // DoCompilable and DoCompiledUnit keep: each unit's answer (Decided: 1 compiled form,
  // 2 source), the units being decided (Deciding) and those answered yes while an outer
  // one is still open (Tentative), the units of the group being loaded (Pending) and how
  // deep its loads nest (GroupDepth)
  ParseState = object
    Ast: ref SyntaxTree;
    Errors: ref Diagnostics;
    Sources: ref SourceFiles;
    Names: StringArray;
    Ids: NodeList;
    Loading: StringArray;
    Target: string;
    OverrideTarget: string;
    DefaultTarget: string;
    Loader: ref UnitLoader;
    Decided: ref StringIdMap;
    Deciding: StringArray;
    Tentative: StringArray;
    Pending: ref StringIdMap;
    GroupDepth: int64;

    init(const ATree: ref SyntaxTree; const AErrors: ref Diagnostics;
      const ASources: ref SourceFiles);
    begin
      self.Ast := ATree;
      self.Errors := AErrors;
      self.Sources := ASources;
      self.Target := "";
      self.OverrideTarget := "";
      self.DefaultTarget := "";
      self.Loader := nil;
      self.Decided := ref StringIdMap();
      setlength(self.Deciding, 0);
      setlength(self.Tentative, 0);
      self.Pending := ref StringIdMap();
      self.GroupDepth := 0;
    end;

    // The module id of AName when it is parsed already; 0 when it is not
    const method ParsedId(const AName: string): int64;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.Names) - 1 do
        if self.Names[LI] = AName then
          return self.Ids.Items[LI];
        end;
      end;
      return 0;
    end;

    // AName is parsed: its module is AId
    method Register(const AName: string; const AId: int64);
    var
      LCount: int64;
    begin
      LCount := len(self.Names);
      setlength(self.Names, LCount + 1);
      self.Names[LCount] := AName;
      self.Ids.Add(AId);
    end;

    // True while AName is being parsed (it is in the chain of importers)
    const method IsLoading(const AName: string): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.Loading) - 1 do
        if self.Loading[LI] = AName then
          return true;
        end;
      end;
      return false;
    end;

    // AName's parse starts (it joins the chain)
    method Push(const AName: string);
    var
      LCount: int64;
    begin
      LCount := len(self.Loading);
      setlength(self.Loading, LCount + 1);
      self.Loading[LCount] := AName;
    end;

    // The last parse in the chain is done
    method Pop();
    begin
      setlength(self.Loading, len(self.Loading) - 1);
    end;

    // The chain from AName's place in it to its end, then AName again ("A -> B -> A")
    const method Cycle(const AName: string): string;
    var
      LFrom: int64;
      LI: int64;
      LText: string;
    begin
      LFrom := 0;
      for LI := 0 to len(self.Loading) - 1 do
        if self.Loading[LI] = AName then
          LFrom := LI;
          leave;
        end;
      end;
      LText := "";
      for LI := LFrom to len(self.Loading) - 1 do
        LText := LText + self.Loading[LI] + " -> ";
      end;
      return LText + AName;
    end;
  end;

// Parses the unit AName, imported at APlace by a file in AImporterDir, into the program:
// its module id; 0 when it cannot be loaded (reported). FileParser and this call each
// other (an import clause loads its units), so it is declared here and defined after
forward routine DoParseUnit(const AState: ref ParseState; const AName: string;
  const AImporterDir: string; const APlace: SourcePlace): int64;

type
  // One file's parser: its tokens, the cursor, the module it builds. AName is the name
  // the module must have (the main file's name without '.adam', an import's dotted name)
  FileParser = object
    hidden FState: ref ParseState;
    hidden FPath: string;
    hidden FName: string;
    hidden FIsMain: bool;
    hidden FTokens: TokenList;
    hidden FAt: int64;
    hidden FLastEnd: int64;
    hidden FModule: int64;
    hidden FKind: ModuleKind;
    hidden FUnclosed: bool;
    hidden FDepth: int64;
    hidden FTooDeep: bool;

    init(const AState: ref ParseState; const ATokens: TokenList; const APath: string;
      const AName: string; const AIsMain: bool);
    begin
      self.FState := AState;
      self.FTokens := ATokens;
      self.FPath := APath;
      self.FName := AName;
      self.FIsMain := AIsMain;
      self.FAt := 0;
      self.FLastEnd := 0;
      self.FModule := 0;
      self.FKind := ModuleKind.None;
      self.FUnclosed := false;
      self.FDepth := 0;
      self.FTooDeep := false;
    end;

    // The token at the cursor
    hidden const method DoToken(): ref Token;
    begin
      return self.FTokens[self.FAt];
    end;

    // The kind of the token at the cursor
    hidden const method DoKind(): TokenKind;
    begin
      return self.FTokens[self.FAt].Kind;
    end;

    // The kind of the token AAhead tokens after the cursor (EndOfFile past the end)
    hidden const method DoKindAt(const AAhead: int64): TokenKind;
    var
      LAt: int64;
    begin
      LAt := self.FAt + AAhead;
      if LAt >= self.FTokens.Count then
        LAt := self.FTokens.Count - 1;
      end;
      return self.FTokens[LAt].Kind;
    end;

    // The text of the token AAhead tokens after the cursor (EndOfFile's past the end)
    hidden const method DoTextAt(const AAhead: int64): string;
    var
      LAt: int64;
    begin
      LAt := self.FAt + AAhead;
      if LAt >= self.FTokens.Count then
        LAt := self.FTokens.Count - 1;
      end;
      return self.FTokens[LAt].Text;
    end;

    // Moves past the token at the cursor (never past EndOfFile)
    hidden method DoAdvance();
    begin
      if self.DoKind() <> TokenKind.EndOfFile then
        self.FLastEnd := self.FTokens[self.FAt].EndOffset;
        self.FAt := self.FAt + 1;
      end;
    end;

    // The token at the cursor as a message names it
    hidden const method DoFound(): string;
    begin
      if self.DoKind() = TokenKind.EndOfFile then
        return ADAM_MSG_PARSER_END_OF_FILE;
      end;
      return DoQuoted(self.FTokens[self.FAt].Text);
    end;

    // Reports ATemplate as error ACode with AArgs at APlace
    hidden method DoReport(const ACode: string; const APlace: SourcePlace;
      const ATemplate: string; const AArgs: MessageArgs);
    begin
      self.FState.Errors.Add(Severity.Error, ACode, APlace, ATemplate, AArgs);
    end;

    // Reports ATemplate as warning ACode with AArgs at APlace
    hidden method DoWarning(const ACode: string; const APlace: SourcePlace;
      const ATemplate: string; const AArgs: MessageArgs);
    begin
      self.FState.Errors.Add(Severity.Warning, ACode, APlace, ATemplate, AArgs);
    end;

    // PR0001 at the cursor: AWhat was expected. Silent once a parse went past the nesting
    // bound (PR0042 said why the rest of the file was taken), and silent on an Invalid
    // token: the lexer already reported it (one fault, one error)
    hidden method DoExpected(const AWhat: string);
    begin
      if self.FTooDeep then
        return;
      end;
      if self.DoKind() = TokenKind.Invalid then
        return;
      end;
      self.DoReport(ADAM_ERR_PARSER_001, self.DoToken().Place, ADAM_MSG_PARSER_EXPECTED,
        NoArgs().Str(AWhat).Str(self.DoFound()));
    end;

    // Moves past a token of AKind; anything else is PR0001 (AWhat expected) and stays
    hidden method DoRequire(const AKind: TokenKind; const AWhat: string);
    begin
      if self.DoKind() = AKind then
        self.DoAdvance();
      else
        self.DoExpected(AWhat);
      end;
    end;

    // A new node of AKind under AParent playing ARole, with the place and byte range of
    // the token at the cursor
    hidden method DoAddAt(const AParent: int64; const ARole: NodeRole;
      const AKind: NodeKind): int64;
    var
      LToken: ref Token;
    begin
      LToken := self.DoToken();
      return self.FState.Ast.AddChild(AParent, ARole, AKind, LToken.Place,
        LToken.StartOffset, LToken.EndOffset);
    end;

    // AId's byte range ends where the last token moved past ends; a node whose parse
    // moved past nothing after its start (a missing part) ends where it starts
    hidden method DoEnd(const AId: int64);
    var
      LNode: ref Node;
    begin
      LNode := self.FState.Ast[AId];
      if self.FLastEnd < LNode.StartOffset then
        LNode.EndOffset := LNode.StartOffset;
      else
        LNode.EndOffset := self.FLastEnd;
      end;
    end;

    // A new node of AKind with no parent yet, with the place and byte range of the token
    // at the cursor; the caller attaches it
    hidden method DoNew(const AKind: NodeKind): int64;
    var
      LToken: ref Token;
    begin
      LToken := self.DoToken();
      return self.FState.Ast.Add(AKind, LToken.Place, LToken.StartOffset, LToken.EndOffset);
    end;

    // A new node of AKind with no parent yet that starts where the node AFirst starts (an
    // operator's node starts at its left operand); AFirst goes under it playing ARole
    hidden method DoNewOver(const AKind: NodeKind; const AFirst: int64;
      const ARole: NodeRole): int64;
    var
      LFirst: ref Node;
      LId: int64;
    begin
      LFirst := self.FState.Ast[AFirst];
      LId := self.FState.Ast.Add(AKind, LFirst.Place, LFirst.StartOffset, LFirst.EndOffset);
      self.FState.Ast.Attach(LId, ARole, AFirst);
      return LId;
    end;

    // AChild goes under AParent playing ARole
    hidden method DoPut(const AParent: int64; const ARole: NodeRole; const AChild: int64);
    begin
      self.FState.Ast.Attach(AParent, ARole, AChild);
    end;

    // What a missing part leaves: PR0001 at the cursor (AWhat expected) and an Error node
    // with no parent and an empty range there. The cursor stays
    hidden method DoMissing(const AWhat: string): int64;
    var
      LId: int64;
    begin
      self.DoExpected(AWhat);
      LId := self.DoNew(NodeKind.Error);
      self.FState.Ast[LId].EndOffset := self.FState.Ast[LId].StartOffset;
      return LId;
    end;

    // Skips tokens up to one that starts a part of a module (DoIsSync); with ASemicolon
    // a ';' ends the skip too and is moved past; with AFirst the token at the cursor is
    // skipped whatever it is. What is skipped becomes an Error node under AParent
    // playing ARole (none when nothing is skipped)
    hidden method DoSkip(const AParent: int64; const ARole: NodeRole; const ASemicolon: bool;
      const AFirst: bool);
    var
      LError: int64;
    begin
      LError := 0;
      if AFirst and (self.DoKind() <> TokenKind.EndOfFile) then
        LError := self.DoAddAt(AParent, ARole, NodeKind.Error);
        self.DoAdvance();
      end;
      while not DoIsSync(self.DoKind()) do
        if ASemicolon and (self.DoKind() = TokenKind.Semicolon) then
          self.DoAdvance();
          leave;
        end;
        if LError = 0 then
          LError := self.DoAddAt(AParent, ARole, NodeKind.Error);
        end;
        self.DoAdvance();
      end;
      if LError <> 0 then
        self.DoEnd(LError);
      end;
    end;

    // Skips up to the 'end' that closes the construct the cursor is in (left at the
    // cursor) or the end of the file, keeping nested 'end's balanced: one Error node
    // under AParent playing ARole
    hidden method DoSkipBalanced(const AParent: int64; const ARole: NodeRole);
    var
      LError: int64;
      LDepth: int64;
    begin
      LError := self.DoAddAt(AParent, ARole, NodeKind.Error);
      LDepth := 0;
      while self.DoKind() <> TokenKind.EndOfFile do
        if self.DoKind() = TokenKind.KwEnd then
          if LDepth = 0 then
            leave;
          end;
          LDepth := LDepth - 1;
        else
          if DoOpensEnd(self.DoKind()) then
            LDepth := LDepth + 1;
          end;
        end;
        self.DoAdvance();
      end;
      self.DoEnd(LError);
    end;

    // Everything from the cursor to the end of the file as one Error node under AParent
    // playing ARole
    hidden method DoSkipAll(const AParent: int64; const ARole: NodeRole);
    var
      LError: int64;
    begin
      if self.DoKind() = TokenKind.EndOfFile then
        return;
      end;
      LError := self.DoAddAt(AParent, ARole, NodeKind.Error);
      while self.DoKind() <> TokenKind.EndOfFile do
        self.DoAdvance();
      end;
      self.DoEnd(LError);
    end;

    // A begin body at the cursor ('begin'): a Block under AParent playing ARole holding its
    // statements (role Statement) up to its 'end'. With AOwnEnd the 'end' is the block's
    // and is moved past; without it, it is left for the module's 'end' '.'. An 'end' that
    // never comes is PR0063 at the 'begin'
    hidden method DoBlock(const AParent: int64; const ARole: NodeRole; const AOwnEnd: bool);
    var
      LBlock: int64;
      LBegin: SourcePlace;
    begin
      LBlock := self.DoAddAt(AParent, ARole, NodeKind.Block);
      LBegin := self.DoToken().Place;
      self.DoAdvance();
      self.DoStatements(LBlock, NodeRole.Statement, []);
      if self.DoKind() = TokenKind.EndOfFile then
        // The innermost opener the file never closes is reported once (PR0063)
        if not self.FUnclosed then
          self.DoReport(ADAM_ERR_PARSER_063, LBegin, ADAM_MSG_PARSER_NOT_CLOSED,
            NoArgs().Str("begin"));
        end;
        self.FUnclosed := true;
      else
        if AOwnEnd then
          self.DoAdvance();
        end;
      end;
      self.DoEnd(LBlock);
    end;

    // Statements under AParent playing ARole (BNF sec 5) up to 'end', the end of the file,
    // or a stop AStops names. A statement that consumed nothing (a token no statement
    // starts with) is skipped as an Error node, so the list always moves on
    hidden method DoStatements(const AParent: int64; const ARole: NodeRole;
      const AStops: StatementStops);
    var
      LKind: TokenKind;
      LAt: int64;
    begin
      while not (self.FUnclosed or self.FTooDeep) do
        LKind := self.DoKind();
        if (LKind = TokenKind.KwEnd) or (LKind = TokenKind.EndOfFile) then
          leave;
        end;
        if (LKind = TokenKind.KwElse) and (StatementStop.AtElse in AStops) then
          leave;
        end;
        if (LKind = TokenKind.KwUntil) and (StatementStop.AtUntil in AStops) then
          leave;
        end;
        if ((LKind = TokenKind.KwExcept) or (LKind = TokenKind.KwFinally)) and
          (StatementStop.AtExceptFinally in AStops) then
          leave;
        end;
        if (StatementStop.AtArm in AStops) and self.DoIsArmStart() then
          leave;
        end;
        LAt := self.FAt;
        self.DoStatement(AParent, ARole, StatementStop.AtArm in AStops);
        if self.FAt = LAt then
          self.DoSkipStatement(AParent, ARole);
        end;
      end;
    end;

    // True for a token a statement keyword starts (a label list never does)
    hidden const method DoIsStatementWord(const AKind: TokenKind): bool;
    begin
      match AKind of
        TokenKind.KwBegin, TokenKind.KwIf, TokenKind.KwWhile, TokenKind.KwFor,
        TokenKind.KwRepeat, TokenKind.KwMatch, TokenKind.KwGuard, TokenKind.KwReturn,
        TokenKind.KwLeave, TokenKind.KwSkip, TokenKind.KwVar, TokenKind.KwConst,
        TokenKind.KwType, TokenKind.KwPublic, TokenKind.KwThreadstatic, TokenKind.Directive:
          return true;
      else
        return false;
      end;
    end;

    // True when a match arm's label list starts at the cursor (BNF sec 5): before any ';',
    // assignment, '?' or end of the file, a ':' stands outside brackets
    hidden const method DoIsArmStart(): bool;
    var
      LAt: int64;
      LDepth: int64;
      LKind: TokenKind;
    begin
      if self.DoIsStatementWord(self.DoKind()) then
        return false;
      end;
      LAt := 0;
      LDepth := 0;
      while true do
        LKind := self.DoKindAt(LAt);
        if LKind = TokenKind.EndOfFile then
          return false;
        end;
        if (LKind = TokenKind.LParen) or (LKind = TokenKind.LBracket) then
          LDepth := LDepth + 1;
        else
          if (LKind = TokenKind.RParen) or (LKind = TokenKind.RBracket) then
            LDepth := LDepth - 1;
          else
            if LDepth <= 0 then
              if LKind = TokenKind.Colon then
                return true;
              end;
              if (LKind = TokenKind.Semicolon) or (LKind = TokenKind.Question) or
                (LKind = TokenKind.KwEnd) or (DoAssignOp(LKind) <> OperatorKind.None) then
                return false;
              end;
            end;
          end;
        end;
        LAt := LAt + 1;
      end;
      return false;
    end;

    // One statement at the cursor under AParent playing ARole (DoStatementBody). Each
    // statement nested in another is one level of the nesting bound (DoEnter, PR0042),
    // so no input overflows the parser's stack
    hidden method DoStatement(const AParent: int64; const ARole: NodeRole; const AInArm: bool);
    var
      LDeep: int64;
    begin
      if not self.DoEnter() then
        LDeep := self.DoTooDeep();
        self.DoPut(AParent, ARole, LDeep);
        return;
      end;
      self.DoStatementBody(AParent, ARole, AInArm);
      self.DoLeave();
    end;

    // The statement at the cursor under AParent playing ARole. AInArm: directly in a match
    // arm, a var / const keyword takes one item (BNF sec 5). A lone ';' is PR0001 (there is
    // no empty statement), skipped
    hidden method DoStatementBody(const AParent: int64; const ARole: NodeRole;
      const AInArm: bool);
    var
      LKind: TokenKind;
    begin
      LKind := self.DoKind();
      if LKind = TokenKind.KwBegin then
        self.DoBlock(AParent, ARole, true);
        if not self.FUnclosed then
          self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
        end;
        return;
      end;
      if LKind = TokenKind.KwIf then
        self.DoIf(AParent, ARole);
        return;
      end;
      if LKind = TokenKind.KwWhile then
        self.DoWhile(AParent, ARole);
        return;
      end;
      if LKind = TokenKind.KwFor then
        self.DoFor(AParent, ARole);
        return;
      end;
      if LKind = TokenKind.KwRepeat then
        self.DoRepeat(AParent, ARole);
        return;
      end;
      if LKind = TokenKind.KwMatch then
        self.DoMatch(AParent, ARole);
        return;
      end;
      if LKind = TokenKind.KwGuard then
        self.DoGuard(AParent, ARole);
        return;
      end;
      if self.DoIsLockStart("lock") then
        self.DoLock(AParent, ARole, NodeKind.LockStatement);
        return;
      end;
      if self.DoIsLockStart("trylock") then
        self.DoLock(AParent, ARole, NodeKind.TryLockStatement);
        return;
      end;
      if LKind = TokenKind.KwReturn then
        self.DoReturn(AParent, ARole);
        return;
      end;
      if LKind = TokenKind.KwLeave then
        self.DoJump(AParent, ARole, NodeKind.LeaveStatement);
        return;
      end;
      if LKind = TokenKind.KwSkip then
        self.DoJump(AParent, ARole, NodeKind.SkipStatement);
        return;
      end;
      if LKind = TokenKind.Directive then
        self.DoDirective(AParent, ARole, true);
        return;
      end;
      if IsPublicWord(LKind) or (LKind = TokenKind.KwVar) or
        (LKind = TokenKind.KwConst) or (LKind = TokenKind.KwType) or
        (LKind = TokenKind.KwThreadstatic) then
        self.DoBodyDecl(AParent, ARole, AInArm);
        return;
      end;
      if LKind = TokenKind.Semicolon then
        self.DoExpected(ADAM_MSG_PARSER_A_STATEMENT);
        self.DoSkipStatement(AParent, ARole);
        return;
      end;
      self.DoExpressionStatement(AParent, ARole);
    end;

    // A var / const / type block among statements (each decl under AParent playing
    // ARole). 'public' before it is PR0057; 'threadstatic' is PR0057 and its block a var
    // block. AInArm: a var / const keyword takes one item
    hidden method DoBodyDecl(const AParent: int64; const ARole: NodeRole; const AInArm: bool);
    begin
      if self.DoKind() = TokenKind.KwThreadstatic then
        self.DoReport(ADAM_ERR_PARSER_057, self.DoToken().Place, ADAM_MSG_PARSER_PUBLIC_LOCAL,
          NoArgs().Str(KindText(self.DoKind())));
        self.DoVarBlock(AParent, ARole, false);
        return;
      end;
      if IsPublicWord(self.DoKind()) then
        self.DoReport(ADAM_ERR_PARSER_057, self.DoToken().Place, ADAM_MSG_PARSER_PUBLIC_LOCAL,
          NoArgs().Str(KindText(self.DoKind())));
        self.DoAdvance();
        if (self.DoKind() <> TokenKind.KwVar) and (self.DoKind() <> TokenKind.KwConst) and
          (self.DoKind() <> TokenKind.KwType) then
          return;
        end;
      end;
      if self.DoKind() = TokenKind.KwType then
        self.DoTypeBlock(AParent, ARole, false);
        return;
      end;
      if not AInArm then
        if self.DoKind() = TokenKind.KwVar then
          self.DoVarBlock(AParent, ARole, false);
        else
          self.DoConstBlock(AParent, ARole, false);
        end;
        return;
      end;
      if self.DoKind() = TokenKind.KwVar then
        self.DoAdvance();
        if self.DoKind() = TokenKind.Identifier then
          self.DoVarDecl(AParent, ARole, false);
        else
          self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
        end;
      else
        self.DoAdvance();
        if self.DoKind() = TokenKind.Identifier then
          self.DoConstDecl(AParent, ARole, false);
        else
          self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
        end;
      end;
    end;

    // An expression statement: ExpressionStatement (its expression as Value) then ';'; a
    // missing ';' is PR0001 and the rest up to the next ';' skipped
    hidden method DoExpressionStatement(const AParent: int64; const ARole: NodeRole);
    var
      LNode: int64;
      LExpr: int64;
    begin
      LNode := self.DoAddAt(AParent, ARole, NodeKind.ExpressionStatement);
      LExpr := self.DoExpression();
      self.DoPut(LNode, NodeRole.Value, LExpr);
      if self.DoKind() = TokenKind.Semicolon then
        self.DoAdvance();
      else
        self.DoExpected(DoQuoted(";"));
        if not self.FTooDeep then
          self.DoSkipStatement(LNode, NodeRole.Value);
        end;
      end;
      self.DoEnd(LNode);
    end;

    // Skips what no statement takes (the token at the cursor at least) up to its ';'
    // (moved past), an 'end' or the end of the file: one Error node under AParent (ARole)
    hidden method DoSkipStatement(const AParent: int64; const ARole: NodeRole);
    var
      LError: int64;
    begin
      if (self.DoKind() = TokenKind.KwEnd) or (self.DoKind() = TokenKind.EndOfFile) then
        return;
      end;
      LError := self.DoAddAt(AParent, ARole, NodeKind.Error);
      self.DoAdvance();
      while (self.DoKind() <> TokenKind.Semicolon) and (self.DoKind() <> TokenKind.KwEnd) and
        (self.DoKind() <> TokenKind.EndOfFile) do
        self.DoAdvance();
      end;
      if self.DoKind() = TokenKind.Semicolon then
        self.DoAdvance();
      end;
      self.DoEnd(LError);
    end;

    // The 'end' ';' that closes a statement opened at AOpen by AWord: the end of the file
    // instead is PR0063 at AOpen (once); anything else PR0001 ('end' expected)
    hidden method DoCloseEnd(const AOpen: SourcePlace; const AWord: string);
    begin
      if self.DoKind() = TokenKind.KwEnd then
        self.DoAdvance();
        self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
        return;
      end;
      if self.DoKind() = TokenKind.EndOfFile then
        if not self.FUnclosed then
          self.DoReport(ADAM_ERR_PARSER_063, AOpen, ADAM_MSG_PARSER_NOT_CLOSED,
            NoArgs().Str(AWord));
        end;
        self.FUnclosed := true;
        return;
      end;
      self.DoExpected(DoQuoted("end"));
    end;

    // An if statement: IfStatement (Condition, Then*, Else*), 'end' ';'
    hidden method DoIf(const AParent: int64; const ARole: NodeRole);
    var
      LNode: int64;
      LOpen: SourcePlace;
      LExpr: int64;
    begin
      LNode := self.DoAddAt(AParent, ARole, NodeKind.IfStatement);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      LExpr := self.DoExpression();
      self.DoPut(LNode, NodeRole.Condition, LExpr);
      self.DoRequire(TokenKind.KwThen, DoQuoted("then"));
      self.DoStatements(LNode, NodeRole.Then, [StatementStop.AtElse]);
      if self.DoKind() = TokenKind.KwElse then
        self.DoAdvance();
        self.DoStatements(LNode, NodeRole.Else, []);
      end;
      self.DoCloseEnd(LOpen, "if");
      self.DoEnd(LNode);
    end;

    // True when a lock / trylock statement (BNF sec 5, H4t) starts at the cursor: the
    // identifier AWord, '(' and after its matching ')' the word 'do' (for trylock also the
    // context word 'wait'). Any other 'lock (W)' is sec 7's intrinsic call, any other
    // trylock a name
    hidden const method DoIsLockStart(const AWord: string): bool;
    var
      LAt: int64;
      LDepth: int64;
      LKind: TokenKind;
    begin
      if (self.DoKind() <> TokenKind.Identifier) or (self.DoToken().Text <> AWord) or
        (self.DoKindAt(1) <> TokenKind.LParen) then
        return false;
      end;
      // The ')' that closes the '(' after the word
      LAt := 1;
      LDepth := 0;
      while true do
        LKind := self.DoKindAt(LAt);
        if LKind = TokenKind.EndOfFile then
          return false;
        end;
        if (LKind = TokenKind.LParen) or (LKind = TokenKind.LBracket) then
          LDepth := LDepth + 1;
        end;
        if (LKind = TokenKind.RParen) or (LKind = TokenKind.RBracket) then
          LDepth := LDepth - 1;
          if LDepth = 0 then
            leave;
          end;
        end;
        LAt := LAt + 1;
      end;
      if self.DoKindAt(LAt + 1) = TokenKind.KwDo then
        return true;
      end;
      return (AWord = "trylock") and (self.DoKindAt(LAt + 1) = TokenKind.Identifier) and
        (self.DoTextAt(LAt + 1) = "wait");
    end;

    // A lock or trylock statement (AKind, BNF sec 5, H4t): LockStatement / TryLockStatement
    // (Subject, trylock's Limit the milliseconds after 'wait', Statement*, trylock's Else*),
    // 'end' ';'
    hidden method DoLock(const AParent: int64; const ARole: NodeRole; const AKind: NodeKind);
    var
      LNode: int64;
      LOpen: SourcePlace;
      LExpr: int64;
      LWord: string;
    begin
      LNode := self.DoAddAt(AParent, ARole, AKind);
      LOpen := self.DoToken().Place;
      LWord := self.DoToken().Text;
      self.DoAdvance();
      self.DoRequire(TokenKind.LParen, DoQuoted("("));
      LExpr := self.DoExpression();
      self.DoPut(LNode, NodeRole.Subject, LExpr);
      self.DoRequire(TokenKind.RParen, DoQuoted(")"));
      if (AKind = NodeKind.TryLockStatement) and (self.DoKind() = TokenKind.Identifier) and
        (self.DoToken().Text = "wait") then
        self.DoAdvance();
        LExpr := self.DoExpression();
        self.DoPut(LNode, NodeRole.Limit, LExpr);
      end;
      self.DoRequire(TokenKind.KwDo, DoQuoted("do"));
      if AKind = NodeKind.TryLockStatement then
        self.DoStatements(LNode, NodeRole.Statement, [StatementStop.AtElse]);
        if self.DoKind() = TokenKind.KwElse then
          self.DoAdvance();
          self.DoStatements(LNode, NodeRole.Else, []);
        end;
      else
        self.DoStatements(LNode, NodeRole.Statement, []);
      end;
      self.DoCloseEnd(LOpen, LWord);
      self.DoEnd(LNode);
    end;

    // A while statement: WhileStatement (Condition, Statement*), 'end' ';'
    hidden method DoWhile(const AParent: int64; const ARole: NodeRole);
    var
      LNode: int64;
      LOpen: SourcePlace;
      LExpr: int64;
    begin
      LNode := self.DoAddAt(AParent, ARole, NodeKind.WhileStatement);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      LExpr := self.DoExpression();
      self.DoPut(LNode, NodeRole.Condition, LExpr);
      self.DoRequire(TokenKind.KwDo, DoQuoted("do"));
      self.DoStatements(LNode, NodeRole.Statement, []);
      self.DoCloseEnd(LOpen, "while");
      self.DoEnd(LNode);
    end;

    // A for statement: ForStatement (Iterator a NameExpression, Start, Limit, flag Downto,
    // Statement*), 'end' ';'. The iterator is a name declared before (BNF sec 5)
    hidden method DoFor(const AParent: int64; const ARole: NodeRole);
    var
      LNode: int64;
      LOpen: SourcePlace;
      LName: int64;
      LExpr: int64;
    begin
      LNode := self.DoAddAt(AParent, ARole, NodeKind.ForStatement);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      if self.DoKind() = TokenKind.Identifier then
        LName := self.DoAddAt(LNode, NodeRole.Iterator, NodeKind.NameExpression);
        self.FState.Ast[LName].Text := self.DoToken().Text;
        self.DoAdvance();
        self.DoEnd(LName);
      else
        self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
      end;
      self.DoRequire(TokenKind.Assign, DoQuoted(":="));
      LExpr := self.DoExpression();
      self.DoPut(LNode, NodeRole.Start, LExpr);
      if self.DoKind() = TokenKind.KwDownto then
        self.FState.Ast[LNode].AddFlag(NodeFlag.Downto);
        self.DoAdvance();
      else
        self.DoRequire(TokenKind.KwTo, DoQuoted("to"));
      end;
      LExpr := self.DoExpression();
      self.DoPut(LNode, NodeRole.Limit, LExpr);
      self.DoRequire(TokenKind.KwDo, DoQuoted("do"));
      self.DoStatements(LNode, NodeRole.Statement, []);
      self.DoCloseEnd(LOpen, "for");
      self.DoEnd(LNode);
    end;

    // A repeat statement: RepeatStatement (Statement*, Condition after 'until'), ';'
    hidden method DoRepeat(const AParent: int64; const ARole: NodeRole);
    var
      LNode: int64;
      LOpen: SourcePlace;
      LExpr: int64;
    begin
      LNode := self.DoAddAt(AParent, ARole, NodeKind.RepeatStatement);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      self.DoStatements(LNode, NodeRole.Statement, [StatementStop.AtUntil]);
      if self.DoKind() = TokenKind.KwUntil then
        self.DoAdvance();
        LExpr := self.DoExpression();
        self.DoPut(LNode, NodeRole.Condition, LExpr);
        self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
      else
        if self.DoKind() = TokenKind.EndOfFile then
          if not self.FUnclosed then
            self.DoReport(ADAM_ERR_PARSER_063, LOpen, ADAM_MSG_PARSER_NOT_CLOSED,
              NoArgs().Str("repeat"));
          end;
          self.FUnclosed := true;
        else
          self.DoExpected(DoQuoted("until"));
        end;
      end;
      self.DoEnd(LNode);
    end;

    // A match statement: MatchStatement (Subject, Arm*, Else*; flag ElsePart when an else
    // part is written), 'end' ';'. An arm is a MatchArm (Label*, Statement*), a label a
    // MatchLabel (LowBound, [HighBound])
    hidden method DoMatch(const AParent: int64; const ARole: NodeRole);
    var
      LNode: int64;
      LOpen: SourcePlace;
      LExpr: int64;
      LAt: int64;
    begin
      LNode := self.DoAddAt(AParent, ARole, NodeKind.MatchStatement);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      LExpr := self.DoExpression();
      self.DoPut(LNode, NodeRole.Subject, LExpr);
      self.DoRequire(TokenKind.KwOf, DoQuoted("of"));
      while not (self.FUnclosed or self.FTooDeep) do
        if (self.DoKind() = TokenKind.KwEnd) or (self.DoKind() = TokenKind.KwElse) or
          (self.DoKind() = TokenKind.EndOfFile) then
          leave;
        end;
        LAt := self.FAt;
        self.DoMatchArm(LNode);
        if self.FAt = LAt then
          self.DoSkipStatement(LNode, NodeRole.Arm);
        end;
      end;
      if self.DoKind() = TokenKind.KwElse then
        // The flag keeps an empty else part, which leaves no Else child
        self.FState.Ast[LNode].AddFlag(NodeFlag.ElsePart);
        self.DoAdvance();
        self.DoStatements(LNode, NodeRole.Else, []);
      end;
      self.DoCloseEnd(LOpen, "match");
      self.DoEnd(LNode);
    end;

    // One match arm at the cursor under AMatch: its labels (',' between them), ':', then
    // its statements up to the next arm, 'else' or 'end'
    hidden method DoMatchArm(const AMatch: int64);
    var
      LArm: int64;
      LLabel: int64;
      LExpr: int64;
    begin
      LArm := self.DoAddAt(AMatch, NodeRole.Arm, NodeKind.MatchArm);
      while true do
        LLabel := self.DoAddAt(LArm, NodeRole.Label, NodeKind.MatchLabel);
        LExpr := self.DoExpression();
        self.DoPut(LLabel, NodeRole.LowBound, LExpr);
        if self.DoKind() = TokenKind.DotDot then
          self.DoAdvance();
          LExpr := self.DoExpression();
          self.DoPut(LLabel, NodeRole.HighBound, LExpr);
        end;
        self.DoEnd(LLabel);
        if self.DoKind() <> TokenKind.Comma then
          leave;
        end;
        self.DoAdvance();
      end;
      self.DoRequire(TokenKind.Colon, DoQuoted(":"));
      self.DoStatements(LArm, NodeRole.Statement, [StatementStop.AtElse, StatementStop.AtArm]);
      self.DoEnd(LArm);
    end;

    // A guard statement: GuardStatement (Statement*, Except*, Finally*), 'end' ';'. With
    // neither 'except' nor 'finally' it is PR0052 at 'guard'
    hidden method DoGuard(const AParent: int64; const ARole: NodeRole);
    var
      LNode: int64;
      LOpen: SourcePlace;
      LHandled: bool;
    begin
      LNode := self.DoAddAt(AParent, ARole, NodeKind.GuardStatement);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      LHandled := false;
      self.DoStatements(LNode, NodeRole.Statement, [StatementStop.AtExceptFinally]);
      if self.DoKind() = TokenKind.KwExcept then
        LHandled := true;
        // Written even when the part holds no statement (it then swallows)
        self.FState.Ast[LNode].AddFlag(NodeFlag.ExceptPart);
        self.DoAdvance();
        self.DoStatements(LNode, NodeRole.Except, [StatementStop.AtExceptFinally]);
      end;
      if self.DoKind() = TokenKind.KwFinally then
        LHandled := true;
        self.DoAdvance();
        self.DoStatements(LNode, NodeRole.Finally, []);
      end;
      if (not LHandled) and (not self.FUnclosed) then
        self.DoReport(ADAM_ERR_PARSER_052, LOpen, ADAM_MSG_PARSER_GUARD_NO_HANDLER, NoArgs());
      end;
      self.DoCloseEnd(LOpen, "guard");
      self.DoEnd(LNode);
    end;

    // A return statement: ReturnStatement ([Value]) ';'
    hidden method DoReturn(const AParent: int64; const ARole: NodeRole);
    var
      LNode: int64;
      LExpr: int64;
    begin
      LNode := self.DoAddAt(AParent, ARole, NodeKind.ReturnStatement);
      self.DoAdvance();
      if self.DoKind() <> TokenKind.Semicolon then
        LExpr := self.DoExpression();
        self.DoPut(LNode, NodeRole.Value, LExpr);
      end;
      self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
      self.DoEnd(LNode);
    end;

    // A leave / skip statement (AKind) and its ';'
    hidden method DoJump(const AParent: int64; const ARole: NodeRole; const AKind: NodeKind);
    var
      LNode: int64;
    begin
      LNode := self.DoAddAt(AParent, ARole, AKind);
      self.DoAdvance();
      self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
      self.DoEnd(LNode);
    end;

    // A dotted name at the cursor (an identifier): AName gets it ("A.B.C") and the cursor
    // moves past it; false (PR0001 reported) when a '.' is not followed by an identifier
    hidden method DoDottedName(var AName: string): bool;
    begin
      AName := self.DoToken().Text;
      self.DoAdvance();
      while self.DoKind() = TokenKind.Dot do
        self.DoAdvance();
        if self.DoKind() <> TokenKind.Identifier then
          self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
          return false;
        end;
        AName := AName + "." + self.DoToken().Text;
        self.DoAdvance();
      end;
      return true;
    end;

    // The token at the cursor as an argument of ADirective: a node of AKind whose Text is
    // its spelling (an integer's value and suffix too)
    hidden method DoLeaf(const ADirective: int64; const AKind: NodeKind);
    var
      LToken: ref Token;
      LId: int64;
    begin
      LToken := self.DoToken();
      LId := self.DoAddAt(ADirective, NodeRole.Argument, AKind);
      self.FState.Ast[LId].Text := LToken.Text;
      if AKind = NodeKind.IntLiteral then
        self.FState.Ast[LId].IntValue := LToken.IntValue;
        self.FState.Ast[LId].Suffix := LToken.Suffix;
      end;
      self.DoAdvance();
    end;

    // AId's decoded values and faults back to none (a literal with no value)
    hidden method DoClearDecoded(const AId: int64);
    begin
      self.FState.Ast[AId].Decoded := "";
      setlength(self.FState.Ast[AId].DecodedWide, 0);
      self.FState.Ast[AId].NarrowFault.Reason := "";
      self.FState.Ast[AId].NarrowFault.IsWarning := false;
      self.FState.Ast[AId].WideFault.Reason := "";
      self.FState.Ast[AId].WideFault.IsWarning := false;
    end;

    // Decodes the string token at the cursor (Adam.Compiler.Literals) and joins its value
    // onto the StringLiteral AId: each encoding's value appended while that encoding has
    // no fault, the first fault of each kept. False when it has no value (PR0009); a
    // fault both encodings share is PR0021, the value kept
    hidden method DoDecodePiece(const AId: int64): bool;
    var
      LDecoded: DecodedLiteral;
    begin
      DecodeString(self.DoToken().Text, LDecoded);
      if LDecoded.Status = LiteralStatus.Error then
        self.DoReport(ADAM_ERR_PARSER_009, self.DoToken().Place, ADAM_MSG_PARSER_BAD_STRING,
          NoArgs().Str(LDecoded.Reason));
        return false;
      end;
      if LDecoded.Status = LiteralStatus.Warning then
        self.DoWarning(ADAM_ERR_PARSER_021, self.DoToken().Place, ADAM_MSG_PARSER_STRING_WARNING,
          NoArgs().Str(LDecoded.Reason));
      end;
      if self.FState.Ast[AId].NarrowFault.Reason = "" then
        if LDecoded.NarrowFault.Reason <> "" then
          self.FState.Ast[AId].NarrowFault := LDecoded.NarrowFault;
          self.FState.Ast[AId].Decoded := "";
        else
          self.FState.Ast[AId].Decoded := self.FState.Ast[AId].Decoded + LDecoded.Narrow;
        end;
      end;
      if self.FState.Ast[AId].WideFault.Reason = "" then
        if LDecoded.WideFault.Reason <> "" then
          self.FState.Ast[AId].WideFault := LDecoded.WideFault;
          setlength(self.FState.Ast[AId].DecodedWide, 0);
        else
          self.FState.Ast[AId].DecodedWide := self.FState.Ast[AId].DecodedWide + LDecoded.Wide;
        end;
      end;
      return true;
    end;

    // The string at the cursor as a StringLiteral with no parent, its Text its spelling;
    // with AJoin the adjacent strings after it are joined into it (BNF sec 9), their
    // spellings separated by a blank. Each piece is decoded and its value joined
    // (DoDecodePiece); AOk false when a piece has no value: the node then has none
    hidden method DoStringNode(const AJoin: bool; var AOk: bool): int64;
    var
      LId: int64;
      LText: string;
    begin
      LId := self.DoNew(NodeKind.StringLiteral);
      LText := self.DoToken().Text;
      AOk := self.DoDecodePiece(LId);
      self.DoAdvance();
      while AJoin and (self.DoKind() = TokenKind.StringLiteral) do
        LText := LText + " " + self.DoToken().Text;
        if not self.DoDecodePiece(LId) then
          AOk := false;
        end;
        self.DoAdvance();
      end;
      self.FState.Ast[LId].Text := LText;
      if not AOk then
        self.DoClearDecoded(LId);
      end;
      self.DoEnd(LId);
      return LId;
    end;

    // True when the argument number AIndex (0-based) of the directive ASpelling is a path
    // (BNF sec 2), resolved once by the parser
    hidden const method DoIsPathArgument(const ASpelling: string; const AIndex: int64): bool;
    begin
      if ASpelling = "@addresdata" then
        return AIndex = 1;
      end;
      return (ASpelling = "@exeicon") or (ASpelling = "@addmodulepath") or
        (ASpelling = "@outputpath") or (ASpelling = "@copydll") or
        (ASpelling = "@addlibrarypath");
    end;

    // The path argument AArg of the directive ASpelling resolved once into its
    // ResolvedPath ($P: the exe's folder, $D: / no prefix the working folder, $R: the
    // project root; System.Windows' ResolvePath). $R: in a build with no project is
    // PR0065; a value that resolves to nothing (blank, a bare prefix) is PR0022. Whether
    // the path exists is Semantics'
    hidden method DoResolvePath(const AArg: int64; const ASpelling: string;
      const APlace: SourcePlace);
    var
      LValue: string;
      LTrimmed: string;
      LRoot: string;
      LPath: string;
    begin
      LValue := self.FState.Ast[AArg].Decoded;
      LTrimmed := Trim(LValue);
      LRoot := self.FState.Sources.ProjectRoot();
      if (len(LTrimmed) >= 3) and (LTrimmed[0] = '$') and ((LTrimmed[1] = 'R') or
        (LTrimmed[1] = 'r')) and (LTrimmed[2] = ':') then
        if LRoot = "" then
          self.DoReport(ADAM_ERR_PARSER_065, APlace, ADAM_MSG_PARSER_NO_PROJECT_ROOT,
            NoArgs().Str(ASpelling).Str(LValue));
          return;
        end;
        LPath := ResolvePath(Substring(LTrimmed, 3, len(LTrimmed) - 3), LRoot);
      else
        LPath := ResolvePath(LValue);
      end;
      if LPath = "" then
        self.DoReport(ADAM_ERR_PARSER_022, APlace, ADAM_MSG_PARSER_PATH_RESOLVE,
          NoArgs().Str(ASpelling).Str(LValue));
        return;
      end;
      self.FState.Ast[AArg].ResolvedPath := LPath;
    end;

    // PR0055 at APlace when AText has no library name's shape (BNF sec 2); AWhere names
    // what takes it
    hidden method DoCheckLibraryName(const AText: string; const AWhere: string;
      const APlace: SourcePlace);
    begin
      if not IsLibraryName(AText) then
        self.DoReport(ADAM_ERR_PARSER_055, APlace, ADAM_MSG_PARSER_LIB_NAME,
          NoArgs().Str(AText).Str(AWhere));
      end;
    end;

    // The string argument AArg of ADirective, as its directive takes it: a directive's
    // value is narrow text, so a narrow fault is PR0009 here; a path is resolved, a
    // library name's shape checked
    hidden method DoDirectiveValue(const ADirective: int64; const AArg: int64;
      const APlace: SourcePlace);
    var
      LSpelling: string;
      LIndex: int64;
    begin
      if self.FState.Ast[AArg].NarrowFault.Reason <> "" then
        self.DoReport(ADAM_ERR_PARSER_009, APlace, ADAM_MSG_PARSER_BAD_STRING,
          NoArgs().Str(self.FState.Ast[AArg].NarrowFault.Reason));
        return;
      end;
      LSpelling := self.FState.Ast[ADirective].Text;
      LIndex := self.FState.Ast.CountOf(ADirective, NodeRole.Argument) - 1;
      if self.DoIsPathArgument(LSpelling, LIndex) then
        self.DoResolvePath(AArg, LSpelling, APlace);
        return;
      end;
      if LSpelling = "@linklibrary" then
        self.DoCheckLibraryName(self.FState.Ast[AArg].Decoded, LSpelling, APlace);
      end;
    end;

    // The string at the cursor as an argument of ADirective (DoStringNode), judged as its
    // directive takes it once it has a value (DoDirectiveValue)
    hidden method DoString(const ADirective: int64; const AJoin: bool);
    var
      LId: int64;
      LPlace: SourcePlace;
      LOk: bool;
    begin
      LPlace := self.DoToken().Place;
      LOk := true;
      LId := self.DoStringNode(AJoin, LOk);
      self.DoPut(ADirective, NodeRole.Argument, LId);
      if LOk then
        self.DoDirectiveValue(ADirective, LId, LPlace);
      end;
    end;

    // PR0006 at the cursor: ASpelling takes AShape. The rest up to ';' is skipped under
    // ADirective. Always false
    hidden method DoShapeError(const ADirective: int64; const ASpelling: string;
      const AShape: DirectiveShape): bool;
    begin
      self.DoReport(ADAM_ERR_PARSER_006, self.DoToken().Place, ADAM_MSG_PARSER_DIRECTIVE_SHAPE,
        NoArgs().Str(ASpelling).Str(DoShapeText(AShape)));
      self.DoSkip(ADirective, NodeRole.Argument, true, false);
      return false;
    end;

    // True when the directive's arguments end here (a ';' at the cursor); a token that
    // starts a part of the module is a missing ';' (PR0001); anything else is one argument
    // too many (PR0006)
    hidden method DoShapeEnd(const ADirective: int64; const ASpelling: string;
      const AShape: DirectiveShape): bool;
    begin
      if self.DoKind() = TokenKind.Semicolon then
        return true;
      end;
      if DoIsSync(self.DoKind()) then
        self.DoExpected(DoQuoted(";"));
        return false;
      end;
      return self.DoShapeError(ADirective, ASpelling, AShape);
    end;

    // The arguments of the directive ASpelling of AShape, as Argument children of
    // ADirective: true when they fit (the cursor then at the ';'); else reported (PR0006,
    // PR0007 for @message's severity, PR0001 for a missing ';') and skipped
    hidden method DoArguments(const ADirective: int64; const ASpelling: string;
      const AShape: DirectiveShape): bool;
    begin
      match AShape of
        DirectiveShape.Bare:
          return self.DoShapeEnd(ADirective, ASpelling, AShape);
        DirectiveShape.Name:
          if self.DoKind() <> TokenKind.Identifier then
            return self.DoShapeError(ADirective, ASpelling, AShape);
          end;
          self.DoLeaf(ADirective, NodeKind.NameExpression);
        DirectiveShape.Number:
          if self.DoKind() <> TokenKind.IntLiteral then
            return self.DoShapeError(ADirective, ASpelling, AShape);
          end;
          self.DoLeaf(ADirective, NodeKind.IntLiteral);
        DirectiveShape.Text:
          if self.DoKind() <> TokenKind.StringLiteral then
            return self.DoShapeError(ADirective, ASpelling, AShape);
          end;
          self.DoString(ADirective, true);
        DirectiveShape.Message:
          if self.DoKind() <> TokenKind.Identifier then
            return self.DoShapeError(ADirective, ASpelling, AShape);
          end;
          if not DoIsSeverity(self.DoToken().Text) then
            self.DoReport(ADAM_ERR_PARSER_007, self.DoToken().Place, ADAM_MSG_PARSER_SEVERITY,
              NoArgs().Str(self.DoToken().Text));
            self.DoSkip(ADirective, NodeRole.Argument, true, false);
            return false;
          end;
          self.DoLeaf(ADirective, NodeKind.NameExpression);
          if self.DoKind() <> TokenKind.StringLiteral then
            return self.DoShapeError(ADirective, ASpelling, AShape);
          end;
          self.DoString(ADirective, true);
        DirectiveShape.KeyPath:
          if self.DoKind() <> TokenKind.StringLiteral then
            return self.DoShapeError(ADirective, ASpelling, AShape);
          end;
          self.DoString(ADirective, false);
          if self.DoKind() <> TokenKind.StringLiteral then
            return self.DoShapeError(ADirective, ASpelling, AShape);
          end;
          self.DoString(ADirective, false);
      end;
      return self.DoShapeEnd(ADirective, ASpelling, AShape);
    end;

    // The build directive at the cursor: a Directive node under AParent playing ARole (Text
    // its spelling) and its arguments. Not a build directive: PR0005, skipped to ';'; a
    // main-module-only directive in a unit: PR0023 (still read). In a body (AInBody) only
    // @breakpoint and @message stand (BNF sec 5); any other is PR0008, still read
    hidden method DoDirective(const AParent: int64; const ARole: NodeRole; const AInBody: bool);
    var
      LDirective: int64;
      LSpelling: string;
      LShape: DirectiveShape;
      LMainOnly: bool;
    begin
      LSpelling := self.DoToken().Text;
      LDirective := self.DoAddAt(AParent, ARole, NodeKind.Directive);
      self.FState.Ast[LDirective].Text := LSpelling;
      if not DoDirectiveShape(LSpelling, LShape, LMainOnly) then
        self.DoReport(ADAM_ERR_PARSER_005, self.DoToken().Place,
          ADAM_MSG_PARSER_UNKNOWN_DIRECTIVE, NoArgs().Str(LSpelling));
        self.DoAdvance();
        self.DoSkip(LDirective, NodeRole.Argument, true, false);
        self.DoEnd(LDirective);
        return;
      end;
      if AInBody and (LSpelling <> "@breakpoint") and (LSpelling <> "@message") then
        self.DoReport(ADAM_ERR_PARSER_008, self.DoToken().Place, ADAM_MSG_PARSER_DIRECTIVE_PLACE,
          NoArgs().Str(LSpelling));
      end;
      if LMainOnly and (self.FKind = ModuleKind.Unit) then
        self.DoReport(ADAM_ERR_PARSER_023, self.DoToken().Place, ADAM_MSG_PARSER_UNIT_MAIN_ONLY,
          NoArgs().Str(LSpelling));
      end;
      self.DoAdvance();
      if self.DoArguments(LDirective, LSpelling, LShape) then
        self.DoAdvance();
      end;
      self.DoEnd(LDirective);
    end;

    // The directive prologue: every build directive right after the module header
    hidden method DoPrologue();
    begin
      while self.DoKind() = TokenKind.Directive do
        self.DoDirective(self.FModule, NodeRole.Directive, false);
      end;
    end;

    // The module's @addmodulepath folders, in their order, added to the module paths
    // (BNF sec 1: after the compiler's own; one already there is not added again). Each
    // was resolved once at its directive; one with no resolved path was reported there
    hidden method DoAddModulePaths();
    var
      LI: int64;
      LDirective: int64;
      LArg: int64;
    begin
      for LI := 0 to self.FState.Ast.CountOf(self.FModule, NodeRole.Directive) - 1 do
        LDirective := self.FState.Ast.NthOf(self.FModule, NodeRole.Directive, LI);
        if (self.FState.Ast[LDirective].Text = "@addmodulepath") and
          (self.FState.Ast.CountOf(LDirective, NodeRole.Argument) > 0) then
          LArg := self.FState.Ast.NthOf(LDirective, NodeRole.Argument, 0);
          if self.FState.Ast[LArg].ResolvedPath <> "" then
            self.FState.Sources.AddModulePath(self.FState.Ast[LArg].ResolvedPath);
          end;
        end;
      end;
    end;

    // True when an Import of the module other than AImport already names AName
    hidden const method DoImportedBefore(const AName: string; const AImport: int64): bool;
    var
      LI: int64;
      LOther: int64;
    begin
      for LI := 0 to self.FState.Ast.CountOf(self.FModule, NodeRole.Import) - 1 do
        LOther := self.FState.Ast.NthOf(self.FModule, NodeRole.Import, LI);
        if (LOther <> AImport) and (self.FState.Ast[LOther].Text = AName) then
          return true;
        end;
      end;
      return false;
    end;

    // The import clause at the cursor ('import'): an Import node per name (role Import,
    // Text the dotted name), each unit parsed when it is named (ResolvedUnit its module
    // id). A name the clause holds already is PR0014 and is not loaded again
    hidden method DoImportClause();
    var
      LImport: int64;
      LName: string;
      LPlace: SourcePlace;
    begin
      self.DoAdvance();
      while true do
        if self.DoKind() <> TokenKind.Identifier then
          self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
          self.DoSkip(self.FModule, NodeRole.Import, true, false);
          return;
        end;
        LPlace := self.DoToken().Place;
        LImport := self.DoAddAt(self.FModule, NodeRole.Import, NodeKind.Import);
        LName := "";
        if not self.DoDottedName(LName) then
          self.FState.Ast[LImport].Text := LName;
          self.DoEnd(LImport);
          self.DoSkip(self.FModule, NodeRole.Import, true, false);
          return;
        end;
        self.FState.Ast[LImport].Text := LName;
        self.DoEnd(LImport);
        if self.DoImportedBefore(LName, LImport) then
          self.DoReport(ADAM_ERR_PARSER_014, LPlace, ADAM_MSG_PARSER_DUPLICATE_IMPORT,
            NoArgs().Str(LName));
        else
          self.FState.Ast[LImport].ResolvedUnit := DoParseUnit(self.FState, LName,
            ExtractFileDir(self.FPath), LPlace);
        end;
        if self.DoKind() = TokenKind.Comma then
          self.DoAdvance();
        else
          if self.DoKind() = TokenKind.Semicolon then
            self.DoAdvance();
            return;
          end;
          self.DoExpected(DoQuoted(";"));
          self.DoSkip(self.FModule, NodeRole.Import, true, false);
          return;
        end;
      end;
    end;

    // A test block at the cursor ('test'): a TestBlock under the module (role Test, Text
    // the name's spelling), its var block (each decl role Local), its body a Block (role
    // Body), then ';'
    hidden method DoTest();
    var
      LTest: int64;
    begin
      LTest := self.DoAddAt(self.FModule, NodeRole.Test, NodeKind.TestBlock);
      self.DoAdvance();
      if self.DoKind() = TokenKind.StringLiteral then
        self.FState.Ast[LTest].Text := self.DoToken().Text;
        self.DoAdvance();
      else
        self.DoExpected(ADAM_MSG_PARSER_A_STRING);
      end;
      if self.DoKind() = TokenKind.KwVar then
        self.DoVarBlock(LTest, NodeRole.Local, false);
      end;
      if self.DoKind() = TokenKind.KwBegin then
        self.DoBlock(LTest, NodeRole.Body, true);
        if not self.FUnclosed then
          self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
        end;
      else
        self.DoExpected(DoQuoted("begin"));
        self.DoSkip(LTest, NodeRole.Body, true, false);
      end;
      self.DoEnd(LTest);
    end;

    // What stands out of its place between the import clause and the sections: a second
    // import clause (PR0010) or a build directive (PR0008), each skipped to its ';', a test
    // block (PR0019, read as one)
    hidden method DoMisplaced();
    begin
      while true do
        if self.DoKind() = TokenKind.KwImport then
          self.DoReport(ADAM_ERR_PARSER_010, self.DoToken().Place, ADAM_MSG_PARSER_IMPORT_PLACE,
            NoArgs());
          self.DoSkip(self.FModule, NodeRole.Import, true, true);
        else
          if self.DoKind() = TokenKind.Directive then
            self.DoReport(ADAM_ERR_PARSER_008, self.DoToken().Place,
              ADAM_MSG_PARSER_DIRECTIVE_PLACE, NoArgs().Str(self.DoToken().Text));
            self.DoSkip(self.FModule, NodeRole.Directive, true, true);
          else
            if self.DoKind() = TokenKind.KwTest then
              self.DoReport(ADAM_ERR_PARSER_019, self.DoToken().Place,
                ADAM_MSG_PARSER_TEST_PLACE, NoArgs());
              self.DoTest();
            else
              leave;
            end;
          end;
        end;
      end;
    end;

    // An initialize or finalize section at the cursor: a node of AKind under the module
    // playing ARole (an Error node when AWrong: twice or out of order, reported by the
    // caller), its body a Block (role Body), then ';'. Local blocks are M1.6's
    hidden method DoSection(const AKind: NodeKind; const ARole: NodeRole; const AWrong: bool);
    var
      LKind: NodeKind;
      LSection: int64;
    begin
      LKind := AKind;
      if AWrong then
        LKind := NodeKind.Error;
      end;
      LSection := self.DoAddAt(self.FModule, ARole, LKind);
      self.DoAdvance();
      if self.DoKind() = TokenKind.KwBegin then
        self.DoBlock(LSection, NodeRole.Body, true);
        if not self.FUnclosed then
          self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
        end;
      else
        self.DoExpected(DoQuoted("begin"));
        self.DoSkip(LSection, NodeRole.Body, true, false);
      end;
      self.DoEnd(LSection);
    end;

    // The initialize and finalize sections, each at most once, initialize first (PR0018)
    hidden method DoSections();
    var
      LInit: bool;
      LFinal: bool;
      LWrong: bool;
    begin
      LInit := false;
      LFinal := false;
      while (self.DoKind() = TokenKind.KwInitialize) or (self.DoKind() = TokenKind.KwFinalize) do
        if self.FUnclosed then
          return;
        end;
        if self.DoKind() = TokenKind.KwInitialize then
          LWrong := LInit or LFinal;
          if LInit then
            self.DoReport(ADAM_ERR_PARSER_018, self.DoToken().Place, ADAM_MSG_PARSER_SECTION_TWICE,
              NoArgs().Str("initialize"));
          else
            if LFinal then
              self.DoReport(ADAM_ERR_PARSER_018, self.DoToken().Place,
                ADAM_MSG_PARSER_SECTION_ORDER, NoArgs());
            end;
          end;
          LInit := true;
          self.DoSection(NodeKind.InitializeSection, NodeRole.Initialize, LWrong);
        else
          LWrong := LFinal;
          if LFinal then
            self.DoReport(ADAM_ERR_PARSER_018, self.DoToken().Place, ADAM_MSG_PARSER_SECTION_TWICE,
              NoArgs().Str("finalize"));
          end;
          LFinal := true;
          self.DoSection(NodeKind.FinalizeSection, NodeRole.Finalize, LWrong);
        end;
      end;
    end;

    // The exe's begin body (a Block, role Body: only an exe has one, PR0016; an exe needs
    // one, PR0017), then the module's 'end' '.'
    hidden method DoBodyAndEnd();
    var
      LHasBody: bool;
      LBegin: SourcePlace;
    begin
      LHasBody := false;
      if self.DoKind() = TokenKind.KwBegin then
        LHasBody := true;
        LBegin := self.DoToken().Place;
        self.DoBlock(self.FModule, NodeRole.Body, false);
        if (self.FKind <> ModuleKind.Exe) and (self.FKind <> ModuleKind.None) then
          self.DoReport(ADAM_ERR_PARSER_016, LBegin, ADAM_MSG_PARSER_BEGIN_NOT_EXE,
            NoArgs().Str(DoKindPhrase(self.FKind)));
        end;
      end;
      if self.FUnclosed then
        return;
      end;
      if (not LHasBody) and (self.FKind = ModuleKind.Exe) and (self.DoKind() = TokenKind.KwEnd) then
        self.DoReport(ADAM_ERR_PARSER_017, self.DoToken().Place, ADAM_MSG_PARSER_EXE_NO_BEGIN,
          NoArgs());
      end;
      if self.DoKind() <> TokenKind.KwEnd then
        self.DoExpected(DoQuoted("end"));
        self.DoSkipBalanced(self.FModule, NodeRole.Declaration);
        if self.DoKind() <> TokenKind.KwEnd then
          return;
        end;
      end;
      self.DoAdvance();
      self.DoRequire(TokenKind.Dot, DoQuoted("."));
    end;

    // What follows the module's 'end' '.': test blocks only; anything else is PR0020
    // (once) and is skipped up to the next test block as an Error node (role Test)
    hidden method DoTests();
    var
      LReported: bool;
      LError: int64;
    begin
      LReported := false;
      while self.DoKind() <> TokenKind.EndOfFile do
        if self.DoKind() = TokenKind.KwTest then
          self.DoTest();
          if self.FUnclosed then
            return;
          end;
        else
          if not LReported then
            self.DoReport(ADAM_ERR_PARSER_020, self.DoToken().Place, ADAM_MSG_PARSER_AFTER_END,
              NoArgs());
            LReported := true;
          end;
          LError := self.DoAddAt(self.FModule, NodeRole.Test, NodeKind.Error);
          while (self.DoKind() <> TokenKind.EndOfFile) and (self.DoKind() <> TokenKind.KwTest) do
            self.DoAdvance();
          end;
          self.DoEnd(LError);
        end;
      end;
    end;

    // True when the token at the cursor is the identifier AWord (a word in context)
    hidden const method DoIsWord(const AWord: string): bool;
    begin
      return (self.DoKind() = TokenKind.Identifier) and (self.DoToken().Text = AWord);
    end;

    // True when the token after the cursor is of AKind and starts where the cursor's ends
    // (the two make one C form: '==', '!=')
    hidden const method DoAdjacent(const AKind: TokenKind): bool;
    begin
      if self.FAt + 1 >= self.FTokens.Count then
        return false;
      end;
      return (self.FTokens[self.FAt + 1].Kind = AKind) and
        (self.FTokens[self.FAt + 1].StartOffset = self.FTokens[self.FAt].EndOffset);
    end;

    // The tokens from AFirst up to the cursor, their spellings joined by blanks (a
    // type as a message names it)
    hidden const method DoSpelledFrom(const AFirst: int64): string;
    var
      LText: string;
      LI: int64;
    begin
      LText := "";
      for LI := AFirst to self.FAt - 1 do
        if LText <> "" then
          LText := LText + " ";
        end;
        LText := LText + self.FTokens[LI].Text;
      end;
      return LText;
    end;

    // One level deeper into a nested expression or type: true; at ADAM_PARSER_NEST_MAX
    // levels false, and PR0042 at the cursor (once per parse)
    hidden method DoEnter(): bool;
    begin
      if self.FDepth >= ADAM_PARSER_NEST_MAX then
        if not self.FTooDeep then
          self.DoReport(ADAM_ERR_PARSER_042, self.DoToken().Place, ADAM_MSG_PARSER_NESTED_TOO_DEEP,
            NoArgs().Int(ADAM_PARSER_NEST_MAX));
          self.FTooDeep := true;
        end;
        return false;
      end;
      self.FDepth := self.FDepth + 1;
      return true;
    end;

    // Back out of the level DoEnter went into
    hidden method DoLeave();
    begin
      self.FDepth := self.FDepth - 1;
    end;

    // What lies past the nesting bound: everything from the cursor to the end of the file
    // as one Error node with no parent (empty at the end of the file). The openers it
    // leaves open are not reported again: PR0042 said why
    hidden method DoTooDeep(): int64;
    var
      LId: int64;
    begin
      LId := self.DoNew(NodeKind.Error);
      while self.DoKind() <> TokenKind.EndOfFile do
        self.DoAdvance();
      end;
      self.DoEnd(LId);
      return LId;
    end;

    // Skips from the cursor up to the closer ACloser at this nesting level (left at the
    // cursor), a token that starts a part of a module or the end of the file, keeping
    // ( ) and [ ] balanced; a ';' ends the skip too, except in a parameter list (ARole
    // Param), where it separates the parameters. One Error node under AParent playing ARole
    // (none when nothing is skipped)
    hidden method DoSkipToCloser(const AParent: int64; const ARole: NodeRole;
      const ACloser: TokenKind);
    var
      LError: int64;
      LDepth: int64;
      LKind: TokenKind;
    begin
      LError := 0;
      LDepth := 0;
      while self.DoKind() <> TokenKind.EndOfFile do
        LKind := self.DoKind();
        if LDepth = 0 then
          if (LKind = ACloser) or DoIsSync(LKind) then
            leave;
          end;
          if (LKind = TokenKind.Semicolon) and (ARole <> NodeRole.Param) then
            leave;
          end;
        end;
        if (LKind = TokenKind.LParen) or (LKind = TokenKind.LBracket) then
          LDepth := LDepth + 1;
        else
          if ((LKind = TokenKind.RParen) or (LKind = TokenKind.RBracket)) and (LDepth > 0) then
            LDepth := LDepth - 1;
          end;
        end;
        if LError = 0 then
          LError := self.DoAddAt(AParent, ARole, NodeKind.Error);
        end;
        self.DoAdvance();
      end;
      if LError <> 0 then
        self.DoEnd(LError);
      end;
    end;

    // The closer ACloser of the opener AOpener at AOpen: moved past. At the end of the
    // file the opener is never closed (PR0063 at it); any other token is PR0001 (unless
    // AQuiet: the caller reported what is wrong there) and is skipped up to the closer
    // (DoSkipToCloser, under AParent playing ARole), which is then moved past
    hidden method DoClose(const ACloser: TokenKind; const AOpen: SourcePlace;
      const AOpener: string; const AParent: int64; const ARole: NodeRole; const AQuiet: bool);
    begin
      if self.DoKind() = ACloser then
        self.DoAdvance();
        return;
      end;
      if self.FTooDeep then
        return;
      end;
      if self.DoKind() = TokenKind.EndOfFile then
        self.DoReport(ADAM_ERR_PARSER_063, AOpen, ADAM_MSG_PARSER_NOT_CLOSED,
          NoArgs().Str(AOpener));
        self.FUnclosed := true;
        return;
      end;
      if not AQuiet then
        self.DoExpected(DoQuoted(DoCloserText(ACloser)));
      end;
      self.DoSkipToCloser(AParent, ARole, ACloser);
      if self.DoKind() = ACloser then
        self.DoAdvance();
      end;
    end;

    // An expression at the cursor (BNF sec 6): its id, a node with no parent; the caller
    // attaches it. A missing one is PR0001 and an empty Error node. Each expression nested
    // in another (a parenthesis, an argument, an index, ...) is one level (DoEnter)
    hidden method DoExpression(): int64;
    var
      LId: int64;
    begin
      if not self.DoEnter() then
        return self.DoTooDeep();
      end;
      LId := self.DoAssignment();
      self.DoLeave();
      return LId;
    end;

    // Level 2: a conditional, then an assignment operator and the expression it assigns
    // (right associative): an AssignExpression (Op, Text the spelling, Target, Source)
    hidden method DoAssignment(): int64;
    var
      LTarget: int64;
      LOp: OperatorKind;
      LNode: int64;
      LSource: int64;
    begin
      LTarget := self.DoConditional();
      LOp := DoAssignOp(self.DoKind());
      if LOp = OperatorKind.None then
        return LTarget;
      end;
      LNode := self.DoNewOver(NodeKind.AssignExpression, LTarget, NodeRole.Target);
      self.FState.Ast[LNode].Op := LOp;
      self.FState.Ast[LNode].Text := self.DoToken().Text;
      self.DoAdvance();
      LSource := self.DoExpression();
      self.DoPut(LNode, NodeRole.Source, LSource);
      self.DoEnd(LNode);
      return LNode;
    end;

    // Level 4: an or-expression, then '?' expression ':' conditional (right associative):
    // a ConditionalExpression (Condition, Then, Else). A missing ':' is PR0001; the else
    // part is still read when an expression can start there
    hidden method DoConditional(): int64;
    var
      LCondition: int64;
      LNode: int64;
      LThen: int64;
      LElse: int64;
      LHasColon: bool;
    begin
      LCondition := self.DoBinary(6);
      if self.DoKind() <> TokenKind.Question then
        return LCondition;
      end;
      LNode := self.DoNewOver(NodeKind.ConditionalExpression, LCondition, NodeRole.Condition);
      self.DoAdvance();
      LThen := self.DoExpression();
      self.DoPut(LNode, NodeRole.Then, LThen);
      LHasColon := self.DoKind() = TokenKind.Colon;
      if LHasColon then
        self.DoAdvance();
      else
        self.DoExpected(DoQuoted(":"));
      end;
      if LHasColon or not DoEndsExpression(self.DoKind()) then
        if self.DoEnter() then
          LElse := self.DoConditional();
          self.DoLeave();
        else
          LElse := self.DoTooDeep();
        end;
        self.DoPut(LNode, NodeRole.Else, LElse);
      end;
      self.DoEnd(LNode);
      return LNode;
    end;

    // The operand of level ALevel's operators: the next tighter level of BNF sec 6's table
    hidden method DoTighter(const ALevel: int32): int64;
    begin
      if ALevel = 6 then
        return self.DoBinary(8);
      end;
      if ALevel = 8 then
        return self.DoRelation();
      end;
      if ALevel = 20 then
        return self.DoBinary(25);
      end;
      if ALevel = 25 then
        return self.DoBinary(30);
      end;
      return self.DoUnary();
    end;

    // The left-associative level ALevel (6 or, 8 and, 20 add, 25 shift, 30 mul): operands
    // of the next tighter level joined by the level's operators into BinaryExpressions (Op,
    // Text the spelling, Left, Right); at level 30 'as' and a type too (an AsExpression)
    hidden method DoBinary(const ALevel: int32): int64;
    var
      LLeft: int64;
      LOp: OperatorKind;
      LNode: int64;
      LRight: int64;
    begin
      LLeft := self.DoTighter(ALevel);
      while true do
        if (ALevel = 30) and self.DoIsWord("as") and DoStartsType(self.DoKindAt(1)) then
          LLeft := self.DoTypeTest(NodeKind.AsExpression, LLeft);
          skip;
        end;
        LOp := DoBinaryOp(ALevel, self.DoKind());
        if LOp = OperatorKind.None then
          leave;
        end;
        LNode := self.DoNewOver(NodeKind.BinaryExpression, LLeft, NodeRole.Left);
        self.FState.Ast[LNode].Op := LOp;
        self.FState.Ast[LNode].Text := self.DoToken().Text;
        self.DoAdvance();
        LRight := self.DoTighter(ALevel);
        self.DoPut(LNode, NodeRole.Right, LRight);
        self.DoEnd(LNode);
        LLeft := LNode;
      end;
      return LLeft;
    end;

    // The relational operator at the cursor (level 10): its kind, AText its spelling and
    // ATokens how many tokens it takes. The C forms '==' and '!=' are two adjacent tokens,
    // read as '=' and '<>' (the caller reports them). None for any other token
    hidden const method DoRelOp(var AText: string; var ATokens: int64): OperatorKind;
    begin
      AText := self.DoToken().Text;
      ATokens := 1;
      match self.DoKind() of
        TokenKind.Equal:
          if self.DoAdjacent(TokenKind.Equal) then
            AText := "==";
            ATokens := 2;
          end;
          return OperatorKind.Equal;
        TokenKind.Bang:
          if self.DoAdjacent(TokenKind.Equal) then
            AText := "!=";
            ATokens := 2;
            return OperatorKind.NotEqual;
          end;
          return OperatorKind.None;
        TokenKind.NotEqual:
          return OperatorKind.NotEqual;
        TokenKind.Less:
          return OperatorKind.Less;
        TokenKind.LessEqual:
          return OperatorKind.LessEqual;
        TokenKind.Greater:
          return OperatorKind.Greater;
        TokenKind.GreaterEqual:
          return OperatorKind.GreaterEqual;
        TokenKind.Compare:
          return OperatorKind.Compare;
        TokenKind.KwIn:
          return OperatorKind.In;
      else
        return OperatorKind.None;
      end;
    end;

    // Level 10, non-chaining: a sum, then one relational operator and its sum (a
    // BinaryExpression) or 'is' and a type (an IsExpression). A second one is PR0038 and is
    // read on into the tree (the relation so far its left operand), so nothing is dropped;
    // '==' / '!=' are PR0039 and read as '=' / '<>'
    hidden method DoRelation(): int64;
    var
      LLeft: int64;
      LCount: int64;
      LOp: OperatorKind;
      LText: string;
      LTokens: int64;
      LNode: int64;
      LRight: int64;
      LHint: string;
    begin
      LLeft := self.DoBinary(20);
      LCount := 0;
      while true do
        LText := "is";
        LTokens := 0;
        LOp := OperatorKind.None;
        if not (self.DoIsWord("is") and DoStartsType(self.DoKindAt(1))) then
          LOp := self.DoRelOp(LText, LTokens);
          if LOp = OperatorKind.None then
            leave;
          end;
        end;
        if LCount > 0 then
          self.DoReport(ADAM_ERR_PARSER_038, self.DoToken().Place, ADAM_MSG_PARSER_NO_CHAIN,
            NoArgs().Str(DoQuoted(LText)));
        end;
        LCount := LCount + 1;
        if LTokens = 0 then
          LLeft := self.DoTypeTest(NodeKind.IsExpression, LLeft);
          skip;
        end;
        if LTokens = 2 then
          LHint := "<>";
          if LOp = OperatorKind.Equal then
            LHint := "=";
          end;
          self.DoReport(ADAM_ERR_PARSER_039, self.DoToken().Place,
            ADAM_MSG_PARSER_NOT_ADAM_OPERATOR, NoArgs().Str(LText).Str(DoQuoted(LHint)));
        end;
        LNode := self.DoNewOver(NodeKind.BinaryExpression, LLeft, NodeRole.Left);
        self.FState.Ast[LNode].Op := LOp;
        self.FState.Ast[LNode].Text := LText;
        self.DoAdvance();
        if LTokens = 2 then
          self.DoAdvance();
        end;
        LRight := self.DoBinary(20);
        self.DoPut(LNode, NodeRole.Right, LRight);
        self.DoEnd(LNode);
        LLeft := LNode;
      end;
      return LLeft;
    end;

    // 'is' / 'as' at the cursor after AOperand: a node of AKind over AOperand (role
    // Operand) holding the type after the word (role TypeOf)
    hidden method DoTypeTest(const AKind: NodeKind; const AOperand: int64): int64;
    var
      LNode: int64;
      LType: int64;
    begin
      LNode := self.DoNewOver(AKind, AOperand, NodeRole.Operand);
      self.DoAdvance();
      LType := self.DoTypeExpr();
      self.DoPut(LNode, NodeRole.TypeOf, LType);
      self.DoEnd(LNode);
      return LNode;
    end;

    // Level 35: a prefix operator and its operand, itself a prefix chain (not not X): a
    // UnaryExpression (Op, Text the spelling, Operand); 'addr' needs its 'of' (PR0001, the
    // operand still read). Without one, a postfix chain
    hidden method DoUnary(): int64;
    var
      LOp: OperatorKind;
      LIsAddr: bool;
      LText: string;
      LNode: int64;
      LOperand: int64;
    begin
      // 'async' / 'await' are context words (BNF sec 6 unary expr): the operator only
      // before a name or self, an identifier everywhere else
      if (self.DoKind() = TokenKind.Identifier) and DoIsTaskOperand(self.DoKindAt(1)) then
        if self.DoToken().Text = "async" then
          return self.DoTaskOperator(NodeKind.AsyncExpression);
        end;
        if self.DoToken().Text = "await" then
          return self.DoTaskOperator(NodeKind.AwaitExpression);
        end;
      end;
      LOp := DoPrefixOp(self.DoKind());
      if LOp = OperatorKind.None then
        return self.DoPostfix();
      end;
      LIsAddr := (self.DoKind() = TokenKind.KwAddr);
      LText := self.DoToken().Text;
      LNode := self.DoNew(NodeKind.UnaryExpression);
      self.FState.Ast[LNode].Op := LOp;
      self.DoAdvance();
      if LIsAddr then
        if self.DoKind() = TokenKind.KwOf then
          LText := "addr of";
          self.DoAdvance();
        else
          self.DoExpected(DoQuoted("of"));
        end;
      end;
      self.FState.Ast[LNode].Text := LText;
      if self.DoEnter() then
        LOperand := self.DoUnary();
        self.DoLeave();
      else
        LOperand := self.DoTooDeep();
      end;
      self.DoPut(LNode, NodeRole.Operand, LOperand);
      self.DoEnd(LNode);
      return LNode;
    end;

    // 'async' / 'await' at the cursor (BNF sec 6 unary expr): a node of AKind
    // (AsyncExpression / AwaitExpression) holding its Operand, for async a postfix chain
    // (SEM checks it is a call), for await a unary expression (a task)
    hidden method DoTaskOperator(const AKind: NodeKind): int64;
    var
      LNode: int64;
      LOperand: int64;
    begin
      LNode := self.DoNew(AKind);
      self.DoAdvance();
      if self.DoEnter() then
        if AKind = NodeKind.AsyncExpression then
          LOperand := self.DoPostfix();
        else
          LOperand := self.DoUnary();
        end;
        self.DoLeave();
      else
        LOperand := self.DoTooDeep();
      end;
      self.DoPut(LNode, NodeRole.Operand, LOperand);
      self.DoEnd(LNode);
      return LNode;
    end;

    // Levels 40-50: a primary, then its postfix operators left to right (a call, an index,
    // '.' / '->' and a member, '^', '++', '--')
    hidden method DoPostfix(): int64;
    var
      LExpr: int64;
      LGoing: bool;
    begin
      LExpr := self.DoPrimary();
      LGoing := true;
      while LGoing do
        match self.DoKind() of
          TokenKind.LParen:
            LExpr := self.DoCall(LExpr);
          TokenKind.LBracket:
            LExpr := self.DoIndex(LExpr);
          TokenKind.Dot, TokenKind.Arrow:
            LExpr := self.DoMember(LExpr);
          TokenKind.Caret:
            LExpr := self.DoPostfixOp(LExpr, OperatorKind.Deref);
          TokenKind.PlusPlus:
            LExpr := self.DoPostfixOp(LExpr, OperatorKind.Increment);
          TokenKind.MinusMinus:
            LExpr := self.DoPostfixOp(LExpr, OperatorKind.Decrement);
        else
          LGoing := false;
        end;
      end;
      return LExpr;
    end;

    // The arguments after an opening '(' at AOpen (moved past already) up to its ')': each
    // an expression under ANode playing Argument; the one at the zero-based position
    // ATypeAt (-1: none) is a type expression when it is unmistakably one
    // (DoIsTypeArgument)
    hidden method DoArgList(const ANode: int64; const AOpen: SourcePlace; const ATypeAt: int64);
    var
      LArgument: int64;
      LIndex: int64;
    begin
      LIndex := 0;
      if self.DoKind() <> TokenKind.RParen then
        while true do
          if (LIndex = ATypeAt) and self.DoIsTypeArgument() then
            LArgument := self.DoTypeExpr();
          else
            LArgument := self.DoExpression();
          end;
          LIndex := LIndex + 1;
          self.DoPut(ANode, NodeRole.Argument, LArgument);
          if self.DoKind() <> TokenKind.Comma then
            leave;
          end;
          self.DoAdvance();
        end;
      end;
      self.DoClose(TokenKind.RParen, AOpen, "(", ANode, NodeRole.Argument, false);
    end;

    // A call of ACallee ('(' at the cursor): a CallExpression (Callee, Argument*)
    hidden method DoCall(const ACallee: int64): int64;
    var
      LNode: int64;
      LOpen: SourcePlace;
      LType: int64;
    begin
      LNode := self.DoNewOver(NodeKind.CallExpression, ACallee, NodeRole.Callee);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      if self.DoIsSizeOfType(ACallee) then
        LType := self.DoTypeExpr();
        self.DoPut(LNode, NodeRole.Argument, LType);
        self.DoClose(TokenKind.RParen, LOpen, "(", LNode, NodeRole.Argument, false);
      else
        self.DoArgList(LNode, LOpen, self.DoTypeSlot(ACallee));
      end;
      self.DoEnd(LNode);
      return LNode;
    end;

    // The argument position a type may take in a call of ACallee (-1: none): after
    // `.next(` the first, after `.get(I,` the second, on any receiver (BNF sec 6 type arg:
    // Semantics decides by the receiver's type whether it reads a varargs pack)
    hidden const method DoTypeSlot(const ACallee: int64): int64;
    begin
      if self.FState.Ast[ACallee].Kind <> NodeKind.MemberExpression then
        return -1;
      end;
      if self.FState.Ast[ACallee].Text = "next" then
        return 0;
      end;
      if self.FState.Ast[ACallee].Text = "get" then
        return 1;
      end;
      return -1;
    end;

    // True when the argument at the cursor is unmistakably a type expression: it starts
    // with a type word no expression starts with (a builtin type word, array, routine; a
    // name parses as an expression, Semantics decides), and up to its ',' or ')' it holds
    // no '(' outside brackets before a 'routine' (`int32(X)` and `ptr to T(P)` are casts)
    hidden const method DoIsTypeArgument(): bool;
    var
      LAhead: int64;
      LDepth: int64;
      LKind: TokenKind;
    begin
      if (self.DoKind() = TokenKind.Identifier) or not DoStartsType(self.DoKind()) then
        return false;
      end;
      LAhead := 0;
      LDepth := 0;
      while true do
        LKind := self.DoKindAt(LAhead);
        if LKind = TokenKind.EndOfFile then
          return true;
        end;
        if (LDepth = 0) and (LKind = TokenKind.KwRoutine) then
          return true;
        end;
        if (LKind = TokenKind.LParen) or (LKind = TokenKind.LBracket) then
          if (LDepth = 0) and (LKind = TokenKind.LParen) then
            return false;
          end;
          LDepth := LDepth + 1;
        else
          if (LKind = TokenKind.RParen) or (LKind = TokenKind.RBracket) then
            if LDepth = 0 then
              return true;
            end;
            LDepth := LDepth - 1;
          else
            if (LDepth = 0) and (LKind = TokenKind.Comma) then
              return true;
            end;
          end;
        end;
        LAhead := LAhead + 1;
      end;
      return true;
    end;

    // True when ACallee is the name 'size' and its argument at the cursor is unmistakably
    // a type (BNF sec 7): a builtin type word, ptr, array or routine. A name alone parses
    // as an expression (Semantics requires it to name a type)
    hidden const method DoIsSizeOfType(const ACallee: int64): bool;
    begin
      if self.FState.Ast[ACallee].Kind <> NodeKind.NameExpression then
        return false;
      end;
      if self.FState.Ast[ACallee].Text <> "size" then
        return false;
      end;
      return (self.DoKind() <> TokenKind.Identifier) and DoStartsType(self.DoKind());
    end;

    // An index into AOperand ('[' at the cursor): an IndexExpression (Operand, Index)
    hidden method DoIndex(const AOperand: int64): int64;
    var
      LNode: int64;
      LOpen: SourcePlace;
      LIndex: int64;
    begin
      LNode := self.DoNewOver(NodeKind.IndexExpression, AOperand, NodeRole.Operand);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      LIndex := self.DoExpression();
      self.DoPut(LNode, NodeRole.Index, LIndex);
      self.DoClose(TokenKind.RBracket, LOpen, "[", LNode, NodeRole.Index, false);
      self.DoEnd(LNode);
      return LNode;
    end;

    // A member of AOperand ('.' or '->' at the cursor): a MemberExpression (Operand, Text
    // the member, flag Arrow for '->'). Any keyword is a member name; anything else is
    // PR0001 and stays
    hidden method DoMember(const AOperand: int64): int64;
    var
      LNode: int64;
    begin
      LNode := self.DoNewOver(NodeKind.MemberExpression, AOperand, NodeRole.Operand);
      if self.DoKind() = TokenKind.Arrow then
        self.FState.Ast[LNode].AddFlag(NodeFlag.Arrow);
      end;
      self.DoAdvance();
      if KeywordKind(self.DoToken().Text) = self.DoKind() then
        self.FState.Ast[LNode].Text := self.DoToken().Text;
        self.DoAdvance();
      else
        self.DoExpected(ADAM_MSG_PARSER_A_MEMBER_NAME);
      end;
      self.DoEnd(LNode);
      return LNode;
    end;

    // The postfix operator AOp at the cursor after AOperand: a PostfixExpression (Op, Text
    // the spelling, Operand)
    hidden method DoPostfixOp(const AOperand: int64; const AOp: OperatorKind): int64;
    var
      LNode: int64;
    begin
      LNode := self.DoNewOver(NodeKind.PostfixExpression, AOperand, NodeRole.Operand);
      self.FState.Ast[LNode].Op := AOp;
      self.FState.Ast[LNode].Text := self.DoToken().Text;
      self.DoAdvance();
      self.DoEnd(LNode);
      return LNode;
    end;

    // A primary (BNF sec 6 primary expr). A token no primary starts with is PR0001 (an
    // expression expected) and an empty Error node; the cursor stays
    hidden method DoPrimary(): int64;
    begin
      match self.DoKind() of
        TokenKind.IntLiteral:
          return self.DoLiteral(NodeKind.IntLiteral);
        TokenKind.FloatLiteral:
          return self.DoLiteral(NodeKind.FloatLiteral);
        TokenKind.CharLiteral:
          return self.DoLiteral(NodeKind.CharLiteral);
        TokenKind.StringLiteral:
          return self.DoStringExpression();
        TokenKind.KwTrue, TokenKind.KwFalse:
          return self.DoLiteral(NodeKind.BoolLiteral);
        TokenKind.KwNil:
          return self.DoLiteral(NodeKind.NilLiteral);
        TokenKind.KwSelf:
          return self.DoLiteral(NodeKind.SelfExpression);
        TokenKind.KwParent:
          return self.DoLiteral(NodeKind.ParentExpression);
        TokenKind.Identifier:
          return self.DoName();
        TokenKind.KwVarargs:
          return self.DoVarargs();
        TokenKind.KwPtr:
          if self.DoKindAt(1) = TokenKind.KwTo then
            return self.DoPointerCast();
          end;
          return self.DoTypeCast();
        TokenKind.LBracket:
          return self.DoSetLiteral();
        TokenKind.LParen:
          return self.DoParen();
      else
        if DoIsBuiltinType(self.DoKind()) then
          return self.DoTypeCast();
        end;
        return self.DoMissing(ADAM_MSG_PARSER_AN_EXPRESSION);
      end;
    end;

    // A string literal in an expression, its adjacent pieces joined (DoStringNode): a
    // piece with no value was reported there (PR0009) and the node keeps none
    hidden method DoStringExpression(): int64;
    var
      LOk: bool;
    begin
      LOk := true;
      return self.DoStringNode(true, LOk);
    end;

    // Decodes the char literal at the cursor into AId (Adam.Compiler.Literals): both
    // encodings, each one's fault, the narrow value in IntValue. No value is PR0054; a
    // fault both encodings share is PR0064, the value kept
    hidden method DoDecodeChar(const AId: int64);
    var
      LDecoded: DecodedLiteral;
    begin
      DecodeChar(self.DoToken().Text, LDecoded);
      if LDecoded.Status = LiteralStatus.Error then
        self.DoReport(ADAM_ERR_PARSER_054, self.DoToken().Place, ADAM_MSG_PARSER_BAD_CHAR,
          NoArgs().Str(LDecoded.Reason));
        return;
      end;
      if LDecoded.Status = LiteralStatus.Warning then
        self.DoWarning(ADAM_ERR_PARSER_064, self.DoToken().Place, ADAM_MSG_PARSER_CHAR_WARNING,
          NoArgs().Str(LDecoded.Reason));
      end;
      self.FState.Ast[AId].Decoded := LDecoded.Narrow;
      self.FState.Ast[AId].DecodedWide := LDecoded.Wide;
      self.FState.Ast[AId].NarrowFault := LDecoded.NarrowFault;
      self.FState.Ast[AId].WideFault := LDecoded.WideFault;
      self.FState.Ast[AId].IntValue := LDecoded.CharValue;
    end;

    // The token at the cursor as a leaf of AKind with no parent: Text its spelling (an
    // integer's value and a number's suffix too; a char's decoded value, DoDecodeChar)
    hidden method DoLiteral(const AKind: NodeKind): int64;
    var
      LToken: ref Token;
      LId: int64;
    begin
      LToken := self.DoToken();
      LId := self.DoNew(AKind);
      self.FState.Ast[LId].Text := LToken.Text;
      if AKind = NodeKind.IntLiteral then
        self.FState.Ast[LId].IntValue := LToken.IntValue;
      end;
      if (AKind = NodeKind.IntLiteral) or (AKind = NodeKind.FloatLiteral) then
        self.FState.Ast[LId].Suffix := LToken.Suffix;
      end;
      if AKind = NodeKind.CharLiteral then
        self.DoDecodeChar(LId);
      end;
      self.DoAdvance();
      return LId;
    end;

    // A parenthesized expression ('(' at the cursor): a ParenExpression (Operand)
    hidden method DoParen(): int64;
    var
      LNode: int64;
      LOpen: SourcePlace;
      LInner: int64;
    begin
      LNode := self.DoNew(NodeKind.ParenExpression);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      LInner := self.DoExpression();
      self.DoPut(LNode, NodeRole.Operand, LInner);
      self.DoClose(TokenKind.RParen, LOpen, "(", LNode, NodeRole.Operand, false);
      self.DoEnd(LNode);
      return LNode;
    end;

    // An identifier at the cursor: an owner word before a type head starts an owner new;
    // a dotted name before '(' Name ':' a record literal; anything else a NameExpression
    hidden method DoName(): int64;
    var
      LOwner: NodeKind;
      LId: int64;
    begin
      LOwner := DoOwnerKind(self.DoToken().Text, true);
      if (LOwner <> NodeKind.None) and DoIsTypeHead(self.DoKindAt(1)) then
        return self.DoOwnerNew(LOwner);
      end;
      if self.DoRecordAhead() then
        return self.DoRecordLiteral();
      end;
      LId := self.DoNew(NodeKind.NameExpression);
      self.FState.Ast[LId].Text := self.DoToken().Text;
      self.DoAdvance();
      return LId;
    end;

    // True when a record literal starts at the cursor: a dotted name, '(' , an identifier
    // and ':' (a field init; ':=' is another token, so `F(X := 1)` stays a call)
    hidden const method DoRecordAhead(): bool;
    var
      LAt: int64;
    begin
      LAt := 1;
      while (self.DoKindAt(LAt) = TokenKind.Dot) and
        (self.DoKindAt(LAt + 1) = TokenKind.Identifier) do
        LAt := LAt + 2;
      end;
      return (self.DoKindAt(LAt) = TokenKind.LParen) and
        (self.DoKindAt(LAt + 1) = TokenKind.Identifier) and
        (self.DoKindAt(LAt + 2) = TokenKind.Colon);
    end;

    // A record literal (DoRecordAhead held): a RecordLiteral (TypeOf the NamedType, a
    // FieldInit per field playing Argument: Text the field, Value its expression). A
    // place that holds no field init is PR0001 and is skipped to the ')'
    hidden method DoRecordLiteral(): int64;
    var
      LNode: int64;
      LType: int64;
      LOpen: SourcePlace;
      LField: int64;
      LValue: int64;
    begin
      LNode := self.DoNew(NodeKind.RecordLiteral);
      LType := self.DoNamedType();
      self.DoPut(LNode, NodeRole.TypeOf, LType);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      while true do
        if (self.DoKind() <> TokenKind.Identifier) or (self.DoKindAt(1) <> TokenKind.Colon) then
          self.DoExpected(ADAM_MSG_PARSER_A_FIELD_INIT);
          self.DoClose(TokenKind.RParen, LOpen, "(", LNode, NodeRole.Argument, true);
          self.DoEnd(LNode);
          return LNode;
        end;
        LField := self.DoNew(NodeKind.FieldInit);
        self.FState.Ast[LField].Text := self.DoToken().Text;
        self.DoAdvance();
        self.DoAdvance();
        LValue := self.DoExpression();
        self.DoPut(LField, NodeRole.Value, LValue);
        self.DoEnd(LField);
        self.DoPut(LNode, NodeRole.Argument, LField);
        if self.DoKind() <> TokenKind.Comma then
          leave;
        end;
        self.DoAdvance();
      end;
      self.DoClose(TokenKind.RParen, LOpen, "(", LNode, NodeRole.Argument, false);
      self.DoEnd(LNode);
      return LNode;
    end;

    // An owner new (own / ref / weak before a type head at the cursor): a node of AKind
    // (OwnNew / RefNew / WeakNew; weak builds nothing, Semantics' SM0359) holding the type
    // (TypeOf) and the init's arguments after it (Argument*)
    hidden method DoOwnerNew(const AKind: NodeKind): int64;
    var
      LNode: int64;
      LType: int64;
      LOpen: SourcePlace;
    begin
      LNode := self.DoNew(AKind);
      self.DoAdvance();
      LType := self.DoTypeExpr();
      self.DoPut(LNode, NodeRole.TypeOf, LType);
      if self.DoKind() = TokenKind.LParen then
        LOpen := self.DoToken().Place;
        self.DoAdvance();
        self.DoArgList(LNode, LOpen, -1);
      end;
      self.DoEnd(LNode);
      return LNode;
    end;

    // A varargs expression ('varargs' at the cursor): a VarargsExpression, Text the
    // member; next(T) holds T (TypeOf), get(I, T) I (Argument) and T, kind(I) I. A word
    // that is no member is PR0001 and is read as the member (the node holds it)
    hidden method DoVarargs(): int64;
    var
      LNode: int64;
      LMember: string;
      LOpen: SourcePlace;
      LIndex: int64;
      LType: int64;
    begin
      LNode := self.DoNew(NodeKind.VarargsExpression);
      self.DoAdvance();
      if self.DoKind() <> TokenKind.Dot then
        self.DoExpected(DoQuoted("."));
        self.DoEnd(LNode);
        return LNode;
      end;
      self.DoAdvance();
      if self.DoKind() <> TokenKind.Identifier then
        self.DoExpected(ADAM_MSG_PARSER_A_VARARGS_MEMBER);
        self.DoEnd(LNode);
        return LNode;
      end;
      LMember := self.DoToken().Text;
      if not DoIsVarargsMember(LMember) then
        self.DoExpected(ADAM_MSG_PARSER_A_VARARGS_MEMBER);
      end;
      self.FState.Ast[LNode].Text := LMember;
      self.DoAdvance();
      if (LMember = "count") or not DoIsVarargsMember(LMember) then
        self.DoEnd(LNode);
        return LNode;
      end;
      if self.DoKind() <> TokenKind.LParen then
        self.DoExpected(DoQuoted("("));
        self.DoEnd(LNode);
        return LNode;
      end;
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      if (LMember = "get") or (LMember = "kind") then
        LIndex := self.DoExpression();
        self.DoPut(LNode, NodeRole.Argument, LIndex);
      end;
      if LMember = "get" then
        self.DoRequire(TokenKind.Comma, DoQuoted(","));
      end;
      if (LMember = "next") or (LMember = "get") then
        LType := self.DoTypeExpr();
        self.DoPut(LNode, NodeRole.TypeOf, LType);
      end;
      self.DoClose(TokenKind.RParen, LOpen, "(", LNode, NodeRole.Argument, false);
      self.DoEnd(LNode);
      return LNode;
    end;

    // The '(' expression ')' of a cast ANode whose type is spelled ASpelling: the
    // expression plays Operand. More than one is PR0041; the others are read as Argument
    // children (nothing dropped)
    hidden method DoCastOperand(const ANode: int64; const ASpelling: string);
    var
      LOpen: SourcePlace;
      LOperand: int64;
      LExtra: int64;
    begin
      if self.DoKind() <> TokenKind.LParen then
        self.DoExpected(DoQuoted("("));
        return;
      end;
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      LOperand := self.DoExpression();
      self.DoPut(ANode, NodeRole.Operand, LOperand);
      if self.DoKind() = TokenKind.Comma then
        self.DoReport(ADAM_ERR_PARSER_041, self.DoToken().Place, ADAM_MSG_PARSER_CAST_ONE_ARG,
          NoArgs().Str(ASpelling));
        while self.DoKind() = TokenKind.Comma do
          self.DoAdvance();
          LExtra := self.DoExpression();
          self.DoPut(ANode, NodeRole.Argument, LExtra);
        end;
      end;
      self.DoClose(TokenKind.RParen, LOpen, "(", ANode, NodeRole.Argument, false);
    end;

    // A type cast (a builtin type word at the cursor, 'ptr' without 'to' included): a
    // TypeCast (TypeOf the BuiltinTypeName, Operand)
    hidden method DoTypeCast(): int64;
    var
      LNode: int64;
      LType: int64;
      LSpelling: string;
    begin
      LNode := self.DoNew(NodeKind.TypeCast);
      LSpelling := self.DoToken().Text;
      LType := self.DoBuiltinName();
      self.DoPut(LNode, NodeRole.TypeOf, LType);
      self.DoCastOperand(LNode, LSpelling);
      self.DoEnd(LNode);
      return LNode;
    end;

    // A pointer cast ('ptr' 'to' at the cursor): a PointerCast (TypeOf the PointerType,
    // Operand)
    hidden method DoPointerCast(): int64;
    var
      LNode: int64;
      LFirst: int64;
      LType: int64;
    begin
      LNode := self.DoNew(NodeKind.PointerCast);
      LFirst := self.FAt;
      LType := self.DoTypeExpr();
      self.DoPut(LNode, NodeRole.TypeOf, LType);
      self.DoCastOperand(LNode, self.DoSpelledFrom(LFirst));
      self.DoEnd(LNode);
      return LNode;
    end;

    // A bracket literal ('[' at the cursor, BNF sec 6: a set literal or an array literal,
    // parsed once; Semantics tells which by the place it goes): a SetLiteral, a SetElement
    // per element playing Element (LowBound, and HighBound for a range a..b); a comma right
    // before the `]` ends the list and flags the node TrailingComma (an array literal takes
    // it, Semantics refuses it on a set literal)
    hidden method DoSetLiteral(): int64;
    var
      LNode: int64;
      LOpen: SourcePlace;
      LElement: int64;
      LLow: int64;
      LHigh: int64;
    begin
      LNode := self.DoNew(NodeKind.SetLiteral);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      if self.DoKind() <> TokenKind.RBracket then
        while true do
          LElement := self.DoNew(NodeKind.SetElement);
          LLow := self.DoExpression();
          self.DoPut(LElement, NodeRole.LowBound, LLow);
          if self.DoKind() = TokenKind.DotDot then
            self.DoAdvance();
            LHigh := self.DoExpression();
            self.DoPut(LElement, NodeRole.HighBound, LHigh);
          end;
          self.DoEnd(LElement);
          self.DoPut(LNode, NodeRole.Element, LElement);
          if self.DoKind() <> TokenKind.Comma then
            leave;
          end;
          self.DoAdvance();
          if self.DoKind() = TokenKind.RBracket then
            self.FState.Ast[LNode].AddFlag(NodeFlag.TrailingComma);
            leave;
          end;
        end;
      end;
      self.DoClose(TokenKind.RBracket, LOpen, "[", LNode, NodeRole.Element, false);
      self.DoEnd(LNode);
      return LNode;
    end;

    // A type expression at the cursor (BNF sec 4 type expr): its id, a node with no
    // parent. Each type nested in another is one level (DoEnter)
    hidden method DoTypeExpr(): int64;
    var
      LId: int64;
    begin
      if not self.DoEnter() then
        return self.DoTooDeep();
      end;
      LId := self.DoTypeBody();
      self.DoLeave();
      return LId;
    end;

    // The kinds of type expression: an owner type before a type head, a named type, a
    // pointer type, an array type, a routine type, a builtin type word; a record / object /
    // overlay / choices / set is PR0026; anything else PR0001 and an empty Error node
    hidden method DoTypeBody(): int64;
    var
      LKind: TokenKind;
      LOwner: NodeKind;
    begin
      LKind := self.DoKind();
      if LKind = TokenKind.Identifier then
        // 'task' is a context word (BNF sec 4 task type): a type head here unless a dotted
        // name goes on from it
        if (self.DoToken().Text = "task") and (self.DoKindAt(1) <> TokenKind.Dot) then
          return self.DoTaskType();
        end;
        LOwner := DoOwnerKind(self.DoToken().Text, false);
        if (LOwner <> NodeKind.None) and DoIsTypeHead(self.DoKindAt(1)) then
          return self.DoOwnerType(LOwner);
        end;
        return self.DoNamedType();
      end;
      if LKind = TokenKind.KwPtr then
        return self.DoPointerType();
      end;
      if LKind = TokenKind.KwArray then
        return self.DoArrayType();
      end;
      if LKind = TokenKind.KwRoutine then
        return self.DoRoutineType();
      end;
      if DoIsBuiltinType(LKind) then
        return self.DoBuiltinName();
      end;
      if DoIsDeclaredOnly(LKind) then
        return self.DoDeclaredOnly();
      end;
      return self.DoMissing(ADAM_MSG_PARSER_A_TYPE);
    end;

    // The builtin type word at the cursor: a BuiltinTypeName, Text its spelling
    hidden method DoBuiltinName(): int64;
    var
      LId: int64;
    begin
      LId := self.DoNew(NodeKind.BuiltinTypeName);
      self.FState.Ast[LId].Text := self.DoToken().Text;
      self.DoAdvance();
      return LId;
    end;

    // A dotted name at the cursor (an identifier) as a type: a NamedType, Text the name
    hidden method DoNamedType(): int64;
    var
      LId: int64;
      LName: string;
    begin
      LId := self.DoNew(NodeKind.NamedType);
      LName := "";
      self.DoDottedName(LName);
      self.FState.Ast[LId].Text := LName;
      self.DoEnd(LId);
      return LId;
    end;

    // A record / object / overlay / choices / set word in a type expression: PR0026 (it
    // is declared in a type block and used by its name); the word ('set of' both words) is
    // one Error node with no parent
    hidden method DoDeclaredOnly(): int64;
    var
      LId: int64;
      LSpelling: string;
    begin
      LSpelling := self.DoToken().Text;
      if (self.DoKind() = TokenKind.KwSet) and (self.DoKindAt(1) = TokenKind.KwOf) then
        LSpelling := "set of";
      end;
      self.DoReport(ADAM_ERR_PARSER_026, self.DoToken().Place, ADAM_MSG_PARSER_DECLARE_AS_TYPE,
        NoArgs().Str(LSpelling));
      LId := self.DoNew(NodeKind.Error);
      self.DoAdvance();
      if LSpelling = "set of" then
        self.DoAdvance();
      end;
      self.DoEnd(LId);
      return LId;
    end;

    // An owner type (own / ref / weak before a type head at the cursor): a node of AKind
    // (OwnType / RefType / WeakType) holding the type it owns (Element)
    hidden method DoOwnerType(const AKind: NodeKind): int64;
    var
      LNode: int64;
      LElement: int64;
    begin
      LNode := self.DoNew(AKind);
      self.DoAdvance();
      LElement := self.DoTypeExpr();
      self.DoPut(LNode, NodeRole.Element, LElement);
      self.DoEnd(LNode);
      return LNode;
    end;

    // 'task' at the cursor (BNF sec 4 task type): a TaskType holding its result type
    // (Element) when a type head follows, none for a plain task
    hidden method DoTaskType(): int64;
    var
      LNode: int64;
      LElement: int64;
    begin
      LNode := self.DoNew(NodeKind.TaskType);
      self.DoAdvance();
      if DoIsTypeHead(self.DoKind()) then
        LElement := self.DoTypeExpr();
        self.DoPut(LNode, NodeRole.Element, LElement);
      end;
      self.DoEnd(LNode);
      return LNode;
    end;

    // 'ptr' at the cursor: with 'to' a PointerType (Element, flag ConstTarget for 'to
    // const'); alone the untyped ptr, a BuiltinTypeName
    hidden method DoPointerType(): int64;
    var
      LNode: int64;
      LElement: int64;
    begin
      if self.DoKindAt(1) <> TokenKind.KwTo then
        return self.DoBuiltinName();
      end;
      LNode := self.DoNew(NodeKind.PointerType);
      self.DoAdvance();
      self.DoAdvance();
      if self.DoKind() = TokenKind.KwConst then
        self.FState.Ast[LNode].AddFlag(NodeFlag.ConstTarget);
        self.DoAdvance();
      end;
      LElement := self.DoTypeExpr();
      self.DoPut(LNode, NodeRole.Element, LElement);
      self.DoEnd(LNode);
      return LNode;
    end;

    // An array type ('array' at the cursor): an ArrayType (LowBound HighBound for a
    // static one, none for a dynamic one, '[]' or no brackets; Element)
    hidden method DoArrayType(): int64;
    var
      LNode: int64;
      LOpen: SourcePlace;
      LLow: int64;
      LHigh: int64;
      LElement: int64;
    begin
      LNode := self.DoNew(NodeKind.ArrayType);
      self.DoAdvance();
      if self.DoKind() = TokenKind.LBracket then
        LOpen := self.DoToken().Place;
        self.DoAdvance();
        if self.DoKind() = TokenKind.RBracket then
          self.DoAdvance();
        else
          LLow := self.DoExpression();
          self.DoPut(LNode, NodeRole.LowBound, LLow);
          if self.DoKind() = TokenKind.DotDot then
            self.DoAdvance();
            LHigh := self.DoExpression();
            self.DoPut(LNode, NodeRole.HighBound, LHigh);
            self.DoClose(TokenKind.RBracket, LOpen, "[", LNode, NodeRole.HighBound, false);
          else
            self.DoExpected(DoQuoted(".."));
            self.DoClose(TokenKind.RBracket, LOpen, "[", LNode, NodeRole.HighBound, true);
          end;
        end;
      end;
      if self.DoKind() <> TokenKind.KwOf then
        self.DoExpected(DoQuoted("of"));
        self.DoEnd(LNode);
        return LNode;
      end;
      self.DoAdvance();
      LElement := self.DoTypeExpr();
      self.DoPut(LNode, NodeRole.Element, LElement);
      self.DoEnd(LNode);
      return LNode;
    end;

    // A routine type ('routine' at the cursor): a RoutineType (flag Clink / Cpplink for
    // the linkage written, Param* and flag Variadic from the parameter list, ReturnType)
    hidden method DoRoutineType(): int64;
    var
      LNode: int64;
      LReturn: int64;
    begin
      LNode := self.DoNew(NodeKind.RoutineType);
      self.DoAdvance();
      if self.DoKind() = TokenKind.KwClink then
        self.FState.Ast[LNode].AddFlag(NodeFlag.Clink);
        self.DoAdvance();
      else
        if self.DoKind() = TokenKind.KwCpplink then
          self.FState.Ast[LNode].AddFlag(NodeFlag.Cpplink);
          self.DoAdvance();
        end;
      end;
      if self.DoKind() <> TokenKind.LParen then
        self.DoExpected(DoQuoted("("));
        self.DoEnd(LNode);
        return LNode;
      end;
      self.DoParamList(LNode);
      if self.DoKind() = TokenKind.Colon then
        self.DoAdvance();
        LReturn := self.DoTypeExpr();
        self.DoPut(LNode, NodeRole.ReturnType, LReturn);
      end;
      self.DoEnd(LNode);
      return LNode;
    end;

    // A parameter list ('(' at the cursor; BNF sec 3 param list): a Param under AOwner per
    // parameter (Text its name, TypeOf its type, flag VarParam / ConstParam for its mode),
    // ';' between them; '...' (alone or last) is flag Variadic on AOwner. A parameter
    // without its name or its ':' is PR0001 and the rest is skipped to the ')'. Shared by
    // routine types and routine declarations (M1.6)
    hidden method DoParamList(const AOwner: int64);
    var
      LOpen: SourcePlace;
      LParam: int64;
      LType: int64;
    begin
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      if self.DoKind() = TokenKind.RParen then
        self.DoAdvance();
        return;
      end;
      while true do
        if self.DoKind() = TokenKind.Ellipsis then
          self.FState.Ast[AOwner].AddFlag(NodeFlag.Variadic);
          self.DoAdvance();
          leave;
        end;
        LParam := self.DoNew(NodeKind.Param);
        if self.DoKind() = TokenKind.KwVar then
          self.FState.Ast[LParam].AddFlag(NodeFlag.VarParam);
          self.DoAdvance();
        else
          if self.DoKind() = TokenKind.KwConst then
            self.FState.Ast[LParam].AddFlag(NodeFlag.ConstParam);
            self.DoAdvance();
          end;
        end;
        if self.DoKind() <> TokenKind.Identifier then
          self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
          self.DoEnd(LParam);
          self.DoPut(AOwner, NodeRole.Param, LParam);
          self.DoClose(TokenKind.RParen, LOpen, "(", AOwner, NodeRole.Param, true);
          return;
        end;
        self.FState.Ast[LParam].Text := self.DoToken().Text;
        self.DoAdvance();
        if self.DoKind() <> TokenKind.Colon then
          self.DoExpected(DoQuoted(":"));
          self.DoEnd(LParam);
          self.DoPut(AOwner, NodeRole.Param, LParam);
          self.DoClose(TokenKind.RParen, LOpen, "(", AOwner, NodeRole.Param, true);
          return;
        end;
        self.DoAdvance();
        LType := self.DoTypeExpr();
        self.DoPut(LParam, NodeRole.TypeOf, LType);
        self.DoEnd(LParam);
        self.DoPut(AOwner, NodeRole.Param, LParam);
        if self.DoKind() <> TokenKind.Semicolon then
          leave;
        end;
        self.DoAdvance();
      end;
      self.DoClose(TokenKind.RParen, LOpen, "(", AOwner, NodeRole.Param, false);
    end;

    // Flag Public on ANode when APublic (declarations, BNF sec 3, from here on; the
    // type definitions of a type block, sec 4, with them)
    hidden method DoMark(const ANode: int64; const APublic: bool);
    begin
      if APublic then
        self.FState.Ast[ANode].AddFlag(NodeFlag.Public);
      end;
    end;

    // The ';' that ends a declaration: moved past; missing, PR0001 and the tokens up to the
    // next ';' or part of a module are skipped as an Error node under AParent playing ARole
    hidden method DoSemicolon(const AParent: int64; const ARole: NodeRole);
    begin
      if self.DoKind() = TokenKind.Semicolon then
        self.DoAdvance();
      else
        self.DoExpected(DoQuoted(";"));
        self.DoSkip(AParent, ARole, true, false);
      end;
    end;

    // ':' and a type expression after a declared name (TypeOf of ADecl): false when the ':'
    // is missing (PR0001; the rest of the declaration up to its ';' skipped, an Error node
    // playing TypeOf)
    hidden method DoTypeOf(const ADecl: int64): bool;
    var
      LType: int64;
    begin
      if self.DoKind() <> TokenKind.Colon then
        self.DoExpected(DoQuoted(":"));
        self.DoSkip(ADecl, NodeRole.TypeOf, true, false);
        return false;
      end;
      self.DoAdvance();
      LType := self.DoTypeExpr();
      self.DoPut(ADecl, NodeRole.TypeOf, LType);
      return true;
    end;

    // An external clause ('external' at the cursor): an ExternalClause under AOwner (role
    // External), Text the spelling of its string or identifier (none: empty), then ';'.
    // A string library is decoded into the clause's Decoded (narrow text: no value or a
    // narrow fault is PR0009) and must have a library name's shape (PR0055); an
    // identifier is also a NameExpression child (role Argument), the library constant
    // Semantics resolves and checks
    hidden method DoExternal(const AOwner: int64);
    var
      LNode: int64;
      LName: int64;
      LDecoded: DecodedLiteral;
    begin
      LNode := self.DoAddAt(AOwner, NodeRole.External, NodeKind.ExternalClause);
      self.DoAdvance();
      if self.DoKind() = TokenKind.StringLiteral then
        self.FState.Ast[LNode].Text := self.DoToken().Text;
        DecodeString(self.DoToken().Text, LDecoded);
        if LDecoded.Status = LiteralStatus.Error then
          self.DoReport(ADAM_ERR_PARSER_009, self.DoToken().Place, ADAM_MSG_PARSER_BAD_STRING,
            NoArgs().Str(LDecoded.Reason));
        else
          if LDecoded.NarrowFault.Reason <> "" then
            self.DoReport(ADAM_ERR_PARSER_009, self.DoToken().Place, ADAM_MSG_PARSER_BAD_STRING,
              NoArgs().Str(LDecoded.NarrowFault.Reason));
          else
            if LDecoded.Status = LiteralStatus.Warning then
              self.DoWarning(ADAM_ERR_PARSER_021, self.DoToken().Place,
                ADAM_MSG_PARSER_STRING_WARNING, NoArgs().Str(LDecoded.Reason));
            end;
            self.FState.Ast[LNode].Decoded := LDecoded.Narrow;
            self.DoCheckLibraryName(LDecoded.Narrow, "external", self.DoToken().Place);
          end;
        end;
        self.DoAdvance();
      else
        if self.DoKind() = TokenKind.Identifier then
          // A library constant: a bare name (BNF sec 1), resolved and checked as one
          self.FState.Ast[LNode].Text := self.DoToken().Text;
          LName := self.DoAddAt(LNode, NodeRole.Argument, NodeKind.NameExpression);
          self.FState.Ast[LName].Text := self.DoToken().Text;
          self.DoAdvance();
        end;
      end;
      self.DoEnd(LNode);
      self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
    end;

    // A var block ('var' at the cursor; a body's misplaced 'threadstatic' too, PR0057
    // reported): a VarDecl under AParent playing ARole per name
    hidden method DoVarBlock(const AParent: int64; const ARole: NodeRole; const APublic: bool);
    begin
      self.DoAdvance();
      while self.DoKind() = TokenKind.Identifier do
        self.DoVarDeclOf(AParent, ARole, APublic, false);
      end;
    end;

    // A threadstatic block at module level ('threadstatic' at the cursor, BNF sec 3): a
    // VarDecl flagged ThreadStatic under AParent playing ARole per name
    hidden method DoThreadStaticBlock(const AParent: int64; const ARole: NodeRole;
      const APublic: bool);
    begin
      self.DoAdvance();
      while self.DoKind() = TokenKind.Identifier do
        self.DoVarDeclOf(AParent, ARole, APublic, true);
      end;
    end;

    // One var decl (its name at the cursor), not thread-static (DoVarDeclOf)
    hidden method DoVarDecl(const AParent: int64; const ARole: NodeRole; const APublic: bool);
    begin
      self.DoVarDeclOf(AParent, ARole, APublic, false);
    end;

    // One var decl (its name at the cursor): VarDecl (Text the name, TypeOf, then an
    // Initializer after '=' or a ConstructorArgument per argument of '(...)'), ';', then
    // an ExternalClause when 'external' follows; flagged ThreadStatic when AThreadStatic
    hidden method DoVarDeclOf(const AParent: int64; const ARole: NodeRole; const APublic: bool;
      const AThreadStatic: bool);
    var
      LDecl: int64;
      LValue: int64;
      LOpen: SourcePlace;
    begin
      LDecl := self.DoAddAt(AParent, ARole, NodeKind.VarDecl);
      self.DoMark(LDecl, APublic);
      if AThreadStatic then
        self.FState.Ast[LDecl].AddFlag(NodeFlag.ThreadStatic);
      end;
      self.FState.Ast[LDecl].Text := self.DoToken().Text;
      self.DoAdvance();
      if not self.DoTypeOf(LDecl) then
        self.DoEnd(LDecl);
        return;
      end;
      if self.DoKind() = TokenKind.Equal then
        self.DoAdvance();
        LValue := self.DoExpression();
        self.DoPut(LDecl, NodeRole.Initializer, LValue);
      else
        if self.DoKind() = TokenKind.LParen then
          LOpen := self.DoToken().Place;
          self.DoAdvance();
          self.DoConstructorArguments(LDecl, LOpen);
        end;
      end;
      self.DoSemicolon(LDecl, NodeRole.Initializer);
      if self.DoKind() = TokenKind.KwExternal then
        self.DoExternal(LDecl);
      end;
      self.DoEnd(LDecl);
    end;

    // A var's init arguments after its '(' (cursor past it): a ConstructorArgument under
    // ADecl per expression, ',' between them, then the ')'
    hidden method DoConstructorArguments(const ADecl: int64; const AOpen: SourcePlace);
    var
      LArgument: int64;
    begin
      if self.DoKind() <> TokenKind.RParen then
        while true do
          LArgument := self.DoExpression();
          self.DoPut(ADecl, NodeRole.ConstructorArgument, LArgument);
          if self.DoKind() <> TokenKind.Comma then
            leave;
          end;
          self.DoAdvance();
        end;
      end;
      self.DoClose(TokenKind.RParen, AOpen, "(", ADecl, NodeRole.ConstructorArgument, false);
    end;

    // A const block ('const' at the cursor): a ConstDecl per name (Text, TypeOf, the
    // Initializer after the '=' the grammar requires), each ended by ';'
    hidden method DoConstBlock(const AParent: int64; const ARole: NodeRole; const APublic: bool);
    begin
      self.DoAdvance();
      while self.DoKind() = TokenKind.Identifier do
        self.DoConstDecl(AParent, ARole, APublic);
      end;
    end;

    // One const decl (its name at the cursor): ConstDecl (Text, TypeOf, the Initializer
    // after the '=' the grammar requires), ended by ';'
    hidden method DoConstDecl(const AParent: int64; const ARole: NodeRole; const APublic: bool);
    var
      LDecl: int64;
      LValue: int64;
    begin
      LDecl := self.DoAddAt(AParent, ARole, NodeKind.ConstDecl);
      self.DoMark(LDecl, APublic);
      self.FState.Ast[LDecl].Text := self.DoToken().Text;
      self.DoAdvance();
      if self.DoTypeOf(LDecl) then
        if self.DoKind() = TokenKind.Equal then
          self.DoAdvance();
          LValue := self.DoExpression();
          self.DoPut(LDecl, NodeRole.Initializer, LValue);
          self.DoSemicolon(LDecl, NodeRole.Initializer);
        else
          self.DoExpected(DoQuoted("="));
          self.DoSkip(LDecl, NodeRole.Initializer, true, false);
        end;
      end;
      self.DoEnd(LDecl);
    end;

    // A type block ('type' at the cursor): a TypeDecl per name (Text, TypeOf the type it
    // defines), each ended by ';'. Generic params are M10's: a '<' after the name is PR0001
    hidden method DoTypeBlock(const AParent: int64; const ARole: NodeRole; const APublic: bool);
    var
      LDecl: int64;
      LDef: int64;
    begin
      self.DoAdvance();
      while self.DoKind() = TokenKind.Identifier do
        LDecl := self.DoAddAt(AParent, ARole, NodeKind.TypeDecl);
        self.DoMark(LDecl, APublic);
        self.FState.Ast[LDecl].Text := self.DoToken().Text;
        self.DoAdvance();
        if self.DoKind() = TokenKind.Equal then
          self.DoAdvance();
          LDef := self.DoTypeDef();
          self.DoPut(LDecl, NodeRole.TypeOf, LDef);
          if not self.FUnclosed then
            self.DoSemicolon(LDecl, NodeRole.TypeOf);
          end;
        else
          self.DoExpected(DoQuoted("="));
          self.DoSkip(LDecl, NodeRole.TypeOf, true, false);
        end;
        self.DoEnd(LDecl);
      end;
    end;

    // The type a type block defines: a record, an overlay, a choices or a set type, an
    // object ('final object' too) or an interface ('final' and 'interface' are context
    // words), or any type expression (an alias, an array, a pointer, a routine type)
    hidden method DoTypeDef(): int64;
    begin
      if self.DoKind() = TokenKind.KwObject then
        return self.DoObjectType(false);
      end;
      if (self.DoWordAt(0) = "final") and (self.DoKindAt(1) = TokenKind.KwObject) then
        return self.DoObjectType(true);
      end;
      if self.DoWordAt(0) = "interface" then
        return self.DoInterfaceType();
      end;
      if self.DoKind() = TokenKind.KwRecord then
        return self.DoRecordType();
      end;
      if self.DoKind() = TokenKind.KwOverlay then
        return self.DoOverlayType();
      end;
      if self.DoKind() = TokenKind.KwChoices then
        return self.DoChoicesType();
      end;
      if self.DoKind() = TokenKind.KwSet then
        return self.DoSetType();
      end;
      return self.DoTypeExpr();
    end;

    // A record's prefix word of rank ARank (1 parent, 2 packed, 3 align) at the cursor:
    // one that comes after a later one or repeats is PR0032, still parsed. ALast is the
    // highest rank seen
    hidden method DoPrefixOrder(const ARank: int32; var ALast: int32);
    begin
      if ARank <= ALast then
        self.DoReport(ADAM_ERR_PARSER_032, self.DoToken().Place, ADAM_MSG_PARSER_PREFIX_ORDER,
          NoArgs().Str(self.DoFound()));
      else
        ALast := ARank;
      end;
    end;

    // 'align' at the cursor: its '(' expression ')' under ANode (role Align)
    hidden method DoAlign(const ANode: int64);
    var
      LOpen: SourcePlace;
      LValue: int64;
    begin
      self.DoAdvance();
      if self.DoKind() <> TokenKind.LParen then
        self.DoExpected(DoQuoted("("));
        return;
      end;
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      LValue := self.DoExpression();
      self.DoPut(ANode, NodeRole.Align, LValue);
      self.DoClose(TokenKind.RParen, LOpen, "(", ANode, NodeRole.Align, false);
    end;

    // A record type ('record' at the cursor): RecordType ([Parent] NamedType, flag Packed,
    // [Align], Member*), up to its 'end'
    hidden method DoRecordType(): int64;
    var
      LNode: int64;
      LOpen: SourcePlace;
      LParenOpen: SourcePlace;
      LParent: int64;
      LLast: int32;
    begin
      LNode := self.DoNew(NodeKind.RecordType);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      LLast := 0;
      while true do
        if self.DoKind() = TokenKind.LParen then
          self.DoPrefixOrder(1, LLast);
          LParenOpen := self.DoToken().Place;
          self.DoAdvance();
          if self.DoKind() = TokenKind.Identifier then
            LParent := self.DoNamedType();
            self.DoPut(LNode, NodeRole.Parent, LParent);
          else
            self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
          end;
          self.DoClose(TokenKind.RParen, LParenOpen, "(", LNode, NodeRole.Parent, false);
        else
          if self.DoKind() = TokenKind.KwPacked then
            self.DoPrefixOrder(2, LLast);
            self.FState.Ast[LNode].AddFlag(NodeFlag.Packed);
            self.DoAdvance();
          else
            if self.DoKind() = TokenKind.KwAlign then
              self.DoPrefixOrder(3, LLast);
              self.DoAlign(LNode);
            else
              leave;
            end;
          end;
        end;
      end;
      self.DoMembers(LNode, false);
      self.DoAggregateEnd(LNode, LOpen, "record");
      return LNode;
    end;

    // An overlay type ('overlay' at the cursor): OverlayType (Member*), up to its 'end'.
    // 'packed' or 'align' after the word is PR0033 and consumed (align's value kept, role
    // Align)
    hidden method DoOverlayType(): int64;
    var
      LNode: int64;
      LOpen: SourcePlace;
    begin
      LNode := self.DoNew(NodeKind.OverlayType);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      self.DoNoPrefixWords(LNode, ADAM_MSG_PARSER_NOT_ON_OVERLAY);
      self.DoMembers(LNode, true);
      self.DoAggregateEnd(LNode, LOpen, "overlay");
      return LNode;
    end;

    // 'packed' / 'align(...)' where the aggregate takes neither (an overlay, an object):
    // PR0033 each with ATemplate, consumed (align's value kept, role Align)
    hidden method DoNoPrefixWords(const ANode: int64; const ATemplate: string);
    begin
      while (self.DoKind() = TokenKind.KwPacked) or (self.DoKind() = TokenKind.KwAlign) do
        self.DoReport(ADAM_ERR_PARSER_033, self.DoToken().Place, ATemplate,
          NoArgs().Str(self.DoToken().Text));
        if self.DoKind() = TokenKind.KwAlign then
          self.DoAlign(ANode);
        else
          self.DoAdvance();
        end;
      end;
    end;

    // An aggregate's 'end': moved past; the end of the file instead is PR0063 at the word
    // that opened it (AOpen, spelt AWord). ANode's range ends here
    hidden method DoAggregateEnd(const ANode: int64; const AOpen: SourcePlace;
      const AWord: string);
    begin
      if self.DoKind() = TokenKind.KwEnd then
        self.DoAdvance();
      else
        // The innermost opener the file never closes is reported once (PR0063)
        if not self.FUnclosed then
          self.DoReport(ADAM_ERR_PARSER_063, AOpen, ADAM_MSG_PARSER_NOT_CLOSED,
            NoArgs().Str(AWord));
        end;
        self.FUnclosed := true;
      end;
      self.DoEnd(ANode);
    end;

    // The members of a record (AOverlay false) or of an overlay (AOverlay true), up to
    // 'end' or the end of the file, one DoAggregateMember each
    hidden method DoMembers(const AOwner: int64; const AOverlay: bool);
    begin
      while (self.DoKind() <> TokenKind.KwEnd) and (self.DoKind() <> TokenKind.EndOfFile) do
        self.DoAggregateMember(AOwner, false, AOverlay);
        if self.FUnclosed then
          return;
        end;
      end;
    end;

    // One member at the cursor under AOwner: an object's (AInObject) or a record's /
    // overlay's (AOverlay). A field (Name ':' ...), an anonymous overlay in a record or an
    // anonymous record in an overlay, an operator (records and objects), or an object's
    // member (DoObjectMember: PR0034 in a record or an overlay, still parsed). An
    // identifier that starts none of them is a field missing its ':'; anything else is
    // PR0001 and skipped up to its ';' as an Error member
    hidden method DoAggregateMember(const AOwner: int64; const AInObject: bool; const AOverlay: bool);
    begin
      if (self.DoKind() = TokenKind.Identifier) and (self.DoKindAt(1) = TokenKind.Colon) then
        self.DoField(AOwner);
        return;
      end;
      if (not AInObject) and AOverlay and (self.DoKind() = TokenKind.KwRecord) then
        self.DoAnonAggregate(AOwner, NodeKind.AnonRecord);
        return;
      end;
      if (not AInObject) and (not AOverlay) and (self.DoKind() = TokenKind.KwOverlay) then
        self.DoAnonAggregate(AOwner, NodeKind.AnonOverlay);
        return;
      end;
      if self.DoKind() = TokenKind.KwOperator then
        self.DoOperatorDecl(AOwner, AInObject, AOverlay);
        return;
      end;
      if self.DoObjectMember(AOwner, AInObject, AOverlay) then
        return;
      end;
      if self.DoKind() = TokenKind.Identifier then
        self.DoField(AOwner);
        return;
      end;
      if AInObject then
        self.DoExpected(ADAM_MSG_PARSER_A_MEMBER);
      else
        self.DoExpected(ADAM_MSG_PARSER_A_FIELD);
      end;
      self.DoSkipMember(AOwner);
    end;

    // The token AAhead tokens after the cursor when it is an identifier (its spelling: a
    // context word is an identifier everywhere but where the grammar expects it); "" else
    hidden const method DoWordAt(const AAhead: int64): string;
    begin
      if self.DoKindAt(AAhead) <> TokenKind.Identifier then
        return "";
      end;
      return self.FTokens[self.FAt + AAhead].Text;
    end;

    // True when the token AAhead tokens after the cursor is a word before a member's
    // head: virtual, const before 'method', and the context words hidden / override /
    // final when no ':' follows them (then they are a field's name)
    hidden const method DoIsMemberWord(const AAhead: int64): bool;
    var
      LWord: string;
    begin
      if self.DoKindAt(AAhead) = TokenKind.KwVirtual then
        return true;
      end;
      if (self.DoKindAt(AAhead) = TokenKind.KwConst) and
        (self.DoKindAt(AAhead + 1) = TokenKind.KwMethod) then
        return true;
      end;
      LWord := self.DoWordAt(AAhead);
      if (LWord = "hidden") or (LWord = "override") or (LWord = "final") then
        return self.DoKindAt(AAhead + 1) <> TokenKind.Colon;
      end;
      return false;
    end;

    // The kind of the object member that starts at the cursor (looked ahead, nothing
    // moved): AWords gets how many words stand before its head. MethodDecl, PropertyDecl,
    // EmbedDecl, InitDecl, CopyDecl, DoneDecl, or FieldDecl for words before a field
    // ('hidden X: T;'); None when no member of an object starts here
    hidden const method DoMemberHead(var AWords: int64): NodeKind;
    var
      LWord: string;
    begin
      AWords := 0;
      while self.DoIsMemberWord(AWords) do
        AWords := AWords + 1;
      end;
      if self.DoKindAt(AWords) = TokenKind.KwMethod then
        return NodeKind.MethodDecl;
      end;
      LWord := self.DoWordAt(AWords);
      if LWord = "" then
        return NodeKind.None;
      end;
      if self.DoKindAt(AWords + 1) = TokenKind.Colon then
        if AWords > 0 then
          return NodeKind.FieldDecl;
        end;
        return NodeKind.None;
      end;
      if LWord = "property" then
        return NodeKind.PropertyDecl;
      end;
      if LWord = "embed" then
        return NodeKind.EmbedDecl;
      end;
      if LWord = "init" then
        return NodeKind.InitDecl;
      end;
      if LWord = "copy" then
        return NodeKind.CopyDecl;
      end;
      if LWord = "done" then
        return NodeKind.DoneDecl;
      end;
      return NodeKind.None;
    end;

    // The flag the member word at the cursor writes (DoIsMemberWord held)
    hidden const method DoWordFlag(): NodeFlag;
    var
      LWord: string;
    begin
      if self.DoKind() = TokenKind.KwVirtual then
        return NodeFlag.Virtual;
      end;
      if self.DoKind() = TokenKind.KwConst then
        return NodeFlag.ConstMethod;
      end;
      LWord := self.DoWordAt(0);
      if LWord = "hidden" then
        return NodeFlag.Hidden;
      end;
      if LWord = "override" then
        return NodeFlag.Override;
      end;
      return NodeFlag.Final;
    end;

    // Moves past AWords member words, adding each one's flag to AFlags; a word whose flag
    // AAllowed does not hold is ACode at it ("'X' does not go before AHead"), still kept
    hidden method DoTakeWords(const AWords: int64; const AHead: string; const AAllowed: NodeFlags;
      const ACode: string; var AFlags: NodeFlags);
    var
      LI: int64;
      LFlag: NodeFlag;
    begin
      for LI := 1 to AWords do
        LFlag := self.DoWordFlag();
        if not (LFlag in AAllowed) then
          self.DoReport(ACode, self.DoToken().Place, ADAM_MSG_PARSER_NO_WORD_BEFORE,
            NoArgs().Str(self.DoToken().Text).Str(AHead));
        end;
        AFlags += [LFlag];
        self.DoAdvance();
      end;
    end;

    // What a member report names the aggregate: a record or an overlay
    hidden const method DoAggregatePhrase(const AOverlay: bool): string;
    begin
      if AOverlay then
        return ADAM_MSG_PARSER_AN_OVERLAY;
      end;
      return ADAM_MSG_PARSER_A_RECORD;
    end;

    // An object's member at the cursor (DoMemberHead): false when none starts here. Its
    // node under AOwner (Member) carries the words' flags; outside an object
    // (AInObject false) it is PR0034 at its first word and flagged Recovered. A word an
    // init / copy / done does not take is PR0058, one a field or an embed does not take
    // PR0034 (both kept)
    hidden method DoObjectMember(const AOwner: int64; const AInObject: bool;
      const AOverlay: bool): bool;
    var
      LKind: NodeKind;
      LWords: int64;
      LNode: int64;
      LFlags: NodeFlags;
      LHead: string;
      LAllowed: NodeFlags;
      LCode: string;
    begin
      LKind := self.DoMemberHead(LWords);
      if LKind = NodeKind.None then
        return false;
      end;
      LFlags := [];
      if LKind = NodeKind.MethodDecl then
        LHead := "method";
      else
        LHead := self.DoWordAt(LWords);
      end;
      if not AInObject then
        if LKind = NodeKind.FieldDecl then
          LHead := self.DoToken().Text;
        end;
        self.DoReport(ADAM_ERR_PARSER_034, self.DoToken().Place, ADAM_MSG_PARSER_NOT_A_MEMBER,
          NoArgs().Str(LHead).Str(self.DoAggregatePhrase(AOverlay)));
        LFlags += [NodeFlag.Recovered];
      end;

      // A field after its words: the words go on the field DoField builds
      if LKind = NodeKind.FieldDecl then
        self.DoTakeWords(LWords, "a field", [NodeFlag.Hidden], ADAM_ERR_PARSER_034, LFlags);
        self.DoField(AOwner);
        LNode := self.FState.Ast.NthOf(AOwner, NodeRole.Member,
          self.FState.Ast.CountOf(AOwner, NodeRole.Member) - 1);
        self.FState.Ast[LNode].Flags := self.FState.Ast[LNode].Flags + LFlags;
        return true;
      end;

      LNode := self.DoAddAt(AOwner, NodeRole.Member, LKind);
      LCode := ADAM_ERR_PARSER_034;
      LAllowed := [NodeFlag.Hidden, NodeFlag.Virtual, NodeFlag.Override, NodeFlag.Final,
        NodeFlag.ConstMethod];
      if LKind = NodeKind.PropertyDecl then
        LAllowed := [NodeFlag.Hidden, NodeFlag.Virtual, NodeFlag.Override, NodeFlag.Final];
      end;
      if LKind = NodeKind.EmbedDecl then
        LAllowed := [NodeFlag.Hidden];
      end;
      if (LKind = NodeKind.InitDecl) or (LKind = NodeKind.CopyDecl) or
        (LKind = NodeKind.DoneDecl) then
        LAllowed := [];
        LCode := ADAM_ERR_PARSER_058;
      end;
      self.DoTakeWords(LWords, LHead, LAllowed, LCode, LFlags);
      self.FState.Ast[LNode].Flags := self.FState.Ast[LNode].Flags + LFlags;
      if LKind = NodeKind.MethodDecl then
        self.DoMethodRest(LNode, false);
      else
        if LKind = NodeKind.PropertyDecl then
          self.DoPropertyRest(LNode, false);
        else
          if LKind = NodeKind.EmbedDecl then
            self.DoEmbedRest(LNode);
          else
            self.DoLifeRest(LNode, LHead);
          end;
        end;
      end;
      self.DoEnd(LNode);
      return true;
    end;

    // A method after its words ('method' at the cursor) into ANode: Text its name, its
    // parameters, ReturnType, ';', then its tail (DoMethodTail)
    hidden method DoMethodRest(const ANode: int64; const AInterface: bool);
    var
      LReturn: int64;
    begin
      self.DoAdvance();
      if self.DoKind() = TokenKind.Identifier then
        self.FState.Ast[ANode].Text := self.DoToken().Text;
        self.DoAdvance();
      else
        self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
      end;
      if self.DoKind() = TokenKind.LParen then
        self.DoParamList(ANode);
      end;
      if self.DoKind() = TokenKind.Colon then
        self.DoAdvance();
        LReturn := self.DoTypeExpr();
        self.DoPut(ANode, NodeRole.ReturnType, LReturn);
      end;
      self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
      self.DoMethodTail(ANode, AInterface);
    end;

    // What follows a method's heading: 'abstract' ';' (flag Abstract), or its body
    // (DoMethodBody). In an interface (AInterface) nothing follows; a body or 'abstract'
    // there is PR0060, still parsed
    hidden method DoMethodTail(const ANode: int64; const AInterface: bool);
    var
      LKind: TokenKind;
    begin
      if (self.DoWordAt(0) = "abstract") and (self.DoKindAt(1) = TokenKind.Semicolon) then
        if AInterface then
          self.DoReport(ADAM_ERR_PARSER_060, self.DoToken().Place, ADAM_MSG_PARSER_INTERFACE_BODY,
            NoArgs());
        end;
        self.FState.Ast[ANode].AddFlag(NodeFlag.Abstract);
        self.DoAdvance();
        self.DoAdvance();
        return;
      end;
      if AInterface then
        LKind := self.DoKind();
        if (LKind <> TokenKind.KwVar) and (LKind <> TokenKind.KwConst) and
          (LKind <> TokenKind.KwType) and (LKind <> TokenKind.KwBegin) then
          return;
        end;
        // 'const method' is the next member's heading, not a const block
        if (LKind = TokenKind.KwConst) and (self.DoKindAt(1) = TokenKind.KwMethod) then
          return;
        end;
        self.DoReport(ADAM_ERR_PARSER_060, self.DoToken().Place, ADAM_MSG_PARSER_INTERFACE_BODY,
          NoArgs());
      end;
      self.DoMethodBody(ANode);
    end;

    // A method's (an accessor's, an init's, an operator's) var blocks (each decl role
    // Local under ANode) and its body (Body) ';'. A const or type block there is PR0025,
    // still parsed as the body's own. No 'begin' is PR0001, the member skipped to its ';'
    hidden method DoMethodBody(const ANode: int64);
    begin
      while true do
        if self.DoKind() = TokenKind.KwVar then
          self.DoVarBlock(ANode, NodeRole.Local, false);
        else
          if (self.DoKind() = TokenKind.KwConst) or (self.DoKind() = TokenKind.KwType) then
            self.DoReport(ADAM_ERR_PARSER_025, self.DoToken().Place, ADAM_MSG_PARSER_METHOD_LOCALS,
              NoArgs().Str(self.DoFound()));
            if self.DoKind() = TokenKind.KwConst then
              self.DoConstBlock(ANode, NodeRole.Local, false);
            else
              self.DoTypeBlock(ANode, NodeRole.Local, false);
            end;
          else
            leave;
          end;
        end;
      end;
      if self.DoKind() = TokenKind.KwBegin then
        self.DoBlock(ANode, NodeRole.Body, true);
        if not self.FUnclosed then
          self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
        end;
      else
        self.DoExpected(DoQuoted("begin"));
        if (self.DoKind() <> TokenKind.KwEnd) and (self.DoKind() <> TokenKind.EndOfFile) then
          self.DoSkipMember(ANode);
        end;
      end;
    end;

    // A property after its words ('property' at the cursor) into ANode: Text its name,
    // its index ([...]: Param), TypeOf, its read accessor (Read; none is PR0061), its
    // write accessor ('hidden write': flag Hidden on it), 'default' ';' (flag
    // DefaultProperty). AInterface: accessors are 'read;' / 'write;'
    hidden method DoPropertyRest(const ANode: int64; const AInterface: bool);
    var
      LHidden: bool;
    begin
      self.DoAdvance();
      if self.DoKind() = TokenKind.Identifier then
        self.FState.Ast[ANode].Text := self.DoToken().Text;
        self.DoAdvance();
      else
        self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
      end;
      if self.DoKind() = TokenKind.LBracket then
        self.DoPropertyIndex(ANode);
      end;
      if not self.DoTypeOf(ANode) then
        return;
      end;
      if self.DoWordAt(0) = "read" then
        self.DoAccessor(ANode, NodeKind.PropertyRead, NodeRole.Read, AInterface, false);
      else
        self.DoReport(ADAM_ERR_PARSER_061, self.DoToken().Place, ADAM_MSG_PARSER_PROPERTY_NO_READ,
          NoArgs());
        if self.DoKind() = TokenKind.Semicolon then
          self.DoAdvance();
        end;
      end;
      LHidden := (self.DoWordAt(0) = "hidden") and (self.DoWordAt(1) = "write");
      if LHidden then
        self.DoAdvance();
      end;
      if self.DoWordAt(0) = "write" then
        self.DoAccessor(ANode, NodeKind.PropertyWrite, NodeRole.Write, AInterface, LHidden);
      end;
      if self.DoKind() = TokenKind.KwDefault then
        self.FState.Ast[ANode].AddFlag(NodeFlag.DefaultProperty);
        self.DoAdvance();
        self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
      end;
    end;

    // A property's index ('[' at the cursor): a Param under ANode (flag ConstParam; a
    // 'var' index is PR0061, flagged VarParam), its name, ':' and type, then ']'
    hidden method DoPropertyIndex(const ANode: int64);
    var
      LOpen: SourcePlace;
      LParam: int64;
      LType: int64;
    begin
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      LParam := self.DoAddAt(ANode, NodeRole.Param, NodeKind.Param);
      if self.DoKind() = TokenKind.KwConst then
        self.FState.Ast[LParam].AddFlag(NodeFlag.ConstParam);
        self.DoAdvance();
      else
        if self.DoKind() = TokenKind.KwVar then
          self.DoReport(ADAM_ERR_PARSER_061, self.DoToken().Place,
            ADAM_MSG_PARSER_PROPERTY_VAR_INDEX, NoArgs());
          self.FState.Ast[LParam].AddFlag(NodeFlag.VarParam);
          self.DoAdvance();
        end;
      end;
      if self.DoKind() = TokenKind.Identifier then
        self.FState.Ast[LParam].Text := self.DoToken().Text;
        self.DoAdvance();
      else
        self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
      end;
      if self.DoKind() = TokenKind.Colon then
        self.DoAdvance();
        LType := self.DoTypeExpr();
        self.DoPut(LParam, NodeRole.TypeOf, LType);
      else
        self.DoExpected(DoQuoted(":"));
      end;
      self.DoEnd(LParam);
      self.DoClose(TokenKind.RBracket, LOpen, "[", ANode, NodeRole.Param, false);
    end;

    // A property accessor ('read' / 'write' at the cursor): a node of AKind under AProp
    // playing ARole (flag Hidden for 'hidden write'). Its shapes: a field (Text) ';',
    // 'abstract' ';' (flag Abstract), a read's body (DoMethodBody), a write's '(' Name ')'
    // (a Param) and body. In an interface the accessor is the word and ';'; anything after
    // it there is PR0060, still parsed. Any other shape is PR0061, skipped to its ';'
    hidden method DoAccessor(const AProp: int64; const AKind: NodeKind; const ARole: NodeRole;
      const AInterface: bool; const AHidden: bool);
    var
      LNode: int64;
      LOpen: SourcePlace;
      LParam: int64;
    begin
      LNode := self.DoAddAt(AProp, ARole, AKind);
      if AHidden then
        self.FState.Ast[LNode].AddFlag(NodeFlag.Hidden);
      end;
      self.DoAdvance();
      if self.DoKind() = TokenKind.Semicolon then
        if not AInterface then
          self.DoReport(ADAM_ERR_PARSER_061, self.DoToken().Place,
            ADAM_MSG_PARSER_PROPERTY_ACCESSOR, NoArgs().Str(self.DoFound()));
        end;
        self.DoAdvance();
        self.DoEnd(LNode);
        return;
      end;
      if AInterface then
        self.DoReport(ADAM_ERR_PARSER_060, self.DoToken().Place, ADAM_MSG_PARSER_INTERFACE_BODY,
          NoArgs());
      end;
      if (self.DoWordAt(0) = "abstract") and (self.DoKindAt(1) = TokenKind.Semicolon) then
        self.FState.Ast[LNode].AddFlag(NodeFlag.Abstract);
        self.DoAdvance();
        self.DoAdvance();
      else
        if (self.DoKind() = TokenKind.Identifier) and (self.DoKindAt(1) = TokenKind.Semicolon) then
          self.FState.Ast[LNode].Text := self.DoToken().Text;
          self.DoAdvance();
          self.DoAdvance();
        else
          if (AKind = NodeKind.PropertyRead) and
            ((self.DoKind() = TokenKind.KwVar) or (self.DoKind() = TokenKind.KwBegin)) then
            self.DoMethodBody(LNode);
          else
            if (AKind = NodeKind.PropertyWrite) and (self.DoKind() = TokenKind.LParen) then
              LOpen := self.DoToken().Place;
              self.DoAdvance();
              if self.DoKind() = TokenKind.Identifier then
                LParam := self.DoAddAt(LNode, NodeRole.Param, NodeKind.Param);
                self.FState.Ast[LParam].Text := self.DoToken().Text;
                self.DoAdvance();
                self.DoEnd(LParam);
              else
                self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
              end;
              self.DoClose(TokenKind.RParen, LOpen, "(", LNode, NodeRole.Param, false);
              self.DoMethodBody(LNode);
            else
              self.DoReport(ADAM_ERR_PARSER_061, self.DoToken().Place,
                ADAM_MSG_PARSER_PROPERTY_ACCESSOR, NoArgs().Str(self.DoFound()));
              if (self.DoKind() <> TokenKind.KwEnd) and (self.DoKind() <> TokenKind.EndOfFile) then
                self.DoSkipMember(LNode);
              end;
            end;
          end;
        end;
      end;
      self.DoEnd(LNode);
    end;

    // An embed after its words ('embed' at the cursor) into ANode: Text, TypeOf, ';'
    hidden method DoEmbedRest(const ANode: int64);
    begin
      self.DoAdvance();
      if self.DoKind() = TokenKind.Identifier then
        self.FState.Ast[ANode].Text := self.DoToken().Text;
        self.DoAdvance();
      else
        self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
      end;
      if self.DoTypeOf(ANode) then
        self.DoMemberSemicolon(ANode);
      end;
    end;

    // An init / copy / done (its word AWord at the cursor) into ANode: an init's or a
    // copy's parameter list ('...' PR0059), a done's none (a list PR0059); a result type
    // is PR0059 on each (kept as ReturnType); ';' and the body (DoMethodBody)
    hidden method DoLifeRest(const ANode: int64; const AWord: string);
    var
      LDone: bool;
      LReturn: int64;
    begin
      LDone := self.FState.Ast[ANode].Kind = NodeKind.DoneDecl;
      self.DoAdvance();
      if self.DoKind() = TokenKind.LParen then
        if LDone then
          self.DoReport(ADAM_ERR_PARSER_059, self.DoToken().Place, ADAM_MSG_PARSER_NO_PART,
            NoArgs().Str(AWord).Str(ADAM_MSG_PARSER_PARAMETERS));
        end;
        self.DoParamList(ANode);
      else
        if not LDone then
          self.DoExpected(DoQuoted("("));
        end;
      end;
      if self.FState.Ast[ANode].HasFlag(NodeFlag.Variadic) then
        self.DoReport(ADAM_ERR_PARSER_059, self.FState.Ast[ANode].Place, ADAM_MSG_PARSER_NO_PART,
          NoArgs().Str(AWord).Str(DoQuoted("...")));
      end;
      if self.DoKind() = TokenKind.Colon then
        self.DoReport(ADAM_ERR_PARSER_059, self.DoToken().Place, ADAM_MSG_PARSER_NO_PART,
          NoArgs().Str(AWord).Str(ADAM_MSG_PARSER_A_RESULT_TYPE));
        self.DoAdvance();
        LReturn := self.DoTypeExpr();
        self.DoPut(ANode, NodeRole.ReturnType, LReturn);
      end;
      self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
      self.DoMethodBody(ANode);
    end;

    // An operator decl ('operator' at the cursor) under AOwner (Member): OperatorDecl, Text
    // its symbol's spelling, Op its meaning (DoOperatorSymbol; another symbol is PR0062),
    // its operands (DoParamList; '...' PR0062), ReturnType, ';', body. In an overlay it is
    // PR0034 (flag Recovered), still parsed
    hidden method DoOperatorDecl(const AOwner: int64; const AInObject: bool; const AOverlay: bool);
    var
      LNode: int64;
      LOp: OperatorKind;
      LReturn: int64;
    begin
      LNode := self.DoAddAt(AOwner, NodeRole.Member, NodeKind.OperatorDecl);
      if (not AInObject) and AOverlay then
        self.DoReport(ADAM_ERR_PARSER_034, self.DoToken().Place, ADAM_MSG_PARSER_NOT_A_MEMBER,
          NoArgs().Str("operator").Str(ADAM_MSG_PARSER_AN_OVERLAY));
        self.FState.Ast[LNode].AddFlag(NodeFlag.Recovered);
      end;
      self.DoAdvance();
      LOp := DoOperatorSymbol(self.DoKind());
      if LOp = OperatorKind.None then
        self.DoReport(ADAM_ERR_PARSER_062, self.DoToken().Place, ADAM_MSG_PARSER_OPERATOR_SYMBOL,
          NoArgs().Str(self.DoFound()));
        if (self.DoKind() <> TokenKind.LParen) and (self.DoKind() <> TokenKind.EndOfFile) then
          self.DoAdvance();
        end;
      else
        self.FState.Ast[LNode].Text := self.DoToken().Text;
        self.FState.Ast[LNode].Op := LOp;
        self.DoAdvance();
      end;
      if self.DoKind() = TokenKind.LParen then
        self.DoParamList(LNode);
      else
        self.DoExpected(DoQuoted("("));
      end;
      if self.FState.Ast[LNode].HasFlag(NodeFlag.Variadic) then
        self.DoReport(ADAM_ERR_PARSER_062, self.FState.Ast[LNode].Place,
          ADAM_MSG_PARSER_OPERATOR_VARIADIC, NoArgs());
      end;
      if self.DoKind() = TokenKind.Colon then
        self.DoAdvance();
        LReturn := self.DoTypeExpr();
        self.DoPut(LNode, NodeRole.ReturnType, LReturn);
      else
        self.DoExpected(DoQuoted(":"));
      end;
      self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
      self.DoMethodBody(LNode);
      self.DoEnd(LNode);
    end;

    // A parent in '(' ')' after an object's or an interface's word (cursor at the '('):
    // a NamedType under ANode (role Parent)
    hidden method DoParentType(const ANode: int64);
    var
      LOpen: SourcePlace;
      LParent: int64;
    begin
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      if self.DoKind() = TokenKind.Identifier then
        LParent := self.DoNamedType();
        self.DoPut(ANode, NodeRole.Parent, LParent);
      else
        self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
      end;
      self.DoClose(TokenKind.RParen, LOpen, "(", ANode, NodeRole.Parent, false);
    end;

    // An object type ('object' at the cursor, or 'final' 'object' with AFinal: flag
    // Final): ObjectType ([Parent], Implements* after the context word 'implements',
    // Member*), up to its 'end'. 'packed' / 'align' on it are PR0033
    hidden method DoObjectType(const AFinal: bool): int64;
    var
      LNode: int64;
      LOpen: SourcePlace;
      LType: int64;
    begin
      LNode := self.DoNew(NodeKind.ObjectType);
      if AFinal then
        self.FState.Ast[LNode].AddFlag(NodeFlag.Final);
        self.DoAdvance();
      end;
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      if self.DoKind() = TokenKind.LParen then
        self.DoParentType(LNode);
      end;
      if (self.DoWordAt(0) = "implements") and (self.DoKindAt(1) = TokenKind.Identifier) then
        self.DoAdvance();
        while true do
          LType := self.DoNamedType();
          self.DoPut(LNode, NodeRole.Implements, LType);
          if (self.DoKind() <> TokenKind.Comma) or (self.DoKindAt(1) <> TokenKind.Identifier) then
            leave;
          end;
          self.DoAdvance();
        end;
      end;
      self.DoNoPrefixWords(LNode, ADAM_MSG_PARSER_NOT_ON_OBJECT);
      while (self.DoKind() <> TokenKind.KwEnd) and (self.DoKind() <> TokenKind.EndOfFile) do
        self.DoAggregateMember(LNode, true, false);
        if self.FUnclosed then
          leave;
        end;
      end;
      self.DoAggregateEnd(LNode, LOpen, "object");
      return LNode;
    end;

    // An interface type ('interface' at the cursor): InterfaceType ([Parent], Member*:
    // '[const] method' headings and properties), up to its 'end'
    hidden method DoInterfaceType(): int64;
    var
      LNode: int64;
      LOpen: SourcePlace;
    begin
      LNode := self.DoNew(NodeKind.InterfaceType);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      if self.DoKind() = TokenKind.LParen then
        self.DoParentType(LNode);
      end;
      while (self.DoKind() <> TokenKind.KwEnd) and (self.DoKind() <> TokenKind.EndOfFile) do
        self.DoInterfaceMember(LNode);
        if self.FUnclosed then
          leave;
        end;
      end;
      self.DoAggregateEnd(LNode, LOpen, "interface");
      return LNode;
    end;

    // One member of an interface at the cursor under AOwner: a '[const] method' heading or
    // a property. Any other member (a word before them, a field, an embed, an init /
    // copy / done, an operator) is PR0034 at its first token and parsed as an object's;
    // anything else PR0001, skipped to its ';'
    hidden method DoInterfaceMember(const AOwner: int64);
    var
      LNode: int64;
      LWords: int64;
    begin
      if (self.DoKind() = TokenKind.KwMethod) or
        ((self.DoKind() = TokenKind.KwConst) and (self.DoKindAt(1) = TokenKind.KwMethod)) then
        LNode := self.DoAddAt(AOwner, NodeRole.Member, NodeKind.MethodDecl);
        if self.DoKind() = TokenKind.KwConst then
          self.FState.Ast[LNode].AddFlag(NodeFlag.ConstMethod);
          self.DoAdvance();
        end;
        self.DoMethodRest(LNode, true);
        self.DoEnd(LNode);
        return;
      end;
      if (self.DoWordAt(0) = "property") and (self.DoKindAt(1) <> TokenKind.Colon) then
        LNode := self.DoAddAt(AOwner, NodeRole.Member, NodeKind.PropertyDecl);
        self.DoPropertyRest(LNode, true);
        self.DoEnd(LNode);
        return;
      end;
      if (self.DoMemberHead(LWords) <> NodeKind.None) or
        (self.DoKind() = TokenKind.KwOperator) or
        ((self.DoKind() = TokenKind.Identifier) and (self.DoKindAt(1) = TokenKind.Colon)) then
        self.DoReport(ADAM_ERR_PARSER_034, self.DoToken().Place, ADAM_MSG_PARSER_NOT_A_MEMBER,
          NoArgs().Str(self.DoToken().Text).Str(ADAM_MSG_PARSER_AN_INTERFACE));
        self.DoAggregateMember(AOwner, true, false);
        return;
      end;
      self.DoExpected(ADAM_MSG_PARSER_A_MEMBER);
      self.DoSkipMember(AOwner);
    end;

    // Skips a member that is not one (the token at the cursor at least) up to its ';'
    // (moved past), an 'end' or the end of the file: one Error node under AOwner (Member)
    hidden method DoSkipMember(const AOwner: int64);
    var
      LError: int64;
    begin
      LError := self.DoAddAt(AOwner, NodeRole.Member, NodeKind.Error);
      self.DoAdvance();
      while (self.DoKind() <> TokenKind.Semicolon) and (self.DoKind() <> TokenKind.KwEnd) and
        (self.DoKind() <> TokenKind.EndOfFile) do
        self.DoAdvance();
      end;
      if self.DoKind() = TokenKind.Semicolon then
        self.DoAdvance();
      end;
      self.DoEnd(LError);
    end;

    // A field (its name at the cursor): FieldDecl under AOwner (Member; Text, TypeOf, a
    // bitfield width after a second ':' as BitWidth), then ';'
    hidden method DoField(const AOwner: int64);
    var
      LField: int64;
      LWidth: int64;
    begin
      LField := self.DoAddAt(AOwner, NodeRole.Member, NodeKind.FieldDecl);
      self.FState.Ast[LField].Text := self.DoToken().Text;
      self.DoAdvance();
      if self.DoTypeOf(LField) then
        if self.DoKind() = TokenKind.Colon then
          self.DoAdvance();
          LWidth := self.DoExpression();
          self.DoPut(LField, NodeRole.BitWidth, LWidth);
        end;
        self.DoMemberSemicolon(LField);
      end;
      self.DoEnd(LField);
    end;

    // The ';' after a member: moved past; missing, PR0001 and the member's tokens up to its
    // ';' / 'end' skipped (an Error node under ANode, role Member)
    hidden method DoMemberSemicolon(const ANode: int64);
    begin
      if self.DoKind() = TokenKind.Semicolon then
        self.DoAdvance();
      else
        self.DoExpected(DoQuoted(";"));
        if (self.DoKind() <> TokenKind.KwEnd) and (self.DoKind() <> TokenKind.EndOfFile) then
          self.DoSkipMember(ANode);
        end;
      end;
    end;

    // An anonymous record (AKind AnonRecord, in an overlay; 'packed' allowed) or overlay
    // (AnonOverlay, in a record; 'packed' / 'align' PR0033) at the cursor, under AOwner
    // (Member), up to its 'end' ';'. Each one nested is one level (DoEnter)
    hidden method DoAnonAggregate(const AOwner: int64; const AKind: NodeKind);
    var
      LNode: int64;
      LOpen: SourcePlace;
      LDeep: int64;
    begin
      if not self.DoEnter() then
        LDeep := self.DoTooDeep();
        self.DoPut(AOwner, NodeRole.Member, LDeep);
        return;
      end;
      LNode := self.DoAddAt(AOwner, NodeRole.Member, AKind);
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      if AKind = NodeKind.AnonRecord then
        if self.DoKind() = TokenKind.KwPacked then
          self.FState.Ast[LNode].AddFlag(NodeFlag.Packed);
          self.DoAdvance();
        end;
        self.DoMembers(LNode, false);
        self.DoAggregateEnd(LNode, LOpen, "record");
      else
        self.DoNoPrefixWords(LNode, ADAM_MSG_PARSER_NOT_ON_OVERLAY);
        self.DoMembers(LNode, true);
        self.DoAggregateEnd(LNode, LOpen, "overlay");
      end;
      if not self.FUnclosed then
        self.DoMemberSemicolon(LNode);
      end;
      self.DoEnd(LNode);
      self.DoLeave();
    end;

    // A choices type ('choices' at the cursor): ChoicesType with a ChoiceValue per value
    // (Member; Text, [Value] after '='), ',' between them, in '(' ')'; none is PR0035
    hidden method DoChoicesType(): int64;
    var
      LNode: int64;
      LOpen: SourcePlace;
      LValue: int64;
      LExpr: int64;
    begin
      LNode := self.DoNew(NodeKind.ChoicesType);
      self.DoAdvance();
      if self.DoKind() <> TokenKind.LParen then
        self.DoExpected(DoQuoted("("));
        self.DoEnd(LNode);
        return LNode;
      end;
      LOpen := self.DoToken().Place;
      self.DoAdvance();
      if self.DoKind() = TokenKind.RParen then
        self.DoReport(ADAM_ERR_PARSER_035, self.DoToken().Place, ADAM_MSG_PARSER_EMPTY_CHOICES,
          NoArgs());
        self.DoAdvance();
        self.DoEnd(LNode);
        return LNode;
      end;
      while true do
        if self.DoKind() <> TokenKind.Identifier then
          self.DoExpected(ADAM_MSG_PARSER_A_CHOICE_VALUE);
          self.DoClose(TokenKind.RParen, LOpen, "(", LNode, NodeRole.Member, true);
          self.DoEnd(LNode);
          return LNode;
        end;
        LValue := self.DoAddAt(LNode, NodeRole.Member, NodeKind.ChoiceValue);
        self.FState.Ast[LValue].Text := self.DoToken().Text;
        self.DoAdvance();
        if self.DoKind() = TokenKind.Equal then
          self.DoAdvance();
          LExpr := self.DoExpression();
          self.DoPut(LValue, NodeRole.Value, LExpr);
        end;
        self.DoEnd(LValue);
        if self.DoKind() <> TokenKind.Comma then
          leave;
        end;
        self.DoAdvance();
      end;
      self.DoClose(TokenKind.RParen, LOpen, "(", LNode, NodeRole.Member, false);
      self.DoEnd(LNode);
      return LNode;
    end;

    // A set type ('set' at the cursor): SetType with a range (LowBound HighBound) when a
    // '..' stands in it, else its element type (Element). 'set' without 'of' is PR0053
    hidden method DoSetType(): int64;
    var
      LNode: int64;
      LPart: int64;
    begin
      LNode := self.DoNew(NodeKind.SetType);
      if self.DoKindAt(1) <> TokenKind.KwOf then
        self.DoReport(ADAM_ERR_PARSER_053, self.DoToken().Place, ADAM_MSG_PARSER_BARE_SET, NoArgs());
        self.DoAdvance();
        self.DoEnd(LNode);
        return LNode;
      end;
      self.DoAdvance();
      self.DoAdvance();
      if self.DoIsRange() then
        LPart := self.DoExpression();
        self.DoPut(LNode, NodeRole.LowBound, LPart);
        self.DoRequire(TokenKind.DotDot, DoQuoted(".."));
        LPart := self.DoExpression();
        self.DoPut(LNode, NodeRole.HighBound, LPart);
      else
        LPart := self.DoTypeExpr();
        self.DoPut(LNode, NodeRole.Element, LPart);
      end;
      self.DoEnd(LNode);
      return LNode;
    end;

    // True when a '..' stands outside brackets between the cursor and the ';' (or the end
    // of the file) that ends the declaration: a set's range, not its element type
    hidden const method DoIsRange(): bool;
    var
      LAt: int64;
      LDepth: int64;
      LKind: TokenKind;
    begin
      LAt := 0;
      LDepth := 0;
      while true do
        LKind := self.DoKindAt(LAt);
        if LKind = TokenKind.EndOfFile then
          return false;
        end;
        if (LKind = TokenKind.LParen) or (LKind = TokenKind.LBracket) then
          LDepth := LDepth + 1;
        else
          if (LKind = TokenKind.RParen) or (LKind = TokenKind.RBracket) then
            LDepth := LDepth - 1;
          else
            if LDepth = 0 then
              if LKind = TokenKind.Semicolon then
                return false;
              end;
              if LKind = TokenKind.DotDot then
                return true;
              end;
            end;
          end;
        end;
        LAt := LAt + 1;
      end;
      return false;
    end;

    // A routine's head after 'routine' (cursor past it): flag Clink / Cpplink, Text its
    // name, its parameters (DoParamList), ReturnType, then ';'
    hidden method DoRoutineHead(const ANode: int64);
    var
      LReturn: int64;
    begin
      if self.DoKind() = TokenKind.KwClink then
        self.FState.Ast[ANode].AddFlag(NodeFlag.Clink);
        self.DoAdvance();
      else
        if self.DoKind() = TokenKind.KwCpplink then
          self.FState.Ast[ANode].AddFlag(NodeFlag.Cpplink);
          self.DoAdvance();
        end;
      end;
      if self.DoKind() = TokenKind.Identifier then
        self.FState.Ast[ANode].Text := self.DoToken().Text;
        self.DoAdvance();
      else
        self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
      end;
      if self.DoKind() = TokenKind.LParen then
        self.DoParamList(ANode);
      end;
      if self.DoKind() = TokenKind.Colon then
        self.DoAdvance();
        LReturn := self.DoTypeExpr();
        self.DoPut(ANode, NodeRole.ReturnType, LReturn);
      end;
      self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
    end;

    // A routine decl ('routine' at the cursor): RoutineDecl under AParent playing ARole,
    // its head, then an ExternalClause or its local blocks (Local) and its body (Body) ';'
    hidden method DoRoutineDecl(const AParent: int64; const ARole: NodeRole;
      const APublic: bool);
    var
      LNode: int64;
    begin
      LNode := self.DoAddAt(AParent, ARole, NodeKind.RoutineDecl);
      self.DoMark(LNode, APublic);
      self.DoAdvance();
      self.DoRoutineHead(LNode);
      if self.DoKind() = TokenKind.KwExternal then
        self.DoExternal(LNode);
      else
        self.DoLocals(LNode);
        if self.DoKind() = TokenKind.KwBegin then
          self.DoBlock(LNode, NodeRole.Body, true);
          if not self.FUnclosed then
            self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
          end;
        else
          self.DoExpected(DoQuoted("begin"));
          self.DoSkip(LNode, NodeRole.Body, true, false);
        end;
      end;
      self.DoEnd(LNode);
    end;

    // A routine body's own var / const / type blocks (each decl role Local under AOwner).
    // 'public' before one is PR0057 at the word; the block stays the body's
    // own; a 'threadstatic' block is PR0057 at the word and its decls the body's own vars
    hidden method DoLocals(const AOwner: int64);
    begin
      while true do
        if IsPublicWord(self.DoKind()) then
          self.DoReport(ADAM_ERR_PARSER_057, self.DoToken().Place, ADAM_MSG_PARSER_PUBLIC_LOCAL,
            NoArgs().Str(KindText(self.DoKind())));
          self.DoAdvance();
        else
          if self.DoKind() = TokenKind.KwThreadstatic then
            self.DoReport(ADAM_ERR_PARSER_057, self.DoToken().Place, ADAM_MSG_PARSER_PUBLIC_LOCAL,
              NoArgs().Str(KindText(self.DoKind())));
            self.DoVarBlock(AOwner, NodeRole.Local, false);
            skip;
          end;
          if self.DoKind() = TokenKind.KwVar then
            self.DoVarBlock(AOwner, NodeRole.Local, false);
          else
            if self.DoKind() = TokenKind.KwConst then
              self.DoConstBlock(AOwner, NodeRole.Local, false);
            else
              if self.DoKind() = TokenKind.KwType then
                self.DoTypeBlock(AOwner, NodeRole.Local, false);
              else
                leave;
              end;
            end;
          end;
        end;
      end;
    end;

    // A forward decl ('forward' at the cursor): ForwardType (Text) for 'forward type', else
    // ForwardRoutine (a routine's head, no body), under AParent playing ARole
    hidden method DoForward(const AParent: int64; const ARole: NodeRole; const APublic: bool);
    var
      LNode: int64;
    begin
      if self.DoKindAt(1) = TokenKind.KwType then
        LNode := self.DoAddAt(AParent, ARole, NodeKind.ForwardType);
        self.DoMark(LNode, APublic);
        self.DoAdvance();
        self.DoAdvance();
        if self.DoKind() = TokenKind.Identifier then
          self.FState.Ast[LNode].Text := self.DoToken().Text;
          self.DoAdvance();
        else
          self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
        end;
        self.DoRequire(TokenKind.Semicolon, DoQuoted(";"));
      else
        LNode := self.DoAddAt(AParent, ARole, NodeKind.ForwardRoutine);
        self.DoMark(LNode, APublic);
        self.DoAdvance();
        if self.DoKind() = TokenKind.KwRoutine then
          self.DoAdvance();
          self.DoRoutineHead(LNode);
        else
          self.DoExpected(DoQuoted("routine"));
          self.DoSkip(LNode, NodeRole.Param, true, false);
        end;
      end;
      self.DoEnd(LNode);
    end;

    // One declaration at the cursor (with a 'public' before it) under AParent
    // playing ARole: true when one was there (the word alone counts: PR0001 a declaration)
    hidden method DoDeclaration(const AParent: int64; const ARole: NodeRole): bool;
    var
      LPublic: bool;
    begin
      LPublic := false;
      if IsPublicWord(self.DoKind()) then
        LPublic := true;
        self.DoAdvance();
      end;
      if self.DoKind() = TokenKind.KwVar then
        self.DoVarBlock(AParent, ARole, LPublic);
        return true;
      end;
      if self.DoKind() = TokenKind.KwThreadstatic then
        self.DoThreadStaticBlock(AParent, ARole, LPublic);
        return true;
      end;
      if self.DoKind() = TokenKind.KwConst then
        self.DoConstBlock(AParent, ARole, LPublic);
        return true;
      end;
      if self.DoKind() = TokenKind.KwType then
        self.DoTypeBlock(AParent, ARole, LPublic);
        return true;
      end;
      if self.DoKind() = TokenKind.KwRoutine then
        self.DoRoutineDecl(AParent, ARole, LPublic);
        return true;
      end;
      if self.DoKind() = TokenKind.KwForward then
        self.DoForward(AParent, ARole, LPublic);
        return true;
      end;
      if LPublic then
        self.DoExpected(ADAM_MSG_PARSER_A_DECLARATION);
        return true;
      end;
      return false;
    end;

    // The module's declarations (after its import clause), up to initialize / finalize /
    // begin / end / the end of the file. A misplaced import / directive / test reports
    // between them (DoMisplaced); anything else is PR0001 (a declaration), skipped to the
    // next part of the module as an Error node (role Declaration)
    hidden method DoDeclarations();
    var
      LKind: TokenKind;
    begin
      while not self.FUnclosed do
        self.DoMisplaced();
        if not self.DoDeclaration(self.FModule, NodeRole.Declaration) then
          LKind := self.DoKind();
          if (LKind = TokenKind.KwInitialize) or (LKind = TokenKind.KwFinalize) or
            (LKind = TokenKind.KwBegin) or (LKind = TokenKind.KwEnd) or
            (LKind = TokenKind.EndOfFile) then
            return;
          end;
          self.DoExpected(ADAM_MSG_PARSER_A_DECLARATION);
          self.DoSkip(self.FModule, NodeRole.Declaration, true, true);
        end;
      end;
    end;

    // Parses all of the file's tokens as one expression (AType false) or one type
    // expression (AType true): its id, a node with no parent. A token after it is PR0001
    // and the rest of the file one Error node under the program
    method ParseFragment(const AType: bool): int64;
    var
      LId: int64;
    begin
      if AType then
        LId := self.DoTypeExpr();
      else
        LId := self.DoExpression();
      end;
      if self.DoKind() <> TokenKind.EndOfFile then
        self.DoExpected(ADAM_MSG_PARSER_END_OF_FILE);
        self.DoSkipAll(ADAM_AST_PROGRAM, NodeRole.Module);
      end;
      return LId;
    end;

    // Parses the file's module: its id; 0 when the file has no module header (all of it
    // is then one Error node under the program)
    method ParseModule(): int64;
    var
      LKindPlace: SourcePlace;
      LNamePlace: SourcePlace;
      LName: string;
    begin
      if self.DoKind() <> TokenKind.KwModule then
        self.DoExpected(DoQuoted("module"));
        self.DoSkipAll(ADAM_AST_PROGRAM, NodeRole.Module);
        return 0;
      end;
      self.FModule := self.DoAddAt(ADAM_AST_PROGRAM, NodeRole.Module, NodeKind.Module);
      self.DoAdvance();

      // The kind; a word in its place (a misspelt kind) is passed over when the name
      // follows it
      LKindPlace := self.DoToken().Place;
      self.FKind := DoModuleKindOf(self.DoKind());
      if self.FKind = ModuleKind.None then
        self.DoReport(ADAM_ERR_PARSER_002, LKindPlace, ADAM_MSG_PARSER_NO_MODULE_KIND,
          NoArgs().Str(self.DoFound()));
        if (self.DoKind() = TokenKind.Identifier) and (self.DoKindAt(1) = TokenKind.Identifier) then
          self.DoAdvance();
        end;
      else
        self.DoAdvance();
      end;
      self.FState.Ast[self.FModule].Module := self.FKind;

      // The dotted name: the file's own (the main module's file name, an import's name)
      LNamePlace := self.DoToken().Place;
      LName := "";
      if self.DoKind() <> TokenKind.Identifier then
        self.DoExpected(ADAM_MSG_PARSER_AN_IDENTIFIER);
      else
        if self.DoDottedName(LName) and (LName <> self.FName) then
          self.DoReport(ADAM_ERR_PARSER_003, LNamePlace, ADAM_MSG_PARSER_NAME_MISMATCH,
            NoArgs().Str(LName).Str(self.FName));
        end;
      end;
      self.FState.Ast[self.FModule].Text := LName;
      if self.FIsMain and (self.FKind = ModuleKind.Unit) then
        self.DoReport(ADAM_ERR_PARSER_004, LKindPlace, ADAM_MSG_PARSER_UNIT_AS_MAIN,
          NoArgs().Str(LName));
      end;
      if self.DoKind() = TokenKind.Semicolon then
        self.DoAdvance();
      else
        self.DoExpected(DoQuoted(";"));
        self.DoSkip(self.FModule, NodeRole.Declaration, true, false);
      end;

      // The parts in their order: prologue, import clause, declarations, sections. The
      // main module's @addmodulepath folders join the module paths before any import loads
      self.DoPrologue();
      if self.FIsMain then
        self.DoAddModulePaths();
      end;
      if self.DoKind() = TokenKind.KwImport then
        self.DoImportClause();
      end;
      self.DoDeclarations();
      self.DoSections();
      if not self.FUnclosed then
        self.DoBodyAndEnd();
      end;
      self.DoEnd(self.FModule);
      if not self.FUnclosed then
        self.DoTests();
      end;
      return self.FModule;
    end;
  end;

// Lexes the loaded file AIndex and parses its module (AName the name it must have) into
// the program: the module's id (0 when the file has no module header). AName is in the
// chain of importers while it is parsed, and registered once it is
routine DoParseFile(const AState: ref ParseState; const AIndex: int64; const APath: string;
  const AName: string; const AIsMain: bool): int64;
var
  LLexer: ref Lexer;
  LFilter: ref ConditionalFilter;
  LTokens: TokenList;
  LParser: ref FileParser;
  LId: int64;
begin
  // Lexer -> conditional filter (the active tokens; the main module settles the build's
  // target, an import is checked against it) -> parser
  LLexer := ref Lexer(AState.Sources[AIndex], AState.Errors);
  LFilter := ref ConditionalFilter(AState.Errors);
  if AIsMain then
    LTokens := LFilter.Filter(LLexer.ReadAll(), "", AState.OverrideTarget, AState.DefaultTarget,
      AState.Ast.DebugBuild);
    AState.Target := LFilter.Target();
    AState.Ast.SetTriple(AState.Target);
  else
    LTokens := LFilter.Filter(LLexer.ReadAll(), AState.Target, AState.OverrideTarget, "",
      AState.Ast.DebugBuild);
  end;
  LParser := ref FileParser(AState, LTokens, APath, AName, AIsMain);
  AState.Push(AName);
  LId := LParser.ParseModule();
  AState.Pop();
  if LId <> 0 then
    AState.Register(AName, LId);
  end;
  return LId;
end;

// True when ANames holds AName
routine DoHasName(const ANames: StringArray; const AName: string): bool;
var
  LI: int64;
begin
  for LI := 0 to len(ANames) - 1 do
    if ANames[LI] = AName then
      return true;
    end;
  end;
  return false;
end;

// True when the unit AName, its source the file APath, is to come from the loader's
// compiled form: it has a current one and every unit it imports is from a compiled form
// too: in the tree from one already, a member of the group being loaded, or (not loaded
// yet, found from the unit's folder) one that can come from its own. A unit in the tree or
// in the chain from its source never can: its names are not resolved while the parse runs,
// and a compiled form binds to its imports' resolved facts. A unit being decided counts as
// compiled (units that import each other load as one group). A no is kept at once; a yes
// once the outermost unit being decided is a yes (each yes below it rested on that)
routine DoCompilable(const AState: ref ParseState; const AName: string;
  const APath: string): bool;
var
  LImports: StringArray;
  LDir: string;
  LI: int64;
  LId: int64;
  LPath: string;
  LOk: bool;
  LOuter: bool;
begin
  if AState.Decided.Find(AName) <> 0 then
    return AState.Decided.Find(AName) = 1;
  end;
  if DoHasName(AState.Deciding, AName) then
    return true;
  end;
  if not AState.Loader.HasUnit(AName, APath, LImports) then
    AState.Decided.Put(AName, 2);
    return false;
  end;
  LOuter := len(AState.Deciding) = 0;
  setlength(AState.Deciding, len(AState.Deciding) + 1);
  AState.Deciding[len(AState.Deciding) - 1] := AName;
  LDir := ExtractFileDir(APath);
  LOk := true;
  for LI := 0 to len(LImports) - 1 do
    if LOk and (AState.Pending.Find(LImports[LI]) = 0) then
      LId := AState.ParsedId(LImports[LI]);
      if LId <> 0 then
        LOk := AState.Ast[LId].HasFlag(NodeFlag.Compiled);
      else
        if AState.IsLoading(LImports[LI]) then
          LOk := false;
        else
          LPath := AState.Sources.FindUnit(LImports[LI], LDir);
          LOk := (LPath <> "") and DoCompilable(AState, LImports[LI], LPath);
        end;
      end;
    end;
  end;
  setlength(AState.Deciding, len(AState.Deciding) - 1);
  if not LOk then
    AState.Decided.Put(AName, 2);
  else
    setlength(AState.Tentative, len(AState.Tentative) + 1);
    AState.Tentative[len(AState.Tentative) - 1] := AName;
  end;
  if LOuter then
    if LOk then
      for LI := 0 to len(AState.Tentative) - 1 do
        AState.Decided.Put(AState.Tentative[LI], 1);
      end;
    end;
    setlength(AState.Tentative, 0);
  end;
  return LOk;
end;

// The unit AName, its source the file APath, from the loader's compiled form, imported at
// APlace, when DoCompilable says so: its imports loaded first (in the chain of importers),
// each from the unit's folder as its own import clause would load it, a member of the
// group being loaded skipped (units that import each other), then the form appended. The
// loads nested in the outermost one are one group, attached when it ends. Its module; 0
// when its source is to be parsed; -1 after an error was told
routine DoCompiledUnit(const AState: ref ParseState; const AName: string; const APath: string;
  const APlace: SourcePlace): int64;
var
  LImports: StringArray;
  LDir: string;
  LI: int64;
  LLoaded: bool;
  LId: int64;
begin
  if (AState.Loader = nil) or not DoCompilable(AState, AName, APath) then
    return 0;
  end;
  if not AState.Loader.HasUnit(AName, APath, LImports) then
    return 0;
  end;
  AState.Pending.Put(AName, 1);
  AState.GroupDepth := AState.GroupDepth + 1;
  LDir := ExtractFileDir(APath);
  LLoaded := true;
  AState.Push(AName);
  for LI := 0 to len(LImports) - 1 do
    if AState.Pending.Find(LImports[LI]) = 0 then
      if DoParseUnit(AState, LImports[LI], LDir, APlace) = 0 then
        LLoaded := false;
      end;
    end;
  end;
  AState.Pop();
  LId := 0;
  if LLoaded then
    LId := AState.Loader.LoadUnit(AName, APlace);
  end;
  if LId <> 0 then
    AState.Register(AName, LId);
  end;
  AState.GroupDepth := AState.GroupDepth - 1;
  if AState.GroupDepth = 0 then
    if not AState.Loader.FinishUnits() then
      LId := 0;
    end;
    AState.Pending := ref StringIdMap();
  end;
  if LId = 0 then
    return -1;
  end;
  return LId;
end;

// See its forward declaration above: a unit in the chain of importers is a cycle
// (PR0011), a unit parsed already is that module, else its file is found (PR0012), then
// taken from the loader's compiled form when it has a current one (DoCompiledUnit), else
// read (PR0066) and parsed; a module that is no unit is PR0013 at the import
routine DoParseUnit(const AState: ref ParseState; const AName: string;
  const AImporterDir: string; const APlace: SourcePlace): int64;
var
  LId: int64;
  LPath: string;
  LIndex: int64;
  LKind: ModuleKind;
begin
  if AState.IsLoading(AName) then
    AState.Errors.Add(Severity.Error, ADAM_ERR_PARSER_011, APlace, ADAM_MSG_PARSER_IMPORT_CYCLE,
      NoArgs().Str(AName).Str(AState.Cycle(AName)));
    return 0;
  end;
  LId := AState.ParsedId(AName);
  if LId = 0 then
    LPath := AState.Sources.FindUnit(AName, AImporterDir);
    if LPath = "" then
      AState.Errors.Add(Severity.Error, ADAM_ERR_PARSER_012, APlace,
        ADAM_MSG_PARSER_UNIT_NOT_FOUND, NoArgs().Str(AName).Str(AName + ADAM_SOURCE_EXT));
      return 0;
    end;
    LId := DoCompiledUnit(AState, AName, LPath, APlace);
    if LId < 0 then
      return 0;
    end;
    if LId = 0 then
      LIndex := AState.Sources.Load(LPath);
      if LIndex < 0 then
        AState.Errors.Add(Severity.Error, ADAM_ERR_PARSER_066, APlace, ADAM_MSG_PARSER_UNREADABLE,
          NoArgs().Str(LPath));
        return 0;
      end;
      LId := DoParseFile(AState, LIndex, LPath, AName, false);
      if LId = 0 then
        return 0;
      end;
    end;
  end;
  LKind := AState.Ast[LId].Module;
  if (LKind = ModuleKind.Exe) or (LKind = ModuleKind.Dll) or (LKind = ModuleKind.Lib) then
    AState.Errors.Add(Severity.Error, ADAM_ERR_PARSER_013, APlace, ADAM_MSG_PARSER_NOT_A_UNIT,
      NoArgs().Str(AName).Str(DoKindPhrase(LKind)));
  end;
  return LId;
end;

// The unit AName the program needs but nothing imports (the runtime, its platform unit),
// parsed like an imported unit from ASources' module paths: PR0012 naming the module paths
// only, PR0013 when it is no unit, both at APlace (the main module's header); its module, 0
// when it was not loaded
routine DoImplicitUnit(const AState: ref ParseState; const AName: string;
  const APlace: SourcePlace): int64;
begin
  if AState.Sources.FindUnit(AName, "") = "" then
    AState.Errors.Add(Severity.Error, ADAM_ERR_PARSER_012, APlace,
      ADAM_MSG_PARSER_RUNTIME_NOT_FOUND, NoArgs().Str(AName).Str(AName + ADAM_SOURCE_EXT));
    return 0;
  end;
  return DoParseUnit(AState, AName, "", APlace);
end;

// The runtime ARuntime of the program whose main module is AMain: the picked target's
// platform unit (Target.RuntimeUnit: the OS calls) first, then ARuntime, given an Import of
// that unit (Text its name, ResolvedUnit its module) as if it had written one, so its
// names resolve while ARuntime itself names no OS (user 2026-11-06: win64 is one target
// among many). No target for the main module's triple loads no platform unit (the Driver
// reports DR0004). ARuntime's module is recorded as ATree.Runtime. A runtime taken from its
// compiled form has that Import already. APlatform / ARuntimeId: the two modules (0 when
// not loaded)
routine DoRuntimeUnits(const AState: ref ParseState; const AMain: int64; const ARuntime: string;
  var APlatform: int64; var ARuntimeId: int64);
var
  LTarget: ref Target;
  LPlace: SourcePlace;
  LName: string;
  LImport: int64;
  LI: int64;
  LHas: bool;
begin
  LPlace := AState.Ast[AMain].Place;
  LTarget := FindTarget(AState.Ast.Triple);
  APlatform := 0;
  LName := "";
  if LTarget <> nil then
    LName := LTarget.RuntimeUnit();
    APlatform := DoImplicitUnit(AState, LName, LPlace);
  end;
  ARuntimeId := DoImplicitUnit(AState, ARuntime, LPlace);
  if ARuntimeId = 0 then
    return;
  end;
  AState.Ast.SetRuntime(ARuntimeId);
  if APlatform <> 0 then
    LHas := false;
    for LI := 0 to AState.Ast.CountOf(ARuntimeId, NodeRole.Import) - 1 do
      if AState.Ast[AState.Ast.NthOf(ARuntimeId, NodeRole.Import, LI)].ResolvedUnit = APlatform then
        LHas := true;
      end;
    end;
    if not LHas then
      LImport := AState.Ast.AddChild(ARuntimeId, NodeRole.Import, NodeKind.Import, LPlace, 0, 0);
      AState.Ast[LImport].Text := LName;
      AState.Ast[LImport].ResolvedUnit := APlatform;
    end;
  end;
end;

// AModule and then, depth first, every unit its Imports name, in their order, appended to
// AOrder when not in it yet: the order a parse of every source starts them in. Only a
// Module node under the program counts (0, an unloaded import, is none)
routine DoModuleOrder(const AState: ref ParseState; const AModule: int64;
  const AOrder: ref NodeList);
var
  LI: int64;
  LUnit: int64;
begin
  if (AModule = 0) or (AOrder.IndexOf(AModule) >= 0) or
    (AState.Ast.ParentOf(AModule) <> ADAM_AST_PROGRAM) or
    (AState.Ast[AModule].Kind <> NodeKind.Module) then
    return;
  end;
  AOrder.Add(AModule);
  for LI := 0 to AState.Ast.CountOf(AModule, NodeRole.Import) - 1 do
    LUnit := AState.Ast[AState.Ast.NthOf(AModule, NodeRole.Import, LI)].ResolvedUnit;
    DoModuleOrder(AState, LUnit, AOrder);
  end;
end;

// The program's modules put in the one order every build has, whichever were parsed and
// whichever taken from a compiled form (DESIGN sec 3: the same exe either way): the main
// module AMain and its imports depth first, then the platform unit APlatform and the
// runtime ARuntime with theirs (the order a parse of every source makes: those two load
// last). Every other child of the program (a skipped span's Error node) keeps its place
routine DoProgramOrder(const AState: ref ParseState; const AMain: int64; const APlatform: int64;
  const ARuntime: int64);
var
  LModules: ref NodeList;
  LOrder: ref NodeList;
  LI: int64;
  LChild: int64;
  LNext: int64;
begin
  LModules := ref NodeList();
  DoModuleOrder(AState, AMain, LModules);
  DoModuleOrder(AState, APlatform, LModules);
  DoModuleOrder(AState, ARuntime, LModules);
  // A module no import reaches (none today) keeps its parse order after those
  for LI := 0 to AState.Ast.ChildCount(ADAM_AST_PROGRAM) - 1 do
    LChild := AState.Ast.ChildAt(ADAM_AST_PROGRAM, LI);
    if AState.Ast[LChild].Kind = NodeKind.Module then
      DoModuleOrder(AState, LChild, LModules);
    end;
  end;
  // Each module slot of the program takes the next module of that order
  LOrder := ref NodeList();
  LNext := 0;
  for LI := 0 to AState.Ast.ChildCount(ADAM_AST_PROGRAM) - 1 do
    LChild := AState.Ast.ChildAt(ADAM_AST_PROGRAM, LI);
    if AState.Ast[LChild].Kind = NodeKind.Module then
      LOrder.Add(LModules.Items[LNext]);
      LNext := LNext + 1;
    else
      LOrder.Add(LChild);
    end;
  end;
  AState.Ast.ReorderChildren(ADAM_AST_PROGRAM, LOrder);
end;

// Parses the program whose main module is the file AMainPath into ATree, reporting into
// ADiagnostics, then (ARuntime not empty) the runtime unit ARuntime and its target's
// platform unit as implicit imports (DESIGN sec 8, DoRuntimeUnits) and recorded as
// ATree.Runtime. Files come from ASources: a given text in place of the disk, imports looked
// for in the importer's folder, then in ASources' module paths. AOverrideTarget, when not
// empty, is the triple the build has whatever the main module's @target says (the command
// line's -t). ALoader (nil for none) is asked for each imported unit's compiled form before
// its source is parsed (DoCompiledUnit). The modules end in the one order every build has
// (DoProgramOrder). The main module's id; 0 when its file cannot be read (PR0066, for the
// whole file) or has no module header
public routine ParseProgramWith(const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics;
  const ASources: ref SourceFiles; const AMainPath: string; const ARuntime: string;
  const AOverrideTarget: string; const ALoader: ref UnitLoader): int64;
var
  LState: ref ParseState;
  LIndex: int64;
  LMain: int64;
  LPlatform: int64;
  LRuntime: int64;
begin
  LState := ref ParseState(ATree, ADiagnostics, ASources);
  LState.OverrideTarget := AOverrideTarget;
  LState.Loader := ALoader;
  LIndex := ASources.Load(AMainPath);
  if LIndex < 0 then
    ADiagnostics.Add(Severity.Error, ADAM_ERR_PARSER_066, PlaceAt(AMainPath, 0, 0),
      ADAM_MSG_PARSER_UNREADABLE, NoArgs().Str(AMainPath));
    return 0;
  end;
  LMain := DoParseFile(LState, LIndex, AMainPath, ChangeFileExt(ExtractFileName(AMainPath), ""),
    true);
  if LMain = 0 then
    return 0;
  end;
  LPlatform := 0;
  LRuntime := 0;
  if ARuntime <> "" then
    DoRuntimeUnits(LState, LMain, ARuntime, LPlatform, LRuntime);
  end;
  DoProgramOrder(LState, LMain, LPlatform, LRuntime);
  return LMain;
end;

// ParseProgramWith with no runtime unit and no loader: the program as its own imports make it
public routine ParseProgram(const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics;
  const ASources: ref SourceFiles; const AMainPath: string): int64;
begin
  return ParseProgramWith(ATree, ADiagnostics, ASources, AMainPath, "", "", nil);
end;

// Parses the whole file APath (from ASources) as one expression (AType false) or one type
// expression (AType true) into ATree, reporting into ADiagnostics: its id, a node with no
// parent; 0 when the file cannot be read (PR0066)
routine DoParseFragment(const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics;
  const ASources: ref SourceFiles; const APath: string; const AType: bool): int64;
var
  LState: ref ParseState;
  LIndex: int64;
  LLexer: ref Lexer;
  LParser: ref FileParser;
begin
  LState := ref ParseState(ATree, ADiagnostics, ASources);
  LIndex := ASources.Load(APath);
  if LIndex < 0 then
    ADiagnostics.Add(Severity.Error, ADAM_ERR_PARSER_066, PlaceAt(APath, 0, 0),
      ADAM_MSG_PARSER_UNREADABLE, NoArgs().Str(APath));
    return 0;
  end;
  LLexer := ref Lexer(ASources[LIndex], ADiagnostics);
  LParser := ref FileParser(LState, LLexer.ReadAll(), APath, "", false);
  return LParser.ParseFragment(AType);
end;

// Parses the whole file APath (from ASources: a given text or the disk) as one expression
// (BNF sec 6) into ATree, reporting into ADiagnostics: the expression's id, a node with no
// parent; 0 when the file cannot be read (PR0066). Anything after the expression is
// PR0001 and one Error node under the program
public routine ParseExpression(const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics;
  const ASources: ref SourceFiles; const APath: string): int64;
begin
  return DoParseFragment(ATree, ADiagnostics, ASources, APath, false);
end;

// As ParseExpression, for one type expression (BNF sec 4)
public routine ParseTypeExpression(const ATree: ref SyntaxTree;
  const ADiagnostics: ref Diagnostics; const ASources: ref SourceFiles;
  const APath: string): int64;
begin
  return DoParseFragment(ATree, ADiagnostics, ASources, APath, true);
end;

end.
