-------------------------------------------------------------------------------
  Adam.Lsp.Hover.adam - a declaration as a hover shows it (M11b L3)

  HoverMarkdown: the declaration's heading in an adam fence, then its doc
  comment (Adam.Lsp.Docs) as a paragraph of its own. The heading:
    routine, method, init / copy / done, operator, forward, property,
    module: its text as written from its first token to the ';' that ends
    its heading (outside brackets), blanks run into one space; const: `const`
    and that text;
    type: `type` and its first line (`type Point = record`);
    var / field / parameter: `var X: T` / `X: T` with the type's text
    (Adam.Compiler.Types TypeText: the resolved type, an instance's own);
    embed `embed X: T`; a choice value `Type.Value`; a type parameter its
    name.
  The text is that of the declaration's own file (an LspDocument); with
  none, a heading needing it is its kind's word and its name.
*******************************************************************************/

module unit Adam.Lsp.Hover;

import System.SysUtils, Adam.Core.Containers, Adam.Compiler.SourceText, Adam.Compiler.AST,
  Adam.Compiler.Types, Adam.Lsp.Document, Adam.Lsp.Docs;

const
  ADAM_LSP_HOVER_FENCE: string = "```adam";
  ADAM_LSP_HOVER_FENCE_END: string = "```";

// The heading text of ADocument from AStart: up to the ';' that ends it outside brackets (or
// the end of its first line when AOneLine), a line comment dropped, blanks run into one space
// (a hover's heading, an outline's detail)
public routine HeadingText(const ADocument: ref LspDocument; const AStart: int64;
  const AOneLine: bool): string;
var
  LText: string;
  LAt: int64;
  LDepth: int64;
  LOut: ref TextBuilder;
  LBlank: bool;
  LChar: char;
begin
  LText := ADocument.Text;
  LOut := ref TextBuilder();
  LAt := AStart;
  LDepth := 0;
  LBlank := false;
  while LAt < len(LText) do
    LChar := LText[LAt];
    if (LChar = ';') and (LDepth = 0) then
      leave;
    end;
    if AOneLine and ((LChar = '\n') or (LChar = '\r')) then
      leave;
    end;
    if (LChar = '/') and (LAt + 1 < len(LText)) and (LText[LAt + 1] = '/') then
      // A comment to the line's end
      while (LAt < len(LText)) and (LText[LAt] <> '\n') do
        LAt := LAt + 1;
      end;
      LBlank := true;
      skip;
    end;
    if (LChar = ' ') or (LChar = '\t') or (LChar = '\n') or (LChar = '\r') then
      LBlank := true;
    else
      if LBlank and (LOut.Count > 0) then
        LOut.Add(" ");
      end;
      LBlank := false;
      if (LChar = '(') or (LChar = '[') then
        LDepth := LDepth + 1;
      end;
      if ((LChar = ')') or (LChar = ']')) and (LDepth > 0) then
        LDepth := LDepth - 1;
      end;
      LOut.Add(Substring(LText, LAt, 1));
    end;
    LAt := LAt + 1;
  end;
  return LOut.Text();
end;

// The heading of ADecl (see the header)
routine DoDeclarationText(const ATree: ref SyntaxTree; const ADecl: int64;
  const ADocument: ref LspDocument): string;
var
  LNode: ref Node;
  LStart: int64;
  LOwner: int64;
begin
  LNode := ATree[ADecl];
  match LNode.Kind of
    NodeKind.VarDecl:
      return "var " + LNode.Text + ": " + TypeText(ATree, LNode.ResolvedType);
    NodeKind.FieldDecl, NodeKind.Param:
      return LNode.Text + ": " + TypeText(ATree, LNode.ResolvedType);
    NodeKind.EmbedDecl:
      return "embed " + LNode.Text + ": " + TypeText(ATree, LNode.ResolvedType);
    NodeKind.GenericParam:
      return LNode.Text;
    NodeKind.ChoiceValue:
      LOwner := ATree.ParentOf(ADecl);
      while (LOwner <> 0) and (ATree[LOwner].Kind <> NodeKind.TypeDecl) do
        LOwner := ATree.ParentOf(LOwner);
      end;
      if LOwner = 0 then
        return LNode.Text;
      end;
      return ATree[LOwner].Text + "." + LNode.Text;
  else
  end;
  if ADocument = nil then
    return Trim(LowerCase(NodeKindText(LNode.Kind)) + " " + LNode.Text);
  end;
  LStart := ADocument.OffsetOfPlace(int64(LNode.Place.Line), int64(LNode.Place.Column));
  if (LNode.Kind = NodeKind.TypeDecl) or (LNode.Kind = NodeKind.ForwardType) then
    return "type " + HeadingText(ADocument, LStart, true);
  end;
  if LNode.Kind = NodeKind.ConstDecl then
    return "const " + HeadingText(ADocument, LStart, false);
  end;
  return HeadingText(ADocument, LStart, false);
end;

// The hover of the declaration ADecl of ATree, ADocument the text of its file (nil: none;
// see the header)
public routine HoverMarkdown(const ATree: ref SyntaxTree; const ADecl: int64;
  const ADocument: ref LspDocument): string;
var
  LText: string;
  LDoc: string;
begin
  LText := ADAM_LSP_HOVER_FENCE + "\n" + DoDeclarationText(ATree, ADecl, ADocument) + "\n" +
    ADAM_LSP_HOVER_FENCE_END;
  LDoc := DocMarkdown(ATree[ADecl].DocText);
  if LDoc <> "" then
    LText := LText + "\n\n" + LDoc;
  end;
  return LText;
end;

end.
