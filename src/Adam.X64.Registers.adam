-------------------------------------------------------------------------------
  Adam.X64.Registers.adam - x86_64's registers (DESIGN sec 6)

  X64Registers  the registers, numbered as the encoder writes them. 0..15
                are the general registers in their encoding order (rax rcx
                rdx rbx rsp rbp rsi rdi r8..r15: the low 3 bits go in ModRM
                / SIB, the 4th in REX), 16..31 are xmm0..xmm15 (number - 16
                is the encoding). The arch part (Adam.X64.Arch) answers its
                register facts from here; the arch's own units (Machine,
                Select, Allocate, Encode) number registers from here, never
                through the part, which sits above them.
*******************************************************************************/

module unit Adam.X64.Registers;

import System.SysUtils;

exported const
  // Every register, by number (see the header): the general ones, then the xmm ones
  ADAM_X64_GENERAL_REGISTERS: string = "rax rcx rdx rbx rsp rbp rsi rdi r8 r9 r10 r11 r12 r13 r14 r15";
  ADAM_X64_XMM_REGISTERS: string =
    "xmm0 xmm1 xmm2 xmm3 xmm4 xmm5 xmm6 xmm7 xmm8 xmm9 xmm10 xmm11 xmm12 xmm13 xmm14 xmm15";
  // The first xmm register's number
  ADAM_X64_FIRST_XMM: int64 = 16;
  // The stack pointer's name
  ADAM_X64_STACK_POINTER: string = "rsp";

exported type
  // x86_64's registers (see the header)
  X64Registers = object
    hidden FNames: StringArray;

    init();
    begin
      self.FNames := SplitString(ADAM_X64_GENERAL_REGISTERS + " " + ADAM_X64_XMM_REGISTERS, " ");
    end;

    // How many registers there are
    const method Count(): int64;
    begin
      return len(self.FNames);
    end;

    // The name of register ANumber; "" for a number that is no register
    const method Text(const ANumber: int64): string;
    begin
      if (ANumber < 0) or (ANumber >= len(self.FNames)) then
        return "";
      end;
      return self.FNames[ANumber];
    end;

    // The number of the register named AName; -1 for a name that is no register
    const method NumberOf(const AName: string): int64;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FNames) - 1 do
        if self.FNames[LI] = AName then
          return LI;
        end;
      end;
      return -1;
    end;
  end;

end.
