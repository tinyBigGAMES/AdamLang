-------------------------------------------------------------------------------
  Adam.Lsp.Uri.adam - file:// URIs and paths (M11b L1)

  UriToPath     the path a file URI names (RFC 8089): percent forms decoded
                as UTF-8 bytes, the slash before a drive letter dropped
                (/C:/dir -> C:/dir), an authority (host) part kept as a UNC
                path (//host/share); '/' separated, the caller resolves it
                as the OS spells it (System.IO's ResolvePath)
  PathToUri     UriToPath reversed: separators as '/', every byte outside
                the unreserved set (and '/' ':') percent-encoded
  PercentDecode RFC 3986's %XX forms as bytes, other characters as they are

  Prior art: PaskalCPP.LSP.Uri (CONCEPT and its byte sets adopted).
*******************************************************************************/

module unit Adam.Lsp.Uri;

import System.SysUtils, Adam.Compiler.SourceText;

public const
  // The scheme every file URI starts with (compared without case)
  ADAM_LSP_FILE_SCHEME: string = "file://";

const
  ADAM_LSP_URI_HEX: string = "0123456789ABCDEF";

// The value of the hex digit AChar; -1 when it is none
routine DoHexValue(const AChar: char): int64;
begin
  if (AChar >= '0') and (AChar <= '9') then
    return int64(AChar) - int64('0');
  end;
  if (AChar >= 'a') and (AChar <= 'f') then
    return int64(AChar) - int64('a') + 10;
  end;
  if (AChar >= 'A') and (AChar <= 'F') then
    return int64(AChar) - int64('A') + 10;
  end;
  return -1;
end;

// True when the byte AChar is written as it is in a URI's path (RFC 3986's unreserved set,
// '/' and ':')
routine DoIsPlain(const AChar: char): bool;
begin
  if ((AChar >= 'A') and (AChar <= 'Z')) or ((AChar >= 'a') and (AChar <= 'z')) or
    ((AChar >= '0') and (AChar <= '9')) then
    return true;
  end;
  return (AChar = '-') or (AChar = '.') or (AChar = '_') or (AChar = '~') or (AChar = '/') or
    (AChar = ':');
end;

// AText with each %XX (two hex digits) as the byte it names; every other character, a '%'
// with no two hex digits after it included, as it is
public routine PercentDecode(const AText: string): string;
var
  LText: string;
  LAt: int64;
  LI: int64;
  LHigh: int64;
  LLow: int64;
begin
  // The result is never longer than AText
  setlength(LText, len(AText));
  LAt := 0;
  LI := 0;
  while LI < len(AText) do
    LHigh := -1;
    LLow := -1;
    if (AText[LI] = '%') and (LI + 2 < len(AText)) then
      LHigh := DoHexValue(AText[LI + 1]);
      LLow := DoHexValue(AText[LI + 2]);
    end;
    if (LHigh >= 0) and (LLow >= 0) then
      LText[LAt] := char(uint8(LHigh * 16 + LLow));
      LI := LI + 3;
    else
      LText[LAt] := AText[LI];
      LI := LI + 1;
    end;
    LAt := LAt + 1;
  end;
  return Substring(LText, 0, LAt);
end;

// The path the file URI AUri names into APath (see the header); false (APath "") for a URI of
// any other scheme or one that names no path
public routine UriToPath(const AUri: string; var APath: string): bool;
var
  LPath: string;
begin
  APath := "";
  if not StartsText(ADAM_LSP_FILE_SCHEME, AUri) then
    return false;
  end;
  LPath := PercentDecode(Substring(AUri, len(ADAM_LSP_FILE_SCHEME),
    len(AUri) - len(ADAM_LSP_FILE_SCHEME)));
  if StartsStr("/", LPath) then
    // The slash before a drive letter: /C:/dir
    if (len(LPath) >= 3) and (LPath[2] = ':') then
      LPath := Substring(LPath, 1, len(LPath) - 1);
    end;
  else
    // An authority (host) part: a UNC path
    LPath := "//" + LPath;
  end;
  APath := LPath;
  return APath <> "";
end;

// The file URI of the path APath (see the header): C:\dir\a b.adam -> file:///C:/dir/a%20b.adam,
// /home/u/x.adam -> file:///home/u/x.adam, \\host\share\x -> file://host/share/x
public routine PathToUri(const APath: string): string;
var
  LPath: string;
  LText: string;
  LAt: int64;
  LI: int64;
  LByte: int64;
begin
  LPath := ForwardSlashes(APath);
  if StartsStr("//", LPath) then
    // A UNC path: its host is the URI's authority
    LPath := Substring(LPath, 2, len(LPath) - 2);
  else
    // A drive path gets the slash before its letter; a rooted one (/home/u) has it
    if not StartsStr("/", LPath) then
      LPath := "/" + LPath;
    end;
  end;
  // Each byte takes at most three
  setlength(LText, len(LPath) * 3);
  LAt := 0;
  for LI := 0 to len(LPath) - 1 do
    if DoIsPlain(LPath[LI]) then
      LText[LAt] := LPath[LI];
      LAt := LAt + 1;
    else
      LByte := int64(uint8(LPath[LI]));
      LText[LAt] := '%';
      LText[LAt + 1] := ADAM_LSP_URI_HEX[LByte shr 4];
      LText[LAt + 2] := ADAM_LSP_URI_HEX[LByte & 15];
      LAt := LAt + 3;
    end;
  end;
  return ADAM_LSP_FILE_SCHEME + Substring(LText, 0, LAt);
end;

end.
