-------------------------------------------------------------------------------
  Adam.PDB.Writer.adam - a PDB 7.00 written from a link's merged debug
  information (M7c), and the PDB read back as text (the rows' view)

  Every layout fact is Microsoft's PDB as LLVM documents and writes it
  (llvm/DebugInfo/PDB/Native: InfoStreamBuilder, NamedStreamMap,
  PDBStringTableBuilder, TpiStreamBuilder, TpiHashing, DbiStreamBuilder,
  DbiModuleDescriptorBuilder, GSIStreamBuilder; llvm/DebugInfo/PDB/Hash.cpp;
  the docs/PDB pages). lld-link's choices are followed where the format leaves
  one open (which symbols go to the globals, the order inside a hash bucket).

  PDBInput      what the linker hands over: the image's GUID, signature, age
                and machine; the type records (TPI) and id records (IPI),
                each final (indices remapped, 0x1000 up); per module (one
                object) its names, its source files, its symbol records
                (addresses resolved) and its line runs; the section
                contributions; the publics; the image's section headers
  PDBStreams    the input as an MSFWriter's streams:
     0          the old directory (empty)
     1          PDB info: version VC70, signature, age, GUID, the named
                stream map ("/names"), feature VC140
     2, 4       TPI and IPI: header V80, the records; each with a hash
                stream (each record's hash modulo 0x3FFFF, a type index
                offset every 8 KB of records)
     3          DBI: header V70, module infos, section contributions, the
                section map, the source file info, the optional debug header
                (the section headers stream)
     5..11      TPI hash, IPI hash, /names, globals (GSI hash), publics
                (PSI header, GSI hash, address map), the symbol records
                (publics then globals), the section headers
     12 up      one symbol stream per module: the C13 signature, the
                module's symbols (each scope's parent / end set to stream
                offsets), the file checksums (by /names offset, each with the
                checksum its object gave, in its object's order: a foreign
                object's inline sites and inlinee lines name a file by its
                entry's offset), the lines (columns when its object had
                them), the module's other subsections as its object had them
                (inlinee lines), then no global refs
                A module's symbol goes to its stream, to the globals, or both
                (lld-link's rule): a procedure stays in the module and the
                globals get an S_PROCREF / S_LPROCREF to it; S_GDATA32 /
                S_GTHREAD32 go to the globals only; S_UDT and S_LDATA32 /
                S_LTHREAD32 at module level go to the globals (an S_UDT only
                there), inside a procedure to the module; S_CONSTANT both. A
                global record identical to one already there is not added
                again (every module's S_UDT of one type)
  WritePDB      PDBStreams as a file of ADAM_MSF_BLOCK_SIZE blocks
  PDBSetIdentity  the info stream's signature and GUID set in a made
                PDBStreams (the linker's hash of the image and the streams)
  PDBText       a PDB file as text, one line per fact (the rows' view): the
                MSF layout, every stream decoded, each hash table checked by
                looking every name up the way a reader does ("found")
*******************************************************************************/

module unit Adam.PDB.Writer;

import System.SysUtils, System.Collections, Adam.Core.Containers, Adam.PDB.MSF,
  Adam.PDB.CodeView, Adam.PDB.Refs, System.Windows;

public const
  // The fixed stream numbers
  ADAM_PDB_STREAM_OLD_DIRECTORY: int64 = 0;
  ADAM_PDB_STREAM_INFO: int64 = 1;
  ADAM_PDB_STREAM_TPI: int64 = 2;
  ADAM_PDB_STREAM_DBI: int64 = 3;
  ADAM_PDB_STREAM_IPI: int64 = 4;
  // The name a PDB's string table stream goes by in the named stream map
  ADAM_PDB_NAMES_STREAM: string = "/names";
  // Raised (a compiler bug): a record whose length field is not its size or whose size is
  // not a multiple of 4, a scope closed it never opened or left open, a GUID not 16 bytes,
  // more modules or files than the DBI numbers
  ADAM_PDB_FAULT_RECORD: string = "PDB: a malformed record: ";
  ADAM_PDB_FAULT_SCOPE: string = "PDB: unbalanced symbol scopes in module ";
  ADAM_PDB_FAULT_GUID: string = "PDB: a GUID is 16 bytes, not ";
  ADAM_PDB_FAULT_LIMIT: string = "PDB: more than the DBI numbers: ";
  ADAM_PDB_FAULT_COLUMNS: string = "PDB: a line run with columns for some rows only: ";

const
  // PDB info stream: version VC70, feature VC140 (an IPI stream is there)
  ADAM_PDB_INFO_VERSION: int64 = 20000404;
  ADAM_PDB_FEATURE_VC140: int64 = 20140508;
  // The named stream map's hash table capacity (LLVM's first, never grown for one name)
  // and the 16 bits of a name's hash it uses
  ADAM_PDB_NAMED_CAPACITY: int64 = 8;
  ADAM_PDB_NAMED_HASH_MASK: uint64 = 0xFFFF;
  // TPI / IPI: version V80, the header's size, the hash buckets, one type index offset per
  // 8 KB of records, no stream (an aux hash stream)
  ADAM_PDB_TPI_VERSION: int64 = 20040203;
  ADAM_PDB_TPI_HEADER_SIZE: int64 = 56;
  ADAM_PDB_TPI_BUCKETS: int64 = 0x3FFFF;
  ADAM_PDB_TPI_OFFSET_SPAN: int64 = 8192;
  ADAM_PDB_NO_STREAM: int64 = 0xFFFF;
  // DBI: version V70 (the signature -1 before it), build 14.0 in the new format, the
  // header's and a module info's fixed sizes, a section contribution's size, the
  // contributions' version (Ver60), the optional debug header's 11 stream numbers (the
  // section headers' the 6th)
  ADAM_PDB_DBI_SIGNATURE: int64 = 0xFFFFFFFF;
  ADAM_PDB_DBI_VERSION: int64 = 19990903;
  ADAM_PDB_DBI_BUILD: int64 = 0x8E00;
  ADAM_PDB_DBI_HEADER_SIZE: int64 = 64;
  ADAM_PDB_DBI_MODULE_SIZE: int64 = 64;
  ADAM_PDB_DBI_CONTRIBUTION_SIZE: int64 = 28;
  // 0xEFFE0000 + 19970605
  ADAM_PDB_DBI_CONTRIBUTION_VERSION: int64 = 0xF12EBA2D;
  ADAM_PDB_DBI_DEBUG_STREAMS: int64 = 11;
  ADAM_PDB_DBI_DEBUG_SECTION_HEADERS: int64 = 5;
  // The section map: an entry's size; its flags (OMFSegDescFlags) from a section's
  // characteristics; the closing entry's flags
  ADAM_PDB_SECMAP_ENTRY_SIZE: int64 = 20;
  ADAM_PDB_SECMAP_READ: int64 = 0x0001;
  ADAM_PDB_SECMAP_WRITE: int64 = 0x0002;
  ADAM_PDB_SECMAP_EXECUTE: int64 = 0x0004;
  ADAM_PDB_SECMAP_32BIT: int64 = 0x0008;
  ADAM_PDB_SECMAP_SELECTOR: int64 = 0x0100;
  ADAM_PDB_SECMAP_ABSOLUTE: int64 = 0x0200;
  // GSI hash: buckets (IPHR_HASH), the bitmap's words, its version, the size a hash
  // record had with 32-bit pointers (a bucket's start is its first record's index times it)
  ADAM_PDB_GSI_BUCKETS: int64 = 4096;
  ADAM_PDB_GSI_BITMAP_WORDS: int64 = 129;
  ADAM_PDB_GSI_SIGNATURE: int64 = 0xFFFFFFFF;
  // 0xEFFE0000 + 19990810
  ADAM_PDB_GSI_VERSION: int64 = 0xF12F091A;
  ADAM_PDB_GSI_RECORD_SPAN: int64 = 12;
  // The publics stream's header size, a public's flag for a function
  ADAM_PDB_PSI_HEADER_SIZE: int64 = 28;
  // The string table (/names): its signature, hash version 1
  ADAM_PDB_NAMES_SIGNATURE: int64 = 0xEFFEEFFE;
  ADAM_PDB_NAMES_VERSION: int64 = 1;
  // Where a scope record's parent and end fields are (after its length and kind)
  ADAM_PDB_SCOPE_PARENT: int64 = 4;
  ADAM_PDB_SCOPE_END: int64 = 8;
  // Where a procedure record's name starts (parent end next size start end type offset
  // segment flags), and where an S_PUB32 / S_PROCREF / S_*DATA32's does
  ADAM_PDB_PROC_NAME: int64 = 39;
  ADAM_PDB_REF_NAME: int64 = 14;
  // The reflected CRC-32 polynomial (TPI hashes a record that has no name by it)
  ADAM_PDB_CRC_POLY: uint64 = 0xEDB88320;

public type
  // One function's line runs: its code's section (1 up), offset and size, then per row
  // its code offset from the start, its C13 line word (the line in bits 0..23, the delta
  // to the statement's end in 24..30, a statement in 31) and its file (an index into its
  // module's Files); with columns (HasColumns) each row's start and end column too
  PDBLines = object
    Section: int64;
    Offset: int64;
    CodeSize: int64;
    CodeOffsets: Int64Array;
    LineWords: Int64Array;
    FileIndices: Int64Array;
    HasColumns: bool;
    ColumnStarts: Int64Array;
    ColumnEnds: Int64Array;

    init(const ASection: int64; const AOffset: int64; const ACodeSize: int64);
    begin
      self.Section := ASection;
      self.Offset := AOffset;
      self.CodeSize := ACodeSize;
      setlength(self.CodeOffsets, 0);
      setlength(self.LineWords, 0);
      setlength(self.FileIndices, 0);
      self.HasColumns := false;
      setlength(self.ColumnStarts, 0);
      setlength(self.ColumnEnds, 0);
    end;

    // The row: code at ACodeOffset is the statement at line ALine of file AFile
    method Add(const ACodeOffset: int64; const ALine: int64; const AFile: int64);
    begin
      self.AddWord(ACodeOffset, (ALine & ADAM_CV_LINE_MASK) | ADAM_CV_LINE_STATEMENT, AFile);
    end;

    // The row: code at ACodeOffset is the C13 line word AWord of file AFile
    method AddWord(const ACodeOffset: int64; const AWord: int64; const AFile: int64);
    var
      LCount: int64;
    begin
      LCount := len(self.CodeOffsets);
      setlength(self.CodeOffsets, LCount + 1);
      setlength(self.LineWords, LCount + 1);
      setlength(self.FileIndices, LCount + 1);
      self.CodeOffsets[LCount] := ACodeOffset;
      self.LineWords[LCount] := AWord;
      self.FileIndices[LCount] := AFile;
    end;

    // The last row's columns: AStart to AEnd (a run with columns gives every row its own)
    method AddColumns(const AStart: int64; const AEnd: int64);
    var
      LCount: int64;
    begin
      self.HasColumns := true;
      LCount := len(self.ColumnStarts);
      setlength(self.ColumnStarts, LCount + 1);
      setlength(self.ColumnEnds, LCount + 1);
      self.ColumnStarts[LCount] := AStart;
      self.ColumnEnds[LCount] := AEnd;
    end;
  end;

// Raises unless ARecord is one whole record: at least its length and kind, a multiple of 4
// bytes, its length field all but itself
func DoCheckRecord(const ARecord: ByteArray);
begin
  if (len(ARecord) < 4) or ((len(ARecord) & 3) <> 0) or
    (int64(GetLe(ARecord, 0, 2)) <> len(ARecord) - 2) then
    raise(ADAM_PDB_FAULT_RECORD + IntToStr(len(ARecord)) + " bytes");
  end;
end;

public type
  // One module (one object) of the link (see the header): per source file its name, its
  // checksum's kind and bytes (kind 0, none: no bytes); its other C13 subsections (each
  // kind and contents, final)
  PDBModule = object
    ModuleName: string;
    ObjectName: string;
    Files: StringArray;
    ChecksumKinds: Int64Array;
    Checksums: ref List<ByteArray>;
    Lines: ref List<ref PDBLines>;
    SubsectionKinds: Int64Array;
    Subsections: ref List<ByteArray>;
    hidden FSymbols: ref MSFBytes;

    init(const AModuleName: string; const AObjectName: string);
    begin
      self.ModuleName := AModuleName;
      self.ObjectName := AObjectName;
      setlength(self.Files, 0);
      setlength(self.ChecksumKinds, 0);
      self.Checksums := ref List<ByteArray>();
      self.Lines := ref List<ref PDBLines>();
      setlength(self.SubsectionKinds, 0);
      self.Subsections := ref List<ByteArray>();
      self.FSymbols := ref MSFBytes();
    end;

    // The index of the source file AFileName (no checksum), added when it is new
    method AddFile(const AFileName: string): int64;
    var
      LI: int64;
      LNone: ByteArray;
    begin
      for LI := 0 to len(self.Files) - 1 do
        if self.Files[LI] = AFileName then
          return LI;
        end;
      end;
      setlength(LNone, 0);
      return self.AddFileEntry(AFileName, 0, LNone);
    end;

    // The source file AFileName with its checksum (AKind, AChecksum) as the next file,
    // a name already there or not (an object's checksum table entry by entry); its index
    method AddFileEntry(const AFileName: string; const AKind: int64; const AChecksum: ByteArray): int64;
    var
      LCount: int64;
    begin
      LCount := len(self.Files);
      setlength(self.Files, LCount + 1);
      setlength(self.ChecksumKinds, LCount + 1);
      self.Files[LCount] := AFileName;
      self.ChecksumKinds[LCount] := AKind;
      self.Checksums.Add(AChecksum);
      return LCount;
    end;

    // A C13 subsection of kind AKind and contents ABytes (final: its indices the PDB's,
    // its files by this module's checksum offsets), written after the lines
    method AddSubsection(const AKind: int64; const ABytes: ByteArray);
    begin
      setlength(self.SubsectionKinds, len(self.SubsectionKinds) + 1);
      self.SubsectionKinds[len(self.SubsectionKinds) - 1] := AKind;
      self.Subsections.Add(ABytes);
    end;

    // ARecord (one whole symbol record, its address final) appended to the module's symbols
    method AddSymbol(const ARecord: ByteArray);
    begin
      DoCheckRecord(ARecord);
      self.FSymbols.PutBytes(ARecord);
    end;

    // ALines appended to the module's line runs
    method AddLines(const ALines: ref PDBLines);
    begin
      self.Lines.Add(ALines);
    end;

    // The module's symbol records, in order
    const method Symbols(): ByteArray;
    begin
      return self.FSymbols.Bytes();
    end;
  end;

  // A run of an image section a module's object put there: section (1 up), offset, size,
  // the section's characteristics, the module's index; ordered by section, then offset
  PDBContribution = record
    Section: int64;
    Offset: int64;
    Size: int64;
    Characteristics: int64;
    ModuleIndex: int64;

    operator <(const A: PDBContribution; const B: PDBContribution): bool;
    begin
      if A.Section <> B.Section then
        return A.Section < B.Section;
      end;
      return A.Offset < B.Offset;
    end;
  end;

  // A public symbol: its name, its section (1 up) and offset, whether it is code
  PDBPublic = record
    SymbolName: string;
    Section: int64;
    Offset: int64;
    IsCode: bool;
  end;

  // Everything the PDB is written from (see the header)
  PDBInput = object
    GUID: ByteArray;
    Signature: int64;
    Age: int64;
    Machine: int64;
    Modules: ref List<ref PDBModule>;
    Contributions: ref List<PDBContribution>;
    Publics: ref List<PDBPublic>;
    SectionHeaders: ByteArray;
    hidden FTypes: ref MSFBytes;
    hidden FTypeCount: int64;
    hidden FIds: ref MSFBytes;
    hidden FIdCount: int64;

    // An empty input for an image of the COFF machine AMachine: GUID zeros, signature 0,
    // age 1
    init(const AMachine: int64);
    var
      LI: int64;
    begin
      setlength(self.GUID, 16);
      for LI := 0 to 15 do
        self.GUID[LI] := 0;
      end;
      self.Signature := 0;
      self.Age := 1;
      self.Machine := AMachine;
      self.Modules := ref List<ref PDBModule>();
      self.Contributions := ref List<PDBContribution>();
      self.Publics := ref List<PDBPublic>();
      setlength(self.SectionHeaders, 0);
      self.FTypes := ref MSFBytes();
      self.FTypeCount := 0;
      self.FIds := ref MSFBytes();
      self.FIdCount := 0;
    end;

    // A new module of the names AModuleName and AObjectName; its index is its place in
    // Modules
    method AddModule(const AModuleName: string; const AObjectName: string): ref PDBModule;
    var
      LModule: ref PDBModule;
    begin
      LModule := ref PDBModule(AModuleName, AObjectName);
      self.Modules.Add(LModule);
      return LModule;
    end;

    // ARecord (one whole type record) as the next type; its index returned (0x1000 up)
    method AddType(const ARecord: ByteArray): int64;
    begin
      DoCheckRecord(ARecord);
      self.FTypes.PutBytes(ARecord);
      self.FTypeCount := self.FTypeCount + 1;
      return CV_FIRST_NONPRIM + self.FTypeCount - 1;
    end;

    // ARecord (one whole id record) as the next id; its index returned (0x1000 up)
    method AddId(const ARecord: ByteArray): int64;
    begin
      DoCheckRecord(ARecord);
      self.FIds.PutBytes(ARecord);
      self.FIdCount := self.FIdCount + 1;
      return CV_FIRST_NONPRIM + self.FIdCount - 1;
    end;

    // A run of ASize bytes at AOffset of section ASection (characteristics
    // ACharacteristics) from module AModuleIndex
    method AddContribution(const ASection: int64; const AOffset: int64; const ASize: int64;
      const ACharacteristics: int64; const AModuleIndex: int64);
    var
      LRun: PDBContribution;
    begin
      LRun.Section := ASection;
      LRun.Offset := AOffset;
      LRun.Size := ASize;
      LRun.Characteristics := ACharacteristics;
      LRun.ModuleIndex := AModuleIndex;
      self.Contributions.Add(LRun);
    end;

    // The public ASymbolName at AOffset of section ASection (code when AIsCode)
    method AddPublic(const ASymbolName: string; const ASection: int64; const AOffset: int64;
      const AIsCode: bool);
    var
      LPublic: PDBPublic;
    begin
      LPublic.SymbolName := ASymbolName;
      LPublic.Section := ASection;
      LPublic.Offset := AOffset;
      LPublic.IsCode := AIsCode;
      self.Publics.Add(LPublic);
    end;

    // The type records, in index order, and their count
    const method TypeBytes(): ByteArray;
    begin
      return self.FTypes.Bytes();
    end;

    const method TypeCount(): int64;
    begin
      return self.FTypeCount;
    end;

    // The id records, in index order, and their count
    const method IdBytes(): ByteArray;
    begin
      return self.FIds.Bytes();
    end;

    const method IdCount(): int64;
    begin
      return self.FIdCount;
    end;
  end;

// PDB's string hash (hashStringV1): AText's bytes xor-ed in as 32-bit little-endian words,
// then a 16-bit word and a byte for the rest, then folded; every name table of a PDB (the
// named stream map with its low 16 bits, /names, the GSI, a UDT's TPI hash) hashes by it
public func PDBHashText(const AText: string): uint64;
var
  LResult: uint64;
  LSize: int64;
  LAt: int64;
begin
  LResult := 0;
  LSize := len(AText);
  LAt := 0;
  while LAt + 4 <= LSize do
    LResult := LResult xor (uint64(uint8(AText[LAt])) | (uint64(uint8(AText[LAt + 1])) shl 8) |
      (uint64(uint8(AText[LAt + 2])) shl 16) | (uint64(uint8(AText[LAt + 3])) shl 24));
    LAt := LAt + 4;
  end;
  if LSize - LAt >= 2 then
    LResult := LResult xor (uint64(uint8(AText[LAt])) | (uint64(uint8(AText[LAt + 1])) shl 8));
    LAt := LAt + 2;
  end;
  if LSize - LAt = 1 then
    LResult := LResult xor uint64(uint8(AText[LAt]));
  end;
  // every byte's 0x20 bit set (case folds alike), then folded down
  LResult := LResult | 0x20202020;
  LResult := LResult xor (LResult shr 11);
  return (LResult xor (LResult shr 16)) & 0xFFFFFFFF;
end;

// The CRC-32 of ACount bytes of ABytes from AAt with no first or last inversion (LLVM's
// JamCRC from 0: hashBufferV8, TPI's hash of a record that has no name)
public func PDBHashBytes(const ABytes: ByteArray; const AAt: int64; const ACount: int64): uint64;
var
  LCRC: uint64;
  LBit: int64;
  LI: int64;
begin
  LCRC := 0;
  for LI := 0 to ACount - 1 do
    LCRC := LCRC xor uint64(ABytes[AAt + LI]);
    // one bit at a time: a record is hashed once, so no table is kept
    for LBit := 0 to 7 do
      if (LCRC & 1) <> 0 then
        LCRC := (LCRC shr 1) xor ADAM_PDB_CRC_POLY;
      else
        LCRC := LCRC shr 1;
      end;
    end;
  end;
  return LCRC & 0xFFFFFFFF;
end;

// The NUL-ended text at AAt of ABytes (stopping at AEnd)
func DoTextAt(const ABytes: ByteArray; const AAt: int64; const AEnd: int64): string;
var
  LText: string;
  LStop: int64;
  LI: int64;
begin
  LStop := AAt;
  while (LStop < AEnd) and (LStop < len(ABytes)) and (ABytes[LStop] <> 0) do
    LStop := LStop + 1;
  end;
  if LStop <= AAt then
    return "";
  end;
  // sized once, then filled
  setlength(LText, LStop - AAt);
  for LI := 0 to LStop - AAt - 1 do
    LText[LI] := char(ABytes[AAt + LI]);
  end;
  return LText;
end;

// ACount bytes of ABytes from AAt as a text of those bytes (a record compared whole)
func DoBytesText(const ABytes: ByteArray; const AAt: int64; const ACount: int64): string;
var
  LText: string;
  LI: int64;
begin
  setlength(LText, ACount);
  for LI := 0 to ACount - 1 do
    LText[LI] := char(ABytes[AAt + LI]);
  end;
  return LText;
end;

// The AWidth-byte value at AAt of ABytes
func DoGet(const ABytes: ByteArray; const AAt: int64; const AWidth: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, AWidth));
end;

// The byte count of the numeric leaf at AAt of ABytes (its kind and its value; Refs'
// CvNumericSize, a kind it does not know read as its 2 bytes alone)
func DoLeafSize(const ABytes: ByteArray; const AAt: int64): int64;
var
  LSize: int64;
begin
  LSize := CvNumericSize(ABytes, AAt, len(ABytes));
  if LSize < 0 then
    return 2;
  end;
  return LSize;
end;

// True when a record of AKind is a procedure (the globals get a reference to it)
func DoIsProcedure(const AKind: int64): bool;
begin
  return (AKind = S_GPROC32) or (AKind = S_LPROC32) or
    (AKind = S_GPROC32_ID) or (AKind = S_LPROC32_ID) or
    (AKind = S_LPROC32_DPC) or (AKind = S_LPROC32_DPC_ID);
end;

// The name of the symbol record at AAt of ABytes ("" for a kind that has none the PDB
// hashes)
func DoSymbolName(const ABytes: ByteArray; const AAt: int64): string;
var
  LKind: int64;
  LEnd: int64;
begin
  LKind := DoGet(ABytes, AAt + 2, 2);
  LEnd := AAt + 2 + DoGet(ABytes, AAt, 2);
  if (LKind = S_PUB32) or (LKind = S_PROCREF) or (LKind = S_LPROCREF) or
    (LKind = S_GDATA32) or (LKind = S_LDATA32) or (LKind = S_GTHREAD32) or
    (LKind = S_LTHREAD32) then
    return DoTextAt(ABytes, AAt + ADAM_PDB_REF_NAME, LEnd);
  end;
  if DoIsProcedure(LKind) then
    return DoTextAt(ABytes, AAt + ADAM_PDB_PROC_NAME, LEnd);
  end;
  if LKind = S_UDT then
    return DoTextAt(ABytes, AAt + 8, LEnd);
  end;
  if LKind = S_CONSTANT then
    return DoTextAt(ABytes, AAt + 8 + DoLeafSize(ABytes, AAt + 8), LEnd);
  end;
  return "";
end;

// True when a byte of AText is past ASCII
func DoHasWide(const AText: string): bool;
var
  LI: int64;
begin
  for LI := 0 to len(AText) - 1 do
    if uint8(AText[LI]) >= 0x80 then
      return true;
    end;
  end;
  return false;
end;

// AByte lowered when it is an ASCII capital
func DoLower(const AByte: int64): int64;
begin
  if (AByte >= 0x41) and (AByte <= 0x5A) then
    return AByte + 0x20;
  end;
  return AByte;
end;

// A GSI bucket's order of names (the reference implementation's, which a reader's search
// stops early by): a shorter name first; equal lengths by their bytes when either is past
// ASCII, else ignoring case; -1, 0 or 1
public func PDBCompareNames(const ALeft: string; const ARight: string): int64;
var
  LWide: bool;
  LA: int64;
  LB: int64;
  LI: int64;
begin
  if len(ALeft) <> len(ARight) then
    if len(ALeft) < len(ARight) then
      return -1;
    end;
    return 1;
  end;
  LWide := DoHasWide(ALeft) or DoHasWide(ARight);
  for LI := 0 to len(ALeft) - 1 do
    LA := int64(uint8(ALeft[LI]));
    LB := int64(uint8(ARight[LI]));
    if not LWide then
      LA := DoLower(LA);
      LB := DoLower(LB);
    end;
    if LA <> LB then
      if LA < LB then
        return -1;
      end;
      return 1;
    end;
  end;
  return 0;
end;

// AText's bytes compared as they are; -1, 0 or 1
func DoCompareBytes(const ALeft: string; const ARight: string): int64;
var
  LCount: int64;
  LA: int64;
  LB: int64;
  LI: int64;
begin
  LCount := len(ALeft);
  if len(ARight) < LCount then
    LCount := len(ARight);
  end;
  for LI := 0 to LCount - 1 do
    LA := int64(uint8(ALeft[LI]));
    LB := int64(uint8(ARight[LI]));
    if LA <> LB then
      if LA < LB then
        return -1;
      end;
      return 1;
    end;
  end;
  if len(ALeft) < len(ARight) then
    return -1;
  end;
  if len(ALeft) > len(ARight) then
    return 1;
  end;
  return 0;
end;

type
  // A record of a GSI hash table: its bucket, its name, its offset in the symbol record
  // stream; ordered by bucket, then name (PDBCompareNames), then offset
  GsiEntry = record
    Bucket: int64;
    SymbolName: string;
    Offset: int64;

    operator <(const A: GsiEntry; const B: GsiEntry): bool;
    var
      LOrder: int64;
    begin
      if A.Bucket <> B.Bucket then
        return A.Bucket < B.Bucket;
      end;
      LOrder := PDBCompareNames(A.SymbolName, B.SymbolName);
      if LOrder <> 0 then
        return LOrder < 0;
      end;
      return A.Offset < B.Offset;
    end;
  end;

  // A public's place in the address map: section, offset, name, record offset; ordered by
  // section, then offset, then name's bytes
  AddressEntry = record
    Section: int64;
    Offset: int64;
    SymbolName: string;
    RecordOffset: int64;

    operator <(const A: AddressEntry; const B: AddressEntry): bool;
    begin
      if A.Section <> B.Section then
        return A.Section < B.Section;
      end;
      if A.Offset <> B.Offset then
        return A.Offset < B.Offset;
      end;
      return DoCompareBytes(A.SymbolName, B.SymbolName) < 0;
    end;
  end;

// The GSI bucket of the name AText
func DoGsiBucket(const AText: string): int64;
begin
  return int64(PDBHashText(AText) mod uint64(ADAM_PDB_GSI_BUCKETS));
end;

// The GSI hash table over AEntries (each a record's name and offset): the header, the
// hash records by bucket and name, the bitmap of non-empty buckets, each one's start
func DoGsiHash(const AEntries: ref List<GsiEntry>): ByteArray;
var
  LBytes: ref MSFBytes;
  LBitmap: Int64Array;
  LStarts: ref Int64List;
  LEntry: GsiEntry;
  LBucket: int64;
  LI: int64;
begin
  for LI := 0 to AEntries.Count - 1 do
    LEntry := AEntries[LI];
    LEntry.Bucket := DoGsiBucket(LEntry.SymbolName);
    AEntries[LI] := LEntry;
  end;
  AEntries.Sort();
  setlength(LBitmap, ADAM_PDB_GSI_BITMAP_WORDS);
  for LI := 0 to ADAM_PDB_GSI_BITMAP_WORDS - 1 do
    LBitmap[LI] := 0;
  end;
  LStarts := ref Int64List();
  LBucket := -1;
  for LI := 0 to AEntries.Count - 1 do
    if AEntries[LI].Bucket <> LBucket then
      LBucket := AEntries[LI].Bucket;
      LBitmap[LBucket div 32] := LBitmap[LBucket div 32] | (1 shl (LBucket mod 32));
      LStarts.Add(LI * ADAM_PDB_GSI_RECORD_SPAN);
    end;
  end;
  LBytes := ref MSFBytes();
  LBytes.Put(uint64(ADAM_PDB_GSI_SIGNATURE), 4);
  LBytes.Put(uint64(ADAM_PDB_GSI_VERSION), 4);
  LBytes.Put(uint64(AEntries.Count * 8), 4);
  LBytes.Put(uint64((ADAM_PDB_GSI_BITMAP_WORDS + LStarts.Count) * 4), 4);
  // a hash record names its record's offset plus 1, one reference
  for LI := 0 to AEntries.Count - 1 do
    LBytes.Put(uint64(AEntries[LI].Offset + 1), 4);
    LBytes.Put(1, 4);
  end;
  for LI := 0 to ADAM_PDB_GSI_BITMAP_WORDS - 1 do
    LBytes.Put(uint64(LBitmap[LI]), 4);
  end;
  for LI := 0 to LStarts.Count - 1 do
    LBytes.Put(uint64(LStarts[LI]), 4);
  end;
  return LBytes.Bytes();
end;

// True when AText is the name C / C++ give an unnamed UDT ("<unnamed-tag>", "__unnamed",
// or either after a scope's "::")
func DoIsAnonymous(const AText: string): bool;
begin
  return (AText = "<unnamed-tag>") or (AText = "__unnamed") or EndsStr("::<unnamed-tag>", AText) or
    EndsStr("::__unnamed", AText);
end;

// The hash of the type (or id) record at AAt of ARecords, ASize bytes (TpiHashing): a
// named UDT by its name or unique name, a UDT source line by its UDT's index, any other
// record by its bytes
func DoTypeHash(const ARecords: ByteArray; const AAt: int64; const ASize: int64): uint64;
var
  LKind: int64;
  LProperties: int64;
  LNameAt: int64;
  LEnd: int64;
  LText: string;
  LUnique: string;
  LIndex: string;
  LForward: bool;
  LScoped: bool;
  LHasUnique: bool;
  LAnonymous: bool;
  LI: int64;
begin
  LKind := DoGet(ARecords, AAt + 2, 2);
  LEnd := AAt + ASize;
  if (LKind = LF_UDT_SRC_LINE) or (LKind = LF_UDT_MOD_SRC_LINE) then
    // the UDT's index as its 4 bytes
    setlength(LIndex, 4);
    for LI := 0 to 3 do
      LIndex[LI] := char(ARecords[AAt + 4 + LI]);
    end;
    return PDBHashText(LIndex);
  end;
  LNameAt := -1;
  if (LKind = LF_CLASS) or (LKind = LF_STRUCTURE) or
    (LKind = LF_INTERFACE) then
    // count, properties, field list, derived, vshape, then the size leaf
    LNameAt := AAt + 20 + DoLeafSize(ARecords, AAt + 20);
  end;
  if LKind = LF_UNION then
    LNameAt := AAt + 12 + DoLeafSize(ARecords, AAt + 12);
  end;
  if LKind = LF_ENUM then
    LNameAt := AAt + 16;
  end;
  if LNameAt < 0 then
    return PDBHashBytes(ARecords, AAt, ASize);
  end;
  LProperties := DoGet(ARecords, AAt + 6, 2);
  LText := DoTextAt(ARecords, LNameAt, LEnd);
  LUnique := DoTextAt(ARecords, LNameAt + len(LText) + 1, LEnd);
  LForward := (LProperties & ADAM_CV_PROP_FORWARD) <> 0;
  LScoped := (LProperties & ADAM_CV_PROP_SCOPED) <> 0;
  LHasUnique := (LProperties & ADAM_CV_PROP_UNIQUE) <> 0;
  LAnonymous := LHasUnique and DoIsAnonymous(LText);
  if not LForward and not LScoped and not LAnonymous then
    return PDBHashText(LText);
  end;
  if not LForward and LHasUnique and not LAnonymous then
    return PDBHashText(LUnique);
  end;
  return PDBHashBytes(ARecords, AAt, ASize);
end;

type
  // Builds the streams of a PDBInput (see the header)
  PDBBuilder = object
    hidden FInput: ref PDBInput;
    hidden FMSF: ref MSFWriter;
    // The streams numbered after the fixed five
    hidden FTpiHash: int64;
    hidden FIpiHash: int64;
    hidden FNamesStream: int64;
    hidden FGlobalsStream: int64;
    hidden FPublicsStream: int64;
    hidden FRecordsStream: int64;
    hidden FHeadersStream: int64;
    hidden FFirstModuleStream: int64;
    // /names: its buffer (the empty name at 0) and each name's offset + 1
    hidden FNames: ref MSFBytes;
    hidden FNameOffsets: ref StringIdMap;
    hidden FNameCount: int64;
    // The global records (each module's, then deduplicated) and the ones already in
    hidden FGlobals: ref MSFBytes;
    hidden FGlobalSeen: ref StringIdMap;
    // Per module: its symbol bytes (signature included) and its C13 bytes' sizes
    hidden FSymbolSizes: Int64Array;
    hidden FLineSizes: Int64Array;

    init(const AInput: ref PDBInput; const ABlockSize: int64);
    var
      LI: int64;
    begin
      if len(AInput.GUID) <> 16 then
        raise(ADAM_PDB_FAULT_GUID + IntToStr(len(AInput.GUID)));
      end;
      if AInput.Modules.Count > 0xFFFF then
        raise(ADAM_PDB_FAULT_LIMIT + IntToStr(AInput.Modules.Count) + " modules");
      end;
      self.FInput := AInput;
      self.FMSF := ref MSFWriter(ABlockSize);
      for LI := 0 to ADAM_PDB_STREAM_IPI do
        self.FMSF.ReserveStream();
      end;
      self.FTpiHash := self.FMSF.ReserveStream();
      self.FIpiHash := self.FMSF.ReserveStream();
      self.FNamesStream := self.FMSF.ReserveStream();
      self.FGlobalsStream := self.FMSF.ReserveStream();
      self.FPublicsStream := self.FMSF.ReserveStream();
      self.FRecordsStream := self.FMSF.ReserveStream();
      self.FHeadersStream := self.FMSF.ReserveStream();
      self.FFirstModuleStream := self.FMSF.StreamCount();
      for LI := 0 to AInput.Modules.Count - 1 do
        self.FMSF.ReserveStream();
      end;
      self.FNames := ref MSFBytes();
      self.FNames.Put(0, 1);
      self.FNameOffsets := ref StringIdMap(0);
      self.FNameCount := 0;
      self.FGlobals := ref MSFBytes();
      self.FGlobalSeen := ref StringIdMap(0);
      setlength(self.FSymbolSizes, AInput.Modules.Count);
      setlength(self.FLineSizes, AInput.Modules.Count);
    end;

    // The /names offset of AText, added when it is new ("" is 0)
    hidden method DoName(const AText: string): int64;
    var
      LOffset: int64;
    begin
      if AText = "" then
        return 0;
      end;
      LOffset := self.FNameOffsets.Find(AText);
      if LOffset <> 0 then
        return LOffset - 1;
      end;
      LOffset := self.FNames.Count;
      self.FNames.PutText(AText);
      self.FNameOffsets.Put(AText, LOffset + 1);
      self.FNameCount := self.FNameCount + 1;
      return LOffset;
    end;

    // ACount bytes of ABytes at AAt (a whole record) into the globals, unless an identical
    // record is there
    hidden method DoGlobal(const ABytes: ByteArray; const AAt: int64; const ACount: int64);
    var
      LKey: string;
    begin
      LKey := DoBytesText(ABytes, AAt, ACount);
      if self.FGlobalSeen.Find(LKey) <> 0 then
        return;
      end;
      self.FGlobalSeen.Put(LKey, 1);
      self.FGlobals.PutRange(ABytes, AAt, ACount);
    end;

    // The globals' S_PROCREF (or S_LPROCREF for a local procedure) to the procedure
    // ASymbolName at AOffset of module AModuleIndex's stream
    hidden method DoProcRef(const AKind: int64; const ASymbolName: string; const AOffset: int64;
      const AModuleIndex: int64);
    var
      LRecord: ref MSFBytes;
      LBytes: ByteArray;
    begin
      LRecord := ref MSFBytes();
      LRecord.Put(0, 2);
      if (AKind = S_GPROC32) or (AKind = S_GPROC32_ID) then
        LRecord.Put(uint64(S_PROCREF), 2);
      else
        LRecord.Put(uint64(S_LPROCREF), 2);
      end;
      // no name checksum, the module stream offset, the module's number (its index + 1)
      LRecord.Put(0, 4);
      LRecord.Put(uint64(AOffset), 4);
      LRecord.Put(uint64(AModuleIndex + 1), 2);
      LRecord.PutText(ASymbolName);
      LRecord.PadTo(4);
      LRecord.Patch(0, uint64(LRecord.Count - 2), 2);
      LBytes := LRecord.Bytes();
      self.DoGlobal(LBytes, 0, len(LBytes));
    end;

    // Module AIndex's symbol stream: its symbols routed (see the header), each scope's
    // parent and end set, its file checksums and lines, no global refs
    hidden method DoModule(const AIndex: int64);
    var
      LModule: ref PDBModule;
      LLines: ref PDBLines;
      LSymbols: ByteArray;
      // a file's checksum, then a subsection's contents
      LChecksum: ByteArray;
      LOut: ref MSFBytes;
      LScopes: ref Int64List;
      LChecksums: Int64Array;
      LKind: int64;
      LSize: int64;
      LDepth: int64;
      LOffset: int64;
      LOpener: int64;
      LParent: int64;
      LC13: int64;
      LSub: int64;
      LBlock: int64;
      LFirst: int64;
      LCount: int64;
      LAt: int64;
      LL: int64;
      LI: int64;
      LToModule: bool;
      LToGlobals: bool;
    begin
      LModule := self.FInput.Modules[AIndex];
      LSymbols := LModule.Symbols();
      LOut := ref MSFBytes();
      LOut.Put(uint64(CV_SIGNATURE_C13), 4);
      LScopes := ref Int64List();
      LAt := 0;
      while LAt < len(LSymbols) do
        LSize := DoGet(LSymbols, LAt, 2) + 2;
        LKind := DoGet(LSymbols, LAt + 2, 2);
        LDepth := LScopes.Count;
        // lld-link's routing (see the header)
        LToModule := true;
        LToGlobals := false;
        if (LKind = S_GDATA32) or (LKind = S_GTHREAD32) then
          LToModule := false;
          LToGlobals := true;
        else
          if LKind = S_UDT then
            LToModule := LDepth > 0;
            LToGlobals := LDepth = 0;
          else
            if (LKind = S_LDATA32) or (LKind = S_LTHREAD32) then
              LToGlobals := LDepth = 0;
            else
              if LKind = S_CONSTANT then
                LToGlobals := true;
              end;
            end;
          end;
        end;
        if LToModule then
          LOffset := LOut.Count;
          LOut.PutRange(LSymbols, LAt, LSize);
          if CvOpensScope(LKind) then
            LParent := 0;
            if LScopes.Count > 0 then
              LParent := LScopes[LScopes.Count - 1];
            end;
            LOut.Patch(LOffset + ADAM_PDB_SCOPE_PARENT, uint64(LParent), 4);
            LOut.Patch(LOffset + ADAM_PDB_SCOPE_END, 0, 4);
            LScopes.Add(LOffset);
            if DoIsProcedure(LKind) and (LDepth = 0) then
              self.DoProcRef(LKind, DoSymbolName(LSymbols, LAt), LOffset, AIndex);
            end;
          end;
          if CvClosesScope(LKind) then
            if LScopes.Count = 0 then
              raise(ADAM_PDB_FAULT_SCOPE + LModule.ModuleName);
            end;
            LOpener := LScopes.RemoveLast();
            LOut.Patch(LOpener + ADAM_PDB_SCOPE_END, uint64(LOffset), 4);
          end;
        end;
        if LToGlobals then
          self.DoGlobal(LSymbols, LAt, LSize);
        end;
        LAt := LAt + LSize;
      end;
      if LScopes.Count <> 0 then
        raise(ADAM_PDB_FAULT_SCOPE + LModule.ModuleName);
      end;
      self.FSymbolSizes[AIndex] := LOut.Count;
      // The file checksums (each file's /names offset, no checksum), then the lines: each
      // run's code, then one block per run of rows in one file
      LC13 := LOut.Count;
      setlength(LChecksums, len(LModule.Files));
      if len(LModule.Files) > 0 then
        LSub := LOut.Count;
        LOut.Put(uint64(DEBUG_S_FILECHKSMS), 4);
        LOut.Put(0, 4);
        for LI := 0 to len(LModule.Files) - 1 do
          // its name, its checksum's size and kind, the checksum, to a 4-byte end
          LChecksums[LI] := LOut.Count - LSub - 8;
          LChecksum := LModule.Checksums[LI];
          LOut.Put(uint64(self.DoName(LModule.Files[LI])), 4);
          LOut.Put(uint64(len(LChecksum)), 1);
          LOut.Put(uint64(LModule.ChecksumKinds[LI]), 1);
          LOut.PutBytes(LChecksum);
          LOut.PadTo(4);
        end;
        LOut.Patch(LSub + 4, uint64(LOut.Count - LSub - 8), 4);
      end;
      for LL := 0 to LModule.Lines.Count - 1 do
        LLines := LModule.Lines[LL];
        LSub := LOut.Count;
        LOut.Put(uint64(DEBUG_S_LINES), 4);
        LOut.Put(0, 4);
        LOut.Put(uint64(LLines.Offset), 4);
        LOut.Put(uint64(LLines.Section), 2);
        if LLines.HasColumns then
          if len(LLines.ColumnStarts) <> len(LLines.CodeOffsets) then
            raise(ADAM_PDB_FAULT_COLUMNS + LModule.ModuleName);
          end;
          LOut.Put(uint64(CV_LINES_HAVE_COLUMNS), 2);
        else
          LOut.Put(0, 2);
        end;
        LOut.Put(uint64(LLines.CodeSize), 4);
        LFirst := 0;
        while LFirst < len(LLines.CodeOffsets) do
          LCount := 1;
          while (LFirst + LCount < len(LLines.CodeOffsets)) and
            (LLines.FileIndices[LFirst + LCount] = LLines.FileIndices[LFirst]) do
            LCount := LCount + 1;
          end;
          LBlock := ADAM_CV_LINES_BLOCK + LCount * ADAM_CV_LINES_ENTRY;
          if LLines.HasColumns then
            LBlock := LBlock + LCount * ADAM_CV_COLUMN_ENTRY;
          end;
          LOut.Put(uint64(LChecksums[LLines.FileIndices[LFirst]]), 4);
          LOut.Put(uint64(LCount), 4);
          LOut.Put(uint64(LBlock), 4);
          for LI := LFirst to LFirst + LCount - 1 do
            LOut.Put(uint64(LLines.CodeOffsets[LI]), 4);
            LOut.Put(uint64(LLines.LineWords[LI]), 4);
          end;
          // the block's columns after its lines
          if LLines.HasColumns then
            for LI := LFirst to LFirst + LCount - 1 do
              LOut.Put(uint64(LLines.ColumnStarts[LI]), 2);
              LOut.Put(uint64(LLines.ColumnEnds[LI]), 2);
            end;
          end;
          LFirst := LFirst + LCount;
        end;
        LOut.Patch(LSub + 4, uint64(LOut.Count - LSub - 8), 4);
      end;
      // the module's other subsections, each to a 4-byte end
      for LI := 0 to len(LModule.SubsectionKinds) - 1 do
        LChecksum := LModule.Subsections[LI];
        LOut.Put(uint64(LModule.SubsectionKinds[LI]), 4);
        LOut.Put(uint64(len(LChecksum)), 4);
        LOut.PutBytes(LChecksum);
        LOut.PadTo(4);
      end;
      self.FLineSizes[AIndex] := LOut.Count - LC13;
      // no global refs
      LOut.Put(0, 4);
      self.FMSF.SetStream(self.FFirstModuleStream + AIndex, LOut.Bytes());
    end;

    // The string table stream (/names, DoStringTable of every name the streams use)
    hidden method DoNamesStream();
    begin
      self.FMSF.SetStream(self.FNamesStream, self.DoStringTable(self.FNames.Bytes(), self.FNameCount));
    end;

    // A PDB string table of the names ANames holds (the empty one at 0, ANameCount after
    // it, each NUL-ended): header, the names, the hash table (each name's offset at its
    // hash, probing on), the name count; /names and the DBI's EC names are one
    hidden const method DoStringTable(const ANames: ByteArray; const ANameCount: int64): ByteArray;
    var
      LOut: ref MSFBytes;
      LBuckets: Int64Array;
      LBucketCount: int64;
      LSeen: int64;
      LSlot: int64;
      LHash: uint64;
      LAt: int64;
      LText: string;
      LI: int64;
    begin
      // the reference implementation's growth: past 3/4 full, 1.5 times plus 1
      LBucketCount := 1;
      LSeen := 0;
      for LI := 1 to ANameCount do
        LSeen := LSeen + 1;
        if LSeen > LBucketCount * 3 div 4 then
          LBucketCount := LBucketCount * 3 div 2 + 1;
        end;
      end;
      setlength(LBuckets, LBucketCount);
      for LI := 0 to LBucketCount - 1 do
        LBuckets[LI] := 0;
      end;
      // every name, in offset order, at its hash's bucket or the next free one
      LAt := 1;
      while LAt < len(ANames) do
        LText := DoTextAt(ANames, LAt, len(ANames));
        LHash := PDBHashText(LText);
        for LI := 0 to LBucketCount - 1 do
          LSlot := int64((LHash + uint64(LI)) mod uint64(LBucketCount));
          if LBuckets[LSlot] = 0 then
            LBuckets[LSlot] := LAt;
            leave;
          end;
        end;
        LAt := LAt + len(LText) + 1;
      end;
      LOut := ref MSFBytes();
      LOut.Put(uint64(ADAM_PDB_NAMES_SIGNATURE), 4);
      LOut.Put(uint64(ADAM_PDB_NAMES_VERSION), 4);
      LOut.Put(uint64(len(ANames)), 4);
      LOut.PutBytes(ANames);
      LOut.Put(uint64(LBucketCount), 4);
      for LI := 0 to LBucketCount - 1 do
        LOut.Put(uint64(LBuckets[LI]), 4);
      end;
      LOut.Put(uint64(ANameCount), 4);
      return LOut.Bytes();
    end;

    // The symbol records stream (the publics' S_PUB32 records, then the globals), the
    // globals' GSI hash and the publics stream (its header, its GSI hash, its address map)
    hidden method DoSymbolStreams();
    var
      LRecords: ref MSFBytes;
      LGlobalEntries: ref List<GsiEntry>;
      LPublicEntries: ref List<GsiEntry>;
      LAddresses: ref List<AddressEntry>;
      LPublics: ref MSFBytes;
      LGlobals: ByteArray;
      LHash: ByteArray;
      LPublic: PDBPublic;
      LEntry: GsiEntry;
      LAddress: AddressEntry;
      LStart: int64;
      LAt: int64;
      LI: int64;
    begin
      LRecords := ref MSFBytes();
      LPublicEntries := ref List<GsiEntry>();
      LAddresses := ref List<AddressEntry>();
      for LI := 0 to self.FInput.Publics.Count - 1 do
        LPublic := self.FInput.Publics[LI];
        LStart := LRecords.Count;
        LRecords.Put(0, 2);
        LRecords.Put(uint64(S_PUB32), 2);
        if LPublic.IsCode then
          LRecords.Put(uint64(cvpsfFunction), 4);
        else
          LRecords.Put(0, 4);
        end;
        LRecords.Put(uint64(LPublic.Offset), 4);
        LRecords.Put(uint64(LPublic.Section), 2);
        LRecords.PutText(LPublic.SymbolName);
        LRecords.PadTo(4);
        LRecords.Patch(LStart, uint64(LRecords.Count - LStart - 2), 2);
        LEntry.Bucket := 0;
        LEntry.SymbolName := LPublic.SymbolName;
        LEntry.Offset := LStart;
        LPublicEntries.Add(LEntry);
        LAddress.Section := LPublic.Section;
        LAddress.Offset := LPublic.Offset;
        LAddress.SymbolName := LPublic.SymbolName;
        LAddress.RecordOffset := LStart;
        LAddresses.Add(LAddress);
      end;
      // the globals after the publics, each named for its hash
      LGlobalEntries := ref List<GsiEntry>();
      LGlobals := self.FGlobals.Bytes();
      LAt := 0;
      while LAt < len(LGlobals) do
        LEntry.Bucket := 0;
        LEntry.SymbolName := DoSymbolName(LGlobals, LAt);
        LEntry.Offset := LRecords.Count + LAt;
        LGlobalEntries.Add(LEntry);
        LAt := LAt + DoGet(LGlobals, LAt, 2) + 2;
      end;
      LRecords.PutBytes(LGlobals);
      self.FMSF.SetStream(self.FRecordsStream, LRecords.Bytes());
      self.FMSF.SetStream(self.FGlobalsStream, DoGsiHash(LGlobalEntries));
      // The publics: the header, the hash, the address map (record offsets by address)
      LHash := DoGsiHash(LPublicEntries);
      LAddresses.Sort();
      LPublics := ref MSFBytes();
      LPublics.Put(uint64(len(LHash)), 4);
      LPublics.Put(uint64(LAddresses.Count * 4), 4);
      // no thunks, no thunk table, no sections in it
      LPublics.PutZeros(ADAM_PDB_PSI_HEADER_SIZE - 8);
      LPublics.PutBytes(LHash);
      for LI := 0 to LAddresses.Count - 1 do
        LPublics.Put(uint64(LAddresses[LI].RecordOffset), 4);
      end;
      self.FMSF.SetStream(self.FPublicsStream, LPublics.Bytes());
    end;

    // A TPI or IPI stream (stream AStream, its hash stream AHashStream) over ARecords
    // (ACount of them): the header, the records; the hash stream: each record's hash
    // bucket, then a type index offset each time the records pass another 8 KB
    hidden method DoTypeStream(const AStream: int64; const AHashStream: int64;
      const ARecords: ByteArray; const ACount: int64);
    var
      LOut: ref MSFBytes;
      LHashes: ref MSFBytes;
      LOffsets: ref MSFBytes;
      LSize: int64;
      LAt: int64;
      LI: int64;
    begin
      LHashes := ref MSFBytes();
      LOffsets := ref MSFBytes();
      LAt := 0;
      for LI := 0 to ACount - 1 do
        LSize := DoGet(ARecords, LAt, 2) + 2;
        LHashes.Put(DoTypeHash(ARecords, LAt, LSize) mod uint64(ADAM_PDB_TPI_BUCKETS), 4);
        if (LI = 0) or ((LAt + LSize) div ADAM_PDB_TPI_OFFSET_SPAN > LAt div ADAM_PDB_TPI_OFFSET_SPAN) then
          LOffsets.Put(uint64(CV_FIRST_NONPRIM + LI), 4);
          LOffsets.Put(uint64(LAt), 4);
        end;
        LAt := LAt + LSize;
      end;
      LOut := ref MSFBytes();
      LOut.Put(uint64(ADAM_PDB_TPI_VERSION), 4);
      LOut.Put(uint64(ADAM_PDB_TPI_HEADER_SIZE), 4);
      LOut.Put(uint64(CV_FIRST_NONPRIM), 4);
      LOut.Put(uint64(CV_FIRST_NONPRIM + ACount), 4);
      LOut.Put(uint64(len(ARecords)), 4);
      LOut.Put(uint64(AHashStream), 2);
      LOut.Put(uint64(ADAM_PDB_NO_STREAM), 2);
      // hash key size, buckets, then the hash values', type offsets' and adjusters' places
      LOut.Put(4, 4);
      LOut.Put(uint64(ADAM_PDB_TPI_BUCKETS), 4);
      LOut.Put(0, 4);
      LOut.Put(uint64(LHashes.Count), 4);
      LOut.Put(uint64(LHashes.Count), 4);
      LOut.Put(uint64(LOffsets.Count), 4);
      LOut.Put(uint64(LHashes.Count + LOffsets.Count), 4);
      LOut.Put(0, 4);
      LOut.PutBytes(ARecords);
      self.FMSF.SetStream(AStream, LOut.Bytes());
      LHashes.PutBytes(LOffsets.Bytes());
      self.FMSF.SetStream(AHashStream, LHashes.Bytes());
    end;

    // AContribution as a DBI section contribution entry
    hidden const method DoContribution(const AOut: ref MSFBytes; const AContribution: PDBContribution);
    begin
      AOut.Put(uint64(AContribution.Section), 2);
      AOut.Put(0, 2);
      AOut.Put(uint64(AContribution.Offset), 4);
      AOut.Put(uint64(AContribution.Size), 4);
      AOut.Put(uint64(AContribution.Characteristics), 4);
      AOut.Put(uint64(AContribution.ModuleIndex), 2);
      AOut.Put(0, 2);
      // no data or relocation CRC
      AOut.Put(0, 4);
      AOut.Put(0, 4);
    end;

    // The DBI stream: its header, the module infos, the section contributions, the section
    // map, the source file info, no type server map, the EC names (a string table of the
    // empty name alone, as lld-link writes it: a module's PDB file name index 0 reads
    // there), the optional debug header
    hidden method DoDbi();
    var
      LModules: ref MSFBytes;
      LContributions: ref MSFBytes;
      LMap: ref MSFBytes;
      LFiles: ref MSFBytes;
      LFileNames: ref MSFBytes;
      LDebug: ref MSFBytes;
      LOut: ref MSFBytes;
      LEcNames: ByteArray;
      LNoName: ByteArray;
      LSorted: ref List<PDBContribution>;
      LFirsts: Int64Array;
      LFileOffsets: ref StringIdMap;
      LModule: ref PDBModule;
      LRun: PDBContribution;
      LHeaders: ByteArray;
      LTotalFiles: int64;
      LFileOffset: int64;
      LSections: int64;
      LCharacteristics: int64;
      LFlags: int64;
      LM: int64;
      LI: int64;
    begin
      LSorted := ref List<PDBContribution>();
      for LI := 0 to self.FInput.Contributions.Count - 1 do
        LSorted.Add(self.FInput.Contributions[LI]);
      end;
      LSorted.Sort();
      // each module's first contribution (by address), -1 none
      setlength(LFirsts, self.FInput.Modules.Count);
      for LM := 0 to self.FInput.Modules.Count - 1 do
        LFirsts[LM] := -1;
      end;
      for LI := 0 to LSorted.Count - 1 do
        LM := LSorted[LI].ModuleIndex;
        if (LM >= 0) and (LM < len(LFirsts)) and (LFirsts[LM] < 0) then
          LFirsts[LM] := LI;
        end;
      end;
      // The module infos
      LModules := ref MSFBytes();
      for LM := 0 to self.FInput.Modules.Count - 1 do
        LModule := self.FInput.Modules[LM];
        if len(LModule.Files) > 0xFFFF then
          raise(ADAM_PDB_FAULT_LIMIT + IntToStr(len(LModule.Files)) + " files");
        end;
        LModules.Put(0, 4);
        if LFirsts[LM] >= 0 then
          self.DoContribution(LModules, LSorted[LFirsts[LM]]);
        else
          // no contribution: no section
          LRun.Section := ADAM_PDB_NO_STREAM;
          LRun.Offset := 0;
          LRun.Size := 0;
          LRun.Characteristics := 0;
          LRun.ModuleIndex := LM;
          self.DoContribution(LModules, LRun);
        end;
        // flags, its stream, its symbols' and lines' sizes, its file count
        LModules.Put(0, 2);
        LModules.Put(uint64(self.FFirstModuleStream + LM), 2);
        LModules.Put(uint64(self.FSymbolSizes[LM]), 4);
        LModules.Put(0, 4);
        LModules.Put(uint64(self.FLineSizes[LM]), 4);
        LModules.Put(uint64(len(LModule.Files)), 2);
        LModules.Put(0, 2);
        LModules.Put(0, 4);
        LModules.Put(0, 4);
        LModules.Put(0, 4);
        LModules.PutText(LModule.ModuleName);
        LModules.PutText(LModule.ObjectName);
        LModules.PadTo(4);
      end;
      // The section contributions
      LContributions := ref MSFBytes();
      LContributions.Put(uint64(ADAM_PDB_DBI_CONTRIBUTION_VERSION), 4);
      for LI := 0 to LSorted.Count - 1 do
        self.DoContribution(LContributions, LSorted[LI]);
      end;
      // The section map: one entry per image section, then the closing one
      LHeaders := self.FInput.SectionHeaders;
      LSections := len(LHeaders) div IMAGE_SIZEOF_SECTION_HEADER;
      LMap := ref MSFBytes();
      LMap.Put(uint64(LSections + 1), 2);
      LMap.Put(uint64(LSections + 1), 2);
      for LI := 0 to LSections - 1 do
        LCharacteristics := DoGet(LHeaders, LI * IMAGE_SIZEOF_SECTION_HEADER + 36, 4);
        LFlags := ADAM_PDB_SECMAP_SELECTOR;
        if (LCharacteristics & IMAGE_SCN_MEM_READ) <> 0 then
          LFlags := LFlags | ADAM_PDB_SECMAP_READ;
        end;
        if (LCharacteristics & IMAGE_SCN_MEM_WRITE) <> 0 then
          LFlags := LFlags | ADAM_PDB_SECMAP_WRITE;
        end;
        if (LCharacteristics & IMAGE_SCN_MEM_EXECUTE) <> 0 then
          LFlags := LFlags | ADAM_PDB_SECMAP_EXECUTE;
        end;
        if (LCharacteristics & IMAGE_SCN_MEM_16BIT) = 0 then
          LFlags := LFlags | ADAM_PDB_SECMAP_32BIT;
        end;
        // flags, overlay, group, frame (its number), no names, offset 0, its virtual size
        LMap.Put(uint64(LFlags), 2);
        LMap.Put(0, 2);
        LMap.Put(0, 2);
        LMap.Put(uint64(LI + 1), 2);
        LMap.Put(uint64(ADAM_PDB_NO_STREAM), 2);
        LMap.Put(uint64(ADAM_PDB_NO_STREAM), 2);
        LMap.Put(0, 4);
        LMap.Put(uint64(DoGet(LHeaders, LI * IMAGE_SIZEOF_SECTION_HEADER + 8, 4)), 4);
      end;
      LMap.Put(uint64(ADAM_PDB_SECMAP_32BIT | ADAM_PDB_SECMAP_ABSOLUTE), 2);
      LMap.Put(0, 2);
      LMap.Put(0, 2);
      LMap.Put(uint64(LSections + 1), 2);
      LMap.Put(uint64(ADAM_PDB_NO_STREAM), 2);
      LMap.Put(uint64(ADAM_PDB_NO_STREAM), 2);
      LMap.Put(0, 4);
      LMap.Put(0xFFFFFFFF, 4);
      // The source file info: the module count, the file count (16 bits of it), each
      // module's first file and file count, each file's name offset, the names (each once)
      LTotalFiles := 0;
      for LM := 0 to self.FInput.Modules.Count - 1 do
        LTotalFiles := LTotalFiles + len(self.FInput.Modules[LM].Files);
      end;
      LFiles := ref MSFBytes();
      LFiles.Put(uint64(self.FInput.Modules.Count), 2);
      LFiles.Put(uint64(LTotalFiles & 0xFFFF), 2);
      LFileOffset := 0;
      for LM := 0 to self.FInput.Modules.Count - 1 do
        LFiles.Put(uint64(LFileOffset & 0xFFFF), 2);
        LFileOffset := LFileOffset + len(self.FInput.Modules[LM].Files);
      end;
      for LM := 0 to self.FInput.Modules.Count - 1 do
        LFiles.Put(uint64(len(self.FInput.Modules[LM].Files)), 2);
      end;
      LFileNames := ref MSFBytes();
      LFileOffsets := ref StringIdMap(0);
      for LM := 0 to self.FInput.Modules.Count - 1 do
        LModule := self.FInput.Modules[LM];
        for LI := 0 to len(LModule.Files) - 1 do
          LFileOffset := LFileOffsets.Find(LModule.Files[LI]);
          if LFileOffset = 0 then
            LFileOffset := LFileNames.Count + 1;
            LFileNames.PutText(LModule.Files[LI]);
            LFileOffsets.Put(LModule.Files[LI], LFileOffset);
          end;
          LFiles.Put(uint64(LFileOffset - 1), 4);
        end;
      end;
      LFiles.PutBytes(LFileNames.Bytes());
      LFiles.PadTo(4);
      // The EC names: the empty name alone
      setlength(LNoName, 1);
      LNoName[0] := 0;
      LEcNames := self.DoStringTable(LNoName, 0);
      // The optional debug header: only the section headers stream
      LDebug := ref MSFBytes();
      for LI := 0 to ADAM_PDB_DBI_DEBUG_STREAMS - 1 do
        if LI = ADAM_PDB_DBI_DEBUG_SECTION_HEADERS then
          LDebug.Put(uint64(self.FHeadersStream), 2);
        else
          LDebug.Put(uint64(ADAM_PDB_NO_STREAM), 2);
        end;
      end;
      // The header, then the substreams in their order
      LOut := ref MSFBytes();
      LOut.Put(uint64(ADAM_PDB_DBI_SIGNATURE), 4);
      LOut.Put(uint64(ADAM_PDB_DBI_VERSION), 4);
      LOut.Put(uint64(self.FInput.Age), 4);
      LOut.Put(uint64(self.FGlobalsStream), 2);
      LOut.Put(uint64(ADAM_PDB_DBI_BUILD), 2);
      LOut.Put(uint64(self.FPublicsStream), 2);
      LOut.Put(0, 2);
      LOut.Put(uint64(self.FRecordsStream), 2);
      LOut.Put(0, 2);
      LOut.Put(uint64(LModules.Count), 4);
      LOut.Put(uint64(LContributions.Count), 4);
      LOut.Put(uint64(LMap.Count), 4);
      LOut.Put(uint64(LFiles.Count), 4);
      // no type server map, no MFC type server, the optional header, the EC names
      LOut.Put(0, 4);
      LOut.Put(0, 4);
      LOut.Put(uint64(LDebug.Count), 4);
      LOut.Put(uint64(len(LEcNames)), 4);
      LOut.Put(0, 2);
      LOut.Put(uint64(self.FInput.Machine), 2);
      LOut.Put(0, 4);
      LOut.PutBytes(LModules.Bytes());
      LOut.PutBytes(LContributions.Bytes());
      LOut.PutBytes(LMap.Bytes());
      LOut.PutBytes(LFiles.Bytes());
      LOut.PutBytes(LEcNames);
      LOut.PutBytes(LDebug.Bytes());
      self.FMSF.SetStream(ADAM_PDB_STREAM_DBI, LOut.Bytes());
    end;

    // The PDB info stream: version, signature, age, GUID, the named stream map (/names
    // alone: its 16-bit hash's bucket of a table of 8), feature VC140
    hidden method DoInfo();
    var
      LOut: ref MSFBytes;
      LBucket: int64;
    begin
      LOut := ref MSFBytes();
      LOut.Put(uint64(ADAM_PDB_INFO_VERSION), 4);
      LOut.Put(uint64(self.FInput.Signature & 0xFFFFFFFF), 4);
      LOut.Put(uint64(self.FInput.Age), 4);
      LOut.PutBytes(self.FInput.GUID);
      // the names' buffer
      LOut.Put(uint64(len(ADAM_PDB_NAMES_STREAM) + 1), 4);
      LOut.PutText(ADAM_PDB_NAMES_STREAM);
      // the hash table: its size and capacity, the present bits (one word), no deleted
      // bits, the one entry (name offset, stream)
      LBucket := int64((PDBHashText(ADAM_PDB_NAMES_STREAM) & ADAM_PDB_NAMED_HASH_MASK) mod
        uint64(ADAM_PDB_NAMED_CAPACITY));
      LOut.Put(1, 4);
      LOut.Put(uint64(ADAM_PDB_NAMED_CAPACITY), 4);
      LOut.Put(1, 4);
      LOut.Put(uint64(1 shl LBucket), 4);
      LOut.Put(0, 4);
      LOut.Put(0, 4);
      LOut.Put(uint64(self.FNamesStream), 4);
      LOut.Put(uint64(ADAM_PDB_FEATURE_VC140), 4);
      self.FMSF.SetStream(ADAM_PDB_STREAM_INFO, LOut.Bytes());
    end;

    // Every stream made; the MSF writer holding them
    method Build(): ref MSFWriter;
    var
      LI: int64;
    begin
      for LI := 0 to self.FInput.Modules.Count - 1 do
        self.DoModule(LI);
      end;
      self.DoNamesStream();
      self.DoSymbolStreams();
      self.DoTypeStream(ADAM_PDB_STREAM_TPI, self.FTpiHash, self.FInput.TypeBytes(),
        self.FInput.TypeCount());
      self.DoTypeStream(ADAM_PDB_STREAM_IPI, self.FIpiHash, self.FInput.IdBytes(),
        self.FInput.IdCount());
      self.DoDbi();
      self.DoInfo();
      self.FMSF.SetStream(self.FHeadersStream, self.FInput.SectionHeaders);
      return self.FMSF;
    end;
  end;

// AInput's streams in an MSF writer of ABlockSize blocks (see the header)
public func PDBStreams(const AInput: ref PDBInput; const ABlockSize: int64): ref MSFWriter;
var
  LBuilder: ref PDBBuilder;
begin
  LBuilder := ref PDBBuilder(AInput, ABlockSize);
  return LBuilder.Build();
end;

// AInput as a PDB file of ADAM_MSF_BLOCK_SIZE blocks
public func WritePDB(const AInput: ref PDBInput): ByteArray;
begin
  return PDBStreams(AInput, ADAM_MSF_BLOCK_SIZE).Write();
end;

// The PDB info stream of AWriter (PDBStreams') given the signature ASignature and the GUID
// AGUID in place: the identity a linker learns only once the image and the other streams
// are made (a hash of their contents), with nothing else rebuilt; raises for a GUID not 16
// bytes
public func PDBSetIdentity(const AWriter: ref MSFWriter; const ASignature: int64;
  const AGUID: ByteArray);
var
  LInfo: ByteArray;
  LI: int64;
begin
  if len(AGUID) <> 16 then
    raise(ADAM_PDB_FAULT_GUID + IntToStr(len(AGUID)));
  end;
  LInfo := AWriter.StreamAt(ADAM_PDB_STREAM_INFO);
  // version 4, signature 4, age 4, then the GUID (DoInfo)
  PutLe(LInfo, 4, uint64(ASignature & 0xFFFFFFFF), 4);
  for LI := 0 to 15 do
    LInfo[12 + LI] := AGUID[LI];
  end;
  AWriter.SetStream(ADAM_PDB_STREAM_INFO, LInfo);
end;

// A symbol kind as the text names it (its number for one it does not name)
func DoKindText(const AKind: int64): string;
begin
  if AKind = S_GPROC32 then
    return "gproc";
  end;
  if AKind = S_LPROC32 then
    return "lproc";
  end;
  if AKind = S_GPROC32_ID then
    return "gprocid";
  end;
  if AKind = S_LPROC32_ID then
    return "lprocid";
  end;
  if AKind = S_END then
    return "end";
  end;
  if AKind = S_PROC_ID_END then
    return "procidend";
  end;
  if AKind = S_BLOCK32 then
    return "block";
  end;
  if AKind = S_THUNK32 then
    return "thunk";
  end;
  if AKind = S_FRAMEPROC then
    return "frameproc";
  end;
  if AKind = S_REGREL32 then
    return "regrel";
  end;
  if AKind = S_LOCAL then
    return "local";
  end;
  if AKind = S_DEFRANGE_FRAMEPOINTER_REL_FULL_SCOPE then
    return "defrange";
  end;
  if AKind = S_OBJNAME then
    return "objname";
  end;
  if AKind = S_COMPILE3 then
    return "compile";
  end;
  if AKind = S_UDT then
    return "udt";
  end;
  if AKind = S_GDATA32 then
    return "gdata";
  end;
  if AKind = S_LDATA32 then
    return "ldata";
  end;
  if AKind = S_GTHREAD32 then
    return "gthread";
  end;
  if AKind = S_LTHREAD32 then
    return "lthread";
  end;
  if AKind = S_CONSTANT then
    return "constant";
  end;
  if AKind = S_PUB32 then
    return "pub";
  end;
  if AKind = S_PROCREF then
    return "procref";
  end;
  if AKind = S_LPROCREF then
    return "lprocref";
  end;
  return "0x" + IntToHex(uint64(AKind), 4);
end;

// AValue as the text writes a number: 0x and its hex digits
func DoHex(const AValue: int64): string;
begin
  return "0x" + IntToHex(uint64(AValue), 1);
end;

// The /names text at offset AOffset of a string table stream ANames ("?" past it)
func DoNameAt(const ANames: ByteArray; const AOffset: int64): string;
begin
  if (len(ANames) < 12) or (AOffset < 0) or (AOffset >= DoGet(ANames, 8, 4)) then
    return "?";
  end;
  return DoTextAt(ANames, 12 + AOffset, 12 + DoGet(ANames, 8, 4));
end;

// True when the GSI hash table AHash finds the record at AOffset of the symbol records
// ARecords by its name, as a reader looks it up (its bucket's bit, its chain by the bucket
// starts); AOrdered false when a chain is out of PDBCompareNames order
func DoGsiFinds(const AHash: ByteArray; const ARecords: ByteArray; const AOffset: int64): bool;
var
  LText: string;
  LCount: int64;
  LBitmapAt: int64;
  LStartsAt: int64;
  LStarts: int64;
  LBucket: int64;
  LBefore: int64;
  LFirst: int64;
  LLast: int64;
  LAt: int64;
  LI: int64;
begin
  LText := DoSymbolName(ARecords, AOffset);
  LCount := DoGet(AHash, 8, 4) div 8;
  LBitmapAt := 16 + LCount * 8;
  LStartsAt := LBitmapAt + ADAM_PDB_GSI_BITMAP_WORDS * 4;
  LStarts := DoGet(AHash, 12, 4) div 4 - ADAM_PDB_GSI_BITMAP_WORDS;
  LBucket := DoGsiBucket(LText);
  if (DoGet(AHash, LBitmapAt + (LBucket div 32) * 4, 4) & (1 shl (LBucket mod 32))) = 0 then
    return false;
  end;
  // the bucket's chain is the LBefore-th: one per set bit below its own
  LBefore := 0;
  for LI := 0 to LBucket - 1 do
    if (DoGet(AHash, LBitmapAt + (LI div 32) * 4, 4) & (1 shl (LI mod 32))) <> 0 then
      LBefore := LBefore + 1;
    end;
  end;
  LFirst := DoGet(AHash, LStartsAt + LBefore * 4, 4) div ADAM_PDB_GSI_RECORD_SPAN;
  LLast := LCount;
  if LBefore + 1 < LStarts then
    LLast := DoGet(AHash, LStartsAt + (LBefore + 1) * 4, 4) div ADAM_PDB_GSI_RECORD_SPAN;
  end;
  for LI := LFirst to LLast - 1 do
    LAt := DoGet(AHash, 16 + LI * 8, 4) - 1;
    if (LAt = AOffset) and (DoSymbolName(ARecords, LAt) = LText) then
      return true;
    end;
  end;
  return false;
end;

// True when every chain of the GSI hash table AHash is in the order a reader's search
// relies on (each record's name not below the one before it in its bucket)
func DoGsiOrdered(const AHash: ByteArray; const ARecords: ByteArray): bool;
var
  LCount: int64;
  LPrevious: string;
  LText: string;
  LBucket: int64;
  LPreviousBucket: int64;
  LI: int64;
begin
  LCount := DoGet(AHash, 8, 4) div 8;
  LPrevious := "";
  LPreviousBucket := -1;
  for LI := 0 to LCount - 1 do
    LText := DoSymbolName(ARecords, DoGet(AHash, 16 + LI * 8, 4) - 1);
    LBucket := DoGsiBucket(LText);
    if LBucket < LPreviousBucket then
      return false;
    end;
    if (LBucket = LPreviousBucket) and (PDBCompareNames(LPrevious, LText) > 0) then
      return false;
    end;
    LPrevious := LText;
    LPreviousBucket := LBucket;
  end;
  return true;
end;

// A GSI hash table's records as lines under ALabel ("global" / "public"): the count, the
// order check, then per record its offset, kind, name and whether a lookup finds it
func DoGsiText(const ALabel: string; const AHash: ByteArray; const ARecords: ByteArray;
  const AText: ref TextBuilder);
var
  LCount: int64;
  LAt: int64;
  LFound: string;
  LOrder: string;
  LI: int64;
begin
  if (len(AHash) < 16) or (DoGet(AHash, 0, 4) <> ADAM_PDB_GSI_SIGNATURE) or
    (DoGet(AHash, 4, 4) <> ADAM_PDB_GSI_VERSION) then
    AText.Add("  no gsi header\n");
    return;
  end;
  LCount := DoGet(AHash, 8, 4) div 8;
  LOrder := "out of order";
  if DoGsiOrdered(AHash, ARecords) then
    LOrder := "in order";
  end;
  AText.Add("  hash records " + IntToStr(LCount) + " chains " +
    IntToStr(DoGet(AHash, 12, 4) div 4 - ADAM_PDB_GSI_BITMAP_WORDS) + " " + LOrder + "\n");
  for LI := 0 to LCount - 1 do
    LAt := DoGet(AHash, 16 + LI * 8, 4) - 1;
    LFound := "missing";
    if DoGsiFinds(AHash, ARecords, LAt) then
      LFound := "found";
    end;
    AText.Add("  " + ALabel + " +" + DoHex(LAt) + " " + DoKindText(DoGet(ARecords, LAt + 2, 2)) +
      " '" + DoSymbolName(ARecords, LAt) + "' " + LFound + "\n");
  end;
end;

// The details of the symbol record at AAt of ABytes the text adds after its kind and name:
// a scope's parent and end, a reference's module and offset, a public's or a variable's
// section and offset, a type index where the record names one
func DoSymbolDetail(const ABytes: ByteArray; const AAt: int64): string;
var
  LKind: int64;
begin
  LKind := DoGet(ABytes, AAt + 2, 2);
  if CvOpensScope(LKind) then
    return " parent +" + DoHex(DoGet(ABytes, AAt + ADAM_PDB_SCOPE_PARENT, 4)) + " end +" +
      DoHex(DoGet(ABytes, AAt + ADAM_PDB_SCOPE_END, 4));
  end;
  if (LKind = S_PROCREF) or (LKind = S_LPROCREF) then
    return " module " + IntToStr(DoGet(ABytes, AAt + 12, 2)) + " at +" + DoHex(DoGet(ABytes, AAt + 8, 4));
  end;
  if LKind = S_PUB32 then
    return " flags " + IntToStr(DoGet(ABytes, AAt + 4, 4)) + " at " +
      IntToStr(DoGet(ABytes, AAt + 12, 2)) + ":" + DoHex(DoGet(ABytes, AAt + 8, 4));
  end;
  if (LKind = S_GDATA32) or (LKind = S_LDATA32) or (LKind = S_GTHREAD32) or
    (LKind = S_LTHREAD32) then
    return " type " + DoHex(DoGet(ABytes, AAt + 4, 4)) + " at " +
      IntToStr(DoGet(ABytes, AAt + 12, 2)) + ":" + DoHex(DoGet(ABytes, AAt + 8, 4));
  end;
  if LKind = S_UDT then
    return " type " + DoHex(DoGet(ABytes, AAt + 4, 4));
  end;
  return "";
end;

// A TPI or IPI stream (AStream) as lines under ALabel: its header, each record (index,
// leaf, size, its stored hash bucket checked against the record's), the type index offsets
func DoTypesText(const ALabel: string; const AReader: ref MSFReader; const AStream: int64;
  const AText: ref TextBuilder);
var
  LBytes: ByteArray;
  LHashes: ByteArray;
  LFirst: int64;
  LLast: int64;
  LHashStream: int64;
  LOffsetsAt: int64;
  LOffsetsSize: int64;
  LSize: int64;
  LStored: int64;
  LCheck: string;
  LAt: int64;
  LI: int64;
begin
  LBytes := AReader.Stream(AStream);
  if (len(LBytes) < ADAM_PDB_TPI_HEADER_SIZE) or (DoGet(LBytes, 0, 4) <> ADAM_PDB_TPI_VERSION) then
    AText.Add(ALabel + " no header\n");
    return;
  end;
  LFirst := DoGet(LBytes, 8, 4);
  LLast := DoGet(LBytes, 12, 4);
  LHashStream := DoGet(LBytes, 20, 2);
  AText.Add(ALabel + " version " + IntToStr(DoGet(LBytes, 0, 4)) + " header " +
    IntToStr(DoGet(LBytes, 4, 4)) + " types " + DoHex(LFirst) + ".." + DoHex(LLast) + " bytes " +
    IntToStr(DoGet(LBytes, 16, 4)) + " hash stream " + IntToStr(LHashStream) + " aux " +
    DoHex(DoGet(LBytes, 22, 2)) + " key " + IntToStr(DoGet(LBytes, 24, 4)) + " buckets " +
    DoHex(DoGet(LBytes, 28, 4)) + "\n");
  LHashes := AReader.Stream(LHashStream);
  LAt := DoGet(LBytes, 4, 4);
  for LI := 0 to LLast - LFirst - 1 do
    LSize := DoGet(LBytes, LAt, 2) + 2;
    LCheck := "no hash";
    if DoGet(LBytes, 32, 4) + LI * 4 + 4 <= len(LHashes) then
      LStored := DoGet(LHashes, DoGet(LBytes, 32, 4) + LI * 4, 4);
      LCheck := "hash " + DoHex(LStored);
      if uint64(LStored) = DoTypeHash(LBytes, LAt, LSize) mod uint64(ADAM_PDB_TPI_BUCKETS) then
        LCheck := LCheck + " ok";
      else
        LCheck := LCheck + " differs";
      end;
    end;
    AText.Add("  type " + DoHex(LFirst + LI) + " leaf " + DoHex(DoGet(LBytes, LAt + 2, 2)) +
      " bytes " + IntToStr(LSize) + " " + LCheck + "\n");
    LAt := LAt + LSize;
  end;
  LOffsetsAt := DoGet(LBytes, 40, 4);
  LOffsetsSize := DoGet(LBytes, 44, 4);
  for LI := 0 to LOffsetsSize div 8 - 1 do
    AText.Add("  offset " + DoHex(DoGet(LHashes, LOffsetsAt + LI * 8, 4)) + " at " +
      IntToStr(DoGet(LHashes, LOffsetsAt + LI * 8 + 4, 4)) + "\n");
  end;
  AText.Add("  adjusters " + IntToStr(DoGet(LBytes, 52, 4)) + "\n");
end;

// Module stream AStream's content as lines (ANames the string table stream): its
// signature, its symbols (offset, kind, name, details), its C13 subsections (checksums by
// file name, lines by file), its global refs size
func DoModuleText(const AReader: ref MSFReader; const AStream: int64; const ASymbols: int64;
  const ALines: int64; const ANames: ByteArray; const AText: ref TextBuilder);
var
  LBytes: ByteArray;
  LChecksums: int64;
  LKind: int64;
  LSize: int64;
  LEnd: int64;
  LBlock: int64;
  LCount: int64;
  LAt: int64;
  LI: int64;
begin
  LBytes := AReader.Stream(AStream);
  if (len(LBytes) < ASymbols + ALines + 4) or (ASymbols < 4) then
    AText.Add("  stream too short\n");
    return;
  end;
  AText.Add("  signature " + IntToStr(DoGet(LBytes, 0, 4)) + "\n");
  LAt := 4;
  while LAt < ASymbols do
    LSize := DoGet(LBytes, LAt, 2) + 2;
    LKind := DoGet(LBytes, LAt + 2, 2);
    AText.Add("  sym +" + DoHex(LAt) + " " + DoKindText(LKind));
    if DoSymbolName(LBytes, LAt) <> "" then
      AText.Add(" '" + DoSymbolName(LBytes, LAt) + "'");
    end;
    AText.Add(DoSymbolDetail(LBytes, LAt) + "\n");
    LAt := LAt + LSize;
  end;
  // the C13 subsections: the checksums found first (the lines name a file by its entry)
  LChecksums := -1;
  LAt := ASymbols;
  while LAt + 8 <= ASymbols + ALines do
    if DoGet(LBytes, LAt, 4) = DEBUG_S_FILECHKSMS then
      LChecksums := LAt + 8;
    end;
    LAt := AlignUp(LAt + 8 + DoGet(LBytes, LAt + 4, 4), 4);
  end;
  LAt := ASymbols;
  while LAt + 8 <= ASymbols + ALines do
    LKind := DoGet(LBytes, LAt, 4);
    LEnd := LAt + 8 + DoGet(LBytes, LAt + 4, 4);
    if LKind = DEBUG_S_FILECHKSMS then
      LI := LAt + 8;
      while LI < LEnd do
        AText.Add("  checksum +" + DoHex(LI - LAt - 8) + " '" + DoNameAt(ANames, DoGet(LBytes, LI, 4)) +
          "' kind " + IntToStr(DoGet(LBytes, LI + 5, 1)) + "\n");
        LI := LI + AlignUp(6 + DoGet(LBytes, LI + 4, 1), 4);
      end;
    else
      if LKind = DEBUG_S_LINES then
        AText.Add("  lines at " + IntToStr(DoGet(LBytes, LAt + 12, 2)) + ":" +
          DoHex(DoGet(LBytes, LAt + 8, 4)) + " size " + DoHex(DoGet(LBytes, LAt + 16, 4)) + "\n");
        LBlock := LAt + 8 + ADAM_CV_LINES_HEADER;
        while LBlock < LEnd do
          LCount := DoGet(LBytes, LBlock + 4, 4);
          if LChecksums >= 0 then
            AText.Add("    file '" + DoNameAt(ANames, DoGet(LBytes, LChecksums + DoGet(LBytes, LBlock, 4), 4)) +
              "' count " + IntToStr(LCount) + "\n");
          else
            AText.Add("    file ? count " + IntToStr(LCount) + "\n");
          end;
          for LI := 0 to LCount - 1 do
            AText.Add("      +" + DoHex(DoGet(LBytes, LBlock + 12 + LI * 8, 4)) + " line " +
              IntToStr(DoGet(LBytes, LBlock + 16 + LI * 8, 4) & ADAM_CV_LINE_MASK) + "\n");
          end;
          LBlock := LBlock + DoGet(LBytes, LBlock + 8, 4);
        end;
      else
        AText.Add("  subsection " + DoHex(LKind) + "\n");
      end;
    end;
    LAt := AlignUp(LEnd, 4);
  end;
  AText.Add("  globalrefs " + IntToStr(DoGet(LBytes, ASymbols + ALines, 4)) + "\n");
end;

// True when the named stream map at AAt of the info stream AInfo finds AText as a reader
// does (its 16-bit hash's bucket, probing on); its stream in AStream
func DoNamedFinds(const AInfo: ByteArray; const ABuffer: int64; const ATable: int64;
  const AText: string; var AStream: int64): bool;
var
  LCapacity: int64;
  LWords: int64;
  LEntries: int64;
  LSlot: int64;
  LBefore: int64;
  LHash: uint64;
  LI: int64;
  LJ: int64;
begin
  LCapacity := DoGet(AInfo, ATable + 4, 4);
  LWords := DoGet(AInfo, ATable + 8, 4);
  LEntries := ATable + 12 + LWords * 4 + 4 + DoGet(AInfo, ATable + 12 + LWords * 4, 4) * 4;
  LHash := PDBHashText(AText) & ADAM_PDB_NAMED_HASH_MASK;
  for LI := 0 to LCapacity - 1 do
    LSlot := int64((LHash + uint64(LI)) mod uint64(LCapacity));
    if (LSlot div 32 >= LWords) or
      ((DoGet(AInfo, ATable + 12 + (LSlot div 32) * 4, 4) & (1 shl (LSlot mod 32))) = 0) then
      return false;
    end;
    LBefore := 0;
    for LJ := 0 to LSlot - 1 do
      if (DoGet(AInfo, ATable + 12 + (LJ div 32) * 4, 4) & (1 shl (LJ mod 32))) <> 0 then
        LBefore := LBefore + 1;
      end;
    end;
    if DoTextAt(AInfo, ABuffer + DoGet(AInfo, LEntries + LBefore * 8, 4), len(AInfo)) = AText then
      AStream := DoGet(AInfo, LEntries + LBefore * 8 + 4, 4);
      return true;
    end;
  end;
  return false;
end;

// True when the string table stream ANames finds the name at AOffset by its hash
func DoNamesFinds(const ANames: ByteArray; const AOffset: int64): bool;
var
  LTable: int64;
  LBuckets: int64;
  LSlot: int64;
  LHash: uint64;
  LI: int64;
begin
  LTable := 12 + DoGet(ANames, 8, 4);
  LBuckets := DoGet(ANames, LTable, 4);
  LHash := PDBHashText(DoNameAt(ANames, AOffset));
  for LI := 0 to LBuckets - 1 do
    LSlot := int64((LHash + uint64(LI)) mod uint64(LBuckets));
    if DoGet(ANames, LTable + 4 + LSlot * 4, 4) = 0 then
      return false;
    end;
    if DoGet(ANames, LTable + 4 + LSlot * 4, 4) = AOffset then
      return true;
    end;
  end;
  return false;
end;

// The 16 GUID bytes at AAt as 32 hex digits, in file order
func DoGUIDText(const ABytes: ByteArray; const AAt: int64): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  for LI := 0 to 15 do
    LText := LText + IntToHex(uint64(ABytes[AAt + LI]), 2);
  end;
  return LText;
end;

// A PDB file as text (see the header)
public func PDBText(const AFile: ByteArray): string;
var
  LText: ref TextBuilder;
  LReader: ref MSFReader;
  LInfo: ByteArray;
  LNames: ByteArray;
  LDbi: ByteArray;
  LRecords: ByteArray;
  LPublics: ByteArray;
  LHeaders: ByteArray;
  LHash: ByteArray;
  LModuleNames: StringArray;
  LModuleStreams: Int64Array;
  LModuleSymbols: Int64Array;
  LModuleLines: Int64Array;
  LBuffer: int64;
  LTable: int64;
  LNamesStream: int64;
  LGlobalsStream: int64;
  LPublicsStream: int64;
  LRecordsStream: int64;
  LHeadersStream: int64;
  LModules: int64;
  LModuleCount: int64;
  LContributionsAt: int64;
  LMapAt: int64;
  LFilesAt: int64;
  LDebugAt: int64;
  LFileTexts: int64;
  LFileOffsets: int64;
  LFirstFile: int64;
  LFileCount: int64;
  LAt: int64;
  LEnd: int64;
  LCount: int64;
  LFound: string;
  LM: int64;
  LI: int64;
begin
  LText := ref TextBuilder();
  LReader := ref MSFReader(AFile);
  LText.Add(MSFText(LReader));
  if not LReader.IsRead() then
    return LText.Text();
  end;
  // The PDB info stream and its named stream map
  LInfo := LReader.Stream(ADAM_PDB_STREAM_INFO);
  if (len(LInfo) < 32) or (DoGet(LInfo, 0, 4) <> ADAM_PDB_INFO_VERSION) then
    LText.Add("info no header\n");
    return LText.Text();
  end;
  LText.Add("info version " + IntToStr(DoGet(LInfo, 0, 4)) + " signature " +
    DoHex(DoGet(LInfo, 4, 4)) + " age " + IntToStr(DoGet(LInfo, 8, 4)) + " guid " +
    DoGUIDText(LInfo, 12) + "\n");
  // the named stream map: its buffer's size at 28, the buffer, then its hash table
  LBuffer := 32;
  LTable := LBuffer + DoGet(LInfo, 28, 4);
  LNamesStream := -1;
  if DoNamedFinds(LInfo, LBuffer, LTable, ADAM_PDB_NAMES_STREAM, LNamesStream) then
    LText.Add("  named '" + ADAM_PDB_NAMES_STREAM + "' stream " + IntToStr(LNamesStream) + " found\n");
  else
    LText.Add("  named '" + ADAM_PDB_NAMES_STREAM + "' missing\n");
  end;
  LText.Add("  named count " + IntToStr(DoGet(LInfo, LTable, 4)) + " capacity " +
    IntToStr(DoGet(LInfo, LTable + 4, 4)) + "\n");
  // the features after the table's entries
  LAt := LTable + 8;
  LAt := LAt + 4 + DoGet(LInfo, LAt, 4) * 4;
  LAt := LAt + 4 + DoGet(LInfo, LAt, 4) * 4;
  LAt := LAt + DoGet(LInfo, LTable, 4) * 8;
  while LAt + 4 <= len(LInfo) do
    LText.Add("  feature " + IntToStr(DoGet(LInfo, LAt, 4)) + "\n");
    LAt := LAt + 4;
  end;
  // The string table
  LNames := LReader.Stream(LNamesStream);
  if (len(LNames) < 12) or (DoGet(LNames, 0, 4) <> ADAM_PDB_NAMES_SIGNATURE) then
    LText.Add("names no header\n");
  else
    LTable := 12 + DoGet(LNames, 8, 4);
    LText.Add("names version " + IntToStr(DoGet(LNames, 4, 4)) + " bytes " +
      IntToStr(DoGet(LNames, 8, 4)) + " buckets " + IntToStr(DoGet(LNames, LTable, 4)) +
      " count " + IntToStr(DoGet(LNames, LTable + 4 + DoGet(LNames, LTable, 4) * 4, 4)) + "\n");
    LAt := 1;
    while LAt < DoGet(LNames, 8, 4) do
      LFound := "missing";
      if DoNamesFinds(LNames, LAt) then
        LFound := "found";
      end;
      LText.Add("  name +" + DoHex(LAt) + " '" + DoNameAt(LNames, LAt) + "' " + LFound + "\n");
      LAt := LAt + len(DoNameAt(LNames, LAt)) + 1;
    end;
  end;
  // TPI and IPI
  DoTypesText("tpi", LReader, ADAM_PDB_STREAM_TPI, LText);
  DoTypesText("ipi", LReader, ADAM_PDB_STREAM_IPI, LText);
  // DBI
  LDbi := LReader.Stream(ADAM_PDB_STREAM_DBI);
  if (len(LDbi) < ADAM_PDB_DBI_HEADER_SIZE) or (DoGet(LDbi, 4, 4) <> ADAM_PDB_DBI_VERSION) then
    LText.Add("dbi no header\n");
    return LText.Text();
  end;
  LGlobalsStream := DoGet(LDbi, 12, 2);
  LPublicsStream := DoGet(LDbi, 16, 2);
  LRecordsStream := DoGet(LDbi, 20, 2);
  LText.Add("dbi version " + IntToStr(DoGet(LDbi, 4, 4)) + " age " + IntToStr(DoGet(LDbi, 8, 4)) +
    " build " + DoHex(DoGet(LDbi, 14, 2)) + " machine " + DoHex(DoGet(LDbi, 58, 2)) +
    " globals " + IntToStr(LGlobalsStream) + " publics " + IntToStr(LPublicsStream) + " records " +
    IntToStr(LRecordsStream) + "\n");
  LModules := ADAM_PDB_DBI_HEADER_SIZE;
  LContributionsAt := LModules + DoGet(LDbi, 24, 4);
  LMapAt := LContributionsAt + DoGet(LDbi, 28, 4);
  LFilesAt := LMapAt + DoGet(LDbi, 32, 4);
  LDebugAt := LFilesAt + DoGet(LDbi, 36, 4) + DoGet(LDbi, 40, 4) + DoGet(LDbi, 52, 4);
  // the module infos
  LModuleCount := 0;
  setlength(LModuleNames, 0);
  setlength(LModuleStreams, 0);
  setlength(LModuleSymbols, 0);
  setlength(LModuleLines, 0);
  LAt := LModules;
  while LAt < LContributionsAt do
    setlength(LModuleNames, LModuleCount + 1);
    setlength(LModuleStreams, LModuleCount + 1);
    setlength(LModuleSymbols, LModuleCount + 1);
    setlength(LModuleLines, LModuleCount + 1);
    LModuleNames[LModuleCount] := DoTextAt(LDbi, LAt + ADAM_PDB_DBI_MODULE_SIZE, LContributionsAt);
    LModuleStreams[LModuleCount] := DoGet(LDbi, LAt + 34, 2);
    LModuleSymbols[LModuleCount] := DoGet(LDbi, LAt + 36, 4);
    LModuleLines[LModuleCount] := DoGet(LDbi, LAt + 44, 4);
    LEnd := LAt + ADAM_PDB_DBI_MODULE_SIZE + len(LModuleNames[LModuleCount]) + 1;
    LText.Add("  module " + IntToStr(LModuleCount) + " '" + LModuleNames[LModuleCount] +
      "' object '" + DoTextAt(LDbi, LEnd, LContributionsAt) + "' stream " +
      IntToStr(LModuleStreams[LModuleCount]) + " symbols " + IntToStr(LModuleSymbols[LModuleCount]) +
      " lines " + IntToStr(LModuleLines[LModuleCount]) + " files " +
      IntToStr(DoGet(LDbi, LAt + 48, 2)) + " first " + IntToStr(DoGet(LDbi, LAt + 4, 2)) + ":" +
      DoHex(DoGet(LDbi, LAt + 8, 4)) + " size " + DoHex(DoGet(LDbi, LAt + 12, 4)) + "\n");
    LEnd := LEnd + len(DoTextAt(LDbi, LEnd, LContributionsAt)) + 1;
    LAt := AlignUp(LEnd, 4);
    LModuleCount := LModuleCount + 1;
  end;
  // the section contributions
  LText.Add("  contributions version " + DoHex(DoGet(LDbi, LContributionsAt, 4)) + "\n");
  LAt := LContributionsAt + 4;
  while LAt + ADAM_PDB_DBI_CONTRIBUTION_SIZE <= LMapAt do
    LText.Add("  contribution " + IntToStr(DoGet(LDbi, LAt, 2)) + ":" + DoHex(DoGet(LDbi, LAt + 4, 4)) +
      " size " + DoHex(DoGet(LDbi, LAt + 8, 4)) + " characteristics " +
      DoHex(DoGet(LDbi, LAt + 12, 4)) + " module " + IntToStr(DoGet(LDbi, LAt + 16, 2)) + "\n");
    LAt := LAt + ADAM_PDB_DBI_CONTRIBUTION_SIZE;
  end;
  // the section map
  LCount := DoGet(LDbi, LMapAt, 2);
  LText.Add("  secmap count " + IntToStr(LCount) + " log " + IntToStr(DoGet(LDbi, LMapAt + 2, 2)) + "\n");
  for LI := 0 to LCount - 1 do
    LAt := LMapAt + 4 + LI * ADAM_PDB_SECMAP_ENTRY_SIZE;
    LText.Add("  secmap flags " + DoHex(DoGet(LDbi, LAt, 2)) + " frame " + IntToStr(DoGet(LDbi, LAt + 6, 2)) +
      " size " + DoHex(DoGet(LDbi, LAt + 16, 4)) + "\n");
  end;
  // the source file info
  LCount := DoGet(LDbi, LFilesAt, 2);
  LFileOffsets := LFilesAt + 4 + LCount * 4;
  LFileTexts := LFileOffsets;
  for LM := 0 to LCount - 1 do
    LFileTexts := LFileTexts + DoGet(LDbi, LFilesAt + 4 + LCount * 2 + LM * 2, 2) * 4;
  end;
  LText.Add("  fileinfo modules " + IntToStr(LCount) + " files " + IntToStr(DoGet(LDbi, LFilesAt + 2, 2)) + "\n");
  for LM := 0 to LCount - 1 do
    LFirstFile := DoGet(LDbi, LFilesAt + 4 + LM * 2, 2);
    LFileCount := DoGet(LDbi, LFilesAt + 4 + LCount * 2 + LM * 2, 2);
    LText.Add("  fileinfo module " + IntToStr(LM) + " first " + IntToStr(LFirstFile) + " count " +
      IntToStr(LFileCount) + "\n");
    for LI := 0 to LFileCount - 1 do
      LText.Add("    file '" + DoTextAt(LDbi, LFileTexts + DoGet(LDbi, LFileOffsets + (LFirstFile + LI) * 4, 4),
        LDebugAt) + "'\n");
    end;
  end;
  // the optional debug header
  LHeadersStream := ADAM_PDB_NO_STREAM;
  LCount := 0;
  for LI := 0 to DoGet(LDbi, 48, 4) div 2 - 1 do
    if DoGet(LDbi, LDebugAt + LI * 2, 2) <> ADAM_PDB_NO_STREAM then
      LCount := LCount + 1;
      if LI = ADAM_PDB_DBI_DEBUG_SECTION_HEADERS then
        LHeadersStream := DoGet(LDbi, LDebugAt + LI * 2, 2);
      end;
    end;
  end;
  LText.Add("  debug streams " + IntToStr(DoGet(LDbi, 48, 4) div 2) + " set " + IntToStr(LCount) +
    " sectionheaders " + IntToStr(LHeadersStream) + "\n");
  // The section headers
  LHeaders := LReader.Stream(LHeadersStream);
  LText.Add("headers count " + IntToStr(len(LHeaders) div IMAGE_SIZEOF_SECTION_HEADER) + "\n");
  for LI := 0 to len(LHeaders) div IMAGE_SIZEOF_SECTION_HEADER - 1 do
    LAt := LI * IMAGE_SIZEOF_SECTION_HEADER;
    LText.Add("  header '" + DoTextAt(LHeaders, LAt, LAt + 8) + "' size " + DoHex(DoGet(LHeaders, LAt + 8, 4)) +
      " address " + DoHex(DoGet(LHeaders, LAt + 12, 4)) + " characteristics " +
      DoHex(DoGet(LHeaders, LAt + 36, 4)) + "\n");
  end;
  // Each module's stream
  for LM := 0 to LModuleCount - 1 do
    LText.Add("module " + IntToStr(LM) + " '" + LModuleNames[LM] + "' stream " +
      IntToStr(LModuleStreams[LM]) + "\n");
    DoModuleText(LReader, LModuleStreams[LM], LModuleSymbols[LM], LModuleLines[LM], LNames, LText);
  end;
  // The globals and the publics, over the symbol records
  LRecords := LReader.Stream(LRecordsStream);
  LText.Add("records bytes " + IntToStr(len(LRecords)) + "\n");
  LAt := 0;
  while LAt + 4 <= len(LRecords) do
    LText.Add("  record +" + DoHex(LAt) + " " + DoKindText(DoGet(LRecords, LAt + 2, 2)) + " '" +
      DoSymbolName(LRecords, LAt) + "'" + DoSymbolDetail(LRecords, LAt) + "\n");
    LAt := LAt + DoGet(LRecords, LAt, 2) + 2;
  end;
  LText.Add("globals stream " + IntToStr(LGlobalsStream) + "\n");
  DoGsiText("global", LReader.Stream(LGlobalsStream), LRecords, LText);
  LPublics := LReader.Stream(LPublicsStream);
  if len(LPublics) < ADAM_PDB_PSI_HEADER_SIZE then
    LText.Add("publics no header\n");
    return LText.Text();
  end;
  LText.Add("publics stream " + IntToStr(LPublicsStream) + " hash " + IntToStr(DoGet(LPublics, 0, 4)) +
    " addrmap " + IntToStr(DoGet(LPublics, 4, 4)) + " thunks " + IntToStr(DoGet(LPublics, 8, 4)) + "\n");
  setlength(LHash, DoGet(LPublics, 0, 4));
  for LI := 0 to len(LHash) - 1 do
    LHash[LI] := LPublics[ADAM_PDB_PSI_HEADER_SIZE + LI];
  end;
  DoGsiText("public", LHash, LRecords, LText);
  LAt := ADAM_PDB_PSI_HEADER_SIZE + len(LHash);
  for LI := 0 to DoGet(LPublics, 4, 4) div 4 - 1 do
    LText.Add("  address +" + DoHex(DoGet(LPublics, LAt + LI * 4, 4)) + " '" +
      DoSymbolName(LRecords, DoGet(LPublics, LAt + LI * 4, 4)) + "'\n");
  end;
  return LText.Text();
end;

end.
