-------------------------------------------------------------------------------
  Adam.LSP.Outline.adam - a module's symbols as an outline shows them (M11b L4)

  Read from the last check's tree as the parser wrote it (AA.2): nothing is
  re-derived, no list of names is kept. OutlineChildren gives an entry's
  entries in source order:
    a module: its imports, declarations, initialize / finalize sections and
      tests in its own file (directives are no declarations);
    a type: a record / object / interface / overlay's fields, embeds,
      properties, methods, init / copy / done and operators (an anonymous
      record / overlay's members in its place, it has no name), a choices
      type's values; an extend (BNF sec 3): the members it adds;
    a routine, method, init / copy / done, operator, section or test: its
      local types (places to go; its local variables and constants are not).
  OutlineKind is LSP's SymbolKind (a type by its form: interface, class for
  an object, struct for a record / overlay, enum for choices, an alias a
  type parameter, as pcpp; a forward type as the type it announces);
  OutlineName never empty (init / copy / done / initialize / finalize by
  their word, an operator `operator <symbol>`, an extend `extend <type>`, a
  test by its name); an extend is a class, as an object;
  OutlineDetail a var / const / field / embed / property's type (the
  resolved one, TypeText), a routine's heading after its name as written
  (`(const AValue: int32): int32`), else none. OutlineRanges: the whole
  declaration (its first token to its last; a module the whole text) and
  its name (an import's dotted name, a test's string), in the text of its
  file. OutlineIsPublic: an entry another module sees (a module's own
  declaration written public, a member not hidden). MatchesQuery:
  workspace/symbol's match, the query's characters in
  order in the name, case aside ("" matches all).

  Prior art: PaskalCPP.LSP.Outline (CONCEPT: the entries, kinds, names and
  details; GEOMETRY rejected: node ids of Adam's tree).
*******************************************************************************/

module unit Adam.LSP.Outline;

import System.SysUtils, Adam.Compiler.SourceText, Adam.Compiler.AST, Adam.Compiler.Types,
  Adam.LSP.Document, Adam.LSP.Find, Adam.LSP.Hover;

public const
  // LSP's SymbolKind values the outline uses
  ADAM_LSP_SYMBOL_MODULE: int64 = 2;
  ADAM_LSP_SYMBOL_CLASS: int64 = 5;
  ADAM_LSP_SYMBOL_METHOD: int64 = 6;
  ADAM_LSP_SYMBOL_PROPERTY: int64 = 7;
  ADAM_LSP_SYMBOL_FIELD: int64 = 8;
  ADAM_LSP_SYMBOL_CONSTRUCTOR: int64 = 9;
  ADAM_LSP_SYMBOL_ENUM: int64 = 10;
  ADAM_LSP_SYMBOL_INTERFACE: int64 = 11;
  ADAM_LSP_SYMBOL_FUNCTION: int64 = 12;
  ADAM_LSP_SYMBOL_VARIABLE: int64 = 13;
  ADAM_LSP_SYMBOL_CONSTANT: int64 = 14;
  ADAM_LSP_SYMBOL_ENUM_MEMBER: int64 = 22;
  ADAM_LSP_SYMBOL_STRUCT: int64 = 23;
  ADAM_LSP_SYMBOL_EVENT: int64 = 24;
  ADAM_LSP_SYMBOL_OPERATOR: int64 = 25;
  ADAM_LSP_SYMBOL_TYPE_PARAMETER: int64 = 26;
  // An entry with no name of its own (LSP requires one)
  ADAM_LSP_SYMBOL_UNNAMED: string = "(unnamed)";

// AId appended to AList
func DoAdd(var AList: Int64Array; const AId: int64);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := AId;
end;

// True for a node the outline lists (one with a place)
func DoIsEntry(const ATree: ref SyntaxTree; const AId: int64): bool;
begin
  if ATree[AId].Place.IsNone() then
    return false;
  end;
  match ATree[AId].Kind of
    NodeKind.Import, NodeKind.ConstDecl, NodeKind.VarDecl, NodeKind.TypeDecl,
    NodeKind.RoutineDecl, NodeKind.ForwardRoutine, NodeKind.ForwardType,
    NodeKind.InitializeSection, NodeKind.FinalizeSection, NodeKind.TestBlock,
    NodeKind.FieldDecl, NodeKind.EmbedDecl, NodeKind.MethodDecl, NodeKind.PropertyDecl,
    NodeKind.InitDecl, NodeKind.CopyDecl, NodeKind.DoneDecl, NodeKind.OperatorDecl,
    NodeKind.ChoiceValue, NodeKind.ExtendDecl:
      return true;
  else
  end;
  return false;
end;

// The members of the aggregate AOwner appended to AList (an anonymous one's in its place)
func DoAddMembers(const ATree: ref SyntaxTree; const AOwner: int64; var AList: Int64Array);
var
  LI: int64;
  LChild: int64;
begin
  for LI := 0 to ATree.ChildCount(AOwner) - 1 do
    LChild := ATree.ChildAt(AOwner, LI);
    if ATree.RoleOf(LChild) = NodeRole.Member then
      if (ATree[LChild].Kind = NodeKind.AnonRecord) or
        (ATree[LChild].Kind = NodeKind.AnonOverlay) then
        DoAddMembers(ATree, LChild, AList);
      else
        if DoIsEntry(ATree, LChild) then
          DoAdd(AList, LChild);
        end;
      end;
    end;
  end;
end;

// True for a node whose local types the outline lists
func DoHasLocals(const AKind: NodeKind): bool;
begin
  match AKind of
    NodeKind.RoutineDecl, NodeKind.MethodDecl, NodeKind.InitDecl, NodeKind.CopyDecl,
    NodeKind.DoneDecl, NodeKind.OperatorDecl, NodeKind.TestBlock,
    NodeKind.InitializeSection, NodeKind.FinalizeSection:
      return true;
  else
  end;
  return false;
end;

// The entries under AId in source order (see the header)
public func OutlineChildren(const ATree: ref SyntaxTree; const AId: int64): Int64Array;
var
  LList: Int64Array;
  LI: int64;
  LChild: int64;
  LType: int64;
  LKind: NodeKind;
begin
  LKind := ATree[AId].Kind;
  if LKind = NodeKind.Module then
    for LI := 0 to ATree.ChildCount(AId) - 1 do
      LChild := ATree.ChildAt(AId, LI);
      if DoIsEntry(ATree, LChild) and
        (ATree[LChild].Place.FileName = ATree[AId].Place.FileName) then
        DoAdd(LList, LChild);
      end;
    end;
    return LList;
  end;
  // A type's members, and an extend's (its TypeOf the ObjectType holding them)
  if (LKind = NodeKind.TypeDecl) or (LKind = NodeKind.ExtendDecl) then
    LType := ATree.FirstOf(AId, NodeRole.TypeOf);
    if LType <> 0 then
      match ATree[LType].Kind of
        NodeKind.RecordType, NodeKind.ObjectType, NodeKind.InterfaceType,
        NodeKind.OverlayType, NodeKind.ChoicesType:
          DoAddMembers(ATree, LType, LList);
      else
      end;
    end;
    return LList;
  end;
  if DoHasLocals(LKind) then
    for LI := 0 to ATree.ChildCount(AId) - 1 do
      LChild := ATree.ChildAt(AId, LI);
      if (ATree.RoleOf(LChild) = NodeRole.Local) and
        (ATree[LChild].Kind = NodeKind.TypeDecl) and DoIsEntry(ATree, LChild) then
        DoAdd(LList, LChild);
      end;
    end;
  end;
  return LList;
end;

// The kind of the type declaration AId by its type's form (a forward: the type it announces)
func DoTypeKind(const ATree: ref SyntaxTree; const AId: int64): int64;
var
  LType: int64;
begin
  if (ATree[AId].Kind = NodeKind.ForwardType) and (ATree[AId].ResolvedDecl <> 0) and
    (ATree[ATree[AId].ResolvedDecl].Kind = NodeKind.TypeDecl) then
    return DoTypeKind(ATree, ATree[AId].ResolvedDecl);
  end;
  LType := ATree.FirstOf(AId, NodeRole.TypeOf);
  if LType = 0 then
    return ADAM_LSP_SYMBOL_TYPE_PARAMETER;
  end;
  match ATree[LType].Kind of
    NodeKind.InterfaceType:
      return ADAM_LSP_SYMBOL_INTERFACE;
    NodeKind.ObjectType:
      return ADAM_LSP_SYMBOL_CLASS;
    NodeKind.RecordType, NodeKind.OverlayType:
      return ADAM_LSP_SYMBOL_STRUCT;
    NodeKind.ChoicesType:
      return ADAM_LSP_SYMBOL_ENUM;
  else
  end;
  return ADAM_LSP_SYMBOL_TYPE_PARAMETER;
end;

// The entry AId's LSP SymbolKind (see the header)
public func OutlineKind(const ATree: ref SyntaxTree; const AId: int64): int64;
begin
  match ATree[AId].Kind of
    NodeKind.Module, NodeKind.Import:
      return ADAM_LSP_SYMBOL_MODULE;
    NodeKind.ConstDecl:
      return ADAM_LSP_SYMBOL_CONSTANT;
    NodeKind.VarDecl:
      return ADAM_LSP_SYMBOL_VARIABLE;
    NodeKind.TypeDecl, NodeKind.ForwardType:
      return DoTypeKind(ATree, AId);
    NodeKind.ExtendDecl:
      // the methods it adds to its type, as an object's
      return ADAM_LSP_SYMBOL_CLASS;
    NodeKind.MethodDecl, NodeKind.DoneDecl:
      // done ends an object (LSP has no destructor kind)
      return ADAM_LSP_SYMBOL_METHOD;
    NodeKind.InitDecl, NodeKind.CopyDecl:
      return ADAM_LSP_SYMBOL_CONSTRUCTOR;
    NodeKind.OperatorDecl:
      return ADAM_LSP_SYMBOL_OPERATOR;
    NodeKind.FieldDecl, NodeKind.EmbedDecl:
      return ADAM_LSP_SYMBOL_FIELD;
    NodeKind.PropertyDecl:
      return ADAM_LSP_SYMBOL_PROPERTY;
    NodeKind.ChoiceValue:
      return ADAM_LSP_SYMBOL_ENUM_MEMBER;
    NodeKind.TestBlock:
      return ADAM_LSP_SYMBOL_EVENT;
  else
  end;
  // A routine, a forward routine, a section
  return ADAM_LSP_SYMBOL_FUNCTION;
end;

// The entry AId's name, never empty (see the header)
public func OutlineName(const ATree: ref SyntaxTree; const AId: int64): string;
var
  LName: string;
begin
  match ATree[AId].Kind of
    NodeKind.InitDecl:
      return "init";
    NodeKind.CopyDecl:
      return "copy";
    NodeKind.DoneDecl:
      return "done";
    NodeKind.InitializeSection:
      return "initialize";
    NodeKind.FinalizeSection:
      return "finalize";
    NodeKind.OperatorDecl:
      return "operator " + ATree[AId].Text;
    NodeKind.ExtendDecl:
      return "extend " + ATree[AId].Text;
  else
  end;
  LName := ATree[AId].Text;
  if LName = "" then
    return ADAM_LSP_SYMBOL_UNNAMED;
  end;
  return LName;
end;

// The entry AId's detail, ADocument its file's text (nil: none); "" for none (see the header)
public func OutlineDetail(const ATree: ref SyntaxTree; const AId: int64;
  const ADocument: ref LSPDocument): string;
var
  LStart: int64;
  LEnd: int64;
begin
  LStart := 0;
  LEnd := 0;
  match ATree[AId].Kind of
    NodeKind.VarDecl, NodeKind.ConstDecl, NodeKind.FieldDecl, NodeKind.EmbedDecl,
    NodeKind.PropertyDecl:
      if ATree[AId].ResolvedType = 0 then
        return "";
      end;
      return TypeText(ATree, ATree[AId].ResolvedType);
    NodeKind.RoutineDecl, NodeKind.ForwardRoutine, NodeKind.MethodDecl, NodeKind.InitDecl,
    NodeKind.CopyDecl, NodeKind.OperatorDecl:
      // Its heading as written after its name (done has no parameter list)
      if not DeclarationRange(ATree, AId, ADocument, LStart, LEnd) then
        return "";
      end;
      return HeadingText(ADocument, LEnd, false);
  else
  end;
  return "";
end;

// The byte offset in ADocument of APlace (a place of its file)
func DoOffsetOf(const ADocument: ref LSPDocument; const APlace: SourcePlace): int64;
begin
  return ADocument.OffsetOfPlace(int64(APlace.Line), int64(APlace.Column));
end;

// Where the entry AId is in ADocument, the text of its file: the whole declaration
// [AStart, AEnd) and its name [ANameStart, ANameEnd) within it; false when it has no place
// there (see the header)
public func OutlineRanges(const ATree: ref SyntaxTree; const AId: int64;
  const ADocument: ref LSPDocument; var AStart: int64; var AEnd: int64; var ANameStart: int64;
  var ANameEnd: int64): bool;
var
  LNode: ref Node;
  LLabel: int64;
begin
  AStart := 0;
  AEnd := 0;
  ANameStart := 0;
  ANameEnd := 0;
  if ADocument = nil then
    return false;
  end;
  LNode := ATree[AId];
  if LNode.Place.IsNone() then
    return false;
  end;
  // The whole declaration: its first token to its last (a module: the whole text, its doc
  // comment included)
  if LNode.Kind = NodeKind.Module then
    AEnd := len(ADocument.Text);
  else
    AStart := DoOffsetOf(ADocument, LNode.Place);
    AEnd := AStart + (LNode.EndOffset - LNode.StartOffset);
  end;
  // Its name
  if LNode.Kind = NodeKind.Import then
    ANameStart := DoOffsetOf(ADocument, LNode.Place);
    ANameEnd := ANameStart + len(LNode.Text);
  else
    if LNode.Kind = NodeKind.TestBlock then
      LLabel := ATree.FirstOf(AId, NodeRole.Label);
      if LLabel <> 0 then
        ANameStart := DoOffsetOf(ADocument, ATree[LLabel].Place);
        ANameEnd := ANameStart + len(ATree[LLabel].Text);
      else
        ANameStart := AStart;
        ANameEnd := AStart;
      end;
    else
      if not DeclarationRange(ATree, AId, ADocument, ANameStart, ANameEnd) then
        ANameStart := AStart;
        ANameEnd := AStart;
      end;
    end;
  end;
  // LSP: the name lies within the whole range, both within the text
  if ANameStart < AStart then
    AStart := ANameStart;
  end;
  if ANameEnd > AEnd then
    AEnd := ANameEnd;
  end;
  if AEnd > len(ADocument.Text) then
    AEnd := len(ADocument.Text);
  end;
  if ANameEnd > AEnd then
    ANameEnd := AEnd;
  end;
  return true;
end;

// True when another module sees the entry AId: a module's own entry only when written
// public (a section or test never), a member when not hidden (a module itself: true)
public func OutlineIsPublic(const ATree: ref SyntaxTree; const AId: int64): bool;
var
  LParent: int64;
begin
  if ATree[AId].HasFlag(NodeFlag.Hidden) then
    return false;
  end;
  LParent := ATree.ParentOf(AId);
  if (ATree[AId].Kind <> NodeKind.Module) and (LParent <> 0) and
    (ATree[LParent].Kind = NodeKind.Module) then
    return ATree[AId].HasFlag(NodeFlag.Public);
  end;
  return true;
end;

// True when the characters of AQuery come in order in AName, case aside ("" matches all)
public func MatchesQuery(const AName: string; const AQuery: string): bool;
var
  LName: string;
  LQuery: string;
  LAt: int64;
  LI: int64;
begin
  LName := LowerCase(AName);
  LQuery := LowerCase(AQuery);
  LAt := 0;
  for LI := 0 to len(LQuery) - 1 do
    while (LAt < len(LName)) and (LName[LAt] <> LQuery[LI]) do
      LAt := LAt + 1;
    end;
    if LAt >= len(LName) then
      return false;
    end;
    LAt := LAt + 1;
  end;
  return true;
end;

end.
