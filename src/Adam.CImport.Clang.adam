-------------------------------------------------------------------------------
  Adam.CImport.Clang.adam - clang's answers to the __has_* queries, frozen
  (M9b; DESIGN sec 15): what `adam cimport`'s preprocessor says to
  __has_attribute, __has_builtin, __has_feature, __has_extension,
  __has_c_attribute and __has_declspec_attribute, as the clang Adam's
  system headers were gathered with (zig 0.17) says it

  HasAnswer   the value clang gives AName of AKind for ATriple; 0 for a
              name the table does not hold (clang's own answer to a name
              it does not know)

  WRITTEN BY scripts\adam\gen_cimport_clang.py (never edited by hand): its
  probe step asks zig cc -E, for every triple the headers were gathered
  for, about every name the gathered headers query (directly or through
  glibc's __glibc_has_* wrappers) and a list of common attributes; its
  write step keeps each non-zero answer, once when the triples agree
  (Triple ""), else once per triple. A triple is only data here (the
  headers' folder name), so the table stays target-neutral. Regenerate
  after the headers are gathered again.
*******************************************************************************/

module unit Adam.CImport.Clang;

import System.SysUtils, Adam.Core.Containers;

public type
  // Which __has_* query a name is asked by
  HasKind = choices(Attribute, Builtin, Feature, Extension, CAttribute, DeclspecAttribute);

  // One non-zero answer: of AKind, for Triple ("" = every triple)
  HasEntry = record
    Kind: HasKind;
    Name: string;
    Triple: string;
    Value: int64;
  end;

  HasEntryArray = array of HasEntry;

routine DoEntry(const AKind: HasKind; const AName: string; const ATriple: string;
  const AValue: int64): HasEntry;
var
  LEntry: HasEntry;
begin
  LEntry.Kind := AKind;
  LEntry.Name := AName;
  LEntry.Triple := ATriple;
  LEntry.Value := AValue;
  return LEntry;
end;

// The frozen answers (see the header)
routine DoEntries(): HasEntryArray;
var
  LList: HasEntryArray;
  LCount: int64;
begin
