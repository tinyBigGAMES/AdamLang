// The key a table entry is found by: the kind's tag, the triple, the name
func DoKey(const AKind: HasKind; const AName: string; const ATriple: string): string;
var
  LTag: string;
begin
  match AKind of
    HasKind.Attribute: LTag := "a";
    HasKind.Builtin: LTag := "b";
    HasKind.Feature: LTag := "f";
    HasKind.Extension: LTag := "e";
    HasKind.CAttribute: LTag := "c";
    HasKind.DeclspecAttribute: LTag := "d";
  end;
  return LTag + ":" + ATriple + ":" + AName;
end;

public type
  // The table, indexed once (Find is a map lookup)
  HasTable = object
    hidden FEntries: HasEntryArray;
    hidden FIndex: ref StringIdMap;

    init();
    var
      LI: int64;
    begin
      self.FEntries := DoEntries();
      self.FIndex := ref StringIdMap(0);
      for LI := 0 to len(self.FEntries) - 1 do
        self.FIndex.Put(DoKey(self.FEntries[LI].Kind, self.FEntries[LI].Name,
          self.FEntries[LI].Triple), LI + 1);
      end;
    end;

    // clang's answer to __has_<AKind>(AName) for ATriple (see the header)
    const method HasAnswer(const AKind: HasKind; const AName: string; const ATriple: string): int64;
    var
      LId: int64;
    begin
      LId := self.FIndex.Find(DoKey(AKind, AName, ATriple));
      if LId = 0 then
        LId := self.FIndex.Find(DoKey(AKind, AName, ""));
      end;
      if LId = 0 then
        return 0;
      end;
      return self.FEntries[LId - 1].Value;
    end;
  end;

end.
