-------------------------------------------------------------------------------
  Adam.Dev.Stamp.adam - an existing program's resources replaced (M11a
  D5e2, adam --dev-editor stamps the editor's editor.exe), target-neutral
  over its host part (@ifdef, as Adam.Debug.Console)

  StampResources puts AResources (Adam.Coff.Resources' ImageResource list:
  VersionResource, IconResources) into the program APath in one update:
  first every resource it holds of a type the list has goes, in every
  language (an image's own version info is often US English and Adam's
  neutral: both kept would leave either one shown), then the list's go in.
  False with the step that failed (StampStep) and the OS's code; the file is
  then as it was. A host with no part: StampStep.NoPart.
*******************************************************************************/

module unit Adam.Dev.Stamp;

import System.SysUtils, Adam.Coff.Resources, Adam.Dev.Stamp.Step
@ifdef TARGET_X86_64_WINDOWS_GNU
  , Adam.Dev.Stamp.Win64
@endif
  ;

// AResources into the program APath (see the header); false with AStep and ACode saying why
public routine StampResources(const APath: string; const AResources: ImageResourceList;
  var AStep: StampStep; var ACode: uint32): bool;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return DevStampPlatformResources(APath, AResources, AStep, ACode);
@else
  AStep := StampStep.NoPart;
  ACode := 0;
  return false;
@endif
end;

end.
