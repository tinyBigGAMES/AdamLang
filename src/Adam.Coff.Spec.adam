-------------------------------------------------------------------------------
  Adam.Coff.Spec.adam - the PE / COFF specification's own names

  Every value Adam's COFF object format part takes from Microsoft's PE / COFF
  specification, under the name the specification's headers give it
  (winnt.h: IMAGE_*, IMPORT_OBJECT_*, LANG_NEUTRAL; winuser.h: RT_*;
  winver.h: VS_*, VOS_*, VFT_*), each once: Adam.Coff.Writer / Reader /
  Linker / Exports / Archive / Resources and Adam.Pdb.Writer (a PDB's section
  headers) import it. Adam's own layout facts (field offsets, limits, sizes
  the headers name no constant for) stay ADAM_ in the unit that uses them.

  It imports nothing and sits below Adam.Pdb.*: a pure table of the format's
  facts, the same on every host (the compiler writes COFF from any OS, so it
  never imports std's System.Windows* bindings). An ELF target's part gets
  ELF's own names in its own unit.
*******************************************************************************/

module unit Adam.Coff.Spec;

public const
  // Record sizes (PE Format: COFF File Header, Section Table, COFF Relocations, COFF Symbol Table)
  IMAGE_SIZEOF_FILE_HEADER: int64 = 20;
  IMAGE_SIZEOF_SECTION_HEADER: int64 = 40;
  IMAGE_SIZEOF_RELOCATION: int64 = 10;
  IMAGE_SIZEOF_SYMBOL: int64 = 18;
  IMAGE_SIZEOF_SHORT_NAME: int64 = 8;
  // The Machine field and the relocation types (x64 Processors)
  IMAGE_FILE_MACHINE_AMD64: int64 = 0x8664;
  IMAGE_REL_AMD64_ADDR64: int64 = 0x0001;
  IMAGE_REL_AMD64_ADDR32NB: int64 = 0x0003;
  IMAGE_REL_AMD64_REL32: int64 = 0x0004;
  IMAGE_REL_AMD64_SECTION: int64 = 0x000A;
  IMAGE_REL_AMD64_SECREL: int64 = 0x000B;
  // Section Flags
  IMAGE_SCN_CNT_CODE: int64 = 0x00000020;
  IMAGE_SCN_CNT_INITIALIZED_DATA: int64 = 0x00000040;
  IMAGE_SCN_CNT_UNINITIALIZED_DATA: int64 = 0x00000080;
  // An Info section: comments / compiler data no linker puts in an image
  IMAGE_SCN_LNK_INFO: int64 = 0x00000200;
  IMAGE_SCN_LNK_REMOVE: int64 = 0x00000800;
  // A COMDAT section: a Removable one (SU2.7, see the header)
  IMAGE_SCN_LNK_COMDAT: int64 = 0x00001000;
  IMAGE_SCN_LNK_NRELOC_OVFL: int64 = 0x01000000;
  // A Debug section (CodeView): no image holds it, the linker reads it into the PDB
  IMAGE_SCN_MEM_DISCARDABLE: int64 = 0x02000000;
  IMAGE_SCN_MEM_EXECUTE: int64 = 0x20000000;
  IMAGE_SCN_MEM_READ: int64 = 0x40000000;
  IMAGE_SCN_MEM_WRITE: int64 = 0x80000000;
  // Storage classes (COFF Symbol Table)
  IMAGE_SYM_CLASS_EXTERNAL: int64 = 2;
  IMAGE_SYM_CLASS_STATIC: int64 = 3;
  // A section symbol in section 0: the start of the image's sections of its name
  IMAGE_SYM_CLASS_SECTION: int64 = 104;
  // COMDAT selections (COMDAT Sections) the writer gives a Removable section: its own
  // (one definition of its symbol), any one of the copies (a Shared one: a generic
  // instance's code, every object using the instance holds a copy), or the section it goes
  // with (an Associate one)
  IMAGE_COMDAT_SELECT_NODUPLICATES: int64 = 1;
  IMAGE_COMDAT_SELECT_ANY: int64 = 2;
  IMAGE_COMDAT_SELECT_ASSOCIATIVE: int64 = 5;
  // Section Number Values
  IMAGE_SYM_UNDEFINED: int64 = 0;
  IMAGE_SYM_ABSOLUTE: int64 = -1;
  IMAGE_SYM_DEBUG: int64 = -2;
  // Storage classes read beyond the writer's
  IMAGE_SYM_CLASS_LABEL: int64 = 6;
  IMAGE_SYM_CLASS_FILE: int64 = 103;
  IMAGE_SYM_CLASS_WEAK_EXTERNAL: int64 = 105;
  // COMDAT selections (COMDAT Sections) read beyond the writer's
  IMAGE_COMDAT_SELECT_SAME_SIZE: int64 = 3;
  IMAGE_COMDAT_SELECT_EXACT_MATCH: int64 = 4;
  IMAGE_COMDAT_SELECT_LARGEST: int64 = 6;
  // Weak external search kinds (Auxiliary Format 3's Characteristics)
  IMAGE_WEAK_EXTERN_SEARCH_NOLIBRARY: int64 = 1;
  IMAGE_WEAK_EXTERN_SEARCH_LIBRARY: int64 = 2;
  IMAGE_WEAK_EXTERN_SEARCH_ALIAS: int64 = 3;
  // The debug directory: its data directory index and a CodeView entry's Type (Debug Type)
  IMAGE_DIRECTORY_ENTRY_DEBUG: int64 = 6;
  IMAGE_DEBUG_TYPE_CODEVIEW: int64 = 2;
  // Image headers: the MS-DOS and PE signatures, the file header's Characteristics, the
  // optional header's magic (PE32+), its data directories, subsystems and DLL characteristics
  IMAGE_DOS_SIGNATURE: int64 = 0x5A4D;
  IMAGE_NT_SIGNATURE: int64 = 0x00004550;
  IMAGE_FILE_RELOCS_STRIPPED: int64 = 0x0001;
  IMAGE_FILE_EXECUTABLE_IMAGE: int64 = 0x0002;
  IMAGE_FILE_LARGE_ADDRESS_AWARE: int64 = 0x0020;
  IMAGE_FILE_DLL: int64 = 0x2000;
  IMAGE_NT_OPTIONAL_HDR64_MAGIC: int64 = 0x20B;
  IMAGE_NUMBEROF_DIRECTORY_ENTRIES: int64 = 16;
  IMAGE_DIRECTORY_ENTRY_EXPORT: int64 = 0;
  IMAGE_DIRECTORY_ENTRY_IMPORT: int64 = 1;
  IMAGE_DIRECTORY_ENTRY_RESOURCE: int64 = 2;
  IMAGE_DIRECTORY_ENTRY_EXCEPTION: int64 = 3;
  IMAGE_DIRECTORY_ENTRY_BASERELOC: int64 = 5;
  IMAGE_DIRECTORY_ENTRY_TLS: int64 = 9;
  IMAGE_DIRECTORY_ENTRY_IAT: int64 = 12;
  IMAGE_SUBSYSTEM_WINDOWS_GUI: int64 = 2;
  IMAGE_SUBSYSTEM_WINDOWS_CUI: int64 = 3;
  IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA: int64 = 0x0020;
  IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE: int64 = 0x0040;
  IMAGE_DLLCHARACTERISTICS_NX_COMPAT: int64 = 0x0100;
  // A base relocation's type (Base Relocation Types)
  IMAGE_REL_BASED_DIR64: int64 = 10;
  // Archives (Archive (Library) File Format) and short import headers (Import Library Format)
  IMAGE_ARCHIVE_START: string = "!<arch>\n";
  IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR: int64 = 60;
  IMPORT_OBJECT_HDR_SIG2: int64 = 0xFFFF;
  IMPORT_OBJECT_CODE: int64 = 0;
  IMPORT_OBJECT_DATA: int64 = 1;
  IMPORT_OBJECT_NAME: int64 = 1;
  // Resources: their types (winuser.h RT_*), the neutral language (winnt.h), the version
  // resource's id and VS_FIXEDFILEINFO fields (winver.h)
  RT_ICON: int64 = 3;
  RT_GROUP_ICON: int64 = 14;
  RT_VERSION: int64 = 16;
  LANG_NEUTRAL: int64 = 0;
  VS_VERSION_INFO: int64 = 1;
  VS_FFI_SIGNATURE: int64 = 0xFEEF04BD;
  VS_FFI_STRUCVERSION: int64 = 0x00010000;
  VS_FFI_FILEFLAGSMASK: int64 = 0x3F;
  VOS_NT_WINDOWS32: int64 = 0x00040004;
  VFT_APP: int64 = 1;
  VFT_DLL: int64 = 2;
  // The 16-bit flag a PDB's section map entries carry (Adam.Pdb.Writer)
  IMAGE_SCN_MEM_16BIT: int64 = 0x00020000;

end.
