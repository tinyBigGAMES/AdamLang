-------------------------------------------------------------------------------
  Adam.Target.adam - The target interface

  Target          what the phases above the target parts ask about the
                  target a program is built for (PROJECT.md, Targets): its
                  triple, the size and alignment of each builtin scalar,
                  the pointer's, C's long, the C++ type each builtin is, the
                  bitfield rule and the symbol mangling scheme. It is
                  abstract: each target is one implementation of it
                  (Adam.Target.Win64 the first), and a new target is a new
                  implementation, never an edit above it. One compile holds
                  one Target, picked once from the main module's triple by
                  the Driver.

  BitfieldRule    how bitfields share storage units. Microsoft: a run of
                  bitfields shares one unit of its declared type's size; a
                  field of another size, or one that does not fit, starts a
                  new unit (MS ABI, which x86_64-windows-gnu follows).

  ManglingScheme  how C++ linkage symbols are spelled. Itanium: the Itanium
                  C++ ABI as clang writes it.

  The phases ask through these methods only; a fact no method answers is a
  new method here and in every implementation, never a constant in a phase.
*******************************************************************************/

module unit Adam.Target;

public type
  // How bitfields share storage units (see the header)
  BitfieldRule = choices(Microsoft);

  // How C++ linkage symbols are spelled (see the header)
  ManglingScheme = choices(Itanium);

  // The target interface (see the header); every method is a target fact
  Target = object
    // The target's normalized triple, arch-os-abi
    virtual method Triple(): string; abstract;

    // The target's short name, what a user may type in place of its triple (the command
    // line's -t, the help's list)
    virtual method TargetName(): string; abstract;

    // True for the target a build has when nothing names one (BNF sec 2); the registry
    // holds exactly one such target
    virtual method IsDefault(): bool; abstract;

    // The size in bytes of the builtin scalar type named AName (int8 .. uint64, bool, char,
    // wchar, float32, float64, ptr); -1 for a name that is no builtin scalar
    virtual method BuiltinSize(const AName: string): int64; abstract;

    // The alignment in bytes of the builtin scalar type named AName; -1 for a name that is
    // no builtin scalar
    virtual method BuiltinAlign(const AName: string): int64; abstract;

    // The size in bytes of a pointer (a typed pointer, a routine value, a vtable pointer,
    // and the handles of Adam's managed types)
    virtual method PointerSize(): int64; abstract;

    // The alignment in bytes of a pointer
    virtual method PointerAlign(): int64; abstract;

    // The alignment in bytes the stack keeps at a call (a local aligned above it needs the
    // frame realigned at run time)
    virtual method StackAlign(): int64; abstract;

    // True when an aggregate (record, array, set) of ASize bytes crosses a call by value in
    // one integer register, as an argument and as a result; any other size goes by a pointer
    // to a caller's copy (an argument) or through a hidden result pointer (a result)
    virtual method AggregateInRegister(const ASize: int64): bool; abstract;

    // The bytes between two variadic arguments of a C variadic call: each one (promoted,
    // an aggregate as AggregateInRegister passes it) takes one place of this size, so a
    // clink varargs.next moves its cursor by it
    virtual method VariadicSlotBytes(): int64; abstract;

    // The size in bytes of C's long (the data model: 4 on LLP64 Windows, 8 on LP64); an
    // integer literal's single l suffix names it (BNF sec 9)
    virtual method CLongSize(): int64; abstract;

    // True when char (C's plain char) is signed on this target; its values, conversions and
    // compares follow it
    virtual method CharSigned(): bool; abstract;

    // True when wchar (C's wchar_t) is signed on this target (unsigned 16 bits on Windows,
    // signed 32 bits on LP64 Linux)
    virtual method WideCharSigned(): bool; abstract;

    // The C++ fundamental type the builtin named AName is on this target, as C++ spells it
    // ("long long", "wchar_t"); empty for a builtin that is no C++ fundamental type
    // (string, wstring, varargs, ptr) and for a name that is no builtin
    virtual method BuiltinCppType(const AName: string): string; abstract;

    // How bitfields share storage units
    virtual method Bitfields(): BitfieldRule; abstract;

    // How C++ linkage symbols are spelled
    virtual method Mangling(): ManglingScheme; abstract;

    // The unit holding this target's platform routines (the OS calls under System.Runtime:
    // write, exit, the heap, the process's arguments), loaded with the runtime as its
    // implicit import, so System.Runtime itself names no OS
    virtual method RuntimeUnit(): string; abstract;
  end;

// The name of ARule, as a row or a dump prints it
public routine BitfieldRuleText(const ARule: BitfieldRule): string;
begin
  match ARule of
    BitfieldRule.Microsoft: return "Microsoft";
  end;
  return "";
end;

// The name of AScheme, as a row or a dump prints it
public routine ManglingSchemeText(const AScheme: ManglingScheme): string;
begin
  match AScheme of
    ManglingScheme.Itanium: return "Itanium";
  end;
  return "";
end;

end.
