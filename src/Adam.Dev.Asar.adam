-------------------------------------------------------------------------------
  Adam.Dev.Asar.adam - an Electron app archive (app.asar) written from a
  folder (M11a D5e2, adam --dev-editor), target-neutral

  The format is Electron's asar: a Chromium Pickle holding the header's size
  (two 32-bit little-endian words: 4, then the second pickle's whole size),
  a second Pickle holding the header JSON as a string (its payload's size,
  the string's byte length, its UTF-8 bytes, zeros to a 4-byte end), then
  every file's bytes one after another. The header is {"files": {..}}: a
  folder is {"files": {..}} of its members, a file {"size": N, "offset":
  "O"} (offset a string, from the end of the header). Prior art: pcpp's
  PaskalCPP.Asar (CONCEPT and VALUES adopted; GEOMETRY: one routine over a
  folder walk, the archive made whole in memory).

  AsarFromFolder walks a folder (members in GetFiles / GetDirectories' fixed
  order, an empty folder left out), each file's bytes read once; AReplace
  names files (by their '/' name in the archive) whose bytes are given
  instead of the disk's (adam --dev-editor's package.json). False with why
  when a file cannot be read.
*******************************************************************************/

module unit Adam.Dev.Asar;

import System.SysUtils, System.IO, System.JSON.Ext, System.LibC.C;

public const
  // The header's pickles: the first one's payload size (a 32-bit word), the alignment of a
  // pickle string's bytes
  ADAM_ASAR_SIZE_PICKLE: int64 = 4;
  ADAM_ASAR_ALIGN: int64 = 4;

public type
  // One file whose bytes go in place of the disk's: its '/' name in the archive
  AsarReplace = record
    Name: string;
    Bytes: ByteArray;
  end;

  AsarReplaceArray = array of AsarReplace;

type
  // The walk's state: every file's bytes in archive order, their total so far, why it stopped
  AsarWalk = record
    Data: array of ByteArray;
    Total: int64;
    Why: string;
  end;

// The index in AReplace of the file named AName; -1 when it is the disk's
func DoReplaceIndex(const AReplace: AsarReplaceArray; const AName: string): int64;
var
  LI: int64;
begin
  for LI := 0 to len(AReplace) - 1 do
    if AReplace[LI].Name = AName then
      return LI;
    end;
  end;
  return -1;
end;

// The folder ADir (named APrefix in the archive, "" the root) as its header node into ANode,
// its files' bytes appended to AWalk; false when it has no member (left out) or a file could
// not be read (AWalk.Why)
func DoFolder(const ADir: string; const APrefix: string; const AReplace: AsarReplaceArray;
  var AWalk: AsarWalk; var ANode: Json): bool;
var
  LFiles: StringArray;
  LDirs: StringArray;
  LMembers: Json;
  LChild: Json;
  LFresh: Json;
  LBytes: ByteArray;
  LName: string;
  LIndex: int64;
  LCount: int64;
  LI: int64;
begin
  LCount := 0;
  setlength(LFiles, 0);
  setlength(LDirs, 0);
  GetFiles(ADir, LFiles);
  GetDirectories(ADir, LDirs);
  for LI := 0 to len(LFiles) - 1 do
    LName := APrefix + LFiles[LI];
    LIndex := DoReplaceIndex(AReplace, LName);
    if LIndex >= 0 then
      LBytes := AReplace[LIndex].Bytes;
    else
      if not ReadAllBytes(ResolvePath(LFiles[LI], ADir), LBytes) then
        AWalk.Why := ResolvePath(LFiles[LI], ADir);
        return false;
      end;
    end;
    LChild := LFresh;
    LChild.Add("size", int64(len(LBytes)));
    LChild.Add("offset", IntToStr(AWalk.Total));
    LMembers.Add(LFiles[LI], LChild);
    setlength(AWalk.Data, len(AWalk.Data) + 1);
    AWalk.Data[len(AWalk.Data) - 1] := LBytes;
    AWalk.Total := AWalk.Total + len(LBytes);
    LCount := LCount + 1;
  end;
  for LI := 0 to len(LDirs) - 1 do
    LChild := LFresh;
    if DoFolder(ResolvePath(LDirs[LI], ADir), APrefix + LDirs[LI] + "/", AReplace, AWalk,
      LChild) then
      LMembers.Add(LDirs[LI], LChild);
      LCount := LCount + 1;
    else
      if AWalk.Why <> "" then
        return false;
      end;
    end;
  end;
  if LCount = 0 then
    return false;
  end;
  ANode.Add("files", LMembers);
  return true;
end;

// AValue as a 32-bit little-endian word at AAt in ABytes
func DoPutWord(var ABytes: ByteArray; const AAt: int64; const AValue: int64);
begin
  PutLe(ABytes, AAt, uint64(AValue), 4);
end;

// The archive of the folder ADir (see the header) into ABytes, ACount the files in it; false
// with why (AWhy, a file that could not be read, or "" for a folder with nothing in it)
public func AsarFromFolder(const ADir: string; const AReplace: AsarReplaceArray;
  var ABytes: ByteArray; var ACount: int64; var AWhy: string): bool;
var
  LWalk: AsarWalk;
  LRoot: Json;
  LHeader: string;
  LTextSize: int64;
  LPadded: int64;
  LPickle: int64;
  LAt: int64;
  LI: int64;
begin
  AWhy := "";
  ACount := 0;
  setlength(ABytes, 0);
  setlength(LWalk.Data, 0);
  LWalk.Total := 0;
  LWalk.Why := "";
  if not DoFolder(ADir, "", AReplace, LWalk, LRoot) then
    AWhy := LWalk.Why;
    return false;
  end;
  ACount := len(LWalk.Data);
  LHeader := LRoot.ToString();
  LTextSize := len(LHeader);
  LPadded := (LTextSize + ADAM_ASAR_ALIGN - 1) div ADAM_ASAR_ALIGN * ADAM_ASAR_ALIGN;
  // The second pickle: its payload size word, then the string (its length word, its bytes)
  LPickle := 4 + 4 + LPadded;
  setlength(ABytes, 8 + LPickle + LWalk.Total);
  // The header's words and its padding zeroed (every data byte is written below)
  for LI := 0 to 8 + LPickle - 1 do
    ABytes[LI] := 0;
  end;
  DoPutWord(ABytes, 0, ADAM_ASAR_SIZE_PICKLE);
  DoPutWord(ABytes, 4, LPickle);
  DoPutWord(ABytes, 8, 4 + LPadded);
  DoPutWord(ABytes, 12, LTextSize);
  for LI := 0 to LTextSize - 1 do
    ABytes[16 + LI] := uint8(LHeader[LI]);
  end;
  LAt := 8 + LPickle;
  for LI := 0 to len(LWalk.Data) - 1 do
    if len(LWalk.Data[LI]) > 0 then
      memcpy(ptr(addr of ABytes[LAt]), ptr to const(addr of LWalk.Data[LI][0]),
        size_t(len(LWalk.Data[LI])));
      LAt := LAt + len(LWalk.Data[LI]);
    end;
  end;
  return true;
end;

end.
