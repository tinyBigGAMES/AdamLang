-------------------------------------------------------------------------------
  Adam.LSP.Tokens.adam - The language server's semantic tokens (M11b L2)

  SemanticTokens colours one document: the Lexer's tokens of its text, each
  name given the kind of what the last check resolved it to (read from the
  AST, AA.2: nothing re-derived here).

  The legend (TokenTypeNames, TokenModifierNames: LSP's standard names, the
  ones every client's theme knows): keyword, type, namespace, struct,
  class, interface, enum, enumMember, typeParameter, function, method,
  property, variable, parameter, macro; modifiers declaration, readonly.

  A keyword token is a keyword (a builtin type word a type); a directive a
  macro. A name the check's tree holds is claimed at its token (the node's
  name place, Node.AtName): a declaration by what it declares (with
  declaration; a const readonly), a use (a name, a member after '.' / '->',
  a named type, a record literal's field, a property accessor's field) by
  its ResolvedDecl's kind; a dotted name (a module's, an import's, a named
  type's prefix) and a dotted prefix naming a unit (ResolvedUnit, and every
  name before it) are namespaces. A name claimed with no kind (one the check
  could not resolve) is left uncoloured. An identifier no node claims is a
  word the parser took as syntax (defer, yield, sequence, task, async,
  hidden, property, read, external's name ..): a keyword, with no list kept
  here that could fall behind the Parser, except inside a directive or a
  span the parser skipped (an error node), where nothing is claimed, and in
  a conditional branch the check left out (the build's own ConditionalFilter
  run again with the target and level the check settled: the parser never
  saw those tokens).

  A generic's instances (role Instance) repeat their template's places and
  a write summary (role Effects) has none: neither is walked. With no tree
  (a document that names no file) only the Lexer's colours are given: its
  names stay uncoloured, none taken for a keyword.

  LSP's encoding: per token its line from the one before, its character
  from the one before when on the same line (else from the line's start),
  its length, its type and its modifiers' bits; a token over two lines (a
  splice inside it) is left out.

  Prior art: PaskalCPP.LSP.Server DoSemanticData (CONCEPT: the real lexer
  over the buffer, keywords and builtin types); the resolved name kinds are
  Adam's own.
*******************************************************************************/

module unit Adam.LSP.Tokens;

import System.SysUtils, Adam.Core.Common, Adam.Core.Containers, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics, Adam.Compiler.Lexer, Adam.Compiler.Conditionals,
  Adam.Compiler.AST, Adam.LSP.Document;

public const
  // The legend's token types, by index (TokenTypeNames)
  ADAM_LSP_TOKEN_KEYWORD: int64 = 0;
  ADAM_LSP_TOKEN_TYPE: int64 = 1;
  ADAM_LSP_TOKEN_NAMESPACE: int64 = 2;
  ADAM_LSP_TOKEN_STRUCT: int64 = 3;
  ADAM_LSP_TOKEN_CLASS: int64 = 4;
  ADAM_LSP_TOKEN_INTERFACE: int64 = 5;
  ADAM_LSP_TOKEN_ENUM: int64 = 6;
  ADAM_LSP_TOKEN_ENUM_MEMBER: int64 = 7;
  ADAM_LSP_TOKEN_TYPE_PARAMETER: int64 = 8;
  ADAM_LSP_TOKEN_FUNCTION: int64 = 9;
  ADAM_LSP_TOKEN_METHOD: int64 = 10;
  ADAM_LSP_TOKEN_PROPERTY: int64 = 11;
  ADAM_LSP_TOKEN_VARIABLE: int64 = 12;
  ADAM_LSP_TOKEN_PARAMETER: int64 = 13;
  ADAM_LSP_TOKEN_MACRO: int64 = 14;
  // No colour (a name the check could not resolve)
  ADAM_LSP_TOKEN_NONE: int64 = -1;

  // The legend's modifiers, as bits (TokenModifierNames)
  ADAM_LSP_MODIFIER_DECLARATION: int64 = 1;
  ADAM_LSP_MODIFIER_READONLY: int64 = 2;

const
  // The report budget of the scratch Diagnostics the Lexer reports into (its reports are
  // the diagnostics' business, dropped here)
  ADAM_LSP_TOKENS_BUDGET: int64 = 1000;

type
  // A name the tree claims at a token: its type (ADAM_LSP_TOKEN_*), its modifiers' bits,
  // and how many dotted parts it spans (the ones before the last namespaces)
  LSPClaim = record
    TokenType: int64;
    Modifiers: int64;
    Parts: int64;
  end;

// AText added at the end of AList
func DoAppend(var AList: StringArray; const AText: string);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := AText;
end;

// The legend's token type names, in their index order (ADAM_LSP_TOKEN_*)
public func TokenTypeNames(): StringArray;
var
  LNames: StringArray;
begin
  setlength(LNames, 0);
  DoAppend(LNames, "keyword");
  DoAppend(LNames, "type");
  DoAppend(LNames, "namespace");
  DoAppend(LNames, "struct");
  DoAppend(LNames, "class");
  DoAppend(LNames, "interface");
  DoAppend(LNames, "enum");
  DoAppend(LNames, "enumMember");
  DoAppend(LNames, "typeParameter");
  DoAppend(LNames, "function");
  DoAppend(LNames, "method");
  DoAppend(LNames, "property");
  DoAppend(LNames, "variable");
  DoAppend(LNames, "parameter");
  DoAppend(LNames, "macro");
  return LNames;
end;

// The legend's modifier names, bit 0 first (ADAM_LSP_MODIFIER_*)
public func TokenModifierNames(): StringArray;
var
  LNames: StringArray;
begin
  setlength(LNames, 0);
  DoAppend(LNames, "declaration");
  DoAppend(LNames, "readonly");
  return LNames;
end;

// How many dotted parts AText has (a name with no '.' one)
func DoParts(const AText: string): int64;
var
  LParts: int64;
  LI: int64;
begin
  LParts := 1;
  for LI := 0 to len(AText) - 1 do
    if AText[LI] = '.' then
      LParts := LParts + 1;
    end;
  end;
  return LParts;
end;

type
  // One document's colouring (see the header): the tree's claims, then the Lexer's pass
  LSPColouring = object
    hidden FDocument: ref LSPDocument;
    hidden FTree: ref SyntaxTree;
    hidden FEncoding: LSPEncoding;
    // The file the module's nodes were read from: a node of another file claims nothing
    hidden FFile: string;
    // True once a module's tree was walked: an unclaimed identifier is then a keyword
    hidden FWalked: bool;
    // By a name token's byte offset in the document's text, the index of its claim
    hidden FClaimAt: ref Int64Map;
    hidden FClaims: array of LSPClaim;
    // [start, end) byte spans where an unclaimed identifier is no keyword
    hidden FQuietStarts: Int64Array;
    hidden FQuietEnds: Int64Array;
    // The encoded data, and the last token's line and character
    hidden FData: Int64Array;
    hidden FLastLine: int64;
    hidden FLastCharacter: int64;

    init(const ADocument: ref LSPDocument; const ATree: ref SyntaxTree;
      const AEncoding: LSPEncoding);
    begin
      self.FDocument := ADocument;
      self.FTree := ATree;
      self.FEncoding := AEncoding;
      self.FFile := "";
      self.FWalked := false;
      self.FClaimAt := ref Int64Map(-1);
      setlength(self.FClaims, 0);
      setlength(self.FQuietStarts, 0);
      setlength(self.FQuietEnds, 0);
      setlength(self.FData, 0);
      self.FLastLine := 0;
      self.FLastCharacter := 0;
    end;

    // The data of the module AModule of the tree (none: 0) over the document's text
    method Run(const AModule: int64): Int64Array;
    begin
      if (self.FTree <> nil) and (AModule <> 0) then
        self.FFile := self.FTree[AModule].Place.FileName;
        self.DoWalk(AModule);
        self.FWalked := true;
      end;
      self.DoLex();
      return self.FData;
    end;

    // -- The tree's claims

    // AId and every node below it claimed (an instance and a write summary skipped)
    hidden method DoWalk(const AId: int64);
    var
      LI: int64;
      LChild: int64;
      LRole: NodeRole;
    begin
      self.DoNode(AId);
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LChild := self.FTree.ChildAt(AId, LI);
        LRole := self.FTree.RoleOf(LChild);
        if (LRole <> NodeRole.Instance) and (LRole <> NodeRole.Effects) and
          (self.FTree[LChild].Kind <> NodeKind.GenericInstance) then
          self.DoWalk(LChild);
        end;
      end;
    end;

    // What the node AId claims
    hidden method DoNode(const AId: int64);
    var
      LNode: ref Node;
      LType: int64;
    begin
      LNode := self.FTree[AId];
      match LNode.Kind of
        NodeKind.Directive, NodeKind.Error:
          self.DoQuiet(LNode.StartOffset, LNode.EndOffset);
        NodeKind.Module:
          self.DoClaim(LNode.AtName(), ADAM_LSP_TOKEN_NAMESPACE, ADAM_LSP_MODIFIER_DECLARATION,
            DoParts(LNode.Text));
        NodeKind.Import:
          // An import names a unit: it declares nothing
          self.DoClaim(LNode.Place, ADAM_LSP_TOKEN_NAMESPACE, 0, DoParts(LNode.Text));
        NodeKind.VarDecl, NodeKind.ConstDecl, NodeKind.TypeDecl, NodeKind.RoutineDecl,
        NodeKind.ForwardRoutine, NodeKind.ForwardType, NodeKind.Param, NodeKind.GenericParam,
        NodeKind.FieldDecl, NodeKind.EmbedDecl, NodeKind.MethodDecl, NodeKind.PropertyDecl,
        NodeKind.ChoiceValue, NodeKind.InitDecl, NodeKind.CopyDecl, NodeKind.DoneDecl:
          LType := self.DoKindOf(AId);
          self.DoClaim(LNode.AtName(), LType,
            self.DoModifiersOf(AId) | ADAM_LSP_MODIFIER_DECLARATION, 1);
        NodeKind.NamedType:
          self.DoClaim(LNode.Place, self.DoTargetKind(LNode.ResolvedDecl),
            self.DoTargetModifiers(LNode.ResolvedDecl), DoParts(LNode.Text));
        NodeKind.NameExpression, NodeKind.MemberExpression:
          self.DoNameUse(AId);
        NodeKind.FieldInit:
          self.DoClaim(LNode.AtName(), self.DoTargetKind(LNode.ResolvedDecl),
            self.DoTargetModifiers(LNode.ResolvedDecl), 1);
        NodeKind.PropertyRead, NodeKind.PropertyWrite:
          // An accessor names a field only when the parser read one (NamePlace): its first
          // token is the word read / write
          if not LNode.NamePlace.IsNone() then
            self.DoClaim(LNode.NamePlace, self.DoTargetKind(LNode.ResolvedDecl),
              self.DoTargetModifiers(LNode.ResolvedDecl), 1);
          end;
      else
      end;
    end;

    // A name or a member AId: a dotted prefix naming a unit is a namespace, with every name
    // of its operand chain; else the kind of what it means
    hidden method DoNameUse(const AId: int64);
    var
      LNode: ref Node;
      LAt: int64;
    begin
      LNode := self.FTree[AId];
      if LNode.ResolvedUnit <> 0 then
        LAt := AId;
        while (LAt <> 0) and ((self.FTree[LAt].Kind = NodeKind.NameExpression) or
          (self.FTree[LAt].Kind = NodeKind.MemberExpression)) do
          self.DoClaim(self.FTree[LAt].AtName(), ADAM_LSP_TOKEN_NAMESPACE, 0, 1);
          LAt := self.FTree.FirstOf(LAt, NodeRole.Operand);
        end;
        return;
      end;
      self.DoClaim(LNode.AtName(), self.DoTargetKind(LNode.ResolvedDecl),
        self.DoTargetModifiers(LNode.ResolvedDecl), 1);
    end;

    // The token at APlace claimed with AType, AModifiers and AParts. A place of another file
    // claims nothing; a claim with a kind is never replaced by one with none (a unit prefix's
    // names are namespaces before their own nodes, which resolve nothing, are walked)
    hidden method DoClaim(const APlace: SourcePlace; const AType: int64; const AModifiers: int64;
      const AParts: int64);
    var
      LOffset: int64;
      LAt: int64;
      LCount: int64;
    begin
      if APlace.IsNone() or (APlace.FileName <> self.FFile) then
        return;
      end;
      LOffset := self.FDocument.OffsetOfPlace(int64(APlace.Line), int64(APlace.Column));
      LAt := self.FClaimAt.Find(LOffset);
      if LAt >= 0 then
        if (AType = ADAM_LSP_TOKEN_NONE) and (self.FClaims[LAt].TokenType <> ADAM_LSP_TOKEN_NONE) then
          return;
        end;
      else
        LCount := len(self.FClaims);
        setlength(self.FClaims, LCount + 1);
        LAt := LCount;
        self.FClaimAt.Put(LOffset, LAt);
      end;
      self.FClaims[LAt].TokenType := AType;
      self.FClaims[LAt].Modifiers := AModifiers;
      self.FClaims[LAt].Parts := AParts;
    end;

    // The bytes [AStart, AEnd) quiet: an unclaimed identifier there is no keyword
    hidden method DoQuiet(const AStart: int64; const AEnd: int64);
    var
      LCount: int64;
    begin
      LCount := len(self.FQuietStarts);
      setlength(self.FQuietStarts, LCount + 1);
      setlength(self.FQuietEnds, LCount + 1);
      self.FQuietStarts[LCount] := AStart;
      self.FQuietEnds[LCount] := AEnd;
    end;

    hidden const method DoIsQuiet(const AOffset: int64): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FQuietStarts) - 1 do
        if (AOffset >= self.FQuietStarts[LI]) and (AOffset < self.FQuietEnds[LI]) then
          return true;
        end;
      end;
      return false;
    end;

    // The kind a type declaration AId's type is: its TypeOf's form (a forward its type's)
    hidden const method DoTypeKind(const AId: int64): int64;
    var
      LType: int64;
    begin
      LType := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      if LType = 0 then
        return ADAM_LSP_TOKEN_TYPE;
      end;
      match self.FTree[LType].Kind of
        NodeKind.RecordType, NodeKind.AnonRecord, NodeKind.OverlayType, NodeKind.AnonOverlay:
          return ADAM_LSP_TOKEN_STRUCT;
        NodeKind.ObjectType:
          return ADAM_LSP_TOKEN_CLASS;
        NodeKind.InterfaceType:
          return ADAM_LSP_TOKEN_INTERFACE;
        NodeKind.ChoicesType:
          return ADAM_LSP_TOKEN_ENUM;
      else
      end;
      return ADAM_LSP_TOKEN_TYPE;
    end;

    // The kind the declaration AId declares (ADAM_LSP_TOKEN_NONE: none of a name's)
    hidden const method DoKindOf(const AId: int64): int64;
    begin
      match self.FTree[AId].Kind of
        NodeKind.VarDecl, NodeKind.ConstDecl:
          return ADAM_LSP_TOKEN_VARIABLE;
        NodeKind.Param:
          return ADAM_LSP_TOKEN_PARAMETER;
        NodeKind.FieldDecl, NodeKind.EmbedDecl, NodeKind.PropertyDecl:
          return ADAM_LSP_TOKEN_PROPERTY;
        NodeKind.RoutineDecl, NodeKind.ForwardRoutine, NodeKind.IntrinsicDecl:
          return ADAM_LSP_TOKEN_FUNCTION;
        NodeKind.MethodDecl, NodeKind.InitDecl, NodeKind.CopyDecl, NodeKind.DoneDecl,
        NodeKind.OperatorDecl:
          return ADAM_LSP_TOKEN_METHOD;
        NodeKind.TypeDecl:
          return self.DoTypeKind(AId);
        NodeKind.ForwardType:
          // The type it announces, when the check found it
          if self.FTree[AId].ResolvedDecl <> 0 then
            return self.DoTargetKind(self.FTree[AId].ResolvedDecl);
          end;
          return ADAM_LSP_TOKEN_TYPE;
        NodeKind.BuiltinTypeDecl:
          return ADAM_LSP_TOKEN_TYPE;
        NodeKind.ChoiceValue:
          return ADAM_LSP_TOKEN_ENUM_MEMBER;
        NodeKind.GenericParam:
          return ADAM_LSP_TOKEN_TYPE_PARAMETER;
        NodeKind.Module, NodeKind.Import:
          return ADAM_LSP_TOKEN_NAMESPACE;
      else
      end;
      return ADAM_LSP_TOKEN_NONE;
    end;

    // The modifiers the declaration AId's name carries apart from declaration
    hidden const method DoModifiersOf(const AId: int64): int64;
    begin
      if self.FTree[AId].Kind = NodeKind.ConstDecl then
        return ADAM_LSP_MODIFIER_READONLY;
      end;
      return 0;
    end;

    // A generic's instance stands for the declaration it clones (its Instance child)
    hidden const method DoTarget(const ADecl: int64): int64;
    var
      LClone: int64;
    begin
      if (ADecl <> 0) and (self.FTree[ADecl].Kind = NodeKind.GenericInstance) then
        LClone := self.FTree.FirstOf(ADecl, NodeRole.Instance);
        if LClone <> 0 then
          return LClone;
        end;
      end;
      return ADecl;
    end;

    // The kind a use of the declaration ADecl is (none: 0, unresolved)
    hidden const method DoTargetKind(const ADecl: int64): int64;
    var
      LDecl: int64;
    begin
      LDecl := self.DoTarget(ADecl);
      if LDecl = 0 then
        return ADAM_LSP_TOKEN_NONE;
      end;
      return self.DoKindOf(LDecl);
    end;

    // The modifiers a use of the declaration ADecl carries
    hidden const method DoTargetModifiers(const ADecl: int64): int64;
    var
      LDecl: int64;
    begin
      LDecl := self.DoTarget(ADecl);
      if LDecl = 0 then
        return 0;
      end;
      return self.DoModifiersOf(LDecl);
    end;

    // -- The Lexer's pass

    // The document's tokens coloured into FData (see the header)
    hidden method DoLex();
    var
      LSource: ref SourceText;
      LScratch: ref Diagnostics;
      LLexer: ref Lexer;
      LTokens: TokenList;
      LToken: ref Token;
      LI: int64;
      LAt: int64;
      LPending: int64;
      LFinal: LSPClaim;
      LFilter: ref ConditionalFilter;
      LActive: TokenList;
      LActiveAt: ref Int64Map;
    begin
      LSource := ref SourceText(self.FDocument.Path, self.FDocument.Text);
      LScratch := ref Diagnostics(ADAM_LSP_TOKENS_BUDGET);
      LLexer := ref Lexer(LSource, LScratch);
      LTokens := LLexer.ReadAll();
      // The tokens the parser saw, by offset: the check's target and level settle the branches
      LActiveAt := ref Int64Map(-1);
      if self.FWalked then
        LFilter := ref ConditionalFilter(LScratch);
        LActive := LFilter.Filter(LTokens, self.FTree.Triple, "", "", self.FTree.Level, true,
          OptLevel.Debug, false);
        for LI := 0 to LActive.Count - 1 do
          LActiveAt.Put(LActive[LI].StartOffset, LI);
        end;
      end;
      // The dotted parts still to come of a claim, and its last part's colour
      LPending := 0;
      for LI := 0 to LTokens.Count - 1 do
        LToken := LTokens[LI];
        if LToken.Kind = TokenKind.EndOfFile then
          leave;
        end;
        if LToken.Kind = TokenKind.Identifier then
          if LPending > 0 then
            LPending := LPending - 1;
            if LPending = 0 then
              self.DoEmit(LToken, LFinal.TokenType, LFinal.Modifiers);
            else
              self.DoEmit(LToken, ADAM_LSP_TOKEN_NAMESPACE, 0);
            end;
          else
            LAt := self.FClaimAt.Find(LToken.StartOffset);
            if LAt >= 0 then
              LFinal := self.FClaims[LAt];
              if LFinal.Parts > 1 then
                LPending := LFinal.Parts - 1;
                self.DoEmit(LToken, ADAM_LSP_TOKEN_NAMESPACE, 0);
              else
                self.DoEmit(LToken, LFinal.TokenType, LFinal.Modifiers);
              end;
            else
              if self.FWalked and (LActiveAt.Find(LToken.StartOffset) >= 0) and
                not self.DoIsQuiet(LToken.StartOffset) then
                self.DoEmit(LToken, ADAM_LSP_TOKEN_KEYWORD, 0);
              end;
            end;
          end;
        else
          // A dotted name's '.' keeps its parts coming; anything else ends them
          if LToken.Kind <> TokenKind.Dot then
            LPending := 0;
          end;
          if IsTypeWordKind(LToken.Kind) then
            self.DoEmit(LToken, ADAM_LSP_TOKEN_TYPE, 0);
          else
            if IsKeywordKind(LToken.Kind) then
              self.DoEmit(LToken, ADAM_LSP_TOKEN_KEYWORD, 0);
            else
              if LToken.Kind = TokenKind.Directive then
                self.DoEmit(LToken, ADAM_LSP_TOKEN_MACRO, 0);
              end;
            end;
          end;
        end;
      end;
    end;

    // AToken added to FData as AType with AModifiers (no colour: nothing; a token over two
    // lines: nothing)
    hidden method DoEmit(const AToken: ref Token; const AType: int64; const AModifiers: int64);
    var
      LLine: int64;
      LCharacter: int64;
      LEndLine: int64;
      LEndCharacter: int64;
      LCount: int64;
    begin
      if AType = ADAM_LSP_TOKEN_NONE then
        return;
      end;
      self.FDocument.PositionAt(AToken.StartOffset, self.FEncoding, LLine, LCharacter);
      self.FDocument.PositionAt(AToken.EndOffset, self.FEncoding, LEndLine, LEndCharacter);
      if (LEndLine <> LLine) or (LEndCharacter <= LCharacter) then
        return;
      end;
      LCount := len(self.FData);
      setlength(self.FData, LCount + 5);
      self.FData[LCount] := LLine - self.FLastLine;
      if LLine = self.FLastLine then
        self.FData[LCount + 1] := LCharacter - self.FLastCharacter;
      else
        self.FData[LCount + 1] := LCharacter;
      end;
      self.FData[LCount + 2] := LEndCharacter - LCharacter;
      self.FData[LCount + 3] := AType;
      self.FData[LCount + 4] := AModifiers;
      self.FLastLine := LLine;
      self.FLastCharacter := LCharacter;
    end;
  end;

// The semantic tokens of ADocument in AEncoding (see the header): the module AModule of
// ATree (the document's last check; nil / 0: no tree, the Lexer's colours alone), LSP's
// relative encoding, five numbers a token
public func SemanticTokens(const ADocument: ref LSPDocument; const ATree: ref SyntaxTree;
  const AModule: int64; const AEncoding: LSPEncoding): Int64Array;
var
  LColouring: ref LSPColouring;
begin
  LColouring := ref LSPColouring(ADocument, ATree, AEncoding);
  return LColouring.Run(AModule);
end;

end.
