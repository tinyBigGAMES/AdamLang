-------------------------------------------------------------------------------
  Adam.Compiler.Scopes.adam - The scope rule, once (BNF sec 1)

  What a scope declares, read straight from the tree: a node's own
  declarations are its children of a declaring kind (var, const, type,
  routine, forward, parameter) playing a declaring role (Declaration at
  module level, Local and Param in a routine or method, Statement among a
  block's or a match arm's statements). Members (fields, methods, choice
  values) are not bare names: they are reached through their type.

  FindDeclared     the first own declaration of a name in one scope, before
                   a byte offset (declare before use) or after it
  FindPublic       a unit's public declaration of a name (or the private one
                   it holds)
  FindSystem       a builtin type or an intrinsic of the system scope
  ModuleOf         the module a node is in
  MethodOwnerOf    the aggregate type whose method / init / copy / done /
                   operator / accessor encloses a node (0 outside any)

  Used by Semantics and, later, by the language server: one rule, one place.
*******************************************************************************/

module unit Adam.Compiler.Scopes;

import Adam.Compiler.AST;

// True for the kinds a scope declares by name
public routine IsDeclarationKind(const AKind: NodeKind): bool;
begin
  return (AKind = NodeKind.VarDecl) or (AKind = NodeKind.ConstDecl) or
    (AKind = NodeKind.TypeDecl) or (AKind = NodeKind.RoutineDecl) or
    (AKind = NodeKind.ForwardRoutine) or (AKind = NodeKind.ForwardType) or
    (AKind = NodeKind.Param);
end;

// True for the roles a declaration plays in the scope that holds it
public routine IsDeclaringRole(const ARole: NodeRole): bool;
begin
  return (ARole = NodeRole.Declaration) or (ARole = NodeRole.Local) or
    (ARole = NodeRole.Param) or (ARole = NodeRole.Statement);
end;

// True when AId is a declaration of its parent's scope (a declaring kind in a declaring
// role)
public routine IsScopeDeclaration(const ATree: ref SyntaxTree; const AId: int64): bool;
begin
  return IsDeclarationKind(ATree[AId].Kind) and IsDeclaringRole(ATree.RoleOf(AId));
end;

// True for the kinds a routine-like body hangs under (their Param and Local children are
// the body's scope)
public routine IsRoutineLike(const AKind: NodeKind): bool;
begin
  return (AKind = NodeKind.RoutineDecl) or (AKind = NodeKind.MethodDecl) or
    (AKind = NodeKind.InitDecl) or (AKind = NodeKind.CopyDecl) or
    (AKind = NodeKind.DoneDecl) or (AKind = NodeKind.OperatorDecl) or
    (AKind = NodeKind.PropertyRead) or (AKind = NodeKind.PropertyWrite);
end;

// The first own declaration of AName in the scope AScope that starts before ABefore
// (ABefore < 0: anywhere); 0 when it has none. Overloads share a name: the first is
// given, Semantics picks among them later
public routine FindDeclared(const ATree: ref SyntaxTree; const AScope: int64;
  const AName: string; const ABefore: int64): int64;
var
  LI: int64;
  LChild: int64;
begin
  for LI := 0 to ATree.ChildCount(AScope) - 1 do
    LChild := ATree.ChildAt(AScope, LI);
    if IsScopeDeclaration(ATree, LChild) and (ATree[LChild].Text = AName) and
      ((ABefore < 0) or (ATree[LChild].StartOffset < ABefore)) then
      return LChild;
    end;
  end;
  return 0;
end;

// The first own declaration of AName in AScope that starts at or after AAt (a use before
// its declaration); 0 when it has none
public routine FindLater(const ATree: ref SyntaxTree; const AScope: int64;
  const AName: string; const AAt: int64): int64;
var
  LI: int64;
  LChild: int64;
begin
  for LI := 0 to ATree.ChildCount(AScope) - 1 do
    LChild := ATree.ChildAt(AScope, LI);
    if IsScopeDeclaration(ATree, LChild) and (ATree[LChild].Text = AName) and
      (ATree[LChild].StartOffset >= AAt) then
      return LChild;
    end;
  end;
  return 0;
end;

// The unit AModule's public declaration of AName; 0 when it has none. AHidden gets the
// private declaration it holds (0 when none), so a caller can say which fault
public routine FindPublic(const ATree: ref SyntaxTree; const AModule: int64;
  const AName: string; var AHidden: int64): int64;
var
  LI: int64;
  LChild: int64;
begin
  AHidden := 0;
  for LI := 0 to ATree.CountOf(AModule, NodeRole.Declaration) - 1 do
    LChild := ATree.NthOf(AModule, NodeRole.Declaration, LI);
    if IsDeclarationKind(ATree[LChild].Kind) and (ATree[LChild].Text = AName) then
      if ATree[LChild].HasFlag(NodeFlag.Public) then
        return LChild;
      end;
      if AHidden = 0 then
        AHidden := LChild;
      end;
    end;
  end;
  return 0;
end;

// The system scope's builtin type or intrinsic named AName; 0 when none
public routine FindSystem(const ATree: ref SyntaxTree; const AName: string): int64;
var
  LI: int64;
  LChild: int64;
begin
  for LI := 0 to ATree.ChildCount(ADAM_AST_SYSTEM) - 1 do
    LChild := ATree.ChildAt(ADAM_AST_SYSTEM, LI);
    if ATree[LChild].Text = AName then
      return LChild;
    end;
  end;
  return 0;
end;

// The Module node AId is in (AId itself when it is one); 0 outside every module
public routine ModuleOf(const ATree: ref SyntaxTree; const AId: int64): int64;
var
  LAt: int64;
begin
  LAt := AId;
  while LAt <> 0 do
    if ATree[LAt].Kind = NodeKind.Module then
      return LAt;
    end;
    LAt := ATree.ParentOf(LAt);
  end;
  return 0;
end;

// The kind the expression AId is used as: a unit-qualified name `Unit.Name` (a member
// access whose operand names a unit, ResolvedUnit on that operand; BNF sec 1) is the bare
// name of its ResolvedDecl, so NameExpression; any other node its own kind. Every check
// that takes a name (a place, an assignable target, a call's callee, a value) asks this,
// never the node's Kind, so the qualified form means exactly what the bare one does
public routine NameKindOf(const ATree: ref SyntaxTree; const AId: int64): NodeKind;
var
  LOperand: int64;
begin
  if ATree[AId].Kind <> NodeKind.MemberExpression then
    return ATree[AId].Kind;
  end;
  LOperand := ATree.FirstOf(AId, NodeRole.Operand);
  if (LOperand <> 0) and (ATree[LOperand].ResolvedUnit <> 0) then
    return NodeKind.NameExpression;
  end;
  return NodeKind.MemberExpression;
end;

// True when AId is a module-level declaration that is not public: it is its module's
// alone (BNF decision row 20), so nothing of it meets another module's, its symbol included
public routine IsModulePrivate(const ATree: ref SyntaxTree; const AId: int64): bool;
begin
  if ATree[ATree.ParentOf(AId)].Kind <> NodeKind.Module then
    return false;
  end;
  return not ATree[AId].HasFlag(NodeFlag.Public);
end;

// The aggregate type (record or object) whose method, init, copy, done, operator or
// property accessor encloses AId; 0 when none does
public routine MethodOwnerOf(const ATree: ref SyntaxTree; const AId: int64): int64;
var
  LAt: int64;
  LParent: int64;
begin
  LAt := AId;
  while LAt <> 0 do
    if IsRoutineLike(ATree[LAt].Kind) and (ATree[LAt].Kind <> NodeKind.RoutineDecl) then
      LParent := ATree.ParentOf(LAt);
      // An accessor hangs under its property, the property under the type
      if ATree[LParent].Kind = NodeKind.PropertyDecl then
        LParent := ATree.ParentOf(LParent);
      end;
      return LParent;
    end;
    LAt := ATree.ParentOf(LAt);
  end;
  return 0;
end;

// The member of the aggregate type AType named AName (a field, method, property or
// embed); 0 when it has none
public routine FindMember(const ATree: ref SyntaxTree; const AType: int64;
  const AName: string): int64;
var
  LI: int64;
  LChild: int64;
begin
  for LI := 0 to ATree.CountOf(AType, NodeRole.Member) - 1 do
    LChild := ATree.NthOf(AType, NodeRole.Member, LI);
    if ATree[LChild].Text = AName then
      return LChild;
    end;
  end;
  return 0;
end;

end.
