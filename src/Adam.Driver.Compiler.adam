-------------------------------------------------------------------------------
  Adam.Driver.Compiler.adam - The orchestrator

  Compiler      one compile: the one Diagnostics owner (every phase reports
                into it), the build's SourceFiles and the whole-program AST.
                Made, it adds the compiler's module path (the standard
                library's folder, $P:res/libs/std, BNF sec 1); Check runs
                the front end on one program; Build checks it, then (no
                error) lowers it, picks its backend and generates its exe
                into the output folder; PrintReports and ExitCode close the
                compile out
  BuildPhase    the phases a compile tells its listener about, in their
                order: Parse, Analyze (Check's), Lower, Generate, Link
                (Build's)
  PhaseListener told by the Compiler as each phase ends while no error is
                reported (SetListener; none by default), with that
                phase's counts read from what the phase made: Parse the
                AST's modules and the loaded files' lines, Analyze none,
                Lower the SSA's functions, Generate the code sections'
                bytes, Link the exe written and the libraries it imports.
                After the first error it hears nothing more. The Compiler
                still prints nothing: the listener (the CLI's) does

  The build's project (Adam.Driver.Project, PaskalCPP's rule): the nearest
  project.toml at or above the main module. None is a plain build; one that
  is there must load and validate, else its PJ reports stop the compile.
  The build is that project's only when the main module IS its main: then
  $R: is its folder for every file of the build, its output folder takes
  part in the order below, and its type must be the main module's kind
  (DR0010 at the header; a unit is the parser's). Any other file under it
  builds as a plain file, with no $R:.

  Build's output folder (BNF sec 2, @outputpath): the one the command line
  gives, else the main module's @outputpath (resolved at its directive),
  else a project build's output folder, else output under the working
  folder; made when it is not there. The exe
  is the main module's name with the format's exe ending. Its libraries are
  searched in every module's @addlibrarypath folders, in module and
  directive order, then res/libs/vendor/<triple> and res/libs/system/<triple>
  beside adam.exe (the picked target's triple), then where the target's OS
  keeps its own. A dll or lib
  main module is DR0009 at its header (their output is M8's; Lowering itself
  lowers their routines). A malformed IR out of Lowering raises: a compiler
  bug, never a report.

  The front end has no phase gate (PROJECT.md, Frontend contracts): once
  the main module has a header, names, types, layouts and symbols all run,
  each within the error budget, so one compile reports every phase's
  errors. A Compiler checks one program: a second Check is a defect in the
  caller (DR0003).

  PickTarget picks the program's Target from the triple its main module
  settled; every phase that needs a target fact is handed it. A triple
  with no target is DR0004 and no target: layouts and symbols are left
  undone rather than guessed (M1.12). PickBackend picks the code generator
  (Adam.Backend.Targets) the same way: a triple with a target but no
  backend is DR0006, and no code is generated.
*******************************************************************************/

module unit Adam.Driver.Compiler;

import System.SysUtils, System.Windows, Adam.Core.Common, Adam.Core.Messages, Adam.Target,
  Adam.Target.Registry,
  Adam.Compiler.SourceText, Adam.Compiler.Diagnostics, Adam.Compiler.SourceFiles,
  Adam.Compiler.AST, Adam.Compiler.Parser, Adam.Compiler.Semantics, Adam.Compiler.Layout,
  Adam.Compiler.Symbols, Adam.Backend.Ssa, Adam.Backend.Lowering, Adam.Backend.Sections,
  Adam.Backend.Targets, Adam.Backend.Generate, Adam.Driver.Project;

public const
  ADAM_ERR_DRIVER_001: string = "DR0001";
  ADAM_ERR_DRIVER_002: string = "DR0002";
  ADAM_ERR_DRIVER_003: string = "DR0003";
  ADAM_ERR_DRIVER_004: string = "DR0004";   // the program's triple names no target Adam has
  ADAM_ERR_DRIVER_005: string = "DR0005";   // the runtime's folder cannot be told
  ADAM_ERR_DRIVER_006: string = "DR0006";   // the program's triple has no backend
  ADAM_ERR_DRIVER_007: string = "DR0007";   // the output folder cannot be made
  ADAM_ERR_DRIVER_008: string = "DR0008";   // the exe cannot be written
  ADAM_ERR_DRIVER_009: string = "DR0009";   // a main module build cannot output yet (dll / lib: M8)
  ADAM_ERR_DRIVER_010: string = "DR0010";   // project.toml's type is not the main module's kind

  // Build's output folder when neither the command line nor @outputpath names one: under
  // the working folder (BNF sec 2)
  ADAM_DRIVER_OUTPUT_DIR: string = "output";

  // The directives Build reads from the AST (their arguments resolved at the directive)
  ADAM_DRIVER_DIRECTIVE_OUTPUT: string = "@outputpath";
  ADAM_DRIVER_DIRECTIVE_LIBRARY: string = "@addlibrarypath";

  // Raised (an invariant broken) by a malformed IR out of Lowering
  ADAM_DRIVER_FAULT_IR: string = "Driver: Lowering made a malformed IR: ";

  // How many errors one compile keeps; the first one past it leaves one DG0001
  ADAM_DRIVER_ERROR_BUDGET: int64 = 100;

  // The compiler's module path: the standard library's folder beside adam.exe (BNF sec 1)
  ADAM_DRIVER_STD_MODULE_PATH: string = "$P:res/libs/std";

  // The runtime unit every program carries as an implicit import, and its folder beside
  // adam.exe (DESIGN sec 8)
  ADAM_DRIVER_RUNTIME_UNIT: string = "System.Runtime";
  ADAM_DRIVER_RUNTIME_MODULE_PATH: string = "$P:res/runtime";

  // The library folders beside adam.exe, each followed by the picked target's triple: vendor
  // static libraries (searched first), then the system archives (the C runtime's static
  // extras and compiler support routines)
  ADAM_DRIVER_VENDOR_LIBRARY_PATH: string = "$P:res/libs/vendor/";
  ADAM_DRIVER_SYSTEM_LIBRARY_PATH: string = "$P:res/libs/system/";

  // The exit codes of a compile: clean (hints and warnings allowed), or an error reported
  ADAM_DRIVER_EXIT_OK: int32 = 0;
  ADAM_DRIVER_EXIT_ERRORS: int32 = 1;

// The Target of the program in ATree, picked once from the triple its main module AMain
// settled (ATree.Triple): the registry's (Adam.Target.Registry). None (a triple Adam has no
// target for) is DR0004 at the main module, reported into AReports, and nil: nothing is
// laid out or named, never a guessed target. A found target's facts the target-free
// phases read from the AST are written into it here (clong / culong's width)
public routine PickTarget(const ATree: ref SyntaxTree; const AMain: int64;
  const AReports: ref Diagnostics): ref Target;
var
  LTarget: ref Target;
begin
  LTarget := FindTarget(ATree.Triple);
  if LTarget = nil then
    AReports.Add(Severity.Error, ADAM_ERR_DRIVER_004, ATree[AMain].Place,
      ADAM_MSG_DRIVER_NO_TARGET, NoArgs().Str(ATree.Triple).Str(KnownTriples()));
    return nil;
  end;
  ATree.SetCLongBits(LTarget.CLongSize() * 8);
  return LTarget;
end;

// The Backend (Adam.Backend.Targets) that generates code for ATriple, the triple of a
// program whose front end found a target. None is DR0006 at APlace (the main module),
// reported into AReports, and nil: no code is generated
public routine PickBackend(const ATriple: string; const APlace: SourcePlace;
  const AReports: ref Diagnostics): ref Backend;
var
  LBackend: ref Backend;
begin
  LBackend := BackendFor(ATriple);
  if LBackend = nil then
    AReports.Add(Severity.Error, ADAM_ERR_DRIVER_006, APlace, ADAM_MSG_DRIVER_NO_BACKEND,
      NoArgs().Str(ATriple).Str(KnownBackends()));
  end;
  return LBackend;
end;

public type
  // The phases a compile reports as each ends, in their order (see the header)
  BuildPhase = choices(Parse, Analyze, Lower, Generate, Link);

  // Told as each phase ends with no error reported (see the header); this one hears
  // nothing: a caller that shows the phases overrides PhaseEnded
  PhaseListener = object
    // APhase ended. Parse: AFirst modules, ASecond lines. Analyze: nothing. Lower: AFirst
    // functions. Generate: AFirst code bytes. Link: AText the exe's path, AFirst the
    // libraries it imports. A count a phase has not is 0, a text ""
    virtual method PhaseEnded(const APhase: BuildPhase; const AFirst: int64;
      const ASecond: int64; const AText: string);
    begin
    end;
  end;

  // One compile (see the header)
  Compiler = object
    hidden FReports: ref Diagnostics;
    hidden FSources: ref SourceFiles;
    hidden FTree: ref SyntaxTree;
    hidden FTarget: ref Target;
    hidden FMain: int64;
    hidden FChecked: bool;
    hidden FOverrideTarget: string;
    hidden FExePath: string;
    hidden FListener: ref PhaseListener;
    // The project this build is (DoFindProject): set only when the main module is its
    // project.toml's main; "" / Exe for a plain build
    hidden FProjectRoot: string;
    hidden FProjectOutput: string;
    hidden FProjectKind: ModuleKind;
    // The main module's resolved path (Check)
    hidden FMainPath: string;

    // Tells the listener (when there is one) APhase ended, while no error is reported
    hidden method DoPhaseEnded(const APhase: BuildPhase; const AFirst: int64;
      const ASecond: int64; const AText: string);
    begin
      if (self.FListener = nil) or self.FReports.HasErrors() then
        return;
      end;
      self.FListener.PhaseEnded(APhase, AFirst, ASecond, AText);
    end;

    // The lines of every file the build loaded
    hidden const method DoLineCount(): int64;
    var
      LLines: int64;
      LI: int64;
    begin
      LLines := 0;
      for LI := 0 to self.FSources.Count - 1 do
        LLines := LLines + int64(self.FSources[LI].LineCount);
      end;
      return LLines;
    end;

    // The bytes of every code section in ASet
    hidden const method DoCodeBytes(const ASet: ref SectionSet): int64;
    var
      LBytes: int64;
      LId: int64;
    begin
      LBytes := 0;
      for LId := 1 to ASet.SectionCount - 1 do
        if ASet.SectionAt(LId).Kind = SectionKind.Code then
          LBytes := LBytes + ASet.SectionAt(LId).Size();
        end;
      end;
      return LBytes;
    end;

    // Adds the folder APath ($P: adam.exe's folder) as the next module path. When the
    // folder of adam.exe cannot be told, ACode warns with ATemplate and imports are looked
    // for without it
    hidden method DoAddModulePath(const APath: string; const ACode: string; const ATemplate: string);
    var
      LDir: string;
    begin
      LDir := ResolvePath(APath);
      if LDir = "" then
        self.FReports.Add(Severity.Warning, ACode, NoPlace(), ATemplate, NoArgs().Str(APath));
        return;
      end;
      self.FSources.AddModulePath(LDir);
    end;

    // The standard library's folder as the first module path (DR0001), the runtime's next
    // (DR0005: where the implicit runtime unit is found)
    hidden method DoAddStdPath();
    begin
      self.DoAddModulePath(ADAM_DRIVER_STD_MODULE_PATH, ADAM_ERR_DRIVER_001, ADAM_MSG_DRIVER_NO_STD);
      self.DoAddModulePath(ADAM_DRIVER_RUNTIME_MODULE_PATH, ADAM_ERR_DRIVER_005,
        ADAM_MSG_DRIVER_NO_RUNTIME);
    end;

    init();
    begin
      self.FReports := ref Diagnostics(ADAM_DRIVER_ERROR_BUDGET);
      self.FSources := ref SourceFiles();
      self.FTree := ref SyntaxTree();
      self.FTarget := nil;
      self.FMain := 0;
      self.FChecked := false;
      self.FOverrideTarget := "";
      self.FExePath := "";
      self.FListener := nil;
      self.FProjectRoot := "";
      self.FProjectOutput := "";
      self.FProjectKind := ModuleKind.Exe;
      self.FMainPath := "";
      self.DoAddStdPath();
    end;

    // The nearest project.toml at or above the main module APath (resolved), loaded. None is
    // a plain build (projects are opt-in); one that is there must load (false: its reports
    // stop the compile). The build is that project's only when APath is its main module:
    // then its root ($R:), output folder and kind are the build's
    hidden method DoFindProject(const APath: string): bool;
    var
      LProject: ref Project;
      LRoot: string;
    begin
      self.FProjectRoot := "";
      self.FProjectOutput := "";
      self.FProjectKind := ModuleKind.Exe;
      LProject := ref Project(self.FReports);
      LRoot := LProject.Find(APath);
      if self.FReports.HasErrors() then
        return false;
      end;
      if LRoot = "" then
        return true;
      end;
      if not LProject.Load(LRoot) then
        return false;
      end;
      if SamePath(LProject.MainPath(), APath) then
        self.FProjectRoot := LProject.Root;
        self.FProjectOutput := LProject.OutputPath();
        self.FProjectKind := LProject.Kind;
      end;
      return true;
    end;

    // A project build's main module must be the kind project.toml's type says (DR0010 at its
    // header); a unit, or a module with no kind, is left to the parser
    hidden method DoCheckProjectKind();
    var
      LKind: ModuleKind;
    begin
      if (self.FProjectRoot = "") or (self.FMain = 0) then
        return;
      end;
      LKind := self.FTree[self.FMain].Module;
      if (LKind = ModuleKind.Unit) or (LKind = ModuleKind.None) then
        return;
      end;
      if LKind <> self.FProjectKind then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_010, self.FTree[self.FMain].Place,
          ADAM_MSG_DRIVER_PROJECT_KIND, NoArgs().Str(ProjectKindText(self.FProjectKind))
          .Str(self.FMainPath));
      end;
    end;

    // AListener is told as each phase ends (see the header); nil for none. Before Check
    method SetListener(const AListener: ref PhaseListener);
    begin
      self.FListener := AListener;
    end;

    // The triple ATriple (a target the registry has, three-part) as the build's target,
    // whatever the main module's @target says: the command line's -t. Before Check
    method SetTarget(const ATriple: string);
    begin
      self.FOverrideTarget := ATriple;
    end;

    // Adds the folder ADir (a resolved path) after the module paths already there: for a
    // caller that runs the compiler in its own process, whose $P: is not adam.exe's folder
    // (a probe, later the language server). Before Check
    method AddModulePath(const ADir: string);
    begin
      self.FSources.AddModulePath(ADir);
    end;

    // The compile's reports: every phase's, and the caller's own (a command line's)
    property Reports: ref Diagnostics read FReports;

    // The whole-program AST, filled by Check
    property Tree: ref SyntaxTree read FTree;

    // The main module's id in Tree; 0 before Check, or when the main file cannot be read
    // or has no module header
    property MainModule: int64 read FMain;

    // The program's Target, picked by Check; nil before Check, when the main module has no
    // header, or when its triple names no target (DR0004)
    property PickedTarget: ref Target read FTarget;

    // The exe Build wrote (its resolved path, '/' form); "" before Build, or when Build
    // wrote none
    property ExePath: string read FExePath;

    // Runs the front end on the program whose main module is the file AMainPath (resolved
    // against the current folder, so the main module's folder is a full path imports and
    // $S: paths start from): parse (imports recurse into the one AST), names, types,
    // layouts, symbols. Everything goes to Reports; nothing is printed
    method Check(const AMainPath: string);
    var
      LPath: string;
    begin
      if self.FChecked then
        self.FReports.Add(Severity.Fatal, ADAM_ERR_DRIVER_003, NoPlace(),
          ADAM_MSG_DRIVER_CHECK_TWICE, NoArgs().Str(AMainPath));
        return;
      end;
      self.FChecked := true;
      LPath := ResolvePath(AMainPath);
      if LPath = "" then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_002, NoPlace(),
          ADAM_MSG_DRIVER_BAD_PATH, NoArgs().Str(AMainPath));
        return;
      end;
      self.FMainPath := LPath;
      // The build's project, found from the main module (a missing file is the parser's to
      // report, with no project looked for); an invalid project.toml stops the compile
      if FileExists(LPath) and not self.DoFindProject(LPath) then
        return;
      end;
      // $R: in every file of the build: the project's root when the main module is its main
      self.FSources.SetProjectRoot(self.FProjectRoot);
      self.FMain := ParseProgramWith(self.FTree, self.FReports, self.FSources, LPath,
        ADAM_DRIVER_RUNTIME_UNIT, self.FOverrideTarget);
      if self.FMain = 0 then
        return;
      end;
      // Reported, never a gate: the front end still runs
      self.DoCheckProjectKind();
      self.DoPhaseEnded(BuildPhase.Parse, self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module),
        self.DoLineCount(), "");
      self.FTarget := PickTarget(self.FTree, self.FMain, self.FReports);
      ResolveNames(self.FTree, self.FReports);
      CheckTypes(self.FTree, self.FTarget, self.FReports);
      CheckLayouts(self.FTree, self.FTarget, self.FReports);
      NameSymbols(self.FTree, self.FTarget, self.FReports);
      self.DoPhaseEnded(BuildPhase.Analyze, 0, 0, "");
    end;

    // The resolved path of the first argument of every directive spelled ASpelling in the
    // module AModule, in their order (a directive whose path did not resolve was reported
    // there and adds nothing), appended to AList
    hidden const method DoDirectivePaths(const AModule: int64; const ASpelling: string;
      var AList: StringArray);
    var
      LDirective: int64;
      LArg: int64;
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Directive) - 1 do
        LDirective := self.FTree.NthOf(AModule, NodeRole.Directive, LI);
        if (self.FTree[LDirective].Text = ASpelling) and
          (self.FTree.CountOf(LDirective, NodeRole.Argument) > 0) then
          LArg := self.FTree.NthOf(LDirective, NodeRole.Argument, 0);
          if self.FTree[LArg].ResolvedPath <> "" then
            setlength(AList, len(AList) + 1);
            AList[len(AList) - 1] := self.FTree[LArg].ResolvedPath;
          end;
        end;
      end;
    end;

    // The folder APrefix + the picked target's triple appended to AList; nothing when the
    // folder of adam.exe cannot be told (DR0001 already said so)
    hidden method DoAddTargetLibraryPath(const APrefix: string; var AList: StringArray);
    var
      LDir: string;
    begin
      LDir := ResolvePath(APrefix + self.FTarget.Triple());
      if LDir <> "" then
        setlength(AList, len(AList) + 1);
        AList[len(AList) - 1] := LDir;
      end;
    end;

    // Every module's @addlibrarypath folders, in module order, each module's in its order;
    // then the vendor and the system library folders of the picked target
    hidden method DoLibraryPaths(): StringArray;
    var
      LList: StringArray;
      LI: int64;
    begin
      setlength(LList, 0);
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        self.DoDirectivePaths(self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI),
          ADAM_DRIVER_DIRECTIVE_LIBRARY, LList);
      end;
      self.DoAddTargetLibraryPath(ADAM_DRIVER_VENDOR_LIBRARY_PATH, LList);
      self.DoAddTargetLibraryPath(ADAM_DRIVER_SYSTEM_LIBRARY_PATH, LList);
      return LList;
    end;

    // The output folder (see the header): AOutputDir when not empty, resolved against the
    // working folder; else the main module's @outputpath; else a project build's output
    // folder; else output under the working folder. "" when it cannot be resolved
    hidden const method DoOutputDir(const AOutputDir: string): string;
    var
      LList: StringArray;
    begin
      if AOutputDir <> "" then
        return ResolvePath(AOutputDir);
      end;
      setlength(LList, 0);
      self.DoDirectivePaths(self.FMain, ADAM_DRIVER_DIRECTIVE_OUTPUT, LList);
      if len(LList) > 0 then
        return LList[0];
      end;
      if self.FProjectOutput <> "" then
        return self.FProjectOutput;
      end;
      return ResolvePath(ADAM_DRIVER_OUTPUT_DIR);
    end;

    // Check on the program whose main module is AMainPath, then, when nothing stops it, its
    // exe generated into the output folder AOutputDir ("" for the default; see the header).
    // Everything goes to Reports; nothing is printed
    method Build(const AMainPath: string; const AOutputDir: string);
    var
      LModule: ref IrModule;
      LProblems: StringArray;
      LBackend: ref Backend;
      LSet: ref SectionSet;
      LLibraries: StringArray;
      LBytes: ByteArray;
      LDir: string;
      LExe: string;
    begin
      self.Check(AMainPath);
      if (self.FMain = 0) or self.FReports.HasErrors() then
        return;
      end;
      // A dll or lib main module: its output is not made yet (a unit is PR0004 already)
      if self.FTree[self.FMain].Module <> ModuleKind.Exe then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_009, self.FTree[self.FMain].Place,
          ADAM_MSG_DRIVER_NOT_EXE, NoArgs().Str(self.FTree[self.FMain].Text)
          .Str(LowerCase(ModuleKindText(self.FTree[self.FMain].Module))));
        return;
      end;
      LModule := LowerProgram(self.FTree, self.FTarget, self.FReports);
      if self.FReports.HasErrors() then
        return;
      end;
      LProblems := LModule.Verify();
      if len(LProblems) > 0 then
        raise(ADAM_DRIVER_FAULT_IR + JoinStrings(LProblems, "; "));
      end;
      // Function ids start at 1: id 0 is none (Adam.Backend.Ssa)
      self.DoPhaseEnded(BuildPhase.Lower, LModule.FunctionCount - 1, 0, "");
      LBackend := PickBackend(self.FTree.Triple, self.FTree[self.FMain].Place, self.FReports);
      if LBackend = nil then
        return;
      end;
      LSet := GenerateSections(LModule, LBackend);
      self.DoPhaseEnded(BuildPhase.Generate, self.DoCodeBytes(LSet), 0, "");
      setlength(LLibraries, 0);
      LBytes := LinkSections(LModule, LSet, LBackend, self.DoLibraryPaths(), self.FTree,
        self.FReports, LLibraries);
      if self.FReports.HasErrors() then
        return;
      end;
      LDir := self.DoOutputDir(AOutputDir);
      if LDir = "" then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_007, NoPlace(),
          ADAM_MSG_DRIVER_OUTPUT_DIR, NoArgs().Str(AOutputDir));
        return;
      end;
      if not ForceDirectories(LDir) then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_007, NoPlace(),
          ADAM_MSG_DRIVER_OUTPUT_DIR, NoArgs().Str(LDir));
        return;
      end;
      LExe := ResolvePath(self.FTree[self.FMain].Text + LBackend.Format.ExeExtension(), LDir);
      if (LExe = "") or not WriteAllBytes(LExe, LBytes) then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_008, NoPlace(),
          ADAM_MSG_DRIVER_WRITE_EXE, NoArgs().Str(LExe));
        return;
      end;
      self.FExePath := LExe;
      self.DoPhaseEnded(BuildPhase.Link, len(LLibraries), 0, LExe);
    end;

    // Prints every report, one line each, in the order made
    const method PrintReports();
    begin
      self.FReports.PrintAll();
    end;

    // ADAM_DRIVER_EXIT_ERRORS when a report stops the build (an Error or a Fatal), else
    // ADAM_DRIVER_EXIT_OK
    const method ExitCode(): int32;
    begin
      if self.FReports.HasErrors() then
        return ADAM_DRIVER_EXIT_ERRORS;
      end;
      return ADAM_DRIVER_EXIT_OK;
    end;
  end;

end.
