-------------------------------------------------------------------------------
  Adam.Driver.Compiler.adam - The orchestrator

  Compiler      one compile: the one Diagnostics owner (every phase reports
                into it), the build's SourceFiles and the whole-program AST.
                Made, it adds the compiler's module path (the standard
                library's folder, $P:res/libs/std, BNF sec 1); Check runs
                the front end on one program; Build checks it, then (no
                error) lowers it, picks its backend and generates its exe
                into the output folder; PrintReports and ExitCode close the
                compile out
  BuildPhase    the phases a compile tells its listener about, in their
                order: Parse, Analyze (Check's), Lower, Generate, Link
                (Build's)
  BuildStep     the steps a phase tells as they start: a unit's lower /
                optimize / generate / write, the program's parts, a unit's
                object merged
  PhaseListener told by the Compiler as each phase starts, as each of its
                steps starts (the unit, its place among the units the
                phase works) and as it ends, while no error is
                reported (SetListener; none by default), with that
                phase's counts read from what the phase made: Parse the
                AST's modules and the loaded files' lines, Analyze none,
                Lower the units the build compiled (its unit compiles'
                too) and the SSA functions they and the program's parts
                define, Generate the linked set's code bytes, Link the exe
                written and the libraries it imports.
                A unit compiled during Parse (a stale import) tells its
                steps under the build's Parse, through UnitContext.
                After the first error it hears nothing more. The Compiler
                still prints nothing: the listener (the CLI's) does

  The build's project (Adam.Driver.Project, PaskalCPP's rule): the nearest
  project.toml at or above the main module. None is a plain build; one that
  is there must load and validate, else its PJ reports stop the compile.
  The build is that project's only when the main module IS its main: then
  $R: is its folder for every file of the build, its output folder takes
  part in the order below, and its type must be the main module's kind
  (DR0010 at the header; a unit is the parser's). Any other file under it
  builds as a plain file, with no $R:.

  Build's output folder (BNF sec 2, @outputpath): the one the command line
  gives, else the main module's @outputpath (resolved at its directive),
  else a project build's output folder, else output under the working
  folder; made when it is not there. Its output is split by kind, then by
  the build's target triple and mode (SU2.5, Adam.Driver.Project's
  OutputPartPath): <output>\bin\<triple>\<mode>\ the exe (and later a dll /
  pdb), <output>\lib\<triple>\<mode>\ the static libs,
  <output>\acu\<triple>\<mode>\ the compiled units (SU2): a build takes each
  imported unit from its .acu when it is current (AcuPlan decides, AcuLoader
  loads; a stale unit is first compiled alone into its .acu, so an importer
  whose import changed only in private stays current) and compiles every
  module it parsed: lowered alone and generated, its object (with its
  payload) is its .acu (SU2.4b). A unit taken from its .acu is not lowered
  or generated again: the link merges every unit's .acu as it is on the
  disk, then the
  program's parts (a check parses every source). The exe, in bin, is the main
  module's name with the format's exe ending (a dll main module's: its dll
  ending, the image a dll exporting its public routines and variables,
  DoExports, M8a; its import library lib<name>.dll.a in lib, M8b). A lib main module
  links nothing: its static library lib<name>.a (its module, its start, its own units)
  and the runtime's companion libadamrt.a (the shared std and runtime units) go to lib
  (DoWriteLibraries, M8d). A dll or lib also writes its C header <name>.h into lib
  (DoWriteCHeader over Adam.Compiler.CHeader, M8g: its exported routines and variables
  C can call). Its libraries are
  searched in every module's @addlibrarypath folders, in module and
  directive order, then res/libs/vendor/<triple> and res/libs/system/<triple>
  beside adam.exe (the picked target's triple), then where the target's OS
  keeps its own. A malformed IR out of Lowering raises: a compiler bug, never
  a report.

  The front end has no phase gate (PROJECT.md, Frontend contracts): once
  the main module has a header, names, types, layouts and symbols all run,
  each within the error budget, so one compile reports every phase's
  errors. A Compiler checks one program: a second Check is a defect in the
  caller (DR0003).

  PickTarget picks the program's Target from the triple its main module
  settled; every phase that needs a target fact is handed it. A triple
  with no target is DR0004 and no target: layouts and symbols are left
  undone rather than guessed (M1.12). PickBackend picks the code generator
  (Adam.Backend.Targets) the same way: a triple with a target but no
  backend is DR0006, and no code is generated.
*******************************************************************************/

module unit Adam.Driver.Compiler;

import System.SysUtils, System.IO, Adam.Core.Common, Adam.Core.Containers,
  Adam.Core.Messages, Adam.Target,
  Adam.Target.Registry,
  Adam.Compiler.SourceText, Adam.Compiler.Diagnostics, Adam.Compiler.SourceFiles,
  Adam.Compiler.AST, Adam.Compiler.Conditionals, Adam.Compiler.Parser, Adam.Compiler.Semantics,
  Adam.Compiler.Layout, Adam.Compiler.CHeader,
  Adam.Compiler.Symbols, Adam.Backend.Ssa, Adam.Backend.Lowering, Adam.Backend.Sections,
  Adam.Backend.Parts, Adam.Backend.Targets, Adam.Backend.Generate, Adam.Opt.Analysis,
  Adam.Opt.Pipeline,
  Adam.Acu.Format, Adam.Acu.Writer, Adam.Acu.Reader, Adam.Driver.Project;

public const
  ADAM_ERR_DRIVER_001: string = "DR0001";
  ADAM_ERR_DRIVER_002: string = "DR0002";
  ADAM_ERR_DRIVER_003: string = "DR0003";
  ADAM_ERR_DRIVER_004: string = "DR0004";   // the program's triple names no target Adam has
  ADAM_ERR_DRIVER_005: string = "DR0005";   // the runtime's folder cannot be told
  ADAM_ERR_DRIVER_006: string = "DR0006";   // the program's triple has no backend
  ADAM_ERR_DRIVER_007: string = "DR0007";   // the output folder cannot be made
  ADAM_ERR_DRIVER_008: string = "DR0008";   // the exe cannot be written
  ADAM_ERR_DRIVER_010: string = "DR0010";   // project.toml's type is not the main module's kind
  ADAM_ERR_DRIVER_011: string = "DR0011";   // a unit's .acu cannot be written
  ADAM_ERR_DRIVER_012: string = "DR0012";   // a unit's .acu cannot be read for the link
  ADAM_ERR_DRIVER_013: string = "DR0013";   // the --emit-ir file cannot be written
  ADAM_ERR_DRIVER_014: string = "DR0014";   // the project's assets archive cannot be copied beside the exe
  ADAM_ERR_DRIVER_015: string = "DR0015";   // a dll's import library cannot be written
  ADAM_ERR_DRIVER_016: string = "DR0016";   // a lib's static library cannot be written
  ADAM_ERR_DRIVER_017: string = "DR0017";   // a dll's or lib's C header cannot be written

  // Build's output folder when neither the command line nor @outputpath names one: under
  // the working folder (BNF sec 2)
  ADAM_DRIVER_OUTPUT_DIR: string = "output";

  // The directives Build reads from the AST (their arguments resolved at the directive)
  ADAM_DRIVER_DIRECTIVE_OUTPUT: string = "@outputpath";
  ADAM_DRIVER_DIRECTIVE_LIBRARY: string = "@addlibrarypath";

  // Raised (an invariant broken) by a malformed IR out of Lowering
  ADAM_DRIVER_FAULT_IR: string = "Driver: Lowering made a malformed IR: ";
  // Raised (an invariant broken) when the parser loads a unit HasUnit did not find
  ADAM_DRIVER_FAULT_LOAD: string = "Driver: a compiled unit was loaded unfound: ";

  // How many errors one compile keeps; the first one past it leaves one DG0001
  ADAM_DRIVER_ERROR_BUDGET: int64 = 100;

  // The compiler's module path: the standard library's folder beside adam.exe (BNF sec 1)
  ADAM_DRIVER_STD_MODULE_PATH: string = "$P:res/libs/std";

  // The runtime unit every program carries as an implicit import, and its folder beside
  // adam.exe (DESIGN sec 8)
  ADAM_DRIVER_RUNTIME_UNIT: string = "System.Runtime";
  ADAM_DRIVER_RUNTIME_MODULE_PATH: string = "$P:res/runtime";

  // The shared compiled-unit cache (SU2.6): the std's and the runtime's units (their source in
  // one of the two folders above) keep their .acu in <res>\acu\<triple>\<mode>\ beside
  // adam.exe, one copy for every build; when that cannot be written, in this user's cache
  // (UserCacheDir) below ADAM_DRIVER_USER_CACHE_DIR, split the same way
  ADAM_DRIVER_SHARED_RES: string = "$P:res";
  ADAM_DRIVER_USER_CACHE_DIR: string = "Adam";

  // The library folders beside adam.exe, each followed by the picked target's triple: vendor
  // static libraries (searched first), then the system archives (the C runtime's static
  // extras and compiler support routines)
  ADAM_DRIVER_VENDOR_LIBRARY_PATH: string = "$P:res/libs/vendor/";
  ADAM_DRIVER_SYSTEM_LIBRARY_PATH: string = "$P:res/libs/system/";
  // A lib's start member's name after the lib's (M8d: <name>_start, the parts' object)
  ADAM_DRIVER_LIB_START_MEMBER: string = "_start";

  // The exit codes of a compile: clean (hints and warnings allowed), or an error reported
  ADAM_DRIVER_EXIT_OK: int32 = 0;
  ADAM_DRIVER_EXIT_ERRORS: int32 = 1;

// The Target of the program in ATree, picked once from the triple its main module AMain
// settled (ATree.Triple): the registry's (Adam.Target.Registry). None (a triple Adam has no
// target for) is DR0004 at the main module, reported into AReports, and nil: nothing is
// laid out or named, never a guessed target. A found target's facts the target-free
// phases read from the AST are written into it here (clong / culong's width)
public routine PickTarget(const ATree: ref SyntaxTree; const AMain: int64;
  const AReports: ref Diagnostics): ref Target;
var
  LTarget: ref Target;
begin
  LTarget := FindTarget(ATree.Triple);
  if LTarget = nil then
    AReports.Add(Severity.Error, ADAM_ERR_DRIVER_004, ATree[AMain].Place,
      ADAM_MSG_DRIVER_NO_TARGET, NoArgs().Str(ATree.Triple).Str(KnownTriples()));
    return nil;
  end;
  ATree.SetCLongBits(LTarget.CLongSize() * 8);
  return LTarget;
end;

// The Backend (Adam.Backend.Targets) that generates code for ATriple, the triple of a
// program whose front end found a target. None is DR0006 at APlace (the main module),
// reported into AReports, and nil: no code is generated
public routine PickBackend(const ATriple: string; const APlace: SourcePlace;
  const AReports: ref Diagnostics): ref Backend;
var
  LBackend: ref Backend;
begin
  LBackend := BackendFor(ATriple);
  if LBackend = nil then
    AReports.Add(Severity.Error, ADAM_ERR_DRIVER_006, APlace, ADAM_MSG_DRIVER_NO_BACKEND,
      NoArgs().Str(ATriple).Str(KnownBackends()));
  end;
  return LBackend;
end;

// The resolved path of the first argument of every directive spelled ASpelling in the
// module AModule of ATree, in their order (a directive whose path did not resolve was
// reported there and adds nothing), appended to AList
routine DoDirectivePathsOf(const ATree: ref SyntaxTree; const AModule: int64;
  const ASpelling: string; var AList: StringArray);
var
  LDirective: int64;
  LArg: int64;
  LI: int64;
begin
  for LI := 0 to ATree.CountOf(AModule, NodeRole.Directive) - 1 do
    LDirective := ATree.NthOf(AModule, NodeRole.Directive, LI);
    if (ATree[LDirective].Text = ASpelling) and
      (ATree.CountOf(LDirective, NodeRole.Argument) > 0) then
      LArg := ATree.NthOf(LDirective, NodeRole.Argument, 0);
      if ATree[LArg].ResolvedPath <> "" then
        setlength(AList, len(AList) + 1);
        AList[len(AList) - 1] := ATree[LArg].ResolvedPath;
      end;
    end;
  end;
end;

// The output folder (see the header) of the build whose main module is AMain in ATree:
// AOutputDir when not empty, resolved against the working folder; else the main module's
// @outputpath; else AProjectOutput (a project build's output folder); else output under the
// working folder. "" when it cannot be resolved
routine DoOutputRootOf(const ATree: ref SyntaxTree; const AMain: int64; const AOutputDir: string;
  const AProjectOutput: string): string;
var
  LList: StringArray;
begin
  if AOutputDir <> "" then
    return ResolvePath(AOutputDir);
  end;
  setlength(LList, 0);
  if AMain <> 0 then
    DoDirectivePathsOf(ATree, AMain, ADAM_DRIVER_DIRECTIVE_OUTPUT, LList);
  end;
  if len(LList) > 0 then
    return LList[0];
  end;
  if AProjectOutput <> "" then
    return AProjectOutput;
  end;
  return ResolvePath(ADAM_DRIVER_OUTPUT_DIR);
end;

// The folder of the output folder ARoot's part APart (ADAM_OUTPUT_BIN_DIR / _ACU_DIR) for
// ATree's triple and mode: <ARoot>\<APart>\<triple>\<mode>\ (Adam.Driver.Project's
// OutputPartPath); "" when it cannot be resolved
routine DoOutputPartOf(const ATree: ref SyntaxTree; const ARoot: string;
  const APart: string): string;
begin
  return OutputPartPath(ARoot, APart, ATree.Triple, AcuModeOf(ATree.Level));
end;

// Each node's place in ATree as "file(line,col)" (the file's name alone; "" for a node with
// none), indexed by node id: what the IR's Dump puts after each instruction (--emit-ir)
routine DoNodePlaces(const ATree: ref SyntaxTree): StringArray;
var
  LPlaces: StringArray;
  LPlace: SourcePlace;
  LI: int64;
begin
  setlength(LPlaces, ATree.Count);
  for LI := 1 to ATree.Count - 1 do
    LPlace := ATree[LI].Place;
    if LPlace.IsNone() then
      LPlaces[LI] := "";
    else
      LPlaces[LI] := ExtractFileName(LPlace.FileName) + "(" + IntToStr(int64(LPlace.Line)) +
        "," + IntToStr(int64(LPlace.Column)) + ")";
    end;
  end;
  return LPlaces;
end;

// AModule's IR checked (Adam.Backend.Ssa's Verify): a malformed IR is a compiler bug
routine DoVerifyIr(const AModule: ref IrModule);
var
  LProblems: StringArray;
begin
  LProblems := AModule.Verify();
  if len(LProblems) > 0 then
    raise(ADAM_DRIVER_FAULT_IR + JoinStrings(LProblems, "; "));
  end;
end;

// How many functions AModule defines (its declared ones are other units'; function ids
// start at 1: id 0 is none, Adam.Backend.Ssa)
routine DoDefinedFunctions(const AModule: ref IrModule): int64;
var
  LCount: int64;
  LF: int64;
begin
  LCount := 0;
  for LF := 1 to AModule.FunctionCount - 1 do
    if not AModule.FunctionAt(LF).Declared then
      LCount := LCount + 1;
    end;
  end;
  return LCount;
end;

// The external routines of the module AUnit in ATree by symbol (ResolvedSymbol -> the
// declaration): a link report about what one names (a symbol nothing defines, a routine
// its library lacks) is at its declaration (MergeObject's ANodes)
routine DoExternalNodes(const ATree: ref SyntaxTree; const AUnit: int64): ref StringIdMap;
var
  LNodes: ref StringIdMap;
  LDecl: int64;
  LI: int64;
begin
  LNodes := ref StringIdMap();
  for LI := 0 to ATree.CountOf(AUnit, NodeRole.Declaration) - 1 do
    LDecl := ATree.NthOf(AUnit, NodeRole.Declaration, LI);
    if (ATree[LDecl].Kind = NodeKind.RoutineDecl) and
      (ATree.FirstOf(LDecl, NodeRole.External) <> 0) and
      (LNodes.Find(ATree[LDecl].ResolvedSymbol) = 0) then
      LNodes.Put(ATree[LDecl].ResolvedSymbol, LDecl);
    end;
  end;
  return LNodes;
end;

// The compiler's identity an .acu's header carries: its version and its exe's size and
// write time, hashed (any other compiler build is another id)
routine DoCompilerId(): uint64;
var
  LExe: string;
begin
  LExe := ProgramFilePath();
  return Fnv1a64(AdamVersionText() + "|" + IntToStr(FileSize(LExe)) + "|" +
    IntToStr(FileWriteTime(LExe)));
end;

// The pack key an .acu's header carries for the build in ATree: its project's, 0 outside one
routine DoProjectKeyOf(const ATree: ref SyntaxTree): uint64;
begin
  if ATree.InProject then
    return ATree.ProjectKey;
  end;
  return 0;
end;

// The hash AHashes holds for the unit AName (0 when it has none: every module of a tree has
// one, DoUnitHashes)
routine DoHashIn(const AHashes: AcuUnitHashArray; const AName: string): uint64;
var
  LI: int64;
begin
  for LI := 0 to len(AHashes) - 1 do
    if AHashes[LI].UnitName = AName then
      return AHashes[LI].Hash;
    end;
  end;
  return 0;
end;

// The predefined symbols an .acu's header carries for the build in ATree (its triple and
// mode: Adam.Compiler.Conditionals' PredefinedSymbols), joined
routine DoDefinesOf(const ATree: ref SyntaxTree): string;
begin
  return JoinStrings(PredefinedSymbols(ATree.Triple, ATree.Level), ADAM_ACU_DEFINE_SEPARATOR);
end;

// The file of the unit AName's .acu in the folder ADir appended to AList; nothing when ADir
// is none ("") or the path does not resolve
routine DoAddAcuFile(var AList: StringArray; const ADir: string; const AName: string);
var
  LFile: string;
begin
  if ADir = "" then
    return;
  end;
  LFile := ResolvePath(AcuFileName(AName), ADir);
  if LFile <> "" then
    setlength(AList, len(AList) + 1);
    AList[len(AList) - 1] := LFile;
  end;
end;

type
  // A unit's compiled form waiting to be read: found current by HasUnit, read by LoadUnit
  AcuFound = record
    UnitName: string;
    Imports: StringArray;
    Payload: ByteArray;
  end;

  AcuFoundArray = array of AcuFound;

  // One .acu file as this build read it from the disk (AcuPlan's cache, read once): Found
  // when it was read, its bytes, the payload of its Info section (empty when it has none)
  // and Valid when that payload's header is of this format version (Header then holds it)
  AcuFile = record
    Path: string;
    Found: bool;
    Bytes: ByteArray;
    Payload: ByteArray;
    Valid: bool;
    Header: AcuHeader;
  end;

  AcuFileArray = array of AcuFile;

public type
  // Compiles one unit from its source into its .acu for the build an AcuPlan decides for
  // (the Compiler's own: a unit compile, see AcuPlan). This one compiles nothing
  UnitCompiler = object
    // True when the unit AName, its source the file APath, was checked with no error and its
    // .acu written (with every other unit that compile had to parse); its warnings and
    // hints then the build's. False: the build parses it from source and reports what it has
    virtual method CompileUnit(const AName: string; const APath: string): bool;
    begin
      return false;
    end;
  end;

type
  // Where a unit stands in an AcuPlan: being decided (its imports are), its .acu current,
  // or compiled from source by the tree that needs it
  AcuState = choices(Deciding, Current, Stale);

  // One unit an AcuPlan decided: its state, its .acu's header as last judged, and (Refresh)
  // the size and write time its source has now when only its write time moved and its bytes
  // are those compiled, so its .acu is written again with them. Shared: the unit is the std's
  // or the runtime's (AcuPlan.IsShared), its .acu in the shared cache
  AcuDecision = record
    UnitName: string;
    Shared: bool;
    State: AcuState;
    Header: AcuHeader;
    Refresh: bool;
    RefreshSize: int64;
    RefreshTime: int64;
  end;

  AcuDecisionArray = array of AcuDecision;

public type
  // The build's compiled units (SU2.2 / SU2.3, DESIGN sec 3), decided once per build and
  // shared by the build's AcuLoader and every unit compile's. A unit's .acu (in the build's
  // <output>\acu\<triple>\<mode>\ folder, DoOutputPartOf, settled once the main module's
  // prologue is parsed) is current when its header has this format version, the unit's
  // name, this compiler (DoCompilerId), the build's triple, mode, predefined symbols and
  // pack key, its source as found (the path, the size, then the write time, else the
  // text's Fnv1a64 when only the time moved), and for each import the interface hash that
  // import has now. A unit's imports are decided before it (each one compiled into its
  // .acu when not current), so a change in an import's private part leaves the unit
  // current, a change an importer can see makes it stale. A unit whose own source moved,
  // its .acu written by a build like this one (DoSameBuild) and its imports all current
  // (or in its cycle of imports), is compiled alone into its .acu by the UnitCompiler, then
  // judged again: its importers are then decided against its new interface. A unit with no
  // such .acu (none yet, another compiler, format or mode: every importer is stale too), or
  // stale only because an import's interface moved (its importers are stale with it), is
  // parsed from source by the tree that needs it, with no unit compile: one tree compiles
  // the whole chain. A unit an import of which cannot be compiled (an error), or whose own
  // compile fails, is parsed from source by the tree that needs it, which reports what it
  // has at the import that needs it.
  // A std or runtime unit (its source in the compiler's own std or runtime folder, IsShared)
  // keeps its .acu in the shared cache (SU2.6, ADAM_DRIVER_SHARED_RES): one copy for every
  // build of this compiler, project or not, so it is judged as outside a project (pack key
  // 0: a std or runtime unit never reads ProjectPassword, which a plain build refuses). Its
  // .acu is looked for in the shared folder, then in the user's (a read-only install); the
  // first current one is taken (PlaceOf), else the first there is (its header then says
  // what moved). One compiled is written to the shared folder, else the user's (WriteFiles).
  // Under --emit-ir (SetOwnFromSource) every unit that is not shared is stale: the build's
  // tree parses and compiles each one, so the .ir holds every unit of the program's own
  AcuPlan = object
    hidden FSources: ref SourceFiles;
    hidden FOwnFromSource: bool;
    hidden FCompiler: ref UnitCompiler;
    hidden FUnits: AcuDecisionArray;
    hidden FReady: bool;
    hidden FDir: string;
    hidden FBackend: ref Backend;
    hidden FCompilerId: uint64;
    hidden FTriple: string;
    hidden FMode: string;
    hidden FDefines: string;
    hidden FProjectKey: uint64;
    hidden FCompiledUnits: int64;
    hidden FCompiledRoutines: int64;
    // The compiler's std and runtime folders (IsShared), the shared cache's folder and the
    // user's fallback ("" when the OS names no user cache), for the build's triple and mode
    hidden FSharedRoots: StringArray;
    hidden FSharedDir: string;
    hidden FUserDir: string;
    // Each unit's .acu file as placed (PlaceOf, NoteWritten): FPlaceNames[i]'s is FPlacePaths[i]
    hidden FPlaceNames: StringArray;
    hidden FPlacePaths: StringArray;
    // Every .acu file this build has read, each read from the disk once (DoFileIndex) until
    // the build writes it again (Forget)
    hidden FFiles: AcuFileArray;

    // ASources: the build's (its imports found as the parser finds them)
    init(const ASources: ref SourceFiles);
    begin
      setlength(self.FSharedRoots, 0);
      self.FSharedDir := "";
      self.FUserDir := "";
      setlength(self.FPlaceNames, 0);
      setlength(self.FPlacePaths, 0);
      setlength(self.FFiles, 0);
      self.FSources := ASources;
      self.FOwnFromSource := false;
      self.FCompiler := nil;
      setlength(self.FUnits, 0);
      self.FReady := false;
      self.FDir := "";
      self.FBackend := nil;
      self.FCompilerId := 0;
      self.FTriple := "";
      self.FMode := "";
      self.FDefines := "";
      self.FProjectKey := 0;
      self.FCompiledUnits := 0;
      self.FCompiledRoutines := 0;
    end;

    // One unit lowered and generated into its .acu by this build (the build's own tree or
    // a unit compile's), ARoutines the routines it defines: the build's Lower phase counts
    // every one (SU2.4b), so a build shows how many units it compiled
    method NoteCompiled(const ARoutines: int64);
    begin
      self.FCompiledUnits := self.FCompiledUnits + 1;
      self.FCompiledRoutines := self.FCompiledRoutines + ARoutines;
    end;

    // The units NoteCompiled counted and the routines they define
    property CompiledUnits: int64 read FCompiledUnits;
    property CompiledRoutines: int64 read FCompiledRoutines;

    // AValue: every unit that is not shared is stale, parsed from its source by the build's
    // tree (--emit-ir: see the type's comment). Before the parse
    method SetOwnFromSource(const AValue: bool);
    begin
      self.FOwnFromSource := AValue;
    end;

    // ACompiler compiles each unit the plan finds stale (the build's, before its parse)
    method SetCompiler(const ACompiler: ref UnitCompiler);
    begin
      self.FCompiler := ACompiler;
    end;

    // No unit compile from now on: the plan's way back to the build's compile ends (the
    // build has parsed; nothing outlives it in a cycle of references)
    method Detach();
    begin
      self.FCompiler := nil;
    end;

    // True once Settle ran
    property Ready: bool read FReady;

    // The units' folder ("" when there is none: no unit comes from an .acu) and the backend
    // whose object format holds them
    property Dir: string read FDir;
    property Format: ref Backend read FBackend;

    // The build's facts settled from its tree ATree (the main module's prologue parsed) and
    // its output folder ARoot (see DoOutputRootOf)
    method Settle(const ATree: ref SyntaxTree; const ARoot: string);
    begin
      self.FReady := true;
      self.FBackend := BackendFor(ATree.Triple);
      if self.FBackend = nil then
        return;
      end;
      self.FDir := DoOutputPartOf(ATree, ARoot, ADAM_OUTPUT_ACU_DIR);
      self.FCompilerId := DoCompilerId();
      self.FTriple := ATree.Triple;
      self.FMode := AcuModeOf(ATree.Level);
      self.FDefines := DoDefinesOf(ATree);
      self.FProjectKey := DoProjectKeyOf(ATree);
      // The shared cache: no folder when adam.exe's cannot be told (DR0001 said so); the
      // user's fallback none when the OS names no user cache
      setlength(self.FSharedRoots, 0);
      self.DoAddSharedRoot(ADAM_DRIVER_STD_MODULE_PATH);
      self.DoAddSharedRoot(ADAM_DRIVER_RUNTIME_MODULE_PATH);
      self.FSharedDir := DoOutputPartOf(ATree, ResolvePath(ADAM_DRIVER_SHARED_RES),
        ADAM_OUTPUT_ACU_DIR);
      self.FUserDir := "";
      if UserCacheDir() <> "" then
        self.FUserDir := DoOutputPartOf(ATree,
          ResolvePath(ADAM_DRIVER_USER_CACHE_DIR, UserCacheDir()), ADAM_OUTPUT_ACU_DIR);
      end;
    end;

    // The folder APath ($P: adam.exe's) added to the shared roots when it resolves
    hidden method DoAddSharedRoot(const APath: string);
    var
      LDir: string;
    begin
      LDir := ResolvePath(APath);
      if LDir <> "" then
        setlength(self.FSharedRoots, len(self.FSharedRoots) + 1);
        self.FSharedRoots[len(self.FSharedRoots) - 1] := LDir;
      end;
    end;

    // True when the unit whose source is the file ASource is the std's or the runtime's: its
    // folder is the compiler's std or runtime folder (SamePath: as Windows tells paths apart)
    const method IsShared(const ASource: string): bool;
    var
      LDir: string;
      LI: int64;
    begin
      LDir := ExtractFileDir(ASource);
      if LDir = "" then
        return false;
      end;
      for LI := 0 to len(self.FSharedRoots) - 1 do
        if SamePath(LDir, self.FSharedRoots[LI]) then
          return true;
        end;
      end;
      return false;
    end;

    // True when the unit AName is the std's or the runtime's: its decision's (a unit taken
    // from its .acu), else IsShared of its source ASource (one parsed from source)
    const method UnitShared(const AName: string; const ASource: string): bool;
    var
      LIndex: int64;
    begin
      LIndex := self.DoIndexOf(AName);
      if LIndex >= 0 then
        return self.FUnits[LIndex].Shared;
      end;
      return self.IsShared(ASource);
    end;

    // The pack key the .acu of a unit (AShared: the std's or the runtime's) is judged and
    // written with: the build's, 0 for a shared unit (see the type's comment)
    const method KeyFor(const AShared: bool): uint64;
    begin
      if AShared then
        return 0;
      end;
      return self.FProjectKey;
    end;

    // The files the .acu of the unit AName (AShared: the std's or the runtime's) may be at,
    // in the order they are read and written: the shared cache's then the user's for a shared
    // unit, the build's <output>\acu\<triple>\<mode>\ for any other; a folder that is none
    // gives no file
    const method FilesOf(const AName: string; const AShared: bool): StringArray;
    var
      LList: StringArray;
    begin
      setlength(LList, 0);
      if AShared then
        DoAddAcuFile(LList, self.FSharedDir, AName);
        DoAddAcuFile(LList, self.FUserDir, AName);
      else
        DoAddAcuFile(LList, self.FDir, AName);
      end;
      return LList;
    end;

    // The index in FPlaceNames of AName (-1: not placed)
    hidden const method DoPlaceIndex(const AName: string): int64;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FPlaceNames) - 1 do
        if self.FPlaceNames[LI] = AName then
          return LI;
        end;
      end;
      return -1;
    end;

    // AName's .acu is the file APath from now on (its decision's pick, or the file a compile
    // wrote it to)
    method NoteWritten(const AName: string; const APath: string);
    var
      LIndex: int64;
    begin
      LIndex := self.DoPlaceIndex(AName);
      if LIndex < 0 then
        LIndex := len(self.FPlaceNames);
        setlength(self.FPlaceNames, LIndex + 1);
        setlength(self.FPlacePaths, LIndex + 1);
        self.FPlaceNames[LIndex] := AName;
      end;
      self.FPlacePaths[LIndex] := APath;
    end;

    // The file AName's .acu is read from: the one this build placed it at (PlaceOf when it
    // was decided, NoteWritten when it was compiled); "" when it has none
    const method FileOf(const AName: string): string;
    var
      LIndex: int64;
    begin
      LIndex := self.DoPlaceIndex(AName);
      if LIndex < 0 then
        return "";
      end;
      return self.FPlacePaths[LIndex];
    end;

    // The index in FUnits of AName (-1: not decided yet)
    hidden const method DoIndexOf(const AName: string): int64;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FUnits) - 1 do
        if self.FUnits[LI].UnitName = AName then
          return LI;
        end;
      end;
      return -1;
    end;

    // The index in FFiles of the .acu file AFile ("" no file), read from the disk on the
    // first ask only: a build asks for one unit's file several times (its place picked, its
    // header judged before and after its imports are decided, its payload loaded, its object
    // merged), so each file is read and its Info section's payload taken out once. A file
    // that is missing or cannot be read is kept as such (Found false) until the build writes
    // it (Forget)
    hidden method DoFileIndex(const AFile: string): int64;
    var
      LFile: AcuFile;
      LI: int64;
    begin
      for LI := 0 to len(self.FFiles) - 1 do
        if self.FFiles[LI].Path = AFile then
          return LI;
        end;
      end;
      LFile.Path := AFile;
      LFile.Found := false;
      setlength(LFile.Bytes, 0);
      setlength(LFile.Payload, 0);
      LFile.Valid := false;
      if (AFile <> "") and FileExists(AFile) and ReadAllBytes(AFile, LFile.Bytes) then
        LFile.Found := true;
        if self.FBackend.Format.ReadSection(LFile.Bytes,
          self.FBackend.Format.SectionNameOf(SectionKind.Info), LFile.Payload) then
          LFile.Valid := ReadAcuHeader(LFile.Payload, LFile.Header);
        else
          setlength(LFile.Payload, 0);
        end;
      end;
      setlength(self.FFiles, len(self.FFiles) + 1);
      self.FFiles[len(self.FFiles) - 1] := LFile;
      return len(self.FFiles) - 1;
    end;

    // The .acu file AFile was written by this build (DoWriteUnit): its next ask reads it from
    // the disk again
    method Forget(const AFile: string);
    var
      LI: int64;
      LLast: int64;
    begin
      for LI := 0 to len(self.FFiles) - 1 do
        if self.FFiles[LI].Path = AFile then
          // Order does not matter (DoFileIndex looks a path up): the last entry fills the gap
          LLast := len(self.FFiles) - 1;
          if LI < LLast then
            self.FFiles[LI] := self.FFiles[LLast];
          end;
          setlength(self.FFiles, LLast);
          return;
        end;
      end;
    end;

    // AName's .acu as it is on the disk (the file it is placed at, FileOf): its payload's
    // header into AHeader; false when there is none of this format version
    hidden method DoReadUnit(const AName: string; var AHeader: AcuHeader): bool;
    begin
      return self.DoReadFile(self.FileOf(AName), AHeader);
    end;

    // The .acu file AFile's payload header into AHeader; false when there is none of this
    // format version
    hidden method DoReadFile(const AFile: string; var AHeader: AcuHeader): bool;
    var
      LIndex: int64;
    begin
      LIndex := self.DoFileIndex(AFile);
      if not self.FFiles[LIndex].Valid then
        return false;
      end;
      AHeader := self.FFiles[LIndex].Header;
      return true;
    end;

    // AName's payload as its .acu holds it now (empty when there is none)
    method PayloadOf(const AName: string): ByteArray;
    begin
      return self.FFiles[self.DoFileIndex(self.FileOf(AName))].Payload;
    end;

    // AName's .acu file whole as it is on the disk (FileOf's) into ABytes; false when it has
    // none or it cannot be read
    method BytesOf(const AName: string; var ABytes: ByteArray): bool;
    var
      LIndex: int64;
    begin
      LIndex := self.DoFileIndex(self.FileOf(AName));
      if not self.FFiles[LIndex].Found then
        setlength(ABytes, 0);
        return false;
      end;
      ABytes := self.FFiles[LIndex].Bytes;
      return true;
    end;

    // The header AName was decided current with (its imports, its interface hash)
    const method HeaderOf(const AName: string): AcuHeader;
    begin
      return self.FUnits[self.DoIndexOf(AName)].Header;
    end;

    // The interface hash AName has now into AHash: a current unit's from its decided header,
    // a unit still being decided (a cycle of imports) from its .acu as written; false for a
    // stale unit or one not decided (no hash an importer could match)
    hidden method DoHashNow(const AName: string; var AHash: uint64): bool;
    var
      LIndex: int64;
      LHeader: AcuHeader;
    begin
      LIndex := self.DoIndexOf(AName);
      if LIndex < 0 then
        return false;
      end;
      if self.FUnits[LIndex].State = AcuState.Current then
        AHash := self.FUnits[LIndex].Header.InterfaceHash;
        return true;
      end;
      if (self.FUnits[LIndex].State = AcuState.Deciding) and
        self.DoReadUnit(AName, LHeader) then
        AHash := LHeader.InterfaceHash;
        return true;
      end;
      return false;
    end;

    // True when AHeader was written by a build like this one: this compiler, the unit's name,
    // the build's triple, mode, predefined symbols and pack key. Only then can its importers'
    // .acu be current too, so only then is a stale unit worth compiling alone (a new compiler
    // or another mode recompiles every unit: each tree parses its own, with no unit compile)
    hidden const method DoSameBuild(const AHeader: AcuHeader; const AName: string;
      const AShared: bool): bool;
    begin
      return (AHeader.UnitName = AName) and (AHeader.CompilerId = self.FCompilerId) and
        (AHeader.Triple = self.FTriple) and (AHeader.Mode = self.FMode) and
        (AHeader.Defines = self.FDefines) and (AHeader.ProjectKey = self.KeyFor(AShared));
    end;

    // The file of the unit AName's .acu (AShared, its source the file APath) this build reads
    // (see the type's comment): of FilesOf, the first whose header is a build like this one
    // with APath's size and write time as they are now; else the first there is; else the
    // first of FilesOf (where a compile writes it); "" when FilesOf is empty
    hidden method DoPickFile(const AName: string; const AShared: bool;
      const APath: string): string;
    var
      LFiles: StringArray;
      LHeader: AcuHeader;
      LFirst: string;
      LI: int64;
    begin
      LFiles := self.FilesOf(AName, AShared);
      if len(LFiles) = 0 then
        return "";
      end;
      // One place (a unit of the build's own, a shared one with no user cache): nothing to pick
      if len(LFiles) = 1 then
        return LFiles[0];
      end;
      LFirst := "";
      for LI := 0 to len(LFiles) - 1 do
        if self.DoReadFile(LFiles[LI], LHeader) then
          if self.DoSameBuild(LHeader, AName, AShared) and (LHeader.SourcePath = APath) and
            (LHeader.SourceSize = FileSize(APath)) and
            (LHeader.SourceTime = FileWriteTime(APath)) then
            return LFiles[LI];
          end;
          if LFirst = "" then
            LFirst := LFiles[LI];
          end;
        end;
      end;
      if LFirst <> "" then
        return LFirst;
      end;
      return LFiles[0];
    end;

    // True when AHeader is current for the unit AName at AIndex, its source the file APath,
    // but for its imports (see the type's comment): when only the source's write time moved
    // and its text is the one compiled, the unit's decision is marked for a refresh
    hidden method DoSelfCurrent(const AIndex: int64; const AHeader: AcuHeader;
      const AName: string; const APath: string): bool;
    var
      LSize: int64;
      LTime: int64;
      LText: string;
    begin
      if not self.DoSameBuild(AHeader, AName, self.FUnits[AIndex].Shared) or
        (AHeader.SourcePath <> APath) then
        return false;
      end;
      // The stamp before the read, as SourceFiles' Load takes it
      LSize := FileSize(APath);
      LTime := FileWriteTime(APath);
      if LSize <> AHeader.SourceSize then
        return false;
      end;
      if LTime = AHeader.SourceTime then
        return true;
      end;
      if not ReadAllText(APath, LText) or (Fnv1a64(LText) <> AHeader.SourceHash) then
        return false;
      end;
      self.FUnits[AIndex].Refresh := true;
      self.FUnits[AIndex].RefreshSize := LSize;
      self.FUnits[AIndex].RefreshTime := LTime;
      return true;
    end;

    // True when the unit AName at AIndex, its source the file APath, has a current .acu
    // (its header then the decision's): its imports decided first. ABlocked: compiling this
    // unit alone cannot help: it has no .acu of a build like this one (DoSameBuild: none,
    // another format, compiler or mode), an import cannot be current (its source missing,
    // its compile failed), or an import's interface moved. Not blocked and not current: its
    // own source moved, so it alone is compiled and its importers may stay current
    hidden method DoCheck(const AIndex: int64; const AName: string; const APath: string;
      var ABlocked: bool): bool;
    var
      LHeader: AcuHeader;
      LDir: string;
      LPath: string;
      LHash: uint64;
      LI: int64;
    begin
      ABlocked := true;
      if not self.DoReadUnit(AName, LHeader) or
        not self.DoSameBuild(LHeader, AName, self.FUnits[AIndex].Shared) then
        return false;
      end;
      ABlocked := false;
      LDir := ExtractFileDir(APath);
      for LI := 0 to len(LHeader.Imports) - 1 do
        LPath := self.FSources.FindUnit(LHeader.Imports[LI], LDir);
        if LPath = "" then
          ABlocked := true;
        else
          if not self.Decide(LHeader.Imports[LI], LPath) and
            (self.FUnits[self.DoIndexOf(LHeader.Imports[LI])].State = AcuState.Stale) then
            ABlocked := true;
          end;
        end;
      end;
      if ABlocked then
        return false;
      end;
      // A unit compile in a cycle of imports may have written this unit's .acu meanwhile:
      // the unit is judged by its .acu as it is now
      if not self.DoReadUnit(AName, LHeader) or
        not self.DoSelfCurrent(AIndex, LHeader, AName, APath) then
        return false;
      end;
      // An import whose interface moved makes the unit stale with every importer above it:
      // compiling it alone would not keep them, so the tree that needs it parses its source
      // (one tree for the whole chain, far cheaper than a unit compile per importer)
      for LI := 0 to len(LHeader.Imports) - 1 do
        if not self.DoHashNow(LHeader.Imports[LI], LHash) or
          (LHash <> LHeader.ImportHashes[LI]) then
          ABlocked := true;
          return false;
        end;
      end;
      self.FUnits[AIndex].Header := LHeader;
      return true;
    end;

    // True when the unit AName, its source the file APath, is to come from its .acu (see the
    // type's comment); decided once, a unit being decided (a cycle of imports) is no
    method Decide(const AName: string; const APath: string): bool;
    var
      LIndex: int64;
      LOk: bool;
      LBlocked: bool;
    begin
      LIndex := self.DoIndexOf(AName);
      if LIndex >= 0 then
        return self.FUnits[LIndex].State = AcuState.Current;
      end;
      if not self.FReady or (self.FDir = "") then
        return false;
      end;
      LIndex := len(self.FUnits);
      setlength(self.FUnits, LIndex + 1);
      self.FUnits[LIndex].UnitName := AName;
      self.FUnits[LIndex].Shared := self.IsShared(APath);
      // Its .acu's file picked before it is read (a unit compile then writes it where it can)
      self.NoteWritten(AName, self.DoPickFile(AName, self.FUnits[LIndex].Shared, APath));
      self.FUnits[LIndex].State := AcuState.Deciding;
      self.FUnits[LIndex].Refresh := false;
      self.FUnits[LIndex].RefreshSize := 0;
      self.FUnits[LIndex].RefreshTime := 0;
      // --emit-ir: the program's own unit from its source, with no unit compile
      if self.FOwnFromSource and not self.FUnits[LIndex].Shared then
        self.FUnits[LIndex].State := AcuState.Stale;
        return false;
      end;
      LOk := self.DoCheck(LIndex, AName, APath, LBlocked);
      if not LOk and not LBlocked and (self.FCompiler <> nil) then
        if self.FCompiler.CompileUnit(AName, APath) then
          LOk := self.DoCheck(LIndex, AName, APath, LBlocked);
        end;
      end;
      if LOk then
        self.FUnits[LIndex].State := AcuState.Current;
      else
        self.FUnits[LIndex].State := AcuState.Stale;
      end;
      return LOk;
    end;

    // The interface hash of the current unit AName (its decided header's)
    const method InterfaceHashOf(const AName: string): uint64;
    begin
      return self.FUnits[self.DoIndexOf(AName)].Header.InterfaceHash;
    end;

    // True, once, when the current unit AName's .acu is to be written again with the size
    // and write time its source has now (ASize, ATime; see AcuDecision); its header into
    // AHeader
    method TakeRefresh(const AName: string; var AHeader: AcuHeader; var ASize: int64;
      var ATime: int64): bool;
    var
      LIndex: int64;
    begin
      LIndex := self.DoIndexOf(AName);
      if (LIndex < 0) or not self.FUnits[LIndex].Refresh then
        return false;
      end;
      self.FUnits[LIndex].Refresh := false;
      AHeader := self.FUnits[LIndex].Header;
      ASize := self.FUnits[LIndex].RefreshSize;
      ATime := self.FUnits[LIndex].RefreshTime;
      return true;
    end;
  end;

  // The build's compiled units seen by one tree's parse, the parser's UnitLoader: a unit
  // the build's AcuPlan decides current is taken from its .acu in place of its source. Its
  // payload is read by Adam.Acu.Reader's group reader once the parser has loaded its imports
  // (or is loading them in the same group); a name its import no longer declares is the
  // reader's AU0002 at the import that needs the unit
  AcuLoader = object(UnitLoader)
    hidden FTree: ref SyntaxTree;
    hidden FReports: ref Diagnostics;
    hidden FOutputDir: string;
    hidden FProjectOutput: string;
    hidden FPlan: ref AcuPlan;
    hidden FFound: AcuFoundArray;
    hidden FGroup: ref AcuGroupReader;

    // AOutputDir: the command line's output folder ("" none, see DoOutputRootOf); APlan the
    // build's (settled by the first loader that needs it: the build's own)
    init(const ATree: ref SyntaxTree; const AReports: ref Diagnostics; const AOutputDir: string;
      const APlan: ref AcuPlan);
    begin
      self.FTree := ATree;
      self.FReports := AReports;
      self.FOutputDir := AOutputDir;
      self.FProjectOutput := "";
      self.FPlan := APlan;
      setlength(self.FFound, 0);
      self.FGroup := ref AcuGroupReader(ATree, AReports);
    end;

    // The build's plan
    property Plan: ref AcuPlan read FPlan;

    // A project build's output folder (the Compiler's DoFindProject, before the parse)
    method SetProjectOutput(const AProjectOutput: string);
    begin
      self.FProjectOutput := AProjectOutput;
    end;

    // The plan settled on the first unit asked for: the main module (the program's first
    // module) has its prologue parsed and the build's triple by then. False when there is
    // no folder (no backend for the triple, a folder that cannot be resolved)
    hidden method DoReady(): bool;
    begin
      if not self.FPlan.Ready then
        self.FPlan.Settle(self.FTree, DoOutputRootOf(self.FTree,
          self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, 0), self.FOutputDir,
          self.FProjectOutput));
      end;
      return self.FPlan.Dir <> "";
    end;

    override method HasUnit(const AName: string; const APath: string;
      var AImports: StringArray): bool;
    var
      LPayload: ByteArray;
      LHeader: AcuHeader;
      LCount: int64;
      LIndex: int64;
    begin
      setlength(AImports, 0);
      // Asked again (the parser decides a unit, then loads it): the form found the first time
      LIndex := self.DoFoundIndex(AName);
      if LIndex >= 0 then
        AImports := self.FFound[LIndex].Imports;
        return true;
      end;
      if not self.DoReady() or not self.FPlan.Decide(AName, APath) then
        return false;
      end;
      // The payload the plan judged (no build writes it again: it is current)
      LPayload := self.FPlan.PayloadOf(AName);
      if len(LPayload) = 0 then
        return false;
      end;
      LHeader := self.FPlan.HeaderOf(AName);
      LCount := len(self.FFound);
      setlength(self.FFound, LCount + 1);
      self.FFound[LCount].UnitName := AName;
      self.FFound[LCount].Imports := LHeader.Imports;
      self.FFound[LCount].Payload := LPayload;
      AImports := LHeader.Imports;
      return true;
    end;

    // The index in FFound of the form HasUnit found for AName (-1: none)
    hidden const method DoFoundIndex(const AName: string): int64;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FFound) - 1 do
        if self.FFound[LI].UnitName = AName then
          return LI;
        end;
      end;
      return -1;
    end;

    // The form HasUnit found for AName appended to the group being read and taken off the
    // list. Raises when there is none (the parser asked for a unit HasUnit did not find: a
    // compiler defect)
    override method LoadUnit(const AName: string; const APlace: SourcePlace): int64;
    var
      LIndex: int64;
      LPayload: ByteArray;
    begin
      LIndex := self.DoFoundIndex(AName);
      if LIndex < 0 then
        raise(ADAM_DRIVER_FAULT_LOAD + AName);
      end;
      LPayload := self.FFound[LIndex].Payload;
      self.FFound[LIndex] := self.FFound[len(self.FFound) - 1];
      setlength(self.FFound, len(self.FFound) - 1);
      return self.FGroup.Append(LPayload, APlace);
    end;

    override method FinishUnits(): bool;
    begin
      return self.FGroup.Finish();
    end;
  end;

public type
  // The phases a compile reports as each ends, in their order (see the header)
  BuildPhase = choices(Parse, Analyze, Lower, Generate, Link);

  // The steps a phase tells as each starts (see the header): a unit's Lower / Optimize /
  // Generate (its object) / Write (its .acu), Program (the program's parts lowered and
  // optimized), Merge (a unit's object merged into the link's set)
  BuildStep = choices(Lower, Optimize, Generate, Write, Program, Merge);

  // Told as each phase starts and ends and as each of its steps starts, with no error
  // reported (see the header); this one hears nothing: a caller that shows the phases
  // overrides what it shows
  PhaseListener = object
    // APhase started
    virtual method PhaseStarted(const APhase: BuildPhase);
    begin
    end;

    // AStep of APhase started on the unit AUnit ("" for the program's parts), the ADone-th
    // of the ATotal units the phase works (both 0 when the phase does not count them: a unit
    // compiled during Parse)
    virtual method StepStarted(const APhase: BuildPhase; const AStep: BuildStep;
      const ADone: int64; const ATotal: int64; const AUnit: string);
    begin
    end;

    // APhase ended. Parse: AFirst modules parsed from source, ASecond their lines, AThird
    // modules taken from their .acu (NodeFlag.Compiled). Analyze: nothing. Lower: AFirst
    // units compiled, ASecond functions. Generate: AFirst code bytes. Link: AText the exe's
    // path, AFirst the libraries it imports. A count a phase has not is 0, a text ""
    virtual method PhaseEnded(const APhase: BuildPhase; const AFirst: int64;
      const ASecond: int64; const AThird: int64; const AText: string);
    begin
    end;
  end;

public type
  // What a unit compile takes from the build it compiles for (Compiler.CompileUnitFor): the
  // build's sources (module paths, given texts, project root), its tree (triple, mode,
  // project secret), its reports (a unit compile's warnings and hints join them), its
  // project, its plan and its listener (the unit compile's steps are told to it)
  UnitContext = object
    Sources: ref SourceFiles;
    Tree: ref SyntaxTree;
    Reports: ref Diagnostics;
    ProjectRoot: string;
    ProjectOutput: string;
    ProjectKind: ModuleKind;
    Plan: ref AcuPlan;
    Listener: ref PhaseListener;

    init(const ASources: ref SourceFiles; const ATree: ref SyntaxTree;
      const AReports: ref Diagnostics; const AProjectRoot: string; const AProjectOutput: string;
      const AProjectKind: ModuleKind; const APlan: ref AcuPlan; const AListener: ref PhaseListener);
    begin
      self.Sources := ASources;
      self.Tree := ATree;
      self.Reports := AReports;
      self.ProjectRoot := AProjectRoot;
      self.ProjectOutput := AProjectOutput;
      self.ProjectKind := AProjectKind;
      self.Plan := APlan;
      self.Listener := AListener;
    end;
  end;

// The UnitCompiler that compiles each stale unit for the build AContext describes, by a new
// Compiler (declared past the Compiler, which it makes)
forward routine DoUnitCompilerFor(const AContext: ref UnitContext): ref UnitCompiler;

public type
  // One compile (see the header)
  Compiler = object
    hidden FReports: ref Diagnostics;
    hidden FSources: ref SourceFiles;
    hidden FTree: ref SyntaxTree;
    hidden FTarget: ref Target;
    hidden FMain: int64;
    hidden FChecked: bool;
    hidden FOverrideTarget: string;
    // The tree's level was set here (SetLevel, a unit compile's build's): the main module's
    // @optimize does not change it
    hidden FLevelGiven: bool;
    hidden FExePath: string;
    hidden FBuiltDll: bool;
    hidden FBuiltLib: bool;
    hidden FListener: ref PhaseListener;
    // Who hears the steps (DoStep): the build's listener (this compile's, or the build's a
    // unit compile works for), under FStepPhase, at the unit FStepUnit, the FStepDone-th of
    // FStepTotal
    hidden FSteps: ref PhaseListener;
    hidden FStepPhase: BuildPhase;
    hidden FStepDone: int64;
    hidden FStepTotal: int64;
    hidden FStepUnit: string;
    // The project this build is (DoFindProject): set only when the main module is its
    // project.toml's main; "" / Exe for a plain build
    hidden FProjectRoot: string;
    hidden FProjectOutput: string;
    hidden FProjectKind: ModuleKind;
    // The project's assets archive (Project.RezPath: adam pack's <output>\<name>.rez), copied
    // beside the exe a build writes when it is there; "" for a plain build
    hidden FProjectRez: string;
    // The main module's resolved path (Check)
    hidden FMainPath: string;
    // The build's compiled units (Build's; nil for a check: every unit is parsed), decided by
    // the build's plan (a unit compile shares the build's)
    hidden FLoader: ref AcuLoader;
    hidden FPlan: ref AcuPlan;
    // --emit-ir (SetEmitIr): FIrText gathers the IR of every module the build lowers that
    // is not shared, after the optimizer, with its analysis (Adam.Opt.Analysis); FIrPlaces
    // each node's place text for its dump (DoNodePlaces)
    hidden FEmitIr: bool;
    hidden FIrText: ref TextBuilder;
    hidden FIrPlaces: StringArray;

    // Tells the listener (when there is one) APhase ended, while no error is reported
    hidden method DoPhaseEnded(const APhase: BuildPhase; const AFirst: int64;
      const ASecond: int64; const AThird: int64; const AText: string);
    begin
      if (self.FListener = nil) or self.FReports.HasErrors() then
        return;
      end;
      self.FListener.PhaseEnded(APhase, AFirst, ASecond, AThird, AText);
    end;

    // Tells the listener (when there is one) APhase started, while no error is reported
    hidden method DoPhaseStarted(const APhase: BuildPhase);
    begin
      if (self.FListener = nil) or self.FReports.HasErrors() then
        return;
      end;
      self.FListener.PhaseStarted(APhase);
    end;

    // Tells the steps' listener (when there is one) AStep started at the unit and count the
    // step fields hold, while no error is reported
    hidden method DoStep(const AStep: BuildStep);
    begin
      if (self.FSteps = nil) or self.FReports.HasErrors() then
        return;
      end;
      self.FSteps.StepStarted(self.FStepPhase, AStep, self.FStepDone, self.FStepTotal,
        self.FStepUnit);
    end;

    // The program's modules taken from their .acu (ACompiled: NodeFlag.Compiled), or the ones
    // parsed from source, as the tree holds them
    hidden const method DoModuleCount(const ACompiled: bool): int64;
    var
      LCount: int64;
      LI: int64;
    begin
      LCount := 0;
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        if self.FTree[self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI)].HasFlag(
          NodeFlag.Compiled) = ACompiled then
          LCount := LCount + 1;
        end;
      end;
      return LCount;
    end;

    // The lines of every file the build loaded (a unit taken from its .acu loads none)
    hidden const method DoLineCount(): int64;
    var
      LLines: int64;
      LI: int64;
    begin
      LLines := 0;
      for LI := 0 to self.FSources.Count - 1 do
        LLines := LLines + int64(self.FSources[LI].LineCount);
      end;
      return LLines;
    end;

    // The bytes of every code section in ASet
    hidden const method DoCodeBytes(const ASet: ref SectionSet): int64;
    var
      LBytes: int64;
      LId: int64;
    begin
      LBytes := 0;
      for LId := 1 to ASet.SectionCount - 1 do
        if ASet.SectionAt(LId).Kind = SectionKind.Code then
          LBytes := LBytes + ASet.SectionAt(LId).Size();
        end;
      end;
      return LBytes;
    end;

    // Adds the folder APath ($P: adam.exe's folder) as the next module path. When the
    // folder of adam.exe cannot be told, ACode warns with ATemplate and imports are looked
    // for without it
    hidden method DoAddModulePath(const APath: string; const ACode: string; const ATemplate: string);
    var
      LDir: string;
    begin
      LDir := ResolvePath(APath);
      if LDir = "" then
        self.FReports.Add(Severity.Warning, ACode, NoPlace(), ATemplate, NoArgs().Str(APath));
        return;
      end;
      self.FSources.AddModulePath(LDir);
    end;

    // The standard library's folder as the first module path (DR0001), the runtime's next
    // (DR0005: where the implicit runtime unit is found)
    hidden method DoAddStdPath();
    begin
      self.DoAddModulePath(ADAM_DRIVER_STD_MODULE_PATH, ADAM_ERR_DRIVER_001, ADAM_MSG_DRIVER_NO_STD);
      self.DoAddModulePath(ADAM_DRIVER_RUNTIME_MODULE_PATH, ADAM_ERR_DRIVER_005,
        ADAM_MSG_DRIVER_NO_RUNTIME);
    end;

    init();
    begin
      self.FReports := ref Diagnostics(ADAM_DRIVER_ERROR_BUDGET);
      self.FSources := ref SourceFiles();
      self.FTree := ref SyntaxTree();
      self.FTarget := nil;
      self.FMain := 0;
      self.FChecked := false;
      self.FOverrideTarget := "";
      self.FLevelGiven := false;
      self.FExePath := "";
      self.FBuiltDll := false;
      self.FBuiltLib := false;
      self.FListener := nil;
      self.FLoader := nil;
      self.FPlan := nil;
      self.FProjectRoot := "";
      self.FProjectOutput := "";
      self.FProjectKind := ModuleKind.Exe;
      self.FProjectRez := "";
      self.FMainPath := "";
      self.FEmitIr := false;
      self.FIrText := ref TextBuilder();
      setlength(self.FIrPlaces, 0);
      self.DoAddStdPath();
    end;

    // The nearest project.toml at or above the main module APath (resolved), loaded. None is
    // a plain build (projects are opt-in); one that is there must load (false: its reports
    // stop the compile). The build is that project's only when APath is its main module:
    // then its root ($R:), output folder and kind are the build's, and its pack password,
    // scrambled (ScramblePassword), is on the AST for ProjectPassword()
    hidden method DoFindProject(const APath: string): bool;
    var
      LProject: ref Project;
      LRoot: string;
      LSecret: string;
      LKey: uint64;
    begin
      self.FProjectRoot := "";
      self.FProjectOutput := "";
      self.FProjectKind := ModuleKind.Exe;
      self.FProjectRez := "";
      LProject := ref Project(self.FReports);
      LRoot := LProject.Find(APath);
      if self.FReports.HasErrors() then
        return false;
      end;
      if LRoot = "" then
        return true;
      end;
      if not LProject.Load(LRoot) then
        return false;
      end;
      if SamePath(LProject.MainPath(), APath) then
        self.FProjectRoot := LProject.Root;
        self.FProjectOutput := LProject.OutputPath();
        self.FProjectKind := LProject.Kind;
        self.FProjectRez := LProject.RezPath();
        ScramblePassword(LProject.Password, LSecret, LKey);
        self.FTree.SetProjectSecret(LSecret, LKey);
      end;
      return true;
    end;

    // A project build's main module must be the kind project.toml's type says (DR0010 at its
    // header); a unit, or a module with no kind, is left to the parser
    hidden method DoCheckProjectKind();
    var
      LKind: ModuleKind;
    begin
      if (self.FProjectRoot = "") or (self.FMain = 0) then
        return;
      end;
      LKind := self.FTree[self.FMain].Module;
      if (LKind = ModuleKind.Unit) or (LKind = ModuleKind.None) then
        return;
      end;
      if LKind <> self.FProjectKind then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_010, self.FTree[self.FMain].Place,
          ADAM_MSG_DRIVER_PROJECT_KIND, NoArgs().Str(ProjectKindText(self.FProjectKind))
          .Str(self.FMainPath));
      end;
    end;

    // AListener is told as each phase ends (see the header); nil for none. Before Check
    method SetListener(const AListener: ref PhaseListener);
    begin
      self.FListener := AListener;
      self.FSteps := AListener;
    end;

    // The triple ATriple (a target the registry has, three-part) as the build's target,
    // whatever the main module's @target says: the command line's -t. Before Check
    method SetTarget(const ATriple: string);
    begin
      self.FOverrideTarget := ATriple;
    end;

    // ALevel as the build's optimization level, whatever the main module's @optimize says
    // (still checked): the command line's -opt, the self-build's. Before Check
    method SetLevel(const ALevel: OptLevel);
    begin
      self.FTree.SetLevel(ALevel);
      self.FLevelGiven := true;
    end;

    // The build also writes <stem>.ir beside its exe (the command line's --emit-ir): every
    // module it lowers that is not a shared std / runtime unit, as the optimizer left it,
    // with each function's analysis; every unit of the program's own is compiled from its
    // source for it (AcuPlan.SetOwnFromSource). Before Build
    method SetEmitIr(const AValue: bool);
    begin
      self.FEmitIr := AValue;
    end;

    // Adds the folder ADir (a resolved path) after the module paths already there: for a
    // caller that runs the compiler in its own process, whose $P: is not adam.exe's folder
    // (a probe, later the language server). Before Check
    method AddModulePath(const ADir: string);
    begin
      self.FSources.AddModulePath(ADir);
    end;

    // The compile's reports: every phase's, and the caller's own (a command line's)
    property Reports: ref Diagnostics read FReports;

    // The whole-program AST, filled by Check
    property Tree: ref SyntaxTree read FTree;

    // The main module's id in Tree; 0 before Check, or when the main file cannot be read
    // or has no module header
    property MainModule: int64 read FMain;

    // The program's Target, picked by Check; nil before Check, when the main module has no
    // header, or when its triple names no target (DR0004)
    property PickedTarget: ref Target read FTarget;

    // The exe Build wrote (its resolved path, '/' form; a dll main module's dll, M8a); ""
    // before Build, or when Build wrote none
    property ExePath: string read FExePath;

    // Build wrote a dll (ExePath is one, which no process runs, M8a)
    property BuiltDll: bool read FBuiltDll;
    // True once Build wrote a lib's static libraries (M8d; ExePath names its own)
    property BuiltLib: bool read FBuiltLib;

    // Runs the front end on the program whose main module is the file AMainPath (resolved
    // against the current folder, so the main module's folder is a full path imports and
    // $S: paths start from): parse (imports recurse into the one AST), names, types,
    // layouts, symbols. Everything goes to Reports; nothing is printed
    method Check(const AMainPath: string);
    var
      LPath: string;
    begin
      if self.FChecked then
        self.FReports.Add(Severity.Fatal, ADAM_ERR_DRIVER_003, NoPlace(),
          ADAM_MSG_DRIVER_CHECK_TWICE, NoArgs().Str(AMainPath));
        return;
      end;
      self.FChecked := true;
      LPath := ResolvePath(AMainPath);
      if LPath = "" then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_002, NoPlace(),
          ADAM_MSG_DRIVER_BAD_PATH, NoArgs().Str(AMainPath));
        return;
      end;
      self.FMainPath := LPath;
      // The build's project, found from the main module (a missing file is the parser's to
      // report, with no project looked for); an invalid project.toml stops the compile
      if FileExists(LPath) and not self.DoFindProject(LPath) then
        return;
      end;
      self.DoFrontEnd(false);
    end;

    // The front end on the main module FMainPath, the project settled (Check's, or the build's
    // for a unit compile): AUnitMain the main module may be a unit (a unit compile)
    hidden method DoFrontEnd(const AUnitMain: bool);
    begin
      // $R: in every file of the build: the project's root when the main module is its main
      // (the parser's literal paths, Semantics' constant ones)
      self.FSources.SetProjectRoot(self.FProjectRoot);
      self.FTree.SetProjectRoot(self.FProjectRoot);
      // The build's plan compiles each stale unit alone for this build (its project is known
      // only now); a unit compile shares the build's plan and its compiler
      if (self.FPlan <> nil) and not AUnitMain then
        self.FPlan.SetCompiler(DoUnitCompilerFor(ref UnitContext(self.FSources, self.FTree,
          self.FReports, self.FProjectRoot, self.FProjectOutput, self.FProjectKind,
          self.FPlan, self.FListener)));
      end;
      // A build's units come from their .acu when current (the project's output folder is
      // known only now)
      if self.FLoader <> nil then
        self.FLoader.SetProjectOutput(self.FProjectOutput);
      end;
      self.DoPhaseStarted(BuildPhase.Parse);
      self.FMain := ParseProgramWith(self.FTree, self.FReports, self.FSources, self.FMainPath,
        ADAM_DRIVER_RUNTIME_UNIT, self.FOverrideTarget, self.FLevelGiven, self.FLoader,
        AUnitMain);
      if self.FMain = 0 then
        return;
      end;
      // Reported, never a gate: the front end still runs
      self.DoCheckProjectKind();
      self.DoPhaseEnded(BuildPhase.Parse, self.DoModuleCount(false), self.DoLineCount(),
        self.DoModuleCount(true), "");
      self.DoPhaseStarted(BuildPhase.Analyze);
      self.FTarget := PickTarget(self.FTree, self.FMain, self.FReports);
      ResolveNames(self.FTree, self.FReports);
      CheckTypes(self.FTree, self.FTarget, self.FReports);
      CheckLayouts(self.FTree, self.FTarget, self.FReports);
      NameSymbols(self.FTree, self.FTarget, self.FReports);
      self.DoPhaseEnded(BuildPhase.Analyze, 0, 0, 0, "");
    end;

    // The resolved path of the first argument of every directive spelled ASpelling in the
    // module AModule, in their order (a directive whose path did not resolve was reported
    // there and adds nothing), appended to AList
    hidden const method DoDirectivePaths(const AModule: int64; const ASpelling: string;
      var AList: StringArray);
    begin
      DoDirectivePathsOf(self.FTree, AModule, ASpelling, AList);
    end;

    // The folder APrefix + the picked target's triple appended to AList; nothing when the
    // folder of adam.exe cannot be told (DR0001 already said so)
    hidden method DoAddTargetLibraryPath(const APrefix: string; var AList: StringArray);
    var
      LDir: string;
    begin
      LDir := ResolvePath(APrefix + self.FTarget.Triple());
      if LDir <> "" then
        setlength(AList, len(AList) + 1);
        AList[len(AList) - 1] := LDir;
      end;
    end;

    // Every module's @addlibrarypath folders, in module order, each module's in its order;
    // then the vendor and the system library folders of the picked target
    hidden method DoLibraryPaths(): StringArray;
    var
      LList: StringArray;
      LI: int64;
    begin
      setlength(LList, 0);
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        self.DoDirectivePaths(self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI),
          ADAM_DRIVER_DIRECTIVE_LIBRARY, LList);
      end;
      self.DoAddTargetLibraryPath(ADAM_DRIVER_VENDOR_LIBRARY_PATH, LList);
      self.DoAddTargetLibraryPath(ADAM_DRIVER_SYSTEM_LIBRARY_PATH, LList);
      return LList;
    end;

    // The output folder (see the header): AOutputDir when not empty, resolved against the
    // working folder; else the main module's @outputpath; else a project build's output
    // folder; else output under the working folder. "" when it cannot be resolved
    hidden const method DoOutputDir(const AOutputDir: string): string;
    begin
      return DoOutputRootOf(self.FTree, self.FMain, AOutputDir, self.FProjectOutput);
    end;

    // What the main module's prologue directives ask of its exe (BNF sec 2, ExeSettings), as
    // Semantics checked them: @subsystem gui; @addverinfo on with the @vi* values (each its
    // argument's ResolvedConst, a literal's or a named constant's: a number its Bits, a text
    // its Text; Unknown for one Semantics reported); @exeicon's resolved file and its path's node
    // (an icon that holds no image is an error at the path, BNF sec 2). A recovered directive
    // gives nothing; one Semantics judged not to apply never reaches a link (a lib main
    // module links nothing, a target without the setting has no format part that writes it)
    hidden const method DoExeSettings(): ref ExeSettings;
    var
      LSettings: ref ExeSettings;
      LI: int64;
      LDirective: int64;
      LArg: int64;
      LSpelling: string;
    begin
      LSettings := ref ExeSettings();
      for LI := 0 to self.FTree.CountOf(self.FMain, NodeRole.Directive) - 1 do
        LDirective := self.FTree.NthOf(self.FMain, NodeRole.Directive, LI);
        if self.FTree[LDirective].HasFlag(NodeFlag.Recovered) or
          (self.FTree.CountOf(LDirective, NodeRole.Argument) = 0) then
          skip;
        end;
        LSpelling := self.FTree[LDirective].Text;
        LArg := self.FTree.NthOf(LDirective, NodeRole.Argument, 0);
        if LSpelling = "@subsystem" then
          LSettings.Gui := self.FTree[LArg].Text = "gui";
        end;
        if LSpelling = "@addverinfo" then
          LSettings.VersionInfo := self.FTree[LArg].Text = "on";
        end;
        if LSpelling = "@vimajor" then
          LSettings.VersionMajor := int64(self.FTree[LArg].ResolvedConst.Bits);
        end;
        if LSpelling = "@viminor" then
          LSettings.VersionMinor := int64(self.FTree[LArg].ResolvedConst.Bits);
        end;
        if LSpelling = "@vipatch" then
          LSettings.VersionPatch := int64(self.FTree[LArg].ResolvedConst.Bits);
        end;
        if LSpelling = "@viproductname" then
          LSettings.ProductName := self.FTree[LArg].ResolvedConst.Text;
        end;
        if LSpelling = "@videscription" then
          LSettings.Description := self.FTree[LArg].ResolvedConst.Text;
        end;
        if LSpelling = "@vifilename" then
          LSettings.FileName := self.FTree[LArg].ResolvedConst.Text;
        end;
        if LSpelling = "@vicompanyname" then
          LSettings.CompanyName := self.FTree[LArg].ResolvedConst.Text;
        end;
        if LSpelling = "@vicopyright" then
          LSettings.Copyright := self.FTree[LArg].ResolvedConst.Text;
        end;
        if (LSpelling = "@exeicon") and (self.FTree[LArg].ResolvedPath <> "") then
          LSettings.IconPath := self.FTree[LArg].ResolvedPath;
          LSettings.IconNode := LArg;
        end;
      end;
      if self.FTree[self.FMain].Module = ModuleKind.Dll then
        LSettings.Dll := true;
        self.DoExports(LSettings);
      end;
      return LSettings;
    end;

    // The symbols a dll main module exports (M8a; BNF sec 3 row 20, pcpp's DoIsDllExport):
    // its own public module-level routines with a body and public variables, each its
    // ResolvedSymbol (a clink one its C name, a cpplink one its Itanium name), in
    // declaration order (the linker sorts its name table), into ASettings.Exports, each
    // variable's ExportData true (its import library imports it as data, M8b). An external
    // one is another binary's; a threadstatic one has a copy per thread, which no export
    // address can name; an imported unit's public names are not the dll's to export
    hidden const method DoExports(const ASettings: ref ExeSettings);
    var
      LDecls: Int64Array;
      LExports: StringArray;
      LData: BoolArray;
      LI: int64;
    begin
      LDecls := self.DoExportedDecls();
      setlength(LExports, len(LDecls));
      setlength(LData, len(LDecls));
      for LI := 0 to len(LDecls) - 1 do
        LExports[LI] := self.FTree[LDecls[LI]].ResolvedSymbol;
        LData[LI] := self.FTree[LDecls[LI]].Kind = NodeKind.VarDecl;
      end;
      ASettings.Exports := LExports;
      ASettings.ExportData := LData;
    end;

    // True when the main module's declaration ADecl is one of its exports (DoExports' rule:
    // a public module-level routine with a body or a public variable that is not
    // threadstatic, with its symbol; nothing external, nothing recovered); a lib's C header
    // declares the same set (M8g)
    hidden const method DoIsExported(const ADecl: int64): bool;
    var
      LKind: NodeKind;
    begin
      LKind := self.FTree[ADecl].Kind;
      if (not self.FTree[ADecl].HasFlag(NodeFlag.Public)) or self.FTree[ADecl].HasFlag(NodeFlag.Recovered) or
        (self.FTree.FirstOf(ADecl, NodeRole.External) <> 0) or (self.FTree[ADecl].ResolvedSymbol = "") then
        return false;
      end;
      if LKind = NodeKind.RoutineDecl then
        return self.FTree.FirstOf(ADecl, NodeRole.Body) <> 0;
      end;
      if LKind = NodeKind.VarDecl then
        return not self.FTree[ADecl].HasFlag(NodeFlag.ThreadStatic);
      end;
      return false;
    end;

    // The main module's exports (DoIsExported), in declaration order
    hidden const method DoExportedDecls(): Int64Array;
    var
      LDecls: Int64Array;
      LCount: int64;
      LDecl: int64;
      LI: int64;
    begin
      setlength(LDecls, 0);
      LCount := 0;
      for LI := 0 to self.FTree.CountOf(self.FMain, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(self.FMain, NodeRole.Declaration, LI);
        if not self.DoIsExported(LDecl) then
          skip;
        end;
        if LCount = len(LDecls) then
          setlength(LDecls, LCount * 2 + 8);
        end;
        LDecls[LCount] := LDecl;
        LCount := LCount + 1;
      end;
      setlength(LDecls, LCount);
      return LDecls;
    end;

    // The source text the module AModule was parsed from ("" when no loaded file is its)
    hidden const method DoSourceOf(const AModule: int64): string;
    var
      LI: int64;
    begin
      for LI := 0 to self.FSources.Count - 1 do
        if self.FSources[LI].FileName = self.FTree[AModule].Place.FileName then
          return self.FSources[LI].Slice(0, self.FSources[LI].ByteCount);
        end;
      end;
      return "";
    end;

    // The interface hash of every module of the checked tree: one parsed from its source made
    // now (Adam.Acu.Writer's AcuInterfaceHash), one taken from its .acu as the plan decided it
    hidden method DoUnitHashes(): AcuUnitHashArray;
    var
      LHashes: AcuUnitHashArray;
      LI: int64;
      LModule: int64;
      LCount: int64;
    begin
      setlength(LHashes, 0);
      for LI := 0 to self.FTree.ChildCount(ADAM_AST_PROGRAM) - 1 do
        LModule := self.FTree.ChildAt(ADAM_AST_PROGRAM, LI);
        if self.FTree.RoleOf(LModule) = NodeRole.Module then
          LCount := len(LHashes);
          setlength(LHashes, LCount + 1);
          LHashes[LCount].UnitName := self.FTree[LModule].Text;
          if self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
            LHashes[LCount].Hash := self.FPlan.InterfaceHashOf(self.FTree[LModule].Text);
          else
            LHashes[LCount].Hash := AcuInterfaceHash(self.FTree, LModule);
          end;
        end;
      end;
      return LHashes;
    end;

    // True when the module AModule is the std's or the runtime's (its .acu in the shared
    // cache): as the plan decided it, else by its source (AcuPlan.UnitShared)
    hidden const method DoIsShared(const AModule: int64): bool;
    begin
      return self.FPlan.UnitShared(self.FTree[AModule].Text, self.FTree[AModule].Place.FileName);
    end;

    // ABytes, the module AModule's object, written as its .acu through a temporary file put
    // into place in one step: at the first of the plan's files for it (AcuPlan.FilesOf: the
    // shared cache's, then the user's, for a std or runtime unit) that takes it, its folder
    // made first; the plan then reads it from there. False after DR0011 (no file took it: the
    // last one tried is named)
    hidden method DoWriteUnit(const AModule: int64; const ABytes: ByteArray): bool;
    var
      LFiles: StringArray;
      LPath: string;
      LTemp: string;
      LI: int64;
    begin
      LFiles := self.FPlan.FilesOf(self.FTree[AModule].Text, self.DoIsShared(AModule));
      LPath := "";
      for LI := 0 to len(LFiles) - 1 do
        LPath := LFiles[LI];
        LTemp := LPath + ADAM_EXT_TEMP;
        if ForceDirectories(ExtractFileDir(LPath)) then
          if WriteAllBytes(LTemp, ABytes) and ReplaceFile(LTemp, LPath) then
            // The plan's copy of the file as it was is gone: its next ask reads this one
            self.FPlan.Forget(LPath);
            self.FPlan.NoteWritten(self.FTree[AModule].Text, LPath);
            return true;
          end;
          // The temporary file is this build's own: never left behind (only a resolved
          // file's is named, so nothing else is ever deleted)
          DeleteFile(LTemp);
        end;
      end;
      self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_011, self.FTree[AModule].Place,
        ADAM_MSG_DRIVER_WRITE_ACU, NoArgs().Str(LPath));
      return false;
    end;

    // --emit-ir: the module AModule (ATitle its first line names: "unit <name>", "program
    // parts") added to the .ir's text, its dump (each instruction's place) then each defined
    // function's analysis; nothing without --emit-ir
    hidden method DoNoteIr(const ATitle: string; const AModule: ref IrModule);
    begin
      if not self.FEmitIr then
        return;
      end;
      self.FIrText.Add(ATitle + "\n");
      self.FIrText.Add(AModule.Dump(self.FIrPlaces));
      self.FIrText.Add(AnalysisText(AModule));
    end;

    // The module AModule, parsed from its source, compiled into its .acu (SU2.4b; where
    // DoWriteUnit puts it): its payload made from AHeader (its Imports and their hashes from
    // AHashes) and the checked tree, then the unit lowered alone, optimized at the build's
    // level (Adam.Opt.Pipeline) and generated as one object
    // of ABackend's format holding the payload in its Info section; the plan counts it.
    // False after a report (the lowering's, DR0011)
    hidden method DoCompileUnit(const ABackend: ref Backend; const AModule: int64;
      const AHeader: AcuHeader; const AHashes: AcuUnitHashArray): bool;
    var
      LPayload: ByteArray;
      LUnit: ref IrModule;
      LRoutines: int64;
      LObject: ByteArray;
    begin
      // The payload from the tree as Check left it, before anything is lowered
      self.DoStep(BuildStep.Lower);
      LPayload := WriteAcuPayload(self.FTree, AModule, AHeader, AHashes);
      LUnit := LowerUnit(self.FTree, self.FTarget, self.FReports, AModule);
      if self.FReports.HasErrors() then
        return false;
      end;
      self.DoStep(BuildStep.Optimize);
      OptimizeModule(LUnit, self.FTree.Level);
      DoVerifyIr(LUnit);
      if not self.DoIsShared(AModule) then
        self.DoNoteIr("unit " + self.FTree[AModule].Text, LUnit);
      end;
      LRoutines := DoDefinedFunctions(LUnit);
      self.DoStep(BuildStep.Generate);
      LObject := GenerateObject(LUnit, ABackend, self.FTree, LPayload);
      self.DoStep(BuildStep.Write);
      if not self.DoWriteUnit(AModule, LObject) then
        return false;
      end;
      self.FPlan.NoteCompiled(LRoutines);
      return true;
    end;

    // The current unit AModule's .acu (the file the plan read it from) written again with
    // AHeader, its header with the size and write time its source has now
    // (AcuPlan.TakeRefresh): the payload made again from the loaded tree (AHashes as
    // DoCompileUnit takes them) put over the old one in place, its code kept as it is, then
    // written as DoWriteUnit writes (a read-only shared cache's: the user's). An .acu that
    // cannot be read, or whose payload has another size, stays as it is (still current: the
    // next build hashes the source's text again). False after DR0011
    hidden method DoRefreshUnit(const ABackend: ref Backend; const AModule: int64;
      const AHeader: AcuHeader; const AHashes: AcuUnitHashArray): bool;
    var
      LBytes: ByteArray;
    begin
      if not self.FPlan.BytesOf(self.FTree[AModule].Text, LBytes) then
        return true;
      end;
      if not ABackend.Format.ReplaceSection(LBytes,
        ABackend.Format.SectionNameOf(SectionKind.Info),
        WriteAcuPayload(self.FTree, AModule, AHeader, AHashes)) then
        return true;
      end;
      return self.DoWriteUnit(AModule, LBytes);
    end;

    // Every module of the checked tree parsed from its source compiled into its .acu
    // (Adam.Acu.Format; DoCompileUnit) where DoWriteUnit puts it (ADir, the build's
    // <output>\acu\<triple>\<mode>\, made first; a std or runtime unit's in the shared cache):
    // its source's size and write time as they were when its text was read, the text's
    // Fnv1a64, its interface hash, the plan's pack key for it (0 for a shared unit); a unit
    // taken from its .acu is current there already (not lowered, not generated), written
    // again only when the plan found its source touched but unchanged (DoRefreshUnit: the
    // new write time kept, so its text is not hashed again). False after a report (DR0007
    // the folder, a unit's)
    hidden method DoCompileUnits(const ADir: string; const ABackend: ref Backend): bool;
    var
      LHeader: AcuHeader;
      LHashes: AcuUnitHashArray;
      LI: int64;
      LModule: int64;
      LIndex: int64;
      LSize: int64;
      LTime: int64;
    begin
      if (ADir = "") or not ForceDirectories(ADir) then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_007, NoPlace(),
          ADAM_MSG_DRIVER_OUTPUT_DIR, NoArgs().Str(ADir));
        return false;
      end;
      // Every routine's write summary first (SU2.8 e4): a unit's interface hash holds them,
      // and each unit's lowering reads its callees'
      SummarizeWrites(self.FTree, self.FTarget, self.FReports);
      LHashes := self.DoUnitHashes();
      // The steps count the units compiled here: every module not taken from its .acu
      self.FStepDone := 0;
      self.FStepTotal := 0;
      for LI := 0 to self.FTree.ChildCount(ADAM_AST_PROGRAM) - 1 do
        LModule := self.FTree.ChildAt(ADAM_AST_PROGRAM, LI);
        if (self.FTree.RoleOf(LModule) = NodeRole.Module) and
          not self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
          self.FStepTotal := self.FStepTotal + 1;
        end;
      end;
      for LI := 0 to self.FTree.ChildCount(ADAM_AST_PROGRAM) - 1 do
        LModule := self.FTree.ChildAt(ADAM_AST_PROGRAM, LI);
        if self.FTree.RoleOf(LModule) = NodeRole.Module then
          if self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
            if self.FPlan.TakeRefresh(self.FTree[LModule].Text, LHeader, LSize, LTime) then
              LHeader.SourceSize := LSize;
              LHeader.SourceTime := LTime;
              if not self.DoRefreshUnit(ABackend, LModule, LHeader, LHashes) then
                return false;
              end;
            end;
          else
            LHeader.FormatVersion := ADAM_ACU_FORMAT_VERSION;
            LHeader.CompilerVersion := AdamVersionText();
            LHeader.CompilerId := DoCompilerId();
            LHeader.Triple := self.FTree.Triple;
            LHeader.Mode := AcuModeOf(self.FTree.Level);
            LHeader.Defines := DoDefinesOf(self.FTree);
            LHeader.ProjectKey := self.FPlan.KeyFor(self.DoIsShared(LModule));
            LHeader.UnitName := self.FTree[LModule].Text;
            LHeader.SourcePath := self.FTree[LModule].Place.FileName;
            LIndex := self.FSources.IndexOf(LHeader.SourcePath);
            LHeader.SourceSize := 0;
            LHeader.SourceTime := 0;
            if LIndex >= 0 then
              self.FSources.StampOf(LIndex, LHeader.SourceSize, LHeader.SourceTime);
            end;
            LHeader.SourceHash := Fnv1a64(self.DoSourceOf(LModule));
            LHeader.InterfaceHash := DoHashIn(LHashes, LHeader.UnitName);
            self.FStepDone := self.FStepDone + 1;
            self.FStepUnit := LHeader.UnitName;
            if not self.DoCompileUnit(ABackend, LModule, LHeader, LHashes) then
              return false;
            end;
          end;
        end;
      end;
      return true;
    end;

    // The build's own (its AcuPlan's, through DoUnitCompilerFor), on a new Compiler: the unit
    // at APath compiled into its .acu for the build AContext describes (see UnitCompiler).
    // It takes the build's module paths, given texts, project, triple, mode and plan (no
    // project.toml of its own), parses the unit as its main module, and compiles every
    // module it parsed into its .acu (DoCompileUnits; the plan counts them). Its reports
    // join the build's when it has no error; an error leaves the build's untouched (the
    // build parses the unit itself and reports it there)
    method CompileUnitFor(const AContext: ref UnitContext; const APath: string): bool;
    begin
      self.FChecked := true;
      self.FMainPath := APath;
      self.FSources.InheritFrom(AContext.Sources);
      self.FOverrideTarget := AContext.Tree.Triple;
      self.SetLevel(AContext.Tree.Level);
      if AContext.Tree.InProject then
        self.FTree.SetProjectSecret(AContext.Tree.ProjectSecret, AContext.Tree.ProjectKey);
      end;
      self.FProjectRoot := AContext.ProjectRoot;
      self.FProjectOutput := AContext.ProjectOutput;
      self.FProjectKind := AContext.ProjectKind;
      self.FPlan := AContext.Plan;
      // The steps are the build's, told under its Parse (the import that asked for this unit)
      self.FSteps := AContext.Listener;
      self.FStepPhase := BuildPhase.Parse;
      self.FLoader := ref AcuLoader(self.FTree, self.FReports, "", self.FPlan);
      self.DoFrontEnd(true);
      if (self.FMain = 0) or self.FReports.HasErrors() then
        return false;
      end;
      if not self.DoCompileUnits(self.FPlan.Dir, self.FPlan.Format) then
        return false;
      end;
      AContext.Reports.AddFrom(self.FReports);
      return true;
    end;

    // Check on the program whose main module is AMainPath, then, when nothing stops it, every
    // unit's .acu and its exe (or dll) generated into the output folder AOutputDir ("" for
    // the default; see the header). Everything goes to Reports; nothing is printed
    method Build(const AMainPath: string; const AOutputDir: string);
    var
      LModule: ref IrModule;
      LObject: ByteArray;
      LUnit: int64;
      LI: int64;
      LBackend: ref Backend;
      LSet: ref SectionSet;
      LLibraries: StringArray;
      LSettings: ref ExeSettings;
      LBytes: ByteArray;
      LRoot: string;
      LAcuDir: string;
      LPath: string;
      LDir: string;
      LExe: string;
    begin
      // A build takes each current unit from its .acu (SU2.2), compiling a stale one alone
      // into its .acu first when that keeps its importers current (SU2.3); a check parses
      // every source
      if not self.FChecked then
        self.FPlan := ref AcuPlan(self.FSources);
        self.FPlan.SetOwnFromSource(self.FEmitIr);
        self.FLoader := ref AcuLoader(self.FTree, self.FReports, AOutputDir, self.FPlan);
      end;
      self.Check(AMainPath);
      // Every unit is decided once the parse ends: the plan's way back to this compile ends
      if self.FPlan <> nil then
        self.FPlan.Detach();
      end;
      if (self.FMain = 0) or self.FReports.HasErrors() then
        return;
      end;
      // The output folder and the backend before anything is lowered: every unit's .acu is
      // written from the checked tree (SU2.1)
      LRoot := self.DoOutputDir(AOutputDir);
      if LRoot = "" then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_007, NoPlace(),
          ADAM_MSG_DRIVER_OUTPUT_DIR, NoArgs().Str(AOutputDir));
        return;
      end;
      LBackend := PickBackend(self.FTree.Triple, self.FTree[self.FMain].Place, self.FReports);
      if LBackend = nil then
        return;
      end;
      // Every unit this tree parsed lowered alone and generated into its .acu (SU2.4b); a
      // unit taken from its .acu is neither
      LAcuDir := DoOutputPartOf(self.FTree, LRoot, ADAM_OUTPUT_ACU_DIR);
      // The plan names every unit's file (SU2.6): settled here when no import asked for it
      if not self.FPlan.Ready then
        self.FPlan.Settle(self.FTree, LRoot);
      end;
      // --emit-ir: the places are the checked tree's, before anything is lowered
      self.FIrText := ref TextBuilder();
      if self.FEmitIr then
        self.FIrPlaces := DoNodePlaces(self.FTree);
      end;
      self.DoPhaseStarted(BuildPhase.Lower);
      self.FStepPhase := BuildPhase.Lower;
      if not self.DoCompileUnits(LAcuDir, LBackend) then
        return;
      end;
      // The program's parts (every build); the parts' set is the link's
      self.FStepDone := 0;
      self.FStepTotal := 0;
      self.FStepUnit := "";
      self.DoStep(BuildStep.Program);
      LModule := LowerProgramParts(self.FTree, self.FTarget, self.FReports);
      if self.FReports.HasErrors() then
        return;
      end;
      OptimizeModule(LModule, self.FTree.Level);
      DoVerifyIr(LModule);
      self.DoNoteIr("program parts", LModule);
      self.DoPhaseEnded(BuildPhase.Lower, self.FPlan.CompiledUnits,
        self.FPlan.CompiledRoutines + DoDefinedFunctions(LModule), 0, "");
      self.DoPhaseStarted(BuildPhase.Generate);
      self.FStepPhase := BuildPhase.Generate;
      LSet := GenerateSections(LModule, LBackend, self.FTree);
      // A lib (M8d): no link; its static library and the runtime's companion one go to the
      // lib part, from every unit's .acu as it is on the disk and the parts' own object
      if self.FTree[self.FMain].Module = ModuleKind.Lib then
        self.DoPhaseEnded(BuildPhase.Generate, self.DoCodeBytes(LSet), 0, 0, "");
        self.DoPhaseStarted(BuildPhase.Link);
        if self.DoWriteLibraries(LRoot, LBackend, LSet) then
          self.DoPhaseEnded(BuildPhase.Link, 0, 0, 0, self.FExePath);
        end;
        return;
      end;
      self.FStepTotal := self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module);
      // Every unit's .acu merged into it whole, as it is on the disk (the file the plan read
      // it from or this build wrote it to): one this build compiled and one it kept link the
      // same way
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        LUnit := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        self.FStepDone := LI + 1;
        self.FStepUnit := self.FTree[LUnit].Text;
        self.DoStep(BuildStep.Merge);
        // The plan's copy: read from the disk when it was judged, or again since it was written
        if not self.FPlan.BytesOf(self.FTree[LUnit].Text, LObject) then
          self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_012, self.FTree[LUnit].Place,
            ADAM_MSG_DRIVER_READ_ACU, NoArgs().Str(self.FPlan.FileOf(self.FTree[LUnit].Text)));
          return;
        end;
        if not LBackend.Format.MergeObject(LSet, LObject, self.FTree[LUnit].Text, LUnit,
          DoExternalNodes(self.FTree, LUnit), self.FTree, self.FReports) then
          return;
        end;
      end;
      self.DoPhaseEnded(BuildPhase.Generate, self.DoCodeBytes(LSet), 0, 0, "");
      self.DoPhaseStarted(BuildPhase.Link);
      setlength(LLibraries, 0);
      LSettings := self.DoExeSettings();
      if LSettings.Dll then
        LSettings.DllName := self.FTree[self.FMain].Text + LBackend.Format.DllExtension();
      end;
      LBytes := LinkSections(LModule, LSet, LBackend, self.DoLibraryPaths(), LSettings,
        self.FTree, self.FReports, LLibraries);
      if self.FReports.HasErrors() then
        return;
      end;
      // The exe (or dll) goes to the output folder's bin part for the build's triple and mode
      // (<output>\bin\<triple>\<mode>\, SU2.5)
      LDir := DoOutputPartOf(self.FTree, LRoot, ADAM_OUTPUT_BIN_DIR);
      if (LDir = "") or not ForceDirectories(LDir) then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_007, NoPlace(),
          ADAM_MSG_DRIVER_OUTPUT_DIR, NoArgs().Str(LDir));
        return;
      end;
      if LSettings.Dll then
        LExe := ResolvePath(LSettings.DllName, LDir);
      else
        LExe := ResolvePath(self.FTree[self.FMain].Text + LBackend.Format.ExeExtension(), LDir);
      end;
      if (LExe = "") or not WriteAllBytes(LExe, LBytes) then
        self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_008, NoPlace(),
          ADAM_MSG_DRIVER_WRITE_EXE, NoArgs().Str(LExe));
        return;
      end;
      self.FExePath := LExe;
      self.FBuiltDll := LSettings.Dll;
      // A dll's import library (M8b) in the lib part (<output>\lib\<triple>\<mode>\), where
      // an exe's `@addlibrarypath` and `@linklibrary "<name>"` find it (BNF sec 2's search)
      if LSettings.Dll and not self.DoWriteImportLibrary(LRoot, LBackend, LSettings) then
        return;
      end;
      // Its C header beside the import library (M8g)
      if LSettings.Dll and not self.DoWriteCHeader(LRoot, true) then
        return;
      end;
      // A project's assets archive (adam pack's) beside the exe, so the program opens it as
      // $P:<name>.rez in every target's and mode's folder; none packed yet: nothing to copy
      if (self.FProjectRez <> "") and FileExists(self.FProjectRez) then
        if not CopyRez(self.FProjectRez, LDir, LPath) then
          self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_014, NoPlace(),
            ADAM_MSG_DRIVER_COPY_REZ, NoArgs().Str(self.FProjectRez).Str(LPath));
          return;
        end;
      end;
      // --emit-ir: <stem>.ir beside the exe, the IR the build generated from
      if self.FEmitIr then
        LPath := ChangeFileExt(LExe, ADAM_EXT_IR);
        if not WriteAllText(LPath, self.FIrText.Text()) then
          self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_013, NoPlace(),
            ADAM_MSG_DRIVER_WRITE_IR, NoArgs().Str(LPath));
          return;
        end;
      end;
      self.DoPhaseEnded(BuildPhase.Link, len(LLibraries), 0, 0, LExe);
    end;

    // The import library of the dll ASettings describes (its format's, ImportLibraryName /
    // WriteImportLibrary) written into ARoot's lib part, through a temporary file put into
    // place in one step; nothing for a format whose dlls need none. False after DR0015 (the
    // folder cannot be made or the file written)
    hidden method DoWriteImportLibrary(const ARoot: string; const ABackend: ref Backend;
      const ASettings: ref ExeSettings): bool;
    var
      LName: string;
      LPath: string;
    begin
      LName := ABackend.Format.ImportLibraryName(self.FTree[self.FMain].Text);
      if LName = "" then
        return true;
      end;
      return self.DoWriteLibraryFile(DoOutputPartOf(self.FTree, ARoot, ADAM_OUTPUT_LIB_DIR), LName,
        ABackend.Format.WriteImportLibrary(ASettings.DllName, ASettings.Exports, ASettings.ExportData),
        ADAM_ERR_DRIVER_015, ADAM_MSG_DRIVER_WRITE_IMPORT_LIBRARY, LPath);
    end;

    // The C header of the dll (ADll) or lib main module (Adam.Compiler.CHeader's
    // WriteCHeader over its exports, DoExportedDecls) written as <name>.h into ARoot's lib
    // part, beside its import library or static library, through a temporary file put into
    // place in one step. False after DR0017 (the folder cannot be made or the file written)
    hidden method DoWriteCHeader(const ARoot: string; const ADll: bool): bool;
    var
      LDir: string;
      LPath: string;
      LTemp: string;
      LText: string;
    begin
      LText := WriteCHeader(self.FTree, self.FTarget, self.FMain, self.DoExportedDecls(), ADll);
      LDir := DoOutputPartOf(self.FTree, ARoot, ADAM_OUTPUT_LIB_DIR);
      LPath := LDir;
      if LDir <> "" then
        LPath := ResolvePath(self.FTree[self.FMain].Text + ADAM_EXT_C_HEADER, LDir);
      end;
      if (LDir <> "") and ForceDirectories(LDir) and (LPath <> "") then
        LTemp := LPath + ADAM_EXT_TEMP;
        if WriteAllText(LTemp, LText) and ReplaceFile(LTemp, LPath) then
          return true;
        end;
        // The temporary file is this build's own: never left behind
        DeleteFile(LTemp);
      end;
      self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_017, NoPlace(),
        ADAM_MSG_DRIVER_WRITE_C_HEADER, NoArgs().Str(LPath));
      return false;
    end;

    // A lib's two static libraries (M8d; its format's StaticLibraryName and
    // WriteStaticLibrary) written into ARoot's lib part: the lib's own (lib<name>.a) holds
    // the lib's module, its start (the parts' object ASet, the start list entry's routine)
    // and every unit of its own, the runtime's companion (StaticLibraryName of
    // ADAM_RUNTIME_LIBRARY) every shared std and runtime unit, each unit's .acu as it is
    // on the disk, in program order: two libs in one C program share one runtime, an Adam
    // program linking the lib uses its own. ExePath names the lib's own; BuiltLib is set; an
    // --emit-ir build writes its IR beside it. False after DR0012 (a unit's .acu cannot be
    // read), DR0016 (a library cannot be written) or DR0013
    hidden method DoWriteLibraries(const ARoot: string; const ABackend: ref Backend;
      const ASet: ref SectionSet): bool;
    var
      LOwn: ObjectFileArray;
      LShared: ObjectFileArray;
      LOwnCount: int64;
      LSharedCount: int64;
      LCount: int64;
      LUnit: int64;
      LBytes: ByteArray;
      LDir: string;
      LPath: string;
      LI: int64;
    begin
      LCount := self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module);
      setlength(LOwn, LCount + 1);
      setlength(LShared, LCount);
      LOwnCount := 0;
      LSharedCount := 0;
      for LI := 0 to LCount - 1 do
        LUnit := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        self.FStepDone := LI + 1;
        self.FStepUnit := self.FTree[LUnit].Text;
        if not self.FPlan.BytesOf(self.FTree[LUnit].Text, LBytes) then
          self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_012, self.FTree[LUnit].Place,
            ADAM_MSG_DRIVER_READ_ACU, NoArgs().Str(self.FPlan.FileOf(self.FTree[LUnit].Text)));
          return false;
        end;
        if self.DoIsShared(LUnit) then
          LShared[LSharedCount].MemberName := self.FTree[LUnit].Text;
          LShared[LSharedCount].Bytes := LBytes;
          LSharedCount := LSharedCount + 1;
        else
          LOwn[LOwnCount].MemberName := self.FTree[LUnit].Text;
          LOwn[LOwnCount].Bytes := LBytes;
          LOwnCount := LOwnCount + 1;
        end;
      end;
      LOwn[LOwnCount].MemberName := self.FTree[self.FMain].Text + ADAM_DRIVER_LIB_START_MEMBER;
      LOwn[LOwnCount].Bytes := ABackend.Format.WriteObject(ASet);
      LOwnCount := LOwnCount + 1;
      setlength(LOwn, LOwnCount);
      setlength(LShared, LSharedCount);
      LDir := DoOutputPartOf(self.FTree, ARoot, ADAM_OUTPUT_LIB_DIR);
      if not self.DoWriteLibraryFile(LDir,
        ABackend.Format.StaticLibraryName(self.FTree[self.FMain].Text),
        ABackend.Format.WriteStaticLibrary(LOwn), ADAM_ERR_DRIVER_016, ADAM_MSG_DRIVER_WRITE_LIBRARY,
        LPath) then
        return false;
      end;
      self.FExePath := LPath;
      self.FBuiltLib := true;
      self.DoKeepShared(LDir, ABackend, LShared);
      if not self.DoWriteLibraryFile(LDir, ABackend.Format.StaticLibraryName(ADAM_RUNTIME_LIBRARY),
        ABackend.Format.WriteStaticLibrary(LShared), ADAM_ERR_DRIVER_016, ADAM_MSG_DRIVER_WRITE_LIBRARY,
        LPath) then
        return false;
      end;
      // Its C header beside its static library (M8g)
      if not self.DoWriteCHeader(ARoot, false) then
        return false;
      end;
      // --emit-ir: <stem>.ir beside the lib, the IR the build generated from
      if self.FEmitIr then
        LPath := ChangeFileExt(self.FExePath, ADAM_EXT_IR);
        if not WriteAllText(LPath, self.FIrText.Text()) then
          self.FReports.Add(Severity.Error, ADAM_ERR_DRIVER_013, NoPlace(),
            ADAM_MSG_DRIVER_WRITE_IR, NoArgs().Str(LPath));
          return false;
        end;
      end;
      return true;
    end;

    // The runtime's companion library is one per lib folder, shared by every lib built into
    // it (M8d2): AShared (this build's runtime and std units) keeps, after its own, each unit
    // the library already in ADir holds that this build does not use (a lib built there
    // before needs it: a C program links both libs with one companion), so building a
    // second lib never drops the first's units. Nothing kept when there is none, or it is
    // not this format's static library (it is then replaced whole)
    hidden method DoKeepShared(const ADir: string; const ABackend: ref Backend;
      var AShared: ObjectFileArray);
    var
      LPath: string;
      LBytes: ByteArray;
      LOld: ObjectFileArray;
      LNames: ref StringIdMap;
      LCount: int64;
      LI: int64;
    begin
      if ADir = "" then
        return;
      end;
      LPath := ResolvePath(ABackend.Format.StaticLibraryName(ADAM_RUNTIME_LIBRARY), ADir);
      if (LPath = "") or not FileExists(LPath) then
        return;
      end;
      if not ReadAllBytes(LPath, LBytes) then
        return;
      end;
      if not ABackend.Format.ReadStaticLibrary(LBytes, LOld) then
        return;
      end;
      LNames := ref StringIdMap();
      for LI := 0 to len(AShared) - 1 do
        LNames.Put(AShared[LI].MemberName, LI + 1);
      end;
      LCount := len(AShared);
      for LI := 0 to len(LOld) - 1 do
        if LNames.Find(LOld[LI].MemberName) = 0 then
          setlength(AShared, LCount + 1);
          AShared[LCount] := LOld[LI];
          LCount := LCount + 1;
          LNames.Put(LOld[LI].MemberName, LCount);
        end;
      end;
    end;

    // ABytes written as the file AName in the folder ADir (made first), through a temporary
    // file put into place in one step, its path into APath. False after ACode with AMessage
    // (the library's: DR0015 an import library, DR0016 a static library)
    hidden method DoWriteLibraryFile(const ADir: string; const AName: string;
      const ABytes: ByteArray; const ACode: string; const AMessage: string; var APath: string): bool;
    var
      LTemp: string;
    begin
      APath := ADir;
      if ADir <> "" then
        APath := ResolvePath(AName, ADir);
      end;
      if (ADir <> "") and ForceDirectories(ADir) and (APath <> "") then
        LTemp := APath + ADAM_EXT_TEMP;
        if WriteAllBytes(LTemp, ABytes) and ReplaceFile(LTemp, APath) then
          return true;
        end;
        // The temporary file is this build's own: never left behind
        DeleteFile(LTemp);
      end;
      self.FReports.Add(Severity.Error, ACode, NoPlace(), AMessage, NoArgs().Str(APath));
      return false;
    end;

    // Prints every report, one line each, in the order made
    const method PrintReports();
    begin
      self.FReports.PrintAll();
    end;

    // ADAM_DRIVER_EXIT_ERRORS when a report stops the build (an Error or a Fatal), else
    // ADAM_DRIVER_EXIT_OK
    const method ExitCode(): int32;
    begin
      if self.FReports.HasErrors() then
        return ADAM_DRIVER_EXIT_ERRORS;
      end;
      return ADAM_DRIVER_EXIT_OK;
    end;
  end;

type
  // The build's UnitCompiler (DoUnitCompilerFor): each unit compiled by a new Compiler for
  // the build its context describes
  BuildUnits = object(UnitCompiler)
    hidden FContext: ref UnitContext;

    init(const AContext: ref UnitContext);
    begin
      self.FContext := AContext;
    end;

    override method CompileUnit(const AName: string; const APath: string): bool;
    var
      LUnit: ref Compiler;
    begin
      LUnit := ref Compiler();
      return LUnit.CompileUnitFor(self.FContext, APath);
    end;
  end;

// See its forward declaration above
routine DoUnitCompilerFor(const AContext: ref UnitContext): ref UnitCompiler;
begin
  return ref BuildUnits(AContext);
end;

end.
