-------------------------------------------------------------------------------
  Adam.Lsp.Document.adam - One text the language server holds (M11b L1)

  LspEncoding   how a client counts a position's character (LSP's
                positionEncoding): UTF-8 bytes, UTF-16 code units (what
                every client must take), code points
  LspDocument   an open buffer (its URI, the path the front end reads it
                as, its version, its text) or a file's text that is not open
                (version -1): the text with an index of its line starts, the
                one place a position is converted. An LSP position is a
                0-based line and a 0-based character counted in the
                session's encoding; an Adam place a 1-based line and a
                1-based UTF-8 byte column; both meet here as byte offsets.
                Lines end at LF, CR LF or CR (LSP's rule). A position past
                its line's end is the line's end, a line past the last the
                text's end, one inside a character that character's start

  Prior art: PaskalCPP.LSP.Document (CONCEPT; its offset and position rules).
*******************************************************************************/

module unit Adam.Lsp.Document;

import System.SysUtils;

public const
  // A UTF-8 byte order mark: a file's first three bytes, never part of its first line's
  // columns (Adam's SourceText)
  ADAM_LSP_DOCUMENT_BOM: string = "\xEF\xBB\xBF";

public type
  // See the header
  LspEncoding = choices(Utf8, Utf16, Utf32);

// The units one character, the code point ACode spelled in ABytes UTF-8 bytes, counts in
// AEncoding
func DoWidth(const ACode: uint32; const ABytes: int64; const AEncoding: LspEncoding): int64;
begin
  if AEncoding = LspEncoding.Utf8 then
    return ABytes;
  end;
  if (AEncoding = LspEncoding.Utf16) and (ACode >= 0x10000) then
    return 2;
  end;
  return 1;
end;

public type
  // See the header
  LspDocument = object
    hidden FUri: string;
    hidden FPath: string;
    hidden FVersion: int64;
    hidden FText: string;
    // The byte offset each line starts at; the first is 0
    hidden FLineStarts: Int64Array;

    init(const AUri: string; const APath: string; const AVersion: int64; const AText: string);
    begin
      self.FUri := AUri;
      self.FPath := APath;
      self.FVersion := AVersion;
      self.FText := AText;
      self.DoIndex();
    end;

    // The client's name of it
    property Uri: string read FUri;
    // The path the front end reads it as ("" when its URI names no file: never checked)
    property Path: string read FPath;
    // The client's version of it (-1: a file that is not open)
    property Version: int64 read FVersion;
    property Text: string read FText;

    // How many lines the text has (an empty text has one)
    const method LineCount(): int64;
    begin
      return len(self.FLineStarts);
    end;

    method SetVersion(const AVersion: int64);
    begin
      self.FVersion := AVersion;
    end;

    // The whole text is AText
    method ReplaceAll(const AText: string);
    begin
      self.FText := AText;
      self.DoIndex();
    end;

    // The bytes AStart up to AEnd (offsets, clamped to the text; an end before the start is
    // the start) are AText
    method Replace(const AStart: int64; const AEnd: int64; const AText: string);
    var
      LStart: int64;
      LEnd: int64;
    begin
      LStart := self.DoClamp(AStart);
      LEnd := self.DoClamp(AEnd);
      if LEnd < LStart then
        LEnd := LStart;
      end;
      self.FText := Substring(self.FText, 0, LStart) + AText +
        Substring(self.FText, LEnd, len(self.FText) - LEnd);
      self.DoIndex();
    end;

    // The byte offset of the LSP position ALine / ACharacter counted in AEncoding (see the
    // header for the clamping)
    const method OffsetAt(const ALine: int64; const ACharacter: int64;
      const AEncoding: LspEncoding): int64;
    var
      LAt: int64;
      LEnd: int64;
      LNext: int64;
      LUnits: int64;
      LWidth: int64;
      LCode: uint32;
    begin
      if ALine < 0 then
        return 0;
      end;
      if ALine >= len(self.FLineStarts) then
        return len(self.FText);
      end;
      LAt := self.FLineStarts[ALine];
      LEnd := self.DoLineEnd(ALine);
      LUnits := 0;
      while LAt < LEnd do
        LNext := LAt;
        LCode := DecodeUtf8Char(self.FText, LNext);
        LWidth := DoWidth(LCode, LNext - LAt, AEncoding);
        // A character the position falls inside (or past) ends the walk at its start
        if LUnits + LWidth > ACharacter then
          leave;
        end;
        LUnits := LUnits + LWidth;
        LAt := LNext;
      end;
      return LAt;
    end;

    // The LSP position of the byte offset AOffset (clamped to the text) counted in
    // AEncoding: its 0-based line and character
    const method PositionAt(const AOffset: int64; const AEncoding: LspEncoding; var ALine: int64;
      var ACharacter: int64);
    var
      LOffset: int64;
      LAt: int64;
      LNext: int64;
      LCode: uint32;
    begin
      LOffset := self.DoClamp(AOffset);
      ALine := self.DoLineOf(LOffset);
      ACharacter := 0;
      LAt := self.FLineStarts[ALine];
      while LAt < LOffset do
        LNext := LAt;
        LCode := DecodeUtf8Char(self.FText, LNext);
        // An offset inside a character is that character's start
        if LNext > LOffset then
          leave;
        end;
        ACharacter := ACharacter + DoWidth(LCode, LNext - LAt, AEncoding);
        LAt := LNext;
      end;
    end;

    // The byte offset of the Adam place ALine / AColumn (1-based line, 1-based byte column):
    // line 0 (a report with no place) is the text's start; clamped to the place's line, a
    // line past the last the text's end
    const method OffsetOfPlace(const ALine: int64; const AColumn: int64): int64;
    var
      LStart: int64;
      LEnd: int64;
      LOffset: int64;
    begin
      if ALine <= 0 then
        return 0;
      end;
      if ALine > len(self.FLineStarts) then
        return len(self.FText);
      end;
      LStart := self.FLineStarts[ALine - 1];
      // Adam's line 1 starts after a UTF-8 BOM (SourceText's rule), when a client keeps one
      if (ALine = 1) and StartsStr(ADAM_LSP_DOCUMENT_BOM, self.FText) then
        LStart := len(ADAM_LSP_DOCUMENT_BOM);
      end;
      LEnd := self.DoLineEnd(ALine - 1);
      LOffset := LStart + AColumn - 1;
      if LOffset < LStart then
        return LStart;
      end;
      if LOffset > LEnd then
        return LEnd;
      end;
      return LOffset;
    end;

    // AOffset clamped to 0 .. the text's length
    hidden const method DoClamp(const AOffset: int64): int64;
    begin
      if AOffset < 0 then
        return 0;
      end;
      if AOffset > len(self.FText) then
        return len(self.FText);
      end;
      return AOffset;
    end;

    // The 0-based line the byte offset AOffset (in the text) is on: the last line starting at
    // or before it
    hidden const method DoLineOf(const AOffset: int64): int64;
    var
      LLow: int64;
      LHigh: int64;
      LMiddle: int64;
    begin
      // Binary search for the last start <= AOffset (the first start is 0)
      LLow := 0;
      LHigh := len(self.FLineStarts) - 1;
      while LLow < LHigh do
        LMiddle := (LLow + LHigh + 1) div 2;
        if self.FLineStarts[LMiddle] <= AOffset then
          LLow := LMiddle;
        else
          LHigh := LMiddle - 1;
        end;
      end;
      return LLow;
    end;

    // The byte offset the line ALine's text ends at: its line break, else the text's end
    hidden const method DoLineEnd(const ALine: int64): int64;
    var
      LAt: int64;
    begin
      LAt := self.FLineStarts[ALine];
      while (LAt < len(self.FText)) and (self.FText[LAt] <> '\n') and (self.FText[LAt] <> '\r') do
        LAt := LAt + 1;
      end;
      return LAt;
    end;

    // FLineStarts made from the text: after each LF, CR LF and lone CR
    hidden method DoIndex();
    var
      LCount: int64;
      LI: int64;
    begin
      setlength(self.FLineStarts, 1);
      self.FLineStarts[0] := 0;
      LCount := 1;
      LI := 0;
      while LI < len(self.FText) do
        if (self.FText[LI] = '\r') and (LI + 1 < len(self.FText)) and (self.FText[LI + 1] = '\n') then
          LI := LI + 1;
        end;
        if (self.FText[LI] = '\n') or (self.FText[LI] = '\r') then
          if LCount >= len(self.FLineStarts) then
            setlength(self.FLineStarts, LCount * 2);
          end;
          self.FLineStarts[LCount] := LI + 1;
          LCount := LCount + 1;
        end;
        LI := LI + 1;
      end;
      setlength(self.FLineStarts, LCount);
    end;
  end;

end.
