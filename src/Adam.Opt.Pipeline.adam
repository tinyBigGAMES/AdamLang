-------------------------------------------------------------------------------
  Adam.Opt.Pipeline.adam - the optimizer's pass list per level (M6)

  Every lowered module goes through OptimizeModule before it is generated:
  each defined function, a function's callees before it (a declared callee
  by its body copy), each pass of the build's level in order, a fresh
  FunctionAnalysis (Adam.Opt.Analysis) made for every pass that runs. The
  passes are target-neutral, over the SSA IR alone; machine passes stay in
  the arch part (PROJECT.md AT.2).

  PassesOf is the one list: debug runs none (DESIGN sec 5: its locals stay in
  slots; unused routines and data still go at link time), safe, fast and
  small take each pass as its atom adds it (PLAN-ADAM M6 O3 on): inline
  (Adam.Opt.Inline) first, each level its own cost model, copying the
  callees the order has already optimized into their calls; then sroa then
  mem2reg (Adam.Opt.Promote), so every later pass sees values, not
  slots; then sccp (Adam.Opt.Sccp); then tailrec (Adam.Opt.Tail) turns a
  call of the function itself at a path's end into a jump back to its top,
  a loop every later pass reads as one; then simplifycfg (Adam.Opt.Cfg)
  drops the blocks sccp found nothing runs into (and a return block
  tailrec left unreached) and merges what is left straight;
  then memory (Adam.Opt.Memory) makes small copies and fills scalar moves,
  forwards stored values to the loads that read them and drops dead
  stores, over the constant Offsets sccp left; then sroa and mem2reg again,
  as sccp has turned a static array's constant index arithmetic into a
  constant Offset they split and promote (and memory has left fewer
  accesses in their way); then
  combine (Adam.Opt.Combine) propagates copies and turns each value into its
  simplest exact form, over the values the second promotion made; then gvn
  (Adam.Opt.Gvn) replaces a value, a load or a pure call computed again
  where an identical one dominates it, and gives a check repeated under an
  identical one its known condition; then licm (Adam.Opt.Loops) puts each
  loop in its form (preheader, one latch, dedicated exits, lcssa) and moves
  what does not change in it to the preheader, after gvn so a value
  computed twice moves once; then indvars (Adam.Opt.Loops) reads each
  loop's induction variables: a check their ranges prove gets its known
  condition, an exit phi the variable's last value, an address a
  multiple of one a pointer stepped each turn, a variable stepping with
  another that one plus a difference; at fast then loopshape
  (Adam.Opt.Loops) unswitches a loop on a condition made outside it,
  unrolls a loop whose turns it can count in full (else partially, each
  copy keeping its exit tests) and rotates a loop that tests at its top,
  and sccp and combine fold the unrolled turns' values; then simplifycfg
  folds gvn's and
  indvars' known branches (the raise path left unreached, the constant
  unused) and merges the preheaders and exits licm made into their
  neighbours; then adce
  (Adam.Opt.Dce) drops what nothing the program does needs, the values the
  passes before it left without a use among them; then tailcall
  (Adam.Opt.Tail) marks each call of another routine left at a path's end
  a tail call (a jump when the target's ABI allows), copying its return
  into its block; then simplifycfg again drops the blocks adce's jumps
  skip (and a return block tailcall left unreached), folds the branches
  on compares combine found known, and merges the chains they leave. A
  pass that leaves the IR malformed is a compiler bug: the compiler's own
  debug build verifies the function (and its funclets) after every pass that
  changed it and raises, naming the pass and the function; that check costs
  the function's size, never the module's (IrModule.VerifyFunction), so it
  stays linear as the passes grow. The driver's one Verify of the whole
  module still runs before the code is generated, at every build.
*******************************************************************************/

module unit Adam.Opt.Pipeline;

import System.SysUtils, Adam.Core.Common, Adam.Core.Containers, Adam.Backend.Ssa,
  Adam.Opt.Analysis, Adam.Opt.Promote, Adam.Opt.Sccp, Adam.Opt.Memory, Adam.Opt.Combine,
  Adam.Opt.Gvn, Adam.Opt.Loops, Adam.Opt.Dce, Adam.Opt.Cfg, Adam.Opt.Inline, Adam.Opt.Tail;

public const
  // Raised (an invariant broken) by a pass that left the IR malformed
  ADAM_OPT_FAULT_PASS: string = "Opt: the IR is malformed after the pass ";

public type
  // One pass over one function of a module, its facts made for it just before; true when
  // it changed the function
  OptPassRoutine = routine(const AModule: ref IrModule; const AFunction: int64;
    const AAnalysis: ref FunctionAnalysis): bool;

  // One pass of a level's list: the name its fault gives, and its routine
  OptPass = record
    PassName: string;
    Run: OptPassRoutine;
  end;

  OptPassArray = array of OptPass;

// The passes a build at ALevel runs, in order (see the header): none at debug; at safe,
// fast and small the ones their atoms have added
public routine PassesOf(const ALevel: OptLevel): OptPassArray;
var
  LPasses: OptPassArray;
  LAt: int64;
begin
  if ALevel = OptLevel.Debug then
    setlength(LPasses, 0);
    return LPasses;
  end;
  // sroa first: the fields it splits out are mem2reg's to promote; sccp then folds what
  // they made values (simplifycfg drops the blocks it found dead), memory forwards and
  // drops what reaches memory over the constant Offsets it leaves, and those are sroa's
  // and mem2reg's again; combine simplifies what they made,
  // gvn drops what is computed twice (and makes a repeated check's branch constant),
  // licm gives each loop its form and moves its invariants to the preheader,
  // indvars proves checks from the induction variables' ranges, gives the exits their
  // values, steps addresses and merges variables that step alike,
  // at fast loopshape then unswitches, unrolls and rotates the loops, sccp folds the
  // unrolled turns' values and combine their copies,
  // simplifycfg folds those branches (their constants left unused) and merges the
  // preheaders and exits licm made straight, adce drops the values none of them left a
  // use for, and simplifycfg last the blocks its jumps skip
  // (tailrec after sccp turns a self call at a path's end into a loop, before every pass
  // that reads loops; tailcall after adce marks the calls left at a path's end, the last
  // simplifycfg dropping a return block either leaves unreached)
  if ALevel = OptLevel.Fast then
    setlength(LPasses, 20);
  else
    setlength(LPasses, 17);
  end;
  // inline first: its callees ran through the list before it (OptimizeModule's order),
  // and every pass after it sees the copies with the caller's arguments
  LPasses[0].PassName := "inline";
  if ALevel = OptLevel.Fast then
    LPasses[0].Run := InlineFast;
  else
    if ALevel = OptLevel.Small then
      LPasses[0].Run := InlineSmall;
    else
      LPasses[0].Run := InlineSafe;
    end;
  end;
  LPasses[1].PassName := "sroa";
  LPasses[1].Run := SplitSlots;
  LPasses[2].PassName := "mem2reg";
  LPasses[2].Run := PromoteSlots;
  LPasses[3].PassName := "sccp";
  LPasses[3].Run := PropagateConstants;
  LPasses[4].PassName := "tailrec";
  LPasses[4].Run := EliminateTailRecursion;
  LPasses[5].PassName := "simplifycfg";
  LPasses[5].Run := SimplifyControlFlow;
  LPasses[6].PassName := "memory";
  LPasses[6].Run := OptimizeMemory;
  LPasses[7].PassName := "sroa";
  LPasses[7].Run := SplitSlots;
  LPasses[8].PassName := "mem2reg";
  LPasses[8].Run := PromoteSlots;
  LPasses[9].PassName := "combine";
  LPasses[9].Run := CombineInstructions;
  LPasses[10].PassName := "gvn";
  LPasses[10].Run := NumberValues;
  LPasses[11].PassName := "licm";
  LPasses[11].Run := HoistInvariants;
  LPasses[12].PassName := "indvars";
  LPasses[12].Run := SimplifyInductions;
  LAt := 13;
  if ALevel = OptLevel.Fast then
    LPasses[13].PassName := "loopshape";
    LPasses[13].Run := ShapeLoops;
    LPasses[14].PassName := "sccp";
    LPasses[14].Run := PropagateConstants;
    LPasses[15].PassName := "combine";
    LPasses[15].Run := CombineInstructions;
    LAt := 16;
  end;
  LPasses[LAt].PassName := "simplifycfg";
  LPasses[LAt].Run := SimplifyControlFlow;
  LPasses[LAt + 1].PassName := "adce";
  LPasses[LAt + 1].Run := RemoveDeadCode;
  LPasses[LAt + 2].PassName := "tailcall";
  LPasses[LAt + 2].Run := MarkTailCalls;
  LPasses[LAt + 3].PassName := "simplifycfg";
  LPasses[LAt + 3].Run := SimplifyControlFlow;
  return LPasses;
end;

// The compiler's own debug build: the function AFunction (and its funclets) verified after
// the pass APass changed it, a malformed IR raised with the pass's name, the function and
// every problem
routine DoVerifyAfter(const AModule: ref IrModule; const APass: OptPass;
  const AFunction: int64);
var
  LProblems: StringArray;
begin
  LProblems := AModule.VerifyFunction(AFunction);
  if len(LProblems) > 0 then
    raise(ADAM_OPT_FAULT_PASS + APass.PassName + " in f" + IntToStr(AFunction) + ": " +
      JoinStrings(LProblems, "; "));
  end;
end;

// The function AFunction and every function it calls directly (a declared one by its
// body copy) and its funclets, those first, added to AOrder once each (AVisited: already
// added or on the way), in the order of the calls
routine DoCalleesFirst(const AModule: ref IrModule; const AFunction: int64;
  const AOrder: ref Int64List; var AVisited: BoolArray);
var
  LFunction: ref IrFunction;
  LBlock: ref IrBlock;
  LInstr: ref IrInstr;
  LCallee: int64;
  LB: int64;
  LK: int64;
begin
  if AVisited[AFunction] then
    return;
  end;
  AVisited[AFunction] := true;
  LFunction := AModule.FunctionAt(AFunction);
  for LB := 0 to LFunction.Blocks.Count - 1 do
    LBlock := AModule.BlockAt(LFunction.Blocks[LB]);
    for LK := 0 to LBlock.Instrs.Count - 1 do
      LInstr := AModule.InstrAt(LBlock.Instrs[LK]);
      if (LInstr.Kind = IrOp.Call) and AModule.IsFunction(LInstr.Link) then
        LCallee := LInstr.Link;
        if AModule.FunctionAt(LCallee).Declared then
          LCallee := AModule.FunctionAt(LCallee).InlineBody;
        end;
        if LCallee <> 0 then
          DoCalleesFirst(AModule, LCallee, AOrder, AVisited);
        end;
      end;
    end;
  end;
  // its funclets before it too: a funclet the inliner copies is then an optimized one
  for LK := 0 to LFunction.ScopeCount() - 1 do
    LCallee := LFunction.ScopeHandler(LK);
    if AModule.IsFunction(LCallee) then
      if AModule.FunctionAt(LCallee).Parent = AFunction then
        DoCalleesFirst(AModule, LCallee, AOrder, AVisited);
      end;
    end;
  end;
  if not LFunction.Declared then
    AOrder.Add(AFunction);
  end;
end;

// AModule optimized at ALevel: every defined function through every pass PassesOf names,
// in order (see the header), a function's callees before it (the inliner copies them
// optimized); a cycle of calls is entered at its lowest id
public routine OptimizeModule(const AModule: ref IrModule; const ALevel: OptLevel);
var
  LPasses: OptPassArray;
  LAnalysis: ref FunctionAnalysis;
  LOrder: ref Int64List;
  LVisited: BoolArray;
  LChanged: bool;
  LO: int64;
  LF: int64;
  LI: int64;
begin
  LPasses := PassesOf(ALevel);
  if len(LPasses) = 0 then
    return;
  end;
  LOrder := ref Int64List();
  setlength(LVisited, AModule.FunctionCount);
  for LF := 1 to AModule.FunctionCount - 1 do
    DoCalleesFirst(AModule, LF, LOrder, LVisited);
  end;
  for LO := 0 to LOrder.Count - 1 do
    LF := LOrder[LO];
    if not AModule.FunctionAt(LF).Declared then
      for LI := 0 to len(LPasses) - 1 do
        LAnalysis := ref FunctionAnalysis(AModule, LF);
        LChanged := LPasses[LI].Run(AModule, LF, LAnalysis);
@ifdef DEBUG
        if LChanged then
          DoVerifyAfter(AModule, LPasses[LI], LF);
        end;
@endif
      end;
    end;
  end;
end;

end.
