-------------------------------------------------------------------------------
  Adam.Opt.Pipeline.adam - the optimizer's pass list per level (M6)

  Every lowered module goes through OptimizeModule before it is generated:
  each defined function, each pass of the build's level in order, a fresh
  FunctionAnalysis (Adam.Opt.Analysis) made for every pass that runs. The
  passes are target-neutral, over the SSA IR alone; machine passes stay in
  the arch part (PROJECT.md AT.2).

  PassesOf is the one list: debug runs none (DESIGN sec 5: its locals stay in
  slots; unused routines and data still go at link time), safe, fast and
  small take each pass as its atom adds it (PLAN-ADAM M6 O3 on): sroa then
  mem2reg (Adam.Opt.Promote) first, so every later pass sees values, not
  slots; then sccp (Adam.Opt.Sccp); then simplifycfg (Adam.Opt.Cfg) drops
  the blocks sccp found nothing runs into and merges what is left straight;
  then memory (Adam.Opt.Memory) makes small copies and fills scalar moves,
  forwards stored values to the loads that read them and drops dead
  stores, over the constant Offsets sccp left; then sroa and mem2reg again,
  as sccp has turned a static array's constant index arithmetic into a
  constant Offset they split and promote (and memory has left fewer
  accesses in their way); then
  combine (Adam.Opt.Combine) propagates copies and turns each value into its
  simplest exact form, over the values the second promotion made; then gvn
  (Adam.Opt.Gvn) replaces a value, a load or a pure call computed again
  where an identical one dominates it, and gives a check repeated under an
  identical one its known condition; then licm (Adam.Opt.Loops) puts each
  loop in its form (preheader, one latch, dedicated exits, lcssa) and moves
  what does not change in it to the preheader, after gvn so a value
  computed twice moves once; then simplifycfg folds gvn's known branches
  (the raise path left unreached, the constant unused) and merges the
  preheaders and exits licm made into their neighbours; then adce
  (Adam.Opt.Dce) drops what nothing the program does needs, the values the
  passes before it left without a use among them; then simplifycfg again
  drops the blocks adce's jumps skip, folds the branches on compares
  combine found known, and merges the chains they leave. A
  pass that leaves the IR malformed is a compiler bug: the compiler's own
  debug build verifies the function (and its funclets) after every pass that
  changed it and raises, naming the pass and the function; that check costs
  the function's size, never the module's (IrModule.VerifyFunction), so it
  stays linear as the passes grow. The driver's one Verify of the whole
  module still runs before the code is generated, at every build.
*******************************************************************************/

module unit Adam.Opt.Pipeline;

import System.SysUtils, Adam.Core.Common, Adam.Backend.Ssa, Adam.Opt.Analysis,
  Adam.Opt.Promote, Adam.Opt.Sccp, Adam.Opt.Memory, Adam.Opt.Combine, Adam.Opt.Gvn,
  Adam.Opt.Loops, Adam.Opt.Dce, Adam.Opt.Cfg;

public const
  // Raised (an invariant broken) by a pass that left the IR malformed
  ADAM_OPT_FAULT_PASS: string = "Opt: the IR is malformed after the pass ";

public type
  // One pass over one function of a module, its facts made for it just before; true when
  // it changed the function
  OptPassRoutine = routine(const AModule: ref IrModule; const AFunction: int64;
    const AAnalysis: ref FunctionAnalysis): bool;

  // One pass of a level's list: the name its fault gives, and its routine
  OptPass = record
    PassName: string;
    Run: OptPassRoutine;
  end;

  OptPassArray = array of OptPass;

// The passes a build at ALevel runs, in order (see the header): none at debug; at safe,
// fast and small the ones their atoms have added
public routine PassesOf(const ALevel: OptLevel): OptPassArray;
var
  LPasses: OptPassArray;
begin
  if ALevel = OptLevel.Debug then
    setlength(LPasses, 0);
    return LPasses;
  end;
  // sroa first: the fields it splits out are mem2reg's to promote; sccp then folds what
  // they made values (simplifycfg drops the blocks it found dead), memory forwards and
  // drops what reaches memory over the constant Offsets it leaves, and those are sroa's
  // and mem2reg's again; combine simplifies what they made,
  // gvn drops what is computed twice (and makes a repeated check's branch constant),
  // licm gives each loop its form and moves its invariants to the preheader,
  // simplifycfg folds those branches (their constants left unused) and merges the
  // preheaders and exits licm made straight, adce drops the values none of them left a
  // use for, and simplifycfg last the blocks its jumps skip
  setlength(LPasses, 13);
  LPasses[0].PassName := "sroa";
  LPasses[0].Run := SplitSlots;
  LPasses[1].PassName := "mem2reg";
  LPasses[1].Run := PromoteSlots;
  LPasses[2].PassName := "sccp";
  LPasses[2].Run := PropagateConstants;
  LPasses[3].PassName := "simplifycfg";
  LPasses[3].Run := SimplifyControlFlow;
  LPasses[4].PassName := "memory";
  LPasses[4].Run := OptimizeMemory;
  LPasses[5].PassName := "sroa";
  LPasses[5].Run := SplitSlots;
  LPasses[6].PassName := "mem2reg";
  LPasses[6].Run := PromoteSlots;
  LPasses[7].PassName := "combine";
  LPasses[7].Run := CombineInstructions;
  LPasses[8].PassName := "gvn";
  LPasses[8].Run := NumberValues;
  LPasses[9].PassName := "licm";
  LPasses[9].Run := HoistInvariants;
  LPasses[10].PassName := "simplifycfg";
  LPasses[10].Run := SimplifyControlFlow;
  LPasses[11].PassName := "adce";
  LPasses[11].Run := RemoveDeadCode;
  LPasses[12].PassName := "simplifycfg";
  LPasses[12].Run := SimplifyControlFlow;
  return LPasses;
end;

// The compiler's own debug build: the function AFunction (and its funclets) verified after
// the pass APass changed it, a malformed IR raised with the pass's name, the function and
// every problem
routine DoVerifyAfter(const AModule: ref IrModule; const APass: OptPass;
  const AFunction: int64);
var
  LProblems: StringArray;
begin
  LProblems := AModule.VerifyFunction(AFunction);
  if len(LProblems) > 0 then
    raise(ADAM_OPT_FAULT_PASS + APass.PassName + " in f" + IntToStr(AFunction) + ": " +
      JoinStrings(LProblems, "; "));
  end;
end;

// AModule optimized at ALevel: every defined function through every pass PassesOf names,
// in order (see the header)
public routine OptimizeModule(const AModule: ref IrModule; const ALevel: OptLevel);
var
  LPasses: OptPassArray;
  LAnalysis: ref FunctionAnalysis;
  LChanged: bool;
  LF: int64;
  LI: int64;
begin
  LPasses := PassesOf(ALevel);
  if len(LPasses) = 0 then
    return;
  end;
  for LF := 1 to AModule.FunctionCount - 1 do
    if not AModule.FunctionAt(LF).Declared then
      for LI := 0 to len(LPasses) - 1 do
        LAnalysis := ref FunctionAnalysis(AModule, LF);
        LChanged := LPasses[LI].Run(AModule, LF, LAnalysis);
@ifdef DEBUG
        if LChanged then
          DoVerifyAfter(AModule, LPasses[LI], LF);
        end;
@endif
      end;
    end;
  end;
end;

end.
