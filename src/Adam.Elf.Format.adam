-------------------------------------------------------------------------------
  Adam.Elf.Format.adam - the ELF format part (DESIGN sec 7, PLAN-LINUX64 LX2)

  ElfFormat     the FormatPart (Adam.Backend.Parts) of ELF64 objects and
                images: a section of each kind is the one the gABI and GNU's
                tools name (code .text, constants .rodata, data .data, zeroed
                .bss, thread-local data .tdata); an object is written by
                Adam.Elf.Writer for the arch its ElfMachine describes
                (Adam.Backend.Targets composes the pair). An exe has no file
                ending, a dll is a .so that is linked itself (no import
                library), a static library lib<name>.a.

  The C start list (StartListGroupOf): a lib's start entries go in
  .init_array, which a C host's loader and glibc's start run; the bounds of
  an Adam image's own walk (RunStartList) are both in adam_start_bounds,
  made one after the other, and Adam's ELF linker lays every .init_array
  (and .preinit_array) section between the two (Adam.Elf.Linker), so an
  Adam exe's entry runs every start after its own managed setup, as on
  win64, and its image leaves the loader no init array (the start's once
  guard keeps a second run out either way). The thread end callbacks of a
  lib go in adam_thread_callbacks (a C identifier: a linker's __start_ /
  __stop_ bound it; the linux runtime's thread end, LX4d, runs them).

  An object is read back by Adam.Elf.Reader (ReadSection / ReplaceSection:
  a compiled unit's payload, H4). A static library is a GNU ar archive
  (Adam.Backend.Archive's Gnu kind): each object a member <name>.o, the
  symbol index its defined non-local symbols (global, weak, unique; in a
  section, absolute or common) in symbol table order, as GNU ar indexes
  them.

  Linking: a unit's object is merged whole by Adam.Elf.Foreign (MergeObject,
  its imports bound by its .adamimp list), the set linked by Adam.Elf.Linker
  (LinkExe: the static part, LX3a; the dynamic part LX3b, thread-local
  storage LX3c). Built so far (PLAN-LINUX64): the object writer (LX2a), the
  reader and the static library (LX2b), the static link (LX3a). A debug
  build's debug information is not written (DWARF is a later plan):
  WriteDebugInfo adds nothing and the image holds no debug file beside it.
*******************************************************************************/

module unit Adam.Elf.Format;

import System.SysUtils, Adam.Core.Common, Adam.Core.Containers, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics, Adam.Compiler.AST, Adam.Backend.Ssa, Adam.Backend.Sections,
  Adam.Backend.Parts, Adam.Backend.DebugInfo, Adam.Backend.Archive, Adam.Elf.Writer,
  Adam.Elf.Reader, Adam.Elf.Foreign, Adam.Elf.Linker, System.Elf;

const
  // The report budget of a scratch Diagnostics: only whether a read worked counts
  ADAM_ELF_READ_BUDGET: int64 = 1;
  // Raised (a compiler bug) by WriteStaticLibrary for a member that is no object it reads
  ADAM_ELF_FAULT_MEMBER: string = "Elf.Format: a static library member is no object: ";
  // A static library's name around its module's name
  ADAM_ELF_LIB_PREFIX: string = "lib";

public const
  // The format's name
  ADAM_ELF_FORMAT_NAME: string = "elf";
  // The sections, by kind
  ADAM_ELF_SECTION_CODE: string = ".text";
  ADAM_ELF_SECTION_READONLY: string = ".rodata";
  ADAM_ELF_SECTION_DATA: string = ".data";
  ADAM_ELF_SECTION_ZEROED: string = ".bss";
  ADAM_ELF_SECTION_THREAD_LOCAL: string = ".tdata";
  // The compiler's own data (a compiled unit's header and tree): SHF_EXCLUDE
  ADAM_ELF_SECTION_INFO: string = ".adam";
  // A unit object's import list (ImportListName; an Info section)
  ADAM_ELF_SECTION_IMPORTS: string = ".adamimp";
  // Debug: no ELF form yet (WriteDebugInfo writes none); the name a Debug kind has
  ADAM_ELF_SECTION_DEBUG: string = ".adam_debug";
  // The start list's bounds and the thread end callbacks (see the header)
  ADAM_ELF_SECTION_START_BOUNDS: string = "adam_start_bounds";
  ADAM_ELF_SECTION_THREAD_CALLBACKS: string = "adam_thread_callbacks";

public type
  // ELF (see the header)
  ElfFormat = object(FormatPart)
    // The arch's e_machine and relocation types
    Machine: ref ElfMachine;

    init(const AMachine: ref ElfMachine);
    begin
      self.Machine := AMachine;
    end;

    override method FormatName(): string;
    begin
      return ADAM_ELF_FORMAT_NAME;
    end;

    override method SectionNameOf(const AKind: SectionKind): string;
    begin
      match AKind of
        SectionKind.Code: return ADAM_ELF_SECTION_CODE;
        SectionKind.ReadOnly: return ADAM_ELF_SECTION_READONLY;
        SectionKind.Data: return ADAM_ELF_SECTION_DATA;
        SectionKind.Zeroed: return ADAM_ELF_SECTION_ZEROED;
        SectionKind.ThreadLocal: return ADAM_ELF_SECTION_THREAD_LOCAL;
        SectionKind.Info: return ADAM_ELF_SECTION_INFO;
        SectionKind.Debug: return ADAM_ELF_SECTION_DEBUG;
      end;
      return "";
    end;

    // A linux exe's file name has no ending
    override method ExeExtension(): string;
    begin
      return "";
    end;

    override method DllExtension(): string;
    begin
      return ADAM_EXT_ELF_SO;
    end;

    // The image holds its own debug information (DWARF, a later plan): no file beside it
    override method DebugFileExtension(): string;
    begin
      return "";
    end;

    // A .so is linked itself: no import library
    override method ImportLibraryName(const AModuleName: string): string;
    begin
      return "";
    end;

    override method WriteImportLibrary(const ADllName: string; const ANames: StringArray;
      const AData: BoolArray): ByteArray;
    var
      LNone: ByteArray;
    begin
      setlength(LNone, 0);
      return LNone;
    end;

    // No ELF debug information yet (see the header): nothing added
    override method WriteDebugInfo(const ASections: ref SectionSet; const ADebug: ref DebugModule);
    begin
    end;

    override method WriteObject(const ASections: ref SectionSet): ByteArray;
    begin
      return WriteElfObject(ASections, self.Machine);
    end;

    // The index of the first section named AName holding bytes in AObject (no SHT_NOBITS);
    // 0 when there is none
    method FindSection(const AObject: ElfObjectData; const AName: string): int64;
    var
      LI: int64;
    begin
      for LI := 1 to len(AObject.Sections) - 1 do
        if (AObject.Sections[LI].SectionName = AName) and
          (AObject.Sections[LI].SectionType <> int64(SHT_NOBITS)) then
          return LI;
        end;
      end;
      return 0;
    end;

    // Read by Adam.Elf.Reader; its report of a damaged object stays in a scratch
    // Diagnostics (the caller only needs to know the section is not there)
    override method ReadSection(const ABytes: ByteArray; const AName: string;
      var ASection: ByteArray): bool;
    var
      LScratch: ref Diagnostics;
      LObject: ElfObjectData;
      LIndex: int64;
      LSize: int64;
    begin
      setlength(ASection, 0);
      LScratch := ref Diagnostics(ADAM_ELF_READ_BUDGET);
      if not ReadElfObject(ABytes, 0, len(ABytes), AName, NoPlace(), LScratch, LObject) then
        return false;
      end;
      LIndex := self.FindSection(LObject, AName);
      if LIndex = 0 then
        return false;
      end;
      // One block copy (ReadElfObject checked the data lies inside ABytes)
      LSize := LObject.Sections[LIndex].DataSize;
      setlength(ASection, LSize);
      if LSize > 0 then
        CopyBytes(addr of ASection[0], addr of ABytes[LObject.Sections[LIndex].DataAt], LSize);
      end;
      return true;
    end;

    // Read by Adam.Elf.Reader as ReadSection reads (its report kept in a scratch
    // Diagnostics); the section's data overwritten where the object holds it
    override method ReplaceSection(var ABytes: ByteArray; const AName: string;
      const ASection: ByteArray): bool;
    var
      LScratch: ref Diagnostics;
      LObject: ElfObjectData;
      LIndex: int64;
    begin
      LScratch := ref Diagnostics(ADAM_ELF_READ_BUDGET);
      if not ReadElfObject(ABytes, 0, len(ABytes), AName, NoPlace(), LScratch, LObject) then
        return false;
      end;
      LIndex := self.FindSection(LObject, AName);
      if (LIndex = 0) or (LObject.Sections[LIndex].DataSize <> len(ASection)) then
        return false;
      end;
      // One block copy (ReadElfObject checked the data lies inside ABytes)
      if len(ASection) > 0 then
        CopyBytes(addr of ABytes[LObject.Sections[LIndex].DataAt], addr of ASection[0],
          len(ASection));
      end;
      return true;
    end;

    override method ImportListName(): string;
    begin
      return ADAM_ELF_SECTION_IMPORTS;
    end;

    // GNU's static archive name, lib<name>.a
    override method StaticLibraryName(const AModuleName: string): string;
    begin
      return ADAM_ELF_LIB_PREFIX + AModuleName + ADAM_EXT_AR;
    end;

    // Adam.Backend.Archive's WriteArchive (Gnu) over AObjects, each member named by its
    // object's name and the ELF object ending (.o), its index entries its defined non-local
    // symbols (see the header) in its symbol table's order
    override method WriteStaticLibrary(const AObjects: ObjectFileArray): ByteArray;
    var
      LMembers: ArchiveInputArray;
      LScratch: ref Diagnostics;
      LObject: ElfObjectData;
      LSymbol: ElfSymbol;
      LDefines: StringArray;
      LName: string;
      LCount: int64;
      LI: int64;
      LJ: int64;
    begin
      setlength(LMembers, len(AObjects));
      for LI := 0 to len(AObjects) - 1 do
        LScratch := ref Diagnostics(ADAM_ELF_READ_BUDGET);
        LName := AObjects[LI].MemberName + ADAM_EXT_ELF_OBJ;
        if not ReadElfObject(AObjects[LI].Bytes, 0, len(AObjects[LI].Bytes), LName, NoPlace(),
          LScratch, LObject) then
          raise(ADAM_ELF_FAULT_MEMBER + LName);
        end;
        setlength(LDefines, len(LObject.Symbols));
        LCount := 0;
        for LJ := 0 to len(LObject.Symbols) - 1 do
          LSymbol := LObject.Symbols[LJ];
          if (LSymbol.Bind <> int64(STB_LOCAL)) and (LSymbol.SectionIndex <> int64(SHN_UNDEF)) and
            (LSymbol.SymbolName <> "") then
            LDefines[LCount] := LSymbol.SymbolName;
            LCount := LCount + 1;
          end;
        end;
        setlength(LDefines, LCount);
        LMembers[LI].MemberName := LName;
        LMembers[LI].Bytes := AObjects[LI].Bytes;
        LMembers[LI].Defines := LDefines;
      end;
      return WriteArchive(LMembers, ArchiveKind.Gnu);
    end;

    // The members of WriteStaticLibrary's archive; false for an archive that is no such one
    // (a member that is no ELF object, or not named with the object ending)
    override method ReadStaticLibrary(const ABytes: ByteArray; var AObjects: ObjectFileArray): bool;
    var
      LArchive: ArchiveContents;
      LScratch: ref Diagnostics;
      LEntry: ArchiveEntry;
      LCount: int64;
      LI: int64;
    begin
      setlength(AObjects, 0);
      LScratch := ref Diagnostics(ADAM_ELF_READ_BUDGET);
      if not ReadArchiveContents(ABytes, "", NoPlace(), LScratch, LArchive) then
        return false;
      end;
      setlength(AObjects, len(LArchive.Entries));
      LCount := 0;
      for LI := 0 to len(LArchive.Entries) - 1 do
        LEntry := LArchive.Entries[LI];
        if LEntry.Kind = ArchiveEntryKind.Member then
          // WriteStaticLibrary's member names end in the object ending it added, its data
          // an ELF object
          if (not EndsStr(ADAM_EXT_ELF_OBJ, LEntry.EntryName)) or (LEntry.Size < 4) or
            (ABytes[LEntry.DataAt] <> ELFMAG0) or (ABytes[LEntry.DataAt + 1] <> ELFMAG1) or
            (ABytes[LEntry.DataAt + 2] <> ELFMAG2) or (ABytes[LEntry.DataAt + 3] <> ELFMAG3) then
            setlength(AObjects, 0);
            return false;
          end;
          AObjects[LCount].MemberName := Substring(LEntry.EntryName, 0,
            len(LEntry.EntryName) - len(ADAM_EXT_ELF_OBJ));
          setlength(AObjects[LCount].Bytes, LEntry.Size);
          if LEntry.Size > 0 then
            CopyBytes(addr of AObjects[LCount].Bytes[0], addr of ABytes[LEntry.DataAt], LEntry.Size);
          end;
          LCount := LCount + 1;
        end;
      end;
      setlength(AObjects, LCount);
      return true;
    end;

    override method StartListGroupOf(const APlace: StartListPlace): string;
    begin
      match APlace of
        StartListPlace.None: return "";
        StartListPlace.First: return ADAM_ELF_SECTION_START_BOUNDS;
        StartListPlace.Entry: return ADAM_ELF_SECTION_INIT_ARRAY;
        StartListPlace.Last: return ADAM_ELF_SECTION_START_BOUNDS;
        StartListPlace.ThreadCallback: return ADAM_ELF_SECTION_THREAD_CALLBACKS;
      end;
      return "";
    end;

    // Through Adam.Elf.Foreign's whole-object merge (AddObject), the object's GOT
    // references to its imports bound by its ADAM_ELF_SECTION_IMPORTS list
    override method MergeObject(const ASections: ref SectionSet; const ABytes: ByteArray;
      const ALabel: string; const ANode: int64; const ANodes: ref StringIdMap;
      const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics): bool;
    var
      LForeign: ref ElfForeignLinker;
    begin
      LForeign := ref ElfForeignLinker(ASections, self.Machine, ATree, ADiagnostics);
      if not LForeign.AddObject(ABytes, ALabel, ANode, ANodes, ADAM_ELF_SECTION_IMPORTS) then
        return false;
      end;
      return LForeign.MergeObjects();
    end;

    // Adam.Elf.Linker's LinkElfImage, the start list's bounds group the one
    // StartListGroupOf gives (see the header): ALibraries its shared libraries (DT_NEEDED's
    // files); an ELF exe holds its own symbols (no debug file); the OS calls no thread
    // callback on ELF (the runtime's thread end, LX4d)
    override method LinkExe(const ASections: ref SectionSet; const AEntry: string;
      const AThreadCallback: string; const AAddedPaths: StringArray; const ARuntime: ref CRuntimeFacts;
      const ASettings: ref ExeSettings; const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics;
      var ALibraries: StringArray; var ADebugFile: ByteArray): ByteArray;
    begin
      setlength(ADebugFile, 0);
      return LinkElfImage(ASections, self.Machine, AEntry, AAddedPaths, ARuntime, ASettings,
        self.StartListGroupOf(StartListPlace.First), ATree, ADiagnostics, ALibraries);
    end;
  end;

end.
