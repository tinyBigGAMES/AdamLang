-------------------------------------------------------------------------------
  Adam.Elf.Format.adam - the ELF format part (DESIGN sec 7, PLAN-LINUX64 LX2)

  ElfFormat     the FormatPart (Adam.Backend.Parts) of ELF64 objects and
                images: a section of each kind is the one the gABI and GNU's
                tools name (code .text, constants .rodata, data .data, zeroed
                .bss, thread-local data .tdata); an object is written by
                Adam.Elf.Writer for the arch its ElfMachine describes
                (Adam.Backend.Targets composes the pair). An exe has no file
                ending, a dll is a .so that is linked itself (no import
                library), a static library lib<name>.a.

  The C start list (StartListGroupOf): a lib's start entries go in
  .init_array, which the loader and glibc's start run (a C host's and an
  Adam image's alike: the start's once guard keeps a second run out); the
  bounds of an Adam image's own walk (RunStartList) are both in
  adam_start_bounds, made one after the other, so that walk finds nothing
  between them on ELF. The thread end callbacks of a lib go in
  adam_thread_callbacks (a C identifier: a linker's __start_ / __stop_
  bound it; the linux runtime's thread end, LX4d, runs them).

  Built so far (PLAN-LINUX64): the object writer (LX2a). A debug build's
  debug information is not written (DWARF is a later plan): WriteDebugInfo
  adds nothing and the image holds no debug file beside it. Reading an
  object back (ReadSection / ReplaceSection: a compiled unit's payload) and
  the static library's archive are LX2b's: until then no ELF .acu is read
  back (each unit compiles from its source) and a lib build raises. Linking
  (MergeObject, LinkExe) is LX3's: it reports EL0001.
*******************************************************************************/

module unit Adam.Elf.Format;

import System.SysUtils, Adam.Core.Common, Adam.Core.Containers, Adam.Core.Messages, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics, Adam.Compiler.AST, Adam.Backend.Ssa, Adam.Backend.Sections,
  Adam.Backend.Parts, Adam.Backend.DebugInfo, Adam.Elf.Writer;

const
  // Raised (a compiler bug: no lib build reaches it before LX2b)
  ADAM_ELF_FAULT_ARCHIVE: string = "Elf.Format: no ELF static library is written before PLAN-LINUX64 LX2b";
  // A static library's name around its module's name
  ADAM_ELF_LIB_PREFIX: string = "lib";

public const
  // Errors (Adam.Core.Messages' ADAM_MSG_ELF_*)
  ADAM_ERR_ELF_001: string = "EL0001";   // a link the format part cannot make yet (LX3)
  // The format's name
  ADAM_ELF_FORMAT_NAME: string = "elf";
  // The sections, by kind
  ADAM_ELF_SECTION_CODE: string = ".text";
  ADAM_ELF_SECTION_READONLY: string = ".rodata";
  ADAM_ELF_SECTION_DATA: string = ".data";
  ADAM_ELF_SECTION_ZEROED: string = ".bss";
  ADAM_ELF_SECTION_THREAD_LOCAL: string = ".tdata";
  // The compiler's own data (a compiled unit's header and tree): SHF_EXCLUDE
  ADAM_ELF_SECTION_INFO: string = ".adam";
  // A unit object's import list (ImportListName; an Info section)
  ADAM_ELF_SECTION_IMPORTS: string = ".adamimp";
  // Debug: no ELF form yet (WriteDebugInfo writes none); the name a Debug kind has
  ADAM_ELF_SECTION_DEBUG: string = ".adam_debug";
  // The start list's bounds and the thread end callbacks (see the header)
  ADAM_ELF_SECTION_START_BOUNDS: string = "adam_start_bounds";
  ADAM_ELF_SECTION_THREAD_CALLBACKS: string = "adam_thread_callbacks";

public type
  // ELF (see the header)
  ElfFormat = object(FormatPart)
    // The arch's e_machine and relocation types
    Machine: ref ElfMachine;

    init(const AMachine: ref ElfMachine);
    begin
      self.Machine := AMachine;
    end;

    override method FormatName(): string;
    begin
      return ADAM_ELF_FORMAT_NAME;
    end;

    override method SectionNameOf(const AKind: SectionKind): string;
    begin
      match AKind of
        SectionKind.Code: return ADAM_ELF_SECTION_CODE;
        SectionKind.ReadOnly: return ADAM_ELF_SECTION_READONLY;
        SectionKind.Data: return ADAM_ELF_SECTION_DATA;
        SectionKind.Zeroed: return ADAM_ELF_SECTION_ZEROED;
        SectionKind.ThreadLocal: return ADAM_ELF_SECTION_THREAD_LOCAL;
        SectionKind.Info: return ADAM_ELF_SECTION_INFO;
        SectionKind.Debug: return ADAM_ELF_SECTION_DEBUG;
      end;
      return "";
    end;

    // A linux exe's file name has no ending
    override method ExeExtension(): string;
    begin
      return "";
    end;

    override method DllExtension(): string;
    begin
      return ADAM_EXT_ELF_SO;
    end;

    // The image holds its own debug information (DWARF, a later plan): no file beside it
    override method DebugFileExtension(): string;
    begin
      return "";
    end;

    // A .so is linked itself: no import library
    override method ImportLibraryName(const AModuleName: string): string;
    begin
      return "";
    end;

    override method WriteImportLibrary(const ADllName: string; const ANames: StringArray;
      const AData: BoolArray): ByteArray;
    var
      LNone: ByteArray;
    begin
      setlength(LNone, 0);
      return LNone;
    end;

    // No ELF debug information yet (see the header): nothing added
    override method WriteDebugInfo(const ASections: ref SectionSet; const ADebug: ref DebugModule);
    begin
    end;

    override method WriteObject(const ASections: ref SectionSet): ByteArray;
    begin
      return WriteElfObject(ASections, self.Machine);
    end;

    // LX2b (see the header): no ELF object is read back yet
    override method ReadSection(const ABytes: ByteArray; const AName: string;
      var ASection: ByteArray): bool;
    begin
      setlength(ASection, 0);
      return false;
    end;

    // LX2b (see the header)
    override method ReplaceSection(var ABytes: ByteArray; const AName: string;
      const ASection: ByteArray): bool;
    begin
      return false;
    end;

    override method ImportListName(): string;
    begin
      return ADAM_ELF_SECTION_IMPORTS;
    end;

    // GNU's static archive name, lib<name>.a
    override method StaticLibraryName(const AModuleName: string): string;
    begin
      return ADAM_ELF_LIB_PREFIX + AModuleName + ADAM_EXT_AR;
    end;

    // LX2b (see the header)
    override method WriteStaticLibrary(const AObjects: ObjectFileArray): ByteArray;
    begin
      raise(ADAM_ELF_FAULT_ARCHIVE);
    end;

    // LX2b (see the header): no library read back yet
    override method ReadStaticLibrary(const ABytes: ByteArray; var AObjects: ObjectFileArray): bool;
    begin
      setlength(AObjects, 0);
      return false;
    end;

    override method StartListGroupOf(const APlace: StartListPlace): string;
    begin
      match APlace of
        StartListPlace.None: return "";
        StartListPlace.First: return ADAM_ELF_SECTION_START_BOUNDS;
        StartListPlace.Entry: return ADAM_ELF_SECTION_INIT_ARRAY;
        StartListPlace.Last: return ADAM_ELF_SECTION_START_BOUNDS;
        StartListPlace.ThreadCallback: return ADAM_ELF_SECTION_THREAD_CALLBACKS;
      end;
      return "";
    end;

    // LX3 (see the header): EL0001 at ANode (the first unit the link takes)
    override method MergeObject(const ASections: ref SectionSet; const ABytes: ByteArray;
      const ALabel: string; const ANode: int64; const ANodes: ref StringIdMap;
      const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics): bool;
    var
      LPlace: SourcePlace;
    begin
      LPlace := NoPlace();
      if (ATree <> nil) and (ANode <> 0) then
        LPlace := ATree[ANode].Place;
      end;
      ADiagnostics.Add(Severity.Error, ADAM_ERR_ELF_001, LPlace, ADAM_MSG_ELF_NO_LINKER,
        NoArgs());
      return false;
    end;

    // LX3 (see the header): EL0001, no image
    override method LinkExe(const ASections: ref SectionSet; const AEntry: string;
      const AThreadCallback: string; const AAddedPaths: StringArray; const ARuntime: ref CRuntimeFacts;
      const ASettings: ref ExeSettings; const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics;
      var ALibraries: StringArray; var ADebugFile: ByteArray): ByteArray;
    var
      LNone: ByteArray;
    begin
      setlength(ALibraries, 0);
      setlength(ADebugFile, 0);
      setlength(LNone, 0);
      ADiagnostics.Add(Severity.Error, ADAM_ERR_ELF_001, NoPlace(), ADAM_MSG_ELF_NO_LINKER,
        NoArgs());
      return LNone;
    end;
  end;

end.
