-------------------------------------------------------------------------------
  Adam.Driver.Project.adam - A project's project.toml (PaskalCPP's project
  model, PaskalCPP.Project)

  Project   one project.toml: Find (the nearest one at or above a path),
            Load (read over System.Toml, then validated), its fields and
            the full paths of its main module and output folder. It
            reports into the Diagnostics it is made with (PJ codes, no
            place: the file is no .adam source); made with nil it still
            answers, reporting nothing

  The file (format 1): the root's `format` (an integer, required);
  [project] `name`, `type` (exe | dll | lib) and `main` (strings,
  required), `output` (a string, optional: output when absent); [pack]
  `password` (a string, optional). A key or table it does not know is a
  warning (PJ0004), never an error. main and output are relative to the
  project's folder and never leave it; main is a .adam file that exists;
  output is never the project's folder itself nor inside its src or assets
  folder. A project name is an identifier, no Adam keyword in any case and
  no Windows device name (PaskalCPP also refuses its C++ words: Adam has no
  C++ surface). The pack password is printable ASCII. Every text is
  PaskalCPP's (StdApp.Resources' PaskalCPP.Project block). A project.toml
  is opt-in: none at or above a path is no report.
*******************************************************************************/

module unit Adam.Driver.Project;

import System.SysUtils, System.Windows, System.Toml, Adam.Core.Common, Adam.Core.Messages,
  Adam.Compiler.SourceText, Adam.Compiler.Diagnostics, Adam.Compiler.SourceFiles,
  Adam.Compiler.Lexer;

public const
  ADAM_ERR_PROJECT_001: string = "PJ0001";   // project.toml cannot be read or parsed
  ADAM_ERR_PROJECT_002: string = "PJ0002";   // a required key is missing
  ADAM_ERR_PROJECT_003: string = "PJ0003";   // a key holds the wrong kind of value
  ADAM_ERR_PROJECT_004: string = "PJ0004";   // an unknown key or table (a warning)
  ADAM_ERR_PROJECT_005: string = "PJ0005";   // the project name is not valid
  ADAM_ERR_PROJECT_006: string = "PJ0006";   // the project type is not exe, dll or lib
  ADAM_ERR_PROJECT_007: string = "PJ0007";   // the main module path is not valid
  ADAM_ERR_PROJECT_008: string = "PJ0008";   // the main module does not exist
  ADAM_ERR_PROJECT_009: string = "PJ0009";   // the output folder is not valid
  ADAM_ERR_PROJECT_010: string = "PJ0010";   // the pack password is not printable ASCII
  ADAM_ERR_PROJECT_011: string = "PJ0011";   // the file's format is not one Adam reads
  ADAM_ERR_PROJECT_013: string = "PJ0013";   // the search for project.toml above a path failed

  // The project file, at the project's root
  ADAM_PROJECT_FILE_NAME: string = "project.toml";
  // The newest project.toml format Adam reads
  ADAM_PROJECT_FORMAT: int64 = 1;
  // The output folder when project.toml names none
  ADAM_PROJECT_OUTPUT_DEFAULT: string = "output";
  // The project's source and assets folders (no output folder inside either)
  ADAM_PROJECT_SRC_DIR: string = "src";
  ADAM_PROJECT_ASSETS_DIR: string = "assets";
  // The tables that hold fields
  ADAM_PROJECT_TABLE_PROJECT: string = "project";
  ADAM_PROJECT_TABLE_PACK: string = "pack";
  // The bytes a pack password may hold: printable ASCII, the blank included
  ADAM_PROJECT_PRINTABLE_FIRST: int32 = 32;
  ADAM_PROJECT_PRINTABLE_LAST: int32 = 126;

public type
  // Every field of project.toml, in the order the file lists them
  ProjectField = choices(FileFormat, ProjectName, ProjectType, MainModule, OutputDir,
    PackPassword);

// The table AField sits in ("" = the root table)
routine DoFieldTable(const AField: ProjectField): string;
begin
  match AField of
    ProjectField.FileFormat: return "";
    ProjectField.ProjectName: return ADAM_PROJECT_TABLE_PROJECT;
    ProjectField.ProjectType: return ADAM_PROJECT_TABLE_PROJECT;
    ProjectField.MainModule: return ADAM_PROJECT_TABLE_PROJECT;
    ProjectField.OutputDir: return ADAM_PROJECT_TABLE_PROJECT;
    ProjectField.PackPassword: return ADAM_PROJECT_TABLE_PACK;
  end;
  return "";
end;

// AField's key in its table
routine DoFieldKey(const AField: ProjectField): string;
begin
  match AField of
    ProjectField.FileFormat: return "format";
    ProjectField.ProjectName: return "name";
    ProjectField.ProjectType: return "type";
    ProjectField.MainModule: return "main";
    ProjectField.OutputDir: return "output";
    ProjectField.PackPassword: return "password";
  end;
  return "";
end;

// True for a field the file must hold
routine DoFieldRequired(const AField: ProjectField): bool;
begin
  match AField of
    ProjectField.FileFormat: return true;
    ProjectField.ProjectName: return true;
    ProjectField.ProjectType: return true;
    ProjectField.MainModule: return true;
    ProjectField.OutputDir: return false;
    ProjectField.PackPassword: return false;
  end;
  return false;
end;

// AField's path in the document: its key, after its table and a '.' when it has one
routine DoKeyPath(const AField: ProjectField): string;
begin
  if DoFieldTable(AField) = "" then
    return DoFieldKey(AField);
  end;
  return DoFieldTable(AField) + "." + DoFieldKey(AField);
end;

// True when AKey in the table ATable ("" = the root) is a field
routine DoIsKnownKey(const ATable: string; const AKey: string): bool;
var
  LField: ProjectField;
begin
  for LField := ProjectField.FileFormat to ProjectField.PackPassword do
    if (DoFieldTable(LField) = ATable) and (DoFieldKey(LField) = AKey) then
      return true;
    end;
  end;
  return false;
end;

// True when ATable (never the root) holds a field
routine DoIsKnownTable(const ATable: string): bool;
var
  LField: ProjectField;
begin
  if ATable = "" then
    return false;
  end;
  for LField := ProjectField.FileFormat to ProjectField.PackPassword do
    if DoFieldTable(LField) = ATable then
      return true;
    end;
  end;
  return false;
end;

// True for the first field registered in its table (so each table is visited once)
routine DoIsFirstOfTable(const AField: ProjectField): bool;
var
  LField: ProjectField;
begin
  for LField := ProjectField.FileFormat to ProjectField.PackPassword do
    if LField = AField then
      return true;
    end;
    if DoFieldTable(LField) = DoFieldTable(AField) then
      return false;
    end;
  end;
  return true;
end;

// AChar's byte
routine DoByteOf(const AChar: char): int32;
begin
  return int32(uint8(AChar));
end;

// True for a letter or '_'
routine DoIsNameStart(const AByte: int32): bool;
begin
  return ((AByte >= DoByteOf('A')) and (AByte <= DoByteOf('Z'))) or
    ((AByte >= DoByteOf('a')) and (AByte <= DoByteOf('z'))) or (AByte = DoByteOf('_'));
end;

// True for a letter, a digit or '_'
routine DoIsNameByte(const AByte: int32): bool;
begin
  return DoIsNameStart(AByte) or ((AByte >= DoByteOf('0')) and (AByte <= DoByteOf('9')));
end;

// True when AName (any case) is a name Windows keeps for a device: CON, PRN, AUX, NUL,
// COM0 to COM9, LPT0 to LPT9
routine DoIsDeviceName(const AName: string): bool;
var
  LUpper: string;
  LStem: string;
  LLast: int32;
begin
  LUpper := UpperCase(AName);
  if (LUpper = "CON") or (LUpper = "PRN") or (LUpper = "AUX") or (LUpper = "NUL") then
    return true;
  end;
  if len(LUpper) <> 4 then
    return false;
  end;
  LStem := Substring(LUpper, 0, 3);
  if (LStem <> "COM") and (LStem <> "LPT") then
    return false;
  end;
  LLast := DoByteOf(LUpper[3]);
  return (LLast >= DoByteOf('0')) and (LLast <= DoByteOf('9'));
end;

// Why AName cannot name a project (an Adam.Core.Messages text); "" when it can
public routine ProjectNameProblem(const AName: string): string;
var
  LI: int64;
begin
  if (AName = "") or not DoIsNameStart(DoByteOf(AName[0])) then
    return ADAM_MSG_PROJECT_NAME_NOT_IDENT;
  end;
  for LI := 1 to len(AName) - 1 do
    if not DoIsNameByte(DoByteOf(AName[LI])) then
      return ADAM_MSG_PROJECT_NAME_NOT_IDENT;
    end;
  end;
  // Adam's words are lowercase; a name is refused in any case, as PaskalCPP does
  if KeywordKind(LowerCase(AName)) <> TokenKind.Identifier then
    return ADAM_MSG_PROJECT_NAME_RESERVED;
  end;
  if DoIsDeviceName(AName) then
    return ADAM_MSG_PROJECT_NAME_DEVICE;
  end;
  return "";
end;

// How project.toml writes the kind AKind (exe, dll, lib)
public routine ProjectKindText(const AKind: ModuleKind): string;
begin
  return LowerCase(ModuleKindText(AKind));
end;

// AText as a project kind in AKind, exactly as ProjectKindText writes it; false (AKind Exe)
// for any other text
public routine ProjectKindFromText(const AText: string; var AKind: ModuleKind): bool;
var
  LKind: ModuleKind;
begin
  AKind := ModuleKind.Exe;
  for LKind := ModuleKind.Exe to ModuleKind.Lib do
    if AText = ProjectKindText(LKind) then
      AKind := LKind;
      return true;
    end;
  end;
  return false;
end;

// True when APath is relative to the project's folder and never leaves it; false with the
// reason (an Adam.Core.Messages text) in AReason
routine DoCheckRelative(const APath: string; var AReason: string): bool;
var
  LSegments: StringArray;
  LI: int64;
begin
  AReason := "";
  if Trim(APath) = "" then
    AReason := ADAM_MSG_PROJECT_PATH_EMPTY;
    return false;
  end;
  // A prefix ($P:, $R: ...), a drive or a leading separator: rooted
  if StartsStr("$", APath) or (IndexOf(":", APath, 0) >= 0) or StartsStr("/", APath) or
    StartsStr("\\", APath) then
    AReason := ADAM_MSG_PROJECT_PATH_ROOTED;
    return false;
  end;
  LSegments := SplitString(APath, "/\\");
  for LI := 0 to len(LSegments) - 1 do
    if Trim(LSegments[LI]) = ".." then
      AReason := ADAM_MSG_PROJECT_PATH_PARENT;
      return false;
    end;
  end;
  return true;
end;

// The first segment of APath that names a folder ("" and "." name none); "" when none does
routine DoFirstSegment(const APath: string): string;
var
  LSegments: StringArray;
  LI: int64;
begin
  LSegments := SplitString(APath, "/\\");
  for LI := 0 to len(LSegments) - 1 do
    if (Trim(LSegments[LI]) <> "") and (Trim(LSegments[LI]) <> ".") then
      return Trim(LSegments[LI]);
    end;
  end;
  return "";
end;

public type
  // One project.toml (see the header)
  Project = object
    hidden FReports: ref Diagnostics;
    hidden FRoot: string;
    hidden FFileName: string;
    hidden FFileFormat: int64;
    hidden FProjectName: string;
    hidden FKind: ModuleKind;
    // The type as written (its report quotes it)
    hidden FKindText: string;
    hidden FMainModule: string;
    hidden FOutputDir: string;
    hidden FPassword: string;
    // The fields holding a usable value
    hidden FHaveFormat: bool;
    hidden FHaveName: bool;
    hidden FHaveType: bool;
    hidden FHaveMain: bool;
    hidden FHaveOutput: bool;
    hidden FHavePassword: bool;
    // No error reported since the last reset
    hidden FValid: bool;

    hidden method DoClear();
    begin
      self.FRoot := "";
      self.FFileName := "";
      self.FFileFormat := 0;
      self.FProjectName := "";
      self.FKind := ModuleKind.Exe;
      self.FKindText := "";
      self.FMainModule := "";
      self.FOutputDir := "";
      self.FPassword := "";
      self.FHaveFormat := false;
      self.FHaveName := false;
      self.FHaveType := false;
      self.FHaveMain := false;
      self.FHaveOutput := false;
      self.FHavePassword := false;
      self.FValid := true;
    end;

    // AReports takes every report (nil: none is made)
    init(const AReports: ref Diagnostics);
    begin
      self.FReports := AReports;
      self.DoClear();
    end;

    hidden method DoError(const ACode: string; const ATemplate: string; const AArgs: MessageArgs);
    begin
      self.FValid := false;
      if self.FReports <> nil then
        self.FReports.Add(Severity.Error, ACode, NoPlace(), ATemplate, AArgs);
      end;
    end;

    hidden method DoWarning(const ACode: string; const ATemplate: string; const AArgs: MessageArgs);
    begin
      if self.FReports <> nil then
        self.FReports.Add(Severity.Warning, ACode, NoPlace(), ATemplate, AArgs);
      end;
    end;

    // True when AField is absent and optional (AValue ADefault), or present as a string
    // (AValue it); false, reported, when a required field is absent or holds no string
    hidden method DoReadString(var ADoc: TomlDocument; const AField: ProjectField;
      const ADefault: string; var AValue: string): bool;
    var
      LPath: string;
    begin
      LPath := DoKeyPath(AField);
      AValue := ADefault;
      if not ADoc.Has(LPath) then
        if DoFieldRequired(AField) then
          self.DoError(ADAM_ERR_PROJECT_002, ADAM_MSG_PROJECT_KEY_MISSING,
            NoArgs().Str(self.FFileName).Str(LPath));
          return false;
        end;
        return true;
      end;
      if ADoc.KindOf(LPath) <> TomlKind.String then
        self.DoError(ADAM_ERR_PROJECT_003, ADAM_MSG_PROJECT_KEY_TYPE,
          NoArgs().Str(self.FFileName).Str(LPath).Str(ADAM_MSG_PROJECT_KIND_STRING));
        return false;
      end;
      if not ADoc.GetString(LPath, AValue) then
        self.DoError(ADAM_ERR_PROJECT_001, ADAM_MSG_PROJECT_READ_FAILED,
          NoArgs().Str(self.FFileName).Str(ADoc.ErrorText()));
        return false;
      end;
      return true;
    end;

    // As DoReadString, for an integer
    hidden method DoReadInteger(var ADoc: TomlDocument; const AField: ProjectField;
      const ADefault: int64; var AValue: int64): bool;
    var
      LPath: string;
    begin
      LPath := DoKeyPath(AField);
      AValue := ADefault;
      if not ADoc.Has(LPath) then
        if DoFieldRequired(AField) then
          self.DoError(ADAM_ERR_PROJECT_002, ADAM_MSG_PROJECT_KEY_MISSING,
            NoArgs().Str(self.FFileName).Str(LPath));
          return false;
        end;
        return true;
      end;
      if ADoc.KindOf(LPath) <> TomlKind.Integer then
        self.DoError(ADAM_ERR_PROJECT_003, ADAM_MSG_PROJECT_KEY_TYPE,
          NoArgs().Str(self.FFileName).Str(LPath).Str(ADAM_MSG_PROJECT_KIND_INTEGER));
        return false;
      end;
      if not ADoc.GetInt64(LPath, AValue) then
        self.DoError(ADAM_ERR_PROJECT_001, ADAM_MSG_PROJECT_READ_FAILED,
          NoArgs().Str(self.FFileName).Str(ADoc.ErrorText()));
        return false;
      end;
      return true;
    end;

    // Every field read from ADoc; each one that holds a usable value is marked
    hidden method DoReadFields(var ADoc: TomlDocument);
    var
      LText: string;
      LNumber: int64;
    begin
      if self.DoReadInteger(ADoc, ProjectField.FileFormat, 0, LNumber) then
        self.FFileFormat := LNumber;
        self.FHaveFormat := true;
      end;
      if self.DoReadString(ADoc, ProjectField.ProjectName, "", LText) then
        self.FProjectName := LText;
        self.FHaveName := true;
      end;
      if self.DoReadString(ADoc, ProjectField.ProjectType, "", LText) then
        self.FKindText := LText;
        self.FHaveType := true;
      end;
      if self.DoReadString(ADoc, ProjectField.MainModule, "", LText) then
        self.FMainModule := LText;
        self.FHaveMain := true;
      end;
      if self.DoReadString(ADoc, ProjectField.OutputDir, ADAM_PROJECT_OUTPUT_DEFAULT, LText) then
        self.FOutputDir := LText;
        self.FHaveOutput := true;
      end;
      if self.DoReadString(ADoc, ProjectField.PackPassword, "", LText) then
        self.FPassword := LText;
        self.FHavePassword := true;
      end;
    end;

    // A warning for every key of the table ATable ("" = the root) that is no field (at the
    // root: no field and no field's table); a table that is no table holds no keys
    hidden method DoCheckKeys(var ADoc: TomlDocument; const ATable: string);
    var
      LCount: int64;
      LKey: string;
      LI: int64;
    begin
      if (ATable <> "") and (ADoc.KindOf(ATable) <> TomlKind.Table) then
        return;
      end;
      if not ADoc.Count(ATable, LCount) then
        return;
      end;
      for LI := 0 to LCount - 1 do
        if ADoc.KeyAt(ATable, LI, LKey) then
          if ATable = "" then
            if not (DoIsKnownKey("", LKey) or DoIsKnownTable(LKey)) then
              self.DoWarning(ADAM_ERR_PROJECT_004, ADAM_MSG_PROJECT_KEY_UNKNOWN,
                NoArgs().Str(self.FFileName).Str(LKey));
            end;
          else
            if not DoIsKnownKey(ATable, LKey) then
              self.DoWarning(ADAM_ERR_PROJECT_004, ADAM_MSG_PROJECT_KEY_UNKNOWN,
                NoArgs().Str(self.FFileName).Str(ATable + "." + LKey));
            end;
          end;
        end;
      end;
    end;

    // The root's keys, then each field table's keys, checked against the fields
    hidden method DoCheckUnknown(var ADoc: TomlDocument);
    var
      LField: ProjectField;
    begin
      self.DoCheckKeys(ADoc, "");
      for LField := ProjectField.FileFormat to ProjectField.PackPassword do
        if (DoFieldTable(LField) <> "") and DoIsFirstOfTable(LField) then
          self.DoCheckKeys(ADoc, DoFieldTable(LField));
        end;
      end;
    end;

    hidden method DoValidateFormat();
    begin
      if (self.FFileFormat < 1) or (self.FFileFormat > ADAM_PROJECT_FORMAT) then
        self.DoError(ADAM_ERR_PROJECT_011, ADAM_MSG_PROJECT_FORMAT_INVALID,
          NoArgs().Str(self.FFileName).Int(self.FFileFormat).Int(ADAM_PROJECT_FORMAT));
      end;
    end;

    hidden method DoValidateName();
    var
      LReason: string;
    begin
      LReason := ProjectNameProblem(self.FProjectName);
      if LReason <> "" then
        self.DoError(ADAM_ERR_PROJECT_005, ADAM_MSG_PROJECT_NAME_INVALID,
          NoArgs().Str(self.FProjectName).Str(LReason));
      end;
    end;

    hidden method DoValidateType();
    var
      LKind: ModuleKind;
    begin
      if ProjectKindFromText(self.FKindText, LKind) then
        self.FKind := LKind;
        return;
      end;
      self.DoError(ADAM_ERR_PROJECT_006, ADAM_MSG_PROJECT_TYPE_INVALID,
        NoArgs().Str(self.FKindText));
    end;

    hidden method DoValidateMain();
    var
      LReason: string;
      LPath: string;
    begin
      if not DoCheckRelative(self.FMainModule, LReason) then
        self.DoError(ADAM_ERR_PROJECT_007, ADAM_MSG_PROJECT_MAIN_INVALID,
          NoArgs().Str(self.FMainModule).Str(LReason));
        return;
      end;
      if not EndsStr(ADAM_SOURCE_EXT, LowerCase(self.FMainModule)) then
        self.DoError(ADAM_ERR_PROJECT_007, ADAM_MSG_PROJECT_MAIN_INVALID,
          NoArgs().Str(self.FMainModule)
          .Str(NoArgs().Str(ADAM_SOURCE_EXT).Fill(ADAM_MSG_PROJECT_MAIN_EXT)));
        return;
      end;
      LPath := self.MainPath();
      if LPath = "" then
        self.DoError(ADAM_ERR_PROJECT_008, ADAM_MSG_PROJECT_MAIN_MISSING,
          NoArgs().Str(self.FMainModule).Str(ADAM_MSG_PROJECT_PATH_UNRESOLVED));
        return;
      end;
      if not FileExists(LPath) then
        self.DoError(ADAM_ERR_PROJECT_008, ADAM_MSG_PROJECT_MAIN_MISSING,
          NoArgs().Str(self.FMainModule).Str(LPath));
      end;
    end;

    hidden method DoValidateOutput();
    var
      LReason: string;
      LFirst: string;
    begin
      if not DoCheckRelative(self.FOutputDir, LReason) then
        self.DoError(ADAM_ERR_PROJECT_009, ADAM_MSG_PROJECT_OUTPUT_INVALID,
          NoArgs().Str(self.FOutputDir).Str(LReason));
        return;
      end;
      // Never the root itself (a build would fill it), never inside src or assets
      LFirst := DoFirstSegment(self.FOutputDir);
      if LFirst = "" then
        self.DoError(ADAM_ERR_PROJECT_009, ADAM_MSG_PROJECT_OUTPUT_INVALID,
          NoArgs().Str(self.FOutputDir).Str(ADAM_MSG_PROJECT_OUTPUT_ROOT));
        return;
      end;
      if (LowerCase(LFirst) = ADAM_PROJECT_SRC_DIR) or
        (LowerCase(LFirst) = ADAM_PROJECT_ASSETS_DIR) then
        self.DoError(ADAM_ERR_PROJECT_009, ADAM_MSG_PROJECT_OUTPUT_INVALID,
          NoArgs().Str(self.FOutputDir)
          .Str(NoArgs().Str(LFirst).Fill(ADAM_MSG_PROJECT_OUTPUT_RESERVED)));
      end;
    end;

    hidden method DoValidatePassword();
    var
      LByte: int32;
      LI: int64;
    begin
      for LI := 0 to len(self.FPassword) - 1 do
        LByte := DoByteOf(self.FPassword[LI]);
        if (LByte < ADAM_PROJECT_PRINTABLE_FIRST) or (LByte > ADAM_PROJECT_PRINTABLE_LAST) then
          self.DoError(ADAM_ERR_PROJECT_010, ADAM_MSG_PROJECT_PASSWORD_INVALID,
            NoArgs().Int(LI + 1));
          return;
        end;
      end;
    end;

    // The nearest folder holding project.toml at or above AStartPath (a file or a folder);
    // "" when there is none (no report: projects are opt-in)
    method Find(const AStartPath: string): string;
    var
      LDir: string;
      LUp: string;
    begin
      LDir := ResolvePath(AStartPath);
      if LDir = "" then
        self.DoError(ADAM_ERR_PROJECT_013, ADAM_MSG_PROJECT_FIND_FAILED,
          NoArgs().Str(AStartPath).Str(ADAM_MSG_PROJECT_PATH_UNRESOLVED));
        return "";
      end;
      if FileExists(LDir) then
        LDir := ExtractFileDir(LDir);
      end;
      while LDir <> "" do
        if FileExists(ResolvePath(ADAM_PROJECT_FILE_NAME, LDir)) then
          return LDir;
        end;
        // A root's folder is the root itself: nothing above it
        LUp := ExtractFileDir(LDir);
        if (LUp = "") or (LUp = LDir) then
          return "";
        end;
        LDir := LUp;
      end;
      return "";
    end;

    // Checks every field holding a value; false on any error
    method Validate(): bool;
    begin
      self.FValid := true;
      if self.FHaveFormat then
        self.DoValidateFormat();
      end;
      if self.FHaveName then
        self.DoValidateName();
      end;
      if self.FHaveType then
        self.DoValidateType();
      end;
      if self.FHaveMain then
        self.DoValidateMain();
      end;
      if self.FHaveOutput then
        self.DoValidateOutput();
      end;
      if self.FHavePassword then
        self.DoValidatePassword();
      end;
      return self.FValid;
    end;

    // Reads ARoot's project.toml and validates it; false on any error
    method Load(const ARoot: string): bool;
    var
      LDoc: TomlDocument;
      LReadValid: bool;
    begin
      self.DoClear();
      self.FRoot := ResolvePath(ARoot);
      if self.FRoot <> "" then
        self.FFileName := ResolvePath(ADAM_PROJECT_FILE_NAME, self.FRoot);
      end;
      if self.FFileName = "" then
        self.DoError(ADAM_ERR_PROJECT_001, ADAM_MSG_PROJECT_READ_FAILED,
          NoArgs().Str(ARoot).Str(ADAM_MSG_PROJECT_PATH_UNRESOLVED));
        return false;
      end;
      if not LDoc.ParseFile(self.FFileName) then
        self.DoError(ADAM_ERR_PROJECT_001, ADAM_MSG_PROJECT_READ_FAILED,
          NoArgs().Str(self.FFileName).Str(LDoc.ErrorText()));
        return false;
      end;
      self.DoReadFields(LDoc);
      self.DoCheckUnknown(LDoc);
      // Validate resets the flag: the read's errors are kept apart
      LReadValid := self.FValid;
      self.FValid := self.Validate() and LReadValid;
      return self.FValid;
    end;

    // The main module's full path; "" when it cannot be resolved
    const method MainPath(): string;
    begin
      return ResolvePath(self.FMainModule, self.FRoot);
    end;

    // The output folder's full path; "" when it cannot be resolved
    const method OutputPath(): string;
    begin
      return ResolvePath(self.FOutputDir, self.FRoot);
    end;

    // The project's folder (resolved) and its project.toml's path, after Load
    property Root: string read FRoot;
    property FileName: string read FFileName;
    // The fields as written (Kind: the type's kind, once valid)
    property FileFormat: int64 read FFileFormat;
    property ProjectName: string read FProjectName;
    property Kind: ModuleKind read FKind;
    property MainModule: string read FMainModule;
    property OutputDir: string read FOutputDir;
    property Password: string read FPassword;
  end;

end.
