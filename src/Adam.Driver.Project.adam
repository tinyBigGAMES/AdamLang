-------------------------------------------------------------------------------
  Adam.Driver.Project.adam - A project's project.toml (PaskalCPP's project
  model, PaskalCPP.Project)

  Project   one project.toml: Find (the nearest one at or above a path),
            Load (read over System.TOML.Ext, then validated), its fields and
            the full paths of its main module and output folder. It
            reports into the Diagnostics it is made with (PJ codes, no
            place: the file is no .adam source); made with nil it still
            answers, reporting nothing. Scaffold makes a new project
            (adam init): its folder, src/<name>.adam (the kind's
            starter), an empty assets folder and project.toml
            with a new pack password from the system's secure random
            generator (System.IO's SecureRandomBytes), written by
            Save as PaskalCPP writes it (LF, its three comments)
  ScramblePassword   the pack password as a project build's ProjectPassword()
            data: scrambled with System.Runtime's ProjectKeyWord stream,
            never the plain text

  The file (format 1): the root's `format` (an integer, required);
  [project] `name`, `type` (exe | dll | lib) and `main` (strings,
  required), `output` (a string, optional: output when absent); [pack]
  `password` (a string, optional). A key or table it does not know is a
  warning (PJ0004), never an error. main and output are relative to the
  project's folder and never leave it; main is a .adam file that exists;
  output is never the project's folder itself nor inside its src or assets
  folder. A project name is an identifier, no Adam keyword in any case and
  no Windows device name (PaskalCPP also refuses its C++ words: Adam has no
  C++ surface). The pack password is printable ASCII. Every text is
  PaskalCPP's (StdApp.Resources' PaskalCPP.Project block). A project.toml
  is opt-in: none at or above a path is no report.
*******************************************************************************/

module unit Adam.Driver.Project;

import System.SysUtils, System.Runtime, System.IO, System.TOML.Ext, Adam.Core.Common,
  Adam.Core.Messages, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics,
  Adam.Compiler.SourceFiles, Adam.Compiler.Lexer;

public const
  ADAM_ERR_PROJECT_001: string = "PJ0001";   // project.toml cannot be read or parsed
  ADAM_ERR_PROJECT_002: string = "PJ0002";   // a required key is missing
  ADAM_ERR_PROJECT_003: string = "PJ0003";   // a key holds the wrong kind of value
  ADAM_ERR_PROJECT_004: string = "PJ0004";   // an unknown key or table (a warning)
  ADAM_ERR_PROJECT_005: string = "PJ0005";   // the project name is not valid
  ADAM_ERR_PROJECT_006: string = "PJ0006";   // the project type is not exe, dll or lib
  ADAM_ERR_PROJECT_007: string = "PJ0007";   // the main module path is not valid
  ADAM_ERR_PROJECT_008: string = "PJ0008";   // the main module does not exist
  ADAM_ERR_PROJECT_009: string = "PJ0009";   // the output folder is not valid
  ADAM_ERR_PROJECT_010: string = "PJ0010";   // the pack password is not printable ASCII
  ADAM_ERR_PROJECT_011: string = "PJ0011";   // the file's format is not one Adam reads
  ADAM_ERR_PROJECT_012: string = "PJ0012";   // project.toml cannot be saved
  ADAM_ERR_PROJECT_013: string = "PJ0013";   // the search for project.toml above a path failed
  ADAM_ERR_PROJECT_014: string = "PJ0014";   // init: the new project's folder is already there
  ADAM_ERR_PROJECT_015: string = "PJ0015";   // init: a folder or file cannot be created
  ADAM_ERR_PROJECT_016: string = "PJ0016";   // init: no pack password could be made

  // The project file, at the project's root
  ADAM_PROJECT_FILE_NAME: string = "project" + ADAM_EXT_TOML;
  // The newest project.toml format Adam reads
  ADAM_PROJECT_FORMAT: int64 = 1;
  // The output folder when project.toml names none
  ADAM_PROJECT_OUTPUT_DEFAULT: string = "output";
  // The project's source and assets folders (no output folder inside either)
  ADAM_PROJECT_SRC_DIR: string = "src";
  ADAM_PROJECT_ASSETS_DIR: string = "assets";
  // The output folder's parts, each split by target triple and build mode as
  // <output>\<part>\<triple>\<mode>\ (OutputPartPath; mode debug / release): bin the programs
  // (adam build's exe, later a dll and its pdb; adam pack's .rez beside the exe), lib the
  // static libraries (M8: a lib module's .a, a dll's import lib), acu the compiled units (one
  // <Unit>.acu each)
  ADAM_OUTPUT_BIN_DIR: string = "bin";
  ADAM_OUTPUT_LIB_DIR: string = "lib";
  ADAM_OUTPUT_ACU_DIR: string = "acu";
  // The tables that hold fields
  ADAM_PROJECT_TABLE_PROJECT: string = "project";
  ADAM_PROJECT_TABLE_PACK: string = "pack";
  // The bytes a pack password may hold: printable ASCII, the blank included
  ADAM_PROJECT_PRINTABLE_FIRST: int32 = 32;
  ADAM_PROJECT_PRINTABLE_LAST: int32 = 126;
  // A new pack password: this many bytes of printable ASCII without the blank ('!' to '~'),
  // so a password copied by hand never loses an edge
  ADAM_PROJECT_PASSWORD_LENGTH: int64 = 64;
  ADAM_PROJECT_PASSWORD_FIRST: int32 = 33;
  ADAM_PROJECT_PASSWORD_LAST: int32 = 126;
  // What ScramblePassword hashes in front of the password for its key, so the key is no
  // plain hash of the password (the key's hash is System.SysUtils' Fnv1a64)
  ADAM_PROJECT_SECRET_SALT: string = "Adam.ProjectPassword.1";
  // What starts a comment line Save writes
  ADAM_PROJECT_COMMENT_MARK: string = "# ";

public type
  // Every field of project.toml, in the order the file lists them
  ProjectField = choices(FileFormat, ProjectName, ProjectType, MainModule, OutputDir,
    PackPassword);

// The table AField sits in ("" = the root table)
routine DoFieldTable(const AField: ProjectField): string;
begin
  match AField of
    ProjectField.FileFormat: return "";
    ProjectField.ProjectName: return ADAM_PROJECT_TABLE_PROJECT;
    ProjectField.ProjectType: return ADAM_PROJECT_TABLE_PROJECT;
    ProjectField.MainModule: return ADAM_PROJECT_TABLE_PROJECT;
    ProjectField.OutputDir: return ADAM_PROJECT_TABLE_PROJECT;
    ProjectField.PackPassword: return ADAM_PROJECT_TABLE_PACK;
  end;
  return "";
end;

// AField's key in its table
routine DoFieldKey(const AField: ProjectField): string;
begin
  match AField of
    ProjectField.FileFormat: return "format";
    ProjectField.ProjectName: return "name";
    ProjectField.ProjectType: return "type";
    ProjectField.MainModule: return "main";
    ProjectField.OutputDir: return "output";
    ProjectField.PackPassword: return "password";
  end;
  return "";
end;

// True for a field the file must hold
routine DoFieldRequired(const AField: ProjectField): bool;
begin
  match AField of
    ProjectField.FileFormat: return true;
    ProjectField.ProjectName: return true;
    ProjectField.ProjectType: return true;
    ProjectField.MainModule: return true;
    ProjectField.OutputDir: return false;
    ProjectField.PackPassword: return false;
  end;
  return false;
end;

// AField's path in the document: its key, after its table and a '.' when it has one
routine DoKeyPath(const AField: ProjectField): string;
begin
  if DoFieldTable(AField) = "" then
    return DoFieldKey(AField);
  end;
  return DoFieldTable(AField) + "." + DoFieldKey(AField);
end;

// True when AKey in the table ATable ("" = the root) is a field
routine DoIsKnownKey(const ATable: string; const AKey: string): bool;
var
  LField: ProjectField;
begin
  for LField := ProjectField.FileFormat to ProjectField.PackPassword do
    if (DoFieldTable(LField) = ATable) and (DoFieldKey(LField) = AKey) then
      return true;
    end;
  end;
  return false;
end;

// True when ATable (never the root) holds a field
routine DoIsKnownTable(const ATable: string): bool;
var
  LField: ProjectField;
begin
  if ATable = "" then
    return false;
  end;
  for LField := ProjectField.FileFormat to ProjectField.PackPassword do
    if DoFieldTable(LField) = ATable then
      return true;
    end;
  end;
  return false;
end;

// True for the first field registered in its table (so each table is visited once)
routine DoIsFirstOfTable(const AField: ProjectField): bool;
var
  LField: ProjectField;
begin
  for LField := ProjectField.FileFormat to ProjectField.PackPassword do
    if LField = AField then
      return true;
    end;
    if DoFieldTable(LField) = DoFieldTable(AField) then
      return false;
    end;
  end;
  return true;
end;

// AChar's byte
routine DoByteOf(const AChar: char): int32;
begin
  return int32(uint8(AChar));
end;

// True for a letter or '_'
routine DoIsNameStart(const AByte: int32): bool;
begin
  return ((AByte >= DoByteOf('A')) and (AByte <= DoByteOf('Z'))) or
    ((AByte >= DoByteOf('a')) and (AByte <= DoByteOf('z'))) or (AByte = DoByteOf('_'));
end;

// True for a letter, a digit or '_'
routine DoIsNameByte(const AByte: int32): bool;
begin
  return DoIsNameStart(AByte) or ((AByte >= DoByteOf('0')) and (AByte <= DoByteOf('9')));
end;

// True when AName (any case) is a name Windows keeps for a device: CON, PRN, AUX, NUL,
// COM0 to COM9, LPT0 to LPT9
routine DoIsDeviceName(const AName: string): bool;
var
  LUpper: string;
  LStem: string;
  LLast: int32;
begin
  LUpper := UpperCase(AName);
  if (LUpper = "CON") or (LUpper = "PRN") or (LUpper = "AUX") or (LUpper = "NUL") then
    return true;
  end;
  if len(LUpper) <> 4 then
    return false;
  end;
  LStem := Substring(LUpper, 0, 3);
  if (LStem <> "COM") and (LStem <> "LPT") then
    return false;
  end;
  LLast := DoByteOf(LUpper[3]);
  return (LLast >= DoByteOf('0')) and (LLast <= DoByteOf('9'));
end;

// The source file a main module path names (TODO.md 1, his 2026-11-07 / 13): a source can only
// be an .adam file, so its extension is implied. A path already ending in .adam (any case) is
// kept as given; else the name with .adam added, when that file is there ("hello.world" ->
// "hello.world.adam"); else ChangeFileExt to .adam ("hello" -> "hello.adam", "hello.txt" ->
// "hello.adam"). "" stays "". The one rule for the command line's main module and
// project.toml's main
public routine SourceFilePath(const APath: string): string;
begin
  if APath = "" then
    return "";
  end;
  if LowerCase(ExtractFileExt(APath)) = ADAM_EXT_SOURCE then
    return APath;
  end;
  if FileExists(APath + ADAM_EXT_SOURCE) then
    return APath + ADAM_EXT_SOURCE;
  end;
  return ChangeFileExt(APath, ADAM_EXT_SOURCE);
end;

// The assets archive ARez (Project.RezPath) copied into the folder ADir under its own name,
// beside the exe a build wrote there; its full path in ACopy. False when it cannot be read or
// the copy cannot be written
public routine CopyRez(const ARez: string; const ADir: string; var ACopy: string): bool;
var
  LBytes: ByteArray;
begin
  ACopy := ResolvePath(ExtractFileName(ARez), ADir);
  if ACopy = "" then
    return false;
  end;
  if not ReadAllBytes(ARez, LBytes) then
    return false;
  end;
  return WriteAllBytes(ACopy, LBytes);
end;

// Why AName cannot name a project (an Adam.Core.Messages text); "" when it can
public routine ProjectNameProblem(const AName: string): string;
var
  LI: int64;
begin
  if (AName = "") or not DoIsNameStart(DoByteOf(AName[0])) then
    return ADAM_MSG_PROJECT_NAME_NOT_IDENT;
  end;
  for LI := 1 to len(AName) - 1 do
    if not DoIsNameByte(DoByteOf(AName[LI])) then
      return ADAM_MSG_PROJECT_NAME_NOT_IDENT;
    end;
  end;
  // Adam's words are lowercase; a name is refused in any case, as PaskalCPP does
  if KeywordKind(LowerCase(AName)) <> TokenKind.Identifier then
    return ADAM_MSG_PROJECT_NAME_RESERVED;
  end;
  if DoIsDeviceName(AName) then
    return ADAM_MSG_PROJECT_NAME_DEVICE;
  end;
  return "";
end;

// How project.toml writes the kind AKind (exe, dll, lib)
public routine ProjectKindText(const AKind: ModuleKind): string;
begin
  return LowerCase(ModuleKindText(AKind));
end;

// AText as a project kind in AKind, exactly as ProjectKindText writes it; false (AKind Exe)
// for any other text
public routine ProjectKindFromText(const AText: string; var AKind: ModuleKind): bool;
var
  LKind: ModuleKind;
begin
  AKind := ModuleKind.Exe;
  for LKind := ModuleKind.Exe to ModuleKind.Lib do
    if AText = ProjectKindText(LKind) then
      AKind := LKind;
      return true;
    end;
  end;
  return false;
end;

// The folder of the output folder AOutput's part APart (ADAM_OUTPUT_BIN_DIR / _LIB_DIR /
// _ACU_DIR) for the target triple ATriple and the build mode AMode (Adam.Acu.Format's
// AcuModeOf): <AOutput>\<APart>\<ATriple>\<AMode>\, the one rule every part follows; "" when
// any piece is empty or the path cannot be resolved
public routine OutputPartPath(const AOutput: string; const APart: string;
  const ATriple: string; const AMode: string): string;
var
  LDir: string;
begin
  if (AOutput = "") or (APart = "") or (ATriple = "") or (AMode = "") then
    return "";
  end;
  LDir := ResolvePath(APart, AOutput);
  if LDir = "" then
    return "";
  end;
  LDir := ResolvePath(ATriple, LDir);
  if LDir = "" then
    return "";
  end;
  return ResolvePath(AMode, LDir);
end;

// True when APath is relative to the project's folder and never leaves it; false with the
// reason (an Adam.Core.Messages text) in AReason
routine DoCheckRelative(const APath: string; var AReason: string): bool;
var
  LSegments: StringArray;
  LI: int64;
begin
  AReason := "";
  if Trim(APath) = "" then
    AReason := ADAM_MSG_PROJECT_PATH_EMPTY;
    return false;
  end;
  // A prefix ($P:, $R: ...), a drive or a leading separator: rooted
  if StartsStr("$", APath) or (IndexOf(":", APath, 0) >= 0) or StartsStr("/", APath) or
    StartsStr("\\", APath) then
    AReason := ADAM_MSG_PROJECT_PATH_ROOTED;
    return false;
  end;
  LSegments := SplitString(APath, "/\\");
  for LI := 0 to len(LSegments) - 1 do
    if Trim(LSegments[LI]) = ".." then
      AReason := ADAM_MSG_PROJECT_PATH_PARENT;
      return false;
    end;
  end;
  return true;
end;

// The first segment of APath that names a folder ("" and "." name none); "" when none does
routine DoFirstSegment(const APath: string): string;
var
  LSegments: StringArray;
  LI: int64;
begin
  LSegments := SplitString(APath, "/\\");
  for LI := 0 to len(LSegments) - 1 do
    if (Trim(LSegments[LI]) <> "") and (Trim(LSegments[LI]) <> ".") then
      return Trim(LSegments[LI]);
    end;
  end;
  return "";
end;

// Adds AText at the end of ALines
routine DoAddLine(var ALines: StringArray; const AText: string);
var
  LCount: int64;
begin
  LCount := len(ALines);
  setlength(ALines, LCount + 1);
  ALines[LCount] := AText;
end;

// ACount '*' in a row (a block comment's rule)
routine DoStars(const ACount: int64): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  for LI := 1 to ACount do
    LText := LText + "*";
  end;
  return LText;
end;

// A new project's main module (CRLF): a blank header its author fills in (never Adam's
// copyright: the module is the user's code), then the smallest module of AKind that builds
// (PaskalCPP's PC_PRJ_STARTER_HEADER and PC_PRJ_STARTER)
routine DoStarterText(const AName: string; const AKind: ModuleKind): string;
var
  LLines: StringArray;
begin
  setlength(LLines, 0);
  DoAddLine(LLines, "/" + DoStars(79));
  DoAddLine(LLines, "  " + AName + ADAM_EXT_SOURCE + " - main module of " + AName);
  DoAddLine(LLines, "");
  DoAddLine(LLines, "  Description:");
  DoAddLine(LLines, "  Author:");
  DoAddLine(LLines, "  Copyright:");
  DoAddLine(LLines, "  License:");
  DoAddLine(LLines, DoStars(79) + "/");
  DoAddLine(LLines, "");
  DoAddLine(LLines, "module " + ProjectKindText(AKind) + " " + AName + ";");
  DoAddLine(LLines, "");
  if AKind = ModuleKind.Exe then
    DoAddLine(LLines, "begin");
    DoAddLine(LLines, "  println(\"" + AName + " runs\");");
    DoAddLine(LLines, "end.");
  else
    // A dll or a lib: one C routine to call
    DoAddLine(LLines, "public routine clink " + AName + "_add(AA: int32; AB: int32): int32;");
    DoAddLine(LLines, "begin");
    DoAddLine(LLines, "  return AA + AB;");
    DoAddLine(LLines, "end;");
    DoAddLine(LLines, "");
    DoAddLine(LLines, "end.");
  end;
  return JoinStrings(LLines, "\r\n") + "\r\n";
end;

// A new pack password (ADAM_PROJECT_PASSWORD_LENGTH bytes, '!' to '~') from the system's
// secure random generator; false when it fails. Rejection sampling: a byte below the largest
// multiple of the alphabet's size that fits in a byte maps evenly onto the alphabet and the
// rest are dropped, so no character is likelier than another (a plain mod would favour the
// first 256 mod 94 characters)
routine DoNewPassword(var APassword: string): bool;
var
  LSize: int32;
  LLimit: int32;
  LBytes: ByteArray;
  LByte: int32;
  LI: int64;
begin
  APassword := "";
  LSize := ADAM_PROJECT_PASSWORD_LAST - ADAM_PROJECT_PASSWORD_FIRST + 1;
  LLimit := (256 div LSize) * LSize;
  while len(APassword) < ADAM_PROJECT_PASSWORD_LENGTH do
    if not SecureRandomBytes(ADAM_PROJECT_PASSWORD_LENGTH * 2, LBytes) then
      APassword := "";
      return false;
    end;
    for LI := 0 to len(LBytes) - 1 do
      LByte := int32(LBytes[LI]);
      if (LByte < LLimit) and (len(APassword) < ADAM_PROJECT_PASSWORD_LENGTH) then
        APassword := APassword + char(uint8(ADAM_PROJECT_PASSWORD_FIRST + (LByte mod LSize)));
      end;
    end;
  end;
  return true;
end;

// APassword scrambled for ProjectPassword() (the Driver puts it on the AST; the plain text
// never reaches the exe): the key AKey is FNV-1a 64 over ADAM_PROJECT_SECRET_SALT and the
// password's bytes, then one SplitMix64 mix (System.Runtime's ProjectKeyWord), so one
// password always scrambles the same (determinism); each byte of ASecret is the password's
// byte XOR the keystream AKey seeds (ProjectKeyWord: a word per 8 bytes, its bytes taken low
// first), the stream System.Runtime's ProjectPassword undoes. An empty password is "" (its
// key still made)
public routine ScramblePassword(const APassword: string; var ASecret: string; var AKey: uint64);
var
  LHash: uint64;
  LState: uint64;
  LWord: uint64;
  LByte: uint8;
  LI: int64;
begin
  LHash := Fnv1a64(ADAM_PROJECT_SECRET_SALT + APassword);
  AKey := ProjectKeyWord(LHash);

  ASecret := "";
  LState := AKey;
  LWord := 0;
  for LI := 0 to len(APassword) - 1 do
    if (LI mod 8) = 0 then
      LWord := ProjectKeyWord(LState);
    end;
    LByte := uint8(uint8(APassword[LI]) xor uint8((LWord shr (8 * (LI mod 8))) & 255));
    ASecret := ASecret + char(LByte);
  end;
end;

public type
  // One project.toml (see the header)
  Project = object
    hidden FReports: ref Diagnostics;
    hidden FRoot: string;
    hidden FFileName: string;
    hidden FFileFormat: int64;
    hidden FProjectName: string;
    hidden FKind: ModuleKind;
    // The type as written (its report quotes it)
    hidden FKindText: string;
    hidden FMainModule: string;
    hidden FOutputDir: string;
    hidden FPassword: string;
    // The fields holding a usable value
    hidden FHaveFormat: bool;
    hidden FHaveName: bool;
    hidden FHaveType: bool;
    hidden FHaveMain: bool;
    hidden FHaveOutput: bool;
    hidden FHavePassword: bool;
    // No error reported since the last reset
    hidden FValid: bool;

    hidden method DoClear();
    begin
      self.FRoot := "";
      self.FFileName := "";
      self.FFileFormat := 0;
      self.FProjectName := "";
      self.FKind := ModuleKind.Exe;
      self.FKindText := "";
      self.FMainModule := "";
      self.FOutputDir := "";
      self.FPassword := "";
      self.FHaveFormat := false;
      self.FHaveName := false;
      self.FHaveType := false;
      self.FHaveMain := false;
      self.FHaveOutput := false;
      self.FHavePassword := false;
      self.FValid := true;
    end;

    // AReports takes every report (nil: none is made)
    init(const AReports: ref Diagnostics);
    begin
      self.FReports := AReports;
      self.DoClear();
    end;

    hidden method DoError(const ACode: string; const ATemplate: string; const AArgs: MessageArgs);
    begin
      self.FValid := false;
      if self.FReports <> nil then
        self.FReports.Add(Severity.Error, ACode, NoPlace(), ATemplate, AArgs);
      end;
    end;

    hidden method DoWarning(const ACode: string; const ATemplate: string; const AArgs: MessageArgs);
    begin
      if self.FReports <> nil then
        self.FReports.Add(Severity.Warning, ACode, NoPlace(), ATemplate, AArgs);
      end;
    end;

    // True when AField is absent and optional (AValue ADefault), or present as a string
    // (AValue it); false, reported, when a required field is absent or holds no string
    hidden method DoReadString(var ADoc: TomlDocument; const AField: ProjectField;
      const ADefault: string; var AValue: string): bool;
    var
      LPath: string;
    begin
      LPath := DoKeyPath(AField);
      AValue := ADefault;
      if not ADoc.Has(LPath) then
        if DoFieldRequired(AField) then
          self.DoError(ADAM_ERR_PROJECT_002, ADAM_MSG_PROJECT_KEY_MISSING,
            NoArgs().Str(self.FFileName).Str(LPath));
          return false;
        end;
        return true;
      end;
      if ADoc.KindOf(LPath) <> TomlKind.String then
        self.DoError(ADAM_ERR_PROJECT_003, ADAM_MSG_PROJECT_KEY_TYPE,
          NoArgs().Str(self.FFileName).Str(LPath).Str(ADAM_MSG_PROJECT_KIND_STRING));
        return false;
      end;
      if not ADoc.GetString(LPath, AValue) then
        self.DoError(ADAM_ERR_PROJECT_001, ADAM_MSG_PROJECT_READ_FAILED,
          NoArgs().Str(self.FFileName).Str(ADoc.ErrorText()));
        return false;
      end;
      return true;
    end;

    // As DoReadString, for an integer
    hidden method DoReadInteger(var ADoc: TomlDocument; const AField: ProjectField;
      const ADefault: int64; var AValue: int64): bool;
    var
      LPath: string;
    begin
      LPath := DoKeyPath(AField);
      AValue := ADefault;
      if not ADoc.Has(LPath) then
        if DoFieldRequired(AField) then
          self.DoError(ADAM_ERR_PROJECT_002, ADAM_MSG_PROJECT_KEY_MISSING,
            NoArgs().Str(self.FFileName).Str(LPath));
          return false;
        end;
        return true;
      end;
      if ADoc.KindOf(LPath) <> TomlKind.Integer then
        self.DoError(ADAM_ERR_PROJECT_003, ADAM_MSG_PROJECT_KEY_TYPE,
          NoArgs().Str(self.FFileName).Str(LPath).Str(ADAM_MSG_PROJECT_KIND_INTEGER));
        return false;
      end;
      if not ADoc.GetInt64(LPath, AValue) then
        self.DoError(ADAM_ERR_PROJECT_001, ADAM_MSG_PROJECT_READ_FAILED,
          NoArgs().Str(self.FFileName).Str(ADoc.ErrorText()));
        return false;
      end;
      return true;
    end;

    // Every field read from ADoc; each one that holds a usable value is marked
    hidden method DoReadFields(var ADoc: TomlDocument);
    var
      LText: string;
      LNumber: int64;
    begin
      if self.DoReadInteger(ADoc, ProjectField.FileFormat, 0, LNumber) then
        self.FFileFormat := LNumber;
        self.FHaveFormat := true;
      end;
      if self.DoReadString(ADoc, ProjectField.ProjectName, "", LText) then
        self.FProjectName := LText;
        self.FHaveName := true;
      end;
      if self.DoReadString(ADoc, ProjectField.ProjectType, "", LText) then
        self.FKindText := LText;
        self.FHaveType := true;
      end;
      if self.DoReadString(ADoc, ProjectField.MainModule, "", LText) then
        self.FMainModule := LText;
        self.FHaveMain := true;
      end;
      if self.DoReadString(ADoc, ProjectField.OutputDir, ADAM_PROJECT_OUTPUT_DEFAULT, LText) then
        self.FOutputDir := LText;
        self.FHaveOutput := true;
      end;
      if self.DoReadString(ADoc, ProjectField.PackPassword, "", LText) then
        self.FPassword := LText;
        self.FHavePassword := true;
      end;
    end;

    // A warning for every key of the table ATable ("" = the root) that is no field (at the
    // root: no field and no field's table); a table that is no table holds no keys
    hidden method DoCheckKeys(var ADoc: TomlDocument; const ATable: string);
    var
      LCount: int64;
      LKey: string;
      LI: int64;
    begin
      if (ATable <> "") and (ADoc.KindOf(ATable) <> TomlKind.Table) then
        return;
      end;
      if not ADoc.Count(ATable, LCount) then
        return;
      end;
      for LI := 0 to LCount - 1 do
        if ADoc.KeyAt(ATable, LI, LKey) then
          if ATable = "" then
            if not (DoIsKnownKey("", LKey) or DoIsKnownTable(LKey)) then
              self.DoWarning(ADAM_ERR_PROJECT_004, ADAM_MSG_PROJECT_KEY_UNKNOWN,
                NoArgs().Str(self.FFileName).Str(LKey));
            end;
          else
            if not DoIsKnownKey(ATable, LKey) then
              self.DoWarning(ADAM_ERR_PROJECT_004, ADAM_MSG_PROJECT_KEY_UNKNOWN,
                NoArgs().Str(self.FFileName).Str(ATable + "." + LKey));
            end;
          end;
        end;
      end;
    end;

    // The root's keys, then each field table's keys, checked against the fields
    hidden method DoCheckUnknown(var ADoc: TomlDocument);
    var
      LField: ProjectField;
    begin
      self.DoCheckKeys(ADoc, "");
      for LField := ProjectField.FileFormat to ProjectField.PackPassword do
        if (DoFieldTable(LField) <> "") and DoIsFirstOfTable(LField) then
          self.DoCheckKeys(ADoc, DoFieldTable(LField));
        end;
      end;
    end;

    hidden method DoValidateFormat();
    begin
      if (self.FFileFormat < 1) or (self.FFileFormat > ADAM_PROJECT_FORMAT) then
        self.DoError(ADAM_ERR_PROJECT_011, ADAM_MSG_PROJECT_FORMAT_INVALID,
          NoArgs().Str(self.FFileName).Int(self.FFileFormat).Int(ADAM_PROJECT_FORMAT));
      end;
    end;

    hidden method DoValidateName();
    var
      LReason: string;
    begin
      LReason := ProjectNameProblem(self.FProjectName);
      if LReason <> "" then
        self.DoError(ADAM_ERR_PROJECT_005, ADAM_MSG_PROJECT_NAME_INVALID,
          NoArgs().Str(self.FProjectName).Str(LReason));
      end;
    end;

    hidden method DoValidateType();
    var
      LKind: ModuleKind;
    begin
      if ProjectKindFromText(self.FKindText, LKind) then
        self.FKind := LKind;
        return;
      end;
      self.DoError(ADAM_ERR_PROJECT_006, ADAM_MSG_PROJECT_TYPE_INVALID,
        NoArgs().Str(self.FKindText));
    end;

    hidden method DoValidateMain();
    var
      LReason: string;
      LPath: string;
    begin
      if not DoCheckRelative(self.FMainModule, LReason) then
        self.DoError(ADAM_ERR_PROJECT_007, ADAM_MSG_PROJECT_MAIN_INVALID,
          NoArgs().Str(self.FMainModule).Str(LReason));
        return;
      end;
      LPath := self.MainPath();
      if LPath = "" then
        self.DoError(ADAM_ERR_PROJECT_008, ADAM_MSG_PROJECT_MAIN_MISSING,
          NoArgs().Str(self.FMainModule).Str(ADAM_MSG_PROJECT_PATH_UNRESOLVED));
        return;
      end;
      if not FileExists(LPath) then
        self.DoError(ADAM_ERR_PROJECT_008, ADAM_MSG_PROJECT_MAIN_MISSING,
          NoArgs().Str(self.FMainModule).Str(LPath));
      end;
    end;

    hidden method DoValidateOutput();
    var
      LReason: string;
      LFirst: string;
    begin
      if not DoCheckRelative(self.FOutputDir, LReason) then
        self.DoError(ADAM_ERR_PROJECT_009, ADAM_MSG_PROJECT_OUTPUT_INVALID,
          NoArgs().Str(self.FOutputDir).Str(LReason));
        return;
      end;
      // Never the root itself (a build would fill it), never inside src or assets
      LFirst := DoFirstSegment(self.FOutputDir);
      if LFirst = "" then
        self.DoError(ADAM_ERR_PROJECT_009, ADAM_MSG_PROJECT_OUTPUT_INVALID,
          NoArgs().Str(self.FOutputDir).Str(ADAM_MSG_PROJECT_OUTPUT_ROOT));
        return;
      end;
      if (LowerCase(LFirst) = ADAM_PROJECT_SRC_DIR) or
        (LowerCase(LFirst) = ADAM_PROJECT_ASSETS_DIR) then
        self.DoError(ADAM_ERR_PROJECT_009, ADAM_MSG_PROJECT_OUTPUT_INVALID,
          NoArgs().Str(self.FOutputDir)
          .Str(NoArgs().Str(LFirst).Fill(ADAM_MSG_PROJECT_OUTPUT_RESERVED)));
      end;
    end;

    hidden method DoValidatePassword();
    var
      LByte: int32;
      LI: int64;
    begin
      for LI := 0 to len(self.FPassword) - 1 do
        LByte := DoByteOf(self.FPassword[LI]);
        if (LByte < ADAM_PROJECT_PRINTABLE_FIRST) or (LByte > ADAM_PROJECT_PRINTABLE_LAST) then
          self.DoError(ADAM_ERR_PROJECT_010, ADAM_MSG_PROJECT_PASSWORD_INVALID,
            NoArgs().Int(LI + 1));
          return;
        end;
      end;
    end;

    // The nearest folder holding project.toml at or above AStartPath (a file or a folder);
    // "" when there is none (no report: projects are opt-in)
    method Find(const AStartPath: string): string;
    var
      LDir: string;
      LUp: string;
    begin
      LDir := ResolvePath(AStartPath);
      if LDir = "" then
        self.DoError(ADAM_ERR_PROJECT_013, ADAM_MSG_PROJECT_FIND_FAILED,
          NoArgs().Str(AStartPath).Str(ADAM_MSG_PROJECT_PATH_UNRESOLVED));
        return "";
      end;
      if FileExists(LDir) then
        LDir := ExtractFileDir(LDir);
      end;
      while LDir <> "" do
        if FileExists(ResolvePath(ADAM_PROJECT_FILE_NAME, LDir)) then
          return LDir;
        end;
        // A root's folder is the root itself: nothing above it
        LUp := ExtractFileDir(LDir);
        if (LUp = "") or (LUp = LDir) then
          return "";
        end;
        LDir := LUp;
      end;
      return "";
    end;

    // Checks every field holding a value; false on any error
    method Validate(): bool;
    begin
      self.FValid := true;
      if self.FHaveFormat then
        self.DoValidateFormat();
      end;
      if self.FHaveName then
        self.DoValidateName();
      end;
      if self.FHaveType then
        self.DoValidateType();
      end;
      if self.FHaveMain then
        self.DoValidateMain();
      end;
      if self.FHaveOutput then
        self.DoValidateOutput();
      end;
      if self.FHavePassword then
        self.DoValidatePassword();
      end;
      return self.FValid;
    end;

    // Reads ARoot's project.toml and validates it; false on any error
    method Load(const ARoot: string): bool;
    var
      LDoc: TomlDocument;
      LReadValid: bool;
    begin
      self.DoClear();
      self.FRoot := ResolvePath(ARoot);
      if self.FRoot <> "" then
        self.FFileName := ResolvePath(ADAM_PROJECT_FILE_NAME, self.FRoot);
      end;
      if self.FFileName = "" then
        self.DoError(ADAM_ERR_PROJECT_001, ADAM_MSG_PROJECT_READ_FAILED,
          NoArgs().Str(ARoot).Str(ADAM_MSG_PROJECT_PATH_UNRESOLVED));
        return false;
      end;
      if not LDoc.ParseFile(self.FFileName) then
        self.DoError(ADAM_ERR_PROJECT_001, ADAM_MSG_PROJECT_READ_FAILED,
          NoArgs().Str(self.FFileName).Str(LDoc.ErrorText()));
        return false;
      end;
      self.DoReadFields(LDoc);
      self.DoCheckUnknown(LDoc);
      // Validate resets the flag: the read's errors are kept apart
      LReadValid := self.FValid;
      self.FValid := self.Validate() and LReadValid;
      return self.FValid;
    end;

    // The main module's full path, its .adam implied (SourceFilePath); "" when it cannot be
    // resolved
    const method MainPath(): string;
    begin
      return SourceFilePath(ResolvePath(self.FMainModule, self.FRoot));
    end;

    // The output folder's full path; "" when it cannot be resolved
    const method OutputPath(): string;
    begin
      return ResolvePath(self.FOutputDir, self.FRoot);
    end;

    // The assets folder's full path (adam pack zips it); "" when it cannot be resolved
    const method AssetsPath(): string;
    begin
      return ResolvePath(ADAM_PROJECT_ASSETS_DIR, self.FRoot);
    end;

    // The full path of the archive adam pack writes: <name>.rez in the output folder itself
    // (assets are the same for every target and mode). Every build copies it beside the exe
    // it writes (CopyRez), so the program opens it as $P:<name>.rez; "" when the output folder
    // cannot be resolved
    const method RezPath(): string;
    var
      LOutput: string;
    begin
      LOutput := self.OutputPath();
      if LOutput = "" then
        return "";
      end;
      return ResolvePath(self.FProjectName + ADAM_EXT_REZ, LOutput);
    end;

    // Makes the folder APath (its parent exists); false, reported (PJ0015), when it cannot
    hidden method DoMakeDir(const APath: string): bool;
    begin
      if CreateDir(APath) then
        return true;
      end;
      self.DoError(ADAM_ERR_PROJECT_015, ADAM_MSG_PROJECT_SCAFFOLD_FAILED,
        NoArgs().Str(APath).Str(ADAM_MSG_PROJECT_DIR_NOT_MADE));
      return false;
    end;

    // Writes AText as the file APath (no BOM); false, reported (PJ0015), when it cannot
    hidden method DoWriteFile(const APath: string; const AText: string): bool;
    begin
      if WriteAllText(APath, AText) then
        return true;
      end;
      self.DoError(ADAM_ERR_PROJECT_015, ADAM_MSG_PROJECT_SCAFFOLD_FAILED,
        NoArgs().Str(APath).Str(ADAM_MSG_PROJECT_FILE_NOT_WRITTEN));
      return false;
    end;

    // A new project's folders and starter module at ARoot: everything but
    // project.toml, which Save writes once the main module is there. False at the first path
    // that fails (reported)
    hidden method DoScaffoldFiles(const ARoot: string; const AName: string;
      const AKind: ModuleKind): bool;
    var
      LSrcDir: string;
    begin
      LSrcDir := ResolvePath(ADAM_PROJECT_SRC_DIR, ARoot);
      if not self.DoMakeDir(ARoot) then
        return false;
      end;
      if not self.DoMakeDir(LSrcDir) then
        return false;
      end;
      if not self.DoMakeDir(ResolvePath(ADAM_PROJECT_ASSETS_DIR, ARoot)) then
        return false;
      end;
      return self.DoWriteFile(ResolvePath(AName + ADAM_EXT_SOURCE, LSrcDir),
        DoStarterText(AName, AKind));
    end;

    // Holds a new project at ARoot: format 1, AName, AKind, main src/<AName>.adam, output
    // 'output', APassword ("" = no [pack] table); every field held, nothing read or written
    method InitNew(const ARoot: string; const AName: string; const AKind: ModuleKind;
      const APassword: string);
    begin
      self.DoClear();
      self.FRoot := ResolvePath(ARoot);
      self.FFileName := ResolvePath(ADAM_PROJECT_FILE_NAME, self.FRoot);
      self.FFileFormat := ADAM_PROJECT_FORMAT;
      self.FProjectName := AName;
      self.FKind := AKind;
      self.FKindText := ProjectKindText(AKind);
      self.FMainModule := ADAM_PROJECT_SRC_DIR + "/" + AName + ADAM_EXT_SOURCE;
      self.FOutputDir := ADAM_PROJECT_OUTPUT_DEFAULT;
      self.FPassword := APassword;
      self.FHaveFormat := true;
      self.FHaveName := true;
      self.FHaveType := true;
      self.FHaveMain := true;
      self.FHaveOutput := true;
      self.FHavePassword := true;
    end;

    // AField's line of project.toml: its key, then its value as a TOML basic string
    hidden const method DoStringLine(const AField: ProjectField; const AValue: string): string;
    begin
      return DoFieldKey(AField) + " = " + TomlQuoteString(AValue);
    end;

    // Writes project.toml from the fields as PaskalCPP writes it (LF line ends; a comment
    // over the file, over [project] and over [pack]; no [pack] table without a password).
    // Never a file Load would refuse: false, reported, when the fields do not validate, or
    // PJ0012 when the file cannot be written
    method Save(): bool;
    var
      LLines: StringArray;
    begin
      if not self.Validate() then
        return false;
      end;
      setlength(LLines, 0);
      DoAddLine(LLines, ADAM_PROJECT_COMMENT_MARK + NoArgs().Fill(ADAM_MSG_PROJECT_FILE_COMMENT));
      DoAddLine(LLines, DoFieldKey(ProjectField.FileFormat) + " = " + IntToStr(self.FFileFormat));
      DoAddLine(LLines, "");
      DoAddLine(LLines, ADAM_PROJECT_COMMENT_MARK + NoArgs().Fill(ADAM_MSG_PROJECT_PROJECT_COMMENT));
      DoAddLine(LLines, "[" + ADAM_PROJECT_TABLE_PROJECT + "]");
      DoAddLine(LLines, self.DoStringLine(ProjectField.ProjectName, self.FProjectName));
      DoAddLine(LLines, self.DoStringLine(ProjectField.ProjectType, self.FKindText));
      DoAddLine(LLines, self.DoStringLine(ProjectField.MainModule, self.FMainModule));
      DoAddLine(LLines, self.DoStringLine(ProjectField.OutputDir, self.FOutputDir));
      // No password = no [pack] table (absent and "" mean the same)
      if self.FPassword <> "" then
        DoAddLine(LLines, "");
        DoAddLine(LLines, ADAM_PROJECT_COMMENT_MARK + NoArgs().Fill(ADAM_MSG_PROJECT_PACK_COMMENT));
        DoAddLine(LLines, "[" + ADAM_PROJECT_TABLE_PACK + "]");
        DoAddLine(LLines, self.DoStringLine(ProjectField.PackPassword, self.FPassword));
      end;
      if not WriteAllText(self.FFileName, JoinStrings(LLines, "\n") + "\n") then
        self.DoError(ADAM_ERR_PROJECT_012, ADAM_MSG_PROJECT_SAVE_FAILED,
          NoArgs().Str(self.FFileName).Str(ADAM_MSG_PROJECT_FILE_NOT_WRITTEN));
        return false;
      end;
      return true;
    end;

    // Makes a new project (adam init): the folder AName under AParent ("" = the working
    // folder) with src/<AName>.adam (AKind's starter), an empty assets folder and
    // project.toml with a new pack password. The name first (PJ0005: it names the folder and
    // the main module); never into a folder or file that is there (PJ0014, nothing touched);
    // the password before any file (PJ0016: the disk stays as it was). False, reported, on any
    // failure
    method Scaffold(const AParent: string; const AName: string; const AKind: ModuleKind): bool;
    var
      LReason: string;
      LRoot: string;
      LPassword: string;
    begin
      self.DoClear();
      LReason := ProjectNameProblem(AName);
      if LReason <> "" then
        self.DoError(ADAM_ERR_PROJECT_005, ADAM_MSG_PROJECT_NAME_INVALID,
          NoArgs().Str(AName).Str(LReason));
        return false;
      end;
      if AParent = "" then
        LRoot := ResolvePath(AName);
      else
        LRoot := ResolvePath(AName, AParent);
      end;
      if LRoot = "" then
        self.DoError(ADAM_ERR_PROJECT_015, ADAM_MSG_PROJECT_SCAFFOLD_FAILED,
          NoArgs().Str(AName).Str(ADAM_MSG_PROJECT_PATH_UNRESOLVED));
        return false;
      end;
      if DirectoryExists(LRoot) or FileExists(LRoot) then
        self.DoError(ADAM_ERR_PROJECT_014, ADAM_MSG_PROJECT_FOLDER_EXISTS, NoArgs().Str(LRoot));
        return false;
      end;
      if not DoNewPassword(LPassword) then
        self.DoError(ADAM_ERR_PROJECT_016, ADAM_MSG_PROJECT_PASSWORD_FAILED,
          NoArgs().Str(ADAM_MSG_PROJECT_RANDOM_FAILED));
        return false;
      end;
      if not self.DoScaffoldFiles(LRoot, AName, AKind) then
        return false;
      end;
      self.InitNew(LRoot, AName, AKind, LPassword);
      return self.Save();
    end;

    // The project's folder (resolved) and its project.toml's path, after Load
    property Root: string read FRoot;
    property FileName: string read FFileName;
    // The fields as written (Kind: the type's kind, once valid)
    property FileFormat: int64 read FFileFormat;
    property ProjectName: string read FProjectName;
    property Kind: ModuleKind read FKind;
    property MainModule: string read FMainModule;
    property OutputDir: string read FOutputDir;
    property Password: string read FPassword;
  end;

end.
