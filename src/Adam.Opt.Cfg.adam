-------------------------------------------------------------------------------
  Adam.Opt.Cfg.adam - control flow simplification (PLAN-ADAM M6 O7), jump
  threading and tail merging (O16)

  SimplifyControlFlow reshapes one function's blocks, in rounds until a round
  changes nothing; each step makes its own graph of the blocks as they stand
  (DoGraph: terminator edges and a catching scope's unwind edges, as
  Adam.Opt.Analysis has them), so no step reads a fact an earlier one made
  stale:
    fold     a branch on a constant becomes a jump to the arm it takes (the
             other arm's phis lose this block's value); a branch with one
             block for both arms becomes a jump to it
    drop     the blocks the entry does not reach (sccp's bare rets, the
             blocks adce's jumps skip, a folded branch's dead arm) leave the
             function, and the phis of the kept blocks lose their values
    phis     a phi with one value (its block has one predecessor) is that
             value: every use takes it, the phi goes
    merge    a block that jumps to a block only it runs into takes that
             block's code (its phis replaced by their one value), when both
             are in the same scopes and the other is no resume target and
             not the entry; a chain of them merges into its first block
    bypass   a block that is a bare jump (not to itself, not the entry, no
             resume target) is bypassed: each predecessor jumps straight on
             and the target's phis take the value from each of them; skipped
             when the target has phis and one of them runs into it already;
             the bypassed block is unreached, the next round drops it

  Scopes name blocks by POSITION in IrFunction.Blocks (first to last, the
  target where a caught exception resumes): every step that removes blocks
  goes through DoCompact, which renumbers each scope to the kept blocks of
  its run in the same step and drops a scope with none left (its funclet then
  runs for no block). A scope that stays keeps its resume block: its blocks
  reach it by their unwind edge (raised otherwise: a compiler bug). Blocks
  keep their order, so a scope's run stays a run and a kept target stays
  outside it.

  A block merged away and every block dropped are left out of the function's
  list (the module keeps them unused); a moved instruction takes its new
  block. Phis are only ever this function's: a funclet uses its parent's
  slots alone, so no other function's operand changes.

  ThreadJumps (jumpthread, every release level, after the simplifycfg that
  follows the loop passes) moves edges, it copies no code: a block B that
  is only phis, at most one compare and a branch deciding on one of its phis
  (the phi itself, or the phi against a constant), whose values are used in
  B alone or by its targets' phis on the edges from B, is no loop header,
  no resume target and not the entry; a predecessor P whose value of that
  phi is a constant knows the arm B takes (the compare folded exact to the
  machine: IrFoldCompare, sccp's own), so P jumps straight to that arm T:
  T's phis take from P what they took from B (a phi of B: its value from
  P), B's phis lose P's values. Skipped when P already runs into T (two
  edges to one phi), when T is B or a resume target. A block a round
  changed (P, T) waits for the next round, made over a fresh analysis
  (ADAM_CFG_THREAD_ROUNDS at most). A loop header never threads, so no
  edge enters a loop past its header (the graph stays reducible). B, left
  with fewer predecessors (or none), is the last simplifycfg's to drop.

  MergeTails (tailmerge, small only, after adce, before tailcall marks a
  call) cross-jumps equal tails: blocks ending in terminators of one shape
  (kind, operand count, targets; none targeting either block) are compared
  from their ends, instruction by instruction (kind, type, immediates,
  link, predicate, targets; an operand the same value from outside both
  blocks, or the instructions at the same distance inside the tail; no
  phi or entry value in a tail); the tail's successors' phis must take the
  same value from both. A tail of ADAM_CFG_TAIL_LENGTH instructions merges
  into a block that is wholly that tail (no phis, not the entry, no resume
  target), else of ADAM_CFG_TAIL_SPLIT_LENGTH into a new block after the
  kept one (IrModule.InsertBlock: its scopes, every later position moved)
  that takes its tail, the kept block jumping to it; the other block keeps
  what came before its tail and jumps there too, the successors' phis
  dropping its entries. Both blocks are in the same scopes (a tail that may
  raise unwinds to the same place). Each terminator shape keeps up to
  ADAM_CFG_TAIL_CANDIDATES blocks to compare against; rounds until one
  merges nothing.
*******************************************************************************/

module unit Adam.Opt.Cfg;

import System.SysUtils, Adam.Core.Containers, Adam.Backend.Ssa, Adam.Opt.Analysis;

const
  // No block / no instruction (a map's missing value), and a block id's mark in a set
  ADAM_CFG_NONE: int64 = -1;
  ADAM_CFG_GONE: int64 = 1;
  // jumpthread: its rounds at most (each over a fresh analysis)
  ADAM_CFG_THREAD_ROUNDS: int64 = 8;
  // tailmerge: the shortest tail worth a jump into a block that is wholly it, the
  // shortest worth a new block (its own jump more), and the blocks each terminator shape
  // keeps to compare against
  ADAM_CFG_TAIL_LENGTH: int64 = 2;
  ADAM_CFG_TAIL_SPLIT_LENGTH: int64 = 3;
  ADAM_CFG_TAIL_CANDIDATES: int64 = 16;
  // Raised (an invariant broken): a terminator target no block of the function, a kept
  // scope whose resume block went, a merged block's phi without exactly one value, a chain
  // of one-value phis that runs round to itself
  ADAM_CFG_FAULT_NOT_OWN_BLOCK: string = "Opt: simplifycfg found a target no block of the function: b";
  ADAM_CFG_FAULT_RESUME: string = "Opt: simplifycfg dropped the resume block of a kept scope: b";
  ADAM_CFG_FAULT_PHI_COUNT: string = "Opt: simplifycfg merged a block whose phi has not one value: i";
  ADAM_CFG_FAULT_REPLACE_CYCLE: string = "Opt: simplifycfg found one-value phis in a cycle at i";

type
  // One list of block positions per block
  BlockPositionLists = array of ref Int64List;

  // One function's control flow simplification (see the header)
  ControlFlowSimplifier = object
    hidden FModule: ref IrModule;
    hidden FFunctionId: int64;
    hidden FFunction: ref IrFunction;
    // The graph of the blocks as they stand (DoGraph): how many, each block id's
    // position, each position's predecessors (each once, in block order; a catching
    // scope's blocks are predecessors of its target), whether the entry reaches it,
    // whether a scope resumes at it
    hidden FCount: int64;
    hidden FPositionOf: ref Int64Map;
    hidden FPreds: BlockPositionLists;
    hidden FReached: BoolArray;
    hidden FResume: BoolArray;

    // The simplification of AModule's function AFunction
    init(const AModule: ref IrModule; const AFunction: int64);
    begin
      self.FModule := AModule;
      self.FFunctionId := AFunction;
      self.FFunction := AModule.FunctionAt(AFunction);
      self.FCount := 0;
      self.FPositionOf := ref Int64Map(ADAM_CFG_NONE);
    end;

    // The terminator of the block ABlock (an id; ADAM_CFG_NONE: it ends in none)
    hidden const method DoTerminatorOf(const ABlock: int64): int64;
    var
      LInstrs: ref Int64List;
      LLast: int64;
    begin
      LInstrs := self.FModule.BlockAt(ABlock).Instrs;
      if LInstrs.Count = 0 then
        return ADAM_CFG_NONE;
      end;
      LLast := LInstrs[LInstrs.Count - 1];
      if not IsTerminator(self.FModule.InstrAt(LLast).Kind) then
        return ADAM_CFG_NONE;
      end;
      return LLast;
    end;

    // True when the block ABlock (an id) has a phi
    hidden const method DoHasPhi(const ABlock: int64): bool;
    var
      LInstrs: ref Int64List;
      LK: int64;
    begin
      LInstrs := self.FModule.BlockAt(ABlock).Instrs;
      for LK := 0 to LInstrs.Count - 1 do
        if self.FModule.InstrAt(LInstrs[LK]).Kind = IrOp.Phi then
          return true;
        end;
      end;
      return false;
    end;

    // The graph of the blocks as they stand (see the fields)
    hidden method DoGraph();
    var
      LBlocks: ref Int64List;
      LSuccs: BlockPositionLists;
      LWork: ref Int64List;
      LTerminator: ref IrInstr;
      LTerm: int64;
      LTarget: int64;
      LAt: int64;
      LI: int64;
      LK: int64;
    begin
      LBlocks := self.FFunction.Blocks;
      self.FCount := LBlocks.Count;
      self.FPositionOf := ref Int64Map(ADAM_CFG_NONE);
      setlength(self.FPreds, self.FCount);
      setlength(self.FReached, self.FCount);
      setlength(self.FResume, self.FCount);
      setlength(LSuccs, self.FCount);
      for LI := 0 to self.FCount - 1 do
        self.FPositionOf.Put(LBlocks[LI], LI);
        self.FPreds[LI] := ref Int64List();
        self.FReached[LI] := false;
        self.FResume[LI] := false;
        LSuccs[LI] := ref Int64List();
      end;
      for LI := 0 to self.FCount - 1 do
        LTerm := self.DoTerminatorOf(LBlocks[LI]);
        if LTerm <> ADAM_CFG_NONE then
          LTerminator := self.FModule.InstrAt(LTerm);
          for LK := 0 to LTerminator.Targets.Count - 1 do
            LTarget := self.FPositionOf.Find(LTerminator.Targets[LK]);
            if LTarget = ADAM_CFG_NONE then
              raise(ADAM_CFG_FAULT_NOT_OWN_BLOCK + IntToStr(LTerminator.Targets[LK]));
            end;
            if LSuccs[LI].IndexOf(LTarget) < 0 then
              LSuccs[LI].Add(LTarget);
            end;
          end;
        end;
      end;
      // A catching scope's blocks may each raise into its target (scopes name blocks by
      // position already)
      for LK := 0 to self.FFunction.ScopeCount() - 1 do
        LTarget := self.FFunction.ScopeTarget(LK);
        if LTarget >= 0 then
          self.FResume[LTarget] := true;
          for LI := self.FFunction.ScopeFirst(LK) to self.FFunction.ScopeLast(LK) do
            if LSuccs[LI].IndexOf(LTarget) < 0 then
              LSuccs[LI].Add(LTarget);
            end;
          end;
        end;
      end;
      // Walked in block order, so each block's predecessors come in block order
      for LI := 0 to self.FCount - 1 do
        for LK := 0 to LSuccs[LI].Count - 1 do
          self.FPreds[LSuccs[LI][LK]].Add(LI);
        end;
      end;
      // What the entry reaches, its unwind edges followed
      LWork := ref Int64List();
      self.FReached[0] := true;
      LWork.Add(0);
      while LWork.Count > 0 do
        LAt := LWork.RemoveLast();
        for LK := 0 to LSuccs[LAt].Count - 1 do
          LTarget := LSuccs[LAt][LK];
          if not self.FReached[LTarget] then
            self.FReached[LTarget] := true;
            LWork.Add(LTarget);
          end;
        end;
      end;
    end;

    // The phi entries of the block ABlock (an id) that arrive from a block AGone marks
    // removed
    hidden method DoTrimPhis(const ABlock: int64; const AGone: ref Int64Map);
    var
      LInstrs: ref Int64List;
      LPhi: ref IrInstr;
      LOperands: ref Int64List;
      LTargets: ref Int64List;
      LK: int64;
      LE: int64;
    begin
      LInstrs := self.FModule.BlockAt(ABlock).Instrs;
      for LK := 0 to LInstrs.Count - 1 do
        LPhi := self.FModule.InstrAt(LInstrs[LK]);
        if LPhi.Kind = IrOp.Phi then
          LOperands := ref Int64List();
          LTargets := ref Int64List();
          for LE := 0 to LPhi.Targets.Count - 1 do
            if AGone.Find(LPhi.Targets[LE]) <> ADAM_CFG_GONE then
              LOperands.Add(LPhi.Operands[LE]);
              LTargets.Add(LPhi.Targets[LE]);
            end;
          end;
          LPhi.Operands := LOperands;
          LPhi.Targets := LTargets;
        end;
      end;
    end;

    // The phis of the block ABlock (an id) take the value they had from AFrom from ATo
    hidden method DoRenamePhiSource(const ABlock: int64; const AFrom: int64; const ATo: int64);
    var
      LInstrs: ref Int64List;
      LPhi: ref IrInstr;
      LEntry: int64;
      LK: int64;
    begin
      LInstrs := self.FModule.BlockAt(ABlock).Instrs;
      for LK := 0 to LInstrs.Count - 1 do
        LPhi := self.FModule.InstrAt(LInstrs[LK]);
        if LPhi.Kind = IrOp.Phi then
          LEntry := LPhi.Targets.IndexOf(AFrom);
          if LEntry >= 0 then
            LPhi.Targets[LEntry] := ATo;
          end;
        end;
      end;
    end;

    // The terminator AInstr made a jump to the block ATo (an id)
    hidden method DoMakeJump(const AInstr: ref IrInstr; const ATo: int64);
    begin
      AInstr.Kind := IrOp.Jump;
      AInstr.Operands := ref Int64List();
      AInstr.Targets := ref Int64List();
      AInstr.Targets.Add(ATo);
    end;

    // The value AId stands for once AReplace's phis are gone: followed until it names one
    // that stays (raised when the chain runs round: a compiler bug)
    hidden const method DoResolve(const AReplace: ref Int64Map; const AId: int64): int64;
    var
      LAt: int64;
      LNext: int64;
      LSteps: int64;
    begin
      LAt := AId;
      LSteps := 0;
      LNext := AReplace.Find(LAt);
      while LNext <> ADAM_CFG_NONE do
        LSteps := LSteps + 1;
        if LSteps > AReplace.Count then
          raise(ADAM_CFG_FAULT_REPLACE_CYCLE + IntToStr(AId));
        end;
        LAt := LNext;
        LNext := AReplace.Find(LAt);
      end;
      return LAt;
    end;

    // Every operand of the function that names a phi AReplace maps made the value it
    // stands for
    hidden method DoReplaceUses(const AReplace: ref Int64Map);
    var
      LBlocks: ref Int64List;
      LInstrs: ref Int64List;
      LInstr: ref IrInstr;
      LValue: int64;
      LI: int64;
      LK: int64;
      LE: int64;
    begin
      LBlocks := self.FFunction.Blocks;
      for LI := 0 to LBlocks.Count - 1 do
        LInstrs := self.FModule.BlockAt(LBlocks[LI]).Instrs;
        for LK := 0 to LInstrs.Count - 1 do
          LInstr := self.FModule.InstrAt(LInstrs[LK]);
          for LE := 0 to LInstr.Operands.Count - 1 do
            LValue := self.DoResolve(AReplace, LInstr.Operands[LE]);
            if LValue <> LInstr.Operands[LE] then
              LInstr.Operands[LE] := LValue;
            end;
          end;
        end;
      end;
    end;

    // The blocks AKeep does not keep (by position) dropped from the function: the phis of
    // the kept ones lose the values they had from them, and each scope covers the kept
    // blocks of its run, renumbered (one with none left goes; a kept one's resume block
    // must be kept, raised otherwise: a compiler bug)
    hidden method DoCompact(const AKeep: BoolArray);
    var
      LOld: ref Int64List;
      LNew: ref Int64List;
      LGone: ref Int64Map;
      LNewPosition: Int64Array;
      LScopeFirst: Int64Array;
      LScopeLast: Int64Array;
      LScopeHandler: Int64Array;
      LScopeTarget: Int64Array;
      LScopes: int64;
      LFrom: int64;
      LTo: int64;
      LResume: int64;
      LI: int64;
      LK: int64;
    begin
      LOld := self.FFunction.Blocks;
      LNew := ref Int64List();
      LGone := ref Int64Map(ADAM_CFG_NONE);
      setlength(LNewPosition, LOld.Count);
      for LI := 0 to LOld.Count - 1 do
        if AKeep[LI] then
          LNewPosition[LI] := LNew.Count;
          LNew.Add(LOld[LI]);
        else
          LNewPosition[LI] := ADAM_CFG_NONE;
          LGone.Put(LOld[LI], ADAM_CFG_GONE);
        end;
      end;
      for LI := 0 to LNew.Count - 1 do
        self.DoTrimPhis(LNew[LI], LGone);
      end;
      // The scopes read out, then added again over the kept blocks in their order
      LScopes := self.FFunction.ScopeCount();
      setlength(LScopeFirst, LScopes);
      setlength(LScopeLast, LScopes);
      setlength(LScopeHandler, LScopes);
      setlength(LScopeTarget, LScopes);
      for LK := 0 to LScopes - 1 do
        LScopeFirst[LK] := self.FFunction.ScopeFirst(LK);
        LScopeLast[LK] := self.FFunction.ScopeLast(LK);
        LScopeHandler[LK] := self.FFunction.ScopeHandler(LK);
        LScopeTarget[LK] := self.FFunction.ScopeTarget(LK);
      end;
      self.FFunction.ClearScopes();
      for LK := 0 to LScopes - 1 do
        LFrom := ADAM_CFG_NONE;
        LTo := ADAM_CFG_NONE;
        for LI := LScopeFirst[LK] to LScopeLast[LK] do
          if AKeep[LI] then
            if LFrom = ADAM_CFG_NONE then
              LFrom := LNewPosition[LI];
            end;
            LTo := LNewPosition[LI];
          end;
        end;
        if LFrom = ADAM_CFG_NONE then
          // No block of its run is left: the scope goes
          skip;
        end;
        LResume := LScopeTarget[LK];
        if LResume >= 0 then
          if not AKeep[LResume] then
            raise(ADAM_CFG_FAULT_RESUME + IntToStr(LOld[LResume]));
          end;
          LResume := LNewPosition[LResume];
        end;
        self.FFunction.AddScope(LFrom, LTo, LScopeHandler[LK], LResume);
      end;
      self.FFunction.Blocks := LNew;
    end;

    // fold (see the header): true when any branch became a jump
    hidden method DoFoldBranches(): bool;
    var
      LBlocks: ref Int64List;
      LBranch: ref IrInstr;
      LCondition: ref IrInstr;
      LGone: ref Int64Map;
      LChanged: bool;
      LTerm: int64;
      LTaken: int64;
      LOther: int64;
      LI: int64;
    begin
      LChanged := false;
      LBlocks := self.FFunction.Blocks;
      for LI := 0 to LBlocks.Count - 1 do
        LTerm := self.DoTerminatorOf(LBlocks[LI]);
        if LTerm = ADAM_CFG_NONE then
          skip;
        end;
        LBranch := self.FModule.InstrAt(LTerm);
        if LBranch.Kind <> IrOp.Branch then
          skip;
        end;
        LCondition := self.FModule.InstrAt(LBranch.Operands[0]);
        if LCondition.Kind = IrOp.Constant then
          // A bool constant is 0 / 1: true takes the then arm (Targets[0])
          if LCondition.Imm <> 0 then
            LTaken := LBranch.Targets[0];
            LOther := LBranch.Targets[1];
          else
            LTaken := LBranch.Targets[1];
            LOther := LBranch.Targets[0];
          end;
          if LOther <> LTaken then
            LGone := ref Int64Map(ADAM_CFG_NONE);
            LGone.Put(LBlocks[LI], ADAM_CFG_GONE);
            self.DoTrimPhis(LOther, LGone);
          end;
        else
          if LBranch.Targets[0] <> LBranch.Targets[1] then
            skip;
          end;
          LTaken := LBranch.Targets[0];
        end;
        self.DoMakeJump(LBranch, LTaken);
        LChanged := true;
      end;
      return LChanged;
    end;

    // drop (see the header): true when any block went
    hidden method DoDropUnreachable(): bool;
    var
      LKeep: BoolArray;
      LAll: bool;
      LI: int64;
    begin
      self.DoGraph();
      setlength(LKeep, self.FCount);
      LAll := true;
      for LI := 0 to self.FCount - 1 do
        LKeep[LI] := self.FReached[LI];
        if not LKeep[LI] then
          LAll := false;
        end;
      end;
      if LAll then
        return false;
      end;
      self.DoCompact(LKeep);
      return true;
    end;

    // phis (see the header): true when any phi went
    hidden method DoSinglePhis(): bool;
    var
      LBlocks: ref Int64List;
      LBlock: ref IrBlock;
      LInstr: ref IrInstr;
      LKept: ref Int64List;
      LReplace: ref Int64Map;
      LId: int64;
      LI: int64;
      LK: int64;
    begin
      LReplace := ref Int64Map(ADAM_CFG_NONE);
      LBlocks := self.FFunction.Blocks;
      for LI := 0 to LBlocks.Count - 1 do
        LBlock := self.FModule.BlockAt(LBlocks[LI]);
        LKept := ref Int64List();
        for LK := 0 to LBlock.Instrs.Count - 1 do
          LId := LBlock.Instrs[LK];
          LInstr := self.FModule.InstrAt(LId);
          if (LInstr.Kind = IrOp.Phi) and (LInstr.Targets.Count = 1) then
            LReplace.Put(LId, LInstr.Operands[0]);
          else
            LKept.Add(LId);
          end;
        end;
        if LKept.Count <> LBlock.Instrs.Count then
          LBlock.Instrs := LKept;
        end;
      end;
      if LReplace.Count = 0 then
        return false;
      end;
      self.DoReplaceUses(LReplace);
      return true;
    end;

    // True when the blocks at positions AOne and AOther are in the same scopes
    hidden const method DoSameScopes(const AOne: int64; const AOther: int64): bool;
    var
      LInOne: bool;
      LInOther: bool;
      LK: int64;
    begin
      for LK := 0 to self.FFunction.ScopeCount() - 1 do
        LInOne := (AOne >= self.FFunction.ScopeFirst(LK)) and
          (AOne <= self.FFunction.ScopeLast(LK));
        LInOther := (AOther >= self.FFunction.ScopeFirst(LK)) and
          (AOther <= self.FFunction.ScopeLast(LK));
        if LInOne <> LInOther then
          return false;
        end;
      end;
      return true;
    end;

    // True when the block at position AGuest may merge into the one at AHost, which jumps
    // to it (see the header); AInto: the block each position has merged into (itself: none)
    hidden const method DoCanMerge(const AHost: int64; const AGuest: int64;
      const AInto: Int64Array): bool;
    var
      LPred: int64;
    begin
      if (AGuest = AHost) or (AGuest = 0) or self.FResume[AGuest] then
        return false;
      end;
      if self.FPreds[AGuest].Count <> 1 then
        return false;
      end;
      // Its one predecessor, or the block that one has merged into this round
      LPred := self.FPreds[AGuest][0];
      while AInto[LPred] <> LPred do
        LPred := AInto[LPred];
      end;
      if LPred <> AHost then
        return false;
      end;
      return self.DoSameScopes(AHost, AGuest);
    end;

    // The block at position AGuest merged into the one at AHost (see the header): its phis
    // into AReplace, its other instructions after the host's (whose jump goes), its
    // successors' phis taking their values from the host
    hidden method DoMergeInto(const AHost: int64; const AGuest: int64;
      const AReplace: ref Int64Map);
    var
      LHost: ref IrBlock;
      LGuest: ref IrBlock;
      LInstr: ref IrInstr;
      LTerminator: ref IrInstr;
      LKept: ref Int64List;
      LHostId: int64;
      LGuestId: int64;
      LTerm: int64;
      LId: int64;
      LK: int64;
    begin
      LHostId := self.FFunction.Blocks[AHost];
      LGuestId := self.FFunction.Blocks[AGuest];
      LHost := self.FModule.BlockAt(LHostId);
      LGuest := self.FModule.BlockAt(LGuestId);
      LKept := ref Int64List();
      for LK := 0 to LHost.Instrs.Count - 2 do
        LKept.Add(LHost.Instrs[LK]);
      end;
      for LK := 0 to LGuest.Instrs.Count - 1 do
        LId := LGuest.Instrs[LK];
        LInstr := self.FModule.InstrAt(LId);
        if LInstr.Kind = IrOp.Phi then
          if LInstr.Targets.Count <> 1 then
            raise(ADAM_CFG_FAULT_PHI_COUNT + IntToStr(LId));
          end;
          AReplace.Put(LId, LInstr.Operands[0]);
        else
          LInstr.Block := LHostId;
          LKept.Add(LId);
        end;
      end;
      LHost.Instrs := LKept;
      LGuest.Instrs := ref Int64List();
      LTerm := self.DoTerminatorOf(LHostId);
      if LTerm <> ADAM_CFG_NONE then
        LTerminator := self.FModule.InstrAt(LTerm);
        for LK := 0 to LTerminator.Targets.Count - 1 do
          self.DoRenamePhiSource(LTerminator.Targets[LK], LGuestId, LHostId);
        end;
      end;
    end;

    // merge (see the header): true when any block merged
    hidden method DoMergeChains(): bool;
    var
      LBlocks: ref Int64List;
      LKeep: BoolArray;
      LInto: Int64Array;
      LReplace: ref Int64Map;
      LJump: ref IrInstr;
      LMerged: bool;
      LGoing: bool;
      LTerm: int64;
      LNext: int64;
      LA: int64;
    begin
      self.DoGraph();
      LBlocks := self.FFunction.Blocks;
      setlength(LKeep, self.FCount);
      setlength(LInto, self.FCount);
      for LA := 0 to self.FCount - 1 do
        LKeep[LA] := true;
        LInto[LA] := LA;
      end;
      LReplace := ref Int64Map(ADAM_CFG_NONE);
      LMerged := false;
      for LA := 0 to self.FCount - 1 do
        if not LKeep[LA] then
          skip;
        end;
        // The host takes block after block while its jump leads to one it may merge
        LGoing := true;
        while LGoing do
          LGoing := false;
          LTerm := self.DoTerminatorOf(LBlocks[LA]);
          if LTerm = ADAM_CFG_NONE then
            skip;
          end;
          LJump := self.FModule.InstrAt(LTerm);
          if LJump.Kind <> IrOp.Jump then
            skip;
          end;
          LNext := self.FPositionOf.Find(LJump.Targets[0]);
          if not self.DoCanMerge(LA, LNext, LInto) then
            skip;
          end;
          self.DoMergeInto(LA, LNext, LReplace);
          LKeep[LNext] := false;
          LInto[LNext] := LA;
          LMerged := true;
          LGoing := true;
        end;
      end;
      if not LMerged then
        return false;
      end;
      if LReplace.Count > 0 then
        self.DoReplaceUses(LReplace);
      end;
      self.DoCompact(LKeep);
      return true;
    end;

    // True when the bare jump at position AGuest may be bypassed to the block at ATo: ATo
    // has no phi, or none of AGuest's predecessors runs into it already
    hidden const method DoCanBypass(const AGuest: int64; const ATo: int64): bool;
    var
      LPreds: ref Int64List;
      LK: int64;
    begin
      if not self.DoHasPhi(self.FFunction.Blocks[ATo]) then
        return true;
      end;
      LPreds := self.FPreds[AGuest];
      for LK := 0 to LPreds.Count - 1 do
        if self.FPreds[ATo].IndexOf(LPreds[LK]) >= 0 then
          return false;
        end;
      end;
      return true;
    end;

    // The bare jump at position AGuest bypassed to the block at ATo: each predecessor's
    // terminator goes to ATo where it went to AGuest, and each phi of ATo takes the value
    // it had from AGuest from each of them
    hidden method DoBypass(const AGuest: int64; const ATo: int64);
    var
      LPreds: ref Int64List;
      LInstrs: ref Int64List;
      LTerminator: ref IrInstr;
      LPhi: ref IrInstr;
      LOperands: ref Int64List;
      LTargets: ref Int64List;
      LGuestId: int64;
      LToId: int64;
      LValue: int64;
      LEntry: int64;
      LK: int64;
      LE: int64;
    begin
      LGuestId := self.FFunction.Blocks[AGuest];
      LToId := self.FFunction.Blocks[ATo];
      LPreds := self.FPreds[AGuest];
      for LK := 0 to LPreds.Count - 1 do
        LTerminator := self.FModule.InstrAt(self.DoTerminatorOf(self.FFunction.Blocks[LPreds[LK]]));
        for LE := 0 to LTerminator.Targets.Count - 1 do
          if LTerminator.Targets[LE] = LGuestId then
            LTerminator.Targets[LE] := LToId;
          end;
        end;
      end;
      LInstrs := self.FModule.BlockAt(LToId).Instrs;
      for LK := 0 to LInstrs.Count - 1 do
        LPhi := self.FModule.InstrAt(LInstrs[LK]);
        if LPhi.Kind = IrOp.Phi then
          LEntry := LPhi.Targets.IndexOf(LGuestId);
          if LEntry >= 0 then
            LValue := LPhi.Operands[LEntry];
            LOperands := ref Int64List();
            LTargets := ref Int64List();
            for LE := 0 to LPhi.Targets.Count - 1 do
              if LE <> LEntry then
                LOperands.Add(LPhi.Operands[LE]);
                LTargets.Add(LPhi.Targets[LE]);
              end;
            end;
            for LE := 0 to LPreds.Count - 1 do
              LOperands.Add(LValue);
              LTargets.Add(self.FFunction.Blocks[LPreds[LE]]);
            end;
            LPhi.Operands := LOperands;
            LPhi.Targets := LTargets;
          end;
        end;
      end;
    end;

    // bypass (see the header): one change per block a round (a block a bypass touched,
    // its predecessors and its target, waits for the next round's graph); true when any
    // block was bypassed
    hidden method DoForwardEmpty(): bool;
    var
      LBlocks: ref Int64List;
      LTouched: BoolArray;
      LPreds: ref Int64List;
      LGuest: ref IrBlock;
      LJump: ref IrInstr;
      LChanged: bool;
      LTo: int64;
      LI: int64;
      LK: int64;
    begin
      self.DoGraph();
      LBlocks := self.FFunction.Blocks;
      setlength(LTouched, self.FCount);
      for LI := 0 to self.FCount - 1 do
        LTouched[LI] := false;
      end;
      LChanged := false;
      // The entry (position 0) is never bypassed
      for LI := 1 to self.FCount - 1 do
        LGuest := self.FModule.BlockAt(LBlocks[LI]);
        if (LGuest.Instrs.Count <> 1) or LTouched[LI] or self.FResume[LI] then
          skip;
        end;
        LJump := self.FModule.InstrAt(LGuest.Instrs[0]);
        if LJump.Kind <> IrOp.Jump then
          skip;
        end;
        LTo := self.FPositionOf.Find(LJump.Targets[0]);
        if (LTo = LI) or LTouched[LTo] then
          skip;
        end;
        LPreds := self.FPreds[LI];
        if (LPreds.Count = 0) or (not self.DoCanBypass(LI, LTo)) then
          skip;
        end;
        self.DoBypass(LI, LTo);
        LTouched[LI] := true;
        LTouched[LTo] := true;
        for LK := 0 to LPreds.Count - 1 do
          LTouched[LPreds[LK]] := true;
        end;
        LChanged := true;
      end;
      return LChanged;
    end;

    // jumpthread: true when the block at position APosition heads a loop of AAnalysis
    hidden const method DoIsLoopHeader(const AAnalysis: ref FunctionAnalysis;
      const APosition: int64): bool;
    var
      LK: int64;
    begin
      for LK := 0 to AAnalysis.LoopCount() - 1 do
        if AAnalysis.LoopHeader(LK) = APosition then
          return true;
        end;
      end;
      return false;
    end;

    // jumpthread: true when every use AAnalysis knows of the value AValue (an instruction
    // of the block ABlock, an id) is in ABlock, or is a phi of one of the blocks ATargets
    // (ids) taking it on the edge from ABlock
    hidden const method DoUsedOnlyThere(const AAnalysis: ref FunctionAnalysis;
      const AValue: int64; const ABlock: int64; const ATargets: ref Int64List): bool;
    var
      LUses: ref Int64List;
      LUse: ref IrInstr;
      LK: int64;
      LE: int64;
    begin
      LUses := AAnalysis.UsesOf(AValue);
      for LK := 0 to LUses.Count - 1 do
        LUse := self.FModule.InstrAt(LUses[LK]);
        if LUse.Block = ABlock then
          skip;
        end;
        if (LUse.Kind <> IrOp.Phi) or (ATargets.IndexOf(LUse.Block) < 0) then
          return false;
        end;
        for LE := 0 to LUse.Operands.Count - 1 do
          if (LUse.Operands[LE] = AValue) and (LUse.Targets[LE] <> ABlock) then
            return false;
          end;
        end;
      end;
      return true;
    end;

    // jumpthread: true when the value AValue is a phi of the block ABlock (an id)
    hidden const method DoIsPhiOf(const AValue: int64; const ABlock: int64): bool;
    var
      LInstr: ref IrInstr;
    begin
      LInstr := self.FModule.InstrAt(AValue);
      return (LInstr.Kind = IrOp.Phi) and (LInstr.Block = ABlock);
    end;

    // jumpthread: true when the block at position APosition has the shape it threads (see
    // the header): APhi the phi its branch decides on, ACompare the compare of it with a
    // constant the branch reads (ADAM_CFG_NONE: the branch reads the phi itself)
    hidden const method DoThreadShape(const AAnalysis: ref FunctionAnalysis;
      const APosition: int64; var APhi: int64; var ACompare: int64): bool;
    var
      LInstrs: ref Int64List;
      LBranch: ref IrInstr;
      LCondition: ref IrInstr;
      LUses: ref Int64List;
      LBlockId: int64;
      LTerm: int64;
      LOthers: int64;
      LK: int64;
    begin
      APhi := ADAM_CFG_NONE;
      ACompare := ADAM_CFG_NONE;
      LBlockId := self.FFunction.Blocks[APosition];
      LTerm := self.DoTerminatorOf(LBlockId);
      if LTerm = ADAM_CFG_NONE then
        return false;
      end;
      LBranch := self.FModule.InstrAt(LTerm);
      if (LBranch.Kind <> IrOp.Branch) or (LBranch.Targets[0] = LBranch.Targets[1]) then
        return false;
      end;
      // Phis, then at most one other instruction (the compare) before the branch
      LInstrs := self.FModule.BlockAt(LBlockId).Instrs;
      LOthers := 0;
      for LK := 0 to LInstrs.Count - 2 do
        if self.FModule.InstrAt(LInstrs[LK]).Kind <> IrOp.Phi then
          LOthers := LOthers + 1;
        end;
      end;
      LCondition := self.FModule.InstrAt(LBranch.Operands[0]);
      if LCondition.Block <> LBlockId then
        return false;
      end;
      if LCondition.Kind = IrOp.Phi then
        if LOthers <> 0 then
          return false;
        end;
        APhi := LBranch.Operands[0];
      else
        if (LCondition.Kind <> IrOp.Compare) or (LOthers <> 1) then
          return false;
        end;
        // One side a phi of this block, the other a constant
        if self.DoIsPhiOf(LCondition.Operands[0], LBlockId) and
          (self.FModule.InstrAt(LCondition.Operands[1]).Kind = IrOp.Constant) then
          APhi := LCondition.Operands[0];
        else
          if self.DoIsPhiOf(LCondition.Operands[1], LBlockId) and
            (self.FModule.InstrAt(LCondition.Operands[0]).Kind = IrOp.Constant) then
            APhi := LCondition.Operands[1];
          else
            return false;
          end;
        end;
        ACompare := LBranch.Operands[0];
        // The compare read by the branch alone
        LUses := AAnalysis.UsesOf(ACompare);
        for LK := 0 to LUses.Count - 1 do
          if self.FModule.InstrAt(LUses[LK]).Block <> LBlockId then
            return false;
          end;
        end;
      end;
      // Every phi used in the block, or by its targets' phis on the edges from it
      for LK := 0 to LInstrs.Count - 2 do
        if self.FModule.InstrAt(LInstrs[LK]).Kind = IrOp.Phi then
          if not self.DoUsedOnlyThere(AAnalysis, LInstrs[LK], LBlockId, LBranch.Targets) then
            return false;
          end;
        end;
      end;
      return true;
    end;

    // jumpthread: the arm (a block id) ABranch takes when its block is entered from the
    // block APred (an id), APhi and ACompare as DoThreadShape gave them; ADAM_CFG_NONE when
    // the phi's value on that edge is no constant
    hidden const method DoThreadTarget(const ABranch: ref IrInstr; const APhi: int64;
      const ACompare: int64; const APred: int64): int64;
    var
      LPhi: ref IrInstr;
      LValue: ref IrInstr;
      LCompare: ref IrInstr;
      LEntry: int64;
      LTruth: int64;
    begin
      LPhi := self.FModule.InstrAt(APhi);
      LEntry := LPhi.Targets.IndexOf(APred);
      if LEntry < 0 then
        return ADAM_CFG_NONE;
      end;
      LValue := self.FModule.InstrAt(LPhi.Operands[LEntry]);
      if LValue.Kind <> IrOp.Constant then
        return ADAM_CFG_NONE;
      end;
      if ACompare = ADAM_CFG_NONE then
        // A bool constant is 0 / 1
        LTruth := LValue.Imm;
      else
        LCompare := self.FModule.InstrAt(ACompare);
        if LCompare.Operands[0] = APhi then
          LTruth := IrFoldCompare(LCompare.Predicate, LPhi.ValueType, LValue.Imm,
            self.FModule.InstrAt(LCompare.Operands[1]).Imm);
        else
          LTruth := IrFoldCompare(LCompare.Predicate, LPhi.ValueType,
            self.FModule.InstrAt(LCompare.Operands[0]).Imm, LValue.Imm);
        end;
      end;
      if LTruth <> 0 then
        return ABranch.Targets[0];
      end;
      return ABranch.Targets[1];
    end;

    // jumpthread: the edge from the block APred to the block ABlock (ids) moved to ATarget,
    // the arm ABlock's branch takes on it: APred's terminator goes to ATarget, ATarget's
    // phis take from APred what they took from ABlock (a phi of ABlock: its value from
    // APred), ABlock's phis lose APred's values
    hidden method DoThreadEdge(const APred: int64; const ABlock: int64; const ATarget: int64);
    var
      LTerminator: ref IrInstr;
      LInstrs: ref Int64List;
      LPhi: ref IrInstr;
      LSource: ref IrInstr;
      LGone: ref Int64Map;
      LValue: int64;
      LEntry: int64;
      LK: int64;
    begin
      LTerminator := self.FModule.InstrAt(self.DoTerminatorOf(APred));
      for LK := 0 to LTerminator.Targets.Count - 1 do
        if LTerminator.Targets[LK] = ABlock then
          LTerminator.Targets[LK] := ATarget;
        end;
      end;
      // ATarget's phis first: they read ABlock's phis' values from APred
      LInstrs := self.FModule.BlockAt(ATarget).Instrs;
      for LK := 0 to LInstrs.Count - 1 do
        LPhi := self.FModule.InstrAt(LInstrs[LK]);
        if LPhi.Kind <> IrOp.Phi then
          skip;
        end;
        LEntry := LPhi.Targets.IndexOf(ABlock);
        if LEntry < 0 then
          skip;
        end;
        LValue := LPhi.Operands[LEntry];
        LSource := self.FModule.InstrAt(LValue);
        if (LSource.Kind = IrOp.Phi) and (LSource.Block = ABlock) then
          LValue := LSource.Operands[LSource.Targets.IndexOf(APred)];
        end;
        LPhi.Operands.Add(LValue);
        LPhi.Targets.Add(APred);
      end;
      LGone := ref Int64Map(ADAM_CFG_NONE);
      LGone.Put(APred, ADAM_CFG_GONE);
      self.DoTrimPhis(ABlock, LGone);
    end;

    // jumpthread: one round over the graph as it stands and AAnalysis made over it (see
    // the header); true when an edge moved
    hidden method DoThreadRound(const AAnalysis: ref FunctionAnalysis): bool;
    var
      LBlocks: ref Int64List;
      LTouched: BoolArray;
      LPreds: ref Int64List;
      LBranch: ref IrInstr;
      LPredTerm: ref IrInstr;
      LChanged: bool;
      LBlockId: int64;
      LPredId: int64;
      LPhi: int64;
      LCompare: int64;
      LPredEnd: int64;
      LTo: int64;
      LToAt: int64;
      LPred: int64;
      LB: int64;
      LK: int64;
    begin
      self.DoGraph();
      LBlocks := self.FFunction.Blocks;
      setlength(LTouched, self.FCount);
      for LB := 0 to self.FCount - 1 do
        LTouched[LB] := false;
      end;
      LChanged := false;
      // The entry (position 0) is never threaded through
      for LB := 1 to self.FCount - 1 do
        if (not self.FReached[LB]) or self.FResume[LB] or LTouched[LB] then
          skip;
        end;
        if self.DoIsLoopHeader(AAnalysis, LB) then
          skip;
        end;
        if not self.DoThreadShape(AAnalysis, LB, LPhi, LCompare) then
          skip;
        end;
        LBlockId := LBlocks[LB];
        LBranch := self.FModule.InstrAt(self.DoTerminatorOf(LBlockId));
        LPreds := self.FPreds[LB];
        for LK := 0 to LPreds.Count - 1 do
          LPred := LPreds[LK];
          if (LPred = LB) or (not self.FReached[LPred]) or LTouched[LPred] then
            skip;
          end;
          LPredId := LBlocks[LPred];
          LPredEnd := self.DoTerminatorOf(LPredId);
          if LPredEnd = ADAM_CFG_NONE then
            skip;
          end;
          LPredTerm := self.FModule.InstrAt(LPredEnd);
          if LPredTerm.Targets.IndexOf(LBlockId) < 0 then
            skip;
          end;
          LTo := self.DoThreadTarget(LBranch, LPhi, LCompare, LPredId);
          if (LTo = ADAM_CFG_NONE) or (LTo = LBlockId) then
            skip;
          end;
          LToAt := self.FPositionOf.Find(LTo);
          // Two edges from one block into a phi's block cannot carry two values
          if self.FResume[LToAt] or (LPredTerm.Targets.IndexOf(LTo) >= 0) then
            skip;
          end;
          self.DoThreadEdge(LPredId, LBlockId, LTo);
          LTouched[LPred] := true;
          LTouched[LToAt] := true;
          LTouched[LB] := true;
          LChanged := true;
        end;
      end;
      return LChanged;
    end;

    // jumpthread (see the header): rounds until one moves no edge, the first over
    // AAnalysis, each later one over a fresh analysis; true when it changed the function
    method RunThreading(const AAnalysis: ref FunctionAnalysis): bool;
    var
      LAnalysis: ref FunctionAnalysis;
      LChanged: bool;
      LRound: int64;
    begin
      LChanged := false;
      LAnalysis := AAnalysis;
      for LRound := 1 to ADAM_CFG_THREAD_ROUNDS do
        if LRound > 1 then
          LAnalysis := ref FunctionAnalysis(self.FModule, self.FFunctionId,
            ADAM_OPT_FACTS_LOOPS | ADAM_OPT_FACTS_USES);
        end;
        if not self.DoThreadRound(LAnalysis) then
          leave;
        end;
        LChanged := true;
      end;
      return LChanged;
    end;

    // tailmerge: true for the kinds a tail never holds (a block's head: its phis; the
    // entry's own values; a mark: its line keeps its own address)
    hidden const method DoTailBarrier(const AKind: IrOp): bool;
    begin
      return (AKind = IrOp.Phi) or (AKind = IrOp.Slot) or (AKind = IrOp.Parameter) or
        (AKind = IrOp.ChainParameter) or (AKind = IrOp.VarargsStart) or (AKind = IrOp.Mark);
    end;

    // tailmerge: true when the instructions AOne and AOther do the same, their operands
    // aside (the caller pairs those): kind, type, immediates, link, predicate, tail mark,
    // operand count, targets
    hidden const method DoSameShape(const AOne: ref IrInstr; const AOther: ref IrInstr): bool;
    var
      LK: int64;
    begin
      if (AOne.Kind <> AOther.Kind) or (AOne.ValueType <> AOther.ValueType) or
        (AOne.Imm <> AOther.Imm) or (AOne.Align <> AOther.Align) or
        (AOne.Link <> AOther.Link) or (AOne.Predicate <> AOther.Predicate) or
        (AOne.Tail <> AOther.Tail) then
        return false;
      end;
      if (AOne.Operands.Count <> AOther.Operands.Count) or
        (AOne.Targets.Count <> AOther.Targets.Count) then
        return false;
      end;
      for LK := 0 to AOne.Targets.Count - 1 do
        if AOne.Targets[LK] <> AOther.Targets[LK] then
          return false;
        end;
      end;
      return true;
    end;

    // tailmerge: each instruction of the block ABlock (an id) mapped to its distance from
    // the block's end (its terminator 0)
    hidden const method DoDistances(const ABlock: int64): ref Int64Map;
    var
      LInstrs: ref Int64List;
      LMap: ref Int64Map;
      LK: int64;
    begin
      LInstrs := self.FModule.BlockAt(ABlock).Instrs;
      LMap := ref Int64Map(ADAM_CFG_NONE);
      for LK := 0 to LInstrs.Count - 1 do
        LMap.Put(LInstrs[LK], LInstrs.Count - 1 - LK);
      end;
      return LMap;
    end;

    // tailmerge: true when the operands AOne (of the block AOneAt measures) and AOther (of
    // the block AOtherAt measures) are one value in a tail of ALength: the same value from
    // outside both blocks, or the instructions at the same distance inside the tail
    hidden const method DoSameOperand(const AOne: int64; const AOther: int64;
      const AOneAt: ref Int64Map; const AOtherAt: ref Int64Map; const ALength: int64): bool;
    var
      LOne: int64;
      LOther: int64;
    begin
      LOne := AOneAt.Find(AOne);
      LOther := AOtherAt.Find(AOther);
      if (LOne = ADAM_CFG_NONE) and (LOther = ADAM_CFG_NONE) then
        return AOne = AOther;
      end;
      return (LOne = LOther) and (LOne < ALength);
    end;

    // tailmerge: the first distance (from the end) below ALength whose instructions of the
    // blocks AOne and AOther (ids) have an operand pair that is not one value in a tail of
    // ALength; ALength when every pair is
    hidden const method DoFirstBroken(const AOne: int64; const AOther: int64;
      const AOneAt: ref Int64Map; const AOtherAt: ref Int64Map; const ALength: int64): int64;
    var
      LOneInstrs: ref Int64List;
      LOtherInstrs: ref Int64List;
      LOne: ref IrInstr;
      LOther: ref IrInstr;
      LI: int64;
      LK: int64;
    begin
      LOneInstrs := self.FModule.BlockAt(AOne).Instrs;
      LOtherInstrs := self.FModule.BlockAt(AOther).Instrs;
      for LI := 0 to ALength - 1 do
        LOne := self.FModule.InstrAt(LOneInstrs[LOneInstrs.Count - 1 - LI]);
        LOther := self.FModule.InstrAt(LOtherInstrs[LOtherInstrs.Count - 1 - LI]);
        for LK := 0 to LOne.Operands.Count - 1 do
          if not self.DoSameOperand(LOne.Operands[LK], LOther.Operands[LK], AOneAt, AOtherAt,
            ALength) then
            return LI;
          end;
        end;
      end;
      return ALength;
    end;

    // tailmerge: the length of the tail the blocks AOne and AOther (ids, terminators of one
    // shape) share (see the header); 0 when their successors' phis take different values
    // from them
    hidden const method DoCommonTail(const AOne: int64; const AOther: int64): int64;
    var
      LOneInstrs: ref Int64List;
      LOtherInstrs: ref Int64List;
      LOneAt: ref Int64Map;
      LOtherAt: ref Int64Map;
      LOne: ref IrInstr;
      LOther: ref IrInstr;
      LEnd: ref IrInstr;
      LTargetInstrs: ref Int64List;
      LPhi: ref IrInstr;
      LLength: int64;
      LMost: int64;
      LBroken: int64;
      LGoing: bool;
      LK: int64;
      LE: int64;
    begin
      LOneInstrs := self.FModule.BlockAt(AOne).Instrs;
      LOtherInstrs := self.FModule.BlockAt(AOther).Instrs;
      LOneAt := self.DoDistances(AOne);
      LOtherAt := self.DoDistances(AOther);
      LMost := LOneInstrs.Count;
      if LOtherInstrs.Count < LMost then
        LMost := LOtherInstrs.Count;
      end;
      // The longest run of same-shaped instructions from the ends, operands paired as
      // they would be in a tail of the most both blocks could share
      LLength := 0;
      LGoing := true;
      while LGoing and (LLength < LMost) do
        LOne := self.FModule.InstrAt(LOneInstrs[LOneInstrs.Count - 1 - LLength]);
        LOther := self.FModule.InstrAt(LOtherInstrs[LOtherInstrs.Count - 1 - LLength]);
        if self.DoTailBarrier(LOne.Kind) or self.DoTailBarrier(LOther.Kind) or
          (not self.DoSameShape(LOne, LOther)) then
          LGoing := false;
        else
          for LK := 0 to LOne.Operands.Count - 1 do
            if not self.DoSameOperand(LOne.Operands[LK], LOther.Operands[LK], LOneAt,
              LOtherAt, LMost) then
              LGoing := false;
            end;
          end;
          if LGoing then
            LLength := LLength + 1;
          end;
        end;
      end;
      // Shortened until no operand inside it reaches an instruction outside it
      LBroken := self.DoFirstBroken(AOne, AOther, LOneAt, LOtherAt, LLength);
      while LBroken < LLength do
        LLength := LBroken;
        LBroken := self.DoFirstBroken(AOne, AOther, LOneAt, LOtherAt, LLength);
      end;
      if LLength = 0 then
        return 0;
      end;
      // The successors' phis take one value from both
      LEnd := self.FModule.InstrAt(LOneInstrs[LOneInstrs.Count - 1]);
      for LK := 0 to LEnd.Targets.Count - 1 do
        LTargetInstrs := self.FModule.BlockAt(LEnd.Targets[LK]).Instrs;
        for LE := 0 to LTargetInstrs.Count - 1 do
          LPhi := self.FModule.InstrAt(LTargetInstrs[LE]);
          if LPhi.Kind <> IrOp.Phi then
            skip;
          end;
          if not self.DoSameOperand(LPhi.Operands[LPhi.Targets.IndexOf(AOne)],
            LPhi.Operands[LPhi.Targets.IndexOf(AOther)], LOneAt, LOtherAt, LLength) then
            return 0;
          end;
        end;
      end;
      return LLength;
    end;

    // tailmerge: the shape key of the terminator ATerminator (kind, operand count, targets)
    hidden const method DoTailKey(const ATerminator: ref IrInstr): string;
    var
      LKey: string;
      LK: int64;
    begin
      LKey := IrOpText(ATerminator.Kind) + " " + IntToStr(ATerminator.Operands.Count);
      for LK := 0 to ATerminator.Targets.Count - 1 do
        LKey := LKey + " b" + IntToStr(ATerminator.Targets[LK]);
      end;
      return LKey;
    end;

    // tailmerge: each block id of the function mapped to its position as it stands
    hidden const method DoPositionMap(): ref Int64Map;
    var
      LMap: ref Int64Map;
      LI: int64;
    begin
      LMap := ref Int64Map(ADAM_CFG_NONE);
      for LI := 0 to self.FFunction.Blocks.Count - 1 do
        LMap.Put(self.FFunction.Blocks[LI], LI);
      end;
      return LMap;
    end;

    // tailmerge: the last ALength instructions of the block ADup traded for a jump to the
    // block holding AKeep's same tail (ids): AKeep itself, or when ASplit a new block after
    // it (at AKeepAt) taking its tail, AKeep jumping to it and the tail's successors' phis
    // taking from it what they took from AKeep; the successors' phis lose ADup's entries;
    // returns the tail's block
    hidden method DoMergeTail(const ADup: int64; const AKeep: int64; const ALength: int64;
      const AKeepAt: int64; const ASplit: bool): int64;
    var
      LKeep: ref IrBlock;
      LDup: ref IrBlock;
      LTail: ref IrBlock;
      LEnd: ref IrInstr;
      LKept: ref Int64List;
      LGone: ref Int64Map;
      LTailId: int64;
      LCut: int64;
      LNode: int64;
      LJump: int64;
      LId: int64;
      LK: int64;
    begin
      LKeep := self.FModule.BlockAt(AKeep);
      LDup := self.FModule.BlockAt(ADup);
      LEnd := self.FModule.InstrAt(LKeep.Instrs[LKeep.Instrs.Count - 1]);
      LTailId := AKeep;
      if ASplit then
        LTailId := self.FModule.InsertBlock(self.FFunctionId, AKeepAt, false);
        LTail := self.FModule.BlockAt(LTailId);
        LCut := LKeep.Instrs.Count - ALength;
        LKept := ref Int64List();
        for LK := 0 to LCut - 1 do
          LKept.Add(LKeep.Instrs[LK]);
        end;
        for LK := LCut to LKeep.Instrs.Count - 1 do
          LId := LKeep.Instrs[LK];
          self.FModule.InstrAt(LId).Block := LTailId;
          LTail.Instrs.Add(LId);
        end;
        LKeep.Instrs := LKept;
        LNode := self.FModule.InstrAt(LTail.Instrs[0]).Node;
        LJump := self.FModule.Emit(AKeep, IrOp.Jump, IrType.Void, LNode);
        self.FModule.InstrAt(LJump).Targets.Add(LTailId);
        for LK := 0 to LEnd.Targets.Count - 1 do
          self.DoRenamePhiSource(LEnd.Targets[LK], AKeep, LTailId);
        end;
      end;
      // The other block keeps what came before its tail, then jumps to the tail's block
      LCut := LDup.Instrs.Count - ALength;
      LNode := self.FModule.InstrAt(LDup.Instrs[LCut]).Node;
      LKept := ref Int64List();
      for LK := 0 to LCut - 1 do
        LKept.Add(LDup.Instrs[LK]);
      end;
      LDup.Instrs := LKept;
      LJump := self.FModule.Emit(ADup, IrOp.Jump, IrType.Void, LNode);
      self.FModule.InstrAt(LJump).Targets.Add(LTailId);
      LGone := ref Int64Map(ADAM_CFG_NONE);
      LGone.Put(ADup, ADAM_CFG_GONE);
      for LK := 0 to LEnd.Targets.Count - 1 do
        self.DoTrimPhis(LEnd.Targets[LK], LGone);
      end;
      return LTailId;
    end;

    // tailmerge: one round over the blocks as they stand (see the header); true when a
    // tail merged
    hidden method DoTailRound(): bool;
    var
      LBlocks: ref Int64List;
      LBucketOf: ref StringIdMap;
      LBuckets: BlockPositionLists;
      LCandidates: ref Int64List;
      LPosition: ref Int64Map;
      LResumes: ref Int64Map;
      LTerminator: ref IrInstr;
      LChanged: bool;
      LMerged: bool;
      LSplit: bool;
      LKey: string;
      LEntry: int64;
      LBucket: int64;
      LBucketCount: int64;
      LId: int64;
      LKeep: int64;
      LTerm: int64;
      LLength: int64;
      LNeed: int64;
      LTail: int64;
      LI: int64;
      LK: int64;
    begin
      self.DoGraph();
      // The list as the round began: a new block replaces the function's list, this one
      // stays the round's order
      LBlocks := self.FFunction.Blocks;
      LEntry := LBlocks[0];
      LResumes := ref Int64Map(ADAM_CFG_NONE);
      for LI := 0 to self.FCount - 1 do
        if self.FResume[LI] then
          LResumes.Put(LBlocks[LI], ADAM_CFG_GONE);
        end;
      end;
      LPosition := self.DoPositionMap();
      LBucketOf := ref StringIdMap(0);
      setlength(LBuckets, self.FCount);
      LBucketCount := 0;
      LChanged := false;
      for LI := 0 to self.FCount - 1 do
        LId := LBlocks[LI];
        if not self.FReached[LI] then
          skip;
        end;
        LTerm := self.DoTerminatorOf(LId);
        if LTerm = ADAM_CFG_NONE then
          skip;
        end;
        LTerminator := self.FModule.InstrAt(LTerm);
        if LTerminator.Targets.IndexOf(LId) >= 0 then
          skip;
        end;
        LKey := self.DoTailKey(LTerminator);
        LBucket := LBucketOf.Find(LKey);
        if LBucket = 0 then
          LBuckets[LBucketCount] := ref Int64List();
          LBucketCount := LBucketCount + 1;
          LBucket := LBucketCount;
          LBucketOf.Put(LKey, LBucket);
        end;
        LCandidates := LBuckets[LBucket - 1];
        LMerged := false;
        for LK := 0 to LCandidates.Count - 1 do
          LKeep := LCandidates[LK];
          if LTerminator.Targets.IndexOf(LKeep) >= 0 then
            skip;
          end;
          if not self.DoSameScopes(LPosition.Find(LId), LPosition.Find(LKeep)) then
            skip;
          end;
          LLength := self.DoCommonTail(LId, LKeep);
          // A block wholly the tail takes the jump itself, unless a jump may not enter it
          LSplit := (LLength < self.FModule.BlockAt(LKeep).Instrs.Count) or (LKeep = LEntry) or
            (LResumes.Find(LKeep) = ADAM_CFG_GONE);
          LNeed := ADAM_CFG_TAIL_LENGTH;
          if LSplit then
            LNeed := ADAM_CFG_TAIL_SPLIT_LENGTH;
          end;
          if LLength < LNeed then
            skip;
          end;
          LTail := self.DoMergeTail(LId, LKeep, LLength, LPosition.Find(LKeep), LSplit);
          if LSplit then
            // The new block moved every later position, and it holds the tail now
            LPosition := self.DoPositionMap();
            LCandidates[LK] := LTail;
          end;
          LMerged := true;
          LChanged := true;
          leave;
        end;
        if (not LMerged) and (LCandidates.Count < ADAM_CFG_TAIL_CANDIDATES) then
          LCandidates.Add(LId);
        end;
      end;
      return LChanged;
    end;

    // tailmerge (see the header): rounds until one merges nothing; true when it changed
    // the function
    method RunTailMerge(): bool;
    var
      LChanged: bool;
    begin
      LChanged := false;
      while self.DoTailRound() do
        LChanged := true;
      end;
      return LChanged;
    end;

    // The simplification (see the header): rounds until one changes nothing; true when
    // it changed the function
    method Run(): bool;
    var
      LChanged: bool;
      LRound: bool;
    begin
      LChanged := false;
      LRound := true;
      while LRound do
        LRound := false;
        if self.DoFoldBranches() then
          LRound := true;
        end;
        if self.DoDropUnreachable() then
          LRound := true;
        end;
        if self.DoSinglePhis() then
          LRound := true;
        end;
        if self.DoMergeChains() then
          LRound := true;
        end;
        if self.DoForwardEmpty() then
          LRound := true;
        end;
        if LRound then
          LChanged := true;
        end;
      end;
      return LChanged;
    end;
  end;

// The pass simplifycfg (see the header) over AModule's function AFunction; AAnalysis is
// not read (every step makes its own graph of the blocks as they stand)
public func SimplifyControlFlow(const AModule: ref IrModule; const AFunction: int64;
  const AAnalysis: ref FunctionAnalysis): bool;
var
  LSimplifier: ref ControlFlowSimplifier;
begin
  LSimplifier := ref ControlFlowSimplifier(AModule, AFunction);
  return LSimplifier.Run();
end;

// The pass jumpthread (see the header) over AModule's function AFunction; AAnalysis is
// its first round's facts (each later round makes its own)
public func ThreadJumps(const AModule: ref IrModule; const AFunction: int64;
  const AAnalysis: ref FunctionAnalysis): bool;
var
  LSimplifier: ref ControlFlowSimplifier;
begin
  LSimplifier := ref ControlFlowSimplifier(AModule, AFunction);
  return LSimplifier.RunThreading(AAnalysis);
end;

// The pass tailmerge (see the header) over AModule's function AFunction; AAnalysis is not
// read (each round makes its own graph of the blocks as they stand)
public func MergeTails(const AModule: ref IrModule; const AFunction: int64;
  const AAnalysis: ref FunctionAnalysis): bool;
var
  LSimplifier: ref ControlFlowSimplifier;
begin
  LSimplifier := ref ControlFlowSimplifier(AModule, AFunction);
  return LSimplifier.RunTailMerge();
end;

end.
