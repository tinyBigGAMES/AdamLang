  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  Adam.SysV.Abi.adam - the System V x86_64 convention (DESIGN sec 6)

  SysVAbi       the AbiPart (Adam.Backend.Parts) of x86_64-linux-gnu, the
                one convention of every routine there (clink and cpplink
                alike; the x86_64 psABI sec 3.2, research\PLAN-LINUX64
                kb_sysv_abi.md):
                - Integer and pointer arguments in rdi, rsi, rdx, rcx, r8,
                  r9, floats in xmm0..xmm7, each kind counted on its own
                  (the third float is xmm2 whatever came before it); the
                  rest on the stack from the stack pointer at the call up,
                  one 8-byte place each, in order. No home (shadow) area.
                - The result in rax (a float in xmm0); none for void.
                - An aggregate by value (LX1a2, its IrAggregate) is
                  classified by eightbytes (psABI 3.2.3): one bigger than 16
                  bytes or with an unaligned field is MEMORY; else each
                  eightbyte is INTEGER when any integer touches it, else
                  SSE when a float does (one only of padding takes no
                  register). An argument whose eightbytes all fit in the
                  registers left takes one each in order (an INTEGER one
                  the next of rdi .. r9 at its bytes, an SSE one the next
                  of xmm0 .. xmm7); else, and for MEMORY, its bytes are
                  copied to the stack (its place aligned to its alignment,
                  8 at least) and no register is used. A result classified
                  so comes back in rax, rdx (INTEGER) and xmm0, xmm1 (SSE),
                  its place (parameter 0) not passed; a MEMORY one through
                  its place, its address in rdi and handed back in rax.
                - The stack pointer is 16-byte aligned at every call; the
                  call pushes the 8-byte return address, so at a callee's
                  first instruction an argument's offset is 8 more.
                - Callee-saved: rbx, rbp, r12..r15; every other general
                  register and every xmm register is volatile (Windows
                  keeps xmm6..15: no vector register is ever saved here).
                - The frame rule is Win64Abi's (pushes, one reservation
                  padded to a 16-byte stack pointer, no frame for a leaf
                  with nothing to keep, rbp for a realigned frame); the 128
                  bytes under the stack pointer (the red zone) stay unused.
                - A thread's stack has a guard page under it (glibc's
                  threads: one page): a frame reaching more than a page
                  below its saves is probed page by page as on Windows, so
                  it never steps over the guard (the stack-clash rule gcc's
                  -fstack-clash-protection keeps). The probe changes only
                  rax, r10, r11 (free at a function's start: no argument,
                  no result; a variadic callee's al is read by nothing here,
                  its register save area keeps every vector register).
                - A variadic call sets al to the vector registers its
                  arguments take (an upper bound is enough: the callee's
                  save area keeps all eight here). A variadic function
                  stores rdi .. r9 and xmm0 .. xmm7 at entry into a 176-byte
                  register save area in its frame (psABI Figure 3.32), and
                  keeps the va_list state after it: gp_offset / fp_offset
                  past its named arguments' registers, overflow_arg_area at
                  its first stacked variadic argument, reg_save_area the
                  area (Adam.Target.Linux64's VarargsSave reads it).
                The unwind data: Adam.SysV.Unwind.
*******************************************************************************/

module unit Adam.SysV.Abi;

import System.SysUtils, Adam.Core.Common, Adam.Backend.Ssa, Adam.Backend.Sections, Adam.Backend.Parts,
  Adam.Backend.Unwind, Adam.SysV.Unwind;

public const
  // The ABI's name
  ADAM_SYSV_ABI_NAME: string = "sysv";
  // The C runtime (CRuntimeFacts): no static archive yet (compiler-rt for linux joins when
  // Adam's code first calls one of its helpers, KB finding 4), glibc's libc.so.6 by its
  // library spelling, and C's atexit, stat, fstat and lstat with their 64 forms
  // (libc_nonshared.a's below glibc 2.33, which an Adam image does not carry; a large-file
  // build such as libxml2's calls stat64, x86_64's struct stat64 being struct stat) bound to
  // the platform unit's PlatformCAtExit / PlatformCStat / PlatformCFstat / PlatformCLstat
  ADAM_SYSV_C_LIBRARIES: string = "c";
  ADAM_SYSV_C_STAND_IN_NAMES: string = "atexit stat fstat lstat stat64 fstat64 lstat64";
  ADAM_SYSV_C_STAND_INS: string = "PlatformCAtExit PlatformCStat PlatformCFstat PlatformCLstat " +
    "PlatformCStat PlatformCFstat PlatformCLstat";
  // glibc's version table (bin\res\libs\system\x86_64-linux-gnu, made for the glibc floor:
  // research PLAN-LINUX64 kb_glibc_floor.md) and the start routine an exe's _start calls
  ADAM_SYSV_C_SHARED_TABLE: string = "glibc" + ADAM_EXT_SHARED_TABLE;
  ADAM_SYSV_C_START_ROUTINE: string = "__libc_start_main";
  // glibc's stream names (CRuntimeFacts.StreamNames): every routine of the floor's version
  // table taking a FILE * (stdio.h, wchar.h, stdio_ext.h and the _chk forms of bits\stdio2.h /
  // wchar2.h at the floor, and libio's own exported _IO_* / __*flow names that objects built
  // against glibc's older headers reach: libio.h / libioP.h, glibc 2.39's iolibio.h twins of
  // the public names), and the name that says a link hooks them: System.HookIO.Linux64's own
  // HookIOStreamOf (a C library may define fopen; only System.HookIO defines this)
  ADAM_SYSV_C_STREAM_NAMES: string =
    "_IO_default_doallocate _IO_default_finish _IO_default_pbackfail _IO_default_uflow " +
    "_IO_default_xsgetn _IO_default_xsputn _IO_do_write _IO_doallocbuf _IO_fclose _IO_feof " +
    "_IO_ferror _IO_fflush _IO_fgetpos _IO_fgetpos64 _IO_fgets _IO_file_attach " +
    "_IO_file_close _IO_file_close_it _IO_file_doallocate _IO_file_finish _IO_file_fopen " +
    "_IO_file_init _IO_file_open _IO_file_overflow _IO_file_read _IO_file_seek " +
    "_IO_file_seekoff _IO_file_setbuf _IO_file_stat _IO_file_sync _IO_file_underflow " +
    "_IO_file_write _IO_file_xsputn _IO_flockfile _IO_fprintf _IO_fputs _IO_fread " +
    "_IO_free_backup_area _IO_free_wbackup_area _IO_fsetpos _IO_fsetpos64 _IO_ftell " +
    "_IO_ftrylockfile _IO_funlockfile _IO_fwrite _IO_getc _IO_getline _IO_getline_info " +
    "_IO_init _IO_init_marker _IO_init_wmarker _IO_least_wmarker _IO_link_in _IO_padn " +
    "_IO_peekc_locked _IO_proc_close _IO_proc_open _IO_putc _IO_seekmark _IO_seekoff " +
    "_IO_seekpos _IO_seekwmark _IO_setb _IO_setbuffer _IO_setvbuf _IO_sgetn _IO_sputbackc " +
    "_IO_sputbackwc _IO_str_overflow _IO_str_pbackfail _IO_str_seekoff _IO_str_underflow " +
    "_IO_sungetc _IO_sungetwc _IO_switch_to_get_mode _IO_switch_to_main_wget_area " +
    "_IO_switch_to_wbackup_area _IO_switch_to_wget_mode _IO_un_link _IO_ungetc " +
    "_IO_unsave_markers _IO_unsave_wmarkers _IO_vfprintf _IO_vfscanf " +
    "_IO_wdefault_doallocate _IO_wdefault_finish _IO_wdefault_pbackfail _IO_wdefault_uflow " +
    "_IO_wdefault_xsgetn _IO_wdefault_xsputn _IO_wdo_write _IO_wdoallocbuf " +
    "_IO_wfile_overflow _IO_wfile_seekoff _IO_wfile_sync _IO_wfile_underflow " +
    "_IO_wfile_xsputn _IO_wsetb __fbufsize __fgets_chk __fgets_unlocked_chk __fgetws_chk " +
    "__fgetws_unlocked_chk __flbf __fpending __fprintf_chk __fpurge __fread_chk " +
    "__fread_unlocked_chk __freadable __freading __fsetlocking __fwprintf_chk __fwritable " +
    "__fwriting __getdelim __isoc99_fscanf __isoc99_fwscanf __isoc99_vfscanf " +
    "__isoc99_vfwscanf __overflow __uflow __underflow __vfprintf_chk __vfwprintf_chk " +
    "__woverflow __wuflow __wunderflow clearerr clearerr_unlocked fclose feof feof_unlocked " +
    "ferror ferror_unlocked fflush fflush_unlocked fgetc fgetc_unlocked fgetpos fgetpos64 " +
    "fgets fgets_unlocked fgetwc fgetwc_unlocked fgetws fgetws_unlocked fileno " +
    "fileno_unlocked flockfile fprintf fputc fputc_unlocked fputs fputs_unlocked fputwc " +
    "fputwc_unlocked fputws fputws_unlocked fread fread_unlocked freopen freopen64 fscanf " +
    "fseek fseeko fseeko64 fsetpos fsetpos64 ftell ftello ftello64 ftrylockfile funlockfile " +
    "fwide fwprintf fwrite fwrite_unlocked fwscanf getc getc_unlocked getdelim getline getw " +
    "getwc getwc_unlocked pclose putc putc_unlocked putw putwc putwc_unlocked rewind setbuf " +
    "setbuffer setlinebuf setvbuf ungetc ungetwc vfprintf vfscanf vfwprintf vfwscanf";
  ADAM_SYSV_C_STREAM_HOOK: string = "HookIOStreamOf";
  // Thread-local storage (ThreadLocalFacts, ThreadPointer): a variable at a fixed offset
  // (TpOff32) from the thread pointer, the word at fs:0 (the TCB's self pointer: SysV
  // psABI TLS variant II), the exe's local-exec model
  ADAM_SYSV_TLS_REGISTER: string = "fs";
  ADAM_SYSV_TLS_BLOCK_OFFSET: int64 = 0;
  ADAM_SYSV_TLS_INDEX_SYMBOL: string = "";
  // The stack pointer's alignment at a call, and one argument place
  ADAM_SYSV_STACK_ALIGN: int64 = 16;
  ADAM_SYSV_SLOT_BYTES: int64 = 8;
  // The return address the call pushes
  ADAM_SYSV_RETURN_BYTES: int64 = 8;
  // The registers, as the x86_64 arch part names them
  ADAM_SYSV_INT_ARGS: string = "rdi rsi rdx rcx r8 r9";
  ADAM_SYSV_FLOAT_ARGS: string = "xmm0 xmm1 xmm2 xmm3 xmm4 xmm5 xmm6 xmm7";
  ADAM_SYSV_INT_RESULT: string = "rax";
  ADAM_SYSV_FLOAT_RESULT: string = "xmm0";
  // An aggregate's result registers, by its eightbytes' classes in order
  ADAM_SYSV_INT_RESULTS: string = "rax rdx";
  ADAM_SYSV_FLOAT_RESULTS: string = "xmm0 xmm1";
  // An eightbyte (psABI 3.2.3) and the most of them a value passed in registers has
  ADAM_SYSV_EIGHTBYTE: int64 = 8;
  ADAM_SYSV_REGISTER_EIGHTBYTES: int64 = 2;
  ADAM_SYSV_CALLEE_SAVED: string = "rbx rbp r12 r13 r14 r15";
  ADAM_SYSV_VOLATILE: string = "rax rcx rdx rsi rdi r8 r9 r10 r11 xmm0 xmm1 xmm2 xmm3 xmm4 " +
    "xmm5 xmm6 xmm7 xmm8 xmm9 xmm10 xmm11 xmm12 xmm13 xmm14 xmm15";
  // The register a realigned frame keeps its frame in (callee-saved, above)
  ADAM_SYSV_FRAME_REGISTER: string = "rbp";
  // The stack page (a thread's guard page is one), and the registers free at a function's
  // first instruction (volatile, no argument, no result)
  ADAM_SYSV_PAGE_BYTES: int64 = 4096;
  ADAM_SYSV_PROBE_SCRATCH: string = "rax r10 r11";
  // The register a C callback's thunk passes its data word in (CB1: the System V ABI's
  // static chain register, volatile, no argument, no result)
  ADAM_SYSV_CHAIN_REGISTER: string = "r10";
  // Raised (an IR or Lowering fault) by a void parameter, a frame this rule cannot make, or
  // what a later atom of PLAN-LINUX64 gives this part
  ADAM_SYSV_FAULT_VOID_PARAM: string = "SysVAbi: a void parameter at ";
  ADAM_SYSV_FAULT_LOCAL_ALIGN: string = "SysVAbi: a local alignment that is not a power of two: ";
  ADAM_SYSV_FAULT_NEGATIVE: string = "SysVAbi: a negative frame request: ";
  // The register save area (psABI Figure 3.32: the integer registers 8 bytes apart, then
  // the vector ones 16 apart) and the va_list record kept after it (Figure 3.33's fields:
  // gp_offset, fp_offset, overflow_arg_area, reg_save_area), Adam.Target.Linux64's facts
  ADAM_SYSV_SAVE_GP_BYTES: int64 = 48;
  ADAM_SYSV_SAVE_FP_STEP: int64 = 16;
  ADAM_SYSV_SAVE_BYTES: int64 = 176;
  ADAM_SYSV_VA_LIST_BYTES: int64 = 24;
  ADAM_SYSV_VA_GP_AT: int64 = 0;
  ADAM_SYSV_VA_FP_AT: int64 = 4;
  ADAM_SYSV_VA_OVERFLOW_AT: int64 = 8;
  ADAM_SYSV_VA_AREA_AT: int64 = 16;
  // The register a variadic call's vector register count goes in (al)
  ADAM_SYSV_VECTOR_COUNT: string = "rax";
  ADAM_SYSV_FAULT_RESULT: string = "SysVAbi: an aggregate result its registers cannot hold: ";

// AValue (0 or more) rounded up to a multiple of AAlign (1 or more)
func DoRoundUp(const AValue: int64; const AAlign: int64): int64;
begin
  return ((AValue + AAlign - 1) div AAlign) * AAlign;
end;

// The smaller of AFirst and ASecond
func DoMin(const AFirst: int64; const ASecond: int64): int64;
begin
  if AFirst < ASecond then
    return AFirst;
  end;
  return ASecond;
end;

public type
  // An eightbyte's class (see the header): only padding, INTEGER, SSE
  EightbyteClass = choices(Empty, General, Sse);

  // The System V x86_64 convention (see the header)
  SysVAbi = object(AbiPart)
    hidden FIntArgs: StringArray;
    hidden FFloatArgs: StringArray;
    hidden FIntResults: StringArray;
    hidden FFloatResults: StringArray;

    init();
    begin
      self.FIntArgs := SplitString(ADAM_SYSV_INT_ARGS, " ");
      self.FFloatArgs := SplitString(ADAM_SYSV_FLOAT_ARGS, " ");
      self.FIntResults := SplitString(ADAM_SYSV_INT_RESULTS, " ");
      self.FFloatResults := SplitString(ADAM_SYSV_FLOAT_RESULTS, " ");
    end;

    // True when an aggregate of AShape is MEMORY: past two eightbytes, empty or unaligned
    hidden const method DoInMemory(const AShape: ref IrAggregate): bool;
    begin
      return (AShape.Size <= 0) or (AShape.Size > ADAM_SYSV_REGISTER_EIGHTBYTES * ADAM_SYSV_EIGHTBYTE) or
        AShape.Unaligned;
    end;

    // The eightbytes of AShape
    hidden const method DoEightbytes(const AShape: ref IrAggregate): int64;
    begin
      return (AShape.Size + ADAM_SYSV_EIGHTBYTE - 1) div ADAM_SYSV_EIGHTBYTE;
    end;

    // The class of eightbyte AIndex of AShape: INTEGER when an integer leaf touches it, else
    // SSE when a float leaf does, else Empty
    hidden const method DoClassOf(const AShape: ref IrAggregate; const AIndex: int64): EightbyteClass;
    var
      LStart: int64;
      LEnd: int64;
      LFloat: bool;
      LI: int64;
    begin
      LStart := AIndex * ADAM_SYSV_EIGHTBYTE;
      LEnd := LStart + ADAM_SYSV_EIGHTBYTE;
      LFloat := false;
      for LI := 0 to AShape.LeafCount - 1 do
        if (AShape.LeafOffset(LI) < LEnd) and (AShape.LeafOffset(LI) + AShape.LeafSize(LI) > LStart) then
          if not AShape.LeafFloat(LI) then
            return EightbyteClass.General;
          end;
          LFloat := true;
        end;
      end;
      if LFloat then
        return EightbyteClass.Sse;
      end;
      return EightbyteClass.Empty;
    end;

    // The bytes of eightbyte AIndex of AShape (the last may be short)
    hidden const method DoEightbyteBytes(const AShape: ref IrAggregate; const AIndex: int64): int64;
    begin
      return DoMin(ADAM_SYSV_EIGHTBYTE, AShape.Size - AIndex * ADAM_SYSV_EIGHTBYTE);
    end;

    // AShape (not DoInMemory) as pieces, each eightbyte in the next register of its class
    // from AInts / AFloats (counted on); nil when they are short, the counts then unchanged
    hidden const method DoPieces(const AShape: ref IrAggregate; const AInts: StringArray;
      const AFloats: StringArray; var AIntAt: int64; var AFloatAt: int64): ref Location;
    var
      LPlace: ref Location;
      LClass: EightbyteClass;
      LInts: int64;
      LFloats: int64;
      LI: int64;
    begin
      LInts := 0;
      LFloats := 0;
      for LI := 0 to self.DoEightbytes(AShape) - 1 do
        LClass := self.DoClassOf(AShape, LI);
        if LClass = EightbyteClass.General then
          LInts := LInts + 1;
        end;
        if LClass = EightbyteClass.Sse then
          LFloats := LFloats + 1;
        end;
      end;
      if (AIntAt + LInts > len(AInts)) or (AFloatAt + LFloats > len(AFloats)) then
        return nil;
      end;
      LPlace := ref Location(LocationKind.Pieces);
      for LI := 0 to self.DoEightbytes(AShape) - 1 do
        LClass := self.DoClassOf(AShape, LI);
        if LClass = EightbyteClass.General then
          LPlace.AddPiece(AInts[AIntAt], LI * ADAM_SYSV_EIGHTBYTE, self.DoEightbyteBytes(AShape, LI), false);
          AIntAt := AIntAt + 1;
        end;
        if LClass = EightbyteClass.Sse then
          LPlace.AddPiece(AFloats[AFloatAt], LI * ADAM_SYSV_EIGHTBYTE, self.DoEightbyteBytes(AShape, LI),
            true);
          AFloatAt := AFloatAt + 1;
        end;
      end;
      return LPlace;
    end;

    // An aggregate argument of AShape: its pieces in the registers left (DoPieces), else
    // its bytes copied to the next stack place, aligned to its alignment (8 at least)
    hidden const method DoAggregatePlace(const AShape: ref IrAggregate; var AInts: int64;
      var AFloats: int64; var AStackBytes: int64): ref Location;
    var
      LPlace: ref Location;
      LAlign: int64;
      LOffset: int64;
    begin
      if not self.DoInMemory(AShape) then
        LPlace := self.DoPieces(AShape, self.FIntArgs, self.FFloatArgs, AInts, AFloats);
        if LPlace <> nil then
          return LPlace;
        end;
      end;
      LAlign := AShape.Align;
      if LAlign < ADAM_SYSV_SLOT_BYTES then
        LAlign := ADAM_SYSV_SLOT_BYTES;
      end;
      LOffset := DoRoundUp(AStackBytes, LAlign);
      AStackBytes := LOffset + DoRoundUp(AShape.Size, ADAM_SYSV_SLOT_BYTES);
      return StackBytesLocation(LOffset, LOffset + ADAM_SYSV_RETURN_BYTES, AShape.Size);
    end;

    override method AbiName(): string;
    begin
      return ADAM_SYSV_ABI_NAME;
    end;

    // No archive (an empty list, never SplitString's one empty part of "")
    override method CRuntime(): ref CRuntimeFacts;
    var
      LArchives: StringArray;
      LFacts: ref CRuntimeFacts;
    begin
      LFacts := ref CRuntimeFacts(LArchives,
        SplitString(ADAM_SYSV_C_LIBRARIES, " "), SplitString(ADAM_SYSV_C_STAND_IN_NAMES, " "),
        SplitString(ADAM_SYSV_C_STAND_INS, " "));
      LFacts.SharedTable := ADAM_SYSV_C_SHARED_TABLE;
      LFacts.StartRoutine := ADAM_SYSV_C_START_ROUTINE;
      LFacts.StreamNames := SplitString(ADAM_SYSV_C_STREAM_NAMES, " ");
      LFacts.StreamHook := ADAM_SYSV_C_STREAM_HOOK;
      return LFacts;
    end;

    override method ThreadLocal(): ref ThreadLocalFacts;
    begin
      return ref ThreadLocalFacts(ThreadLocalForm.ThreadPointer, ADAM_SYSV_TLS_REGISTER,
        ADAM_SYSV_TLS_BLOCK_OFFSET, ADAM_SYSV_TLS_INDEX_SYMBOL);
    end;

    override method StackAlign(): int64;
    begin
      return ADAM_SYSV_STACK_ALIGN;
    end;

    override method FrameRegister(): string;
    begin
      return ADAM_SYSV_FRAME_REGISTER;
    end;

    override method PageBytes(): int64;
    begin
      return ADAM_SYSV_PAGE_BYTES;
    end;

    override method ProbeScratch(): StringArray;
    begin
      return SplitString(ADAM_SYSV_PROBE_SCRATCH, " ");
    end;

    override method ChainRegister(): string;
    begin
      return ADAM_SYSV_CHAIN_REGISTER;
    end;

    // Each argument by its kind's own count: an integer or pointer in the next of rdi ..
    // r9, a float in the next of xmm0 .. xmm7; once its kind's registers are spent, the
    // next 8-byte stack place (from the stack pointer at the call). A variadic call's
    // arguments past the fixed ones go the same way (a float stays in its xmm register: no
    // integer copy, the callee's register save area reads both kinds; al, the count of
    // vector registers a variadic call uses, is LX1b's)
    override method LayoutCall(const ASignature: ref IrSignature): ref CallLayout;
    var
      LLayout: ref CallLayout;
      LShape: ref IrAggregate;
      LResult: ref Location;
      LI: int64;
      LType: IrType;
      LInts: int64;
      LFloats: int64;
      LStackBytes: int64;
      LIntResult: int64;
      LFloatResult: int64;
    begin
      LLayout := ref CallLayout();
      LInts := 0;
      LFloats := 0;
      LStackBytes := 0;
      for LI := 0 to ASignature.ParamCount - 1 do
        LType := ASignature.ParamTypes[LI];
        if LType = IrType.Void then
          raise(ADAM_SYSV_FAULT_VOID_PARAM + IntToStr(LI));
        end;
        LShape := ASignature.ParamShape(LI);
        // a result's place: passed (in rdi, the first) only for a MEMORY result
        if ASignature.ResultPlace and (LI = 0) then
          if self.DoInMemory(LShape) then
            LLayout.AddArg(RegisterLocation(self.FIntArgs[LInts]));
            LInts := LInts + 1;
          else
            LLayout.AddArg(ref Location(LocationKind.None));
          end;
          skip;
        end;
        if LShape <> nil then
          LLayout.AddArg(self.DoAggregatePlace(LShape, LInts, LFloats, LStackBytes));
          skip;
        end;
        if IsFloatType(LType) and (LFloats < len(self.FFloatArgs)) then
          LLayout.AddArg(RegisterLocation(self.FFloatArgs[LFloats]));
          LFloats := LFloats + 1;
        else
          if (not IsFloatType(LType)) and (LInts < len(self.FIntArgs)) then
            LLayout.AddArg(RegisterLocation(self.FIntArgs[LInts]));
            LInts := LInts + 1;
          else
            LLayout.AddArg(StackLocation(LStackBytes, LStackBytes + ADAM_SYSV_RETURN_BYTES));
            LStackBytes := LStackBytes + ADAM_SYSV_SLOT_BYTES;
          end;
        end;
      end;
      if IsFloatType(ASignature.ResultType) then
        LLayout.ResultAt := RegisterLocation(ADAM_SYSV_FLOAT_RESULT);
      end;
      if (ASignature.ResultType <> IrType.Void) and not IsFloatType(ASignature.ResultType) then
        LLayout.ResultAt := RegisterLocation(ADAM_SYSV_INT_RESULT);
      end;
      // an aggregate result in registers: its pieces (a MEMORY one's address is in rax)
      LShape := ASignature.ResultShape();
      if (LShape <> nil) and not self.DoInMemory(LShape) then
        LIntResult := 0;
        LFloatResult := 0;
        LResult := self.DoPieces(LShape, self.FIntResults, self.FFloatResults, LIntResult, LFloatResult);
        if LResult = nil then
          raise(ADAM_SYSV_FAULT_RESULT + LShape.Text());
        end;
        LLayout.ResultAt := LResult;
      end;
      // No home area: only the stacked arguments' places
      LLayout.OutgoingBytes := LStackBytes;
      // A narrow integer argument is extended to 32 bits by the caller (clang's callees
      // read all 32)
      LLayout.ExtendNarrow := true;
      if ASignature.Variadic then
        LLayout.VectorCountRegister := ADAM_SYSV_VECTOR_COUNT;
        LLayout.VectorCount := LFloats;
      end;
      return LLayout;
    end;

    // True when ARegister is one of the vector argument registers
    hidden const method DoIsFloatArg(const ARegister: string): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FFloatArgs) - 1 do
        if self.FFloatArgs[LI] = ARegister then
          return true;
        end;
      end;
      return false;
    end;

    // The register save area of a variadic function of ASignature (see the header): every
    // argument register homed in it, the va_list state after it, gp_offset / fp_offset past
    // the registers its fixed parameters take (their call layout's), overflow_arg_area at
    // its first stacked variadic argument, past its stacked fixed ones
    override method LayoutVarargs(const ASignature: ref IrSignature): ref VarargsLayout;
    var
      LLayout: ref VarargsLayout;
      LCall: ref CallLayout;
      LPlace: ref Location;
      LInts: int64;
      LFloats: int64;
      LI: int64;
      LK: int64;
    begin
      LCall := self.LayoutCall(ASignature);
      LInts := 0;
      LFloats := 0;
      for LI := 0 to LCall.ArgCount - 1 do
        LPlace := LCall.ArgAt(LI);
        if LPlace.Kind = LocationKind.Register then
          if self.DoIsFloatArg(LPlace.RegisterName) then
            LFloats := LFloats + 1;
          else
            LInts := LInts + 1;
          end;
        end;
        if LPlace.Kind = LocationKind.Pieces then
          for LK := 0 to LPlace.PieceCount - 1 do
            if LPlace.PieceFloat(LK) then
              LFloats := LFloats + 1;
            else
              LInts := LInts + 1;
            end;
          end;
        end;
      end;
      LLayout := ref VarargsLayout();
      for LI := 0 to len(self.FIntArgs) - 1 do
        LLayout.AddHome(self.FIntArgs[LI], LI * ADAM_SYSV_SLOT_BYTES);
      end;
      for LI := 0 to len(self.FFloatArgs) - 1 do
        LLayout.AddHome(self.FFloatArgs[LI], ADAM_SYSV_SAVE_GP_BYTES + LI * ADAM_SYSV_SAVE_FP_STEP);
      end;
      LLayout.SaveBytes := ADAM_SYSV_SAVE_BYTES + ADAM_SYSV_VA_LIST_BYTES;
      LLayout.StateAt := ADAM_SYSV_SAVE_BYTES;
      LLayout.GpAt := ADAM_SYSV_VA_GP_AT;
      LLayout.FpAt := ADAM_SYSV_VA_FP_AT;
      LLayout.OverflowAt := ADAM_SYSV_VA_OVERFLOW_AT;
      LLayout.AreaAt := ADAM_SYSV_VA_AREA_AT;
      LLayout.GpStart := LInts * ADAM_SYSV_SLOT_BYTES;
      LLayout.FpStart := ADAM_SYSV_SAVE_GP_BYTES + LFloats * ADAM_SYSV_SAVE_FP_STEP;
      LLayout.FirstAt := ADAM_SYSV_RETURN_BYTES + LCall.OutgoingBytes;
      return LLayout;
    end;

    // A variadic aggregate is classified as a named one (psABI 3.5.7's va_arg): a MEMORY
    // one is always in the overflow area, its bytes at its alignment (8 at least) taking
    // its size rounded up to 8 (DoAggregatePlace's stack place); any other has its
    // eightbytes' pieces (DoPieces: each the next register of its class), read from the
    // register save area when they all fit, else from the overflow area as a MEMORY one
    override method LayoutVariadicAggregate(const AShape: ref IrAggregate): ref VariadicAggregate;
    var
      LLayout: ref VariadicAggregate;
      LAlign: int64;
      LInts: int64;
      LFloats: int64;
    begin
      LAlign := AShape.Align;
      if LAlign < ADAM_SYSV_SLOT_BYTES then
        LAlign := ADAM_SYSV_SLOT_BYTES;
      end;
      LLayout := ref VariadicAggregate(LAlign, DoRoundUp(AShape.Size, ADAM_SYSV_SLOT_BYTES));
      if not self.DoInMemory(AShape) then
        LInts := 0;
        LFloats := 0;
        LLayout.Pieces := self.DoPieces(AShape, self.FIntArgs, self.FFloatArgs, LInts, LFloats);
      end;
      return LLayout;
    end;

    // Win64Abi's frame rule with no vector register saves (see the header)
    override method LayoutFrame(const ALocalBytes: int64; const ALocalAlign: int64;
      const AOutgoingBytes: int64; const ASavedCount: int64;
      const AVectorCount: int64; const AMakesCalls: bool): ref FrameLayout;
    var
      LFrame: ref FrameLayout;
      LAlign: int64;
      LFrameAlign: int64;
      LBelow: int64;
      LReach: int64;
    begin
      // AVectorCount is always 0 here (no xmm register is callee-saved): any other is a
      // request this rule cannot make
      if (ALocalBytes < 0) or (ALocalAlign < 0) or (AOutgoingBytes < 0) or (ASavedCount < 0) or
        (AVectorCount <> 0) then
        raise(ADAM_SYSV_FAULT_NEGATIVE + IntToStr(ALocalBytes) + " " + IntToStr(ALocalAlign) +
          " " + IntToStr(AOutgoingBytes) + " " + IntToStr(ASavedCount) + " " +
          IntToStr(AVectorCount));
      end;
      if (ALocalAlign > 0) and not IsPowerOfTwo(ALocalAlign) then
        raise(ADAM_SYSV_FAULT_LOCAL_ALIGN + IntToStr(ALocalAlign));
      end;
      LAlign := ALocalAlign;
      if LAlign < 1 then
        LAlign := 1;
      end;
      LFrame := ref FrameLayout();
      LFrame.SavedCount := ASavedCount;
      LFrame.SavedBytes := ASavedCount * ADAM_SYSV_SLOT_BYTES;
      // Locals aligned above the stack's alignment realign the frame
      LFrameAlign := ADAM_SYSV_STACK_ALIGN;
      if LAlign > ADAM_SYSV_STACK_ALIGN then
        LFrameAlign := LAlign;
        LFrame.Realign := LAlign;
        LFrame.FrameRegister := ADAM_SYSV_FRAME_REGISTER;
      end;
      // The outgoing area at the bottom, rounded to 16; the locals above it start at the
      // frame's alignment
      LFrame.OutgoingBytes := DoRoundUp(AOutgoingBytes, ADAM_SYSV_STACK_ALIGN);
      LFrame.LocalBase := DoRoundUp(LFrame.OutgoingBytes, LFrameAlign);
      LFrame.LocalBytes := DoRoundUp(ALocalBytes, LAlign);
      LBelow := LFrame.LocalBase + LFrame.LocalBytes;
      if (LBelow = 0) and (ASavedCount = 0) and not AMakesCalls then
        // A leaf with nothing to keep: no frame
        LFrame.AllocBytes := 0;
      else
        // At entry the stack pointer is 8 past a 16 boundary (the return address); the
        // saved registers and the reserved bytes (whole 8-byte places, so the loop below
        // ends) bring it back to one
        LFrame.AllocBytes := DoRoundUp(LBelow, ADAM_SYSV_SLOT_BYTES);
        while ((ADAM_SYSV_RETURN_BYTES + LFrame.SavedBytes + LFrame.AllocBytes) mod
          ADAM_SYSV_STACK_ALIGN) <> 0 do
          LFrame.AllocBytes := LFrame.AllocBytes + ADAM_SYSV_SLOT_BYTES;
        end;
      end;
      LFrame.SavedBase := LFrame.AllocBytes;
      LFrame.ReturnOffset := LFrame.SavedBase + LFrame.SavedBytes;
      LFrame.EntryBase := LFrame.ReturnOffset;
      // How far below the saves the frame reaches: the reservation, then a realigned frame's
      // rounding (at most Realign - 16); past a page it is probed (see the header)
      LReach := LFrame.AllocBytes;
      if LFrame.Realign > 0 then
        LReach := LReach + LFrame.Realign - ADAM_SYSV_STACK_ALIGN;
      end;
      if LReach > ADAM_SYSV_PAGE_BYTES then
        LFrame.ProbeBytes := LReach;
      end;
      return LFrame;
    end;

    override method CalleeSaved(): StringArray;
    begin
      return SplitString(ADAM_SYSV_CALLEE_SAVED, " ");
    end;

    override method Volatile(): StringArray;
    begin
      return SplitString(ADAM_SYSV_VOLATILE, " ");
    end;

    // The unwind data (Adam.SysV.Unwind's header): Adam.Backend.Unwind's tables in
    // adam_xdata / adam_pdata for System.Runtime.Linux64's unwinder (plan H1), and the
    // function's .eh_frame piece for foreign ones (backtrace(), gdb, perf)
    override method WriteUnwind(const ACode: ref FunctionCode; const ASections: ref SectionSet);
    begin
      TableUnwind(ACode, ASections, ADAM_SYSV_UNWIND_INFO, ADAM_SYSV_UNWIND_TABLE);
      FrameInfo(ACode, ASections);
    end;
  end;

end.
