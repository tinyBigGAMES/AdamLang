-------------------------------------------------------------------------------
  Adam.Backend.Parts.adam - the three target parts (DESIGN sec 6)

  A target is three independent parts, each an abstract object here, each
  target's part one implementation of it:
  ArchPart      the instruction set: its registers (by number and name),
                and one IR function generated into a SectionSet's code
                section (x86_64: Adam.X64.Select, Allocate, Encode over the
                arch's own machine IR), answered as a FunctionCode; and the
                stack probe a probed frame calls, by the ABI's facts
  AbiPart       the OS / ABI: the calling convention, the frame rule and
                its stack facts (the page a probed frame touches by, the
                registers free at a function's start),
                answered as data (CallLayout, FrameLayout) that names
                registers by their arch name, so the ABI part never holds
                an arch part and the arch part never holds an ABI part;
                and a generated function's unwind data, written from its
                FunctionCode alone
  FormatPart    the object format: what a section of each kind is called,
                a SectionSet written as one object file's bytes, and a
                SectionSet linked into an exe

  Parts never reference each other: Adam.Backend.Targets composes one of
  each per triple, and the phases above ask the composed parts. A fact no
  method answers is a new method here and in every implementation, never a
  constant above the parts.

  Location      where one value is at a call: none (a void result, or a
                result place the ABI does not pass), an arch register by
                name, a stack place given as offsets from the stack pointer
                at the call instruction (where the caller writes it) and at
                the callee's first instruction (where the callee reads it),
                with the bytes an aggregate takes there when it is copied
                in whole, or an aggregate's pieces, each in a register
                (LX1a2: Adam.Backend.Ssa's IrAggregate, placed by the ABI)
  CallLayout    a call's argument locations in order, its result's, and
                the bytes the caller reserves under the call for them
  VarargsLayout how a variadic function reaches its variadic arguments: the
                argument registers it stores at entry (each a home: the
                register and its place, from the stack pointer at entry,
                or in a register save area of its frame) and where the
                first stacked variadic argument is; with a save area
                (LX1b), the va_list state the function keeps beside it
                and that state's first values
  VariadicAggregate how a variadic function reads one variadic aggregate
                argument (C's va_arg of a record, LX1b2): from its place
                in the overflow area (or the cursor's), its bytes there or
                the address of the caller's copy, or eightbyte by
                eightbyte from the register save area while its registers
                were left
  FrameLayout   one function's frame: the bytes the prologue reserves and
                where each area starts, as offsets from the stack pointer
                after the prologue (a realigned frame, a probed frame: see
                FrameLayout)
  PrologueStep  one prologue instruction as data: what it does (allocate
                bytes, save a register, set the frame register; registers
                by their arch name) and where it ends, in bytes from the
                function's start
  ExeSettings   what the main module asks of its image (the GUI subsystem,
                the version resource, the icon; a dll: the image kind and
                its exports), read from its directives and declarations by
                the Driver and written by the format part
  FunctionCode  one generated function as the arch part hands it on: its
                symbol (and its id in the SectionSet), AST node, byte
                count, frame, whether it calls, its prologue steps in order,
                its IR slots' frame offsets (a funclet's parent's, which the
                funclet reaches them by), its scopes as byte ranges with
                their funclets' symbols and the frame handler's symbol
*******************************************************************************/

module unit Adam.Backend.Parts;

import System.SysUtils, Adam.Core.Containers, Adam.Compiler.Diagnostics, Adam.Compiler.AST,
  Adam.Backend.Ssa, Adam.Backend.Sections, Adam.Backend.DebugInfo;

public const
  // Raised (an invariant broken) by an argument index outside a call, a step index outside
  // a prologue
  ADAM_PARTS_FAULT_NO_ARG: string = "Parts: no argument ";
  ADAM_PARTS_FAULT_NO_STEP: string = "Parts: no prologue step ";
  ADAM_PARTS_FAULT_NO_HOME: string = "Parts: no varargs home ";
  ADAM_PARTS_FAULT_NO_PIECE: string = "Parts: no aggregate piece ";

public type
  // Where a value is (see the header)
  LocationKind = choices(None, Register, Stack, Pieces);

// The name of AKind, as a row prints it
public routine LocationKindText(const AKind: LocationKind): string;
begin
  match AKind of
    LocationKind.None: return "none";
    LocationKind.Register: return "register";
    LocationKind.Stack: return "stack";
    LocationKind.Pieces: return "pieces";
  end;
  return "";
end;

public type
  // Where one value is at a call (see the header)
  Location = object
    Kind: LocationKind;
    // Register: the arch part's name for it ("rcx", "xmm0")
    RegisterName: string;
    // Register: a second register the value is copied into too ("" for none): a float of a
    // variadic call goes in its float register and its integer one (Win64)
    ShadowName: string;
    // Stack: the offset from the stack pointer at the call instruction
    CallOffset: int64;
    // Stack: the offset from the stack pointer at the callee's first instruction; a home
    // (VarargsLayout.HomeAt, a register): the place, from there, the function stores it at
    EntryOffset: int64;
    // Stack: the bytes of an aggregate copied in whole there (0: a scalar's slot, or the
    // address of an aggregate's copy)
    Bytes: int64;
    // Pieces: each piece's register, its offset in the aggregate, its bytes (1..8) and
    // whether its register is a vector one
    hidden FPieceRegisters: StringArray;
    hidden FPieceOffsets: array of int64;
    hidden FPieceBytes: array of int64;
    hidden FPieceFloats: array of bool;
    hidden FPieceCount: int64;

    init(const AKind: LocationKind);
    begin
      self.Kind := AKind;
      self.RegisterName := "";
      self.ShadowName := "";
      self.CallOffset := 0;
      self.EntryOffset := 0;
      self.Bytes := 0;
      self.FPieceCount := 0;
    end;

    property PieceCount: int64 read FPieceCount;

    // Piece AIndex's register, offset, bytes and kind; each raises outside the pieces
    const method PieceRegister(const AIndex: int64): string;
    begin
      self.DoCheckPiece(AIndex);
      return self.FPieceRegisters[AIndex];
    end;

    const method PieceOffset(const AIndex: int64): int64;
    begin
      self.DoCheckPiece(AIndex);
      return self.FPieceOffsets[AIndex];
    end;

    const method PieceBytes(const AIndex: int64): int64;
    begin
      self.DoCheckPiece(AIndex);
      return self.FPieceBytes[AIndex];
    end;

    const method PieceFloat(const AIndex: int64): bool;
    begin
      self.DoCheckPiece(AIndex);
      return self.FPieceFloats[AIndex];
    end;

    // A piece of ABytes at AOffset in the register ARegister (a vector one when AFloat)
    method AddPiece(const ARegister: string; const AOffset: int64; const ABytes: int64;
      const AFloat: bool);
    begin
      if self.FPieceCount = len(self.FPieceOffsets) then
        setlength(self.FPieceRegisters, self.FPieceCount + 2);
        setlength(self.FPieceOffsets, self.FPieceCount + 2);
        setlength(self.FPieceBytes, self.FPieceCount + 2);
        setlength(self.FPieceFloats, self.FPieceCount + 2);
      end;
      self.FPieceRegisters[self.FPieceCount] := ARegister;
      self.FPieceOffsets[self.FPieceCount] := AOffset;
      self.FPieceBytes[self.FPieceCount] := ABytes;
      self.FPieceFloats[self.FPieceCount] := AFloat;
      self.FPieceCount := self.FPieceCount + 1;
    end;

    // "rcx", "xmm1+rdx" (with its shadow), "stack call +32 entry +40" (" bytes 24" after
    // it for an aggregate copied there), "pieces rdi@0+8 xmm0@8+4" or "none", as a row
    // prints it
    const method Text(): string;
    var
      LText: string;
      LI: int64;
    begin
      match self.Kind of
        LocationKind.None: return "none";
        LocationKind.Register:
          if self.ShadowName <> "" then
            return self.RegisterName + "+" + self.ShadowName;
          end;
          return self.RegisterName;
        LocationKind.Stack:
          LText := "stack call +" + IntToStr(self.CallOffset) + " entry +" +
            IntToStr(self.EntryOffset);
          if self.Bytes > 0 then
            LText := LText + " bytes " + IntToStr(self.Bytes);
          end;
          return LText;
        LocationKind.Pieces:
          LText := "pieces";
          for LI := 0 to self.FPieceCount - 1 do
            LText := LText + " " + self.FPieceRegisters[LI] + "@" + IntToStr(self.FPieceOffsets[LI]) +
              "+" + IntToStr(self.FPieceBytes[LI]);
          end;
          return LText;
      end;
      return "none";
    end;

    hidden const method DoCheckPiece(const AIndex: int64);
    begin
      if (AIndex < 0) or (AIndex >= self.FPieceCount) then
        raise(ADAM_PARTS_FAULT_NO_PIECE + IntToStr(AIndex));
      end;
    end;
  end;

// A location in the register named AName
public routine RegisterLocation(const AName: string): ref Location;
var
  LLocation: ref Location;
begin
  LLocation := ref Location(LocationKind.Register);
  LLocation.RegisterName := AName;
  return LLocation;
end;

// A stack location at ACallOffset from the stack pointer at the call, AEntryOffset at the
// callee's first instruction
public routine StackLocation(const ACallOffset: int64; const AEntryOffset: int64): ref Location;
var
  LLocation: ref Location;
begin
  LLocation := ref Location(LocationKind.Stack);
  LLocation.CallOffset := ACallOffset;
  LLocation.EntryOffset := AEntryOffset;
  return LLocation;
end;

// An aggregate of ABytes copied in whole to a stack location (StackLocation's offsets)
public routine StackBytesLocation(const ACallOffset: int64; const AEntryOffset: int64;
  const ABytes: int64): ref Location;
var
  LLocation: ref Location;
begin
  LLocation := StackLocation(ACallOffset, AEntryOffset);
  LLocation.Bytes := ABytes;
  return LLocation;
end;

public type
  // A call's argument and result locations (see the header)
  CallLayout = object
    hidden FArgs: array of ref Location;
    hidden FCount: int64;
    // Where the result is (Kind None for a void call)
    ResultAt: ref Location;
    // The bytes the caller reserves under the call for the arguments (any home area the
    // convention asks for included)
    OutgoingBytes: int64;
    // A register the call sets to VectorCount first ("" for none): a System V variadic
    // call's al, the vector registers its arguments take (LX1b)
    VectorCountRegister: string;
    VectorCount: int64;

    init();
    begin
      self.FCount := 0;
      self.ResultAt := ref Location(LocationKind.None);
      self.OutgoingBytes := 0;
      self.VectorCountRegister := "";
      self.VectorCount := 0;
    end;

    property ArgCount: int64 read FCount;

    // Where argument AIndex (0-based) is; raises outside the arguments
    const method ArgAt(const AIndex: int64): ref Location;
    begin
      if (AIndex < 0) or (AIndex >= self.FCount) then
        raise(ADAM_PARTS_FAULT_NO_ARG + IntToStr(AIndex));
      end;
      return self.FArgs[AIndex];
    end;

    // Adds ALocation as the next argument's
    method AddArg(const ALocation: ref Location);
    begin
      if self.FCount = len(self.FArgs) then
        setlength(self.FArgs, self.FCount * 2 + 4);
      end;
      self.FArgs[self.FCount] := ALocation;
      self.FCount := self.FCount + 1;
    end;

    // The layout as text, one line per argument then the result and the outgoing bytes
    const method Text(): string;
    var
      LText: string;
      LI: int64;
    begin
      LText := "";
      for LI := 0 to self.FCount - 1 do
        LText := LText + "arg " + IntToStr(LI) + " " + self.FArgs[LI].Text() + "\n";
      end;
      LText := LText + "result " + self.ResultAt.Text() + "\n" + "outgoing " +
        IntToStr(self.OutgoingBytes) + "\n";
      if self.VectorCountRegister <> "" then
        LText := LText + "vectors " + self.VectorCountRegister + " " + IntToStr(self.VectorCount) + "\n";
      end;
      return LText;
    end;
  end;

  // How a variadic function reaches its variadic arguments (see the header)
  VarargsLayout = object
    hidden FHomes: array of ref Location;
    hidden FCount: int64;
    // The offset from the stack pointer at the function's first instruction of its first
    // (stacked) variadic argument (the next ones follow, Target.VariadicSlotBytes apart)
    FirstAt: int64;
    // A register save area (0: none, the homes are in the incoming area): its bytes in the
    // function's frame (each home's EntryOffset is then its offset in the area), the
    // va_list state at StateAt in it (varargsstart gives its address), whose fields
    // (Target.VarargsSave's) at GpAt / FpAt start as GpStart / FpStart (uint32: the named
    // arguments' registers counted), at OverflowAt the first stacked variadic argument's
    // address (FirstAt), at AreaAt the area's address
    SaveBytes: int64;
    StateAt: int64;
    GpAt: int64;
    FpAt: int64;
    OverflowAt: int64;
    AreaAt: int64;
    GpStart: int64;
    FpStart: int64;

    init();
    begin
      self.FCount := 0;
      self.FirstAt := 0;
      self.SaveBytes := 0;
      self.StateAt := 0;
      self.GpAt := 0;
      self.FpAt := 0;
      self.OverflowAt := 0;
      self.AreaAt := 0;
      self.GpStart := 0;
      self.FpStart := 0;
    end;

    property HomeCount: int64 read FCount;

    // Home AIndex (0-based): a register location whose EntryOffset is the place the function
    // stores it at entry, so the variadic arguments it carried sit beside the stacked ones;
    // raises outside the homes
    const method HomeAt(const AIndex: int64): ref Location;
    begin
      if (AIndex < 0) or (AIndex >= self.FCount) then
        raise(ADAM_PARTS_FAULT_NO_HOME + IntToStr(AIndex));
      end;
      return self.FHomes[AIndex];
    end;

    // Adds the register named AName, stored at AEntryOffset, as the next home
    method AddHome(const AName: string; const AEntryOffset: int64);
    var
      LHome: ref Location;
    begin
      LHome := RegisterLocation(AName);
      LHome.EntryOffset := AEntryOffset;
      if self.FCount = len(self.FHomes) then
        setlength(self.FHomes, self.FCount * 2 + 4);
      end;
      self.FHomes[self.FCount] := LHome;
      self.FCount := self.FCount + 1;
    end;

    // The layout as text: one line per home ("home rdx entry +16"), then "first entry +16"
    const method Text(): string;
    var
      LText: string;
      LI: int64;
    begin
      LText := "";
      for LI := 0 to self.FCount - 1 do
        LText := LText + "home " + self.FHomes[LI].RegisterName + " entry +" +
          IntToStr(self.FHomes[LI].EntryOffset) + "\n";
      end;
      LText := LText + "first entry +" + IntToStr(self.FirstAt) + "\n";
      if self.SaveBytes > 0 then
        LText := LText + "save " + IntToStr(self.SaveBytes) + " state +" + IntToStr(self.StateAt) +
          " gp " + IntToStr(self.GpStart) + " fp " + IntToStr(self.FpStart) + "\n";
      end;
      return LText;
    end;
  end;

  // How a variadic function reads one variadic aggregate argument (see the header): at its
  // place in the overflow area (a cursor ABI's next place), aligned to OverflowAlign and
  // taking OverflowBytes there, holding its bytes or (ByAddress) the address of the
  // caller's copy; with Pieces (a register save area's ABI), from the area instead while
  // the registers its pieces need were left at the call: each piece (its offset in the
  // aggregate, its bytes, a float's or an integer's) one eightbyte in the next register of
  // its kind, in order
  VariadicAggregate = object
    ByAddress: bool;
    Pieces: ref Location;
    OverflowAlign: int64;
    OverflowBytes: int64;

    init(const AOverflowAlign: int64; const AOverflowBytes: int64);
    begin
      self.ByAddress := false;
      self.Pieces := nil;
      self.OverflowAlign := AOverflowAlign;
      self.OverflowBytes := AOverflowBytes;
    end;

    // The integer pieces (a float's counted apart, FloatPieces)
    const method IntPieces(): int64;
    begin
      return self.DoPiecesOf(false);
    end;

    // The float pieces
    const method FloatPieces(): int64;
    begin
      return self.DoPiecesOf(true);
    end;

    // "vararg pieces i 0+8 f 8+8 overflow 16 align 8" ("vararg by address overflow 8 align
    // 8"; no pieces: "vararg overflow 24 align 8")
    const method Text(): string;
    var
      LText: string;
      LI: int64;
    begin
      LText := "vararg";
      if self.ByAddress then
        LText := LText + " by address";
      end;
      if self.Pieces <> nil then
        LText := LText + " pieces";
        for LI := 0 to self.Pieces.PieceCount - 1 do
          if self.Pieces.PieceFloat(LI) then
            LText := LText + " f ";
          else
            LText := LText + " i ";
          end;
          LText := LText + IntToStr(self.Pieces.PieceOffset(LI)) + "+" +
            IntToStr(self.Pieces.PieceBytes(LI));
        end;
      end;
      return LText + " overflow " + IntToStr(self.OverflowBytes) + " align " +
        IntToStr(self.OverflowAlign) + "\n";
    end;

    hidden const method DoPiecesOf(const AFloat: bool): int64;
    var
      LCount: int64;
      LI: int64;
    begin
      LCount := 0;
      if self.Pieces = nil then
        return 0;
      end;
      for LI := 0 to self.Pieces.PieceCount - 1 do
        if self.Pieces.PieceFloat(LI) = AFloat then
          LCount := LCount + 1;
        end;
      end;
      return LCount;
    end;
  end;

  // One function's frame (see the header). Every offset is from the stack pointer after
  // the prologue, which reserves AllocBytes under the registers it saved
  FrameLayout = object
    // The callee-saved registers the prologue saves, and the bytes they take
    SavedCount: int64;
    SavedBytes: int64;
    // The callee-saved vector registers the prologue saves after the reservation, each
    // whole (16 bytes) at VectorBase + 16 * k (k in the ABI's order), VectorBase a multiple
    // of 16 above the locals, from the stack pointer after the reservation (a realigned
    // frame: from FrameRegister, which holds that value); 0 and 0: none
    VectorCount: int64;
    VectorBase: int64;
    // The locals' area: its start and its bytes (locals are placed from LocalBase up)
    LocalBase: int64;
    LocalBytes: int64;
    // The area for the arguments of the calls the function makes (from offset 0)
    OutgoingBytes: int64;
    // The bytes the prologue reserves under the saved registers (0: no frame)
    AllocBytes: int64;
    // Where the saved registers start, and the return address
    SavedBase: int64;
    ReturnOffset: int64;
    // The stack pointer at the function's first instruction: a Location's EntryOffset is
    // from here
    EntryBase: int64;
    // A realigned frame (locals aligned above the ABI's StackAlign): Realign is the
    // alignment the stack pointer is rounded down to after the prologue, and FrameRegister
    // (by the arch part's name) holds the stack pointer as it was after the reservation.
    // Then LocalBase and OutgoingBytes are from the rounded stack pointer, SavedBase,
    // ReturnOffset and EntryBase from FrameRegister. 0 and "": not realigned, every offset
    // from the stack pointer after the prologue
    Realign: int64;
    FrameRegister: string;
    // A probed frame: the bytes below the stack pointer after the saves that the frame
    // reaches (the reservation, and a realigned frame's rounding at its most), touched page
    // by page (AbiPart.PageBytes) before the reservation, so the OS's guard page is never
    // skipped. 0: not probed, the frame stays within a page of what the saves touched
    ProbeBytes: int64;

    init();
    begin
      self.SavedCount := 0;
      self.SavedBytes := 0;
      self.VectorCount := 0;
      self.VectorBase := 0;
      self.LocalBase := 0;
      self.LocalBytes := 0;
      self.OutgoingBytes := 0;
      self.AllocBytes := 0;
      self.SavedBase := 0;
      self.ReturnOffset := 0;
      self.EntryBase := 0;
      self.Realign := 0;
      self.FrameRegister := "";
      self.ProbeBytes := 0;
    end;

    // The frame as one line, as a row prints it (a realigned frame adds its alignment and
    // its frame register, a probed one its probe)
    const method Text(): string;
    var
      LText: string;
    begin
      LText := "alloc " + IntToStr(self.AllocBytes) + " outgoing " + IntToStr(self.OutgoingBytes) +
        " locals +" + IntToStr(self.LocalBase) + " " + IntToStr(self.LocalBytes) + " saved +" +
        IntToStr(self.SavedBase) + " " + IntToStr(self.SavedCount) + " return +" +
        IntToStr(self.ReturnOffset) + " entry +" + IntToStr(self.EntryBase);
      if self.Realign > 0 then
        LText := LText + " realign " + IntToStr(self.Realign) + " over " + self.FrameRegister;
      end;
      if self.ProbeBytes > 0 then
        LText := LText + " probe " + IntToStr(self.ProbeBytes);
      end;
      if self.VectorCount > 0 then
        LText := LText + " vectors +" + IntToStr(self.VectorBase) + " " +
          IntToStr(self.VectorCount);
      end;
      return LText;
    end;
  end;

  // What one prologue step does (see the header)
  PrologueAction = choices(Allocate, SaveRegister, SetFrame, SaveVector);

// The name of AAction, as a row prints it
public routine PrologueActionText(const AAction: PrologueAction): string;
begin
  match AAction of
    PrologueAction.Allocate: return "allocate";
    PrologueAction.SaveRegister: return "save";
    PrologueAction.SetFrame: return "frame";
    PrologueAction.SaveVector: return "save vector";
  end;
  return "";
end;

public type
  // One prologue instruction as data (see the header)
  PrologueStep = object
    Action: PrologueAction;
    // Allocate: the bytes reserved; SaveVector: where the register is saved, from the stack
    // pointer after the reservation (0 otherwise)
    Bytes: int64;
    // SaveRegister / SetFrame / SaveVector: the register, by the arch part's name ("" otherwise)
    RegisterName: string;
    // Where the step's instruction ends, in bytes from the function's start
    EndsAt: int64;

    init(const AAction: PrologueAction);
    begin
      self.Action := AAction;
      self.Bytes := 0;
      self.RegisterName := "";
      self.EndsAt := 0;
    end;

    // "allocate 40 ends 4", "save rbx ends 1", as a row prints it
    const method Text(): string;
    begin
      if self.Action = PrologueAction.Allocate then
        return "allocate " + IntToStr(self.Bytes) + " ends " + IntToStr(self.EndsAt);
      end;
      if self.Action = PrologueAction.SaveVector then
        return "save vector " + self.RegisterName + " at +" + IntToStr(self.Bytes) + " ends " +
          IntToStr(self.EndsAt);
      end;
      return PrologueActionText(self.Action) + " " + self.RegisterName + " ends " +
        IntToStr(self.EndsAt);
    end;
  end;

  // One generated function (see the header). Its slots: each IR slot's offset in its frame
  // (from the stack pointer after the prologue, a realigned frame's rounded one), what a
  // funclet of it reaches them by. Its scopes: each a byte range of its code (from its
  // symbol on, the end past the range: a call ending at the range's last byte returns into
  // it) and the symbol of the funclet an unwind leaving it runs, innermost first (a catching
  // scope's: its filter's symbol and its target, the byte its caught exceptions resume at;
  // -1 for any other); with any, FrameHandler is the symbol of the function the OS calls for
  // its frame
  FunctionCode = object
    hidden FSteps: array of ref PrologueStep;
    hidden FCount: int64;
    hidden FSlotIds: ref Int64List;
    hidden FSlotOffsets: ref Int64List;
    hidden FScopeBegins: ref Int64List;
    hidden FScopeEnds: ref Int64List;
    hidden FScopeHandlers: StringArray;
    hidden FScopeTargets: ref Int64List;
    hidden FPlaceStarts: ref Int64List;
    hidden FPlaceNodes: ref Int64List;
    // The function's symbol, its id in the SectionSet it was generated into, its AST node
    // (0: none)
    Symbol: string;
    SymbolId: int64;
    Node: int64;
    // Its code's bytes, from its symbol on
    ByteCount: int64;
    // Its frame (nil: none laid out), and whether it makes calls
    Frame: ref FrameLayout;
    MakesCalls: bool;
    // The frame handler's symbol ("": no scopes)
    FrameHandler: string;
    // A funclet's generated parent (nil: no funclet): a funclet nested in this one walks
    // up these to reach the slots of every function it is nested in
    ParentCode: ref FunctionCode;
    // Where a funclet that has funclets of its own keeps its frame parameter (its parent's
    // raw frame, as the target hands it a funclet), at an offset as a slot's (-1: none)
    FrameSaveOffset: int64;

    init(const ASymbol: string);
    begin
      self.FCount := 0;
      self.FSlotIds := ref Int64List();
      self.FSlotOffsets := ref Int64List();
      self.FScopeBegins := ref Int64List();
      self.FScopeEnds := ref Int64List();
      setlength(self.FScopeHandlers, 0);
      self.FScopeTargets := ref Int64List();
      self.FPlaceStarts := ref Int64List();
      self.FPlaceNodes := ref Int64List();
      self.Symbol := ASymbol;
      self.SymbolId := 0;
      self.Node := 0;
      self.ByteCount := 0;
      self.Frame := nil;
      self.MakesCalls := false;
      self.FrameHandler := "";
      self.ParentCode := nil;
      self.FrameSaveOffset := -1;
    end;

    property StepCount: int64 read FCount;

    // Records IR slot AIrSlot at AOffset in the frame
    method AddSlot(const AIrSlot: int64; const AOffset: int64);
    begin
      self.FSlotIds.Add(AIrSlot);
      self.FSlotOffsets.Add(AOffset);
    end;

    // A place row (M4.L2): the code from AStart (from its symbol on) on is the AST node
    // ANode's, up to the next row; rows are added in code order
    method AddPlace(const AStart: int64; const ANode: int64);
    begin
      self.FPlaceStarts.Add(AStart);
      self.FPlaceNodes.Add(ANode);
    end;

    // The place rows AStarts / ANodes (the same count, in code order) taken as this code's
    // rows in place of any it had: the lists themselves, no copy (the arch part hands over
    // the rows its encoder found)
    method TakePlaces(const AStarts: ref Int64List; const ANodes: ref Int64List);
    begin
      self.FPlaceStarts := AStarts;
      self.FPlaceNodes := ANodes;
    end;

    // How many place rows it has, and row AIndex's start and node (0-based)
    const method PlaceCount(): int64;
    begin
      return self.FPlaceStarts.Count;
    end;

    const method PlaceStartAt(const AIndex: int64): int64;
    begin
      return self.FPlaceStarts.Items[AIndex];
    end;

    const method PlaceNodeAt(const AIndex: int64): int64;
    begin
      return self.FPlaceNodes.Items[AIndex];
    end;

    // The frame offset of IR slot AIrSlot (-1: not one of the function's slots)
    const method SlotOffsetOf(const AIrSlot: int64): int64;
    var
      LI: int64;
    begin
      LI := self.FSlotIds.IndexOf(AIrSlot);
      if LI < 0 then
        return -1;
      end;
      return self.FSlotOffsets[LI];
    end;

    // Adds a scope: the bytes ABegin up to AEnd (past the last), the funclet AHandler and
    // ATarget -1; or, catching, the filter AHandler and the byte ATarget
    method AddScope(const ABegin: int64; const AEnd: int64; const AHandler: string;
      const ATarget: int64);
    begin
      self.FScopeBegins.Add(ABegin);
      self.FScopeEnds.Add(AEnd);
      setlength(self.FScopeHandlers, len(self.FScopeHandlers) + 1);
      self.FScopeHandlers[len(self.FScopeHandlers) - 1] := AHandler;
      self.FScopeTargets.Add(ATarget);
    end;

    // Scope AIndex's target byte (-1: no catching scope)
    const method ScopeTarget(const AIndex: int64): int64;
    begin
      return self.FScopeTargets[AIndex];
    end;

    // True when a scope catches (one has a target)
    const method Catches(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to self.FScopeTargets.Count - 1 do
        if self.FScopeTargets[LI] >= 0 then
          return true;
        end;
      end;
      return false;
    end;

    // How many scopes; scope AIndex's begin, end and funclet symbol
    const method ScopeCount(): int64;
    begin
      return self.FScopeBegins.Count;
    end;

    const method ScopeBegin(const AIndex: int64): int64;
    begin
      return self.FScopeBegins[AIndex];
    end;

    const method ScopeEnd(const AIndex: int64): int64;
    begin
      return self.FScopeEnds[AIndex];
    end;

    const method ScopeHandler(const AIndex: int64): string;
    begin
      return self.FScopeHandlers[AIndex];
    end;

    // Prologue step AIndex (0-based, in code order); raises outside the prologue
    const method StepAt(const AIndex: int64): ref PrologueStep;
    begin
      if (AIndex < 0) or (AIndex >= self.FCount) then
        raise(ADAM_PARTS_FAULT_NO_STEP + IntToStr(AIndex) + " in " + self.Symbol);
      end;
      return self.FSteps[AIndex];
    end;

    // Adds AStep as the prologue's next step
    method AddStep(const AStep: ref PrologueStep);
    begin
      if self.FCount = len(self.FSteps) then
        setlength(self.FSteps, self.FCount * 2 + 4);
      end;
      self.FSteps[self.FCount] := AStep;
      self.FCount := self.FCount + 1;
    end;

    // The function as text: one line of its shape, then one per step
    const method Text(): string;
    var
      LText: string;
      LFrame: string;
      LI: int64;
    begin
      LFrame := "none";
      if self.Frame <> nil then
        LFrame := self.Frame.Text();
      end;
      LText := "code " + self.Symbol + " bytes " + IntToStr(self.ByteCount) + " calls " +
        BoolToStr(self.MakesCalls) + " frame " + LFrame + "\n";
      for LI := 0 to self.FCount - 1 do
        LText := LText + "step " + IntToStr(LI) + " " + self.FSteps[LI].Text() + "\n";
      end;
      return LText;
    end;
  end;

  // The C runtime a link resolves a static library's objects against (the ABI's): its static
  // archives (file names, searched in this order after the program's static libraries: the C
  // runtime's static extras and the compiler support routines), then the library spellings
  // (BNF sec 2's search) of the DLLs whose exports stand for what no archive defines, in the
  // order they are searched (a name binds to the first that exports it); and its stand-ins
  // (M8d): each C name in CNames a routine the C runtime's startup defines and an Adam image
  // does not carry, bound by the link to the runtime's routine StandIns[i] (its own name, so
  // an Adam lib in a C program never meets the C runtime's own definition). A C runtime the
  // link binds to as a shared library by symbol versions (glibc, PLAN-LINUX64 LX3b) names
  // its version table SharedTable (a file the library paths hold: each symbol's version and
  // shared library, "" none) and StartRoutine the routine an exe's own start calls with the
  // entry ("" none)
  CRuntimeFacts = object
    Archives: StringArray;
    LibraryNames: StringArray;
    CNames: StringArray;
    StandIns: StringArray;
    SharedTable: string;
    StartRoutine: string;

    init(const AArchives: StringArray; const ALibraryNames: StringArray;
      const ACNames: StringArray; const AStandIns: StringArray);
    begin
      self.Archives := AArchives;
      self.LibraryNames := ALibraryNames;
      self.CNames := ACNames;
      self.StandIns := AStandIns;
      self.SharedTable := "";
      self.StartRoutine := "";
    end;
  end;

  // What the main module's prologue directives ask of the exe's image (BNF sec 2), read from
  // its directive nodes by the Driver and written by the format part as its OS takes them:
  // Gui the GUI subsystem (@subsystem gui; else the console one); VersionInfo a version
  // resource (@addverinfo on) of VersionMajor.VersionMinor.VersionPatch (@vimajor /
  // @viminor / @vipatch, 0..65535) and the texts ProductName (@viproductname), Description
  // (@videscription), FileName (@vifilename), CompanyName (@vicompanyname) and Copyright
  // (@vicopyright), "" for one not given; IconPath the @exeicon file's resolved path ("" none)
  // and IconNode the node of its path, where a file that holds no icon is reported; Dll the
  // image is a dll (the main module's kind, M8a) and Exports the symbols it exports (its
  // main module's public routines and variables, BNF sec 3 row 20), under their own names,
  // ExportData[i] true when Exports[i] is a variable (its import library imports it as
  // data, M8b), DllName its file's name (what its export directory names it); DebugFile
  // the debug file's name a debug build's image names (its file name alone: it is written
  // beside the image; "" none: no debug file, M7d) and ModuleName the name the debug file
  // gives the program's own object (the set GenerateSections made: its entry and start
  // lists; every unit's object, the main module's too, is a merged one of its own name)
  ExeSettings = object
    Dll: bool;
    Exports: StringArray;
    ExportData: BoolArray;
    DllName: string;
    Gui: bool;
    VersionInfo: bool;
    VersionMajor: int64;
    VersionMinor: int64;
    VersionPatch: int64;
    ProductName: string;
    Description: string;
    FileName: string;
    CompanyName: string;
    Copyright: string;
    IconPath: string;
    IconNode: int64;
    DebugFile: string;
    ModuleName: string;

    init();
    begin
      self.Dll := false;
      setlength(self.Exports, 0);
      setlength(self.ExportData, 0);
      self.DllName := "";
      self.Gui := false;
      self.VersionInfo := false;
      self.VersionMajor := 0;
      self.VersionMinor := 0;
      self.VersionPatch := 0;
      self.ProductName := "";
      self.Description := "";
      self.FileName := "";
      self.CompanyName := "";
      self.Copyright := "";
      self.IconPath := "";
      self.IconNode := 0;
      self.DebugFile := "";
      self.ModuleName := "";
    end;
  end;

  // How a thread reaches its own copy of the program's thread-local section (the ABI's
  // model): IndexedBlock: the thread's block of copies is a table of pointers, one per
  // module, read at BlockOffset from the thread register; the module's entry is at the
  // 4-byte index the loader writes into IndexSymbol; a variable is its section offset
  // (SecRel32) from that entry (win64: gs, 0x58, _tls_index). ThreadPointer: the variable
  // is at a fixed offset from the thread register's own value (linux64's local-exec model,
  // when that target comes)
  ThreadLocalForm = choices(IndexedBlock, ThreadPointer);

  // The ABI's thread-local model (see ThreadLocalForm): the thread register by the arch
  // part's name, the block table's offset from it and the index symbol (IndexedBlock)
  ThreadLocalFacts = object
    Form: ThreadLocalForm;
    ThreadRegister: string;
    BlockOffset: int64;
    IndexSymbol: string;

    init(const AForm: ThreadLocalForm; const AThreadRegister: string; const ABlockOffset: int64;
      const AIndexSymbol: string);
    begin
      self.Form := AForm;
      self.ThreadRegister := AThreadRegister;
      self.BlockOffset := ABlockOffset;
      self.IndexSymbol := AIndexSymbol;
    end;
  end;

  // The OS / ABI (see the header); registers are named as the arch part names them
  AbiPart = object
    // The ABI's name ("win64")
    virtual method AbiName(): string; abstract;

    // The C runtime a static library's objects are linked against (see CRuntimeFacts)
    virtual method CRuntime(): ref CRuntimeFacts; abstract;

    // How a thread reaches its thread-local variables (see ThreadLocalFacts)
    virtual method ThreadLocal(): ref ThreadLocalFacts; abstract;

    // The stack pointer's alignment at every call, in bytes
    virtual method StackAlign(): int64; abstract;

    // The callee-saved register a realigned frame keeps its frame in (FrameLayout.Realign),
    // by the arch part's name; the arch part saves it and never allocates it in such a frame
    virtual method FrameRegister(): string; abstract;

    // The OS's stack page in bytes: the stride a probed frame touches its pages at
    // (FrameLayout.ProbeBytes)
    virtual method PageBytes(): int64; abstract;

    // The registers free at a function's first instruction (volatile, no argument and no
    // result in them), by the arch part's name: the arch's stack probe takes its size in the
    // first and may change only these
    virtual method ProbeScratch(): StringArray; abstract;

    // Where the arguments and the result of a call to a routine of ASignature are, and the
    // bytes the caller reserves for them; raises for a void parameter (an IR fault)
    virtual method LayoutCall(const ASignature: ref IrSignature): ref CallLayout; abstract;

    // How a variadic function of ASignature (its own: the fixed parameters, marked
    // Variadic) reaches its variadic arguments: the argument registers it stores at entry,
    // and where the first variadic argument is
    virtual method LayoutVarargs(const ASignature: ref IrSignature): ref VarargsLayout; abstract;

    // How a variadic function reads a variadic aggregate argument of AShape (C's va_arg of
    // a record; a call passes it as LayoutCall places a shaped parameter of a variadic call
    // site's signature)
    virtual method LayoutVariadicAggregate(const AShape: ref IrAggregate): ref VariadicAggregate; abstract;

    // The frame of a function whose locals take ALocalBytes aligned to ALocalAlign, whose
    // calls need AOutgoingBytes (the largest CallLayout.OutgoingBytes; 0 for no call, and
    // for calls that pass nothing on the stack where the ABI reserves no home area), whose
    // prologue saves ASavedCount callee-saved general registers (pushed) and AVectorCount
    // callee-saved vector registers (stored whole into the frame), and that makes a call
    // when AMakesCalls (a caller is never frameless: its calls need the aligned stack)
    virtual method LayoutFrame(const ALocalBytes: int64; const ALocalAlign: int64;
      const AOutgoingBytes: int64; const ASavedCount: int64;
      const AVectorCount: int64; const AMakesCalls: bool): ref FrameLayout; abstract;

    // The registers a callee must give back unchanged
    virtual method CalleeSaved(): StringArray; abstract;

    // The registers a call may change
    virtual method Volatile(): StringArray; abstract;

    // ACode's unwind data written into ASections (the ABI's sections, made on first use);
    // nothing for a function the ABI needs none for; raises (a compiler bug) for what the
    // ABI's unwind data cannot describe
    virtual method WriteUnwind(const ACode: ref FunctionCode; const ASections: ref SectionSet);
      abstract;
  end;

  // The instruction set (see the header)
  ArchPart = object
    // The arch's name as a triple spells it ("x86_64")
    virtual method ArchName(): string; abstract;

    // How many registers the arch has, numbered 0 .. RegisterCount() - 1
    virtual method RegisterCount(): int64; abstract;

    // The name of register ANumber; "" for a number that is no register
    virtual method RegisterText(const ANumber: int64): string; abstract;

    // The number of the register named AName; -1 for a name that is no register
    virtual method RegisterOf(const AName: string): int64; abstract;

    // Function AFunction of AModule generated, by AAbi's convention, into ASections' code
    // section ACode (its symbol defined there, its calls' relocations and imports added);
    // AParent the generated parent of a funclet (nil for any other function), whose frame
    // the funclet reaches the parent's slots in; the FunctionCode carries its slots' offsets
    // and its scopes. Raises (a compiler bug) for what the arch cannot generate
    virtual method GenerateFunction(const AModule: ref IrModule; const AFunction: int64;
      const AAbi: ref AbiPart; const ASections: ref SectionSet; const ACode: int64;
      const AParent: ref FunctionCode): ref FunctionCode; abstract;

    // The stack probe a probed frame's prologue calls (FrameLayout.ProbeBytes), generated by
    // AAbi's facts (PageBytes, ProbeScratch) into ASections' code section ACode, its symbol
    // internal; once per SectionSet, when a generated function's frame is probed
    virtual method GenerateProbe(const AAbi: ref AbiPart; const ASections: ref SectionSet;
      const ACode: int64): ref FunctionCode; abstract;
  end;

  // One object file a static library holds (M8d): the name a linker reports it by (a
  // unit's name: the format adds its object file ending) and its bytes (an object of the
  // library's format)
  ObjectFile = record
    MemberName: string;
    Bytes: ByteArray;
  end;

  // The objects of one static library, in member order
  ObjectFileArray = array of ObjectFile;

  // The object format (see the header)
  FormatPart = object
    // The format's name ("coff")
    virtual method FormatName(): string; abstract;

    // The name of the section that holds what AKind holds
    virtual method SectionNameOf(const AKind: SectionKind): string; abstract;

    // What an exe's file name ends with (".exe"; "" for a format whose exes have none)
    virtual method ExeExtension(): string; abstract;

    // What a dll's file name ends with (".dll"; linux64's ".so")
    virtual method DllExtension(): string; abstract;

    // What a debug build's debug file beside its image is named with (".pdb"); "" for a
    // format whose image holds its own debug information
    virtual method DebugFileExtension(): string; abstract;

    // The file name of the import library of a dll whose main module is AModuleName, built
    // beside the build's static libraries ("lib<name>.dll.a", what BNF sec 2's library
    // search finds first); "" for a format whose dlls need none (linux64's .so is linked
    // itself)
    virtual method ImportLibraryName(const AModuleName: string): string; abstract;

    // The import library of the dll ADllName exporting ANames (ANames[i] a variable when
    // AData[i]), deterministic; empty for a format whose dlls need none
    virtual method WriteImportLibrary(const ADllName: string; const ANames: StringArray;
      const AData: BoolArray): ByteArray; abstract;

    // ADebug (a debug build's debug information of the module ASections holds) written into
    // ASections as the format's debug sections (SectionKind.Debug: never laid in an image;
    // each function's and each module variable's part a Removable section going with the
    // section its code or storage is in, so link-time removal drops it with them), their
    // relocations naming ASections' symbols; deterministic (M7b: COFF writes CodeView)
    virtual method WriteDebugInfo(const ASections: ref SectionSet; const ADebug: ref DebugModule);
      abstract;

    // ASections as one object file's bytes, deterministic; raises (a compiler bug) for what
    // the format cannot hold
    virtual method WriteObject(const ASections: ref SectionSet): ByteArray; abstract;

    // The bytes of the section named AName in ABytes, an object file of this format, into
    // ASection: false (nothing reported) when ABytes is no such object or has no such
    // section (a compiled unit's payload is read back this way)
    virtual method ReadSection(const ABytes: ByteArray; const AName: string;
      var ASection: ByteArray): bool; abstract;

    // ASection written over the bytes of the section named AName in ABytes, an object file
    // of this format, in place; false (ABytes untouched, nothing reported) when ABytes is no
    // such object, has no such section, or the section holds another byte count (a compiled
    // unit's refreshed payload replaces its old one this way, its code kept as it is)
    virtual method ReplaceSection(var ABytes: ByteArray; const AName: string;
      const ASection: ByteArray): bool; abstract;

    // The name of the Info section a unit's object keeps its imports in (SU2.4: each
    // import's library and name, NUL-ended, in import order; Adam.Backend.Generate's
    // GenerateObject writes it, MergeObject reads it), so a merged unit's imports are the
    // ones its set had
    virtual method ImportListName(): string; abstract;

    // The file name of the static library of a lib whose main module is AModuleName
    // (M8d: "lib<name>.a", what BNF sec 2's library search finds), built into the build's
    // lib part beside the runtime's companion library (StaticLibraryName of
    // ADAM_RUNTIME_LIBRARY)
    virtual method StaticLibraryName(const AModuleName: string): string; abstract;

    // The static library holding AObjects (each an object of this format), in their order,
    // with the symbol index every linker searches it by (each member's defined external
    // symbols); deterministic. Raises (a compiler bug) for an object it cannot read
    virtual method WriteStaticLibrary(const AObjects: ObjectFileArray): ByteArray; abstract;

    // The objects of the static library ABytes (WriteStaticLibrary's, M8d2), in member
    // order, each MemberName as WriteStaticLibrary was given it, into AObjects; false (none)
    // when ABytes is no static library of this format or holds a member that is no object
    virtual method ReadStaticLibrary(const ABytes: ByteArray; var AObjects: ObjectFileArray): bool;
      abstract;

    // The name of the section a blob in APlace of the program's start list goes in
    // (IrData.StartList, M8d: COFF's .CRT$XCA / .CRT$XCU / .CRT$XCZ, the C start list
    // mingw-w64's and MSVC's startup both run and Adam's linker lays in suffix order; M8d2:
    // ThreadCallback COFF's .CRT$XLC, the C TLS callback list); "" for None
    virtual method StartListGroupOf(const APlace: StartListPlace): string; abstract;

    // The unit object ABytes (GenerateObject's, this format's; ALabel names it in
    // reports, at ANode) merged into ASections whole: every section but its Info ones,
    // its symbols defined there (its internal ones its own), its references by name, its
    // imports bound by its import list; a reference or an import whose name ANodes holds
    // is at that node (the declaration that needs it, so the link reports there), any
    // other at ANode. False after a report into ADiagnostics (a damaged object, a second
    // definition)
    virtual method MergeObject(const ASections: ref SectionSet; const ABytes: ByteArray;
      const ALabel: string; const ANode: int64; const ANodes: ref StringIdMap;
      const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics): bool; abstract;

    // ASections linked into an exe entered at the symbol AEntry, the OS calling the symbol
    // AThreadCallback ("" none: IrModule.ThreadCallback's) as each thread starts and ends,
    // its imports' libraries searched in the build's AAddedPaths and then wherever the
    // format's OS keeps its own; a static library's objects linked against ARuntime (the
    // ABI's C runtime); what the program got wrong (an undefined symbol, a name its library
    // lacks) reported at ATree's nodes into ADiagnostics. Empty after a report. ALibraries:
    // the libraries the exe imports, one per library the loader opens, by the name the exe
    // records. ASettings: what the main module asks of the image (ExeSettings), each part
    // the format's OS takes written into it. ADebugFile: the debug file's bytes when
    // ASettings names one (a debug build: the format's own debug file, a PDB for COFF),
    // empty otherwise
    virtual method LinkExe(const ASections: ref SectionSet; const AEntry: string;
      const AThreadCallback: string; const AAddedPaths: StringArray; const ARuntime: ref CRuntimeFacts;
      const ASettings: ref ExeSettings; const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics;
      var ALibraries: StringArray; var ADebugFile: ByteArray): ByteArray; abstract;
  end;

end.
