  ADAM_MSG_SEMANTICS_HIDDEN_OUTSIDE: string = "'{}' is hidden in '{}': only the methods of '{}' and of its descendants reach it";
  ADAM_MSG_SEMANTICS_HIDDEN_THROUGH: string = "'{}' is hidden in '{}': a method of '{}' reaches it only through self or a '{}' value";
