  ADAM_MSG_SEMANTICS_TYPE_NOT_VALUE: string = "'{}' is a type, not a value";
  ADAM_MSG_SEMANTICS_MODULE_NOT_VALUE: string = "'{}' is a module, not a value";
  ADAM_MSG_SEMANTICS_NOT_CALLABLE: string = "'{}' is not callable: its type '{}' is not a routine type";
