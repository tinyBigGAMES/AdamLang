// Adam.Compiler.Semantics (SM codes; PaskalCPP's number where the meaning is the same)
public const
  ADAM_MSG_SEMANTICS_OWN_DECL: string = "'{}' is used in its own declaration";
  ADAM_MSG_SEMANTICS_USED_BEFORE: string = "'{}' is used before its declaration: declare it first or add forward";
