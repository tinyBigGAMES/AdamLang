  // generic, its parameter count, the count given
  ADAM_MSG_SEMANTICS_GENERIC_LINKAGE: string = "the generic '{}' cannot be {}: each instance is its own cpplink routine";
  ADAM_MSG_SEMANTICS_GENERIC_DISPATCH: string = "the generic method '{}' cannot be {}: a slot holds one method, a generic method is one per instance";
  ADAM_MSG_SEMANTICS_TYPE_ARG_COUNT: string = "'{}' takes {} type argument(s), {} given";
  ADAM_MSG_SEMANTICS_NOT_GENERIC: string = "'{}' is not generic: it takes no type arguments";
  ADAM_MSG_SEMANTICS_INSTANCE_DEPTH: string = "generic instances nest past {} deep, each needing a bigger one: {}";
  ADAM_MSG_SEMANTICS_IN_INSTANCE: string = "in the instance '{}' made here";
  ADAM_MSG_SEMANTICS_GENERIC_UNFIXED: string = "the call of '{}' fixes no type for its type parameter '{}': name the type arguments";
  ADAM_MSG_SEMANTICS_GENERIC_VALUE: string = "the generic '{}' is a value only where a routine type gives it its type arguments: give it one, or call it";
  ADAM_MSG_SEMANTICS_GENERIC_VALUE_TYPE: string = "the generic '{}' takes its type arguments from a routine type, not from '{}': give it a routine type, or call it";
  ADAM_MSG_SEMANTICS_GENERIC_VALUE_FIT: string = "no generic '{}' fits the routine type '{}': its parameters and result do not match";
  ADAM_MSG_SEMANTICS_GENERIC_VALUE_UNFIXED: string = "the routine type '{}' fixes no type for the type parameter '{}' of '{}': call it, with its type arguments named";
  ADAM_MSG_SEMANTICS_GENERIC_VALUE_CLASH: string = "the routine type '{}' gives the type parameter '{}' of '{}' two types, '{}' and '{}'";
  ADAM_MSG_SEMANTICS_HASH_NO_OPERATOR: string = "'{}' has no hash: '{}' declares no operator hash (one operand of its type, giving uint64)";
  ADAM_MSG_SEMANTICS_HASH_TYPE: string = "'{}' has no hash: hash(X) takes a value '=' compares by its contents (a number, char, bool, choices value, pointer, text, set, array, or a record or object with an operator hash)";
  ADAM_MSG_SEMANTICS_GENERIC_VALUE_AMBIGUOUS: string = "the routine type '{}' fits more than one generic '{}': call the one meant from a routine of that type";
  ADAM_MSG_SEMANTICS_GENERIC_CLASH: string = "the call of '{}' gives its type parameter '{}' two types, '{}' and '{}': name the type arguments";
  ADAM_MSG_SEMANTICS_FLEX_USE: string = "the flexible array member '{}' has no size: only an index takes it ({}[i]; addr of {}[0] is where it starts)";
  ADAM_MSG_SEMANTICS_INDEX_NOT_INT: string = "an index is an integer, got '{}'";
  ADAM_MSG_SEMANTICS_INDEX_FAMILY: string = "an index of '{}' is a '{}' value, got '{}'";
  // the index, the array type, its low and high bound
  ADAM_MSG_SEMANTICS_INDEX_OUTSIDE: string = "index {} is outside '{}' ({}..{})";
  ADAM_MSG_SEMANTICS_CONDITION: string = "a condition is bool, got '{}'";
  ADAM_MSG_SEMANTICS_NO_CAST: string = "'{}' cannot be cast to '{}'";
  ADAM_MSG_SEMANTICS_NO_POINTER_CAST: string = "'{}' cannot be cast to '{}': a pointer cast takes a pointer that keeps const, or an integer of pointer width";
  ADAM_MSG_SEMANTICS_NOT_ELEMENT: string = "'in': '{}' is not the element type of '{}'";
  ADAM_MSG_SEMANTICS_TYPE_NOT_VALUE: string = "'{}' is a type, not a value";
  ADAM_MSG_SEMANTICS_ARROW_QUALIFIED: string = "'{}' is a module or a type: reach its names with '.'";
  ADAM_MSG_SEMANTICS_MODULE_NOT_VALUE: string = "'{}' is a module, not a value";
  ADAM_MSG_SEMANTICS_NOT_CALLABLE: string = "'{}' is not callable: its type '{}' is not a routine type";
  ADAM_MSG_SEMANTICS_ARG_COUNT: string = "'{}' takes {} argument(s), {} given";
  ADAM_MSG_SEMANTICS_ARG_COUNT_VARIADIC: string = "'{}' takes at least {} argument(s), {} given";
  ADAM_MSG_SEMANTICS_VARIADIC_FIXED: string = "'{}' has C linkage and a body: it needs a fixed parameter before '...' (C reads the extra arguments from the last fixed one)";
  ADAM_MSG_SEMANTICS_VARARGS_OUTSIDE: string = "varargs outside a variadic routine";
  ADAM_MSG_SEMANTICS_VARARGS_CLINK: string = "varargs.{} needs a cpplink variadic: a C caller passes no types or count";
  ADAM_MSG_SEMANTICS_VARARGS_TYPE: string = "'varargs' is only the type of a variadic routine's local, set from a varargs.copy()";
  ADAM_MSG_SEMANTICS_VAR_PARAM: string = "var parameter '{}' needs a variable of type '{}'";
  ADAM_MSG_SEMANTICS_NO_VALUE: string = "'{}' calls a procedure: it has no value";
  ADAM_MSG_SEMANTICS_INTRINSIC_STMT: string = "'{}' is a statement, not a value";
  ADAM_MSG_SEMANTICS_INTRINSIC_SIG: string = "'{}' takes {}";
  ADAM_MSG_SEMANTICS_SIZE_OF_VALUE: string = "size takes a type, and '{}' is a value: write size(its type)";
  ADAM_MSG_SEMANTICS_HIDDEN_INTRINSIC: string = "'{}' is a type, not a value: '{}' here is a routine, which hides the intrinsic of that name";
  ADAM_MSG_SEMANTICS_NO_PROJECT: string = "'{}' is only in a project build: the main module of a project.toml and the units it imports";
  ADAM_MSG_SEMANTICS_CAST_ARGS: string = "a cast '{}(...)' takes exactly one argument, given {}";
  ADAM_MSG_SEMANTICS_RECORD_KIND: string = "a record literal needs a record type, got '{}'";
  ADAM_MSG_SEMANTICS_RECORD_NO_FIELD: string = "record literal: '{}' has no field '{}'";
  ADAM_MSG_SEMANTICS_RECORD_ORDER: string = "record literal: field '{}' comes before '{}' in '{}': give the fields in their declared order";
  ADAM_MSG_SEMANTICS_INTRINSIC_VALUE: string = "'{}' is an intrinsic: it is called, never a value";
  ADAM_MSG_SEMANTICS_NO_EFFECT: string = "statement has no effect: its value is computed and dropped";
  ADAM_MSG_SEMANTICS_EXC_OUTSIDE: string = "{}() reads the exception being handled: it is called inside an except body only";
  ADAM_MSG_SEMANTICS_RECORD_TWICE: string = "record literal: field '{}' is given twice";
  ADAM_MSG_SEMANTICS_A_SET_LITERAL: string = "a set literal";

  // Semantics: the object family (M1.9b)
  ADAM_MSG_SEMANTICS_HIDDEN_OUTSIDE: string = "'{}' is hidden in '{}': only the methods of '{}' and of its descendants reach it";
  ADAM_MSG_SEMANTICS_HIDDEN_THROUGH: string = "'{}' is hidden in '{}': a method of '{}' reaches it only through self or a '{}' value";
  ADAM_MSG_SEMANTICS_TEST_OPERAND: string = "'{}' tests a polymorphic object (one with a virtual method) or a ptr to, own or ref of one; '{}' is '{}'";
  ADAM_MSG_SEMANTICS_TEST_TARGET: string = "'{} {}': '{}' is not an object or an interface type";
  ADAM_MSG_SEMANTICS_TEST_NEVER: string = "'{}' never holds: a '{}' is never a '{}'";
  ADAM_MSG_SEMANTICS_TEST_EXACT: string = "'{}' holds exactly a '{}', never a '{}': only a var or const parameter, a deref, self, or a ptr, own or ref may hold a descendant";
  ADAM_MSG_SEMANTICS_TEST_WEAK: string = "'{}' is a weak: test lock({}) instead";
  ADAM_MSG_SEMANTICS_NEEDS_OVERRIDE: string = "'{}' is virtual in '{}': write 'override method {}'";
  ADAM_MSG_SEMANTICS_PROP_NEEDS_OVERRIDE: string = "'{}' is virtual in '{}': write 'override property {}'";
  ADAM_MSG_SEMANTICS_OVERRIDES_NOTHING: string = "'{}' overrides nothing: no level above '{}' has a virtual method '{}' of these parameter types";
  ADAM_MSG_SEMANTICS_PROP_OVERRIDES_NOTHING: string = "'{}' overrides nothing: no level above '{}' has a virtual property '{}'";
  ADAM_MSG_SEMANTICS_OVERRIDE_SIGNATURE: string = "'{}' must take the parameters and return the type of '{}.{}' it overrides";
  ADAM_MSG_SEMANTICS_PROP_OVERRIDE_TYPE: string = "'{}' must have the type, index and write of '{}.{}' it overrides";
  ADAM_MSG_SEMANTICS_OVERRIDE_FINAL: string = "'{}.{}' is final: it cannot be overridden";
  ADAM_MSG_SEMANTICS_FINAL_NOT_VIRTUAL: string = "'final' closes a virtual method: write 'virtual final method' or 'override final method'";
  ADAM_MSG_SEMANTICS_PROP_FINAL_NOT_VIRTUAL: string = "'final' closes a virtual property: write 'virtual final property' or 'override final property'";
  ADAM_MSG_SEMANTICS_ABSTRACT_NOT_VIRTUAL: string = "an abstract method is virtual: write 'virtual method {}'";
  ADAM_MSG_SEMANTICS_PROP_ABSTRACT_NOT_VIRTUAL: string = "an abstract accessor belongs to a virtual property: write 'virtual property {}'";
  ADAM_MSG_SEMANTICS_ABSTRACT_VALUE: string = "'{}' is abstract ('{}.{}' has no body): it cannot be held by value or created";
  ADAM_MSG_SEMANTICS_INTERFACE_VALUE: string = "'{}' is an interface: it is reached through var, const, ptr to, own or ref, never held by value or created";
  ADAM_MSG_SEMANTICS_FINAL_PARENT: string = "'{}' is final: no type may extend it";
  ADAM_MSG_SEMANTICS_INTERFACE_PARENT: string = "'{}' is an interface: an object never names it as its parent, write 'implements {}'";
  ADAM_MSG_SEMANTICS_OBJECT_PARENT: string = "'{}' is no object type: an object's parent is an object";
  ADAM_MSG_SEMANTICS_NO_PARENT: string = "parent: '{}' has no parent type";
  ADAM_MSG_SEMANTICS_PARENT_MEMBER: string = "parent is written only as parent.<member>: it names an inherited member, it is no value";
  ADAM_MSG_SEMANTICS_RECORD_PARENT: string = "'{}' is no record type: a record's parent is a record";
  ADAM_MSG_SEMANTICS_PARENT_NAME: string = "'{}' is a member name of its parent '{}' or a type above it: a name is unique down the parent chain, but a method may reuse a parent method's and a property a parent property's";
  ADAM_MSG_SEMANTICS_ABSTRACT_CALL: string = "'{}.{}' is abstract: it has no body to call";
  ADAM_MSG_SEMANTICS_NO_DEFAULT_INIT: string = "'{}' has no init without arguments: build it with arguments, {}(...)";
  ADAM_MSG_SEMANTICS_INIT_NOT_OBJECT: string = "'{}' takes no init arguments: only an object has an init";
  ADAM_MSG_SEMANTICS_NO_INIT_TAKES: string = "no init of '{}' takes ({})";
  ADAM_MSG_SEMANTICS_NO_INIT_DECLARED: string = "'{}' declares no init: it is built without arguments";
  ADAM_MSG_SEMANTICS_INIT_AMBIGUOUS: string = "the arguments ({}) fit more than one init of '{}': convert them to pick one";
  ADAM_MSG_SEMANTICS_OWNER_TARGET: string = "'{}': own, ref and weak hold an object, and '{}' is none";
  ADAM_MSG_SEMANTICS_OWN_COPY: string = "'{}' would be copied here, and '{}' cannot be copied: an own moves only from a call, a construction or return of a local";
  ADAM_MSG_SEMANTICS_VALUE_COPY: string = "'{}' would be copied here, and '{}' cannot be copied: give it a copy, or move it (a call, a construction or return of a local)";
  ADAM_MSG_SEMANTICS_COPY_DONE: string = "'{}' ends by a done and declares no copy";
  ADAM_MSG_SEMANTICS_COPY_PART: string = "'{}' holds a '{}' here, which cannot be copied";
  ADAM_MSG_SEMANTICS_COPY_PARAM: string = "a copy takes one const parameter of its own type: copy(const ASource: {})";
  ADAM_MSG_SEMANTICS_COPY_TWICE: string = "'{}' declares a copy already: one copy per type";
  ADAM_MSG_SEMANTICS_COPY_PARENT: string = "'{}' cannot be copied, so its descendant '{}' cannot declare a copy";
  ADAM_MSG_SEMANTICS_DONE_TWICE: string = "'{}' declares done twice: an object has one done";
  ADAM_MSG_SEMANTICS_INIT_BY_NAME: string = "init runs when an object is built: it is never called (only parent.init(...) and self.<field>.init(...) begin an init)";
  ADAM_MSG_SEMANTICS_COPY_BY_NAME: string = "copy runs when an object is copied (:=, a value argument): it is never called";
  ADAM_MSG_SEMANTICS_DONE_BY_NAME: string = "done runs when an object ends: it is never called";
  ADAM_MSG_SEMANTICS_PARENT_INIT_FIRST: string = "parent.init(...) is the first statement of an init";
  ADAM_MSG_SEMANTICS_FIELD_INIT_ORDER: string = "self.{}.init(...) comes after self.{}.init(...): fields are built in declaration order";
  ADAM_MSG_SEMANTICS_FIELD_INIT_TWICE: string = "self.{}.init(...) is written twice: a field is built once";
  ADAM_MSG_SEMANTICS_LEAD_ARG_EARLY: string = "'{}' does not exist yet: the arguments of {}(...) run before the object is built";
  ADAM_MSG_SEMANTICS_PARENT_NEEDS_INIT: string = "'{}' has no init without arguments: begin every init of '{}' with parent.init(...)";
  ADAM_MSG_SEMANTICS_FIELD_NEEDS_INIT: string = "field '{}': '{}' has no init without arguments: begin every init of '{}' with self.{}.init(...)";
  ADAM_MSG_SEMANTICS_VIRTUAL_IN_LIFETIME: string = "'{}' is virtual: in an init, a copy or a done a call does not dispatch, call a plain method or parent.{}()";
  ADAM_MSG_SEMANTICS_COPY_PARENT_INIT: string = "a copy copies the parent part by the parent's own copy: parent.init(...) is not written in a copy";
  ADAM_MSG_SEMANTICS_WEAK_NEW: string = "'{}' builds nothing: a weak watches an object a ref holds (build it with ref {}(...))";
  ADAM_MSG_SEMANTICS_WEAK_MEMBER: string = "'{}.{}': a weak may watch an object that is gone: read it through lock({}), which is nil then";
  ADAM_MSG_SEMANTICS_NOT_INTERFACE: string = "'{}' is not an interface: implements names interfaces only";
  ADAM_MSG_SEMANTICS_IMPLEMENTS_TWICE: string = "'{}' is named twice after implements of '{}'";
  ADAM_MSG_SEMANTICS_MISSING_METHOD: string = "'{}' does not implement '{}.{}': declare virtual method {} with its parameters and result";
  ADAM_MSG_SEMANTICS_MISSING_PROPERTY: string = "'{}' does not implement '{}.{}': declare virtual property {} with its type and accessors";
  ADAM_MSG_SEMANTICS_IMPLEMENTS_PLAIN: string = "'{}.{}' implements '{}.{}': write 'virtual method {}'";
  ADAM_MSG_SEMANTICS_IMPLEMENTS_PLAIN_PROPERTY: string = "'{}.{}' implements '{}.{}': write 'virtual property {}'";
  ADAM_MSG_SEMANTICS_IMPLEMENTS_SIGNATURE: string = "'{}.{}' does not implement '{}.{}': its parameter modes or result differ";
  ADAM_MSG_SEMANTICS_IMPLEMENTS_PROPERTY_SHAPE: string = "'{}.{}' does not implement '{}.{}': its type, index or write differ";
  ADAM_MSG_SEMANTICS_IMPLEMENTS_HIDDEN: string = "'{}.{}' implements '{}.{}': an interface member is never hidden";
  ADAM_MSG_SEMANTICS_IMPLEMENTS_EMBED_SHARED: string = "'{}.{}' is reached through two embeds of '{}', '{}' and '{}': declare virtual method {} to choose one";
  ADAM_MSG_SEMANTICS_INTERFACE_REPEAT: string = "method '{}' of interface '{}' is already declared by its parent '{}'";
  ADAM_MSG_SEMANTICS_EMBED_TYPE: string = "embed '{}' holds '{}': an embed is a record, an overlay or an object, whose members its object reaches";
  ADAM_MSG_SEMANTICS_EMBED_SHARED: string = "'{}' is reached through two embeds, '{}' and '{}': name one, as {}.{}.{}";
  ADAM_MSG_SEMANTICS_PROPERTY_NO_WRITE: string = "property '{}' has no write: it is read-only";
  ADAM_MSG_SEMANTICS_PROPERTY_NO_FIELD: string = "property '{}' binds '{}', which is no field of '{}': name a field, or write the accessor with a body";
  ADAM_MSG_SEMANTICS_PROPERTY_FIELD_TYPE: string = "property '{}' is '{}', and its field '{}' is '{}': a bound field has the property's type";
  ADAM_MSG_SEMANTICS_PROPERTY_DEFAULT_INDEX: string = "property '{}' has no index: default names an indexed property, which X[i] means";
  ADAM_MSG_SEMANTICS_PROPERTY_DEFAULT_TWICE: string = "property '{}' is a second default of '{}': '{}' is its default already";
  ADAM_MSG_SEMANTICS_PROPERTY_READ_CHANGE: string = "the read of '{}' cannot change '{}': a read changes nothing of its object";
  ADAM_MSG_SEMANTICS_PROPERTY_READ_CALL: string = "the read of '{}' cannot call method '{}' through self: a read changes nothing of its object";
  ADAM_MSG_SEMANTICS_PROPERTY_OWN_READ: string = "the read of '{}' reads the property again, forever: read its field";
  ADAM_MSG_SEMANTICS_PROPERTY_OWN_WRITE: string = "the write of '{}' assigns the property again, forever: assign its field";
  ADAM_MSG_SEMANTICS_PROPERTY_STORAGE: string = "'{}' is a property, not storage: {} needs a variable (read it into one, or assign the property)";
  ADAM_MSG_SEMANTICS_MESSAGE: string = "{}";
  ADAM_MSG_SEMANTICS_PROPERTY_ASSIGN_VALUE: string = "an assignment to property '{}' is a statement: its write has no value";
  ADAM_MSG_SEMANTICS_PROPERTY_NEEDS_INDEX: string = "property '{}' is indexed: write {}[<index>]";
  ADAM_MSG_SEMANTICS_CONST_METHOD_CHANGE: string = "'{}' is a const method: it cannot change '{}' (it changes nothing of its object)";
  ADAM_MSG_SEMANTICS_CONST_METHOD_CALL: string = "'{}' is a const method: it cannot call '{}' through self, which is not const";
  ADAM_MSG_SEMANTICS_CONST_DIFFERS: string = "'{}' must be {}, as '{}' of '{}' is: an override or an implementing method keeps the const of the method it continues";
  ADAM_MSG_SEMANTICS_CONST_WORD: string = "a const method";
  ADAM_MSG_SEMANTICS_PLAIN_WORD: string = "a method that is not const";
  ADAM_MSG_SEMANTICS_SLICE: string = "'{}' would be cut down to its '{}' part here (it is polymorphic): pass it var / const, or through a pointer";
  ADAM_MSG_SEMANTICS_SLICE_COPY: string = "'{}' may be a descendant of '{}' here (a var or const parameter, a deref, self or an as): a copy by value would keep only its '{}' part";
  ADAM_MSG_SEMANTICS_SLICE_ASSIGN: string = "'{}' may be a descendant of '{}' here (a var parameter, a deref, self or an as): an assignment would change only its '{}' part";
  ADAM_MSG_SEMANTICS_CONST_OBJECT_METHOD: string = "method '{}' may change its object, which is const here: pass it var";
  ADAM_MSG_SEMANTICS_NO_SELF: string = "'{}' names no object here: only a method, an init, a copy, a done or a property accessor of a type has one";
  ADAM_MSG_SEMANTICS_OPERATOR_NO_SELF: string = "'{}' names no object here: an operator has no self, its operands are its parameters";

  // Semantics: declared operators (BNF sec 4 operator decl, PLAN-OBJECT O11)
  ADAM_MSG_SEMANTICS_OPERATOR_ARITY: string = "operator '{}' takes {}";
  ADAM_MSG_SEMANTICS_OPERATOR_TWO: string = "two operands";
  ADAM_MSG_SEMANTICS_OPERATOR_MINUS: string = "one operand (the unary minus) or two";
  ADAM_MSG_SEMANTICS_OPERATOR_ONE: string = "one operand";
  ADAM_MSG_SEMANTICS_OPERATOR_OWN_TYPE: string = "operator '{}' of '{}' takes no '{}': one of its operands is the type that declares it";
  ADAM_MSG_SEMANTICS_OPERATOR_BOOL: string = "operator '{}' gives a bool, not '{}'";
  ADAM_MSG_SEMANTICS_OPERATOR_HASH: string = "operator 'hash' gives a uint64, not '{}'";
  ADAM_MSG_SEMANTICS_OPERATOR_TWICE: string = "operator '{}' of '{}' is declared twice with these operand types";
  ADAM_MSG_SEMANTICS_OPERATOR_HERE: string = "operator '{}' of '{}' is declared here";
  ADAM_MSG_SEMANTICS_OPERATOR_VAR: string = "operator '{}' takes its operands by value or const, not var ('{}')";
  ADAM_MSG_SEMANTICS_OPERATOR_PAIR: string = "operator '{}' of '{}' needs its pair: declare operator '{}' with the same operand types";
  ADAM_MSG_SEMANTICS_OPERATOR_NONE: string = "no operator '{}' declared for these operands takes ({})";
  ADAM_MSG_SEMANTICS_OPERATOR_AMBIGUOUS: string = "several operators '{}' take ({}) alike: give the operands their exact parameter types";
  ADAM_MSG_SEMANTICS_OPERATOR_TAKES: string = "operator '{}' of '{}' takes ({})";

  // Semantics: statements (M1.9b; the for rules M3.3c1; the match rules M3.3d1)
  ADAM_MSG_SEMANTICS_FOR_NOT_VAR: string = "for needs a variable: '{}' is {}";
  ADAM_MSG_SEMANTICS_FOR_TYPE: string = "a for iterator is an integer, char, wchar or a choice, got '{}'";
  ADAM_MSG_SEMANTICS_MATCH_SUBJECT: string = "a match subject is an integer, char, wchar, a choice, a string or a wstring, got '{}'";
  ADAM_MSG_SEMANTICS_LOCK_SUBJECT: string = "{} takes a mutex variable, field or element, not '{}'";
  ADAM_MSG_SEMANTICS_MUTEX_PARAM: string = "parameter '{}' of type '{}' holds a mutex, which is never copied: make it a var parameter";
  ADAM_MSG_SEMANTICS_MUTEX_RESULT: string = "'{}' returns '{}', which holds a mutex: a mutex is never copied";
  ADAM_MSG_SEMANTICS_MUTEX_INIT: string = "variable '{}' of type '{}' holds a mutex: it starts unlocked and takes no initializer";
  ADAM_MSG_SEMANTICS_MUTEX_ASSIGN: string = "'{}' of type '{}' holds a mutex, which is never assigned";
  ADAM_MSG_SEMANTICS_LABEL_RANGE: string = "match label {} is outside '{}': it never matches";
  ADAM_MSG_SEMANTICS_LABEL_REPEAT: string = "match label {} repeats label {} (first at line {})";
  ADAM_MSG_SEMANTICS_STRING_LABEL_RANGE: string = "a match on '{}' takes one string per label, not a range";
  // print / println (PaskalCPP's RSSemCallUnprintable, RSSemCallNoAddress,
  // RSSemCallFormatMismatch, word for word; the mismatch's third hole is the literal
  // braces). FORMAT_NOT_STRING is Adam's own: any string is a format (M3.8i)
  ADAM_MSG_SEMANTICS_PRINT_UNPRINTABLE: string = "'{}' cannot be printed: print the fields of a record, object or overlay";
  ADAM_MSG_SEMANTICS_PRINT_NO_ADDRESS: string = "'{}' cannot be printed: an overload set or a method has no single address";
  ADAM_MSG_SEMANTICS_FORMAT_MISMATCH: string = "format string {} does not fit the {} argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type";
  ADAM_MSG_SEMANTICS_FORMAT_NOT_STRING: string = "format string '{}' is of type '{}', not string: print, println and FormatStr take their format as a string";
  ADAM_MSG_SEMANTICS_NOT_COVERED: string = "match on '{}' does not cover: {}";
  ADAM_MSG_SEMANTICS_ITERATOR_WRITE: string = "'{}' is the for iterator: the loop body cannot write it";
  // What a for iterator's name is when it is no variable (SM0600's second part)
  ADAM_MSG_SEMANTICS_KIND_CONST: string = "a constant";
  ADAM_MSG_SEMANTICS_KIND_CONST_PARAM: string = "a const parameter";
  ADAM_MSG_SEMANTICS_KIND_TYPE: string = "a type";
  ADAM_MSG_SEMANTICS_KIND_ROUTINE: string = "a routine";
  ADAM_MSG_SEMANTICS_KIND_OTHER: string = "not a variable";
  ADAM_MSG_SEMANTICS_LEAVE_OUTSIDE: string = "leave outside a loop or match";
  ADAM_MSG_SEMANTICS_SKIP_OUTSIDE: string = "skip outside a loop";
  ADAM_MSG_SEMANTICS_JUMP_FINALLY: string = "{} cannot jump out of finally";
  ADAM_MSG_SEMANTICS_JUMP_DEFER: string = "{} cannot jump out of a defer statement";
  ADAM_MSG_SEMANTICS_DEFER_DECL: string = "a defer statement defers a statement, never a declaration";
  ADAM_MSG_SEMANTICS_YIELD_OUTSIDE: string = "yield outside a generator (a routine whose result is a sequence)";
  ADAM_MSG_SEMANTICS_YIELD_INNER: string = "yield cannot hand a value out of an async block or a for parallel's body";
  ADAM_MSG_SEMANTICS_GENERATOR_RETURN: string = "a generator's return takes no value: yield hands its values out";
  ADAM_MSG_SEMANTICS_GENERATOR_VAR: string = "generator '{}' cannot take var parameter '{}': its body runs after the call has returned";
  ADAM_MSG_SEMANTICS_GENERATOR_VARARGS: string = "generator '{}' cannot take varargs: its body runs after the call has returned";
  ADAM_MSG_SEMANTICS_FOR_IN_SUBJECT: string = "for in walks a sequence, an array, a string, a wstring or a set, not '{}'";
  ADAM_MSG_SEMANTICS_FOR_IN_TYPE: string = "for in variable '{}' is a '{}', but the elements are '{}'";
  ADAM_MSG_SEMANTICS_YIELD_FROM_SUBJECT: string = "yield from walks a sequence, an array, a string, a wstring or a set, not '{}'";
  ADAM_MSG_SEMANTICS_YIELD_FROM_TYPE: string = "yield from hands out '{}' elements, but the generator yields '{}'";
  ADAM_MSG_SEMANTICS_RETURN_NEEDS: string = "return needs a value of type '{}'";
  ADAM_MSG_SEMANTICS_RETURN_NO_VALUE: string = "return takes no value here";
  ADAM_MSG_SEMANTICS_EXIT_CODE_HOST: string = "a {} writes 'ExitCode', but the exit code is its host program's, which this write may not reach";
  ADAM_MSG_SEMANTICS_MISSING_RETURN: string = "missing return: '{}' can reach its end without returning a value";
  ADAM_MSG_SEMANTICS_UNREACHABLE: string = "unreachable statement: the statement before it ends the path (return, raise, leave, skip, a noreturn call or an endless loop), so it and what follows never run";
  ADAM_MSG_SEMANTICS_NORETURN_END: string = "'{}' is noreturn but its body can reach its end";
  ADAM_MSG_SEMANTICS_NORETURN_RETURN: string = "return in '{}', which is noreturn: it never returns to its caller";

  // Semantics: constants, overloads (M1.10; the position words fill NOT_CONSTANT's hole)
  ADAM_MSG_SEMANTICS_NOT_CONSTANT: string = "{} must be a constant";
