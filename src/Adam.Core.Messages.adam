-------------------------------------------------------------------------------
  Adam.Core.Messages.adam - Every text a diagnostic shows the user

  Resourcestrings in waiting (projects\Adam\PROJECT.md, Objects and
  Diagnostics): one const block per owning unit, holding message texts and
  nothing else. A text is read only at run time, through
  Adam.Compiler.Diagnostics: never in a constant expression, a match label,
  a bound, a size or another constant. Its arguments are positional `{}`
  holes, filled by Diagnostics when the diagnostic is printed.
*******************************************************************************/

module unit Adam.Core.Messages;

// Adam.Compiler.Diagnostics
public const
  ADAM_MSG_DIAGNOSTICS_HINT: string = "Hint";
  ADAM_MSG_DIAGNOSTICS_WARNING: string = "Warning";
  ADAM_MSG_DIAGNOSTICS_ERROR: string = "Error";
  ADAM_MSG_DIAGNOSTICS_FATAL: string = "Fatal";
  ADAM_MSG_DIAGNOSTICS_AT: string = "{}({},{}): {} {}: {}";
  ADAM_MSG_DIAGNOSTICS_IN_FILE: string = "{}: {} {}: {}";
  ADAM_MSG_DIAGNOSTICS_NO_PLACE: string = "{} {}: {}";
  ADAM_MSG_DIAGNOSTICS_BUDGET: string = "the error budget ({}) is reached; later errors are not shown";
  ADAM_MSG_DIAGNOSTICS_BAD_CODE: string = "internal: '{}' is not a diagnostic code (two capitals, four digits)";
  ADAM_MSG_DIAGNOSTICS_ARG_COUNT: string = "internal: the message of {} does not fit its arguments (holes: {}, arguments: {})";

