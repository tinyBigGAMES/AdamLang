  ADAM_MSG_SEMANTICS_BARE_CHOICE: string = "'{}' is a choice value: write {}.{}";
  ADAM_MSG_SEMANTICS_BARE_MEMBER: string = "'{}' is a member of '{}': write self.{}";
  ADAM_MSG_SEMANTICS_UNDECLARED: string = "'{}' is not declared";

  // Semantics: types (M1.9)
  ADAM_MSG_SEMANTICS_NO_MEMBER: string = "'{}' has no member '{}'";
  ADAM_MSG_SEMANTICS_BAD_STRING_AS: string = "invalid string literal for '{}': {}";
  ADAM_MSG_SEMANTICS_BAD_CHAR_AS: string = "invalid character literal for '{}': {}";
