  ADAM_MSG_SEMANTICS_NOT_FIT: string = "{} does not fit in '{}' ({}..{})";
  ADAM_MSG_SEMANTICS_OP_ONE: string = "operator '{}' does not take '{}'";
  ADAM_MSG_SEMANTICS_OP_TWO: string = "operator '{}' does not take '{}' and '{}'";
  ADAM_MSG_SEMANTICS_DOT_ON_POINTER: string = "'{}' is a pointer: write {}^.{} or {}->{}";
  ADAM_MSG_SEMANTICS_NOT_COMPARABLE: string = "operator '{}' cannot compare '{}': records and overlays are not comparable, compare their fields";
  ADAM_MSG_SEMANTICS_OBJECT_NOT_COMPARABLE: string = "operator '{}' cannot compare '{}': an object compares only through an operator its type declares";
  ADAM_MSG_SEMANTICS_UNTYPED_POINTER: string = "'{}' is an untyped ptr and points at no type: cast it to a typed pointer first (ptr to T({}))";
  ADAM_MSG_SEMANTICS_NO_ADDRESS: string = "'{}' has no address: only a variable, a field, an element or a dereference has one";
