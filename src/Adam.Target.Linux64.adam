-------------------------------------------------------------------------------
  Adam.Target.Linux64.adam - x86_64-linux-gnu, the second target

  Linux64Target the Target interface (Adam.Target) for x86_64 Linux, the
                System V AMD64 psABI over glibc, as clang lays it out for
                x86_64-linux-gnu (PLAN-LINUX64, DESIGN sec 6):
                - Scalars: int8 uint8 bool char 1, int16 uint16 2, int32
                  uint32 float32 wchar 4, int64 uint64 clong culong float64
                  ptr 8, each aligned to its size. A pointer is 8, aligned
                  8. A mutex is 16, aligned 8 (System.Runtime's MutexWords,
                  the same record on every target).
                - C++ types (LP64): int64 is long (int64_t), clong / culong
                  are long / unsigned long (C's long is 8 bytes), wchar is
                  wchar_t (signed, 32 bits on Linux), char is char (signed
                  on x86_64), int8 signed char.
                - Bitfields by the System V rule (Itanium: gcc's and clang's
                  on this triple).
                - Symbols by the Itanium C++ ABI, as clang writes them for
                  this triple.
                - A shared object ends .so; an ELF import needs no
                  dllimport; no version resource, no gui subsystem.
                - C's va_list is a one-element array of a 24-byte record
                  (gp_offset, fp_offset, overflow_arg_area, reg_save_area),
                  never a plain pointer.
*******************************************************************************/

module unit Adam.Target.Linux64;

import Adam.Core.Common, Adam.Target;

public const
  // The triple this target builds for
  ADAM_TARGET_LINUX64_TRIPLE: string = "x86_64-linux-gnu";
  // A pointer's size and alignment
  ADAM_TARGET_LINUX64_POINTER: int64 = 8;
  // C's long (LP64)
  ADAM_TARGET_LINUX64_C_LONG: int64 = 8;
  // C's wchar_t: 32 bits on Linux
  ADAM_TARGET_LINUX64_WCHAR: int64 = 4;
  // A mutex (BNF sec 4): System.Runtime's MutexWords, a state and a count (int32 each)
  // and the owner (a pointer-sized word), aligned as the owner
  ADAM_TARGET_LINUX64_MUTEX_SIZE: int64 = 16;
  ADAM_TARGET_LINUX64_MUTEX_ALIGN: int64 = 8;
  // The stack's alignment at a call (the System V AMD64 psABI)
  ADAM_TARGET_LINUX64_STACK_ALIGN: int64 = 16;
  // One place of the variadic overflow area (the System V AMD64 psABI: every argument
  // passed in memory takes a multiple of 8 bytes)
  ADAM_TARGET_LINUX64_VARIADIC_SLOT: int64 = 8;
  // The psABI's va_list record (3.5.7, Figure 3.33) and its register save area (Figure
  // 3.32: six integer registers, 8 bytes each, then eight vector registers, 16 bytes
  // each); Adam.SysV.ABI lays the area out by the same facts
  ADAM_TARGET_LINUX64_VA_GP_AT: int64 = 0;
  ADAM_TARGET_LINUX64_VA_FP_AT: int64 = 4;
  ADAM_TARGET_LINUX64_VA_OVERFLOW_AT: int64 = 8;
  ADAM_TARGET_LINUX64_VA_AREA_AT: int64 = 16;
  ADAM_TARGET_LINUX64_VA_GP_END: int64 = 48;
  ADAM_TARGET_LINUX64_VA_FP_END: int64 = 176;
  ADAM_TARGET_LINUX64_VA_FP_STEP: int64 = 16;
  ADAM_TARGET_LINUX64_VA_LIST_BYTES: int64 = 24;
  ADAM_TARGET_LINUX64_VA_LIST_ALIGN: int64 = 8;
  // x86_64's widest alignment: an SSE vector's 16 bytes (__BIGGEST_ALIGNMENT__)
  ADAM_TARGET_LINUX64_BIGGEST_ALIGN: int64 = 16;
  // The unit of this target's platform routines (over glibc), under System.Runtime
  ADAM_TARGET_LINUX64_RUNTIME_UNIT: string = "System.Runtime.Linux64";

public type
  // x86_64-linux-gnu (see the header)
  Linux64Target = object(Target)
    override method Triple(): string;
    begin
      return ADAM_TARGET_LINUX64_TRIPLE;
    end;

    // A build names it (-t x86_64-linux-gnu, @target), never the default on this compiler
    override method IsDefault(): bool;
    begin
      return false;
    end;

    override method BuiltinSize(const AName: string): int64;
    begin
      if (AName = "int8") or (AName = "uint8") or (AName = "bool") or (AName = "char") then
        return 1;
      end;
      if (AName = "int16") or (AName = "uint16") then
        return 2;
      end;
      if (AName = "int32") or (AName = "uint32") or (AName = "float32") then
        return 4;
      end;
      if AName = "wchar" then
        return ADAM_TARGET_LINUX64_WCHAR;
      end;
      if (AName = "int64") or (AName = "uint64") or (AName = "float64") or (AName = "ptr") then
        return 8;
      end;
      if (AName = "clong") or (AName = "culong") then
        return ADAM_TARGET_LINUX64_C_LONG;
      end;
      if AName = "mutex" then
        return ADAM_TARGET_LINUX64_MUTEX_SIZE;
      end;
      return -1;
    end;

    // Every scalar is aligned to its size on this target; a mutex as its owner word
    override method BuiltinAlign(const AName: string): int64;
    begin
      if AName = "mutex" then
        return ADAM_TARGET_LINUX64_MUTEX_ALIGN;
      end;
      return self.BuiltinSize(AName);
    end;

    override method PointerSize(): int64;
    begin
      return ADAM_TARGET_LINUX64_POINTER;
    end;

    override method PointerAlign(): int64;
    begin
      return ADAM_TARGET_LINUX64_POINTER;
    end;

    // 16 at every call (the System V AMD64 psABI)
    override method StackAlign(): int64;
    begin
      return ADAM_TARGET_LINUX64_STACK_ALIGN;
    end;

    // The System V psABI: an argument in the overflow area takes 8 bytes (VarargsSave: the
    // register save area comes first)
    override method VariadicSlotBytes(): int64;
    begin
      return ADAM_TARGET_LINUX64_VARIADIC_SLOT;
    end;

    // The register save area's va_list (see the constants)
    override method VarargsSave(): VarargsSaveFacts;
    var
      LFacts: VarargsSaveFacts;
    begin
      LFacts.Used := true;
      LFacts.ListBytes := ADAM_TARGET_LINUX64_VA_LIST_BYTES;
      LFacts.ListAlign := ADAM_TARGET_LINUX64_VA_LIST_ALIGN;
      LFacts.GpAt := ADAM_TARGET_LINUX64_VA_GP_AT;
      LFacts.FpAt := ADAM_TARGET_LINUX64_VA_FP_AT;
      LFacts.OverflowAt := ADAM_TARGET_LINUX64_VA_OVERFLOW_AT;
      LFacts.AreaAt := ADAM_TARGET_LINUX64_VA_AREA_AT;
      LFacts.GpEnd := ADAM_TARGET_LINUX64_VA_GP_END;
      LFacts.FpEnd := ADAM_TARGET_LINUX64_VA_FP_END;
      LFacts.FpStep := ADAM_TARGET_LINUX64_VA_FP_STEP;
      return LFacts;
    end;

    // LP64: long is 64 bits
    override method CLongSize(): int64;
    begin
      return ADAM_TARGET_LINUX64_C_LONG;
    end;

    // The x86_64 psABI: plain char is signed
    override method CharSigned(): bool;
    begin
      return true;
    end;

    // wchar_t is a signed 32-bit type on x86_64 Linux
    override method WideCharSigned(): bool;
    begin
      return true;
    end;

    override method BuiltinCppType(const AName: string): string;
    begin
      if AName = "int8" then
        return "signed char";
      end;
      if AName = "uint8" then
        return "unsigned char";
      end;
      if AName = "int16" then
        return "short";
      end;
      if AName = "uint16" then
        return "unsigned short";
      end;
      if AName = "int32" then
        return "int";
      end;
      if AName = "uint32" then
        return "unsigned int";
      end;
      // int64_t / uint64_t are long / unsigned long on LP64 glibc
      if AName = "int64" then
        return "long";
      end;
      if AName = "uint64" then
        return "unsigned long";
      end;
      if AName = "clong" then
        return "long";
      end;
      if AName = "culong" then
        return "unsigned long";
      end;
      if AName = "float32" then
        return "float";
      end;
      if AName = "float64" then
        return "double";
      end;
      if AName = "bool" then
        return "bool";
      end;
      if AName = "char" then
        return "char";
      end;
      if AName = "wchar" then
        return "wchar_t";
      end;
      return "";
    end;

    override method Bitfields(): BitfieldRule;
    begin
      return BitfieldRule.Itanium;
    end;

    override method Mangling(): ManglingScheme;
    begin
      return ManglingScheme.Itanium;
    end;

    // System.Runtime.Linux64: the platform routines over glibc
    override method RuntimeUnit(): string;
    begin
      return ADAM_TARGET_LINUX64_RUNTIME_UNIT;
    end;

    override method DLLExtension(): string;
    begin
      return ADAM_EXT_ELF_SO;
    end;

    // An ELF import is reached by a plain extern (the dynamic linker binds it)
    override method CImportSpec(): string;
    begin
      return "";
    end;

    // An ELF file has no version resource
    override method HasVersionInfo(): bool;
    begin
      return false;
    end;

    // System V's va_list is a one-element array of a 24-byte record
    override method VaListIsPointer(): bool;
    begin
      return false;
    end;

    override method BiggestAlign(): int64;
    begin
      return ADAM_TARGET_LINUX64_BIGGEST_ALIGN;
    end;

    // An ELF executable has no windowed subsystem
    override method HasGUISubsystem(): bool;
    begin
      return false;
    end;

    override method ProgramFormat(): ImageFormat;
    begin
      return ImageFormat.ELF;
    end;

    override method HasIconResource(): bool;
    begin
      return false;
    end;
  end;

end.
