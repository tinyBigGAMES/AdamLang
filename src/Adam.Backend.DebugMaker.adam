-------------------------------------------------------------------------------
  Adam.Backend.DebugMaker.adam - a debug build's debug information built from
  the tree and the generated code (DESIGN sec 9, M7)

  DebugInfoMaker   builds an Adam.Backend.DebugInfo DebugModule: Add(irfunction,
                   code) per generated function (its lines, its parameters,
                   a method's self (IRFunction.SelfSlot: a pointer to its
                   object type) and its locals at their frame offsets),
                   AddGlobals once, then Module; types by TypeOf (a declared
                   type's UniqueName its module-qualified Adam name); a file
                   by a name the same on every machine (DoStableName: `$P:` +
                   its path under the compiler's folder, its path under the
                   project root, else its name)
*******************************************************************************/

module unit Adam.Backend.DebugMaker;

import System.SysUtils, System.IO, System.Collections, Adam.Core.Common, Adam.Core.Containers,
  Adam.Target,
  Adam.Compiler.SourceText, Adam.Compiler.AST, Adam.Compiler.Scopes, Adam.Compiler.Types,
  Adam.Compiler.Layout, Adam.Backend.SSA, Adam.Backend.Parts, Adam.Backend.DebugInfo;

const
  // A name resolved under ADAM_DEBUG_PROGRAM_PREFIX (Adam.Core.Common): its folder is the
  // compiler's (DebugInfoMaker's init)
  ADAM_DEBUG_PROGRAM_NAME: string = "adam";
  // A thunk's kind in its name when its symbol is its routine's own (a variadic routine's
  // forwarder to its core: DebugInfoMaker's DoThunkName)
  ADAM_DEBUG_THUNK_FORWARD: string = ".adam_forward";

// ADir with forward slashes and no trailing one ("" stays "")
func DoBaseDir(const ADir: string): string;
var
  LDir: string;
begin
  LDir := ForwardSlashes(ADir);
  while (len(LDir) > 0) and (LDir[len(LDir) - 1] = '/') do
    LDir := Substring(LDir, 0, len(LDir) - 1);
  end;
  return LDir;
end;

public type
  // Builds a DebugModule (see the header)
  DebugInfoMaker = object
    hidden FTree: ref SyntaxTree;
    hidden FTarget: ref Target;
    hidden FModule: ref DebugModule;
    // FModule.Files' index + 1 by full path
    hidden FFileIds: ref StringIdMap;
    // A debug type's index by its canonical AST type
    hidden FTypeIds: ref Int64Map;
    // A made pointer type's index (DoPointerTo: self's) by its target's index
    hidden FPointerIds: ref Int64Map;
    // A made array view type's index (DoViewTypeOf, AS2) by its dynamic array type
    hidden FViewIds: ref Int64Map;
    // The one-byte unsigned type a set's member bits are typed (0 not made yet)
    hidden FBitType: int64;
    // The compiler's own folder ($P:) and the build's project root ($R:), forward slashes,
    // no trailing one ("" none): DoStableName's bases
    hidden FProgramDir: string;
    hidden FRootDir: string;

    init(const ATree: ref SyntaxTree; const ATarget: ref Target);
    begin
      self.FTree := ATree;
      self.FTarget := ATarget;
      self.FModule := ref DebugModule();
      self.FFileIds := ref StringIdMap(0);
      self.FTypeIds := ref Int64Map(0);
      self.FPointerIds := ref Int64Map(0);
      self.FViewIds := ref Int64Map(0);
      self.FBitType := 0;
      // the folder `$P:` names in this build: resolved as the build resolves it (System.IO,
      // one spelling however the compiler was started), the folder of a name under it
      self.FProgramDir := DoBaseDir(ExtractFileDir(ResolvePath(ADAM_DEBUG_PROGRAM_PREFIX +
        ADAM_DEBUG_PROGRAM_NAME)));
      self.FRootDir := DoBaseDir(ATree.ProjectRoot);
    end;

    property Module: ref DebugModule read FModule;

    // AFile (a full path) as the debug information names it, the same on every machine (a
    // debug file holds no absolute path, AD.7; a shipped std unit's object was built on
    // another): a file under the compiler's own folder (its std and runtime) as `$P:` and
    // its path from there, one under the project root as its path from the root, any
    // other its name alone; forward slashes
    hidden const method DoStableName(const AFile: string): string;
    var
      LFile: string;
    begin
      LFile := ForwardSlashes(AFile);
      if (self.FProgramDir <> "") and StartsText(self.FProgramDir + "/", LFile) then
        return ADAM_DEBUG_PROGRAM_PREFIX + Substring(LFile, len(self.FProgramDir) + 1,
          len(LFile) - len(self.FProgramDir) - 1);
      end;
      if (self.FRootDir <> "") and StartsText(self.FRootDir + "/", LFile) then
        return Substring(LFile, len(self.FRootDir) + 1, len(LFile) - len(self.FRootDir) - 1);
      end;
      return ExtractFileName(LFile);
    end;

    // The file index of AFile (a full path; the model holds its DoStableName), added on
    // its first ask
    hidden method DoFileIndex(const AFile: string): int64;
    var
      LId: int64;
    begin
      LId := self.FFileIds.Find(AFile);
      if LId <> 0 then
        return LId - 1;
      end;
      setlength(self.FModule.Files, len(self.FModule.Files) + 1);
      self.FModule.Files[len(self.FModule.Files) - 1] := self.DoStableName(AFile);
      self.FFileIds.Put(AFile, len(self.FModule.Files));
      return len(self.FModule.Files) - 1;
    end;

    // The kind of a scalar or pointer class (Opaque for any other)
    hidden const method DoScalarKind(const AClass: TypeClass): DebugTypeKind;
    begin
      match AClass of
        TypeClass.SignedInt: return DebugTypeKind.Signed;
        TypeClass.UnsignedInt: return DebugTypeKind.Unsigned;
        TypeClass.Float: return DebugTypeKind.Float;
        TypeClass.Boolean: return DebugTypeKind.Boolean;
        TypeClass.Char: return DebugTypeKind.Char;
        TypeClass.WideChar: return DebugTypeKind.WideChar;
        TypeClass.Pointer: return DebugTypeKind.Pointer;
        TypeClass.UntypedPointer: return DebugTypeKind.Pointer;
        TypeClass.StaticArray: return DebugTypeKind.StaticArray;
        TypeClass.RecordType: return DebugTypeKind.Record;
        TypeClass.OverlayType: return DebugTypeKind.Overlay;
        TypeClass.ObjectType: return DebugTypeKind.Object;
        TypeClass.ChoicesType: return DebugTypeKind.Choices;
        TypeClass.RoutineType: return DebugTypeKind.Routine;
      else
        // every other Adam type is formatted by its name (see the header)
      end;
      return DebugTypeKind.Opaque;
    end;

    // The fields of the aggregate AType (its body's field members, and an object's parent
    // part as a field "parent") added to ADebug
    hidden method DoFields(const AType: int64; const ADebug: ref DebugType);
    var
      LBody: int64;
      LMember: int64;
      LParent: int64;
      LField: ref DebugField;
      LI: int64;
    begin
      LBody := BodyOf(self.FTree, AType);
      if LBody = 0 then
        return;
      end;
      LParent := self.FTree.FirstOf(LBody, NodeRole.Parent);
      if (LParent <> 0) and (self.FTree[LParent].ResolvedDecl <> 0) then
        ADebug.Fields.Add(ref DebugField("parent", self.FTree[LParent].ResolvedOffset,
          self.TypeOf(DeclaredTypeOf(self.FTree, self.FTree[LParent].ResolvedDecl))));
      end;
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if self.FTree[LMember].Kind <> NodeKind.FieldDecl then
          skip;
        end;
        LField := ref DebugField(self.FTree[LMember].Text, self.FTree[LMember].ResolvedOffset,
          self.TypeOf(VariableTypeOf(self.FTree, LMember)));
        if self.FTree[LMember].ResolvedBitWidth > 0 then
          LField.BitOffset := int64(self.FTree[LMember].ResolvedBitOffset);
          LField.BitWidth := int64(self.FTree[LMember].ResolvedBitWidth);
        end;
        ADebug.Fields.Add(LField);
      end;
    end;

    // The values of the choices type AType added to ADebug
    hidden method DoValues(const AType: int64; const ADebug: ref DebugType);
    var
      LBody: int64;
      LValue: int64;
      LI: int64;
    begin
      LBody := BodyOf(self.FTree, AType);
      if LBody = 0 then
        return;
      end;
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LValue := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if self.FTree[LValue].ResolvedConst.Kind = ConstKind.Signed then
          ADebug.Values.Add(ref DebugValue(self.FTree[LValue].Text,
            int64(self.FTree[LValue].ResolvedConst.Bits)));
        end;
      end;
    end;

    // The debug type of the canonical AST type AType (0: none), added on its first ask: its
    // index is kept before its fields are, so a type reaching itself through a pointer
    // takes that index
    method TypeOf(const AType: int64): int64;
    var
      LId: int64;
      LClass: TypeClass;
      LDebug: ref DebugType;
    begin
      if AType = 0 then
        return 0;
      end;
      LId := self.FTypeIds.Find(AType);
      if LId <> 0 then
        return LId;
      end;
      LClass := ClassOf(self.FTree, AType);
      LDebug := ref DebugType(self.DoScalarKind(LClass), TypeText(self.FTree, AType),
        TypeSize(self.FTree, self.FTarget, AType));
      if self.FTree[AType].Kind = NodeKind.TypeDecl then
        LDebug.UniqueName := self.DoModuleName(AType) + "." + LDebug.TypeName;
      end;
      LId := self.FModule.Types.Count;
      self.FModule.Types.Add(LDebug);
      self.FTypeIds.Put(AType, LId);
      match LDebug.Kind of
        DebugTypeKind.Pointer:
          // an untyped ptr's target stays 0
          LDebug.Target := self.TypeOf(TargetOf(self.FTree, AType));
        DebugTypeKind.StaticArray:
          LDebug.Target := self.TypeOf(TargetOf(self.FTree, AType));
          LDebug.Count := ArrayCount(self.FTree, self.FTarget, AType);
        DebugTypeKind.Record, DebugTypeKind.Overlay, DebugTypeKind.Object:
          self.DoFields(AType, LDebug);
        DebugTypeKind.Choices:
          self.DoValues(AType, LDebug);
        DebugTypeKind.Opaque:
          self.DoForm(AType, LClass, LDebug);
      else
        // a scalar or a routine type has no parts
      end;
      return LId;
    end;

    // The form of the opaque AType (of class AClass) as ADebug's first field (see the
    // header): a pointer to its element when it has one, a set's members after it
    hidden method DoForm(const AType: int64; const AClass: TypeClass; const ADebug: ref DebugType);
    var
      LForm: string;
      LElement: int64;
      LPointer: int64;
    begin
      LElement := 0;
      match AClass of
        TypeClass.Text: LForm := ADAM_DEBUG_FORM_STRING;
        TypeClass.WideText: LForm := ADAM_DEBUG_FORM_WSTRING;
        TypeClass.DynamicArray:
          LForm := ADAM_DEBUG_FORM_ARRAY;
          LElement := TargetOf(self.FTree, AType);
        TypeClass.SetType: LForm := ADAM_DEBUG_FORM_SET;
        TypeClass.RefType, TypeClass.OwnType, TypeClass.WeakType:
          LElement := TargetOf(self.FTree, AType);
          if ClassOf(self.FTree, LElement) = TypeClass.InterfaceType then
            // own I / ref I: its itable word, not its object
            LForm := ADAM_DEBUG_FORM_INTERFACE;
            LElement := 0;
          else
            if AClass = TypeClass.RefType then
              LForm := ADAM_DEBUG_FORM_REF;
            else
              if AClass = TypeClass.OwnType then
                LForm := ADAM_DEBUG_FORM_OWN;
              else
                LForm := ADAM_DEBUG_FORM_WEAK;
              end;
            end;
          end;
        TypeClass.InterfaceType: LForm := ADAM_DEBUG_FORM_INTERFACE;
        TypeClass.TaskType: LForm := ADAM_DEBUG_FORM_TASK;
        TypeClass.SequenceType: LForm := ADAM_DEBUG_FORM_SEQUENCE;
      else
        LForm := ADAM_DEBUG_FORM_OTHER;
      end;
      LPointer := 0;
      if LElement <> 0 then
        LPointer := self.DoPointerTo(self.TypeOf(LElement));
      end;
      ADebug.Fields.Add(ref DebugField(ADAM_DEBUG_FORM_PREFIX + LForm, 0, LPointer));
      if AClass = TypeClass.SetType then
        self.DoSetMembers(AType, ADebug);
      end;
    end;

    // The members of the set type AType as one-bit fields of ADebug, by name (a choices
    // value's, false / true, else the number), bit i of the set member low + i; none past
    // ADAM_DEBUG_SET_MEMBER_LIMIT members or when its range is unknown
    hidden method DoSetMembers(const AType: int64; const ADebug: ref DebugType);
    var
      LElement: int64;
      LClass: TypeClass;
      LNames: ref Int64Map;
      LValues: ref DebugType;
      LField: ref DebugField;
      LName: string;
      LLow: int64;
      LHigh: int64;
      LIndex: int64;
      LI: int64;
    begin
      if (not SetRange(self.FTree, self.FTarget, AType, LLow, LHigh)) or
        (LHigh - LLow + 1 > ADAM_DEBUG_SET_MEMBER_LIMIT) then
        return;
      end;
      LElement := SetElementOf(self.FTree, AType);
      LClass := TypeClass.Unknown;
      if LElement <> 0 then
        LElement := CanonicalOf(self.FTree, LElement);
        LClass := ClassOf(self.FTree, LElement);
      end;
      // a choices element's value names by number (the value's index + 1 in its list)
      LNames := ref Int64Map(0);
      LValues := nil;
      if (LElement <> 0) and (LClass = TypeClass.ChoicesType) then
        LValues := self.FModule.Types.Items[self.TypeOf(LElement)];
        for LI := 0 to LValues.Values.Count - 1 do
          LNames.Put(LValues.Values.Items[LI].Number, LI + 1);
        end;
      end;
      if self.FBitType = 0 then
        self.FBitType := self.FModule.Types.Count;
        self.FModule.Types.Add(ref DebugType(DebugTypeKind.Unsigned, "uint8", 1));
      end;
      for LI := 0 to LHigh - LLow do
        LName := IntToStr(LLow + LI);
        if LClass = TypeClass.Boolean then
          LName := BoolToStr(LLow + LI <> 0);
        end;
        LIndex := LNames.Find(LLow + LI);
        if (LValues <> nil) and (LIndex <> 0) then
          LName := LValues.Values.Items[LIndex - 1].ValueName;
        end;
        LField := ref DebugField(LName, LI div 8, self.FBitType);
        LField.BitOffset := LI mod 8;
        LField.BitWidth := 1;
        ADebug.Fields.Add(LField);
      end;
    end;

    // The name of the module ANode is declared in ("" for none)
    hidden const method DoModuleName(const ANode: int64): string;
    var
      LAt: int64;
    begin
      LAt := ANode;
      while LAt <> 0 do
        if self.FTree[LAt].Kind = NodeKind.Module then
          return self.FTree[LAt].Text;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return "";
    end;

    // The debug type of the view a `const array of T` parameter of the dynamic array type
    // AType holds in its slot (BNF sec 6, AS2: Lowering's DoViewParam), made on its first
    // ask: an opaque type of the view's size whose form field (ADAM_DEBUG_FORM_VIEW) is
    // typed a pointer to its element, named as the parameter's type is
    hidden method DoViewTypeOf(const AType: int64): int64;
    var
      LId: int64;
      LDebug: ref DebugType;
    begin
      LId := self.FViewIds.Find(AType);
      if LId <> 0 then
        return LId;
      end;
      LDebug := ref DebugType(DebugTypeKind.Opaque, TypeText(self.FTree, AType), ADAM_ARRAY_VIEW_SIZE);
      LDebug.UniqueName := LDebug.TypeName + " " + ADAM_DEBUG_FORM_VIEW;
      LId := self.FModule.Types.Count;
      self.FModule.Types.Add(LDebug);
      self.FViewIds.Put(AType, LId);
      LDebug.Fields.Add(ref DebugField(ADAM_DEBUG_FORM_PREFIX + ADAM_DEBUG_FORM_VIEW, 0,
        self.DoPointerTo(self.TypeOf(TargetOf(self.FTree, AType)))));
      return LId;
    end;

    // The debug type of a pointer to the debug type ATarget, made on its first ask (a
    // method's self: no AST type names a pointer to its object type)
    hidden method DoPointerTo(const ATarget: int64): int64;
    var
      LId: int64;
      LDebug: ref DebugType;
    begin
      LId := self.FPointerIds.Find(ATarget);
      if LId <> 0 then
        return LId;
      end;
      LDebug := ref DebugType(DebugTypeKind.Pointer,
        "ptr to " + self.FModule.Types.Items[ATarget].TypeName, self.FTarget.PointerSize());
      LDebug.Target := ATarget;
      LId := self.FModule.Types.Count;
      self.FModule.Types.Add(LDebug);
      self.FPointerIds.Put(ATarget, LId);
      return LId;
    end;

    // The Adam name of the declaration ADecl: its module's name, an object type's name for
    // a method, then its own (an init / copy / done, which has none, by its word),
    // dot-joined
    hidden const method DoAdamName(const ADecl: int64): string;
    var
      LName: string;
      LAt: int64;
    begin
      LName := self.FTree[ADecl].Text;
      if LName = "" then
        match self.FTree[ADecl].Kind of
          NodeKind.InitDecl: LName := "init";
          NodeKind.CopyDecl: LName := "copy";
          NodeKind.DoneDecl: LName := "done";
        else
          // every other declaration has its name
        end;
      end;
      LAt := self.FTree.ParentOf(ADecl);
      while LAt <> 0 do
        if self.FTree[LAt].Kind = NodeKind.TypeDecl then
          LName := self.FTree[LAt].Text + "." + LName;
        end;
        if self.FTree[LAt].Kind = NodeKind.Module then
          return self.FTree[LAt].Text + "." + LName;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return LName;
    end;

    // True when ANode is a routine's own declaration (a routine, a method, an operator, an
    // init / copy / done): a function made for it takes its Adam name and place
    // The name of the forwarder AIR's thunk: its routine's Adam name and its kind, the
    // part of its symbol past its routine's (Lowering's suffix: .adam_entry, .adam_outer),
    // or ADAM_DEBUG_THUNK_FORWARD for one under its routine's own symbol; never the
    // routine's own name (a name, a line or a frame finds the routine itself)
    hidden const method DoThunkName(const AIR: ref IRFunction): string;
    var
      LRoutine: string;
    begin
      if not self.DoIsRoutineNode(AIR.Node) then
        return AIR.Symbol;
      end;
      LRoutine := self.FTree[AIR.Node].ResolvedSymbol;
      if (len(AIR.Symbol) > len(LRoutine)) and StartsStr(LRoutine, AIR.Symbol) then
        return self.DoAdamName(AIR.Node) + Substring(AIR.Symbol, len(LRoutine), len(AIR.Symbol) - len(LRoutine));
      end;
      return self.DoAdamName(AIR.Node) + ADAM_DEBUG_THUNK_FORWARD;
    end;

    hidden const method DoIsRoutineNode(const ANode: int64): bool;
    var
      LKind: NodeKind;
    begin
      if ANode = 0 then
        return false;
      end;
      LKind := self.FTree[ANode].Kind;
      return (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.MethodDecl) or
        (LKind = NodeKind.OperatorDecl) or (LKind = NodeKind.InitDecl) or
        (LKind = NodeKind.CopyDecl) or (LKind = NodeKind.DoneDecl);
    end;

    // True when ANode is (or is inside) a local of the routine ARoutine's own var / const
    // section: code made for its slot or initializer runs before the routine's first
    // statement
    hidden const method DoIsRoutineLocal(const ARoutine: int64; const ANode: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
    begin
      if (ARoutine = 0) or (not self.DoIsRoutineNode(ARoutine)) then
        return false;
      end;
      LAt := ANode;
      while (LAt <> 0) and (LAt <> ARoutine) do
        LKind := self.FTree[LAt].Kind;
        if ((LKind = NodeKind.VarDecl) or (LKind = NodeKind.ConstDecl)) and
          (self.FTree.ParentOf(LAt) = ARoutine) then
          return true;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // The 1-based index in ABody (a statement list) of the statement ANode is in (AIndexes:
    // each statement's index by node); 0 when ANode is in none of them
    hidden const method DoStatementIndex(const ABody: int64; const AIndexes: ref Int64Map;
      const ANode: int64): int64;
    var
      LAt: int64;
    begin
      LAt := ANode;
      while (LAt <> 0) and (self.FTree.ParentOf(LAt) <> ABody) do
        LAt := self.FTree.ParentOf(LAt);
      end;
      if LAt = 0 then
        return 0;
      end;
      return AIndexes.Find(LAt);
    end;

    // The index of ACode's row where the body of AIR's routine (or module) starts: the first
    // row of the earliest statement that has code; -1 for a funclet, a function with no body
    // or a body with no code. The rows before it are the routine's setup (its locals', its
    // hidden slots')
    hidden method DoBodyRow(const AIR: ref IRFunction; const ACode: ref FunctionCode;
      const AFunction: ref DebugFunction): int64;
    var
      LIndexes: ref Int64Map;
      LBody: int64;
      LEarliest: int64;
      LIndex: int64;
      LI: int64;
    begin
      if (AIR.Node = 0) or (AFunction.ParentSymbol <> "") then
        return -1;
      end;
      LBody := self.FTree.FirstOf(AIR.Node, NodeRole.Body);
      if LBody = 0 then
        return -1;
      end;
      LIndexes := ref Int64Map(0);
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Statement) - 1 do
        LIndexes.Put(self.FTree.NthOf(LBody, NodeRole.Statement, LI), LI + 1);
      end;
      LEarliest := 0;
      for LI := 0 to ACode.PlaceCount() - 1 do
        LIndex := self.DoStatementIndex(LBody, LIndexes, ACode.PlaceNodeAt(LI));
        if (LIndex > 0) and ((LEarliest = 0) or (LIndex < LEarliest)) then
          LEarliest := LIndex;
        end;
      end;
      if LEarliest = 0 then
        return -1;
      end;
      for LI := 0 to ACode.PlaceCount() - 1 do
        if self.DoStatementIndex(LBody, LIndexes, ACode.PlaceNodeAt(LI)) = LEarliest then
          return LI;
        end;
      end;
      return -1;
    end;

    // True when ANode is an @breakpoint among statements (its nop is a mark)
    hidden const method DoIsMark(const ANode: int64): bool;
    begin
      return (ANode <> 0) and (self.FTree[ANode].Kind = NodeKind.Directive) and
        (self.FTree[ANode].Text = ADAM_DEBUG_BREAKPOINT_LABEL);
    end;

    // ACode's rows into AFunction's (a run of one place merged; the prologue and the setup
    // before the body, AIR's own locals' and hidden slots', are its declaration line's: a stop
    // on entering it lands on its first statement, his word 2026-11-18), each @breakpoint's
    // nop a mark too
    hidden method DoLines(const AIR: ref IRFunction; const ACode: ref FunctionCode;
      const AFunction: ref DebugFunction);
    var
      LPlace: SourcePlace;
      LLast: ref DebugLine;
      LNode: int64;
      LBodyRow: int64;
      LFile: int64;
      LLastName: string;
      LI: int64;
    begin
      LBodyRow := self.DoBodyRow(AIR, ACode, AFunction);
      LFile := -1;
      LLastName := "";
      LLast := nil;
      // the code from the function's start is its own declaration's, whatever node its
      // prologue's first instruction has (none: a module's body)
      if (AIR.Node <> 0) and (AFunction.PrologueEnd > 0) and
        (not self.FTree[AIR.Node].Place.IsNone()) then
        LPlace := self.FTree[AIR.Node].Place;
        LLastName := LPlace.FileName;
        LFile := self.DoFileIndex(LLastName);
        LLast := ref DebugLine(0, int64(LPlace.Line), int64(LPlace.Column), LFile);
        AFunction.Lines.Add(LLast);
      end;
      for LI := 0 to ACode.PlaceCount() - 1 do
        LNode := ACode.PlaceNodeAt(LI);
        // the prologue and the setup before the body (locals, hidden slots) are the
        // function's own declaration's (a module's body: its module's)
        if self.DoIsRoutineLocal(AIR.Node, LNode) or (LI < LBodyRow) or
          ((AIR.Node <> 0) and (ACode.PlaceStartAt(LI) < AFunction.PrologueEnd)) then
          LNode := AIR.Node;
        end;
        LPlace := self.FTree[LNode].Place;
        if LPlace.IsNone() then
          skip;
        end;
        if (LFile < 0) or (LPlace.FileName <> LLastName) then
          LLastName := LPlace.FileName;
          LFile := self.DoFileIndex(LLastName);
        end;
        if (LLast <> nil) and (LLast.Line = int64(LPlace.Line)) and
          (LLast.Column = int64(LPlace.Column)) and (LLast.FileIndex = LFile) then
          skip;
        end;
        LLast := ref DebugLine(ACode.PlaceStartAt(LI), int64(LPlace.Line), int64(LPlace.Column),
          LFile);
        AFunction.Lines.Add(LLast);
        if self.DoIsMark(LNode) then
          AFunction.Marks.Add(ref DebugLine(LLast.Offset, LLast.Line, LLast.Column, LFile));
        end;
      end;
    end;

    // The parameters and locals of the IR function AIR (a method's self first, then every
    // slot made at a parameter's or a variable's declaration, once each) at their offsets in
    // ACode's frame
    hidden method DoVariables(const AModule: ref IRModule; const AIR: ref IRFunction;
      const ACode: ref FunctionCode; const AFunction: ref DebugFunction);
    var
      LSeen: ref Int64Map;
      LBlock: ref IRBlock;
      LInstr: ref IRInstr;
      LKind: NodeKind;
      LOffset: int64;
      LB: int64;
      LI: int64;
    begin
      LSeen := ref Int64Map(0);
      // self: the receiver's pointer (a pointer to its object type, as the method sees it)
      if AIR.SelfSlot <> 0 then
        LOffset := ACode.SlotOffsetOf(AIR.SelfSlot);
        if LOffset >= 0 then
          AFunction.Variables.Add(ref DebugVariable("self", true, LOffset,
            self.DoPointerTo(self.TypeOf(DeclaredTypeOf(self.FTree,
            self.FTree.ParentOf(MethodOwnerOf(self.FTree, AIR.Node)))))));
        end;
      end;
      for LB := 0 to AIR.Blocks.Count - 1 do
        LBlock := AModule.BlockAt(AIR.Blocks.Items[LB]);
        for LI := 0 to LBlock.Instrs.Count - 1 do
          LInstr := AModule.InstrAt(LBlock.Instrs.Items[LI]);
          if (LInstr.Kind <> IROp.Slot) or (LInstr.Node = 0) or (LSeen.Find(LInstr.Node) <> 0) then
            skip;
          end;
          LKind := self.FTree[LInstr.Node].Kind;
          // a variable's hidden holder of C strings (F4) is the compiler's own: never shown
          if ((LKind <> NodeKind.Param) and (LKind <> NodeKind.VarDecl)) or
            IsCTextHolder(self.FTree, LInstr.Node) then
            skip;
          end;
          LOffset := ACode.SlotOffsetOf(LBlock.Instrs.Items[LI]);
          if LOffset < 0 then
            skip;
          end;
          LSeen.Put(LInstr.Node, 1);
          // a const array of T whose slot holds its view (AS2: a slot of the view's size)
          if (LKind = NodeKind.Param) and PassedAsView(self.FTree, LInstr.Node) and
            (LInstr.Imm = ADAM_ARRAY_VIEW_SIZE) then
            AFunction.Variables.Add(ref DebugVariable(self.FTree[LInstr.Node].Text, true, LOffset,
              self.DoViewTypeOf(VariableTypeOf(self.FTree, LInstr.Node))));
            skip;
          end;
          AFunction.Variables.Add(ref DebugVariable(self.FTree[LInstr.Node].Text,
            LKind = NodeKind.Param, LOffset,
            self.TypeOf(VariableTypeOf(self.FTree, LInstr.Node))));
        end;
      end;
    end;

    // The generated function ACode of AModule's IR function AIR added (see the header)
    method Add(const AModule: ref IRModule; const AIR: ref IRFunction; const ACode: ref FunctionCode);
    var
      LFunction: ref DebugFunction;
      LPlace: SourcePlace;
    begin
      LFunction := ref DebugFunction(ACode.Symbol);
      LFunction.ByteCount := ACode.ByteCount;
      if ACode.StepCount > 0 then
        LFunction.PrologueEnd := ACode.StepAt(ACode.StepCount - 1).EndsAt;
      end;
      if (ACode.Frame <> nil) and (ACode.Frame.Realign > 0) then
        LFunction.FrameBase := ACode.Frame.FrameRegister;
      end;
      // compiler-made code passing a call on to its routine: a thunk under its own symbol,
      // so a name, a line or a frame always finds the routine itself
      if AIR.Forwarder then
        LFunction.Thunk := true;
        LFunction.AdamName := self.DoThunkName(AIR);
        self.FModule.Functions.Add(LFunction);
        return;
      end;
      if ACode.ParentCode <> nil then
        LFunction.ParentSymbol := ACode.ParentCode.Symbol;
      else
        if self.DoIsRoutineNode(AIR.Node) then
          LFunction.AdamName := self.DoAdamName(AIR.Node);
        end;
        // An exe's block is its module's own code: named as the module is
        if AIR.ModuleBody then
          LFunction.AdamName := self.FTree[AIR.Node].Text;
        end;
        if AIR.Node <> 0 then
          LPlace := self.FTree[AIR.Node].Place;
          if not LPlace.IsNone() then
            LFunction.FileIndex := self.DoFileIndex(LPlace.FileName);
            LFunction.Line := int64(LPlace.Line);
          end;
        end;
        self.DoVariables(AModule, AIR, ACode, LFunction);
      end;
      self.DoLines(AIR, ACode, LFunction);
      self.FModule.Functions.Add(LFunction);
    end;

    // Every module variable AModule places (a variable's own storage: a Variable or Zeroed
    // blob of its declaration, not declared by another unit; a read-only blob Lowering
    // makes for its use, such as an allocation site's table, is none) added, in the
    // module's order
    method AddGlobals(const AModule: ref IRModule);
    var
      LBlob: ref IRData;
      LGlobal: ref DebugGlobal;
      LPlace: SourcePlace;
      LD: int64;
    begin
      for LD := 1 to AModule.DataCount - 1 do
        LBlob := AModule.DataAt(LD);
        if LBlob.Declared or (LBlob.Node = 0) or (LBlob.StartList <> StartListPlace.None) or
          (LBlob.Kind = IRDataKind.ReadOnly) then
          skip;
        end;
        // a variable's hidden holder of C strings (F4) is the compiler's own: never shown
        if (self.FTree[LBlob.Node].Kind <> NodeKind.VarDecl) or IsCTextHolder(self.FTree, LBlob.Node) then
          skip;
        end;
        LGlobal := ref DebugGlobal(LBlob.Symbol, self.DoAdamName(LBlob.Node),
          self.TypeOf(VariableTypeOf(self.FTree, LBlob.Node)));
        LGlobal.ThreadLocal := LBlob.ThreadLocal;
        LPlace := self.FTree[LBlob.Node].Place;
        if not LPlace.IsNone() then
          LGlobal.FileIndex := self.DoFileIndex(LPlace.FileName);
          LGlobal.Line := int64(LPlace.Line);
        end;
        self.FModule.Globals.Add(LGlobal);
      end;
    end;
  end;

end.
