  ADAM_SEMANTICS_RUNTIME_TASK_CANCELLED_SELF: string = "TaskCancelledSelf";
  // The platform unit's routines (Target.RuntimeUnit, imported by the runtime unit): the one
  // the OS calls for a frame whose unwind data holds a scope table, a guard's catching
