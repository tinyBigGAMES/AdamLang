  ADAM_SEMANTICS_RUNTIME_SPEC_WIDTH: string = "SpecWidth";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_INT: string = "SinkSpecInt";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_BOOL: string = "SinkSpecBool";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_CHAR: string = "SinkSpecChar";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_ADDRESS: string = "SinkSpecAddress";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_CHOICE: string = "SinkSpecChoice";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_STR: string = "SinkSpecStr";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_WIDE_TEXT: string = "SinkSpecWideText";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_WIDE_CHAR: string = "SinkSpecWideChar";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_C_TEXT: string = "SinkSpecCText";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_WIDE_C_TEXT: string = "SinkSpecWideCText";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_FLOAT32: string = "SinkSpecFloat32";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_FLOAT64: string = "SinkSpecFloat64";
  // A range's element in the debug form where it differs from `?` (M3.8f6)
  ADAM_SEMANTICS_RUNTIME_WRITE_DEBUG_WIDE_CHAR: string = "SinkDebugWideChar";
  ADAM_SEMANTICS_RUNTIME_WRITE_DEBUG_C_TEXT: string = "SinkDebugCText";
  ADAM_SEMANTICS_RUNTIME_WRITE_DEBUG_WIDE_C_TEXT: string = "SinkDebugWideCText";
  // The entry's exit handler that waits for every running task (M3.8g0b3)
  ADAM_SEMANTICS_RUNTIME_TASK_WAIT: string = "TaskWait";
  // A typed pack's checked item (next / get / kind) and the choices type kind(I) answers
  // with (M3.8h, BNF sec 6 varargs expr)
  ADAM_SEMANTICS_RUNTIME_PACK_ITEM: string = "PackItem";
  ADAM_SEMANTICS_RUNTIME_VAR_KIND: string = "VarKind";
  // The threadstatic the compiled code stores an allocation's site id into (M3.12b)
  ADAM_SEMANTICS_RUNTIME_ALLOC_SITE: string = "GAllocSite";
  // The leak tracker's site list node handed over by a debug build's program start (M4.L1,
  // M8d2); the runtime declares it (and GAllocSite) only under `@ifdef DEBUG`
  ADAM_SEMANTICS_RUNTIME_HEAP_SITES: string = "AddHeapSites";
  // The walker of a print / println / FormatStr format known only at run time (M3.8i)
  ADAM_SEMANTICS_RUNTIME_FORMAT_RUN: string = "FormatRun";
  // The index check's raises (M3.11a): a static array's bounds, a block's length
  ADAM_SEMANTICS_RUNTIME_INDEX_FAIL: string = "IndexFail";
  ADAM_SEMANTICS_RUNTIME_INDEX_FAIL_IN: string = "IndexFailIn";
  // The nil owner check's raise (M3.11b): an object reached through a nil ref
  ADAM_SEMANTICS_RUNTIME_NIL_OWNER_FAIL: string = "NilOwnerFail";
  // `is` and a checked `as` over two TypeInfos, a failed `as`'s raise (I1)
  ADAM_SEMANTICS_RUNTIME_IS_INSTANCE: string = "IsInstance";
  ADAM_SEMANTICS_RUNTIME_INVALID_CAST: string = "InvalidCast";
  // An own I / ref I's counts on its object's block, an object's itable word for an
  // interface found at run time (I3)
  ADAM_SEMANTICS_RUNTIME_INTF_ADD_REF: string = "IntfAddRef";
  ADAM_SEMANTICS_RUNTIME_INTF_RELEASE: string = "IntfRelease";
  ADAM_SEMANTICS_RUNTIME_INTF_ASSIGN: string = "IntfAssign";
  ADAM_SEMANTICS_RUNTIME_INTERFACE_OFFSET: string = "InterfaceOffset";
