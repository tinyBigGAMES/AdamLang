  ADAM_ERR_SEMANTICS_755: string = "SM0755";   // a func literal capturing a var parameter or a self that is no ref object's
  ADAM_ERR_SEMANTICS_756: string = "SM0756";   // a func literal reading its routine's varargs
  ADAM_ERR_SEMANTICS_757: string = "SM0757";   // a capturing func literal in a plain func slot
  ADAM_ERR_SEMANTICS_758: string = "SM0758";   // a ref object held as a value (F2a0)
  ADAM_ERR_SEMANTICS_759: string = "SM0759";   // a string stored into a C string place no hidden holder can keep (F4)
  ADAM_ERR_SEMANTICS_760: string = "SM0760";   // a variable holding borrowed strings copied or returned where they are not kept (F4)
  ADAM_ERR_SEMANTICS_761: string = "SM0761";   // a set and an integer cast where a member's value is no bit of it (F6a)
  ADAM_ERR_SEMANTICS_762: string = "SM0762";   // a return in a method returning self that is no 'return self;' (F7)
  ADAM_ERR_SEMANTICS_763: string = "SM0763";   // an override that returns self where the method it overrides does not, or the reverse (F7)
  ADAM_ERR_SEMANTICS_764: string = "SM0764";   // self as a type anywhere but an object method's return type (F7)
  ADAM_ERR_SEMANTICS_765: string = "SM0765";   // a C variadic's argument C cannot take: a managed value other than a string, an object, a closure (CV1)
  ADAM_ERR_SEMANTICS_766: string = "SM0766";   // varargs.next(T) in a clink variadic, T one C cannot pass (CV1)
  ADAM_ERR_SEMANTICS_767: string = "SM0767";   // __adam_closureof / __adam_cthunk over a type that is no plain func type (CB1)
  ADAM_ERR_SEMANTICS_768: string = "SM0768";   // __adam_closureof / __adam_cthunk over a func type of too many parameters (CB1)
  ADAM_ERR_SEMANTICS_741: string = "SM0741";   // hash(X) of a type with no hash (no operator hash, a type = does not compare by its contents)

  // How deep generic instances may nest, each made while making the one around it (BNF
  // sec 10: an instance needing ever bigger ones stops here, the chain named)
  ADAM_SEMANTICS_INSTANCE_DEPTH: int64 = 32;
  // How deep inference walks a parameter type for its type parameters (DoUnify)
  ADAM_SEMANTICS_INFER_DEPTH: int64 = 64;

// AText split at each '.' into AParts (System.SysUtils' SplitString)
func DoSplitDots(const AText: string; var AParts: StringArray);
begin
  AParts := SplitString(AText, ".");
end;

// True for the kinds a type's place takes
func DoIsTypeDecl(const AKind: NodeKind): bool;
begin
  return (AKind = NodeKind.TypeDecl) or (AKind = NodeKind.ForwardType) or
    (AKind = NodeKind.BuiltinTypeDecl) or (AKind = NodeKind.GenericParam);
end;

// True for the version info directives (BNF sec 2 @vi*: stamped only with @addverinfo on)
func DoIsVersionDirective(const ASpelling: string): bool;
begin
  return (ASpelling = "@vimajor") or (ASpelling = "@viminor") or (ASpelling = "@vipatch") or
    (ASpelling = "@viproductname") or (ASpelling = "@videscription") or
    (ASpelling = "@vifilename") or (ASpelling = "@vicompanyname") or
    (ASpelling = "@vicopyright");
end;

// True for the directives that take a constant's name in place of their literal (BNF sec 2,
// user 2026-11-16): the @vi* and @exeicon (the rest: TODO.md 13)
func DoTakesConst(const ASpelling: string): bool;
begin
  return DoIsVersionDirective(ASpelling) or (ASpelling = "@exeicon");
end;

// The constant name a directive ADirective gives in place of its literal (DoTakesConst: a
// NameExpression, or the outermost MemberExpression of a dotted one); 0 for a literal, a
// directive that takes no constant or none
func DoDirectiveConstName(const ATree: ref SyntaxTree; const ADirective: int64): int64;
var
  LArg: int64;
  LKind: NodeKind;
begin
  if not DoTakesConst(ATree[ADirective].Text) or
    (ATree.CountOf(ADirective, NodeRole.Argument) = 0) then
    return 0;
  end;
  LArg := ATree.NthOf(ADirective, NodeRole.Argument, 0);
  LKind := ATree[LArg].Kind;
  if (LKind = NodeKind.NameExpression) or (LKind = NodeKind.MemberExpression) then
    return LArg;
  end;
  return 0;
end;

// The Module node ANode stands in
func DoModuleOf(const ATree: ref SyntaxTree; const ANode: int64): int64;
var
  LAt: int64;
begin
  LAt := ANode;
  while (LAt <> 0) and (ATree[LAt].Kind <> NodeKind.Module) do
    LAt := ATree.ParentOf(LAt);
  end;
  return LAt;
end;

// True when AUse stands under a directive (a directive's constant name, DoDirectiveConstName)
func DoInDirective(const ATree: ref SyntaxTree; const AUse: int64): bool;
var
  LAt: int64;
begin
  LAt := ATree.ParentOf(AUse);
  while (LAt <> 0) and (ATree[LAt].Kind <> NodeKind.Module) do
    if ATree[LAt].Kind = NodeKind.Directive then
      return true;
    end;
    LAt := ATree.ParentOf(LAt);
  end;
  return false;
end;

// True when the two declarations of one scope may share a name: overloads (routines and
// their forwards) and a forward type with its type
func DoMayShare(const AFirst: NodeKind; const ASecond: NodeKind): bool;
var
  LFirstRoutine: bool;
  LSecondRoutine: bool;
begin
  LFirstRoutine := (AFirst = NodeKind.RoutineDecl) or (AFirst = NodeKind.ForwardRoutine);
  LSecondRoutine := (ASecond = NodeKind.RoutineDecl) or (ASecond = NodeKind.ForwardRoutine);
  if LFirstRoutine and LSecondRoutine then
    return true;
  end;
  return ((AFirst = NodeKind.ForwardType) and (ASecond = NodeKind.TypeDecl)) or
    ((AFirst = NodeKind.TypeDecl) and (ASecond = NodeKind.ForwardType));
end;

// The Error ACode at APlace (ATemplate filled with AArgs); inside the generic instance
// AInstance (0: in none, kept as given) it is kept once (Diagnostics.Holds: the template
// or another instance said it already, BNF sec 10), then SM0737, a hint at the use that
// made each instance it lies in, the innermost first
public func ReportInInstance(const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics;
  const AInstance: int64; const ACode: string; const APlace: SourcePlace; const ATemplate: string;
  const AArgs: MessageArgs);
var
  LAt: int64;
begin
  if AInstance = 0 then
    ADiagnostics.Add(Severity.Error, ACode, APlace, ATemplate, AArgs);
    return;
  end;
  if ADiagnostics.Holds(ACode, APlace, ATemplate, AArgs) then
    return;
  end;
  ADiagnostics.Add(Severity.Error, ACode, APlace, ATemplate, AArgs);
  LAt := AInstance;
  while LAt <> 0 do
    ADiagnostics.Add(Severity.Hint, ADAM_ERR_SEMANTICS_737, ATree[LAt].NamePlace,
      ADAM_MSG_SEMANTICS_IN_INSTANCE, NoArgs().Str(InstanceText(ATree, LAt)));
    LAt := InstanceAbove(ATree, ATree.ParentOf(LAt));
  end;
end;

public type
  // One resolution pass over a tree (see the header)
  NameResolver = object
    hidden FTree: ref SyntaxTree;
    hidden FDiagnostics: ref Diagnostics;
    // The generic instances being made, outermost first (DoMakeInstance: each is resolved
    // while the one before it is; a TypeChecker typing one adds it: EnterInstance)
    hidden FChain: ref NodeList;
    // Every generic instance made, in the order made (a TypeChecker types the ones its
    // resolver makes: MadeCount / MadeAt)
    hidden FMade: ref NodeList;

    init(const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics);
    begin
      self.FTree := ATree;
      self.FDiagnostics := ADiagnostics;
      self.FChain := ref NodeList();
      self.FMade := ref NodeList();
    end;

    // The instance of the generic routine or method ADecl over the canonical types AArgs
    // (one per type parameter, BNF sec 10), found or made for AUse (DoMakeInstance, its
    // clone resolved whole); 0 past the depth limit (SM0736 reported)
    method RoutineInstance(const ADecl: int64; const AArgs: ref NodeList; const AUse: int64): int64;
    var
      LKey: string;
      LInstance: int64;
    begin
      LKey := InstanceKey(ADecl, AArgs);
      LInstance := self.FTree.InstanceFor(LKey);
      if LInstance = 0 then
        LInstance := self.DoMakeInstance(ADecl, AArgs, LKey, AUse);
      end;
      return LInstance;
    end;

    // The clink adapter of the generic routine ADecl over AArgs (BNF sec 10, user
    // 2026-11-17): what a generic named as a value fills a clink routine slot with. A
    // second instance, keyed apart from RoutineInstance's, its clone flagged Clink (no
    // Cpplink): C's parameter passing (Types.IsCppSignature), its symbol the instance's
    // under the reserved prefix (Symbols); 0 past the depth limit
    method ClinkInstance(const ADecl: int64; const AArgs: ref NodeList; const AUse: int64): int64;
    var
      LKey: string;
      LInstance: int64;
      LClone: int64;
    begin
      // apart from the cpplink instance of the same generic and type arguments
      LKey := InstanceKey(ADecl, AArgs) + ADAM_TYPES_CLINK_KEY;
      LInstance := self.FTree.InstanceFor(LKey);
      if LInstance = 0 then
        LInstance := self.DoMakeInstance(ADecl, AArgs, LKey, AUse);
        if LInstance <> 0 then
          LClone := self.FTree.FirstOf(LInstance, NodeRole.Instance);
          self.FTree[LClone].Flags -= [NodeFlag.Cpplink];
          self.FTree[LClone].AddFlag(NodeFlag.Clink);
        end;
      end;
      return LInstance;
    end;

    // The instance AInstance is being typed (TypeChecker): an instance made meanwhile nests
    // inside it, for the depth limit (DoMakeInstance)
    method EnterInstance(const AInstance: int64);
    begin
      self.FChain.Add(AInstance);
    end;

    // The instance EnterInstance named last is typed
    method LeaveInstance();
    begin
      self.FChain.RemoveLast();
    end;

    // How many generic instances this resolver has made (FMade)
    const method MadeCount(): int64;
    begin
      return self.FMade.Count;
    end;

    // The generic instance this resolver made AIndex-th (0 the first)
    const method MadeAt(const AIndex: int64): int64;
    begin
      return self.FMade.Items[AIndex];
    end;

    // Error ACode at AId's place (ReportInInstance: once, noted, inside an instance)
    hidden method DoError(const AId: int64; const ACode: string; const ATemplate: string;
      const AArgs: MessageArgs);
    begin
      ReportInInstance(self.FTree, self.FDiagnostics, InstanceAbove(self.FTree, AId), ACode,
        self.FTree[AId].Place, ATemplate, AArgs);
    end;

    // Error ACode at AId's name (Node.AtName: a member's name, not where its expression
    // starts), as the type checker's DoErrorName
    hidden method DoErrorName(const AId: int64; const ACode: string; const ATemplate: string;
      const AArgs: MessageArgs);
    begin
      ReportInInstance(self.FTree, self.FDiagnostics, InstanceAbove(self.FTree, AId), ACode,
        self.FTree[AId].AtName(), ATemplate, AArgs);
    end;

    // The name of the module that holds AId ("" outside every module)
    hidden const method DoModuleName(const AId: int64): string;
    var
      LModule: int64;
    begin
      LModule := ModuleOf(self.FTree, AId);
      if LModule = 0 then
        return "";
      end;
      return self.FTree[LModule].Text;
    end;

    // True when the type declaration ADecl may name itself at AUse, inside its own
    // declaration (BNF sec 3: a type is visible only after it, so a self reference needs
    // `forward type`): an object's or an interface's body names its own type anywhere (it
    // is reached by reference), any type's own routines (a method, an operator, an init,
    // a copy, a done, a property accessor) name it in their signature and body
    hidden const method DoMayNameSelf(const ADecl: int64; const AUse: int64): bool;
    var
      LBody: int64;
      LAt: int64;
    begin
      LBody := self.FTree.FirstOf(ADecl, NodeRole.TypeOf);
      if (LBody <> 0) and ((self.FTree[LBody].Kind = NodeKind.ObjectType) or
        (self.FTree[LBody].Kind = NodeKind.InterfaceType)) then
        return true;
      end;
      LAt := self.FTree.ParentOf(AUse);
      while (LAt <> 0) and (LAt <> ADecl) do
        if IsRoutineLike(self.FTree[LAt].Kind) then
          return true;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // The static method AName of the type whose body is ABody (a record's or an object's),
    // or of a type above it (Types.MemberOf); 0 when ABody is no type body or AName names
    // none there (an instance member is SM0018 at the last tries, DoNotFound)
    hidden const method DoStaticNamed(const ABody: int64; const AName: string): int64;
    var
      LKind: NodeKind;
      LDecl: int64;
      LMember: int64;
    begin
      LKind := self.FTree[ABody].Kind;
      if (LKind <> NodeKind.ObjectType) and (LKind <> NodeKind.RecordType) then
        return 0;
      end;
      LDecl := self.FTree.ParentOf(ABody);
      if (LDecl = 0) or ((self.FTree[LDecl].Kind <> NodeKind.TypeDecl) and
        (self.FTree[LDecl].Kind <> NodeKind.ExtendDecl)) then
        return 0;
      end;
      // an extend's own static methods first, then its target's (BNF sec 3, F1)
      LMember := 0;
      if self.FTree[LDecl].Kind = NodeKind.ExtendDecl then
        LMember := FindMember(self.FTree, ABody, AName);
      end;
      if LMember = 0 then
        LMember := MemberOf(self.FTree, DeclaredTypeOf(self.FTree, LDecl), AName);
      end;
      if (LMember <> 0) and (self.FTree[LMember].Kind = NodeKind.MethodDecl) and
        self.FTree[LMember].HasFlag(NodeFlag.Static) then
        return LMember;
      end;
      return 0;
    end;

    // The declaration of AName the scopes enclosing AUse hold before it, innermost first;
    // 0 when none does. One met in its own var / const declaration is SM0001, a type met
    // in its own declaration where it may not name itself (DoMayNameSelf) SM0003, each -1
    // (the fault reported: no later lookup step may report it again)
    hidden method DoOwnScopes(const AUse: int64; const AName: string): int64;
    var
      LAt: int64;
      LFound: int64;
      LKind: NodeKind;
    begin
      LAt := self.FTree.ParentOf(AUse);
      while LAt <> 0 do
        // the type whose method encloses AUse: its static methods, its parents' too
        // (BNF sec 3, J3d), between the method's own scopes and the module's
        if self.FTree[AUse].Kind <> NodeKind.NamedType then
          LFound := self.DoStaticNamed(LAt, AName);
          if LFound <> 0 then
            return LFound;
          end;
        end;
        LFound := FindDeclared(self.FTree, LAt, AName, self.FTree[AUse].StartOffset);
        if LFound <> 0 then
          LKind := self.FTree[LFound].Kind;
          if ((LKind = NodeKind.VarDecl) or (LKind = NodeKind.ConstDecl)) and
            self.FTree.IsAncestor(LFound, AUse) then
            self.DoError(AUse, ADAM_ERR_SEMANTICS_001, ADAM_MSG_SEMANTICS_OWN_DECL,
              NoArgs().Str(AName));
            return -1;
          end;
          if (LKind = NodeKind.TypeDecl) and self.FTree.IsAncestor(LFound, AUse) and
            not self.DoMayNameSelf(LFound, AUse) then
            self.DoError(AUse, ADAM_ERR_SEMANTICS_003, ADAM_MSG_SEMANTICS_TYPE_SELF,
              NoArgs().Str(AName).Str(AName));
            return -1;
          end;
          return LFound;
        end;
        if self.FTree[LAt].Kind = NodeKind.Module then
          return 0;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // A declaration of AName in a scope enclosing AUse that starts after it: SM0002, the
    // name still resolved to it; 0 when none. A directive's constant name is no use before
    // its declaration: the prologue stands above every declaration, and its values are read
    // once the whole module is checked (BNF sec 2, user 2026-11-16: the module's own const)
    hidden method DoLaterScopes(const AUse: int64; const AName: string): int64;
    var
      LAt: int64;
      LFound: int64;
    begin
      LAt := self.FTree.ParentOf(AUse);
      while LAt <> 0 do
        LFound := FindLater(self.FTree, LAt, AName, self.FTree[AUse].StartOffset);
        if LFound <> 0 then
          if not DoInDirective(self.FTree, AUse) then
            self.DoError(AUse, ADAM_ERR_SEMANTICS_002, ADAM_MSG_SEMANTICS_USED_BEFORE,
              NoArgs().Str(AName));
          end;
          return LFound;
        end;
        if self.FTree[LAt].Kind = NodeKind.Module then
          return 0;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // The public declaration of AName in the units AModule imports, the last unit of
    // the clause that exports it winning; 0 when none does (imports are not transitive)
    hidden const method DoImports(const AModule: int64; const AName: string): int64;
    var
      LI: int64;
      LImport: int64;
      LUnit: int64;
      LHidden: int64;
      LFound: int64;
    begin
      for LI := self.FTree.CountOf(AModule, NodeRole.Import) - 1 downto 0 do
        LImport := self.FTree.NthOf(AModule, NodeRole.Import, LI);
        LUnit := self.FTree[LImport].ResolvedUnit;
        if LUnit <> 0 then
          LHidden := 0;
          LFound := FindPublic(self.FTree, LUnit, AName, LHidden);
          if LFound <> 0 then
            return LFound;
          end;
        end;
      end;
      return 0;
    end;

    // The choices type of AModule's own (or, APublicOnly, public) type declarations
    // that has a value AName: that TypeDecl, 0 when none
    hidden const method DoChoiceIn(const AModule: int64; const AName: string;
      const APublicOnly: bool): int64;
    var
      LI: int64;
      LDecl: int64;
      LType: int64;
      LJ: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(AModule, NodeRole.Declaration, LI);
        if (self.FTree[LDecl].Kind = NodeKind.TypeDecl) and
          ((not APublicOnly) or self.FTree[LDecl].HasFlag(NodeFlag.Public)) then
          LType := self.FTree.FirstOf(LDecl, NodeRole.TypeOf);
          if (LType <> 0) and (self.FTree[LType].Kind = NodeKind.ChoicesType) then
            for LJ := 0 to self.FTree.CountOf(LType, NodeRole.Member) - 1 do
              if self.FTree[self.FTree.NthOf(LType, NodeRole.Member, LJ)].Text = AName then
                return LDecl;
              end;
            end;
          end;
        end;
      end;
      return 0;
    end;

    // True when AName is a module's name or the start of a dotted one in AModule: its own
    // (AOwn true) or an import's
    hidden const method DoIsModuleName(const AModule: int64; const AName: string; var AOwn: bool): bool;
    var
      LI: int64;
      LText: string;
    begin
      LText := self.FTree[AModule].Text;
      AOwn := (LText = AName) or StartsStr(AName + ".", LText);
      if AOwn then
        return true;
      end;
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Import) - 1 do
        LText := self.FTree[self.FTree.NthOf(AModule, NodeRole.Import, LI)].Text;
        if (LText = AName) or StartsStr(AName + ".", LText) then
          return true;
        end;
      end;
      return false;
    end;

    // A bare AName no scope holds that is a module's name (or the start of a dotted one)
    // where AUse stands: a module is reached only through its members by its import's own
    // name (BNF sec 1), so pcpp's report for the place is given at AUse: a type's place
    // SM0013, '->' after it SM0014, the program's own module before '.' SM0007, a chain
    // spelling a whole imported module (or a bare one) as a value SM0269. True when it
    // reported
    hidden method DoModuleNameAt(const AUse: int64; const AName: string): bool;
    var
      LModule: int64;
      LOwn: bool;
      LNode: int64;
      LParent: int64;
      LText: string;
    begin
      LModule := ModuleOf(self.FTree, AUse);
      if not self.DoIsModuleName(LModule, AName, LOwn) then
        return false;
      end;
      if self.FTree[AUse].Kind = NodeKind.NamedType then
        self.DoError(AUse, ADAM_ERR_SEMANTICS_013, ADAM_MSG_SEMANTICS_NOT_TYPE, NoArgs().Str(AName));
        return true;
      end;
      LParent := self.FTree.ParentOf(AUse);
      if (LParent <> 0) and (self.FTree[LParent].Kind = NodeKind.MemberExpression) and
        (self.FTree.FirstOf(LParent, NodeRole.Operand) = AUse) then
        if self.FTree[LParent].HasFlag(NodeFlag.Arrow) then
          self.DoError(AUse, ADAM_ERR_SEMANTICS_014, ADAM_MSG_SEMANTICS_ARROW_QUALIFIED,
            NoArgs().Str(AName));
          return true;
        end;
        if LOwn then
          self.DoError(AUse, ADAM_ERR_SEMANTICS_007, ADAM_MSG_SEMANTICS_NOT_MODULE,
            NoArgs().Str(self.FTree[LModule].Text));
          return true;
        end;
      end;
      // The '.' chain from AUse up: the first prefix that spells an imported module whole
      LNode := AUse;
      LText := AName;
      while LText <> "" do
        if self.DoUnitNamed(LModule, LText) <> 0 then
          self.DoError(AUse, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_MODULE_NOT_VALUE,
            NoArgs().Str(LText));
          return true;
        end;
        LParent := self.FTree.ParentOf(LNode);
        if (LParent = 0) or (self.FTree[LParent].Kind <> NodeKind.MemberExpression) or
          self.FTree[LParent].HasFlag(NodeFlag.Arrow) or (self.FTree.FirstOf(LParent, NodeRole.Operand) <> LNode) then
          LText := "";
        else
          LText := LText + "." + self.FTree[LParent].Text;
          LNode := LParent;
        end;
      end;
      return false;
    end;

    // True when an embed of the aggregate type node AType (its own, or an embed's embed,
    // ADepth levels down) holds a member AName, judged on the declarations as written (the
    // names are resolved before the types are canonical): the bare use of a member an embed
    // reaches is SM0018 as its own member's is
    hidden const method DoEmbedHolds(const AType: int64; const AName: string; const ADepth: int64): bool;
    var
      LI: int64;
      LChild: int64;
      LTypeOf: int64;
      LDecl: int64;
      LBody: int64;
    begin
      if (AType = 0) or (ADepth > ADAM_TYPES_MAX_DEPTH) then
        return false;
      end;
      for LI := 0 to self.FTree.CountOf(AType, NodeRole.Member) - 1 do
        LChild := self.FTree.NthOf(AType, NodeRole.Member, LI);
        if self.FTree[LChild].Kind = NodeKind.EmbedDecl then
          LTypeOf := self.FTree.FirstOf(LChild, NodeRole.TypeOf);
          LDecl := 0;
          if LTypeOf <> 0 then
            LDecl := self.FTree[LTypeOf].ResolvedDecl;
          end;
          if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.TypeDecl) then
            LBody := self.FTree.FirstOf(LDecl, NodeRole.TypeOf);
            if (FindMember(self.FTree, LBody, AName) <> 0) or self.DoEmbedHolds(LBody, AName, ADepth + 1) then
              return true;
            end;
          end;
        end;
      end;
      return false;
    end;

    // The last tries for a bare AName no scope holds: an external clause's library name
    // (SM0326: a const string), `self` as a type (SM0764, F7), a module's name
    // (DoModuleNameAt), a choice value (SM0015;
    // in a type's place SM0013), a member of the enclosing method's type, its own or one
    // an embed reaches (SM0018), else SM0021. Always reports
    hidden method DoNotFound(const AUse: int64; const AName: string);
    var
      LModule: int64;
      LChoice: int64;
      LI: int64;
      LUnit: int64;
      LOwner: int64;
      LOwnerName: string;
      LParent: int64;
    begin
      // `self` in a type's place (the parser's NamedType "self", F7)
      if (self.FTree[AUse].Kind = NodeKind.NamedType) and (AName = "self") then
        self.DoError(AUse, ADAM_ERR_SEMANTICS_764, ADAM_MSG_SEMANTICS_SELF_TYPE, NoArgs());
        return;
      end;
      LParent := self.FTree.ParentOf(AUse);
      if (LParent <> 0) and (self.FTree[LParent].Kind = NodeKind.ExternalClause) then
        self.DoError(AUse, ADAM_ERR_SEMANTICS_326, ADAM_MSG_SEMANTICS_LIBRARY_CONST,
          NoArgs().Str(AName));
        return;
      end;
      if self.DoModuleNameAt(AUse, AName) then
        return;
      end;
      LModule := ModuleOf(self.FTree, AUse);
      LChoice := self.DoChoiceIn(LModule, AName, false);
      LI := self.FTree.CountOf(LModule, NodeRole.Import) - 1;
      while (LChoice = 0) and (LI >= 0) do
        LUnit := self.FTree[self.FTree.NthOf(LModule, NodeRole.Import, LI)].ResolvedUnit;
        if LUnit <> 0 then
          LChoice := self.DoChoiceIn(LUnit, AName, true);
        end;
        LI := LI - 1;
      end;
      if LChoice <> 0 then
        if self.FTree[AUse].Kind = NodeKind.NamedType then
          self.DoError(AUse, ADAM_ERR_SEMANTICS_013, ADAM_MSG_SEMANTICS_NOT_TYPE, NoArgs().Str(AName));
          return;
        end;
        self.DoError(AUse, ADAM_ERR_SEMANTICS_015, ADAM_MSG_SEMANTICS_BARE_CHOICE,
          NoArgs().Str(AName).Str(self.FTree[LChoice].Text).Str(AName));
        return;
      end;
      LOwner := MethodOwnerOf(self.FTree, AUse);
      if (LOwner <> 0) and ((FindMember(self.FTree, LOwner, AName) <> 0) or
        self.DoEmbedHolds(LOwner, AName, 0)) then
        LOwnerName := self.FTree[self.FTree.ParentOf(LOwner)].Text;
        self.DoError(AUse, ADAM_ERR_SEMANTICS_018, ADAM_MSG_SEMANTICS_BARE_MEMBER,
          NoArgs().Str(AName).Str(LOwnerName).Str(AName));
        return;
      end;
      self.DoError(AUse, ADAM_ERR_SEMANTICS_021, ADAM_MSG_SEMANTICS_UNDECLARED,
        NoArgs().Str(AName));
    end;

    // The declaration a bare AName at AUse means, in BNF sec 1's order, without the last
    // tries (DoNotFound); 0 when nothing holds it
    hidden method DoLookupBare(const AUse: int64; const AName: string): int64;
    var
      LFound: int64;
    begin
      LFound := self.DoOwnScopes(AUse, AName);
      if LFound <> 0 then
        return LFound;
      end;
      LFound := FindSystem(self.FTree, AName);
      if LFound <> 0 then
        return LFound;
      end;
      LFound := self.DoLaterScopes(AUse, AName);
      if LFound <> 0 then
        return LFound;
      end;
      LFound := self.DoImports(ModuleOf(self.FTree, AUse), AName);
      if LFound <> 0 then
        return LFound;
      end;
      return self.DoRuntimePublic(AName);
    end;

    // The runtime's public declaration of a bare AName (BNF sec 1, user 2026-11-10: in scope in
    // every module with no import, as Delphi's System unit, after the module's imports); 0 when
    // the program has no runtime unit or it holds no public AName (a private one stays unseen)
    hidden const method DoRuntimePublic(const AName: string): int64;
    var
      LHidden: int64;
    begin
      if self.FTree.Runtime = 0 then
        return 0;
      end;
      LHidden := 0;
      return FindPublic(self.FTree, self.FTree.Runtime, AName, LHidden);
    end;

    // The unit the dotted name AParts[0..ALast] names in AModule's import clause; 0 when
    // no import of the clause is that name (or its unit could not be loaded)
    hidden const method DoUnitNamed(const AModule: int64; const AName: string): int64;
    var
      LI: int64;
      LImport: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Import) - 1 do
        LImport := self.FTree.NthOf(AModule, NodeRole.Import, LI);
        if self.FTree[LImport].Text = AName then
          return self.FTree[LImport].ResolvedUnit;
        end;
      end;
      return 0;
    end;

    // AParts[0..ALast] in AModule: the longest prefix AParts[0..k] (k < ALast) naming an
    // imported unit, its k in AAt; the unit, or 0 when no prefix names one
    hidden const method DoLongestUnit(const AModule: int64; const AParts: StringArray;
      const ALast: int64; var AAt: int64): int64;
    var
      LK: int64;
      LUnit: int64;
    begin
      AAt := -1;
      for LK := ALast - 1 downto 0 do
        LUnit := self.DoUnitNamed(AModule, JoinStrings(AParts, ".", 0, LK + 1));
        if LUnit <> 0 then
          AAt := LK;
          return LUnit;
        end;
      end;
      return 0;
    end;

    // AName as a member of the unit AUnit, at AUse: the public declaration (into
    // ResolvedDecl); SM0006 when it is held private, SM0005 when not held
    hidden method DoUnitMember(const AUse: int64; const AUnit: int64; const AName: string): int64;
    var
      LFound: int64;
      LHidden: int64;
    begin
      LHidden := 0;
      LFound := FindPublic(self.FTree, AUnit, AName, LHidden);
      if LFound <> 0 then
        self.FTree[AUse].ResolvedDecl := LFound;
        return LFound;
      end;
      if LHidden <> 0 then
        self.DoErrorName(AUse, ADAM_ERR_SEMANTICS_006, ADAM_MSG_SEMANTICS_NOT_PUBLIC,
          NoArgs().Str(AName).Str(self.FTree[AUnit].Text));
      else
        self.DoErrorName(AUse, ADAM_ERR_SEMANTICS_005, ADAM_MSG_SEMANTICS_UNIT_NO_NAME,
          NoArgs().Str(self.FTree[AUnit].Text).Str(AName));
      end;
      return 0;
    end;

    // A bare name AUse (a NameExpression)
    hidden method DoName(const AUse: int64);
    var
      LFound: int64;
    begin
      LFound := self.DoLookupBare(AUse, self.FTree[AUse].Text);
      if LFound < 0 then
        return;
      end;
      if LFound = 0 then
        self.DoNotFound(AUse, self.FTree[AUse].Text);
        return;
      end;
      self.FTree[AUse].ResolvedDecl := LFound;
    end;

    // The dotted chain AOuter = (...((Name . m1) . m2) ... . mn): ANodes[i] the node of
    // AParts[i] (ANodes[0] the NameExpression). See the header for the rule
    hidden method DoDotted(const AParts: StringArray; const ANodes: NodeList);
    var
      LLast: int64;
      LFound: int64;
      LModule: int64;
      LUnit: int64;
      LAt: int64;
      LHead: int64;
    begin
      LLast := len(AParts) - 1;
      LHead := ANodes.Items[0];
      LFound := self.DoOwnScopes(LHead, AParts[0]);
      if LFound < 0 then
        return;
      end;
      if LFound = 0 then
        LFound := FindSystem(self.FTree, AParts[0]);
      end;
      if LFound <> 0 then
        self.FTree[LHead].ResolvedDecl := LFound;
        return;
      end;
      LModule := ModuleOf(self.FTree, LHead);
      LUnit := self.DoLongestUnit(LModule, AParts, LLast, LAt);
      if LUnit <> 0 then
        self.FTree[ANodes.Items[LAt]].ResolvedUnit := LUnit;
        self.DoUnitMember(ANodes.Items[LAt + 1], LUnit, AParts[LAt + 1]);
        return;
      end;

      // No unit prefix: the head is a later own name or an import's bare export (its
      // members are M1.9's), else nothing holds it
      LFound := self.DoLaterScopes(LHead, AParts[0]);
      if LFound = 0 then
        LFound := self.DoImports(LModule, AParts[0]);
      end;
      if LFound <> 0 then
        self.FTree[LHead].ResolvedDecl := LFound;
        return;
      end;
      self.DoNotFound(LHead, AParts[0]);
    end;

    // An arrow MemberExpression AId whose operand is a dotted name naming an imported unit
    // (`System.SysUtils->IntToStr`): DoChain stops at '->', so the operand would be looked
    // up as a declaration and miss. The unit goes into the operand's ResolvedUnit, as a
    // one-part unit name gets it, and nothing under AId is walked: Semantics reports the
    // '->' (SM0014, DoMember). True when it was such a node (or its head's lookup was
    // reported already: SM0001 / SM0003)
    hidden method DoArrowOnUnit(const AId: int64): bool;
    var
      LOperand: int64;
      LAt: int64;
      LReversed: NodeList;
      LParts: StringArray;
      LCount: int64;
      LI: int64;
      LFound: int64;
      LUnit: int64;
    begin
      if not self.FTree[AId].HasFlag(NodeFlag.Arrow) then
        return false;
      end;
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      if (LOperand = 0) or (self.FTree[LOperand].Kind <> NodeKind.MemberExpression) then
        return false;
      end;
      LAt := LOperand;
      while (self.FTree[LAt].Kind = NodeKind.MemberExpression) and
        (not self.FTree[LAt].HasFlag(NodeFlag.Arrow)) do
        LReversed.Add(LAt);
        LAt := self.FTree.FirstOf(LAt, NodeRole.Operand);
        if LAt = 0 then
          return false;
        end;
      end;
      if self.FTree[LAt].Kind <> NodeKind.NameExpression then
        return false;
      end;
      LReversed.Add(LAt);
      LCount := LReversed.Count;
      setlength(LParts, LCount);
      for LI := 0 to LCount - 1 do
        LParts[LI] := self.FTree[LReversed.Items[LCount - 1 - LI]].Text;
      end;
      // A declaration the head names comes first, as in DoDotted
      LFound := self.DoOwnScopes(LAt, LParts[0]);
      if LFound <> 0 then
        return LFound < 0;
      end;
      if FindSystem(self.FTree, LParts[0]) <> 0 then
        return false;
      end;
      LUnit := self.DoUnitNamed(ModuleOf(self.FTree, LAt), JoinStrings(LParts, ".", 0, LCount));
      if LUnit = 0 then
        return false;
      end;
      self.FTree[LOperand].ResolvedUnit := LUnit;
      return true;
    end;

    // A MemberExpression AId: when its chain of '.' members bottoms out at a name, the
    // whole chain is resolved here (true); false for any other operand (walked as usual)
    hidden method DoChain(const AId: int64): bool;
    var
      LAt: int64;
      LParts: StringArray;
      LReversed: NodeList;
      LNodes: NodeList;
      LI: int64;
      LCount: int64;
    begin
      LAt := AId;
      while (self.FTree[LAt].Kind = NodeKind.MemberExpression) and
        (not self.FTree[LAt].HasFlag(NodeFlag.Arrow)) do
        LReversed.Add(LAt);
        LAt := self.FTree.FirstOf(LAt, NodeRole.Operand);
        if LAt = 0 then
          return false;
        end;
      end;
      if self.FTree[LAt].Kind <> NodeKind.NameExpression then
        return false;
      end;
      LReversed.Add(LAt);

      // Innermost first: the name, then each member outward
      LCount := LReversed.Count;
      setlength(LParts, LCount);
      for LI := 0 to LCount - 1 do
        LNodes.Add(LReversed.Items[LCount - 1 - LI]);
        LParts[LI] := self.FTree[LNodes.Items[LI]].Text;
      end;
      self.DoDotted(LParts, LNodes);
      return true;
    end;

    // True when the forward type AForward has no full declaration in its scope before AUse
    // (lookup finds the forward first, the full may follow it)
    hidden const method DoForwardOnly(const AForward: int64; const AUse: int64): bool;
    var
      LScope: int64;
      LElsewhere: bool;
      LI: int64;
      LChild: int64;
    begin
      LScope := self.FTree.ParentOf(AForward);
      // A use in another module (an importer of a public forward type) sees the declaring
      // module whole: its full declaration counts wherever it stands; offsets compare only
      // within one file. So does a use in code (a routine's or method's locals and
      // statements, BNF sec 3, J3c): code is checked after every declaration of its module
      LElsewhere := (DoModuleOf(self.FTree, AUse) <> DoModuleOf(self.FTree, AForward)) or
        self.DoInCode(AUse);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if (self.FTree[LChild].Kind = NodeKind.TypeDecl) and
          (self.FTree[LChild].Text = self.FTree[AForward].Text) and
          (LElsewhere or (self.FTree[LChild].StartOffset < self.FTree[AUse].StartOffset)) then
          return false;
        end;
      end;
      return true;
    end;

    // True when AUse stands in code: under a Local (a routine's, method's or test's own
    // declarations) or a Body (its statements, the module's block)
    hidden const method DoInCode(const AUse: int64): bool;
    var
      LAt: int64;
      LRole: NodeRole;
    begin
      LAt := AUse;
      while LAt <> 0 do
        LRole := self.FTree.RoleOf(LAt);
        if (LRole = NodeRole.Local) or (LRole = NodeRole.Body) then
          return true;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // True when the named type AId is the type a field or variable holds by value (BNF sec 3:
    // a forward type goes only behind ptr to, own / ref / weak, or in a routine type's
    // parameters and return type until its full declaration): walked up through the array
    // types around it (an array's element is held by value); any other type around it
    // (ptr to, own / ref / weak, a routine type) holds no value of it
    hidden const method DoHeldByValue(const AId: int64): bool;
    var
      LAt: int64;
      LParent: int64;
      LKind: NodeKind;
    begin
      LAt := AId;
      LParent := self.FTree.ParentOf(LAt);
      while (LParent <> 0) and (self.FTree[LParent].Kind = NodeKind.ArrayType) do
        LAt := LParent;
        LParent := self.FTree.ParentOf(LAt);
      end;
      if LParent = 0 then
        return false;
      end;
      LKind := self.FTree[LParent].Kind;
      return ((LKind = NodeKind.FieldDecl) or (LKind = NodeKind.VarDecl)) and
        (self.FTree.RoleOf(LAt) = NodeRole.TypeOf);
    end;

    // A NamedType AId (its Text the dotted name): a type, from a unit when a prefix names
    // one; anything else in a type's place is SM0013, a prefix that is no unit SM0007
    hidden method DoNamedType(const AId: int64);
    var
      LParts: StringArray;
      LFound: int64;
      LModule: int64;
      LUnit: int64;
      LAt: int64;
      LLast: int64;
    begin
      DoSplitDots(self.FTree[AId].Text, LParts);
      LLast := len(LParts) - 1;
      if LLast = 0 then
        LFound := self.DoLookupBare(AId, LParts[0]);
        if LFound < 0 then
          return;
        end;
        if LFound = 0 then
          self.DoNotFound(AId, LParts[0]);
          return;
        end;
        if (self.FTree[LFound].Kind = NodeKind.ForwardType) and self.DoForwardOnly(LFound, AId) and
          self.DoHeldByValue(AId) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_300, ADAM_MSG_SEMANTICS_FORWARD_BY_VALUE,
            NoArgs().Str(LParts[0]).Str(LParts[0]));
        end;
      else
        // The qualifier is a bare name first (BNF sec 1's order): an own declaration of its
        // spelling hides the imported module (SM0007 at the type)
        LFound := self.DoOwnScopes(AId, LParts[0]);
        if LFound < 0 then
          return;
        end;
        if LFound <> 0 then
          self.DoError(AId, ADAM_ERR_SEMANTICS_007, ADAM_MSG_SEMANTICS_MODULE_HIDDEN,
            NoArgs().Str(LParts[0]).Int(int64(self.FTree[LFound].Place.Line)));
          return;
        end;
        LModule := ModuleOf(self.FTree, AId);
        LUnit := self.DoUnitNamed(LModule, JoinStrings(LParts, ".", 0, LLast));
        // A shorter prefix that names a module: parts are left past its type (no nested
        // types, BNF sec 1)
        if (LUnit = 0) and (self.DoLongestUnit(LModule, LParts, LLast, LAt) <> 0) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_008, ADAM_MSG_SEMANTICS_QUALIFIED_PARTS, NoArgs());
          return;
        end;
        if LUnit = 0 then
          self.DoError(AId, ADAM_ERR_SEMANTICS_007, ADAM_MSG_SEMANTICS_NOT_MODULE,
            NoArgs().Str(JoinStrings(LParts, ".", 0, LLast)));
          return;
        end;
        // LAt receives the declaration the unit holds private (0: none)
        LAt := 0;
        LFound := FindPublic(self.FTree, LUnit, LParts[LLast], LAt);
        if LFound = 0 then
          if LAt <> 0 then
            self.DoErrorName(AId, ADAM_ERR_SEMANTICS_006, ADAM_MSG_SEMANTICS_NOT_PUBLIC,
              NoArgs().Str(LParts[LLast]).Str(self.FTree[LUnit].Text));
          else
            self.DoErrorName(AId, ADAM_ERR_SEMANTICS_005, ADAM_MSG_SEMANTICS_UNIT_NO_NAME,
              NoArgs().Str(self.FTree[LUnit].Text).Str(LParts[LLast]));
          end;
          return;
        end;
      end;
      if not DoIsTypeDecl(self.FTree[LFound].Kind) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_013, ADAM_MSG_SEMANTICS_NOT_TYPE,
          NoArgs().Str(self.FTree[AId].Text));
        return;
      end;
      self.FTree[AId].ResolvedDecl := LFound;
      self.DoTypeArgCount(AId, LFound);
    end;

    // AUse's type arguments (TypeArgument children of a named type or a name, BNF sec 10)
    // resolved like any type expression
    hidden method DoTypeArguments(const AUse: int64);
    var
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AUse, NodeRole.TypeArgument) - 1 do
        self.DoWalk(self.FTree.NthOf(AUse, NodeRole.TypeArgument, LI));
      end;
    end;

    // The type use AUse names the type ADecl with as many type arguments as ADecl has type
    // parameters (BNF sec 10): SM0735 when a generic gets another count, or a type that is
    // not generic gets any. Inside its own declaration a generic's bare name is the instance
    // being declared, so no arguments are needed there
    hidden method DoTypeArgCount(const AUse: int64; const ADecl: int64);
    var
      LParams: int64;
      LGiven: int64;
    begin
      LParams := self.FTree.CountOf(ADecl, NodeRole.GenericParam);
      LGiven := self.FTree.CountOf(AUse, NodeRole.TypeArgument);
      if LParams = LGiven then
        return;
      end;
      if LParams = 0 then
        self.DoError(AUse, ADAM_ERR_SEMANTICS_735, ADAM_MSG_SEMANTICS_NOT_GENERIC,
          NoArgs().Str(self.FTree[AUse].Text));
        return;
      end;
      if (LGiven = 0) and (self.FTree.IsAncestor(ADecl, AUse) or (self.DoOwnInstance(ADecl, AUse) <> 0)) then
        return;
      end;
      self.DoError(AUse, ADAM_ERR_SEMANTICS_735, ADAM_MSG_SEMANTICS_TYPE_ARG_COUNT,
        NoArgs().Str(self.FTree[AUse].Text).Int(LParams).Int(LGiven));
    end;

    // The instance of the generic ADecl that AUse lies in (inside its own declaration a
    // generic's bare name is the instance being declared, BNF sec 10); 0 when none
    hidden const method DoOwnInstance(const ADecl: int64; const AUse: int64): int64;
    var
      LInstance: int64;
    begin
      LInstance := InstanceAbove(self.FTree, AUse);
      while LInstance <> 0 do
        if GenericOf(self.FTree, LInstance) = ADecl then
          return LInstance;
        end;
        LInstance := InstanceAbove(self.FTree, self.FTree.ParentOf(LInstance));
      end;
      return 0;
    end;

    // The use AUse naming a generic type (BNF sec 10): the instance its type arguments
    // name, found or made (DoMakeInstance), into its ResolvedDecl (the instance's clone) and
    // ResolvedInstance; a bare name inside an instance of its own generic is that instance.
    // A template's own uses name none (its instances' do), nor does a use whose type
    // arguments do not match (SM0735) or hold a type that did not resolve (reported where it
    // was lost)
    hidden method DoInstance(const AUse: int64);
    var
      LDecl: int64;
      LCount: int64;
      LKey: string;
      LArgs: ref NodeList;
      LI: int64;
      LType: int64;
      LInstance: int64;
    begin
      LDecl := self.FTree[AUse].ResolvedDecl;
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.TypeDecl) then
        return;
      end;
      LCount := self.FTree.CountOf(LDecl, NodeRole.GenericParam);
      if LCount = 0 then
        return;
      end;
      if self.FTree.CountOf(AUse, NodeRole.TypeArgument) = 0 then
        LInstance := self.DoOwnInstance(LDecl, AUse);
        if LInstance <> 0 then
          self.FTree[AUse].ResolvedDecl := self.FTree.FirstOf(LInstance, NodeRole.Instance);
          self.FTree[AUse].ResolvedInstance := LInstance;
        end;
        return;
      end;
      if (self.FTree.CountOf(AUse, NodeRole.TypeArgument) <> LCount) or IsInTemplate(self.FTree, AUse) then
        return;
      end;
      LArgs := ref NodeList();
      for LI := 0 to LCount - 1 do
        LType := CanonicalOf(self.FTree, self.FTree.NthOf(AUse, NodeRole.TypeArgument, LI));
        if (LType = 0) or HasUnknownPart(self.FTree, LType) then
          return;
        end;
        LArgs.Add(LType);
      end;
      LKey := InstanceKey(LDecl, LArgs);
      LInstance := self.FTree.InstanceFor(LKey);
      if LInstance = 0 then
        LInstance := self.DoMakeInstance(LDecl, LArgs, LKey, AUse);
      end;
      if LInstance = 0 then
        // past the depth limit (SM0736): the use names no type, nothing cascades
        self.FTree[AUse].ResolvedDecl := 0;
        return;
      end;
      self.FTree[AUse].ResolvedDecl := self.FTree.FirstOf(LInstance, NodeRole.Instance);
      self.FTree[AUse].ResolvedInstance := LInstance;
    end;

    // The instance of the generic ADecl over the canonical types AArgs (one per type
    // parameter), made for AUse and recorded under AKey: a GenericInstance under ADecl's own
    // parent (role Instance, so the clone's names resolve where the generic was written),
    // ADecl's place, the use in its NamePlace, ADecl in its ResolvedDecl; a bound
    // GenericParam per type parameter (ResolvedType its argument), then ADecl's clone (role
    // Instance, its type parameters left out), resolved here whole. Recorded before it is
    // resolved: a use of itself inside finds it. Past ADAM_SEMANTICS_INSTANCE_DEPTH nested
    // instances SM0736 at AUse, naming the chain; 0
    hidden method DoMakeInstance(const ADecl: int64; const AArgs: ref NodeList; const AKey: string;
      const AUse: int64): int64;
    var
      LInstance: int64;
      LParam: int64;
      LBound: int64;
      LClone: int64;
      LChain: string;
      LI: int64;
    begin
      if self.FChain.Count >= ADAM_SEMANTICS_INSTANCE_DEPTH then
        // the chain as its first two and its last instance (the rest grows the same way)
        LChain := "";
        for LI := 0 to self.FChain.Count - 1 do
          if (LI >= 2) and (LI < self.FChain.Count - 1) then
            if LI = 2 then
              LChain := LChain + " -> ...";
            end;
            skip;
          end;
          if LI > 0 then
            LChain := LChain + " -> ";
          end;
          LChain := LChain + InstanceText(self.FTree, self.FChain.Items[LI]);
        end;
        // reported once, at the use, the chain its own note (a hint per instance would be
        // the chain again)
        self.FDiagnostics.Add(Severity.Error, ADAM_ERR_SEMANTICS_736, self.FTree[AUse].Place,
          ADAM_MSG_SEMANTICS_INSTANCE_DEPTH,
          NoArgs().Int(ADAM_SEMANTICS_INSTANCE_DEPTH).Str(LChain));
        return 0;
      end;
      LInstance := self.FTree.Add(NodeKind.GenericInstance, self.FTree[ADecl].Place,
        self.FTree[ADecl].StartOffset, self.FTree[ADecl].EndOffset);
      self.FTree[LInstance].NamePlace := self.FTree[AUse].Place;
      self.FTree[LInstance].Text := self.FTree[ADecl].Text;
      self.FTree[LInstance].ResolvedDecl := ADecl;
      for LI := 0 to self.FTree.CountOf(ADecl, NodeRole.GenericParam) - 1 do
        LParam := self.FTree.NthOf(ADecl, NodeRole.GenericParam, LI);
        LBound := self.FTree.Add(NodeKind.GenericParam, self.FTree[LParam].Place,
          self.FTree[LParam].StartOffset, self.FTree[LParam].EndOffset);
        self.FTree[LBound].Text := self.FTree[LParam].Text;
        self.FTree[LBound].NamePlace := self.FTree[LParam].NamePlace;
        self.FTree[LBound].ResolvedType := AArgs.Items[LI];
        self.FTree.Attach(LInstance, NodeRole.GenericParam, LBound);
      end;
      LClone := self.FTree.Clone(ADecl, NodeRole.GenericParam);
      self.FTree.Attach(LInstance, NodeRole.Instance, LClone);
      self.FTree.Attach(self.FTree.ParentOf(ADecl), NodeRole.Instance, LInstance);
      self.FTree.AddInstance(AKey, LInstance);
      self.FMade.Add(LInstance);
      self.FChain.Add(LInstance);
      self.DoWalk(LClone);
      self.FChain.RemoveLast();
      return LInstance;
    end;

    // SM0004 for each declaration of AScope whose name an earlier one of AScope holds
    // (overloads and a forward with its declaration excepted), reported against the first
    // such earlier one. Linear: the earlier declarations of each name are a chain in
    // their order (LFirst / LLast by name, LNext by declaration), walked per declaration
    // (an overload set's own length only); a scope with fewer than two makes no map
    hidden method DoDuplicates(const AScope: int64);
    var
      LCount: int64;
      LI: int64;
      LA: int64;
      LB: int64;
      LFirst: ref StringIdMap;
      LLast: ref StringIdMap;
      LNext: ref Int64Map;
    begin
      LCount := 0;
      for LI := 0 to self.FTree.ChildCount(AScope) - 1 do
        if IsScopeDeclaration(self.FTree, self.FTree.ChildAt(AScope, LI)) then
          LCount := LCount + 1;
        end;
      end;
      if LCount < 2 then
        return;
      end;
      LFirst := ref StringIdMap(0);
      LLast := ref StringIdMap(0);
      LNext := ref Int64Map(0);
      for LI := 0 to self.FTree.ChildCount(AScope) - 1 do
        LB := self.FTree.ChildAt(AScope, LI);
        if not IsScopeDeclaration(self.FTree, LB) then
          skip;
        end;
        LA := LFirst.Find(self.FTree[LB].Text);
        while LA <> 0 do
          if not DoMayShare(self.FTree[LA].Kind, self.FTree[LB].Kind) then
            self.DoError(LB, ADAM_ERR_SEMANTICS_004, ADAM_MSG_SEMANTICS_DUPLICATE,
              NoArgs().Str(self.FTree[LB].Text).Int(int64(self.FTree[LA].Place.Line)));
            self.FTree[LB].AddFlag(NodeFlag.Repeated);
            leave;
          end;
          LA := LNext.Find(LA);
        end;
        if LFirst.Find(self.FTree[LB].Text) = 0 then
          LFirst.Put(self.FTree[LB].Text, LB);
        else
          LNext.Put(LLast.Find(self.FTree[LB].Text), LB);
        end;
        LLast.Put(self.FTree[LB].Text, LB);
      end;
    end;

    // SM0004 for each declaration among the top statements of the routine body ABody whose
    // name a parameter or local of its routine holds: the body's own statements share the
    // routine's scope (a nested block's do not), reported against that one
    hidden method DoBodyDuplicates(const ABody: int64);
    var
      LRoutine: int64;
      LI: int64;
      LDecl: int64;
      LEarlier: int64;
    begin
      LRoutine := self.FTree.ParentOf(ABody);
      for LI := 0 to self.FTree.ChildCount(ABody) - 1 do
        LDecl := self.FTree.ChildAt(ABody, LI);
        if not IsScopeDeclaration(self.FTree, LDecl) then
          skip;
        end;
        LEarlier := FindDeclared(self.FTree, LRoutine, self.FTree[LDecl].Text, -1);
        if (LEarlier <> 0) and not DoMayShare(self.FTree[LEarlier].Kind, self.FTree[LDecl].Kind) then
          self.DoError(LDecl, ADAM_ERR_SEMANTICS_004, ADAM_MSG_SEMANTICS_DUPLICATE,
            NoArgs().Str(self.FTree[LDecl].Text).Int(int64(self.FTree[LEarlier].Place.Line)));
          self.FTree[LDecl].AddFlag(NodeFlag.Repeated);
        end;
      end;
    end;

    // The extend declaration AId resolved (BNF sec 3, F1): a type argument of its target
    // that is a bare name naming nothing visible made a GenericParam of the extend (it is then
    // a template, one instance per matching instance of the target; a name made twice is
    // SM0752), the target resolved, ResolvedType its canonical type (a template's: the
    // generic type it extends) so its members' self is the target from here on, then its
    // members
    hidden method DoExtendWalk(const AId: int64);
    var
      LTarget: int64;
      LArg: int64;
      LParam: int64;
      LFound: int64;
      LOrder: ref NodeList;
      LI: int64;
      LName: string;
    begin
      LTarget := self.FTree.FirstOf(AId, NodeRole.ExtendTarget);
      if LTarget = 0 then
        return;
      end;
      // an instance's clone binds its parameters already (its GenericInstance's); a
      // compiled unit's template carries its own
      if (InstanceOf(self.FTree, AId) = 0) and (self.FTree.FirstOf(AId, NodeRole.GenericParam) = 0) then
        for LI := 0 to self.FTree.CountOf(LTarget, NodeRole.TypeArgument) - 1 do
          LArg := self.FTree.NthOf(LTarget, NodeRole.TypeArgument, LI);
          LName := self.FTree[LArg].Text;
          if (self.FTree[LArg].Kind <> NodeKind.NamedType) or (IndexOf(".", LName, 0) >= 0) or
            (self.FTree.CountOf(LArg, NodeRole.TypeArgument) <> 0) then
            skip;
          end;
          LFound := self.DoLookupBare(LArg, LName);
          if (LFound <> 0) and (self.FTree.ParentOf(LFound) = AId) then
            self.DoError(LArg, ADAM_ERR_SEMANTICS_752, ADAM_MSG_SEMANTICS_EXTEND_PARAM_TWICE,
              NoArgs().Str(LName));
            skip;
          end;
          if LFound <> 0 then
            skip;
          end;
          // declared where the extend starts: before every name of it, its args' included
          LParam := self.FTree.Add(NodeKind.GenericParam, self.FTree[LArg].Place,
            self.FTree[AId].StartOffset, self.FTree[LArg].EndOffset);
          self.FTree[LParam].Text := LName;
          self.FTree[LParam].NamePlace := self.FTree[LArg].Place;
          self.FTree.Attach(AId, NodeRole.GenericParam, LParam);
        end;
        // the parameters first among the extend's children: a scope holds a name for the
        // children after its declaration
        if self.FTree.FirstOf(AId, NodeRole.GenericParam) <> 0 then
          LOrder := ref NodeList();
          for LI := 0 to self.FTree.CountOf(AId, NodeRole.GenericParam) - 1 do
            LOrder.Add(self.FTree.NthOf(AId, NodeRole.GenericParam, LI));
          end;
          for LI := 0 to self.FTree.ChildCount(AId) - 1 do
            if self.FTree.RoleOf(self.FTree.ChildAt(AId, LI)) <> NodeRole.GenericParam then
              LOrder.Add(self.FTree.ChildAt(AId, LI));
            end;
          end;
          self.FTree.ReorderChildren(AId, LOrder);
        end;
      end;
      self.DoWalk(LTarget);
      if IsInTemplate(self.FTree, AId) then
        self.FTree[AId].ResolvedType := self.FTree[LTarget].ResolvedDecl;
      else
        self.FTree[AId].ResolvedType := CanonicalOf(self.FTree, LTarget);
      end;
      self.DoWalk(self.FTree.FirstOf(AId, NodeRole.TypeOf));
    end;

    // AId and everything under it: duplicates per scope, every name resolved. A
    // directive's arguments are its values, not names, but for a constant's name in place of
    // a literal (DoDirectiveConstName)
    hidden method DoWalk(const AId: int64);
    var
      LKind: NodeKind;
      LI: int64;
      LName: int64;
    begin
      LKind := self.FTree[AId].Kind;
      if LKind = NodeKind.Directive then
        LName := DoDirectiveConstName(self.FTree, AId);
        if LName <> 0 then
          self.DoWalk(LName);
        end;
        return;
      end;
      if LKind = NodeKind.NameExpression then
        self.DoName(AId);
        self.DoTypeArguments(AId);
        self.DoInstance(AId);
        return;
      end;
      if LKind = NodeKind.NamedType then
        self.DoNamedType(AId);
        self.DoTypeArguments(AId);
        self.DoInstance(AId);
        return;
      end;
      // an instance is resolved whole when it is made (DoMakeInstance)
      if LKind = NodeKind.GenericInstance then
        return;
      end;
      if LKind = NodeKind.ExtendDecl then
        self.DoExtendWalk(AId);
        return;
      end;
      if (LKind = NodeKind.MemberExpression) and (self.DoArrowOnUnit(AId) or self.DoChain(AId)) then
        // a dotted chain's members are resolved by the chain; the type arguments a member
        // names (X.Map<string>(..), BNF sec 10) are type expressions of their own
        LName := AId;
        while (LName <> 0) and (self.FTree[LName].Kind = NodeKind.MemberExpression) do
          self.DoTypeArguments(LName);
          LName := self.FTree.FirstOf(LName, NodeRole.Operand);
        end;
        return;
      end;
      self.DoDuplicates(AId);
      if (self.FTree.RoleOf(AId) = NodeRole.Body) and
        (IsRoutineLike(self.FTree[self.FTree.ParentOf(AId)].Kind) or
        (self.FTree[self.FTree.ParentOf(AId)].Kind = NodeKind.FuncLiteral)) then
        self.DoBodyDuplicates(AId);
      end;
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        self.DoWalk(self.FTree.ChildAt(AId, LI));
      end;
    end;

    // True when ADecl is a module's private routine, variable or constant (no generic: an
    // instance of a private generic is each using object's own)
    hidden const method DoIsPrivateGlobal(const ADecl: int64): bool;
    var
      LKind: NodeKind;
      LParent: int64;
    begin
      LKind := self.FTree[ADecl].Kind;
      if (LKind <> NodeKind.RoutineDecl) and (LKind <> NodeKind.ForwardRoutine) and
        (LKind <> NodeKind.VarDecl) and (LKind <> NodeKind.ConstDecl) then
        return false;
      end;
      LParent := self.FTree.ParentOf(ADecl);
      return (LParent <> 0) and (self.FTree[LParent].Kind = NodeKind.Module) and
        not self.FTree[ADecl].HasFlag(NodeFlag.Public) and
        (self.FTree.FirstOf(ADecl, NodeRole.GenericParam) = 0);
    end;

    // Every private routine, variable or constant of a module that a generic template's
    // body of the module names flagged GenericUse, with every declaration of its name in
    // the module (the overload a call there picks is its instance's): an instance is
    // lowered in each object that uses it (M10f), and those objects reach its symbol
    hidden method DoGenericUses();
    var
      LI: int64;
      LJ: int64;
      LDecl: int64;
      LModule: int64;
      LChild: int64;
    begin
      for LI := 1 to self.FTree.Count - 1 do
        if self.FTree[LI].HasFlag(NodeFlag.Compiled) then
          skip;
        end;
        LDecl := self.FTree[LI].ResolvedDecl;
        if (LDecl = 0) or self.FTree[LDecl].HasFlag(NodeFlag.GenericUse) or
          not self.DoIsPrivateGlobal(LDecl) or not IsInTemplate(self.FTree, LI) then
          skip;
        end;
        LModule := self.FTree.ParentOf(LDecl);
        for LJ := 0 to self.FTree.ChildCount(LModule) - 1 do
          LChild := self.FTree.ChildAt(LModule, LJ);
          if (self.FTree[LChild].Text = self.FTree[LDecl].Text) and self.DoIsPrivateGlobal(LChild) then
            self.FTree[LChild].AddFlag(NodeFlag.GenericUse);
          end;
        end;
      end;
    end;

    // Every module of the program resolved, but a compiled unit's (resolved already); then
    // the private declarations generic templates name flagged (DoGenericUses)
    method Run();
    var
      LI: int64;
      LModule: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        LModule := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        if not self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
          self.DoWalk(LModule);
        end;
      end;
      self.DoGenericUses();
    end;
  end;

// Every name of the program in ATree resolved into the AST, reporting into ADiagnostics
// (see the header)
public func ResolveNames(const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics);
var
  LResolver: ref NameResolver;
begin
  LResolver := ref NameResolver(ATree, ADiagnostics);
  LResolver.Run();
end;

// True for the kinds of a type expression (BNF sec 4 type expr)
func DoIsTypeExpression(const AKind: NodeKind): bool;
begin
  return (AKind = NodeKind.NamedType) or (AKind = NodeKind.BuiltinTypeName) or
    (AKind = NodeKind.PointerType) or (AKind = NodeKind.ArrayType) or
    (AKind = NodeKind.RoutineType) or (AKind = NodeKind.OwnType) or
    (AKind = NodeKind.RefType) or (AKind = NodeKind.WeakType) or (AKind = NodeKind.TaskType) or
    (AKind = NodeKind.SequenceType) or (AKind = NodeKind.ClosureType) or
    (AKind = NodeKind.ClosureOfType);
end;

// True for the kinds of an expression (BNF sec 6)
func DoIsExpression(const AKind: NodeKind): bool;
begin
  match AKind of
    NodeKind.AssignExpression, NodeKind.ConditionalExpression, NodeKind.BinaryExpression,
    NodeKind.UnaryExpression, NodeKind.PostfixExpression, NodeKind.IsExpression,
    NodeKind.AsExpression, NodeKind.CallExpression, NodeKind.IndexExpression,
    NodeKind.MemberExpression, NodeKind.NameExpression, NodeKind.ParenExpression,
    NodeKind.IntLiteral, NodeKind.FloatLiteral, NodeKind.StringLiteral,
    NodeKind.CharLiteral, NodeKind.BoolLiteral, NodeKind.NilLiteral,
    NodeKind.SelfExpression, NodeKind.ParentExpression, NodeKind.OwnNew, NodeKind.RefNew,
    NodeKind.WeakNew, NodeKind.VarargsExpression, NodeKind.TypeCast, NodeKind.PointerCast,
    NodeKind.SetLiteral, NodeKind.ArrayLiteral, NodeKind.RecordLiteral, NodeKind.AsyncExpression,
    NodeKind.AwaitExpression, NodeKind.FuncLiteral:
      return true;
  else
    // any other kind is no expression
  end;
  return false;
end;

// True for the intrinsics that are statements (BNF sec 7 memory / exception / io stmt and
// the asserts of sec 8): a call of one has no value
func DoIsStatementIntrinsic(const AName: string): bool;
begin
  if (AName = "create") or (AName = "destroy") or (AName = "freemem") or
    (AName = "setlength") or (AName = "raise") or (AName = "raisecode") or
    (AName = "print") or (AName = "println") or (AName = "atomicstore") or (AName = "cancel") then
    return true;
  end;
  return StartsStr(ADAM_SEMANTICS_INTRINSIC_TEST_PREFIX, AName);
end;

// The signature SM0409 names for the atomic intrinsic AName
func DoAtomicSignature(const AName: string): string;
begin
  if AName = "atomicadd" then
    return ADAM_MSG_SEMANTICS_SIG_ATOMIC_ADD;
  end;
  if AName = "atomiccas" then
    return ADAM_MSG_SEMANTICS_SIG_ATOMIC_CAS;
  end;
  if AName = "atomicload" then
    return ADAM_MSG_SEMANTICS_SIG_ATOMIC_LOAD;
  end;
  return ADAM_MSG_SEMANTICS_SIG_ATOMIC_SWAP;
end;

// The count of arguments the atomic intrinsic AName takes: the place, then its values
func DoAtomicArity(const AName: string): int64;
begin
  if AName = "atomicload" then
    return 1;
  end;
  if AName = "atomiccas" then
    return 3;
  end;
  return 2;
end;

// True when AText (a suffix) holds the character AChar in either case
func DoHasLetter(const AText: string; const ALower: char; const AUpper: char): bool;
var
  LI: int64;
begin
  for LI := 0 to len(AText) - 1 do
    if (AText[LI] = ALower) or (AText[LI] = AUpper) then
      return true;
    end;
  end;
  return false;
end;

public type
  // One typing pass over a tree (see CheckTypes): every expression's type into its
  // ResolvedType, every implicit conversion into the converted value's ResolvedConvert,
  // every declaration's type into its ResolvedType, a return's routine into its
  // ResolvedJump, a member's declaration into its ResolvedDecl, a forward's full
  // declaration into the forward's ResolvedDecl
  TypeChecker = object
    hidden FTree: ref SyntaxTree;
    hidden FTarget: ref Target;
    hidden FDiagnostics: ref Diagnostics;
    hidden FDone: array of bool;
    hidden FFolder: ref ConstantFolder;
    // The forward types and routines visited, in visit order: those no full declaration
    // completed are reported once the program is typed (DoUnpairedForwards)
    hidden FForwards: ref NodeList;
    // The generic instance being visited (DoVisit; 0: none): where DoErrorAt's report lies,
    // which names no node
    hidden FInstance: int64;
    // Makes and resolves the instances a call of a generic routine or method names (a
    // routine's instance is picked with its call's types: DoGenericCallee, BNF sec 10)
    hidden FResolver: ref NameResolver;
    // The generic routines named as values (DoGenericValue), in visit order: each takes its
    // instance from the routine type it converts to (DoGenericValueTo); one no routine type
    // reached is reported once the program is typed (DoGenericValues)
    hidden FGenericValues: ref NodeList;
    // Each name of FGenericValues: 1 waiting for its routine type, 2 met one (an instance
    // taken, or the reason it could not be reported there)
    hidden FGenericState: ref Int64Map;
    // F4 (BNF sec 6): the copy sites of values holding C string pointers whose source lies
    // in a variable (DoNoteCTextCopy), the returned values of such types, and the holders
    // made (DoEnsureHolder); DoCTextHolds settles them once the program is typed
    hidden FHoldCopies: ref NodeList;
    hidden FHoldReturns: ref NodeList;
    // The values of record literals' C string fields borrowing a string (F4b,
    // DoLiteralCText), each checked by DoCTextHolds
    hidden FHoldLiterals: ref NodeList;
    hidden FHolders: int64;

    init(const ATree: ref SyntaxTree; const ATarget: ref Target;
      const ADiagnostics: ref Diagnostics);
    begin
      self.FTree := ATree;
      self.FTarget := ATarget;
      self.FDiagnostics := ADiagnostics;
      self.FHoldCopies := ref NodeList();
      self.FHoldReturns := ref NodeList();
      self.FHoldLiterals := ref NodeList();
      self.FHolders := 0;
      self.FFolder := ref ConstantFolder(ATree, ATarget, ADiagnostics);
      self.FForwards := ref NodeList();
      self.FInstance := 0;
      self.FResolver := ref NameResolver(ATree, ADiagnostics);
      self.FGenericValues := ref NodeList();
      self.FGenericState := ref Int64Map(0);
    end;

    // Error ACode at AId's place (ReportInInstance: once, noted, inside an instance)
    hidden method DoError(const AId: int64; const ACode: string; const ATemplate: string;
      const AArgs: MessageArgs);
    begin
      ReportInInstance(self.FTree, self.FDiagnostics, InstanceAbove(self.FTree, AId), ACode,
        self.FTree[AId].Place, ATemplate, AArgs);
    end;

    // Error ACode at APlace: a token of a node other than its first (Node.AtName / AtMark),
    // in the instance being visited (FInstance)
    hidden method DoErrorAt(const APlace: SourcePlace; const ACode: string; const ATemplate: string;
      const AArgs: MessageArgs);
    begin
      ReportInInstance(self.FTree, self.FDiagnostics, self.FInstance, ACode, APlace, ATemplate, AArgs);
    end;

    // Error ACode at AId's name (Node.AtName: a member after '.' / '->', the name a
    // declaration declares, an accessor's field); an index names its operand's (X.P[i]:
    // at P)
    hidden method DoErrorName(const AId: int64; const ACode: string; const ATemplate: string;
      const AArgs: MessageArgs);
    var
      LAt: int64;
    begin
      LAt := AId;
      if self.FTree[LAt].Kind = NodeKind.IndexExpression then
        LAt := self.FTree.FirstOf(LAt, NodeRole.Operand);
      end;
      ReportInInstance(self.FTree, self.FDiagnostics, InstanceAbove(self.FTree, AId), ACode,
        self.FTree[LAt].AtName(), ATemplate, AArgs);
    end;

    // Where a report about the init arguments AHolder holds points: the '(' a var's
    // arguments open with (BNF sec 3 `LV: T(...)`), else AAt's place
    hidden const method DoInitArgsPlace(const AHolder: int64; const AAt: int64): SourcePlace;
    begin
      if self.FTree[AHolder].HasMark(NodeMark.InitOpen) then
        return self.FTree[AHolder].AtMark(NodeMark.InitOpen);
      end;
      return self.FTree[AAt].Place;
    end;

    // True the first time AId is met, which marks it; false every time after (a node is
    // typed once, its errors reported once)
    hidden method DoFirstVisit(const AId: int64): bool;
    var
      LOld: int64;
      LI: int64;
    begin
      if AId >= len(self.FDone) then
        LOld := len(self.FDone);
        setlength(self.FDone, self.FTree.Count + 64);
        for LI := LOld to len(self.FDone) - 1 do
          self.FDone[LI] := false;
        end;
      end;
      if self.FDone[AId] then
        return false;
      end;
      self.FDone[AId] := true;
      return true;
    end;

    // The builtin type named AName
    hidden const method DoBuiltin(const AName: string): int64;
    begin
      return BuiltinType(self.FTree, AName);
    end;

    // AType as a message writes it
    hidden const method DoText(const AType: int64): string;
    begin
      return TypeText(self.FTree, AType);
    end;

    // The class of AType
    hidden const method DoClass(const AType: int64): TypeClass;
    begin
      return ClassOf(self.FTree, AType);
    end;

    // The type of the expression AId (0: unknown)
    hidden const method DoTypeOf(const AId: int64): int64;
    begin
      if AId = 0 then
        return 0;
      end;
      return self.FTree[AId].ResolvedType;
    end;

    // AType written as the type of AId
    hidden method DoSetType(const AId: int64; const AType: int64);
    var
      LParent: int64;
    begin
      self.FTree[AId].ResolvedType := AType;
      if (AType = 0) or (ClassOf(self.FTree, AType) <> TypeClass.FlexibleArray) then
        return;
      end;
      // an external variable of array[0..] of T (C's `extern T x[];`, PLAN-XML X2c): no
      // size either, so only an index or `addr of` (where its elements start) takes it
      if self.DoIsExternalArray(AId) then
        LParent := self.FTree.ParentOf(AId);
        if (LParent <> 0) and (self.FTree.FirstOf(LParent, NodeRole.Operand) = AId) and
          ((self.FTree[LParent].Kind = NodeKind.IndexExpression) or
          ((self.FTree[LParent].Kind = NodeKind.UnaryExpression) and
          (self.FTree[LParent].Op = OperatorKind.AddressOf))) then
          return;
        end;
        self.DoError(AId, ADAM_ERR_SEMANTICS_730, ADAM_MSG_SEMANTICS_FLEX_EXTERNAL_USE,
          NoArgs().Str(self.FTree[AId].Text).Str(self.FTree[AId].Text).Str(self.FTree[AId].Text));
        // reported: no type, so what holds it is silent (an expression lost)
        self.FTree[AId].ResolvedType := 0;
        return;
      end;
      // a flexible array member (M9e0b) is only the operand of an index: it has no size, so
      // no value, copy, address, len or loop takes it whole (SM0730)
      if self.FTree[AId].Kind = NodeKind.MemberExpression then
        LParent := self.FTree.ParentOf(AId);
        if (LParent = 0) or (self.FTree[LParent].Kind <> NodeKind.IndexExpression) or
          (self.FTree.FirstOf(LParent, NodeRole.Operand) <> AId) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_730, ADAM_MSG_SEMANTICS_FLEX_USE,
            NoArgs().Str(self.FTree[AId].Text).Str(self.FTree[AId].Text).Str(self.FTree[AId].Text));
          // reported: no type, so what holds it is silent (an expression lost)
          self.FTree[AId].ResolvedType := 0;
        end;
      end;
    end;

    // True when the name or member expression AId names an external variable (BNF sec 3:
    // its type array[0..] of T is C's `extern T x[];`, PLAN-XML X2c)
    hidden const method DoIsExternalArray(const AId: int64): bool;
    var
      LDecl: int64;
    begin
      if (self.FTree[AId].Kind <> NodeKind.NameExpression) and
        (self.FTree[AId].Kind <> NodeKind.MemberExpression) then
        return false;
      end;
      LDecl := self.FTree[AId].ResolvedDecl;
      if LDecl = 0 then
        return false;
      end;
      return (self.FTree[LDecl].Kind = NodeKind.VarDecl) and
        (self.FTree.FirstOf(LDecl, NodeRole.External) <> 0);
    end;

    // AId with its parentheses taken off
    hidden const method DoSkipParens(const AId: int64): int64;
    var
      LAt: int64;
    begin
      LAt := AId;
      while (LAt <> 0) and (self.FTree[LAt].Kind = NodeKind.ParenExpression) do
        LAt := self.FTree.FirstOf(LAt, NodeRole.Operand);
      end;
      return LAt;
    end;

    // The expression AId as a message spells it (names, members, literals as written;
    // what lies inside a call's or an index's brackets as ...)
    hidden const method DoSpell(const AId: int64; const ADepth: int64): string;
    var
      LNode: ref Node;
      LKind: NodeKind;
      LText: string;
    begin
      if AId = 0 then
        return "";
      end;
      if ADepth > 8 then
        return "...";
      end;
      LNode := self.FTree[AId];
      LKind := LNode.Kind;
      if (LKind = NodeKind.NameExpression) or (LKind = NodeKind.IntLiteral) or
        (LKind = NodeKind.FloatLiteral) or (LKind = NodeKind.CharLiteral) or
        (LKind = NodeKind.StringLiteral) or (LKind = NodeKind.BoolLiteral) then
        return LNode.Text;
      end;
      if LKind = NodeKind.NilLiteral then
        return "nil";
      end;
      if LKind = NodeKind.SelfExpression then
        return "self";
      end;
      if LKind = NodeKind.ParentExpression then
        return "parent";
      end;
      if LKind = NodeKind.MemberExpression then
        LText := self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1);
        if LNode.HasFlag(NodeFlag.Arrow) then
          return LText + "->" + LNode.Text;
        end;
        return LText + "." + LNode.Text;
      end;
      if LKind = NodeKind.CallExpression then
        LText := self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Callee), ADepth + 1);
        if self.FTree.CountOf(AId, NodeRole.Argument) = 0 then
          return LText + "()";
        end;
        return LText + "(...)";
      end;
      if LKind = NodeKind.IndexExpression then
        return self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1) + "[...]";
      end;
      if LKind = NodeKind.ParenExpression then
        return "(" + self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1) + ")";
      end;
      if LKind = NodeKind.UnaryExpression then
        LText := LNode.Text;
        if (LText = "not") or (LText = "addr of") then
          LText := LText + " ";
        end;
        return LText + self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1);
      end;
      if LKind = NodeKind.PostfixExpression then
        return self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1) + LNode.Text;
      end;
      if LKind = NodeKind.BinaryExpression then
        return self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Left), ADepth + 1) + " " +
          LNode.Text + " " + self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Right), ADepth + 1);
      end;
      if (LKind = NodeKind.TypeCast) or (LKind = NodeKind.PointerCast) then
        return self.DoText(CanonicalOf(self.FTree, self.FTree.FirstOf(AId, NodeRole.TypeOf))) +
          "(...)";
      end;
      // X is T, X as T (BNF sec 6 O12)
      if (LKind = NodeKind.IsExpression) or (LKind = NodeKind.AsExpression) then
        LText := " as ";
        if LKind = NodeKind.IsExpression then
          LText := " is ";
        end;
        return self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1) + LText +
          self.DoText(CanonicalOf(self.FTree, self.FTree.FirstOf(AId, NodeRole.TypeOf)));
      end;
      return "expression";
    end;

    // The expression AId as a message spells it
    hidden const method DoExprText(const AId: int64): string;
    begin
      return self.DoSpell(AId, 0);
    end;

    // The type the declaration ADecl declares or holds: a variable's, constant's,
    // parameter's, field's, property's or embed's type (written into its ResolvedType),
    // a type declaration's type, a routine's or method's routine type, a choice value's
    // choices type; 0 for any other
    hidden method DoDeclType(const ADecl: int64): int64;
    var
      LKind: NodeKind;
      LType: int64;
    begin
      if ADecl = 0 then
        return 0;
      end;
      LKind := self.FTree[ADecl].Kind;
      if (LKind = NodeKind.VarDecl) or (LKind = NodeKind.ConstDecl) or
        (LKind = NodeKind.Param) or (LKind = NodeKind.FieldDecl) or
        (LKind = NodeKind.PropertyDecl) or (LKind = NodeKind.EmbedDecl) then
        if self.FTree[ADecl].ResolvedType <> 0 then
          return self.FTree[ADecl].ResolvedType;
        end;
        // A write accessor's value parameter `write (AValue)` is written without a type:
        // it holds the property's (BNF sec 4)
        if (LKind = NodeKind.Param) and (self.FTree.FirstOf(ADecl, NodeRole.TypeOf) = 0) and
          (self.FTree[self.FTree.ParentOf(ADecl)].Kind = NodeKind.PropertyWrite) then
          LType := self.DoDeclType(self.FTree.ParentOf(self.FTree.ParentOf(ADecl)));
          self.FTree[ADecl].ResolvedType := LType;
          return LType;
        end;
        LType := CanonicalOf(self.FTree, self.FTree.FirstOf(ADecl, NodeRole.TypeOf));
        self.FTree[ADecl].ResolvedType := LType;
        return LType;
      end;
      if DoIsTypeDecl(LKind) then
        return DeclaredTypeOf(self.FTree, ADecl);
      end;
      if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
        (LKind = NodeKind.MethodDecl) then
        return RoutineTypeOf(self.FTree, ADecl);
      end;
      if LKind = NodeKind.ChoiceValue then
        return self.FTree.ParentOf(self.FTree.ParentOf(ADecl));
      end;
      return 0;
    end;

    // The declared type a Name / Member expression AExpr names (0 when it names none)
    hidden method DoTypeNamed(const AExpr: int64): int64;
    var
      LKind: NodeKind;
      LDecl: int64;
    begin
      if AExpr = 0 then
        return 0;
      end;
      LKind := self.FTree[AExpr].Kind;
      if (LKind <> NodeKind.NameExpression) and (LKind <> NodeKind.MemberExpression) then
        return 0;
      end;
      LDecl := self.FTree[AExpr].ResolvedDecl;
      if (LDecl = 0) or (not DoIsTypeDecl(self.FTree[LDecl].Kind)) then
        return 0;
      end;
      return DeclaredTypeOf(self.FTree, LDecl);
    end;

    // The declaration the callee AExpr names (a Name or Member's ResolvedDecl); 0 for any
    // other callee
    hidden const method DoCalleeDecl(const AExpr: int64): int64;
    var
      LAt: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return 0;
      end;
      if (self.FTree[LAt].Kind = NodeKind.NameExpression) or
        (self.FTree[LAt].Kind = NodeKind.MemberExpression) then
        return self.FTree[LAt].ResolvedDecl;
      end;
      return 0;
    end;

    // True when the routine or method ADecl shares its name with another of its scope
    // (an overload set: M1.10 picks the member a call runs)
    hidden const method DoIsOverloaded(const ADecl: int64): bool;
    var
      LScope: int64;
      LI: int64;
      LChild: int64;
      LCount: int64;
    begin
      if self.FTree[ADecl].Kind = NodeKind.MethodDecl then
        // its level's methods of its name and the virtual ones above (MO1)
        return self.DoMethodSet(ADecl, ADecl).Count > 1;
      end;
      LScope := self.FTree.ParentOf(ADecl);
      if LScope = 0 then
        return false;
      end;
      LCount := 0;
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if ((self.FTree[LChild].Kind = NodeKind.RoutineDecl) or
          (self.FTree[LChild].Kind = NodeKind.MethodDecl)) and
          (self.FTree[LChild].Text = self.FTree[ADecl].Text) then
          LCount := LCount + 1;
        end;
      end;
      return LCount > 1;
    end;

    // True when the expression AExpr is a call that has no value: a procedure (not one
    // returning self, F7), a statement intrinsic, a routine value with no return type; or an await of a plain task
    hidden const method DoIsNoValue(const AExpr: int64): bool;
    var
      LAt: int64;
      LCallee: int64;
      LDecl: int64;
      LKind: NodeKind;
      LType: int64;
    begin
      if self.DoIsPlainAwait(AExpr) then
        return true;
      end;
      LAt := self.DoSkipParens(AExpr);
      if (LAt = 0) or (self.FTree[LAt].Kind <> NodeKind.CallExpression) then
        return false;
      end;
      LCallee := self.FTree.FirstOf(LAt, NodeRole.Callee);
      LDecl := self.DoCalleeDecl(LCallee);
      if LDecl <> 0 then
        LKind := self.FTree[LDecl].Kind;
        if LKind = NodeKind.IntrinsicDecl then
          return DoIsStatementIntrinsic(self.FTree[LDecl].Text);
        end;
        if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
          (LKind = NodeKind.MethodDecl) then
          if self.DoIsOverloaded(LDecl) then
            return false;
          end;
          // a method returning self has its receiver as its value (F7)
          return (self.FTree.FirstOf(LDecl, NodeRole.ReturnType) = 0) and not self.DoReturnsSelf(LDecl);
        end;
      end;
      LType := self.DoTypeOf(LCallee);
      return ((ClassOf(self.FTree, LType) = TypeClass.RoutineType) or
        (ClassOf(self.FTree, LType) = TypeClass.ClosureType)) and (TargetOf(self.FTree, LType) = 0);
    end;

    // The value-less call AExpr used as a value: SM0704 for an await of a plain task,
    // SM0408 for a statement intrinsic, else SM0406
    hidden method DoNoValue(const AExpr: int64);
    var
      LAt: int64;
      LDecl: int64;
    begin
      if self.DoIsPlainAwait(AExpr) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_704, ADAM_MSG_SEMANTICS_AWAIT_PLAIN, NoArgs());
        return;
      end;
      LAt := self.DoSkipParens(AExpr);
      LDecl := self.DoCalleeDecl(self.FTree.FirstOf(LAt, NodeRole.Callee));
      if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.IntrinsicDecl) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_408, ADAM_MSG_SEMANTICS_INTRINSIC_STMT,
          NoArgs().Str(self.FTree[LDecl].Text));
        return;
      end;
      self.DoError(AExpr, ADAM_ERR_SEMANTICS_406, ADAM_MSG_SEMANTICS_NO_VALUE,
        NoArgs().Str(self.DoExprText(AExpr)));
    end;

    // True when the literal AExpr (AId with its parentheses off: ARoot) takes ATarget as
    // its encoding or form: a string literal a wstring or a ptr to const char / wchar /
    // 8-bit integer, a char literal a wchar (BNF sec 9: wide literals are type-driven); a
    // string constant a ptr to const char or 8-bit integer as its literal does, a wstring
    // constant a ptr to const wchar (BNF sec 4, user 2026-11-17; the 8-bit integers: uint8 /
    // int8, C's unsigned / signed char, his OK 2026-11-22, PLAN-XML X2b); a string literal
    // or a wstring constant a ptr to const uint16 too (C's char16_t, UTF-16 on every
    // target: F3). A string constant is any expression folded to one: a named constant
    // and a constant expression alike (`"Adam " + VERSION`, BNF sec 6 F4's example)
    hidden const method DoLiteralTakes(const ARoot: int64; const ATarget: int64): bool;
    var
      LKind: NodeKind;
      LTarget: TypeClass;
      LPointee: TypeClass;
      LText: TypeClass;
      LBytes: bool;
    begin
      if ARoot = 0 then
        return false;
      end;
      LKind := self.FTree[ARoot].Kind;
      LTarget := self.DoClass(ATarget);
      if (LKind <> NodeKind.StringLiteral) and (self.FTree[ARoot].ResolvedConst.Kind = ConstKind.String) and
        (LTarget = TypeClass.Pointer) and IsConstTarget(self.FTree, ATarget) then
        LPointee := self.DoClass(TargetOf(self.FTree, ATarget));
        LText := self.DoClass(self.DoTypeOf(ARoot));
        LBytes := IntBits(self.FTree, TargetOf(self.FTree, ATarget)) = 8;
        return ((LText = TypeClass.Text) and ((LPointee = TypeClass.Char) or LBytes)) or
          ((LText = TypeClass.WideText) and ((LPointee = TypeClass.WideChar) or
          (TargetOf(self.FTree, ATarget) = self.DoBuiltin("uint16"))));
      end;
      if LKind = NodeKind.StringLiteral then
        if LTarget = TypeClass.WideText then
          return true;
        end;
        if (LTarget = TypeClass.Pointer) and IsConstTarget(self.FTree, ATarget) then
          LPointee := self.DoClass(TargetOf(self.FTree, ATarget));
          return (LPointee = TypeClass.Char) or (LPointee = TypeClass.WideChar) or
            (IntBits(self.FTree, TargetOf(self.FTree, ATarget)) = 8) or
            (TargetOf(self.FTree, ATarget) = self.DoBuiltin("uint16"));
        end;
        return false;
      end;
      if LKind = NodeKind.CharLiteral then
        return LTarget = TypeClass.WideChar;
      end;
      return false;
    end;

    // True when a value of the type AType crosses a C variadic's '...' as C reads it (BNF sec
    // 6, CV1, his OK 2026-11-24): plain data only, no managed value at any depth (a string,
    // a wstring, a dynamic array, an own / ref / weak, a closure), no object, interface,
    // task, sequence, varargs or mutex; a string / wstring argument is converted to its C
    // text before this is asked (DoCVariadicArg)
    hidden const method DoIsCVariadicType(const AType: int64): bool;
    var
      LClass: TypeClass;
    begin
      if AType = 0 then
        return true;
      end;
      LClass := self.DoClass(AType);
      if (LClass = TypeClass.Text) or (LClass = TypeClass.WideText) or
        (LClass = TypeClass.DynamicArray) or (LClass = TypeClass.OwnType) or
        (LClass = TypeClass.RefType) or (LClass = TypeClass.WeakType) or
        (LClass = TypeClass.ClosureType) or (LClass = TypeClass.ObjectType) or
        (LClass = TypeClass.InterfaceType) or (LClass = TypeClass.TaskType) or
        (LClass = TypeClass.SequenceType) or (LClass = TypeClass.Varargs) or
        (LClass = TypeClass.Mutex) then
        return false;
      end;
      return not HoldsManaged(self.FTree, AType);
    end;

    // The argument AArgument in a clink variadic's '...' (BNF sec 6, CV1): a string travels
    // as its C text (ptr to const char), a wstring as its wide one (ptr to const wchar: a
    // UTF-32 copy where wchar_t is 32 bits), as F3 borrows one for a parameter (a literal's
    // and a constant's text their static C string); any other value C cannot read is SM0765
    hidden method DoCVariadicArg(const AArgument: int64);
    var
      LType: int64;
      LClass: TypeClass;
    begin
      LType := self.DoTypeOf(AArgument);
      if LType = 0 then
        return;
      end;
      LClass := self.DoClass(LType);
      if LClass = TypeClass.Text then
        self.FTree[AArgument].ResolvedConvert := PointerTo(self.FTree, self.DoBuiltin("char"), true);
        return;
      end;
      if LClass = TypeClass.WideText then
        self.FTree[AArgument].ResolvedConvert := PointerTo(self.FTree, self.DoBuiltin("wchar"), true);
        return;
      end;
      if not self.DoIsCVariadicType(LType) then
        self.DoError(AArgument, ADAM_ERR_SEMANTICS_765, ADAM_MSG_SEMANTICS_C_VARIADIC_ARG,
          NoArgs().Str(self.DoText(LType)));
      end;
    end;

    // True when the argument AArgument, a string or wstring of no constant text (a literal's
    // and a constant's are DoLiteralTakes'), is borrowed as the C string a value or const
    // parameter of type ATarget takes (BNF sec 6, F3, his OK 2026-11-23): a string to a ptr
    // to const char / uint8 / int8, a wstring to a ptr to const wchar or uint16 (C's
    // char16_t); Lowering passes its own text (DoTextToC), held through the call (a UTF-32
    // copy for a wchar where it is 32 bits)
    hidden const method DoTextArgTakes(const AArgument: int64; const ATarget: int64): bool;
    var
      LRoot: int64;
      LText: TypeClass;
      LPointee: TypeClass;
    begin
      LRoot := self.DoSkipParens(AArgument);
      if (LRoot = 0) or (ATarget = 0) or (self.FTree[LRoot].Kind = NodeKind.StringLiteral) or
        (self.FTree[LRoot].ResolvedConst.Kind = ConstKind.String) then
        return false;
      end;
      if (self.DoClass(ATarget) <> TypeClass.Pointer) or not IsConstTarget(self.FTree, ATarget) then
        return false;
      end;
      LText := self.DoClass(self.DoTypeOf(AArgument));
      LPointee := self.DoClass(TargetOf(self.FTree, ATarget));
      if LText = TypeClass.Text then
        return (LPointee = TypeClass.Char) or (IntBits(self.FTree, TargetOf(self.FTree, ATarget)) = 8);
      end;
      return (LText = TypeClass.WideText) and ((LPointee = TypeClass.WideChar) or
        (TargetOf(self.FTree, ATarget) = self.DoBuiltin("uint16")));
    end;

    // True when the argument AArgument, a static array, is borrowed as the view a `const
    // array of T` parameter AParam of type ATarget takes (BNF sec 6, AS2, his OK
    // 2026-11-24): its element type is T exactly; Lowering passes the view {its element 0,
    // its count, no block} (DoViewArgument), no copy
    hidden const method DoArrayViewTakes(const AArgument: int64; const AParam: int64;
      const ATarget: int64): bool;
    var
      LFrom: int64;
    begin
      if (AParam = 0) or (ATarget = 0) or (not self.FTree[AParam].HasFlag(NodeFlag.ConstParam)) or
        (self.DoClass(ATarget) <> TypeClass.DynamicArray) then
        return false;
      end;
      LFrom := self.DoTypeOf(AArgument);
      if (LFrom = 0) or (self.DoClass(LFrom) <> TypeClass.StaticArray) then
        return false;
      end;
      return (TargetOf(self.FTree, LFrom) <> 0) and (TargetOf(self.FTree, LFrom) = TargetOf(self.FTree, ATarget));
    end;

    // True when the variable ADecl, named at AAt, can have a hidden holder keep the strings
    // its C string fields are given (F4 / F4b, BNF sec 6): a local or a module variable of a
    // record, overlay or static array type, not external, that has a holder (a public
    // module variable's is made at its own unit's compile, DoPublicHolders, so a store
    // from any module reaches it), or is declared in the source module that holds AAt, or
    // is another source module's variable DoPublicHeld (its holder made with the rest); a
    // compiled unit's variable with no holder takes none
    hidden const method DoHoldsDecl(const ADecl: int64; const AAt: int64): bool;
    var
      LRole: NodeRole;
      LClass: TypeClass;
      LModule: int64;
    begin
      if (ADecl <= 0) or (self.FTree[ADecl].Kind <> NodeKind.VarDecl) or
        (self.FTree.FirstOf(ADecl, NodeRole.External) <> 0) or IsCTextHolder(self.FTree, ADecl) then
        return false;
      end;
      LRole := self.FTree.RoleOf(ADecl);
      if (LRole <> NodeRole.Local) and (LRole <> NodeRole.Statement) and (LRole <> NodeRole.Declaration) then
        return false;
      end;
      LClass := self.DoClass(VariableTypeOf(self.FTree, ADecl));
      if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.OverlayType) and
        (LClass <> TypeClass.StaticArray) then
        return false;
      end;
      if self.DoHolderOf(ADecl) <> 0 then
        return true;
      end;
      LModule := ModuleOf(self.FTree, ADecl);
      if (LModule = 0) or self.FTree[LModule].HasFlag(NodeFlag.Compiled) or
        self.FTree[ADecl].HasFlag(NodeFlag.Compiled) then
        return false;
      end;
      if LModule = ModuleOf(self.FTree, AAt) then
        return true;
      end;
      return self.DoPublicHeld(ADecl);
    end;

    // True when the module variable ADecl gets its holder at its own unit's compile (F4b,
    // DoPublicHolders): a public one, not external, of a record, overlay or static array
    // type holding a C string pointer (HoldsCText)
    hidden const method DoPublicHeld(const ADecl: int64): bool;
    var
      LClass: TypeClass;
    begin
      if (self.FTree[ADecl].Kind <> NodeKind.VarDecl) or (self.FTree.RoleOf(ADecl) <> NodeRole.Declaration) or
        not self.FTree[ADecl].HasFlag(NodeFlag.Public) or
        (self.FTree.FirstOf(ADecl, NodeRole.External) <> 0) or IsCTextHolder(self.FTree, ADecl) then
        return false;
      end;
      LClass := self.DoClass(VariableTypeOf(self.FTree, ADecl));
      if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.OverlayType) and
        (LClass <> TypeClass.StaticArray) then
        return false;
      end;
      return HoldsCText(self.FTree, VariableTypeOf(self.FTree, ADecl));
    end;

    // Every public module variable of a source module that DoPublicHeld given its hidden
    // holder (F4b, his word 2026-11-23): made at its own unit's compile and kept in its
    // .acu with it (reached by its ResolvedJump), its symbol public as its variable's
    // (Symbols.HasInternalSymbol), so another module's store into its C string fields, or
    // copy of it, reaches the texts
    hidden method DoPublicHolders();
    var
      LModule: int64;
      LDecls: ref NodeList;
      LChild: int64;
      LI: int64;
      LJ: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        LModule := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        if self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
          skip;
        end;
        // the module's declarations taken first: a holder made reorders them
        LDecls := ref NodeList();
        for LJ := 0 to self.FTree.CountOf(LModule, NodeRole.Declaration) - 1 do
          LChild := self.FTree.NthOf(LModule, NodeRole.Declaration, LJ);
          if not self.FTree[LChild].HasFlag(NodeFlag.Recovered) and self.DoPublicHeld(LChild) then
            LDecls.Add(LChild);
          end;
        end;
        for LJ := 0 to LDecls.Count - 1 do
          self.DoEnsureHolder(LDecls.Items[LJ]);
        end;
      end;
    end;
    // The variable the place AExpr lies in when a hidden holder can keep the strings its C
    // string fields are given (F4, BNF sec 6): AExpr a name, or a value field of a record /
    // overlay or a static array's element (any index) reached from one, the name a local
    // or a module variable a holder can keep texts for (DoHoldsDecl); AField: AExpr must be
    // a field or an element, not the name itself. 0 for any other place: through a
    // pointer, a deref, an own / ref, an object, a dynamic array, a property, a
    // parameter's record, a function's result
    hidden const method DoHoldRoot(const AExpr: int64; const AField: bool): int64;
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
      LOperand: int64;
      LClass: TypeClass;
      LSteps: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      LSteps := 0;
      while LAt <> 0 do
        LKind := self.FTree[LAt].Kind;
        if LKind = NodeKind.MemberExpression then
          LDecl := self.FTree[LAt].ResolvedDecl;
          if self.FTree[LAt].HasFlag(NodeFlag.Arrow) or (LDecl = 0) or
            (self.FTree[LDecl].Kind <> NodeKind.FieldDecl) or (self.FTree[LAt].ResolvedEmbed <> 0) then
            return 0;
          end;
          LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
          LClass := self.DoClass(self.DoTypeOf(LOperand));
          if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.OverlayType) then
            return 0;
          end;
          LAt := self.DoSkipParens(LOperand);
          LSteps := LSteps + 1;
        else
          if LKind = NodeKind.IndexExpression then
            LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
            if (self.DoPropertyOf(LAt) <> 0) or
              (self.DoClass(self.DoTypeOf(LOperand)) <> TypeClass.StaticArray) then
              return 0;
            end;
            LAt := self.DoSkipParens(LOperand);
            LSteps := LSteps + 1;
          else
            if (LKind <> NodeKind.NameExpression) or (AField and (LSteps = 0)) then
              return 0;
            end;
            LDecl := self.FTree[LAt].ResolvedDecl;
            if not self.DoHoldsDecl(LDecl, AExpr) then
              return 0;
            end;
            return LDecl;
          end;
        end;
      end;
      return 0;
    end;

    // The hidden holder of the variable ADecl (F4: a VarDecl Semantics added beside it,
    // linked both ways by ResolvedJump; DoEnsureHolder); 0 for none, and for a holder itself
    hidden const method DoHolderOf(const ADecl: int64): int64;
    begin
      if (ADecl <= 0) or (self.FTree[ADecl].Kind <> NodeKind.VarDecl) or IsCTextHolder(self.FTree, ADecl) then
        return 0;
      end;
      return self.FTree[ADecl].ResolvedJump;
    end;

    // The variable ARoot (DoHoldRoot's) given its hidden holder once (F4, BNF sec 6): a
    // variable beside it (the same parent and role: a local of its routine, a module
    // variable of its module, thread-static with it) of type array[0..N-1] of string, N
    // its words (a C string field at byte offset F keeps its text in element F div 8:
    // Lowering's DoHolderSlot), so its scope's end, an exit, an unwind or module teardown
    // releases the texts as any string variable's; linked both ways by ResolvedJump. It
    // stands just before its variable (a statement list's local is made where it stands:
    // the holder is ready before the variable's initializer copies into it)
    hidden method DoEnsureHolder(const ARoot: int64);
    var
      LSize: int64;
      LHolder: int64;
      LParent: int64;
      LOrder: ref NodeList;
      LChild: int64;
      LI: int64;
      LFirst: bool;
    begin
      if self.FTree[ARoot].ResolvedJump <> 0 then
        return;
      end;
      LSize := TypeSize(self.FTree, self.FTarget, VariableTypeOf(self.FTree, ARoot));
      if LSize < 8 then
        LSize := 8;
      end;
      // no source span (F4c): the compiler's own, so no tool (debug info, LSP) sees it
      LHolder := self.FTree.AddChild(self.FTree.ParentOf(ARoot), self.FTree.RoleOf(ARoot), NodeKind.VarDecl,
        NoPlace(), 0, 0);
      self.FTree[LHolder].Text := ADAM_HOLDER_PREFIX + self.FTree[ARoot].Text;
      self.FTree[LHolder].ResolvedType := StaticArrayOf(self.FTree, uint64((LSize + 7) div 8 - 1),
        self.DoBuiltin("string"));
      if self.FTree[ARoot].HasFlag(NodeFlag.ThreadStatic) then
        self.FTree[LHolder].AddFlag(NodeFlag.ThreadStatic);
      end;
      self.FTree[LHolder].ResolvedJump := ARoot;
      self.FTree[ARoot].ResolvedJump := LHolder;
      self.FHolders := self.FHolders + 1;
      // typed here, whole: no walk visits it as a written declaration
      LFirst := self.DoFirstVisit(LHolder);
      LParent := self.FTree.ParentOf(ARoot);
      LOrder := ref NodeList();
      for LI := 0 to self.FTree.ChildCount(LParent) - 1 do
        LChild := self.FTree.ChildAt(LParent, LI);
        if LChild = ARoot then
          LOrder.Add(LHolder);
        end;
        if LChild <> LHolder then
          LOrder.Add(LChild);
        end;
      end;
      self.FTree.ReorderChildren(LParent, LOrder);
    end;

    // The assignment AId of ASource to ATarget, a C string pointer of type AType (F4, BNF
    // sec 6): a string of no constant text (DoTextArgTakes) converts when the place lies in
    // a variable a holder can keep it in (DoHoldRoot: its holder made, the assignment's
    // ResolvedJump that variable), else SM0759 naming CString; any other value stored into
    // such a field of a variable notes the variable too (Lowering empties the field's holder
    // element when the variable has a holder). True when the source was taken here (no
    // conversion left to check)
    hidden method DoCTextStore(const AId: int64; const ATarget: int64; const ASource: int64;
      const AType: int64): bool;
    var
      LRoot: int64;
    begin
      LRoot := self.DoHoldRoot(ATarget, true);
      if not self.DoTextArgTakes(ASource, AType) then
        self.FTree[AId].ResolvedJump := LRoot;
        return false;
      end;
      self.FTree[ASource].ResolvedConvert := AType;
      if LRoot = 0 then
        self.DoError(ASource, ADAM_ERR_SEMANTICS_759, ADAM_MSG_SEMANTICS_CTEXT_UNTRACKED,
          NoArgs().Str(self.DoExprText(ATarget)).Str(self.DoText(AType)));
        return true;
      end;
      self.DoEnsureHolder(LRoot);
      self.FTree[AId].ResolvedJump := LRoot;
      return true;
    end;

    // The copy site AId (an aggregate assignment, or a local's initializer when ASite is its
    // VarDecl) of ASource, a value of a type holding C string pointers (HoldsCText): the
    // source's variable (DoHoldRoot) noted on it (ResolvedJump), the site kept for
    // DoCTextHolds, which gives the target's variable a holder when the source's has one
    hidden method DoNoteCTextCopy(const ASite: int64; const ASource: int64);
    var
      LRoot: int64;
    begin
      LRoot := self.DoHoldRoot(ASource, false);
      if LRoot = 0 then
        return;
      end;
      self.FTree[self.DoSkipParens(ASource)].ResolvedJump := LRoot;
      self.FHoldCopies.Add(ASite);
    end;

    // The borrowed strings' rules settled once the program is typed (F4, BNF sec 6): each
    // copy site (FHoldCopies) whose source's variable has a holder gives its target's one,
    // until no holder is added (a copy may come before the store that made the source's
    // holder: a loop's), each record literal's borrowed field (FHoldLiterals) giving the
    // variable it goes into one first (DoLiteralRoot; none: SM0759); a target no holder
    // can keep is SM0760, as is a return of such a
    // variable (FHoldReturns) and an async block's copy of one. Each func literal or for
    // parallel that captures a variable with a holder captures the holder too (its stores
    // and its copies reach it there; the closure keeps the texts with the variable)
    hidden method DoCTextHolds();
    var
      LChanged: bool;
      LSite: int64;
      LSource: int64;
      LTarget: int64;
      LFrom: int64;
      LKind: NodeKind;
      LHolder: int64;
      LAsync: int64;
      LCapture: int64;
      LI: int64;
      LJ: int64;
      LSeen: bool;
      LReported: ref Int64Map;
      LAsyncSeen: ref Int64Map;
    begin
      LReported := ref Int64Map(0);
      LAsyncSeen := ref Int64Map(0);
      // a record literal's borrowed field: kept by the holder of the variable it goes into
      for LI := 0 to self.FHoldLiterals.Count - 1 do
        LSource := self.FHoldLiterals.Items[LI];
        LSite := self.FTree.ParentOf(self.FTree.ParentOf(LSource));
        LTarget := self.DoLiteralRoot(LSite);
        if LTarget = 0 then
          self.DoError(LSource, ADAM_ERR_SEMANTICS_759, ADAM_MSG_SEMANTICS_CTEXT_UNTRACKED,
            NoArgs().Str(self.DoLiteralPlace(LSource)).Str(self.DoText(self.FTree[LSource].ResolvedConvert)));
        else
          self.DoEnsureHolder(LTarget);
        end;
      end;
      LChanged := true;
      while LChanged do
        LChanged := false;
        for LI := 0 to self.FHoldCopies.Count - 1 do
          LSite := self.FHoldCopies.Items[LI];
          if self.FTree[LSite].Kind = NodeKind.VarDecl then
            LSource := self.FTree.FirstOf(LSite, NodeRole.Initializer);
            // a local's or a module variable's initializer (DoGlobalInit carries the texts)
            LTarget := 0;
            if self.DoHoldsDecl(LSite, LSite) then
              LTarget := LSite;
            end;
          else
            LSource := self.FTree.FirstOf(LSite, NodeRole.Source);
            LTarget := self.FTree[LSite].ResolvedJump;
          end;
          LFrom := self.FTree[self.DoSkipParens(LSource)].ResolvedJump;
          if self.DoHolderOf(LFrom) = 0 then
            skip;
          end;
          if LTarget = 0 then
            if LReported.Find(LSite) = 0 then
              LReported.Put(LSite, 1);
              if self.FTree[LSite].Kind = NodeKind.VarDecl then
                self.DoError(LSite, ADAM_ERR_SEMANTICS_760, ADAM_MSG_SEMANTICS_CTEXT_COPIED,
                  NoArgs().Str(self.FTree[LFrom].Text).Str(self.FTree[LSite].Text));
              else
                self.DoError(LSource, ADAM_ERR_SEMANTICS_760, ADAM_MSG_SEMANTICS_CTEXT_COPIED,
                  NoArgs().Str(self.FTree[LFrom].Text).Str(self.DoExprText(self.FTree.FirstOf(LSite, NodeRole.Target))));
              end;
            end;
            skip;
          end;
          if self.FTree[LTarget].ResolvedJump = 0 then
            self.DoEnsureHolder(LTarget);
            LChanged := true;
          end;
        end;
      end;
      for LI := 0 to self.FHoldReturns.Count - 1 do
        LSource := self.FHoldReturns.Items[LI];
        LFrom := self.FTree[self.DoSkipParens(LSource)].ResolvedJump;
        if self.DoHolderOf(LFrom) <> 0 then
          self.DoError(LSource, ADAM_ERR_SEMANTICS_760, ADAM_MSG_SEMANTICS_CTEXT_RETURNED,
            NoArgs().Str(self.FTree[LFrom].Text));
        end;
      end;
      if self.FHolders = 0 then
        return;
      end;
      for LI := 1 to self.FTree.Count - 1 do
        LKind := self.FTree[LI].Kind;
        if (LKind = NodeKind.Capture) and (self.FTree[LI].ResolvedDecl > 0) then
          LHolder := self.DoHolderOf(self.FTree[LI].ResolvedDecl);
          if LHolder <> 0 then
            LSeen := false;
            for LJ := 0 to self.FTree.CountOf(self.FTree.ParentOf(LI), NodeRole.Capture) - 1 do
              if self.FTree[self.FTree.NthOf(self.FTree.ParentOf(LI), NodeRole.Capture, LJ)].ResolvedDecl = LHolder then
                LSeen := true;
              end;
            end;
            if not LSeen then
              // a holder's capture has no source span, as its holder (F4c)
              LCapture := self.FTree.AddChild(self.FTree.ParentOf(LI), NodeRole.Capture, NodeKind.Capture,
                NoPlace(), 0, 0);
              self.FTree[LCapture].ResolvedDecl := LHolder;
            end;
          end;
        end;
        if (LKind = NodeKind.NameExpression) and (self.DoHolderOf(self.FTree[LI].ResolvedDecl) <> 0) then
          LAsync := self.DoAsyncCopy(LI, self.FTree[LI].ResolvedDecl);
          // one report per variable: its first use in an async block
          if (LAsync <> 0) and (LAsyncSeen.Find(self.FTree[LI].ResolvedDecl) = 0) then
            LAsyncSeen.Put(self.FTree[LI].ResolvedDecl, 1);
            self.DoError(LI, ADAM_ERR_SEMANTICS_760, ADAM_MSG_SEMANTICS_CTEXT_ASYNC,
              NoArgs().Str(self.FTree[LI].Text));
          end;
        end;
      end;
    end;

    // True when the constant AExpr (of type AFrom) is a value ATarget holds exactly: an
    // integer constant an integer type it fits, or a float whose mantissa holds its
    // significant bits (24 / 53, after its trailing zero bits: 2^30 is exact in a float32);
    // a float64 constant a float32 that holds it exactly (an infinity is exact, a NaN never)
    hidden const method DoConstTakes(const AExpr: int64; const AFrom: int64;
      const ATarget: int64): bool;
    var
      LNegative: bool;
      LMagnitude: uint64;
      LConst: ConstValue;
    begin
      if (self.DoClass(AFrom) = TypeClass.Float) and (self.DoClass(ATarget) = TypeClass.Float) and
        (FloatBits(self.FTree, ATarget) = 32) then
        LConst := self.FTree[AExpr].ResolvedConst;
        return (LConst.Kind = ConstKind.Float) and FloatFitsSingle(LConst.Float);
      end;
      if not IsIntegerClass(self.DoClass(AFrom)) then
        return false;
      end;
      if not ConstIntOf(self.FTree, AExpr, LNegative, LMagnitude) then
        return false;
      end;
      if IsIntegerClass(self.DoClass(ATarget)) then
        return IntFits(self.FTree, ATarget, LNegative, LMagnitude);
      end;
      if self.DoClass(ATarget) = TypeClass.Float then
        if FloatBits(self.FTree, ATarget) = 32 then
          return FitsMantissa(LMagnitude, 24);
        end;
        return FitsMantissa(LMagnitude, 53);
      end;
      return false;
    end;

    // True when the value AExpr converts to ATarget with no cast (no report): the same or
    // an unknown type, the implicit rule, a literal's type-driven form, a constant that
    // fits
    hidden const method DoWouldConvert(const AExpr: int64; const ATarget: int64): bool;
    var
      LFrom: int64;
    begin
      if self.DoIsGenericValue(self.DoSkipParens(AExpr)) then
        return self.DoGenericValueFits(self.DoSkipParens(AExpr), ATarget);
      end;
      // a method named as a value: a closure of its shape binds it (F2b)
      if self.DoMethodValue(self.DoSkipParens(AExpr)) <> 0 then
        return (self.DoClass(ATarget) = TypeClass.ClosureType) and
          (self.DoFittingOverload(self.DoMethodValue(self.DoSkipParens(AExpr)), ATarget) <> 0);
      end;
      LFrom := self.DoTypeOf(AExpr);
      if ConvertsImplicitly(self.FTree, LFrom, ATarget) then
        return true;
      end;
      if self.DoLiteralTakes(self.DoSkipParens(AExpr), ATarget) then
        return true;
      end;
      return self.DoConstTakes(AExpr, LFrom, ATarget);
    end;

    // The method the member access ARoot names as a value, not called (F2b, BNF sec 4 O13):
    // one that takes self (a static method is a routine's); 0 for anything else
    hidden const method DoMethodValue(const ARoot: int64): int64;
    var
      LDecl: int64;
    begin
      if (ARoot = 0) or (self.FTree[ARoot].Kind <> NodeKind.MemberExpression) or
        (self.FTree.RoleOf(ARoot) = NodeRole.Callee) then
        return 0;
      end;
      LDecl := self.FTree[ARoot].ResolvedDecl;
      if (LDecl <= 0) or (self.FTree[LDecl].Kind <> NodeKind.MethodDecl) or
        self.FTree[LDecl].HasFlag(NodeFlag.Static) then
        return 0;
      end;
      return LDecl;
    end;

    // The method of AMethod's name and level that fits the closure type ATarget bound to
    // its object (F2b, MethodFitsClosure): AMethod itself, else an overload beside it; 0
    // for none
    hidden const method DoFittingOverload(const AMethod: int64; const ATarget: int64): int64;
    var
      LLevel: int64;
      LMember: int64;
      LI: int64;
    begin
      if MethodFitsClosure(self.FTree, AMethod, ATarget) then
        return AMethod;
      end;
      LLevel := self.FTree.ParentOf(AMethod);
      for LI := 0 to self.FTree.CountOf(LLevel, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LLevel, NodeRole.Member, LI);
        if (LMember <> AMethod) and (self.FTree[LMember].Kind = NodeKind.MethodDecl) and
          (not self.FTree[LMember].HasFlag(NodeFlag.Static)) and
          (self.FTree[LMember].Text = self.FTree[AMethod].Text) and
          MethodFitsClosure(self.FTree, LMember, ATarget) then
          return LMember;
        end;
      end;
      return 0;
    end;

    // True when the object the method value ARoot (DoMethodValue) runs on lives in a ref
    // block a closure can hold (F2b, BNF sec 4): reached through a ref / own (of an object
    // or an interface), or self in a ref object's method (F2a0); a value (a local, a field,
    // an embed, P^, parent) cannot be held
    hidden const method DoBindsObject(const ARoot: int64): bool;
    var
      LOperand: int64;
      LClass: TypeClass;
      LRoutine: int64;
    begin
      if self.FTree[ARoot].HasFlag(NodeFlag.Arrow) or (self.FTree[ARoot].ResolvedEmbed <> 0) then
        return false;
      end;
      LOperand := self.DoSkipParens(self.FTree.FirstOf(ARoot, NodeRole.Operand));
      if LOperand = 0 then
        return false;
      end;
      if self.FTree[LOperand].Kind = NodeKind.SelfExpression then
        LRoutine := self.DoEnclosingRoutine(LOperand);
        return (LRoutine <> 0) and IsRefOnly(self.FTree, MethodOwnerTypeOf(self.FTree, LRoutine));
      end;
      LClass := self.DoClass(self.DoTypeOf(LOperand));
      return (LClass = TypeClass.RefType) or (LClass = TypeClass.OwnType);
    end;

    // The method value AExpr (ARoot its member access naming AMethod, DoMethodValue) where
    // a value of ATarget is needed (F2b, BNF sec 4): a closure type of the method's shape (it
    // or an overload beside it, DoFittingOverload) takes it bound to its object: true,
    // ARoot's ResolvedDecl that method and AExpr's ResolvedConvert ATarget, when the object
    // lives in a ref block (DoBindsObject); else SM0432 (O13: a method has no routine value;
    // or its object is a value) and false
    hidden method DoMethodValueTo(const AExpr: int64; const ARoot: int64; const AMethod: int64;
      const ATarget: int64): bool;
    var
      LFit: int64;
    begin
      LFit := 0;
      if self.DoClass(ATarget) = TypeClass.ClosureType then
        LFit := self.DoFittingOverload(AMethod, ATarget);
      end;
      if LFit = 0 then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_432, ADAM_MSG_SEMANTICS_METHOD_VALUE,
          NoArgs().Str(self.DoExprText(ARoot)));
        return false;
      end;
      if not self.DoBindsObject(ARoot) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_432, ADAM_MSG_SEMANTICS_METHOD_RECEIVER,
          NoArgs().Str(self.DoExprText(ARoot)));
        return false;
      end;
      self.FTree[ARoot].ResolvedDecl := LFit;
      self.FTree[AExpr].ResolvedConvert := ATarget;
      return true;
    end;

    // True when a cast to ATo takes a value of AFrom (BNF sec 6 type cast): numbers,
    // chars, bools and choices values among the numbers; a pointer to an integer of
    // pointer width; an integer to a char or a choices type; a set and an integer by the
    // members' values as bit numbers (F6a, DoSetBitsFit); a pointer cast's values; a
    // routine value to the untyped ptr and back
    hidden const method DoCastTakes(const AFrom: int64; const ATo: int64): bool;
    var
      LFrom: TypeClass;
      LTo: TypeClass;
    begin
      if ConvertsImplicitly(self.FTree, AFrom, ATo) then
        return true;
      end;
      LFrom := self.DoClass(AFrom);
      LTo := self.DoClass(ATo);
      if (LFrom = TypeClass.SetType) and IsIntegerClass(LTo) then
        return self.DoSetBitsFit(AFrom, IntBits(self.FTree, ATo));
      end;
      if (LTo = TypeClass.SetType) and IsIntegerClass(LFrom) then
        return self.DoSetBitsFit(ATo, 64);
      end;
      if IsNumericClass(LTo) then
        if IsNumericClass(LFrom) or (LFrom = TypeClass.Char) or (LFrom = TypeClass.WideChar) or
          (LFrom = TypeClass.Boolean) or (LFrom = TypeClass.ChoicesType) then
          return true;
        end;
        return IsPointerClass(LFrom) and IsIntegerClass(LTo) and (IntBits(self.FTree, ATo) = 64);
      end;
      if LTo = TypeClass.Boolean then
        return IsNumericClass(LFrom);
      end;
      // a float too, truncated toward 0 (BNF sec 6: a float constant converts only when the
      // type holds its integer part, Folding's SM0200)
      if (LTo = TypeClass.Char) or (LTo = TypeClass.WideChar) then
        return IsNumericClass(LFrom) or (LFrom = TypeClass.Char) or (LFrom = TypeClass.WideChar);
      end;
      if LTo = TypeClass.ChoicesType then
        return IsIntegerClass(LFrom);
      end;
      // A routine value and the untyped ptr cast to each other (user 2026-11-08: a hook's
      // real function, System.HookABI's HookReal, is called through the hook's routine type)
      if LTo = TypeClass.UntypedPointer then
        return IsPointerClass(LFrom) or (LFrom = TypeClass.RoutineType) or
          (IsIntegerClass(LFrom) and (IntBits(self.FTree, AFrom) = 64));
      end;
      if LTo = TypeClass.RoutineType then
        return LFrom = TypeClass.UntypedPointer;
      end;
      if LTo = TypeClass.Pointer then
        return self.DoPointerCastTakes(AFrom, ATo);
      end;
      return false;
    end;

    // True when the set type ASet casts to and from an integer of ABits bits (BNF sec 6,
    // F6a): every member's value is a bit of it, 0 .. ABits - 1 (and so at most 63)
    hidden const method DoSetBitsFit(const ASet: int64; const ABits: int64): bool;
    var
      LLow: int64;
      LHigh: int64;
    begin
      if not SetRange(self.FTree, self.FTarget, ASet, LLow, LHigh) then
        return false;
      end;
      return (LLow >= 0) and (LHigh < ABits) and (LHigh <= 63);
    end;

    // SM0761 at AArgument: the set type ASet and the integer type AInteger cast to each other
    // by the members' values as bit numbers, checked against ABits bits (DoSetBitsFit), and
    // one value is no such bit; the value named is the lowest when it is negative, else the
    // largest
    hidden method DoSetBitsError(const AArgument: int64; const ASet: int64; const AInteger: int64;
      const ABits: int64);
    var
      LLow: int64;
      LHigh: int64;
      LBits: int64;
      LValue: int64;
    begin
      LLow := 0;
      LHigh := 0;
      SetRange(self.FTree, self.FTarget, ASet, LLow, LHigh);
      LBits := ABits;
      if LBits > 64 then
        LBits := 64;
      end;
      LValue := LHigh;
      if LLow < 0 then
        LValue := LLow;
      end;
      self.DoError(AArgument, ADAM_ERR_SEMANTICS_761, ADAM_MSG_SEMANTICS_SET_BITS,
        NoArgs().Str(self.DoText(ASet)).Str(self.DoText(AInteger)).Int(LBits - 1).Int(LValue));
    end;

    // True when a pointer cast to ATo takes a value of AFrom (BNF sec 6 pointer cast): a
    // pointer that keeps const (typed or untyped), an integer of pointer width
    hidden const method DoPointerCastTakes(const AFrom: int64; const ATo: int64): bool;
    var
      LFrom: TypeClass;
    begin
      LFrom := self.DoClass(AFrom);
      if LFrom = TypeClass.Pointer then
        return not (IsConstTarget(self.FTree, AFrom) and (not IsConstTarget(self.FTree, ATo)));
      end;
      // the untyped ptr to const (M9h0) keeps const as a ptr to const T does
      if LFrom = TypeClass.UntypedPointer then
        return not (IsConstTarget(self.FTree, AFrom) and (not IsConstTarget(self.FTree, ATo)));
      end;
      return IsIntegerClass(LFrom) and (IntBits(self.FTree, AFrom) = 64);
    end;

    // SM0200 for the value AExpr of AFrom that does not convert to ATarget; the cast is
    // named as the hint when one takes the value
    hidden method DoNoConvert(const AExpr: int64; const AFrom: int64; const ATarget: int64);
    begin
      self.DoNoConvertAt(AExpr, AFrom, ATarget, -1, "");
    end;

    // DoNoConvert for the argument number AArgIndex (from 0) of a call of ACallee: SM0404
    // naming it; AArgIndex -1 is any other place (SM0200)
    hidden method DoNoConvertAt(const AExpr: int64; const AFrom: int64; const ATarget: int64;
      const AArgIndex: int64; const ACallee: string);
    begin
      // A type with a part no name resolved: its fault is reported where it is written
      if HasUnknownPart(self.FTree, AFrom) or HasUnknownPart(self.FTree, ATarget) then
        return;
      end;
      if AArgIndex >= 0 then
        if self.DoCastTakes(AFrom, ATarget) then
          self.DoError(AExpr, ADAM_ERR_SEMANTICS_404, ADAM_MSG_SEMANTICS_ARG_NO_CONVERT_CAST,
            NoArgs().Int(AArgIndex + 1).Str(ACallee).Str(self.DoText(AFrom)).Str(self.DoText(ATarget)).Str(
            self.DoText(ATarget) + "(...)"));
          return;
        end;
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_404, ADAM_MSG_SEMANTICS_ARG_NO_CONVERT,
          NoArgs().Int(AArgIndex + 1).Str(ACallee).Str(self.DoText(AFrom)).Str(self.DoText(ATarget)));
        return;
      end;
      if self.DoCastTakes(AFrom, ATarget) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NO_CONVERT_CAST,
          NoArgs().Str(self.DoText(AFrom)).Str(self.DoText(ATarget)).Str(self.DoText(ATarget) + "(...)"));
        return;
      end;
      self.DoError(AExpr, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NO_CONVERT,
        NoArgs().Str(self.DoText(AFrom)).Str(self.DoText(ATarget)));
    end;

    // SM0200 for the integer constant AExpr that does not fit ATarget, with its range
    hidden method DoNotFit(const AExpr: int64; const ATarget: int64);
    begin
      self.DoNotFitAt(AExpr, ATarget, -1, "");
    end;

    // DoNotFit for the argument number AArgIndex (from 0) of a call of ACallee: SM0404
    // naming it; AArgIndex -1 is any other place (SM0200)
    hidden method DoNotFitAt(const AExpr: int64; const ATarget: int64; const AArgIndex: int64;
      const ACallee: string);
    var
      LNegative: bool;
      LMagnitude: uint64;
      LLow: string;
    begin
      ConstIntOf(self.FTree, AExpr, LNegative, LMagnitude);
      LLow := "0";
      if self.DoClass(ATarget) = TypeClass.SignedInt then
        LLow := "-" + UIntToStr(IntLimit(self.FTree, ATarget, true));
      end;
      if AArgIndex >= 0 then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_404, ADAM_MSG_SEMANTICS_ARG_NOT_FIT,
          NoArgs().Int(AArgIndex + 1).Str(ACallee).Str(ConstIntText(LNegative, LMagnitude)).Str(
          self.DoText(ATarget)).Str(LLow).Str(UIntToStr(IntLimit(self.FTree, ATarget, false))));
        return;
      end;
      self.DoError(AExpr, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NOT_FIT,
        NoArgs().Str(ConstIntText(LNegative, LMagnitude)).Str(self.DoText(ATarget)).Str(LLow).Str(
        UIntToStr(IntLimit(self.FTree, ATarget, false))));
    end;

    // The bitfield the place AExpr names (through parens): its FieldDecl, 0 when AExpr is
    // no member access or names no field written with a width
    hidden const method DoBitfieldIn(const AExpr: int64): int64;
    var
      LAt: int64;
      LDecl: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if (LAt = 0) or (self.FTree[LAt].Kind <> NodeKind.MemberExpression) then
        return 0;
      end;
      LDecl := self.FTree[LAt].ResolvedDecl;
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.FieldDecl) or
        (self.FTree.FirstOf(LDecl, NodeRole.BitWidth) = 0) then
        return 0;
      end;
      return LDecl;
    end;

    // SM0262 at AExpr when it names a bitfield, which has no address (`addr of` it, or it
    // given to a var parameter: C++'s rule, which Adam states itself); true when reported
    hidden method DoBitfieldAddress(const AExpr: int64): bool;
    var
      LField: int64;
    begin
      LField := self.DoBitfieldIn(AExpr);
      if LField = 0 then
        return false;
      end;
      self.DoError(AExpr, ADAM_ERR_SEMANTICS_262, ADAM_MSG_SEMANTICS_BITFIELD_ADDRESS,
        NoArgs().Str(self.FTree[LField].Text));
      return true;
    end;

    // The pack limit (0 none) a packed level places the member AMember reached on a value of
    // AType with (BNF PLAN-RECORDS M8 / M10, M9e0d): the tightest of its own body's and the
    // anonymous parts' around it, and of each level between AType and the type that
    // declares AMember (a packed extension packs its parent part, which starts at its
    // offset 0)
    hidden const method DoLevelsPack(const AType: int64; const AMember: int64): int64;
    var
      LAt: int64;
      LOwner: int64;
      LLevel: int64;
      LBody: int64;
      LDepth: int64;
      LPack: int64;
    begin
      LPack := 0;
      LAt := self.FTree.ParentOf(AMember);
      while (LAt <> 0) and (self.FTree[LAt].Kind <> NodeKind.TypeDecl) do
        LPack := InnerPack(LPack, PackLimit(self.FTree, self.FTarget, LAt));
        LAt := self.FTree.ParentOf(LAt);
      end;
      LOwner := self.DoDeclaringType(AMember);
      LLevel := AType;
      LDepth := 0;
      while (LLevel <> 0) and (LLevel <> LOwner) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
        LBody := BodyOf(self.FTree, LLevel);
        LPack := InnerPack(LPack, PackLimit(self.FTree, self.FTarget, LBody));
        LLevel := ParentTypeOf(self.FTree, LLevel);
        LDepth := LDepth + 1;
      end;
      return LPack;
    end;

    // The pack limit (0 none) the place AExpr (through parens) is reached through, so it is
    // only sure to sit at that alignment (pcpp's OnPackedPath): the tightest a packed level
    // of a field's access places it with (DoLevelsPack, each embed on the way included), of
    // any field or static array element of a place reached so. A pointer's target (-> or a
    // dereference) is aligned: only the placement inside it counts
    hidden const method DoPathPack(const AExpr: int64): int64;
    var
      LAt: int64;
      LKind: NodeKind;
      LOperand: int64;
      LType: int64;
      LDecl: int64;
      LEmbed: int64;
      LI: int64;
      LPack: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return 0;
      end;
      LKind := self.FTree[LAt].Kind;
      LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
      if LKind = NodeKind.IndexExpression then
        // A static array's element sits where its array does; any other array's elements
        // (and a pointer's) live apart, aligned
        if self.DoClass(self.DoTypeOf(LOperand)) = TypeClass.StaticArray then
          return self.DoPathPack(LOperand);
        end;
        return 0;
      end;
      if LKind <> NodeKind.MemberExpression then
        return 0;
      end;
      LDecl := self.FTree[LAt].ResolvedDecl;
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.FieldDecl) then
        return 0;
      end;
      LPack := 0;
      LType := self.DoTypeOf(LOperand);
      if self.DoClass(LType) = TypeClass.Pointer then
        LType := TargetOf(self.FTree, LType);
      else
        LPack := self.DoPathPack(LOperand);
      end;
      // Through each embed on the way, outermost first: each one is a field of its level
      LEmbed := self.FTree[LAt].ResolvedEmbed;
      if LEmbed <> 0 then
        LPack := InnerPack(LPack, self.DoLevelsPack(LType, LEmbed));
        LType := self.DoEmbedTypeOf(LEmbed);
        for LI := 0 to self.FTree.CountOf(LAt, NodeRole.EmbedStep) - 1 do
          LEmbed := self.FTree[self.FTree.NthOf(LAt, NodeRole.EmbedStep, LI)].ResolvedDecl;
          LPack := InnerPack(LPack, self.DoLevelsPack(LType, LEmbed));
          LType := self.DoEmbedTypeOf(LEmbed);
        end;
      end;
      return InnerPack(LPack, self.DoLevelsPack(LType, LDecl));
    end;

    // True when the place AExpr may be misaligned (BNF PLAN-RECORDS M8, M9e0d): a packed
    // level places it (DoPathPack) and its type aligns above that level's limit. An unknown
    // alignment (no target, a type with no layout) is silent: reported where it was lost
    hidden const method DoMayBeMisaligned(const AExpr: int64): bool;
    var
      LPack: int64;
    begin
      LPack := self.DoPathPack(AExpr);
      if LPack = 0 then
        return false;
      end;
      return TypeAlign(self.FTree, self.FTarget, self.DoTypeOf(AExpr)) > LPack;
    end;

    // True when the part of its record ancestor ATo inside a value of the record AFrom may
    // be misaligned (pcpp's ParentPartMayBeMisaligned): every parent part starts at offset
    // 0 of its level, so it is aligned unless a level from AFrom up to ATo is packed (to
    // the tightest limit of them) and ATo aligns above that limit
    hidden const method DoPartMisaligned(const AFrom: int64; const ATo: int64): bool;
    var
      LLevel: int64;
      LTo: int64;
      LBody: int64;
      LDepth: int64;
      LPack: int64;
    begin
      LTo := ATo;
      LLevel := AFrom;
      if (LLevel = 0) or (LLevel = LTo) or (self.DoClass(LTo) <> TypeClass.RecordType) then
        return false;
      end;
      LPack := 0;
      LDepth := 0;
      while (LLevel <> 0) and (LLevel <> LTo) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
        LBody := BodyOf(self.FTree, LLevel);
        LPack := InnerPack(LPack, PackLimit(self.FTree, self.FTarget, LBody));
        LLevel := ParentTypeOf(self.FTree, LLevel);
        LDepth := LDepth + 1;
      end;
      if (LLevel <> LTo) or (LPack = 0) then
        return false;
      end;
      return TypeAlign(self.FTree, self.FTarget, LTo) > LPack;
    end;

    // SM0270 at the argument AArgument of the var parameter AName of type AParamType when
    // it may be misaligned (a var parameter binds its address, which promises its type's
    // alignment) or it is taken at a record ancestor's part that may be (DoPartMisaligned);
    // true when reported
    hidden method DoMisalignedVar(const AArgument: int64; const AName: string; const AParamType: int64): bool;
    var
      LFrom: int64;
    begin
      if self.DoMayBeMisaligned(AArgument) then
        self.DoError(AArgument, ADAM_ERR_SEMANTICS_270, ADAM_MSG_SEMANTICS_MISALIGNED_VAR,
          NoArgs().Str(AName).Str(self.DoExprText(AArgument)));
        return true;
      end;
      LFrom := self.DoTypeOf(AArgument);
      if self.DoPartMisaligned(LFrom, AParamType) then
        self.DoError(AArgument, ADAM_ERR_SEMANTICS_270, ADAM_MSG_SEMANTICS_MISALIGNED_UPCAST,
          NoArgs().Str(self.DoExprText(AArgument)).Str(self.DoText(AParamType)).Str(self.DoText(LFrom)));
        return true;
      end;
      return false;
    end;

    // SM0270 at AExpr when the pointer value of AFrom it is, converted to the pointer type
    // ATo, points at a record ancestor's part that may be misaligned (DoPartMisaligned)
    hidden method DoPointerUpcast(const AExpr: int64; const AFrom: int64; const ATo: int64);
    var
      LFromTarget: int64;
    begin
      if (self.DoClass(AFrom) <> TypeClass.Pointer) or (self.DoClass(ATo) <> TypeClass.Pointer) then
        return;
      end;
      LFromTarget := TargetOf(self.FTree, AFrom);
      if self.DoPartMisaligned(LFromTarget, TargetOf(self.FTree, ATo)) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_270, ADAM_MSG_SEMANTICS_MISALIGNED_UPCAST,
          NoArgs().Str(self.DoExprText(AExpr)).Str(self.DoText(ATo)).Str(self.DoText(LFromTarget)));
      end;
    end;

    // BNF F37: the constant AValue stored into the bitfield AField (`:=`, a record literal's
    // field; AValue already converts to the field's type) must fit its width, as a signed
    // value for a signed type, else an unsigned one (DoUnsignedValues); SM0200 names the
    // type as 'T : width' with that range. A value that folds to no constant is not
    // checked, nor a bool field (0 and 1 fit any width), a width Layout refuses (SM0315)
    // or a width of 64 (every value of the type fits)
    hidden method DoBitStore(const AField: int64; const AValue: int64);
    var
      LType: int64;
      LWidth: int64;
      LBits: int64;
      LHigh: int64;
      LLow: int64;
      LValueText: string;
      LLowText: string;
    begin
      LType := self.DoDeclType(AField);
      if (LType = 0) or (self.DoClass(LType) = TypeClass.Boolean) then
        return;
      end;
      if not BoundValue(self.FTree, self.FTarget, self.FTree.FirstOf(AField, NodeRole.BitWidth), LWidth) then
        return;
      end;
      if (LWidth < 1) or (LWidth >= 64) then
        return;
      end;
      if not self.DoFoldedBits(AValue, LType, LBits) then
        return;
      end;
      if self.DoUnsignedValues(LType) then
        LHigh := BitMask(LWidth, 0);
        if uint64(LBits) <= uint64(LHigh) then
          return;
        end;
        LValueText := UIntToStr(uint64(LBits));
        LLowText := "0";
      else
        // A signed width of W bits holds -2^(W-1) .. 2^(W-1) - 1
        LHigh := BitMask(LWidth, 0) div 2;
        LLow := -LHigh - 1;
        if (LBits >= LLow) and (LBits <= LHigh) then
          return;
        end;
        LValueText := IntToStr(LBits);
        LLowText := IntToStr(LLow);
      end;
      self.DoError(AValue, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NOT_FIT,
        NoArgs().Str(LValueText).Str(self.DoText(LType) + " : " + IntToStr(LWidth)).Str(
        LLowText).Str(IntToStr(LHigh)));
    end;

    // The element type of the set type ASet: `set of T`'s T, a range set's bounds' type
    // (Types.SetMemberOf, the bound visited first when it is not typed yet)
    hidden method DoSetElement(const ASet: int64): int64;
    var
      LBody: int64;
    begin
      LBody := BodyOf(self.FTree, ASet);
      if (SetElementOf(self.FTree, ASet) = 0) and (LBody <> 0) and
        (self.FTree.FirstOf(LBody, NodeRole.LowBound) <> 0) then
        self.DoVisit(self.FTree.FirstOf(LBody, NodeRole.LowBound));
      end;
      return SetMemberOf(self.FTree, ASet);
    end;

    // The bracket literal ARoot (AExpr with its parentheses off) where a value of the array
    // type ATarget goes (BNF sec 6 array literal): an array literal, so the node becomes an
    // ArrayLiteral (Folding and Lowering read the kind); each element converts to the
    // element type as in an assignment, one written as a range is SM0706; a static array
    // takes exactly its range's count (SM0705 names both counts), a dynamic one any count.
    // ARoot and AExpr take ATarget
    hidden method DoConvertArray(const AExpr: int64; const ARoot: int64; const ATarget: int64): bool;
    var
      LElement: int64;
      LCount: int64;
      LWant: int64;
      LI: int64;
      LItem: int64;
      LOk: bool;
    begin
      self.FTree[ARoot].Kind := NodeKind.ArrayLiteral;
      LElement := TargetOf(self.FTree, ATarget);
      LCount := self.FTree.CountOf(ARoot, NodeRole.Element);
      LOk := true;
      for LI := 0 to LCount - 1 do
        LItem := self.FTree.NthOf(ARoot, NodeRole.Element, LI);
        if self.FTree.FirstOf(LItem, NodeRole.HighBound) <> 0 then
          self.DoError(LItem, ADAM_ERR_SEMANTICS_706, ADAM_MSG_SEMANTICS_ARRAY_RANGE, NoArgs());
          LOk := false;
        else
          // a string borrowed by a static array literal's C string element (F4b)
          if not self.DoLiteralCText(ARoot, self.FTree.FirstOf(LItem, NodeRole.LowBound), LElement) and
            not self.DoConvert(self.FTree.FirstOf(LItem, NodeRole.LowBound), LElement) then
            LOk := false;
          end;
        end;
      end;
      if self.DoClass(ATarget) = TypeClass.StaticArray then
        LWant := ArrayCount(self.FTree, self.FTarget, ATarget);
        if (LWant >= 0) and (LWant <> LCount) then
          self.DoError(AExpr, ADAM_ERR_SEMANTICS_705, ADAM_MSG_SEMANTICS_ARRAY_COUNT,
            NoArgs().Int(LCount).Str(self.DoText(ATarget)).Int(LWant));
          LOk := false;
        end;
      end;
      self.DoSetType(ARoot, ATarget);
      self.DoSetType(AExpr, ATarget);
      return LOk;
    end;

    // A set literal ARoot written with a comma before its `]` (the parser's TrailingComma:
    // BNF sec 6 gives the comma to an array literal only) is SM0707, once at its node
    hidden method DoSetComma(const ARoot: int64);
    begin
      if self.FTree[ARoot].HasFlag(NodeFlag.TrailingComma) then
        self.DoError(ARoot, ADAM_ERR_SEMANTICS_707, ADAM_MSG_SEMANTICS_SET_COMMA, NoArgs());
      end;
    end;

    // A const's initializer AInit (BNF sec 3: a constant expression; sec 6: in a const every
    // element folds): an array, record or set literal has each part checked by DoConstPart;
    // any other value that did not fold (a call, a variable) is SM0202 at it (one with no
    // type was reported where it lost it)
    hidden method DoConstLiteral(const AInit: int64);
    var
      LRoot: int64;
      LKind: NodeKind;
    begin
      if AInit = 0 then
        return;
      end;
      LRoot := self.DoSkipParens(AInit);
      if LRoot = 0 then
        return;
      end;
      LKind := self.FTree[LRoot].Kind;
      if (LKind = NodeKind.ArrayLiteral) or (LKind = NodeKind.RecordLiteral) or
        (LKind = NodeKind.SetLiteral) then
        self.DoConstPart(LRoot);
        return;
      end;
      if (self.FTree[AInit].ResolvedConst.Kind = ConstKind.Unknown) and
        (self.FTree[AInit].ResolvedType <> 0) then
        self.DoError(AInit, ADAM_ERR_SEMANTICS_202, ADAM_MSG_SEMANTICS_NOT_CONSTANT,
          NoArgs().Str(ADAM_MSG_SEMANTICS_A_CONST_VALUE));
      end;
    end;

    // The part AExpr of a const's array literal: a nested array literal's elements, a record
    // literal's field values and a set literal's bounds each checked the same way; any other
    // value that did not fold is SM0202 at it (one with no type was reported where it lost
    // it)
    hidden method DoConstPart(const AExpr: int64);
    var
      LRoot: int64;
      LKind: NodeKind;
      LI: int64;
      LItem: int64;
    begin
      if AExpr = 0 then
        return;
      end;
      LRoot := self.DoSkipParens(AExpr);
      if LRoot = 0 then
        return;
      end;
      LKind := self.FTree[LRoot].Kind;
      if (LKind = NodeKind.ArrayLiteral) or (LKind = NodeKind.SetLiteral) then
        for LI := 0 to self.FTree.CountOf(LRoot, NodeRole.Element) - 1 do
          LItem := self.FTree.NthOf(LRoot, NodeRole.Element, LI);
          self.DoConstPart(self.FTree.FirstOf(LItem, NodeRole.LowBound));
          self.DoConstPart(self.FTree.FirstOf(LItem, NodeRole.HighBound));
        end;
        return;
      end;
      if LKind = NodeKind.RecordLiteral then
        for LI := 0 to self.FTree.CountOf(LRoot, NodeRole.Argument) - 1 do
          LItem := self.FTree.NthOf(LRoot, NodeRole.Argument, LI);
          self.DoConstPart(self.FTree.FirstOf(LItem, NodeRole.Value));
        end;
        return;
      end;
      if (self.FTree[AExpr].ResolvedConst.Kind = ConstKind.Unknown) and
        (self.FTree[AExpr].ResolvedType <> 0) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_202, ADAM_MSG_SEMANTICS_NOT_CONSTANT,
          NoArgs().Str(ADAM_MSG_SEMANTICS_A_CONST_ELEMENT));
      end;
    end;

    // The set literal ARoot (AExpr with its parentheses off) where a value of ATarget
    // goes: a set type takes it when each element converts to its element type (a trailing
    // comma is SM0707: DoSetComma), a constant one lies in the set's range (SM0200) and a
    // constant range's low bound is not above its high (SM0267)
    hidden method DoConvertSet(const AExpr: int64; const ARoot: int64; const ATarget: int64): bool;
    var
      LElement: int64;
      LI: int64;
      LItem: int64;
      LLowBound: int64;
      LHighBound: int64;
      LOk: bool;
    begin
      self.DoSetComma(ARoot);
      if self.DoClass(ATarget) <> TypeClass.SetType then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NO_CONVERT,
          NoArgs().Str(ADAM_MSG_SEMANTICS_A_SET_LITERAL).Str(self.DoText(ATarget)));
        return false;
      end;
      // pcpp's set literal rule comes first: SM0266, the literal's one report
      if not self.DoSetElementsAlike(ARoot) then
        self.DoSetType(ARoot, ATarget);
        self.DoSetType(AExpr, ATarget);
        return false;
      end;
      LElement := self.DoSetElement(ATarget);
      LOk := true;
      for LI := 0 to self.FTree.CountOf(ARoot, NodeRole.Element) - 1 do
        LItem := self.FTree.NthOf(ARoot, NodeRole.Element, LI);
        LLowBound := self.FTree.FirstOf(LItem, NodeRole.LowBound);
        LHighBound := self.FTree.FirstOf(LItem, NodeRole.HighBound);
        if not self.DoConvert(LLowBound, LElement) then
          LOk := false;
        else
          if not self.DoSetMemberFits(LLowBound, LElement, ATarget) then
            LOk := false;
          end;
        end;
        if not self.DoConvert(LHighBound, LElement) then
          LOk := false;
        else
          if not self.DoSetMemberFits(LHighBound, LElement, ATarget) then
            LOk := false;
          end;
        end;
        if LOk and (not self.DoSetRangeOrdered(LLowBound, LHighBound, LElement)) then
          LOk := false;
        end;
      end;
      self.DoSetType(ARoot, ATarget);
      self.DoSetType(AExpr, ATarget);
      return LOk;
    end;

    // True when every bound of the set literal ARoot is of an ordinal type (an integer, a
    // char or wchar, a bool, a choices type) and all are of one family (the integers of any
    // width one family, every other kind its own type); else SM0266 at the first that is
    // not (pcpp's rule)
    hidden method DoSetElementsAlike(const ARoot: int64): bool;
    var
      LI: int64;
      LSide: int32;
      LItem: int64;
      LBound: int64;
      LType: int64;
      LFirst: int64;
      LClass: TypeClass;
    begin
      LFirst := 0;
      for LI := 0 to self.FTree.CountOf(ARoot, NodeRole.Element) - 1 do
        LItem := self.FTree.NthOf(ARoot, NodeRole.Element, LI);
        for LSide := 0 to 1 do
          if LSide = 0 then
            LBound := self.FTree.FirstOf(LItem, NodeRole.LowBound);
          else
            LBound := self.FTree.FirstOf(LItem, NodeRole.HighBound);
          end;
          LType := 0;
          if LBound <> 0 then
            LType := self.DoTypeOf(LBound);
          end;
          if LType <> 0 then
            LClass := self.DoClass(LType);
            if not (IsIntegerClass(LClass) or (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) or
              (LClass = TypeClass.Boolean) or (LClass = TypeClass.ChoicesType)) then
              self.DoError(LBound, ADAM_ERR_SEMANTICS_266, ADAM_MSG_SEMANTICS_SET_NOT_ORDINAL,
                NoArgs().Str(self.DoText(LType)));
              return false;
            end;
            if LFirst = 0 then
              LFirst := LType;
            else
              if not ((IsIntegerClass(LClass) and IsIntegerClass(self.DoClass(LFirst))) or (LType = LFirst)) then
                self.DoError(LBound, ADAM_ERR_SEMANTICS_266, ADAM_MSG_SEMANTICS_SET_MIXED,
                  NoArgs().Str(self.DoText(LFirst)).Str(self.DoText(LType)));
                return false;
              end;
            end;
          end;
        end;
      end;
      return true;
    end;

    // True unless the set literal element AValue (converted to the element type AElement)
    // is a constant outside the members of the set type ASet (SetRange): SM0200 then, naming
    // the range. A value not folded, or a set whose range is unknown, is the run time's
    hidden method DoSetMemberFits(const AValue: int64; const AElement: int64; const ASet: int64): bool;
    var
      LBits: int64;
      LLow: int64;
      LHigh: int64;
    begin
      if (AValue = 0) or (not self.DoFoldedBits(AValue, AElement, LBits)) then
        return true;
      end;
      if not SetRange(self.FTree, self.FTarget, ASet, LLow, LHigh) then
        return true;
      end;
      if (LBits >= LLow) and (LBits <= LHigh) then
        return true;
      end;
      self.DoError(AValue, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NOT_FIT,
        NoArgs().Str(self.DoExprText(AValue)).Str(self.DoText(ASet)).Str(IntToStr(LLow)).Str(
        IntToStr(LHigh)));
      return false;
    end;

    // True unless the set literal range ALow .. AHigh (both converted to the element type
    // AElement) has constant bounds, the low one above the high one: SM0267 at ALow (an
    // empty range written so is a mistake, as a match label's is)
    hidden method DoSetRangeOrdered(const ALow: int64; const AHigh: int64; const AElement: int64): bool;
    var
      LLowBits: int64;
      LHighBits: int64;
    begin
      if (ALow = 0) or (AHigh = 0) then
        return true;
      end;
      if (not self.DoFoldedBits(ALow, AElement, LLowBits)) or
        (not self.DoFoldedBits(AHigh, AElement, LHighBits)) then
        return true;
      end;
      if not self.DoLabelLess(LHighBits, LLowBits, self.DoUnsignedValues(AElement)) then
        return true;
      end;
      self.DoError(ALow, ADAM_ERR_SEMANTICS_267, ADAM_MSG_SEMANTICS_LOW_HIGH,
        NoArgs().Str(self.DoExprText(ALow)).Str(self.DoExprText(AHigh)));
      return false;
    end;

    // A char literal ARoot (AExpr with its parentheses off) converted to the wchar ATarget
    // holds its wide value (BNF sec 9, type-driven: the parser's DecodedWide unit, as
    // Folding.FoldDeclaration gives a wchar const), written into AExpr's ResolvedConst so
    // Lowering and the match labels read the unit, never the narrow code
    hidden method DoWideCharValue(const AExpr: int64; const ARoot: int64; const ATarget: int64);
    begin
      if (ARoot = 0) or (self.FTree[ARoot].Kind <> NodeKind.CharLiteral) or
        (self.DoClass(ATarget) <> TypeClass.WideChar) then
        return;
      end;
      if (len(self.FTree[ARoot].DecodedWide) = 0) or
        (self.FTree[AExpr].ResolvedConst.Kind <> ConstKind.Char) then
        return;
      end;
      self.FTree[AExpr].ResolvedConst.Bits := uint64(uint16(self.FTree[ARoot].DecodedWide[0]));
    end;

    // The value AExpr goes where a value of ATarget is needed: true when it converts (its
    // ResolvedConvert then ATarget when the type changes); else reported (SM0200, SM0406,
    // SM0408) and false. An unknown type on either side is silent (reported where it was
    // lost)
    hidden method DoConvert(const AExpr: int64; const ATarget: int64): bool;
    begin
      return self.DoConvertArg(AExpr, ATarget, -1, "");
    end;

    // DoConvert for the argument number AArgIndex (from 0) of a call of ACallee: the same
    // rule, a value that does not convert or fit reported as SM0404 naming the argument
    // (pcpp's report); AArgIndex -1 is any other place (SM0200)
    hidden method DoConvertArg(const AExpr: int64; const ATarget: int64; const AArgIndex: int64;
      const ACallee: string): bool;
    var
      LRoot: int64;
      LFrom: int64;
      LFits: bool;
    begin
      if (AExpr = 0) or (ATarget = 0) then
        return true;
      end;
      if self.DoIsNoValue(AExpr) then
        self.DoNoValue(AExpr);
        return false;
      end;
      LRoot := self.DoSkipParens(AExpr);
      if self.DoIsGenericValue(LRoot) then
        // a generic named as a value takes its instance from ATarget (BNF sec 10)
        return self.DoGenericValueTo(AExpr, LRoot, ATarget, AArgIndex, ACallee);
      end;
      if self.DoMethodValue(LRoot) <> 0 then
        // a method named as a value: a closure bound to its object, or SM0432 (F2b, O13)
        return self.DoMethodValueTo(AExpr, LRoot, self.DoMethodValue(LRoot), ATarget);
      end;
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.FuncLiteral) and
        (self.DoClass(ATarget) = TypeClass.RoutineType) and (self.DoTypeOf(LRoot) <> 0) then
        // a captureless literal is a plain routine (F2a); a capturing one SM0757
        if self.DoLiteralToRoutine(AExpr, LRoot, ATarget, LFits) then
          return true;
        end;
        if LFits then
          return false;
        end;
      end;
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.SetLiteral) then
        // the place decides (BNF sec 6): an array type takes an array literal
        if (self.DoClass(ATarget) = TypeClass.StaticArray) or
          (self.DoClass(ATarget) = TypeClass.DynamicArray) then
          return self.DoConvertArray(AExpr, LRoot, ATarget);
        end;
        return self.DoConvertSet(AExpr, LRoot, ATarget);
      end;
      LFrom := self.DoTypeOf(AExpr);
      if (LFrom = 0) or (LFrom = ATarget) then
        return true;
      end;
      if self.DoWouldConvert(AExpr, ATarget) then
        self.FTree[AExpr].ResolvedConvert := ATarget;
        self.DoWideCharValue(AExpr, LRoot, ATarget);
        // A pointer upcast to a part a packed level may misalign (SM0270): it keeps its type
        self.DoPointerUpcast(AExpr, LFrom, ATarget);
        return true;
      end;
      if IsIntegerClass(self.DoClass(LFrom)) and IsIntegerClass(self.DoClass(ATarget)) and
        self.DoIsConstInt(AExpr) then
        self.DoNotFitAt(AExpr, ATarget, AArgIndex, ACallee);
        return false;
      end;
      if (self.DoClass(LFrom) = TypeClass.ObjectType) and (self.DoClass(ATarget) = TypeClass.ObjectType) and
        IsBaseOf(self.FTree, ATarget, LFrom) then
        // Only a polymorphic object is refused its parent by value (ConvertsImplicitly)
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_428, ADAM_MSG_SEMANTICS_SLICE,
          NoArgs().Str(self.DoExprText(AExpr)).Str(self.DoText(ATarget)));
        return false;
      end;
      self.DoNoConvertAt(AExpr, LFrom, ATarget, AArgIndex, ACallee);
      return false;
    end;

    // True when AExpr is an integer constant (ConstIntOf)
    hidden const method DoIsConstInt(const AExpr: int64): bool;
    var
      LNegative: bool;
      LMagnitude: uint64;
    begin
      return ConstIntOf(self.FTree, AExpr, LNegative, LMagnitude);
    end;

    // The condition AExpr (if, while, repeat, guard, ?:) is a bool: SM0263 otherwise
    hidden method DoCondition(const AExpr: int64);
    var
      LType: int64;
    begin
      if AExpr = 0 then
        return;
      end;
      if self.DoIsNoValue(AExpr) then
        self.DoNoValue(AExpr);
        return;
      end;
      LType := self.DoTypeOf(AExpr);
      if (LType <> 0) and (self.DoClass(LType) <> TypeClass.Boolean) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_263, ADAM_MSG_SEMANTICS_CONDITION,
          NoArgs().Str(self.DoText(LType)));
      end;
    end;

    // True when the value AExpr is a value-less call (reported) or of unknown type: the
    // caller then stops (its own type stays unknown)
    hidden method DoLost(const AExpr: int64): bool;
    begin
      if self.DoIsNoValue(AExpr) then
        self.DoNoValue(AExpr);
        return true;
      end;
      return self.DoTypeOf(AExpr) = 0;
    end;

    // True when the place AExpr has an address (BNF sec 6 addr of): a variable or a
    // parameter, a field or an embed of a stored value (or through a pointer, an own, a
    // ref, self), an element, a dereference, a string literal, self. A property, as a
    // member or by an index, is a value its accessor gives, never stored
    hidden const method DoIsStored(const AExpr: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
      LOperand: int64;
      LClass: TypeClass;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      LKind := NameKindOf(self.FTree, LAt);
      if (LKind = NodeKind.StringLiteral) or (LKind = NodeKind.SelfExpression) then
        return true;
      end;
      if LKind = NodeKind.NameExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        return (LDecl <> 0) and ((self.FTree[LDecl].Kind = NodeKind.VarDecl) or
          (self.FTree[LDecl].Kind = NodeKind.Param));
      end;
      if ((LKind = NodeKind.PostfixExpression) or (LKind = NodeKind.UnaryExpression)) and
        (self.FTree[LAt].Op = OperatorKind.Deref) then
        return true;
      end;
      LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
      LClass := self.DoClass(self.DoTypeOf(LOperand));
      if LKind = NodeKind.IndexExpression then
        // A property reached by the index (DoPropertyIndex) is no storage
        LDecl := self.FTree[LAt].ResolvedDecl;
        if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
          return false;
        end;
        if (LClass = TypeClass.Pointer) or (LClass = TypeClass.DynamicArray) then
          return true;
        end;
        return self.DoIsStored(LOperand);
      end;
      if LKind = NodeKind.MemberExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        if (LDecl = 0) or ((self.FTree[LDecl].Kind <> NodeKind.FieldDecl) and
          (self.FTree[LDecl].Kind <> NodeKind.EmbedDecl)) then
          return false;
        end;
        if self.FTree[LAt].HasFlag(NodeFlag.Arrow) or (LClass = TypeClass.OwnType) or
          (LClass = TypeClass.RefType) then
          return true;
        end;
        return self.DoIsStored(LOperand);
      end;
      // `X as T` of an object or an own is the object as T (BNF sec 6 O12): stored as X is
      if self.DoIsObjectAs(LAt) then
        return (LClass = TypeClass.OwnType) or self.DoIsStored(LOperand);
      end;
      return false;
    end;

    // True when the `as` AId's result is an object (BNF sec 6 O12: X an object or an own,
    // the object as T, an lvalue const when X is), not a ptr or a ref value
    hidden const method DoIsObjectAs(const AId: int64): bool;
    begin
      return (self.FTree[AId].Kind = NodeKind.AsExpression) and
        (self.DoClass(self.DoTypeOf(AId)) = TypeClass.ObjectType);
    end;

    // True when the place AExpr can be assigned (BNF sec 6): a variable, a parameter that
    // is not const, a field or an embed of an assignable value (or through a pointer that
    // is not to const, an own, a ref, self), an element of an assignable array or string or
    // through such a pointer, a dereference of such a pointer, a property (as a member or
    // by an index: its write is DoWritten's)
    // True when the object AExpr (a by-value object or record place) is const here (BNF sec 4,
    // PLAN-OBJECT decision (a)): a const parameter or declaration, a field, an index or a
    // deref of one, `->` / `^.` on a `ptr to const`, `X as T` of a const by-value X, a copy an async
    // block reads (T4). A var or plain parameter, a variable, self, parent. and a call's
    // result are not; nor is what an own or a ref reaches
    hidden const method DoIsConstObject(const AExpr: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
      LOperand: int64;
      LClass: TypeClass;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      LKind := NameKindOf(self.FTree, LAt);
      if LKind = NodeKind.NameExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        if LDecl = 0 then
          return false;
        end;
        if self.DoAsyncCopy(LAt, LDecl) <> 0 then
          return true;
        end;
        return (self.FTree[LDecl].Kind = NodeKind.ConstDecl) or
          ((self.FTree[LDecl].Kind = NodeKind.Param) and self.FTree[LDecl].HasFlag(NodeFlag.ConstParam));
      end;
      LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
      if LOperand = 0 then
        return false;
      end;
      LClass := self.DoClass(self.DoTypeOf(LOperand));
      if ((LKind = NodeKind.PostfixExpression) or (LKind = NodeKind.UnaryExpression)) and
        (self.FTree[LAt].Op = OperatorKind.Deref) then
        return (LClass = TypeClass.Pointer) and IsConstTarget(self.FTree, self.DoTypeOf(LOperand));
      end;
      if LKind = NodeKind.IndexExpression then
        if LClass = TypeClass.Pointer then
          return IsConstTarget(self.FTree, self.DoTypeOf(LOperand));
        end;
        if (LClass = TypeClass.StaticArray) or (LClass = TypeClass.DynamicArray) then
          return self.DoIsConstObject(LOperand);
        end;
        return false;
      end;
      if LKind = NodeKind.MemberExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        if (LDecl = 0) or ((self.FTree[LDecl].Kind <> NodeKind.FieldDecl) and
          (self.FTree[LDecl].Kind <> NodeKind.EmbedDecl)) then
          return false;
        end;
        if self.FTree[LAt].HasFlag(NodeFlag.Arrow) then
          return (LClass = TypeClass.Pointer) and IsConstTarget(self.FTree, self.DoTypeOf(LOperand));
        end;
        if (LClass <> TypeClass.ObjectType) and (LClass <> TypeClass.RecordType) and
          (LClass <> TypeClass.OverlayType) then
          return false;
        end;
        return self.DoIsConstObject(LOperand);
      end;
      // `X as T` of a by-value X is X's object; of an interface (a reference) another place
      if self.DoIsObjectAs(LAt) then
        return self.DoIsValueObject(LOperand) and self.DoIsConstObject(LOperand);
      end;
      return false;
    end;

    // True when AExpr is an object, a record or an overlay held by value (not what a
    // pointer, an own or a ref reaches: a const handle's object is not const)
    hidden const method DoIsValueObject(const AExpr: int64): bool;
    var
      LClass: TypeClass;
    begin
      LClass := self.DoClass(self.DoTypeOf(AExpr));
      return (LClass = TypeClass.ObjectType) or (LClass = TypeClass.RecordType) or
        (LClass = TypeClass.OverlayType);
    end;

    // True when AType is an object a place may hold a descendant of: polymorphic and not
    // final (BNF sec 4, O5 / TODO.md 8 (a))
    hidden const method DoMaySlice(const AType: int64): bool;
    begin
      return (self.DoClass(AType) = TypeClass.ObjectType) and IsPolymorphic(self.FTree, AType) and
        not IsFinalType(self.FTree, AType);
    end;

    // True when the place AExpr may hold a descendant of its type (BNF sec 4, O5): a var or
    // const parameter, a deref or P[i] on a ptr, self, `X as T`. A variable, a plain
    // parameter, a field and an array element hold exactly their type
    hidden const method DoMayBeDescendant(const AExpr: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
      LOperand: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      LKind := NameKindOf(self.FTree, LAt);
      if LKind = NodeKind.SelfExpression then
        return true;
      end;
      if LKind = NodeKind.NameExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        return (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.Param) and
          (self.FTree[LDecl].HasFlag(NodeFlag.ConstParam) or self.FTree[LDecl].HasFlag(NodeFlag.VarParam));
      end;
      if self.DoIsObjectAs(LAt) then
        return true;
      end;
      LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
      if LOperand = 0 then
        return false;
      end;
      if ((LKind = NodeKind.PostfixExpression) or (LKind = NodeKind.UnaryExpression)) and
        (self.FTree[LAt].Op = OperatorKind.Deref) then
        return true;
      end;
      return (LKind = NodeKind.IndexExpression) and
        (self.DoClass(self.DoTypeOf(LOperand)) = TypeClass.Pointer);
    end;

    hidden const method DoIsAssignable(const AExpr: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
      LOperand: int64;
      LOperandType: int64;
      LClass: TypeClass;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      LKind := NameKindOf(self.FTree, LAt);
      if LKind = NodeKind.NameExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        if LDecl = 0 then
          return false;
        end;
        // an async block reads its own copy of its routine's variable (T4): never written
        if self.DoAsyncCopy(LAt, LDecl) <> 0 then
          return false;
        end;
        if self.FTree[LDecl].Kind = NodeKind.VarDecl then
          return true;
        end;
        return (self.FTree[LDecl].Kind = NodeKind.Param) and
          (not self.FTree[LDecl].HasFlag(NodeFlag.ConstParam));
      end;
      // a call of a method returning self is its receiver (F7): a place when that is a
      // value object's place (a ref's, an own's or a ptr's receiver hands back that value)
      if self.DoIsSelfCall(LAt) then
        LOperand := self.FTree.FirstOf(self.FTree.FirstOf(LAt, NodeRole.Callee), NodeRole.Operand);
        return (self.DoClass(self.DoTypeOf(LOperand)) = TypeClass.ObjectType) and
          (not self.FTree[self.FTree.FirstOf(LAt, NodeRole.Callee)].HasFlag(NodeFlag.Arrow)) and
          self.DoIsAssignable(LOperand);
      end;
      LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
      LOperandType := self.DoTypeOf(LOperand);
      LClass := self.DoClass(LOperandType);
      if ((LKind = NodeKind.PostfixExpression) or (LKind = NodeKind.UnaryExpression)) and
        (self.FTree[LAt].Op = OperatorKind.Deref) then
        return (LClass = TypeClass.Pointer) and (not IsConstTarget(self.FTree, LOperandType));
      end;
      if LKind = NodeKind.IndexExpression then
        // A property reached by the index (DoPropertyIndex): its write is DoWritten's
        LDecl := self.FTree[LAt].ResolvedDecl;
        if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
          return true;
        end;
        if LClass = TypeClass.Pointer then
          return not IsConstTarget(self.FTree, LOperandType);
        end;
        return self.DoIsAssignable(LOperand);
      end;
      if LKind = NodeKind.MemberExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        if LDecl = 0 then
          return false;
        end;
        // A property's write runs on its object: never on a const one (SM0255)
        if self.FTree[LDecl].Kind = NodeKind.PropertyDecl then
          if self.FTree[LAt].HasFlag(NodeFlag.Arrow) then
            return (LClass <> TypeClass.Pointer) or (not IsConstTarget(self.FTree, LOperandType));
          end;
          return not self.DoIsConstObject(LOperand);
        end;
        // An embed is storage of its object as a field is (PaskalCPP's rule): the same test
        if (self.FTree[LDecl].Kind <> NodeKind.FieldDecl) and
          (self.FTree[LDecl].Kind <> NodeKind.EmbedDecl) then
          return false;
        end;
        if self.FTree[LAt].HasFlag(NodeFlag.Arrow) then
          return (LClass <> TypeClass.Pointer) or (not IsConstTarget(self.FTree, LOperandType));
        end;
        if (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) or
          (self.FTree[self.DoSkipParens(LOperand)].Kind = NodeKind.SelfExpression) then
          return true;
        end;
        return self.DoIsAssignable(LOperand);
      end;
      // `X as T` of an object or an own (DoIsObjectAs): assignable as X is, as a member of
      // it would be (an own's object, self, an assignable place; const when X is)
      if self.DoIsObjectAs(LAt) then
        if (LClass = TypeClass.OwnType) or
          (self.FTree[self.DoSkipParens(LOperand)].Kind = NodeKind.SelfExpression) then
          return true;
        end;
        return self.DoIsAssignable(LOperand);
      end;
      return false;
    end;

    // An integer literal's type (BNF sec 9, C++23 [lex.icon]; a single l is C's long, as
    // wide as the target says): the first of its suffix's types that holds its value. A
    // decimal without u takes signed types only; a hex or binary one also the unsigned
    hidden method DoIntLiteral(const AId: int64);
    var
      LValue: uint64;
      LSuffix: string;
      LText: string;
      LUnsigned: bool;
      LWide: bool;
      LRadix: bool;
      LLongWide: bool;
    begin
      LValue := self.FTree[AId].IntValue;
      LSuffix := self.FTree[AId].Suffix;
      LText := self.FTree[AId].Text;
      LUnsigned := DoHasLetter(LSuffix, 'u', 'U');
      // A single l starts at 64 bits only where the target's long is 8 bytes (LP64); with
      // no target (DR0004) it keeps C++'s least width, 32 bits
      LLongWide := (self.FTarget <> nil) and (self.FTarget.CLongSize() = 8) and
        DoHasLetter(LSuffix, 'l', 'L');
      // ll and z start at 64 bits; a single l per the target's long
      LWide := DoHasLetter(LSuffix, 'z', 'Z') or StartsStr("ll", LSuffix) or
        StartsStr("LL", LSuffix) or EndsStr("ll", LSuffix) or EndsStr("LL", LSuffix) or
        LLongWide;
      LRadix := StartsStr("0x", LText) or StartsStr("0X", LText) or StartsStr("0b", LText) or
        StartsStr("0B", LText);
      if LUnsigned then
        if (not LWide) and (LValue <= 0xFFFFFFFFu) then
          self.DoSetType(AId, self.DoBuiltin("uint32"));
        else
          self.DoSetType(AId, self.DoBuiltin("uint64"));
        end;
        return;
      end;
      if (not LWide) and (LValue <= 0x7FFFFFFFu) then
        self.DoSetType(AId, self.DoBuiltin("int32"));
        return;
      end;
      if (not LWide) and LRadix and (LValue <= 0xFFFFFFFFu) then
        self.DoSetType(AId, self.DoBuiltin("uint32"));
        return;
      end;
      if LValue <= 0x7FFFFFFFFFFFFFFFu then
        self.DoSetType(AId, self.DoBuiltin("int64"));
        return;
      end;
      self.DoSetType(AId, self.DoBuiltin("uint64"));
    end;

    // A float literal's type: float32 with f, else float64
    hidden method DoFloatLiteral(const AId: int64);
    begin
      if (self.FTree[AId].Suffix = "f") or (self.FTree[AId].Suffix = "F") then
        self.DoSetType(AId, self.DoBuiltin("float32"));
        return;
      end;
      self.DoSetType(AId, self.DoBuiltin("float64"));
    end;

    // A name used as a value: its declaration's type; a type or a module is SM0269 (a type
    // as a for's iterator is the for's to report once: SM0600, DoIsIterator)
    hidden method DoName(const AId: int64);
    var
      LDecl: int64;
      LKind: NodeKind;
    begin
      LDecl := self.FTree[AId].ResolvedDecl;
      if (LDecl <> 0) and (self.FTree.RoleOf(AId) = NodeRole.Iterator) and
        DoIsTypeDecl(self.FTree[LDecl].Kind) then
        return;
      end;
      if LDecl = 0 then
        if self.FTree[AId].ResolvedUnit <> 0 then
          self.DoError(AId, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_MODULE_NOT_VALUE,
            NoArgs().Str(self.FTree[AId].Text));
        end;
        return;
      end;
      LKind := self.FTree[LDecl].Kind;
      if DoIsTypeDecl(LKind) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_TYPE_NOT_VALUE,
          NoArgs().Str(self.FTree[AId].Text));
        return;
      end;
      if LKind = NodeKind.IntrinsicDecl then
        if not self.DoIsCallee(AId) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_423, ADAM_MSG_SEMANTICS_INTRINSIC_VALUE,
            NoArgs().Str(self.FTree[AId].Text));
        end;
        return;
      end;
      self.DoDeclarationFirst(LDecl);
      if ((LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.MethodDecl)) and
        (self.FTree.FirstOf(LDecl, NodeRole.GenericParam) <> 0) and not self.DoIsCallee(AId) then
        self.DoGenericValue(AId, LDecl);
        return;
      end;
      self.DoSetType(AId, self.DoDeclType(LDecl));
    end;

    // The generic routine ADecl named as a value by AId (not called, BNF sec 10): its type
    // arguments come from the routine type it converts to (DoConvertArg ->
    // DoGenericValueTo), so it waits untyped in FGenericValues; one no routine type reaches
    // is SM0738 once the program is typed (DoGenericValues). In a template the value is
    // its instances' (unknown, silent)
    hidden method DoGenericValue(const AId: int64; const ADecl: int64);
    begin
      if IsInTemplate(self.FTree, AId) then
        return;
      end;
      if self.FGenericState.Find(AId) = 0 then
        self.FGenericState.Put(AId, 1);
        self.FGenericValues.Add(AId);
      end;
    end;

    // True when AId (parentheses off) is a generic routine named as a value that no
    // routine type has given its instance yet (DoGenericValue); in a template never
    hidden const method DoIsGenericValue(const AId: int64): bool;
    var
      LDecl: int64;
      LKind: NodeKind;
    begin
      if (AId = 0) or (self.FTree[AId].Kind <> NodeKind.NameExpression) then
        return false;
      end;
      LDecl := self.FTree[AId].ResolvedDecl;
      if LDecl = 0 then
        return false;
      end;
      LKind := self.FTree[LDecl].Kind;
      return ((LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.MethodDecl)) and
        (self.FTree.FirstOf(LDecl, NodeRole.GenericParam) <> 0) and (not self.DoIsCallee(AId)) and
        (not IsInTemplate(self.FTree, AId));
    end;

    // The generics the value AUse naming the generic ADecl may name: ADecl's scope's generic
    // routines / methods of its name (overloads by parameter types, BNF sec 10) AUse sees
    // (DoIsSeenBy), into ACandidates
    hidden const method DoGenericNamesake(const ADecl: int64; const AUse: int64;
      const ACandidates: ref NodeList);
    var
      LScope: int64;
      LChild: int64;
      LI: int64;
    begin
      ACandidates.Clear();
      LScope := self.FTree.ParentOf(ADecl);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if self.DoIsNamedRoutine(LChild, self.FTree[ADecl].Text) and
          (self.FTree.FirstOf(LChild, NodeRole.GenericParam) <> 0) and
          self.DoIsSeenBy(LChild, AUse) then
          ACandidates.Add(LChild);
        end;
      end;
    end;

    // The type arguments the routine type ATarget gives the generic AGeneric named as a
    // value (BNF sec 10): its parameters and result unified with ATarget's (DoUnify,
    // exact) into AArgs. False when ATarget is no routine type of AGeneric's shape (as
    // many parameters, a result on both or neither: AShape), a type parameter it does not
    // fix (AUnfixed: its index) or one it gives two types (AClash / AClashType, DoInfer's)
    hidden const method DoInferFromType(const AGeneric: int64; const ATarget: int64;
      const AArgs: ref NodeList; var AShape: bool; var AUnfixed: int64; var AClash: int64;
      var AClashType: int64): bool;
    var
      LSig: int64;
      LBound: array of int64;
      LCount: int64;
      LReturn: int64;
      LI: int64;
    begin
      AShape := false;
      AUnfixed := -1;
      AClash := 0;
      AClashType := 0;
      AArgs.Clear();
      LSig := 0;
      if (self.DoClass(ATarget) = TypeClass.RoutineType) or (self.DoClass(ATarget) = TypeClass.ClosureType) then
        LSig := self.FTree[ATarget].ResolvedDecl;
      end;
      if (LSig = 0) or (self.FTree.CountOf(LSig, NodeRole.Param) <> self.FTree.CountOf(AGeneric, NodeRole.Param)) or
        ((self.FTree.FirstOf(LSig, NodeRole.ReturnType) = 0) <> (self.FTree.FirstOf(AGeneric, NodeRole.ReturnType) = 0)) then
        AShape := true;
        return false;
      end;
      LCount := self.FTree.CountOf(AGeneric, NodeRole.GenericParam);
      setlength(LBound, LCount);
      for LI := 0 to LCount - 1 do
        LBound[LI] := 0;
      end;
      for LI := 0 to self.FTree.CountOf(LSig, NodeRole.Param) - 1 do
        self.DoUnify(self.FTree.FirstOf(self.FTree.NthOf(AGeneric, NodeRole.Param, LI), NodeRole.TypeOf),
          self.FTree[self.FTree.FirstOf(self.FTree.NthOf(LSig, NodeRole.Param, LI), NodeRole.TypeOf)].ResolvedType,
          AGeneric, LBound, AClash, AClashType, 0);
      end;
      LReturn := self.FTree.FirstOf(LSig, NodeRole.ReturnType);
      if LReturn <> 0 then
        self.DoUnify(self.FTree.FirstOf(AGeneric, NodeRole.ReturnType), self.FTree[LReturn].ResolvedType,
          AGeneric, LBound, AClash, AClashType, 0);
      end;
      return self.DoBoundArgs(LBound, AArgs, AClash, AUnfixed);
    end;

    // True when the generic value AId fits the routine type ATarget with no report: some
    // generic of its name (DoGenericNamesake) has every type parameter fixed by ATarget
    // (the overload picker's test, DoArgumentFits / DoWouldConvert)
    hidden const method DoGenericValueFits(const AId: int64; const ATarget: int64): bool;
    var
      LCandidates: ref NodeList;
      LArgs: ref NodeList;
      LShape: bool;
      LUnfixed: int64;
      LClash: int64;
      LClashType: int64;
      LI: int64;
    begin
      LCandidates := ref NodeList();
      LArgs := ref NodeList();
      self.DoGenericNamesake(self.FTree[AId].ResolvedDecl, AId, LCandidates);
      for LI := 0 to LCandidates.Count - 1 do
        if self.DoInferFromType(LCandidates.Items[LI], ATarget, LArgs, LShape, LUnfixed, LClash, LClashType) then
          return true;
        end;
      end;
      return false;
    end;

    // The generic value ARoot (AExpr with its parentheses off) converted to ATarget (BNF
    // sec 10): the one generic of its name ATarget fixes (DoInferFromType) gives its
    // instance (made and typed, DoVisitMade; for a clink routine type its clink adapter,
    // NameResolver.ClinkInstance), written as ARoot's ResolvedDecl /
    // ResolvedInstance, ARoot and its parentheses typed with the instance's routine type,
    // then converted as any value (AArgIndex / ACallee: DoConvertArg's). Reported: no
    // routine type (SM0738), none of the name fitting it (SM0738 / SM0739 naming why for a
    // lone generic), several (SM0740)
    hidden method DoGenericValueTo(const AExpr: int64; const ARoot: int64; const ATarget: int64;
      const AArgIndex: int64; const ACallee: string): bool;
    var
      LDecl: int64;
      LCandidates: ref NodeList;
      LArgs: ref NodeList;
      LPickedArgs: ref NodeList;
      LPicked: int64;
      LTakers: int64;
      LShape: bool;
      LUnfixed: int64;
      LClash: int64;
      LClashType: int64;
      LMade: int64;
      LInstance: int64;
      LClone: int64;
      LType: int64;
      LAt: int64;
      LI: int64;
      LJ: int64;
    begin
      self.FGenericState.Put(ARoot, 2);
      LDecl := self.FTree[ARoot].ResolvedDecl;
      if (self.DoClass(ATarget) <> TypeClass.RoutineType) and (self.DoClass(ATarget) <> TypeClass.ClosureType) then
        self.DoError(ARoot, ADAM_ERR_SEMANTICS_738, ADAM_MSG_SEMANTICS_GENERIC_VALUE_TYPE,
          NoArgs().Str(self.FTree[ARoot].Text).Str(self.DoText(ATarget)));
        return false;
      end;
      LCandidates := ref NodeList();
      LArgs := ref NodeList();
      LPickedArgs := ref NodeList();
      self.DoGenericNamesake(LDecl, ARoot, LCandidates);
      LPicked := 0;
      LTakers := 0;
      for LI := 0 to LCandidates.Count - 1 do
        if self.DoInferFromType(LCandidates.Items[LI], ATarget, LArgs, LShape, LUnfixed, LClash, LClashType) then
          LTakers := LTakers + 1;
          if LPicked = 0 then
            LPicked := LCandidates.Items[LI];
            LPickedArgs.Clear();
            for LJ := 0 to LArgs.Count - 1 do
              LPickedArgs.Add(LArgs.Items[LJ]);
            end;
          end;
        end;
      end;
      if LTakers > 1 then
        self.DoError(ARoot, ADAM_ERR_SEMANTICS_740, ADAM_MSG_SEMANTICS_GENERIC_VALUE_AMBIGUOUS,
          NoArgs().Str(self.DoText(ATarget)).Str(self.FTree[ARoot].Text));
        return false;
      end;
      if LTakers = 0 then
        if LCandidates.Count <> 1 then
          self.DoError(ARoot, ADAM_ERR_SEMANTICS_738, ADAM_MSG_SEMANTICS_GENERIC_VALUE_FIT,
            NoArgs().Str(self.FTree[ARoot].Text).Str(self.DoText(ATarget)));
          return false;
        end;
        // the lone generic of the name: why ATarget gives it no instance (LArgs holds the
        // types the last DoInferFromType bound)
        if LShape then
          self.DoError(ARoot, ADAM_ERR_SEMANTICS_738, ADAM_MSG_SEMANTICS_GENERIC_VALUE_FIT,
            NoArgs().Str(self.FTree[ARoot].Text).Str(self.DoText(ATarget)));
        else
          if LClash <> 0 then
            self.DoError(ARoot, ADAM_ERR_SEMANTICS_739, ADAM_MSG_SEMANTICS_GENERIC_VALUE_CLASH,
              NoArgs().Str(self.DoText(ATarget)).Str(self.FTree[self.FTree.NthOf(LDecl, NodeRole.GenericParam, LClash - 1)].Text).Str(self.FTree[ARoot].Text).Str(self.DoText(LArgs.Items[LClash - 1])).Str(self.DoText(LClashType)));
          else
            self.DoError(ARoot, ADAM_ERR_SEMANTICS_738, ADAM_MSG_SEMANTICS_GENERIC_VALUE_UNFIXED,
              NoArgs().Str(self.DoText(ATarget)).Str(self.FTree[self.FTree.NthOf(LDecl, NodeRole.GenericParam, LUnfixed)].Text).Str(self.FTree[ARoot].Text));
          end;
        end;
        return false;
      end;
      LMade := self.FResolver.MadeCount();
      // a closure slot (F2a) takes the instance itself, through its adapter (DoConvertArg)
      if (self.FTree[LPicked].Kind = NodeKind.RoutineDecl) and not self.FTree[ATarget].HasFlag(NodeFlag.Cpplink) and
        (self.DoClass(ATarget) = TypeClass.RoutineType) then
        // a clink slot: the instance's clink adapter (C's parameter passing, user 2026-11-17)
        LInstance := self.FResolver.ClinkInstance(LPicked, LPickedArgs, ARoot);
      else
        LInstance := self.FResolver.RoutineInstance(LPicked, LPickedArgs, ARoot);
      end;
      if LInstance = 0 then
        // past the depth limit (SM0736)
        return false;
      end;
      self.DoVisitMade(LMade);
      LClone := self.FTree.FirstOf(LInstance, NodeRole.Instance);
      self.FTree[ARoot].ResolvedDecl := LClone;
      self.FTree[ARoot].ResolvedInstance := LInstance;
      LType := RoutineTypeOf(self.FTree, LClone);
      self.DoSetType(ARoot, LType);
      LAt := AExpr;
      while (LAt <> 0) and (LAt <> ARoot) do
        self.DoSetType(LAt, LType);
        LAt := self.FTree.FirstOf(LAt, NodeRole.Operand);
      end;
      return self.DoConvertArg(AExpr, ATarget, AArgIndex, ACallee);
    end;

    // Every generic routine named as a value that no routine type reached (FGenericValues
    // still waiting): SM0738, in visit order (BNF sec 10: a value takes its type arguments
    // only from a routine type)
    hidden method DoGenericValues();
    var
      LI: int64;
      LId: int64;
    begin
      for LI := 0 to self.FGenericValues.Count - 1 do
        LId := self.FGenericValues.Items[LI];
        if self.FGenericState.Find(LId) = 1 then
          self.DoError(LId, ADAM_ERR_SEMANTICS_738, ADAM_MSG_SEMANTICS_GENERIC_VALUE,
            NoArgs().Str(self.FTree[LId].Text));
        end;
      end;
    end;

    // True when the name AId is what a call calls (its Callee)
    hidden const method DoIsCallee(const AId: int64): bool;
    var
      LParent: int64;
    begin
      LParent := self.FTree.ParentOf(AId);
      return (LParent <> 0) and (self.FTree[LParent].Kind = NodeKind.CallExpression) and
        (self.FTree.RoleOf(AId) = NodeRole.Callee);
    end;

    // A const's or a choice value's declaration ADecl typed and folded before a name or a
    // member naming it is folded, wherever it stands (another unit, later in the arena);
    // inside its own declaration the visit is already marked and returns at once
    hidden method DoDeclarationFirst(const ADecl: int64);
    begin
      if ADecl = 0 then
        return;
      end;
      if self.FTree[ADecl].Kind = NodeKind.ConstDecl then
        self.DoVisit(ADecl);
      end;
      if self.FTree[ADecl].Kind = NodeKind.ChoiceValue then
        self.DoVisit(self.FTree.ParentOf(self.FTree.ParentOf(ADecl)));
      end;
    end;

    // self: the type whose method encloses it; parent: that type's parent. Where no
    // object is, SM0011: no method, init, copy, done or accessor encloses it, or an
    // operator does (it has no self: BNF sec 4 operator decl); SM0745 in a static method. parent is written only as
    // parent.<member> (SM0016: never a value, addr of parent or parent->Z) in a method of
    // a type that has a parent (SM0012)
    hidden method DoSelf(const AId: int64);
    var
      LOwner: int64;
      LType: int64;
      LAt: int64;
      LWord: string;
    begin
      LWord := "self";
      if self.FTree[AId].Kind = NodeKind.ParentExpression then
        LWord := "parent";
      end;
      // the routine MethodOwnerOf takes its type from: the first routine-like one around
      // AId that is no plain routine
      LAt := self.FTree.ParentOf(AId);
      while (LAt <> 0) and
        not (IsRoutineLike(self.FTree[LAt].Kind) and (self.FTree[LAt].Kind <> NodeKind.RoutineDecl)) do
        LAt := self.FTree.ParentOf(LAt);
      end;
      if LAt = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_011, ADAM_MSG_SEMANTICS_NO_SELF, NoArgs().Str(LWord));
        return;
      end;
      if self.FTree[LAt].Kind = NodeKind.OperatorDecl then
        self.DoError(AId, ADAM_ERR_SEMANTICS_011, ADAM_MSG_SEMANTICS_OPERATOR_NO_SELF, NoArgs().Str(LWord));
        return;
      end;
      // a static method has no self (BNF sec 3, J3d)
      if (self.FTree[LAt].Kind = NodeKind.MethodDecl) and self.FTree[LAt].HasFlag(NodeFlag.Static) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_745, ADAM_MSG_SEMANTICS_STATIC_NO_SELF,
          NoArgs().Str(LWord).Str(self.FTree[LAt].Text));
        return;
      end;
      LOwner := MethodOwnerOf(self.FTree, AId);
      if LOwner = 0 then
        return;
      end;
      LType := DeclaredTypeOf(self.FTree, self.FTree.ParentOf(LOwner));
      if self.FTree[AId].Kind = NodeKind.ParentExpression then
        if (self.FTree[self.FTree.ParentOf(AId)].Kind <> NodeKind.MemberExpression) or
          (self.FTree.RoleOf(AId) <> NodeRole.Operand) or
          self.FTree[self.FTree.ParentOf(AId)].HasFlag(NodeFlag.Arrow) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_016, ADAM_MSG_SEMANTICS_PARENT_MEMBER, NoArgs());
          return;
        end;
        if ParentTypeOf(self.FTree, LType) = 0 then
          self.DoError(AId, ADAM_ERR_SEMANTICS_012, ADAM_MSG_SEMANTICS_NO_PARENT,
            NoArgs().Str(self.DoText(LType)));
          return;
        end;
        LType := ParentTypeOf(self.FTree, LType);
      end;
      self.DoSetType(AId, LType);
    end;

    // SM0250 for the operator AId on one operand of AType
    hidden method DoOpOne(const AId: int64; const AType: int64);
    begin
      self.DoError(AId, ADAM_ERR_SEMANTICS_250, ADAM_MSG_SEMANTICS_OP_ONE,
        NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(AType)));
    end;

    // SM0250 for the operator AId on operands of ALeft and ARight
    hidden method DoOpTwo(const AId: int64; const ALeft: int64; const ARight: int64);
    begin
      self.DoError(AId, ADAM_ERR_SEMANTICS_250, ADAM_MSG_SEMANTICS_OP_TWO,
        NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(ALeft)).Str(self.DoText(ARight)));
    end;

    // SM0253 at AOperand: the untyped ptr points at no type
    hidden method DoUntyped(const AOperand: int64);
    begin
      self.DoError(AOperand, ADAM_ERR_SEMANTICS_253, ADAM_MSG_SEMANTICS_UNTYPED_POINTER,
        NoArgs().Str(self.DoExprText(AOperand)).Str(self.DoExprText(AOperand)));
    end;

    // A dereference AId of AOperand (of AType): what a typed pointer points at
    hidden method DoDeref(const AId: int64; const AOperand: int64; const AType: int64);
    begin
      if self.DoClass(AType) = TypeClass.Pointer then
        self.DoSetType(AId, TargetOf(self.FTree, AType));
        return;
      end;
      if self.DoClass(AType) = TypeClass.UntypedPointer then
        self.DoUntyped(AOperand);
        return;
      end;
      self.DoOpOne(AId, AType);
    end;

    // ++ / -- AId of AOperand (of AType): an integer, a char, a wchar or a typed pointer
    // that can be assigned; the operand's own type
    hidden method DoStep(const AId: int64; const AOperand: int64; const AType: int64);
    var
      LClass: TypeClass;
    begin
      LClass := self.DoClass(AType);
      if not (IsIntegerClass(LClass) or (LClass = TypeClass.Char) or
        (LClass = TypeClass.WideChar) or (LClass = TypeClass.Pointer)) then
        self.DoOpOne(AId, AType);
        return;
      end;
      if not self.DoIsAssignable(AOperand) then
        self.DoNotAssignable(AOperand);
      else
        self.DoWritten(AOperand);
      end;
      self.DoSetType(AId, AType);
    end;

    // AOperand promoted where AId's arithmetic needs AType's promotion: the promoted
    // type, written as the operand's conversion when it changes
    hidden method DoPromote(const AOperand: int64; const AType: int64): int64;
    var
      LPromoted: int64;
    begin
      LPromoted := Promoted(self.FTree, AType);
      if LPromoted <> AType then
        self.FTree[AOperand].ResolvedConvert := LPromoted;
      end;
      return LPromoted;
    end;

    // A prefix operator (BNF sec 6): not on a bool; - + on a number, ~ on an integer
    // (promoted); addr of a stored place (ptr to const for a place that cannot be
    // assigned; a bitfield has none, SM0262); * / ^ a dereference; ++ --
    hidden method DoUnary(const AId: int64);
    var
      LOperand: int64;
      LType: int64;
      LClass: TypeClass;
      LOp: OperatorKind;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      LOp := self.FTree[AId].Op;
      if LOp = OperatorKind.AddressOf then
        if self.DoBitfieldAddress(LOperand) then
          return;
        end;
        // A property is no storage: it has no address (pcpp O9)
        if self.DoPropertyOf(LOperand) <> 0 then
          self.DoError(LOperand, ADAM_ERR_SEMANTICS_376, ADAM_MSG_SEMANTICS_PROPERTY_STORAGE,
            NoArgs().Str(self.DoExprText(LOperand)).Str("addr of"));
          return;
        end;
        if not self.DoIsStored(LOperand) then
          self.DoError(LOperand, ADAM_ERR_SEMANTICS_254, ADAM_MSG_SEMANTICS_NO_ADDRESS,
            NoArgs().Str(self.DoExprText(LOperand)));
          return;
        end;
        // A typed pointer promises its target's alignment: a place a packed record may
        // misalign has none to give (SM0270); the expression keeps its type, one report
        if self.DoMayBeMisaligned(LOperand) then
          self.DoError(LOperand, ADAM_ERR_SEMANTICS_270, ADAM_MSG_SEMANTICS_MISALIGNED_ADDRESS,
            NoArgs().Str(self.DoExprText(LOperand)));
        end;
        LType := self.DoTypeOf(LOperand);
        if (LType <> 0) and (self.DoClass(LType) = TypeClass.FlexibleArray) then
          // an external array (X2c): where its elements start, C's decay of x to a T *
          LType := TargetOf(self.FTree, LType);
        end;
        if LType <> 0 then
          self.DoSetType(AId, PointerTo(self.FTree, LType, self.DoAddressConst(LOperand)));
        end;
        return;
      end;
      if self.DoLost(LOperand) then
        return;
      end;
      LType := self.DoTypeOf(LOperand);
      LClass := self.DoClass(LType);
      if LOp = OperatorKind.LogicalNot then
        if LClass = TypeClass.Boolean then
          self.DoSetType(AId, LType);
        else
          self.DoOpOne(AId, LType);
        end;
        return;
      end;
      // the unary minus a record's or an object's `operator -` with one operand runs
      if (LOp = OperatorKind.Negate) and self.DoDeclaredOperator(AId, OperatorKind.Subtract) then
        return;
      end;
      if (LOp = OperatorKind.Negate) or (LOp = OperatorKind.Plus) then
        if IsNumericClass(LClass) then
          self.DoSetType(AId, self.DoPromote(LOperand, LType));
        else
          self.DoOpOne(AId, LType);
        end;
        return;
      end;
      if LOp = OperatorKind.BitNot then
        if IsIntegerClass(LClass) then
          self.DoSetType(AId, self.DoPromote(LOperand, LType));
        else
          self.DoOpOne(AId, LType);
        end;
        return;
      end;
      if LOp = OperatorKind.Deref then
        self.DoDeref(AId, LOperand, LType);
        return;
      end;
      self.DoStep(AId, LOperand, LType);
    end;

    // A postfix operator: ^ (a dereference), ++ / --
    hidden method DoPostfix(const AId: int64);
    var
      LOperand: int64;
      LType: int64;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      if self.DoLost(LOperand) then
        return;
      end;
      LType := self.DoTypeOf(LOperand);
      if self.FTree[AId].Op = OperatorKind.Deref then
        self.DoDeref(AId, LOperand, LType);
        return;
      end;
      self.DoStep(AId, LOperand, LType);
    end;

    // A signed operand AOperand of AType the usual arithmetic conversions would make
    // unsigned at ACommon (BNF sec 6: int32 meets uint32 at uint32, so -1 would become
    // 4294967295): SM0251 naming the cast, pcpp's report, unless it is a constant >= 0
    // (it converts exactly); true when reported
    hidden method DoSignedToUnsigned(const AId: int64; const AOperand: int64; const AType: int64;
      const ACommon: int64): bool;
    var
      LNegative: bool;
      LMagnitude: uint64;
    begin
      if (self.DoClass(AType) <> TypeClass.SignedInt) or (self.DoClass(ACommon) <> TypeClass.UnsignedInt) then
        return false;
      end;
      if ConstIntOf(self.FTree, AOperand, LNegative, LMagnitude) and (not LNegative) then
        return false;
      end;
      self.DoError(AOperand, ADAM_ERR_SEMANTICS_251, ADAM_MSG_SEMANTICS_SIGNED_TO_UNSIGNED,
        NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(AType)).Str(self.DoText(ACommon)).Str(
        self.DoText(ACommon)));
      return true;
    end;

    // Two numbers meet at their common type (BNF sec 6, PLAN-ARITH): each converts to it
    // (SM0200 at the one that does not, the cast as the hint; an operator's signed operand
    // made unsigned SM0251, the one report); the common type
    hidden method DoArithmetic(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64): int64;
    var
      LCommon: int64;
    begin
      LCommon := CommonArithmetic(self.FTree, ALeftType, ARightType);
      if self.FTree[AId].Kind = NodeKind.BinaryExpression then
        if self.DoSignedToUnsigned(AId, ALeft, ALeftType, LCommon) or
          self.DoSignedToUnsigned(AId, ARight, ARightType, LCommon) then
          return LCommon;
        end;
      end;
      self.DoConvert(ALeft, LCommon);
      self.DoConvert(ARight, LCommon);
      return LCommon;
    end;

    // One side ASide of a concatenation in the string family AText (string or wstring,
    // its char ACharType): the family's string or char, or a literal taking its form
    hidden method DoConcatSide(const ASide: int64; const AText: int64; const ACharType: int64): bool;
    var
      LType: int64;
      LRoot: int64;
    begin
      LType := self.DoTypeOf(ASide);
      if (LType = AText) or (LType = ACharType) then
        return true;
      end;
      LRoot := self.DoSkipParens(ASide);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.StringLiteral) then
        return self.DoConvert(ASide, AText);
      end;
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.CharLiteral) then
        return self.DoConvert(ASide, ACharType);
      end;
      return false;
    end;

    // + with a string family operand (BNF sec 6): concatenation with the string family of
    // its width (a string, a string literal, a char); the family's string type
    hidden method DoConcat(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64);
    var
      LText: int64;
      LChar: int64;
    begin
      if (self.DoClass(ALeftType) = TypeClass.WideText) or
        (self.DoClass(ARightType) = TypeClass.WideText) then
        LText := self.DoBuiltin("wstring");
        LChar := self.DoBuiltin("wchar");
      else
        LText := self.DoBuiltin("string");
        LChar := self.DoBuiltin("char");
      end;
      if self.DoConcatSide(ALeft, LText, LChar) and self.DoConcatSide(ARight, LText, LChar) then
        self.DoSetType(AId, LText);
        return;
      end;
      self.DoOpTwo(AId, ALeftType, ARightType);
    end;

    // True when ALeft and ARight are one set type
    hidden const method DoSameSet(const ALeft: int64; const ARight: int64): bool;
    begin
      return (ALeft = ARight) and (self.DoClass(ALeft) = TypeClass.SetType);
    end;

    // + - and the sets' * & | (union, difference, intersection) and pointer moves
    // (ptr + n, n + ptr, ptr - n, ptr - ptr: int64), else the numbers' arithmetic
    hidden method DoAdditive(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64);
    var
      LLeft: TypeClass;
      LRight: TypeClass;
      LOp: OperatorKind;
    begin
      LLeft := self.DoClass(ALeftType);
      LRight := self.DoClass(ARightType);
      LOp := self.FTree[AId].Op;
      if (LOp = OperatorKind.Add) and ((LLeft = TypeClass.Text) or (LRight = TypeClass.Text) or
        (LLeft = TypeClass.WideText) or (LRight = TypeClass.WideText)) then
        self.DoConcat(AId, ALeft, ARight, ALeftType, ARightType);
        return;
      end;
      if self.DoSameSet(ALeftType, ARightType) then
        self.DoSetType(AId, ALeftType);
        return;
      end;
      if IsNumericClass(LLeft) and IsNumericClass(LRight) and (LOp <> OperatorKind.BitAnd) and
        (LOp <> OperatorKind.BitOr) then
        self.DoSetType(AId, self.DoArithmetic(AId, ALeft, ARight, ALeftType, ARightType));
        return;
      end;
      if (LOp = OperatorKind.Add) or (LOp = OperatorKind.Subtract) then
        if (LLeft = TypeClass.UntypedPointer) and IsIntegerClass(LRight) then
          self.DoUntyped(ALeft);
          return;
        end;
        if (LLeft = TypeClass.Pointer) and IsIntegerClass(LRight) then
          self.DoSetType(AId, ALeftType);
          return;
        end;
        if (LOp = OperatorKind.Add) and IsIntegerClass(LLeft) and (LRight = TypeClass.Pointer) then
          self.DoSetType(AId, ARightType);
          return;
        end;
        if (LOp = OperatorKind.Subtract) and (LLeft = TypeClass.Pointer) and (ALeftType = ARightType) then
          self.DoSetType(AId, self.DoBuiltin("int64"));
          return;
        end;
      end;
      self.DoOpTwo(AId, ALeftType, ARightType);
    end;

    // / is real division (BNF sec 6): float32 when a float32 meets no float64 (each
    // operand converts to it), else float64
    hidden method DoDivide(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64);
    var
      LResult: int64;
    begin
      if not (IsNumericClass(self.DoClass(ALeftType)) and IsNumericClass(self.DoClass(ARightType))) then
        self.DoOpTwo(AId, ALeftType, ARightType);
        return;
      end;
      LResult := self.DoBuiltin("float64");
      if ((FloatBits(self.FTree, ALeftType) = 32) or (FloatBits(self.FTree, ARightType) = 32)) and
        (FloatBits(self.FTree, ALeftType) <> 64) and (FloatBits(self.FTree, ARightType) <> 64) then
        LResult := self.DoBuiltin("float32");
      end;
      self.DoConvert(ALeft, LResult);
      self.DoConvert(ARight, LResult);
      self.DoSetType(AId, LResult);
    end;

    // div / mod on integers; & | on integers (or sets, DoAdditive); xor on integers or two
    // bools (a bool)
    hidden method DoIntegral(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64);
    var
      LLeft: TypeClass;
      LRight: TypeClass;
    begin
      LLeft := self.DoClass(ALeftType);
      LRight := self.DoClass(ARightType);
      if IsIntegerClass(LLeft) and IsIntegerClass(LRight) then
        self.DoSetType(AId, self.DoArithmetic(AId, ALeft, ARight, ALeftType, ARightType));
        return;
      end;
      if (self.FTree[AId].Op = OperatorKind.Xor) and (LLeft = TypeClass.Boolean) and
        (LRight = TypeClass.Boolean) then
        self.DoSetType(AId, ALeftType);
        return;
      end;
      if ((self.FTree[AId].Op = OperatorKind.BitAnd) or (self.FTree[AId].Op = OperatorKind.BitOr)) and
        self.DoSameSet(ALeftType, ARightType) then
        self.DoSetType(AId, ALeftType);
        return;
      end;
      self.DoOpTwo(AId, ALeftType, ARightType);
    end;

    // shl / shr: an integer shifted by an integer count (not converted); the promoted
    // left operand's type
    hidden method DoShift(const AId: int64; const ALeft: int64; const ALeftType: int64;
      const ARightType: int64);
    begin
      if IsIntegerClass(self.DoClass(ALeftType)) and IsIntegerClass(self.DoClass(ARightType)) then
        self.DoSetType(AId, self.DoPromote(ALeft, ALeftType));
        return;
      end;
      self.DoOpTwo(AId, ALeftType, ARightType);
    end;

    // True when the string family side ASide meets AOther's family in a comparison: the
    // same string type, or a string literal taking its form
    hidden method DoStringSide(const ASide: int64; const AFamily: int64): bool;
    var
      LRoot: int64;
    begin
      if self.DoTypeOf(ASide) = AFamily then
        return true;
      end;
      LRoot := self.DoSkipParens(ASide);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.StringLiteral) then
        return self.DoConvert(ASide, AFamily);
      end;
      return false;
    end;

    // True when values of the aggregate (or array of aggregates) AType compare with the
    // operator AId: SM0252 (reported) when its type declares no operator for it. An array
    // of records or objects compares through its elements' operator (DoElementOperator,
    // AId's ResolvedCallee); SM0252 then names the operator the elements need
    hidden method DoComparable(const AId: int64; const AType: int64): bool;
    var
      LType: int64;
      LClass: TypeClass;
      LText: string;
    begin
      LType := AType;
      while (self.DoClass(LType) = TypeClass.StaticArray) or
        (self.DoClass(LType) = TypeClass.DynamicArray) do
        LType := TargetOf(self.FTree, LType);
      end;
      LClass := self.DoClass(LType);
      // A set has no order (only = <> and the subset / superset tests): an array of sets
      // orders by none of its elements' operators (SM0250)
      if (LClass = TypeClass.SetType) and (LType <> AType) and
        (self.DoElementMeaning(AId) = OperatorKind.Less) then
        self.DoOpTwo(AId, AType, AType);
        return false;
      end;
      if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.OverlayType) and
        (LClass <> TypeClass.ObjectType) then
        return true;
      end;
      LText := self.FTree[AId].Text;
      if LType <> AType then
        if self.DoElementOperator(AId, LType) then
          return true;
        end;
        LText := "<";
        if self.DoElementMeaning(AId) = OperatorKind.Equal then
          LText := "=";
        end;
      else
        if DeclaresOperator(self.FTree, LType, LText) or self.DoExtendDeclares(AId, LType, LText) then
          return true;
        end;
      end;
      if LClass = TypeClass.ObjectType then
        self.DoError(AId, ADAM_ERR_SEMANTICS_252, ADAM_MSG_SEMANTICS_OBJECT_NOT_COMPARABLE,
          NoArgs().Str(LText).Str(self.DoText(AType)));
      else
        self.DoError(AId, ADAM_ERR_SEMANTICS_252, ADAM_MSG_SEMANTICS_NOT_COMPARABLE,
          NoArgs().Str(LText).Str(self.DoText(AType)));
      end;
      return false;
    end;

    // The meaning of the operator an array comparison AId runs on its elements of a record
    // or an object type (BNF sec 6, C++'s std::array / std::vector rule, pcpp's): = and <>
    // run the elements' =; < <= > >= <=> their < (lexicographically, both ways)
    hidden const method DoElementMeaning(const AId: int64): OperatorKind;
    begin
      if (self.FTree[AId].Op = OperatorKind.Equal) or (self.FTree[AId].Op = OperatorKind.NotEqual) then
        return OperatorKind.Equal;
      end;
      return OperatorKind.Less;
    end;

    // True when the record or object type AElement declares the operator the array
    // comparison AId runs on its elements (DoElementMeaning) for two of them (each
    // parameter of AElement or a parent of it: its own level's first, then its parents'):
    // that operator is AId's ResolvedCallee (Lowering's DoArrayCompare calls it per pair)
    hidden method DoElementOperator(const AId: int64; const AElement: int64): bool;
    var
      LFound: ref NodeList;
      LI: int64;
      LCandidate: int64;
    begin
      LFound := ref NodeList();
      self.DoCollectOperators(AElement, self.DoElementMeaning(AId), 2, LFound, AId);
      for LI := 0 to LFound.Count - 1 do
        LCandidate := LFound[LI];
        if self.DoTakesElement(self.FTree.NthOf(LCandidate, NodeRole.Param, 0), AElement) and
          self.DoTakesElement(self.FTree.NthOf(LCandidate, NodeRole.Param, 1), AElement) then
          self.FTree[AId].ResolvedCallee := LCandidate;
          return true;
        end;
      end;
      return false;
    end;

    // True when the operator parameter AParam takes a value of the record or object type
    // AElement: its type is AElement or an ancestor of it
    hidden method DoTakesElement(const AParam: int64; const AElement: int64): bool;
    var
      LType: int64;
    begin
      LType := self.DoDeclType(AParam);
      return (LType = AElement) or IsAncestorOf(self.FTree, LType, AElement);
    end;

    // = <> < <= > >= <=> (BNF sec 6): two numbers meet at their common type; a bool, a
    // char, a wchar, a choices value with its own type; a string with its family (or a
    // literal); pointers (nil, an extension's with its base's); an own / ref / weak /
    // routine / interface value with one of its type or nil; a set with its own type; an
    // array, record, overlay or object with its own type when its elements compare (an
    // aggregate only through a declared operator, SM0252). A bool, or int32 for <=>
    hidden method DoCompare(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64);
    var
      LLeft: TypeClass;
      LRight: TypeClass;
      LResult: int64;
      LOk: bool;
    begin
      LResult := self.DoBuiltin("bool");
      if self.FTree[AId].Op = OperatorKind.Compare then
        LResult := self.DoBuiltin("int32");
      end;
      LLeft := self.DoClass(ALeftType);
      LRight := self.DoClass(ARightType);
      LOk := false;
      if IsNumericClass(LLeft) and IsNumericClass(LRight) then
        self.DoArithmetic(AId, ALeft, ARight, ALeftType, ARightType);
        LOk := true;
      else
        if (LLeft = TypeClass.Text) or (LLeft = TypeClass.WideText) then
          // a string literal on the left takes a wstring right side's form, as one on the
          // right takes the left's (BNF sec 6: `"ab" < LW`)
          LOk := self.DoStringSide(ARight, ALeftType);
          if (not LOk) and ((LRight = TypeClass.Text) or (LRight = TypeClass.WideText)) then
            LOk := self.DoStringSide(ALeft, ARightType);
          end;
        else
          if (LRight = TypeClass.Text) or (LRight = TypeClass.WideText) then
            LOk := self.DoStringSide(ALeft, ARightType);
          else
            if (LLeft = TypeClass.ClosureType) or (LRight = TypeClass.ClosureType) then
              // a closure compares with nil only, by = / <> (F2a: two closures share no
              // identity worth comparing)
              LOk := self.DoClosureCompare(AId, ALeft, ARight, ALeftType, ARightType);
            else
              if not self.DoScalarCompare(AId, ALeft, ARight, ALeftType, ARightType, LOk) then
                return;
              end;
            end;
          end;
        end;
      end;
      // A set compares by = <> and by >= <= (superset, subset: BNF sec 4); < > <=> are SM0250
      if (LLeft = TypeClass.SetType) and (self.FTree[AId].Op <> OperatorKind.Equal) and
        (self.FTree[AId].Op <> OperatorKind.NotEqual) and
        (self.FTree[AId].Op <> OperatorKind.GreaterEqual) and
        (self.FTree[AId].Op <> OperatorKind.LessEqual) then
        LOk := false;
      end;
      if not LOk then
        self.DoOpTwo(AId, ALeftType, ARightType);
        return;
      end;
      self.DoSetType(AId, LResult);
    end;

    // True when the comparison AId with a closure side (ALeft of ALeftType, ARight of
    // ARightType) is = / <> against nil (BNF sec 4, F2a), the nil side converted to the
    // closure's type; false otherwise (the caller's SM0250)
    hidden method DoClosureCompare(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64): bool;
    begin
      if (self.FTree[AId].Op <> OperatorKind.Equal) and (self.FTree[AId].Op <> OperatorKind.NotEqual) then
        return false;
      end;
      if self.DoClass(ARightType) = TypeClass.NilType then
        return self.DoConvert(ARight, ALeftType);
      end;
      if self.DoClass(ALeftType) = TypeClass.NilType then
        return self.DoConvert(ALeft, ARightType);
      end;
      return false;
    end;

    // The sides of the comparison AId of two values that are no number pair and no text
    // (ALeft of ALeftType, ARight of ARightType) brought to one type, AOk true when they
    // meet: a char literal on either side of a wchar takes the wchar form (DoWideCharSide),
    // else one side converts implicitly to the other's type; there the type must compare
    // (DoComparable). False when DoComparable reported (AId needs no report of its own);
    // true with AOk false when the sides meet at no type (the caller's SM0250)
    hidden method DoScalarCompare(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64; var AOk: bool): bool;
    begin
      AOk := false;
      if self.DoWideCharSide(ARight, ALeftType) then
        AOk := self.DoComparable(AId, ALeftType);
        return AOk;
      end;
      if self.DoWideCharSide(ALeft, ARightType) then
        AOk := self.DoComparable(AId, ARightType);
        return AOk;
      end;
      if ConvertsImplicitly(self.FTree, ARightType, ALeftType) then
        self.DoConvert(ARight, ALeftType);
        AOk := self.DoComparable(AId, ALeftType);
        return AOk;
      end;
      if ConvertsImplicitly(self.FTree, ALeftType, ARightType) then
        self.DoConvert(ALeft, ARightType);
        AOk := self.DoComparable(AId, ARightType);
        return AOk;
      end;
      return true;
    end;

    // True when ASide, one side of a comparison whose other side is of AOther, is a char
    // literal and AOther a wchar: the literal takes the wchar form (BNF sec 9: wide
    // literals are type-driven, as a string literal beside a wstring), converted there
    // (DoConvert writes its wide unit); a char literal no wchar unit holds is the parser's
    // PR0054 already
    hidden method DoWideCharSide(const ASide: int64; const AOther: int64): bool;
    begin
      if self.DoClass(AOther) <> TypeClass.WideChar then
        return false;
      end;
      if not self.DoLiteralTakes(self.DoSkipParens(ASide), AOther) then
        return false;
      end;
      self.DoConvert(ASide, AOther);
      return true;
    end;

    // and / or on two bools
    hidden method DoLogical(const AId: int64; const ALeftType: int64; const ARightType: int64);
    begin
      if (self.DoClass(ALeftType) = TypeClass.Boolean) and
        (self.DoClass(ARightType) = TypeClass.Boolean) then
        self.DoSetType(AId, ALeftType);
        return;
      end;
      self.DoOpTwo(AId, ALeftType, ARightType);
    end;

    // X in S: S a set type (X converts to its element type, SM0268 otherwise) or a set
    // literal (its items convert to X's type); a bool
    hidden method DoIn(const AId: int64; const ALeft: int64; const ARight: int64);
    var
      LRoot: int64;
      LLeftType: int64;
      LRightType: int64;
      LElement: int64;
      LI: int64;
      LItem: int64;
    begin
      self.DoSetType(AId, self.DoBuiltin("bool"));
      if self.DoLost(ALeft) then
        return;
      end;
      LLeftType := self.DoTypeOf(ALeft);
      LRoot := self.DoSkipParens(ARight);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.SetLiteral) then
        self.DoSetComma(LRoot);
        for LI := 0 to self.FTree.CountOf(LRoot, NodeRole.Element) - 1 do
          LItem := self.FTree.NthOf(LRoot, NodeRole.Element, LI);
          self.DoConvert(self.FTree.FirstOf(LItem, NodeRole.LowBound), LLeftType);
          self.DoConvert(self.FTree.FirstOf(LItem, NodeRole.HighBound), LLeftType);
        end;
        return;
      end;
      if self.DoLost(ARight) then
        return;
      end;
      LRightType := self.DoTypeOf(ARight);
      if self.DoClass(LRightType) <> TypeClass.SetType then
        self.DoOpTwo(AId, LLeftType, LRightType);
        return;
      end;
      LElement := self.DoSetElement(LRightType);
      if LElement = 0 then
        return;
      end;
      if self.DoWouldConvert(ALeft, LElement) then
        self.DoConvert(ALeft, LElement);
        return;
      end;
      self.DoError(ALeft, ADAM_ERR_SEMANTICS_268, ADAM_MSG_SEMANTICS_NOT_ELEMENT,
        NoArgs().Str(self.DoText(LLeftType)).Str(self.DoText(LRightType)));
    end;

    // A bracket literal ASide of the comparison AId whose other side AOther is an array
    // (LA = [1, 2]): an array literal of that type (BNF sec 6: the place decides, as in an
    // assignment: DoConvert, its elements converted there), before the literal's own set
    // type (none for elements no set takes, such as records) is judged
    hidden method DoArrayLiteralSide(const AId: int64; const ASide: int64; const AOther: int64);
    var
      LRoot: int64;
      LClass: TypeClass;
    begin
      if not self.DoGivesBool(self.FTree[AId].Op) and (self.FTree[AId].Op <> OperatorKind.Compare) then
        return;
      end;
      LRoot := self.DoSkipParens(ASide);
      if (LRoot = 0) or (self.FTree[LRoot].Kind <> NodeKind.SetLiteral) or self.DoLost(AOther) then
        return;
      end;
      LClass := self.DoClass(self.DoTypeOf(AOther));
      if (LClass = TypeClass.StaticArray) or (LClass = TypeClass.DynamicArray) then
        self.DoConvert(ASide, self.DoTypeOf(AOther));
      end;
    end;

    // A set literal ASide meeting a set type AOther (S + [1, 2]): it takes the set type
    hidden method DoSetLiteralSide(const ASide: int64; const AOther: int64);
    var
      LRoot: int64;
    begin
      LRoot := self.DoSkipParens(ASide);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.SetLiteral) and
        (self.DoClass(self.DoTypeOf(AOther)) = TypeClass.SetType) then
        self.DoConvert(ASide, self.DoTypeOf(AOther));
      end;
    end;

    // True for the meanings a record or an object may declare an operator for (BNF sec 4
    // operator symbol): + - * / div mod = <> < <= > >= in
    hidden const method DoIsDeclarable(const AOp: OperatorKind): bool;
    begin
      return (AOp = OperatorKind.Add) or (AOp = OperatorKind.Subtract) or
        (AOp = OperatorKind.Multiply) or (AOp = OperatorKind.Divide) or
        (AOp = OperatorKind.IntDivide) or (AOp = OperatorKind.Modulo) or self.DoGivesBool(AOp);
    end;

    // True when the operator AOperator, declared by the type AOwner, can run for ACount
    // operands of meaning AOp: its meaning and operand count, not recovered, no var
    // operand, one operand of AOwner, and a bool from a comparison or in (a declaration
    // that breaks one was reported by DoOperatorShape and is never picked)
    hidden method DoOperatorUsable(const AOperator: int64; const AOwner: int64; const AOp: OperatorKind;
      const ACount: int64): bool;
    var
      LI: int64;
      LParam: int64;
      LOwns: bool;
      LReturn: int64;
    begin
      if (self.FTree[AOperator].Kind <> NodeKind.OperatorDecl) or self.FTree[AOperator].HasFlag(NodeFlag.Recovered) or
        (self.FTree[AOperator].Op <> AOp) or (self.FTree.CountOf(AOperator, NodeRole.Param) <> ACount) then
        return false;
      end;
      LOwns := false;
      for LI := 0 to ACount - 1 do
        LParam := self.FTree.NthOf(AOperator, NodeRole.Param, LI);
        if self.FTree[LParam].HasFlag(NodeFlag.VarParam) or (self.DoDeclType(LParam) = 0) then
          return false;
        end;
        if self.DoDeclType(LParam) = AOwner then
          LOwns := true;
        end;
      end;
      if not LOwns then
        return false;
      end;
      LReturn := self.FTree.FirstOf(AOperator, NodeRole.ReturnType);
      if (LReturn = 0) or (CanonicalOf(self.FTree, LReturn) = 0) then
        return false;
      end;
      if AOp = OperatorKind.Hash then
        return CanonicalOf(self.FTree, LReturn) = self.DoBuiltin("uint64");
      end;
      return (not self.DoGivesBool(AOp)) or (CanonicalOf(self.FTree, LReturn) = self.DoBuiltin("bool"));
    end;

    // The operators of meaning AOp for ACount operands that the record or object type
    // AType declares, at its own level and its parents', then those the extends visible at
    // the use AUse add to it or a type above it (BNF sec 3, F1; an overlay's and a choices
    // type's come from extends only), added to AFound once each (both operands may be of one
    // type); nothing for any other type (0 included)
    hidden method DoCollectOperators(const AType: int64; const AOp: OperatorKind; const ACount: int64;
      const AFound: ref NodeList; const AUse: int64);
    var
      LAt: int64;
      LDepth: int64;
      LBody: int64;
      LBodies: ref NodeList;
      LClass: TypeClass;
      LI: int64;
      LJ: int64;
      LMember: int64;
    begin
      if AType = 0 then
        return;
      end;
      LClass := self.DoClass(AType);
      if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.ObjectType) and
        (LClass <> TypeClass.OverlayType) and (LClass <> TypeClass.ChoicesType) then
        return;
      end;
      LAt := AType;
      LDepth := 0;
      while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
        LBodies := ref NodeList();
        if (LClass = TypeClass.RecordType) or (LClass = TypeClass.ObjectType) then
          LBody := BodyOf(self.FTree, LAt);
          if LBody <> 0 then
            LBodies.Add(LBody);
          end;
        end;
        self.DoExtendBodies(AUse, LAt, LBodies);
        for LJ := 0 to LBodies.Count - 1 do
          LBody := LBodies[LJ];
          for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
            LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
            if self.DoOperatorUsable(LMember, LAt, AOp, ACount) and (AFound.IndexOf(LMember) < 0) then
              AFound.Add(LMember);
            end;
          end;
        end;
        if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.ObjectType) then
          return;
        end;
        LAt := ParentTypeOf(self.FTree, LAt);
        LDepth := LDepth + 1;
      end;
    end;

    // True when the operator ACandidate takes the operands of the operator expression AId,
    // each fitting its parameter by the call rule (DoArgumentFits)
    hidden method DoOperatorTakes(const AId: int64; const ACandidate: int64): bool;
    var
      LI: int64;
    begin
      for LI := 0 to OperandCount(self.FTree, AId) - 1 do
        if not self.DoArgumentFits(OperandAt(self.FTree, AId, LI),
          self.FTree.NthOf(ACandidate, NodeRole.Param, LI)) then
          return false;
        end;
      end;
      return true;
    end;

    // True when every operand of the operator expression AId has the exact type of the
    // operator ACandidate's parameter for it (the tie-break among several that take them)
    hidden method DoOperatorExact(const AId: int64; const ACandidate: int64): bool;
    var
      LI: int64;
    begin
      for LI := 0 to OperandCount(self.FTree, AId) - 1 do
        if self.DoTypeOf(OperandAt(self.FTree, AId, LI)) <>
          self.DoDeclType(self.FTree.NthOf(ACandidate, NodeRole.Param, LI)) then
          return false;
        end;
      end;
      return true;
    end;

    // `T1, T2`: the types of the operator expression AId's operands, as a message lists them
    hidden const method DoOperandTypesText(const AId: int64): string;
    var
      LText: string;
      LI: int64;
    begin
      LText := "";
      for LI := 0 to OperandCount(self.FTree, AId) - 1 do
        if LI > 0 then
          LText := LText + ", ";
        end;
        LText := LText + self.DoText(self.DoTypeOf(OperandAt(self.FTree, AId, LI)));
      end;
      return LText;
    end;

    // `T1, T2`: the operand types the operator AOperator takes, as a message lists them
    hidden method DoOperatorParamsText(const AOperator: int64): string;
    var
      LText: string;
      LI: int64;
    begin
      LText := "";
      for LI := 0 to self.FTree.CountOf(AOperator, NodeRole.Param) - 1 do
        if LI > 0 then
          LText := LText + ", ";
        end;
        LText := LText + self.DoText(self.DoDeclType(self.FTree.NthOf(AOperator, NodeRole.Param, LI)));
      end;
      return LText;
    end;

    // A hint of ACode at each operator in AOperators, the operand types it takes
    hidden method DoOperatorHints(const ACode: string; const AOperators: ref NodeList);
    var
      LI: int64;
      LOperator: int64;
    begin
      for LI := 0 to AOperators.Count - 1 do
        LOperator := AOperators[LI];
        self.FDiagnostics.Add(Severity.Hint, ACode, self.FTree[LOperator].Place, ADAM_MSG_SEMANTICS_OPERATOR_TAKES,
          NoArgs().Str(self.FTree[LOperator].Text).Str(self.DoText(self.DoDeclaringType(LOperator))).Str(
          self.DoOperatorParamsText(LOperator)));
      end;
    end;

    // The operator expression AId (binary, or the unary minus: AOp its declared meaning,
    // Subtract) when an operand's record or object type declares an operator of that
    // meaning (BNF sec 4 operator decl): false for none, the built-in rules then judge
    // it. True when handled: the operator that takes the operands by the call rule
    // (several: the one with their exact types) is AId's ResolvedDecl, its result AId's
    // type, each operand bound to its parameter as an argument is (DoConstOrValue); or
    // none takes them (SM0430) or several alike (SM0431), a hint at each operator, AId's
    // type unknown
    hidden method DoDeclaredOperator(const AId: int64; const AOp: OperatorKind): bool;
    var
      LCount: int64;
      LI: int64;
      LOperand: int64;
      LParam: int64;
      LFound: ref NodeList;
      LTaken: ref NodeList;
      LExact: ref NodeList;
      LPicked: int64;
    begin
      LCount := OperandCount(self.FTree, AId);
      LFound := ref NodeList();
      for LI := 0 to LCount - 1 do
        LOperand := OperandAt(self.FTree, AId, LI);
        if self.DoIsNoValue(LOperand) then
          return false;
        end;
        self.DoCollectOperators(self.DoTypeOf(LOperand), AOp, LCount, LFound, AId);
      end;
      if LFound.Count = 0 then
        return false;
      end;
      LTaken := ref NodeList();
      for LI := 0 to LFound.Count - 1 do
        if self.DoOperatorTakes(AId, LFound[LI]) then
          LTaken.Add(LFound[LI]);
        end;
      end;
      if LTaken.Count = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_430, ADAM_MSG_SEMANTICS_OPERATOR_NONE,
          NoArgs().Str(self.FTree[AId].Text).Str(self.DoOperandTypesText(AId)));
        self.DoOperatorHints(ADAM_ERR_SEMANTICS_430, LFound);
        return true;
      end;
      LPicked := LTaken[0];
      if LTaken.Count > 1 then
        LExact := ref NodeList();
        for LI := 0 to LTaken.Count - 1 do
          if self.DoOperatorExact(AId, LTaken[LI]) then
            LExact.Add(LTaken[LI]);
          end;
        end;
        if LExact.Count <> 1 then
          self.DoError(AId, ADAM_ERR_SEMANTICS_431, ADAM_MSG_SEMANTICS_OPERATOR_AMBIGUOUS,
            NoArgs().Str(self.FTree[AId].Text).Str(self.DoOperandTypesText(AId)));
          self.DoOperatorHints(ADAM_ERR_SEMANTICS_431, LTaken);
          return true;
        end;
        LPicked := LExact[0];
      end;
      for LI := 0 to LCount - 1 do
        LParam := self.FTree.NthOf(LPicked, NodeRole.Param, LI);
        self.DoConstOrValue(OperandAt(self.FTree, AId, LI), LParam, self.DoDeclType(LParam), -1, "");
      end;
      self.FTree[AId].ResolvedDecl := LPicked;
      self.DoSetType(AId, CanonicalOf(self.FTree, self.FTree.FirstOf(LPicked, NodeRole.ReturnType)));
      return true;
    end;

    // A binary operator (BNF sec 6), by its meaning; one an operand's record or object
    // type declares runs that operator (DoDeclaredOperator)
    hidden method DoBinary(const AId: int64);
    var
      LLeft: int64;
      LRight: int64;
      LLeftType: int64;
      LRightType: int64;
      LOp: OperatorKind;
    begin
      LLeft := self.FTree.FirstOf(AId, NodeRole.Left);
      LRight := self.FTree.FirstOf(AId, NodeRole.Right);
      self.DoVisit(LLeft);
      self.DoVisit(LRight);
      LOp := self.FTree[AId].Op;
      if self.DoIsDeclarable(LOp) and self.DoDeclaredOperator(AId, LOp) then
        return;
      end;
      if LOp = OperatorKind.In then
        self.DoIn(AId, LLeft, LRight);
        return;
      end;
      self.DoArrayLiteralSide(AId, LLeft, LRight);
      self.DoArrayLiteralSide(AId, LRight, LLeft);
      self.DoSetLiteralSide(LLeft, LRight);
      self.DoSetLiteralSide(LRight, LLeft);
      if self.DoLost(LLeft) or self.DoLost(LRight) then
        return;
      end;
      LLeftType := self.DoTypeOf(LLeft);
      LRightType := self.DoTypeOf(LRight);
      match LOp of
        OperatorKind.LogicalOr, OperatorKind.LogicalAnd:
          self.DoLogical(AId, LLeftType, LRightType);
        OperatorKind.Equal, OperatorKind.NotEqual, OperatorKind.Less, OperatorKind.LessEqual,
        OperatorKind.Greater, OperatorKind.GreaterEqual, OperatorKind.Compare:
          self.DoCompare(AId, LLeft, LRight, LLeftType, LRightType);
        OperatorKind.Add, OperatorKind.Subtract, OperatorKind.Multiply:
          self.DoAdditive(AId, LLeft, LRight, LLeftType, LRightType);
        OperatorKind.Divide:
          self.DoDivide(AId, LLeft, LRight, LLeftType, LRightType);
        OperatorKind.IntDivide, OperatorKind.Modulo, OperatorKind.BitAnd, OperatorKind.BitOr,
        OperatorKind.Xor:
          self.DoIntegral(AId, LLeft, LRight, LLeftType, LRightType);
        OperatorKind.ShiftLeft, OperatorKind.ShiftRight:
          self.DoShift(AId, LLeft, LLeftType, LRightType);
      else
        self.DoOpTwo(AId, LLeftType, LRightType);
      end;
    end;

    // True when AOp is a compound operator a set target takes (BNF sec 4 / A8d: += -= *=
    // and &= |=)
    hidden const method DoIsSetCompound(const AOp: OperatorKind): bool;
    begin
      return (AOp = OperatorKind.AddAssign) or (AOp = OperatorKind.SubtractAssign) or
        (AOp = OperatorKind.MultiplyAssign) or (AOp = OperatorKind.BitAndAssign) or
        (AOp = OperatorKind.BitOrAssign);
    end;

    // A compound assignment's value ASource on ATarget (of AType): the operator must take
    // the target's type (/= on an integer is SM0250: write div), then the value converts
    // to it; a shift's count is an integer, not converted; a pointer moves by an integer. A
    // set literal has no type of its own before it meets one: on a set target it takes the
    // target's (DoConvert, as `:=` gives it), so it is never read as a lost value
    hidden method DoCompound(const AId: int64; const ASource: int64; const AType: int64);
    var
      LClass: TypeClass;
      LOp: OperatorKind;
      LSourceType: int64;
      LRoot: int64;
      LOk: bool;
    begin
      LClass := self.DoClass(AType);
      LOp := self.FTree[AId].Op;
      LRoot := self.DoSkipParens(ASource);
      if (LClass = TypeClass.SetType) and (LRoot <> 0) and
        (self.FTree[LRoot].Kind = NodeKind.SetLiteral) then
        if self.DoIsSetCompound(LOp) then
          self.DoConvert(ASource, AType);
        else
          self.DoOpTwo(AId, AType, AType);
        end;
        return;
      end;
      if self.DoLost(ASource) then
        return;
      end;
      LSourceType := self.DoTypeOf(ASource);
      LOk := false;
      if (LOp = OperatorKind.ShiftLeftAssign) or (LOp = OperatorKind.ShiftRightAssign) then
        LOk := IsIntegerClass(LClass) and IsIntegerClass(self.DoClass(LSourceType));
        if not LOk then
          self.DoOpTwo(AId, AType, LSourceType);
        end;
        return;
      end;
      if (LClass = TypeClass.Pointer) and
        ((LOp = OperatorKind.AddAssign) or (LOp = OperatorKind.SubtractAssign)) then
        if not IsIntegerClass(self.DoClass(LSourceType)) then
          self.DoOpTwo(AId, AType, LSourceType);
        end;
        return;
      end;
      if (LOp = OperatorKind.AddAssign) and ((LClass = TypeClass.Text) or (LClass = TypeClass.WideText)) then
        if LClass = TypeClass.Text then
          LOk := self.DoConcatSide(ASource, AType, self.DoBuiltin("char"));
        else
          LOk := self.DoConcatSide(ASource, AType, self.DoBuiltin("wchar"));
        end;
        if not LOk then
          self.DoOpTwo(AId, AType, LSourceType);
        end;
        return;
      end;
      if LClass = TypeClass.SetType then
        LOk := self.DoIsSetCompound(LOp);
      end;
      if IsIntegerClass(LClass) then
        LOk := LOp <> OperatorKind.DivideAssign;
      end;
      if LClass = TypeClass.Float then
        LOk := (LOp = OperatorKind.AddAssign) or (LOp = OperatorKind.SubtractAssign) or
          (LOp = OperatorKind.MultiplyAssign) or (LOp = OperatorKind.DivideAssign);
      end;
      if not LOk then
        self.DoOpTwo(AId, AType, LSourceType);
        return;
      end;
      self.DoConvert(ASource, AType);
    end;

    // := and the compound assignments: the target can be assigned (SM0255), the value
    // converts to its type, a constant stored into a bitfield fits its width (SM0200,
    // DoBitStore); the target's type
    hidden method DoAssign(const AId: int64);
    var
      LTarget: int64;
      LSource: int64;
      LType: int64;
      LField: int64;
    begin
      LTarget := self.FTree.FirstOf(AId, NodeRole.Target);
      LSource := self.FTree.FirstOf(AId, NodeRole.Source);
      self.DoVisit(LTarget);
      self.DoVisit(LSource);
      LType := self.DoTypeOf(LTarget);
      if LType = 0 then
        return;
      end;
      // An assignment to a property is a statement: its write has no value (pcpp O9)
      if (self.DoPropertyOf(LTarget) <> 0) and
        (self.FTree[self.FTree.ParentOf(AId)].Kind <> NodeKind.ExpressionStatement) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_377, ADAM_MSG_SEMANTICS_PROPERTY_ASSIGN_VALUE,
          NoArgs().Str(self.FTree[self.DoPropertyOf(LTarget)].Text));
        self.DoSetType(AId, LType);
        return;
      end;
      // A polymorphic object is never assigned whole where it may be a descendant (SM0429:
      // only its parent part would change), self included
      if (self.FTree[AId].Op = OperatorKind.Assign) and self.DoMaySlice(LType) and
        self.DoMayBeDescendant(LTarget) and (self.DoIsAssignable(LTarget) or
        (self.FTree[self.DoSkipParens(LTarget)].Kind = NodeKind.SelfExpression)) then
        self.DoError(LTarget, ADAM_ERR_SEMANTICS_429, ADAM_MSG_SEMANTICS_SLICE_ASSIGN,
          NoArgs().Str(self.DoExprText(LTarget)).Str(self.DoText(LType)).Str(self.DoText(LType)));
        self.DoSetType(AId, LType);
        return;
      end;
      if not self.DoIsAssignable(LTarget) then
        self.DoNotAssignable(LTarget);
      else
        self.DoWritten(LTarget);
      end;
      self.DoSetType(AId, LType);
      // A mutex is never assigned (a lock would be copied with it): SM0621
      if HoldsMutex(self.FTree, LType) then
        self.DoError(LTarget, ADAM_ERR_SEMANTICS_621, ADAM_MSG_SEMANTICS_MUTEX_ASSIGN,
          NoArgs().Str(self.DoExprText(LTarget)).Str(self.DoText(LType)));
        return;
      end;
      if self.FTree[AId].Op = OperatorKind.Assign then
        self.DoPackSource(LSource, LType);
        LField := self.DoBitfieldIn(LTarget);
        self.DoOwnMoves(LSource, false);
        // a string's text kept by a C string field's holder (F4), and the holders a copy
        // of such fields carries
        if IsCTextPointer(self.FTree, LType) then
          if self.DoCTextStore(AId, LTarget, LSource, LType) then
            return;
          end;
        else
          if HoldsCText(self.FTree, LType) then
            self.FTree[AId].ResolvedJump := self.DoHoldRoot(LTarget, false);
            self.DoNoteCTextCopy(AId, LSource);
          end;
        end;
        if self.DoConvert(LSource, LType) and (LField <> 0) then
          self.DoBitStore(LField, LSource);
        end;
        return;
      end;
      // An aggregate's compound operator (a set's) writes its target through its address: a
      // place a packed record may misalign has none to give (SM0270); a scalar's operator
      // writes the place as it is
      if (not IsScalarOrPointer(self.FTree, LType)) and self.DoMayBeMisaligned(LTarget) then
        self.DoError(LTarget, ADAM_ERR_SEMANTICS_270, ADAM_MSG_SEMANTICS_MISALIGNED_COMPOUND,
          NoArgs().Str(self.FTree[AId].Text).Str(self.DoExprText(LTarget)));
        return;
      end;
      self.DoCompound(AId, LSource, LType);
    end;

    // True when `addr of AOperand` gives a ptr to const (BNF sec 6): a place that cannot be
    // assigned, and anything of self's own storage in a const method or a property's read
    // (self is read-only there, SM0387 / SM0373). A bare self is its method's object: in a
    // method that may change it, `addr of self` is a ptr to its type (BNF sec 4), though
    // `self := X` stays no assignment (DoIsAssignable)
    hidden const method DoAddressConst(const AOperand: int64): bool;
    var
      LMethod: int64;
      LReadOnly: bool;
      LAt: int64;
    begin
      LMethod := self.DoEnclosingRoutine(AOperand);
      LReadOnly := false;
      if LMethod <> 0 then
        if (self.FTree[LMethod].Kind = NodeKind.MethodDecl) and
          self.FTree[LMethod].HasFlag(NodeFlag.ConstMethod) then
          LReadOnly := true;
        end;
        if self.FTree[LMethod].Kind = NodeKind.PropertyRead then
          LReadOnly := true;
        end;
      end;
      if LReadOnly and self.DoThroughSelf(AOperand) then
        return true;
      end;
      LAt := self.DoSkipParens(AOperand);
      if (LAt <> 0) and (self.FTree[LAt].Kind = NodeKind.SelfExpression) then
        return false;
      end;
      return not self.DoIsAssignable(AOperand);
    end;

    // True when the place AExpr is part of self's own storage: self, or a field or an
    // element reached from it by value (a field of a field, an element of a static or
    // dynamic array or a string field). Through a pointer, an own or a ref it is another
    // object's storage
    hidden const method DoThroughSelf(const AExpr: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
      LOperand: int64;
      LClass: TypeClass;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      LKind := self.FTree[LAt].Kind;
      if LKind = NodeKind.SelfExpression then
        return true;
      end;
      if (LKind <> NodeKind.MemberExpression) and (LKind <> NodeKind.IndexExpression) then
        return false;
      end;
      if self.FTree[LAt].HasFlag(NodeFlag.Arrow) then
        return false;
      end;
      LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
      LClass := self.DoClass(self.DoTypeOf(LOperand));
      if IsPointerClass(LClass) or (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
        return false;
      end;
      return self.DoThroughSelf(LOperand);
    end;

    // The property AProperty written at AAt (ATarget the whole target, AObject the value
    // whose property it is): it needs a write (SM0375) this place may reach (a hidden write:
    // SM0019); false when it has no write
    hidden method DoPropertyWritten(const ATarget: int64; const AAt: int64; const AObject: int64;
      const AProperty: int64): bool;
    var
      LWrite: int64;
    begin
      LWrite := PropertyWriteOf(self.FTree, AProperty);
      if LWrite = 0 then
        self.DoErrorName(ATarget, ADAM_ERR_SEMANTICS_375, ADAM_MSG_SEMANTICS_PROPERTY_NO_WRITE,
          NoArgs().Str(self.FTree[AProperty].Text));
        return false;
      end;
      if self.FTree[LWrite].HasFlag(NodeFlag.Hidden) then
        self.DoHiddenReach(AAt, AObject, LWrite);
      end;
      return true;
    end;

    // The property the expression AExpr (through parentheses) reads or writes: a member
    // access or an index (DoPropertyIndex) whose ResolvedDecl is a property; 0 otherwise
    hidden const method DoPropertyOf(const AExpr: int64): int64;
    var
      LAt: int64;
      LDecl: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return 0;
      end;
      if (self.FTree[LAt].Kind <> NodeKind.MemberExpression) and
        (self.FTree[LAt].Kind <> NodeKind.IndexExpression) then
        return 0;
      end;
      LDecl := self.FTree[LAt].ResolvedDecl;
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.PropertyDecl) then
        return 0;
      end;
      return LDecl;
    end;

    // True when the property access AId on AObject (AAccess the member access whose
    // ResolvedEmbed tells whether an embed holds the property) sits inside the property's
    // own accessor AAccessor, its read or its write, reached through self or parent: it
    // would run that accessor again, forever (SM0374, pcpp's DoInOwnAccessor). A property
    // reached through an embed is the embed's, never this accessor's
    hidden const method DoInOwnAccessor(const AId: int64; const AObject: int64; const AAccess: int64;
      const AAccessor: int64): bool;
    var
      LObject: int64;
      LKind: NodeKind;
    begin
      if (AAccessor = 0) or (self.DoEnclosingRoutine(AId) <> AAccessor) then
        return false;
      end;
      if (AAccess <> 0) and (self.FTree[AAccess].ResolvedEmbed <> 0) then
        return false;
      end;
      LObject := self.DoSkipParens(AObject);
      if LObject = 0 then
        return false;
      end;
      LKind := self.FTree[LObject].Kind;
      return (LKind = NodeKind.SelfExpression) or (LKind = NodeKind.ParentExpression);
    end;

    // True when the expression AId is the target of an assignment (its write runs, not its
    // read: DoWritten judges it)
    hidden const method DoIsAssignTarget(const AId: int64): bool;
    var
      LParent: int64;
    begin
      LParent := self.FTree.ParentOf(AId);
      return (LParent <> 0) and (self.FTree[LParent].Kind = NodeKind.AssignExpression) and
        (self.FTree.RoleOf(AId) = NodeRole.Target);
    end;

    // ATarget, a place DoIsAssignable refused, written by an assignment or ++ / --: SM0714
    // when the place is (a part of) a variable an async block copies (DoAsyncCopy, T4), else
    // SM0255
    hidden method DoNotAssignable(const ATarget: int64);
    var
      LName: int64;
    begin
      LName := self.DoCopiedName(ATarget);
      if LName <> 0 then
        self.DoError(ATarget, ADAM_ERR_SEMANTICS_714, ADAM_MSG_SEMANTICS_ASYNC_WRITE,
          NoArgs().Str(self.FTree[LName].Text));
        return;
      end;
      self.DoError(ATarget, ADAM_ERR_SEMANTICS_255, ADAM_MSG_SEMANTICS_NOT_ASSIGNABLE,
        NoArgs().Str(self.DoExprText(ATarget)));
    end;

    // The name under the place APlace whose variable an async block copies (DoAsyncCopy,
    // T4): APlace itself, or the base of a field or an element of it reached by value (no
    // ptr, no dereference: through one the write goes elsewhere); 0 when there is none
    hidden const method DoCopiedName(const APlace: int64): int64;
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
      LClass: TypeClass;
    begin
      LAt := self.DoSkipParens(APlace);
      while LAt <> 0 do
        LKind := NameKindOf(self.FTree, LAt);
        if LKind = NodeKind.NameExpression then
          // only what could be written outside the block (a constant is SM0255 anywhere)
          LDecl := self.FTree[LAt].ResolvedDecl;
          if (LDecl <> 0) and ((self.FTree[LDecl].Kind = NodeKind.VarDecl) or
            ((self.FTree[LDecl].Kind = NodeKind.Param) and
            (not self.FTree[LDecl].HasFlag(NodeFlag.ConstParam)))) and
            (self.DoAsyncCopy(LAt, LDecl) <> 0) then
            return LAt;
          end;
          return 0;
        end;
        if ((LKind <> NodeKind.MemberExpression) and (LKind <> NodeKind.IndexExpression)) or
          self.FTree[LAt].HasFlag(NodeFlag.Arrow) then
          return 0;
        end;
        LAt := self.DoSkipParens(self.FTree.FirstOf(LAt, NodeRole.Operand));
        LClass := self.DoClass(self.DoTypeOf(LAt));
        if (LClass = TypeClass.Pointer) or (LClass = TypeClass.UntypedPointer) or
          (LClass = TypeClass.RefType) or (LClass = TypeClass.OwnType) then
          return 0;
        end;
      end;
      return 0;
    end;

    // The async block (T4) whose body AId stands in (at any depth, inside its own routine)
    // that copies ADecl: a variable, constant or parameter of the routine declared outside
    // the block (a module's never: it is shared, not copied), the innermost such block; 0
    // when there is none. The block reads its copy, taken at the async: never written
    hidden const method DoAsyncCopy(const AId: int64; const ADecl: int64): int64;
    var
      LAt: int64;
      LKind: NodeKind;
    begin
      if self.FTree.RoleOf(ADecl) = NodeRole.Declaration then
        return 0;
      end;
      LKind := self.FTree[ADecl].Kind;
      if (LKind <> NodeKind.VarDecl) and (LKind <> NodeKind.ConstDecl) and (LKind <> NodeKind.Param) then
        return 0;
      end;
      LAt := self.FTree.ParentOf(AId);
      while LAt <> 0 do
        LKind := self.FTree[LAt].Kind;
        // only the block form copies: `async F(x)` passes its arguments as a call does
        if (LKind = NodeKind.AsyncExpression) and (self.FTree.FirstOf(LAt, NodeRole.Body) <> 0) and
          (not self.FTree.IsAncestor(LAt, ADecl)) then
          return LAt;
        end;
        if IsRoutineLike(LKind) or (LKind = NodeKind.Module) or (LKind = NodeKind.TestBlock) then
          return 0;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // The place ATarget is written (an assignment, ++ / --): a property, reached as a member
    // or by an index (DoPropertyIndex: X.P[i] or a default property's X[i]), needs a write
    // (DoPropertyWritten) and is not assigned through self in its own write (SM0374); a
    // const method changes nothing of its object (SM0387), nor does a property's read
    // (SM0373); a for iterator is not written inside its loop (DoIteratorWritten)
    hidden method DoWritten(const ATarget: int64);
    var
      LAt: int64;
      LDecl: int64;
      LObject: int64;
      LAccess: int64;
      LMethod: int64;
    begin
      self.DoIteratorWritten(ATarget);
      self.DoExitCodeWritten(ATarget);
      self.DoUnshareWritten(ATarget);
      LAt := self.DoSkipParens(ATarget);
      if (LAt <> 0) and ((self.FTree[LAt].Kind = NodeKind.MemberExpression) or
        (self.FTree[LAt].Kind = NodeKind.IndexExpression)) then
        LDecl := self.FTree[LAt].ResolvedDecl;
        if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
          LObject := self.FTree.FirstOf(LAt, NodeRole.Operand);
          LAccess := LAt;
          // X.P[i]: the object is the member's operand, not the member
          if (self.FTree[LAt].Kind = NodeKind.IndexExpression) and
            (self.FTree[LObject].Kind = NodeKind.MemberExpression) and
            (self.FTree[LObject].ResolvedDecl = LDecl) then
            LAccess := LObject;
            LObject := self.FTree.FirstOf(LObject, NodeRole.Operand);
          end;
          if not self.DoPropertyWritten(ATarget, LAt, LObject, LDecl) then
            return;
          end;
          if self.DoInOwnAccessor(LAt, LObject, LAccess, PropertyWriteOf(self.FTree, LDecl)) then
            self.DoErrorName(ATarget, ADAM_ERR_SEMANTICS_374, ADAM_MSG_SEMANTICS_PROPERTY_OWN_WRITE,
              NoArgs().Str(self.FTree[LDecl].Text));
            return;
          end;
        end;
      end;
      LMethod := self.DoEnclosingRoutine(ATarget);
      if LMethod = 0 then
        return;
      end;
      if (self.FTree[LMethod].Kind = NodeKind.MethodDecl) and
        self.FTree[LMethod].HasFlag(NodeFlag.ConstMethod) and self.DoThroughSelf(ATarget) then
        self.DoError(ATarget, ADAM_ERR_SEMANTICS_387, ADAM_MSG_SEMANTICS_CONST_METHOD_CHANGE,
          NoArgs().Str(self.FTree[LMethod].Text).Str(self.DoExprText(ATarget)));
        return;
      end;
      // A property's read has self const (pcpp O9): it changes nothing of its object
      if (self.FTree[LMethod].Kind = NodeKind.PropertyRead) and self.DoThroughSelf(ATarget) then
        self.DoError(ATarget, ADAM_ERR_SEMANTICS_373, ADAM_MSG_SEMANTICS_PROPERTY_READ_CHANGE,
          NoArgs().Str(self.FTree[self.FTree.ParentOf(LMethod)].Text).Str(self.DoExprText(ATarget)));
      end;
    end;

    // C ? A : B: C is a bool; one branch converts to the other's type (that type), or two
    // numbers meet at their common type; SM0200 at the else branch otherwise
    hidden method DoConditional(const AId: int64);
    var
      LCondition: int64;
      LThen: int64;
      LElse: int64;
      LThenType: int64;
      LElseType: int64;
    begin
      LCondition := self.FTree.FirstOf(AId, NodeRole.Condition);
      LThen := self.FTree.FirstOf(AId, NodeRole.Then);
      LElse := self.FTree.FirstOf(AId, NodeRole.Else);
      self.DoVisit(LCondition);
      self.DoVisit(LThen);
      self.DoVisit(LElse);
      self.DoCondition(LCondition);
      if self.DoLost(LThen) or self.DoLost(LElse) then
        return;
      end;
      LThenType := self.DoTypeOf(LThen);
      LElseType := self.DoTypeOf(LElse);
      if self.DoWouldConvert(LElse, LThenType) then
        self.DoConvert(LElse, LThenType);
        self.DoSetType(AId, LThenType);
        return;
      end;
      if self.DoWouldConvert(LThen, LElseType) then
        self.DoConvert(LThen, LElseType);
        self.DoSetType(AId, LElseType);
        return;
      end;
      if IsNumericClass(self.DoClass(LThenType)) and IsNumericClass(self.DoClass(LElseType)) then
        self.DoSetType(AId, self.DoArithmetic(AId, LThen, LElse, LThenType, LElseType));
        return;
      end;
      self.DoNoConvert(LElse, LElseType, LThenType);
    end;

    // The type the bounds of the array type AArray give its index when it is a static
    // array bounded by chars, wchars or choices; 0 for any other array (an integer index)
    hidden method DoIndexBoundType(const AArray: int64): int64;
    var
      LLow: int64;
      LBound: int64;
      LBoundClass: TypeClass;
    begin
      if self.DoClass(AArray) <> TypeClass.StaticArray then
        return 0;
      end;
      LLow := self.FTree.FirstOf(self.FTree[AArray].ResolvedDecl, NodeRole.LowBound);
      // a bound the array type owns in an index family is typed already (Types'
      // DoOwnBound): a visit would type its literal as an integer
      if self.FTree[LLow].ResolvedType = 0 then
        self.DoVisit(LLow);
      end;
      LBound := self.DoTypeOf(LLow);
      LBoundClass := self.DoClass(LBound);
      if (LBoundClass = TypeClass.Char) or (LBoundClass = TypeClass.WideChar) or
        (LBoundClass = TypeClass.ChoicesType) then
        return LBound;
      end;
      return 0;
    end;

    // The index AIndex of the array type AArray: a char- or choices-bounded array takes a
    // value of its bounds' type (SM0261 family), any other an integer; an index of the
    // right type is then judged against a static array's folded bounds (DoIndexInRange)
    hidden method DoArrayIndex(const AIndex: int64; const AArray: int64);
    var
      LBound: int64;
    begin
      LBound := self.DoIndexBoundType(AArray);
      if LBound = 0 then
        self.DoIntegerIndex(AIndex);
        if (not self.DoLost(AIndex)) and IsIntegerClass(self.DoClass(self.DoTypeOf(AIndex))) then
          self.DoIndexInRange(AIndex, AArray, self.DoTypeOf(AIndex));
        end;
        return;
      end;
      if self.DoLost(AIndex) then
        return;
      end;
      if self.DoWouldConvert(AIndex, LBound) then
        self.DoConvert(AIndex, LBound);
        self.DoIndexInRange(AIndex, AArray, LBound);
        return;
      end;
      self.DoError(AIndex, ADAM_ERR_SEMANTICS_261, ADAM_MSG_SEMANTICS_INDEX_FAMILY,
        NoArgs().Str(self.DoText(AArray)).Str(self.DoText(LBound)).Str(self.DoText(self.DoTypeOf(AIndex))));
    end;

    // pcpp's F45 (SM0276): a static array AArray indexed by a constant AIndex outside its
    // folded bounds is an error at the index. The index is read as a value of AType (the
    // bounds' type for a char / wchar / choices array, else its own type), the bounds as
    // BoundValue reads them (the target's char reading), so both compare as values of the
    // index type. An index or a bound that did not fold is not judged here
    hidden method DoIndexInRange(const AIndex: int64; const AArray: int64; const AType: int64);
    var
      LDecl: int64;
      LLowExpr: int64;
      LHighExpr: int64;
      LLow: int64;
      LHigh: int64;
      LIndex: int64;
      LAbove: bool;
    begin
      if self.DoClass(AArray) <> TypeClass.StaticArray then
        return;
      end;
      LDecl := self.FTree[AArray].ResolvedDecl;
      LLowExpr := self.FTree.FirstOf(LDecl, NodeRole.LowBound);
      LHighExpr := self.FTree.FirstOf(LDecl, NodeRole.HighBound);
      if (not BoundValue(self.FTree, self.FTarget, LLowExpr, LLow)) or
        (not BoundValue(self.FTree, self.FTarget, LHighExpr, LHigh)) or
        (not self.DoFoldedBits(AIndex, AType, LIndex)) then
        return;
      end;
      // An unsigned index past int64's top reads as negative here: it is above every bound
      // (BoundValue reads no bound that high)
      LAbove := self.DoUnsignedValues(AType) and (LIndex < 0);
      if (not LAbove) and (LIndex >= LLow) and (LIndex <= LHigh) then
        return;
      end;
      self.DoError(AIndex, ADAM_ERR_SEMANTICS_276, ADAM_MSG_SEMANTICS_INDEX_OUTSIDE,
        NoArgs().Str(self.DoExprText(AIndex)).Str(self.DoText(AArray)).Str(
        self.DoExprText(LLowExpr)).Str(self.DoExprText(LHighExpr)));
    end;

    // An index that is an integer (SM0261 otherwise)
    hidden method DoIntegerIndex(const AIndex: int64);
    begin
      if self.DoLost(AIndex) then
        return;
      end;
      if not IsIntegerClass(self.DoClass(self.DoTypeOf(AIndex))) then
        self.DoError(AIndex, ADAM_ERR_SEMANTICS_261, ADAM_MSG_SEMANTICS_INDEX_NOT_INT,
          NoArgs().Str(self.DoText(self.DoTypeOf(AIndex))));
      end;
    end;

    // The property the index AId on AOperand reads or writes (PaskalCPP's rule): X.P[i]
    // when P is an indexed property; X[i] when X is an object, or an own / ref holding one,
    // with a default property (DefaultPropertyOf; never through a weak). Then AId's
    // ResolvedDecl is that property, its type the property's, AIndex converts to the
    // property's index type, and a hidden default property is reached as a hidden member
    // is (SM0019). False when AId is no property access (DoIndex judges it as any index)
    hidden method DoPropertyIndex(const AId: int64; const AOperand: int64; const AIndex: int64): bool;
    var
      LProperty: int64;
      LType: int64;
      LClass: TypeClass;
      LParam: int64;
      LParamType: int64;
      LAccess: int64;
      LObject: int64;
    begin
      LProperty := 0;
      if self.FTree[AOperand].Kind = NodeKind.MemberExpression then
        LProperty := self.FTree[AOperand].ResolvedDecl;
        if (LProperty <> 0) and ((self.FTree[LProperty].Kind <> NodeKind.PropertyDecl) or
          (self.FTree.FirstOf(LProperty, NodeRole.Param) = 0)) then
          // A field, a method, a plain property: its value is indexed as any value
          LProperty := 0;
        end;
      end;
      if LProperty = 0 then
        LType := self.DoTypeOf(AOperand);
        LClass := self.DoClass(LType);
        if (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
          LType := TargetOf(self.FTree, LType);
          LClass := self.DoClass(LType);
        end;
        if LClass <> TypeClass.ObjectType then
          return false;
        end;
        LProperty := DefaultPropertyOf(self.FTree, LType);
        if LProperty = 0 then
          return false;
        end;
        if self.FTree[LProperty].HasFlag(NodeFlag.Hidden) then
          self.DoHiddenReach(AId, AOperand, LProperty);
        end;
      end;
      self.FTree[AId].ResolvedDecl := LProperty;
      self.DoSetType(AId, self.DoMemberType(LProperty));
      // Read through self in its own read: that read again, forever (SM0374, at the index)
      if not self.DoIsAssignTarget(AId) then
        if self.FTree[AOperand].ResolvedDecl = LProperty then
          LAccess := AOperand;
          LObject := self.FTree.FirstOf(AOperand, NodeRole.Operand);
        else
          LAccess := 0;
          LObject := AOperand;
        end;
        if self.DoInOwnAccessor(AId, LObject, LAccess, self.FTree.FirstOf(LProperty, NodeRole.Read)) then
          self.DoErrorName(AId, ADAM_ERR_SEMANTICS_374, ADAM_MSG_SEMANTICS_PROPERTY_OWN_READ,
            NoArgs().Str(self.FTree[LProperty].Text));
        end;
      end;
      // A parameter the parser lost has no type: nothing to convert to (already reported)
      LParam := self.FTree.FirstOf(LProperty, NodeRole.Param);
      LParamType := self.DoDeclType(LParam);
      if (LParamType <> 0) and (not self.DoLost(AIndex)) then
        self.DoConvert(AIndex, LParamType);
      end;
      return true;
    end;

    // X[i]: a property (DoPropertyIndex), an array's element, a string's char, a wstring's
    // wchar, what a typed pointer points at (the untyped ptr is SM0253); anything else SM0260
    hidden method DoIndex(const AId: int64);
    var
      LOperand: int64;
      LIndex: int64;
      LType: int64;
      LClass: TypeClass;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      LIndex := self.FTree.FirstOf(AId, NodeRole.Index);
      self.DoVisit(LOperand);
      self.DoVisit(LIndex);
      if self.DoLost(LOperand) then
        return;
      end;
      if self.DoPropertyIndex(AId, LOperand, LIndex) then
        return;
      end;
      LType := self.DoTypeOf(LOperand);
      LClass := self.DoClass(LType);
      if (LClass = TypeClass.StaticArray) or (LClass = TypeClass.DynamicArray) then
        self.DoArrayIndex(LIndex, LType);
        self.DoSetType(AId, TargetOf(self.FTree, LType));
        return;
      end;
      if LClass = TypeClass.FlexibleArray then
        // from 0, no high bound: C's flexible member, unchecked (M9e0b)
        self.DoIntegerIndex(LIndex);
        self.DoSetType(AId, TargetOf(self.FTree, LType));
        return;
      end;
      if (LClass = TypeClass.Text) or (LClass = TypeClass.WideText) or (LClass = TypeClass.Pointer) then
        self.DoIntegerIndex(LIndex);
        if LClass = TypeClass.Text then
          self.DoSetType(AId, self.DoBuiltin("char"));
        else
          if LClass = TypeClass.WideText then
            self.DoSetType(AId, self.DoBuiltin("wchar"));
          else
            self.DoSetType(AId, TargetOf(self.FTree, LType));
          end;
        end;
        return;
      end;
      if LClass = TypeClass.UntypedPointer then
        self.DoUntyped(LOperand);
        return;
      end;
      self.DoError(AId, ADAM_ERR_SEMANTICS_260, ADAM_MSG_SEMANTICS_NOT_INDEXABLE,
        NoArgs().Str(self.DoText(LType)));
    end;

    // The type a member declaration AMember gives its use: a field's, a property's, an
    // embed's type, a method's routine type
    hidden method DoMemberType(const AMember: int64): int64;
    begin
      return self.DoDeclType(AMember);
    end;

    // The extend declaration AId checked (BNF sec 3, F1): its target a record, object,
    // overlay or choices type (an alias of one too; SM0748), a generic one named with its
    // type arguments (SM0748); each member a method or an operator with no virtual word and
    // not hidden (SM0749), named as no member of the target (SM0750). Its members are typed
    // as the target's own (their self is the target: Types.DeclaringTypeOf)
    hidden method DoExtendDecl(const AId: int64);
    var
      LTarget: int64;
      LType: int64;
      LClass: TypeClass;
      LBody: int64;
      LMember: int64;
      LOwn: int64;
      LKind: NodeKind;
      LI: int64;
    begin
      LTarget := self.FTree.FirstOf(AId, NodeRole.ExtendTarget);
      self.DoVisit(LTarget);
      LType := self.FTree[AId].ResolvedType;
      if (LType = 0) or self.DoLost(LTarget) then
        return;
      end;
      // a generic target named with no type args is SM0735 (DoInstance): nothing to extend
      if (self.FTree[LType].Kind = NodeKind.TypeDecl) and (self.FTree.FirstOf(LType, NodeRole.GenericParam) <> 0) and
        not IsInTemplate(self.FTree, AId) then
        self.FTree[AId].ResolvedType := 0;
        return;
      end;
      LClass := self.DoClass(LType);
      if IsInTemplate(self.FTree, AId) then
        // a generic type's template: what its body is
        LKind := self.FTree[self.FTree.FirstOf(LType, NodeRole.TypeOf)].Kind;
        LClass := TypeClass.Unknown;
        if (LKind = NodeKind.RecordType) or (LKind = NodeKind.ObjectType) or (LKind = NodeKind.OverlayType) then
          LClass := TypeClass.RecordType;
        end;
      end;
      if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.ObjectType) and
        (LClass <> TypeClass.OverlayType) and (LClass <> TypeClass.ChoicesType) then
        self.DoError(LTarget, ADAM_ERR_SEMANTICS_748, ADAM_MSG_SEMANTICS_EXTEND_TARGET,
          NoArgs().Str(self.FTree[LTarget].Text));
        self.FTree[AId].ResolvedType := 0;
        return;
      end;
      // each instance's code is made where it is used: no binary defines it (F1b)
      if (self.FTree.FirstOf(AId, NodeRole.External) <> 0) and (self.FTree.FirstOf(AId, NodeRole.GenericParam) <> 0) then
        self.DoError(self.FTree.FirstOf(AId, NodeRole.External), ADAM_ERR_SEMANTICS_753,
          ADAM_MSG_SEMANTICS_EXTEND_EXTERNAL_GENERIC, NoArgs().Str(self.FTree[LTarget].Text));
      end;
      LBody := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        LKind := self.FTree[LMember].Kind;
        if (LKind = NodeKind.Error) or self.FTree[LMember].HasFlag(NodeFlag.Recovered) then
          skip;
        end;
        if ((LKind <> NodeKind.MethodDecl) and (LKind <> NodeKind.OperatorDecl)) or
          self.FTree[LMember].HasFlag(NodeFlag.Hidden) or self.FTree[LMember].HasFlag(NodeFlag.Virtual) or
          self.FTree[LMember].HasFlag(NodeFlag.Override) or self.FTree[LMember].HasFlag(NodeFlag.Final) or
          self.FTree[LMember].HasFlag(NodeFlag.Abstract) then
          self.DoError(LMember, ADAM_ERR_SEMANTICS_749, ADAM_MSG_SEMANTICS_EXTEND_MEMBER,
            NoArgs().Str(self.FTree.ConstructPhrase(LMember)));
          skip;
        end;
        if LKind = NodeKind.OperatorDecl then
          skip;
        end;
        LOwn := MemberOf(self.FTree, LType, self.FTree[LMember].Text);
        if LOwn <> 0 then
          self.DoError(LMember, ADAM_ERR_SEMANTICS_750, ADAM_MSG_SEMANTICS_EXTEND_CLASH,
            NoArgs().Str(self.FTree[LMember].Text).Str(self.DoText(LType)).Int(int64(self.FTree[LOwn].Place.Line)));
          skip;
        end;
        // an earlier extend of this module adding the name to the same target: both are
        // always visible here (SM0751 now, the later one flagged Repeated: no second symbol)
        LOwn := self.DoEarlierExtendMember(AId, self.FTree[LMember].Text);
        if LOwn <> 0 then
          self.DoError(LMember, ADAM_ERR_SEMANTICS_751, ADAM_MSG_SEMANTICS_EXTEND_TWICE,
            NoArgs().Str(self.FTree[LMember].Text).Str(self.DoText(LType)).Str(self.DoWhereText(LOwn)).Str(
            self.DoWhereText(LMember)));
          self.FTree[LMember].AddFlag(NodeFlag.Repeated);
        end;
      end;
    end;

    // The member AName of a plain extend declared before the plain extend AExtend in its
    // module with the same target; 0 when none adds it
    hidden method DoEarlierExtendMember(const AExtend: int64; const AName: string): int64;
    var
      LModule: int64;
      LDecl: int64;
      LMember: int64;
      LI: int64;
    begin
      LModule := self.FTree.ParentOf(AExtend);
      if (LModule = 0) or (self.FTree[LModule].Kind <> NodeKind.Module) then
        return 0;
      end;
      for LI := 0 to self.FTree.CountOf(LModule, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(LModule, NodeRole.Declaration, LI);
        if LDecl = AExtend then
          return 0;
        end;
        // generic extends overlap per instance: judged at the use (DoExtendMember)
        if (self.FTree[LDecl].Kind <> NodeKind.ExtendDecl) or (self.FTree[LDecl].ResolvedType = 0) or
          (self.FTree[LDecl].ResolvedType <> self.FTree[AExtend].ResolvedType) or
          (self.FTree.FirstOf(LDecl, NodeRole.GenericParam) <> 0) or
          (self.FTree.FirstOf(AExtend, NodeRole.GenericParam) <> 0) then
          skip;
        end;
        LMember := FindMember(self.FTree, self.FTree.FirstOf(LDecl, NodeRole.TypeOf), AName);
        if LMember <> 0 then
          return LMember;
        end;
      end;
      return 0;
    end;

    // The body of the extend AExtend that adds to the type AType for the use AUse (BNF sec 3,
    // F1), 0 when it does not: a plain extend's own when its target is AType; a generic one's
    // instance for AType (found or made, typed) when AType is an instance of its generic
    // whose type arguments equal the extend's fixed ones, each extend parameter bound to the
    // instance's argument in its place
    hidden method DoExtendBodyFor(const AExtend: int64; const AType: int64; const AUse: int64): int64;
    var
      LTarget: int64;
      LInstance: int64;
      LArgs: ref NodeList;
      LParam: int64;
      LArg: int64;
      LBound: int64;
      LFound: int64;
      LMade: int64;
      LMadeInstance: int64;
      LI: int64;
      LJ: int64;
    begin
      if self.FTree.FirstOf(AExtend, NodeRole.GenericParam) = 0 then
        if (self.FTree[AExtend].ResolvedType <> 0) and (self.FTree[AExtend].ResolvedType = AType) then
          return self.FTree.FirstOf(AExtend, NodeRole.TypeOf);
        end;
        return 0;
      end;
      LInstance := InstanceOf(self.FTree, AType);
      if (LInstance = 0) or (self.FTree[AExtend].ResolvedType = 0) or
        (self.FTree[LInstance].ResolvedDecl <> self.FTree[AExtend].ResolvedType) then
        return 0;
      end;
      LTarget := self.FTree.FirstOf(AExtend, NodeRole.ExtendTarget);
      if self.FTree.CountOf(LTarget, NodeRole.TypeArgument) <> self.FTree.CountOf(LInstance, NodeRole.GenericParam) then
        return 0;
      end;
      // the fixed arguments match first
      for LI := 0 to self.FTree.CountOf(LTarget, NodeRole.TypeArgument) - 1 do
        LArg := self.FTree.NthOf(LTarget, NodeRole.TypeArgument, LI);
        LParam := self.FTree[LArg].ResolvedDecl;
        if (LParam <> 0) and (self.FTree.ParentOf(LParam) = AExtend) then
          skip;
        end;
        LBound := self.FTree[self.FTree.NthOf(LInstance, NodeRole.GenericParam, LI)].ResolvedType;
        if CanonicalOf(self.FTree, LArg) <> LBound then
          return 0;
        end;
      end;
      // each extend parameter bound to the instance's argument where the target names it
      LArgs := ref NodeList();
      for LJ := 0 to self.FTree.CountOf(AExtend, NodeRole.GenericParam) - 1 do
        LParam := self.FTree.NthOf(AExtend, NodeRole.GenericParam, LJ);
        LFound := 0;
        for LI := 0 to self.FTree.CountOf(LTarget, NodeRole.TypeArgument) - 1 do
          if self.FTree[self.FTree.NthOf(LTarget, NodeRole.TypeArgument, LI)].ResolvedDecl = LParam then
            LFound := self.FTree[self.FTree.NthOf(LInstance, NodeRole.GenericParam, LI)].ResolvedType;
            leave;
          end;
        end;
        if LFound = 0 then
          return 0;
        end;
        LArgs.Add(LFound);
      end;
      LMade := self.FResolver.MadeCount();
      LMadeInstance := self.FResolver.RoutineInstance(AExtend, LArgs, AUse);
      if LMadeInstance = 0 then
        return 0;
      end;
      self.DoVisitMade(LMade);
      return self.FTree.FirstOf(self.FTree.FirstOf(LMadeInstance, NodeRole.Instance), NodeRole.TypeOf);
    end;

    // The bodies of the extends of the module AModule (all of them when AOwn, else its
    // public ones) that add to AType for AUse (DoExtendBodyFor), into ABodies once each
    hidden method DoExtendsIn(const AModule: int64; const AOwn: bool; const AType: int64; const AUse: int64;
      const ABodies: ref NodeList);
    var
      LDecl: int64;
      LBody: int64;
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(AModule, NodeRole.Declaration, LI);
        if (self.FTree[LDecl].Kind <> NodeKind.ExtendDecl) or self.FTree[LDecl].HasFlag(NodeFlag.Recovered) or
          (not AOwn and not self.FTree[LDecl].HasFlag(NodeFlag.Public)) then
          skip;
        end;
        // its target resolved before it is matched (a use may come before it is visited)
        self.DoVisit(LDecl);
        LBody := self.DoExtendBodyFor(LDecl, AType, AUse);
        if (LBody <> 0) and (ABodies.IndexOf(LBody) < 0) then
          ABodies.Add(LBody);
        end;
      end;
    end;

    // The bodies of the extends visible at AUse (BNF sec 3, F1: declared in AUse's module, or
    // public in a unit it imports) that add to the type AType, into ABodies
    hidden method DoExtendBodies(const AUse: int64; const AType: int64; const ABodies: ref NodeList);
    var
      LModule: int64;
      LUnit: int64;
      LI: int64;
    begin
      if AType = 0 then
        return;
      end;
      LModule := ModuleOf(self.FTree, AUse);
      if LModule = 0 then
        return;
      end;
      self.DoExtendsIn(LModule, true, AType, AUse, ABodies);
      for LI := 0 to self.FTree.CountOf(LModule, NodeRole.Import) - 1 do
        LUnit := self.FTree[self.FTree.NthOf(LModule, NodeRole.Import, LI)].ResolvedUnit;
        if (LUnit <> 0) and (LUnit <> LModule) then
          self.DoExtendsIn(LUnit, false, AType, AUse, ABodies);
        end;
      end;
    end;

    // True when an extend visible at AUse adds an operator spelled AText to the type AType
    // or a type above it (BNF sec 3, F1; Types.DeclaresOperator's twin for extends)
    hidden method DoExtendDeclares(const AUse: int64; const AType: int64; const AText: string): bool;
    var
      LAt: int64;
      LDepth: int64;
      LBodies: ref NodeList;
      LMember: int64;
      LI: int64;
      LJ: int64;
    begin
      LAt := AType;
      LDepth := 0;
      while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
        LBodies := ref NodeList();
        self.DoExtendBodies(AUse, LAt, LBodies);
        for LJ := 0 to LBodies.Count - 1 do
          for LI := 0 to self.FTree.CountOf(LBodies[LJ], NodeRole.Member) - 1 do
            LMember := self.FTree.NthOf(LBodies[LJ], NodeRole.Member, LI);
            if (self.FTree[LMember].Kind = NodeKind.OperatorDecl) and (self.FTree[LMember].Text = AText) then
              return true;
            end;
          end;
        end;
        LAt := ParentTypeOf(self.FTree, LAt);
        LDepth := LDepth + 1;
      end;
      return false;
    end;

    // Where a message names the declaration ADecl: its module's name and its line
    hidden const method DoWhereText(const ADecl: int64): string;
    begin
      return self.FTree[ModuleOf(self.FTree, ADecl)].Text + " line " + IntToStr(int64(self.FTree[ADecl].Place.Line));
    end;

    // The member AName an extend visible at AUse adds to the type AType or to a type above it
    // (BNF sec 3, F1), the type's own level first; one name added by two extends of a level
    // is SM0751 at AUse (the first is given, nothing cascades); 0 when none adds it
    hidden method DoExtendMember(const AUse: int64; const AType: int64; const AName: string): int64;
    var
      LAt: int64;
      LDepth: int64;
      LBodies: ref NodeList;
      LFound: int64;
      LMember: int64;
      LI: int64;
    begin
      LAt := AType;
      LDepth := 0;
      while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
        LBodies := ref NodeList();
        self.DoExtendBodies(AUse, LAt, LBodies);
        LFound := 0;
        for LI := 0 to LBodies.Count - 1 do
          LMember := FindMember(self.FTree, LBodies[LI], AName);
          if (LMember = 0) or self.FTree[LMember].HasFlag(NodeFlag.Repeated) then
            skip;
          end;
          if LFound = 0 then
            LFound := LMember;
            skip;
          end;
          self.DoErrorName(AUse, ADAM_ERR_SEMANTICS_751, ADAM_MSG_SEMANTICS_EXTEND_TWICE,
            NoArgs().Str(AName).Str(self.DoText(LAt)).Str(self.DoWhereText(LFound)).Str(self.DoWhereText(LMember)));
          leave;
        end;
        if LFound <> 0 then
          return LFound;
        end;
        if (self.DoClass(LAt) <> TypeClass.RecordType) and (self.DoClass(LAt) <> TypeClass.ObjectType) then
          return 0;
        end;
        LAt := ParentTypeOf(self.FTree, LAt);
        LDepth := LDepth + 1;
      end;
      return 0;
    end;

    // The aggregate a member access AId on AOperand (of AType) reaches: '.' on a record,
    // an object, an overlay or the object an own / ref holds; '->' through a typed pointer,
    // an own or a ref. 0 (reported) for anything else
    hidden method DoMemberBase(const AId: int64; const AOperand: int64; const AType: int64): int64;
    var
      LClass: TypeClass;
      LOperandText: string;
    begin
      LClass := self.DoClass(AType);
      if (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
        return TargetOf(self.FTree, AType);
      end;
      if self.FTree[AId].HasFlag(NodeFlag.Arrow) then
        if LClass = TypeClass.Pointer then
          return TargetOf(self.FTree, AType);
        end;
        // '->' is an operator the untyped ptr does not take (SM0250, pcpp's; SM0253 is ^ / [i]),
        // at the operand, with the cast that gives it a type
        if LClass = TypeClass.UntypedPointer then
          self.DoError(AOperand, ADAM_ERR_SEMANTICS_250, ADAM_MSG_SEMANTICS_UNTYPED_POINTER,
            NoArgs().Str(self.DoExprText(AOperand)).Str(self.DoExprText(AOperand)));
          return 0;
        end;
        self.DoError(AId, ADAM_ERR_SEMANTICS_250, ADAM_MSG_SEMANTICS_OP_ONE,
          NoArgs().Str("->").Str(self.DoText(AType)));
        return 0;
      end;
      if LClass = TypeClass.Pointer then
        LOperandText := self.DoExprText(AOperand);
        self.DoError(AId, ADAM_ERR_SEMANTICS_250, ADAM_MSG_SEMANTICS_DOT_ON_POINTER,
          NoArgs().Str(LOperandText).Str(LOperandText).Str(self.FTree[AId].Text).Str(
          LOperandText).Str(self.FTree[AId].Text));
        return 0;
      end;
      return AType;
    end;

    // X.m / X->m: a unit's member (resolved by ResolveNames), a choices type's value
    // (TColor.Red), else a member of the aggregate X reaches (SM0009 when it has none)
    hidden method DoMember(const AId: int64);
    var
      LOperand: int64;
      LNamed: int64;
      LMember: int64;
      LBase: int64;
      LDecl: int64;
    begin
      if self.FTree[AId].ResolvedUnit <> 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_MODULE_NOT_VALUE,
          NoArgs().Str(self.DoExprText(AId)));
        return;
      end;
      LDecl := self.FTree[AId].ResolvedDecl;
      if LDecl <> 0 then
        if DoIsTypeDecl(self.FTree[LDecl].Kind) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_TYPE_NOT_VALUE,
            NoArgs().Str(self.DoExprText(AId)));
          return;
        end;
        self.DoSetType(AId, self.DoDeclType(LDecl));
        return;
      end;
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      // '->' reaches through a pointer: a module's or a type's names are reached with '.'
      // (SM0014; ResolveNames' chains stop at '->', so nothing else reported it)
      if self.FTree[AId].HasFlag(NodeFlag.Arrow) and
        ((self.FTree[LOperand].ResolvedUnit <> 0) or (self.DoTypeNamed(LOperand) <> 0)) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_014, ADAM_MSG_SEMANTICS_ARROW_QUALIFIED,
          NoArgs().Str(self.DoExprText(LOperand)));
        return;
      end;
      // A unit's member ResolveNames could not resolve: SM0005 / SM0006 is reported at this
      // node already, so neither it nor the unit before it is checked again
      if self.FTree[LOperand].ResolvedUnit <> 0 then
        return;
      end;
      LNamed := self.DoTypeNamed(LOperand);
      if LNamed <> 0 then
        // The operand names a type, not a value: never typed as one
        self.DoFirstVisit(LOperand);
        LMember := MemberOf(self.FTree, LNamed, self.FTree[AId].Text);
        if LMember = 0 then
          LMember := self.DoExtendMember(AId, LNamed, self.FTree[AId].Text);
        end;
        if (LMember <> 0) and (self.FTree[LMember].Kind = NodeKind.ChoiceValue) then
          self.FTree[AId].ResolvedDecl := LMember;
          self.DoSetType(AId, LNamed);
          return;
        end;
        if LMember <> 0 then
          self.DoTypeMember(AId, LNamed, LMember);
          return;
        end;
        if self.DoClass(LNamed) = TypeClass.ChoicesType then
          self.DoErrorName(AId, ADAM_ERR_SEMANTICS_010, ADAM_MSG_SEMANTICS_NO_CHOICE,
            NoArgs().Str(self.DoText(LNamed)).Str(self.FTree[AId].Text));
          return;
        end;
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_009, ADAM_MSG_SEMANTICS_NO_MEMBER,
          NoArgs().Str(self.DoText(LNamed)).Str(self.FTree[AId].Text));
        return;
      end;
      self.DoVisit(LOperand);
      if self.DoLost(LOperand) then
        return;
      end;
      if self.DoClass(self.DoTypeOf(LOperand)) = TypeClass.Varargs then
        self.DoPackMember(AId);
        return;
      end;
      if self.DoClass(self.DoTypeOf(LOperand)) = TypeClass.WeakType then
        self.DoError(AId, ADAM_ERR_SEMANTICS_360, ADAM_MSG_SEMANTICS_WEAK_MEMBER,
          NoArgs().Str(self.DoExprText(LOperand)).Str(self.FTree[AId].Text).Str(
          self.DoExprText(LOperand)));
        return;
      end;
      LBase := self.DoMemberBase(AId, LOperand, self.DoTypeOf(LOperand));
      if LBase = 0 then
        return;
      end;
      LMember := MemberOf(self.FTree, LBase, self.FTree[AId].Text);
      if LMember = 0 then
        LMember := self.DoEmbedMember(AId, LOperand, LBase);
        if LMember < 0 then
          return;
        end;
      end;
      if LMember = 0 then
        LMember := self.DoExtendMember(AId, LBase, self.FTree[AId].Text);
      end;
      if LMember = 0 then
        if self.DoLifetimeName(AId, LBase) then
          return;
        end;
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_009, ADAM_MSG_SEMANTICS_NO_MEMBER,
          NoArgs().Str(self.DoText(LBase)).Str(self.FTree[AId].Text));
        return;
      end;
      if (self.FTree[LMember].Kind = NodeKind.MethodDecl) and self.FTree[LMember].HasFlag(NodeFlag.Static) then
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_747, ADAM_MSG_SEMANTICS_STATIC_THROUGH_VALUE,
          NoArgs().Str(self.FTree[LMember].Text).Str(self.DoText(self.DoDeclaringType(LMember))).Str(
          self.DoText(self.DoDeclaringType(LMember))).Str(self.FTree[LMember].Text));
        return;
      end;
      self.FTree[AId].ResolvedDecl := LMember;
      self.DoSetType(AId, self.DoMemberType(LMember));
      if (self.FTree[LMember].Kind = NodeKind.MethodDecl) and
        (self.DoIsOverloaded(LMember) or self.DoIsGenericCall(AId, LMember)) then
        // an overload set (MO1): the method its call picks is judged there (DoRoutineCall)
        return;
      end;
      self.DoMemberReach(AId, LOperand, LMember);
    end;

    // T.M / U.T.M (AId) naming the member AMember of the type ANamed (BNF sec 3, J3d): a
    // static method, its ResolvedDecl (an overload set's or a generic's member is picked
    // by its call, DoRoutineCall, and its reach judged there); any other member is an
    // instance's, reached through a value (SM0746)
    hidden method DoTypeMember(const AId: int64; const ANamed: int64; const AMember: int64);
    begin
      if (self.FTree[AMember].Kind <> NodeKind.MethodDecl) or not self.FTree[AMember].HasFlag(NodeFlag.Static) then
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_746, ADAM_MSG_SEMANTICS_INSTANCE_THROUGH_TYPE,
          NoArgs().Str(self.DoText(ANamed)).Str(self.FTree[AId].Text).Str(self.DoText(ANamed)));
        return;
      end;
      self.FTree[AId].ResolvedDecl := AMember;
      self.DoSetType(AId, self.DoMemberType(AMember));
      if self.DoIsOverloaded(AMember) or self.DoIsGenericCall(AId, AMember) then
        return;
      end;
      self.DoStaticReach(AId, AMember);
    end;

    // The static method AMember reached by AId (through its type or bare): a hidden one
    // only from the methods of its type and of its descendants (SM0019, as any hidden
    // member, BNF sec 4)
    hidden method DoStaticReach(const AId: int64; const AMember: int64);
    begin
      if self.FTree[AMember].HasFlag(NodeFlag.Hidden) then
        self.DoHiddenReachIn(AId, AMember, true, 0);
      end;
    end;

    // The member access AId on AOperand that reaches the member AMember (a field, a
    // property, the one method of its name, or the overload a call picked: DoRoutineCall):
    // a virtual method through self in a lifetime member (SM0348), a hidden member's reach
    // (SM0019), a property's own rules, a method that may change a const object (SM0426),
    // an abstract method through parent (SM0340)
    hidden method DoMemberReach(const AId: int64; const AOperand: int64; const AMember: int64);
    var
      LOperand: int64;
      LMember: int64;
    begin
      LOperand := AOperand;
      LMember := AMember;
      self.DoLifetimeVirtual(AId, LOperand, LMember);
      if self.FTree[LMember].HasFlag(NodeFlag.Hidden) then
        self.DoHiddenReach(AId, LOperand, LMember);
      end;
      if self.FTree[LMember].Kind = NodeKind.PropertyDecl then
        self.DoPropertyMember(AId, LOperand, LMember);
      end;
      // A method may change its object: never one reached through a const object (SM0426;
      // a const method changes nothing)
      if (self.FTree[LMember].Kind = NodeKind.MethodDecl) and
        not self.FTree[LMember].HasFlag(NodeFlag.ConstMethod) and
        not self.FTree[AId].HasFlag(NodeFlag.Arrow) and self.DoIsValueObject(LOperand) and
        self.DoIsConstObject(LOperand) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_426, ADAM_MSG_SEMANTICS_CONST_OBJECT_METHOD,
          NoArgs().Str(self.FTree[LMember].Text));
      end;
      if (self.FTree[self.DoSkipParens(LOperand)].Kind = NodeKind.ParentExpression) and
        (self.FTree[LMember].Kind = NodeKind.MethodDecl) and self.FTree[LMember].HasFlag(NodeFlag.Abstract) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_340, ADAM_MSG_SEMANTICS_ABSTRACT_CALL,
          NoArgs().Str(self.DoText(self.DoDeclaringType(LMember))).Str(self.FTree[LMember].Text));
      end;
    end;

    // True when the member access AId on the object type ABase names its init, copy or
    // done (SM0342 / SM0343: they run where an object is built, copied or ended, never
    // called; a lead call's `.init` never reaches here, DoLeadCall)
    hidden method DoLifetimeName(const AId: int64; const ABase: int64): bool;
    var
      LName: string;
    begin
      if self.DoClass(ABase) <> TypeClass.ObjectType then
        return false;
      end;
      LName := self.FTree[AId].Text;
      if LName = "init" then
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_342, ADAM_MSG_SEMANTICS_INIT_BY_NAME, NoArgs());
        return true;
      end;
      if LName = "copy" then
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_342, ADAM_MSG_SEMANTICS_COPY_BY_NAME, NoArgs());
        return true;
      end;
      if LName = "done" then
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_343, ADAM_MSG_SEMANTICS_DONE_BY_NAME, NoArgs());
        return true;
      end;
      return false;
    end;

    // SM0348 when the member access AId on AOperand names the virtual method AMember
    // through self in an init, a copy or a done: the object is not yet (or no longer) its
    // own type there, so the call would not dispatch (an embed's own methods do)
    hidden method DoLifetimeVirtual(const AId: int64; const AOperand: int64; const AMember: int64);
    var
      LRoutine: int64;
      LKind: NodeKind;
    begin
      if (self.FTree[AMember].Kind <> NodeKind.MethodDecl) or not self.DoIsVirtual(AMember) or
        (self.FTree[self.DoSkipParens(AOperand)].Kind <> NodeKind.SelfExpression) or
        (self.FTree[AId].ResolvedEmbed <> 0) then
        return;
      end;
      LRoutine := self.DoEnclosingRoutine(AId);
      if LRoutine = 0 then
        return;
      end;
      LKind := self.FTree[LRoutine].Kind;
      if (LKind = NodeKind.InitDecl) or (LKind = NodeKind.CopyDecl) or (LKind = NodeKind.DoneDecl) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_348, ADAM_MSG_SEMANTICS_VIRTUAL_IN_LIFETIME,
          NoArgs().Str(self.FTree[AMember].Text).Str(self.FTree[AMember].Text));
      end;
    end;

    // The member access AId on AOperand that names the property AProperty (pcpp O9 / O10):
    // an indexed one is reached through its index, as the operand of X.P[i] (SM0378
    // otherwise; DoPropertyIndex judges the index's own read); a plain one read through
    // self in its own read runs that read again, forever (SM0374). A target of an
    // assignment is its write's (DoWritten)
    hidden method DoPropertyMember(const AId: int64; const AOperand: int64; const AProperty: int64);
    var
      LParent: int64;
    begin
      if self.FTree.FirstOf(AProperty, NodeRole.Param) <> 0 then
        LParent := self.FTree.ParentOf(AId);
        if (LParent = 0) or (self.FTree[LParent].Kind <> NodeKind.IndexExpression) or
          (self.FTree.RoleOf(AId) <> NodeRole.Operand) then
          self.DoErrorName(AId, ADAM_ERR_SEMANTICS_378, ADAM_MSG_SEMANTICS_PROPERTY_NEEDS_INDEX,
            NoArgs().Str(self.FTree[AProperty].Text).Str(self.DoExprText(AId)));
        end;
        return;
      end;
      if self.DoIsAssignTarget(AId) then
        return;
      end;
      if self.DoInOwnAccessor(AId, AOperand, AId, self.FTree.FirstOf(AProperty, NodeRole.Read)) then
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_374, ADAM_MSG_SEMANTICS_PROPERTY_OWN_READ,
          NoArgs().Str(self.FTree[AProperty].Text));
      end;
    end;

    // The member the access AId on ABase reaches through its embeds (EmbedMemberOf, BNF
    // sec 4), the path written into the AST: its outermost embed into AId's ResolvedEmbed,
    // each embed past it an EmbedStep child of AId (its ResolvedDecl the embed, outermost
    // first). A hidden embed on the path is reached where a hidden field is (SM0019). 0 when
    // no embed holds the name; -1 (SM0370 reported) when two paths of one depth reach it
    hidden method DoEmbedMember(const AId: int64; const AOperand: int64; const ABase: int64): int64;
    var
      LMember: int64;
      LPath: NodeList;
      LSecond: NodeList;
      LStep: int64;
      LI: int64;
      LName: string;
      LFirst: string;
    begin
      LName := self.FTree[AId].Text;
      if not EmbedMemberOf(self.FTree, ABase, LName, LMember, LPath, LSecond) then
        return 0;
      end;
      if LSecond.Count <> 0 then
        LFirst := self.DoEmbedPathText(LPath);
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_370, ADAM_MSG_SEMANTICS_EMBED_SHARED,
          NoArgs().Str(LName).Str(LFirst).Str(self.DoEmbedPathText(LSecond)).Str(
          self.DoExprText(AOperand)).Str(LFirst).Str(LName));
        return -1;
      end;
      self.FTree[AId].ResolvedEmbed := LPath.Items[0];
      // A second visit of AId finds its steps written already
      if self.FTree.CountOf(AId, NodeRole.EmbedStep) = 0 then
        for LI := 1 to LPath.Count - 1 do
          LStep := self.FTree.AddChild(AId, NodeRole.EmbedStep, NodeKind.EmbedStep,
            self.FTree[AId].Place, self.FTree[AId].StartOffset, self.FTree[AId].EndOffset);
          self.FTree[LStep].ResolvedDecl := LPath.Items[LI];
        end;
      end;
      // The outermost embed is reached through the operand, each next one through the
      // embed before it
      if self.FTree[LPath.Items[0]].HasFlag(NodeFlag.Hidden) then
        self.DoHiddenReach(AId, AOperand, LPath.Items[0]);
      end;
      for LI := 1 to LPath.Count - 1 do
        if self.FTree[LPath.Items[LI]].HasFlag(NodeFlag.Hidden) then
          self.DoHiddenReachIn(AId, LPath.Items[LI], false, self.DoEmbedTypeOf(LPath.Items[LI - 1]));
        end;
      end;
      return LMember;
    end;

    // The embeds of an embed path (EmbedMemberOf), joined as source names them: "A.B"
    hidden const method DoEmbedPathText(const APath: NodeList): string;
    var
      LText: TextBuilder;
      LI: int64;
    begin
      for LI := 0 to APath.Count - 1 do
        if LI > 0 then
          LText.Add(".");
        end;
        LText.Add(self.FTree[APath.Items[LI]].Text);
      end;
      return LText.Text();
    end;

    // The canonical type the embed AEmbed holds (the record, overlay or object its members
    // are laid out in)
    hidden const method DoEmbedTypeOf(const AEmbed: int64): int64;
    begin
      return CanonicalOf(self.FTree, self.FTree.FirstOf(AEmbed, NodeRole.TypeOf));
    end;

    // The innermost embed the member access AId reaches its member through: its last
    // EmbedStep's, else its ResolvedEmbed (0: AId reaches its member directly)
    hidden const method DoInnermostEmbed(const AId: int64): int64;
    var
      LCount: int64;
    begin
      LCount := self.FTree.CountOf(AId, NodeRole.EmbedStep);
      if LCount > 0 then
        return self.FTree[self.FTree.NthOf(AId, NodeRole.EmbedStep, LCount - 1)].ResolvedDecl;
      end;
      return self.FTree[AId].ResolvedEmbed;
    end;

    // The declared type whose body declares the member AMember (an anonymous part's
    // member belongs to the type around it); 0 when none does
    hidden const method DoDeclaringType(const AMember: int64): int64;
    begin
      return DeclaringTypeOf(self.FTree, AMember);
    end;

    // The object type whose method (or init, done, accessor, operator) holds AId; 0 when
    // none does
    hidden const method DoMethodOwnerType(const AId: int64): int64;
    begin
      return MethodOwnerTypeOf(self.FTree, AId);
    end;

    // The hidden member (or accessor) AMember reached by AId on AOperand (BNF sec 4,
    // hidden): only from a method of its declaring type or of a descendant (SM0019,
    // outside), and there only through self, parent or a value of that method's own type
    // or a descendant of it (SM0019, through)
    hidden method DoHiddenReach(const AId: int64; const AOperand: int64; const AMember: int64);
    var
      LHeld: int64;
      LClass: TypeClass;
      LKind: NodeKind;
      LInner: int64;
    begin
      // A member reached through embeds is reached through the innermost one (X.M of an
      // embed's M is X.E.M, BNF sec 4); the embeds on the path are checked on their own
      // (DoEmbedMember)
      LInner := 0;
      if (self.FTree[AId].Kind = NodeKind.MemberExpression) and (self.FTree[AId].ResolvedDecl = AMember) then
        LInner := self.DoInnermostEmbed(AId);
      end;
      if LInner <> 0 then
        self.DoHiddenReachIn(AId, AMember, false, self.DoEmbedTypeOf(LInner));
        return;
      end;
      LKind := self.FTree[self.DoSkipParens(AOperand)].Kind;
      if (LKind = NodeKind.SelfExpression) or (LKind = NodeKind.ParentExpression) then
        self.DoHiddenReachIn(AId, AMember, true, 0);
        return;
      end;
      LHeld := self.DoTypeOf(AOperand);
      LClass := self.DoClass(LHeld);
      if IsPointerClass(LClass) or (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
        LHeld := TargetOf(self.FTree, LHeld);
      end;
      self.DoHiddenReachIn(AId, AMember, false, LHeld);
    end;

    // DoHiddenReach's rule for the hidden member AMember reached by AId: from a method of
    // its declaring type or of a descendant (SM0019 outside), and there through self or
    // parent (AThroughSelf) or a value of the type AHeld that is that method's own type or
    // a descendant of it (SM0019 through)
    hidden method DoHiddenReachIn(const AId: int64; const AMember: int64; const AThroughSelf: bool;
      const AHeld: int64);
    var
      LLevel: int64;
      LOwner: int64;
      LName: string;
      LReach: HiddenReach;
    begin
      LName := self.FTree[AMember].Text;
      if self.FTree[AMember].Kind = NodeKind.PropertyWrite then
        LName := self.FTree[self.FTree.ParentOf(AMember)].Text;
      end;
      LLevel := self.DoDeclaringType(AMember);
      LOwner := self.DoMethodOwnerType(AId);
      LReach := HiddenReachOf(self.FTree, AMember, AId, AThroughSelf, AHeld);
      if LReach = HiddenReach.Reached then
        return;
      end;
      if LReach = HiddenReach.Outside then
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_019, ADAM_MSG_SEMANTICS_HIDDEN_OUTSIDE,
          NoArgs().Str(LName).Str(self.DoText(LLevel)).Str(self.DoText(LLevel)));
        return;
      end;
      self.DoErrorName(AId, ADAM_ERR_SEMANTICS_019, ADAM_MSG_SEMANTICS_HIDDEN_THROUGH,
        NoArgs().Str(LName).Str(self.DoText(LLevel)).Str(self.DoText(LOwner)).Str(self.DoText(LOwner)));
    end;

    // Every argument of the call AId visited; a type expression there (the parser's type
    // argument after `.next(` / `.get(I,`, BNF sec 6 type arg) is a value only a varargs
    // read takes (DoPackCall), so here it is SM0269
    hidden method DoVisitArguments(const AId: int64);
    var
      LArgument: int64;
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        LArgument := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        self.DoVisit(LArgument);
        if DoIsTypeExpression(self.FTree[LArgument].Kind) then
          self.DoError(LArgument, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_TYPE_NOT_VALUE,
            NoArgs().Str(self.DoText(CanonicalOf(self.FTree, LArgument))));
        end;
      end;
    end;

    // True when a var parameter of type AParam takes an argument of AArgument: the same
    // type, or a descendant of the record, object or interface AParam (BNF sec 6,
    // PLAN-RECORDS R4; a parameter binds by reference, so nothing is cut down)
    hidden const method DoVarTakes(const AArgument: int64; const AParam: int64): bool;
    var
      LClass: TypeClass;
    begin
      if (AArgument = 0) or (AParam = 0) or (AArgument = AParam) then
        return true;
      end;
      LClass := self.DoClass(AParam);
      if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.ObjectType) and
        (LClass <> TypeClass.InterfaceType) then
        return false;
      end;
      return ReachesAs(self.FTree, AArgument, AParam);
    end;

    // SM0427 (BNF sec 4 owner type and O5, sec 6): a value AExpr given by value (:=, an
    // initializer, a value argument, a construction's field, a result) that cannot be
    // copied moves, never copies: an own, or an object whose type cannot be copied (a done
    // and no copy somewhere in it: DoCopyBlocker, a hint at the reason). It may be a
    // call's result, a construction or nil, or (AReturn) `return X;` of a local variable
    // or a value parameter of the routine; any other place would be copied (reported).
    // True when AExpr moves or copies
    hidden method DoOwnMoves(const AExpr: int64; const AReturn: bool): bool;
    var
      LType: int64;
      LRoot: int64;
      LKind: NodeKind;
      LDecl: int64;
      LRoutine: int64;
      LBlocker: int64;
      LHolder: int64;
      LPart: int64;
    begin
      LType := self.DoTypeOf(AExpr);
      if LType = 0 then
        return true;
      end;
      // A polymorphic object copied by value from where it may be a descendant: the copy
      // would keep only that part (SM0428, BNF sec 4 O5)
      if self.DoMaySlice(LType) and self.DoMayBeDescendant(AExpr) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_428, ADAM_MSG_SEMANTICS_SLICE_COPY,
          NoArgs().Str(self.DoExprText(AExpr)).Str(self.DoText(LType)).Str(self.DoText(LType)));
        return false;
      end;
      LBlocker := 0;
      LHolder := 0;
      LPart := 0;
      if self.DoClass(LType) <> TypeClass.OwnType then
        LBlocker := self.DoCopyBlocker(LType, LHolder, LPart);
        if LBlocker = 0 then
          return true;
        end;
      end;
      LRoot := self.DoSkipParens(AExpr);
      if LRoot = 0 then
        return true;
      end;
      LKind := self.FTree[LRoot].Kind;
      // a call's result (a declared operator's too) is a new value: it moves, never copies
      if (LKind = NodeKind.CallExpression) or (LKind = NodeKind.OwnNew) or
        (LKind = NodeKind.NilLiteral) or (self.FTree[LRoot].ResolvedConst.Kind = ConstKind.Nil) or
        (OperatorCallOf(self.FTree, LRoot) <> 0) then
        return true;
      end;
      if AReturn then
        LDecl := self.FTree[LRoot].ResolvedDecl;
        LRoutine := self.DoEnclosingBody(LRoot);
        if (LDecl <> 0) and (LRoutine <> 0) and (self.DoEnclosingBody(LDecl) = LRoutine) then
          if self.FTree[LDecl].Kind = NodeKind.VarDecl then
            return true;
          end;
          if (self.FTree[LDecl].Kind = NodeKind.Param) and
            (not self.FTree[LDecl].HasFlag(NodeFlag.ConstParam)) and
            (not self.FTree[LDecl].HasFlag(NodeFlag.VarParam)) then
            return true;
          end;
        end;
      end;
      if LBlocker = 0 then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_427, ADAM_MSG_SEMANTICS_OWN_COPY,
          NoArgs().Str(self.DoExprText(AExpr)).Str(self.DoText(LType)));
        return false;
      end;
      self.DoError(AExpr, ADAM_ERR_SEMANTICS_427, ADAM_MSG_SEMANTICS_VALUE_COPY,
        NoArgs().Str(self.DoExprText(AExpr)).Str(self.DoText(LType)));
      self.DoCopyHint(LBlocker, LHolder, LPart);
      return false;
    end;

    // The node that keeps a value of the canonical type AType from being copied (BNF sec
    // 4 O5), 0 when it copies: an object type that declares a copy copies (its parent
    // must: SM0355); one that declares a done and no copy cannot (the done; AHolder that
    // type, APart 0); else its parent part or a field or an embed that cannot (the body's
    // parent node or the member; AHolder the level holding it, APart the part's type); a
    // static or a dynamic array as its element (a dynamic array's copy shares its block
    // until a write copies the elements); any other type copies
    hidden method DoCopyBlocker(const AType: int64; var AHolder: int64; var APart: int64): int64;
    var
      LBody: int64;
      LDone: int64;
      LParent: int64;
      LMember: int64;
      LKind: NodeKind;
      LPart: int64;
      LInnerHolder: int64;
      LInnerPart: int64;
      LI: int64;
    begin
      AHolder := 0;
      APart := 0;
      if AType = 0 then
        return 0;
      end;
      if (self.DoClass(AType) = TypeClass.StaticArray) or (self.DoClass(AType) = TypeClass.DynamicArray) then
        return self.DoCopyBlocker(TargetOf(self.FTree, AType), AHolder, APart);
      end;
      if self.DoClass(AType) <> TypeClass.ObjectType then
        return 0;
      end;
      LBody := BodyOf(self.FTree, AType);
      if (LBody = 0) or (self.DoBodyMember(LBody, NodeKind.CopyDecl) <> 0) then
        return 0;
      end;
      LDone := self.DoBodyMember(LBody, NodeKind.DoneDecl);
      if LDone <> 0 then
        AHolder := AType;
        return LDone;
      end;
      LParent := ParentTypeOf(self.FTree, AType);
      if (LParent <> 0) and (self.DoCopyBlocker(LParent, LInnerHolder, LInnerPart) <> 0) then
        AHolder := AType;
        APart := LParent;
        return self.FTree.FirstOf(LBody, NodeRole.Parent);
      end;
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        LKind := self.FTree[LMember].Kind;
        LPart := 0;
        if LKind = NodeKind.FieldDecl then
          LPart := self.DoDeclType(LMember);
        end;
        if LKind = NodeKind.EmbedDecl then
          LPart := CanonicalOf(self.FTree, self.FTree.FirstOf(LMember, NodeRole.TypeOf));
        end;
        if (LPart <> 0) and (self.DoCopyBlocker(LPart, LInnerHolder, LInnerPart) <> 0) then
          AHolder := AType;
          APart := LPart;
          return LMember;
        end;
      end;
      return 0;
    end;

    // The first member of kind AKind the object body ABody declares; 0 for none
    hidden const method DoBodyMember(const ABody: int64; const AKind: NodeKind): int64;
    var
      LMember: int64;
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        if self.FTree[LMember].Kind = AKind then
          return LMember;
        end;
      end;
      return 0;
    end;

    // SM0427's hint at ABlocker, the reason a value cannot be copied (DoCopyBlocker): the
    // done of AHolder, which declares no copy, or the part of type APart AHolder holds
    hidden method DoCopyHint(const ABlocker: int64; const AHolder: int64; const APart: int64);
    begin
      if APart = 0 then
        self.FDiagnostics.Add(Severity.Hint, ADAM_ERR_SEMANTICS_427, self.FTree[ABlocker].Place,
          ADAM_MSG_SEMANTICS_COPY_DONE, NoArgs().Str(self.DoText(AHolder)));
        return;
      end;
      self.FDiagnostics.Add(Severity.Hint, ADAM_ERR_SEMANTICS_427, self.FTree[ABlocker].Place,
        ADAM_MSG_SEMANTICS_COPY_PART, NoArgs().Str(self.DoText(AHolder)).Str(self.DoText(APart)));
    end;

    // The copy decl ACopy of the object type AType (BNF sec 4 O5), after AEarlier copies
    // of the same type: one per type (SM0354); it takes exactly one const parameter of
    // the type itself (SM0353); the parent must be copyable (SM0355, the hint at its
    // reason: DoCopyHint)
    hidden method DoCopyRules(const AType: int64; const ACopy: int64; const AEarlier: int64);
    var
      LAt: int64;
      LParam: int64;
      LFits: bool;
      LParent: int64;
      LBlocker: int64;
      LHolder: int64;
      LPart: int64;
    begin
      if AEarlier > 0 then
        self.DoError(ACopy, ADAM_ERR_SEMANTICS_354, ADAM_MSG_SEMANTICS_COPY_TWICE,
          NoArgs().Str(self.DoText(AType)));
        self.FTree[ACopy].AddFlag(NodeFlag.Repeated);
      end;
      LFits := self.FTree.CountOf(ACopy, NodeRole.Param) = 1;
      if LFits then
        LParam := self.FTree.NthOf(ACopy, NodeRole.Param, 0);
        LFits := self.FTree[LParam].HasFlag(NodeFlag.ConstParam) and
          (not self.FTree[LParam].HasFlag(NodeFlag.VarParam)) and (self.DoDeclType(LParam) = AType);
      end;
      // one parameter of the wrong shape: at it (pcpp's place); another count: at the copy
      if not LFits then
        LAt := ACopy;
        if self.FTree.CountOf(ACopy, NodeRole.Param) = 1 then
          LAt := self.FTree.NthOf(ACopy, NodeRole.Param, 0);
        end;
        self.DoError(LAt, ADAM_ERR_SEMANTICS_353, ADAM_MSG_SEMANTICS_COPY_PARAM,
          NoArgs().Str(self.DoText(AType)));
      end;
      LParent := ParentTypeOf(self.FTree, AType);
      if LParent = 0 then
        return;
      end;
      LBlocker := self.DoCopyBlocker(LParent, LHolder, LPart);
      if LBlocker <> 0 then
        self.DoError(ACopy, ADAM_ERR_SEMANTICS_355, ADAM_MSG_SEMANTICS_COPY_PARENT,
          NoArgs().Str(self.DoText(LParent)).Str(self.DoText(AType)));
        self.DoCopyHint(LBlocker, LHolder, LPart);
      end;
    end;

    // The argument AArgument for the value or const parameter AParam of type AParamType:
    // a const parameter of a record, object or interface type binds by reference, so a
    // descendant (an implementer) passes as it is (its ResolvedConvert names the view);
    // anything else converts to the parameter's type (a call's argument number AArgIndex of
    // ACallee reported as SM0404 when it does not; -1 for an operator's or an init's, which
    // their pick already took)
    hidden method DoConstOrValue(const AArgument: int64; const AParam: int64; const AParamType: int64;
      const AArgIndex: int64; const ACallee: string);
    var
      LFrom: int64;
    begin
      LFrom := self.DoTypeOf(AArgument);
      if self.FTree[AParam].HasFlag(NodeFlag.ConstParam) and (LFrom <> 0) and (LFrom <> AParamType) and
        (not self.DoIsNoValue(AArgument)) and self.DoVarTakes(LFrom, AParamType) then
        self.FTree[AArgument].ResolvedConvert := AParamType;
        return;
      end;
      // a string borrowed as a C string (F3): its own text for the call, no copy
      if self.DoTextArgTakes(AArgument, AParamType) then
        self.FTree[AArgument].ResolvedConvert := AParamType;
        return;
      end;
      // a static array borrowed as a const array of T's view (AS2): no conversion, no copy
      if self.DoArrayViewTakes(AArgument, AParam, AParamType) then
        return;
      end;
      // a value parameter takes its own copy: an own moves into it (a const one binds)
      if not self.FTree[AParam].HasFlag(NodeFlag.ConstParam) then
        self.DoOwnMoves(AArgument, false);
      end;
      self.DoConvertArg(AArgument, AParamType, AArgIndex, ACallee);
    end;

    // True when the argument AArgument fits the parameter AParam (no report): a var
    // parameter's variable of its type or a descendant, else a value that converts
    hidden method DoArgumentFits(const AArgument: int64; const AParam: int64): bool;
    var
      LParamType: int64;
      LFrom: int64;
    begin
      LParamType := self.DoDeclType(AParam);
      LFrom := self.DoTypeOf(AArgument);
      if self.DoIsGenericValue(self.DoSkipParens(AArgument)) then
        // a generic named as a value is no variable; it fits a routine type that fixes it
        return (not self.FTree[AParam].HasFlag(NodeFlag.VarParam)) and
          self.DoGenericValueFits(self.DoSkipParens(AArgument), LParamType);
      end;
      if self.FTree[AParam].HasFlag(NodeFlag.VarParam) then
        return self.DoIsAssignable(AArgument) and self.DoVarTakes(LFrom, LParamType);
      end;
      if self.DoIsNoValue(AArgument) then
        return false;
      end;
      if self.FTree[AParam].HasFlag(NodeFlag.ConstParam) and self.DoVarTakes(LFrom, LParamType) then
        return true;
      end;
      if self.DoTextArgTakes(AArgument, LParamType) then
        return true;
      end;
      if self.DoArrayViewTakes(AArgument, AParam, LParamType) then
        return true;
      end;
      return self.DoWouldConvert(AArgument, LParamType);
    end;

    // True when the init AInit takes the arguments of AHolder playing ARole (its count,
    // each one fitting its parameter)
    hidden method DoInitTakes(const AInit: int64; const AHolder: int64; const ARole: NodeRole): bool;
    var
      LParams: int64;
      LGiven: int64;
      LI: int64;
    begin
      LParams := self.FTree.CountOf(AInit, NodeRole.Param);
      LGiven := self.FTree.CountOf(AHolder, ARole);
      if LGiven <> LParams then
        return false;
      end;
      for LI := 0 to LGiven - 1 do
        if not self.DoArgumentFits(self.FTree.NthOf(AHolder, ARole, LI),
          self.FTree.NthOf(AInit, NodeRole.Param, LI)) then
          return false;
        end;
      end;
      return true;
    end;

    // The types of the arguments of AHolder playing ARole as a message lists them
    hidden const method DoArgumentTypesText(const AHolder: int64; const ARole: NodeRole): string;
    var
      LText: string;
      LI: int64;
    begin
      LText := "";
      for LI := 0 to self.FTree.CountOf(AHolder, ARole) - 1 do
        if LI > 0 then
          LText := LText + ", ";
        end;
        LText := LText + self.DoText(self.DoTypeOf(self.FTree.NthOf(AHolder, ARole, LI)));
      end;
      return LText;
    end;

    // The object AType is built at AHolder (own / ref T(...), LV: T(...), LV: T) with the
    // arguments AHolder holds in ARole (BNF sec 4 init): an abstract object or an
    // interface is never built (SM0338); with no init declared it takes no arguments
    // (SM0351); else exactly one of its inits takes them (none: SM0351, or SM0349 when
    // none was given; several: SM0352). The init picked goes into AHolder's
    // ResolvedCallee, each argument converting to its parameter. AAt is where a report
    // goes. A part built by a lead call (APart: the parent part, DoLeadCall) is built
    // inside its holder, so an abstract parent is built as well
    hidden method DoBuild(const AHolder: int64; const ARole: NodeRole; const AType: int64;
      const AAt: int64; const APart: bool);
    var
      LBody: int64;
      LI: int64;
      LMember: int64;
      LPicked: int64;
      LCount: int64;
      LInits: int64;
      LParam: int64;
      LArgument: int64;
      LTypeText: string;
    begin
      if (not APart) and (not self.DoValueHolds(AType, AAt)) then
        return;
      end;
      LBody := BodyOf(self.FTree, AType);
      LTypeText := self.DoText(AType);
      LPicked := 0;
      LCount := 0;
      LInits := 0;
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if self.FTree[LMember].Kind = NodeKind.InitDecl then
          LInits := LInits + 1;
          if self.DoInitTakes(LMember, AHolder, ARole) then
            LCount := LCount + 1;
            if LPicked = 0 then
              LPicked := LMember;
            end;
          end;
        end;
      end;
      if LInits = 0 then
        if self.FTree.CountOf(AHolder, ARole) > 0 then
          self.DoErrorAt(self.DoInitArgsPlace(AHolder, AAt), ADAM_ERR_SEMANTICS_351, ADAM_MSG_SEMANTICS_NO_INIT_DECLARED,
            NoArgs().Str(LTypeText));
        end;
        return;
      end;
      if LCount = 0 then
        if self.FTree.CountOf(AHolder, ARole) = 0 then
          self.DoError(AAt, ADAM_ERR_SEMANTICS_349, ADAM_MSG_SEMANTICS_NO_DEFAULT_INIT,
            NoArgs().Str(LTypeText).Str(LTypeText));
        else
          self.DoErrorAt(self.DoInitArgsPlace(AHolder, AAt), ADAM_ERR_SEMANTICS_351, ADAM_MSG_SEMANTICS_NO_INIT_TAKES,
            NoArgs().Str(LTypeText).Str(self.DoArgumentTypesText(AHolder, ARole)));
        end;
        return;
      end;
      if LCount > 1 then
        self.DoErrorAt(self.DoInitArgsPlace(AHolder, AAt), ADAM_ERR_SEMANTICS_352, ADAM_MSG_SEMANTICS_INIT_AMBIGUOUS,
          NoArgs().Str(self.DoArgumentTypesText(AHolder, ARole)).Str(LTypeText));
        return;
      end;
      self.FTree[AHolder].ResolvedCallee := LPicked;
      for LI := 0 to self.FTree.CountOf(AHolder, ARole) - 1 do
        LParam := self.FTree.NthOf(LPicked, NodeRole.Param, LI);
        LArgument := self.FTree.NthOf(AHolder, ARole, LI);
        if self.FTree[LParam].HasFlag(NodeFlag.VarParam) then
          // DoInitTakes took it as a variable: it binds by address as a routine's var
          // argument does (SM0262, SM0270), and the init writes it
          if not self.DoBitfieldAddress(LArgument) then
            self.DoMisalignedVar(LArgument, self.DoParamName(LPicked, LI), self.DoDeclType(LParam));
          end;
          self.DoIteratorWritten(LArgument);
        else
          self.DoConstOrValue(LArgument, LParam, self.DoDeclType(LParam), -1, "");
        end;
      end;
    end;

    // True when the canonical type AType holds no ref object by value (SM0758 at AAt
    // otherwise, BNF sec 4, F2a0): a ref object itself, or an array's, a task's or a
    // sequence's element that is one (each holds its elements in itself)
    hidden method DoRefOnlyHeld(const AType: int64; const AAt: int64): bool;
    var
      LClass: TypeClass;
    begin
      if AType = 0 then
        return true;
      end;
      LClass := self.DoClass(AType);
      if (LClass = TypeClass.ObjectType) and IsRefOnly(self.FTree, AType) then
        self.DoError(AAt, ADAM_ERR_SEMANTICS_758, ADAM_MSG_SEMANTICS_REF_OBJECT_VALUE,
          NoArgs().Str(self.DoText(AType)).Str(self.DoText(AType)));
        return false;
      end;
      if (LClass = TypeClass.StaticArray) or (LClass = TypeClass.DynamicArray) or
        (LClass = TypeClass.FlexibleArray) or (LClass = TypeClass.TaskType) or
        (LClass = TypeClass.SequenceType) then
        return self.DoRefOnlyHeld(TargetOf(self.FTree, AType), AAt);
      end;
      return true;
    end;

    // AAt when it is a node (a declaration's written type), else ADecl (an inferred one's
    // declaration): where a report about the declaration's type goes
    hidden const method DoAtOrSelf(const AAt: int64; const ADecl: int64): int64;
    begin
      if AAt <> 0 then
        return AAt;
      end;
      return ADecl;
    end;

    // The result type of the routine, method or operator AId holding no ref object by
    // value (DoRefOnlyHeld: SM0758 at the result type)
    hidden method DoRefOnlyResult(const AId: int64);
    var
      LResult: int64;
    begin
      LResult := self.FTree.FirstOf(AId, NodeRole.ReturnType);
      if LResult <> 0 then
        self.DoRefOnlyHeld(CanonicalOf(self.FTree, LResult), LResult);
      end;
    end;

    // True when a value of AType may be held or built (SM0338 at AAt otherwise): an
    // interface never is, nor an object with an abstract member no level gave a body
    hidden method DoValueHolds(const AType: int64; const AAt: int64): bool;
    var
      LAbstract: int64;
      LOwner: int64;
    begin
      if self.DoClass(AType) = TypeClass.InterfaceType then
        self.DoError(AAt, ADAM_ERR_SEMANTICS_338, ADAM_MSG_SEMANTICS_INTERFACE_VALUE,
          NoArgs().Str(self.DoText(AType)));
        return false;
      end;
      if self.DoClass(AType) <> TypeClass.ObjectType then
        return true;
      end;
      LAbstract := AbstractMemberOf(self.FTree, AType);
      if LAbstract = 0 then
        return true;
      end;
      LOwner := self.FTree.ParentOf(self.FTree.ParentOf(LAbstract));
      self.DoError(AAt, ADAM_ERR_SEMANTICS_338, ADAM_MSG_SEMANTICS_ABSTRACT_VALUE,
        NoArgs().Str(self.DoText(AType)).Str(self.FTree[LOwner].Text).Str(self.FTree[LAbstract].Text));
      return false;
    end;

    // The written signature that names the parameters of a call through the routine value
    // ACallee: the routine type expression its declaration (a variable, constant, parameter,
    // field or property) was written with, directly or through type declarations naming
    // one; 0 when there is none (a value no declaration holds, such as a call's result).
    // A routine type owns no parameter name (Adam.Compiler.Types' DoOwnSignature)
    hidden method DoNamingSignature(const ACallee: int64): int64;
    var
      LDecl: int64;
      LKind: NodeKind;
      LExpr: int64;
      LDepth: int64;
    begin
      LDecl := self.DoCalleeDecl(ACallee);
      if LDecl = 0 then
        return 0;
      end;
      LKind := self.FTree[LDecl].Kind;
      if (LKind <> NodeKind.VarDecl) and (LKind <> NodeKind.ConstDecl) and
        (LKind <> NodeKind.Param) and (LKind <> NodeKind.FieldDecl) and
        (LKind <> NodeKind.PropertyDecl) then
        return 0;
      end;
      LExpr := self.FTree.FirstOf(LDecl, NodeRole.TypeOf);
      LDepth := 0;
      // An alias chain followed to the routine type it names (a cycle stops at the depth)
      while (LExpr <> 0) and (self.FTree[LExpr].Kind = NodeKind.NamedType) and
        (LDepth < ADAM_TYPES_MAX_DEPTH) do
        LDecl := self.FTree[LExpr].ResolvedDecl;
        if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.TypeDecl) then
          return 0;
        end;
        LExpr := self.FTree.FirstOf(LDecl, NodeRole.TypeOf);
        LDepth := LDepth + 1;
      end;
      if (LExpr <> 0) and ((self.FTree[LExpr].Kind = NodeKind.RoutineType) or
        (self.FTree[LExpr].Kind = NodeKind.ClosureType)) then
        return LExpr;
      end;
      return 0;
    end;

    // The name a message gives the parameter number AIndex (from 0) of a call: its name in
    // the written signature ANames, else its position (#1 the first)
    hidden const method DoParamName(const ANames: int64; const AIndex: int64): string;
    begin
      if (ANames <> 0) and (AIndex < self.FTree.CountOf(ANames, NodeRole.Param)) then
        return self.FTree[self.FTree.NthOf(ANames, NodeRole.Param, AIndex)].Text;
      end;
      return "#" + IntToStr(AIndex + 1);
    end;

    // The arguments of the call AId against the parameters of the signature ASig (a
    // routine, a method, a routine type) called as AName: their count (SM0401; at least
    // the fixed ones before a '...'), a var parameter's variable (SM0405, the parameter
    // named by ANames: DoParamName), every other argument converting to its parameter's type
    hidden method DoArguments(const AId: int64; const ASig: int64; const ANames: int64;
      const AName: string);
    var
      LParams: int64;
      LGiven: int64;
      LI: int64;
      LParam: int64;
      LArgument: int64;
      LParamType: int64;
    begin
      self.DoVisitArguments(AId);
      LParams := self.FTree.CountOf(ASig, NodeRole.Param);
      LGiven := self.FTree.CountOf(AId, NodeRole.Argument);
      if self.FTree[ASig].HasFlag(NodeFlag.Variadic) then
        if LGiven < LParams then
          self.DoError(AId, ADAM_ERR_SEMANTICS_401, ADAM_MSG_SEMANTICS_ARG_COUNT_VARIADIC,
            NoArgs().Str(AName).Int(LParams).Int(LGiven));
          return;
        end;
      else
        if LGiven <> LParams then
          self.DoError(AId, ADAM_ERR_SEMANTICS_401, ADAM_MSG_SEMANTICS_ARG_COUNT,
            NoArgs().Str(AName).Int(LParams).Int(LGiven));
          return;
        end;
      end;
      for LI := 0 to LGiven - 1 do
        LArgument := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        if LI >= LParams then
          // A variadic argument travels with its own type; a C variadic's as C reads it
          // (CV1: a string its C text)
          if self.DoIsNoValue(LArgument) then
            self.DoNoValue(LArgument);
          else
            if not IsCppSignature(self.FTree, ASig) then
              self.DoCVariadicArg(LArgument);
            end;
          end;
        else
          LParam := self.FTree.NthOf(ASig, NodeRole.Param, LI);
          LParamType := self.DoDeclType(LParam);
          if self.FTree[LParam].HasFlag(NodeFlag.VarParam) then
            // A var parameter binds to its argument's address: a bitfield has none (SM0262),
            // a place a packed record may misalign none it may bind (SM0270)
            if not self.DoBitfieldAddress(LArgument) then
              // a property is no variable: its write runs, never a store through an address
              if (not self.DoIsAssignable(LArgument)) or (self.DoPropertyOf(LArgument) <> 0) or
                (not self.DoVarTakes(self.DoTypeOf(LArgument), LParamType)) then
                self.DoError(LArgument, ADAM_ERR_SEMANTICS_405, ADAM_MSG_SEMANTICS_VAR_PARAM,
                  NoArgs().Str(self.DoParamName(ANames, LI)).Str(self.DoText(LParamType)));
              else
                self.DoMisalignedVar(LArgument, self.DoParamName(ANames, LI), LParamType);
              end;
            end;
            // A var argument is written by the call
            self.DoIteratorWritten(LArgument);
          else
            self.DoConstOrValue(LArgument, LParam, LParamType, LI, AName);
          end;
        end;
      end;
    end;

    // A const method calls through self (self.M(), self.F.M() of a field held by value)
    // only methods that are const themselves (SM0388), as does a property's read, whose
    // self is const too (SM0373): the callee ACallee of the method ASig
    hidden method DoConstMethodCall(const ACallee: int64; const ASig: int64);
    var
      LMethod: int64;
    begin
      if (self.FTree[ASig].Kind <> NodeKind.MethodDecl) or self.FTree[ASig].HasFlag(NodeFlag.ConstMethod) or
        self.FTree[ASig].HasFlag(NodeFlag.Static) or (self.FTree[ACallee].Kind <> NodeKind.MemberExpression) then
        return;
      end;
      LMethod := self.DoEnclosingRoutine(ACallee);
      if LMethod = 0 then
        return;
      end;
      if not self.DoThroughSelf(self.FTree.FirstOf(ACallee, NodeRole.Operand)) then
        return;
      end;
      if (self.FTree[LMethod].Kind = NodeKind.MethodDecl) and self.FTree[LMethod].HasFlag(NodeFlag.ConstMethod) then
        self.DoError(ACallee, ADAM_ERR_SEMANTICS_388, ADAM_MSG_SEMANTICS_CONST_METHOD_CALL,
          NoArgs().Str(self.FTree[LMethod].Text).Str(self.DoExprText(ACallee)));
        return;
      end;
      if self.FTree[LMethod].Kind = NodeKind.PropertyRead then
        self.DoError(ACallee, ADAM_ERR_SEMANTICS_373, ADAM_MSG_SEMANTICS_PROPERTY_READ_CALL,
          NoArgs().Str(self.FTree[self.FTree.ParentOf(LMethod)].Text).Str(self.DoExprText(ACallee)));
      end;
    end;

    // The parameter AIndex of ASig (0 past its last: a '...' takes the argument)
    hidden const method DoParamAt(const ASig: int64; const AIndex: int64): int64;
    begin
      if AIndex < self.FTree.CountOf(ASig, NodeRole.Param) then
        return self.FTree.NthOf(ASig, NodeRole.Param, AIndex);
      end;
      return 0;
    end;

    // True when a value of AFrom reaches ATo by a C++ promotion: an integer below 32
    // bits, a bool, a char or a wchar to int32; float32 to float64
    hidden const method DoIsPromotion(const AFrom: int64; const ATo: int64): bool;
    var
      LClass: TypeClass;
    begin
      LClass := self.DoClass(AFrom);
      if ATo = self.DoBuiltin("int32") then
        if IsIntegerClass(LClass) then
          return IntBits(self.FTree, AFrom) < 32;
        end;
        return (LClass = TypeClass.Boolean) or (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar);
      end;
      return (ATo = self.DoBuiltin("float64")) and (AFrom = self.DoBuiltin("float32"));
    end;

    // How the argument AArgument fits the parameter AParam, by C++'s ranks: 0 exact (the
    // same type), 1 a promotion, 2 a conversion (a descendant for a var parameter, a
    // constant that fits, a literal's type-driven form), 3 taken by a '...' (AParam 0)
    hidden method DoArgumentRank(const AArgument: int64; const AParam: int64): int64;
    var
      LFrom: int64;
      LTo: int64;
    begin
      if AParam = 0 then
        return 3;
      end;
      LFrom := self.DoTypeOf(AArgument);
      LTo := self.DoDeclType(AParam);
      if (LFrom = LTo) or self.DoIsGenericValue(self.DoSkipParens(AArgument)) then
        // a generic value's instance is made with the parameter's own types: exact
        return 0;
      end;
      if (not self.FTree[AParam].HasFlag(NodeFlag.VarParam)) and self.DoIsPromotion(LFrom, LTo) then
        return 1;
      end;
      return 2;
    end;

    // True when the routine ACandidate takes the call AId's arguments: their count (at
    // least its fixed parameters before a '...'), each fitting its parameter (DoBuild's
    // test, DoArgumentFits)
    hidden method DoOverloadTakes(const AId: int64; const ACandidate: int64): bool;
    var
      LParams: int64;
      LGiven: int64;
      LI: int64;
    begin
      LParams := self.FTree.CountOf(ACandidate, NodeRole.Param);
      LGiven := self.FTree.CountOf(AId, NodeRole.Argument);
      if self.FTree[ACandidate].HasFlag(NodeFlag.Variadic) then
        if LGiven < LParams then
          return false;
        end;
      else
        if LGiven <> LParams then
          return false;
        end;
      end;
      for LI := 0 to LGiven - 1 do
        if (LI < LParams) and
          (not self.DoArgumentFits(self.FTree.NthOf(AId, NodeRole.Argument, LI), self.FTree.NthOf(ACandidate, NodeRole.Param, LI))) then
          return false;
        end;
      end;
      return true;
    end;

    // True when ACandidate fits the call AId better than AOther (C++'s rule): no argument
    // ranks worse, one ranks better
    hidden method DoBetterOverload(const AId: int64; const ACandidate: int64; const AOther: int64): bool;
    var
      LI: int64;
      LArgument: int64;
      LMine: int64;
      LTheirs: int64;
      LBetter: bool;
    begin
      LBetter := false;
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        LArgument := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        LMine := self.DoArgumentRank(LArgument, self.DoParamAt(ACandidate, LI));
        LTheirs := self.DoArgumentRank(LArgument, self.DoParamAt(AOther, LI));
        if LMine > LTheirs then
          return false;
        end;
        if LMine < LTheirs then
          LBetter := true;
        end;
      end;
      return LBetter;
    end;

    // True when the routine or method ACandidate may be picked by the use AUse: a
    // module-level one that is not public is its own module's alone (IsModulePrivate, BNF
    // decision row 20), so a use in another module never meets it, an overload set it shares
    // with public namesakes included (a use in an instance's clone is in the generic's module)
    hidden const method DoIsSeenBy(const ACandidate: int64; const AUse: int64): bool;
    begin
      if not IsModulePrivate(self.FTree, ACandidate) then
        return true;
      end;
      return ModuleOf(self.FTree, ACandidate) = ModuleOf(self.FTree, AUse);
    end;

    // True when the routine ACandidate is a member of the overload set named AName in its
    // scope (a generic member takes a call through its instances: DoGenericCallee)
    hidden const method DoIsOverloadMember(const ACandidate: int64; const AName: string): bool;
    begin
      return (self.FTree[ACandidate].Kind = NodeKind.RoutineDecl) and
        (self.FTree[ACandidate].Text = AName) and
        (self.FTree.FirstOf(ACandidate, NodeRole.GenericParam) = 0);
    end;

    // The one of the routines or methods ACandidates (an overload set's members, or the
    // instances of generic overloads, BNF sec 3 / 10) the call AId runs: only those that
    // take the arguments by Adam's conversions (none: SM0402), the one better than every
    // other by C++'s ranks (none: SM0403, Adam's own). 0 after a report
    hidden method DoPickFrom(const AId: int64; const ACallee: int64; const ACandidates: ref NodeList): int64;
    var
      LI: int64;
      LJ: int64;
      LFits: ref NodeList;
      LBest: bool;
    begin
      LFits := ref NodeList();
      for LI := 0 to ACandidates.Count - 1 do
        if self.DoOverloadTakes(AId, ACandidates.Items[LI]) then
          LFits.Add(ACandidates.Items[LI]);
        end;
      end;
      if LFits.Count = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_402, ADAM_MSG_SEMANTICS_OVERLOAD_NONE,
          NoArgs().Str(self.DoExprText(ACallee)).Str(self.DoArgumentTypesText(AId, NodeRole.Argument)));
        return 0;
      end;
      for LI := 0 to LFits.Count - 1 do
        LBest := true;
        for LJ := 0 to LFits.Count - 1 do
          if (LJ <> LI) and not self.DoBetterOverload(AId, LFits.Items[LI], LFits.Items[LJ]) and
            not self.DoPlainWinsTie(AId, LFits.Items[LI], LFits.Items[LJ]) then
            LBest := false;
            leave;
          end;
        end;
        if LBest then
          return LFits.Items[LI];
        end;
      end;
      self.DoError(AId, ADAM_ERR_SEMANTICS_403, ADAM_MSG_SEMANTICS_OVERLOAD_AMBIGUOUS,
        NoArgs().Str(self.DoArgumentTypesText(AId, NodeRole.Argument)).Str(self.DoExprText(ACallee)));
      return 0;
    end;

    // True when the routine or method AChild of a scope is one of the overloads of AName
    // (a plain one or a generic)
    hidden const method DoIsNamedRoutine(const AChild: int64; const AName: string): bool;
    var
      LKind: NodeKind;
    begin
      LKind := self.FTree[AChild].Kind;
      return ((LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.MethodDecl)) and
        (self.FTree[AChild].Text = AName);
    end;

    // True when the plain routine ACandidate takes the call AId as well as the generic
    // instance AOther (neither ranks better): the plain one wins (BNF sec 10)
    hidden method DoPlainWinsTie(const AId: int64; const ACandidate: int64; const AOther: int64): bool;
    begin
      return (InstanceOf(self.FTree, ACandidate) = 0) and (InstanceOf(self.FTree, AOther) <> 0) and
        not self.DoBetterOverload(AId, AOther, ACandidate);
    end;

    // True when the call of ASig through ACallee goes through a generic instance (BNF sec
    // 10): ACallee names type arguments (Max<int32>(..), X.Map<string>(..)), or a generic
    // shares ASig's name in its scope (its type arguments inferred, DoGenericCallee)
    hidden const method DoIsGenericCall(const ACallee: int64; const ASig: int64): bool;
    var
      LScope: int64;
      LChild: int64;
      LI: int64;
    begin
      if self.FTree.CountOf(ACallee, NodeRole.TypeArgument) > 0 then
        return true;
      end;
      LScope := self.FTree.ParentOf(ASig);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if self.DoIsNamedRoutine(LChild, self.FTree[ASig].Text) and
          (self.FTree.FirstOf(LChild, NodeRole.GenericParam) <> 0) and
          self.DoIsSeenBy(LChild, ACallee) then
          return true;
        end;
      end;
      return false;
    end;

    // The index of the type parameter AParam among its generic's (-1: none)
    hidden const method DoParamIndex(const AGeneric: int64; const AParam: int64): int64;
    var
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AGeneric, NodeRole.GenericParam) - 1 do
        if self.FTree.NthOf(AGeneric, NodeRole.GenericParam, LI) = AParam then
          return LI;
        end;
      end;
      return -1;
    end;

    // The type parameters of AGeneric that the parameter type ANode (a type expression of
    // its signature) fixes from the argument type AType (canonical), into ABound (BNF sec
    // 10: structural, exact): T takes AType whole; ptr to X / array of X / array[..] of X
    // reach X through a pointer's or an array's element; G<X, ..> reaches each X through
    // the arguments of AType's instance of G. A T bound to another type first is a clash:
    // its index + 1 into AClash, the second type into AClashType (the first is ABound's).
    // nil fixes nothing
    hidden const method DoUnify(const ANode: int64; const AType: int64; const AGeneric: int64;
      var ABound: array of int64; var AClash: int64; var AClashType: int64; const ADepth: int64);
    var
      LKind: NodeKind;
      LDecl: int64;
      LIndex: int64;
      LInstance: int64;
      LClass: TypeClass;
      LI: int64;
    begin
      if (ANode = 0) or (AType = 0) or (AClash <> 0) or (ADepth > ADAM_SEMANTICS_INFER_DEPTH) then
        return;
      end;
      LKind := self.FTree[ANode].Kind;
      LClass := self.DoClass(AType);
      if LKind = NodeKind.NamedType then
        LDecl := self.FTree[ANode].ResolvedDecl;
        if LDecl = 0 then
          return;
        end;
        if (self.FTree[LDecl].Kind = NodeKind.GenericParam) and (self.FTree.ParentOf(LDecl) = AGeneric) then
          LIndex := self.DoParamIndex(AGeneric, LDecl);
          if (LIndex < 0) or (LClass = TypeClass.NilType) then
            return;
          end;
          if ABound[LIndex] = 0 then
            ABound[LIndex] := AType;
          else
            if ABound[LIndex] <> AType then
              AClash := LIndex + 1;
              AClashType := AType;
            end;
          end;
          return;
        end;
        LInstance := InstanceOf(self.FTree, AType);
        if (self.FTree.CountOf(ANode, NodeRole.TypeArgument) > 0) and (LInstance <> 0) and
          (GenericOf(self.FTree, LInstance) = LDecl) and
          (self.FTree.CountOf(LInstance, NodeRole.GenericParam) = self.FTree.CountOf(ANode, NodeRole.TypeArgument)) then
          for LI := 0 to self.FTree.CountOf(ANode, NodeRole.TypeArgument) - 1 do
            self.DoUnify(self.FTree.NthOf(ANode, NodeRole.TypeArgument, LI),
              self.FTree[self.FTree.NthOf(LInstance, NodeRole.GenericParam, LI)].ResolvedType,
              AGeneric, ABound, AClash, AClashType, ADepth + 1);
          end;
        end;
        return;
      end;
      if ((LKind = NodeKind.PointerType) and (LClass = TypeClass.Pointer)) or
        ((LKind = NodeKind.ArrayType) and ((LClass = TypeClass.StaticArray) or (LClass = TypeClass.DynamicArray))) then
        self.DoUnify(self.FTree.FirstOf(ANode, NodeRole.Element), TargetOf(self.FTree, AType),
          AGeneric, ABound, AClash, AClashType, ADepth + 1);
      end;
    end;

    // The type arguments the call AId gives the generic AGeneric (its arguments typed
    // already), each parameter's type unified with its argument's (DoUnify) into AArgs;
    // false when one is not fixed (AUnfixed: its index) or two arguments disagree on one
    // (AClash: its index + 1, AClashType: the second type, AArgs the first)
    hidden method DoInfer(const AId: int64; const AGeneric: int64; const AArgs: ref NodeList;
      var AUnfixed: int64; var AClash: int64; var AClashType: int64): bool;
    var
      LBound: array of int64;
      LCount: int64;
      LGiven: int64;
      LI: int64;
    begin
      LCount := self.FTree.CountOf(AGeneric, NodeRole.GenericParam);
      setlength(LBound, LCount);
      for LI := 0 to LCount - 1 do
        LBound[LI] := 0;
      end;
      AUnfixed := -1;
      AClash := 0;
      AClashType := 0;
      LGiven := self.FTree.CountOf(AId, NodeRole.Argument);
      if LGiven > self.FTree.CountOf(AGeneric, NodeRole.Param) then
        LGiven := self.FTree.CountOf(AGeneric, NodeRole.Param);
      end;
      for LI := 0 to LGiven - 1 do
        self.DoUnify(self.FTree.FirstOf(self.FTree.NthOf(AGeneric, NodeRole.Param, LI), NodeRole.TypeOf),
          self.DoTypeOf(self.FTree.NthOf(AId, NodeRole.Argument, LI)), AGeneric, LBound, AClash, AClashType, 0);
      end;
      return self.DoBoundArgs(LBound, AArgs, AClash, AUnfixed);
    end;

    // The type parameters' bound types ABound (DoUnify's) as AArgs, in order: false on a
    // clash (AClash set) or a type parameter left unfixed (AUnfixed: the first one's index)
    hidden const method DoBoundArgs(const ABound: array of int64; const AArgs: ref NodeList;
      const AClash: int64; var AUnfixed: int64): bool;
    var
      LI: int64;
    begin
      AArgs.Clear();
      for LI := 0 to len(ABound) - 1 do
        AArgs.Add(ABound[LI]);
      end;
      if AClash <> 0 then
        return false;
      end;
      for LI := 0 to len(ABound) - 1 do
        if (ABound[LI] = 0) or HasUnknownPart(self.FTree, ABound[LI]) then
          AUnfixed := LI;
          return false;
        end;
      end;
      return true;
    end;

    // The routine or method the call AId of ASig (through ACallee, DoIsGenericCall) runs,
    // written as ACallee's ResolvedDecl (an instance's GenericInstance as its
    // ResolvedInstance), BNF sec 10. With type arguments: the generics of ASig's name in its
    // scope with that many type parameters (none: SM0735), each instance made over the
    // arguments. Without: the plain routines of the name and an instance of each generic
    // whose type arguments the call's arguments fix (DoInfer); a lone generic that cannot
    // is SM0738 (a type fixed by nothing) or SM0739 (two arguments disagree). Every
    // instance made is typed (DoVisitMade); several takers are picked by DoPickFrom (a
    // plain routine wins a tie with an instance). In a template the call is its instances'
    // (its type unknown, silent). 0 then, or after a report: its arguments visited
    hidden method DoGenericCallee(const AId: int64; const ACallee: int64; const ASig: int64): int64;
    var
      LGiven: int64;
      LScope: int64;
      LChild: int64;
      LName: string;
      LGeneric: int64;
      LGenerics: int64;
      LCandidates: ref NodeList;
      LTakers: ref NodeList;
      LSet: ref NodeList;
      LArgs: ref NodeList;
      LType: int64;
      LInstance: int64;
      LMade: int64;
      LPicked: int64;
      LUnfixed: int64;
      LClash: int64;
      LClashType: int64;
      LFailed: int64;
      LI: int64;
    begin
      LGiven := self.FTree.CountOf(ACallee, NodeRole.TypeArgument);
      LName := self.FTree[ASig].Text;
      LCandidates := ref NodeList();
      LTakers := ref NodeList();
      LGeneric := 0;
      LGenerics := 0;
      LScope := self.FTree.ParentOf(ASig);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if self.DoIsNamedRoutine(LChild, LName) and self.DoIsSeenBy(LChild, AId) then
          if self.FTree.FirstOf(LChild, NodeRole.GenericParam) <> 0 then
            if LGeneric = 0 then
              LGeneric := LChild;
            end;
            LGenerics := LGenerics + 1;
            if (LGiven = 0) or (self.FTree.CountOf(LChild, NodeRole.GenericParam) = LGiven) then
              LCandidates.Add(LChild);
            end;
          else
            // a plain routine of the name takes a call with no type arguments (a method's
            // plain ones are its set, below)
            if (LGiven = 0) and (self.FTree[LChild].Kind <> NodeKind.MethodDecl) then
              LTakers.Add(LChild);
            end;
          end;
        end;
      end;
      if (LGiven = 0) and (self.FTree[ASig].Kind = NodeKind.MethodDecl) then
        // its level's plain methods of the name and the virtual ones above (MO1)
        LSet := self.DoMethodSet(ASig, AId);
        for LI := 0 to LSet.Count - 1 do
          LTakers.Add(LSet.Items[LI]);
        end;
      end;
      if (LGiven > 0) and (LCandidates.Count = 0) then
        self.DoVisitArguments(AId);
        if LGeneric = 0 then
          self.DoError(ACallee, ADAM_ERR_SEMANTICS_735, ADAM_MSG_SEMANTICS_NOT_GENERIC,
            NoArgs().Str(self.DoExprText(ACallee)));
        else
          self.DoError(ACallee, ADAM_ERR_SEMANTICS_735, ADAM_MSG_SEMANTICS_TYPE_ARG_COUNT,
            NoArgs().Str(self.DoExprText(ACallee)).Int(self.FTree.CountOf(LGeneric, NodeRole.GenericParam)).Int(LGiven));
        end;
        return 0;
      end;
      // a template's own calls are its instances' (typed there, each T in place)
      if IsInTemplate(self.FTree, AId) then
        self.DoVisitArguments(AId);
        return 0;
      end;
      LArgs := ref NodeList();
      LMade := self.FResolver.MadeCount();
      if LGiven > 0 then
        for LI := 0 to LGiven - 1 do
          LType := CanonicalOf(self.FTree, self.FTree.NthOf(ACallee, NodeRole.TypeArgument, LI));
          if (LType = 0) or HasUnknownPart(self.FTree, LType) then
            // a type that did not resolve was reported where it was lost
            self.DoVisitArguments(AId);
            return 0;
          end;
          LArgs.Add(LType);
        end;
        for LI := 0 to LCandidates.Count - 1 do
          LInstance := self.FResolver.RoutineInstance(LCandidates.Items[LI], LArgs, ACallee);
          if LInstance = 0 then
            // past the depth limit (SM0736)
            self.DoVisitArguments(AId);
            return 0;
          end;
          LTakers.Add(self.FTree.FirstOf(LInstance, NodeRole.Instance));
        end;
      else
        self.DoVisitArguments(AId);
        LFailed := 0;
        LUnfixed := -1;
        LClash := 0;
        LClashType := 0;
        for LI := 0 to LCandidates.Count - 1 do
          if self.DoInfer(AId, LCandidates.Items[LI], LArgs, LUnfixed, LClash, LClashType) then
            LInstance := self.FResolver.RoutineInstance(LCandidates.Items[LI], LArgs, ACallee);
            if LInstance = 0 then
              return 0;
            end;
            LTakers.Add(self.FTree.FirstOf(LInstance, NodeRole.Instance));
          else
            LFailed := LCandidates.Items[LI];
          end;
        end;
        if (LTakers.Count = 0) and (LGenerics = 1) then
          // the one generic of the name: why its type arguments are not fixed
          if LClash <> 0 then
            self.DoError(ACallee, ADAM_ERR_SEMANTICS_739, ADAM_MSG_SEMANTICS_GENERIC_CLASH,
              NoArgs().Str(self.DoExprText(ACallee)).Str(self.FTree[self.FTree.NthOf(LFailed, NodeRole.GenericParam, LClash - 1)].Text).Str(self.DoText(LArgs.Items[LClash - 1])).Str(self.DoText(LClashType)));
          else
            self.DoError(ACallee, ADAM_ERR_SEMANTICS_738, ADAM_MSG_SEMANTICS_GENERIC_UNFIXED,
              NoArgs().Str(self.DoExprText(ACallee)).Str(self.FTree[self.FTree.NthOf(LFailed, NodeRole.GenericParam, LUnfixed)].Text));
          end;
          return 0;
        end;
      end;
      self.DoVisitMade(LMade);
      if LTakers.Count = 1 then
        LPicked := LTakers.Items[0];
      else
        self.DoVisitArguments(AId);
        LPicked := self.DoPickFrom(AId, ACallee, LTakers);
        if LPicked = 0 then
          return 0;
        end;
      end;
      self.FTree[ACallee].ResolvedDecl := LPicked;
      self.FTree[ACallee].ResolvedInstance := InstanceOf(self.FTree, LPicked);
      self.DoSetType(ACallee, RoutineTypeOf(self.FTree, LPicked));
      return LPicked;
    end;

    // The overload set of the method ASig the use AUse sees (BNF sec 4, MO1): the methods
    // of its name at its level (generic ones take a call through their instances:
    // DoGenericCallee), then each dispatched one of the levels above (virtual, override,
    // abstract; an interface's every method) whose parameter types no method already in
    // the set takes (SameMethodParams: its override is in it). A level hides its parents'
    // plain methods of its name, never their virtual ones
    hidden const method DoMethodSet(const ASig: int64; const AUse: int64): ref NodeList;
    var
      LSet: ref NodeList;
      LBody: int64;
      LAt: int64;
      LDepth: int64;
      LInterface: bool;
      LCovered: bool;
      LChild: int64;
      LI: int64;
      LJ: int64;
    begin
      LSet := ref NodeList();
      LBody := self.FTree.ParentOf(ASig);
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LChild := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if (self.FTree[LChild].Kind = NodeKind.MethodDecl) and (self.FTree[LChild].Text = self.FTree[ASig].Text) and
          (self.FTree.FirstOf(LChild, NodeRole.GenericParam) = 0) and self.DoIsSeenBy(LChild, AUse) then
          LSet.Add(LChild);
        end;
      end;
      // a static's set is its level's alone: no static dispatches (J3d)
      if self.FTree[ASig].HasFlag(NodeFlag.Static) then
        return LSet;
      end;
      LAt := ParentTypeOf(self.FTree, self.DoDeclaringType(ASig));
      LDepth := 0;
      while (LAt <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
        LBody := BodyOf(self.FTree, LAt);
        if LBody = 0 then
          leave;
        end;
        LInterface := ClassOf(self.FTree, LAt) = TypeClass.InterfaceType;
        for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
          LChild := self.FTree.NthOf(LBody, NodeRole.Member, LI);
          if (self.FTree[LChild].Kind = NodeKind.MethodDecl) and (self.FTree[LChild].Text = self.FTree[ASig].Text) and
            (self.FTree.FirstOf(LChild, NodeRole.GenericParam) = 0) and
            (LInterface or self.DoIsVirtual(LChild)) and self.DoIsSeenBy(LChild, AUse) then
            LCovered := false;
            for LJ := 0 to LSet.Count - 1 do
              if SameMethodParams(self.FTree, LSet.Items[LJ], LChild) then
                LCovered := true;
                leave;
              end;
            end;
            if not LCovered then
              LSet.Add(LChild);
            end;
          end;
        end;
        LAt := ParentTypeOf(self.FTree, LAt);
        LDepth := LDepth + 1;
      end;
      return LSet;
    end;

    // The member of the overload set ASig belongs to (its scope's routines of its name,
    // forwards left out: each pairs with its routine) that the call AId runs, by BNF sec 3:
    // only the members that take the arguments by Adam's conversions (none: SM0402), the
    // one better than every other by C++'s ranks (none: SM0403, Adam's own). 0 after a
    // report
    hidden method DoPickOverload(const AId: int64; const ACallee: int64; const ASig: int64): int64;
    var
      LScope: int64;
      LChild: int64;
      LCandidates: ref NodeList;
      LI: int64;
    begin
      if self.FTree[ASig].Kind = NodeKind.MethodDecl then
        return self.DoPickFrom(AId, ACallee, self.DoMethodSet(ASig, AId));
      end;
      LScope := self.FTree.ParentOf(ASig);
      LCandidates := ref NodeList();
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if self.DoIsOverloadMember(LChild, self.FTree[ASig].Text) and
          self.DoIsSeenBy(LChild, AId) then
          LCandidates.Add(LChild);
        end;
      end;
      return self.DoPickFrom(AId, ACallee, LCandidates);
    end;

    // True when the call AId of a routine whose bare name ACallee is also an intrinsic's
    // (a routine size hides size(T)) is given a type: SM0411 at each type argument (the
    // caller meant the intrinsic), its other arguments visited; nothing more is checked
    hidden method DoHiddenIntrinsicTypeArgs(const AId: int64; const ACallee: int64): bool;
    var
      LSystem: int64;
      LArgument: int64;
      LI: int64;
      LFound: bool;
    begin
      if self.FTree[ACallee].Kind <> NodeKind.NameExpression then
        return false;
      end;
      LSystem := FindSystem(self.FTree, self.FTree[ACallee].Text);
      if (LSystem = 0) or (self.FTree[LSystem].Kind <> NodeKind.IntrinsicDecl) then
        return false;
      end;
      LFound := false;
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        LArgument := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        if DoIsTypeExpression(self.FTree[LArgument].Kind) or (self.DoTypeNamed(LArgument) <> 0) then
          LFound := true;
        end;
      end;
      if not LFound then
        return false;
      end;
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        LArgument := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        if DoIsTypeExpression(self.FTree[LArgument].Kind) then
          self.DoVisit(LArgument);
          self.DoError(LArgument, ADAM_ERR_SEMANTICS_411, ADAM_MSG_SEMANTICS_HIDDEN_INTRINSIC,
            NoArgs().Str(self.DoText(CanonicalOf(self.FTree, LArgument))).Str(self.FTree[ACallee].Text));
        else
          if self.DoTypeNamed(LArgument) <> 0 then
            // a named type: marked visited, so its own visit adds no SM0269
            self.DoFirstVisit(LArgument);
            self.DoError(LArgument, ADAM_ERR_SEMANTICS_411, ADAM_MSG_SEMANTICS_HIDDEN_INTRINSIC,
              NoArgs().Str(self.DoExprText(LArgument)).Str(self.FTree[ACallee].Text));
          else
            self.DoVisit(LArgument);
          end;
        end;
      end;
      return true;
    end;

    // A call AId of the routine or method ASig (its callee ACallee): the arguments
    // checked, the return type its type (none: a procedure). An overload set's call runs
    // the member DoPickOverload picks, written as the callee's ResolvedDecl (the name then
    // means that member); after a report its arguments are only visited
    hidden method DoRoutineCall(const AId: int64; const ACallee: int64; const ASig: int64);
    var
      LSig: int64;
      LGeneric: bool;
      LOverloaded: bool;
      LReach: bool;
      LStatic: bool;
    begin
      if self.DoHiddenIntrinsicTypeArgs(AId, ACallee) then
        self.DoSetType(AId, CanonicalOf(self.FTree, self.FTree.FirstOf(ASig, NodeRole.ReturnType)));
        return;
      end;
      LSig := ASig;
      LGeneric := self.DoIsGenericCall(ACallee, ASig);
      LOverloaded := (not LGeneric) and self.DoIsOverloaded(ASig);
      // a method of an overload set: DoMember left its member checks to the one picked (MO1)
      LReach := (self.FTree[ACallee].Kind = NodeKind.MemberExpression) and
        (self.FTree[ASig].Kind = NodeKind.MethodDecl) and (LGeneric or LOverloaded);
      LStatic := (self.FTree[ASig].Kind = NodeKind.MethodDecl) and self.FTree[ASig].HasFlag(NodeFlag.Static);
      if LGeneric then
        LSig := self.DoGenericCallee(AId, ACallee, ASig);
        if LSig = 0 then
          return;
        end;
      else
        if LOverloaded then
          self.DoVisitArguments(AId);
          LSig := self.DoPickOverload(AId, ACallee, ASig);
          if LSig = 0 then
            return;
          end;
          self.FTree[ACallee].ResolvedDecl := LSig;
          self.DoSetType(ACallee, RoutineTypeOf(self.FTree, LSig));
        end;
      end;
      if LStatic and (LReach or (self.FTree[ACallee].Kind = NodeKind.NameExpression)) then
        // a static has no receiver: only its hidden reach (J3d)
        self.DoStaticReach(ACallee, LSig);
      else
        if LReach then
          self.DoMemberReach(ACallee, self.FTree.FirstOf(ACallee, NodeRole.Operand), LSig);
        end;
      end;
      if self.DoTypeOf(ACallee) = 0 then
        self.DoSetType(ACallee, RoutineTypeOf(self.FTree, LSig));
      end;
      self.DoConstMethodCall(ACallee, LSig);
      self.DoArguments(AId, LSig, LSig, self.DoExprText(ACallee));
      // a method returning self: the call is its receiver, of the receiver's static type (F7)
      if self.DoIsSelfCall(AId) then
        self.DoSetType(AId, self.DoTypeOf(self.FTree.FirstOf(ACallee, NodeRole.Operand)));
        return;
      end;
      self.DoSetType(AId, CanonicalOf(self.FTree, self.FTree.FirstOf(LSig, NodeRole.ReturnType)));
    end;

    // True when the routine-like ARoutine is a method whose return type is self (BNF sec 3
    // method decl, F7: flag SelfReturn)
    hidden const method DoReturnsSelf(const ARoutine: int64): bool;
    begin
      return (ARoutine <> 0) and (self.FTree[ARoutine].Kind = NodeKind.MethodDecl) and
        self.FTree[ARoutine].HasFlag(NodeFlag.SelfReturn);
    end;

    // True when AId is a call of a method returning self through a member access (F7):
    // its value is that access's receiver
    hidden const method DoIsSelfCall(const AId: int64): bool;
    var
      LCallee: int64;
    begin
      if (AId = 0) or (self.FTree[AId].Kind <> NodeKind.CallExpression) then
        return false;
      end;
      LCallee := self.FTree.FirstOf(AId, NodeRole.Callee);
      return (LCallee <> 0) and (self.FTree[LCallee].Kind = NodeKind.MemberExpression) and
        self.DoReturnsSelf(self.FTree[LCallee].ResolvedDecl);
    end;

    // The method AId's `: self` (F7) where it may stand: a method of an object type with a
    // self (not a static's, an interface's or a record's); SM0764 at its name else, the
    // flag dropped (refused: nothing more is reported of its returns)
    hidden method DoSelfReturnDecl(const AId: int64);
    var
      LOwner: int64;
    begin
      if not self.FTree[AId].HasFlag(NodeFlag.SelfReturn) then
        return;
      end;
      LOwner := MethodOwnerOf(self.FTree, AId);
      if (LOwner <> 0) and (self.FTree[LOwner].Kind = NodeKind.ObjectType) and
        not self.FTree[AId].HasFlag(NodeFlag.Static) then
        return;
      end;
      self.DoErrorName(AId, ADAM_ERR_SEMANTICS_764, ADAM_MSG_SEMANTICS_SELF_TYPE, NoArgs());
      self.FTree[AId].RemoveFlag(NodeFlag.SelfReturn);
    end;

    // True when AParam, a child in a routine's Param role, is a parameter the parser lost
    // (it was reported): a skipped span, or a Param whose type never came
    hidden method DoLostParam(const AParam: int64): bool;
    begin
      return (self.FTree[AParam].Kind <> NodeKind.Param) or (self.FTree.FirstOf(AParam, NodeRole.TypeOf) = 0);
    end;

    // True when the routine ARoutine has a parameter the parser lost
    hidden method DoLostParams(const ARoutine: int64): bool;
    var
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ARoutine, NodeRole.Param) - 1 do
        if self.DoLostParam(self.FTree.NthOf(ARoutine, NodeRole.Param, LI)) then
          return true;
        end;
      end;
      return false;
    end;

    // True when the routines AFirst and ASecond have the same parameter count and each
    // parameter the same type. ALostMatches: a parameter the parser lost (it was reported)
    // matches any, as a forward pairs with its full declaration (the modes, names and the
    // rest are facts judged after the pair, DoRoutineFact); false keeps it a type of its
    // own, so a parse error starts no SM0324
    hidden method DoSameParamTypes(const AFirst: int64; const ASecond: int64; const ALostMatches: bool): bool;
    var
      LI: int64;
      LFirst: int64;
      LSecond: int64;
      LGenerics: int64;
    begin
      if self.FTree.CountOf(AFirst, NodeRole.Param) <> self.FTree.CountOf(ASecond, NodeRole.Param) then
        return false;
      end;
      // a generic and a plain routine are two (BNF sec 10: the plain one wins a tie), two
      // generics one only with as many type parameters (C++'s template equivalence)
      LGenerics := self.FTree.CountOf(AFirst, NodeRole.GenericParam);
      if LGenerics <> self.FTree.CountOf(ASecond, NodeRole.GenericParam) then
        return false;
      end;
      for LI := 0 to self.FTree.CountOf(AFirst, NodeRole.Param) - 1 do
        LFirst := self.FTree.NthOf(AFirst, NodeRole.Param, LI);
        LSecond := self.FTree.NthOf(ASecond, NodeRole.Param, LI);
        if ALostMatches and (self.DoLostParam(LFirst) or self.DoLostParam(LSecond)) then
          skip;
        end;
        if LGenerics > 0 then
          if not self.DoSameTypeShape(self.FTree.FirstOf(LFirst, NodeRole.TypeOf), AFirst,
            self.FTree.FirstOf(LSecond, NodeRole.TypeOf), ASecond, 0) then
            return false;
          end;
        else
          if self.DoDeclType(LFirst) <> self.DoDeclType(LSecond) then
            return false;
          end;
        end;
      end;
      return true;
    end;

    // True when the type expressions AFirst (in the generic AFirstGeneric's signature) and
    // ASecond (in ASecondGeneric's) are one type with each generic's type parameters
    // matched by position (T in F<T> is U in F<U>): a type parameter only its own index; a
    // type naming none its canonical type; else the same kind over the same parts (ptr to
    // [const] X, array of X, array[lo..hi] of X with the same constant bounds, G<X, ..>).
    // Any other form naming a type parameter is two types (a routine type over T: no
    // report rather than a wrong one)
    hidden const method DoSameTypeShape(const AFirst: int64; const AFirstGeneric: int64;
      const ASecond: int64; const ASecondGeneric: int64; const ADepth: int64): bool;
    var
      LKind: NodeKind;
      LFirstDecl: int64;
      LSecondDecl: int64;
      LFirstIndex: int64;
      LSecondIndex: int64;
      LFirstType: int64;
      LSecondType: int64;
      LI: int64;
    begin
      if (AFirst = 0) or (ASecond = 0) or (ADepth > ADAM_SEMANTICS_INFER_DEPTH) then
        return false;
      end;
      LKind := self.FTree[AFirst].Kind;
      if LKind <> self.FTree[ASecond].Kind then
        LFirstType := CanonicalOf(self.FTree, AFirst);
        return (LFirstType <> 0) and (LFirstType = CanonicalOf(self.FTree, ASecond));
      end;
      if LKind = NodeKind.NamedType then
        LFirstDecl := self.FTree[AFirst].ResolvedDecl;
        LSecondDecl := self.FTree[ASecond].ResolvedDecl;
        LFirstIndex := -1;
        LSecondIndex := -1;
        if (LFirstDecl <> 0) and (self.FTree[LFirstDecl].Kind = NodeKind.GenericParam) and
          (self.FTree.ParentOf(LFirstDecl) = AFirstGeneric) then
          LFirstIndex := self.DoParamIndex(AFirstGeneric, LFirstDecl);
        end;
        if (LSecondDecl <> 0) and (self.FTree[LSecondDecl].Kind = NodeKind.GenericParam) and
          (self.FTree.ParentOf(LSecondDecl) = ASecondGeneric) then
          LSecondIndex := self.DoParamIndex(ASecondGeneric, LSecondDecl);
        end;
        if (LFirstIndex >= 0) or (LSecondIndex >= 0) then
          return LFirstIndex = LSecondIndex;
        end;
        if self.FTree.CountOf(AFirst, NodeRole.TypeArgument) = 0 then
          LFirstType := CanonicalOf(self.FTree, AFirst);
          return (LFirstType <> 0) and (LFirstType = CanonicalOf(self.FTree, ASecond));
        end;
        if (LFirstDecl = 0) or (LFirstDecl <> LSecondDecl) or
          (self.FTree.CountOf(AFirst, NodeRole.TypeArgument) <> self.FTree.CountOf(ASecond, NodeRole.TypeArgument)) then
          return false;
        end;
        for LI := 0 to self.FTree.CountOf(AFirst, NodeRole.TypeArgument) - 1 do
          if not self.DoSameTypeShape(self.FTree.NthOf(AFirst, NodeRole.TypeArgument, LI), AFirstGeneric,
            self.FTree.NthOf(ASecond, NodeRole.TypeArgument, LI), ASecondGeneric, ADepth + 1) then
            return false;
          end;
        end;
        return true;
      end;
      if LKind = NodeKind.PointerType then
        return (self.FTree[AFirst].HasFlag(NodeFlag.ConstTarget) = self.FTree[ASecond].HasFlag(NodeFlag.ConstTarget)) and
          self.DoSameTypeShape(self.FTree.FirstOf(AFirst, NodeRole.Element), AFirstGeneric,
          self.FTree.FirstOf(ASecond, NodeRole.Element), ASecondGeneric, ADepth + 1);
      end;
      if LKind = NodeKind.ArrayType then
        return self.DoSameBound(self.FTree.FirstOf(AFirst, NodeRole.LowBound), self.FTree.FirstOf(ASecond, NodeRole.LowBound)) and
          self.DoSameBound(self.FTree.FirstOf(AFirst, NodeRole.HighBound), self.FTree.FirstOf(ASecond, NodeRole.HighBound)) and
          (self.FTree[AFirst].HasFlag(NodeFlag.OpenEnd) = self.FTree[ASecond].HasFlag(NodeFlag.OpenEnd)) and
          self.DoSameTypeShape(self.FTree.FirstOf(AFirst, NodeRole.Element), AFirstGeneric,
          self.FTree.FirstOf(ASecond, NodeRole.Element), ASecondGeneric, ADepth + 1);
      end;
      LFirstType := CanonicalOf(self.FTree, AFirst);
      return (LFirstType <> 0) and (LFirstType = CanonicalOf(self.FTree, ASecond));
    end;

    // True when the array bounds AFirst and ASecond (expressions, 0 for none) are both
    // absent or the same integer constant
    hidden const method DoSameBound(const AFirst: int64; const ASecond: int64): bool;
    var
      LFirstNeg: bool;
      LFirstMag: uint64;
      LSecondNeg: bool;
      LSecondMag: uint64;
    begin
      if (AFirst = 0) or (ASecond = 0) then
        return (AFirst = 0) and (ASecond = 0);
      end;
      return ConstIntOf(self.FTree, AFirst, LFirstNeg, LFirstMag) and
        ConstIntOf(self.FTree, ASecond, LSecondNeg, LSecondMag) and
        (LFirstNeg = LSecondNeg) and (LFirstMag = LSecondMag);
    end;

    // True when the routines AFirst and ASecond have the same parameter types (count, '...'
    // and each type: names, var / const, linkage and return type make no overload, BNF
    // sec 3)
    hidden method DoSameParameters(const AFirst: int64; const ASecond: int64): bool;
    begin
      if self.FTree[AFirst].HasFlag(NodeFlag.Variadic) <> self.FTree[ASecond].HasFlag(NodeFlag.Variadic) then
        return false;
      end;
      return self.DoSameParamTypes(AFirst, ASecond, false);
    end;

    // A routine declaration AId with a body that is variadic with C linkage (by meaning:
    // Types.IsCppSignature) needs a fixed parameter before '...' (BNF sec 4: C reads the
    // extra arguments from past the last fixed one), else SM0325 at it; an external one may
    // have none
    hidden method DoVariadicFixed(const AId: int64);
    begin
      if not self.FTree[AId].HasFlag(NodeFlag.Variadic) then
        return;
      end;
      if (self.FTree.FirstOf(AId, NodeRole.Body) = 0) or IsCppSignature(self.FTree, AId) then
        return;
      end;
      if self.FTree.CountOf(AId, NodeRole.Param) = 0 then
        self.DoErrorAt(self.FTree[AId].AtMark(NodeMark.Ellipsis), ADAM_ERR_SEMANTICS_325, ADAM_MSG_SEMANTICS_VARIADIC_FIXED,
          NoArgs().Str(self.FTree[AId].Text));
      end;
    end;

    // The variadic routine AId: its pack takes any arguments, so it joins no overload set
    // (pcpp V4); another routine of its name in its scope is SM0330 at it, once (its forward
    // is the same routine)
    hidden method DoVariadicOverload(const AId: int64);
    var
      LScope: int64;
      LI: int64;
      LOther: int64;
    begin
      if not self.FTree[AId].HasFlag(NodeFlag.Variadic) then
        return;
      end;
      LScope := self.FTree.ParentOf(AId);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LOther := self.FTree.ChildAt(LScope, LI);
        if (LOther <> AId) and (self.FTree[LOther].Kind = NodeKind.RoutineDecl) and
          (self.FTree[LOther].Text = self.FTree[AId].Text) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_330, ADAM_MSG_SEMANTICS_VARIADIC_OVERLOAD,
            NoArgs().Str(self.FTree[AId].Text).Int(int64(self.FTree[LOther].Place.Line)));
          return;
        end;
      end;
    end;

    // A routine declaration AId: an earlier routine of its name in its scope with the same
    // parameter types makes it no overload (SM0324 at it, once)
    hidden method DoOverloadDeclared(const AId: int64);
    var
      LScope: int64;
      LI: int64;
      LEarlier: int64;
    begin
      LScope := self.FTree.ParentOf(AId);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LEarlier := self.FTree.ChildAt(LScope, LI);
        if LEarlier = AId then
          return;
        end;
        if (self.FTree[LEarlier].Kind = NodeKind.RoutineDecl) and
          (self.FTree[LEarlier].Text = self.FTree[AId].Text) and self.DoSameParameters(LEarlier, AId) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_324, ADAM_MSG_SEMANTICS_OVERLOAD_SAME,
            NoArgs().Str(self.FTree[AId].Text));
          self.FTree[AId].AddFlag(NodeFlag.Repeated);
          return;
        end;
      end;
    end;

    // The first parameter the paired forward AForward and full declaration AFull spell
    // differently: its name, then its mode ("" when none; the counts are equal, they
    // paired; a parameter the parser lost is skipped, it was reported)
    hidden method DoParamFact(const AForward: int64; const AFull: int64): string;
    var
      LI: int64;
      LForward: int64;
      LFull: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AForward, NodeRole.Param) - 1 do
        LForward := self.FTree.NthOf(AForward, NodeRole.Param, LI);
        LFull := self.FTree.NthOf(AFull, NodeRole.Param, LI);
        if self.DoLostParam(LForward) or self.DoLostParam(LFull) then
          skip;
        end;
        if self.FTree[LForward].Text <> self.FTree[LFull].Text then
          return NoArgs().Int(LI + 1).Str(self.FTree[LForward].Text).Str(self.FTree[LFull].Text).Fill(
            ADAM_MSG_SEMANTICS_FACT_PARAM_NAME);
        end;
        if (self.FTree[LForward].HasFlag(NodeFlag.VarParam) <> self.FTree[LFull].HasFlag(NodeFlag.VarParam)) or
          (self.FTree[LForward].HasFlag(NodeFlag.ConstParam) <> self.FTree[LFull].HasFlag(NodeFlag.ConstParam)) then
          return NoArgs().Str(self.FTree[LForward].Text).Fill(ADAM_MSG_SEMANTICS_FACT_PARAM_MODE);
        end;
      end;
      return "";
    end;

    // The first fact the paired forward AForward and full declaration AFull disagree on
    // (BNF sec 3): the linkage by meaning (clink written or not is C, Types.IsCppSignature),
    // the export, '...', the parameters, the return type; "" when they match
    hidden method DoRoutineFact(const AForward: int64; const AFull: int64): string;
    var
      LFact: string;
      LForwardReturn: int64;
      LFullReturn: int64;
    begin
      if IsCppSignature(self.FTree, AForward) <> IsCppSignature(self.FTree, AFull) then
        return ADAM_MSG_SEMANTICS_FACT_LINKAGE;
      end;
      if self.FTree[AForward].HasFlag(NodeFlag.Public) <> self.FTree[AFull].HasFlag(NodeFlag.Public) then
        return ADAM_MSG_SEMANTICS_FACT_PUBLIC;
      end;
      if self.FTree[AForward].HasFlag(NodeFlag.Variadic) <> self.FTree[AFull].HasFlag(NodeFlag.Variadic) then
        return ADAM_MSG_SEMANTICS_FACT_VARIADIC;
      end;
      // A call of the forward ends the path as a call of the full does (DoIsEndingCall)
      if self.FTree[AForward].HasFlag(NodeFlag.NoReturn) <> self.FTree[AFull].HasFlag(NodeFlag.NoReturn) then
        return ADAM_MSG_SEMANTICS_FACT_NORETURN;
      end;
      LFact := self.DoParamFact(AForward, AFull);
      if LFact <> "" then
        return LFact;
      end;
      LForwardReturn := self.FTree.FirstOf(AForward, NodeRole.ReturnType);
      LFullReturn := self.FTree.FirstOf(AFull, NodeRole.ReturnType);
      if (LForwardReturn = 0) <> (LFullReturn = 0) then
        return ADAM_MSG_SEMANTICS_FACT_RETURN;
      end;
      if (LForwardReturn <> 0) and
        (CanonicalOf(self.FTree, LForwardReturn) <> CanonicalOf(self.FTree, LFullReturn)) then
        return ADAM_MSG_SEMANTICS_FACT_RETURN;
      end;
      return "";
    end;

    // A full routine AId completes the first earlier forward routine of its scope with its
    // name and parameter types that has none (routines pair by signature): the forward's
    // ResolvedDecl is AId, so whatever names the forward runs AId. A fact the two disagree
    // on is SM0306 at AId. A full that pairs with no forward is an overload of its own
    hidden method DoPairRoutine(const AId: int64);
    var
      LScope: int64;
      LI: int64;
      LForward: int64;
      LFact: string;
    begin
      LScope := self.FTree.ParentOf(AId);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LForward := self.FTree.ChildAt(LScope, LI);
        if LForward = AId then
          return;
        end;
        if (self.FTree[LForward].Kind = NodeKind.ForwardRoutine) and
          (self.FTree[LForward].ResolvedDecl = 0) and
          (self.FTree[LForward].Text = self.FTree[AId].Text) and
          self.DoSameParamTypes(LForward, AId, true) then
          self.FTree[LForward].ResolvedDecl := AId;
          LFact := self.DoRoutineFact(LForward, AId);
          if LFact <> "" then
            self.DoError(AId, ADAM_ERR_SEMANTICS_306, ADAM_MSG_SEMANTICS_FORWARD_DIFFER,
              NoArgs().Str(self.FTree[AId].Text).Str(LFact).Int(int64(self.FTree[LForward].Place.Line)));
          end;
          return;
        end;
      end;
    end;

    // A forward type AId after a full declaration of its name in its scope declares
    // nothing (SM0304): it names that full (its ResolvedDecl), so no SM0303 follows
    hidden method DoForwardType(const AId: int64);
    var
      LScope: int64;
      LI: int64;
      LFull: int64;
    begin
      LScope := self.FTree.ParentOf(AId);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LFull := self.FTree.ChildAt(LScope, LI);
        if LFull = AId then
          return;
        end;
        if (self.FTree[LFull].Kind = NodeKind.TypeDecl) and (self.FTree[LFull].Text = self.FTree[AId].Text) then
          self.FTree[AId].ResolvedDecl := LFull;
          self.DoError(AId, ADAM_ERR_SEMANTICS_304, ADAM_MSG_SEMANTICS_FORWARD_AFTER_FULL,
            NoArgs().Str(self.FTree[AId].Text).Int(int64(self.FTree[LFull].Place.Line)));
          return;
        end;
      end;
    end;

    // A full type declaration AId completes every earlier forward type of its name in its
    // scope that has none (types pair by name: each forward's ResolvedDecl is AId). The
    // first such forward is the one its kind (SM0305: a record, object, interface or
    // overlay completes a forward) and its export (SM0306) are judged against
    hidden method DoFullType(const AId: int64);
    var
      LScope: int64;
      LI: int64;
      LForward: int64;
      LFirst: int64;
      LBody: int64;
      LKind: NodeKind;
    begin
      LScope := self.FTree.ParentOf(AId);
      LFirst := 0;
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LForward := self.FTree.ChildAt(LScope, LI);
        if LForward = AId then
          leave;
        end;
        if (self.FTree[LForward].Kind = NodeKind.ForwardType) and
          (self.FTree[LForward].ResolvedDecl = 0) and
          (self.FTree[LForward].Text = self.FTree[AId].Text) then
          self.FTree[LForward].ResolvedDecl := AId;
          if LFirst = 0 then
            LFirst := LForward;
          end;
        end;
      end;
      if LFirst = 0 then
        return;
      end;
      LBody := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      if LBody <> 0 then
        LKind := self.FTree[LBody].Kind;
        if (LKind <> NodeKind.RecordType) and (LKind <> NodeKind.ObjectType) and
          (LKind <> NodeKind.InterfaceType) and (LKind <> NodeKind.OverlayType) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_305, ADAM_MSG_SEMANTICS_FORWARD_KIND,
            NoArgs().Str(self.FTree[AId].Text).Int(int64(self.FTree[LFirst].Place.Line)));
        end;
      end;
      if self.FTree[LFirst].HasFlag(NodeFlag.Public) <> self.FTree[AId].HasFlag(NodeFlag.Public) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_306, ADAM_MSG_SEMANTICS_FORWARD_DIFFER,
          NoArgs().Str(self.FTree[AId].Text).Str(ADAM_MSG_SEMANTICS_FACT_PUBLIC).Int(
          int64(self.FTree[LFirst].Place.Line)));
      end;
    end;

    // True when the forward routine AForward, or a full routine of its name in its scope,
    // has a parameter the parser lost (it was reported): the pair cannot be judged, so the
    // forward is not reported unpaired
    hidden method DoLostPair(const AForward: int64): bool;
    var
      LScope: int64;
      LI: int64;
      LChild: int64;
    begin
      if self.DoLostParams(AForward) then
        return true;
      end;
      LScope := self.FTree.ParentOf(AForward);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if (self.FTree[LChild].Kind = NodeKind.RoutineDecl) and
          (self.FTree[LChild].Text = self.FTree[AForward].Text) and self.DoLostParams(LChild) then
          return true;
        end;
      end;
      return false;
    end;

    // The full routine of the forward routine AForward's name in its scope closest to it
    // (the SM0307 line); 0 when the scope has none
    hidden method DoNearestFull(const AForward: int64): int64;
    var
      LScope: int64;
      LI: int64;
      LAt: int64;
      LBest: int64;
      LBestDistance: int64;
      LDistance: int64;
      LChild: int64;
    begin
      LScope := self.FTree.ParentOf(AForward);
      LAt := 0;
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        if self.FTree.ChildAt(LScope, LI) = AForward then
          LAt := LI;
        end;
      end;
      LBest := 0;
      LBestDistance := 0;
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if (self.FTree[LChild].Kind = NodeKind.RoutineDecl) and
          (self.FTree[LChild].Text = self.FTree[AForward].Text) then
          // Closest by list distance; the earlier one on a tie (list order)
          LDistance := LI - LAt;
          if LDistance < 0 then
            LDistance := -LDistance;
          end;
          if (LBest = 0) or (LDistance < LBestDistance) then
            LBest := LChild;
            LBestDistance := LDistance;
          end;
        end;
      end;
      return LBest;
    end;

    // Every forward visited that no full declaration completed, once the program is
    // typed: a forward type is SM0303, a forward routine SM0307 (the nearest full
    // routine of its name named). Silent on a nameless forward and on a forward routine
    // whose pair has a parameter the parser lost (DoLostPair): the parser reported those
    hidden method DoUnpairedForwards();
    var
      LI: int64;
      LForward: int64;
      LNearest: int64;
    begin
      for LI := 0 to self.FForwards.Count - 1 do
        LForward := self.FForwards[LI];
        if (self.FTree[LForward].ResolvedDecl = 0) and (self.FTree[LForward].Text <> "") then
          if self.FTree[LForward].Kind = NodeKind.ForwardType then
            self.DoError(LForward, ADAM_ERR_SEMANTICS_303, ADAM_MSG_SEMANTICS_FORWARD_NO_FULL,
              NoArgs().Str(self.FTree[LForward].Text));
          else
            if not self.DoLostPair(LForward) then
              LNearest := self.DoNearestFull(LForward);
              if LNearest = 0 then
                self.DoError(LForward, ADAM_ERR_SEMANTICS_307, ADAM_MSG_SEMANTICS_ROUTINE_NO_FULL,
                  NoArgs().Str(self.FTree[LForward].Text));
              else
                self.DoError(LForward, ADAM_ERR_SEMANTICS_307, ADAM_MSG_SEMANTICS_ROUTINE_NO_FULL_NEAREST,
                  NoArgs().Str(self.FTree[LForward].Text).Int(int64(self.FTree[LNearest].Place.Line)));
              end;
            end;
          end;
        end;
      end;
    end;

    // The choices type AChoices numbered now when its own module's walk has not reached it
    // yet (its body visited once: DoChoices): a set / integer cast reads its values' numbers
    // (F6a) wherever it is met, as main's cast of a set of a unit's choices type is met
    // before that unit's walk (nothing for any other type)
    hidden method DoNumberChoices(const AChoices: int64);
    var
      LBody: int64;
    begin
      if (AChoices = 0) or (self.DoClass(AChoices) <> TypeClass.ChoicesType) then
        return;
      end;
      LBody := BodyOf(self.FTree, AChoices);
      // a compiled unit's choices are numbered already
      if (LBody <> 0) and (self.FTree[LBody].Kind = NodeKind.ChoicesType) and
        not self.FTree[LBody].HasFlag(NodeFlag.Compiled) then
        self.DoVisit(LBody);
      end;
    end;

    // The choices type a set type ASet holds numbered now (DoNumberChoices; nothing for any
    // other type, or a set of another element)
    hidden method DoNumberSetChoices(const ASet: int64);
    var
      LBody: int64;
    begin
      if (ASet = 0) or (self.DoClass(ASet) <> TypeClass.SetType) then
        return;
      end;
      LBody := BodyOf(self.FTree, ASet);
      if (LBody = 0) or (self.FTree.FirstOf(LBody, NodeRole.LowBound) <> 0) then
        return;
      end;
      self.DoNumberChoices(CanonicalOf(self.FTree, self.FTree.FirstOf(LBody, NodeRole.Element)));
    end;

    // The value AArgument cast to AType (a type cast, T(x) on a declared type): SM0264
    // when no cast takes it
    hidden method DoCastValue(const AArgument: int64; const AType: int64);
    var
      LFrom: int64;
      LRoot: int64;
    begin
      if (AArgument = 0) or (AType = 0) then
        return;
      end;
      // a set literal cast to an integer: its members' bits, no set type (F6a, R1)
      LRoot := self.DoSkipParens(AArgument);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.SetLiteral) and
        IsIntegerClass(self.DoClass(AType)) then
        self.DoSetLiteralBits(LRoot, AType);
        return;
      end;
      if self.DoLost(AArgument) then
        return;
      end;
      LFrom := self.DoTypeOf(AArgument);
      // a set's members numbered before their bits are judged (F6a)
      self.DoNumberSetChoices(LFrom);
      self.DoNumberSetChoices(AType);
      if self.DoCastTakes(LFrom, AType) then
        return;
      end;
      if self.DoLiteralTakes(self.DoSkipParens(AArgument), AType) then
        self.FTree[AArgument].ResolvedConvert := AType;
        return;
      end;
      // a set and an integer whose bits do not hold every member's value
      if (self.DoClass(LFrom) = TypeClass.SetType) and IsIntegerClass(self.DoClass(AType)) then
        self.DoSetBitsError(AArgument, LFrom, AType, IntBits(self.FTree, AType));
        return;
      end;
      if (self.DoClass(AType) = TypeClass.SetType) and IsIntegerClass(self.DoClass(LFrom)) then
        self.DoSetBitsError(AArgument, AType, LFrom, 64);
        return;
      end;
      self.DoError(AArgument, ADAM_ERR_SEMANTICS_264, ADAM_MSG_SEMANTICS_NO_CAST,
        NoArgs().Str(self.DoText(LFrom)).Str(self.DoText(AType)));
    end;

    // The set literal ALiteral cast to the integer type AType (BNF sec 6 F6a, his (a)
    // 2026-11-24, R1): bit int64(M) set for each member M, as a set of its items' choices
    // type casts (no set type is needed: the bits are the members' values). Its items (a
    // value or a span) are of one choices type, the first item's (each converted to it,
    // SM0200 otherwise), whose every value is 0..63 and a bit of AType (SM0761, as
    // DoSetBitsFit judges a set of it); an empty literal is 0. Lowering builds the bits
    // (DoBitsFromLiteral)
    hidden method DoSetLiteralBits(const ALiteral: int64; const AType: int64);
    var
      LItem: int64;
      LLow: int64;
      LHigh: int64;
      LChoices: int64;
      LBits: int64;
      LFirst: int64;
      LLast: int64;
      LI: int64;
    begin
      if self.FTree.CountOf(ALiteral, NodeRole.Element) = 0 then
        return;
      end;
      LItem := self.FTree.NthOf(ALiteral, NodeRole.Element, 0);
      LChoices := self.DoTypeOf(self.FTree.FirstOf(LItem, NodeRole.LowBound));
      if LChoices = 0 then
        return;
      end;
      if self.DoClass(LChoices) <> TypeClass.ChoicesType then
        self.DoError(self.FTree.FirstOf(LItem, NodeRole.LowBound), ADAM_ERR_SEMANTICS_264,
          ADAM_MSG_SEMANTICS_NO_CAST, NoArgs().Str(self.DoText(LChoices)).Str(self.DoText(AType)));
        return;
      end;
      // its members numbered before their bits are judged
      self.DoNumberChoices(LChoices);
      for LI := 0 to self.FTree.CountOf(ALiteral, NodeRole.Element) - 1 do
        LItem := self.FTree.NthOf(ALiteral, NodeRole.Element, LI);
        LLow := self.FTree.FirstOf(LItem, NodeRole.LowBound);
        LHigh := self.FTree.FirstOf(LItem, NodeRole.HighBound);
        if LLow <> 0 then
          self.DoConvert(LLow, LChoices);
        end;
        if LHigh <> 0 then
          self.DoConvert(LHigh, LChoices);
        end;
      end;
      LBits := IntBits(self.FTree, AType);
      LFirst := 0;
      LLast := 0;
      if (not ChoicesRange(self.FTree, LChoices, LFirst, LLast)) or (LFirst < 0) or
        (LLast >= LBits) or (LLast > 63) then
        if LBits > 64 then
          LBits := 64;
        end;
        LI := LLast;
        if LFirst < 0 then
          LI := LFirst;
        end;
        self.DoError(ALiteral, ADAM_ERR_SEMANTICS_761, ADAM_MSG_SEMANTICS_SET_BITS,
          NoArgs().Str(self.DoText(LChoices)).Str(self.DoText(AType)).Int(LBits - 1).Int(LI));
      end;
    end;

    // A call AId whose callee names the type AType: a value construction (BNF sec 4, his
    // OK 2026-11-23: an object type whose init its arguments fit, or given other than one
    // argument, builds a value by its init, DoBuild; NodeFlag.Construction), else a cast
    // (BNF sec 6, TColor(N)), one argument (SM0412)
    hidden method DoCastCall(const AId: int64; const AType: int64; const AName: string);
    var
      LGiven: int64;
    begin
      self.DoVisitArguments(AId);
      self.DoSetType(AId, AType);
      LGiven := self.FTree.CountOf(AId, NodeRole.Argument);
      if self.DoIsConstruction(AId, AType, LGiven) then
        self.FTree[AId].AddFlag(NodeFlag.Construction);
        self.DoBuild(AId, NodeRole.Argument, AType, AId, false);
        return;
      end;
      if LGiven <> 1 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_412, ADAM_MSG_SEMANTICS_CAST_ARGS,
          NoArgs().Str(AName).Int(LGiven));
        return;
      end;
      self.DoCastValue(self.FTree.FirstOf(AId, NodeRole.Argument), AType);
    end;

    // True when the call AId of the type AType with AGiven arguments builds a value of it
    // (DoCastCall): AType an object type, given other than one argument (DoBuild reports
    // what no init takes) or one an init of it takes; one argument no init takes stays a cast
    hidden method DoIsConstruction(const AId: int64; const AType: int64; const AGiven: int64): bool;
    var
      LBody: int64;
      LMember: int64;
      LI: int64;
    begin
      if self.DoClass(AType) <> TypeClass.ObjectType then
        return false;
      end;
      if AGiven <> 1 then
        return true;
      end;
      LBody := BodyOf(self.FTree, AType);
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if (self.FTree[LMember].Kind = NodeKind.InitDecl) and
          self.DoInitTakes(LMember, AId, NodeRole.Argument) then
          return true;
        end;
      end;
      return false;
    end;

    // SM0409 at the intrinsic call AId named AName: it takes ASignature
    hidden method DoBadIntrinsic(const AId: int64; const AName: string; const ASignature: string);
    begin
      self.DoError(AId, ADAM_ERR_SEMANTICS_409, ADAM_MSG_SEMANTICS_INTRINSIC_SIG,
        NoArgs().Str(AName).Str(ASignature));
    end;

    // SM0409 for the intrinsic call AId named AName (it takes ASignature, ACount arguments):
    // at its AIndex-th argument, the one that does not fit, when the call has ACount (pcpp's
    // place); at the call when the count is wrong
    hidden method DoBadArgument(const AId: int64; const AName: string; const ASignature: string;
      const ACount: int64; const AIndex: int64);
    var
      LAt: int64;
    begin
      LAt := AId;
      if self.FTree.CountOf(AId, NodeRole.Argument) = ACount then
        LAt := self.FTree.NthOf(AId, NodeRole.Argument, AIndex);
        // in a template an argument of unknown type depends on a type parameter: typed
        // per instance (BNF sec 10), nothing reported here
        if (self.FTree[LAt].ResolvedType = 0) and IsInTemplate(self.FTree, AId) then
          return;
        end;
      end;
      self.DoError(LAt, ADAM_ERR_SEMANTICS_409, ADAM_MSG_SEMANTICS_INTRINSIC_SIG,
        NoArgs().Str(AName).Str(ASignature));
    end;

    // True when the intrinsic call AId has ACount arguments and the AIndex-th converts to
    // AType (no report); AType 0 checks the count only
    hidden const method DoIntrinsicArg(const AId: int64; const ACount: int64; const AIndex: int64;
      const AType: int64): bool;
    var
      LArgument: int64;
    begin
      if self.FTree.CountOf(AId, NodeRole.Argument) <> ACount then
        return false;
      end;
      if AType = 0 then
        return true;
      end;
      LArgument := self.FTree.NthOf(AId, NodeRole.Argument, AIndex);
      if self.DoIsNoValue(LArgument) then
        return false;
      end;
      return self.DoWouldConvert(LArgument, AType);
    end;

    // The AIndex-th argument of the intrinsic call AId converted to AType (its conversion
    // written; DoIntrinsicArg said it converts)
    hidden method DoIntrinsicConvert(const AId: int64; const AIndex: int64; const AType: int64);
    begin
      self.DoConvert(self.FTree.NthOf(AId, NodeRole.Argument, AIndex), AType);
    end;

    // The class of the AIndex-th argument of the intrinsic call AId
    hidden const method DoArgClass(const AId: int64; const AIndex: int64): TypeClass;
    begin
      return self.DoClass(self.DoTypeOf(self.FTree.NthOf(AId, NodeRole.Argument, AIndex)));
    end;

    // size(T): a type expression or a name of a type; an int64
    hidden method DoSizeOf(const AId: int64);
    var
      LArgument: int64;
    begin
      self.DoSetType(AId, self.DoBuiltin("int64"));
      if self.FTree.CountOf(AId, NodeRole.Argument) <> 1 then
        self.DoVisitArguments(AId);
        self.DoBadIntrinsic(AId, "size", ADAM_MSG_SEMANTICS_SIG_TYPE);
        return;
      end;
      LArgument := self.FTree.FirstOf(AId, NodeRole.Argument);
      if DoIsTypeExpression(self.FTree[LArgument].Kind) then
        self.DoVisit(LArgument);
        return;
      end;
      if self.DoTypeNamed(LArgument) <> 0 then
        self.DoFirstVisit(LArgument);
        return;
      end;
      // a value (a variable, an expression): SM0410 at it, size reads only a type
      self.DoVisit(LArgument);
      self.DoError(LArgument, ADAM_ERR_SEMANTICS_410, ADAM_MSG_SEMANTICS_SIZE_OF_VALUE,
        NoArgs().Str(self.DoExprText(LArgument)));
    end;

    // __adam_cthunk(T) (CB1, the runtime's CCallback<T>): T a type expression or a name of
    // a plain func type (DoThunkFuncType); a ptr, the code address of T's chain entry (the
    // target a thunk jumps to, Lowering). T's canonical type is written into the argument's
    // ResolvedType and T's closure type (the one CCallback<T> holds) into its ResolvedJump
    // (no conversion of the argument: no pass lowers it as a value), the places Lowering
    // reads them; any other argument is SM0767
    hidden method DoCThunk(const AId: int64);
    var
      LArgument: int64;
      LType: int64;
      LKind: NodeKind;
      LDecl: int64;
    begin
      self.DoSetType(AId, self.DoBuiltin("ptr"));
      if self.FTree.CountOf(AId, NodeRole.Argument) <> 1 then
        self.DoVisitArguments(AId);
        self.DoBadIntrinsic(AId, ADAM_CTHUNK_NAME, ADAM_MSG_SEMANTICS_SIG_TYPE);
        return;
      end;
      LArgument := self.FTree.FirstOf(AId, NodeRole.Argument);
      if DoIsTypeExpression(self.FTree[LArgument].Kind) then
        self.DoVisit(LArgument);
        LType := CanonicalOf(self.FTree, LArgument);
      else
        // a name of a type declaration (a template's type parameter among them: its type
        // is 0 there, judged per instance)
        LKind := self.FTree[LArgument].Kind;
        LDecl := 0;
        if (LKind = NodeKind.NameExpression) or (LKind = NodeKind.MemberExpression) then
          LDecl := self.FTree[LArgument].ResolvedDecl;
        end;
        if (LDecl = 0) or not DoIsTypeDecl(self.FTree[LDecl].Kind) then
          self.DoVisit(LArgument);
          if self.DoIsNoValue(LArgument) then
            return;
          end;
          self.DoError(LArgument, ADAM_ERR_SEMANTICS_767, ADAM_MSG_SEMANTICS_CTHUNK_TYPE,
            NoArgs().Str(self.DoExprText(LArgument)).Str(ADAM_MSG_SEMANTICS_CTHUNK_NOT_FUNC));
          return;
        end;
        self.DoFirstVisit(LArgument);
        LType := self.DoTypeNamed(LArgument);
        if LType = 0 then
          return;
        end;
        self.FTree[LArgument].ResolvedType := LType;
      end;
      if self.DoThunkFuncType(LArgument, LType) then
        self.FTree[LArgument].ResolvedJump := ClosureTypeOf(self.FTree, LType);
      end;
    end;

    // True when AExpr is a place an atomic acts on (BNF sec 7, H4t2): assignable storage (a
    // property has no address: refused), of int32, int64, uint32 or uint64, or of ptr when
    // APointer (atomicadd takes no ptr)
    hidden const method DoIsAtomicPlace(const AExpr: int64; const APointer: bool): bool;
    var
      LAt: int64;
      LDecl: int64;
      LType: int64;
      LClass: TypeClass;
      LName: string;
    begin
      if self.DoIsNoValue(AExpr) or (not self.DoIsAssignable(AExpr)) then
        return false;
      end;
      LAt := self.DoSkipParens(AExpr);
      LDecl := self.FTree[LAt].ResolvedDecl;
      if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
        return false;
      end;
      LType := self.DoTypeOf(AExpr);
      LClass := self.DoClass(LType);
      if LClass = TypeClass.UntypedPointer then
        return APointer;
      end;
      if not IsIntegerClass(LClass) then
        return false;
      end;
      LName := self.FTree[LType].Text;
      return (LName = "int32") or (LName = "int64") or (LName = "uint32") or (LName = "uint64");
    end;

    // An atomic intrinsic (BNF sec 7, H4t2): its first argument a place (DoIsAtomicPlace),
    // every other one converted to the place's type; atomiccas is a bool, atomicstore has
    // no value, the others are the place's type. SM0409 naming the signature otherwise
    hidden method DoAtomicIntrinsic(const AId: int64; const AName: string);
    var
      LCount: int64;
      LPlace: int64;
      LType: int64;
      LI: int64;
    begin
      LCount := DoAtomicArity(AName);
      LType := 0;
      if self.FTree.CountOf(AId, NodeRole.Argument) = LCount then
        LPlace := self.FTree.FirstOf(AId, NodeRole.Argument);
        if self.DoIsAtomicPlace(LPlace, AName <> "atomicadd") then
          LType := self.DoTypeOf(LPlace);
        end;
      end;
      if AName = "atomiccas" then
        self.DoSetType(AId, self.DoBuiltin("bool"));
      end;
      if (LType <> 0) and (AName <> "atomiccas") and (AName <> "atomicstore") then
        self.DoSetType(AId, LType);
      end;
      if LType = 0 then
        self.DoBadIntrinsic(AId, AName, DoAtomicSignature(AName));
        return;
      end;
      for LI := 1 to LCount - 1 do
        if not self.DoIntrinsicArg(AId, LCount, LI, LType) then
          self.DoBadIntrinsic(AId, AName, DoAtomicSignature(AName));
          return;
        end;
      end;
      for LI := 1 to LCount - 1 do
        self.DoIntrinsicConvert(AId, LI, LType);
      end;
    end;

    // A bit intrinsic (BNF sec 7, M9j0): one argument of any integer type, read at its own
    // width; byteswap is of that type, leadingzeros / trailingzeros / popcount an int32.
    // SM0409 naming the signature otherwise (an argument of unknown type stays silent)
    hidden method DoBitIntrinsic(const AId: int64; const AName: string);
    var
      LType: int64;
      LClass: TypeClass;
    begin
      LType := self.DoBuiltin("int32");
      LClass := TypeClass.Unknown;
      if self.DoIntrinsicArg(AId, 1, 0, 0) then
        LClass := self.DoArgClass(AId, 0);
        if IsIntegerClass(LClass) and (AName = "byteswap") then
          LType := self.DoTypeOf(self.FTree.FirstOf(AId, NodeRole.Argument));
        end;
      end;
      self.DoSetType(AId, LType);
      if self.DoIntrinsicArg(AId, 1, 0, 0) and
        (IsIntegerClass(LClass) or (LClass = TypeClass.Unknown)) then
        return;
      end;
      self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_INTEGER, 1, 0);
    end;

    // hash(X) (BNF sec 7, M10g): a uint64, for one argument of a type DoHashable takes;
    // SM0409 naming the signature for another argument count. An argument of unknown type
    // (lost, or a template's type parameter: typed per instance) stays silent
    hidden method DoHashIntrinsic(const AId: int64);
    var
      LType: int64;
    begin
      self.DoSetType(AId, self.DoBuiltin("uint64"));
      if not self.DoIntrinsicArg(AId, 1, 0, 0) then
        self.DoBadArgument(AId, "hash", ADAM_MSG_SEMANTICS_SIG_VALUE, 1, 0);
        return;
      end;
      LType := self.DoTypeOf(self.FTree.FirstOf(AId, NodeRole.Argument));
      if (LType = 0) or HasUnknownPart(self.FTree, LType) then
        return;
      end;
      self.DoHashable(AId, LType);
    end;

    // True when values of AType have a hash (BNF sec 7, M10g): a number, a char, a wchar, a
    // bool, a choices value, a pointer, a routine value, an own or a ref (by their bits), a
    // string or a wstring, a set, an array of any of these element by element; a record or
    // an object (or an array of them) through the operator hash its type declares (one
    // operand its type or an ancestor's: written as the call AId's ResolvedCallee, Lowering's
    // DoHashAt calls it per value). SM0741 at the argument otherwise
    hidden method DoHashable(const AId: int64; const AType: int64): bool;
    var
      LElement: int64;
      LClass: TypeClass;
      LFound: ref NodeList;
      LI: int64;
    begin
      LElement := AType;
      while (self.DoClass(LElement) = TypeClass.StaticArray) or
        (self.DoClass(LElement) = TypeClass.DynamicArray) do
        LElement := TargetOf(self.FTree, LElement);
      end;
      LClass := self.DoClass(LElement);
      if (LClass = TypeClass.RecordType) or (LClass = TypeClass.ObjectType) then
        LFound := ref NodeList();
        self.DoCollectOperators(LElement, OperatorKind.Hash, 1, LFound, AId);
        for LI := 0 to LFound.Count - 1 do
          if self.DoTakesElement(self.FTree.NthOf(LFound[LI], NodeRole.Param, 0), LElement) then
            self.FTree[AId].ResolvedCallee := LFound[LI];
            return true;
          end;
        end;
        self.DoError(self.FTree.FirstOf(AId, NodeRole.Argument), ADAM_ERR_SEMANTICS_741,
          ADAM_MSG_SEMANTICS_HASH_NO_OPERATOR, NoArgs().Str(self.DoText(AType)).Str(self.DoText(LElement)));
        return false;
      end;
      if IsIntegerClass(LClass) or (LClass = TypeClass.Float) or (LClass = TypeClass.Boolean) or
        (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) or (LClass = TypeClass.Text) or
        (LClass = TypeClass.WideText) or (LClass = TypeClass.ChoicesType) or
        (LClass = TypeClass.SetType) or (LClass = TypeClass.Pointer) or
        (LClass = TypeClass.UntypedPointer) or (LClass = TypeClass.RoutineType) or
        (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
        return true;
      end;
      self.DoError(self.FTree.FirstOf(AId, NodeRole.Argument), ADAM_ERR_SEMANTICS_741,
        ADAM_MSG_SEMANTICS_HASH_TYPE, NoArgs().Str(self.DoText(AType)));
      return false;
    end;

    // The value intrinsics' types and arguments (BNF sec 7, PLAN-INTRINSICS I1): an
    // argument takes the type the runtime takes by the no-hidden-conversion rule (SM0409
    // naming the signature otherwise)
    hidden method DoValueIntrinsic(const AId: int64; const AName: string);
    var
      LInt32: int64;
      LInt64: int64;
      LString: int64;
      LClass: TypeClass;
    begin
      if IsAtomicIntrinsic(AName) then
        self.DoAtomicIntrinsic(AId, AName);
        return;
      end;
      if IsBitIntrinsic(AName) then
        self.DoBitIntrinsic(AId, AName);
        return;
      end;
      if AName = "hash" then
        self.DoHashIntrinsic(AId);
        return;
      end;
      LInt32 := self.DoBuiltin("int32");
      LInt64 := self.DoBuiltin("int64");
      LString := self.DoBuiltin("string");
      if AName = "len" then
        self.DoSetType(AId, LInt64);
        if self.DoIntrinsicArg(AId, 1, 0, 0) then
          LClass := self.DoArgClass(AId, 0);
          if (LClass = TypeClass.Text) or (LClass = TypeClass.WideText) or
            (LClass = TypeClass.StaticArray) or (LClass = TypeClass.DynamicArray) or
            (LClass = TypeClass.Unknown) then
            return;
          end;
        end;
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_LENGTH, 1, 0);
        return;
      end;
      // FormatStr(F, ..) is the string print(F, ..) writes: print's format and arguments,
      // checked as print's (M3.8f2b); F is no optional
      if AName = "FormatStr" then
        self.DoSetType(AId, LString);
        if self.FTree.CountOf(AId, NodeRole.Argument) = 0 then
          self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_FORMAT);
          return;
        end;
        self.DoPrintCall(AId);
        return;
      end;
      if AName = "utf8" then
        self.DoSetType(AId, LString);
        if self.DoIntrinsicArg(AId, 1, 0, self.DoBuiltin("wstring")) then
          self.DoIntrinsicConvert(AId, 0, self.DoBuiltin("wstring"));
          return;
        end;
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_WSTRING, 1, 0);
        return;
      end;
      if AName = "paramstr" then
        self.DoSetType(AId, LString);
        if self.DoIntrinsicArg(AId, 1, 0, LInt32) then
          self.DoIntrinsicConvert(AId, 0, LInt32);
          return;
        end;
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_INT32, 1, 0);
        return;
      end;
      if AName = "getmem" then
        self.DoSetType(AId, self.DoBuiltin("ptr"));
        if self.DoIntrinsicArg(AId, 1, 0, LInt64) then
          self.DoIntrinsicConvert(AId, 0, LInt64);
          return;
        end;
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_INT64, 1, 0);
        return;
      end;
      if AName = "resizemem" then
        self.DoSetType(AId, self.DoBuiltin("ptr"));
        if self.DoIntrinsicArg(AId, 2, 1, LInt64) and IsPointerClass(self.DoArgClass(AId, 0)) then
          self.DoIntrinsicConvert(AId, 1, LInt64);
          return;
        end;
        // the pointer first, then the size
        if IsPointerClass(self.DoArgClass(AId, 0)) then
          self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_POINTER_INT64, 2, 1);
        else
          self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_POINTER_INT64, 2, 0);
        end;
        return;
      end;
      if AName = "pull" then
        self.DoPullIntrinsic(AId);
        return;
      end;
      // ready(T) (BNF sec 7): a bool, its one argument a task
      if AName = "ready" then
        self.DoSetType(AId, self.DoBuiltin("bool"));
        if (self.FTree.CountOf(AId, NodeRole.Argument) = 1) and
          (self.DoArgClass(AId, 0) = TypeClass.TaskType) then
          return;
        end;
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_TASK, 1, 0);
        return;
      end;
      // cancelled(T) / cancelled() (BNF sec 7, T3): a bool, no argument or one task
      if AName = "cancelled" then
        self.DoSetType(AId, self.DoBuiltin("bool"));
        if (self.FTree.CountOf(AId, NodeRole.Argument) = 0) or
          ((self.FTree.CountOf(AId, NodeRole.Argument) = 1) and
          (self.DoArgClass(AId, 0) = TypeClass.TaskType)) then
          return;
        end;
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_TASK_OR_NONE, 1, 0);
        return;
      end;
      // alive(W) / lock(W) (BNF sec 7, M3.10g): a bool / a ref T, the one argument a weak T
      if (AName = "alive") or (AName = "lock") then
        self.DoWeakIntrinsic(AId, AName);
        return;
      end;
      self.DoNoArgumentIntrinsic(AId, AName);
    end;

    // pull(S, X) (BNF sec 7, G1f): a bool; S a sequence of T, X a place of type T that the
    // pull writes as an assignment writes its target (SM0255 / SM0714 when it is not
    // assignable: DoNotAssignable; DoWritten's checks), never a property (its accessor has
    // no place to store into); SM0409 naming the signature at the argument that does not
    // fit. Lowering reads T from S's type
    hidden method DoPullIntrinsic(const AId: int64);
    var
      LSequence: int64;
      LPlace: int64;
      LClass: TypeClass;
      LElement: int64;
      LType: int64;
      LAt: int64;
      LDecl: int64;
    begin
      self.DoSetType(AId, self.DoBuiltin("bool"));
      if self.FTree.CountOf(AId, NodeRole.Argument) <> 2 then
        self.DoBadArgument(AId, "pull", ADAM_MSG_SEMANTICS_SIG_PULL, 2, 0);
        return;
      end;
      LSequence := self.FTree.NthOf(AId, NodeRole.Argument, 0);
      LPlace := self.FTree.NthOf(AId, NodeRole.Argument, 1);
      LClass := self.DoArgClass(AId, 0);
      if LClass = TypeClass.Unknown then
        // lost where it was reported
        return;
      end;
      if LClass <> TypeClass.SequenceType then
        self.DoBadArgument(AId, "pull", ADAM_MSG_SEMANTICS_SIG_PULL, 2, 0);
        return;
      end;
      LElement := TargetOf(self.FTree, self.DoTypeOf(LSequence));
      LType := self.DoTypeOf(LPlace);
      if (LType = 0) or (self.DoClass(LType) = TypeClass.Unknown) then
        return;
      end;
      LAt := self.DoSkipParens(LPlace);
      LDecl := 0;
      if LAt <> 0 then
        LDecl := self.FTree[LAt].ResolvedDecl;
      end;
      if self.DoIsNoValue(LPlace) or (LType <> LElement) or
        ((LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl)) then
        self.DoBadArgument(AId, "pull", ADAM_MSG_SEMANTICS_SIG_PULL, 2, 1);
        return;
      end;
      if not self.DoIsAssignable(LPlace) then
        self.DoNotAssignable(LPlace);
        return;
      end;
      self.DoWritten(LPlace);
    end;

    // alive(W): a bool; lock(W): a ref of the object type the weak W watches (BNF sec 7);
    // SM0409 when the one argument is no weak (lock then has no type)
    hidden method DoWeakIntrinsic(const AId: int64; const AName: string);
    var
      LWeak: int64;
    begin
      if AName = "alive" then
        self.DoSetType(AId, self.DoBuiltin("bool"));
      end;
      if (self.FTree.CountOf(AId, NodeRole.Argument) <> 1) or
        (self.DoArgClass(AId, 0) <> TypeClass.WeakType) then
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_WEAK, 1, 0);
        return;
      end;
      if AName = "lock" then
        LWeak := self.DoTypeOf(self.FTree.NthOf(AId, NodeRole.Argument, 0));
        self.DoSetType(AId, OwnerOf(self.FTree, NodeKind.RefType, TargetOf(self.FTree, LWeak)));
      end;
    end;

    // True when AId stands inside an except body of a guard of its own routine, test or
    // module body (what exccode() / excmsg() read is the exception that body handles)
    hidden const method DoInExcept(const AId: int64): bool;
    var
      LAt: int64;
      LParent: int64;
      LKind: NodeKind;
    begin
      LAt := AId;
      LParent := self.FTree.ParentOf(LAt);
      while LParent <> 0 do
        LKind := self.FTree[LParent].Kind;
        if (LKind = NodeKind.GuardStatement) and (self.FTree.RoleOf(LAt) = NodeRole.Except) then
          return true;
        end;
        // a func literal's closure runs outside the except part around it (F2a)
        if IsRoutineLike(LKind) or (LKind = NodeKind.Module) or (LKind = NodeKind.TestBlock) or
          (LKind = NodeKind.FuncLiteral) then
          return false;
        end;
        LAt := LParent;
        LParent := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // The intrinsics with no argument (paramcount, exccode, excmsg, ProjectPassword;
    // workerindex / workercount, T2: int64, known only in a for parallel's body, SM0710)
    hidden method DoNoArgumentIntrinsic(const AId: int64; const AName: string);
    var
      LWorker: bool;
    begin
      LWorker := (AName = "workerindex") or (AName = "workercount");
      if ((AName = "exccode") or (AName = "excmsg")) and not self.DoInExcept(AId) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_615, ADAM_MSG_SEMANTICS_EXC_OUTSIDE, NoArgs().Str(AName));
      end;
      if (AName = "paramcount") or (AName = "exccode") then
        self.DoSetType(AId, self.DoBuiltin("int32"));
      else
        if LWorker then
          self.DoSetType(AId, self.DoBuiltin("int64"));
        else
          self.DoSetType(AId, self.DoBuiltin("string"));
        end;
      end;
      if self.FTree.CountOf(AId, NodeRole.Argument) <> 0 then
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_NONE);
        return;
      end;
      if LWorker and not self.DoInParallelBody(AId) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_710, ADAM_MSG_SEMANTICS_PARALLEL_WORKER,
          NoArgs().Str(AName));
        return;
      end;
      // ProjectPassword() reads the project's scrambled password (the Driver's
      // SetProjectSecret): a build that is no project's has none
      if (AName = "ProjectPassword") and not self.FTree.InProject then
        self.DoError(AId, ADAM_ERR_SEMANTICS_433, ADAM_MSG_SEMANTICS_NO_PROJECT,
          NoArgs().Str(AName));
      end;
    end;

    // True when the print / println argument AArg names an overload set or a method as a
    // value: it has no single address to print (PaskalCPP's pfNoAddress)
    hidden const method DoIsNoAddress(const AArg: int64): bool;
    var
      LAt: int64;
      LDecl: int64;
      LKind: NodeKind;
    begin
      LAt := self.DoSkipParens(AArg);
      if LAt = 0 then
        return false;
      end;
      if (self.FTree[LAt].Kind <> NodeKind.NameExpression) and
        (self.FTree[LAt].Kind <> NodeKind.MemberExpression) then
        return false;
      end;
      LDecl := self.FTree[LAt].ResolvedDecl;
      if LDecl = 0 then
        return false;
      end;
      LKind := self.FTree[LDecl].Kind;
      if LKind = NodeKind.MethodDecl then
        return true;
      end;
      return ((LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine)) and
        self.DoIsOverloaded(LDecl);
    end;

    // The arguments of the print / println call AId after its format (PaskalCPP's E7): each
    // needs a print form (Types' PrintFormOf): a record, object, overlay or owner, or an
    // array of one, is SM0425 (print its fields), as is an overload set or a method named as
    // a value (no single address). ATypes gets their canonical types in order; true when
    // every one prints (an argument typed nowhere was reported where it was lost)
    hidden method DoPrintArguments(const AId: int64; var ATypes: array of int64): bool;
    var
      LArg: int64;
      LType: int64;
      LReady: bool;
      LI: int64;
    begin
      LReady := true;
      setlength(ATypes, self.FTree.CountOf(AId, NodeRole.Argument) - 1);
      for LI := 1 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        LArg := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        LType := self.FTree[LArg].ResolvedType;
        ATypes[LI - 1] := LType;
        if self.DoIsNoAddress(LArg) then
          self.DoError(LArg, ADAM_ERR_SEMANTICS_425, ADAM_MSG_SEMANTICS_PRINT_NO_ADDRESS,
            NoArgs().Str(self.DoExprText(LArg)));
          LReady := false;
        else
          if PrintFormOf(self.FTree, LType) = PrintForm.Unprintable then
            self.DoError(LArg, ADAM_ERR_SEMANTICS_425, ADAM_MSG_SEMANTICS_PRINT_UNPRINTABLE,
              NoArgs().Str(self.DoText(LType)));
            LReady := false;
          end;
          if PrintFormOf(self.FTree, LType) = PrintForm.Unknown then
            LReady := false;
          end;
        end;
      end;
      return LReady;
    end;

    // The text of the print / println format AFormat when it is one the build checks
    // (PaskalCPP's: a string literal, or a name of a const whose initializer is one,
    // TPCConstDecl.HasConstText) into AText (its decoded UTF-8); false for any other value
    hidden method DoFormatText(const AFormat: int64; var AText: string): bool;
    var
      LDecl: int64;
      LInit: int64;
    begin
      if self.FTree[AFormat].Kind = NodeKind.StringLiteral then
        AText := self.FTree[AFormat].Decoded;
        return true;
      end;
      if (self.FTree[AFormat].Kind <> NodeKind.NameExpression) and
        (self.FTree[AFormat].Kind <> NodeKind.MemberExpression) then
        return false;
      end;
      LDecl := self.FTree[AFormat].ResolvedDecl;
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.ConstDecl) then
        return false;
      end;
      LInit := self.FTree.FirstOf(LDecl, NodeRole.Initializer);
      if (LInit = 0) or (self.FTree[LInit].Kind <> NodeKind.StringLiteral) then
        return false;
      end;
      AText := self.FTree[LInit].Decoded;
      return true;
    end;

    // print / println / FormatStr (BNF sec 7; PaskalCPP's std::print and std::format, whose
    // format clang checks when the program is built): every argument after the format prints (DoPrintArguments,
    // SM0425); a format that is a string literal or a string const holding one is read
    // against the arguments' types as std::format reads it (Adam.Compiler.Formats; a wide
    // one never fits: SM0502); any other string is read when the call runs (M3.8i: the
    // plan AtRunTime, the runtime's FormatRun); a format of any other type is SM0500. The
    // plan read is the call's ResolvedFormat, Lowering's
    hidden method DoPrintCall(const AId: int64);
    var
      LFormat: int64;
      LText: string;
      LTypes: array of int64;
      LPlan: FormatPlan;
    begin
      if self.FTree.CountOf(AId, NodeRole.Argument) = 0 then
        return;
      end;
      LFormat := self.FTree.FirstOf(AId, NodeRole.Argument);
      if not self.DoPrintArguments(AId, LTypes) then
        return;
      end;
      if self.FTree[LFormat].ResolvedType = 0 then
        return;
      end;
      if not self.DoFormatText(LFormat, LText) then
        if ClassOf(self.FTree, self.FTree[LFormat].ResolvedType) <> TypeClass.Text then
          self.DoError(LFormat, ADAM_ERR_SEMANTICS_500, ADAM_MSG_SEMANTICS_FORMAT_NOT_STRING,
            NoArgs().Str(self.DoExprText(LFormat)).Str(self.DoText(self.FTree[LFormat].ResolvedType)));
          return;
        end;
        LPlan.AtRunTime := true;
        self.FTree.SetFormat(AId, LPlan);
        return;
      end;
      if (ClassOf(self.FTree, self.FTree[LFormat].ResolvedType) = TypeClass.WideText) or
        (not ReadFormat(self.FTree, LText, LTypes, LPlan)) then
        self.DoError(LFormat, ADAM_ERR_SEMANTICS_502, ADAM_MSG_SEMANTICS_FORMAT_MISMATCH,
          NoArgs().Str(self.DoExprText(LFormat)).Int(len(LTypes)).Str("{}"));
        return;
      end;
      self.FTree.SetFormat(AId, LPlan);
    end;

    // True when AExpr is what setlength resizes: an assignable dynamic array, string or
    // wstring
    hidden method DoIsResizable(const AExpr: int64): bool;
    var
      LClass: TypeClass;
    begin
      LClass := self.DoClass(self.DoTypeOf(AExpr));
      return ((LClass = TypeClass.DynamicArray) or (LClass = TypeClass.Text) or
        (LClass = TypeClass.WideText)) and self.DoIsAssignable(AExpr);
    end;

    // create(P) / destroy(P) (BNF sec 7): P a pointer variable (assignable: create writes the
    // new block into it, destroy nil) to a record or an overlay, else SM0409 naming that
    // signature; a pointer to an object is SM0361 at P, naming the own / ref that builds and
    // frees one (pcpp's PLAN-OBJECT O6, D4)
    hidden method DoHeapIntrinsic(const AId: int64; const AName: string);
    var
      LArgument: int64;
      LTarget: int64;
      LClass: TypeClass;
      LTargetText: string;
    begin
      if not self.DoIntrinsicArg(AId, 1, 0, 0) then
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_HEAP_POINTER, 1, 0);
        return;
      end;
      LArgument := self.FTree.NthOf(AId, NodeRole.Argument, 0);
      if (self.DoArgClass(AId, 0) <> TypeClass.Pointer) or (not self.DoIsAssignable(LArgument)) then
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_HEAP_POINTER, 1, 0);
        return;
      end;
      LTarget := TargetOf(self.FTree, self.DoTypeOf(LArgument));
      LClass := self.DoClass(LTarget);
      if LClass = TypeClass.ObjectType then
        LTargetText := self.DoText(LTarget);
        if AName = "create" then
          self.DoError(LArgument, ADAM_ERR_SEMANTICS_361, ADAM_MSG_SEMANTICS_CREATE_OBJECT,
            NoArgs().Str(LTargetText).Str(LTargetText).Str(LTargetText));
          return;
        end;
        self.DoError(LArgument, ADAM_ERR_SEMANTICS_361, ADAM_MSG_SEMANTICS_DESTROY_OBJECT,
          NoArgs().Str(LTargetText));
        return;
      end;
      if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.OverlayType) then
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_HEAP_POINTER, 1, 0);
      end;
    end;

    // The statement intrinsics' arguments (BNF sec 7): freemem a pointer; setlength a
    // dynamic array or string that can be assigned and an int64; raise a string; raisecode
    // an int32 and a string; print / println their format and print forms (DoPrintCall);
    // create / destroy their heap pointer (DoHeapIntrinsic); the asserts (DoAssertIntrinsic)
    hidden method DoStatementIntrinsic(const AId: int64; const AName: string);
    var
      LInt64: int64;
      LString: int64;
    begin
      if (AName = "print") or (AName = "println") then
        self.DoPrintCall(AId);
        return;
      end;
      if StartsStr(ADAM_SEMANTICS_INTRINSIC_TEST_PREFIX, AName) then
        self.DoAssertIntrinsic(AId, AName);
        return;
      end;
      if AName = "atomicstore" then
        self.DoAtomicIntrinsic(AId, AName);
        return;
      end;
      if (AName = "create") or (AName = "destroy") then
        self.DoHeapIntrinsic(AId, AName);
        return;
      end;
      // cancel(T) (BNF sec 7, T3): its one argument a task
      if AName = "cancel" then
        if not ((self.FTree.CountOf(AId, NodeRole.Argument) = 1) and
          (self.DoArgClass(AId, 0) = TypeClass.TaskType)) then
          self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_TASK, 1, 0);
        end;
        return;
      end;
      LInt64 := self.DoBuiltin("int64");
      LString := self.DoBuiltin("string");
      if AName = "freemem" then
        if not (self.DoIntrinsicArg(AId, 1, 0, 0) and IsPointerClass(self.DoArgClass(AId, 0))) then
          self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_POINTER, 1, 0);
        end;
        return;
      end;
      if AName = "setlength" then
        if self.DoIntrinsicArg(AId, 2, 1, LInt64) then
          if self.DoIsResizable(self.FTree.FirstOf(AId, NodeRole.Argument)) then
            self.DoIntrinsicConvert(AId, 1, LInt64);
            return;
          end;
        end;
        // the array / string place first, then the length
        if self.DoIntrinsicArg(AId, 2, 0, 0) and self.DoIsResizable(self.FTree.FirstOf(AId, NodeRole.Argument)) then
          self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_RESIZE, 2, 1);
        else
          self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_RESIZE, 2, 0);
        end;
        return;
      end;
      if AName = "raise" then
        if self.DoIntrinsicArg(AId, 1, 0, LString) then
          self.DoIntrinsicConvert(AId, 0, LString);
          return;
        end;
        self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_STRING, 1, 0);
        return;
      end;
      if AName = "raisecode" then
        if self.DoIntrinsicArg(AId, 2, 0, self.DoBuiltin("int32")) and
          self.DoIntrinsicArg(AId, 2, 1, LString) then
          self.DoIntrinsicConvert(AId, 0, self.DoBuiltin("int32"));
          self.DoIntrinsicConvert(AId, 1, LString);
          return;
        end;
        // the code first, then the message
        if self.DoIntrinsicArg(AId, 2, 0, self.DoBuiltin("int32")) then
          self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_INT32_STRING, 2, 1);
        else
          self.DoBadArgument(AId, AName, ADAM_MSG_SEMANTICS_SIG_INT32_STRING, 2, 0);
        end;
      end;
    end;

    // An assert's arguments (BNF sec 8): testAssert / testAssertTrue / testAssertFalse a
    // bool, testAssertNil / testAssertNotNil a pointer (nil too), testFail a string, each
    // testAssertEqual* its expected and its actual value (Int int64, UInt uint64, Float
    // float64, Str string, Bool bool, Ptr two pointers), each converted to its type (the
    // runtime's TestX takes them so, then the call's file and line, which Lowering adds).
    // The wrong count is SM0409 at the call, a value of the wrong type SM0409 at that value
    hidden method DoAssertIntrinsic(const AId: int64; const AName: string);
    var
      LCount: int64;
      LType: int64;
      LPointers: bool;
      LSignature: string;
      LArgument: int64;
      LI: int64;
    begin
      LCount := 2;
      LType := 0;
      LPointers := false;
      if (AName = "testAssert") or (AName = "testAssertTrue") or (AName = "testAssertFalse") then
        LCount := 1;
        LType := self.DoBuiltin("bool");
        LSignature := ADAM_MSG_SEMANTICS_SIG_BOOL;
      else
        if (AName = "testAssertNil") or (AName = "testAssertNotNil") then
          LCount := 1;
          LPointers := true;
          LSignature := ADAM_MSG_SEMANTICS_SIG_POINTER;
        else
          if AName = "testFail" then
            LCount := 1;
            LType := self.DoBuiltin("string");
            LSignature := ADAM_MSG_SEMANTICS_SIG_STRING;
          else
            if AName = "testAssertEqualInt" then
              LType := self.DoBuiltin("int64");
              LSignature := ADAM_MSG_SEMANTICS_SIG_TWO_INT64;
            else
              if AName = "testAssertEqualUInt" then
                LType := self.DoBuiltin("uint64");
                LSignature := ADAM_MSG_SEMANTICS_SIG_TWO_UINT64;
              else
                if AName = "testAssertEqualFloat" then
                  LType := self.DoBuiltin("float64");
                  LSignature := ADAM_MSG_SEMANTICS_SIG_TWO_FLOAT64;
                else
                  if AName = "testAssertEqualStr" then
                    LType := self.DoBuiltin("string");
                    LSignature := ADAM_MSG_SEMANTICS_SIG_TWO_STRING;
                  else
                    if AName = "testAssertEqualBool" then
                      LType := self.DoBuiltin("bool");
                      LSignature := ADAM_MSG_SEMANTICS_SIG_TWO_BOOL;
                    else
                      // testAssertEqualPtr, the last of BNF sec 8's asserts
                      LPointers := true;
                      LSignature := ADAM_MSG_SEMANTICS_SIG_TWO_POINTER;
                    end;
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
      if self.FTree.CountOf(AId, NodeRole.Argument) <> LCount then
        self.DoBadIntrinsic(AId, AName, LSignature);
        return;
      end;
      for LI := 0 to LCount - 1 do
        LArgument := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        if self.DoLost(LArgument) then
          return;
        end;
        if LPointers then
          if self.DoIsNoValue(LArgument) or not IsPointerClass(self.DoArgClass(AId, LI)) then
            self.DoError(LArgument, ADAM_ERR_SEMANTICS_409, ADAM_MSG_SEMANTICS_INTRINSIC_SIG,
              NoArgs().Str(AName).Str(LSignature));
            return;
          end;
        else
          if not self.DoIntrinsicArg(AId, LCount, LI, LType) then
            self.DoError(LArgument, ADAM_ERR_SEMANTICS_409, ADAM_MSG_SEMANTICS_INTRINSIC_SIG,
              NoArgs().Str(AName).Str(LSignature));
            return;
          end;
          self.DoIntrinsicConvert(AId, LI, LType);
        end;
      end;
    end;

    // The routine AName of the runtime unit (ATree.Runtime, DESIGN sec 8), public or not: the
    // compiler calls it, no program names it; 0 when the program has no runtime unit or it
    // declares no such routine (Lowering then reports what needed it)
    hidden const method DoRuntimeRoutine(const AName: string): int64;
    var
      LRuntime: int64;
    begin
      LRuntime := self.FTree.Runtime;
      if LRuntime = 0 then
        return 0;
      end;
      return self.DoRoutineIn(LRuntime, AName);
    end;

    // The routine AName declared in the module AModule, public or not; 0 when it declares
    // none
    hidden const method DoRoutineIn(const AModule: int64; const AName: string): int64;
    var
      LDecl: int64;
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(AModule, NodeRole.Declaration, LI);
        if (self.FTree[LDecl].Kind = NodeKind.RoutineDecl) and (self.FTree[LDecl].Text = AName) then
          return LDecl;
        end;
      end;
      return 0;
    end;

    // The routine AName of the platform unit (the runtime unit's implicit import of the
    // target's Target.RuntimeUnit, the parser's DoRuntimeUnits), public or not: the routines
    // the compiler names that are the OS's shape, never System.Runtime's; 0 when the program
    // has no runtime unit, the runtime imports no platform unit, or it declares no such
    // routine (Lowering then reports what needed it)
    hidden const method DoPlatformRoutine(const AName: string): int64;
    var
      LRuntime: int64;
      LImport: int64;
      LFound: int64;
      LI: int64;
    begin
      LRuntime := self.FTree.Runtime;
      if LRuntime = 0 then
        return 0;
      end;
      for LI := 0 to self.FTree.CountOf(LRuntime, NodeRole.Import) - 1 do
        LImport := self.FTree.NthOf(LRuntime, NodeRole.Import, LI);
        if self.FTree[LImport].ResolvedUnit <> 0 then
          LFound := self.DoRoutineIn(self.FTree[LImport].ResolvedUnit, AName);
          if LFound <> 0 then
            return LFound;
          end;
        end;
      end;
      return 0;
    end;

    // Every exe module with a block: the runtime routine its block ends with (ExitProgram:
    // the exit with ExitCode, BNF sec 5) written into the module's ResolvedCallee; a dll module's: the runtime routine its
    // loader entry hands the event to (DLLEvent, M8a)
    hidden method DoProgramExits();
    var
      LModule: int64;
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        LModule := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        if (self.FTree[LModule].Module = ModuleKind.Exe) and
          (self.FTree.FirstOf(LModule, NodeRole.Body) <> 0) then
          self.FTree[LModule].ResolvedCallee := self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_EXIT);
        end;
        // A dll's entry is the loader's: it hands the event on to the runtime (M8a)
        if self.FTree[LModule].Module = ModuleKind.DLL then
          self.FTree[LModule].ResolvedCallee := self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_DLL_EVENT);
        end;
      end;
    end;

    // The runtime unit's routines a managed type's operations call, which no single node
    // names, each recorded in the tree once (SyntaxTree.RuntimeRoutineOf; 0 when missing)
    hidden method DoRuntimeRoutines();
    begin
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrRelease,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_RELEASE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrAssign,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_ASSIGN));
