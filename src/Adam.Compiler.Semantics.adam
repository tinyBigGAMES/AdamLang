    // The runtime unit's threadstatic GAllocSite (its VarDecl, M3.12b): the allocation site
    // Lowering stores before a runtime call that may allocate; 0 when the program has no
    // runtime unit or it declares none (Lowering then stores no sites)
    hidden method DoAllocSite(): int64;
    var
      LRuntime: int64;
      LDecl: int64;
      LI: int64;
    begin
      LRuntime := self.FTree.Runtime;
      if LRuntime = 0 then
        return 0;
      end;
      for LI := 0 to self.FTree.CountOf(LRuntime, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(LRuntime, NodeRole.Declaration, LI);
        if (self.FTree[LDecl].Kind = NodeKind.VarDecl) and
          self.FTree[LDecl].HasFlag(NodeFlag.ThreadStatic) and
          (self.FTree[LDecl].Text = ADAM_SEMANTICS_RUNTIME_ALLOC_SITE) then
          return LDecl;
        end;
      end;
      return 0;
    end;

    // The runtime unit's choices type VarKind (its TypeDecl, visited so its values are
    // folded): what varargs.kind(I) answers with; 0 when the program has no runtime unit or
    // it declares none (Lowering then reports what needed it)
    hidden method DoVarKind(): int64;
    var
      LRuntime: int64;
      LDecl: int64;
      LI: int64;
    begin
      LRuntime := self.FTree.Runtime;
      if LRuntime = 0 then
        return 0;
      end;
      for LI := 0 to self.FTree.CountOf(LRuntime, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(LRuntime, NodeRole.Declaration, LI);
        if (self.FTree[LDecl].Kind = NodeKind.TypeDecl) and
          (self.FTree[LDecl].Text = ADAM_SEMANTICS_RUNTIME_VAR_KIND) then
          self.DoVisit(LDecl);
          return LDecl;
        end;
      end;
      return 0;
    end;

    // The node AId of kind(I) typed VarKind (DoVarKind), its I (AIndex) an int32; the
    // type is left unset when the runtime declares no VarKind
    hidden method DoPackKind(const AId: int64; const AIndex: int64);
    var
      LVarKind: int64;
    begin
      self.DoConvert(AIndex, self.DoBuiltin("int32"));
      LVarKind := self.DoVarKind();
      if LVarKind <> 0 then
        self.DoSetType(AId, LVarKind);
      end;
    end;

    // The runtime routine the intrinsic AName runs (DoIntrinsic writes it into the call's
    // ResolvedCallee); "" for an intrinsic the compiler lowers itself or that has none yet
    hidden const method DoRuntimeNameOf(const AName: string): string;
    begin
      if (AName = "print") or (AName = "println") or (AName = "FormatStr") then
        return ADAM_SEMANTICS_RUNTIME_WRITE;
      end;
      if AName = "getmem" then
        return ADAM_SEMANTICS_RUNTIME_GETMEM;
      end;
      if AName = "resizemem" then
        return ADAM_SEMANTICS_RUNTIME_RESIZEMEM;
      end;
      if AName = "freemem" then
        return ADAM_SEMANTICS_RUNTIME_FREEMEM;
      end;
      if AName = "paramcount" then
        return ADAM_SEMANTICS_RUNTIME_PARAMCOUNT;
      end;
      if AName = "paramstr" then
        return ADAM_SEMANTICS_RUNTIME_PARAMSTR;
      end;
      if AName = "raise" then
        return ADAM_SEMANTICS_RUNTIME_RAISE;
      end;
      if AName = "raisecode" then
        return ADAM_SEMANTICS_RUNTIME_RAISECODE;
      end;
      if AName = "exccode" then
        return ADAM_SEMANTICS_RUNTIME_EXCCODE;
      end;
      if AName = "excmsg" then
        return ADAM_SEMANTICS_RUNTIME_EXCMSG;
      end;
      if AName = "ProjectPassword" then
        return ADAM_SEMANTICS_RUNTIME_PROJECT_PASSWORD;
      end;
      // an assert (BNF sec 8): testAssertTrue runs TestAssertTrue, and so on
      if StartsStr(ADAM_SEMANTICS_INTRINSIC_TEST_PREFIX, AName) then
        return ReplaceStr(AName, ADAM_SEMANTICS_INTRINSIC_TEST_PREFIX,
          ADAM_SEMANTICS_RUNTIME_TEST_PREFIX);
      end;
      return "";
    end;

    // A call of the intrinsic named AName: size by its type argument, the others with
    // their arguments visited first; one the runtime runs (DoRuntimeNameOf) has that
    // routine as its ResolvedCallee (the intrinsic stays its callee's ResolvedDecl)
    hidden method DoIntrinsic(const AId: int64; const AName: string);
    begin
      if AName = "size" then
        self.DoSizeOf(AId);
        return;
      end;
      if AName = ADAM_CTHUNK_NAME then
        self.DoCThunk(AId);
        return;
      end;
      self.DoVisitArguments(AId);
      if self.DoRuntimeNameOf(AName) <> "" then
        self.FTree[AId].ResolvedCallee := self.DoRuntimeRoutine(self.DoRuntimeNameOf(AName));
      end;
      if DoIsStatementIntrinsic(AName) then
        self.DoStatementIntrinsic(AId, AName);
        return;
      end;
      self.DoValueIntrinsic(AId, AName);
    end;

    // A call (BNF sec 6): of an intrinsic, of a type (a cast), of a routine or a method,
    // or of a value of a routine type (its signature's checks); any other value SM0400
    hidden method DoCall(const AId: int64);
    var
      LCallee: int64;
      LPart: int64;
      LDecl: int64;
      LKind: NodeKind;
      LType: int64;
    begin
      LCallee := self.FTree.FirstOf(AId, NodeRole.Callee);
      LPart := self.DoLeadOf(AId);
      if LPart <> 0 then
        self.DoLeadCall(AId, LPart);
        return;
      end;
      if self.DoPackCall(AId, LCallee) then
        return;
      end;
      if (self.FTree[LCallee].Kind = NodeKind.MemberExpression) and
        (self.FTree[LCallee].ResolvedDecl = 0) and (self.FTree[LCallee].ResolvedUnit = 0) then
        // A member callee is resolved by its own visit (a method, a field of routine type)
        self.DoVisit(LCallee);
      end;
      LDecl := self.DoCalleeDecl(LCallee);
      if LDecl <> 0 then
        LKind := self.FTree[LDecl].Kind;
        if LKind = NodeKind.IntrinsicDecl then
          self.DoFirstVisit(LCallee);
          self.DoIntrinsic(AId, self.FTree[LDecl].Text);
          return;
        end;
        if DoIsTypeDecl(LKind) then
          self.DoFirstVisit(LCallee);
          self.DoCastCall(AId, DeclaredTypeOf(self.FTree, LDecl), self.DoExprText(LCallee));
          return;
        end;
        if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
          (LKind = NodeKind.MethodDecl) then
          self.DoFirstVisit(LCallee);
          self.DoRoutineCall(AId, LCallee, LDecl);
          self.DoGeneratorReceiver(LCallee);
          return;
        end;
      end;
      self.DoVisit(LCallee);
      if self.DoLost(LCallee) then
        self.DoVisitArguments(AId);
        return;
      end;
      LType := self.DoTypeOf(LCallee);
      // a routine value's call, a closure's (F2a: through its code, its environment passed)
      if (self.DoClass(LType) = TypeClass.RoutineType) or (self.DoClass(LType) = TypeClass.ClosureType) then
        self.DoArguments(AId, self.FTree[LType].ResolvedDecl, self.DoNamingSignature(LCallee),
          self.DoExprText(LCallee));
        self.DoSetType(AId, TargetOf(self.FTree, LType));
        return;
      end;
      self.DoVisitArguments(AId);
      self.DoError(AId, ADAM_ERR_SEMANTICS_400, ADAM_MSG_SEMANTICS_NOT_CALLABLE,
        NoArgs().Str(self.DoExprText(LCallee)).Str(self.DoText(LType)));
    end;

    // A type cast T(x) on a builtin type word (BNF sec 6); extra arguments (PR0041) are
    // visited
    hidden method DoTypeCast(const AId: int64);
    var
      LType: int64;
      LOperand: int64;
    begin
      LType := CanonicalOf(self.FTree, self.FTree.FirstOf(AId, NodeRole.TypeOf));
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      self.DoVisitArguments(AId);
      self.DoSetType(AId, LType);
      self.DoCastValue(LOperand, LType);
    end;

    // A pointer cast ptr to [const] T(x) (BNF sec 6): a pointer that keeps const, an
    // integer of pointer width, a string literal into a ptr to const char / wchar / 8-bit
    // integer; SM0265
    // otherwise (a const drop, a float, a narrower integer, nil)
    hidden method DoPointerCast(const AId: int64);
    var
      LType: int64;
      LOperand: int64;
      LFrom: int64;
    begin
      LType := CanonicalOf(self.FTree, self.FTree.FirstOf(AId, NodeRole.TypeOf));
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      self.DoVisitArguments(AId);
      self.DoSetType(AId, LType);
      if (LType = 0) or self.DoLost(LOperand) then
        return;
      end;
      if self.DoLiteralTakes(self.DoSkipParens(LOperand), LType) then
        self.FTree[LOperand].ResolvedConvert := LType;
        return;
      end;
      LFrom := self.DoTypeOf(LOperand);
      if self.DoPointerCastTakes(LFrom, LType) then
        return;
      end;
      self.DoError(LOperand, ADAM_ERR_SEMANTICS_265, ADAM_MSG_SEMANTICS_NO_POINTER_CAST,
        NoArgs().Str(self.DoText(LFrom)).Str(self.DoText(LType)));
    end;

    // True when no object is both an AFirst and an ASecond (SM0273): neither is an
    // ancestor of the other and they are two objects (two branches of one chain), or one
    // is an interface the other, a final object, does not implement. Two interfaces may
    // meet in one object
    hidden const method DoNeverBoth(const AFirst: int64; const ASecond: int64): bool;
    var
      LFirstClass: TypeClass;
      LSecondClass: TypeClass;
    begin
      if (AFirst = ASecond) or IsAncestorOf(self.FTree, AFirst, ASecond) or
        IsAncestorOf(self.FTree, ASecond, AFirst) then
        return false;
      end;
      LFirstClass := self.DoClass(AFirst);
      LSecondClass := self.DoClass(ASecond);
      if (LFirstClass = TypeClass.ObjectType) and (LSecondClass = TypeClass.ObjectType) then
        return true;
      end;
      if LFirstClass = TypeClass.ObjectType then
        return IsFinalType(self.FTree, AFirst);
      end;
      if LSecondClass = TypeClass.ObjectType then
        return IsFinalType(self.FTree, ASecond);
      end;
      return false;
    end;

    // True when the object value AExpr may hold a descendant of its type (BNF sec 6, is /
    // as): a var or const parameter, a deref, P[i] on a pointer, self, parent, X as T.
    // A variable, a field, an element, a call's result holds exactly its type
    hidden const method DoMayHoldDescendant(const AExpr: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      LKind := self.FTree[LAt].Kind;
      if (LKind = NodeKind.SelfExpression) or (LKind = NodeKind.ParentExpression) or
        (LKind = NodeKind.AsExpression) then
        return true;
      end;
      if (LKind = NodeKind.UnaryExpression) and (self.FTree[LAt].Op = OperatorKind.Deref) then
        return true;
      end;
      if (LKind = NodeKind.PostfixExpression) and (self.FTree[LAt].Op = OperatorKind.Deref) then
        return true;
      end;
      if LKind = NodeKind.IndexExpression then
        return IsPointerClass(self.DoClass(self.DoTypeOf(self.FTree.FirstOf(LAt, NodeRole.Operand))));
      end;
      if LKind = NodeKind.NameExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        return (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.Param) and
          (self.FTree[LDecl].HasFlag(NodeFlag.VarParam) or self.FTree[LDecl].HasFlag(NodeFlag.ConstParam));
      end;
      return false;
    end;

    // X is T (a bool) / X as T (BNF sec 6): X a polymorphic object or a ptr to / own / ref
    // of one (SM0271; a weak: SM0275), T an object or an interface type (SM0272); a test
    // no object passes is SM0273 (no object is both types) or SM0274 (X holds exactly its
    // own type). as keeps X's kind: an object -> the object as T, ptr to S -> ptr to T,
    // ref S -> ref T, own S -> the object it holds as T
    hidden method DoIsAs(const AId: int64);
    var
      LOperand: int64;
      LTypeNode: int64;
      LType: int64;
      LFrom: int64;
      LHeld: int64;
      LClass: TypeClass;
      LIs: bool;
      LWord: string;
      LOperandText: string;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      LTypeNode := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      LType := CanonicalOf(self.FTree, LTypeNode);
      LIs := self.FTree[AId].Kind = NodeKind.IsExpression;
      LWord := "as";
      if LIs then
        LWord := "is";
        self.DoSetType(AId, self.DoBuiltin("bool"));
      end;
      if LType = 0 then
        return;
      end;
      if (self.DoClass(LType) <> TypeClass.ObjectType) and (self.DoClass(LType) <> TypeClass.InterfaceType) then
        self.DoError(LTypeNode, ADAM_ERR_SEMANTICS_272, ADAM_MSG_SEMANTICS_TEST_TARGET,
          NoArgs().Str(LWord).Str(self.DoText(LType)).Str(self.DoText(LType)));
        return;
      end;
      if not LIs then
        // The result's type stands even when the test below is refused: what uses it is
        // checked against it
        self.DoSetType(AId, LType);
      end;
      if self.DoLost(LOperand) then
        return;
      end;
      LFrom := self.DoTypeOf(LOperand);
      LClass := self.DoClass(LFrom);
      LOperandText := self.DoExprText(LOperand);
      if LClass = TypeClass.WeakType then
        self.DoError(LOperand, ADAM_ERR_SEMANTICS_275, ADAM_MSG_SEMANTICS_TEST_WEAK,
          NoArgs().Str(LOperandText).Str(LOperandText));
        return;
      end;
      LHeld := LFrom;
      if (LClass = TypeClass.Pointer) or (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
        LHeld := TargetOf(self.FTree, LFrom);
      end;
      if not IsPolymorphic(self.FTree, LHeld) then
        self.DoError(LOperand, ADAM_ERR_SEMANTICS_271, ADAM_MSG_SEMANTICS_TEST_OPERAND,
          NoArgs().Str(LOperandText).Str(LOperandText).Str(self.DoText(LFrom)));
        return;
      end;
      if self.DoNeverBoth(LHeld, LType) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_273, ADAM_MSG_SEMANTICS_TEST_NEVER,
          NoArgs().Str(LOperandText + " " + LWord + " " + self.DoText(LType)).Str(
          self.DoText(LHeld)).Str(self.DoText(LType)));
        return;
      end;
      if (LHeld = LFrom) and (LHeld <> LType) and (not IsAncestorOf(self.FTree, LType, LHeld)) and
        (not self.DoMayHoldDescendant(LOperand)) then
        self.DoError(LOperand, ADAM_ERR_SEMANTICS_274, ADAM_MSG_SEMANTICS_TEST_EXACT,
          NoArgs().Str(LOperandText).Str(self.DoText(LHeld)).Str(self.DoText(LType)));
        return;
      end;
      if LIs then
        return;
      end;
      if LClass = TypeClass.Pointer then
        self.DoSetType(AId, PointerTo(self.FTree, LType, IsConstTarget(self.FTree, LFrom)));
      end;
      if LClass = TypeClass.RefType then
        self.DoSetType(AId, OwnerOf(self.FTree, NodeKind.RefType, LType));
      end;
    end;

    // own / ref / weak T(...): an own / ref / weak T (BNF sec 6). T is an object
    // (SM0358); a weak builds nothing (SM0359); an own / ref builds T with one of its inits
    // (DoBuild)
    hidden method DoOwnerNew(const AId: int64);
    var
      LTypeNode: int64;
      LType: int64;
      LKind: NodeKind;
      LWord: string;
    begin
      LTypeNode := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      LType := CanonicalOf(self.FTree, LTypeNode);
      self.DoVisitArguments(AId);
      if LType = 0 then
        return;
      end;
      LWord := "own ";
      if self.FTree[AId].Kind = NodeKind.RefNew then
        LWord := "ref ";
      end;
      if self.FTree[AId].Kind = NodeKind.WeakNew then
        LWord := "weak ";
      end;
      if (self.DoClass(LType) <> TypeClass.ObjectType) and (self.DoClass(LType) <> TypeClass.InterfaceType) then
        self.DoError(LTypeNode, ADAM_ERR_SEMANTICS_358, ADAM_MSG_SEMANTICS_OWNER_TARGET,
          NoArgs().Str(LWord + self.DoText(LType)).Str(self.DoText(LType)));
        return;
      end;
      if self.FTree[AId].Kind = NodeKind.WeakNew then
        self.DoError(AId, ADAM_ERR_SEMANTICS_359, ADAM_MSG_SEMANTICS_WEAK_NEW,
          NoArgs().Str(LWord + self.DoText(LType)).Str(self.DoText(LType)));
        return;
      end;
      self.DoBuild(AId, NodeRole.Argument, LType, LTypeNode, false);
      LKind := NodeKind.WeakType;
      if self.FTree[AId].Kind = NodeKind.OwnNew then
        LKind := NodeKind.OwnType;
      end;
      if self.FTree[AId].Kind = NodeKind.RefNew then
        LKind := NodeKind.RefType;
      end;
      self.DoSetType(AId, OwnerOf(self.FTree, LKind, LType));
    end;

    // varargs.count (int32), next(T) / get(I, T) (a T; I an int32), copy() (varargs),
    // reset() (no value), kind(I) (a VarKind: DoPackKind), clist() (a ptr: the C va_list).
    // Only inside a variadic routine (SM0417); in a clink one (by meaning:
    // Types.IsCppSignature) only next and clist (SM0418, BNF sec 6: a C caller passes no
    // types or count), clist only there (SM0434: a cpplink pack is no C va_list). The type is
    // set either way, so the uses around it check as written
    hidden method DoVarargs(const AId: int64);
    var
      LMember: string;
      LRoutine: int64;
    begin
      LMember := self.FTree[AId].Text;
      self.DoVisitArguments(AId);
      LRoutine := self.DoEnclosingRoutine(AId);
      // a func literal's closure may run after its routine's varargs are gone (F2a)
      if (LRoutine <> 0) and self.FTree[LRoutine].HasFlag(NodeFlag.Variadic) and
        (self.DoEnclosingBody(AId) <> LRoutine) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_756, ADAM_MSG_SEMANTICS_CLOSURE_VARARGS, NoArgs());
      end;
      if (LRoutine = 0) or not self.FTree[LRoutine].HasFlag(NodeFlag.Variadic) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_417, ADAM_MSG_SEMANTICS_VARARGS_OUTSIDE, NoArgs());
      else
        if IsCppSignature(self.FTree, LRoutine) then
          if LMember = "clist" then
            self.DoError(AId, ADAM_ERR_SEMANTICS_434, ADAM_MSG_SEMANTICS_VARARGS_CLIST, NoArgs());
          end;
        else
          if (LMember <> "next") and (LMember <> "clist") then
            self.DoError(AId, ADAM_ERR_SEMANTICS_418, ADAM_MSG_SEMANTICS_VARARGS_CLINK,
              NoArgs().Str(LMember));
          end;
        end;
      end;
      if LMember = "count" then
        self.DoSetType(AId, self.DoBuiltin("int32"));
        return;
      end;
      if (LMember = "next") or (LMember = "get") then
        if LMember = "get" then
          self.DoConvert(self.FTree.FirstOf(AId, NodeRole.Argument), self.DoBuiltin("int32"));
        end;
        self.DoSetType(AId, CanonicalOf(self.FTree, self.FTree.FirstOf(AId, NodeRole.TypeOf)));
        // a C caller passes plain values: a string comes as its C text (CV1)
        if (LMember = "next") and (LRoutine <> 0) and self.FTree[LRoutine].HasFlag(NodeFlag.Variadic) and
          (not IsCppSignature(self.FTree, LRoutine)) and
          (not self.DoIsCVariadicType(self.FTree[AId].ResolvedType)) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_766, ADAM_MSG_SEMANTICS_C_VARIADIC_NEXT,
            NoArgs().Str(self.DoText(self.FTree[AId].ResolvedType)));
        end;
        return;
      end;
      if LMember = "copy" then
        self.DoSetType(AId, self.DoBuiltin("varargs"));
        return;
      end;
      if LMember = "clist" then
        self.DoSetType(AId, self.DoBuiltin("ptr"));
        return;
      end;
      if LMember = "kind" then
        self.DoPackKind(AId, self.FTree.FirstOf(AId, NodeRole.Argument));
      end;
    end;

    // True when the operand AOperand of a member access is a value of type varargs (a
    // varargs local: BNF sec 6, the members of a pack); a module's or a type's name is
    // none. AOperand is visited
    hidden method DoIsPackOperand(const AOperand: int64): bool;
    begin
      if (self.FTree[AOperand].ResolvedUnit <> 0) or (self.DoTypeNamed(AOperand) <> 0) then
        return false;
      end;
      self.DoVisit(AOperand);
      if self.DoLost(AOperand) then
        return false;
      end;
      return self.DoClass(self.DoTypeOf(AOperand)) = TypeClass.Varargs;
    end;

    // The member AId of a varargs local that is no call: count (an int32); any other name
    // SM0009 (next / get / reset / copy are called: DoPackCall)
    hidden method DoPackMember(const AId: int64);
    begin
      if self.FTree[AId].Text = "count" then
        self.DoSetType(AId, self.DoBuiltin("int32"));
        return;
      end;
      self.DoErrorName(AId, ADAM_ERR_SEMANTICS_009, ADAM_MSG_SEMANTICS_NO_MEMBER,
        NoArgs().Str("varargs").Str(self.FTree[AId].Text));
    end;

    // The type the argument AArg of next / get names: a type expression's canonical type,
    // a name of a type (BNF sec 6 type arg); 0 after SM0013 for anything else
    hidden method DoPackType(const AArg: int64): int64;
    var
      LNamed: int64;
    begin
      if DoIsTypeExpression(self.FTree[AArg].Kind) then
        self.DoVisit(AArg);
        return CanonicalOf(self.FTree, AArg);
      end;
      LNamed := self.DoTypeNamed(AArg);
      if LNamed <> 0 then
        self.DoFirstVisit(AArg);
        return LNamed;
      end;
      self.DoVisit(AArg);
      if not self.DoLost(AArg) then
        self.DoError(AArg, ADAM_ERR_SEMANTICS_013, ADAM_MSG_SEMANTICS_NOT_TYPE,
          NoArgs().Str(self.DoExprText(AArg)));
      end;
      return 0;
    end;

    // True when the call AId of ACallee reads a varargs local (BNF sec 6, the members of a
    // pack, user 2026-11-06: SEM decides by the receiver's type): next(T) a T, get(I, T) a
    // T with I an int32, reset() no value, copy() a varargs, kind(I) a VarKind; each with
    // its own argument count (SM0401). False for any other call (the callee is left to
    // DoCall)
    hidden method DoPackCall(const AId: int64; const ACallee: int64): bool;
    var
      LWord: string;
      LCount: int64;
      LWant: int64;
      LType: int64;
    begin
      if (self.FTree[ACallee].Kind <> NodeKind.MemberExpression) or
        (self.FTree[ACallee].ResolvedDecl <> 0) or (self.FTree[ACallee].ResolvedUnit <> 0) then
        return false;
      end;
      LWord := self.FTree[ACallee].Text;
      if (LWord <> "next") and (LWord <> "get") and (LWord <> "reset") and (LWord <> "copy") and
        (LWord <> "kind") then
        return false;
      end;
      if not self.DoIsPackOperand(self.FTree.FirstOf(ACallee, NodeRole.Operand)) then
        return false;
      end;
      // The callee is the member word itself: no member access of its own to check
      self.DoFirstVisit(ACallee);
      LCount := self.FTree.CountOf(AId, NodeRole.Argument);
      LWant := 0;
      if (LWord = "next") or (LWord = "kind") then
        LWant := 1;
      end;
      if LWord = "get" then
        LWant := 2;
      end;
      if LCount <> LWant then
        self.DoVisitArguments(AId);
        self.DoError(AId, ADAM_ERR_SEMANTICS_401, ADAM_MSG_SEMANTICS_ARG_COUNT,
          NoArgs().Str(self.DoExprText(ACallee)).Int(LWant).Int(LCount));
        return true;
      end;
      if LWord = "copy" then
        self.DoSetType(AId, self.DoBuiltin("varargs"));
        return true;
      end;
      if LWord = "reset" then
        return true;
      end;
      if LWord = "kind" then
        self.DoVisit(self.FTree.FirstOf(AId, NodeRole.Argument));
        self.DoPackKind(AId, self.FTree.FirstOf(AId, NodeRole.Argument));
        return true;
      end;
      if LWord = "get" then
        self.DoVisit(self.FTree.FirstOf(AId, NodeRole.Argument));
        self.DoConvert(self.FTree.FirstOf(AId, NodeRole.Argument), self.DoBuiltin("int32"));
      end;
      LType := self.DoPackType(self.FTree.NthOf(AId, NodeRole.Argument, LWant - 1));
      if LType <> 0 then
        self.DoSetType(AId, LType);
      end;
      return true;
    end;

    // True when AExpr (through parentheses) is a pack's copy: varargs.copy() or copy() of
    // a varargs local (SM0422 takes nothing else into one)
    hidden const method DoIsVarargsCopy(const AExpr: int64): bool;
    var
      LAt: int64;
      LCallee: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      if self.FTree[LAt].Kind = NodeKind.VarargsExpression then
        return self.FTree[LAt].Text = "copy";
      end;
      if self.FTree[LAt].Kind <> NodeKind.CallExpression then
        return false;
      end;
      LCallee := self.FTree.FirstOf(LAt, NodeRole.Callee);
      return (self.FTree[LCallee].Kind = NodeKind.MemberExpression) and
        (self.FTree[LCallee].Text = "copy") and
        (self.DoClass(self.DoTypeOf(self.FTree.FirstOf(LCallee, NodeRole.Operand))) = TypeClass.Varargs);
    end;

    // The value ASource stored into a place of the canonical type AType (an initializer, an
    // assignment): into a varargs local only a pack's copy (SM0422, BNF sec 4 / 6)
    hidden method DoPackSource(const ASource: int64; const AType: int64);
    begin
      if (self.DoClass(AType) = TypeClass.Varargs) and not self.DoLost(ASource) and
        not self.DoIsVarargsCopy(ASource) then
        self.DoError(ASource, ADAM_ERR_SEMANTICS_422, ADAM_MSG_SEMANTICS_VARARGS_TYPE, NoArgs());
      end;
    end;

    // The varargs type expression AId (BNF sec 4: only the type of a variadic routine's
    // local; in a clink one it can never be set, its copy() being SM0418) anywhere else is
    // SM0422: a parameter, a field, a module variable, a result, a part of another type
    hidden method DoVarargsTypeAt(const AId: int64);
    var
      LDecl: int64;
      LRoutine: int64;
    begin
      LDecl := self.FTree.ParentOf(AId);
      if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.VarDecl) and
        (self.FTree.FirstOf(LDecl, NodeRole.TypeOf) = AId) then
        LRoutine := self.FTree.ParentOf(LDecl);
        if (LRoutine <> 0) and ((self.FTree[LRoutine].Kind = NodeKind.RoutineDecl) or
          (self.FTree[LRoutine].Kind = NodeKind.MethodDecl)) and
          self.FTree[LRoutine].HasFlag(NodeFlag.Variadic) then
          return;
        end;
      end;
      self.DoError(AId, ADAM_ERR_SEMANTICS_422, ADAM_MSG_SEMANTICS_VARARGS_TYPE, NoArgs());
    end;

    // The parent level of the record type AType that declares its field AField: 0 its own,
    // 1 its parent's, ... (a parent's fields come first in its layout)
    hidden const method DoFieldLevel(const AType: int64; const AField: int64): int64;
    var
      LAt: int64;
      LDepth: int64;
    begin
      LAt := AType;
      LDepth := 0;
      while LAt <> 0 do
        if MemberOf(self.FTree, LAt, self.FTree[AField].Text) <> AField then
          return LDepth - 1;
        end;
        LAt := ParentTypeOf(self.FTree, LAt);
        LDepth := LDepth + 1;
      end;
      return LDepth - 1;
    end;

    // True when the field AFirst of the record type AType comes before its field ASecond in
    // their declared order (the parent's fields first, then each level's in source order)
    hidden const method DoFieldBefore(const AType: int64; const AFirst: int64; const ASecond: int64): bool;
    var
      LFirstLevel: int64;
      LSecondLevel: int64;
    begin
      LFirstLevel := self.DoFieldLevel(AType, AFirst);
      LSecondLevel := self.DoFieldLevel(AType, ASecond);
      if LFirstLevel <> LSecondLevel then
        return LFirstLevel > LSecondLevel;
      end;
      return self.FTree[AFirst].StartOffset < self.FTree[ASecond].StartOffset;
    end;

    // The variable whose hidden holder keeps the texts the record literal ALiteral's C
    // string fields borrow (F4b, BNF sec 6): the literal, through parentheses, a field
    // init's value of an outer record literal or an element of a static array literal (the
    // outermost such literal's place), assigned whole (:=) to a place DoHoldRoot gives, or
    // the initializer of a variable DoHoldsDecl takes; 0 for any other place
    hidden const method DoLiteralRoot(const ALiteral: int64): int64;
    var
      LAt: int64;
      LParent: int64;
      LKind: NodeKind;
      LRole: NodeRole;
    begin
      // a dynamic array's literal is a block of its own: nothing a variable's holder keeps
      if (self.FTree[ALiteral].Kind = NodeKind.ArrayLiteral) and
        (self.DoClass(self.DoTypeOf(ALiteral)) <> TypeClass.StaticArray) then
        return 0;
      end;
      LAt := ALiteral;
      while true do
        LParent := self.FTree.ParentOf(LAt);
        while (LParent <> 0) and (self.FTree[LParent].Kind = NodeKind.ParenExpression) do
          LAt := LParent;
          LParent := self.FTree.ParentOf(LAt);
        end;
        if LParent = 0 then
          return 0;
        end;
        LKind := self.FTree[LParent].Kind;
        LRole := self.FTree.RoleOf(LAt);
        if (LKind = NodeKind.FieldInit) and (LRole = NodeRole.Value) and
          (self.FTree[self.FTree.ParentOf(LParent)].Kind = NodeKind.RecordLiteral) then
          LAt := self.FTree.ParentOf(LParent);
          skip;
        end;
        if (LRole = NodeRole.LowBound) and (self.FTree.FirstOf(LParent, NodeRole.HighBound) = 0) and
          (self.FTree[self.FTree.ParentOf(LParent)].Kind = NodeKind.ArrayLiteral) and
          (self.DoClass(self.DoTypeOf(self.FTree.ParentOf(LParent))) = TypeClass.StaticArray) then
          LAt := self.FTree.ParentOf(LParent);
          skip;
        end;
        if (LKind = NodeKind.AssignExpression) and (LRole = NodeRole.Source) and
          (self.FTree[LParent].Op = OperatorKind.Assign) then
          return self.DoHoldRoot(self.FTree.FirstOf(LParent, NodeRole.Target), false);
        end;
        if (LKind = NodeKind.VarDecl) and (LRole = NodeRole.Initializer) and self.DoHoldsDecl(LParent, LParent) then
          return LParent;
        end;
        return 0;
      end;
    end;

    // The place the literal's value AValue goes, as SM0759 names it (F4b): its record
    // literal's type and field (`Config.Title`), or its array literal and index
    hidden const method DoLiteralPlace(const AValue: int64): string;
    var
      LItem: int64;
      LLiteral: int64;
      LI: int64;
    begin
      LItem := self.FTree.ParentOf(AValue);
      LLiteral := self.FTree.ParentOf(LItem);
      if self.FTree[LItem].Kind = NodeKind.FieldInit then
        return self.DoText(self.FTree[LLiteral].ResolvedType) + "." + self.FTree[LItem].Text;
      end;
      for LI := 0 to self.FTree.CountOf(LLiteral, NodeRole.Element) - 1 do
        if self.FTree.NthOf(LLiteral, NodeRole.Element, LI) = LItem then
          return "[...][" + IntToStr(LI) + "]";
        end;
      end;
      return self.DoExprText(AValue);
    end;
    // The value AValue of a field of the record literal ALiteral (or an element of the
    // array literal ALiteral), of type AType (F4b, BNF sec 6): a string of no constant text
    // (DoTextArgTakes) into a C string field is borrowed (Lowering's DoFieldText) and kept
    // by the holder of the variable the literal goes into: DoCTextHolds finds it
    // (DoLiteralRoot, once every type is known) and makes its holder, else SM0759 naming
    // CString. True when the value was taken here (no conversion left to check)
    hidden method DoLiteralCText(const ALiteral: int64; const AValue: int64; const AType: int64): bool;
    begin
      if (AValue = 0) or (AType = 0) or not IsCTextPointer(self.FTree, AType) or
        not self.DoTextArgTakes(AValue, AType) then
        return false;
      end;
      self.FTree[AValue].ResolvedConvert := AType;
      self.FHoldLiterals.Add(AValue);
      return true;
    end;
    // T(F: v, ...): a record type (SM0413); each field one of its fields (SM0414), given
    // once (SM0415) and in their declared order (SM0416 at one given after a later one), its
    // value converting to the field's type (a constant for a bitfield fitting its width:
    // DoBitStore); a T
    hidden method DoRecordLiteral(const AId: int64);
    var
      LTypeNode: int64;
      LType: int64;
      LI: int64;
      LJ: int64;
      LInit: int64;
      LName: string;
      LField: int64;
      LValue: int64;
      LTwice: bool;
      LLast: int64;
    begin
      LTypeNode := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      LType := CanonicalOf(self.FTree, LTypeNode);
      self.DoSetType(AId, LType);
      self.DoVisitArguments(AId);
      if LType = 0 then
        return;
      end;
      if self.DoClass(LType) <> TypeClass.RecordType then
        self.DoError(LTypeNode, ADAM_ERR_SEMANTICS_413, ADAM_MSG_SEMANTICS_RECORD_KIND,
          NoArgs().Str(self.DoText(LType)));
        return;
      end;
      // LLast: the latest field given so far in declared order (0: none yet)
      LLast := 0;
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        LInit := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        LName := self.FTree[LInit].Text;
        LTwice := false;
        for LJ := 0 to LI - 1 do
          if self.FTree[self.FTree.NthOf(AId, NodeRole.Argument, LJ)].Text = LName then
            LTwice := true;
          end;
        end;
        LField := MemberOf(self.FTree, LType, LName);
        if LTwice then
          self.DoError(LInit, ADAM_ERR_SEMANTICS_415, ADAM_MSG_SEMANTICS_RECORD_TWICE,
            NoArgs().Str(LName));
        else
          if (LField = 0) or (self.FTree[LField].Kind <> NodeKind.FieldDecl) then
            self.DoError(LInit, ADAM_ERR_SEMANTICS_414, ADAM_MSG_SEMANTICS_RECORD_NO_FIELD,
              NoArgs().Str(self.DoText(LType)).Str(LName));
          else
            if (LLast <> 0) and self.DoFieldBefore(LType, LField, LLast) then
              self.DoError(LInit, ADAM_ERR_SEMANTICS_416, ADAM_MSG_SEMANTICS_RECORD_ORDER,
                NoArgs().Str(LName).Str(self.FTree[LLast].Text).Str(self.DoText(LType)));
            else
              LLast := LField;
            end;
            self.FTree[LInit].ResolvedDecl := LField;
            LValue := self.FTree.FirstOf(LInit, NodeRole.Value);
            if not self.DoLiteralCText(AId, LValue, self.DoDeclType(LField)) and
              self.DoConvert(LValue, self.DoDeclType(LField)) and
              (self.FTree.FirstOf(LField, NodeRole.BitWidth) <> 0) then
              self.DoBitStore(LField, LValue);
            end;
          end;
        end;
      end;
    end;

    // An expression (BNF sec 6), by its kind: its type into ResolvedType
    hidden method DoExpression(const AId: int64);
    begin
      match self.FTree[AId].Kind of
        NodeKind.IntLiteral: self.DoIntLiteral(AId);
        NodeKind.FloatLiteral: self.DoFloatLiteral(AId);
        NodeKind.StringLiteral: self.DoSetType(AId, self.DoBuiltin("string"));
        NodeKind.CharLiteral: self.DoSetType(AId, self.DoBuiltin("char"));
        NodeKind.BoolLiteral: self.DoSetType(AId, self.DoBuiltin("bool"));
        NodeKind.NilLiteral: self.DoSetType(AId, NilTypeOf(self.FTree));
        NodeKind.NameExpression: self.DoName(AId);
        NodeKind.ParenExpression: self.DoParen(AId);
        NodeKind.SelfExpression, NodeKind.ParentExpression: self.DoSelf(AId);
        NodeKind.UnaryExpression: self.DoUnary(AId);
        NodeKind.PostfixExpression: self.DoPostfix(AId);
        NodeKind.BinaryExpression: self.DoBinary(AId);
        NodeKind.AssignExpression: self.DoAssign(AId);
        NodeKind.ConditionalExpression: self.DoConditional(AId);
        NodeKind.CallExpression: self.DoCall(AId);
        NodeKind.IndexExpression: self.DoIndex(AId);
        NodeKind.MemberExpression: self.DoMember(AId);
        NodeKind.TypeCast: self.DoTypeCast(AId);
        NodeKind.PointerCast: self.DoPointerCast(AId);
        NodeKind.IsExpression, NodeKind.AsExpression: self.DoIsAs(AId);
        NodeKind.OwnNew, NodeKind.RefNew, NodeKind.WeakNew: self.DoOwnerNew(AId);
        NodeKind.VarargsExpression: self.DoVarargs(AId);
        NodeKind.RecordLiteral: self.DoRecordLiteral(AId);
        NodeKind.AsyncExpression: self.DoAsync(AId);
        NodeKind.AwaitExpression: self.DoAwait(AId);
        NodeKind.FuncLiteral: self.DoFuncLiteral(AId);
      else
        // a set literal takes its type where it goes (DoConvert); its items are typed
        self.DoChildren(AId);
      end;
    end;

    // The signature node a call's callee ACallee runs (BNF sec 6 async: the routine it
    // names, a forward's full declaration, a method; a routine value's or a closure's type's
    // signature);
    // 0 for any other callee (an intrinsic, a cast's type)
    hidden method DoAsyncSignature(const ACallee: int64): int64;
    var
      LDecl: int64;
      LKind: NodeKind;
      LType: int64;
    begin
      LDecl := self.DoCalleeDecl(ACallee);
      if LDecl <> 0 then
        LKind := self.FTree[LDecl].Kind;
        if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
          (LKind = NodeKind.MethodDecl) then
          return LDecl;
        end;
      end;
      LType := self.DoTypeOf(ACallee);
      // a closure's too (F2a, user 2026-11-23): the task holds the closure, so its
      // environment lives until the task ends
      if (self.DoClass(LType) = TypeClass.RoutineType) or (self.DoClass(LType) = TypeClass.ClosureType) then
        return self.FTree[LType].ResolvedDecl;
      end;
      return 0;
    end;

    // async F(..) (BNF sec 6): its operand a call of a routine (a routine's name, a method,
    // a routine value: else SM0701), passing no var parameter (SM0702: the caller's place
    // may be gone before the call ends), a method's run on an object the task cannot
    // outlive (SM0708: DoAsyncReceiverLost); a task T, T the call's result type, plain task
    // for a call with none
    hidden method DoAsync(const AId: int64);
    var
      LCall: int64;
      LCallee: int64;
      LSignature: int64;
      LNames: int64;
      LParam: int64;
      LArgument: int64;
      LRoot: int64;
      LI: int64;
    begin
      if self.FTree.FirstOf(AId, NodeRole.Body) <> 0 then
        self.DoAsyncBlock(AId);
        return;
      end;
      LCall := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LCall);
      if (LCall = 0) or (self.FTree[LCall].Kind <> NodeKind.CallExpression) then
        if (LCall <> 0) and (not self.FTree[LCall].HasFlag(NodeFlag.Recovered)) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_701, ADAM_MSG_SEMANTICS_ASYNC_CALL,
            NoArgs().Str(self.DoExprText(LCall)));
        end;
        return;
      end;
      LCallee := self.FTree.FirstOf(LCall, NodeRole.Callee);
      LSignature := self.DoAsyncSignature(LCallee);
      if LSignature = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_701, ADAM_MSG_SEMANTICS_ASYNC_CALL,
          NoArgs().Str(self.DoExprText(LCall)));
        return;
      end;
      // A routine value's type names no parameter: its written type does (DoNamingSignature)
      LNames := LSignature;
      if self.FTree.ParentOf(LSignature) = ADAM_AST_DERIVED then
        LNames := self.DoNamingSignature(LCallee);
      end;
      for LI := 0 to self.FTree.CountOf(LSignature, NodeRole.Param) - 1 do
        LParam := self.FTree.NthOf(LSignature, NodeRole.Param, LI);
        if self.FTree[LParam].HasFlag(NodeFlag.VarParam) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_702, ADAM_MSG_SEMANTICS_ASYNC_VAR,
            NoArgs().Str(self.DoParamName(LNames, LI)));
          return;
        end;
      end;
      if self.DoAsyncReceiverLost(LCallee) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_708, ADAM_MSG_SEMANTICS_ASYNC_RECEIVER,
          NoArgs().Str(self.FTree[self.FTree[LCallee].ResolvedDecl].Text).Str(
          self.DoExprText(self.FTree.FirstOf(LCallee, NodeRole.Operand))));
        return;
      end;
      // the task's copy of a variable whose C string fields hold borrowed strings carries
      // the holder's texts (F4b, BNF sec 6: Lowering's DoTaskHolds), the variable noted on
      // its argument
      for LI := 0 to self.FTree.CountOf(LSignature, NodeRole.Param) - 1 do
        if LI >= self.FTree.CountOf(LCall, NodeRole.Argument) then
          leave;
        end;
        LParam := self.FTree.NthOf(LSignature, NodeRole.Param, LI);
        LArgument := self.FTree.NthOf(LCall, NodeRole.Argument, LI);
        if HoldsCText(self.FTree, VariableTypeOf(self.FTree, LParam)) then
          LRoot := self.DoHoldRoot(LArgument, false);
          if LRoot <> 0 then
            self.FTree[self.DoSkipParens(LArgument)].ResolvedJump := LRoot;
          end;
        end;
      end;
      self.DoSetType(AId, TaskOf(self.FTree, self.DoTypeOf(LCall)));
    end;

    // The callee ACallee of a call of a generator method (G1c2; any other callee: nothing):
    // a receiver reached through a ref (not a ptr's `->`) is held by the generator; any
    // other (a value, self, parent, an own's or a ptr's object) is copied into it at the
    // call, so its type must copy (SM0427, DoCopyBlocker's hint) and, for a method that does
    // not dispatch, the receiver may not be a descendant of a polymorphic type (SM0428: the
    // copy at the method's type would keep only that part). A dispatched method (virtual,
    // override, abstract, an interface's) copies the object's own type in its ramp
    hidden method DoGeneratorReceiver(const ACallee: int64);
    var
      LDecl: int64;
      LOperand: int64;
      LType: int64;
      LOwner: int64;
      LDispatched: bool;
      LDescendant: bool;
      LBlocker: int64;
      LHolder: int64;
      LPart: int64;
    begin
      if self.FTree[ACallee].Kind <> NodeKind.MemberExpression then
        return;
      end;
      LDecl := self.FTree[ACallee].ResolvedDecl;
      // by its result (DoGeneratorElement): its declaration may be visited after this call
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.MethodDecl) or
        self.FTree[LDecl].HasFlag(NodeFlag.Static) or (self.DoGeneratorElement(LDecl) = 0) then
        return;
      end;
      LOperand := self.FTree.FirstOf(ACallee, NodeRole.Operand);
      LType := self.DoTypeOf(LOperand);
      if LType = 0 then
        return;
      end;
      LDescendant := self.DoMayBeDescendant(LOperand) or
        (self.FTree[self.DoSkipParens(LOperand)].Kind = NodeKind.ParentExpression);
      if self.FTree[ACallee].HasFlag(NodeFlag.Arrow) then
        LType := TargetOf(self.FTree, LType);
        LDescendant := true;
      else
        if self.DoClass(LType) = TypeClass.RefType then
          return;
        end;
        if self.DoClass(LType) = TypeClass.OwnType then
          LType := TargetOf(self.FTree, LType);
          LDescendant := true;
        end;
      end;
      if LType = 0 then
        return;
      end;
      LOwner := MethodOwnerOf(self.FTree, LDecl);
      LDispatched := self.FTree[LDecl].HasFlag(NodeFlag.Virtual) or self.FTree[LDecl].HasFlag(NodeFlag.Override) or
        self.FTree[LDecl].HasFlag(NodeFlag.Abstract) or
        ((LOwner <> 0) and (self.FTree[LOwner].Kind = NodeKind.InterfaceType));
      if (not LDispatched) and LDescendant and self.DoMaySlice(LType) then
        self.DoError(LOperand, ADAM_ERR_SEMANTICS_428, ADAM_MSG_SEMANTICS_SLICE_COPY,
          NoArgs().Str(self.DoExprText(LOperand)).Str(self.DoText(LType)).Str(self.DoText(LType)));
        return;
      end;
      LHolder := 0;
      LPart := 0;
      LBlocker := self.DoCopyBlocker(LType, LHolder, LPart);
      if LBlocker <> 0 then
        self.DoError(LOperand, ADAM_ERR_SEMANTICS_427, ADAM_MSG_SEMANTICS_VALUE_COPY,
          NoArgs().Str(self.DoExprText(LOperand)).Str(self.DoText(LType)));
        self.DoCopyHint(LBlocker, LHolder, LPart);
      end;
    end;

    // `async begin .. end` (BNF sec 6, T4): its block visited (a write to what it copies is
    // SM0714: DoAsyncCopy), then the variables, constants and parameters of its routine the
    // block names recorded (DoCaptures: each copied into the task at the async, the block
    // reads the copy, so the task may outlive the routine); a plain task
    hidden method DoAsyncBlock(const AId: int64);
    begin
      self.DoVisit(self.FTree.FirstOf(AId, NodeRole.Body));
      self.DoCaptures(AId);
      self.DoSetType(AId, TaskOf(self.FTree, 0));
    end;

    // A func literal AId (BNF sec 6, F2a): its parameters, result type and body typed (its
    // body a routine's own: a return returns from it, DoEnclosingBody; leave / skip reach no
    // loop outside it), no '...' (SM0754), its end path checked as a routine's
    // (DoReturnPath, DoMutexResult), then what it captures recorded (DoCaptures: by
    // reference, one environment per call of the frame that declares it); typed `ref
    // func(<its signature>)`. A plain func slot of its signature takes it when it captures
    // nothing (DoConvertArg)
    hidden method DoFuncLiteral(const AId: int64);
    begin
      self.DoChildren(AId);
      // one the parser recovered (no '(' or no 'begin', FL1): its PR0001 is the report; no
      // type, so nothing it meets reports it again
      if self.FTree[AId].HasFlag(NodeFlag.Recovered) then
        return;
      end;
      if self.FTree[AId].HasFlag(NodeFlag.Variadic) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_754, ADAM_MSG_SEMANTICS_LITERAL_VARIADIC, NoArgs());
        // refused: its closure type has no '...' (nothing more is reported of it)
        self.FTree[AId].RemoveFlag(NodeFlag.Variadic);
      end;
      self.DoReturnPath(AId);
      self.DoMutexResult(AId);
      self.DoRefOnlyResult(AId);
      self.DoCaptures(AId);
      self.DoSetType(AId, ClosureTypeOf(self.FTree, AId));
    end;

    // The closure the func literal ARoot (AExpr with its parentheses off) is goes to the plain
    // routine type ATarget (BNF sec 6, F2a: C++'s captureless lambda, a C callback): true,
    // ARoot and its parentheses retyped ATarget (Lowering writes the literal as a routine of
    // that linkage), when the signatures agree (SameClosureShape; else false: the caller's
    // SM0200) and it captures nothing (SM0757 naming its first capture otherwise)
    hidden method DoLiteralToRoutine(const AExpr: int64; const ARoot: int64; const ATarget: int64;
      var AFits: bool): bool;
    var
      LCapture: int64;
      LDecl: int64;
      LName: string;
      LAt: int64;
    begin
      AFits := false;
      if (self.FTree[ATarget].ResolvedDecl = 0) or TakesSelf(self.FTree, ATarget) or
        not SameClosureShape(self.FTree, ATarget, self.DoTypeOf(ARoot)) then
        return false;
      end;
      AFits := true;
      LCapture := self.FTree.FirstOf(ARoot, NodeRole.Capture);
      if LCapture <> 0 then
        LDecl := self.FTree[LCapture].ResolvedDecl;
        LName := "self";
        // a self's capture names its method (DoLiteralCapture)
        if (LDecl <> 0) and not IsRoutineLike(self.FTree[LDecl].Kind) then
          LName := self.FTree[LDecl].Text;
        end;
        self.DoError(ARoot, ADAM_ERR_SEMANTICS_757, ADAM_MSG_SEMANTICS_CLOSURE_PLAIN_SLOT,
          NoArgs().Str(LName).Str(self.DoText(ATarget)));
        return false;
      end;
      LAt := AExpr;
      while LAt <> 0 do
        self.DoSetType(LAt, ATarget);
        if LAt = ARoot then
          leave;
        end;
        LAt := self.FTree.FirstOf(LAt, NodeRole.Operand);
      end;
      return true;
    end;

    // True when the callee ACallee of an async's call (BNF sec 6) is a method run on an
    // object the task may outlive: one reached neither through a ptr (`P->M()`, `P^.M()`:
    // the caller keeps the object) nor on a ref (ref T, ref I: the task holds it), i.e. a
    // local, a field, self, parent, an own, an interface value (SM0708). A weak's call is
    // SM0360 already
    hidden const method DoAsyncReceiverLost(const ACallee: int64): bool;
    var
      LDecl: int64;
      LOperand: int64;
      LType: int64;
      LClass: TypeClass;
    begin
      if self.FTree[ACallee].Kind <> NodeKind.MemberExpression then
        return false;
      end;
      LDecl := self.FTree[ACallee].ResolvedDecl;
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.MethodDecl) then
        return false;
      end;
      if self.FTree[ACallee].HasFlag(NodeFlag.Arrow) then
        return false;
      end;
      LOperand := self.DoSkipParens(self.FTree.FirstOf(ACallee, NodeRole.Operand));
      if ((self.FTree[LOperand].Kind = NodeKind.PostfixExpression) or
        (self.FTree[LOperand].Kind = NodeKind.UnaryExpression)) and
        (self.FTree[LOperand].Op = OperatorKind.Deref) then
        return false;
      end;
      LType := self.DoTypeOf(LOperand);
      if LType = 0 then
        return false;
      end;
      LClass := self.DoClass(LType);
      return (LClass <> TypeClass.RefType) and (LClass <> TypeClass.WeakType);
    end;

    // await T (BNF sec 6): its operand a task (else SM0703); the task's result type, none
    // for a plain task (a statement only: DoIsNoValue)
    hidden method DoAwait(const AId: int64);
    var
      LOperand: int64;
      LType: int64;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      LType := self.DoTypeOf(LOperand);
      if self.DoClass(LType) <> TypeClass.TaskType then
        if LType <> 0 then
          self.DoError(AId, ADAM_ERR_SEMANTICS_703, ADAM_MSG_SEMANTICS_AWAIT_TASK,
            NoArgs().Str(self.DoText(LType)));
        end;
        return;
      end;
      if self.FTree[LType].ResolvedType <> 0 then
        self.DoSetType(AId, self.FTree[LType].ResolvedType);
      end;
    end;

    // True when AExpr (its parentheses off) is an await of a plain task: no value (SM0704)
    hidden const method DoIsPlainAwait(const AExpr: int64): bool;
    var
      LAt: int64;
      LType: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if (LAt = 0) or (self.FTree[LAt].Kind <> NodeKind.AwaitExpression) then
        return false;
      end;
      LType := self.DoTypeOf(self.FTree.FirstOf(LAt, NodeRole.Operand));
      return (self.DoClass(LType) = TypeClass.TaskType) and (self.FTree[LType].ResolvedType = 0);
    end;

    // (X): X's type
    hidden method DoParen(const AId: int64);
    var
      LOperand: int64;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      self.DoSetType(AId, self.DoTypeOf(LOperand));
    end;

    // Every child of AId visited
    hidden method DoChildren(const AId: int64);
    var
      LI: int64;
    begin
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        self.DoVisit(self.FTree.ChildAt(AId, LI));
      end;
    end;

    // True when the explicit value of the choice value AMember is a value of a type that is
    // no integer: a float, a string, a bool (cA = 1.5) is SM0200 at it, converting to the
    // int64 a choice value is (the folder does not number it)
    hidden method DoNonIntegralChoice(const AMember: int64): bool;
    var
      LExpr: int64;
      LClass: TypeClass;
    begin
      LExpr := self.FTree.FirstOf(AMember, NodeRole.Value);
      if (LExpr = 0) or self.DoLost(LExpr) then
        return false;
      end;
      LClass := self.DoClass(self.DoTypeOf(LExpr));
      if (LClass = TypeClass.Unknown) or (LClass = TypeClass.SignedInt) or (LClass = TypeClass.UnsignedInt) or
        (LClass = TypeClass.ChoicesType) then
        return false;
      end;
      // a value that does convert is the folder's to number
      return not self.DoConvert(LExpr, self.DoBuiltin("int64"));
    end;

    // A choices type's body AId: each value typed, then numbered before the next one is
    // typed, so a value may name one before it (fB = fA + 1, BNF sec 4)
    hidden method DoChoices(const AId: int64);
    var
      LI: int64;
      LMember: int64;
    begin
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LMember := self.FTree.ChildAt(AId, LI);
        self.DoVisit(LMember);
        if (self.FTree[LMember].Kind = NodeKind.ChoiceValue) and not self.DoNonIntegralChoice(LMember) then
          self.FFolder.NumberChoice(AId, LMember);
        end;
      end;
    end;

    // A var / const declaration: its type, its initializer converting to it. A variable of
    // an object type is built (DoBuild: LV: T, LV: T(...)); init arguments on any other
    // type are SM0350; an external variable is built elsewhere
    hidden method DoVarDecl(const AId: int64);
    var
      LType: int64;
      LInit: int64;
      LClass: TypeClass;
      LTypeNode: int64;
    begin
      LType := self.DoDeclType(AId);
      self.DoChildren(AId);
      LInit := self.FTree.FirstOf(AId, NodeRole.Initializer);
      if LInit <> 0 then
        self.DoOwnMoves(LInit, false);
        self.DoConvert(LInit, LType);
        self.DoPackSource(LInit, LType);
        // a copy of a variable whose C string fields hold borrowed strings (F4)
        if (self.FTree[AId].Kind = NodeKind.VarDecl) and HoldsCText(self.FTree, LType) then
          self.DoNoteCTextCopy(AId, LInit);
        end;
        // A mutex starts free (all zero) and is never copied in: no initializer (SM0621)
        if (LType <> 0) and HoldsMutex(self.FTree, LType) then
          self.DoError(LInit, ADAM_ERR_SEMANTICS_621, ADAM_MSG_SEMANTICS_MUTEX_INIT,
            NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(LType)));
        end;
      end;
      if self.FTree[AId].HasFlag(NodeFlag.ThreadStatic) then
        self.DoThreadStatic(AId, LType, LInit);
        return;
      end;
      if self.FTree.FirstOf(AId, NodeRole.External) <> 0 then
        self.DoExternalVar(AId, LInit);
        return;
      end;
      if (LType = 0) or (self.FTree[AId].Kind <> NodeKind.VarDecl) then
        return;
      end;
      LTypeNode := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      // a variable holds its value in itself (F2a0)
      if not self.DoRefOnlyHeld(LType, self.DoAtOrSelf(LTypeNode, AId)) then
        return;
      end;
      LClass := self.DoClass(LType);
      if (LClass = TypeClass.ObjectType) or (LClass = TypeClass.InterfaceType) then
        // one given an initializer takes its value (a call's result is moved in: BNF sec
        // 3's `= expression`, never with `( )`): no init builds it
        if LInit <> 0 then
          self.DoValueHolds(LType, LTypeNode);
          return;
        end;
        self.DoBuild(AId, NodeRole.ConstructorArgument, LType, LTypeNode, false);
        return;
      end;
      if self.FTree.CountOf(AId, NodeRole.ConstructorArgument) > 0 then
        self.DoErrorAt(self.DoInitArgsPlace(AId, LTypeNode), ADAM_ERR_SEMANTICS_350, ADAM_MSG_SEMANTICS_INIT_NOT_OBJECT,
          NoArgs().Str(self.DoText(LType)));
      end;
    end;

    // The external variable AId (BNF sec 3): declared at module level only (SM0302 at its
    // name: a body's or a routine's variable lives in its frame, no library holds it), and
    // its value is the library's, so it takes no initializer AInit (0: none; SM0301 at it)
    hidden method DoExternalVar(const AId: int64; const AInit: int64);
    begin
      if self.FTree[self.FTree.ParentOf(AId)].Kind <> NodeKind.Module then
        self.DoError(AId, ADAM_ERR_SEMANTICS_302, ADAM_MSG_SEMANTICS_EXTERNAL_VAR_LEVEL,
          NoArgs().Str(self.FTree[AId].Text));
        return;
      end;
      if AInit <> 0 then
        self.DoError(AInit, ADAM_ERR_SEMANTICS_301, ADAM_MSG_SEMANTICS_EXTERNAL_VAR_INIT, NoArgs());
      end;
    end;

    // The threadstatic variable AId of type AType (BNF sec 3): never external, never given
    // init arguments, never an object or interface value (each is built once, at the
    // program's start): SM0700 naming which; its initializer AInit (0: none) a constant
    // (SM0202), the bytes every thread's copy starts with
    hidden method DoThreadStatic(const AId: int64; const AType: int64; const AInit: int64);
    var
      LClass: TypeClass;
    begin
      if self.FTree.FirstOf(AId, NodeRole.External) <> 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_700, ADAM_MSG_SEMANTICS_THREADSTATIC_FORM,
          NoArgs().Str(self.FTree[AId].Text).Str(ADAM_MSG_SEMANTICS_THREADSTATIC_EXTERNAL));
        return;
      end;
      if self.FTree.CountOf(AId, NodeRole.ConstructorArgument) > 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_700, ADAM_MSG_SEMANTICS_THREADSTATIC_FORM,
          NoArgs().Str(self.FTree[AId].Text).Str(ADAM_MSG_SEMANTICS_THREADSTATIC_ARGUMENTS));
        return;
      end;
      if AType <> 0 then
        LClass := self.DoClass(AType);
        if (LClass = TypeClass.ObjectType) or (LClass = TypeClass.InterfaceType) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_700, ADAM_MSG_SEMANTICS_THREADSTATIC_FORM,
            NoArgs().Str(self.FTree[AId].Text).Str(ADAM_MSG_SEMANTICS_THREADSTATIC_OBJECT));
          return;
        end;
      end;
      if (AInit <> 0) and (self.FTree[AInit].ResolvedConst.Kind = ConstKind.Unknown) and
        (self.FTree[AInit].ResolvedType <> 0) then
        self.DoError(AInit, ADAM_ERR_SEMANTICS_202, ADAM_MSG_SEMANTICS_NOT_CONSTANT,
          NoArgs().Str(ADAM_MSG_SEMANTICS_THREADSTATIC_INIT));
      end;
    end;

    // A parameter or a field: its type; a value parameter or a field holds its value, so
    // an interface or an abstract object there is SM0338 (a var / const parameter reaches
    // one by reference). A parameter whose type holds a mutex is var only (SM0621: a mutex
    // is never copied, and a plain routine's const one is a copy)
    hidden method DoHeldDecl(const AId: int64);
    var
      LType: int64;
    begin
      LType := self.DoDeclType(AId);
      if (LType <> 0) and (self.FTree[AId].Kind = NodeKind.Param) and
        (not self.FTree[AId].HasFlag(NodeFlag.VarParam)) and HoldsMutex(self.FTree, LType) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_621, ADAM_MSG_SEMANTICS_MUTEX_PARAM,
          NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(LType)));
      end;
      if (LType = 0) or self.FTree[AId].HasFlag(NodeFlag.VarParam) or
        self.FTree[AId].HasFlag(NodeFlag.ConstParam) then
        return;
      end;
      // a value parameter and a field hold their value in themselves (F2a0)
      if not self.DoRefOnlyHeld(LType, self.DoAtOrSelf(self.FTree.FirstOf(AId, NodeRole.TypeOf), AId)) then
        return;
      end;
      self.DoValueHolds(LType, self.FTree.FirstOf(AId, NodeRole.TypeOf));
    end;

    // A type expression AId of kind AKind: its canonical type; own / ref / weak hold an
    // object or an interface (SM0358); varargs only where DoVarargsTypeAt takes it
    hidden method DoTypeExpression(const AId: int64; const AKind: NodeKind);
    var
      LType: int64;
      LTarget: int64;
      LClass: TypeClass;
    begin
      // The children first: a static array's bounds are folded before its type's key is
      // made from their values (M1.10)
      self.DoChildren(AId);
      if AKind = NodeKind.ClosureType then
        self.DoClosureTypeWords(AId);
      end;
      if AKind = NodeKind.ClosureOfType then
        self.DoThunkFuncType(self.FTree.FirstOf(AId, NodeRole.Element),
          CanonicalOf(self.FTree, self.FTree.FirstOf(AId, NodeRole.Element)));
      end;
      LType := CanonicalOf(self.FTree, AId);
      if self.DoClass(LType) = TypeClass.Varargs then
        self.DoVarargsTypeAt(AId);
        return;
      end;
      if (AKind <> NodeKind.OwnType) and (AKind <> NodeKind.RefType) and (AKind <> NodeKind.WeakType) then
        return;
      end;
      LTarget := TargetOf(self.FTree, LType);
      if LTarget = 0 then
        return;
      end;
      LClass := self.DoClass(LTarget);
      // at the target, the type an owner cannot hold (pcpp's place)
      if (LClass <> TypeClass.ObjectType) and (LClass <> TypeClass.InterfaceType) then
        self.DoError(self.FTree.FirstOf(AId, NodeRole.Element), ADAM_ERR_SEMANTICS_358, ADAM_MSG_SEMANTICS_OWNER_TARGET,
          NoArgs().Str(self.DoText(LType)).Str(self.DoText(LTarget)));
      end;
    end;

    // AType, the type AExpr names, is the func type of a C callback's thunk (CB1: a
    // `__adam_closureof(T)`'s or `__adam_cthunk(T)`'s T): a plain func type (no '...', no
    // method's self; SM0767 at AExpr) of at most ADAM_CTHUNK_MAX_PARAMS parameters (SM0768).
    // No type (0) was reported where it failed; a template's type parameter is judged per
    // instance (BNF sec 10). True when AType is such a func type
    hidden method DoThunkFuncType(const AExpr: int64; const AType: int64): bool;
    var
      LType: int64;
      LCount: int64;
    begin
      LType := AType;
      if (AExpr = 0) or (LType = 0) or (self.DoClass(LType) = TypeClass.TypeParam) then
        return false;
      end;
      if self.DoClass(LType) <> TypeClass.RoutineType then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_767, ADAM_MSG_SEMANTICS_CTHUNK_TYPE,
          NoArgs().Str(self.DoText(LType)).Str(ADAM_MSG_SEMANTICS_CTHUNK_NOT_FUNC));
        return false;
      end;
      if self.FTree[LType].HasFlag(NodeFlag.Variadic) or self.FTree[LType].HasFlag(NodeFlag.TakesSelf) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_767, ADAM_MSG_SEMANTICS_CTHUNK_TYPE,
          NoArgs().Str(self.DoText(LType)).Str(ADAM_MSG_SEMANTICS_CTHUNK_VARIADIC));
        return false;
      end;
      LCount := self.FTree.CountOf(LType, NodeRole.Param);
      if LCount > ADAM_CTHUNK_MAX_PARAMS then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_768, ADAM_MSG_SEMANTICS_CTHUNK_PARAMS,
          NoArgs().Str(self.DoText(LType)).Int(LCount).Int(ADAM_CTHUNK_MAX_PARAMS));
        return false;
      end;
      return true;
    end;

    // A closure type expression AId (BNF sec 4, F2a) has no linkage word and no '...'
    // (SM0754: a closure is called the Adam way only, never from C)
    hidden method DoClosureTypeWords(const AId: int64);
    var
      LWord: string;
    begin
      LWord := "";
      if self.FTree[AId].HasFlag(NodeFlag.Clink) then
        LWord := "'clink'";
      end;
      if self.FTree[AId].HasFlag(NodeFlag.Cpplink) then
        LWord := "'cpplink'";
      end;
      if self.FTree[AId].HasFlag(NodeFlag.Variadic) then
        LWord := "'...'";
      end;
      if LWord <> "" then
        self.DoError(AId, ADAM_ERR_SEMANTICS_754, ADAM_MSG_SEMANTICS_CLOSURE_LINKAGE, NoArgs().Str(LWord));
      end;
    end;

    // ADAM_MSG_SEMANTICS_CONST_WORD or _PLAIN_WORD: what the method AMethod is
    hidden const method DoConstWord(const AMethod: int64): string;
    begin
      if self.FTree[AMethod].HasFlag(NodeFlag.ConstMethod) then
        return ADAM_MSG_SEMANTICS_CONST_WORD;
      end;
      return ADAM_MSG_SEMANTICS_PLAIN_WORD;
    end;

    // True when the member AMember is virtual or an override
    hidden const method DoIsVirtual(const AMember: int64): bool;
    begin
      return self.FTree[AMember].HasFlag(NodeFlag.Virtual) or self.FTree[AMember].HasFlag(NodeFlag.Override);
    end;

    // True when the properties AFirst and ASecond have one shape: their type, their index
    // and whether they have a write
    hidden method DoSameProperty(const AFirst: int64; const ASecond: int64): bool;
    var
      LFirstIndex: int64;
      LSecondIndex: int64;
    begin
      if self.DoDeclType(AFirst) <> self.DoDeclType(ASecond) then
        return false;
      end;
      // the write each runs: an override restating its read only runs its base's (PropertyWriteOf)
      if (PropertyWriteOf(self.FTree, AFirst) = 0) <> (PropertyWriteOf(self.FTree, ASecond) = 0) then
        return false;
      end;
      LFirstIndex := self.FTree.FirstOf(AFirst, NodeRole.Param);
      LSecondIndex := self.FTree.FirstOf(ASecond, NodeRole.Param);
      if (LFirstIndex = 0) <> (LSecondIndex = 0) then
        return false;
      end;
      return (LFirstIndex = 0) or (self.DoDeclType(LFirstIndex) = self.DoDeclType(LSecondIndex));
    end;

    // The virtual words of the method or property AMember of the object AType (BNF sec 4,
    // object members): final and abstract close or open a virtual one (SM0336 / SM0337);
    // an override continues a virtual one of a level above (none: SM0333; final there:
    // SM0335) with its signature (SM0334) and const (SM0389); a name a level above has
    // virtual is overridden only by override (SM0332). A method continues the one of its
    // parameter types (MethodLike): another overload of the name is a method of its own (MO1)
    hidden method DoVirtualWords(const AType: int64; const AMember: int64);
    var
      LName: string;
      LMethod: bool;
      LAbove: int64;
      LUp: int64;
      LUpOwner: string;
      LTypeText: string;
    begin
      LName := self.FTree[AMember].Text;
      LMethod := self.FTree[AMember].Kind = NodeKind.MethodDecl;
      LTypeText := self.DoText(AType);
      if self.FTree[AMember].HasFlag(NodeFlag.Final) and (not self.DoIsVirtual(AMember)) then
        if LMethod then
          self.DoError(AMember, ADAM_ERR_SEMANTICS_336, ADAM_MSG_SEMANTICS_FINAL_NOT_VIRTUAL, NoArgs());
        else
          self.DoError(AMember, ADAM_ERR_SEMANTICS_336, ADAM_MSG_SEMANTICS_PROP_FINAL_NOT_VIRTUAL, NoArgs());
        end;
      end;
      if LMethod and self.FTree[AMember].HasFlag(NodeFlag.Abstract) and (not self.DoIsVirtual(AMember)) then
        self.DoErrorAt(self.FTree[AMember].AtMark(NodeMark.AbstractWord), ADAM_ERR_SEMANTICS_337, ADAM_MSG_SEMANTICS_ABSTRACT_NOT_VIRTUAL,
          NoArgs().Str(LName));
      end;
      if (not LMethod) and HasAbstractAccessor(self.FTree, AMember) and (not self.DoIsVirtual(AMember)) then
        self.DoErrorAt(self.FTree[AbstractAccessorOf(self.FTree, AMember)].AtMark(NodeMark.AbstractWord), ADAM_ERR_SEMANTICS_337, ADAM_MSG_SEMANTICS_PROP_ABSTRACT_NOT_VIRTUAL,
          NoArgs().Str(LName));
      end;
      LUp := 0;
      LAbove := ParentTypeOf(self.FTree, AType);
      if LAbove <> 0 then
        // a method continues the overload of its parameter types (MO1), a property its name
        if LMethod then
          LUp := MethodLike(self.FTree, LAbove, AMember);
        else
          LUp := MemberOf(self.FTree, LAbove, LName);
        end;
      end;
      if (LUp <> 0) and ((self.FTree[LUp].Kind <> self.FTree[AMember].Kind) or (not self.DoIsVirtual(LUp))) then
        LUp := 0;
      end;
      if not self.FTree[AMember].HasFlag(NodeFlag.Override) then
        if LUp <> 0 then
          LUpOwner := self.DoText(self.DoDeclaringType(LUp));
          if LMethod then
            self.DoErrorName(AMember, ADAM_ERR_SEMANTICS_332, ADAM_MSG_SEMANTICS_NEEDS_OVERRIDE,
              NoArgs().Str(LName).Str(LUpOwner).Str(LName));
          else
            self.DoErrorName(AMember, ADAM_ERR_SEMANTICS_332, ADAM_MSG_SEMANTICS_PROP_NEEDS_OVERRIDE,
              NoArgs().Str(LName).Str(LUpOwner).Str(LName));
          end;
        end;
        return;
      end;
      if LUp = 0 then
        if LMethod then
          self.DoError(AMember, ADAM_ERR_SEMANTICS_333, ADAM_MSG_SEMANTICS_OVERRIDES_NOTHING,
            NoArgs().Str(LName).Str(LTypeText).Str(LName));
        else
          self.DoError(AMember, ADAM_ERR_SEMANTICS_333, ADAM_MSG_SEMANTICS_PROP_OVERRIDES_NOTHING,
            NoArgs().Str(LName).Str(LTypeText).Str(LName));
        end;
        return;
      end;
      LUpOwner := self.DoText(self.DoDeclaringType(LUp));
      if self.FTree[LUp].HasFlag(NodeFlag.Final) then
        self.DoError(AMember, ADAM_ERR_SEMANTICS_335, ADAM_MSG_SEMANTICS_OVERRIDE_FINAL,
          NoArgs().Str(LUpOwner).Str(LName));
        return;
      end;
      if not LMethod then
        if not self.DoSameProperty(AMember, LUp) then
          // a write the base has not is what differs when the type agrees: the report points at it
          if (self.DoDeclType(AMember) = self.DoDeclType(LUp)) and
            (self.FTree.FirstOf(AMember, NodeRole.Write) <> 0) and (PropertyWriteOf(self.FTree, LUp) = 0) then
            self.DoError(self.FTree.FirstOf(AMember, NodeRole.Write), ADAM_ERR_SEMANTICS_334,
              ADAM_MSG_SEMANTICS_PROP_OVERRIDE_TYPE, NoArgs().Str(LName).Str(LUpOwner).Str(LName));
          else
            self.DoErrorName(AMember, ADAM_ERR_SEMANTICS_334, ADAM_MSG_SEMANTICS_PROP_OVERRIDE_TYPE,
              NoArgs().Str(LName).Str(LUpOwner).Str(LName));
          end;
        end;
        return;
      end;
      // a method returning self is overridden only by one returning self (F7)
      if self.FTree[AMember].HasFlag(NodeFlag.SelfReturn) <> self.FTree[LUp].HasFlag(NodeFlag.SelfReturn) then
        self.DoErrorName(AMember, ADAM_ERR_SEMANTICS_763, ADAM_MSG_SEMANTICS_SELF_OVERRIDE,
          NoArgs().Str(LName).Str(LUpOwner).Str(LName));
        return;
      end;
      if RoutineTypeOf(self.FTree, AMember) <> RoutineTypeOf(self.FTree, LUp) then
        self.DoErrorName(AMember, ADAM_ERR_SEMANTICS_334, ADAM_MSG_SEMANTICS_OVERRIDE_SIGNATURE,
          NoArgs().Str(LName).Str(LUpOwner).Str(LName));
        return;
      end;
      if self.FTree[AMember].HasFlag(NodeFlag.ConstMethod) <> self.FTree[LUp].HasFlag(NodeFlag.ConstMethod) then
        self.DoError(AMember, ADAM_ERR_SEMANTICS_389, ADAM_MSG_SEMANTICS_CONST_DIFFERS,
          NoArgs().Str(LName).Str(self.DoConstWord(LUp)).Str(LName).Str(LUpOwner));
      end;
    end;

    // The object AType implements every method and property of the interface AInterface
    // and of its parent interfaces (BNF sec 4, implements; reports at ANameNode, the name
    // after implements): a member of AType or of a level above, of that kind (SM0364),
    // not hidden (SM0367), virtual or override (SM0365), with the same signature or shape
    // (SM0366) and const (SM0389)
    hidden method DoImplementsAll(const AType: int64; const AInterface: int64; const ANameNode: int64);
    var
      LLevel: int64;
      LDepth: int64;
      LBody: int64;
      LI: int64;
      LWant: int64;
    begin
      LLevel := AInterface;
      LDepth := 0;
      while (LLevel <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
        LBody := BodyOf(self.FTree, LLevel);
        if LBody = 0 then
          return;
        end;
        for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
          LWant := self.FTree.NthOf(LBody, NodeRole.Member, LI);
          if (self.FTree[LWant].Kind = NodeKind.MethodDecl) or (self.FTree[LWant].Kind = NodeKind.PropertyDecl) then
            self.DoImplementsOne(AType, LLevel, LWant, ANameNode);
          end;
        end;
        LLevel := ParentTypeOf(self.FTree, LLevel);
        LDepth := LDepth + 1;
      end;
    end;

    // The object AType implements the member AWant of the interface level ALevel (see
    // DoImplementsAll); a method no level of AType declares may be an embed's (I4,
    // DoImplementsByEmbed)
    hidden method DoImplementsOne(const AType: int64; const ALevel: int64; const AWant: int64;
      const ANameNode: int64);
    var
      LName: string;
      LHave: int64;
      LMethod: bool;
      LHaveOwner: string;
      LOwner: string;
    begin
      LName := self.FTree[AWant].Text;
      LMethod := self.FTree[AWant].Kind = NodeKind.MethodDecl;
      LOwner := self.DoText(ALevel);
      // a method is implemented by the overload of its parameter types (MO1)
      if LMethod then
        LHave := MethodLike(self.FTree, AType, AWant);
      else
        LHave := MemberOf(self.FTree, AType, LName);
      end;
      if (LHave = 0) and LMethod and self.DoImplementsByEmbed(AType, ALevel, AWant, ANameNode) then
        return;
      end;
      if (LHave = 0) or (self.FTree[LHave].Kind <> self.FTree[AWant].Kind) then
        if LMethod then
          self.DoError(ANameNode, ADAM_ERR_SEMANTICS_364, ADAM_MSG_SEMANTICS_MISSING_METHOD,
            NoArgs().Str(self.DoText(AType)).Str(LOwner).Str(LName).Str(LName));
        else
          self.DoError(ANameNode, ADAM_ERR_SEMANTICS_364, ADAM_MSG_SEMANTICS_MISSING_PROPERTY,
            NoArgs().Str(self.DoText(AType)).Str(LOwner).Str(LName).Str(LName));
        end;
        return;
      end;
      LHaveOwner := self.DoText(self.DoDeclaringType(LHave));
      if self.FTree[LHave].HasFlag(NodeFlag.Hidden) then
        self.DoError(ANameNode, ADAM_ERR_SEMANTICS_367, ADAM_MSG_SEMANTICS_IMPLEMENTS_HIDDEN,
          NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName));
        return;
      end;
      if not self.DoIsVirtual(LHave) then
        if LMethod then
          self.DoError(ANameNode, ADAM_ERR_SEMANTICS_365, ADAM_MSG_SEMANTICS_IMPLEMENTS_PLAIN,
            NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName).Str(LName));
        else
          self.DoError(ANameNode, ADAM_ERR_SEMANTICS_365, ADAM_MSG_SEMANTICS_IMPLEMENTS_PLAIN_PROPERTY,
            NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName).Str(LName));
        end;
        return;
      end;
      if not LMethod then
        if not self.DoSameProperty(LHave, AWant) then
          self.DoError(ANameNode, ADAM_ERR_SEMANTICS_366, ADAM_MSG_SEMANTICS_IMPLEMENTS_PROPERTY_SHAPE,
            NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName));
        end;
        return;
      end;
      if RoutineTypeOf(self.FTree, LHave) <> RoutineTypeOf(self.FTree, AWant) then
        self.DoError(ANameNode, ADAM_ERR_SEMANTICS_366, ADAM_MSG_SEMANTICS_IMPLEMENTS_SIGNATURE,
          NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName));
        return;
      end;
      if self.FTree[LHave].HasFlag(NodeFlag.ConstMethod) <> self.FTree[AWant].HasFlag(NodeFlag.ConstMethod) then
        self.DoError(ANameNode, ADAM_ERR_SEMANTICS_389, ADAM_MSG_SEMANTICS_CONST_DIFFERS,
          NoArgs().Str(LName).Str(self.DoConstWord(AWant)).Str(LName).Str(LOwner));
      end;
    end;

    // The interface method AWant of the interface level ALevel fulfilled by a method an
    // embed of AType holds (I4, BNF sec 4 embed decl: the object forwards to it, no virtual
    // needed; EmbedMemberOf, the nearest depth): two embeds of one depth holding it is
    // SM0370, a hidden one SM0367, another signature SM0366, another const SM0389, each at
    // ANameNode; else the forward is written into the AST, a Forward child of ANameNode (its
    // Text AWant's name, its ResolvedDecl the embed's method, its ResolvedEmbed the
    // outermost embed, each embed past it an EmbedStep child). False when no embed holds a
    // method of that name (SM0364 is the caller's)
    hidden method DoImplementsByEmbed(const AType: int64; const ALevel: int64; const AWant: int64;
      const ANameNode: int64): bool;
    var
      LName: string;
      LMember: int64;
      LPath: NodeList;
      LSecond: NodeList;
      LOwner: string;
      LHaveOwner: string;
      LForward: int64;
      LStep: int64;
      LI: int64;
    begin
      LName := self.FTree[AWant].Text;
      if not EmbedMemberOf(self.FTree, AType, LName, LMember, LPath, LSecond) then
        return false;
      end;
      if (LMember = 0) or (self.FTree[LMember].Kind <> NodeKind.MethodDecl) then
        return false;
      end;
      LOwner := self.DoText(ALevel);
      if LSecond.Count <> 0 then
        self.DoError(ANameNode, ADAM_ERR_SEMANTICS_370, ADAM_MSG_SEMANTICS_IMPLEMENTS_EMBED_SHARED,
          NoArgs().Str(LOwner).Str(LName).Str(self.DoText(AType)).Str(self.DoEmbedPathText(LPath)).Str(
          self.DoEmbedPathText(LSecond)).Str(LName));
        return true;
      end;
      // the overload of AWant's parameter types at the level that has the name (MO1); none
      // takes them: no embed fulfils it (SM0364 is the caller's)
      LMember := MethodLike(self.FTree, self.DoDeclaringType(LMember), AWant);
      if LMember = 0 then
        return false;
      end;
      LHaveOwner := self.DoText(self.DoDeclaringType(LMember));
      if self.FTree[LMember].HasFlag(NodeFlag.Hidden) then
        self.DoError(ANameNode, ADAM_ERR_SEMANTICS_367, ADAM_MSG_SEMANTICS_IMPLEMENTS_HIDDEN,
          NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName));
        return true;
      end;
      if RoutineTypeOf(self.FTree, LMember) <> RoutineTypeOf(self.FTree, AWant) then
        self.DoError(ANameNode, ADAM_ERR_SEMANTICS_366, ADAM_MSG_SEMANTICS_IMPLEMENTS_SIGNATURE,
          NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName));
        return true;
      end;
      if self.FTree[LMember].HasFlag(NodeFlag.ConstMethod) <> self.FTree[AWant].HasFlag(NodeFlag.ConstMethod) then
        self.DoError(ANameNode, ADAM_ERR_SEMANTICS_389, ADAM_MSG_SEMANTICS_CONST_DIFFERS,
          NoArgs().Str(LName).Str(self.DoConstWord(AWant)).Str(LName).Str(LOwner));
        return true;
      end;
      // A second visit of ANameNode finds its forward written already (one per overload)
      for LI := 0 to self.FTree.CountOf(ANameNode, NodeRole.Forward) - 1 do
        LForward := self.FTree.NthOf(ANameNode, NodeRole.Forward, LI);
        if (self.FTree[LForward].Text = LName) and (self.FTree[LForward].ResolvedDecl = LMember) then
          return true;
        end;
      end;
      LForward := self.FTree.AddChild(ANameNode, NodeRole.Forward, NodeKind.Forward,
        self.FTree[ANameNode].Place, self.FTree[ANameNode].StartOffset, self.FTree[ANameNode].EndOffset);
      self.FTree[LForward].Text := LName;
      self.FTree[LForward].ResolvedDecl := LMember;
      self.FTree[LForward].ResolvedEmbed := LPath.Items[0];
      for LI := 1 to LPath.Count - 1 do
        LStep := self.FTree.AddChild(LForward, NodeRole.EmbedStep, NodeKind.EmbedStep,
          self.FTree[ANameNode].Place, self.FTree[ANameNode].StartOffset, self.FTree[ANameNode].EndOffset);
        self.FTree[LStep].ResolvedDecl := LPath.Items[LI];
      end;
      return true;
    end;

    // An object type declaration AType with body ABody (BNF sec 4): its parent is an
    // object, never an interface or another type (SM0308), and not final (SM0339); after implements interfaces only (SM0362), each once (SM0363),
    // each implemented in full (DoImplementsAll); its members' virtual words
    // (DoVirtualWords); its properties' bound fields (DoPropertyBindings) and default
    // (DoPropertyDefault); an embed holds a record, an overlay or an object (SM0369); its
    // copy decls' rules (DoCopyRules); one done (SM0341 at each later one); its inits'
    // and copy's lead calls (DoLifetimeRules)
    hidden method DoObjectRules(const AType: int64; const ABody: int64);
    var
      LCopies: int64;
      LDones: int64;
      LParentNode: int64;
      LParent: int64;
      LI: int64;
      LJ: int64;
      LNameNode: int64;
      LNamed: int64;
      LTwice: bool;
      LMember: int64;
      LKind: NodeKind;
      LEmbedType: int64;
      LClass: TypeClass;
      LDefault: int64;
    begin
      LDefault := 0;
      LParentNode := self.FTree.FirstOf(ABody, NodeRole.Parent);
      LParent := ParentTypeOf(self.FTree, AType);
      if (LParent <> 0) and (self.DoClass(LParent) = TypeClass.InterfaceType) then
        self.DoError(LParentNode, ADAM_ERR_SEMANTICS_308, ADAM_MSG_SEMANTICS_INTERFACE_PARENT,
          NoArgs().Str(self.DoText(LParent)).Str(self.DoText(LParent)));
      else
        if (LParent <> 0) and (self.DoClass(LParent) <> TypeClass.ObjectType) then
          self.DoError(LParentNode, ADAM_ERR_SEMANTICS_308, ADAM_MSG_SEMANTICS_OBJECT_PARENT,
            NoArgs().Str(self.DoText(LParent)));
        end;
      end;
      if (LParent <> 0) and (self.DoClass(LParent) = TypeClass.ObjectType) and IsFinalType(self.FTree, LParent) then
        self.DoError(LParentNode, ADAM_ERR_SEMANTICS_339, ADAM_MSG_SEMANTICS_FINAL_PARENT,
          NoArgs().Str(self.DoText(LParent)));
      end;
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Implements) - 1 do
        LNameNode := self.FTree.NthOf(ABody, NodeRole.Implements, LI);
        LNamed := CanonicalOf(self.FTree, LNameNode);
        if LNamed <> 0 then
          if self.DoClass(LNamed) <> TypeClass.InterfaceType then
            self.DoError(LNameNode, ADAM_ERR_SEMANTICS_362, ADAM_MSG_SEMANTICS_NOT_INTERFACE,
              NoArgs().Str(self.DoText(LNamed)));
          else
            LTwice := false;
            for LJ := 0 to LI - 1 do
              if CanonicalOf(self.FTree, self.FTree.NthOf(ABody, NodeRole.Implements, LJ)) = LNamed then
                LTwice := true;
              end;
            end;
            if LTwice then
              self.DoError(LNameNode, ADAM_ERR_SEMANTICS_363, ADAM_MSG_SEMANTICS_IMPLEMENTS_TWICE,
                NoArgs().Str(self.DoText(LNamed)).Str(self.DoText(AType)));
            else
              self.DoImplementsAll(AType, LNamed, LNameNode);
            end;
          end;
        end;
      end;
      LCopies := 0;
      LDones := 0;
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        LKind := self.FTree[LMember].Kind;
        if (LKind = NodeKind.MethodDecl) or (LKind = NodeKind.PropertyDecl) then
          self.DoVirtualWords(AType, LMember);
        end;
        if LKind = NodeKind.CopyDecl then
          self.DoCopyRules(AType, LMember, LCopies);
          LCopies := LCopies + 1;
        end;
        if LKind = NodeKind.DoneDecl then
          if LDones > 0 then
            self.DoError(LMember, ADAM_ERR_SEMANTICS_341, ADAM_MSG_SEMANTICS_DONE_TWICE,
              NoArgs().Str(self.DoText(AType)));
          end;
          LDones := LDones + 1;
        end;
        if LKind = NodeKind.PropertyDecl then
          self.DoPropertyBindings(AType, LMember);
          self.DoPropertyDefault(AType, LMember, LDefault);
        end;
        if LKind = NodeKind.EmbedDecl then
          LEmbedType := CanonicalOf(self.FTree, self.FTree.FirstOf(LMember, NodeRole.TypeOf));
          LClass := self.DoClass(LEmbedType);
          if (LEmbedType <> 0) and (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.OverlayType) and
            (LClass <> TypeClass.ObjectType) then
            self.DoError(self.FTree.FirstOf(LMember, NodeRole.TypeOf), ADAM_ERR_SEMANTICS_369,
              ADAM_MSG_SEMANTICS_EMBED_TYPE, NoArgs().Str(self.FTree[LMember].Text).Str(self.DoText(LEmbedType)));
          end;
        end;
      end;
      // an external type's inits and copy are the library's: its build ran these rules
      if not IsExternalType(self.FTree, AType) then
        self.DoLifetimeRules(AType, ABody);
      end;
    end;

    // True when the object type AType declares inits and none of them takes no argument:
    // it is built only with arguments (as a part: by a lead call, SM0347)
    hidden method DoNeedsInitArgs(const AType: int64): bool;
    var
      LBody: int64;
      LMember: int64;
      LInits: int64;
      LI: int64;
    begin
      if (AType = 0) or (self.DoClass(AType) <> TypeClass.ObjectType) then
        return false;
      end;
      LBody := BodyOf(self.FTree, AType);
      LInits := 0;
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if self.FTree[LMember].Kind = NodeKind.InitDecl then
          if self.FTree.CountOf(LMember, NodeRole.Param) = 0 then
            return false;
          end;
          LInits := LInits + 1;
        end;
      end;
      return LInits > 0;
    end;

    // The field or embed named AName the object type AOwner declares itself (its own
    // level, never a parent's); 0 when it declares none
    hidden method DoOwnPart(const AOwner: int64; const AName: string): int64;
    var
      LBody: int64;
      LMember: int64;
      LKind: NodeKind;
      LI: int64;
    begin
      LBody := BodyOf(self.FTree, AOwner);
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        LKind := self.FTree[LMember].Kind;
        if ((LKind = NodeKind.FieldDecl) or (LKind = NodeKind.EmbedDecl)) and (self.FTree[LMember].Text = AName) then
          return LMember;
        end;
      end;
      return 0;
    end;

    // The place of the member AMember in the member list of the object type AOwner (its
    // declaration order); -1 when AOwner declares none such
    hidden method DoMemberIndex(const AOwner: int64; const AMember: int64): int64;
    var
      LBody: int64;
      LI: int64;
    begin
      LBody := BodyOf(self.FTree, AOwner);
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        if self.FTree.NthOf(LBody, NodeRole.Member, LI) = AMember then
          return LI;
        end;
      end;
      return -1;
    end;

    // The part the statement AStatement of an init or a copy of the object type AOwner
    // builds when it is shaped as a lead call (BNF sec 4 D3), told by its shape alone
    // (what the part's type is, DoLeadCall judges): `parent.init(...);` the parent's type
    // (ParentTypeOf, the value Lowering's DoLeadCall compares with), `self.F.init(...);`
    // with F a field or an embed AOwner declares itself that field; 0 for any other
    // statement
    hidden method DoLeadShape(const AStatement: int64; const AOwner: int64): int64;
    var
      LCall: int64;
      LCallee: int64;
      LOperand: int64;
      LBase: int64;
    begin
      if self.FTree[AStatement].Kind <> NodeKind.ExpressionStatement then
        return 0;
      end;
      LCall := self.FTree.FirstOf(AStatement, NodeRole.Value);
      if self.FTree[LCall].Kind <> NodeKind.CallExpression then
        return 0;
      end;
      LCallee := self.FTree.FirstOf(LCall, NodeRole.Callee);
      if (self.FTree[LCallee].Kind <> NodeKind.MemberExpression) or (self.FTree[LCallee].Text <> "init") or
        self.FTree[LCallee].HasFlag(NodeFlag.Arrow) then
        return 0;
      end;
      LOperand := self.FTree.FirstOf(LCallee, NodeRole.Operand);
      if self.FTree[LOperand].Kind = NodeKind.ParentExpression then
        return ParentTypeOf(self.FTree, AOwner);
      end;
      if (self.FTree[LOperand].Kind <> NodeKind.MemberExpression) or self.FTree[LOperand].HasFlag(NodeFlag.Arrow) then
        return 0;
      end;
      LBase := self.FTree.FirstOf(LOperand, NodeRole.Operand);
      if self.FTree[LBase].Kind <> NodeKind.SelfExpression then
        return 0;
      end;
      return self.DoOwnPart(AOwner, self.FTree[LOperand].Text);
    end;

    // True when APart (the parent's type or a field) is a field or an embed
    hidden method DoIsFieldPart(const APart: int64): bool;
    var
      LKind: NodeKind;
    begin
      LKind := self.FTree[APart].Kind;
      return (LKind = NodeKind.FieldDecl) or (LKind = NodeKind.EmbedDecl);
    end;

    // The lead calls of the init or copy ARoutine of the object type AOwner (BNF sec 4
    // D3): its body begins with them, `parent.init(...)` first (SM0344; never in a copy,
    // SM0356), then `self.F.init(...)` for AOwner's own fields in declaration order, each
    // once (SM0345); the run ends at the first other statement, or at a misplaced one
    // (reported when AReport). The part the statement AStop builds when it is one of the
    // run (DoLeadShape), -1 when it is the misplaced one, else 0
    hidden method DoLeadRun(const ARoutine: int64; const AOwner: int64; const AStop: int64;
      const AReport: bool): int64;
    var
      LBody: int64;
      LStatement: int64;
      LCall: int64;
      LPart: int64;
      LLast: int64;
      LLastIndex: int64;
      LIndex: int64;
      LCount: int64;
      LCode: string;
      LTemplate: string;
      LArgs: MessageArgs;
      LI: int64;
    begin
      LBody := self.FTree.FirstOf(ARoutine, NodeRole.Body);
      if LBody = 0 then
        return 0;
      end;
      LLast := 0;
      LLastIndex := -1;
      LCount := 0;
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Statement) - 1 do
        LStatement := self.FTree.NthOf(LBody, NodeRole.Statement, LI);
        LPart := self.DoLeadShape(LStatement, AOwner);
        if LPart = 0 then
          return 0;
        end;
        LCall := self.FTree.FirstOf(LStatement, NodeRole.Value);
        LCode := "";
        LTemplate := "";
        LArgs := NoArgs();
        if not self.DoIsFieldPart(LPart) then
          if self.FTree[ARoutine].Kind = NodeKind.CopyDecl then
            LCode := ADAM_ERR_SEMANTICS_356;
            LTemplate := ADAM_MSG_SEMANTICS_COPY_PARENT_INIT;
          else
            if LCount > 0 then
              LCode := ADAM_ERR_SEMANTICS_344;
              LTemplate := ADAM_MSG_SEMANTICS_PARENT_INIT_FIRST;
            end;
          end;
        else
          LIndex := self.DoMemberIndex(AOwner, LPart);
          if LIndex <= LLastIndex then
            LCode := ADAM_ERR_SEMANTICS_345;
            if LPart = LLast then
              LTemplate := ADAM_MSG_SEMANTICS_FIELD_INIT_TWICE;
              LArgs := NoArgs().Str(self.FTree[LPart].Text);
            else
              LTemplate := ADAM_MSG_SEMANTICS_FIELD_INIT_ORDER;
              LArgs := NoArgs().Str(self.FTree[LPart].Text).Str(self.FTree[LLast].Text);
            end;
          else
            LLast := LPart;
            LLastIndex := LIndex;
          end;
        end;
        if LCode <> "" then
          if AReport then
            self.DoError(LCall, LCode, LTemplate, LArgs);
          end;
          if LStatement = AStop then
            return -1;
          end;
          return 0;
        end;
        if LStatement = AStop then
          return LPart;
        end;
        LCount := LCount + 1;
      end;
      return 0;
    end;

    // The part the call ACall builds when it is a lead call of an init or a copy (its
    // statement one of the run that begins the body, DoLeadRun); -1 for a misplaced one
    // (DoLifetimeRules reports it); 0 for any other call
    hidden method DoLeadOf(const ACall: int64): int64;
    var
      LStatement: int64;
      LBody: int64;
      LRoutine: int64;
      LKind: NodeKind;
    begin
      LStatement := self.FTree.ParentOf(ACall);
      if (LStatement = 0) or (self.FTree[LStatement].Kind <> NodeKind.ExpressionStatement) or
        (self.FTree.RoleOf(ACall) <> NodeRole.Value) then
        return 0;
      end;
      LBody := self.FTree.ParentOf(LStatement);
      if (LBody = 0) or (self.FTree.RoleOf(LStatement) <> NodeRole.Statement) then
        return 0;
      end;
      LRoutine := self.FTree.ParentOf(LBody);
      if (LRoutine = 0) or (self.FTree.RoleOf(LBody) <> NodeRole.Body) then
        return 0;
      end;
      LKind := self.FTree[LRoutine].Kind;
      if (LKind <> NodeKind.InitDecl) and (LKind <> NodeKind.CopyDecl) then
        return 0;
      end;
      // the routine hangs in its type's body, the body under the type's declaration
      return self.DoLeadRun(LRoutine, DeclaredTypeOf(self.FTree, self.FTree.ParentOf(self.FTree.ParentOf(LRoutine))),
        LStatement, false);
    end;

    // SM0346 at each `self`, `parent` or local of the init or copy ARoutine named in the
    // expression AId, an argument of the lead call whose callee is ACallee: its arguments
    // run before the object (and the routine's locals) exist; parameters and constants
    // are there
    hidden method DoLeadArgument(const AId: int64; const ACallee: int64; const ARoutine: int64);
    var
      LKind: NodeKind;
      LDecl: int64;
      LI: int64;
    begin
      LKind := self.FTree[AId].Kind;
      if (LKind = NodeKind.SelfExpression) or (LKind = NodeKind.ParentExpression) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_346, ADAM_MSG_SEMANTICS_LEAD_ARG_EARLY,
          NoArgs().Str(self.DoExprText(AId)).Str(self.DoExprText(ACallee)));
        return;
      end;
      if LKind = NodeKind.NameExpression then
        LDecl := self.FTree[AId].ResolvedDecl;
        if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.VarDecl) and self.FTree.IsAncestor(ARoutine, LDecl) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_346, ADAM_MSG_SEMANTICS_LEAD_ARG_EARLY,
            NoArgs().Str(self.DoExprText(AId)).Str(self.DoExprText(ACallee)));
        end;
        return;
      end;
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        self.DoLeadArgument(self.FTree.ChildAt(AId, LI), ACallee, ARoutine);
      end;
    end;

    // The lead call AId building APart (DoLeadOf; -1: misplaced, reported by
    // DoLifetimeRules): its callee's `.init` is never typed as a member (SM0342 is for any
    // other use); its arguments are typed as any call's and name nothing that does not
    // exist yet (SM0346); APart goes into AId's ResolvedDecl (what Lowering's DoLeadCall
    // finds it by) and the part's init is picked as a construction's (DoBuild: into
    // ResolvedCallee); a part that is no object is SM0350
    hidden method DoLeadCall(const AId: int64; const APart: int64);
    var
      LCallee: int64;
      LRoutine: int64;
      LType: int64;
      LI: int64;
    begin
      LCallee := self.FTree.FirstOf(AId, NodeRole.Callee);
      self.DoFirstVisit(LCallee);
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        self.DoVisit(self.FTree.NthOf(AId, NodeRole.Argument, LI));
      end;
      if APart < 0 then
        return;
      end;
      self.DoVisit(self.FTree.FirstOf(LCallee, NodeRole.Operand));
      LRoutine := self.FTree.ParentOf(self.FTree.ParentOf(self.FTree.ParentOf(AId)));
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        self.DoLeadArgument(self.FTree.NthOf(AId, NodeRole.Argument, LI), LCallee, LRoutine);
      end;
      self.FTree[AId].ResolvedDecl := APart;
      LType := APart;
      if self.DoIsFieldPart(APart) then
        LType := self.DoDeclType(APart);
      end;
      if LType = 0 then
        return;
      end;
      if self.DoClass(LType) <> TypeClass.ObjectType then
        self.DoError(AId, ADAM_ERR_SEMANTICS_350, ADAM_MSG_SEMANTICS_INIT_NOT_OBJECT,
          NoArgs().Str(self.DoText(LType)));
        return;
      end;
      self.DoBuild(AId, NodeRole.Argument, LType, AId, true);
    end;

    // True when the init or copy ARoutine of AOwner has a top-level statement shaped as
    // the lead call that builds APart (DoLeadShape), in its run or misplaced (reported
    // already: SM0344 / SM0345 / SM0356), so a part is never reported missing as well
    hidden method DoLeadsWith(const ARoutine: int64; const AOwner: int64; const APart: int64): bool;
    var
      LBody: int64;
      LI: int64;
    begin
      LBody := self.FTree.FirstOf(ARoutine, NodeRole.Body);
      if LBody = 0 then
        return false;
      end;
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Statement) - 1 do
        if self.DoLeadShape(self.FTree.NthOf(LBody, NodeRole.Statement, LI), AOwner) = APart then
          return true;
        end;
      end;
      return false;
    end;

    // The lead calls of the object type AType's inits and copy (BNF sec 4 D3, O5; ABody
    // its body): each run's order (DoLeadRun, reported); a parent whose every init takes
    // arguments is built by a lead call of every init, and an own field or embed of such a
    // type by one of every init and of the copy (SM0347 at the init or copy lacking it,
    // or at the parent / the field when AType declares no init)
    hidden method DoLifetimeRules(const AType: int64; const ABody: int64);
    var
      LMember: int64;
      LKind: NodeKind;
      LParent: int64;
      LPartType: int64;
      LInits: int64;
      LI: int64;
      LJ: int64;
      LRoutine: int64;
    begin
      LInits := 0;
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        LKind := self.FTree[LMember].Kind;
        if (LKind = NodeKind.InitDecl) or (LKind = NodeKind.CopyDecl) then
          self.DoLeadRun(LMember, AType, 0, true);
        end;
        if LKind = NodeKind.InitDecl then
          LInits := LInits + 1;
        end;
      end;
      LParent := ParentTypeOf(self.FTree, AType);
      if self.DoNeedsInitArgs(LParent) then
        if LInits = 0 then
          self.DoError(self.FTree.FirstOf(ABody, NodeRole.Parent), ADAM_ERR_SEMANTICS_347,
            ADAM_MSG_SEMANTICS_PARENT_NEEDS_INIT, NoArgs().Str(self.DoText(LParent)).Str(self.DoText(AType)));
        end;
        for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
          LRoutine := self.FTree.NthOf(ABody, NodeRole.Member, LI);
          if (self.FTree[LRoutine].Kind = NodeKind.InitDecl) and not self.DoLeadsWith(LRoutine, AType, LParent) then
            self.DoError(LRoutine, ADAM_ERR_SEMANTICS_347, ADAM_MSG_SEMANTICS_PARENT_NEEDS_INIT,
              NoArgs().Str(self.DoText(LParent)).Str(self.DoText(AType)));
          end;
        end;
      end;
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        if self.DoIsFieldPart(LMember) then
          LPartType := self.DoDeclType(LMember);
          if self.DoNeedsInitArgs(LPartType) then
            if LInits = 0 then
              self.DoFieldNeedsInit(LMember, LMember, LPartType, AType);
            end;
            for LJ := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
              LRoutine := self.FTree.NthOf(ABody, NodeRole.Member, LJ);
              LKind := self.FTree[LRoutine].Kind;
              if ((LKind = NodeKind.InitDecl) or (LKind = NodeKind.CopyDecl)) and
                not self.DoLeadsWith(LRoutine, AType, LMember) then
                self.DoFieldNeedsInit(LRoutine, LMember, LPartType, AType);
              end;
            end;
          end;
        end;
      end;
    end;

    // SM0347 at AAt: the field AField of type APartType (no init without arguments) of
    // AOwner is built by no lead call
    hidden method DoFieldNeedsInit(const AAt: int64; const AField: int64; const APartType: int64;
      const AOwner: int64);
    begin
      self.DoError(AAt, ADAM_ERR_SEMANTICS_347, ADAM_MSG_SEMANTICS_FIELD_NEEDS_INIT,
        NoArgs().Str(self.FTree[AField].Text).Str(self.DoText(APartType)).Str(self.DoText(AOwner)).Str(
        self.FTree[AField].Text));
    end;

    // The bound accessors of the property AProperty of the object AType (BNF sec 4,
    // `read F` / `write F`): each names a field of AType's chain (SM0371) of the
    // property's type exactly (SM0372); the field is written to the accessor's
    // ResolvedDecl, the place Lowering reads it from. An accessor with a body, an
    // abstract one or one in an interface binds nothing; a write's value parameter
    // `write (AValue)` gets the property's type into its ResolvedType here, used or not
    // (DoDeclType)
    hidden method DoPropertyBindings(const AType: int64; const AProperty: int64);
    var
      LI: int64;
      LAccessor: int64;
      LField: int64;
      LPropertyType: int64;
      LFieldType: int64;
      LValue: int64;
    begin
      LAccessor := self.FTree.FirstOf(AProperty, NodeRole.Write);
      if LAccessor <> 0 then
        LValue := self.FTree.FirstOf(LAccessor, NodeRole.Param);
        if LValue <> 0 then
          self.DoDeclType(LValue);
        end;
      end;
      for LI := 0 to 1 do
        if LI = 0 then
          LAccessor := self.FTree.FirstOf(AProperty, NodeRole.Read);
        else
          LAccessor := self.FTree.FirstOf(AProperty, NodeRole.Write);
        end;
        if (LAccessor = 0) or (self.FTree[LAccessor].Text = "") then
          skip;
        end;
        LField := MemberOf(self.FTree, AType, self.FTree[LAccessor].Text);
        if (LField = 0) or (self.FTree[LField].Kind <> NodeKind.FieldDecl) then
          self.DoErrorName(LAccessor, ADAM_ERR_SEMANTICS_371, ADAM_MSG_SEMANTICS_PROPERTY_NO_FIELD,
            NoArgs().Str(self.FTree[AProperty].Text).Str(self.FTree[LAccessor].Text).Str(self.DoText(AType)));
          skip;
        end;
        self.FTree[LAccessor].ResolvedDecl := LField;
        LPropertyType := self.DoDeclType(AProperty);
        LFieldType := self.DoDeclType(LField);
        if (LPropertyType <> 0) and (LFieldType <> 0) and (LPropertyType <> LFieldType) then
          self.DoErrorName(LAccessor, ADAM_ERR_SEMANTICS_372, ADAM_MSG_SEMANTICS_PROPERTY_FIELD_TYPE,
            NoArgs().Str(self.FTree[AProperty].Text).Str(self.DoText(LPropertyType)).Str(
            self.FTree[LField].Text).Str(self.DoText(LFieldType)));
        end;
      end;
    end;

    // The default word of the property AProperty of the object AType (BNF sec 4:
    // `default` names the type's one indexed property X[i] means): on a property with
    // no index, or after ADefault (the type's default met so far, 0: none), SM0379;
    // otherwise AProperty becomes ADefault
    hidden method DoPropertyDefault(const AType: int64; const AProperty: int64; var ADefault: int64);
    begin
      if not self.FTree[AProperty].HasFlag(NodeFlag.DefaultProperty) then
        return;
      end;
      if self.FTree.FirstOf(AProperty, NodeRole.Param) = 0 then
        self.DoErrorAt(self.FTree[AProperty].AtMark(NodeMark.DefaultWord), ADAM_ERR_SEMANTICS_379, ADAM_MSG_SEMANTICS_PROPERTY_DEFAULT_INDEX,
          NoArgs().Str(self.FTree[AProperty].Text));
        return;
      end;
      if ADefault <> 0 then
        self.DoErrorAt(self.FTree[AProperty].AtMark(NodeMark.DefaultWord), ADAM_ERR_SEMANTICS_379, ADAM_MSG_SEMANTICS_PROPERTY_DEFAULT_TWICE,
          NoArgs().Str(self.FTree[AProperty].Text).Str(self.DoText(AType)).Str(self.FTree[ADefault].Text));
        return;
      end;
      ADefault := AProperty;
    end;

    // The external type ADecl (MO1b0, BNF sec 4), its clause AClause resolved: declared at
    // module level only (SM0742: its members are a library's exports), naming its library
    // (SM0743: the members are mangled under the library's module name), a parent only an
    // external type of that same library (SM0744: the library's build made the parent's
    // parts and vtable). The parser judged its kind and members
    hidden method DoExternalType(const ADecl: int64; const AClause: int64);
    var
      LLibrary: string;
      LParent: int64;
      LParentClause: int64;
    begin
      if self.FTree[self.FTree.ParentOf(ADecl)].Kind <> NodeKind.Module then
        self.DoError(ADecl, ADAM_ERR_SEMANTICS_742, ADAM_MSG_SEMANTICS_EXTERNAL_TYPE_LEVEL,
          NoArgs().Str(self.FTree[ADecl].Text));
        return;
      end;
      if self.FTree[AClause].ResolvedConst.Kind <> ConstKind.String then
        if (self.FTree.FirstOf(AClause, NodeRole.Argument) = 0) and (self.FTree[AClause].Text = "") then
          self.DoError(AClause, ADAM_ERR_SEMANTICS_743, ADAM_MSG_SEMANTICS_EXTERNAL_TYPE_LIBRARY,
            NoArgs().Str(self.FTree[ADecl].Text));
        end;
        return;
      end;
      LLibrary := self.FTree[AClause].ResolvedConst.Text;
      LParent := ParentTypeOf(self.FTree, DeclaredTypeOf(self.FTree, ADecl));
      if LParent = 0 then
        return;
      end;
      LParentClause := self.FTree.FirstOf(LParent, NodeRole.External);
      if (LParentClause = 0) or (self.FTree[LParentClause].ResolvedConst.Kind <> ConstKind.String) or
        (self.FTree[LParentClause].ResolvedConst.Text <> LLibrary) then
        self.DoError(ADecl, ADAM_ERR_SEMANTICS_744, ADAM_MSG_SEMANTICS_EXTERNAL_TYPE_PARENT,
          NoArgs().Str(self.FTree[ADecl].Text).Str(self.FTree[LParent].Text).Str(LLibrary));
      end;
    end;

    // A type declaration AId: the type it declares into its ResolvedType; an object's and
    // an interface's own rules (DoObjectRules, DoInterfaceRules), a record's parent
    // (DoRecordParent)
    hidden method DoTypeDecl(const AId: int64);
    var
      LType: int64;
      LBody: int64;
    begin
      LType := DeclaredTypeOf(self.FTree, AId);
      self.FTree[AId].ResolvedType := LType;
      LBody := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      if (LType = 0) or (LBody = 0) then
        return;
      end;
      if self.FTree[LBody].Kind = NodeKind.ObjectType then
        self.DoObjectRules(LType, LBody);
      end;
      if self.FTree[LBody].Kind = NodeKind.InterfaceType then
        self.DoInterfaceRules(LType, LBody);
      end;
      if self.FTree[LBody].Kind = NodeKind.RecordType then
        self.DoRecordParent(LType, LBody);
      end;
      if (self.FTree[LBody].Kind = NodeKind.RecordType) or
        (self.FTree[LBody].Kind = NodeKind.ObjectType) or
        (self.FTree[LBody].Kind = NodeKind.OverlayType) or
        (self.FTree[LBody].Kind = NodeKind.ChoicesType) or
        (self.FTree[LBody].Kind = NodeKind.InterfaceType) then
        self.DoMemberNames(LType, LBody);
      end;
      if (self.FTree[LBody].Kind = NodeKind.RecordType) or (self.FTree[LBody].Kind = NodeKind.ObjectType) or
        (self.FTree[LBody].Kind = NodeKind.InterfaceType) then
        self.DoMethodOverloads(LType, LBody);
      end;
      if (self.FTree[LBody].Kind = NodeKind.RecordType) or (self.FTree[LBody].Kind = NodeKind.ObjectType) then
        self.DoOperatorRules(LType, LBody);
        self.DoInitOverloads(LType, LBody);
      end;
    end;

    // True for a member kind that is named by its own name in the type's member namespace (a
    // field, an embed, a method, a property, a choice value): an init, a copy, a done and an
    // operator are found by their shape, never by a member name
    hidden const method DoIsNamedMember(const AKind: NodeKind): bool;
    begin
      return (AKind = NodeKind.FieldDecl) or (AKind = NodeKind.EmbedDecl) or
        (AKind = NodeKind.MethodDecl) or (AKind = NodeKind.PropertyDecl) or
        (AKind = NodeKind.ChoiceValue);
    end;

    // The named members of the aggregate body ABody into AMembers in their order, an inline
    // record's and an inline overlay's (BNF sec 4: their members are the type's) hoisted in
    // their place
    hidden const method DoNamedMembers(const ABody: int64; var AMembers: Int64Array);
    var
      LI: int64;
      LChild: int64;
      LCount: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LChild := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        if (self.FTree[LChild].Kind = NodeKind.AnonRecord) or
          (self.FTree[LChild].Kind = NodeKind.AnonOverlay) then
          self.DoNamedMembers(LChild, AMembers);
        else
          if self.DoIsNamedMember(self.FTree[LChild].Kind) and (self.FTree[LChild].Text <> "") then
            LCount := len(AMembers);
            setlength(AMembers, LCount + 1);
            AMembers[LCount] := LChild;
          end;
        end;
      end;
    end;

    // The methods of the type AType (body ABody) overload by parameter types (BNF sec 4,
    // MO1): a method with the name and parameter types of an earlier one (DoSameParameters:
    // modes, names, const and result make no overload) is SM0324 at it, once; one static
    // where the earlier one is not (or the reverse) SM0004 (J3d)
    hidden method DoMethodOverloads(const AType: int64; const ABody: int64);
    var
      LI: int64;
      LJ: int64;
      LMethod: int64;
      LEarlier: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LMethod := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        if self.FTree[LMethod].Kind <> NodeKind.MethodDecl then
          skip;
        end;
        for LJ := 0 to LI - 1 do
          LEarlier := self.FTree.NthOf(ABody, NodeRole.Member, LJ);
          // a static and an instance method never share a name in one type (J3d)
          if (self.FTree[LEarlier].Kind = NodeKind.MethodDecl) and
            (self.FTree[LEarlier].Text = self.FTree[LMethod].Text) and
            (self.FTree[LEarlier].HasFlag(NodeFlag.Static) <> self.FTree[LMethod].HasFlag(NodeFlag.Static)) then
            self.DoError(LMethod, ADAM_ERR_SEMANTICS_004, ADAM_MSG_SEMANTICS_DUPLICATE,
              NoArgs().Str(self.FTree[LMethod].Text).Int(int64(self.FTree[LEarlier].Place.Line)));
            self.FTree[LMethod].AddFlag(NodeFlag.Repeated);
            leave;
          end;
          if (self.FTree[LEarlier].Kind = NodeKind.MethodDecl) and
            (self.FTree[LEarlier].Text = self.FTree[LMethod].Text) and self.DoSameParameters(LEarlier, LMethod) then
            self.DoError(LMethod, ADAM_ERR_SEMANTICS_324, ADAM_MSG_SEMANTICS_METHOD_SAME,
              NoArgs().Str(self.DoText(AType)).Str(self.FTree[LMethod].Text).Int(int64(self.FTree[LEarlier].Place.Line)));
            self.FTree[LMethod].AddFlag(NodeFlag.Repeated);
            leave;
          end;
        end;
      end;
    end;

    // The inits of the type AType (body ABody) overload by parameter types (BNF sec 4): an
    // init with the same parameter types as an earlier one is SM0324 at it, once
    hidden method DoInitOverloads(const AType: int64; const ABody: int64);
    var
      LI: int64;
      LJ: int64;
      LInit: int64;
      LEarlier: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LInit := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        if self.FTree[LInit].Kind <> NodeKind.InitDecl then
          skip;
        end;
        for LJ := 0 to LI - 1 do
          LEarlier := self.FTree.NthOf(ABody, NodeRole.Member, LJ);
          if (self.FTree[LEarlier].Kind = NodeKind.InitDecl) and self.DoSameParameters(LEarlier, LInit) then
            self.DoError(LInit, ADAM_ERR_SEMANTICS_324, ADAM_MSG_SEMANTICS_INIT_SAME,
              NoArgs().Str(self.DoText(AType)).Int(int64(self.FTree[LEarlier].Place.Line)));
            self.FTree[LInit].AddFlag(NodeFlag.Repeated);
            leave;
          end;
        end;
      end;
    end;

    // The member names of the type AType (body ABody: a record, an object, an overlay, a
    // choices, an interface; BNF sec 4): no two of its own members share a name but methods
    // (they overload, MO1: DoMethodOverloads), SM0004 at the later one; and none
    // reuses a name of its parent chain (SM0309), but a method a parent method's (it
    // hides it, or overrides a virtual one: D7) and a property a parent property's
    hidden method DoMemberNames(const AType: int64; const ABody: int64);
    var
      LMembers: Int64Array;
      LFirst: ref StringIdMap;
      LI: int64;
      LMember: int64;
      LEarlier: int64;
      LParent: int64;
      LInherited: int64;
      LKind: NodeKind;
    begin
      setlength(LMembers, 0);
      self.DoNamedMembers(ABody, LMembers);
      LFirst := ref StringIdMap(0);
      for LI := 0 to len(LMembers) - 1 do
        LMember := LMembers[LI];
        if IsUnnamedField(self.FTree, LMember) then
          // any number of unnamed bitfields (M9e0c): they declare no name
          skip;
        end;
        LEarlier := LFirst.Find(self.FTree[LMember].Text);
        if (LEarlier <> 0) and (self.FTree[LEarlier].Kind = NodeKind.MethodDecl) and
          (self.FTree[LMember].Kind = NodeKind.MethodDecl) then
          // methods of one name overload (MO1: DoMethodOverloads judges their parameters)
          skip;
        end;
        if LEarlier <> 0 then
          self.DoError(LMember, ADAM_ERR_SEMANTICS_004, ADAM_MSG_SEMANTICS_MEMBER_DUPLICATE,
            NoArgs().Str(self.FTree[LMember].Text).Str(self.DoText(AType))
            .Int(int64(self.FTree[LEarlier].Place.Line)));
          self.FTree[LMember].AddFlag(NodeFlag.Repeated);
        else
          LFirst.Put(self.FTree[LMember].Text, LMember);
        end;
      end;
      // The parent chain: only a record's record parent and an object's object parent
      // (any other parent is SM0308 already)
      LParent := ParentTypeOf(self.FTree, AType);
      if LParent = 0 then
        return;
      end;
      if not (((self.FTree[ABody].Kind = NodeKind.RecordType) and
        (self.DoClass(LParent) = TypeClass.RecordType)) or
        ((self.FTree[ABody].Kind = NodeKind.ObjectType) and
        (self.DoClass(LParent) = TypeClass.ObjectType))) then
        return;
      end;
      for LI := 0 to len(LMembers) - 1 do
        LMember := LMembers[LI];
        LInherited := MemberOf(self.FTree, LParent, self.FTree[LMember].Text);
        if (LInherited <> 0) and self.DoIsNamedMember(self.FTree[LInherited].Kind) then
          LKind := self.FTree[LMember].Kind;
          if not (((LKind = NodeKind.MethodDecl) and
            (self.FTree[LInherited].Kind = NodeKind.MethodDecl)) or
            ((LKind = NodeKind.PropertyDecl) and
            (self.FTree[LInherited].Kind = NodeKind.PropertyDecl))) then
            self.DoError(LMember, ADAM_ERR_SEMANTICS_309, ADAM_MSG_SEMANTICS_PARENT_NAME,
              NoArgs().Str(self.FTree[LMember].Text).Str(self.DoText(LParent)));
          end;
        end;
      end;
    end;

    // The parent a record type AType (body ABody) names is a record (BNF sec 4: SM0308 at
    // it for any other type, an object, an alias of a scalar, a choices)
    hidden method DoRecordParent(const AType: int64; const ABody: int64);
    var
      LParent: int64;
    begin
      LParent := ParentTypeOf(self.FTree, AType);
      if (LParent <> 0) and (self.DoClass(LParent) <> TypeClass.RecordType) then
        self.DoError(self.FTree.FirstOf(ABody, NodeRole.Parent), ADAM_ERR_SEMANTICS_308,
          ADAM_MSG_SEMANTICS_RECORD_PARENT, NoArgs().Str(self.DoText(LParent)));
      end;
    end;

    // The operators the record or object type AType (body ABody) declares (BNF sec 4
    // operator decl): each one's shape (DoOperatorShape), no two of one symbol with one set
    // of operand types (SM0383, a hint at the first), = and <> as a pair of the same
    // operand types (DoOperatorPair: SM0386)
    hidden method DoOperatorRules(const AType: int64; const ABody: int64);
    var
      LI: int64;
      LJ: int64;
      LMember: int64;
      LOther: int64;
      LTwice: bool;
    begin
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        if (self.FTree[LMember].Kind = NodeKind.OperatorDecl) and self.DoOperatorShape(AType, LMember) then
          LTwice := false;
          LJ := 0;
          while (LJ < LI) and not LTwice do
            LOther := self.FTree.NthOf(ABody, NodeRole.Member, LJ);
            if self.DoSameOperator(LOther, LMember, self.FTree[LMember].Op) then
              self.DoError(LMember, ADAM_ERR_SEMANTICS_383, ADAM_MSG_SEMANTICS_OPERATOR_TWICE,
                NoArgs().Str(self.FTree[LMember].Text).Str(self.DoText(AType)));
              self.FTree[LMember].AddFlag(NodeFlag.Repeated);
              self.FDiagnostics.Add(Severity.Hint, ADAM_ERR_SEMANTICS_383, self.FTree[LOther].Place,
                ADAM_MSG_SEMANTICS_OPERATOR_HERE, NoArgs().Str(self.FTree[LOther].Text).Str(self.DoText(AType)));
              LTwice := true;
            end;
            LJ := LJ + 1;
          end;
          if not LTwice then
            self.DoOperatorPair(AType, ABody, LMember);
          end;
        end;
      end;
    end;

    // True when the operator AOperator of the type AType has its shape, reported where
    // not: two operands, or one for `-` (the unary minus) (SM0380); none of them var
    // (SM0384); one of them AType (SM0381); a bool from = <> < <= > >= in (SM0382). An
    // operand or result type that is unknown was reported where it was lost: false, silent
    hidden method DoOperatorShape(const AType: int64; const AOperator: int64): bool;
    var
      LCount: int64;
      LArity: string;
      LI: int64;
      LParam: int64;
      LOk: bool;
      LOwns: bool;
      LReturn: int64;
      LResult: int64;
    begin
      if self.FTree[AOperator].HasFlag(NodeFlag.Recovered) or (self.FTree[AOperator].Op = OperatorKind.None) then
        return false;
      end;
      LCount := self.FTree.CountOf(AOperator, NodeRole.Param);
      // hash takes one operand (BNF sec 4, M10g), `-` one or two, any other two
      if ((self.FTree[AOperator].Op = OperatorKind.Hash) and (LCount <> 1)) or
        ((self.FTree[AOperator].Op <> OperatorKind.Hash) and
        not ((LCount = 2) or ((LCount = 1) and (self.FTree[AOperator].Op = OperatorKind.Subtract)))) then
        LArity := ADAM_MSG_SEMANTICS_OPERATOR_TWO;
        if self.FTree[AOperator].Op = OperatorKind.Subtract then
          LArity := ADAM_MSG_SEMANTICS_OPERATOR_MINUS;
        end;
        if self.FTree[AOperator].Op = OperatorKind.Hash then
          LArity := ADAM_MSG_SEMANTICS_OPERATOR_ONE;
        end;
        self.DoError(AOperator, ADAM_ERR_SEMANTICS_380, ADAM_MSG_SEMANTICS_OPERATOR_ARITY,
          NoArgs().Str(self.FTree[AOperator].Text).Str(LArity));
        return false;
      end;
      LOk := true;
      LOwns := false;
      for LI := 0 to LCount - 1 do
        LParam := self.FTree.NthOf(AOperator, NodeRole.Param, LI);
        if self.FTree[LParam].HasFlag(NodeFlag.VarParam) then
          self.DoError(LParam, ADAM_ERR_SEMANTICS_384, ADAM_MSG_SEMANTICS_OPERATOR_VAR,
            NoArgs().Str(self.FTree[AOperator].Text).Str(self.FTree[LParam].Text));
          LOk := false;
        end;
        if self.DoDeclType(LParam) = 0 then
          LOk := false;
        end;
        if self.DoDeclType(LParam) = AType then
          LOwns := true;
        end;
      end;
      if not LOk then
        return false;
      end;
      if not LOwns then
        self.DoError(AOperator, ADAM_ERR_SEMANTICS_381, ADAM_MSG_SEMANTICS_OPERATOR_OWN_TYPE,
          NoArgs().Str(self.FTree[AOperator].Text).Str(self.DoText(AType)).Str(self.DoText(AType)));
        return false;
      end;
      if not self.DoGivesBool(self.FTree[AOperator].Op) and (self.FTree[AOperator].Op <> OperatorKind.Hash) then
        return true;
      end;
      LReturn := self.FTree.FirstOf(AOperator, NodeRole.ReturnType);
      if LReturn = 0 then
        return false;
      end;
      LResult := CanonicalOf(self.FTree, LReturn);
      if LResult = 0 then
        return false;
      end;
      // hash gives a uint64 (BNF sec 4, M10g), at SM0382 as a comparison's bool
      if self.FTree[AOperator].Op = OperatorKind.Hash then
        if LResult <> self.DoBuiltin("uint64") then
          self.DoError(LReturn, ADAM_ERR_SEMANTICS_382, ADAM_MSG_SEMANTICS_OPERATOR_HASH,
            NoArgs().Str(self.DoText(LResult)));
          return false;
        end;
        return true;
      end;
      if LResult <> self.DoBuiltin("bool") then
        self.DoError(LReturn, ADAM_ERR_SEMANTICS_382, ADAM_MSG_SEMANTICS_OPERATOR_BOOL,
          NoArgs().Str(self.FTree[AOperator].Text).Str(self.DoText(LResult)));
        return false;
      end;
      return true;
    end;

    // True for the operators a type declares that give a bool: = <> < <= > >= in
    hidden const method DoGivesBool(const AOp: OperatorKind): bool;
    begin
      return (AOp = OperatorKind.Equal) or (AOp = OperatorKind.NotEqual) or
        (AOp = OperatorKind.Less) or (AOp = OperatorKind.LessEqual) or
        (AOp = OperatorKind.Greater) or (AOp = OperatorKind.GreaterEqual) or
        (AOp = OperatorKind.In);
    end;

    // True when AOther is an operator declaration of the meaning AOp that takes the same
    // operand types as the operator AOperator (their count, each one's type)
    hidden method DoSameOperator(const AOther: int64; const AOperator: int64; const AOp: OperatorKind): bool;
    var
      LCount: int64;
      LI: int64;
    begin
      if (self.FTree[AOther].Kind <> NodeKind.OperatorDecl) or self.FTree[AOther].HasFlag(NodeFlag.Recovered) or
        (self.FTree[AOther].Op <> AOp) then
        return false;
      end;
      LCount := self.FTree.CountOf(AOperator, NodeRole.Param);
      if self.FTree.CountOf(AOther, NodeRole.Param) <> LCount then
        return false;
      end;
      for LI := 0 to LCount - 1 do
        if self.DoDeclType(self.FTree.NthOf(AOther, NodeRole.Param, LI)) <>
          self.DoDeclType(self.FTree.NthOf(AOperator, NodeRole.Param, LI)) then
          return false;
        end;
      end;
      return true;
    end;

    // = and <> come as a pair (BNF sec 4, D13): the operator AOperator of the type AType
    // (body ABody), an = or a <>, needs its partner with the same operand types declared
    // beside it (SM0386): a type never has one meaning of = and another (or none) of <>
    hidden method DoOperatorPair(const AType: int64; const ABody: int64; const AOperator: int64);
    var
      LPartner: OperatorKind;
      LPartnerText: string;
      LI: int64;
    begin
      if self.FTree[AOperator].Op = OperatorKind.Equal then
        LPartner := OperatorKind.NotEqual;
        LPartnerText := "<>";
      else
        if self.FTree[AOperator].Op = OperatorKind.NotEqual then
          LPartner := OperatorKind.Equal;
          LPartnerText := "=";
        else
          return;
        end;
      end;
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        if self.DoSameOperator(self.FTree.NthOf(ABody, NodeRole.Member, LI), AOperator, LPartner) then
          return;
        end;
      end;
      self.DoError(AOperator, ADAM_ERR_SEMANTICS_386, ADAM_MSG_SEMANTICS_OPERATOR_PAIR,
        NoArgs().Str(self.FTree[AOperator].Text).Str(self.DoText(AType)).Str(LPartnerText));
    end;

    // An interface type declaration AType with body ABody: a method its parent
    // interfaces already declare is not declared again (SM0368)
    hidden method DoInterfaceRules(const AType: int64; const ABody: int64);
    var
      LParent: int64;
      LI: int64;
      LMember: int64;
      LUp: int64;
    begin
      LParent := ParentTypeOf(self.FTree, AType);
      if LParent = 0 then
        return;
      end;
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        if self.FTree[LMember].Kind = NodeKind.MethodDecl then
          // a method of the parent's name and parameter types: another overload is new (MO1)
          LUp := MethodLike(self.FTree, LParent, LMember);
          if LUp <> 0 then
            self.DoErrorName(LMember, ADAM_ERR_SEMANTICS_368, ADAM_MSG_SEMANTICS_INTERFACE_REPEAT,
              NoArgs().Str(self.FTree[LMember].Text).Str(self.DoText(AType)).Str(
              self.DoText(self.DoDeclaringType(LUp))));
          end;
        end;
      end;
    end;

    // The routine, method, init, operator or accessor whose body holds AId, through any
    // func literal between (F2a: a literal in a method is that method's code); 0 when none
    // does (a module's body, a test block)
    hidden const method DoEnclosingRoutine(const AId: int64): int64;
    var
      LAt: int64;
    begin
      LAt := self.FTree.ParentOf(AId);
      while LAt <> 0 do
        if IsRoutineLike(self.FTree[LAt].Kind) then
          return LAt;
        end;
        if self.FTree[LAt].Kind = NodeKind.Module then
          return 0;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // The routine-like declaration or the func literal (F2a) whose body holds AId, the
    // innermost: what a return returns from; 0 when none does (a module's body, a test
    // block). DoEnclosingRoutine passes literals by (a const method's self, an accessor)
    hidden const method DoEnclosingBody(const AId: int64): int64;
    var
      LAt: int64;
    begin
      LAt := self.FTree.ParentOf(AId);
      while LAt <> 0 do
        if IsRoutineLike(self.FTree[LAt].Kind) or (self.FTree[LAt].Kind = NodeKind.FuncLiteral) then
          return LAt;
        end;
        if self.FTree[LAt].Kind = NodeKind.Module then
          return 0;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // The type expression of what the routine-like ARoutine returns: its ReturnType, or
    // for a property's read accessor the property's type; 0 when it returns nothing
    hidden const method DoReturnTypeNode(const ARoutine: int64): int64;
    begin
      if ARoutine = 0 then
        return 0;
      end;
      if self.FTree[ARoutine].Kind = NodeKind.PropertyRead then
        return self.FTree.FirstOf(self.FTree.ParentOf(ARoutine), NodeRole.TypeOf);
      end;
      return self.FTree.FirstOf(ARoutine, NodeRole.ReturnType);
    end;

    // True when the way from AId out to AOuter, a node around it (0: as far as its
    // module), leaves a guard's finally body
    hidden const method DoCrossesFinally(const AId: int64; const AOuter: int64): bool;
    var
      LAt: int64;
      LParent: int64;
    begin
      LAt := AId;
      LParent := self.FTree.ParentOf(LAt);
      while (LParent <> 0) and (LParent <> AOuter) do
        if (self.FTree[LParent].Kind = NodeKind.GuardStatement) and
          (self.FTree.RoleOf(LAt) = NodeRole.Finally) then
          return true;
        end;
        if self.FTree[LParent].Kind = NodeKind.Module then
          return false;
        end;
        LAt := LParent;
        LParent := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // True when the way from AId out to AOuter, a node around it (0: as far as its
    // module), leaves a defer statement's statement (D1: it runs as its list ends, so it
    // cannot jump anywhere outside itself)
    hidden const method DoCrossesDefer(const AId: int64; const AOuter: int64): bool;
    var
      LAt: int64;
      LParent: int64;
    begin
      LAt := AId;
      LParent := self.FTree.ParentOf(LAt);
      while (LParent <> 0) and (LParent <> AOuter) do
        if self.FTree[LParent].Kind = NodeKind.DeferStatement then
          return true;
        end;
        if self.FTree[LParent].Kind = NodeKind.Module then
          return false;
        end;
        LAt := LParent;
        LParent := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // SM0718 when the defer statement AId's statement is a declaration (a var / const /
    // type block): what it declares would live in no statement list (D1)
    hidden method DoDeferDecl(const AId: int64);
    var
      LStatement: int64;
      LKind: NodeKind;
    begin
      LStatement := self.FTree.FirstOf(AId, NodeRole.Statement);
      if LStatement = 0 then
        return;
      end;
      LKind := self.FTree[LStatement].Kind;
      if (LKind = NodeKind.VarDecl) or (LKind = NodeKind.ConstDecl) or
        (LKind = NodeKind.TypeDecl) then
        self.DoError(LStatement, ADAM_ERR_SEMANTICS_718, ADAM_MSG_SEMANTICS_DEFER_DECL, NoArgs());
      end;
    end;

    // The innermost loop around the leave / skip AId in its own routine (AMatch: or
    // match, whichever is nearer); 0 when there is none
    hidden const method DoInnermostLoop(const AId: int64; const AMatch: bool): int64;
    var
      LAt: int64;
      LKind: NodeKind;
    begin
      LAt := self.FTree.ParentOf(AId);
      while LAt <> 0 do
        LKind := self.FTree[LAt].Kind;
        if (LKind = NodeKind.WhileStatement) or (LKind = NodeKind.ForStatement) or
          (LKind = NodeKind.ForInStatement) or (LKind = NodeKind.RepeatStatement) then
          return LAt;
        end;
        if AMatch and (LKind = NodeKind.MatchStatement) then
          return LAt;
        end;
        // an async block's task leaves no loop around the async (T4), a func literal's
        // closure none around the literal (F2a)
        if IsRoutineLike(LKind) or (LKind = NodeKind.Module) or (LKind = NodeKind.TestBlock) or
          (LKind = NodeKind.AsyncExpression) or (LKind = NodeKind.FuncLiteral) then
          return 0;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // leave / skip (BNF sec 5): leave leaves the innermost loop or match, skip continues
    // the innermost loop (a match between is passed by); the statement it leaves into its
    // ResolvedJump. None around it: SM0607 / SM0608; out of a finally body: SM0609
    hidden method DoJump(const AId: int64);
    var
      LLeave: bool;
      LTarget: int64;
      LWord: string;
    begin
      LLeave := self.FTree[AId].Kind = NodeKind.LeaveStatement;
      LTarget := self.DoInnermostLoop(AId, LLeave);
      if LTarget = 0 then
        if LLeave then
          self.DoError(AId, ADAM_ERR_SEMANTICS_607, ADAM_MSG_SEMANTICS_LEAVE_OUTSIDE, NoArgs());
        else
          self.DoError(AId, ADAM_ERR_SEMANTICS_608, ADAM_MSG_SEMANTICS_SKIP_OUTSIDE, NoArgs());
        end;
        return;
      end;
      if self.DoCrossesFinally(AId, LTarget) then
        LWord := "skip";
        if LLeave then
          LWord := "leave";
        end;
        self.DoError(AId, ADAM_ERR_SEMANTICS_609, ADAM_MSG_SEMANTICS_JUMP_FINALLY,
          NoArgs().Str(LWord));
        return;
      end;
      if self.DoCrossesDefer(AId, LTarget) then
        LWord := "skip";
        if LLeave then
          LWord := "leave";
        end;
        self.DoError(AId, ADAM_ERR_SEMANTICS_717, ADAM_MSG_SEMANTICS_JUMP_DEFER,
          NoArgs().Str(LWord));
        return;
      end;
      self.FTree[AId].ResolvedJump := LTarget;
    end;

    // True when the expression statement AId is a call that never returns: of the raise or
    // raisecode intrinsic, or of a routine written noreturn (its full or its forward: they
    // agree, DoRoutineFact)
    hidden const method DoIsEndingCall(const AId: int64): bool;
    var
      LValue: int64;
      LCallee: int64;
      LKind: NodeKind;
    begin
      LValue := self.FTree.FirstOf(AId, NodeRole.Value);
      if (LValue = 0) or (self.FTree[LValue].Kind <> NodeKind.CallExpression) then
        return false;
      end;
      LCallee := self.DoCalleeDecl(self.FTree.FirstOf(LValue, NodeRole.Callee));
      if LCallee = 0 then
        return false;
      end;
      LKind := self.FTree[LCallee].Kind;
      if LKind = NodeKind.IntrinsicDecl then
        return (self.FTree[LCallee].Text = "raise") or (self.FTree[LCallee].Text = "raisecode");
      end;
      return ((LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine)) and
        self.FTree[LCallee].HasFlag(NodeFlag.NoReturn);
    end;

    // True when some leave under AAt leaves the loop ALoop (its ResolvedJump: a leave
    // leaves the innermost loop or match, so one in a nested loop or match leaves that one)
    hidden const method DoLeaves(const AAt: int64; const ALoop: int64): bool;
    var
      LI: int64;
    begin
      if (self.FTree[AAt].Kind = NodeKind.LeaveStatement) and
        (self.FTree[AAt].ResolvedJump = ALoop) then
        return true;
      end;
      for LI := 0 to self.FTree.ChildCount(AAt) - 1 do
        if self.DoLeaves(self.FTree.ChildAt(AAt, LI), ALoop) then
          return true;
        end;
      end;
      return false;
    end;

    // True when the while statement AId never completes: its condition is the literal true
    // (in parentheses or not) and no leave leaves it (a return, a raise or a noreturn call
    // in it ends the routine, not the loop)
    hidden const method DoIsEndless(const AId: int64): bool;
    var
      LCondition: int64;
    begin
      LCondition := self.DoSkipParens(self.FTree.FirstOf(AId, NodeRole.Condition));
      if (LCondition = 0) or (self.FTree[LCondition].Kind <> NodeKind.BoolLiteral) or
        (self.FTree[LCondition].Text <> "true") then
        return false;
      end;
      return not self.DoLeaves(AId, AId);
    end;

    // True when a statement of AId's ARole list ends the path (DoStatementEnds): the list
    // then never completes. An empty list completes
    hidden const method DoListEnds(const AId: int64; const ARole: NodeRole): bool;
    var
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AId, ARole) - 1 do
        if self.DoStatementEnds(self.FTree.NthOf(AId, ARole, LI)) then
          return true;
        end;
      end;
      return false;
    end;

    // True when control never reaches the statement after AId: a return, a call that never
    // returns (DoIsEndingCall), a leave or a skip, a while that never completes
    // (DoIsEndless), or a compound statement none of whose ways out completes (a block or
    // lock whose list ends; an if with an else, both lists ending; a match with an else,
    // the else and every arm ending; a guard whose statements end, its except part too when
    // it has one; a trylock whose statements and else both end)
    hidden const method DoStatementEnds(const AId: int64): bool;
    var
      LI: int64;
    begin
      match self.FTree[AId].Kind of
        NodeKind.ReturnStatement, NodeKind.LeaveStatement, NodeKind.SkipStatement:
          return true;
        NodeKind.ExpressionStatement:
          return self.DoIsEndingCall(AId);
        NodeKind.WhileStatement:
          return self.DoIsEndless(AId);
        NodeKind.Block, NodeKind.LockStatement:
          return self.DoListEnds(AId, NodeRole.Statement);
        NodeKind.IfStatement:
          return self.DoListEnds(AId, NodeRole.Then) and self.DoListEnds(AId, NodeRole.Else);
        NodeKind.MatchStatement:
          if not self.DoListEnds(AId, NodeRole.Else) then
            return false;
          end;
          for LI := 0 to self.FTree.CountOf(AId, NodeRole.Arm) - 1 do
            if not self.DoListEnds(self.FTree.NthOf(AId, NodeRole.Arm, LI), NodeRole.Statement) then
              return false;
            end;
          end;
          return true;
        NodeKind.GuardStatement:
          if not self.DoListEnds(AId, NodeRole.Statement) then
            return false;
          end;
          return (not self.FTree[AId].HasFlag(NodeFlag.ExceptPart)) or
            self.DoListEnds(AId, NodeRole.Except);
        NodeKind.TryLockStatement:
          return self.DoListEnds(AId, NodeRole.Statement) and
            self.DoListEnds(AId, NodeRole.Else);
      else
        // any other statement can complete normally
      end;
      return false;
    end;

    // True when the statement list of AId playing ARole provably returns: the first of its
    // statements that ends the path (DoStatementEnds) returns; the ones after it never run
    // (SM0622), so they cannot make it return or fall through. An empty list does not
    // return; a list holding a statement the parser could not finish is not judged (that
    // one may have returned)
    hidden const method DoListReturns(const AId: int64; const ARole: NodeRole): bool;
    var
      LCount: int64;
      LI: int64;
      LStatement: int64;
    begin
      LCount := self.FTree.CountOf(AId, ARole);
      for LI := 0 to LCount - 1 do
        LStatement := self.FTree.NthOf(AId, ARole, LI);
        if (self.FTree[LStatement].Kind = NodeKind.Error) or
          self.FTree[LStatement].HasFlag(NodeFlag.Recovered) then
          return true;
        end;
      end;
      for LI := 0 to LCount - 1 do
        LStatement := self.FTree.NthOf(AId, ARole, LI);
        if self.DoStatementEnds(LStatement) then
          return self.DoStatementReturns(LStatement);
        end;
      end;
      return false;
    end;

    // SM0622 (a warning) at the first statement of AId's ARole list that follows one that
    // ends the path (DoStatementEnds): it never runs. Once per list (the first dead
    // statement names the whole dead tail); a list holding a statement the parser could not
    // finish is not judged
    hidden method DoUnreachableIn(const AId: int64; const ARole: NodeRole);
    var
      LCount: int64;
      LI: int64;
      LStatement: int64;
    begin
      LCount := self.FTree.CountOf(AId, ARole);
      if LCount < 2 then
        return;
      end;
      for LI := 0 to LCount - 1 do
        LStatement := self.FTree.NthOf(AId, ARole, LI);
        if (self.FTree[LStatement].Kind = NodeKind.Error) or
          self.FTree[LStatement].HasFlag(NodeFlag.Recovered) then
          return;
        end;
      end;
      for LI := 0 to LCount - 2 do
        if self.DoStatementEnds(self.FTree.NthOf(AId, ARole, LI)) then
          self.FDiagnostics.Add(Severity.Warning, ADAM_ERR_SEMANTICS_622,
            self.FTree[self.FTree.NthOf(AId, ARole, LI + 1)].Place,
            ADAM_MSG_SEMANTICS_UNREACHABLE, NoArgs());
          return;
        end;
      end;
    end;

    // Every statement list AId holds checked for a dead tail (DoUnreachableIn), once its
    // statements are typed (a raise or noreturn call's callee resolved, a leave's loop); a
    // match checks its arms' lists (an arm is never judged on its own, so no list is judged
    // twice)
    hidden method DoUnreachable(const AId: int64);
    var
      LI: int64;
    begin
      if self.FTree[AId].Kind = NodeKind.MatchArm then
        return;
      end;
      self.DoUnreachableIn(AId, NodeRole.Statement);
      self.DoUnreachableIn(AId, NodeRole.Then);
      self.DoUnreachableIn(AId, NodeRole.Else);
      self.DoUnreachableIn(AId, NodeRole.Except);
      self.DoUnreachableIn(AId, NodeRole.Finally);
      if self.FTree[AId].Kind = NodeKind.MatchStatement then
        for LI := 0 to self.FTree.CountOf(AId, NodeRole.Arm) - 1 do
          self.DoUnreachableIn(self.FTree.NthOf(AId, NodeRole.Arm, LI), NodeRole.Statement);
        end;
      end;
    end;

    // True when the statement AId provably returns (PaskalCPP's DoStmtReturns): a return;
    // a call that never returns (DoIsEndingCall) or a while that never completes
    // (DoIsEndless), neither of which falls through; a block whose list returns; an if with
    // an else, both lists returning; a match with an else, the else and every arm
    // returning; a guard whose statements return, and its except part too when it has one
    hidden const method DoStatementReturns(const AId: int64): bool;
    var
      LI: int64;
    begin
      match self.FTree[AId].Kind of
        NodeKind.ReturnStatement:
          return true;
        NodeKind.ExpressionStatement:
          return self.DoIsEndingCall(AId);
        NodeKind.WhileStatement:
          return self.DoIsEndless(AId);
        NodeKind.Block:
          return self.DoListReturns(AId, NodeRole.Statement);
        NodeKind.IfStatement:
          return self.DoListReturns(AId, NodeRole.Then) and self.DoListReturns(AId, NodeRole.Else);
        NodeKind.MatchStatement:
          // No else, or an else that does not return: some value falls through
          if not self.DoListReturns(AId, NodeRole.Else) then
            return false;
          end;
          for LI := 0 to self.FTree.CountOf(AId, NodeRole.Arm) - 1 do
            if not self.DoListReturns(self.FTree.NthOf(AId, NodeRole.Arm, LI), NodeRole.Statement) then
              return false;
            end;
          end;
          return true;
        NodeKind.GuardStatement:
          if not self.DoListReturns(AId, NodeRole.Statement) then
            return false;
          end;
          return (not self.FTree[AId].HasFlag(NodeFlag.ExceptPart)) or
            self.DoListReturns(AId, NodeRole.Except);
        NodeKind.LockStatement:
          return self.DoListReturns(AId, NodeRole.Statement);
        NodeKind.TryLockStatement:
          // Not taken, the else statements run (none: it falls through)
          return self.DoListReturns(AId, NodeRole.Statement) and
            self.DoListReturns(AId, NodeRole.Else);
      else
        // any other statement can complete normally
      end;
      return false;
    end;

    // SM0624 at each return under AAt, the body (or a part of it) of the noreturn routine
    // ARoutine: it never returns to its caller
    hidden method DoNoReturnReturns(const AAt: int64; const ARoutine: int64);
    var
      LI: int64;
    begin
      if self.FTree[AAt].Kind = NodeKind.ReturnStatement then
        self.DoError(AAt, ADAM_ERR_SEMANTICS_624, ADAM_MSG_SEMANTICS_NORETURN_RETURN,
          NoArgs().Str(self.FTree[ARoutine].Text));
        return;
      end;
      for LI := 0 to self.FTree.ChildCount(AAt) - 1 do
        self.DoNoReturnReturns(self.FTree.ChildAt(AAt, LI), ARoutine);
      end;
    end;

    // The body LBody of the noreturn routine AId: SM0624 at each return in it, SM0623 at the
    // declaration when the body can reach its end (no statement of it ends the path:
    // DoListEnds). A body holding a statement the parser could not finish is not judged for
    // its end (that one may have ended it)
    hidden method DoNoReturnBody(const AId: int64; const ABody: int64);
    var
      LI: int64;
      LStatement: int64;
    begin
      self.DoNoReturnReturns(ABody, AId);
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Statement) - 1 do
        LStatement := self.FTree.NthOf(ABody, NodeRole.Statement, LI);
        if (self.FTree[LStatement].Kind = NodeKind.Error) or
          self.FTree[LStatement].HasFlag(NodeFlag.Recovered) then
          return;
        end;
      end;
      if not self.DoListEnds(ABody, NodeRole.Statement) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_623, ADAM_MSG_SEMANTICS_NORETURN_END,
          NoArgs().Str(self.FTree[AId].Text));
      end;
    end;

    // A routine, method or operator AId with a body: a noreturn one's body checked
    // (DoNoReturnBody, which covers a result too: it never reaches its end); else, with a
    // result type, SM0612 at its declaration when its body can reach its end without
    // returning a value
    hidden method DoReturnPath(const AId: int64);
    var
      LBody: int64;
    begin
      LBody := self.FTree.FirstOf(AId, NodeRole.Body);
      if LBody = 0 then
        return;
      end;
      if self.FTree[AId].HasFlag(NodeFlag.NoReturn) then
        self.DoNoReturnBody(AId, LBody);
        return;
      end;
      // a generator may end anywhere (G1): its end finishes it; a method returning self
      // ends with `return self;` as one with a result type does (F7)
      if ((self.FTree.FirstOf(AId, NodeRole.ReturnType) = 0) and not self.DoReturnsSelf(AId)) or
        self.FTree[AId].HasFlag(NodeFlag.Generator) then
        return;
      end;
      if self.DoListReturns(LBody, NodeRole.Statement) then
        return;
      end;
      self.DoError(AId, ADAM_ERR_SEMANTICS_612, ADAM_MSG_SEMANTICS_MISSING_RETURN,
        NoArgs().Str(self.DoBodyName(AId)));
    end;

    // The name a message gives the routine-like AId: its name, a func literal's kind words
    hidden const method DoBodyName(const AId: int64): string;
    begin
      if self.FTree[AId].Kind = NodeKind.FuncLiteral then
        return NodeKindWords(NodeKind.FuncLiteral);
      end;
      return self.FTree[AId].Text;
    end;

    // A routine, method or operator AId whose result type holds a mutex: SM0621 at the
    // result type (a mutex is never copied, so no call hands one back)
    hidden method DoMutexResult(const AId: int64);
    var
      LResult: int64;
      LType: int64;
    begin
      LResult := self.FTree.FirstOf(AId, NodeRole.ReturnType);
      if LResult = 0 then
        return;
      end;
      LType := CanonicalOf(self.FTree, LResult);
      if (LType <> 0) and HoldsMutex(self.FTree, LType) then
        self.DoError(LResult, ADAM_ERR_SEMANTICS_621, ADAM_MSG_SEMANTICS_MUTEX_RESULT,
          NoArgs().Str(self.DoBodyName(AId)).Str(self.DoText(LType)));
      end;
    end;

    // True when AExpr is a place a lock / trylock holds (BNF sec 5): assignable storage of
    // type mutex (a variable, a field, an element, P^; a property has no address)
    hidden const method DoIsMutexPlace(const AExpr: int64): bool;
    var
      LAt: int64;
      LDecl: int64;
    begin
      if self.DoIsNoValue(AExpr) or (not self.DoIsAssignable(AExpr)) then
        return false;
      end;
      LAt := self.DoSkipParens(AExpr);
      LDecl := self.FTree[LAt].ResolvedDecl;
      if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
        return false;
      end;
      return self.DoClass(self.DoTypeOf(AExpr)) = TypeClass.Mutex;
    end;

    // A lock / trylock statement AId (BNF sec 5): its subject a mutex place (DoIsMutexPlace;
    // SM0620 naming the statement and the subject otherwise, silent on a subject whose type
    // was lost); trylock's wait (its Limit) converted to int64
    hidden method DoLock(const AId: int64);
    var
      LSubject: int64;
      LLimit: int64;
      LWord: string;
    begin
      LLimit := self.FTree.FirstOf(AId, NodeRole.Limit);
      if LLimit <> 0 then
        self.DoConvert(LLimit, self.DoBuiltin("int64"));
      end;
      LSubject := self.FTree.FirstOf(AId, NodeRole.Subject);
      if (LSubject = 0) or self.DoIsMutexPlace(LSubject) then
        return;
      end;
      if (not self.DoIsNoValue(LSubject)) and (self.DoTypeOf(LSubject) = 0) then
        return;
      end;
      LWord := "lock";
      if self.FTree[AId].Kind = NodeKind.TryLockStatement then
        LWord := "trylock";
      end;
      self.DoError(LSubject, ADAM_ERR_SEMANTICS_620, ADAM_MSG_SEMANTICS_LOCK_SUBJECT,
        NoArgs().Str(LWord).Str(self.DoExprText(LSubject)));
    end;

    // True when AId stands in its module's own body (`begin .. end.`), not in a routine, a
    // section, a test block or a type's member
    hidden const method DoInModuleBody(const AId: int64): bool;
    var
      LAt: int64;
      LParent: int64;
    begin
      LAt := AId;
      LParent := self.FTree.ParentOf(LAt);
      while LParent <> 0 do
        if IsRoutineLike(self.FTree[LParent].Kind) or (self.FTree[LParent].Kind = NodeKind.FuncLiteral) then
          return false;
        end;
        if self.FTree[LParent].Kind = NodeKind.Module then
          return self.FTree.RoleOf(LAt) = NodeRole.Body;
        end;
        LAt := LParent;
        LParent := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // The runtime's public ExitCode variable (BNF sec 5); 0 when the program has none
    hidden const method DoExitCodeDecl(): int64;
    var
      LDecl: int64;
      LHidden: int64;
    begin
      if self.FTree.Runtime = 0 then
        return 0;
      end;
      LHidden := 0;
      LDecl := FindPublic(self.FTree, self.FTree.Runtime, ADAM_SEMANTICS_RUNTIME_EXIT_CODE, LHidden);
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.VarDecl) then
        return 0;
      end;
      return LDecl;
    end;

    // `return E;` in the module body (BNF sec 5, M8h; only an exe has one, BNF sec 1): it
    // sets ExitCode (its ResolvedDecl, E converted to ExitCode's type) and ends the body; a
    // program with no runtime ExitCode keeps SM0611
    hidden method DoBodyReturn(const AId: int64; const AValue: int64);
    var
      LDecl: int64;
      LType: int64;
    begin
      LDecl := self.DoExitCodeDecl();
      if (self.FTree[ModuleOf(self.FTree, AId)].Module <> ModuleKind.Exe) or (LDecl = 0) then
        self.DoError(AValue, ADAM_ERR_SEMANTICS_611, ADAM_MSG_SEMANTICS_RETURN_NO_VALUE, NoArgs());
        return;
      end;
      LType := self.DoDeclType(LDecl);
      if LType = 0 then
        // ExitCode's type was lost (reported at its declaration)
        return;
      end;
      self.FTree[AId].ResolvedDecl := LDecl;
      self.DoConvert(AValue, LType);
    end;

    // The word a dll or a lib module is named by in a message
    hidden const method DoModuleKindText(const AKind: ModuleKind): string;
    begin
      if AKind = ModuleKind.DLL then
        return "dll";
      end;
      return "lib";
    end;

    // A write of the runtime's ExitCode in a dll's or a lib's own module is SM0628, a
    // warning: its host program owns the exit code (BNF sec 5); a unit's is not judged
    // (units are shared by exe and dll builds)
    hidden method DoExitCodeWritten(const ATarget: int64);
    var
      LAt: int64;
      LDecl: int64;
      LKind: ModuleKind;
    begin
      LAt := self.DoSkipParens(ATarget);
      if (LAt = 0) or (NameKindOf(self.FTree, LAt) <> NodeKind.NameExpression) then
        return;
      end;
      LDecl := self.FTree[LAt].ResolvedDecl;
      if (LDecl = 0) or (ModuleOf(self.FTree, LDecl) <> self.FTree.Runtime) or
        (LDecl <> self.DoExitCodeDecl()) then
        return;
      end;
      LKind := self.FTree[ModuleOf(self.FTree, ATarget)].Module;
      if (LKind <> ModuleKind.DLL) and (LKind <> ModuleKind.Lib) then
        return;
      end;
      self.FDiagnostics.Add(Severity.Warning, ADAM_ERR_SEMANTICS_628, self.FTree[ATarget].Place,
        ADAM_MSG_SEMANTICS_EXIT_CODE_HOST, NoArgs().Str(self.DoModuleKindText(LKind)));
    end;

    // return [value]: the routine it leaves into its ResolvedJump; the value converts to
    // what that routine returns (a read accessor: its property's type). A value where the
    // routine returns nothing is SM0611 (an initialize / finalize or a test block returns
    // nothing; a module body's: DoBodyReturn), none where it returns one SM0610, out of a
    // finally body SM0609
    hidden method DoReturn(const AId: int64);
    var
      LRoutine: int64;
      LReturnNode: int64;
      LReturn: int64;
      LValue: int64;
    begin
      self.DoChildren(AId);
      LRoutine := self.DoEnclosingBody(AId);
      if self.DoCrossesFinally(AId, LRoutine) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_609, ADAM_MSG_SEMANTICS_JUMP_FINALLY,
          NoArgs().Str("return"));
        return;
      end;
      if self.DoCrossesDefer(AId, LRoutine) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_717, ADAM_MSG_SEMANTICS_JUMP_DEFER,
          NoArgs().Str("return"));
        return;
      end;
      self.FTree[AId].ResolvedJump := LRoutine;
      LValue := self.FTree.FirstOf(AId, NodeRole.Value);
      // a generator's return finishes it, handing nothing back (G1); a func literal is
      // never a generator (its return hands a sequence back)
      if (LRoutine <> 0) and (self.FTree[LRoutine].Kind <> NodeKind.FuncLiteral) and
        (self.DoGeneratorElement(LRoutine) <> 0) then
        if LValue <> 0 then
          self.DoError(LValue, ADAM_ERR_SEMANTICS_720, ADAM_MSG_SEMANTICS_GENERATOR_RETURN,
            NoArgs());
        end;
        return;
      end;
      // a method returning self hands back only self (F7: its call's value is its receiver)
      if self.DoReturnsSelf(LRoutine) then
        if LValue = 0 then
          self.DoError(AId, ADAM_ERR_SEMANTICS_762, ADAM_MSG_SEMANTICS_SELF_RETURN,
            NoArgs().Str(self.FTree[LRoutine].Text));
        else
          if self.FTree[self.DoSkipParens(LValue)].Kind <> NodeKind.SelfExpression then
            self.DoError(LValue, ADAM_ERR_SEMANTICS_762, ADAM_MSG_SEMANTICS_SELF_RETURN,
              NoArgs().Str(self.FTree[LRoutine].Text));
          end;
        end;
        return;
      end;
      LReturnNode := self.DoReturnTypeNode(LRoutine);
      if LReturnNode = 0 then
        if LValue <> 0 then
          if (LRoutine = 0) and self.DoInModuleBody(AId) then
            self.DoBodyReturn(AId, LValue);
          else
            self.DoError(LValue, ADAM_ERR_SEMANTICS_611, ADAM_MSG_SEMANTICS_RETURN_NO_VALUE,
              NoArgs());
          end;
        end;
        return;
      end;
      LReturn := CanonicalOf(self.FTree, LReturnNode);
      if LReturn = 0 then
        // The return type was lost (reported where it was)
        return;
      end;
      if LValue = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_610, ADAM_MSG_SEMANTICS_RETURN_NEEDS,
          NoArgs().Str(self.DoText(LReturn)));
        return;
      end;
      self.DoOwnMoves(LValue, true);
      self.DoConvert(LValue, LReturn);
      // a variable's C string fields' borrowed strings never leave with it (F4: SM0760)
      if HoldsCText(self.FTree, LReturn) and (self.DoHoldRoot(LValue, false) <> 0) then
        self.FTree[self.DoSkipParens(LValue)].ResolvedJump := self.DoHoldRoot(LValue, false);
        self.FHoldReturns.Add(LValue);
      end;
    end;

    // What the for iterator's name ADecl is when it is no variable (SM0600's second part);
    // "" for a var or a parameter that is not const (BNF sec 5: a variable declared before
    // the loop)
    hidden const method DoNotVariableText(const ADecl: int64): string;
    var
      LKind: NodeKind;
    begin
      LKind := self.FTree[ADecl].Kind;
      if LKind = NodeKind.VarDecl then
        return "";
      end;
      if LKind = NodeKind.Param then
        if self.FTree[ADecl].HasFlag(NodeFlag.ConstParam) then
          return ADAM_MSG_SEMANTICS_KIND_CONST_PARAM;
        end;
        return "";
      end;
      if LKind = NodeKind.ConstDecl then
        return ADAM_MSG_SEMANTICS_KIND_CONST;
      end;
      if (LKind = NodeKind.TypeDecl) or (LKind = NodeKind.BuiltinTypeDecl) or
        (LKind = NodeKind.ForwardType) then
        return ADAM_MSG_SEMANTICS_KIND_TYPE;
      end;
      if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
        (LKind = NodeKind.IntrinsicDecl) then
        return ADAM_MSG_SEMANTICS_KIND_ROUTINE;
      end;
      // A member (field, method, property) or a choice value named bare never resolves:
      // the resolver reports it (SM0018 / SM0015)
      return ADAM_MSG_SEMANTICS_KIND_OTHER;
    end;

    // The for statement whose body AId stands in (at any depth, inside its own routine) and
    // whose iterator names ADecl; 0 when there is none. Only the body counts: a for's
    // bounds are evaluated before its loop begins
    hidden const method DoLoopOver(const AId: int64; const ADecl: int64): int64;
    var
      LChild: int64;
      LAt: int64;
      LKind: NodeKind;
    begin
      LChild := AId;
      LAt := self.FTree.ParentOf(AId);
      while LAt <> 0 do
        LKind := self.FTree[LAt].Kind;
        // a for parallel's iterator is its own VarDecl (T2), a for's a name of one
        if ((LKind = NodeKind.ForStatement) or (LKind = NodeKind.ForInStatement)) and
          (self.FTree.RoleOf(LChild) = NodeRole.Statement) and
          ((self.FTree.FirstOf(LAt, NodeRole.Iterator) = ADecl) or
          (self.FTree[self.FTree.FirstOf(LAt, NodeRole.Iterator)].ResolvedDecl = ADecl)) then
          return LAt;
        end;
        // an async block writes no iterator around the async: it copies it (SM0714, T4)
        if IsRoutineLike(LKind) or (LKind = NodeKind.Module) or (LKind = NodeKind.TestBlock) or
          (LKind = NodeKind.AsyncExpression) then
          return 0;
        end;
        LChild := LAt;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // The for AFor's iterator AIterator (BNF sec 5): a variable (SM0600) that is not already
    // the iterator of a for AFor stands in (a nested for over it writes it: SM0602), of an
    // integer, char, wchar or choices type (SM0601); each reported at AFor. False when the
    // bounds have no iterator type to convert to (a name or type lost before included)
    hidden method DoIsIterator(const AFor: int64; const AIterator: int64): bool;
    var
      LType: int64;
      LClass: TypeClass;
    begin
      if not self.DoIsIteratorVar(AFor, AIterator) then
        return false;
      end;
      LType := self.DoTypeOf(AIterator);
      LClass := self.DoClass(LType);
      if LClass = TypeClass.Unknown then
        return false;
      end;
      if IsIntegerClass(LClass) or (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) or
        (LClass = TypeClass.ChoicesType) then
        return true;
      end;
      self.DoError(AFor, ADAM_ERR_SEMANTICS_601, ADAM_MSG_SEMANTICS_FOR_TYPE,
        NoArgs().Str(self.DoText(LType)));
      return false;
    end;

    // The for / for in AFor's iterator AIterator is a variable (SM0600) that is not already
    // the iterator of a loop AFor stands in (SM0602) nor one an async block around AFor
    // copies (SM0714); each reported at AFor. False when it is no variable or found nowhere
    hidden method DoIsIteratorVar(const AFor: int64; const AIterator: int64): bool;
    var
      LDecl: int64;
      LKind: string;
    begin
      LDecl := self.FTree[AIterator].ResolvedDecl;
      if LDecl = 0 then
        // Found nowhere: reported where it was resolved (a bare module name included)
        return false;
      end;
      LKind := self.DoNotVariableText(LDecl);
      if LKind <> "" then
        self.DoError(AFor, ADAM_ERR_SEMANTICS_600, ADAM_MSG_SEMANTICS_FOR_NOT_VAR,
          NoArgs().Str(self.FTree[AIterator].Text).Str(LKind));
        return false;
      end;
      if self.DoLoopOver(AFor, LDecl) <> 0 then
        self.DoError(AFor, ADAM_ERR_SEMANTICS_602, ADAM_MSG_SEMANTICS_ITERATOR_WRITE,
          NoArgs().Str(self.FTree[AIterator].Text));
      end;
      // a for inside an async block over a variable the block copies would write it (T4)
      if self.DoAsyncCopy(AFor, LDecl) <> 0 then
        self.DoError(AFor, ADAM_ERR_SEMANTICS_714, ADAM_MSG_SEMANTICS_ASYNC_WRITE,
          NoArgs().Str(self.FTree[AIterator].Text));
      end;
      return true;
    end;

    // The element type a for in walks over a value of AType (BNF sec 5, G1): a sequence's
    // T, an array's element, a string's char, a wstring's wchar, a set's member; 0 for any
    // other type
    hidden const method DoForInElement(const AType: int64): int64;
    begin
      match self.DoClass(AType) of
        TypeClass.SequenceType, TypeClass.StaticArray, TypeClass.DynamicArray:
          return TargetOf(self.FTree, AType);
        TypeClass.Text:
          return self.DoBuiltin("char");
        TypeClass.WideText:
          return self.DoBuiltin("wchar");
        TypeClass.SetType:
          return SetMemberOf(self.FTree, AType);
      else
        return 0;
      end;
    end;

    // for X in S (BNF sec 5, G1): X a variable (DoIsIteratorVar) of the element type S
    // walks (SM0723); S a sequence, an array, a string, a wstring or a set (SM0722). Its
    // ResolvedType is the element type (Lowering reads it)
    hidden method DoForIn(const AId: int64);
    var
      LIterator: int64;
      LSubject: int64;
      LSubjectType: int64;
      LElement: int64;
      LType: int64;
    begin
      self.DoChildren(AId);
      LIterator := self.FTree.FirstOf(AId, NodeRole.Iterator);
      LSubject := self.FTree.FirstOf(AId, NodeRole.Value);
      if (LIterator = 0) or (LSubject = 0) then
        return;
      end;
      LSubjectType := self.DoTypeOf(LSubject);
      if (LSubjectType = 0) or (self.DoClass(LSubjectType) = TypeClass.Unknown) then
        // lost where it was reported
        return;
      end;
      LElement := self.DoForInElement(LSubjectType);
      if LElement = 0 then
        self.DoError(LSubject, ADAM_ERR_SEMANTICS_722, ADAM_MSG_SEMANTICS_FOR_IN_SUBJECT,
          NoArgs().Str(self.DoText(LSubjectType)));
        return;
      end;
      self.FTree[AId].ResolvedType := LElement;
      if not self.DoIsIteratorVar(AId, LIterator) then
        return;
      end;
      LType := self.DoTypeOf(LIterator);
      if (LType <> 0) and (LType <> LElement) then
        self.DoError(LIterator, ADAM_ERR_SEMANTICS_723, ADAM_MSG_SEMANTICS_FOR_IN_TYPE,
          NoArgs().Str(self.FTree[LIterator].Text).Str(self.DoText(LType)).Str(self.DoText(LElement)));
      end;
    end;

    // The element type of the routine-like ARoutine's sequence result when it is a generator
    // (its result type a sequence of T: BNF sec 5, G1); 0 for any other routine and for none
    hidden const method DoGeneratorElement(const ARoutine: int64): int64;
    var
      LReturnNode: int64;
      LReturn: int64;
    begin
      LReturnNode := self.DoReturnTypeNode(ARoutine);
      if LReturnNode = 0 then
        return 0;
      end;
      LReturn := CanonicalOf(self.FTree, LReturnNode);
      if (LReturn = 0) or (self.DoClass(LReturn) <> TypeClass.SequenceType) then
        return 0;
      end;
      return TargetOf(self.FTree, LReturn);
    end;

    // A routine or method AId whose result is a sequence is a generator (G1): flagged
    // Generator (Lowering, an .acu); a var parameter or varargs on it is SM0721 (its body
    // runs after the call has returned, so the caller's place or arguments may be gone)
    hidden method DoGenerator(const AId: int64);
    var
      LI: int64;
      LParam: int64;
    begin
      if self.DoGeneratorElement(AId) = 0 then
        return;
      end;
      self.FTree[AId].AddFlag(NodeFlag.Generator);
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Param) - 1 do
        LParam := self.FTree.NthOf(AId, NodeRole.Param, LI);
        if self.FTree[LParam].HasFlag(NodeFlag.VarParam) then
          self.DoError(LParam, ADAM_ERR_SEMANTICS_721, ADAM_MSG_SEMANTICS_GENERATOR_VAR,
            NoArgs().Str(self.FTree[AId].Text).Str(self.FTree[LParam].Text));
        end;
      end;
      if self.FTree[AId].HasFlag(NodeFlag.Variadic) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_721, ADAM_MSG_SEMANTICS_GENERATOR_VARARGS,
          NoArgs().Str(self.FTree[AId].Text));
      end;
    end;

    // yield E (BNF sec 5, G1): only in a generator's own body, never inside an async block
    // or a for parallel's body there (SM0719); E converts to the generator's T. ResolvedJump
    // is the generator
    hidden method DoYield(const AId: int64);
    var
      LChild: int64;
      LAt: int64;
      LKind: NodeKind;
      LElement: int64;
      LValue: int64;
    begin
      self.DoChildren(AId);
      LChild := AId;
      LAt := self.FTree.ParentOf(AId);
      while LAt <> 0 do
        LKind := self.FTree[LAt].Kind;
        if (LKind = NodeKind.AsyncExpression) or ((LKind = NodeKind.ForStatement) and
          self.FTree[LAt].HasFlag(NodeFlag.Parallel) and
          (self.FTree.RoleOf(LChild) = NodeRole.Statement)) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_719, ADAM_MSG_SEMANTICS_YIELD_INNER, NoArgs());
          return;
        end;
        // a func literal is never a generator (F2a): a yield in it yields from nothing
        if IsRoutineLike(LKind) or (LKind = NodeKind.Module) or (LKind = NodeKind.TestBlock) or
          (LKind = NodeKind.FuncLiteral) then
          leave;
        end;
        LChild := LAt;
        LAt := self.FTree.ParentOf(LAt);
      end;
      LElement := 0;
      if (LAt <> 0) and IsRoutineLike(self.FTree[LAt].Kind) then
        LElement := self.DoGeneratorElement(LAt);
      end;
      if LElement = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_719, ADAM_MSG_SEMANTICS_YIELD_OUTSIDE, NoArgs());
        return;
      end;
      self.FTree[AId].ResolvedJump := LAt;
      if self.FTree[AId].HasFlag(NodeFlag.YieldFrom) then
        self.DoYieldFrom(AId, LElement);
        return;
      end;
      LValue := self.FTree.FirstOf(AId, NodeRole.Value);
      if LValue <> 0 then
        self.DoOwnMoves(LValue, true);
        self.DoConvert(LValue, LElement);
      end;
    end;

    // yield from S (BNF sec 5, G1e) in a generator of AElement: S walks as a for in's
    // subject does (a sequence, an array, a string, a wstring or a set: SM0724), its element
    // converts to AElement (SM0725). The statement's ResolvedType and its YieldElement
    // child's are the element type (Lowering reads them); that child's ResolvedConvert is
    // AElement where the types differ (DoConvert), so each pass hands the element on as a
    // yield of it would
    hidden method DoYieldFrom(const AId: int64; const AElement: int64);
    var
      LSubject: int64;
      LPlace: int64;
      LSubjectType: int64;
      LItem: int64;
    begin
      LSubject := self.FTree.FirstOf(AId, NodeRole.Value);
      LPlace := self.FTree.FirstOf(AId, NodeRole.Element);
      if (LSubject = 0) or (LPlace = 0) then
        return;
      end;
      LSubjectType := self.DoTypeOf(LSubject);
      if (LSubjectType = 0) or (self.DoClass(LSubjectType) = TypeClass.Unknown) then
        // lost where it was reported
        return;
      end;
      LItem := self.DoForInElement(LSubjectType);
      if LItem = 0 then
        self.DoError(LSubject, ADAM_ERR_SEMANTICS_724, ADAM_MSG_SEMANTICS_YIELD_FROM_SUBJECT,
          NoArgs().Str(self.DoText(LSubjectType)));
        return;
      end;
      self.FTree[AId].ResolvedType := LItem;
      self.FTree[LPlace].ResolvedType := LItem;
      if (LItem <> AElement) and not self.DoWouldConvert(LPlace, AElement) then
        self.DoError(LSubject, ADAM_ERR_SEMANTICS_725, ADAM_MSG_SEMANTICS_YIELD_FROM_TYPE,
          NoArgs().Str(self.DoText(LItem)).Str(self.DoText(AElement)));
        return;
      end;
      self.DoConvert(LPlace, AElement);
    end;

    // A write SEM can see to ATarget (an assignment, ++ / --, a var argument): when it names
    // the iterator of a for it stands in, SM0602 at the write (the loop owns its iterator; a
    // write through a pointer is not seen)
    hidden method DoIteratorWritten(const ATarget: int64);
    var
      LName: int64;
      LDecl: int64;
    begin
      LName := self.DoSkipParens(ATarget);
      if (LName = 0) or (self.FTree[LName].Kind <> NodeKind.NameExpression) then
        return;
      end;
      LDecl := self.FTree[LName].ResolvedDecl;
      if (LDecl <> 0) and (self.DoLoopOver(LName, LDecl) <> 0) then
        self.DoError(LName, ADAM_ERR_SEMANTICS_602, ADAM_MSG_SEMANTICS_ITERATOR_WRITE,
          NoArgs().Str(self.FTree[LName].Text));
      end;
    end;

    // for I := A to|downto B: I checked (DoIsIterator), then A and B convert to I's type;
    // a for parallel its own check (DoParallelFor)
    hidden method DoFor(const AId: int64);
    var
      LIterator: int64;
      LType: int64;
    begin
      if self.FTree[AId].HasFlag(NodeFlag.Parallel) then
        self.DoParallelFor(AId);
        return;
      end;
      self.DoChildren(AId);
      LIterator := self.FTree.FirstOf(AId, NodeRole.Iterator);
      if not self.DoIsIterator(AId, LIterator) then
        return;
      end;
      LType := self.DoTypeOf(LIterator);
      self.DoConvert(self.FTree.FirstOf(AId, NodeRole.Start), LType);
      self.DoConvert(self.FTree.FirstOf(AId, NodeRole.Limit), LType);
    end;

    // `for parallel [(W)] I := A to|downto B do .. end;` (BNF sec 5, T2): the workers' count
    // W an int64; the bounds met at their common type (the same type: it; two integers:
    // CommonArithmetic; else the start's, the limit converting to it), the type of the
    // iterator the loop declares
    // (its VarDecl, visited here: it has no written type), an integer, a char, a wchar or a
    // choice (SM0601); neither the bounds nor W read the iterator (SM0712); then the body,
    // and the variables and parameters of its routine the body uses recorded (DoCaptures)
    hidden method DoParallelFor(const AId: int64);
    var
      LIterator: int64;
      LStart: int64;
      LLimit: int64;
      LWorkers: int64;
      LStartType: int64;
      LLimitType: int64;
      LType: int64;
      LClass: TypeClass;
      LI: int64;
    begin
      LIterator := self.FTree.FirstOf(AId, NodeRole.Iterator);
      LStart := self.FTree.FirstOf(AId, NodeRole.Start);
      LLimit := self.FTree.FirstOf(AId, NodeRole.Limit);
      LWorkers := self.FTree.FirstOf(AId, NodeRole.Value);
      // the iterator's type comes from the bounds, never from a visit of its own
      if LIterator <> 0 then
        self.DoFirstVisit(LIterator);
      end;
      self.DoVisit(LStart);
      self.DoVisit(LLimit);
      if LWorkers <> 0 then
        self.DoVisit(LWorkers);
        self.DoConvert(LWorkers, self.DoBuiltin("int64"));
      end;
      if LIterator <> 0 then
        self.DoOwnIterator(LStart, LIterator);
        self.DoOwnIterator(LLimit, LIterator);
        self.DoOwnIterator(LWorkers, LIterator);
      end;
      LStartType := self.DoTypeOf(LStart);
      LLimitType := self.DoTypeOf(LLimit);
      // bounds of one type keep it (a uint8 loop stays one); two integer types meet
      LType := LStartType;
      if (LStartType <> 0) and (LLimitType <> 0) and (LStartType <> LLimitType) and
        IsIntegerClass(self.DoClass(LStartType)) and IsIntegerClass(self.DoClass(LLimitType)) then
        LType := CommonArithmetic(self.FTree, LStartType, LLimitType);
      end;
      if (LType <> 0) and (LIterator <> 0) then
        LClass := self.DoClass(LType);
        if IsIntegerClass(LClass) or (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) or
          (LClass = TypeClass.ChoicesType) then
          self.DoSetType(LIterator, LType);
          self.DoConvert(LStart, LType);
          self.DoConvert(LLimit, LType);
        else
          self.DoError(AId, ADAM_ERR_SEMANTICS_601, ADAM_MSG_SEMANTICS_FOR_TYPE,
            NoArgs().Str(self.DoText(LType)));
        end;
      end;
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Statement) - 1 do
        self.DoVisit(self.FTree.NthOf(AId, NodeRole.Statement, LI));
      end;
      self.DoCaptures(AId);
    end;

    // SM0712 at each name under ARoot (a for parallel's bound or workers' count) that reads
    // AIterator, the loop's own iterator: it is declared for the body alone
    hidden method DoOwnIterator(const ARoot: int64; const AIterator: int64);
    var
      LI: int64;
    begin
      if ARoot = 0 then
        return;
      end;
      if (self.FTree[ARoot].Kind = NodeKind.NameExpression) and
        (self.FTree[ARoot].ResolvedDecl = AIterator) then
        self.DoError(ARoot, ADAM_ERR_SEMANTICS_712, ADAM_MSG_SEMANTICS_PARALLEL_OWN,
          NoArgs().Str(self.FTree[AIterator].Text));
        return;
      end;
      for LI := 0 to self.FTree.ChildCount(ARoot) - 1 do
        self.DoOwnIterator(self.FTree.ChildAt(ARoot, LI), AIterator);
      end;
    end;

    // The written place ATarget (DoWritten) seen for BNF sec 5's shared writes: each element
    // write on the way down it (X[i] where X is an array of T, a string or a wstring; a
    // field of such an element; an element of an element) hands X to DoUnsharePlace, so a
    // for parallel around the write makes X unshared once at its start. A property's place
    // (its write is a call) ends the walk
    hidden method DoUnshareWritten(const ATarget: int64);
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
      LOperand: int64;
      LClass: TypeClass;
    begin
      LAt := self.DoSkipParens(ATarget);
      while LAt <> 0 do
        LKind := self.FTree[LAt].Kind;
        if (LKind <> NodeKind.MemberExpression) and (LKind <> NodeKind.IndexExpression) then
          return;
        end;
        LDecl := self.FTree[LAt].ResolvedDecl;
        if (LDecl > 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
          return;
        end;
        LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
        if LOperand = 0 then
          return;
        end;
        if LKind = NodeKind.IndexExpression then
          LClass := ClassOf(self.FTree, self.DoTypeOf(LOperand));
          if (LClass = TypeClass.DynamicArray) or (LClass = TypeClass.Text) or
            (LClass = TypeClass.WideText) then
            self.DoUnsharePlace(LAt, LOperand);
          end;
        end;
        LAt := self.DoSkipParens(LOperand);
      end;
    end;

    // The array or string APlace whose element the write AWrite writes (DoUnshareWritten):
    // when APlace is a name / field chain (a variable or parameter, self, their fields; an
    // index, a deref or a call on the way is left to the run-time check) whose root lives
    // outside a for parallel around AWrite, that loop gets an Unshare child for it (its
    // ResolvedJump APlace), once per place text: Lowering makes it unshared at the loop's
    // start, on the calling thread, before any worker runs (BNF sec 5). Every enclosing for
    // parallel the root is outside of gets one (the outermost unshares first, a nested one
    // then finds it unshared); the walk stops at the routine, the module, a test block or
    // an async block (whose task is no worker of a loop around it)
    hidden method DoUnsharePlace(const AWrite: int64; const APlace: int64);
    var
      LAt: int64;
      LKind: NodeKind;
      LRoot: int64;
      LDecl: int64;
      LChild: int64;
      LFor: int64;
      LText: string;
      LUnshare: int64;
      LSeen: bool;
      LI: int64;
    begin
      // the chain down to its root: a name (LRoot its declaration) or self (LRoot 0)
      LAt := self.DoSkipParens(APlace);
      LRoot := -1;
      while LRoot < 0 do
        LKind := self.FTree[LAt].Kind;
        if LKind = NodeKind.SelfExpression then
          LRoot := 0;
        else
          if LKind = NodeKind.NameExpression then
            LDecl := self.FTree[LAt].ResolvedDecl;
            if LDecl <= 0 then
              return;
            end;
            // a method's own field named bare is reached through self
            if self.FTree[LDecl].Kind = NodeKind.FieldDecl then
              LRoot := 0;
            else
              if (self.FTree[LDecl].Kind <> NodeKind.VarDecl) and
                (self.FTree[LDecl].Kind <> NodeKind.Param) then
                return;
              end;
              LRoot := LDecl;
            end;
          else
            if LKind <> NodeKind.MemberExpression then
              return;
            end;
            LDecl := self.FTree[LAt].ResolvedDecl;
            if (LDecl <= 0) or (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
              return;
            end;
            LAt := self.DoSkipParens(self.FTree.FirstOf(LAt, NodeRole.Operand));
            if LAt = 0 then
              return;
            end;
          end;
        end;
      end;
      LText := self.DoExprText(APlace);
      LChild := AWrite;
      LFor := self.FTree.ParentOf(AWrite);
      while LFor <> 0 do
        LKind := self.FTree[LFor].Kind;
        if IsRoutineLike(LKind) or (LKind = NodeKind.Module) or (LKind = NodeKind.TestBlock) or
          (LKind = NodeKind.AsyncExpression) then
          return;
        end;
        if (LKind = NodeKind.ForStatement) and self.FTree[LFor].HasFlag(NodeFlag.Parallel) and
          (self.FTree.RoleOf(LChild) = NodeRole.Statement) and
          ((LRoot = 0) or not self.FTree.IsAncestor(LFor, LRoot)) then
          LSeen := false;
          for LI := 0 to self.FTree.CountOf(LFor, NodeRole.Unshare) - 1 do
            LUnshare := self.FTree.NthOf(LFor, NodeRole.Unshare, LI);
            if self.DoExprText(self.FTree[LUnshare].ResolvedJump) = LText then
              LSeen := true;
            end;
          end;
          if not LSeen then
            LUnshare := self.FTree.AddChild(LFor, NodeRole.Unshare, NodeKind.Unshare,
              self.FTree[APlace].Place, self.FTree[APlace].StartOffset, self.FTree[APlace].EndOffset);
            self.FTree[LUnshare].ResolvedJump := APlace;
          end;
        end;
        LChild := LFor;
        LFor := self.FTree.ParentOf(LFor);
      end;
    end;

    // The Capture children of AOwner, a for parallel (T2), an async block (T4) or a func
    // literal (F2a), made once (a second visit finds them): one per variable, constant or
    // parameter of its routine its body names, in the order of first use (DoCaptureWalk),
    // each its ResolvedDecl (a literal's: also one for self, its ResolvedDecl the method);
    // a for parallel's body reaches them by reference (Lowering's frame), shared by its
    // workers, an async block's reads its task's copies, taken at the async, a literal's
    // reaches them by reference through its environment
    hidden method DoCaptures(const AOwner: int64);
    var
      LSeen: ref Int64Map;
      LI: int64;
    begin
      if self.FTree.CountOf(AOwner, NodeRole.Capture) > 0 then
        return;
      end;
      LSeen := ref Int64Map(0);
      if self.FTree[AOwner].Kind = NodeKind.FuncLiteral then
        // its own locals' initializers name what it captures too (FL1)
        for LI := 0 to self.FTree.CountOf(AOwner, NodeRole.Local) - 1 do
          self.DoCaptureWalk(AOwner, self.FTree.NthOf(AOwner, NodeRole.Local, LI), LSeen, true);
        end;
        self.DoCaptureWalk(AOwner, self.FTree.FirstOf(AOwner, NodeRole.Body), LSeen, true);
        return;
      end;
      if self.FTree[AOwner].Kind = NodeKind.AsyncExpression then
        self.DoCaptureWalk(AOwner, self.FTree.FirstOf(AOwner, NodeRole.Body), LSeen, true);
        return;
      end;
      for LI := 0 to self.FTree.CountOf(AOwner, NodeRole.Statement) - 1 do
        self.DoCaptureWalk(AOwner, self.FTree.NthOf(AOwner, NodeRole.Statement, LI), LSeen, true);
      end;
    end;

    // The walk of DoCaptures over AAt, a node of AFor's body (AFor a for parallel, an async
    // block or a func literal): a name of a variable, a constant or a parameter of the
    // routine (any declaration but a module's, Declaration) declared outside AFor and not in
    // ASeen yet gets its Capture child. AOwn: AAt is AFor's own body, not a nested for
    // parallel's, async block's or func literal's (that one reports its own): a return there
    // is SM0709 / SM0713 (the body is no part of the routine's own flow), a varargs read
    // SM0711 / SM0715 (the routine's varargs never reach the body's workers or task); in an
    // async block self or parent is SM0716 (the task may outlive the object), in a literal
    // nested there too (it would reach the object through the task). A literal's own walk
    // (DoLiteralCapture) captures self too, and refuses a var parameter or a value type's
    // self (SM0755); its varargs read is DoVarargs' SM0756
    hidden method DoCaptureWalk(const AFor: int64; const AAt: int64; const ASeen: ref Int64Map;
      const AOwn: bool);
    var
      LAsync: bool;
      LKind: NodeKind;
      LChild: int64;
      LOwn: bool;
      LI: int64;
    begin
      LAsync := self.FTree[AFor].Kind = NodeKind.AsyncExpression;
      LKind := self.FTree[AAt].Kind;
      if self.FTree[AFor].Kind = NodeKind.FuncLiteral then
        self.DoLiteralCapture(AFor, AAt, ASeen);
      else
        self.DoBodyCapture(AFor, AAt, ASeen, AOwn, LAsync, LKind);
      end;
      for LI := 0 to self.FTree.ChildCount(AAt) - 1 do
        LChild := self.FTree.ChildAt(AAt, LI);
        // a nested for parallel's, async block's or func literal's own body reports its
        // own returns and varargs reads
        LOwn := AOwn;
        if (LKind = NodeKind.ForStatement) and self.FTree[AAt].HasFlag(NodeFlag.Parallel) and
          (self.FTree.RoleOf(LChild) = NodeRole.Statement) then
          LOwn := false;
        end;
        if (LKind = NodeKind.AsyncExpression) and (self.FTree.RoleOf(LChild) = NodeRole.Body) then
          LOwn := false;
        end;
        if (LKind = NodeKind.FuncLiteral) and (self.FTree.RoleOf(LChild) = NodeRole.Body) then
          // an async block's self rule reaches through the literals in its own body
          if AOwn and LAsync then
            self.DoAsyncLiteralSelf(LChild);
          end;
          LOwn := false;
        end;
        self.DoCaptureWalk(AFor, LChild, ASeen, LOwn);
      end;
    end;

    // DoCaptureWalk's own rules at AAt (of kind AKind) for AFor, a for parallel or an async
    // block (AAsync), AOwn its: the returns, varargs reads and self / parent of its own
    // body, and the Capture child of a routine's variable it names
    hidden method DoBodyCapture(const AFor: int64; const AAt: int64; const ASeen: ref Int64Map;
      const AOwn: bool; const AAsync: bool; const AKind: NodeKind);
    var
      LDecl: int64;
      LDeclKind: NodeKind;
      LCapture: int64;
      LWord: string;
    begin
      if AOwn and (AKind = NodeKind.ReturnStatement) then
        if AAsync then
          self.DoError(AAt, ADAM_ERR_SEMANTICS_713, ADAM_MSG_SEMANTICS_ASYNC_RETURN, NoArgs());
        else
          self.DoError(AAt, ADAM_ERR_SEMANTICS_709, ADAM_MSG_SEMANTICS_PARALLEL_RETURN, NoArgs());
        end;
      end;
      if AOwn and (AKind = NodeKind.VarargsExpression) then
        if AAsync then
          self.DoError(AAt, ADAM_ERR_SEMANTICS_715, ADAM_MSG_SEMANTICS_ASYNC_VARARGS, NoArgs());
        else
          self.DoError(AAt, ADAM_ERR_SEMANTICS_711, ADAM_MSG_SEMANTICS_PARALLEL_VARARGS, NoArgs());
        end;
      end;
      if AOwn and AAsync and
        ((AKind = NodeKind.SelfExpression) or (AKind = NodeKind.ParentExpression)) then
        LWord := "self";
        if AKind = NodeKind.ParentExpression then
          LWord := "parent";
        end;
        self.DoError(AAt, ADAM_ERR_SEMANTICS_716, ADAM_MSG_SEMANTICS_ASYNC_SELF, NoArgs().Str(LWord));
      end;
      if AKind = NodeKind.NameExpression then
        LDecl := self.FTree[AAt].ResolvedDecl;
        if LDecl > 0 then
          LDeclKind := self.FTree[LDecl].Kind;
          if ((LDeclKind = NodeKind.VarDecl) or (LDeclKind = NodeKind.ConstDecl) or
            (LDeclKind = NodeKind.Param)) and (self.FTree.RoleOf(LDecl) <> NodeRole.Declaration) and
            (not self.FTree.IsAncestor(AFor, LDecl)) and (ASeen.Find(LDecl) = 0) then
            ASeen.Put(LDecl, 1);
            LCapture := self.FTree.AddChild(AFor, NodeRole.Capture, NodeKind.Capture,
              self.FTree[AAt].Place, self.FTree[AAt].StartOffset, self.FTree[AAt].EndOffset);
            self.FTree[LCapture].ResolvedDecl := LDecl;
          end;
        end;
      end;
    end;

    // SM0716 at each self / parent under ABody, the body of a func literal in an async
    // block's own body, literals nested in it included, an async block nested there not (it
    // reports its own): the literal would reach the object through the task, which may
    // outlive it
    hidden method DoAsyncLiteralSelf(const ABody: int64);
    var
      LKind: NodeKind;
      LWord: string;
      LI: int64;
      LChild: int64;
    begin
      LKind := self.FTree[ABody].Kind;
      if (LKind = NodeKind.SelfExpression) or (LKind = NodeKind.ParentExpression) then
        LWord := "self";
        if LKind = NodeKind.ParentExpression then
          LWord := "parent";
        end;
        self.DoError(ABody, ADAM_ERR_SEMANTICS_716, ADAM_MSG_SEMANTICS_ASYNC_SELF, NoArgs().Str(LWord));
      end;
      for LI := 0 to self.FTree.ChildCount(ABody) - 1 do
        LChild := self.FTree.ChildAt(ABody, LI);
        if (LKind = NodeKind.AsyncExpression) and (self.FTree.RoleOf(LChild) = NodeRole.Body) then
          skip;
        end;
        self.DoAsyncLiteralSelf(LChild);
      end;
    end;

    // DoCaptureWalk's own rule at AAt for the func literal ALiteral (BNF sec 6, F2a): a name
    // of a routine's variable, constant or parameter declared outside it (DoBodyCapture's
    // test) or a self / parent gets its Capture child once (self's ResolvedDecl the method
    // it is the object of), each at its first use; a var parameter (SM0755: the caller's
    // place may be gone) and a self that is no ref object's (SM0755, F2a0: any other self
    // may be a value or an embed, the caller's place) are refused, at each use
    hidden method DoLiteralCapture(const ALiteral: int64; const AAt: int64; const ASeen: ref Int64Map);
    var
      LKind: NodeKind;
      LDecl: int64;
      LDeclKind: NodeKind;
      LCapture: int64;
      LType: int64;
      LWord: string;
    begin
      LKind := self.FTree[AAt].Kind;
      LDecl := 0;
      if (LKind = NodeKind.SelfExpression) or (LKind = NodeKind.ParentExpression) then
        LDecl := self.DoEnclosingRoutine(ALiteral);
        LType := self.DoTypeOf(AAt);
        if (LDecl = 0) or (LType = 0) then
          // no self here (SM0011 / SM0745 at it already)
          return;
        end;
        // only a ref object's self lies in a ref block a closure can hold (F2a0): a plain
        // object's may be a value or an embed
        if (self.DoClass(LType) <> TypeClass.ObjectType) or
          (not IsRefOnly(self.FTree, MethodOwnerTypeOf(self.FTree, LDecl))) then
          LWord := "self";
          if LKind = NodeKind.ParentExpression then
            LWord := "parent";
          end;
          self.DoError(AAt, ADAM_ERR_SEMANTICS_755, ADAM_MSG_SEMANTICS_CLOSURE_CAPTURE_SELF,
            NoArgs().Str(LWord).Str(self.DoText(LType)));
          return;
        end;
      end;
      if LKind = NodeKind.NameExpression then
        LDecl := self.FTree[AAt].ResolvedDecl;
        if LDecl <= 0 then
          return;
        end;
        LDeclKind := self.FTree[LDecl].Kind;
        if ((LDeclKind <> NodeKind.VarDecl) and (LDeclKind <> NodeKind.ConstDecl) and
          (LDeclKind <> NodeKind.Param)) or (self.FTree.RoleOf(LDecl) = NodeRole.Declaration) or
          self.FTree.IsAncestor(ALiteral, LDecl) then
          return;
        end;
        if (LDeclKind = NodeKind.Param) and self.FTree[LDecl].HasFlag(NodeFlag.VarParam) then
          self.DoError(AAt, ADAM_ERR_SEMANTICS_755, ADAM_MSG_SEMANTICS_CLOSURE_CAPTURE_PARAM,
            NoArgs().Str("var").Str(self.FTree[LDecl].Text));
          return;
        end;
      end;
      if (LDecl = 0) or (ASeen.Find(LDecl) <> 0) then
        return;
      end;
      ASeen.Put(LDecl, 1);
      LCapture := self.FTree.AddChild(ALiteral, NodeRole.Capture, NodeKind.Capture,
        self.FTree[AAt].Place, self.FTree[AAt].StartOffset, self.FTree[AAt].EndOffset);
      self.FTree[LCapture].ResolvedDecl := LDecl;
    end;

    // True when AId stands in a for parallel's body inside its own routine (where
    // workerindex() / workercount() are known, T2)
    hidden const method DoInParallelBody(const AId: int64): bool;
    var
      LChild: int64;
      LAt: int64;
      LKind: NodeKind;
    begin
      LChild := AId;
      LAt := self.FTree.ParentOf(AId);
      while LAt <> 0 do
        LKind := self.FTree[LAt].Kind;
        if (LKind = NodeKind.ForStatement) and self.FTree[LAt].HasFlag(NodeFlag.Parallel) and
          (self.FTree.RoleOf(LChild) = NodeRole.Statement) then
          return true;
        end;
        // an async block's task is no worker of a loop around the async (T4), nor is a func
        // literal's closure (F2a: it may run anywhere)
        if IsRoutineLike(LKind) or (LKind = NodeKind.Module) or (LKind = NodeKind.TestBlock) or
          (LKind = NodeKind.AsyncExpression) or (LKind = NodeKind.FuncLiteral) then
          return false;
        end;
        LChild := LAt;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // The type of the typed match subject ASubject when it is one a match takes (an
    // integer, char, wchar or a choice; a string or a wstring, BNF sec 5); SM0603
    // otherwise. 0 = nothing to check the labels against (an unknown subject was reported
    // where it was lost)
    hidden method DoMatchSubject(const ASubject: int64): int64;
    var
      LType: int64;
      LClass: TypeClass;
    begin
      LType := self.DoTypeOf(ASubject);
      if LType = 0 then
        return 0;
      end;
      LClass := self.DoClass(LType);
      if IsIntegerClass(LClass) or (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) or
        (LClass = TypeClass.ChoicesType) or (LClass = TypeClass.Text) or
        (LClass = TypeClass.WideText) then
        return LType;
      end;
      self.DoError(ASubject, ADAM_ERR_SEMANTICS_603, ADAM_MSG_SEMANTICS_MATCH_SUBJECT,
        NoArgs().Str(self.DoText(LType)));
      return 0;
    end;

    // True when the values of AType (a match subject's, a bitfield's) are unsigned: an
    // unsigned integer, and a char or wchar the target makes unsigned (IsCharTypeSigned); a
    // signed integer and a choice are signed. Lowering's compares and bitfield reads make
    // the same split
    hidden const method DoUnsignedValues(const AType: int64): bool;
    var
      LClass: TypeClass;
    begin
      LClass := self.DoClass(AType);
      if (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) then
        return not IsCharTypeSigned(self.FTree, self.FTarget, AType);
      end;
      return LClass = TypeClass.UnsignedInt;
    end;

    // The folded value of the constant AId (a match label bound, a choice value, a value
    // stored into a bitfield) as its 64 bits into ABits (an integer, a char's code, a
    // choice's number, a bool's 0 / 1); false when it holds none of those. Under a char or
    // wchar type AType the code is read at the width and sign the target gives it (a char's
    // stored code is its low bits: char(200) is -56 where char is signed), so the value is
    // the one a value of AType holds
    hidden const method DoFoldedBits(const AId: int64; const AType: int64; var ABits: int64): bool;
    var
      LConst: ConstValue;
      LClass: TypeClass;
    begin
      ABits := 0;
      LConst := self.FTree[AId].ResolvedConst;
      match LConst.Kind of
        ConstKind.Signed, ConstKind.Unsigned, ConstKind.Char, ConstKind.Boolean:
          ABits := int64(LConst.Bits);
      else
        // no other constant is a label value
        return false;
      end;
      LClass := self.DoClass(AType);
      if (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) then
        ABits := ReadLowBits(ABits, CharTypeBits(self.FTree, self.FTarget, AType),
          IsCharTypeSigned(self.FTree, self.FTarget, AType));
      end;
      return true;
    end;

    // AFirst < ASecond for two label values, unsigned when AUnsigned (DoUnsignedValues)
    hidden const method DoLabelLess(const AFirst: int64; const ASecond: int64; const AUnsigned: bool): bool;
    begin
      if AUnsigned then
        return uint64(AFirst) < uint64(ASecond);
      end;
      return AFirst < ASecond;
    end;

    // The match label ALabel as written: low, or low..high
    hidden const method DoLabelText(const ALabel: int64): string;
    var
      LText: string;
      LHigh: int64;
    begin
      LText := self.DoExprText(self.FTree.FirstOf(ALabel, NodeRole.LowBound));
      LHigh := self.FTree.FirstOf(ALabel, NodeRole.HighBound);
      if LHigh <> 0 then
        LText := LText + ".." + self.DoExprText(LHigh);
      end;
      return LText;
    end;

    // One typed label bound ABound against the subject type AType (0: no subject to check
    // against). A constant (SM0202); a known value outside an integer subject's range never
    // matches (SM0604, before the conversion, whose SM0200 would only name the types); then
    // it converts (a choice subject takes values of that choice only). True = its value is
    // known and nothing was reported
    hidden method DoLabelBound(const ABound: int64; const AType: int64): bool;
    var
      LNegative: bool;
      LMagnitude: uint64;
      LBits: int64;
    begin
      if ABound = 0 then
        return false;
      end;
      if self.FTree[ABound].ResolvedConst.Kind = ConstKind.Unknown then
        // A bound with no type was reported where it was lost
        if self.FTree[ABound].ResolvedType <> 0 then
          self.DoError(ABound, ADAM_ERR_SEMANTICS_202, ADAM_MSG_SEMANTICS_NOT_CONSTANT,
            NoArgs().Str(ADAM_MSG_SEMANTICS_POS_LABEL));
        end;
        return false;
      end;
      if AType = 0 then
        return false;
      end;
      if IsIntegerClass(self.DoClass(AType)) and ConstIntOf(self.FTree, ABound, LNegative, LMagnitude) and
        (not IntFits(self.FTree, AType, LNegative, LMagnitude)) then
        self.DoError(ABound, ADAM_ERR_SEMANTICS_604, ADAM_MSG_SEMANTICS_LABEL_RANGE,
          NoArgs().Str(ConstIntText(LNegative, LMagnitude)).Str(self.DoText(AType)));
        return false;
      end;
      if not self.DoConvert(ABound, AType) then
        return false;
      end;
      return self.DoFoldedBits(ABound, AType, LBits);
    end;

    // The match label ALabel (its bounds typed) against the subject type AType: each bound
    // by DoLabelBound; a known range low > high is SM0267 (an empty range covers nothing);
    // a label sharing a value with an earlier known one is SM0605 naming the first. ASpans
    // holds the known labels so far, three entries each (low, high, label node); a known
    // label that repeats nothing is added. True = the label's values are known (the
    // coverage check counts it)
    hidden method DoMatchLabel(const ALabel: int64; const AType: int64; const ASpans: ref NodeList): bool;
    var
      LLow: int64;
      LHigh: int64;
      LLowKnown: bool;
      LHighKnown: bool;
      LLowBits: int64;
      LHighBits: int64;
      LUnsigned: bool;
      LI: int64;
      LFirst: int64;
    begin
      if (AType <> 0) and ((self.DoClass(AType) = TypeClass.Text) or
        (self.DoClass(AType) = TypeClass.WideText)) then
        return self.DoStringMatchLabel(ALabel, AType, ASpans);
      end;
      LLow := self.FTree.FirstOf(ALabel, NodeRole.LowBound);
      LHigh := self.FTree.FirstOf(ALabel, NodeRole.HighBound);
      LLowKnown := self.DoLabelBound(LLow, AType);
      LHighKnown := true;
      if LHigh <> 0 then
        LHighKnown := self.DoLabelBound(LHigh, AType);
      else
        LHigh := LLow;
      end;
      if (not LLowKnown) or (not LHighKnown) then
        return false;
      end;
      self.DoFoldedBits(LLow, AType, LLowBits);
      self.DoFoldedBits(LHigh, AType, LHighBits);
      LUnsigned := self.DoUnsignedValues(AType);
      if self.DoLabelLess(LHighBits, LLowBits, LUnsigned) then
        self.DoError(LLow, ADAM_ERR_SEMANTICS_267, ADAM_MSG_SEMANTICS_LOW_HIGH,
          NoArgs().Str(self.DoExprText(LLow)).Str(self.DoExprText(LHigh)));
        return true;
      end;
      for LI := 0 to (ASpans.Count div 3) - 1 do
        // Two closed ranges share a value unless one ends before the other starts
        if not (self.DoLabelLess(LHighBits, ASpans[LI * 3], LUnsigned) or
          self.DoLabelLess(ASpans[LI * 3 + 1], LLowBits, LUnsigned)) then
          LFirst := ASpans[LI * 3 + 2];
          self.DoError(LLow, ADAM_ERR_SEMANTICS_605, ADAM_MSG_SEMANTICS_LABEL_REPEAT,
            NoArgs().Str(self.DoLabelText(ALabel)).Str(self.DoLabelText(LFirst)).Int(
            int64(self.FTree[LFirst].Place.Line)));
          return true;
        end;
      end;
      ASpans.Add(LLowBits);
      ASpans.Add(LHighBits);
      ASpans.Add(ALabel);
      return true;
    end;

    // The label ALabel of a match on a string or wstring (the subject type AType, BNF sec 5):
    // one string constant of the subject's width, compared exactly. A range is SM0613; a
    // bound that is no constant SM0202; one that does not convert to AType (a char, an
    // integer: only a string constant converts) reports there (SM0200); the same text as an
    // earlier label SM0605 naming the first. ASpans keeps DoMatchLabel's three entries per known
    // label (0, 0, the label node: its text is its bound's folded string). True = the
    // label's text is known
    hidden method DoStringMatchLabel(const ALabel: int64; const AType: int64;
      const ASpans: ref NodeList): bool;
    var
      LLow: int64;
      LHigh: int64;
      LFirst: int64;
      LI: int64;
    begin
      LLow := self.FTree.FirstOf(ALabel, NodeRole.LowBound);
      LHigh := self.FTree.FirstOf(ALabel, NodeRole.HighBound);
      if LHigh <> 0 then
        self.DoError(LHigh, ADAM_ERR_SEMANTICS_627, ADAM_MSG_SEMANTICS_STRING_LABEL_RANGE,
          NoArgs().Str(self.DoText(AType)));
        return false;
      end;
      if self.FTree[LLow].ResolvedConst.Kind = ConstKind.Unknown then
        // A bound with no type was reported where it was lost
        if self.FTree[LLow].ResolvedType <> 0 then
          self.DoError(LLow, ADAM_ERR_SEMANTICS_202, ADAM_MSG_SEMANTICS_NOT_CONSTANT,
            NoArgs().Str(ADAM_MSG_SEMANTICS_POS_LABEL));
        end;
        return false;
      end;
      if not self.DoConvert(LLow, AType) then
        return false;
      end;
      for LI := 0 to (ASpans.Count div 3) - 1 do
        LFirst := ASpans[LI * 3 + 2];
        if self.FTree[self.FTree.FirstOf(LFirst, NodeRole.LowBound)].ResolvedConst.Text =
          self.FTree[LLow].ResolvedConst.Text then
          self.DoError(LLow, ADAM_ERR_SEMANTICS_605, ADAM_MSG_SEMANTICS_LABEL_REPEAT,
            NoArgs().Str(self.DoLabelText(ALabel)).Str(self.DoLabelText(LFirst)).Int(
            int64(self.FTree[LFirst].Place.Line)));
          return true;
        end;
      end;
      ASpans.Add(0);
      ASpans.Add(0);
      ASpans.Add(ALabel);
      return true;
    end;

    // The match arm AArm against the subject type AType: its children in source order,
    // each label checked as it is met (DoMatchLabel), then its statements. True = every
    // label's values are known
    hidden method DoMatchArm(const AArm: int64; const AType: int64; const ASpans: ref NodeList): bool;
    var
      LI: int64;
      LChild: int64;
      LKnown: bool;
    begin
      LKnown := true;
      for LI := 0 to self.FTree.ChildCount(AArm) - 1 do
        LChild := self.FTree.ChildAt(AArm, LI);
        self.DoVisit(LChild);
        if (self.FTree[LChild].Kind = NodeKind.MatchLabel) and
          (not self.DoMatchLabel(LChild, AType, ASpans)) then
          LKnown := false;
        end;
      end;
      return LKnown;
    end;

    // A match AMatch on a choice (subject type AType) with no else, every label known: the
    // choice values no label covers are named in a WARNING SM0606 (a value with no number
    // leaves the coverage unknown: nothing is said)
    hidden method DoMatchCoverage(const AMatch: int64; const AType: int64; const ASpans: ref NodeList);
    var
      LCanonical: int64;
      LBody: int64;
      LI: int64;
      LJ: int64;
      LMember: int64;
      LBits: int64;
      LCovered: bool;
      LMissing: string;
    begin
      if self.FTree[AMatch].HasFlag(NodeFlag.ElsePart) or (self.DoClass(AType) <> TypeClass.ChoicesType) then
        return;
      end;
      LCanonical := CanonicalOf(self.FTree, AType);
      LBody := LCanonical;
      if self.FTree[LCanonical].Kind <> NodeKind.ChoicesType then
        LBody := BodyOf(self.FTree, LCanonical);
      end;
      if LBody = 0 then
        return;
      end;
      LMissing := "";
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if self.FTree[LMember].Kind <> NodeKind.ChoiceValue then
          skip;
        end;
        if not self.DoFoldedBits(LMember, AType, LBits) then
          return;
        end;
        // A choice's numbers compare signed
        LCovered := false;
        for LJ := 0 to (ASpans.Count div 3) - 1 do
          if (ASpans[LJ * 3] <= LBits) and (LBits <= ASpans[LJ * 3 + 1]) then
            LCovered := true;
            leave;
          end;
        end;
        if LCovered then
          skip;
        end;
        if LMissing <> "" then
          LMissing := LMissing + ", ";
        end;
        LMissing := LMissing + self.FTree[LMember].Text;
      end;
      if LMissing <> "" then
        self.FDiagnostics.Add(Severity.Warning, ADAM_ERR_SEMANTICS_606, self.FTree[AMatch].Place,
          ADAM_MSG_SEMANTICS_NOT_COVERED, NoArgs().Str(self.DoText(AType)).Str(LMissing));
      end;
    end;

    // match S of ...: S (DoMatchSubject), then each arm in source order (DoMatchArm), the
    // else part, then a choice match's coverage (DoMatchCoverage) when every label is known
    hidden method DoMatch(const AId: int64);
    var
      LSubject: int64;
      LType: int64;
      LSpans: ref NodeList;
      LAllKnown: bool;
      LI: int64;
      LChild: int64;
    begin
      LSubject := self.FTree.FirstOf(AId, NodeRole.Subject);
      self.DoVisit(LSubject);
      LType := self.DoMatchSubject(LSubject);
      LAllKnown := LType <> 0;
      LSpans := ref NodeList();
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LChild := self.FTree.ChildAt(AId, LI);
        if LChild = LSubject then
          skip;
        end;
        if self.FTree[LChild].Kind = NodeKind.MatchArm then
          if not self.DoMatchArm(LChild, LType, LSpans) then
            LAllKnown := false;
          end;
        else
          self.DoVisit(LChild);
        end;
      end;
      if LAllKnown and (not self.FDiagnostics.BudgetReached) then
        self.DoMatchCoverage(AId, LType, LSpans);
      end;
    end;

    // The external clause AId's library (BNF sec 2), resolved once into its ResolvedConst
    // (String, Text the library name) for every later phase: a "..." name as the parser
    // decoded and checked it (PR0055), or the const its NameExpression child names, whose
    // value must be a plain string literal (SM0326) with a library name's shape (SM0327).
    // A clause naming no library, or one whose name was reported already, keeps Unknown
    hidden method DoExternalClause(const AId: int64);
    var
      LName: int64;
      LDecl: int64;
      LValue: int64;
      LLibrary: ConstValue;
    begin
      LLibrary.Kind := ConstKind.String;
      LLibrary.Bits := 0;
      LLibrary.Float := 0.0;
      LLibrary.Text := "";
      LName := self.FTree.FirstOf(AId, NodeRole.Argument);
      if LName = 0 then
        if IsLibraryName(self.FTree[AId].Decoded) then
          LLibrary.Text := self.FTree[AId].Decoded;
          self.FTree[AId].ResolvedConst := LLibrary;
        end;
        return;
      end;
      LDecl := self.FTree[LName].ResolvedDecl;
      if LDecl = 0 then
        // NameResolver reported the name (not declared, not public, ...)
        return;
      end;
      LValue := 0;
      if self.FTree[LDecl].Kind = NodeKind.ConstDecl then
        LValue := self.FTree.FirstOf(LDecl, NodeRole.Initializer);
      end;
      if (LValue = 0) or (self.FTree[LValue].Kind <> NodeKind.StringLiteral) or
        (self.FTree[LValue].NarrowFault.Reason <> "") then
        self.DoError(LName, ADAM_ERR_SEMANTICS_326, ADAM_MSG_SEMANTICS_LIBRARY_CONST,
          NoArgs().Str(self.FTree[LName].Text));
        return;
      end;
      if not IsLibraryName(self.FTree[LValue].Decoded) then
        self.DoError(LName, ADAM_ERR_SEMANTICS_327, ADAM_MSG_SEMANTICS_LIBRARY_NAME,
          NoArgs().Str(self.FTree[LValue].Decoded));
        return;
      end;
      LLibrary.Text := self.FTree[LValue].Decoded;
      self.FTree[AId].ResolvedConst := LLibrary;
    end;

    // AId and everything under it typed, once. A directive's arguments are its values; a
    // recovered node and an error node are silent
    hidden method DoVisit(const AId: int64);
    var
      LKind: NodeKind;
    begin
      if AId = 0 then
        return;
      end;
      // A generic type instance's method no use has reached: its signature and locals typed
      // (every phase reads a routine's parameter types), its body waits for a use (DoWake)
      if IsDormantMethod(self.FTree, AId) then
        self.DoDormantSignature(AId);
        return;
      end;
      if not self.DoFirstVisit(AId) then
        return;
      end;
      LKind := self.FTree[AId].Kind;
      if (LKind = NodeKind.Directive) or (LKind = NodeKind.Error) or
        self.FTree[AId].HasFlag(NodeFlag.Recovered) then
        return;
      end;
      // An instance's clone typed whole, its reports noted at the use that made it
      if LKind = NodeKind.GenericInstance then
        self.DoInstanceVisit(AId);
        return;
      end;
      // A generic template is typed here once, its type parameters unknown (Types: what
      // depends on them is silent, typed again per instance with each type argument in
      // place, BNF sec 10)
      if ((LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.MethodDecl)) and
        (self.FTree.FirstOf(AId, NodeRole.GenericParam) <> 0) then
        self.DoGenericRoutine(AId);
      end;
      if DoIsExpression(LKind) then
        self.DoExpression(AId);
        if LKind = NodeKind.MemberExpression then
          self.DoDeclarationFirst(self.FTree[AId].ResolvedDecl);
        end;
        self.DoWakeUse(AId, LKind);
        // Folded once typed: its operands were typed and folded before it (M1.10)
        self.FFolder.Fold(AId);
        return;
      end;
      if DoIsTypeExpression(LKind) then
        self.DoTypeExpression(AId, LKind);
        return;
      end;
      match LKind of
        NodeKind.TypeDecl:
          self.DoTypeDecl(AId);
          self.DoFullType(AId);
        NodeKind.ForwardType:
          self.FForwards.Add(AId);
          self.DoForwardType(AId);
        NodeKind.ExtendDecl:
          self.DoExtendDecl(AId);
        NodeKind.ForwardRoutine:
          self.FForwards.Add(AId);
        NodeKind.VarDecl, NodeKind.ConstDecl:
          self.DoVarDecl(AId);
          if LKind = NodeKind.ConstDecl then
            self.FFolder.FoldDeclaration(AId);
            self.DoConstLiteral(self.FTree.FirstOf(AId, NodeRole.Initializer));
          end;
          // An external variable's library (its children are not visited below)
          self.DoVisit(self.FTree.FirstOf(AId, NodeRole.External));
        NodeKind.ChoicesType:
          self.DoChoices(AId);
        NodeKind.RoutineDecl:
          self.DoOverloadDeclared(AId);
          self.DoVariadicOverload(AId);
          self.DoVariadicFixed(AId);
          self.DoPairRoutine(AId);
        NodeKind.Param, NodeKind.FieldDecl:
          self.DoHeldDecl(AId);
        NodeKind.PropertyDecl:
          self.DoDeclType(AId);
        NodeKind.EmbedDecl:
          // an embed is built inside its holder (F2a0: never a ref object)
          self.DoRefOnlyHeld(self.DoDeclType(AId), self.DoAtOrSelf(self.FTree.FirstOf(AId, NodeRole.TypeOf), AId));
        NodeKind.ReturnStatement:
          self.DoReturn(AId);
        NodeKind.LeaveStatement, NodeKind.SkipStatement:
          self.DoJump(AId);
        NodeKind.DeferStatement:
          self.DoDeferDecl(AId);
        NodeKind.ForStatement:
          self.DoFor(AId);
        NodeKind.ForInStatement:
          self.DoForIn(AId);
        NodeKind.YieldStatement:
          self.DoYield(AId);
        NodeKind.MatchStatement:
          self.DoMatch(AId);
        NodeKind.ExternalClause:
          self.DoExternalClause(AId);
          if self.FTree[self.FTree.ParentOf(AId)].Kind = NodeKind.TypeDecl then
            self.DoExternalType(self.FTree.ParentOf(AId), AId);
          end;
      else
        // children below
      end;
      if (LKind = NodeKind.VarDecl) or (LKind = NodeKind.ConstDecl) or
        (LKind = NodeKind.ReturnStatement) or (LKind = NodeKind.ForStatement) or
        (LKind = NodeKind.ForInStatement) or (LKind = NodeKind.YieldStatement) or
        (LKind = NodeKind.MatchStatement) or (LKind = NodeKind.ChoicesType) or
        (LKind = NodeKind.ExternalClause) then
        // A for's and a match's statements were typed by their own check above
        self.DoUnreachable(AId);
        return;
      end;
      self.DoChildren(AId);
      if LKind = NodeKind.ExpressionStatement then
        self.DoEffect(AId);
      end;
      if (LKind = NodeKind.IfStatement) or (LKind = NodeKind.WhileStatement) or
        (LKind = NodeKind.RepeatStatement) or (LKind = NodeKind.GuardStatement) then
        self.DoCondition(self.FTree.FirstOf(AId, NodeRole.Condition));
      end;
      if (LKind = NodeKind.LockStatement) or (LKind = NodeKind.TryLockStatement) then
        self.DoLock(AId);
      end;
      self.DoUnreachable(AId);
      // Its body typed first: a raise or noreturn call's callee is resolved by then (a
      // template's body is its instances')
      if ((LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.MethodDecl) or
        (LKind = NodeKind.OperatorDecl)) and not IsInTemplate(self.FTree, AId) then
        if LKind <> NodeKind.OperatorDecl then
          self.DoGenerator(AId);
        end;
        if LKind = NodeKind.MethodDecl then
          self.DoSelfReturnDecl(AId);
        end;
        self.DoReturnPath(AId);
        self.DoMutexResult(AId);
        self.DoRefOnlyResult(AId);
      end;
    end;

    // The dormant method AId's parameters, result type and locals typed, its body left
    // for the use that wakes it (DoWake: the method visited whole then, these once)
    hidden method DoDormantSignature(const AId: int64);
    var
      LChild: int64;
      LRole: NodeRole;
      LI: int64;
    begin
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LChild := self.FTree.ChildAt(AId, LI);
        LRole := self.FTree.RoleOf(LChild);
        if (LRole = NodeRole.Param) or (LRole = NodeRole.ReturnType) or (LRole = NodeRole.Local) then
          self.DoVisit(LChild);
        end;
      end;
    end;

    // The method an expression AId of kind AKind uses, woken (DoWake): a call's callee as its
    // overloads picked it, a name or member that is no callee (a method value)
    hidden method DoWakeUse(const AId: int64; const AKind: NodeKind);
    var
      LCallee: int64;
    begin
      if AKind = NodeKind.CallExpression then
        LCallee := self.FTree.FirstOf(AId, NodeRole.Callee);
        if LCallee <> 0 then
          self.DoWake(self.FTree[LCallee].ResolvedDecl, AId);
        end;
        return;
      end;
      if ((AKind = NodeKind.MemberExpression) or (AKind = NodeKind.NameExpression)) and
        not self.DoIsCallee(AId) then
        self.DoWake(self.FTree[AId].ResolvedDecl, AId);
      end;
    end;

    // The dormant method ADecl (IsDormantMethod) the expression AUse uses, typed now (BNF
    // sec 10: an instance's method is checked and compiled only when something uses it):
    // flagged Instanced, then visited as its instance's (its reports noted at the use that
    // made the instance), in its instance's context when that is not the one being typed. A
    // use in a template wakes nothing: its instances use their own
    hidden method DoWake(const ADecl: int64; const AUse: int64);
    var
      LOuter: int64;
      LInstance: int64;
    begin
      if not IsDormantMethod(self.FTree, ADecl) or IsInTemplate(self.FTree, AUse) then
        return;
      end;
      self.FTree[ADecl].AddFlag(NodeFlag.Instanced);
      LInstance := InstanceAbove(self.FTree, ADecl);
      if LInstance = self.FInstance then
        self.DoVisit(ADecl);
        return;
      end;
      LOuter := self.FInstance;
      self.FInstance := LInstance;
      self.FResolver.EnterInstance(LInstance);
      self.DoVisit(ADecl);
      self.FResolver.LeaveInstance();
      self.FInstance := LOuter;
    end;

    // The generic instance AInstance's clone typed (BNF sec 10: each instance's body checked
    // whole, its type arguments in place), FInstance it while it is
    hidden method DoInstanceVisit(const AInstance: int64);
    var
      LOuter: int64;
    begin
      LOuter := self.FInstance;
      self.FInstance := AInstance;
      self.FResolver.EnterInstance(AInstance);
      self.DoVisit(self.FTree.FirstOf(AInstance, NodeRole.Instance));
      self.FResolver.LeaveInstance();
      self.FInstance := LOuter;
    end;

    // The instances FResolver made from its AFrom-th on typed (a routine's, and the type
    // instances its clone names: the latest first, so a type is typed before the code that
    // uses it)
    hidden method DoVisitMade(const AFrom: int64);
    var
      LI: int64;
    begin
      for LI := self.FResolver.MadeCount() - 1 downto AFrom do
        self.DoVisit(self.FResolver.MadeAt(LI));
      end;
    end;

    // The generic routine or method AId's own rules (BNF sec 10): no clink, never external
    // (SM0733: each instance is its own cpplink routine); a generic method is never
    // virtual, override or abstract (SM0734: a slot holds one method)
    hidden method DoGenericRoutine(const AId: int64);
    var
      LWord: string;
    begin
      if self.FTree[AId].HasFlag(NodeFlag.Clink) then
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_733, ADAM_MSG_SEMANTICS_GENERIC_LINKAGE,
          NoArgs().Str(self.FTree[AId].Text).Str("clink"));
      end;
      if self.FTree.FirstOf(AId, NodeRole.External) <> 0 then
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_733, ADAM_MSG_SEMANTICS_GENERIC_LINKAGE,
          NoArgs().Str(self.FTree[AId].Text).Str("external"));
      end;
      LWord := "";
      if self.FTree[AId].HasFlag(NodeFlag.Virtual) then
        LWord := "virtual";
      end;
      if self.FTree[AId].HasFlag(NodeFlag.Override) then
        LWord := "override";
      end;
      if self.FTree[AId].HasFlag(NodeFlag.Abstract) then
        LWord := "abstract";
      end;
      if LWord <> "" then
        self.DoErrorName(AId, ADAM_ERR_SEMANTICS_734, ADAM_MSG_SEMANTICS_GENERIC_DISPATCH,
          NoArgs().Str(self.FTree[AId].Text).Str(LWord));
      end;
    end;

    // The expression statement AId does something (BNF sec 5): its expression (parentheses
    // off) is an assignment, a call, ++ / --, an await, an async, an owner new or a varargs
    // next / reset; any other
    // value is computed and dropped, SM0613 at it. An '=' statement was PR0048 (that one
    // report) and a recovered node was reported where it was lost
    hidden method DoEffect(const AId: int64);
    var
      LValue: int64;
      LKind: NodeKind;
      LOp: OperatorKind;
    begin
      LValue := self.DoSkipParens(self.FTree.FirstOf(AId, NodeRole.Value));
      if (LValue = 0) or self.FTree[LValue].HasFlag(NodeFlag.Recovered) then
        return;
      end;
      LKind := self.FTree[LValue].Kind;
      LOp := self.FTree[LValue].Op;
      if (LKind = NodeKind.AssignExpression) or (LKind = NodeKind.CallExpression) or
        (LKind = NodeKind.AwaitExpression) or (LKind = NodeKind.AsyncExpression) or
        (LKind = NodeKind.OwnNew) or (LKind = NodeKind.RefNew) or (LKind = NodeKind.WeakNew) or
        (LKind = NodeKind.Error) then
        return;
      end;
      if ((LKind = NodeKind.PostfixExpression) or (LKind = NodeKind.UnaryExpression)) and
        ((LOp = OperatorKind.Increment) or (LOp = OperatorKind.Decrement)) then
        return;
      end;
      if (LKind = NodeKind.BinaryExpression) and (LOp = OperatorKind.Equal) then
        return;
      end;
      // varargs.next(T) moves the pack's cursor (its value may be dropped, skipping that
      // argument), reset() moves it back; count / kind / get / copy only read
      if (LKind = NodeKind.VarargsExpression) and
        ((self.FTree[LValue].Text = "next") or (self.FTree[LValue].Text = "reset")) then
        return;
      end;
      self.DoError(LValue, ADAM_ERR_SEMANTICS_613, ADAM_MSG_SEMANTICS_NO_EFFECT, NoArgs());
    end;

    // The type the literal AId's value is picked for: the conversion written on it (or on
    // the parentheses around it), else its own type
    hidden const method DoPickedType(const AId: int64): int64;
    var
      LAt: int64;
      LParent: int64;
    begin
      LAt := AId;
      while true do
        if self.FTree[LAt].ResolvedConvert <> 0 then
          return self.FTree[LAt].ResolvedConvert;
        end;
        LParent := self.FTree.ParentOf(LAt);
        if (LParent = 0) or (self.FTree[LParent].Kind <> NodeKind.ParenExpression) then
          return self.FTree[AId].ResolvedType;
        end;
        LAt := LParent;
      end;
    end;

    // True when the type APicked takes a literal's wide encoding: a wstring, a wchar, a
    // ptr to const wchar
    hidden const method DoIsWide(const APicked: int64): bool;
    var
      LClass: TypeClass;
    begin
      LClass := self.DoClass(APicked);
      if (LClass = TypeClass.WideText) or (LClass = TypeClass.WideChar) then
        return true;
      end;
      return (LClass = TypeClass.Pointer) and
        (self.DoClass(TargetOf(self.FTree, APicked)) = TypeClass.WideChar);
    end;

    // Each typed string / char literal's fault in the encoding its type picked (the
    // parser kept one-encoding faults on the node, BNF sec 9): SM0022 / SM0023, an error,
    // or a warning when the fault is one
    hidden method DoLiteralFaults();
    var
      LI: int64;
      LKind: NodeKind;
      LPicked: int64;
      LFault: EncodingFault;
      LSeverity: Severity;
      LCode: string;
      LTemplate: string;
    begin
      for LI := 1 to self.FTree.Count - 1 do
        LKind := self.FTree[LI].Kind;
        // A compiled unit's literal was told when its unit was compiled
        if ((LKind = NodeKind.StringLiteral) or (LKind = NodeKind.CharLiteral)) and
          (self.FTree[LI].ResolvedType <> 0) and not self.FTree[LI].HasFlag(NodeFlag.Compiled) then
          LPicked := self.DoPickedType(LI);
          if self.DoIsWide(LPicked) then
            LFault := self.FTree[LI].WideFault;
          else
            LFault := self.FTree[LI].NarrowFault;
          end;
          if LFault.Reason <> "" then
            LSeverity := Severity.Error;
            if LFault.IsWarning then
              LSeverity := Severity.Warning;
            end;
            LCode := ADAM_ERR_SEMANTICS_022;
            LTemplate := ADAM_MSG_SEMANTICS_BAD_STRING_AS;
            if LKind = NodeKind.CharLiteral then
              LCode := ADAM_ERR_SEMANTICS_023;
              LTemplate := ADAM_MSG_SEMANTICS_BAD_CHAR_AS;
            end;
            self.FDiagnostics.Add(LSeverity, LCode, self.FTree[LI].Place, LTemplate,
              NoArgs().Str(self.DoText(LPicked)).Str(LFault.Reason));
          end;
        end;
      end;
    end;

    // SM0017 at every name a declaration in a source module declares that starts with
    // ADAM_RESERVED_PREFIX (a var, const, type, routine, method, property, field, embed,
    // parameter or choice value; a forward's full declaration reports for it). A compiled
    // unit's nodes were judged when it compiled, a recovered node's span already reported
    hidden method DoReservedNames();
    var
      LI: int64;
      LKind: NodeKind;
    begin
      for LI := 1 to self.FTree.Count - 1 do
        LKind := self.FTree[LI].Kind;
        if (LKind = NodeKind.VarDecl) or (LKind = NodeKind.ConstDecl) or
          (LKind = NodeKind.TypeDecl) or (LKind = NodeKind.RoutineDecl) or
          (LKind = NodeKind.MethodDecl) or (LKind = NodeKind.PropertyDecl) or
          (LKind = NodeKind.FieldDecl) or (LKind = NodeKind.EmbedDecl) or
          (LKind = NodeKind.Param) or (LKind = NodeKind.ChoiceValue) then
          // a variable's hidden holder (F4) is the compiler's own
          if StartsStr(ADAM_RESERVED_PREFIX, self.FTree[LI].Text) and
            not IsCTextHolder(self.FTree, LI) and
            not self.FTree[LI].HasFlag(NodeFlag.Compiled) and
            not self.FTree[LI].HasFlag(NodeFlag.Recovered) then
            self.DoErrorName(LI, ADAM_ERR_SEMANTICS_017, ADAM_MSG_SEMANTICS_RESERVED_NAME,
              NoArgs().Str(self.FTree[LI].Text).Str(ADAM_RESERVED_PREFIX));
          end;
        end;
      end;
    end;

    // True when the node AId lies in a module taken from its compiled unit (.acu: flagged
    // Compiled), whose own nodes no walk of Run visits
    hidden const method DoInCompiledModule(const AId: int64): bool;
    var
      LAt: int64;
    begin
      LAt := self.FTree.ParentOf(AId);
      while (LAt <> 0) and (LAt <> ADAM_AST_PROGRAM) do
        if self.FTree.RoleOf(LAt) = NodeRole.Module then
          return self.FTree[LAt].HasFlag(NodeFlag.Compiled);
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // Every static array's and set range's bounds typed and folded first (a type's key and
    // a layout read their values wherever the type is first met), then every module of
    // the program typed, then the forwards no full declaration completed, then the
    // literals' picked faults. A compiled unit's nodes are typed already: none is visited
    method Run();
    var
      LI: int64;
      LKind: NodeKind;
      LModule: int64;
    begin
      // Every constant a layout reads (array and set bounds, bitfield widths, packed(N),
      // align(N)) typed and folded before any module: a module may lay out another one's
      // type before that module's own walk reaches it (main's size(T) of a unit's T)
      for LI := 1 to self.FTree.Count - 1 do
        LKind := self.FTree[LI].Kind;
        if (self.FTree.ParentOf(LI) = ADAM_AST_DERIVED) or
          self.FTree[LI].HasFlag(NodeFlag.Compiled) then
          skip;
        end;
        if (LKind = NodeKind.ArrayType) or (LKind = NodeKind.SetType) then
          self.DoVisit(self.FTree.FirstOf(LI, NodeRole.LowBound));
          self.DoVisit(self.FTree.FirstOf(LI, NodeRole.HighBound));
        end;
        if LKind = NodeKind.FieldDecl then
          self.DoVisit(self.FTree.FirstOf(LI, NodeRole.BitWidth));
        end;
        if (LKind = NodeKind.RecordType) or (LKind = NodeKind.AnonRecord) or
          (LKind = NodeKind.OverlayType) or (LKind = NodeKind.ObjectType) then
          self.DoVisit(self.FTree.FirstOf(LI, NodeRole.Pack));
          self.DoVisit(self.FTree.FirstOf(LI, NodeRole.Align));
        end;
      end;
      // Every instance this build made of a compiled unit's generic (ResolveNames hangs it
      // beside its generic, in that unit: BNF sec 10), typed as a source module's are: the
      // walk below never enters a compiled module, and the code that uses the instance
      // reads its members' bindings and types
      for LI := 1 to self.FTree.Count - 1 do
        if (self.FTree[LI].Kind = NodeKind.GenericInstance) and
          not self.FTree[LI].HasFlag(NodeFlag.Compiled) and self.DoInCompiledModule(LI) then
          self.DoVisit(LI);
        end;
      end;
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        LModule := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        if not self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
          self.DoVisit(LModule);
        end;
      end;
      self.DoPublicHolders();
      self.DoCTextHolds();
      self.DoUnpairedForwards();
      self.DoGenericValues();
      self.DoReservedNames();
      self.DoLiteralFaults();
      self.DoProgramExits();
      self.DoRuntimeRoutines();
      self.DoDirectiveFiles();
      self.DoDirectiveValues();
      self.DoMessages();
    end;

    // AModule's own words for a module that is no exe, as SM0103 names it ("" for an exe)
    hidden const method DoNotExeText(const AModule: int64): string;
    begin
      match self.FTree[AModule].Module of
        ModuleKind.DLL: return ADAM_MSG_SEMANTICS_KIND_A_DLL;
        ModuleKind.Lib: return ADAM_MSG_SEMANTICS_KIND_A_LIB;
        ModuleKind.Unit: return ADAM_MSG_SEMANTICS_KIND_A_UNIT;
      else
        return "";
      end;
    end;

    // True for a directive given at most once in a module (BNF sec 2; @target and
    // @optimize are judged where they are read, Conditionals)
    hidden const method DoSingleValued(const ASpelling: string): bool;
    begin
      return (ASpelling = "@subsystem") or (ASpelling = "@addverinfo") or
        (ASpelling = "@unitTestMode") or (ASpelling = "@exeicon") or
        (ASpelling = "@outputpath") or self.DoVersionDirective(ASpelling);
    end;

    // True for the version info directives (@vi*: stamped only with @addverinfo on)
    hidden const method DoVersionDirective(const ASpelling: string): bool;
    begin
      return DoIsVersionDirective(ASpelling);
    end;

    // The @vi* directive ADirective's value into its argument's ResolvedConst, the one
    // place the Driver reads it (BNF sec 2): a number (Unsigned) for @vimajor / @viminor /
    // @vipatch, 0..65535 (SM0101); a text (String) for the other five. A literal gives its
    // own value; a constant's name (user 2026-11-16) is typed and folded here, and must
    // name a constant of that kind (SM0123), the module's own or an imported unit's public
    // one (names resolved it). A name names reported already keeps Unknown
    hidden method DoVersionValue(const ADirective: int64);
    var
      LSpelling: string;
      LArg: int64;
      LDecl: int64;
      LNumber: bool;
      LValue: ConstValue;
      LTaken: string;
    begin
      LSpelling := self.FTree[ADirective].Text;
      if self.FTree.CountOf(ADirective, NodeRole.Argument) = 0 then
        return;
      end;
      LArg := self.FTree.NthOf(ADirective, NodeRole.Argument, 0);
      LNumber := (LSpelling = "@vimajor") or (LSpelling = "@viminor") or (LSpelling = "@vipatch");
      if DoDirectiveConstName(self.FTree, ADirective) = 0 then
        // a literal: the parser read its value (PR0009 left a bad string without one)
        if LNumber then
          LValue.Kind := ConstKind.Unsigned;
          LValue.Bits := uint64(self.FTree[LArg].IntValue);
          LValue.Float := 0.0;
          LValue.Text := "";
          if LValue.Bits > 65535 then
            self.DoError(LArg, ADAM_ERR_SEMANTICS_101, ADAM_MSG_SEMANTICS_DIRECTIVE_RANGE,
              NoArgs().Str(LSpelling).Str(self.FTree[LArg].Text));
            return;
          end;
        else
          if self.FTree[LArg].NarrowFault.Reason <> "" then
            return;
          end;
          LValue.Kind := ConstKind.String;
          LValue.Bits := 0;
          LValue.Float := 0.0;
          LValue.Text := self.FTree[LArg].Decoded;
        end;
        self.FTree[LArg].ResolvedConst := LValue;
        return;
      end;
      LDecl := self.FTree[LArg].ResolvedDecl;
      if LDecl = 0 then
        // names reported it (not declared, not public, ...)
        return;
      end;
      self.DoVisit(LArg);
      LValue := self.FTree[LArg].ResolvedConst;
      if LNumber then
        LTaken := ADAM_MSG_SEMANTICS_VI_INT_CONST;
      else
        LTaken := ADAM_MSG_SEMANTICS_VI_STRING_CONST;
      end;
      if (self.FTree[LDecl].Kind <> NodeKind.ConstDecl) or
        (LNumber and (LValue.Kind <> ConstKind.Signed) and (LValue.Kind <> ConstKind.Unsigned)) or
        (not LNumber and (LValue.Kind <> ConstKind.String)) then
        self.DoError(LArg, ADAM_ERR_SEMANTICS_123, ADAM_MSG_SEMANTICS_DIRECTIVE_CONST,
          NoArgs().Str(LSpelling).Str(LTaken).Str(self.DoExprText(LArg)));
        return;
      end;
      if LNumber then
        // a negative Signed value is past 65535 as its unsigned bits
        if (LValue.Kind = ConstKind.Signed) and (int64(LValue.Bits) < 0) then
          self.DoError(LArg, ADAM_ERR_SEMANTICS_101, ADAM_MSG_SEMANTICS_DIRECTIVE_RANGE,
            NoArgs().Str(LSpelling).Str(IntToStr(int64(LValue.Bits))));
          return;
        end;
        if LValue.Bits > 65535 then
          self.DoError(LArg, ADAM_ERR_SEMANTICS_101, ADAM_MSG_SEMANTICS_DIRECTIVE_RANGE,
            NoArgs().Str(LSpelling).Str(UIntToStr(LValue.Bits)));
          return;
        end;
        LValue.Kind := ConstKind.Unsigned;
      end;
      self.FTree[LArg].ResolvedConst := LValue;
    end;

    // The name argument of the directive ADirective, "" when it has none (the parser
    // reported a missing or misshapen one)
    hidden const method DoDirectiveWord(const ADirective: int64): string;
    begin
      if self.FTree.CountOf(ADirective, NodeRole.Argument) = 0 then
        return "";
      end;
      return self.FTree[self.FTree.NthOf(ADirective, NodeRole.Argument, 0)].Text;
    end;

    // The name value of the directive ADirective is one of AFirst / ASecond (exact case,
    // BNF sec 2), else SM0100 at it naming both
    hidden method DoDirectiveChoice(const ADirective: int64; const AFirst: string;
      const ASecond: string);
    var
      LWord: string;
    begin
      LWord := self.DoDirectiveWord(ADirective);
      if (LWord = "") or (LWord = AFirst) or (LWord = ASecond) then
        return;
      end;
      self.DoError(self.FTree.NthOf(ADirective, NodeRole.Argument, 0), ADAM_ERR_SEMANTICS_100,
        ADAM_MSG_SEMANTICS_DIRECTIVE_VALUE,
        NoArgs().Str(LWord).Str(self.FTree[ADirective].Text).Str(AFirst + " | " + ASecond));
    end;

    // A warning at ADirective: it does not apply to AWhat and is not used (SM0103)
    hidden method DoNotApplied(const ADirective: int64; const AWhat: string);
    begin
      self.FDiagnostics.Add(Severity.Warning, ADAM_ERR_SEMANTICS_103, self.FTree[ADirective].Place,
        ADAM_MSG_SEMANTICS_DIRECTIVE_NOT_APPLIED, NoArgs().Str(self.FTree[ADirective].Text).Str(AWhat));
    end;

    // The prologue directives of the module AModule (BNF sec 2): a single-valued one given
    // twice is SM0102 at the second; @subsystem / @addverinfo / @unitTestMode take their
    // words (SM0100); a @vi* number 0..65535 (SM0101) and only with @addverinfo on (else
    // the warning SM0104); a setting the module or the target cannot take is the warning
    // SM0103 and is not applied; @breakpoint in the prologue the warning SM0109
    hidden method DoModuleDirectives(const AModule: int64);
    var
      LI: int64;
      LDirective: int64;
      LSpelling: string;
      LFirst: int64;
      LVerInfo: bool;
      LSeen: ref StringIdMap;
    begin
      LVerInfo := false;
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Directive) - 1 do
        LDirective := self.FTree.NthOf(AModule, NodeRole.Directive, LI);
        if (self.FTree[LDirective].Text = "@addverinfo") and (self.DoDirectiveWord(LDirective) = "on") then
          LVerInfo := true;
        end;
      end;
      LSeen := ref StringIdMap(0);
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Directive) - 1 do
        LDirective := self.FTree.NthOf(AModule, NodeRole.Directive, LI);
        if self.FTree[LDirective].HasFlag(NodeFlag.Recovered) then
          skip;
        end;
        LSpelling := self.FTree[LDirective].Text;
        if self.DoSingleValued(LSpelling) then
          LFirst := LSeen.Find(LSpelling);
          if LFirst <> 0 then
            self.DoError(LDirective, ADAM_ERR_SEMANTICS_102, ADAM_MSG_SEMANTICS_DIRECTIVE_TWICE,
              NoArgs().Str(LSpelling).Int(int64(self.FTree[LFirst].Place.Line)));
            skip;
          end;
          LSeen.Put(LSpelling, LDirective);
        end;
        if LSpelling = "@breakpoint" then
          self.FDiagnostics.Add(Severity.Warning, ADAM_ERR_SEMANTICS_109, self.FTree[LDirective].Place,
            ADAM_MSG_SEMANTICS_DIRECTIVE_PROLOGUE_BREAKPOINT, NoArgs());
        end;
        if (LSpelling = "@addverinfo") or (LSpelling = "@unitTestMode") then
          self.DoDirectiveChoice(LDirective, "on", "off");
        end;
        // the test runner is an exe's (BNF sec 8): its entry runs it in place of its block
        if LSpelling = "@unitTestMode" then
          if self.DoNotExeText(AModule) <> "" then
            self.DoError(LDirective, ADAM_ERR_SEMANTICS_110, ADAM_MSG_SEMANTICS_TEST_MODE_EXE,
              NoArgs().Str(self.DoNotExeText(AModule)));
          else
            if self.DoDirectiveWord(LDirective) = "on" then
              self.FTree[AModule].AddFlag(NodeFlag.UnitTests);
            end;
          end;
        end;
        if LSpelling = "@subsystem" then
          self.DoDirectiveChoice(LDirective, "console", "gui");
        end;
        if self.DoVersionDirective(LSpelling) then
          self.DoVersionValue(LDirective);
        end;
        if self.DoVersionDirective(LSpelling) and not LVerInfo then
          self.FDiagnostics.Add(Severity.Warning, ADAM_ERR_SEMANTICS_104, self.FTree[LDirective].Place,
            ADAM_MSG_SEMANTICS_DIRECTIVE_NO_VERINFO, NoArgs().Str(LSpelling));
        end;
        // What the module or the target cannot take (BNF sec 2): a warning, not applied
        if (LSpelling = "@exeicon") and (self.DoNotExeText(AModule) <> "") then
          self.DoNotApplied(LDirective, self.DoNotExeText(AModule));
        end;
        if (LSpelling = "@subsystem") and (self.DoDirectiveWord(LDirective) = "gui") then
          if self.DoNotExeText(AModule) <> "" then
            self.DoNotApplied(LDirective, self.DoNotExeText(AModule));
          else
            if (self.FTarget <> nil) and not self.FTarget.HasGUISubsystem() then
              self.DoNotApplied(LDirective,
                NoArgs().Str(self.FTarget.Triple()).Fill(ADAM_MSG_SEMANTICS_KIND_TARGET));
            end;
          end;
        end;
        if (LSpelling = "@addverinfo") and (self.DoDirectiveWord(LDirective) = "on") then
          if self.FTree[AModule].Module = ModuleKind.Lib then
            self.DoNotApplied(LDirective, ADAM_MSG_SEMANTICS_KIND_A_LIB);
          else
            if (self.FTarget <> nil) and not self.FTarget.HasVersionInfo() then
              self.DoNotApplied(LDirective,
                NoArgs().Str(self.FTarget.Triple()).Fill(ADAM_MSG_SEMANTICS_KIND_TARGET));
            end;
          end;
        end;
      end;
    end;

    // The @addresdata key AArg (its decoded text) of a module this build checks: empty or
    // holding a control character (below 32, or 127) is SM0119; one starting with the
    // compiler's prefix adam/ (its own keys, as adam/exeicon) SM0120; one AKeys already
    // holds (an earlier @addresdata of the build) SM0121 naming its line; else it is added
    hidden method DoResDataKey(const AArg: int64; const AKeys: ref StringIdMap);
    var
      LKey: string;
      LI: int64;
      LCode: int64;
      LFirst: int64;
    begin
      LKey := self.FTree[AArg].Decoded;
      if LKey = "" then
        self.DoError(AArg, ADAM_ERR_SEMANTICS_119, ADAM_MSG_SEMANTICS_RESDATA_KEY, NoArgs());
        return;
      end;
      for LI := 0 to len(LKey) - 1 do
        LCode := int64(uint8(LKey[LI]));
        if (LCode < 32) or (LCode = 127) then
          self.DoError(AArg, ADAM_ERR_SEMANTICS_119, ADAM_MSG_SEMANTICS_RESDATA_KEY, NoArgs());
          return;
        end;
      end;
      if StartsStr(ADAM_RESDATA_COMPILER_PREFIX, LKey) then
        self.DoError(AArg, ADAM_ERR_SEMANTICS_120, ADAM_MSG_SEMANTICS_RESDATA_RESERVED,
          NoArgs().Str(LKey));
        return;
      end;
      LFirst := AKeys.Find(LKey);
      if LFirst <> 0 then
        self.DoError(AArg, ADAM_ERR_SEMANTICS_121, ADAM_MSG_SEMANTICS_RESDATA_TWICE,
          NoArgs().Str(LKey).Int(int64(self.FTree[LFirst].Place.Line)));
        return;
      end;
      AKeys.Put(LKey, AArg);
    end;

    // The test blocks of the module AModule (BNF sec 8): a name non-empty (SM0111) and
    // unique in the module (SM0112 at the second); one of a dll or a lib, which no program
    // runs, the warning SM0113. A test the parser left without its name is not judged
    hidden method DoModuleTests(const AModule: int64);
    var
      LI: int64;
      LTest: int64;
      LName: int64;
      LFirst: int64;
      LSeen: ref StringIdMap;
    begin
      LSeen := ref StringIdMap(0);
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Test) - 1 do
        LTest := self.FTree.NthOf(AModule, NodeRole.Test, LI);
        LName := self.FTree.FirstOf(LTest, NodeRole.Label);
        if LName = 0 then
          skip;
        end;
        if (self.FTree[AModule].Module = ModuleKind.DLL) or
          (self.FTree[AModule].Module = ModuleKind.Lib) then
          self.FDiagnostics.Add(Severity.Warning, ADAM_ERR_SEMANTICS_113, self.FTree[LTest].Place,
            ADAM_MSG_SEMANTICS_TEST_NEVER_RUNS, NoArgs().Str(self.DoNotExeText(AModule)));
        end;
        if self.FTree[LTest].Text = "" then
          self.DoError(LName, ADAM_ERR_SEMANTICS_111, ADAM_MSG_SEMANTICS_TEST_NAME_EMPTY, NoArgs());
          skip;
        end;
        LFirst := LSeen.Find(self.FTree[LTest].Text);
        if LFirst <> 0 then
          self.DoError(LName, ADAM_ERR_SEMANTICS_112, ADAM_MSG_SEMANTICS_TEST_NAME_TWICE,
            NoArgs().Str(self.FTree[LTest].Text).Int(int64(self.FTree[LFirst].Place.Line)));
          skip;
        end;
        LSeen.Put(self.FTree[LTest].Text, LTest);
      end;
    end;

    // Every module's build directives (BNF sec 2), in the program's module order: each
    // checked module's prologue (DoModuleDirectives), and every @addresdata key of the one
    // build (DoResDataKey; a compiled unit's keys are added unchecked, they were checked
    // when it was compiled)
    hidden method DoDirectiveValues();
    var
      LI: int64;
      LJ: int64;
      LModule: int64;
      LDirective: int64;
      LArg: int64;
      LKeys: ref StringIdMap;
    begin
      LKeys := ref StringIdMap(0);
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        LModule := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        if not self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
          self.DoModuleDirectives(LModule);
          self.DoModuleTests(LModule);
        end;
        for LJ := 0 to self.FTree.CountOf(LModule, NodeRole.Directive) - 1 do
          LDirective := self.FTree.NthOf(LModule, NodeRole.Directive, LJ);
          if (self.FTree[LDirective].Text = ADAM_SEMANTICS_DIRECTIVE_RESDATA) and
            not self.FTree[LDirective].HasFlag(NodeFlag.Recovered) and
            (self.FTree.CountOf(LDirective, NodeRole.Argument) = 2) then
            LArg := self.FTree.NthOf(LDirective, NodeRole.Argument, 0);
            if self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
              if LKeys.Find(self.FTree[LArg].Decoded) = 0 then
                LKeys.Put(self.FTree[LArg].Decoded, LArg);
              end;
            else
              self.DoResDataKey(LArg, LKeys);
            end;
          end;
        end;
      end;
      self.DoResDataCalls(LKeys);
    end;

    // Every call this build checks of System.ResData's FindResData / HasResData whose key is
    // a string literal no @addresdata of the build adds (BNF sec 2: it is never found):
    // SM0122, a warning at the key. AKeys: every key of the build (DoDirectiveValues). A
    // linked static library's keys join them with M8's libraries
    hidden method DoResDataCalls(const AKeys: ref StringIdMap);
    var
      LI: int64;
      LCallee: int64;
      LDecl: int64;
      LArg: int64;
      LModule: int64;
    begin
      for LI := 1 to self.FTree.Count - 1 do
        if (self.FTree[LI].Kind <> NodeKind.CallExpression) or
          self.FTree[LI].HasFlag(NodeFlag.Compiled) or
          self.FTree[LI].HasFlag(NodeFlag.Recovered) or
          (self.FTree.CountOf(LI, NodeRole.Argument) <> 1) then
          skip;
        end;
        LCallee := self.FTree.FirstOf(LI, NodeRole.Callee);
        if LCallee = 0 then
          skip;
        end;
        LDecl := self.FTree[LCallee].ResolvedDecl;
        if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.RoutineDecl) then
          skip;
        end;
        if (self.FTree[LDecl].Text <> ADAM_SEMANTICS_RESDATA_FIND) and
          (self.FTree[LDecl].Text <> ADAM_SEMANTICS_RESDATA_HAS) then
          skip;
        end;
        LModule := ModuleOf(self.FTree, LDecl);
        if (LModule = 0) or (self.FTree[LModule].Text <> ADAM_SEMANTICS_RESDATA_UNIT) then
          skip;
        end;
        LArg := self.FTree.NthOf(LI, NodeRole.Argument, 0);
        if (self.FTree[LArg].Kind = NodeKind.StringLiteral) and
          (AKeys.Find(self.FTree[LArg].Decoded) = 0) then
          self.FDiagnostics.Add(Severity.Warning, ADAM_ERR_SEMANTICS_122, self.FTree[LArg].Place,
            ADAM_MSG_SEMANTICS_RESDATA_UNKNOWN, NoArgs().Str(self.FTree[LArg].Decoded));
        end;
      end;
    end;

    // Every @message of the modules this build checks (a compiled unit's reported when it
    // was compiled), in the prologue or among statements (BNF sec 2 / 5: wherever it
    // stands, whether or not its code runs; an inactive @ifdef branch's was never parsed),
    // in source order: SM0108 at the directive, its text at its severity (hint, warn,
    // error, fatal: error and fatal fail the build)
    hidden method DoMessages();
    var
      LId: int64;
      LSeverity: Severity;
      LWord: string;
    begin
      for LId := 1 to self.FTree.Count - 1 do
        if (self.FTree[LId].Kind = NodeKind.Directive) and
          (self.FTree[LId].Text = ADAM_SEMANTICS_DIRECTIVE_MESSAGE) and
          not self.FTree[LId].HasFlag(NodeFlag.Recovered) and
          (self.FTree.CountOf(LId, NodeRole.Argument) = 2) and
          not self.FTree[ModuleOf(self.FTree, LId)].HasFlag(NodeFlag.Compiled) then
          LWord := self.FTree[self.FTree.NthOf(LId, NodeRole.Argument, 0)].Text;
          LSeverity := Severity.Fatal;
          if LWord = ADAM_SEMANTICS_MESSAGE_HINT then
            LSeverity := Severity.Hint;
          else
            if LWord = ADAM_SEMANTICS_MESSAGE_WARN then
              LSeverity := Severity.Warning;
            else
              if LWord = ADAM_SEMANTICS_MESSAGE_ERROR then
                LSeverity := Severity.Error;
              end;
            end;
          end;
          self.FDiagnostics.Add(LSeverity, ADAM_ERR_SEMANTICS_108, self.FTree[LId].Place,
            ADAM_MSG_SEMANTICS_MESSAGE, NoArgs().Str(self.FTree[self.FTree.NthOf(LId, NodeRole.Argument, 1)].Decoded));
        end;
      end;
    end;

    // The file the directive ADirective names, its kind's one extension AExt forced (PLAN-EXT
    // X4, his 2026-11-13): a name with no extension gets AExt (its ResolvedPath updated: what
    // the build reads), another extension is SM0625 at the path as written (never replaced: that
    // could pick another file); then it must exist (BNF sec 2), else SM0626. A path the parser could not resolve
    // was reported there
    hidden method DoDirectiveFile(const ADirective: int64; const AExt: string);
    var
      LArg: int64;
      LPath: string;
      LExt: string;
    begin
      if self.FTree.CountOf(ADirective, NodeRole.Argument) = 0 then
        return;
      end;
      LArg := self.FTree.NthOf(ADirective, NodeRole.Argument, 0);
      if DoDirectiveConstName(self.FTree, ADirective) <> 0 then
        self.DoConstPath(ADirective, LArg);
      end;
      LPath := self.FTree[LArg].ResolvedPath;
      if LPath = "" then
        return;
      end;
      // AExt "" (no target picked): the extension is not known, only the file is looked for
      LExt := ExtractFileExt(LPath);
      if (AExt <> "") and (LExt = "") then
        LPath := LPath + AExt;
        self.FTree[LArg].ResolvedPath := LPath;
      end;
      if (AExt <> "") and (LExt <> "") and (LowerCase(LExt) <> AExt) then
        self.DoError(LArg, ADAM_ERR_SEMANTICS_625, ADAM_MSG_SEMANTICS_DIRECTIVE_EXT,
          NoArgs().Str(self.FTree[ADirective].Text).Str(self.DoPathText(LArg)).Str(AExt));
        return;
      end;
      self.DoDirectiveExists(ADirective, LArg, false);
    end;

    // A path argument AArg as written: a literal's decoded text, a constant name's value
    // (DoConstPath put it in its ResolvedConst)
    hidden const method DoPathText(const AArg: int64): string;
    begin
      if self.FTree[AArg].Kind = NodeKind.StringLiteral then
        return self.FTree[AArg].Decoded;
      end;
      return self.FTree[AArg].ResolvedConst.Text;
    end;

    // The constant name AArg a path directive ADirective gives (DoDirectiveConstName, BNF sec
    // 2): typed and folded, it must name a string constant (SM0123), the module's own or an
    // imported unit's public one (names resolved it); its value goes into AArg's
    // ResolvedConst and, resolved as a literal's path is (ResolveDirectivePath with the
    // build's project root), into its ResolvedPath: $R: with no project is SM0124, a value
    // that resolves to nothing SM0125. A name names reported already is left alone
    hidden method DoConstPath(const ADirective: int64; const AArg: int64);
    var
      LDecl: int64;
      LValue: ConstValue;
      LPath: string;
      LNoRoot: bool;
    begin
      LDecl := self.FTree[AArg].ResolvedDecl;
      if LDecl = 0 then
        return;
      end;
      self.DoVisit(AArg);
      LValue := self.FTree[AArg].ResolvedConst;
      if (self.FTree[LDecl].Kind <> NodeKind.ConstDecl) or (LValue.Kind <> ConstKind.String) then
        self.DoError(AArg, ADAM_ERR_SEMANTICS_123, ADAM_MSG_SEMANTICS_DIRECTIVE_CONST,
          NoArgs().Str(self.FTree[ADirective].Text).Str(ADAM_MSG_SEMANTICS_VI_STRING_CONST)
          .Str(self.DoExprText(AArg)));
        return;
      end;
      LPath := ResolveDirectivePath(LValue.Text, self.FTree.ProjectRoot, LNoRoot);
      if LNoRoot then
        self.DoError(AArg, ADAM_ERR_SEMANTICS_124, ADAM_MSG_SEMANTICS_CONST_PATH_NO_ROOT,
          NoArgs().Str(self.FTree[ADirective].Text).Str(LValue.Text).Str(self.DoExprText(AArg)));
        return;
      end;
      if LPath = "" then
        self.DoError(AArg, ADAM_ERR_SEMANTICS_125, ADAM_MSG_SEMANTICS_CONST_PATH_RESOLVE,
          NoArgs().Str(self.FTree[ADirective].Text).Str(LValue.Text).Str(self.DoExprText(AArg)));
        return;
      end;
      self.FTree[AArg].ResolvedPath := LPath;
    end;

    // SM0626 at AArg (the argument of ADirective holding a path) when what its ResolvedPath
    // names is not there (a folder: AFolder, else a file; BNF sec 2), at the path as
    // written. A path the parser could not resolve was reported there
    hidden method DoDirectiveExists(const ADirective: int64; const AArg: int64;
      const AFolder: bool);
    var
      LPath: string;
      LThere: bool;
    begin
      LPath := self.FTree[AArg].ResolvedPath;
      if LPath = "" then
        return;
      end;
      if AFolder then
        LThere := DirectoryExists(LPath);
      else
        LThere := FileExists(LPath);
      end;
      if not LThere then
        self.DoError(AArg, ADAM_ERR_SEMANTICS_626, ADAM_MSG_SEMANTICS_DIRECTIVE_MISSING,
          NoArgs().Str(self.FTree[ADirective].Text).Str(self.DoPathText(AArg)));
      end;
    end;

    // The argument number AIndex of ADirective, then whether what its path names is there
    hidden method DoDirectiveArgExists(const ADirective: int64; const AIndex: int64;
      const AFolder: bool);
    begin
      if self.FTree.CountOf(ADirective, NodeRole.Argument) > AIndex then
        self.DoDirectiveExists(ADirective,
          self.FTree.NthOf(ADirective, NodeRole.Argument, AIndex), AFolder);
      end;
    end;

    // The picked target's dll extension; "" with no target picked
    hidden method DoDLLExtension(): string;
    begin
      if self.FTarget = nil then
        return "";
      end;
      return self.FTarget.DLLExtension();
    end;

    // Every @exeicon (ADAM_EXT_ICON on every target, BNF sec 2) and @copydll (the target's
    // DLLExtension) of the modules this build checks (a compiled unit's were checked when it
    // was compiled); with no target picked a @copydll's extension is not known: only its
    // file is looked for
    hidden method DoDirectiveFiles();
    var
      LModule: int64;
      LDirective: int64;
      LI: int64;
      LJ: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        LModule := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        if not self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
          for LJ := 0 to self.FTree.CountOf(LModule, NodeRole.Directive) - 1 do
            LDirective := self.FTree.NthOf(LModule, NodeRole.Directive, LJ);
            if self.FTree[LDirective].Text = ADAM_SEMANTICS_DIRECTIVE_ICON then
              self.DoDirectiveFile(LDirective, ADAM_EXT_ICON);
            end;
            if self.FTree[LDirective].Text = ADAM_SEMANTICS_DIRECTIVE_COPYDLL then
              self.DoDirectiveFile(LDirective, self.DoDLLExtension());
            end;
            // A data file (any kind: no extension forced) and the search folders
            if self.FTree[LDirective].Text = ADAM_SEMANTICS_DIRECTIVE_RESDATA then
              self.DoDirectiveArgExists(LDirective, 1, false);
            end;
            if (self.FTree[LDirective].Text = ADAM_SEMANTICS_DIRECTIVE_LIBRARYPATH) or
              (self.FTree[LDirective].Text = ADAM_SEMANTICS_DIRECTIVE_MODULEPATH) then
              self.DoDirectiveArgExists(LDirective, 0, true);
            end;
          end;
        end;
      end;
    end;
  end;

// Every expression, declaration and conversion of the program in ATree typed into the
// AST (see TypeChecker), reporting into ADiagnostics. Runs after ResolveNames: it reads
// what names mean. ATarget answers size(T) (nil: no target picked, size(T) stays unfolded)
public func CheckTypes(const ATree: ref SyntaxTree; const ATarget: ref Target;
  const ADiagnostics: ref Diagnostics);
var
  LChecker: ref TypeChecker;
begin
  LChecker := ref TypeChecker(ATree, ATarget, ADiagnostics);
  LChecker.Run();
end;

end.
