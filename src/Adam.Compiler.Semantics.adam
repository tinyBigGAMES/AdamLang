  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_FLOAT32: string = "SinkSpecFloat32";
  ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_FLOAT64: string = "SinkSpecFloat64";
  // A range's element in the debug form where it differs from `?` (M3.8f6)
  ADAM_SEMANTICS_RUNTIME_WRITE_DEBUG_WIDE_CHAR: string = "SinkDebugWideChar";
  ADAM_SEMANTICS_RUNTIME_WRITE_DEBUG_C_TEXT: string = "SinkDebugCText";
  ADAM_SEMANTICS_RUNTIME_WRITE_DEBUG_WIDE_C_TEXT: string = "SinkDebugWideCText";
  // The entry's exit handler that waits for every running task (M3.8g0b3)
  ADAM_SEMANTICS_RUNTIME_TASK_WAIT: string = "TaskWait";
  // A typed pack's checked item (next / get / kind) and the choices type kind(I) answers
  // with (M3.8h, BNF sec 6 varargs expr)
  ADAM_SEMANTICS_RUNTIME_PACK_ITEM: string = "PackItem";
  ADAM_SEMANTICS_RUNTIME_VAR_KIND: string = "VarKind";
  // The threadstatic the compiled code stores an allocation's site id into (M3.12b)
  ADAM_SEMANTICS_RUNTIME_ALLOC_SITE: string = "GAllocSite";
  // The leak tracker's site table handed over by a debug build's entry (M4.L1); the runtime
  // declares it (and GAllocSite) only under `@ifdef DEBUG`
  ADAM_SEMANTICS_RUNTIME_HEAP_SITES: string = "HeapSiteList";
  // The walker of a print / println / FormatStr format known only at run time (M3.8i)
  ADAM_SEMANTICS_RUNTIME_FORMAT_RUN: string = "FormatRun";
  // The index check's raises (M3.11a): a static array's bounds, a block's length
  ADAM_SEMANTICS_RUNTIME_INDEX_FAIL: string = "IndexFail";
  ADAM_SEMANTICS_RUNTIME_INDEX_FAIL_IN: string = "IndexFailIn";
  // The nil owner check's raise (M3.11b): an object reached through a nil ref
  ADAM_SEMANTICS_RUNTIME_NIL_OWNER_FAIL: string = "NilOwnerFail";
  // The platform unit's routines (Target.RuntimeUnit, imported by the runtime unit): the one
  // the OS calls for a frame whose unwind data holds a scope table, the entry's catching
  // scope's filter, and the one the OS calls as a thread starts and ends
  ADAM_SEMANTICS_PLATFORM_FRAME_HANDLER: string = "PlatformFrameHandler";
  ADAM_SEMANTICS_PLATFORM_CATCH: string = "PlatformCatch";
  ADAM_SEMANTICS_PLATFORM_THREAD_CALLBACK: string = "PlatformThreadCallback";

  ADAM_ERR_SEMANTICS_001: string = "SM0001";   // a name used in its own declaration
  ADAM_ERR_SEMANTICS_002: string = "SM0002";   // a name used before its declaration
  ADAM_ERR_SEMANTICS_004: string = "SM0004";   // a name declared twice in one scope
  ADAM_ERR_SEMANTICS_005: string = "SM0005";   // a unit has no such name
  ADAM_ERR_SEMANTICS_006: string = "SM0006";   // a unit's name not public
  ADAM_ERR_SEMANTICS_007: string = "SM0007";   // a dotted prefix that is no imported module
  ADAM_ERR_SEMANTICS_009: string = "SM0009";   // a type has no such member
  ADAM_ERR_SEMANTICS_013: string = "SM0013";   // a name in a type's place that is no type
  ADAM_ERR_SEMANTICS_015: string = "SM0015";   // a bare choice value
  ADAM_ERR_SEMANTICS_018: string = "SM0018";   // a bare member of the method's type
  ADAM_ERR_SEMANTICS_019: string = "SM0019";   // a hidden member reached from outside its type's methods
  ADAM_ERR_SEMANTICS_021: string = "SM0021";   // a name declared nowhere
  ADAM_ERR_SEMANTICS_022: string = "SM0022";   // a string literal's picked encoding has a fault (Adam's own)
  ADAM_ERR_SEMANTICS_023: string = "SM0023";   // a char literal's picked encoding has a fault (Adam's own)
  ADAM_ERR_SEMANTICS_200: string = "SM0200";   // a value that does not convert implicitly, or does not fit
  ADAM_ERR_SEMANTICS_202: string = "SM0202";   // a constant place (a match label) holds no constant
  ADAM_ERR_SEMANTICS_250: string = "SM0250";   // an operator that does not take its operand type(s)
  ADAM_ERR_SEMANTICS_252: string = "SM0252";   // a record / overlay / object compared with no declared operator
  ADAM_ERR_SEMANTICS_253: string = "SM0253";   // ^ or [i] on the untyped ptr
  ADAM_ERR_SEMANTICS_254: string = "SM0254";   // the address of a value that is not stored
  ADAM_ERR_SEMANTICS_255: string = "SM0255";   // a target that cannot be assigned
  ADAM_ERR_SEMANTICS_260: string = "SM0260";   // a value that cannot be indexed
  ADAM_ERR_SEMANTICS_261: string = "SM0261";   // an index of the wrong family
  ADAM_ERR_SEMANTICS_262: string = "SM0262";   // the address of a bitfield (addr of, a var argument)
  ADAM_ERR_SEMANTICS_263: string = "SM0263";   // a condition that is no bool
  ADAM_ERR_SEMANTICS_264: string = "SM0264";   // a value no cast to that type takes (Adam's own)
  ADAM_ERR_SEMANTICS_265: string = "SM0265";   // a value a pointer cast does not take
  ADAM_ERR_SEMANTICS_267: string = "SM0267";   // a match label range whose low bound is above its high
  ADAM_ERR_SEMANTICS_268: string = "SM0268";   // in: the value is not of the set's element type
  ADAM_ERR_SEMANTICS_269: string = "SM0269";   // a type or a module used as a value
  ADAM_ERR_SEMANTICS_271: string = "SM0271";   // is / as on what is no polymorphic object, or ptr / own / ref of one
  ADAM_ERR_SEMANTICS_272: string = "SM0272";   // is / as names a type that is no object or interface
  ADAM_ERR_SEMANTICS_273: string = "SM0273";   // is / as never holds: no object is both types
  ADAM_ERR_SEMANTICS_274: string = "SM0274";   // is / as never holds: the operand holds exactly its type
  ADAM_ERR_SEMANTICS_275: string = "SM0275";   // is / as on a weak: test lock(W)
  ADAM_ERR_SEMANTICS_276: string = "SM0276";   // a constant index outside a static array's folded bounds
  ADAM_ERR_SEMANTICS_303: string = "SM0303";   // a forward type with no full declaration in its scope
  ADAM_ERR_SEMANTICS_304: string = "SM0304";   // a forward type after its full declaration
  ADAM_ERR_SEMANTICS_305: string = "SM0305";   // a forward type completed by no record, object, interface or overlay
  ADAM_ERR_SEMANTICS_306: string = "SM0306";   // a forward and its full declaration differ
  ADAM_ERR_SEMANTICS_307: string = "SM0307";   // a forward routine no full declaration pairs with
  ADAM_ERR_SEMANTICS_324: string = "SM0324";   // a routine of one name declared again with the same parameter types
  ADAM_ERR_SEMANTICS_325: string = "SM0325";   // a clink variadic routine with a body and no fixed parameter
  ADAM_ERR_SEMANTICS_326: string = "SM0326";   // an external clause's name is no const string literal
  ADAM_ERR_SEMANTICS_327: string = "SM0327";   // an external clause's const string is no library name
  ADAM_ERR_SEMANTICS_332: string = "SM0332";   // a parent's virtual method / property named again without override
  ADAM_ERR_SEMANTICS_333: string = "SM0333";   // override of no virtual method / property above
  ADAM_ERR_SEMANTICS_334: string = "SM0334";   // an override's signature differs from the overridden one
  ADAM_ERR_SEMANTICS_335: string = "SM0335";   // override of a final method / property
  ADAM_ERR_SEMANTICS_336: string = "SM0336";   // final on what is not virtual or override
  ADAM_ERR_SEMANTICS_337: string = "SM0337";   // abstract on what is not virtual or override
  ADAM_ERR_SEMANTICS_338: string = "SM0338";   // an abstract object or an interface held by value or created
  ADAM_ERR_SEMANTICS_339: string = "SM0339";   // a final object named as a parent
  ADAM_ERR_SEMANTICS_340: string = "SM0340";   // parent.M() of an abstract method
  ADAM_ERR_SEMANTICS_349: string = "SM0349";   // an object with no init without arguments built without them
  ADAM_ERR_SEMANTICS_350: string = "SM0350";   // init arguments on a type that is no object
  ADAM_ERR_SEMANTICS_351: string = "SM0351";   // no init of the object takes the arguments
  ADAM_ERR_SEMANTICS_352: string = "SM0352";   // the arguments fit more than one init
  ADAM_ERR_SEMANTICS_358: string = "SM0358";   // own / ref / weak of a type that is no object
  ADAM_ERR_SEMANTICS_359: string = "SM0359";   // weak T(...): a weak builds nothing
  ADAM_ERR_SEMANTICS_360: string = "SM0360";   // W.X on a weak: read it through lock(W)
  ADAM_ERR_SEMANTICS_361: string = "SM0361";   // create / destroy on an object: own / ref hold it
  ADAM_ERR_SEMANTICS_362: string = "SM0362";   // a name after implements that is no interface
  ADAM_ERR_SEMANTICS_363: string = "SM0363";   // an interface named twice after implements
  ADAM_ERR_SEMANTICS_364: string = "SM0364";   // an interface member the object does not implement
  ADAM_ERR_SEMANTICS_365: string = "SM0365";   // an implementing method / property that is not virtual
  ADAM_ERR_SEMANTICS_366: string = "SM0366";   // an implementing method / property of another signature
  ADAM_ERR_SEMANTICS_367: string = "SM0367";   // an implementing method / property that is hidden
  ADAM_ERR_SEMANTICS_368: string = "SM0368";   // an interface repeats a method of its parent interface
  ADAM_ERR_SEMANTICS_369: string = "SM0369";   // an embed's type is no record, overlay or object
  ADAM_ERR_SEMANTICS_370: string = "SM0370";   // a name two embeds share, at the use
  ADAM_ERR_SEMANTICS_371: string = "SM0371";   // a property accessor binds a name that is no field of its object
  ADAM_ERR_SEMANTICS_372: string = "SM0372";   // a property's bound field has another type than the property
  ADAM_ERR_SEMANTICS_373: string = "SM0373";   // a property's read changes self (an assignment, ++, a method call through self)
  ADAM_ERR_SEMANTICS_374: string = "SM0374";   // a property read in its own read, or assigned in its own write, through self
  ADAM_ERR_SEMANTICS_375: string = "SM0375";   // a property without write is assigned
  ADAM_ERR_SEMANTICS_376: string = "SM0376";   // a property used as storage: addr of it (a var argument is SM0405)
  ADAM_ERR_SEMANTICS_377: string = "SM0377";   // an assignment to a property used as a value (it is a statement)
  ADAM_ERR_SEMANTICS_378: string = "SM0378";   // an indexed property used without its index
  ADAM_ERR_SEMANTICS_379: string = "SM0379";   // default on a property with no index, or a second default in a type
  ADAM_ERR_SEMANTICS_387: string = "SM0387";   // a const method changes self
  ADAM_ERR_SEMANTICS_388: string = "SM0388";   // a const method calls a method that is not const through self
  ADAM_ERR_SEMANTICS_389: string = "SM0389";   // an override / implementer does not keep the const of what it continues
  ADAM_ERR_SEMANTICS_400: string = "SM0400";   // a call of a value that is no routine
  ADAM_ERR_SEMANTICS_401: string = "SM0401";   // a call with the wrong number of arguments
  ADAM_ERR_SEMANTICS_402: string = "SM0402";   // no overload takes the arguments
  ADAM_ERR_SEMANTICS_403: string = "SM0403";   // the arguments fit more than one overload, none best (Adam's own)
  ADAM_ERR_SEMANTICS_405: string = "SM0405";   // a var parameter given no variable of its type
  ADAM_ERR_SEMANTICS_406: string = "SM0406";   // a procedure call used as a value
  ADAM_ERR_SEMANTICS_408: string = "SM0408";   // a statement intrinsic used as a value
  ADAM_ERR_SEMANTICS_409: string = "SM0409";   // an intrinsic given arguments it does not take
  ADAM_ERR_SEMANTICS_412: string = "SM0412";   // a cast T(...) with other than one argument
  ADAM_ERR_SEMANTICS_413: string = "SM0413";   // a record literal of a type that is no record
  ADAM_ERR_SEMANTICS_414: string = "SM0414";   // a record literal naming no field of its type
  ADAM_ERR_SEMANTICS_415: string = "SM0415";   // a record literal giving a field twice
  ADAM_ERR_SEMANTICS_417: string = "SM0417";   // varargs outside a variadic routine
  ADAM_ERR_SEMANTICS_418: string = "SM0418";   // a varargs member other than next in a clink variadic
  ADAM_ERR_SEMANTICS_422: string = "SM0422";   // varargs is only the type of a variadic routine's local, set from copy()
  ADAM_ERR_SEMANTICS_425: string = "SM0425";   // a print argument with no print form (a record, object, overlay, owner; an overload set, a method)
  ADAM_ERR_SEMANTICS_427: string = "SM0427";   // a value given by value that cannot be copied (an own place)
  ADAM_ERR_SEMANTICS_428: string = "SM0428";   // a polymorphic object by value to its parent: it would be cut down
  ADAM_ERR_SEMANTICS_433: string = "SM0433";   // ProjectPassword() outside a project build
  ADAM_ERR_SEMANTICS_500: string = "SM0500";   // a print format that is no string (an integer, a wstring, a C string)
  ADAM_ERR_SEMANTICS_502: string = "SM0502";   // a print format that does not fit its arguments (std::format would refuse it)
  ADAM_ERR_SEMANTICS_600: string = "SM0600";   // a for iterator that names no variable
  ADAM_ERR_SEMANTICS_601: string = "SM0601";   // a for iterator not integer, char, wchar or choices
  ADAM_ERR_SEMANTICS_602: string = "SM0602";   // a for iterator written inside its loop
  ADAM_ERR_SEMANTICS_603: string = "SM0603";   // a match subject not integer, char, wchar, choices or string
  ADAM_ERR_SEMANTICS_604: string = "SM0604";   // a match label outside an integer subject's range
  ADAM_ERR_SEMANTICS_605: string = "SM0605";   // a match label sharing a value with an earlier one
  ADAM_ERR_SEMANTICS_606: string = "SM0606";   // warning: a choices match without else misses values
  ADAM_ERR_SEMANTICS_607: string = "SM0607";   // leave outside a loop or match
  ADAM_ERR_SEMANTICS_608: string = "SM0608";   // skip outside a loop
  ADAM_ERR_SEMANTICS_609: string = "SM0609";   // leave / skip / return out of a finally
  ADAM_ERR_SEMANTICS_610: string = "SM0610";   // return without the value its routine returns
  ADAM_ERR_SEMANTICS_611: string = "SM0611";   // return with a value where the routine returns none
  ADAM_ERR_SEMANTICS_612: string = "SM0612";   // a routine with a result can reach its end without return
  ADAM_ERR_SEMANTICS_613: string = "SM0613";   // a range label in a string match
  ADAM_ERR_SEMANTICS_620: string = "SM0620";   // a lock / trylock subject that is no mutex place
  ADAM_ERR_SEMANTICS_621: string = "SM0621";   // a value holding a mutex copied or assigned
  ADAM_ERR_SEMANTICS_622: string = "SM0622";   // (warning) a statement after one that ends the path
  ADAM_ERR_SEMANTICS_623: string = "SM0623";   // a noreturn routine's body can reach its end
  ADAM_ERR_SEMANTICS_624: string = "SM0624";   // a return in a noreturn routine
  ADAM_ERR_SEMANTICS_700: string = "SM0700";   // a threadstatic variable external, given init arguments or of an object / interface value
  ADAM_ERR_SEMANTICS_701: string = "SM0701";   // async of something that is no call of a routine
  ADAM_ERR_SEMANTICS_702: string = "SM0702";   // async of a call passing a var parameter
  ADAM_ERR_SEMANTICS_703: string = "SM0703";   // await of something that is no task
  ADAM_ERR_SEMANTICS_704: string = "SM0704";   // await of a plain task used as a value
  ADAM_ERR_SEMANTICS_705: string = "SM0705";   // an array literal whose count is not its static array's
  ADAM_ERR_SEMANTICS_706: string = "SM0706";   // an array literal's element written as a range a..b
  ADAM_ERR_SEMANTICS_707: string = "SM0707";   // a set literal written with a comma before its ']'

// AText split at each '.' into AParts (System.SysUtils' SplitString)
routine DoSplitDots(const AText: string; var AParts: StringArray);
begin
  AParts := SplitString(AText, ".");
end;

// True for the kinds a type's place takes
routine DoIsTypeDecl(const AKind: NodeKind): bool;
begin
  return (AKind = NodeKind.TypeDecl) or (AKind = NodeKind.ForwardType) or
    (AKind = NodeKind.BuiltinTypeDecl) or (AKind = NodeKind.GenericParam);
end;

// True when the two declarations of one scope may share a name: overloads (routines and
// their forwards) and a forward type with its type
routine DoMayShare(const AFirst: NodeKind; const ASecond: NodeKind): bool;
var
  LFirstRoutine: bool;
  LSecondRoutine: bool;
begin
  LFirstRoutine := (AFirst = NodeKind.RoutineDecl) or (AFirst = NodeKind.ForwardRoutine);
  LSecondRoutine := (ASecond = NodeKind.RoutineDecl) or (ASecond = NodeKind.ForwardRoutine);
  if LFirstRoutine and LSecondRoutine then
    return true;
  end;
  return ((AFirst = NodeKind.ForwardType) and (ASecond = NodeKind.TypeDecl)) or
    ((AFirst = NodeKind.TypeDecl) and (ASecond = NodeKind.ForwardType));
end;

public type
  // One resolution pass over a tree (see the header)
  NameResolver = object
    hidden FTree: ref SyntaxTree;
    hidden FDiagnostics: ref Diagnostics;

    init(const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics);
    begin
      self.FTree := ATree;
      self.FDiagnostics := ADiagnostics;
    end;

    // Error ACode at AId's place
    hidden method DoError(const AId: int64; const ACode: string; const ATemplate: string;
      const AArgs: MessageArgs);
    begin
      self.FDiagnostics.Add(Severity.Error, ACode, self.FTree[AId].Place, ATemplate, AArgs);
    end;

    // The name of the module that holds AId ("" outside every module)
    hidden const method DoModuleName(const AId: int64): string;
    var
      LModule: int64;
    begin
      LModule := ModuleOf(self.FTree, AId);
      if LModule = 0 then
        return "";
      end;
      return self.FTree[LModule].Text;
    end;

    // The declaration of AName the scopes enclosing AUse hold before it, innermost first;
    // 0 when none does. One met in its own var / const declaration is SM0001 and -1 (the
    // fault reported: no later lookup step may report it again)
    hidden method DoOwnScopes(const AUse: int64; const AName: string): int64;
    var
      LAt: int64;
      LFound: int64;
      LKind: NodeKind;
    begin
      LAt := self.FTree.ParentOf(AUse);
      while LAt <> 0 do
        LFound := FindDeclared(self.FTree, LAt, AName, self.FTree[AUse].StartOffset);
        if LFound <> 0 then
          LKind := self.FTree[LFound].Kind;
          if ((LKind = NodeKind.VarDecl) or (LKind = NodeKind.ConstDecl)) and
            self.FTree.IsAncestor(LFound, AUse) then
            self.DoError(AUse, ADAM_ERR_SEMANTICS_001, ADAM_MSG_SEMANTICS_OWN_DECL,
              NoArgs().Str(AName));
            return -1;
          end;
          return LFound;
        end;
        if self.FTree[LAt].Kind = NodeKind.Module then
          return 0;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // A declaration of AName in a scope enclosing AUse that starts after it: SM0002, the
    // name still resolved to it; 0 when none
    hidden method DoLaterScopes(const AUse: int64; const AName: string): int64;
    var
      LAt: int64;
      LFound: int64;
    begin
      LAt := self.FTree.ParentOf(AUse);
      while LAt <> 0 do
        LFound := FindLater(self.FTree, LAt, AName, self.FTree[AUse].StartOffset);
        if LFound <> 0 then
          self.DoError(AUse, ADAM_ERR_SEMANTICS_002, ADAM_MSG_SEMANTICS_USED_BEFORE,
            NoArgs().Str(AName));
          return LFound;
        end;
        if self.FTree[LAt].Kind = NodeKind.Module then
          return 0;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // The public declaration of AName in the units AModule imports, the last unit of
    // the clause that exports it winning; 0 when none does (imports are not transitive)
    hidden const method DoImports(const AModule: int64; const AName: string): int64;
    var
      LI: int64;
      LImport: int64;
      LUnit: int64;
      LHidden: int64;
      LFound: int64;
    begin
      for LI := self.FTree.CountOf(AModule, NodeRole.Import) - 1 downto 0 do
        LImport := self.FTree.NthOf(AModule, NodeRole.Import, LI);
        LUnit := self.FTree[LImport].ResolvedUnit;
        if LUnit <> 0 then
          LHidden := 0;
          LFound := FindPublic(self.FTree, LUnit, AName, LHidden);
          if LFound <> 0 then
            return LFound;
          end;
        end;
      end;
      return 0;
    end;

    // The choices type of AModule's own (or, APublicOnly, public) type declarations
    // that has a value AName: that TypeDecl, 0 when none
    hidden const method DoChoiceIn(const AModule: int64; const AName: string;
      const APublicOnly: bool): int64;
    var
      LI: int64;
      LDecl: int64;
      LType: int64;
      LJ: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(AModule, NodeRole.Declaration, LI);
        if (self.FTree[LDecl].Kind = NodeKind.TypeDecl) and
          ((not APublicOnly) or self.FTree[LDecl].HasFlag(NodeFlag.Public)) then
          LType := self.FTree.FirstOf(LDecl, NodeRole.TypeOf);
          if (LType <> 0) and (self.FTree[LType].Kind = NodeKind.ChoicesType) then
            for LJ := 0 to self.FTree.CountOf(LType, NodeRole.Member) - 1 do
              if self.FTree[self.FTree.NthOf(LType, NodeRole.Member, LJ)].Text = AName then
                return LDecl;
              end;
            end;
          end;
        end;
      end;
      return 0;
    end;

    // The last tries for a bare AName no scope holds: a choice value (SM0015), a member
    // of the enclosing method's type (SM0018), else SM0021. Always reports
    hidden method DoNotFound(const AUse: int64; const AName: string);
    var
      LModule: int64;
      LChoice: int64;
      LI: int64;
      LUnit: int64;
      LOwner: int64;
      LOwnerName: string;
    begin
      LModule := ModuleOf(self.FTree, AUse);
      LChoice := self.DoChoiceIn(LModule, AName, false);
      LI := self.FTree.CountOf(LModule, NodeRole.Import) - 1;
      while (LChoice = 0) and (LI >= 0) do
        LUnit := self.FTree[self.FTree.NthOf(LModule, NodeRole.Import, LI)].ResolvedUnit;
        if LUnit <> 0 then
          LChoice := self.DoChoiceIn(LUnit, AName, true);
        end;
        LI := LI - 1;
      end;
      if LChoice <> 0 then
        self.DoError(AUse, ADAM_ERR_SEMANTICS_015, ADAM_MSG_SEMANTICS_BARE_CHOICE,
          NoArgs().Str(AName).Str(self.FTree[LChoice].Text).Str(AName));
        return;
      end;
      LOwner := MethodOwnerOf(self.FTree, AUse);
      if (LOwner <> 0) and (FindMember(self.FTree, LOwner, AName) <> 0) then
        LOwnerName := self.FTree[self.FTree.ParentOf(LOwner)].Text;
        self.DoError(AUse, ADAM_ERR_SEMANTICS_018, ADAM_MSG_SEMANTICS_BARE_MEMBER,
          NoArgs().Str(AName).Str(LOwnerName).Str(AName));
        return;
      end;
      self.DoError(AUse, ADAM_ERR_SEMANTICS_021, ADAM_MSG_SEMANTICS_UNDECLARED,
        NoArgs().Str(AName));
    end;

    // The declaration a bare AName at AUse means, in BNF sec 1's order, without the last
    // tries (DoNotFound); 0 when nothing holds it
    hidden method DoLookupBare(const AUse: int64; const AName: string): int64;
    var
      LFound: int64;
    begin
      LFound := self.DoOwnScopes(AUse, AName);
      if LFound <> 0 then
        return LFound;
      end;
      LFound := FindSystem(self.FTree, AName);
      if LFound <> 0 then
        return LFound;
      end;
      LFound := self.DoLaterScopes(AUse, AName);
      if LFound <> 0 then
        return LFound;
      end;
      LFound := self.DoImports(ModuleOf(self.FTree, AUse), AName);
      if LFound <> 0 then
        return LFound;
      end;
      return self.DoRuntimePublic(AName);
    end;

    // The runtime's public declaration of a bare AName (BNF sec 1, user 2026-11-10: in scope in
    // every module with no import, as Delphi's System unit, after the module's imports); 0 when
    // the program has no runtime unit or it holds no public AName (a private one stays unseen)
    hidden const method DoRuntimePublic(const AName: string): int64;
    var
      LHidden: int64;
    begin
      if self.FTree.Runtime = 0 then
        return 0;
      end;
      LHidden := 0;
      return FindPublic(self.FTree, self.FTree.Runtime, AName, LHidden);
    end;

    // The unit the dotted name AParts[0..ALast] names in AModule's import clause; 0 when
    // no import of the clause is that name (or its unit could not be loaded)
    hidden const method DoUnitNamed(const AModule: int64; const AName: string): int64;
    var
      LI: int64;
      LImport: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Import) - 1 do
        LImport := self.FTree.NthOf(AModule, NodeRole.Import, LI);
        if self.FTree[LImport].Text = AName then
          return self.FTree[LImport].ResolvedUnit;
        end;
      end;
      return 0;
    end;

    // AParts[0..ALast] in AModule: the longest prefix AParts[0..k] (k < ALast) naming an
    // imported unit, its k in AAt; the unit, or 0 when no prefix names one
    hidden const method DoLongestUnit(const AModule: int64; const AParts: StringArray;
      const ALast: int64; var AAt: int64): int64;
    var
      LK: int64;
      LUnit: int64;
    begin
      AAt := -1;
      for LK := ALast - 1 downto 0 do
        LUnit := self.DoUnitNamed(AModule, JoinStrings(AParts, ".", 0, LK + 1));
        if LUnit <> 0 then
          AAt := LK;
          return LUnit;
        end;
      end;
      return 0;
    end;

    // AName as a member of the unit AUnit, at AUse: the public declaration (into
    // ResolvedDecl); SM0006 when it is held private, SM0005 when not held
    hidden method DoUnitMember(const AUse: int64; const AUnit: int64; const AName: string): int64;
    var
      LFound: int64;
      LHidden: int64;
    begin
      LHidden := 0;
      LFound := FindPublic(self.FTree, AUnit, AName, LHidden);
      if LFound <> 0 then
        self.FTree[AUse].ResolvedDecl := LFound;
        return LFound;
      end;
      if LHidden <> 0 then
        self.DoError(AUse, ADAM_ERR_SEMANTICS_006, ADAM_MSG_SEMANTICS_NOT_PUBLIC,
          NoArgs().Str(AName).Str(self.FTree[AUnit].Text));
      else
        self.DoError(AUse, ADAM_ERR_SEMANTICS_005, ADAM_MSG_SEMANTICS_UNIT_NO_NAME,
          NoArgs().Str(self.FTree[AUnit].Text).Str(AName));
      end;
      return 0;
    end;

    // A bare name AUse (a NameExpression)
    hidden method DoName(const AUse: int64);
    var
      LFound: int64;
    begin
      LFound := self.DoLookupBare(AUse, self.FTree[AUse].Text);
      if LFound < 0 then
        return;
      end;
      if LFound = 0 then
        self.DoNotFound(AUse, self.FTree[AUse].Text);
        return;
      end;
      self.FTree[AUse].ResolvedDecl := LFound;
    end;

    // The dotted chain AOuter = (...((Name . m1) . m2) ... . mn): ANodes[i] the node of
    // AParts[i] (ANodes[0] the NameExpression). See the header for the rule
    hidden method DoDotted(const AParts: StringArray; const ANodes: NodeList);
    var
      LLast: int64;
      LFound: int64;
      LModule: int64;
      LUnit: int64;
      LAt: int64;
      LHead: int64;
    begin
      LLast := len(AParts) - 1;
      LHead := ANodes.Items[0];
      LFound := self.DoOwnScopes(LHead, AParts[0]);
      if LFound < 0 then
        return;
      end;
      if LFound = 0 then
        LFound := FindSystem(self.FTree, AParts[0]);
      end;
      if LFound <> 0 then
        self.FTree[LHead].ResolvedDecl := LFound;
        return;
      end;
      LModule := ModuleOf(self.FTree, LHead);
      LUnit := self.DoLongestUnit(LModule, AParts, LLast, LAt);
      if LUnit <> 0 then
        self.FTree[ANodes.Items[LAt]].ResolvedUnit := LUnit;
        self.DoUnitMember(ANodes.Items[LAt + 1], LUnit, AParts[LAt + 1]);
        return;
      end;

      // No unit prefix: the head is a later own name or an import's bare export (its
      // members are M1.9's), else nothing holds it
      LFound := self.DoLaterScopes(LHead, AParts[0]);
      if LFound = 0 then
        LFound := self.DoImports(LModule, AParts[0]);
      end;
      if LFound <> 0 then
        self.FTree[LHead].ResolvedDecl := LFound;
        return;
      end;
      self.DoNotFound(LHead, AParts[0]);
    end;

    // A MemberExpression AId: when its chain of '.' members bottoms out at a name, the
    // whole chain is resolved here (true); false for any other operand (walked as usual)
    hidden method DoChain(const AId: int64): bool;
    var
      LAt: int64;
      LParts: StringArray;
      LReversed: NodeList;
      LNodes: NodeList;
      LI: int64;
      LCount: int64;
    begin
      LAt := AId;
      while (self.FTree[LAt].Kind = NodeKind.MemberExpression) and
        (not self.FTree[LAt].HasFlag(NodeFlag.Arrow)) do
        LReversed.Add(LAt);
        LAt := self.FTree.FirstOf(LAt, NodeRole.Operand);
        if LAt = 0 then
          return false;
        end;
      end;
      if self.FTree[LAt].Kind <> NodeKind.NameExpression then
        return false;
      end;
      LReversed.Add(LAt);

      // Innermost first: the name, then each member outward
      LCount := LReversed.Count;
      setlength(LParts, LCount);
      for LI := 0 to LCount - 1 do
        LNodes.Add(LReversed.Items[LCount - 1 - LI]);
        LParts[LI] := self.FTree[LNodes.Items[LI]].Text;
      end;
      self.DoDotted(LParts, LNodes);
      return true;
    end;

    // A NamedType AId (its Text the dotted name): a type, from a unit when a prefix names
    // one; anything else in a type's place is SM0013, a prefix that is no unit SM0007
    hidden method DoNamedType(const AId: int64);
    var
      LParts: StringArray;
      LFound: int64;
      LModule: int64;
      LUnit: int64;
      LAt: int64;
      LLast: int64;
    begin
      DoSplitDots(self.FTree[AId].Text, LParts);
      LLast := len(LParts) - 1;
      if LLast = 0 then
        LFound := self.DoLookupBare(AId, LParts[0]);
        if LFound < 0 then
          return;
        end;
        if LFound = 0 then
          self.DoNotFound(AId, LParts[0]);
          return;
        end;
      else
        LModule := ModuleOf(self.FTree, AId);
        LUnit := self.DoUnitNamed(LModule, JoinStrings(LParts, ".", 0, LLast));
        if LUnit = 0 then
          self.DoError(AId, ADAM_ERR_SEMANTICS_007, ADAM_MSG_SEMANTICS_NOT_MODULE,
            NoArgs().Str(JoinStrings(LParts, ".", 0, LLast)));
          return;
        end;
        // LAt receives the declaration the unit holds private (0: none)
        LAt := 0;
        LFound := FindPublic(self.FTree, LUnit, LParts[LLast], LAt);
        if LFound = 0 then
          if LAt <> 0 then
            self.DoError(AId, ADAM_ERR_SEMANTICS_006, ADAM_MSG_SEMANTICS_NOT_PUBLIC,
              NoArgs().Str(LParts[LLast]).Str(self.FTree[LUnit].Text));
          else
            self.DoError(AId, ADAM_ERR_SEMANTICS_005, ADAM_MSG_SEMANTICS_UNIT_NO_NAME,
              NoArgs().Str(self.FTree[LUnit].Text).Str(LParts[LLast]));
          end;
          return;
        end;
      end;
      if not DoIsTypeDecl(self.FTree[LFound].Kind) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_013, ADAM_MSG_SEMANTICS_NOT_TYPE,
          NoArgs().Str(self.FTree[AId].Text));
        return;
      end;
      self.FTree[AId].ResolvedDecl := LFound;
    end;

    // SM0004 for each declaration of AScope whose name an earlier one of AScope holds
    // (overloads and a forward with its declaration excepted)
    hidden method DoDuplicates(const AScope: int64);
    var
      LI: int64;
      LJ: int64;
      LA: int64;
      LB: int64;
    begin
      for LI := 1 to self.FTree.ChildCount(AScope) - 1 do
        LB := self.FTree.ChildAt(AScope, LI);
        if IsScopeDeclaration(self.FTree, LB) then
          for LJ := 0 to LI - 1 do
            LA := self.FTree.ChildAt(AScope, LJ);
            if IsScopeDeclaration(self.FTree, LA) and
              (self.FTree[LA].Text = self.FTree[LB].Text) and
              (not DoMayShare(self.FTree[LA].Kind, self.FTree[LB].Kind)) then
              self.DoError(LB, ADAM_ERR_SEMANTICS_004, ADAM_MSG_SEMANTICS_DUPLICATE,
                NoArgs().Str(self.FTree[LB].Text).Int(int64(self.FTree[LA].Place.Line)));
              leave;
            end;
          end;
        end;
      end;
    end;

    // AId and everything under it: duplicates per scope, every name resolved. A
    // directive's arguments are its values, not names
    hidden method DoWalk(const AId: int64);
    var
      LKind: NodeKind;
      LI: int64;
    begin
      LKind := self.FTree[AId].Kind;
      if LKind = NodeKind.Directive then
        return;
      end;
      if LKind = NodeKind.NameExpression then
        self.DoName(AId);
        return;
      end;
      if LKind = NodeKind.NamedType then
        self.DoNamedType(AId);
        return;
      end;
      if (LKind = NodeKind.MemberExpression) and self.DoChain(AId) then
        return;
      end;
      self.DoDuplicates(AId);
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        self.DoWalk(self.FTree.ChildAt(AId, LI));
      end;
    end;

    // Every module of the program resolved, but a compiled unit's (resolved already)
    method Run();
    var
      LI: int64;
      LModule: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        LModule := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        if not self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
          self.DoWalk(LModule);
        end;
      end;
    end;
  end;

// Every name of the program in ATree resolved into the AST, reporting into ADiagnostics
// (see the header)
public routine ResolveNames(const ATree: ref SyntaxTree; const ADiagnostics: ref Diagnostics);
var
  LResolver: ref NameResolver;
begin
  LResolver := ref NameResolver(ATree, ADiagnostics);
  LResolver.Run();
end;

// True for the kinds of a type expression (BNF sec 4 type expr)
routine DoIsTypeExpression(const AKind: NodeKind): bool;
begin
  return (AKind = NodeKind.NamedType) or (AKind = NodeKind.BuiltinTypeName) or
    (AKind = NodeKind.PointerType) or (AKind = NodeKind.ArrayType) or
    (AKind = NodeKind.RoutineType) or (AKind = NodeKind.OwnType) or
    (AKind = NodeKind.RefType) or (AKind = NodeKind.WeakType) or (AKind = NodeKind.TaskType);
end;

// True for the kinds of an expression (BNF sec 6)
routine DoIsExpression(const AKind: NodeKind): bool;
begin
  match AKind of
    NodeKind.AssignExpression, NodeKind.ConditionalExpression, NodeKind.BinaryExpression,
    NodeKind.UnaryExpression, NodeKind.PostfixExpression, NodeKind.IsExpression,
    NodeKind.AsExpression, NodeKind.CallExpression, NodeKind.IndexExpression,
    NodeKind.MemberExpression, NodeKind.NameExpression, NodeKind.ParenExpression,
    NodeKind.IntLiteral, NodeKind.FloatLiteral, NodeKind.StringLiteral,
    NodeKind.CharLiteral, NodeKind.BoolLiteral, NodeKind.NilLiteral,
    NodeKind.SelfExpression, NodeKind.ParentExpression, NodeKind.OwnNew, NodeKind.RefNew,
    NodeKind.WeakNew, NodeKind.VarargsExpression, NodeKind.TypeCast, NodeKind.PointerCast,
    NodeKind.SetLiteral, NodeKind.ArrayLiteral, NodeKind.RecordLiteral, NodeKind.AsyncExpression,
    NodeKind.AwaitExpression:
      return true;
  else
    // any other kind is no expression
  end;
  return false;
end;

// True for the intrinsics that are statements (BNF sec 7 memory / exception / io stmt and
// the asserts of sec 8): a call of one has no value
routine DoIsStatementIntrinsic(const AName: string): bool;
begin
  if (AName = "create") or (AName = "destroy") or (AName = "freemem") or
    (AName = "setlength") or (AName = "raise") or (AName = "raisecode") or
    (AName = "print") or (AName = "println") or (AName = "atomicstore") then
    return true;
  end;
  return StartsStr("test", AName);
end;

// True for the atomic intrinsics (BNF sec 7, H4t2; atomicstore the statement among them)
routine DoIsAtomicIntrinsic(const AName: string): bool;
begin
  return (AName = "atomicadd") or (AName = "atomicswap") or (AName = "atomiccas") or
    (AName = "atomicload") or (AName = "atomicstore");
end;

// The signature SM0409 names for the atomic intrinsic AName
routine DoAtomicSignature(const AName: string): string;
begin
  if AName = "atomicadd" then
    return ADAM_MSG_SEMANTICS_SIG_ATOMIC_ADD;
  end;
  if AName = "atomiccas" then
    return ADAM_MSG_SEMANTICS_SIG_ATOMIC_CAS;
  end;
  if AName = "atomicload" then
    return ADAM_MSG_SEMANTICS_SIG_ATOMIC_LOAD;
  end;
  return ADAM_MSG_SEMANTICS_SIG_ATOMIC_SWAP;
end;

// The count of arguments the atomic intrinsic AName takes: the place, then its values
routine DoAtomicArity(const AName: string): int64;
begin
  if AName = "atomicload" then
    return 1;
  end;
  if AName = "atomiccas" then
    return 3;
  end;
  return 2;
end;

// True when AText (a suffix) holds the character AChar in either case
routine DoHasLetter(const AText: string; const ALower: char; const AUpper: char): bool;
var
  LI: int64;
begin
  for LI := 0 to len(AText) - 1 do
    if (AText[LI] = ALower) or (AText[LI] = AUpper) then
      return true;
    end;
  end;
  return false;
end;

public type
  // One typing pass over a tree (see CheckTypes): every expression's type into its
  // ResolvedType, every implicit conversion into the converted value's ResolvedConvert,
  // every declaration's type into its ResolvedType, a return's routine into its
  // ResolvedJump, a member's declaration into its ResolvedDecl, a forward's full
  // declaration into the forward's ResolvedDecl
  TypeChecker = object
    hidden FTree: ref SyntaxTree;
    hidden FTarget: ref Target;
    hidden FDiagnostics: ref Diagnostics;
    hidden FDone: array of bool;
    hidden FFolder: ref ConstantFolder;
    // The forward types and routines visited, in visit order: those no full declaration
    // completed are reported once the program is typed (DoUnpairedForwards)
    hidden FForwards: ref NodeList;

    init(const ATree: ref SyntaxTree; const ATarget: ref Target;
      const ADiagnostics: ref Diagnostics);
    begin
      self.FTree := ATree;
      self.FTarget := ATarget;
      self.FDiagnostics := ADiagnostics;
      self.FFolder := ref ConstantFolder(ATree, ATarget, ADiagnostics);
      self.FForwards := ref NodeList();
    end;

    // Error ACode at AId's place
    hidden method DoError(const AId: int64; const ACode: string; const ATemplate: string;
      const AArgs: MessageArgs);
    begin
      self.FDiagnostics.Add(Severity.Error, ACode, self.FTree[AId].Place, ATemplate, AArgs);
    end;

    // True the first time AId is met, which marks it; false every time after (a node is
    // typed once, its errors reported once)
    hidden method DoFirstVisit(const AId: int64): bool;
    var
      LOld: int64;
      LI: int64;
    begin
      if AId >= len(self.FDone) then
        LOld := len(self.FDone);
        setlength(self.FDone, self.FTree.Count + 64);
        for LI := LOld to len(self.FDone) - 1 do
          self.FDone[LI] := false;
        end;
      end;
      if self.FDone[AId] then
        return false;
      end;
      self.FDone[AId] := true;
      return true;
    end;

    // The builtin type named AName
    hidden const method DoBuiltin(const AName: string): int64;
    begin
      return BuiltinType(self.FTree, AName);
    end;

    // AType as a message writes it
    hidden const method DoText(const AType: int64): string;
    begin
      return TypeText(self.FTree, AType);
    end;

    // The class of AType
    hidden const method DoClass(const AType: int64): TypeClass;
    begin
      return ClassOf(self.FTree, AType);
    end;

    // The type of the expression AId (0: unknown)
    hidden const method DoTypeOf(const AId: int64): int64;
    begin
      if AId = 0 then
        return 0;
      end;
      return self.FTree[AId].ResolvedType;
    end;

    // AType written as the type of AId
    hidden method DoSetType(const AId: int64; const AType: int64);
    begin
      self.FTree[AId].ResolvedType := AType;
    end;

    // AId with its parentheses taken off
    hidden const method DoSkipParens(const AId: int64): int64;
    var
      LAt: int64;
    begin
      LAt := AId;
      while (LAt <> 0) and (self.FTree[LAt].Kind = NodeKind.ParenExpression) do
        LAt := self.FTree.FirstOf(LAt, NodeRole.Operand);
      end;
      return LAt;
    end;

    // The expression AId as a message spells it (names, members, literals as written;
    // what lies inside a call's or an index's brackets as ...)
    hidden const method DoSpell(const AId: int64; const ADepth: int64): string;
    var
      LNode: ref Node;
      LKind: NodeKind;
      LText: string;
    begin
      if AId = 0 then
        return "";
      end;
      if ADepth > 8 then
        return "...";
      end;
      LNode := self.FTree[AId];
      LKind := LNode.Kind;
      if (LKind = NodeKind.NameExpression) or (LKind = NodeKind.IntLiteral) or
        (LKind = NodeKind.FloatLiteral) or (LKind = NodeKind.CharLiteral) or
        (LKind = NodeKind.StringLiteral) or (LKind = NodeKind.BoolLiteral) then
        return LNode.Text;
      end;
      if LKind = NodeKind.NilLiteral then
        return "nil";
      end;
      if LKind = NodeKind.SelfExpression then
        return "self";
      end;
      if LKind = NodeKind.ParentExpression then
        return "parent";
      end;
      if LKind = NodeKind.MemberExpression then
        LText := self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1);
        if LNode.HasFlag(NodeFlag.Arrow) then
          return LText + "->" + LNode.Text;
        end;
        return LText + "." + LNode.Text;
      end;
      if LKind = NodeKind.CallExpression then
        LText := self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Callee), ADepth + 1);
        if self.FTree.CountOf(AId, NodeRole.Argument) = 0 then
          return LText + "()";
        end;
        return LText + "(...)";
      end;
      if LKind = NodeKind.IndexExpression then
        return self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1) + "[...]";
      end;
      if LKind = NodeKind.ParenExpression then
        return "(" + self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1) + ")";
      end;
      if LKind = NodeKind.UnaryExpression then
        LText := LNode.Text;
        if (LText = "not") or (LText = "addr of") then
          LText := LText + " ";
        end;
        return LText + self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1);
      end;
      if LKind = NodeKind.PostfixExpression then
        return self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Operand), ADepth + 1) + LNode.Text;
      end;
      if LKind = NodeKind.BinaryExpression then
        return self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Left), ADepth + 1) + " " +
          LNode.Text + " " + self.DoSpell(self.FTree.FirstOf(AId, NodeRole.Right), ADepth + 1);
      end;
      if (LKind = NodeKind.TypeCast) or (LKind = NodeKind.PointerCast) then
        return self.DoText(CanonicalOf(self.FTree, self.FTree.FirstOf(AId, NodeRole.TypeOf))) +
          "(...)";
      end;
      return "expression";
    end;

    // The expression AId as a message spells it
    hidden const method DoExprText(const AId: int64): string;
    begin
      return self.DoSpell(AId, 0);
    end;

    // The type the declaration ADecl declares or holds: a variable's, constant's,
    // parameter's, field's, property's or embed's type (written into its ResolvedType),
    // a type declaration's type, a routine's or method's routine type, a choice value's
    // choices type; 0 for any other
    hidden method DoDeclType(const ADecl: int64): int64;
    var
      LKind: NodeKind;
      LType: int64;
    begin
      if ADecl = 0 then
        return 0;
      end;
      LKind := self.FTree[ADecl].Kind;
      if (LKind = NodeKind.VarDecl) or (LKind = NodeKind.ConstDecl) or
        (LKind = NodeKind.Param) or (LKind = NodeKind.FieldDecl) or
        (LKind = NodeKind.PropertyDecl) or (LKind = NodeKind.EmbedDecl) then
        if self.FTree[ADecl].ResolvedType <> 0 then
          return self.FTree[ADecl].ResolvedType;
        end;
        // A write accessor's value parameter `write (AValue)` is written without a type:
        // it holds the property's (BNF sec 4)
        if (LKind = NodeKind.Param) and (self.FTree.FirstOf(ADecl, NodeRole.TypeOf) = 0) and
          (self.FTree[self.FTree.ParentOf(ADecl)].Kind = NodeKind.PropertyWrite) then
          LType := self.DoDeclType(self.FTree.ParentOf(self.FTree.ParentOf(ADecl)));
          self.FTree[ADecl].ResolvedType := LType;
          return LType;
        end;
        LType := CanonicalOf(self.FTree, self.FTree.FirstOf(ADecl, NodeRole.TypeOf));
        self.FTree[ADecl].ResolvedType := LType;
        return LType;
      end;
      if DoIsTypeDecl(LKind) then
        return DeclaredTypeOf(self.FTree, ADecl);
      end;
      if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
        (LKind = NodeKind.MethodDecl) then
        return RoutineTypeOf(self.FTree, ADecl);
      end;
      if LKind = NodeKind.ChoiceValue then
        return self.FTree.ParentOf(self.FTree.ParentOf(ADecl));
      end;
      return 0;
    end;

    // The declared type a Name / Member expression AExpr names (0 when it names none)
    hidden method DoTypeNamed(const AExpr: int64): int64;
    var
      LKind: NodeKind;
      LDecl: int64;
    begin
      if AExpr = 0 then
        return 0;
      end;
      LKind := self.FTree[AExpr].Kind;
      if (LKind <> NodeKind.NameExpression) and (LKind <> NodeKind.MemberExpression) then
        return 0;
      end;
      LDecl := self.FTree[AExpr].ResolvedDecl;
      if (LDecl = 0) or (not DoIsTypeDecl(self.FTree[LDecl].Kind)) then
        return 0;
      end;
      return DeclaredTypeOf(self.FTree, LDecl);
    end;

    // The declaration the callee AExpr names (a Name or Member's ResolvedDecl); 0 for any
    // other callee
    hidden const method DoCalleeDecl(const AExpr: int64): int64;
    var
      LAt: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return 0;
      end;
      if (self.FTree[LAt].Kind = NodeKind.NameExpression) or
        (self.FTree[LAt].Kind = NodeKind.MemberExpression) then
        return self.FTree[LAt].ResolvedDecl;
      end;
      return 0;
    end;

    // True when the routine or method ADecl shares its name with another of its scope
    // (an overload set: M1.10 picks the member a call runs)
    hidden const method DoIsOverloaded(const ADecl: int64): bool;
    var
      LScope: int64;
      LI: int64;
      LChild: int64;
      LCount: int64;
    begin
      LScope := self.FTree.ParentOf(ADecl);
      if LScope = 0 then
        return false;
      end;
      LCount := 0;
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if ((self.FTree[LChild].Kind = NodeKind.RoutineDecl) or
          (self.FTree[LChild].Kind = NodeKind.MethodDecl)) and
          (self.FTree[LChild].Text = self.FTree[ADecl].Text) then
          LCount := LCount + 1;
        end;
      end;
      return LCount > 1;
    end;

    // True when the expression AExpr is a call that has no value: a procedure, a
    // statement intrinsic, a routine value with no return type; or an await of a plain task
    hidden const method DoIsNoValue(const AExpr: int64): bool;
    var
      LAt: int64;
      LCallee: int64;
      LDecl: int64;
      LKind: NodeKind;
      LType: int64;
    begin
      if self.DoIsPlainAwait(AExpr) then
        return true;
      end;
      LAt := self.DoSkipParens(AExpr);
      if (LAt = 0) or (self.FTree[LAt].Kind <> NodeKind.CallExpression) then
        return false;
      end;
      LCallee := self.FTree.FirstOf(LAt, NodeRole.Callee);
      LDecl := self.DoCalleeDecl(LCallee);
      if LDecl <> 0 then
        LKind := self.FTree[LDecl].Kind;
        if LKind = NodeKind.IntrinsicDecl then
          return DoIsStatementIntrinsic(self.FTree[LDecl].Text);
        end;
        if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
          (LKind = NodeKind.MethodDecl) then
          if self.DoIsOverloaded(LDecl) then
            return false;
          end;
          return self.FTree.FirstOf(LDecl, NodeRole.ReturnType) = 0;
        end;
      end;
      LType := self.DoTypeOf(LCallee);
      return (ClassOf(self.FTree, LType) = TypeClass.RoutineType) and
        (TargetOf(self.FTree, LType) = 0);
    end;

    // The value-less call AExpr used as a value: SM0704 for an await of a plain task,
    // SM0408 for a statement intrinsic, else SM0406
    hidden method DoNoValue(const AExpr: int64);
    var
      LAt: int64;
      LDecl: int64;
    begin
      if self.DoIsPlainAwait(AExpr) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_704, ADAM_MSG_SEMANTICS_AWAIT_PLAIN, NoArgs());
        return;
      end;
      LAt := self.DoSkipParens(AExpr);
      LDecl := self.DoCalleeDecl(self.FTree.FirstOf(LAt, NodeRole.Callee));
      if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.IntrinsicDecl) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_408, ADAM_MSG_SEMANTICS_INTRINSIC_STMT,
          NoArgs().Str(self.FTree[LDecl].Text));
        return;
      end;
      self.DoError(AExpr, ADAM_ERR_SEMANTICS_406, ADAM_MSG_SEMANTICS_NO_VALUE,
        NoArgs().Str(self.DoExprText(AExpr)));
    end;

    // True when the literal AExpr (AId with its parentheses off: ARoot) takes ATarget as
    // its encoding or form: a string literal a wstring or a ptr to const char / wchar, a
    // char literal a wchar (BNF sec 9: wide literals are type-driven)
    hidden const method DoLiteralTakes(const ARoot: int64; const ATarget: int64): bool;
    var
      LKind: NodeKind;
      LTarget: TypeClass;
      LPointee: TypeClass;
    begin
      if ARoot = 0 then
        return false;
      end;
      LKind := self.FTree[ARoot].Kind;
      LTarget := self.DoClass(ATarget);
      if LKind = NodeKind.StringLiteral then
        if LTarget = TypeClass.WideText then
          return true;
        end;
        if (LTarget = TypeClass.Pointer) and IsConstTarget(self.FTree, ATarget) then
          LPointee := self.DoClass(TargetOf(self.FTree, ATarget));
          return (LPointee = TypeClass.Char) or (LPointee = TypeClass.WideChar);
        end;
        return false;
      end;
      if LKind = NodeKind.CharLiteral then
        return LTarget = TypeClass.WideChar;
      end;
      return false;
    end;

    // True when the constant AExpr (of type AFrom) is a value ATarget holds exactly: an
    // integer constant an integer type it fits, or a float whose mantissa holds its
    // significant bits (24 / 53, after its trailing zero bits: 2^30 is exact in a float32);
    // a float64 constant a float32 that holds it exactly (an infinity is exact, a NaN never)
    hidden const method DoConstTakes(const AExpr: int64; const AFrom: int64;
      const ATarget: int64): bool;
    var
      LNegative: bool;
      LMagnitude: uint64;
      LConst: ConstValue;
    begin
      if (self.DoClass(AFrom) = TypeClass.Float) and (self.DoClass(ATarget) = TypeClass.Float) and
        (FloatBits(self.FTree, ATarget) = 32) then
        LConst := self.FTree[AExpr].ResolvedConst;
        return (LConst.Kind = ConstKind.Float) and FloatFitsSingle(LConst.Float);
      end;
      if not IsIntegerClass(self.DoClass(AFrom)) then
        return false;
      end;
      if not ConstIntOf(self.FTree, AExpr, LNegative, LMagnitude) then
        return false;
      end;
      if IsIntegerClass(self.DoClass(ATarget)) then
        return IntFits(self.FTree, ATarget, LNegative, LMagnitude);
      end;
      if self.DoClass(ATarget) = TypeClass.Float then
        if FloatBits(self.FTree, ATarget) = 32 then
          return FitsMantissa(LMagnitude, 24);
        end;
        return FitsMantissa(LMagnitude, 53);
      end;
      return false;
    end;

    // True when the value AExpr converts to ATarget with no cast (no report): the same or
    // an unknown type, the implicit rule, a literal's type-driven form, a constant that
    // fits
    hidden const method DoWouldConvert(const AExpr: int64; const ATarget: int64): bool;
    var
      LFrom: int64;
    begin
      LFrom := self.DoTypeOf(AExpr);
      if ConvertsImplicitly(self.FTree, LFrom, ATarget) then
        return true;
      end;
      if self.DoLiteralTakes(self.DoSkipParens(AExpr), ATarget) then
        return true;
      end;
      return self.DoConstTakes(AExpr, LFrom, ATarget);
    end;

    // True when a cast to ATo takes a value of AFrom (BNF sec 6 type cast): numbers,
    // chars, bools and choices values among the numbers; a pointer to an integer of
    // pointer width; an integer to a char or a choices type; a pointer cast's values; a
    // routine value to the untyped ptr and back
    hidden const method DoCastTakes(const AFrom: int64; const ATo: int64): bool;
    var
      LFrom: TypeClass;
      LTo: TypeClass;
    begin
      if ConvertsImplicitly(self.FTree, AFrom, ATo) then
        return true;
      end;
      LFrom := self.DoClass(AFrom);
      LTo := self.DoClass(ATo);
      if IsNumericClass(LTo) then
        if IsNumericClass(LFrom) or (LFrom = TypeClass.Char) or (LFrom = TypeClass.WideChar) or
          (LFrom = TypeClass.Boolean) or (LFrom = TypeClass.ChoicesType) then
          return true;
        end;
        return IsPointerClass(LFrom) and IsIntegerClass(LTo) and (IntBits(self.FTree, ATo) = 64);
      end;
      if LTo = TypeClass.Boolean then
        return IsNumericClass(LFrom);
      end;
      if (LTo = TypeClass.Char) or (LTo = TypeClass.WideChar) then
        return IsIntegerClass(LFrom) or (LFrom = TypeClass.Char) or (LFrom = TypeClass.WideChar);
      end;
      if LTo = TypeClass.ChoicesType then
        return IsIntegerClass(LFrom);
      end;
      // A routine value and the untyped ptr cast to each other (user 2026-11-08: a hook's
      // real function, System.HookAbi's HookReal, is called through the hook's routine type)
      if LTo = TypeClass.UntypedPointer then
        return IsPointerClass(LFrom) or (LFrom = TypeClass.RoutineType) or
          (IsIntegerClass(LFrom) and (IntBits(self.FTree, AFrom) = 64));
      end;
      if LTo = TypeClass.RoutineType then
        return LFrom = TypeClass.UntypedPointer;
      end;
      if LTo = TypeClass.Pointer then
        return self.DoPointerCastTakes(AFrom, ATo);
      end;
      return false;
    end;

    // True when a pointer cast to ATo takes a value of AFrom (BNF sec 6 pointer cast): a
    // pointer that keeps const (typed or untyped), an integer of pointer width
    hidden const method DoPointerCastTakes(const AFrom: int64; const ATo: int64): bool;
    var
      LFrom: TypeClass;
    begin
      LFrom := self.DoClass(AFrom);
      if LFrom = TypeClass.Pointer then
        return not (IsConstTarget(self.FTree, AFrom) and (not IsConstTarget(self.FTree, ATo)));
      end;
      if LFrom = TypeClass.UntypedPointer then
        return true;
      end;
      return IsIntegerClass(LFrom) and (IntBits(self.FTree, AFrom) = 64);
    end;

    // SM0200 for the value AExpr of AFrom that does not convert to ATarget; the cast is
    // named as the hint when one takes the value
    hidden method DoNoConvert(const AExpr: int64; const AFrom: int64; const ATarget: int64);
    begin
      if self.DoCastTakes(AFrom, ATarget) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NO_CONVERT_CAST,
          NoArgs().Str(self.DoText(AFrom)).Str(self.DoText(ATarget)).Str(self.DoText(ATarget) + "(...)"));
        return;
      end;
      self.DoError(AExpr, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NO_CONVERT,
        NoArgs().Str(self.DoText(AFrom)).Str(self.DoText(ATarget)));
    end;

    // SM0200 for the integer constant AExpr that does not fit ATarget, with its range
    hidden method DoNotFit(const AExpr: int64; const ATarget: int64);
    var
      LNegative: bool;
      LMagnitude: uint64;
      LLow: string;
    begin
      ConstIntOf(self.FTree, AExpr, LNegative, LMagnitude);
      LLow := "0";
      if self.DoClass(ATarget) = TypeClass.SignedInt then
        LLow := "-" + UIntToStr(IntLimit(self.FTree, ATarget, true));
      end;
      self.DoError(AExpr, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NOT_FIT,
        NoArgs().Str(ConstIntText(LNegative, LMagnitude)).Str(self.DoText(ATarget)).Str(LLow).Str(
        UIntToStr(IntLimit(self.FTree, ATarget, false))));
    end;

    // The bitfield the place AExpr names (through parens): its FieldDecl, 0 when AExpr is
    // no member access or names no field written with a width
    hidden const method DoBitfieldIn(const AExpr: int64): int64;
    var
      LAt: int64;
      LDecl: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if (LAt = 0) or (self.FTree[LAt].Kind <> NodeKind.MemberExpression) then
        return 0;
      end;
      LDecl := self.FTree[LAt].ResolvedDecl;
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.FieldDecl) or
        (self.FTree.FirstOf(LDecl, NodeRole.BitWidth) = 0) then
        return 0;
      end;
      return LDecl;
    end;

    // SM0262 at AExpr when it names a bitfield, which has no address (`addr of` it, or it
    // given to a var parameter: C++'s rule, which Adam states itself); true when reported
    hidden method DoBitfieldAddress(const AExpr: int64): bool;
    var
      LField: int64;
    begin
      LField := self.DoBitfieldIn(AExpr);
      if LField = 0 then
        return false;
      end;
      self.DoError(AExpr, ADAM_ERR_SEMANTICS_262, ADAM_MSG_SEMANTICS_BITFIELD_ADDRESS,
        NoArgs().Str(self.FTree[LField].Text));
      return true;
    end;

    // BNF F37: the constant AValue stored into the bitfield AField (`:=`, a record literal's
    // field; AValue already converts to the field's type) must fit its width, as a signed
    // value for a signed type, else an unsigned one (DoUnsignedValues); SM0200 names the
    // type as 'T : width' with that range. A value that folds to no constant is not
    // checked, nor a bool field (0 and 1 fit any width), a width Layout refuses (SM0315)
    // or a width of 64 (every value of the type fits)
    hidden method DoBitStore(const AField: int64; const AValue: int64);
    var
      LType: int64;
      LWidth: int64;
      LBits: int64;
      LHigh: int64;
      LLow: int64;
      LValueText: string;
      LLowText: string;
    begin
      LType := self.DoDeclType(AField);
      if (LType = 0) or (self.DoClass(LType) = TypeClass.Boolean) then
        return;
      end;
      if not BoundValue(self.FTree, self.FTarget, self.FTree.FirstOf(AField, NodeRole.BitWidth), LWidth) then
        return;
      end;
      if (LWidth < 1) or (LWidth >= 64) then
        return;
      end;
      if not self.DoFoldedBits(AValue, LType, LBits) then
        return;
      end;
      if self.DoUnsignedValues(LType) then
        LHigh := BitMask(LWidth, 0);
        if uint64(LBits) <= uint64(LHigh) then
          return;
        end;
        LValueText := UIntToStr(uint64(LBits));
        LLowText := "0";
      else
        // A signed width of W bits holds -2^(W-1) .. 2^(W-1) - 1
        LHigh := BitMask(LWidth, 0) div 2;
        LLow := -LHigh - 1;
        if (LBits >= LLow) and (LBits <= LHigh) then
          return;
        end;
        LValueText := IntToStr(LBits);
        LLowText := IntToStr(LLow);
      end;
      self.DoError(AValue, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NOT_FIT,
        NoArgs().Str(LValueText).Str(self.DoText(LType) + " : " + IntToStr(LWidth)).Str(
        LLowText).Str(IntToStr(LHigh)));
    end;

    // The element type of the set type ASet: `set of T`'s T, a range set's bounds' type
    // (Types.SetMemberOf, the bound visited first when it is not typed yet)
    hidden method DoSetElement(const ASet: int64): int64;
    var
      LBody: int64;
    begin
      LBody := BodyOf(self.FTree, ASet);
      if (SetElementOf(self.FTree, ASet) = 0) and (LBody <> 0) and
        (self.FTree.FirstOf(LBody, NodeRole.LowBound) <> 0) then
        self.DoVisit(self.FTree.FirstOf(LBody, NodeRole.LowBound));
      end;
      return SetMemberOf(self.FTree, ASet);
    end;

    // The bracket literal ARoot (AExpr with its parentheses off) where a value of the array
    // type ATarget goes (BNF sec 6 array literal): an array literal, so the node becomes an
    // ArrayLiteral (Folding and Lowering read the kind); each element converts to the
    // element type as in an assignment, one written as a range is SM0706; a static array
    // takes exactly its range's count (SM0705 names both counts), a dynamic one any count.
    // ARoot and AExpr take ATarget
    hidden method DoConvertArray(const AExpr: int64; const ARoot: int64; const ATarget: int64): bool;
    var
      LElement: int64;
      LCount: int64;
      LWant: int64;
      LI: int64;
      LItem: int64;
      LOk: bool;
    begin
      self.FTree[ARoot].Kind := NodeKind.ArrayLiteral;
      LElement := TargetOf(self.FTree, ATarget);
      LCount := self.FTree.CountOf(ARoot, NodeRole.Element);
      LOk := true;
      for LI := 0 to LCount - 1 do
        LItem := self.FTree.NthOf(ARoot, NodeRole.Element, LI);
        if self.FTree.FirstOf(LItem, NodeRole.HighBound) <> 0 then
          self.DoError(LItem, ADAM_ERR_SEMANTICS_706, ADAM_MSG_SEMANTICS_ARRAY_RANGE, NoArgs());
          LOk := false;
        else
          if not self.DoConvert(self.FTree.FirstOf(LItem, NodeRole.LowBound), LElement) then
            LOk := false;
          end;
        end;
      end;
      if self.DoClass(ATarget) = TypeClass.StaticArray then
        LWant := ArrayCount(self.FTree, self.FTarget, ATarget);
        if (LWant >= 0) and (LWant <> LCount) then
          self.DoError(AExpr, ADAM_ERR_SEMANTICS_705, ADAM_MSG_SEMANTICS_ARRAY_COUNT,
            NoArgs().Int(LCount).Str(self.DoText(ATarget)).Int(LWant));
          LOk := false;
        end;
      end;
      self.DoSetType(ARoot, ATarget);
      self.DoSetType(AExpr, ATarget);
      return LOk;
    end;

    // A set literal ARoot written with a comma before its `]` (the parser's TrailingComma:
    // BNF sec 6 gives the comma to an array literal only) is SM0707, once at its node
    hidden method DoSetComma(const ARoot: int64);
    begin
      if self.FTree[ARoot].HasFlag(NodeFlag.TrailingComma) then
        self.DoError(ARoot, ADAM_ERR_SEMANTICS_707, ADAM_MSG_SEMANTICS_SET_COMMA, NoArgs());
      end;
    end;

    // A const's initializer AInit when it is an array literal (BNF sec 6: in a const every
    // element folds): each element checked by DoConstPart
    hidden method DoConstLiteral(const AInit: int64);
    var
      LRoot: int64;
    begin
      if AInit = 0 then
        return;
      end;
      LRoot := self.DoSkipParens(AInit);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.ArrayLiteral) then
        self.DoConstPart(LRoot);
      end;
    end;

    // The part AExpr of a const's array literal: a nested array literal's elements, a record
    // literal's field values and a set literal's bounds each checked the same way; any other
    // value that did not fold is SM0202 at it (one with no type was reported where it lost
    // it)
    hidden method DoConstPart(const AExpr: int64);
    var
      LRoot: int64;
      LKind: NodeKind;
      LI: int64;
      LItem: int64;
    begin
      if AExpr = 0 then
        return;
      end;
      LRoot := self.DoSkipParens(AExpr);
      if LRoot = 0 then
        return;
      end;
      LKind := self.FTree[LRoot].Kind;
      if (LKind = NodeKind.ArrayLiteral) or (LKind = NodeKind.SetLiteral) then
        for LI := 0 to self.FTree.CountOf(LRoot, NodeRole.Element) - 1 do
          LItem := self.FTree.NthOf(LRoot, NodeRole.Element, LI);
          self.DoConstPart(self.FTree.FirstOf(LItem, NodeRole.LowBound));
          self.DoConstPart(self.FTree.FirstOf(LItem, NodeRole.HighBound));
        end;
        return;
      end;
      if LKind = NodeKind.RecordLiteral then
        for LI := 0 to self.FTree.CountOf(LRoot, NodeRole.Argument) - 1 do
          LItem := self.FTree.NthOf(LRoot, NodeRole.Argument, LI);
          self.DoConstPart(self.FTree.FirstOf(LItem, NodeRole.Value));
        end;
        return;
      end;
      if (self.FTree[AExpr].ResolvedConst.Kind = ConstKind.Unknown) and
        (self.FTree[AExpr].ResolvedType <> 0) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_202, ADAM_MSG_SEMANTICS_NOT_CONSTANT,
          NoArgs().Str(ADAM_MSG_SEMANTICS_A_CONST_ELEMENT));
      end;
    end;

    // The set literal ARoot (AExpr with its parentheses off) where a value of ATarget
    // goes: a set type takes it when each element converts to its element type (a trailing
    // comma is SM0707: DoSetComma)
    hidden method DoConvertSet(const AExpr: int64; const ARoot: int64; const ATarget: int64): bool;
    var
      LElement: int64;
      LI: int64;
      LItem: int64;
      LOk: bool;
    begin
      self.DoSetComma(ARoot);
      if self.DoClass(ATarget) <> TypeClass.SetType then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_200, ADAM_MSG_SEMANTICS_NO_CONVERT,
          NoArgs().Str(ADAM_MSG_SEMANTICS_A_SET_LITERAL).Str(self.DoText(ATarget)));
        return false;
      end;
      LElement := self.DoSetElement(ATarget);
      LOk := true;
      for LI := 0 to self.FTree.CountOf(ARoot, NodeRole.Element) - 1 do
        LItem := self.FTree.NthOf(ARoot, NodeRole.Element, LI);
        if not self.DoConvert(self.FTree.FirstOf(LItem, NodeRole.LowBound), LElement) then
          LOk := false;
        end;
        if not self.DoConvert(self.FTree.FirstOf(LItem, NodeRole.HighBound), LElement) then
          LOk := false;
        end;
      end;
      self.DoSetType(ARoot, ATarget);
      self.DoSetType(AExpr, ATarget);
      return LOk;
    end;

    // A char literal ARoot (AExpr with its parentheses off) converted to the wchar ATarget
    // holds its wide value (BNF sec 9, type-driven: the parser's DecodedWide unit, as
    // Folding.FoldDeclaration gives a wchar const), written into AExpr's ResolvedConst so
    // Lowering and the match labels read the unit, never the narrow code
    hidden method DoWideCharValue(const AExpr: int64; const ARoot: int64; const ATarget: int64);
    begin
      if (ARoot = 0) or (self.FTree[ARoot].Kind <> NodeKind.CharLiteral) or
        (self.DoClass(ATarget) <> TypeClass.WideChar) then
        return;
      end;
      if (len(self.FTree[ARoot].DecodedWide) = 0) or
        (self.FTree[AExpr].ResolvedConst.Kind <> ConstKind.Char) then
        return;
      end;
      self.FTree[AExpr].ResolvedConst.Bits := uint64(uint16(self.FTree[ARoot].DecodedWide[0]));
    end;

    // The value AExpr goes where a value of ATarget is needed: true when it converts (its
    // ResolvedConvert then ATarget when the type changes); else reported (SM0200, SM0406,
    // SM0408) and false. An unknown type on either side is silent (reported where it was
    // lost)
    hidden method DoConvert(const AExpr: int64; const ATarget: int64): bool;
    var
      LRoot: int64;
      LFrom: int64;
    begin
      if (AExpr = 0) or (ATarget = 0) then
        return true;
      end;
      if self.DoIsNoValue(AExpr) then
        self.DoNoValue(AExpr);
        return false;
      end;
      LRoot := self.DoSkipParens(AExpr);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.SetLiteral) then
        // the place decides (BNF sec 6): an array type takes an array literal
        if (self.DoClass(ATarget) = TypeClass.StaticArray) or
          (self.DoClass(ATarget) = TypeClass.DynamicArray) then
          return self.DoConvertArray(AExpr, LRoot, ATarget);
        end;
        return self.DoConvertSet(AExpr, LRoot, ATarget);
      end;
      LFrom := self.DoTypeOf(AExpr);
      if (LFrom = 0) or (LFrom = ATarget) then
        return true;
      end;
      if self.DoWouldConvert(AExpr, ATarget) then
        self.FTree[AExpr].ResolvedConvert := ATarget;
        self.DoWideCharValue(AExpr, LRoot, ATarget);
        return true;
      end;
      if IsIntegerClass(self.DoClass(LFrom)) and IsIntegerClass(self.DoClass(ATarget)) and
        self.DoIsConstInt(AExpr) then
        self.DoNotFit(AExpr, ATarget);
        return false;
      end;
      if (self.DoClass(LFrom) = TypeClass.ObjectType) and (self.DoClass(ATarget) = TypeClass.ObjectType) and
        IsBaseOf(self.FTree, ATarget, LFrom) then
        // Only a polymorphic object is refused its parent by value (ConvertsImplicitly)
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_428, ADAM_MSG_SEMANTICS_SLICE,
          NoArgs().Str(self.DoExprText(AExpr)).Str(self.DoText(ATarget)));
        return false;
      end;
      self.DoNoConvert(AExpr, LFrom, ATarget);
      return false;
    end;

    // True when AExpr is an integer constant (ConstIntOf)
    hidden const method DoIsConstInt(const AExpr: int64): bool;
    var
      LNegative: bool;
      LMagnitude: uint64;
    begin
      return ConstIntOf(self.FTree, AExpr, LNegative, LMagnitude);
    end;

    // The condition AExpr (if, while, repeat, guard, ?:) is a bool: SM0263 otherwise
    hidden method DoCondition(const AExpr: int64);
    var
      LType: int64;
    begin
      if AExpr = 0 then
        return;
      end;
      if self.DoIsNoValue(AExpr) then
        self.DoNoValue(AExpr);
        return;
      end;
      LType := self.DoTypeOf(AExpr);
      if (LType <> 0) and (self.DoClass(LType) <> TypeClass.Boolean) then
        self.DoError(AExpr, ADAM_ERR_SEMANTICS_263, ADAM_MSG_SEMANTICS_CONDITION,
          NoArgs().Str(self.DoText(LType)));
      end;
    end;

    // True when the value AExpr is a value-less call (reported) or of unknown type: the
    // caller then stops (its own type stays unknown)
    hidden method DoLost(const AExpr: int64): bool;
    begin
      if self.DoIsNoValue(AExpr) then
        self.DoNoValue(AExpr);
        return true;
      end;
      return self.DoTypeOf(AExpr) = 0;
    end;

    // True when the place AExpr has an address (BNF sec 6 addr of): a variable or a
    // parameter, a field or an embed of a stored value (or through a pointer, an own, a
    // ref, self), an element, a dereference, a string literal, self. A property, as a
    // member or by an index, is a value its accessor gives, never stored
    hidden const method DoIsStored(const AExpr: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
      LOperand: int64;
      LClass: TypeClass;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      LKind := NameKindOf(self.FTree, LAt);
      if (LKind = NodeKind.StringLiteral) or (LKind = NodeKind.SelfExpression) then
        return true;
      end;
      if LKind = NodeKind.NameExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        return (LDecl <> 0) and ((self.FTree[LDecl].Kind = NodeKind.VarDecl) or
          (self.FTree[LDecl].Kind = NodeKind.Param));
      end;
      if ((LKind = NodeKind.PostfixExpression) or (LKind = NodeKind.UnaryExpression)) and
        (self.FTree[LAt].Op = OperatorKind.Deref) then
        return true;
      end;
      LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
      LClass := self.DoClass(self.DoTypeOf(LOperand));
      if LKind = NodeKind.IndexExpression then
        // A property reached by the index (DoPropertyIndex) is no storage
        LDecl := self.FTree[LAt].ResolvedDecl;
        if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
          return false;
        end;
        if (LClass = TypeClass.Pointer) or (LClass = TypeClass.DynamicArray) then
          return true;
        end;
        return self.DoIsStored(LOperand);
      end;
      if LKind = NodeKind.MemberExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        if (LDecl = 0) or ((self.FTree[LDecl].Kind <> NodeKind.FieldDecl) and
          (self.FTree[LDecl].Kind <> NodeKind.EmbedDecl)) then
          return false;
        end;
        if self.FTree[LAt].HasFlag(NodeFlag.Arrow) or (LClass = TypeClass.OwnType) or
          (LClass = TypeClass.RefType) then
          return true;
        end;
        return self.DoIsStored(LOperand);
      end;
      return false;
    end;

    // True when the place AExpr can be assigned (BNF sec 6): a variable, a parameter that
    // is not const, a field or an embed of an assignable value (or through a pointer that
    // is not to const, an own, a ref, self), an element of an assignable array or string or
    // through such a pointer, a dereference of such a pointer, a property (as a member or
    // by an index: its write is DoWritten's)
    hidden const method DoIsAssignable(const AExpr: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
      LOperand: int64;
      LOperandType: int64;
      LClass: TypeClass;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      LKind := NameKindOf(self.FTree, LAt);
      if LKind = NodeKind.NameExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        if LDecl = 0 then
          return false;
        end;
        if self.FTree[LDecl].Kind = NodeKind.VarDecl then
          return true;
        end;
        return (self.FTree[LDecl].Kind = NodeKind.Param) and
          (not self.FTree[LDecl].HasFlag(NodeFlag.ConstParam));
      end;
      LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
      LOperandType := self.DoTypeOf(LOperand);
      LClass := self.DoClass(LOperandType);
      if ((LKind = NodeKind.PostfixExpression) or (LKind = NodeKind.UnaryExpression)) and
        (self.FTree[LAt].Op = OperatorKind.Deref) then
        return (LClass = TypeClass.Pointer) and (not IsConstTarget(self.FTree, LOperandType));
      end;
      if LKind = NodeKind.IndexExpression then
        // A property reached by the index (DoPropertyIndex): its write is DoWritten's
        LDecl := self.FTree[LAt].ResolvedDecl;
        if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
          return true;
        end;
        if LClass = TypeClass.Pointer then
          return not IsConstTarget(self.FTree, LOperandType);
        end;
        return self.DoIsAssignable(LOperand);
      end;
      if LKind = NodeKind.MemberExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        if LDecl = 0 then
          return false;
        end;
        if self.FTree[LDecl].Kind = NodeKind.PropertyDecl then
          return true;
        end;
        // An embed is storage of its object as a field is (PaskalCPP's rule): the same test
        if (self.FTree[LDecl].Kind <> NodeKind.FieldDecl) and
          (self.FTree[LDecl].Kind <> NodeKind.EmbedDecl) then
          return false;
        end;
        if self.FTree[LAt].HasFlag(NodeFlag.Arrow) then
          return (LClass <> TypeClass.Pointer) or (not IsConstTarget(self.FTree, LOperandType));
        end;
        if (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) or
          (self.FTree[self.DoSkipParens(LOperand)].Kind = NodeKind.SelfExpression) then
          return true;
        end;
        return self.DoIsAssignable(LOperand);
      end;
      return false;
    end;

    // An integer literal's type (BNF sec 9, C++23 [lex.icon]; a single l is C's long, as
    // wide as the target says): the first of its suffix's types that holds its value. A
    // decimal without u takes signed types only; a hex or binary one also the unsigned
    hidden method DoIntLiteral(const AId: int64);
    var
      LValue: uint64;
      LSuffix: string;
      LText: string;
      LUnsigned: bool;
      LWide: bool;
      LRadix: bool;
      LLongWide: bool;
    begin
      LValue := self.FTree[AId].IntValue;
      LSuffix := self.FTree[AId].Suffix;
      LText := self.FTree[AId].Text;
      LUnsigned := DoHasLetter(LSuffix, 'u', 'U');
      // A single l starts at 64 bits only where the target's long is 8 bytes (LP64); with
      // no target (DR0004) it keeps C++'s least width, 32 bits
      LLongWide := (self.FTarget <> nil) and (self.FTarget.CLongSize() = 8) and
        DoHasLetter(LSuffix, 'l', 'L');
      // ll and z start at 64 bits; a single l per the target's long
      LWide := DoHasLetter(LSuffix, 'z', 'Z') or StartsStr("ll", LSuffix) or
        StartsStr("LL", LSuffix) or EndsStr("ll", LSuffix) or EndsStr("LL", LSuffix) or
        LLongWide;
      LRadix := StartsStr("0x", LText) or StartsStr("0X", LText) or StartsStr("0b", LText) or
        StartsStr("0B", LText);
      if LUnsigned then
        if (not LWide) and (LValue <= 0xFFFFFFFFu) then
          self.DoSetType(AId, self.DoBuiltin("uint32"));
        else
          self.DoSetType(AId, self.DoBuiltin("uint64"));
        end;
        return;
      end;
      if (not LWide) and (LValue <= 0x7FFFFFFFu) then
        self.DoSetType(AId, self.DoBuiltin("int32"));
        return;
      end;
      if (not LWide) and LRadix and (LValue <= 0xFFFFFFFFu) then
        self.DoSetType(AId, self.DoBuiltin("uint32"));
        return;
      end;
      if LValue <= 0x7FFFFFFFFFFFFFFFu then
        self.DoSetType(AId, self.DoBuiltin("int64"));
        return;
      end;
      self.DoSetType(AId, self.DoBuiltin("uint64"));
    end;

    // A float literal's type: float32 with f, else float64
    hidden method DoFloatLiteral(const AId: int64);
    begin
      if (self.FTree[AId].Suffix = "f") or (self.FTree[AId].Suffix = "F") then
        self.DoSetType(AId, self.DoBuiltin("float32"));
        return;
      end;
      self.DoSetType(AId, self.DoBuiltin("float64"));
    end;

    // A name used as a value: its declaration's type; a type or a module is SM0269 (a type
    // as a for's iterator is the for's to report once: SM0600, DoIsIterator)
    hidden method DoName(const AId: int64);
    var
      LDecl: int64;
      LKind: NodeKind;
    begin
      LDecl := self.FTree[AId].ResolvedDecl;
      if (LDecl <> 0) and (self.FTree.RoleOf(AId) = NodeRole.Iterator) and
        DoIsTypeDecl(self.FTree[LDecl].Kind) then
        return;
      end;
      if LDecl = 0 then
        if self.FTree[AId].ResolvedUnit <> 0 then
          self.DoError(AId, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_MODULE_NOT_VALUE,
            NoArgs().Str(self.FTree[AId].Text));
        end;
        return;
      end;
      LKind := self.FTree[LDecl].Kind;
      if DoIsTypeDecl(LKind) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_TYPE_NOT_VALUE,
          NoArgs().Str(self.FTree[AId].Text));
        return;
      end;
      if LKind = NodeKind.IntrinsicDecl then
        return;
      end;
      self.DoDeclarationFirst(LDecl);
      self.DoSetType(AId, self.DoDeclType(LDecl));
    end;

    // A const's or a choice value's declaration ADecl typed and folded before a name or a
    // member naming it is folded, wherever it stands (another unit, later in the arena);
    // inside its own declaration the visit is already marked and returns at once
    hidden method DoDeclarationFirst(const ADecl: int64);
    begin
      if ADecl = 0 then
        return;
      end;
      if self.FTree[ADecl].Kind = NodeKind.ConstDecl then
        self.DoVisit(ADecl);
      end;
      if self.FTree[ADecl].Kind = NodeKind.ChoiceValue then
        self.DoVisit(self.FTree.ParentOf(self.FTree.ParentOf(ADecl)));
      end;
    end;

    // self: the type whose method encloses it; parent: that type's parent
    hidden method DoSelf(const AId: int64);
    var
      LOwner: int64;
      LType: int64;
    begin
      LOwner := MethodOwnerOf(self.FTree, AId);
      if LOwner = 0 then
        return;
      end;
      LType := DeclaredTypeOf(self.FTree, self.FTree.ParentOf(LOwner));
      if self.FTree[AId].Kind = NodeKind.ParentExpression then
        LType := ParentTypeOf(self.FTree, LType);
      end;
      self.DoSetType(AId, LType);
    end;

    // SM0250 for the operator AId on one operand of AType
    hidden method DoOpOne(const AId: int64; const AType: int64);
    begin
      self.DoError(AId, ADAM_ERR_SEMANTICS_250, ADAM_MSG_SEMANTICS_OP_ONE,
        NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(AType)));
    end;

    // SM0250 for the operator AId on operands of ALeft and ARight
    hidden method DoOpTwo(const AId: int64; const ALeft: int64; const ARight: int64);
    begin
      self.DoError(AId, ADAM_ERR_SEMANTICS_250, ADAM_MSG_SEMANTICS_OP_TWO,
        NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(ALeft)).Str(self.DoText(ARight)));
    end;

    // SM0253 at AOperand: the untyped ptr points at no type
    hidden method DoUntyped(const AOperand: int64);
    begin
      self.DoError(AOperand, ADAM_ERR_SEMANTICS_253, ADAM_MSG_SEMANTICS_UNTYPED_POINTER,
        NoArgs().Str(self.DoExprText(AOperand)).Str(self.DoExprText(AOperand)));
    end;

    // A dereference AId of AOperand (of AType): what a typed pointer points at
    hidden method DoDeref(const AId: int64; const AOperand: int64; const AType: int64);
    begin
      if self.DoClass(AType) = TypeClass.Pointer then
        self.DoSetType(AId, TargetOf(self.FTree, AType));
        return;
      end;
      if self.DoClass(AType) = TypeClass.UntypedPointer then
        self.DoUntyped(AOperand);
        return;
      end;
      self.DoOpOne(AId, AType);
    end;

    // ++ / -- AId of AOperand (of AType): an integer, a char, a wchar or a typed pointer
    // that can be assigned; the operand's own type
    hidden method DoStep(const AId: int64; const AOperand: int64; const AType: int64);
    var
      LClass: TypeClass;
    begin
      LClass := self.DoClass(AType);
      if not (IsIntegerClass(LClass) or (LClass = TypeClass.Char) or
        (LClass = TypeClass.WideChar) or (LClass = TypeClass.Pointer)) then
        self.DoOpOne(AId, AType);
        return;
      end;
      if not self.DoIsAssignable(AOperand) then
        self.DoError(AOperand, ADAM_ERR_SEMANTICS_255, ADAM_MSG_SEMANTICS_NOT_ASSIGNABLE,
          NoArgs().Str(self.DoExprText(AOperand)));
      else
        self.DoWritten(AOperand);
      end;
      self.DoSetType(AId, AType);
    end;

    // AOperand promoted where AId's arithmetic needs AType's promotion: the promoted
    // type, written as the operand's conversion when it changes
    hidden method DoPromote(const AOperand: int64; const AType: int64): int64;
    var
      LPromoted: int64;
    begin
      LPromoted := Promoted(self.FTree, AType);
      if LPromoted <> AType then
        self.FTree[AOperand].ResolvedConvert := LPromoted;
      end;
      return LPromoted;
    end;

    // A prefix operator (BNF sec 6): not on a bool; - + on a number, ~ on an integer
    // (promoted); addr of a stored place (ptr to const for a place that cannot be
    // assigned; a bitfield has none, SM0262); * / ^ a dereference; ++ --
    hidden method DoUnary(const AId: int64);
    var
      LOperand: int64;
      LType: int64;
      LClass: TypeClass;
      LOp: OperatorKind;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      LOp := self.FTree[AId].Op;
      if LOp = OperatorKind.AddressOf then
        if self.DoBitfieldAddress(LOperand) then
          return;
        end;
        // A property is no storage: it has no address (pcpp O9)
        if self.DoPropertyOf(LOperand) <> 0 then
          self.DoError(LOperand, ADAM_ERR_SEMANTICS_376, ADAM_MSG_SEMANTICS_PROPERTY_STORAGE,
            NoArgs().Str(self.DoExprText(LOperand)).Str("addr of"));
          return;
        end;
        if not self.DoIsStored(LOperand) then
          self.DoError(LOperand, ADAM_ERR_SEMANTICS_254, ADAM_MSG_SEMANTICS_NO_ADDRESS,
            NoArgs().Str(self.DoExprText(LOperand)));
          return;
        end;
        LType := self.DoTypeOf(LOperand);
        if LType <> 0 then
          self.DoSetType(AId, PointerTo(self.FTree, LType, not self.DoIsAssignable(LOperand)));
        end;
        return;
      end;
      if self.DoLost(LOperand) then
        return;
      end;
      LType := self.DoTypeOf(LOperand);
      LClass := self.DoClass(LType);
      if LOp = OperatorKind.LogicalNot then
        if LClass = TypeClass.Boolean then
          self.DoSetType(AId, LType);
        else
          self.DoOpOne(AId, LType);
        end;
        return;
      end;
      if (LOp = OperatorKind.Negate) or (LOp = OperatorKind.Plus) then
        if IsNumericClass(LClass) then
          self.DoSetType(AId, self.DoPromote(LOperand, LType));
        else
          self.DoOpOne(AId, LType);
        end;
        return;
      end;
      if LOp = OperatorKind.BitNot then
        if IsIntegerClass(LClass) then
          self.DoSetType(AId, self.DoPromote(LOperand, LType));
        else
          self.DoOpOne(AId, LType);
        end;
        return;
      end;
      if LOp = OperatorKind.Deref then
        self.DoDeref(AId, LOperand, LType);
        return;
      end;
      self.DoStep(AId, LOperand, LType);
    end;

    // A postfix operator: ^ (a dereference), ++ / --
    hidden method DoPostfix(const AId: int64);
    var
      LOperand: int64;
      LType: int64;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      if self.DoLost(LOperand) then
        return;
      end;
      LType := self.DoTypeOf(LOperand);
      if self.FTree[AId].Op = OperatorKind.Deref then
        self.DoDeref(AId, LOperand, LType);
        return;
      end;
      self.DoStep(AId, LOperand, LType);
    end;

    // Two numbers meet at their common type (BNF sec 6, PLAN-ARITH): each converts to it
    // (SM0200 at the one that does not, the cast as the hint); the common type
    hidden method DoArithmetic(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64): int64;
    var
      LCommon: int64;
    begin
      LCommon := CommonArithmetic(self.FTree, ALeftType, ARightType);
      self.DoConvert(ALeft, LCommon);
      self.DoConvert(ARight, LCommon);
      return LCommon;
    end;

    // One side ASide of a concatenation in the string family AText (string or wstring,
    // its char ACharType): the family's string or char, or a literal taking its form
    hidden method DoConcatSide(const ASide: int64; const AText: int64; const ACharType: int64): bool;
    var
      LType: int64;
      LRoot: int64;
    begin
      LType := self.DoTypeOf(ASide);
      if (LType = AText) or (LType = ACharType) then
        return true;
      end;
      LRoot := self.DoSkipParens(ASide);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.StringLiteral) then
        return self.DoConvert(ASide, AText);
      end;
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.CharLiteral) then
        return self.DoConvert(ASide, ACharType);
      end;
      return false;
    end;

    // + with a string family operand (BNF sec 6): concatenation with the string family of
    // its width (a string, a string literal, a char); the family's string type
    hidden method DoConcat(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64);
    var
      LText: int64;
      LChar: int64;
    begin
      if (self.DoClass(ALeftType) = TypeClass.WideText) or
        (self.DoClass(ARightType) = TypeClass.WideText) then
        LText := self.DoBuiltin("wstring");
        LChar := self.DoBuiltin("wchar");
      else
        LText := self.DoBuiltin("string");
        LChar := self.DoBuiltin("char");
      end;
      if self.DoConcatSide(ALeft, LText, LChar) and self.DoConcatSide(ARight, LText, LChar) then
        self.DoSetType(AId, LText);
        return;
      end;
      self.DoOpTwo(AId, ALeftType, ARightType);
    end;

    // True when ALeft and ARight are one set type
    hidden const method DoSameSet(const ALeft: int64; const ARight: int64): bool;
    begin
      return (ALeft = ARight) and (self.DoClass(ALeft) = TypeClass.SetType);
    end;

    // + - and the sets' * & | (union, difference, intersection) and pointer moves
    // (ptr + n, n + ptr, ptr - n, ptr - ptr: int64), else the numbers' arithmetic
    hidden method DoAdditive(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64);
    var
      LLeft: TypeClass;
      LRight: TypeClass;
      LOp: OperatorKind;
    begin
      LLeft := self.DoClass(ALeftType);
      LRight := self.DoClass(ARightType);
      LOp := self.FTree[AId].Op;
      if (LOp = OperatorKind.Add) and ((LLeft = TypeClass.Text) or (LRight = TypeClass.Text) or
        (LLeft = TypeClass.WideText) or (LRight = TypeClass.WideText)) then
        self.DoConcat(AId, ALeft, ARight, ALeftType, ARightType);
        return;
      end;
      if self.DoSameSet(ALeftType, ARightType) then
        self.DoSetType(AId, ALeftType);
        return;
      end;
      if IsNumericClass(LLeft) and IsNumericClass(LRight) and (LOp <> OperatorKind.BitAnd) and
        (LOp <> OperatorKind.BitOr) then
        self.DoSetType(AId, self.DoArithmetic(AId, ALeft, ARight, ALeftType, ARightType));
        return;
      end;
      if (LOp = OperatorKind.Add) or (LOp = OperatorKind.Subtract) then
        if (LLeft = TypeClass.UntypedPointer) and IsIntegerClass(LRight) then
          self.DoUntyped(ALeft);
          return;
        end;
        if (LLeft = TypeClass.Pointer) and IsIntegerClass(LRight) then
          self.DoSetType(AId, ALeftType);
          return;
        end;
        if (LOp = OperatorKind.Add) and IsIntegerClass(LLeft) and (LRight = TypeClass.Pointer) then
          self.DoSetType(AId, ARightType);
          return;
        end;
        if (LOp = OperatorKind.Subtract) and (LLeft = TypeClass.Pointer) and (ALeftType = ARightType) then
          self.DoSetType(AId, self.DoBuiltin("int64"));
          return;
        end;
      end;
      self.DoOpTwo(AId, ALeftType, ARightType);
    end;

    // / is real division (BNF sec 6): float32 when a float32 meets no float64 (each
    // operand converts to it), else float64
    hidden method DoDivide(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64);
    var
      LResult: int64;
    begin
      if not (IsNumericClass(self.DoClass(ALeftType)) and IsNumericClass(self.DoClass(ARightType))) then
        self.DoOpTwo(AId, ALeftType, ARightType);
        return;
      end;
      LResult := self.DoBuiltin("float64");
      if ((FloatBits(self.FTree, ALeftType) = 32) or (FloatBits(self.FTree, ARightType) = 32)) and
        (FloatBits(self.FTree, ALeftType) <> 64) and (FloatBits(self.FTree, ARightType) <> 64) then
        LResult := self.DoBuiltin("float32");
      end;
      self.DoConvert(ALeft, LResult);
      self.DoConvert(ARight, LResult);
      self.DoSetType(AId, LResult);
    end;

    // div / mod on integers; & | on integers (or sets, DoAdditive); xor on integers or two
    // bools (a bool)
    hidden method DoIntegral(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64);
    var
      LLeft: TypeClass;
      LRight: TypeClass;
    begin
      LLeft := self.DoClass(ALeftType);
      LRight := self.DoClass(ARightType);
      if IsIntegerClass(LLeft) and IsIntegerClass(LRight) then
        self.DoSetType(AId, self.DoArithmetic(AId, ALeft, ARight, ALeftType, ARightType));
        return;
      end;
      if (self.FTree[AId].Op = OperatorKind.Xor) and (LLeft = TypeClass.Boolean) and
        (LRight = TypeClass.Boolean) then
        self.DoSetType(AId, ALeftType);
        return;
      end;
      if ((self.FTree[AId].Op = OperatorKind.BitAnd) or (self.FTree[AId].Op = OperatorKind.BitOr)) and
        self.DoSameSet(ALeftType, ARightType) then
        self.DoSetType(AId, ALeftType);
        return;
      end;
      self.DoOpTwo(AId, ALeftType, ARightType);
    end;

    // shl / shr: an integer shifted by an integer count (not converted); the promoted
    // left operand's type
    hidden method DoShift(const AId: int64; const ALeft: int64; const ALeftType: int64;
      const ARightType: int64);
    begin
      if IsIntegerClass(self.DoClass(ALeftType)) and IsIntegerClass(self.DoClass(ARightType)) then
        self.DoSetType(AId, self.DoPromote(ALeft, ALeftType));
        return;
      end;
      self.DoOpTwo(AId, ALeftType, ARightType);
    end;

    // True when the string family side ASide meets AOther's family in a comparison: the
    // same string type, or a string literal taking its form
    hidden method DoStringSide(const ASide: int64; const AFamily: int64): bool;
    var
      LRoot: int64;
    begin
      if self.DoTypeOf(ASide) = AFamily then
        return true;
      end;
      LRoot := self.DoSkipParens(ASide);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.StringLiteral) then
        return self.DoConvert(ASide, AFamily);
      end;
      return false;
    end;

    // True when values of the aggregate (or array of aggregates) AType compare with the
    // operator AId: SM0252 (reported) when its type declares no operator for it
    hidden method DoComparable(const AId: int64; const AType: int64): bool;
    var
      LType: int64;
      LClass: TypeClass;
    begin
      LType := AType;
      while (self.DoClass(LType) = TypeClass.StaticArray) or
        (self.DoClass(LType) = TypeClass.DynamicArray) do
        LType := TargetOf(self.FTree, LType);
      end;
      LClass := self.DoClass(LType);
      if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.OverlayType) and
        (LClass <> TypeClass.ObjectType) then
        return true;
      end;
      if DeclaresOperator(self.FTree, LType, self.FTree[AId].Text) then
        return true;
      end;
      if LClass = TypeClass.ObjectType then
        self.DoError(AId, ADAM_ERR_SEMANTICS_252, ADAM_MSG_SEMANTICS_OBJECT_NOT_COMPARABLE,
          NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(AType)));
      else
        self.DoError(AId, ADAM_ERR_SEMANTICS_252, ADAM_MSG_SEMANTICS_NOT_COMPARABLE,
          NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(AType)));
      end;
      return false;
    end;

    // = <> < <= > >= <=> (BNF sec 6): two numbers meet at their common type; a bool, a
    // char, a wchar, a choices value with its own type; a string with its family (or a
    // literal); pointers (nil, an extension's with its base's); an own / ref / weak /
    // routine / interface value with one of its type or nil; a set with its own type; an
    // array, record, overlay or object with its own type when its elements compare (an
    // aggregate only through a declared operator, SM0252). A bool, or int32 for <=>
    hidden method DoCompare(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64);
    var
      LLeft: TypeClass;
      LRight: TypeClass;
      LResult: int64;
      LOk: bool;
    begin
      LResult := self.DoBuiltin("bool");
      if self.FTree[AId].Op = OperatorKind.Compare then
        LResult := self.DoBuiltin("int32");
      end;
      LLeft := self.DoClass(ALeftType);
      LRight := self.DoClass(ARightType);
      LOk := false;
      if IsNumericClass(LLeft) and IsNumericClass(LRight) then
        self.DoArithmetic(AId, ALeft, ARight, ALeftType, ARightType);
        LOk := true;
      else
        if (LLeft = TypeClass.Text) or (LLeft = TypeClass.WideText) then
          // a string literal on the left takes a wstring right side's form, as one on the
          // right takes the left's (BNF sec 6: `"ab" < LW`)
          LOk := self.DoStringSide(ARight, ALeftType);
          if (not LOk) and ((LRight = TypeClass.Text) or (LRight = TypeClass.WideText)) then
            LOk := self.DoStringSide(ALeft, ARightType);
          end;
        else
          if (LRight = TypeClass.Text) or (LRight = TypeClass.WideText) then
            LOk := self.DoStringSide(ALeft, ARightType);
          else
            if not self.DoScalarCompare(AId, ALeft, ARight, ALeftType, ARightType, LOk) then
              return;
            end;
          end;
        end;
      end;
      // A set compares by = <> and by >= <= (superset, subset: BNF sec 4); < > <=> are SM0250
      if (LLeft = TypeClass.SetType) and (self.FTree[AId].Op <> OperatorKind.Equal) and
        (self.FTree[AId].Op <> OperatorKind.NotEqual) and
        (self.FTree[AId].Op <> OperatorKind.GreaterEqual) and
        (self.FTree[AId].Op <> OperatorKind.LessEqual) then
        LOk := false;
      end;
      if not LOk then
        self.DoOpTwo(AId, ALeftType, ARightType);
        return;
      end;
      self.DoSetType(AId, LResult);
    end;

    // The sides of the comparison AId of two values that are no number pair and no text
    // (ALeft of ALeftType, ARight of ARightType) brought to one type, AOk true when they
    // meet: a char literal on either side of a wchar takes the wchar form (DoWideCharSide),
    // else one side converts implicitly to the other's type; there the type must compare
    // (DoComparable). False when DoComparable reported (AId needs no report of its own);
    // true with AOk false when the sides meet at no type (the caller's SM0250)
    hidden method DoScalarCompare(const AId: int64; const ALeft: int64; const ARight: int64;
      const ALeftType: int64; const ARightType: int64; var AOk: bool): bool;
    begin
      AOk := false;
      if self.DoWideCharSide(ARight, ALeftType) then
        AOk := self.DoComparable(AId, ALeftType);
        return AOk;
      end;
      if self.DoWideCharSide(ALeft, ARightType) then
        AOk := self.DoComparable(AId, ARightType);
        return AOk;
      end;
      if ConvertsImplicitly(self.FTree, ARightType, ALeftType) then
        self.DoConvert(ARight, ALeftType);
        AOk := self.DoComparable(AId, ALeftType);
        return AOk;
      end;
      if ConvertsImplicitly(self.FTree, ALeftType, ARightType) then
        self.DoConvert(ALeft, ARightType);
        AOk := self.DoComparable(AId, ARightType);
        return AOk;
      end;
      return true;
    end;

    // True when ASide, one side of a comparison whose other side is of AOther, is a char
    // literal and AOther a wchar: the literal takes the wchar form (BNF sec 9: wide
    // literals are type-driven, as a string literal beside a wstring), converted there
    // (DoConvert writes its wide unit); a char literal no wchar unit holds is the parser's
    // PR0054 already
    hidden method DoWideCharSide(const ASide: int64; const AOther: int64): bool;
    begin
      if self.DoClass(AOther) <> TypeClass.WideChar then
        return false;
      end;
      if not self.DoLiteralTakes(self.DoSkipParens(ASide), AOther) then
        return false;
      end;
      self.DoConvert(ASide, AOther);
      return true;
    end;

    // and / or on two bools
    hidden method DoLogical(const AId: int64; const ALeftType: int64; const ARightType: int64);
    begin
      if (self.DoClass(ALeftType) = TypeClass.Boolean) and
        (self.DoClass(ARightType) = TypeClass.Boolean) then
        self.DoSetType(AId, ALeftType);
        return;
      end;
      self.DoOpTwo(AId, ALeftType, ARightType);
    end;

    // X in S: S a set type (X converts to its element type, SM0268 otherwise) or a set
    // literal (its items convert to X's type); a bool
    hidden method DoIn(const AId: int64; const ALeft: int64; const ARight: int64);
    var
      LRoot: int64;
      LLeftType: int64;
      LRightType: int64;
      LElement: int64;
      LI: int64;
      LItem: int64;
    begin
      self.DoSetType(AId, self.DoBuiltin("bool"));
      if self.DoLost(ALeft) then
        return;
      end;
      LLeftType := self.DoTypeOf(ALeft);
      LRoot := self.DoSkipParens(ARight);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.SetLiteral) then
        self.DoSetComma(LRoot);
        for LI := 0 to self.FTree.CountOf(LRoot, NodeRole.Element) - 1 do
          LItem := self.FTree.NthOf(LRoot, NodeRole.Element, LI);
          self.DoConvert(self.FTree.FirstOf(LItem, NodeRole.LowBound), LLeftType);
          self.DoConvert(self.FTree.FirstOf(LItem, NodeRole.HighBound), LLeftType);
        end;
        return;
      end;
      if self.DoLost(ARight) then
        return;
      end;
      LRightType := self.DoTypeOf(ARight);
      if self.DoClass(LRightType) <> TypeClass.SetType then
        self.DoOpTwo(AId, LLeftType, LRightType);
        return;
      end;
      LElement := self.DoSetElement(LRightType);
      if LElement = 0 then
        return;
      end;
      if self.DoWouldConvert(ALeft, LElement) then
        self.DoConvert(ALeft, LElement);
        return;
      end;
      self.DoError(ALeft, ADAM_ERR_SEMANTICS_268, ADAM_MSG_SEMANTICS_NOT_ELEMENT,
        NoArgs().Str(self.DoText(LLeftType)).Str(self.DoText(LRightType)));
    end;

    // A set literal ASide meeting a set type AOther (S + [1, 2]): it takes the set type
    hidden method DoSetLiteralSide(const ASide: int64; const AOther: int64);
    var
      LRoot: int64;
    begin
      LRoot := self.DoSkipParens(ASide);
      if (LRoot <> 0) and (self.FTree[LRoot].Kind = NodeKind.SetLiteral) and
        (self.DoClass(self.DoTypeOf(AOther)) = TypeClass.SetType) then
        self.DoConvert(ASide, self.DoTypeOf(AOther));
      end;
    end;

    // A binary operator (BNF sec 6), by its meaning
    hidden method DoBinary(const AId: int64);
    var
      LLeft: int64;
      LRight: int64;
      LLeftType: int64;
      LRightType: int64;
      LOp: OperatorKind;
    begin
      LLeft := self.FTree.FirstOf(AId, NodeRole.Left);
      LRight := self.FTree.FirstOf(AId, NodeRole.Right);
      self.DoVisit(LLeft);
      self.DoVisit(LRight);
      LOp := self.FTree[AId].Op;
      if LOp = OperatorKind.In then
        self.DoIn(AId, LLeft, LRight);
        return;
      end;
      self.DoSetLiteralSide(LLeft, LRight);
      self.DoSetLiteralSide(LRight, LLeft);
      if self.DoLost(LLeft) or self.DoLost(LRight) then
        return;
      end;
      LLeftType := self.DoTypeOf(LLeft);
      LRightType := self.DoTypeOf(LRight);
      match LOp of
        OperatorKind.LogicalOr, OperatorKind.LogicalAnd:
          self.DoLogical(AId, LLeftType, LRightType);
        OperatorKind.Equal, OperatorKind.NotEqual, OperatorKind.Less, OperatorKind.LessEqual,
        OperatorKind.Greater, OperatorKind.GreaterEqual, OperatorKind.Compare:
          self.DoCompare(AId, LLeft, LRight, LLeftType, LRightType);
        OperatorKind.Add, OperatorKind.Subtract, OperatorKind.Multiply:
          self.DoAdditive(AId, LLeft, LRight, LLeftType, LRightType);
        OperatorKind.Divide:
          self.DoDivide(AId, LLeft, LRight, LLeftType, LRightType);
        OperatorKind.IntDivide, OperatorKind.Modulo, OperatorKind.BitAnd, OperatorKind.BitOr,
        OperatorKind.Xor:
          self.DoIntegral(AId, LLeft, LRight, LLeftType, LRightType);
        OperatorKind.ShiftLeft, OperatorKind.ShiftRight:
          self.DoShift(AId, LLeft, LLeftType, LRightType);
      else
        self.DoOpTwo(AId, LLeftType, LRightType);
      end;
    end;

    // True when AOp is a compound operator a set target takes (BNF sec 4 / A8d: += -= *=
    // and &= |=)
    hidden const method DoIsSetCompound(const AOp: OperatorKind): bool;
    begin
      return (AOp = OperatorKind.AddAssign) or (AOp = OperatorKind.SubtractAssign) or
        (AOp = OperatorKind.MultiplyAssign) or (AOp = OperatorKind.BitAndAssign) or
        (AOp = OperatorKind.BitOrAssign);
    end;

    // A compound assignment's value ASource on ATarget (of AType): the operator must take
    // the target's type (/= on an integer is SM0250: write div), then the value converts
    // to it; a shift's count is an integer, not converted; a pointer moves by an integer. A
    // set literal has no type of its own before it meets one: on a set target it takes the
    // target's (DoConvert, as `:=` gives it), so it is never read as a lost value
    hidden method DoCompound(const AId: int64; const ASource: int64; const AType: int64);
    var
      LClass: TypeClass;
      LOp: OperatorKind;
      LSourceType: int64;
      LRoot: int64;
      LOk: bool;
    begin
      LClass := self.DoClass(AType);
      LOp := self.FTree[AId].Op;
      LRoot := self.DoSkipParens(ASource);
      if (LClass = TypeClass.SetType) and (LRoot <> 0) and
        (self.FTree[LRoot].Kind = NodeKind.SetLiteral) then
        if self.DoIsSetCompound(LOp) then
          self.DoConvert(ASource, AType);
        else
          self.DoOpTwo(AId, AType, AType);
        end;
        return;
      end;
      if self.DoLost(ASource) then
        return;
      end;
      LSourceType := self.DoTypeOf(ASource);
      LOk := false;
      if (LOp = OperatorKind.ShiftLeftAssign) or (LOp = OperatorKind.ShiftRightAssign) then
        LOk := IsIntegerClass(LClass) and IsIntegerClass(self.DoClass(LSourceType));
        if not LOk then
          self.DoOpTwo(AId, AType, LSourceType);
        end;
        return;
      end;
      if (LClass = TypeClass.Pointer) and
        ((LOp = OperatorKind.AddAssign) or (LOp = OperatorKind.SubtractAssign)) then
        if not IsIntegerClass(self.DoClass(LSourceType)) then
          self.DoOpTwo(AId, AType, LSourceType);
        end;
        return;
      end;
      if (LOp = OperatorKind.AddAssign) and ((LClass = TypeClass.Text) or (LClass = TypeClass.WideText)) then
        if LClass = TypeClass.Text then
          LOk := self.DoConcatSide(ASource, AType, self.DoBuiltin("char"));
        else
          LOk := self.DoConcatSide(ASource, AType, self.DoBuiltin("wchar"));
        end;
        if not LOk then
          self.DoOpTwo(AId, AType, LSourceType);
        end;
        return;
      end;
      if LClass = TypeClass.SetType then
        LOk := self.DoIsSetCompound(LOp);
      end;
      if IsIntegerClass(LClass) then
        LOk := LOp <> OperatorKind.DivideAssign;
      end;
      if LClass = TypeClass.Float then
        LOk := (LOp = OperatorKind.AddAssign) or (LOp = OperatorKind.SubtractAssign) or
          (LOp = OperatorKind.MultiplyAssign) or (LOp = OperatorKind.DivideAssign);
      end;
      if not LOk then
        self.DoOpTwo(AId, AType, LSourceType);
        return;
      end;
      self.DoConvert(ASource, AType);
    end;

    // := and the compound assignments: the target can be assigned (SM0255), the value
    // converts to its type, a constant stored into a bitfield fits its width (SM0200,
    // DoBitStore); the target's type
    hidden method DoAssign(const AId: int64);
    var
      LTarget: int64;
      LSource: int64;
      LType: int64;
      LField: int64;
    begin
      LTarget := self.FTree.FirstOf(AId, NodeRole.Target);
      LSource := self.FTree.FirstOf(AId, NodeRole.Source);
      self.DoVisit(LTarget);
      self.DoVisit(LSource);
      LType := self.DoTypeOf(LTarget);
      if LType = 0 then
        return;
      end;
      // An assignment to a property is a statement: its write has no value (pcpp O9)
      if (self.DoPropertyOf(LTarget) <> 0) and
        (self.FTree[self.FTree.ParentOf(AId)].Kind <> NodeKind.ExpressionStatement) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_377, ADAM_MSG_SEMANTICS_PROPERTY_ASSIGN_VALUE,
          NoArgs().Str(self.FTree[self.DoPropertyOf(LTarget)].Text));
        self.DoSetType(AId, LType);
        return;
      end;
      if not self.DoIsAssignable(LTarget) then
        self.DoError(LTarget, ADAM_ERR_SEMANTICS_255, ADAM_MSG_SEMANTICS_NOT_ASSIGNABLE,
          NoArgs().Str(self.DoExprText(LTarget)));
      else
        self.DoWritten(LTarget);
      end;
      self.DoSetType(AId, LType);
      // A mutex is never assigned (a lock would be copied with it): SM0621
      if HoldsMutex(self.FTree, LType) then
        self.DoError(LTarget, ADAM_ERR_SEMANTICS_621, ADAM_MSG_SEMANTICS_MUTEX_ASSIGN,
          NoArgs().Str(self.DoExprText(LTarget)).Str(self.DoText(LType)));
        return;
      end;
      if self.FTree[AId].Op = OperatorKind.Assign then
        self.DoPackSource(LSource, LType);
        LField := self.DoBitfieldIn(LTarget);
        self.DoOwnMoves(LSource, false);
        if self.DoConvert(LSource, LType) and (LField <> 0) then
          self.DoBitStore(LField, LSource);
        end;
        return;
      end;
      self.DoCompound(AId, LSource, LType);
    end;

    // True when the place AExpr is part of self's own storage: self, or a field or an
    // element reached from it by value (a field of a field, an element of a static or
    // dynamic array or a string field). Through a pointer, an own or a ref it is another
    // object's storage
    hidden const method DoThroughSelf(const AExpr: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
      LOperand: int64;
      LClass: TypeClass;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      LKind := self.FTree[LAt].Kind;
      if LKind = NodeKind.SelfExpression then
        return true;
      end;
      if (LKind <> NodeKind.MemberExpression) and (LKind <> NodeKind.IndexExpression) then
        return false;
      end;
      if self.FTree[LAt].HasFlag(NodeFlag.Arrow) then
        return false;
      end;
      LOperand := self.FTree.FirstOf(LAt, NodeRole.Operand);
      LClass := self.DoClass(self.DoTypeOf(LOperand));
      if IsPointerClass(LClass) or (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
        return false;
      end;
      return self.DoThroughSelf(LOperand);
    end;

    // The property AProperty written at AAt (ATarget the whole target, AObject the value
    // whose property it is): it needs a write (SM0375) this place may reach (a hidden write:
    // SM0019); false when it has no write
    hidden method DoPropertyWritten(const ATarget: int64; const AAt: int64; const AObject: int64;
      const AProperty: int64): bool;
    var
      LWrite: int64;
    begin
      LWrite := self.FTree.FirstOf(AProperty, NodeRole.Write);
      if LWrite = 0 then
        self.DoError(ATarget, ADAM_ERR_SEMANTICS_375, ADAM_MSG_SEMANTICS_PROPERTY_NO_WRITE,
          NoArgs().Str(self.FTree[AProperty].Text));
        return false;
      end;
      if self.FTree[LWrite].HasFlag(NodeFlag.Hidden) then
        self.DoHiddenReach(AAt, AObject, LWrite);
      end;
      return true;
    end;

    // The property the expression AExpr (through parentheses) reads or writes: a member
    // access or an index (DoPropertyIndex) whose ResolvedDecl is a property; 0 otherwise
    hidden const method DoPropertyOf(const AExpr: int64): int64;
    var
      LAt: int64;
      LDecl: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return 0;
      end;
      if (self.FTree[LAt].Kind <> NodeKind.MemberExpression) and
        (self.FTree[LAt].Kind <> NodeKind.IndexExpression) then
        return 0;
      end;
      LDecl := self.FTree[LAt].ResolvedDecl;
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.PropertyDecl) then
        return 0;
      end;
      return LDecl;
    end;

    // True when the property access AId on AObject (AAccess the member access whose
    // ResolvedEmbed tells whether an embed holds the property) sits inside the property's
    // own accessor AAccessor, its read or its write, reached through self or parent: it
    // would run that accessor again, forever (SM0374, pcpp's DoInOwnAccessor). A property
    // reached through an embed is the embed's, never this accessor's
    hidden const method DoInOwnAccessor(const AId: int64; const AObject: int64; const AAccess: int64;
      const AAccessor: int64): bool;
    var
      LObject: int64;
      LKind: NodeKind;
    begin
      if (AAccessor = 0) or (self.DoEnclosingRoutine(AId) <> AAccessor) then
        return false;
      end;
      if (AAccess <> 0) and (self.FTree[AAccess].ResolvedEmbed <> 0) then
        return false;
      end;
      LObject := self.DoSkipParens(AObject);
      if LObject = 0 then
        return false;
      end;
      LKind := self.FTree[LObject].Kind;
      return (LKind = NodeKind.SelfExpression) or (LKind = NodeKind.ParentExpression);
    end;

    // True when the expression AId is the target of an assignment (its write runs, not its
    // read: DoWritten judges it)
    hidden const method DoIsAssignTarget(const AId: int64): bool;
    var
      LParent: int64;
    begin
      LParent := self.FTree.ParentOf(AId);
      return (LParent <> 0) and (self.FTree[LParent].Kind = NodeKind.AssignExpression) and
        (self.FTree.RoleOf(AId) = NodeRole.Target);
    end;

    // The place ATarget is written (an assignment, ++ / --): a property, reached as a member
    // or by an index (DoPropertyIndex: X.P[i] or a default property's X[i]), needs a write
    // (DoPropertyWritten) and is not assigned through self in its own write (SM0374); a
    // const method changes nothing of its object (SM0387), nor does a property's read
    // (SM0373); a for iterator is not written inside its loop (DoIteratorWritten)
    hidden method DoWritten(const ATarget: int64);
    var
      LAt: int64;
      LDecl: int64;
      LObject: int64;
      LAccess: int64;
      LMethod: int64;
    begin
      self.DoIteratorWritten(ATarget);
      LAt := self.DoSkipParens(ATarget);
      if (LAt <> 0) and ((self.FTree[LAt].Kind = NodeKind.MemberExpression) or
        (self.FTree[LAt].Kind = NodeKind.IndexExpression)) then
        LDecl := self.FTree[LAt].ResolvedDecl;
        if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
          LObject := self.FTree.FirstOf(LAt, NodeRole.Operand);
          LAccess := LAt;
          // X.P[i]: the object is the member's operand, not the member
          if (self.FTree[LAt].Kind = NodeKind.IndexExpression) and
            (self.FTree[LObject].Kind = NodeKind.MemberExpression) and
            (self.FTree[LObject].ResolvedDecl = LDecl) then
            LAccess := LObject;
            LObject := self.FTree.FirstOf(LObject, NodeRole.Operand);
          end;
          if not self.DoPropertyWritten(ATarget, LAt, LObject, LDecl) then
            return;
          end;
          if self.DoInOwnAccessor(LAt, LObject, LAccess, self.FTree.FirstOf(LDecl, NodeRole.Write)) then
            self.DoError(ATarget, ADAM_ERR_SEMANTICS_374, ADAM_MSG_SEMANTICS_PROPERTY_OWN_WRITE,
              NoArgs().Str(self.FTree[LDecl].Text));
            return;
          end;
        end;
      end;
      LMethod := self.DoEnclosingRoutine(ATarget);
      if LMethod = 0 then
        return;
      end;
      if (self.FTree[LMethod].Kind = NodeKind.MethodDecl) and
        self.FTree[LMethod].HasFlag(NodeFlag.ConstMethod) and self.DoThroughSelf(ATarget) then
        self.DoError(ATarget, ADAM_ERR_SEMANTICS_387, ADAM_MSG_SEMANTICS_CONST_METHOD_CHANGE,
          NoArgs().Str(self.FTree[LMethod].Text).Str(self.DoExprText(ATarget)));
        return;
      end;
      // A property's read has self const (pcpp O9): it changes nothing of its object
      if (self.FTree[LMethod].Kind = NodeKind.PropertyRead) and self.DoThroughSelf(ATarget) then
        self.DoError(ATarget, ADAM_ERR_SEMANTICS_373, ADAM_MSG_SEMANTICS_PROPERTY_READ_CHANGE,
          NoArgs().Str(self.FTree[self.FTree.ParentOf(LMethod)].Text).Str(self.DoExprText(ATarget)));
      end;
    end;

    // C ? A : B: C is a bool; one branch converts to the other's type (that type), or two
    // numbers meet at their common type; SM0200 at the else branch otherwise
    hidden method DoConditional(const AId: int64);
    var
      LCondition: int64;
      LThen: int64;
      LElse: int64;
      LThenType: int64;
      LElseType: int64;
    begin
      LCondition := self.FTree.FirstOf(AId, NodeRole.Condition);
      LThen := self.FTree.FirstOf(AId, NodeRole.Then);
      LElse := self.FTree.FirstOf(AId, NodeRole.Else);
      self.DoVisit(LCondition);
      self.DoVisit(LThen);
      self.DoVisit(LElse);
      self.DoCondition(LCondition);
      if self.DoLost(LThen) or self.DoLost(LElse) then
        return;
      end;
      LThenType := self.DoTypeOf(LThen);
      LElseType := self.DoTypeOf(LElse);
      if self.DoWouldConvert(LElse, LThenType) then
        self.DoConvert(LElse, LThenType);
        self.DoSetType(AId, LThenType);
        return;
      end;
      if self.DoWouldConvert(LThen, LElseType) then
        self.DoConvert(LThen, LElseType);
        self.DoSetType(AId, LElseType);
        return;
      end;
      if IsNumericClass(self.DoClass(LThenType)) and IsNumericClass(self.DoClass(LElseType)) then
        self.DoSetType(AId, self.DoArithmetic(AId, LThen, LElse, LThenType, LElseType));
        return;
      end;
      self.DoNoConvert(LElse, LElseType, LThenType);
    end;

    // The type the bounds of the array type AArray give its index when it is a static
    // array bounded by chars, wchars or choices; 0 for any other array (an integer index)
    hidden method DoIndexBoundType(const AArray: int64): int64;
    var
      LLow: int64;
      LBound: int64;
      LBoundClass: TypeClass;
    begin
      if self.DoClass(AArray) <> TypeClass.StaticArray then
        return 0;
      end;
      LLow := self.FTree.FirstOf(self.FTree[AArray].ResolvedDecl, NodeRole.LowBound);
      // a bound the array type owns in an index family is typed already (Types'
      // DoOwnBound): a visit would type its literal as an integer
      if self.FTree[LLow].ResolvedType = 0 then
        self.DoVisit(LLow);
      end;
      LBound := self.DoTypeOf(LLow);
      LBoundClass := self.DoClass(LBound);
      if (LBoundClass = TypeClass.Char) or (LBoundClass = TypeClass.WideChar) or
        (LBoundClass = TypeClass.ChoicesType) then
        return LBound;
      end;
      return 0;
    end;

    // The index AIndex of the array type AArray: a char- or choices-bounded array takes a
    // value of its bounds' type (SM0261 family), any other an integer; an index of the
    // right type is then judged against a static array's folded bounds (DoIndexInRange)
    hidden method DoArrayIndex(const AIndex: int64; const AArray: int64);
    var
      LBound: int64;
    begin
      LBound := self.DoIndexBoundType(AArray);
      if LBound = 0 then
        self.DoIntegerIndex(AIndex);
        if (not self.DoLost(AIndex)) and IsIntegerClass(self.DoClass(self.DoTypeOf(AIndex))) then
          self.DoIndexInRange(AIndex, AArray, self.DoTypeOf(AIndex));
        end;
        return;
      end;
      if self.DoLost(AIndex) then
        return;
      end;
      if self.DoWouldConvert(AIndex, LBound) then
        self.DoConvert(AIndex, LBound);
        self.DoIndexInRange(AIndex, AArray, LBound);
        return;
      end;
      self.DoError(AIndex, ADAM_ERR_SEMANTICS_261, ADAM_MSG_SEMANTICS_INDEX_FAMILY,
        NoArgs().Str(self.DoText(AArray)).Str(self.DoText(LBound)).Str(self.DoText(self.DoTypeOf(AIndex))));
    end;

    // pcpp's F45 (SM0276): a static array AArray indexed by a constant AIndex outside its
    // folded bounds is an error at the index. The index is read as a value of AType (the
    // bounds' type for a char / wchar / choices array, else its own type), the bounds as
    // BoundValue reads them (the target's char reading), so both compare as values of the
    // index type. An index or a bound that did not fold is not judged here
    hidden method DoIndexInRange(const AIndex: int64; const AArray: int64; const AType: int64);
    var
      LDecl: int64;
      LLowExpr: int64;
      LHighExpr: int64;
      LLow: int64;
      LHigh: int64;
      LIndex: int64;
      LAbove: bool;
    begin
      if self.DoClass(AArray) <> TypeClass.StaticArray then
        return;
      end;
      LDecl := self.FTree[AArray].ResolvedDecl;
      LLowExpr := self.FTree.FirstOf(LDecl, NodeRole.LowBound);
      LHighExpr := self.FTree.FirstOf(LDecl, NodeRole.HighBound);
      if (not BoundValue(self.FTree, self.FTarget, LLowExpr, LLow)) or
        (not BoundValue(self.FTree, self.FTarget, LHighExpr, LHigh)) or
        (not self.DoFoldedBits(AIndex, AType, LIndex)) then
        return;
      end;
      // An unsigned index past int64's top reads as negative here: it is above every bound
      // (BoundValue reads no bound that high)
      LAbove := self.DoUnsignedValues(AType) and (LIndex < 0);
      if (not LAbove) and (LIndex >= LLow) and (LIndex <= LHigh) then
        return;
      end;
      self.DoError(AIndex, ADAM_ERR_SEMANTICS_276, ADAM_MSG_SEMANTICS_INDEX_OUTSIDE,
        NoArgs().Str(self.DoExprText(AIndex)).Str(self.DoText(AArray)).Str(
        self.DoExprText(LLowExpr)).Str(self.DoExprText(LHighExpr)));
    end;

    // An index that is an integer (SM0261 otherwise)
    hidden method DoIntegerIndex(const AIndex: int64);
    begin
      if self.DoLost(AIndex) then
        return;
      end;
      if not IsIntegerClass(self.DoClass(self.DoTypeOf(AIndex))) then
        self.DoError(AIndex, ADAM_ERR_SEMANTICS_261, ADAM_MSG_SEMANTICS_INDEX_NOT_INT,
          NoArgs().Str(self.DoText(self.DoTypeOf(AIndex))));
      end;
    end;

    // The property the index AId on AOperand reads or writes (PaskalCPP's rule): X.P[i]
    // when P is an indexed property; X[i] when X is an object, or an own / ref holding one,
    // with a default property (DefaultPropertyOf; never through a weak). Then AId's
    // ResolvedDecl is that property, its type the property's, AIndex converts to the
    // property's index type, and a hidden default property is reached as a hidden member
    // is (SM0019). False when AId is no property access (DoIndex judges it as any index)
    hidden method DoPropertyIndex(const AId: int64; const AOperand: int64; const AIndex: int64): bool;
    var
      LProperty: int64;
      LType: int64;
      LClass: TypeClass;
      LParam: int64;
      LParamType: int64;
      LAccess: int64;
      LObject: int64;
    begin
      LProperty := 0;
      if self.FTree[AOperand].Kind = NodeKind.MemberExpression then
        LProperty := self.FTree[AOperand].ResolvedDecl;
        if (LProperty <> 0) and ((self.FTree[LProperty].Kind <> NodeKind.PropertyDecl) or
          (self.FTree.FirstOf(LProperty, NodeRole.Param) = 0)) then
          // A field, a method, a plain property: its value is indexed as any value
          LProperty := 0;
        end;
      end;
      if LProperty = 0 then
        LType := self.DoTypeOf(AOperand);
        LClass := self.DoClass(LType);
        if (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
          LType := TargetOf(self.FTree, LType);
          LClass := self.DoClass(LType);
        end;
        if LClass <> TypeClass.ObjectType then
          return false;
        end;
        LProperty := DefaultPropertyOf(self.FTree, LType);
        if LProperty = 0 then
          return false;
        end;
        if self.FTree[LProperty].HasFlag(NodeFlag.Hidden) then
          self.DoHiddenReach(AId, AOperand, LProperty);
        end;
      end;
      self.FTree[AId].ResolvedDecl := LProperty;
      self.DoSetType(AId, self.DoMemberType(LProperty));
      // Read through self in its own read: that read again, forever (SM0374, at the index)
      if not self.DoIsAssignTarget(AId) then
        if self.FTree[AOperand].ResolvedDecl = LProperty then
          LAccess := AOperand;
          LObject := self.FTree.FirstOf(AOperand, NodeRole.Operand);
        else
          LAccess := 0;
          LObject := AOperand;
        end;
        if self.DoInOwnAccessor(AId, LObject, LAccess, self.FTree.FirstOf(LProperty, NodeRole.Read)) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_374, ADAM_MSG_SEMANTICS_PROPERTY_OWN_READ,
            NoArgs().Str(self.FTree[LProperty].Text));
        end;
      end;
      // A parameter the parser lost has no type: nothing to convert to (already reported)
      LParam := self.FTree.FirstOf(LProperty, NodeRole.Param);
      LParamType := self.DoDeclType(LParam);
      if (LParamType <> 0) and (not self.DoLost(AIndex)) then
        self.DoConvert(AIndex, LParamType);
      end;
      return true;
    end;

    // X[i]: a property (DoPropertyIndex), an array's element, a string's char, a wstring's
    // wchar, what a typed pointer points at (the untyped ptr is SM0253); anything else SM0260
    hidden method DoIndex(const AId: int64);
    var
      LOperand: int64;
      LIndex: int64;
      LType: int64;
      LClass: TypeClass;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      LIndex := self.FTree.FirstOf(AId, NodeRole.Index);
      self.DoVisit(LOperand);
      self.DoVisit(LIndex);
      if self.DoLost(LOperand) then
        return;
      end;
      if self.DoPropertyIndex(AId, LOperand, LIndex) then
        return;
      end;
      LType := self.DoTypeOf(LOperand);
      LClass := self.DoClass(LType);
      if (LClass = TypeClass.StaticArray) or (LClass = TypeClass.DynamicArray) then
        self.DoArrayIndex(LIndex, LType);
        self.DoSetType(AId, TargetOf(self.FTree, LType));
        return;
      end;
      if (LClass = TypeClass.Text) or (LClass = TypeClass.WideText) or (LClass = TypeClass.Pointer) then
        self.DoIntegerIndex(LIndex);
        if LClass = TypeClass.Text then
          self.DoSetType(AId, self.DoBuiltin("char"));
        else
          if LClass = TypeClass.WideText then
            self.DoSetType(AId, self.DoBuiltin("wchar"));
          else
            self.DoSetType(AId, TargetOf(self.FTree, LType));
          end;
        end;
        return;
      end;
      if LClass = TypeClass.UntypedPointer then
        self.DoUntyped(LOperand);
        return;
      end;
      self.DoError(AId, ADAM_ERR_SEMANTICS_260, ADAM_MSG_SEMANTICS_NOT_INDEXABLE,
        NoArgs().Str(self.DoText(LType)));
    end;

    // The type a member declaration AMember gives its use: a field's, a property's, an
    // embed's type, a method's routine type
    hidden method DoMemberType(const AMember: int64): int64;
    begin
      return self.DoDeclType(AMember);
    end;

    // The aggregate a member access AId on AOperand (of AType) reaches: '.' on a record,
    // an object, an overlay or the object an own / ref holds; '->' through a typed pointer,
    // an own or a ref. 0 (reported) for anything else
    hidden method DoMemberBase(const AId: int64; const AOperand: int64; const AType: int64): int64;
    var
      LClass: TypeClass;
      LOperandText: string;
    begin
      LClass := self.DoClass(AType);
      if (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
        return TargetOf(self.FTree, AType);
      end;
      if self.FTree[AId].HasFlag(NodeFlag.Arrow) then
        if LClass = TypeClass.Pointer then
          return TargetOf(self.FTree, AType);
        end;
        if LClass = TypeClass.UntypedPointer then
          self.DoUntyped(AOperand);
          return 0;
        end;
        self.DoError(AId, ADAM_ERR_SEMANTICS_250, ADAM_MSG_SEMANTICS_OP_ONE,
          NoArgs().Str("->").Str(self.DoText(AType)));
        return 0;
      end;
      if LClass = TypeClass.Pointer then
        LOperandText := self.DoExprText(AOperand);
        self.DoError(AId, ADAM_ERR_SEMANTICS_250, ADAM_MSG_SEMANTICS_DOT_ON_POINTER,
          NoArgs().Str(LOperandText).Str(LOperandText).Str(self.FTree[AId].Text).Str(
          LOperandText).Str(self.FTree[AId].Text));
        return 0;
      end;
      return AType;
    end;

    // X.m / X->m: a unit's member (resolved by ResolveNames), a choices type's value
    // (TColor.Red), else a member of the aggregate X reaches (SM0009 when it has none)
    hidden method DoMember(const AId: int64);
    var
      LOperand: int64;
      LNamed: int64;
      LMember: int64;
      LBase: int64;
      LDecl: int64;
    begin
      if self.FTree[AId].ResolvedUnit <> 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_MODULE_NOT_VALUE,
          NoArgs().Str(self.DoExprText(AId)));
        return;
      end;
      LDecl := self.FTree[AId].ResolvedDecl;
      if LDecl <> 0 then
        if DoIsTypeDecl(self.FTree[LDecl].Kind) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_TYPE_NOT_VALUE,
            NoArgs().Str(self.DoExprText(AId)));
          return;
        end;
        self.DoSetType(AId, self.DoDeclType(LDecl));
        return;
      end;
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      // A unit's member ResolveNames could not resolve: SM0005 / SM0006 is reported at this
      // node already, so neither it nor the unit before it is checked again
      if self.FTree[LOperand].ResolvedUnit <> 0 then
        return;
      end;
      LNamed := self.DoTypeNamed(LOperand);
      if LNamed <> 0 then
        // The operand names a type, not a value: never typed as one
        self.DoFirstVisit(LOperand);
        LMember := MemberOf(self.FTree, LNamed, self.FTree[AId].Text);
        if (LMember <> 0) and (self.FTree[LMember].Kind = NodeKind.ChoiceValue) then
          self.FTree[AId].ResolvedDecl := LMember;
          self.DoSetType(AId, LNamed);
          return;
        end;
        self.DoError(AId, ADAM_ERR_SEMANTICS_009, ADAM_MSG_SEMANTICS_NO_MEMBER,
          NoArgs().Str(self.DoText(LNamed)).Str(self.FTree[AId].Text));
        return;
      end;
      self.DoVisit(LOperand);
      if self.DoLost(LOperand) then
        return;
      end;
      if self.DoClass(self.DoTypeOf(LOperand)) = TypeClass.Varargs then
        self.DoPackMember(AId);
        return;
      end;
      if self.DoClass(self.DoTypeOf(LOperand)) = TypeClass.WeakType then
        self.DoError(AId, ADAM_ERR_SEMANTICS_360, ADAM_MSG_SEMANTICS_WEAK_MEMBER,
          NoArgs().Str(self.DoExprText(LOperand)).Str(self.FTree[AId].Text).Str(
          self.DoExprText(LOperand)));
        return;
      end;
      LBase := self.DoMemberBase(AId, LOperand, self.DoTypeOf(LOperand));
      if LBase = 0 then
        return;
      end;
      LMember := MemberOf(self.FTree, LBase, self.FTree[AId].Text);
      if LMember = 0 then
        LMember := self.DoEmbedMember(AId, LOperand, LBase);
        if LMember < 0 then
          return;
        end;
      end;
      if LMember = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_009, ADAM_MSG_SEMANTICS_NO_MEMBER,
          NoArgs().Str(self.DoText(LBase)).Str(self.FTree[AId].Text));
        return;
      end;
      self.FTree[AId].ResolvedDecl := LMember;
      self.DoSetType(AId, self.DoMemberType(LMember));
      if self.FTree[LMember].HasFlag(NodeFlag.Hidden) then
        self.DoHiddenReach(AId, LOperand, LMember);
      end;
      if self.FTree[LMember].Kind = NodeKind.PropertyDecl then
        self.DoPropertyMember(AId, LOperand, LMember);
      end;
      if (self.FTree[self.DoSkipParens(LOperand)].Kind = NodeKind.ParentExpression) and
        (self.FTree[LMember].Kind = NodeKind.MethodDecl) and self.FTree[LMember].HasFlag(NodeFlag.Abstract) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_340, ADAM_MSG_SEMANTICS_ABSTRACT_CALL,
          NoArgs().Str(self.DoText(self.DoDeclaringType(LMember))).Str(self.FTree[LMember].Text));
      end;
    end;

    // The member access AId on AOperand that names the property AProperty (pcpp O9 / O10):
    // an indexed one is reached through its index, as the operand of X.P[i] (SM0378
    // otherwise; DoPropertyIndex judges the index's own read); a plain one read through
    // self in its own read runs that read again, forever (SM0374). A target of an
    // assignment is its write's (DoWritten)
    hidden method DoPropertyMember(const AId: int64; const AOperand: int64; const AProperty: int64);
    var
      LParent: int64;
    begin
      if self.FTree.FirstOf(AProperty, NodeRole.Param) <> 0 then
        LParent := self.FTree.ParentOf(AId);
        if (LParent = 0) or (self.FTree[LParent].Kind <> NodeKind.IndexExpression) or
          (self.FTree.RoleOf(AId) <> NodeRole.Operand) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_378, ADAM_MSG_SEMANTICS_PROPERTY_NEEDS_INDEX,
            NoArgs().Str(self.FTree[AProperty].Text).Str(self.DoExprText(AId)));
        end;
        return;
      end;
      if self.DoIsAssignTarget(AId) then
        return;
      end;
      if self.DoInOwnAccessor(AId, AOperand, AId, self.FTree.FirstOf(AProperty, NodeRole.Read)) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_374, ADAM_MSG_SEMANTICS_PROPERTY_OWN_READ,
          NoArgs().Str(self.FTree[AProperty].Text));
      end;
    end;

    // The member the access AId on ABase reaches through an embed (EmbedMemberOf), the
    // embed into AId's ResolvedEmbed; 0 when no embed holds the name; -1 (SM0370
    // reported) when two embeds of one level hold it
    hidden method DoEmbedMember(const AId: int64; const AOperand: int64; const ABase: int64): int64;
    var
      LMember: int64;
      LEmbed: int64;
      LSecond: int64;
      LName: string;
    begin
      LName := self.FTree[AId].Text;
      if not EmbedMemberOf(self.FTree, ABase, LName, LMember, LEmbed, LSecond) then
        return 0;
      end;
      if LSecond <> 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_370, ADAM_MSG_SEMANTICS_EMBED_SHARED,
          NoArgs().Str(LName).Str(self.FTree[LEmbed].Text).Str(self.FTree[LSecond].Text).Str(
          self.DoExprText(AOperand)).Str(self.FTree[LEmbed].Text).Str(LName));
        return -1;
      end;
      self.FTree[AId].ResolvedEmbed := LEmbed;
      return LMember;
    end;

    // The declared type whose body declares the member AMember (an anonymous part's
    // member belongs to the type around it); 0 when none does
    hidden const method DoDeclaringType(const AMember: int64): int64;
    var
      LAt: int64;
      LParent: int64;
    begin
      LAt := self.FTree.ParentOf(AMember);
      while LAt <> 0 do
        LParent := self.FTree.ParentOf(LAt);
        if (LParent <> 0) and (self.FTree[LParent].Kind = NodeKind.TypeDecl) then
          return DeclaredTypeOf(self.FTree, LParent);
        end;
        LAt := LParent;
      end;
      return 0;
    end;

    // The object type whose method (or init, done, accessor, operator) holds AId; 0 when
    // none does
    hidden const method DoMethodOwnerType(const AId: int64): int64;
    var
      LBody: int64;
      LParent: int64;
    begin
      LBody := MethodOwnerOf(self.FTree, AId);
      if LBody = 0 then
        return 0;
      end;
      LParent := self.FTree.ParentOf(LBody);
      if (LParent = 0) or (self.FTree[LParent].Kind <> NodeKind.TypeDecl) then
        return 0;
      end;
      return DeclaredTypeOf(self.FTree, LParent);
    end;

    // The hidden member (or accessor) AMember reached by AId on AOperand (BNF sec 4,
    // hidden): only from a method of its declaring type or of a descendant (SM0019,
    // outside), and there only through self, parent or a value of that method's own type
    // or a descendant of it (SM0019, through)
    hidden method DoHiddenReach(const AId: int64; const AOperand: int64; const AMember: int64);
    var
      LLevel: int64;
      LOwner: int64;
      LHeld: int64;
      LClass: TypeClass;
      LKind: NodeKind;
      LName: string;
    begin
      LName := self.FTree[AMember].Text;
      if self.FTree[AMember].Kind = NodeKind.PropertyWrite then
        LName := self.FTree[self.FTree.ParentOf(AMember)].Text;
      end;
      LLevel := self.DoDeclaringType(AMember);
      LOwner := self.DoMethodOwnerType(AId);
      if (LOwner = 0) or ((LOwner <> LLevel) and (not IsBaseOf(self.FTree, LLevel, LOwner))) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_019, ADAM_MSG_SEMANTICS_HIDDEN_OUTSIDE,
          NoArgs().Str(LName).Str(self.DoText(LLevel)).Str(self.DoText(LLevel)));
        return;
      end;
      LKind := self.FTree[self.DoSkipParens(AOperand)].Kind;
      if (LKind = NodeKind.SelfExpression) or (LKind = NodeKind.ParentExpression) then
        return;
      end;
      LHeld := self.DoTypeOf(AOperand);
      LClass := self.DoClass(LHeld);
      if IsPointerClass(LClass) or (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
        LHeld := TargetOf(self.FTree, LHeld);
      end;
      if (LHeld = LOwner) or IsBaseOf(self.FTree, LOwner, LHeld) then
        return;
      end;
      self.DoError(AId, ADAM_ERR_SEMANTICS_019, ADAM_MSG_SEMANTICS_HIDDEN_THROUGH,
        NoArgs().Str(LName).Str(self.DoText(LLevel)).Str(self.DoText(LOwner)).Str(self.DoText(LOwner)));
    end;

    // Every argument of the call AId visited; a type expression there (the parser's type
    // argument after `.next(` / `.get(I,`, BNF sec 6 type arg) is a value only a varargs
    // read takes (DoPackCall), so here it is SM0269
    hidden method DoVisitArguments(const AId: int64);
    var
      LArgument: int64;
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        LArgument := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        self.DoVisit(LArgument);
        if DoIsTypeExpression(self.FTree[LArgument].Kind) then
          self.DoError(LArgument, ADAM_ERR_SEMANTICS_269, ADAM_MSG_SEMANTICS_TYPE_NOT_VALUE,
            NoArgs().Str(self.DoText(CanonicalOf(self.FTree, LArgument))));
        end;
      end;
    end;

    // True when a var parameter of type AParam takes an argument of AArgument: the same
    // type, or a descendant of the record, object or interface AParam (BNF sec 6,
    // PLAN-RECORDS R4; a parameter binds by reference, so nothing is cut down)
    hidden const method DoVarTakes(const AArgument: int64; const AParam: int64): bool;
    var
      LClass: TypeClass;
    begin
      if (AArgument = 0) or (AParam = 0) or (AArgument = AParam) then
        return true;
      end;
      LClass := self.DoClass(AParam);
      if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.ObjectType) and
        (LClass <> TypeClass.InterfaceType) then
        return false;
      end;
      return ReachesAs(self.FTree, AArgument, AParam);
    end;

    // SM0427 (BNF sec 4 owner type, sec 6): an own value AExpr given by value (:=, an
    // initializer, a value argument, a construction's field, a result) moves, never copies:
    // it may be a call's result, a construction or nil, or (AReturn) `return X;` of a local
    // variable or a value parameter of the routine; any other own place would be copied
    // (reported). True when AExpr moves or is no own
    hidden method DoOwnMoves(const AExpr: int64; const AReturn: bool): bool;
    var
      LType: int64;
      LRoot: int64;
      LKind: NodeKind;
      LDecl: int64;
      LRoutine: int64;
    begin
      LType := self.DoTypeOf(AExpr);
      if (LType = 0) or (self.DoClass(LType) <> TypeClass.OwnType) then
        return true;
      end;
      LRoot := self.DoSkipParens(AExpr);
      if LRoot = 0 then
        return true;
      end;
      LKind := self.FTree[LRoot].Kind;
      if (LKind = NodeKind.CallExpression) or (LKind = NodeKind.OwnNew) or
        (LKind = NodeKind.NilLiteral) or (self.FTree[LRoot].ResolvedConst.Kind = ConstKind.Nil) then
        return true;
      end;
      if AReturn then
        LDecl := self.FTree[LRoot].ResolvedDecl;
        LRoutine := self.DoEnclosingRoutine(LRoot);
        if (LDecl <> 0) and (LRoutine <> 0) and (self.DoEnclosingRoutine(LDecl) = LRoutine) then
          if self.FTree[LDecl].Kind = NodeKind.VarDecl then
            return true;
          end;
          if (self.FTree[LDecl].Kind = NodeKind.Param) and
            (not self.FTree[LDecl].HasFlag(NodeFlag.ConstParam)) and
            (not self.FTree[LDecl].HasFlag(NodeFlag.VarParam)) then
            return true;
          end;
        end;
      end;
      self.DoError(AExpr, ADAM_ERR_SEMANTICS_427, ADAM_MSG_SEMANTICS_OWN_COPY,
        NoArgs().Str(self.DoExprText(AExpr)).Str(self.DoText(LType)));
      return false;
    end;

    // The argument AArgument for the value or const parameter AParam of type AParamType:
    // a const parameter of a record, object or interface type binds by reference, so a
    // descendant (an implementer) passes as it is (its ResolvedConvert names the view);
    // anything else converts to the parameter's type
    hidden method DoConstOrValue(const AArgument: int64; const AParam: int64; const AParamType: int64);
    var
      LFrom: int64;
    begin
      LFrom := self.DoTypeOf(AArgument);
      if self.FTree[AParam].HasFlag(NodeFlag.ConstParam) and (LFrom <> 0) and (LFrom <> AParamType) and
        (not self.DoIsNoValue(AArgument)) and self.DoVarTakes(LFrom, AParamType) then
        self.FTree[AArgument].ResolvedConvert := AParamType;
        return;
      end;
      // a value parameter takes its own copy: an own moves into it (a const one binds)
      if not self.FTree[AParam].HasFlag(NodeFlag.ConstParam) then
        self.DoOwnMoves(AArgument, false);
      end;
      self.DoConvert(AArgument, AParamType);
    end;

    // True when the argument AArgument fits the parameter AParam (no report): a var
    // parameter's variable of its type or a descendant, else a value that converts
    hidden method DoArgumentFits(const AArgument: int64; const AParam: int64): bool;
    var
      LParamType: int64;
      LFrom: int64;
    begin
      LParamType := self.DoDeclType(AParam);
      LFrom := self.DoTypeOf(AArgument);
      if self.FTree[AParam].HasFlag(NodeFlag.VarParam) then
        return self.DoIsAssignable(AArgument) and self.DoVarTakes(LFrom, LParamType);
      end;
      if self.DoIsNoValue(AArgument) then
        return false;
      end;
      if self.FTree[AParam].HasFlag(NodeFlag.ConstParam) and self.DoVarTakes(LFrom, LParamType) then
        return true;
      end;
      return self.DoWouldConvert(AArgument, LParamType);
    end;

    // True when the init AInit takes the arguments of AHolder playing ARole (its count,
    // each one fitting its parameter)
    hidden method DoInitTakes(const AInit: int64; const AHolder: int64; const ARole: NodeRole): bool;
    var
      LParams: int64;
      LGiven: int64;
      LI: int64;
    begin
      LParams := self.FTree.CountOf(AInit, NodeRole.Param);
      LGiven := self.FTree.CountOf(AHolder, ARole);
      if LGiven <> LParams then
        return false;
      end;
      for LI := 0 to LGiven - 1 do
        if not self.DoArgumentFits(self.FTree.NthOf(AHolder, ARole, LI),
          self.FTree.NthOf(AInit, NodeRole.Param, LI)) then
          return false;
        end;
      end;
      return true;
    end;

    // The types of the arguments of AHolder playing ARole as a message lists them
    hidden const method DoArgumentTypesText(const AHolder: int64; const ARole: NodeRole): string;
    var
      LText: string;
      LI: int64;
    begin
      LText := "";
      for LI := 0 to self.FTree.CountOf(AHolder, ARole) - 1 do
        if LI > 0 then
          LText := LText + ", ";
        end;
        LText := LText + self.DoText(self.DoTypeOf(self.FTree.NthOf(AHolder, ARole, LI)));
      end;
      return LText;
    end;

    // The object AType is built at AHolder (own / ref T(...), LV: T(...), LV: T) with the
    // arguments AHolder holds in ARole (BNF sec 4 init): an abstract object or an
    // interface is never built (SM0338); with no init declared it takes no arguments
    // (SM0351); else exactly one of its inits takes them (none: SM0351, or SM0349 when
    // none was given; several: SM0352). The init picked goes into AHolder's
    // ResolvedCallee, each argument converting to its parameter. AAt is where a report
    // goes
    hidden method DoBuild(const AHolder: int64; const ARole: NodeRole; const AType: int64;
      const AAt: int64);
    var
      LBody: int64;
      LI: int64;
      LMember: int64;
      LPicked: int64;
      LCount: int64;
      LInits: int64;
      LParam: int64;
      LTypeText: string;
    begin
      if not self.DoValueHolds(AType, AAt) then
        return;
      end;
      LBody := BodyOf(self.FTree, AType);
      LTypeText := self.DoText(AType);
      LPicked := 0;
      LCount := 0;
      LInits := 0;
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if self.FTree[LMember].Kind = NodeKind.InitDecl then
          LInits := LInits + 1;
          if self.DoInitTakes(LMember, AHolder, ARole) then
            LCount := LCount + 1;
            if LPicked = 0 then
              LPicked := LMember;
            end;
          end;
        end;
      end;
      if LInits = 0 then
        if self.FTree.CountOf(AHolder, ARole) > 0 then
          self.DoError(AAt, ADAM_ERR_SEMANTICS_351, ADAM_MSG_SEMANTICS_NO_INIT_DECLARED,
            NoArgs().Str(LTypeText));
        end;
        return;
      end;
      if LCount = 0 then
        if self.FTree.CountOf(AHolder, ARole) = 0 then
          self.DoError(AAt, ADAM_ERR_SEMANTICS_349, ADAM_MSG_SEMANTICS_NO_DEFAULT_INIT,
            NoArgs().Str(LTypeText).Str(LTypeText));
        else
          self.DoError(AAt, ADAM_ERR_SEMANTICS_351, ADAM_MSG_SEMANTICS_NO_INIT_TAKES,
            NoArgs().Str(LTypeText).Str(self.DoArgumentTypesText(AHolder, ARole)));
        end;
        return;
      end;
      if LCount > 1 then
        self.DoError(AAt, ADAM_ERR_SEMANTICS_352, ADAM_MSG_SEMANTICS_INIT_AMBIGUOUS,
          NoArgs().Str(self.DoArgumentTypesText(AHolder, ARole)).Str(LTypeText));
        return;
      end;
      self.FTree[AHolder].ResolvedCallee := LPicked;
      for LI := 0 to self.FTree.CountOf(AHolder, ARole) - 1 do
        LParam := self.FTree.NthOf(LPicked, NodeRole.Param, LI);
        if not self.FTree[LParam].HasFlag(NodeFlag.VarParam) then
          self.DoConstOrValue(self.FTree.NthOf(AHolder, ARole, LI), LParam, self.DoDeclType(LParam));
        end;
      end;
    end;

    // True when a value of AType may be held or built (SM0338 at AAt otherwise): an
    // interface never is, nor an object with an abstract member no level gave a body
    hidden method DoValueHolds(const AType: int64; const AAt: int64): bool;
    var
      LAbstract: int64;
      LOwner: int64;
    begin
      if self.DoClass(AType) = TypeClass.InterfaceType then
        self.DoError(AAt, ADAM_ERR_SEMANTICS_338, ADAM_MSG_SEMANTICS_INTERFACE_VALUE,
          NoArgs().Str(self.DoText(AType)));
        return false;
      end;
      if self.DoClass(AType) <> TypeClass.ObjectType then
        return true;
      end;
      LAbstract := AbstractMemberOf(self.FTree, AType);
      if LAbstract = 0 then
        return true;
      end;
      LOwner := self.FTree.ParentOf(self.FTree.ParentOf(LAbstract));
      self.DoError(AAt, ADAM_ERR_SEMANTICS_338, ADAM_MSG_SEMANTICS_ABSTRACT_VALUE,
        NoArgs().Str(self.DoText(AType)).Str(self.FTree[LOwner].Text).Str(self.FTree[LAbstract].Text));
      return false;
    end;

    // The written signature that names the parameters of a call through the routine value
    // ACallee: the routine type expression its declaration (a variable, constant, parameter,
    // field or property) was written with, directly or through type declarations naming
    // one; 0 when there is none (a value no declaration holds, such as a call's result).
    // A routine type owns no parameter name (Adam.Compiler.Types' DoOwnSignature)
    hidden method DoNamingSignature(const ACallee: int64): int64;
    var
      LDecl: int64;
      LKind: NodeKind;
      LExpr: int64;
      LDepth: int64;
    begin
      LDecl := self.DoCalleeDecl(ACallee);
      if LDecl = 0 then
        return 0;
      end;
      LKind := self.FTree[LDecl].Kind;
      if (LKind <> NodeKind.VarDecl) and (LKind <> NodeKind.ConstDecl) and
        (LKind <> NodeKind.Param) and (LKind <> NodeKind.FieldDecl) and
        (LKind <> NodeKind.PropertyDecl) then
        return 0;
      end;
      LExpr := self.FTree.FirstOf(LDecl, NodeRole.TypeOf);
      LDepth := 0;
      // An alias chain followed to the routine type it names (a cycle stops at the depth)
      while (LExpr <> 0) and (self.FTree[LExpr].Kind = NodeKind.NamedType) and
        (LDepth < ADAM_TYPES_MAX_DEPTH) do
        LDecl := self.FTree[LExpr].ResolvedDecl;
        if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.TypeDecl) then
          return 0;
        end;
        LExpr := self.FTree.FirstOf(LDecl, NodeRole.TypeOf);
        LDepth := LDepth + 1;
      end;
      if (LExpr <> 0) and (self.FTree[LExpr].Kind = NodeKind.RoutineType) then
        return LExpr;
      end;
      return 0;
    end;

    // The name a message gives the parameter number AIndex (from 0) of a call: its name in
    // the written signature ANames, else its position (#1 the first)
    hidden const method DoParamName(const ANames: int64; const AIndex: int64): string;
    begin
      if (ANames <> 0) and (AIndex < self.FTree.CountOf(ANames, NodeRole.Param)) then
        return self.FTree[self.FTree.NthOf(ANames, NodeRole.Param, AIndex)].Text;
      end;
      return "#" + IntToStr(AIndex + 1);
    end;

    // The arguments of the call AId against the parameters of the signature ASig (a
    // routine, a method, a routine type) called as AName: their count (SM0401; at least
    // the fixed ones before a '...'), a var parameter's variable (SM0405, the parameter
    // named by ANames: DoParamName), every other argument converting to its parameter's type
    hidden method DoArguments(const AId: int64; const ASig: int64; const ANames: int64;
      const AName: string);
    var
      LParams: int64;
      LGiven: int64;
      LI: int64;
      LParam: int64;
      LArgument: int64;
      LParamType: int64;
    begin
      self.DoVisitArguments(AId);
      LParams := self.FTree.CountOf(ASig, NodeRole.Param);
      LGiven := self.FTree.CountOf(AId, NodeRole.Argument);
      if self.FTree[ASig].HasFlag(NodeFlag.Variadic) then
        if LGiven < LParams then
          self.DoError(AId, ADAM_ERR_SEMANTICS_401, ADAM_MSG_SEMANTICS_ARG_COUNT_VARIADIC,
            NoArgs().Str(AName).Int(LParams).Int(LGiven));
          return;
        end;
      else
        if LGiven <> LParams then
          self.DoError(AId, ADAM_ERR_SEMANTICS_401, ADAM_MSG_SEMANTICS_ARG_COUNT,
            NoArgs().Str(AName).Int(LParams).Int(LGiven));
          return;
        end;
      end;
      for LI := 0 to LGiven - 1 do
        LArgument := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        if LI >= LParams then
          // A variadic argument travels with its own type
          if self.DoIsNoValue(LArgument) then
            self.DoNoValue(LArgument);
          end;
        else
          LParam := self.FTree.NthOf(ASig, NodeRole.Param, LI);
          LParamType := self.DoDeclType(LParam);
          if self.FTree[LParam].HasFlag(NodeFlag.VarParam) then
            // A var parameter binds to its argument's address: a bitfield has none (SM0262)
            if not self.DoBitfieldAddress(LArgument) then
              // a property is no variable: its write runs, never a store through an address
              if (not self.DoIsAssignable(LArgument)) or (self.DoPropertyOf(LArgument) <> 0) or
                (not self.DoVarTakes(self.DoTypeOf(LArgument), LParamType)) then
                self.DoError(LArgument, ADAM_ERR_SEMANTICS_405, ADAM_MSG_SEMANTICS_VAR_PARAM,
                  NoArgs().Str(self.DoParamName(ANames, LI)).Str(self.DoText(LParamType)));
              end;
            end;
            // A var argument is written by the call
            self.DoIteratorWritten(LArgument);
          else
            self.DoConstOrValue(LArgument, LParam, LParamType);
          end;
        end;
      end;
    end;

    // A const method calls through self (self.M(), self.F.M() of a field held by value)
    // only methods that are const themselves (SM0388), as does a property's read, whose
    // self is const too (SM0373): the callee ACallee of the method ASig
    hidden method DoConstMethodCall(const ACallee: int64; const ASig: int64);
    var
      LMethod: int64;
    begin
      if (self.FTree[ASig].Kind <> NodeKind.MethodDecl) or self.FTree[ASig].HasFlag(NodeFlag.ConstMethod) or
        (self.FTree[ACallee].Kind <> NodeKind.MemberExpression) then
        return;
      end;
      LMethod := self.DoEnclosingRoutine(ACallee);
      if LMethod = 0 then
        return;
      end;
      if not self.DoThroughSelf(self.FTree.FirstOf(ACallee, NodeRole.Operand)) then
        return;
      end;
      if (self.FTree[LMethod].Kind = NodeKind.MethodDecl) and self.FTree[LMethod].HasFlag(NodeFlag.ConstMethod) then
        self.DoError(ACallee, ADAM_ERR_SEMANTICS_388, ADAM_MSG_SEMANTICS_CONST_METHOD_CALL,
          NoArgs().Str(self.FTree[LMethod].Text).Str(self.DoExprText(ACallee)));
        return;
      end;
      if self.FTree[LMethod].Kind = NodeKind.PropertyRead then
        self.DoError(ACallee, ADAM_ERR_SEMANTICS_373, ADAM_MSG_SEMANTICS_PROPERTY_READ_CALL,
          NoArgs().Str(self.FTree[self.FTree.ParentOf(LMethod)].Text).Str(self.DoExprText(ACallee)));
      end;
    end;

    // The parameter AIndex of ASig (0 past its last: a '...' takes the argument)
    hidden const method DoParamAt(const ASig: int64; const AIndex: int64): int64;
    begin
      if AIndex < self.FTree.CountOf(ASig, NodeRole.Param) then
        return self.FTree.NthOf(ASig, NodeRole.Param, AIndex);
      end;
      return 0;
    end;

    // True when a value of AFrom reaches ATo by a C++ promotion: an integer below 32
    // bits, a bool, a char or a wchar to int32; float32 to float64
    hidden const method DoIsPromotion(const AFrom: int64; const ATo: int64): bool;
    var
      LClass: TypeClass;
    begin
      LClass := self.DoClass(AFrom);
      if ATo = self.DoBuiltin("int32") then
        if IsIntegerClass(LClass) then
          return IntBits(self.FTree, AFrom) < 32;
        end;
        return (LClass = TypeClass.Boolean) or (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar);
      end;
      return (ATo = self.DoBuiltin("float64")) and (AFrom = self.DoBuiltin("float32"));
    end;

    // How the argument AArgument fits the parameter AParam, by C++'s ranks: 0 exact (the
    // same type), 1 a promotion, 2 a conversion (a descendant for a var parameter, a
    // constant that fits, a literal's type-driven form), 3 taken by a '...' (AParam 0)
    hidden method DoArgumentRank(const AArgument: int64; const AParam: int64): int64;
    var
      LFrom: int64;
      LTo: int64;
    begin
      if AParam = 0 then
        return 3;
      end;
      LFrom := self.DoTypeOf(AArgument);
      LTo := self.DoDeclType(AParam);
      if LFrom = LTo then
        return 0;
      end;
      if (not self.FTree[AParam].HasFlag(NodeFlag.VarParam)) and self.DoIsPromotion(LFrom, LTo) then
        return 1;
      end;
      return 2;
    end;

    // True when the routine ACandidate takes the call AId's arguments: their count (at
    // least its fixed parameters before a '...'), each fitting its parameter (DoBuild's
    // test, DoArgumentFits)
    hidden method DoOverloadTakes(const AId: int64; const ACandidate: int64): bool;
    var
      LParams: int64;
      LGiven: int64;
      LI: int64;
    begin
      LParams := self.FTree.CountOf(ACandidate, NodeRole.Param);
      LGiven := self.FTree.CountOf(AId, NodeRole.Argument);
      if self.FTree[ACandidate].HasFlag(NodeFlag.Variadic) then
        if LGiven < LParams then
          return false;
        end;
      else
        if LGiven <> LParams then
          return false;
        end;
      end;
      for LI := 0 to LGiven - 1 do
        if (LI < LParams) and
          (not self.DoArgumentFits(self.FTree.NthOf(AId, NodeRole.Argument, LI), self.FTree.NthOf(ACandidate, NodeRole.Param, LI))) then
          return false;
        end;
      end;
      return true;
    end;

    // True when ACandidate fits the call AId better than AOther (C++'s rule): no argument
    // ranks worse, one ranks better
    hidden method DoBetterOverload(const AId: int64; const ACandidate: int64; const AOther: int64): bool;
    var
      LI: int64;
      LArgument: int64;
      LMine: int64;
      LTheirs: int64;
      LBetter: bool;
    begin
      LBetter := false;
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        LArgument := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        LMine := self.DoArgumentRank(LArgument, self.DoParamAt(ACandidate, LI));
        LTheirs := self.DoArgumentRank(LArgument, self.DoParamAt(AOther, LI));
        if LMine > LTheirs then
          return false;
        end;
        if LMine < LTheirs then
          LBetter := true;
        end;
      end;
      return LBetter;
    end;

    // True when the routine ACandidate is a member of the overload set named AName in its
    // scope that takes the call AId's arguments
    hidden method DoOverloadFits(const AId: int64; const ACandidate: int64; const AName: string): bool;
    begin
      return (self.FTree[ACandidate].Kind = NodeKind.RoutineDecl) and
        (self.FTree[ACandidate].Text = AName) and self.DoOverloadTakes(AId, ACandidate);
    end;

    // The member of the overload set ASig belongs to (its scope's routines of its name,
    // forwards left out: each pairs with its routine) that the call AId runs, by BNF sec 3:
    // only the members that take the arguments by Adam's conversions (none: SM0402), the
    // one better than every other by C++'s ranks (none: SM0403, Adam's own). 0 after a
    // report
    hidden method DoPickOverload(const AId: int64; const ACallee: int64; const ASig: int64): int64;
    var
      LScope: int64;
      LName: string;
      LI: int64;
      LJ: int64;
      LCandidate: int64;
      LOther: int64;
      LFits: int64;
      LBest: bool;
    begin
      LScope := self.FTree.ParentOf(ASig);
      LName := self.FTree[ASig].Text;
      LFits := 0;
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        if self.DoOverloadFits(AId, self.FTree.ChildAt(LScope, LI), LName) then
          LFits := LFits + 1;
        end;
      end;
      if LFits = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_402, ADAM_MSG_SEMANTICS_OVERLOAD_NONE,
          NoArgs().Str(self.DoExprText(ACallee)).Str(self.DoArgumentTypesText(AId, NodeRole.Argument)));
        return 0;
      end;
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LCandidate := self.FTree.ChildAt(LScope, LI);
        if self.DoOverloadFits(AId, LCandidate, LName) then
          LBest := true;
          for LJ := 0 to self.FTree.ChildCount(LScope) - 1 do
            LOther := self.FTree.ChildAt(LScope, LJ);
            if (LOther <> LCandidate) and self.DoOverloadFits(AId, LOther, LName) and
              (not self.DoBetterOverload(AId, LCandidate, LOther)) then
              LBest := false;
              leave;
            end;
          end;
          if LBest then
            return LCandidate;
          end;
        end;
      end;
      self.DoError(AId, ADAM_ERR_SEMANTICS_403, ADAM_MSG_SEMANTICS_OVERLOAD_AMBIGUOUS,
        NoArgs().Str(self.DoArgumentTypesText(AId, NodeRole.Argument)).Str(self.DoExprText(ACallee)));
      return 0;
    end;

    // A call AId of the routine or method ASig (its callee ACallee): the arguments
    // checked, the return type its type (none: a procedure). An overload set's call runs
    // the member DoPickOverload picks, written as the callee's ResolvedDecl (the name then
    // means that member); after a report its arguments are only visited
    hidden method DoRoutineCall(const AId: int64; const ACallee: int64; const ASig: int64);
    var
      LSig: int64;
    begin
      LSig := ASig;
      if self.DoIsOverloaded(ASig) then
        self.DoVisitArguments(AId);
        LSig := self.DoPickOverload(AId, ACallee, ASig);
        if LSig = 0 then
          return;
        end;
        self.FTree[ACallee].ResolvedDecl := LSig;
        self.DoSetType(ACallee, RoutineTypeOf(self.FTree, LSig));
      end;
      if self.DoTypeOf(ACallee) = 0 then
        self.DoSetType(ACallee, RoutineTypeOf(self.FTree, LSig));
      end;
      self.DoConstMethodCall(ACallee, LSig);
      self.DoArguments(AId, LSig, LSig, self.DoExprText(ACallee));
      self.DoSetType(AId, CanonicalOf(self.FTree, self.FTree.FirstOf(LSig, NodeRole.ReturnType)));
    end;

    // True when AParam, a child in a routine's Param role, is a parameter the parser lost
    // (it was reported): a skipped span, or a Param whose type never came
    hidden method DoLostParam(const AParam: int64): bool;
    begin
      return (self.FTree[AParam].Kind <> NodeKind.Param) or (self.FTree.FirstOf(AParam, NodeRole.TypeOf) = 0);
    end;

    // True when the routine ARoutine has a parameter the parser lost
    hidden method DoLostParams(const ARoutine: int64): bool;
    var
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ARoutine, NodeRole.Param) - 1 do
        if self.DoLostParam(self.FTree.NthOf(ARoutine, NodeRole.Param, LI)) then
          return true;
        end;
      end;
      return false;
    end;

    // True when the routines AFirst and ASecond have the same parameter count and each
    // parameter the same type. ALostMatches: a parameter the parser lost (it was reported)
    // matches any, as a forward pairs with its full declaration (the modes, names and the
    // rest are facts judged after the pair, DoRoutineFact); false keeps it a type of its
    // own, so a parse error starts no SM0324
    hidden method DoSameParamTypes(const AFirst: int64; const ASecond: int64; const ALostMatches: bool): bool;
    var
      LI: int64;
      LFirst: int64;
      LSecond: int64;
    begin
      if self.FTree.CountOf(AFirst, NodeRole.Param) <> self.FTree.CountOf(ASecond, NodeRole.Param) then
        return false;
      end;
      for LI := 0 to self.FTree.CountOf(AFirst, NodeRole.Param) - 1 do
        LFirst := self.FTree.NthOf(AFirst, NodeRole.Param, LI);
        LSecond := self.FTree.NthOf(ASecond, NodeRole.Param, LI);
        if ALostMatches and (self.DoLostParam(LFirst) or self.DoLostParam(LSecond)) then
          skip;
        end;
        if self.DoDeclType(LFirst) <> self.DoDeclType(LSecond) then
          return false;
        end;
      end;
      return true;
    end;

    // True when the routines AFirst and ASecond have the same parameter types (count, '...'
    // and each type: names, var / const, linkage and return type make no overload, BNF
    // sec 3)
    hidden method DoSameParameters(const AFirst: int64; const ASecond: int64): bool;
    begin
      if self.FTree[AFirst].HasFlag(NodeFlag.Variadic) <> self.FTree[ASecond].HasFlag(NodeFlag.Variadic) then
        return false;
      end;
      return self.DoSameParamTypes(AFirst, ASecond, false);
    end;

    // A routine declaration AId with a body that is variadic with C linkage (by meaning:
    // Types.IsCppSignature) needs a fixed parameter before '...' (BNF sec 4: C reads the
    // extra arguments from past the last fixed one), else SM0325 at it; an external one may
    // have none
    hidden method DoVariadicFixed(const AId: int64);
    begin
      if not self.FTree[AId].HasFlag(NodeFlag.Variadic) then
        return;
      end;
      if (self.FTree.FirstOf(AId, NodeRole.Body) = 0) or IsCppSignature(self.FTree, AId) then
        return;
      end;
      if self.FTree.CountOf(AId, NodeRole.Param) = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_325, ADAM_MSG_SEMANTICS_VARIADIC_FIXED,
          NoArgs().Str(self.FTree[AId].Text));
      end;
    end;

    // A routine declaration AId: an earlier routine of its name in its scope with the same
    // parameter types makes it no overload (SM0324 at it, once)
    hidden method DoOverloadDeclared(const AId: int64);
    var
      LScope: int64;
      LI: int64;
      LEarlier: int64;
    begin
      LScope := self.FTree.ParentOf(AId);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LEarlier := self.FTree.ChildAt(LScope, LI);
        if LEarlier = AId then
          return;
        end;
        if (self.FTree[LEarlier].Kind = NodeKind.RoutineDecl) and
          (self.FTree[LEarlier].Text = self.FTree[AId].Text) and self.DoSameParameters(LEarlier, AId) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_324, ADAM_MSG_SEMANTICS_OVERLOAD_SAME,
            NoArgs().Str(self.FTree[AId].Text));
          return;
        end;
      end;
    end;

    // The first parameter the paired forward AForward and full declaration AFull spell
    // differently: its name, then its mode ("" when none; the counts are equal, they
    // paired; a parameter the parser lost is skipped, it was reported)
    hidden method DoParamFact(const AForward: int64; const AFull: int64): string;
    var
      LI: int64;
      LForward: int64;
      LFull: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AForward, NodeRole.Param) - 1 do
        LForward := self.FTree.NthOf(AForward, NodeRole.Param, LI);
        LFull := self.FTree.NthOf(AFull, NodeRole.Param, LI);
        if self.DoLostParam(LForward) or self.DoLostParam(LFull) then
          skip;
        end;
        if self.FTree[LForward].Text <> self.FTree[LFull].Text then
          return NoArgs().Int(LI + 1).Str(self.FTree[LForward].Text).Str(self.FTree[LFull].Text).Fill(
            ADAM_MSG_SEMANTICS_FACT_PARAM_NAME);
        end;
        if (self.FTree[LForward].HasFlag(NodeFlag.VarParam) <> self.FTree[LFull].HasFlag(NodeFlag.VarParam)) or
          (self.FTree[LForward].HasFlag(NodeFlag.ConstParam) <> self.FTree[LFull].HasFlag(NodeFlag.ConstParam)) then
          return NoArgs().Str(self.FTree[LForward].Text).Fill(ADAM_MSG_SEMANTICS_FACT_PARAM_MODE);
        end;
      end;
      return "";
    end;

    // The first fact the paired forward AForward and full declaration AFull disagree on
    // (BNF sec 3): the linkage by meaning (clink written or not is C, Types.IsCppSignature),
    // the export, '...', the parameters, the return type; "" when they match
    hidden method DoRoutineFact(const AForward: int64; const AFull: int64): string;
    var
      LFact: string;
      LForwardReturn: int64;
      LFullReturn: int64;
    begin
      if IsCppSignature(self.FTree, AForward) <> IsCppSignature(self.FTree, AFull) then
        return ADAM_MSG_SEMANTICS_FACT_LINKAGE;
      end;
      if self.FTree[AForward].HasFlag(NodeFlag.Public) <> self.FTree[AFull].HasFlag(NodeFlag.Public) then
        return ADAM_MSG_SEMANTICS_FACT_PUBLIC;
      end;
      if self.FTree[AForward].HasFlag(NodeFlag.Variadic) <> self.FTree[AFull].HasFlag(NodeFlag.Variadic) then
        return ADAM_MSG_SEMANTICS_FACT_VARIADIC;
      end;
      // A call of the forward ends the path as a call of the full does (DoIsEndingCall)
      if self.FTree[AForward].HasFlag(NodeFlag.NoReturn) <> self.FTree[AFull].HasFlag(NodeFlag.NoReturn) then
        return ADAM_MSG_SEMANTICS_FACT_NORETURN;
      end;
      LFact := self.DoParamFact(AForward, AFull);
      if LFact <> "" then
        return LFact;
      end;
      LForwardReturn := self.FTree.FirstOf(AForward, NodeRole.ReturnType);
      LFullReturn := self.FTree.FirstOf(AFull, NodeRole.ReturnType);
      if (LForwardReturn = 0) <> (LFullReturn = 0) then
        return ADAM_MSG_SEMANTICS_FACT_RETURN;
      end;
      if (LForwardReturn <> 0) and
        (CanonicalOf(self.FTree, LForwardReturn) <> CanonicalOf(self.FTree, LFullReturn)) then
        return ADAM_MSG_SEMANTICS_FACT_RETURN;
      end;
      return "";
    end;

    // A full routine AId completes the first earlier forward routine of its scope with its
    // name and parameter types that has none (routines pair by signature): the forward's
    // ResolvedDecl is AId, so whatever names the forward runs AId. A fact the two disagree
    // on is SM0306 at AId. A full that pairs with no forward is an overload of its own
    hidden method DoPairRoutine(const AId: int64);
    var
      LScope: int64;
      LI: int64;
      LForward: int64;
      LFact: string;
    begin
      LScope := self.FTree.ParentOf(AId);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LForward := self.FTree.ChildAt(LScope, LI);
        if LForward = AId then
          return;
        end;
        if (self.FTree[LForward].Kind = NodeKind.ForwardRoutine) and
          (self.FTree[LForward].ResolvedDecl = 0) and
          (self.FTree[LForward].Text = self.FTree[AId].Text) and
          self.DoSameParamTypes(LForward, AId, true) then
          self.FTree[LForward].ResolvedDecl := AId;
          LFact := self.DoRoutineFact(LForward, AId);
          if LFact <> "" then
            self.DoError(AId, ADAM_ERR_SEMANTICS_306, ADAM_MSG_SEMANTICS_FORWARD_DIFFER,
              NoArgs().Str(self.FTree[AId].Text).Str(LFact).Int(int64(self.FTree[LForward].Place.Line)));
          end;
          return;
        end;
      end;
    end;

    // A forward type AId after a full declaration of its name in its scope declares
    // nothing (SM0304): it names that full (its ResolvedDecl), so no SM0303 follows
    hidden method DoForwardType(const AId: int64);
    var
      LScope: int64;
      LI: int64;
      LFull: int64;
    begin
      LScope := self.FTree.ParentOf(AId);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LFull := self.FTree.ChildAt(LScope, LI);
        if LFull = AId then
          return;
        end;
        if (self.FTree[LFull].Kind = NodeKind.TypeDecl) and (self.FTree[LFull].Text = self.FTree[AId].Text) then
          self.FTree[AId].ResolvedDecl := LFull;
          self.DoError(AId, ADAM_ERR_SEMANTICS_304, ADAM_MSG_SEMANTICS_FORWARD_AFTER_FULL,
            NoArgs().Str(self.FTree[AId].Text).Int(int64(self.FTree[LFull].Place.Line)));
          return;
        end;
      end;
    end;

    // A full type declaration AId completes every earlier forward type of its name in its
    // scope that has none (types pair by name: each forward's ResolvedDecl is AId). The
    // first such forward is the one its kind (SM0305: a record, object, interface or
    // overlay completes a forward) and its export (SM0306) are judged against
    hidden method DoFullType(const AId: int64);
    var
      LScope: int64;
      LI: int64;
      LForward: int64;
      LFirst: int64;
      LBody: int64;
      LKind: NodeKind;
    begin
      LScope := self.FTree.ParentOf(AId);
      LFirst := 0;
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LForward := self.FTree.ChildAt(LScope, LI);
        if LForward = AId then
          leave;
        end;
        if (self.FTree[LForward].Kind = NodeKind.ForwardType) and
          (self.FTree[LForward].ResolvedDecl = 0) and
          (self.FTree[LForward].Text = self.FTree[AId].Text) then
          self.FTree[LForward].ResolvedDecl := AId;
          if LFirst = 0 then
            LFirst := LForward;
          end;
        end;
      end;
      if LFirst = 0 then
        return;
      end;
      LBody := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      if LBody <> 0 then
        LKind := self.FTree[LBody].Kind;
        if (LKind <> NodeKind.RecordType) and (LKind <> NodeKind.ObjectType) and
          (LKind <> NodeKind.InterfaceType) and (LKind <> NodeKind.OverlayType) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_305, ADAM_MSG_SEMANTICS_FORWARD_KIND,
            NoArgs().Str(self.FTree[AId].Text).Int(int64(self.FTree[LFirst].Place.Line)));
        end;
      end;
      if self.FTree[LFirst].HasFlag(NodeFlag.Public) <> self.FTree[AId].HasFlag(NodeFlag.Public) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_306, ADAM_MSG_SEMANTICS_FORWARD_DIFFER,
          NoArgs().Str(self.FTree[AId].Text).Str(ADAM_MSG_SEMANTICS_FACT_PUBLIC).Int(
          int64(self.FTree[LFirst].Place.Line)));
      end;
    end;

    // True when the forward routine AForward, or a full routine of its name in its scope,
    // has a parameter the parser lost (it was reported): the pair cannot be judged, so the
    // forward is not reported unpaired
    hidden method DoLostPair(const AForward: int64): bool;
    var
      LScope: int64;
      LI: int64;
      LChild: int64;
    begin
      if self.DoLostParams(AForward) then
        return true;
      end;
      LScope := self.FTree.ParentOf(AForward);
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if (self.FTree[LChild].Kind = NodeKind.RoutineDecl) and
          (self.FTree[LChild].Text = self.FTree[AForward].Text) and self.DoLostParams(LChild) then
          return true;
        end;
      end;
      return false;
    end;

    // The full routine of the forward routine AForward's name in its scope closest to it
    // (the SM0307 line); 0 when the scope has none
    hidden method DoNearestFull(const AForward: int64): int64;
    var
      LScope: int64;
      LI: int64;
      LAt: int64;
      LBest: int64;
      LBestDistance: int64;
      LDistance: int64;
      LChild: int64;
    begin
      LScope := self.FTree.ParentOf(AForward);
      LAt := 0;
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        if self.FTree.ChildAt(LScope, LI) = AForward then
          LAt := LI;
        end;
      end;
      LBest := 0;
      LBestDistance := 0;
      for LI := 0 to self.FTree.ChildCount(LScope) - 1 do
        LChild := self.FTree.ChildAt(LScope, LI);
        if (self.FTree[LChild].Kind = NodeKind.RoutineDecl) and
          (self.FTree[LChild].Text = self.FTree[AForward].Text) then
          // Closest by list distance; the earlier one on a tie (list order)
          LDistance := LI - LAt;
          if LDistance < 0 then
            LDistance := -LDistance;
          end;
          if (LBest = 0) or (LDistance < LBestDistance) then
            LBest := LChild;
            LBestDistance := LDistance;
          end;
        end;
      end;
      return LBest;
    end;

    // Every forward visited that no full declaration completed, once the program is
    // typed: a forward type is SM0303, a forward routine SM0307 (the nearest full
    // routine of its name named). Silent on a nameless forward and on a forward routine
    // whose pair has a parameter the parser lost (DoLostPair): the parser reported those
    hidden method DoUnpairedForwards();
    var
      LI: int64;
      LForward: int64;
      LNearest: int64;
    begin
      for LI := 0 to self.FForwards.Count - 1 do
        LForward := self.FForwards[LI];
        if (self.FTree[LForward].ResolvedDecl = 0) and (self.FTree[LForward].Text <> "") then
          if self.FTree[LForward].Kind = NodeKind.ForwardType then
            self.DoError(LForward, ADAM_ERR_SEMANTICS_303, ADAM_MSG_SEMANTICS_FORWARD_NO_FULL,
              NoArgs().Str(self.FTree[LForward].Text));
          else
            if not self.DoLostPair(LForward) then
              LNearest := self.DoNearestFull(LForward);
              if LNearest = 0 then
                self.DoError(LForward, ADAM_ERR_SEMANTICS_307, ADAM_MSG_SEMANTICS_ROUTINE_NO_FULL,
                  NoArgs().Str(self.FTree[LForward].Text));
              else
                self.DoError(LForward, ADAM_ERR_SEMANTICS_307, ADAM_MSG_SEMANTICS_ROUTINE_NO_FULL_NEAREST,
                  NoArgs().Str(self.FTree[LForward].Text).Int(int64(self.FTree[LNearest].Place.Line)));
              end;
            end;
          end;
        end;
      end;
    end;

    // The value AArgument cast to AType (a type cast, T(x) on a declared type): SM0264
    // when no cast takes it
    hidden method DoCastValue(const AArgument: int64; const AType: int64);
    var
      LFrom: int64;
    begin
      if (AArgument = 0) or (AType = 0) or self.DoLost(AArgument) then
        return;
      end;
      LFrom := self.DoTypeOf(AArgument);
      if self.DoCastTakes(LFrom, AType) then
        return;
      end;
      if self.DoLiteralTakes(self.DoSkipParens(AArgument), AType) then
        self.FTree[AArgument].ResolvedConvert := AType;
        return;
      end;
      self.DoError(AArgument, ADAM_ERR_SEMANTICS_264, ADAM_MSG_SEMANTICS_NO_CAST,
        NoArgs().Str(self.DoText(LFrom)).Str(self.DoText(AType)));
    end;

    // A call AId whose callee names the type AType: a cast (BNF sec 6, TColor(N)), one
    // argument (SM0412)
    hidden method DoCastCall(const AId: int64; const AType: int64; const AName: string);
    var
      LGiven: int64;
    begin
      self.DoVisitArguments(AId);
      self.DoSetType(AId, AType);
      LGiven := self.FTree.CountOf(AId, NodeRole.Argument);
      if LGiven <> 1 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_412, ADAM_MSG_SEMANTICS_CAST_ARGS,
          NoArgs().Str(AName).Int(LGiven));
        return;
      end;
      self.DoCastValue(self.FTree.FirstOf(AId, NodeRole.Argument), AType);
    end;

    // SM0409 at the intrinsic call AId named AName: it takes ASignature
    hidden method DoBadIntrinsic(const AId: int64; const AName: string; const ASignature: string);
    begin
      self.DoError(AId, ADAM_ERR_SEMANTICS_409, ADAM_MSG_SEMANTICS_INTRINSIC_SIG,
        NoArgs().Str(AName).Str(ASignature));
    end;

    // True when the intrinsic call AId has ACount arguments and the AIndex-th converts to
    // AType (no report); AType 0 checks the count only
    hidden const method DoIntrinsicArg(const AId: int64; const ACount: int64; const AIndex: int64;
      const AType: int64): bool;
    var
      LArgument: int64;
    begin
      if self.FTree.CountOf(AId, NodeRole.Argument) <> ACount then
        return false;
      end;
      if AType = 0 then
        return true;
      end;
      LArgument := self.FTree.NthOf(AId, NodeRole.Argument, AIndex);
      if self.DoIsNoValue(LArgument) then
        return false;
      end;
      return self.DoWouldConvert(LArgument, AType);
    end;

    // The AIndex-th argument of the intrinsic call AId converted to AType (its conversion
    // written; DoIntrinsicArg said it converts)
    hidden method DoIntrinsicConvert(const AId: int64; const AIndex: int64; const AType: int64);
    begin
      self.DoConvert(self.FTree.NthOf(AId, NodeRole.Argument, AIndex), AType);
    end;

    // The class of the AIndex-th argument of the intrinsic call AId
    hidden const method DoArgClass(const AId: int64; const AIndex: int64): TypeClass;
    begin
      return self.DoClass(self.DoTypeOf(self.FTree.NthOf(AId, NodeRole.Argument, AIndex)));
    end;

    // size(T): a type expression or a name of a type; an int64
    hidden method DoSizeOf(const AId: int64);
    var
      LArgument: int64;
    begin
      self.DoSetType(AId, self.DoBuiltin("int64"));
      if self.FTree.CountOf(AId, NodeRole.Argument) <> 1 then
        self.DoVisitArguments(AId);
        self.DoBadIntrinsic(AId, "size", ADAM_MSG_SEMANTICS_SIG_TYPE);
        return;
      end;
      LArgument := self.FTree.FirstOf(AId, NodeRole.Argument);
      if DoIsTypeExpression(self.FTree[LArgument].Kind) then
        self.DoVisit(LArgument);
        return;
      end;
      if self.DoTypeNamed(LArgument) <> 0 then
        self.DoFirstVisit(LArgument);
        return;
      end;
      self.DoVisit(LArgument);
      self.DoBadIntrinsic(AId, "size", ADAM_MSG_SEMANTICS_SIG_TYPE);
    end;

    // True when AExpr is a place an atomic acts on (BNF sec 7, H4t2): assignable storage (a
    // property has no address: refused), of int32, int64, uint32 or uint64, or of ptr when
    // APointer (atomicadd takes no ptr)
    hidden const method DoIsAtomicPlace(const AExpr: int64; const APointer: bool): bool;
    var
      LAt: int64;
      LDecl: int64;
      LType: int64;
      LClass: TypeClass;
      LName: string;
    begin
      if self.DoIsNoValue(AExpr) or (not self.DoIsAssignable(AExpr)) then
        return false;
      end;
      LAt := self.DoSkipParens(AExpr);
      LDecl := self.FTree[LAt].ResolvedDecl;
      if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
        return false;
      end;
      LType := self.DoTypeOf(AExpr);
      LClass := self.DoClass(LType);
      if LClass = TypeClass.UntypedPointer then
        return APointer;
      end;
      if not IsIntegerClass(LClass) then
        return false;
      end;
      LName := self.FTree[LType].Text;
      return (LName = "int32") or (LName = "int64") or (LName = "uint32") or (LName = "uint64");
    end;

    // An atomic intrinsic (BNF sec 7, H4t2): its first argument a place (DoIsAtomicPlace),
    // every other one converted to the place's type; atomiccas is a bool, atomicstore has
    // no value, the others are the place's type. SM0409 naming the signature otherwise
    hidden method DoAtomicIntrinsic(const AId: int64; const AName: string);
    var
      LCount: int64;
      LPlace: int64;
      LType: int64;
      LI: int64;
    begin
      LCount := DoAtomicArity(AName);
      LType := 0;
      if self.FTree.CountOf(AId, NodeRole.Argument) = LCount then
        LPlace := self.FTree.FirstOf(AId, NodeRole.Argument);
        if self.DoIsAtomicPlace(LPlace, AName <> "atomicadd") then
          LType := self.DoTypeOf(LPlace);
        end;
      end;
      if AName = "atomiccas" then
        self.DoSetType(AId, self.DoBuiltin("bool"));
      end;
      if (LType <> 0) and (AName <> "atomiccas") and (AName <> "atomicstore") then
        self.DoSetType(AId, LType);
      end;
      if LType = 0 then
        self.DoBadIntrinsic(AId, AName, DoAtomicSignature(AName));
        return;
      end;
      for LI := 1 to LCount - 1 do
        if not self.DoIntrinsicArg(AId, LCount, LI, LType) then
          self.DoBadIntrinsic(AId, AName, DoAtomicSignature(AName));
          return;
        end;
      end;
      for LI := 1 to LCount - 1 do
        self.DoIntrinsicConvert(AId, LI, LType);
      end;
    end;

    // The value intrinsics' types and arguments (BNF sec 7, PLAN-INTRINSICS I1): an
    // argument takes the type the runtime takes by the no-hidden-conversion rule (SM0409
    // naming the signature otherwise)
    hidden method DoValueIntrinsic(const AId: int64; const AName: string);
    var
      LInt32: int64;
      LInt64: int64;
      LString: int64;
      LClass: TypeClass;
    begin
      if DoIsAtomicIntrinsic(AName) then
        self.DoAtomicIntrinsic(AId, AName);
        return;
      end;
      LInt32 := self.DoBuiltin("int32");
      LInt64 := self.DoBuiltin("int64");
      LString := self.DoBuiltin("string");
      if AName = "len" then
        self.DoSetType(AId, LInt64);
        if self.DoIntrinsicArg(AId, 1, 0, 0) then
          LClass := self.DoArgClass(AId, 0);
          if (LClass = TypeClass.Text) or (LClass = TypeClass.WideText) or
            (LClass = TypeClass.StaticArray) or (LClass = TypeClass.DynamicArray) or
            (LClass = TypeClass.Unknown) then
            return;
          end;
        end;
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_LENGTH);
        return;
      end;
      // FormatStr(F, ..) is the string print(F, ..) writes: print's format and arguments,
      // checked as print's (M3.8f2b); F is no optional
      if AName = "FormatStr" then
        self.DoSetType(AId, LString);
        if self.FTree.CountOf(AId, NodeRole.Argument) = 0 then
          self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_FORMAT);
          return;
        end;
        self.DoPrintCall(AId);
        return;
      end;
      if AName = "utf8" then
        self.DoSetType(AId, LString);
        if self.DoIntrinsicArg(AId, 1, 0, self.DoBuiltin("wstring")) then
          self.DoIntrinsicConvert(AId, 0, self.DoBuiltin("wstring"));
          return;
        end;
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_WSTRING);
        return;
      end;
      if AName = "paramstr" then
        self.DoSetType(AId, LString);
        if self.DoIntrinsicArg(AId, 1, 0, LInt32) then
          self.DoIntrinsicConvert(AId, 0, LInt32);
          return;
        end;
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_INT32);
        return;
      end;
      if AName = "getmem" then
        self.DoSetType(AId, self.DoBuiltin("ptr"));
        if self.DoIntrinsicArg(AId, 1, 0, LInt64) then
          self.DoIntrinsicConvert(AId, 0, LInt64);
          return;
        end;
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_INT64);
        return;
      end;
      if AName = "resizemem" then
        self.DoSetType(AId, self.DoBuiltin("ptr"));
        if self.DoIntrinsicArg(AId, 2, 1, LInt64) and IsPointerClass(self.DoArgClass(AId, 0)) then
          self.DoIntrinsicConvert(AId, 1, LInt64);
          return;
        end;
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_POINTER_INT64);
        return;
      end;
      // ready(T) (BNF sec 7): a bool, its one argument a task
      if AName = "ready" then
        self.DoSetType(AId, self.DoBuiltin("bool"));
        if (self.FTree.CountOf(AId, NodeRole.Argument) = 1) and
          (self.DoArgClass(AId, 0) = TypeClass.TaskType) then
          return;
        end;
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_TASK);
        return;
      end;
      self.DoNoArgumentIntrinsic(AId, AName);
    end;

    // The intrinsics with no argument (paramcount, exccode, excmsg, ProjectPassword) and
    // alive / lock (their own checks are M1.9b's: alive a bool)
    hidden method DoNoArgumentIntrinsic(const AId: int64; const AName: string);
    begin
      if AName = "alive" then
        self.DoSetType(AId, self.DoBuiltin("bool"));
        return;
      end;
      if AName = "lock" then
        return;
      end;
      if (AName = "paramcount") or (AName = "exccode") then
        self.DoSetType(AId, self.DoBuiltin("int32"));
      else
        self.DoSetType(AId, self.DoBuiltin("string"));
      end;
      if self.FTree.CountOf(AId, NodeRole.Argument) <> 0 then
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_NONE);
        return;
      end;
      // ProjectPassword() reads the project's scrambled password (the Driver's
      // SetProjectSecret): a build that is no project's has none
      if (AName = "ProjectPassword") and not self.FTree.InProject then
        self.DoError(AId, ADAM_ERR_SEMANTICS_433, ADAM_MSG_SEMANTICS_NO_PROJECT,
          NoArgs().Str(AName));
      end;
    end;

    // True when the print / println argument AArg names an overload set or a method as a
    // value: it has no single address to print (PaskalCPP's pfNoAddress)
    hidden const method DoIsNoAddress(const AArg: int64): bool;
    var
      LAt: int64;
      LDecl: int64;
      LKind: NodeKind;
    begin
      LAt := self.DoSkipParens(AArg);
      if LAt = 0 then
        return false;
      end;
      if (self.FTree[LAt].Kind <> NodeKind.NameExpression) and
        (self.FTree[LAt].Kind <> NodeKind.MemberExpression) then
        return false;
      end;
      LDecl := self.FTree[LAt].ResolvedDecl;
      if LDecl = 0 then
        return false;
      end;
      LKind := self.FTree[LDecl].Kind;
      if LKind = NodeKind.MethodDecl then
        return true;
      end;
      return ((LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine)) and
        self.DoIsOverloaded(LDecl);
    end;

    // The arguments of the print / println call AId after its format (PaskalCPP's E7): each
    // needs a print form (Types' PrintFormOf): a record, object, overlay or owner, or an
    // array of one, is SM0425 (print its fields), as is an overload set or a method named as
    // a value (no single address). ATypes gets their canonical types in order; true when
    // every one prints (an argument typed nowhere was reported where it was lost)
    hidden method DoPrintArguments(const AId: int64; var ATypes: array of int64): bool;
    var
      LArg: int64;
      LType: int64;
      LReady: bool;
      LI: int64;
    begin
      LReady := true;
      setlength(ATypes, self.FTree.CountOf(AId, NodeRole.Argument) - 1);
      for LI := 1 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        LArg := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        LType := self.FTree[LArg].ResolvedType;
        ATypes[LI - 1] := LType;
        if self.DoIsNoAddress(LArg) then
          self.DoError(LArg, ADAM_ERR_SEMANTICS_425, ADAM_MSG_SEMANTICS_PRINT_NO_ADDRESS,
            NoArgs().Str(self.DoExprText(LArg)));
          LReady := false;
        else
          if PrintFormOf(self.FTree, LType) = PrintForm.Unprintable then
            self.DoError(LArg, ADAM_ERR_SEMANTICS_425, ADAM_MSG_SEMANTICS_PRINT_UNPRINTABLE,
              NoArgs().Str(self.DoText(LType)));
            LReady := false;
          end;
          if PrintFormOf(self.FTree, LType) = PrintForm.Unknown then
            LReady := false;
          end;
        end;
      end;
      return LReady;
    end;

    // The text of the print / println format AFormat when it is one the build checks
    // (PaskalCPP's: a string literal, or a name of a const whose initializer is one,
    // TPCConstDecl.HasConstText) into AText (its decoded UTF-8); false for any other value
    hidden method DoFormatText(const AFormat: int64; var AText: string): bool;
    var
      LDecl: int64;
      LInit: int64;
    begin
      if self.FTree[AFormat].Kind = NodeKind.StringLiteral then
        AText := self.FTree[AFormat].Decoded;
        return true;
      end;
      if (self.FTree[AFormat].Kind <> NodeKind.NameExpression) and
        (self.FTree[AFormat].Kind <> NodeKind.MemberExpression) then
        return false;
      end;
      LDecl := self.FTree[AFormat].ResolvedDecl;
      if (LDecl = 0) or (self.FTree[LDecl].Kind <> NodeKind.ConstDecl) then
        return false;
      end;
      LInit := self.FTree.FirstOf(LDecl, NodeRole.Initializer);
      if (LInit = 0) or (self.FTree[LInit].Kind <> NodeKind.StringLiteral) then
        return false;
      end;
      AText := self.FTree[LInit].Decoded;
      return true;
    end;

    // print / println / FormatStr (BNF sec 7; PaskalCPP's std::print and std::format, whose
    // format clang checks when the program is built): every argument after the format prints (DoPrintArguments,
    // SM0425); a format that is a string literal or a string const holding one is read
    // against the arguments' types as std::format reads it (Adam.Compiler.Formats; a wide
    // one never fits: SM0502); any other string is read when the call runs (M3.8i: the
    // plan AtRunTime, the runtime's FormatRun); a format of any other type is SM0500. The
    // plan read is the call's ResolvedFormat, Lowering's
    hidden method DoPrintCall(const AId: int64);
    var
      LFormat: int64;
      LText: string;
      LTypes: array of int64;
      LPlan: FormatPlan;
    begin
      if self.FTree.CountOf(AId, NodeRole.Argument) = 0 then
        return;
      end;
      LFormat := self.FTree.FirstOf(AId, NodeRole.Argument);
      if not self.DoPrintArguments(AId, LTypes) then
        return;
      end;
      if self.FTree[LFormat].ResolvedType = 0 then
        return;
      end;
      if not self.DoFormatText(LFormat, LText) then
        if ClassOf(self.FTree, self.FTree[LFormat].ResolvedType) <> TypeClass.Text then
          self.DoError(LFormat, ADAM_ERR_SEMANTICS_500, ADAM_MSG_SEMANTICS_FORMAT_NOT_STRING,
            NoArgs().Str(self.DoExprText(LFormat)).Str(self.DoText(self.FTree[LFormat].ResolvedType)));
          return;
        end;
        LPlan.AtRunTime := true;
        self.FTree.SetFormat(AId, LPlan);
        return;
      end;
      if (ClassOf(self.FTree, self.FTree[LFormat].ResolvedType) = TypeClass.WideText) or
        (not ReadFormat(self.FTree, LText, LTypes, LPlan)) then
        self.DoError(LFormat, ADAM_ERR_SEMANTICS_502, ADAM_MSG_SEMANTICS_FORMAT_MISMATCH,
          NoArgs().Str(self.DoExprText(LFormat)).Int(len(LTypes)).Str("{}"));
        return;
      end;
      self.FTree.SetFormat(AId, LPlan);
    end;

    // create(P) / destroy(P) (BNF sec 7): P a pointer variable (assignable: create writes the
    // new block into it, destroy nil) to a record or an overlay, else SM0409 naming that
    // signature; a pointer to an object is SM0361 at P, naming the own / ref that builds and
    // frees one (pcpp's PLAN-OBJECT O6, D4)
    hidden method DoHeapIntrinsic(const AId: int64; const AName: string);
    var
      LArgument: int64;
      LTarget: int64;
      LClass: TypeClass;
      LTargetText: string;
    begin
      if not self.DoIntrinsicArg(AId, 1, 0, 0) then
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_HEAP_POINTER);
        return;
      end;
      LArgument := self.FTree.NthOf(AId, NodeRole.Argument, 0);
      if (self.DoArgClass(AId, 0) <> TypeClass.Pointer) or (not self.DoIsAssignable(LArgument)) then
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_HEAP_POINTER);
        return;
      end;
      LTarget := TargetOf(self.FTree, self.DoTypeOf(LArgument));
      LClass := self.DoClass(LTarget);
      if LClass = TypeClass.ObjectType then
        LTargetText := self.DoText(LTarget);
        if AName = "create" then
          self.DoError(LArgument, ADAM_ERR_SEMANTICS_361, ADAM_MSG_SEMANTICS_CREATE_OBJECT,
            NoArgs().Str(LTargetText).Str(LTargetText).Str(LTargetText));
          return;
        end;
        self.DoError(LArgument, ADAM_ERR_SEMANTICS_361, ADAM_MSG_SEMANTICS_DESTROY_OBJECT,
          NoArgs().Str(LTargetText));
        return;
      end;
      if (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.OverlayType) then
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_HEAP_POINTER);
      end;
    end;

    // The statement intrinsics' arguments (BNF sec 7): freemem a pointer; setlength a
    // dynamic array or string that can be assigned and an int64; raise a string; raisecode
    // an int32 and a string; print / println their format and print forms (DoPrintCall).
    // create / destroy / the asserts: M1.9b and M1.10 (heap types)
    hidden method DoStatementIntrinsic(const AId: int64; const AName: string);
    var
      LClass: TypeClass;
      LInt64: int64;
      LString: int64;
    begin
      if (AName = "print") or (AName = "println") then
        self.DoPrintCall(AId);
        return;
      end;
      if AName = "atomicstore" then
        self.DoAtomicIntrinsic(AId, AName);
        return;
      end;
      if (AName = "create") or (AName = "destroy") then
        self.DoHeapIntrinsic(AId, AName);
        return;
      end;
      LInt64 := self.DoBuiltin("int64");
      LString := self.DoBuiltin("string");
      if AName = "freemem" then
        if not (self.DoIntrinsicArg(AId, 1, 0, 0) and IsPointerClass(self.DoArgClass(AId, 0))) then
          self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_POINTER);
        end;
        return;
      end;
      if AName = "setlength" then
        if self.DoIntrinsicArg(AId, 2, 1, LInt64) then
          LClass := self.DoArgClass(AId, 0);
          if ((LClass = TypeClass.DynamicArray) or (LClass = TypeClass.Text) or
            (LClass = TypeClass.WideText)) and
            self.DoIsAssignable(self.FTree.FirstOf(AId, NodeRole.Argument)) then
            self.DoIntrinsicConvert(AId, 1, LInt64);
            return;
          end;
        end;
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_RESIZE);
        return;
      end;
      if AName = "raise" then
        if self.DoIntrinsicArg(AId, 1, 0, LString) then
          self.DoIntrinsicConvert(AId, 0, LString);
          return;
        end;
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_STRING);
        return;
      end;
      if AName = "raisecode" then
        if self.DoIntrinsicArg(AId, 2, 0, self.DoBuiltin("int32")) and
          self.DoIntrinsicArg(AId, 2, 1, LString) then
          self.DoIntrinsicConvert(AId, 0, self.DoBuiltin("int32"));
          self.DoIntrinsicConvert(AId, 1, LString);
          return;
        end;
        self.DoBadIntrinsic(AId, AName, ADAM_MSG_SEMANTICS_SIG_INT32_STRING);
      end;
    end;

    // The routine AName of the runtime unit (ATree.Runtime, DESIGN sec 8), public or not: the
    // compiler calls it, no program names it; 0 when the program has no runtime unit or it
    // declares no such routine (Lowering then reports what needed it)
    hidden const method DoRuntimeRoutine(const AName: string): int64;
    var
      LRuntime: int64;
    begin
      LRuntime := self.FTree.Runtime;
      if LRuntime = 0 then
        return 0;
      end;
      return self.DoRoutineIn(LRuntime, AName);
    end;

    // The routine AName declared in the module AModule, public or not; 0 when it declares
    // none
    hidden const method DoRoutineIn(const AModule: int64; const AName: string): int64;
    var
      LDecl: int64;
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AModule, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(AModule, NodeRole.Declaration, LI);
        if (self.FTree[LDecl].Kind = NodeKind.RoutineDecl) and (self.FTree[LDecl].Text = AName) then
          return LDecl;
        end;
      end;
      return 0;
    end;

    // The routine AName of the platform unit (the runtime unit's implicit import of the
    // target's Target.RuntimeUnit, the parser's DoRuntimeUnits), public or not: the routines
    // the compiler names that are the OS's shape, never System.Runtime's; 0 when the program
    // has no runtime unit, the runtime imports no platform unit, or it declares no such
    // routine (Lowering then reports what needed it)
    hidden const method DoPlatformRoutine(const AName: string): int64;
    var
      LRuntime: int64;
      LImport: int64;
      LFound: int64;
      LI: int64;
    begin
      LRuntime := self.FTree.Runtime;
      if LRuntime = 0 then
        return 0;
      end;
      for LI := 0 to self.FTree.CountOf(LRuntime, NodeRole.Import) - 1 do
        LImport := self.FTree.NthOf(LRuntime, NodeRole.Import, LI);
        if self.FTree[LImport].ResolvedUnit <> 0 then
          LFound := self.DoRoutineIn(self.FTree[LImport].ResolvedUnit, AName);
          if LFound <> 0 then
            return LFound;
          end;
        end;
      end;
      return 0;
    end;

    // Every exe module with a block: the runtime routine its block ends with (exit with 0)
    // written into the module's ResolvedCallee
    hidden method DoProgramExits();
    var
      LModule: int64;
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        LModule := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        if (self.FTree[LModule].Module = ModuleKind.Exe) and
          (self.FTree.FirstOf(LModule, NodeRole.Body) <> 0) then
          self.FTree[LModule].ResolvedCallee := self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_EXIT);
        end;
      end;
    end;

    // The runtime unit's routines a managed type's operations call, which no single node
    // names, each recorded in the tree once (SyntaxTree.RuntimeRoutineOf; 0 when missing)
    hidden method DoRuntimeRoutines();
    begin
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrRelease,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_RELEASE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrAssign,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_ASSIGN));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrWrite,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_WRITE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrTake,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_TAKE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrConcat,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_CONCAT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrFromChar,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_FROM_CHAR));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrLength,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_LENGTH));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrCompare,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_COMPARE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrUnique,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_UNIQUE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrSetLength,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_SET_LENGTH));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WStrConcat,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WSTR_CONCAT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WStrFromChar,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WSTR_FROM_CHAR));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WStrCompare,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WSTR_COMPARE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WStrUnique,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WSTR_UNIQUE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WStrSetLength,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WSTR_SET_LENGTH));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WStrToUtf8,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WSTR_TO_UTF8));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.StrAddRef,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_STR_ADD_REF));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.ManagedRelease,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_MANAGED_RELEASE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.ManagedAssign,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_MANAGED_ASSIGN));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.ArrRelease,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_ARR_RELEASE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.ArrAssign,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_ARR_ASSIGN));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.ArrUnique,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_ARR_UNIQUE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.ArrSetLength,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_ARR_SET_LENGTH));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.RefNew,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_REF_NEW));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.RefRelease,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_REF_RELEASE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.RefAssign,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_REF_ASSIGN));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.AbstractCall,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_ABSTRACT_CALL));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.FrameHandler,
        self.DoPlatformRoutine(ADAM_SEMANTICS_PLATFORM_FRAME_HANDLER));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.Unhandled,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_UNHANDLED));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.Catch,
        self.DoPlatformRoutine(ADAM_SEMANTICS_PLATFORM_CATCH));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.SetRange,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_SET_RANGE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.ThreadCallback,
        self.DoPlatformRoutine(ADAM_SEMANTICS_PLATFORM_THREAD_CALLBACK));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.SetThreadRelease,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_SET_THREAD_RELEASE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.TaskStart,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_TASK_START));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.TaskAwait,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_TASK_AWAIT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.TaskReady,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_TASK_READY));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.TaskDone,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_TASK_DONE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.MutexEnter,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_MUTEX_ENTER));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.MutexTryEnter,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_MUTEX_TRY_ENTER));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.MutexLeave,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_MUTEX_LEAVE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.CreateMem,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_CREATE_MEM));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.DestroyMem,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_DESTROY_MEM));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteInt,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_INT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteUInt,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_UINT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteBool,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_BOOL));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteChar,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_CHAR));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteWideChar,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_WIDE_CHAR));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteWideText,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_WIDE_TEXT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteCText,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_C_TEXT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteWideCText,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_WIDE_C_TEXT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteAddress,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_ADDRESS));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteChoice,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_CHOICE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteFloat32,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_FLOAT32));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteFloat64,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_FLOAT64));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.AtExit,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_AT_EXIT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.ReportHeap,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_REPORT_HEAP));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.HeapSiteList,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_HEAP_SITES));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.SpecWidth,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_SPEC_WIDTH));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecInt,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_INT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecBool,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_BOOL));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecChar,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_CHAR));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecAddress,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_ADDRESS));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecChoice,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_CHOICE));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecStr,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_STR));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecWideText,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_WIDE_TEXT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecWideChar,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_WIDE_CHAR));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecCText,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_C_TEXT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecWideCText,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_WIDE_C_TEXT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecFloat32,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_FLOAT32));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteSpecFloat64,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_SPEC_FLOAT64));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteDebugWideChar,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_DEBUG_WIDE_CHAR));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteDebugCText,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_DEBUG_C_TEXT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.WriteDebugWideCText,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_WRITE_DEBUG_WIDE_C_TEXT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.TaskWait,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_TASK_WAIT));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.PackItem,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_PACK_ITEM));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.FormatRun,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_FORMAT_RUN));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.IndexFail,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_INDEX_FAIL));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.IndexFailIn,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_INDEX_FAIL_IN));
      self.FTree.SetRuntimeRoutine(RuntimeRoutine.NilOwnerFail,
        self.DoRuntimeRoutine(ADAM_SEMANTICS_RUNTIME_NIL_OWNER_FAIL));
      self.FTree.SetVarKind(self.DoVarKind());
      self.FTree.SetAllocSite(self.DoAllocSite());
    end;

    // The runtime unit's threadstatic GAllocSite (its VarDecl, M3.12b): the allocation site
    // Lowering stores before a runtime call that may allocate; 0 when the program has no
    // runtime unit or it declares none (Lowering then stores no sites)
    hidden method DoAllocSite(): int64;
    var
      LRuntime: int64;
      LDecl: int64;
      LI: int64;
    begin
      LRuntime := self.FTree.Runtime;
      if LRuntime = 0 then
        return 0;
      end;
      for LI := 0 to self.FTree.CountOf(LRuntime, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(LRuntime, NodeRole.Declaration, LI);
        if (self.FTree[LDecl].Kind = NodeKind.VarDecl) and
          self.FTree[LDecl].HasFlag(NodeFlag.ThreadStatic) and
          (self.FTree[LDecl].Text = ADAM_SEMANTICS_RUNTIME_ALLOC_SITE) then
          return LDecl;
        end;
      end;
      return 0;
    end;

    // The runtime unit's choices type VarKind (its TypeDecl, visited so its values are
    // folded): what varargs.kind(I) answers with; 0 when the program has no runtime unit or
    // it declares none (Lowering then reports what needed it)
    hidden method DoVarKind(): int64;
    var
      LRuntime: int64;
      LDecl: int64;
      LI: int64;
    begin
      LRuntime := self.FTree.Runtime;
      if LRuntime = 0 then
        return 0;
      end;
      for LI := 0 to self.FTree.CountOf(LRuntime, NodeRole.Declaration) - 1 do
        LDecl := self.FTree.NthOf(LRuntime, NodeRole.Declaration, LI);
        if (self.FTree[LDecl].Kind = NodeKind.TypeDecl) and
          (self.FTree[LDecl].Text = ADAM_SEMANTICS_RUNTIME_VAR_KIND) then
          self.DoVisit(LDecl);
          return LDecl;
        end;
      end;
      return 0;
    end;

    // The node AId of kind(I) typed VarKind (DoVarKind), its I (AIndex) an int32; the
    // type is left unset when the runtime declares no VarKind
    hidden method DoPackKind(const AId: int64; const AIndex: int64);
    var
      LVarKind: int64;
    begin
      self.DoConvert(AIndex, self.DoBuiltin("int32"));
      LVarKind := self.DoVarKind();
      if LVarKind <> 0 then
        self.DoSetType(AId, LVarKind);
      end;
    end;

    // The runtime routine the intrinsic AName runs (DoIntrinsic writes it into the call's
    // ResolvedCallee); "" for an intrinsic the compiler lowers itself or that has none yet
    hidden const method DoRuntimeNameOf(const AName: string): string;
    begin
      if (AName = "print") or (AName = "println") or (AName = "FormatStr") then
        return ADAM_SEMANTICS_RUNTIME_WRITE;
      end;
      if AName = "getmem" then
        return ADAM_SEMANTICS_RUNTIME_GETMEM;
      end;
      if AName = "resizemem" then
        return ADAM_SEMANTICS_RUNTIME_RESIZEMEM;
      end;
      if AName = "freemem" then
        return ADAM_SEMANTICS_RUNTIME_FREEMEM;
      end;
      if AName = "paramcount" then
        return ADAM_SEMANTICS_RUNTIME_PARAMCOUNT;
      end;
      if AName = "paramstr" then
        return ADAM_SEMANTICS_RUNTIME_PARAMSTR;
      end;
      if AName = "raise" then
        return ADAM_SEMANTICS_RUNTIME_RAISE;
      end;
      if AName = "raisecode" then
        return ADAM_SEMANTICS_RUNTIME_RAISECODE;
      end;
      if AName = "exccode" then
        return ADAM_SEMANTICS_RUNTIME_EXCCODE;
      end;
      if AName = "excmsg" then
        return ADAM_SEMANTICS_RUNTIME_EXCMSG;
      end;
      if AName = "ProjectPassword" then
        return ADAM_SEMANTICS_RUNTIME_PROJECT_PASSWORD;
      end;
      return "";
    end;

    // A call of the intrinsic named AName: size by its type argument, the others with
    // their arguments visited first; one the runtime runs (DoRuntimeNameOf) has that
    // routine as its ResolvedCallee (the intrinsic stays its callee's ResolvedDecl)
    hidden method DoIntrinsic(const AId: int64; const AName: string);
    begin
      if AName = "size" then
        self.DoSizeOf(AId);
        return;
      end;
      self.DoVisitArguments(AId);
      if self.DoRuntimeNameOf(AName) <> "" then
        self.FTree[AId].ResolvedCallee := self.DoRuntimeRoutine(self.DoRuntimeNameOf(AName));
      end;
      if DoIsStatementIntrinsic(AName) then
        self.DoStatementIntrinsic(AId, AName);
        return;
      end;
      self.DoValueIntrinsic(AId, AName);
    end;

    // A call (BNF sec 6): of an intrinsic, of a type (a cast), of a routine or a method,
    // or of a value of a routine type (its signature's checks); any other value SM0400
    hidden method DoCall(const AId: int64);
    var
      LCallee: int64;
      LDecl: int64;
      LKind: NodeKind;
      LType: int64;
    begin
      LCallee := self.FTree.FirstOf(AId, NodeRole.Callee);
      if self.DoPackCall(AId, LCallee) then
        return;
      end;
      if (self.FTree[LCallee].Kind = NodeKind.MemberExpression) and
        (self.FTree[LCallee].ResolvedDecl = 0) and (self.FTree[LCallee].ResolvedUnit = 0) then
        // A member callee is resolved by its own visit (a method, a field of routine type)
        self.DoVisit(LCallee);
      end;
      LDecl := self.DoCalleeDecl(LCallee);
      if LDecl <> 0 then
        LKind := self.FTree[LDecl].Kind;
        if LKind = NodeKind.IntrinsicDecl then
          self.DoFirstVisit(LCallee);
          self.DoIntrinsic(AId, self.FTree[LDecl].Text);
          return;
        end;
        if DoIsTypeDecl(LKind) then
          self.DoFirstVisit(LCallee);
          self.DoCastCall(AId, DeclaredTypeOf(self.FTree, LDecl), self.DoExprText(LCallee));
          return;
        end;
        if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
          (LKind = NodeKind.MethodDecl) then
          self.DoFirstVisit(LCallee);
          self.DoRoutineCall(AId, LCallee, LDecl);
          return;
        end;
      end;
      self.DoVisit(LCallee);
      if self.DoLost(LCallee) then
        self.DoVisitArguments(AId);
        return;
      end;
      LType := self.DoTypeOf(LCallee);
      if self.DoClass(LType) = TypeClass.RoutineType then
        self.DoArguments(AId, self.FTree[LType].ResolvedDecl, self.DoNamingSignature(LCallee),
          self.DoExprText(LCallee));
        self.DoSetType(AId, TargetOf(self.FTree, LType));
        return;
      end;
      self.DoVisitArguments(AId);
      self.DoError(AId, ADAM_ERR_SEMANTICS_400, ADAM_MSG_SEMANTICS_NOT_CALLABLE,
        NoArgs().Str(self.DoExprText(LCallee)).Str(self.DoText(LType)));
    end;

    // A type cast T(x) on a builtin type word (BNF sec 6); extra arguments (PR0041) are
    // visited
    hidden method DoTypeCast(const AId: int64);
    var
      LType: int64;
      LOperand: int64;
    begin
      LType := CanonicalOf(self.FTree, self.FTree.FirstOf(AId, NodeRole.TypeOf));
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      self.DoVisitArguments(AId);
      self.DoSetType(AId, LType);
      self.DoCastValue(LOperand, LType);
    end;

    // A pointer cast ptr to [const] T(x) (BNF sec 6): a pointer that keeps const, an
    // integer of pointer width, a string literal into a ptr to const char / wchar; SM0265
    // otherwise (a const drop, a float, a narrower integer, nil)
    hidden method DoPointerCast(const AId: int64);
    var
      LType: int64;
      LOperand: int64;
      LFrom: int64;
    begin
      LType := CanonicalOf(self.FTree, self.FTree.FirstOf(AId, NodeRole.TypeOf));
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      self.DoVisitArguments(AId);
      self.DoSetType(AId, LType);
      if (LType = 0) or self.DoLost(LOperand) then
        return;
      end;
      if self.DoLiteralTakes(self.DoSkipParens(LOperand), LType) then
        self.FTree[LOperand].ResolvedConvert := LType;
        return;
      end;
      LFrom := self.DoTypeOf(LOperand);
      if self.DoPointerCastTakes(LFrom, LType) then
        return;
      end;
      self.DoError(LOperand, ADAM_ERR_SEMANTICS_265, ADAM_MSG_SEMANTICS_NO_POINTER_CAST,
        NoArgs().Str(self.DoText(LFrom)).Str(self.DoText(LType)));
    end;

    // True when no object is both an AFirst and an ASecond (SM0273): neither is an
    // ancestor of the other and they are two objects (two branches of one chain), or one
    // is an interface the other, a final object, does not implement. Two interfaces may
    // meet in one object
    hidden const method DoNeverBoth(const AFirst: int64; const ASecond: int64): bool;
    var
      LFirstClass: TypeClass;
      LSecondClass: TypeClass;
    begin
      if (AFirst = ASecond) or IsAncestorOf(self.FTree, AFirst, ASecond) or
        IsAncestorOf(self.FTree, ASecond, AFirst) then
        return false;
      end;
      LFirstClass := self.DoClass(AFirst);
      LSecondClass := self.DoClass(ASecond);
      if (LFirstClass = TypeClass.ObjectType) and (LSecondClass = TypeClass.ObjectType) then
        return true;
      end;
      if LFirstClass = TypeClass.ObjectType then
        return IsFinalType(self.FTree, AFirst);
      end;
      if LSecondClass = TypeClass.ObjectType then
        return IsFinalType(self.FTree, ASecond);
      end;
      return false;
    end;

    // True when the object value AExpr may hold a descendant of its type (BNF sec 6, is /
    // as): a var or const parameter, a deref, P[i] on a pointer, self, parent, X as T.
    // A variable, a field, an element, a call's result holds exactly its type
    hidden const method DoMayHoldDescendant(const AExpr: int64): bool;
    var
      LAt: int64;
      LKind: NodeKind;
      LDecl: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      LKind := self.FTree[LAt].Kind;
      if (LKind = NodeKind.SelfExpression) or (LKind = NodeKind.ParentExpression) or
        (LKind = NodeKind.AsExpression) then
        return true;
      end;
      if (LKind = NodeKind.UnaryExpression) and (self.FTree[LAt].Op = OperatorKind.Deref) then
        return true;
      end;
      if (LKind = NodeKind.PostfixExpression) and (self.FTree[LAt].Op = OperatorKind.Deref) then
        return true;
      end;
      if LKind = NodeKind.IndexExpression then
        return IsPointerClass(self.DoClass(self.DoTypeOf(self.FTree.FirstOf(LAt, NodeRole.Operand))));
      end;
      if LKind = NodeKind.NameExpression then
        LDecl := self.FTree[LAt].ResolvedDecl;
        return (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.Param) and
          (self.FTree[LDecl].HasFlag(NodeFlag.VarParam) or self.FTree[LDecl].HasFlag(NodeFlag.ConstParam));
      end;
      return false;
    end;

    // X is T (a bool) / X as T (BNF sec 6): X a polymorphic object or a ptr to / own / ref
    // of one (SM0271; a weak: SM0275), T an object or an interface type (SM0272); a test
    // no object passes is SM0273 (no object is both types) or SM0274 (X holds exactly its
    // own type). as keeps X's kind: an object -> the object as T, ptr to S -> ptr to T,
    // ref S -> ref T, own S -> the object it holds as T
    hidden method DoIsAs(const AId: int64);
    var
      LOperand: int64;
      LTypeNode: int64;
      LType: int64;
      LFrom: int64;
      LHeld: int64;
      LClass: TypeClass;
      LIs: bool;
      LWord: string;
      LOperandText: string;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      LTypeNode := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      LType := CanonicalOf(self.FTree, LTypeNode);
      LIs := self.FTree[AId].Kind = NodeKind.IsExpression;
      LWord := "as";
      if LIs then
        LWord := "is";
        self.DoSetType(AId, self.DoBuiltin("bool"));
      end;
      if LType = 0 then
        return;
      end;
      if (self.DoClass(LType) <> TypeClass.ObjectType) and (self.DoClass(LType) <> TypeClass.InterfaceType) then
        self.DoError(LTypeNode, ADAM_ERR_SEMANTICS_272, ADAM_MSG_SEMANTICS_TEST_TARGET,
          NoArgs().Str(LWord).Str(self.DoText(LType)).Str(self.DoText(LType)));
        return;
      end;
      if not LIs then
        // The result's type stands even when the test below is refused: what uses it is
        // checked against it
        self.DoSetType(AId, LType);
      end;
      if self.DoLost(LOperand) then
        return;
      end;
      LFrom := self.DoTypeOf(LOperand);
      LClass := self.DoClass(LFrom);
      LOperandText := self.DoExprText(LOperand);
      if LClass = TypeClass.WeakType then
        self.DoError(LOperand, ADAM_ERR_SEMANTICS_275, ADAM_MSG_SEMANTICS_TEST_WEAK,
          NoArgs().Str(LOperandText).Str(LOperandText));
        return;
      end;
      LHeld := LFrom;
      if (LClass = TypeClass.Pointer) or (LClass = TypeClass.OwnType) or (LClass = TypeClass.RefType) then
        LHeld := TargetOf(self.FTree, LFrom);
      end;
      if not IsPolymorphic(self.FTree, LHeld) then
        self.DoError(LOperand, ADAM_ERR_SEMANTICS_271, ADAM_MSG_SEMANTICS_TEST_OPERAND,
          NoArgs().Str(LOperandText).Str(LOperandText).Str(self.DoText(LFrom)));
        return;
      end;
      if self.DoNeverBoth(LHeld, LType) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_273, ADAM_MSG_SEMANTICS_TEST_NEVER,
          NoArgs().Str(LOperandText + " " + LWord + " " + self.DoText(LType)).Str(
          self.DoText(LHeld)).Str(self.DoText(LType)));
        return;
      end;
      if (LHeld = LFrom) and (LHeld <> LType) and (not IsAncestorOf(self.FTree, LType, LHeld)) and
        (not self.DoMayHoldDescendant(LOperand)) then
        self.DoError(LOperand, ADAM_ERR_SEMANTICS_274, ADAM_MSG_SEMANTICS_TEST_EXACT,
          NoArgs().Str(LOperandText).Str(self.DoText(LHeld)).Str(self.DoText(LType)));
        return;
      end;
      if LIs then
        return;
      end;
      if LClass = TypeClass.Pointer then
        self.DoSetType(AId, PointerTo(self.FTree, LType, IsConstTarget(self.FTree, LFrom)));
      end;
      if LClass = TypeClass.RefType then
        self.DoSetType(AId, OwnerOf(self.FTree, NodeKind.RefType, LType));
      end;
    end;

    // own / ref / weak T(...): an own / ref / weak T (BNF sec 6). T is an object
    // (SM0358); a weak builds nothing (SM0359); an own / ref builds T with one of its inits
    // (DoBuild)
    hidden method DoOwnerNew(const AId: int64);
    var
      LTypeNode: int64;
      LType: int64;
      LKind: NodeKind;
      LWord: string;
    begin
      LTypeNode := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      LType := CanonicalOf(self.FTree, LTypeNode);
      self.DoVisitArguments(AId);
      if LType = 0 then
        return;
      end;
      LWord := "own ";
      if self.FTree[AId].Kind = NodeKind.RefNew then
        LWord := "ref ";
      end;
      if self.FTree[AId].Kind = NodeKind.WeakNew then
        LWord := "weak ";
      end;
      if (self.DoClass(LType) <> TypeClass.ObjectType) and (self.DoClass(LType) <> TypeClass.InterfaceType) then
        self.DoError(LTypeNode, ADAM_ERR_SEMANTICS_358, ADAM_MSG_SEMANTICS_OWNER_TARGET,
          NoArgs().Str(LWord + self.DoText(LType)).Str(self.DoText(LType)));
        return;
      end;
      if self.FTree[AId].Kind = NodeKind.WeakNew then
        self.DoError(AId, ADAM_ERR_SEMANTICS_359, ADAM_MSG_SEMANTICS_WEAK_NEW,
          NoArgs().Str(LWord + self.DoText(LType)).Str(self.DoText(LType)));
        return;
      end;
      self.DoBuild(AId, NodeRole.Argument, LType, LTypeNode);
      LKind := NodeKind.WeakType;
      if self.FTree[AId].Kind = NodeKind.OwnNew then
        LKind := NodeKind.OwnType;
      end;
      if self.FTree[AId].Kind = NodeKind.RefNew then
        LKind := NodeKind.RefType;
      end;
      self.DoSetType(AId, OwnerOf(self.FTree, LKind, LType));
    end;

    // varargs.count (int32), next(T) / get(I, T) (a T; I an int32), copy() (varargs),
    // reset() (no value), kind(I) (a VarKind: DoPackKind). Only inside a variadic routine
    // (SM0417); in a clink one (by meaning: Types.IsCppSignature) only next (SM0418, BNF
    // sec 6: a C caller passes no types or count). The type is set either way, so the uses
    // around it check as written
    hidden method DoVarargs(const AId: int64);
    var
      LMember: string;
      LRoutine: int64;
    begin
      LMember := self.FTree[AId].Text;
      self.DoVisitArguments(AId);
      LRoutine := self.DoEnclosingRoutine(AId);
      if (LRoutine = 0) or not self.FTree[LRoutine].HasFlag(NodeFlag.Variadic) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_417, ADAM_MSG_SEMANTICS_VARARGS_OUTSIDE, NoArgs());
      else
        if (LMember <> "next") and not IsCppSignature(self.FTree, LRoutine) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_418, ADAM_MSG_SEMANTICS_VARARGS_CLINK,
            NoArgs().Str(LMember));
        end;
      end;
      if LMember = "count" then
        self.DoSetType(AId, self.DoBuiltin("int32"));
        return;
      end;
      if (LMember = "next") or (LMember = "get") then
        if LMember = "get" then
          self.DoConvert(self.FTree.FirstOf(AId, NodeRole.Argument), self.DoBuiltin("int32"));
        end;
        self.DoSetType(AId, CanonicalOf(self.FTree, self.FTree.FirstOf(AId, NodeRole.TypeOf)));
        return;
      end;
      if LMember = "copy" then
        self.DoSetType(AId, self.DoBuiltin("varargs"));
        return;
      end;
      if LMember = "kind" then
        self.DoPackKind(AId, self.FTree.FirstOf(AId, NodeRole.Argument));
      end;
    end;

    // True when the operand AOperand of a member access is a value of type varargs (a
    // varargs local: BNF sec 6, the members of a pack); a module's or a type's name is
    // none. AOperand is visited
    hidden method DoIsPackOperand(const AOperand: int64): bool;
    begin
      if (self.FTree[AOperand].ResolvedUnit <> 0) or (self.DoTypeNamed(AOperand) <> 0) then
        return false;
      end;
      self.DoVisit(AOperand);
      if self.DoLost(AOperand) then
        return false;
      end;
      return self.DoClass(self.DoTypeOf(AOperand)) = TypeClass.Varargs;
    end;

    // The member AId of a varargs local that is no call: count (an int32); any other name
    // SM0009 (next / get / reset / copy are called: DoPackCall)
    hidden method DoPackMember(const AId: int64);
    begin
      if self.FTree[AId].Text = "count" then
        self.DoSetType(AId, self.DoBuiltin("int32"));
        return;
      end;
      self.DoError(AId, ADAM_ERR_SEMANTICS_009, ADAM_MSG_SEMANTICS_NO_MEMBER,
        NoArgs().Str("varargs").Str(self.FTree[AId].Text));
    end;

    // The type the argument AArg of next / get names: a type expression's canonical type,
    // a name of a type (BNF sec 6 type arg); 0 after SM0013 for anything else
    hidden method DoPackType(const AArg: int64): int64;
    var
      LNamed: int64;
    begin
      if DoIsTypeExpression(self.FTree[AArg].Kind) then
        self.DoVisit(AArg);
        return CanonicalOf(self.FTree, AArg);
      end;
      LNamed := self.DoTypeNamed(AArg);
      if LNamed <> 0 then
        self.DoFirstVisit(AArg);
        return LNamed;
      end;
      self.DoVisit(AArg);
      if not self.DoLost(AArg) then
        self.DoError(AArg, ADAM_ERR_SEMANTICS_013, ADAM_MSG_SEMANTICS_NOT_TYPE,
          NoArgs().Str(self.DoExprText(AArg)));
      end;
      return 0;
    end;

    // True when the call AId of ACallee reads a varargs local (BNF sec 6, the members of a
    // pack, user 2026-11-06: SEM decides by the receiver's type): next(T) a T, get(I, T) a
    // T with I an int32, reset() no value, copy() a varargs, kind(I) a VarKind; each with
    // its own argument count (SM0401). False for any other call (the callee is left to
    // DoCall)
    hidden method DoPackCall(const AId: int64; const ACallee: int64): bool;
    var
      LWord: string;
      LCount: int64;
      LWant: int64;
      LType: int64;
    begin
      if (self.FTree[ACallee].Kind <> NodeKind.MemberExpression) or
        (self.FTree[ACallee].ResolvedDecl <> 0) or (self.FTree[ACallee].ResolvedUnit <> 0) then
        return false;
      end;
      LWord := self.FTree[ACallee].Text;
      if (LWord <> "next") and (LWord <> "get") and (LWord <> "reset") and (LWord <> "copy") and
        (LWord <> "kind") then
        return false;
      end;
      if not self.DoIsPackOperand(self.FTree.FirstOf(ACallee, NodeRole.Operand)) then
        return false;
      end;
      // The callee is the member word itself: no member access of its own to check
      self.DoFirstVisit(ACallee);
      LCount := self.FTree.CountOf(AId, NodeRole.Argument);
      LWant := 0;
      if (LWord = "next") or (LWord = "kind") then
        LWant := 1;
      end;
      if LWord = "get" then
        LWant := 2;
      end;
      if LCount <> LWant then
        self.DoVisitArguments(AId);
        self.DoError(AId, ADAM_ERR_SEMANTICS_401, ADAM_MSG_SEMANTICS_ARG_COUNT,
          NoArgs().Str(self.DoExprText(ACallee)).Int(LWant).Int(LCount));
        return true;
      end;
      if LWord = "copy" then
        self.DoSetType(AId, self.DoBuiltin("varargs"));
        return true;
      end;
      if LWord = "reset" then
        return true;
      end;
      if LWord = "kind" then
        self.DoVisit(self.FTree.FirstOf(AId, NodeRole.Argument));
        self.DoPackKind(AId, self.FTree.FirstOf(AId, NodeRole.Argument));
        return true;
      end;
      if LWord = "get" then
        self.DoVisit(self.FTree.FirstOf(AId, NodeRole.Argument));
        self.DoConvert(self.FTree.FirstOf(AId, NodeRole.Argument), self.DoBuiltin("int32"));
      end;
      LType := self.DoPackType(self.FTree.NthOf(AId, NodeRole.Argument, LWant - 1));
      if LType <> 0 then
        self.DoSetType(AId, LType);
      end;
      return true;
    end;

    // True when AExpr (through parentheses) is a pack's copy: varargs.copy() or copy() of
    // a varargs local (SM0422 takes nothing else into one)
    hidden const method DoIsVarargsCopy(const AExpr: int64): bool;
    var
      LAt: int64;
      LCallee: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if LAt = 0 then
        return false;
      end;
      if self.FTree[LAt].Kind = NodeKind.VarargsExpression then
        return self.FTree[LAt].Text = "copy";
      end;
      if self.FTree[LAt].Kind <> NodeKind.CallExpression then
        return false;
      end;
      LCallee := self.FTree.FirstOf(LAt, NodeRole.Callee);
      return (self.FTree[LCallee].Kind = NodeKind.MemberExpression) and
        (self.FTree[LCallee].Text = "copy") and
        (self.DoClass(self.DoTypeOf(self.FTree.FirstOf(LCallee, NodeRole.Operand))) = TypeClass.Varargs);
    end;

    // The value ASource stored into a place of the canonical type AType (an initializer, an
    // assignment): into a varargs local only a pack's copy (SM0422, BNF sec 4 / 6)
    hidden method DoPackSource(const ASource: int64; const AType: int64);
    begin
      if (self.DoClass(AType) = TypeClass.Varargs) and not self.DoLost(ASource) and
        not self.DoIsVarargsCopy(ASource) then
        self.DoError(ASource, ADAM_ERR_SEMANTICS_422, ADAM_MSG_SEMANTICS_VARARGS_TYPE, NoArgs());
      end;
    end;

    // The varargs type expression AId (BNF sec 4: only the type of a variadic routine's
    // local; in a clink one it can never be set, its copy() being SM0418) anywhere else is
    // SM0422: a parameter, a field, a module variable, a result, a part of another type
    hidden method DoVarargsTypeAt(const AId: int64);
    var
      LDecl: int64;
      LRoutine: int64;
    begin
      LDecl := self.FTree.ParentOf(AId);
      if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.VarDecl) and
        (self.FTree.FirstOf(LDecl, NodeRole.TypeOf) = AId) then
        LRoutine := self.FTree.ParentOf(LDecl);
        if (LRoutine <> 0) and ((self.FTree[LRoutine].Kind = NodeKind.RoutineDecl) or
          (self.FTree[LRoutine].Kind = NodeKind.MethodDecl)) and
          self.FTree[LRoutine].HasFlag(NodeFlag.Variadic) then
          return;
        end;
      end;
      self.DoError(AId, ADAM_ERR_SEMANTICS_422, ADAM_MSG_SEMANTICS_VARARGS_TYPE, NoArgs());
    end;

    // T(F: v, ...): a record type (SM0413); each field one of its fields (SM0414), given
    // once (SM0415), its value converting to the field's type (a constant for a bitfield
    // fitting its width: DoBitStore); a T
    hidden method DoRecordLiteral(const AId: int64);
    var
      LTypeNode: int64;
      LType: int64;
      LI: int64;
      LJ: int64;
      LInit: int64;
      LName: string;
      LField: int64;
      LValue: int64;
      LTwice: bool;
    begin
      LTypeNode := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      LType := CanonicalOf(self.FTree, LTypeNode);
      self.DoSetType(AId, LType);
      self.DoVisitArguments(AId);
      if LType = 0 then
        return;
      end;
      if self.DoClass(LType) <> TypeClass.RecordType then
        self.DoError(LTypeNode, ADAM_ERR_SEMANTICS_413, ADAM_MSG_SEMANTICS_RECORD_KIND,
          NoArgs().Str(self.DoText(LType)));
        return;
      end;
      for LI := 0 to self.FTree.CountOf(AId, NodeRole.Argument) - 1 do
        LInit := self.FTree.NthOf(AId, NodeRole.Argument, LI);
        LName := self.FTree[LInit].Text;
        LTwice := false;
        for LJ := 0 to LI - 1 do
          if self.FTree[self.FTree.NthOf(AId, NodeRole.Argument, LJ)].Text = LName then
            LTwice := true;
          end;
        end;
        LField := MemberOf(self.FTree, LType, LName);
        if LTwice then
          self.DoError(LInit, ADAM_ERR_SEMANTICS_415, ADAM_MSG_SEMANTICS_RECORD_TWICE,
            NoArgs().Str(LName));
        else
          if (LField = 0) or (self.FTree[LField].Kind <> NodeKind.FieldDecl) then
            self.DoError(LInit, ADAM_ERR_SEMANTICS_414, ADAM_MSG_SEMANTICS_RECORD_NO_FIELD,
              NoArgs().Str(self.DoText(LType)).Str(LName));
          else
            self.FTree[LInit].ResolvedDecl := LField;
            LValue := self.FTree.FirstOf(LInit, NodeRole.Value);
            if self.DoConvert(LValue, self.DoDeclType(LField)) and
              (self.FTree.FirstOf(LField, NodeRole.BitWidth) <> 0) then
              self.DoBitStore(LField, LValue);
            end;
          end;
        end;
      end;
    end;

    // An expression (BNF sec 6), by its kind: its type into ResolvedType
    hidden method DoExpression(const AId: int64);
    begin
      match self.FTree[AId].Kind of
        NodeKind.IntLiteral: self.DoIntLiteral(AId);
        NodeKind.FloatLiteral: self.DoFloatLiteral(AId);
        NodeKind.StringLiteral: self.DoSetType(AId, self.DoBuiltin("string"));
        NodeKind.CharLiteral: self.DoSetType(AId, self.DoBuiltin("char"));
        NodeKind.BoolLiteral: self.DoSetType(AId, self.DoBuiltin("bool"));
        NodeKind.NilLiteral: self.DoSetType(AId, NilTypeOf(self.FTree));
        NodeKind.NameExpression: self.DoName(AId);
        NodeKind.ParenExpression: self.DoParen(AId);
        NodeKind.SelfExpression, NodeKind.ParentExpression: self.DoSelf(AId);
        NodeKind.UnaryExpression: self.DoUnary(AId);
        NodeKind.PostfixExpression: self.DoPostfix(AId);
        NodeKind.BinaryExpression: self.DoBinary(AId);
        NodeKind.AssignExpression: self.DoAssign(AId);
        NodeKind.ConditionalExpression: self.DoConditional(AId);
        NodeKind.CallExpression: self.DoCall(AId);
        NodeKind.IndexExpression: self.DoIndex(AId);
        NodeKind.MemberExpression: self.DoMember(AId);
        NodeKind.TypeCast: self.DoTypeCast(AId);
        NodeKind.PointerCast: self.DoPointerCast(AId);
        NodeKind.IsExpression, NodeKind.AsExpression: self.DoIsAs(AId);
        NodeKind.OwnNew, NodeKind.RefNew, NodeKind.WeakNew: self.DoOwnerNew(AId);
        NodeKind.VarargsExpression: self.DoVarargs(AId);
        NodeKind.RecordLiteral: self.DoRecordLiteral(AId);
        NodeKind.AsyncExpression: self.DoAsync(AId);
        NodeKind.AwaitExpression: self.DoAwait(AId);
      else
        // a set literal takes its type where it goes (DoConvert); its items are typed
        self.DoChildren(AId);
      end;
    end;

    // The signature node a call's callee ACallee runs (BNF sec 6 async: the routine it
    // names, a forward's full declaration, a method; a routine value's type's signature);
    // 0 for any other callee (an intrinsic, a cast's type)
    hidden method DoAsyncSignature(const ACallee: int64): int64;
    var
      LDecl: int64;
      LKind: NodeKind;
      LType: int64;
    begin
      LDecl := self.DoCalleeDecl(ACallee);
      if LDecl <> 0 then
        LKind := self.FTree[LDecl].Kind;
        if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
          (LKind = NodeKind.MethodDecl) then
          return LDecl;
        end;
      end;
      LType := self.DoTypeOf(ACallee);
      if self.DoClass(LType) = TypeClass.RoutineType then
        return self.FTree[LType].ResolvedDecl;
      end;
      return 0;
    end;

    // async F(..) (BNF sec 6): its operand a call of a routine (a routine's name, a method,
    // a routine value: else SM0701), passing no var parameter (SM0702: the caller's place
    // may be gone before the call ends); a task T, T the call's result type, plain task for
    // a call with none
    hidden method DoAsync(const AId: int64);
    var
      LCall: int64;
      LCallee: int64;
      LSignature: int64;
      LNames: int64;
      LParam: int64;
      LI: int64;
    begin
      LCall := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LCall);
      if (LCall = 0) or (self.FTree[LCall].Kind <> NodeKind.CallExpression) then
        if (LCall <> 0) and (not self.FTree[LCall].HasFlag(NodeFlag.Recovered)) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_701, ADAM_MSG_SEMANTICS_ASYNC_CALL,
            NoArgs().Str(self.DoExprText(LCall)));
        end;
        return;
      end;
      LCallee := self.FTree.FirstOf(LCall, NodeRole.Callee);
      LSignature := self.DoAsyncSignature(LCallee);
      if LSignature = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_701, ADAM_MSG_SEMANTICS_ASYNC_CALL,
          NoArgs().Str(self.DoExprText(LCall)));
        return;
      end;
      // A routine value's type names no parameter: its written type does (DoNamingSignature)
      LNames := LSignature;
      if self.FTree.ParentOf(LSignature) = ADAM_AST_DERIVED then
        LNames := self.DoNamingSignature(LCallee);
      end;
      for LI := 0 to self.FTree.CountOf(LSignature, NodeRole.Param) - 1 do
        LParam := self.FTree.NthOf(LSignature, NodeRole.Param, LI);
        if self.FTree[LParam].HasFlag(NodeFlag.VarParam) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_702, ADAM_MSG_SEMANTICS_ASYNC_VAR,
            NoArgs().Str(self.DoParamName(LNames, LI)));
          return;
        end;
      end;
      self.DoSetType(AId, TaskOf(self.FTree, self.DoTypeOf(LCall)));
    end;

    // await T (BNF sec 6): its operand a task (else SM0703); the task's result type, none
    // for a plain task (a statement only: DoIsNoValue)
    hidden method DoAwait(const AId: int64);
    var
      LOperand: int64;
      LType: int64;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      LType := self.DoTypeOf(LOperand);
      if self.DoClass(LType) <> TypeClass.TaskType then
        if LType <> 0 then
          self.DoError(AId, ADAM_ERR_SEMANTICS_703, ADAM_MSG_SEMANTICS_AWAIT_TASK,
            NoArgs().Str(self.DoText(LType)));
        end;
        return;
      end;
      if self.FTree[LType].ResolvedType <> 0 then
        self.DoSetType(AId, self.FTree[LType].ResolvedType);
      end;
    end;

    // True when AExpr (its parentheses off) is an await of a plain task: no value (SM0704)
    hidden const method DoIsPlainAwait(const AExpr: int64): bool;
    var
      LAt: int64;
      LType: int64;
    begin
      LAt := self.DoSkipParens(AExpr);
      if (LAt = 0) or (self.FTree[LAt].Kind <> NodeKind.AwaitExpression) then
        return false;
      end;
      LType := self.DoTypeOf(self.FTree.FirstOf(LAt, NodeRole.Operand));
      return (self.DoClass(LType) = TypeClass.TaskType) and (self.FTree[LType].ResolvedType = 0);
    end;

    // (X): X's type
    hidden method DoParen(const AId: int64);
    var
      LOperand: int64;
    begin
      LOperand := self.FTree.FirstOf(AId, NodeRole.Operand);
      self.DoVisit(LOperand);
      self.DoSetType(AId, self.DoTypeOf(LOperand));
    end;

    // Every child of AId visited
    hidden method DoChildren(const AId: int64);
    var
      LI: int64;
    begin
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        self.DoVisit(self.FTree.ChildAt(AId, LI));
      end;
    end;

    // A choices type's body AId: each value typed, then numbered before the next one is
    // typed, so a value may name one before it (fB = fA + 1, BNF sec 4)
    hidden method DoChoices(const AId: int64);
    var
      LI: int64;
      LMember: int64;
    begin
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LMember := self.FTree.ChildAt(AId, LI);
        self.DoVisit(LMember);
        if self.FTree[LMember].Kind = NodeKind.ChoiceValue then
          self.FFolder.NumberChoice(AId, LMember);
        end;
      end;
    end;

    // A var / const declaration: its type, its initializer converting to it. A variable of
    // an object type is built (DoBuild: LV: T, LV: T(...)); init arguments on any other
    // type are SM0350; an external variable is built elsewhere
    hidden method DoVarDecl(const AId: int64);
    var
      LType: int64;
      LInit: int64;
      LClass: TypeClass;
      LTypeNode: int64;
    begin
      LType := self.DoDeclType(AId);
      self.DoChildren(AId);
      LInit := self.FTree.FirstOf(AId, NodeRole.Initializer);
      if LInit <> 0 then
        self.DoOwnMoves(LInit, false);
        self.DoConvert(LInit, LType);
        self.DoPackSource(LInit, LType);
        // A mutex starts free (all zero) and is never copied in: no initializer (SM0621)
        if (LType <> 0) and HoldsMutex(self.FTree, LType) then
          self.DoError(LInit, ADAM_ERR_SEMANTICS_621, ADAM_MSG_SEMANTICS_MUTEX_INIT,
            NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(LType)));
        end;
      end;
      if self.FTree[AId].HasFlag(NodeFlag.ThreadStatic) then
        self.DoThreadStatic(AId, LType, LInit);
        return;
      end;
      if (LType = 0) or (self.FTree[AId].Kind <> NodeKind.VarDecl) or
        (self.FTree.FirstOf(AId, NodeRole.External) <> 0) then
        return;
      end;
      LTypeNode := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      LClass := self.DoClass(LType);
      if (LClass = TypeClass.ObjectType) or (LClass = TypeClass.InterfaceType) then
        // one given an initializer takes its value (a call's result is moved in: BNF sec
        // 3's `= expression`, never with `( )`): no init builds it
        if LInit <> 0 then
          self.DoValueHolds(LType, LTypeNode);
          return;
        end;
        self.DoBuild(AId, NodeRole.ConstructorArgument, LType, LTypeNode);
        return;
      end;
      if self.FTree.CountOf(AId, NodeRole.ConstructorArgument) > 0 then
        self.DoError(LTypeNode, ADAM_ERR_SEMANTICS_350, ADAM_MSG_SEMANTICS_INIT_NOT_OBJECT,
          NoArgs().Str(self.DoText(LType)));
      end;
    end;

    // The threadstatic variable AId of type AType (BNF sec 3): never external, never given
    // init arguments, never an object or interface value (each is built once, at the
    // program's start): SM0700 naming which; its initializer AInit (0: none) a constant
    // (SM0202), the bytes every thread's copy starts with
    hidden method DoThreadStatic(const AId: int64; const AType: int64; const AInit: int64);
    var
      LClass: TypeClass;
    begin
      if self.FTree.FirstOf(AId, NodeRole.External) <> 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_700, ADAM_MSG_SEMANTICS_THREADSTATIC_FORM,
          NoArgs().Str(self.FTree[AId].Text).Str(ADAM_MSG_SEMANTICS_THREADSTATIC_EXTERNAL));
        return;
      end;
      if self.FTree.CountOf(AId, NodeRole.ConstructorArgument) > 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_700, ADAM_MSG_SEMANTICS_THREADSTATIC_FORM,
          NoArgs().Str(self.FTree[AId].Text).Str(ADAM_MSG_SEMANTICS_THREADSTATIC_ARGUMENTS));
        return;
      end;
      if AType <> 0 then
        LClass := self.DoClass(AType);
        if (LClass = TypeClass.ObjectType) or (LClass = TypeClass.InterfaceType) then
          self.DoError(AId, ADAM_ERR_SEMANTICS_700, ADAM_MSG_SEMANTICS_THREADSTATIC_FORM,
            NoArgs().Str(self.FTree[AId].Text).Str(ADAM_MSG_SEMANTICS_THREADSTATIC_OBJECT));
          return;
        end;
      end;
      if (AInit <> 0) and (self.FTree[AInit].ResolvedConst.Kind = ConstKind.Unknown) and
        (self.FTree[AInit].ResolvedType <> 0) then
        self.DoError(AInit, ADAM_ERR_SEMANTICS_202, ADAM_MSG_SEMANTICS_NOT_CONSTANT,
          NoArgs().Str(ADAM_MSG_SEMANTICS_THREADSTATIC_INIT));
      end;
    end;

    // A parameter or a field: its type; a value parameter or a field holds its value, so
    // an interface or an abstract object there is SM0338 (a var / const parameter reaches
    // one by reference). A parameter whose type holds a mutex is var only (SM0621: a mutex
    // is never copied, and a plain routine's const one is a copy)
    hidden method DoHeldDecl(const AId: int64);
    var
      LType: int64;
    begin
      LType := self.DoDeclType(AId);
      if (LType <> 0) and (self.FTree[AId].Kind = NodeKind.Param) and
        (not self.FTree[AId].HasFlag(NodeFlag.VarParam)) and HoldsMutex(self.FTree, LType) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_621, ADAM_MSG_SEMANTICS_MUTEX_PARAM,
          NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(LType)));
      end;
      if (LType = 0) or self.FTree[AId].HasFlag(NodeFlag.VarParam) or
        self.FTree[AId].HasFlag(NodeFlag.ConstParam) then
        return;
      end;
      self.DoValueHolds(LType, self.FTree.FirstOf(AId, NodeRole.TypeOf));
    end;

    // A type expression AId of kind AKind: its canonical type; own / ref / weak hold an
    // object or an interface (SM0358); varargs only where DoVarargsTypeAt takes it
    hidden method DoTypeExpression(const AId: int64; const AKind: NodeKind);
    var
      LType: int64;
      LTarget: int64;
      LClass: TypeClass;
    begin
      // The children first: a static array's bounds are folded before its type's key is
      // made from their values (M1.10)
      self.DoChildren(AId);
      LType := CanonicalOf(self.FTree, AId);
      if self.DoClass(LType) = TypeClass.Varargs then
        self.DoVarargsTypeAt(AId);
        return;
      end;
      if (AKind <> NodeKind.OwnType) and (AKind <> NodeKind.RefType) and (AKind <> NodeKind.WeakType) then
        return;
      end;
      LTarget := TargetOf(self.FTree, LType);
      if LTarget = 0 then
        return;
      end;
      LClass := self.DoClass(LTarget);
      if (LClass <> TypeClass.ObjectType) and (LClass <> TypeClass.InterfaceType) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_358, ADAM_MSG_SEMANTICS_OWNER_TARGET,
          NoArgs().Str(self.DoText(LType)).Str(self.DoText(LTarget)));
      end;
    end;

    // ADAM_MSG_SEMANTICS_CONST_WORD or _PLAIN_WORD: what the method AMethod is
    hidden const method DoConstWord(const AMethod: int64): string;
    begin
      if self.FTree[AMethod].HasFlag(NodeFlag.ConstMethod) then
        return ADAM_MSG_SEMANTICS_CONST_WORD;
      end;
      return ADAM_MSG_SEMANTICS_PLAIN_WORD;
    end;

    // True when the member AMember is virtual or an override
    hidden const method DoIsVirtual(const AMember: int64): bool;
    begin
      return self.FTree[AMember].HasFlag(NodeFlag.Virtual) or self.FTree[AMember].HasFlag(NodeFlag.Override);
    end;

    // True when the properties AFirst and ASecond have one shape: their type, their index
    // and whether they have a write
    hidden method DoSameProperty(const AFirst: int64; const ASecond: int64): bool;
    var
      LFirstIndex: int64;
      LSecondIndex: int64;
    begin
      if self.DoDeclType(AFirst) <> self.DoDeclType(ASecond) then
        return false;
      end;
      if (self.FTree.FirstOf(AFirst, NodeRole.Write) = 0) <> (self.FTree.FirstOf(ASecond, NodeRole.Write) = 0) then
        return false;
      end;
      LFirstIndex := self.FTree.FirstOf(AFirst, NodeRole.Param);
      LSecondIndex := self.FTree.FirstOf(ASecond, NodeRole.Param);
      if (LFirstIndex = 0) <> (LSecondIndex = 0) then
        return false;
      end;
      return (LFirstIndex = 0) or (self.DoDeclType(LFirstIndex) = self.DoDeclType(LSecondIndex));
    end;

    // The virtual words of the method or property AMember of the object AType (BNF sec 4,
    // object members): final and abstract close or open a virtual one (SM0336 / SM0337);
    // an override continues a virtual one of a level above (none: SM0333; final there:
    // SM0335) with its signature (SM0334) and const (SM0389); a name a level above has
    // virtual is overridden only by override (SM0332)
    hidden method DoVirtualWords(const AType: int64; const AMember: int64);
    var
      LName: string;
      LMethod: bool;
      LAbove: int64;
      LUp: int64;
      LUpOwner: string;
      LTypeText: string;
    begin
      LName := self.FTree[AMember].Text;
      LMethod := self.FTree[AMember].Kind = NodeKind.MethodDecl;
      LTypeText := self.DoText(AType);
      if self.FTree[AMember].HasFlag(NodeFlag.Final) and (not self.DoIsVirtual(AMember)) then
        if LMethod then
          self.DoError(AMember, ADAM_ERR_SEMANTICS_336, ADAM_MSG_SEMANTICS_FINAL_NOT_VIRTUAL, NoArgs());
        else
          self.DoError(AMember, ADAM_ERR_SEMANTICS_336, ADAM_MSG_SEMANTICS_PROP_FINAL_NOT_VIRTUAL, NoArgs());
        end;
      end;
      if LMethod and self.FTree[AMember].HasFlag(NodeFlag.Abstract) and (not self.DoIsVirtual(AMember)) then
        self.DoError(AMember, ADAM_ERR_SEMANTICS_337, ADAM_MSG_SEMANTICS_ABSTRACT_NOT_VIRTUAL,
          NoArgs().Str(LName));
      end;
      if (not LMethod) and HasAbstractAccessor(self.FTree, AMember) and (not self.DoIsVirtual(AMember)) then
        self.DoError(AMember, ADAM_ERR_SEMANTICS_337, ADAM_MSG_SEMANTICS_PROP_ABSTRACT_NOT_VIRTUAL,
          NoArgs().Str(LName));
      end;
      LUp := 0;
      LAbove := ParentTypeOf(self.FTree, AType);
      if LAbove <> 0 then
        LUp := MemberOf(self.FTree, LAbove, LName);
      end;
      if (LUp <> 0) and ((self.FTree[LUp].Kind <> self.FTree[AMember].Kind) or (not self.DoIsVirtual(LUp))) then
        LUp := 0;
      end;
      if not self.FTree[AMember].HasFlag(NodeFlag.Override) then
        if LUp <> 0 then
          LUpOwner := self.DoText(self.DoDeclaringType(LUp));
          if LMethod then
            self.DoError(AMember, ADAM_ERR_SEMANTICS_332, ADAM_MSG_SEMANTICS_NEEDS_OVERRIDE,
              NoArgs().Str(LName).Str(LUpOwner).Str(LName));
          else
            self.DoError(AMember, ADAM_ERR_SEMANTICS_332, ADAM_MSG_SEMANTICS_PROP_NEEDS_OVERRIDE,
              NoArgs().Str(LName).Str(LUpOwner).Str(LName));
          end;
        end;
        return;
      end;
      if LUp = 0 then
        if LMethod then
          self.DoError(AMember, ADAM_ERR_SEMANTICS_333, ADAM_MSG_SEMANTICS_OVERRIDES_NOTHING,
            NoArgs().Str(LName).Str(LTypeText).Str(LName));
        else
          self.DoError(AMember, ADAM_ERR_SEMANTICS_333, ADAM_MSG_SEMANTICS_PROP_OVERRIDES_NOTHING,
            NoArgs().Str(LName).Str(LTypeText).Str(LName));
        end;
        return;
      end;
      LUpOwner := self.DoText(self.DoDeclaringType(LUp));
      if self.FTree[LUp].HasFlag(NodeFlag.Final) then
        self.DoError(AMember, ADAM_ERR_SEMANTICS_335, ADAM_MSG_SEMANTICS_OVERRIDE_FINAL,
          NoArgs().Str(LUpOwner).Str(LName));
        return;
      end;
      if not LMethod then
        if not self.DoSameProperty(AMember, LUp) then
          self.DoError(AMember, ADAM_ERR_SEMANTICS_334, ADAM_MSG_SEMANTICS_PROP_OVERRIDE_TYPE,
            NoArgs().Str(LName).Str(LUpOwner).Str(LName));
        end;
        return;
      end;
      if RoutineTypeOf(self.FTree, AMember) <> RoutineTypeOf(self.FTree, LUp) then
        self.DoError(AMember, ADAM_ERR_SEMANTICS_334, ADAM_MSG_SEMANTICS_OVERRIDE_SIGNATURE,
          NoArgs().Str(LName).Str(LUpOwner).Str(LName));
        return;
      end;
      if self.FTree[AMember].HasFlag(NodeFlag.ConstMethod) <> self.FTree[LUp].HasFlag(NodeFlag.ConstMethod) then
        self.DoError(AMember, ADAM_ERR_SEMANTICS_389, ADAM_MSG_SEMANTICS_CONST_DIFFERS,
          NoArgs().Str(LName).Str(self.DoConstWord(LUp)).Str(LName).Str(LUpOwner));
      end;
    end;

    // The object AType implements every method and property of the interface AInterface
    // and of its parent interfaces (BNF sec 4, implements; reports at ANameNode, the name
    // after implements): a member of AType or of a level above, of that kind (SM0364),
    // not hidden (SM0367), virtual or override (SM0365), with the same signature or shape
    // (SM0366) and const (SM0389)
    hidden method DoImplementsAll(const AType: int64; const AInterface: int64; const ANameNode: int64);
    var
      LLevel: int64;
      LDepth: int64;
      LBody: int64;
      LI: int64;
      LWant: int64;
    begin
      LLevel := AInterface;
      LDepth := 0;
      while (LLevel <> 0) and (LDepth <= ADAM_TYPES_MAX_DEPTH) do
        LBody := BodyOf(self.FTree, LLevel);
        if LBody = 0 then
          return;
        end;
        for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
          LWant := self.FTree.NthOf(LBody, NodeRole.Member, LI);
          if (self.FTree[LWant].Kind = NodeKind.MethodDecl) or (self.FTree[LWant].Kind = NodeKind.PropertyDecl) then
            self.DoImplementsOne(AType, LLevel, LWant, ANameNode);
          end;
        end;
        LLevel := ParentTypeOf(self.FTree, LLevel);
        LDepth := LDepth + 1;
      end;
    end;

    // The object AType implements the member AWant of the interface level ALevel (see
    // DoImplementsAll)
    hidden method DoImplementsOne(const AType: int64; const ALevel: int64; const AWant: int64;
      const ANameNode: int64);
    var
      LName: string;
      LHave: int64;
      LMethod: bool;
      LHaveOwner: string;
      LOwner: string;
    begin
      LName := self.FTree[AWant].Text;
      LMethod := self.FTree[AWant].Kind = NodeKind.MethodDecl;
      LOwner := self.DoText(ALevel);
      LHave := MemberOf(self.FTree, AType, LName);
      if (LHave = 0) or (self.FTree[LHave].Kind <> self.FTree[AWant].Kind) then
        if LMethod then
          self.DoError(ANameNode, ADAM_ERR_SEMANTICS_364, ADAM_MSG_SEMANTICS_MISSING_METHOD,
            NoArgs().Str(self.DoText(AType)).Str(LOwner).Str(LName).Str(LName));
        else
          self.DoError(ANameNode, ADAM_ERR_SEMANTICS_364, ADAM_MSG_SEMANTICS_MISSING_PROPERTY,
            NoArgs().Str(self.DoText(AType)).Str(LOwner).Str(LName).Str(LName));
        end;
        return;
      end;
      LHaveOwner := self.DoText(self.DoDeclaringType(LHave));
      if self.FTree[LHave].HasFlag(NodeFlag.Hidden) then
        self.DoError(ANameNode, ADAM_ERR_SEMANTICS_367, ADAM_MSG_SEMANTICS_IMPLEMENTS_HIDDEN,
          NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName));
        return;
      end;
      if not self.DoIsVirtual(LHave) then
        if LMethod then
          self.DoError(ANameNode, ADAM_ERR_SEMANTICS_365, ADAM_MSG_SEMANTICS_IMPLEMENTS_PLAIN,
            NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName).Str(LName));
        else
          self.DoError(ANameNode, ADAM_ERR_SEMANTICS_365, ADAM_MSG_SEMANTICS_IMPLEMENTS_PLAIN_PROPERTY,
            NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName).Str(LName));
        end;
        return;
      end;
      if not LMethod then
        if not self.DoSameProperty(LHave, AWant) then
          self.DoError(ANameNode, ADAM_ERR_SEMANTICS_366, ADAM_MSG_SEMANTICS_IMPLEMENTS_PROPERTY_SHAPE,
            NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName));
        end;
        return;
      end;
      if RoutineTypeOf(self.FTree, LHave) <> RoutineTypeOf(self.FTree, AWant) then
        self.DoError(ANameNode, ADAM_ERR_SEMANTICS_366, ADAM_MSG_SEMANTICS_IMPLEMENTS_SIGNATURE,
          NoArgs().Str(LHaveOwner).Str(LName).Str(LOwner).Str(LName));
        return;
      end;
      if self.FTree[LHave].HasFlag(NodeFlag.ConstMethod) <> self.FTree[AWant].HasFlag(NodeFlag.ConstMethod) then
        self.DoError(ANameNode, ADAM_ERR_SEMANTICS_389, ADAM_MSG_SEMANTICS_CONST_DIFFERS,
          NoArgs().Str(LName).Str(self.DoConstWord(AWant)).Str(LName).Str(LOwner));
      end;
    end;

    // An object type declaration AType with body ABody (BNF sec 4): its parent is not
    // final (SM0339); after implements interfaces only (SM0362), each once (SM0363),
    // each implemented in full (DoImplementsAll); its members' virtual words
    // (DoVirtualWords); its properties' bound fields (DoPropertyBindings) and default
    // (DoPropertyDefault); an embed holds a record, an overlay or an object (SM0369)
    hidden method DoObjectRules(const AType: int64; const ABody: int64);
    var
      LParentNode: int64;
      LParent: int64;
      LI: int64;
      LJ: int64;
      LNameNode: int64;
      LNamed: int64;
      LTwice: bool;
      LMember: int64;
      LKind: NodeKind;
      LEmbedType: int64;
      LClass: TypeClass;
      LDefault: int64;
    begin
      LDefault := 0;
      LParentNode := self.FTree.FirstOf(ABody, NodeRole.Parent);
      LParent := ParentTypeOf(self.FTree, AType);
      if (LParent <> 0) and (self.DoClass(LParent) = TypeClass.ObjectType) and IsFinalType(self.FTree, LParent) then
        self.DoError(LParentNode, ADAM_ERR_SEMANTICS_339, ADAM_MSG_SEMANTICS_FINAL_PARENT,
          NoArgs().Str(self.DoText(LParent)));
      end;
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Implements) - 1 do
        LNameNode := self.FTree.NthOf(ABody, NodeRole.Implements, LI);
        LNamed := CanonicalOf(self.FTree, LNameNode);
        if LNamed <> 0 then
          if self.DoClass(LNamed) <> TypeClass.InterfaceType then
            self.DoError(LNameNode, ADAM_ERR_SEMANTICS_362, ADAM_MSG_SEMANTICS_NOT_INTERFACE,
              NoArgs().Str(self.DoText(LNamed)));
          else
            LTwice := false;
            for LJ := 0 to LI - 1 do
              if CanonicalOf(self.FTree, self.FTree.NthOf(ABody, NodeRole.Implements, LJ)) = LNamed then
                LTwice := true;
              end;
            end;
            if LTwice then
              self.DoError(LNameNode, ADAM_ERR_SEMANTICS_363, ADAM_MSG_SEMANTICS_IMPLEMENTS_TWICE,
                NoArgs().Str(self.DoText(LNamed)).Str(self.DoText(AType)));
            else
              self.DoImplementsAll(AType, LNamed, LNameNode);
            end;
          end;
        end;
      end;
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        LKind := self.FTree[LMember].Kind;
        if (LKind = NodeKind.MethodDecl) or (LKind = NodeKind.PropertyDecl) then
          self.DoVirtualWords(AType, LMember);
        end;
        if LKind = NodeKind.PropertyDecl then
          self.DoPropertyBindings(AType, LMember);
          self.DoPropertyDefault(AType, LMember, LDefault);
        end;
        if LKind = NodeKind.EmbedDecl then
          LEmbedType := CanonicalOf(self.FTree, self.FTree.FirstOf(LMember, NodeRole.TypeOf));
          LClass := self.DoClass(LEmbedType);
          if (LEmbedType <> 0) and (LClass <> TypeClass.RecordType) and (LClass <> TypeClass.OverlayType) and
            (LClass <> TypeClass.ObjectType) then
            self.DoError(self.FTree.FirstOf(LMember, NodeRole.TypeOf), ADAM_ERR_SEMANTICS_369,
              ADAM_MSG_SEMANTICS_EMBED_TYPE, NoArgs().Str(self.FTree[LMember].Text).Str(self.DoText(LEmbedType)));
          end;
        end;
      end;
    end;

    // The bound accessors of the property AProperty of the object AType (BNF sec 4,
    // `read F` / `write F`): each names a field of AType's chain (SM0371) of the
    // property's type exactly (SM0372); the field is written to the accessor's
    // ResolvedDecl, the place Lowering reads it from. An accessor with a body, an
    // abstract one or one in an interface binds nothing; a write's value parameter
    // `write (AValue)` gets the property's type into its ResolvedType here, used or not
    // (DoDeclType)
    hidden method DoPropertyBindings(const AType: int64; const AProperty: int64);
    var
      LI: int64;
      LAccessor: int64;
      LField: int64;
      LPropertyType: int64;
      LFieldType: int64;
      LValue: int64;
    begin
      LAccessor := self.FTree.FirstOf(AProperty, NodeRole.Write);
      if LAccessor <> 0 then
        LValue := self.FTree.FirstOf(LAccessor, NodeRole.Param);
        if LValue <> 0 then
          self.DoDeclType(LValue);
        end;
      end;
      for LI := 0 to 1 do
        if LI = 0 then
          LAccessor := self.FTree.FirstOf(AProperty, NodeRole.Read);
        else
          LAccessor := self.FTree.FirstOf(AProperty, NodeRole.Write);
        end;
        if (LAccessor = 0) or (self.FTree[LAccessor].Text = "") then
          skip;
        end;
        LField := MemberOf(self.FTree, AType, self.FTree[LAccessor].Text);
        if (LField = 0) or (self.FTree[LField].Kind <> NodeKind.FieldDecl) then
          self.DoError(LAccessor, ADAM_ERR_SEMANTICS_371, ADAM_MSG_SEMANTICS_PROPERTY_NO_FIELD,
            NoArgs().Str(self.FTree[AProperty].Text).Str(self.FTree[LAccessor].Text).Str(self.DoText(AType)));
          skip;
        end;
        self.FTree[LAccessor].ResolvedDecl := LField;
        LPropertyType := self.DoDeclType(AProperty);
        LFieldType := self.DoDeclType(LField);
        if (LPropertyType <> 0) and (LFieldType <> 0) and (LPropertyType <> LFieldType) then
          self.DoError(LAccessor, ADAM_ERR_SEMANTICS_372, ADAM_MSG_SEMANTICS_PROPERTY_FIELD_TYPE,
            NoArgs().Str(self.FTree[AProperty].Text).Str(self.DoText(LPropertyType)).Str(
            self.FTree[LField].Text).Str(self.DoText(LFieldType)));
        end;
      end;
    end;

    // The default word of the property AProperty of the object AType (BNF sec 4:
    // `default` names the type's one indexed property X[i] means): on a property with
    // no index, or after ADefault (the type's default met so far, 0: none), SM0379;
    // otherwise AProperty becomes ADefault
    hidden method DoPropertyDefault(const AType: int64; const AProperty: int64; var ADefault: int64);
    begin
      if not self.FTree[AProperty].HasFlag(NodeFlag.DefaultProperty) then
        return;
      end;
      if self.FTree.FirstOf(AProperty, NodeRole.Param) = 0 then
        self.DoError(AProperty, ADAM_ERR_SEMANTICS_379, ADAM_MSG_SEMANTICS_PROPERTY_DEFAULT_INDEX,
          NoArgs().Str(self.FTree[AProperty].Text));
        return;
      end;
      if ADefault <> 0 then
        self.DoError(AProperty, ADAM_ERR_SEMANTICS_379, ADAM_MSG_SEMANTICS_PROPERTY_DEFAULT_TWICE,
          NoArgs().Str(self.FTree[AProperty].Text).Str(self.DoText(AType)).Str(self.FTree[ADefault].Text));
        return;
      end;
      ADefault := AProperty;
    end;

    // A type declaration AId: the type it declares into its ResolvedType; an object's and
    // an interface's own rules (DoObjectRules, DoInterfaceRules)
    hidden method DoTypeDecl(const AId: int64);
    var
      LType: int64;
      LBody: int64;
    begin
      LType := DeclaredTypeOf(self.FTree, AId);
      self.FTree[AId].ResolvedType := LType;
      LBody := self.FTree.FirstOf(AId, NodeRole.TypeOf);
      if (LType = 0) or (LBody = 0) then
        return;
      end;
      if self.FTree[LBody].Kind = NodeKind.ObjectType then
        self.DoObjectRules(LType, LBody);
      end;
      if self.FTree[LBody].Kind = NodeKind.InterfaceType then
        self.DoInterfaceRules(LType, LBody);
      end;
    end;

    // An interface type declaration AType with body ABody: a method its parent
    // interfaces already declare is not declared again (SM0368)
    hidden method DoInterfaceRules(const AType: int64; const ABody: int64);
    var
      LParent: int64;
      LI: int64;
      LMember: int64;
      LUp: int64;
    begin
      LParent := ParentTypeOf(self.FTree, AType);
      if LParent = 0 then
        return;
      end;
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(ABody, NodeRole.Member, LI);
        if self.FTree[LMember].Kind = NodeKind.MethodDecl then
          LUp := MemberOf(self.FTree, LParent, self.FTree[LMember].Text);
          if LUp <> 0 then
            self.DoError(LMember, ADAM_ERR_SEMANTICS_368, ADAM_MSG_SEMANTICS_INTERFACE_REPEAT,
              NoArgs().Str(self.FTree[LMember].Text).Str(self.DoText(AType)).Str(
              self.DoText(self.DoDeclaringType(LUp))));
          end;
        end;
      end;
    end;

    // The routine, method, init, operator or accessor whose body holds AId; 0 when none
    // does (a module's body, a test block)
    hidden const method DoEnclosingRoutine(const AId: int64): int64;
    var
      LAt: int64;
    begin
      LAt := self.FTree.ParentOf(AId);
      while LAt <> 0 do
        if IsRoutineLike(self.FTree[LAt].Kind) then
          return LAt;
        end;
        if self.FTree[LAt].Kind = NodeKind.Module then
          return 0;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // The type expression of what the routine-like ARoutine returns: its ReturnType, or
    // for a property's read accessor the property's type; 0 when it returns nothing
    hidden const method DoReturnTypeNode(const ARoutine: int64): int64;
    begin
      if ARoutine = 0 then
        return 0;
      end;
      if self.FTree[ARoutine].Kind = NodeKind.PropertyRead then
        return self.FTree.FirstOf(self.FTree.ParentOf(ARoutine), NodeRole.TypeOf);
      end;
      return self.FTree.FirstOf(ARoutine, NodeRole.ReturnType);
    end;

    // True when the way from AId out to AOuter, a node around it (0: as far as its
    // module), leaves a guard's finally body
    hidden const method DoCrossesFinally(const AId: int64; const AOuter: int64): bool;
    var
      LAt: int64;
      LParent: int64;
    begin
      LAt := AId;
      LParent := self.FTree.ParentOf(LAt);
      while (LParent <> 0) and (LParent <> AOuter) do
        if (self.FTree[LParent].Kind = NodeKind.GuardStatement) and
          (self.FTree.RoleOf(LAt) = NodeRole.Finally) then
          return true;
        end;
        if self.FTree[LParent].Kind = NodeKind.Module then
          return false;
        end;
        LAt := LParent;
        LParent := self.FTree.ParentOf(LAt);
      end;
      return false;
    end;

    // The innermost loop around the leave / skip AId in its own routine (AMatch: or
    // match, whichever is nearer); 0 when there is none
    hidden const method DoInnermostLoop(const AId: int64; const AMatch: bool): int64;
    var
      LAt: int64;
      LKind: NodeKind;
    begin
      LAt := self.FTree.ParentOf(AId);
      while LAt <> 0 do
        LKind := self.FTree[LAt].Kind;
        if (LKind = NodeKind.WhileStatement) or (LKind = NodeKind.ForStatement) or
          (LKind = NodeKind.RepeatStatement) then
          return LAt;
        end;
        if AMatch and (LKind = NodeKind.MatchStatement) then
          return LAt;
        end;
        if IsRoutineLike(LKind) or (LKind = NodeKind.Module) or (LKind = NodeKind.TestBlock) then
          return 0;
        end;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // leave / skip (BNF sec 5): leave leaves the innermost loop or match, skip continues
    // the innermost loop (a match between is passed by); the statement it leaves into its
    // ResolvedJump. None around it: SM0607 / SM0608; out of a finally body: SM0609
    hidden method DoJump(const AId: int64);
    var
      LLeave: bool;
      LTarget: int64;
      LWord: string;
    begin
      LLeave := self.FTree[AId].Kind = NodeKind.LeaveStatement;
      LTarget := self.DoInnermostLoop(AId, LLeave);
      if LTarget = 0 then
        if LLeave then
          self.DoError(AId, ADAM_ERR_SEMANTICS_607, ADAM_MSG_SEMANTICS_LEAVE_OUTSIDE, NoArgs());
        else
          self.DoError(AId, ADAM_ERR_SEMANTICS_608, ADAM_MSG_SEMANTICS_SKIP_OUTSIDE, NoArgs());
        end;
        return;
      end;
      if self.DoCrossesFinally(AId, LTarget) then
        LWord := "skip";
        if LLeave then
          LWord := "leave";
        end;
        self.DoError(AId, ADAM_ERR_SEMANTICS_609, ADAM_MSG_SEMANTICS_JUMP_FINALLY,
          NoArgs().Str(LWord));
        return;
      end;
      self.FTree[AId].ResolvedJump := LTarget;
    end;

    // True when the expression statement AId is a call that never returns: of the raise or
    // raisecode intrinsic, or of a routine written noreturn (its full or its forward: they
    // agree, DoRoutineFact)
    hidden const method DoIsEndingCall(const AId: int64): bool;
    var
      LValue: int64;
      LCallee: int64;
      LKind: NodeKind;
    begin
      LValue := self.FTree.FirstOf(AId, NodeRole.Value);
      if (LValue = 0) or (self.FTree[LValue].Kind <> NodeKind.CallExpression) then
        return false;
      end;
      LCallee := self.DoCalleeDecl(self.FTree.FirstOf(LValue, NodeRole.Callee));
      if LCallee = 0 then
        return false;
      end;
      LKind := self.FTree[LCallee].Kind;
      if LKind = NodeKind.IntrinsicDecl then
        return (self.FTree[LCallee].Text = "raise") or (self.FTree[LCallee].Text = "raisecode");
      end;
      return ((LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine)) and
        self.FTree[LCallee].HasFlag(NodeFlag.NoReturn);
    end;

    // True when some leave under AAt leaves the loop ALoop (its ResolvedJump: a leave
    // leaves the innermost loop or match, so one in a nested loop or match leaves that one)
    hidden const method DoLeaves(const AAt: int64; const ALoop: int64): bool;
    var
      LI: int64;
    begin
      if (self.FTree[AAt].Kind = NodeKind.LeaveStatement) and
        (self.FTree[AAt].ResolvedJump = ALoop) then
        return true;
      end;
      for LI := 0 to self.FTree.ChildCount(AAt) - 1 do
        if self.DoLeaves(self.FTree.ChildAt(AAt, LI), ALoop) then
          return true;
        end;
      end;
      return false;
    end;

    // True when the while statement AId never completes: its condition is the literal true
    // (in parentheses or not) and no leave leaves it (a return, a raise or a noreturn call
    // in it ends the routine, not the loop)
    hidden const method DoIsEndless(const AId: int64): bool;
    var
      LCondition: int64;
    begin
      LCondition := self.DoSkipParens(self.FTree.FirstOf(AId, NodeRole.Condition));
      if (LCondition = 0) or (self.FTree[LCondition].Kind <> NodeKind.BoolLiteral) or
        (self.FTree[LCondition].Text <> "true") then
        return false;
      end;
      return not self.DoLeaves(AId, AId);
    end;

    // True when a statement of AId's ARole list ends the path (DoStatementEnds): the list
    // then never completes. An empty list completes
    hidden const method DoListEnds(const AId: int64; const ARole: NodeRole): bool;
    var
      LI: int64;
    begin
      for LI := 0 to self.FTree.CountOf(AId, ARole) - 1 do
        if self.DoStatementEnds(self.FTree.NthOf(AId, ARole, LI)) then
          return true;
        end;
      end;
      return false;
    end;

    // True when control never reaches the statement after AId: a return, a call that never
    // returns (DoIsEndingCall), a leave or a skip, a while that never completes
    // (DoIsEndless), or a compound statement none of whose ways out completes (a block or
    // lock whose list ends; an if with an else, both lists ending; a match with an else,
    // the else and every arm ending; a guard whose statements end, its except part too when
    // it has one; a trylock whose statements and else both end)
    hidden const method DoStatementEnds(const AId: int64): bool;
    var
      LI: int64;
    begin
      match self.FTree[AId].Kind of
        NodeKind.ReturnStatement, NodeKind.LeaveStatement, NodeKind.SkipStatement:
          return true;
        NodeKind.ExpressionStatement:
          return self.DoIsEndingCall(AId);
        NodeKind.WhileStatement:
          return self.DoIsEndless(AId);
        NodeKind.Block, NodeKind.LockStatement:
          return self.DoListEnds(AId, NodeRole.Statement);
        NodeKind.IfStatement:
          return self.DoListEnds(AId, NodeRole.Then) and self.DoListEnds(AId, NodeRole.Else);
        NodeKind.MatchStatement:
          if not self.DoListEnds(AId, NodeRole.Else) then
            return false;
          end;
          for LI := 0 to self.FTree.CountOf(AId, NodeRole.Arm) - 1 do
            if not self.DoListEnds(self.FTree.NthOf(AId, NodeRole.Arm, LI), NodeRole.Statement) then
              return false;
            end;
          end;
          return true;
        NodeKind.GuardStatement:
          if not self.DoListEnds(AId, NodeRole.Statement) then
            return false;
          end;
          return (not self.FTree[AId].HasFlag(NodeFlag.ExceptPart)) or
            self.DoListEnds(AId, NodeRole.Except);
        NodeKind.TryLockStatement:
          return self.DoListEnds(AId, NodeRole.Statement) and
            self.DoListEnds(AId, NodeRole.Else);
      else
        // any other statement can complete normally
      end;
      return false;
    end;

    // True when the statement list of AId playing ARole provably returns: the first of its
    // statements that ends the path (DoStatementEnds) returns; the ones after it never run
    // (SM0622), so they cannot make it return or fall through. An empty list does not
    // return; a list holding a statement the parser could not finish is not judged (that
    // one may have returned)
    hidden const method DoListReturns(const AId: int64; const ARole: NodeRole): bool;
    var
      LCount: int64;
      LI: int64;
      LStatement: int64;
    begin
      LCount := self.FTree.CountOf(AId, ARole);
      for LI := 0 to LCount - 1 do
        LStatement := self.FTree.NthOf(AId, ARole, LI);
        if (self.FTree[LStatement].Kind = NodeKind.Error) or
          self.FTree[LStatement].HasFlag(NodeFlag.Recovered) then
          return true;
        end;
      end;
      for LI := 0 to LCount - 1 do
        LStatement := self.FTree.NthOf(AId, ARole, LI);
        if self.DoStatementEnds(LStatement) then
          return self.DoStatementReturns(LStatement);
        end;
      end;
      return false;
    end;

    // SM0622 (a warning) at the first statement of AId's ARole list that follows one that
    // ends the path (DoStatementEnds): it never runs. Once per list (the first dead
    // statement names the whole dead tail); a list holding a statement the parser could not
    // finish is not judged
    hidden method DoUnreachableIn(const AId: int64; const ARole: NodeRole);
    var
      LCount: int64;
      LI: int64;
      LStatement: int64;
    begin
      LCount := self.FTree.CountOf(AId, ARole);
      if LCount < 2 then
        return;
      end;
      for LI := 0 to LCount - 1 do
        LStatement := self.FTree.NthOf(AId, ARole, LI);
        if (self.FTree[LStatement].Kind = NodeKind.Error) or
          self.FTree[LStatement].HasFlag(NodeFlag.Recovered) then
          return;
        end;
      end;
      for LI := 0 to LCount - 2 do
        if self.DoStatementEnds(self.FTree.NthOf(AId, ARole, LI)) then
          self.FDiagnostics.Add(Severity.Warning, ADAM_ERR_SEMANTICS_622,
            self.FTree[self.FTree.NthOf(AId, ARole, LI + 1)].Place,
            ADAM_MSG_SEMANTICS_UNREACHABLE, NoArgs());
          return;
        end;
      end;
    end;

    // Every statement list AId holds checked for a dead tail (DoUnreachableIn), once its
    // statements are typed (a raise or noreturn call's callee resolved, a leave's loop); a
    // match checks its arms' lists (an arm is never judged on its own, so no list is judged
    // twice)
    hidden method DoUnreachable(const AId: int64);
    var
      LI: int64;
    begin
      if self.FTree[AId].Kind = NodeKind.MatchArm then
        return;
      end;
      self.DoUnreachableIn(AId, NodeRole.Statement);
      self.DoUnreachableIn(AId, NodeRole.Then);
      self.DoUnreachableIn(AId, NodeRole.Else);
      self.DoUnreachableIn(AId, NodeRole.Except);
      self.DoUnreachableIn(AId, NodeRole.Finally);
      if self.FTree[AId].Kind = NodeKind.MatchStatement then
        for LI := 0 to self.FTree.CountOf(AId, NodeRole.Arm) - 1 do
          self.DoUnreachableIn(self.FTree.NthOf(AId, NodeRole.Arm, LI), NodeRole.Statement);
        end;
      end;
    end;

    // True when the statement AId provably returns (PaskalCPP's DoStmtReturns): a return;
    // a call that never returns (DoIsEndingCall) or a while that never completes
    // (DoIsEndless), neither of which falls through; a block whose list returns; an if with
    // an else, both lists returning; a match with an else, the else and every arm
    // returning; a guard whose statements return, and its except part too when it has one
    hidden const method DoStatementReturns(const AId: int64): bool;
    var
      LI: int64;
    begin
      match self.FTree[AId].Kind of
        NodeKind.ReturnStatement:
          return true;
        NodeKind.ExpressionStatement:
          return self.DoIsEndingCall(AId);
        NodeKind.WhileStatement:
          return self.DoIsEndless(AId);
        NodeKind.Block:
          return self.DoListReturns(AId, NodeRole.Statement);
        NodeKind.IfStatement:
          return self.DoListReturns(AId, NodeRole.Then) and self.DoListReturns(AId, NodeRole.Else);
        NodeKind.MatchStatement:
          // No else, or an else that does not return: some value falls through
          if not self.DoListReturns(AId, NodeRole.Else) then
            return false;
          end;
          for LI := 0 to self.FTree.CountOf(AId, NodeRole.Arm) - 1 do
            if not self.DoListReturns(self.FTree.NthOf(AId, NodeRole.Arm, LI), NodeRole.Statement) then
              return false;
            end;
          end;
          return true;
        NodeKind.GuardStatement:
          if not self.DoListReturns(AId, NodeRole.Statement) then
            return false;
          end;
          return (not self.FTree[AId].HasFlag(NodeFlag.ExceptPart)) or
            self.DoListReturns(AId, NodeRole.Except);
        NodeKind.LockStatement:
          return self.DoListReturns(AId, NodeRole.Statement);
        NodeKind.TryLockStatement:
          // Not taken, the else statements run (none: it falls through)
          return self.DoListReturns(AId, NodeRole.Statement) and
            self.DoListReturns(AId, NodeRole.Else);
      else
        // any other statement can complete normally
      end;
      return false;
    end;

    // SM0624 at each return under AAt, the body (or a part of it) of the noreturn routine
    // ARoutine: it never returns to its caller
    hidden method DoNoReturnReturns(const AAt: int64; const ARoutine: int64);
    var
      LI: int64;
    begin
      if self.FTree[AAt].Kind = NodeKind.ReturnStatement then
        self.DoError(AAt, ADAM_ERR_SEMANTICS_624, ADAM_MSG_SEMANTICS_NORETURN_RETURN,
          NoArgs().Str(self.FTree[ARoutine].Text));
        return;
      end;
      for LI := 0 to self.FTree.ChildCount(AAt) - 1 do
        self.DoNoReturnReturns(self.FTree.ChildAt(AAt, LI), ARoutine);
      end;
    end;

    // The body LBody of the noreturn routine AId: SM0624 at each return in it, SM0623 at the
    // declaration when the body can reach its end (no statement of it ends the path:
    // DoListEnds). A body holding a statement the parser could not finish is not judged for
    // its end (that one may have ended it)
    hidden method DoNoReturnBody(const AId: int64; const ABody: int64);
    var
      LI: int64;
      LStatement: int64;
    begin
      self.DoNoReturnReturns(ABody, AId);
      for LI := 0 to self.FTree.CountOf(ABody, NodeRole.Statement) - 1 do
        LStatement := self.FTree.NthOf(ABody, NodeRole.Statement, LI);
        if (self.FTree[LStatement].Kind = NodeKind.Error) or
          self.FTree[LStatement].HasFlag(NodeFlag.Recovered) then
          return;
        end;
      end;
      if not self.DoListEnds(ABody, NodeRole.Statement) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_623, ADAM_MSG_SEMANTICS_NORETURN_END,
          NoArgs().Str(self.FTree[AId].Text));
      end;
    end;

    // A routine, method or operator AId with a body: a noreturn one's body checked
    // (DoNoReturnBody, which covers a result too: it never reaches its end); else, with a
    // result type, SM0612 at its declaration when its body can reach its end without
    // returning a value
    hidden method DoReturnPath(const AId: int64);
    var
      LBody: int64;
    begin
      LBody := self.FTree.FirstOf(AId, NodeRole.Body);
      if LBody = 0 then
        return;
      end;
      if self.FTree[AId].HasFlag(NodeFlag.NoReturn) then
        self.DoNoReturnBody(AId, LBody);
        return;
      end;
      if self.FTree.FirstOf(AId, NodeRole.ReturnType) = 0 then
        return;
      end;
      if self.DoListReturns(LBody, NodeRole.Statement) then
        return;
      end;
      self.DoError(AId, ADAM_ERR_SEMANTICS_612, ADAM_MSG_SEMANTICS_MISSING_RETURN,
        NoArgs().Str(self.FTree[AId].Text));
    end;

    // A routine, method or operator AId whose result type holds a mutex: SM0621 at the
    // result type (a mutex is never copied, so no call hands one back)
    hidden method DoMutexResult(const AId: int64);
    var
      LResult: int64;
      LType: int64;
    begin
      LResult := self.FTree.FirstOf(AId, NodeRole.ReturnType);
      if LResult = 0 then
        return;
      end;
      LType := CanonicalOf(self.FTree, LResult);
      if (LType <> 0) and HoldsMutex(self.FTree, LType) then
        self.DoError(LResult, ADAM_ERR_SEMANTICS_621, ADAM_MSG_SEMANTICS_MUTEX_RESULT,
          NoArgs().Str(self.FTree[AId].Text).Str(self.DoText(LType)));
      end;
    end;

    // True when AExpr is a place a lock / trylock holds (BNF sec 5): assignable storage of
    // type mutex (a variable, a field, an element, P^; a property has no address)
    hidden const method DoIsMutexPlace(const AExpr: int64): bool;
    var
      LAt: int64;
      LDecl: int64;
    begin
      if self.DoIsNoValue(AExpr) or (not self.DoIsAssignable(AExpr)) then
        return false;
      end;
      LAt := self.DoSkipParens(AExpr);
      LDecl := self.FTree[LAt].ResolvedDecl;
      if (LDecl <> 0) and (self.FTree[LDecl].Kind = NodeKind.PropertyDecl) then
        return false;
      end;
      return self.DoClass(self.DoTypeOf(AExpr)) = TypeClass.Mutex;
    end;

    // A lock / trylock statement AId (BNF sec 5): its subject a mutex place (DoIsMutexPlace;
    // SM0620 naming the statement and the subject otherwise, silent on a subject whose type
    // was lost); trylock's wait (its Limit) converted to int64
    hidden method DoLock(const AId: int64);
    var
      LSubject: int64;
      LLimit: int64;
      LWord: string;
    begin
      LLimit := self.FTree.FirstOf(AId, NodeRole.Limit);
      if LLimit <> 0 then
        self.DoConvert(LLimit, self.DoBuiltin("int64"));
      end;
      LSubject := self.FTree.FirstOf(AId, NodeRole.Subject);
      if (LSubject = 0) or self.DoIsMutexPlace(LSubject) then
        return;
      end;
      if (not self.DoIsNoValue(LSubject)) and (self.DoTypeOf(LSubject) = 0) then
        return;
      end;
      LWord := "lock";
      if self.FTree[AId].Kind = NodeKind.TryLockStatement then
        LWord := "trylock";
      end;
      self.DoError(LSubject, ADAM_ERR_SEMANTICS_620, ADAM_MSG_SEMANTICS_LOCK_SUBJECT,
        NoArgs().Str(LWord).Str(self.DoExprText(LSubject)));
    end;

    // return [value]: the routine it leaves into its ResolvedJump; the value converts to
    // what that routine returns (a read accessor: its property's type). A value where the
    // routine returns nothing is SM0611 (a module body or a test block returns nothing),
    // none where it returns one SM0610, out of a finally body SM0609
    hidden method DoReturn(const AId: int64);
    var
      LRoutine: int64;
      LReturnNode: int64;
      LReturn: int64;
      LValue: int64;
    begin
      self.DoChildren(AId);
      LRoutine := self.DoEnclosingRoutine(AId);
      if self.DoCrossesFinally(AId, LRoutine) then
        self.DoError(AId, ADAM_ERR_SEMANTICS_609, ADAM_MSG_SEMANTICS_JUMP_FINALLY,
          NoArgs().Str("return"));
        return;
      end;
      self.FTree[AId].ResolvedJump := LRoutine;
      LValue := self.FTree.FirstOf(AId, NodeRole.Value);
      LReturnNode := self.DoReturnTypeNode(LRoutine);
      if LReturnNode = 0 then
        if LValue <> 0 then
          self.DoError(LValue, ADAM_ERR_SEMANTICS_611, ADAM_MSG_SEMANTICS_RETURN_NO_VALUE, NoArgs());
        end;
        return;
      end;
      LReturn := CanonicalOf(self.FTree, LReturnNode);
      if LReturn = 0 then
        // The return type was lost (reported where it was)
        return;
      end;
      if LValue = 0 then
        self.DoError(AId, ADAM_ERR_SEMANTICS_610, ADAM_MSG_SEMANTICS_RETURN_NEEDS,
          NoArgs().Str(self.DoText(LReturn)));
        return;
      end;
      self.DoOwnMoves(LValue, true);
      self.DoConvert(LValue, LReturn);
    end;

    // What the for iterator's name ADecl is when it is no variable (SM0600's second part);
    // "" for a var or a parameter that is not const (BNF sec 5: a variable declared before
    // the loop)
    hidden const method DoNotVariableText(const ADecl: int64): string;
    var
      LKind: NodeKind;
    begin
      LKind := self.FTree[ADecl].Kind;
      if LKind = NodeKind.VarDecl then
        return "";
      end;
      if LKind = NodeKind.Param then
        if self.FTree[ADecl].HasFlag(NodeFlag.ConstParam) then
          return ADAM_MSG_SEMANTICS_KIND_CONST_PARAM;
        end;
        return "";
      end;
      if LKind = NodeKind.ConstDecl then
        return ADAM_MSG_SEMANTICS_KIND_CONST;
      end;
      if (LKind = NodeKind.TypeDecl) or (LKind = NodeKind.BuiltinTypeDecl) or
        (LKind = NodeKind.ForwardType) then
        return ADAM_MSG_SEMANTICS_KIND_TYPE;
      end;
      if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.ForwardRoutine) or
        (LKind = NodeKind.IntrinsicDecl) then
        return ADAM_MSG_SEMANTICS_KIND_ROUTINE;
      end;
      // A member (field, method, property) or a choice value named bare never resolves:
      // the resolver reports it (SM0018 / SM0015)
      return ADAM_MSG_SEMANTICS_KIND_OTHER;
    end;

    // The for statement whose body AId stands in (at any depth, inside its own routine) and
    // whose iterator names ADecl; 0 when there is none. Only the body counts: a for's
    // bounds are evaluated before its loop begins
    hidden const method DoLoopOver(const AId: int64; const ADecl: int64): int64;
    var
      LChild: int64;
      LAt: int64;
      LKind: NodeKind;
    begin
      LChild := AId;
      LAt := self.FTree.ParentOf(AId);
      while LAt <> 0 do
        LKind := self.FTree[LAt].Kind;
        if (LKind = NodeKind.ForStatement) and (self.FTree.RoleOf(LChild) = NodeRole.Statement) and
          (self.FTree[self.FTree.FirstOf(LAt, NodeRole.Iterator)].ResolvedDecl = ADecl) then
          return LAt;
        end;
        if IsRoutineLike(LKind) or (LKind = NodeKind.Module) or (LKind = NodeKind.TestBlock) then
          return 0;
        end;
        LChild := LAt;
        LAt := self.FTree.ParentOf(LAt);
      end;
      return 0;
    end;

    // The for AFor's iterator AIterator (BNF sec 5): a variable (SM0600) that is not already
    // the iterator of a for AFor stands in (a nested for over it writes it: SM0602), of an
    // integer, char, wchar or choices type (SM0601); each reported at AFor. False when the
    // bounds have no iterator type to convert to (a name or type lost before included)
    hidden method DoIsIterator(const AFor: int64; const AIterator: int64): bool;
    var
      LDecl: int64;
      LKind: string;
      LType: int64;
      LClass: TypeClass;
    begin
      LDecl := self.FTree[AIterator].ResolvedDecl;
      if LDecl = 0 then
        // Found nowhere: reported where it was resolved (a bare module name included)
        return false;
      end;
      LKind := self.DoNotVariableText(LDecl);
      if LKind <> "" then
        self.DoError(AFor, ADAM_ERR_SEMANTICS_600, ADAM_MSG_SEMANTICS_FOR_NOT_VAR,
          NoArgs().Str(self.FTree[AIterator].Text).Str(LKind));
        return false;
      end;
      if self.DoLoopOver(AFor, LDecl) <> 0 then
        self.DoError(AFor, ADAM_ERR_SEMANTICS_602, ADAM_MSG_SEMANTICS_ITERATOR_WRITE,
          NoArgs().Str(self.FTree[AIterator].Text));
      end;
      LType := self.DoTypeOf(AIterator);
      LClass := self.DoClass(LType);
      if LClass = TypeClass.Unknown then
        return false;
      end;
      if IsIntegerClass(LClass) or (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) or
        (LClass = TypeClass.ChoicesType) then
        return true;
      end;
      self.DoError(AFor, ADAM_ERR_SEMANTICS_601, ADAM_MSG_SEMANTICS_FOR_TYPE,
        NoArgs().Str(self.DoText(LType)));
      return false;
    end;

    // A write SEM can see to ATarget (an assignment, ++ / --, a var argument): when it names
    // the iterator of a for it stands in, SM0602 at the write (the loop owns its iterator; a
    // write through a pointer is not seen)
    hidden method DoIteratorWritten(const ATarget: int64);
    var
      LName: int64;
      LDecl: int64;
    begin
      LName := self.DoSkipParens(ATarget);
      if (LName = 0) or (self.FTree[LName].Kind <> NodeKind.NameExpression) then
        return;
      end;
      LDecl := self.FTree[LName].ResolvedDecl;
      if (LDecl <> 0) and (self.DoLoopOver(LName, LDecl) <> 0) then
        self.DoError(LName, ADAM_ERR_SEMANTICS_602, ADAM_MSG_SEMANTICS_ITERATOR_WRITE,
          NoArgs().Str(self.FTree[LName].Text));
      end;
    end;

    // for I := A to|downto B: I checked (DoIsIterator), then A and B convert to I's type
    hidden method DoFor(const AId: int64);
    var
      LIterator: int64;
      LType: int64;
    begin
      self.DoChildren(AId);
      LIterator := self.FTree.FirstOf(AId, NodeRole.Iterator);
      if not self.DoIsIterator(AId, LIterator) then
        return;
      end;
      LType := self.DoTypeOf(LIterator);
      self.DoConvert(self.FTree.FirstOf(AId, NodeRole.Start), LType);
      self.DoConvert(self.FTree.FirstOf(AId, NodeRole.Limit), LType);
    end;

    // The type of the typed match subject ASubject when it is one a match takes (an
    // integer, char, wchar or a choice; a string or a wstring, BNF sec 5); SM0603
    // otherwise. 0 = nothing to check the labels against (an unknown subject was reported
    // where it was lost)
    hidden method DoMatchSubject(const ASubject: int64): int64;
    var
      LType: int64;
      LClass: TypeClass;
    begin
      LType := self.DoTypeOf(ASubject);
      if LType = 0 then
        return 0;
      end;
      LClass := self.DoClass(LType);
      if IsIntegerClass(LClass) or (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) or
        (LClass = TypeClass.ChoicesType) or (LClass = TypeClass.Text) or
        (LClass = TypeClass.WideText) then
        return LType;
      end;
      self.DoError(ASubject, ADAM_ERR_SEMANTICS_603, ADAM_MSG_SEMANTICS_MATCH_SUBJECT,
        NoArgs().Str(self.DoText(LType)));
      return 0;
    end;

    // True when the values of AType (a match subject's, a bitfield's) are unsigned: an
    // unsigned integer, and a char or wchar the target makes unsigned (IsCharTypeSigned); a
    // signed integer and a choice are signed. Lowering's compares and bitfield reads make
    // the same split
    hidden const method DoUnsignedValues(const AType: int64): bool;
    var
      LClass: TypeClass;
    begin
      LClass := self.DoClass(AType);
      if (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) then
        return not IsCharTypeSigned(self.FTree, self.FTarget, AType);
      end;
      return LClass = TypeClass.UnsignedInt;
    end;

    // The folded value of the constant AId (a match label bound, a choice value, a value
    // stored into a bitfield) as its 64 bits into ABits (an integer, a char's code, a
    // choice's number, a bool's 0 / 1); false when it holds none of those. Under a char or
    // wchar type AType the code is read at the width and sign the target gives it (a char's
    // stored code is its low bits: char(200) is -56 where char is signed), so the value is
    // the one a value of AType holds
    hidden const method DoFoldedBits(const AId: int64; const AType: int64; var ABits: int64): bool;
    var
      LConst: ConstValue;
      LClass: TypeClass;
    begin
      ABits := 0;
      LConst := self.FTree[AId].ResolvedConst;
      match LConst.Kind of
        ConstKind.Signed, ConstKind.Unsigned, ConstKind.Char, ConstKind.Boolean:
          ABits := int64(LConst.Bits);
      else
        // no other constant is a label value
        return false;
      end;
      LClass := self.DoClass(AType);
      if (LClass = TypeClass.Char) or (LClass = TypeClass.WideChar) then
        ABits := ReadLowBits(ABits, CharTypeBits(self.FTree, self.FTarget, AType),
          IsCharTypeSigned(self.FTree, self.FTarget, AType));
      end;
      return true;
    end;

    // AFirst < ASecond for two label values, unsigned when AUnsigned (DoUnsignedValues)
    hidden const method DoLabelLess(const AFirst: int64; const ASecond: int64; const AUnsigned: bool): bool;
    begin
      if AUnsigned then
        return uint64(AFirst) < uint64(ASecond);
      end;
      return AFirst < ASecond;
    end;

    // The match label ALabel as written: low, or low..high
    hidden const method DoLabelText(const ALabel: int64): string;
    var
      LText: string;
      LHigh: int64;
    begin
      LText := self.DoExprText(self.FTree.FirstOf(ALabel, NodeRole.LowBound));
      LHigh := self.FTree.FirstOf(ALabel, NodeRole.HighBound);
      if LHigh <> 0 then
        LText := LText + ".." + self.DoExprText(LHigh);
      end;
      return LText;
    end;

    // One typed label bound ABound against the subject type AType (0: no subject to check
    // against). A constant (SM0202); a known value outside an integer subject's range never
    // matches (SM0604, before the conversion, whose SM0200 would only name the types); then
    // it converts (a choice subject takes values of that choice only). True = its value is
    // known and nothing was reported
    hidden method DoLabelBound(const ABound: int64; const AType: int64): bool;
    var
      LNegative: bool;
      LMagnitude: uint64;
      LBits: int64;
    begin
      if ABound = 0 then
        return false;
      end;
      if self.FTree[ABound].ResolvedConst.Kind = ConstKind.Unknown then
        // A bound with no type was reported where it was lost
        if self.FTree[ABound].ResolvedType <> 0 then
          self.DoError(ABound, ADAM_ERR_SEMANTICS_202, ADAM_MSG_SEMANTICS_NOT_CONSTANT,
            NoArgs().Str(ADAM_MSG_SEMANTICS_POS_LABEL));
        end;
        return false;
      end;
      if AType = 0 then
        return false;
      end;
      if IsIntegerClass(self.DoClass(AType)) and ConstIntOf(self.FTree, ABound, LNegative, LMagnitude) and
        (not IntFits(self.FTree, AType, LNegative, LMagnitude)) then
        self.DoError(ABound, ADAM_ERR_SEMANTICS_604, ADAM_MSG_SEMANTICS_LABEL_RANGE,
          NoArgs().Str(ConstIntText(LNegative, LMagnitude)).Str(self.DoText(AType)));
        return false;
      end;
      if not self.DoConvert(ABound, AType) then
        return false;
      end;
      return self.DoFoldedBits(ABound, AType, LBits);
    end;

    // The match label ALabel (its bounds typed) against the subject type AType: each bound
    // by DoLabelBound; a known range low > high is SM0267 (an empty range covers nothing);
    // a label sharing a value with an earlier known one is SM0605 naming the first. ASpans
    // holds the known labels so far, three entries each (low, high, label node); a known
    // label that repeats nothing is added. True = the label's values are known (the
    // coverage check counts it)
    hidden method DoMatchLabel(const ALabel: int64; const AType: int64; const ASpans: ref NodeList): bool;
    var
      LLow: int64;
      LHigh: int64;
      LLowKnown: bool;
      LHighKnown: bool;
      LLowBits: int64;
      LHighBits: int64;
      LUnsigned: bool;
      LI: int64;
      LFirst: int64;
    begin
      if (AType <> 0) and ((self.DoClass(AType) = TypeClass.Text) or
        (self.DoClass(AType) = TypeClass.WideText)) then
        return self.DoStringMatchLabel(ALabel, AType, ASpans);
      end;
      LLow := self.FTree.FirstOf(ALabel, NodeRole.LowBound);
      LHigh := self.FTree.FirstOf(ALabel, NodeRole.HighBound);
      LLowKnown := self.DoLabelBound(LLow, AType);
      LHighKnown := true;
      if LHigh <> 0 then
        LHighKnown := self.DoLabelBound(LHigh, AType);
      else
        LHigh := LLow;
      end;
      if (not LLowKnown) or (not LHighKnown) then
        return false;
      end;
      self.DoFoldedBits(LLow, AType, LLowBits);
      self.DoFoldedBits(LHigh, AType, LHighBits);
      LUnsigned := self.DoUnsignedValues(AType);
      if self.DoLabelLess(LHighBits, LLowBits, LUnsigned) then
        self.DoError(LLow, ADAM_ERR_SEMANTICS_267, ADAM_MSG_SEMANTICS_LOW_HIGH,
          NoArgs().Str(self.DoExprText(LLow)).Str(self.DoExprText(LHigh)));
        return true;
      end;
      for LI := 0 to (ASpans.Count div 3) - 1 do
        // Two closed ranges share a value unless one ends before the other starts
        if not (self.DoLabelLess(LHighBits, ASpans[LI * 3], LUnsigned) or
          self.DoLabelLess(ASpans[LI * 3 + 1], LLowBits, LUnsigned)) then
          LFirst := ASpans[LI * 3 + 2];
          self.DoError(LLow, ADAM_ERR_SEMANTICS_605, ADAM_MSG_SEMANTICS_LABEL_REPEAT,
            NoArgs().Str(self.DoLabelText(ALabel)).Str(self.DoLabelText(LFirst)).Int(
            int64(self.FTree[LFirst].Place.Line)));
          return true;
        end;
      end;
      ASpans.Add(LLowBits);
      ASpans.Add(LHighBits);
      ASpans.Add(ALabel);
      return true;
    end;

    // The label ALabel of a match on a string or wstring (the subject type AType, BNF sec 5):
    // one string constant of the subject's width, compared exactly. A range is SM0613; a
    // bound that is no constant SM0202; one that does not convert to AType (a char, an
    // integer: only a string constant converts) reports there (SM0200); the same text as an
    // earlier label SM0605 naming the first. ASpans keeps DoMatchLabel's three entries per known
    // label (0, 0, the label node: its text is its bound's folded string). True = the
    // label's text is known
    hidden method DoStringMatchLabel(const ALabel: int64; const AType: int64;
      const ASpans: ref NodeList): bool;
    var
      LLow: int64;
      LHigh: int64;
      LFirst: int64;
      LI: int64;
    begin
      LLow := self.FTree.FirstOf(ALabel, NodeRole.LowBound);
      LHigh := self.FTree.FirstOf(ALabel, NodeRole.HighBound);
      if LHigh <> 0 then
        self.DoError(LHigh, ADAM_ERR_SEMANTICS_613, ADAM_MSG_SEMANTICS_STRING_LABEL_RANGE,
          NoArgs().Str(self.DoText(AType)));
        return false;
      end;
      if self.FTree[LLow].ResolvedConst.Kind = ConstKind.Unknown then
        // A bound with no type was reported where it was lost
        if self.FTree[LLow].ResolvedType <> 0 then
          self.DoError(LLow, ADAM_ERR_SEMANTICS_202, ADAM_MSG_SEMANTICS_NOT_CONSTANT,
            NoArgs().Str(ADAM_MSG_SEMANTICS_POS_LABEL));
        end;
        return false;
      end;
      if not self.DoConvert(LLow, AType) then
        return false;
      end;
      for LI := 0 to (ASpans.Count div 3) - 1 do
        LFirst := ASpans[LI * 3 + 2];
        if self.FTree[self.FTree.FirstOf(LFirst, NodeRole.LowBound)].ResolvedConst.Text =
          self.FTree[LLow].ResolvedConst.Text then
          self.DoError(LLow, ADAM_ERR_SEMANTICS_605, ADAM_MSG_SEMANTICS_LABEL_REPEAT,
            NoArgs().Str(self.DoLabelText(ALabel)).Str(self.DoLabelText(LFirst)).Int(
            int64(self.FTree[LFirst].Place.Line)));
          return true;
        end;
      end;
      ASpans.Add(0);
      ASpans.Add(0);
      ASpans.Add(ALabel);
      return true;
    end;

    // The match arm AArm against the subject type AType: its children in source order,
    // each label checked as it is met (DoMatchLabel), then its statements. True = every
    // label's values are known
    hidden method DoMatchArm(const AArm: int64; const AType: int64; const ASpans: ref NodeList): bool;
    var
      LI: int64;
      LChild: int64;
      LKnown: bool;
    begin
      LKnown := true;
      for LI := 0 to self.FTree.ChildCount(AArm) - 1 do
        LChild := self.FTree.ChildAt(AArm, LI);
        self.DoVisit(LChild);
        if (self.FTree[LChild].Kind = NodeKind.MatchLabel) and
          (not self.DoMatchLabel(LChild, AType, ASpans)) then
          LKnown := false;
        end;
      end;
      return LKnown;
    end;

    // A match AMatch on a choice (subject type AType) with no else, every label known: the
    // choice values no label covers are named in a WARNING SM0606 (a value with no number
    // leaves the coverage unknown: nothing is said)
    hidden method DoMatchCoverage(const AMatch: int64; const AType: int64; const ASpans: ref NodeList);
    var
      LCanonical: int64;
      LBody: int64;
      LI: int64;
      LJ: int64;
      LMember: int64;
      LBits: int64;
      LCovered: bool;
      LMissing: string;
    begin
      if self.FTree[AMatch].HasFlag(NodeFlag.ElsePart) or (self.DoClass(AType) <> TypeClass.ChoicesType) then
        return;
      end;
      LCanonical := CanonicalOf(self.FTree, AType);
      LBody := LCanonical;
      if self.FTree[LCanonical].Kind <> NodeKind.ChoicesType then
        LBody := BodyOf(self.FTree, LCanonical);
      end;
      if LBody = 0 then
        return;
      end;
      LMissing := "";
      for LI := 0 to self.FTree.CountOf(LBody, NodeRole.Member) - 1 do
        LMember := self.FTree.NthOf(LBody, NodeRole.Member, LI);
        if self.FTree[LMember].Kind <> NodeKind.ChoiceValue then
          skip;
        end;
        if not self.DoFoldedBits(LMember, AType, LBits) then
          return;
        end;
        // A choice's numbers compare signed
        LCovered := false;
        for LJ := 0 to (ASpans.Count div 3) - 1 do
          if (ASpans[LJ * 3] <= LBits) and (LBits <= ASpans[LJ * 3 + 1]) then
            LCovered := true;
            leave;
          end;
        end;
        if LCovered then
          skip;
        end;
        if LMissing <> "" then
          LMissing := LMissing + ", ";
        end;
        LMissing := LMissing + self.FTree[LMember].Text;
      end;
      if LMissing <> "" then
        self.FDiagnostics.Add(Severity.Warning, ADAM_ERR_SEMANTICS_606, self.FTree[AMatch].Place,
          ADAM_MSG_SEMANTICS_NOT_COVERED, NoArgs().Str(self.DoText(AType)).Str(LMissing));
      end;
    end;

    // match S of ...: S (DoMatchSubject), then each arm in source order (DoMatchArm), the
    // else part, then a choice match's coverage (DoMatchCoverage) when every label is known
    hidden method DoMatch(const AId: int64);
    var
      LSubject: int64;
      LType: int64;
      LSpans: ref NodeList;
      LAllKnown: bool;
      LI: int64;
      LChild: int64;
    begin
      LSubject := self.FTree.FirstOf(AId, NodeRole.Subject);
      self.DoVisit(LSubject);
      LType := self.DoMatchSubject(LSubject);
      LAllKnown := LType <> 0;
      LSpans := ref NodeList();
      for LI := 0 to self.FTree.ChildCount(AId) - 1 do
        LChild := self.FTree.ChildAt(AId, LI);
        if LChild = LSubject then
          skip;
        end;
        if self.FTree[LChild].Kind = NodeKind.MatchArm then
          if not self.DoMatchArm(LChild, LType, LSpans) then
            LAllKnown := false;
          end;
        else
          self.DoVisit(LChild);
        end;
      end;
      if LAllKnown and (not self.FDiagnostics.BudgetReached) then
        self.DoMatchCoverage(AId, LType, LSpans);
      end;
    end;

    // The external clause AId's library (BNF sec 2), resolved once into its ResolvedConst
    // (String, Text the library name) for every later phase: a "..." name as the parser
    // decoded and checked it (PR0055), or the const its NameExpression child names, whose
    // value must be a plain string literal (SM0326) with a library name's shape (SM0327).
    // A clause naming no library, or one whose name was reported already, keeps Unknown
    hidden method DoExternalClause(const AId: int64);
    var
      LName: int64;
      LDecl: int64;
      LValue: int64;
      LLibrary: ConstValue;
    begin
      LLibrary.Kind := ConstKind.String;
      LLibrary.Bits := 0;
      LLibrary.Float := 0.0;
      LLibrary.Text := "";
      LName := self.FTree.FirstOf(AId, NodeRole.Argument);
      if LName = 0 then
        if IsLibraryName(self.FTree[AId].Decoded) then
          LLibrary.Text := self.FTree[AId].Decoded;
          self.FTree[AId].ResolvedConst := LLibrary;
        end;
        return;
      end;
      LDecl := self.FTree[LName].ResolvedDecl;
      if LDecl = 0 then
        // NameResolver reported the name (not declared, not public, ...)
        return;
      end;
      LValue := 0;
      if self.FTree[LDecl].Kind = NodeKind.ConstDecl then
        LValue := self.FTree.FirstOf(LDecl, NodeRole.Initializer);
      end;
      if (LValue = 0) or (self.FTree[LValue].Kind <> NodeKind.StringLiteral) or
        (self.FTree[LValue].NarrowFault.Reason <> "") then
        self.DoError(LName, ADAM_ERR_SEMANTICS_326, ADAM_MSG_SEMANTICS_LIBRARY_CONST,
          NoArgs().Str(self.FTree[LName].Text));
        return;
      end;
      if not IsLibraryName(self.FTree[LValue].Decoded) then
        self.DoError(LName, ADAM_ERR_SEMANTICS_327, ADAM_MSG_SEMANTICS_LIBRARY_NAME,
          NoArgs().Str(self.FTree[LValue].Decoded));
        return;
      end;
      LLibrary.Text := self.FTree[LValue].Decoded;
      self.FTree[AId].ResolvedConst := LLibrary;
    end;

    // AId and everything under it typed, once. A directive's arguments are its values; a
    // recovered node and an error node are silent
    hidden method DoVisit(const AId: int64);
    var
      LKind: NodeKind;
    begin
      if AId = 0 then
        return;
      end;
      if not self.DoFirstVisit(AId) then
        return;
      end;
      LKind := self.FTree[AId].Kind;
      if (LKind = NodeKind.Directive) or (LKind = NodeKind.Error) or
        self.FTree[AId].HasFlag(NodeFlag.Recovered) then
        return;
      end;
      if DoIsExpression(LKind) then
        self.DoExpression(AId);
        if LKind = NodeKind.MemberExpression then
          self.DoDeclarationFirst(self.FTree[AId].ResolvedDecl);
        end;
        // Folded once typed: its operands were typed and folded before it (M1.10)
        self.FFolder.Fold(AId);
        return;
      end;
      if DoIsTypeExpression(LKind) then
        self.DoTypeExpression(AId, LKind);
        return;
      end;
      match LKind of
        NodeKind.TypeDecl:
          self.DoTypeDecl(AId);
          self.DoFullType(AId);
        NodeKind.ForwardType:
          self.FForwards.Add(AId);
          self.DoForwardType(AId);
        NodeKind.ForwardRoutine:
          self.FForwards.Add(AId);
        NodeKind.VarDecl, NodeKind.ConstDecl:
          self.DoVarDecl(AId);
          if LKind = NodeKind.ConstDecl then
            self.FFolder.FoldDeclaration(AId);
            self.DoConstLiteral(self.FTree.FirstOf(AId, NodeRole.Initializer));
          end;
          // An external variable's library (its children are not visited below)
          self.DoVisit(self.FTree.FirstOf(AId, NodeRole.External));
        NodeKind.ChoicesType:
          self.DoChoices(AId);
        NodeKind.RoutineDecl:
          self.DoOverloadDeclared(AId);
          self.DoVariadicFixed(AId);
          self.DoPairRoutine(AId);
        NodeKind.Param, NodeKind.FieldDecl:
          self.DoHeldDecl(AId);
        NodeKind.PropertyDecl, NodeKind.EmbedDecl:
          self.DoDeclType(AId);
        NodeKind.ReturnStatement:
          self.DoReturn(AId);
        NodeKind.LeaveStatement, NodeKind.SkipStatement:
          self.DoJump(AId);
        NodeKind.ForStatement:
          self.DoFor(AId);
        NodeKind.MatchStatement:
          self.DoMatch(AId);
        NodeKind.ExternalClause:
          self.DoExternalClause(AId);
      else
        // children below
      end;
      if (LKind = NodeKind.VarDecl) or (LKind = NodeKind.ConstDecl) or
        (LKind = NodeKind.ReturnStatement) or (LKind = NodeKind.ForStatement) or
        (LKind = NodeKind.MatchStatement) or (LKind = NodeKind.ChoicesType) or
        (LKind = NodeKind.ExternalClause) then
        // A for's and a match's statements were typed by their own check above
        self.DoUnreachable(AId);
        return;
      end;
      self.DoChildren(AId);
      if (LKind = NodeKind.IfStatement) or (LKind = NodeKind.WhileStatement) or
        (LKind = NodeKind.RepeatStatement) or (LKind = NodeKind.GuardStatement) then
        self.DoCondition(self.FTree.FirstOf(AId, NodeRole.Condition));
      end;
      if (LKind = NodeKind.LockStatement) or (LKind = NodeKind.TryLockStatement) then
        self.DoLock(AId);
      end;
      self.DoUnreachable(AId);
      // Its body typed first: a raise or noreturn call's callee is resolved by then
      if (LKind = NodeKind.RoutineDecl) or (LKind = NodeKind.MethodDecl) or
        (LKind = NodeKind.OperatorDecl) then
        self.DoReturnPath(AId);
        self.DoMutexResult(AId);
      end;
    end;

    // The type the literal AId's value is picked for: the conversion written on it (or on
    // the parentheses around it), else its own type
    hidden const method DoPickedType(const AId: int64): int64;
    var
      LAt: int64;
      LParent: int64;
    begin
      LAt := AId;
      while true do
        if self.FTree[LAt].ResolvedConvert <> 0 then
          return self.FTree[LAt].ResolvedConvert;
        end;
        LParent := self.FTree.ParentOf(LAt);
        if (LParent = 0) or (self.FTree[LParent].Kind <> NodeKind.ParenExpression) then
          return self.FTree[AId].ResolvedType;
        end;
        LAt := LParent;
      end;
    end;

    // True when the type APicked takes a literal's wide encoding: a wstring, a wchar, a
    // ptr to const wchar
    hidden const method DoIsWide(const APicked: int64): bool;
    var
      LClass: TypeClass;
    begin
      LClass := self.DoClass(APicked);
      if (LClass = TypeClass.WideText) or (LClass = TypeClass.WideChar) then
        return true;
      end;
      return (LClass = TypeClass.Pointer) and
        (self.DoClass(TargetOf(self.FTree, APicked)) = TypeClass.WideChar);
    end;

    // Each typed string / char literal's fault in the encoding its type picked (the
    // parser kept one-encoding faults on the node, BNF sec 9): SM0022 / SM0023, an error,
    // or a warning when the fault is one
    hidden method DoLiteralFaults();
    var
      LI: int64;
      LKind: NodeKind;
      LPicked: int64;
      LFault: EncodingFault;
      LSeverity: Severity;
      LCode: string;
      LTemplate: string;
    begin
      for LI := 1 to self.FTree.Count - 1 do
        LKind := self.FTree[LI].Kind;
        // A compiled unit's literal was told when its unit was compiled
        if ((LKind = NodeKind.StringLiteral) or (LKind = NodeKind.CharLiteral)) and
          (self.FTree[LI].ResolvedType <> 0) and not self.FTree[LI].HasFlag(NodeFlag.Compiled) then
          LPicked := self.DoPickedType(LI);
          if self.DoIsWide(LPicked) then
            LFault := self.FTree[LI].WideFault;
          else
            LFault := self.FTree[LI].NarrowFault;
          end;
          if LFault.Reason <> "" then
            LSeverity := Severity.Error;
            if LFault.IsWarning then
              LSeverity := Severity.Warning;
            end;
            LCode := ADAM_ERR_SEMANTICS_022;
            LTemplate := ADAM_MSG_SEMANTICS_BAD_STRING_AS;
            if LKind = NodeKind.CharLiteral then
              LCode := ADAM_ERR_SEMANTICS_023;
              LTemplate := ADAM_MSG_SEMANTICS_BAD_CHAR_AS;
            end;
            self.FDiagnostics.Add(LSeverity, LCode, self.FTree[LI].Place, LTemplate,
              NoArgs().Str(self.DoText(LPicked)).Str(LFault.Reason));
          end;
        end;
      end;
    end;

    // Every static array's and set range's bounds typed and folded first (a type's key and
    // a layout read their values wherever the type is first met), then every module of
    // the program typed, then the forwards no full declaration completed, then the
    // literals' picked faults. A compiled unit's nodes are typed already: none is visited
    method Run();
    var
      LI: int64;
      LKind: NodeKind;
      LModule: int64;
    begin
      for LI := 1 to self.FTree.Count - 1 do
        LKind := self.FTree[LI].Kind;
        if ((LKind = NodeKind.ArrayType) or (LKind = NodeKind.SetType)) and
          (self.FTree.ParentOf(LI) <> ADAM_AST_DERIVED) and
          not self.FTree[LI].HasFlag(NodeFlag.Compiled) then
          self.DoVisit(self.FTree.FirstOf(LI, NodeRole.LowBound));
          self.DoVisit(self.FTree.FirstOf(LI, NodeRole.HighBound));
        end;
      end;
      for LI := 0 to self.FTree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
        LModule := self.FTree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
        if not self.FTree[LModule].HasFlag(NodeFlag.Compiled) then
          self.DoVisit(LModule);
        end;
      end;
      self.DoUnpairedForwards();
      self.DoLiteralFaults();
      self.DoProgramExits();
      self.DoRuntimeRoutines();
    end;
  end;

// Every expression, declaration and conversion of the program in ATree typed into the
// AST (see TypeChecker), reporting into ADiagnostics. Runs after ResolveNames: it reads
// what names mean. ATarget answers size(T) (nil: no target picked, size(T) stays unfolded)
public routine CheckTypes(const ATree: ref SyntaxTree; const ATarget: ref Target;
  const ADiagnostics: ref Diagnostics);
var
  LChecker: ref TypeChecker;
begin
  LChecker := ref TypeChecker(ATree, ATarget, ADiagnostics);
  LChecker.Run();
end;

end.
