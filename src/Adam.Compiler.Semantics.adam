  // writer print / println / FormatStr run (a print sink's, M3.8f2b), the exit an exe's block ends with, the heap's and the
  // arguments' that getmem / resizemem / freemem / paramcount / paramstr run
  ADAM_SEMANTICS_RUNTIME_WRITE: string = "SinkText";
  ADAM_SEMANTICS_RUNTIME_EXIT: string = "Halt";
  ADAM_SEMANTICS_RUNTIME_GETMEM: string = "GetMem";
