  ADAM_SEMANTICS_RUNTIME_WSTR_COMPARE: string = "WStrCompare";
  ADAM_SEMANTICS_RUNTIME_WSTR_UNIQUE: string = "WStrUnique";
  ADAM_SEMANTICS_RUNTIME_WSTR_SET_LENGTH: string = "WStrSetLength";
  ADAM_SEMANTICS_RUNTIME_WSTR_TO_UTF8: string = "WStrToUTF8";
  ADAM_SEMANTICS_RUNTIME_STR_ADD_REF: string = "StrAddRef";
  ADAM_SEMANTICS_RUNTIME_MANAGED_RELEASE: string = "ManagedRelease";
  ADAM_SEMANTICS_RUNTIME_MANAGED_ASSIGN: string = "ManagedAssign";
  ADAM_SEMANTICS_RUNTIME_ARR_RELEASE: string = "ArrRelease";
  ADAM_SEMANTICS_RUNTIME_ARR_ASSIGN: string = "ArrAssign";
  ADAM_SEMANTICS_RUNTIME_ARR_UNIQUE: string = "ArrUnique";
  ADAM_SEMANTICS_RUNTIME_ARR_SET_LENGTH: string = "ArrSetLength";
  ADAM_SEMANTICS_RUNTIME_REF_NEW: string = "RefNew";
  ADAM_SEMANTICS_RUNTIME_REF_RELEASE: string = "RefRelease";
  ADAM_SEMANTICS_RUNTIME_REF_ASSIGN: string = "RefAssign";
  ADAM_SEMANTICS_RUNTIME_WEAK_ADD_REF: string = "WeakAddRef";
  ADAM_SEMANTICS_RUNTIME_WEAK_RELEASE: string = "WeakRelease";
  ADAM_SEMANTICS_RUNTIME_WEAK_ASSIGN: string = "WeakAssign";
