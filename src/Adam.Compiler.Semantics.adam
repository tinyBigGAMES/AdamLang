  ADAM_SEMANTICS_RUNTIME_TEST_START: string = "TestStart";
  ADAM_SEMANTICS_RUNTIME_TEST_RUN: string = "TestRun";
  ADAM_SEMANTICS_RUNTIME_TEST_END: string = "TestEnd";
