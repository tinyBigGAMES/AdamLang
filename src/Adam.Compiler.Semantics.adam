  ADAM_SEMANTICS_RUNTIME_GENERATOR_COPY_FAIL: string = "GeneratorCopyFail";
  ADAM_SEMANTICS_RUNTIME_GENERATOR_DELEGATE: string = "GeneratorDelegate";
  // The std unit that reads @addresdata keys back and its two lookups by key (SM0122)
  ADAM_SEMANTICS_RESDATA_UNIT: string = "System.ResData";
  ADAM_SEMANTICS_RESDATA_FIND: string = "FindResData";
  ADAM_SEMANTICS_RESDATA_HAS: string = "HasResData";
  ADAM_SEMANTICS_INTRINSIC_TEST_PREFIX: string = "test";
  ADAM_SEMANTICS_RUNTIME_TEST_PREFIX: string = "Test";
  ADAM_SEMANTICS_RUNTIME_SET_RANGE: string = "SetRange";
  ADAM_SEMANTICS_RUNTIME_ADD_THREAD_RELEASE: string = "AddThreadRelease";
  ADAM_SEMANTICS_RUNTIME_TASK_START: string = "TaskStart";
  ADAM_SEMANTICS_RUNTIME_TASK_AWAIT: string = "TaskAwait";
  ADAM_SEMANTICS_RUNTIME_TASK_READY: string = "TaskReady";
