  ADAM_SEMANTICS_PLATFORM_CATCH_ABORT: string = "PlatformCatchAbort";
  ADAM_SEMANTICS_PLATFORM_THREAD_CALLBACK: string = "PlatformThreadCallback";

  ADAM_ERR_SEMANTICS_001: string = "SM0001";   // a name used in its own declaration
  ADAM_ERR_SEMANTICS_002: string = "SM0002";   // a name used before its declaration
  ADAM_ERR_SEMANTICS_003: string = "SM0003";   // a type that names itself in its own declaration
  ADAM_ERR_SEMANTICS_004: string = "SM0004";   // a name declared twice in one scope
  ADAM_ERR_SEMANTICS_005: string = "SM0005";   // a unit has no such name
  ADAM_ERR_SEMANTICS_006: string = "SM0006";   // a unit's name not public
  ADAM_ERR_SEMANTICS_007: string = "SM0007";   // a dotted prefix that is no imported module
  ADAM_ERR_SEMANTICS_008: string = "SM0008";   // a qualified type with parts past its module's type
  ADAM_ERR_SEMANTICS_009: string = "SM0009";   // a type has no such member
  ADAM_ERR_SEMANTICS_011: string = "SM0011";   // self / parent where no object is: outside a method, in an operator
  ADAM_ERR_SEMANTICS_012: string = "SM0012";   // parent in a method of a type that has no parent
  ADAM_ERR_SEMANTICS_010: string = "SM0010";   // a choices type has no such value
  ADAM_ERR_SEMANTICS_013: string = "SM0013";   // a name in a type's place that is no type
  ADAM_ERR_SEMANTICS_014: string = "SM0014";   // '->' on a module or a type
  ADAM_ERR_SEMANTICS_015: string = "SM0015";   // a bare choice value
  ADAM_ERR_SEMANTICS_016: string = "SM0016";   // parent written other than as parent.<member>
  ADAM_ERR_SEMANTICS_017: string = "SM0017";   // a declared name that starts with the reserved prefix
  ADAM_ERR_SEMANTICS_018: string = "SM0018";   // a bare member of the method's type
  ADAM_ERR_SEMANTICS_019: string = "SM0019";   // a hidden member reached from outside its type's methods
  ADAM_ERR_SEMANTICS_021: string = "SM0021";   // a name declared nowhere
  ADAM_ERR_SEMANTICS_022: string = "SM0022";   // a string literal's picked encoding has a fault (Adam's own)
  ADAM_ERR_SEMANTICS_023: string = "SM0023";   // a char literal's picked encoding has a fault (Adam's own)
  ADAM_ERR_SEMANTICS_100: string = "SM0100";   // a directive's value it does not take
  ADAM_ERR_SEMANTICS_101: string = "SM0101";   // a @vimajor / @viminor / @vipatch past 65535
  ADAM_ERR_SEMANTICS_102: string = "SM0102";   // a single-valued directive given twice in one module
  ADAM_ERR_SEMANTICS_103: string = "SM0103";   // (warning) a directive the module or the target cannot take
  ADAM_ERR_SEMANTICS_104: string = "SM0104";   // (warning) a @vi* without @addverinfo on
  ADAM_ERR_SEMANTICS_109: string = "SM0109";   // (warning) @breakpoint in the directive prologue
  ADAM_ERR_SEMANTICS_110: string = "SM0110";   // @unitTestMode in a module that is no exe
  ADAM_ERR_SEMANTICS_111: string = "SM0111";   // a test with an empty name
  ADAM_ERR_SEMANTICS_112: string = "SM0112";   // two tests of one module with one name
  ADAM_ERR_SEMANTICS_113: string = "SM0113";   // (warning) a test of a dll / lib, which never runs
  ADAM_ERR_SEMANTICS_119: string = "SM0119";   // an @addresdata key empty or holding a control character
  ADAM_ERR_SEMANTICS_120: string = "SM0120";   // an @addresdata key with the compiler's prefix adam/
  ADAM_ERR_SEMANTICS_121: string = "SM0121";   // an @addresdata key added twice in one build
  ADAM_ERR_SEMANTICS_122: string = "SM0122";   // (warning) a literal key no @addresdata of the build adds
  ADAM_ERR_SEMANTICS_123: string = "SM0123";   // a @vi* / @exeicon name that is no integer / string constant
  ADAM_ERR_SEMANTICS_124: string = "SM0124";   // a directive constant's path with $R: in a build with no project
  ADAM_ERR_SEMANTICS_125: string = "SM0125";   // a directive constant's path that resolves to nothing
  ADAM_ERR_SEMANTICS_108: string = "SM0108";   // an @message: its own text at its own severity
  ADAM_ERR_SEMANTICS_200: string = "SM0200";   // a value that does not convert implicitly, or does not fit
  ADAM_ERR_SEMANTICS_202: string = "SM0202";   // a constant place (a match label) holds no constant
  ADAM_ERR_SEMANTICS_250: string = "SM0250";   // an operator that does not take its operand type(s)
  ADAM_ERR_SEMANTICS_251: string = "SM0251";   // a signed operand the common type would make unsigned (write the cast)
  ADAM_ERR_SEMANTICS_252: string = "SM0252";   // a record / overlay / object compared with no declared operator
  ADAM_ERR_SEMANTICS_253: string = "SM0253";   // ^ or [i] on the untyped ptr
  ADAM_ERR_SEMANTICS_254: string = "SM0254";   // the address of a value that is not stored
  ADAM_ERR_SEMANTICS_255: string = "SM0255";   // a target that cannot be assigned
  ADAM_ERR_SEMANTICS_260: string = "SM0260";   // a value that cannot be indexed
  ADAM_ERR_SEMANTICS_261: string = "SM0261";   // an index of the wrong family
  ADAM_ERR_SEMANTICS_262: string = "SM0262";   // the address of a bitfield (addr of, a var argument)
  ADAM_ERR_SEMANTICS_263: string = "SM0263";   // a condition that is no bool
  ADAM_ERR_SEMANTICS_264: string = "SM0264";   // a value no cast to that type takes (Adam's own)
  ADAM_ERR_SEMANTICS_265: string = "SM0265";   // a value a pointer cast does not take
  ADAM_ERR_SEMANTICS_266: string = "SM0266";   // a set literal element that is no ordinal, or elements of two ordinal types
  ADAM_ERR_SEMANTICS_267: string = "SM0267";   // a match label or set literal range whose low bound is above its high
