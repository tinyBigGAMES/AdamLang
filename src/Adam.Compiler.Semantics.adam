  ADAM_SEMANTICS_RUNTIME_GENERATOR_RUN: string = "GeneratorRun";
  ADAM_SEMANTICS_RUNTIME_GENERATOR_END: string = "GeneratorEnd";
  ADAM_SEMANTICS_RUNTIME_GENERATOR_RESUME: string = "GeneratorResume";
