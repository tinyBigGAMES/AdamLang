  ADAM_SEMANTICS_RUNTIME_WSTR_TO_UTF32: string = "WStrToUTF32";
  // A `const array of T` parameter's view as an array value, a view's index check (AS2)
  ADAM_SEMANTICS_RUNTIME_ARR_FROM_VIEW: string = "ArrFromView";
  ADAM_SEMANTICS_RUNTIME_INDEX_FAIL_LENGTH: string = "IndexFailLength";
  // A C callback's chain entry on a thread Adam never entered, and its leave (CB1)
  ADAM_SEMANTICS_RUNTIME_CALLBACK_ENTER: string = "CallbackEnter";
  ADAM_SEMANTICS_RUNTIME_CALLBACK_LEAVE: string = "CallbackLeave";
  // A generator's coroutine run (given a last catching scope for its abort), its end (that
