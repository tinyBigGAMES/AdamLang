  ADAM_ERR_SEMANTICS_745: string = "SM0745";   // self / parent in a static method
  ADAM_ERR_SEMANTICS_746: string = "SM0746";   // an instance member named through its type's name
  ADAM_ERR_SEMANTICS_747: string = "SM0747";   // a static method reached through a value
  ADAM_ERR_SEMANTICS_748: string = "SM0748";   // an extend's target no record / object / overlay / choices type
  ADAM_ERR_SEMANTICS_749: string = "SM0749";   // a member an extend does not take (a field, init / copy / done, a property, a virtual word, hidden)
  ADAM_ERR_SEMANTICS_750: string = "SM0750";   // an extend's member named as a member of its target
