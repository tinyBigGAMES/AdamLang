  ADAM_SEMANTICS_RUNTIME_ARR_UNIQUE: string = "ArrUnique";
  ADAM_SEMANTICS_RUNTIME_ARR_SET_LENGTH: string = "ArrSetLength";
  ADAM_SEMANTICS_RUNTIME_REF_NEW: string = "RefNew";
  ADAM_SEMANTICS_RUNTIME_REF_RELEASE: string = "RefRelease";
  ADAM_SEMANTICS_RUNTIME_REF_ASSIGN: string = "RefAssign";
  ADAM_SEMANTICS_RUNTIME_ABSTRACT_CALL: string = "AbstractCall";
  ADAM_SEMANTICS_RUNTIME_UNHANDLED: string = "Unhandled";
  ADAM_SEMANTICS_RUNTIME_SET_RANGE: string = "SetRange";
  ADAM_SEMANTICS_RUNTIME_SET_THREAD_RELEASE: string = "SetThreadRelease";
  ADAM_SEMANTICS_RUNTIME_TASK_START: string = "TaskStart";
  ADAM_SEMANTICS_RUNTIME_TASK_AWAIT: string = "TaskAwait";
  ADAM_SEMANTICS_RUNTIME_TASK_READY: string = "TaskReady";
  ADAM_SEMANTICS_RUNTIME_TASK_DONE: string = "TaskDone";
  ADAM_SEMANTICS_RUNTIME_MUTEX_ENTER: string = "MutexEnter";
  ADAM_SEMANTICS_RUNTIME_MUTEX_TRY_ENTER: string = "MutexTryEnter";
  ADAM_SEMANTICS_RUNTIME_MUTEX_LEAVE: string = "MutexLeave";
  ADAM_SEMANTICS_RUNTIME_CREATE_MEM: string = "CreateMem";
  ADAM_SEMANTICS_RUNTIME_DESTROY_MEM: string = "DestroyMem";
  ADAM_SEMANTICS_RUNTIME_WRITE_INT: string = "SinkInt";
  ADAM_SEMANTICS_RUNTIME_WRITE_UINT: string = "SinkUInt";
  ADAM_SEMANTICS_RUNTIME_WRITE_BOOL: string = "SinkBool";
  ADAM_SEMANTICS_RUNTIME_WRITE_CHAR: string = "SinkChar";
  ADAM_SEMANTICS_RUNTIME_WRITE_WIDE_CHAR: string = "SinkWideChar";
