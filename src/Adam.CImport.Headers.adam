-------------------------------------------------------------------------------
  Adam.CImport.Headers.adam - Where `adam cimport` finds its C headers
  (M9; DESIGN sec 15): the one way the importer reaches a header

  HeaderSearch   the search roots, in order, each one an IOSource
                 (System.CustomIO): the spec's include folders (each one's
                 <triple>/ first when it has one: a target's own headers,
                 the layout of a vendor package's include folder), then the
                 system headers beside adam.exe, res/libs/system/include:
                 clang/ (the compiler's own headers, shared by every
                 target) and <triple>/ (the target's C library headers),
                 both out of git and gathered by a dev-side script. Find
                 is clang's search: a quoted name first in the including
                 file's folder (in that file's root), then every root in
                 order; #include_next resumes after the root that found the
                 including file. Read hands a header's bytes back;
                 ReadPredefines the target's predefines (<triple>
                 .predefines.h in the system include folder: what clang
                 defines before a file). It reports into the Diagnostics it
                 is made with (CP codes).

  A root is an IOSource, so the headers can move from loose folders into
  one .rez per target (a CreateZipIOSource root and a pack step) with
  nothing else changed. A header's name is '/'-separated and relative; a
  `..` never climbs out of its root (IOSource's rule). A system root's
  headers are read, never bound: IsSystem says which roots they are.
  Target-neutral: a triple is only a folder's name here.
*******************************************************************************/

module unit Adam.CImport.Headers;

import System.SysUtils, System.IO, System.CustomIO, Adam.Core.Common, Adam.Core.Messages,
  Adam.Compiler.SourceText, Adam.Compiler.Diagnostics;

public const
  ADAM_ERR_CIMPORT_HEADERS_001: string = "CP0016";   // a root folder cannot be opened
  ADAM_ERR_CIMPORT_HEADERS_002: string = "CP0017";   // a header is in no root
  ADAM_ERR_CIMPORT_HEADERS_003: string = "CP0018";   // a header cannot be read

  // The system headers beside adam.exe: <this>clang and <this><triple>
  ADAM_CIMPORT_SYSTEM_INCLUDE: string = "$P:res/libs/system/include/";
  ADAM_CIMPORT_CLANG_FOLDER: string = "clang";

public type
  // A header as found: the root it is in (an index into the search's roots; -1 = none), its
  // path in that root ('/' form) and its full path ('/' form: the name reports and status
  // lines print)
  HeaderFile = record
    Root: int64;
    Path: string;
    FullName: string;
  end;

// No header: what the spec's own headers are looked up from (no including file)
public func NoHeader(): HeaderFile;
var
  LFile: HeaderFile;
begin
  LFile.Root := -1;
  LFile.Path := "";
  LFile.FullName := "";
  return LFile;
end;

// APath's folder part in '/' form ("" for a name with no folder)
func DoFolderOf(const APath: string): string;
var
  LI: int64;
begin
  LI := len(APath) - 1;
  while LI >= 0 do
    if APath[LI] = '/' then
      return Substring(APath, 0, LI);
    end;
    LI := LI - 1;
  end;
  return "";
end;

// AFolder and AName joined by '/' (AName alone when AFolder is "")
func DoJoin(const AFolder: string; const AName: string): string;
begin
  if AFolder = "" then
    return AName;
  end;
  return AFolder + "/" + AName;
end;

public type
  // The search roots and the headers' search (see the header)
  HeaderSearch = object
    hidden FReports: ref Diagnostics;
    hidden FFolders: StringArray;
    hidden FSystem: BoolArray;
    hidden FSources: array of IOSource;
    hidden FInclude: IOSource;

    // AReports takes every report (nil: none is made)
    init(const AReports: ref Diagnostics);
    begin
      self.FReports := AReports;
      setlength(self.FFolders, 0);
      setlength(self.FSystem, 0);
      setlength(self.FSources, 0);
      self.FInclude := nil;
    end;

    done;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FSources) - 1 do
        IOSourceClose(self.FSources[LI]);
      end;
      setlength(self.FSources, 0);
      if self.FInclude <> nil then
        IOSourceClose(self.FInclude);
        self.FInclude := nil;
      end;
    end;

    hidden method DoError(const ACode: string; const APlace: SourcePlace; const ATemplate: string;
      const AArgs: MessageArgs);
    begin
      if self.FReports <> nil then
        self.FReports.Add(Severity.Error, ACode, APlace, ATemplate, AArgs);
      end;
    end;

    // The folder AFolder (a full path, or $P: / $D: as CreateFolderIOSource takes it) as the
    // next root; ASystem: its headers are read, never bound. A folder that cannot be opened:
    // CP0016 at APlace, false
    method AddFolder(const AFolder: string; const ASystem: bool; const APlace: SourcePlace): bool;
    var
      LSource: IOSource;
      LCount: int64;
      LFull: string;
    begin
      LFull := ResolvePath(AFolder);
      LSource := nil;
      if LFull <> "" then
        LSource := CreateFolderIOSource(LFull);
      end;
      if LSource = nil then
        self.DoError(ADAM_ERR_CIMPORT_HEADERS_001, APlace, ADAM_MSG_CIMPORT_HEADERS_NO_ROOT,
          NoArgs().Str(ForwardSlashes(LFull)));
        return false;
      end;
      LCount := len(self.FSources);
      setlength(self.FSources, LCount + 1);
      setlength(self.FFolders, LCount + 1);
      setlength(self.FSystem, LCount + 1);
      self.FSources[LCount] := LSource;
      self.FFolders[LCount] := ForwardSlashes(LFull);
      self.FSystem[LCount] := ASystem;
      return true;
    end;

    // A spec include folder for ATriple: its <triple>/ subfolder first when there is one (that
    // target's own headers, as a vendor package installs them), then the folder itself, its
    // headers system ones when ASystem (a spec's systemincludes: clang -isystem); false
    // (CP0016 reported) when the folder cannot be opened
    method AddIncludeFolder(const AFolder: string; const ATriple: string; const ASystem: bool;
      const APlace: SourcePlace): bool;
    var
      LTarget: string;
    begin
      LTarget := ResolvePath(AFolder);
      if LTarget <> "" then
        LTarget := ResolvePath(ATriple, LTarget);
        if (LTarget <> "") and DirectoryExists(LTarget) and
          not self.AddFolder(LTarget, ASystem, APlace) then
          return false;
        end;
      end;
      return self.AddFolder(AFolder, ASystem, APlace);
    end;

    // The system roots of ATriple: clang/ then <triple>/ under the system include folder
    // beside adam.exe. A missing one (the target's headers not installed): CP0016, false
    method AddSystemRoots(const ATriple: string): bool;
    var
      LOk: bool;
    begin
      LOk := self.AddFolder(ADAM_CIMPORT_SYSTEM_INCLUDE + ADAM_CIMPORT_CLANG_FOLDER, true,
        NoPlace());
      if not self.AddFolder(ADAM_CIMPORT_SYSTEM_INCLUDE + ATriple, true, NoPlace()) then
        LOk := false;
      end;
      return LOk;
    end;

    // How many roots there are
    const method RootCount(): int64;
    begin
      return len(self.FSources);
    end;

    // The root AIndex's folder ('/' form)
    const method RootFolder(const AIndex: int64): string;
    begin
      return self.FFolders[AIndex];
    end;

    // True when the root AIndex is a system root (its headers read, never bound)
    const method IsSystem(const AIndex: int64): bool;
    begin
      return self.FSystem[AIndex];
    end;

    // True when the root AIndex holds APath; AFound then names it
    hidden const method DoHas(const AIndex: int64; const APath: string; var AFound: HeaderFile): bool;
    begin
      if not IOSourceExists(self.FSources[AIndex], APath) then
        return false;
      end;
      AFound.Root := AIndex;
      AFound.Path := APath;
      AFound.FullName := DoJoin(self.FFolders[AIndex], APath);
      return true;
    end;

    // The header AName (as written between the quotes or the angle brackets) in AFound, as
    // clang finds it (see the header): AQuoted a "name" include, AFrom the including file
    // (NoHeader for the spec's own headers), ANext an #include_next. False when no root has it
    const method Find(const AName: string; const AQuoted: bool; const AFrom: HeaderFile;
      const ANext: bool; var AFound: HeaderFile): bool;
    var
      LName: string;
      LStart: int64;
      LI: int64;
    begin
      AFound := NoHeader();
      LName := ForwardSlashes(AName);
      if LName = "" then
        return false;
      end;
      if AQuoted and not ANext and (AFrom.Root >= 0) then
        if self.DoHas(AFrom.Root, DoJoin(DoFolderOf(AFrom.Path), LName), AFound) then
          return true;
        end;
      end;
      LStart := 0;
      if ANext and (AFrom.Root >= 0) then
        LStart := AFrom.Root + 1;
      end;
      for LI := LStart to len(self.FSources) - 1 do
        if self.DoHas(LI, LName, AFound) then
          return true;
        end;
      end;
      return false;
    end;

    // The bytes of AFile (found by Find) in AText. One that cannot be read: CP0018 at APlace
    // (the include that named it), false
    method Read(const AFile: HeaderFile; const APlace: SourcePlace; var AText: string): bool;
    var
      LIO: IO;
      LOk: bool;
    begin
      AText := "";
      LOk := false;
      if (AFile.Root >= 0) and (AFile.Root < len(self.FSources)) then
        LIO := IOSourceOpen(self.FSources[AFile.Root], AFile.Path);
        if LIO <> nil then
          LOk := IOReadAll(LIO, AText);
          IOClose(LIO);
        end;
      end;
      if not LOk then
        self.DoError(ADAM_ERR_CIMPORT_HEADERS_003, APlace, ADAM_MSG_CIMPORT_HEADERS_READ_FAILED,
          NoArgs().Str(AFile.FullName));
      end;
      return LOk;
    end;

    // The predefines of ATriple (see the header) in AText, AName its full path ('/' form). A
    // folder or file that cannot be opened or read: CP0016 / CP0018 (no place), false
    method ReadPredefines(const ATriple: string; var AText: string; var AName: string): bool;
    var
      LFolder: string;
      LIO: IO;
      LOk: bool;
    begin
      AText := "";
      LFolder := ResolvePath(Substring(ADAM_CIMPORT_SYSTEM_INCLUDE, 0,
        len(ADAM_CIMPORT_SYSTEM_INCLUDE) - 1));
      AName := DoJoin(ForwardSlashes(LFolder), ATriple + ADAM_EXT_C_PREDEFINES);
      if self.FInclude = nil then
        if LFolder <> "" then
          self.FInclude := CreateFolderIOSource(LFolder);
        end;
        if self.FInclude = nil then
          self.DoError(ADAM_ERR_CIMPORT_HEADERS_001, NoPlace(), ADAM_MSG_CIMPORT_HEADERS_NO_ROOT,
            NoArgs().Str(ForwardSlashes(LFolder)));
          return false;
        end;
      end;
      LOk := false;
      LIO := IOSourceOpen(self.FInclude, ATriple + ADAM_EXT_C_PREDEFINES);
      if LIO <> nil then
        LOk := IOReadAll(LIO, AText);
        IOClose(LIO);
      end;
      if not LOk then
        self.DoError(ADAM_ERR_CIMPORT_HEADERS_003, NoPlace(), ADAM_MSG_CIMPORT_HEADERS_READ_FAILED,
          NoArgs().Str(AName));
      end;
      return LOk;
    end;

    // CP0017 for the header AName at APlace: in no root of the search
    method ReportMissing(const AName: string; const APlace: SourcePlace);
    begin
      self.DoError(ADAM_ERR_CIMPORT_HEADERS_002, APlace, ADAM_MSG_CIMPORT_HEADERS_NOT_FOUND,
        NoArgs().Str(AName).Int(len(self.FSources)));
    end;
  end;

end.
