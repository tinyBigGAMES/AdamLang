-------------------------------------------------------------------------------
  Adam.Backend.Targets.adam - the backends Adam has (DESIGN sec 6)

  Backend       one target's three parts (Adam.Backend.Parts), composed: an
                arch part, an ABI part and a format part, for one triple
  BackendFor    the Backend of a triple; nil when Adam generates no code
                for it (the Driver's DR0006)

  This is the one place a target's parts are put together: a new target is
  one more entry in DoCandidates, made of new or existing parts. The front
  end's targets (Adam.Target.Registry) are a separate list: a triple can
  have a target (it is checked and laid out) before it has a backend.
*******************************************************************************/

module unit Adam.Backend.Targets;

import Adam.Backend.Parts, Adam.X64.Arch, Adam.Win64.ABI, Adam.COFF.Format, Adam.COFF.Writer,
  Adam.SysV.ABI, Adam.ELF.Format, Adam.ELF.Writer;

public const
  // The triple of the first backend: x86_64 + Windows x64 + COFF / PE
  ADAM_BACKEND_WIN64_TRIPLE: string = "x86_64-windows-gnu";
  // The second: x86_64 + System V + ELF (PLAN-LINUX64 LX2a)
  ADAM_BACKEND_LINUX64_TRIPLE: string = "x86_64-linux-gnu";

public type
  // One target's composed parts (see the header)
  Backend = object
    hidden FTriple: string;
    hidden FArch: ref ArchPart;
    hidden FABI: ref ABIPart;
    hidden FFormat: ref FormatPart;

    init(const ATriple: string; const AArch: ref ArchPart; const AABI: ref ABIPart;
      const AFormat: ref FormatPart);
    begin
      self.FTriple := ATriple;
      self.FArch := AArch;
      self.FABI := AABI;
      self.FFormat := AFormat;
    end;

    // The triple it generates code for (normalized, arch-os-abi)
    property Triple: string read FTriple;
    property Arch: ref ArchPart read FArch;
    property ABI: ref ABIPart read FABI;
    property Format: ref FormatPart read FFormat;
  end;

  // Every Backend Adam has, made fresh (a compile owns the one it picks)
  BackendList = array of ref Backend;

// Every backend, in the order a message lists them
func DoCandidates(): BackendList;
var
  LList: BackendList;
begin
  setlength(LList, 2);
  LList[0] := ref Backend(ADAM_BACKEND_WIN64_TRIPLE, ref X64Arch(), ref Win64ABI(),
    ref COFFFormat(COFFMachineAmd64()));
  LList[1] := ref Backend(ADAM_BACKEND_LINUX64_TRIPLE, ref X64Arch(), ref SysVABI(),
    ref ELFFormat(ElfMachineX86_64()));
  return LList;
end;

// The Backend whose triple is ATriple (normalized, arch-os-abi); nil when Adam has none
public func BackendFor(const ATriple: string): ref Backend;
var
  LList: BackendList;
  LI: int64;
begin
  LList := DoCandidates();
  for LI := 0 to len(LList) - 1 do
    if LList[LI].Triple = ATriple then
      return LList[LI];
    end;
  end;
  return nil;
end;

// The triples of every backend, comma separated, as a message lists them
public func KnownBackends(): string;
var
  LList: BackendList;
  LI: int64;
  LText: string;
begin
  LList := DoCandidates();
  LText := "";
  for LI := 0 to len(LList) - 1 do
    if LI > 0 then
      LText := LText + ", ";
    end;
    LText := LText + LList[LI].Triple;
  end;
  return LText;
end;

end.
