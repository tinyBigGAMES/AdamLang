  Adam.Dev.Stamp.Win64.adam - Adam.Dev.Stamp's x86_64-windows-gnu part over
  std System.Windows: the program loaded as a data file (LoadLibraryExW) and
  its resources of the list's types listed in every language
  (EnumResourceNamesW / EnumResourceLanguagesW), then one update
  (BeginUpdateResourceW .. EndUpdateResourceW): each found one deleted (no
  data), each of the list's added; any refusal discards the update
*******************************************************************************/

module unit Adam.Dev.Stamp.Win64;

import System.SysUtils, System.Windows, Adam.Coff.Resources, Adam.Dev.Stamp.Step;

type
  // A UTF-16 buffer on the heap (64 KB off the stack frame)
  StampWide = final object
    Data: WideBuffer;
  end;

  // One resource the program holds: its type, its name (an id, or a text), its language
  StampFound = record
    TypeId: uint64;
    NameId: uint64;
    NameText: string;
    Language: uint16;
  end;

  StampFoundArray = array of StampFound;

  // The listing's state, handed to the callbacks: what was found, the name being listed
  StampScan = record
    Found: StampFoundArray;
    TypeId: uint64;
    NameId: uint64;
    NameText: string;
  end;

const
  // A type or name at or below this is an id (IS_INTRESOURCE), else a text's address
  ADAM_STAMP_ID_MAX: uint64 = 0xFFFF;

// The NUL-terminated UTF-16 text at AAddress as UTF-8
func DoWideAt(const AAddress: uint64): string;
var
  LUnits: ptr to uint16;
  LBox: own StampWide;
  LCount: int32;
begin
  LBox := own StampWide();
  LUnits := ptr to uint16(ptr(AAddress));
  LCount := 0;
  while (LCount < ADAM_WINDOWS_WIDE_MAX) and (LUnits[LCount] <> 0) do
    LBox.Data[LCount] := LUnits[LCount];
    LCount := LCount + 1;
  end;
  LBox.Data[LCount] := 0;
  return WideToUtf8(LBox.Data, LCount);
end;

// EnumResourceLanguagesW's callback: the name being listed, in ALanguage, kept
func clink DoLanguage(AModule: uint64; AType: uint64; AName: uint64; ALanguage: uint16;
  AParam: ptr): int32;
var
  LScan: ptr to StampScan;
  LCount: int64;
begin
  LScan := ptr to StampScan(AParam);
  LCount := len(LScan->Found);
  setlength(LScan->Found, LCount + 1);
  LScan->Found[LCount].TypeId := LScan->TypeId;
  LScan->Found[LCount].NameId := LScan->NameId;
  LScan->Found[LCount].NameText := LScan->NameText;
  LScan->Found[LCount].Language := ALanguage;
  return 1;
end;

// EnumResourceNamesW's callback: each of the name's languages listed
func clink DoName(AModule: uint64; AType: uint64; AName: uint64; AParam: ptr): int32;
var
  LScan: ptr to StampScan;
begin
  LScan := ptr to StampScan(AParam);
  LScan->TypeId := AType;
  if AName > ADAM_STAMP_ID_MAX then
    LScan->NameId := 0;
    LScan->NameText := DoWideAt(AName);
  else
    LScan->NameId := AName;
    LScan->NameText := "";
  end;
  EnumResourceLanguagesW(AModule, AType, AName, DoLanguage, AParam);
  return 1;
end;

// True when ATypes holds AType
func DoHasType(const ATypes: Int64Array; const AType: int64): bool;
var
  LI: int64;
begin
  for LI := 0 to len(ATypes) - 1 do
    if ATypes[LI] = AType then
      return true;
    end;
  end;
  return false;
end;

// One resource deleted (AData nil) or put (its bytes) under its type, name and language;
// a text name passed as its UTF-16 address
func DoUpdate(const AUpdate: uint64; const AType: uint64; const ANameId: uint64;
  const ANameText: string; const ALanguage: uint16; const AData: ptr to const;
  const ASize: uint32): bool;
var
  LName: own StampWide;
begin
  if ANameText = "" then
    return UpdateResourceW(AUpdate, AType, ANameId, ALanguage, AData, ASize) <> 0;
  end;
  LName := own StampWide();
  if not Utf8ToWide(ANameText, LName.Data) then
    return false;
  end;
  return UpdateResourceW(AUpdate, AType, uint64(addr of LName.Data), ALanguage, AData,
    ASize) <> 0;
end;

// Adam.Dev.Stamp's StampResources on this host (see the header)
public func DevStampPlatformResources(const APath: string; const AResources: ImageResourceList;
  var AStep: StampStep; var ACode: uint32): bool;
var
  LPath: own StampWide;
  LTypes: Int64Array;
  LScan: StampScan;
  LModule: uint64;
  LUpdate: uint64;
  LResource: ref ImageResource;
  LI: int64;
begin
  AStep := StampStep.None;
  ACode := 0;
  LPath := own StampWide();
  if not Utf8ToWide(APath, LPath.Data) then
    AStep := StampStep.Read;
    return false;
  end;
  setlength(LTypes, 0);
  for LI := 0 to len(AResources) - 1 do
    if not DoHasType(LTypes, AResources[LI].TypeId) then
      setlength(LTypes, len(LTypes) + 1);
      LTypes[len(LTypes) - 1] := AResources[LI].TypeId;
    end;
  end;

  // What the program holds of those types, every language (a type it has none of lists
  // nothing)
  LModule := LoadLibraryExW(LPath.Data, 0, LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE);
  if LModule = 0 then
    AStep := StampStep.Read;
    ACode := GetLastError();
    return false;
  end;
  setlength(LScan.Found, 0);
  for LI := 0 to len(LTypes) - 1 do
    EnumResourceNamesW(LModule, uint64(LTypes[LI]), DoName, ptr(addr of LScan));
  end;
  FreeLibrary(LModule);

  LUpdate := BeginUpdateResourceW(LPath.Data, 0);
  if LUpdate = 0 then
    AStep := StampStep.Open;
    ACode := GetLastError();
    return false;
  end;
  for LI := 0 to len(LScan.Found) - 1 do
    if not DoUpdate(LUpdate, LScan.Found[LI].TypeId, LScan.Found[LI].NameId,
      LScan.Found[LI].NameText, LScan.Found[LI].Language, nil, 0) then
      AStep := StampStep.Delete;
      ACode := GetLastError();
      EndUpdateResourceW(LUpdate, 1);
      return false;
    end;
  end;
  for LI := 0 to len(AResources) - 1 do
    LResource := AResources[LI];
    if not DoUpdate(LUpdate, uint64(LResource.TypeId), uint64(LResource.NameId),
      LResource.NameText, uint16(LResource.Language), ptr to const(addr of LResource.Bytes[0]),
      uint32(len(LResource.Bytes))) then
      AStep := StampStep.Add;
      ACode := GetLastError();
      EndUpdateResourceW(LUpdate, 1);
      return false;
    end;
  end;
  if EndUpdateResourceW(LUpdate, 0) = 0 then
    AStep := StampStep.Commit;
    ACode := GetLastError();
    return false;
  end;
  return true;
end;

end.
