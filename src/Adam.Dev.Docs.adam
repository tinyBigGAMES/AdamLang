-------------------------------------------------------------------------------
  Adam.Dev.Docs.adam - adam --dev-docs <unit> (PLAN-DOCS D1, his OK
  2026-11-27): a unit's public declarations and their `///` docs as one line
  of JSON, a developer's job (never in the help, as --dev-pack): docgen's
  stdlib.py reads it, so the docs take a unit's API from the compiler's own
  front end (the Parser's doc attach rules, Adam.LSP.Docs' tag reader,
  Adam.LSP.Hover's headings), never from a second reader of the source.

  The unit is checked as the language server checks a document
  (Compiler.CheckDocument: a unit may be the main module). Its entries are
  Adam.LSP.Outline's, in source order, only the public ones
  (OutlineIsPublic: a module's own declaration written public, a member not
  hidden), imports left out; a type's and an extend's members nested under
  it. Each entry: name (OutlineName), kind (NodeKindWords), symbol (LSP's
  SymbolKind, a type by its form), declaration (DeclarationText: what a
  hover shows), line, documented (a `///` doc is attached), doc (DocPartsOf:
  summary, params, returns, raises, see, deprecated, since, example,
  exampleNote), members.

  {"unit": .., "entries": [ .. ]} on stdout and true; a unit
  that is missing or has errors prints its reports and DOCS FAILED - <why>,
  then false.
*******************************************************************************/

module unit Adam.Dev.Docs;

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Core.Messages, Adam.Compiler.AST,
  Adam.Compiler.Diagnostics, Adam.Driver.Compiler, Adam.LSP.Document, Adam.LSP.Docs,
  Adam.LSP.Hover, Adam.LSP.Outline;

// The last line of a failed run (DOCS FAILED - AWhat), then false
func DoFailed(const AWhat: string): bool;
begin
  // "{}": the text is printed as it is, never read as a format (a path may hold braces)
  println("{}", NoArgs().Str(AWhat).Fill(ADAM_MSG_DEV_DOCS_FAILED));
  FlushOutput();
  return false;
end;

// AList as the array AKey of the object AJSON is making
func DoAddStrings(var AJSON: JSON; const AKey: string; const AList: StringArray);
var
  LI: int64;
begin
  AJSON.BeginArray(AKey);
  for LI := 0 to len(AList) - 1 do
    AJSON.Add(AList[LI]);
  end;
  AJSON.EndArray();
end;

// The doc comment text ADocText's parts as the object "doc" of the entry AJSON is making
func DoAddDoc(var AJSON: JSON; const ADocText: string);
var
  LDoc: DocParts;
  LI: int64;
begin
  LDoc := DocPartsOf(ADocText);
  AJSON.BeginObject("doc");
  AJSON.Add("summary", LDoc.Summary);
  AJSON.BeginArray("params");
  for LI := 0 to len(LDoc.ParamNames) - 1 do
    AJSON.BeginObject();
    AJSON.Add("name", LDoc.ParamNames[LI]);
    AJSON.Add("text", LDoc.ParamTexts[LI]);
    AJSON.EndObject();
  end;
  AJSON.EndArray();
  DoAddStrings(AJSON, "returns", LDoc.Returns);
  DoAddStrings(AJSON, "raises", LDoc.Raises);
  DoAddStrings(AJSON, "see", LDoc.See);
  DoAddStrings(AJSON, "deprecated", LDoc.Deprecated);
  DoAddStrings(AJSON, "since", LDoc.Since);
  AJSON.Add("example", LDoc.Example);
  AJSON.Add("exampleNote", LDoc.ExampleNote);
  AJSON.EndObject();
end;

// True for an entry whose outline children are its API (a type's members, an extend's);
// a routine's are its local types, no part of it
func DoHasMembers(const AKind: NodeKind): bool;
begin
  return (AKind = NodeKind.TypeDecl) or (AKind = NodeKind.ExtendDecl);
end;

// The outline entry AId of ATree (its file's text ADocument) appended to the array AJSON is
// making, when another module sees it (see the header)
func DoAddEntry(var AJSON: JSON; const ATree: ref SyntaxTree; const AId: int64;
  const ADocument: ref LSPDocument);
var
  LChildren: Int64Array;
  LI: int64;
begin
  if (ATree[AId].Kind = NodeKind.Import) or not OutlineIsPublic(ATree, AId) then
    return;
  end;
  AJSON.BeginObject();
  AJSON.Add("name", OutlineName(ATree, AId));
  AJSON.Add("kind", NodeKindWords(ATree[AId].Kind));
  AJSON.Add("symbol", OutlineKind(ATree, AId));
  AJSON.Add("declaration", DeclarationText(ATree, AId, ADocument));
  AJSON.Add("line", int64(ATree[AId].Place.Line));
  AJSON.Add("documented", Trim(ATree[AId].DocText) <> "");
  DoAddDoc(AJSON, ATree[AId].DocText);
  AJSON.BeginArray("members");
  if DoHasMembers(ATree[AId].Kind) then
    LChildren := OutlineChildren(ATree, AId);
    for LI := 0 to len(LChildren) - 1 do
      DoAddEntry(AJSON, ATree, LChildren[LI], ADocument);
    end;
  end;
  AJSON.EndArray();
  AJSON.EndObject();
end;

// adam --dev-docs APath (see the header): true after the JSON line, false after DOCS FAILED
public func DevDocs(const APath: string): bool;
var
  LCompiler: ref Compiler;
  LText: string;
  LDocument: ref LSPDocument;
  LOut: JSON;
  LChildren: Int64Array;
  LI: int64;
begin
  if APath = "" then
    return DoFailed(ADAM_MSG_DEV_DOCS_NO_UNIT);
  end;
  if not FileExists(APath) then
    return DoFailed(NoArgs().Str(APath).Fill(ADAM_MSG_DEV_DOCS_NO_FILE));
  end;
  LCompiler := ref Compiler();
  LCompiler.CheckDocument(APath);
  if (LCompiler.Reports.ErrorCount > 0) or (LCompiler.MainModule = 0) then
    LCompiler.PrintReports();
    return DoFailed(ADAM_MSG_DEV_DOCS_ERRORS);
  end;
  // The unit's text as the front end read it: the headings are cut from it
  LText := "";
  if not LCompiler.LoadedText(APath, LText) then
    if not ReadAllText(APath, LText) then
      return DoFailed(NoArgs().Str(APath).Fill(ADAM_MSG_DEV_DOCS_NO_FILE));
    end;
  end;
  if StartsStr(ADAM_LSP_DOCUMENT_BOM, LText) then
    LText := Substring(LText, len(ADAM_LSP_DOCUMENT_BOM), len(LText) - len(ADAM_LSP_DOCUMENT_BOM));
  end;
  LDocument := ref LSPDocument("", APath, -1, LText);
  LOut.Add("unit", LCompiler.Tree[LCompiler.MainModule].Text);
  LOut.BeginArray("entries");
  LChildren := OutlineChildren(LCompiler.Tree, LCompiler.MainModule);
  for LI := 0 to len(LChildren) - 1 do
    DoAddEntry(LOut, LCompiler.Tree, LChildren[LI], LDocument);
  end;
  LOut.EndArray();
  println("{}", LOut.ToString());
  FlushOutput();
  return true;
end;

end.
