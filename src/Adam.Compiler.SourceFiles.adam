-------------------------------------------------------------------------------
  Adam.Compiler.SourceFiles.adam - Every source file of one build

  SourceFiles   the one owner of a build's sources: each file is read once
                and kept for the whole build (every phase reads slices of it
                by a node's offsets). A file's text can be given in place of
                the disk (an editor's unsaved buffer, a test's source): it
                stands for the file whatever spelling the build reaches it
                by (an import's folder + '/' + name, a module path's), the
                OS's own comparison of paths with the file name's case
                exact (DoGivenIndex). An
                import is looked for in the importer's folder, then in the
                module paths in the order they were added; the file name's
                case must be the module name's (BNF sec 1)
  FolderNames   each folder an import is looked for in, listed from the disk
                once per build (shared with the unit compiles it starts)
  ResolveDirectivePath  a path directive's value resolved ($P: / $D: / $R:),
                the parser's for a literal and Semantics' for a constant's
                value (BNF sec 2), so both resolve it one way

  It sits above SourceText (which reads no file) and below the parser, so
  the parser asks for files by name and never touches the disk itself.
  Paths are kept as given and compared as text (a given text aside).
*******************************************************************************/

module unit Adam.Compiler.SourceFiles;

import System.SysUtils, System.IO, Adam.Core.Common, Adam.Compiler.SourceText;

// The path directive value AValue resolved as BNF sec 2 says: $R: the project root ARoot,
// $P: the compiler's folder, $D: or no prefix the working folder (System.IO's ResolvePath).
// "" when it resolves to nothing (blank, a bare prefix), or when it starts with $R: and
// ARoot is "" (the build has no project): ANoRoot true then
public func ResolveDirectivePath(const AValue: string; const ARoot: string;
  var ANoRoot: bool): string;
var
  LTrimmed: string;
begin
  ANoRoot := false;
  LTrimmed := Trim(AValue);
  if (len(LTrimmed) >= 3) and (LTrimmed[0] = '$') and ((LTrimmed[1] = 'R') or
    (LTrimmed[1] = 'r')) and (LTrimmed[2] = ':') then
    if ARoot = "" then
      ANoRoot := true;
      return "";
    end;
    return ResolvePath(Substring(LTrimmed, 3, len(LTrimmed) - 3), ARoot);
  end;
  return ResolvePath(AValue);
end;

// ADir joined with AName: '/' between them unless ADir is empty or ends in a separator
func DoJoin(const ADir: string; const AName: string): string;
var
  LLast: char;
begin
  if ADir = "" then
    return AName;
  end;
  LLast := ADir[len(ADir) - 1];
  if (LLast = '/') or (LLast = '\\') then
    return ADir + AName;
  end;
  return ADir + "/" + AName;
end;

// The index of AText in AList (exact text); -1 when it is not there
func DoIndexOf(const AList: StringArray; const AText: string): int64;
var
  LI: int64;
begin
  for LI := 0 to len(AList) - 1 do
    if AList[LI] = AText then
      return LI;
    end;
  end;
  return -1;
end;

// AText added at the end of AList
func DoAppend(var AList: StringArray; const AText: string);
var
  LCount: int64;
begin
  LCount := len(AList);
  setlength(AList, LCount + 1);
  AList[LCount] := AText;
end;

type
  // The file names of the folders a build looks for imports in, each folder listed from
  // the disk on its first ask only: every import of every unit is looked for in the same
  // few folders, and a listing is a read of the whole folder. Shared by a build and the
  // unit compiles it starts (SourceFiles.InheritFrom), which look in the same folders
  FolderNames = object
    hidden FDirs: StringArray;
    hidden FListed: BoolArray;
    hidden FNames: array of StringArray;

    init();
    begin
      setlength(self.FDirs, 0);
      setlength(self.FListed, 0);
      setlength(self.FNames, 0);
    end;

    // True when the folder ADir has a file named AName with exactly that case; false for
    // a folder that cannot be listed (missing, not a folder)
    method Has(const ADir: string; const AName: string): bool;
    var
      LIndex: int64;
      LList: StringArray;
    begin
      LIndex := DoIndexOf(self.FDirs, ADir);
      if LIndex < 0 then
        LIndex := len(self.FDirs);
        DoAppend(self.FDirs, ADir);
        setlength(self.FListed, LIndex + 1);
        setlength(self.FNames, LIndex + 1);
        setlength(LList, 0);
        self.FListed[LIndex] := GetFiles(ADir, LList);
        if not self.FListed[LIndex] then
          setlength(LList, 0);
        end;
        self.FNames[LIndex] := LList;
      end;
      return self.FListed[LIndex] and (DoIndexOf(self.FNames[LIndex], AName) >= 0);
    end;
  end;

public type
  // The source files of one build (see the header)
  SourceFiles = object
    hidden FPaths: StringArray;
    hidden FTexts: array of ref SourceText;
    hidden FFolders: ref FolderNames;
    hidden FGivenPaths: StringArray;
    hidden FGivenTexts: StringArray;
    hidden FModulePaths: StringArray;
    hidden FProjectRoot: string;
    // Each loaded file's size and write time, taken before its text was read (a given
    // text: its byte count and 0), at its load index
    hidden FSizes: Int64Array;
    hidden FTimes: Int64Array;

    init();
    begin
      self.FProjectRoot := "";
      setlength(self.FSizes, 0);
      setlength(self.FTimes, 0);
      self.FFolders := ref FolderNames();
    end;

    // The module paths, the given texts and the project root of AOther, the build this one
    // compiles a unit for (Adam.Driver.Compiler's unit compiles): its imports are then found
    // as AOther finds them, in AOther's folder listings. Before anything is loaded
    method InheritFrom(const AOther: ref SourceFiles);
    var
      LI: int64;
    begin
      self.FFolders := AOther.FFolders;
      for LI := 0 to len(AOther.FModulePaths) - 1 do
        self.AddModulePath(AOther.FModulePaths[LI]);
      end;
      for LI := 0 to len(AOther.FGivenPaths) - 1 do
        self.AddText(AOther.FGivenPaths[LI], AOther.FGivenTexts[LI]);
      end;
      self.FProjectRoot := AOther.FProjectRoot;
    end;

    // The size and write time the loaded file at AIndex had when its text was read (see
    // FSizes): what a compiled unit's header records of its source, so an edit made while
    // the build runs is never taken for the text it compiled
    const method StampOf(const AIndex: int64; var ASize: int64; var ATime: int64);
    begin
      ASize := self.FSizes[AIndex];
      ATime := self.FTimes[AIndex];
    end;

    // The load index of APath (-1 when it is not loaded)
    const method IndexOf(const APath: string): int64;
    begin
      return DoIndexOf(self.FPaths, APath);
    end;

    // The project's folder, what $R: names in a path directive ("" = the build has no
    // project: a $R: path is then an error at its directive)
    method SetProjectRoot(const ADir: string);
    begin
      self.FProjectRoot := ADir;
    end;

    // See SetProjectRoot
    const method ProjectRoot(): string;
    begin
      return self.FProjectRoot;
    end;

    // How many files are loaded
    property Count: int64
      read
      begin
        return len(self.FTexts);
      end;

    // The loaded file at AIndex (0-based, in load order)
    property Items[AIndex: int64]: ref SourceText
      read
      begin
        return self.FTexts[AIndex];
      end;
      default;

    // The index of the given text that stands for the file APath (see the header): the same
    // file name, case and all, and the same file as the OS compares paths (System.IO's
    // SamePath: '/' and '\' alike on win64, which ignores case); -1 when no text is given
    // for it. A build with no given text never asks the OS
    hidden const method DoGivenIndex(const APath: string): int64;
    var
      LI: int64;
      LName: string;
    begin
      if len(self.FGivenPaths) = 0 then
        return -1;
      end;
      LName := ExtractFileName(APath);
      for LI := 0 to len(self.FGivenPaths) - 1 do
        if (ExtractFileName(self.FGivenPaths[LI]) = LName) and
          SamePath(self.FGivenPaths[LI], APath) then
          return LI;
        end;
      end;
      return -1;
    end;

    // The text of APath is AText, in place of the disk (see DoGivenIndex); a later call for
    // the same file replaces it
    method AddText(const APath: string; const AText: string);
    var
      LIndex: int64;
    begin
      LIndex := self.DoGivenIndex(APath);
      if LIndex >= 0 then
        self.FGivenTexts[LIndex] := AText;
        return;
      end;
      DoAppend(self.FGivenPaths, APath);
      DoAppend(self.FGivenTexts, AText);
    end;

    // Adds ADir after the module paths already there; a folder already there (the same
    // text) is not added again
    method AddModulePath(const ADir: string);
    begin
      if DoIndexOf(self.FModulePaths, ADir) < 0 then
        DoAppend(self.FModulePaths, ADir);
      end;
    end;

    // True when the file AName (no folder) is in ADir with exactly that case: a given
    // text, or a file the folder lists (FFolders: listed once per build, so not const)
    hidden method DoHasFile(const ADir: string; const AName: string): bool;
    begin
      if self.DoGivenIndex(DoJoin(ADir, AName)) >= 0 then
        return true;
      end;
      return self.FFolders.Has(ADir, AName);
    end;

    // The path of the file of the unit AName (AName + ADAM_EXT_SOURCE): first in AImporterDir,
    // then in each module path in its order; "" when none has it. An empty AImporterDir (an
    // implicit import: nothing imports it) looks in the module paths only. Not const: a
    // folder's first look lists it (DoHasFile)
    method FindUnit(const AName: string; const AImporterDir: string): string;
    var
      LFile: string;
      LI: int64;
    begin
      LFile := AName + ADAM_EXT_SOURCE;
      if (AImporterDir <> "") and self.DoHasFile(AImporterDir, LFile) then
        return DoJoin(AImporterDir, LFile);
      end;
      for LI := 0 to len(self.FModulePaths) - 1 do
        if self.DoHasFile(self.FModulePaths[LI], LFile) then
          return DoJoin(self.FModulePaths[LI], LFile);
        end;
      end;
      return "";
    end;

    // Loads APath once (its given text, else the file on the disk): its index, or -1 when
    // it cannot be read. A path loaded already gives the index it got then
    method Load(const APath: string): int64;
    var
      LIndex: int64;
      LText: string;
      LCount: int64;
      LSize: int64;
      LTime: int64;
    begin
      LIndex := DoIndexOf(self.FPaths, APath);
      if LIndex >= 0 then
        return LIndex;
      end;
      LIndex := self.DoGivenIndex(APath);
      if LIndex >= 0 then
        LText := self.FGivenTexts[LIndex];
        LSize := len(LText);
        LTime := 0;
      else
        // The stamp before the read: a file written after it gets a later time, so the next
        // build compares its bytes and finds them changed
        LSize := FileSize(APath);
        LTime := FileWriteTime(APath);
        if not ReadAllText(APath, LText) then
          return -1;
        end;
      end;
      LCount := len(self.FTexts);
      setlength(self.FTexts, LCount + 1);
      self.FTexts[LCount] := ref SourceText(APath, LText);
      setlength(self.FSizes, LCount + 1);
      self.FSizes[LCount] := LSize;
      setlength(self.FTimes, LCount + 1);
      self.FTimes[LCount] := LTime;
      DoAppend(self.FPaths, APath);
      return LCount;
    end;
  end;

end.
