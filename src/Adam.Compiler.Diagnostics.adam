-------------------------------------------------------------------------------
  Adam.Compiler.Diagnostics.adam - Errors in Adam's words

  MessageArgs   a message's arguments, filled into its `{}` holes in order
  Diagnostic    one report: severity, code, the place it is about (an
                embedded SourcePlace), the message template and its args
  Diagnostics   the one list every phase reports into (owned by
                Adam.Driver.Compiler, passed down), with the error budget

  A diagnostic keeps its template and args, never a pre-formatted string:
  the text is made when it is read (Text / Display), so the templates stay
  resourcestrings in waiting (Adam.Core.Messages). The printed form is
  PaskalCPP's: `file(line,col): Error LX0001: text`.

  Nothing is dropped silently: once the errors reach the budget, one Fatal
  DG0001 says so and later errors are not kept. A malformed code (DG0002)
  or a template whose holes do not match its args (DG0003) is a defect in
  the compiler: it is reported as Fatal beside the report, which is kept.
*******************************************************************************/

module unit Adam.Compiler.Diagnostics;

import System.SysUtils, Adam.Core.Common, Adam.Core.Messages, Adam.Compiler.SourceText;

public const
  ADAM_ERR_DIAGNOSTICS_001: string = "DG0001";
  ADAM_ERR_DIAGNOSTICS_002: string = "DG0002";
  ADAM_ERR_DIAGNOSTICS_003: string = "DG0003";

// The number of `{}` holes in ATemplate
routine DoCountHoles(const ATemplate: string): int64;
var
  LI: int64;
  LCount: int64;
begin
  LCount := 0;
  LI := 0;
  while LI < len(ATemplate) - 1 do
    if (ATemplate[LI] = '{') and (ATemplate[LI + 1] = '}') then
      LCount := LCount + 1;
      LI := LI + 2;
    else
      LI := LI + 1;
    end;
  end;
  return LCount;
end;

// True when ACode has a code's shape: two capitals, then four digits (LX0001)
routine DoIsCode(const ACode: string): bool;
var
  LI: int64;
begin
  if len(ACode) <> 6 then
    return false;
  end;
  for LI := 0 to 1 do
    if (ACode[LI] < 'A') or (ACode[LI] > 'Z') then
      return false;
    end;
  end;
  for LI := 2 to 5 do
    if (ACode[LI] < '0') or (ACode[LI] > '9') then
      return false;
    end;
  end;
  return true;
end;

public type
  // How bad a report is. Error counts against the budget; Fatal always shows
  Severity = choices(Hint, Warning, Error, Fatal);

  // A message's arguments as text, in hole order. Built by chaining:
  // NoArgs().Str(LName).Int(LCount); every method leaves self as it was
  MessageArgs = object
    hidden FValues: StringArray;

    // These arguments and AValue after them
    const method Str(const AValue: string): MessageArgs;
    var
      LArgs: MessageArgs;
      LCount: int64;
    begin
      LArgs := self;
      LCount := len(LArgs.FValues);
      setlength(LArgs.FValues, LCount + 1);
      LArgs.FValues[LCount] := AValue;
      return LArgs;
    end;

    // These arguments and AValue's decimal text after them
    const method Int(const AValue: int64): MessageArgs;
    begin
      return self.Str(IntToStr(AValue));
    end;

    // How many arguments there are
    property Count: int64
      read
      begin
        return len(self.FValues);
      end;

    // ATemplate with its holes filled by the arguments in order. A hole
    // with no argument left stays `{}`; an argument with no hole is unused
    // (Add reports both as DG0003 before it keeps the diagnostic)
    const method Fill(const ATemplate: string): string;
    var
      LText: string;
      LI: int64;
      LNext: int64;
    begin
      LText := "";
      LI := 0;
      LNext := 0;
      while LI < len(ATemplate) do
        if (LI < len(ATemplate) - 1) and (ATemplate[LI] = '{') and
          (ATemplate[LI + 1] = '}') and (LNext < len(self.FValues)) then
          LText := LText + self.FValues[LNext];
          LNext := LNext + 1;
          LI := LI + 2;
        else
          LText := LText + Substring(ATemplate, LI, 1);
          LI := LI + 1;
        end;
      end;
      return LText;
    end;
  end;

  // One report, immutable once made. Its place is embedded: FileName, Line
  // and Column read through it
  Diagnostic = object
    embed Place: SourcePlace;
    hidden FSeverity: Severity;
    hidden FCode: string;
    hidden FTemplate: string;
    hidden FArgs: MessageArgs;

    init(const ASeverity: Severity; const ACode: string; const APlace: SourcePlace;
      const ATemplate: string; const AArgs: MessageArgs);
    begin
      self.Place := APlace;
      self.FSeverity := ASeverity;
      self.FCode := ACode;
      self.FTemplate := ATemplate;
      self.FArgs := AArgs;
    end;

    // How bad it is (named Level: Severity is its type's name)
    property Level: Severity read FSeverity;
    property Code: string read FCode;

    // The message, its holes filled
    const method Text(): string;
    begin
      return self.FArgs.Fill(self.FTemplate);
    end;

    // The severity as the user reads it
    const method SeverityText(): string;
    var
      LText: string;
    begin
      match self.FSeverity of
        Severity.Hint: LText := ADAM_MSG_DIAGNOSTICS_HINT;
        Severity.Warning: LText := ADAM_MSG_DIAGNOSTICS_WARNING;
        Severity.Error: LText := ADAM_MSG_DIAGNOSTICS_ERROR;
        Severity.Fatal: LText := ADAM_MSG_DIAGNOSTICS_FATAL;
      end;
      return LText;
    end;

    // True for Error and Fatal: a report that stops the build
    const method IsError(): bool;
    begin
      return (self.FSeverity = Severity.Error) or (self.FSeverity = Severity.Fatal);
    end;

    // The severity word as printed: in its color (Adam.Core.Common's VT sequences) when
    // AColor, else plain
    hidden const method DoSeverityShown(const AColor: bool): string;
    var
      LColor: string;
    begin
      if not AColor then
        return self.SeverityText();
      end;
      match self.FSeverity of
        Severity.Hint: LColor := ADAM_COLOR_CYAN;
        Severity.Warning: LColor := ADAM_COLOR_YELLOW;
        Severity.Error: LColor := ADAM_COLOR_RED;
        Severity.Fatal: LColor := ADAM_COLOR_RED;
      end;
      return LColor + self.SeverityText() + ADAM_COLOR_RESET;
    end;

    // The printed line: `file(line,col): Error LX0001: text`, the place cut
    // to what the report has; the severity word in its color when AColor (a console)
    const method DisplayIn(const AColor: bool): string;
    var
      LArgs: MessageArgs;
    begin
      if self.Place.IsNone() then
        LArgs := LArgs.Str(self.DoSeverityShown(AColor)).Str(self.FCode).Str(self.Text());
        return LArgs.Fill(ADAM_MSG_DIAGNOSTICS_NO_PLACE);
      end;
      if self.Place.IsWholeFile() then
        LArgs := LArgs.Str(self.Place.FileName).Str(self.DoSeverityShown(AColor));
        LArgs := LArgs.Str(self.FCode).Str(self.Text());
        return LArgs.Fill(ADAM_MSG_DIAGNOSTICS_IN_FILE);
      end;
      LArgs := LArgs.Str(self.Place.FileName).Int(int64(self.Place.Line));
      LArgs := LArgs.Int(int64(self.Place.Column)).Str(self.DoSeverityShown(AColor));
      LArgs := LArgs.Str(self.FCode).Str(self.Text());
      return LArgs.Fill(ADAM_MSG_DIAGNOSTICS_AT);
    end;

    // The printed line, plain (DisplayIn with no color): what a file, a pipe, a test reads
    const method Display(): string;
    begin
      return self.DisplayIn(false);
    end;
  end;

  // The reports of one compile, in the order made. ABudget is how many
  // errors are kept (Hint / Warning / Fatal never count)
  Diagnostics = object
    hidden FItems: array of ref Diagnostic;
    hidden FBudget: int64;
    hidden FErrorCount: int64;
    hidden FBudgetReached: bool;
    hidden FColor: bool;

    init(const ABudget: int64);
    begin
      self.FBudget := ABudget;
      self.FErrorCount := 0;
      self.FBudgetReached := false;
      self.FColor := false;
    end;

    // AOn: PrintAll writes each severity word in its color (the output is a console that
    // takes VT sequences); off (the start): plain, as a pipe or a file needs
    method SetColor(const AOn: bool);
    begin
      self.FColor := AOn;
    end;

    property Budget: int64 read FBudget;
    property ErrorCount: int64 read FErrorCount;

    // True once an Error was turned away by the budget
    property BudgetReached: bool read FBudgetReached;

    property Count: int64
      read
      begin
        return len(self.FItems);
      end;

    // The report at AIndex (0-based, in the order made)
    property Items[AIndex: int64]: ref Diagnostic
      read
      begin
        return self.FItems[AIndex];
      end;
      default;

    // Keeps one report as given, nothing checked
    hidden method DoKeep(const ASeverity: Severity; const ACode: string;
      const APlace: SourcePlace; const ATemplate: string; const AArgs: MessageArgs);
    var
      LCount: int64;
    begin
      LCount := len(self.FItems);
      setlength(self.FItems, LCount + 1);
      self.FItems[LCount] := ref Diagnostic(ASeverity, ACode, APlace, ATemplate, AArgs);
    end;

    // Reports ATemplate (an Adam.Core.Messages text) filled with AArgs, at
    // APlace. An Error past the budget is not kept; the first one past it
    // leaves one Fatal DG0001 instead
    method Add(const ASeverity: Severity; const ACode: string; const APlace: SourcePlace;
      const ATemplate: string; const AArgs: MessageArgs);
    var
      LArgs: MessageArgs;
      LNoPlace: SourcePlace;
    begin
      if not DoIsCode(ACode) then
        self.DoKeep(Severity.Fatal, ADAM_ERR_DIAGNOSTICS_002, APlace,
          ADAM_MSG_DIAGNOSTICS_BAD_CODE, LArgs.Str(ACode));
      end;
      if DoCountHoles(ATemplate) <> AArgs.Count then
        self.DoKeep(Severity.Fatal, ADAM_ERR_DIAGNOSTICS_003, APlace,
          ADAM_MSG_DIAGNOSTICS_ARG_COUNT,
          LArgs.Str(ACode).Int(DoCountHoles(ATemplate)).Int(AArgs.Count));
      end;
      if ASeverity = Severity.Error then
        if self.FErrorCount >= self.FBudget then
          if not self.FBudgetReached then
            self.FBudgetReached := true;
            self.DoKeep(Severity.Fatal, ADAM_ERR_DIAGNOSTICS_001, LNoPlace,
              ADAM_MSG_DIAGNOSTICS_BUDGET, LArgs.Int(self.FBudget));
          end;
          return;
        end;
        self.FErrorCount := self.FErrorCount + 1;
      end;
      self.DoKeep(ASeverity, ACode, APlace, ATemplate, AArgs);
    end;

    // True when a report of ACode at APlace with ATemplate filled with AArgs is kept
    // already (a generic's instances repeat what does not depend on their type arguments:
    // BNF sec 10 reports it once)
    const method Holds(const ACode: string; const APlace: SourcePlace; const ATemplate: string;
      const AArgs: MessageArgs): bool;
    var
      LProbe: ref Diagnostic;
      LText: string;
      LI: int64;
    begin
      LProbe := ref Diagnostic(Severity.Error, ACode, APlace, ATemplate, AArgs);
      LText := LProbe.Display();
      for LI := 0 to len(self.FItems) - 1 do
        if (self.FItems[LI].Code = ACode) and (self.FItems[LI].Display() = LText) then
          return true;
        end;
      end;
      return false;
    end;

    // Every report AOther kept appended, in its order, as it is (the warnings and hints of a
    // unit compiled for this build, Adam.Driver.Compiler's unit compile); an Error among
    // them counts as this compile's own
    method AddFrom(const AOther: ref Diagnostics);
    var
      LI: int64;
      LCount: int64;
    begin
      for LI := 0 to len(AOther.FItems) - 1 do
        if AOther.FItems[LI].Level = Severity.Error then
          self.FErrorCount := self.FErrorCount + 1;
        end;
        LCount := len(self.FItems);
        setlength(self.FItems, LCount + 1);
        self.FItems[LCount] := AOther.FItems[LI];
      end;
    end;

    // True when a kept report stops the build (an Error or a Fatal)
    const method HasErrors(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FItems) - 1 do
        if self.FItems[LI].IsError() then
          return true;
        end;
      end;
      return false;
    end;

    // Prints the kept reports from index AFirst on (0-based), one line each, in the order made
    // (in color after SetColor(true)): a caller that printed the first ones already prints
    // only those kept since (Count before they were added)
    const method PrintFrom(const AFirst: int64);
    var
      LI: int64;
    begin
      for LI := AFirst to len(self.FItems) - 1 do
        println("{}", self.FItems[LI].DisplayIn(self.FColor));
      end;
    end;

    // Prints every kept report, one line each, in the order made (in color after
    // SetColor(true))
    const method PrintAll();
    begin
      self.PrintFrom(0);
    end;
  end;

// No arguments: the start of a chain (NoArgs().Str(LName))
public routine NoArgs(): MessageArgs;
var
  LArgs: MessageArgs;
begin
  return LArgs;
end;

end.
