  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.XML.Ext.adam - XML documents in Adam, over libxml2's C API
  (System.XML.C), as easy to use as System.JSON. An Xml is a value: a view
  of one node of a parsed document that every view of it shares (held by a
  ref, so the document lives while any view does; a view costs no copy). A
  view that names nothing is a missing value: IsNull, every text "", every
  Get its default, every walk empty.

  Read: Xml.FromString / Xml.FromFile / Xml.FromIO (static) give the
  document's root element (a missing value with its ErrorText on a failure);
  Xml.TryFromString is false on a failure; Parse / LoadFromFile /
  LoadFromIO do the same into an existing value. ErrorText is
  "name(line,col): message" (name: "<text>", the path, or "<io>"), or
  "name: message" when there is no place. Blank-only text between
  elements is dropped as the document is read; no network is ever used.

  Walk: Name / LocalName / Prefix / NamespaceUri, Kind / IsElement, Text
  (the node's own text) / InnerText (all text below it), Line; attributes
  by name ("local", or "prefix:local" for a namespaced one): Has, Get (a
  string, or the default's type: int32 / int64 / float64 / bool), TryGet,
  AttributeCount / AttributeNames / Attributes; Children / Elements /
  Elements(name) / FindAll(name) as `for .. in` sequences; Parent / Next /
  Previous / NextElement / PreviousElement / FirstChild / FirstElement /
  LastElement / FindChild / Root, ChildCount / ElementCount.

  Build: Xml.New(name) / Xml.New(name, uri) (static) give a new document's
  root element. AddElement(name) / AddElement(name, text) append a child
  element and give it: "prefix:local" takes a prefix declared on it or an
  ancestor (DeclareNamespace(prefix, uri); "" the default namespace), a
  bare "local" the default namespace in scope. AddText / AddComment /
  AddCData append a node, SetText replaces the children with one text,
  SetAttribute (a string, or an int32 / int64 / float64 / bool) sets one;
  each returns the value it was called on, so calls chain, and a call that
  does not fit (a missing value, a name that is no XML name, a prefix not
  declared, a comment holding "--", a CDATA section holding "]]>")
  changes nothing. RemoveAttribute and Remove take an attribute / a node
  out. A node taken out (Remove, the children SetText replaces) is kept
  until the document goes, so a view of it never dangles.

  Write: ToString (compact) / ToPrettyString (2 spaces a level) give the
  node's own markup; SaveToFile / SaveToIO write the whole document with
  its XML declaration, pretty unless APretty is false, in UTF-8 or the
  encoding named (libxml2's built-in ones: UTF-8, UTF-16, ISO-8859-x,
  ASCII ...), through the same C file calls / IO callbacks reading uses.

  The file form goes through libxml2's own C file calls (open / _wopen),
  never System.IO: with System.HookIO imported, an io://<n>/<name> path
  (a registered IO, a .rez / zip entry) or a path a path source holds reads
  as a disk file does. FromIO reads System.CustomIO's IO through libxml2's
  IO callbacks, never a copy of its whole content. Every libxml2 block is
  Adam's heap (xmlMemSetup over getmem / resizemem / freemem), so a debug
  build's heap report covers it; libxml2 never prints: each parse has its
  own error handler. Target-neutral: no OS named.
*******************************************************************************/

module unit System.XML.Ext;

import System.SysUtils, System.IO, System.CustomIO, System.XML.C;

const
  // The errors a failed read reports (after "name(line,col): " / "name: ")
  ADAM_XML_MSG_NO_ROOM: string = "out of memory";
  ADAM_XML_MSG_OPEN_FAILED: string = "the file cannot be opened";
  ADAM_XML_MSG_IO_FAILED: string = "the IO cannot be read";
  ADAM_XML_MSG_NO_IO: string = "no IO";
  ADAM_XML_MSG_TOO_LARGE: string = "the text is too large";
  ADAM_XML_MSG_NO_ROOT: string = "the document has no root element";
  // The name errors carry for a text and for an IO
  ADAM_XML_TEXT_NAME: string = "<text>";
  ADAM_XML_IO_NAME: string = "<io>";
  // How every document is read: no network, blank-only text between elements dropped
  ADAM_XML_READ_OPTIONS: int32 = XML_PARSE_NONET | XML_PARSE_NOBLANKS;
  // The largest text one read takes (libxml2 counts a memory buffer in an int32)
  ADAM_XML_INT32_MAX: int64 = 2147483647;
  ADAM_XML_INT32_MIN: int64 = -2147483648;
  // The errors a failed Xml.New reports (after "<new>: ")
  ADAM_XML_MSG_BAD_NAME: string = "not an XML name: ";
  ADAM_XML_MSG_NO_NAMESPACE: string = "no namespace URI is given for the prefix ";
  // The name a failed Xml.New's error carries
  ADAM_XML_NEW_NAME: string = "<new>";
  // The XML version a new document declares
  ADAM_XML_VERSION: string = "1.0";
  // The encoding a save writes unless another is named
  ADAM_XML_UTF8: string = "UTF-8";
  // An attribute name only DeclareNamespace writes
  ADAM_XML_XMLNS: string = "xmlns";
  // What a comment and a CDATA section must not hold
  ADAM_XML_COMMENT_END: string = "--";
  ADAM_XML_CDATA_END: string = "]]>";
  // A bool attribute as SetAttribute writes it (Get reads true / 1, false / 0)
  ADAM_XML_TRUE: string = "true";
  ADAM_XML_FALSE: string = "false";
  // The first char of an Adam path prefix ($P: $D: $S:): the only paths resolved before a read
  ADAM_XML_PATH_PREFIX: char = '$';

type
  // What a parse's error handler keeps: the first error; until one comes, the first warning
  // (libxml2 reports an input it cannot open as a warning)
  XmlReadState = record
    Found: bool;
    IsError: bool;
    Domain: int32;
    Line: int32;
    Column: int32;
    Message: string;
  end;

// -- libxml2's allocator on Adam's heap

routine clink DoMalloc(ASize: uint64): ptr;
begin
  if ASize = 0 then
    return getmem(1);
  end;
  return getmem(int64(ASize));
end;

routine clink DoRealloc(APointer: ptr; ASize: uint64): ptr;
var
  LSize: int64;
begin
  LSize := int64(ASize);
  if LSize = 0 then
    LSize := 1;
  end;
  // C's realloc(NULL, n) is malloc(n)
  if APointer = nil then
    return getmem(LSize);
  end;
  return resizemem(APointer, LSize);
end;

routine clink DoFree(APointer: ptr);
begin
  if APointer <> nil then
    freemem(APointer);
  end;
end;

routine clink DoStrdup(AText: ptr to const char): ptr to char;
begin
  if AText = nil then
    return nil;
  end;
  return StringToC(StringFromC(AText));
end;

// -- Text between libxml2 and Adam

// A libxml2 text as an Adam string ("" for nil)
routine DoText(const AText: ptr to const xmlChar): string;
begin
  if AText = nil then
    return "";
  end;
  return StringFromC(ptr to const char(AText));
end;

// A text libxml2 made for the caller as an Adam string, the block freed ("" for nil)
routine DoTakeText(const AText: ptr to xmlChar): string;
var
  LResult: string;
begin
  if AText = nil then
    return "";
  end;
  LResult := StringFromC(ptr to const char(AText));
  xmlFree(ptr(AText));
  return LResult;
end;

// AText's bytes for a C call that takes them with their count (no NUL needed); "" for none
routine DoChars(const AText: string): ptr to const char;
begin
  if len(AText) = 0 then
    return "";
  end;
  return addr of AText[0];
end;

// APath as the file a C call opens: an Adam path prefix ($P: $D: $S:) resolved, any other
// path as written (a HookIO io:// path, or a plain one a path source may hold by that name;
// the C call takes a relative one from the working folder); nil when there is no room
routine DoFilePath(const APath: string): ptr to char;
begin
  if (len(APath) > 0) and (APath[0] = ADAM_XML_PATH_PREFIX) then
    return StringToC(ResolvePath(APath));
  end;
  return StringToC(APath);
end;

// -- Nodes

// Whether ANode is an element
routine DoIsElement(const ANode: ptr to xmlNode): bool;
begin
  return (ANode <> nil) and (ANode^.type_ = XML_ELEMENT_NODE);
end;

// A namespace's prefix + ":" before ALocal; ALocal alone with no prefix
routine DoQualified(const ANs: ptr to xmlNs; const ALocal: ptr to const xmlChar): string;
begin
  if (ANs <> nil) and (ANs^.prefix <> nil) then
    return DoText(ANs^.prefix) + ":" + DoText(ALocal);
  end;
  return DoText(ALocal);
end;

// An element's or a processing instruction's name as written (prefix:local); "" for any
// other node
routine DoName(const ANode: ptr to xmlNode): string;
begin
  if ANode = nil then
    return "";
  end;
  if ANode^.type_ = XML_ELEMENT_NODE then
    return DoQualified(ANode^.ns, ANode^.name);
  end;
  if ANode^.type_ = XML_PI_NODE then
    return DoText(ANode^.name);
  end;
  return "";
end;

// Whether ANode is an element named AName (prefix:local as written)
routine DoIsNamed(const ANode: ptr to xmlNode; const AName: string): bool;
begin
  return DoIsElement(ANode) and (DoName(ANode) = AName);
end;

// The attribute of ANode named AName ("local" for one with no namespace, "prefix:local"
// for a namespaced one); nil when it has none
routine DoFindAttribute(const ANode: ptr to xmlNode; const AName: string): ptr to xmlAttr;
var
  LAttr: ptr to xmlAttr;
begin
  if not DoIsElement(ANode) then
    return nil;
  end;
  LAttr := ANode^.properties;
  while LAttr <> nil do
    if DoQualified(LAttr^.ns, LAttr^.name) = AName then
      return LAttr;
    end;
    LAttr := LAttr^.next;
  end;
  return nil;
end;

// An attribute's value (its text, entity references expanded)
routine DoAttributeValue(const AAttr: ptr to xmlAttr): string;
begin
  return DoTakeText(xmlNodeGetContent(ptr to xmlNode(ptr(AAttr))));
end;

// -- Reading

// A parse's error handler: the first error is kept (the first warning until an error
// comes), nothing is printed
routine clink DoOnError(AUserData: ptr; AError: ptr to const xmlError);
var
  LState: ptr to XmlReadState;
  LIsError: bool;
begin
  LState := ptr to XmlReadState(AUserData);
  if (AError = nil) or (AError^.level < XML_ERR_WARNING) or (LState^.IsError) then
    return;
  end;
  LIsError := AError^.level >= XML_ERR_ERROR;
  if (LState^.Found) and (not LIsError) then
    return;
  end;
  LState^.Found := true;
  LState^.IsError := LIsError;
  LState^.Domain := AError^.domain;
  LState^.Line := AError^.line;
  LState^.Column := AError^.int2;
  LState^.Message := TrimRight(DoText(ptr to const xmlChar(AError^.message)));
end;

// libxml2's resource loader for every parse: the URL opened as written, through libxml2's
// own file calls (open / _wopen, which HookIO hooks), never rewritten by its default loader
// (xmlCanonicPath, a catalog lookup), which would break an io:// path
routine clink DoLoadResource(AContext: ptr; AUrl: ptr to const char; APublicId: ptr to const char;
  AType: xmlResourceType; AFlags: xmlParserInputFlags;
  AOut: ptr to ptr to xmlParserInput): xmlParserErrors;
begin
  return xmlNewInputFromUrl(AUrl, AFlags, AOut);
end;

// A parser context reporting to AState, loading through DoLoadResource; nil when there is no
// room
routine DoNewContext(const AState: ptr to XmlReadState): ptr to xmlParserCtxt;
var
  LContext: ptr to xmlParserCtxt;
begin
  LContext := xmlNewParserCtxt();
  if LContext <> nil then
    xmlCtxtSetErrorHandler(LContext, DoOnError, ptr(AState));
    xmlCtxtSetResourceLoader(LContext, DoLoadResource, nil);
  end;
  return LContext;
end;

// Why a read of AName failed, from AState: "AName(line,col): message", "AName: message"
// with no place, AIOFailed when the input could not be opened or read, else no room
routine DoReadError(const AName: string; const AState: XmlReadState; const AIOFailed: string): string;
begin
  if not AState.Found then
    return AName + ": " + ADAM_XML_MSG_NO_ROOM;
  end;
  if (AState.Domain = XML_FROM_IO) and (AState.Line = 0) then
    return AName + ": " + AIOFailed;
  end;
  if AState.Line > 0 then
    return AName + "(" + IntToStr(int64(AState.Line)) + "," + IntToStr(int64(AState.Column)) +
      "): " + AState.Message;
  end;
  return AName + ": " + AState.Message;
end;

// libxml2's read of an IO: AContext is the IO; -1 when the IO reports an error
routine clink DoIORead(AContext: ptr; ABuffer: ptr to char; ALength: int32): int32;
var
  LIO: IO;
  LCount: int64;
begin
  LIO := IO(AContext);
  LCount := IORead(LIO, ptr(ABuffer), int64(ALength));
  if (LCount = 0) and (IOStatus(LIO) = IOState.Error) then
    return -1;
  end;
  return int32(LCount);
end;

// libxml2's close of an IO: the IO stays the caller's
routine clink DoIOClose(AContext: ptr): int32;
begin
  return 0;
end;

// -- Writing

// libxml2's write to an IO: AContext is the IO; -1 when not all of it could be written
routine clink DoIOWrite(AContext: ptr; ABuffer: ptr to const char; ALength: int32): int32;
var
  LIO: IO;
begin
  LIO := IO(AContext);
  if IOWriteFull(LIO, ABuffer, int64(ALength)) <> int64(ALength) then
    return -1;
  end;
  return ALength;
end;

// AText as a new NUL-terminated libxml2 text (freed with DoFreeText); nil when there is no room
routine DoNewText(const AText: string): ptr to xmlChar;
begin
  return ptr to xmlChar(ptr(StringToC(AText)));
end;

// A text DoNewText made, freed (nil is nothing)
routine DoFreeText(const AText: ptr to xmlChar);
begin
  if AText <> nil then
    freemem(ptr(AText));
  end;
end;

// A C text StringToC made, freed (nil is nothing)
routine DoFreeChars(const AText: ptr to char);
begin
  if AText <> nil then
    freemem(ptr(AText));
  end;
end;

// libxml2's format flag: 1 (indented) when APretty, else 0
routine DoFormat(const APretty: bool): int32;
begin
  if APretty then
    return 1;
  end;
  return 0;
end;

// Whether AEncoding names UTF-8 (libxml2 writes it with no encoder)
routine DoIsUtf8(const AEncoding: string): bool;
var
  LName: string;
begin
  LName := UpperCase(AEncoding);
  return (LName = ADAM_XML_UTF8) or (LName = "UTF8");
end;

// AName split at its first ':' into APrefix and ALocal (APrefix "" when it has none)
routine DoSplitName(const AName: string; var APrefix: string; var ALocal: string);
var
  LAt: int64;
begin
  LAt := IndexOf(":", AName, 0);
  if LAt < 0 then
    APrefix := "";
    ALocal := AName;
  else
    APrefix := Substring(AName, 0, LAt);
    ALocal := Substring(AName, LAt + 1, len(AName) - LAt - 1);
  end;
end;

// Whether AText is an XML name with no ':' (an NCName: a prefix or a local name)
routine DoIsNCName(const AText: string): bool;
var
  LText: ptr to xmlChar;
  LOk: bool;
begin
  if len(AText) = 0 then
    return false;
  end;
  LText := DoNewText(AText);
  LOk := (LText <> nil) and (xmlValidateNCName(LText, 0) = 0);
  DoFreeText(LText);
  return LOk;
end;

// The namespace APrefix names in scope at ANode in ADoc ("" the default one); nil when none
routine DoFindNamespace(const ADoc: ptr to xmlDoc; const ANode: ptr to xmlNode;
  const APrefix: string): ptr to xmlNs;
var
  LPrefix: ptr to xmlChar;
  LNs: ptr to xmlNs;
begin
  if len(APrefix) = 0 then
    return xmlSearchNs(ADoc, ANode, nil);
  end;
  LPrefix := DoNewText(APrefix);
  LNs := xmlSearchNs(ADoc, ANode, LPrefix);
  DoFreeText(LPrefix);
  return LNs;
end;

// AName ("local" or "prefix:local") as a name at ANode: its local part into ALocal, its
// namespace into ANs (a prefix's as declared at ANode or above; with none, the default one
// in scope for an element, none for an attribute); false when a part is no XML name or the
// prefix is not declared
routine DoResolveName(const ADoc: ptr to xmlDoc; const ANode: ptr to xmlNode; const AName: string;
  const AIsElement: bool; var ALocal: string; var ANs: ptr to xmlNs): bool;
var
  LPrefix: string;
begin
  ANs := nil;
  DoSplitName(AName, LPrefix, ALocal);
  if not DoIsNCName(ALocal) then
    return false;
  end;
  if len(LPrefix) = 0 then
    if AIsElement then
      ANs := DoFindNamespace(ADoc, ANode, "");
    end;
    return true;
  end;
  if not DoIsNCName(LPrefix) then
    return false;
  end;
  ANs := DoFindNamespace(ADoc, ANode, LPrefix);
  return ANs <> nil;
end;

// One parsed document, shared by every Xml viewing it
type
  XmlTree = object
    Doc: ptr to xmlDoc;
    // The nodes taken out of the document (Remove, SetText), kept until it goes so no view
    // of one dangles
    Detached: array of ptr to xmlNode;

    // ANode unlinked from where it is, kept in Detached
    method Detach(const ANode: ptr to xmlNode);
    begin
      xmlUnlinkNode(ANode);
      setlength(self.Detached, len(self.Detached) + 1);
      self.Detached[len(self.Detached) - 1] := ANode;
    end;

    // The detached nodes freed (before the document: their names may be its dictionary's)
    method FreeDetached();
    var
      LI: int64;
    begin
      for LI := 0 to len(self.Detached) - 1 do
        xmlFreeNode(self.Detached[LI]);
      end;
      setlength(self.Detached, 0);
    end;

    done;
    begin
      self.FreeDetached();
      if self.Doc <> nil then
        xmlFreeDoc(self.Doc);
      end;
    end;
  end;

public forward type Xml;
public forward type XmlAttribute;

public type
  // What a node is
  XmlKind = choices(Missing, Element, Text, CData, Comment, Instruction, EntityReference,
    Document, Other);

  // An XML node: a view of one node of a shared parsed document (see the header)
  Xml = object
    // The document (nil for a missing value)
    hidden Tree: ref XmlTree;
    // The node viewed (nil: a missing value)
    hidden Node: ptr to xmlNode;
    // Why the last Parse / LoadFromFile / LoadFromIO failed ("" after a success)
    hidden Error: string;

    // A view of ANode in this document; a missing value for nil
    hidden const method DoView(const ANode: ptr to xmlNode): Xml;
    var
      LView: Xml;
    begin
      if ANode = nil then
        return LView;
      end;
      LView.Tree := self.Tree;
      LView.Node := ANode;
      return LView;
    end;

    // This value made a missing one carrying AError
    hidden method DoFail(const AError: string);
    begin
      self.Tree := nil;
      self.Node := nil;
      self.Error := AError;
    end;

    // The document ADoc this value's from now on, viewing its root element; false (ADoc
    // freed) when it has none
    hidden method DoTake(const ADoc: ptr to xmlDoc; const AName: string): bool;
    var
      LTree: ref XmlTree;
      LRoot: ptr to xmlNode;
    begin
      LTree := ref XmlTree();
      LTree.Doc := ADoc;
      LRoot := xmlDocGetRootElement(ADoc);
      if LRoot = nil then
        self.DoFail(AName + ": " + ADAM_XML_MSG_NO_ROOT);
        return false;
      end;
      self.Tree := LTree;
      self.Node := LRoot;
      self.Error := "";
      return true;
    end;

    // -- Reading text, files and IOs (a failure: a missing value, ErrorText set)

    // The XML text AText, this value's document from now on (its root element); false with
    // ErrorText when it is no well-formed XML ("<text>(line,col): message")
    method Parse(const AText: string): bool;
    var
      LState: XmlReadState;
      LContext: ptr to xmlParserCtxt;
      LDoc: ptr to xmlDoc;
    begin
      if len(AText) > ADAM_XML_INT32_MAX then
        self.DoFail(ADAM_XML_TEXT_NAME + ": " + ADAM_XML_MSG_TOO_LARGE);
        return false;
      end;
      LContext := DoNewContext(addr of LState);
      if LContext = nil then
        self.DoFail(ADAM_XML_TEXT_NAME + ": " + ADAM_XML_MSG_NO_ROOM);
        return false;
      end;
      LDoc := xmlCtxtReadMemory(LContext, DoChars(AText), int32(len(AText)), nil, nil,
        ADAM_XML_READ_OPTIONS);
      xmlFreeParserCtxt(LContext);
      if LDoc = nil then
        self.DoFail(DoReadError(ADAM_XML_TEXT_NAME, LState, ADAM_XML_MSG_IO_FAILED));
        return false;
      end;
      return self.DoTake(LDoc, ADAM_XML_TEXT_NAME);
    end;

    // The XML file at APath read through C's file calls (so a HookIO path reads its IO),
    // this value's document from now on; false with ErrorText ("APath(line,col): message",
    // "APath: the file cannot be opened")
    method LoadFromFile(const APath: string): bool;
    var
      LState: XmlReadState;
      LContext: ptr to xmlParserCtxt;
      LPath: ptr to char;
      LDoc: ptr to xmlDoc;
    begin
      LPath := DoFilePath(APath);
      if LPath = nil then
        self.DoFail(APath + ": " + ADAM_XML_MSG_NO_ROOM);
        return false;
      end;
      LContext := DoNewContext(addr of LState);
      if LContext = nil then
        freemem(ptr(LPath));
        self.DoFail(APath + ": " + ADAM_XML_MSG_NO_ROOM);
        return false;
      end;
      LDoc := xmlCtxtReadFile(LContext, ptr to const char(LPath), nil, ADAM_XML_READ_OPTIONS);
      xmlFreeParserCtxt(LContext);
      freemem(ptr(LPath));
      if LDoc = nil then
        self.DoFail(DoReadError(APath, LState, ADAM_XML_MSG_OPEN_FAILED));
        return false;
      end;
      return self.DoTake(LDoc, APath);
    end;

    // The XML text the IO AIO holds from its place to its end, read in pieces through
    // libxml2's IO callbacks, this value's document from now on; false with ErrorText
    // ("<io>(line,col): message"); the IO stays the caller's (not closed)
    method LoadFromIO(const AIO: IO): bool;
    var
      LState: XmlReadState;
      LContext: ptr to xmlParserCtxt;
      LDoc: ptr to xmlDoc;
    begin
      if AIO = nil then
        self.DoFail(ADAM_XML_IO_NAME + ": " + ADAM_XML_MSG_NO_IO);
        return false;
      end;
      LContext := DoNewContext(addr of LState);
      if LContext = nil then
        self.DoFail(ADAM_XML_IO_NAME + ": " + ADAM_XML_MSG_NO_ROOM);
        return false;
      end;
      LDoc := xmlCtxtReadIO(LContext, DoIORead, DoIOClose, ptr(AIO), nil, nil,
        ADAM_XML_READ_OPTIONS);
      xmlFreeParserCtxt(LContext);
      if LDoc = nil then
        self.DoFail(DoReadError(ADAM_XML_IO_NAME, LState, ADAM_XML_MSG_IO_FAILED));
        return false;
      end;
      return self.DoTake(LDoc, ADAM_XML_IO_NAME);
    end;

    // Why the last Parse / LoadFromFile / LoadFromIO (or Xml.From*) failed; "" if it did not
    const method ErrorText(): string;
    begin
      return self.Error;
    end;

    // -- Made from a text, a file or an IO (static: Xml.FromFile(P))

    // The XML text AText's root element (a missing value with its ErrorText when it is no
    // well-formed XML)
    static method FromString(const AText: string): Xml;
    var
      LXml: Xml;
    begin
      LXml.Parse(AText);
      return LXml;
    end;

    // The root element of the XML file at APath, read through C's file calls (a HookIO path
    // reads its IO)
    static method FromFile(const APath: string): Xml;
    var
      LXml: Xml;
    begin
      LXml.LoadFromFile(APath);
      return LXml;
    end;

    // The root element of the XML text the IO AIO holds from its place to its end
    static method FromIO(const AIO: IO): Xml;
    var
      LXml: Xml;
    begin
      LXml.LoadFromIO(AIO);
      return LXml;
    end;

    // The XML text AText's root element into AXml; false when it is no well-formed XML
    // (AXml then the missing value, its ErrorText why)
    static method TryFromString(const AText: string; var AXml: Xml): bool;
    var
      LXml: Xml;
      LOk: bool;
    begin
      LOk := LXml.Parse(AText);
      AXml := LXml;
      return LOk;
    end;

    // -- What the node is

    // Whether this value names no node (a failed read, a walk past the end, a name not found)
    const method IsNull(): bool;
    begin
      return self.Node = nil;
    end;

    // What the node is (XmlKind.Missing for a missing value)
    const method Kind(): XmlKind;
    var
      LType: int32;
    begin
      if self.Node = nil then
        return XmlKind.Missing;
      end;
      LType := self.Node^.type_;
      if LType = XML_ELEMENT_NODE then
        return XmlKind.Element;
      end;
      if LType = XML_TEXT_NODE then
        return XmlKind.Text;
      end;
      if LType = XML_CDATA_SECTION_NODE then
        return XmlKind.CData;
      end;
      if LType = XML_COMMENT_NODE then
        return XmlKind.Comment;
      end;
      if LType = XML_PI_NODE then
        return XmlKind.Instruction;
      end;
      if LType = XML_ENTITY_REF_NODE then
        return XmlKind.EntityReference;
      end;
      if (LType = XML_DOCUMENT_NODE) or (LType = XML_HTML_DOCUMENT_NODE) then
        return XmlKind.Document;
      end;
      return XmlKind.Other;
    end;

    // Whether the node is an element
    const method IsElement(): bool;
    begin
      return DoIsElement(self.Node);
    end;

    // An element's name as written (prefix:local), a processing instruction's target; ""
    // for any other node
    const method Name(): string;
    begin
      return DoName(self.Node);
    end;

    // An element's name without its prefix; "" for any other node
    const method LocalName(): string;
    begin
      if not DoIsElement(self.Node) then
        return "";
      end;
      return DoText(self.Node^.name);
    end;

    // An element's namespace prefix; "" when it has none
    const method Prefix(): string;
    begin
      if (not DoIsElement(self.Node)) or (self.Node^.ns = nil) then
        return "";
      end;
      return DoText(self.Node^.ns^.prefix);
    end;

    // An element's namespace URI; "" when it is in no namespace
    const method NamespaceUri(): string;
    begin
      if (not DoIsElement(self.Node)) or (self.Node^.ns = nil) then
        return "";
      end;
      return DoText(self.Node^.ns^.href);
    end;

    // The line the node starts on in its source (0 for a missing value)
    const method Line(): int64;
    begin
      if self.Node = nil then
        return 0;
      end;
      return int64(xmlGetLineNo(self.Node));
    end;

    // -- Text

    // The node's own text: an element's text and CDATA children joined (not its
    // descendants'), a text / CDATA / comment / processing instruction node's content
    const method Text(): string;
    var
      LResult: string;
      LChild: ptr to xmlNode;
    begin
      if self.Node = nil then
        return "";
      end;
      if self.Node^.type_ <> XML_ELEMENT_NODE then
        return DoText(self.Node^.content);
      end;
      LResult := "";
      LChild := self.Node^.children;
      while LChild <> nil do
        if (LChild^.type_ = XML_TEXT_NODE) or (LChild^.type_ = XML_CDATA_SECTION_NODE) then
          LResult := LResult + DoText(LChild^.content);
        end;
        LChild := LChild^.next;
      end;
      return LResult;
    end;

    // All the text in and below the node, in document order (entity references expanded)
    const method InnerText(): string;
    begin
      if self.Node = nil then
        return "";
      end;
      return DoTakeText(xmlNodeGetContent(self.Node));
    end;

    // -- Attributes ("local", or "prefix:local" for a namespaced one)

    // Whether the element has the attribute AName
    const method Has(const AName: string): bool;
    begin
      return DoFindAttribute(self.Node, AName) <> nil;
    end;

    // The attribute AName's value; "" when there is none
    const method Get(const AName: string): string;
    begin
      return self.Get(AName, "");
    end;

    // The attribute AName's value; ADefault when there is none
    const method Get(const AName: string; const ADefault: string): string;
    var
      LValue: string;
    begin
      if not self.TryGet(AName, LValue) then
        return ADefault;
      end;
      return LValue;
    end;

    // The attribute AName as an int32; ADefault when there is none or it is no int32
    const method Get(const AName: string; const ADefault: int32): int32;
    var
      LValue: int32;
    begin
      if not self.TryGet(AName, LValue) then
        return ADefault;
      end;
      return LValue;
    end;

    // The attribute AName as an int64; ADefault when there is none or it is no int64
    const method Get(const AName: string; const ADefault: int64): int64;
    var
      LValue: int64;
    begin
      if not self.TryGet(AName, LValue) then
        return ADefault;
      end;
      return LValue;
    end;

    // The attribute AName as a float64; ADefault when there is none or it is no number
    const method Get(const AName: string; const ADefault: float64): float64;
    var
      LValue: float64;
    begin
      if not self.TryGet(AName, LValue) then
        return ADefault;
      end;
      return LValue;
    end;

    // The attribute AName as a bool (true / 1, false / 0, as XML Schema's boolean); ADefault
    // when there is none or it is neither
    const method Get(const AName: string; const ADefault: bool): bool;
    var
      LValue: bool;
    begin
      if not self.TryGet(AName, LValue) then
        return ADefault;
      end;
      return LValue;
    end;

    // The attribute AName's value into AValue; false when there is none (AValue unchanged)
    const method TryGet(const AName: string; var AValue: string): bool;
    var
      LAttr: ptr to xmlAttr;
    begin
      LAttr := DoFindAttribute(self.Node, AName);
      if LAttr = nil then
        return false;
      end;
      AValue := DoAttributeValue(LAttr);
      return true;
    end;

    // The attribute AName as an int64 into AValue (spaces around it allowed); false when
    // there is none or it is no whole number (AValue unchanged)
    const method TryGet(const AName: string; var AValue: int64): bool;
    var
      LText: string;
      LValue: int64;
    begin
      if not self.TryGet(AName, LText) then
        return false;
      end;
      if not TryStrToInt(Trim(LText), LValue) then
        return false;
      end;
      AValue := LValue;
      return true;
    end;

    // The attribute AName as an int32 into AValue; false when there is none or it is no
    // whole number in int32's range (AValue unchanged)
    const method TryGet(const AName: string; var AValue: int32): bool;
    var
      LValue: int64;
    begin
      if not self.TryGet(AName, LValue) then
        return false;
      end;
      if (LValue < ADAM_XML_INT32_MIN) or (LValue > ADAM_XML_INT32_MAX) then
        return false;
      end;
      AValue := int32(LValue);
      return true;
    end;

    // The attribute AName as a float64 into AValue; false when there is none or it is no
    // number (AValue unchanged)
    const method TryGet(const AName: string; var AValue: float64): bool;
    var
      LText: string;
      LValue: float64;
    begin
      if not self.TryGet(AName, LText) then
        return false;
      end;
      if not TryStrToFloat(Trim(LText), LValue) then
        return false;
      end;
      AValue := LValue;
      return true;
    end;

    // The attribute AName as a bool into AValue (true / 1, false / 0); false when there is
    // none or it is neither (AValue unchanged)
    const method TryGet(const AName: string; var AValue: bool): bool;
    var
      LText: string;
    begin
      if not self.TryGet(AName, LText) then
        return false;
      end;
      LText := Trim(LText);
      if (LText = "true") or (LText = "1") then
        AValue := true;
        return true;
      end;
      if (LText = "false") or (LText = "0") then
        AValue := false;
        return true;
      end;
      return false;
    end;

    // How many attributes the element has (0 for any other node)
    const method AttributeCount(): int64;
    var
      LCount: int64;
      LAttr: ptr to xmlAttr;
    begin
      LCount := 0;
      if DoIsElement(self.Node) then
        LAttr := self.Node^.properties;
        while LAttr <> nil do
          LCount := LCount + 1;
          LAttr := LAttr^.next;
        end;
      end;
      return LCount;
    end;

    // The element's attribute names as written, in document order
    const method AttributeNames(): StringArray;
    var
      LNames: StringArray;
      LAttr: ptr to xmlAttr;
      LAt: int64;
    begin
      setlength(LNames, self.AttributeCount());
      if len(LNames) = 0 then
        return LNames;
      end;
      LAt := 0;
      LAttr := self.Node^.properties;
      while LAttr <> nil do
        LNames[LAt] := DoQualified(LAttr^.ns, LAttr^.name);
        LAt := LAt + 1;
        LAttr := LAttr^.next;
      end;
      return LNames;
    end;

    // The element's attributes (name as written and value), in document order
    const method Attributes(): sequence of XmlAttribute;
    var
      LAttr: ptr to xmlAttr;
      LItem: XmlAttribute;
    begin
      if not DoIsElement(self.Node) then
        return;
      end;
      LAttr := self.Node^.properties;
      while LAttr <> nil do
        LItem.Name := DoQualified(LAttr^.ns, LAttr^.name);
        LItem.Value := DoAttributeValue(LAttr);
        yield LItem;
        LAttr := LAttr^.next;
      end;
    end;

    // -- Walking

    // The node's parent (the root element's is the document node); missing for the document
    const method Parent(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(self.Node^.parent_);
    end;

    // The next sibling node; missing for the last
    const method Next(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(self.Node^.next);
    end;

    // The previous sibling node; missing for the first
    const method Previous(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(self.Node^.prev);
    end;

    // The next sibling element; missing when there is none
    const method NextElement(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(xmlNextElementSibling(self.Node));
    end;

    // The previous sibling element; missing when there is none
    const method PreviousElement(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(xmlPreviousElementSibling(self.Node));
    end;

    // The first child node; missing when there is none
    const method FirstChild(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(self.Node^.children);
    end;

    // The first child element; missing when there is none
    const method FirstElement(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(xmlFirstElementChild(self.Node));
    end;

    // The last child element; missing when there is none
    const method LastElement(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(xmlLastElementChild(self.Node));
    end;

    // The document's root element, from any node of it
    const method Root(): Xml;
    begin
      if self.Tree = nil then
        return self.DoView(nil);
      end;
      return self.DoView(xmlDocGetRootElement(self.Tree.Doc));
    end;

    // How many child nodes the node has
    const method ChildCount(): int64;
    var
      LCount: int64;
      LChild: ptr to xmlNode;
    begin
      LCount := 0;
      if self.Node <> nil then
        LChild := self.Node^.children;
        while LChild <> nil do
          LCount := LCount + 1;
          LChild := LChild^.next;
        end;
      end;
      return LCount;
    end;

    // How many child elements the node has
    const method ElementCount(): int64;
    begin
      if self.Node = nil then
        return 0;
      end;
      return int64(xmlChildElementCount(self.Node));
    end;

    // The first child element named AName (prefix:local as written); missing when none is
    const method FindChild(const AName: string): Xml;
    var
      LChild: ptr to xmlNode;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      LChild := self.Node^.children;
      while LChild <> nil do
        if DoIsNamed(LChild, AName) then
          return self.DoView(LChild);
        end;
        LChild := LChild^.next;
      end;
      return self.DoView(nil);
    end;

    // Every child node, in document order
    const method Children(): sequence of Xml;
    var
      LChild: ptr to xmlNode;
    begin
      if self.Node = nil then
        return;
      end;
      LChild := self.Node^.children;
      while LChild <> nil do
        yield self.DoView(LChild);
        LChild := LChild^.next;
      end;
    end;

    // Every child element, in document order
    const method Elements(): sequence of Xml;
    var
      LChild: ptr to xmlNode;
    begin
      if self.Node = nil then
        return;
      end;
      LChild := self.Node^.children;
      while LChild <> nil do
        if DoIsElement(LChild) then
          yield self.DoView(LChild);
        end;
        LChild := LChild^.next;
      end;
    end;

    // Every child element named AName (prefix:local as written), in document order
    const method Elements(const AName: string): sequence of Xml;
    var
      LChild: ptr to xmlNode;
    begin
      if self.Node = nil then
        return;
      end;
      LChild := self.Node^.children;
      while LChild <> nil do
        if DoIsNamed(LChild, AName) then
          yield self.DoView(LChild);
        end;
        LChild := LChild^.next;
      end;
    end;

    // Every element below the node named AName (prefix:local as written), the node itself
    // not included, in document order
    const method FindAll(const AName: string): sequence of Xml;
    var
      LNode: ptr to xmlNode;
      LClimbing: bool;
    begin
      if self.Node = nil then
        return;
      end;
      // A walk without recursion: down into an element's children, else on to the next
      // sibling, climbing back up while a level is done; only elements are entered (an
      // entity reference's children are its declaration's, not this tree's)
      LNode := self.Node^.children;
      while LNode <> nil do
        if DoIsNamed(LNode, AName) then
          yield self.DoView(LNode);
        end;
        if DoIsElement(LNode) and (LNode^.children <> nil) then
          LNode := LNode^.children;
        else
          LClimbing := true;
          while LClimbing do
            if LNode^.next <> nil then
              LNode := LNode^.next;
              LClimbing := false;
            else
              LNode := LNode^.parent_;
              if LNode = self.Node then
                return;
              end;
            end;
          end;
        end;
      end;
    end;

    // -- Building (a change returns the value it was called on, so calls chain; one that
    //    does not fit changes nothing)

    // This element's new last child ANode (nil: nothing); freed when libxml2 refuses it
    hidden method DoAppend(const ANode: ptr to xmlNode);
    begin
      if ANode = nil then
        return;
      end;
      if xmlAddChild(self.Node, ANode) = nil then
        xmlFreeNode(ANode);
      end;
    end;

    /// A new document whose root element is AName, in no namespace.
    /// @param AName the root element's name ("local"; a "prefix:local" one needs the
    ///   namespace URI form)
    /// @returns the root element; a missing value with its ErrorText when AName is no XML
    ///   name
    /// @example `LConfig := Xml.New("config").SetAttribute("version", 2);`
    /// @see Xml.SaveToFile
    static method New(const AName: string): Xml;
    begin
      return Xml.New(AName, "");
    end;

    /// A new document whose root element AName is in the namespace ANamespaceUri: a
    /// "prefix:local" name declares the prefix for it, a bare "local" makes it the default
    /// namespace (inherited by the unprefixed elements added below).
    /// @param AName the root element's name, "local" or "prefix:local"
    /// @param ANamespaceUri the namespace URI ("" for none, then AName takes no prefix)
    /// @returns the root element; a missing value with its ErrorText ("<new>: ...") when
    ///   AName is no XML name or names a prefix with no URI
    /// @example `LSvg := Xml.New("svg", "http://www.w3.org/2000/svg");`
    static method New(const AName: string; const ANamespaceUri: string): Xml;
    var
      LXml: Xml;
      LPrefix: string;
      LLocal: string;
      LDoc: ptr to xmlDoc;
      LRoot: ptr to xmlNode;
      LText: ptr to xmlChar;
      LUri: ptr to xmlChar;
    begin
      DoSplitName(AName, LPrefix, LLocal);
      if (not DoIsNCName(LLocal)) or ((len(LPrefix) > 0) and (not DoIsNCName(LPrefix))) then
        LXml.DoFail(ADAM_XML_NEW_NAME + ": " + ADAM_XML_MSG_BAD_NAME + AName);
        return LXml;
      end;
      if (len(LPrefix) > 0) and (len(ANamespaceUri) = 0) then
        LXml.DoFail(ADAM_XML_NEW_NAME + ": " + ADAM_XML_MSG_NO_NAMESPACE + LPrefix);
        return LXml;
      end;
      LDoc := xmlNewDoc(ADAM_XML_VERSION);
      if LDoc = nil then
        LXml.DoFail(ADAM_XML_NEW_NAME + ": " + ADAM_XML_MSG_NO_ROOM);
        return LXml;
      end;
      LText := DoNewText(LLocal);
      LRoot := xmlNewDocNode(LDoc, nil, LText, nil);
      DoFreeText(LText);
      if LRoot = nil then
        xmlFreeDoc(LDoc);
        LXml.DoFail(ADAM_XML_NEW_NAME + ": " + ADAM_XML_MSG_NO_ROOM);
        return LXml;
      end;
      xmlDocSetRootElement(LDoc, LRoot);
      if len(ANamespaceUri) > 0 then
        LUri := DoNewText(ANamespaceUri);
        LText := nil;
        if len(LPrefix) > 0 then
          LText := DoNewText(LPrefix);
        end;
        xmlSetNs(LRoot, xmlNewNs(LRoot, LUri, LText));
        DoFreeText(LText);
        DoFreeText(LUri);
      end;
      LXml.DoTake(LDoc, ADAM_XML_NEW_NAME);
      return LXml;
    end;

    /// Declares the namespace ANamespaceUri on this element under APrefix, for it and
    /// everything below to name by "prefix:local"; APrefix "" declares the default
    /// namespace, which this element (when unprefixed and in none) and the unprefixed
    /// elements added below then are in.
    /// @param APrefix the prefix ("" for the default namespace)
    /// @param ANamespaceUri the namespace URI
    /// @returns this value; nothing changes when it is no element, APrefix is no XML name
    ///   or already declared here, or ANamespaceUri is ""
    /// @example `LRoot.DeclareNamespace("xlink", "http://www.w3.org/1999/xlink");`
    method DeclareNamespace(const APrefix: string; const ANamespaceUri: string): Xml;
    var
      LUri: ptr to xmlChar;
      LPrefix: ptr to xmlChar;
      LNs: ptr to xmlNs;
    begin
      if DoIsElement(self.Node) and (len(ANamespaceUri) > 0) and
        ((len(APrefix) = 0) or DoIsNCName(APrefix)) then
        LUri := DoNewText(ANamespaceUri);
        LPrefix := nil;
        if len(APrefix) > 0 then
          LPrefix := DoNewText(APrefix);
        end;
        LNs := xmlNewNs(self.Node, LUri, LPrefix);
        DoFreeText(LPrefix);
        DoFreeText(LUri);
        // An unprefixed element in no namespace is in the default one declared on it
        if (LNs <> nil) and (len(APrefix) = 0) and (self.Node^.ns = nil) then
          xmlSetNs(self.Node, LNs);
        end;
      end;
      return self;
    end;

    /// Appends a new element AName as this element's last child.
    /// @param AName "local" (in the default namespace in scope) or "prefix:local" (a prefix
    ///   declared here or above)
    /// @returns the new element; a missing value when this is no element, AName is no XML
    ///   name or its prefix is not declared
    /// @example `LItem := LList.AddElement("item").SetAttribute("id", 1);`
    method AddElement(const AName: string): Xml;
    var
      LLocal: string;
      LNs: ptr to xmlNs;
      LText: ptr to xmlChar;
      LNode: ptr to xmlNode;
    begin
      if not DoIsElement(self.Node) then
        return self.DoView(nil);
      end;
      if not DoResolveName(self.Tree.Doc, self.Node, AName, true, LLocal, LNs) then
        return self.DoView(nil);
      end;
      LText := DoNewText(LLocal);
      LNode := xmlNewChild(self.Node, LNs, LText, nil);
      DoFreeText(LText);
      return self.DoView(LNode);
    end;

    /// Appends a new element AName holding the text AText as this element's last child.
    /// @param AName as AddElement takes it
    /// @param AText the new element's text (written escaped)
    /// @returns the new element (a missing value as AddElement's)
    /// @example `LBook.AddElement("title", "Dune");`
    method AddElement(const AName: string; const AText: string): Xml;
    var
      LChild: Xml;
    begin
      LChild := self.AddElement(AName);
      LChild.AddText(AText);
      return LChild;
    end;

    /// Appends the text AText to this element (beside a text before it, it joins it).
    /// @param AText the text, as is (written escaped: & < > as entities)
    /// @returns this value; nothing changes when it is no element or AText is ""
    /// @example `LNote.AddText("a & b");`
    method AddText(const AText: string): Xml;
    begin
      if DoIsElement(self.Node) and (len(AText) > 0) and (len(AText) <= ADAM_XML_INT32_MAX) then
        self.DoAppend(xmlNewDocTextLen(self.Tree.Doc, ptr to const xmlChar(DoChars(AText)),
          int32(len(AText))));
      end;
      return self;
    end;

    /// Replaces this element's children with the one text AText (none for "").
    /// @param AText the new text (written escaped)
    /// @returns this value; nothing changes when it is no element
    /// @example `LTitle.SetText("Dune Messiah");`
    method SetText(const AText: string): Xml;
    begin
      if not DoIsElement(self.Node) then
        return self;
      end;
      // The children are detached, not freed: a view of one stays good
      while self.Node^.children <> nil do
        self.Tree.Detach(self.Node^.children);
      end;
      return self.AddText(AText);
    end;

    /// Appends the comment AText (written <!--AText-->) to this element.
    /// @param AText the comment's text
    /// @returns this value; nothing changes when it is no element or AText holds "--" or
    ///   ends in "-" (no well-formed comment can)
    /// @example `LRoot.AddComment(" generated ");`
    method AddComment(const AText: string): Xml;
    var
      LText: ptr to xmlChar;
    begin
      if DoIsElement(self.Node) and (IndexOf(ADAM_XML_COMMENT_END, AText, 0) < 0) and
        ((len(AText) = 0) or (AText[len(AText) - 1] <> '-')) then
        LText := DoNewText(AText);
        if LText <> nil then
          self.DoAppend(xmlNewDocComment(self.Tree.Doc, LText));
          DoFreeText(LText);
        end;
      end;
      return self;
    end;

    /// Appends the CDATA section AText (written <![CDATA[AText]]>, its text as is) to this
    /// element.
    /// @param AText the section's text
    /// @returns this value; nothing changes when it is no element or AText holds "]]>"
    /// @example `LScript.AddCData("if (a < b) run();");`
    method AddCData(const AText: string): Xml;
    begin
      if DoIsElement(self.Node) and (IndexOf(ADAM_XML_CDATA_END, AText, 0) < 0) and
        (len(AText) <= ADAM_XML_INT32_MAX) then
        self.DoAppend(xmlNewCDataBlock(self.Tree.Doc, ptr to const xmlChar(DoChars(AText)),
          int32(len(AText))));
      end;
      return self;
    end;

    /// Sets the attribute AName of this element to AValue (added, or its value replaced).
    /// @param AName "local" (in no namespace) or "prefix:local" (a prefix declared here or
    ///   above); "xmlns" is DeclareNamespace's
    /// @param AValue the value (written escaped)
    /// @returns this value; nothing changes when it is no element, AName is no XML name or
    ///   its prefix is not declared
    /// @example `LItem.SetAttribute("name", "Ada").SetAttribute("age", 36);`
    method SetAttribute(const AName: string; const AValue: string): Xml;
    var
      LLocal: string;
      LNs: ptr to xmlNs;
      LName: ptr to xmlChar;
      LValue: ptr to xmlChar;
    begin
      if (not DoIsElement(self.Node)) or (AName = ADAM_XML_XMLNS) then
        return self;
      end;
      if not DoResolveName(self.Tree.Doc, self.Node, AName, false, LLocal, LNs) then
        return self;
      end;
      LName := DoNewText(LLocal);
      LValue := DoNewText(AValue);
      if (LName <> nil) and (LValue <> nil) then
        xmlSetNsProp(self.Node, LNs, LName, LValue);
      end;
      DoFreeText(LValue);
      DoFreeText(LName);
      return self;
    end;

    /// Sets the attribute AName to the whole number AValue.
    /// @param AName as the string form takes it
    /// @param AValue the value
    /// @returns this value (unchanged as the string form's)
    /// @example `LMap.SetAttribute("width", int32(30));`
    method SetAttribute(const AName: string; const AValue: int32): Xml;
    begin
      return self.SetAttribute(AName, IntToStr(int64(AValue)));
    end;

    /// Sets the attribute AName to the whole number AValue.
    /// @param AName as the string form takes it
    /// @param AValue the value
    /// @returns this value (unchanged as the string form's)
    /// @example `LFile.SetAttribute("size", LSize);`
    method SetAttribute(const AName: string; const AValue: int64): Xml;
    begin
      return self.SetAttribute(AName, IntToStr(AValue));
    end;

    /// Sets the attribute AName to the number AValue.
    /// @param AName as the string form takes it
    /// @param AValue the value
    /// @returns this value (unchanged as the string form's)
    /// @example `LSound.SetAttribute("volume", 0.8);`
    method SetAttribute(const AName: string; const AValue: float64): Xml;
    begin
      return self.SetAttribute(AName, FloatToStr(AValue));
    end;

    /// Sets the attribute AName to AValue as "true" / "false".
    /// @param AName as the string form takes it
    /// @param AValue the value
    /// @returns this value (unchanged as the string form's)
    /// @example `LWindow.SetAttribute("fullscreen", false);`
    method SetAttribute(const AName: string; const AValue: bool): Xml;
    begin
      if AValue then
        return self.SetAttribute(AName, ADAM_XML_TRUE);
      end;
      return self.SetAttribute(AName, ADAM_XML_FALSE);
    end;

    /// Removes the attribute AName from this element.
    /// @param AName "local" or "prefix:local", as Get takes it
    /// @returns false when it has no such attribute
    /// @example `LItem.RemoveAttribute("draft");`
    method RemoveAttribute(const AName: string): bool;
    var
      LAttr: ptr to xmlAttr;
    begin
      LAttr := DoFindAttribute(self.Node, AName);
      if LAttr = nil then
        return false;
      end;
      return xmlRemoveProp(LAttr) = 0;
    end;

    /// Takes this node out of its document (with everything below it). The node is kept
    /// until the document goes, so this value and every other view of it stay readable.
    /// @returns false for a missing value or a node already taken out
    /// @example `LMap.FindChild("debug").Remove();`
    method Remove(): bool;
    begin
      if (self.Node = nil) or (self.Node^.parent_ = nil) then
        return false;
      end;
      self.Tree.Detach(self.Node);
      return true;
    end;

    // -- Writing

    // The node's markup, indented when APretty; "" for a missing value
    hidden const method DoDump(const APretty: bool): string;
    var
      LBuffer: ptr to xmlBuffer;
      LLength: int32;
      LResult: string;
    begin
      if self.Node = nil then
        return "";
      end;
      LBuffer := xmlBufferCreate();
      if LBuffer = nil then
        return "";
      end;
      xmlNodeDump(LBuffer, self.Tree.Doc, self.Node, 0, DoFormat(APretty));
      LLength := xmlBufferLength(LBuffer);
      LResult := "";
      if LLength > 0 then
        LResult := StringFromC(ptr to const char(xmlBufferContent(LBuffer)), int64(LLength));
      end;
      xmlBufferFree(LBuffer);
      return LResult;
    end;

    /// The node's own markup, compact (no XML declaration; an element with everything
    /// below it).
    /// @returns the markup; "" for a missing value
    /// @example `println(LItem.ToString());`
    const method ToString(): string;
    begin
      return self.DoDump(false);
    end;

    /// The node's own markup, an element per line, 2 spaces a level (an element holding
    /// text stays on its line).
    /// @returns the markup; "" for a missing value
    /// @example `println(LDoc.ToPrettyString());`
    const method ToPrettyString(): string;
    begin
      return self.DoDump(true);
    end;

    /// Writes the whole document this value is in to the file at APath, pretty, in UTF-8,
    /// through C's file calls (a HookIO path writes its IO).
    /// @param APath the file (an Adam $ path resolved, any other as written)
    /// @returns false for a missing value or when it cannot be written
    /// @example `LConfig.SaveToFile("$D:config.xml");`
    const method SaveToFile(const APath: string): bool;
    begin
      return self.SaveToFile(APath, true, ADAM_XML_UTF8);
    end;

    /// SaveToFile, pretty when APretty, else compact.
    /// @param APath the file
    /// @param APretty whether a line per element
    /// @returns false for a missing value or when it cannot be written
    /// @example `LDoc.SaveToFile("out.xml", false);`
    const method SaveToFile(const APath: string; const APretty: bool): bool;
    begin
      return self.SaveToFile(APath, APretty, ADAM_XML_UTF8);
    end;

    /// SaveToFile in the encoding AEncoding (declared in the XML declaration).
    /// @param APath the file
    /// @param APretty whether a line per element
    /// @param AEncoding libxml2's name for it ("UTF-8", "UTF-16", "ISO-8859-1" ...)
    /// @returns false for a missing value, an encoding libxml2 lacks, or when it cannot be
    ///   written
    /// @example `LDoc.SaveToFile("latin1.xml", true, "ISO-8859-1");`
    const method SaveToFile(const APath: string; const APretty: bool; const AEncoding: string): bool;
    var
      LPath: ptr to char;
      LEncoding: ptr to char;
      LOk: bool;
    begin
      if self.Tree = nil then
        return false;
      end;
      LPath := DoFilePath(APath);
      LEncoding := StringToC(AEncoding);
      LOk := (LPath <> nil) and (LEncoding <> nil) and
        (xmlSaveFormatFileEnc(LPath, self.Tree.Doc, LEncoding, DoFormat(APretty)) >= 0);
      DoFreeChars(LEncoding);
      DoFreeChars(LPath);
      return LOk;
    end;

    /// Writes the whole document this value is in to the IO AIO at its place, pretty, in
    /// UTF-8, through libxml2's IO callbacks (no copy in a string).
    /// @param AIO the IO written (it stays the caller's, open)
    /// @returns false for a missing value or when not all of it could be written
    /// @example `LDoc.SaveToIO(LMemory);`
    const method SaveToIO(const AIO: IO): bool;
    begin
      return self.SaveToIO(AIO, true, ADAM_XML_UTF8);
    end;

    /// SaveToIO, pretty when APretty, else compact.
    /// @param AIO the IO written
    /// @param APretty whether a line per element
    /// @returns false for a missing value or when not all of it could be written
    /// @example `LDoc.SaveToIO(LMemory, false);`
    const method SaveToIO(const AIO: IO; const APretty: bool): bool;
    begin
      return self.SaveToIO(AIO, APretty, ADAM_XML_UTF8);
    end;

    /// SaveToIO in the encoding AEncoding (declared in the XML declaration).
    /// @param AIO the IO written
    /// @param APretty whether a line per element
    /// @param AEncoding libxml2's name for it ("UTF-8", "UTF-16", "ISO-8859-1" ...)
    /// @returns false for a missing value, an encoding libxml2 lacks, or when not all of it
    ///   could be written
    /// @example `LDoc.SaveToIO(LMemory, true, "ISO-8859-1");`
    const method SaveToIO(const AIO: IO; const APretty: bool; const AEncoding: string): bool;
    var
      LEncoding: ptr to char;
      LEncoder: ptr to xmlCharEncodingHandler;
      LBuffer: ptr to xmlOutputBuffer;
      LOk: bool;
    begin
      if (self.Tree = nil) or (AIO = nil) then
        return false;
      end;
      LEncoding := StringToC(AEncoding);
      if LEncoding = nil then
        return false;
      end;
      LEncoder := nil;
      if not DoIsUtf8(AEncoding) then
        LEncoder := xmlFindCharEncodingHandler(LEncoding);
        if LEncoder = nil then
          DoFreeChars(LEncoding);
          return false;
        end;
      end;
      // The buffer owns the encoder; saving closes the buffer (the IO stays open)
      LBuffer := xmlOutputBufferCreateIO(DoIOWrite, DoIOClose, ptr(AIO), LEncoder);
      LOk := (LBuffer <> nil) and
        (xmlSaveFormatFileTo(LBuffer, self.Tree.Doc, LEncoding, DoFormat(APretty)) >= 0);
      DoFreeChars(LEncoding);
      return LOk;
    end;
  end;

  // An attribute as Attributes gives it: its name as written and its value
  XmlAttribute = object
    Name: string;
    Value: string;
  end;

initialize
begin
  // Every libxml2 block on Adam's heap, set before libxml2 allocates anything
  xmlMemSetup(DoFree, DoMalloc, DoRealloc, DoStrdup);
  xmlInitParser();
end;

finalize
begin
  xmlCleanupParser();
end;

end.
