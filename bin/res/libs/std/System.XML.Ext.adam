  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.XML.Ext.adam - XML documents in Adam, over libxml2's C API
  (System.XML.C), as easy to use as System.JSON. An Xml is a value: a view
  of one node of a parsed document that every view of it shares (held by a
  ref, so the document lives while any view does; a view costs no copy). A
  view that names nothing is a missing value: IsNull, every text "", every
  Get its default, every walk empty.

  Read: Xml.FromString / Xml.FromFile / Xml.FromIO (static) give the
  document's root element (a missing value with its ErrorText on a failure);
  Xml.TryFromString is false on a failure; Parse / LoadFromFile /
  LoadFromIO do the same into an existing value. ErrorText is
  "name(line,col): message" (name: "<text>", the path, or "<io>"),
  "name(line): message" when libxml2 gives no column, or "name: message"
  when there is no place. Blank-only text between
  elements is dropped as the document is read; no network is ever used.
  Each read also takes XmlReadOptions: [XmlReadOption.XInclude] replaces
  every XInclude element (xi:include, its xi:fallback when the target
  cannot be read) by what it includes as the document is read, before any
  value views it, the targets read as the document is (so an io:// / zip
  path works); a failed include fails the read, ErrorText naming the
  included document when the error is in it.

  HTML: Xml.FromHtmlString / FromHtmlFile / FromHtmlIO (static) and
  ParseHtml / LoadFromHtmlFile / LoadFromHtmlIO read HTML with libxml2's
  HTML parser (forgiving, as a browser is: only a file or IO that cannot
  be read fails), the root element the html one (implied when missing);
  the whole node API works on it, and ToString / SaveToFile / SaveToIO
  write an HTML document as HTML.

  Walk: Name / LocalName / Prefix / NamespaceUri, Kind / IsElement, Text
  (the node's own text) / InnerText (all text below it), Line; attributes
  by name ("local", or "prefix:local" for a namespaced one): Has, Get (a
  string, or the default's type: int32 / int64 / float64 / bool), TryGet,
  AttributeCount / AttributeNames / Attributes; Children / Elements /
  Elements(name) / FindAll(name) as `for .. in` sequences; Parent / Next /
  Previous / NextElement / PreviousElement / FirstChild / FirstElement /
  LastElement / FindChild / Root, ChildCount / ElementCount.

  Build: Xml.New(name) / Xml.New(name, uri) (static) give a new document's
  root element. AddElement(name) / AddElement(name, text) append a child
  element and give it: "prefix:local" takes a prefix declared on it or an
  ancestor (DeclareNamespace(prefix, uri); "" the default namespace), a
  bare "local" the default namespace in scope. AddText / AddComment /
  AddCData append a node, SetText replaces the children with one text,
  SetAttribute (a string, or an int32 / int64 / float64 / bool) sets one;
  each returns the value it was called on, so calls chain, and a call that
  does not fit (a missing value, a name that is no XML name, a prefix not
  declared, a comment holding "--", a CDATA section holding "]]>")
  changes nothing. RemoveAttribute and Remove take an attribute / a node
  out. A node taken out (Remove, the children SetText replaces) is kept
  until the document goes, so a view of it never dangles.

  Write: ToString (compact) / ToPrettyString (2 spaces a level) give the
  node's own markup; SaveToFile / SaveToIO write the whole document with
  its XML declaration, pretty unless APretty is false, in UTF-8 or the
  encoding named (libxml2's built-in ones: UTF-8, UTF-16, ISO-8859-x,
  ASCII ...), through the same C file calls / IO callbacks reading uses.

  XPath 1.0 (the node a value views is the context node): Select (every
  node found, a `for .. in` sequence), SelectFirst (the first, in document
  order), Evaluate (the result as a string, or the default's type: int32 /
  int64 / float64 / bool; the default when it fails or does not fit). Each
  takes the expression as a string or an XmlPath: XmlPath.Compile compiles
  one once for any number of runs (IsValid / ErrorText say why one does
  not compile: "<xpath>(1,col): message", or why its last run failed:
  "<xpath>: message"), RegisterNamespace binds a prefix (the prefixes
  declared where the context node is are bound too,
  XPath has no default namespace) and SetVariable a $variable. A result
  may hold attributes (XmlKind.Attribute: Name, Text = its value, Parent =
  its element) and namespace nodes (XmlKind.Namespace: Name = the prefix,
  Text = the URI, Parent = the element it is in scope on).

  Validate: XmlSchema.FromFile / FromString / FromIO (static; a DTD, an
  XML Schema or a RelaxNG schema: XmlSchemaKind) compile a schema once for
  any number of documents (IsValid / ErrorText as a read's); Validate()
  checks the document against its own DTD, Validate(schema) against a
  schema; each with an XmlFindings out lists every error and warning
  (XmlFinding: Line, Column, Message, IsWarning) instead of stopping at
  the first.

  The file form goes through libxml2's own C file calls (open / _wopen),
  never System.IO: with System.HookIO imported, an io://<n>/<name> path
  (a registered IO, a .rez / zip entry) or a path a path source holds reads
  as a disk file does. FromIO reads System.CustomIO's IO through libxml2's
  IO callbacks, never a copy of its whole content. Every libxml2 block is
  Adam's heap (xmlMemSetup over getmem / resizemem / freemem), so a debug
  build's heap report covers it; libxml2 never prints: each parse has its
  own error handler. Target-neutral: no OS named.
*******************************************************************************/

module unit System.XML.Ext;

import System.SysUtils, System.IO, System.CustomIO, System.XML.C;

const
  // The errors a failed read reports (after "name(line,col): " / "name: ")
  ADAM_XML_MSG_NO_ROOM: string = "out of memory";
  ADAM_XML_MSG_OPEN_FAILED: string = "the file cannot be opened";
  ADAM_XML_MSG_IO_FAILED: string = "the IO cannot be read";
  ADAM_XML_MSG_NO_IO: string = "no IO";
  ADAM_XML_MSG_TOO_LARGE: string = "the text is too large";
  ADAM_XML_MSG_NO_ROOT: string = "the document has no root element";
  // The name errors carry for a text and for an IO
  ADAM_XML_TEXT_NAME: string = "<text>";
  ADAM_XML_IO_NAME: string = "<io>";
  // How every document is read: no network, blank-only text between elements dropped
  ADAM_XML_READ_OPTIONS: int32 = XML_PARSE_NONET | XML_PARSE_NOBLANKS;
  // How XInclude reads what it includes: as the document, with no XInclude start / end
  // marker nodes left in the tree
  ADAM_XML_XINCLUDE_OPTIONS: int32 = XML_PARSE_NONET | XML_PARSE_NOBLANKS |
    XML_PARSE_NOXINCNODE;
  // How every HTML document is read: no network, blank-only text between elements dropped
  ADAM_XML_HTML_OPTIONS: int32 = HTML_PARSE_NONET | HTML_PARSE_NOBLANKS;
  // The largest text one read takes (libxml2 counts a memory buffer in an int32)
  ADAM_XML_INT32_MAX: int64 = 2147483647;
  ADAM_XML_INT32_MIN: int64 = -2147483648;
  // The errors a failed Xml.New reports (after "<new>: ")
  ADAM_XML_MSG_BAD_NAME: string = "not an XML name: ";
  ADAM_XML_MSG_NO_NAMESPACE: string = "no namespace URI is given for the prefix ";
  // The name a failed Xml.New's error carries
  ADAM_XML_NEW_NAME: string = "<new>";
  // The XML version a new document declares
  ADAM_XML_VERSION: string = "1.0";
  // The encoding a save writes unless another is named
  ADAM_XML_UTF8: string = "UTF-8";
  // An attribute name only DeclareNamespace writes
  ADAM_XML_XMLNS: string = "xmlns";
  // What a comment and a CDATA section must not hold
  ADAM_XML_COMMENT_END: string = "--";
  ADAM_XML_CDATA_END: string = "]]>";
  // A bool attribute as SetAttribute writes it (Get reads true / 1, false / 0)
  ADAM_XML_TRUE: string = "true";
  ADAM_XML_FALSE: string = "false";
  // The first char of an Adam path prefix ($P: $D: $S:): the only paths resolved before a read
  ADAM_XML_PATH_PREFIX: char = '$';
  // The name an XPath error carries, and what it says when libxml2 gave no reason
  ADAM_XML_XPATH_NAME: string = "<xpath>";
  ADAM_XML_MSG_XPATH_FAILED: string = "the XPath expression cannot be evaluated";
  // 2^31 and 2^63, exact in float64: the int32 / int64 ranges an XPath number must fall in
  ADAM_XML_INT32_BOUND: float64 = 2147483648.0;
  ADAM_XML_INT64_BOUND: float64 = 9223372036854775808.0;
  // What a schema that does not compile, and a validation that cannot run, report
  ADAM_XML_MSG_NO_SCHEMA: string = "the schema cannot be compiled";
  ADAM_XML_MSG_SCHEMA_INVALID: string = "the schema did not compile: ";
  ADAM_XML_MSG_NO_DOCUMENT: string = "no document to validate";

type
  // What a parse's error handler keeps: the first error; until one comes, the first warning
  // (libxml2 reports an input it cannot open as a warning)
  XmlReadState = record
    Found: bool;
    IsError: bool;
    Domain: int32;
    Line: int32;
    Column: int32;
    // An XPath error's place in its expression (0-based)
    Offset: int32;
    Message: string;
    // The document the error is in, as libxml2 names it ("" for a text / an IO)
    File: string;
  end;

// -- libxml2's allocator on Adam's heap

routine clink DoMalloc(ASize: uint64): ptr;
begin
  if ASize = 0 then
    return getmem(1);
  end;
  return getmem(int64(ASize));
end;

routine clink DoRealloc(APointer: ptr; ASize: uint64): ptr;
var
  LSize: int64;
begin
  LSize := int64(ASize);
  if LSize = 0 then
    LSize := 1;
  end;
  // C's realloc(NULL, n) is malloc(n)
  if APointer = nil then
    return getmem(LSize);
  end;
  return resizemem(APointer, LSize);
end;

routine clink DoFree(APointer: ptr);
begin
  if APointer <> nil then
    freemem(APointer);
  end;
end;

routine clink DoStrdup(AText: ptr to const char): ptr to char;
begin
  if AText = nil then
    return nil;
  end;
  return StringToC(StringFromC(AText));
end;

// -- Text between libxml2 and Adam

// A libxml2 text as an Adam string ("" for nil)
routine DoText(const AText: ptr to const xmlChar): string;
begin
  if AText = nil then
    return "";
  end;
  return StringFromC(ptr to const char(AText));
end;

// A text libxml2 made for the caller as an Adam string, the block freed ("" for nil)
routine DoTakeText(const AText: ptr to xmlChar): string;
var
  LResult: string;
begin
  if AText = nil then
    return "";
  end;
  LResult := StringFromC(ptr to const char(AText));
  xmlFree(ptr(AText));
  return LResult;
end;

// AText's bytes for a C call that takes them with their count (no NUL needed); "" for none
routine DoChars(const AText: string): ptr to const char;
begin
  if len(AText) = 0 then
    return "";
  end;
  return addr of AText[0];
end;

// APath as the file a C call opens: an Adam path prefix ($P: $D: $S:) resolved, any other
// path as written (a HookIO io:// path, or a plain one a path source may hold by that name;
// the C call takes a relative one from the working folder); nil when there is no room
routine DoFilePath(const APath: string): ptr to char;
begin
  if (len(APath) > 0) and (APath[0] = ADAM_XML_PATH_PREFIX) then
    return StringToC(ResolvePath(APath));
  end;
  return StringToC(APath);
end;

// -- Nodes

// Whether ANode is an element
routine DoIsElement(const ANode: ptr to xmlNode): bool;
begin
  return (ANode <> nil) and (ANode^.type_ = XML_ELEMENT_NODE);
end;

// A namespace's prefix + ":" before ALocal; ALocal alone with no prefix
routine DoQualified(const ANs: ptr to xmlNs; const ALocal: ptr to const xmlChar): string;
begin
  if (ANs <> nil) and (ANs^.prefix <> nil) then
    return DoText(ANs^.prefix) + ":" + DoText(ALocal);
  end;
  return DoText(ALocal);
end;

// Whether ANode is an element or an attribute (an xmlAttr shares xmlNode's fields up to ns)
routine DoIsNamedKind(const ANode: ptr to xmlNode): bool;
begin
  return (ANode <> nil) and ((ANode^.type_ = XML_ELEMENT_NODE) or
    (ANode^.type_ = XML_ATTRIBUTE_NODE));
end;

// An element's or an attribute's name as written (prefix:local), a processing
// instruction's target; "" for any other node
routine DoName(const ANode: ptr to xmlNode): string;
begin
  if ANode = nil then
    return "";
  end;
  if DoIsNamedKind(ANode) then
    return DoQualified(ANode^.ns, ANode^.name);
  end;
  if ANode^.type_ = XML_PI_NODE then
    return DoText(ANode^.name);
  end;
  return "";
end;

// Whether ANode is an element named AName (prefix:local as written)
routine DoIsNamed(const ANode: ptr to xmlNode; const AName: string): bool;
begin
  return DoIsElement(ANode) and (DoName(ANode) = AName);
end;

// The attribute of ANode named AName ("local" for one with no namespace, "prefix:local"
// for a namespaced one); nil when it has none
routine DoFindAttribute(const ANode: ptr to xmlNode; const AName: string): ptr to xmlAttr;
var
  LAttr: ptr to xmlAttr;
begin
  if not DoIsElement(ANode) then
    return nil;
  end;
  LAttr := ANode^.properties;
  while LAttr <> nil do
    if DoQualified(LAttr^.ns, LAttr^.name) = AName then
      return LAttr;
    end;
    LAttr := LAttr^.next;
  end;
  return nil;
end;

// An attribute's value (its text, entity references expanded)
routine DoAttributeValue(const AAttr: ptr to xmlAttr): string;
begin
  return DoTakeText(xmlNodeGetContent(ptr to xmlNode(ptr(AAttr))));
end;

// -- Reading

// A parse's error handler: the first error is kept (the first warning until an error
// comes), nothing is printed
routine clink DoOnError(AUserData: ptr; AError: ptr to const xmlError);
var
  LState: ptr to XmlReadState;
  LIsError: bool;
begin
  LState := ptr to XmlReadState(AUserData);
  if (AError = nil) or (AError^.level < XML_ERR_WARNING) or (LState^.IsError) then
    return;
  end;
  LIsError := AError^.level >= XML_ERR_ERROR;
  if (LState^.Found) and (not LIsError) then
    return;
  end;
  LState^.Found := true;
  LState^.IsError := LIsError;
  LState^.Domain := AError^.domain;
  LState^.Line := AError^.line;
  LState^.Column := AError^.int2;
  LState^.Offset := AError^.int1;
  LState^.Message := TrimRight(DoText(ptr to const xmlChar(AError^.message)));
  LState^.File := DoText(ptr to const xmlChar(AError^.file));
end;

// libxml2's resource loader for every parse: the URL opened as written, through libxml2's
// own file calls (open / _wopen, which HookIO hooks), never rewritten by its default loader
// (xmlCanonicPath, a catalog lookup), which would break an io:// path
routine clink DoLoadResource(AContext: ptr; AUrl: ptr to const char; APublicId: ptr to const char;
  AType: xmlResourceType; AFlags: xmlParserInputFlags;
  AOut: ptr to ptr to xmlParserInput): xmlParserErrors;
begin
  return xmlNewInputFromUrl(AUrl, AFlags, AOut);
end;

// A parser context for XML, or for HTML when AHtml, reporting to AState, loading through
// DoLoadResource; nil when there is no room
routine DoNewReadContext(const AState: ptr to XmlReadState;
  const AHtml: bool): ptr to xmlParserCtxt;
var
  LContext: ptr to xmlParserCtxt;
begin
  if AHtml then
    LContext := htmlNewParserCtxt();
  else
    LContext := xmlNewParserCtxt();
  end;
  if LContext <> nil then
    xmlCtxtSetErrorHandler(LContext, DoOnError, ptr(AState));
    xmlCtxtSetResourceLoader(LContext, DoLoadResource, nil);
  end;
  return LContext;
end;

// An XML parser context reporting to AState, loading through DoLoadResource; nil when there
// is no room
routine DoNewContext(const AState: ptr to XmlReadState): ptr to xmlParserCtxt;
begin
  return DoNewReadContext(AState, false);
end;

// Why a read of AName failed, from AState: "AName(line,col): message", "AName(line):
// message" with no column, "AName: message" with no place, AIOFailed when the input could
// not be opened or read, else no room
routine DoReadError(const AName: string; const AState: XmlReadState; const AIOFailed: string): string;
begin
  if not AState.Found then
    return AName + ": " + ADAM_XML_MSG_NO_ROOM;
  end;
  if (AState.Domain = XML_FROM_IO) and (AState.Line = 0) then
    return AName + ": " + AIOFailed;
  end;
  // A column of 0 is none given (a schema's errors name only the line)
  if (AState.Line > 0) and (AState.Column > 0) then
    return AName + "(" + IntToStr(int64(AState.Line)) + "," + IntToStr(int64(AState.Column)) +
      "): " + AState.Message;
  end;
  if AState.Line > 0 then
    return AName + "(" + IntToStr(int64(AState.Line)) + "): " + AState.Message;
  end;
  return AName + ": " + AState.Message;
end;

// libxml2's read of an IO: AContext is the IO; -1 when the IO reports an error
routine clink DoIORead(AContext: ptr; ABuffer: ptr to char; ALength: int32): int32;
var
  LIO: IO;
  LCount: int64;
begin
  LIO := IO(AContext);
  LCount := IORead(LIO, ptr(ABuffer), int64(ALength));
  if (LCount = 0) and (IOStatus(LIO) = IOState.Error) then
    return -1;
  end;
  return int32(LCount);
end;

// libxml2's close of an IO: the IO stays the caller's
routine clink DoIOClose(AContext: ptr): int32;
begin
  return 0;
end;

// -- Writing

// libxml2's write to an IO: AContext is the IO; -1 when not all of it could be written
routine clink DoIOWrite(AContext: ptr; ABuffer: ptr to const char; ALength: int32): int32;
var
  LIO: IO;
begin
  LIO := IO(AContext);
  if IOWriteFull(LIO, ABuffer, int64(ALength)) <> int64(ALength) then
    return -1;
  end;
  return ALength;
end;

// AText as a new NUL-terminated libxml2 text (freed with DoFreeText); nil when there is no room
routine DoNewText(const AText: string): ptr to xmlChar;
begin
  return ptr to xmlChar(ptr(StringToC(AText)));
end;

// A text DoNewText made, freed (nil is nothing)
routine DoFreeText(const AText: ptr to xmlChar);
begin
  if AText <> nil then
    freemem(ptr(AText));
  end;
end;

// A C text StringToC made, freed (nil is nothing)
routine DoFreeChars(const AText: ptr to char);
begin
  if AText <> nil then
    freemem(ptr(AText));
  end;
end;

// libxml2's format flag: 1 (indented) when APretty, else 0
routine DoFormat(const APretty: bool): int32;
begin
  if APretty then
    return 1;
  end;
  return 0;
end;

// Whether AEncoding names UTF-8 (libxml2 writes it with no encoder)
routine DoIsUtf8(const AEncoding: string): bool;
var
  LName: string;
begin
  LName := UpperCase(AEncoding);
  return (LName = ADAM_XML_UTF8) or (LName = "UTF8");
end;

// AName split at its first ':' into APrefix and ALocal (APrefix "" when it has none)
routine DoSplitName(const AName: string; var APrefix: string; var ALocal: string);
var
  LAt: int64;
begin
  LAt := IndexOf(":", AName, 0);
  if LAt < 0 then
    APrefix := "";
    ALocal := AName;
  else
    APrefix := Substring(AName, 0, LAt);
    ALocal := Substring(AName, LAt + 1, len(AName) - LAt - 1);
  end;
end;

// Whether AText is an XML name with no ':' (an NCName: a prefix or a local name)
routine DoIsNCName(const AText: string): bool;
var
  LText: ptr to xmlChar;
  LOk: bool;
begin
  if len(AText) = 0 then
    return false;
  end;
  LText := DoNewText(AText);
  LOk := (LText <> nil) and (xmlValidateNCName(LText, 0) = 0);
  DoFreeText(LText);
  return LOk;
end;

// The namespace APrefix names in scope at ANode in ADoc ("" the default one); nil when none
routine DoFindNamespace(const ADoc: ptr to xmlDoc; const ANode: ptr to xmlNode;
  const APrefix: string): ptr to xmlNs;
var
  LPrefix: ptr to xmlChar;
  LNs: ptr to xmlNs;
begin
  if len(APrefix) = 0 then
    return xmlSearchNs(ADoc, ANode, nil);
  end;
  LPrefix := DoNewText(APrefix);
  LNs := xmlSearchNs(ADoc, ANode, LPrefix);
  DoFreeText(LPrefix);
  return LNs;
end;

// AName ("local" or "prefix:local") as a name at ANode: its local part into ALocal, its
// namespace into ANs (a prefix's as declared at ANode or above; with none, the default one
// in scope for an element, none for an attribute); false when a part is no XML name or the
// prefix is not declared
routine DoResolveName(const ADoc: ptr to xmlDoc; const ANode: ptr to xmlNode; const AName: string;
  const AIsElement: bool; var ALocal: string; var ANs: ptr to xmlNs): bool;
var
  LPrefix: string;
begin
  ANs := nil;
  DoSplitName(AName, LPrefix, ALocal);
  if not DoIsNCName(ALocal) then
    return false;
  end;
  if len(LPrefix) = 0 then
    if AIsElement then
      ANs := DoFindNamespace(ADoc, ANode, "");
    end;
    return true;
  end;
  if not DoIsNCName(LPrefix) then
    return false;
  end;
  ANs := DoFindNamespace(ADoc, ANode, LPrefix);
  return ANs <> nil;
end;

public type
  /// What a read does besides parsing (Xml.FromString / FromFile / FromIO and their
  /// instance forms, with an XmlReadOptions set).
  XmlReadOption = choices(
    /// Every XInclude element (xi:include) is replaced by the document or text it includes
    /// (its xi:fallback when that cannot be read), as the document is read
    XInclude);

  /// The XmlReadOption set a read takes ([] reads the document as it is).
  /// @example `LBook := Xml.FromFile("book.xml", [XmlReadOption.XInclude]);`
  XmlReadOptions = set of XmlReadOption;

// -- Reading a document (Xml's reads and XmlSchema's share these)

// The XInclude elements of ADoc (read as AName from the URL AUrl; "" for a text / an IO)
// replaced by what they include, read through DoLoadResource as the document was; false with
// AError set ("AName(line): message", the included document's own name when the error is in
// it); ADoc stays the caller's either way
routine DoXInclude(const ADoc: ptr to xmlDoc; const AName: string; const AUrl: string;
  var AError: string): bool;
var
  LState: XmlReadState;
  LContext: ptr to xmlXIncludeCtxt;
  LCount: int32;
  LName: string;
begin
  LContext := xmlXIncludeNewContext(ADoc);
  if LContext = nil then
    AError := AName + ": " + ADAM_XML_MSG_NO_ROOM;
    return false;
  end;
  xmlXIncludeSetFlags(LContext, ADAM_XML_XINCLUDE_OPTIONS);
  xmlXIncludeSetErrorHandler(LContext, DoOnError, ptr(addr of LState));
  xmlXIncludeSetResourceLoader(LContext, DoLoadResource, nil);
  // The document node: an XInclude element as the root is replaced too
  LCount := xmlXIncludeProcessNode(LContext, ptr to xmlNode(ptr(ADoc)));
  xmlXIncludeFreeContext(LContext);
  if LCount >= 0 then
    return true;
  end;
  // An error inside an included document names that document; one at an XInclude element
  // (a target that cannot be read, a bad href) names the document read
  LName := AName;
  if (len(LState.File) > 0) and (LState.File <> AUrl) then
    LName := LState.File;
  end;
  AError := DoReadError(LName, LState, ADAM_XML_MSG_OPEN_FAILED);
  return false;
end;

// ADoc (nil: the read failed, AError already set) with its XInclude elements processed when
// AOptions asks for it; nil (ADoc freed) with AError set when that fails
routine DoAfterRead(const ADoc: ptr to xmlDoc; const AOptions: XmlReadOptions;
  const AName: string; const AUrl: string; var AError: string): ptr to xmlDoc;
begin
  if (ADoc = nil) or not (XmlReadOption.XInclude in AOptions) then
    return ADoc;
  end;
  if not DoXInclude(ADoc, AName, AUrl, AError) then
    xmlFreeDoc(ADoc);
    return nil;
  end;
  return ADoc;
end;

// The text AText as a new document (the caller's), XML or HTML when AHtml, AOptions applied
// (XML only); nil with AError set ("<text>(line,col): message")
routine DoParseText(const AText: string; const AHtml: bool; const AOptions: XmlReadOptions;
  var AError: string): ptr to xmlDoc;
var
  LState: XmlReadState;
  LContext: ptr to xmlParserCtxt;
  LDoc: ptr to xmlDoc;
begin
  if len(AText) > ADAM_XML_INT32_MAX then
    AError := ADAM_XML_TEXT_NAME + ": " + ADAM_XML_MSG_TOO_LARGE;
    return nil;
  end;
  LContext := DoNewReadContext(addr of LState, AHtml);
  if LContext = nil then
    AError := ADAM_XML_TEXT_NAME + ": " + ADAM_XML_MSG_NO_ROOM;
    return nil;
  end;
  if AHtml then
    LDoc := htmlCtxtReadMemory(LContext, DoChars(AText), int32(len(AText)), nil, nil,
      ADAM_XML_HTML_OPTIONS);
  else
    LDoc := xmlCtxtReadMemory(LContext, DoChars(AText), int32(len(AText)), nil, nil,
      ADAM_XML_READ_OPTIONS);
  end;
  xmlFreeParserCtxt(LContext);
  if LDoc = nil then
    AError := DoReadError(ADAM_XML_TEXT_NAME, LState, ADAM_XML_MSG_IO_FAILED);
    return nil;
  end;
  return DoAfterRead(LDoc, AOptions, ADAM_XML_TEXT_NAME, "", AError);
end;

// The file at APath read through C's file calls (a HookIO path reads its IO) as a new
// document (the caller's), XML or HTML when AHtml, AOptions applied (XML only); nil with
// AError set ("APath(line,col): message", "APath: the file cannot be opened")
routine DoParseFile(const APath: string; const AHtml: bool; const AOptions: XmlReadOptions;
  var AError: string): ptr to xmlDoc;
var
  LState: XmlReadState;
  LContext: ptr to xmlParserCtxt;
  LPath: ptr to char;
  LUrl: string;
  LDoc: ptr to xmlDoc;
begin
  LPath := DoFilePath(APath);
  if LPath = nil then
    AError := APath + ": " + ADAM_XML_MSG_NO_ROOM;
    return nil;
  end;
  LContext := DoNewReadContext(addr of LState, AHtml);
  if LContext = nil then
    freemem(ptr(LPath));
    AError := APath + ": " + ADAM_XML_MSG_NO_ROOM;
    return nil;
  end;
  if AHtml then
    LDoc := htmlCtxtReadFile(LContext, ptr to const char(LPath), nil, ADAM_XML_HTML_OPTIONS);
  else
    LDoc := xmlCtxtReadFile(LContext, ptr to const char(LPath), nil, ADAM_XML_READ_OPTIONS);
  end;
  xmlFreeParserCtxt(LContext);
  // The URL libxml2 names the document by (its errors' file)
  LUrl := DoText(ptr to const xmlChar(LPath));
  freemem(ptr(LPath));
  if LDoc = nil then
    AError := DoReadError(APath, LState, ADAM_XML_MSG_OPEN_FAILED);
    return nil;
  end;
  return DoAfterRead(LDoc, AOptions, APath, LUrl, AError);
end;

// The text the IO AIO holds from its place to its end, read in pieces through libxml2's IO
// callbacks, as a new document (the caller's), XML or HTML when AHtml, AOptions applied (XML
// only); nil with AError set ("<io>(line,col): message"); the IO stays the caller's (not
// closed)
routine DoParseIO(const AIO: IO; const AHtml: bool; const AOptions: XmlReadOptions;
  var AError: string): ptr to xmlDoc;
var
  LState: XmlReadState;
  LContext: ptr to xmlParserCtxt;
  LDoc: ptr to xmlDoc;
begin
  if AIO = nil then
    AError := ADAM_XML_IO_NAME + ": " + ADAM_XML_MSG_NO_IO;
    return nil;
  end;
  LContext := DoNewReadContext(addr of LState, AHtml);
  if LContext = nil then
    AError := ADAM_XML_IO_NAME + ": " + ADAM_XML_MSG_NO_ROOM;
    return nil;
  end;
  if AHtml then
    LDoc := htmlCtxtReadIO(LContext, DoIORead, DoIOClose, ptr(AIO), nil, nil,
      ADAM_XML_HTML_OPTIONS);
  else
    LDoc := xmlCtxtReadIO(LContext, DoIORead, DoIOClose, ptr(AIO), nil, nil,
      ADAM_XML_READ_OPTIONS);
  end;
  xmlFreeParserCtxt(LContext);
  if LDoc = nil then
    AError := DoReadError(ADAM_XML_IO_NAME, LState, ADAM_XML_MSG_IO_FAILED);
    return nil;
  end;
  return DoAfterRead(LDoc, AOptions, ADAM_XML_IO_NAME, "", AError);
end;

// -- XPath

// The element whose in-scope namespaces an XPath run from ANode binds: ANode itself, a
// document's root element, else the nearest element above ANode (an attribute's, a text's
// inside an attribute); nil when there is none
routine DoScopeElement(const ADoc: ptr to xmlDoc; const ANode: ptr to xmlNode): ptr to xmlNode;
var
  LNode: ptr to xmlNode;
begin
  if ANode = nil then
    return nil;
  end;
  if (ANode^.type_ = XML_DOCUMENT_NODE) or (ANode^.type_ = XML_HTML_DOCUMENT_NODE) then
    return xmlDocGetRootElement(ADoc);
  end;
  LNode := ANode;
  while (LNode <> nil) and (LNode^.type_ <> XML_ELEMENT_NODE) do
    LNode := LNode^.parent_;
  end;
  return LNode;
end;

// Why an XPath compile or run failed, from AState: a compile's "<xpath>(1,col): message" (col
// 1-based in the expression), a run's "<xpath>: message" (a compiled run has no place in the
// text: libxml2 reports offset 0), "<xpath>: ..." when libxml2 gave no reason
routine DoPathError(const AState: XmlReadState; const AHasPlace: bool): string;
begin
  if not AState.Found then
    return ADAM_XML_XPATH_NAME + ": " + ADAM_XML_MSG_XPATH_FAILED;
  end;
  if not AHasPlace then
    return ADAM_XML_XPATH_NAME + ": " + AState.Message;
  end;
  return ADAM_XML_XPATH_NAME + "(1," + IntToStr(int64(AState.Offset) + 1) + "): " +
    AState.Message;
end;

// An XPath number as an int64 into AValue; false for a NaN, an infinity, a fraction or a value
// outside int64 (every comparison with a NaN is false, so the range test catches it)
routine DoWhole(const ANumber: float64; var AValue: int64): bool;
begin
  if not ((ANumber >= -ADAM_XML_INT64_BOUND) and (ANumber < ADAM_XML_INT64_BOUND)) then
    return false;
  end;
  if float64(int64(ANumber)) <> ANumber then
    return false;
  end;
  AValue := int64(ANumber);
  return true;
end;

type
  // A compiled XPath expression, shared by every XmlPath made from one Compile
  XmlPathCode = object
    // nil when the expression did not compile
    Compiled: ptr to xmlXPathCompExpr;
    // The compile's error, then the last run's ("" after a run that worked)
    LastError: string;

    done;
    begin
      if self.Compiled <> nil then
        xmlXPathFreeCompExpr(self.Compiled);
      end;
    end;
  end;

  // A $variable an XmlPath binds: its name and one value of the kind XPATH_STRING /
  // XPATH_NUMBER / XPATH_BOOLEAN
  XmlPathVariable = record
    Name: string;
    Kind: int32;
    Text: string;
    Number: float64;
    Flag: bool;
  end;

  // One parsed document, shared by every Xml viewing it
  XmlTree = object
    Doc: ptr to xmlDoc;
    // The nodes taken out of the document (Remove, SetText), kept until it goes so no view
    // of one dangles
    Detached: array of ptr to xmlNode;

    // ANode unlinked from where it is, kept in Detached
    method Detach(const ANode: ptr to xmlNode);
    begin
      xmlUnlinkNode(ANode);
      setlength(self.Detached, len(self.Detached) + 1);
      self.Detached[len(self.Detached) - 1] := ANode;
    end;

    // The detached nodes freed (before the document: their names may be its dictionary's)
    method FreeDetached();
    var
      LI: int64;
    begin
      for LI := 0 to len(self.Detached) - 1 do
        xmlFreeNode(self.Detached[LI]);
      end;
      setlength(self.Detached, 0);
    end;

    done;
    begin
      self.FreeDetached();
      if self.Doc <> nil then
        xmlFreeDoc(self.Doc);
      end;
    end;
  end;

// AVariable's value as a new libxml2 XPath object (the caller's); nil when there is no room
routine DoVariableValue(const AVariable: XmlPathVariable): ptr to xmlXPathObject;
var
  LText: ptr to xmlChar;
  LResult: ptr to xmlXPathObject;
begin
  if AVariable.Kind = XPATH_NUMBER then
    return xmlXPathNewFloat(AVariable.Number);
  end;
  if AVariable.Kind = XPATH_BOOLEAN then
    if AVariable.Flag then
      return xmlXPathNewBoolean(1);
    end;
    return xmlXPathNewBoolean(0);
  end;
  LText := DoNewText(AVariable.Text);
  if LText = nil then
    return nil;
  end;
  LResult := xmlXPathNewString(ptr to const xmlChar(LText));
  DoFreeText(LText);
  return LResult;
end;

// -- Validation

public type
  // What a schema is written in: a DTD (its declarations, as an external subset is), an XML
  // Schema (XSD) or a RelaxNG schema (its XML form)
  XmlSchemaKind = choices(Dtd, Xsd, RelaxNG);

  // One thing a validation found: where (the line of the node at fault; column 0 when
  // libxml2 gives none), what, and whether it is only a warning
  XmlFinding = record
    Line: int64;
    Column: int64;
    Message: string;
    IsWarning: bool;
  end;

  // Every finding of one validation, in the order found
  XmlFindings = array of XmlFinding;

type
  // What a validation's error handler collects: every error and warning
  XmlValidState = record
    Findings: XmlFindings;
  end;

  // A compiled schema, shared by every XmlSchema made from one From*
  XmlSchemaCode = object
    Kind: XmlSchemaKind;
    // An XSD / RelaxNG schema's own document (an XSD schema points into it)
    Doc: ptr to xmlDoc;
    // The compiled schema, one of these for its kind (nil when it did not compile)
    Dtd: ptr to xmlDtd;
    Xsd: ptr to xmlSchema;
    Rng: ptr to xmlRelaxNG;
    // Why it did not compile ("" when it did)
    Error: string;

    done;
    begin
      if self.Xsd <> nil then
        xmlSchemaFree(self.Xsd);
      end;
      if self.Rng <> nil then
        xmlRelaxNGFree(self.Rng);
      end;
      if self.Dtd <> nil then
        xmlFreeDtd(self.Dtd);
      end;
      if self.Doc <> nil then
        xmlFreeDoc(self.Doc);
      end;
    end;
  end;

// A validation's error handler: every error and warning kept, nothing printed
routine clink DoOnFinding(AUserData: ptr; AError: ptr to const xmlError);
var
  LState: ptr to XmlValidState;
  LFinding: XmlFinding;
begin
  LState := ptr to XmlValidState(AUserData);
  if (AError = nil) or (AError^.level < XML_ERR_WARNING) then
    return;
  end;
  LFinding.Line := int64(AError^.line);
  LFinding.Column := int64(AError^.int2);
  LFinding.Message := TrimRight(DoText(ptr to const xmlChar(AError^.message)));
  LFinding.IsWarning := AError^.level < XML_ERR_ERROR;
  setlength(LState^.Findings, len(LState^.Findings) + 1);
  LState^.Findings[len(LState^.Findings) - 1] := LFinding;
end;

// AFindings as the one finding AMessage (line 0): a validation that could not start
routine DoOneFinding(var AFindings: XmlFindings; const AMessage: string);
begin
  setlength(AFindings, 1);
  AFindings[0].Line := 0;
  AFindings[0].Column := 0;
  AFindings[0].Message := AMessage;
  AFindings[0].IsWarning := false;
end;

// The DTD AInput holds (consumed; nil: AOpenFailed) compiled into ACode, AName naming it in
// an error ("AName(line,col): message")
routine DoTakeDtd(const ACode: ref XmlSchemaCode; const AInput: ptr to xmlParserInput;
  const AName: string; const AOpenFailed: string);
var
  LState: XmlReadState;
  LContext: ptr to xmlParserCtxt;
begin
  if AInput = nil then
    ACode.Error := AName + ": " + AOpenFailed;
    return;
  end;
  LContext := DoNewContext(addr of LState);
  if LContext = nil then
    xmlFreeInputStream(AInput);
    ACode.Error := AName + ": " + ADAM_XML_MSG_NO_ROOM;
    return;
  end;
  ACode.Dtd := xmlCtxtParseDtd(LContext, AInput, nil, nil);
  xmlFreeParserCtxt(LContext);
  if ACode.Dtd = nil then
    ACode.Error := DoReadError(AName, LState, AOpenFailed);
  end;
end;

// The schema document ADoc (nil: AError, why it could not be read) compiled into ACode as its
// kind (XSD / RelaxNG); ACode keeps ADoc; AName names the schema in an error
routine DoTakeSchemaDoc(const ACode: ref XmlSchemaCode; const ADoc: ptr to xmlDoc;
  const AError: string; const AName: string);
var
  LState: XmlReadState;
  LXsdParser: ptr to xmlSchemaParserCtxt;
  LRngParser: ptr to xmlRelaxNGParserCtxt;
begin
  if ADoc = nil then
    ACode.Error := AError;
    return;
  end;
  ACode.Doc := ADoc;
  if ACode.Kind = XmlSchemaKind.Xsd then
    LXsdParser := xmlSchemaNewDocParserCtxt(ADoc);
    if LXsdParser = nil then
      ACode.Error := AName + ": " + ADAM_XML_MSG_NO_ROOM;
      return;
    end;
    xmlSchemaSetParserStructuredErrors(LXsdParser, DoOnError, ptr(addr of LState));
    xmlSchemaSetResourceLoader(LXsdParser, DoLoadResource, nil);
    ACode.Xsd := xmlSchemaParse(LXsdParser);
    xmlSchemaFreeParserCtxt(LXsdParser);
    if ACode.Xsd = nil then
      ACode.Error := DoReadError(AName, LState, ADAM_XML_MSG_NO_SCHEMA);
    end;
    return;
  end;
  LRngParser := xmlRelaxNGNewDocParserCtxt(ADoc);
  if LRngParser = nil then
    ACode.Error := AName + ": " + ADAM_XML_MSG_NO_ROOM;
    return;
  end;
  xmlRelaxNGSetParserStructuredErrors(LRngParser, DoOnError, ptr(addr of LState));
  xmlRelaxNGSetResourceLoader(LRngParser, DoLoadResource, nil);
  ACode.Rng := xmlRelaxNGParse(LRngParser);
  xmlRelaxNGFreeParserCtxt(LRngParser);
  if ACode.Rng = nil then
    ACode.Error := DoReadError(AName, LState, ADAM_XML_MSG_NO_SCHEMA);
  end;
end;

public forward type Xml;
public forward type XmlAttribute;

public type
  // What a node is
  XmlKind = choices(Missing, Element, Text, CData, Comment, Instruction, EntityReference,
    Attribute, Namespace, Document, Other);

  /// A compiled XPath 1.0 expression with the namespace prefixes and $variables it binds:
  /// compiled once (XmlPath.Compile), run on any node of any document any number of times
  /// (Xml.Select / SelectFirst / Evaluate). A value: a copy shares the compiled code and
  /// takes its own copy of the prefixes and variables.
  /// @example `LItems := XmlPath.Compile("//p:item[@id = $id]").RegisterNamespace("p", "urn:shop").SetVariable("id", 7);`
  XmlPath = object
    // The compiled code (nil only for a value never made by Compile)
    hidden Code: ref XmlPathCode;
    // The expression as given
    hidden Source: string;
    // The prefixes bound, each with the URI at the same index
    hidden Prefixes: StringArray;
    hidden Uris: StringArray;
    // The $variables bound
    hidden Variables: array of XmlPathVariable;

    /// Compiles the XPath 1.0 expression AExpression.
    /// @param AExpression the expression ("//item[@id = 3]", "count(//item)", "$name" ...)
    /// @returns the compiled expression; IsValid false, ErrorText why, when it does not
    ///   compile
    /// @example `LPath := XmlPath.Compile("/config/window/@width");`
    static method Compile(const AExpression: string): XmlPath;
    var
      LPath: XmlPath;
      LState: XmlReadState;
      LContext: ptr to xmlXPathContext;
      LText: ptr to xmlChar;
    begin
      LPath.Source := AExpression;
      LPath.Code := ref XmlPathCode();
      LContext := xmlXPathNewContext(nil);
      if LContext = nil then
        LPath.Code.LastError := ADAM_XML_XPATH_NAME + ": " + ADAM_XML_MSG_NO_ROOM;
        return LPath;
      end;
      // Every compile error to LState: libxml2 prints nothing
      xmlXPathSetErrorHandler(LContext, DoOnError, ptr(addr of LState));
      LText := DoNewText(AExpression);
      if LText <> nil then
        LPath.Code.Compiled := xmlXPathCtxtCompile(LContext, ptr to const xmlChar(LText));
        DoFreeText(LText);
      end;
      xmlXPathFreeContext(LContext);
      if LPath.Code.Compiled = nil then
        if LText = nil then
          LPath.Code.LastError := ADAM_XML_XPATH_NAME + ": " + ADAM_XML_MSG_NO_ROOM;
        else
          LPath.Code.LastError := DoPathError(LState, true);
        end;
      end;
      return LPath;
    end;

    /// Whether the expression compiled.
    /// @returns false for one that did not (ErrorText says why) or a value never compiled
    /// @example `if not LPath.IsValid() then println(LPath.ErrorText()); end;`
    const method IsValid(): bool;
    begin
      return (self.Code <> nil) and (self.Code.Compiled <> nil);
    end;

    /// The expression as given to Compile.
    /// @returns the expression text
    /// @example `println(LPath.Expression());`
    const method Expression(): string;
    begin
      return self.Source;
    end;

    /// Why the expression did not compile, else why its last run failed (a prefix or
    /// $variable not bound, a function libxml2 lacks): "<xpath>(1,col): message" for a
    /// compile, "<xpath>: message" for a run (a run has no place in the text).
    /// @returns the error; "" when it compiled and its last run worked
    /// @example `println(LPath.ErrorText());`
    const method ErrorText(): string;
    begin
      if self.Code = nil then
        return ADAM_XML_XPATH_NAME + ": " + ADAM_XML_MSG_XPATH_FAILED;
      end;
      return self.Code.LastError;
    end;

    /// Binds the namespace prefix APrefix to ANamespaceUri for every run (over a prefix
    /// the context node has in scope, or one bound before).
    /// @param APrefix the prefix the expression writes ("p" in "//p:item"); XPath has no
    ///   default namespace, so an element in one is reached through a prefix bound here
    /// @param ANamespaceUri the namespace's URI
    /// @returns this value, so calls chain; unchanged for an empty prefix or URI
    /// @example `LPath.RegisterNamespace("svg", "http://www.w3.org/2000/svg");`
    method RegisterNamespace(const APrefix: string; const ANamespaceUri: string): XmlPath;
    var
      LI: int64;
    begin
      if (len(APrefix) = 0) or (len(ANamespaceUri) = 0) then
        return self;
      end;
      for LI := 0 to len(self.Prefixes) - 1 do
        if self.Prefixes[LI] = APrefix then
          self.Uris[LI] := ANamespaceUri;
          return self;
        end;
      end;
      setlength(self.Prefixes, len(self.Prefixes) + 1);
      setlength(self.Uris, len(self.Uris) + 1);
      self.Prefixes[len(self.Prefixes) - 1] := APrefix;
      self.Uris[len(self.Uris) - 1] := ANamespaceUri;
      return self;
    end;

    // AVariable bound (over one of its name bound before); unchanged for an empty name
    hidden method DoBind(const AVariable: XmlPathVariable): XmlPath;
    var
      LI: int64;
    begin
      if len(AVariable.Name) = 0 then
        return self;
      end;
      for LI := 0 to len(self.Variables) - 1 do
        if self.Variables[LI].Name = AVariable.Name then
          self.Variables[LI] := AVariable;
          return self;
        end;
      end;
      setlength(self.Variables, len(self.Variables) + 1);
      self.Variables[len(self.Variables) - 1] := AVariable;
      return self;
    end;

    /// Binds the $variable AName to the string AValue for every run.
    /// @param AName the name without its $ ("id" for $id)
    /// @param AValue the value
    /// @returns this value, so calls chain; unchanged for an empty name
    /// @example `LPath.SetVariable("name", "door");`
    method SetVariable(const AName: string; const AValue: string): XmlPath;
    var
      LVariable: XmlPathVariable;
    begin
      LVariable.Name := AName;
      LVariable.Kind := XPATH_STRING;
      LVariable.Text := AValue;
      return self.DoBind(LVariable);
    end;

    /// Binds the $variable AName to the number AValue for every run.
    /// @param AName the name without its $
    /// @param AValue the value
    /// @returns this value, so calls chain
    /// @example `LPath.SetVariable("id", 7);`
    method SetVariable(const AName: string; const AValue: int32): XmlPath;
    begin
      return self.SetVariable(AName, float64(AValue));
    end;

    /// Binds the $variable AName to the number AValue for every run (XPath numbers are
    /// float64: an int64 beyond 2^53 is rounded).
    /// @param AName the name without its $
    /// @param AValue the value
    /// @returns this value, so calls chain
    /// @example `LPath.SetVariable("id", LId);`
    method SetVariable(const AName: string; const AValue: int64): XmlPath;
    begin
      return self.SetVariable(AName, float64(AValue));
    end;

    /// Binds the $variable AName to the number AValue for every run.
    /// @param AName the name without its $
    /// @param AValue the value
    /// @returns this value, so calls chain
    /// @example `LPath.SetVariable("limit", 0.5);`
    method SetVariable(const AName: string; const AValue: float64): XmlPath;
    var
      LVariable: XmlPathVariable;
    begin
      LVariable.Name := AName;
      LVariable.Kind := XPATH_NUMBER;
      LVariable.Number := AValue;
      return self.DoBind(LVariable);
    end;

    /// Binds the $variable AName to the boolean AValue for every run.
    /// @param AName the name without its $
    /// @param AValue the value
    /// @returns this value, so calls chain
    /// @example `LPath.SetVariable("strict", true);`
    method SetVariable(const AName: string; const AValue: bool): XmlPath;
    var
      LVariable: XmlPathVariable;
    begin
      LVariable.Name := AName;
      LVariable.Kind := XPATH_BOOLEAN;
      LVariable.Flag := AValue;
      return self.DoBind(LVariable);
    end;

    // An XPath context over ADoc with this value's bindings, the prefixes in scope on AScope
    // first, reporting to AState; nil when there is no room
    hidden const method DoContext(const ADoc: ptr to xmlDoc; const AScope: ptr to xmlNode;
      const AState: ptr to XmlReadState): ptr to xmlXPathContext;
    var
      LContext: ptr to xmlXPathContext;
      LList: ptr to ptr to xmlNs;
      LI: int64;
      LName: ptr to xmlChar;
      LUri: ptr to xmlChar;
      LValue: ptr to xmlXPathObject;
    begin
      LContext := xmlXPathNewContext(ADoc);
      if LContext = nil then
        return nil;
      end;
      xmlXPathSetErrorHandler(LContext, DoOnError, ptr(AState));
      // The prefixes declared where the context node is (a default namespace has no prefix:
      // XPath cannot name it)
      if AScope <> nil then
        LList := xmlGetNsList(ADoc, AScope);
        if LList <> nil then
          LI := 0;
          while LList[LI] <> nil do
            if LList[LI]^.prefix <> nil then
              xmlXPathRegisterNs(LContext, LList[LI]^.prefix, LList[LI]^.href);
            end;
            LI := LI + 1;
          end;
          xmlFree(ptr(LList));
        end;
      end;
      // This value's prefixes, over those
      for LI := 0 to len(self.Prefixes) - 1 do
        LName := DoNewText(self.Prefixes[LI]);
        LUri := DoNewText(self.Uris[LI]);
        if (LName <> nil) and (LUri <> nil) then
          xmlXPathRegisterNs(LContext, ptr to const xmlChar(LName), ptr to const xmlChar(LUri));
        end;
        DoFreeText(LUri);
        DoFreeText(LName);
      end;
      // This value's $variables: the context owns each value registered
      for LI := 0 to len(self.Variables) - 1 do
        LValue := DoVariableValue(self.Variables[LI]);
        LName := DoNewText(self.Variables[LI].Name);
        if (LValue <> nil) and ((LName = nil) or
          (xmlXPathRegisterVariable(LContext, ptr to const xmlChar(LName), LValue) <> 0)) then
          xmlXPathFreeObject(LValue);
        end;
        DoFreeText(LName);
      end;
      return LContext;
    end;

    /// Runs the expression on ANode of ADoc at libxml2's level (Xml.Select / SelectFirst /
    /// Evaluate are the easy forms): ANode is the context node, the prefixes in scope on
    /// its element and this value's bindings are bound; ErrorText tells why a run failed.
    /// @param ADoc the document
    /// @param ANode the context node (nil: the document node)
    /// @returns libxml2's result, the caller's to free (xmlXPathFreeObject); nil when the
    ///   expression did not compile or the run failed
    /// @example `LResult := LPath.EvaluateAt(LDoc, xmlDocGetRootElement(LDoc));`
    const method EvaluateAt(const ADoc: ptr to xmlDoc; const ANode: ptr to xmlNode): ptr to xmlXPathObject;
    var
      LState: XmlReadState;
      LContext: ptr to xmlXPathContext;
      LNode: ptr to xmlNode;
      LResult: ptr to xmlXPathObject;
    begin
      if (not self.IsValid()) or (ADoc = nil) then
        return nil;
      end;
      LNode := ANode;
      if LNode = nil then
        LNode := ptr to xmlNode(ptr(ADoc));
      end;
      LContext := self.DoContext(ADoc, DoScopeElement(ADoc, LNode), addr of LState);
      if LContext = nil then
        self.Code.LastError := ADAM_XML_XPATH_NAME + ": " + ADAM_XML_MSG_NO_ROOM;
        return nil;
      end;
      LResult := nil;
      if xmlXPathSetContextNode(LNode, LContext) = 0 then
        LResult := xmlXPathCompiledEval(self.Code.Compiled, LContext);
      end;
      xmlXPathFreeContext(LContext);
      if LResult = nil then
        self.Code.LastError := DoPathError(LState, false);
      else
        self.Code.LastError := "";
      end;
      return LResult;
    end;
  end;

  /// A compiled schema (a DTD, an XML Schema or a RelaxNG schema), compiled once and used
  /// to validate any number of documents (Xml.Validate). A value: a copy shares it.
  /// @example `LSchema := XmlSchema.FromFile(XmlSchemaKind.Xsd, "$P:shop.xsd");`
  XmlSchema = object
    // The compiled schema (nil only for a value never made by From*)
    hidden Code: ref XmlSchemaCode;

    // A new value of kind AKind, nothing compiled yet
    hidden static method DoNew(const AKind: XmlSchemaKind): XmlSchema;
    var
      LSchema: XmlSchema;
    begin
      LSchema.Code := ref XmlSchemaCode();
      LSchema.Code.Kind := AKind;
      return LSchema;
    end;

    /// The schema in the file at APath, read through C's file calls (a HookIO path reads
    /// its IO; an XSD's xs:include / xs:import and a RelaxNG's include are read the same way).
    /// @param AKind what it is written in
    /// @param APath the file (an Adam $ path resolved, any other as written)
    /// @returns the schema; IsValid false, ErrorText why ("APath(line,col): message"), when
    ///   it cannot be read or compiled
    /// @example `LSchema := XmlSchema.FromFile(XmlSchemaKind.RelaxNG, "$P:map.rng");`
    static method FromFile(const AKind: XmlSchemaKind; const APath: string): XmlSchema;
    var
      LSchema: XmlSchema;
      LPath: ptr to char;
      LInput: ptr to xmlParserInput;
      LError: string;
    begin
      LSchema := XmlSchema.DoNew(AKind);
      if AKind <> XmlSchemaKind.Dtd then
        DoTakeSchemaDoc(LSchema.Code, DoParseFile(APath, false, [], LError), LError, APath);
        return LSchema;
      end;
      LPath := DoFilePath(APath);
      if LPath = nil then
        LSchema.Code.Error := APath + ": " + ADAM_XML_MSG_NO_ROOM;
        return LSchema;
      end;
      LInput := nil;
      if xmlNewInputFromUrl(ptr to const char(LPath), 0, addr of LInput) <> XML_ERR_OK then
        LInput := nil;
      end;
      DoFreeChars(LPath);
      DoTakeDtd(LSchema.Code, LInput, APath, ADAM_XML_MSG_OPEN_FAILED);
      return LSchema;
    end;

    /// The schema in the text AText (a DTD's declarations, or an XSD / RelaxNG schema's XML).
    /// @param AKind what it is written in
    /// @param AText the schema
    /// @returns the schema; IsValid false, ErrorText why ("<text>(line,col): message"),
    ///   when it does not compile
    /// @example `LSchema := XmlSchema.FromString(XmlSchemaKind.Dtd, "<!ELEMENT note (#PCDATA)>");`
    static method FromString(const AKind: XmlSchemaKind; const AText: string): XmlSchema;
    var
      LSchema: XmlSchema;
      LError: string;
    begin
      LSchema := XmlSchema.DoNew(AKind);
      if AKind <> XmlSchemaKind.Dtd then
        DoTakeSchemaDoc(LSchema.Code, DoParseText(AText, false, [], LError), LError,
          ADAM_XML_TEXT_NAME);
        return LSchema;
      end;
      DoTakeDtd(LSchema.Code, xmlNewInputFromMemory(nil, DoChars(AText), uint64(len(AText)), 0),
        ADAM_XML_TEXT_NAME, ADAM_XML_MSG_NO_ROOM);
      return LSchema;
    end;

    /// The schema the IO AIO holds from its place to its end, read in pieces through
    /// libxml2's IO callbacks (no copy in a string); the IO stays the caller's, open.
    /// @param AKind what it is written in
    /// @param AIO the IO
    /// @returns the schema; IsValid false, ErrorText why ("<io>(line,col): message"), when
    ///   it cannot be read or compiled
    /// @example `LSchema := XmlSchema.FromIO(XmlSchemaKind.Xsd, LEntry);`
    static method FromIO(const AKind: XmlSchemaKind; const AIO: IO): XmlSchema;
    var
      LSchema: XmlSchema;
      LError: string;
    begin
      LSchema := XmlSchema.DoNew(AKind);
      if AKind <> XmlSchemaKind.Dtd then
        DoTakeSchemaDoc(LSchema.Code, DoParseIO(AIO, false, [], LError), LError,
          ADAM_XML_IO_NAME);
        return LSchema;
      end;
      if AIO = nil then
        LSchema.Code.Error := ADAM_XML_IO_NAME + ": " + ADAM_XML_MSG_NO_IO;
        return LSchema;
      end;
      DoTakeDtd(LSchema.Code, xmlNewInputFromIO(nil, DoIORead, DoIOClose, ptr(AIO), 0),
        ADAM_XML_IO_NAME, ADAM_XML_MSG_IO_FAILED);
      return LSchema;
    end;

    /// Whether the schema compiled.
    /// @returns false for one that did not (ErrorText says why) or a value never made
    /// @example `if not LSchema.IsValid() then println(LSchema.ErrorText()); end;`
    const method IsValid(): bool;
    begin
      if self.Code = nil then
        return false;
      end;
      return (self.Code.Dtd <> nil) or (self.Code.Xsd <> nil) or (self.Code.Rng <> nil);
    end;

    /// Why the schema did not compile.
    /// @returns "name(line,col): message" (name: the path, "<text>" or "<io>"); "" when it
    ///   compiled
    /// @example `println(LSchema.ErrorText());`
    const method ErrorText(): string;
    begin
      if self.Code = nil then
        return ADAM_XML_MSG_NO_SCHEMA;
      end;
      return self.Code.Error;
    end;

    /// What the schema is written in.
    /// @returns its kind (XmlSchemaKind.Dtd for a value never made)
    /// @example `if LSchema.Kind() = XmlSchemaKind.Xsd then println("xsd"); end;`
    const method Kind(): XmlSchemaKind;
    begin
      if self.Code = nil then
        return XmlSchemaKind.Dtd;
      end;
      return self.Code.Kind;
    end;

    /// Validates the document ADoc against the schema at libxml2's level (Xml.Validate is
    /// the easy form).
    /// @param ADoc the document
    /// @param AFindings every error and warning found, in order (one finding when the
    ///   schema did not compile or there is no document)
    /// @returns whether the document is valid
    /// @example `LOk := LSchema.ValidateAt(LDoc, LFindings);`
    const method ValidateAt(const ADoc: ptr to xmlDoc; var AFindings: XmlFindings): bool;
    var
      LState: XmlValidState;
      LContext: ptr to xmlParserCtxt;
      LXsd: ptr to xmlSchemaValidCtxt;
      LRng: ptr to xmlRelaxNGValidCtxt;
      LOk: bool;
    begin
      setlength(AFindings, 0);
      if not self.IsValid() then
        DoOneFinding(AFindings, ADAM_XML_MSG_SCHEMA_INVALID + self.ErrorText());
        return false;
      end;
      if ADoc = nil then
        DoOneFinding(AFindings, ADAM_XML_MSG_NO_DOCUMENT);
        return false;
      end;
      LOk := false;
      if self.Code.Dtd <> nil then
        LContext := xmlNewParserCtxt();
        if LContext = nil then
          DoOneFinding(AFindings, ADAM_XML_MSG_NO_ROOM);
          return false;
        end;
        xmlCtxtSetErrorHandler(LContext, DoOnFinding, ptr(addr of LState));
        LOk := xmlCtxtValidateDtd(LContext, ADoc, self.Code.Dtd) <> 0;
        xmlFreeParserCtxt(LContext);
      end;
      if self.Code.Xsd <> nil then
        LXsd := xmlSchemaNewValidCtxt(self.Code.Xsd);
        if LXsd = nil then
          DoOneFinding(AFindings, ADAM_XML_MSG_NO_ROOM);
          return false;
        end;
        xmlSchemaSetValidStructuredErrors(LXsd, DoOnFinding, ptr(addr of LState));
        LOk := xmlSchemaValidateDoc(LXsd, ADoc) = 0;
        xmlSchemaFreeValidCtxt(LXsd);
      end;
      if self.Code.Rng <> nil then
        LRng := xmlRelaxNGNewValidCtxt(self.Code.Rng);
        if LRng = nil then
          DoOneFinding(AFindings, ADAM_XML_MSG_NO_ROOM);
          return false;
        end;
        xmlRelaxNGSetValidStructuredErrors(LRng, DoOnFinding, ptr(addr of LState));
        LOk := xmlRelaxNGValidateDoc(LRng, ADoc) = 0;
        xmlRelaxNGFreeValidCtxt(LRng);
      end;
      AFindings := LState.Findings;
      return LOk;
    end;
  end;

  // An XML node: a view of one node of a shared parsed document (see the header)
  Xml = object
    // The document (nil for a missing value)
    hidden Tree: ref XmlTree;
    // The node viewed (nil: a missing value, or a namespace node)
    hidden Node: ptr to xmlNode;
    // A namespace node an XPath result holds (Node nil): the document's declaration of it,
    // and the element it is in scope on
    hidden Ns: ptr to xmlNs;
    hidden NsOwner: ptr to xmlNode;
    // Why the last Parse / LoadFromFile / LoadFromIO failed ("" after a success)
    hidden Error: string;

    // A view of ANode in this document; a missing value for nil
    hidden const method DoView(const ANode: ptr to xmlNode): Xml;
    var
      LView: Xml;
    begin
      if ANode = nil then
        return LView;
      end;
      LView.Tree := self.Tree;
      LView.Node := ANode;
      return LView;
    end;

    // A view of the namespace node ANs in scope on AOwner, in this document
    hidden const method DoViewNs(const ANs: ptr to xmlNs; const AOwner: ptr to xmlNode): Xml;
    var
      LView: Xml;
    begin
      LView.Tree := self.Tree;
      LView.Ns := ANs;
      LView.NsOwner := AOwner;
      return LView;
    end;

    // This value made a missing one carrying AError
    hidden method DoFail(const AError: string);
    begin
      self.Tree := nil;
      self.Node := nil;
      self.Ns := nil;
      self.NsOwner := nil;
      self.Error := AError;
    end;

    // The document ADoc this value's from now on, viewing its root element; false (ADoc
    // freed) when it has none
    hidden method DoTake(const ADoc: ptr to xmlDoc; const AName: string): bool;
    var
      LTree: ref XmlTree;
      LRoot: ptr to xmlNode;
    begin
      LTree := ref XmlTree();
      LTree.Doc := ADoc;
      LRoot := xmlDocGetRootElement(ADoc);
      if LRoot = nil then
        self.DoFail(AName + ": " + ADAM_XML_MSG_NO_ROOT);
        return false;
      end;
      self.Tree := LTree;
      self.Node := LRoot;
      self.Ns := nil;
      self.NsOwner := nil;
      self.Error := "";
      return true;
    end;

    // -- Reading text, files and IOs (a failure: a missing value, ErrorText set)

    // ADoc (nil: AError says why) this value's document from now on, viewing its root
    // element; false with ErrorText when the read failed or the document has no root
    hidden method DoLoad(const ADoc: ptr to xmlDoc; const AError: string;
      const AName: string): bool;
    begin
      if ADoc = nil then
        self.DoFail(AError);
        return false;
      end;
      return self.DoTake(ADoc, AName);
    end;

    /// Reads the XML text AText as this value's document (its root element from now on).
    /// @param AText the XML text
    /// @returns false, ErrorText why ("<text>(line,col): message"), when it is no
    ///   well-formed XML
    /// @example `if not LDoc.Parse("<config/>") then println(LDoc.ErrorText()); end;`
    method Parse(const AText: string): bool;
    begin
      return self.Parse(AText, []);
    end;

    /// Reads the XML text AText as this value's document, AOptions applied.
    /// @param AText the XML text
    /// @param AOptions what the read does besides parsing ([XmlReadOption.XInclude] ...)
    /// @returns false, ErrorText why, when it is no well-formed XML or an include fails
    /// @example `LDoc.Parse(LText, [XmlReadOption.XInclude]);`
    method Parse(const AText: string; const AOptions: XmlReadOptions): bool;
    var
      LError: string;
      LDoc: ptr to xmlDoc;
    begin
      LDoc := DoParseText(AText, false, AOptions, LError);
      return self.DoLoad(LDoc, LError, ADAM_XML_TEXT_NAME);
    end;

    /// Reads the XML file at APath, through C's file calls (so a HookIO path reads its IO),
    /// as this value's document.
    /// @param APath the file
    /// @returns false, ErrorText why ("APath(line,col): message", "APath: the file cannot
    ///   be opened"), on a failure
    /// @example `if not LDoc.LoadFromFile("config.xml") then println(LDoc.ErrorText()); end;`
    method LoadFromFile(const APath: string): bool;
    begin
      return self.LoadFromFile(APath, []);
    end;

    /// Reads the XML file at APath as this value's document, AOptions applied (an
    /// XInclude's relative href is read from the file's folder).
    /// @param APath the file
    /// @param AOptions what the read does besides parsing
    /// @returns false, ErrorText why, on a failure
    /// @example `LBook.LoadFromFile("book.xml", [XmlReadOption.XInclude]);`
    method LoadFromFile(const APath: string; const AOptions: XmlReadOptions): bool;
    var
      LError: string;
      LDoc: ptr to xmlDoc;
    begin
      LDoc := DoParseFile(APath, false, AOptions, LError);
      return self.DoLoad(LDoc, LError, APath);
    end;

    /// Reads the XML text the IO AIO holds from its place to its end, in pieces through
    /// libxml2's IO callbacks, as this value's document; the IO stays the caller's (not
    /// closed).
    /// @param AIO the IO
    /// @returns false, ErrorText why ("<io>(line,col): message"), on a failure
    /// @example `LDoc.LoadFromIO(LIO);`
    method LoadFromIO(const AIO: IO): bool;
    begin
      return self.LoadFromIO(AIO, []);
    end;

    /// Reads the XML text the IO AIO holds as this value's document, AOptions applied.
    /// @param AIO the IO
    /// @param AOptions what the read does besides parsing
    /// @returns false, ErrorText why, on a failure
    /// @example `LDoc.LoadFromIO(LIO, [XmlReadOption.XInclude]);`
    method LoadFromIO(const AIO: IO; const AOptions: XmlReadOptions): bool;
    var
      LError: string;
      LDoc: ptr to xmlDoc;
    begin
      LDoc := DoParseIO(AIO, false, AOptions, LError);
      return self.DoLoad(LDoc, LError, ADAM_XML_IO_NAME);
    end;

    /// Reads the HTML text AText as this value's document (its html element from now on),
    /// with libxml2's forgiving HTML parser.
    /// @param AText the HTML text
    /// @returns false, ErrorText why, only when there is no room
    /// @example `LPage.ParseHtml("<p>Hello<br>world");`
    method ParseHtml(const AText: string): bool;
    var
      LError: string;
      LDoc: ptr to xmlDoc;
    begin
      LDoc := DoParseText(AText, true, [], LError);
      return self.DoLoad(LDoc, LError, ADAM_XML_TEXT_NAME);
    end;

    /// Reads the HTML file at APath, through C's file calls (so a HookIO path reads its IO),
    /// as this value's document.
    /// @param APath the file
    /// @returns false, ErrorText why ("APath: the file cannot be opened"), on a failure
    /// @example `if not LPage.LoadFromHtmlFile("index.html") then println(LPage.ErrorText()); end;`
    method LoadFromHtmlFile(const APath: string): bool;
    var
      LError: string;
      LDoc: ptr to xmlDoc;
    begin
      LDoc := DoParseFile(APath, true, [], LError);
      return self.DoLoad(LDoc, LError, APath);
    end;

    /// Reads the HTML text the IO AIO holds from its place to its end as this value's
    /// document; the IO stays the caller's (not closed).
    /// @param AIO the IO
    /// @returns false, ErrorText why ("<io>: the IO cannot be read"), on a failure
    /// @example `LPage.LoadFromHtmlIO(LIO);`
    method LoadFromHtmlIO(const AIO: IO): bool;
    var
      LError: string;
      LDoc: ptr to xmlDoc;
    begin
      LDoc := DoParseIO(AIO, true, [], LError);
      return self.DoLoad(LDoc, LError, ADAM_XML_IO_NAME);
    end;

    /// Why the last read (Parse, LoadFrom*, Xml.From*, their HTML forms) failed.
    /// @returns the reason; "" when it did not fail
    /// @example `println(Xml.FromString("<a>").ErrorText());`
    const method ErrorText(): string;
    begin
      return self.Error;
    end;

    // -- Made from a text, a file or an IO (static: Xml.FromFile(P))

    /// The XML text AText's root element.
    /// @param AText the XML text
    /// @returns the root element; a missing value with its ErrorText when it is no
    ///   well-formed XML
    /// @example `LConfig := Xml.FromString("<config debug=\"true\"/>");`
    static method FromString(const AText: string): Xml;
    var
      LXml: Xml;
    begin
      LXml.Parse(AText, []);
      return LXml;
    end;

    /// The XML text AText's root element, AOptions applied.
    /// @param AText the XML text
    /// @param AOptions what the read does besides parsing
    /// @returns the root element; a missing value with its ErrorText on a failure
    /// @example `LDoc := Xml.FromString(LText, [XmlReadOption.XInclude]);`
    static method FromString(const AText: string; const AOptions: XmlReadOptions): Xml;
    var
      LXml: Xml;
    begin
      LXml.Parse(AText, AOptions);
      return LXml;
    end;

    /// The root element of the XML file at APath, read through C's file calls (a HookIO
    /// path reads its IO).
    /// @param APath the file
    /// @returns the root element; a missing value with its ErrorText on a failure
    /// @example `LMap := Xml.FromFile("maps/overworld.tmx");`
    static method FromFile(const APath: string): Xml;
    var
      LXml: Xml;
    begin
      LXml.LoadFromFile(APath, []);
      return LXml;
    end;

    /// The root element of the XML file at APath, AOptions applied.
    /// @param APath the file
    /// @param AOptions what the read does besides parsing
    /// @returns the root element; a missing value with its ErrorText on a failure
    /// @example `LBook := Xml.FromFile("book.xml", [XmlReadOption.XInclude]);`
    static method FromFile(const APath: string; const AOptions: XmlReadOptions): Xml;
    var
      LXml: Xml;
    begin
      LXml.LoadFromFile(APath, AOptions);
      return LXml;
    end;

    /// The root element of the XML text the IO AIO holds from its place to its end.
    /// @param AIO the IO (stays the caller's)
    /// @returns the root element; a missing value with its ErrorText on a failure
    /// @example `LDoc := Xml.FromIO(LIO);`
    static method FromIO(const AIO: IO): Xml;
    var
      LXml: Xml;
    begin
      LXml.LoadFromIO(AIO, []);
      return LXml;
    end;

    /// The root element of the XML text the IO AIO holds, AOptions applied.
    /// @param AIO the IO (stays the caller's)
    /// @param AOptions what the read does besides parsing
    /// @returns the root element; a missing value with its ErrorText on a failure
    /// @example `LDoc := Xml.FromIO(LIO, [XmlReadOption.XInclude]);`
    static method FromIO(const AIO: IO; const AOptions: XmlReadOptions): Xml;
    var
      LXml: Xml;
    begin
      LXml.LoadFromIO(AIO, AOptions);
      return LXml;
    end;

    /// The XML text AText's root element into AXml.
    /// @param AText the XML text
    /// @param AXml the root element; the missing value, its ErrorText why, on a failure
    /// @returns false when it is no well-formed XML
    /// @example `if not Xml.TryFromString(LText, LDoc) then println(LDoc.ErrorText()); end;`
    static method TryFromString(const AText: string; var AXml: Xml): bool;
    begin
      return Xml.TryFromString(AText, [], AXml);
    end;

    /// The XML text AText's root element into AXml, AOptions applied.
    /// @param AText the XML text
    /// @param AOptions what the read does besides parsing
    /// @param AXml the root element; the missing value, its ErrorText why, on a failure
    /// @returns false on a failure
    /// @example `LOk := Xml.TryFromString(LText, [XmlReadOption.XInclude], LDoc);`
    static method TryFromString(const AText: string; const AOptions: XmlReadOptions;
      var AXml: Xml): bool;
    var
      LXml: Xml;
      LOk: bool;
    begin
      LOk := LXml.Parse(AText, AOptions);
      AXml := LXml;
      return LOk;
    end;

    /// The HTML text AText's html element, read with libxml2's forgiving HTML parser
    /// (missing html / head / body elements implied, tags closed as a browser does).
    /// @param AText the HTML text
    /// @returns the html element
    /// @example `LTitle := Xml.FromHtmlString(LPage).SelectFirst("//title").Text();`
    static method FromHtmlString(const AText: string): Xml;
    var
      LXml: Xml;
    begin
      LXml.ParseHtml(AText);
      return LXml;
    end;

    /// The html element of the HTML file at APath, read through C's file calls (a HookIO
    /// path reads its IO).
    /// @param APath the file
    /// @returns the html element; a missing value with its ErrorText when the file cannot
    ///   be read
    /// @example `LPage := Xml.FromHtmlFile("docs/index.html");`
    static method FromHtmlFile(const APath: string): Xml;
    var
      LXml: Xml;
    begin
      LXml.LoadFromHtmlFile(APath);
      return LXml;
    end;

    /// The html element of the HTML text the IO AIO holds from its place to its end.
    /// @param AIO the IO (stays the caller's)
    /// @returns the html element; a missing value with its ErrorText when the IO cannot be
    ///   read
    /// @example `LPage := Xml.FromHtmlIO(LIO);`
    static method FromHtmlIO(const AIO: IO): Xml;
    var
      LXml: Xml;
    begin
      LXml.LoadFromHtmlIO(AIO);
      return LXml;
    end;

    // -- What the node is

    // Whether this value names no node (a failed read, a walk past the end, a name not found)
    const method IsNull(): bool;
    begin
      return (self.Node = nil) and (self.Ns = nil);
    end;

    // What the node is (XmlKind.Missing for a missing value)
    const method Kind(): XmlKind;
    var
      LType: int32;
    begin
      if self.Ns <> nil then
        return XmlKind.Namespace;
      end;
      if self.Node = nil then
        return XmlKind.Missing;
      end;
      LType := self.Node^.type_;
      if LType = XML_ELEMENT_NODE then
        return XmlKind.Element;
      end;
      if LType = XML_TEXT_NODE then
        return XmlKind.Text;
      end;
      if LType = XML_CDATA_SECTION_NODE then
        return XmlKind.CData;
      end;
      if LType = XML_COMMENT_NODE then
        return XmlKind.Comment;
      end;
      if LType = XML_PI_NODE then
        return XmlKind.Instruction;
      end;
      if LType = XML_ENTITY_REF_NODE then
        return XmlKind.EntityReference;
      end;
      if LType = XML_ATTRIBUTE_NODE then
        return XmlKind.Attribute;
      end;
      if (LType = XML_DOCUMENT_NODE) or (LType = XML_HTML_DOCUMENT_NODE) then
        return XmlKind.Document;
      end;
      return XmlKind.Other;
    end;

    // Whether the node is an element
    const method IsElement(): bool;
    begin
      return DoIsElement(self.Node);
    end;

    // An element's or an attribute's name as written (prefix:local), a processing
    // instruction's target, a namespace node's prefix ("" for the default namespace); ""
    // for any other node
    const method Name(): string;
    begin
      if self.Ns <> nil then
        return DoText(self.Ns^.prefix);
      end;
      return DoName(self.Node);
    end;

    // An element's or an attribute's name without its prefix, a namespace node's prefix;
    // "" for any other node
    const method LocalName(): string;
    begin
      if self.Ns <> nil then
        return DoText(self.Ns^.prefix);
      end;
      if not DoIsNamedKind(self.Node) then
        return "";
      end;
      return DoText(self.Node^.name);
    end;

    // An element's or an attribute's namespace prefix; "" when it has none
    const method Prefix(): string;
    begin
      if (not DoIsNamedKind(self.Node)) or (self.Node^.ns = nil) then
        return "";
      end;
      return DoText(self.Node^.ns^.prefix);
    end;

    // An element's or an attribute's namespace URI; "" when it is in no namespace
    const method NamespaceUri(): string;
    begin
      if (not DoIsNamedKind(self.Node)) or (self.Node^.ns = nil) then
        return "";
      end;
      return DoText(self.Node^.ns^.href);
    end;

    // The line the node starts on in its source (an attribute's or a namespace node's: its
    // element's; 0 for a missing value)
    const method Line(): int64;
    begin
      if self.Ns <> nil then
        return int64(xmlGetLineNo(self.NsOwner));
      end;
      if self.Node = nil then
        return 0;
      end;
      return int64(xmlGetLineNo(self.Node));
    end;

    // -- Text

    // The node's own text: an element's text and CDATA children joined (not its
    // descendants'), a text / CDATA / comment / processing instruction / entity reference
    // node's content, an attribute's value, a namespace node's URI; "" for any other node
    // (a document, a DTD: their records hold no content field)
    const method Text(): string;
    var
      LResult: string;
      LChild: ptr to xmlNode;
      LType: int32;
    begin
      if self.Ns <> nil then
        return DoText(self.Ns^.href);
      end;
      if self.Node = nil then
        return "";
      end;
      LType := self.Node^.type_;
      if LType = XML_ATTRIBUTE_NODE then
        return DoAttributeValue(ptr to xmlAttr(ptr(self.Node)));
      end;
      if (LType = XML_TEXT_NODE) or (LType = XML_CDATA_SECTION_NODE) or
        (LType = XML_COMMENT_NODE) or (LType = XML_PI_NODE) or (LType = XML_ENTITY_REF_NODE) then
        return DoText(self.Node^.content);
      end;
      if LType <> XML_ELEMENT_NODE then
        return "";
      end;
      LResult := "";
      LChild := self.Node^.children;
      while LChild <> nil do
        if (LChild^.type_ = XML_TEXT_NODE) or (LChild^.type_ = XML_CDATA_SECTION_NODE) then
          LResult := LResult + DoText(LChild^.content);
        end;
        LChild := LChild^.next;
      end;
      return LResult;
    end;

    // All the text in and below the node, in document order (entity references expanded)
    const method InnerText(): string;
    begin
      if self.Ns <> nil then
        return DoText(self.Ns^.href);
      end;
      if self.Node = nil then
        return "";
      end;
      return DoTakeText(xmlNodeGetContent(self.Node));
    end;

    // -- Attributes ("local", or "prefix:local" for a namespaced one)

    // Whether the element has the attribute AName
    const method Has(const AName: string): bool;
    begin
      return DoFindAttribute(self.Node, AName) <> nil;
    end;

    // The attribute AName's value; "" when there is none
    const method Get(const AName: string): string;
    begin
      return self.Get(AName, "");
    end;

    // The attribute AName's value; ADefault when there is none
    const method Get(const AName: string; const ADefault: string): string;
    var
      LValue: string;
    begin
      if not self.TryGet(AName, LValue) then
        return ADefault;
      end;
      return LValue;
    end;

    // The attribute AName as an int32; ADefault when there is none or it is no int32
    const method Get(const AName: string; const ADefault: int32): int32;
    var
      LValue: int32;
    begin
      if not self.TryGet(AName, LValue) then
        return ADefault;
      end;
      return LValue;
    end;

    // The attribute AName as an int64; ADefault when there is none or it is no int64
    const method Get(const AName: string; const ADefault: int64): int64;
    var
      LValue: int64;
    begin
      if not self.TryGet(AName, LValue) then
        return ADefault;
      end;
      return LValue;
    end;

    // The attribute AName as a float64; ADefault when there is none or it is no number
    const method Get(const AName: string; const ADefault: float64): float64;
    var
      LValue: float64;
    begin
      if not self.TryGet(AName, LValue) then
        return ADefault;
      end;
      return LValue;
    end;

    // The attribute AName as a bool (true / 1, false / 0, as XML Schema's boolean); ADefault
    // when there is none or it is neither
    const method Get(const AName: string; const ADefault: bool): bool;
    var
      LValue: bool;
    begin
      if not self.TryGet(AName, LValue) then
        return ADefault;
      end;
      return LValue;
    end;

    // The attribute AName's value into AValue; false when there is none (AValue unchanged)
    const method TryGet(const AName: string; var AValue: string): bool;
    var
      LAttr: ptr to xmlAttr;
    begin
      LAttr := DoFindAttribute(self.Node, AName);
      if LAttr = nil then
        return false;
      end;
      AValue := DoAttributeValue(LAttr);
      return true;
    end;

    // The attribute AName as an int64 into AValue (spaces around it allowed); false when
    // there is none or it is no whole number (AValue unchanged)
    const method TryGet(const AName: string; var AValue: int64): bool;
    var
      LText: string;
      LValue: int64;
    begin
      if not self.TryGet(AName, LText) then
        return false;
      end;
      if not TryStrToInt(Trim(LText), LValue) then
        return false;
      end;
      AValue := LValue;
      return true;
    end;

    // The attribute AName as an int32 into AValue; false when there is none or it is no
    // whole number in int32's range (AValue unchanged)
    const method TryGet(const AName: string; var AValue: int32): bool;
    var
      LValue: int64;
    begin
      if not self.TryGet(AName, LValue) then
        return false;
      end;
      if (LValue < ADAM_XML_INT32_MIN) or (LValue > ADAM_XML_INT32_MAX) then
        return false;
      end;
      AValue := int32(LValue);
      return true;
    end;

    // The attribute AName as a float64 into AValue; false when there is none or it is no
    // number (AValue unchanged)
    const method TryGet(const AName: string; var AValue: float64): bool;
    var
      LText: string;
      LValue: float64;
    begin
      if not self.TryGet(AName, LText) then
        return false;
      end;
      if not TryStrToFloat(Trim(LText), LValue) then
        return false;
      end;
      AValue := LValue;
      return true;
    end;

    // The attribute AName as a bool into AValue (true / 1, false / 0); false when there is
    // none or it is neither (AValue unchanged)
    const method TryGet(const AName: string; var AValue: bool): bool;
    var
      LText: string;
    begin
      if not self.TryGet(AName, LText) then
        return false;
      end;
      LText := Trim(LText);
      if (LText = "true") or (LText = "1") then
        AValue := true;
        return true;
      end;
      if (LText = "false") or (LText = "0") then
        AValue := false;
        return true;
      end;
      return false;
    end;

    // How many attributes the element has (0 for any other node)
    const method AttributeCount(): int64;
    var
      LCount: int64;
      LAttr: ptr to xmlAttr;
    begin
      LCount := 0;
      if DoIsElement(self.Node) then
        LAttr := self.Node^.properties;
        while LAttr <> nil do
          LCount := LCount + 1;
          LAttr := LAttr^.next;
        end;
      end;
      return LCount;
    end;

    // The element's attribute names as written, in document order
    const method AttributeNames(): StringArray;
    var
      LNames: StringArray;
      LAttr: ptr to xmlAttr;
      LAt: int64;
    begin
      setlength(LNames, self.AttributeCount());
      if len(LNames) = 0 then
        return LNames;
      end;
      LAt := 0;
      LAttr := self.Node^.properties;
      while LAttr <> nil do
        LNames[LAt] := DoQualified(LAttr^.ns, LAttr^.name);
        LAt := LAt + 1;
        LAttr := LAttr^.next;
      end;
      return LNames;
    end;

    // The element's attributes (name as written and value), in document order
    const method Attributes(): sequence of XmlAttribute;
    var
      LAttr: ptr to xmlAttr;
      LItem: XmlAttribute;
    begin
      if not DoIsElement(self.Node) then
        return;
      end;
      LAttr := self.Node^.properties;
      while LAttr <> nil do
        LItem.Name := DoQualified(LAttr^.ns, LAttr^.name);
        LItem.Value := DoAttributeValue(LAttr);
        yield LItem;
        LAttr := LAttr^.next;
      end;
    end;

    // -- Walking

    // The node's parent (the root element's is the document node; an attribute's its
    // element; a namespace node's the element it is in scope on); missing for the document
    const method Parent(): Xml;
    begin
      if self.Ns <> nil then
        return self.DoView(self.NsOwner);
      end;
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(self.Node^.parent_);
    end;

    // The next sibling node; missing for the last
    const method Next(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(self.Node^.next);
    end;

    // The previous sibling node; missing for the first
    const method Previous(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(self.Node^.prev);
    end;

    // The next sibling element; missing when there is none
    const method NextElement(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(xmlNextElementSibling(self.Node));
    end;

    // The previous sibling element; missing when there is none
    const method PreviousElement(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(xmlPreviousElementSibling(self.Node));
    end;

    // The first child node; missing when there is none
    const method FirstChild(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(self.Node^.children);
    end;

    // The first child element; missing when there is none
    const method FirstElement(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(xmlFirstElementChild(self.Node));
    end;

    // The last child element; missing when there is none
    const method LastElement(): Xml;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      return self.DoView(xmlLastElementChild(self.Node));
    end;

    // The document's root element, from any node of it
    const method Root(): Xml;
    begin
      if self.Tree = nil then
        return self.DoView(nil);
      end;
      return self.DoView(xmlDocGetRootElement(self.Tree.Doc));
    end;

    // How many child nodes the node has
    const method ChildCount(): int64;
    var
      LCount: int64;
      LChild: ptr to xmlNode;
    begin
      LCount := 0;
      if self.Node <> nil then
        LChild := self.Node^.children;
        while LChild <> nil do
          LCount := LCount + 1;
          LChild := LChild^.next;
        end;
      end;
      return LCount;
    end;

    // How many child elements the node has
    const method ElementCount(): int64;
    begin
      if self.Node = nil then
        return 0;
      end;
      return int64(xmlChildElementCount(self.Node));
    end;

    // The first child element named AName (prefix:local as written); missing when none is
    const method FindChild(const AName: string): Xml;
    var
      LChild: ptr to xmlNode;
    begin
      if self.Node = nil then
        return self.DoView(nil);
      end;
      LChild := self.Node^.children;
      while LChild <> nil do
        if DoIsNamed(LChild, AName) then
          return self.DoView(LChild);
        end;
        LChild := LChild^.next;
      end;
      return self.DoView(nil);
    end;

    // Every child node, in document order
    const method Children(): sequence of Xml;
    var
      LChild: ptr to xmlNode;
    begin
      if self.Node = nil then
        return;
      end;
      LChild := self.Node^.children;
      while LChild <> nil do
        yield self.DoView(LChild);
        LChild := LChild^.next;
      end;
    end;

    // Every child element, in document order
    const method Elements(): sequence of Xml;
    var
      LChild: ptr to xmlNode;
    begin
      if self.Node = nil then
        return;
      end;
      LChild := self.Node^.children;
      while LChild <> nil do
        if DoIsElement(LChild) then
          yield self.DoView(LChild);
        end;
        LChild := LChild^.next;
      end;
    end;

    // Every child element named AName (prefix:local as written), in document order
    const method Elements(const AName: string): sequence of Xml;
    var
      LChild: ptr to xmlNode;
    begin
      if self.Node = nil then
        return;
      end;
      LChild := self.Node^.children;
      while LChild <> nil do
        if DoIsNamed(LChild, AName) then
          yield self.DoView(LChild);
        end;
        LChild := LChild^.next;
      end;
    end;

    // Every element below the node named AName (prefix:local as written), the node itself
    // not included, in document order
    const method FindAll(const AName: string): sequence of Xml;
    var
      LNode: ptr to xmlNode;
      LClimbing: bool;
    begin
      if self.Node = nil then
        return;
      end;
      // A walk without recursion: down into an element's children, else on to the next
      // sibling, climbing back up while a level is done; only elements are entered (an
      // entity reference's children are its declaration's, not this tree's)
      LNode := self.Node^.children;
      while LNode <> nil do
        if DoIsNamed(LNode, AName) then
          yield self.DoView(LNode);
        end;
        if DoIsElement(LNode) and (LNode^.children <> nil) then
          LNode := LNode^.children;
        else
          LClimbing := true;
          while LClimbing do
            if LNode^.next <> nil then
              LNode := LNode^.next;
              LClimbing := false;
            else
              LNode := LNode^.parent_;
              if LNode = self.Node then
                return;
              end;
            end;
          end;
        end;
      end;
    end;

    // -- XPath 1.0 (this node the context node; see the header and XmlPath)

    // APath run from this node: libxml2's result, the caller's to free; nil for a missing
    // value or a namespace node (no context node), or a run that failed
    hidden const method DoEvaluate(const APath: XmlPath): ptr to xmlXPathObject;
    begin
      if self.Node = nil then
        return nil;
      end;
      return APath.EvaluateAt(self.Tree.Doc, self.Node);
    end;

    // A view of the node-set item AItem: a namespace node as the document's own declaration
    // of it (the item is a copy freed with the result; its next field is its element), any
    // other node as itself; a missing value when the declaration is not found
    hidden const method DoItem(const AItem: ptr to xmlNode): Xml;
    var
      LCopy: ptr to xmlNs;
      LOwner: ptr to xmlNode;
      LNs: ptr to xmlNs;
    begin
      if AItem^.type_ <> XML_NAMESPACE_DECL then
        return self.DoView(AItem);
      end;
      LCopy := ptr to xmlNs(ptr(AItem));
      LOwner := ptr to xmlNode(ptr(LCopy^.next));
      LNs := xmlSearchNs(self.Tree.Doc, LOwner, LCopy^.prefix);
      if LNs = nil then
        return self.DoView(nil);
      end;
      return self.DoViewNs(LNs, LOwner);
    end;

    /// Every node the XPath expression APath selects from this node, in document order
    /// (elements, attributes, texts, namespace nodes ...).
    /// @param APath the compiled expression (its ErrorText says why a run failed)
    /// @returns the nodes as a `for .. in` sequence; empty for a missing value, an
    ///   expression that failed, or one whose result is no node-set (count(..), a string)
    /// @example `for LItem in LShop.Select(LItems) do println(LItem.Get("name")); end;`
    const method Select(const APath: XmlPath): sequence of Xml;
    var
      LResult: ptr to xmlXPathObject;
      LFound: array of Xml;
      LCount: int64;
      LI: int64;
    begin
      LResult := self.DoEvaluate(APath);
      if LResult = nil then
        return;
      end;
      // The views made before anything is yielded: the result (and its namespace copies)
      // is freed at once, so a sequence left early holds nothing of libxml2's
      if (LResult^.type_ = XPATH_NODESET) and (LResult^.nodesetval <> nil) then
        LCount := int64(LResult^.nodesetval^.nodeNr);
        setlength(LFound, LCount);
        for LI := 0 to LCount - 1 do
          LFound[LI] := self.DoItem(LResult^.nodesetval^.nodeTab[LI]);
        end;
      end;
      xmlXPathFreeObject(LResult);
      for LI := 0 to len(LFound) - 1 do
        if not LFound[LI].IsNull() then
          yield LFound[LI];
        end;
      end;
    end;

    /// Every node the XPath expression AExpression selects from this node (compiled for
    /// this call; XmlPath.Compile once for a run repeated).
    /// @param AExpression the expression ("item[@price > 10]", "//p:title", "@*" ...)
    /// @returns the nodes as a `for .. in` sequence; empty for a missing value, an
    ///   expression that does not compile or fails, or a result that is no node-set
    /// @example `for LLayer in LMap.Select("layer[@visible != 0]") do println(LLayer.Get("name")); end;`
    const method Select(const AExpression: string): sequence of Xml;
    begin
      yield from self.Select(XmlPath.Compile(AExpression));
    end;

    /// The first node, in document order, the XPath expression APath selects from this node.
    /// @param APath the compiled expression
    /// @returns the node; a missing value when it selects none, fails, or gives no node-set
    /// @example `LTitle := LBook.SelectFirst(LTitlePath);`
    const method SelectFirst(const APath: XmlPath): Xml;
    var
      LResult: ptr to xmlXPathObject;
      LFirst: Xml;
    begin
      LResult := self.DoEvaluate(APath);
      if LResult = nil then
        return LFirst;
      end;
      if (LResult^.type_ = XPATH_NODESET) and (LResult^.nodesetval <> nil) and
        (LResult^.nodesetval^.nodeNr > 0) then
        LFirst := self.DoItem(LResult^.nodesetval^.nodeTab[0]);
      end;
      xmlXPathFreeObject(LResult);
      return LFirst;
    end;

    /// The first node, in document order, the XPath expression AExpression selects from
    /// this node.
    /// @param AExpression the expression
    /// @returns the node; a missing value when it selects none, does not compile, fails,
    ///   or gives no node-set
    /// @example `LWidth := LConfig.SelectFirst("window/@width").Text();`
    const method SelectFirst(const AExpression: string): Xml;
    begin
      return self.SelectFirst(XmlPath.Compile(AExpression));
    end;

    /// The XPath expression APath's result from this node as a string (XPath's string():
    /// a node-set's first node's text, a number as XPath writes it, true / false).
    /// @param APath the compiled expression
    /// @param ADefault what a missing value or a failed run gives
    /// @returns the result's string; ADefault on a failure
    /// @example `LName := LRoot.Evaluate(LNamePath, "unnamed");`
    const method Evaluate(const APath: XmlPath; const ADefault: string): string;
    var
      LResult: ptr to xmlXPathObject;
      LText: string;
    begin
      LResult := self.DoEvaluate(APath);
      if LResult = nil then
        return ADefault;
      end;
      LText := DoTakeText(xmlXPathCastToString(LResult));
      xmlXPathFreeObject(LResult);
      return LText;
    end;

    /// The XPath expression APath's result from this node as a string.
    /// @param APath the compiled expression
    /// @returns the result's string; "" on a failure
    /// @example `println(LRoot.Evaluate(LTitlePath));`
    const method Evaluate(const APath: XmlPath): string;
    begin
      return self.Evaluate(APath, "");
    end;

    /// The XPath expression APath's result from this node as a number (XPath's number()).
    /// @param APath the compiled expression
    /// @param ADefault what a failure or a NaN (a text that is no number) gives
    /// @returns the number (an infinity included); ADefault on a failure or a NaN
    /// @example `LTotal := LCart.Evaluate(LSumPath, 0.0);`
    const method Evaluate(const APath: XmlPath; const ADefault: float64): float64;
    var
      LResult: ptr to xmlXPathObject;
      LNumber: float64;
    begin
      LResult := self.DoEvaluate(APath);
      if LResult = nil then
        return ADefault;
      end;
      LNumber := xmlXPathCastToNumber(LResult);
      xmlXPathFreeObject(LResult);
      if xmlXPathIsNaN(LNumber) <> 0 then
        return ADefault;
      end;
      return LNumber;
    end;

    /// The XPath expression APath's result from this node as a whole number.
    /// @param APath the compiled expression
    /// @param ADefault what a failure, a NaN, an infinity, a fraction or a number outside
    ///   int64 gives
    /// @returns the number; ADefault when it does not fit
    /// @example `LCount := LShop.Evaluate(LCountPath, int64(0));`
    const method Evaluate(const APath: XmlPath; const ADefault: int64): int64;
    var
      LValue: int64;
    begin
      // 2^63 as the number form's default: a failure or a NaN gives it, and DoWhole refuses
      // it (outside int64), so every failure lands on ADefault
      if DoWhole(self.Evaluate(APath, ADAM_XML_INT64_BOUND), LValue) then
        return LValue;
      end;
      return ADefault;
    end;

    /// The XPath expression APath's result from this node as a whole number in int32.
    /// @param APath the compiled expression
    /// @param ADefault what a failure, a NaN, an infinity, a fraction or a number outside
    ///   int32 gives
    /// @returns the number; ADefault when it does not fit
    /// @example `LCount := LShop.Evaluate(LCountPath, 0);`
    const method Evaluate(const APath: XmlPath; const ADefault: int32): int32;
    var
      LValue: int64;
    begin
      if DoWhole(self.Evaluate(APath, ADAM_XML_INT64_BOUND), LValue) and
        (float64(LValue) >= -ADAM_XML_INT32_BOUND) and (float64(LValue) < ADAM_XML_INT32_BOUND) then
        return int32(LValue);
      end;
      return ADefault;
    end;

    /// The XPath expression APath's result from this node as a boolean (XPath's boolean():
    /// a node-set is true when not empty, a number when not 0 / NaN, a string when not "").
    /// @param APath the compiled expression
    /// @param ADefault what a failure gives
    /// @returns the boolean; ADefault on a failure
    /// @example `if LDoc.Evaluate(LHasErrors, false) then println("errors"); end;`
    const method Evaluate(const APath: XmlPath; const ADefault: bool): bool;
    var
      LResult: ptr to xmlXPathObject;
      LFlag: bool;
    begin
      LResult := self.DoEvaluate(APath);
      if LResult = nil then
        return ADefault;
      end;
      LFlag := xmlXPathCastToBoolean(LResult) <> 0;
      xmlXPathFreeObject(LResult);
      return LFlag;
    end;

    /// The XPath expression AExpression's result from this node as a string.
    /// @param AExpression the expression ("string(@id)", "concat(first, ' ', last)" ...)
    /// @returns the result's string; "" on a failure
    /// @example `println(LBook.Evaluate("normalize-space(title)"));`
    const method Evaluate(const AExpression: string): string;
    begin
      return self.Evaluate(XmlPath.Compile(AExpression), "");
    end;

    /// The XPath expression AExpression's result from this node as a string.
    /// @param AExpression the expression
    /// @param ADefault what a failure gives
    /// @returns the result's string; ADefault on a failure
    /// @example `LName := LRoot.Evaluate("string(@name)", "unnamed");`
    const method Evaluate(const AExpression: string; const ADefault: string): string;
    begin
      return self.Evaluate(XmlPath.Compile(AExpression), ADefault);
    end;

    /// The XPath expression AExpression's result from this node as a number.
    /// @param AExpression the expression ("sum(item/@price)" ...)
    /// @param ADefault what a failure or a NaN gives
    /// @returns the number; ADefault on a failure or a NaN
    /// @example `LTotal := LCart.Evaluate("sum(item/@price)", 0.0);`
    const method Evaluate(const AExpression: string; const ADefault: float64): float64;
    begin
      return self.Evaluate(XmlPath.Compile(AExpression), ADefault);
    end;

    /// The XPath expression AExpression's result from this node as a whole number.
    /// @param AExpression the expression ("count(item)" ...)
    /// @param ADefault what a failure or a number that is no int64 gives
    /// @returns the number; ADefault when it does not fit
    /// @example `LCount := LShop.Evaluate("count(item)", int64(0));`
    const method Evaluate(const AExpression: string; const ADefault: int64): int64;
    begin
      return self.Evaluate(XmlPath.Compile(AExpression), ADefault);
    end;

    /// The XPath expression AExpression's result from this node as a whole number in int32.
    /// @param AExpression the expression
    /// @param ADefault what a failure or a number that is no int32 gives
    /// @returns the number; ADefault when it does not fit
    /// @example `LCount := LShop.Evaluate("count(item)", 0);`
    const method Evaluate(const AExpression: string; const ADefault: int32): int32;
    begin
      return self.Evaluate(XmlPath.Compile(AExpression), ADefault);
    end;

    /// The XPath expression AExpression's result from this node as a boolean.
    /// @param AExpression the expression ("boolean(item[@sold])" ...)
    /// @param ADefault what a failure gives
    /// @returns the boolean; ADefault on a failure
    /// @example `if LShop.Evaluate("item[@price > 100]", false) then println("pricey"); end;`
    const method Evaluate(const AExpression: string; const ADefault: bool): bool;
    begin
      return self.Evaluate(XmlPath.Compile(AExpression), ADefault);
    end;

    // -- Validation (the whole document this value is in)

    /// Validates the document this value is in against its own DTD (its DOCTYPE's internal
    /// subset and the external one it names, read through C's file calls), listing every
    /// error and warning.
    /// @param AFindings every finding, in order ("no DTD found" when it declares none)
    /// @returns whether the document is valid
    /// @example `if not LDoc.Validate(LFindings) then println(LFindings[0].Message); end;`
    const method Validate(var AFindings: XmlFindings): bool;
    var
      LState: XmlValidState;
      LContext: ptr to xmlParserCtxt;
      LOk: bool;
    begin
      setlength(AFindings, 0);
      if self.Tree = nil then
        DoOneFinding(AFindings, ADAM_XML_MSG_NO_DOCUMENT);
        return false;
      end;
      LContext := xmlNewParserCtxt();
      if LContext = nil then
        DoOneFinding(AFindings, ADAM_XML_MSG_NO_ROOM);
        return false;
      end;
      xmlCtxtSetErrorHandler(LContext, DoOnFinding, ptr(addr of LState));
      xmlCtxtSetResourceLoader(LContext, DoLoadResource, nil);
      LOk := xmlCtxtValidateDocument(LContext, self.Tree.Doc) <> 0;
      xmlFreeParserCtxt(LContext);
      AFindings := LState.Findings;
      return LOk;
    end;

    /// Whether the document this value is in is valid against its own DTD.
    /// @returns false for a missing value, a document with no DTD, or one not valid
    /// @example `if LDoc.Validate() then println("valid"); end;`
    const method Validate(): bool;
    var
      LFindings: XmlFindings;
    begin
      return self.Validate(LFindings);
    end;

    /// Validates the document this value is in against ASchema, listing every error and
    /// warning.
    /// @param ASchema the schema (a DTD, an XSD or a RelaxNG one)
    /// @param AFindings every finding, in order (one when the schema did not compile)
    /// @returns whether the document is valid
    /// @example `if not LOrder.Validate(LSchema, LFindings) then println(LFindings[0].Line); end;`
    const method Validate(const ASchema: XmlSchema; var AFindings: XmlFindings): bool;
    begin
      if self.Tree = nil then
        setlength(AFindings, 0);
        DoOneFinding(AFindings, ADAM_XML_MSG_NO_DOCUMENT);
        return false;
      end;
      return ASchema.ValidateAt(self.Tree.Doc, AFindings);
    end;

    /// Whether the document this value is in is valid against ASchema.
    /// @param ASchema the schema
    /// @returns false for a missing value, a schema that did not compile, or a document
    ///   not valid
    /// @example `if LOrder.Validate(LSchema) then println("valid"); end;`
    const method Validate(const ASchema: XmlSchema): bool;
    var
      LFindings: XmlFindings;
    begin
      return self.Validate(ASchema, LFindings);
    end;

    // -- Building (a change returns the value it was called on, so calls chain; one that
    //    does not fit changes nothing)

    // This element's new last child ANode (nil: nothing); freed when libxml2 refuses it
    hidden method DoAppend(const ANode: ptr to xmlNode);
    begin
      if ANode = nil then
        return;
      end;
      if xmlAddChild(self.Node, ANode) = nil then
        xmlFreeNode(ANode);
      end;
    end;

    /// A new document whose root element is AName, in no namespace.
    /// @param AName the root element's name ("local"; a "prefix:local" one needs the
    ///   namespace URI form)
    /// @returns the root element; a missing value with its ErrorText when AName is no XML
    ///   name
    /// @example `LConfig := Xml.New("config").SetAttribute("version", 2);`
    /// @see Xml.SaveToFile
    static method New(const AName: string): Xml;
    begin
      return Xml.New(AName, "");
    end;

    /// A new document whose root element AName is in the namespace ANamespaceUri: a
    /// "prefix:local" name declares the prefix for it, a bare "local" makes it the default
    /// namespace (inherited by the unprefixed elements added below).
    /// @param AName the root element's name, "local" or "prefix:local"
    /// @param ANamespaceUri the namespace URI ("" for none, then AName takes no prefix)
    /// @returns the root element; a missing value with its ErrorText ("<new>: ...") when
    ///   AName is no XML name or names a prefix with no URI
    /// @example `LSvg := Xml.New("svg", "http://www.w3.org/2000/svg");`
    static method New(const AName: string; const ANamespaceUri: string): Xml;
    var
      LXml: Xml;
      LPrefix: string;
      LLocal: string;
      LDoc: ptr to xmlDoc;
      LRoot: ptr to xmlNode;
      LText: ptr to xmlChar;
      LUri: ptr to xmlChar;
    begin
      DoSplitName(AName, LPrefix, LLocal);
      if (not DoIsNCName(LLocal)) or ((len(LPrefix) > 0) and (not DoIsNCName(LPrefix))) then
        LXml.DoFail(ADAM_XML_NEW_NAME + ": " + ADAM_XML_MSG_BAD_NAME + AName);
        return LXml;
      end;
      if (len(LPrefix) > 0) and (len(ANamespaceUri) = 0) then
        LXml.DoFail(ADAM_XML_NEW_NAME + ": " + ADAM_XML_MSG_NO_NAMESPACE + LPrefix);
        return LXml;
      end;
      LDoc := xmlNewDoc(ADAM_XML_VERSION);
      if LDoc = nil then
        LXml.DoFail(ADAM_XML_NEW_NAME + ": " + ADAM_XML_MSG_NO_ROOM);
        return LXml;
      end;
      LText := DoNewText(LLocal);
      LRoot := xmlNewDocNode(LDoc, nil, LText, nil);
      DoFreeText(LText);
      if LRoot = nil then
        xmlFreeDoc(LDoc);
        LXml.DoFail(ADAM_XML_NEW_NAME + ": " + ADAM_XML_MSG_NO_ROOM);
        return LXml;
      end;
      xmlDocSetRootElement(LDoc, LRoot);
      if len(ANamespaceUri) > 0 then
        LUri := DoNewText(ANamespaceUri);
        LText := nil;
        if len(LPrefix) > 0 then
          LText := DoNewText(LPrefix);
        end;
        xmlSetNs(LRoot, xmlNewNs(LRoot, LUri, LText));
        DoFreeText(LText);
        DoFreeText(LUri);
      end;
      LXml.DoTake(LDoc, ADAM_XML_NEW_NAME);
      return LXml;
    end;

    /// Declares the namespace ANamespaceUri on this element under APrefix, for it and
    /// everything below to name by "prefix:local"; APrefix "" declares the default
    /// namespace, which this element (when unprefixed and in none) and the unprefixed
    /// elements added below then are in.
    /// @param APrefix the prefix ("" for the default namespace)
    /// @param ANamespaceUri the namespace URI
    /// @returns this value; nothing changes when it is no element, APrefix is no XML name
    ///   or already declared here, or ANamespaceUri is ""
    /// @example `LRoot.DeclareNamespace("xlink", "http://www.w3.org/1999/xlink");`
    method DeclareNamespace(const APrefix: string; const ANamespaceUri: string): Xml;
    var
      LUri: ptr to xmlChar;
      LPrefix: ptr to xmlChar;
      LNs: ptr to xmlNs;
    begin
      if DoIsElement(self.Node) and (len(ANamespaceUri) > 0) and
        ((len(APrefix) = 0) or DoIsNCName(APrefix)) then
        LUri := DoNewText(ANamespaceUri);
        LPrefix := nil;
        if len(APrefix) > 0 then
          LPrefix := DoNewText(APrefix);
        end;
        LNs := xmlNewNs(self.Node, LUri, LPrefix);
        DoFreeText(LPrefix);
        DoFreeText(LUri);
        // An unprefixed element in no namespace is in the default one declared on it
        if (LNs <> nil) and (len(APrefix) = 0) and (self.Node^.ns = nil) then
          xmlSetNs(self.Node, LNs);
        end;
      end;
      return self;
    end;

    /// Appends a new element AName as this element's last child.
    /// @param AName "local" (in the default namespace in scope) or "prefix:local" (a prefix
    ///   declared here or above)
    /// @returns the new element; a missing value when this is no element, AName is no XML
    ///   name or its prefix is not declared
    /// @example `LItem := LList.AddElement("item").SetAttribute("id", 1);`
    method AddElement(const AName: string): Xml;
    var
      LLocal: string;
      LNs: ptr to xmlNs;
      LText: ptr to xmlChar;
      LNode: ptr to xmlNode;
    begin
      if not DoIsElement(self.Node) then
        return self.DoView(nil);
      end;
      if not DoResolveName(self.Tree.Doc, self.Node, AName, true, LLocal, LNs) then
        return self.DoView(nil);
      end;
      LText := DoNewText(LLocal);
      LNode := xmlNewChild(self.Node, LNs, LText, nil);
      DoFreeText(LText);
      return self.DoView(LNode);
    end;

    /// Appends a new element AName holding the text AText as this element's last child.
    /// @param AName as AddElement takes it
    /// @param AText the new element's text (written escaped)
    /// @returns the new element (a missing value as AddElement's)
    /// @example `LBook.AddElement("title", "Dune");`
    method AddElement(const AName: string; const AText: string): Xml;
    var
      LChild: Xml;
    begin
      LChild := self.AddElement(AName);
      LChild.AddText(AText);
      return LChild;
    end;

    /// Appends the text AText to this element (beside a text before it, it joins it).
    /// @param AText the text, as is (written escaped: & < > as entities)
    /// @returns this value; nothing changes when it is no element or AText is ""
    /// @example `LNote.AddText("a & b");`
    method AddText(const AText: string): Xml;
    begin
      if DoIsElement(self.Node) and (len(AText) > 0) and (len(AText) <= ADAM_XML_INT32_MAX) then
        self.DoAppend(xmlNewDocTextLen(self.Tree.Doc, ptr to const xmlChar(DoChars(AText)),
          int32(len(AText))));
      end;
      return self;
    end;

    /// Replaces this element's children with the one text AText (none for "").
    /// @param AText the new text (written escaped)
    /// @returns this value; nothing changes when it is no element
    /// @example `LTitle.SetText("Dune Messiah");`
    method SetText(const AText: string): Xml;
    begin
      if not DoIsElement(self.Node) then
        return self;
      end;
      // The children are detached, not freed: a view of one stays good
      while self.Node^.children <> nil do
        self.Tree.Detach(self.Node^.children);
      end;
      return self.AddText(AText);
    end;

    /// Appends the comment AText (written <!--AText-->) to this element.
    /// @param AText the comment's text
    /// @returns this value; nothing changes when it is no element or AText holds "--" or
    ///   ends in "-" (no well-formed comment can)
    /// @example `LRoot.AddComment(" generated ");`
    method AddComment(const AText: string): Xml;
    var
      LText: ptr to xmlChar;
    begin
      if DoIsElement(self.Node) and (IndexOf(ADAM_XML_COMMENT_END, AText, 0) < 0) and
        ((len(AText) = 0) or (AText[len(AText) - 1] <> '-')) then
        LText := DoNewText(AText);
        if LText <> nil then
          self.DoAppend(xmlNewDocComment(self.Tree.Doc, LText));
          DoFreeText(LText);
        end;
      end;
      return self;
    end;

    /// Appends the CDATA section AText (written <![CDATA[AText]]>, its text as is) to this
    /// element.
    /// @param AText the section's text
    /// @returns this value; nothing changes when it is no element or AText holds "]]>"
    /// @example `LScript.AddCData("if (a < b) run();");`
    method AddCData(const AText: string): Xml;
    begin
      if DoIsElement(self.Node) and (IndexOf(ADAM_XML_CDATA_END, AText, 0) < 0) and
        (len(AText) <= ADAM_XML_INT32_MAX) then
        self.DoAppend(xmlNewCDataBlock(self.Tree.Doc, ptr to const xmlChar(DoChars(AText)),
          int32(len(AText))));
      end;
      return self;
    end;

    /// Sets the attribute AName of this element to AValue (added, or its value replaced).
    /// @param AName "local" (in no namespace) or "prefix:local" (a prefix declared here or
    ///   above); "xmlns" is DeclareNamespace's
    /// @param AValue the value (written escaped)
    /// @returns this value; nothing changes when it is no element, AName is no XML name or
    ///   its prefix is not declared
    /// @example `LItem.SetAttribute("name", "Ada").SetAttribute("age", 36);`
    method SetAttribute(const AName: string; const AValue: string): Xml;
    var
      LLocal: string;
      LNs: ptr to xmlNs;
      LName: ptr to xmlChar;
      LValue: ptr to xmlChar;
    begin
      if (not DoIsElement(self.Node)) or (AName = ADAM_XML_XMLNS) then
        return self;
      end;
      if not DoResolveName(self.Tree.Doc, self.Node, AName, false, LLocal, LNs) then
        return self;
      end;
      LName := DoNewText(LLocal);
      LValue := DoNewText(AValue);
      if (LName <> nil) and (LValue <> nil) then
        xmlSetNsProp(self.Node, LNs, LName, LValue);
      end;
      DoFreeText(LValue);
      DoFreeText(LName);
      return self;
    end;

    /// Sets the attribute AName to the whole number AValue.
    /// @param AName as the string form takes it
    /// @param AValue the value
    /// @returns this value (unchanged as the string form's)
    /// @example `LMap.SetAttribute("width", int32(30));`
    method SetAttribute(const AName: string; const AValue: int32): Xml;
    begin
      return self.SetAttribute(AName, IntToStr(int64(AValue)));
    end;

    /// Sets the attribute AName to the whole number AValue.
    /// @param AName as the string form takes it
    /// @param AValue the value
    /// @returns this value (unchanged as the string form's)
    /// @example `LFile.SetAttribute("size", LSize);`
    method SetAttribute(const AName: string; const AValue: int64): Xml;
    begin
      return self.SetAttribute(AName, IntToStr(AValue));
    end;

    /// Sets the attribute AName to the number AValue.
    /// @param AName as the string form takes it
    /// @param AValue the value
    /// @returns this value (unchanged as the string form's)
    /// @example `LSound.SetAttribute("volume", 0.8);`
    method SetAttribute(const AName: string; const AValue: float64): Xml;
    begin
      return self.SetAttribute(AName, FloatToStr(AValue));
    end;

    /// Sets the attribute AName to AValue as "true" / "false".
    /// @param AName as the string form takes it
    /// @param AValue the value
    /// @returns this value (unchanged as the string form's)
    /// @example `LWindow.SetAttribute("fullscreen", false);`
    method SetAttribute(const AName: string; const AValue: bool): Xml;
    begin
      if AValue then
        return self.SetAttribute(AName, ADAM_XML_TRUE);
      end;
      return self.SetAttribute(AName, ADAM_XML_FALSE);
    end;

    /// Removes the attribute AName from this element.
    /// @param AName "local" or "prefix:local", as Get takes it
    /// @returns false when it has no such attribute
    /// @example `LItem.RemoveAttribute("draft");`
    method RemoveAttribute(const AName: string): bool;
    var
      LAttr: ptr to xmlAttr;
    begin
      LAttr := DoFindAttribute(self.Node, AName);
      if LAttr = nil then
        return false;
      end;
      return xmlRemoveProp(LAttr) = 0;
    end;

    /// Takes this node out of its document (with everything below it). The node is kept
    /// until the document goes, so this value and every other view of it stay readable.
    /// @returns false for a missing value or a node already taken out
    /// @example `LMap.FindChild("debug").Remove();`
    method Remove(): bool;
    begin
      if (self.Node = nil) or (self.Node^.parent_ = nil) then
        return false;
      end;
      self.Tree.Detach(self.Node);
      return true;
    end;

    // -- Writing

    // The node of an HTML document written as HTML (void elements as <br>, no XML
    // declaration), indented when APretty
    hidden const method DoDumpHtml(const APretty: bool): string;
    var
      LBuffer: ptr to xmlOutputBuffer;
      LSize: uint64;
      LResult: string;
    begin
      LBuffer := xmlAllocOutputBuffer(nil);
      if LBuffer = nil then
        return "";
      end;
      htmlNodeDumpFormatOutput(LBuffer, self.Tree.Doc, self.Node, nil, DoFormat(APretty));
      LSize := xmlOutputBufferGetSize(LBuffer);
      LResult := "";
      if LSize > 0 then
        LResult := StringFromC(ptr to const char(xmlOutputBufferGetContent(LBuffer)),
          int64(LSize));
      end;
      xmlOutputBufferClose(LBuffer);
      if self.Node^.type_ = XML_ATTRIBUTE_NODE then
        LResult := TrimLeft(LResult);
      end;
      return LResult;
    end;

    // The node's markup, indented when APretty; "" for a missing value
    hidden const method DoDump(const APretty: bool): string;
    var
      LBuffer: ptr to xmlBuffer;
      LLength: int32;
      LResult: string;
    begin
      if self.Node = nil then
        return "";
      end;
      if self.Tree.Doc^.type_ = XML_HTML_DOCUMENT_NODE then
        return self.DoDumpHtml(APretty);
      end;
      LBuffer := xmlBufferCreate();
      if LBuffer = nil then
        return "";
      end;
      xmlNodeDump(LBuffer, self.Tree.Doc, self.Node, 0, DoFormat(APretty));
      LLength := xmlBufferLength(LBuffer);
      LResult := "";
      if LLength > 0 then
        LResult := StringFromC(ptr to const char(xmlBufferContent(LBuffer)), int64(LLength));
      end;
      xmlBufferFree(LBuffer);
      // libxml2 writes an attribute as it sits in a start tag, after a space: its own
      // markup is name="value"
      if self.Node^.type_ = XML_ATTRIBUTE_NODE then
        LResult := TrimLeft(LResult);
      end;
      return LResult;
    end;

    /// The node's own markup, compact (no XML declaration; an element with everything
    /// below it; an attribute as name="value").
    /// @returns the markup; "" for a missing value or a namespace node (an XPath result
    ///   with no markup of its own: its Name and Text are the prefix and URI)
    /// @example `println(LItem.ToString());`
    const method ToString(): string;
    begin
      return self.DoDump(false);
    end;

    /// The node's own markup, an element per line, 2 spaces a level (an element holding
    /// text stays on its line).
    /// @returns the markup; "" for a missing value
    /// @example `println(LDoc.ToPrettyString());`
    const method ToPrettyString(): string;
    begin
      return self.DoDump(true);
    end;

    /// Writes the whole document this value is in to the file at APath, pretty, in UTF-8,
    /// through C's file calls (a HookIO path writes its IO).
    /// @param APath the file (an Adam $ path resolved, any other as written)
    /// @returns false for a missing value or when it cannot be written
    /// @example `LConfig.SaveToFile("$D:config.xml");`
    const method SaveToFile(const APath: string): bool;
    begin
      return self.SaveToFile(APath, true, ADAM_XML_UTF8);
    end;

    /// SaveToFile, pretty when APretty, else compact.
    /// @param APath the file
    /// @param APretty whether a line per element
    /// @returns false for a missing value or when it cannot be written
    /// @example `LDoc.SaveToFile("out.xml", false);`
    const method SaveToFile(const APath: string; const APretty: bool): bool;
    begin
      return self.SaveToFile(APath, APretty, ADAM_XML_UTF8);
    end;

    /// SaveToFile in the encoding AEncoding (declared in the XML declaration; an HTML
    /// document, Xml.FromHtml*, is written as HTML, the encoding in its meta charset).
    /// @param APath the file
    /// @param APretty whether a line per element
    /// @param AEncoding libxml2's name for it ("UTF-8", "UTF-16", "ISO-8859-1" ...)
    /// @returns false for a missing value, an encoding libxml2 lacks, or when it cannot be
    ///   written
    /// @example `LDoc.SaveToFile("latin1.xml", true, "ISO-8859-1");`
    const method SaveToFile(const APath: string; const APretty: bool; const AEncoding: string): bool;
    var
      LPath: ptr to char;
      LEncoding: ptr to char;
      LOk: bool;
    begin
      if self.Tree = nil then
        return false;
      end;
      LPath := DoFilePath(APath);
      LEncoding := StringToC(AEncoding);
      LOk := (LPath <> nil) and (LEncoding <> nil);
      if LOk then
        // libxml2's xmlSave* forms always write XML: an HTML document goes through its
        // HTML saver
        if self.Tree.Doc^.type_ = XML_HTML_DOCUMENT_NODE then
          LOk := htmlSaveFileFormat(LPath, self.Tree.Doc, LEncoding, DoFormat(APretty)) >= 0;
        else
          LOk := xmlSaveFormatFileEnc(LPath, self.Tree.Doc, LEncoding, DoFormat(APretty)) >= 0;
        end;
      end;
      DoFreeChars(LEncoding);
      DoFreeChars(LPath);
      return LOk;
    end;

    /// Writes the whole document this value is in to the IO AIO at its place, pretty, in
    /// UTF-8, through libxml2's IO callbacks (no copy in a string).
    /// @param AIO the IO written (it stays the caller's, open)
    /// @returns false for a missing value or when not all of it could be written
    /// @example `LDoc.SaveToIO(LMemory);`
    const method SaveToIO(const AIO: IO): bool;
    begin
      return self.SaveToIO(AIO, true, ADAM_XML_UTF8);
    end;

    /// SaveToIO, pretty when APretty, else compact.
    /// @param AIO the IO written
    /// @param APretty whether a line per element
    /// @returns false for a missing value or when not all of it could be written
    /// @example `LDoc.SaveToIO(LMemory, false);`
    const method SaveToIO(const AIO: IO; const APretty: bool): bool;
    begin
      return self.SaveToIO(AIO, APretty, ADAM_XML_UTF8);
    end;

    /// SaveToIO in the encoding AEncoding (declared in the XML declaration; an HTML document
    /// is written as HTML, the encoding in its meta charset).
    /// @param AIO the IO written
    /// @param APretty whether a line per element
    /// @param AEncoding libxml2's name for it ("UTF-8", "UTF-16", "ISO-8859-1" ...)
    /// @returns false for a missing value, an encoding libxml2 lacks, or when not all of it
    ///   could be written
    /// @example `LDoc.SaveToIO(LMemory, true, "ISO-8859-1");`
    const method SaveToIO(const AIO: IO; const APretty: bool; const AEncoding: string): bool;
    var
      LEncoding: ptr to char;
      LEncoder: ptr to xmlCharEncodingHandler;
      LBuffer: ptr to xmlOutputBuffer;
      LOk: bool;
    begin
      if (self.Tree = nil) or (AIO = nil) then
        return false;
      end;
      LEncoding := StringToC(AEncoding);
      if LEncoding = nil then
        return false;
      end;
      LEncoder := nil;
      if not DoIsUtf8(AEncoding) then
        LEncoder := xmlFindCharEncodingHandler(LEncoding);
        if LEncoder = nil then
          DoFreeChars(LEncoding);
          return false;
        end;
      end;
      // The buffer owns the encoder; saving closes the buffer (the IO stays open)
      LBuffer := xmlOutputBufferCreateIO(DoIOWrite, DoIOClose, ptr(AIO), LEncoder);
      LOk := LBuffer <> nil;
      if LOk then
        // An HTML document through libxml2's HTML writer (xmlSave* always writes XML); that
        // writer leaves the buffer open, its close reports a failed write
        if self.Tree.Doc^.type_ = XML_HTML_DOCUMENT_NODE then
          htmlDocContentDumpFormatOutput(LBuffer, self.Tree.Doc, LEncoding, DoFormat(APretty));
          LOk := xmlOutputBufferClose(LBuffer) >= 0;
        else
          LOk := xmlSaveFormatFileTo(LBuffer, self.Tree.Doc, LEncoding, DoFormat(APretty)) >= 0;
        end;
      end;
      DoFreeChars(LEncoding);
      return LOk;
    end;
  end;

  // An attribute as Attributes gives it: its name as written and its value
  XmlAttribute = object
    Name: string;
    Value: string;
  end;

initialize
begin
  // Every libxml2 block on Adam's heap, set before libxml2 allocates anything
  xmlMemSetup(DoFree, DoMalloc, DoRealloc, DoStrdup);
  xmlInitParser();
end;

finalize
begin
  xmlCleanupParser();
end;

end.
