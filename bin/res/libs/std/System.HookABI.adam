-------------------------------------------------------------------------------
  System.HookABI.adam - link-time hooks of C functions (PaskalCPP's HookABI)

  A hook is a public routine with the hooked C function's name and C
  signature (a plain routine has C linkage; public gives it its plain C
  name), written anywhere in the program:

    public func fopen(const APath: ptr to const char;
      const AMode: ptr to const char): ptr;

  Its definition is in the final link, so it binds every reference to that
  name in the link: the program's own calls and the calls inside the static
  C libraries linked into it, their import slots included (`__imp_fopen`
  on x86_64-windows-gnu: Adam's linker makes such a slot the definition's
  own and loads no library member for it). No line beside the hook is
  needed. Code outside the final link (a DLL, the C runtime's own calls) is
  not hooked.

  Inside the hook, HookReal finds the real function (the definition the
  hook stands in for) once, into a slot the hook keeps (a module variable,
  nil at the start), and the hook calls it through its own routine type.

  HookReal(ASlot, AName) looks AName up in the C runtime (System.Runtime's
  FindCRuntimeFunction; x86_64-windows-gnu: ucrtbase.dll's export of that
  name, looked up there only). A MinGW name the C runtime exports under
  another (fseeko64 is ucrtbase's _fseeki64) is looked up by the export's
  name. HookReal(ASlot, ALibrary, AName) looks AName up in the library
  ALibrary (its UTF-8 file name) when the process has it loaded; it never
  loads one (System.Runtime's FindLoadedFunction).

  The slot is written when a lookup finds the function; while it is nil
  every call looks again. Two threads in their first call both look up the
  same function and store the same address (one aligned 8-byte store), so
  the slot never holds anything else.

  The run-time level: HookInstall writes a replacement into the import
  slot of a C name in every loaded module (x86_64-windows-gnu: the import
  address table entries, under VirtualProtect), records each slot and what
  it held, and HookUninstall writes exactly that back into every recorded
  slot whose module is still loaded. Modules loaded later are patched as
  they load (x86_64-windows-gnu: the loader's DLL notification, which sees
  every load); unloads drop their slots. Calls that do not go through an
  import slot (inside the defining module, a link-time hook's own symbol)
  are the link-time level's. A failure is false with C's errno set (read
  with HookErrno, its values ADAM_HOOK_*); the work is System.Runtime's
  InstallHook / UninstallHook.
*******************************************************************************/

module unit System.HookABI;

import System.Runtime;

// The C runtime's function AName (NUL-terminated), looked up the first time into ASlot (the
// hook's own pointer, nil until then); nil while the C runtime has no function of that name
public func HookReal(var ASlot: ptr; const AName: ptr to const char): ptr;
begin
  if ASlot = nil then
    ASlot := FindCRuntimeFunction(AName);
  end;
  return ASlot;
end;

// The function AName (NUL-terminated) of the library ALibrary (its NUL-terminated UTF-8 file
// name, "kernel32.dll"), looked up the first time into ASlot (nil until then) when the
// process has the library loaded (it is never loaded here); nil while it is not loaded or
// has no function of that name
public func HookReal(var ASlot: ptr; const ALibrary: ptr to const char;
  const AName: ptr to const char): ptr;
begin
  if ASlot = nil then
    ASlot := FindLoadedFunction(ALibrary, AName);
  end;
  return ASlot;
end;

public const
  // The failure a run-time hook reports in C's errno (read with HookErrno after HookInstall
  // / HookUninstall returned false), POSIX names: a name or argument refused, the name
  // already hooked, no module defines it, a slot not writable, out of memory
  ADAM_HOOK_EINVAL: int32 = ADAM_ERRNO_EINVAL;
  ADAM_HOOK_EEXIST: int32 = ADAM_ERRNO_EEXIST;
  ADAM_HOOK_ENOENT: int32 = ADAM_ERRNO_ENOENT;
  ADAM_HOOK_EACCES: int32 = ADAM_ERRNO_EACCES;
  ADAM_HOOK_ENOMEM: int32 = ADAM_ERRNO_ENOMEM;

// The calling thread's C errno after a HookInstall / HookUninstall that returned false (one
// of ADAM_HOOK_*; System.Runtime's CErrno)
public func HookErrno(): int32;
begin
  return CErrno();
end;

public type
  // A run-time hook, filled by HookInstall: while installed, every call of the hooked name
  // through a module's import slot reaches the replacement instead. A Hook variable starts
  // zeroed (not installed); keep it while installed. Original: the function the name's
  // slots reached before the install (the replacement calls it for the real work: calling
  // the name itself would reach the replacement again); it stays valid after HookUninstall
  // (a replacement still running on another thread may call it). State: the install's
  // record, nil when not installed.
  Hook = record
    Original: ptr;
    State: ptr;
  end;

// Installs a run-time hook: AName's (a NUL-terminated C name, as the modules import it)
// import slot in every module loaded now takes AReplacement (a routine of the same C
// signature, `ptr(F)`), and so does every module the program loads later. Code that calls
// AName directly, not through an import slot, is not reached. One install per name at a
// time; installs and uninstalls run one at a time. True when installed (AHook.Original and
// AHook.State set; a name no module imports yet is installed for the modules loaded later);
// false with C's errno (HookErrno): ADAM_HOOK_EINVAL (nil or empty AName, nil
// AReplacement), ADAM_HOOK_EEXIST (AHook is installed, or AName already is),
// ADAM_HOOK_ENOENT (no loaded module defines AName), ADAM_HOOK_EACCES (a slot could not be
// written: every slot written is put back), ADAM_HOOK_ENOMEM
public func HookInstall(var AHook: Hook; const AName: ptr to const char;
  const AReplacement: ptr): bool;
var
  LError: int32;
begin
  LError := InstallHook(AName, AReplacement, AHook.Original, AHook.State);
  if LError <> 0 then
    SetCErrno(LError);
    return false;
  end;
  return true;
end;

// Uninstalls a run-time hook: every slot it wrote whose module is still loaded gets back
// exactly what it held; nothing else is written. AHook.State becomes nil; AHook.Original
// stays. True when uninstalled; false with C's errno (HookErrno): ADAM_HOOK_EINVAL (AHook
// is not installed), ADAM_HOOK_EACCES (a slot could not be written back: the hook stays
// installed, the slots that went back stay back), ADAM_HOOK_ENOMEM
public func HookUninstall(var AHook: Hook): bool;
var
  LError: int32;
begin
  LError := UninstallHook(AHook.State);
  if LError <> 0 then
    SetCErrno(LError);
    return false;
  end;
  return true;
end;

end.
