  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.ResData.adam - the files a build added with @addresdata, read back
  by key (PaskalCPP's ResData, rewritten in Adam; BNF sec 2)

  `@addresdata "key" "path";` builds the file at path into the binary under
  key. FindResData(key) gives its bytes and their count (Data nil and Size 0
  for a key no directive adds), one zero byte after them (not counted), so
  a text reads as a C string and an empty file still has a Data.
  HasResData(key) says whether a key is there; ResDataCount() /
  ResDataKey(i) list the keys in byte-wise key order ('' outside
  0 .. ResDataCount() - 1). A key is looked up by its bytes, exact case.

  The compiler writes the table and the program's start hands it to the
  runtime (System.Runtime's ResDataList), so every binary reads its own
  keys. A lib shares its host's runtime: each lib's start adds its table
  beside the host's, and the keys of every table are read as one set (a key
  two tables hold is the one of the last started, the host's before a lib's,
  and is listed once). A string literal key no directive of the build adds
  is warned about at the call (SM0122). Target-neutral: no OS is named.

  Keys starting with ADAM_RESDATA_COMPILER_PREFIX are the compiler's own (no
  @addresdata may add one, SM0120): ADAM_RESDATA_EXEICON_KEY is @exeicon's
  icon on a target whose executable carries none itself (BNF sec 2), its
  largest image as the compiler decoded it: width and height (uint32 LE
  each, ADAM_RESDATA_EXEICON_HEADER bytes), then RGBA rows top down.
*******************************************************************************/

module unit System.ResData;

public type
  // A key's bytes: Data its first byte (nil when the key is missing), Size their count;
  // Data[Size] is a zero byte
  ResDataEntry = record
    Data: ptr to const uint8;
    Size: int64;
  end;

public const
  // The compiler's own keys (see the header): their prefix, @exeicon's entry and the bytes
  // before its pixels
  ADAM_RESDATA_COMPILER_PREFIX: string = "adam/";
  ADAM_RESDATA_EXEICON_KEY: string = "adam/exeicon";
  ADAM_RESDATA_EXEICON_HEADER: int64 = 8;

const
  // The table's layout (Lowering's DoResDataTable): the count, then per key three words
  ADAM_RESDATA_HEADER: int64 = 8;
  ADAM_RESDATA_RECORD: int64 = 24;
  ADAM_RESDATA_KEY_AT: int64 = 0;
  ADAM_RESDATA_DATA_AT: int64 = 8;
  ADAM_RESDATA_SIZE_AT: int64 = 16;
  // A node of the runtime's list (System.Runtime's ResDataList): the next node, its table
  ADAM_RESDATA_NODE_NEXT: int64 = 0;
  ADAM_RESDATA_NODE_TABLE: int64 = 8;

// The little-endian 8-byte word at AAt of ATable
routine DoWord(const ATable: ptr to const uint8; const AAt: int64): uint64;
var
  LValue: uint64;
  LI: int64;
begin
  LValue := 0;
  for LI := 7 downto 0 do
    LValue := (LValue shl 8) | uint64(ATable[AAt + LI]);
  end;
  return LValue;
end;

// Every table of the program, the last started first (the runtime's list order)
routine DoTables(): array of ptr to const uint8;
var
  LTables: array of ptr to const uint8;
  LNode: ptr to const uint8;
  LCount: int64;
begin
  LCount := 0;
  LNode := ResDataList();
  while LNode <> nil do
    LCount := LCount + 1;
    LNode := ptr to const uint8(DoWord(LNode, ADAM_RESDATA_NODE_NEXT));
  end;
  setlength(LTables, LCount);
  LCount := 0;
  LNode := ResDataList();
  while LNode <> nil do
    LTables[LCount] := ptr to const uint8(DoWord(LNode, ADAM_RESDATA_NODE_TABLE));
    LCount := LCount + 1;
    LNode := ptr to const uint8(DoWord(LNode, ADAM_RESDATA_NODE_NEXT));
  end;
  return LTables;
end;

// How many keys the table ATable holds
routine DoCount(const ATable: ptr to const uint8): int64;
begin
  return int64(DoWord(ATable, 0));
end;

// The NUL-ended key text of record AIndex of ATable (the caller keeps AIndex in range)
routine DoKeyText(const ATable: ptr to const uint8; const AIndex: int64): ptr to const uint8;
begin
  return ptr to const uint8(DoWord(ATable,
    ADAM_RESDATA_HEADER + AIndex * ADAM_RESDATA_RECORD + ADAM_RESDATA_KEY_AT));
end;

// AKey against the NUL-ended text AText by unsigned bytes, a prefix first: below 0 when
// AKey is before it, 0 when equal, above 0 when after (the order the compiler sorted by)
routine DoCompare(const AKey: string; const AText: ptr to const uint8): int32;
var
  LI: int64;
begin
  LI := 0;
  while LI < len(AKey) do
    if AText[LI] = 0 then
      return 1;
    end;
    if uint8(AKey[LI]) <> AText[LI] then
      if uint8(AKey[LI]) < AText[LI] then
        return -1;
      end;
      return 1;
    end;
    LI := LI + 1;
  end;
  if AText[LI] = 0 then
    return 0;
  end;
  return -1;
end;

// The NUL-ended texts AFirst and ASecond by unsigned bytes, a prefix first: below 0 when
// AFirst is before ASecond, 0 when equal, above 0 when after
routine DoCompareTexts(const AFirst: ptr to const uint8; const ASecond: ptr to const uint8): int32;
var
  LI: int64;
begin
  LI := 0;
  while (AFirst[LI] = ASecond[LI]) and (AFirst[LI] <> 0) do
    LI := LI + 1;
  end;
  if AFirst[LI] = ASecond[LI] then
    return 0;
  end;
  if AFirst[LI] < ASecond[LI] then
    return -1;
  end;
  return 1;
end;

// The record of AKey in the table ATable (a binary search over its sorted keys); -1 when
// missing
routine DoFindIn(const ATable: ptr to const uint8; const AKey: string): int64;
var
  LLow: int64;
  LHigh: int64;
  LMiddle: int64;
  LOrder: int32;
begin
  LLow := 0;
  LHigh := DoCount(ATable) - 1;
  while LLow <= LHigh do
    LMiddle := LLow + (LHigh - LLow) div 2;
    LOrder := DoCompare(AKey, DoKeyText(ATable, LMiddle));
    if LOrder = 0 then
      return LMiddle;
    end;
    if LOrder < 0 then
      LHigh := LMiddle - 1;
    else
      LLow := LMiddle + 1;
    end;
  end;
  return -1;
end;

// The record of AKey in the first table that holds it (the last started first), that table
// in ATable; -1 (ATable nil) when no table holds it
routine DoFind(const AKey: string; var ATable: ptr to const uint8): int64;
var
  LNode: ptr to const uint8;
  LTable: ptr to const uint8;
  LIndex: int64;
begin
  ATable := nil;
  LNode := ResDataList();
  while LNode <> nil do
    LTable := ptr to const uint8(DoWord(LNode, ADAM_RESDATA_NODE_TABLE));
    LIndex := DoFindIn(LTable, AKey);
    if LIndex >= 0 then
      ATable := LTable;
      return LIndex;
    end;
    LNode := ptr to const uint8(DoWord(LNode, ADAM_RESDATA_NODE_NEXT));
  end;
  return -1;
end;

// The keys of every table walked as one set in byte-wise key order (a merge of the sorted
// tables: each step takes the least key the tables' cursors are at, the first table's on a
// tie, and moves every cursor at that key on, so a key two tables hold is one step). With
// AStop >= 0 the walk stops at step AStop, its table and record in ATable and ARecord, and
// answers AStop; else (or past the last key) it answers the count of distinct keys, ATable
// nil
routine DoMerge(const AStop: int64; var ATable: ptr to const uint8; var ARecord: int64): int64;
var
  LTables: array of ptr to const uint8;
  LCursors: array of int64;
  LLeast: int64;
  LText: ptr to const uint8;
  LSteps: int64;
  LI: int64;
begin
  ATable := nil;
  ARecord := -1;
  LTables := DoTables();
  setlength(LCursors, len(LTables));
  for LI := 0 to len(LTables) - 1 do
    LCursors[LI] := 0;
  end;
  LSteps := 0;
  while true do
    // The table whose cursor is at the least key (-1: every table walked)
    LLeast := -1;
    for LI := 0 to len(LTables) - 1 do
      if LCursors[LI] < DoCount(LTables[LI]) then
        if LLeast < 0 then
          LLeast := LI;
        else
          if DoCompareTexts(DoKeyText(LTables[LI], LCursors[LI]),
            DoKeyText(LTables[LLeast], LCursors[LLeast])) < 0 then
            LLeast := LI;
          end;
        end;
      end;
    end;
    if LLeast < 0 then
      return LSteps;
    end;
    if LSteps = AStop then
      ATable := LTables[LLeast];
      ARecord := LCursors[LLeast];
      return LSteps;
    end;
    // Every cursor at that key moves on (the least's last: its text is the one compared)
    LText := DoKeyText(LTables[LLeast], LCursors[LLeast]);
    for LI := 0 to len(LTables) - 1 do
      if (LI <> LLeast) and (LCursors[LI] < DoCount(LTables[LI])) and
        (DoCompareTexts(DoKeyText(LTables[LI], LCursors[LI]), LText) = 0) then
        LCursors[LI] := LCursors[LI] + 1;
      end;
    end;
    LCursors[LLeast] := LCursors[LLeast] + 1;
    LSteps := LSteps + 1;
  end;
end;

// How many keys this binary holds (a key two tables hold counted once)
public routine cpplink ResDataCount(): int64;
var
  LTable: ptr to const uint8;
  LRecord: int64;
begin
  return DoMerge(-1, LTable, LRecord);
end;

// The key AIndex in byte-wise key order; '' outside 0 .. ResDataCount() - 1
public routine cpplink ResDataKey(const AIndex: int64): string;
var
  LTable: ptr to const uint8;
  LRecord: int64;
  LText: ptr to const uint8;
  LKey: string;
  LCount: int64;
  LI: int64;
begin
  if AIndex < 0 then
    return "";
  end;
  DoMerge(AIndex, LTable, LRecord);
  if LTable = nil then
    return "";
  end;
  LText := DoKeyText(LTable, LRecord);
  LCount := 0;
  while LText[LCount] <> 0 do
    LCount := LCount + 1;
  end;
  setlength(LKey, LCount);
  for LI := 0 to LCount - 1 do
    LKey[LI] := char(LText[LI]);
  end;
  return LKey;
end;

// AKey's bytes and their count; Data nil and Size 0 when no @addresdata adds AKey
public routine cpplink FindResData(const AKey: string): ResDataEntry;
var
  LEntry: ResDataEntry;
  LTable: ptr to const uint8;
  LIndex: int64;
  LAt: int64;
begin
  LEntry.Data := nil;
  LEntry.Size := 0;
  LIndex := DoFind(AKey, LTable);
  if LIndex >= 0 then
    LAt := ADAM_RESDATA_HEADER + LIndex * ADAM_RESDATA_RECORD;
    LEntry.Data := ptr to const uint8(DoWord(LTable, LAt + ADAM_RESDATA_DATA_AT));
    LEntry.Size := int64(DoWord(LTable, LAt + ADAM_RESDATA_SIZE_AT));
  end;
  return LEntry;
end;

// True when an @addresdata adds AKey to this binary
public routine cpplink HasResData(const AKey: string): bool;
var
  LTable: ptr to const uint8;
begin
  return DoFind(AKey, LTable) >= 0;
end;

end.
