public routine deflateInit(const strm: z_streamp; const level: int32): int32;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return deflateInit_(strm, level, "1.4", int32(uint64(size(z_stream))));
@elseif TARGET_X86_64_LINUX_GNU
  return deflateInit_(strm, level, "1.4", int32(culong(size(z_stream))));
@endif
end;

public routine inflateInit(const strm: z_streamp): int32;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return inflateInit_(strm, "1.4", int32(uint64(size(z_stream))));
@elseif TARGET_X86_64_LINUX_GNU
  return inflateInit_(strm, "1.4", int32(culong(size(z_stream))));
@endif
end;

public routine deflateInit2(const strm: z_streamp; const level: int32; const method_: int32;
  const windowBits: int32; const memLevel: int32; const strategy: int32): int32;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  return deflateInit2_(strm, level, method_, windowBits, memLevel, strategy, "1.4", int32(uint64(size(z_stream))));
@elseif TARGET_X86_64_LINUX_GNU
  return deflateInit2_(strm, level, method_, windowBits, memLevel, strategy, "1.4", int32(culong(size(z_stream))));
@endif
end;

