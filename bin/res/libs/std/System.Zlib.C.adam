  alloc_func = routine clink(opaque: voidpf; items: uInt; size: uInt): voidpf;
  free_func = routine clink(opaque: voidpf; address: voidpf);

  internal_state = record
  end;

  z_stream_s = record
    next_in: ptr to const Bytef;
    avail_in: uInt;
    total_in: uLong;
    next_out: ptr to Bytef;
    avail_out: uInt;
    total_out: uLong;
    msg: ptr to const char;
    state: ptr to internal_state;
    zalloc: alloc_func;
    zfree: free_func;
    opaque: voidpf;
    data_type: int32;
    adler: uLong;
    reserved: uLong;
  end;

  z_stream = z_stream_s;
  z_streamp = ptr to z_stream;

  gz_header_s = record
    text: int32;
    time: uLong;
    xflags: int32;
    os: int32;
    extra: ptr to Bytef;
    extra_len: uInt;
    extra_max: uInt;
    name: ptr to Bytef;
    name_max: uInt;
    comment: ptr to Bytef;
    comm_max: uInt;
    hcrc: int32;
    done: int32;
  end;

  gz_header = gz_header_s;
  gz_headerp = ptr to gz_header;

  in_func = routine clink(p1: ptr; p2: ptr to ptr to const uint8): uint32;
  out_func = routine clink(p1: ptr; p2: ptr to uint8; p3: uint32): int32;

  gzFile = ptr to gzFile_s;

  gzFile_s = record
    have: uint32;
    next: ptr to uint8;
@ifdef TARGET_X86_64_WINDOWS_GNU
    pos: int64;
@elseif TARGET_X86_64_LINUX_GNU
    pos: clong;
@endif
  end;

