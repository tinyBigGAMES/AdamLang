-------------------------------------------------------------------------------
  System.Zlib.C.adam - the part of zlib's C API (Jean-loup Gailly and Mark
  Adler, zlib license) that Adam uses, translated by hand from zlib.h /
  zconf.h (tag v1.4) with the header's own names, as M9's importer will
  write them when it regenerates this file: z_stream laid out as C lays it
  out, the stream routines (deflate / inflate and their setup), the
  checksums and the one-shot buffers as `external "zlib"` (libzlib.a in
  res/libs/vendor/<triple>, built by AdamLang-Libs). System.Zlib is the
  Adam API over it.

  The header's types: `int` int32, uInt (`unsigned int`) uint32, uLong
  (`unsigned long`) culong (4 bytes on win64, 8 on linux64: the target
  sizes it), Bytef uint8, z_crc_t uint32 (Z_U4), voidpf / `void *` ptr;
  z_const is read as `const` (the header's ZLIB_CONST reading; no layout
  changes). deflateInit2 / inflateInit2 are macros over deflateInit2_ /
  inflateInit2_, which take the version the caller was written for
  (ZLIB_VERSION) and sizeof(z_stream): zlib refuses a stream of another
  layout (Z_VERSION_ERROR). A C name that is an Adam keyword takes a
  trailing '_' (the parameter `method` is method_). Target-neutral: no OS
  named.
*******************************************************************************/

module unit System.Zlib.C;

public const
  ZLIB_VERSION: string = "1.4";
  // Allowed flush values
  Z_NO_FLUSH: int32 = 0;
  Z_SYNC_FLUSH: int32 = 2;
  Z_FINISH: int32 = 4;
  Z_BLOCK: int32 = 5;
  // Return codes: >= 0 normal events, < 0 errors
  Z_OK: int32 = 0;
  Z_STREAM_END: int32 = 1;
  Z_NEED_DICT: int32 = 2;
  Z_ERRNO: int32 = -1;
  Z_STREAM_ERROR: int32 = -2;
  Z_DATA_ERROR: int32 = -3;
  Z_MEM_ERROR: int32 = -4;
  Z_BUF_ERROR: int32 = -5;
  Z_VERSION_ERROR: int32 = -6;
  // Compression levels
  Z_BEST_SPEED: int32 = 1;
  Z_BEST_COMPRESSION: int32 = 9;
  Z_DEFAULT_COMPRESSION: int32 = -1;
  // Compression strategy
  Z_DEFAULT_STRATEGY: int32 = 0;
  // The deflate compression method (the only one)
  Z_DEFLATED: int32 = 8;
  // zconf.h: the largest window, 32K
  MAX_WBITS: int32 = 15;

public type
  uInt = uint32;
  uLong = culong;
  uLongf = uLong;
  Bytef = uint8;
  voidpf = ptr;
  z_crc_t = uint32;

  alloc_func = routine clink(opaque: voidpf; items: uInt; size: uInt): voidpf;
  free_func = routine clink(opaque: voidpf; address: voidpf);

  // 88 bytes on win64 (uLong is 4), 112 on linux64
  z_stream = record
    next_in: ptr to const Bytef;
    avail_in: uInt;
    total_in: uLong;
    next_out: ptr to Bytef;
    avail_out: uInt;
    total_out: uLong;
    msg: ptr to const char;
    state: ptr;
    zalloc: alloc_func;
    zfree: free_func;
    opaque: voidpf;
    data_type: int32;
    adler: uLong;
    reserved: uLong;
  end;

  z_streamp = ptr to z_stream;

public routine clink zlibVersion(): ptr to const char; external "zlib";
public routine clink deflate(strm: z_streamp; flush: int32): int32; external "zlib";
public routine clink deflateEnd(strm: z_streamp): int32; external "zlib";
public routine clink inflate(strm: z_streamp; flush: int32): int32; external "zlib";
public routine clink inflateEnd(strm: z_streamp): int32; external "zlib";
public routine clink deflateBound(strm: z_streamp; sourceLen: uLong): uLong; external "zlib";
public routine clink inflateSetDictionary(strm: z_streamp; dictionary: ptr to const Bytef;
  dictLength: uInt): int32; external "zlib";
public routine clink inflateReset(strm: z_streamp): int32; external "zlib";
public routine clink inflatePrime(strm: z_streamp; bits: int32; value: int32): int32;
  external "zlib";
public routine clink compress2(dest: ptr to Bytef; destLen: ptr to uLongf;
  source: ptr to const Bytef; sourceLen: uLong; level: int32): int32; external "zlib";
public routine clink compressBound(sourceLen: uLong): uLong; external "zlib";
public routine clink uncompress(dest: ptr to Bytef; destLen: ptr to uLongf;
  source: ptr to const Bytef; sourceLen: uLong): int32; external "zlib";
public routine clink adler32(adler: uLong; buf: ptr to const Bytef; len: uInt): uLong;
  external "zlib";
public routine clink crc32(crc: uLong; buf: ptr to const Bytef; len: uInt): uLong;
  external "zlib";
public routine clink deflateInit2_(strm: z_streamp; level: int32; method_: int32;
  windowBits: int32; memLevel: int32; strategy: int32; version: ptr to const char;
  stream_size: int32): int32; external "zlib";
public routine clink inflateInit2_(strm: z_streamp; windowBits: int32; version: ptr to const char;
  stream_size: int32): int32; external "zlib";
public routine clink get_crc_table(): ptr to const z_crc_t; external "zlib";

end.
