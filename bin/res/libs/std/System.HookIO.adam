  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.HookIO.adam - C's file calls on Adam streams (PaskalCPP's HookIO)

  RegisterIO / RegisterIOSource put an IO or an IOSource (System.CustomIO)
  under a prefix, `io://<n>`. From then on fopen("io://<n>/<name>"), in the
  program or inside any C library linked into it, opens that IO (each open
  a handle of its own, with its own place, on the shared IO) or the
  source's entry <name> (the handle owns the entry's IO). The hooks are
  System.HookAbi's link-time kind: public routines of the C names, so they
  bind every reference in the final link, the runtime's own `external`
  fwrite (its printing) included. A FILE that is not a HookIO handle goes
  to the real function (HookReal, found once): real files and printing work
  as before.

  A handle is told by its address in the open list (a real FILE's bytes are
  never read: ucrt's FILE is opaque); while no handle is open a stream call
  on a real FILE takes no lock. The registry and the open list share one
  lock, never held while CustomIO runs. Every handle on one registered IO
  shares that IO's stream lock (they share its position); a source entry's
  handle has a lock of its own.

  Modes are read as ucrt's fopen reads them (r / w / a, then +, b / t,
  c / n, S / R, T, D, N, x with w, and a ccs= part); a mode it refuses is
  EINVAL. w empties the IO (a read-only IO: EACCES), x fails with EEXIST
  when the target exists, and D removes a source entry when its last D
  handle closes (ucrt's share rules: a D handle and a plain one on one
  entry refuse each other with EACCES). An unregistered prefix, a missing
  entry or a path the source refuses is ENOENT; an entry the source does
  not offer in the mode is EACCES. A ccs= open is EINVAL until the wide
  stream model is built.

  Every stream call on a handle (fread, fwrite, fgetc, fgets, ungetc,
  fputc, fputs, fseek, ftell, rewind, fflush, feof / ferror / clearerr and
  their _nolock forms) runs on a model of ucrt's own FILE: its buffer, its
  read / write / update flags and lowio's place, as ucrt's sources do it
  (fills, the direct path past a buffer's size, ungot bytes in the buffer,
  ftell's arithmetic, fseek's fast track, flush on a switch and at fclose),
  so a C library sees on a handle what ucrt gives on a real file of the
  same bytes. fflush(NULL) flushes every open handle too.
*******************************************************************************/

module unit System.HookIO;

import System.SysUtils, System.Runtime, System.HookAbi, System.CustomIO;

public const
  // C's EOF: what the hooked stream calls return on a failure or at the end
  ADAM_HOOKIO_EOF: int32 = -1;
  // C's fseek origins (SEEK_SET, SEEK_CUR, SEEK_END)
  ADAM_HOOKIO_SEEK_SET: int32 = 0;
  ADAM_HOOKIO_SEEK_CUR: int32 = 1;
  ADAM_HOOKIO_SEEK_END: int32 = 2;

const
  // The scheme every virtual path starts with, and its length
  ADAM_HOOKIO_SCHEME: string = "io://";
  ADAM_HOOKIO_SCHEME_LENGTH: int64 = 5;
  // The byte that ends a text-mode file on Windows (ucrt drops a trailing one at a "+" open)
  ADAM_HOOKIO_CTRL_Z: uint8 = 0x1A;
  // A text handle's line end on Windows: lowio writes each '\n' as "\r\n" and reads "\r\n" as
  // '\n'
  ADAM_HOOKIO_CR: uint8 = 13;
  ADAM_HOOKIO_LF: uint8 = 10;
  // ucrt's _O_BINARY (fcntl.h): _get_fmode's bit for a binary default
  ADAM_HOOKIO_O_BINARY: int32 = 0x8000;
  // The largest int64: the bytes of fread / fwrite are clamped there
  ADAM_HOOKIO_MAX_BYTES: int64 = 9223372036854775807;
  // The largest size_t (64 bits on every target Adam has): fread / fwrite's byte count past it
  // is refused
  ADAM_HOOKIO_MAX_SIZE: uint64 = 18446744073709551615u;
  // The smallest int64 (ucrt's fseek fast track checks its difference against both ends)
  ADAM_HOOKIO_MIN_BYTES: int64 = -9223372036854775807 - 1;
  // ucrt's stdio buffer sizes (corecrt_internal_lowio.h _INTERNAL_BUFSIZ, _SMALL_BUFSIZ): a
  // fill asks for the big size, the first fill after an fseek of a read-only stream the small
  ADAM_HOOKIO_BUFFER_SIZE: int64 = 4096;
  ADAM_HOOKIO_SMALL_BUFFER_SIZE: int64 = 512;
  // lowio's largest read (INT_MAX) and write (UINT_MAX - 1) at a time
  ADAM_HOOKIO_LOW_READ_MAX: int64 = 2147483647;
  ADAM_HOOKIO_LOW_WRITE_MAX: int64 = 4294967294;
  // The largest place ucrt's ftell gives in its long (LONG_MAX on Windows)
  ADAM_HOOKIO_LONG_MAX: int64 = 2147483647;
  // fputs's result on success (ucrt's)
  ADAM_HOOKIO_PUTS_OK: int32 = 0;
  // The byte fgets stops after
  ADAM_HOOKIO_NEWLINE: int32 = 10;

type
  // The lock every handle on one stream shares: a registered IO's (Listed: one per IO in
  // GStreamLocks however often the IO is registered) or a source entry's handle's own. Users:
  // the entries and handles that hold it; it goes with its last user
  HookStreamLock = record
    Stream: IO;
    Listed: bool;
    Users: int64;
    Lock: mutex;
  end;

  // A registered prefix: exactly one of Stream (RegisterIO, with its stream lock) and Source
  // (RegisterIOSource)
  HookEntry = record
    Id: uint64;
    Stream: IO;
    Source: IOSource;
    Lock: ptr to HookStreamLock;
  end;

  // How open handles use one source entry (ucrt's share rules for D): the plain and the D
  // handles, counted before the entry opens; Removing while its last D close removes it
  HookEntryUse = record
    Source: IOSource;
    EntryName: string;
    Plain: int64;
    Temporary: int64;
    Removing: bool;
  end;

  // What a mode string asks for, as ucrt's fopen reads it. First: 'r', 'w' or 'a'. Mode: r
  // Read, w Write, a Append, any with + ReadWrite (First then says whether the open empties,
  // w, or appends, a). Text: reads and writes translate. Exclusive: x. Temporary: D.
  // Encoded: a ccs= part, Encoding its name (1 UTF-8, 2 UTF-16LE, 3 UNICODE)
  HookOpenMode = record
    First: char;
    Mode: FileMode;
    Plus: bool;
    Text: bool;
    Exclusive: bool;
    Temporary: bool;
    Encoded: bool;
    Encoding: int32;
  end;

  // Who made a ucrt FILE's buffer (corecrt_internal_stdio.h): Crt is _IOBUFFER_CRT (the first
  // fill, ungetc or setvbuf with no array), User _IOBUFFER_USER (the caller's array, setvbuf /
  // setbuf), Single _IOBUFFER_NONE (setvbuf _IONBF: the FILE's own 2-byte _charbuf)
  HookCrtBufferKind = choices(Crt, User, Single);

  // A ucrt FILE's main buffer: memory the model made (Owned) or the caller's own array handed
  // to setvbuf / setbuf (Caller, never freed here), which the CRT fills itself, so the caller
  // sees the bytes there as a real FILE leaves them; Size bytes
  HookCrtBuffer = record
    Owned: array of uint8;
    Caller: ptr to uint8;
    Size: int64;
  end;

  // The state of a ucrt FILE (Windows Kits 10.0.26100 ucrt: stdio _filbuf.cpp, fread.cpp,
  // ftell.cpp, fseek.cpp, ungetc.cpp, fwrite.cpp, fputc.cpp, _flsbuf.cpp, fflush.cpp; lowio
  // read.cpp, write.cpp). The stdio side: Buffer holds the last fill; Next is the next byte in
  // it (_ptr - _base), Count the bytes left (_cnt), BufferSize the size the next fill asks for
  // (_bufsiz). While writing, [0, Next) are the bytes written and not yet flushed and Count is
  // the room left. HasBuffer: the buffer exists (any _IOBUFFER_* bit), Kind says who made it.
  // StreamRead / StreamWrite / StreamUpdate are _IOREAD / _IOWRITE / _IOUPDATE; StreamCtrlZ
  // is _IOCTRLZ (a fill of a read-only stream met a Ctrl-Z; cleared only by setvbuf);
  // SetvbufBuffer is _IOBUFFER_SETVBUF. The lowio side, over the handle's Position: LowEof is
  // FEOFLAG (a text read met a Ctrl-Z; lowio reads nothing until a seek clears it), LowCrlf is
  // FCRLF (the last text read began with a newline). A binary handle never sets either
  HookCrtModel = record
    Buffer: HookCrtBuffer;
    Next: int64;
    Count: int64;
    BufferSize: int64;
    HasBuffer: bool;
    Kind: HookCrtBufferKind;
    StreamRead: bool;
    StreamWrite: bool;
    StreamUpdate: bool;
    StreamCtrlZ: bool;
    SetvbufBuffer: bool;
    LowEof: bool;
    LowCrlf: bool;
  end;

  // An open handle, what a hooked open returns in place of a FILE*. Owned: the handle opened
  // Stream itself (a source entry) and closes it with the handle; else Stream is a registered
  // IO every handle on it shares. Position: the handle's place in Stream (lowio's descriptor
  // place). Appending: opened with a or a+ (every write lands at the IO's end). Lock: the
  // stream lock that guards every field and every call on Stream. AtEnd / Failed: feof /
  // ferror. Closed: fclose ran. Text: opened in text mode. Source / EntryName / Temporary: the
  // source entry the handle opened and whether with D (Source nil on a registered IO, and once
  // the use is given back). Users: the open list and every call that found the handle; the last
  // one frees it. Crt: the state of ucrt's own FILE, what every read, write, ungetc, ftell and
  // fseek runs on, so that a handle gives what ucrt gives on a real file of the same bytes
  HookHandle = record
    Stream: IO;
    Owned: bool;
    Position: int64;
    Mode: FileMode;
    Appending: bool;
    Lock: ptr to HookStreamLock;
    AtEnd: bool;
    Failed: bool;
    Closed: bool;
    Text: bool;
    Source: IOSource;
    EntryName: string;
    Temporary: bool;
    Users: int64;
    Crt: HookCrtModel;
  end;

  // The stream calls DoWith runs on a handle
  HookOp = choices(Read, Write, Get, Gets, Unget, Put, Puts, Seek, Tell, Rewind, AtEnd, Failed,
    ClearError, Flush, Fileno);

  // One stream call on a handle: its arguments (Buffer / Size: the bytes of a read, write,
  // fgets or fputs; ItemSize: fread / fwrite's element size, C's size_t in its bits; Offset /
  // Origin: fseek's; Value: the byte of fputc / ungetc; Refused: arguments ucrt refuses up
  // front, fread / fwrite's byte count past size_t: EINVAL) and its answer (Answer, set to the
  // call's failure value before DoWith runs it)
  HookCall = record
    Op: HookOp;
    Buffer: ptr to uint8;
    Size: int64;
    ItemSize: int64;
    Offset: int64;
    Origin: int32;
    Value: int32;
    Refused: bool;
    Answer: int64;
  end;

  // The real functions' types, called through HookReal's slots
  FopenFn = routine(const APath: ptr to const char; const AMode: ptr to const char): ptr;
  FopenSFn = routine(const AFile: ptr to ptr; const APath: ptr to const char;
    const AMode: ptr to const char): int32;
  WfopenFn = routine(const APath: ptr to const wchar; const AMode: ptr to const wchar): ptr;
  FcloseFn = routine(const AFile: ptr): int32;
  FreadFn = routine(const ABuffer: ptr; const ASize: int64; const ACount: int64;
    const AFile: ptr): int64;
  FwriteFn = routine(const ABuffer: ptr; const ASize: int64; const ACount: int64;
    const AFile: ptr): int64;
  GetFmodeFn = routine(const AMode: ptr to int32): int32;
  FileIntFn = routine(const AFile: ptr): int32;
  FileVoidFn = routine(const AFile: ptr);
  CharFileFn = routine(const AChar: int32; const AFile: ptr): int32;
  FgetsFn = routine(const AText: ptr to char; const ACount: int32; const AFile: ptr): ptr to char;
  FputsFn = routine(const AText: ptr to const char; const AFile: ptr): int32;
  FseekFn = routine(const AFile: ptr; const AOffset: clong; const AOrigin: int32): int32;
  Fseeki64Fn = routine(const AFile: ptr; const AOffset: int64; const AOrigin: int32): int32;
  FtellFn = routine(const AFile: ptr): clong;
  Ftelli64Fn = routine(const AFile: ptr): int64;

var
  // The registry lock: the entries, the stream locks, the open list and the entry uses. Never
  // held while CustomIO runs: a source that opens files comes back through these hooks
  GLock: mutex;
  GEntries: array of HookEntry;
  GStreamLocks: array of ptr to HookStreamLock;
  GHandles: array of ptr to HookHandle;
  GEntryUses: array of ptr to HookEntryUse;
  // The last prefix number handed out (0 is never one), under GLock
  GLastId: uint64;
  // How many handles are open (atomic): while it is 0 no address is a handle
  GOpenCount: int64;
  // Whether the exit flush is registered (DoExitFlush, once, at the first open), under GLock
  GExitArmed: bool;
  // HookReal's slots of the real functions
  GRealFopen: ptr;
  GRealFopenS: ptr;
  GRealWfopen: ptr;
  GRealFclose: ptr;
  GRealFread: ptr;
  GRealFwrite: ptr;
  GRealGetFmode: ptr;
  GRealFgetc: ptr;
  GRealGetc: ptr;
  GRealFgetcNolock: ptr;
  GRealGetcNolock: ptr;
  GRealFgets: ptr;
  GRealUngetc: ptr;
  GRealUngetcNolock: ptr;
  GRealFeof: ptr;
  GRealFerror: ptr;
  GRealClearerr: ptr;
  GRealFseek: ptr;
  GRealFseekNolock: ptr;
  GRealFseeki64: ptr;
  GRealFseeki64Nolock: ptr;
  GRealFtell: ptr;
  GRealFtellNolock: ptr;
  GRealFtelli64: ptr;
  GRealFtelli64Nolock: ptr;
  GRealRewind: ptr;
  GRealFileno: ptr;
  GRealUnderFileno: ptr;
  GRealLockFile: ptr;
  GRealUnlockFile: ptr;
  GRealFputc: ptr;
  GRealPutc: ptr;
  GRealFputcNolock: ptr;
  GRealPutcNolock: ptr;
  GRealFputs: ptr;
  GRealFflush: ptr;
  GRealFflushNolock: ptr;
  GRealFreadNolock: ptr;
  GRealFwriteNolock: ptr;
  GRealFcloseNolock: ptr;

threadstatic
  // How deep this thread is inside HookIO's own path work (a hooked open): while it is above
  // 0 a plain path is never looked up in a path source, so a source's own opens reach the real
  // file system
  GPathDepth: int32;

// Gives back one user of ALock (nil: nothing); its last user takes it out of GStreamLocks and
// frees it
routine DoReleaseLock(const ALock: ptr to HookStreamLock);
var
  LLock: ptr to HookStreamLock;
  LFree: bool;
  LCount: int64;
  LI: int64;
begin
  if ALock = nil then
    return;
  end;
  LFree := false;
  lock (GLock) do
    ALock->Users := ALock->Users - 1;
    if ALock->Users = 0 then
      LFree := true;
      if ALock->Listed then
        LCount := len(GStreamLocks);
        LI := 0;
        while (LI < LCount) and (GStreamLocks[LI] <> ALock) do
          LI := LI + 1;
        end;
        if LI < LCount then
          while LI < LCount - 1 do
            GStreamLocks[LI] := GStreamLocks[LI + 1];
            LI := LI + 1;
          end;
          setlength(GStreamLocks, LCount - 1);
        end;
      end;
    end;
  end;
  if LFree then
    LLock := ALock;
    destroy(LLock);
  end;
end;

// AStream's shared stream lock with one more user, made on first use (the caller holds
// GLock); nil when there is no room. One IO has one lock however often it is registered,
// also after an unregister while its handles stay open
routine DoStreamLockOf(const AStream: IO): ptr to HookStreamLock;
var
  LLock: ptr to HookStreamLock;
  LCount: int64;
  LI: int64;
begin
  for LI := 0 to len(GStreamLocks) - 1 do
    LLock := GStreamLocks[LI];
    if LLock->Stream = AStream then
      LLock->Users := LLock->Users + 1;
      return LLock;
    end;
  end;
  create(LLock);
  if LLock = nil then
    return nil;
  end;
  LLock->Stream := AStream;
  LLock->Listed := true;
  LLock->Users := 1;
  LCount := len(GStreamLocks);
  setlength(GStreamLocks, LCount + 1);
  GStreamLocks[LCount] := LLock;
  return LLock;
end;

// A stream lock of a handle's own, with the handle as its one user (a source entry's IO is
// that handle's alone); nil when there is no room
routine DoOwnLock(): ptr to HookStreamLock;
var
  LLock: ptr to HookStreamLock;
begin
  create(LLock);
  if LLock <> nil then
    LLock->Users := 1;
  end;
  return LLock;
end;

// True when APath from AFrom on is virtual (starts with io://). AId: its prefix number, 0 when
// the number is missing, has a leading zero, passes uint64 or is followed by anything but the
// end or '/' (no prefix is 0, so the path is a missing file). ARest: what follows the number,
// "" or "/<name>"
routine DoParse(const APath: string; const AFrom: int64; var AId: uint64;
  var ARest: string): bool;
var
  LCount: int64;
  LAt: int64;
  LId: uint64;
  LDigit: uint64;
  LDigits: bool;
begin
  AId := 0;
  ARest := "";
  LCount := len(APath);
  if Substring(APath, AFrom, ADAM_HOOKIO_SCHEME_LENGTH) <> ADAM_HOOKIO_SCHEME then
    return false;
  end;
  LAt := AFrom + ADAM_HOOKIO_SCHEME_LENGTH;
  if (LAt < LCount) and (APath[LAt] = '0') then
    return true;
  end;
  LId := 0;
  LDigits := false;
  while (LAt < LCount) and (APath[LAt] >= '0') and (APath[LAt] <= '9') do
    LDigit := uint64(int32(APath[LAt]) - 48);
    // Past the largest number: no such prefix
    if LId > ((18446744073709551615u - LDigit) div 10) then
      return true;
    end;
    LId := (LId * 10) + LDigit;
    LDigits := true;
    LAt := LAt + 1;
  end;
  if not LDigits then
    return true;
  end;
  if (LAt < LCount) and (APath[LAt] <> '/') then
    return true;
  end;
  AId := LId;
  ARest := Substring(APath, LAt, LCount - LAt);
  return true;
end;

// Where APath's io:// path starts when every leading "./" (or ".\", the same step on Windows)
// is followed by one, else 0. A C library joining a folder with no root and a name writes
// "./<folder>" (raylib's GetDirectoryPath), so "./io://3/a.png" names "io://3/a.png"
routine DoSkipCurrentFolder(const APath: string): int64;
var
  LAt: int64;
begin
  LAt := 0;
  while (LAt + 1 < len(APath)) and (APath[LAt] = '.') and
    ((APath[LAt + 1] = '/') or (APath[LAt + 1] = '\\')) do
    LAt := LAt + 2;
  end;
  if (LAt > 0) and (Substring(APath, LAt, ADAM_HOOKIO_SCHEME_LENGTH) = ADAM_HOOKIO_SCHEME) then
    return LAt;
  end;
  return 0;
end;

// True when APath names a virtual path (io://, after DoSkipCurrentFolder)
routine DoIsVirtual(const APath: string): bool;
begin
  return Substring(APath, DoSkipCurrentFolder(APath), ADAM_HOOKIO_SCHEME_LENGTH) =
    ADAM_HOOKIO_SCHEME;
end;

// Past the spaces of AText from AAt on
routine DoSkipSpaces(const AText: string; const AAt: int64): int64;
var
  LAt: int64;
begin
  LAt := AAt;
  while (LAt < len(AText)) and (AText[LAt] = ' ') do
    LAt := LAt + 1;
  end;
  return LAt;
end;

// True when AText from AAt on starts with AWord, ASCII letters compared without case
routine DoStartsNoCase(const AText: string; const AAt: int64; const AWord: string): bool;
var
  LI: int64;
  LHave: int32;
  LWant: int32;
begin
  if AAt + len(AWord) > len(AText) then
    return false;
  end;
  for LI := 0 to len(AWord) - 1 do
    LHave := int32(AText[AAt + LI]);
    LWant := int32(AWord[LI]);
    if (LHave >= 97) and (LHave <= 122) then
      LHave := LHave - 32;
    end;
    if (LWant >= 97) and (LWant <= 122) then
      LWant := LWant - 32;
    end;
    if LHave <> LWant then
      return false;
    end;
  end;
  return true;
end;

// ucrt's encoding part after the comma, AText from AAt on: spaces, "ccs" (lower case only),
// spaces, '=', spaces, UTF-8, UTF-16LE or UNICODE (any case, tried in that order, each as a
// prefix of what follows), spaces, the end. False: EINVAL. AEncoding: 1 UTF-8, 2 UTF-16LE,
// 3 UNICODE
routine DoParseEncoding(const AText: string; const AAt: int64; var AEncoding: int32): bool;
var
  LAt: int64;
begin
  LAt := DoSkipSpaces(AText, AAt);
  if Substring(AText, LAt, 3) <> "ccs" then
    return false;
  end;
  LAt := DoSkipSpaces(AText, LAt + 3);
  if (LAt >= len(AText)) or (AText[LAt] <> '=') then
    return false;
  end;
  LAt := DoSkipSpaces(AText, LAt + 1);
  if DoStartsNoCase(AText, LAt, "UTF-8") then
    LAt := LAt + 5;
    AEncoding := 1;
  else
    if DoStartsNoCase(AText, LAt, "UTF-16LE") then
      LAt := LAt + 8;
      AEncoding := 2;
    else
      if not DoStartsNoCase(AText, LAt, "UNICODE") then
        return false;
      end;
      LAt := LAt + 7;
      AEncoding := 3;
    end;
  end;
  LAt := DoSkipSpaces(AText, LAt);
  return LAt = len(AText);
end;

// True when a mode with neither b nor t opens in text mode: ucrt's _get_fmode says _O_TEXT
// (its default; a program linked with binmode.o has _O_BINARY). True when it cannot be asked
routine DoDefaultText(): bool;
var
  LFound: ptr;
  LGet: GetFmodeFn;
  LMode: int32;
begin
  LFound := HookReal(GRealGetFmode, ptr to const char("_get_fmode"));
  if LFound = nil then
    return true;
  end;
  LGet := GetFmodeFn(LFound);
  LMode := 0;
  if LGet(addr of LMode) <> 0 then
    return true;
  end;
  return (LMode & ADAM_HOOKIO_O_BINARY) = 0;
end;

// AResult's First and Mode from the mode's first letter; false when it is not r, w or a
routine DoParseFirst(const AFirst: char; var AResult: HookOpenMode): bool;
begin
  AResult.First := AFirst;
  if AFirst = 'r' then
    AResult.Mode := FileMode.Read;
    return true;
  end;
  if AFirst = 'w' then
    AResult.Mode := FileMode.Write;
    return true;
  end;
  if AFirst = 'a' then
    AResult.Mode := FileMode.Append;
    return true;
  end;
  return false;
end;

// AMode as ucrt's fopen parses it (corecrt_internal_stdio.h __acrt_stdio_parse_mode, Windows
// Kits 10.0.26100): leading spaces, then r, w or a, then any of: + (once); b or t (one of the
// two, once); c or n (one of the two, once); S or R (one of the two, once); T (once); D
// (once); N (any number); x (only when the first letter is w); spaces; or a comma, which
// starts the encoding part (DoParseEncoding). Anything else, or a rule broken: false (fopen's
// EINVAL). Text: t, or neither b nor t while _get_fmode says _O_TEXT. c / n (commit on
// flush), S / R / T (caching hints) and N (not inherited) change nothing an IO can show
routine DoParseMode(const AMode: string; var AResult: HookOpenMode): bool;
var
  LAt: int64;
  LChar: char;
  LKnown: bool;
  LBinary: bool;
  LTextFlag: bool;
  LCommit: bool;
  LCaching: bool;
  LShortLived: bool;
  LComma: bool;
begin
  AResult.First := 'r';
  AResult.Mode := FileMode.Read;
  AResult.Plus := false;
  AResult.Text := false;
  AResult.Exclusive := false;
  AResult.Temporary := false;
  AResult.Encoded := false;
  AResult.Encoding := 0;
  LBinary := false;
  LTextFlag := false;
  LCommit := false;
  LCaching := false;
  LShortLived := false;
  LComma := false;
  LAt := DoSkipSpaces(AMode, 0);
  if LAt >= len(AMode) then
    return false;
  end;
  if not DoParseFirst(AMode[LAt], AResult) then
    return false;
  end;
  LAt := LAt + 1;
  while (not LComma) and (LAt < len(AMode)) do
    LChar := AMode[LAt];
    LKnown := false;
    if LChar = '+' then
      if AResult.Plus then
        return false;
      end;
      AResult.Plus := true;
      LKnown := true;
    end;
    if (LChar = 'b') or (LChar = 't') then
      if LBinary or LTextFlag then
        return false;
      end;
      LBinary := LChar = 'b';
      LTextFlag := LChar = 't';
      LKnown := true;
    end;
    if (LChar = 'c') or (LChar = 'n') then
      if LCommit then
        return false;
      end;
      LCommit := true;
      LKnown := true;
    end;
    if (LChar = 'S') or (LChar = 'R') then
      if LCaching then
        return false;
      end;
      LCaching := true;
      LKnown := true;
    end;
    if LChar = 'T' then
      if LShortLived then
        return false;
      end;
      LShortLived := true;
      LKnown := true;
    end;
    if LChar = 'D' then
      if AResult.Temporary then
        return false;
      end;
      AResult.Temporary := true;
      LKnown := true;
    end;
    if LChar = 'x' then
      // ucrt allows x only with the truncating open, w
      if AResult.First <> 'w' then
        return false;
      end;
      AResult.Exclusive := true;
      LKnown := true;
    end;
    if LChar = ',' then
      LComma := true;
      LKnown := true;
    end;
    if (LChar = 'N') or (LChar = ' ') then
      LKnown := true;
    end;
    if not LKnown then
      return false;
    end;
    LAt := LAt + 1;
  end;
  if LComma then
    if not DoParseEncoding(AMode, LAt, AResult.Encoding) then
      return false;
    end;
    AResult.Encoded := true;
  end;
  // ucrt: + gives _O_RDWR and _IOUPDATE whatever the first letter
  if AResult.Plus then
    AResult.Mode := FileMode.ReadWrite;
  end;
  AResult.Text := (not LBinary) and (LTextFlag or DoDefaultText());
  return true;
end;

// True when the parsed mode asks for something HookIO does not open yet, refused with EINVAL:
// a ccs= open (a wide-text stream), until the wide stream model is built
routine DoModeNotBuilt(const AMode: HookOpenMode): bool;
begin
  return AMode.Encoded;
end;

// True when the open must fail with EEXIST because the target exists: x with a creating open
routine DoExclusive(const AMode: HookOpenMode): bool;
begin
  return AMode.Exclusive and (AMode.First <> 'r');
end;

// The registered entry of AId copied out under the lock, its stream lock with one more user
// (the open gives it back when it is done); false when none
routine DoFind(const AId: uint64; var AEntry: HookEntry): bool;
var
  LI: int64;
begin
  lock (GLock) do
    for LI := 0 to len(GEntries) - 1 do
      if GEntries[LI].Id = AId then
        AEntry := GEntries[LI];
        if AEntry.Lock <> nil then
          AEntry.Lock->Users := AEntry.Lock->Users + 1;
        end;
        return true;
      end;
    end;
  end;
  return false;
end;

// Registers one stream under the next prefix number; "" when both are nil or there is no room.
// The prefix text is built before the entry is added, so a failure registers nothing
routine DoRegister(const AStream: IO; const ASource: IOSource): string;
var
  LEntry: HookEntry;
  LPrefix: string;
  LCount: int64;
begin
  if (AStream = nil) and (ASource = nil) then
    return "";
  end;
  LEntry.Id := 0;
  LEntry.Stream := AStream;
  LEntry.Source := ASource;
  LEntry.Lock := nil;
  lock (GLock) do
    if AStream <> nil then
      LEntry.Lock := DoStreamLockOf(AStream);
      if LEntry.Lock = nil then
        return "";
      end;
    end;
    LEntry.Id := GLastId + 1;
    LPrefix := ADAM_HOOKIO_SCHEME + UIntToStr(LEntry.Id);
    LCount := len(GEntries);
    setlength(GEntries, LCount + 1);
    GEntries[LCount] := LEntry;
    GLastId := LEntry.Id;
  end;
  return LPrefix;
end;

// Removes a registered prefix (exactly `io://<n>`); false when it is not one
routine DoUnregister(const APrefix: string): bool;
var
  LId: uint64;
  LRest: string;
  LLock: ptr to HookStreamLock;
  LFound: bool;
  LCount: int64;
  LI: int64;
begin
  if not DoParse(APrefix, 0, LId, LRest) then
    return false;
  end;
  if (LId = 0) or (len(LRest) <> 0) then
    return false;
  end;
  LFound := false;
  LLock := nil;
  lock (GLock) do
    LCount := len(GEntries);
    LI := 0;
    while (LI < LCount) and (GEntries[LI].Id <> LId) do
      LI := LI + 1;
    end;
    if LI < LCount then
      LFound := true;
      LLock := GEntries[LI].Lock;
      while LI < LCount - 1 do
        GEntries[LI] := GEntries[LI + 1];
        LI := LI + 1;
      end;
      setlength(GEntries, LCount - 1);
    end;
  end;
  DoReleaseLock(LLock);
  return LFound;
end;

// The exit flush of open handles' written bytes, defined below
forward routine DoExitFlush();

// Records AHandle as open. The first open registers the exit flush (System.Runtime's AtExit):
// a C exit-time routine registered before it runs after it, the heap report last
routine DoAddHandle(const AHandle: ptr to HookHandle);
var
  LCount: int64;
begin
  lock (GLock) do
    LCount := len(GHandles);
    setlength(GHandles, LCount + 1);
    GHandles[LCount] := AHandle;
    atomicadd(GOpenCount, 1);
    if not GExitArmed then
      GExitArmed := true;
      AtExit(DoExitFlush);
    end;
  end;
end;

// The handle behind AFile with one more user (given back with DoReleaseHandle), or nil when
// AFile is not one (a real FILE, nil). While no handle is open no lock is taken
routine DoFindHandle(const AFile: ptr): ptr to HookHandle;
var
  LHandle: ptr to HookHandle;
  LI: int64;
begin
  if (AFile = nil) or (atomicload(GOpenCount) = 0) then
    return nil;
  end;
  lock (GLock) do
    for LI := 0 to len(GHandles) - 1 do
      LHandle := GHandles[LI];
      if ptr(LHandle) = AFile then
        LHandle->Users := LHandle->Users + 1;
        return LHandle;
      end;
    end;
  end;
  return nil;
end;

// Takes AFile out of the open list: its handle, still holding the open list's user, or nil
// when AFile is not one
routine DoTakeHandle(const AFile: ptr): ptr to HookHandle;
var
  LHandle: ptr to HookHandle;
  LCount: int64;
  LI: int64;
begin
  if (AFile = nil) or (atomicload(GOpenCount) = 0) then
    return nil;
  end;
  LHandle := nil;
  lock (GLock) do
    LCount := len(GHandles);
    LI := 0;
    while (LI < LCount) and (ptr(GHandles[LI]) <> AFile) do
      LI := LI + 1;
    end;
    if LI < LCount then
      LHandle := GHandles[LI];
      while LI < LCount - 1 do
        GHandles[LI] := GHandles[LI + 1];
        LI := LI + 1;
      end;
      setlength(GHandles, LCount - 1);
      atomicadd(GOpenCount, -1);
    end;
  end;
  return LHandle;
end;

// Frees a handle no one holds any more, its stream lock's user given back first
routine DoFreeHandle(const AHandle: ptr to HookHandle);
var
  LHandle: ptr to HookHandle;
begin
  DoReleaseLock(AHandle->Lock);
  LHandle := AHandle;
  destroy(LHandle);
end;

// Gives back one user of AHandle; the last one frees it
routine DoReleaseHandle(const AHandle: ptr to HookHandle);
var
  LFree: bool;
begin
  lock (GLock) do
    AHandle->Users := AHandle->Users - 1;
    LFree := AHandle->Users = 0;
  end;
  if LFree then
    DoFreeHandle(AHandle);
  end;
end;

// The place of ASource's entry AEntry in GEntryUses (the caller holds GLock), or -1
routine DoFindEntryUse(const ASource: IOSource; const AEntry: string): int64;
var
  LUse: ptr to HookEntryUse;
  LI: int64;
begin
  for LI := 0 to len(GEntryUses) - 1 do
    LUse := GEntryUses[LI];
    if (LUse->Source = ASource) and (LUse->EntryName = AEntry) then
      return LI;
    end;
  end;
  return -1;
end;

// Takes the use record at AAt out of GEntryUses (the caller holds GLock) and frees it
routine DoDropEntryUseAt(const AAt: int64);
var
  LUse: ptr to HookEntryUse;
  LCount: int64;
  LI: int64;
begin
  LUse := GEntryUses[AAt];
  LCount := len(GEntryUses);
  LI := AAt;
  while LI < LCount - 1 do
    GEntryUses[LI] := GEntryUses[LI + 1];
    LI := LI + 1;
  end;
  setlength(GEntryUses, LCount - 1);
  destroy(LUse);
end;

// Takes a use of a source entry before it is opened (ucrt's share rules for D: a D open asks
// DELETE access and shares deletion, every other open shares reading and writing only, so a D
// handle and a plain one refuse each other). False with errno set: EACCES when the other kind
// holds it, ENOENT while its last D close is removing it, ENOMEM
routine DoReserveEntry(const ASource: IOSource; const AEntry: string;
  const ATemporary: bool): bool;
var
  LUse: ptr to HookEntryUse;
  LAt: int64;
  LCount: int64;
begin
  lock (GLock) do
    LAt := DoFindEntryUse(ASource, AEntry);
    if LAt >= 0 then
      LUse := GEntryUses[LAt];
    else
      create(LUse);
      if LUse = nil then
        SetCErrno(ADAM_ERRNO_ENOMEM);
        return false;
      end;
      LUse->Source := ASource;
      LUse->EntryName := AEntry;
      LCount := len(GEntryUses);
      setlength(GEntryUses, LCount + 1);
      GEntryUses[LCount] := LUse;
    end;
    if LUse->Removing then
      SetCErrno(ADAM_ERRNO_ENOENT);
      return false;
    end;
    if (ATemporary and (LUse->Plain > 0)) or ((not ATemporary) and (LUse->Temporary > 0)) then
      SetCErrno(ADAM_ERRNO_EACCES);
      return false;
    end;
    if ATemporary then
      LUse->Temporary := LUse->Temporary + 1;
    else
      LUse->Plain := LUse->Plain + 1;
    end;
  end;
  return true;
end;

// Gives a use back. True when it was the entry's last D use and ARemove asks for the removal:
// the entry is then marked Removing and the caller removes it (DoFinishRemove). ARemove is
// false when the open that took the use failed before its IO was opened
routine DoReleaseEntry(const ASource: IOSource; const AEntry: string; const ATemporary: bool;
  const ARemove: bool): bool;
var
  LUse: ptr to HookEntryUse;
  LAt: int64;
begin
  lock (GLock) do
    LAt := DoFindEntryUse(ASource, AEntry);
    if LAt < 0 then
      return false;
    end;
    LUse := GEntryUses[LAt];
    if ATemporary then
      LUse->Temporary := LUse->Temporary - 1;
    else
      LUse->Plain := LUse->Plain - 1;
    end;
    if ATemporary and ARemove and (LUse->Temporary = 0) then
      LUse->Removing := true;
      return true;
    end;
    if (LUse->Plain = 0) and (LUse->Temporary = 0) and (not LUse->Removing) then
      DoDropEntryUseAt(LAt);
    end;
  end;
  return false;
end;

// Removes an entry whose last D handle closed (GLock is not held: the source runs), then
// forgets its use. The result is not reported: ucrt's fclose cannot see whether the OS deleted
// the file either
routine DoFinishRemove(const ASource: IOSource; const AEntry: string);
var
  LAt: int64;
begin
  IOSourceRemove(ASource, AEntry);
  lock (GLock) do
    LAt := DoFindEntryUse(ASource, AEntry);
    if LAt >= 0 then
      DoDropEntryUseAt(LAt);
    end;
  end;
end;

// Gives back the entry use a handle holds, once (Source is cleared), and removes the entry when
// that was its last D handle. A no-op on a registered IO
routine DoGiveBackEntry(const AHandle: ptr to HookHandle; const ARemove: bool);
var
  LSource: IOSource;
begin
  LSource := AHandle->Source;
  if LSource = nil then
    return;
  end;
  AHandle->Source := nil;
  if DoReleaseEntry(LSource, AHandle->EntryName, AHandle->Temporary, ARemove) then
    DoFinishRemove(LSource, AHandle->EntryName);
  end;
end;

// The entry name in a path's rest after the prefix: "/<entry>" -> "<entry>"
routine DoEntryName(const ARest: string): string;
begin
  if (len(ARest) > 0) and (ARest[0] = '/') then
    return Substring(ARest, 1, len(ARest) - 1);
  end;
  return ARest;
end;

// True when the open's target exists: always for a registered IO (every name under its prefix
// is that IO), IOSourceExists for a source entry
routine DoExists(const AEntry: HookEntry; const ARest: string): bool;
begin
  if AEntry.Stream <> nil then
    return true;
  end;
  return IOSourceExists(AEntry.Source, DoEntryName(ARest));
end;

// w / w+ empty the handle's IO, as the C runtime's open truncates the file (on a registered IO
// every other handle sees it emptied). An IO that cannot write refuses the open with EACCES (a
// read-only file); one that cannot be emptied (no Truncate, or a failed one) with ucrt's EINVAL
// for a file it cannot truncate. False with errno set; the handle starts at 0
routine DoEmptyIO(const AHandle: ptr to HookHandle): bool;
var
  LEmptied: bool;
  LReadOnly: bool;
begin
  LEmptied := false;
  LReadOnly := false;
  lock (AHandle->Lock->Lock) do
    LEmptied := IOTruncate(AHandle->Stream, 0);
    if not LEmptied then
      LReadOnly := IOStatus(AHandle->Stream) = IOState.ReadOnly;
    end;
  end;
  if not LEmptied then
    if LReadOnly then
      SetCErrno(ADAM_ERRNO_EACCES);
    else
      SetCErrno(ADAM_ERRNO_EINVAL);
    end;
    return false;
  end;
  AHandle->Position := 0;
  return true;
end;

// Where a write-only append handle ("a") starts, as ucrt opens it: its descriptor at 0 (lowio
// moves it to the end at each write, so ftell before the first write is 0, measured). "a+"
// starts at 0 too
routine DoAppendStart(const AHandle: ptr to HookHandle): bool;
begin
  AHandle->Position := 0;
  return true;
end;

// The body of DoDropCtrlZ, under the handle's stream lock
routine DoDropCtrlZLocked(const AHandle: ptr to HookHandle);
var
  LEnd: int64;
  LLast: uint8;
begin
  LEnd := IOSize(AHandle->Stream);
  // An IO with no size may still know its end
  if LEnd < 0 then
    LEnd := IOSeek(AHandle->Stream, 0, SeekOrigin.FromEnd);
  end;
  // An empty file: ucrt's seek to -1 from the end fails with EINVAL; the open goes on
  if LEnd = 0 then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return;
  end;
  if LEnd < 0 then
    return;
  end;
  if IOSeek(AHandle->Stream, LEnd - 1, SeekOrigin.FromStart) <> LEnd - 1 then
    return;
  end;
  // A failed read of the last byte is not an error (ucrt reads 0 bytes)
  LLast := 0;
  if IORead(AHandle->Stream, addr of LLast, 1) <> 1 then
    return;
  end;
  if LLast <> ADAM_HOOKIO_CTRL_Z then
    return;
  end;
  // A shorten that fails does not fail the open: ucrt goes on with the byte kept and errno
  // left at EACCES
  if not IOTruncate(AHandle->Stream, LEnd - 1) then
    SetCErrno(ADAM_ERRNO_EACCES);
  end;
end;

// ucrt's open of a text-mode file for reading and writing (any "+") drops one trailing Ctrl-Z
// so that appending works (lowio\open.cpp truncate_ctrl_z_if_present): nothing for an empty IO
// or one that cannot seek to its end; when the last byte is 0x1A the IO is shortened by one.
// The handle starts at 0 either way
routine DoDropCtrlZ(const AHandle: ptr to HookHandle);
begin
  lock (AHandle->Lock->Lock) do
    DoDropCtrlZLocked(AHandle);
  end;
  AHandle->Position := 0;
end;

// w+ / a+ on a source entry: CustomIO has no mode that creates AND reads, so a missing entry
// is created first by IOSourceOpen in Write (w+) or Append (a+) and closed at once; the handle
// then opens it ReadWrite. False with errno set: ENOENT when the source would not create it,
// EIO when closing the new entry failed
routine DoCreateEntry(const ASource: IOSource; const AEntry: string;
  const AParsed: HookOpenMode): bool;
var
  LCreated: IO;
  LMode: FileMode;
begin
  if IOSourceExists(ASource, AEntry) then
    return true;
  end;
  LMode := FileMode.Append;
  if AParsed.First = 'w' then
    LMode := FileMode.Write;
  end;
  LCreated := IOSourceOpen(ASource, AEntry, LMode);
  if LCreated = nil then
    SetCErrno(ADAM_ERRNO_ENOENT);
    return false;
  end;
  if not IOClose(LCreated) then
    SetCErrno(ADAM_ERRNO_EIO);
    return false;
  end;
  return true;
end;

// ucrt's D open asks DELETE access, which a file that cannot be deleted refuses with EACCES
// before anything is opened. For an entry: a source that cannot remove entries (a zip), or an
// existing entry that does not open for writing. A missing entry opened with r is left to the
// open's own ENOENT. False with errno set
routine DoTemporaryAllowed(const ASource: IOSource; const AEntry: string;
  const AParsed: HookOpenMode): bool;
var
  LExists: bool;
  LProbe: IO;
begin
  LExists := IOSourceExists(ASource, AEntry);
  if (not LExists) and (AParsed.First = 'r') then
    return true;
  end;
  if not IOSourceCanRemove(ASource) then
    SetCErrno(ADAM_ERRNO_EACCES);
    return false;
  end;
  if not LExists then
    return true;
  end;
  LProbe := IOSourceOpen(ASource, AEntry, FileMode.ReadWrite);
  if LProbe = nil then
    SetCErrno(ADAM_ERRNO_EACCES);
    return false;
  end;
  IOClose(LProbe);
  return true;
end;

// A handle on a registered IO, sharing the entry's stream lock (one more user for the
// handle). w / w+ empty the IO (DoEmptyIO); a starts where ucrt's does (DoAppendStart); a+ at 0
routine DoOpenShared(const AEntry: HookEntry; const AParsed: HookOpenMode;
  const AHandle: ptr to HookHandle): bool;
begin
  lock (GLock) do
    AEntry.Lock->Users := AEntry.Lock->Users + 1;
  end;
  AHandle->Stream := AEntry.Stream;
  AHandle->Lock := AEntry.Lock;
  AHandle->Owned := false;
  AHandle->Position := 0;
  if AParsed.First = 'w' then
    return DoEmptyIO(AHandle);
  end;
  if AParsed.Mode = FileMode.Append then
    return DoAppendStart(AHandle);
  end;
  return true;
end;

// A handle's IO on the source entry AEntry; the handle owns the IO and a stream lock of its
// own. w+ / a+ open it ReadWrite (DoCreateEntry first), w+ then empties it (DoEmptyIO). A
// failed open sets errno: EACCES when the entry exists (the source does not offer that mode),
// ENOENT otherwise (missing, or a path IOSourceOpen refuses)
routine DoOpenEntryIO(const ASource: IOSource; const AEntry: string; const AParsed: HookOpenMode;
  const AHandle: ptr to HookHandle): bool;
var
  LCreating: bool;
  LStream: IO;
  LFailed: bool;
  LError: int32;
begin
  LCreating := AParsed.Plus and (AParsed.First <> 'r');
  if LCreating and (not DoCreateEntry(ASource, AEntry, AParsed)) then
    return false;
  end;
  LStream := IOSourceOpen(ASource, AEntry, AParsed.Mode);
  if LStream = nil then
    if IOSourceExists(ASource, AEntry) then
      SetCErrno(ADAM_ERRNO_EACCES);
    else
      SetCErrno(ADAM_ERRNO_ENOENT);
    end;
    return false;
  end;
  AHandle->Stream := LStream;
  AHandle->Owned := true;
  AHandle->Position := 0;
  AHandle->Lock := DoOwnLock();
  if AHandle->Lock = nil then
    IOClose(LStream);
    AHandle->Stream := nil;
    SetCErrno(ADAM_ERRNO_ENOMEM);
    return false;
  end;
  LFailed := false;
  if AParsed.Mode = FileMode.Append then
    LFailed := not DoAppendStart(AHandle);
  end;
  if (not LFailed) and LCreating and (AParsed.First = 'w') then
    LFailed := not DoEmptyIO(AHandle);
  end;
  if LFailed then
    // errno is set by the step that failed; the close must not change it
    LError := CErrno();
    IOClose(LStream);
    AHandle->Stream := nil;
    SetCErrno(LError);
    return false;
  end;
  return true;
end;

// A handle on a source entry (DoOpenEntryIO): the handle takes a use of the entry first (ucrt's
// share rules for D, DoReserveEntry) and a D open checks the entry can be removed
// (DoTemporaryAllowed); the handle keeps the entry and gives the use back at its close
routine DoOpenEntry(const ASource: IOSource; const ARest: string; const AParsed: HookOpenMode;
  const AHandle: ptr to HookHandle): bool;
var
  LEntry: string;
  LError: int32;
begin
  LEntry := DoEntryName(ARest);
  if AParsed.Temporary and (not DoTemporaryAllowed(ASource, LEntry, AParsed)) then
    return false;
  end;
  if not DoReserveEntry(ASource, LEntry, AParsed.Temporary) then
    return false;
  end;
  if not DoOpenEntryIO(ASource, LEntry, AParsed, AHandle) then
    LError := CErrno();
    DoReleaseEntry(ASource, LEntry, AParsed.Temporary, false);
    SetCErrno(LError);
    return false;
  end;
  AHandle->Source := ASource;
  AHandle->EntryName := LEntry;
  AHandle->Temporary := AParsed.Temporary;
  return true;
end;

// The open once a path named its target. AFound: AEntry is the registered IO or IOSource the
// path names (false: nothing is registered under it, ENOENT once the mode is read); ARest: ""
// or "/<entry>"; ACallerErrno: errno as the caller left it (a successful open leaves it so).
// The new handle, or nil with errno set
routine DoOpenOn(const AFound: bool; const AEntry: HookEntry; const ARest: string;
  const AMode: string; const ACallerErrno: int32): ptr;
var
  LParsed: HookOpenMode;
  LHandle: ptr to HookHandle;
  LOpened: bool;
  LOpenErrno: int32;
begin
  // ucrt reads the mode before it touches the file
  if not DoParseMode(AMode, LParsed) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return nil;
  end;
  if DoModeNotBuilt(LParsed) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return nil;
  end;
  if not AFound then
    SetCErrno(ADAM_ERRNO_ENOENT);
    return nil;
  end;
  // x: the creating open fails when its target exists
  if DoExclusive(LParsed) and DoExists(AEntry, ARest) then
    SetCErrno(ADAM_ERRNO_EEXIST);
    return nil;
  end;
  create(LHandle);
  if LHandle = nil then
    SetCErrno(ADAM_ERRNO_ENOMEM);
    return nil;
  end;
  LHandle->Users := 1;
  LHandle->Mode := LParsed.Mode;
  LHandle->Appending := LParsed.First = 'a';
  LHandle->Text := LParsed.Text;
  // ucrt's open: 'r' sets _IOREAD, 'w' / 'a' _IOWRITE, '+' _IOUPDATE and neither of the others
  LHandle->Crt.StreamUpdate := LParsed.Mode = FileMode.ReadWrite;
  LHandle->Crt.StreamRead := LParsed.Mode = FileMode.Read;
  LHandle->Crt.StreamWrite := (LParsed.Mode = FileMode.Write) or (LParsed.Mode = FileMode.Append);
  // errno is set by the open that fails
  if AEntry.Stream <> nil then
    LOpened := DoOpenShared(AEntry, LParsed, LHandle);
  else
    LOpened := DoOpenEntry(AEntry.Source, ARest, LParsed, LHandle);
  end;
  if not LOpened then
    DoFreeHandle(LHandle);
    return nil;
  end;
  SetCErrno(ACallerErrno);
  // A text open for reading and writing drops a trailing Ctrl-Z, as ucrt's does
  if LParsed.Text and (LParsed.Mode = FileMode.ReadWrite) then
    DoDropCtrlZ(LHandle);
  end;
  LOpenErrno := CErrno();
  DoAddHandle(LHandle);
  SetCErrno(LOpenErrno);
  return ptr(LHandle);
end;

// A hooked open of APath in AMode (both UTF-8). False: not a virtual path, the caller passes it
// to the C runtime. True: handled; AResult is the new handle, or nil with errno set
routine DoOpenText(const APath: string; const AMode: string; var AResult: ptr): bool;
var
  LEntry: HookEntry;
  LRest: string;
  LId: uint64;
  LFound: bool;
  LCallerErrno: int32;
begin
  // errno as the caller left it: a successful open leaves it so; what the source's work set
  // (a missing entry's ENOENT before it is created) never leaks out
  LCallerErrno := CErrno();
  AResult := nil;
  if not DoParse(APath, DoSkipCurrentFolder(APath), LId, LRest) then
    return false;
  end;
  LEntry.Id := 0;
  LEntry.Stream := nil;
  LEntry.Source := nil;
  LEntry.Lock := nil;
  // The open's own work (the source's real files) never maps a plain path
  GPathDepth := GPathDepth + 1;
  LFound := false;
  if LId <> 0 then
    LFound := DoFind(LId, LEntry);
  end;
  SetCErrno(LCallerErrno);
  AResult := DoOpenOn(LFound, LEntry, LRest, AMode, LCallerErrno);
  // The entry's stream lock user DoFind took (a handle holds its own)
  DoReleaseLock(LEntry.Lock);
  GPathDepth := GPathDepth - 1;
  return true;
end;

// A hooked open of the C texts APath and AMode, as DoOpenText; false for a nil path
routine DoOpen(const APath: ptr to const char; const AMode: ptr to const char;
  var AResult: ptr): bool;
begin
  AResult := nil;
  if APath = nil then
    return false;
  end;
  return DoOpenText(StringFromC(APath), StringFromC(AMode), AResult);
end;

// The leading ASCII units of the NUL-terminated UTF-16 text AText (up to the first unit past
// 0x7F or the end) as a string: enough to tell a virtual path
routine DoAsciiPrefix(const AText: ptr to const wchar): string;
var
  LText: string;
  LCount: int64;
  LUnit: uint32;
begin
  LCount := 0;
  LUnit := uint32(AText[0]);
  while (LUnit <> 0) and (LUnit < 128) do
    LCount := LCount + 1;
    LUnit := uint32(AText[LCount]);
  end;
  setlength(LText, LCount);
  for LCount := 0 to len(LText) - 1 do
    LText[LCount] := char(uint8(AText[LCount]));
  end;
  return LText;
end;

// The NUL-terminated UTF-16 text AText as UTF-8 in AResult; false for nil, or when it holds a
// lone surrogate (ucrt converts with WC_ERR_INVALID_CHARS, which refuses one)
routine DoNarrow(const AText: ptr to const wchar; var AResult: string): bool;
var
  LCount: int64;
  LAt: int64;
  LOut: int64;
  LUnit: uint32;
  LNext: uint32;
  LCode: uint32;
begin
  AResult := "";
  if AText = nil then
    return false;
  end;
  LCount := 0;
  while uint32(AText[LCount]) <> 0 do
    LCount := LCount + 1;
  end;
  // Room for the longest form: 3 bytes a unit (a pair, 2 units, is 4 bytes)
  setlength(AResult, LCount * 3);
  LOut := 0;
  LAt := 0;
  while LAt < LCount do
    LUnit := uint32(AText[LAt]);
    LAt := LAt + 1;
    LCode := LUnit;
    if (LUnit >= 0xDC00) and (LUnit <= 0xDFFF) then
      return false;
    end;
    if (LUnit >= 0xD800) and (LUnit <= 0xDBFF) then
      if LAt >= LCount then
        return false;
      end;
      LNext := uint32(AText[LAt]);
      if (LNext < 0xDC00) or (LNext > 0xDFFF) then
        return false;
      end;
      LAt := LAt + 1;
      LCode := 0x10000 + ((LUnit - 0xD800) shl 10) + (LNext - 0xDC00);
    end;
    EncodeUtf8Char(AResult, LOut, LCode);
  end;
  setlength(AResult, LOut);
  return true;
end;

// A hooked _wfopen: as DoOpenText after converting to UTF-8. Only a path that starts with io://
// (after any leading "./" or ".\") is converted; such a path that does not convert is a missing
// file (ENOENT), such a mode is refused (EINVAL). Any other path goes to the C runtime
routine DoOpenWide(const APath: ptr to const wchar; const AMode: ptr to const wchar;
  var AResult: ptr): bool;
var
  LPath: string;
  LMode: string;
begin
  AResult := nil;
  if APath = nil then
    return false;
  end;
  if not DoIsVirtual(DoAsciiPrefix(APath)) then
    return false;
  end;
  if not DoNarrow(APath, LPath) then
    SetCErrno(ADAM_ERRNO_ENOENT);
    return true;
  end;
  if not DoNarrow(AMode, LMode) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return true;
  end;
  return DoOpenText(LPath, LMode, AResult);
end;

// lowio's descriptor rights: a handle opened for reading (r, or any mode with +) reads
routine DoCanRead(const AHandle: ptr to HookHandle): bool;
begin
  return (AHandle->Mode = FileMode.Read) or (AHandle->Mode = FileMode.ReadWrite);
end;

// lowio's descriptor rights: a handle opened with anything but r writes
routine DoCanWrite(const AHandle: ptr to HookHandle): bool;
begin
  return AHandle->Mode <> FileMode.Read;
end;

// Moves the IO to the handle's Position: another handle on the same IO, or a seek that only
// tried a target, may have left it elsewhere. False: the IO cannot go there
routine DoSyncLocked(const AHandle: ptr to HookHandle): bool;
begin
  if IOTell(AHandle->Stream) = AHandle->Position then
    return true;
  end;
  return IOSeek(AHandle->Stream, AHandle->Position, SeekOrigin.FromStart) = AHandle->Position;
end;

// The first byte of the model's buffer: the caller's array or the model's own (only asked
// once the buffer exists: HasBuffer)
routine DoCrtData(const AHandle: ptr to HookHandle): ptr to uint8;
begin
  if AHandle->Crt.Buffer.Caller <> nil then
    return AHandle->Crt.Buffer.Caller;
  end;
  return addr of AHandle->Crt.Buffer.Owned[0];
end;

// lowio's write of the descriptor itself (write.cpp): ASize bytes at AData to the IO at the
// handle's Position, as they are. Append mode writes at the IO's end: lowio seeks there first
// and ignores a failed seek (its lseek also clears the Ctrl-Z end). A handle opened without
// write access writes nothing: -1 with EBADF (ucrt maps the OS refusal to it). A short write
// sets Failed: nothing written is -1 with ENOSPC, else the count with EIO. Returns the count
// written or -1
routine DoWriteIOLocked(const AHandle: ptr to HookHandle; const AData: ptr to uint8;
  const ASize: int64): int64;
var
  LEnd: int64;
  LGot: int64;
begin
  if not DoCanWrite(AHandle) then
    SetCErrno(ADAM_ERRNO_EBADF);
    return -1;
  end;
  if AHandle->Appending then
    LEnd := IOSeek(AHandle->Stream, 0, SeekOrigin.FromEnd);
    if LEnd >= 0 then
      AHandle->Position := LEnd;
    end;
    AHandle->Crt.LowEof := false;
  end;
  if not DoSyncLocked(AHandle) then
    AHandle->Failed := true;
    SetCErrno(ADAM_ERRNO_EIO);
    return -1;
  end;
  LGot := IOWrite(AHandle->Stream, ptr(AData), ASize);
  if LGot < 0 then
    LGot := 0;
  end;
  AHandle->Position := AHandle->Position + LGot;
  if LGot < ASize then
    AHandle->Failed := true;
    if LGot = 0 then
      SetCErrno(ADAM_ERRNO_ENOSPC);
      return -1;
    end;
    SetCErrno(ADAM_ERRNO_EIO);
  end;
  return LGot;
end;

// lowio's text-mode _write (write.cpp, ANSI): every '\n' of the ASize bytes at AData goes to
// the IO as "\r\n". Returns the count of AData's bytes written (after a short IO write only
// those whose whole translation landed), or -1 when nothing was written
routine DoWriteTextLocked(const AHandle: ptr to HookHandle; const AData: ptr to uint8;
  const ASize: int64): int64;
var
  LRaw: ByteArray;
  LLength: int64;
  LI: int64;
  LAt: int64;
  LGot: int64;
  LUsed: int64;
  LCount: int64;
  LTakes: int64;
begin
  // Nothing to translate: the descriptor's own rules (EBADF, the append seek) still hold
  if ASize <= 0 then
    return DoWriteIOLocked(AHandle, AData, ASize);
  end;
  // The raw size first: each '\n' takes two bytes
  LLength := ASize;
  for LI := 0 to ASize - 1 do
    if AData[LI] = ADAM_HOOKIO_LF then
      LLength := LLength + 1;
    end;
  end;
  setlength(LRaw, LLength);
  LAt := 0;
  for LI := 0 to ASize - 1 do
    if AData[LI] = ADAM_HOOKIO_LF then
      LRaw[LAt] := ADAM_HOOKIO_CR;
      LAt := LAt + 1;
    end;
    LRaw[LAt] := AData[LI];
    LAt := LAt + 1;
  end;
  LGot := DoWriteIOLocked(AHandle, addr of LRaw[0], LLength);
  if LGot < 0 then
    return -1;
  end;
  if LGot = LLength then
    return ASize;
  end;
  // A short write: walk the source, each byte took 1 raw byte, a '\n' took 2
  LUsed := 0;
  LCount := 0;
  while LCount < ASize do
    LTakes := 1;
    if AData[LCount] = ADAM_HOOKIO_LF then
      LTakes := 2;
    end;
    if (LUsed + LTakes) > LGot then
      leave;
    end;
    LUsed := LUsed + LTakes;
    LCount := LCount + 1;
  end;
  return LCount;
end;

// lowio's _write: a text handle's bytes translated (DoWriteTextLocked), a binary handle's as
// they are (DoWriteIOLocked)
routine DoLowWriteLocked(const AHandle: ptr to HookHandle; const AData: ptr to uint8;
  const ASize: int64): int64;
begin
  if AHandle->Text then
    return DoWriteTextLocked(AHandle, AData, ASize);
  end;
  return DoWriteIOLocked(AHandle, AData, ASize);
end;

// lowio's read of the descriptor itself (read.cpp): up to ASize bytes of the IO at the
// handle's Position into AData, as they are. -1 on a failure: a handle opened without read
// access EBADF, an IO that cannot read EIO; a short count is the end. No stdio flag changes
// here: lowio has none
routine DoLowRawLocked(const AHandle: ptr to HookHandle; const AData: ptr to uint8;
  const ASize: int64): int64;
var
  LGot: int64;
begin
  if not DoCanRead(AHandle) then
    SetCErrno(ADAM_ERRNO_EBADF);
    return -1;
  end;
  if not DoSyncLocked(AHandle) then
    SetCErrno(ADAM_ERRNO_EIO);
    return -1;
  end;
  LGot := IORead(AHandle->Stream, ptr(AData), ASize);
  if LGot < 0 then
    LGot := 0;
  end;
  AHandle->Position := AHandle->Position + LGot;
  if (LGot = 0) and (ASize > 0) and (IOStatus(AHandle->Stream) <> IOState.Eof) then
    SetCErrno(ADAM_ERRNO_EIO);
    return -1;
  end;
  return LGot;
end;

// lowio's text translation of the ACount raw bytes just read into AData, in place (ucrt
// translate_text_mode_nolock, a seekable file): "\r\n" is '\n', any other '\r' stays. LowCrlf
// records whether the raw bytes began with '\n'. A Ctrl-Z sets LowEof and ends the bytes
// delivered; Position stays at the end of the raw read. A '\r' that is the last raw byte
// reads one more: no byte keeps the '\r'; a '\n' that would be the only byte delivered is
// taken; otherwise the descriptor steps back onto it and the '\r' is kept only when it was
// not a '\n' (the next read starts with that '\n', a lone one). Returns the count delivered
routine DoLowTranslateLocked(const AHandle: ptr to HookHandle; const AData: ptr to uint8;
  const ACount: int64): int64;
var
  LFrom: int64;
  LTo: int64;
  LPeek: uint8;
  LPeekGot: int64;
  LErrno: int32;
begin
  LFrom := 0;
  LTo := 0;
  LPeek := 0;
  AHandle->Crt.LowCrlf := (ACount > 0) and (AData[0] = ADAM_HOOKIO_LF);
  while LFrom < ACount do
    if AData[LFrom] = ADAM_HOOKIO_CTRL_Z then
      AHandle->Crt.LowEof := true;
      leave;
    end;
    if AData[LFrom] <> ADAM_HOOKIO_CR then
      AData[LTo] := AData[LFrom];
      LTo := LTo + 1;
      LFrom := LFrom + 1;
      skip;
    end;
    if (LFrom + 1) < ACount then
      if AData[LFrom + 1] = ADAM_HOOKIO_LF then
        AData[LTo] := ADAM_HOOKIO_LF;
        LFrom := LFrom + 2;
      else
        AData[LTo] := ADAM_HOOKIO_CR;
        LFrom := LFrom + 1;
      end;
      LTo := LTo + 1;
      skip;
    end;
    // The '\r' is the last raw byte: look at the next one. A failed look is no byte (ucrt's
    // ReadFile failure leaves errno alone)
    LFrom := LFrom + 1;
    LErrno := CErrno();
    LPeekGot := DoLowRawLocked(AHandle, addr of LPeek, 1);
    SetCErrno(LErrno);
    if LPeekGot <> 1 then
      AData[LTo] := ADAM_HOOKIO_CR;
      LTo := LTo + 1;
      skip;
    end;
    if (LPeek = ADAM_HOOKIO_LF) and (LTo = 0) then
      AData[LTo] := ADAM_HOOKIO_LF;
      LTo := LTo + 1;
      skip;
    end;
    // A seek back (lowio's lseek clears LowEof, which is not set here)
    AHandle->Position := AHandle->Position - 1;
    AHandle->Crt.LowEof := false;
    if LPeek <> ADAM_HOOKIO_LF then
      AData[LTo] := ADAM_HOOKIO_CR;
      LTo := LTo + 1;
    end;
  end;
  return LTo;
end;

// lowio's _read: 0 at the end, and after a Ctrl-Z end (LowEof) until a seek clears it; -1 on
// a failure (DoLowRawLocked's errno), else the count: a text handle's translated
// (DoLowTranslateLocked), a binary handle's as read
routine DoLowReadLocked(const AHandle: ptr to HookHandle; const AData: ptr to uint8;
  const ASize: int64): int64;
var
  LGot: int64;
begin
  if (ASize <= 0) or AHandle->Crt.LowEof then
    return 0;
  end;
  LGot := DoLowRawLocked(AHandle, AData, ASize);
  if LGot < 0 then
    return -1;
  end;
  if not AHandle->Text then
    return LGot;
  end;
  return DoLowTranslateLocked(AHandle, AData, LGot);
end;

// ucrt's buffer allocation (_getbuf.cpp __acrt_stdio_allocate_buffer_nolock), once: the big
// size, empty (Next and Count 0)
routine DoCrtAllocateLocked(const AHandle: ptr to HookHandle);
begin
  if AHandle->Crt.HasBuffer then
    return;
  end;
  setlength(AHandle->Crt.Buffer.Owned, ADAM_HOOKIO_BUFFER_SIZE);
  AHandle->Crt.Buffer.Caller := nil;
  AHandle->Crt.Buffer.Size := ADAM_HOOKIO_BUFFER_SIZE;
  AHandle->Crt.BufferSize := ADAM_HOOKIO_BUFFER_SIZE;
  AHandle->Crt.HasBuffer := true;
  AHandle->Crt.Kind := HookCrtBufferKind.Crt;
  AHandle->Crt.Next := 0;
  AHandle->Crt.Count := 0;
end;

// The small fill size after an fseek applies only to a buffer ucrt made itself on its own
// (has_crt_buffer() and not _IOBUFFER_SETVBUF)
routine DoCrtOwnBuffer(const AHandle: ptr to HookHandle): bool;
begin
  return AHandle->Crt.HasBuffer and (AHandle->Crt.Kind = HookCrtBufferKind.Crt) and
    (not AHandle->Crt.SetvbufBuffer);
end;

// ucrt's has_big_buffer(): a buffer ucrt or the caller made, not _IONBF's 2-byte _charbuf
routine DoCrtBigBuffer(const AHandle: ptr to HookHandle): bool;
begin
  return AHandle->Crt.HasBuffer and (AHandle->Crt.Kind <> HookCrtBufferKind.Single);
end;

// ucrt's buffer flush (fflush.cpp __acrt_stdio_flush_nolock): only a stream that writes and
// does not read, with a big buffer, flushes. The buffer empties (Next, Count 0), then its
// [0, Next) bytes go to lowio; a short write sets Failed and is EOF. An update stream that
// wrote bytes stops writing; one that had none to write keeps writing (ucrt returns before
// that step). Returns 0 or EOF
routine DoCrtFlushLocked(const AHandle: ptr to HookHandle): int32;
var
  LBytes: int64;
begin
  if AHandle->Crt.StreamRead or (not AHandle->Crt.StreamWrite) or
    (not DoCrtBigBuffer(AHandle)) then
    return 0;
  end;
  LBytes := AHandle->Crt.Next;
  AHandle->Crt.Next := 0;
  AHandle->Crt.Count := 0;
  if LBytes <= 0 then
    return 0;
  end;
  if DoLowWriteLocked(AHandle, DoCrtData(AHandle), LBytes) <> LBytes then
    AHandle->Failed := true;
    return ADAM_HOOKIO_EOF;
  end;
  if AHandle->Crt.StreamUpdate then
    AHandle->Crt.StreamWrite := false;
  end;
  return 0;
end;

// A read form on an update stream that holds written bytes, where ucrt's read would take the
// buffer's stale bytes past them (fgetc, fread, while the buffer has room left) or read past
// them straight from lowio (ADirect: fread's direct path is next), after which no flush ever
// writes them. C requires an fflush between a write and a read; the read takes it here, so
// the written bytes land and the read starts at the caller's place. A write-only stream ("w",
// "a") holding written bytes would hand back the buffer's stale bytes the same way: it is
// refused as ucrt's _filbuf refuses a writing stream (Failed, errno untouched). False: the
// read reads nothing
routine DoCrtLeaveWriteLocked(const AHandle: ptr to HookHandle; const ADirect: bool): bool;
begin
  if (not AHandle->Crt.StreamUpdate) and AHandle->Crt.StreamWrite and
    (not AHandle->Crt.StreamRead) and (AHandle->Crt.Count > 0) then
    AHandle->Failed := true;
    return false;
  end;
  if (not AHandle->Crt.StreamUpdate) or (not AHandle->Crt.StreamWrite) or
    AHandle->Crt.StreamRead or (AHandle->Crt.Next = 0) then
    return true;
  end;
  if (AHandle->Crt.Count <= 0) and (not ADirect) then
    return true;
  end;
  return DoCrtFlushLocked(AHandle) = 0;
end;

// ucrt's refill (_filbuf.cpp common_refill_and_read_nolock): the buffer is made on the first
// fill, filled with up to BufferSize bytes and its first byte returned. Nothing read: EOF with
// AtEnd (the end) or Failed (a failure). A read-only stream whose fill met a Ctrl-Z sets
// StreamCtrlZ; a fill at the small size puts the big size back for the next one. A stream
// that writes is refused: Failed, EOF, errno untouched
routine DoCrtRefillLocked(const AHandle: ptr to HookHandle): int32;
var
  LData: ptr to uint8;
  LGot: int64;
  LByte: uint8;
begin
  if AHandle->Crt.StreamWrite then
    AHandle->Failed := true;
    return ADAM_HOOKIO_EOF;
  end;
  AHandle->Crt.StreamRead := true;
  DoCrtAllocateLocked(AHandle);
  AHandle->Crt.Next := 0;
  LData := DoCrtData(AHandle);
  LGot := DoLowReadLocked(AHandle, LData, AHandle->Crt.BufferSize);
  if LGot <= 0 then
    if LGot < 0 then
      AHandle->Failed := true;
    else
      AHandle->AtEnd := true;
    end;
    AHandle->Crt.Count := 0;
    return ADAM_HOOKIO_EOF;
  end;
  AHandle->Crt.Count := LGot;
  if (not AHandle->Crt.StreamWrite) and (not AHandle->Crt.StreamUpdate) and
    AHandle->Crt.LowEof then
    AHandle->Crt.StreamCtrlZ := true;
  end;
  if (AHandle->Crt.BufferSize = ADAM_HOOKIO_SMALL_BUFFER_SIZE) and DoCrtOwnBuffer(AHandle) then
    AHandle->Crt.BufferSize := ADAM_HOOKIO_BUFFER_SIZE;
  end;
  AHandle->Crt.Count := AHandle->Crt.Count - 1;
  LByte := LData[AHandle->Crt.Next];
  AHandle->Crt.Next := AHandle->Crt.Next + 1;
  return int32(LByte);
end;

// A read of up to ASize bytes into AData, as ucrt's fread (fread.cpp _fread_nolock_s): the
// buffer's bytes first; with the buffer empty, a request of at least one buffer's size reads
// the largest whole multiple of it straight from lowio (at most INT_MAX bytes at a time),
// bypassing the buffer; a smaller one refills. A short count at the end sets AtEnd, after a
// failure Failed. Written bytes still in the buffer are flushed first where ucrt would read
// past them (DoCrtLeaveWriteLocked). A count left below 0 by a refused fputc is an empty
// buffer, as ucrt's getc macro takes it
routine DoCrtReadLocked(const AHandle: ptr to HookHandle; const AData: ptr to uint8;
  const ASize: int64): int64;
var
  LDone: int64;
  LBufferSize: int64;
  LRemaining: int64;
  LTake: int64;
  LLimit: int64;
  LGot: int64;
  LByte: int32;
begin
  LDone := 0;
  if AHandle->Crt.HasBuffer then
    LBufferSize := AHandle->Crt.BufferSize;
  else
    LBufferSize := ADAM_HOOKIO_BUFFER_SIZE;
  end;
  if not DoCrtLeaveWriteLocked(AHandle, ASize >= LBufferSize) then
    return 0;
  end;
  while LDone < ASize do
    LRemaining := ASize - LDone;
    if AHandle->Crt.HasBuffer and (AHandle->Crt.Count > 0) then
      LTake := LRemaining;
      if LTake > AHandle->Crt.Count then
        LTake := AHandle->Crt.Count;
      end;
      CopyBytes(AData + LDone, DoCrtData(AHandle) + AHandle->Crt.Next, LTake);
      AHandle->Crt.Count := AHandle->Crt.Count - LTake;
      AHandle->Crt.Next := AHandle->Crt.Next + LTake;
      LDone := LDone + LTake;
    else
      if LRemaining >= LBufferSize then
        LLimit := LRemaining;
        if LLimit > ADAM_HOOKIO_LOW_READ_MAX then
          LLimit := ADAM_HOOKIO_LOW_READ_MAX;
        end;
        LTake := LLimit - (LLimit mod LBufferSize);
        // The buffer no longer holds what precedes the place
        AHandle->Crt.Next := 0;
        AHandle->Crt.Count := 0;
        LGot := DoLowReadLocked(AHandle, AData + LDone, LTake);
        if LGot = 0 then
          AHandle->AtEnd := true;
          leave;
        end;
        if LGot < 0 then
          AHandle->Failed := true;
          leave;
        end;
        LDone := LDone + LGot;
      else
        LByte := DoCrtRefillLocked(AHandle);
        if LByte = ADAM_HOOKIO_EOF then
          leave;
        end;
        AData[LDone] := uint8(LByte);
        LDone := LDone + 1;
        LBufferSize := AHandle->Crt.BufferSize;
      end;
    end;
  end;
  return LDone;
end;

// The '\n' bytes in [AFirst, ALast) of the buffer
routine DoCrtNewlines(const AHandle: ptr to HookHandle; const AFirst: int64;
  const ALast: int64): int64;
var
  LData: ptr to uint8;
  LCount: int64;
  LI: int64;
begin
  LCount := 0;
  if ALast <= AFirst then
    return 0;
  end;
  LData := DoCrtData(AHandle);
  for LI := AFirst to ALast - 1 do
    if LData[LI] = ADAM_HOOKIO_LF then
      LCount := LCount + 1;
    end;
  end;
  return LCount;
end;

// ucrt's ftell (ftell.cpp common_ftell_nolock, common_ftell_read_mode_nolock), ungot bytes in
// the buffer counted as the buffer's own: in read mode the place minus the bytes left, in
// write mode the place plus the bytes not yet flushed. ucrt finds the descriptor's place with
// an lseek, and lowio's lseek clears FEOFLAG: so does this (a read that met a Ctrl-Z goes on
// past it). A text stream counts each newline before Next twice and, in read mode with bytes
// left in the buffer, estimates the buffer's raw size as ucrt does: at the end of the IO its
// bytes plus one per newline (plus the Ctrl-Z of StreamCtrlZ), elsewhere the small size for a
// fill of at most that many bytes, else BufferSize, plus one when LowCrlf. -1 with EINVAL for
// a stream that neither reads, writes nor updates. No sign check (ucrt has none): an ungot
// '\n' at the front can make a text place negative
routine DoCrtTellLocked(const AHandle: ptr to HookHandle): int64;
var
  LLow: int64;
  LOffset: int64;
  LBytes: int64;
  LEnd: int64;
begin
  LLow := AHandle->Position;
  // ucrt's ftell first sets a negative count to 0: a putc refused by _flsbuf (a read-only
  // stream) leaves it at -1
  if AHandle->Crt.Count < 0 then
    AHandle->Crt.Count := 0;
  end;
  AHandle->Crt.LowEof := false;
  // No buffer, or the _IONBF one (not a big buffer)
  if (not AHandle->Crt.HasBuffer) or (AHandle->Crt.Kind = HookCrtBufferKind.Single) then
    return LLow - AHandle->Crt.Count;
  end;
  LOffset := AHandle->Crt.Next;
  if (not AHandle->Crt.StreamRead) and (not AHandle->Crt.StreamWrite) and
    (not AHandle->Crt.StreamUpdate) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return -1;
  end;
  if AHandle->Text and (AHandle->Crt.StreamRead or AHandle->Crt.StreamWrite) then
    LOffset := LOffset + DoCrtNewlines(AHandle, 0, AHandle->Crt.Next);
  end;
  if LLow = 0 then
    return LOffset;
  end;
  if not AHandle->Crt.StreamRead then
    return LLow + LOffset;
  end;
  if AHandle->Crt.Count = 0 then
    return LLow;
  end;
  // Binary: lowio - (Count + Next) + Next
  if not AHandle->Text then
    return LLow - AHandle->Crt.Count;
  end;
  LBytes := AHandle->Crt.Count + AHandle->Crt.Next;
  // An IO with no size is never "at the end" (ucrt's lseek to the end failed)
  LEnd := IOSize(AHandle->Stream);
  if LEnd = LLow then
    LBytes := LBytes + DoCrtNewlines(AHandle, 0, LBytes);
    if AHandle->Crt.StreamCtrlZ then
      LBytes := LBytes + 1;
    end;
  else
    if (LBytes <= ADAM_HOOKIO_SMALL_BUFFER_SIZE) and DoCrtOwnBuffer(AHandle) then
      LBytes := ADAM_HOOKIO_SMALL_BUFFER_SIZE;
    else
      LBytes := AHandle->Crt.BufferSize;
    end;
    if AHandle->Crt.LowCrlf then
      LBytes := LBytes + 1;
    end;
  end;
  return LLow - LBytes + LOffset;
end;

// ucrt's buffer drop on fseek / rewind (__acrt_stdio_reset_buffer and the flag rules after
// it): the buffer empties (ungetc's bytes with it); an update stream forgets whether it read
// or wrote; a read-only stream's next fill asks for the small size after an fseek
// (ASmallBuffer), not after a rewind
routine DoCrtResetLocked(const AHandle: ptr to HookHandle; const ASmallBuffer: bool);
begin
  AHandle->Crt.Next := 0;
  AHandle->Crt.Count := 0;
  if AHandle->Crt.StreamUpdate then
    AHandle->Crt.StreamRead := false;
    AHandle->Crt.StreamWrite := false;
    return;
  end;
  if ASmallBuffer and AHandle->Crt.StreamRead and DoCrtOwnBuffer(AHandle) then
    AHandle->Crt.BufferSize := ADAM_HOOKIO_SMALL_BUFFER_SIZE;
  end;
end;

// ucrt's fseek fast track for a read-only binary stream (fseek.cpp
// common_fseek_binary_mode_read_only_fast_track_nolock): a target from the start or the
// caller's place that lies within the buffer (back to its start, on to its last byte read
// ahead) only moves Next; the buffer, the descriptor and the next fill's size stay. The
// start's place is taken as the descriptor's place minus the bytes left. True: done
routine DoCrtSeekInBufferLocked(const AHandle: ptr to HookHandle; const AOffset: int64;
  const AOrigin: int32): bool;
var
  LMove: int64;
  LHere: int64;
begin
  if AOrigin = ADAM_HOOKIO_SEEK_END then
    return false;
  end;
  if (not AHandle->Crt.HasBuffer) or AHandle->Crt.StreamWrite or AHandle->Crt.StreamUpdate then
    return false;
  end;
  if (AHandle->Crt.Count <= 0) or AHandle->Text then
    return false;
  end;
  LMove := AOffset;
  if AOrigin = ADAM_HOOKIO_SEEK_SET then
    LHere := AHandle->Position - AHandle->Crt.Count;
    // ucrt refuses the fast track when the difference overflows
    if (LHere < 0) and (AOffset > ADAM_HOOKIO_MAX_BYTES + LHere) then
      return false;
    end;
    if (LHere > 0) and (AOffset < ADAM_HOOKIO_MIN_BYTES + LHere) then
      return false;
    end;
    LMove := AOffset - LHere;
  end;
  if (LMove < 0 - AHandle->Crt.Next) or (LMove > AHandle->Crt.Count) then
    return false;
  end;
  AHandle->Crt.Next := AHandle->Crt.Next + LMove;
  AHandle->Crt.Count := AHandle->Crt.Count - LMove;
  return true;
end;

// ucrt's fseek: AOffset from the start (SEEK_SET), the caller's place (SEEK_CUR) or the end
// (SEEK_END); an unknown origin fails with EINVAL. Past a valid origin AtEnd is cleared
// whether or not the seek then succeeds; a read-only binary stream whose target lies in its
// buffer only moves in it (DoCrtSeekInBufferLocked); otherwise SEEK_CUR's place is ucrt's
// ftell, the buffer is flushed and dropped (a read-only stream's next fill asks for the small
// size) and the descriptor moves: the target must be reachable in the IO (past the end when
// the IO allows it); before the start or out of reach fails with EINVAL; success clears the
// Ctrl-Z end. Returns 0 or -1
routine DoSeekLocked(const AHandle: ptr to HookHandle; const AOffset: int64;
  const AOrigin: int32): int32;
var
  LBase: int64;
  LTarget: int64;
begin
  if (AOrigin <> ADAM_HOOKIO_SEEK_SET) and (AOrigin <> ADAM_HOOKIO_SEEK_CUR) and
    (AOrigin <> ADAM_HOOKIO_SEEK_END) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return -1;
  end;
  AHandle->AtEnd := false;
  if DoCrtSeekInBufferLocked(AHandle, AOffset, AOrigin) then
    return 0;
  end;
  // SEEK_CUR's place is taken before the buffer is flushed and dropped (the flush's result
  // is not checked: ucrt's fseek does not)
  LBase := 0;
  if AOrigin = ADAM_HOOKIO_SEEK_CUR then
    LBase := DoCrtTellLocked(AHandle);
  end;
  DoCrtFlushLocked(AHandle);
  DoCrtResetLocked(AHandle, true);
  if AOrigin = ADAM_HOOKIO_SEEK_END then
    LBase := IOSize(AHandle->Stream);
    // An IO with no size may still know its end
    if LBase < 0 then
      LBase := IOSeek(AHandle->Stream, 0, SeekOrigin.FromEnd);
    end;
    if LBase < 0 then
      SetCErrno(ADAM_ERRNO_EINVAL);
      return -1;
    end;
  end;
  // LBase is never below 0 here but for a place before the start (ungetc at 0); the sum is
  // checked before it is formed
  if (AOffset > 0) and (LBase > ADAM_HOOKIO_MAX_BYTES - AOffset) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return -1;
  end;
  LTarget := LBase + AOffset;
  if LTarget < 0 then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return -1;
  end;
  if IOSeek(AHandle->Stream, LTarget, SeekOrigin.FromStart) <> LTarget then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return -1;
  end;
  AHandle->Position := LTarget;
  // lowio's lseek clears the Ctrl-Z end
  AHandle->Crt.LowEof := false;
  return 0;
end;

// One byte as ucrt's _fgetc_nolock reads it (--_cnt >= 0 ? *_ptr++ : _filbuf): the buffer's
// next byte, a refill when the buffer is empty (EOF as the refill gives it). Written bytes in
// the buffer are flushed first (DoCrtLeaveWriteLocked)
routine DoCrtGetLocked(const AHandle: ptr to HookHandle): int32;
var
  LByte: uint8;
begin
  if not DoCrtLeaveWriteLocked(AHandle, false) then
    return ADAM_HOOKIO_EOF;
  end;
  if AHandle->Crt.HasBuffer and (AHandle->Crt.Count > 0) then
    AHandle->Crt.Count := AHandle->Crt.Count - 1;
    LByte := DoCrtData(AHandle)[AHandle->Crt.Next];
    AHandle->Crt.Next := AHandle->Crt.Next + 1;
    return int32(LByte);
  end;
  return DoCrtRefillLocked(AHandle);
end;

// ucrt's ungetc (ungetc.cpp _ungetc_nolock, a file stream, text or binary alike): AChar goes
// into the buffer in front of the next byte. Refused (EOF) for EOF itself, for a stream that
// has not read unless it is an update stream that writes, and when the next byte is already
// the buffer's first while bytes are left (one ungot byte at the front, no room for another).
// A stream with no buffer gets one first; at the front of an empty buffer the byte takes its
// first slot. AtEnd is cleared, the stream counts as reading. Returns the byte (0..255) or
// EOF. On an update stream holding written bytes ucrt puts the byte over the last one
// written and the rest are lost: here the ungetc behaves as after the fflush C requires
// before a read (the written bytes land, the stream no longer writes, and ucrt's rule then
// refuses the byte)
routine DoCrtUngetLocked(const AHandle: ptr to HookHandle; const AChar: int32): int32;
var
  LData: ptr to uint8;
begin
  if AChar = ADAM_HOOKIO_EOF then
    return ADAM_HOOKIO_EOF;
  end;
  if AHandle->Crt.StreamUpdate and (not AHandle->Crt.StreamRead) and (AHandle->Crt.Next <> 0) and
    (DoCrtFlushLocked(AHandle) = ADAM_HOOKIO_EOF) then
    return ADAM_HOOKIO_EOF;
  end;
  if (not AHandle->Crt.StreamRead) and
    (not (AHandle->Crt.StreamUpdate and AHandle->Crt.StreamWrite)) then
    return ADAM_HOOKIO_EOF;
  end;
  DoCrtAllocateLocked(AHandle);
  if AHandle->Crt.Next = 0 then
    if AHandle->Crt.Count <> 0 then
      return ADAM_HOOKIO_EOF;
    end;
    AHandle->Crt.Next := 1;
  end;
  AHandle->Crt.Next := AHandle->Crt.Next - 1;
  LData := DoCrtData(AHandle);
  LData[AHandle->Crt.Next] := uint8(AChar & 0xFF);
  AHandle->Crt.Count := AHandle->Crt.Count + 1;
  AHandle->AtEnd := false;
  AHandle->Crt.StreamRead := true;
  return AChar & 0xFF;
end;

// _flsbuf.cpp stream_is_at_end_of_file_nolock: feof is set; else not when a big buffer's Next
// is at its start; else the descriptor's place is the IO's size (an IO with no size is not at
// the end, as a failed query is not)
routine DoCrtAtEndLocked(const AHandle: ptr to HookHandle): bool;
var
  LSize: int64;
begin
  if AHandle->AtEnd then
    return true;
  end;
  if DoCrtBigBuffer(AHandle) and (AHandle->Crt.Next = 0) then
    return false;
  end;
  LSize := IOSize(AHandle->Stream);
  if LSize < 0 then
    return false;
  end;
  return AHandle->Position = LSize;
end;

// _flsbuf.cpp write_buffer_nolock: with a big buffer its written bytes go to lowio (none: an
// append stream's descriptor goes to the IO's end, a failed seek is Failed), the buffer then
// holds the character's ASize bytes alone (Next ASize, Count the rest); without one the
// character goes to lowio by itself. True when every byte asked was written
routine DoCrtWriteBufferLocked(const AHandle: ptr to HookHandle; const AChar: ptr to uint8;
  const ASize: int64): bool;
var
  LToWrite: int64;
  LWritten: int64;
  LEnd: int64;
begin
  if not DoCrtBigBuffer(AHandle) then
    return DoLowWriteLocked(AHandle, AChar, ASize) = ASize;
  end;
  LToWrite := AHandle->Crt.Next;
  LWritten := 0;
  AHandle->Crt.Next := ASize;
  AHandle->Crt.Count := AHandle->Crt.BufferSize - ASize;
  if LToWrite > 0 then
    LWritten := DoLowWriteLocked(AHandle, DoCrtData(AHandle), LToWrite);
  else
    if AHandle->Appending then
      LEnd := IOSeek(AHandle->Stream, 0, SeekOrigin.FromEnd);
      if LEnd < 0 then
        // ucrt returns its EOF from this bool function here, which is true: the stream is
        // flagged, the character is not stored, and its caller reports success
        AHandle->Failed := true;
        return true;
      end;
      // lowio's lseek clears the Ctrl-Z end
      AHandle->Position := LEnd;
      AHandle->Crt.LowEof := false;
    end;
  end;
  CopyBytes(DoCrtData(AHandle), AChar, ASize);
  return LWritten = LToWrite;
end;

// ucrt's flush-and-write (_flsbuf.cpp common_flush_and_write_nolock) of a character of ASize
// bytes: a stream that neither writes nor updates fails (EBADF, Failed). A reading stream may
// turn to writing only at the end (DoCrtAtEndLocked); its buffer is dropped either way, and
// elsewhere it fails (Failed). The stream then writes, AtEnd is cleared, a stream with no
// buffer gets ucrt's, and the character goes through DoCrtWriteBufferLocked (a short write:
// Failed). False: the character failed (the caller's EOF)
routine DoCrtFlushAndWriteCharLocked(const AHandle: ptr to HookHandle; const AChar: ptr to uint8;
  const ASize: int64): bool;
var
  LSwitch: bool;
begin
  if (not AHandle->Crt.StreamWrite) and (not AHandle->Crt.StreamUpdate) then
    SetCErrno(ADAM_ERRNO_EBADF);
    AHandle->Failed := true;
    return false;
  end;
  if AHandle->Crt.StreamRead then
    LSwitch := DoCrtAtEndLocked(AHandle);
    AHandle->Crt.Count := 0;
    if not LSwitch then
      AHandle->Failed := true;
      return false;
    end;
    AHandle->Crt.Next := 0;
    AHandle->Crt.StreamRead := false;
  end;
  AHandle->Crt.StreamWrite := true;
  AHandle->AtEnd := false;
  AHandle->Crt.Count := 0;
  DoCrtAllocateLocked(AHandle);
  if not DoCrtWriteBufferLocked(AHandle, AChar, ASize) then
    AHandle->Failed := true;
    return false;
  end;
  return true;
end;

// __acrt_stdio_flush_and_write_narrow_nolock: the byte (0..255) or EOF
routine DoCrtFlushAndWriteLocked(const AHandle: ptr to HookHandle; const AChar: int32): int32;
var
  LByte: uint8;
begin
  LByte := uint8(AChar & 0xFF);
  if not DoCrtFlushAndWriteCharLocked(AHandle, addr of LByte, 1) then
    return ADAM_HOOKIO_EOF;
  end;
  return AChar & 0xFF;
end;

// One byte as ucrt's _fputc_nolock writes it: into the buffer while it has room (--_cnt >=
// 0), else DoCrtFlushAndWriteLocked. Returns the byte (0..255) or EOF. ucrt's fast path also
// stores into a buffer holding bytes read ahead, and on an update stream the byte is then lost
// (a reading buffer is never flushed): here the write takes the fseek(SEEK_CUR, 0) C requires
// between a read and a write first, so the byte lands at the caller's place. A read-only
// stream keeps ucrt's rule (the byte replaces the next byte read ahead and fputc succeeds):
// nothing could have been written there
routine DoCrtPutLocked(const AHandle: ptr to HookHandle; const AChar: int32): int32;
var
  LData: ptr to uint8;
begin
  if AHandle->Crt.StreamUpdate and AHandle->Crt.StreamRead and (AHandle->Crt.Count > 0) then
    DoSeekLocked(AHandle, 0, ADAM_HOOKIO_SEEK_CUR);
  end;
  AHandle->Crt.Count := AHandle->Crt.Count - 1;
  if AHandle->Crt.Count < 0 then
    return DoCrtFlushAndWriteLocked(AHandle, AChar);
  end;
  LData := DoCrtData(AHandle);
  LData[AHandle->Crt.Next] := uint8(AChar & 0xFF);
  AHandle->Crt.Next := AHandle->Crt.Next + 1;
  return AChar & 0xFF;
end;

// A write of ASize bytes from AData, as ucrt's fwrite (fwrite.cpp _fwrite_nolock_internal):
// while a big buffer has room the bytes are copied in (a reading stream with bytes read ahead
// stops there, nothing flagged); with no room, at least one buffer's size goes first through
// a flush and then straight to lowio as the largest whole multiple of that size (at most
// UINT_MAX - 1 bytes at a time); less goes one byte through DoCrtFlushAndWriteLocked, after
// which the buffer's own size counts. A failure stops the write (Failed). Returns the count
// written
routine DoCrtWriteLocked(const AHandle: ptr to HookHandle; const AData: ptr to uint8;
  const ASize: int64): int64;
var
  LBufferSize: int64;
  LRemaining: int64;
  LTake: int64;
  LGot: int64;
  LAt: int64;
begin
  if ASize <= 0 then
    return 0;
  end;
  if AHandle->Crt.HasBuffer then
    LBufferSize := AHandle->Crt.BufferSize;
  else
    LBufferSize := ADAM_HOOKIO_BUFFER_SIZE;
  end;
  LRemaining := ASize;
  LAt := 0;
  while LRemaining <> 0 do
    if DoCrtBigBuffer(AHandle) and (AHandle->Crt.Count <> 0) then
      if AHandle->Crt.Count < 0 then
        AHandle->Failed := true;
        leave;
      end;
      if AHandle->Crt.StreamRead then
        leave;
      end;
      LTake := LRemaining;
      if LTake > AHandle->Crt.Count then
        LTake := AHandle->Crt.Count;
      end;
      CopyBytes(DoCrtData(AHandle) + AHandle->Crt.Next, AData + LAt, LTake);
      LRemaining := LRemaining - LTake;
      AHandle->Crt.Count := AHandle->Crt.Count - LTake;
      AHandle->Crt.Next := AHandle->Crt.Next + LTake;
      LAt := LAt + LTake;
    else
      if LRemaining >= LBufferSize then
        if DoCrtBigBuffer(AHandle) and (DoCrtFlushLocked(AHandle) <> 0) then
          leave;
        end;
        LTake := LRemaining;
        if LBufferSize > 0 then
          LTake := LRemaining - (LRemaining mod LBufferSize);
        end;
        if LTake > ADAM_HOOKIO_LOW_WRITE_MAX then
          LTake := ADAM_HOOKIO_LOW_WRITE_MAX;
        end;
        LGot := DoLowWriteLocked(AHandle, AData + LAt, LTake);
        if LGot < 0 then
          AHandle->Failed := true;
          leave;
        end;
        if LGot > LTake then
          LGot := LTake;
        end;
        LRemaining := LRemaining - LGot;
        LAt := LAt + LGot;
        if LGot < LTake then
          AHandle->Failed := true;
          leave;
        end;
      else
        if DoCrtFlushAndWriteLocked(AHandle, int32(AData[LAt])) = ADAM_HOOKIO_EOF then
          leave;
        end;
        LAt := LAt + 1;
        LRemaining := LRemaining - 1;
        LBufferSize := AHandle->Crt.BufferSize;
        if LBufferSize <= 0 then
          LBufferSize := 1;
        end;
      end;
    end;
  end;
  return ASize - LRemaining;
end;

// The IO's IOFlush for a handle that writes; 0 or EOF (Failed, errno EIO)
routine DoFlushIOLocked(const AHandle: ptr to HookHandle): int32;
begin
  if not DoCanWrite(AHandle) then
    return 0;
  end;
  if IOFlush(AHandle->Stream) then
    return 0;
  end;
  AHandle->Failed := true;
  SetCErrno(ADAM_ERRNO_EIO);
  return ADAM_HOOKIO_EOF;
end;

// What fflush(NULL) does to one handle: only a handle holding written bytes flushes them
// (ucrt's common_flush_all: a stream that writes and does not read). 0 or EOF
routine DoCrtFlushWrittenLocked(const AHandle: ptr to HookHandle): int32;
begin
  if AHandle->Crt.StreamRead or (not AHandle->Crt.StreamWrite) then
    return 0;
  end;
  return DoCrtFlushLocked(AHandle);
end;

// fflush(NULL)'s half for HookIO: every open handle's written bytes, then its IO's IOFlush,
// each under its own stream lock (the list is copied out under the registry lock, each handle
// held by one more user meanwhile); 0, or EOF when any failed
routine DoFlushAll(): int32;
var
  LOpen: array of ptr to HookHandle;
  LHandle: ptr to HookHandle;
  LResult: int32;
  LI: int64;
begin
  LResult := 0;
  if atomicload(GOpenCount) = 0 then
    return LResult;
  end;
  lock (GLock) do
    setlength(LOpen, len(GHandles));
    for LI := 0 to len(GHandles) - 1 do
      LHandle := GHandles[LI];
      LHandle->Users := LHandle->Users + 1;
      LOpen[LI] := LHandle;
    end;
  end;
  for LI := 0 to len(LOpen) - 1 do
    LHandle := LOpen[LI];
    lock (LHandle->Lock->Lock) do
      if not LHandle->Closed then
        if DoCrtFlushWrittenLocked(LHandle) <> 0 then
          LResult := ADAM_HOOKIO_EOF;
        end;
        if DoFlushIOLocked(LHandle) <> 0 then
          LResult := ADAM_HOOKIO_EOF;
        end;
      end;
    end;
    DoReleaseHandle(LHandle);
  end;
  return LResult;
end;

// ucrt flushes every open stream's written bytes at exit (its stdio termination); an open
// handle's do the same, registered by the first open (DoAddHandle). Only bytes still unflushed
// go to the IO (a handle with none never touches it). A D handle still open is then closed and
// its entry given back with removal: the OS deletes a D file when the ending process's handle
// closes. The handle stays in the open list, so a later call on it fails as on a closed one
// (EBADF) instead of reaching the C runtime. Nothing can report a failure at exit
routine DoExitFlush();
var
  LOpen: array of ptr to HookHandle;
  LGoing: array of bool;
  LHandle: ptr to HookHandle;
  LI: int64;
begin
  if atomicload(GOpenCount) = 0 then
    return;
  end;
  lock (GLock) do
    setlength(LOpen, len(GHandles));
    for LI := 0 to len(GHandles) - 1 do
      LHandle := GHandles[LI];
      LHandle->Users := LHandle->Users + 1;
      LOpen[LI] := LHandle;
    end;
  end;
  setlength(LGoing, len(LOpen));
  for LI := 0 to len(LOpen) - 1 do
    LHandle := LOpen[LI];
    LGoing[LI] := false;
    lock (LHandle->Lock->Lock) do
      if not LHandle->Closed then
        DoCrtFlushWrittenLocked(LHandle);
        if LHandle->Temporary then
          LHandle->Closed := true;
          if LHandle->Owned then
            IOClose(LHandle->Stream);
          end;
          LHandle->Stream := nil;
          LGoing[LI] := true;
        end;
      end;
    end;
  end;
  // Outside the stream locks: the removal runs the source
  for LI := 0 to len(LOpen) - 1 do
    LHandle := LOpen[LI];
    if LGoing[LI] then
      DoGiveBackEntry(LHandle, true);
    end;
    DoReleaseHandle(LHandle);
  end;
end;

// A hooked fclose. False: not a HookIO handle, the caller passes it to the C runtime. True:
// closed; AResult 0, or EOF when ucrt's flush of written bytes or closing its own IO failed
// (the handle closes anyway). The handle is freed when the last call holding it gives it back
routine DoClose(const AFile: ptr; var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
  LOk: bool;
begin
  AResult := 0;
  LHandle := DoTakeHandle(AFile);
  if LHandle = nil then
    return false;
  end;
  LOk := true;
  lock (LHandle->Lock->Lock) do
    if not LHandle->Closed then
      // ucrt's fclose flushes the written bytes first; a failure makes the close EOF
      if DoCrtFlushLocked(LHandle) <> 0 then
        LOk := false;
      end;
      LHandle->Closed := true;
      if LHandle->Owned and (not IOClose(LHandle->Stream)) then
        LOk := false;
      end;
      LHandle->Stream := nil;
    end;
  end;
  // The entry use goes back once the IO is closed: a D entry's last handle removes it, as the
  // OS deletes the file at the last close
  DoGiveBackEntry(LHandle, true);
  // The open list's user
  DoReleaseHandle(LHandle);
  if not LOk then
    AResult := ADAM_HOOKIO_EOF;
  end;
  return true;
end;

// The bytes fread / fwrite move for ACount items of ASize bytes, both C's size_t in their bits,
// by ucrt's rule: a product past size_t is refused (ARefused: its parameter check, EINVAL, 0,
// no ferror), a product of 0 moves nothing, and one past int64 (never a real buffer) is
// clamped there
routine DoItemBytes(const ASize: int64; const ACount: int64; var ARefused: bool): int64;
var
  LSize: uint64;
  LCount: uint64;
  LBytes: uint64;
begin
  ARefused := false;
  LSize := uint64(ASize);
  LCount := uint64(ACount);
  if (LSize = 0u) or (LCount = 0u) then
    return 0;
  end;
  if LCount > (ADAM_HOOKIO_MAX_SIZE div LSize) then
    ARefused := true;
    return 0;
  end;
  LBytes := LSize * LCount;
  if LBytes > uint64(ADAM_HOOKIO_MAX_BYTES) then
    return ADAM_HOOKIO_MAX_BYTES;
  end;
  return int64(LBytes);
end;

// The whole items of AItemSize bytes (C's size_t in its bits) in ABytes moved
routine DoWholeItems(const ABytes: int64; const AItemSize: int64): int64;
begin
  return int64(uint64(ABytes) div uint64(AItemSize));
end;

// A call of AOp whose answer, until it runs, is AFail; no arguments yet
routine DoCall(const AOp: HookOp; const AFail: int64): HookCall;
var
  LCall: HookCall;
begin
  LCall.Op := AOp;
  LCall.Buffer := nil;
  LCall.Size := 0;
  LCall.ItemSize := 0;
  LCall.Offset := 0;
  LCall.Origin := 0;
  LCall.Value := 0;
  LCall.Refused := false;
  LCall.Answer := AFail;
  return LCall;
end;

// C's truth value of a flag: 1 or 0
routine DoFlagValue(const AFlag: bool): int64;
begin
  if AFlag then
    return 1;
  end;
  return 0;
end;

// fread: whole elements; a partial one is read and not counted (nothing for no bytes; a
// refused count: EINVAL, nothing read, no ferror)
routine DoCallRead(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  if ACall.Refused then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return;
  end;
  if ACall.Size > 0 then
    ACall.Answer := DoWholeItems(DoCrtReadLocked(AHandle, ACall.Buffer, ACall.Size),
      ACall.ItemSize);
  end;
end;

// fwrite: whole elements written (nothing for no bytes; a refused count: EINVAL, nothing
// written, no ferror)
routine DoCallWrite(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  if ACall.Refused then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return;
  end;
  if ACall.Size > 0 then
    ACall.Answer := DoWholeItems(DoCrtWriteLocked(AHandle, ACall.Buffer, ACall.Size),
      ACall.ItemSize);
  end;
end;

// fgets: up to Size - 1 bytes into Buffer, stopping after a newline, then a 0; Answer 1. One
// getc at a time, as ucrt's fgets reads. Answer stays 0 (C's nil) when nothing was read before
// the end, on an error of this call (the error flag is sticky: only a new error counts), and
// for no buffer or a count of 0 or less (EINVAL)
routine DoCallGets(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LFailedBefore: bool;
  LCount: int64;
  LByte: int32;
begin
  LFailedBefore := AHandle->Failed;
  if (ACall.Buffer = nil) or (ACall.Size <= 0) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return;
  end;
  LCount := 0;
  while LCount < ACall.Size - 1 do
    LByte := DoCrtGetLocked(AHandle);
    if LByte = ADAM_HOOKIO_EOF then
      leave;
    end;
    ACall.Buffer[LCount] := uint8(LByte);
    LCount := LCount + 1;
    if LByte = ADAM_HOOKIO_NEWLINE then
      leave;
    end;
  end;
  if AHandle->Failed and (not LFailedBefore) then
    return;
  end;
  if (LCount = 0) and (ACall.Size > 1) then
    return;
  end;
  ACall.Buffer[LCount] := 0;
  ACall.Answer := 1;
end;

// fputs: Size bytes of Buffer through ucrt's fwrite; ucrt's success value, else EOF. No text
// (nil) is refused like ucrt's invalid parameter (EINVAL)
routine DoCallPuts(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  if ACall.Buffer = nil then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return;
  end;
  if DoCrtWriteLocked(AHandle, ACall.Buffer, ACall.Size) = ACall.Size then
    ACall.Answer := ADAM_HOOKIO_PUTS_OK;
  end;
end;

// rewind, as ucrt's (rewind.cpp): written bytes are flushed, the buffer is dropped without
// fseek's small-size rule (and never by its fast track), both flags and the Ctrl-Z end are
// cleared, then the descriptor goes to 0; a failed seek sets Failed again
routine DoCallRewind(const AHandle: ptr to HookHandle);
begin
  DoCrtFlushLocked(AHandle);
  DoCrtResetLocked(AHandle, false);
  AHandle->AtEnd := false;
  AHandle->Failed := false;
  AHandle->Crt.LowEof := false;
  if IOSeek(AHandle->Stream, 0, SeekOrigin.FromStart) = 0 then
    AHandle->Position := 0;
  else
    AHandle->Failed := true;
  end;
end;

// clearerr: both flags, and the Ctrl-Z end as ucrt's clears it
routine DoCallClearError(const AHandle: ptr to HookHandle);
begin
  AHandle->AtEnd := false;
  AHandle->Failed := false;
  AHandle->Crt.LowEof := false;
end;

// fflush of one handle: ucrt's flush of its written bytes (a reading stream is left alone),
// then the IO's own IOFlush; 0 or EOF
routine DoCallFlush(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  if DoCrtFlushLocked(AHandle) = ADAM_HOOKIO_EOF then
    return;
  end;
  ACall.Answer := DoFlushIOLocked(AHandle);
end;

// ACall run on AHandle, under its stream lock. fileno: a handle has no descriptor (EBADF, the
// answer stays -1)
routine DoRun(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  match ACall.Op of
    HookOp.Read: DoCallRead(AHandle, ACall);
    HookOp.Write: DoCallWrite(AHandle, ACall);
    HookOp.Get: ACall.Answer := DoCrtGetLocked(AHandle);
    HookOp.Gets: DoCallGets(AHandle, ACall);
    HookOp.Unget: ACall.Answer := DoCrtUngetLocked(AHandle, ACall.Value);
    HookOp.Put: ACall.Answer := DoCrtPutLocked(AHandle, ACall.Value);
    HookOp.Puts: DoCallPuts(AHandle, ACall);
    HookOp.Seek: ACall.Answer := DoSeekLocked(AHandle, ACall.Offset, ACall.Origin);
    HookOp.Tell: ACall.Answer := DoCrtTellLocked(AHandle);
    HookOp.Rewind: DoCallRewind(AHandle);
    HookOp.AtEnd: ACall.Answer := DoFlagValue(AHandle->AtEnd);
    HookOp.Failed: ACall.Answer := DoFlagValue(AHandle->Failed);
    HookOp.ClearError: DoCallClearError(AHandle);
    HookOp.Flush: DoCallFlush(AHandle, ACall);
    HookOp.Fileno: SetCErrno(ADAM_ERRNO_EBADF);
  end;
end;

// Runs ACall on AFile's handle under its stream lock. False: AFile is not a HookIO handle (the
// hook then calls the C runtime). A handle closed by a call that raced this one fails with
// EBADF (the call does not run; its answer stays the failure value)
routine DoWith(const AFile: ptr; var ACall: HookCall): bool;
var
  LHandle: ptr to HookHandle;
begin
  LHandle := DoFindHandle(AFile);
  if LHandle = nil then
    return false;
  end;
  lock (LHandle->Lock->Lock) do
    if LHandle->Closed then
      SetCErrno(ADAM_ERRNO_EBADF);
    else
      DoRun(LHandle, ACall);
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// The real function AName (HookReal fills ASlot once); nil with ENOSYS when the C runtime has
// no such function
routine DoReal(var ASlot: ptr; const AName: ptr to const char): ptr;
var
  LFound: ptr;
begin
  LFound := HookReal(ASlot, AName);
  if LFound = nil then
    SetCErrno(ADAM_ERRNO_ENOSYS);
  end;
  return LFound;
end;

// A hooked fread / fwrite (AOp Read / Write) of ACount items of ASize bytes at ABuffer. False:
// not a HookIO handle. True: handled; AResult is the count of whole items moved
routine DoTransfer(const AOp: HookOp; const ABuffer: ptr; const ASize: int64;
  const ACount: int64; const AFile: ptr; var AResult: int64): bool;
var
  LCall: HookCall;
begin
  AResult := 0;
  LCall := DoCall(AOp, 0);
  LCall.Buffer := ptr to uint8(ABuffer);
  LCall.ItemSize := ASize;
  LCall.Size := DoItemBytes(ASize, ACount, LCall.Refused);
  if not DoWith(AFile, LCall) then
    return false;
  end;
  AResult := LCall.Answer;
  return true;
end;

// A hooked C function of int (FILE*) form (fgetc, getc, feof, ferror, fileno and their
// _nolock forms): AOp on a handle, AFail when it fails; anything else goes to the real
// function AName (ASlot its slot), AFail with ENOSYS when the C runtime has none
routine DoFileInt(const AOp: HookOp; const AFail: int32; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FileIntFn;
begin
  LCall := DoCall(AOp, AFail);
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return AFail;
  end;
  LReal := FileIntFn(LFound);
  return LReal(AFile);
end;

// A hooked C function of void (FILE*) form (rewind, clearerr): AOp on a handle, anything else
// goes to the real function AName (ASlot its slot)
routine DoFileVoid(const AOp: HookOp; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char);
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FileVoidFn;
begin
  LCall := DoCall(AOp, 0);
  if DoWith(AFile, LCall) then
    return;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return;
  end;
  LReal := FileVoidFn(LFound);
  LReal(AFile);
end;

// A hooked C function of int (int, FILE*) form (fputc, putc, ungetc and their _nolock forms):
// AOp with the byte AChar on a handle (EOF when it fails), anything else goes to the real
// function AName (ASlot its slot)
routine DoCharFile(const AOp: HookOp; const AChar: int32; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: CharFileFn;
begin
  LCall := DoCall(AOp, ADAM_HOOKIO_EOF);
  LCall.Value := AChar;
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := CharFileFn(LFound);
  return LReal(AChar, AFile);
end;

// A hooked fseek of AOffset from AOrigin. False: not a HookIO handle. True: AResult 0 or -1
routine DoSeekCall(const AFile: ptr; const AOffset: int64; const AOrigin: int32;
  var AResult: int32): bool;
var
  LCall: HookCall;
begin
  AResult := -1;
  LCall := DoCall(HookOp.Seek, -1);
  LCall.Offset := AOffset;
  LCall.Origin := AOrigin;
  if not DoWith(AFile, LCall) then
    return false;
  end;
  AResult := int32(LCall.Answer);
  return true;
end;

// A hooked ftell. False: not a HookIO handle. True: APlace is ucrt's ftell on the handle's
// model as it is (its own refusals set errno; ucrt checks no sign)
routine DoTellCall(const AFile: ptr; var APlace: int64): bool;
var
  LCall: HookCall;
begin
  APlace := -1;
  LCall := DoCall(HookOp.Tell, -1);
  if not DoWith(AFile, LCall) then
    return false;
  end;
  APlace := LCall.Answer;
  return true;
end;

// fseek / _fseek_nolock (C's long offset)
routine DoFseek(const AFile: ptr; const AOffset: clong; const AOrigin: int32; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FseekFn;
begin
  if DoSeekCall(AFile, int64(AOffset), AOrigin, LResult) then
    return LResult;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := FseekFn(LFound);
  return LReal(AFile, AOffset, AOrigin);
end;

// _fseeki64 / _fseeki64_nolock (a 64-bit offset)
routine DoFseeki64(const AFile: ptr; const AOffset: int64; const AOrigin: int32;
  var ASlot: ptr; const AName: ptr to const char): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: Fseeki64Fn;
begin
  if DoSeekCall(AFile, AOffset, AOrigin, LResult) then
    return LResult;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := Fseeki64Fn(LFound);
  return LReal(AFile, AOffset, AOrigin);
end;

// ftell / _ftell_nolock: a place past what a long holds is -1 with EINVAL, as ucrt's ftell
// gives (a negative place goes back as it is)
routine DoFtell(const AFile: ptr; var ASlot: ptr; const AName: ptr to const char): clong;
var
  LPlace: int64;
  LFound: ptr;
  LReal: FtellFn;
begin
  if DoTellCall(AFile, LPlace) then
    if LPlace > ADAM_HOOKIO_LONG_MAX then
      SetCErrno(ADAM_ERRNO_EINVAL);
      return clong(-1);
    end;
    return clong(LPlace);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return clong(-1);
  end;
  LReal := FtellFn(LFound);
  return LReal(AFile);
end;

// _ftelli64 / _ftelli64_nolock
routine DoFtelli64(const AFile: ptr; var ASlot: ptr; const AName: ptr to const char): int64;
var
  LPlace: int64;
  LFound: ptr;
  LReal: Ftelli64Fn;
begin
  if DoTellCall(AFile, LPlace) then
    return LPlace;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := Ftelli64Fn(LFound);
  return LReal(AFile);
end;

// fflush / _fflush_nolock: a handle's written bytes, then its IO's IOFlush. Anything else
// goes to the real function AName (ASlot its slot); NULL flushes every open handle too (EOF
// when any of them failed, else the C runtime's result)
routine DoFlush(const AFile: ptr; var ASlot: ptr; const AName: ptr to const char): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FileIntFn;
  LOurs: int32;
  LResult: int32;
begin
  LCall := DoCall(HookOp.Flush, ADAM_HOOKIO_EOF);
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := FileIntFn(LFound);
  if AFile = nil then
    LOurs := DoFlushAll();
    LResult := LReal(AFile);
    if LOurs <> 0 then
      return ADAM_HOOKIO_EOF;
    end;
    return LResult;
  end;
  return LReal(AFile);
end;

// _lock_file / _unlock_file: nothing on a handle (it has no CRT lock: each call takes its
// stream lock itself); anything else goes to the real function AName (ASlot its slot)
routine DoLockFile(const AFile: ptr; var ASlot: ptr; const AName: ptr to const char);
var
  LHandle: ptr to HookHandle;
  LFound: ptr;
  LReal: FileVoidFn;
begin
  LHandle := DoFindHandle(AFile);
  if LHandle <> nil then
    DoReleaseHandle(LHandle);
    return;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return;
  end;
  LReal := FileVoidFn(LFound);
  LReal(AFile);
end;

// The IO behind a handle: the registered IO, or the entry's IO for a source; nil for anything
// else, and for a handle being closed
routine DoStream(const AFile: ptr): IO;
var
  LHandle: ptr to HookHandle;
  LStream: IO;
begin
  LHandle := DoFindHandle(AFile);
  if LHandle = nil then
    return nil;
  end;
  lock (LHandle->Lock->Lock) do
    LStream := LHandle->Stream;
  end;
  DoReleaseHandle(LHandle);
  return LStream;
end;

// The hooks: C's names (public: their plain C names). Each hands a path or a FILE that is not
// HookIO's to the real function, found once (System.HookAbi's HookReal); when the C runtime has
// no such function the call fails with ENOSYS.

// fopen: a virtual path opens a handle (see the unit header)
public routine fopen(const APath: ptr to const char; const AMode: ptr to const char): ptr;
var
  LFile: ptr;
  LFound: ptr;
  LReal: FopenFn;
begin
  if DoOpen(APath, AMode, LFile) then
    return LFile;
  end;
  LFound := HookReal(GRealFopen, ptr to const char("fopen"));
  if LFound = nil then
    SetCErrno(ADAM_ERRNO_ENOSYS);
    return nil;
  end;
  LReal := FopenFn(LFound);
  return LReal(APath, AMode);
end;

// fopen_s: the stream in AFile^, 0 or the error code returned. A nil AFile is the real
// function's to refuse
public routine fopen_s(const AFile: ptr to ptr; const APath: ptr to const char;
  const AMode: ptr to const char): int32;
var
  LFile: ptr;
  LFound: ptr;
  LReal: FopenSFn;
begin
  if (AFile <> nil) and DoOpen(APath, AMode, LFile) then
    AFile^ := LFile;
    if LFile = nil then
      return CErrno();
    end;
    return 0;
  end;
  LFound := HookReal(GRealFopenS, ptr to const char("fopen_s"));
  if LFound = nil then
    if AFile <> nil then
      AFile^ := nil;
    end;
    SetCErrno(ADAM_ERRNO_ENOSYS);
    return ADAM_ERRNO_ENOSYS;
  end;
  LReal := FopenSFn(LFound);
  return LReal(AFile, APath, AMode);
end;

// _wfopen: a UTF-16 path, opened as fopen opens its UTF-8 form
public routine _wfopen(const APath: ptr to const wchar; const AMode: ptr to const wchar): ptr;
var
  LFile: ptr;
  LFound: ptr;
  LReal: WfopenFn;
begin
  if DoOpenWide(APath, AMode, LFile) then
    return LFile;
  end;
  LFound := HookReal(GRealWfopen, ptr to const char("_wfopen"));
  if LFound = nil then
    SetCErrno(ADAM_ERRNO_ENOSYS);
    return nil;
  end;
  LReal := WfopenFn(LFound);
  return LReal(APath, AMode);
end;

// fclose: a handle is closed (its own IO with it), anything else goes to the C runtime
public routine fclose(const AFile: ptr): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FcloseFn;
begin
  if DoClose(AFile, LResult) then
    return LResult;
  end;
  LFound := HookReal(GRealFclose, ptr to const char("fclose"));
  if LFound = nil then
    SetCErrno(ADAM_ERRNO_ENOSYS);
    return ADAM_HOOKIO_EOF;
  end;
  LReal := FcloseFn(LFound);
  return LReal(AFile);
end;

// fread: a handle reads through its ucrt FILE model
public routine fread(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AFile: ptr): int64;
var
  LResult: int64;
  LFound: ptr;
  LReal: FreadFn;
begin
  if DoTransfer(HookOp.Read, ABuffer, ASize, ACount, AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFread, ptr to const char("fread"));
  if LFound = nil then
    return 0;
  end;
  LReal := FreadFn(LFound);
  return LReal(ABuffer, ASize, ACount, AFile);
end;

// _fread_nolock: fread (a handle has no CRT lock)
public routine _fread_nolock(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AFile: ptr): int64;
var
  LResult: int64;
  LFound: ptr;
  LReal: FreadFn;
begin
  if DoTransfer(HookOp.Read, ABuffer, ASize, ACount, AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFreadNolock, ptr to const char("_fread_nolock"));
  if LFound = nil then
    return 0;
  end;
  LReal := FreadFn(LFound);
  return LReal(ABuffer, ASize, ACount, AFile);
end;

// fwrite: a handle writes through its ucrt FILE model. The runtime's own printing comes here
// too (its `external` fwrite binds to this hook): stdout is no handle, so it goes to the real
// one
public routine fwrite(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AFile: ptr): int64;
var
  LResult: int64;
  LFound: ptr;
  LReal: FwriteFn;
begin
  if DoTransfer(HookOp.Write, ABuffer, ASize, ACount, AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFwrite, ptr to const char("fwrite"));
  if LFound = nil then
    return 0;
  end;
  LReal := FwriteFn(LFound);
  return LReal(ABuffer, ASize, ACount, AFile);
end;

// _fwrite_nolock: fwrite
public routine _fwrite_nolock(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AFile: ptr): int64;
var
  LResult: int64;
  LFound: ptr;
  LReal: FwriteFn;
begin
  if DoTransfer(HookOp.Write, ABuffer, ASize, ACount, AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFwriteNolock, ptr to const char("_fwrite_nolock"));
  if LFound = nil then
    return 0;
  end;
  LReal := FwriteFn(LFound);
  return LReal(ABuffer, ASize, ACount, AFile);
end;

// fgetc / getc and their _nolock forms: the byte (0..255) or EOF
public routine fgetc(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Get, ADAM_HOOKIO_EOF, AFile, GRealFgetc, ptr to const char("fgetc"));
end;

public routine getc(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Get, ADAM_HOOKIO_EOF, AFile, GRealGetc, ptr to const char("getc"));
end;

public routine _fgetc_nolock(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Get, ADAM_HOOKIO_EOF, AFile, GRealFgetcNolock,
    ptr to const char("_fgetc_nolock"));
end;

public routine _getc_nolock(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Get, ADAM_HOOKIO_EOF, AFile, GRealGetcNolock,
    ptr to const char("_getc_nolock"));
end;

// fgets: up to ACount - 1 bytes into AText, stopping after a newline, then a 0; AText, or nil
// when nothing was read before the end, on an error, or for a count of 0 or less (EINVAL)
public routine fgets(const AText: ptr to char; const ACount: int32; const AFile: ptr): ptr to char;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FgetsFn;
begin
  LCall := DoCall(HookOp.Gets, 0);
  LCall.Buffer := ptr to uint8(ptr(AText));
  LCall.Size := int64(ACount);
  if DoWith(AFile, LCall) then
    if LCall.Answer = 0 then
      return nil;
    end;
    return AText;
  end;
  LFound := DoReal(GRealFgets, ptr to const char("fgets"));
  if LFound = nil then
    return nil;
  end;
  LReal := FgetsFn(LFound);
  return LReal(AText, ACount, AFile);
end;

// ungetc / _ungetc_nolock: AChar put back by ucrt's rules; the byte (0..255) or EOF
public routine ungetc(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.Unget, AChar, AFile, GRealUngetc, ptr to const char("ungetc"));
end;

public routine _ungetc_nolock(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.Unget, AChar, AFile, GRealUngetcNolock,
    ptr to const char("_ungetc_nolock"));
end;

// feof / ferror: 1 when the flag is set, else 0
public routine feof(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.AtEnd, 0, AFile, GRealFeof, ptr to const char("feof"));
end;

public routine ferror(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Failed, 0, AFile, GRealFerror, ptr to const char("ferror"));
end;

// clearerr: both flags cleared
public routine clearerr(const AFile: ptr);
begin
  DoFileVoid(HookOp.ClearError, AFile, GRealClearerr, ptr to const char("clearerr"));
end;

// fseek / _fseek_nolock / _fseeki64 / _fseeki64_nolock: 0 or -1
public routine fseek(const AFile: ptr; const AOffset: clong; const AOrigin: int32): int32;
begin
  return DoFseek(AFile, AOffset, AOrigin, GRealFseek, ptr to const char("fseek"));
end;

public routine _fseek_nolock(const AFile: ptr; const AOffset: clong; const AOrigin: int32): int32;
begin
  return DoFseek(AFile, AOffset, AOrigin, GRealFseekNolock, ptr to const char("_fseek_nolock"));
end;

public routine _fseeki64(const AFile: ptr; const AOffset: int64; const AOrigin: int32): int32;
begin
  return DoFseeki64(AFile, AOffset, AOrigin, GRealFseeki64, ptr to const char("_fseeki64"));
end;

public routine _fseeki64_nolock(const AFile: ptr; const AOffset: int64;
  const AOrigin: int32): int32;
begin
  return DoFseeki64(AFile, AOffset, AOrigin, GRealFseeki64Nolock,
    ptr to const char("_fseeki64_nolock"));
end;

// ftell / _ftell_nolock / _ftelli64 / _ftelli64_nolock: the caller's place, or -1
public routine ftell(const AFile: ptr): clong;
begin
  return DoFtell(AFile, GRealFtell, ptr to const char("ftell"));
end;

public routine _ftell_nolock(const AFile: ptr): clong;
begin
  return DoFtell(AFile, GRealFtellNolock, ptr to const char("_ftell_nolock"));
end;

public routine _ftelli64(const AFile: ptr): int64;
begin
  return DoFtelli64(AFile, GRealFtelli64, ptr to const char("_ftelli64"));
end;

public routine _ftelli64_nolock(const AFile: ptr): int64;
begin
  return DoFtelli64(AFile, GRealFtelli64Nolock, ptr to const char("_ftelli64_nolock"));
end;

// rewind: to the start, both flags cleared
public routine rewind(const AFile: ptr);
begin
  DoFileVoid(HookOp.Rewind, AFile, GRealRewind, ptr to const char("rewind"));
end;

// fileno / _fileno: a handle has no descriptor (-1 with EBADF)
public routine fileno(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Fileno, -1, AFile, GRealFileno, ptr to const char("fileno"));
end;

public routine _fileno(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Fileno, -1, AFile, GRealUnderFileno, ptr to const char("_fileno"));
end;

// _lock_file / _unlock_file: nothing on a handle
public routine _lock_file(const AFile: ptr);
begin
  DoLockFile(AFile, GRealLockFile, ptr to const char("_lock_file"));
end;

public routine _unlock_file(const AFile: ptr);
begin
  DoLockFile(AFile, GRealUnlockFile, ptr to const char("_unlock_file"));
end;

// fputc / putc and their _nolock forms: the byte written (0..255) or EOF
public routine fputc(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.Put, AChar, AFile, GRealFputc, ptr to const char("fputc"));
end;

public routine putc(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.Put, AChar, AFile, GRealPutc, ptr to const char("putc"));
end;

public routine _fputc_nolock(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.Put, AChar, AFile, GRealFputcNolock,
    ptr to const char("_fputc_nolock"));
end;

public routine _putc_nolock(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.Put, AChar, AFile, GRealPutcNolock,
    ptr to const char("_putc_nolock"));
end;

// fputs: ucrt's success value (0) or EOF
public routine fputs(const AText: ptr to const char; const AFile: ptr): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FputsFn;
begin
  LCall := DoCall(HookOp.Puts, ADAM_HOOKIO_EOF);
  LCall.Buffer := ptr to uint8(ptr(AText));
  LCall.Size := CTextLength(AText);
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(GRealFputs, ptr to const char("fputs"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := FputsFn(LFound);
  return LReal(AText, AFile);
end;

// fflush: a handle's written bytes, then its IO's own flush; fflush(NULL) flushes every
// stream, the C runtime's and every handle. The runtime's own `external` fflush binds here
// too: stdout is no handle, so it goes to the real one
public routine fflush(const AFile: ptr): int32;
begin
  return DoFlush(AFile, GRealFflush, ptr to const char("fflush"));
end;

// _fflush_nolock: fflush
public routine _fflush_nolock(const AFile: ptr): int32;
begin
  return DoFlush(AFile, GRealFflushNolock, ptr to const char("_fflush_nolock"));
end;

// _fclose_nolock: fclose
public routine _fclose_nolock(const AFile: ptr): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FcloseFn;
begin
  if DoClose(AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFcloseNolock, ptr to const char("_fclose_nolock"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := FcloseFn(LFound);
  return LReal(AFile);
end;

// Registers an IO under a new prefix: from now on fopen("<prefix>") and fopen("<prefix>/<any
// name>"), in the program or in any C library linked into it, opens it. Every open gets its
// own handle with its own place. The IO stays the caller's: the registry never closes it.
// The prefix, `io://<n>`; "" when AIO is nil or there is no room
public routine RegisterIO(const AIO: IO): string;
begin
  return DoRegister(AIO, nil);
end;

// Registers an IOSource under a new prefix: from now on fopen("<prefix>/<entry>"), in the
// program or in any C library linked into it, opens that entry of the source (IOSourceOpen).
// The source stays the caller's: the registry never closes it. The prefix, `io://<n>`; ""
// when ASource is nil or there is no room
public routine RegisterIOSource(const ASource: IOSource): string;
begin
  return DoRegister(nil, ASource);
end;

// Removes a prefix: opening a path under it fails as a missing file does (ENOENT) from now on.
// Handles already open stay as they are; close them before closing what was registered. True
// when APrefix (exactly what RegisterIO / RegisterIOSource returned) was registered
public routine UnregisterIO(const APrefix: string): bool;
begin
  return DoUnregister(APrefix);
end;

// The IO behind a handle a hooked open returned: the registered IO, or the entry's IO for a
// source; nil for a C runtime FILE or nil
public routine FileIO(const AFile: ptr): IO;
begin
  return DoStream(AFile);
end;

end.
