// fgets: up to ACount - 1 bytes into AText, stopping after a newline, then a 0; AText, or nil
// when nothing was read before the end, on an error, or for a count of 0 or less (EINVAL)
public routine fgets(const AText: ptr to char; const ACount: int32; const AFile: ptr): ptr to char;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FgetsFn;
begin
  LCall := DoCall(HookOp.Gets, 0);
  LCall.Buffer := ptr to uint8(ptr(AText));
  LCall.Size := int64(ACount);
  if DoWith(AFile, LCall) then
    if LCall.Answer = 0 then
      return nil;
    end;
    return AText;
  end;
  LFound := DoReal(GRealFgets, ptr to const char("fgets"));
  if LFound = nil then
    return nil;
  end;
  LReal := FgetsFn(LFound);
  return LReal(AText, ACount, AFile);
end;

