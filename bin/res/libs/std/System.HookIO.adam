-------------------------------------------------------------------------------
  System.HookIO.adam - C's file calls on Adam streams (PaskalCPP's HookIO)

  RegisterIO / RegisterIOSource put an IO or an IOSource (System.CustomIO)
  under a prefix, `io://<n>`. From then on fopen("io://<n>/<name>"), in the
  program or inside any C library linked into it, opens that IO (each open
  a handle of its own, with its own place, on the shared IO) or the
  source's entry <name> (the handle owns the entry's IO). The hooks are
  System.HookAbi's link-time kind: public routines of the C names, so they
  bind every reference in the final link, the runtime's own `external`
  fwrite (its printing) included. A FILE that is not a HookIO handle goes
  to the real function (HookReal, found once): real files and printing work
  as before.

  This unit is the public surface and names no OS: the registry and the
  IO-level opens are System.HookIO.Core's, the hooked C names and the C
  runtime's FILE model the platform unit the target triple picks
  (System.HookIO.Win64 for x86_64-windows-gnu: ucrt's; System.HookIO.Linux64
  for x86_64-linux-gnu: glibc's libio), each giving a C library on a handle
  what its C runtime gives on a real file of the same bytes.
*******************************************************************************/

module unit System.HookIO;

import System.CustomIO, System.HookIO.Core
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

public const
  // C's EOF: what the hooked stream calls return on a failure or at the end
  ADAM_HOOKIO_EOF: int32 = System.HookIO.Core.ADAM_HOOKIO_EOF;
  // C's fseek origins (SEEK_SET, SEEK_CUR, SEEK_END)
  ADAM_HOOKIO_SEEK_SET: int32 = System.HookIO.Core.ADAM_HOOKIO_SEEK_SET;
  ADAM_HOOKIO_SEEK_CUR: int32 = System.HookIO.Core.ADAM_HOOKIO_SEEK_CUR;
  ADAM_HOOKIO_SEEK_END: int32 = System.HookIO.Core.ADAM_HOOKIO_SEEK_END;
  // C's WEOF (the target's wint_t): what the hooked wide calls return on a failure
@ifdef TARGET_X86_64_WINDOWS_GNU
  ADAM_HOOKIO_WEOF: int32 = System.HookIO.Win64.ADAM_HOOKIO_WEOF;
@elseif TARGET_X86_64_LINUX_GNU
  ADAM_HOOKIO_WEOF: int32 = System.HookIO.Linux64.ADAM_HOOKIO_WEOF;
@endif

// Registers an IO under a new prefix: from now on fopen("<prefix>") and fopen("<prefix>/<any
// name>"), in the program or in any C library linked into it, opens it. Every open gets its
// own handle with its own place. The IO stays the caller's: the registry never closes it.
// The prefix, `io://<n>`; "" when AIO is nil or there is no room
public routine cpplink RegisterIO(const AIO: IO): string;
begin
  return HookIORegister(AIO, nil);
end;
// Registers an IOSource under a new prefix: from now on fopen("<prefix>/<entry>"), in the
// program or in any C library linked into it, opens that entry of the source (IOSourceOpen).
// The source stays the caller's: the registry never closes it. The prefix, `io://<n>`; ""
// when ASource is nil or there is no room
public routine cpplink RegisterIOSource(const ASource: IOSource): string;
begin
  return HookIORegister(nil, ASource);
end;
// Removes a prefix: opening a path under it fails as a missing file does (ENOENT) from now on.
// Handles already open stay as they are; close them before closing what was registered. True
// when APrefix (exactly what RegisterIO / RegisterIOSource returned) was registered
public routine cpplink UnregisterIO(const APrefix: string): bool;
begin
  return HookIOUnregister(APrefix);
end;
// The IO behind a handle a hooked open returned: the registered IO, or the entry's IO for a
// source; nil for a C runtime FILE or nil
public routine cpplink FileIO(const AFile: ptr): IO;
begin
  return HookIOStreamOf(AFile);
end;
// Makes an IOSource the path source: while it is set, a plain path (not `io://`) that a hooked
// open names, in the program or in any C library linked into it, is looked up in the source
// first, as an entry name (a separator as '/': on Windows '\' is one; every leading "./" or
// separator dropped). When the source has
// that entry, the path opens as `<prefix>/<entry>` would; otherwise it goes to the real file
// system untouched. While a hooked open runs, the files a source opens itself reach the real
// file system. One setting for the whole program; setting a source replaces the one before.
// The source stays the caller's: unset it (nil) before closing it. CustomIO's file IO and
// folder source always mean the disk. False when the source could not be registered (no
// room): nothing changed
public routine cpplink SetIOPathSource(const ASource: IOSource): bool;
begin
  return HookIOSetPathSource(ASource);
end;
// Makes an IOSource the calling thread's own path source: while it is set, a plain path that a
// hooked open names on this thread is looked up in it, as SetIOPathSource describes, instead
// of in the program's path source; every other thread keeps the program's. A loader that pulls
// in files by plain relative paths sets one for the load and unsets it after, without moving
// the program's path source under another thread. Set and unset it on the same thread, unset
// it (nil) before the thread ends and before closing the source; nil: the program's path
// source applies to this thread again. False when the source could not be registered (no
// room): nothing changed
public routine cpplink SetIOThreadPathSource(const ASource: IOSource): bool;
begin
  return HookIOSetThreadPathSource(ASource);
end;
// The calling thread's own path source, as SetIOThreadPathSource last set it on this thread,
// so a loader can set its own for a call and put the caller's back after; nil when none is set
// on this thread (the program's path source, if any, applies)
public routine cpplink GetIOThreadPathSource(): IOSource;
begin
  return HookIOThreadPathSource();
end;

end.
