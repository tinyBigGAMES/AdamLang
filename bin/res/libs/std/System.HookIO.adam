// __stdio_common_vfprintf: what ucrt's fprintf and the headers' inline vfprintf / printf
// family call (AArgs is their va_list). A handle gets the text ucrt formats, written as ucrt
// writes it (DoPrint): the count, or -1. Anything else goes to the real function (-1 with
// ENOSYS when the C runtime has none)
public routine __stdio_common_vfprintf(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const char; const ALocale: ptr; const AArgs: ptr): int32;
var
  LAnswer: int32;
  LFound: ptr;
  LReal: VfprintfFn;
begin
  if DoPrint(AFile, AOptions, AFormat, ALocale, AArgs, LAnswer) then
    return LAnswer;
  end;
  LFound := DoReal(GRealVfprintf, ptr to const char("__stdio_common_vfprintf"));
  if LFound = nil then
    return -1;
  end;
  LReal := VfprintfFn(LFound);
  return LReal(AOptions, AFile, AFormat, ALocale, AArgs);
end;

// __stdio_common_vfscanf: what ucrt's fscanf / vfscanf and the headers' inline scan forms
// (fscanf_s, _fscanf_l, ...) call (AArgs is their va_list). A handle is scanned by the real
// function over a stand-in FILE (DoCallScan), a real FILE by the real function directly (EOF
// with ENOSYS when the C runtime has none)
public routine __stdio_common_vfscanf(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const char; const ALocale: ptr; const AArgs: ptr): int32;
var
  LFound: ptr;
  LReal: VfscanfFn;
  LCall: HookCall;
begin
  LFound := DoReal(GRealVfscanf, ptr to const char("__stdio_common_vfscanf"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LCall := DoCall(HookOp.Scan, ADAM_HOOKIO_EOF);
  LCall.ScanReal := LFound;
  LCall.ScanOptions := AOptions;
  LCall.ScanFormat := AFormat;
  LCall.ScanLocale := ALocale;
  LCall.ScanArgs := AArgs;
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LReal := VfscanfFn(LFound);
  return LReal(AOptions, AFile, AFormat, ALocale, AArgs);
end;

// __stdio_common_vfwprintf: what ucrt's fwprintf / vfwprintf (mingw's stubs of them) and the
// headers' inline wide printf family call (AArgs is their va_list). A handle gets the text ucrt
// formats, written as ucrt writes it (DoPrintWide): the count, or -1. Anything else goes to the
// real function (-1 with ENOSYS when the C runtime has none)
public routine __stdio_common_vfwprintf(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const wchar; const ALocale: ptr; const AArgs: ptr): int32;
var
  LAnswer: int32;
  LFound: ptr;
  LReal: VfwprintfFn;
begin
  if DoPrintWide(AFile, AOptions, AFormat, ALocale, AArgs, LAnswer) then
    return LAnswer;
  end;
  LFound := DoReal(GRealVfwprintf, ptr to const char("__stdio_common_vfwprintf"));
  if LFound = nil then
    return -1;
  end;
  LReal := VfwprintfFn(LFound);
  return LReal(AOptions, AFile, AFormat, ALocale, AArgs);
end;

// __stdio_common_vfwscanf: what ucrt's fwscanf / vfwscanf (mingw's stubs of them) and the
// headers' inline wide scan forms call (AArgs is their va_list). A handle is scanned by the
// real function over stand-in FILEs (DoCallScanWide), a real FILE by the real function
// directly (EOF with ENOSYS when the C runtime has none)
public routine __stdio_common_vfwscanf(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const wchar; const ALocale: ptr; const AArgs: ptr): int32;
var
  LFound: ptr;
  LReal: VfwscanfFn;
  LCall: HookCall;
begin
  LFound := DoReal(GRealVfwscanf, ptr to const char("__stdio_common_vfwscanf"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LCall := DoCall(HookOp.ScanWide, ADAM_HOOKIO_EOF);
  LCall.ScanReal := LFound;
  LCall.ScanOptions := AOptions;
  LCall.ScanWideFormat := AFormat;
  LCall.ScanLocale := ALocale;
  LCall.ScanArgs := AArgs;
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LReal := VfwscanfFn(LFound);
  return LReal(AOptions, AFile, AFormat, ALocale, AArgs);
end;

// A setvbuf call of AMode at ASize bytes over ABuffer (nil: no array): Refused for a mode
// ucrt refuses or, buffering, a size outside 2 .. INT_MAX; else Size is the usable size
// (rounded down to even). The failure value is -1
routine DoSetvbufCall(const ABuffer: ptr to char; const AMode: int32; const ASize: uint64):
  HookCall;
var
  LCall: HookCall;
begin
  LCall := DoCall(HookOp.Setvbuf, -1);
  LCall.Buffer := ptr to uint8(ptr(ABuffer));
  LCall.Value := AMode;
  if (AMode <> ADAM_HOOKIO_IONBF) and (AMode <> ADAM_HOOKIO_IOFBF) and
    (AMode <> ADAM_HOOKIO_IOLBF) then
    LCall.Refused := true;
    return LCall;
  end;
  if AMode = ADAM_HOOKIO_IONBF then
    return LCall;
  end;
  if (ASize < 2) or (ASize > ADAM_HOOKIO_INT_MAX) then
    LCall.Refused := true;
    return LCall;
  end;
  LCall.Size := int64(ASize & uint64(0x7FFFFFFE));
  return LCall;
end;

// setvbuf: a handle's buffer as ucrt's setvbuf sets it (DoCallSetvbuf): 0, or -1 (EINVAL for
// a mode or size ucrt refuses). Anything else goes to the real function (-1 with ENOSYS when
// the C runtime has none)
public routine setvbuf(const AFile: ptr; const ABuffer: ptr to char; const AMode: int32;
  const ASize: uint64): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: SetvbufFn;
begin
  LCall := DoSetvbufCall(ABuffer, AMode, ASize);
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(GRealSetvbuf, ptr to const char("setvbuf"));
  if LFound = nil then
    return -1;
  end;
  LReal := SetvbufFn(LFound);
  return LReal(AFile, ABuffer, AMode, ASize);
end;

// setbuf, as ucrt's: no array is setvbuf's _IONBF, an array is _IOFBF at BUFSIZ. Anything
// else goes to the real function (ENOSYS when the C runtime has none)
public routine setbuf(const AFile: ptr; const ABuffer: ptr to char);
var
  LCall: HookCall;
  LFound: ptr;
  LReal: SetbufFn;
begin
  if ABuffer = nil then
    LCall := DoSetvbufCall(nil, ADAM_HOOKIO_IONBF, 0);
  else
    LCall := DoSetvbufCall(ABuffer, ADAM_HOOKIO_IOFBF, ADAM_HOOKIO_BUFSIZ);
  end;
  if DoWith(AFile, LCall) then
    return;
  end;
  LFound := DoReal(GRealSetbuf, ptr to const char("setbuf"));
  if LFound = nil then
    return;
  end;
  LReal := SetbufFn(LFound);
  LReal(AFile, ABuffer);
end;

// fflush: a handle's written bytes, then its IO's own flush; fflush(NULL) flushes every
// stream, the C runtime's and every handle. The runtime's own `external` fflush binds here
// too: stdout is no handle, so it goes to the real one
public routine fflush(const AFile: ptr): int32;
begin
  return DoFlush(AFile, GRealFflush, ptr to const char("fflush"));
end;

// _fflush_nolock: fflush
public routine _fflush_nolock(const AFile: ptr): int32;
begin
  return DoFlush(AFile, GRealFflushNolock, ptr to const char("_fflush_nolock"));
end;

// _fclose_nolock: fclose
public routine _fclose_nolock(const AFile: ptr): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FcloseFn;
begin
  if DoClose(AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFcloseNolock, ptr to const char("_fclose_nolock"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := FcloseFn(LFound);
  return LReal(AFile);
end;

// Registers an IO under a new prefix: from now on fopen("<prefix>") and fopen("<prefix>/<any
// name>"), in the program or in any C library linked into it, opens it. Every open gets its
// own handle with its own place. The IO stays the caller's: the registry never closes it.
// The prefix, `io://<n>`; "" when AIO is nil or there is no room
public routine RegisterIO(const AIO: IO): string;
begin
  return DoRegister(AIO, nil);
end;

// Registers an IOSource under a new prefix: from now on fopen("<prefix>/<entry>"), in the
// program or in any C library linked into it, opens that entry of the source (IOSourceOpen).
// The source stays the caller's: the registry never closes it. The prefix, `io://<n>`; ""
// when ASource is nil or there is no room
public routine RegisterIOSource(const ASource: IOSource): string;
begin
  return DoRegister(nil, ASource);
end;

// Removes a prefix: opening a path under it fails as a missing file does (ENOENT) from now on.
// Handles already open stay as they are; close them before closing what was registered. True
// when APrefix (exactly what RegisterIO / RegisterIOSource returned) was registered
public routine UnregisterIO(const APrefix: string): bool;
begin
  return DoUnregister(APrefix);
end;

// The IO behind a handle a hooked open returned: the registered IO, or the entry's IO for a
// source; nil for a C runtime FILE or nil
public routine FileIO(const AFile: ptr): IO;
begin
  return DoStream(AFile);
end;

// Makes an IOSource the path source: while it is set, a plain path (not `io://`) that a hooked
// open names, in the program or in any C library linked into it, is looked up in the source
// first, as an entry name ('\' as '/', every leading "./" or '/' dropped). When the source has
// that entry, the path opens as `<prefix>/<entry>` would; otherwise it goes to the real file
// system untouched. While a hooked open runs, the files a source opens itself reach the real
// file system. One setting for the whole program; setting a source replaces the one before.
// The source stays the caller's: unset it (nil) before closing it. CustomIO's file IO and
// folder source always mean the disk. False when the source could not be registered (no
// room): nothing changed
public routine SetIOPathSource(const ASource: IOSource): bool;
begin
  return DoSetPathSource(ASource);
end;

// Makes an IOSource the calling thread's own path source: while it is set, a plain path that a
// hooked open names on this thread is looked up in it, as SetIOPathSource describes, instead
// of in the program's path source; every other thread keeps the program's. A loader that pulls
// in files by plain relative paths sets one for the load and unsets it after, without moving
// the program's path source under another thread. Set and unset it on the same thread, unset
// it (nil) before the thread ends and before closing the source; nil: the program's path
// source applies to this thread again. False when the source could not be registered (no
// room): nothing changed
public routine SetIOThreadPathSource(const ASource: IOSource): bool;
begin
  return DoSetThreadPathSource(ASource);
end;

// The calling thread's own path source, as SetIOThreadPathSource last set it on this thread,
// so a loader can set its own for a call and put the caller's back after; nil when none is set
// on this thread (the program's path source, if any, applies)
public routine GetIOThreadPathSource(): IOSource;
begin
  return DoThreadPathSource();
end;

end.
