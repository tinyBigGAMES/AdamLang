-------------------------------------------------------------------------------
  System.Raylib.Ext.Linux64.adam - System.Raylib.Ext's platform unit for
  x86_64-linux-gnu: what the frame window needs from X11 (the target triple
  picks it; System.Raylib.Ext.Win64 has the same names).

  GLFW loads libX11 at run time (dlopen) and takes its names with dlsym.
  The program's dlsym is the hook here (System.HookAbi: the public routine
  of that name binds every dlsym call in the link, raylib's GLFW and the
  runtime's alike): it hands back this unit's XCreateWindow and
  XDestroyWindow for those two names asked of a library handle, and the
  real answer for every other name. The real dlsym is glibc's own, found by
  its version with dlvsym (another name, so nothing comes back here).

  XCreateWindow: the real one; the display GLFW opened is kept (the DPI
  query's), and a top-level window (the root window its parent) gets the
  exe's icon as its _NET_WM_ICON (CARDINAL, 32: width, height, then one
  ARGB word per pixel, rows top down) from the compiler's entry
  ADAM_RESDATA_EXEICON_KEY (@exeicon, BNF sec 2), as a Windows exe's window
  gets its MAINICON; nothing for a build with no @exeicon. XDestroyWindow:
  System.Raylib.Ext told which window goes (the
  notice it set with RaylibPlatformSetWindowGone), then the real one.

  The DPI: X11's Xft.dpi, read from the root window's RESOURCE_MANAGER as
  it is now (a changed setting is seen), through libX11's own names on
  GLFW's handle; 0 when unset or when no X11 window was made yet. Asked
  once a second (a round trip to the server).

  Handles are passed as raylib's GetWindowHandle gives them, so the unit
  needs nothing of raylib's.
*******************************************************************************/

module unit System.Raylib.Ext.Linux64;

import System.SysUtils, System.LibC.C, System.ResData;

public type
  // The notice System.Raylib.Ext takes of a native window going (its X11 Window id)
  RaylibWindowGoneFn = func(const AWindow: uint64);

public const
  // How often the frame asks the DPI again, in seconds: once a second
  ADAM_RAYLIB_DPI_CHECK_SECONDS: float64 = 1.0;

const
  // dlfcn.h: the next object after the caller in the search order, the default one
  RTLD_NEXT: uint64 = 0xFFFFFFFFFFFFFFFF;
  RTLD_DEFAULT: uint64 = 0;
  // Xlib (X.h / Xatom.h): XA_STRING, XA_CARDINAL, Success, PropModeReplace
  XA_STRING: uint64 = 31;
  XA_CARDINAL: uint64 = 6;
  Success: int32 = 0;
  PropModeReplace: int32 = 0;
  // The window manager's icon property (EWMH) and the words before its pixels
  ADAM_RAYLIB_NET_WM_ICON: string = "_NET_WM_ICON";
  ADAM_RAYLIB_ICON_WORDS: int64 = 2;
  // The whole property in one read (XGetWindowProperty's length, in 32-bit units)
  ADAM_RAYLIB_WHOLE_PROPERTY: int64 = 0x7FFFFFFF;
  // The resource the DPI is (X resource name and class)
  ADAM_RAYLIB_XFT_DPI: string = "Xft.dpi";
  ADAM_RAYLIB_XFT_DPI_CLASS: string = "Xft.Dpi";

type
  // XrmValue (Xresource.h)
  XrmValue = record
    size: uint32;
    addr_: ptr to char;
  end;

  // The real functions (glibc's and libX11's own signatures)
  DlsymFn = func(AHandle: ptr; AName: ptr to const char): ptr;
  XCreateWindowFn = func(ADisplay: ptr; AParent: uint64; AX: int32; AY: int32;
    AWidth: uint32; AHeight: uint32; ABorderWidth: uint32; ADepth: int32; AClass: uint32;
    AVisual: ptr; AValueMask: uint64; AAttributes: ptr): uint64;
  XDestroyWindowFn = func(ADisplay: ptr; AWindow: uint64): int32;
  XDefaultRootWindowFn = func(ADisplay: ptr): uint64;
  XInternAtomFn = func(ADisplay: ptr; AAtomName: ptr to const char; AOnlyIfExists: int32): uint64;
  XGetWindowPropertyFn = func(ADisplay: ptr; AWindow: uint64; AProperty: uint64;
    ALongOffset: int64; ALongLength: int64; ADelete: int32; AReqType: uint64;
    AActualType: ptr to uint64; AActualFormat: ptr to int32; ANItems: ptr to uint64;
    ABytesAfter: ptr to uint64; AProp: ptr to ptr to uint8): int32;
  XFreeFn = func(AData: ptr): int32;
  XChangePropertyFn = func(ADisplay: ptr; AWindow: uint64; AProperty: uint64; AType: uint64;
    AFormat: int32; AMode: int32; AData: ptr to const uint8; ANElements: int32): int32;
  XrmGetStringDatabaseFn = func(AData: ptr to const char): ptr;
  XrmGetResourceFn = func(ADatabase: ptr; AName: ptr to const char;
    AClass: ptr to const char; AType: ptr to ptr to char; AValue: ptr to XrmValue): int32;
  XrmDestroyDatabaseFn = func(ADatabase: ptr);

var
  // glibc's own dlsym (dlvsym), found once
  GRealDlsym: ptr;
  // GLFW's libX11 handle (its dlsym of XCreateWindow) and the real two window routines
  GX11Library: ptr;
  GRealXCreateWindow: ptr;
  GRealXDestroyWindow: ptr;
  // GLFW's display, from its first XCreateWindow (the DPI query's)
  GX11Display: ptr;
  // The notice RaylibPlatformSetWindowGone set (nil: none)
  GWindowGone: RaylibWindowGoneFn;

func dlvsym(const AHandle: ptr; const AName: ptr to const char;
  const AVersion: ptr to const char): ptr; external "c";

// glibc's own dlsym (its x86_64 base version), found once into GRealDlsym
func DoRealDlsym(): DlsymFn;
begin
  if GRealDlsym = nil then
    GRealDlsym := dlvsym(ptr(RTLD_NEXT), ptr to const char("dlsym"),
      ptr to const char("GLIBC_2.2.5"));
  end;
  return DlsymFn(GRealDlsym);
end;

// libX11's AName on GLFW's handle (nil: no X11 window yet, or no such name)
func DoX11(const AName: ptr to const char): ptr;
var
  LReal: DlsymFn;
begin
  if (GX11Library = nil) or (GRealDlsym = nil) then
    return nil;
  end;
  LReal := DoRealDlsym();
  return LReal(GX11Library, AName);
end;

// The exe's icon (the compiler's ADAM_RESDATA_EXEICON_KEY entry) set as AWindow's
// _NET_WM_ICON: format 32 property words are C longs (64-bit here), each holding one value
// (the width, the height, then a pixel's ARGB); nothing when the build has no icon entry
func DoSetIcon(const ADisplay: ptr; const AWindow: uint64);
var
  LEntry: ResDataEntry;
  LIntern: XInternAtomFn;
  LChange: XChangePropertyFn;
  LWidth: int64;
  LHeight: int64;
  LWords: array of uint64;
  LI: int64;
  LAt: int64;
begin
  LEntry := FindResData(ADAM_RESDATA_EXEICON_KEY);
  if LEntry.Size < ADAM_RESDATA_EXEICON_HEADER then
    return;
  end;
  LWidth := int64(LEntry.Data[0]) | (int64(LEntry.Data[1]) shl 8) |
    (int64(LEntry.Data[2]) shl 16) | (int64(LEntry.Data[3]) shl 24);
  LHeight := int64(LEntry.Data[4]) | (int64(LEntry.Data[5]) shl 8) |
    (int64(LEntry.Data[6]) shl 16) | (int64(LEntry.Data[7]) shl 24);
  if (LWidth < 1) or (LHeight < 1) or
    (LEntry.Size < ADAM_RESDATA_EXEICON_HEADER + LWidth * LHeight * 4) then
    return;
  end;
  LIntern := XInternAtomFn(DoX11(ptr to const char("XInternAtom")));
  LChange := XChangePropertyFn(DoX11(ptr to const char("XChangeProperty")));
  if (LIntern = nil) or (LChange = nil) then
    return;
  end;
  setlength(LWords, ADAM_RAYLIB_ICON_WORDS + LWidth * LHeight);
  LWords[0] := uint64(LWidth);
  LWords[1] := uint64(LHeight);
  for LI := 0 to LWidth * LHeight - 1 do
    // RGBA bytes to one ARGB value
    LAt := ADAM_RESDATA_EXEICON_HEADER + LI * 4;
    LWords[ADAM_RAYLIB_ICON_WORDS + LI] := (uint64(LEntry.Data[LAt + 3]) shl 24) |
      (uint64(LEntry.Data[LAt]) shl 16) | (uint64(LEntry.Data[LAt + 1]) shl 8) |
      uint64(LEntry.Data[LAt + 2]);
  end;
  LChange(ADisplay, AWindow, LIntern(ADisplay, ptr to const char(ADAM_RAYLIB_NET_WM_ICON), 0),
    XA_CARDINAL, 32, PropModeReplace, ptr to const uint8(addr of LWords[0]), int32(len(LWords)));
end;

// XCreateWindow as GLFW gets it from the dlsym hook: the real one, its display kept, a
// top-level window given the exe's icon (DoSetIcon)
func DoXCreateWindowHook(ADisplay: ptr; AParent: uint64; AX: int32; AY: int32;
  AWidth: uint32; AHeight: uint32; ABorderWidth: uint32; ADepth: int32; AClass: uint32;
  AVisual: ptr; AValueMask: uint64; AAttributes: ptr): uint64;
var
  LReal: XCreateWindowFn;
  LRoot: XDefaultRootWindowFn;
  LWindow: uint64;
begin
  if GRealXCreateWindow = nil then
    return 0;
  end;
  LReal := XCreateWindowFn(GRealXCreateWindow);
  LWindow := LReal(ADisplay, AParent, AX, AY, AWidth, AHeight, ABorderWidth, ADepth, AClass,
    AVisual, AValueMask, AAttributes);
  if LWindow <> 0 then
    GX11Display := ADisplay;
    LRoot := XDefaultRootWindowFn(DoX11(ptr to const char("XDefaultRootWindow")));
    if (LRoot <> nil) and (AParent = LRoot(ADisplay)) then
      DoSetIcon(ADisplay, LWindow);
    end;
  end;
  return LWindow;
end;

// XDestroyWindow as GLFW gets it from the dlsym hook: System.Raylib.Ext told the window goes,
// then the real one
func DoXDestroyWindowHook(ADisplay: ptr; AWindow: uint64): int32;
var
  LReal: XDestroyWindowFn;
begin
  if GWindowGone <> nil then
    GWindowGone(AWindow);
  end;
  if GRealXDestroyWindow = nil then
    return 0;
  end;
  LReal := XDestroyWindowFn(GRealXDestroyWindow);
  return LReal(ADisplay, AWindow);
end;

// The hook: glibc's name (public: its plain C name, System.HookAbi). AName is nonnull by
// glibc's own declaration, as every caller passes it.
public func dlsym(AHandle: ptr; AName: ptr to const char): ptr;
var
  LReal: DlsymFn;
  LFound: ptr;
  LLibrary: bool;
begin
  LReal := DoRealDlsym();
  if LReal = nil then
    return nil;
  end;
  LFound := LReal(AHandle, AName);
  // A library's own handle (GLFW's libX11), never the pseudo handles
  LLibrary := (AHandle <> ptr(RTLD_NEXT)) and (AHandle <> ptr(RTLD_DEFAULT));
  if (LFound <> nil) and LLibrary and (strcmp(AName, ptr to const char("XCreateWindow")) = 0) then
    GX11Library := AHandle;
    GRealXCreateWindow := LFound;
    return ptr(DoXCreateWindowHook);
  end;
  if (LFound <> nil) and LLibrary and (strcmp(AName, ptr to const char("XDestroyWindow")) = 0) then
    GRealXDestroyWindow := LFound;
    return ptr(DoXDestroyWindowHook);
  end;
  return LFound;
end;

/// Sets the notice the XDestroyWindow hook gives as a window goes (nil: none).
/// @param ANotice the routine told each native window's id as it is destroyed
public func cpplink RaylibPlatformSetWindowGone(const ANotice: RaylibWindowGoneFn);
begin
  GWindowGone := ANotice;
end;

/// raylib's window as X11 names it: its Window id (raylib's GetWindowHandle points at its
/// copy of it); 0 for none.
/// @param AHandle raylib's GetWindowHandle()
public func cpplink RaylibPlatformNativeWindow(const AHandle: ptr): uint64;
var
  LId: ptr to const uint64;
begin
  if AHandle = nil then
    return 0;
  end;
  LId := ptr to const uint64(AHandle);
  return LId^;
end;

// The number strtod reads at the start of AText (spaces skipped; sign, digits, point,
// exponent), 0 when there is none
func DoLeadingNumber(const AText: string): float64;
var
  LStart: int64;
  LEnd: int64;
  LChar: char;
  LValue: float64;
begin
  LStart := 0;
  while (LStart < len(AText)) and ((AText[LStart] = ' ') or (AText[LStart] = '\t')) do
    LStart := LStart + 1;
  end;
  LEnd := LStart;
  while LEnd < len(AText) do
    LChar := AText[LEnd];
    if not (((LChar >= '0') and (LChar <= '9')) or (LChar = '.') or (LChar = '+') or
      (LChar = '-') or (LChar = 'e') or (LChar = 'E')) then
      leave;
    end;
    LEnd := LEnd + 1;
  end;
  // A shorter prefix when the whole run is no number ("96." reads, "96e" reads 96)
  while LEnd > LStart do
    if TryStrToFloat(Substring(AText, LStart, LEnd - LStart), LValue) then
      return LValue;
    end;
    LEnd := LEnd - 1;
  end;
  return 0.0;
end;

/// X11's Xft.dpi as it is now (the root window's RESOURCE_MANAGER), rounded; 0 when it is
/// unset or below 1, or before GLFW made an X11 window.
/// @param AHandle raylib's GetWindowHandle() (not needed on X11: the root window's setting)
public func cpplink RaylibPlatformQueryDpi(const AHandle: ptr): int32;
var
  LRoot: XDefaultRootWindowFn;
  LIntern: XInternAtomFn;
  LGet: XGetWindowPropertyFn;
  LFree: XFreeFn;
  LGetDatabase: XrmGetStringDatabaseFn;
  LGetResource: XrmGetResourceFn;
  LDestroy: XrmDestroyDatabaseFn;
  LType: uint64;
  LFormat: int32;
  LCount: uint64;
  LAfter: uint64;
  LData: ptr to uint8;
  LDatabase: ptr;
  LValueType: ptr to char;
  LValue: XrmValue;
  LDpi: float64;
  LResult: int32;
begin
  LResult := 0;
  if GX11Display = nil then
    return LResult;
  end;
  LRoot := XDefaultRootWindowFn(DoX11(ptr to const char("XDefaultRootWindow")));
  LIntern := XInternAtomFn(DoX11(ptr to const char("XInternAtom")));
  LGet := XGetWindowPropertyFn(DoX11(ptr to const char("XGetWindowProperty")));
  LFree := XFreeFn(DoX11(ptr to const char("XFree")));
  LGetDatabase := XrmGetStringDatabaseFn(DoX11(ptr to const char("XrmGetStringDatabase")));
  LGetResource := XrmGetResourceFn(DoX11(ptr to const char("XrmGetResource")));
  LDestroy := XrmDestroyDatabaseFn(DoX11(ptr to const char("XrmDestroyDatabase")));
  if (LRoot = nil) or (LIntern = nil) or (LGet = nil) or (LFree = nil) or
    (LGetDatabase = nil) or (LGetResource = nil) or (LDestroy = nil) then
    return LResult;
  end;

  LType := 0;
  LFormat := 0;
  LCount := 0;
  LAfter := 0;
  LData := nil;
  if LGet(GX11Display, LRoot(GX11Display),
    LIntern(GX11Display, ptr to const char("RESOURCE_MANAGER"), 0), 0,
    ADAM_RAYLIB_WHOLE_PROPERTY, 0, XA_STRING, addr of LType, addr of LFormat, addr of LCount,
    addr of LAfter, addr of LData) <> Success then
    return LResult;
  end;
  if LData = nil then
    return LResult;
  end;
  LDatabase := LGetDatabase(ptr to const char(LData));
  if LDatabase <> nil then
    LValueType := nil;
    LValue.size := 0;
    LValue.addr_ := nil;
    if (LGetResource(LDatabase, ptr to const char(ADAM_RAYLIB_XFT_DPI),
      ptr to const char(ADAM_RAYLIB_XFT_DPI_CLASS), addr of LValueType, addr of LValue) <> 0) and
      (LValue.addr_ <> nil) then
      LDpi := DoLeadingNumber(StringFromC(LValue.addr_));
      if LDpi >= 1.0 then
        LResult := int32(lround(LDpi));
      end;
    end;
    LDestroy(LDatabase);
  end;
  LFree(LData);
  return LResult;
end;

end.
