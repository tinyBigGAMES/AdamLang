public routine SDL_size_mul_check_overflow_builtin(const a: uint64; const b: uint64;
  const ret: ptr to uint64): bool;
begin
  return (int32(((a <> 0) ? ((ret^ := (a * b)) div a <> b) : ((ret^ := uint64(0)) <> uint64(0)))) = 0);
end;

public routine SDL_iconv_utf8_locale(const S: ptr to const char): ptr to char;
begin
  return SDL_iconv_string("", "UTF-8", S, (SDL_strlen(S) + 1));
end;

public routine SDL_iconv_utf8_ucs2(const S: ptr to const char): ptr to Uint16;
begin
  return ptr to Uint16(SDL_iconv_string("UCS-2", "UTF-8", S, (SDL_strlen(S) + 1)));
end;

public routine SDL_iconv_utf8_ucs4(const S: ptr to const char): ptr to Uint32;
begin
  return ptr to Uint32(SDL_iconv_string("UCS-4", "UTF-8", S, (SDL_strlen(S) + 1)));
end;

public routine SDL_iconv_wchar_utf8(const S: ptr to const uint16): ptr to char;
begin
  return SDL_iconv_string("UTF-8", "WCHAR_T", ptr to const char(S), ((SDL_wcslen(S) + 1) * 2));
end;

public routine SDL_AtomicIncRef(const a: ptr to SDL_AtomicInt): int32;
begin
  return SDL_AddAtomicInt(a, 1);
end;

public routine SDL_AtomicDecRef(const a: ptr to SDL_AtomicInt): int32;
begin
  return int32((SDL_AddAtomicInt(a, (-1)) = 1));
end;

public routine SDL_Swap16(const x: uint16): uint16;
begin
  return byteswap(x);
end;

public routine SDL_Swap32(const x: uint32): uint32;
begin
  return byteswap(x);
end;

public routine SDL_Swap64(const x: uint64): uint64;
begin
  return byteswap(x);
end;

public routine SDL_Unsupported(): bool;
begin
  return SDL_SetError("That operation is not supported");
end;

end.
