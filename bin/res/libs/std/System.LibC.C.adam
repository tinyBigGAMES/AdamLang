-------------------------------------------------------------------------------
  System.LibC.C.adam - the pure C routines of libc.a, Adam's own C library
  (res/libs/vendor/<triple>/libc.a, built by AdamLang-Libs from upstream
  musl v1.2.6, MIT license, with the same flags for every target, so a
  routine gives the same result on win64 and linux64). Translated by hand
  from musl's include/math.h with the header's own names, as M9's importer
  will write them when it regenerates this file; the parameter names are
  those of musl's sources (the header names none). math.h is libc.a's first
  part: string, ctype and the conversions join it here when a job needs
  them. The OS-facing C (malloc / free, FILE stdio, errno, threads, time,
  exit) stays the platform's own C runtime and is not declared here.

  The header's types: double float64, float float32, int int32, long long
  int64, long clong (4 bytes on win64, 8 on linux64: the target sizes it,
  as C does; lrint / lround / scalbln are C's own there, llrint / llround
  give one range on every target). Left out, as Adam has no long double:
  every `l` form, HUGE_VALL and nexttoward / nexttowardf. Left out as C
  macros with no routine behind them: fpclassify, isnan, isinf, isfinite,
  isnormal, signbit, the is* compares, math_errhandling, FP_FAST_FMA*
  (and FP_NAN .. FP_NORMAL with them: musl's __fpclassify / __signbit
  helpers are a build detail, renamed on win64 where mingw-w64 owns those
  names). The variable signgam is not declared (lgamma_r gives the sign).
  Target-neutral: no OS named, imports nothing.
*******************************************************************************/

module unit System.LibC.C;

public const
  // Float constants musl's math.h defines (NAN and INFINITY are floats)
  NAN: float32 = 0.0f / 0.0f;
  INFINITY: float32 = 1.0f / 0.0f;
  HUGE_VALF: float32 = 1.0f / 0.0f;
  HUGE_VAL: float64 = 1.0 / 0.0;
  // What math_errhandling holds the bits of
  MATH_ERRNO: int32 = 1;
  MATH_ERREXCEPT: int32 = 2;
  // ilogb's results for a NaN and a zero
  FP_ILOGBNAN: int32 = -2147483647 - 1;
  FP_ILOGB0: int32 = -2147483647 - 1;
  // The X/Open constants
  M_E: float64 = 2.7182818284590452354;
  M_LOG2E: float64 = 1.4426950408889634074;
  M_LOG10E: float64 = 0.43429448190325182765;
  M_LN2: float64 = 0.69314718055994530942;
  M_LN10: float64 = 2.30258509299404568402;
  M_PI: float64 = 3.14159265358979323846;
  M_PI_2: float64 = 1.57079632679489661923;
  M_PI_4: float64 = 0.78539816339744830962;
  M_1_PI: float64 = 0.31830988618379067154;
  M_2_PI: float64 = 0.63661977236758134308;
  M_2_SQRTPI: float64 = 1.12837916709551257390;
  M_SQRT2: float64 = 1.41421356237309504880;
  M_SQRT1_2: float64 = 0.70710678118654752440;
  // The largest float32
  HUGE: float32 = 3.40282346638528859812e+38f;

// C99 math.h
