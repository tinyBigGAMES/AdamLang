public routine clink asinh(x: float64): float64; external "c";
public routine clink asinhf(x: float32): float32; external "c";
public routine clink atan(x: float64): float64; external "c";
public routine clink atanf(x: float32): float32; external "c";
public routine clink atan2(y: float64; x: float64): float64; external "c";
public routine clink atan2f(y: float32; x: float32): float32; external "c";
public routine clink atanh(x: float64): float64; external "c";
public routine clink atanhf(x: float32): float32; external "c";
public routine clink cbrt(x: float64): float64; external "c";
public routine clink cbrtf(x: float32): float32; external "c";
