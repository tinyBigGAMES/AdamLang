public routine clink log2(x: float64): float64; external "c";
public routine clink log2f(x: float32): float32; external "c";
public routine clink logb(x: float64): float64; external "c";
public routine clink logbf(x: float32): float32; external "c";
public routine clink lrint(x: float64): clong; external "c";
