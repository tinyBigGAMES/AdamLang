public routine clink hypot(x: float64; y: float64): float64; external "c";
public routine clink hypotf(x: float32; y: float32): float32; external "c";
public routine clink ilogb(x: float64): int32; external "c";
public routine clink ilogbf(x: float32): int32; external "c";
public routine clink ldexp(x: float64; n: int32): float64; external "c";
public routine clink ldexpf(x: float32; n: int32): float32; external "c";
public routine clink lgamma(x: float64): float64; external "c";
public routine clink lgammaf(x: float32): float32; external "c";
public routine clink llrint(x: float64): int64; external "c";
public routine clink llrintf(x: float32): int64; external "c";
public routine clink llround(x: float64): int64; external "c";
public routine clink llroundf(x: float32): int64; external "c";
public routine clink log(x: float64): float64; external "c";
public routine clink logf(x: float32): float32; external "c";
public routine clink log10(x: float64): float64; external "c";
public routine clink log10f(x: float32): float32; external "c";
public routine clink log1p(x: float64): float64; external "c";
