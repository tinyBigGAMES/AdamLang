  This file is covered by the Adam Runtime Exception
  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.Raylib.adam - raylib extended (PaskalCPP's raylib_ext): over
  System.Raylib.C, every raylib routine that loads data from a file name
  gets a form taking a System.CustomIO IO in its place, `<Name>IO(...)`:
  pass the IO CreateZipFileIO gives and raylib loads from a zip, pass any
  IO and it loads from that.

  The IO forms run through System.HookIO's hooks: each registers the IO
  for the call (RegisterIO), hands raylib's own file-name form the path
  `io://<n>/file<type>`, and unregisters it when raylib returns. raylib
  opens and reads that path with its own fopen / fread / fseek / ftell,
  which the hooks give the IO, so the result is the file-name form's for a
  file of the same bytes, read the way raylib reads files (text mode on
  Windows for LoadFileText included), and is unloaded the same way
  (UnloadFileData, UnloadFileText, UnloadImage, ...). The extension is what
  raylib picks a decoder by. The IO is read from its start; it stays the
  caller's: these routines never close it.

  A music stream (LoadMusicStreamIO) is read while it plays, so its IO stays
  registered until UnloadMusicStreamIO. The loaders that read files beside
  the one named (LoadModelIO, LoadMaterialsIO, LoadModelAnimationsIO: a
  glTF's .bin, an OBJ's .mtl, textures) take an IOSource and a path in it:
  the source is registered for the call (RegisterIOSource) and raylib finds
  every sibling in it by its path, through the same hooks. SetRaylibIOSource
  makes an IOSource raylib's whole file system (its four file callbacks and
  HookIO's path source).

  An IO that cannot be registered (nil, no room) is handed to raylib as a
  path no prefix answers (`io://0/file<type>`): raylib gives what it gives
  for a missing file (nil, size 0, an empty image, ...) with its own
  warning.

  The frame window: InitFrameWindow opens raylib's window at a base
  (virtual) size x the frame's zoom (SetFrameZoom) x the monitor's scale
  (DPI / 96), centred, resizable, and follows a DPI change. BeginFrame /
  EndFrame (inside BeginDrawing) draw in base units through a letterboxed
  Camera2D, the aspect kept on resize, maximize and ToggleFrameFullscreen,
  bars outside it; BeginFrameMode2D / BeginFrameMode3D draw the program's
  own Camera2D / Camera3D through the letterbox (the 3D scene at the base
  size's aspect); RestoreFrameClip turns the frame's clip on again.
  GetFrameMousePosition is the mouse in base units. SetFrameIntegerScale
  keeps the letterbox a whole multiple of the base size. GetFrameLetterbox
  is the frame's rectangle in the window now. GetLetterboxRect,
  GetIntegerLetterboxRect, GetScaledFrameSize and GetFramePoint are its
  rules, usable with no window. CloseWindow closes the frame too: the frame
  learns its native window is gone (the platform unit's hook), so a window
  opened after it is never taken for the frame.

  The program icon, with no call of the program's own: the icon @exeicon
  gives is set on raylib's window as GLFW makes it (the platform unit's
  hook); a program's own SetWindowIcon later wins.

  The unit names no OS: the hooked C names it calls (fopen, fread ..) are
  the HookIO platform unit's the target triple picks, and the frame's DPI,
  native window and window hooks are System.Raylib.Win64's /
  System.Raylib.Linux64's.
*******************************************************************************/

module unit System.Raylib;

import System.SysUtils, System.Collections, System.LibC.C, System.Raylib.C, System.CustomIO,
  System.HookIO, System.HookIO.Core
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64, System.Raylib.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64, System.Raylib.Linux64
@endif
  ;

const
  // The prefix no registration ever gives: its paths open as missing files
  ADAM_RAYLIB_NO_PREFIX: string = "io://0";
  // The first room a source callback's whole-file read takes, doubled as it fills
  ADAM_RAYLIB_READ_START: int64 = 65536;
  // The most bytes raylib's int counts
  ADAM_RAYLIB_READ_MAX: int64 = 2147483647;

var
  // The IOSource SetRaylibIOSource last made HookIO's path source (nil: none).
  // SetRaylibIOSource is one setting for the program, not for several threads
  // at once (as raylib's callbacks are not), so it needs no lock.
  GPathSource: IOSource;
  // The prefix of the IOSource SetRaylibIOSource made raylib's file system
  // ("" when none), under GSourceLock. The lock is held only to read or swap
  // the text, never while a file is opened (the hooks take their own).
  GSourceLock: mutex;
  GSourcePrefix: string;
  // The prefix each music stream from LoadMusicStreamIO keeps registered until
  // UnloadMusicStreamIO, by the stream's ctxData address (unique while it
  // plays), under GMusicLock
  GMusicLock: mutex;
  GMusicPrefixes: Map<uint64, string>;

// Records ASource as the path source SetRaylibIOSource set
routine DoRememberPathSource(const ASource: IOSource);
begin
  GPathSource := ASource;
end;

// Unsets HookIO's path source when it is still the one SetRaylibIOSource set; a
// path source the program set since (SetIOPathSource) stays
routine DoForgetPathSource();
begin
  if GPathSource <> nil then
    HookIOResetPathSourceIf(GPathSource);
  end;
  GPathSource := nil;
end;

// The current source's prefix ("" when none), read under its lock
routine DoSourcePrefix(): string;
var
  LPrefix: string;
begin
  lock (GSourceLock) do
    LPrefix := GSourcePrefix;
  end;
  return LPrefix;
end;

// True when AName holds "io://" at AAt
routine DoIsIOPath(const AName: string; const AAt: int64): bool;
begin
  if len(AName) - AAt < 5 then
    return false;
  end;
  return (AName[AAt] = 'i') and (AName[AAt + 1] = 'o') and (AName[AAt + 2] = ':') and
    (AName[AAt + 3] = '/') and (AName[AAt + 4] = '/');
end;

// The path raylib's AFileName names in the current source: an io:// path as it
// is (an IO form's own; after any leading "./" or ".\", which raylib writes
// before a folder with no root, as HookIO reads it), any other as
// `<prefix>/<name>` with '\' turned to '/' and every leading "./" or '/' dropped
// (a source's paths are relative). With no source set, AFileName as it is.
routine DoSourcePath(const AFileName: ptr to const char): string;
var
  LName: string;
  LPrefix: string;
  LSkip: int64;
  LAt: int64;
  LI: int64;
  LDropping: bool;
begin
  LName := "";
  if AFileName <> nil then
    LName := StringFromC(AFileName);
  end;
  LPrefix := DoSourcePrefix();
  if len(LPrefix) = 0 then
    return LName;
  end;
  // An IO form's own path, behind the current-folder steps raylib adds
  LSkip := 0;
  while (len(LName) >= LSkip + 2) and (LName[LSkip] = '.') and
    ((LName[LSkip + 1] = '/') or (LName[LSkip + 1] = '\\')) do
    LSkip := LSkip + 2;
  end;
  if DoIsIOPath(LName, LSkip) then
    return LName;
  end;
  for LI := 0 to len(LName) - 1 do
    if LName[LI] = '\\' then
      LName[LI] := '/';
    end;
  end;
  // Every leading "./" and '/', in any order
  LAt := 0;
  LDropping := true;
  while LDropping do
    LDropping := false;
    if (len(LName) - LAt >= 2) and (LName[LAt] = '.') and (LName[LAt + 1] = '/') then
      LAt := LAt + 2;
      LDropping := true;
    else
      if (len(LName) - LAt >= 1) and (LName[LAt] = '/') then
        LAt := LAt + 1;
        LDropping := true;
      end;
    end;
  end;
  return LPrefix + "/" + Substring(LName, LAt, len(LName) - LAt);
end;

// AText as a NUL-ended C copy for one call (an Adam string has no terminator), freed by
// DoFreeCText; nil when there is no room (raylib then reports an invalid file name)
routine DoCText(const AText: string): ptr to char;
begin
  return StringToC(AText);
end;

// Frees a DoCText copy (nil: nothing)
routine DoFreeCText(const AText: ptr to char);
begin
  if AText <> nil then
    freemem(AText);
  end;
end;

// The whole file at APath, opened with AMode through the hooks, in memory from
// raylib's allocator (UnloadFileData / UnloadFileText free it) with AExtra zero
// bytes after it. nil (ASize 0) when it cannot be opened or read, is empty
// (raylib's loaders give nil for an empty file), or holds more than an int counts.
routine DoReadFile(const APath: string; const AMode: ptr to const char; const AExtra: int64;
  var ASize: int32): ptr to uint8;
var
  LName: ptr to char;
  LFile: ptr;
  LData: ptr to uint8;
  LGrown: ptr to uint8;
  LCapacity: int64;
  LCount: int64;
  LGrow: int64;
  LWant: int64;
  LGot: int64;
  LFailed: bool;
  LI: int64;
begin
  ASize := 0;
  LName := DoCText(APath);
  if LName = nil then
    return nil;
  end;
  LFile := fopen(LName, AMode);
  DoFreeCText(LName);
  if LFile = nil then
    return nil;
  end;
  LData := nil;
  LCapacity := 0;
  LCount := 0;
  LFailed := false;
  while true do
    // Room for one more byte past the count and the extra zero bytes
    if LCount + AExtra + 1 > LCapacity then
      LGrow := ADAM_RAYLIB_READ_START;
      if LCapacity > 0 then
        LGrow := LCapacity * 2;
      end;
      if LGrow > ADAM_RAYLIB_READ_MAX then
        LFailed := true;
        leave;
      end;
      LGrown := ptr to uint8(MemRealloc(LData, uint32(LGrow)));
      if LGrown = nil then
        LFailed := true;
        leave;
      end;
      LData := LGrown;
      LCapacity := LGrow;
    end;
    LWant := LCapacity - LCount - AExtra;
    LGot := fread(LData + LCount, 1, LWant, LFile);
    LCount := LCount + LGot;
    if LGot < LWant then
      LFailed := ferror(LFile) <> 0;
      leave;
    end;
  end;
  fclose(LFile);
  if LFailed or (LCount = 0) then
    MemFree(LData);
    return nil;
  end;
  for LI := 0 to AExtra - 1 do
    LData[LCount + LI] := 0;
  end;
  ASize := int32(LCount);
  return LData;
end;

// raylib's file callbacks while a source is set: each opens the source's path
// through the hooks, as raylib's own file functions would open it
routine clink DoLoadData(fileName: ptr to const char; dataSize: ptr to int32): ptr to uint8;
var
  LSize: int32;
  LData: ptr to uint8;
begin
  LData := DoReadFile(DoSourcePath(fileName), "rb", 0, LSize);
  if LData = nil then
    TraceLog(LOG_WARNING, "FILEIO: [%s] Failed to load file from the IO source", fileName);
  end;
  if dataSize <> nil then
    dataSize^ := LSize;
  end;
  return LData;
end;

routine clink DoLoadText(fileName: ptr to const char): ptr to char;
var
  LSize: int32;
  LText: ptr to char;
begin
  // Text mode, as raylib's LoadFileText opens a file
  LText := ptr to char(DoReadFile(DoSourcePath(fileName), "rt", 1, LSize));
  if LText = nil then
    TraceLog(LOG_WARNING, "FILEIO: [%s] Failed to load text file from the IO source", fileName);
  end;
  return LText;
end;

routine clink DoSaveData(fileName: ptr to const char; data: ptr to const; dataSize: int32): bool;
var
  LPath: ptr to char;
  LFile: ptr;
  LWritten: int64;
  LWant: int64;
  LClosed: bool;
begin
  LPath := DoCText(DoSourcePath(fileName));
  LFile := nil;
  if LPath <> nil then
    LFile := fopen(LPath, "wb");
    DoFreeCText(LPath);
  end;
  if LFile = nil then
    TraceLog(LOG_WARNING, "FILEIO: [%s] Failed to save file to the IO source", fileName);
    return false;
  end;
  LWritten := 0;
  LWant := 0;
  if dataSize > 0 then
    LWant := dataSize;
  end;
  if (data <> nil) and (LWant > 0) then
    LWritten := fwrite(ptr(data), 1, LWant, LFile);
  end;
  LClosed := fclose(LFile) = 0;
  return LClosed and (LWritten = LWant);
end;

routine clink DoSaveText(fileName: ptr to const char; text: ptr to const char): bool;
var
  LPath: ptr to char;
  LFile: ptr;
  LOk: bool;
begin
  LPath := DoCText(DoSourcePath(fileName));
  // Text mode, as raylib's SaveFileText opens a file
  LFile := nil;
  if LPath <> nil then
    LFile := fopen(LPath, "wt");
    DoFreeCText(LPath);
  end;
  if LFile = nil then
    TraceLog(LOG_WARNING, "FILEIO: [%s] Failed to save text file to the IO source", fileName);
    return false;
  end;
  LOk := (text = nil) or (fputs(text, LFile) >= 0);
  if fclose(LFile) <> 0 then
    LOk := false;
  end;
  return LOk;
end;

// Makes APrefix ("" for none) the current source and points raylib's four file
// callbacks at it (none: raylib's own file functions); the prefix it replaces,
// for the caller to unregister
routine DoInstallSource(const APrefix: string): string;
var
  LReplaced: string;
  LSet: bool;
begin
  LSet := len(APrefix) <> 0;
  lock (GSourceLock) do
    LReplaced := GSourcePrefix;
    GSourcePrefix := APrefix;
  end;
  if LSet then
    SetLoadFileDataCallback(DoLoadData);
    SetSaveFileDataCallback(DoSaveData);
    SetLoadFileTextCallback(DoLoadText);
    SetSaveFileTextCallback(DoSaveText);
  else
    SetLoadFileDataCallback(nil);
    SetSaveFileDataCallback(nil);
    SetLoadFileTextCallback(nil);
    SetSaveFileTextCallback(nil);
  end;
  return LReplaced;
end;

// Keeps APrefix for the music stream AKey
routine DoKeepMusic(const AKey: ptr; const APrefix: string);
begin
  lock (GMusicLock) do
    GMusicPrefixes.Put(uint64(AKey), APrefix);
  end;
end;

// Takes (removes) the prefix kept for the music stream AKey; "" when none is
routine DoTakeMusic(const AKey: ptr): string;
var
  LPrefix: string;
begin
  LPrefix := "";
  lock (GMusicLock) do
    if GMusicPrefixes.TryGet(uint64(AKey), LPrefix) then
      GMusicPrefixes.Remove(uint64(AKey));
    end;
  end;
  return LPrefix;
end;

// A letter folded to lower case, as raylib's IsFileExtension compares
routine DoLowerChar(const AChar: char): char;
begin
  if (AChar >= 'A') and (AChar <= 'Z') then
    return char(uint8(AChar) - uint8('A') + uint8('a'));
  end;
  return AChar;
end;

// True when AFileType (".ttf", ".PNG", ...) is one of the ';'-separated
// extensions in AList, letter case aside, as raylib's IsFileExtension compares
routine DoIsType(const AFileType: ptr to const char; const AList: string): bool;
var
  LType: string;
  LItems: array of string;
  LI: int64;
  LJ: int64;
  LSame: bool;
begin
  if AFileType = nil then
    return false;
  end;
  LType := StringFromC(AFileType);
  LItems := SplitString(AList, ";");
  for LI := 0 to len(LItems) - 1 do
    if len(LItems[LI]) = len(LType) then
      LSame := true;
      for LJ := 0 to len(LType) - 1 do
        if DoLowerChar(LType[LJ]) <> DoLowerChar(LItems[LI][LJ]) then
          LSame := false;
          leave;
        end;
      end;
      if LSame then
        return true;
      end;
    end;
  end;
  return false;
end;

// AIO registered with HookIO for one call: its prefix, or the prefix no
// registration gives when AIO cannot be registered
routine DoRegister(const AIO: IO): string;
var
  LPrefix: string;
begin
  LPrefix := RegisterIO(AIO);
  if len(LPrefix) = 0 then
    return ADAM_RAYLIB_NO_PREFIX;
  end;
  return LPrefix;
end;

// ASource registered with HookIO for one call, as DoRegister
routine DoRegisterSource(const ASource: IOSource): string;
var
  LPrefix: string;
begin
  LPrefix := RegisterIOSource(ASource);
  if len(LPrefix) = 0 then
    return ADAM_RAYLIB_NO_PREFIX;
  end;
  return LPrefix;
end;

// Ends DoRegister's / DoRegisterSource's registration
routine DoUnregister(const APrefix: string);
begin
  if APrefix <> ADAM_RAYLIB_NO_PREFIX then
    UnregisterIO(APrefix);
  end;
end;

// The path raylib is handed: `<prefix>/file<type>` (no type: `<prefix>/file`)
routine DoPath(const APrefix: string; const AFileType: ptr to const char): string;
begin
  if AFileType = nil then
    return APrefix + "/file";
  end;
  return APrefix + "/file" + StringFromC(AFileType);
end;

/// Loads an IO's bytes as LoadFileData loads a file's (raylib's own
/// LoadFileData reads it through the hooks), in memory that UnloadFileData
/// frees. The IO stays the caller's.
/// @param AIO the stream (CreateZipFileIO's, CreateFileIO's, any IO)
/// @param ADataSize the byte count; 0 on a failure
/// @returns the bytes, or nil (with raylib's warning) when the IO is nil,
///   empty, or cannot be read
/// @example `LData := LoadFileDataIO(CreateZipFileIO("$P:assets.zip", "level1.bin"), LSize);`
/// @see LoadFileTextIO
public routine cpplink LoadFileDataIO(const AIO: IO; var ADataSize: int32): ptr to uint8;
var
  LPrefix: string;
  LPath: ptr to char;
  LData: ptr to uint8;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, nil));
  LData := LoadFileData(LPath, addr of ADataSize);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LData;
end;

/// Loads an IO's bytes as text, as LoadFileText loads a file (raylib's own
/// LoadFileText reads it through the hooks, in text mode on Windows),
/// '\0'-terminated, in memory that UnloadFileText frees. The IO stays the
/// caller's.
/// @param AIO the stream
/// @returns the text, or nil (with raylib's warning) when the IO is nil or
///   cannot be read
/// @example `LText := LoadFileTextIO(CreateZipFileIO("$P:assets.zip", "intro.txt"));`
/// @see LoadFileDataIO
public routine cpplink LoadFileTextIO(const AIO: IO): ptr to char;
var
  LPrefix: string;
  LPath: ptr to char;
  LText: ptr to char;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, nil));
  LText := LoadFileText(LPath);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LText;
end;

/// Loads an image from an IO as LoadImage loads one from a file (raylib's
/// own LoadImage reads it through the hooks); unload with UnloadImage.
/// @param AIO the stream
/// @param AFileType the file type, its extension: ".png", ".jpg", ...
/// @returns the image; an empty one (data nil) when the IO cannot be read
///   or its bytes do not decode
/// @example `LImage := LoadImageIO(CreateZipFileIO("$P:assets.zip", "hero.png"), ".png");`
/// @see LoadTextureIO
public routine cpplink LoadImageIO(const AIO: IO; const AFileType: ptr to const char): Image;
var
  LPrefix: string;
  LPath: ptr to char;
  LImage: Image;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, AFileType));
  LImage := LoadImage(LPath);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LImage;
end;

/// Loads raw pixel data from an IO as LoadImageRaw loads it from a file
/// (raylib's own LoadImageRaw reads it through the hooks): the pixels after
/// AHeaderSize bytes; unload with UnloadImage.
/// @param AIO the stream
/// @param AWidth the image width in pixels
/// @param AHeight the image height in pixels
/// @param AFormat a PixelFormat value
/// @param AHeaderSize bytes to skip before the pixels
/// @returns the image; an empty one when LoadImageRaw gives one for a file
///   of the same bytes, or the IO cannot be read
/// @example `LImage := LoadImageRawIO(LIO, 64, 64, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 16);`
/// @see LoadImageIO
public routine cpplink LoadImageRawIO(const AIO: IO; const AWidth: int32; const AHeight: int32;
  const AFormat: int32; const AHeaderSize: int32): Image;
var
  LPrefix: string;
  LPath: ptr to char;
  LImage: Image;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, ".raw"));
  LImage := LoadImageRaw(LPath, AWidth, AHeight, AFormat, AHeaderSize);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LImage;
end;

/// Loads an image sequence from an IO as LoadImageAnim loads one from a
/// file (raylib's own LoadImageAnim reads it through the hooks; frames
/// appended to the image data); unload with UnloadImage.
/// @param AIO the stream
/// @param AFileType the file type: ".gif" (any other image type loads one
///   frame)
/// @param AFrames the frame count; 0 on a failure
/// @returns the image; an empty one on a failure
/// @example `LAnim := LoadImageAnimIO(LIO, ".gif", LFrames);`
/// @see LoadImageIO
public routine cpplink LoadImageAnimIO(const AIO: IO; const AFileType: ptr to const char;
  var AFrames: int32): Image;
var
  LPrefix: string;
  LPath: ptr to char;
  LImage: Image;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, AFileType));
  LImage := LoadImageAnim(LPath, addr of AFrames);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LImage;
end;

/// Loads a texture from an IO as LoadTexture loads one from a file
/// (raylib's own LoadTexture reads it through the hooks); unload with
/// UnloadTexture. Needs a window, as LoadTexture does.
/// @param AIO the stream
/// @param AFileType the file type: ".png", ...
/// @returns the texture; an empty one (id 0) on a failure
/// @example `LTexture := LoadTextureIO(CreateZipFileIO("$P:assets.zip", "hero.png"), ".png");`
/// @see LoadImageIO
public routine cpplink LoadTextureIO(const AIO: IO; const AFileType: ptr to const char): Texture2D;
var
  LPrefix: string;
  LPath: ptr to char;
  LTexture: Texture2D;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, AFileType));
  LTexture := LoadTexture(LPath);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LTexture;
end;

/// Loads a font from an IO as LoadFont loads one from a file (raylib's own
/// LoadFont reads it through the hooks): a TTF / OTF at raylib's default
/// size and characters, any image type as an image font. A .fnt reads its
/// page images by name beside it, which one IO cannot hold, so it is
/// refused here (an empty font and a warning): route it through an
/// IOSource. Unload with UnloadFont; needs a window, as LoadFont does.
/// @param AIO the stream
/// @param AFileType the file type: ".ttf", ".otf", ".png", ...
/// @returns the font; on a failure what LoadFont gives for such a file
/// @example `LFont := LoadFontIO(CreateZipFileIO("$P:assets.zip", "ui.ttf"), ".ttf");`
/// @see LoadFontExIO
public routine cpplink LoadFontIO(const AIO: IO; const AFileType: ptr to const char): Font;
var
  LPrefix: string;
  LPath: ptr to char;
  LFont: Font;
begin
  if DoIsType(AFileType, ".fnt") then
    TraceLog(LOG_WARNING, "FONT: A .fnt reads its pages by name: load it through an IOSource");
    return LFont;
  end;
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, AFileType));
  LFont := LoadFont(LPath);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LFont;
end;

/// Loads a font from an IO as LoadFontEx loads one from a file (raylib's
/// own LoadFontEx reads it through the hooks), at AFontSize with the given
/// codepoints (nil and 0 for raylib's default set); unload with UnloadFont.
/// Needs a window.
/// @param AIO the stream
/// @param AFileType the file type: ".ttf", ".otf"
/// @param AFontSize the size the glyphs are made at
/// @param ACodepoints the codepoints, or nil
/// @param ACodepointCount how many, or 0
/// @returns the font; on a failure what LoadFontEx gives for such a file
/// @example `LFont := LoadFontExIO(LIO, ".ttf", 48, nil, 0);`
/// @see LoadFontIO
public routine cpplink LoadFontExIO(const AIO: IO; const AFileType: ptr to const char;
  const AFontSize: int32; const ACodepoints: ptr to const int32; const ACodepointCount: int32): Font;
var
  LPrefix: string;
  LPath: ptr to char;
  LFont: Font;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, AFileType));
  LFont := LoadFontEx(LPath, AFontSize, ACodepoints, ACodepointCount);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LFont;
end;

/// Loads wave data from an IO as LoadWave loads it from a file (raylib's
/// own LoadWave reads it through the hooks); unload with UnloadWave.
/// @param AIO the stream
/// @param AFileType the file type raylib decodes by: ".wav", ".ogg",
///   ".mp3", ".qoa", ".flac"
/// @returns the wave; an empty one (data nil) on a failure
/// @example `LWave := LoadWaveIO(CreateZipFileIO("$P:assets.zip", "hit.wav"), ".wav");`
/// @see LoadSoundIO
public routine cpplink LoadWaveIO(const AIO: IO; const AFileType: ptr to const char): Wave;
var
  LPrefix: string;
  LPath: ptr to char;
  LWave: Wave;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, AFileType));
  LWave := LoadWave(LPath);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LWave;
end;

/// Loads a sound (a sound effect, fully in memory) from an IO as LoadSound
/// loads one from a file (raylib's own LoadSound reads it through the
/// hooks); unload with UnloadSound. Needs the audio device, as LoadSound
/// does.
/// @param AIO the stream
/// @param AFileType the file type: ".wav", ".ogg", ".mp3", ".qoa", ".flac"
/// @returns the sound; an empty one on a failure
/// @example `LHit := LoadSoundIO(CreateZipFileIO("$P:assets.zip", "hit.wav"), ".wav");`
/// @see LoadWaveIO
public routine cpplink LoadSoundIO(const AIO: IO; const AFileType: ptr to const char): Sound;
var
  LPrefix: string;
  LPath: ptr to char;
  LSound: Sound;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, AFileType));
  LSound := LoadSound(LPath);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LSound;
end;

/// Loads a music stream from an IO as LoadMusicStream loads one from a
/// file: raylib's own LoadMusicStream opens it through the hooks, and every
/// read and seek while it plays goes to the IO (nothing is read ahead into
/// memory but what raylib itself reads). The IO stays registered until
/// UnloadMusicStreamIO, so it must stay open while the music plays. Unload
/// with UnloadMusicStreamIO, never UnloadMusicStream. Needs the audio
/// device.
/// @param AIO the stream
/// @param AFileType the file type: ".ogg", ".mp3", ".wav", ".qoa", ".flac",
///   ".xm", ".mod"
/// @returns the music; an empty one (ctxData nil) on a failure
/// @example `LSong := LoadMusicStreamIO(CreateZipFileIO("$P:assets.zip", "song.ogg"), ".ogg");`
/// @see UnloadMusicStreamIO
public routine cpplink LoadMusicStreamIO(const AIO: IO; const AFileType: ptr to const char): Music;
var
  LPrefix: string;
  LPath: ptr to char;
  LMusic: Music;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, AFileType));
  LMusic := LoadMusicStream(LPath);
  DoFreeCText(LPath);
  if LMusic.ctxData = nil then
    DoUnregister(LPrefix);
    return LMusic;
  end;
  if LPrefix <> ADAM_RAYLIB_NO_PREFIX then
    DoKeepMusic(LMusic.ctxData, LPrefix);
  end;
  return LMusic;
end;

/// Unloads a music stream LoadMusicStreamIO gave (UnloadMusicStream), then
/// ends its IO's registration. The IO stays the caller's, to close after.
/// @param AMusic the music
/// @example `UnloadMusicStreamIO(LSong); IOClose(LSongIO);`
/// @see LoadMusicStreamIO
public routine cpplink UnloadMusicStreamIO(const AMusic: Music);
var
  LPrefix: string;
begin
  LPrefix := DoTakeMusic(AMusic.ctxData);
  UnloadMusicStream(AMusic);
  if len(LPrefix) <> 0 then
    UnregisterIO(LPrefix);
  end;
end;

/// Loads a shader from two IOs as LoadShader loads one from two files
/// (raylib's own LoadShader reads them through the hooks); unload with
/// UnloadShader. Needs a window.
/// @param AVertex the vertex shader's source, or nil for raylib's default
///   vertex shader (as LoadShader with NULL)
/// @param AFragment the fragment shader's source, or nil for the default
/// @returns the shader; raylib's default shader on a failure, as LoadShader
///   gives
/// @example `LShader := LoadShaderIO(nil, CreateZipFileIO("$P:assets.zip", "glow.fs"));`
public routine cpplink LoadShaderIO(const AVertex: IO; const AFragment: IO): Shader;
var
  LVertexPrefix: string;
  LFragmentPrefix: string;
  LVertexPath: ptr to char;
  LFragmentPath: ptr to char;
  LVertexName: ptr to const char;
  LFragmentName: ptr to const char;
  LShader: Shader;
begin
  LVertexName := nil;
  LFragmentName := nil;
  LVertexPath := nil;
  LFragmentPath := nil;
  LVertexPrefix := ADAM_RAYLIB_NO_PREFIX;
  LFragmentPrefix := ADAM_RAYLIB_NO_PREFIX;
  if AVertex <> nil then
    LVertexPrefix := DoRegister(AVertex);
    LVertexPath := DoCText(DoPath(LVertexPrefix, ".vs"));
    LVertexName := LVertexPath;
  end;
  if AFragment <> nil then
    LFragmentPrefix := DoRegister(AFragment);
    LFragmentPath := DoCText(DoPath(LFragmentPrefix, ".fs"));
    LFragmentName := LFragmentPath;
  end;
  LShader := LoadShader(LVertexName, LFragmentName);
  DoFreeCText(LVertexPath);
  DoFreeCText(LFragmentPath);
  DoUnregister(LVertexPrefix);
  DoUnregister(LFragmentPrefix);
  return LShader;
end;

/// Loads an automation event list from an IO as LoadAutomationEventList
/// loads one from a file (raylib's own loader reads it through the hooks);
/// unload with UnloadAutomationEventList.
/// @param AIO the stream (raylib's .rae events); nil gives an empty list
///   with raylib's capacity, as LoadAutomationEventList(NULL)
/// @returns the list
/// @example `LEvents := LoadAutomationEventListIO(CreateZipFileIO("$P:demo.zip", "run.rae"));`
public routine cpplink LoadAutomationEventListIO(const AIO: IO): AutomationEventList;
var
  LPrefix: string;
  LPath: ptr to char;
  LList: AutomationEventList;
begin
  if AIO = nil then
    return LoadAutomationEventList(nil);
  end;
  LPrefix := DoRegister(AIO);
  LPath := DoCText(DoPath(LPrefix, ".rae"));
  LList := LoadAutomationEventList(LPath);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LList;
end;

/// Loads a model from an IOSource as LoadModel loads one from a file:
/// raylib's own LoadModel opens APath in the source through the hooks, and
/// every file it reads beside it (a glTF's .bin, an OBJ's .mtl, textures)
/// is read from the source by its path too. Unload with UnloadModel; needs
/// a window.
/// @param ASource the files (CreateZipIOSource's, a folder's, any source)
/// @param APath the model's path in the source: "models/hero.gltf"
/// @returns the model; what LoadModel gives for a missing file on a failure
/// @example `LHero := LoadModelIO(CreateZipIOSource("$P:assets.zip"), "models/hero.gltf");`
/// @see LoadMaterialsIO
public routine cpplink LoadModelIO(const ASource: IOSource; const APath: string): Model;
var
  LPrefix: string;
  LPath: ptr to char;
  LModel: Model;
begin
  LPrefix := DoRegisterSource(ASource);
  LPath := DoCText(LPrefix + "/" + APath);
  LModel := LoadModel(LPath);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LModel;
end;

/// Loads the materials of a model file in an IOSource as LoadMaterials
/// does from a file (through the hooks, siblings from the source too).
/// @param ASource the files
/// @param APath the material file's path in the source: "models/hero.mtl"
/// @param AMaterialCount the count; 0 on a failure
/// @returns the materials, or what LoadMaterials gives for a missing file
/// @example `LMats := LoadMaterialsIO(LSource, "models/hero.mtl", LCount);`
/// @see LoadModelIO
public routine cpplink LoadMaterialsIO(const ASource: IOSource; const APath: string;
  var AMaterialCount: int32): ptr to Material;
var
  LPrefix: string;
  LPath: ptr to char;
  LMaterials: ptr to Material;
begin
  LPrefix := DoRegisterSource(ASource);
  LPath := DoCText(LPrefix + "/" + APath);
  LMaterials := LoadMaterials(LPath, addr of AMaterialCount);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LMaterials;
end;

/// Loads the animations of a model file in an IOSource as
/// LoadModelAnimations does from a file (through the hooks, siblings from
/// the source too); unload with UnloadModelAnimations.
/// @param ASource the files
/// @param APath the model's path in the source: "models/hero.glb"
/// @param AAnimCount the count; 0 on a failure
/// @returns the animations, or what LoadModelAnimations gives for a missing
///   file
/// @example `LAnims := LoadModelAnimationsIO(LSource, "models/hero.glb", LCount);`
/// @see LoadModelIO
public routine cpplink LoadModelAnimationsIO(const ASource: IOSource; const APath: string;
  var AAnimCount: int32): ptr to ModelAnimation;
var
  LPrefix: string;
  LPath: ptr to char;
  LAnimations: ptr to ModelAnimation;
begin
  LPrefix := DoRegisterSource(ASource);
  LPath := DoCText(LPrefix + "/" + APath);
  LAnimations := LoadModelAnimations(LPath, addr of AAnimCount);
  DoFreeCText(LPath);
  DoUnregister(LPrefix);
  return LAnimations;
end;

/// Makes an IOSource raylib's file system: raylib's file callbacks
/// (SetLoadFileDataCallback, SetLoadFileTextCallback and the Save pair)
/// then open every file name raylib loads or saves in the source, by that
/// name as a path in it ('\' as '/', a leading "./" or '/' dropped), through
/// the hooks; text loads and saves in text mode, as raylib's own. Paths the
/// IO forms hand raylib (`io://...`) still reach their IO. nil restores
/// raylib's own file functions (the callbacks set to NULL). raylib keeps
/// one set of callbacks for the process with no user data, so this is one
/// setting for the whole program, and not for several threads at once, as
/// raylib's callbacks are not. The source stays the caller's: unset it
/// (nil) before closing it. Setting it replaces callbacks set by
/// SetLoadFileDataCallback and the others, and nil leaves none set. It also
/// makes the source HookIO's path source (SetIOPathSource), so the files
/// raylib's decoders open by plain path themselves (music streams) come
/// from it too; nil unsets that path source when it is still the one set
/// here (one the program set since with SetIOPathSource stays).
/// @param ASource the files, or nil
/// @returns false when the source could not be registered (no room):
///   nothing changed
/// @example `SetRaylibIOSource(CreateZipIOSource("$P:assets.zip")); LHero := LoadModel("models/hero.gltf");`
/// @see LoadModelIO
public routine cpplink SetRaylibIOSource(const ASource: IOSource): bool;
var
  LPrefix: string;
  LReplaced: string;
begin
  LPrefix := "";
  if ASource <> nil then
    LPrefix := RegisterIOSource(ASource);
    if len(LPrefix) = 0 then
      return false;
    end;
  end;
  // The plain paths raylib's own decoders open (music streams) bypass the
  // callbacks: the path source routes them to the same source. nil unsets only
  // the path source set here, never one the program set itself.
  if ASource <> nil then
    if not SetIOPathSource(ASource) then
      UnregisterIO(LPrefix);
      return false;
    end;
    DoRememberPathSource(ASource);
  else
    DoForgetPathSource();
  end;
  LReplaced := DoInstallSource(LPrefix);
  if len(LReplaced) <> 0 then
    UnregisterIO(LReplaced);
  end;
  return true;
end;

// ---------------------------------------------------------------------------------------------
// The frame window (pcpp's raylib_ext frame): a window opened at a base (virtual) size x the
// zoom x the monitor's scale (DPI / 96), drawn in base units through a letterboxed Camera2D,
// the mouse mapped back to them. The DPI is the OS's, asked through the platform unit.
// ---------------------------------------------------------------------------------------------

// GLFW names raylib links statically (its header is not shipped): the monitor list and a
// monitor's work area
routine glfwGetMonitors(const ACount: ptr to int32): ptr to ptr; external "raylib";
routine glfwGetMonitorWorkarea(const AMonitor: ptr; const AX: ptr to int32; const AY: ptr to int32;
  const AWidth: ptr to int32; const AHeight: ptr to int32); external "raylib";

const
  // The DPI the base size is drawn for (scale 1)
  ADAM_RAYLIB_BASE_DPI: int32 = 96;

type
  // The frame as it stands
  FrameWindow = record
    Open: bool;
    BaseWidth: int32;
    BaseHeight: int32;
    Dpi: int32;
    // FLAG_WINDOW_HIGHDPI was set too: raylib sized the window and maps the mouse itself, so
    // the frame window never resizes for the DPI (no stacking)
    RaylibScales: bool;
    // SetFrameIntegerScale: the letterbox a whole multiple of the base size
    IntegerScale: bool;
    // SetFrameZoom: the window's normal size is base x Zoom x the DPI scale
    Zoom: float32;
    FrameColor: Color;
    BarColor: Color;
    Camera: Camera2D;
    Letterbox: Rectangle;
    Mouse: Vector2;
    LastDpiCheck: float64;
    // The native window (Windows' HWND, X11's Window id): its destruction is the frame's close
    NativeWindow: uint64;
  end;

var
  // The frame (raylib's one window per program; raylib's calls are one thread's, so no lock);
  // GFrameReady false until its settings got their defaults (DoFrameState)
  GFrame: FrameWindow;
  GFrameReady: bool;

// AFrame as no frame window: zeroed, the DPI the base's, the colours WHITE / BLACK, no
// integer scale, zoom 1
routine DoFrameDefaults(var AFrame: FrameWindow);
begin
  AFrame.Open := false;
  AFrame.BaseWidth := 0;
  AFrame.BaseHeight := 0;
  AFrame.Dpi := ADAM_RAYLIB_BASE_DPI;
  AFrame.RaylibScales := false;
  AFrame.IntegerScale := false;
  AFrame.Zoom := 1.0f;
  AFrame.FrameColor := WHITE;
  AFrame.BarColor := BLACK;
  AFrame.Camera.offset := Vector2(x: 0.0f, y: 0.0f);
  AFrame.Camera.target := Vector2(x: 0.0f, y: 0.0f);
  AFrame.Camera.rotation := 0.0f;
  AFrame.Camera.zoom := 0.0f;
  AFrame.Letterbox := Rectangle(x: 0.0f, y: 0.0f, width: 0.0f, height: 0.0f);
  AFrame.Mouse := Vector2(x: 0.0f, y: 0.0f);
  AFrame.LastDpiCheck := 0.0;
  AFrame.NativeWindow := 0;
end;

// AFrame back to "no frame window", the frame and bar colours, the integer-scale rule and
// the zoom (the program's settings) kept
routine DoFrameReset(var AFrame: FrameWindow);
var
  LFrameColor: Color;
  LBarColor: Color;
  LIntegerScale: bool;
  LZoom: float32;
begin
  LFrameColor := AFrame.FrameColor;
  LBarColor := AFrame.BarColor;
  LIntegerScale := AFrame.IntegerScale;
  LZoom := AFrame.Zoom;
  DoFrameDefaults(AFrame);
  AFrame.FrameColor := LFrameColor;
  AFrame.BarColor := LBarColor;
  AFrame.IntegerScale := LIntegerScale;
  AFrame.Zoom := LZoom;
end;

// The frame's settings given their defaults the first time it is read
routine DoFrameState();
begin
  if not GFrameReady then
    DoFrameDefaults(GFrame);
    GFrameReady := true;
  end;
end;

// The frame as it stands, read by every frame routine. Its close is seen as its native
// window goes (DoFrameWindowGone, from CloseWindow through GLFW), so a window opened after it
// is never taken for the frame; a frame whose raylib window is not there is closed too.
routine DoFrameLive();
begin
  DoFrameState();
  if GFrame.Open and not IsWindowReady() then
    DoFrameReset(GFrame);
  end;
end;

// The platform unit's notice: the native window AWindow goes (the frame's own: closed)
routine DoFrameWindowGone(const AWindow: uint64);
begin
  DoFrameState();
  if GFrame.Open and (AWindow <> 0) and (AWindow = GFrame.NativeWindow) then
    DoFrameReset(GFrame);
  end;
end;

// The DPI raylib's window is shown at now (the platform's answer; the base DPI when it has
// none)
routine DoQueryDpi(): int32;
var
  LDpi: int32;
begin
  LDpi := RaylibPlatformQueryDpi(GetWindowHandle());
  if LDpi <= 0 then
    return ADAM_RAYLIB_BASE_DPI;
  end;
  return LDpi;
end;

// C's lround of a float32 / float64 (halfway away from zero) as an int32
routine DoRound(const AValue: float32): int32;
begin
  return int32(lroundf(AValue));
end;

routine DoRound(const AValue: float64): int32;
begin
  return int32(lround(AValue));
end;

// The frame's base size x its zoom, each side rounded: the window's normal size at 96 DPI
// (the DPI scale goes on top, DoScaledSize)
routine DoZoomedWidth(): int32;
begin
  return DoRound(float32(GFrame.BaseWidth) * GFrame.Zoom);
end;

routine DoZoomedHeight(): int32;
begin
  return DoRound(float32(GFrame.BaseHeight) * GFrame.Zoom);
end;

// ABase scaled for ADpi, each side rounded
routine DoScaledSize(const ABaseWidth: int32; const ABaseHeight: int32; const ADpi: int32): Vector2;
var
  LScale: float64;
begin
  LScale := float64(ADpi) / float64(ADAM_RAYLIB_BASE_DPI);
  return Vector2(x: float32(DoRound(float64(ABaseWidth) * LScale)),
    y: float32(DoRound(float64(ABaseHeight) * LScale)));
end;

// The rectangle (window units) that fits ABase's aspect into AWindow, centred, bars outside
// it; the whole window when a size is 0 or less
routine DoLetterbox(const AWindowWidth: int32; const AWindowHeight: int32; const ABaseWidth: int32;
  const ABaseHeight: int32): Rectangle;
var
  LRect: Rectangle;
  LWindowRatio: float32;
  LBaseRatio: float32;
begin
  LRect := Rectangle(x: 0.0f, y: 0.0f, width: float32(AWindowWidth), height: float32(AWindowHeight));
  if (AWindowWidth <= 0) or (AWindowHeight <= 0) or (ABaseWidth <= 0) or (ABaseHeight <= 0) then
    return LRect;
  end;
  LWindowRatio := float32(AWindowWidth) / float32(AWindowHeight);
  LBaseRatio := float32(ABaseWidth) / float32(ABaseHeight);
  if LWindowRatio >= LBaseRatio then
    // Wider than the frame: bars left and right
    LRect.width := float32(AWindowHeight) * LBaseRatio;
    LRect.x := (float32(AWindowWidth) - LRect.width) / 2.0f;
  else
    // Taller than the frame: bars above and below
    LRect.height := float32(AWindowWidth) / LBaseRatio;
    LRect.y := (float32(AWindowHeight) - LRect.height) / 2.0f;
  end;
  return LRect;
end;

// The rectangle (window units) of the largest WHOLE multiple of ABase that fits into
// AWindow, centred on whole pixels, bars around it. The multiple is taken in framebuffer
// pixels (APixelsPerUnit of them per window unit), so each base pixel covers the same square
// of real pixels on a scaled display too. A window smaller than one base size gets the fit
// rule instead (never an empty frame); a size of 0 gives the whole window.
routine DoIntegerLetterbox(const AWindowWidth: int32; const AWindowHeight: int32;
  const ABaseWidth: int32; const ABaseHeight: int32; const APixelsPerUnit: float32): Rectangle;
var
  LPixelWidth: int32;
  LPixelHeight: int32;
  LMultiple: int32;
  LWidth: int32;
  LHeight: int32;
  LX: int32;
  LY: int32;
begin
  if (AWindowWidth <= 0) or (AWindowHeight <= 0) or (ABaseWidth <= 0) or (ABaseHeight <= 0) or
    (APixelsPerUnit <= 0.0f) then
    return DoLetterbox(AWindowWidth, AWindowHeight, ABaseWidth, ABaseHeight);
  end;
  LPixelWidth := DoRound(float32(AWindowWidth) * APixelsPerUnit);
  LPixelHeight := DoRound(float32(AWindowHeight) * APixelsPerUnit);
  LMultiple := LPixelWidth div ABaseWidth;
  if LPixelHeight div ABaseHeight < LMultiple then
    LMultiple := LPixelHeight div ABaseHeight;
  end;
  if LMultiple < 1 then
    return DoLetterbox(AWindowWidth, AWindowHeight, ABaseWidth, ABaseHeight);
  end;
  // Whole pixels throughout: the size is exact, the centring rounds down
  LWidth := ABaseWidth * LMultiple;
  LHeight := ABaseHeight * LMultiple;
  LX := (LPixelWidth - LWidth) div 2;
  LY := (LPixelHeight - LHeight) div 2;
  return Rectangle(x: float32(LX) / APixelsPerUnit, y: float32(LY) / APixelsPerUnit,
    width: float32(LWidth) / APixelsPerUnit, height: float32(LHeight) / APixelsPerUnit);
end;

// The frame's letterbox for the window as it is now, under its rule (fit, or a whole
// multiple): the one rule BeginFrame, the mouse and GetFrameLetterbox share
routine DoLetterboxNow(): Rectangle;
var
  LPixelsPerUnit: float32;
begin
  if not GFrame.IntegerScale then
    return DoLetterbox(GetScreenWidth(), GetScreenHeight(), GFrame.BaseWidth, GFrame.BaseHeight);
  end;
  // Framebuffer pixels per window unit: more than 1 when raylib scales the window itself
  // (FLAG_WINDOW_HIGHDPI)
  LPixelsPerUnit := 1.0f;
  if GetScreenWidth() > 0 then
    LPixelsPerUnit := float32(GetRenderWidth()) / float32(GetScreenWidth());
  end;
  return DoIntegerLetterbox(GetScreenWidth(), GetScreenHeight(), GFrame.BaseWidth,
    GFrame.BaseHeight, LPixelsPerUnit);
end;

// AValue held to [ALow, AHigh] (std::clamp's rule)
routine DoClamp(const AValue: float32; const ALow: float32; const AHigh: float32): float32;
begin
  if AValue < ALow then
    return ALow;
  end;
  if AHigh < AValue then
    return AHigh;
  end;
  return AValue;
end;

// A window point (window units) in frame units through the letterbox ALetterbox of a ABase
// frame, clamped to the frame and rounded
routine DoFramePoint(const APoint: Vector2; const ALetterbox: Rectangle; const ABaseWidth: int32;
  const ABaseHeight: int32): Vector2;
var
  LX: float32;
  LY: float32;
begin
  if (ALetterbox.width <= 0.0f) or (ALetterbox.height <= 0.0f) or (ABaseWidth <= 0) or
    (ABaseHeight <= 0) then
    return Vector2(x: 0.0f, y: 0.0f);
  end;
  LX := (APoint.x - ALetterbox.x) * float32(ABaseWidth) / ALetterbox.width;
  LY := (APoint.y - ALetterbox.y) * float32(ABaseHeight) / ALetterbox.height;
  return Vector2(x: float32(DoRound(DoClamp(LX, 0.0f, float32(ABaseWidth - 1)))),
    y: float32(DoRound(DoClamp(LY, 0.0f, float32(ABaseHeight - 1)))));
end;

// The window at the base size x the zoom x the scale (a window at its normal size only:
// fullscreen, borderless, maximized and minimized are the system's), centred on its
// monitor's work area when ACenter
routine DoApplyScale(const ACenter: bool);
var
  LSize: Vector2;
  LMonitor: int32;
  LMonitors: ptr to ptr;
  LCount: int32;
  LAreaX: int32;
  LAreaY: int32;
  LAreaWidth: int32;
  LAreaHeight: int32;
  LPosition: Vector2;
  LLeft: int32;
  LTop: int32;
begin
  DoFrameLive();
  if GFrame.RaylibScales or IsWindowFullscreen() or
    IsWindowState(uint32(FLAG_BORDERLESS_WINDOWED_MODE)) or IsWindowMaximized() or
    IsWindowMinimized() then
    return;
  end;
  LSize := DoScaledSize(DoZoomedWidth(), DoZoomedHeight(), GFrame.Dpi);
  SetWindowSize(int32(LSize.x), int32(LSize.y));
  if not ACenter then
    return;
  end;

  LCount := 0;
  LAreaX := 0;
  LAreaY := 0;
  LAreaWidth := 0;
  LAreaHeight := 0;
  LMonitor := GetCurrentMonitor();
  LMonitors := glfwGetMonitors(addr of LCount);
  if (LMonitors <> nil) and (LMonitor >= 0) and (LMonitor < LCount) then
    glfwGetMonitorWorkarea(LMonitors[LMonitor], addr of LAreaX, addr of LAreaY,
      addr of LAreaWidth, addr of LAreaHeight);
  end;
  if (LAreaWidth <= 0) or (LAreaHeight <= 0) then
    LPosition := GetMonitorPosition(LMonitor);
    LAreaX := int32(LPosition.x);
    LAreaY := int32(LPosition.y);
    LAreaWidth := GetMonitorWidth(LMonitor);
    LAreaHeight := GetMonitorHeight(LMonitor);
  end;
  // Centred; a window larger than the area starts at its top left
  LLeft := (LAreaWidth - int32(LSize.x)) div 2;
  if LLeft < 0 then
    LLeft := 0;
  end;
  LTop := (LAreaHeight - int32(LSize.y)) div 2;
  if LTop < 0 then
    LTop := 0;
  end;
  SetWindowPosition(LAreaX + LLeft, LAreaY + LTop);
end;

// The DPI asked again when its check is due (each frame on Windows, a cheap call; once a
// second on X11, a round trip to the server); a change resizes the window
routine DoFollowDpi();
var
  LDpi: int32;
begin
  if GetTime() - GFrame.LastDpiCheck < ADAM_RAYLIB_DPI_CHECK_SECONDS then
    return;
  end;
  GFrame.LastDpiCheck := GetTime();
  LDpi := DoQueryDpi();
  if LDpi = GFrame.Dpi then
    return;
  end;
  GFrame.Dpi := LDpi;
  DoApplyScale(false);
end;

// The frame's clip: drawing held to the letterbox, in whole window units (BeginFrame's and
// RestoreFrameClip's one rule)
routine DoFrameClip();
begin
  BeginScissorMode(DoRound(GFrame.Letterbox.x), DoRound(GFrame.Letterbox.y),
    DoRound(GFrame.Letterbox.width), DoRound(GFrame.Letterbox.height));
end;

// ACamera (in base units) composed with the frame's camera: raylib's BeginMode2D replaces
// the matrix, so the two are folded into one. The frame's camera is T(offset) S(zoom) (target
// 0, no rotation); a uniform scale commutes with a rotation, so the product is again one
// Camera2D
routine DoFrameCompose(const ACamera: Camera2D): Camera2D;
var
  LResult: Camera2D;
begin
  LResult := ACamera;
  LResult.offset.x := GFrame.Camera.offset.x + GFrame.Camera.zoom * ACamera.offset.x;
  LResult.offset.y := GFrame.Camera.offset.y + GFrame.Camera.zoom * ACamera.offset.y;
  LResult.zoom := GFrame.Camera.zoom * ACamera.zoom;
  return LResult;
end;

// The letterbox in framebuffer pixels, as rlViewport takes it: HIGHDPI renders above the
// window's size (render / screen is the pixel scale), and GL's viewport origin is the
// framebuffer's bottom-left corner
routine DoFrameViewport();
var
  LScaleX: float32;
  LScaleY: float32;
  LX: int32;
  LWidth: int32;
  LHeight: int32;
  LBottom: int32;
begin
  LScaleX := 1.0f;
  LScaleY := 1.0f;
  if (GetScreenWidth() > 0) and (GetScreenHeight() > 0) then
    LScaleX := float32(GetRenderWidth()) / float32(GetScreenWidth());
    LScaleY := float32(GetRenderHeight()) / float32(GetScreenHeight());
  end;
  LX := DoRound(GFrame.Letterbox.x * LScaleX);
  LWidth := DoRound(GFrame.Letterbox.width * LScaleX);
  LHeight := DoRound(GFrame.Letterbox.height * LScaleY);
  LBottom := DoRound((GFrame.Letterbox.y + GFrame.Letterbox.height) * LScaleY);
  rlViewport(LX, GetRenderHeight() - LBottom, LWidth, LHeight);
end;

// ACamera's projection at the frame's base aspect: raylib's BeginMode3D rule (rcore.c), with
// the base size in place of the framebuffer's
routine DoFrameProjection(const ACamera: Camera3D);
var
  LAspect: float64;
  LNear: float64;
  LFar: float64;
  LTop: float64;
  LRight: float64;
begin
  LAspect := float64(GFrame.BaseWidth) / float64(GFrame.BaseHeight);
  LNear := rlGetCullDistanceNear();
  LFar := rlGetCullDistanceFar();
  rlMatrixMode(RL_PROJECTION);
  rlLoadIdentity();
  if ACamera.projection = CAMERA_PERSPECTIVE then
    LTop := LNear * tan(float64(ACamera.fovy) * 0.5 * float64(DEG2RAD));
    LRight := LTop * LAspect;
    rlFrustum(-LRight, LRight, -LTop, LTop, LNear, LFar);
  else
    if ACamera.projection = CAMERA_ORTHOGRAPHIC then
      LTop := float64(ACamera.fovy) / 2.0;
      LRight := LTop * LAspect;
      rlOrtho(-LRight, LRight, -LTop, LTop, LNear, LFar);
    end;
  end;
  rlMatrixMode(RL_MODELVIEW);
end;

/// Opens raylib's window as a frame window: ABaseWidth x ABaseHeight is the base (virtual)
/// size everything is drawn in. The window opens at the base size x the frame's zoom
/// (SetFrameZoom, 1 by default) x the monitor's scale (GetFrameDpi / 96), centred on its
/// monitor's work area, resizable, and takes a new size when the DPI changes (a move to
/// another monitor). Draw between BeginFrame and EndFrame in base units; on resize, maximize
/// or fullscreen the frame keeps its aspect (letterboxed, or a whole multiple with
/// SetFrameIntegerScale), bars outside it. SetConfigFlags before it adds flags (raylib's).
/// CloseWindow closes the frame too (GetFrameWidth 0 again, the frame and bar colours, the
/// integer scale and the zoom kept).
/// @param ABaseWidth the base width, more than 0
/// @param ABaseHeight the base height, more than 0
/// @param ATitle the window's title
/// @returns true when the window opened; false for a base size of 0 or less, with a raylib
///   window already open, or when raylib could not open one
/// @example `if not InitFrameWindow(800, 450, "Game") then return; end;`
/// @see BeginFrame
public routine cpplink InitFrameWindow(const ABaseWidth: int32; const ABaseHeight: int32;
  const ATitle: ptr to const char): bool;
begin
  DoFrameLive();
  // A frame has a size; one window per program (raylib's rule)
  if (ABaseWidth <= 0) or (ABaseHeight <= 0) or IsWindowReady() then
    return false;
  end;
  RaylibPlatformSetWindowGone(DoFrameWindowGone);
  GFrame.BaseWidth := ABaseWidth;
  GFrame.BaseHeight := ABaseHeight;
  // At the zoomed size (raylib scales it on top itself with FLAG_WINDOW_HIGHDPI; otherwise
  // DoApplyScale does below)
  SetConfigFlags(uint32(FLAG_WINDOW_RESIZABLE));
  InitWindow(DoZoomedWidth(), DoZoomedHeight(), ATitle);
  if not IsWindowReady() then
    GFrame.BaseWidth := 0;
    GFrame.BaseHeight := 0;
    return false;
  end;
  GFrame.Open := true;
  GFrame.NativeWindow := RaylibPlatformNativeWindow(GetWindowHandle());
  GFrame.RaylibScales := IsWindowState(uint32(FLAG_WINDOW_HIGHDPI));
  GFrame.Dpi := DoQueryDpi();
  GFrame.LastDpiCheck := GetTime();
  DoApplyScale(true);
  return true;
end;

/// Begins drawing the frame (inside BeginDrawing): the whole window cleared to the bar
/// colour, then drawing held to the letterbox in base units (GetFrameCamera's Camera2D), the
/// frame filled with its colour, and the mouse taken (GetFrameMousePosition). Does nothing
/// with no frame window.
/// @example `BeginDrawing(); BeginFrame(); DrawCircle(400, 225, 50.0f, RED); EndFrame(); EndDrawing();`
/// @see EndFrame
public routine cpplink BeginFrame();
begin
  DoFrameLive();
  if not GFrame.Open then
    return;
  end;
  DoFollowDpi();
  // The letterbox follows the window's size as it is now (a resize needs no call)
  GFrame.Letterbox := DoLetterboxNow();
  GFrame.Camera.offset := Vector2(x: GFrame.Letterbox.x, y: GFrame.Letterbox.y);
  GFrame.Camera.target := Vector2(x: 0.0f, y: 0.0f);
  GFrame.Camera.rotation := 0.0f;
  GFrame.Camera.zoom := GFrame.Letterbox.width / float32(GFrame.BaseWidth);
  // The bars: the whole window; then the frame, clipped to it
  ClearBackground(GFrame.BarColor);
  DoFrameClip();
  BeginMode2D(GFrame.Camera);
  DrawRectangle(0, 0, GFrame.BaseWidth, GFrame.BaseHeight, GFrame.FrameColor);
  GFrame.Mouse := DoFramePoint(GetMousePosition(), GFrame.Letterbox, GFrame.BaseWidth,
    GFrame.BaseHeight);
end;

/// Ends BeginFrame: drawing is in window units again, unclipped (for a HUD over the bars).
/// Does nothing with no frame window.
/// @example `EndFrame(); DrawFPS(10, 10); EndDrawing();`
/// @see BeginFrame
public routine cpplink EndFrame();
begin
  DoFrameLive();
  if not GFrame.Open then
    return;
  end;
  EndMode2D();
  EndScissorMode();
end;

/// Draws through ACamera (in base units) inside the frame: raylib's BeginMode2D would replace
/// the frame's camera, so use this pair inside BeginFrame / EndFrame. With no frame window it
/// is raylib's BeginMode2D.
/// @param ACamera the program's camera, in base units
/// @example `BeginFrameMode2D(LCamera); DrawTexture(LMap, 0, 0, WHITE); EndFrameMode2D();`
/// @see EndFrameMode2D
public routine cpplink BeginFrameMode2D(const ACamera: Camera2D);
begin
  DoFrameLive();
  if not GFrame.Open then
    BeginMode2D(ACamera);
    return;
  end;
  BeginMode2D(DoFrameCompose(ACamera));
end;

/// Ends BeginFrameMode2D: drawing is in base units through the frame's own camera again.
/// With no frame window it is raylib's EndMode2D.
/// @example `EndFrameMode2D(); DrawText("HUD", 10, 10, 20, WHITE);`
/// @see BeginFrameMode2D
public routine cpplink EndFrameMode2D();
begin
  DoFrameLive();
  // Back to the frame's own camera (raylib's EndMode2D would leave window units)
  if not GFrame.Open then
    EndMode2D();
    return;
  end;
  BeginMode2D(GFrame.Camera);
end;

/// Draws a 3D scene through ACamera inside the frame: the scene's projection is at the base
/// size's aspect and its viewport the letterbox, where raylib's BeginMode3D takes the whole
/// window's aspect, so use this pair inside BeginFrame / EndFrame. With no frame window it is
/// raylib's BeginMode3D.
/// @param ACamera the program's 3D camera
/// @example `BeginFrameMode3D(LCamera); DrawGrid(10, 1.0f); EndFrameMode3D();`
/// @see EndFrameMode3D
public routine cpplink BeginFrameMode3D(const ACamera: Camera3D);
begin
  DoFrameLive();
  // raylib's BeginMode3D first: the batch drawn, the 2D projection saved, the view matrix,
  // the depth test; then the projection and the viewport are the letterbox's (the frame's
  // Camera2D and clip stay as they are)
  BeginMode3D(ACamera);
  if not GFrame.Open then
    return;
  end;
  DoFrameProjection(ACamera);
  DoFrameViewport();
end;

/// Ends BeginFrameMode3D: drawing is in base units through the frame's own camera and clip
/// again, as BeginFrame set them. With no frame window it is raylib's EndMode3D.
/// @example `EndFrameMode3D(); DrawText("HUD", 10, 10, 20, WHITE);`
/// @see BeginFrameMode3D
public routine cpplink EndFrameMode3D();
begin
  // raylib's EndMode3D: the batch drawn, the 2D projection back, the depth test off; then
  // raylib's own viewport (desktop GLFW sets no render offset) and the frame's camera and
  // clip, as BeginFrame left them
  EndMode3D();
  DoFrameLive();
  if not GFrame.Open then
    return;
  end;
  rlViewport(0, 0, GetRenderWidth(), GetRenderHeight());
  BeginMode2D(GFrame.Camera);
  DoFrameClip();
end;

/// Turns the frame's clip on again, as BeginFrame set it (drawing held to the letterbox): for
/// code between BeginFrame and EndFrame that turned raylib's scissor off or changed it. Does
/// nothing with no frame window.
/// @example `EndScissorMode(); RestoreFrameClip(); DrawText("clipped again", 10, 10, 20, WHITE);`
/// @see BeginFrame
public routine cpplink RestoreFrameClip();
begin
  DoFrameLive();
  if not GFrame.Open then
    return;
  end;
  DoFrameClip();
end;

/// The frame's base width (InitFrameWindow's); 0 with no frame window.
/// @example `LWidth := GetFrameWidth();`
/// @see GetFrameHeight
public routine cpplink GetFrameWidth(): int32;
begin
  DoFrameLive();
  return GFrame.BaseWidth;
end;

/// The frame's base height (InitFrameWindow's); 0 with no frame window.
/// @example `LHeight := GetFrameHeight();`
/// @see GetFrameWidth
public routine cpplink GetFrameHeight(): int32;
begin
  DoFrameLive();
  return GFrame.BaseHeight;
end;

/// The DPI the frame window is sized for (the monitor's, followed as it changes); 96 with no
/// frame window.
/// @example `println(GetFrameDpi());`
/// @see GetFrameScale
public routine cpplink GetFrameDpi(): int32;
begin
  DoFrameLive();
  return GFrame.Dpi;
end;

/// The monitor's scale the frame window is sized for: GetFrameDpi / 96.
/// @example `LScale := GetFrameScale();`
/// @see GetFrameDpi
public routine cpplink GetFrameScale(): float32;
begin
  return float32(GetFrameDpi()) / 96.0f;
end;

/// The DPI raylib's window is shown at now (a frame window or not; the monitor's): Windows
/// the window's own, X11's Xft.dpi; 96 when the OS gives none.
/// @example `LScale := float32(GetWindowDpi()) / 96.0f;`
/// @see GetFrameDpi
public routine cpplink GetWindowDpi(): int32;
begin
  return DoQueryDpi();
end;

/// The mouse at BeginFrame, in base units, clamped to the frame (0 to the base size - 1) and
/// rounded; 0, 0 with no frame window.
/// @example `LMouse := GetFrameMousePosition();`
/// @see BeginFrame
public routine cpplink GetFrameMousePosition(): Vector2;
begin
  DoFrameLive();
  return GFrame.Mouse;
end;

/// The Camera2D BeginFrame draws through (its offset is the letterbox's top left, its zoom
/// window units per base unit): for raylib's own world / screen mapping.
/// @returns the frame's camera as BeginFrame last set it
/// @example `LWorld := GetScreenToWorld2D(LTouch, GetFrameCamera());`
/// @see BeginFrame
public routine cpplink GetFrameCamera(): Camera2D;
begin
  DoFrameLive();
  return GFrame.Camera;
end;

/// Sets the colour the frame is filled with at BeginFrame (WHITE by default).
/// @param AColor the frame's colour
/// @example `SetFrameColor(RAYWHITE);`
/// @see SetFrameBarColor
public routine cpplink SetFrameColor(const AColor: Color);
begin
  DoFrameLive();
  GFrame.FrameColor := AColor;
end;

/// The colour the frame is filled with at BeginFrame.
/// @example `LColor := GetFrameColor();`
/// @see SetFrameColor
public routine cpplink GetFrameColor(): Color;
begin
  DoFrameLive();
  return GFrame.FrameColor;
end;

/// Sets the colour of the bars around the frame (BLACK by default).
/// @param AColor the bars' colour
/// @example `SetFrameBarColor(DARKGRAY);`
/// @see SetFrameColor
public routine cpplink SetFrameBarColor(const AColor: Color);
begin
  DoFrameLive();
  GFrame.BarColor := AColor;
end;

/// The colour of the bars around the frame.
/// @example `LColor := GetFrameBarColor();`
/// @see SetFrameBarColor
public routine cpplink GetFrameBarColor(): Color;
begin
  DoFrameLive();
  return GFrame.BarColor;
end;

/// Turns integer scaling on or off: on, the frame is the largest whole multiple of the base
/// size that fits the window (GetIntegerLetterboxRect's rule, taken in real framebuffer
/// pixels), so every base pixel is the same square of screen pixels (pixel art); off (the
/// default), it fills the window at its aspect (GetLetterboxRect's rule). It may be set before
/// InitFrameWindow and holds until changed; BeginFrame, GetFrameMousePosition and
/// GetFrameLetterbox follow it at once.
/// @param AEnabled true for whole multiples
/// @example `SetFrameIntegerScale(true); InitFrameWindow(320, 180, "Game");`
/// @see GetFrameLetterbox
/// @see GetIntegerLetterboxRect
public routine cpplink SetFrameIntegerScale(const AEnabled: bool);
begin
  DoFrameLive();
  GFrame.IntegerScale := AEnabled;
end;

/// Whether the frame is integer scaled (SetFrameIntegerScale).
/// @example `if IsFrameIntegerScale() then ... end;`
/// @see SetFrameIntegerScale
public routine cpplink IsFrameIntegerScale(): bool;
begin
  DoFrameLive();
  return GFrame.IntegerScale;
end;

/// Sets the frame's zoom: the window's normal size is the base size x the zoom x the
/// monitor's scale (a 320 x 180 game at zoom 4 opens at 1280 x 720 on a 96 DPI monitor);
/// drawing stays in base units, the frame only bigger when the window is bigger. Set it
/// before InitFrameWindow for the first size; on an open frame window the window takes its
/// new normal size at once (not while fullscreen, maximized or minimized). A zoom of 0 or less
/// is 1. It holds until changed, over a CloseWindow too.
/// @param AZoom the zoom, more than 0
/// @example `SetFrameZoom(4.0f); InitFrameWindow(320, 180, "Game");`
/// @see InitFrameWindow
/// @see GetFrameZoom
public routine cpplink SetFrameZoom(const AZoom: float32);
begin
  DoFrameLive();
  // A zoom of 0 or less (or not a number) is no zoom: 1
  if AZoom > 0.0f then
    GFrame.Zoom := AZoom;
  else
    GFrame.Zoom := 1.0f;
  end;
  if GFrame.Open then
    DoApplyScale(false);
  end;
end;

/// The frame's zoom (SetFrameZoom).
/// @example `LZoom := GetFrameZoom();`
/// @see SetFrameZoom
public routine cpplink GetFrameZoom(): float32;
begin
  DoFrameLive();
  return GFrame.Zoom;
end;

/// The frame's rectangle in the window now, in window units, under its rule (fit, or a whole
/// multiple with SetFrameIntegerScale): where BeginFrame draws the frame this frame. Code that
/// maps between the window and the frame outside BeginFrame / EndFrame uses it; empty with no
/// frame window.
/// @example `LBox := GetFrameLetterbox(); LZoom := LBox.width / float32(GetFrameWidth());`
/// @see SetFrameIntegerScale
/// @see BeginFrame
public routine cpplink GetFrameLetterbox(): Rectangle;
begin
  DoFrameLive();
  if not GFrame.Open then
    return Rectangle(x: 0.0f, y: 0.0f, width: 0.0f, height: 0.0f);
  end;
  return DoLetterboxNow();
end;

/// Toggles the frame window between a borderless window over its monitor and its window (the
/// context kept; raylib puts the window back at its place and size). Does nothing with no
/// frame window.
/// @example `if IsKeyPressed(KEY_F11) then ToggleFrameFullscreen(); end;`
/// @see InitFrameWindow
public routine cpplink ToggleFrameFullscreen();
begin
  DoFrameLive();
  if GFrame.Open then
    ToggleBorderlessWindowed();
  end;
end;

/// The letterbox rule itself (no window needed): the rectangle, in window units, that fits a
/// base size's aspect into a window, centred, bars outside it (left and right in a wider
/// window, above and below in a taller one); the whole window when a size is 0 or less.
/// @param AWindowWidth the window's width
/// @param AWindowHeight the window's height
/// @param ABaseWidth the base width
/// @param ABaseHeight the base height
/// @example `LBox := GetLetterboxRect(1920, 1080, 800, 600);`
/// @see GetScaledFrameSize
public routine cpplink GetLetterboxRect(const AWindowWidth: int32; const AWindowHeight: int32;
  const ABaseWidth: int32; const ABaseHeight: int32): Rectangle;
begin
  return DoLetterbox(AWindowWidth, AWindowHeight, ABaseWidth, ABaseHeight);
end;

/// The integer letterbox rule itself (no window needed): the rectangle, in window units, of
/// the largest whole multiple of the base size that fits the window, centred (the bars round
/// down); a window smaller than the base size gets GetLetterboxRect's fit rule instead; a size
/// of 0 or less, the whole window. The frame uses it with SetFrameIntegerScale on.
/// @param AWindowWidth the window's width
/// @param AWindowHeight the window's height
/// @param ABaseWidth the base width
/// @param ABaseHeight the base height
/// @example `LBox := GetIntegerLetterboxRect(1366, 768, 320, 180); // 4x: 1280x720 at (43, 24)`
/// @see GetLetterboxRect
/// @see SetFrameIntegerScale
public routine cpplink GetIntegerLetterboxRect(const AWindowWidth: int32;
  const AWindowHeight: int32; const ABaseWidth: int32; const ABaseHeight: int32): Rectangle;
begin
  return DoIntegerLetterbox(AWindowWidth, AWindowHeight, ABaseWidth, ABaseHeight, 1.0f);
end;

/// The DPI rule itself (no window needed): the window size InitFrameWindow opens for a base
/// size on a monitor of ADpi: base x ADpi / 96, each side rounded (halfway away from zero).
/// @param ABaseWidth the base width
/// @param ABaseHeight the base height
/// @param ADpi the monitor's DPI
/// @example `LSize := GetScaledFrameSize(800, 450, 144);`
/// @see GetLetterboxRect
public routine cpplink GetScaledFrameSize(const ABaseWidth: int32; const ABaseHeight: int32;
  const ADpi: int32): Vector2;
begin
  return DoScaledSize(ABaseWidth, ABaseHeight, ADpi);
end;

/// The frame point rule itself (no window needed): a window point (window units) in base
/// units through a letterbox (GetLetterboxRect's) of a base-size frame, clamped to the frame
/// (0 to the base size - 1) and rounded; 0, 0 for an empty letterbox or base size.
/// @param APoint the point in the window
/// @param ALetterbox the frame's rectangle in the window
/// @param ABaseWidth the base width
/// @param ABaseHeight the base height
/// @example `LAt := GetFramePoint(GetMousePosition(), LBox, 800, 600);`
/// @see GetFrameMousePosition
public routine cpplink GetFramePoint(const APoint: Vector2; const ALetterbox: Rectangle;
  const ABaseWidth: int32; const ABaseHeight: int32): Vector2;
begin
  return DoFramePoint(APoint, ALetterbox, ABaseWidth, ABaseHeight);
end;

end.
