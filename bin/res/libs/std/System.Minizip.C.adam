// from System.Minizip.C.cimport.toml (zip.h, unzip.h).
// Regenerate it with adam cimport; a change belongs in the spec
// ([renames], [skip], [[insert]]).

module unit System.Minizip.C;

@linklibrary "zlib";

import System.Zlib.C;

public type
  i8_t = int8;
  ui8_t = uint8;
  i16_t = int16;
  ui16_t = uint16;
  i32_t = int32;
  ui32_t = uint32;
@ifdef TARGET_X86_64_WINDOWS_GNU
  i64_t = int64;
  ui64_t = uint64;
@elseif TARGET_X86_64_LINUX_GNU
  i64_t = clong;
  ui64_t = culong;
@endif
  ZPOS64_T = ui64_t;

  open_file_func = routine clink(opaque: voidpf; filename: ptr to const char; mode: int32): voidpf;
  read_file_func = routine clink(opaque: voidpf; stream: voidpf; buf: ptr; size: uLong): uLong;
  write_file_func = routine clink(opaque: voidpf; stream: voidpf; buf: ptr to const; size: uLong): uLong;
  close_file_func = routine clink(opaque: voidpf; stream: voidpf): int32;
  testerror_file_func = routine clink(opaque: voidpf; stream: voidpf): int32;
  tell_file_func = routine clink(opaque: voidpf; stream: voidpf): clong;
  seek_file_func = routine clink(opaque: voidpf; stream: voidpf; offset: uLong; origin: int32): clong;

  zlib_filefunc_def_s = record
    zopen_file: open_file_func;
    zread_file: read_file_func;
    zwrite_file: write_file_func;
    ztell_file: tell_file_func;
    zseek_file: seek_file_func;
    zclose_file: close_file_func;
    zerror_file: testerror_file_func;
    opaque: voidpf;
  end;

  zlib_filefunc_def = zlib_filefunc_def_s;

  tell64_file_func = routine clink(opaque: voidpf; stream: voidpf): ZPOS64_T;
  seek64_file_func = routine clink(opaque: voidpf; stream: voidpf; offset: ZPOS64_T; origin: int32): clong;
  open64_file_func = routine clink(opaque: voidpf; filename: ptr to const; mode: int32): voidpf;

  zlib_filefunc64_def_s = record
    zopen64_file: open64_file_func;
    zread_file: read_file_func;
    zwrite_file: write_file_func;
    ztell64_file: tell64_file_func;
    zseek64_file: seek64_file_func;
    zclose_file: close_file_func;
    zerror_file: testerror_file_func;
    opaque: voidpf;
  end;

  zlib_filefunc64_def = zlib_filefunc64_def_s;

  zlib_filefunc64_32_def_s = record
    zfile_func64: zlib_filefunc64_def;
    zopen32_file: open_file_func;
    ztell32_file: tell_file_func;
    zseek32_file: seek_file_func;
  end;

  zlib_filefunc64_32_def = zlib_filefunc64_32_def_s;
  zipFile = voidp;

  tm_zip_s = record
    tm_sec: int32;
    tm_min: int32;
    tm_hour: int32;
    tm_mday: int32;
    tm_mon: int32;
    tm_year: int32;
  end;

  tm_zip = tm_zip_s;

  zip_fileinfo = record
    tmz_date: tm_zip;
    dosDate: uLong;
    internal_fa: uLong;
    external_fa: uLong;
  end;

  zipcharpc = ptr to const char;
  unzFile = voidp;

  tm_unz_s = record
    tm_sec: int32;
    tm_min: int32;
    tm_hour: int32;
    tm_mday: int32;
    tm_mon: int32;
    tm_year: int32;
  end;

  tm_unz = tm_unz_s;

  unz_global_info64_s = record
    number_entry: ZPOS64_T;
    size_comment: uLong;
  end;

  unz_global_info64 = unz_global_info64_s;

  unz_global_info_s = record
    number_entry: uLong;
    size_comment: uLong;
  end;

  unz_global_info = unz_global_info_s;

  unz_file_info64_s = record
    version: uLong;
    version_needed: uLong;
    flag: uLong;
    compression_method: uLong;
    dosDate: uLong;
    crc: uLong;
    compressed_size: ZPOS64_T;
    uncompressed_size: ZPOS64_T;
    size_filename: uLong;
    size_file_extra: uLong;
    size_file_comment: uLong;
    disk_num_start: uLong;
    internal_fa: uLong;
    external_fa: uLong;
    tmu_date: tm_unz;
  end;

  unz_file_info64 = unz_file_info64_s;

  unz_file_info_s = record
    version: uLong;
    version_needed: uLong;
    flag: uLong;
    compression_method: uLong;
    dosDate: uLong;
    crc: uLong;
    compressed_size: uLong;
    uncompressed_size: uLong;
    size_filename: uLong;
    size_file_extra: uLong;
    size_file_comment: uLong;
    disk_num_start: uLong;
    internal_fa: uLong;
    external_fa: uLong;
    tmu_date: tm_unz;
  end;

  unz_file_info = unz_file_info_s;

  unz_file_pos_s = record
    pos_in_zip_directory: uLong;
    num_of_file: uLong;
  end;

  unz_file_pos = unz_file_pos_s;

  unz64_file_pos_s = record
    pos_in_zip_directory: ZPOS64_T;
    num_of_file: ZPOS64_T;
  end;

  unz64_file_pos = unz64_file_pos_s;

