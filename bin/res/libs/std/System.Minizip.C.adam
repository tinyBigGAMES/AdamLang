-------------------------------------------------------------------------------
  System.Minizip.C.adam - the part of minizip's C API (Gilles Vollant,
  zlib license; zlib's contrib/minizip at tag v1.4) that Adam uses,
  translated by hand from ioapi.h / zip.h / unzip.h with the headers' own
  names, as M9's importer will write them when it regenerates this file:
  the file-function table, the zip writer's and the unzip reader's records
  laid out as C lays them out, their routines as `external "minizip"`
  (libminizip.a in res/libs/vendor/<triple>, built by AdamLang-Libs). The
  headers include zlib.h, so this unit imports System.Zlib.C for uLong /
  uInt / voidpf; minizip calls zlib, so it names libzlib.a with
  @linklibrary: a program that uses it links both.

  The headers' types: `int` int32, `unsigned` uint32, `long` clong,
  ZPOS64_T uint64, zipFile / unzFile / voidp ptr. A path is the
  `const void *` the open64 callback is handed (a narrow C string with
  minizip's default fopen64 table): ptr to const char, since a literal
  converts to no untyped pointer. iowin32 (fill_win32_filefunc64*) is
  Windows-only and not translated here: a program's own table goes through
  zipOpen2_64 / unzOpen2_64. A C name that is an Adam keyword takes a
  trailing '_' (the parameter `method` is method_). Target-neutral: no OS
  named.
*******************************************************************************/

module unit System.Minizip.C;

@linklibrary "zlib";

import System.Zlib.C;

public const
  // ioapi.h
  ZLIB_FILEFUNC_SEEK_CUR: int32 = 1;
  ZLIB_FILEFUNC_SEEK_END: int32 = 2;
  ZLIB_FILEFUNC_SEEK_SET: int32 = 0;
  ZLIB_FILEFUNC_MODE_READ: int32 = 1;
  ZLIB_FILEFUNC_MODE_WRITE: int32 = 2;
  ZLIB_FILEFUNC_MODE_READWRITEFILTER: int32 = 3;
  ZLIB_FILEFUNC_MODE_EXISTING: int32 = 4;
  ZLIB_FILEFUNC_MODE_CREATE: int32 = 8;
  // zip.h
  ZIP_OK: int32 = 0;
  ZIP_EOF: int32 = 0;
  ZIP_ERRNO: int32 = -1;
  ZIP_PARAMERROR: int32 = -102;
  ZIP_BADZIPFILE: int32 = -103;
  ZIP_INTERNALERROR: int32 = -104;
  APPEND_STATUS_CREATE: int32 = 0;
  APPEND_STATUS_CREATEAFTER: int32 = 1;
  APPEND_STATUS_ADDINZIP: int32 = 2;
  // unzip.h
  UNZ_OK: int32 = 0;
  UNZ_END_OF_LIST_OF_FILE: int32 = -100;
  UNZ_ERRNO: int32 = -1;
  UNZ_EOF: int32 = 0;
  UNZ_PARAMERROR: int32 = -102;
  UNZ_BADZIPFILE: int32 = -103;
  UNZ_INTERNALERROR: int32 = -104;
  UNZ_CRCERROR: int32 = -105;

public type
  // ioapi.h
  ZPOS64_T = uint64;

  open64_file_func = routine clink(opaque: voidpf; filename: ptr; mode: int32): voidpf;
  read_file_func = routine clink(opaque: voidpf; stream: voidpf; buf: ptr; size: uLong): uLong;
  write_file_func = routine clink(opaque: voidpf; stream: voidpf; buf: ptr; size: uLong): uLong;
  tell64_file_func = routine clink(opaque: voidpf; stream: voidpf): ZPOS64_T;
  seek64_file_func = routine clink(opaque: voidpf; stream: voidpf; offset: ZPOS64_T;
    origin: int32): clong;
  close_file_func = routine clink(opaque: voidpf; stream: voidpf): int32;
  testerror_file_func = routine clink(opaque: voidpf; stream: voidpf): int32;

  zlib_filefunc64_def = record
    zopen64_file: open64_file_func;
    zread_file: read_file_func;
    zwrite_file: write_file_func;
    ztell64_file: tell64_file_func;
    zseek64_file: seek64_file_func;
    zclose_file: close_file_func;
    zerror_file: testerror_file_func;
    opaque: voidpf;
  end;

  // zip.h
  zipFile = ptr;
  zipcharpc = ptr to const char;

  tm_zip = record
    tm_sec: int32;
    tm_min: int32;
    tm_hour: int32;
    tm_mday: int32;
    tm_mon: int32;
    tm_year: int32;
  end;

  zip_fileinfo = record
    tmz_date: tm_zip;
    dosDate: uLong;
    internal_fa: uLong;
    external_fa: uLong;
  end;

  // unzip.h
  unzFile = ptr;

  tm_unz = record
    tm_sec: int32;
    tm_min: int32;
    tm_hour: int32;
    tm_mday: int32;
    tm_mon: int32;
    tm_year: int32;
  end;

  unz_global_info64 = record
    number_entry: ZPOS64_T;
    size_comment: uLong;
  end;

  unz_file_info64 = record
    version: uLong;
    version_needed: uLong;
    flag: uLong;
    compression_method: uLong;
    dosDate: uLong;
    crc: uLong;
    compressed_size: ZPOS64_T;
    uncompressed_size: ZPOS64_T;
    size_filename: uLong;
    size_file_extra: uLong;
    size_file_comment: uLong;
    disk_num_start: uLong;
    internal_fa: uLong;
    external_fa: uLong;
    tmu_date: tm_unz;
  end;

  unz64_file_pos = record
    pos_in_zip_directory: ZPOS64_T;
    num_of_file: ZPOS64_T;
  end;

// zip.h
public routine clink zipOpen64(pathname: ptr to const char; append: int32): zipFile;
  external "minizip";
public routine clink zipOpen2_64(pathname: ptr to const char; append: int32;
  globalcomment: ptr to zipcharpc; pzlib_filefunc_def: ptr to zlib_filefunc64_def): zipFile;
  external "minizip";
public routine clink zipOpenNewFileInZip64(file: zipFile; filename: ptr to const char;
  zipfi: ptr to const zip_fileinfo; extrafield_local: ptr; size_extrafield_local: uInt;
  extrafield_global: ptr; size_extrafield_global: uInt; comment: ptr to const char;
  method_: int32; level: int32; zip64: int32): int32; external "minizip";
public routine clink zipOpenNewFileInZip4_64(file: zipFile; filename: ptr to const char;
  zipfi: ptr to const zip_fileinfo; extrafield_local: ptr; size_extrafield_local: uInt;
  extrafield_global: ptr; size_extrafield_global: uInt; comment: ptr to const char;
  method_: int32; level: int32; raw: int32; windowBits: int32; memLevel: int32;
  strategy: int32; password: ptr to const char; crcForCrypting: uLong; versionMadeBy: uLong;
  flagBase: uLong; zip64: int32): int32; external "minizip";
public routine clink zipWriteInFileInZip(file: zipFile; buf: ptr; len: uint32): int32;
  external "minizip";
public routine clink zipCloseFileInZip(file: zipFile): int32; external "minizip";
public routine clink zipClose(file: zipFile; global_comment: ptr to const char): int32;
  external "minizip";

// unzip.h
public routine clink unzOpen64(path: ptr to const char): unzFile; external "minizip";
public routine clink unzOpen2_64(path: ptr to const char;
  pzlib_filefunc_def: ptr to zlib_filefunc64_def): unzFile; external "minizip";
public routine clink unzClose(file: unzFile): int32; external "minizip";
public routine clink unzGetGlobalInfo64(file: unzFile; pglobal_info: ptr to unz_global_info64): int32;
  external "minizip";
public routine clink unzGoToFirstFile(file: unzFile): int32; external "minizip";
public routine clink unzGoToNextFile(file: unzFile): int32; external "minizip";
public routine clink unzLocateFile(file: unzFile; szFileName: ptr to const char;
  iCaseSensitivity: int32): int32; external "minizip";
public routine clink unzGetFilePos64(file: unzFile; file_pos: ptr to unz64_file_pos): int32;
  external "minizip";
public routine clink unzGoToFilePos64(file: unzFile; file_pos: ptr to const unz64_file_pos): int32;
  external "minizip";
public routine clink unzGetCurrentFileInfo64(file: unzFile; pfile_info: ptr to unz_file_info64;
  szFileName: ptr to char; fileNameBufferSize: uLong; extraField: ptr;
  extraFieldBufferSize: uLong; szComment: ptr to char; commentBufferSize: uLong): int32;
  external "minizip";
public routine clink unzGetCurrentFileZStreamPos64(file: unzFile): ZPOS64_T; external "minizip";
public routine clink unzOpenCurrentFile(file: unzFile): int32; external "minizip";
public routine clink unzOpenCurrentFile3(file: unzFile; method_: ptr to int32; level: ptr to int32;
  raw: int32; password: ptr to const char): int32; external "minizip";
public routine clink unzCloseCurrentFile(file: unzFile): int32; external "minizip";
public routine clink unzReadCurrentFile(file: unzFile; buf: ptr; len: uint32): int32;
  external "minizip";

end.
