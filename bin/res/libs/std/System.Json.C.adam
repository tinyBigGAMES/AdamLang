  const create_parent: bool; const ctx: ptr to yyjson_ptr_ctx;
  const err: ptr to yyjson_ptr_err): bool;
var
  root: ptr to yyjson_mut_val;
begin
  repeat
    if (err <> nil) then
      err->code := 0;
      err->msg := nil;
      err->pos := 0;
    end;
  until true;
  if (ctx <> nil) then
@ifdef TARGET_X86_64_WINDOWS_GNU
    memset(ctx, 0, uint64(size(yyjson_ptr_ctx)));
@elseif TARGET_X86_64_LINUX_GNU
    memset(ctx, 0, culong(size(yyjson_ptr_ctx)));
@endif
