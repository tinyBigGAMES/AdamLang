    return false;
  end;
  if (not (not ((not (doc->root <> nil)) and (not create_parent)))) then
    repeat
      if (err <> nil) then
        err->code := 4;
        err->msg := "document's root is NULL";
        err->pos := 0;
      end;
    until true;
    return false;
  end;
  if (not (not (not (doc->root <> nil)))) then
    root := yyjson_mut_obj(doc);
    if (not (not (not (root <> nil)))) then
      repeat
        if (err <> nil) then
          err->code := 6;
          err->msg := "failed to create value";
          err->pos := 0;
        end;
      until true;
      return false;
    end;
    if unsafe_yyjson_mut_ptr_putx(root, ptr_, len, new_val, doc, create_parent, true, ctx, err) then
      doc->root := root;
      return true;
    end;
    return false;
