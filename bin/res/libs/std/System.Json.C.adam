  end;
end;

public routine yyjson_ptr_get_uint(const root: ptr to const yyjson_val;
@ifdef TARGET_X86_64_WINDOWS_GNU
  const ptr_: ptr to const char; const value: ptr to uint64): bool;
@elseif TARGET_X86_64_LINUX_GNU
  const ptr_: ptr to const char; const value: ptr to culong): bool;
@endif
var
  val: ptr to yyjson_val;
@ifdef TARGET_X86_64_WINDOWS_GNU
  ret: uint64;
@elseif TARGET_X86_64_LINUX_GNU
  ret: culong;
@endif
begin
  val := yyjson_ptr_get(root, ptr_);
  if ((value <> nil) and (val <> nil)) then
    ret := val->uni.u64;
    if (unsafe_yyjson_is_uint(val) or (unsafe_yyjson_is_sint(val) and (not ((ret >> 63) <> 0)))) then
      value^ := ret;
      return true;
    end;
  end;
  return false;
end;

public routine yyjson_ptr_get_sint(const root: ptr to const yyjson_val;
@ifdef TARGET_X86_64_WINDOWS_GNU
  const ptr_: ptr to const char; const value: ptr to int64): bool;
@elseif TARGET_X86_64_LINUX_GNU
  const ptr_: ptr to const char; const value: ptr to clong): bool;
@endif
var
  val: ptr to yyjson_val;
@ifdef TARGET_X86_64_WINDOWS_GNU
  ret: int64;
@elseif TARGET_X86_64_LINUX_GNU
  ret: clong;
@endif
begin
  val := yyjson_ptr_get(root, ptr_);
  if ((value <> nil) and (val <> nil)) then
    ret := val->uni.i64;
    if (unsafe_yyjson_is_sint(val) or (unsafe_yyjson_is_uint(val) and (ret >= 0))) then
      value^ := ret;
      return true;
    end;
  end;
  return false;
end;

public routine yyjson_ptr_get_real(const root: ptr to const yyjson_val;
  const ptr_: ptr to const char; const value: ptr to float64): bool;
var
  val: ptr to yyjson_val;
begin
  val := yyjson_ptr_get(root, ptr_);
  if ((value <> nil) and yyjson_is_real(val)) then
    value^ := unsafe_yyjson_get_real(val);
    return true;
  else
    return false;
  end;
end;

public routine yyjson_ptr_get_num(const root: ptr to const yyjson_val;
  const ptr_: ptr to const char; const value: ptr to float64): bool;
var
  val: ptr to yyjson_val;
begin
  val := yyjson_ptr_get(root, ptr_);
  if ((value <> nil) and yyjson_is_num(val)) then
    value^ := unsafe_yyjson_get_num(val);
    return true;
  else
    return false;
  end;
end;

public routine yyjson_ptr_get_str(const root: ptr to const yyjson_val;
  const ptr_: ptr to const char; const value: ptr to ptr to const char): bool;
var
  val: ptr to yyjson_val;
begin
  val := yyjson_ptr_get(root, ptr_);
  if ((value <> nil) and yyjson_is_str(val)) then
    value^ := unsafe_yyjson_get_str(val);
    return true;
  else
    return false;
  end;
end;

public routine yyjson_doc_get_pointer(const doc: ptr to yyjson_doc;
  const ptr_: ptr to const char): ptr to yyjson_val;
begin
  return yyjson_doc_ptr_get(doc, ptr_);
end;

public routine yyjson_mut_doc_get_pointer(const doc: ptr to yyjson_mut_doc;
  const ptr_: ptr to const char): ptr to yyjson_mut_val;
begin
  return yyjson_mut_doc_ptr_get(doc, ptr_);
end;

public routine yyjson_get_pointer(const val: ptr to yyjson_val;
  const ptr_: ptr to const char): ptr to yyjson_val;
begin
  return yyjson_ptr_get(val, ptr_);
end;

public routine yyjson_mut_get_pointer(const val: ptr to yyjson_mut_val;
  const ptr_: ptr to const char): ptr to yyjson_mut_val;
begin
  return yyjson_mut_ptr_get(val, ptr_);
end;

public routine yyjson_gcc_available<T>(const major: T; const minor: T; const patch: T): int32;
begin
  return int32((40201 >= (((major * 10000) + (minor * 100)) + patch)));
end;

public routine yyjson_likely<T>(const expr: T): clong;
begin
  return clong((not (not (expr <> 0))));
end;

public routine yyjson_unlikely<T>(const expr: T): clong;
begin
  return clong((not (not (expr <> 0))));
end;

public routine yyjson_constant_p<T>(const value: T): int32;
begin
  return 0;
end;

public routine YYJSON_WRITE_FP_TO_FIXED<T>(const prec: T): yyjson_write_flag;
begin
  return (uint32(prec) << 28);
end;

end.
