  if (not (not (((not (doc <> nil)) or (not (ptr_ <> nil))) or (not (new_val <> nil))))) then
    repeat
      if (err <> nil) then
        err->code := 1;
        err->msg := "input parameter is NULL";
        err->pos := 0;
      end;
    until true;
    return false;
  end;
  if (not (not (len = 0))) then
    if (doc->root <> nil) then
