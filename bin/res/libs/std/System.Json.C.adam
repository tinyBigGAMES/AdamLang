public routine yyjson_read_max_memory_usage(len: uint64; const flg: yyjson_read_flag): uint64;
@elseif TARGET_X86_64_LINUX_GNU
public routine yyjson_read_max_memory_usage(len: culong; const flg: yyjson_read_flag): culong;
@endif
var
@ifdef TARGET_X86_64_WINDOWS_GNU
  mul: uint64;
  pad: uint64;
  max: uint64;
@elseif TARGET_X86_64_LINUX_GNU
  mul: culong;
  pad: culong;
  max: culong;
@endif
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  mul := (12 + uint64((not ((flg & 1) <> 0))));
@elseif TARGET_X86_64_LINUX_GNU
  mul := (12 + culong((not ((flg & 1) <> 0))));
@endif
  pad := 256;
  max := 18446744073709551615u;
  if ((flg & 2) <> 0) then
    len := ((len < 256) ? 256 : len);
  end;
  if (len >= (((max - pad) - mul) div mul)) then
    return 0;
  end;
  return ((len * mul) + pad);
end;

