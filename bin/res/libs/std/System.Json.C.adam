        err->msg := "input parameter is NULL";
        err->pos := 0;
      end;
    until true;
    return nil;
  end;
  if (not (not (not (doc->root <> nil)))) then
    repeat
      if (err <> nil) then
        err->code := 4;
        err->msg := "document's root is NULL";
        err->pos := 0;
      end;
    until true;
    return nil;
  end;
  if (not (not (len = 0))) then
    root := doc->root;
    if (ctx <> nil) then
      ctx->old := root;
    end;
    doc->root := nil;
    return root;
  end;
  if (not (not (int32(ptr_^) <> 47))) then
    repeat
      if (err <> nil) then
        err->code := 2;
        err->msg := "no prefix '/'";
        err->pos := 0;
      end;
    until true;
    return nil;
  end;
  return unsafe_yyjson_mut_ptr_removex(doc->root, ptr_, len, ctx, err);
end;

public routine yyjson_mut_ptr_removex(const val: ptr to yyjson_mut_val;
@ifdef TARGET_X86_64_WINDOWS_GNU
  const ptr_: ptr to const char; const len: uint64; const ctx: ptr to yyjson_ptr_ctx;
@elseif TARGET_X86_64_LINUX_GNU
  const ptr_: ptr to const char; const len: culong; const ctx: ptr to yyjson_ptr_ctx;
@endif
  const err: ptr to yyjson_ptr_err): ptr to yyjson_mut_val;
begin
  repeat
    if (err <> nil) then
      err->code := 0;
      err->msg := nil;
      err->pos := 0;
    end;
  until true;
  if (ctx <> nil) then
@ifdef TARGET_X86_64_WINDOWS_GNU
    memset(ctx, 0, uint64(size(yyjson_ptr_ctx)));
@elseif TARGET_X86_64_LINUX_GNU
    memset(ctx, 0, culong(size(yyjson_ptr_ctx)));
@endif
  end;
  if (not (not ((not (val <> nil)) or (not (ptr_ <> nil))))) then
    repeat
      if (err <> nil) then
        err->code := 1;
        err->msg := "input parameter is NULL";
        err->pos := 0;
      end;
    until true;
    return nil;
  end;
  if (not (not (len = 0))) then
    repeat
      if (err <> nil) then
        err->code := 5;
        err->msg := "cannot set root";
        err->pos := 0;
      end;
    until true;
    return nil;
  end;
  if (not (not (int32(ptr_^) <> 47))) then
    repeat
      if (err <> nil) then
        err->code := 2;
        err->msg := "no prefix '/'";
        err->pos := 0;
      end;
    until true;
    return nil;
  end;
  return unsafe_yyjson_mut_ptr_removex(val, ptr_, len, ctx, err);
end;

public routine yyjson_ptr_ctx_append(const ctx: ptr to yyjson_ptr_ctx;
  const key: ptr to yyjson_mut_val; const val: ptr to yyjson_mut_val): bool;
var
  ctn: ptr to yyjson_mut_val;
  pre_key: ptr to yyjson_mut_val;
  pre_val: ptr to yyjson_mut_val;
  cur_key: ptr to yyjson_mut_val;
  cur_val: ptr to yyjson_mut_val;
begin
  if (((not (ctx <> nil)) or (not (ctx->ctn <> nil))) or (not (val <> nil))) then
    return false;
  end;
  ctn := ctx->ctn;
  if yyjson_mut_is_obj(ctn) then
    if (not (key <> nil)) then
      return false;
    end;
    key->next := val;
    pre_key := ctx->pre;
    if (unsafe_yyjson_get_len(ctn) = 0) then
      val->next := key;
      ctn->uni.ptr_ := key;
      ctx->pre := key;
    else
      if (not (pre_key <> nil)) then
        pre_key := ptr to yyjson_mut_val(ctn->uni.ptr_);
        pre_val := pre_key->next;
        val->next := pre_val->next;
        pre_val->next := key;
        ctn->uni.ptr_ := key;
        ctx->pre := pre_key;
      else
        cur_key := pre_key->next->next;
        cur_val := cur_key->next;
        val->next := cur_val->next;
        cur_val->next := key;
        if (ctn->uni.ptr_ = cur_key) then
          ctn->uni.ptr_ := key;
        end;
        ctx->pre := cur_key;
      end;
    end;
  else
    pre_val := ctx->pre;
    if (unsafe_yyjson_get_len(ctn) = 0) then
      val->next := val;
      ctn->uni.ptr_ := val;
      ctx->pre := val;
    else
      if (not (pre_val <> nil)) then
        pre_val := ptr to yyjson_mut_val(ctn->uni.ptr_);
        val->next := pre_val->next;
        pre_val->next := val;
        ctn->uni.ptr_ := val;
        ctx->pre := pre_val;
      else
        cur_val := pre_val->next;
        val->next := cur_val->next;
        cur_val->next := val;
        if (ctn->uni.ptr_ = cur_val) then
          ctn->uni.ptr_ := val;
        end;
        ctx->pre := cur_val;
      end;
    end;
  end;
  unsafe_yyjson_inc_len(ctn);
  return true;
end;

public routine yyjson_ptr_ctx_replace(const ctx: ptr to yyjson_ptr_ctx;
  const val: ptr to yyjson_mut_val): bool;
var
  ctn: ptr to yyjson_mut_val;
  pre_key: ptr to yyjson_mut_val;
  cur_key: ptr to yyjson_mut_val;
  pre_val: ptr to yyjson_mut_val;
  cur_val: ptr to yyjson_mut_val;
begin
  if ((((not (ctx <> nil)) or (not (ctx->ctn <> nil))) or (not (ctx->pre <> nil))) or (not (val <> nil))) then
    return false;
  end;
  ctn := ctx->ctn;
  if yyjson_mut_is_obj(ctn) then
    pre_key := ctx->pre;
    pre_val := pre_key->next;
    cur_key := pre_val->next;
    cur_val := cur_key->next;
    cur_key->next := val;
    val->next := cur_val->next;
    ctx->old := cur_val;
  else
    pre_val := ctx->pre;
    cur_val := pre_val->next;
    if (pre_val <> cur_val) then
      val->next := cur_val->next;
      pre_val->next := val;
      if (ctn->uni.ptr_ = cur_val) then
        ctn->uni.ptr_ := val;
      end;
    else
      val->next := val;
      ctn->uni.ptr_ := val;
      ctx->pre := val;
    end;
    ctx->old := cur_val;
  end;
  return true;
end;

public routine yyjson_ptr_ctx_remove(const ctx: ptr to yyjson_ptr_ctx): bool;
var
  ctn: ptr to yyjson_mut_val;
  pre_key: ptr to yyjson_mut_val;
  pre_val: ptr to yyjson_mut_val;
  cur_key: ptr to yyjson_mut_val;
  cur_val: ptr to yyjson_mut_val;
@ifdef TARGET_X86_64_WINDOWS_GNU
  len: uint64;
@elseif TARGET_X86_64_LINUX_GNU
  len: culong;
@endif
begin
  if (((not (ctx <> nil)) or (not (ctx->ctn <> nil))) or (not (ctx->pre <> nil))) then
    return false;
  end;
  ctn := ctx->ctn;
  if yyjson_mut_is_obj(ctn) then
    pre_key := ctx->pre;
    pre_val := pre_key->next;
    cur_key := pre_val->next;
    cur_val := cur_key->next;
    pre_val->next := cur_val->next;
    if (ctn->uni.ptr_ = cur_key) then
      ctn->uni.ptr_ := pre_key;
    end;
    ctx->pre := nil;
    ctx->old := cur_val;
  else
    pre_val := ctx->pre;
    cur_val := pre_val->next;
    pre_val->next := cur_val->next;
    if (ctn->uni.ptr_ = cur_val) then
      ctn->uni.ptr_ := pre_val;
    end;
    ctx->pre := nil;
    ctx->old := cur_val;
  end;
  len := (unsafe_yyjson_get_len(ctn) - 1);
  if (len = 0) then
    ctn->uni.ptr_ := nil;
  end;
  unsafe_yyjson_set_len(ctn, len);
  return true;
end;

