  return DoStatCall(APath, ABuf, HookStatKind.Stat64i32, GRealStat64i32,
    ptr to const char("_stat64i32"));
end;

public func _stat64(const APath: ptr to const char; const ABuf: ptr): int32;
begin
  return DoStatCall(APath, ABuf, HookStatKind.Stat64, GRealStat64, ptr to const char("_stat64"));
end;

public func _wstat32(const APath: ptr to const wchar; const ABuf: ptr): int32;
begin
  return DoWstatCall(APath, ABuf, HookStatKind.Stat32, GRealWstat32,
    ptr to const char("_wstat32"));
end;

public func _wstat32i64(const APath: ptr to const wchar; const ABuf: ptr): int32;
begin
  return DoWstatCall(APath, ABuf, HookStatKind.Stat32i64, GRealWstat32i64,
    ptr to const char("_wstat32i64"));
end;

public func _wstat64i32(const APath: ptr to const wchar; const ABuf: ptr): int32;
begin
  return DoWstatCall(APath, ABuf, HookStatKind.Stat64i32, GRealWstat64i32,
    ptr to const char("_wstat64i32"));
end;

public func _wstat64(const APath: ptr to const wchar; const ABuf: ptr): int32;
begin
  return DoWstatCall(APath, ABuf, HookStatKind.Stat64, GRealWstat64,
    ptr to const char("_wstat64"));
end;

end.
