  end;
  LReal := WsopenFn(LFound);
  return LReal(APath, AFlags, AShare, LMode);
end;

// _sopen_s: the descriptor through AFile, the answer an errno (DoFdOpenSecure). No AFile or no
// path is ucrt's own check (the real function's)
public func _sopen_s(const AFile: ptr to int32; const APath: ptr to const char;
  const AFlags: int32; const AShare: int32; const APMode: int32): int32;
var
  LPath: string;
  LFound: ptr;
  LReal: SopenSFn;
begin
  if (AFile <> nil) and (APath <> nil) then
    LPath := StringFromC(APath);
    if DoFdOurs(LPath) then
      return DoFdOpenSecure(AFile, LPath, false, AFlags, AShare, APMode);
    end;
  end;
  LFound := DoReal(GRealSopenS, ptr to const char("_sopen_s"));
  if LFound = nil then
    return ADAM_ERRNO_ENOSYS;
  end;
  LReal := SopenSFn(LFound);
  return LReal(AFile, APath, AFlags, AShare, APMode);
end;

// _wsopen_s: _sopen_s of a UTF-16 path
public func _wsopen_s(const AFile: ptr to int32; const APath: ptr to const wchar;
  const AFlags: int32; const AShare: int32; const APMode: int32): int32;
var
  LPath: string;
  LKind: int32;
  LFound: ptr;
  LReal: WsopenSFn;
begin
  if (AFile <> nil) and (APath <> nil) then
    LKind := DoFdWidePath(APath, LPath);
    if LKind <> 0 then
      return DoFdOpenSecure(AFile, LPath, LKind = 2, AFlags, AShare, APMode);
    end;
  end;
  LFound := DoReal(GRealWsopenS, ptr to const char("_wsopen_s"));
  if LFound = nil then
    return ADAM_ERRNO_ENOSYS;
  end;
  LReal := WsopenSFn(LFound);
  return LReal(AFile, APath, AFlags, AShare, APMode);
end;

// _creat: ucrt's _sopen(APath, _O_CREAT | _O_TRUNC | _O_RDWR, _SH_DENYNO, APMode)
public func _creat(const APath: ptr to const char; const APMode: int32): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: CreatFn;
begin
  if (APath <> nil) and DoFdOpen(StringFromC(APath), _O_CREAT | _O_TRUNC | _O_RDWR, _SH_DENYNO,
    LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealCreat, ptr to const char("_creat"));
  if LFound = nil then
    return -1;
  end;
  LReal := CreatFn(LFound);
  return LReal(APath, APMode);
end;

