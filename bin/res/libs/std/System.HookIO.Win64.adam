// The fstat family through one of its real functions (AName, ASlot its slot) when AFile is no
// handle's
func DoFstat(const AFile: int32; const ABuf: ptr; const AKind: HookStatKind; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FstatFn;
begin
  if DoFdStat(AFile, ABuf, AKind, ASlot, AName, LResult) then
    return LResult;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := FstatFn(LFound);
  return LReal(AFile, ABuf);
end;

// _fstat32 / _fstat32i64 / _fstat64i32 / _fstat64: a handle's descriptor answered (DoFdStat;
// ABuf a struct _stat32 / _stat32i64 / _stat64i32 / _stat64)
public func _fstat32(const AFile: int32; const ABuf: ptr): int32;
begin
  return DoFstat(AFile, ABuf, HookStatKind.Stat32, GRealFstat32, ptr to const char("_fstat32"));
end;

public func _fstat32i64(const AFile: int32; const ABuf: ptr): int32;
begin
  return DoFstat(AFile, ABuf, HookStatKind.Stat32i64, GRealFstat32i64,
    ptr to const char("_fstat32i64"));
end;

public func _fstat64i32(const AFile: int32; const ABuf: ptr): int32;
begin
  return DoFstat(AFile, ABuf, HookStatKind.Stat64i32, GRealFstat64i32,
    ptr to const char("_fstat64i32"));
end;

public func _fstat64(const AFile: int32; const ABuf: ptr): int32;
begin
  return DoFstat(AFile, ABuf, HookStatKind.Stat64, GRealFstat64, ptr to const char("_fstat64"));
end;

// _setmode (mingw's oldnames setmode reaches it too): a handle's descriptor's text mode
// (DoFdSetmode), else ucrt's
public func _setmode(const AFile: int32; const AMode: int32): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: SetmodeFn;
begin
  if DoFdSetmode(AFile, AMode, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealSetmode, ptr to const char("_setmode"));
  if LFound = nil then
    return -1;
  end;
  LReal := SetmodeFn(LFound);
  return LReal(AFile, AMode);
end;

// _chsize_s: a handle's descriptor's IO cut or grown (DoFdChsize), else ucrt's
public func _chsize_s(const AFile: int32; const ASize: int64): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: ChsizeSFn;
begin
  if DoFdChsize(AFile, ASize, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealChsizeS, ptr to const char("_chsize_s"));
  if LFound = nil then
    return ADAM_ERRNO_ENOSYS;
  end;
  LReal := ChsizeSFn(LFound);
  return LReal(AFile, ASize);
end;

// _chsize (mingw's oldnames chsize reaches it too): _chsize_s's 0, else -1 (ucrt's own
// _chsize over _chsize_s)
public func _chsize(const AFile: int32; const ASize: clong): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: ChsizeFn;
begin
  if DoFdChsize(AFile, int64(ASize), LResult) then
    if LResult = 0 then
      return 0;
    end;
    return -1;
  end;
  LFound := DoReal(GRealChsize, ptr to const char("_chsize"));
  if LFound = nil then
    return -1;
  end;
  LReal := ChsizeFn(LFound);
  return LReal(AFile, ASize);
end;

// _get_osfhandle: a handle's descriptor has no OS handle (DoFdOsfhandle), else ucrt's
public func _get_osfhandle(const AFile: int32): int64;
var
  LResult: int64;
  LFound: ptr;
  LReal: FdInt64Fn;
begin
  if DoFdOsfhandle(AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealGetOsfhandle, ptr to const char("_get_osfhandle"));
  if LFound = nil then
    return -1;
  end;
  LReal := FdInt64Fn(LFound);
  return LReal(AFile);
end;

// _dup (mingw's oldnames dup reaches it too): a handle's descriptor's dup (DoFdDup), else
// ucrt's
public func _dup(const AFile: int32): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FdIntFn;
begin
  if DoFdDup(AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealDup, ptr to const char("_dup"));
  if LFound = nil then
    return -1;
  end;
  LReal := FdIntFn(LFound);
  return LReal(AFile);
end;

// _dup2 (mingw's oldnames dup2 reaches it too): a handle's descriptor onto ATarget
// (DoFdDup2), any other onto a handle's number (DoFdDup2Onto), else ucrt's
public func _dup2(const AFile: int32; const ATarget: int32): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: Dup2Fn;
begin
  if DoFdDup2(AFile, ATarget, LResult) then
    return LResult;
  end;
  if DoFdDup2Onto(AFile, ATarget, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealDup2, ptr to const char("_dup2"));
  if LFound = nil then
    return -1;
  end;
  LReal := Dup2Fn(LFound);
  return LReal(AFile, ATarget);
end;

// _fdopen (mingw's oldnames fdopen reaches it too): a FILE on a handle's descriptor
// (DoFdFdopen), else ucrt's. ucrt checks the mode before the number: a nil one is EINVAL with
// the handler run, whoever's the number is
public func _fdopen(const AFile: int32; const AMode: ptr to const char): ptr;
var
  LResult: ptr;
  LFound: ptr;
  LReal: FdopenFn;
begin
  if AMode = nil then
    DoInvalidParameter(ADAM_ERRNO_EINVAL);
    return nil;
  end;
  if DoFdFdopen(AFile, StringFromC(AMode), LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFdopen, ptr to const char("_fdopen"));
  if LFound = nil then
    return nil;
  end;
  LReal := FdopenFn(LFound);
  return LReal(AFile, AMode);
end;

// _wfdopen: _fdopen with a UTF-16 mode (DoFdFdopen over its UTF-8; one ucrt cannot convert is
// EINVAL), else ucrt's
public func _wfdopen(const AFile: int32; const AMode: ptr to const wchar): ptr;
var
  LResult: ptr;
  LMode: string;
  LFound: ptr;
  LReal: WfdopenFn;
  LClosed: bool;
  LHandle: ptr to HookHandle;
begin
  if AMode = nil then
    DoInvalidParameter(ADAM_ERRNO_EINVAL);
    return nil;
  end;
  LHandle := DoFindDescriptor(AFile);
  if LHandle <> nil then
    DoReleaseHandle(LHandle);
    if not DoNarrow(AMode, LMode) then
      SetCErrno(ADAM_ERRNO_EINVAL);
      return nil;
    end;
    if DoFdFdopen(AFile, LMode, LResult) then
      return LResult;
    end;
  end;
  LFound := DoReal(GRealWfdopen, ptr to const char("_wfdopen"));
  if LFound = nil then
    return nil;
  end;
  LReal := WfdopenFn(LFound);
  return LReal(AFile, AMode);
end;

// The stat family of a narrow path through its real function (AName, ASlot its slot) when the
// path is not HookIO's (DoPathStat)
func DoStatCall(const APath: ptr to const char; const ABuf: ptr; const AKind: HookStatKind;
  var ASlot: ptr; const AName: ptr to const char): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: Stat64i32Fn;
begin
  if (APath <> nil) and DoPathStat(StringFromC(APath), ABuf, AKind, LResult) then
    return LResult;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := Stat64i32Fn(LFound);
  return LReal(APath, ABuf);
end;

// The stat family of a UTF-16 path (DoFdWidePath: a virtual one that cannot be narrowed is
// ENOENT, after ucrt's check of the buffer), else its real function
func DoWstatCall(const APath: ptr to const wchar; const ABuf: ptr; const AKind: HookStatKind;
  var ASlot: ptr; const AName: ptr to const char): int32;
var
  LPath: string;
  LKind: int32;
  LResult: int32;
  LFound: ptr;
  LReal: WstatFn;
begin
  LKind := DoFdWidePath(APath, LPath);
  if LKind = 2 then
    if ABuf = nil then
      DoInvalidParameter(ADAM_ERRNO_EINVAL);
    else
      SetCErrno(ADAM_ERRNO_ENOENT);
    end;
    return -1;
  end;
  if (LKind = 1) and DoPathStat(LPath, ABuf, AKind, LResult) then
    return LResult;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := WstatFn(LFound);
  return LReal(APath, ABuf);
end;

// ucrt's stat family (_stat32 / _stat32i64 / _stat64i32 / _stat64 and the _w forms; mingw's
// stat, _stat, _stati64 and _wstat are libcextras aliases of them): a virtual path answered
// (DoPathStat; ABuf a struct _stat32 / _stat32i64 / _stat64i32 / _stat64), anything else ucrt's
public func _stat32(const APath: ptr to const char; const ABuf: ptr): int32;
begin
  return DoStatCall(APath, ABuf, HookStatKind.Stat32, GRealStat32, ptr to const char("_stat32"));
end;

