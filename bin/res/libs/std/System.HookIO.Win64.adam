// A hooked narrow formatted print of AMode's processor: a handle gets the text ucrt formats,
// written as ucrt writes it (DoPrint): the count, or -1. Anything else goes to the real
// function AName (ASlot its slot; -1 with ENOSYS when the C runtime has none)
func DoVfprintf(const AMode: HookPrintMode; const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const char; const ALocale: ptr; const AArgs: ptr; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LAnswer: int32;
  LFound: ptr;
  LReal: VfprintfFn;
begin
  if DoPrint(AFile, AMode, AOptions, AFormat, ALocale, AArgs, LAnswer) then
    return LAnswer;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := VfprintfFn(LFound);
  return LReal(AOptions, AFile, AFormat, ALocale, AArgs);
end;

// __stdio_common_vfprintf: what ucrt's fprintf and the headers' inline vfprintf / printf
// family call (AArgs is their va_list), parsed by ucrt's standard processor (DoVfprintf)
public func __stdio_common_vfprintf(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const char; const ALocale: ptr; const AArgs: ptr): int32;
begin
  return DoVfprintf(HookPrintMode.Standard, AOptions, AFile, AFormat, ALocale, AArgs,
    GRealVfprintf, ptr to const char("__stdio_common_vfprintf"));
end;

// __stdio_common_vfprintf_s: what the headers' inline fprintf_s / vfprintf_s / printf_s family
// calls, parsed by ucrt's validating processor (DoVfprintf: %n and a malformed format a failed
// parameter check)
public func __stdio_common_vfprintf_s(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const char; const ALocale: ptr; const AArgs: ptr): int32;
begin
  return DoVfprintf(HookPrintMode.Validation, AOptions, AFile, AFormat, ALocale, AArgs,
    GRealVfprintfS, ptr to const char("__stdio_common_vfprintf_s"));
end;

// __stdio_common_vfprintf_p: what the headers' inline _fprintf_p / _vfprintf_p / _printf_p
// family calls, parsed by ucrt's positional processor (DoVfprintf: %N$ parameters, validated)
public func __stdio_common_vfprintf_p(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const char; const ALocale: ptr; const AArgs: ptr): int32;
begin
  return DoVfprintf(HookPrintMode.Positional, AOptions, AFile, AFormat, ALocale, AArgs,
    GRealVfprintfP, ptr to const char("__stdio_common_vfprintf_p"));
end;

// __stdio_common_vfscanf: what ucrt's fscanf / vfscanf and the headers' inline scan forms
// (fscanf_s, _fscanf_l, ...) call (AArgs is their va_list). A handle is scanned by the real
// function over a stand-in FILE (DoCallScan), a real FILE by the real function directly (EOF
// with ENOSYS when the C runtime has none)
public func __stdio_common_vfscanf(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const char; const ALocale: ptr; const AArgs: ptr): int32;
var
  LFound: ptr;
  LReal: VfscanfFn;
  LCall: HookCall;
begin
  LFound := DoReal(GRealVfscanf, ptr to const char("__stdio_common_vfscanf"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LCall := DoCall(HookOp.Scan, ADAM_HOOKIO_EOF);
  LCall.ScanReal := LFound;
  LCall.ScanOptions := AOptions;
  LCall.ScanFormat := AFormat;
  LCall.ScanLocale := ALocale;
  LCall.ScanArgs := AArgs;
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LReal := VfscanfFn(LFound);
  return LReal(AOptions, AFile, AFormat, ALocale, AArgs);
end;

// A hooked wide formatted print of AMode's processor: a handle gets the text ucrt formats,
// written as ucrt writes it (DoPrintWide): the count, or -1. Anything else goes to the real
// function AName (ASlot its slot; -1 with ENOSYS when the C runtime has none)
func DoVfwprintf(const AMode: HookPrintMode; const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const wchar; const ALocale: ptr; const AArgs: ptr; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LAnswer: int32;
  LFound: ptr;
  LReal: VfwprintfFn;
begin
  if DoPrintWide(AFile, AMode, AOptions, AFormat, ALocale, AArgs, LAnswer) then
    return LAnswer;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := VfwprintfFn(LFound);
  return LReal(AOptions, AFile, AFormat, ALocale, AArgs);
end;

// __stdio_common_vfwprintf: what ucrt's fwprintf / vfwprintf (mingw's stubs of them) and the
// headers' inline wide printf family call (AArgs is their va_list), parsed by ucrt's standard
// processor (DoVfwprintf)
public func __stdio_common_vfwprintf(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const wchar; const ALocale: ptr; const AArgs: ptr): int32;
begin
  return DoVfwprintf(HookPrintMode.Standard, AOptions, AFile, AFormat, ALocale, AArgs,
    GRealVfwprintf, ptr to const char("__stdio_common_vfwprintf"));
end;

// __stdio_common_vfwprintf_s: what the headers' inline fwprintf_s / vfwprintf_s / wprintf_s
// family calls, parsed by ucrt's validating processor (DoVfwprintf)
public func __stdio_common_vfwprintf_s(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const wchar; const ALocale: ptr; const AArgs: ptr): int32;
begin
  return DoVfwprintf(HookPrintMode.Validation, AOptions, AFile, AFormat, ALocale, AArgs,
    GRealVfwprintfS, ptr to const char("__stdio_common_vfwprintf_s"));
end;

// __stdio_common_vfwprintf_p: what the headers' inline _fwprintf_p / _vfwprintf_p /
// _wprintf_p family calls, parsed by ucrt's positional processor (DoVfwprintf)
public func __stdio_common_vfwprintf_p(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const wchar; const ALocale: ptr; const AArgs: ptr): int32;
begin
  return DoVfwprintf(HookPrintMode.Positional, AOptions, AFile, AFormat, ALocale, AArgs,
    GRealVfwprintfP, ptr to const char("__stdio_common_vfwprintf_p"));
end;

// __stdio_common_vfwscanf: what ucrt's fwscanf / vfwscanf (mingw's stubs of them) and the
// headers' inline wide scan forms call (AArgs is their va_list). A handle is scanned by the
// real function over stand-in FILEs (DoCallScanWide), a real FILE by the real function
// directly (EOF with ENOSYS when the C runtime has none)
public func __stdio_common_vfwscanf(const AOptions: uint64; const AFile: ptr;
  const AFormat: ptr to const wchar; const ALocale: ptr; const AArgs: ptr): int32;
var
  LFound: ptr;
  LReal: VfwscanfFn;
  LCall: HookCall;
begin
  LFound := DoReal(GRealVfwscanf, ptr to const char("__stdio_common_vfwscanf"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LCall := DoCall(HookOp.ScanWide, ADAM_HOOKIO_EOF);
  LCall.ScanReal := LFound;
  LCall.ScanOptions := AOptions;
  LCall.ScanWideFormat := AFormat;
  LCall.ScanLocale := ALocale;
  LCall.ScanArgs := AArgs;
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LReal := VfwscanfFn(LFound);
  return LReal(AOptions, AFile, AFormat, ALocale, AArgs);
end;

// A setvbuf call of AMode at ASize bytes over ABuffer (nil: no array): Refused for a mode
// ucrt refuses or, buffering, a size outside 2 .. INT_MAX; else Size is the usable size
// (rounded down to even). The failure value is -1
func DoSetvbufCall(const ABuffer: ptr to char; const AMode: int32; const ASize: uint64):
  HookCall;
var
  LCall: HookCall;
begin
  LCall := DoCall(HookOp.Setvbuf, -1);
  LCall.Buffer := ptr to uint8(ptr(ABuffer));
  LCall.Value := AMode;
  if (AMode <> _IONBF) and (AMode <> _IOFBF) and
    (AMode <> _IOLBF) then
    LCall.Refused := true;
    return LCall;
  end;
  if AMode = _IONBF then
    return LCall;
  end;
  if (ASize < 2) or (ASize > uint64(INT_MAX)) then
    LCall.Refused := true;
    return LCall;
  end;
  LCall.Size := int64(ASize & uint64(0x7FFFFFFE));
  return LCall;
end;

// setvbuf: a handle's buffer as ucrt's setvbuf sets it (DoCallSetvbuf): 0, or -1 (EINVAL for
// a mode or size ucrt refuses). Anything else goes to the real function (-1 with ENOSYS when
// the C runtime has none)
public func setvbuf(const AFile: ptr; const ABuffer: ptr to char; const AMode: int32;
  const ASize: uint64): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: SetvbufFn;
begin
  LCall := DoSetvbufCall(ABuffer, AMode, ASize);
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(GRealSetvbuf, ptr to const char("setvbuf"));
  if LFound = nil then
    return -1;
  end;
  LReal := SetvbufFn(LFound);
  return LReal(AFile, ABuffer, AMode, ASize);
end;

// setbuf, as ucrt's: no array is setvbuf's _IONBF, an array is _IOFBF at BUFSIZ. Anything
// else goes to the real function (ENOSYS when the C runtime has none)
public func setbuf(const AFile: ptr; const ABuffer: ptr to char);
var
  LCall: HookCall;
  LFound: ptr;
  LReal: SetbufFn;
begin
  if ABuffer = nil then
    LCall := DoSetvbufCall(nil, _IONBF, 0);
  else
    LCall := DoSetvbufCall(ABuffer, _IOFBF, BUFSIZ);
  end;
  if DoWith(AFile, LCall) then
    return;
  end;
  LFound := DoReal(GRealSetbuf, ptr to const char("setbuf"));
  if LFound = nil then
    return;
  end;
  LReal := SetbufFn(LFound);
  LReal(AFile, ABuffer);
end;

// fflush: a handle's written bytes, then its IO's own flush; fflush(NULL) flushes every
// stream, the C runtime's and every handle. The runtime's own `external` fflush binds here
// too: stdout is no handle, so it goes to the real one
public func fflush(const AFile: ptr): int32;
begin
  return DoFlush(AFile, GRealFflush, ptr to const char("fflush"));
end;

// _fflush_nolock: fflush
public func _fflush_nolock(const AFile: ptr): int32;
begin
  return DoFlush(AFile, GRealFflushNolock, ptr to const char("_fflush_nolock"));
end;

// _fclose_nolock: fclose
public func _fclose_nolock(const AFile: ptr): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FcloseFn;
begin
  if DoClose(AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFcloseNolock, ptr to const char("_fclose_nolock"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := FcloseFn(LFound);
  return LReal(AFile);
end;

// fgetpos (ucrt's fgetpos.cpp): the handle's place (_ftelli64's, DoTellCall) in APosition^,
// then 0, or -1 when that place is -1. No position, and anything that is no handle, goes to
// the real function (it checks the position before the stream: EINVAL, -1)
public func fgetpos(const AFile: ptr; const APosition: ptr to int64): int32;
var
  LPlace: int64;
  LFound: ptr;
  LReal: FposFn;
begin
  if (APosition <> nil) and DoTellCall(AFile, LPlace) then
    APosition^ := LPlace;
    if LPlace = -1 then
      return -1;
    end;
    return 0;
  end;
  LFound := DoReal(GRealFgetpos, ptr to const char("fgetpos"));
  if LFound = nil then
    return -1;
  end;
  LReal := FposFn(LFound);
  return LReal(AFile, APosition);
end;

// fsetpos (ucrt's fsetpos.cpp): _fseeki64 to APosition^ from the start (DoSeekCall). No
// position, and anything that is no handle, goes to the real function
public func fsetpos(const AFile: ptr; const APosition: ptr to int64): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FposFn;
begin
  if (APosition <> nil) and DoSeekCall(AFile, APosition^, ADAM_HOOKIO_SEEK_SET, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFsetpos, ptr to const char("fsetpos"));
  if LFound = nil then
    return -1;
  end;
  LReal := FposFn(LFound);
  return LReal(AFile, APosition);
end;

// clearerr_s (ucrt's clearerr.cpp): clearerr's flags on a handle, then 0
public func clearerr_s(const AFile: ptr): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FileIntFn;
begin
  LCall := DoCall(HookOp.ClearError, 0);
  if DoWith(AFile, LCall) then
    return 0;
  end;
  LFound := DoReal(GRealClearerrS, ptr to const char("clearerr_s"));
  if LFound = nil then
    return ADAM_ERRNO_ENOSYS;
  end;
  LReal := FileIntFn(LFound);
  return LReal(AFile);
end;

// _getw (ucrt's getw.cpp): the int of the next 4 bytes (_getc_nolock each, little-endian), or
// EOF when the end or an error came on the way (as feof / ferror tell after the 4 reads)
public func _getw(const AFile: ptr): int32;
var
  LValue: uint32;
  LI: int32;
  LFound: ptr;
  LReal: FileIntFn;
begin
  if DoOwns(AFile) then
    LValue := 0;
    for LI := 0 to 3 do
      LValue := LValue | ((uint32(_getc_nolock(AFile)) & 0xFF) shl (uint32(LI) * 8));
    end;
    if (feof(AFile) <> 0) or (ferror(AFile) <> 0) then
      return ADAM_HOOKIO_EOF;
    end;
    return int32(LValue);
  end;
  LFound := DoReal(GRealGetw, ptr to const char("_getw"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := FileIntFn(LFound);
  return LReal(AFile);
end;

// _putw (ucrt's putw.cpp): AValue's 4 bytes (_fputc_nolock each, little-endian), then AValue,
// or EOF when ferror tells of an error after them
public func _putw(const AValue: int32; const AFile: ptr): int32;
var
  LI: int32;
  LFound: ptr;
  LReal: CharFileFn;
begin
  if DoOwns(AFile) then
    for LI := 0 to 3 do
      _fputc_nolock(int32((uint32(AValue) shr (uint32(LI) * 8)) & 0xFF), AFile);
    end;
    if ferror(AFile) <> 0 then
      return ADAM_HOOKIO_EOF;
    end;
    return AValue;
  end;
  LFound := DoReal(GRealPutw, ptr to const char("_putw"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := CharFileFn(LFound);
  return LReal(AValue, AFile);
end;

// freopen_s (ucrt's freopen.cpp common_freopen): the reopened stream in AResult^ (nil first),
// 0, or the reopen's errno (DoReopen). No AResult goes to the real function (it checks it
// before the stream: EINVAL), and so does anything that is no handle
public func freopen_s(const AResult: ptr to ptr; const APath: ptr to const char;
  const AMode: ptr to const char; const AFile: ptr): int32;
var
  LFile: ptr;
  LFound: ptr;
  LReal: FreopenSFn;
begin
  if (AResult <> nil) and DoOwns(AFile) then
    AResult^ := nil;
    if DoReopen(APath, AMode, AFile, LFile) then
      if LFile = nil then
        return CErrno();
      end;
      AResult^ := LFile;
      return 0;
    end;
  end;
  LFound := HookReal(GRealFreopenS, ptr to const char("freopen_s"));
  if LFound = nil then
    return ADAM_ERRNO_ENOSYS;
  end;
  LReal := FreopenSFn(LFound);
  return LReal(AResult, APath, AMode, AFile);
end;

// A reopen of the handle AFile that fails after its close (ucrt's order: the old stream is
// closed, then the open fails): the stream closed and out of the open list, errno AErrno
func DoReopenFailed(const AFile: ptr; const AErrno: int32);
var
  LOld: ptr to HookHandle;
begin
  LOld := DoFindHandle(AFile);
  if LOld = nil then
    return;
  end;
  DoShutHandle(LOld);
  DoForgetHandle(AFile);
  DoReleaseHandle(LOld);
  SetCErrno(AErrno);
end;

// A wide reopen of the handle AFile (_wfreopen / _wfreopen_s): the path and the mode as UTF-8
// (DoNarrow), then DoReopen. ucrt's checks on no path, no mode and an empty path come first
// (DoReopen's); then, as ucrt's open after the close, a mode that does not convert is its
// parse's refusal (EINVAL) and a path that does not convert a missing file (ENOENT, as an
// io:// path's that does not convert in _wfopen): the stream closed (DoReopenFailed). False:
// AFile is no handle
func DoReopenWide(const APath: ptr to const wchar; const AMode: ptr to const wchar;
  const AFile: ptr; var AResult: ptr): bool;
var
  LPath: string;
  LMode: string;
  LAnswered: bool;
begin
  AResult := nil;
  if not DoOwns(AFile) then
    return false;
  end;
  if (APath = nil) or (AMode = nil) or (uint32(APath[0]) = 0) then
    return DoReopen(ptr to const char(ptr(APath)), ptr to const char(ptr(AMode)), AFile,
      AResult);
  end;
  if not DoNarrow(AMode, LMode) then
    DoReopenFailed(AFile, ADAM_ERRNO_EINVAL);
    return true;
  end;
  if not DoNarrow(APath, LPath) then
    DoReopenFailed(AFile, ADAM_ERRNO_ENOENT);
    return true;
  end;
  LAnswered := DoReopen(LPath, LMode, AFile, AResult);
  return LAnswered;
end;

// _wfreopen: freopen of a wide path and mode (DoReopenWide)
public func _wfreopen(const APath: ptr to const wchar; const AMode: ptr to const wchar;
  const AFile: ptr): ptr;
var
  LFile: ptr;
  LFound: ptr;
  LReal: WfreopenFn;
begin
  if DoReopenWide(APath, AMode, AFile, LFile) then
    return LFile;
  end;
  LFound := HookReal(GRealWfreopen, ptr to const char("_wfreopen"));
  if LFound = nil then
    SetCErrno(ADAM_ERRNO_ENOSYS);
    return nil;
  end;
  LReal := WfreopenFn(LFound);
  return LReal(APath, AMode, AFile);
end;

// _wfreopen_s: freopen_s of a wide path and mode (DoReopenWide)
public func _wfreopen_s(const AResult: ptr to ptr; const APath: ptr to const wchar;
  const AMode: ptr to const wchar; const AFile: ptr): int32;
var
  LFile: ptr;
  LFound: ptr;
  LReal: WfreopenSFn;
begin
  if AResult <> nil then
    if DoOwns(AFile) then
      AResult^ := nil;
    end;
    if DoReopenWide(APath, AMode, AFile, LFile) then
      if LFile = nil then
        return CErrno();
      end;
      AResult^ := LFile;
      return 0;
    end;
  end;
  LFound := HookReal(GRealWfreopenS, ptr to const char("_wfreopen_s"));
  if LFound = nil then
    return ADAM_ERRNO_ENOSYS;
  end;
  LReal := WfreopenSFn(LFound);
  return LReal(AResult, APath, AMode, AFile);
end;

// fread_s / _fread_nolock_s (ucrt's fread.cpp): fread into ABuffer of ARoom bytes
// (DoCallRead's checks; ARoom -1, SIZE_MAX, is no bound, fread's own). No bytes is 0 before
// the stream is looked at, as ucrt's
func DoFreadS(const ABuffer: ptr; const ARoom: int64; const ASize: int64;
  const ACount: int64; const AFile: ptr; var ASlot: ptr; const AName: ptr to const char):
  int64;
var
  LResult: int64;
  LFound: ptr;
  LReal: FreadSFn;
begin
  if (ASize = 0) or (ACount = 0) then
    return 0;
  end;
  if DoTransferRoom(HookOp.Read, ABuffer, ARoom, ASize, ACount, AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return 0;
  end;
  LReal := FreadSFn(LFound);
  return LReal(ABuffer, ARoom, ASize, ACount, AFile);
end;

public func fread_s(const ABuffer: ptr; const ARoom: int64; const ASize: int64;
  const ACount: int64; const AFile: ptr): int64;
begin
  return DoFreadS(ABuffer, ARoom, ASize, ACount, AFile, GRealFreadS,
    ptr to const char("fread_s"));
end;

public func _fread_nolock_s(const ABuffer: ptr; const ARoom: int64; const ASize: int64;
  const ACount: int64; const AFile: ptr): int64;
begin
  return DoFreadS(ABuffer, ARoom, ASize, ACount, AFile, GRealFreadNolockS,
    ptr to const char("_fread_nolock_s"));
end;

// --- lowio on a handle's descriptor --------------------------------------------------------
// A handle's descriptor (fileno's, or the one a hooked lowio open of a virtual path made) is
// lowio's own descriptor of the handle, as ucrt's FILE and its fh share one: the place
// (Base.Position), the text mode and its Ctrl-Z end, the rights. So a C library mixing
// _fileno and fread on one FILE, or reading a virtual file through _open / _fstat64 / _read /
// _lseeki64 / _close, sees what ucrt gives on a real file of the same bytes

// True (ucrt's failed parameter check run: EBADF, then the handler) when descriptor AHandle can
// take no call: its handle closed, or _close ran on its number. The caller holds the stream
// lock
func DoFdGone(const AHandle: ptr to HookHandle): bool;
begin
  if AHandle->Closed then
    DoInvalidParameter(ADAM_ERRNO_EBADF);
    return true;
  end;
  return DoLowClosed(AHandle);
end;

// lowio's lseek of descriptor AHandle (the caller holds its stream lock): AOffset from the
// start (SEEK_SET), its place (SEEK_CUR) or its end (SEEK_END); the new place, or -1 with
// EINVAL (an unknown origin, a place before the start or one the IO cannot reach: the place
// kept). Success clears the Ctrl-Z end. A Pipe handle's place is a number only (its end is
// 0), its IO stays where it is
func DoFdSeekLocked(const AHandle: ptr to HookHandle; const AOffset: int64;
  const AOrigin: int32): int64;
var
  LBase: int64;
  LTarget: int64;
begin
  if (AOrigin <> ADAM_HOOKIO_SEEK_SET) and (AOrigin <> ADAM_HOOKIO_SEEK_CUR) and
    (AOrigin <> ADAM_HOOKIO_SEEK_END) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return -1;
  end;
  LBase := 0;
  if AOrigin = ADAM_HOOKIO_SEEK_CUR then
    LBase := AHandle->Base.Position;
  end;
  if (AOrigin = ADAM_HOOKIO_SEEK_END) and (not AHandle->Pipe) then
    LBase := IOSize(AHandle->Base.Stream);
    // An IO with no size may still know its end
    if LBase < 0 then
      LBase := IOSeek(AHandle->Base.Stream, 0, SeekOrigin.FromEnd);
    end;
    if LBase < 0 then
      SetCErrno(ADAM_ERRNO_EINVAL);
      return -1;
    end;
  end;
  // The sum is checked before it is formed
  if (AOffset > 0) and (LBase > ADAM_HOOKIO_MAX_BYTES - AOffset) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return -1;
  end;
  LTarget := LBase + AOffset;
  if LTarget < 0 then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return -1;
  end;
  if not DoLowMoveLocked(AHandle, LTarget) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return -1;
  end;
  AHandle->Base.Position := LTarget;
  AHandle->Crt.LowEof := false;
  return LTarget;
end;

// _read of descriptor AFile when it is a handle's. False: not a handle's. True: AResult the
// count (0 at the end, or once a text read met a Ctrl-Z), or -1 with errno: ucrt's parameter
// checks (a closed number EBADF; a count past INT_MAX, no buffer EINVAL; the handler run),
// lowio's read's (DoLowReadLocked: a write-only descriptor EBADF ..). A count of 0 reads
// nothing before the buffer is checked, as ucrt's
func DoFdRead(const AFile: int32; const ABuffer: ptr; const ACount: uint32;
  var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if not DoFdGone(LHandle) then
      if int64(ACount) > ADAM_HOOKIO_LOW_READ_MAX then
        DoInvalidParameter(ADAM_ERRNO_EINVAL);
      else
        if (int64(ACount) = 0) or LHandle->Crt.LowEof then
          AResult := 0;
        else
          if ABuffer = nil then
            DoInvalidParameter(ADAM_ERRNO_EINVAL);
          else
            AResult := int32(DoLowReadLocked(LHandle, ptr to uint8(ABuffer), int64(ACount)));
          end;
        end;
      end;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// _write of descriptor AFile when it is a handle's. False: not a handle's. True: AResult the
// count written, or -1 with errno: ucrt's parameter checks (a closed number EBADF, no buffer
// EINVAL; the handler run), lowio's write's (DoLowWriteLocked: a read-only descriptor EBADF,
// an odd count in a Unicode text mode EINVAL, nothing written ENOSPC ..). A count of 0
// writes nothing before the buffer is checked, as ucrt's
func DoFdWrite(const AFile: int32; const ABuffer: ptr; const ACount: uint32;
  var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if not DoFdGone(LHandle) then
      if int64(ACount) = 0 then
        AResult := 0;
      else
        if ABuffer = nil then
          DoInvalidParameter(ADAM_ERRNO_EINVAL);
        else
          AResult := int32(DoLowWriteLocked(LHandle, ptr to uint8(ABuffer), int64(ACount)));
        end;
      end;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// _lseeki64 (ALong false) or _lseek (ALong true) of descriptor AFile when it is a handle's
// (DoFdSeekLocked). False: not a handle's. True: AResult the new place, or -1 with errno: a
// closed number EBADF (the handler run), DoFdSeekLocked's EINVAL; _lseek's place past LONG_MAX
// is EINVAL with the place and the Ctrl-Z end kept
func DoFdSeek(const AFile: int32; const AOffset: int64; const AOrigin: int32;
  const ALong: bool; var AResult: int64): bool;
var
  LHandle: ptr to HookHandle;
  LKeep: int64;
  LEof: bool;
  LGot: int64;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if not DoFdGone(LHandle) then
      LKeep := LHandle->Base.Position;
      LEof := LHandle->Crt.LowEof;
      LGot := DoFdSeekLocked(LHandle, AOffset, AOrigin);
      if ALong and (LGot > int64(LONG_MAX)) then
        DoLowMoveLocked(LHandle, LKeep);
        LHandle->Base.Position := LKeep;
        LHandle->Crt.LowEof := LEof;
        SetCErrno(ADAM_ERRNO_EINVAL);
        LGot := -1;
      end;
      AResult := LGot;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// _eof (AEnd false) or _filelength / _filelengthi64 (AEnd true; ALong: _filelength's long) of
// descriptor AFile when it is a handle's, as ucrt's sources build them on lseek: the place,
// then the end (that lseek clears the Ctrl-Z end), then back to the place when they differ.
// False: not a handle's. True: AResult _eof's 1 at the end / 0 before it, the length's end,
// or -1 with errno: a closed number EBADF (the handler run), a failed lseek's EINVAL, a
// _filelength past LONG_MAX EINVAL
func DoFdEnd(const AFile: int32; const AEnd: bool; const ALong: bool;
  var AResult: int64): bool;
var
  LHandle: ptr to HookHandle;
  LHere: int64;
  LEnd: int64;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if not DoFdGone(LHandle) then
      LHere := DoFdSeekLocked(LHandle, 0, ADAM_HOOKIO_SEEK_CUR);
      if LHere >= 0 then
        LEnd := DoFdSeekLocked(LHandle, 0, ADAM_HOOKIO_SEEK_END);
        if LEnd >= 0 then
          if LEnd <> LHere then
            DoFdSeekLocked(LHandle, LHere, ADAM_HOOKIO_SEEK_SET);
          end;
          if not AEnd then
            AResult := 0;
            if LEnd = LHere then
              AResult := 1;
            end;
          else
            if ALong and (LEnd > int64(LONG_MAX)) then
              SetCErrno(ADAM_ERRNO_EINVAL);
            else
              AResult := LEnd;
            end;
          end;
        end;
      end;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// _commit of descriptor AFile when it is a handle's: its IO flushed (FlushFileBuffers' part).
// False: not a handle's. True: AResult 0, or -1 with errno: a closed number EBADF (the handler
// run), a flush the IO refuses EBADF (ucrt's answer to a failed FlushFileBuffers). A real
// file's description (DoRealPlace) is ucrt's own _commit of its RealFile (the same file
// object's FlushFileBuffers)
func DoFdCommit(const AFile: int32; var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
  LFound: ptr;
  LReal: FdIntFn;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if not DoFdGone(LHandle) then
      if DoRealPlace(LHandle) then
        LFound := DoReal(GRealCommit, ptr to const char("_commit"));
        if LFound <> nil then
          LReal := FdIntFn(LFound);
          AResult := LReal(DoPlaceOf(LHandle)->RealFile);
        end;
      else
        if IOFlush(LHandle->Base.Stream) then
          AResult := 0;
        else
          SetCErrno(ADAM_ERRNO_EBADF);
        end;
      end;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// _close of descriptor AFile when it is a handle's. False: not a handle's. True: AResult 0, or
// -1 with errno: a closed number EBADF (the handler run); the open that made the descriptor
// closes its handle (DoClose: a failed close of its IO EIO). A FILE's own number (fileno's)
// stays reserved, closed (its calls and the stream's own lowio calls are ucrt's on a number
// that is not open: EBADF, the handler run) until that fclose, so no other open meets the
// stream
func DoFdClose(const AFile: int32; var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  DoCloseNumberOf(LHandle, AResult);
  DoReleaseHandle(LHandle);
  return true;
end;

// _close of the number number handle AHandle holds (DoFdClose, an _fdopen FILE's fclose): AResult
// 0, or -1 with errno: a closed number EBADF (the handler run); a lowio open's or a dup's
// number closes its handle (DoClose: a failed close of its IO EIO); a FILE's own number is
// marked closed (DoFdClose)
func DoCloseNumberOf(const AHandle: ptr to HookHandle; var AResult: int32);
var
  LOwned: bool;
  LClosed: int32;
begin
  AResult := -1;
  LOwned := false;
  lock (AHandle->Base.Lock->Lock) do
    DoJoinLocked(AHandle);
    defer DoPartLocked(AHandle);
    if not DoFdGone(AHandle) then
      if AHandle->DescriptorOwned then
        LOwned := true;
      else
        AHandle->DescriptorClosed := true;
        AResult := 0;
      end;
    end;
  end;
  if LOwned then
    // The open list's handle (DoFdOpen / DoNewNumberLocked added it); a close that raced this
    // one took it first
    if not DoClose(ptr(AHandle), LClosed) then
      DoInvalidParameter(ADAM_ERRNO_EBADF);
    else
      if LClosed = 0 then
        AResult := 0;
      else
        SetCErrno(ADAM_ERRNO_EIO);
      end;
    end;
  end;
end;

// The fstat family on descriptor AFile when it is a handle's, filling ABuf as AKind's record
// the way ucrt's fstat fills a real descriptor's (fstat.cpp): a disk file's is a regular file,
// read for everyone, write as the IO or the descriptor writes (the owner's bits copied to
// group and other), on no device; a pipe's (an IO that cannot seek) a FIFO of size 0 with no
// bits, the number its device. False: not a handle's. True: AResult 0, or -1 with errno: no
// buffer EINVAL and a closed number EBADF (ucrt's parameter checks, in that order, the
// handler run), a size past the record's st_size EOVERFLOW. A real file's description
// (DoRealPlace) is answered by ucrt's own fstat (AName, ASlot its slot) of its RealFile, the
// file's own times, size and bits; a device or pipe's st_dev / st_rdev are then AFile, as
// ucrt puts the number there (DoStatDevice)
func DoFdStat(const AFile: int32; const ABuf: ptr; const AKind: HookStatKind; var ASlot: ptr;
  const AName: ptr to const char; var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
  LSize: int64;
  LModeBits: uint16;
  LFound: ptr;
  LReal: FstatFn;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  if ABuf = nil then
    DoInvalidParameter(ADAM_ERRNO_EINVAL);
    DoReleaseHandle(LHandle);
    return true;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if not DoFdGone(LHandle) then
      if DoRealPlace(LHandle) then
        LFound := DoReal(ASlot, AName);
        if LFound <> nil then
          LReal := FstatFn(LFound);
          AResult := LReal(DoPlaceOf(LHandle)->RealFile, ABuf);
          if (AResult = 0) and LHandle->Pipe then
            DoStatDevice(ABuf, AKind, uint32(AFile));
          end;
        end;
      else
        if LHandle->Pipe then
          DoFillStat(ABuf, AKind, _S_IFIFO, uint32(AFile), 0, AResult);
        else
          LSize := IOSize(LHandle->Base.Stream);
          if LSize < 0 then
            LSize := 0;
          end;
          // uint16 operands promote to int32: each result is narrowed back
          LModeBits := uint16(_S_IFREG | _S_IREAD);
          if DoCanWrite(LHandle) or IOCanWrite(LHandle->Base.Stream) then
            LModeBits := uint16(LModeBits | _S_IWRITE);
          end;
          LModeBits := uint16(LModeBits | ((LModeBits & ADAM_HOOKIO_S_OWNER) shr 3) |
            ((LModeBits & ADAM_HOOKIO_S_OWNER) shr 6));
          DoFillStat(ABuf, AKind, LModeBits, 0u, LSize, AResult);
        end;
      end;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// _setmode_nolock (setmode.cpp) on handle AHandle (the caller holds its stream lock): AMode
// (one of _O_BINARY, _O_TEXT, _O_U8TEXT, _O_U16TEXT, _O_WTEXT, checked by the caller) sets
// lowio's text mode in place (_O_BINARY only clears it, keeping the text kind; _O_U16TEXT and
// _O_WTEXT are both UTF-16; _tm_unicode is left as the open made it); the old mode answered:
// _O_BINARY, else _O_TEXT / _O_U8TEXT for an ANSI / UTF-8 kind, else _O_WTEXT (ucrt's answer
// for UTF-16 whichever flag set it)
func DoSetmodeLocked(const AHandle: ptr to HookHandle; const AMode: int32): int32;
var
  LWasText: bool;
  LWasKind: HookLowText;
begin
  LWasText := AHandle->Text;
  LWasKind := AHandle->LowText;
  if AMode = _O_BINARY then
    AHandle->Text := false;
  else
    AHandle->Text := true;
    if AMode = _O_TEXT then
      AHandle->LowText := HookLowText.Ansi;
    else
      if AMode = _O_U8TEXT then
        AHandle->LowText := HookLowText.Utf8;
      else
        AHandle->LowText := HookLowText.Utf16;
      end;
    end;
  end;
  if not LWasText then
    return _O_BINARY;
  end;
  if LWasKind = HookLowText.Ansi then
    return _O_TEXT;
  end;
  if LWasKind = HookLowText.Utf8 then
    return _O_U8TEXT;
  end;
  return _O_WTEXT;
end;

// _setmode of descriptor AFile when it is a handle's (setmode.cpp). False: not a handle's.
// True: AResult the old mode (DoSetmodeLocked), or -1 with errno: a mode none of _O_TEXT,
// _O_BINARY, _O_WTEXT, _O_U8TEXT, _O_U16TEXT EINVAL, then a closed number EBADF (ucrt's
// parameter checks in that order, the handler run). The stream on the descriptor reads and
// writes in the new mode from its next call, as ucrt's FILE does (its calls run on lowio's
// mode)
func DoFdSetmode(const AFile: int32; const AMode: int32; var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  if (AMode <> _O_TEXT) and (AMode <> _O_BINARY) and (AMode <> _O_WTEXT) and
    (AMode <> _O_U8TEXT) and (AMode <> _O_U16TEXT) then
    DoInvalidParameter(ADAM_ERRNO_EINVAL);
    DoReleaseHandle(LHandle);
    return true;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if not DoFdGone(LHandle) then
      AResult := DoSetmodeLocked(LHandle, AMode);
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// _chsize_nolock (chsize.cpp) on handle AHandle (the caller holds its stream lock): the IO cut
// or grown to ASize bytes, the descriptor's place kept. As ucrt's seek guard: the place, then
// the end (each a lowio lseek, which clears the Ctrl-Z end), and the place set back whatever
// happens. Growing writes zero bytes at the end, ADAM_HOOKIO_BUFFER_SIZE (_INTERNAL_BUFSIZ) at
// a time, in binary mode (the old mode set back after the last write; a failed write leaves
// the descriptor binary, as ucrt's early return does); cutting is a lseek to ASize, then the
// IO truncated (SetEndOfFile's part). 0, or the errno: a failed lseek's (EINVAL when it left
// none), a failed write's (a descriptor that cannot write EACCES, ucrt's map of
// ERROR_ACCESS_DENIED), an IO that refuses the cut EACCES. errno is set as ucrt sets it
func DoChsizeLocked(const AHandle: ptr to HookHandle; const ASize: int64): int32;
var
  LPlace: int64;
  LEnd: int64;
  LExtend: int64;
  LZeros: array of uint8;
  LChunk: int64;
  LWritten: int64;
  LOldMode: int32;
  LAnswer: int32;
begin
  LAnswer := 0;
  LPlace := DoFdSeekLocked(AHandle, 0, ADAM_HOOKIO_SEEK_CUR);
  LEnd := DoFdSeekLocked(AHandle, 0, ADAM_HOOKIO_SEEK_END);
  if (LPlace = -1) or (LEnd = -1) then
    LAnswer := CErrno();
    if LAnswer = 0 then
      LAnswer := ADAM_ERRNO_EINVAL;
    end;
  else
    LExtend := ASize - LEnd;
    if LExtend > 0 then
      setlength(LZeros, ADAM_HOOKIO_BUFFER_SIZE);
      LOldMode := DoSetmodeLocked(AHandle, _O_BINARY);
      while (LAnswer = 0) and (LExtend > 0) do
        LChunk := ADAM_HOOKIO_BUFFER_SIZE;
        if LExtend < LChunk then
          LChunk := LExtend;
        end;
        LWritten := DoLowWriteLocked(AHandle, addr of LZeros[0], LChunk);
        if LWritten = -1 then
          if not DoCanWrite(AHandle) then
            SetCErrno(ADAM_ERRNO_EACCES);
          end;
          LAnswer := CErrno();
        else
          LExtend := LExtend - LWritten;
        end;
      end;
      if LAnswer = 0 then
        DoSetmodeLocked(AHandle, LOldMode);
      end;
    else
      if LExtend < 0 then
        if DoFdSeekLocked(AHandle, ASize, ADAM_HOOKIO_SEEK_SET) = -1 then
          LAnswer := CErrno();
        else
          if not IOTruncate(AHandle->Base.Stream, ASize) then
            SetCErrno(ADAM_ERRNO_EACCES);
            LAnswer := ADAM_ERRNO_EACCES;
          end;
        end;
      end;
    end;
  end;
  // The seek guard's destructor: back to the place (a failed first lseek's -1 included)
  DoFdSeekLocked(AHandle, LPlace, ADAM_HOOKIO_SEEK_SET);
  return LAnswer;
end;

// _chsize_s of descriptor AFile when it is a handle's (chsize.cpp; _chsize is its 0 / -1).
// False: not a handle's. True: AResult 0 or the errno: a closed number EBADF, then a size
// below 0 EINVAL (ucrt's parameter checks in that order, the handler run), else
// DoChsizeLocked's
func DoFdChsize(const AFile: int32; const ASize: int64; var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
begin
  AResult := ADAM_ERRNO_EBADF;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if not DoFdGone(LHandle) then
      if ASize < 0 then
        DoInvalidParameter(ADAM_ERRNO_EINVAL);
        AResult := ADAM_ERRNO_EINVAL;
      else
        AResult := DoChsizeLocked(LHandle, ASize);
      end;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// _get_osfhandle of descriptor AFile when it is a handle's (osfinfo.cpp). False: not a
// handle's. True: AResult INVALID_HANDLE_VALUE (-1): the descriptor is open but no OS handle
// stands behind it (its bytes are an IO's, not a file object's), what ucrt answers for an open
// number whose _osfhnd is INVALID_HANDLE_VALUE, errno as it was; a closed number EBADF (the
// handler run). Never the reservation's NUL handle: a Win32 call on it would read nothing and
// write nowhere where the caller meant the handle's bytes. A real file's description
// (DoRealPlace) has a file object behind it: ucrt's own _get_osfhandle of its RealFile (a
// handle to the same file object, as the number's own would be)
func DoFdOsfhandle(const AFile: int32; var AResult: int64): bool;
var
  LHandle: ptr to HookHandle;
  LFound: ptr;
  LReal: FdInt64Fn;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if (not DoFdGone(LHandle)) and DoRealPlace(LHandle) then
      LFound := DoReal(GRealGetOsfhandle, ptr to const char("_get_osfhandle"));
      if LFound <> nil then
        LReal := FdInt64Fn(LFound);
        AResult := LReal(DoPlaceOf(LHandle)->RealFile);
      end;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// _dup of descriptor AFile when it is a handle's (dup.cpp). False: not a handle's. True:
// AResult the new number (a reservation, DoNewNumberLocked: the file pointer shared, the lowio
// state copied), or -1 with errno: a closed number EBADF (the handler run), no number left
// (ucrt's EMFILE from the reservation's open), ENOMEM. A success leaves errno as it was
func DoFdDup(const AFile: int32; var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
  LNumber: int32;
  LError: int32;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  LError := CErrno();
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if not DoFdGone(LHandle) then
      LNumber := DoReserveDescriptor();
      if LNumber >= 0 then
        AResult := DoNewNumberLocked(LHandle, LNumber);
        if AResult < 0 then
          DoCloseReserved(LNumber);
        else
          SetCErrno(LError);
        end;
      end;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// --- a real file put on a handle's number (_dup2 of a descriptor ucrt opened itself) --------

// The IO of a real file's description (DoRealDescription): ucrt's own _read / _write /
// _lseeki64 / _fstat64 / _chsize_s / _close on the binary duplicate its user pointer holds,
// never the hooks (that number is no handle's). A failed call is IOState.Error with ucrt's
// errno kept
func DoRealFileOf(const AUserData: ptr): int32;
begin
  return int32(int64(uint64(AUserData)));
end;

func DoRealFileRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64;
  var AState: IOState): int64;
var
  LFound: ptr;
  LRead: FdReadFn;
  LCount: int64;
  LGot: int32;
begin
  LFound := DoReal(GRealRead, ptr to const char("_read"));
  if LFound = nil then
    AState := IOState.Error;
    return 0;
  end;
  LRead := FdReadFn(LFound);
  // lowio reads at most INT_MAX bytes at a time; a short count is not the end
  LCount := ASize;
  if LCount > ADAM_HOOKIO_LOW_READ_MAX then
    LCount := ADAM_HOOKIO_LOW_READ_MAX;
  end;
  LGot := LRead(DoRealFileOf(AUserData), ABuffer, uint32(LCount));
  if LGot < 0 then
    AState := IOState.Error;
    return 0;
  end;
  if LGot = 0 then
    AState := IOState.Eof;
  end;
  return int64(LGot);
end;

// Writes all ASize bytes, lowio's largest count at a time; a write that stops short (ucrt's
// -1: a full disk ENOSPC, a handle without write access EBADF) is IOState.Error with what
// landed before it
func DoRealFileWrite(const AUserData: ptr; const ABuffer: ptr to const; const ASize: int64;
  var AState: IOState): int64;
var
  LFound: ptr;
  LWrite: FdWriteFn;
  LBytes: ptr to const uint8;
  LDone: int64;
  LCount: int64;
  LGot: int32;
begin
  LFound := DoReal(GRealWrite, ptr to const char("_write"));
  if LFound = nil then
    AState := IOState.Error;
    return 0;
  end;
  LWrite := FdWriteFn(LFound);
  LBytes := ptr to const uint8(ABuffer);
  LDone := 0;
  while LDone < ASize do
    LCount := ASize - LDone;
    if LCount > ADAM_HOOKIO_LOW_WRITE_MAX then
      LCount := ADAM_HOOKIO_LOW_WRITE_MAX;
    end;
    LGot := LWrite(DoRealFileOf(AUserData), LBytes + LDone, uint32(LCount));
    if LGot < 0 then
      AState := IOState.Error;
      return LDone;
    end;
    if LGot = 0 then
      // A device that took nothing (ucrt's Ctrl-Z first byte on a character device): no
      // failure, and no more will land
      return LDone;
    end;
    LDone := LDone + int64(LGot);
  end;
  return LDone;
end;

func DoRealFileSeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
var
  LFound: ptr;
  LSeek: Lseeki64Fn;
  LWhence: int32;
begin
  LWhence := ADAM_HOOKIO_SEEK_SET;
  if AOrigin = SeekOrigin.FromCurrent then
    LWhence := ADAM_HOOKIO_SEEK_CUR;
  end;
  if AOrigin = SeekOrigin.FromEnd then
    LWhence := ADAM_HOOKIO_SEEK_END;
  end;
  LFound := DoReal(GRealLseeki64, ptr to const char("_lseeki64"));
  if LFound = nil then
    return -1;
  end;
  LSeek := Lseeki64Fn(LFound);
  return LSeek(DoRealFileOf(AUserData), AOffset, LWhence);
end;

func DoRealFileTell(const AUserData: ptr): int64;
begin
  return DoRealFileSeek(AUserData, 0, SeekOrigin.FromCurrent);
end;

// A regular file's st_size, -1 for anything else (a pipe, a device) or a failed fstat (errno
// as it was: a size query is no call of the user's)
func DoRealFileSize(const AUserData: ptr): int64;
var
  LFound: ptr;
  LFstat: FstatFn;
  LStat: System.Windows._stat64;
  LError: int32;
  LGot: int32;
begin
  LError := CErrno();
  LFound := HookReal(GRealFstat64, ptr to const char("_fstat64"));
  if LFound = nil then
    return -1;
  end;
  LFstat := FstatFn(LFound);
  LGot := LFstat(DoRealFileOf(AUserData), ptr(addr of LStat));
  SetCErrno(LError);
  if (LGot <> 0) or ((LStat.st_mode & _S_IFMT) <> _S_IFREG) then
    return -1;
  end;
  return LStat.st_size;
end;

// The file cut or grown to ASize bytes by ucrt's _chsize_s (its errno set when it refuses)
func DoRealFileTruncate(const AUserData: ptr; const ASize: int64; var AState: IOState): bool;
var
  LFound: ptr;
  LChsize: ChsizeSFn;
begin
  LFound := DoReal(GRealChsizeS, ptr to const char("_chsize_s"));
  if LFound = nil then
    AState := IOState.Error;
    return false;
  end;
  LChsize := ChsizeSFn(LFound);
  if LChsize(DoRealFileOf(AUserData), ASize) <> 0 then
    AState := IOState.Error;
    return false;
  end;
  return true;
end;

// The duplicate closed with the description (errno as it was)
func DoRealFileClose(const AUserData: ptr): bool;
var
  LFound: ptr;
  LClose: FdIntFn;
  LError: int32;
  LOk: bool;
begin
  LError := CErrno();
  LOk := false;
  LFound := HookReal(GRealClose, ptr to const char("_close"));
  if LFound <> nil then
    LClose := FdIntFn(LFound);
    LOk := LClose(DoRealFileOf(AUserData)) = 0;
  end;
  SetCErrno(LError);
  return LOk;
end;

// The lowio text state of ucrt's _setmode answer AMode (the old mode of a number), as the
// number's own: _O_BINARY none; _O_TEXT ANSI; _O_U8TEXT UTF-8; _O_WTEXT / _O_U16TEXT UTF-16.
// _tm_unicode is set for a Unicode text mode, as the open that asked it sets it
func DoTextStateOf(const AMode: int32; var AState: HookLowState);
begin
  AState.Text := AMode <> _O_BINARY;
  AState.LowText := HookLowText.Ansi;
  if AMode = _O_U8TEXT then
    AState.LowText := HookLowText.Utf8;
  end;
  if (AMode = _O_WTEXT) or (AMode = _O_U16TEXT) then
    AState.LowText := HookLowText.Utf16;
  end;
  AState.WideText := AState.Text and (AState.LowText <> HookLowText.Ansi);
end;

// The open file description of descriptor ASource, a file ucrt opened itself, made one a
// handle's number runs on (_dup2 of ASource onto it): an internal Description handle (Real,
// never in the open list, closed with its last user) whose IO is RealFile (DoRealFile*), a
// duplicate ucrt's _dup makes of ASource (the same OS file object: its file pointer shared)
// set binary, so ucrt hands the bytes as they are and the number's text mode is the model's;
// Pipe when the file is no disk file (GetFileType: a pipe, a console), its place the OS
// file pointer; on its own stream lock, Users 1. AState: the lowio state _dup2 gives the
// number, ASource's text mode (_setmode's answer, DoTextStateOf), read and write rights (the
// OS handle refuses what it lacks, ucrt's EBADF), no append of the model's (a FAPPEND rides
// the duplicate: ucrt's _write goes to the end itself), no Ctrl-Z end or CRLF seen yet. nil
// with errno: ASource not open EBADF (ucrt's _dup ran the handler), no number left EMFILE,
// ENOMEM; nothing is left open then
func DoRealDescription(const ASource: int32; var AState: HookLowState): ptr to HookHandle;
var
  LDesc: ptr to HookHandle;
  LFound: ptr;
  LDup: FdIntFn;
  LSetmode: SetmodeFn;
  LOsfhandle: FdInt64Fn;
  LInterface: IOInterface;
  LStream: IO;
  LLock: ptr to HookStreamLock;
  LFile: int32;
  LOldMode: int32;
  LOs: int64;
  LPipe: bool;
  LAt: int64;
begin
  LFound := DoReal(GRealDup, ptr to const char("_dup"));
  if LFound = nil then
    return nil;
  end;
  LDup := FdIntFn(LFound);
  LFile := LDup(ASource);
  if LFile < 0 then
    return nil;
  end;
  LFound := DoReal(GRealSetmode, ptr to const char("_setmode"));
  LOldMode := -1;
  if LFound <> nil then
    LSetmode := SetmodeFn(LFound);
    LOldMode := LSetmode(LFile, _O_BINARY);
  end;
  LOs := -1;
  if LOldMode <> -1 then
    LFound := DoReal(GRealGetOsfhandle, ptr to const char("_get_osfhandle"));
    if LFound <> nil then
      LOsfhandle := FdInt64Fn(LFound);
      LOs := LOsfhandle(LFile);
    end;
  end;
  if (LOldMode = -1) or (LOs = -1) then
    DoCloseReserved(LFile);
    return nil;
  end;
  LPipe := GetFileType(uint64(LOs)) <> FILE_TYPE_DISK;
  LInterface.Read := DoRealFileRead;
  LInterface.Write := DoRealFileWrite;
  LInterface.Seek := DoRealFileSeek;
  LInterface.Tell := DoRealFileTell;
  LInterface.Size := DoRealFileSize;
  LInterface.Flush := nil;
  LInterface.Close := DoRealFileClose;
  LInterface.Truncate := DoRealFileTruncate;
  LStream := CreateIO(LInterface, ptr(uint64(int64(LFile))));
  LLock := HookIOOwnLock();
  create(LDesc);
  if (LStream = nil) or (LLock = nil) or (LDesc = nil) then
    // The IO's close closes the duplicate; without an IO it is closed here
    if LStream <> nil then
      IOClose(LStream);
    else
      DoCloseReserved(LFile);
    end;
    HookIOReleaseLock(LLock);
    if LDesc <> nil then
      destroy(LDesc);
    end;
    SetCErrno(ADAM_ERRNO_ENOMEM);
    return nil;
  end;
  LDesc->Users := 1;
  LDesc->Description := true;
  LDesc->Base.Stream := LStream;
  LDesc->Base.Owned := true;
  LDesc->Base.Lock := LLock;
  LDesc->Mode := FileMode.ReadWrite;
  LDesc->Pipe := LPipe;
  if not LPipe then
    LAt := IOTell(LStream);
    if LAt >= 0 then
      LDesc->Base.Position := LAt;
    end;
  end;
  LDesc->Descriptor := -1;
  LDesc->DescriptorOwned := false;
  LDesc->DescriptorClosed := false;
  LDesc->Real := true;
  LDesc->RealFile := LFile;
  AState.Mode := FileMode.ReadWrite;
  AState.Appending := false;
  DoTextStateOf(LOldMode, AState);
  AState.Pipe := LPipe;
  AState.LowEof := false;
  AState.LowCrlf := false;
  return LDesc;
end;

// True when number handle AHandle is held by a FILE: a FILE's own number (fileno's: not a
// lowio open's or a dup's), or a number an open _fdopen FILE rides (Low) (the caller holds
// AHandle's stream lock, which an _fdopen FILE shares)
func DoNumberHeld(const AHandle: ptr to HookHandle): bool;
var
  LI: int64;
begin
  if not AHandle->DescriptorOwned then
    return true;
  end;
  lock (GLock) do
    for LI := 0 to len(GHandles) - 1 do
      if (GHandles[LI]->Low = AHandle) and (not GHandles[LI]->Closed) then
        return true;
      end;
    end;
  end;
  return false;
end;

// Number handle AHandle's number taken out of GDescriptors without closing it (ucrt's _dup2
// put a real file there, which is ucrt's own from here): AHandle holds no number (the caller
// holds its stream lock)
func DoUnlistNumberLocked(const AHandle: ptr to HookHandle);
var
  LAt: int64;
  LCount: int64;
  LI: int64;
begin
  lock (GLock) do
    LAt := DoNumberAtLocked(AHandle->Descriptor);
    if LAt >= 0 then
      LCount := len(GDescriptors);
      LI := LAt;
      while LI < LCount - 1 do
        GDescriptors[LI] := GDescriptors[LI + 1];
        LI := LI + 1;
      end;
      setlength(GDescriptors, LCount - 1);
      atomicadd(GDescriptorCount, -1);
    end;
    AHandle->Descriptor := -1;
    AHandle->DescriptorOwned := false;
    AHandle->DescriptorClosed := false;
  end;
end;

// _dup2 of descriptor ASource that is no handle's (a file ucrt opened itself, or a number that
// is not open) onto ATarget when ATarget is a handle's number (dup2.cpp). False: ATarget is no
// handle's (ucrt's own). True: AResult 0, or -1 with ucrt's errno and nothing changed (a
// source that is not open EBADF, the handler run once; no number left for the description's
// duplicate EMFILE; ENOMEM). ucrt's _dup2 closes ATarget's reservation and puts ASource's file
// there: a number a FILE holds (DoNumberHeld) follows that file (DoFollowNumber onto
// DoRealDescription's description: a FILE's buffer kept, it and an _fdopen FILE riding the
// number read and write the real file from here, its file pointer shared with ASource); a
// lowio-only number (an open's or a dup's no FILE rides) is given back to ucrt: unlisted
// (DoUnlistNumberLocked) and its handle closed, the number ucrt's own real file from here. A
// success leaves errno as it was
func DoFdDup2Onto(const ASource: int32; const ATarget: int32; var AResult: int32): bool;
var
  LTarget: ptr to HookHandle;
  LDesc: ptr to HookHandle;
  LState: HookLowState;
  LFound: ptr;
  LReal: Dup2Fn;
  LPut: int32;
  LError: int32;
  LClosed: int32;
  LHeld: bool;
begin
  AResult := -1;
  LTarget := DoFindDescriptor(ATarget);
  if LTarget = nil then
    return false;
  end;
  LError := CErrno();
  // Made before ucrt's _dup2 so a failure leaves the number as it was (a source that is not
  // open fails here, ucrt's handler run by its _dup)
  LDesc := DoRealDescription(ASource, LState);
  if LDesc = nil then
    DoReleaseHandle(LTarget);
    return true;
  end;
  LPut := -1;
  LHeld := false;
  lock (LTarget->Base.Lock->Lock) do
    DoJoinLocked(LTarget);
    defer DoPartLocked(LTarget);
    LHeld := DoNumberHeld(LTarget);
    LFound := DoReal(GRealDup2, ptr to const char("_dup2"));
    if LFound <> nil then
      LReal := Dup2Fn(LFound);
      LPut := LReal(ASource, ATarget);
    end;
    if (LPut = 0) and (not LHeld) then
      DoUnlistNumberLocked(LTarget);
    end;
  end;
  if (LPut = 0) and LHeld then
    // The description's one user is the number's from here
    DoFollowNumber(LTarget, LDesc, LState);
  else
    DoReleaseHandle(LDesc);
  end;
  if LPut = 0 then
    if not LHeld then
      // The open list's handle (a lowio open's or a dup's); a close that raced this one took
      // it first
      DoClose(ptr(LTarget), LClosed);
    end;
    AResult := 0;
    SetCErrno(LError);
  end;
  DoReleaseHandle(LTarget);
  return true;
end;

// _dup2 of descriptor ASource onto ATarget when ASource is a handle's (dup2.cpp). False:
// ASource is no handle's (ucrt's own, or DoFdDup2Onto's when ATarget is a handle's). True:
// AResult 0, or -1 with errno: a closed source EBADF, then a target outside [0, _NHANDLE_)
// EBADF (ucrt's parameter checks in that order, the handler run); the same number 0 with
// nothing done. A target that is a handle's number follows the source (DoFollowNumber: its own
// IO closed, a FILE holding it reads and writes the source's file from here); any other
// target gets a reservation put on it by ucrt's own _dup2 (which closes a real file open there,
// and gives a number past the table EMFILE / ucrt's errno), then the source's lowio state
// (DoNewNumberLocked). A success leaves errno as it was
func DoFdDup2(const ASource: int32; const ATarget: int32; var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
  LTarget: ptr to HookHandle;
  LDesc: ptr to HookHandle;
  LState: HookLowState;
  LFound: ptr;
  LReal: Dup2Fn;
  LReserve: int32;
  LPut: int32;
  LError: int32;
  LFollow: bool;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(ASource);
  if LHandle = nil then
    return false;
  end;
  LError := CErrno();
  LTarget := nil;
  if ATarget <> ASource then
    LTarget := DoFindDescriptor(ATarget);
  end;
  LFollow := false;
  LDesc := nil;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    // ucrt's FOPEN check on the source first (EBADF, the handler run)
    if not DoFdGone(LHandle) then
      if (ATarget < 0) or (ATarget >= _NHANDLE_) then
        DoInvalidParameter(ADAM_ERRNO_EBADF);
      else
        if ATarget = ASource then
          AResult := 0;
        else
          if LTarget <> nil then
            // The target follows outside this lock (its own may differ): the description held
            // for it here
            LDesc := DoShareDescriptionLocked(LHandle);
            if LDesc <> nil then
              lock (GLock) do
                LDesc->Users := LDesc->Users + 1;
              end;
              LState := DoTakeLowState(LHandle);
              LFollow := true;
            end;
          else
            LReserve := DoReserveDescriptor();
            if LReserve >= 0 then
              // The reservation may itself be the free target (ucrt hands out the lowest)
              LPut := 0;
              if LReserve <> ATarget then
                LFound := DoReal(GRealDup2, ptr to const char("_dup2"));
                LPut := -1;
                if LFound <> nil then
                  LReal := Dup2Fn(LFound);
                  LPut := LReal(LReserve, ATarget);
                end;
                DoCloseReserved(LReserve);
              end;
              if LPut = 0 then
                // _dup2 answers 0, not the number
                AResult := DoNewNumberLocked(LHandle, ATarget);
                if AResult < 0 then
                  DoCloseReserved(ATarget);
                else
                  AResult := 0;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
  if LFollow then
    DoFollowNumber(LTarget, LDesc, LState);
    AResult := 0;
  end;
  if AResult = 0 then
    SetCErrno(LError);
  end;
  if LTarget <> nil then
    DoReleaseHandle(LTarget);
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// _fdopen / _wfdopen (AMode UTF-8) of descriptor AFile when it is a handle's (fdopen.cpp).
// False: not a handle's. True: AResult a new FILE on that number (Low: its lowio state and
// file pointer are the number's, so a _setmode of its _fileno changes it; fclose closes the
// number), or nil with errno: a closed number EBADF, a mode ucrt's parse refuses EINVAL (the
// handler run for both), ENOMEM. The FILE's stream flags are the mode's (r _IOREAD, w / a _IOWRITE,
// + _IOUPDATE); its rights and text mode stay the number's
func DoFdFdopen(const AFile: int32; const AMode: string; var AResult: ptr): bool;
var
  LHandle: ptr to HookHandle;
  LFile: ptr to HookHandle;
  LPlace: ptr to HookHandle;
  LParsed: HookOpenMode;
  LError: int32;
begin
  AResult := nil;
  LHandle := DoFindDescriptor(AFile);
  if LHandle = nil then
    return false;
  end;
  LError := CErrno();
  LFile := nil;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    if not DoFdGone(LHandle) then
      if not DoParseMode(AMode, LParsed) then
        DoInvalidParameter(ADAM_ERRNO_EINVAL);
      else
        create(LFile);
        if LFile = nil then
          SetCErrno(ADAM_ERRNO_ENOMEM);
        else
          LPlace := DoPlaceOf(LHandle);
          LFile->Users := 1;
          LFile->Base := LHandle->Base;
          LFile->Base.Stream := LPlace->Base.Stream;
          LFile->Base.Position := LPlace->Base.Position;
          LFile->Base.Owned := false;
          LFile->Base.Source := nil;
          LFile->Base.OwnedSource := nil;
          LFile->Base.Temporary := false;
          LFile->Low := LHandle;
          LFile->Descriptor := AFile;
          LFile->DescriptorOwned := false;
          LFile->DescriptorClosed := false;
          LFile->Mode := LHandle->Mode;
          LFile->Crt.StreamUpdate := LParsed.Mode = FileMode.ReadWrite;
          LFile->Crt.StreamRead := LParsed.Mode = FileMode.Read;
          LFile->Crt.StreamWrite := (LParsed.Mode = FileMode.Write) or
            (LParsed.Mode = FileMode.Append);
          lock (GLock) do
            LFile->Base.Lock->Users := LFile->Base.Lock->Users + 1;
            LHandle->Users := LHandle->Users + 1;
          end;
        end;
      end;
    end;
  end;
  if LFile <> nil then
    DoAddHandle(LFile);
    SetCErrno(LError);
    AResult := ptr(LFile);
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// The fopen mode of a lowio open's flags (DoFdOpen): ABase ("r", "r+", "w", "w+", "a", "a+"),
// then 'b' or 't' (_O_BINARY wins; then _O_TEXT, _O_WTEXT, _O_U16TEXT or _O_U8TEXT; else
// _get_fmode's default), 'D' for _O_TEMPORARY, and the ccs= part of the Unicode flag (in
// ucrt's order: _O_WTEXT UNICODE, _O_U16TEXT UTF-16LE, _O_U8TEXT UTF-8; a binary open keeps it,
// as ucrt's keeps _tm_unicode)
func DoFdMode(const ABase: string; const AFlags: int32): string;
var
  LMode: string;
  LText: bool;
begin
  LMode := ABase;
  if (AFlags & _O_BINARY) <> 0 then
    LText := false;
  else
    if (AFlags & (_O_TEXT | _O_WTEXT | _O_U16TEXT | _O_U8TEXT)) <> 0 then
      LText := true;
    else
      LText := DoDefaultText();
    end;
  end;
  if LText then
    LMode := LMode + "t";
  else
    LMode := LMode + "b";
  end;
  if (AFlags & _O_TEMPORARY) <> 0 then
    LMode := LMode + "D";
  end;
  if (AFlags & _O_WTEXT) <> 0 then
    LMode := LMode + ", ccs=UNICODE";
  else
    if (AFlags & _O_U16TEXT) <> 0 then
      LMode := LMode + ", ccs=UTF-16LE";
    else
      if (AFlags & _O_U8TEXT) <> 0 then
        LMode := LMode + ", ccs=UTF-8";
      end;
    end;
  end;
  return LMode;
end;

// A hooked lowio open of APath (UTF-8) with AFlags and AShare. False: neither a virtual path
// nor one the path source holds (HookIOQuery), the caller passes it to ucrt with errno as it
// came. True: AResult the new descriptor (a handle opened as fopen opens the path,
// DescriptorOwned), or -1 with errno. The flags are read as ucrt's _sopen reads them
// (open.cpp): an access mode past _O_RDWR and a sharing mode that is none of _SH_* are its
// failed parameter checks (EINVAL, the handler run); then CreateFile's dispositions: missing
// without _O_CREAT ENOENT; _O_CREAT | _O_EXCL on one that exists EEXIST; _O_TRUNC without
// _O_CREAT on a read-only open EINVAL (TRUNCATE_EXISTING needs write rights). The open is the
// fopen mode of the same effect (DoFdMode over "w" / "w+" for one that creates or empties,
// "a" / "a+" for one that makes or keeps the bytes with _O_APPEND, else "r" / "r+"); the
// descriptor's rights are then the access
// mode's and _O_APPEND's (DoOpenTextAs: a read-only one that creates or empties reads only,
// and a text open drops a trailing Ctrl-Z only with _O_RDWR). The handle's own refusals are
// fopen's (EACCES: a mode the IO or source does not offer). Every other flag (_O_NOINHERIT,
// _O_SEQUENTIAL, _O_RANDOM, _O_SHORT_LIVED, _O_OBTAIN_DIR) and the sharing mode's denials
// change nothing on a virtual file
func DoFdOpen(const APath: string; const AFlags: int32; const AShare: int32;
  var AResult: int32): bool;
var
  LQuery: HookQuery;
  LAccess: int32;
  LBase: string;
  LFile: ptr;
  LHandle: ptr to HookHandle;
  LCallerErrno: int32;
  LError: int32;
  LClosed: int32;
  LEmpties: bool;
begin
  AResult := -1;
  LCallerErrno := CErrno();
  if not HookIOQuery(APath, LQuery) then
    return false;
  end;
  SetCErrno(LCallerErrno);
  LAccess := AFlags & _O_ACCMODE;
  if LAccess = _O_ACCMODE then
    DoInvalidParameter(ADAM_ERRNO_EINVAL);
    return true;
  end;
  if (AShare <> _SH_DENYRW) and (AShare <> _SH_DENYWR) and (AShare <> _SH_DENYRD) and
    (AShare <> _SH_DENYNO) and (AShare <> _SH_SECURE) then
    DoInvalidParameter(ADAM_ERRNO_EINVAL);
    return true;
  end;
  if LQuery.Found then
    if ((AFlags & _O_CREAT) <> 0) and ((AFlags & _O_EXCL) <> 0) then
      SetCErrno(ADAM_ERRNO_EEXIST);
      return true;
    end;
    if ((AFlags & _O_TRUNC) <> 0) and ((AFlags & _O_CREAT) = 0) and (LAccess = _O_RDONLY) then
      SetCErrno(ADAM_ERRNO_EINVAL);
      return true;
    end;
  else
    if (AFlags & _O_CREAT) = 0 then
      SetCErrno(ADAM_ERRNO_ENOENT);
      return true;
    end;
  end;
  // The fopen mode of the same effect on the bytes: emptied ("w" / "w+"), made with _O_APPEND
  // ("a" / "a+"), or kept ("r" read-only, "a" / "a+" with _O_APPEND, else "r+")
  LEmpties := (not LQuery.Found) or ((AFlags & _O_TRUNC) <> 0);
  if LEmpties and (((AFlags & _O_APPEND) = 0) or ((AFlags & _O_TRUNC) <> 0)) then
    LBase := "w+";
    if LAccess = _O_WRONLY then
      LBase := "w";
    end;
  else
    if LEmpties or (((AFlags & _O_APPEND) <> 0) and (LAccess <> _O_RDONLY)) then
      LBase := "a+";
      if LAccess = _O_WRONLY then
        LBase := "a";
      end;
    else
      LBase := "r+";
      if LAccess = _O_RDONLY then
        LBase := "r";
      end;
    end;
  end;
  LFile := nil;
  if not DoOpenTextAs(APath, DoFdMode(LBase, AFlags), LAccess, (AFlags & _O_APPEND) <> 0,
    LFile) then
    SetCErrno(ADAM_ERRNO_ENOENT);
    return true;
  end;
  if LFile = nil then
    return true;
  end;
  LHandle := DoFindHandle(LFile);
  if LHandle = nil then
    SetCErrno(ADAM_ERRNO_EBADF);
    return true;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoJoinLocked(LHandle);
    defer DoPartLocked(LHandle);
    AResult := DoDescriptorLocked(LHandle);
    if AResult >= 0 then
      LHandle->DescriptorOwned := true;
    end;
  end;
  DoReleaseHandle(LHandle);
  if AResult < 0 then
    LError := CErrno();
    DoClose(LFile, LClosed);
    SetCErrno(LError);
    return true;
  end;
  SetCErrno(LCallerErrno);
  return true;
end;

// A UTF-16 path as a lowio hook takes it, as _wfopen reads a wide path (DoOpenWide): 0 when it
// is ucrt's (its ASCII prefix is not virtual and no path source is active, or it cannot be
// narrowed for the source), 1 when it is HookIO's (AText its UTF-8), 2 when it is virtual but
// cannot be narrowed (ENOENT)
func DoFdWidePath(const APath: ptr to const wchar; var AText: string): int32;
begin
  if APath = nil then
    return 0;
  end;
  if not HookIOIsVirtual(DoAsciiPrefix(APath)) then
    if (not HookIOPathSourceActive()) or (not DoNarrow(APath, AText)) then
      return 0;
    end;
    return 1;
  end;
  if not DoNarrow(APath, AText) then
    return 2;
  end;
  return 1;
end;

// DoFdOpen of the NUL-terminated UTF-16 path APath (DoFdWidePath)
func DoFdOpenWide(const APath: ptr to const wchar; const AFlags: int32; const AShare: int32;
  var AResult: int32): bool;
var
  LPath: string;
  LKind: int32;
begin
  AResult := -1;
  LKind := DoFdWidePath(APath, LPath);
  if LKind = 0 then
    return false;
  end;
  if LKind = 2 then
    SetCErrno(ADAM_ERRNO_ENOENT);
    return true;
  end;
  return DoFdOpen(LPath, AFlags, AShare, AResult);
end;

// True when APath (UTF-8) is HookIO's to open: virtual, or one the path source holds
// (HookIOResolve, as DoOpenText decides); errno as it was
func DoFdOurs(const APath: string): bool;
var
  LId: uint64;
  LRest: string;
  LCallerErrno: int32;
  LOurs: bool;
begin
  LCallerErrno := CErrno();
  LOurs := HookIOResolve(APath, LId, LRest);
  SetCErrno(LCallerErrno);
  return LOurs;
end;

// _sopen_s / _wsopen_s on a path that is HookIO's (APath, UTF-8; AUnnarrowed: a virtual wide
// path that cannot be narrowed, ENOENT): AFile set to -1 first, pmode checked (only _S_IREAD
// and _S_IWRITE may be set: else ucrt's failed parameter check, EINVAL, the handler), then
// DoFdOpen. The answer an errno, 0 on success (AFile the descriptor)
func DoFdOpenSecure(const AFile: ptr to int32; const APath: string; const AUnnarrowed: bool;
  const AFlags: int32; const AShare: int32; const APMode: int32): int32;
var
  LResult: int32;
begin
  AFile^ := -1;
  if (APMode & (~(int32(_S_IREAD) | int32(_S_IWRITE)))) <> 0 then
    DoInvalidParameter(ADAM_ERRNO_EINVAL);
    return ADAM_ERRNO_EINVAL;
  end;
  if AUnnarrowed then
    SetCErrno(ADAM_ERRNO_ENOENT);
    return ADAM_ERRNO_ENOENT;
  end;
  if (not DoFdOpen(APath, AFlags, AShare, LResult)) or (LResult < 0) then
    if CErrno() = 0 then
      SetCErrno(ADAM_ERRNO_ENOENT);
    end;
    return CErrno();
  end;
  AFile^ := LResult;
  return 0;
end;

// The lowio hooks: a virtual path's open, and a handle's descriptor, run here; any other path
// or number is ucrt's (the real function, found once; ENOSYS when the C runtime lacks it).
// mingw's oldnames (open, read, write, close, lseek, lseek64, tell, eof, filelength, sopen,
// creat, fstat ..) are libcextras aliases of these imports, so they reach these hooks too

// _open: the mode (pmode) is read only with _O_CREAT, as ucrt reads its variadic argument
public func _open(const APath: ptr to const char; const AFlags: int32; ...): int32;
var
  LResult: int32;
  LMode: int32;
  LFound: ptr;
  LReal: OpenFn;
begin
  LMode := 0;
  if (AFlags & _O_CREAT) <> 0 then
    LMode := varargs.next(int32);
  end;
  if (APath <> nil) and DoFdOpen(StringFromC(APath), AFlags, _SH_DENYNO, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealOpen, ptr to const char("_open"));
  if LFound = nil then
    return -1;
  end;
  LReal := OpenFn(LFound);
  return LReal(APath, AFlags, LMode);
end;

// _wopen: _open of a UTF-16 path
public func _wopen(const APath: ptr to const wchar; const AFlags: int32; ...): int32;
var
  LResult: int32;
  LMode: int32;
  LFound: ptr;
  LReal: WopenFn;
begin
  LMode := 0;
  if (AFlags & _O_CREAT) <> 0 then
    LMode := varargs.next(int32);
  end;
  if DoFdOpenWide(APath, AFlags, _SH_DENYNO, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealWopen, ptr to const char("_wopen"));
  if LFound = nil then
    return -1;
  end;
  LReal := WopenFn(LFound);
  return LReal(APath, AFlags, LMode);
end;

// _sopen: _open with a sharing mode
public func _sopen(const APath: ptr to const char; const AFlags: int32; const AShare: int32;
  ...): int32;
var
  LResult: int32;
  LMode: int32;
  LFound: ptr;
  LReal: SopenFn;
begin
  LMode := 0;
  if (AFlags & _O_CREAT) <> 0 then
    LMode := varargs.next(int32);
  end;
  if (APath <> nil) and DoFdOpen(StringFromC(APath), AFlags, AShare, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealSopen, ptr to const char("_sopen"));
  if LFound = nil then
    return -1;
  end;
  LReal := SopenFn(LFound);
  return LReal(APath, AFlags, AShare, LMode);
end;

// _wsopen: _sopen of a UTF-16 path
public func _wsopen(const APath: ptr to const wchar; const AFlags: int32;
  const AShare: int32; ...): int32;
var
  LResult: int32;
  LMode: int32;
  LFound: ptr;
  LReal: WsopenFn;
begin
  LMode := 0;
  if (AFlags & _O_CREAT) <> 0 then
    LMode := varargs.next(int32);
  end;
  if DoFdOpenWide(APath, AFlags, AShare, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealWsopen, ptr to const char("_wsopen"));
