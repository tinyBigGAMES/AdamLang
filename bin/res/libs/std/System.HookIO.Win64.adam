// _lseek: a handle's descriptor moves (DoFdSeek, a long's place)
public func _lseek(const AFile: int32; const AOffset: clong; const AOrigin: int32): clong;
var
  LResult: int64;
  LFound: ptr;
  LReal: LseekFn;
begin
  if DoFdSeek(AFile, int64(AOffset), AOrigin, true, LResult) then
    return clong(LResult);
  end;
  LFound := DoReal(GRealLseek, ptr to const char("_lseek"));
  if LFound = nil then
    return -1;
  end;
  LReal := LseekFn(LFound);
  return LReal(AFile, AOffset, AOrigin);
end;

// _lseeki64: a handle's descriptor moves (DoFdSeek)
public func _lseeki64(const AFile: int32; const AOffset: int64; const AOrigin: int32): int64;
var
  LResult: int64;
  LFound: ptr;
  LReal: Lseeki64Fn;
begin
  if DoFdSeek(AFile, AOffset, AOrigin, false, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealLseeki64, ptr to const char("_lseeki64"));
  if LFound = nil then
    return -1;
  end;
  LReal := Lseeki64Fn(LFound);
  return LReal(AFile, AOffset, AOrigin);
end;

// _tell: ucrt's _lseek(AFile, 0, SEEK_CUR)
public func _tell(const AFile: int32): clong;
var
  LResult: int64;
  LFound: ptr;
  LReal: FdLongFn;
begin
  if DoFdSeek(AFile, 0, ADAM_HOOKIO_SEEK_CUR, true, LResult) then
    return clong(LResult);
  end;
  LFound := DoReal(GRealTell, ptr to const char("_tell"));
  if LFound = nil then
    return -1;
  end;
  LReal := FdLongFn(LFound);
  return LReal(AFile);
end;

