// _pclose: a handle is never a pipe; ucrt's _pclose refuses a stream _popen did not open with
// -1 and EBADF and leaves it open, and so does this hook on a handle
public func _pclose(const AFile: ptr): int32;
var
  LFound: ptr;
  LReal: FileIntFn;
begin
  if DoOwns(AFile) then
    SetCErrno(ADAM_ERRNO_EBADF);
    return -1;
  end;
  LFound := HookReal(GRealPclose, ptr to const char("_pclose"));
  if LFound = nil then
    SetCErrno(ADAM_ERRNO_ENOSYS);
    return -1;
  end;
  LReal := FileIntFn(LFound);
  return LReal(AFile);
end;

