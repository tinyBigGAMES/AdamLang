-------------------------------------------------------------------------------
  System.HookAbi.adam - link-time hooks of C functions (PaskalCPP's HookABI)

  A hook is a public routine with the hooked C function's name and C
  signature (a plain routine has C linkage; public gives it its plain C
  name), written anywhere in the program:

    public routine fopen(const APath: ptr to const char;
      const AMode: ptr to const char): ptr;

  Its definition is in the final link, so it binds every reference to that
  name in the link: the program's own calls and the calls inside the static
  C libraries linked into it, their import slots included (`__imp_fopen`
  on x86_64-windows-gnu: Adam's linker makes such a slot the definition's
  own and loads no library member for it). No line beside the hook is
  needed. Code outside the final link (a DLL, the C runtime's own calls) is
  not hooked.

  Inside the hook, HookReal finds the real function (the definition the
  hook stands in for) once, into a slot the hook keeps (a module variable,
  nil at the start), and the hook calls it through its own routine type.

  HookReal(ASlot, AName) looks AName up in the C runtime (System.Runtime's
  FindCRuntimeFunction; x86_64-windows-gnu: ucrtbase.dll's export of that
  name, looked up there only). A MinGW name the C runtime exports under
  another (fseeko64 is ucrtbase's _fseeki64) is looked up by the export's
  name. HookReal(ASlot, ALibrary, AName) looks AName up in the library
  ALibrary (its UTF-8 file name) when the process has it loaded; it never
  loads one (System.Runtime's FindLoadedFunction).

  The slot is written when a lookup finds the function; while it is nil
  every call looks again. Two threads in their first call both look up the
  same function and store the same address (one aligned 8-byte store), so
  the slot never holds anything else.
*******************************************************************************/

module unit System.HookAbi;

import System.Runtime;

// The C runtime's function AName (NUL-terminated), looked up the first time into ASlot (the
// hook's own pointer, nil until then); nil while the C runtime has no function of that name
public routine HookReal(var ASlot: ptr; const AName: ptr to const char): ptr;
begin
  if ASlot = nil then
    ASlot := FindCRuntimeFunction(AName);
  end;
  return ASlot;
end;

// The function AName (NUL-terminated) of the library ALibrary (its NUL-terminated UTF-8 file
// name, "kernel32.dll"), looked up the first time into ASlot (nil until then) when the
// process has the library loaded (it is never loaded here); nil while it is not loaded or
// has no function of that name
public routine HookReal(var ASlot: ptr; const ALibrary: ptr to const char;
  const AName: ptr to const char): ptr;
begin
  if ASlot = nil then
    ASlot := FindLoadedFunction(ALibrary, AName);
  end;
  return ASlot;
end;

end.
