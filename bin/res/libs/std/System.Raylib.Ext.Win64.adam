  System.Raylib.Ext.Win64.adam - System.Raylib.Ext's platform unit for
  x86_64-windows-gnu: what the frame window and the program icon need from
  Windows (the target triple picks it; System.Raylib.Ext.Linux64 has the same
  names).

  The icon: GLFW makes raylib's window with user32's CreateWindowExW. The
  hook here (System.HookAbi: the public routine of that name binds raylib's
  import slot) calls the real one, then a top-level window gets the icon
  @exeicon stamps (the RT_GROUP_ICON MAINICON, big and small) with
  WM_SETICON. A program's own SetWindowIcon later wins; no icon stamped:
  the platform's default.
  The shell asks a new window for its taskbar icon as it appears; a program
  busy right then (loading before its first frame) answers too late, and the
  taskbar keeps the generic icon for good. So the first seconds of the
  window the taskbar shows (the first made WS_EX_APPWINDOW: raylib's, not
  GLFW's hidden helper) are watched (ADAM_RAYLIB_ICON_WATCH_MS): a timer
  ticks while the program reads
  its messages, and a tick that comes after a gap (ADAM_RAYLIB_ICON_STALL_MS:
  the program did not read them) stamps the icon again with fresh handles.
  Only a real change makes the shell look again; the same handles do
  nothing. The icons are the window's own copies at the system's sizes,
  destroyed with it; a window holding an icon the program set is left alone.

  The frame's close: GLFW destroys its window with user32's DestroyWindow
  (raylib's CloseWindow). The hook tells System.Raylib.Ext (the notice it set
  with RaylibPlatformSetWindowGone) which window goes, then calls the real
  one.

  The DPI: the window's own (GetDpiForWindow, per monitor; GLFW makes the
  process per-monitor aware), else the system's (GetDpiForSystem); both
  looked up in the loaded user32 (Windows 10 1607+), never imported; 0
  when neither answers. Asked each frame (a cheap call).

  Handles are passed as raylib's GetWindowHandle gives them, so the unit
  needs nothing of raylib's.
*******************************************************************************/

module unit System.Raylib.Ext.Win64;

import System.HookAbi, System.Windows;

public type
  // The notice System.Raylib.Ext takes of a native window going (its HWND, as a number)
  RaylibWindowGoneFn = func(const AWindow: uint64);

public const
  // How often the frame asks the DPI again, in seconds: each frame
  ADAM_RAYLIB_DPI_CHECK_SECONDS: float64 = 0.0;

const
  // The icon group @exeicon stamps (Adam.Coff.Resources' ADAM_RESOURCE_ICON_GROUP_NAME), as
  // a NUL-terminated UTF-16 name for LoadIconW
  ADAM_RAYLIB_ICON_NAME: array[0..8] of uint16 = [77, 65, 73, 78, 73, 67, 79, 78, 0];
  // The icon watch: how long after its creation the window is watched, the gap between two
  // ticks that means the program stalled, the tick, and the timer's id ("ADMI")
  ADAM_RAYLIB_ICON_WATCH_MS: uint64 = 5000;
  ADAM_RAYLIB_ICON_STALL_MS: uint64 = 400;
  ADAM_RAYLIB_ICON_TICK_MS: uint32 = 100;
  ADAM_RAYLIB_ICON_TIMER: uint64 = 0x41444D49;

type
  // The real functions, called through HookReal's slots (user32's own signatures)
  CreateWindowExWFn = func(AExStyle: uint32; AClassName: ptr to const uint16;
    AWindowName: ptr to const uint16; AStyle: uint32; AX: int32; AY: int32; AWidth: int32;
    AHeight: int32; AParent: ptr; AMenu: ptr; AInstance: ptr; AParam: ptr): ptr;
  DestroyWindowFn = func(AWindow: ptr): int32;
  GetDpiForWindowFn = func(AWindow: ptr): uint32;
  GetDpiForSystemFn = func(): uint32;

var
  // HookReal's slots
  GRealCreateWindowEx: ptr;
  GRealDestroyWindow: ptr;
  GRealGetDpiForWindow: ptr;
  GRealGetDpiForSystem: ptr;
  // The notice RaylibPlatformSetWindowGone set (nil: none)
  GWindowGone: RaylibWindowGoneFn;
  // The watched window (0: none), when it was made and when its timer last ticked
  // (GetTickCount64), and the icons it holds (its own copies: 0 when none)
  GIconWindow: uint64;
  GIconBorn: uint64;
  GIconLastTick: uint64;
  GIconBig: uint64;
  GIconSmall: uint64;

/// Sets the notice the DestroyWindow hook gives as a window goes (nil: none).
/// @param ANotice the routine told each native window's number as it is destroyed
public func cpplink RaylibPlatformSetWindowGone(const ANotice: RaylibWindowGoneFn);
begin
  GWindowGone := ANotice;
end;

/// raylib's window as Windows names it: its HWND as a number (0 for none).
/// @param AHandle raylib's GetWindowHandle()
public func cpplink RaylibPlatformNativeWindow(const AHandle: ptr): uint64;
begin
  return uint64(AHandle);
end;

/// The DPI the window AHandle is shown at (its monitor's), else the system's; 0 when
/// Windows answers neither.
/// @param AHandle raylib's GetWindowHandle() (nil: the system's DPI only)
public func cpplink RaylibPlatformQueryDpi(const AHandle: ptr): int32;
var
  LFound: ptr;
  LForWindow: GetDpiForWindowFn;
  LForSystem: GetDpiForSystemFn;
  LDpi: uint32;
begin
  LDpi := 0;
  LFound := HookReal(GRealGetDpiForWindow, ptr to const char("user32.dll"),
    ptr to const char("GetDpiForWindow"));
  if (LFound <> nil) and (AHandle <> nil) then
    LForWindow := GetDpiForWindowFn(LFound);
    LDpi := LForWindow(AHandle);
  end;
  if LDpi = 0 then
    LFound := HookReal(GRealGetDpiForSystem, ptr to const char("user32.dll"),
      ptr to const char("GetDpiForSystem"));
    if LFound <> nil then
      LForSystem := GetDpiForSystemFn(LFound);
      LDpi := LForSystem();
    end;
  end;
  return int32(LDpi);
end;

// The @exeicon group at one size, a copy of the window's own (LoadImageW without LR_SHARED:
// a new handle on every call, destroyed by DoIconRelease); 0 when the exe has none
func DoIconLoad(const AWidthMetric: int32; const AHeightMetric: int32): uint64;
var
  LIconName: array[0..8] of uint16;
begin
  // A constant has no address: LoadImageW reads a copy
  LIconName := ADAM_RAYLIB_ICON_NAME;
  return LoadImageW(GetModuleHandleW(nil), addr of LIconName[0], IMAGE_ICON,
    GetSystemMetrics(AWidthMetric), GetSystemMetrics(AHeightMetric), LR_DEFAULTCOLOR);
end;

// The watched window's icons stamped with fresh copies (big and small at the system's
// sizes), the copies it held before destroyed once it lets go of them. False when the exe
// has no icon (nothing changed).
func DoIconStamp(const AWindow: uint64): bool;
var
  LBig: uint64;
  LSmall: uint64;
begin
  LBig := DoIconLoad(SM_CXICON, SM_CYICON);
  LSmall := DoIconLoad(SM_CXSMICON, SM_CYSMICON);
  if (LBig = 0) or (LSmall = 0) then
    if LBig <> 0 then
      DestroyIcon(LBig);
    end;
    if LSmall <> 0 then
      DestroyIcon(LSmall);
    end;
    return false;
  end;
  SendMessageW(AWindow, WM_SETICON, ICON_BIG, int64(LBig));
  SendMessageW(AWindow, WM_SETICON, ICON_SMALL, int64(LSmall));
  if GIconBig <> 0 then
    DestroyIcon(GIconBig);
  end;
  if GIconSmall <> 0 then
    DestroyIcon(GIconSmall);
  end;
  GIconBig := LBig;
  GIconSmall := LSmall;
  return true;
end;

// The watch ended (its timer killed); with AGone the window is gone too and its icon copies
// are destroyed
func DoIconRelease(const AGone: bool);
begin
  if GIconWindow = 0 then
    return;
  end;
  KillTimer(GIconWindow, ADAM_RAYLIB_ICON_TIMER);
  if AGone then
    if GIconBig <> 0 then
      DestroyIcon(GIconBig);
    end;
    if GIconSmall <> 0 then
      DestroyIcon(GIconSmall);
    end;
    GIconBig := 0;
    GIconSmall := 0;
    GIconWindow := 0;
  end;
end;

// The watch's tick (SetTimer's callback, run by DispatchMessage): after a gap the program
// stalled, so its window may have answered the shell's icon question too late; a fresh
// stamp makes the shell take the icon again. A window that holds an icon of the program's
// own (SetWindowIcon) is left alone, and the watch ends with its time.
func clink DoIconTick(AWindow: uint64; AMsg: uint32; AIdEvent: uint64; ATime: uint32);
var
  LNow: uint64;
begin
  if AWindow <> GIconWindow then
    return;
  end;
  LNow := GetTickCount64();
  if uint64(SendMessageW(AWindow, WM_GETICON, ICON_BIG, 0)) <> GIconBig then
    // The program's own icon: never overwritten
    DoIconRelease(false);
    return;
  end;
  if LNow - GIconLastTick >= ADAM_RAYLIB_ICON_STALL_MS then
    DoIconStamp(AWindow);
  end;
  GIconLastTick := LNow;
  if LNow - GIconBorn >= ADAM_RAYLIB_ICON_WATCH_MS then
    DoIconRelease(false);
  end;
end;

// The hooks: user32's names (public: their plain C names, System.HookAbi)

// CreateWindowExW: the real one, then the program's icon on a top-level window
public func CreateWindowExW(AExStyle: uint32; AClassName: ptr to const uint16;
  AWindowName: ptr to const uint16; AStyle: uint32; AX: int32; AY: int32; AWidth: int32;
  AHeight: int32; AParent: ptr; AMenu: ptr; AInstance: ptr; AParam: ptr): ptr;
var
  LFound: ptr;
  LReal: CreateWindowExWFn;
  LWindow: ptr;
  LIcon: uint64;
  LIconName: array[0..8] of uint16;
begin
  LFound := HookReal(GRealCreateWindowEx, ptr to const char("user32.dll"),
    ptr to const char("CreateWindowExW"));
  if LFound = nil then
    return nil;
  end;
  LReal := CreateWindowExWFn(LFound);
  LWindow := LReal(AExStyle, AClassName, AWindowName, AStyle, AX, AY, AWidth, AHeight, AParent,
    AMenu, AInstance, AParam);
  if (LWindow <> nil) and (AParent = nil) and ((AStyle & WS_CHILD) = 0) then
    if (GIconWindow = 0) and ((AExStyle & WS_EX_APPWINDOW) <> 0) then
      // The first window the taskbar shows (GLFW makes raylib's with WS_EX_APPWINDOW; its
      // hidden helper window, made before it, has none): its own icon copies, and its first
      // seconds watched for a stall
      if DoIconStamp(uint64(LWindow)) then
        GIconWindow := uint64(LWindow);
        GIconBorn := GetTickCount64();
        GIconLastTick := GIconBorn;
        SetTimer(GIconWindow, ADAM_RAYLIB_ICON_TIMER, ADAM_RAYLIB_ICON_TICK_MS, DoIconTick);
      end;
    else
      // Another top-level window: the shared icon (LoadIconW), never destroyed
      // A constant has no address: LoadIconW reads a copy
      LIconName := ADAM_RAYLIB_ICON_NAME;
      LIcon := LoadIconW(GetModuleHandleW(nil), addr of LIconName[0]);
      if LIcon <> 0 then
        SendMessageW(uint64(LWindow), WM_SETICON, ICON_BIG, int64(LIcon));
        SendMessageW(uint64(LWindow), WM_SETICON, ICON_SMALL, int64(LIcon));
      end;
    end;
  end;
  return LWindow;
end;

// DestroyWindow: System.Raylib.Ext told the window goes, then the real one (BOOL: 0 when the
// real one is not found)
public func DestroyWindow(AWindow: ptr): int32;
var
  LFound: ptr;
  LReal: DestroyWindowFn;
  LDestroyed: int32;
begin
  if GWindowGone <> nil then
    GWindowGone(uint64(AWindow));
  end;
  LFound := HookReal(GRealDestroyWindow, ptr to const char("user32.dll"),
    ptr to const char("DestroyWindow"));
  if LFound = nil then
    return 0;
  end;
  LReal := DestroyWindowFn(LFound);
  LDestroyed := LReal(AWindow);
  // The watched window gone: its timer went with it, its icon copies are let go now
  if (uint64(AWindow) = GIconWindow) and (GIconWindow <> 0) then
    DoIconRelease(true);
  end;
  return LDestroyed;
end;

end.
