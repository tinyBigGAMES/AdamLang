  This file is covered by the Adam Runtime Exception
  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.JSON.Ext.adam - JSON documents in Adam, over yyjson's C API
  (System.JSON.C): StdApp.JSON's fluent surface. A JSON is a value: a view
  of one node of a document tree that every view of it shares (held by a
  ref, so the tree lives while any view does; a view costs no copy). A
  plain `LJ: JSON;` is an empty object, its tree made at its first change;
  a copy taken before that change is an empty object of its own.

  Build: Add puts a value into the open container: Add(key, value) into
  an object, Add(value) into an array, the value a string, an int32 /
  int64 / uint32 / uint64, a float64, a bool or a JSON; AddNull(key) /
  AddNull() a null; AddRaw a key's value from JSON text; AddStrings /
  AddIntegers / AddDoubles a key's array. BeginObject(key) / BeginArray(key) (keyed, in an object)
  and BeginObject() / BeginArray() (bare, in an array) open a nested
  container the next calls go into, EndObject / EndArray close it. Each
  returns the JSON it was called on, so calls chain; a call that does not
  fit the container (a keyed one in an array, a bare one in an object)
  changes nothing. The open containers are the tree's: a chain on a
  returned copy closes what it opened.

  Read: Get / Has by path, keys joined by '.', each bare or "quoted" (\"
  and \\ escaped), an item as [N] after a key or another item:
  `servers[0].ports[1]`, `"a.b".c`, `[2]`; the empty path is the value
  itself. A path that names nothing gives a missing value: IsNull, Count
  0, every As* its default. Count / Keys / Items (for .. in walks them) /
  First / Last / Contains (a string or a whole number), Pairs, the
  As* getters (As*() gives the kind's zero value when the value has none,
  As*(ADefault) the default given), the As*Array forms, the Is* tests,
  ForEach, Remove / Merge / Clone.

  Text and files: ToString / ToPrettyString (2 spaces, or the indent
  given), Parse / LoadFromFile / LoadFromIO (false with ErrorText:
  "file(line,col): message" for a text, "file: message (byte N)" for a
  file's, "file: the file cannot be opened" when it cannot), the static
  JSON.FromString / JSON.FromFile / JSON.FromIO (a missing value on a
  failure, its ErrorText set) and JSON.TryFromString (false on a failure),
  SaveToFile / SaveToIO (pretty, 2 spaces,
  unless APretty is false). The file forms go through yyjson's own C file
  calls (fopen / fread / fwrite), never System.IO: with System.HookIO
  imported, an io://<n>/<name> path (a registered IO, a .rez / zip entry)
  loads and saves as a disk file does. An IO is System.CustomIO's IO.
  Every yyjson block is Adam's heap (getmem / resizemem / freemem through
  one yyjson_alc), so a debug build's heap report covers it.
  Target-neutral: no OS named.
*******************************************************************************/

module unit System.JSON.Ext;

import System.SysUtils, System.IO, System.CustomIO, System.JSON.C;

const
  // The errors a failed read reports (after "file(line,col): " / "file: ")
  ADAM_JSON_MSG_NO_ROOM: string = "out of memory";
  ADAM_JSON_MSG_AT_BYTE: string = " (byte ";
  ADAM_JSON_MSG_IO_FAILED: string = "the IO cannot be read";
  // A file yyjson could not open or read: its own words for these name no cause
  ADAM_JSON_MSG_OPEN_FAILED: string = "the file cannot be opened";
  ADAM_JSON_MSG_READ_FAILED: string = "the file cannot be read";
  ADAM_JSON_MSG_NO_IO: string = "no IO";
  // The name errors carry for Parse's text and for an IO
  ADAM_JSON_TEXT_NAME: string = "<text>";
  ADAM_JSON_IO_NAME: string = "<io>";
  // The indent ToPrettyString uses when none is given (StdApp's), and yyjson's own
  ADAM_JSON_INDENT: int32 = 2;
  ADAM_JSON_YYJSON_INDENT: int64 = 4;
  // How every text is read and written: NaN / infinity, which JSON has no form for, written
  // as null so the text is always valid JSON
  ADAM_JSON_READ_FLAGS: yyjson_read_flag = YYJSON_READ_NOFLAG;
  ADAM_JSON_WRITE_FLAGS: yyjson_write_flag = YYJSON_WRITE_INF_AND_NAN_AS_NULL;
  // The integer limits the As* getters check against; a real's range for int64 (2^63)
  ADAM_JSON_INT32_MIN: int32 = -2147483648;
  ADAM_JSON_INT32_MAX: int32 = 2147483647;
  ADAM_JSON_UINT32_MAX: uint32 = 4294967295;
  ADAM_JSON_INT64_MAX: int64 = 9223372036854775807;
  ADAM_JSON_INT64_LOW: float64 = -9223372036854775808.0;
  ADAM_JSON_INT64_HIGH: float64 = 9223372036854775808.0;
  // The first character of an Adam path prefix ($P: $D: $S:): the one path form resolved
  ADAM_JSON_PATH_PREFIX: char = '$';

var
  // The allocator every yyjson call here is given: Adam's heap (initialize fills it)
  GAlc: yyjson_alc;

// yyjson's malloc / realloc / free on Adam's heap
func clink DoAlcMalloc(ACtx: ptr; ASize: uint64): ptr;
begin
  return getmem(int64(ASize));
end;

func clink DoAlcRealloc(ACtx: ptr; APointer: ptr; AOldSize: uint64; ASize: uint64): ptr;
begin
  return resizemem(APointer, int64(ASize));
end;

func clink DoAlcFree(ACtx: ptr; APointer: ptr);
begin
  if APointer <> nil then
    freemem(APointer);
  end;
end;

// AText's bytes for a C call that takes them with their count (no NUL needed); "" for none
func DoChars(const AText: string): ptr to const char;
begin
  if len(AText) = 0 then
    return "";
  end;
  return addr of AText[0];
end;

// The text of a JSON string value (or a key)
func DoStringOf(const AValue: ptr to yyjson_mut_val): string;
begin
  return StringFromC(yyjson_mut_get_str(AValue), int64(yyjson_mut_get_len(AValue)));
end;

// APath as the file a C call opens: an Adam path prefix ($P: $D: $S:) resolved, any other
// path as written (a HookIO io:// path, or a plain one a path source may hold by that name;
// the C call takes a relative one from the working folder)
func DoFilePath(const APath: string): string;
begin
  if (len(APath) > 0) and (APath[0] = ADAM_JSON_PATH_PREFIX) then
    return ResolvePath(APath);
  end;
  return APath;
end;

// AText written by yyjson with AIndent spaces a level (its own pretty form is 4): a line's
// leading spaces are only indentation (a JSON string holds no raw line break)
func DoReindent(const AText: string; const AIndent: int64): string;
var
  LText: string;
  LSize: int64;
  LAt: int64;
  LTo: int64;
  LSpaces: int64;
  LI: int64;
begin
  // First the size, then the bytes: one allocation
  LSize := 0;
  LAt := 0;
  while LAt < len(AText) do
    LSpaces := 0;
    while (LAt < len(AText)) and (AText[LAt] = ' ') do
      LSpaces := LSpaces + 1;
      LAt := LAt + 1;
    end;
    LSize := LSize + (LSpaces div ADAM_JSON_YYJSON_INDENT) * AIndent;
    while (LAt < len(AText)) and (AText[LAt] <> '\n') do
      LSize := LSize + 1;
      LAt := LAt + 1;
    end;
    if LAt < len(AText) then
      LSize := LSize + 1;
      LAt := LAt + 1;
    end;
  end;
  setlength(LText, LSize);
  LAt := 0;
  LTo := 0;
  while LAt < len(AText) do
    LSpaces := 0;
    while (LAt < len(AText)) and (AText[LAt] = ' ') do
      LSpaces := LSpaces + 1;
      LAt := LAt + 1;
    end;
    for LI := 1 to (LSpaces div ADAM_JSON_YYJSON_INDENT) * AIndent do
      LText[LTo] := ' ';
      LTo := LTo + 1;
    end;
    while (LAt < len(AText)) and (AText[LAt] <> '\n') do
      LText[LTo] := AText[LAt];
      LTo := LTo + 1;
      LAt := LAt + 1;
    end;
    if LAt < len(AText) then
      LText[LTo] := '\n';
      LTo := LTo + 1;
      LAt := LAt + 1;
    end;
  end;
  return LText;
end;

// AValue as JSON text in AFlags; "" when yyjson cannot write it (no room)
func DoWrite(const AValue: ptr to yyjson_mut_val; const AFlags: yyjson_write_flag): string;
var
  LText: ptr to char;
  LLength: uint64;
  LResult: string;
begin
  LLength := 0;
  LText := yyjson_mut_val_write_opts(AValue, AFlags | ADAM_JSON_WRITE_FLAGS, addr of GAlc,
    addr of LLength, nil);
  if LText = nil then
    return "";
  end;
  LResult := StringFromC(ptr to const char(LText), int64(LLength));
  freemem(ptr(LText));
  return LResult;
end;

// A read error of the text AText as "AName(line,col): message"
func DoTextError(const AName: string; const AText: string; const AError: yyjson_read_err): string;
var
  LLine: uint64;
  LCol: uint64;
  LChar: uint64;
begin
  LLine := 0;
  LCol := 0;
  LChar := 0;
  if not yyjson_locate_pos(DoChars(AText), uint64(len(AText)), AError.pos, addr of LLine,
    addr of LCol, addr of LChar) then
    return AName + ": " + StringFromC(AError.msg) + ADAM_JSON_MSG_AT_BYTE +
      UIntToStr(AError.pos) + ")";
  end;
  return AName + "(" + UIntToStr(LLine) + "," + UIntToStr(LCol) + "): " + StringFromC(AError.msg);
end;

// A read error of a file as "APath: message (byte N)"; one that opened or read nothing as
// "APath: the file cannot be opened / read"
func DoFileError(const APath: string; const AError: yyjson_read_err): string;
begin
  if AError.code = YYJSON_READ_ERROR_FILE_OPEN then
    return APath + ": " + ADAM_JSON_MSG_OPEN_FAILED;
  end;
  if AError.code = YYJSON_READ_ERROR_FILE_READ then
    return APath + ": " + ADAM_JSON_MSG_READ_FAILED;
  end;
  return APath + ": " + StringFromC(AError.msg) + ADAM_JSON_MSG_AT_BYTE + UIntToStr(AError.pos) + ")";
end;

type
  // One document's tree, shared by every JSON viewing it: yyjson's mutable document and
  // the containers BeginObject / BeginArray opened (Base: the node the first was opened
  // under; a view of another node adds to itself)
  JSONTree = object
    Doc: ptr to yyjson_mut_doc;
    Open: array of ptr to yyjson_mut_val;
    Depth: int64;
    Base: ptr to yyjson_mut_val;

    done;
    begin
      if self.Doc <> nil then
        yyjson_mut_doc_free(self.Doc);
      end;
    end;
  end;

public forward type JSON;
public forward type JSONPair;

public type
  /// ForEach's callback: each item of an array or value of an object, and the pointer given.
  JSONCallback = func(const AItem: JSON; const AUserData: ptr);

  /// A JSON value: a view of one node of a document tree every view of it shares (no copy). A plain
  /// `LJ: JSON;` is an empty object, its tree made at its first change.
  /// @example `LJ.Add("name", "Ada").Add("age", 36); println(LJ.ToString());`
  JSON = object
    // The tree (nil: a fresh empty object, made at its first change, or a missing value)
    hidden Tree: ref JSONTree;
    // The node viewed (nil while Tree is)
    hidden Node: ptr to yyjson_mut_val;
    // A path or a read that named nothing
    hidden Missing: bool;
    // Why the last Parse / LoadFromFile / LoadFromIO failed ("" after a success)
    hidden Error: string;

    // A fresh value gets its tree: an empty object as the root; false for a missing value
    // (nothing changes it) or when there is no room
    hidden method DoEnsure(): bool;
    var
      LTree: ref JSONTree;
    begin
      if self.Missing then
        return false;
      end;
      if self.Tree <> nil then
        return true;
      end;
      LTree := ref JSONTree();
      LTree.Doc := yyjson_mut_doc_new(addr of GAlc);
      if LTree.Doc = nil then
        return false;
      end;
      self.Node := yyjson_mut_obj(LTree.Doc);
      if self.Node = nil then
        return false;
      end;
      yyjson_mut_doc_set_root(LTree.Doc, self.Node);
      self.Tree := LTree;
      return true;
    end;

    // A view of ANode in this tree; a missing value for nil
    hidden const method DoView(const ANode: ptr to yyjson_mut_val): JSON;
    var
      LView: JSON;
    begin
      if ANode = nil then
        LView.Missing := true;
        return LView;
      end;
      LView.Tree := self.Tree;
      LView.Node := ANode;
      return LView;
    end;

    // A missing value carrying AError
    hidden const method DoFailed(const AError: string): JSON;
    var
      LView: JSON;
    begin
      LView.Missing := true;
      LView.Error := AError;
      return LView;
    end;

    // This value made a missing one carrying AError
    hidden method DoFail(const AError: string);
    begin
      self.Tree := nil;
      self.Node := nil;
      self.Missing := true;
      self.Error := AError;
    end;

    // The tree's document, made for a fresh value (nil for a missing one)
    hidden method DoDoc(): ptr to yyjson_mut_doc;
    begin
      if not self.DoEnsure() then
        return nil;
      end;
      return self.Tree.Doc;
    end;

    // Where the next Add goes: the innermost container opened from this node, else the node
    hidden method DoContainer(): ptr to yyjson_mut_val;
    begin
      if (self.Tree.Depth > 0) and (self.Tree.Base = self.Node) then
        return self.Tree.Open[self.Tree.Depth - 1];
      end;
      return self.Node;
    end;

    // AValue (made in this tree's document) added under AKey to the container when it is an
    // object (AKeyed), or appended when it is an array (not AKeyed); false when it does not fit
    hidden method DoAttach(const AKeyed: bool; const AKey: string;
      const AValue: ptr to yyjson_mut_val): bool;
    var
      LContainer: ptr to yyjson_mut_val;
      LKey: ptr to yyjson_mut_val;
    begin
      if AValue = nil then
        return false;
      end;
      LContainer := self.DoContainer();
      if AKeyed then
        if not yyjson_mut_is_obj(LContainer) then
          return false;
        end;
        LKey := yyjson_mut_strncpy(self.Tree.Doc, DoChars(AKey), uint64(len(AKey)));
        return yyjson_mut_obj_add(LContainer, LKey, AValue);
      end;
      if not yyjson_mut_is_arr(LContainer) then
        return false;
      end;
      return yyjson_mut_arr_append(LContainer, AValue);
    end;

    // The container AValue opened under the current one, pushed so the next Adds go into it
    hidden method DoOpen(const AKeyed: bool; const AKey: string;
      const AValue: ptr to yyjson_mut_val);
    begin
      if not self.DoAttach(AKeyed, AKey, AValue) then
        return;
      end;
      if self.Tree.Depth = 0 then
        self.Tree.Base := self.Node;
      end;
      if self.Tree.Depth >= len(self.Tree.Open) then
        setlength(self.Tree.Open, self.Tree.Depth + 1);
      end;
      self.Tree.Open[self.Tree.Depth] := AValue;
      self.Tree.Depth := self.Tree.Depth + 1;
    end;

    // The innermost open container closed, when it is of the kind AObject says
    hidden method DoClose(const AObject: bool);
    var
      LTop: ptr to yyjson_mut_val;
    begin
      if self.Tree = nil then
        return;
      end;
      if (self.Tree.Depth = 0) or (self.Tree.Base <> self.Node) then
        return;
      end;
      LTop := self.Tree.Open[self.Tree.Depth - 1];
      if yyjson_mut_is_obj(LTop) <> AObject then
        return;
      end;
      self.Tree.Depth := self.Tree.Depth - 1;
    end;

    // The JSON text AText's root copied into this tree's document; nil when it is no JSON
    hidden method DoCopyText(const AText: string): ptr to yyjson_mut_val;
    var
      LDoc: ptr to yyjson_doc;
      LValue: ptr to yyjson_mut_val;
    begin
      LDoc := yyjson_read_opts(ptr to char(ptr(uint64(DoChars(AText)))), uint64(len(AText)),
        ADAM_JSON_READ_FLAGS, addr of GAlc, nil);
      if LDoc = nil then
        return nil;
      end;
      LValue := yyjson_val_mut_copy(self.Tree.Doc, yyjson_doc_get_root(LDoc));
      yyjson_doc_free(LDoc);
      return LValue;
    end;

    // This value the root of the read document ADoc (freed here): a tree of its own
    hidden method DoTake(const ADoc: ptr to yyjson_doc): bool;
    var
      LTree: ref JSONTree;
    begin
      LTree := ref JSONTree();
      LTree.Doc := yyjson_doc_mut_copy(ADoc, addr of GAlc);
      yyjson_doc_free(ADoc);
      if LTree.Doc = nil then
        self.DoFail(ADAM_JSON_MSG_NO_ROOM);
        return false;
      end;
      self.Tree := LTree;
      self.Node := yyjson_mut_doc_get_root(LTree.Doc);
      self.Missing := false;
      self.Error := "";
      return true;
    end;

    // The key at APath[AAt] (bare or quoted) in AKey; false on a malformed one
    hidden const method DoReadKey(const APath: string; var AAt: int64; var AKey: string): bool;
    var
      LFrom: int64;
    begin
      if (AAt < len(APath)) and (APath[AAt] = '"') then
        AAt := AAt + 1;
        LFrom := AAt;
        // A quoted key: found to its closing quote (an escaped one passed), then unescaped
        while (AAt < len(APath)) and (APath[AAt] <> '"') do
          if (APath[AAt] = '\\') and (AAt + 1 < len(APath)) then
            AAt := AAt + 1;
          end;
          AAt := AAt + 1;
        end;
        if AAt >= len(APath) then
          return false;
        end;
        AKey := self.DoUnquote(Substring(APath, LFrom, AAt - LFrom));
        AAt := AAt + 1;
        return true;
      end;
      LFrom := AAt;
      while (AAt < len(APath)) and (APath[AAt] <> '.') and (APath[AAt] <> '[') do
        AAt := AAt + 1;
      end;
      AKey := Substring(APath, LFrom, AAt - LFrom);
      return len(AKey) > 0;
    end;

    // A quoted key's text with its \" and \\ escapes taken
    hidden const method DoUnquote(const AText: string): string;
    var
      LText: string;
      LAt: int64;
      LTo: int64;
    begin
      setlength(LText, len(AText));
      LAt := 0;
      LTo := 0;
      while LAt < len(AText) do
        if (AText[LAt] = '\\') and (LAt + 1 < len(AText)) then
          LAt := LAt + 1;
        end;
        LText[LTo] := AText[LAt];
        LTo := LTo + 1;
        LAt := LAt + 1;
      end;
      setlength(LText, LTo);
      return LText;
    end;

    // The node APath names from this one; nil when it names none (or is malformed)
    hidden const method DoResolve(const APath: string): ptr to yyjson_mut_val;
    var
      LNode: ptr to yyjson_mut_val;
      LAt: int64;
      LKey: string;
      LFrom: int64;
      LIndex: int64;
    begin
      LNode := self.Node;
      if LNode = nil then
        return nil;
      end;
      LAt := 0;
      while LAt < len(APath) do
        if APath[LAt] = '[' then
          LAt := LAt + 1;
          LFrom := LAt;
          while (LAt < len(APath)) and (APath[LAt] <> ']') do
            LAt := LAt + 1;
          end;
          if (LAt >= len(APath)) or not TryStrToInt(Substring(APath, LFrom, LAt - LFrom), LIndex) then
            return nil;
          end;
          LAt := LAt + 1;
          if (not yyjson_mut_is_arr(LNode)) or (LIndex < 0) or
            (LIndex >= int64(yyjson_mut_arr_size(LNode))) then
            return nil;
          end;
          LNode := yyjson_mut_arr_get(LNode, uint64(LIndex));
        else
          if APath[LAt] = '.' then
            LAt := LAt + 1;
          end;
          if not self.DoReadKey(APath, LAt, LKey) then
            return nil;
          end;
          if not yyjson_mut_is_obj(LNode) then
            return nil;
          end;
          LNode := yyjson_mut_obj_getn(LNode, DoChars(LKey), uint64(len(LKey)));
          if LNode = nil then
            return nil;
          end;
        end;
      end;
      return LNode;
    end;

    // -- Reading text, files and streams (a failure: a missing value, ErrorText set)

    /// Parses JSON text into this value's tree.
    /// @param AText the JSON text
    /// @returns false with ErrorText (`<text>(line,col): message`) when it is no valid JSON
    method Parse(const AText: string): bool;
    var
      LError: yyjson_read_err;
      LDoc: ptr to yyjson_doc;
    begin
      LDoc := yyjson_read_opts(ptr to char(ptr(uint64(DoChars(AText)))), uint64(len(AText)),
        ADAM_JSON_READ_FLAGS, addr of GAlc, addr of LError);
      if LDoc = nil then
        self.DoFail(DoTextError(ADAM_JSON_TEXT_NAME, AText, LError));
        return false;
      end;
      return self.DoTake(LDoc);
    end;

    /// Reads a JSON file into this value's tree, through C's file calls (so a HookIO
    /// path reads its IO).
    /// @param APath the file
    /// @returns false with ErrorText (`APath: message (byte N)`, or that the file cannot be opened)
    method LoadFromFile(const APath: string): bool;
    var
      LPath: string;
      LError: yyjson_read_err;
      LDoc: ptr to yyjson_doc;
    begin
      LPath := DoFilePath(APath);
      LDoc := yyjson_read_file(LPath, ADAM_JSON_READ_FLAGS, addr of GAlc,
        addr of LError);
      if LDoc = nil then
        self.DoFail(DoFileError(APath, LError));
        return false;
      end;
      return self.DoTake(LDoc);
    end;

    /// Reads the JSON text an IO holds, from its place to its end, into this value's tree.
    /// @param AIO the IO
    /// @returns false with ErrorText (`<io>(line,col): message`)
    method LoadFromIO(const AIO: IO): bool;
    var
      LText: string;
      LOk: bool;
    begin
      if AIO = nil then
        self.DoFail(ADAM_JSON_IO_NAME + ": " + ADAM_JSON_MSG_NO_IO);
        return false;
      end;
      if not IOReadAll(AIO, LText) then
        self.DoFail(ADAM_JSON_IO_NAME + ": " + ADAM_JSON_MSG_IO_FAILED);
        return false;
      end;
      LOk := self.Parse(LText);
      if not LOk then
        // The text's own errors, named for the IO it came from
        self.Error := ADAM_JSON_IO_NAME + Substring(self.Error, len(ADAM_JSON_TEXT_NAME),
          len(self.Error) - len(ADAM_JSON_TEXT_NAME));
      end;
      return LOk;
    end;

    /// Why the last Parse, LoadFromFile, LoadFromIO or JSON.From* failed.
    /// @returns the reason, or "" when it did not fail
    const method ErrorText(): string;
    begin
      return self.Error;
    end;

    // -- Made from a text, a file or an IO (static: JSON.FromFile(P))

    /// A JSON value parsed from text.
    /// @param AText the JSON text
    /// @returns the value; a missing value with its ErrorText when it is no valid JSON
    /// @example `LCfg := JSON.FromString("{\"port\": 8080}"); println("{}", LCfg.Get("port").AsInt32());`
    static method FromString(const AText: string): JSON;
    var
      LJSON: JSON;
    begin
      LJSON.Parse(AText);
      return LJSON;
    end;

    /// A JSON value read from a file, through C's file calls (a HookIO path reads its IO).
    /// @param APath the file
    /// @returns the value; a missing value with its ErrorText on a failure
    static method FromFile(const APath: string): JSON;
    var
      LJSON: JSON;
    begin
      LJSON.LoadFromFile(APath);
      return LJSON;
    end;

    /// A JSON value read from the text an IO holds, from its place to its end.
    /// @param AIO the IO
    /// @returns the value; a missing value with its ErrorText on a failure
    static method FromIO(const AIO: IO): JSON;
    var
      LJSON: JSON;
    begin
      LJSON.LoadFromIO(AIO);
      return LJSON;
    end;

    /// A JSON value parsed from text, the outcome as a result.
    /// @param AText the JSON text
    /// @param AJSON receives the value (a missing value, its ErrorText why, on a failure)
    /// @returns false when it is no valid JSON
    static method TryFromString(const AText: string; var AJSON: JSON): bool;
    var
      LJSON: JSON;
      LOk: bool;
    begin
      LOk := LJSON.Parse(AText);
      AJSON := LJSON;
      return LOk;
    end;

    // -- Writing

    /// The value as compact JSON text.
    /// @returns the text ("{}" for a fresh value, "null" for a missing one)
    const method ToString(): string;
    begin
      if self.Missing then
        return "null";
      end;
      if self.Tree = nil then
        return "{}";
      end;
      return DoWrite(self.Node, YYJSON_WRITE_NOFLAG);
    end;

    /// The value as JSON text, a line per member, 2 spaces a level.
    /// @returns the text
    const method ToPrettyString(): string;
    begin
      return self.ToPrettyString(ADAM_JSON_INDENT);
    end;

    /// The value as JSON text, a line per member.
    /// @param AIndent the spaces per level
    /// @returns the text
    const method ToPrettyString(const AIndent: int32): string;
    var
      LText: string;
    begin
      if (self.Missing) or (self.Tree = nil) then
        return self.ToString();
      end;
      if AIndent = ADAM_JSON_INDENT then
        return DoWrite(self.Node, YYJSON_WRITE_PRETTY_TWO_SPACES);
      end;
      LText := DoWrite(self.Node, YYJSON_WRITE_PRETTY);
      if int64(AIndent) = ADAM_JSON_YYJSON_INDENT then
        return LText;
      end;
      if AIndent < 0 then
        return DoReindent(LText, 0);
      end;
      return DoReindent(LText, int64(AIndent));
    end;

    /// Writes the value to a file, pretty (2 spaces), through C's file calls (a HookIO path
    /// writes its IO).
    /// @param APath the file
    /// @returns false when it cannot be written
    method SaveToFile(const APath: string): bool;
    begin
      return self.SaveToFile(APath, true);
    end;

    /// Writes the value to a file, through C's file calls.
    /// @param APath the file
    /// @param APretty true for 2 spaces a level, false for compact text
    /// @returns false when it cannot be written
    method SaveToFile(const APath: string; const APretty: bool): bool;
    var
      LPath: string;
      LFlags: yyjson_write_flag;
      LOk: bool;
    begin
      if self.Missing then
        return false;
      end;
      if not self.DoEnsure() then
        return false;
      end;
      LPath := DoFilePath(APath);
      LFlags := ADAM_JSON_WRITE_FLAGS;
      if APretty then
        LFlags := LFlags | YYJSON_WRITE_PRETTY_TWO_SPACES;
      end;
      LOk := yyjson_mut_val_write_file(LPath, self.Node, LFlags, addr of GAlc, nil);
      return LOk;
    end;

    /// Writes the value's text to an IO at its place, pretty (2 spaces).
    /// @param AIO the IO
    /// @returns false when not all of it could be written
    method SaveToIO(const AIO: IO): bool;
    begin
      return self.SaveToIO(AIO, true);
    end;

    /// Writes the value's text to an IO at its place.
    /// @param AIO the IO
    /// @param APretty true for 2 spaces a level, false for compact text
    /// @returns false when not all of it could be written
    method SaveToIO(const AIO: IO; const APretty: bool): bool;
    var
      LText: string;
    begin
      if (AIO = nil) or self.Missing then
        return false;
      end;
      if APretty then
        LText := self.ToPrettyString(ADAM_JSON_INDENT);
      else
        LText := self.ToString();
      end;
      if len(LText) = 0 then
        return true;
      end;
      return IOWriteFull(AIO, DoChars(LText), len(LText)) = len(LText);
    end;

    // -- Building (each returns this value, so calls chain)

    /// Adds a string under a key to the open object (every integer type has its own overload, so a
    /// Adds a string under a key to the open object (nothing changes in an array).
    /// @param AKey the key
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AKey: string; const AValue: string): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(true, AKey, yyjson_mut_strncpy(self.Tree.Doc, DoChars(AValue), uint64(len(AValue))));
      end;
      return self;
    end;

    /// Adds a signed number under a key to the open object (every integer type has its own overload, so a
    /// call is never ambiguous; nothing changes in an array).
    /// @param AKey the key
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AKey: string; const AValue: int32): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(true, AKey, yyjson_mut_sint(self.Tree.Doc, int64(AValue)));
      end;
      return self;
    end;

    /// Adds a signed number under a key to the open object (every integer type has its own overload, so a
    /// call is never ambiguous; nothing changes in an array).
    /// @param AKey the key
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AKey: string; const AValue: int64): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(true, AKey, yyjson_mut_sint(self.Tree.Doc, AValue));
      end;
      return self;
    end;

    /// Adds an unsigned number under a key to the open object (every integer type has its own overload, so a
    /// call is never ambiguous; nothing changes in an array).
    /// @param AKey the key
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AKey: string; const AValue: uint32): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(true, AKey, yyjson_mut_uint(self.Tree.Doc, uint64(AValue)));
      end;
      return self;
    end;

    /// Adds an unsigned number under a key to the open object (every integer type has its own overload, so a
    /// call is never ambiguous; nothing changes in an array).
    /// @param AKey the key
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AKey: string; const AValue: uint64): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(true, AKey, yyjson_mut_uint(self.Tree.Doc, AValue));
      end;
      return self;
    end;

    /// Adds a number under a key to the open object (every integer type has its own overload, so a
    /// call is never ambiguous; nothing changes in an array).
    /// @param AKey the key
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AKey: string; const AValue: float64): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(true, AKey, yyjson_mut_real(self.Tree.Doc, AValue));
      end;
      return self;
    end;

    /// Adds true or false under a key to the open object (every integer type has its own overload, so a
    /// call is never ambiguous; nothing changes in an array).
    /// @param AKey the key
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AKey: string; const AValue: bool): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(true, AKey, yyjson_mut_bool(self.Tree.Doc, AValue));
      end;
      return self;
    end;

    /// Adds a copy of a value's tree under a key to the open object (a fresh value: an
    /// empty object; a missing one: null).
    /// @param AKey the key
    /// @param AValue the value copied
    /// @returns this value, so calls chain
    method Add(const AKey: string; const AValue: JSON): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(true, AKey, self.DoCopyOf(AValue));
      end;
      return self;
    end;

    /// Adds null under a key to the open object.
    /// @param AKey the key
    /// @returns this value, so calls chain
    method AddNull(const AKey: string): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(true, AKey, yyjson_mut_null(self.Tree.Doc));
      end;
      return self;
    end;

    /// Adds the value JSON text holds under a key to the open object; nothing when the text is
    /// no valid JSON.
    /// @param AKey the key
    /// @param AJSONText the JSON text
    /// @returns this value, so calls chain
    method AddRaw(const AKey: string; const AJSONText: string): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(true, AKey, self.DoCopyText(AJSONText));
      end;
      return self;
    end;

    /// Appends a string to the open array (nothing changes in an object).
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AValue: string): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(false, "", yyjson_mut_strncpy(self.Tree.Doc, DoChars(AValue), uint64(len(AValue))));
      end;
      return self;
    end;

    /// Appends a signed number to the open array (nothing changes in an object).
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AValue: int32): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(false, "", yyjson_mut_sint(self.Tree.Doc, int64(AValue)));
      end;
      return self;
    end;

    /// Appends a signed number to the open array (nothing changes in an object).
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AValue: int64): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(false, "", yyjson_mut_sint(self.Tree.Doc, AValue));
      end;
      return self;
    end;

    /// Appends an unsigned number to the open array (nothing changes in an object).
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AValue: uint32): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(false, "", yyjson_mut_uint(self.Tree.Doc, uint64(AValue)));
      end;
      return self;
    end;

    /// Appends an unsigned number to the open array (nothing changes in an object).
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AValue: uint64): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(false, "", yyjson_mut_uint(self.Tree.Doc, AValue));
      end;
      return self;
    end;

    /// Appends a number to the open array (nothing changes in an object).
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AValue: float64): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(false, "", yyjson_mut_real(self.Tree.Doc, AValue));
      end;
      return self;
    end;

    /// Appends true or false to the open array (nothing changes in an object).
    /// @param AValue the value
    /// @returns this value, so calls chain
    method Add(const AValue: bool): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(false, "", yyjson_mut_bool(self.Tree.Doc, AValue));
      end;
      return self;
    end;

    /// Appends a copy of a value's tree to the open array.
    /// @param AValue the value copied
    /// @returns this value, so calls chain
    method Add(const AValue: JSON): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(false, "", self.DoCopyOf(AValue));
      end;
      return self;
    end;

    /// Appends null to the open array.
    /// @returns this value, so calls chain
    method AddNull(): JSON;
    begin
      if self.DoEnsure() then
        self.DoAttach(false, "", yyjson_mut_null(self.Tree.Doc));
      end;
      return self;
    end;

    /// Adds an array of strings under a key to the open object.
    /// @param AKey the key
    /// @param AValues the strings
    /// @returns this value, so calls chain
    method AddStrings(const AKey: string; const AValues: StringArray): JSON;
    var
      LArray: ptr to yyjson_mut_val;
      LI: int64;
    begin
      if self.DoEnsure() then
        LArray := yyjson_mut_arr(self.Tree.Doc);
        if self.DoAttach(true, AKey, LArray) then
          for LI := 0 to len(AValues) - 1 do
            yyjson_mut_arr_append(LArray, yyjson_mut_strncpy(self.Tree.Doc, DoChars(AValues[LI]),
              uint64(len(AValues[LI]))));
          end;
        end;
      end;
      return self;
    end;

    /// Adds an array of whole numbers under a key to the open object.
    /// @param AKey the key
    /// @param AValues the numbers
    /// @returns this value, so calls chain
    method AddIntegers(const AKey: string; const AValues: Int64Array): JSON;
    var
      LArray: ptr to yyjson_mut_val;
      LI: int64;
    begin
      if self.DoEnsure() then
        LArray := yyjson_mut_arr(self.Tree.Doc);
        if self.DoAttach(true, AKey, LArray) then
          for LI := 0 to len(AValues) - 1 do
            yyjson_mut_arr_append(LArray, yyjson_mut_sint(self.Tree.Doc, AValues[LI]));
          end;
        end;
      end;
      return self;
    end;

    /// Adds an array of numbers under a key to the open object.
    /// @param AKey the key
    /// @param AValues the numbers
    /// @returns this value, so calls chain
    method AddDoubles(const AKey: string; const AValues: array of float64): JSON;
    var
      LArray: ptr to yyjson_mut_val;
      LI: int64;
    begin
      if self.DoEnsure() then
        LArray := yyjson_mut_arr(self.Tree.Doc);
        if self.DoAttach(true, AKey, LArray) then
          for LI := 0 to len(AValues) - 1 do
            yyjson_mut_arr_append(LArray, yyjson_mut_real(self.Tree.Doc, AValues[LI]));
          end;
        end;
      end;
      return self;
    end;

    /// Opens an object under a key in the open object: the next Adds go into it until
    /// EndObject.
    /// @param AKey the key
    /// @returns this value, so calls chain
    /// @example `LJ.BeginObject("window").Add("width", 1280).Add("height", 720).EndObject();`
    method BeginObject(const AKey: string): JSON;
    begin
      if self.DoEnsure() then
        self.DoOpen(true, AKey, yyjson_mut_obj(self.Tree.Doc));
      end;
      return self;
    end;

    /// Opens an object appended to the open array: the next Adds go into it until EndObject.
    /// @returns this value, so calls chain
    method BeginObject(): JSON;
    begin
      if self.DoEnsure() then
        self.DoOpen(false, "", yyjson_mut_obj(self.Tree.Doc));
      end;
      return self;
    end;

    /// Closes the object BeginObject opened.
    /// @returns this value, so calls chain
    method EndObject(): JSON;
    begin
      self.DoClose(true);
      return self;
    end;

    /// Opens an array under a key in the open object: the next Adds go into it until EndArray.
    /// @param AKey the key
    /// @returns this value, so calls chain
    method BeginArray(const AKey: string): JSON;
    begin
      if self.DoEnsure() then
        self.DoOpen(true, AKey, yyjson_mut_arr(self.Tree.Doc));
      end;
      return self;
    end;

    /// Opens an array appended to the open array: the next Adds go into it until EndArray.
    /// @returns this value, so calls chain
    method BeginArray(): JSON;
    begin
      if self.DoEnsure() then
        self.DoOpen(false, "", yyjson_mut_arr(self.Tree.Doc));
      end;
      return self;
    end;

    /// Closes the array BeginArray opened.
    /// @returns this value, so calls chain
    method EndArray(): JSON;
    begin
      self.DoClose(false);
      return self;
    end;

    // AValue's node copied into this tree's document (a fresh one: an empty object; a missing
    // one: null); nil when there is no room
    hidden method DoCopyOf(const AValue: JSON): ptr to yyjson_mut_val;
    begin
      if AValue.Missing then
        return yyjson_mut_null(self.Tree.Doc);
      end;
      if AValue.Tree = nil then
        return yyjson_mut_obj(self.Tree.Doc);
      end;
      return yyjson_mut_val_mut_copy(self.Tree.Doc, AValue.Node);
    end;

    // -- Navigating

    /// The value a path names, a view sharing this tree.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @returns the value; a missing value when the path names none
    /// @example `LPort := LCfg.Get("servers[0].ports[1]").AsInt32();`
    const method Get(const APath: string): JSON;
    begin
      if self.Tree = nil then
        if len(APath) = 0 then
          return self;
        end;
        return self.DoView(nil);
      end;
      return self.DoView(self.DoResolve(APath));
    end;

    /// Whether a path names a value.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @returns true when it does
    const method Has(const APath: string): bool;
    begin
      if self.Tree = nil then
        return (len(APath) = 0) and not self.Missing;
      end;
      return self.DoResolve(APath) <> nil;
    end;

    /// The value a path (or one key) names, a view sharing this tree.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param ALiteral true to take APath as one key of this object (no `.` or `[N]` split)
    /// @returns the value; a missing value when it names none
    const method Get(const APath: string; const ALiteral: bool): JSON;
    begin
      if not ALiteral then
        return self.Get(APath);
      end;
      return self.DoView(self.DoLookup(APath, true));
    end;

    /// Whether a path (or one key) names a value.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param ALiteral true to take APath as one key of this object (no `.` or `[N]` split)
    /// @returns true when it does
    const method Has(const APath: string; const ALiteral: bool): bool;
    begin
      if not ALiteral then
        return self.Has(APath);
      end;
      return self.DoLookup(APath, true) <> nil;
    end;

    // The node Get and the TryGet* reads find: APath's (DoResolve), or when ALiteral the
    // member named APath of this object; nil when there is none
    hidden const method DoLookup(const APath: string; const ALiteral: bool): ptr to yyjson_mut_val;
    begin
      if self.Tree = nil then
        return nil;
      end;
      if not ALiteral then
        return self.DoResolve(APath);
      end;
      if not yyjson_mut_is_obj(self.Node) then
        return nil;
      end;
      return yyjson_mut_obj_getn(self.Node, DoChars(APath), uint64(len(APath)));
    end;

    // -- Strict reads: true and AValue set when the value APath names is of the kind asked
    //    (a number is no string, a string no number); false and AValue the kind's zero
    //    (an empty JSON for TryGetObject / TryGetArray) otherwise. Each takes ALiteral as
    //    Get does.

    /// Reads the value a path names when it is of this kind: A string (a number is none).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; "" when the kind differs
    /// @returns true when the value is of this kind
    const method TryGetString(const APath: string; var AValue: string): bool;
    begin
      return self.TryGetString(APath, AValue, false);
    end;

    /// Reads the value a path names when it is of this kind: A string (a number is none).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; "" when the kind differs
    /// @param ALiteral true to take APath as one key of this object (no `.` or `[N]` split)
    /// @returns true when the value is of this kind
    const method TryGetString(const APath: string; var AValue: string; const ALiteral: bool): bool;
    var
      LNode: ptr to yyjson_mut_val;
    begin
      AValue := "";
      LNode := self.DoLookup(APath, ALiteral);
      if (LNode = nil) or not yyjson_mut_is_str(LNode) then
        return false;
      end;
      AValue := DoStringOf(LNode);
      return true;
    end;

    /// Reads the value a path names when it is of this kind: A whole number int32 holds (a real such as 2.5 is none).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; 0 when the kind differs
    /// @returns true when the value is of this kind
    const method TryGetInt32(const APath: string; var AValue: int32): bool;
    begin
      return self.TryGetInt32(APath, AValue, false);
    end;

    /// Reads the value a path names when it is of this kind: A whole number int32 holds (a real such as 2.5 is none).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; 0 when the kind differs
    /// @param ALiteral true to take APath as one key of this object (no `.` or `[N]` split)
    /// @returns true when the value is of this kind
    const method TryGetInt32(const APath: string; var AValue: int32; const ALiteral: bool): bool;
    var
      LValue: int64;
    begin
      AValue := 0;
      if not self.TryGetInt64(APath, LValue, ALiteral) then
        return false;
      end;
      if (LValue < int64(ADAM_JSON_INT32_MIN)) or (LValue > int64(ADAM_JSON_INT32_MAX)) then
        return false;
      end;
      AValue := int32(LValue);
      return true;
    end;

    /// Reads the value a path names when it is of this kind: A whole number int64 holds (a real such as 2.5 is none).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; 0 when the kind differs
    /// @returns true when the value is of this kind
    const method TryGetInt64(const APath: string; var AValue: int64): bool;
    begin
      return self.TryGetInt64(APath, AValue, false);
    end;

    /// Reads the value a path names when it is of this kind: A whole number int64 holds (a real such as 2.5 is none).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; 0 when the kind differs
    /// @param ALiteral true to take APath as one key of this object (no `.` or `[N]` split)
    /// @returns true when the value is of this kind
    const method TryGetInt64(const APath: string; var AValue: int64; const ALiteral: bool): bool;
    var
      LNode: ptr to yyjson_mut_val;
    begin
      AValue := 0;
      LNode := self.DoLookup(APath, ALiteral);
      if LNode = nil then
        return false;
      end;
      if yyjson_mut_is_sint(LNode) then
        AValue := yyjson_mut_get_sint(LNode);
        return true;
      end;
      // A whole number of 0 or more is yyjson's uint: it fits when it is not past int64
      if yyjson_mut_is_uint(LNode) and (yyjson_mut_get_uint(LNode) <= uint64(ADAM_JSON_INT64_MAX)) then
        AValue := int64(yyjson_mut_get_uint(LNode));
        return true;
      end;
      return false;
    end;

    /// Reads the value a path names when it is of this kind: true or false (a number or a string is none).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; false when the kind differs
    /// @returns true when the value is of this kind
    const method TryGetBoolean(const APath: string; var AValue: bool): bool;
    begin
      return self.TryGetBoolean(APath, AValue, false);
    end;

    /// Reads the value a path names when it is of this kind: true or false (a number or a string is none).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; false when the kind differs
    /// @param ALiteral true to take APath as one key of this object (no `.` or `[N]` split)
    /// @returns true when the value is of this kind
    const method TryGetBoolean(const APath: string; var AValue: bool; const ALiteral: bool): bool;
    var
      LNode: ptr to yyjson_mut_val;
    begin
      AValue := false;
      LNode := self.DoLookup(APath, ALiteral);
      if (LNode = nil) or not yyjson_mut_is_bool(LNode) then
        return false;
      end;
      AValue := yyjson_mut_get_bool(LNode);
      return true;
    end;

    /// Reads the value a path names when it is of this kind: An object, AValue a view of it sharing this tree.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; an empty JSON when the kind differs
    /// @returns true when the value is of this kind
    const method TryGetObject(const APath: string; var AValue: JSON): bool;
    begin
      return self.TryGetObject(APath, AValue, false);
    end;

    /// Reads the value a path names when it is of this kind: An object, AValue a view of it sharing this tree.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; an empty JSON when the kind differs
    /// @param ALiteral true to take APath as one key of this object (no `.` or `[N]` split)
    /// @returns true when the value is of this kind
    const method TryGetObject(const APath: string; var AValue: JSON; const ALiteral: bool): bool;
    var
      LNode: ptr to yyjson_mut_val;
      LEmpty: JSON;
    begin
      AValue := LEmpty;
      LNode := self.DoLookup(APath, ALiteral);
      if (LNode = nil) or not yyjson_mut_is_obj(LNode) then
        return false;
      end;
      AValue := self.DoView(LNode);
      return true;
    end;

    /// Reads the value a path names when it is of this kind: An array, AValue a view of it sharing this tree.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; an empty JSON when the kind differs
    /// @returns true when the value is of this kind
    const method TryGetArray(const APath: string; var AValue: JSON): bool;
    begin
      return self.TryGetArray(APath, AValue, false);
    end;

    /// Reads the value a path names when it is of this kind: An array, AValue a view of it sharing this tree.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the value itself)
    /// @param AValue receives the value; an empty JSON when the kind differs
    /// @param ALiteral true to take APath as one key of this object (no `.` or `[N]` split)
    /// @returns true when the value is of this kind
    const method TryGetArray(const APath: string; var AValue: JSON; const ALiteral: bool): bool;
    var
      LNode: ptr to yyjson_mut_val;
      LEmpty: JSON;
    begin
      AValue := LEmpty;
      LNode := self.DoLookup(APath, ALiteral);
      if (LNode = nil) or not yyjson_mut_is_arr(LNode) then
        return false;
      end;
      AValue := self.DoView(LNode);
      return true;
    end;

    /// How many items an array or members an object holds.
    /// @returns the count; 0 for any other value
    const method Count(): int64;
    begin
      if self.Tree = nil then
        return 0;
      end;
      if yyjson_mut_is_arr(self.Node) then
        return int64(yyjson_mut_arr_size(self.Node));
      end;
      if yyjson_mut_is_obj(self.Node) then
        return int64(yyjson_mut_obj_size(self.Node));
      end;
      return 0;
    end;

    /// An object's keys, in order.
    /// @returns the keys; none for any other value
    const method Keys(): StringArray;
    var
      LKeys: StringArray;
      LIter: yyjson_mut_obj_iter;
      LKey: ptr to yyjson_mut_val;
      LAt: int64;
    begin
      setlength(LKeys, 0);
      if (self.Tree = nil) or not yyjson_mut_is_obj(self.Node) then
        return LKeys;
      end;
      setlength(LKeys, int64(yyjson_mut_obj_size(self.Node)));
      yyjson_mut_obj_iter_init(self.Node, addr of LIter);
      LAt := 0;
      LKey := yyjson_mut_obj_iter_next(addr of LIter);
      while LKey <> nil do
        LKeys[LAt] := DoStringOf(LKey);
        LAt := LAt + 1;
        LKey := yyjson_mut_obj_iter_next(addr of LIter);
      end;
      return LKeys;
    end;

    /// An array's items or an object's values, in order, each a view (`for .. in` walks them).
    /// @returns the values; none for any other value
    /// @example `for LItem in LList.Items() do println(LItem.AsString()); end;`
    const method Items(): array of JSON;
    var
      LItems: array of JSON;
      LArrayIter: yyjson_mut_arr_iter;
      LObjectIter: yyjson_mut_obj_iter;
      LNode: ptr to yyjson_mut_val;
      LAt: int64;
    begin
      setlength(LItems, self.Count());
      LAt := 0;
      if len(LItems) = 0 then
        return LItems;
      end;
      if yyjson_mut_is_arr(self.Node) then
        yyjson_mut_arr_iter_init(self.Node, addr of LArrayIter);
        LNode := yyjson_mut_arr_iter_next(addr of LArrayIter);
        while LNode <> nil do
          LItems[LAt] := self.DoView(LNode);
          LAt := LAt + 1;
          LNode := yyjson_mut_arr_iter_next(addr of LArrayIter);
        end;
        return LItems;
      end;
      yyjson_mut_obj_iter_init(self.Node, addr of LObjectIter);
      LNode := yyjson_mut_obj_iter_next(addr of LObjectIter);
      while LNode <> nil do
        LItems[LAt] := self.DoView(yyjson_mut_obj_iter_get_val(LNode));
        LAt := LAt + 1;
        LNode := yyjson_mut_obj_iter_next(addr of LObjectIter);
      end;
      return LItems;
    end;

    /// An object's members, in order: each key and a view of its value.
    /// @returns the members; none for any other value
    const method Pairs(): array of JSONPair;
    var
      LPairs: array of JSONPair;
      LKeys: StringArray;
      LItems: array of JSON;
      LI: int64;
    begin
      setlength(LPairs, 0);
      if not self.IsObject() then
        return LPairs;
      end;
      LKeys := self.Keys();
      LItems := self.Items();
      setlength(LPairs, len(LKeys));
      for LI := 0 to len(LKeys) - 1 do
        LPairs[LI].NodeName := LKeys[LI];
        LPairs[LI].Value := LItems[LI];
      end;
      return LPairs;
    end;

    /// An array's first item.
    /// @returns the item; a missing value for an empty array or any other value
    const method First(): JSON;
    begin
      if (self.Tree = nil) or not yyjson_mut_is_arr(self.Node) then
        return self.DoView(nil);
      end;
      return self.DoView(yyjson_mut_arr_get_first(self.Node));
    end;

    /// An array's last item.
    /// @returns the item; a missing value for an empty array or any other value
    const method Last(): JSON;
    begin
      if (self.Tree = nil) or not yyjson_mut_is_arr(self.Node) then
        return self.DoView(nil);
      end;
      return self.DoView(yyjson_mut_arr_get_last(self.Node));
    end;

    /// Whether the value is an array holding a string.
    /// @param AValue the string
    /// @returns true when it holds it
    const method Contains(const AValue: string): bool;
    var
      LIter: yyjson_mut_arr_iter;
      LNode: ptr to yyjson_mut_val;
    begin
      if (self.Tree = nil) or not yyjson_mut_is_arr(self.Node) then
        return false;
      end;
      yyjson_mut_arr_iter_init(self.Node, addr of LIter);
      LNode := yyjson_mut_arr_iter_next(addr of LIter);
      while LNode <> nil do
        if yyjson_mut_equals_strn(LNode, DoChars(AValue), uint64(len(AValue))) then
          return true;
        end;
        LNode := yyjson_mut_arr_iter_next(addr of LIter);
      end;
      return false;
    end;

    /// Whether the value is an array holding a whole number.
    /// @param AValue the number
    /// @returns true when it holds it
    const method Contains(const AValue: int64): bool;
    var
      LIter: yyjson_mut_arr_iter;
      LNode: ptr to yyjson_mut_val;
    begin
      if (self.Tree = nil) or not yyjson_mut_is_arr(self.Node) then
        return false;
      end;
      yyjson_mut_arr_iter_init(self.Node, addr of LIter);
      LNode := yyjson_mut_arr_iter_next(addr of LIter);
      while LNode <> nil do
        if yyjson_mut_is_sint(LNode) and (yyjson_mut_get_sint(LNode) = AValue) then
          return true;
        end;
        if yyjson_mut_is_uint(LNode) and (AValue >= 0) and (yyjson_mut_get_uint(LNode) = uint64(AValue)) then
          return true;
        end;
        LNode := yyjson_mut_arr_iter_next(addr of LIter);
      end;
      return false;
    end;

    // -- Values (a missing value, null, or one of no fitting kind gives the default: the
    //    kind's zero value for an As*() form)

    /// A string as itself, a number / true / false as its JSON text, an array / object as its compact text.
    /// @returns the value; the kind's zero when the value gives none
    const method AsString(): string;
    begin
      return self.AsString("");
    end;

    /// A string as itself, a number / true / false as its JSON text, an array / object as its compact text.
    /// @param ADefault the result when the value gives none
    /// @returns the value, or ADefault
    const method AsString(const ADefault: string): string;
    begin
      if (self.Tree = nil) or yyjson_mut_is_null(self.Node) then
        if (self.Tree = nil) and not self.Missing then
          return "{}";
        end;
        return ADefault;
      end;
      if yyjson_mut_is_str(self.Node) then
        return DoStringOf(self.Node);
      end;
      return DoWrite(self.Node, YYJSON_WRITE_NOFLAG);
    end;

    /// true / false, a number (not 0), or the string "true" (any case).
    /// @returns the value; the kind's zero when the value gives none
    const method AsBoolean(): bool;
    begin
      return self.AsBoolean(false);
    end;

    /// true / false, a number (not 0), or the string "true" (any case).
    /// @param ADefault the result when the value gives none
    /// @returns the value, or ADefault
    const method AsBoolean(const ADefault: bool): bool;
    begin
      if self.Tree = nil then
        return ADefault;
      end;
      if yyjson_mut_is_bool(self.Node) then
        return yyjson_mut_get_bool(self.Node);
      end;
      if yyjson_mut_is_num(self.Node) then
        return yyjson_mut_get_num(self.Node) <> 0.0;
      end;
      if yyjson_mut_is_str(self.Node) then
        return LowerCase(DoStringOf(self.Node)) = "true";
      end;
      return ADefault;
    end;

    /// A number (a real one truncated toward 0) or a decimal string, when int64 holds it.
    /// @returns the value; the kind's zero when the value gives none
    const method AsInt64(): int64;
    begin
      return self.AsInt64(0);
    end;

    /// A number (a real one truncated toward 0) or a decimal string, when int64 holds it.
    /// @param ADefault the result when the value gives none
    /// @returns the value, or ADefault
    const method AsInt64(const ADefault: int64): int64;
    var
      LValue: int64;
    begin
      if self.DoWhole(LValue) then
        return LValue;
      end;
      return ADefault;
    end;

    /// AsInt64's number, when int32 holds it.
    /// @returns the value; the kind's zero when the value gives none
    const method AsInt32(): int32;
    begin
      return self.AsInt32(0);
    end;

    /// AsInt64's number, when int32 holds it.
    /// @param ADefault the result when the value gives none
    /// @returns the value, or ADefault
    const method AsInt32(const ADefault: int32): int32;
    var
      LValue: int64;
    begin
      if not self.DoWhole(LValue) then
        return ADefault;
      end;
      if (LValue < int64(ADAM_JSON_INT32_MIN)) or (LValue > int64(ADAM_JSON_INT32_MAX)) then
        return ADefault;
      end;
      return int32(LValue);
    end;

    /// A whole number of 0 or more (beyond int64 too), when uint64 holds it.
    /// @returns the value; the kind's zero when the value gives none
    const method AsUInt64(): uint64;
    begin
      return self.AsUInt64(0);
    end;

    /// A whole number of 0 or more (beyond int64 too), when uint64 holds it.
    /// @param ADefault the result when the value gives none
    /// @returns the value, or ADefault
    const method AsUInt64(const ADefault: uint64): uint64;
    var
      LValue: int64;
    begin
      if (self.Tree <> nil) and yyjson_mut_is_uint(self.Node) then
        return yyjson_mut_get_uint(self.Node);
      end;
      if (not self.DoWhole(LValue)) or (LValue < 0) then
        return ADefault;
      end;
      return uint64(LValue);
    end;

    /// AsUInt64's number, when uint32 holds it.
    /// @returns the value; the kind's zero when the value gives none
    const method AsUInt32(): uint32;
    begin
      return self.AsUInt32(0);
    end;

    /// AsUInt64's number, when uint32 holds it.
    /// @param ADefault the result when the value gives none
    /// @returns the value, or ADefault
    const method AsUInt32(const ADefault: uint32): uint32;
    var
      LValue: int64;
    begin
      if (not self.DoWhole(LValue)) or (LValue < 0) or (LValue > int64(ADAM_JSON_UINT32_MAX)) then
        return ADefault;
      end;
      return uint32(LValue);
    end;

    /// A number or a decimal string, as a float64.
    /// @returns the value; the kind's zero when the value gives none
    const method AsDouble(): float64;
    begin
      return self.AsDouble(0.0);
    end;

    /// A number or a decimal string, as a float64.
    /// @param ADefault the result when the value gives none
    /// @returns the value, or ADefault
    const method AsDouble(const ADefault: float64): float64;
    var
      LValue: float64;
    begin
      if self.Tree = nil then
        return ADefault;
      end;
      if yyjson_mut_is_num(self.Node) then
        return yyjson_mut_get_num(self.Node);
      end;
      if yyjson_mut_is_str(self.Node) and TryStrToFloat(DoStringOf(self.Node), LValue) then
        return LValue;
      end;
      return ADefault;
    end;

    /// AsDouble's number as a float32 (past its range: an infinity).
    /// @returns the value; the kind's zero when the value gives none
    const method AsSingle(): float32;
    begin
      return self.AsSingle(float32(0.0));
    end;

    /// AsDouble's number as a float32 (past its range: an infinity).
    /// @param ADefault the result when the value gives none
    /// @returns the value, or ADefault
    const method AsSingle(const ADefault: float32): float32;
    begin
      return float32(self.AsDouble(float64(ADefault)));
    end;

    // The value as a whole number in AValue (AsInt64's rule); false when it gives none
    hidden const method DoWhole(var AValue: int64): bool;
    var
      LReal: float64;
    begin
      if self.Tree = nil then
        return false;
      end;
      if yyjson_mut_is_sint(self.Node) then
        AValue := yyjson_mut_get_sint(self.Node);
        return true;
      end;
      if yyjson_mut_is_uint(self.Node) then
        if yyjson_mut_get_uint(self.Node) > uint64(ADAM_JSON_INT64_MAX) then
          return false;
        end;
        AValue := int64(yyjson_mut_get_uint(self.Node));
        return true;
      end;
      if yyjson_mut_is_real(self.Node) then
        LReal := yyjson_mut_get_real(self.Node);
        // Inside int64's range (NaN fails both tests)
        if (LReal >= ADAM_JSON_INT64_LOW) and (LReal < ADAM_JSON_INT64_HIGH) then
          AValue := int64(LReal);
          return true;
        end;
        return false;
      end;
      if yyjson_mut_is_str(self.Node) then
        return TryStrToInt(DoStringOf(self.Node), AValue);
      end;
      return false;
    end;

    /// An array's items as strings (AsString each).
    /// @returns the strings; none for any other value
    const method AsStringArray(): StringArray;
    var
      LItems: array of JSON;
      LValues: StringArray;
      LI: int64;
    begin
      LItems := self.DoArrayItems();
      setlength(LValues, len(LItems));
      for LI := 0 to len(LItems) - 1 do
        LValues[LI] := LItems[LI].AsString("");
      end;
      return LValues;
    end;

    /// An array's items as int32 numbers (AsInt32 each).
    /// @returns the numbers; none for any other value
    const method AsInt32Array(): array of int32;
    var
      LItems: array of JSON;
      LValues: array of int32;
      LI: int64;
    begin
      LItems := self.DoArrayItems();
      setlength(LValues, len(LItems));
      for LI := 0 to len(LItems) - 1 do
        LValues[LI] := LItems[LI].AsInt32(0);
      end;
      return LValues;
    end;

    /// An array's items as int64 numbers (AsInt64 each).
    /// @returns the numbers; none for any other value
    const method AsInt64Array(): Int64Array;
    var
      LItems: array of JSON;
      LValues: Int64Array;
      LI: int64;
    begin
      LItems := self.DoArrayItems();
      setlength(LValues, len(LItems));
      for LI := 0 to len(LItems) - 1 do
        LValues[LI] := LItems[LI].AsInt64(0);
      end;
      return LValues;
    end;

    /// An array's items as float64 numbers (AsDouble each).
    /// @returns the numbers; none for any other value
    const method AsDoubleArray(): array of float64;
    var
      LItems: array of JSON;
      LValues: array of float64;
      LI: int64;
    begin
      LItems := self.DoArrayItems();
      setlength(LValues, len(LItems));
      for LI := 0 to len(LItems) - 1 do
        LValues[LI] := LItems[LI].AsDouble(0.0);
      end;
      return LValues;
    end;

    // Items, for an array only
    hidden const method DoArrayItems(): array of JSON;
    var
      LNone: array of JSON;
    begin
      if (self.Tree = nil) or not yyjson_mut_is_arr(self.Node) then
        setlength(LNone, 0);
        return LNone;
      end;
      return self.Items();
    end;

    // -- Kinds (a fresh value is an empty object; a missing one is null)

    /// Whether the value is null (a missing value is).
    /// @returns true for null
    const method IsNull(): bool;
    begin
      if self.Tree = nil then
        return self.Missing;
      end;
      return yyjson_mut_is_null(self.Node);
    end;

    /// Whether the value is an object (a fresh value is).
    /// @returns true for an object
    const method IsObject(): bool;
    begin
      if self.Tree = nil then
        return not self.Missing;
      end;
      return yyjson_mut_is_obj(self.Node);
    end;

    /// Whether the value is an array.
    /// @returns true for an array
    const method IsArray(): bool;
    begin
      return (self.Tree <> nil) and yyjson_mut_is_arr(self.Node);
    end;

    /// Whether the value is a number.
    /// @returns true for a number
    const method IsNumber(): bool;
    begin
      return (self.Tree <> nil) and yyjson_mut_is_num(self.Node);
    end;

    /// Whether the value is a string.
    /// @returns true for a string
    const method IsString(): bool;
    begin
      return (self.Tree <> nil) and yyjson_mut_is_str(self.Node);
    end;

    /// Whether the value is true or false.
    /// @returns true for a boolean
    const method IsBoolean(): bool;
    begin
      return (self.Tree <> nil) and yyjson_mut_is_bool(self.Node);
    end;

    // -- Walking and changing

    /// Calls a routine with each of Items.
    /// @param ACallback the routine
    /// @param AUserData the pointer it is given
    /// @returns this value, so calls chain
    method ForEach(const ACallback: JSONCallback; const AUserData: ptr): JSON;
    var
      LItems: array of JSON;
      LI: int64;
    begin
      LItems := self.Items();
      for LI := 0 to len(LItems) - 1 do
        ACallback(LItems[LI], AUserData);
      end;
      return self;
    end;

    /// Removes an object's members of a key.
    /// @param AKey the key
    /// @returns this value, so calls chain
    method Remove(const AKey: string): JSON;
    begin
      if (self.Tree <> nil) and yyjson_mut_is_obj(self.Node) then
        yyjson_mut_obj_remove_keyn(self.Node, DoChars(AKey), uint64(len(AKey)));
      end;
      return self;
    end;

    /// Copies another object's members in, each replacing this one's of its key (both objects).
    /// @param AOther the object copied from
    /// @returns this value, so calls chain
    method Merge(const AOther: JSON): JSON;
    var
      LIter: yyjson_mut_obj_iter;
      LKey: ptr to yyjson_mut_val;
    begin
      if (AOther.Tree = nil) or not yyjson_mut_is_obj(AOther.Node) then
        return self;
      end;
      if not self.DoEnsure() then
        return self;
      end;
      if not yyjson_mut_is_obj(self.Node) then
        return self;
      end;
      yyjson_mut_obj_iter_init(AOther.Node, addr of LIter);
      LKey := yyjson_mut_obj_iter_next(addr of LIter);
      while LKey <> nil do
        yyjson_mut_obj_put(self.Node, yyjson_mut_val_mut_copy(self.Tree.Doc, LKey),
          yyjson_mut_val_mut_copy(self.Tree.Doc, yyjson_mut_obj_iter_get_val(LKey)));
        LKey := yyjson_mut_obj_iter_next(addr of LIter);
      end;
      return self;
    end;

    /// The value copied into a tree of its own.
    /// @returns the copy (a missing value stays missing)
    const method Clone(): JSON;
    var
      LCopy: JSON;
      LTree: ref JSONTree;
    begin
      if self.Tree = nil then
        return self;
      end;
      LTree := ref JSONTree();
      LTree.Doc := yyjson_mut_doc_new(addr of GAlc);
      if LTree.Doc = nil then
        return self.DoFailed(ADAM_JSON_MSG_NO_ROOM);
      end;
      LCopy.Tree := LTree;
      LCopy.Node := yyjson_mut_val_mut_copy(LTree.Doc, self.Node);
      if LCopy.Node = nil then
        return self.DoFailed(ADAM_JSON_MSG_NO_ROOM);
      end;
      yyjson_mut_doc_set_root(LTree.Doc, LCopy.Node);
      return LCopy;
    end;
  end;

  /// An object's member as Pairs gives it: its key and a view of its value.
  JSONPair = object
    /// The member's key.
    NodeName: string;
    /// A view of the member's value.
    Value: JSON;
  end;

initialize
begin
  GAlc.malloc := DoAlcMalloc;
  GAlc.realloc := DoAlcRealloc;
  GAlc.free := DoAlcFree;
  GAlc.ctx := nil;
end;

end.
