// NTSTATUS: 0 = success
routine clink BCryptGenRandom(AAlgorithm: uint64; var ABuffer: ByteBuffer; ACount: uint32;
  AFlags: uint32): int32; external "bcrypt";

// Writes AText (UTF-8) into ABuffer as UTF-16 from AStart on and ends it with a NUL; ALength
// gets the units written, the NUL not counted. False when it does not fit (ADAM_WINDOWS_WIDE_MAX
// units in all, AStart included)
routine DoUtf8ToWideAt(const AText: string; var ABuffer: WideBuffer; const AStart: int32;
  var ALength: int32): bool;
var
  LIndex: int64;
  LCode: uint32;
  LAt: int32;
begin
  ALength := 0;
  ABuffer[AStart] := 0;
  LIndex := 0;
  LAt := AStart;
  while LIndex < len(AText) do
    LCode := DecodeUtf8Char(AText, LIndex);
    if LCode >= 0x10000 then
      // A surrogate pair
      if LAt + 2 > ADAM_WINDOWS_WIDE_MAX then
        return false;
      end;
      LCode := LCode - 0x10000;
      ABuffer[LAt] := uint16(0xD800 | (LCode shr 10));
      ABuffer[LAt + 1] := uint16(0xDC00 | (LCode & 0x3FF));
      LAt := LAt + 2;
    else
      if LAt + 1 > ADAM_WINDOWS_WIDE_MAX then
        return false;
      end;
      ABuffer[LAt] := uint16(LCode);
      LAt := LAt + 1;
    end;
  end;
  ABuffer[LAt] := 0;
  ALength := LAt - AStart;
  return true;
end;

// AText (UTF-8) into ABuffer as NUL-terminated UTF-16; malformed input becomes U+FFFD. False
// when it needs more than ADAM_WINDOWS_WIDE_MAX units
public routine Utf8ToWide(const AText: string; var ABuffer: WideBuffer): bool;
var
  LLength: int32;
begin
  return DoUtf8ToWideAt(AText, ABuffer, 0, LLength);
end;

// The UTF-8 text of ABuffer's first ALength units, or up to its NUL when that comes first; a
// lone surrogate becomes U+FFFD
public routine WideToUtf8(var ABuffer: WideBuffer; const ALength: int32): string;
var
  LText: string;
  LAt: int64;
  LI: int32;
  LUnit: uint32;
  LNext: uint32;
  LCode: uint32;
begin
  LText := "";
  // At most 3 bytes per unit: a pair (2 units) takes 4
  setlength(LText, int64(ALength) * 3);
  LAt := 0;
  LI := 0;
  while (LI < ALength) and (ABuffer[LI] <> 0) do
    LUnit := uint32(ABuffer[LI]);
    LI := LI + 1;
    LCode := LUnit;
    if (LUnit >= 0xD800) and (LUnit <= 0xDBFF) then
      // A high surrogate: a pair with the low one that follows, else alone
      LCode := ADAM_SYSUTILS_REPLACEMENT;
      if LI < ALength then
        LNext := uint32(ABuffer[LI]);
        if (LNext >= 0xDC00) and (LNext <= 0xDFFF) then
          LCode := 0x10000 + ((LUnit - 0xD800) shl 10) + (LNext - 0xDC00);
          LI := LI + 1;
        end;
      end;
    end;
    if (LUnit >= 0xDC00) and (LUnit <= 0xDFFF) then
      // A low surrogate with no high one before it
      LCode := ADAM_SYSUTILS_REPLACEMENT;
    end;
    EncodeUtf8Char(LText, LAt, LCode);
  end;
  setlength(LText, LAt);
  return LText;
end;

// AArg as one argument of a Windows command line, by the rules CommandLineToArgvW reads back
// (StdApp.Utils' QuoteCommandArg): as is when nothing in it splits or quotes (an empty one
// still needs ""), else quoted, each backslash run before a quote or the closing quote doubled
// and the quote itself escaped
public routine QuoteArg(const AArg: string): string;
var
  LNeeds: bool;
  LI: int64;
  LChar: char;
  LSlashes: int64;
  LText: string;
begin
  LNeeds := len(AArg) = 0;
  for LI := 0 to len(AArg) - 1 do
    LChar := AArg[LI];
    if (LChar = ' ') or (LChar = '\t') or (LChar = '\n') or (LChar = '\v') or (LChar = '"') then
      LNeeds := true;
    end;
  end;
  if not LNeeds then
    return AArg;
  end;
  LText := "\"";
  LSlashes := 0;
  for LI := 0 to len(AArg) - 1 do
    LChar := AArg[LI];
    if LChar = '\\' then
      // A run of backslashes counts only before a quote
      LSlashes := LSlashes + 1;
    else
      if LChar = '"' then
        LText := LText + StringOfChar('\\', LSlashes * 2 + 1) + "\"";
      else
        LText := LText + StringOfChar('\\', LSlashes) + LChar;
      end;
      LSlashes := 0;
    end;
  end;
  // The backslashes before the closing quote doubled, so it stays a quote
  LText := LText + StringOfChar('\\', LSlashes * 2) + "\"";
  return LText;
end;

// True for a path separator ('/' or '\')
routine DoIsSeparator(const AChar: char): bool;
begin
  return (AChar = '/') or (AChar = '\\');
end;

// AText with every AFrom byte replaced by ATo (the separators are ASCII: UTF-8 text is never cut)
routine DoReplaceChar(const AText: string; const AFrom: char; const ATo: char): string;
var
  LText: string;
  LI: int64;
begin
  LText := AText;
  for LI := 0 to len(LText) - 1 do
    if LText[LI] = AFrom then
      LText[LI] := ATo;
    end;
  end;
  return LText;
end;

// True when AText starts with the prefix "$<ALetter>:", the letter (upper case) in either case
routine DoHasPrefix(const AText: string; const ALetter: char): bool;
var
  LLetter: uint8;
begin
  if len(AText) < 3 then
    return false;
  end;
  LLetter := uint8(AText[1]);
  if (LLetter >= 0x61) and (LLetter <= 0x7A) then
    LLetter := uint8(LLetter - 0x20);
  end;
  return (AText[0] = '$') and (LLetter = uint8(ALetter)) and (AText[2] = ':');
end;

// The long-path spelling in either slash (\\?\..., //?/..., or a mix)
routine DoIsLongForm(const APath: string): bool;
begin
  if len(APath) < 4 then
    return false;
  end;
  return DoIsSeparator(APath[0]) and DoIsSeparator(APath[1]) and (APath[2] = '?') and
    DoIsSeparator(APath[3]);
end;

// True when APath is rooted: a separator first, or a drive letter and ':'
routine DoIsRooted(const APath: string): bool;
begin
  if (len(APath) > 0) and DoIsSeparator(APath[0]) then
    return true;
  end;
  return (len(APath) >= 2) and (APath[1] = ':');
end;

// The UTF-16 units AText (UTF-8) takes: 2 for a code point past U+FFFF, else 1
routine DoWideLength(const AText: string): int64;
var
  LIndex: int64;
  LCount: int64;
begin
  LIndex := 0;
  LCount := 0;
  while LIndex < len(AText) do
    if DecodeUtf8Char(AText, LIndex) >= 0x10000 then
      LCount := LCount + 2;
    else
      LCount := LCount + 1;
    end;
  end;
  return LCount;
end;

// Win32's own full-path rule (GetFullPathNameW: '.' and '..' folded, repeated separators
// joined, no disk access, symlinks not followed); APath as it is when Win32 cannot make it full
routine DoFullPath(const APath: string): string;
var
  LInput: own WideBox;
  LFull: own WideBox;
  LLength: int32;
  LResult: uint32;
begin
  LInput := own WideBox();
  LFull := own WideBox();
  if not DoUtf8ToWideAt(APath, LInput.Data, 0, LLength) then
    return APath;
  end;
  LResult := GetFullPathNameW(LInput.Data, uint32(ADAM_WINDOWS_WIDE_MAX + 1), LFull.Data, nil);
  // 0 = it failed; more than the buffer holds = the size it would need
  if (LResult = 0) or (LResult > uint32(ADAM_WINDOWS_WIDE_MAX)) then
    return APath;
  end;
  return WideToUtf8(LFull.Data, int32(LResult));
end;

// The one output form of a full path: up to ADAM_WINDOWS_SHORT_PATH_MAX UTF-16 units the
// forward-slash spelling, past it the long-path spelling (backslashes, \\?\UNC\ for a share, a
// device path \\.\ as is). A path already in long form keeps it. Idempotent on both
routine DoFinish(const AFull: string): string;
var
  LPath: string;
begin
  if DoIsLongForm(AFull) then
    return DoReplaceChar(AFull, '/', '\\');
  end;
  if DoWideLength(AFull) <= ADAM_WINDOWS_SHORT_PATH_MAX then
    return DoReplaceChar(AFull, '\\', '/');
  end;
  LPath := DoReplaceChar(AFull, '/', '\\');
  if StartsStr("\\\\.\\", LPath) then
    return LPath;
  end;
  if StartsStr("\\\\", LPath) then
    return "\\\\?\\UNC\\" + Substring(LPath, 2, len(LPath) - 2);
  end;
  return "\\\\?\\" + LPath;
end;

// APath under ABase, one separator between them
routine DoCombine(const ABase: string; const APath: string): string;
begin
  if (len(ABase) > 0) and DoIsSeparator(ABase[len(ABase) - 1]) then
    return ABase + APath;
  end;
  return ABase + "\\" + APath;
end;

// The current working directory as Win32 spells it; "" when it cannot be read
routine DoCurrentDir(): string;
var
  LBuffer: own WideBox;
  LLength: uint32;
begin
  LBuffer := own WideBox();
  LLength := GetCurrentDirectoryW(uint32(ADAM_WINDOWS_WIDE_MAX + 1), LBuffer.Data);
  // 0 = it failed; more than the buffer holds = the size it would need
  if (LLength = 0) or (LLength > uint32(ADAM_WINDOWS_WIDE_MAX)) then
    return "";
  end;
  return WideToUtf8(LBuffer.Data, int32(LLength));
end;

// The folder of this process's exe file as Win32 spells it, asked of the OS (never argv[0]),
// with no trailing separator except at a root (C:\); "" when it cannot be read
routine DoExeFolder(): string;
var
  LBuffer: own WideBox;
  LSize: uint32;
  LLength: uint32;
  LFile: string;
  LSep: int64;
  LI: int64;
begin
  LBuffer := own WideBox();
  LSize := uint32(ADAM_WINDOWS_WIDE_MAX + 1);
  LLength := GetModuleFileNameW(0, LBuffer.Data, LSize);
  // 0 = it failed; the whole buffer = the path was cut short
  if (LLength = 0) or (LLength >= LSize) then
    return "";
  end;
  LFile := WideToUtf8(LBuffer.Data, int32(LLength));
  // A process started through the long-path spelling gets its module path back in it
  // (\\?\C:\...): a drive path short enough for the plain spelling is given in that, so a
  // $P: path takes WinResolvePath's one form however the program was started
  if DoIsLongForm(LFile) and (len(LFile) > 6) and (LFile[5] = ':') and
    (DoWideLength(LFile) - 4 <= ADAM_WINDOWS_SHORT_PATH_MAX) then
    LFile := Substring(LFile, 4, len(LFile) - 4);
  end;
  LSep := -1;
  for LI := 0 to len(LFile) - 1 do
    if DoIsSeparator(LFile[LI]) then
      LSep := LI;
    end;
  end;
  if LSep < 0 then
    return "";
  end;
  if (LSep = 2) and (LFile[1] = ':') then
    return Substring(LFile, 0, 3);
  end;
  return Substring(LFile, 0, LSep);
end;

// Resolves APath to one full, normalized path against ABaseDir (PaskalCPP's WinResolvePath rule).
// A prefix at the very start, in either case, names the base: $P: the folder of this program's
// exe (asked of the OS), $D: the current working directory, $S: ABaseDir (the same as none).
// $R: (the project root) is a build-time prefix of the compiler only: it gives "". A rooted path
// is only normalized; any other is resolved against its base (ABaseDir "" = the current working
// directory). '.' and '..' are folded and repeated separators joined, as text: the disk is never
// touched. Leading and trailing blanks are trimmed. The result uses '/' up to
// ADAM_WINDOWS_SHORT_PATH_MAX UTF-16 units and the long-path spelling past it (\\?\C:\...,
// \\?\UNC\server\share\...), so every file routine takes it at any length; resolving a result
// again gives it back unchanged. "" for an empty path, only a prefix, or a $R: path
public routine WinResolvePath(const APath: string; const ABaseDir: string): string;
var
  LPath: string;
  LBase: string;
  LExeBase: bool;
  LCurrentBase: bool;
begin
  LPath := Trim(APath);
  if LPath = "" then
    return "";
  end;
  if DoHasPrefix(LPath, 'R') then
    return "";
  end;

  // An explicit prefix, at the very start only, overrides the caller's base
  LExeBase := DoHasPrefix(LPath, 'P');
  LCurrentBase := DoHasPrefix(LPath, 'D');
  if LExeBase or LCurrentBase or DoHasPrefix(LPath, 'S') then
    LPath := Trim(Substring(LPath, 3, len(LPath) - 3));
  end;
  if LPath = "" then
    return "";
  end;
  LBase := ABaseDir;
  if LExeBase then
    LBase := DoExeFolder();
  end;
  if LCurrentBase then
    LBase := DoCurrentDir();
  end;

  // The long-path spelling takes backslashes only: one typed with '/' is the same path
  if DoIsLongForm(LPath) then
    LPath := DoReplaceChar(LPath, '/', '\\');
  end;
  if DoIsLongForm(LBase) then
    LBase := DoReplaceChar(LBase, '/', '\\');
  end;
  if not DoIsRooted(LPath) then
    if LBase = "" then
      LBase := DoCurrentDir();
    end;
    LPath := DoCombine(LBase, LPath);
  end;
  return DoFinish(DoFullPath(LPath));
end;

// Resolves APath against the current working directory; see WinResolvePath(APath, ABaseDir) for
// the prefixes and the result's form
public routine WinResolvePath(const APath: string): string;
begin
  return WinResolvePath(APath, "");
end;

// True when AFirst and ASecond (each resolved against the current working directory) name
// the same path as Windows tells paths apart: without case, as the file system does
// (CompareStringOrdinal, ignoring case). False when either resolves to "" or does not fit
public routine WinSamePath(const AFirst: string; const ASecond: string): bool;
var
  LFirst: own WideBox;
  LSecond: own WideBox;
  LFirstCount: int32;
  LSecondCount: int32;
  LFirstPath: string;
  LSecondPath: string;
begin
  LFirst := own WideBox();
  LSecond := own WideBox();
  LFirstPath := WinResolvePath(AFirst);
  LSecondPath := WinResolvePath(ASecond);
  if (LFirstPath = "") or (LSecondPath = "") then
    return false;
  end;
  if not DoUtf8ToWideAt(LFirstPath, LFirst.Data, 0, LFirstCount) then
    return false;
  end;
  if not DoUtf8ToWideAt(LSecondPath, LSecond.Data, 0, LSecondCount) then
    return false;
  end;
  return CompareStringOrdinal(LFirst.Data, LFirstCount, LSecond.Data, LSecondCount, 1) =
    CSTR_EQUAL;
end;

// Puts the long-path prefix into ABuffer at AAt: "\\?\" or, for a UNC path, "\\?\UNC\"
routine DoPutLongPrefix(var ABuffer: WideBuffer; var AAt: int32; const AUnc: bool);
begin
  ABuffer[0] := 0x5C;
  ABuffer[1] := 0x5C;
  ABuffer[2] := 0x3F;
  ABuffer[3] := 0x5C;
  AAt := 4;
  if AUnc then
    ABuffer[4] := 0x55;
    ABuffer[5] := 0x4E;
    ABuffer[6] := 0x43;
    ABuffer[7] := 0x5C;
    AAt := 8;
  end;
end;

// APath as the file API takes it in ABuffer: resolved (WinResolvePath), backslashes, with the
// long-path prefix (X:\... -> \\?\X:\..., \\server\share -> \\?\UNC\server\share; a path
// already \\?\ or \\.\ stays as it is). False when it resolves to "" or does not fit
routine DoFilePath(const APath: string; var ABuffer: WideBuffer): bool;
var
  LPath: string;
  LAt: int32;
  LLength: int32;
begin
  ABuffer[0] := 0;
  LPath := DoReplaceChar(WinResolvePath(APath), '/', '\\');
  if LPath = "" then
    return false;
  end;
  if StartsStr("\\\\?\\", LPath) or StartsStr("\\\\.\\", LPath) then
    return DoUtf8ToWideAt(LPath, ABuffer, 0, LLength);
  end;
  if StartsStr("\\\\", LPath) then
    // A UNC path: its leading "\\" is replaced by "\\?\UNC\"
    DoPutLongPrefix(ABuffer, LAt, true);
    return DoUtf8ToWideAt(Substring(LPath, 2, len(LPath) - 2), ABuffer, LAt, LLength);
  end;
  DoPutLongPrefix(ABuffer, LAt, false);
  return DoUtf8ToWideAt(LPath, ABuffer, LAt, LLength);
end;

// The folder that holds this program's exe file, in the form WinResolvePath returns, with no
// trailing separator (except at a root). Asked of the OS, so it is right however the program
// was started; "" when the OS cannot tell
public routine ExeDir(): string;
var
  LDir: string;
begin
  LDir := DoExeFolder();
  if LDir = "" then
    return "";
  end;
  return DoFinish(LDir);
end;

// The system's folder for temporary files (GetTempPathW: TMP, TEMP, USERPROFILE or the Windows
// folder), in the form WinResolvePath returns, with no trailing separator (except at a root); ""
// when the system names none
public routine TempDir(): string;
var
  LBuffer: own WideBox;
  LLength: uint32;
  LDir: string;
  LCount: int64;
begin
  LBuffer := own WideBox();
  LLength := GetTempPathW(uint32(ADAM_WINDOWS_WIDE_MAX + 1), LBuffer.Data);
  if (LLength = 0) or (LLength > uint32(ADAM_WINDOWS_WIDE_MAX)) then
    return "";
  end;
  LDir := WideToUtf8(LBuffer.Data, int32(LLength));
  // GetTempPathW ends in a separator; a root (C:\) keeps its own
  LCount := len(LDir);
  while (LCount > 1) and DoIsSeparator(LDir[LCount - 1]) do
    if (LCount = 3) and (LDir[1] = ':') then
      leave;
    end;
    LCount := LCount - 1;
  end;
  LDir := Substring(LDir, 0, LCount);
  if LDir = "" then
    return "";
  end;
  return WinResolvePath(LDir);
end;

// The system folder (GetSystemDirectoryW: where Windows keeps its DLLs, C:\Windows\System32 on
// most systems), in the form WinResolvePath returns, with no trailing separator (except at a
// root); "" when the system names none
public routine WinSystemDir(): string;
var
  LBuffer: own WideBox;
  LLength: uint32;
begin
  LBuffer := own WideBox();
  LLength := GetSystemDirectoryW(LBuffer.Data, uint32(ADAM_WINDOWS_WIDE_MAX + 1));
  // 0 is a failure; a length past the buffer is the size it would need
  if (LLength = 0) or (LLength > uint32(ADAM_WINDOWS_WIDE_MAX)) then
    return "";
  end;
  return WinResolvePath(WideToUtf8(LBuffer.Data, int32(LLength)));
end;

// APath's file attributes, or INVALID_FILE_ATTRIBUTES when it does not exist or cannot
// be read
routine DoAttributes(const APath: string): uint32;
var
  LBuffer: own WideBox;
begin
  LBuffer := own WideBox();
  if not DoFilePath(APath, LBuffer.Data) then
    return INVALID_FILE_ATTRIBUTES;
  end;
  return GetFileAttributesW(LBuffer.Data);
end;

// True when APath names an existing file (not a folder); false for a folder, a missing path, ""
// or a path the OS cannot read. The path goes through WinResolvePath first
public routine WinFileExists(const APath: string): bool;
var
  LAttributes: uint32;
begin
  LAttributes := DoAttributes(APath);
  if LAttributes = INVALID_FILE_ATTRIBUTES then
    return false;
  end;
  return (LAttributes & FILE_ATTRIBUTE_DIRECTORY) = 0;
end;

// True when APath names an existing folder. The path goes through WinResolvePath first
public routine WinDirectoryExists(const APath: string): bool;
var
  LAttributes: uint32;
begin
  LAttributes := DoAttributes(APath);
  if LAttributes = INVALID_FILE_ATTRIBUTES then
    return false;
  end;
  return (LAttributes & FILE_ATTRIBUTE_DIRECTORY) <> 0;
end;

// Deletes a file, as Delphi's WinDeleteFile: a folder is never removed by it. True when the file
// was deleted; false for a folder, a missing path or one the OS refuses (a file open elsewhere)
public routine WinDeleteFile(const APath: string): bool;
var
  LBuffer: own WideBox;
begin
  LBuffer := own WideBox();
  if not WinFileExists(APath) then
    return false;
  end;
  if not DoFilePath(APath, LBuffer.Data) then
    return false;
  end;
  return DeleteFileW(LBuffer.Data) <> 0;
end;

// Creates one folder, as Delphi's WinCreateDir: its parent must exist already (nothing above it is
// made). True when the folder was made; false when something of that name exists already (a
// folder or a file), its parent is missing, or the OS refuses it
public routine WinCreateDir(const APath: string): bool;
var
  LBuffer: own WideBox;
begin
  LBuffer := own WideBox();
  if not DoFilePath(APath, LBuffer.Data) then
    return false;
  end;
  return CreateDirectoryW(LBuffer.Data, nil) <> 0;
end;

// Removes an empty folder, as Delphi's RemoveDir: a folder that holds anything is left as it
// is. True when it was removed; false when it is not empty, is a file, is missing, or the OS
// refuses it
public routine RemoveDir(const APath: string): bool;
var
  LBuffer: own WideBox;
begin
  LBuffer := own WideBox();
  if not WinDirectoryExists(APath) then
    return false;
  end;
  if not DoFilePath(APath, LBuffer.Data) then
    return false;
  end;
  return RemoveDirectoryW(LBuffer.Data) <> 0;
end;

// The folder above APath (a resolved path): the text before its last separator, a drive root
// keeping its separator (C:/a -> C:/); "" when there is none
routine DoParentDir(const APath: string): string;
var
  LCount: int64;
  LSep: int64;
  LI: int64;
  LParent: string;
begin
  LCount := len(APath);
  while (LCount > 0) and DoIsSeparator(APath[LCount - 1]) do
    LCount := LCount - 1;
  end;
  LSep := -1;
  for LI := 0 to LCount - 1 do
    if DoIsSeparator(APath[LI]) then
      LSep := LI;
    end;
  end;
  if LSep <= 0 then
    return "";
  end;
  LParent := Substring(APath, 0, LSep);
  if (len(LParent) > 0) and (LParent[len(LParent) - 1] = ':') then
    LParent := LParent + APath[LSep];
  end;
  return LParent;
end;

// Creates a folder and every missing folder above it, as Delphi's WinForceDirectories. A folder
// already there is a success. True when the path is a folder afterwards; false when a file is in
// the way, the path is "" or the OS refuses it. A loop, never a recursion, so a deep path
// takes no stack
public routine WinForceDirectories(const APath: string): bool;
var
  LPath: string;
  LParent: string;
  LMissing: array of string;
  LCount: int64;
  LI: int64;
  LBuffer: own WideBox;
begin
  LBuffer := own WideBox();
  LPath := WinResolvePath(APath);
  if LPath = "" then
    return false;
  end;
  if WinDirectoryExists(LPath) then
    return true;
  end;
  if WinFileExists(LPath) then
    return false;
  end;
  // The missing folders, the deepest first. Each step up is shorter than the one before:
  // the walk ends at the root
  setlength(LMissing, 1);
  LMissing[0] := LPath;
  LCount := 1;
  LParent := DoParentDir(LPath);
  while (LParent <> "") and (len(LParent) < len(LMissing[LCount - 1])) and
    (not WinDirectoryExists(LParent)) do
    setlength(LMissing, LCount + 1);
    LMissing[LCount] := LParent;
    LCount := LCount + 1;
    LParent := DoParentDir(LParent);
  end;
  // Made from the top down; a file in the way, or a refusal, stops the walk
  for LI := LCount - 1 downto 0 do
    if DoFilePath(LMissing[LI], LBuffer.Data) then
      // A folder another program made meanwhile is still a success: the check below decides
      CreateDirectoryW(LBuffer.Data, nil);
    end;
    if not WinDirectoryExists(LMissing[LI]) then
      return false;
    end;
  end;
  return true;
end;

// Gives a file a new name or moves it, as Delphi's RenameFile: something at the new name is
// never replaced (delete it first). True when the file was renamed; false when AOldPath is not
// a file, ANewPath exists already, its folder is missing or the OS refuses it (a move to another
// drive is refused)
public routine RenameFile(const AOldPath: string; const ANewPath: string): bool;
var
  LOld: own WideBox;
  LNew: own WideBox;
begin
  LOld := own WideBox();
  LNew := own WideBox();
  if not WinFileExists(AOldPath) then
    return false;
  end;
  if WinFileExists(ANewPath) or WinDirectoryExists(ANewPath) then
    return false;
  end;
  if not DoFilePath(AOldPath, LOld.Data) then
    return false;
  end;
  if not DoFilePath(ANewPath, LNew.Data) then
    return false;
  end;
  // No flags: an existing target is refused, never replaced
  return MoveFileExW(LOld.Data, LNew.Data, 0) <> 0;
end;

// Puts the file ASourcePath in ATargetPath's place in one step: a file already there is
// replaced, never left half written (write a temporary file, then WinReplaceFile it into place).
// True when the file is at ATargetPath afterwards; false when ASourcePath is not a file,
// ATargetPath is a folder, its folder is missing or the OS refuses it (another drive, a target
// open elsewhere)
public routine WinReplaceFile(const ASourcePath: string; const ATargetPath: string): bool;
var
  LSource: own WideBox;
  LTarget: own WideBox;
begin
  LSource := own WideBox();
  LTarget := own WideBox();
  if not WinFileExists(ASourcePath) then
    return false;
  end;
  if WinDirectoryExists(ATargetPath) then
    return false;
  end;
  if not DoFilePath(ASourcePath, LSource.Data) then
    return false;
  end;
  if not DoFilePath(ATargetPath, LTarget.Data) then
    return false;
  end;
  return MoveFileExW(LSource.Data, LTarget.Data, MOVEFILE_REPLACE_EXISTING |
    MOVEFILE_WRITE_THROUGH) <> 0;
end;

// Marks the file APath read-only (AReadOnly) or writable again: a read-only file is never
// replaced, renamed over or deleted until it is writable. Its other attributes are kept. True
// when the file has the asked state afterwards; false for a folder, a missing path or one the
// OS refuses
public routine SetFileReadOnly(const APath: string; const AReadOnly: bool): bool;
var
  LBuffer: own WideBox;
  LAttributes: uint32;
begin
  LBuffer := own WideBox();
  if not WinFileExists(APath) then
    return false;
  end;
  LAttributes := DoAttributes(APath);
  if AReadOnly then
    LAttributes := LAttributes | FILE_ATTRIBUTE_READONLY;
  else
    LAttributes := LAttributes & ~FILE_ATTRIBUTE_READONLY;
  end;
  if not DoFilePath(APath, LBuffer.Data) then
    return false;
  end;
  return SetFileAttributesW(LBuffer.Data, LAttributes) <> 0;
end;

// The value of this process's environment variable AName; "" when it is not set (or set to
// "") or AName is ""
public routine GetEnvironmentVariable(const AName: string): string;
var
  LName: own WideBox;
  LValue: own WideBox;
  LLength: uint32;
begin
  LName := own WideBox();
  LValue := own WideBox();
  if (AName = "") or not Utf8ToWide(AName, LName.Data) then
    return "";
  end;
  LLength := GetEnvironmentVariableW(LName.Data, LValue.Data, uint32(ADAM_WINDOWS_WIDE_MAX + 1));
  // 0 = not set (or empty); more than the buffer holds = the size it would need
  if (LLength = 0) or (LLength > uint32(ADAM_WINDOWS_WIDE_MAX)) then
    return "";
  end;
  return WideToUtf8(LValue.Data, int32(LLength));
end;

// Sets this process's environment variable AName to AValue (a process it starts inherits
// it); AValue "" leaves it empty, which GetEnvironmentVariable reads as not set. True when
// the variable has the asked value afterwards
public routine SetEnvironmentVariable(const AName: string; const AValue: string): bool;
var
  LName: own WideBox;
  LValue: own WideBox;
begin
  LName := own WideBox();
  LValue := own WideBox();
  if (AName = "") or not Utf8ToWide(AName, LName.Data) then
    return false;
  end;
  if not Utf8ToWide(AValue, LValue.Data) then
    return false;
  end;
  return SetEnvironmentVariableW(LName.Data, LValue.Data) <> 0;
end;

// This user's folder for caches a program may drop and make again (Windows: the local
// application data folder, %LOCALAPPDATA%), resolved; "" when the OS does not name one. A
// program keeps its own folder below it (<WinUserCacheDir>\<Program>\)
public routine WinUserCacheDir(): string;
var
  LDir: string;
begin
  LDir := GetEnvironmentVariable(ADAM_WINDOWS_ENV_LOCAL_APP_DATA);
  if LDir = "" then
    return "";
  end;
  return WinResolvePath(LDir);
end;

// The size of a file in bytes, read from the file system without opening it; -1 when it is a
// folder, is missing or the OS refuses it
public routine WinFileSize(const APath: string): int64;
var
  LBuffer: own WideBox;
  LData: WIN32_FILE_ATTRIBUTE_DATA;
begin
  LBuffer := own WideBox();
  if not DoFilePath(APath, LBuffer.Data) then
    return -1;
  end;
  if GetFileAttributesExW(LBuffer.Data, GetFileExInfoStandard, LData) = 0 then
    return -1;
  end;
  if (LData.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) <> 0 then
    return -1;
  end;
  return int64((uint64(LData.nFileSizeHigh) shl 32) | uint64(LData.nFileSizeLow));
end;

// When a file was last written, as the file system keeps it (Windows: FILETIME's 100 ns ticks
// since 1601-01-01 UTC), read without opening it: a value to compare with an earlier one,
// never a clock time; -1 when it is a folder, is missing or the OS refuses it
public routine WinFileWriteTime(const APath: string): int64;
var
  LBuffer: own WideBox;
  LData: WIN32_FILE_ATTRIBUTE_DATA;
begin
  LBuffer := own WideBox();
  if not DoFilePath(APath, LBuffer.Data) then
    return -1;
  end;
  if GetFileAttributesExW(LBuffer.Data, GetFileExInfoStandard, LData) = 0 then
    return -1;
  end;
  if (LData.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) <> 0 then
    return -1;
  end;
  return int64((uint64(LData.ftLastWriteTime.dwHighDateTime) shl 32) |
    uint64(LData.ftLastWriteTime.dwLowDateTime));
end;

// Opens APath with AAccess / AShare / ADisposition; INVALID_HANDLE_VALUE when it cannot.
// The handle is never inherited by a child process
routine DoOpenFile(const APath: string; const AAccess: uint32; const AShare: uint32;
  const ADisposition: uint32): uint64;
var
  LBuffer: own WideBox;
  LAttributes: SECURITY_ATTRIBUTES;
begin
  LBuffer := own WideBox();
  if not DoFilePath(APath, LBuffer.Data) then
    return INVALID_HANDLE_VALUE;
  end;
  LAttributes.nLength := uint32(size(SECURITY_ATTRIBUTES));
  LAttributes.lpSecurityDescriptor := nil;
  LAttributes.bInheritHandle := 0;
  return CreateFileW(LBuffer.Data, AAccess, AShare, LAttributes, ADisposition,
    FILE_ATTRIBUTE_NORMAL, 0);
end;

// The whole-file routines below (WinReadAllText .. WinWriteAllText) name no OS: they open, size,
// read and write through System.Runtime's file handles (its platform unit holds the OS
// calls), so they hold as they are on every target. A file is sized first and read straight
// into its one block (no chunk buffer, no byte-by-byte copy), as Delphi's TFile.ReadAllBytes
// and TFileStream.ReadBuffer do

// The file APath (WinResolvePath's prefixes taken) opened as AHandle in AMode (System.Runtime's
// ADAM_FILE_*); false (AHandle 0) when it resolves to "" or cannot be opened so
routine DoOpenHandle(const APath: string; const AMode: int32; var AHandle: uint64): bool;
var
  LPath: string;
  LText: ptr to char;
  LOpened: bool;
begin
  AHandle := 0;
  LPath := WinResolvePath(APath);
  if LPath = "" then
    return false;
  end;
  LText := StringToC(LPath);
  if LText = nil then
    return false;
  end;
  LOpened := OpenFileHandle(LText, AMode, AHandle);
  freemem(LText);
  return LOpened;
end;

// Up to ACount bytes of the open file AHandle read into ABuffer, a short read read again:
// the bytes read (fewer than ACount when the file ends first), -1 when a read fails
routine DoReadInto(const AHandle: uint64; const ABuffer: ptr; const ACount: int64): int64;
var
  LDone: int64;
  LGot: int64;
begin
  LDone := 0;
  while LDone < ACount do
    LGot := ReadFileHandle(AHandle, ptr(uint64(ABuffer) + uint64(LDone)), ACount - LDone);
    if LGot < 0 then
      return -1;
    end;
    // A file's end is a read that succeeds with no bytes (it shrank since it was sized)
    if LGot = 0 then
      leave;
    end;
    LDone := LDone + LGot;
  end;
  return LDone;
end;

// ACount bytes at ABuffer written to the open file AHandle, a short write written again;
// false when a write fails or writes nothing
routine DoWriteFrom(const AHandle: uint64; const ABuffer: ptr; const ACount: int64): bool;
var
  LDone: int64;
  LPut: int64;
begin
  LDone := 0;
  while LDone < ACount do
    LPut := WriteFileHandle(AHandle, ptr(uint64(ABuffer) + uint64(LDone)), ACount - LDone);
    if LPut <= 0 then
      return false;
    end;
    LDone := LDone + LPut;
  end;
  return true;
end;

// Reads a whole file into AText, its bytes as they are (no newline or code page conversion).
// False when it is a folder, is missing, or cannot be opened or read (AText then "")
public routine WinReadAllText(const APath: string; var AText: string): bool;
var
  LFile: uint64;
  LText: string;
  LSize: int64;
  LCount: int64;
begin
  AText := "";
  if not DoOpenHandle(APath, ADAM_FILE_READ, LFile) then
    return false;
  end;
  LText := "";
  LSize := 0;
  LCount := 0;
  guard
    LSize := FileHandleSize(LFile);
    if LSize > 0 then
      // Sized from empty: a block of its own, read into in place
      setlength(LText, LSize);
      LCount := DoReadInto(LFile, ptr(addr of LText[0]), LSize);
    end;
  finally
    CloseFileHandle(LFile);
  end;
  if (LSize < 0) or (LCount < 0) then
    return false;
  end;
  if LCount < LSize then
    setlength(LText, LCount);
  end;
  AText := LText;
  return true;
end;

// Reads a whole file into ABytes, its bytes as they are. False when it is a folder, is missing,
// or cannot be opened or read (ABytes then empty)
public routine WinReadAllBytes(const APath: string; var ABytes: ByteArray): bool;
var
  LFile: uint64;
  LBytes: ByteArray;
  LSize: int64;
  LCount: int64;
begin
  setlength(ABytes, 0);
  if not DoOpenHandle(APath, ADAM_FILE_READ, LFile) then
    return false;
  end;
  setlength(LBytes, 0);
  LSize := 0;
  LCount := 0;
  guard
    LSize := FileHandleSize(LFile);
    if LSize > 0 then
      // Sized from empty: a block of its own, read into in place
      setlength(LBytes, LSize);
      LCount := DoReadInto(LFile, ptr(addr of LBytes[0]), LSize);
    end;
  finally
    CloseFileHandle(LFile);
  end;
  if (LSize < 0) or (LCount < 0) then
    return false;
  end;
  if LCount < LSize then
    setlength(LBytes, LCount);
  end;
  ABytes := LBytes;
  return true;
end;

// Writes the bytes of ABytes as the whole file: a file there is replaced, a missing one is made
// in a folder that exists. False when the path is a folder, its folder is missing, or it cannot
// be fully written
public routine WinWriteAllBytes(const APath: string; const ABytes: ByteArray): bool;
var
  LFile: uint64;
  LOk: bool;
begin
  if not DoOpenHandle(APath, ADAM_FILE_WRITE, LFile) then
    return false;
  end;
  LOk := true;
  guard
    if len(ABytes) > 0 then
      LOk := DoWriteFrom(LFile, ptr(addr of ABytes[0]), len(ABytes));
    end;
  finally
    CloseFileHandle(LFile);
  end;
  return LOk;
end;

// Writes AText as the whole file, its bytes as they are (no BOM; line ends as the caller wrote
// them), straight from AText: the same replacing, the same failures as WinWriteAllBytes
public routine WinWriteAllText(const APath: string; const AText: string): bool;
var
  LFile: uint64;
  LOk: bool;
begin
  if not DoOpenHandle(APath, ADAM_FILE_WRITE, LFile) then
    return false;
  end;
  LOk := true;
  guard
    if len(AText) > 0 then
      LOk := DoWriteFrom(LFile, ptr(addr of AText[0]), len(AText));
    end;
  finally
    CloseFileHandle(LFile);
  end;
  return LOk;
end;

// ACount bytes from the system's secure random generator (BCryptGenRandom, the system-preferred
// RNG) as ABytes; false when the generator fails (ABytes is then empty)
public routine WinSecureRandomBytes(const ACount: int64; var ABytes: ByteArray): bool;
var
  LBuffer: ByteBuffer;
  LFrom: int64;
  LCount: int64;
  LI: int64;
begin
  setlength(ABytes, ACount);
  LFrom := 0;
  while LFrom < ACount do
    // The next chunk, at most one buffer
    LCount := ACount - LFrom;
    if LCount > int64(ADAM_WINDOWS_IO_SIZE) then
      LCount := int64(ADAM_WINDOWS_IO_SIZE);
    end;
    if BCryptGenRandom(0, LBuffer, uint32(LCount), BCRYPT_USE_SYSTEM_PREFERRED_RNG) <> 0 then
      setlength(ABytes, 0);
      return false;
    end;
    for LI := 0 to LCount - 1 do
      ABytes[LFrom + LI] := LBuffer[LI];
    end;
    LFrom := LFrom + LCount;
  end;
  return true;
end;

// The file name AData holds, as UTF-8
routine DoFindName(var AData: WIN32_FIND_DATAW): string;
var
  LWide: own WideBox;
  LI: int32;
begin
  LWide := own WideBox();
  LI := 0;
  while (LI < 260) and (AData.cFileName[LI] <> 0) do
    LWide.Data[LI] := AData.cFileName[LI];
    LI := LI + 1;
  end;
  return WideToUtf8(LWide.Data, LI);
end;

// ADir without its trailing separators (a drive root keeps none either: "C:" + "\*" is "C:\*")
routine DoTrimSeparators(const ADir: string): string;
var
  LLength: int64;
begin
  LLength := len(ADir);
  while (LLength > 0) and DoIsSeparator(ADir[LLength - 1]) do
    LLength := LLength - 1;
  end;
  return Substring(ADir, 0, LLength);
end;

// The names of ADir's entries that are folders (AWantDirectories) or files (not), sorted by
// SortStrings, "." and ".." left out. False when the folder cannot be read; an empty folder is
// true with an empty list
routine DoList(const ADir: string; const AWantDirectories: bool; var AList: StringArray): bool;
var
  LBuffer: own WideBox;
  LData: WIN32_FIND_DATAW;
  LFind: uint64;
  LName: string;
  LIsDirectory: bool;
  LCount: int64;
  LOk: bool;
begin
  LBuffer := own WideBox();
  setlength(AList, 0);
  if not DoFilePath(DoTrimSeparators(ADir) + "\\*", LBuffer.Data) then
    return false;
  end;
  LFind := FindFirstFileW(LBuffer.Data, LData);
  if LFind = INVALID_HANDLE_VALUE then
    // A drive root has no "." entry: nothing matched is an empty folder there
    return GetLastError() = ERROR_FILE_NOT_FOUND;
  end;
  LCount := 0;
  LOk := true;
  guard
    repeat
      LName := DoFindName(LData);
      LIsDirectory := (LData.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) <> 0;
      if (LName <> ".") and (LName <> "..") and (LIsDirectory = AWantDirectories) then
        setlength(AList, LCount + 1);
        AList[LCount] := LName;
        LCount := LCount + 1;
      end;
    until FindNextFileW(LFind, LData) = 0;
    // The listing ends at "no more files"; any other failure cut it short
    LOk := GetLastError() = ERROR_NO_MORE_FILES;
  finally
    FindClose(LFind);
  end;
  if not LOk then
    setlength(AList, 0);
    return false;
  end;
  SortStrings(AList);
  return true;
end;

// The names of the files in ADir (no folders), sorted by their bytes. False when the folder
// cannot be read. The path goes through WinResolvePath first
public routine WinGetFiles(const ADir: string; var AList: StringArray): bool;
begin
  return DoList(ADir, false, AList);
end;

// The names of the folders in ADir ("." and ".." left out), sorted by their bytes. False when
// the folder cannot be read. The path goes through WinResolvePath first
public routine WinGetDirectories(const ADir: string; var AList: StringArray): bool;
begin
  return DoList(ADir, true, AList);
end;

// Reads ARead to EOF (the pipe breaks when every writer has closed it), appending the bytes to
// AOutput as they came
routine DoReadAll(const ARead: uint64; var AOutput: string);
var
  LBuffer: ByteBuffer;
  LCount: uint32;
  LOld: int64;
  LI: int64;
begin
  while true do
    LCount := 0;
    if ReadFile(ARead, addr of LBuffer, ADAM_WINDOWS_IO_SIZE, LCount, nil) = 0 then
      leave;
    end;
    LOld := len(AOutput);
    setlength(AOutput, LOld + int64(LCount));
    for LI := 0 to int64(LCount) - 1 do
      AOutput[LOld + LI] := char(LBuffer[LI]);
    end;
  end;
end;

// Starts the process (stdin ANul, stdout and stderr AWrite), reads its output to EOF, waits for
// it and takes its exit code; closes the write end once the child holds it, and the process and
// thread handles on every path. False when it does not start or its exit code cannot be read
routine DoStartAndRead(var AApplication: WideBuffer; var ACommandLine: WideBuffer;
  var ADirectory: WideBuffer; const ANul: uint64; var AWrite: uint64; const ARead: uint64;
  var AOutput: string; var AExitCode: uint32): bool;
var
  LStartup: STARTUPINFOW;
  LInfo: PROCESS_INFORMATION;
  LStarted: bool;
  LOk: bool;
begin
  LStartup.cb := uint32(size(STARTUPINFOW));
  LStartup.dwFlags := STARTF_USESTDHANDLES | STARTF_USESHOWWINDOW;
  LStartup.wShowWindow := SW_HIDE;
  LStartup.hStdInput := ANul;
  LStartup.hStdOutput := AWrite;
  LStartup.hStdError := AWrite;
  LStarted := CreateProcessW(AApplication, ACommandLine, nil, nil, 1,
    NORMAL_PRIORITY_CLASS, nil, ADirectory, LStartup, LInfo) <> 0;
  // Only the child holds the write end now: the pipe breaks when it exits, so the read below
  // ends on EOF
  CloseHandle(AWrite);
  AWrite := 0;
  if not LStarted then
    return false;
  end;
  LOk := false;
  guard
    DoReadAll(ARead, AOutput);
    WaitForSingleObject(LInfo.hProcess, INFINITE);
    LOk := GetExitCodeProcess(LInfo.hProcess, AExitCode) <> 0;
  finally
    CloseHandle(LInfo.hProcess);
    CloseHandle(LInfo.hThread);
  end;
  return LOk;
end;

// What CreateProcessW takes for AExe run with AArgs in AWorkDir ("" = this process's folder):
// the application, the command line and the folder, as UTF-16. False when one cannot be made
routine DoProcessTexts(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AApplication: WideBuffer; var ACommandLine: WideBuffer; var ADirectory: WideBuffer): bool;
var
  LCommand: string;
  LWorkDir: string;
  LI: int64;
begin
  // The program is named twice: as the application (full, long-path form: no MAX_PATH limit,
  // no search) and quoted as the command line's first argument (argv[0] for the child)
  LCommand := QuoteArg(AExe);
  for LI := 0 to len(AArgs) - 1 do
    LCommand := LCommand + " " + QuoteArg(AArgs[LI]);
  end;
  LWorkDir := AWorkDir;
  if LWorkDir = "" then
    LWorkDir := ".";
  end;
  if not DoFilePath(AExe, AApplication) then
    return false;
  end;
  if not Utf8ToWide(LCommand, ACommandLine) then
    return false;
  end;
  return Utf8ToWide(LWorkDir, ADirectory);
end;

// Runs AExe (the path of the exe file itself, its extension included: no PATH search; it goes
// through WinResolvePath) with AArgs, in AWorkDir ("" = this process's folder), on this process's
// own stdin, stdout and stderr: it reads and writes where this process does (a console, a
// pipe, a file), as if the shell had started it. AExitCode gets its exit code. False when it
// cannot start or its exit code cannot be read. Its process and thread handles are closed on
// every path
public routine WinRunAttached(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32): bool;
var
  LApplication: own WideBox;
  LCommandLine: own WideBox;
  LDirectory: own WideBox;
  LStartup: STARTUPINFOW;
  LInfo: PROCESS_INFORMATION;
  LOk: bool;
begin
  LApplication := own WideBox();
  LCommandLine := own WideBox();
  LDirectory := own WideBox();
  AExitCode := 0;
  if not DoProcessTexts(AExe, AArgs, AWorkDir, LApplication.Data, LCommandLine.Data,
    LDirectory.Data) then
    return false;
  end;
  // This process's standard handles, handed on (inherited) as the child's own
  LStartup.cb := uint32(size(STARTUPINFOW));
  LStartup.dwFlags := STARTF_USESTDHANDLES;
  LStartup.hStdInput := GetStdHandle(STD_INPUT_HANDLE);
  LStartup.hStdOutput := GetStdHandle(STD_OUTPUT_HANDLE);
  LStartup.hStdError := GetStdHandle(STD_ERROR_HANDLE);
  if CreateProcessW(LApplication.Data, LCommandLine.Data, nil, nil, 1,
    NORMAL_PRIORITY_CLASS, nil, LDirectory.Data, LStartup, LInfo) = 0 then
    return false;
  end;
  LOk := false;
  guard
    WaitForSingleObject(LInfo.hProcess, INFINITE);
    LOk := GetExitCodeProcess(LInfo.hProcess, AExitCode) <> 0;
  finally
    CloseHandle(LInfo.hProcess);
    CloseHandle(LInfo.hThread);
  end;
  return LOk;
end;

// Runs AExe (the path of the exe file itself, its extension included: no PATH search; it goes
// through WinResolvePath) with AArgs, in AWorkDir ("" = this process's folder). stdin is NUL;
// stdout and stderr go to one pipe, so AOutput holds the bytes in the order written; AExitCode
// gets the exit code. False when it cannot start or its exit code cannot be read (AOutput then
// holds what was read, if anything). Every handle it opens is closed on every path
public routine WinRunProcess(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AOutput: string; var AExitCode: uint32): bool;
var
  LApplication: own WideBox;
  LCommandLine: own WideBox;
  LDirectory: own WideBox;
  LNulName: own WideBox;
  LAttributes: SECURITY_ATTRIBUTES;
  LRead: uint64;
  LWrite: uint64;
  LNul: uint64;
  LOk: bool;
begin
  LApplication := own WideBox();
  LCommandLine := own WideBox();
  LDirectory := own WideBox();
  LNulName := own WideBox();
  AOutput := "";
  AExitCode := 0;
  if not DoProcessTexts(AExe, AArgs, AWorkDir, LApplication.Data, LCommandLine.Data,
    LDirectory.Data) then
    return false;
  end;
  if not Utf8ToWide("NUL", LNulName.Data) then
    return false;
  end;

  // Both pipe ends inheritable; the read end is made private below, so a child never holds it
  LAttributes.nLength := uint32(size(SECURITY_ATTRIBUTES));
  LAttributes.lpSecurityDescriptor := nil;
  LAttributes.bInheritHandle := 1;
  LRead := 0;
  LWrite := 0;
  if CreatePipe(LRead, LWrite, LAttributes, 0) = 0 then
    return false;
  end;
  LNul := INVALID_HANDLE_VALUE;
  LOk := false;
  guard
    if SetHandleInformation(LRead, HANDLE_FLAG_INHERIT, 0) <> 0 then
      LNul := CreateFileW(LNulName.Data, GENERIC_READ,
        FILE_SHARE_READ | FILE_SHARE_WRITE, LAttributes, OPEN_EXISTING, 0, 0);
    end;
    if LNul <> INVALID_HANDLE_VALUE then
      LOk := DoStartAndRead(LApplication.Data, LCommandLine.Data, LDirectory.Data, LNul, LWrite,
        LRead, AOutput, AExitCode);
    end;
  finally
    CloseHandle(LRead);
    if LWrite <> 0 then
      CloseHandle(LWrite);
    end;
    if LNul <> INVALID_HANDLE_VALUE then
      CloseHandle(LNul);
    end;
  end;
  return LOk;
end;

// Waits AMilliseconds, then returns: at least that long (Sleep; the OS may wake the program a
// little later). A wait of 0 or less returns at once
public routine WinDelay(const AMilliseconds: int32);
begin
  if AMilliseconds > 0 then
    Sleep(uint32(AMilliseconds));
  end;
end;

// Milliseconds since the system started (GetTickCount64): only the difference of two
// readings means anything, a duration (a build's time)
public routine WinTickCountMs(): int64;
begin
  return int64(GetTickCount64());
end;

// The high-resolution counter's reading (QueryPerformanceCounter): never going back, only the
// difference of two readings means anything, in WinPerformanceFrequency's units
public routine WinPerformanceCounter(): int64;
var
  LCount: int64;
begin
  LCount := 0;
  QueryPerformanceCounter(LCount);
  return LCount;
end;

// The high-resolution counter's counts per second (QueryPerformanceFrequency: fixed at boot,
// never 0 on Windows XP and later)
public routine WinPerformanceFrequency(): int64;
var
  LFrequency: int64;
begin
  LFrequency := 0;
  QueryPerformanceFrequency(LFrequency);
  return LFrequency;
end;

end.
