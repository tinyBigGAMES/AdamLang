  AProcessAttributes: ptr; AThreadAttributes: ptr; AInheritHandles: int32; AFlags: uint32;
  AEnvironment: ptr; var ACurrentDirectory: WideBuffer; var AStartup: STARTUPINFOW;
  var AInfo: PROCESS_INFORMATION): int32; external "kernel32";
