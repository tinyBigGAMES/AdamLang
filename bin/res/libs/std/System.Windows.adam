-------------------------------------------------------------------------------
  System.Windows.adam - Adam's Windows layer: paths, files, folders,
  processes and the program's own end over the Win32 API

  Its public SDK block holds the Windows SDK's own names, each once (AD.5a):
  the Win32 constants it uses, and winnt.h's PE / COFF, winuser.h's RT_* and
  winver.h's VS_* / VOS_* / VFT_* that Adam's COFF part writes and reads.

  The API is declared here with `external` (DESIGN sec 2): no C or C++ in
  Adam's dependency path, the same file under pcpp and Adam (shared subset,
  DESIGN sec 10). Handles are uint64 (a HANDLE is pointer-sized); a buffer
  Win32 reads or writes is a static array passed `var`, which C linkage
  passes by reference, so no `addr of`. It imports System.SysUtils (the
  UTF-8 codec, string lists), never the other way round.

  The file, folder, path, process and clock jobs every target has are
  System.IO's (FileExists, ResolvePath, RunProcess ...): here they are the
  Win* routines System.IO.Win64 hands them to (WinFileExists, WinResolvePath,
  WinRunProcess ...), PaskalCPP's SysUtils rules kept; a program imports
  System.IO for them, never this unit. Windows-only beside them: ExeDir,
  RemoveDir, RenameFile, TempDir, the UTF-16 codec (Halt is
  System.Runtime's, on every target). WinSystemDir is Windows' system folder,
  where the linker finds the system DLLs.

  Text is UTF-8 in a string. Win32 takes UTF-16: the marshaling into its
  buffers is here (no length limit of its own, malformed input becomes
  U+FFFD). Every routine that takes a path resolves it first (WinResolvePath:
  $P: $D: $S: work as written), then hands it to the file API full and with
  the long-path prefix (\\?\, \\?\UNC\), so no MAX_PATH limit applies. File
  text is read and written as its bytes, as is: no BOM, no line-end change.

  WinRunProcess follows StdApp.Utils' CaptureConsoleOutput: stdout and stderr
  share one pipe (the output in written order), stdin is NUL, and once this
  process closes its copy of the write end the read loop ends at EOF: no
  deadlock, no thread, no polling. WinRunAttached is the other way to run a
  program: nothing captured, the child given this process's own stdin,
  stdout and stderr (a program run for the user, as adam build -r does).
*******************************************************************************/

module unit System.Windows;

import System.SysUtils;

public const
  // The UTF-16 units a Win32 path or command line holds, its NUL not counted
  ADAM_WINDOWS_WIDE_MAX: int32 = 32767;
  // The UTF-16 units up to which WinResolvePath writes a path with '/' (the plain Win32 limit);
  // past it, the long-path spelling
  ADAM_WINDOWS_SHORT_PATH_MAX: int64 = 247;

public type
  // A NUL-terminated UTF-16 text as Win32 reads and writes it
  WideBuffer = array[0..32767] of uint16;

type
  // A WideBuffer on the heap: a routine's 64 KB buffer kept off its stack frame, freed on
  // every way out (return or raise) by its own
  WideBox = final object
    Data: WideBuffer;
  end;

public const
  INVALID_HANDLE_VALUE: uint64 = 0xFFFFFFFFFFFFFFFF;
  // GetStdHandle's standard input (DWORD)-10, output (DWORD)-11 and error (DWORD)-12
  STD_INPUT_HANDLE: uint32 = 0xFFFFFFF6;
  STD_OUTPUT_HANDLE: uint32 = 0xFFFFFFF5;
  STD_ERROR_HANDLE: uint32 = 0xFFFFFFF4;
  // CreateProcessW's flag for a STARTUPINFOEXW; the pseudo console attribute
  // (ProcThreadAttributeValue(22, FALSE, TRUE, FALSE))
  EXTENDED_STARTUPINFO_PRESENT: uint32 = 0x00080000;
  PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE: uint64 = 0x00020016;
  // GetFileType's answers
  FILE_TYPE_UNKNOWN: uint32 = 0;
  FILE_TYPE_DISK: uint32 = 1;
  FILE_TYPE_CHAR: uint32 = 2;
  FILE_TYPE_PIPE: uint32 = 3;
  INVALID_FILE_ATTRIBUTES: uint32 = 0xFFFFFFFF;
  FILE_ATTRIBUTE_DIRECTORY: uint32 = 0x10;
  FILE_ATTRIBUTE_READONLY: uint32 = 0x1;
  // The environment variable naming this user's local (not roaming) application data folder
  ADAM_WINDOWS_ENV_LOCAL_APP_DATA: string = "LOCALAPPDATA";
  // CompareStringOrdinal's result for two equal texts
  CSTR_EQUAL: int32 = 2;
  FILE_ATTRIBUTE_NORMAL: uint32 = 0x80;
  HANDLE_FLAG_INHERIT: uint32 = 0x1;
  // MoveFileExW: a file at the new name is replaced; the move is on disk before it returns
  MOVEFILE_REPLACE_EXISTING: uint32 = 0x1;
  MOVEFILE_WRITE_THROUGH: uint32 = 0x8;
  STARTF_USESHOWWINDOW: uint32 = 0x1;
  STARTF_USESTDHANDLES: uint32 = 0x100;
  SW_HIDE: uint16 = 0;
  NORMAL_PRIORITY_CLASS: uint32 = 0x20;
  GENERIC_READ: uint32 = 0x80000000;
  FILE_SHARE_READ: uint32 = 0x1;
  FILE_SHARE_WRITE: uint32 = 0x2;
  OPEN_EXISTING: uint32 = 3;
  INFINITE: uint32 = 0xFFFFFFFF;
  ERROR_FILE_NOT_FOUND: uint32 = 2;
  ERROR_NO_MORE_FILES: uint32 = 18;
  ADAM_WINDOWS_IO_SIZE: uint32 = 4096;
  // GET_FILEEX_INFO_LEVELS' GetFileExInfoStandard
  GetFileExInfoStandard: int32 = 0;
  // BCryptGenRandom's BCRYPT_USE_SYSTEM_PREFERRED_RNG: no algorithm handle, the system's RNG
  BCRYPT_USE_SYSTEM_PREFERRED_RNG: uint32 = 0x2;
  // SetConsoleMode's ENABLE_VIRTUAL_TERMINAL_PROCESSING (an output handle's mode)
  ENABLE_VIRTUAL_TERMINAL_PROCESSING: uint32 = 0x0004;
  // UTF-8's code page (SetConsoleOutputCP, MultiByteToWideChar)
  CP_UTF8: uint32 = 65001;
  // INPUT_RECORD's EventType for a key
  KEY_EVENT: uint16 = 0x0001;

  // PE / COFF (winnt.h), each in the type of the field it goes in: record sizes (COFF File
  // Header, Section Table, COFF Relocations, COFF Symbol Table)
  IMAGE_SIZEOF_FILE_HEADER: int32 = 20;
  IMAGE_SIZEOF_SECTION_HEADER: int32 = 40;
  IMAGE_SIZEOF_RELOCATION: int32 = 10;
  IMAGE_SIZEOF_SYMBOL: int32 = 18;
  IMAGE_SIZEOF_SHORT_NAME: int32 = 8;
  // The Machine field (also StackWalk64's machine) and the x64 relocation types
  IMAGE_FILE_MACHINE_AMD64: uint16 = 0x8664;
  IMAGE_REL_AMD64_ADDR64: uint16 = 0x0001;
  IMAGE_REL_AMD64_ADDR32NB: uint16 = 0x0003;
  IMAGE_REL_AMD64_REL32: uint16 = 0x0004;
  IMAGE_REL_AMD64_SECTION: uint16 = 0x000A;
  IMAGE_REL_AMD64_SECREL: uint16 = 0x000B;
  // Section Flags
  IMAGE_SCN_CNT_CODE: uint32 = 0x00000020;
  IMAGE_SCN_CNT_INITIALIZED_DATA: uint32 = 0x00000040;
  IMAGE_SCN_CNT_UNINITIALIZED_DATA: uint32 = 0x00000080;
  // An Info section: comments / compiler data no linker puts in an image
  IMAGE_SCN_LNK_INFO: uint32 = 0x00000200;
  IMAGE_SCN_LNK_REMOVE: uint32 = 0x00000800;
  IMAGE_SCN_LNK_COMDAT: uint32 = 0x00001000;
  // The 16-bit flag a PDB's section map entries carry
  IMAGE_SCN_MEM_16BIT: uint32 = 0x00020000;
  IMAGE_SCN_LNK_NRELOC_OVFL: uint32 = 0x01000000;
  IMAGE_SCN_MEM_DISCARDABLE: uint32 = 0x02000000;
  IMAGE_SCN_MEM_EXECUTE: uint32 = 0x20000000;
  IMAGE_SCN_MEM_READ: uint32 = 0x40000000;
  IMAGE_SCN_MEM_WRITE: uint32 = 0x80000000;
  // Storage classes (COFF Symbol Table)
  IMAGE_SYM_CLASS_EXTERNAL: uint8 = 2;
  IMAGE_SYM_CLASS_STATIC: uint8 = 3;
  IMAGE_SYM_CLASS_LABEL: uint8 = 6;
  IMAGE_SYM_CLASS_FILE: uint8 = 103;
  IMAGE_SYM_CLASS_SECTION: uint8 = 104;
  IMAGE_SYM_CLASS_WEAK_EXTERNAL: uint8 = 105;
  // COMDAT selections (COMDAT Sections)
  IMAGE_COMDAT_SELECT_NODUPLICATES: uint8 = 1;
  IMAGE_COMDAT_SELECT_ANY: uint8 = 2;
  IMAGE_COMDAT_SELECT_SAME_SIZE: uint8 = 3;
  IMAGE_COMDAT_SELECT_EXACT_MATCH: uint8 = 4;
  IMAGE_COMDAT_SELECT_ASSOCIATIVE: uint8 = 5;
  IMAGE_COMDAT_SELECT_LARGEST: uint8 = 6;
  // Section Number Values ((SHORT) in winnt.h)
  IMAGE_SYM_UNDEFINED: int16 = 0;
  IMAGE_SYM_ABSOLUTE: int16 = -1;
  IMAGE_SYM_DEBUG: int16 = -2;
  // Weak external search kinds (Auxiliary Format 3's Characteristics)
  IMAGE_WEAK_EXTERN_SEARCH_NOLIBRARY: uint32 = 1;
  IMAGE_WEAK_EXTERN_SEARCH_LIBRARY: uint32 = 2;
  IMAGE_WEAK_EXTERN_SEARCH_ALIAS: uint32 = 3;
  // Image headers: the MS-DOS and PE signatures, the file header's Characteristics, the
  // optional header's magic (PE32+), its data directories, subsystems and DLL characteristics,
  // a CodeView debug directory entry's Type
  IMAGE_DOS_SIGNATURE: uint16 = 0x5A4D;
  IMAGE_NT_SIGNATURE: uint32 = 0x00004550;
  IMAGE_FILE_RELOCS_STRIPPED: uint16 = 0x0001;
  IMAGE_FILE_EXECUTABLE_IMAGE: uint16 = 0x0002;
  IMAGE_FILE_LARGE_ADDRESS_AWARE: uint16 = 0x0020;
  IMAGE_FILE_DLL: uint16 = 0x2000;
  IMAGE_NT_OPTIONAL_HDR64_MAGIC: uint16 = 0x20B;
  IMAGE_NUMBEROF_DIRECTORY_ENTRIES: int32 = 16;
  IMAGE_DIRECTORY_ENTRY_EXPORT: int32 = 0;
  IMAGE_DIRECTORY_ENTRY_IMPORT: int32 = 1;
  IMAGE_DIRECTORY_ENTRY_RESOURCE: int32 = 2;
  IMAGE_DIRECTORY_ENTRY_EXCEPTION: int32 = 3;
  IMAGE_DIRECTORY_ENTRY_BASERELOC: int32 = 5;
  IMAGE_DIRECTORY_ENTRY_DEBUG: int32 = 6;
  IMAGE_DIRECTORY_ENTRY_TLS: int32 = 9;
  IMAGE_DIRECTORY_ENTRY_IAT: int32 = 12;
  IMAGE_SUBSYSTEM_WINDOWS_GUI: uint16 = 2;
  IMAGE_SUBSYSTEM_WINDOWS_CUI: uint16 = 3;
  IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA: uint16 = 0x0020;
  IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE: uint16 = 0x0040;
  IMAGE_DLLCHARACTERISTICS_NX_COMPAT: uint16 = 0x0100;
  IMAGE_DEBUG_TYPE_CODEVIEW: uint32 = 2;
  // A base relocation's type (Base Relocation Types)
  IMAGE_REL_BASED_DIR64: uint16 = 10;
  // Archives (Archive (Library) File Format) and short import headers (Import Library Format)
  IMAGE_ARCHIVE_START: string = "!<arch>\n";
  IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR: int32 = 60;
  IMPORT_OBJECT_HDR_SIG2: uint16 = 0xFFFF;
  IMPORT_OBJECT_CODE: int32 = 0;
  IMPORT_OBJECT_DATA: int32 = 1;
  IMPORT_OBJECT_NAME: int32 = 1;
  // Resources: their types (winuser.h RT_*), the neutral language, the version resource's id
  // and VS_FIXEDFILEINFO fields (winver.h)
  RT_ICON: uint16 = 3;
  RT_GROUP_ICON: uint16 = 14;
  RT_VERSION: uint16 = 16;
  LANG_NEUTRAL: uint16 = 0;
  VS_VERSION_INFO: uint16 = 1;
  VS_FFI_SIGNATURE: uint32 = 0xFEEF04BD;
  VS_FFI_STRUCVERSION: uint32 = 0x00010000;
  VS_FFI_FILEFLAGSMASK: uint32 = 0x3F;
  VOS_NT_WINDOWS32: uint32 = 0x00040004;
  VFT_APP: uint32 = 1;
  VFT_DLL: uint32 = 2;
  // LoadLibraryExW's flags for an image whose resources are read, never run (libloaderapi.h)
  LOAD_LIBRARY_AS_DATAFILE: uint32 = 0x00000002;
  LOAD_LIBRARY_AS_IMAGE_RESOURCE: uint32 = 0x00000020;

public type
  // EnumResourceNamesW's and EnumResourceLanguagesW's callbacks (libloaderapi.h): a type or
  // name is an id when it fits 16 bits (IS_INTRESOURCE), else a NUL-terminated UTF-16 text
  ENUMRESNAMEPROCW = routine clink(AModule: uint64; AType: uint64; AName: uint64;
    AParam: ptr): int32;
  ENUMRESLANGPROCW = routine clink(AModule: uint64; AType: uint64; AName: uint64;
    ALanguage: uint16; AParam: ptr): int32;

  // The SDK's records the Windows units share (minwinbase.h, minwindef.h, processthreadsapi.h)
  FILETIME = record
    dwLowDateTime: uint32;
    dwHighDateTime: uint32;
  end;

  WIN32_FIND_DATAW = record
    dwFileAttributes: uint32;
    ftCreationTime: FILETIME;
    ftLastAccessTime: FILETIME;
    ftLastWriteTime: FILETIME;
    nFileSizeHigh: uint32;
    nFileSizeLow: uint32;
    dwReserved0: uint32;
    dwReserved1: uint32;
    cFileName: array[0..259] of uint16;
    cAlternateFileName: array[0..13] of uint16;
  end;

  WIN32_FILE_ATTRIBUTE_DATA = record
    dwFileAttributes: uint32;
    ftCreationTime: FILETIME;
    ftLastAccessTime: FILETIME;
    ftLastWriteTime: FILETIME;
    nFileSizeHigh: uint32;
    nFileSizeLow: uint32;
  end;

  SECURITY_ATTRIBUTES = record
    nLength: uint32;
    lpSecurityDescriptor: ptr;
    bInheritHandle: int32;
  end;

  STARTUPINFOW = record
    cb: uint32;
    lpReserved: ptr;
    lpDesktop: ptr;
    lpTitle: ptr;
    dwX: uint32;
    dwY: uint32;
    dwXSize: uint32;
    dwYSize: uint32;
    dwXCountChars: uint32;
    dwYCountChars: uint32;
    dwFillAttribute: uint32;
    dwFlags: uint32;
    wShowWindow: uint16;
    cbReserved2: uint16;
    lpReserved2: ptr;
    hStdInput: uint64;
    hStdOutput: uint64;
    hStdError: uint64;
  end;

  // STARTUPINFOEXW: a STARTUPINFOW (cb its whole size) and its attribute list (a pseudo
  // console's, EXTENDED_STARTUPINFO_PRESENT)
  STARTUPINFOEXW = record
    StartupInfo: STARTUPINFOW;
    lpAttributeList: ptr;
  end;

  // wincontypes.h's COORD (a console's or a pseudo console's size, a cell)
  COORD = record
    X: int16;
    Y: int16;
  end;

  PROCESS_INFORMATION = record
    hProcess: uint64;
    hThread: uint64;
    dwProcessId: uint32;
    dwThreadId: uint32;
  end;

type
  // One ReadFile's (a child process's pipe) or BCryptGenRandom's worth of bytes
  ByteBuffer = array[0..4095] of uint8;

