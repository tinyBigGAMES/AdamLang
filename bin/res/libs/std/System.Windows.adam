// Writes AText (UTF-8) into ABuffer as UTF-16 from AStart on and ends it with a NUL; ALength
// gets the units written, the NUL not counted. False when it does not fit (ADAM_WINDOWS_WIDE_MAX
// units in all, AStart included)
func DoUTF8ToWideAt(const AText: string; var ABuffer: WideBuffer; const AStart: int32;
  var ALength: int32): bool;
var
  LIndex: int64;
  LCode: uint32;
  LAt: int32;
begin
  ALength := 0;
  ABuffer[AStart] := 0;
  LIndex := 0;
  LAt := AStart;
  while LIndex < len(AText) do
    LCode := DecodeUTF8Char(AText, LIndex);
    if LCode >= 0x10000 then
      // A surrogate pair
      if LAt + 2 > ADAM_WINDOWS_WIDE_MAX then
        return false;
      end;
      LCode := LCode - 0x10000;
      ABuffer[LAt] := uint16(0xD800 | (LCode shr 10));
      ABuffer[LAt + 1] := uint16(0xDC00 | (LCode & 0x3FF));
      LAt := LAt + 2;
    else
      if LAt + 1 > ADAM_WINDOWS_WIDE_MAX then
        return false;
      end;
      ABuffer[LAt] := uint16(LCode);
      LAt := LAt + 1;
    end;
  end;
  ABuffer[LAt] := 0;
  ALength := LAt - AStart;
  return true;
end;

// AText (UTF-8) into ABuffer as NUL-terminated UTF-16; malformed input becomes U+FFFD. False
// when it needs more than ADAM_WINDOWS_WIDE_MAX units
public func UTF8ToWide(const AText: string; var ABuffer: WideBuffer): bool;
var
  LLength: int32;
begin
  return DoUTF8ToWideAt(AText, ABuffer, 0, LLength);
end;

// The UTF-8 text of ABuffer's first ALength units, or up to its NUL when that comes first; a
// lone surrogate becomes U+FFFD
public func WideToUTF8(var ABuffer: WideBuffer; const ALength: int32): string;
var
  LText: string;
  LAt: int64;
  LI: int32;
  LUnit: uint32;
  LNext: uint32;
  LCode: uint32;
begin
  LText := "";
  // At most 3 bytes per unit: a pair (2 units) takes 4
  setlength(LText, int64(ALength) * 3);
  LAt := 0;
  LI := 0;
  while (LI < ALength) and (ABuffer[LI] <> 0) do
    LUnit := uint32(ABuffer[LI]);
    LI := LI + 1;
    LCode := LUnit;
    if (LUnit >= 0xD800) and (LUnit <= 0xDBFF) then
      // A high surrogate: a pair with the low one that follows, else alone
      LCode := ADAM_SYSUTILS_REPLACEMENT;
      if LI < ALength then
        LNext := uint32(ABuffer[LI]);
        if (LNext >= 0xDC00) and (LNext <= 0xDFFF) then
          LCode := 0x10000 + ((LUnit - 0xD800) shl 10) + (LNext - 0xDC00);
          LI := LI + 1;
        end;
      end;
    end;
    if (LUnit >= 0xDC00) and (LUnit <= 0xDFFF) then
      // A low surrogate with no high one before it
      LCode := ADAM_SYSUTILS_REPLACEMENT;
    end;
    EncodeUTF8Char(LText, LAt, LCode);
  end;
  setlength(LText, LAt);
  return LText;
end;

// AArg as one argument of a Windows command line, by the rules CommandLineToArgvW reads back
// (StdApp.Utils' QuoteCommandArg): as is when nothing in it splits or quotes (an empty one
// still needs ""), else quoted, each backslash run before a quote or the closing quote doubled
// and the quote itself escaped
public func QuoteArg(const AArg: string): string;
var
  LNeeds: bool;
  LI: int64;
  LChar: char;
  LSlashes: int64;
  LText: string;
begin
  LNeeds := len(AArg) = 0;
  for LI := 0 to len(AArg) - 1 do
    LChar := AArg[LI];
    if (LChar = ' ') or (LChar = '\t') or (LChar = '\n') or (LChar = '\v') or (LChar = '"') then
      LNeeds := true;
    end;
  end;
  if not LNeeds then
    return AArg;
  end;
  LText := "\"";
  LSlashes := 0;
  for LI := 0 to len(AArg) - 1 do
    LChar := AArg[LI];
    if LChar = '\\' then
      // A run of backslashes counts only before a quote
      LSlashes := LSlashes + 1;
    else
      if LChar = '"' then
        LText := LText + StringOfChar('\\', LSlashes * 2 + 1) + "\"";
      else
        LText := LText + StringOfChar('\\', LSlashes) + LChar;
      end;
      LSlashes := 0;
    end;
  end;
  // The backslashes before the closing quote doubled, so it stays a quote
  LText := LText + StringOfChar('\\', LSlashes * 2) + "\"";
  return LText;
end;

// True for a path separator ('/' or '\')
func DoIsSeparator(const AChar: char): bool;
begin
  return (AChar = '/') or (AChar = '\\');
end;

// AText with every AFrom byte replaced by ATo (the separators are ASCII: UTF-8 text is never cut)
func DoReplaceChar(const AText: string; const AFrom: char; const ATo: char): string;
var
  LText: string;
  LI: int64;
begin
  LText := AText;
  for LI := 0 to len(LText) - 1 do
    if LText[LI] = AFrom then
      LText[LI] := ATo;
    end;
  end;
  return LText;
end;

// True when AText starts with the prefix "$<ALetter>:", the letter (upper case) in either case
func DoHasPrefix(const AText: string; const ALetter: char): bool;
var
  LLetter: uint8;
begin
  if len(AText) < 3 then
    return false;
  end;
  LLetter := uint8(AText[1]);
  if (LLetter >= 0x61) and (LLetter <= 0x7A) then
    LLetter := uint8(LLetter - 0x20);
  end;
  return (AText[0] = '$') and (LLetter = uint8(ALetter)) and (AText[2] = ':');
end;

// The long-path spelling in either slash (\\?\..., //?/..., or a mix)
func DoIsLongForm(const APath: string): bool;
begin
  if len(APath) < 4 then
    return false;
  end;
  return DoIsSeparator(APath[0]) and DoIsSeparator(APath[1]) and (APath[2] = '?') and
    DoIsSeparator(APath[3]);
end;

// True when APath is rooted: a separator first, or a drive letter and ':'
func DoIsRooted(const APath: string): bool;
begin
  if (len(APath) > 0) and DoIsSeparator(APath[0]) then
    return true;
  end;
  return (len(APath) >= 2) and (APath[1] = ':');
end;

// The UTF-16 units AText (UTF-8) takes: 2 for a code point past U+FFFF, else 1
func DoWideLength(const AText: string): int64;
var
  LIndex: int64;
  LCount: int64;
begin
  LIndex := 0;
  LCount := 0;
  while LIndex < len(AText) do
    if DecodeUTF8Char(AText, LIndex) >= 0x10000 then
      LCount := LCount + 2;
    else
      LCount := LCount + 1;
    end;
  end;
  return LCount;
end;

// Win32's own full-path rule (GetFullPathNameW: '.' and '..' folded, repeated separators
// joined, no disk access, symlinks not followed); APath as it is when Win32 cannot make it full
func DoFullPath(const APath: string): string;
var
  LInput: own WideBox;
  LFull: own WideBox;
  LLength: int32;
  LResult: uint32;
begin
  LInput := own WideBox();
  LFull := own WideBox();
  if not DoUTF8ToWideAt(APath, LInput.Data, 0, LLength) then
    return APath;
  end;
  LResult := GetFullPathNameW(LInput.Data, uint32(ADAM_WINDOWS_WIDE_MAX + 1), LFull.Data, nil);
  // 0 = it failed; more than the buffer holds = the size it would need
  if (LResult = 0) or (LResult > uint32(ADAM_WINDOWS_WIDE_MAX)) then
    return APath;
  end;
  return WideToUTF8(LFull.Data, int32(LResult));
end;

// The one output form of a full path: up to ADAM_WINDOWS_SHORT_PATH_MAX UTF-16 units the
// forward-slash spelling, past it the long-path spelling (backslashes, \\?\UNC\ for a share, a
// device path \\.\ as is). A path already in long form keeps it. Idempotent on both
func DoFinish(const AFull: string): string;
var
  LPath: string;
begin
  if DoIsLongForm(AFull) then
    return DoReplaceChar(AFull, '/', '\\');
  end;
  if DoWideLength(AFull) <= ADAM_WINDOWS_SHORT_PATH_MAX then
    return DoReplaceChar(AFull, '\\', '/');
  end;
  LPath := DoReplaceChar(AFull, '/', '\\');
  if StartsStr("\\\\.\\", LPath) then
    return LPath;
  end;
  if StartsStr("\\\\", LPath) then
    return "\\\\?\\UNC\\" + Substring(LPath, 2, len(LPath) - 2);
  end;
  return "\\\\?\\" + LPath;
end;

// APath under ABase, one separator between them
func DoCombine(const ABase: string; const APath: string): string;
begin
  if (len(ABase) > 0) and DoIsSeparator(ABase[len(ABase) - 1]) then
    return ABase + APath;
  end;
  return ABase + "\\" + APath;
end;

// The current working directory as Win32 spells it; "" when it cannot be read
func DoCurrentDir(): string;
var
  LBuffer: own WideBox;
  LLength: uint32;
begin
  LBuffer := own WideBox();
  LLength := GetCurrentDirectoryW(uint32(ADAM_WINDOWS_WIDE_MAX + 1), LBuffer.Data);
  // 0 = it failed; more than the buffer holds = the size it would need
  if (LLength = 0) or (LLength > uint32(ADAM_WINDOWS_WIDE_MAX)) then
    return "";
  end;
  return WideToUTF8(LBuffer.Data, int32(LLength));
end;

// The folder of this process's exe file as Win32 spells it, asked of the OS (never argv[0]),
// with no trailing separator except at a root (C:\); "" when it cannot be read
func DoExeFolder(): string;
var
  LBuffer: own WideBox;
  LSize: uint32;
  LLength: uint32;
  LFile: string;
  LSep: int64;
  LI: int64;
begin
  LBuffer := own WideBox();
  LSize := uint32(ADAM_WINDOWS_WIDE_MAX + 1);
  LLength := GetModuleFileNameW(0, LBuffer.Data, LSize);
  // 0 = it failed; the whole buffer = the path was cut short
  if (LLength = 0) or (LLength >= LSize) then
    return "";
  end;
  LFile := WideToUTF8(LBuffer.Data, int32(LLength));
  // A process started through the long-path spelling gets its module path back in it
  // (\\?\C:\...): a drive path short enough for the plain spelling is given in that, so a
  // $P: path takes WinResolvePath's one form however the program was started
  if DoIsLongForm(LFile) and (len(LFile) > 6) and (LFile[5] = ':') and
    (DoWideLength(LFile) - 4 <= ADAM_WINDOWS_SHORT_PATH_MAX) then
    LFile := Substring(LFile, 4, len(LFile) - 4);
  end;
  LSep := -1;
  for LI := 0 to len(LFile) - 1 do
    if DoIsSeparator(LFile[LI]) then
      LSep := LI;
    end;
  end;
  if LSep < 0 then
    return "";
  end;
  if (LSep = 2) and (LFile[1] = ':') then
    return Substring(LFile, 0, 3);
  end;
  return Substring(LFile, 0, LSep);
end;

// Resolves APath to one full, normalized path against ABaseDir (PaskalCPP's WinResolvePath rule).
// A prefix at the very start, in either case, names the base: $P: the folder of this program's
// exe (asked of the OS), $D: the current working directory, $S: ABaseDir (the same as none).
// $R: (the project root) is a build-time prefix of the compiler only: it gives "". A rooted path
// is only normalized; any other is resolved against its base (ABaseDir "" = the current working
// directory). '.' and '..' are folded and repeated separators joined, as text: the disk is never
// touched. Leading and trailing blanks are trimmed. The result uses '/' up to
// ADAM_WINDOWS_SHORT_PATH_MAX UTF-16 units and the long-path spelling past it (\\?\C:\...,
// \\?\UNC\server\share\...), so every file routine takes it at any length; resolving a result
// again gives it back unchanged. "" for an empty path, only a prefix, or a $R: path
public func WinResolvePath(const APath: string; const ABaseDir: string): string;
var
  LPath: string;
  LBase: string;
  LExeBase: bool;
  LCurrentBase: bool;
begin
  LPath := Trim(APath);
  if LPath = "" then
    return "";
  end;
  if DoHasPrefix(LPath, 'R') then
    return "";
  end;

  // An explicit prefix, at the very start only, overrides the caller's base
  LExeBase := DoHasPrefix(LPath, 'P');
  LCurrentBase := DoHasPrefix(LPath, 'D');
  if LExeBase or LCurrentBase or DoHasPrefix(LPath, 'S') then
    LPath := Trim(Substring(LPath, 3, len(LPath) - 3));
  end;
  if LPath = "" then
    return "";
  end;
  LBase := ABaseDir;
  if LExeBase then
    LBase := DoExeFolder();
  end;
  if LCurrentBase then
    LBase := DoCurrentDir();
  end;

  // The long-path spelling takes backslashes only: one typed with '/' is the same path
  if DoIsLongForm(LPath) then
    LPath := DoReplaceChar(LPath, '/', '\\');
  end;
  if DoIsLongForm(LBase) then
    LBase := DoReplaceChar(LBase, '/', '\\');
  end;
  if not DoIsRooted(LPath) then
    if LBase = "" then
      LBase := DoCurrentDir();
    end;
    LPath := DoCombine(LBase, LPath);
  end;
  return DoFinish(DoFullPath(LPath));
end;

// Resolves APath against the current working directory; see WinResolvePath(APath, ABaseDir) for
// the prefixes and the result's form
public func WinResolvePath(const APath: string): string;
begin
  return WinResolvePath(APath, "");
end;

// True when AFirst and ASecond (each resolved against the current working directory) name
// the same path as Windows tells paths apart: without case, as the file system does
// (CompareStringOrdinal, ignoring case). False when either resolves to "" or does not fit
public func WinSamePath(const AFirst: string; const ASecond: string): bool;
var
  LFirst: own WideBox;
  LSecond: own WideBox;
  LFirstCount: int32;
  LSecondCount: int32;
  LFirstPath: string;
  LSecondPath: string;
begin
  LFirst := own WideBox();
  LSecond := own WideBox();
  LFirstPath := WinResolvePath(AFirst);
  LSecondPath := WinResolvePath(ASecond);
  if (LFirstPath = "") or (LSecondPath = "") then
    return false;
  end;
  if not DoUTF8ToWideAt(LFirstPath, LFirst.Data, 0, LFirstCount) then
    return false;
  end;
  if not DoUTF8ToWideAt(LSecondPath, LSecond.Data, 0, LSecondCount) then
    return false;
  end;
  return CompareStringOrdinal(LFirst.Data, LFirstCount, LSecond.Data, LSecondCount, 1) =
    CSTR_EQUAL;
end;

// Puts the long-path prefix into ABuffer at AAt: "\\?\" or, for a UNC path, "\\?\UNC\"
func DoPutLongPrefix(var ABuffer: WideBuffer; var AAt: int32; const AUnc: bool);
begin
  ABuffer[0] := 0x5C;
  ABuffer[1] := 0x5C;
  ABuffer[2] := 0x3F;
  ABuffer[3] := 0x5C;
  AAt := 4;
  if AUnc then
    ABuffer[4] := 0x55;
    ABuffer[5] := 0x4E;
    ABuffer[6] := 0x43;
    ABuffer[7] := 0x5C;
    AAt := 8;
  end;
end;

// APath as the file API takes it in ABuffer: resolved (WinResolvePath), backslashes, with the
// long-path prefix (X:\... -> \\?\X:\..., \\server\share -> \\?\UNC\server\share; a path
// already \\?\ or \\.\ stays as it is). False when it resolves to "" or does not fit
func DoFilePath(const APath: string; var ABuffer: WideBuffer): bool;
var
  LPath: string;
  LAt: int32;
  LLength: int32;
begin
  ABuffer[0] := 0;
  LPath := DoReplaceChar(WinResolvePath(APath), '/', '\\');
  if LPath = "" then
    return false;
  end;
  if StartsStr("\\\\?\\", LPath) or StartsStr("\\\\.\\", LPath) then
    return DoUTF8ToWideAt(LPath, ABuffer, 0, LLength);
  end;
  if StartsStr("\\\\", LPath) then
    // A UNC path: its leading "\\" is replaced by "\\?\UNC\"
    DoPutLongPrefix(ABuffer, LAt, true);
    return DoUTF8ToWideAt(Substring(LPath, 2, len(LPath) - 2), ABuffer, LAt, LLength);
  end;
  DoPutLongPrefix(ABuffer, LAt, false);
  return DoUTF8ToWideAt(LPath, ABuffer, LAt, LLength);
end;

// The folder that holds this program's exe file, in the form WinResolvePath returns, with no
// trailing separator (except at a root). Asked of the OS, so it is right however the program
// was started; "" when the OS cannot tell
public func WinExeDir(): string;
var
  LDir: string;
begin
  LDir := DoExeFolder();
  if LDir = "" then
    return "";
  end;
  return DoFinish(LDir);
end;

// The system's folder for temporary files (GetTempPathW: TMP, TEMP, USERPROFILE or the Windows
// folder), in the form WinResolvePath returns, with no trailing separator (except at a root); ""
// when the system names none
public func WinTempDir(): string;
var
  LBuffer: own WideBox;
  LLength: uint32;
  LDir: string;
  LCount: int64;
begin
  LBuffer := own WideBox();
  LLength := GetTempPathW(uint32(ADAM_WINDOWS_WIDE_MAX + 1), LBuffer.Data);
  if (LLength = 0) or (LLength > uint32(ADAM_WINDOWS_WIDE_MAX)) then
    return "";
  end;
  LDir := WideToUTF8(LBuffer.Data, int32(LLength));
  // GetTempPathW ends in a separator; a root (C:\) keeps its own
  LCount := len(LDir);
  while (LCount > 1) and DoIsSeparator(LDir[LCount - 1]) do
    if (LCount = 3) and (LDir[1] = ':') then
      leave;
    end;
    LCount := LCount - 1;
  end;
  LDir := Substring(LDir, 0, LCount);
  if LDir = "" then
    return "";
  end;
  return WinResolvePath(LDir);
end;

// The system folder (GetSystemDirectoryW: where Windows keeps its DLLs, C:\Windows\System32 on
// most systems), in the form WinResolvePath returns, with no trailing separator (except at a
// root); "" when the system names none
public func WinSystemDir(): string;
var
  LBuffer: own WideBox;
  LLength: uint32;
begin
  LBuffer := own WideBox();
  LLength := GetSystemDirectoryW(LBuffer.Data, uint32(ADAM_WINDOWS_WIDE_MAX + 1));
  // 0 is a failure; a length past the buffer is the size it would need
  if (LLength = 0) or (LLength > uint32(ADAM_WINDOWS_WIDE_MAX)) then
    return "";
  end;
  return WinResolvePath(WideToUTF8(LBuffer.Data, int32(LLength)));
end;

// APath's file attributes, or INVALID_FILE_ATTRIBUTES when it does not exist or cannot
// be read
func DoAttributes(const APath: string): uint32;
var
  LBuffer: own WideBox;
begin
  LBuffer := own WideBox();
  if not DoFilePath(APath, LBuffer.Data) then
    return INVALID_FILE_ATTRIBUTES;
  end;
  return GetFileAttributesW(LBuffer.Data);
end;

// True when APath names an existing file (not a folder); false for a folder, a missing path, ""
// or a path the OS cannot read. The path goes through WinResolvePath first
public func WinFileExists(const APath: string): bool;
var
  LAttributes: uint32;
begin
  LAttributes := DoAttributes(APath);
  if LAttributes = INVALID_FILE_ATTRIBUTES then
    return false;
  end;
  return (LAttributes & FILE_ATTRIBUTE_DIRECTORY) = 0;
end;

// True when APath names an existing folder. The path goes through WinResolvePath first
public func WinDirectoryExists(const APath: string): bool;
var
  LAttributes: uint32;
begin
  LAttributes := DoAttributes(APath);
  if LAttributes = INVALID_FILE_ATTRIBUTES then
    return false;
  end;
  return (LAttributes & FILE_ATTRIBUTE_DIRECTORY) <> 0;
end;

// Deletes a file, as Delphi's WinDeleteFile: a folder is never removed by it. True when the file
// was deleted; false for a folder, a missing path or one the OS refuses (a file open elsewhere)
public func WinDeleteFile(const APath: string): bool;
var
  LBuffer: own WideBox;
begin
  LBuffer := own WideBox();
  if not WinFileExists(APath) then
    return false;
  end;
  if not DoFilePath(APath, LBuffer.Data) then
    return false;
  end;
  return DeleteFileW(LBuffer.Data) <> 0;
end;

// Creates one folder, as Delphi's WinCreateDir: its parent must exist already (nothing above it is
// made). True when the folder was made; false when something of that name exists already (a
// folder or a file), its parent is missing, or the OS refuses it
public func WinCreateDir(const APath: string): bool;
var
  LBuffer: own WideBox;
begin
  LBuffer := own WideBox();
  if not DoFilePath(APath, LBuffer.Data) then
    return false;
  end;
  return CreateDirectoryW(LBuffer.Data, nil) <> 0;
end;

// Removes an empty folder, as Delphi's RemoveDir: a folder that holds anything is left as it
// is. True when it was removed; false when it is not empty, is a file, is missing, or the OS
// refuses it
public func WinRemoveDir(const APath: string): bool;
var
  LBuffer: own WideBox;
begin
  LBuffer := own WideBox();
  if not WinDirectoryExists(APath) then
    return false;
  end;
  if not DoFilePath(APath, LBuffer.Data) then
    return false;
  end;
  return RemoveDirectoryW(LBuffer.Data) <> 0;
end;

// The folder above APath (a resolved path): the text before its last separator, a drive root
// keeping its separator (C:/a -> C:/); "" when there is none
func DoParentDir(const APath: string): string;
var
  LCount: int64;
  LSep: int64;
  LI: int64;
  LParent: string;
begin
  LCount := len(APath);
  while (LCount > 0) and DoIsSeparator(APath[LCount - 1]) do
    LCount := LCount - 1;
  end;
  LSep := -1;
  for LI := 0 to LCount - 1 do
    if DoIsSeparator(APath[LI]) then
      LSep := LI;
    end;
  end;
  if LSep <= 0 then
    return "";
  end;
  LParent := Substring(APath, 0, LSep);
  if (len(LParent) > 0) and (LParent[len(LParent) - 1] = ':') then
    LParent := LParent + APath[LSep];
  end;
  return LParent;
end;

// Creates a folder and every missing folder above it, as Delphi's WinForceDirectories. A folder
// already there is a success. True when the path is a folder afterwards; false when a file is in
// the way, the path is "" or the OS refuses it. A loop, never a recursion, so a deep path
// takes no stack
public func WinForceDirectories(const APath: string): bool;
var
  LPath: string;
  LParent: string;
  LMissing: array of string;
  LCount: int64;
  LI: int64;
  LBuffer: own WideBox;
begin
  LBuffer := own WideBox();
  LPath := WinResolvePath(APath);
  if LPath = "" then
    return false;
  end;
  if WinDirectoryExists(LPath) then
    return true;
  end;
  if WinFileExists(LPath) then
    return false;
  end;
  // The missing folders, the deepest first. Each step up is shorter than the one before:
  // the walk ends at the root
  setlength(LMissing, 1);
  LMissing[0] := LPath;
  LCount := 1;
  LParent := DoParentDir(LPath);
  while (LParent <> "") and (len(LParent) < len(LMissing[LCount - 1])) and
    (not WinDirectoryExists(LParent)) do
    setlength(LMissing, LCount + 1);
    LMissing[LCount] := LParent;
    LCount := LCount + 1;
    LParent := DoParentDir(LParent);
  end;
  // Made from the top down; a file in the way, or a refusal, stops the walk
  for LI := LCount - 1 downto 0 do
    if DoFilePath(LMissing[LI], LBuffer.Data) then
      // A folder another program made meanwhile is still a success: the check below decides
      CreateDirectoryW(LBuffer.Data, nil);
    end;
    if not WinDirectoryExists(LMissing[LI]) then
      return false;
    end;
  end;
  return true;
end;

// Gives a file a new name or moves it, as Delphi's RenameFile, to another drive too (copied,
// then deleted): something at the new name is never replaced (delete it first). True when the
// file was renamed; false when AOldPath is not a file, ANewPath exists already, its folder is
// missing or the OS refuses it
public func WinRenameFile(const AOldPath: string; const ANewPath: string): bool;
var
  LOld: own WideBox;
  LNew: own WideBox;
begin
  LOld := own WideBox();
  LNew := own WideBox();
  if not WinFileExists(AOldPath) then
    return false;
  end;
  if WinFileExists(ANewPath) or WinDirectoryExists(ANewPath) then
    return false;
  end;
  if not DoFilePath(AOldPath, LOld.Data) then
    return false;
  end;
  if not DoFilePath(ANewPath, LNew.Data) then
    return false;
  end;
  // No MOVEFILE_REPLACE_EXISTING: an existing target is refused, never replaced
  return MoveFileExW(LOld.Data, LNew.Data, MOVEFILE_COPY_ALLOWED) <> 0;
end;

// Puts the file ASourcePath in ATargetPath's place in one step: a file already there is
// replaced, never left half written (write a temporary file, then WinReplaceFile it into place).
// True when the file is at ATargetPath afterwards; false when ASourcePath is not a file,
// ATargetPath is a folder, its folder is missing or the OS refuses it (another drive, a target
// open elsewhere)
public func WinReplaceFile(const ASourcePath: string; const ATargetPath: string): bool;
var
  LSource: own WideBox;
  LTarget: own WideBox;
begin
  LSource := own WideBox();
  LTarget := own WideBox();
  if not WinFileExists(ASourcePath) then
    return false;
  end;
  if WinDirectoryExists(ATargetPath) then
    return false;
  end;
  if not DoFilePath(ASourcePath, LSource.Data) then
    return false;
  end;
  if not DoFilePath(ATargetPath, LTarget.Data) then
    return false;
  end;
  return MoveFileExW(LSource.Data, LTarget.Data, MOVEFILE_REPLACE_EXISTING |
    MOVEFILE_WRITE_THROUGH) <> 0;
end;

// Marks the file APath read-only (AReadOnly) or writable again: a read-only file is never
// replaced, renamed over or deleted until it is writable. Its other attributes are kept. True
// when the file has the asked state afterwards; false for a folder, a missing path or one the
// OS refuses
public func WinSetFileReadOnly(const APath: string; const AReadOnly: bool): bool;
var
  LBuffer: own WideBox;
  LAttributes: uint32;
begin
  LBuffer := own WideBox();
  if not WinFileExists(APath) then
    return false;
  end;
  LAttributes := DoAttributes(APath);
  if AReadOnly then
    LAttributes := LAttributes | FILE_ATTRIBUTE_READONLY;
  else
    LAttributes := LAttributes & ~FILE_ATTRIBUTE_READONLY;
  end;
  if not DoFilePath(APath, LBuffer.Data) then
    return false;
  end;
  return SetFileAttributesW(LBuffer.Data, LAttributes) <> 0;
end;

// True when APath names an existing file or folder whose hidden attribute is set (what
// Explorer leaves out of a listing by default); false for a missing path
public func WinIsFileHidden(const APath: string): bool;
var
  LAttributes: uint32;
begin
  LAttributes := DoAttributes(APath);
  if LAttributes = INVALID_FILE_ATTRIBUTES then
    return false;
  end;
  return (LAttributes & FILE_ATTRIBUTE_HIDDEN) <> 0;
end;

// Makes the folder APath (resolved) the process's working folder (SetCurrentDirectoryW: the
// OS's own, never a C runtime hook's). False for a file, a missing path or one the OS refuses
public func WinSetCurrentDir(const APath: string): bool;
var
  LBuffer: own WideBox;
  LPath: string;
begin
  LBuffer := own WideBox();
  if not WinDirectoryExists(APath) then
    return false;
  end;
  // The plain spelling (no \\?\ prefix): the working folder takes no long-path form
  LPath := DoReplaceChar(WinResolvePath(APath), '/', '\\');
  if (LPath = "") or not UTF8ToWide(LPath, LBuffer.Data) then
    return false;
  end;
  return SetCurrentDirectoryW(LBuffer.Data) <> 0;
end;

// Copies the file ASourcePath to ATargetPath (CopyFileW: data, attributes and times), a file
// already there replaced only when AOverwrite. False when ASourcePath is not a file,
// ATargetPath is a folder or exists (not AOverwrite), the two are one file, or the OS refuses
public func WinCopyFile(const ASourcePath: string; const ATargetPath: string;
  const AOverwrite: bool): bool;
var
  LSource: own WideBox;
  LTarget: own WideBox;
  LFailIfExists: int32;
begin
  LSource := own WideBox();
  LTarget := own WideBox();
  if not WinFileExists(ASourcePath) or WinDirectoryExists(ATargetPath) then
    return false;
  end;
  if WinSamePath(ASourcePath, ATargetPath) then
    return false;
  end;
  if not DoFilePath(ASourcePath, LSource.Data) or not DoFilePath(ATargetPath, LTarget.Data) then
    return false;
  end;
  LFailIfExists := 1;
  if AOverwrite then
    LFailIfExists := 0;
  end;
  return CopyFileW(LSource.Data, LTarget.Data, LFailIfExists) <> 0;
end;

// Hands AURL to the shell's "open" verb (ShellExecuteW): the user's browser, mail program or
// the scheme's own handler. True when the shell took it; the caller checks the scheme
public func WinOpenURL(const AURL: string): bool;
var
  LOperation: own WideBox;
  LFile: own WideBox;
begin
  LOperation := own WideBox();
  LFile := own WideBox();
  if not UTF8ToWide("open", LOperation.Data) or not UTF8ToWide(AURL, LFile.Data) then
    return false;
  end;
  // Success is a result above 32 (an HINSTANCE kept for 16-bit Windows' sake)
  return ShellExecuteW(0, LOperation.Data, LFile.Data, nil, nil, int32(SW_SHOWNORMAL)) > 32;
end;

// The value of this process's environment variable AName; "" when it is not set (or set to
// "") or AName is ""
public func WinGetEnvironmentVariable(const AName: string): string;
var
  LName: own WideBox;
  LValue: own WideBox;
  LLength: uint32;
begin
  LName := own WideBox();
  LValue := own WideBox();
  if (AName = "") or not UTF8ToWide(AName, LName.Data) then
    return "";
  end;
  LLength := GetEnvironmentVariableW(LName.Data, LValue.Data, uint32(ADAM_WINDOWS_WIDE_MAX + 1));
  // 0 = not set (or empty); more than the buffer holds = the size it would need
  if (LLength = 0) or (LLength > uint32(ADAM_WINDOWS_WIDE_MAX)) then
    return "";
  end;
  return WideToUTF8(LValue.Data, int32(LLength));
end;

// Sets this process's environment variable AName to AValue (a process it starts inherits
// it); AValue "" leaves it empty, which GetEnvironmentVariable reads as not set. True when
// the variable has the asked value afterwards
public func WinSetEnvironmentVariable(const AName: string; const AValue: string): bool;
var
  LName: own WideBox;
  LValue: own WideBox;
begin
  LName := own WideBox();
  LValue := own WideBox();
  if (AName = "") or not UTF8ToWide(AName, LName.Data) then
    return false;
  end;
  if not UTF8ToWide(AValue, LValue.Data) then
    return false;
  end;
  return SetEnvironmentVariableW(LName.Data, LValue.Data) <> 0;
end;

// This user's folder for caches a program may drop and make again (Windows: the local
// application data folder, %LOCALAPPDATA%), resolved; "" when the OS does not name one. A
// program keeps its own folder below it (<WinUserCacheDir>\<Program>\)
public func WinUserCacheDir(): string;
var
  LDir: string;
begin
  LDir := WinGetEnvironmentVariable(ADAM_WINDOWS_ENV_LOCAL_APP_DATA);
  if LDir = "" then
    return "";
  end;
  return WinResolvePath(LDir);
end;

// The size of a file in bytes, read from the file system without opening it; -1 when it is a
// folder, is missing or the OS refuses it
public func WinFileSize(const APath: string): int64;
var
  LBuffer: own WideBox;
  LData: WIN32_FILE_ATTRIBUTE_DATA;
begin
  LBuffer := own WideBox();
  if not DoFilePath(APath, LBuffer.Data) then
    return -1;
  end;
  if GetFileAttributesExW(LBuffer.Data, GetFileExInfoStandard, LData) = 0 then
    return -1;
  end;
  if (LData.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) <> 0 then
    return -1;
  end;
  return int64((uint64(LData.nFileSizeHigh) shl 32) | uint64(LData.nFileSizeLow));
end;

// When a file was last written, as the file system keeps it (Windows: FILETIME's 100 ns ticks
// since 1601-01-01 UTC), read without opening it: a value to compare with an earlier one,
// never a clock time; -1 when it is a folder, is missing or the OS refuses it
public func WinFileWriteTime(const APath: string): int64;
var
  LBuffer: own WideBox;
  LData: WIN32_FILE_ATTRIBUTE_DATA;
begin
  LBuffer := own WideBox();
  if not DoFilePath(APath, LBuffer.Data) then
    return -1;
  end;
  if GetFileAttributesExW(LBuffer.Data, GetFileExInfoStandard, LData) = 0 then
    return -1;
  end;
  if (LData.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) <> 0 then
    return -1;
  end;
  return int64((uint64(LData.ftLastWriteTime.dwHighDateTime) shl 32) |
    uint64(LData.ftLastWriteTime.dwLowDateTime));
end;

// ACount bytes from the system's secure random generator (BCryptGenRandom, the system-preferred
// RNG) as ABytes; false when the generator fails (ABytes is then empty)
public func WinSecureRandomBytes(const ACount: int64; var ABytes: ByteArray): bool;
var
  LBuffer: ByteBuffer;
  LFrom: int64;
  LCount: int64;
  LI: int64;
begin
  setlength(ABytes, ACount);
  LFrom := 0;
  while LFrom < ACount do
    // The next chunk, at most one buffer
    LCount := ACount - LFrom;
    if LCount > int64(ADAM_WINDOWS_IO_SIZE) then
      LCount := int64(ADAM_WINDOWS_IO_SIZE);
    end;
    if BCryptGenRandom(0, LBuffer, uint32(LCount), BCRYPT_USE_SYSTEM_PREFERRED_RNG) <> 0 then
      setlength(ABytes, 0);
      return false;
    end;
    for LI := 0 to LCount - 1 do
      ABytes[LFrom + LI] := LBuffer[LI];
    end;
    LFrom := LFrom + LCount;
  end;
  return true;
end;

// The file name AData holds, as UTF-8
func DoFindName(var AData: WIN32_FIND_DATAW): string;
var
  LWide: own WideBox;
  LI: int32;
begin
  LWide := own WideBox();
  LI := 0;
  while (LI < 260) and (AData.cFileName[LI] <> 0) do
    LWide.Data[LI] := AData.cFileName[LI];
    LI := LI + 1;
  end;
  return WideToUTF8(LWide.Data, LI);
end;

// ADir without its trailing separators (a drive root keeps none either: "C:" + "\*" is "C:\*")
func DoTrimSeparators(const ADir: string): string;
var
  LLength: int64;
begin
  LLength := len(ADir);
  while (LLength > 0) and DoIsSeparator(ADir[LLength - 1]) do
    LLength := LLength - 1;
  end;
  return Substring(ADir, 0, LLength);
end;

// The names of ADir's entries that are folders (AWantDirectories) or files (not), sorted by
// SortStrings, "." and ".." left out. False when the folder cannot be read; an empty folder is
// true with an empty list
func DoList(const ADir: string; const AWantDirectories: bool; var AList: StringArray): bool;
var
  LBuffer: own WideBox;
  LData: WIN32_FIND_DATAW;
  LFind: uint64;
  LName: string;
  LIsDirectory: bool;
  LCount: int64;
  LOk: bool;
begin
  LBuffer := own WideBox();
  setlength(AList, 0);
  if not DoFilePath(DoTrimSeparators(ADir) + "\\*", LBuffer.Data) then
    return false;
  end;
  LFind := FindFirstFileW(LBuffer.Data, LData);
  if LFind = INVALID_HANDLE_VALUE then
    // A drive root has no "." entry: nothing matched is an empty folder there
    return GetLastError() = ERROR_FILE_NOT_FOUND;
  end;
  LCount := 0;
  LOk := true;
  guard
    repeat
      LName := DoFindName(LData);
      LIsDirectory := (LData.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) <> 0;
      if (LName <> ".") and (LName <> "..") and (LIsDirectory = AWantDirectories) then
        setlength(AList, LCount + 1);
        AList[LCount] := LName;
        LCount := LCount + 1;
      end;
    until FindNextFileW(LFind, LData) = 0;
    // The listing ends at "no more files"; any other failure cut it short
    LOk := GetLastError() = ERROR_NO_MORE_FILES;
  finally
    FindClose(LFind);
  end;
  if not LOk then
    setlength(AList, 0);
    return false;
  end;
  SortStrings(AList);
  return true;
end;

// The names of the files in ADir (no folders), sorted by their bytes. False when the folder
// cannot be read. The path goes through WinResolvePath first
public func WinGetFiles(const ADir: string; var AList: StringArray): bool;
begin
  return DoList(ADir, false, AList);
end;

// The names of the folders in ADir ("." and ".." left out), sorted by their bytes. False when
// the folder cannot be read. The path goes through WinResolvePath first
public func WinGetDirectories(const ADir: string; var AList: StringArray): bool;
begin
  return DoList(ADir, true, AList);
end;

// Reads ARead to EOF (the pipe breaks when every writer has closed it), appending the bytes to
// AOutput as they came
func DoReadAll(const ARead: uint64; var AOutput: string);
var
  LBuffer: ByteBuffer;
  LCount: uint32;
  LOld: int64;
  LI: int64;
begin
  while true do
    LCount := 0;
    if ReadFile(ARead, addr of LBuffer, ADAM_WINDOWS_IO_SIZE, LCount, nil) = 0 then
      leave;
    end;
    LOld := len(AOutput);
    setlength(AOutput, LOld + int64(LCount));
    for LI := 0 to int64(LCount) - 1 do
      AOutput[LOld + LI] := char(LBuffer[LI]);
    end;
  end;
end;

// Starts the process (stdin ANul, stdout and stderr AWrite), reads its output to EOF, waits for
// it and takes its exit code; closes the write end once the child holds it, and the process and
// thread handles on every path. False when it does not start or its exit code cannot be read
func DoStartAndRead(var AApplication: WideBuffer; var ACommandLine: WideBuffer;
  var ADirectory: WideBuffer; const ANul: uint64; var AWrite: uint64; const ARead: uint64;
  var AOutput: string; var AExitCode: uint32): bool;
var
  LStartup: STARTUPINFOW;
  LInfo: PROCESS_INFORMATION;
  LStarted: bool;
  LOk: bool;
begin
  LStartup.cb := uint32(size(STARTUPINFOW));
  LStartup.dwFlags := STARTF_USESTDHANDLES | STARTF_USESHOWWINDOW;
  LStartup.wShowWindow := SW_HIDE;
  LStartup.hStdInput := ANul;
  LStartup.hStdOutput := AWrite;
  LStartup.hStdError := AWrite;
  LStarted := CreateProcessW(AApplication, ACommandLine, nil, nil, 1,
    NORMAL_PRIORITY_CLASS, nil, ADirectory, LStartup, LInfo) <> 0;
  // Only the child holds the write end now: the pipe breaks when it exits, so the read below
  // ends on EOF
  CloseHandle(AWrite);
  AWrite := 0;
  if not LStarted then
    return false;
  end;
  LOk := false;
  guard
    DoReadAll(ARead, AOutput);
    WaitForSingleObject(LInfo.hProcess, INFINITE);
    LOk := GetExitCodeProcess(LInfo.hProcess, AExitCode) <> 0;
  finally
    CloseHandle(LInfo.hProcess);
    CloseHandle(LInfo.hThread);
  end;
  return LOk;
end;

// A program's path as CreateProcessW's application (StdApp.Utils' LaunchName): WinResolvePath's
// spelling with '\', plain up to ADAM_WINDOWS_SHORT_PATH_MAX and long (\\?\) only past it.
// Never the long spelling for a short path: it becomes the child's own image path, and a
// program that builds paths or URLs from it (Electron's page) breaks on the prefix
func DoLaunchPath(const APath: string; var ABuffer: WideBuffer): bool;
var
  LPath: string;
  LLength: int32;
begin
  ABuffer[0] := 0;
  LPath := DoReplaceChar(WinResolvePath(APath), '/', '\\');
  if LPath = "" then
    return false;
  end;
  return DoUTF8ToWideAt(LPath, ABuffer, 0, LLength);
end;

// What CreateProcessW takes for AExe run with AArgs in AWorkDir ("" = this process's folder):
// the application, the command line and the folder, as UTF-16. False when one cannot be made
public func WinProcessTexts(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AApplication: WideBuffer; var ACommandLine: WideBuffer; var ADirectory: WideBuffer): bool;
var
  LCommand: string;
  LWorkDir: string;
  LI: int64;
begin
  // The program is named twice: as the application (full, no search; plain unless only the
  // long-path form reaches it: DoLaunchPath) and quoted as the command line's first argument
  // (argv[0] for the child), as the caller named it but with '\': a child that scans its
  // command line for '/' switches (cmd.exe) would read "System32/cmd.exe" as /c
  LCommand := QuoteArg(DoReplaceChar(AExe, '/', '\\'));
  for LI := 0 to len(AArgs) - 1 do
    LCommand := LCommand + " " + QuoteArg(AArgs[LI]);
  end;
  LWorkDir := AWorkDir;
  if LWorkDir = "" then
    LWorkDir := ".";
  end;
  if not DoLaunchPath(AExe, AApplication) then
    return false;
  end;
  if not UTF8ToWide(LCommand, ACommandLine) then
    return false;
  end;
  return UTF8ToWide(LWorkDir, ADirectory);
end;

// Runs AExe (the path of the exe file itself, its extension included: no PATH search; it goes
// through WinResolvePath) with AArgs, in AWorkDir ("" = this process's folder), on this process's
// own stdin, stdout and stderr: it reads and writes where this process does (a console, a
// pipe, a file), as if the shell had started it. AExitCode gets its exit code. False when it
// cannot start or its exit code cannot be read. Its process and thread handles are closed on
// every path
public func WinRunAttached(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32): bool;
var
  LApplication: own WideBox;
  LCommandLine: own WideBox;
  LDirectory: own WideBox;
  LStartup: STARTUPINFOW;
  LInfo: PROCESS_INFORMATION;
  LOk: bool;
begin
  LApplication := own WideBox();
  LCommandLine := own WideBox();
  LDirectory := own WideBox();
  AExitCode := 0;
  if not WinProcessTexts(AExe, AArgs, AWorkDir, LApplication.Data, LCommandLine.Data,
    LDirectory.Data) then
    return false;
  end;
  // This process's standard handles, handed on (inherited) as the child's own
  LStartup.cb := uint32(size(STARTUPINFOW));
  LStartup.dwFlags := STARTF_USESTDHANDLES;
  LStartup.hStdInput := GetStdHandle(STD_INPUT_HANDLE);
  LStartup.hStdOutput := GetStdHandle(STD_OUTPUT_HANDLE);
  LStartup.hStdError := GetStdHandle(STD_ERROR_HANDLE);
  if CreateProcessW(LApplication.Data, LCommandLine.Data, nil, nil, 1,
    NORMAL_PRIORITY_CLASS, nil, LDirectory.Data, LStartup, LInfo) = 0 then
    return false;
  end;
  LOk := false;
  guard
    WaitForSingleObject(LInfo.hProcess, INFINITE);
    LOk := GetExitCodeProcess(LInfo.hProcess, AExitCode) <> 0;
  finally
    CloseHandle(LInfo.hProcess);
    CloseHandle(LInfo.hThread);
  end;
  return LOk;
end;

// What the pipe APipe holds now appended to AText (no wait: an empty pipe adds nothing), in
// reads of ADAM_WINDOWS_IO_SIZE bytes. False when the pipe is closed or broken (every writer
// gone and nothing left in it)
public func WinReadAvailable(const APipe: uint64; var AText: string): bool;
var
  LBuffer: ByteBuffer;
  LAvailable: uint32;
  LWant: uint32;
  LRead: uint32;
  LOld: int64;
  LI: int64;
begin
  while true do
    LAvailable := 0;
    if PeekNamedPipe(APipe, nil, 0, nil, LAvailable, nil) = 0 then
      return false;
    end;
    if LAvailable = 0 then
      return true;
    end;
    LWant := LAvailable;
    if LWant > ADAM_WINDOWS_IO_SIZE then
      LWant := ADAM_WINDOWS_IO_SIZE;
    end;
    LRead := 0;
    if ReadFile(APipe, addr of LBuffer, LWant, LRead, nil) = 0 then
      return false;
    end;
    // Grown once per read, then filled (no append per byte)
    LOld := len(AText);
    setlength(AText, LOld + int64(LRead));
    for LI := 0 to int64(LRead) - 1 do
      AText[LOld + LI] := char(LBuffer[LI]);
    end;
  end;
end;

// One read of the pipe APipe (waits until it holds bytes) appended to AText. False when the
// pipe is closed or broken: every writer gone, nothing left (the end of a child's output)
public func WinReadSome(const APipe: uint64; var AText: string): bool;
var
  LBuffer: ByteBuffer;
  LRead: uint32;
  LOld: int64;
  LI: int64;
begin
  LRead := 0;
  if (ReadFile(APipe, addr of LBuffer, ADAM_WINDOWS_IO_SIZE, LRead, nil) = 0) or
    (LRead = 0) then
    return false;
  end;
  LOld := len(AText);
  setlength(AText, LOld + int64(LRead));
  for LI := 0 to int64(LRead) - 1 do
    AText[LOld + LI] := char(LBuffer[LI]);
  end;
  return true;
end;

// The bytes ABytes in the OEM code page (CP_OEMCP: what a console tool writes that does not
// write UTF-8) as UTF-8 text. Converted in pieces of at most ADAM_WINDOWS_WIDE_MAX bytes (one
// OEM byte gives at most one UTF-16 unit), a piece never ending inside a double-byte character
public func WinOemToUTF8(const ABytes: string): string;
var
  LWide: own WideBox;
  LText: string;
  LAt: int64;
  LEnd: int64;
  LNext: int64;
  LUnits: int32;
begin
  LWide := own WideBox();
  LText := "";
  LAt := 0;
  while LAt < len(ABytes) do
    // The piece: whole characters (a lead byte takes its trail byte along) up to the cap
    LEnd := LAt;
    while LEnd < len(ABytes) do
      LNext := LEnd + 1;
      if (IsDBCSLeadByteEx(CP_OEMCP, uint8(ABytes[LEnd])) <> 0) and (LNext < len(ABytes)) then
        LNext := LNext + 1;
      end;
      if LNext - LAt > int64(ADAM_WINDOWS_WIDE_MAX) then
        leave;
      end;
      LEnd := LNext;
    end;
    LUnits := MultiByteToWideChar(CP_OEMCP, 0, ptr to const(addr of ABytes[LAt]),
      int32(LEnd - LAt), ptr(addr of LWide.Data[0]), int32(ADAM_WINDOWS_WIDE_MAX));
    if LUnits > 0 then
      LText := LText + WideToUTF8(LWide.Data, LUnits);
    end;
    LAt := LEnd;
  end;
  return LText;
end;

// ClosePseudoConsole as a task runs it (PseudoConsole.Close)
func DoClosePseudoConsole(const AConsole: uint64);
begin
  ClosePseudoConsole(AConsole);
end;

// A pseudo console's side: ASide held to 1..32767 (COORD's int16)
func DoConsoleSide(const ASide: int32): int32;
begin
  if ASide < 1 then
    return 1;
  end;
  if ASide > 32767 then
    return 32767;
  end;
  return ASide;
end;

// A handle this unit opened, closed (0 / INVALID_HANDLE_VALUE: none)
func DoCloseOpened(const AHandle: uint64);
begin
  if (AHandle <> 0) and (AHandle <> INVALID_HANDLE_VALUE) then
    CloseHandle(AHandle);
  end;
end;

public type
  // A pseudo console (ConPTY) a started program takes as its console (StdApp.Utils'
  // CaptureConsolePTY; System.IO's captured runs and the debugger's Terminal mode both use
  // it): CreatePseudoConsole over two plain pipes, nothing inheritable, so the program reaches
  // only the pseudo console. Open makes it; AttributeList names it (and a standard input of
  // the program's own) for STARTUPINFOEXW; Output is its output pipe's read end (VT text,
  // UTF-8), WriteKeys writes its input pipe, Resize sizes it. Close closes it on a task while
  // this thread reads its output to the pipe's break: it writes out what it still holds first
  // (an older Windows waits in ClosePseudoConsole for that drain), so nothing is lost to timing
  PseudoConsole = object
    // The HPCON (0 = none), its input pipe's write end and output pipe's read end
    hidden FConsole: uint64;
    hidden FInput: uint64;
    hidden FOutput: uint64;
    // The attribute list AttributeList made and the handle its handle list names (kept here:
    // the list points at it until CreateProcessW returned)
    hidden FList: ByteArray;
    hidden FListMade: bool;
    hidden FStdin: uint64;

    // Made at ACols x ARows (each held to 1..32767); 0, else Windows' reason (a GetLastError
    // code, or CreatePseudoConsole's HRESULT); nothing is left open when it fails. One still
    // open is closed first (its last output dropped)
    method Open(const ACols: int32; const ARows: int32): uint32;
    var
      LSecurity: SECURITY_ATTRIBUTES;
      LInputRead: uint64;
      LOutputWrite: uint64;
      LSize: COORD;
      LResult: int32;
      LError: uint32;
      LDropped: string;
    begin
      if self.FConsole <> 0 then
        self.Close(LDropped);
      end;
      // Two plain pipes, nothing inheritable; the pseudo console keeps its own copies of the
      // ends it is given, closed here
      LSecurity.nLength := uint32(size(SECURITY_ATTRIBUTES));
      LSecurity.bInheritHandle := 0;
      LInputRead := 0;
      LOutputWrite := 0;
      if CreatePipe(LInputRead, self.FInput, LSecurity, 0) = 0 then
        LError := GetLastError();
        self.FInput := 0;
        return LError;
      end;
      if CreatePipe(self.FOutput, LOutputWrite, LSecurity, 0) = 0 then
        LError := GetLastError();
        self.FOutput := 0;
        CloseHandle(LInputRead);
        DoCloseOpened(self.FInput);
        self.FInput := 0;
        return LError;
      end;
      LSize.X := int16(DoConsoleSide(ACols));
      LSize.Y := int16(DoConsoleSide(ARows));
      LResult := CreatePseudoConsole(LSize, LInputRead, LOutputWrite, 0, self.FConsole);
      CloseHandle(LInputRead);
      CloseHandle(LOutputWrite);
      if LResult <> 0 then
        self.FConsole := 0;
        DoCloseOpened(self.FInput);
        DoCloseOpened(self.FOutput);
        self.FInput := 0;
        self.FOutput := 0;
        return uint32(LResult);
      end;
      return 0;
    end;

    // Made and not yet closed
    method IsOpen(): bool;
    begin
      return self.FConsole <> 0;
    end;

    // The output pipe's read end (0 when not open): read with WinReadAvailable / WinReadSome
    method Output(): uint64;
    begin
      return self.FOutput;
    end;

    // The list for STARTUPINFOEXW.lpAttributeList: this pseudo console, and with AStdin <> 0
    // that handle as the only one the program inherits (CreateProcessW's bInheritHandles 1
    // then, AStdin inheritable and open until it returned). nil when not open or Windows
    // refuses. ReleaseList frees it after CreateProcessW
    method AttributeList(const AStdin: uint64): ptr;
    var
      LCount: uint32;
      LSize: uint64;
    begin
      self.ReleaseList();
      if self.FConsole = 0 then
        return nil;
      end;
      self.FStdin := AStdin;
      LCount := 1;
      if AStdin <> 0 then
        LCount := 2;
      end;
      LSize := 0;
      InitializeProcThreadAttributeList(nil, LCount, 0, LSize);
      setlength(self.FList, int64(LSize));
      if (len(self.FList) = 0) or
        (InitializeProcThreadAttributeList(ptr(addr of self.FList[0]), LCount, 0, LSize) = 0) then
        return nil;
      end;
      self.FListMade := true;
      if UpdateProcThreadAttribute(ptr(addr of self.FList[0]), 0,
        PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE, ptr(self.FConsole), 8, nil, nil) = 0 then
        self.ReleaseList();
        return nil;
      end;
      if (AStdin <> 0) and (UpdateProcThreadAttribute(ptr(addr of self.FList[0]), 0,
        PROC_THREAD_ATTRIBUTE_HANDLE_LIST, ptr(addr of self.FStdin), 8, nil, nil) = 0) then
        self.ReleaseList();
        return nil;
      end;
      return ptr(addr of self.FList[0]);
    end;

    // AttributeList's list freed (nothing when there is none)
    method ReleaseList();
    begin
      if self.FListMade then
        DeleteProcThreadAttributeList(ptr(addr of self.FList[0]));
        self.FListMade := false;
      end;
      setlength(self.FList, 0);
      self.FStdin := 0;
    end;

    // AText (UTF-8 keys) written whole into the program's terminal. False when not open or
    // the pipe is gone
    method WriteKeys(const AText: string): bool;
    var
      LDone: int64;
      LWritten: uint32;
    begin
      if (self.FConsole = 0) or (self.FInput = 0) then
        return false;
      end;
      LDone := 0;
      while LDone < len(AText) do
        LWritten := 0;
        if (WriteFile(self.FInput, ptr to const(addr of AText[LDone]),
          uint32(len(AText) - LDone), LWritten, nil) = 0) or (LWritten = 0) then
          return false;
        end;
        LDone := LDone + int64(LWritten);
      end;
      return true;
    end;

    // The terminal's new size (each side held to 1..32767). False when not open or refused
    method Resize(const ACols: int32; const ARows: int32): bool;
    var
      LSize: COORD;
    begin
      if self.FConsole = 0 then
        return false;
      end;
      LSize.X := int16(DoConsoleSide(ACols));
      LSize.Y := int16(DoConsoleSide(ARows));
      return ResizePseudoConsole(self.FConsole, LSize) = 0;
    end;

    // Closed (see the type): what it still writes out appended to ATail, then both pipe ends
    // and the list. Nothing when it is not open (its pipe ends still closed)
    method Close(var ATail: string);
    var
      LConsole: uint64;
      LCloser: task;
    begin
      if self.FConsole <> 0 then
        LConsole := self.FConsole;
        self.FConsole := 0;
        LCloser := async DoClosePseudoConsole(LConsole);
        if self.FOutput <> 0 then
          while WinReadSome(self.FOutput, ATail) do
          end;
        end;
        await LCloser;
      end;
      self.ReleaseList();
      DoCloseOpened(self.FInput);
      DoCloseOpened(self.FOutput);
      self.FInput := 0;
      self.FOutput := 0;
    end;

    // One still open at the end is closed (its last output dropped)
    done;
    var
      LDropped: string;
    begin
      self.Close(LDropped);
    end;
  end;

// StdApp.Utils' RunPE: runs AExe (the path of the exe file itself, its extension included: the
// application named in full, no PATH search; it goes through WinResolvePath) with AArgs, in
// AWorkDir ("" = this process's folder), shown as AShowCmd (SW_*), no handle inherited, a
// Unicode environment. AWait: waits for it and takes its exit code into AExitCode; else it runs
// on (it may outlive this process) and AExitCode is 0. False when it cannot start or its exit
// code cannot be read. Its process and thread handles are closed on every path
public func WinRunPE(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  const AWait: bool; const AShowCmd: uint16; var AExitCode: uint32): bool;
var
  LApplication: own WideBox;
  LCommandLine: own WideBox;
  LDirectory: own WideBox;
  LStartup: STARTUPINFOW;
  LInfo: PROCESS_INFORMATION;
  LOk: bool;
begin
  LApplication := own WideBox();
  LCommandLine := own WideBox();
  LDirectory := own WideBox();
  AExitCode := 0;
  if not WinProcessTexts(AExe, AArgs, AWorkDir, LApplication.Data, LCommandLine.Data,
    LDirectory.Data) then
    return false;
  end;
  LStartup.cb := uint32(size(STARTUPINFOW));
  LStartup.dwFlags := STARTF_USESHOWWINDOW;
  LStartup.wShowWindow := AShowCmd;
  if CreateProcessW(LApplication.Data, LCommandLine.Data, nil, nil, 0,
    CREATE_UNICODE_ENVIRONMENT, nil, LDirectory.Data, LStartup, LInfo) = 0 then
    return false;
  end;
  LOk := true;
  guard
    if AWait then
      WaitForSingleObject(LInfo.hProcess, INFINITE);
      LOk := GetExitCodeProcess(LInfo.hProcess, AExitCode) <> 0;
    end;
  finally
    CloseHandle(LInfo.hThread);
    CloseHandle(LInfo.hProcess);
  end;
  return LOk;
end;

// Runs AExe (the path of the exe file itself, its extension included: no PATH search; it goes
// through WinResolvePath) with AArgs, in AWorkDir ("" = this process's folder). stdin is NUL;
// stdout and stderr go to one pipe, so AOutput holds the bytes in the order written; AExitCode
// gets the exit code. False when it cannot start or its exit code cannot be read (AOutput then
// holds what was read, if anything). Every handle it opens is closed on every path
public func WinRunProcess(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AOutput: string; var AExitCode: uint32): bool;
var
  LApplication: own WideBox;
  LCommandLine: own WideBox;
  LDirectory: own WideBox;
  LNulName: own WideBox;
  LAttributes: SECURITY_ATTRIBUTES;
  LRead: uint64;
  LWrite: uint64;
  LNul: uint64;
  LOk: bool;
begin
  LApplication := own WideBox();
  LCommandLine := own WideBox();
  LDirectory := own WideBox();
  LNulName := own WideBox();
  AOutput := "";
  AExitCode := 0;
  if not WinProcessTexts(AExe, AArgs, AWorkDir, LApplication.Data, LCommandLine.Data,
    LDirectory.Data) then
    return false;
  end;
  if not UTF8ToWide("NUL", LNulName.Data) then
    return false;
  end;

  // Both pipe ends inheritable; the read end is made private below, so a child never holds it
  LAttributes.nLength := uint32(size(SECURITY_ATTRIBUTES));
  LAttributes.lpSecurityDescriptor := nil;
  LAttributes.bInheritHandle := 1;
  LRead := 0;
  LWrite := 0;
  if CreatePipe(LRead, LWrite, LAttributes, 0) = 0 then
    return false;
  end;
  LNul := INVALID_HANDLE_VALUE;
  LOk := false;
  guard
    if SetHandleInformation(LRead, HANDLE_FLAG_INHERIT, 0) <> 0 then
      LNul := CreateFileW(LNulName.Data, GENERIC_READ,
        FILE_SHARE_READ | FILE_SHARE_WRITE, LAttributes, OPEN_EXISTING, 0, 0);
    end;
    if LNul <> INVALID_HANDLE_VALUE then
      LOk := DoStartAndRead(LApplication.Data, LCommandLine.Data, LDirectory.Data, LNul, LWrite,
        LRead, AOutput, AExitCode);
    end;
  finally
    CloseHandle(LRead);
    if LWrite <> 0 then
      CloseHandle(LWrite);
    end;
    if LNul <> INVALID_HANDLE_VALUE then
      CloseHandle(LNul);
    end;
  end;
  return LOk;
end;

// Waits AMilliseconds, then returns: at least that long (Sleep; the OS may wake the program a
// little later). A wait of 0 or less returns at once
public func WinDelay(const AMilliseconds: int32);
begin
  if AMilliseconds > 0 then
    Sleep(uint32(AMilliseconds));
  end;
end;

// Milliseconds since the system started (GetTickCount64): only the difference of two
// readings means anything, a duration (a build's time)
public func WinTickCountMs(): int64;
begin
  return int64(GetTickCount64());
end;

// The high-resolution counter's reading (QueryPerformanceCounter): never going back, only the
// difference of two readings means anything, in WinPerformanceFrequency's units
public func WinPerformanceCounter(): int64;
var
  LCount: int64;
begin
  LCount := 0;
  QueryPerformanceCounter(LCount);
  return LCount;
end;

// The high-resolution counter's counts per second (QueryPerformanceFrequency: fixed at boot,
// never 0 on Windows XP and later)
public func WinPerformanceFrequency(): int64;
var
  LFrequency: int64;
begin
  LFrequency := 0;
  QueryPerformanceFrequency(LFrequency);
  return LFrequency;
end;

type
  // ucrt's formatter (__stdio_common_vsprintf), found in the C runtime by name
  WinVsprintfFn = func(const AOptions: uint64; const ABuffer: ptr to char; const ACount: uint64;
    const AFormat: ptr to const char; const ALocale: ptr; const AArgs: ptr): int32;

var
  // __stdio_common_vsprintf (nil until WinFormatCList first looks it up)
  GWinVsprintf: ptr;

// System.IO's FormatCList: the text of the C format AFormat over the C va_list AArgs, by
// ucrt's own formatter, measured then filled (a Windows va_list points at the arguments, so
// each call reads them anew); "" when the C runtime has no formatter or refuses the format
public func WinFormatCList(const AFormat: ptr to const char; const AArgs: ptr): string;
var
  LFormatFn: WinVsprintfFn;
  LText: array of char;
  LLength: int32;
begin
  if GWinVsprintf = nil then
    GWinVsprintf := FindCRuntimeFunction(ptr to const char("__stdio_common_vsprintf"));
  end;
  if (GWinVsprintf = nil) or (AFormat = nil) then
    return "";
  end;
  LFormatFn := WinVsprintfFn(GWinVsprintf);
  LLength := LFormatFn(_CRT_INTERNAL_PRINTF_STANDARD_SNPRINTF_BEHAVIOR, nil, 0, AFormat, nil,
    AArgs);
  if LLength < 0 then
    return "";
  end;
  setlength(LText, int64(LLength) + 1);
  LLength := LFormatFn(_CRT_INTERNAL_PRINTF_STANDARD_SNPRINTF_BEHAVIOR, addr of LText[0],
    uint64(LLength) + 1, AFormat, nil, AArgs);
  if LLength < 0 then
    return "";
  end;
  return StringFromC(addr of LText[0], int64(LLength));
end;

end.
