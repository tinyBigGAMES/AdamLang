public routine SDL_MIXER_VERSION_ATLEAST<T1, T2, T3>(const X: T1; const Y: T2; const Z: T3): int32;
begin
  return int32((((3 >= X) and ((3 > X) or (2 >= Y))) and (((3 > X) or (2 > Y)) or (4 >= Z))));
end;

end.
