  System.SDL3_mixer.C.adam - SDL3_mixer's C API (Sam Lantinga, zlib license,
  release-3.2.4: mixers, tracks, groups, decoders for WAV, AIFF, VOC, AU,
  FLAC, MP3, Ogg Vorbis and MIDI), written by `adam cimport` from the
  header libsdl3_mixer.a is built with (res/libs/vendor/include/sdl3_mixer)
  with its own names: every routine `external "sdl3_mixer"`
  (libsdl3_mixer.a in res/libs/vendor/<triple>, built by AdamLang-Libs).
  SDL_mixer.h includes SDL.h, so SDL3's declarations are System.SDL3.C's
  (imported); the mixer plays through SDL3, so the unit links libsdl3.a
  with @linklibrary. Do not edit: a change belongs in the spec,
  res/cimport/System.SDL3_mixer.C.cimport.toml, then regenerate.
*******************************************************************************/

// System.SDL3_mixer.C.adam - written by adam cimport for x86_64-windows-gnu, x86_64-linux-gnu
// from System.SDL3_mixer.C.cimport.toml (SDL3_mixer/SDL_mixer.h).
// Regenerate it with adam cimport; a change belongs in the spec
// ([renames], [skip], [[insert]]).

module unit System.SDL3_mixer.C;

@linklibrary "sdl3";

import System.SDL3.C;

public type
  MIX_Mixer = record
  end;

  MIX_Audio = record
  end;

  MIX_Track = record
  end;

  MIX_Group = record
  end;

  MIX_StereoGains = record
    left: float32;
    right: float32;
  end;

  MIX_Point3D = record
    x: float32;
    y: float32;
    z: float32;
  end;

  MIX_TrackStoppedCallback = routine clink(userdata: ptr; track: ptr to MIX_Track);
  MIX_TrackMixCallback = routine clink(userdata: ptr; track: ptr to MIX_Track; spec: ptr to const SDL_AudioSpec; pcm: ptr to float32; samples: int32);
  MIX_GroupMixCallback = routine clink(userdata: ptr; group: ptr to MIX_Group; spec: ptr to const SDL_AudioSpec; pcm: ptr to float32; samples: int32);
  MIX_PostMixCallback = routine clink(userdata: ptr; mixer: ptr to MIX_Mixer; spec: ptr to const SDL_AudioSpec; pcm: ptr to float32; samples: int32);

  MIX_AudioDecoder = record
  end;

public const
  SDL_MIXER_MAJOR_VERSION: int32 = 3;
