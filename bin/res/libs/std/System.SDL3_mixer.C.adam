  MIX_PROP_PLAY_APPEND_SILENCE_MILLISECONDS_NUMBER: string = "SDL_mixer.play.append_silence_milliseconds";
  MIX_PROP_PLAY_HALT_WHEN_EXHAUSTED_BOOLEAN: string = "SDL_mixer.play.halt_when_exhausted";

