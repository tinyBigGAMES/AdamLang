-------------------------------------------------------------------------------
  System.Toml.C.adam - the C API of tomlc17 (CK Tan, TOML v1.0 / v1.1, MIT),
  declared by hand from tomlc17.h (release R261003) with the header's own
  names: its types as records laid out as C lays them out, its 12 routines
  as `external "tomlc17"` (libtomlc17.a in res/libs/vendor/<triple>, built
  by AdamLang-Libs). M9's importer regenerates this file later; System.Toml
  is the Adam API over it.

  The header's mapping: enum toml_type_t (int-sized) is toml_type_t = int32
  with its TOML_* values; `int` is int32, `size_t` uint64, `bool` bool,
  `FILE *` ptr. A name that is an Adam keyword takes a trailing '_' (the
  datum's `type`, the union's `int64`, str's `ptr`, realloc's `ptr`). A
  member whose type has no name in C (the union u, its structs str / ts /
  arr / tab) gets a type named by its member path: toml_datum_t_u,
  toml_datum_t_u_str ... (Adam has no inline type in a field). The obsolete
  static inline toml_table_find is not exported, so it is not here.
  Sizes, as C gives them on every 64-bit target: toml_datum_t 56 bytes,
  toml_result_t 272. Every routine moves a datum or a result by value (C
  linkage: a `const` parameter is by value too, BNF sec 3). Target-neutral:
  no OS named.
*******************************************************************************/

module unit System.Toml.C;

public const
  TOMLC17_RELEASE_AFTER: string = "260618";

public type
  // enum toml_type_t: the kind of a datum
  toml_type_t = int32;

public const
  TOML_UNKNOWN: toml_type_t = 0;
  TOML_STRING: toml_type_t = 1;
  TOML_INT64: toml_type_t = 2;
  TOML_FP64: toml_type_t = 3;
  TOML_BOOLEAN: toml_type_t = 4;
  TOML_DATE: toml_type_t = 5;
  TOML_TIME: toml_type_t = 6;
  TOML_DATETIME: toml_type_t = 7;
  TOML_DATETIMETZ: toml_type_t = 8;
  TOML_ARRAY: toml_type_t = 9;
  TOML_TABLE: toml_type_t = 10;
  // Bit values for toml_datum_t's flag: inline form, a [table] header, an explicit table
  TOML_FLAG_INLINED: uint32 = 1;
  TOML_FLAG_STDEXPR: uint32 = 2;
  TOML_FLAG_EXPLICIT: uint32 = 4;

public forward type toml_datum_t;

public type
  // u.str: NUL-terminated, len bytes before the NUL
  toml_datum_t_u_str = record
    ptr_: ptr to const char;
    len: int32;
  end;

  // u.ts: a date / time datum's parts; tz is the offset in minutes
  toml_datum_t_u_ts = record
    year: int16;
    month: int16;
    day: int16;
    hour: int16;
    minute: int16;
    second: int16;
    usec: int32;
    tz: int16;
  end;

  // u.arr: size elements at elem
  toml_datum_t_u_arr = record
    size: int32;
    elem: ptr to toml_datum_t;
  end;

  // u.tab: size keys (key[i], len[i] bytes) and their value[i]
  toml_datum_t_u_tab = record
    size: int32;
    key: ptr to ptr to const char;
    len: ptr to int32;
    value: ptr to toml_datum_t;
  end;

  // toml_datum_t's union u: the member type_ names is the one that holds; s is a
  // shorthand for str.ptr_
  toml_datum_t_u = overlay
    s: ptr to const char;
    str: toml_datum_t_u_str;
    int64_: int64;
    fp64: float64;
    boolean: bool;
    ts: toml_datum_t_u_ts;
    arr: toml_datum_t_u_arr;
    tab: toml_datum_t_u_tab;
  end;

  // One node of a parsed document; lineno / colno 1-based (0 when synthesized);
  // source the name given to the parse (nil if none), owned by the result
  toml_datum_t = record
    type_: toml_type_t;
    flag: uint32;
    lineno: int32;
    colno: int32;
    source: ptr to const char;
    u: toml_datum_t_u;
  end;

  // A parse's result: toptab holds when ok, else errmsg (NUL-terminated); __internal is
  // the library's own state
  toml_result_t = record
    ok: bool;
    toptab: toml_datum_t;
    errmsg: array[0..199] of char;
    __internal: ptr;
  end;

  // The parser's global options
  toml_option_t = record
    check_utf8: bool;
    mem_realloc: routine clink(ptr_: ptr; size: uint64): ptr;
    mem_free: routine clink(ptr_: ptr);
  end;

// A document of len bytes at src (no NUL needed)
public routine clink toml_parse(src: ptr to const char; len: int32): toml_result_t;
  external "tomlc17";
// As toml_parse, every datum's source set to a copy of name (or nil)
public routine clink toml_parse_named(src: ptr to const char; len: int32;
  name: ptr to const char): toml_result_t; external "tomlc17";
// A document read from the open C FILE fp (the caller closes it)
public routine clink toml_parse_file(fp: ptr): toml_result_t; external "tomlc17";
// As toml_parse_file, every datum's source set to a copy of name (or nil)
public routine clink toml_parse_file_named(fp: ptr; name: ptr to const char): toml_result_t;
  external "tomlc17";
// A document read from the file at the path fname (C's fopen: an ANSI path on Windows)
public routine clink toml_parse_file_ex(fname: ptr to const char): toml_result_t;
  external "tomlc17";
// Releases what result holds; every result is freed once
public routine clink toml_free(result: toml_result_t); external "tomlc17";
// The value of key in table, or a datum of type_ TOML_UNKNOWN
public routine clink toml_get(table: toml_datum_t; key: ptr to const char): toml_datum_t;
  external "tomlc17";
// The value at the dotted key multipart_key (no escapes, 255 bytes at most) from table,
// or a datum of type_ TOML_UNKNOWN
public routine clink toml_seek(table: toml_datum_t; multipart_key: ptr to const char): toml_datum_t;
  external "tomlc17";
// A new result: r1 with r2 merged over it (all three freed on their own)
public routine clink toml_merge(r1: ptr to const toml_result_t;
  r2: ptr to const toml_result_t): toml_result_t; external "tomlc17";
// True when the two documents are equivalent (tables unordered, arrays ordered)
public routine clink toml_equiv(r1: ptr to const toml_result_t;
  r2: ptr to const toml_result_t): bool; external "tomlc17";
// The parser's default options
public routine clink toml_default_option(): toml_option_t; external "tomlc17";
// Sets the parser's global options
public routine clink toml_set_option(opt: toml_option_t); external "tomlc17";

end.
