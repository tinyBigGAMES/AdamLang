-------------------------------------------------------------------------------
  System.Toml.C.adam - the C API of tomlc17 (CK Tan, TOML v1.0 / v1.1, MIT),
  declared by hand from tomlc17.h (release R261003): its types as records
  laid out as C lays them out, its 12 routines as `external "tomlc17"`
  (libtomlc17.a in res/libs/vendor/<triple>, built by AdamLang-Libs). M9's
  importer regenerates this file later; System.Toml is the Adam API over it.

  The header's mapping: toml_type_t (a C enum, int-sized) is int32 with the
  ADAM_TOML_* values; `int` is int32, `size_t` uint64, `bool` bool. The
  datum's anonymous union is the named overlay TomlValue, its anonymous
  structs the named records TomlStr / TomlStamp / TomlArray / TomlTable
  (anonymous parts would clash: arr.size / tab.size, str.len / tab.len);
  the union's `s` (a shorthand for str.ptr) is Str.Ptr. Sizes, as C gives
  them on every 64-bit target: TomlDatum 56 bytes, TomlResult 272.
  Every routine moves a datum or a result by value (C linkage: a `const`
  parameter is by value too, BNF sec 3). Target-neutral: no OS named.
*******************************************************************************/

module unit System.Toml.C;

public const
  // toml_type_t: the kind of a datum
  ADAM_TOML_UNKNOWN: int32 = 0;
  ADAM_TOML_STRING: int32 = 1;
  ADAM_TOML_INT64: int32 = 2;
  ADAM_TOML_FP64: int32 = 3;
  ADAM_TOML_BOOLEAN: int32 = 4;
  ADAM_TOML_DATE: int32 = 5;
  ADAM_TOML_TIME: int32 = 6;
  ADAM_TOML_DATETIME: int32 = 7;
  ADAM_TOML_DATETIMETZ: int32 = 8;
  ADAM_TOML_ARRAY: int32 = 9;
  ADAM_TOML_TABLE: int32 = 10;
  // toml_datum_t's flag bits: inline form, a [table] header, an explicit table
  ADAM_TOML_FLAG_INLINED: uint32 = 1;
  ADAM_TOML_FLAG_STDEXPR: uint32 = 2;
  ADAM_TOML_FLAG_EXPLICIT: uint32 = 4;
  // The bytes of toml_result_t's errmsg
  ADAM_TOML_ERRMSG_SIZE: int32 = 200;

public forward type TomlDatum;

public type
  // A string datum: NUL-terminated, Len bytes before the NUL
  TomlStr = record
    Ptr: ptr to const char;
    Len: int32;
  end;

  // A date / time datum's parts; Tz is the offset in minutes
  TomlStamp = record
    Year: int16;
    Month: int16;
    Day: int16;
    Hour: int16;
    Minute: int16;
    Second: int16;
    Usec: int32;
    Tz: int16;
  end;

  // An array datum: Count elements at Elems
  TomlArray = record
    Count: int32;
    Elems: ptr to TomlDatum;
  end;

  // A table datum: Count keys (Keys[i], Lens[i] bytes) and their Values[i]
  TomlTable = record
    Count: int32;
    Keys: ptr to ptr to const char;
    Lens: ptr to int32;
    Values: ptr to TomlDatum;
  end;

  // toml_datum_t's union: the field Kind names is the one that holds
  TomlValue = overlay
    Str: TomlStr;
    Int64Value: int64;
    Float64Value: float64;
    BoolValue: bool;
    Stamp: TomlStamp;
    Arr: TomlArray;
    Tab: TomlTable;
  end;

  // toml_datum_t: one node of a parsed document; LineNo / ColNo 1-based (0 when
  // synthesized); Source the name given to the parse (nil if none), owned by the result
  TomlDatum = record
    Kind: int32;
    Flag: uint32;
    LineNo: int32;
    ColNo: int32;
    Source: ptr to const char;
    Data: TomlValue;
  end;

  // toml_result_t: TopTab holds when Ok, else ErrMsg (NUL-terminated); Internal is the
  // library's own state
  TomlResult = record
    Ok: bool;
    TopTab: TomlDatum;
    ErrMsg: array[0..199] of char;
    Internal: ptr;
  end;

  // toml_option_t: the parser's global options
  TomlOption = record
    CheckUtf8: bool;
    MemRealloc: routine clink(APtr: ptr; ASize: uint64): ptr;
    MemFree: routine clink(APtr: ptr);
  end;

// A document of ALen bytes at ASource (no NUL needed)
public routine clink toml_parse(ASource: ptr to const char; ALen: int32): TomlResult;
  external "tomlc17";
// As toml_parse, every datum's Source set to a copy of AName (or nil)
public routine clink toml_parse_named(ASource: ptr to const char; ALen: int32;
  AName: ptr to const char): TomlResult; external "tomlc17";
// A document read from the open C FILE AFile (the caller closes it)
public routine clink toml_parse_file(AFile: ptr): TomlResult; external "tomlc17";
// As toml_parse_file, every datum's Source set to a copy of AName (or nil)
public routine clink toml_parse_file_named(AFile: ptr; AName: ptr to const char): TomlResult;
  external "tomlc17";
// A document read from the file at the path AFileName (C's fopen: an ANSI path on Windows)
public routine clink toml_parse_file_ex(AFileName: ptr to const char): TomlResult;
  external "tomlc17";
// Releases what AResult holds; every result is freed once
public routine clink toml_free(AResult: TomlResult); external "tomlc17";
// The value of AKey in the table ATable, or a datum of kind ADAM_TOML_UNKNOWN
public routine clink toml_get(ATable: TomlDatum; AKey: ptr to const char): TomlDatum;
  external "tomlc17";
// The value at the dotted key AMultipartKey (no escapes, 255 bytes at most) from ATable,
// or a datum of kind ADAM_TOML_UNKNOWN
public routine clink toml_seek(ATable: TomlDatum; AMultipartKey: ptr to const char): TomlDatum;
  external "tomlc17";
// A new result: AFirst with ASecond merged over it (all three freed on their own)
public routine clink toml_merge(AFirst: ptr to const TomlResult;
  ASecond: ptr to const TomlResult): TomlResult; external "tomlc17";
// True when the two documents are equivalent (tables unordered, arrays ordered)
public routine clink toml_equiv(AFirst: ptr to const TomlResult;
  ASecond: ptr to const TomlResult): bool; external "tomlc17";
// The parser's default options
public routine clink toml_default_option(): TomlOption; external "tomlc17";
// Sets the parser's global options
public routine clink toml_set_option(AOption: TomlOption); external "tomlc17";

end.
