-------------------------------------------------------------------------------
  System.IO.adam - files, folders, paths, processes and the clock, the same
  on every target: `import System.IO;` and no OS is named.

  Target-neutral (PROJECT AT.3): every routine hands its job to the one
  platform unit the target triple picks (System.IO.Win64 for
  x86_64-windows-gnu, over System.Windows), each with the same IoPlatform*
  routines; a linux64 target adds System.IO.Linux64 over libc and nothing
  else changes. Paths are UTF-8 text with '/' or '\\' between parts; the
  prefixes ResolvePath reads ($P: $D:) mean the same on every target.
*******************************************************************************/

module unit System.IO;

import System.SysUtils
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.IO.Win64
@endif
  ;

// True when APath names a file (not a folder)
public routine FileExists(const APath: string): bool;
begin
  return IoPlatformFileExists(APath);
end;

// True when APath names a folder
public routine DirectoryExists(const APath: string): bool;
begin
  return IoPlatformDirectoryExists(APath);
end;

// APath's size in bytes; -1 when it cannot be read
public routine FileSize(const APath: string): int64;
begin
  return IoPlatformFileSize(APath);
end;

// APath's last write time as the OS keeps it (compared, never shown); -1 when it cannot be read
public routine FileWriteTime(const APath: string): int64;
begin
  return IoPlatformFileWriteTime(APath);
end;

// The whole file APath into ABytes; false when it cannot be read
public routine ReadAllBytes(const APath: string; var ABytes: ByteArray): bool;
begin
  return IoPlatformReadAllBytes(APath, ABytes);
end;

// The whole file APath into AText (its bytes, UTF-8); false when it cannot be read
public routine ReadAllText(const APath: string; var AText: string): bool;
begin
  return IoPlatformReadAllText(APath, AText);
end;

// ABytes as the whole file APath (made or replaced); false when it cannot be written
public routine WriteAllBytes(const APath: string; const ABytes: ByteArray): bool;
begin
  return IoPlatformWriteAllBytes(APath, ABytes);
end;

// AText's bytes as the whole file APath (made or replaced); false when it cannot be written
public routine WriteAllText(const APath: string; const AText: string): bool;
begin
  return IoPlatformWriteAllText(APath, AText);
end;

// ASourcePath renamed over ATargetPath in one step (a file written whole, then put in place)
public routine ReplaceFile(const ASourcePath: string; const ATargetPath: string): bool;
begin
  return IoPlatformReplaceFile(ASourcePath, ATargetPath);
end;

// The file APath deleted; false when it is not there or cannot be
public routine DeleteFile(const APath: string): bool;
begin
  return IoPlatformDeleteFile(APath);
end;

// The folder APath made (its parent must exist); false when it cannot be
public routine CreateDir(const APath: string): bool;
begin
  return IoPlatformCreateDir(APath);
end;

// The folder APath made with every missing parent; true when it is there after
public routine ForceDirectories(const APath: string): bool;
begin
  return IoPlatformForceDirectories(APath);
end;

// The names of the files in the folder ADir, in a fixed order
public routine GetFiles(const ADir: string; var AList: StringArray): bool;
begin
  return IoPlatformGetFiles(ADir, AList);
end;

// The names of the folders in the folder ADir, in a fixed order
public routine GetDirectories(const ADir: string; var AList: StringArray): bool;
begin
  return IoPlatformGetDirectories(ADir, AList);
end;

// APath as a full path: $P: the program's folder, $D: / no prefix ABaseDir (the working folder when ""); "" when it resolves to nothing
public routine ResolvePath(const APath: string; const ABaseDir: string): string;
begin
  return IoPlatformResolvePath(APath, ABaseDir);
end;

// ResolvePath against the working folder
public routine ResolvePath(const APath: string): string;
begin
  return IoPlatformResolvePath(APath);
end;

// True when the two paths name the same file as this OS compares names
public routine SamePath(const AFirst: string; const ASecond: string): bool;
begin
  return IoPlatformSamePath(AFirst, ASecond);
end;

// The OS's own library folder (where its system libraries are)
public routine SystemDir(): string;
begin
  return IoPlatformSystemDir();
end;

// The user's cache folder for Adam; "" when the OS gives none
public routine UserCacheDir(): string;
begin
  return IoPlatformUserCacheDir();
end;

// ACount bytes from the OS's secure random generator; false when it fails
public routine SecureRandomBytes(const ACount: int64; var ABytes: ByteArray): bool;
begin
  return IoPlatformSecureRandomBytes(ACount, ABytes);
end;

// AExe run with AArgs in AWorkDir, its output captured into AOutput; false when it cannot start
public routine RunProcess(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AOutput: string; var AExitCode: uint32): bool;
begin
  return IoPlatformRunProcess(AExe, AArgs, AWorkDir, AOutput, AExitCode);
end;

// AExe run with AArgs in AWorkDir on this program's own console; false when it cannot start
public routine RunAttached(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32): bool;
begin
  return IoPlatformRunAttached(AExe, AArgs, AWorkDir, AExitCode);
end;

// StdApp.Utils' RunPE: the program AExe (named in full, no PATH search) run with AArgs in
// AWorkDir, shown, no handle of this program inherited; AWait waits for it, its exit code in
// AExitCode, else it runs on (it may outlive this program, AExitCode 0). False when it cannot
// start or its exit code cannot be read
public routine RunPE(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  const AWait: bool; var AExitCode: uint32): bool;
begin
  return IoPlatformRunPE(AExe, AArgs, AWorkDir, AWait, AExitCode);
end;

// Milliseconds since an OS-chosen start: for timing, never a date
public routine TickCountMs(): int64;
begin
  return IoPlatformTickCountMs();
end;

// Waits AMilliseconds, then returns: at least that long (the OS may wake the program a little
// later). A wait of 0 or less returns at once
public routine Delay(const AMilliseconds: int32);
begin
  IoPlatformDelay(AMilliseconds);
end;

// The high-resolution clock's reading: never going back, for timing, never a date; only the
// difference of two readings means anything, in PerformanceFrequency's units
public routine PerformanceCounter(): int64;
begin
  return IoPlatformPerformanceCounter();
end;

// The high-resolution clock's counts per second (fixed while the program runs, above 0)
public routine PerformanceFrequency(): int64;
begin
  return IoPlatformPerformanceFrequency();
end;

end.
