-------------------------------------------------------------------------------
  System.IO.adam - files, folders, paths and the clock, the same
  on every target: `import System.IO;` and no OS is named.

  Target-neutral (PROJECT AT.3): every routine hands its job to the one
  platform unit the target triple picks (System.IO.Win64 for
  x86_64-windows-gnu, over System.Windows; System.IO.Linux64 for
  x86_64-linux-gnu, over glibc through System.Linux), each with the same
  IOPlatform* routines; the whole-file reads and writes are this unit's
  own, over System.Runtime's file handles. Paths are UTF-8 text with '/' or '\\' between parts; the
  prefixes ResolvePath reads ($P: $D:) mean the same on every target.
*******************************************************************************/

module unit System.IO;

import System.SysUtils
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.IO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.IO.Linux64
@endif
  ;

// The whole-file routines (ReadAllBytes .. WriteAllText) need no platform part: they open,
// size, read and write through System.Runtime's file handles (its platform unit holds the OS
// calls). A file is sized first and read straight into its one block (no chunk buffer, no
// byte-by-byte copy), as Delphi's TFile.ReadAllBytes and TFileStream.ReadBuffer do

// The file APath (ResolvePath's prefixes taken) opened as AHandle in AMode (System.Runtime's
// ADAM_FILE_*); false (AHandle 0) when it resolves to "" or cannot be opened so
func DoOpenHandle(const APath: string; const AMode: int32; var AHandle: uint64): bool;
var
  LPath: string;
  LOpened: bool;
begin
  AHandle := 0;
  LPath := IOPlatformResolvePath(APath);
  if LPath = "" then
    return false;
  end;
  LOpened := OpenFileHandle(LPath, AMode, AHandle);
  return LOpened;
end;

// Up to ACount bytes of the open file AHandle read into ABuffer, a short read read again:
// the bytes read (fewer than ACount when the file ends first), -1 when a read fails
func DoReadInto(const AHandle: uint64; const ABuffer: ptr; const ACount: int64): int64;
var
  LDone: int64;
  LGot: int64;
begin
  LDone := 0;
  while LDone < ACount do
    LGot := ReadFileHandle(AHandle, ptr(uint64(ABuffer) + uint64(LDone)), ACount - LDone);
    if LGot < 0 then
      return -1;
    end;
    // A file's end is a read that succeeds with no bytes (it shrank since it was sized)
    if LGot = 0 then
      leave;
    end;
    LDone := LDone + LGot;
  end;
  return LDone;
end;

// ACount bytes at ABuffer written to the open file AHandle, a short write written again;
// false when a write fails or writes nothing
func DoWriteFrom(const AHandle: uint64; const ABuffer: ptr; const ACount: int64): bool;
var
  LDone: int64;
  LPut: int64;
begin
  LDone := 0;
  while LDone < ACount do
    LPut := WriteFileHandle(AHandle, ptr(uint64(ABuffer) + uint64(LDone)), ACount - LDone);
    if LPut <= 0 then
      return false;
    end;
    LDone := LDone + LPut;
  end;
  return true;
end;

/// True when `APath` names a file (not a folder).
/// @param APath the path to look at
/// @returns true for a file, false for a folder or nothing there
/// @example `if FileExists("game.toml") then LoadSettings(); end;`
public func cpplink FileExists(const APath: string): bool;
begin
  return IOPlatformFileExists(APath);
end;

/// True when `APath` names a folder.
/// @param APath the path to look at
/// @returns true for a folder, false for a file or nothing there
public func cpplink DirectoryExists(const APath: string): bool;
begin
  return IOPlatformDirectoryExists(APath);
end;

/// The size of the file `APath` in bytes.
/// @param APath the file
/// @returns its size, or -1 when it cannot be read
public func cpplink FileSize(const APath: string): int64;
begin
  return IOPlatformFileSize(APath);
end;

/// The last write time of `APath` in nanoseconds since 1970-01-01 UTC, the same on every
/// target (a file seen from two hosts gives one value, at the file system's own precision).
/// @param APath the file
/// @returns the time, or -1 when it is a folder, is missing or cannot be read
public func cpplink FileWriteTime(const APath: string): int64;
begin
  return IOPlatformFileWriteTime(APath);
end;

/// The time now in nanoseconds since 1970-01-01 UTC, on the scale `FileWriteTime` gives, so
/// the two compare. Only as closely as the file system's clock allows: a file system stamps a
/// write from a coarser clock (a timer tick, 2 s on FAT) or from another host's (a network or
/// WSL drive), so a file written just after a reading can show a write time a little before
/// it; compare with a margin.
/// @returns the time now
/// @example `if FileWriteTime(LPath) >= NowNanos() - LMarginNs then .. end;`
public func cpplink NowNanos(): int64;
begin
  return IOPlatformNowNanos();
end;

/// The whole file `APath` read into `ABytes`, its bytes as they are.
/// @param APath the file to read
/// @param ABytes receives the bytes (empty on failure)
/// @returns false when it is a folder, is missing, or cannot be opened or read
public func cpplink ReadAllBytes(const APath: string; var ABytes: ByteArray): bool;
var
  LFile: uint64;
  LBytes: ByteArray;
  LSize: int64;
  LCount: int64;
begin
  setlength(ABytes, 0);
  if not DoOpenHandle(APath, ADAM_FILE_READ, LFile) then
    return false;
  end;
  setlength(LBytes, 0);
  LSize := 0;
  LCount := 0;
  guard
    LSize := FileHandleSize(LFile);
    if LSize > 0 then
      // Sized from empty: a block of its own, read into in place
      setlength(LBytes, LSize);
      LCount := DoReadInto(LFile, ptr(addr of LBytes[0]), LSize);
    end;
  finally
    CloseFileHandle(LFile);
  end;
  if (LSize < 0) or (LCount < 0) then
    return false;
  end;
  if LCount < LSize then
    setlength(LBytes, LCount);
  end;
  ABytes := LBytes;
  return true;
end;

/// The whole file `APath` read into `AText`, its bytes as they are (UTF-8; no newline or
/// code page conversion).
/// @param APath the file to read
/// @param AText receives the text ("" on failure)
/// @returns false when it is a folder, is missing, or cannot be opened or read
/// @example `if ReadAllText("notes.txt", LText) then println(LText); end;`
public func cpplink ReadAllText(const APath: string; var AText: string): bool;
var
  LFile: uint64;
  LText: string;
  LSize: int64;
  LCount: int64;
begin
  AText := "";
  if not DoOpenHandle(APath, ADAM_FILE_READ, LFile) then
    return false;
  end;
  LText := "";
  LSize := 0;
  LCount := 0;
  guard
    LSize := FileHandleSize(LFile);
    if LSize > 0 then
      // Sized from empty: a block of its own, read into in place
      setlength(LText, LSize);
      LCount := DoReadInto(LFile, ptr(addr of LText[0]), LSize);
    end;
  finally
    CloseFileHandle(LFile);
  end;
  if (LSize < 0) or (LCount < 0) then
    return false;
  end;
  if LCount < LSize then
    setlength(LText, LCount);
  end;
  AText := LText;
  return true;
end;

/// `ABytes` written as the whole file `APath`: a file there is replaced, a missing one is made
/// in a folder that exists.
/// @param APath the file to write
/// @param ABytes its new contents
/// @returns false when the path is a folder, its folder is missing, or it cannot be fully written
public func cpplink WriteAllBytes(const APath: string; const ABytes: ByteArray): bool;
var
  LFile: uint64;
  LOk: bool;
begin
  if not DoOpenHandle(APath, ADAM_FILE_WRITE, LFile) then
    return false;
  end;
  LOk := true;
  guard
    if len(ABytes) > 0 then
      LOk := DoWriteFrom(LFile, ptr(addr of ABytes[0]), len(ABytes));
    end;
  finally
    CloseFileHandle(LFile);
  end;
  return LOk;
end;

/// `AText`'s bytes written as the whole file `APath` (no BOM; line ends as the caller wrote
/// them), straight from `AText`: the same replacing and the same failures as `WriteAllBytes`.
/// @param APath the file to write
/// @param AText its new contents
/// @returns false when the path is a folder, its folder is missing, or it cannot be fully written
/// @example `WriteAllText("out.txt", "hello");`
public func cpplink WriteAllText(const APath: string; const AText: string): bool;
var
  LFile: uint64;
  LOk: bool;
begin
  if not DoOpenHandle(APath, ADAM_FILE_WRITE, LFile) then
    return false;
  end;
  LOk := true;
  guard
    if len(AText) > 0 then
      LOk := DoWriteFrom(LFile, ptr(addr of AText[0]), len(AText));
    end;
  finally
    CloseFileHandle(LFile);
  end;
  return LOk;
end;

/// `ASourcePath` renamed over `ATargetPath` in one step, so a file written whole elsewhere is
/// put in place at once.
/// @param ASourcePath the new file
/// @param ATargetPath the file it replaces
/// @returns true when the target now holds the source
public func cpplink ReplaceFile(const ASourcePath: string; const ATargetPath: string): bool;
begin
  return IOPlatformReplaceFile(ASourcePath, ATargetPath);
end;

/// The file `APath` deleted.
/// @param APath the file
/// @returns false when it is not there or cannot be deleted
public func cpplink DeleteFile(const APath: string): bool;
begin
  return IOPlatformDeleteFile(APath);
end;

/// The folder `APath` made; its parent must exist (`ForceDirectories` makes the parents too).
/// @param APath the folder
/// @returns false when it cannot be made
public func cpplink CreateDir(const APath: string): bool;
begin
  return IOPlatformCreateDir(APath);
end;

/// The folder `APath` made with every missing parent.
/// @param APath the folder
/// @returns true when it is there afterwards
public func cpplink ForceDirectories(const APath: string): bool;
begin
  return IOPlatformForceDirectories(APath);
end;

/// The names of the files in the folder `ADir`, in a fixed order.
/// @param ADir the folder
/// @param AList receives the names (no path)
/// @returns false when the folder cannot be read
public func cpplink GetFiles(const ADir: string; var AList: StringArray): bool;
begin
  return IOPlatformGetFiles(ADir, AList);
end;

/// The names of the folders in the folder `ADir`, in a fixed order.
/// @param ADir the folder
/// @param AList receives the names (no path)
/// @returns false when the folder cannot be read
public func cpplink GetDirectories(const ADir: string; var AList: StringArray): bool;
begin
  return IOPlatformGetDirectories(ADir, AList);
end;

// The files of ADir whose names match one of AMasks (case aside), each with APrefix before
// it, appended to AList at ACount (grown by doubling); with ARecursive every folder of ADir
// walked the same way after its files (APrefix + its name + "/"), a folder link never
// entered (no loop through a link to a folder above). False when a folder cannot be read
func DoFindFiles(const ADir: string; const APrefix: string; const AMasks: StringArray;
  const ARecursive: bool; var AList: StringArray; var ACount: int64): bool;
var
  LNames: StringArray;
  LName: string;
  LSub: string;
  LI: int64;
  LK: int64;
begin
  if not IOPlatformGetFiles(ADir, LNames) then
    return false;
  end;
  for LI := 0 to len(LNames) - 1 do
    LName := LowerCase(LNames[LI]);
    for LK := 0 to len(AMasks) - 1 do
      if MatchesGlob(LName, AMasks[LK]) then
        if ACount = len(AList) then
          setlength(AList, ACount * 2 + 16);
        end;
        AList[ACount] := APrefix + LNames[LI];
        ACount := ACount + 1;
        leave;
      end;
    end;
  end;
  if not ARecursive then
    return true;
  end;
  if not IOPlatformGetDirectories(ADir, LNames) then
    return false;
  end;
  for LI := 0 to len(LNames) - 1 do
    LSub := ADir + "/" + LNames[LI];
    if not PathIsLink(IOPlatformResolvePath(LSub)) then
      if not DoFindFiles(LSub, APrefix + LNames[LI] + "/", AMasks, ARecursive, AList, ACount) then
        return false;
      end;
    end;
  end;
  return true;
end;

/// The files under the folder `ADir` whose names match `AMask`, as paths relative to it with
/// `/` between parts (`"x.png"`, `"sprites/ship.png"`): a folder's files in GetFiles' fixed
/// order, then (with `ARecursive`) each of its folders the same way. A folder link is listed
/// through but never entered.
/// @param ADir the folder
/// @param AMask one or more `MatchesGlob` masks split by `;` (`"*.png;*.jpg"`), matched to the
///   name alone with ASCII case aside (`*.png` takes `A.PNG`); `""` takes every file
/// @param ARecursive true to look in every folder below it as well
/// @param AList the files found (empty on a failure)
/// @returns false when `ADir` (or a folder below it) cannot be read
/// @example `if GetFiles("$P:res/assets", "*.png", true, LImages) then .. end;`
public func cpplink GetFiles(const ADir: string; const AMask: string; const ARecursive: bool;
  var AList: StringArray): bool;
var
  LParts: StringArray;
  LMasks: StringArray;
  LCount: int64;
  LI: int64;
begin
  // The masks, empty ones dropped, lowered once (the names are lowered as they are matched)
  LParts := SplitString(AMask, ";");
  setlength(LMasks, len(LParts));
  LCount := 0;
  for LI := 0 to len(LParts) - 1 do
    if LParts[LI] <> "" then
      LMasks[LCount] := LowerCase(LParts[LI]);
      LCount := LCount + 1;
    end;
  end;
  if LCount = 0 then
    setlength(LMasks, 1);
    LMasks[0] := "*";
    LCount := 1;
  end;
  setlength(LMasks, LCount);
  setlength(AList, 0);
  LCount := 0;
  if not DoFindFiles(ADir, "", LMasks, ARecursive, AList, LCount) then
    setlength(AList, 0);
    return false;
  end;
  setlength(AList, LCount);
  return true;
end;

/// `APath` as a full path: a `$P:` prefix is the program's folder; `$D:` or no prefix is
/// `ABaseDir`.
/// @param APath the path to resolve
/// @param ABaseDir the folder a relative path starts from (the working folder when "")
/// @returns the full path, or "" when it resolves to nothing
/// @example `ResolvePath("$P:assets.zip", "")`
public func cpplink ResolvePath(const APath: string; const ABaseDir: string): string;
begin
  return IOPlatformResolvePath(APath, ABaseDir);
end;

/// `APath` resolved as `ResolvePath` does, against the working folder.
/// @param APath the path to resolve
/// @returns the full path, or "" when it resolves to nothing
public func cpplink ResolvePath(const APath: string): string;
begin
  return IOPlatformResolvePath(APath);
end;

/// True when the two paths name the same file, compared as this OS compares names.
/// @param AFirst one path
/// @param ASecond the other path
/// @returns true for the same file
public func cpplink SamePath(const AFirst: string; const ASecond: string): bool;
begin
  return IOPlatformSamePath(AFirst, ASecond);
end;

/// The OS's own library folder (where its system libraries are).
/// @returns the folder
public func cpplink SystemDir(): string;
begin
  return IOPlatformSystemDir();
end;

/// The user's cache folder for Adam.
/// @returns the folder, or "" when the OS gives none
public func cpplink UserCacheDir(): string;
begin
  return IOPlatformUserCacheDir();
end;

/// `ACount` bytes from the OS's secure random generator.
/// @param ACount how many bytes
/// @param ABytes receives them
/// @returns false when the generator fails
public func cpplink SecureRandomBytes(const ACount: int64; var ABytes: ByteArray): bool;
begin
  return IOPlatformSecureRandomBytes(ACount, ABytes);
end;

/// Milliseconds since a start the OS chooses: for timing, never a date.
/// @returns the count
public func cpplink TickCountMs(): int64;
begin
  return IOPlatformTickCountMs();
end;

/// Waits `AMilliseconds`, then returns: at least that long (the OS may wake the program a
/// little later). A wait of 0 or less returns at once.
/// @param AMilliseconds how long to wait
/// @example `Delay(250);`
public func cpplink Delay(const AMilliseconds: int32);
begin
  IOPlatformDelay(AMilliseconds);
end;

/// The high-resolution clock's reading: it never goes back, for timing, never a date; only the
/// difference of two readings means anything, in `PerformanceFrequency`'s units.
/// @returns the reading
/// @example `LMs := (PerformanceCounter() - LStart) * 1000 div PerformanceFrequency();`
public func cpplink PerformanceCounter(): int64;
begin
  return IOPlatformPerformanceCounter();
end;

/// The high-resolution clock's counts per second (fixed while the program runs, above 0).
/// @returns the counts per second
public func cpplink PerformanceFrequency(): int64;
begin
  return IOPlatformPerformanceFrequency();
end;

/// The folder of this program's exe (asked of the OS, never argv[0]), in `ResolvePath`'s form.
/// @returns the folder, or "" when the OS cannot tell
public func cpplink ExeDir(): string;
begin
  return IOPlatformExeDir();
end;

/// The system's folder for temporary files (Windows: GetTempPathW's; Linux: $TMPDIR, else
/// /tmp), resolved.
/// @returns the folder, or "" when the system names none
public func cpplink TempDir(): string;
begin
  return IOPlatformTempDir();
end;

/// The empty folder `APath` removed; a folder holding anything is left as it is.
/// @param APath the folder
/// @returns false when it is not empty, is a file, is missing or the OS refuses it
public func cpplink RemoveDir(const APath: string): bool;
begin
  return IOPlatformRemoveDir(APath);
end;

/// The folder `APath` removed; with `ARecursive` everything in it first, folder by folder.
/// A link inside (on x86_64-windows-gnu a junction or a symbolic link, on x86_64-linux-gnu a
/// symbolic link, a broken one too) is removed as the link, never followed, so nothing
/// outside `APath` is touched; `APath` itself a link to a folder: only the link goes. A
/// read-only file is removed as well (x86_64-windows-gnu clears its read-only attribute
/// first). Without `ARecursive` it is the one-argument `RemoveDir` (an empty folder only).
/// @param APath the folder (ResolvePath's prefixes taken)
/// @param ARecursive true to remove what it holds too
/// @returns true when `APath` is gone after; false when it is no folder or something in it
///   cannot be removed (an open file on x86_64-windows-gnu, a folder without write
///   permission on x86_64-linux-gnu): what could be removed is gone, the rest is left
/// @example `if DirectoryExists(LScratch) then RemoveDir(LScratch, true); end;`
public func cpplink RemoveDir(const APath: string; const ARecursive: bool): bool;
begin
  if not ARecursive then
    return IOPlatformRemoveDir(APath);
  end;
  return IOPlatformRemoveTree(APath);
end;

/// The file `AOldPath` given the new name `ANewPath`, moved to another folder, drive or file
/// system too (there copied, then removed). Something at `ANewPath` is never replaced
/// (`ReplaceFile` does that).
/// @param AOldPath the file
/// @param ANewPath its new path
/// @returns false when `AOldPath` is not a file, `ANewPath` exists, its folder is missing or the OS refuses it
public func cpplink RenameFile(const AOldPath: string; const ANewPath: string): bool;
begin
  return IOPlatformRenameFile(AOldPath, ANewPath);
end;

/// The file `APath` marked read-only (`AReadOnly`) or writable again, its other attributes kept.
/// Windows: the read-only attribute, so the file is never replaced, renamed over or deleted while
/// it is set. Linux: every write permission bit off, or the owner's back on; there the folder's
/// permissions, not the file's, decide a rename or a delete.
/// @param APath the file
/// @param AReadOnly true to make it read-only, false to make it writable again
/// @returns false for a folder or a missing path
public func cpplink SetFileReadOnly(const APath: string; const AReadOnly: bool): bool;
begin
  return IOPlatformSetFileReadOnly(APath, AReadOnly);
end;

/// The file `APath` made runnable as a program: on x86_64-linux-gnu an execute bit is added
/// for each of the owner, group and others that may read it (chmod), the other bits kept;
/// on x86_64-windows-gnu a program runs by its extension, so nothing changes
/// @param APath the file (a program or a shared library just written)
/// @returns true when the file can be run after; false for a folder, a missing path or a
///   change the OS refuses
/// @example `if not SetFileExecutable(LExe) then println("cannot run {}", LExe); end;`
public func cpplink SetFileExecutable(const APath: string): bool;
begin
  return IOPlatformSetFileExecutable(APath);
end;

/// The value of this process's environment variable `AName`.
/// @param AName the variable
/// @returns its value; "" when it is not set (or set to "") or `AName` is ""
/// @example `LHome := GetEnvironmentVariable("HOME");`
public func cpplink GetEnvironmentVariable(const AName: string): string;
begin
  return IOPlatformGetEnvironmentVariable(AName);
end;

/// This process's environment variable `AName` set to `AValue`; a process it starts inherits it.
/// @param AName the variable
/// @param AValue its value ("" leaves it empty, which `GetEnvironmentVariable` reads as not set)
/// @returns true when it holds the asked value afterwards
public func cpplink SetEnvironmentVariable(const AName: string; const AValue: string): bool;
begin
  return IOPlatformSetEnvironmentVariable(AName, AValue);
end;

/// True when `APath` names an existing file or folder the system hides from a plain listing:
/// on x86_64-windows-gnu its hidden attribute is set, on x86_64-linux-gnu its name starts with
/// `.` (a dot file). False for a missing path.
/// @param APath the file or folder (ResolvePath's prefixes taken)
/// @returns true when it is hidden
/// @example `if not IsFileHidden(LPath) then LShown.Add(LPath); end;`
public func cpplink IsFileHidden(const APath: string): bool;
begin
  return IOPlatformIsFileHidden(APath);
end;

/// True when `APath` is a full path by this target's rule, as text (the disk is never asked):
/// x86_64-windows-gnu a drive and a separator (`C:\x`, `d:/x`) or two separators
/// (`\\server\share`); x86_64-linux-gnu a leading `/` (or `\`). `ResolvePath` makes any path
/// full.
/// @param APath the path
/// @returns true when it needs no base folder
/// @example `if not IsPathAbsolute(LPath) then LPath := ResolvePath(LPath, LBase); end;`
public func cpplink IsPathAbsolute(const APath: string): bool;
begin
  return IOPlatformIsPathAbsolute(APath);
end;

/// The process's working folder as the OS keeps it (the one a relative path is found from),
/// in ResolvePath's form; `""` when the OS cannot tell.
/// @returns the working folder
/// @example `LStart := CurrentDir(); SetCurrentDir(LProject); .. SetCurrentDir(LStart);`
public func cpplink CurrentDir(): string;
begin
  return IOPlatformResolvePath(".");
end;

/// Makes the folder `APath` the process's working folder (the OS's own: a C library's
/// hooked chdir into a mounted source is another matter, HookIO's). A program it starts
/// inherits it.
/// @param APath the folder (ResolvePath's prefixes taken)
/// @returns false for a file, a missing path or one the OS refuses (the working folder kept)
/// @example `if SetCurrentDir("$P:") then .. end;`
public func cpplink SetCurrentDir(const APath: string): bool;
begin
  return IOPlatformSetCurrentDir(APath);
end;

/// Copies the file `ASourcePath` to `ATargetPath`: its bytes and permissions (on
/// x86_64-windows-gnu its attributes and times as well).
/// @param ASourcePath the file copied
/// @param ATargetPath the new file (its folder must exist)
/// @param AOverwrite true to replace a file already at `ATargetPath`
/// @returns false when `ASourcePath` is not a file, `ATargetPath` is a folder, a file is there
///   and not `AOverwrite`, the two name one file, or a read or write fails (no half-written
///   file is left)
/// @example `CopyFile("save.dat", "save.bak", true);`
public func cpplink CopyFile(const ASourcePath: string; const ATargetPath: string;
  const AOverwrite: bool): bool;
begin
  return IOPlatformCopyFile(ASourcePath, ATargetPath, AOverwrite);
end;

/// The text of the C format `AFormat` over the C va_list `AArgs`, as C's printf writes it:
/// for a C callback that hands over a format and its arguments (a library's log hook), or
/// a clink variadic's own `varargs.clist()`. "" when the C runtime cannot make it (or
/// `AFormat` is nil).
/// @param AFormat the NUL-terminated printf format
/// @param AArgs the C va_list of its arguments (on x86_64-linux-gnu read once: format it once)
/// @returns the formatted text
/// @example `func clink OnLog(ALevel: int32; AText: ptr to const char; AArgs: ptr); begin println(FormatCList(AText, AArgs)); end;`
public func cpplink FormatCList(const AFormat: ptr to const char; const AArgs: ptr): string;
begin
  return IOPlatformFormatCList(AFormat, AArgs);
end;

end.
