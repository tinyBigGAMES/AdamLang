// System.pl_mpeg.C.adam - written by adam cimport for x86_64-windows-gnu, x86_64-linux-gnu
// from System.pl_mpeg.C.cimport.toml (plm_utf8.h, plm_stream.h).
// Regenerate it with adam cimport; a change belongs in the spec
// ([renames], [skip], [[insert]]).

module unit System.pl_mpeg.C;

public type
  plm_t = record
  end;

  plm_buffer_t = record
  end;

  plm_demux_t = record
  end;

  plm_video_t = record
  end;

  plm_audio_t = record
  end;

  plm_packet_t = record
    type_: int32;
    pts: float64;
    length: uint64;
    data: ptr to uint8;
  end;

  plm_plane_t = record
    width: uint32;
    height: uint32;
    data: ptr to uint8;
  end;

  plm_frame_t = record
    time: float64;
    width: uint32;
    height: uint32;
    y: plm_plane_t;
    cr: plm_plane_t;
    cb: plm_plane_t;
  end;

  plm_video_decode_callback = routine clink(self_: ptr to plm_t; frame: ptr to plm_frame_t; user: ptr);

  plm_samples_t = record
    time: float64;
    count: uint32;
    interleaved: array[0..2303] of float32;
  end;

  plm_audio_decode_callback = routine clink(self_: ptr to plm_t; samples: ptr to plm_samples_t; user: ptr);
  plm_buffer_load_callback = routine clink(self_: ptr to plm_buffer_t; user: ptr);
  plm_buffer_seek_callback = routine clink(self_: ptr to plm_buffer_t; offset: uint64; user: ptr);
  plm_buffer_tell_callback = routine clink(self_: ptr to plm_buffer_t; user: ptr): uint64;

  plm_stream_t = record
    read: routine clink(user: ptr; dest: ptr; count: uint64): uint64;
    seek: routine clink(user: ptr; position: uint64): int32;
    length: uint64;
    user: ptr;
    position: uint64;
    failed: int32;
  end;

