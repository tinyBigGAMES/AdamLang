/// `System.IO`'s `IsFileHidden`: `System.Windows`' Win* routine of the same job (the hidden
/// attribute).
/// @param APath as `IsFileHidden` takes it
/// @returns as `IsFileHidden` returns it
public func cpplink IOPlatformIsFileHidden(const APath: string): bool;
begin
  return WinIsFileHidden(APath);
end;

/// `System.IO`'s `IsPathAbsolute` by Windows' rule, as text: a drive and a separator (C:\, d:/)
/// or two separators (\\server\share, \\?\..); "C:x" (the drive's own folder) and "\x" (the
/// working drive's root) are relative to something.
/// @param APath as `IsPathAbsolute` takes it
/// @returns as `IsPathAbsolute` returns it
public func cpplink IOPlatformIsPathAbsolute(const APath: string): bool;
var
  LLetter: char;
begin
  if len(APath) < 2 then
    return false;
  end;
  if ((APath[0] = '\\') or (APath[0] = '/')) and ((APath[1] = '\\') or (APath[1] = '/')) then
    return true;
  end;
  if len(APath) < 3 then
    return false;
  end;
  LLetter := APath[0];
  return (((LLetter >= 'A') and (LLetter <= 'Z')) or ((LLetter >= 'a') and (LLetter <= 'z'))) and
    (APath[1] = ':') and ((APath[2] = '\\') or (APath[2] = '/'));
end;

/// `System.IO`'s `SetCurrentDir`: `System.Windows`' Win* routine of the same job.
/// @param APath as `SetCurrentDir` takes it
/// @returns as `SetCurrentDir` returns it
public func cpplink IOPlatformSetCurrentDir(const APath: string): bool;
