end;

// System.IO's GetEnvironmentVariable: System.Windows' Win* routine of the same job
public func cpplink IoPlatformGetEnvironmentVariable(const AName: string): string;
begin
  return WinGetEnvironmentVariable(AName);
end;

// System.IO's SetEnvironmentVariable: System.Windows' Win* routine of the same job
public func cpplink IoPlatformSetEnvironmentVariable(const AName: string; const AValue: string): bool;
begin
  return WinSetEnvironmentVariable(AName, AValue);
end;

end.
