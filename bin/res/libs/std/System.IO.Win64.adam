end;

// System.IO's RemoveDir: System.Windows' Win* routine of the same job
public func cpplink IoPlatformRemoveDir(const APath: string): bool;
begin
  return WinRemoveDir(APath);
end;

// System.IO's RenameFile: System.Windows' Win* routine of the same job
public func cpplink IoPlatformRenameFile(const AOldPath: string; const ANewPath: string): bool;
begin
