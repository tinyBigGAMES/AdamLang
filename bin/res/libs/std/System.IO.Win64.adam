  System.IO.Win64.adam - System.IO's platform unit for x86_64-windows-gnu:
  each IoPlatform* routine is System.Windows' Win* routine of the same job.

  System.IO imports exactly one platform unit, picked by the target triple;
  each one has the same IoPlatform* routines, so System.IO itself names no
  OS (a linux64 target adds System.IO.Linux64 over libc).
*******************************************************************************/

module unit System.IO.Win64;

import System.SysUtils, System.Windows;

// System.IO's FileExists: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformFileExists(const APath: string): bool;
begin
  return WinFileExists(APath);
end;

// System.IO's DirectoryExists: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformDirectoryExists(const APath: string): bool;
begin
  return WinDirectoryExists(APath);
end;

// System.IO's FileSize: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformFileSize(const APath: string): int64;
begin
  return WinFileSize(APath);
end;

// System.IO's FileWriteTime: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformFileWriteTime(const APath: string): int64;
begin
  return WinFileWriteTime(APath);
end;

// System.IO's ReadAllBytes: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformReadAllBytes(const APath: string; var ABytes: ByteArray): bool;
begin
  return WinReadAllBytes(APath, ABytes);
end;

// System.IO's ReadAllText: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformReadAllText(const APath: string; var AText: string): bool;
begin
  return WinReadAllText(APath, AText);
end;

// System.IO's WriteAllBytes: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformWriteAllBytes(const APath: string; const ABytes: ByteArray): bool;
begin
  return WinWriteAllBytes(APath, ABytes);
end;

// System.IO's WriteAllText: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformWriteAllText(const APath: string; const AText: string): bool;
begin
  return WinWriteAllText(APath, AText);
end;

// System.IO's ReplaceFile: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformReplaceFile(const ASourcePath: string; const ATargetPath: string): bool;
begin
  return WinReplaceFile(ASourcePath, ATargetPath);
end;

// System.IO's DeleteFile: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformDeleteFile(const APath: string): bool;
begin
  return WinDeleteFile(APath);
end;

// System.IO's CreateDir: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformCreateDir(const APath: string): bool;
begin
  return WinCreateDir(APath);
end;

// System.IO's ForceDirectories: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformForceDirectories(const APath: string): bool;
begin
  return WinForceDirectories(APath);
end;

// System.IO's GetFiles: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformGetFiles(const ADir: string; var AList: StringArray): bool;
begin
  return WinGetFiles(ADir, AList);
end;

// System.IO's GetDirectories: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformGetDirectories(const ADir: string; var AList: StringArray): bool;
begin
  return WinGetDirectories(ADir, AList);
end;

// System.IO's ResolvePath: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformResolvePath(const APath: string; const ABaseDir: string): string;
begin
  return WinResolvePath(APath, ABaseDir);
end;

// System.IO's ResolvePath: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformResolvePath(const APath: string): string;
begin
  return WinResolvePath(APath);
end;

// System.IO's SamePath: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformSamePath(const AFirst: string; const ASecond: string): bool;
begin
  return WinSamePath(AFirst, ASecond);
end;

// System.IO's SystemDir: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformSystemDir(): string;
begin
  return WinSystemDir();
end;

// System.IO's UserCacheDir: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformUserCacheDir(): string;
begin
  return WinUserCacheDir();
end;

// System.IO's SecureRandomBytes: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformSecureRandomBytes(const ACount: int64; var ABytes: ByteArray): bool;
begin
  return WinSecureRandomBytes(ACount, ABytes);
end;

// System.IO's TickCountMs: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformTickCountMs(): int64;
begin
  return WinTickCountMs();
end;

// System.IO's Delay: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformDelay(const AMilliseconds: int32);
begin
  WinDelay(AMilliseconds);
end;

// System.IO's PerformanceCounter: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformPerformanceCounter(): int64;
begin
  return WinPerformanceCounter();
end;

// System.IO's PerformanceFrequency: System.Windows' Win* routine of the same job
public routine cpplink IoPlatformPerformanceFrequency(): int64;
begin
  return WinPerformanceFrequency();
end;

end.
