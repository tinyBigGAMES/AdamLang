  System.IO.Win64.adam - System.IO's platform unit for x86_64-windows-gnu:
  each IOPlatform* routine is System.Windows' Win* routine of the same job.

  System.IO imports exactly one platform unit, picked by the target triple;
  each one has the same IOPlatform* routines, so System.IO itself names no
  OS (a linux64 target adds System.IO.Linux64 over libc).
*******************************************************************************/

module unit System.IO.Win64;

import System.SysUtils, System.Windows;

const
  // FILETIME's ticks (100 ns since 1601-01-01 UTC) at 1970-01-01 UTC, and ns per tick
  ADAM_IO_WIN64_EPOCH_TICKS: int64 = 116444736000000000;
  ADAM_IO_WIN64_TICK_NS: int64 = 100;

/// `System.IO`'s `FileExists`: `System.Windows`' Win* routine of the same job.
/// @param APath as `FileExists` takes it
/// @returns as `FileExists` returns it
public func cpplink IOPlatformFileExists(const APath: string): bool;
begin
  return WinFileExists(APath);
end;

/// `System.IO`'s `DirectoryExists`: `System.Windows`' Win* routine of the same job.
/// @param APath as `DirectoryExists` takes it
/// @returns as `DirectoryExists` returns it
public func cpplink IOPlatformDirectoryExists(const APath: string): bool;
begin
  return WinDirectoryExists(APath);
end;

/// `System.IO`'s `FileSize`: `System.Windows`' Win* routine of the same job.
/// @param APath as `FileSize` takes it
/// @returns as `FileSize` returns it
public func cpplink IOPlatformFileSize(const APath: string): int64;
begin
  return WinFileSize(APath);
end;

/// `System.IO`'s `FileWriteTime`: `System.Windows`' `WinFileWriteTime` (FILETIME ticks) as
/// nanoseconds since 1970-01-01 UTC, as on every target (ACU4); -1 as WinFileWriteTime's.
/// @param APath as `FileWriteTime` takes it
/// @returns as `FileWriteTime` returns it
public func cpplink IOPlatformFileWriteTime(const APath: string): int64;
var
  LTicks: int64;
begin
  LTicks := WinFileWriteTime(APath);
  if LTicks = -1 then
    return -1;
  end;
  return (LTicks - ADAM_IO_WIN64_EPOCH_TICKS) * ADAM_IO_WIN64_TICK_NS;
end;

/// `System.IO`'s `NowNanos`: `System.Windows`' `WinSystemTime` (FILETIME ticks) as
/// nanoseconds since 1970-01-01 UTC, the clock IOPlatformFileWriteTime gives.
/// @returns as `NowNanos` returns it
public func cpplink IOPlatformNowNanos(): int64;
begin
  return (WinSystemTime() - ADAM_IO_WIN64_EPOCH_TICKS) * ADAM_IO_WIN64_TICK_NS;
end;

