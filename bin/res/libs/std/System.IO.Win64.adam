end;

// System.IO's IsPathAbsolute by Windows' rule, as text: a drive and a separator (C:\, d:/) or
// two separators (\\server\share, \\?\..); "C:x" (the drive's own folder) and "\x" (the
// working drive's root) are relative to something
public func cpplink IOPlatformIsPathAbsolute(const APath: string): bool;
var
  LLetter: char;
begin
  if len(APath) < 2 then
    return false;
  end;
  if ((APath[0] = '\\') or (APath[0] = '/')) and ((APath[1] = '\\') or (APath[1] = '/')) then
    return true;
  end;
  if len(APath) < 3 then
    return false;
  end;
  LLetter := APath[0];
  return (((LLetter >= 'A') and (LLetter <= 'Z')) or ((LLetter >= 'a') and (LLetter <= 'z'))) and
    (APath[1] = ':') and ((APath[2] = '\\') or (APath[2] = '/'));
end;

// System.IO's SetCurrentDir: System.Windows' Win* routine of the same job
public func cpplink IOPlatformSetCurrentDir(const APath: string): bool;
begin
  return WinSetCurrentDir(APath);
end;

// System.IO's CopyFile: System.Windows' Win* routine of the same job
public func cpplink IOPlatformCopyFile(const ASourcePath: string; const ATargetPath: string;
  const AOverwrite: bool): bool;
begin
  return WinCopyFile(ASourcePath, ATargetPath, AOverwrite);
end;

end.
