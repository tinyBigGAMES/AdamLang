public type
  Rid = uint32;
  Ruint = uint32;
  RBackend = int32;
  RError = int32;
  RSeverity = int32;

  RInitDesc = record
    backend: RBackend;
    app_name: ptr to const char;
    worker_threads: int32;
    disable_render_thread: int32;
    disable_vsync: int32;
    enable_validation: int32;
    headless: int32;
    ui_scale: float32;
  end;

  RAllocator = record
    alloc: func clink(size: uint64; user_data: ptr): ptr;
    realloc: func clink(ptr_: ptr; size: uint64; user_data: ptr): ptr;
    free: func clink(ptr_: ptr; user_data: ptr);
    user_data: ptr;
  end;

  RMemoryStats = record
    used_bytes: uint64;
    peak_bytes: uint64;
    reserved_bytes: uint64;
    allocation_count: uint64;
    total_allocations: uint64;
  end;

  RFrameStats = record
    layout_ms: float64;
    paint_ms: float64;
    render_ms: float64;
    widget_count: Ruint;
    instance_count: Ruint;
    draw_call_count: Ruint;
    backdrop_count: Ruint;
    paint_job_count: Ruint;
    frame_index: uint64;
  end;

  RFrameCallback = func clink(delta_seconds: float64; user_data: ptr);

  RAppEvent = int32;

  RAppEventCallback = func clink(event: RAppEvent; user_data: ptr);
  RTaskCallback = func clink(user_data: ptr);
  RParallelRangeCallback = func clink(begin_: Ruint; end_: Ruint; user_data: ptr);
  RTimerCallback = func clink(timer: Rid; user_data: ptr);
  RActionCallback = func clink(sender: Rid; action: ptr to const char; user_data: ptr);

  RActionContext = record
  end;

  RActionParametersCallback = func clink(context: ptr to RActionContext; user_data: ptr);
  RErrorCallback = func clink(code: RError; severity: RSeverity; detail: ptr to const char);
  RDeviceResetCallback = func clink(user_data: ptr);

  RWindowFlags = int32;
  RPictureInPictureCorner = int32;
  RBackdrop = int32;
  RWindowSystem = int32;

  RInsets = record
    top: float32;
    right: float32;
    bottom: float32;
    left: float32;
  end;

  RKeyboardCallback = func clink(window: Rid; visible: int32; height: float32; user_data: ptr);

  RTextInputType = int32;
  RReturnKey = int32;

  RTextInputInfo = record
    type_: RTextInputType;
    return_key: RReturnKey;
    password: int32;
    read_only: int32;
    max_length: int32;
  end;

  RNativeWindow = record
    system: RWindowSystem;
    display: ptr;
    window: uint64;
    visual: uint64;
    transparent: int32;
  end;

  RWindowEdge = int32;
  RMouseButton = int32;
  RModifier = int32;
  RCursor = int32;
  RKey = int32;
  REventType = int32;

  REvent = record
    type_: REventType;
    window: Rid;
    target: Rid;
    x: float32;
    y: float32;
    local_x: float32;
    local_y: float32;
    delta_x: float32;
    delta_y: float32;
    wheel_x: float32;
    wheel_y: float32;
    button: RMouseButton;
    clicks: int32;
    key: RKey;
    modifiers: Ruint;
    repeat_: int32;
    codepoint: Ruint;
    wheel_precise: int32;
  end;

  RDropPhase = int32;

  RDropEvent = record
    phase: RDropPhase;
    window: Rid;
    x: float32;
    y: float32;
    local_x: float32;
    local_y: float32;
    paths: ptr to const ptr to const char;
    path_count: int32;
    text: ptr to const char;
    drag_type: ptr to const char;
    drag_source: Rid;
  end;

  RDropCallback = func clink(target: Rid; event: ptr to const RDropEvent; user_data: ptr): int32;
  RBackCallback = func clink(window: Rid; user_data: ptr): int32;
  RWindowCloseCallback = func clink(window: Rid; user_data: ptr): int32;
  RWindowResizeCallback = func clink(window: Rid; width: int32; height: int32; user_data: ptr);
  RWindowEventHook = func clink(window: Rid; event: ptr to const REvent; user_data: ptr): int32;

  RTouchMode = int32;
  RTouchPhase = int32;
  RPenPhase = int32;
  RPenButton = int32;
  RGesturePhase = int32;
  RGestureKind = int32;
  RGestureDevice = int32;

  RTouchSettings = record
    mouse_emulation: int32;
    slop: float32;
    long_press: float32;
    inertia: int32;
    deceleration: float32;
    gestures: int32;
    pen_mouse_emulation: int32;
    pressure_curve: float32;
    pressure_threshold: float32;
    palm_rejection: int32;
    trackpad_gestures: int32;
    swipe_navigation: int32;
    swipe_distance: float32;
    min_touch_size: float32;
  end;

  RTouchEvent = record
    phase: RTouchPhase;
    window: Rid;
    target: Rid;
    id: int32;
    x: float32;
    y: float32;
    local_x: float32;
    local_y: float32;
    pressure: float32;
    width: float32;
    height: float32;
    count: int32;
    modifiers: Ruint;
  end;

  RPenEvent = record
    phase: RPenPhase;
    window: Rid;
    target: Rid;
    x: float32;
    y: float32;
    local_x: float32;
    local_y: float32;
    pressure: float32;
    raw_pressure: float32;
    tilt_x: float32;
    tilt_y: float32;
    rotation: float32;
    eraser: int32;
    buttons: Ruint;
    modifiers: Ruint;
  end;

  RGestureEvent = record
    phase: RGesturePhase;
    window: Rid;
    target: Rid;
    x: float32;
    y: float32;
    local_x: float32;
    local_y: float32;
    scale: float32;
    scale_delta: float32;
    pan_x: float32;
    pan_y: float32;
    rotation: float32;
    kind: RGestureKind;
    device: RGestureDevice;
    fingers: int32;
    total_x: float32;
    total_y: float32;
    rotation_delta: float32;
    cancelled: int32;
  end;

  RTouchCallback = func clink(widget: Rid; event: ptr to const RTouchEvent; user_data: ptr): int32;
  RPenCallback = func clink(widget: Rid; event: ptr to const RPenEvent; user_data: ptr): int32;
  RGestureCallback = func clink(widget: Rid; event: ptr to const RGestureEvent; user_data: ptr): int32;

  RLook = int32;
  RTheme = int32;
  RMaterial = int32;
  RColorRole = int32;
  RMetric = int32;
  RFontStyle = int32;
  RFilterType = int32;
  RWidgetType = int32;
  RHAlign = int32;
  RVAlign = int32;
  RVisibility = int32;
  RTransition = int32;
  ROrientation = int32;

  RWidgetDestroyCallback = func clink(widget: Rid; user_data: ptr);
  RWidgetEventCallback = func clink(widget: Rid; event: ptr to const REvent; user_data: ptr): int32;

  RBlurStyle = int32;

  RTabChangedCallback = func clink(tab_view: Rid; index: int32; user_data: ptr);
  RTabCloseCallback = func clink(tab_view: Rid; index: int32; content: Rid; user_data: ptr): int32;
  RExpanderChangedCallback = func clink(expander: Rid; expanded: int32; user_data: ptr);

  RDirection = int32;
  RTextAlign = int32;
  RToastKind = int32;
  RToastQueue = int32;
  RButtonStyle = int32;
  RCheckboxStyle = int32;
  RStretch = int32;
  RPlotAxis = int32;
  RPdfFit = int32;
  RPdfStatus = int32;
  RPdfFont = int32;
  RPdfPaint = int32;
  RPdfTextStyle = int32;
  RPdfPrintFlags = int32;

  RPdfPrintDesc = record
    window: Rid;
    title: ptr to const char;
    printer: ptr to const char;
    copies: int32;
    flags: Ruint;
    output: ptr to const char;
    password: ptr to const char;
  end;

  RMapTileState = int32;
  RPlotScale = int32;
  RPlotLine = int32;
  RPlotMarker = int32;
  RPlotLegend = int32;
  RChartKind = int32;

  RLabelLinkCallback = func clink(label: Rid; url: ptr to const char; user_data: ptr);
  RButtonClickedCallback = func clink(button: Rid; user_data: ptr);
  RCheckboxChangedCallback = func clink(checkbox: Rid; checked: int32; user_data: ptr);
  RSliderChangedCallback = func clink(slider: Rid; value: float32; user_data: ptr);
  RTextChangedCallback = func clink(text_input: Rid; text: ptr to const char; user_data: ptr);
  RSpinBoxChangedCallback = func clink(spin_box: Rid; value: float64; user_data: ptr);
  RComboBoxChangedCallback = func clink(combo_box: Rid; index: int32; user_data: ptr);
  RListItemTextCallback = func clink(list_view: Rid; index: int32; user_data: ptr): ptr to const char;
  RListItemColorCallback = func clink(list_view: Rid; index: int32; r: ptr to float32; g: ptr to float32; b: ptr to float32; a: ptr to float32; user_data: ptr): int32;
  RListEventCallback = func clink(list_view: Rid; index: int32; user_data: ptr);
  RTreeEventCallback = func clink(tree_view: Rid; item: Rid; user_data: ptr);
  RTreeContextCallback = func clink(tree_view: Rid; item: Rid; x: float32; y: float32; user_data: ptr);
  RMenuItemClickedCallback = func clink(item: Rid; user_data: ptr);

  RTileItem = record
    text: ptr to const char;
    detail: ptr to const char;
    badge: ptr to const char;
    icon: Rid;
    uv: array[0..3] of float32;
    tint: array[0..3] of float32;
    icon_radius: float32;
    text_color: array[0..3] of float32;
    note: ptr to const char;
    detail_color: array[0..3] of float32;
  end;

  RTileSection = record
    first: int32;
    text: ptr to const char;
    detail: ptr to const char;
  end;

  RTileSectionCallback = func clink(tile_view: Rid; section: int32; out: ptr to RTileSection; user_data: ptr);
  RTileItemCallback = func clink(tile_view: Rid; index: int32; item: ptr to RTileItem; user_data: ptr);
  RTileEventCallback = func clink(tile_view: Rid; index: int32; user_data: ptr);
  RTileContextCallback = func clink(tile_view: Rid; index: int32; x: float32; y: float32; user_data: ptr);
  RTileDragDataCallback = func clink(tile_view: Rid; user_data: ptr): ptr to const char;
  RTableCellTextCallback = func clink(table: Rid; row: int32; column: int32; user_data: ptr): ptr to const char;
  RTableCellColorCallback = func clink(table: Rid; row: int32; column: int32; r: ptr to float32; g: ptr to float32; b: ptr to float32; a: ptr to float32; user_data: ptr): int32;
  RTableEventCallback = func clink(table: Rid; row: int32; user_data: ptr);
  RTableSortCallback = func clink(table: Rid; column: int32; descending: int32; user_data: ptr);
  RDateChangedCallback = func clink(date_picker: Rid; year: int32; month: int32; day: int32; user_data: ptr);
  RTimeChangedCallback = func clink(time_picker: Rid; hour: int32; minute: int32; second: int32; user_data: ptr);
  RToastCallback = func clink(toast: Rid; user_data: ptr);
  RBreadcrumbCallback = func clink(breadcrumb: Rid; index: int32; user_data: ptr);
  RRatingChangedCallback = func clink(rating: Rid; value: float32; user_data: ptr);
  RPageChangedCallback = func clink(pagination: Rid; page: int32; user_data: ptr);
  RPlotViewCallback = func clink(plot: Rid; user_data: ptr);
  RPlotDragLineCallback = func clink(plot: Rid; line: int32; value: float64; user_data: ptr);
  RPlotSeriesCallback = func clink(plot: Rid; series: int32; visible: int32; user_data: ptr);
  RChartSliceCallback = func clink(chart: Rid; slice: int32; selected: int32; user_data: ptr);
  RChartCellCallback = func clink(chart: Rid; row: int32; column: int32; value: float32; user_data: ptr);
  RPdfPageChangedCallback = func clink(view: Rid; page: int32; user_data: ptr);
  RCarouselPageChangedCallback = func clink(carousel: Rid; page: int32; user_data: ptr);
  RMapTileCallback = func clink(map: Rid; z: int32; x: int32; y: int32; user_data: ptr);
  RMapMarkerCallback = func clink(map: Rid; marker: int32; user_data: ptr);
  RMapViewCallback = func clink(map: Rid; latitude: float64; longitude: float64; zoom: float64; user_data: ptr);

  RSyntax = int32;
  RLanguageFlags = int32;

  RLanguageDesc = record
    name: ptr to const char;
    extensions: ptr to const char;
