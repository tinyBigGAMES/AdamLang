  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.Collections.adam - the generic containers (BNF sec 10, PLAN-ADAM
  M10g)

  List<T>  a growable list of T in the order added: Add / Insert / Delete,
           LO[i] read and written (an index outside 0 .. Count - 1 raises
           code 14, as an array's index check does), IndexOf / Contains /
           Remove by T's '=', Sort (stable merge sort by T's '<', n log n),
           Reverse, ToArray. The storage doubles when it is full, so n Adds
           cost O(n); a place a value leaves is emptied at once, so a list
           never keeps a string, array or reference it no longer holds.
  Map<K, V> a map from K to V by K's hash(X) and '=' (BNF sec 7), its keys
           in the order first put: Put / Get (raises code 1 for a key it does
           not hold) / TryGet / Has / Remove / Clear, M[k] read and written
           (a write puts), Keys / Values in that order. Its entries sit in
           order in dense arrays, an open-addressed index (linear probing,
           a power-of-two size, at most three quarters used, removed ones
           kept as tombstones) over them; a rebuild drops the removed
           entries, so each operation costs O(1) on average.
  Set<T>   a set of T over a Map<T, bool>: Add (false when it held the item)
           / Has / Remove / Clear, Items in the order added.

  Every container is a value: a variable, a field or an element starts
  empty, a copy copies its items. A body is checked per instance (BNF sec
  10), so a List<T> of a T with no '=' builds until IndexOf is called.

  Target-neutral (PROJECT AT.3): nothing here names an OS.
*******************************************************************************/

module unit System.Collections;

import System.SysUtils;

public const
  // The code an index outside a container raises with: the runtime's index check's own
  // (System.Runtime's ADAM_RUNTIME_EXC_INDEX), so a list reads as an array does
  ADAM_COLLECTIONS_EXC_INDEX: int32 = 14;
  // A list's first storage, doubled each time it is full
  ADAM_COLLECTIONS_FIRST_CAPACITY: int64 = 4;
  // The code a map's Get of a key it does not hold raises with
  ADAM_COLLECTIONS_EXC_KEY: int32 = 1;
  // A map index's first size (a power of two, doubled while it is more than half used
  // after a rebuild)
  ADAM_COLLECTIONS_FIRST_INDEX: int64 = 8;
  // A map index slot no entry has used, and one whose entry was removed (a tombstone: a
  // search goes on past it); any other slot holds its entry's position + 1
  ADAM_COLLECTIONS_SLOT_EMPTY: int64 = 0;
  ADAM_COLLECTIONS_SLOT_REMOVED: int64 = -1;

// The index check's raise: `index N is out of bounds 0..H`, or `..: it is empty`, the
// runtime's own wording for an array
func IndexFault(const AIndex: int64; const ACount: int64); noreturn;
begin
  if ACount = 0 then
    raisecode(ADAM_COLLECTIONS_EXC_INDEX, "index " + IntToStr(AIndex) +
      " is out of bounds: it is empty");
  end;
  raisecode(ADAM_COLLECTIONS_EXC_INDEX, "index " + IntToStr(AIndex) +
    " is out of bounds 0.." + IntToStr(ACount - 1));
end;

public type
  // A growable list of T, in the order added (see the header)
  List<T> = object
    hidden FItems: array of T;
    hidden FCount: int64;

    // How many items the list holds
    property Count: int64 read FCount;

    // The item at AIndex (0-based), read and written; raises code 14 outside 0 .. Count - 1
    property Items[AIndex: int64]: T
      read
      begin
        if (AIndex < 0) or (AIndex >= self.FCount) then
          IndexFault(AIndex, self.FCount);
        end;
        return self.FItems[AIndex];
      end;
      write(AValue)
      begin
        if (AIndex < 0) or (AIndex >= self.FCount) then
          IndexFault(AIndex, self.FCount);
        end;
        self.FItems[AIndex] := AValue;
      end;
      default;

    // Room for ANeed items: the storage doubles (from the first capacity) until it holds them
    hidden method DoReserve(const ANeed: int64);
    var
      LSize: int64;
    begin
      if ANeed <= len(self.FItems) then
        return;
      end;
      LSize := len(self.FItems) * 2;
      if LSize < ADAM_COLLECTIONS_FIRST_CAPACITY then
        LSize := ADAM_COLLECTIONS_FIRST_CAPACITY;
      end;
      if LSize < ANeed then
        LSize := ANeed;
      end;
      setlength(self.FItems, LSize);
    end;

    // The place at AIndex emptied (a value left there would keep what it holds alive)
    hidden method DoEmpty(const AIndex: int64);
    var
      LEmpty: T;
    begin
      self.FItems[AIndex] := LEmpty;
    end;

    // Adds AItem at the end
    method Add(const AItem: T);
    begin
      self.DoReserve(self.FCount + 1);
      self.FItems[self.FCount] := AItem;
      self.FCount := self.FCount + 1;
    end;

    // Puts AItem at AIndex, the items from there on one place up; AIndex = Count adds it at
    // the end; raises code 14 outside 0 .. Count
    method Insert(const AIndex: int64; const AItem: T);
    var
      LI: int64;
    begin
      if (AIndex < 0) or (AIndex > self.FCount) then
        IndexFault(AIndex, self.FCount + 1);
      end;
      self.DoReserve(self.FCount + 1);
      LI := self.FCount;
      while LI > AIndex do
        self.FItems[LI] := self.FItems[LI - 1];
        LI := LI - 1;
      end;
      self.FItems[AIndex] := AItem;
      self.FCount := self.FCount + 1;
    end;

    // Takes the item at AIndex out, the items after it one place down; raises code 14
    // outside 0 .. Count - 1
    method Delete(const AIndex: int64);
    var
      LI: int64;
    begin
      if (AIndex < 0) or (AIndex >= self.FCount) then
        IndexFault(AIndex, self.FCount);
      end;
      for LI := AIndex to self.FCount - 2 do
        self.FItems[LI] := self.FItems[LI + 1];
      end;
      self.FCount := self.FCount - 1;
      self.DoEmpty(self.FCount);
    end;

    // Takes the last item off the list and returns it; raises code 14 when it is empty
    method RemoveLast(): T;
    var
      LItem: T;
    begin
      if self.FCount = 0 then
        IndexFault(-1, 0);
      end;
      self.FCount := self.FCount - 1;
      LItem := self.FItems[self.FCount];
      self.DoEmpty(self.FCount);
      return LItem;
    end;

    // No items (the storage kept for the items added next, every place emptied)
    method Clear();
    var
      LI: int64;
    begin
      for LI := 0 to self.FCount - 1 do
        self.DoEmpty(LI);
      end;
      self.FCount := 0;
    end;

    // The index of the first item = AItem; -1 when there is none
    const method IndexOf(const AItem: T): int64;
    var
      LI: int64;
    begin
      for LI := 0 to self.FCount - 1 do
        if self.FItems[LI] = AItem then
          return LI;
        end;
      end;
      return -1;
    end;

    // Whether an item = AItem
    const method Contains(const AItem: T): bool;
    begin
      return self.IndexOf(AItem) >= 0;
    end;

    // Takes the first item = AItem out; false when there is none
    method Remove(const AItem: T): bool;
    var
      LIndex: int64;
    begin
      LIndex := self.IndexOf(AItem);
      if LIndex < 0 then
        return false;
      end;
      self.Delete(LIndex);
      return true;
    end;

    // The items in the opposite order
    method Reverse();
    var
      LLow: int64;
      LHigh: int64;
      LItem: T;
    begin
      LLow := 0;
      LHigh := self.FCount - 1;
      while LLow < LHigh do
        LItem := self.FItems[LLow];
        self.FItems[LLow] := self.FItems[LHigh];
        self.FItems[LHigh] := LItem;
        LLow := LLow + 1;
        LHigh := LHigh - 1;
      end;
    end;

    // The items sorted ascending by T's '<', equal items kept in their order: a bottom-up
    // merge sort, runs of 1, 2, 4 .. merged from the items into a buffer and back, n log n
    method Sort();
    var
      LFrom: array of T;
      LTo: array of T;
      LSwap: array of T;
      LWidth: int64;
      LLow: int64;
      LMiddle: int64;
      LHigh: int64;
      LLeft: int64;
      LRight: int64;
      LOut: int64;
      LI: int64;
    begin
      if self.FCount < 2 then
        return;
      end;
      setlength(LFrom, self.FCount);
      setlength(LTo, self.FCount);
      for LI := 0 to self.FCount - 1 do
        LFrom[LI] := self.FItems[LI];
      end;
      LWidth := 1;
      while LWidth < self.FCount do
        LLow := 0;
        while LLow < self.FCount do
          LMiddle := LLow + LWidth;
          if LMiddle > self.FCount then
            LMiddle := self.FCount;
          end;
          LHigh := LMiddle + LWidth;
          if LHigh > self.FCount then
            LHigh := self.FCount;
          end;
          // Merge LFrom[LLow .. LMiddle - 1] and LFrom[LMiddle .. LHigh - 1] into LTo: the
          // right run's item goes first only when it is below the left's (stable)
          LLeft := LLow;
          LRight := LMiddle;
          for LOut := LLow to LHigh - 1 do
            if (LLeft < LMiddle) and ((LRight >= LHigh) or not (LFrom[LRight] < LFrom[LLeft])) then
              LTo[LOut] := LFrom[LLeft];
              LLeft := LLeft + 1;
            else
              LTo[LOut] := LFrom[LRight];
              LRight := LRight + 1;
            end;
          end;
          LLow := LHigh;
        end;
        LSwap := LFrom;
        LFrom := LTo;
        LTo := LSwap;
        // LTo is written next: no other array may still share its block
        setlength(LSwap, 0);
        LWidth := LWidth * 2;
      end;
      for LI := 0 to self.FCount - 1 do
        self.FItems[LI] := LFrom[LI];
      end;
    end;

    // The items as a new array, in list order
    const method ToArray(): array of T;
    var
      LItems: array of T;
      LI: int64;
    begin
      setlength(LItems, self.FCount);
      for LI := 0 to self.FCount - 1 do
        LItems[LI] := self.FItems[LI];
      end;
      return LItems;
    end;
  end;

  // A map from K to V, its keys in the order first put (see the header)
  Map<K, V> = object
    // The entries in the order put, FUsed of them (removed ones among them, FLive false)
    hidden FKeys: array of K;
    hidden FValues: array of V;
    hidden FHashes: array of uint64;
    hidden FLive: array of bool;
    hidden FUsed: int64;
    hidden FCount: int64;
    // The index: by a key's hash, the slot that holds its entry's position + 1 (or one of
    // ADAM_COLLECTIONS_SLOT_EMPTY / _REMOVED); its size a power of two, 0 before the first put
    hidden FIndex: array of int64;
    // The slots used, by entries or tombstones (a rebuild when three quarters are)
    hidden FTaken: int64;

    // How many keys the map holds
    property Count: int64 read FCount;

    // The value of AKey: read, it is Get's (raises code 1 for a key the map does not hold);
    // written, it is Put's
    property Items[const AKey: K]: V
      read
      begin
        return self.Get(AKey);
      end;
      write(AValue)
      begin
        self.Put(AKey, AValue);
      end;
      default;

    // The index slot of AKey (its hash AHash): the one holding its entry, else -1
    hidden const method DoSlotOf(const AKey: K; const AHash: uint64): int64;
    var
      LMask: int64;
      LSlot: int64;
      LEntry: int64;
    begin
      if len(self.FIndex) = 0 then
        return -1;
      end;
      LMask := len(self.FIndex) - 1;
      LSlot := int64(AHash & uint64(LMask));
      // linear probing: an empty slot ends the search, a tombstone does not (its entry's
      // key may have been put after a collision past it)
      while self.FIndex[LSlot] <> ADAM_COLLECTIONS_SLOT_EMPTY do
        LEntry := self.FIndex[LSlot] - 1;
        if (LEntry >= 0) and (self.FHashes[LEntry] = AHash) and (self.FKeys[LEntry] = AKey) then
          return LSlot;
        end;
        LSlot := (LSlot + 1) & LMask;
      end;
      return -1;
    end;

    // The entry position of AKey (its hash AHash), else -1
    hidden const method DoEntryOf(const AKey: K; const AHash: uint64): int64;
    var
      LSlot: int64;
    begin
      LSlot := self.DoSlotOf(AKey, AHash);
      if LSlot < 0 then
        return -1;
      end;
      return self.FIndex[LSlot] - 1;
    end;

    // The entry AEntry (its hash AHash) put in the first free slot of its probe line
    hidden method DoPlace(const AHash: uint64; const AEntry: int64);
    var
      LMask: int64;
      LSlot: int64;
    begin
      LMask := len(self.FIndex) - 1;
      LSlot := int64(AHash & uint64(LMask));
      while self.FIndex[LSlot] <> ADAM_COLLECTIONS_SLOT_EMPTY do
        LSlot := (LSlot + 1) & LMask;
      end;
      self.FIndex[LSlot] := AEntry + 1;
      self.FTaken := self.FTaken + 1;
    end;

    // The entries' places from AFrom on emptied (a value left there would keep what it
    // holds alive)
    hidden method DoEmptyFrom(const AFrom: int64);
    var
      LKey: K;
      LValue: V;
      LI: int64;
    begin
      for LI := AFrom to self.FUsed - 1 do
        self.FKeys[LI] := LKey;
        self.FValues[LI] := LValue;
        self.FHashes[LI] := uint64(0);
        self.FLive[LI] := false;
      end;
    end;

    // The entry place AEntry emptied (DoEmptyFrom's, one place)
    hidden method DoEmptyAt(const AEntry: int64);
    var
      LKey: K;
      LValue: V;
    begin
      self.FKeys[AEntry] := LKey;
      self.FValues[AEntry] := LValue;
      self.FHashes[AEntry] := uint64(0);
      self.FLive[AEntry] := false;
    end;

    // The entries compacted in their order (the removed ones dropped) and the index made
    // again at the first power of two at least twice the entries one more needs
    hidden method DoRebuild();
    var
      LTo: int64;
      LSize: int64;
      LI: int64;
      LUsed: int64;
    begin
      LTo := 0;
      for LI := 0 to self.FUsed - 1 do
        if self.FLive[LI] then
          if LTo <> LI then
            self.FKeys[LTo] := self.FKeys[LI];
            self.FValues[LTo] := self.FValues[LI];
            self.FHashes[LTo] := self.FHashes[LI];
            self.FLive[LTo] := true;
          end;
          LTo := LTo + 1;
        end;
      end;
      LUsed := self.FUsed;
      self.FUsed := LTo;
      // the places the compaction left behind, emptied
      for LI := LTo to LUsed - 1 do
        self.DoEmptyAt(LI);
      end;
      LSize := ADAM_COLLECTIONS_FIRST_INDEX;
      while LSize < (self.FCount + 1) * 2 do
        LSize := LSize * 2;
      end;
      setlength(self.FIndex, 0);
      setlength(self.FIndex, LSize);
      self.FTaken := 0;
      for LI := 0 to self.FUsed - 1 do
        self.DoPlace(self.FHashes[LI], LI);
      end;
    end;

    // Room for one more entry: the index rebuilt when a new slot would make it more than
    // three quarters used, the entry arrays doubled when they are full
    hidden method DoRoom();
    var
      LSize: int64;
    begin
      if (len(self.FIndex) = 0) or ((self.FTaken + 1) * 4 > len(self.FIndex) * 3) then
        self.DoRebuild();
      end;
      if self.FUsed = len(self.FKeys) then
        LSize := len(self.FKeys) * 2;
        if LSize < ADAM_COLLECTIONS_FIRST_CAPACITY then
          LSize := ADAM_COLLECTIONS_FIRST_CAPACITY;
        end;
        setlength(self.FKeys, LSize);
        setlength(self.FValues, LSize);
        setlength(self.FHashes, LSize);
        setlength(self.FLive, LSize);
      end;
    end;

    // AKey maps to AValue: the value of a key the map holds replaced, a new key added last
    method Put(const AKey: K; const AValue: V);
    var
      LHash: uint64;
      LEntry: int64;
    begin
      LHash := hash(AKey);
      LEntry := self.DoEntryOf(AKey, LHash);
      if LEntry >= 0 then
        self.FValues[LEntry] := AValue;
        return;
      end;
      self.DoRoom();
      LEntry := self.FUsed;
      self.FKeys[LEntry] := AKey;
      self.FValues[LEntry] := AValue;
      self.FHashes[LEntry] := LHash;
      self.FLive[LEntry] := true;
      self.FUsed := self.FUsed + 1;
      self.FCount := self.FCount + 1;
      self.DoPlace(LHash, LEntry);
    end;

    // The value of AKey; raises code 1 when the map does not hold it
    const method Get(const AKey: K): V;
    var
      LEntry: int64;
    begin
      LEntry := self.DoEntryOf(AKey, hash(AKey));
      if LEntry < 0 then
        raisecode(ADAM_COLLECTIONS_EXC_KEY, "the key is not in the map");
      end;
      return self.FValues[LEntry];
    end;

    // The value of AKey into AValue, true; false (AValue left as it was) when the map does
    // not hold it
    const method TryGet(const AKey: K; var AValue: V): bool;
    var
      LEntry: int64;
    begin
      LEntry := self.DoEntryOf(AKey, hash(AKey));
      if LEntry < 0 then
        return false;
      end;
      AValue := self.FValues[LEntry];
      return true;
    end;

    // Whether the map holds AKey
    const method Has(const AKey: K): bool;
    begin
      return self.DoEntryOf(AKey, hash(AKey)) >= 0;
    end;

    // AKey and its value taken out (its slot a tombstone, its entry's place emptied); false
    // when the map does not hold it. The last key out empties the map
    method Remove(const AKey: K): bool;
    var
      LSlot: int64;
    begin
      LSlot := self.DoSlotOf(AKey, hash(AKey));
      if LSlot < 0 then
        return false;
      end;
      self.DoEmptyAt(self.FIndex[LSlot] - 1);
      self.FIndex[LSlot] := ADAM_COLLECTIONS_SLOT_REMOVED;
      self.FCount := self.FCount - 1;
      if self.FCount = 0 then
        self.Clear();
      end;
      return true;
    end;

    // No keys (the storage kept for the keys put next, every place emptied)
    method Clear();
    var
      LI: int64;
    begin
      self.DoEmptyFrom(0);
      self.FUsed := 0;
      self.FCount := 0;
      self.FTaken := 0;
      for LI := 0 to len(self.FIndex) - 1 do
        self.FIndex[LI] := ADAM_COLLECTIONS_SLOT_EMPTY;
      end;
    end;

    // The keys as a new array, in the order first put
    const method Keys(): array of K;
    var
      LKeys: array of K;
      LAt: int64;
      LI: int64;
    begin
      setlength(LKeys, self.FCount);
      LAt := 0;
      for LI := 0 to self.FUsed - 1 do
        if self.FLive[LI] then
          LKeys[LAt] := self.FKeys[LI];
          LAt := LAt + 1;
        end;
      end;
      return LKeys;
    end;

    // The values as a new array, in their keys' order (Keys)
    const method Values(): array of V;
    var
      LValues: array of V;
      LAt: int64;
      LI: int64;
    begin
      setlength(LValues, self.FCount);
      LAt := 0;
      for LI := 0 to self.FUsed - 1 do
        if self.FLive[LI] then
          LValues[LAt] := self.FValues[LI];
          LAt := LAt + 1;
        end;
      end;
      return LValues;
    end;
  end;

  // A set of T, the items in the order added (see the header)
  Set<T> = object
    hidden FMap: Map<T, bool>;

    // How many items the set holds
    property Count: int64
      read
      begin
        return self.FMap.Count;
      end;

    // AItem added (last); false when the set held it already (nothing changes)
    method Add(const AItem: T): bool;
    begin
      if self.FMap.Has(AItem) then
        return false;
      end;
      self.FMap.Put(AItem, true);
      return true;
    end;

    // Whether the set holds AItem
    const method Has(const AItem: T): bool;
    begin
      return self.FMap.Has(AItem);
    end;

    // AItem taken out; false when the set did not hold it
    method Remove(const AItem: T): bool;
    begin
      return self.FMap.Remove(AItem);
    end;

    // No items
    method Clear();
    begin
      self.FMap.Clear();
    end;

    // The items as a new array, in the order added
    const method Items(): array of T;
    begin
      return self.FMap.Keys();
    end;
  end;

end.
