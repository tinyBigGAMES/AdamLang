-------------------------------------------------------------------------------
  System.Linux.adam - glibc's POSIX declarations for Adam's x86_64-linux-gnu
  units (the SDK block, AD.5a): each name, value and layout as glibc's x86_64
  headers spell it, declared once here and imported wherever a std platform
  unit needs it (System.IO.Linux64; System.Console.Linux64 and
  System.Process.Linux64 add theirs). Declarations only, no Adam routine:
  the jobs over them are the platform units'.

  Bound to glibc's libc.so.6 (`external "c"`) at Adam's glibc floor 2.29
  (research PLAN-LINUX64 kb_glibc_floor.md): the stat family is glibc's
  __xstat (stat itself is a symbol only from 2.33), getrandom is 2.25.
  Fields glibc spells with '__' (struct stat's __pad0, __glibc_reserved) are
  pad0 / reserved: '__' names are the compiler's.
*******************************************************************************/

module unit System.Linux;

public type
  // struct timespec (time.h): seconds and nanoseconds
  timespec = record
    tv_sec: int64;
    tv_nsec: int64;
  end;

  // struct stat (x86_64, 144 bytes; bits/struct_stat.h)
  stat = record
    st_dev: uint64;
    st_ino: uint64;
    st_nlink: uint64;
    st_mode: uint32;
    st_uid: uint32;
    st_gid: uint32;
    pad0: int32;
    st_rdev: uint64;
    st_size: int64;
    st_blksize: int64;
    st_blocks: int64;
    st_atim: timespec;
    st_mtim: timespec;
    st_ctim: timespec;
    reserved: array[0..2] of int64;
  end;

public const
  // sys/stat.h: the stat version x86_64's __xstat takes (_STAT_VER_LINUX); st_mode's file type
  // bits and its kinds
  _STAT_VER: int32 = 1;
  S_IFMT: uint32 = 0xF000;
  S_IFDIR: uint32 = 0x4000;
  S_IFREG: uint32 = 0x8000;
  // sys/stat.h: st_mode's permission bits (the owner's write, the group's, others')
  S_IWUSR: uint32 = 0x80;
  S_IWGRP: uint32 = 0x10;
  S_IWOTH: uint32 = 0x2;
  // stdio.h: the folder for temporary files when $TMPDIR names none
  P_tmpdir: string = "/tmp";
  // time.h: the clock from a fixed point, never going back
  CLOCK_MONOTONIC: int32 = 1;
  // errno.h: a call a signal broke off (System.Runtime's CErrno reads errno)
  EINTR: int32 = 4;

// glibc: a path's facts, a link followed to its target (stat as every glibc exports it)
public routine __xstat(const AVersion: int32; const APath: ptr to const char; var AStat: stat): int32;
  external "c";
// glibc: a folder made (AMode before the umask), a name moved over another in one step
public routine mkdir(const APath: ptr to const char; const AMode: uint32): int32; external "c";
public routine rename(const AOldPath: ptr to const char; const ANewPath: ptr to const char): int32;
  external "c";
// glibc: an empty folder removed, a file's permission bits set
public routine rmdir(const APath: ptr to const char): int32; external "c";
public routine chmod(const APath: ptr to const char; const AMode: uint32): int32; external "c";

// glibc: an environment variable's value (nil when it is not set)
public routine getenv(const AName: ptr to const char): ptr to char; external "c";
// glibc: an environment variable set (AOverwrite <> 0: an existing value replaced)
public routine setenv(const AName: ptr to const char; const AValue: ptr to const char;
  const AOverwrite: int32): int32; external "c";

// glibc: bytes from the kernel's secure random generator (AFlags 0: the urandom source, waits
// only until it is first seeded)
public routine getrandom(const ABuffer: ptr; const ACount: uint64; const AFlags: uint32): int64;
  external "c";

// glibc: a clock read, the calling thread asleep (ARemaining: what is left when a signal woke it)
public routine clock_gettime(const AClock: int32; var ATime: timespec): int32; external "c";
public routine nanosleep(const ATime: ptr to const timespec; const ARemaining: ptr to timespec): int32;
  external "c";

end.
