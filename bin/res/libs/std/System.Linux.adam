-------------------------------------------------------------------------------
  System.Linux.adam - glibc's POSIX declarations for Adam's x86_64-linux-gnu
  units (the SDK block, AD.5a): each name, value and layout as glibc's x86_64
  headers spell it, declared once here and imported wherever a std platform
  unit needs it (System.IO.Linux64, System.Console.Linux64,
  System.Process.Linux64). Declarations only, no Adam routine: the jobs
  over them are the platform units'.

  Bound to glibc's libc.so.6 (`external "c"`) at Adam's glibc floor 2.29
  (research PLAN-LINUX64 kb_glibc_floor.md): the stat family is glibc's
  __xstat (stat itself is a symbol only from 2.33), getrandom is 2.25.
  Fields glibc spells with '__' (struct stat's __pad0, __glibc_reserved) are
  pad0 / reserved: '__' names are the compiler's.
*******************************************************************************/

module unit System.Linux;

public type
  // struct timespec (time.h): seconds and nanoseconds
  timespec = record
    tv_sec: int64;
    tv_nsec: int64;
  end;

  // struct stat (x86_64, 144 bytes; bits/struct_stat.h)
  stat = record
    st_dev: uint64;
    st_ino: uint64;
    st_nlink: uint64;
    st_mode: uint32;
    st_uid: uint32;
    st_gid: uint32;
    pad0: int32;
    st_rdev: uint64;
    st_size: int64;
    st_blksize: int64;
    st_blocks: int64;
    st_atim: timespec;
    st_mtim: timespec;
    st_ctim: timespec;
    reserved: array[0..2] of int64;
  end;

  // struct termios (x86_64, 60 bytes; bits/termios-struct.h): the four mode words, the line
  // discipline, the NCCS control characters, the two speeds
  termios = record
    c_iflag: uint32;
    c_oflag: uint32;
    c_cflag: uint32;
    c_lflag: uint32;
    c_line: uint8;
    c_cc: array[0..31] of uint8;
    c_ispeed: uint32;
    c_ospeed: uint32;
  end;

  // struct winsize (sys/ioctl.h, bits/ioctl-types.h): a terminal's size in characters and pixels
  winsize = record
    ws_row: uint16;
    ws_col: uint16;
    ws_xpixel: uint16;
    ws_ypixel: uint16;
  end;

  // struct pollfd (sys/poll.h): one descriptor, the events asked for, the events seen
  pollfd = record
    fd: int32;
    events: int16;
    revents: int16;
  end;

  // sigset_t (x86_64, 128 bytes; bits/types/__sigset_t.h): one bit per signal
  sigset_t = record
    val: array[0..15] of uint64;
  end;

  // struct sched_param (bits/types/struct_sched_param.h): a scheduling priority
  sched_param = record
    sched_priority: int32;
  end;

  // posix_spawn_file_actions_t (x86_64, 80 bytes; spawn.h): what a started program's
  // descriptors are made, in order; filled by the posix_spawn_file_actions_* calls only
  posix_spawn_file_actions_t = record
    allocated: int32;
    used: int32;
    actions: ptr;
    pad: array[0..15] of int32;
  end;

  // posix_spawnattr_t (x86_64, 336 bytes; spawn.h): a start's flags, process group, signal
  // defaults and mask, scheduling; filled by the posix_spawnattr_* calls only
  posix_spawnattr_t = record
    flags: int16;
    pgrp: int32;
    sd: sigset_t;
    ss: sigset_t;
    sp: sched_param;
    policy: int32;
    pad: array[0..15] of int32;
  end;

public const
  // sys/stat.h: the stat version x86_64's __xstat takes (_STAT_VER_LINUX); st_mode's file type
  // bits and its kinds
  _STAT_VER: int32 = 1;
  S_IFMT: uint32 = 0xF000;
  S_IFDIR: uint32 = 0x4000;
  S_IFREG: uint32 = 0x8000;
  // sys/stat.h: st_mode's permission bits (the owner's write, the group's, others')
  S_IWUSR: uint32 = 0x80;
  S_IWGRP: uint32 = 0x10;
  S_IWOTH: uint32 = 0x2;
  // sys/stat.h: st_mode's execute bits (the owner's, the group's, others') and every
  // permission bit (set-id and sticky included)
  S_IXUSR: uint32 = 0x40;
  S_IXGRP: uint32 = 0x8;
  S_IXOTH: uint32 = 0x1;
  ALLPERMS: uint32 = 0xFFF;
  // fcntl.h: open's access and flags (read only, read and write; never as the controlling
  // terminal; closed across an exec)
  O_RDONLY: int32 = 0;
  O_RDWR: int32 = 2;
  O_NOCTTY: int32 = 0x100;
  O_CLOEXEC: int32 = 0x80000;
  // fcntl.h: fcntl's request for a copy of a descriptor at or above its argument, closed
  // across an exec
  F_DUPFD_CLOEXEC: int32 = 1030;
  // stdio.h: the folder for temporary files when $TMPDIR names none
  P_tmpdir: string = "/tmp";
  // time.h: the clock from a fixed point, never going back
  CLOCK_MONOTONIC: int32 = 1;
  // errno.h: a call a signal broke off (System.Runtime's CErrno reads errno)
  EINTR: int32 = 4;
  // unistd.h: the standard descriptors
  STDIN_FILENO: int32 = 0;
  STDOUT_FILENO: int32 = 1;
  STDERR_FILENO: int32 = 2;
  // sys/wait.h: waitpid returns at once when no child has changed state
  WNOHANG: int32 = 1;
  // spawn.h: posix_spawnattr_setflags' flags (the signal defaults and mask set; a new session)
  POSIX_SPAWN_SETSIGDEF: int16 = 0x4;
  POSIX_SPAWN_SETSIGMASK: int16 = 0x8;
  POSIX_SPAWN_SETSID: int16 = 0x80;
  // termios.h (bits/termios-*.h, x86_64): tcsetattr's when (TCSANOW: at once), tcflush's queue
  // (TCIFLUSH: the input received, not yet read), c_cc's indexes (VTIME, VMIN; NCCS of them)
  TCSANOW: int32 = 0;
  TCIFLUSH: int32 = 0;
  NCCS: int32 = 32;
  VTIME: int32 = 5;
  VMIN: int32 = 6;
  // termios.h: c_iflag's CR read as NL and XON / XOFF flow control; c_lflag's signal keys,
  // line editing (canonical mode), echo and the implementation's extra keys (Ctrl+V)
  ICRNL: uint32 = 0x100;
  IXON: uint32 = 0x400;
  ISIG: uint32 = 0x1;
  ICANON: uint32 = 0x2;
  ECHO: uint32 = 0x8;
  IEXTEN: uint32 = 0x8000;
  // asm-generic/ioctls.h: a terminal's size read / set (struct winsize)
  TIOCGWINSZ: uint64 = 0x5413;
  TIOCSWINSZ: uint64 = 0x5414;
  // poll.h: data to read
  POLLIN: int16 = 0x1;

public var
  // glibc (unistd.h): the process's environment as it is now (setenv changes it), NULL-ended
  environ: ptr to ptr to char; external "c";

// glibc: a path's facts, a link followed to its target (stat as every glibc exports it)
public routine __xstat(const AVersion: int32; const APath: ptr to const char; var AStat: stat): int32;
  external "c";
// glibc: a folder made (AMode before the umask), a name moved over another in one step
public routine mkdir(const APath: ptr to const char; const AMode: uint32): int32; external "c";
public routine rename(const AOldPath: ptr to const char; const ANewPath: ptr to const char): int32;
  external "c";
// glibc: an empty folder removed, a file's permission bits set
public routine rmdir(const APath: ptr to const char): int32; external "c";
public routine chmod(const APath: ptr to const char; const AMode: uint32): int32; external "c";

// glibc: an environment variable's value (nil when it is not set)
public routine getenv(const AName: ptr to const char): ptr to char; external "c";
// glibc: an environment variable set (AOverwrite <> 0: an existing value replaced)
public routine setenv(const AName: ptr to const char; const AValue: ptr to const char;
  const AOverwrite: int32): int32; external "c";

// glibc: bytes from the kernel's secure random generator (AFlags 0: the urandom source, waits
// only until it is first seeded)
public routine getrandom(const ABuffer: ptr; const ACount: uint64; const AFlags: uint32): int64;
  external "c";

// glibc: a clock read, the calling thread asleep (ARemaining: what is left when a signal woke it)
public routine clock_gettime(const AClock: int32; var ATime: timespec): int32; external "c";
public routine nanosleep(const ATime: ptr to const timespec; const ARemaining: ptr to timespec): int32;
  external "c";

// glibc: bytes read from / written to a descriptor (read: 0 at its end; -1 on an error).
// read / write / open / close / dup2 / fcntl bind glibc's own __read / __write / __open /
// __close / __dup2 / __fcntl, never the plain names System.HookIO.Linux64 hooks: Adam's std
// works on the real file system on every target (System.IO.Win64's calls are no hook's either)
public routine read(const AFile: int32; const ABuffer: ptr; const ACount: uint64): int64;
  external "c" name "__read";
public routine write(const AFile: int32; const ABuffer: ptr to const; const ACount: uint64): int64;
  external "c" name "__write";
// glibc: a file opened as a descriptor (AFlags O_*; a mode after it when it creates one), a
// descriptor closed, copied (ATarget itself), asked or changed (F_*; F_DUPFD_CLOEXEC copies
// to the lowest free one)
public routine open(const APath: ptr to const char; const AFlags: int32; ...): int32;
  external "c" name "__open";
public routine close(const AFile: int32): int32; external "c" name "__close";
public routine dup2(const AFile: int32; const ATarget: int32): int32;
  external "c" name "__dup2";
public routine fcntl(const AFile: int32; const ACommand: int32; ...): int32;
  external "c" name "__fcntl";
// glibc: a pipe, its read end AFiles[0] and write end AFiles[1] (AFlags O_CLOEXEC ..)
public routine pipe2(const AFiles: ptr to int32; const AFlags: int32): int32; external "c";
// glibc: true (1) when a descriptor is a terminal
public routine isatty(const AFile: int32): int32; external "c";
// glibc: a terminal's modes read / set, its input received but not read dropped
public routine tcgetattr(const AFile: int32; var ATerm: termios): int32; external "c";
public routine tcsetattr(const AFile: int32; const AWhen: int32; const ATerm: ptr to const termios): int32;
  external "c";
public routine tcflush(const AFile: int32; const AQueue: int32): int32; external "c";
// glibc: a device's control request (the terminal's size: TIOCGWINSZ with a ptr to winsize)
public routine ioctl(const AFile: int32; const ARequest: uint64; ...): int32; external "c";
// glibc: waits up to ATimeout ms (-1: no limit) for an event on the descriptors; how many have one
public routine poll(const AFds: ptr to pollfd; const ACount: uint64; const ATimeout: int32): int32;
  external "c";

// glibc: a pseudo terminal's master side opened (AFlags O_RDWR, O_NOCTTY ..), its slave
// made ready to open, the slave's path (ptsname: glibc's own buffer; ptsname_r: into ABuffer)
public routine posix_openpt(const AFlags: int32): int32; external "c";
public routine grantpt(const AFile: int32): int32; external "c";
public routine unlockpt(const AFile: int32): int32; external "c";
public routine ptsname(const AFile: int32): ptr to char; external "c";
public routine ptsname_r(const AFile: int32; const ABuffer: ptr to char; const ASize: uint64): int32;
  external "c";

// glibc: a signal set emptied / filled (every signal a program may handle)
public routine sigemptyset(var ASet: sigset_t): int32; external "c";
public routine sigfillset(var ASet: sigset_t): int32; external "c";

// glibc: a program started as a new process (APath named in full, AArgv and AEnvp
// NULL-ended); its id in APid; 0 when it started, else the error number
public routine posix_spawn(var APid: int32; const APath: ptr to const char;
  const AActions: ptr to const posix_spawn_file_actions_t; const AAttributes: ptr to const posix_spawnattr_t;
  const AArgv: ptr to ptr to char; const AEnvp: ptr to ptr to char): int32; external "c";
// glibc: a start's file actions made / released, and one added: a descriptor copied to
// ATarget, a file opened as ATarget, a descriptor closed, the working folder changed (2.29)
public routine posix_spawn_file_actions_init(var AActions: posix_spawn_file_actions_t): int32;
  external "c";
public routine posix_spawn_file_actions_destroy(var AActions: posix_spawn_file_actions_t): int32;
  external "c";
public routine posix_spawn_file_actions_adddup2(var AActions: posix_spawn_file_actions_t;
  const AFile: int32; const ATarget: int32): int32; external "c";
public routine posix_spawn_file_actions_addopen(var AActions: posix_spawn_file_actions_t;
  const ATarget: int32; const APath: ptr to const char; const AFlags: int32; const AMode: uint32): int32;
  external "c";
public routine posix_spawn_file_actions_addclose(var AActions: posix_spawn_file_actions_t;
  const AFile: int32): int32; external "c";
public routine posix_spawn_file_actions_addchdir_np(var AActions: posix_spawn_file_actions_t;
  const APath: ptr to const char): int32; external "c";
// glibc: a start's attributes made / released, its flags (POSIX_SPAWN_*), its signal mask
// and the signals it puts back to their default action
public routine posix_spawnattr_init(var AAttributes: posix_spawnattr_t): int32; external "c";
public routine posix_spawnattr_destroy(var AAttributes: posix_spawnattr_t): int32; external "c";
public routine posix_spawnattr_setflags(var AAttributes: posix_spawnattr_t; const AFlags: int16): int32;
  external "c";
public routine posix_spawnattr_setsigmask(var AAttributes: posix_spawnattr_t;
  const AMask: ptr to const sigset_t): int32; external "c";
public routine posix_spawnattr_setsigdefault(var AAttributes: posix_spawnattr_t;
  const ADefault: ptr to const sigset_t): int32; external "c";
// glibc: waits for the child APid to change state (AOptions WNOHANG: not at all), its status
// into AStatus; its id, 0 (WNOHANG, still running) or -1
public routine waitpid(const APid: int32; var AStatus: int32; const AOptions: int32): int32;
  external "c";

end.
