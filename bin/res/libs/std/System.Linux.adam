  System.Linux.adam - glibc's POSIX declarations for Adam's x86_64-linux-gnu
  units (the SDK block, AD.5a): each name, value and layout as glibc's x86_64
  headers spell it, declared once here and imported wherever a std platform
  unit needs it (System.IO.Linux64, System.Console.Linux64,
  System.Process.Linux64, System.HookIO.Linux64). Declarations only, no Adam routine: the jobs
  over them are the platform units'.

  Bound to glibc's libc.so.6 (`external "c"`) at Adam's glibc floor 2.29
  (research PLAN-LINUX64 kb_glibc_floor.md): the stat family is glibc's
  __xstat (stat itself is a symbol only from 2.33), getrandom is 2.25.
  Fields glibc spells with '__' (struct stat's __pad0, __glibc_reserved) are
  pad0 / reserved: '__' names are the compiler's.
*******************************************************************************/

module unit System.Linux;

public type
  /// Linux's `timespec`: struct timespec (time.h): seconds and nanoseconds
  timespec = record
    /// Linux's `timespec.tv_sec`.
    tv_sec: int64;
    /// Linux's `timespec.tv_nsec`.
    tv_nsec: int64;
  end;

  /// Linux's `itimerspec`: struct itimerspec (time.h): a timer's period (zero: once) and its first expiry
  itimerspec = record
    /// Linux's `itimerspec.it_interval`.
    it_interval: timespec;
    /// Linux's `itimerspec.it_value`.
    it_value: timespec;
  end;

  /// Linux's `sigevent`: struct sigevent (x86_64, 64 bytes; bits/types/sigevent_t.h) as SIGEV_THREAD fills it:
  /// the value (union sigval, its sival_ptr) passed to sigev_notify_function, run on a thread
  /// glibc starts itself (its attributes, a pthread_attr_t or nil); the union's other members
  /// (_tid) and its padding are pad0
  sigevent = record
    /// Linux's `sigevent.sigev_value`.
    sigev_value: ptr;
    /// Linux's `sigevent.sigev_signo`.
    sigev_signo: int32;
    /// Linux's `sigevent.sigev_notify`.
    sigev_notify: int32;
    /// Linux's `sigevent.sigev_notify_function`.
    sigev_notify_function: func(AValue: ptr);
    /// Linux's `sigevent.sigev_notify_attributes`.
    sigev_notify_attributes: ptr;
    /// Linux's `sigevent.pad0`.
    pad0: array[0..7] of int32;
  end;

  /// Linux's `stat`: struct stat (x86_64, 144 bytes; bits/struct_stat.h)
  stat = record
    /// Linux's `stat.st_dev`.
    st_dev: uint64;
    /// Linux's `stat.st_ino`.
    st_ino: uint64;
    /// Linux's `stat.st_nlink`.
    st_nlink: uint64;
    /// Linux's `stat.st_mode`.
    st_mode: uint32;
    /// Linux's `stat.st_uid`.
    st_uid: uint32;
    /// Linux's `stat.st_gid`.
    st_gid: uint32;
    /// Linux's `stat.pad0`.
    pad0: int32;
    /// Linux's `stat.st_rdev`.
    st_rdev: uint64;
    /// Linux's `stat.st_size`.
    st_size: int64;
    /// Linux's `stat.st_blksize`.
    st_blksize: int64;
    /// Linux's `stat.st_blocks`.
    st_blocks: int64;
    /// Linux's `stat.st_atim`.
    st_atim: timespec;
    /// Linux's `stat.st_mtim`.
    st_mtim: timespec;
    /// Linux's `stat.st_ctim`.
    st_ctim: timespec;
    /// Linux's `stat.reserved`.
    reserved: array[0..2] of int64;
  end;

  /// Linux's `termios`: struct termios (x86_64, 60 bytes; bits/termios-struct.h): the four mode words, the line
  /// discipline, the NCCS control characters, the two speeds
  termios = record
    /// Linux's `termios.c_iflag`.
    c_iflag: uint32;
    /// Linux's `termios.c_oflag`.
    c_oflag: uint32;
    /// Linux's `termios.c_cflag`.
    c_cflag: uint32;
    /// Linux's `termios.c_lflag`.
    c_lflag: uint32;
    /// Linux's `termios.c_line`.
    c_line: uint8;
    /// Linux's `termios.c_cc`.
    c_cc: array[0..31] of uint8;
    /// Linux's `termios.c_ispeed`.
    c_ispeed: uint32;
    /// Linux's `termios.c_ospeed`.
    c_ospeed: uint32;
  end;

  /// Linux's `winsize`: struct winsize (sys/ioctl.h, bits/ioctl-types.h): a terminal's size in characters and pixels
  winsize = record
    /// Linux's `winsize.ws_row`.
    ws_row: uint16;
    /// Linux's `winsize.ws_col`.
    ws_col: uint16;
    /// Linux's `winsize.ws_xpixel`.
    ws_xpixel: uint16;
    /// Linux's `winsize.ws_ypixel`.
    ws_ypixel: uint16;
  end;

  /// Linux's `pollfd`: struct pollfd (sys/poll.h): one descriptor, the events asked for, the events seen
  pollfd = record
    /// Linux's `pollfd.fd`.
    fd: int32;
    /// Linux's `pollfd.events`.
    events: int16;
    /// Linux's `pollfd.revents`.
    revents: int16;
  end;

  /// Linux's `sigset_t` (x86_64, 128 bytes; bits/types/__sigset_t.h): one bit per signal
  sigset_t = record
    /// Linux's `sigset_t.val`.
    val: array[0..15] of uint64;
  end;

  /// Linux's `sched_param`: struct sched_param (bits/types/struct_sched_param.h): a scheduling priority
  sched_param = record
    /// Linux's `sched_param.sched_priority`.
    sched_priority: int32;
  end;

  /// Linux's `posix_spawn_file_actions_t` (x86_64, 80 bytes; spawn.h): what a started program's
  /// descriptors are made, in order; filled by the posix_spawn_file_actions_* calls only
  posix_spawn_file_actions_t = record
    /// Linux's `posix_spawn_file_actions_t.allocated`.
    allocated: int32;
    /// Linux's `posix_spawn_file_actions_t.used`.
    used: int32;
    /// Linux's `posix_spawn_file_actions_t.actions`.
    actions: ptr;
    /// Linux's `posix_spawn_file_actions_t.pad`.
    pad: array[0..15] of int32;
  end;

  /// Linux's `posix_spawnattr_t` (x86_64, 336 bytes; spawn.h): a start's flags, process group, signal
  /// defaults and mask, scheduling; filled by the posix_spawnattr_* calls only
  posix_spawnattr_t = record
    /// Linux's `posix_spawnattr_t.flags`.
    flags: int16;
    /// Linux's `posix_spawnattr_t.pgrp`.
    pgrp: int32;
    /// Linux's `posix_spawnattr_t.sd`.
    sd: sigset_t;
    /// Linux's `posix_spawnattr_t.ss`.
    ss: sigset_t;
    /// Linux's `posix_spawnattr_t.sp`.
    sp: sched_param;
    /// Linux's `posix_spawnattr_t.policy`.
    policy: int32;
    /// Linux's `posix_spawnattr_t.pad`.
    pad: array[0..15] of int32;
  end;

public const
  /// Linux's `_STAT_VER`: sys/stat.h: the stat version x86_64's __xstat takes (_STAT_VER_LINUX); st_mode's file type
  /// bits and its kinds
  _STAT_VER: int32 = 1;
  /// Linux's `S_IFMT`: sys/stat.h: the stat version x86_64's __xstat takes (_STAT_VER_LINUX); st_mode's file type
  /// bits and its kinds
  S_IFMT: uint32 = 0xF000;
  /// Linux's `S_IFDIR`: sys/stat.h: the stat version x86_64's __xstat takes (_STAT_VER_LINUX); st_mode's file type
  /// bits and its kinds
  S_IFDIR: uint32 = 0x4000;
  /// Linux's `S_IFREG`: sys/stat.h: the stat version x86_64's __xstat takes (_STAT_VER_LINUX); st_mode's file type
  /// bits and its kinds
  S_IFREG: uint32 = 0x8000;
  /// Linux's `S_IFLNK`: sys/stat.h: the stat version x86_64's __xstat takes (_STAT_VER_LINUX); st_mode's file type
  /// bits and its kinds
  S_IFLNK: uint32 = 0xA000;
  /// Linux's `S_IFIFO`: sys/stat.h: the stat version x86_64's __xstat takes (_STAT_VER_LINUX); st_mode's file type
  /// bits and its kinds
  S_IFIFO: uint32 = 0x1000;
  /// Linux's `S_IRUSR`: sys/stat.h: st_mode's permission bits (the owner's read and write, the group's, others')
  S_IRUSR: uint32 = 0x100;
  /// Linux's `S_IWUSR`: sys/stat.h: st_mode's permission bits (the owner's read and write, the group's, others')
  S_IWUSR: uint32 = 0x80;
  /// Linux's `S_IRGRP`: sys/stat.h: st_mode's permission bits (the owner's read and write, the group's, others')
  S_IRGRP: uint32 = 0x20;
  /// Linux's `S_IWGRP`: sys/stat.h: st_mode's permission bits (the owner's read and write, the group's, others')
  S_IWGRP: uint32 = 0x10;
  /// Linux's `S_IROTH`: sys/stat.h: st_mode's permission bits (the owner's read and write, the group's, others')
  S_IROTH: uint32 = 0x4;
  /// Linux's `S_IWOTH`: sys/stat.h: st_mode's permission bits (the owner's read and write, the group's, others')
  S_IWOTH: uint32 = 0x2;
  /// Linux's `S_IXUSR`: sys/stat.h: st_mode's execute bits (the owner's, the group's, others') and every
  /// permission bit (set-id and sticky included)
  S_IXUSR: uint32 = 0x40;
  /// Linux's `S_IXGRP`: sys/stat.h: st_mode's execute bits (the owner's, the group's, others') and every
  /// permission bit (set-id and sticky included)
  S_IXGRP: uint32 = 0x8;
  /// Linux's `S_IXOTH`: sys/stat.h: st_mode's execute bits (the owner's, the group's, others') and every
  /// permission bit (set-id and sticky included)
  S_IXOTH: uint32 = 0x1;
  /// Linux's `ALLPERMS`: sys/stat.h: st_mode's execute bits (the owner's, the group's, others') and every
  /// permission bit (set-id and sticky included)
  ALLPERMS: uint32 = 0xFFF;
  /// Linux's `O_ACCMODE`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_ACCMODE: int32 = 3;
  /// Linux's `O_RDONLY`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_RDONLY: int32 = 0;
  /// Linux's `O_WRONLY`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_WRONLY: int32 = 1;
  /// Linux's `O_RDWR`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_RDWR: int32 = 2;
  /// Linux's `O_CREAT`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_CREAT: int32 = 0x40;
  /// Linux's `O_EXCL`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_EXCL: int32 = 0x80;
  /// Linux's `O_NOCTTY`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_NOCTTY: int32 = 0x100;
  /// Linux's `O_TRUNC`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_TRUNC: int32 = 0x200;
  /// Linux's `O_APPEND`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_APPEND: int32 = 0x400;
  /// Linux's `O_DIRECTORY`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_DIRECTORY: int32 = 0x10000;
  /// Linux's `O_CLOEXEC`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_CLOEXEC: int32 = 0x80000;
  /// Linux's `O_TMPFILE`: fcntl.h: open's access modes (their mask; read only, write only, read and write) and its
  /// flags (made when missing, refused when there, never as the controlling terminal, emptied,
  /// every write at the end, a folder only, closed across an exec, an unnamed file)
  O_TMPFILE: int32 = 0x410000;
  /// Linux's `F_DUPFD`: fcntl.h: fcntl's requests: a copy of a descriptor at or above its argument (closed across
  /// an exec: F_DUPFD_CLOEXEC), the status flags read and set
  F_DUPFD: int32 = 0;
  /// Linux's `F_GETFL`: fcntl.h: fcntl's requests: a copy of a descriptor at or above its argument (closed across
  /// an exec: F_DUPFD_CLOEXEC), the status flags read and set
  F_GETFL: int32 = 3;
  /// Linux's `F_SETFL`: fcntl.h: fcntl's requests: a copy of a descriptor at or above its argument (closed across
  /// an exec: F_DUPFD_CLOEXEC), the status flags read and set
  F_SETFL: int32 = 4;
  /// Linux's `F_DUPFD_CLOEXEC`: fcntl.h: fcntl's requests: a copy of a descriptor at or above its argument (closed across
  /// an exec: F_DUPFD_CLOEXEC), the status flags read and set
  F_DUPFD_CLOEXEC: int32 = 1030;
  /// Linux's `F_OK`: unistd.h: access's modes (there, executable, writable, readable)
  F_OK: int32 = 0;
  /// Linux's `X_OK`: unistd.h: access's modes (there, executable, writable, readable)
  X_OK: int32 = 1;
  /// Linux's `W_OK`: unistd.h: access's modes (there, executable, writable, readable)
  W_OK: int32 = 2;
  /// Linux's `R_OK`: unistd.h: access's modes (there, executable, writable, readable)
  R_OK: int32 = 4;
  /// Linux's `PROT_WRITE`: sys/mman.h: a mapping's write right, its sharing (shared, private), one of no file, and
  /// mmap's failure (MAP_FAILED, (void *) -1)
  PROT_WRITE: int32 = 2;
  /// Linux's `MAP_SHARED`: sys/mman.h: a mapping's write right, its sharing (shared, private), one of no file, and
  /// mmap's failure (MAP_FAILED, (void *) -1)
  MAP_SHARED: int32 = 1;
  /// Linux's `MAP_PRIVATE`: sys/mman.h: a mapping's write right, its sharing (shared, private), one of no file, and
  /// mmap's failure (MAP_FAILED, (void *) -1)
  MAP_PRIVATE: int32 = 2;
  /// Linux's `MAP_ANONYMOUS`: sys/mman.h: a mapping's write right, its sharing (shared, private), one of no file, and
  /// mmap's failure (MAP_FAILED, (void *) -1)
  MAP_ANONYMOUS: int32 = 0x20;
  /// Linux's `MAP_FAILED`: sys/mman.h: a mapping's write right, its sharing (shared, private), one of no file, and
  /// mmap's failure (MAP_FAILED, (void *) -1)
  MAP_FAILED: uint64 = 18446744073709551615u;
  /// Linux's `SSIZE_MAX`: limits.h (bits/posix1_lim.h, x86_64): the largest ssize_t, the most one read(2) moves
  SSIZE_MAX: int64 = 9223372036854775807;
  /// Linux's `_IOFBF`: stdio.h: setvbuf's modes (full, line, no buffering) and setbuf's buffer size
  _IOFBF: int32 = 0;
  /// Linux's `_IOLBF`: stdio.h: setvbuf's modes (full, line, no buffering) and setbuf's buffer size
  _IOLBF: int32 = 1;
  /// Linux's `_IONBF`: stdio.h: setvbuf's modes (full, line, no buffering) and setbuf's buffer size
  _IONBF: int32 = 2;
  /// Linux's `BUFSIZ`: stdio.h: setvbuf's modes (full, line, no buffering) and setbuf's buffer size
  BUFSIZ: uint64 = 8192u;
  /// Linux's `CODESET`: langinfo.h: nl_langinfo's item for the locale's character set name
  CODESET: int32 = 14;
  /// Linux's `P_tmpdir`: stdio.h: the folder for temporary files when $TMPDIR names none
  P_tmpdir: string = "/tmp";
  /// Linux's `CLOCK_MONOTONIC`: time.h: the clock from a fixed point, never going back
  CLOCK_MONOTONIC: int32 = 1;
  /// Linux's `SIGEV_THREAD`: signal.h: a sigevent's notification on a thread glibc starts (sigev_notify_function)
  SIGEV_THREAD: int32 = 2;
  /// Linux's `SYS_chdir`: sys/syscall.h (x86_64): the kernel's chdir (System.IO's SetCurrentDir: no hook between)
  SYS_chdir: int64 = 80;
  /// Linux's `EINTR`: errno.h (x86_64 glibc; System.Runtime's CErrno reads errno): a call a signal broke off,
  /// an output full (iconv's), nothing there yet, no such device, not a folder, too many open
  /// files, a seek on a pipe; a rename across file systems
  EINTR: int32 = 4;
  /// Linux's `EXDEV`: errno.h (x86_64 glibc; System.Runtime's CErrno reads errno): a call a signal broke off,
  /// an output full (iconv's), nothing there yet, no such device, not a folder, too many open
  /// files, a seek on a pipe; a rename across file systems
  EXDEV: int32 = 18;
  /// Linux's `E2BIG`: errno.h (x86_64 glibc; System.Runtime's CErrno reads errno): a call a signal broke off,
  /// an output full (iconv's), nothing there yet, no such device, not a folder, too many open
  /// files, a seek on a pipe; a rename across file systems
  E2BIG: int32 = 7;
  /// Linux's `EAGAIN`: errno.h (x86_64 glibc; System.Runtime's CErrno reads errno): a call a signal broke off,
  /// an output full (iconv's), nothing there yet, no such device, not a folder, too many open
  /// files, a seek on a pipe; a rename across file systems
  EAGAIN: int32 = 11;
  /// Linux's `ENODEV`: errno.h (x86_64 glibc; System.Runtime's CErrno reads errno): a call a signal broke off,
  /// an output full (iconv's), nothing there yet, no such device, not a folder, too many open
  /// files, a seek on a pipe; a rename across file systems
  ENODEV: int32 = 19;
  /// Linux's `ENOTDIR`: errno.h (x86_64 glibc; System.Runtime's CErrno reads errno): a call a signal broke off,
  /// an output full (iconv's), nothing there yet, no such device, not a folder, too many open
  /// files, a seek on a pipe; a rename across file systems
  ENOTDIR: int32 = 20;
  /// Linux's `EMFILE`: errno.h (x86_64 glibc; System.Runtime's CErrno reads errno): a call a signal broke off,
  /// an output full (iconv's), nothing there yet, no such device, not a folder, too many open
  /// files, a seek on a pipe; a rename across file systems
  EMFILE: int32 = 24;
  /// Linux's `ESPIPE`: errno.h (x86_64 glibc; System.Runtime's CErrno reads errno): a call a signal broke off,
  /// an output full (iconv's), nothing there yet, no such device, not a folder, too many open
  /// files, a seek on a pipe; a rename across file systems
  ESPIPE: int32 = 29;
  /// Linux's `STDIN_FILENO`: unistd.h: the standard descriptors
  STDIN_FILENO: int32 = 0;
  /// Linux's `STDOUT_FILENO`: unistd.h: the standard descriptors
  STDOUT_FILENO: int32 = 1;
  /// Linux's `STDERR_FILENO`: unistd.h: the standard descriptors
  STDERR_FILENO: int32 = 2;
  /// Linux's `WNOHANG`: sys/wait.h: waitpid returns at once when no child has changed state
  WNOHANG: int32 = 1;
  /// Linux's `POSIX_SPAWN_SETSIGDEF`: spawn.h: posix_spawnattr_setflags' flags (the signal defaults and mask set; a new session)
  POSIX_SPAWN_SETSIGDEF: int16 = 0x4;
  /// Linux's `POSIX_SPAWN_SETSIGMASK`: spawn.h: posix_spawnattr_setflags' flags (the signal defaults and mask set; a new session)
  POSIX_SPAWN_SETSIGMASK: int16 = 0x8;
  /// Linux's `POSIX_SPAWN_SETSID`: spawn.h: posix_spawnattr_setflags' flags (the signal defaults and mask set; a new session)
  POSIX_SPAWN_SETSID: int16 = 0x80;
  /// Linux's `TCSANOW`: termios.h (bits/termios-*.h, x86_64): tcsetattr's when (TCSANOW: at once), tcflush's queue
  /// (TCIFLUSH: the input received, not yet read), c_cc's indexes (VTIME, VMIN; NCCS of them)
  TCSANOW: int32 = 0;
  /// Linux's `TCIFLUSH`: termios.h (bits/termios-*.h, x86_64): tcsetattr's when (TCSANOW: at once), tcflush's queue
  /// (TCIFLUSH: the input received, not yet read), c_cc's indexes (VTIME, VMIN; NCCS of them)
  TCIFLUSH: int32 = 0;
  /// Linux's `NCCS`: termios.h (bits/termios-*.h, x86_64): tcsetattr's when (TCSANOW: at once), tcflush's queue
  /// (TCIFLUSH: the input received, not yet read), c_cc's indexes (VTIME, VMIN; NCCS of them)
  NCCS: int32 = 32;
  /// Linux's `VTIME`: termios.h (bits/termios-*.h, x86_64): tcsetattr's when (TCSANOW: at once), tcflush's queue
  /// (TCIFLUSH: the input received, not yet read), c_cc's indexes (VTIME, VMIN; NCCS of them)
  VTIME: int32 = 5;
  /// Linux's `VMIN`: termios.h (bits/termios-*.h, x86_64): tcsetattr's when (TCSANOW: at once), tcflush's queue
  /// (TCIFLUSH: the input received, not yet read), c_cc's indexes (VTIME, VMIN; NCCS of them)
  VMIN: int32 = 6;
  /// Linux's `ICRNL`: termios.h: c_iflag's CR read as NL and XON / XOFF flow control; c_lflag's signal keys,
  /// line editing (canonical mode), echo and the implementation's extra keys (Ctrl+V)
  ICRNL: uint32 = 0x100;
  /// Linux's `IXON`: termios.h: c_iflag's CR read as NL and XON / XOFF flow control; c_lflag's signal keys,
  /// line editing (canonical mode), echo and the implementation's extra keys (Ctrl+V)
  IXON: uint32 = 0x400;
  /// Linux's `ISIG`: termios.h: c_iflag's CR read as NL and XON / XOFF flow control; c_lflag's signal keys,
  /// line editing (canonical mode), echo and the implementation's extra keys (Ctrl+V)
  ISIG: uint32 = 0x1;
  /// Linux's `ICANON`: termios.h: c_iflag's CR read as NL and XON / XOFF flow control; c_lflag's signal keys,
  /// line editing (canonical mode), echo and the implementation's extra keys (Ctrl+V)
  ICANON: uint32 = 0x2;
  /// Linux's `ECHO`: termios.h: c_iflag's CR read as NL and XON / XOFF flow control; c_lflag's signal keys,
  /// line editing (canonical mode), echo and the implementation's extra keys (Ctrl+V)
  ECHO: uint32 = 0x8;
  /// Linux's `IEXTEN`: termios.h: c_iflag's CR read as NL and XON / XOFF flow control; c_lflag's signal keys,
  /// line editing (canonical mode), echo and the implementation's extra keys (Ctrl+V)
  IEXTEN: uint32 = 0x8000;
  /// Linux's `TIOCGWINSZ`: asm-generic/ioctls.h: a terminal's size read / set (struct winsize)
  TIOCGWINSZ: uint64 = 0x5413;
  /// Linux's `TIOCSWINSZ`: asm-generic/ioctls.h: a terminal's size read / set (struct winsize)
  TIOCSWINSZ: uint64 = 0x5414;
  /// Linux's `POLLIN`: poll.h: data to read
  POLLIN: int16 = 0x1;

