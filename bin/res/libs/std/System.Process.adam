-------------------------------------------------------------------------------
  System.Process.adam - running other programs, the same on every target:
  `import System.Process;` and no OS is named (StdApp.Utils' process set).

  RunProcess: the output captured whole. RunAttached: on this program's own
  stdin / stdout / stderr. RunPE: the program started shown, waited for or
  left running; or captured, its output handed to a ProcessOutput as it
  comes: ProcessCapture.Pipes gives it line by line (stdout and stderr share
  one pipe, so the order written is kept; CR, LF and CR LF each end a line,
  empty lines kept, a line that is not UTF-8 read as the OS's console code
  page), ProcessCapture.Terminal through a pseudo console as chunks of
  terminal text (VT sequences included, whole UTF-8 characters only: a
  character a read cut waits for the next). RunELF: a Linux ELF the same
  way, captured or attached (on win64 through WSL; on linux64 natively);
  ELFCommand: the command that starts one, for a caller's own launch. A PE runs only where the
  target runs one: on x86_64-linux-gnu both RunPE forms are false at once
  (nothing started, exit code 0); RunProcess / RunAttached run the host's
  own programs on every target. Text this program wrote is flushed before
  RunAttached starts, so its order on a shared stdout is kept.

  A ProcessHost is the other end of a captured run: StdInput, read before
  the start, is a handle the program reads as its standard input (its end
  is the program's end of input, as `prog < file`; 0 = none: NUL, or for a
  terminal run the keys the host types); a terminal run also takes its
  InitialSize and gets Start (with the run's ProcessTerminal, to type keys
  and resize) before the program starts and Stop once it ended. No host =
  NUL input, the size of this program's console (else 120 x 30).

  Target-neutral (PROJECT AT.3): the OS work is the one platform unit the
  target triple picks (System.Process.Win64 for x86_64-windows-gnu,
  System.Process.Linux64 for x86_64-linux-gnu), its ProcessPlatform*
  routines and its ProcessPlatformRun.
*******************************************************************************/

module unit System.Process;

import System.SysUtils
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.Process.Win64
@endif
@ifdef TARGET_X86_64_LINUX_GNU
  , System.Process.Linux64
@endif
  ;

public type
  /// Where a captured run's output goes: each line (ProcessCapture.Pipes) or chunk
  /// (ProcessCapture.Terminal), in order, as it comes.
  /// @example `RunPE(LExe, LArgs, LDir, LCode, LSink, ProcessCapture.Pipes, nil);`
  ProcessOutput = interface
    /// One line (its line end left out) or one chunk of the program's output.
    /// @param AText the line or chunk, UTF-8 (a chunk holds whole characters only)
    method Output(const AText: string);
  end;

  /// A running terminal run's console, handed to its ProcessHost at Start.
  ProcessTerminal = interface
    /// Types text into the program, as keys pressed.
    /// @param AText the keys, UTF-8
    /// @returns false when the program is gone
    method WriteKeys(const AText: string): bool;
    /// Gives the terminal a new size; each side is held to 1 .. 32767.
    /// @param ACols the columns
    /// @param ARows the lines
    /// @returns false when the size is refused
    method Resize(const ACols: int32; const ARows: int32): bool;
  end;

  /// The other end of a captured run: its standard input and, for a terminal run, its size
  /// and the keys typed into it. No host (nil) means no input and the size of this program's
  /// console (else 120 x 30).
  ProcessHost = interface
    /// The size a terminal run starts with.
    /// @param ACols receives the columns
    /// @param ARows receives the lines
    /// @returns false to take this program's console size
    method InitialSize(var ACols: int32; var ARows: int32): bool;
    /// A handle the program reads as its standard input (its end of input, as `prog < file`),
    /// read before the start.
    /// @returns the handle; 0 = none (no input, or for a terminal run the keys typed through Start)
    method StdInput(): uint64;
    /// A terminal run is about to start: keys and sizes go to ATerminal from now until Stop.
    /// @param ATerminal the run's console
    /// @returns false when the host cannot serve: the program is then not started
    method Start(const ATerminal: ref ProcessTerminal): bool;
    /// The program ended (or never started after Start): no more keys or sizes.
    method Stop();
  end;

  /// How a captured run (RunPE's / RunELF's capture forms) reads its program.
  ProcessCapture = choices(
    Pipes,      /// stdout and stderr through one pipe, handed over line by line in the order written.
    Terminal);  /// A pseudo console, handed over as chunks of terminal text (VT sequences included).

type
  // A terminal run's ProcessTerminal: its platform run's keys and size
  RunTerminal = object implements ProcessTerminal
    hidden FRun: ref ProcessPlatformRun;

    init(const ARun: ref ProcessPlatformRun);
    begin
      self.FRun := ARun;
    end;

    virtual method WriteKeys(const AText: string): bool;
    begin
      return self.FRun.WriteKeys(AText);
    end;

    virtual method Resize(const ACols: int32; const ARows: int32): bool;
    begin
      return self.FRun.Resize(ACols, ARows);
    end;
  end;

/// Runs a program and captures its output whole.
/// @param AExe the program
/// @param AArgs its arguments
/// @param AWorkDir the folder it runs in
/// @param AOutput receives everything it wrote
/// @param AExitCode receives its exit code
/// @returns false when it cannot start
/// @example `if RunProcess("git", ["--version"], ".", LText, LCode) then println("{}", LText); end;`
public func cpplink RunProcess(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AOutput: string; var AExitCode: uint32): bool;
begin
  return ProcessPlatformRunProcess(AExe, AArgs, AWorkDir, AOutput, AExitCode);
end;

/// Runs a program on this program's own console (stdin, stdout, stderr) and waits for it.
/// What this program wrote is flushed first, so a shared stdout keeps the order written.
/// @param AExe the program
/// @param AArgs its arguments
/// @param AWorkDir the folder it runs in
/// @param AExitCode receives its exit code
/// @returns false when it cannot start
public func cpplink RunAttached(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32): bool;
begin
  FlushOutput();
  return ProcessPlatformRunAttached(AExe, AArgs, AWorkDir, AExitCode);
end;

/// Starts a Windows program (PE) shown, named in full (no `PATH` search), inheriting no handle
/// of this program; waits for it or leaves it running (it may outlive this program).
/// On a target that runs no PE (x86_64-linux-gnu) nothing starts.
/// @param AExe the program, its full path
/// @param AArgs its arguments
/// @param AWorkDir the folder it runs in
/// @param AWait true to wait for it to end
/// @param AExitCode receives its exit code when waited for, else 0
/// @returns false when it cannot start or its exit code cannot be read, and on a target that
///   runs no PE
public func cpplink RunPE(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  const AWait: bool; var AExitCode: uint32): bool;
begin
  return ProcessPlatformRunPE(AExe, AArgs, AWorkDir, AWait, AExitCode);
end;

// The lines ABytes ends, each without its end, handed to AOutput (CR, LF and CR LF each end
// one: the LF of a pair ends nothing, so AAfterCR carries a CR at the end of one read to the
// next); what is left after the last end stays in ALine
func DoSplitLines(const ABytes: string; var ALine: string; var AAfterCR: bool;
  const AOutput: ref ProcessOutput);
var
  LI: int64;
  LStart: int64;
  LChar: char;
begin
  LStart := 0;
  for LI := 0 to len(ABytes) - 1 do
    LChar := ABytes[LI];
    if (LChar = '\r') or (LChar = '\n') then
      if (LChar = '\r') or (not AAfterCR) then
        // A line ends here: the text kept from earlier reads, then this read's run
        ALine := ALine + Substring(ABytes, LStart, LI - LStart);
        AOutput.Output(ProcessPlatformDecodeLine(ALine));
        ALine := "";
      end;
      AAfterCR := LChar = '\r';
      LStart := LI + 1;
    else
      AAfterCR := false;
    end;
  end;
  if LStart < len(ABytes) then
    ALine := ALine + Substring(ABytes, LStart, len(ABytes) - LStart);
  end;
end;

// A captured run (RunPE's capture form and RunELF's): AExe (named in full, no PATH search) run
// with AArgs in AWorkDir, its output handed to AOutput as it comes, by ACapture (see the
// header), AHost the other end (nil: none). AExitCode gets its exit code (0 when it never ran).
// False when it cannot start (the host refused, the OS refused) or its exit code cannot be read
func DoRunCaptured(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32; const AOutput: ref ProcessOutput; const ACapture: ProcessCapture;
  const AHost: ref ProcessHost): bool;
var
  LRun: ref ProcessPlatformRun;
  LTerminalRun: bool;
  LCols: int32;
  LRows: int32;
  LStdin: uint64;
  LHostStarted: bool;
  LBytes: string;
  LLine: string;
  LAfterCR: bool;
  LCut: int64;
  LOk: bool;
begin
  AExitCode := 0;
  LTerminalRun := ACapture = ProcessCapture.Terminal;
  LCols := 0;
  LRows := 0;
  LStdin := 0;
  if AHost <> nil then
    LStdin := AHost.StdInput();
    if LTerminalRun and (not AHost.InitialSize(LCols, LRows)) then
      LCols := 0;
      LRows := 0;
    end;
  end;
  LRun := ref ProcessPlatformRun();
  if not LRun.Prepare(LTerminalRun, LCols, LRows, AHost <> nil, LStdin) then
    return false;
  end;
  LHostStarted := false;
  LOk := false;
  guard
    // A terminal run's keys and size come from the host from here (keys typed before the
    // program reads wait in its console's input)
    if LTerminalRun and (AHost <> nil) then
      if not AHost.Start(ref RunTerminal(LRun)) then
        return false;
      end;
      LHostStarted := true;
    end;
    if LRun.Launch(AExe, AArgs, AWorkDir) then
      LBytes := "";
      LLine := "";
      LAfterCR := false;
      while LRun.Next(LBytes) do
        if LTerminalRun then
          // Handed over as it comes (a prompt has no line end), a cut character kept back
          LCut := WholeUTF8Length(LBytes);
          if LCut > 0 then
            AOutput.Output(Substring(LBytes, 0, LCut));
            LBytes := Substring(LBytes, LCut, len(LBytes) - LCut);
          end;
          if LRun.Exited() and LHostStarted then
            AHost.Stop();
            LHostStarted := false;
          end;
        else
          DoSplitLines(LBytes, LLine, LAfterCR, AOutput);
          LBytes := "";
        end;
      end;
      // What is left: a last line with no end (never an empty one), or a character cut at
      // the very end (truncated output: handed over as it is rather than dropped)
      if (len(LLine) > 0) and (not LTerminalRun) then
        AOutput.Output(ProcessPlatformDecodeLine(LLine));
      end;
      if (len(LBytes) > 0) and LTerminalRun then
        AOutput.Output(LBytes);
      end;
      LOk := LRun.ExitCode(AExitCode);
    end;
  finally
    // A run that ended early (it never started, it raised) stops its host here
    if LHostStarted then
      AHost.Stop();
    end;
    LRun.Close();
  end;
  return LOk;
end;

/// Runs a Windows program (PE) with its output captured and handed to AOutput as it comes,
/// through pipes or a pseudo console (ProcessCapture). On a target that runs no PE
/// (x86_64-linux-gnu) nothing starts and the host is never asked.
/// @param AExe the program, its full path
/// @param AArgs its arguments
/// @param AWorkDir the folder it runs in
/// @param AExitCode receives its exit code (0 when it never ran)
/// @param AOutput gets the output, line by line or chunk by chunk
/// @param ACapture pipes or a terminal
/// @param AHost the run's standard input, size and keys; nil for none
/// @returns false when it cannot start or its exit code cannot be read, and on a target that
///   runs no PE
public func cpplink RunPE(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32; const AOutput: ref ProcessOutput; const ACapture: ProcessCapture;
  const AHost: ref ProcessHost): bool;
begin
  AExitCode := 0;
  if not ProcessPlatformCanRunPE() then
    return false;
  end;
  return DoRunCaptured(AExe, AArgs, AWorkDir, AExitCode, AOutput, ACapture, AHost);
end;

/// Runs a Linux ELF program with its output captured, as RunPE's capture form runs one: made
/// executable first, on x86_64-windows-gnu through WSL (pipes join its stderr to its stdout
/// inside Linux, so the order written is kept), on x86_64-linux-gnu natively.
/// @param AELF the ELF file
/// @param AArgs its arguments
/// @param AWorkDir the folder it runs in
/// @param AExitCode receives its exit code (0 when it never ran)
/// @param AOutput gets the output, line by line or chunk by chunk
/// @param ACapture pipes or a terminal
/// @param AHost the run's standard input, size and keys; nil for none
/// @returns false when it cannot start there (no WSL, the execute bits cannot be set, a path
///   WSL cannot name) or its exit code cannot be read
/// @example `RunELF("game", [], ".", LCode, LSink, ProcessCapture.Pipes, nil);`
public func cpplink RunELF(const AELF: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32; const AOutput: ref ProcessOutput; const ACapture: ProcessCapture;
  const AHost: ref ProcessHost): bool;
var
  LExe: string;
  LArgs: StringArray;
begin
  AExitCode := 0;
  if not ProcessPlatformELFCommand(AELF, AArgs, AWorkDir, ACapture = ProcessCapture.Pipes,
    LExe, LArgs) then
    return false;
  end;
  return DoRunCaptured(LExe, LArgs, AWorkDir, AExitCode, AOutput, ACapture, AHost);
end;

/// Runs a Linux ELF program on this program's own console, as RunAttached runs one (what
/// this program wrote is flushed first; its stderr stays its own): made executable first, on
/// x86_64-windows-gnu through WSL, on x86_64-linux-gnu natively.
/// @param AELF the ELF file
/// @param AArgs its arguments
/// @param AWorkDir the folder it runs in
/// @param AExitCode receives its exit code (0 when it never ran)
/// @returns false when it cannot start there (as the capture form's)
public func cpplink RunELF(const AELF: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32): bool;
var
  LExe: string;
  LArgs: StringArray;
begin
  AExitCode := 0;
  FlushOutput();
  if not ProcessPlatformELFCommand(AELF, AArgs, AWorkDir, false, LExe, LArgs) then
    return false;
  end;
  return ProcessPlatformRunAttached(LExe, LArgs, AWorkDir, AExitCode);
end;

/// The program and arguments that start a Linux ELF program on this host, for a caller that
/// launches it itself (a debug adapter's own run): on x86_64-windows-gnu WSL's launcher with
/// the ELF as its argument, on x86_64-linux-gnu the ELF itself. The ELF is made executable first.
/// @param AELF the ELF file
/// @param AArgs its arguments
/// @param AWorkDir the folder it runs in
/// @param AJoinErrors true to join its stderr to its stdout (a pipe read as one stream)
/// @param AExe receives the program to start
/// @param AArgsOut receives that program's arguments
/// @returns false when it cannot be started there (as RunELF's)
public func cpplink ELFCommand(const AELF: string; const AArgs: StringArray; const AWorkDir: string;
  const AJoinErrors: bool; var AExe: string; var AArgsOut: StringArray): bool;
begin
  return ProcessPlatformELFCommand(AELF, AArgs, AWorkDir, AJoinErrors, AExe, AArgsOut);
end;

/// The path a Linux ELF program started on this host (RunELF, ELFCommand) sees for one of
/// this program's files, for a path handed to it as an argument.
/// @param APath the path, as this program names it
/// @returns on x86_64-windows-gnu WSL's name of its resolved drive path (`C:\x` is
///   `/mnt/c/x`; "" for one WSL cannot name, such as a share); on x86_64-linux-gnu the path
///   resolved
/// @example `RunELF(LGame, [ELFPath("level1.map")], ".", LCode);`
public func cpplink ELFPath(const APath: string): string;
begin
  return ProcessPlatformELFPath(APath);
end;

/// Whether this host can run a Linux ELF program (RunELF).
/// @returns on x86_64-windows-gnu true when WSL is there with a distribution that starts
///   (asked once, the answer kept); on x86_64-linux-gnu always true
public func cpplink CanRunELF(): bool;
begin
  return ProcessPlatformCanRunELF();
end;


// True when AURL starts with a URI scheme and its ':' (RFC 3986 sec 3.1: a letter, then
// letters, digits, '+', '-' or '.'), at least two characters long so a drive letter (C:\x) is
// never one: OpenURL never runs a program by its path
func DoHasScheme(const AURL: string): bool;
var
  LChar: char;
  LI: int64;
begin
  for LI := 0 to len(AURL) - 1 do
    LChar := AURL[LI];
    if LChar = ':' then
      return LI >= 2;
    end;
    if not (((LChar >= 'a') and (LChar <= 'z')) or ((LChar >= 'A') and (LChar <= 'Z'))) then
      if (LI = 0) or not (((LChar >= '0') and (LChar <= '9')) or (LChar = '+') or
        (LChar = '-') or (LChar = '.')) then
        return false;
      end;
    end;
  end;
  return false;
end;

/// Opens `AURL` with the user's own handler for its scheme (a browser for `https:`, the mail
/// program for `mailto:` ..), not waiting for it: x86_64-windows-gnu through the shell's
/// open verb, x86_64-linux-gnu through `xdg-open` found on `PATH`.
/// @param AURL the URL, its scheme first (`https://adamlang.org`); a text with no scheme,
///   such as a bare host or a file path, is refused, so no program is ever run by its path
/// @returns true when the system took it
/// @example `OpenURL("https://adamlang.org");`
public func cpplink OpenURL(const AURL: string): bool;
begin
  if not DoHasScheme(AURL) then
    return false;
  end;
  return ProcessPlatformOpenURL(AURL);
end;

end.
