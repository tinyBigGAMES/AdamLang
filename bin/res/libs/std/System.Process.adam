-------------------------------------------------------------------------------
  System.Process.adam - running other programs, the same on every target:
  `import System.Process;` and no OS is named (StdApp.Utils' process set).

  RunProcess: the output captured whole. RunAttached: on this program's own
  stdin / stdout / stderr. RunPE: the program started shown, waited for or
  left running; or captured, its output handed to a ProcessOutput as it
  comes: ProcessCapture.Pipes gives it line by line (stdout and stderr share
  one pipe, so the order written is kept; CR, LF and CR LF each end a line,
  empty lines kept, a line that is not UTF-8 read as the OS's console code
  page), ProcessCapture.Terminal through a pseudo console as chunks of
  terminal text (VT sequences included, whole UTF-8 characters only: a
  character a read cut waits for the next). RunElf: a Linux ELF the same
  way (on win64 through WSL; on linux64 natively).

  A ProcessHost is the other end of a captured run: StdInput, read before
  the start, is a handle the program reads as its standard input (its end
  is the program's end of input, as `prog < file`; 0 = none: NUL, or for a
  terminal run the keys the host types); a terminal run also takes its
  InitialSize and gets Start (with the run's ProcessTerminal, to type keys
  and resize) before the program starts and Stop once it ended. No host =
  NUL input, the size of this program's console (else 120 x 30).

  Target-neutral (PROJECT AT.3): the OS work is the one platform unit the
  target triple picks (System.Process.Win64 for x86_64-windows-gnu), its
  ProcessPlatform* routines and its ProcessPlatformRun; a linux64 target
  adds System.Process.Linux64 and nothing else changes.
*******************************************************************************/

module unit System.Process;

import System.SysUtils
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.Process.Win64
@endif
  ;

public type
  // Where a captured run's output goes: each line (pipes) or chunk (terminal) in order
  ProcessOutput = interface
    method Output(const AText: string);
  end;

  // A running terminal run's console, handed to its host at Start
  ProcessTerminal = interface
    // AText (UTF-8) typed into the program. False when it is gone
    method WriteKeys(const AText: string): bool;
    // The terminal's new size (each side held to 1..32767). False when refused
    method Resize(const ACols: int32; const ARows: int32): bool;
  end;

  // The other end of a captured run (see the header)
  ProcessHost = interface
    // The size a terminal run starts with; false = this program's console's
    method InitialSize(var ACols: int32; var ARows: int32): bool;
    // A handle the program reads as its standard input; 0 = none
    method StdInput(): uint64;
    // A terminal run is about to start: keys and sizes go to ATerminal from now until Stop.
    // False = the host cannot serve: the program is not started
    method Start(const ATerminal: ref ProcessTerminal): bool;
    // The program ended (or never started after Start): no more keys or sizes
    method Stop();
  end;

  // How a captured run reads its program
  ProcessCapture = choices(Pipes, Terminal);

type
  // A terminal run's ProcessTerminal: its platform run's keys and size
  RunTerminal = object implements ProcessTerminal
    hidden FRun: ref ProcessPlatformRun;

    init(const ARun: ref ProcessPlatformRun);
    begin
      self.FRun := ARun;
    end;

    virtual method WriteKeys(const AText: string): bool;
    begin
      return self.FRun.WriteKeys(AText);
    end;

    virtual method Resize(const ACols: int32; const ARows: int32): bool;
    begin
      return self.FRun.Resize(ACols, ARows);
    end;
  end;

// AExe run with AArgs in AWorkDir, its output captured into AOutput; false when it cannot start
public routine RunProcess(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AOutput: string; var AExitCode: uint32): bool;
begin
  return ProcessPlatformRunProcess(AExe, AArgs, AWorkDir, AOutput, AExitCode);
end;

// AExe run with AArgs in AWorkDir on this program's own console; false when it cannot start
public routine RunAttached(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32): bool;
begin
  return ProcessPlatformRunAttached(AExe, AArgs, AWorkDir, AExitCode);
end;

// StdApp.Utils' RunPE: the program AExe (named in full, no PATH search) run with AArgs in
// AWorkDir, shown, no handle of this program inherited; AWait waits for it, its exit code in
// AExitCode, else it runs on (it may outlive this program, AExitCode 0). False when it cannot
// start or its exit code cannot be read
public routine RunPE(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  const AWait: bool; var AExitCode: uint32): bool;
begin
  return ProcessPlatformRunPE(AExe, AArgs, AWorkDir, AWait, AExitCode);
end;

// The lines ABytes ends, each without its end, handed to AOutput (CR, LF and CR LF each end
// one: the LF of a pair ends nothing, so AAfterCR carries a CR at the end of one read to the
// next); what is left after the last end stays in ALine
routine DoSplitLines(const ABytes: string; var ALine: string; var AAfterCR: bool;
  const AOutput: ref ProcessOutput);
var
  LI: int64;
  LStart: int64;
  LChar: char;
begin
  LStart := 0;
  for LI := 0 to len(ABytes) - 1 do
    LChar := ABytes[LI];
    if (LChar = '\r') or (LChar = '\n') then
      if (LChar = '\r') or (not AAfterCR) then
        // A line ends here: the text kept from earlier reads, then this read's run
        ALine := ALine + Substring(ABytes, LStart, LI - LStart);
        AOutput.Output(ProcessPlatformDecodeLine(ALine));
        ALine := "";
      end;
      AAfterCR := LChar = '\r';
      LStart := LI + 1;
    else
      AAfterCR := false;
    end;
  end;
  if LStart < len(ABytes) then
    ALine := ALine + Substring(ABytes, LStart, len(ABytes) - LStart);
  end;
end;

// StdApp.Utils' RunPE capture form: AExe (named in full, no PATH search) run with AArgs in
// AWorkDir, its output handed to AOutput as it comes, by ACapture (see the header), AHost the
// other end (nil: none). AExitCode gets its exit code (0 when it never ran). False when it
// cannot start (the host refused, the OS refused) or its exit code cannot be read
public routine RunPE(const AExe: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32; const AOutput: ref ProcessOutput; const ACapture: ProcessCapture;
  const AHost: ref ProcessHost): bool;
var
  LRun: ref ProcessPlatformRun;
  LTerminalRun: bool;
  LCols: int32;
  LRows: int32;
  LStdin: uint64;
  LHostStarted: bool;
  LBytes: string;
  LLine: string;
  LAfterCR: bool;
  LCut: int64;
  LOk: bool;
begin
  AExitCode := 0;
  LTerminalRun := ACapture = ProcessCapture.Terminal;
  LCols := 0;
  LRows := 0;
  LStdin := 0;
  if AHost <> nil then
    LStdin := AHost.StdInput();
    if LTerminalRun and (not AHost.InitialSize(LCols, LRows)) then
      LCols := 0;
      LRows := 0;
    end;
  end;
  LRun := ref ProcessPlatformRun();
  if not LRun.Prepare(LTerminalRun, LCols, LRows, AHost <> nil, LStdin) then
    return false;
  end;
  LHostStarted := false;
  LOk := false;
  guard
    // A terminal run's keys and size come from the host from here (keys typed before the
    // program reads wait in its console's input)
    if LTerminalRun and (AHost <> nil) then
      if not AHost.Start(ref RunTerminal(LRun)) then
        return false;
      end;
      LHostStarted := true;
    end;
    if LRun.Launch(AExe, AArgs, AWorkDir) then
      LBytes := "";
      LLine := "";
      LAfterCR := false;
      while LRun.Next(LBytes) do
        if LTerminalRun then
          // Handed over as it comes (a prompt has no line end), a cut character kept back
          LCut := WholeUtf8Length(LBytes);
          if LCut > 0 then
            AOutput.Output(Substring(LBytes, 0, LCut));
            LBytes := Substring(LBytes, LCut, len(LBytes) - LCut);
          end;
          if LRun.Exited() and LHostStarted then
            AHost.Stop();
            LHostStarted := false;
          end;
        else
          DoSplitLines(LBytes, LLine, LAfterCR, AOutput);
          LBytes := "";
        end;
      end;
      // What is left: a last line with no end (never an empty one), or a character cut at
      // the very end (truncated output: handed over as it is rather than dropped)
      if (len(LLine) > 0) and (not LTerminalRun) then
        AOutput.Output(ProcessPlatformDecodeLine(LLine));
      end;
      if (len(LBytes) > 0) and LTerminalRun then
        AOutput.Output(LBytes);
      end;
      LOk := LRun.ExitCode(AExitCode);
    end;
  finally
    // A run that ended early (it never started, it raised) stops its host here
    if LHostStarted then
      AHost.Stop();
    end;
    LRun.Close();
  end;
  return LOk;
end;

// StdApp.Utils' RunElf: the Linux ELF file AElf run with AArgs in AWorkDir as RunPE's capture
// form runs a program (on win64 through WSL, made executable first; pipes join its stderr to
// stdout in Linux, so the order written is kept). False when it cannot be started there (no
// WSL, chmod +x fails, a path WSL cannot name) or as RunPE's
public routine RunElf(const AElf: string; const AArgs: StringArray; const AWorkDir: string;
  var AExitCode: uint32; const AOutput: ref ProcessOutput; const ACapture: ProcessCapture;
  const AHost: ref ProcessHost): bool;
var
  LExe: string;
  LArgs: StringArray;
begin
  AExitCode := 0;
  if not ProcessPlatformElfCommand(AElf, AArgs, AWorkDir, ACapture = ProcessCapture.Pipes,
    LExe, LArgs) then
    return false;
  end;
  return RunPE(LExe, LArgs, AWorkDir, AExitCode, AOutput, ACapture, AHost);
end;

end.
