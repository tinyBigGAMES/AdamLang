  at https://mozilla.org/MPL/2.0/.

  This file is covered by the Adam Runtime Exception
  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.Raven.Raylib.adam - a Raven user interface inside a raylib program
  (PaskalCPP's raven_raylib): raylib keeps the window, the loop, audio and
  the game's drawing; Raven builds and lays out its widgets (System.Raven.C's
  API, XML windows and themes included) and draws them in the raylib frame,
  over the game.

    InitWindow(...) or InitFrameWindow(...);  InitRaven("Game");
    LUi := Rwindow_create("Game", 0, 0, Ruint(R_WINDOW_DEFAULT));  ...widgets...
    each frame: UpdateRaven(LUi); BeginDrawing(); ...game...;
                DrawRaven(LUi); EndDrawing();
    CloseRaven(); CloseWindow();

  Raven runs on its host platform (raven_host.h: the application's window
  system, no OS window of Raven's own) with this unit's rendering backend
  (R_BACKEND_CUSTOM, its render thread off, so every GL call is on raylib's
  thread): its draw list is replayed through rlgl with upstream's
  rounded-rectangle shaders ported to GLSL 330, in whatever raylib has bound
  (the screen, a render texture, a camera). raylib's input goes in through
  the host's inject calls: keys with their modifiers and auto-repeat, the
  mouse (a drag keeps its button past the window's edge; leaving the window
  ends hover), the wheel, typed text and the window's focus. Raven asks the
  host for the rest: the mouse cursor it wants is raylib's SetMouseCursor
  (R_CURSOR_NONE hides it), and its clipboard is raylib's, both ways.

  One Raven window is the program's UI layer: it covers the raylib window,
  follows its size in pixels, and its popups and menus draw inside it. Its
  UI scale is the window's DPI scale (System.Raylib.Ext's GetWindowDpi: Windows
  the window's monitor, Linux X11's Xft.dpi, 96 when unset), so text is
  sharp and sized for the monitor; with FLAG_WINDOW_HIGHDPI raylib's own
  scale is used instead (never both). Inside System.Raylib.Ext's frame window
  the Raven window is the frame's base size, drawn in base units between
  BeginFrame and EndFrame, scaled and letterboxed with the frame, its mouse
  over the letterbox only (the bars are not Raven's) and its text rasterized
  at the frame's real pixel density.

  A raylib texture shows inside Raven's widgets through CreateRavenTexture:
  a render texture the program draws a 3D view into becomes a Raven texture
  for a Viewport or an Image, drawn from raylib's own texture in every frame
  (no copy), so an editor's scene panel is raylib's drawing laid out,
  clipped and overdrawn by Raven like any widget.

  What raven_backend.h lets a backend leave out, this one does: GLASS and
  BLUR draw as their tinted rounded rectangle and SHADER effects (SPIR-V)
  through the plain rectangle path; a backdrop, erase or callback command
  and a frame capture are not drawn. The unit names no OS: rlgl, raylib and
  Raven are the same on every target.
*******************************************************************************/

module unit System.Raven.Raylib;

// System.Math comes before System.Raylib.C: a bare name two imports export is the last one's
// (BNF sec 1), and raylib's Vector2 is this unit's
import System.Math, System.Raylib.C, System.Raylib.Ext, System.Raven.C;

const
  // Raven windows this backend keeps a draw list for, at most
  ADAM_RAVEN_RAYLIB_MAX_WINDOWS: int32 = 8;
  // A scale below this is no scale (a DPI query that went wrong): 1 instead
  ADAM_RAVEN_RAYLIB_MIN_SCALE: float32 = 0.25f;
  // The vertices of one instance: its quad as two triangles (the vertex shader's CORNERS)
  ADAM_RAVEN_RAYLIB_QUAD_VERTICES: int32 = 6;
  // RDrawInstance's vertex attributes (rect, uv, clip, radii, color, border_color,
  // border_width, flags)
  ADAM_RAVEN_RAYLIB_ATTRIBUTES: uint32 = 8;
  // The DPI a scale of 1 stands for
  ADAM_RAVEN_RAYLIB_BASE_DPI: float32 = 96.0f;
  // The keys and cursors the tables below pair
  ADAM_RAVEN_RAYLIB_KEY_COUNT: int32 = 102;
  ADAM_RAVEN_RAYLIB_CURSOR_COUNT: int32 = 10;
  ADAM_RAVEN_RAYLIB_BUTTON_COUNT: int32 = 3;

  // Upstream's src/render/vulkan/shaders/ui.vert / ui.frag with the same signed-distance math,
  // for GL 3.3 through rlgl: the pixel position is a varying (v_pos, not gl_FragCoord), so the
  // same shader is right on the screen and in a render texture; clip space is raylib's
  // transform x modelview x projection, so Raven follows what raylib has bound; flags and
  // colours arrive as unsigned bytes (rlgl has no integer attribute path); 6 vertices per
  // instance from gl_VertexID
  ADAM_RAVEN_RAYLIB_VERTEX_SHADER: string = R"(#version 330
layout(location = 0) in vec4 in_rect;
layout(location = 1) in vec4 in_uv;
layout(location = 2) in vec4 in_clip;
layout(location = 3) in vec4 in_radii;
layout(location = 4) in vec4 in_color;
layout(location = 5) in vec4 in_border_color;
layout(location = 6) in float in_border_width;
layout(location = 7) in vec4 in_flags;
uniform mat4 u_mvp;
uniform float u_unit;
out vec2 v_uv;
out vec2 v_pos;
flat out vec4 v_rect;
flat out vec4 v_clip;
flat out vec4 v_radii;
flat out vec4 v_color;
flat out vec4 v_border_color;
flat out float v_border_width;
flat out vec4 v_flags;
flat out vec4 v_params;
const int CORNERS[6] = int[6](0, 1, 2, 2, 1, 3);
void main() {
  uint kind = uint(in_flags.x + 0.5) & 15u;
  int c = CORNERS[gl_VertexID];
  vec2 corner = vec2(float(c & 1), float(c >> 1));
  vec2 lo = in_rect.xy;
  vec2 hi = in_rect.zw;
  if (kind == 0u || kind == 5u || kind == 6u || kind == 8u) { lo -= 0.5; hi += 0.5; }
  else if (kind == 2u) { float g = in_border_width + 1.0; lo -= g; hi += g; }
  else if (kind == 3u) { float g = in_radii.x * 0.5 + 1.0; lo = min(in_rect.xy, in_rect.zw) - g; hi = max(in_rect.xy, in_rect.zw) + g; }
  else if (kind == 7u) { float g = in_border_width * 0.5 + in_uv.x + 1.0;
    lo = min(min(in_rect.xy, in_rect.zw), min(in_radii.xy, in_radii.zw)) - g;
    hi = max(max(in_rect.xy, in_rect.zw), max(in_radii.xy, in_radii.zw)) + g; }
  else if (kind == 4u) { lo = min(min(in_rect.xy, in_rect.zw), in_radii.xy) - 1.0; hi = max(max(in_rect.xy, in_rect.zw), in_radii.xy) + 1.0; }
  vec2 position = mix(lo, hi, corner);
  vec2 size = max(in_rect.zw - in_rect.xy, vec2(1e-6));
  v_uv = mix(in_uv.xy, in_uv.zw, (position - in_rect.xy) / size);
  v_pos = position;
  v_rect = in_rect; v_clip = in_clip; v_radii = in_radii;
  v_color = vec4(in_color.rgb * in_color.a, in_color.a);
  v_border_color = vec4(in_border_color.rgb * in_border_color.a, in_border_color.a);
  v_border_width = in_border_width; v_flags = in_flags; v_params = in_uv;
  gl_Position = u_mvp * vec4(position * u_unit, 0.0, 1.0);
}
)";

  ADAM_RAVEN_RAYLIB_FRAGMENT_SHADER: string = R"(#version 330
uniform sampler2D u_texture;
in vec2 v_uv;
in vec2 v_pos;
flat in vec4 v_rect;
flat in vec4 v_clip;
flat in vec4 v_radii;
flat in vec4 v_color;
flat in vec4 v_border_color;
flat in float v_border_width;
flat in vec4 v_flags;
flat in vec4 v_params;
layout(location = 0) out vec4 out_color;
float sd_round_box(vec2 p, vec2 half_size, vec4 radii) {
  float radius = p.x < 0.0 ? (p.y < 0.0 ? radii.x : radii.w) : (p.y < 0.0 ? radii.y : radii.z);
  radius = min(radius, min(half_size.x, half_size.y));
  vec2 q = abs(p) - half_size + radius;
  return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - radius;
}
float sd_segment(vec2 p, vec2 a, vec2 b) {
  vec2 pa = p - a; vec2 ba = b - a;
  float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
  return length(pa - ba * h);
}
float sd_triangle(vec2 p, vec2 p0, vec2 p1, vec2 p2) {
  vec2 e0 = p1 - p0, e1 = p2 - p1, e2 = p0 - p2;
  vec2 v0 = p - p0, v1 = p - p1, v2 = p - p2;
  vec2 pq0 = v0 - e0 * clamp(dot(v0, e0) / max(dot(e0, e0), 1e-6), 0.0, 1.0);
  vec2 pq1 = v1 - e1 * clamp(dot(v1, e1) / max(dot(e1, e1), 1e-6), 0.0, 1.0);
  vec2 pq2 = v2 - e2 * clamp(dot(v2, e2) / max(dot(e2, e2), 1e-6), 0.0, 1.0);
  float s = sign(e0.x * e2.y - e0.y * e2.x);
  vec2 d = min(min(vec2(dot(pq0, pq0), s * (v0.x * e0.y - v0.y * e0.x)),
                   vec2(dot(pq1, pq1), s * (v1.x * e1.y - v1.y * e1.x))),
                   vec2(dot(pq2, pq2), s * (v2.x * e2.y - v2.y * e2.x)));
  return -sqrt(d.x) * sign(d.y);
}
void main() {
  vec2 p = v_pos;
  if (p.x < v_clip.x || p.y < v_clip.y || p.x >= v_clip.z || p.y >= v_clip.w) discard;
  uint f0 = uint(v_flags.x + 0.5);
  uint kind = f0 & 15u;
  vec4 color = v_color;
  if ((f0 & 16u) != 0u) { vec4 t = textureLod(u_texture, v_uv, 0.0); color *= vec4(t.rgb * t.a, t.a); }
  float coverage = 1.0;
  if (kind == 0u || kind == 5u || kind == 6u || kind == 8u) {
    vec2 hs = (v_rect.zw - v_rect.xy) * 0.5;
    float d = sd_round_box(p - (v_rect.xy + hs), hs, v_radii);
    coverage = clamp(0.5 - d, 0.0, 1.0);
    if (v_border_width > 0.0 && kind != 5u) { float inside = clamp(0.5 - (d + v_border_width), 0.0, 1.0); color = mix(v_border_color, color, inside); }
    if (kind == 5u || kind == 6u) color *= (v_flags.y / 255.0);
  } else if (kind == 2u) {
    vec2 hs = (v_rect.zw - v_rect.xy) * 0.5;
    float d = sd_round_box(p - (v_rect.xy + hs), hs, v_radii);
    float b = max(v_border_width, 0.5);
    coverage = 1.0 - smoothstep(-b, b, d);
  } else if (kind == 3u) {
    float d = sd_segment(p, v_rect.xy, v_rect.zw) - v_radii.x * 0.5;
    coverage = clamp(0.5 - d, 0.0, 1.0);
  } else if (kind == 4u) {
    float d = sd_triangle(p, v_rect.xy, v_rect.zw, v_radii.xy);
    coverage = clamp(0.5 - d, 0.0, 1.0);
  } else if (kind == 7u) {
    vec2 a = v_rect.xy, b = v_radii.xy, c = v_radii.zw, e = v_rect.zw;
    vec2 from = a; float nearest = 1e20, along = 0.0;
    for (int i = 1; i <= 24; i++) {
      float t = float(i) / 24.0; float u = 1.0 - t;
      vec2 to = u * u * u * a + 3.0 * u * u * t * b + 3.0 * u * t * t * c + t * t * t * e;
      vec2 pa = p - from, ba = to - from;
      float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
      vec2 away = pa - ba * h; float d2 = dot(away, away);
      if (d2 < nearest) { nearest = d2; along = (float(i - 1) + h) / 24.0; }
      from = to;
    }
    float d = sqrt(nearest) - v_border_width * 0.5;
    float stroke = clamp(0.5 - d, 0.0, 1.0);
    float pulse = 0.0;
    color = mix(v_color, v_border_color, along);
    float bright = v_flags.y / 255.0;
    if (v_params.w > 0.0 && bright > 0.0) { float f = fract(along * v_params.w - v_params.z) - 0.5; pulse = exp(-f * f * 80.0) * bright; color.rgb = mix(color.rgb, vec3(color.a), pulse * 0.6); }
    float halo = 0.0;
    if (v_params.x > 0.0) { halo = 1.0 - smoothstep(0.0, v_params.x, max(d, 0.0)); halo = halo * halo * v_params.y * (1.0 + pulse * 0.8); }
    coverage = stroke + (1.0 - stroke) * min(halo, 1.0);
  }
  out_color = color * coverage;
}
)";

type
  // A texture Raven made: its GL name and how its pixels come in. Owned is false for a raylib
  // texture CreateRavenTexture linked: Raven draws it, raylib keeps it (never unloaded,
  // updated or re-filtered here)
  RavenTextureSlot = record
    Gl: uint32;
    Format: RTextureFormat;
    Owned: bool;
  end;

  // A Raven window's last draw list (Raven renders a window only when it changed, a game
  // redraws every frame, so DrawRaven replays it) and what the host last told Raven of it
  RavenWindowSlot = record
    Used: bool;
    Window: Rid;
    Instances: array of RDrawInstance;
    InstanceCount: int32;
    Commands: array of RDrawCommand;
    CommandCount: int32;
    // raylib units per framebuffer pixel, from UpdateRaven's layout
    UnitsPerPixel: float32;
    // The mouse as last injected (framebuffer pixels) and whether Raven has it
    MouseX: int32;
    MouseY: int32;
    MouseInside: bool;
    Focused: bool;
  end;

  // The Raven window as UpdateRaven lays it out over raylib's window or the frame: its size in
  // framebuffer pixels, its UI scale (pixels per logical unit), raylib units per pixel, and
  // the mouse in pixels with whether it is over the window
  RavenLayout = record
    Width: int32;
    Height: int32;
    Scale: float32;
    UnitsPerPixel: float32;
    MouseX: int32;
    MouseY: int32;
    MouseInside: bool;
  end;

  // raylib key -> Raven key: the same codes up to END, then the two diverge, so every pair is
  // named (the compiler checks both sides)
  RavenKeyPair = record
    RaylibKey: int32;
    RavenKey: RKey;
  end;

  // The cursor Raven asks for -> raylib's
  RavenCursorPair = record
    RavenCursor: RCursor;
    RaylibCursor: int32;
  end;

const
  ADAM_RAVEN_RAYLIB_KEYS: array[0..ADAM_RAVEN_RAYLIB_KEY_COUNT - 1] of RavenKeyPair = [
    RavenKeyPair(RaylibKey: KEY_SPACE, RavenKey: R_KEY_SPACE),
    RavenKeyPair(RaylibKey: KEY_APOSTROPHE, RavenKey: R_KEY_APOSTROPHE),
    RavenKeyPair(RaylibKey: KEY_COMMA, RavenKey: R_KEY_COMMA),
    RavenKeyPair(RaylibKey: KEY_MINUS, RavenKey: R_KEY_MINUS),
    RavenKeyPair(RaylibKey: KEY_PERIOD, RavenKey: R_KEY_PERIOD),
    RavenKeyPair(RaylibKey: KEY_SLASH, RavenKey: R_KEY_SLASH),
    RavenKeyPair(RaylibKey: KEY_ZERO, RavenKey: R_KEY_0),
    RavenKeyPair(RaylibKey: KEY_ONE, RavenKey: R_KEY_1),
    RavenKeyPair(RaylibKey: KEY_TWO, RavenKey: R_KEY_2),
    RavenKeyPair(RaylibKey: KEY_THREE, RavenKey: R_KEY_3),
    RavenKeyPair(RaylibKey: KEY_FOUR, RavenKey: R_KEY_4),
    RavenKeyPair(RaylibKey: KEY_FIVE, RavenKey: R_KEY_5),
    RavenKeyPair(RaylibKey: KEY_SIX, RavenKey: R_KEY_6),
    RavenKeyPair(RaylibKey: KEY_SEVEN, RavenKey: R_KEY_7),
    RavenKeyPair(RaylibKey: KEY_EIGHT, RavenKey: R_KEY_8),
    RavenKeyPair(RaylibKey: KEY_NINE, RavenKey: R_KEY_9),
    RavenKeyPair(RaylibKey: KEY_SEMICOLON, RavenKey: R_KEY_SEMICOLON),
    RavenKeyPair(RaylibKey: KEY_EQUAL, RavenKey: R_KEY_EQUAL),
    RavenKeyPair(RaylibKey: KEY_A, RavenKey: R_KEY_A),
    RavenKeyPair(RaylibKey: KEY_B, RavenKey: R_KEY_B),
    RavenKeyPair(RaylibKey: KEY_C, RavenKey: R_KEY_C),
    RavenKeyPair(RaylibKey: KEY_D, RavenKey: R_KEY_D),
    RavenKeyPair(RaylibKey: KEY_E, RavenKey: R_KEY_E),
    RavenKeyPair(RaylibKey: KEY_F, RavenKey: R_KEY_F),
    RavenKeyPair(RaylibKey: KEY_G, RavenKey: R_KEY_G),
    RavenKeyPair(RaylibKey: KEY_H, RavenKey: R_KEY_H),
    RavenKeyPair(RaylibKey: KEY_I, RavenKey: R_KEY_I),
    RavenKeyPair(RaylibKey: KEY_J, RavenKey: R_KEY_J),
    RavenKeyPair(RaylibKey: KEY_K, RavenKey: R_KEY_K),
    RavenKeyPair(RaylibKey: KEY_L, RavenKey: R_KEY_L),
    RavenKeyPair(RaylibKey: KEY_M, RavenKey: R_KEY_M),
    RavenKeyPair(RaylibKey: KEY_N, RavenKey: R_KEY_N),
    RavenKeyPair(RaylibKey: KEY_O, RavenKey: R_KEY_O),
    RavenKeyPair(RaylibKey: KEY_P, RavenKey: R_KEY_P),
    RavenKeyPair(RaylibKey: KEY_Q, RavenKey: R_KEY_Q),
    RavenKeyPair(RaylibKey: KEY_R, RavenKey: R_KEY_R),
    RavenKeyPair(RaylibKey: KEY_S, RavenKey: R_KEY_S),
    RavenKeyPair(RaylibKey: KEY_T, RavenKey: R_KEY_T),
    RavenKeyPair(RaylibKey: KEY_U, RavenKey: R_KEY_U),
    RavenKeyPair(RaylibKey: KEY_V, RavenKey: R_KEY_V),
    RavenKeyPair(RaylibKey: KEY_W, RavenKey: R_KEY_W),
    RavenKeyPair(RaylibKey: KEY_X, RavenKey: R_KEY_X),
    RavenKeyPair(RaylibKey: KEY_Y, RavenKey: R_KEY_Y),
    RavenKeyPair(RaylibKey: KEY_Z, RavenKey: R_KEY_Z),
    RavenKeyPair(RaylibKey: KEY_LEFT_BRACKET, RavenKey: R_KEY_LEFT_BRACKET),
    RavenKeyPair(RaylibKey: KEY_BACKSLASH, RavenKey: R_KEY_BACKSLASH),
    RavenKeyPair(RaylibKey: KEY_RIGHT_BRACKET, RavenKey: R_KEY_RIGHT_BRACKET),
    RavenKeyPair(RaylibKey: KEY_GRAVE, RavenKey: R_KEY_GRAVE),
    RavenKeyPair(RaylibKey: KEY_ESCAPE, RavenKey: R_KEY_ESCAPE),
    RavenKeyPair(RaylibKey: KEY_ENTER, RavenKey: R_KEY_ENTER),
    RavenKeyPair(RaylibKey: KEY_TAB, RavenKey: R_KEY_TAB),
    RavenKeyPair(RaylibKey: KEY_BACKSPACE, RavenKey: R_KEY_BACKSPACE),
    RavenKeyPair(RaylibKey: KEY_INSERT, RavenKey: R_KEY_INSERT),
    RavenKeyPair(RaylibKey: KEY_DELETE, RavenKey: R_KEY_DELETE),
    RavenKeyPair(RaylibKey: KEY_RIGHT, RavenKey: R_KEY_RIGHT),
    RavenKeyPair(RaylibKey: KEY_LEFT, RavenKey: R_KEY_LEFT),
    RavenKeyPair(RaylibKey: KEY_DOWN, RavenKey: R_KEY_DOWN),
    RavenKeyPair(RaylibKey: KEY_UP, RavenKey: R_KEY_UP),
    RavenKeyPair(RaylibKey: KEY_PAGE_UP, RavenKey: R_KEY_PAGE_UP),
    RavenKeyPair(RaylibKey: KEY_PAGE_DOWN, RavenKey: R_KEY_PAGE_DOWN),
    RavenKeyPair(RaylibKey: KEY_HOME, RavenKey: R_KEY_HOME),
    RavenKeyPair(RaylibKey: KEY_END, RavenKey: R_KEY_END),
    RavenKeyPair(RaylibKey: KEY_CAPS_LOCK, RavenKey: R_KEY_CAPS_LOCK),
    RavenKeyPair(RaylibKey: KEY_PRINT_SCREEN, RavenKey: R_KEY_PRINT_SCREEN),
    RavenKeyPair(RaylibKey: KEY_PAUSE, RavenKey: R_KEY_PAUSE),
    RavenKeyPair(RaylibKey: KEY_F1, RavenKey: R_KEY_F1),
    RavenKeyPair(RaylibKey: KEY_F2, RavenKey: R_KEY_F2),
    RavenKeyPair(RaylibKey: KEY_F3, RavenKey: R_KEY_F3),
    RavenKeyPair(RaylibKey: KEY_F4, RavenKey: R_KEY_F4),
    RavenKeyPair(RaylibKey: KEY_F5, RavenKey: R_KEY_F5),
    RavenKeyPair(RaylibKey: KEY_F6, RavenKey: R_KEY_F6),
    RavenKeyPair(RaylibKey: KEY_F7, RavenKey: R_KEY_F7),
    RavenKeyPair(RaylibKey: KEY_F8, RavenKey: R_KEY_F8),
    RavenKeyPair(RaylibKey: KEY_F9, RavenKey: R_KEY_F9),
    RavenKeyPair(RaylibKey: KEY_F10, RavenKey: R_KEY_F10),
    RavenKeyPair(RaylibKey: KEY_F11, RavenKey: R_KEY_F11),
    RavenKeyPair(RaylibKey: KEY_F12, RavenKey: R_KEY_F12),
    RavenKeyPair(RaylibKey: KEY_KP_0, RavenKey: R_KEY_KP_0),
    RavenKeyPair(RaylibKey: KEY_KP_1, RavenKey: R_KEY_KP_1),
    RavenKeyPair(RaylibKey: KEY_KP_2, RavenKey: R_KEY_KP_2),
    RavenKeyPair(RaylibKey: KEY_KP_3, RavenKey: R_KEY_KP_3),
    RavenKeyPair(RaylibKey: KEY_KP_4, RavenKey: R_KEY_KP_4),
    RavenKeyPair(RaylibKey: KEY_KP_5, RavenKey: R_KEY_KP_5),
    RavenKeyPair(RaylibKey: KEY_KP_6, RavenKey: R_KEY_KP_6),
    RavenKeyPair(RaylibKey: KEY_KP_7, RavenKey: R_KEY_KP_7),
    RavenKeyPair(RaylibKey: KEY_KP_8, RavenKey: R_KEY_KP_8),
    RavenKeyPair(RaylibKey: KEY_KP_9, RavenKey: R_KEY_KP_9),
    RavenKeyPair(RaylibKey: KEY_KP_DECIMAL, RavenKey: R_KEY_KP_DECIMAL),
    RavenKeyPair(RaylibKey: KEY_KP_DIVIDE, RavenKey: R_KEY_KP_DIVIDE),
    RavenKeyPair(RaylibKey: KEY_KP_MULTIPLY, RavenKey: R_KEY_KP_MULTIPLY),
    RavenKeyPair(RaylibKey: KEY_KP_SUBTRACT, RavenKey: R_KEY_KP_SUBTRACT),
    RavenKeyPair(RaylibKey: KEY_KP_ADD, RavenKey: R_KEY_KP_ADD),
    RavenKeyPair(RaylibKey: KEY_KP_ENTER, RavenKey: R_KEY_KP_ENTER),
    RavenKeyPair(RaylibKey: KEY_LEFT_SHIFT, RavenKey: R_KEY_LEFT_SHIFT),
    RavenKeyPair(RaylibKey: KEY_LEFT_CONTROL, RavenKey: R_KEY_LEFT_CTRL),
    RavenKeyPair(RaylibKey: KEY_LEFT_ALT, RavenKey: R_KEY_LEFT_ALT),
    RavenKeyPair(RaylibKey: KEY_LEFT_SUPER, RavenKey: R_KEY_LEFT_SUPER),
    RavenKeyPair(RaylibKey: KEY_RIGHT_SHIFT, RavenKey: R_KEY_RIGHT_SHIFT),
    RavenKeyPair(RaylibKey: KEY_RIGHT_CONTROL, RavenKey: R_KEY_RIGHT_CTRL),
    RavenKeyPair(RaylibKey: KEY_RIGHT_ALT, RavenKey: R_KEY_RIGHT_ALT),
    RavenKeyPair(RaylibKey: KEY_RIGHT_SUPER, RavenKey: R_KEY_RIGHT_SUPER),
    RavenKeyPair(RaylibKey: KEY_KB_MENU, RavenKey: R_KEY_MENU)
  ];

  // R_CURSOR_NONE is not here: it hides raylib's cursor (DoApplyCursor)
  ADAM_RAVEN_RAYLIB_CURSORS: array[0..ADAM_RAVEN_RAYLIB_CURSOR_COUNT - 1] of RavenCursorPair = [
    RavenCursorPair(RavenCursor: R_CURSOR_ARROW, RaylibCursor: MOUSE_CURSOR_DEFAULT),
    RavenCursorPair(RavenCursor: R_CURSOR_IBEAM, RaylibCursor: MOUSE_CURSOR_IBEAM),
    RavenCursorPair(RavenCursor: R_CURSOR_HAND, RaylibCursor: MOUSE_CURSOR_POINTING_HAND),
    RavenCursorPair(RavenCursor: R_CURSOR_CROSSHAIR, RaylibCursor: MOUSE_CURSOR_CROSSHAIR),
    RavenCursorPair(RavenCursor: R_CURSOR_RESIZE_H, RaylibCursor: MOUSE_CURSOR_RESIZE_EW),
    RavenCursorPair(RavenCursor: R_CURSOR_RESIZE_V, RaylibCursor: MOUSE_CURSOR_RESIZE_NS),
    RavenCursorPair(RavenCursor: R_CURSOR_RESIZE_NWSE, RaylibCursor: MOUSE_CURSOR_RESIZE_NWSE),
    RavenCursorPair(RavenCursor: R_CURSOR_RESIZE_NESW, RaylibCursor: MOUSE_CURSOR_RESIZE_NESW),
    RavenCursorPair(RavenCursor: R_CURSOR_MOVE, RaylibCursor: MOUSE_CURSOR_RESIZE_ALL),
    RavenCursorPair(RavenCursor: R_CURSOR_NOT_ALLOWED, RaylibCursor: MOUSE_CURSOR_NOT_ALLOWED)
  ];

  ADAM_RAVEN_RAYLIB_BUTTONS: array[0..ADAM_RAVEN_RAYLIB_BUTTON_COUNT - 1] of int32 = [
    MOUSE_BUTTON_LEFT, MOUSE_BUTTON_RIGHT, MOUSE_BUTTON_MIDDLE];
  ADAM_RAVEN_RAYLIB_TARGETS: array[0..ADAM_RAVEN_RAYLIB_BUTTON_COUNT - 1] of RMouseButton = [
    R_MOUSE_LEFT, R_MOUSE_RIGHT, R_MOUSE_MIDDLE];

var
  // The backend's GL objects (DoBackendInit's)
  GProgram: uint32;
  GLocMvp: int32;
  GLocUnit: int32;
  GLocTexture: int32;
  GVao: uint32;
  GVbo: uint32;
  GVboSize: int32;
  // Indexed by R_ID_INDEX of the texture's Rid
  GTextures: array of RavenTextureSlot;
  GWindows: array[0..ADAM_RAVEN_RAYLIB_MAX_WINDOWS - 1] of RavenWindowSlot;
  // ALPHA8 pixels widened to RGBA8
  GConvert: array of uint8;
  // The cursor Raven asked for last, and whether this unit hid raylib's for it
  GCursor: RCursor;
  GCursorHidden: bool;

// ---- the backend's state ----

// A bool as Raven's int (R_TRUE / R_FALSE)
func DoRavenBool(const AValue: bool): int32;
begin
  if AValue then
    return R_TRUE;
  end;
  return R_FALSE;
end;

// The slot of a Raven window, made when ACreate and there is room; -1 when none
func DoFindWindow(const AWindow: Rid; const ACreate: bool): int32;
var
  LIndex: int32;
begin
  for LIndex := 0 to ADAM_RAVEN_RAYLIB_MAX_WINDOWS - 1 do
    if GWindows[LIndex].Used and (GWindows[LIndex].Window = AWindow) then
      return LIndex;
    end;
  end;
  if not ACreate then
    return -1;
  end;
  for LIndex := 0 to ADAM_RAVEN_RAYLIB_MAX_WINDOWS - 1 do
    if not GWindows[LIndex].Used then
      GWindows[LIndex].Used := true;
      GWindows[LIndex].Window := AWindow;
      GWindows[LIndex].UnitsPerPixel := 1.0f;
      return LIndex;
    end;
  end;
  return -1;
end;

// A window slot back to unused, its draw lists freed
func DoClearWindow(const AIndex: int32);
var
  LEmpty: RavenWindowSlot;
begin
  GWindows[AIndex] := LEmpty;
end;

// The slot of a texture (its R_ID_INDEX), grown to it when ACreate; -1 when none
func DoFindTexture(const ATexture: Rid; const ACreate: bool): int64;
var
  LIndex: int64;
begin
  if ATexture = R_INVALID_ID then
    return -1;
  end;
  LIndex := int64(R_ID_INDEX(ATexture));
  if LIndex >= len(GTextures) then
    if not ACreate then
      return -1;
    end;
    setlength(GTextures, LIndex + 1);
  end;
  return LIndex;
end;

// ALPHA8 is sampled as (1, 1, 1, value): widened to RGBA8 on the CPU, every texture being
// RGBA8 on the GL side
func DoPixels(const AFormat: RTextureFormat; const AWidth: Ruint; const AHeight: Ruint;
  const APixels: ptr to const): ptr to const;
var
  LCount: int64;
  LPixel: int64;
  LSource: ptr to const uint8;
begin
  LCount := int64(AWidth) * int64(AHeight);
  if (APixels = nil) or (AFormat <> R_TEXTURE_ALPHA8) or (LCount = 0) then
    return APixels;
  end;
  if len(GConvert) < LCount * 4 then
    setlength(GConvert, LCount * 4);
  end;
  LSource := ptr to const uint8(APixels);
  for LPixel := 0 to LCount - 1 do
    GConvert[LPixel * 4] := 255;
    GConvert[LPixel * 4 + 1] := 255;
    GConvert[LPixel * 4 + 2] := 255;
    GConvert[LPixel * 4 + 3] := LSource[LPixel];
  end;
  return addr of GConvert[0];
end;

func DoFilter(const AGl: uint32; const AFilter: RFilterType);
var
  LValue: int32;
begin
  LValue := RL_TEXTURE_FILTER_LINEAR;
  if AFilter = R_FILTER_NEAREST then
    LValue := RL_TEXTURE_FILTER_NEAREST;
  end;
  rlTextureParameters(AGl, RL_TEXTURE_MIN_FILTER, LValue);
  rlTextureParameters(AGl, RL_TEXTURE_MAG_FILTER, LValue);
  rlTextureParameters(AGl, RL_TEXTURE_WRAP_S, RL_TEXTURE_WRAP_CLAMP);
  rlTextureParameters(AGl, RL_TEXTURE_WRAP_T, RL_TEXTURE_WRAP_CLAMP);
end;

// ---- the RBackendVTable entries (Raven calls them on raylib's thread) ----

func clink DoBackendInit(info: ptr to const RBackendInitInfo): int32;
begin
  GProgram := rlLoadShaderProgram(ADAM_RAVEN_RAYLIB_VERTEX_SHADER, ADAM_RAVEN_RAYLIB_FRAGMENT_SHADER);
  if GProgram = 0 then
    return R_FALSE;
  end;
  GLocMvp := rlGetLocationUniform(GProgram, "u_mvp");
  GLocUnit := rlGetLocationUniform(GProgram, "u_unit");
  GLocTexture := rlGetLocationUniform(GProgram, "u_texture");
  GVao := rlLoadVertexArray();
  return R_TRUE;
end;

// Every GL object freed, the state back to "not set up", ready for another InitRaven
func clink DoBackendShutdown();
var
  LIndex: int64;
  LWindow: int32;
begin
  for LIndex := 0 to len(GTextures) - 1 do
    if (GTextures[LIndex].Gl <> 0) and GTextures[LIndex].Owned then
      rlUnloadTexture(GTextures[LIndex].Gl);
    end;
  end;
  setlength(GTextures, 0);
  for LWindow := 0 to ADAM_RAVEN_RAYLIB_MAX_WINDOWS - 1 do
    DoClearWindow(LWindow);
  end;
  setlength(GConvert, 0);
  if GVbo <> 0 then
    rlUnloadVertexBuffer(GVbo);
  end;
  if GVao <> 0 then
    rlUnloadVertexArray(GVao);
  end;
  if GProgram <> 0 then
    rlUnloadShaderProgram(GProgram);
  end;
  GVbo := 0;
  GVboSize := 0;
  GVao := 0;
  GProgram := 0;
  GLocMvp := -1;
  GLocUnit := -1;
  GLocTexture := -1;
end;

// raylib's window is the surface: a slot for the window's draw list is all it takes
func clink DoCreateSurface(window: Rid; native: ptr to const RNativeWindow; width: Ruint;
  height: Ruint): int32;
begin
  return DoRavenBool(DoFindWindow(window, true) >= 0);
end;

func clink DoDestroySurface(window: Rid);
var
  LIndex: int32;
begin
  LIndex := DoFindWindow(window, false);
  if LIndex >= 0 then
    DoClearWindow(LIndex);
  end;
end;

func clink DoCreateTexture(texture: Rid; desc: ptr to const RTextureDesc; pixels: ptr to const): int32;
var
  LSlot: int64;
begin
  LSlot := DoFindTexture(texture, true);
  if LSlot < 0 then
    return R_FALSE;
  end;
  if (GTextures[LSlot].Gl <> 0) and GTextures[LSlot].Owned then
    rlUnloadTexture(GTextures[LSlot].Gl);
  end;
  GTextures[LSlot].Owned := true;
  GTextures[LSlot].Format := desc^.format;
  GTextures[LSlot].Gl := rlLoadTexture(DoPixels(desc^.format, desc^.width, desc^.height, pixels),
    int32(desc^.width), int32(desc^.height), RL_PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 1);
  if GTextures[LSlot].Gl = 0 then
    return R_FALSE;
  end;
  DoFilter(GTextures[LSlot].Gl, desc^.filter);
  return R_TRUE;
end;

func clink DoUpdateTexture(texture: Rid; x: Ruint; y: Ruint; width: Ruint; height: Ruint;
  pixels: ptr to const);
var
  LSlot: int64;
begin
  LSlot := DoFindTexture(texture, false);
  if (LSlot < 0) or (pixels = nil) then
    return;
  end;
  if (GTextures[LSlot].Gl = 0) or not GTextures[LSlot].Owned then
    return;
  end;
  rlUpdateTexture(GTextures[LSlot].Gl, int32(x), int32(y), int32(width), int32(height),
    RL_PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, DoPixels(GTextures[LSlot].Format, width, height, pixels));
end;

func clink DoSetTextureFilter(texture: Rid; filter: RFilterType);
var
  LSlot: int64;
begin
  LSlot := DoFindTexture(texture, false);
  if LSlot < 0 then
    return;
  end;
  if (GTextures[LSlot].Gl <> 0) and GTextures[LSlot].Owned then
    DoFilter(GTextures[LSlot].Gl, filter);
  end;
end;

func clink DoDestroyTexture(texture: Rid);
var
  LSlot: int64;
  LEmpty: RavenTextureSlot;
begin
  LSlot := DoFindTexture(texture, false);
  if LSlot < 0 then
    return;
  end;
  if (GTextures[LSlot].Gl <> 0) and GTextures[LSlot].Owned then
    rlUnloadTexture(GTextures[LSlot].Gl);
  end;
  GTextures[LSlot] := LEmpty;
end;

// Keeps the window's draw list: DrawRaven replays it every frame. A capture is not supported:
// no pixels
func clink DoRenderFrame(data: ptr to const RDrawData; capture: ptr to RCapture);
var
  LIndex: int32;
  LInstances: int64;
  LCommands: int64;
begin
  if capture <> nil then
    capture^.pixels := nil;
  end;
  LIndex := DoFindWindow(data^.window, true);
  if LIndex < 0 then
    return;
  end;
  LInstances := int64(data^.instance_count);
  LCommands := int64(data^.command_count);
  if len(GWindows[LIndex].Instances) < LInstances then
    setlength(GWindows[LIndex].Instances, LInstances);
  end;
  if len(GWindows[LIndex].Commands) < LCommands then
    setlength(GWindows[LIndex].Commands, LCommands);
  end;
  if LInstances > 0 then
    CopyBytes(ptr to uint8(addr of GWindows[LIndex].Instances[0]), ptr to const uint8(data^.instances),
      LInstances * size(RDrawInstance));
  end;
  if LCommands > 0 then
    CopyBytes(ptr to uint8(addr of GWindows[LIndex].Commands[0]), ptr to const uint8(data^.commands),
      LCommands * size(RDrawCommand));
  end;
  GWindows[LIndex].InstanceCount := int32(LInstances);
  GWindows[LIndex].CommandCount := int32(LCommands);
end;

// rlgl's calls are in order on raylib's thread: nothing is ever in flight
func clink DoWaitIdle();
begin
end;

func DoRegisterBackend();
var
  LTable: RBackendVTable;
begin
  LTable.name := "raylib";
  LTable.Init := DoBackendInit;
  LTable.Shutdown := DoBackendShutdown;
  LTable.CreateSurface := DoCreateSurface;
  LTable.DestroySurface := DoDestroySurface;
  LTable.CreateTexture := DoCreateTexture;
  LTable.UpdateTexture := DoUpdateTexture;
  LTable.SetTextureFilter := DoSetTextureFilter;
  LTable.DestroyTexture := DoDestroyTexture;
  LTable.RenderFrame := DoRenderFrame;
  LTable.WaitIdle := DoWaitIdle;
  // CreateShader / DestroyShader stay nil: SHADER primitives draw as rounded rectangles
  Rbackend_register(addr of LTable);
end;

// ---- the host platform (raven_host.h): what Raven asks of raylib ----

// The cursor Raven wants over its window as raylib's; R_CURSOR_NONE hides raylib's, any other
// shows it again
func DoApplyCursor(const ACursor: RCursor);
var
  LIndex: int32;
  LRaylib: int32;
begin
  if ACursor = GCursor then
    return;
  end;
  GCursor := ACursor;
  if ACursor = R_CURSOR_NONE then
    if not IsCursorHidden() then
      HideCursor();
      GCursorHidden := true;
    end;
    return;
  end;
  if GCursorHidden then
    ShowCursor();
    GCursorHidden := false;
  end;
  LRaylib := MOUSE_CURSOR_DEFAULT;
  for LIndex := 0 to ADAM_RAVEN_RAYLIB_CURSOR_COUNT - 1 do
    if ADAM_RAVEN_RAYLIB_CURSORS[LIndex].RavenCursor = ACursor then
      LRaylib := ADAM_RAVEN_RAYLIB_CURSORS[LIndex].RaylibCursor;
    end;
  end;
  SetMouseCursor(LRaylib);
end;

// raylib's cursor as the program had it before Raven: shown, the default shape
func DoResetCursor();
begin
  if IsWindowReady() then
    if GCursorHidden then
      ShowCursor();
    end;
    if GCursor <> R_CURSOR_ARROW then
      SetMouseCursor(MOUSE_CURSOR_DEFAULT);
    end;
  end;
  GCursorHidden := false;
  GCursor := R_CURSOR_ARROW;
end;

func clink DoHostSetCursor(window: Rid; cursor: RCursor; user_data: ptr);
begin
  DoApplyCursor(cursor);
end;

// Raven's clipboard is raylib's: what it copies reaches the OS, a paste reads the OS's
func clink DoHostClipboardSet(text: ptr to const char; user_data: ptr);
begin
  SetClipboardText(text);
end;

// raylib's text stays valid until its next call, as raven_host.h asks (Raven copies it)
func clink DoHostClipboardGet(user_data: ptr): ptr to const char;
begin
  return GetClipboardText();
end;

// ---- input ----

func DoModifiers(): Ruint;
var
  LMods: Ruint;
begin
  LMods := 0;
  if IsKeyDown(KEY_LEFT_SHIFT) or IsKeyDown(KEY_RIGHT_SHIFT) then
    LMods := LMods | Ruint(R_MOD_SHIFT);
  end;
  if IsKeyDown(KEY_LEFT_CONTROL) or IsKeyDown(KEY_RIGHT_CONTROL) then
    LMods := LMods | Ruint(R_MOD_CTRL);
  end;
  if IsKeyDown(KEY_LEFT_ALT) or IsKeyDown(KEY_RIGHT_ALT) then
    LMods := LMods | Ruint(R_MOD_ALT);
  end;
  if IsKeyDown(KEY_LEFT_SUPER) or IsKeyDown(KEY_RIGHT_SUPER) then
    LMods := LMods | Ruint(R_MOD_SUPER);
  end;
  return LMods;
end;

// A scale a query gave, or 1 when it is no scale
func DoCheckedScale(const AScale: float32): float32;
begin
  if AScale < ADAM_RAVEN_RAYLIB_MIN_SCALE then
    return 1.0f;
  end;
  return AScale;
end;

// Framebuffer pixels per raylib window unit: 1, or the monitor's scale when raylib scales the
// window itself (FLAG_WINDOW_HIGHDPI)
func DoPixelsPerUnit(): float32;
begin
  if IsWindowState(uint32(FLAG_WINDOW_HIGHDPI)) then
    return DoCheckedScale(GetWindowScaleDPI().x);
  end;
  return 1.0f;
end;

// Inside the frame window: the frame's base size in base units, drawn through its letterbox
// (GetFrameLetterbox: the window's size now under the frame's own rule, fit or integer scale,
// so the UI never drifts off the frame), text at the letterbox's real pixel density, the mouse
// over the letterbox only
func DoFrameLayout(): RavenLayout;
var
  LResult: RavenLayout;
  LBox: Rectangle;
  LZoom: float32;
  LPixels: float32;
  LMouse: Vector2;
begin
  LBox := GetFrameLetterbox();
  LZoom := LBox.width / float32(GetFrameWidth());
  // A minimized window has an empty letterbox: 1 is never wrong
  if LZoom <= 0.0f then
    LZoom := 1.0f;
  end;
  LPixels := DoPixelsPerUnit();
  LResult.Scale := LZoom * LPixels;
  LResult.Width := int32(Round(float32(GetFrameWidth()) * LResult.Scale));
  LResult.Height := int32(Round(float32(GetFrameHeight()) * LResult.Scale));
  LResult.UnitsPerPixel := 1.0f / LResult.Scale;
  LMouse := GetMousePosition();
  LResult.MouseInside := (LBox.width > 0.0f) and IsCursorOnScreen() and
    CheckCollisionPointRec(LMouse, LBox);
  LResult.MouseX := int32(Round((LMouse.x - LBox.x) * LPixels));
  LResult.MouseY := int32(Round((LMouse.y - LBox.y) * LPixels));
  return LResult;
end;

// raylib's own window: the UI laid out at the window's DPI scale. Without FLAG_WINDOW_HIGHDPI
// raylib's units are pixels; with it raylib works in logical units at its own scale
func DoWindowLayout(): RavenLayout;
var
  LResult: RavenLayout;
  LPixels: float32;
  LMouse: Vector2;
begin
  LPixels := DoPixelsPerUnit();
  if IsWindowState(uint32(FLAG_WINDOW_HIGHDPI)) then
    LResult.Scale := LPixels;
  else
    LResult.Scale := DoCheckedScale(float32(GetWindowDpi()) / ADAM_RAVEN_RAYLIB_BASE_DPI);
  end;
  LResult.Width := int32(Round(float32(GetScreenWidth()) * LPixels));
  LResult.Height := int32(Round(float32(GetScreenHeight()) * LPixels));
  LResult.UnitsPerPixel := 1.0f / LPixels;
  LMouse := GetMousePosition();
  LResult.MouseInside := IsCursorOnScreen();
  LResult.MouseX := int32(Round(LMouse.x * LPixels));
  LResult.MouseY := int32(Round(LMouse.y * LPixels));
  return LResult;
end;

// raylib's input this frame into the Raven window of slot AIndex
func DoFeed(const AIndex: int32; const AWindow: Rid; const ALayout: RavenLayout);
var
  LMods: Ruint;
  LKey: int32;
  LButton: int32;
  LHeld: bool;
  LFocused: bool;
  LWheel: Vector2;
  LCodepoint: int32;
begin
  LMods := DoModifiers();

  LFocused := IsWindowFocused();
  if LFocused <> GWindows[AIndex].Focused then
    Rhost_inject_focus(AWindow, DoRavenBool(LFocused));
    GWindows[AIndex].Focused := LFocused;
  end;

  for LKey := 0 to ADAM_RAVEN_RAYLIB_KEY_COUNT - 1 do
    if IsKeyPressed(ADAM_RAVEN_RAYLIB_KEYS[LKey].RaylibKey) then
      Rhost_inject_key(AWindow, ADAM_RAVEN_RAYLIB_KEYS[LKey].RavenKey, R_TRUE, LMods, R_FALSE);
    else
      if IsKeyPressedRepeat(ADAM_RAVEN_RAYLIB_KEYS[LKey].RaylibKey) then
        Rhost_inject_key(AWindow, ADAM_RAVEN_RAYLIB_KEYS[LKey].RavenKey, R_TRUE, LMods, R_TRUE);
      end;
    end;
    if IsKeyReleased(ADAM_RAVEN_RAYLIB_KEYS[LKey].RaylibKey) then
      Rhost_inject_key(AWindow, ADAM_RAVEN_RAYLIB_KEYS[LKey].RavenKey, R_FALSE, LMods, R_FALSE);
    end;
  end;

  // A held button keeps the mouse Raven's past the window's edge (a drag), so its release
  // reaches the widget that took the press
  LHeld := false;
  for LButton := 0 to ADAM_RAVEN_RAYLIB_BUTTON_COUNT - 1 do
    if IsMouseButtonDown(ADAM_RAVEN_RAYLIB_BUTTONS[LButton]) then
      LHeld := true;
    end;
  end;
  if ALayout.MouseInside or LHeld then
    if (not GWindows[AIndex].MouseInside) or (ALayout.MouseX <> GWindows[AIndex].MouseX) or
      (ALayout.MouseY <> GWindows[AIndex].MouseY) then
      Rhost_inject_mouse_move(AWindow, ALayout.MouseX, ALayout.MouseY, LMods);
    end;
    GWindows[AIndex].MouseInside := true;
    GWindows[AIndex].MouseX := ALayout.MouseX;
    GWindows[AIndex].MouseY := ALayout.MouseY;
  end;
  for LButton := 0 to ADAM_RAVEN_RAYLIB_BUTTON_COUNT - 1 do
    // A press outside (the frame's bars, beside the window) is not Raven's
    if IsMouseButtonPressed(ADAM_RAVEN_RAYLIB_BUTTONS[LButton]) and ALayout.MouseInside then
      Rhost_inject_mouse_button(AWindow, ALayout.MouseX, ALayout.MouseY,
        ADAM_RAVEN_RAYLIB_TARGETS[LButton], R_TRUE, LMods);
    end;
    if IsMouseButtonReleased(ADAM_RAVEN_RAYLIB_BUTTONS[LButton]) and GWindows[AIndex].MouseInside then
      Rhost_inject_mouse_button(AWindow, ALayout.MouseX, ALayout.MouseY,
        ADAM_RAVEN_RAYLIB_TARGETS[LButton], R_FALSE, LMods);
    end;
  end;
  if (not ALayout.MouseInside) and (not LHeld) and GWindows[AIndex].MouseInside then
    Rhost_inject_mouse_leave(AWindow);
    GWindows[AIndex].MouseInside := false;
  end;

  LWheel := GetMouseWheelMoveV();
  if ALayout.MouseInside and ((LWheel.x <> 0.0f) or (LWheel.y <> 0.0f)) then
    Rhost_inject_mouse_wheel(AWindow, LWheel.x, LWheel.y, LMods);
  end;

  LCodepoint := GetCharPressed();
  while LCodepoint <> 0 do
    Rhost_inject_text(AWindow, uint32(LCodepoint));
    LCodepoint := GetCharPressed();
  end;
end;

// ---- drawing ----

// raymath's MatrixMultiply (this unit's own: raymath is header-only and not imported)
func DoMatrixMultiply(const ALeft: Matrix; const ARight: Matrix): Matrix;
var
  LResult: Matrix;
begin
  LResult.m0 := ALeft.m0 * ARight.m0 + ALeft.m1 * ARight.m4 + ALeft.m2 * ARight.m8 + ALeft.m3 * ARight.m12;
  LResult.m1 := ALeft.m0 * ARight.m1 + ALeft.m1 * ARight.m5 + ALeft.m2 * ARight.m9 + ALeft.m3 * ARight.m13;
  LResult.m2 := ALeft.m0 * ARight.m2 + ALeft.m1 * ARight.m6 + ALeft.m2 * ARight.m10 + ALeft.m3 * ARight.m14;
  LResult.m3 := ALeft.m0 * ARight.m3 + ALeft.m1 * ARight.m7 + ALeft.m2 * ARight.m11 + ALeft.m3 * ARight.m15;
  LResult.m4 := ALeft.m4 * ARight.m0 + ALeft.m5 * ARight.m4 + ALeft.m6 * ARight.m8 + ALeft.m7 * ARight.m12;
  LResult.m5 := ALeft.m4 * ARight.m1 + ALeft.m5 * ARight.m5 + ALeft.m6 * ARight.m9 + ALeft.m7 * ARight.m13;
  LResult.m6 := ALeft.m4 * ARight.m2 + ALeft.m5 * ARight.m6 + ALeft.m6 * ARight.m10 + ALeft.m7 * ARight.m14;
  LResult.m7 := ALeft.m4 * ARight.m3 + ALeft.m5 * ARight.m7 + ALeft.m6 * ARight.m11 + ALeft.m7 * ARight.m15;
  LResult.m8 := ALeft.m8 * ARight.m0 + ALeft.m9 * ARight.m4 + ALeft.m10 * ARight.m8 + ALeft.m11 * ARight.m12;
  LResult.m9 := ALeft.m8 * ARight.m1 + ALeft.m9 * ARight.m5 + ALeft.m10 * ARight.m9 + ALeft.m11 * ARight.m13;
  LResult.m10 := ALeft.m8 * ARight.m2 + ALeft.m9 * ARight.m6 + ALeft.m10 * ARight.m10 + ALeft.m11 * ARight.m14;
  LResult.m11 := ALeft.m8 * ARight.m3 + ALeft.m9 * ARight.m7 + ALeft.m10 * ARight.m11 + ALeft.m11 * ARight.m15;
  LResult.m12 := ALeft.m12 * ARight.m0 + ALeft.m13 * ARight.m4 + ALeft.m14 * ARight.m8 + ALeft.m15 * ARight.m12;
  LResult.m13 := ALeft.m12 * ARight.m1 + ALeft.m13 * ARight.m5 + ALeft.m14 * ARight.m9 + ALeft.m15 * ARight.m13;
  LResult.m14 := ALeft.m12 * ARight.m2 + ALeft.m13 * ARight.m6 + ALeft.m14 * ARight.m10 + ALeft.m15 * ARight.m14;
  LResult.m15 := ALeft.m12 * ARight.m3 + ALeft.m13 * ARight.m7 + ALeft.m14 * ARight.m11 + ALeft.m15 * ARight.m15;
  return LResult;
end;

// GL 3.3 has no base instance: each command points the attributes at its first instance, at
// RDrawInstance's offsets (raven_backend.h: rect 0, uv 16, clip 32, radii 48, color 64,
// border_color 68, border_width 72, flags 76)
func DoPointAttributes(const AFirst: Ruint);
var
  LStride: int32;
  LBase: int32;
begin
  LStride := int32(size(RDrawInstance));
  LBase := int32(AFirst) * LStride;
  rlSetVertexAttribute(0, 4, RL_FLOAT, false, LStride, LBase);
  rlSetVertexAttribute(1, 4, RL_FLOAT, false, LStride, LBase + 16);
  rlSetVertexAttribute(2, 4, RL_FLOAT, false, LStride, LBase + 32);
  rlSetVertexAttribute(3, 4, RL_FLOAT, false, LStride, LBase + 48);
  rlSetVertexAttribute(4, 4, RL_UNSIGNED_BYTE, true, LStride, LBase + 64);
  rlSetVertexAttribute(5, 4, RL_UNSIGNED_BYTE, true, LStride, LBase + 68);
  rlSetVertexAttribute(6, 1, RL_FLOAT, false, LStride, LBase + 72);
  rlSetVertexAttribute(7, 4, RL_UNSIGNED_BYTE, false, LStride, LBase + 76);
end;

// The GL texture a draw command samples: its Raven texture's, else rlgl's white one
func DoCommandTexture(const ATexture: Rid): uint32;
var
  LSlot: int64;
begin
  LSlot := DoFindTexture(ATexture, false);
  if (LSlot >= 0) and (ATexture <> 0) then
    if GTextures[LSlot].Gl <> 0 then
      return GTextures[LSlot].Gl;
    end;
  end;
  return rlGetTextureIdDefault();
end;

// The window's last draw list, with raylib's current transform and projection
func DoDraw(const AWindow: Rid);
var
  LIndex: int32;
  LBytes: int32;
  LAttribute: uint32;
  LCommand: int32;
  LMvp: Matrix;
  LUnit: float32;
  LSampler: int32;
begin
  LIndex := DoFindWindow(AWindow, false);
  if (LIndex < 0) or (GProgram = 0) then
    return;
  end;
  if GWindows[LIndex].InstanceCount = 0 then
    return;
  end;
  // raylib's own batch first: Raven draws over what the game drew
  rlDrawRenderBatchActive();
  // Premultiplied output (ONE, ONE_MINUS_SRC_ALPHA), set before any bind: rlSetBlendMode
  // flushes raylib's batch, which binds and then unbinds raylib's own shader and vertex array
  rlSetBlendFactors(RL_ONE, RL_ONE_MINUS_SRC_ALPHA, RL_FUNC_ADD);
  rlSetBlendMode(RL_BLEND_CUSTOM);
  if not rlEnableVertexArray(GVao) then
    // No vertex arrays (an OpenGL below 3.3): nothing this backend can draw
    rlSetBlendMode(RL_BLEND_ALPHA);
    return;
  end;

  LBytes := GWindows[LIndex].InstanceCount * int32(size(RDrawInstance));
  if LBytes > GVboSize then
    if GVbo <> 0 then
      rlUnloadVertexBuffer(GVbo);
    end;
    GVbo := rlLoadVertexBuffer(addr of GWindows[LIndex].Instances[0], LBytes, true);
    GVboSize := LBytes;
  else
    rlEnableVertexBuffer(GVbo);
    rlUpdateVertexBuffer(GVbo, addr of GWindows[LIndex].Instances[0], LBytes, 0);
  end;
  rlEnableVertexBuffer(GVbo);
  for LAttribute := 0 to ADAM_RAVEN_RAYLIB_ATTRIBUTES - 1 do
    rlEnableVertexAttribute(LAttribute);
    rlSetVertexAttributeDivisor(LAttribute, 1);
  end;

  LMvp := DoMatrixMultiply(DoMatrixMultiply(rlGetMatrixTransform(), rlGetMatrixModelview()),
    rlGetMatrixProjection());
  // Raven's framebuffer pixels -> raylib units
  LUnit := GWindows[LIndex].UnitsPerPixel;
  LSampler := 0;
  rlEnableShader(GProgram);
  rlSetUniformMatrix(GLocMvp, LMvp);
  rlSetUniform(GLocUnit, addr of LUnit, RL_SHADER_UNIFORM_FLOAT, 1);
  rlSetUniform(GLocTexture, addr of LSampler, RL_SHADER_UNIFORM_INT, 1);
  rlDisableBackfaceCulling();
  for LCommand := 0 to GWindows[LIndex].CommandCount - 1 do
    if ((GWindows[LIndex].Commands[LCommand].type_ = R_DRAW_INSTANCES) or
      (GWindows[LIndex].Commands[LCommand].type_ = R_DRAW_SHADER)) and
      (GWindows[LIndex].Commands[LCommand].instance_count > 0) then
      rlActiveTextureSlot(0);
      rlEnableTexture(DoCommandTexture(GWindows[LIndex].Commands[LCommand].texture));
      DoPointAttributes(GWindows[LIndex].Commands[LCommand].first_instance);
      rlDrawVertexArrayInstanced(0, ADAM_RAVEN_RAYLIB_QUAD_VERTICES,
        int32(GWindows[LIndex].Commands[LCommand].instance_count));
    end;
  end;
  rlEnableBackfaceCulling();
  rlSetBlendMode(RL_BLEND_ALPHA);
  rlDisableTexture();
  rlDisableShader();
  rlDisableVertexBuffer();
  rlDisableVertexArray();
end;

// A Raven texture whose slot draws raylib's GL texture AGl, not owned. Raven sizes a texture
// from its first pixels, so it is made at the raylib texture's size from transparent ones; the
// GL texture the backend made for them is swapped for raylib's at once (with the render
// thread off, Rtexture_create_from_pixels runs CreateTexture before it returns)
func DoLinkTexture(const AGl: uint32; const AWidth: int32; const AHeight: int32): Rid;
var
  LPixels: array of uint8;
  LTexture: Rid;
  LSlot: int64;
begin
  if (AGl = 0) or (AWidth <= 0) or (AHeight <= 0) or (Ris_initialized() = 0) then
    return R_INVALID_ID;
  end;
  setlength(LPixels, int64(AWidth) * int64(AHeight) * 4);
  LTexture := Rtexture_create_from_pixels(addr of LPixels[0], AWidth, AHeight);
  if LTexture = R_INVALID_ID then
    return R_INVALID_ID;
  end;
  LSlot := DoFindTexture(LTexture, false);
  if LSlot < 0 then
    Rtexture_destroy(LTexture);
    return R_INVALID_ID;
  end;
  if GTextures[LSlot].Gl = 0 then
    Rtexture_destroy(LTexture);
    return R_INVALID_ID;
  end;
  rlUnloadTexture(GTextures[LSlot].Gl);
  GTextures[LSlot].Gl := AGl;
  GTextures[LSlot].Owned := false;
  return LTexture;
end;

/// Starts Raven inside the raylib program, on this unit's rlgl backend and Raven's host
/// platform (no OS window of Raven's own, its render thread off). Call it once after
/// InitWindow or InitFrameWindow, then make the UI window with Rwindow_create (its size
/// follows raylib's window, so any size will do) and its widgets with System.Raven.C's API.
/// @param AAppName the application's name, as RInitDesc.app_name
/// @returns true when Raven is up; false when raylib has no window yet, Raven is already
///   running, or Raven could not start (its error callback says why)
/// @example `InitWindow(800, 450, "Game"); if not InitRaven("Game") then return; end;`
/// @see UpdateRaven
/// @since 0.1
public func cpplink InitRaven(const AAppName: ptr to const char): bool;
var
  LHost: RHostPlatformDesc;
  LDesc: RInitDesc;
begin
  if (not IsWindowReady()) or (Ris_initialized() <> 0) then
    return false;
  end;
  DoRegisterBackend();
  // wake stays nil: raylib's loop makes a frame each time round anyway
  LHost.set_cursor := DoHostSetCursor;
  LHost.clipboard_set := DoHostClipboardSet;
  LHost.clipboard_get := DoHostClipboardGet;
  Rhost_platform_register(addr of LHost);
  GCursor := R_CURSOR_ARROW;
  GCursorHidden := false;
  LDesc.backend := R_BACKEND_CUSTOM;
  LDesc.app_name := AAppName;
  LDesc.disable_render_thread := R_TRUE;
  if Rinit_ex(addr of LDesc) = 0 then
    Rhost_platform_register(nil);
    return false;
  end;
  return true;
end;

/// Runs one Raven frame for AWindow, before BeginDrawing: the window takes raylib's window
/// size in pixels (or the frame's base size inside the frame window) and its UI scale, then
/// raylib's input this frame (focus, keys with modifiers and repeats, mouse, wheel, typed
/// text), then Rdraw_frame lays out and paints what changed and runs Raven's callbacks, timers
/// and tasks. Raven's cursor and clipboard are raylib's as Raven asks for them.
/// @param AWindow the UI window (Rwindow_create's)
/// @returns false once Rquit was called, the last Raven window is closed, or Raven is not
///   running (InitRaven not called, CloseRaven called)
/// @example `while not WindowShouldClose() and UpdateRaven(LUi) do ... end;`
/// @see DrawRaven
/// @since 0.1
public func cpplink UpdateRaven(const AWindow: Rid): bool;
var
  LLayout: RavenLayout;
  LIndex: int32;
begin
  if Ris_initialized() = 0 then
    return false;
  end;
  if GetFrameWidth() > 0 then
    LLayout := DoFrameLayout();
  else
    LLayout := DoWindowLayout();
  end;
  Rhost_window_set_size(AWindow, LLayout.Width, LLayout.Height, LLayout.Scale);
  LIndex := DoFindWindow(AWindow, false);
  if LIndex >= 0 then
    GWindows[LIndex].UnitsPerPixel := LLayout.UnitsPerPixel;
    DoFeed(LIndex, AWindow, LLayout);
  end;
  return Rdraw_frame() <> 0;
end;

/// Draws AWindow's last Raven frame over what the program drew, inside BeginDrawing /
/// EndDrawing: in raylib's window units, or with the frame window open between BeginFrame and
/// EndFrame (base units, scaled and letterboxed with the frame). It draws through whatever
/// raylib has bound, so a render texture or a camera takes it too. Does nothing before the
/// window's first UpdateRaven or with Raven not running.
/// @param AWindow the UI window (Rwindow_create's)
/// @example `BeginDrawing(); ClearBackground(BLACK); DrawGame(); DrawRaven(LUi); EndDrawing();`
/// @see UpdateRaven
/// @since 0.1
public func cpplink DrawRaven(const AWindow: Rid);
begin
  DoDraw(AWindow);
end;

/// Makes a Raven texture that shows ATexture, a raylib texture (one the program loaded, or a
/// render texture's .texture). Raven draws raylib's texture as it is in every frame, so what
/// the program draws into a render texture shows at once in a Viewport
/// (Rviewport_set_texture; a render texture is bottom-up: Rviewport_set_flip_y(viewport,
/// R_TRUE)) or an Image. raylib keeps the texture: Raven never copies, updates, re-filters or
/// unloads it, and Rtexture_update on the Raven texture does nothing. Before the program
/// unloads ATexture, it points the Raven texture at its new one (SetRavenTexture) or destroys
/// it (Rtexture_destroy, which leaves raylib's texture alone).
/// @param ATexture the raylib texture to show
/// @returns the Raven texture; R_INVALID_ID when Raven is not running or ATexture is no
///   texture (id 0, a size of 0)
/// @example `LRaven := CreateRavenTexture(LTarget.texture); Rviewport_set_texture(LView, LRaven);`
/// @see SetRavenTexture
/// @since 0.1
public func cpplink CreateRavenTexture(const ATexture: Texture2D): Rid;
begin
  return DoLinkTexture(ATexture.id, ATexture.width, ATexture.height);
end;

/// Points a Raven texture made by CreateRavenTexture at another raylib texture: after a render
/// texture is made again at a new size, the Viewport or Image showing it keeps its Raven
/// texture.
/// @param ARavenTexture CreateRavenTexture's Raven texture
/// @param ATexture the raylib texture it shows from now on
/// @returns true when done; false when Raven is not running, ATexture is no texture (id 0), or
///   ARavenTexture is not a texture CreateRavenTexture made (one Raven made from its own
///   pixels is never re-pointed)
/// @example `LTarget := LoadRenderTexture(LWidth, LHeight); SetRavenTexture(LRaven, LTarget.texture);`
/// @see CreateRavenTexture
/// @since 0.1
public func cpplink SetRavenTexture(const ARavenTexture: Rid; const ATexture: Texture2D): bool;
var
  LSlot: int64;
begin
  if (ATexture.id = 0) or (Ris_initialized() = 0) then
    return false;
  end;
  if Rtexture_is_valid(ARavenTexture) = 0 then
    return false;
  end;
  LSlot := DoFindTexture(ARavenTexture, false);
  if LSlot < 0 then
    return false;
  end;
  if GTextures[LSlot].Owned then
    return false;
  end;
  GTextures[LSlot].Gl := ATexture.id;
  return true;
end;

/// Ends Raven (Rshutdown): its windows, widgets, textures and the backend's GL objects are
/// freed, and raylib's cursor is shown again in its default shape. Call it before CloseWindow;
/// InitRaven may start it again after. Does nothing with Raven not running.
/// @example `CloseRaven(); CloseWindow();`
/// @see InitRaven
/// @since 0.1
public func cpplink CloseRaven();
begin
  if Ris_initialized() = 0 then
    return;
  end;
  Rshutdown();
  // The next Rinit (another InitRaven, or a program's own) chooses its platform afresh
  Rhost_platform_register(nil);
  DoResetCursor();
end;

end.
