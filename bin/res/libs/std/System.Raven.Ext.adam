    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Switcher];
    end;

    /// Shows the child at `AIndex`. C: Rswitcher_set_index
    const method Index(const AIndex: int32): self;
    begin
      Rswitcher_set_index(self.FId, AIndex);
      return self;
