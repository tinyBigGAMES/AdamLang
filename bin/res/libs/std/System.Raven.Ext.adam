  /// A bar with a thumb to drag between a range's ends. C: Rslider_*
  UISlider = object(UIWidget)
    /// A new slider over 0 .. 1. C: Rwidget_create(R_WIDGET_SLIDER)
    static method Create(): UISlider;
    var
      LWidget: UISlider;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Slider)));
      return LWidget;
    end;

    /// The kind a slider views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Slider];
    end;

    /// The values at its ends. C: Rslider_set_range
    const method Range(const AMin: float32; const AMax: float32): self;
    begin
      Rslider_set_range(self.FId, AMin, AMax);
      return self;
    end;

    /// Its ends and its step. C: Rslider_get_range
    const method Range(): UIRange;
    var
      LMin: float32;
      LMax: float32;
      LStep: float32;
    begin
      Rslider_get_range(self.FId, addr of LMin, addr of LMax, addr of LStep);
      return UIRange(Min: float64(LMin), Max: float64(LMax), Step: float64(LStep));
    end;

    /// Moves the thumb to `AValue` (kept in the range). C: Rslider_set_value
