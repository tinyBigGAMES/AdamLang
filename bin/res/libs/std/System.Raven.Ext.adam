      return self;
    end;

    /// Tinted with the theme's text colour when `AOn` (follows light / dark). C: Rimage_set_tint_text
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method TintText(const AOn: bool): self;
    begin
      Rimage_set_tint_text(self.FId, DoCBool(AOn));
      return self;
    end;

    /// How the picture fits the widget (fill, fit, cover, none). C: Rimage_set_stretch
    /// @param AStretch the stretch
    /// @returns this object, so calls chain
    const method Stretch(const AStretch: UIStretch): self;
    begin
      Rimage_set_stretch(self.FId, int32(AStretch));
      return self;
    end;

    /// The part of the texture shown, as texture coordinates (0 .. 1) of its corners.
    /// C: Rimage_set_region
    /// @param AUVMin the lowest texture coordinates (0 .. 1)
    /// @param AUVMax the highest texture coordinates (0 .. 1)
    /// @returns this object, so calls chain
    const method Region(const AUVMin: UIPoint; const AUVMax: UIPoint): self;
    begin
      Rimage_set_region(self.FId, AUVMin.x, AUVMin.y, AUVMax.x, AUVMax.y);
      return self;
    end;

    /// The picture's corners rounded by `ARadius`. C: Rimage_set_corner_radius
    /// @param ARadius the radius
    /// @returns this object, so calls chain
    const method CornerRadius(const ARadius: float32): self;
    begin
      Rimage_set_corner_radius(self.FId, ARadius);
      return self;
    end;

    /// The texture it shows (an empty handle: nothing); kept while it is set.
    /// C: Rimage_set_texture
    /// @param ATexture the texture
    /// @returns this object, so calls chain
    const method Texture(const ATexture: UITextureRes): self;
    begin
      Rimage_set_texture(self.FId, ATexture.Id());
      DoHookDestroy(self.FId);
      DoKeepTexture(self.FId, ADAM_RAVEN_KEEP_TEXTURE, ATexture);
      return self;
    end;
  end;

  /// A one-line text field. Its text is the base's `Text`. C: Rtext_input_*
  /// @example `UITextInput.Create().Placeholder("Search").OnCommit(func(const S: string) begin Find(S); end);`
  UITextInput = object(UIWidget)
    /// A new, empty text field. C: Rwidget_create(R_WIDGET_TEXT_INPUT)
