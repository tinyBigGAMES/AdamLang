      LPoint: UIPoint;
    begin
      Rscroll_box_get_offset(self.FId, addr of LPoint.x, addr of LPoint.y);
      return LPoint;
    end;

    /// Scrolls to the child's end (a log's last line). C: Rscroll_box_scroll_to_end
    const method ScrollToEnd(): self;
    begin
      Rscroll_box_scroll_to_end(self.FId);
      return self;
    end;
