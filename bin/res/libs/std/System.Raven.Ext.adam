    begin
      Rtext_input_set_placeholder(self.FId, AText);
      return self;
    end;

    /// The text hidden behind dots when `AOn`. C: Rtext_input_set_password
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method Password(const AOn: bool): self;
    begin
      Rtext_input_set_password(self.FId, DoCBool(AOn));
      return self;
    end;

    /// What `Password(..)` sets, read back. C: Rtext_input_is_password
    /// @returns `true` when `Password(..)` turned it on
    const method Password(): bool;
    begin
      return Rtext_input_is_password(self.FId) <> 0;
    end;

    /// The text shown and selectable but not editable when `AOn`. C: Rtext_input_set_read_only
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
