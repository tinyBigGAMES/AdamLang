  /// A bar with a thumb to drag between a range's ends. C: Rslider_*
  UISlider = object(UIWidget)
    /// A new slider over 0 .. 1. C: Rwidget_create(R_WIDGET_SLIDER)
    /// @returns a new slider over 0 .
    static method Create(): UISlider;
