      return LWidget;
    end;

    /// The kind a size box views.
    /// @returns the kind a size box views
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.SizeBox];
    end;

    /// The child's width over its height (0: no ratio kept). C: Rsize_box_set_aspect_ratio
    /// @param ARatio the ratio
    /// @returns this object, so calls chain
    const method AspectRatio(const ARatio: float32): self;
    begin
      Rsize_box_set_aspect_ratio(self.FId, ARatio);
      return self;
    end;
  end;

