    /// @param AMin the lowest value
    /// @param AMax the highest value
    /// @returns this object, so calls chain
    const method Range(const AMin: float32; const AMax: float32): self;
    begin
      Rslider_set_range(self.FId, AMin, AMax);
      return self;
    end;

    /// Its ends and its step. C: Rslider_get_range
    /// @returns its ends and its step
    const method Range(): UIRange;
    var
      LMin: float32;
      LMax: float32;
      LStep: float32;
    begin
      Rslider_get_range(self.FId, addr of LMin, addr of LMax, addr of LStep);
      return UIRange(Min: float64(LMin), Max: float64(LMax), Step: float64(LStep));
    end;

    /// Moves the thumb to `AValue` (kept in the range). C: Rslider_set_value
    /// @param AValue the value
