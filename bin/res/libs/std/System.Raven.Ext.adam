    ScrollBar,     /// A scroll bar. C: R_ROLE_SCROLL_BAR
    Pane);         /// A pane. C: R_ROLE_PANE

// ============================================================================
// Value types (listing sec 2): Raven's float colours, points, sizes and
// rectangles as plain records, given their methods and operators by `extend`.
// ============================================================================

public forward type UITimerRes;
public forward type UITab;

public type
  /// A colour as Raven draws it: red, green, blue and alpha, each from 0 to 1 (Raven runs on
  /// its own, so it keeps its own float colour rather than raylib's bytes).
  /// @example `LAccent := UIColor.FromHex("#3a7bd5", UIColor.Black()).WithAlpha(0.8f);`
  UIColor = record
    r: float32; /// Red, 0 .. 1.
    g: float32; /// Green, 0 .. 1.
    b: float32; /// Blue, 0 .. 1.
    a: float32; /// Alpha (opacity), 0 .. 1.
  end;

  /// A point in logical units (Raven's coordinates: x to the right, y down).
  UIPoint = record
    x: float32; /// The distance to the right.
    y: float32; /// The distance down.
  end;

  /// A size in logical units.
  UISize = record
    w: float32; /// The width.
    h: float32; /// The height.
  end;

  /// A rectangle in logical units: its top-left corner and its size.
  UIRect = record
    x: float32; /// The left edge.
    y: float32; /// The top edge.
    w: float32; /// The width.
    h: float32; /// The height.
  end;

  /// A range a slider or a spin box reads back: its lowest and highest values and its step.
  UIRange = record
    Min: float64; /// The lowest value.
    Max: float64; /// The highest value.
    Step: float64; /// The step between values.
  end;

  /// A date a date picker reads back (Month 1 .. 12, Day 1 .. 31).
  UIDate = record
    Year: int32; /// The year.
    Month: int32; /// The month, 1 .. 12.
    Day: int32; /// The day of the month, 1 .. 31.
  end;

  /// A time a time picker reads back (Hour 0 .. 23).
  UITime = record
    Hour: int32; /// The hour, 0 .. 23.
    Minute: int32; /// The minute, 0 .. 59.
    Second: int32; /// The second, 0 .. 59.
  end;

  /// A colour as hue (0 .. 360), saturation and value (0 .. 1), as a colour picker reads it back.
  UIHSV = record
    h: float32; /// The hue, 0 .. 360.
    s: float32; /// The saturation, 0 .. 1.
    v: float32; /// The value (brightness), 0 .. 1.
  end;

  /// One task of a taskbar jump list (`UIApp.JumpList`): its title, the command-line
  /// arguments the program starts with when it is picked, and its tooltip.
  UIJumpTask = record
    Title: string; /// The text the task shows in the jump list.
    Args: string; /// The command-line arguments the program starts with when the task is picked.
    Description: string; /// The task's tooltip.
  end;

  /// An error Raven reported (`UIErrors.Last`): its code, its severity and Raven's detail.
  UIRavenError = record
    Code: UIErrorCode; /// What went wrong.
    Severity: UISeverity; /// How serious it is.
    Detail: string; /// Raven's text about it.
  end;

  /// What `UIApp.OnFrame` runs each frame: the seconds since the frame before.
  UIFrameFunc = ref func(const ADelta: float64);
  /// What `UIApp.OnAppEvent` runs on a life-cycle event.
  UIAppEventFunc = ref func(const AEvent: UIAppEvent);
  /// A routine with no arguments: a posted task (`UIApp.Post`), `UIApp.OnDeviceReset`,
  /// `UIApp.OnNotifyClicked`.
  UITaskFunc = ref func();
  /// What `UIApp.NotifyFallback` runs for a notification the system cannot show: its
  /// title, body and urgency.
  UINotifyFunc = ref func(const ATitle: string; const ABody: string; const AUrgency: UIUrgency);
  /// What `UIErrors.OnError` runs for each error Raven reports: its code, severity and
  /// detail.
  UIErrorFunc = ref func(const ACode: UIErrorCode; const ASeverity: UISeverity; const ADetail: string);
  /// What a timer runs each time it fires (`UITimerRes`): the timer.
  UITimerFunc = ref func(const ATimer: UITimerRes);
  /// What `UIWidget.OnEvent` runs for each input event the widget gets: `true` when it
  /// handled the event.
  UIEventFunc = ref func(const AEvent: REvent): bool;
  /// What `UIWidget.OnDrop` runs at each stage of a drag and drop over the widget: `true`
  /// when the widget takes the drop.
  UIDropFunc = ref func(const AEvent: RDropEvent): bool;
  /// What `UIWidget.OnTouch` runs for each touch on the widget: `true` when it handled it.
  UITouchFunc = ref func(const AEvent: RTouchEvent): bool;
  /// What `UIWidget.OnPen` runs for each pen event on the widget: `true` when it handled it.
  UIPenFunc = ref func(const AEvent: RPenEvent): bool;
  /// What `UIWidget.OnGesture` runs for each gesture on the widget: `true` when it handled it.
  UIGestureFunc = ref func(const AEvent: RGestureEvent): bool;
  /// What `UIWindow.OnBack` / `OnClose` run: `true` when the back is handled / the window
  /// may close.
  UIAskFunc = ref func(): bool;
  /// What `UIWindow.OnKeyboard` runs when the on-screen keyboard shows or hides: shown, and
  /// the height it covers.
  UIKeyboardFunc = ref func(const AVisible: bool; const AHeight: float32);
  /// What `UIWindow.OnResize` runs: the window's new size in logical units.
  UIResizeFunc = ref func(const AWidth: int32; const AHeight: int32);
  /// What a popup's or dialog's `AOnClosed` runs once when it closes: its result.
  UIClosedFunc = ref func(const AResult: int32);
  /// A control's on / off closure: a check box's checked state, an expander's expanded one.
  UIToggleFunc = ref func(const AOn: bool);
  /// A control's index closure: the tab, item or page chosen.
  UIIndexFunc = ref func(const AIndex: int32);
  /// A control's value closure: a slider's or a rating's value.
  UIValueFunc = ref func(const AValue: float32);
  /// A spin box's value closure.
  UIValue64Func = ref func(const AValue: float64);
  /// A control's text closure: a text input's text, a label link's URL.
  UITextFunc = ref func(const AText: string);
  /// A date picker's closure: the date chosen.
  UIDateFunc = ref func(const AYear: int32; const AMonth: int32; const ADay: int32);
  /// A time picker's closure: the time chosen.
  UITimeFunc = ref func(const AHour: int32; const AMinute: int32; const ASecond: int32);
  /// A colour picker's closure: the colour chosen.
  UIColorFunc = ref func(const AColor: UIColor);
  /// A tab view's close closure: the tab whose close button was pressed; `true` lets Raven
  /// delete its page, `false` keeps it (the program may ask, then destroy the page itself).
  UITabCloseFunc = ref func(const ATab: UITab): bool;

// The byte (0..255) nearest the channel AValue (0..1, clamped)
func DoColorByte(const AValue: float32): uint32;
begin
  if AValue <= 0.0f then
    return 0;
  end;
  if AValue >= 1.0f then
    return 255;
  end;
  return uint32(AValue * 255.0f + 0.5f);
end;

// Raven's int32 truth value of AOn (R_TRUE / R_FALSE)
func DoCBool(const AOn: bool): int32;
begin
  if AOn then
    return R_TRUE;
  end;
  return R_FALSE;
end;

// The C text ARavenText (Raven's, nil for none) as a string ("" for nil)
func DoRavenText(const ARavenText: ptr to const char): string;
begin
  if ARavenText = nil then
    return "";
  end;
  return StringFromC(ARavenText);
end;

// Colours: made from bytes, hex text or hue / saturation / value, and read back.
public extend UIColor
  /// Opaque white (1, 1, 1, 1).
  /// @returns the new `UIColor`
  static method White(): UIColor;
  begin
    return UIColor(r: 1.0f, g: 1.0f, b: 1.0f, a: 1.0f);
  end;

  /// Opaque black (0, 0, 0, 1).
  /// @returns the new `UIColor`
  static method Black(): UIColor;
  begin
    return UIColor(r: 0.0f, g: 0.0f, b: 0.0f, a: 1.0f);
  end;

  /// Fully transparent black (0, 0, 0, 0).
  /// @returns the new `UIColor`
  static method Transparent(): UIColor;
  begin
    return UIColor(r: 0.0f, g: 0.0f, b: 0.0f, a: 0.0f);
  end;

  /// The opaque colour of the bytes `AR`, `AG`, `AB` (0..255 each).
  /// @param AR the red byte
  /// @param AG the green byte
  /// @param AB the blue byte
  /// @returns the opaque colour of the bytes `AR`, `AG`, `AB` (0..255 each)
  /// @example `UIColor.FromRGBA(58, 123, 213)`
  static method FromRGBA(const AR: uint8; const AG: uint8; const AB: uint8): UIColor;
  begin
    return UIColor.FromRGBA(AR, AG, AB, 255);
  end;

  /// The colour of the bytes `AR`, `AG`, `AB`, `AA` (0..255 each).
  /// @param AR the red byte
  /// @param AG the green byte
  /// @param AB the blue byte
  /// @param AA the alpha byte
  /// @returns the colour of the bytes `AR`, `AG`, `AB`, `AA` (0..255 each)
  static method FromRGBA(const AR: uint8; const AG: uint8; const AB: uint8; const AA: uint8): UIColor;
  begin
    return UIColor(r: float32(AR) / 255.0f, g: float32(AG) / 255.0f, b: float32(AB) / 255.0f,
      a: float32(AA) / 255.0f);
  end;

  /// The colour the hex text `AText` names (`#RGB`, `#RGBA`, `#RRGGBB`, `#RRGGBBAA`, the `#`
  /// optional: `TryHexToRGBA`), or `ADefault` for any other text.
  /// @param AText the text
  /// @param ADefault the default
  /// @returns the colour the hex text `AText` names (`#RGB`, `#RGBA`, `#RRGGBB`, `#RRGGBBAA`, the
  ///   `#` optional: `TryHexToRGBA`), or `ADefault` for any other text
  /// @example `UIColor.FromHex("#3a7bd5", UIColor.Black())`
  static method FromHex(const AText: string; const ADefault: UIColor): UIColor;
  var
    LRGBA: uint32;
  begin
    if not TryHexToRGBA(AText, LRGBA) then
      return ADefault;
    end;
    return UIColor.FromRGBA(uint8(LRGBA shr 24), uint8((LRGBA shr 16) & 255), uint8((LRGBA shr 8) & 255),
      uint8(LRGBA & 255));
  end;

  /// The opaque colour of hue `AH` (0..360), saturation `AS` and value `AV` (0..1). C:
  /// Rcolor_hsv_to_rgb
  /// @param AH the hue, in degrees (0 to 360)
  /// @param AS the saturation, 0 to 1
  /// @param AV the value (brightness), 0 to 1
  /// @returns the opaque colour of hue `AH` (0..360), saturation `AS` and value `AV` (0..1)
  static method FromHSV(const AH: float32; const AS: float32; const AV: float32): UIColor;
  begin
    return UIColor.FromHSV(AH, AS, AV, 1.0f);
  end;

  /// The colour of hue `AH` (0..360), saturation `AS`, value `AV` and alpha `AA` (0..1). C:
  /// Rcolor_hsv_to_rgb
  /// @param AH the hue, in degrees (0 to 360)
  /// @param AS the saturation, 0 to 1
  /// @param AV the value (brightness), 0 to 1
  /// @param AA the alpha (0..1)
  /// @returns the colour of hue `AH` (0..360), saturation `AS`, value `AV` and alpha `AA` (0..1)
  static method FromHSV(const AH: float32; const AS: float32; const AV: float32; const AA: float32): UIColor;
  var
    LColor: UIColor;
  begin
    Rcolor_hsv_to_rgb(AH, AS, AV, addr of LColor.r, addr of LColor.g, addr of LColor.b);
    LColor.a := AA;
    return LColor;
  end;

  /// The colour's hue (0..360), saturation and value (0..1). C: Rcolor_rgb_to_hsv
  /// @param AH the hue, in degrees (0 to 360)
  /// @param AS the saturation, 0 to 1
  /// @param AV the value (brightness), 0 to 1
  const method ToHSV(var AH: float32; var AS: float32; var AV: float32);
  begin
    Rcolor_rgb_to_hsv(self.r, self.g, self.b, addr of AH, addr of AS, addr of AV);
  end;

  /// The colour as hex text, uppercase: `#RRGGBB` when it is opaque, else `#RRGGBBAA`
  /// (each channel rounded to its nearest byte; `FromHex` reads it back).
  /// @returns the colour as hex text, uppercase: `#RRGGBB` when it is opaque, else `#RRGGBBAA`
  ///   (each channel rounded to its nearest byte; `FromHex` reads it back)
  const method Hex(): string;
  var
    LRGBA: uint32;
  begin
    LRGBA := (DoColorByte(self.r) shl 24) | (DoColorByte(self.g) shl 16) | (DoColorByte(self.b) shl 8) |
      DoColorByte(self.a);
    return RGBAToHex(LRGBA, (LRGBA & 255) <> 255);
  end;

  /// The colour with its alpha set to `AA` (0..1).
  /// @param AA the new alpha (0..1)
  /// @returns the colour with its alpha set to `AA` (0..1)
  const method WithAlpha(const AA: float32): UIColor;
  begin
    return UIColor(r: self.r, g: self.g, b: self.b, a: AA);
  end;

  /// The colour `AT` of the way from this one to `AB` (0: this one, 1: `AB`), each channel
  /// mixed in a straight line.
  /// @param AB the colour it mixes towards
  /// @param AT how far along, 0 to 1
  /// @returns the colour `AT` of the way from this one to `AB` (0: this one, 1: `AB`), each channel
  ///   mixed in a straight line
  const method Lerp(const AB: UIColor; const AT: float32): UIColor;
  begin
    return UIColor(r: self.r + (AB.r - self.r) * AT, g: self.g + (AB.g - self.g) * AT,
      b: self.b + (AB.b - self.b) * AT, a: self.a + (AB.a - self.a) * AT);
  end;

  /// The same colour: every channel equal.
  /// @param A the left operand
  /// @param B the right operand
  /// @returns `true` when every channel is equal
  operator =(const A: UIColor; const B: UIColor): bool;
  begin
    return (A.r = B.r) and (A.g = B.g) and (A.b = B.b) and (A.a = B.a);
  end;
end;

// Points: moved, scaled and compared.
public extend UIPoint
  /// The sum of two points (a point moved by an offset).
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the sum of two points (a point moved by an offset)
  operator +(const A: UIPoint; const B: UIPoint): UIPoint;
  begin
    return UIPoint(x: A.x + B.x, y: A.y + B.y);
  end;

  /// The offset from `B` to `A`.
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the offset from `B` to `A`
  operator -(const A: UIPoint; const B: UIPoint): UIPoint;
  begin
    return UIPoint(x: A.x - B.x, y: A.y - B.y);
  end;

  /// The point scaled by `S`.
  /// @param A the left operand
  /// @param S the right operand
  /// @returns the point scaled by `S`
  operator *(const A: UIPoint; const S: float32): UIPoint;
  begin
    return UIPoint(x: A.x * S, y: A.y * S);
  end;

  /// The same point.
  /// @param A the left operand
  /// @param B the right operand
  /// @returns `true` when both coordinates are equal
  operator =(const A: UIPoint; const B: UIPoint): bool;
  begin
    return (A.x = B.x) and (A.y = B.y);
  end;
end;

// Rectangles: hit tests and their centre.
public extend UIRect
  /// `true` when `AP` lies inside the rectangle (its left and top edges in, its right and
  /// bottom edges out).
  /// @param AP the point tested
  /// @returns `true` when `AP` lies inside the rectangle (its left and top edges in, its right and
  ///   bottom edges out)
  const method Contains(const AP: UIPoint): bool;
  begin
    return (AP.x >= self.x) and (AP.y >= self.y) and (AP.x < self.x + self.w) and (AP.y < self.y + self.h);
  end;

  /// The rectangle's centre.
  /// @returns the rectangle's centre
  const method Center(): UIPoint;
  begin
    return UIPoint(x: self.x + self.w * 0.5f, y: self.y + self.h * 0.5f);
  end;
end;

// ============================================================================
// Typed reads of Raven's event and info records (listing sec 2): the records
// keep their .C names and fields; these give their int32 / flag / C-text
// fields as Adam's choices, sets, bools and strings. The reads that name a
// widget (a drop's source, a touch's target) come with UIWidget (V2).
// ============================================================================

// A widget input event (`REvent`): typed reads of its fields.
public extend REvent
  /// The event's kind.
  /// @returns the event's kind
  const method Kind(): UIEventKind;
  begin
    return UIEventKind(self.type_);
  end;

  /// Where it happened, in the window's logical units.
  /// @returns where it happened, in the window's logical units
  const method Position(): UIPoint;
  begin
    return UIPoint(x: self.x, y: self.y);
  end;

  /// Where it happened, in the widget's own logical units.
  /// @returns where it happened, in the widget's own logical units
  const method Local(): UIPoint;
  begin
    return UIPoint(x: self.local_x, y: self.local_y);
  end;

  /// How far the pointer moved since the event before.
  /// @returns how far the pointer moved since the event before
  const method Delta(): UIPoint;
  begin
    return UIPoint(x: self.delta_x, y: self.delta_y);
  end;

  /// How far the wheel turned (y: up / down, x: left / right).
  /// @returns how far the wheel turned (y: up / down, x: left / right)
  const method Wheel(): UIPoint;
  begin
    return UIPoint(x: self.wheel_x, y: self.wheel_y);
  end;

  /// The mouse button of a button event.
  /// @returns the mouse button of a button event
  const method Button(): UIPointerButton;
  begin
    return UIPointerButton(self.button);
  end;

  /// The key of a key event.
  /// @returns the key of a key event
  const method Key(): UIKey;
  begin
    return UIKey(self.key);
  end;

  /// The modifier keys held.
  /// @returns the modifier keys held
  const method Mods(): UIModifiers;
  begin
    return UIModifiers(self.modifiers);
  end;

  /// `true` for a key event the key's auto-repeat made.
  /// @returns `true` for a key event the key's auto-repeat made
  const method Repeat(): bool;
  begin
    return self.repeat_ <> 0;
  end;

  /// The character a text event typed, as a string ("" for no character).
  /// @returns the character a text event typed, as a string ("" for no character)
  const method Char(): string;
  var
    LCodes: CodepointArray;
  begin
    if self.codepoint = 0 then
      return "";
    end;
    setlength(LCodes, 1);
    LCodes[0] := self.codepoint;
    return StringFromCodepoints(LCodes);
  end;

  /// `true` when the wheel's amounts are precise (a trackpad's), not whole notches.
  /// @returns `true` when the wheel's amounts are precise (a trackpad's), not whole notches
  const method Precise(): bool;
  begin
    return self.wheel_precise <> 0;
  end;
end;

// A drag and drop over a widget (`RDropEvent`): typed reads of its fields.
public extend RDropEvent
  /// The drop's stage.
  /// @returns the drop's stage
  const method Phase(): UIDropPhase;
  begin
    return UIDropPhase(self.phase);
  end;

  /// Where the pointer is, in the window's logical units.
  /// @returns where the pointer is, in the window's logical units
  const method Position(): UIPoint;
  begin
    return UIPoint(x: self.x, y: self.y);
  end;

  /// Where the pointer is, in the widget's own logical units.
  /// @returns where the pointer is, in the widget's own logical units
  const method Local(): UIPoint;
  begin
    return UIPoint(x: self.local_x, y: self.local_y);
  end;

  /// The files dropped (none for a text drop).
  /// @returns the files dropped (none for a text drop)
  const method Paths(): array of string;
  var
    LPaths: array of string;
    LI: int64;
  begin
    if (self.paths = nil) or (self.path_count <= 0) then
      return LPaths;
    end;
    setlength(LPaths, int64(self.path_count));
    for LI := 0 to len(LPaths) - 1 do
      LPaths[LI] := DoRavenText(self.paths[LI]);
    end;
    return LPaths;
  end;

  /// The text dropped ("" for none).
  /// @returns the text dropped ("" for none)
  const method Text(): string;
  begin
    return DoRavenText(self.text);
  end;

  /// The type a drag inside the program named ("" for none).
  /// @returns the type a drag inside the program named ("" for none)
  const method DragType(): string;
  begin
    return DoRavenText(self.drag_type);
  end;
end;

// A touch (`RTouchEvent`): typed reads of its fields.
public extend RTouchEvent
  /// The touch's stage.
  /// @returns the touch's stage
  const method Phase(): UITouchPhase;
  begin
    return UITouchPhase(self.phase);
  end;

  /// Where the finger is, in the window's logical units.
  /// @returns where the finger is, in the window's logical units
  const method Position(): UIPoint;
  begin
    return UIPoint(x: self.x, y: self.y);
  end;

  /// Where the finger is, in the widget's own logical units.
  /// @returns where the finger is, in the widget's own logical units
  const method Local(): UIPoint;
  begin
    return UIPoint(x: self.local_x, y: self.local_y);
  end;

  /// The modifier keys held.
  /// @returns the modifier keys held
  const method Mods(): UIModifiers;
  begin
    return UIModifiers(self.modifiers);
  end;
end;

// A pen (stylus) input (`RPenEvent`): typed reads of its fields.
public extend RPenEvent
  /// The input's stage.
  /// @returns the input's stage
  const method Phase(): UIPenPhase;
  begin
    return UIPenPhase(self.phase);
  end;

  /// Where the pen is, in the window's logical units.
  /// @returns where the pen is, in the window's logical units
  const method Position(): UIPoint;
  begin
    return UIPoint(x: self.x, y: self.y);
  end;

  /// Where the pen is, in the widget's own logical units.
  /// @returns where the pen is, in the widget's own logical units
  const method Local(): UIPoint;
  begin
    return UIPoint(x: self.local_x, y: self.local_y);
  end;

  /// The pen's tilt (x and y, in degrees).
  /// @returns the pen's tilt (x and y, in degrees)
  const method Tilt(): UIPoint;
  begin
    return UIPoint(x: self.tilt_x, y: self.tilt_y);
  end;

  /// `true` when the pen's eraser end is used.
  /// @returns `true` when the pen's eraser end is used
  const method Eraser(): bool;
  begin
    return self.eraser <> 0;
  end;

  /// The barrel buttons held.
  /// @returns the barrel buttons held
  const method Buttons(): UIPenButtons;
  begin
    return UIPenButtons(self.buttons);
  end;

  /// The modifier keys held.
  /// @returns the modifier keys held
  const method Mods(): UIModifiers;
  begin
    return UIModifiers(self.modifiers);
  end;
end;

// A gesture (`RGestureEvent`): typed reads of its fields.
public extend RGestureEvent
  /// The gesture's stage.
  /// @returns the gesture's stage
  const method Phase(): UIGesturePhase;
  begin
    return UIGesturePhase(self.phase);
  end;

  /// The gesture's kind.
  /// @returns the gesture's kind
  const method Kind(): UIGestureKind;
  begin
    return UIGestureKind(self.kind);
  end;

  /// The device it comes from.
  /// @returns the device it comes from
  const method Device(): UIGestureDevice;
  begin
    return UIGestureDevice(self.device);
  end;

  /// Where it is, in the window's logical units.
  /// @returns where it is, in the window's logical units
  const method Position(): UIPoint;
  begin
    return UIPoint(x: self.x, y: self.y);
  end;

  /// Where it is, in the widget's own logical units.
  /// @returns where it is, in the widget's own logical units
  const method Local(): UIPoint;
  begin
    return UIPoint(x: self.local_x, y: self.local_y);
  end;

  /// How far it panned since the event before.
  /// @returns how far it panned since the event before
  const method Pan(): UIPoint;
  begin
    return UIPoint(x: self.pan_x, y: self.pan_y);
  end;

  /// How far it panned since it began.
  /// @returns how far it panned since it began
  const method Total(): UIPoint;
  begin
    return UIPoint(x: self.total_x, y: self.total_y);
  end;

  /// `true` when the system cancelled it.
  /// @returns `true` when the system cancelled it
  const method Cancelled(): bool;
  begin
    return self.cancelled <> 0;
  end;
end;

// A text input's keyboard settings (`RTextInputInfo`): typed reads of its fields.
public extend RTextInputInfo
  /// The kind of text it takes.
  /// @returns the kind of text it takes
  const method Kind(): UIInputType;
  begin
    return UIInputType(self.type_);
  end;

  /// The label of the on-screen keyboard's return key.
  /// @returns the label of the on-screen keyboard's return key
  const method ReturnKey(): UIReturnKey;
  begin
    return UIReturnKey(self.return_key);
  end;

  /// `true` for a password input (its text hidden).
  /// @returns `true` for a password input (its text hidden)
  const method Password(): bool;
  begin
    return self.password <> 0;
  end;

  /// `true` when its text cannot be edited.
  /// @returns `true` when its text cannot be edited
  const method ReadOnly(): bool;
  begin
    return self.read_only <> 0;
  end;
end;

// The system's accessibility settings (`RAccessibilitySettings`): typed reads of its fields.
public extend RAccessibilitySettings
  /// `true` when high contrast is on.
  /// @returns `true` when high contrast is on
  const method HighContrast(): bool;
  begin
    return self.high_contrast <> 0;
  end;

  /// `true` when the user asks for less motion.
  /// @returns `true` when the user asks for less motion
  const method ReduceMotion(): bool;
  begin
    return self.reduce_motion <> 0;
  end;

  /// `true` when a screen reader runs.
  /// @returns `true` when a screen reader runs
  const method ScreenReader(): bool;
  begin
    return self.screen_reader <> 0;
  end;
end;

// Touch and pen settings (`RTouchSettings`): typed reads of its on / off fields.
public extend RTouchSettings
  /// `true` when a touch also acts as the mouse.
  /// @returns `true` when a touch also acts as the mouse
  const method MouseEmulation(): bool;
  begin
    return self.mouse_emulation <> 0;
  end;

  /// `true` when a fling keeps scrolling.
  /// @returns `true` when a fling keeps scrolling
  const method Inertia(): bool;
  begin
    return self.inertia <> 0;
  end;

  /// `true` when pinch and swipe gestures are recognized.
  /// @returns `true` when pinch and swipe gestures are recognized
  const method Gestures(): bool;
  begin
    return self.gestures <> 0;
  end;

  /// `true` when a pen also acts as the mouse.
  /// @returns `true` when a pen also acts as the mouse
  const method PenMouseEmulation(): bool;
  begin
    return self.pen_mouse_emulation <> 0;
  end;

  /// `true` when a palm resting on the screen is ignored while a pen is used.
  /// @returns `true` when a palm resting on the screen is ignored while a pen is used
  const method PalmRejection(): bool;
  begin
    return self.palm_rejection <> 0;
  end;

  /// `true` when a trackpad's gestures are recognized.
  /// @returns `true` when a trackpad's gestures are recognized
  const method TrackpadGestures(): bool;
  begin
    return self.trackpad_gestures <> 0;
  end;

  /// `true` when a swipe from the edge goes back.
  /// @returns `true` when a swipe from the edge goes back
  const method SwipeNavigation(): bool;
  begin
    return self.swipe_navigation <> 0;
  end;
end;

// An error in an XML window (`RXmlError`): its message as a string.
public extend RXmlError
  /// What is wrong at its line and column.
  /// @returns what is wrong at its line and column
  const method Message(): string;
  begin
    return StringFromC(addr of self.message[0]);
  end;
end;

// What an XML attribute takes (`RXmlAttributeInfo`): typed reads of its fields.
public extend RXmlAttributeInfo
  /// The attribute's name.
  /// @returns the attribute's name
  const method Name(): string;
  begin
    return DoRavenText(self.name);
  end;

  /// The kind of value it takes.
  /// @returns the kind of value it takes
  const method Kind(): UIXMLAttrKind;
  begin
    return UIXMLAttrKind(self.type_);
  end;

  /// The values a choice attribute takes, as Raven lists them ("" for another kind).
  /// @returns the values a choice attribute takes, as Raven lists them ("" for another kind)
  const method Choices(): string;
  begin
    return DoRavenText(self.choices_);
  end;

  /// The group the attribute belongs to ("" for none).
  /// @returns the group the attribute belongs to ("" for none)
  const method Group(): string;
  begin
    return DoRavenText(self.group);
  end;

  /// What the attribute does.
  /// @returns what the attribute does
  const method Description(): string;
  begin
    return DoRavenText(self.description);
  end;
end;

// A tile view's section (`RTileSection`): its texts as strings.
public extend RTileSection
  /// The section's title.
  /// @returns the section's title
