    Color,       /// "#RGB", "#RRGGBB", "#RRGGBBAA", or a name: white, black, red, transparent. C: R_XML_COLOR
    Action,      /// The name of an action (Raction_bind). C: R_XML_ACTION
    File,        /// The path of a file. C: R_XML_FILE
    Numbers,     /// Several numbers separated by commas: "8,4", "0,0,1,1". C: R_XML_NUMBERS
    List);       /// Texts separated by '|': "One|Two|Three". C: R_XML_LIST

