    /// What `ReadOnly(..)` sets, read back. C: Rtext_input_is_read_only
    /// @returns `true` when `ReadOnly(..)` turned it on
    const method ReadOnly(): bool;
    begin
      return Rtext_input_is_read_only(self.FId) <> 0;
    end;

    /// The most characters it takes (0: no limit). C: Rtext_input_set_max_length
    /// @param ALength the length
    /// @returns this object, so calls chain
    const method MaxLength(const ALength: int32): self;
    begin
      Rtext_input_set_max_length(self.FId, ALength);
      return self;
    end;

    /// Selects the whole text. C: Rtext_input_select_all
    /// @returns this object, so calls chain
    const method SelectAll(): self;
    begin
      Rtext_input_select_all(self.FId);
      return self;
    end;

    /// What the text is (e-mail, number ..): the keyboard a touch device shows.
    /// C: Rtext_input_set_input_type
    /// @param AType the type
    /// @returns this object, so calls chain
