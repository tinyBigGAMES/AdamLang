    begin
      Rtext_input_set_input_type(self.FId, int32(AType));
      return self;
    end;

    /// What `InputType(..)` sets, read back. C: Rtext_input_get_input_type
    /// @returns what the text is (e-mail, number ..): the keyboard a touch device shows
    const method InputType(): UIInputType;
    begin
      return UIInputType(Rtext_input_get_input_type(self.FId));
    end;

    /// The label of a touch keyboard's return key. C: Rtext_input_set_return_key
    /// @param AKey the key
    /// @returns this object, so calls chain
