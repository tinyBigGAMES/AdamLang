    end;

    /// Wraps long lines at the label's width when `AOn`. C: Rlabel_set_wrap
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method Wrap(const AOn: bool): self;
