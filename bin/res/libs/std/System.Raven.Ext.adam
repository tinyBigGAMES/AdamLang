    end;

    /// The text as shown, Markdown's marks taken out. C: Rlabel_get_plain_text
    /// @returns the text as shown, Markdown's marks taken out
    const method PlainText(): string;
    begin
      return DoRavenText(Rlabel_get_plain_text(self.FId));
    end;

    /// The text selectable (and copied) with the pointer when `AOn`. C: Rlabel_set_selectable
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method Selectable(const AOn: bool): self;
    begin
      Rlabel_set_selectable(self.FId, DoCBool(AOn));
      return self;
    end;

    /// What `Selectable(..)` sets, read back. C: Rlabel_get_selectable
    /// @returns `true` when `Selectable(..)` turned it on
    const method Selectable(): bool;
    begin
      return Rlabel_get_selectable(self.FId) <> 0;
    end;

    /// The text selected ("" for none). C: Rlabel_get_selected_text
    /// @returns the text selected ("" for none)
    const method SelectedText(): string;
    begin
      return DoRavenText(Rlabel_get_selected_text(self.FId));
    end;

    /// Selects the whole text. C: Rlabel_select_all
    /// @returns this object, so calls chain
    const method SelectAll(): self;
    begin
      Rlabel_select_all(self.FId);
      return self;
    end;

    /// Selects nothing. C: Rlabel_clear_selection
    /// @returns this object, so calls chain
    const method ClearSelection(): self;
    begin
      Rlabel_clear_selection(self.FId);
      return self;
    end;

    /// Runs `AFunc` with a Markdown link's URL when it is clicked (`OpenURL` it, or route it).
    /// C: Rlabel_set_link_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnLink(const AFunc: UITextFunc): self;
    begin
      if AFunc = nil then
        GControlTexts.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rlabel_set_link_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rlabel_set_link_callback(self.FId, DoOnControlText,
        GControlTexts.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// The label's own font (an empty handle: the widget's or the theme's); kept while it is
    /// set. C: Rlabel_set_font
    /// @param AFont the font
    /// @returns this object, so calls chain
    const method Font(const AFont: UIFontRes): self;
    begin
      Rlabel_set_font(self.FId, AFont.Id());
      DoHookDestroy(self.FId);
      DoKeepFont(self.FId, ADAM_RAVEN_KEEP_OWN_FONT, AFont);
      return self;
    end;
  end;

