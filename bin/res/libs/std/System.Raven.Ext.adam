    /// @returns the label of a touch keyboard's return key
    const method ReturnKey(): UIReturnKey;
    begin
      return UIReturnKey(Rtext_input_get_return_key(self.FId));
    end;

    /// Runs `AFunc` with the text at each change. C: Rtext_input_set_changed_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnChanged(const AFunc: UITextFunc): self;
    begin
      if AFunc = nil then
        GControlTexts.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtext_input_set_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtext_input_set_changed_callback(self.FId, DoOnControlText,
        GControlTexts.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the text when it is committed (Enter, the return key).
    /// C: Rtext_input_set_committed_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnCommit(const AFunc: UITextFunc): self;
    begin
      if AFunc = nil then
        GControlTexts.Clear(self.FId, ADAM_RAVEN_CONTROL_COMMIT);
