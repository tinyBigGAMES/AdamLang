  UIFileDialogFlag = choices(
    Multiple = 0,  /// Several files can be chosen (Rfile_dialog_open): see Rfile_dialog_get_result. C: R_FILE_DIALOG_MULTIPLE
    Raven,         /// Never the dialog of the OS: the file browser of Raven, in a dialog of the parent window. C: R_FILE_DIALOG_RAVEN
    ShowHidden);   /// Hidden files shown. C: R_FILE_DIALOG_SHOW_HIDDEN
  /// A set of `UIFileDialogFlag` (Raven's `RFileDialogFlags`).
  UIFileDialogFlags = set of UIFileDialogFlag;

