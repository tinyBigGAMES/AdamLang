  /// Children shown one at a time (pages of a wizard, views of a tool). C: Rswitcher_*
  UISwitcher = object(UIWidget)
    /// A new, empty switcher. C: Rwidget_create(R_WIDGET_SWITCHER)
    static method Create(): UISwitcher;
