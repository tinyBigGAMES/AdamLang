    /// A new spacer `AWidth` by `AHeight`. C: Rwidget_create, Rspacer_set_size
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns a new spacer `AWidth` by `AHeight`
    static method Create(const AWidth: float32; const AHeight: float32): UISpacer;
    var
      LWidget: UISpacer;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Spacer)));
