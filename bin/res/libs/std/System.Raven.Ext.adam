  begin
    return self.pointer <> 0;
  end;
end;

// A spring (`RSpring`): an animated value that eases to where it is set.
public extend RSpring
  /// Gives the spring a push of `AVelocity` (units a second). C: Rspring_kick
  method Kick(const AVelocity: float32);
  begin
    Rspring_kick(addr of self, AVelocity);
  end;

  /// Puts the spring at `AValue` at once, at rest. C: Rspring_set
  method Set(const AValue: float32);
  begin
    Rspring_set(addr of self, AValue);
  end;
end;

// ============================================================================
// Callbacks (listing sec 0 CALLBACKS): each Raven callback type has ONE clink
// trampoline here, its user_data the key of the closure it runs in that type's
// closure table (UISlots), never a pointer into Adam's memory: a key whose
// closure is gone finds nothing. A closure is held per (handle, event), the
// one set before released when another is set; a handle's closures go with
// the handle (a timer's when its TimerRes holder destroys it), the app's when
// the app ends. A closure is copied out before it runs, so one replaced (or
// whose handle goes) while it runs finishes on its own copy.
// ============================================================================

forward func DoAppShutdown();
forward func DoTimerGone(const ATimer: Rid; const AKey: ptr);

type
  // The closures of one closure type T Raven's callbacks run: by key, a (handle, event) pair
  // (Put) or a one-shot task (PutOnce)
  UISlots<T> = object
    // The closures by key: (owner shl 8) | event for Put, bit 63 + a count for PutOnce
    hidden FByKey: Map<uint64, T>;
    // By owner: the events it holds a closure for, a bit each (0..63)
    hidden FEvents: Map<uint64, uint64>;
    // PutOnce's last count
    hidden FOnce: uint64;

    // AFunc held for AOwner's event AEvent (0..63), the one held before released; the key
    // to give Raven as the callback's user_data
    method Put(const AOwner: Rid; const AEvent: int32; const AFunc: T): ptr;
    var
      LKey: uint64;
      LEvents: uint64;
    begin
      LKey := (uint64(AOwner) shl 8) | uint64(AEvent);
      self.FByKey.Put(LKey, AFunc);
      LEvents := 0;
      self.FEvents.TryGet(uint64(AOwner), LEvents);
      self.FEvents.Put(uint64(AOwner), LEvents | (uint64(1) shl uint64(AEvent)));
      return ptr(LKey);
    end;

    // AFunc held until it is taken (Take): the key to give Raven as the user_data
    method PutOnce(const AFunc: T): ptr;
    var
      LKey: uint64;
    begin
      self.FOnce := self.FOnce + 1;
      LKey := (uint64(1) shl 63) | self.FOnce;
      self.FByKey.Put(LKey, AFunc);
      return ptr(LKey);
    end;

    // The closure the user_data AData names, into AFunc: false when none is held for it
    const method Find(const AData: ptr; var AFunc: T): bool;
    begin
      return self.FByKey.TryGet(uint64(AData), AFunc);
    end;

    // The closure the user_data AData names, into AFunc, no longer held: false when none
    method Take(const AData: ptr; var AFunc: T): bool;
    begin
      if not self.FByKey.TryGet(uint64(AData), AFunc) then
        return false;
      end;
      self.FByKey.Remove(uint64(AData));
      return true;
    end;

    // The closure the user_data AData names released (none: nothing)
    method Remove(const AData: ptr);
    begin
      self.FByKey.Remove(uint64(AData));
    end;

    // AOwner's closure for its event AEvent released (none: nothing)
    method Clear(const AOwner: Rid; const AEvent: int32);
    var
      LEvents: uint64;
    begin
      self.FByKey.Remove((uint64(AOwner) shl 8) | uint64(AEvent));
      if self.FEvents.TryGet(uint64(AOwner), LEvents) then
        LEvents := LEvents & ~(uint64(1) shl uint64(AEvent));
        if LEvents = 0 then
          self.FEvents.Remove(uint64(AOwner));
        else
          self.FEvents.Put(uint64(AOwner), LEvents);
        end;
      end;
    end;

    // Every closure AOwner holds released (its handle is gone)
    method DropOwner(const AOwner: Rid);
    var
      LEvents: uint64;
      LBit: uint64;
    begin
      if not self.FEvents.TryGet(uint64(AOwner), LEvents) then
        return;
      end;
      for LBit := 0 to 63 do
        if (LEvents & (uint64(1) shl LBit)) <> 0 then
          self.FByKey.Remove((uint64(AOwner) shl 8) | LBit);
        end;
      end;
      self.FEvents.Remove(uint64(AOwner));
    end;

    // Every closure released (the app ends)
    method DropAll();
    begin
      self.FByKey.Clear();
      self.FEvents.Clear();
    end;
  end;

  // A Raven object a <Name>Res handle destroys: once (Release), at the last copy's release or
  // when the app ends first (DoAppShutdown)
  UIResHold = object
    // It owns what it names (false for one Raven could not make)
    Live: bool;
    // Destroyed: the handle's reads give nothing
    Released: bool;

    // Destroys what it names (Raven is still open)
    virtual method Unload();
    begin
    end;

    // Destroys once: nothing for one never made or destroyed already, nothing once Raven
    // has ended (Rshutdown destroyed it with everything else)
    method Release();
    begin
      if not self.Live or self.Released then
        return;
      end;
      self.Released := true;
      if Ris_initialized() <> 0 then
        self.Unload();
      end;
    end;
  end;

  // A timer's holder: the timer destroyed and its closure released with the last copy
  UITimerHold = object(UIResHold)
    FTimer: Rid;
    // Its closure's key (GTimerSlots)
    FKey: ptr;

    done;
    begin
      self.Release();
    end;

    override method Unload();
    begin
      DoTimerGone(self.FTimer, self.FKey);
    end;
  end;

  // The app's holder: the last UIApp copy's release ends Raven (DoAppShutdown)
  UIAppHold = object
    done;
    begin
      DoAppShutdown();
    end;
  end;

var
  // Raven's allocator: Adam's heap (UIAppConfig.DoOpen sets it before Rinit), so a debug build's leak
  // report counts Raven's blocks too
  GRavenAllocator: RAllocator;
  // The app open now (watched, not held: UIApp.Current)
  GAppHold: weak UIAppHold;
  // The <Name>Res holders alive (watched, not held), destroyed by DoAppShutdown before
  // Rshutdown; entries whose holder is gone leave once the list reaches GUIResRoom
  GUIRes: List<weak UIResHold>;
  GUIResRoom: int64;
  // The app's callbacks: one closure each (nil: none set)
  GOnFrame: UIFrameFunc;
  GOnAppEvent: UIAppEventFunc;
  GOnDeviceReset: UITaskFunc;
  GOnNotifyClicked: UITaskFunc;
  GNotifyFallback: UINotifyFunc;
  // UIErrors.OnError's closure (Raven's error callback is global and has no user_data)
  GOnError: UIErrorFunc;
  // Posted tasks (UIApp.Post, any thread), one-shot, under GTaskLock
  GTaskSlots: UISlots<UITaskFunc>;
  GTaskLock: mutex;
  // The timers' closures (one-shot keys, removed with their holder), and the timers' holders
  // by timer (watched)
  GTimerSlots: UISlots<UITimerFunc>;
  GTimerHeld: Map<uint64, weak UITimerHold>;

// Lists AHold (watched, not held): DoAppShutdown destroys it if it is still alive then. Once
// the list reaches GUIResRoom the watched holders that are gone leave first
func DoTrackRes(const AHold: ref UIResHold);
var
  LWatch: weak UIResHold;
  LI: int64;
begin
  if GUIRes.Count >= GUIResRoom then
    LI := GUIRes.Count - 1;
    while LI >= 0 do
      if not alive(GUIRes.Items[LI]) then
        GUIRes.Delete(LI);
      end;
      LI -= 1;
    end;
    GUIResRoom := GUIRes.Count * 2;
    if GUIResRoom < 64 then
      GUIResRoom := 64;
    end;
  end;
  LWatch := AHold;
  GUIRes.Add(LWatch);
end;

// Raven's allocator over Adam's heap. Raven calls these on any of its threads and takes nil
// for a block the heap cannot give, so the heap's out-of-memory raise is caught here and
// never crosses Raven's C frames
func clink DoRavenAlloc(size: uint64; user_data: ptr): ptr;
var
  LBlock: ptr;
begin
  LBlock := nil;
  guard
    LBlock := getmem(int64(size));
  except
    LBlock := nil;
  end;
  return LBlock;
end;

func clink DoRavenRealloc(ptr_: ptr; size: uint64; user_data: ptr): ptr;
var
  LBlock: ptr;
begin
  LBlock := nil;
  guard
    LBlock := resizemem(ptr_, int64(size));
  except
    LBlock := nil;
  end;
  return LBlock;
end;

func clink DoRavenFree(ptr_: ptr; user_data: ptr);
begin
  if ptr_ <> nil then
    freemem(ptr_);
  end;
end;

// The trampolines: each runs its closure on a copy (one replaced while it runs finishes)
func clink DoOnFrame(delta_seconds: float64; user_data: ptr);
var
  LFunc: UIFrameFunc;
begin
  LFunc := GOnFrame;
  if LFunc <> nil then
    LFunc(delta_seconds);
  end;
end;

func clink DoOnAppEvent(event: RAppEvent; user_data: ptr);
var
  LFunc: UIAppEventFunc;
begin
  LFunc := GOnAppEvent;
  if LFunc <> nil then
    LFunc(UIAppEvent(event));
  end;
end;

func clink DoOnDeviceReset(user_data: ptr);
var
  LFunc: UITaskFunc;
begin
  LFunc := GOnDeviceReset;
  if LFunc <> nil then
    LFunc();
  end;
end;

func clink DoOnNotifyClicked(user_data: ptr);
var
  LFunc: UITaskFunc;
begin
  LFunc := GOnNotifyClicked;
  if LFunc <> nil then
    LFunc();
  end;
end;

func clink DoOnNotifyFallback(title: ptr to const char; body: ptr to const char;
  urgency: RNotificationUrgency; user_data: ptr);
var
  LFunc: UINotifyFunc;
begin
  LFunc := GNotifyFallback;
  if LFunc <> nil then
    LFunc(DoRavenText(title), DoRavenText(body), UIUrgency(urgency));
  end;
end;

func clink DoOnError(code: RError; severity: RSeverity; detail: ptr to const char);
var
  LFunc: UIErrorFunc;
begin
  LFunc := GOnError;
  if LFunc <> nil then
    LFunc(UIErrorCode(code), UISeverity(severity), DoRavenText(detail));
  end;
end;

// UIErrors.Report's handler: one console line per error
func clink DoPrintRavenError(code: RError; severity: RSeverity; detail: ptr to const char);
begin
  println("[Raven] {} ({}): {}", DoRavenText(Rerror_to_string(code)),
    DoRavenText(Rseverity_to_string(severity)), DoRavenText(detail));
end;

// A posted task (UIApp.Post) runs once on the UI thread: taken from its table under the lock,
// run outside it
func clink DoOnTask(user_data: ptr);
var
  LFunc: UITaskFunc;
  LFound: bool;
begin
  lock (GTaskLock) do
    LFound := GTaskSlots.Take(user_data, LFunc);
  end;
  if LFound and (LFunc <> nil) then
    LFunc();
  end;
end;

// The app ends (its last UIApp copy): every <Name>Res still alive destroyed, the newest
// first, every closure the layer holds released, then Raven ends
func DoAppShutdown();
var
  LHold: ref UIResHold;
  LI: int64;
begin
  LI := GUIRes.Count - 1;
  while LI >= 0 do
    LHold := lock(GUIRes.Items[LI]);
    if LHold <> nil then
      LHold.Release();
    end;
    LI -= 1;
  end;
  GUIRes.Clear();
  Rset_frame_callback(nil, nil);
  Rset_app_event_callback(nil, nil);
  Rset_device_reset_callback(nil, nil);
  Rnotification_set_clicked_callback(nil, nil);
  Rnotification_set_fallback(nil, nil);
  GOnFrame := nil;
  GOnAppEvent := nil;
  GOnDeviceReset := nil;
  GOnNotifyClicked := nil;
  GNotifyFallback := nil;
  Rshutdown();
  // Raven ran no task left: their closures go after it
  lock (GTaskLock) do
    GTaskSlots.DropAll();
  end;
  GTimerSlots.DropAll();
  GTimerHeld.Clear();
end;

// A timer's holder is released: the timer destroyed (a one-shot timer that fired is gone
// already: Raven destroyed it), its closure released
func DoTimerGone(const ATimer: Rid; const AKey: ptr);
begin
  if Rtimer_is_valid(ATimer) <> 0 then
    Rtimer_destroy(ATimer);
  end;
  GTimerSlots.Remove(AKey);
  GTimerHeld.Remove(uint64(ATimer));
end;

forward func clink DoOnTimer(timer: Rid; user_data: ptr);

public forward type UIApp;

// ============================================================================
// The app (listing sec 3): one per program, opened by UIAppConfig.Open (or
// UIApp(name)), ended by its last copy's release: every <Name>Res still alive
// is destroyed first, every closure released, then Raven ends. Raven's memory
// is Adam's heap while it runs (a debug build's leak report counts it).
// ============================================================================

public type
  /// How the app opens, built fluently: every method returns the config, `Open` opens the
  /// app. Start one with `UIApp.Config()`. Raven's defaults: the default backend, worker
  /// threads by the CPU count, a render thread, vsync on, no validation, OS windows, the
  /// system's UI scale.
  /// @example `LApp := UIApp.Config().AppName("Notes").Backend(UIBackend.Vulkan).Open();`
  UIAppConfig = object
    hidden FBackend: UIBackend;
    hidden FAppName: string;
    hidden FWorkers: int32;
    hidden FNoRenderThread: bool;
    hidden FNoVsync: bool;
    hidden FValidation: bool;
    hidden FHeadless: bool;
    hidden FUIScale: float32;
    // A setting beyond the backend is set (Rinit_ex, else Rinit)
    hidden FFull: bool;

    /// Raven's defaults (see the type).
    init();
    begin
      self.FBackend := UIBackend.Default;
      self.FAppName := "";
      self.FWorkers := 0;
      self.FNoRenderThread := false;
      self.FNoVsync := false;
      self.FValidation := false;
      self.FHeadless := false;
      self.FUIScale := 0.0f;
      self.FFull := false;
    end;

    /// The application's name (the system's notifications, taskbar and settings show it).
    method AppName(const AName: string): self;
    begin
      self.FAppName := AName;
      self.FFull := true;
      return self;
    end;

    /// The worker threads Raven runs (0: one a CPU core, the default).
    method WorkerThreads(const ACount: int32): self;
    begin
      self.FWorkers := ACount;
      self.FFull := true;
      return self;
    end;

    /// `true` to render on the UI thread rather than a render thread of its own.
    method NoRenderThread(const AOn: bool): self;
    begin
      self.FNoRenderThread := AOn;
      self.FFull := true;
      return self;
    end;

    /// `true` to draw frames without waiting for the display (vsync off).
    method NoVsync(const AOn: bool): self;
    begin
      self.FNoVsync := AOn;
      self.FFull := true;
      return self;
    end;

    /// `true` to turn the GPU driver's validation on (slower: finds rendering mistakes).
    method Validation(const AOn: bool): self;
    begin
      self.FValidation := AOn;
      self.FFull := true;
      return self;
    end;

    /// `true` for no OS window: windows draw off screen and take their input by injection
    /// (tools, tests).
    method Headless(const AOn: bool): self;
    begin
      self.FHeadless := AOn;
      self.FFull := true;
      return self;
    end;

    /// The UI scale (0: the system's, the default; 2: everything twice as big).
    method UIScale(const AScale: float32): self;
    begin
      self.FUIScale := AScale;
      self.FFull := true;
      return self;
    end;

    /// The renderer (`UIBackend.Null` renders nothing: headless runs and tests).
    method Backend(const ABackend: UIBackend): self;
    begin
      self.FBackend := ABackend;
      return self;
    end;

    // Opens Raven as this config says (Rinit, or Rinit_ex when more than the backend is
    // set), Adam's heap its allocator; the app's holder, nil when Raven did not open (its
    // error reported) or is open already (the one app a program has)
    hidden const method DoOpen(): ref UIAppHold;
    var
      LDesc: RInitDesc;
      LOpened: int32;
      LHold: ref UIAppHold;
    begin
      if Ris_initialized() <> 0 then
        return nil;
      end;
      GRavenAllocator.alloc := DoRavenAlloc;
      GRavenAllocator.realloc := DoRavenRealloc;
      GRavenAllocator.free := DoRavenFree;
      GRavenAllocator.user_data := nil;
      Rset_allocator(addr of GRavenAllocator);
      if self.FFull then
        LDesc.backend := int32(self.FBackend);
        LDesc.app_name := self.FAppName;
        LDesc.worker_threads := self.FWorkers;
        LDesc.disable_render_thread := DoCBool(self.FNoRenderThread);
        LDesc.disable_vsync := DoCBool(self.FNoVsync);
        LDesc.enable_validation := DoCBool(self.FValidation);
        LDesc.headless := DoCBool(self.FHeadless);
        LDesc.ui_scale := self.FUIScale;
        LOpened := Rinit_ex(addr of LDesc);
      else
        LOpened := Rinit(int32(self.FBackend));
      end;
      if LOpened = 0 then
        return nil;
      end;
      LHold := ref UIAppHold();
      GAppHold := LHold;
      return LHold;
    end;

    /// Opens the app as configured. C: Rinit, Rinit_ex
    /// @returns the app; `IsValid()` false when Raven did not open (its error reported to
    /// `UIErrors`) or an app is open already
    const method Open(): UIApp;
    var
      LHold: ref UIAppHold;
    begin
      // the holder kept here until the app's handle shares it (Current)
      LHold := self.DoOpen();
      if LHold = nil then
        return UIApp();
      end;
      return UIApp.Current();
    end;
  end;

  /// The app: Raven itself, one per program. A shared handle: the last copy's release ends
  /// Raven (every `<Name>Res` still alive destroyed first). Open it with
  /// `UIApp.Config()...Open()` or `UIApp(name)`; run it with `Run()` (a tool) or a loop of
  /// `Frame()` (a game or an engine).
  /// @example `LApp := UIApp("Notes"); LApp.OnFrame(func(const ADelta: float64) begin Tick(ADelta); end); return LApp.Run();`
  UIApp = object
    hidden FHold: ref UIAppHold;

    /// An empty handle (holds no app: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
    end;

    /// Opens the app named `AName` with Raven's defaults: the short form of
    /// `UIApp.Config().AppName(AName).Open()`.
    init(const AName: string);
    var
      LConfig: UIAppConfig;
    begin
      LConfig.AppName(AName);
      self.FHold := LConfig.Open().FHold;
    end;

    /// A config with Raven's defaults, to open the app with.
    static method Config(): UIAppConfig;
    var
      LConfig: UIAppConfig;
    begin
      return LConfig;
    end;

    /// The app open now (an empty handle when none is).
    static method Current(): UIApp;
    var
      LApp: UIApp;
    begin
      LApp.FHold := lock(GAppHold);
      return LApp;
    end;

    /// `true` while this handle holds the open app.
    const method IsValid(): bool;
    begin
      return (self.FHold <> nil) and (Ris_initialized() <> 0);
    end;

    /// `true` while Raven is open (any app). C: Ris_initialized
    static method Initialized(): bool;
    begin
      return Ris_initialized() <> 0;
    end;

    /// Raven's version, e.g. `"0.3.0"`. C: Rget_version
    static method Version(): string;
    begin
      return DoRavenText(Rget_version());
    end;

    /// `true` until `Quit` is called or the last window is closed. C: Ris_running
    const method Running(): bool;
    begin
      return Ris_running() <> 0;
    end;

    /// `true` while the system has the app paused (a phone's app in the background). C:
    /// Ris_app_paused
    const method Paused(): bool;
    begin
      return Ris_app_paused() <> 0;
    end;

    /// `true` when called on the UI thread (the one that opened the app). C: Ris_ui_thread
    const method OnUIThread(): bool;
    begin
      return Ris_ui_thread() <> 0;
    end;

    /// The exit code `Quit` set (0 when none was). C: Rget_exit_code
    const method ExitCode(): int32;
    begin
      return Rget_exit_code();
    end;

    /// The seconds the last frame took. C: Rget_delta_time
    const method Delta(): float64;
    begin
      return Rget_delta_time();
    end;

    /// The seconds since the app opened. C: Rget_time
    const method Time(): float64;
    begin
      return Rget_time();
    end;

    /// Waits for the display before each frame (`true`, the default) or not. C: Rset_vsync
    method Vsync(const AOn: bool): self;
    begin
      Rset_vsync(DoCBool(AOn));
      return self;
    end;

    /// `true` when frames wait for the display. C: Rget_vsync
    const method Vsync(): bool;
    begin
      return Rget_vsync() <> 0;
    end;

    /// The UI scale (2: everything twice as big). C: Rset_ui_scale
    method UIScale(const AScale: float32): self;
    begin
      Rset_ui_scale(AScale);
      return self;
    end;

    /// The UI scale. C: Rget_ui_scale
    const method UIScale(): float32;
    begin
      return Rget_ui_scale();
    end;

    /// The layout direction of every window (right to left for Arabic or Hebrew). C:
    /// Rset_layout_direction
    method Direction(const ADirection: UIDirection): self;
    begin
      Rset_layout_direction(int32(ADirection));
      return self;
    end;

    /// The layout direction. C: Rget_layout_direction
    const method Direction(): UIDirection;
    begin
      return UIDirection(Rget_layout_direction());
    end;

    /// Animations on (`true`, the default) or off. C: Rset_animations_enabled
    method Animations(const AOn: bool): self;
    begin
      Rset_animations_enabled(DoCBool(AOn));
      return self;
    end;

    /// `true` when animations are on. C: Rget_animations_enabled
    const method Animations(): bool;
    begin
      return Rget_animations_enabled() <> 0;
    end;

    /// How fast animations run (1: as designed, 0.5: half speed). C: Rset_animation_speed
    method AnimationSpeed(const ASpeed: float32): self;
    begin
      Rset_animation_speed(ASpeed);
      return self;
    end;

    /// How fast animations run. C: Rget_animation_speed
    const method AnimationSpeed(): float32;
    begin
      return Rget_animation_speed();
    end;

    /// Animations step `ASeconds` each frame rather than by the clock (0: by the clock), for
    /// frames that come out the same every run (recordings, tests). C:
    /// Rset_animation_time_step
    method AnimationStep(const ASeconds: float64): self;
    begin
      Rset_animation_time_step(ASeconds);
      return self;
    end;

    /// The worker threads Raven runs. C: Rget_worker_thread_count
    const method WorkerThreads(): int32;
    begin
      return Rget_worker_thread_count();
    end;

    /// Runs the app until `Quit` is called or the last window is closed, drawing a frame
    /// whenever something changed and sleeping between (a tool's loop).
    /// @returns the exit code `Quit` set
    method Run(): int32;
    begin
      while Rwait_frame(-1.0) <> 0 do
      end;
      return Rget_exit_code();
    end;

    /// Draws one frame of every window: processes the pending events, runs the posted tasks
    /// and timers, then lays out and paints what changed (a game's loop calls it each turn).
    /// C: Rdraw_frame
    /// @returns `false` once `Quit` was called or the last window is closed
    method Frame(): bool;
    begin
      return Rdraw_frame() <> 0;
    end;

    /// Sleeps until something happens (an event, a task, a timer) or `ATimeout` seconds pass
    /// (a negative one: no limit), then draws a frame. C: Rwait_frame
    /// @returns `false` once `Quit` was called or the last window is closed
    method WaitFrame(const ATimeout: float64): bool;
    begin
      return Rwait_frame(ATimeout) <> 0;
    end;

    /// Sleeps until an event comes or `ATimeout` seconds pass, drawing nothing. C:
    /// Rwait_events
    method WaitEvents(const ATimeout: float64);
    begin
      Rwait_events(ATimeout);
    end;

    /// Takes the pending OS events, drawing nothing. C: Rpoll_events
    method PollEvents();
    begin
      Rpoll_events();
    end;

    /// Ends the loop with exit code 0 (`Run` returns, `Frame` gives `false`). Any thread. C:
    /// Rquit
    method Quit();
    begin
      Rquit(0);
    end;

    /// Ends the loop with exit code `ACode`. Any thread. C: Rquit
    method Quit(const ACode: int32);
    begin
      Rquit(ACode);
    end;

    /// Wakes a `WaitFrame` / `WaitEvents` sleeping on the UI thread. Any thread. C: Rwake_up
    method WakeUp();
    begin
      Rwake_up();
    end;

    /// Acts as if the system sent the life-cycle event `AEvent` (tests). C:
    /// Rinject_app_event
    method InjectAppEvent(const AEvent: UIAppEvent);
    begin
      Rinject_app_event(int32(AEvent));
    end;

    /// Runs `AFunc` at every frame with the seconds since the frame before (nil: none). C:
    /// Rset_frame_callback
    method OnFrame(const AFunc: UIFrameFunc): self;
    begin
      GOnFrame := AFunc;
      if AFunc = nil then
        Rset_frame_callback(nil, nil);
      else
        Rset_frame_callback(DoOnFrame, nil);
      end;
      return self;
    end;

    /// Runs `AFunc` on each life-cycle event (nil: none). C: Rset_app_event_callback
    method OnAppEvent(const AFunc: UIAppEventFunc): self;
    begin
      GOnAppEvent := AFunc;
      if AFunc = nil then
        Rset_app_event_callback(nil, nil);
      else
        Rset_app_event_callback(DoOnAppEvent, nil);
      end;
      return self;
    end;

    /// Runs `AFunc` after the GPU device was lost and Raven made a new one, on the UI thread,
    /// to rebuild what the program made itself (nil: none). C: Rset_device_reset_callback
    method OnDeviceReset(const AFunc: UITaskFunc): self;
    begin
      GOnDeviceReset := AFunc;
      if AFunc = nil then
        Rset_device_reset_callback(nil, nil);
      else
        Rset_device_reset_callback(DoOnDeviceReset, nil);
      end;
      return self;
    end;

    /// Runs `AFunc` once on the UI thread, at the next frame. Any thread: the way a worker
    /// hands its result to the UI. C: Rtask_post
    /// @example `LApp.Post(func() begin LStatus.Text("done"); end);`
    method Post(const AFunc: UITaskFunc);
    var
      LKey: ptr;
    begin
      if AFunc = nil then
        return;
      end;
      lock (GTaskLock) do
        LKey := GTaskSlots.PutOnce(AFunc);
      end;
      Rtask_post(DoOnTask, LKey);
    end;

    /// Raven's memory use. C: Rmemory_get_stats
    const method MemoryStats(): RMemoryStats;
    var
      LStats: RMemoryStats;
    begin
      Rmemory_get_stats(addr of LStats);
      return LStats;
    end;

    /// Checks Raven's memory for damage (a debug aid). C: Rmemory_check
    /// @returns `true` when it is sound
    const method MemoryCheck(): bool;
    begin
      return Rmemory_check() <> 0;
    end;

    /// Gives the memory Raven keeps for reuse back to the heap. C: Rmemory_trim
    method MemoryTrim();
    begin
      Rmemory_trim();
    end;

    /// The clipboard's text ("" when it holds none). C: Rclipboard_get_text
    static method ClipboardText(): string;
    begin
      return DoRavenText(Rclipboard_get_text());
    end;

    /// Puts `AText` on the clipboard. C: Rclipboard_set_text
    static method ClipboardText(const AText: string);
    begin
      Rclipboard_set_text(AText);
    end;

    /// Puts `AText` on the clipboard with `AHTML` as its formatted form (pasted into a
    /// program that takes HTML). C: Rclipboard_set_html
    static method ClipboardHTML(const AText: string; const AHTML: string);
    begin
      Rclipboard_set_html(AText, AHTML);
    end;

    /// Shows a system notification of normal urgency. C: Rnotification_show
    /// @returns `true` when the system showed it (or `NotifyFallback`'s routine took it)
    static method Notify(const ATitle: string; const ABody: string): bool;
    begin
      return UIApp.Notify(ATitle, ABody, UIUrgency.Normal);
    end;

    /// Shows a system notification of urgency `AUrgency`. C: Rnotification_show
    /// @returns `true` when the system showed it (or `NotifyFallback`'s routine took it)
    static method Notify(const ATitle: string; const ABody: string; const AUrgency: UIUrgency): bool;
    begin
      return Rnotification_show(ATitle, ABody, int32(AUrgency)) <> 0;
    end;

    /// `true` when the system shows notifications. C: Rnotification_is_supported
    static method NotifySupported(): bool;
    begin
      return Rnotification_is_supported() <> 0;
    end;

    /// Runs `AFunc` for a notification the system cannot show, to show it another way (a
    /// toast in the window; nil: none). C: Rnotification_set_fallback
    method NotifyFallback(const AFunc: UINotifyFunc): self;
    begin
      GNotifyFallback := AFunc;
      if AFunc = nil then
        Rnotification_set_fallback(nil, nil);
      else
        Rnotification_set_fallback(DoOnNotifyFallback, nil);
      end;
      return self;
    end;

    /// Runs `AFunc` when the user clicks a notification the app showed (nil: none). C:
    /// Rnotification_set_clicked_callback
    method OnNotifyClicked(const AFunc: UITaskFunc): self;
    begin
      GOnNotifyClicked := AFunc;
      if AFunc = nil then
        Rnotification_set_clicked_callback(nil, nil);
      else
        Rnotification_set_clicked_callback(DoOnNotifyClicked, nil);
      end;
      return self;
    end;

    /// Shows `AText` as the badge on the app's taskbar button ("" removes it). C:
    /// Rtaskbar_set_badge
    /// @returns `true` when the system has taskbar badges
    static method TaskbarBadge(const AText: string): bool;
    begin
      return Rtaskbar_set_badge(AText) <> 0;
    end;

    /// The tasks of the app's taskbar jump list, in order (none: it is cleared). C:
    /// Rtaskbar_set_jump_list
    /// @returns `true` when the system has jump lists
    static method JumpList(const ATasks: array of UIJumpTask): bool;
    var
      LTexts: array of CString;
      LTasks: array of RJumpTask;
      LI: int64;
    begin
      if len(ATasks) = 0 then
        return Rtaskbar_set_jump_list(nil, 0) <> 0;
      end;
      // the texts kept as C strings while Raven reads them
      setlength(LTexts, len(ATasks) * 3);
      setlength(LTasks, len(ATasks));
      for LI := 0 to len(ATasks) - 1 do
        LTexts[LI * 3] := CString(ATasks[LI].Title);
        LTexts[LI * 3 + 1] := CString(ATasks[LI].Args);
        LTexts[LI * 3 + 2] := CString(ATasks[LI].Description);
        LTasks[LI].title := LTexts[LI * 3].Ptr;
        LTasks[LI].arguments := LTexts[LI * 3 + 1].Ptr;
        LTasks[LI].description := LTexts[LI * 3 + 2].Ptr;
      end;
      return Rtaskbar_set_jump_list(addr of LTasks[0], int32(len(LTasks))) <> 0;
    end;
  end;

  /// Raven's errors: the last one, their texts, a routine run for each, the console report.
  /// Raven reports every error as it happens (a bad id, a missing file, a bad XML
  /// attribute ...); the program sees them through `OnError` or `Report`, or asks `Last`.
  UIErrors = object
    /// The error Raven reported last (`UIErrorCode.None` when none was). C: Rerror_get_last
    static method Last(): UIRavenError;
    var
      LDetail: ptr to const char;
      LSeverity: RSeverity;
      LCode: RError;
    begin
      LDetail := nil;
      LSeverity := R_SEVERITY_WEAK_WARNING;
      LCode := Rerror_get_last(addr of LDetail, addr of LSeverity);
      return UIRavenError(Code: UIErrorCode(LCode), Severity: UISeverity(LSeverity),
        Detail: DoRavenText(LDetail));
    end;

    /// The name of the error code `ACode`, e.g. `"R_ERROR_INVALID_ID"`. C: Rerror_to_string
    static method Text(const ACode: UIErrorCode): string;
    begin
      return DoRavenText(Rerror_to_string(int32(ACode)));
    end;

    /// The name of the severity `ASeverity`. C: Rseverity_to_string
    static method Text(const ASeverity: UISeverity): string;
    begin
      return DoRavenText(Rseverity_to_string(int32(ASeverity)));
    end;

    /// Runs `AFunc` for every error Raven reports, with its code, severity and detail, in
    /// place of `Report`'s console lines (nil: none). Set it before the app opens to see
    /// the errors of opening too. C: Rerror_set_callback
    static method OnError(const AFunc: UIErrorFunc);
    begin
      GOnError := AFunc;
      if AFunc = nil then
        Rerror_set_callback(nil);
      else
        Rerror_set_callback(DoOnError);
      end;
    end;

    /// Writes every error Raven reports on the console, one line each: `[Raven] <code>
    /// (<severity>): <detail>`, in place of an `OnError` routine. Call it before the app
    /// opens so the errors of opening are seen too; `OnError(nil)` turns it off.
    /// @example `UIErrors.Report(); LApp := UIApp("Game");`
    static method Report();
    begin
      GOnError := nil;
      Rerror_set_callback(DoPrintRavenError);
    end;
  end;

  /// A timer: runs its routine every `AInterval` seconds (or once) on the UI thread, during
  /// a frame. A shared handle: the last copy destroys the timer, the app's end too.
  /// C: Rtimer_destroy (the last copy's release)
  /// @example `LTick := UITimerRes(1.0, true, func(const ATimer: UITimerRes) begin Refresh(); end);`
  UITimerRes = object
    hidden FHold: ref UITimerHold;

    /// An empty handle (holds no timer: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
    end;

    /// A timer running `AFunc` after `AInterval` seconds, then again every `AInterval` seconds
    /// when `ARepeat` is `true` (the app must be open). C: Rtimer_create
    init(const AInterval: float64; const ARepeat: bool; const AFunc: UITimerFunc);
    var
      LHold: ref UITimerHold;
      LWatch: weak UITimerHold;
      LKey: ptr;
      LTimer: Rid;
    begin
      if AFunc = nil then
        return;
      end;
      LKey := GTimerSlots.PutOnce(AFunc);
      LTimer := Rtimer_create(AInterval, DoCBool(ARepeat), DoOnTimer, LKey);
      if LTimer = R_INVALID_ID then
        GTimerSlots.Remove(LKey);
        return;
      end;
      LHold := ref UITimerHold();
      LHold.FTimer := LTimer;
      LHold.FKey := LKey;
      LHold.Live := true;
      LWatch := LHold;
      GTimerHeld.Put(uint64(LTimer), LWatch);
      DoTrackRes(LHold);
      self.FHold := LHold;
    end;

    /// `true` while the timer runs (a one-shot timer that fired runs no more). C:
    /// Rtimer_is_valid
    const method IsValid(): bool;
    begin
      return (self.FHold <> nil) and not self.FHold.Released and (Rtimer_is_valid(self.FHold.FTimer) <> 0);
    end;

    /// A handle to the timer `ATimer` this layer made (sharing its holder), as its routine is
    /// handed when it fires; an empty handle for any other Rid.
    static method Of(const ATimer: Rid): UITimerRes;
    var
      LRes: UITimerRes;
      LWatch: weak UITimerHold;
    begin
      if GTimerHeld.TryGet(uint64(ATimer), LWatch) then
        LRes.FHold := lock(LWatch);
      end;
      return LRes;
    end;

    /// The timer's Rid, for .C calls (`R_INVALID_ID` when the handle holds none).
    const method Id(): Rid;
    begin
      if self.FHold = nil then
        return R_INVALID_ID;
      end;
      return self.FHold.FTimer;
    end;
  end;

// A timer fired: its closure runs with a handle sharing the timer's holder (kept while it runs)
func clink DoOnTimer(timer: Rid; user_data: ptr);
var
  LFunc: UITimerFunc;
begin
  if not GTimerSlots.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  // the handle given is one more copy of the timer's own (its holder kept while it runs)
  LFunc(UITimerRes.Of(timer));
end;

// ---------------------------------------------------------------------------
// Adam forms of Raven's text calls: Adam strings in and out, each borrowed for the call
// ---------------------------------------------------------------------------

/// The widget named `AName` inside `AScope` (a window or any widget), searched as Raven's
/// `Rwidget_find` searches: the `Name` an XML layout gave it, or `Rwidget_set_name`'s.
/// @param AScope the window or widget to search in
/// @param AName the widget's name
/// @returns the widget, or `R_INVALID_ID` when none has that name
/// @example `LStatus := FindWidget(LWindow, "status");`
public func cpplink FindWidget(const AScope: Rid; const AName: string): Rid;
var
  LWidget: Rid;
begin
  LWidget := Rwidget_find(AScope, AName);
  return LWidget;
end;

/// Sets one attribute of a widget as an XML layout writes it (`Rwidget_set_attribute`): any
/// attribute of the widget's tag, slots and colours included (`"Visibility"`, `"Color.Accent"`,
/// `"Slot.Fill"` ...).
/// @param AWidget the widget
/// @param AName the attribute's name, as in XML
/// @param AValue its value, as in XML
/// @returns `true` when the widget took it; `false` for an unknown attribute or a bad value
/// @example `SetWidgetAttribute(LPanel, "Visibility", "Collapsed");`
public func cpplink SetWidgetAttribute(const AWidget: Rid; const AName: string;
  const AValue: string): bool;
var
  LTaken: int32;
begin
  LTaken := Rwidget_set_attribute(AWidget, AName, AValue);
  return LTaken <> 0;
end;

/// Sets the text a widget shows: a label's, a button's, a check box's, a text input's or a
/// text editor's (its `Text` attribute: `SetWidgetAttribute(AWidget, "Text", AText)`).
/// @param AWidget the widget
/// @param AText the text
/// @returns `true` when the widget has a text to set
/// @example `SetWidgetText(LStatus, FormatStr("{} files", LCount));`
public func cpplink SetWidgetText(const AWidget: Rid; const AText: string): bool;
begin
  return SetWidgetAttribute(AWidget, "Text", AText);
end;

/// The text a widget shows, as an Adam string:
/// - a label's, a check box's, a text input's or a text editor's text;
/// - `""` for any other kind of widget, or an invalid one.
/// @param AWidget the widget
/// @returns its text
/// @example `LName := Trim(WidgetText(FindWidget(LWindow, "name")));`
public func cpplink WidgetText(const AWidget: Rid): string;
var
  LKind: RWidgetType;
begin
  LKind := Rwidget_get_type(AWidget);
  if LKind = R_WIDGET_LABEL then
    return StringFromC(Rlabel_get_text(AWidget));
  end;
  if LKind = R_WIDGET_CHECKBOX then
    return StringFromC(Rcheckbox_get_text(AWidget));
  end;
  if LKind = R_WIDGET_TEXT_INPUT then
    return StringFromC(Rtext_input_get_text(AWidget));
  end;
  if LKind = R_WIDGET_TEXT_EDITOR then
    return StringFromC(Rtext_editor_get_text(AWidget));
  end;
  return "";
end;

end.
