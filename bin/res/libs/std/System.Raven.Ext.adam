    Slider,        /// A slider. C: R_ROLE_SLIDER
    ProgressBar,   /// A progress bar. C: R_ROLE_PROGRESS_BAR
    SpinButton,    /// A spin button. C: R_ROLE_SPIN_BUTTON
    TextField,     /// A text field. C: R_ROLE_TEXT_FIELD
