    const method Step(const AStep: float32): self;
    begin
      Rslider_set_step(self.FId, AStep);
      return self;
    end;

    /// Lies across (horizontal) or stands up (vertical). C: Rslider_set_orientation
    const method Orientation(const AOrientation: UIOrientation): self;
    begin
      Rslider_set_orientation(self.FId, int32(AOrientation));
      return self;
    end;

    /// Runs `AFunc` with the value as the thumb moves. C: Rslider_set_changed_callback
    const method OnChanged(const AFunc: UIValueFunc): self;
    begin
      if AFunc = nil then
        GControlValues.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rslider_set_changed_callback(self.FId, nil, nil);
        return self;
