  begin
    return DoRavenText(self.text);
  end;

  /// The section's second line ("" for none).
  /// @returns the section's second line ("" for none)
  const method Detail(): string;
  begin
    return DoRavenText(self.detail);
  end;
end;

// A tile view's tile (`RTileItem`): its texts as strings, its colours as UIColor.
public extend RTileItem
  /// The tile's title.
  /// @returns the tile's title
  const method Text(): string;
  begin
    return DoRavenText(self.text);
  end;

  /// The tile's second line ("" for none).
  /// @returns the tile's second line ("" for none)
  const method Detail(): string;
  begin
    return DoRavenText(self.detail);
  end;

  /// The tile's badge ("" for none).
  /// @returns the tile's badge ("" for none)
  const method Badge(): string;
  begin
    return DoRavenText(self.badge);
  end;

  /// The tile's note ("" for none).
  /// @returns the tile's note ("" for none)
  const method Note(): string;
  begin
    return DoRavenText(self.note);
  end;

  /// The colour the tile's icon is tinted with.
  /// @returns the colour the tile's icon is tinted with
  const method Tint(): UIColor;
  begin
    return UIColor(r: self.tint[0], g: self.tint[1], b: self.tint[2], a: self.tint[3]);
  end;

  /// The colour of the tile's title.
  /// @returns the colour of the tile's title
  const method TextColor(): UIColor;
  begin
    return UIColor(r: self.text_color[0], g: self.text_color[1], b: self.text_color[2], a: self.text_color[3]);
  end;

  /// The colour of the tile's second line.
  /// @returns the colour of the tile's second line
  const method DetailColor(): UIColor;
  begin
    return UIColor(r: self.detail_color[0], g: self.detail_color[1], b: self.detail_color[2],
      a: self.detail_color[3]);
  end;
end;

// A shader's look (`RShaderLook`): its colours as UIColor, its switches as bools.
public extend RShaderLook
  /// The look's first colour.
  /// @returns the look's first colour
  const method Color(): UIColor;
  begin
    return UIColor(r: self.color[0], g: self.color[1], b: self.color[2], a: self.color[3]);
  end;

  /// The look's second colour.
  /// @returns the look's second colour
  const method Color2(): UIColor;
  begin
    return UIColor(r: self.color2[0], g: self.color2[1], b: self.color2[2], a: self.color2[3]);
  end;

  /// `true` when the shader animates (it is drawn every frame).
  /// @returns `true` when the shader animates (it is drawn every frame)
  const method Animate(): bool;
  begin
    return self.animate <> 0;
  end;

  /// `true` when the shader follows the pointer.
  /// @returns `true` when the shader follows the pointer
  const method Pointer(): bool;
  begin
    return self.pointer <> 0;
  end;
end;

// A spring (`RSpring`): an animated value that eases to where it is set.
public extend RSpring
  /// Gives the spring a push of `AVelocity` (units a second). C: Rspring_kick
  /// @param AVelocity the velocity
  method Kick(const AVelocity: float32);
  begin
    Rspring_kick(addr of self, AVelocity);
  end;

  /// Puts the spring at `AValue` at once, at rest. C: Rspring_set
  /// @param AValue the value
  method Set(const AValue: float32);
  begin
    Rspring_set(addr of self, AValue);
  end;
end;

// ============================================================================
// Callbacks (listing sec 0 CALLBACKS): each Raven callback type has ONE clink
// trampoline here, its user_data the key of the closure it runs in that type's
// closure table (UISlots), never a pointer into Adam's memory: a key whose
// closure is gone finds nothing. A closure is held per (handle, event), the
// one set before released when another is set; a handle's closures go with
// the handle (a timer's when its TimerRes holder destroys it), the app's when
// the app ends. A closure is copied out before it runs, so one replaced (or
// whose handle goes) while it runs finishes on its own copy.
// ============================================================================

forward func DoAppShutdown();
forward func DoDropControls(const AWidget: Rid);
forward func DoDropListControls(const AWidget: Rid);
forward func DoDropEditorControls(const AWidget: Rid);
forward func DoDropChartControls(const AWidget: Rid);
forward func DoDropToolControls(const AWidget: Rid);
forward func DoDropKept();
forward func DoDropTreeItems(const ATree: Rid);
forward func DoDropSystemUI();
forward func DoDropHosting();
forward func DoDropVulkanLock();
forward func DoTimerGone(const ATimer: Rid; const AKey: ptr);

type
  // The closures of one closure type T Raven's callbacks run: by key, a (handle, event) pair
  // (Put) or a one-shot task (PutOnce)
  UISlots<T> = object
    // The closures by key: (owner shl 8) | event for Put, bit 63 + a count for PutOnce
    hidden FByKey: Map<uint64, T>;
    // By owner: the events it holds a closure for, a bit each (0..63)
    hidden FEvents: Map<uint64, uint64>;
    // PutOnce's last count
    hidden FOnce: uint64;

    // AFunc held for AOwner's event AEvent (0..63), the one held before released; the key
    // to give Raven as the callback's user_data
    method Put(const AOwner: Rid; const AEvent: int32; const AFunc: T): ptr;
    var
      LKey: uint64;
      LEvents: uint64;
    begin
      LKey := (uint64(AOwner) shl 8) | uint64(AEvent);
      self.FByKey.Put(LKey, AFunc);
      LEvents := 0;
      self.FEvents.TryGet(uint64(AOwner), LEvents);
      self.FEvents.Put(uint64(AOwner), LEvents | (uint64(1) shl uint64(AEvent)));
      return ptr(LKey);
    end;

    // AFunc held until it is taken (Take): the key to give Raven as the user_data
    method PutOnce(const AFunc: T): ptr;
    var
      LKey: uint64;
    begin
      self.FOnce := self.FOnce + 1;
      LKey := (uint64(1) shl 63) | self.FOnce;
      self.FByKey.Put(LKey, AFunc);
      return ptr(LKey);
    end;

    // AOwner's closure for its event AEvent, into AFunc: false when none is held for it
    const method Get(const AOwner: Rid; const AEvent: int32; var AFunc: T): bool;
    begin
      return self.FByKey.TryGet((uint64(AOwner) shl 8) | uint64(AEvent), AFunc);
    end;

    // The closure the user_data AData names, into AFunc: false when none is held for it
    const method Find(const AData: ptr; var AFunc: T): bool;
    begin
      return self.FByKey.TryGet(uint64(AData), AFunc);
    end;

    // The closure the user_data AData names, into AFunc, no longer held: false when none
    method Take(const AData: ptr; var AFunc: T): bool;
    begin
      if not self.FByKey.TryGet(uint64(AData), AFunc) then
        return false;
      end;
      self.FByKey.Remove(uint64(AData));
      return true;
    end;

    // The closure the user_data AData names released (none: nothing)
    method Remove(const AData: ptr);
    begin
      self.FByKey.Remove(uint64(AData));
    end;

    // AOwner's closure for its event AEvent released (none: nothing)
    method Clear(const AOwner: Rid; const AEvent: int32);
    var
      LEvents: uint64;
    begin
      self.FByKey.Remove((uint64(AOwner) shl 8) | uint64(AEvent));
      if self.FEvents.TryGet(uint64(AOwner), LEvents) then
        LEvents := LEvents & ~(uint64(1) shl uint64(AEvent));
        if LEvents = 0 then
          self.FEvents.Remove(uint64(AOwner));
        else
          self.FEvents.Put(uint64(AOwner), LEvents);
        end;
      end;
    end;

    // Every closure AOwner holds released (its handle is gone)
    method DropOwner(const AOwner: Rid);
    var
      LEvents: uint64;
      LBit: uint64;
    begin
      if not self.FEvents.TryGet(uint64(AOwner), LEvents) then
        return;
      end;
      for LBit := 0 to 63 do
        if (LEvents & (uint64(1) shl LBit)) <> 0 then
          self.FByKey.Remove((uint64(AOwner) shl 8) | LBit);
        end;
      end;
      self.FEvents.Remove(uint64(AOwner));
    end;

    // Every closure released (the app ends)
    method DropAll();
    begin
      self.FByKey.Clear();
      self.FEvents.Clear();
    end;
  end;

  // A Raven object a <Name>Res handle destroys: once (Release), at the last copy's release or
  // when the app ends first (DoAppShutdown)
  UIResHold = object
    // It owns what it names (false for one Raven could not make)
    Live: bool;
    // Destroyed: the handle's reads give nothing
    Released: bool;

    // Destroys what it names (Raven is still open)
    virtual method Unload();
    begin
    end;

    // Destroys once: nothing for one never made or destroyed already, nothing once Raven
    // has ended (Rshutdown destroyed it with everything else)
    method Release();
    begin
      if not self.Live or self.Released then
        return;
      end;
      self.Released := true;
      if Ris_initialized() <> 0 then
        self.Unload();
      end;
    end;
  end;

  // A timer's holder: the timer destroyed and its closure released with the last copy
  UITimerHold = object(UIResHold)
    FTimer: Rid;
    // Its closure's key (GTimerSlots)
    FKey: ptr;

    done;
    begin
      self.Release();
    end;

    override method Unload();
    begin
      DoTimerGone(self.FTimer, self.FKey);
    end;
  end;

  // The app's holder: the last UIApp copy's release ends Raven (DoAppShutdown), unless
  // UIApp.Shutdown ended it first
  UIAppHold = object
    Ended: bool;

    done;
    begin
      if not self.Ended then
        DoAppShutdown();
      end;
    end;
  end;

var
  // Raven's allocator: Adam's heap (UIAppConfig.DoOpen sets it before Rinit), so a debug build's leak
  // report counts Raven's blocks too
  GRavenAllocator: RAllocator;
  // The app open now (watched, not held: UIApp.Current)
  GAppHold: weak UIAppHold;
  // The <Name>Res holders alive (watched, not held), destroyed by DoAppShutdown before
  // Rshutdown; entries whose holder is gone leave once the list reaches GUIResRoom
  GUIRes: List<weak UIResHold>;
  GUIResRoom: int64;
  // The app's callbacks: one closure each (nil: none set)
  GOnFrame: UIFrameFunc;
  GOnAppEvent: UIAppEventFunc;
  GOnDeviceReset: UITaskFunc;
  GOnNotifyClicked: UITaskFunc;
  GNotifyFallback: UINotifyFunc;
  // UIErrors.OnError's closure (Raven's error callback is global and has no user_data)
  GOnError: UIErrorFunc;
  // Posted tasks (UIApp.Post, any thread), one-shot, under GTaskLock
  GTaskSlots: UISlots<UITaskFunc>;
  GTaskLock: mutex;
  // The timers' closures (one-shot keys, removed with their holder), and the timers' holders
  // by timer (watched)
  GTimerSlots: UISlots<UITimerFunc>;
  GTimerHeld: Map<uint64, weak UITimerHold>;
  // The widgets' closures (UIWidget.On<Event>) by (widget, event): released by the layer's
  // destroy hook when Raven destroys the widget (DoOnWidgetDestroy), every one when the app
  // ends. GWidgetTasks holds OnDestroy (event 0) and OnAccessiblePress (event 1)
  GWidgetTasks: UISlots<UITaskFunc>;
  GWidgetEvents: UISlots<UIEventFunc>;
  GWidgetDrops: UISlots<UIDropFunc>;
  GWidgetTouches: UISlots<UITouchFunc>;
  GWidgetPens: UISlots<UIPenFunc>;
  GWidgetGestures: UISlots<UIGestureFunc>;
  // The widget types' closures (V4: OnClick, OnChanged ..) by (widget, event), released with
  // the widget the same way. Event 0 (ADAM_RAVEN_WIDGET_EVENT) but GControlTexts' commit (1)
  GControlTasks: UISlots<UITaskFunc>;
  GControlToggles: UISlots<UIToggleFunc>;
  GControlIndexes: UISlots<UIIndexFunc>;
  GControlValues: UISlots<UIValueFunc>;
  GControlValues64: UISlots<UIValue64Func>;
  GControlTexts: UISlots<UITextFunc>;
  GControlDates: UISlots<UIDateFunc>;
  GControlTimes: UISlots<UITimeFunc>;
  GControlColors: UISlots<UIColorFunc>;
  GTabCloses: UISlots<UITabCloseFunc>;
  // The windows' closures (UIWindow.On<Event>) by (window, event), and the windows holding
  // any (Raven tells no window's destroy: DoSweepWindows releases a gone one's); every one
  // when the app ends. GWindowBools holds OnBack (event 0) and OnClose (event 1)
  GWindowBools: UISlots<UIAskFunc>;
  GWindowKeyboards: UISlots<UIKeyboardFunc>;
  GWindowResizes: UISlots<UIResizeFunc>;
  GWindowDrops: UISlots<UIDropFunc>;
  GWindowEvents: UISlots<UIEventFunc>;
  GWindowHeld: Map<uint64, bool>;
  // Popups' and dialogs' OnClosed, one-shot (taken when they run)
  GClosedSlots: UISlots<UIClosedFunc>;

// Lists AHold (watched, not held): DoAppShutdown destroys it if it is still alive then. Once
// the list reaches GUIResRoom the watched holders that are gone leave first
func DoTrackRes(const AHold: ref UIResHold);
var
  LWatch: weak UIResHold;
  LI: int64;
begin
  if GUIRes.Count >= GUIResRoom then
    LI := GUIRes.Count - 1;
    while LI >= 0 do
      if not alive(GUIRes.Items[LI]) then
        GUIRes.Delete(LI);
      end;
      LI -= 1;
    end;
    GUIResRoom := GUIRes.Count * 2;
    if GUIResRoom < 64 then
      GUIResRoom := 64;
    end;
  end;
  LWatch := AHold;
  GUIRes.Add(LWatch);
end;

// Raven's allocator over Adam's heap. Raven calls these on any of its threads and takes nil
// for a block the heap cannot give, so the heap's out-of-memory raise is caught here and
// never crosses Raven's C frames
func clink DoRavenAlloc(size: uint64; user_data: ptr): ptr;
var
  LBlock: ptr;
begin
  LBlock := nil;
  guard
    LBlock := getmem(int64(size));
  except
    LBlock := nil;
  end;
  return LBlock;
end;

func clink DoRavenRealloc(ptr_: ptr; size: uint64; user_data: ptr): ptr;
var
  LBlock: ptr;
begin
  LBlock := nil;
  guard
    LBlock := resizemem(ptr_, int64(size));
  except
    LBlock := nil;
  end;
  return LBlock;
end;

func clink DoRavenFree(ptr_: ptr; user_data: ptr);
begin
  if ptr_ <> nil then
    freemem(ptr_);
  end;
end;

// The trampolines: each runs its closure on a copy (one replaced while it runs finishes)
func clink DoOnFrame(delta_seconds: float64; user_data: ptr);
var
  LFunc: UIFrameFunc;
begin
  LFunc := GOnFrame;
  if LFunc <> nil then
    LFunc(delta_seconds);
  end;
end;

func clink DoOnAppEvent(event: RAppEvent; user_data: ptr);
var
  LFunc: UIAppEventFunc;
begin
  LFunc := GOnAppEvent;
  if LFunc <> nil then
    LFunc(UIAppEvent(event));
  end;
end;

func clink DoOnDeviceReset(user_data: ptr);
var
  LFunc: UITaskFunc;
begin
  LFunc := GOnDeviceReset;
  if LFunc <> nil then
    LFunc();
  end;
end;

func clink DoOnNotifyClicked(user_data: ptr);
var
  LFunc: UITaskFunc;
begin
  LFunc := GOnNotifyClicked;
  if LFunc <> nil then
    LFunc();
  end;
end;

func clink DoOnNotifyFallback(title: ptr to const char; body: ptr to const char;
  urgency: RNotificationUrgency; user_data: ptr);
var
  LFunc: UINotifyFunc;
begin
  LFunc := GNotifyFallback;
  if LFunc <> nil then
    LFunc(DoRavenText(title), DoRavenText(body), UIUrgency(urgency));
  end;
end;

func clink DoOnError(code: RError; severity: RSeverity; detail: ptr to const char);
var
  LFunc: UIErrorFunc;
begin
  LFunc := GOnError;
  if LFunc <> nil then
    LFunc(UIErrorCode(code), UISeverity(severity), DoRavenText(detail));
  end;
end;

// UIErrors.Report's handler: one console line per error
func clink DoPrintRavenError(code: RError; severity: RSeverity; detail: ptr to const char);
begin
  println("[Raven] {} ({}): {}", DoRavenText(Rerror_to_string(code)),
    DoRavenText(Rseverity_to_string(severity)), DoRavenText(detail));
end;

// A posted task (UIApp.Post) runs once on the UI thread: taken from its table under the lock,
// run outside it
func clink DoOnTask(user_data: ptr);
var
  LFunc: UITaskFunc;
  LFound: bool;
begin
  lock (GTaskLock) do
    LFound := GTaskSlots.Take(user_data, LFunc);
  end;
  if LFound and (LFunc <> nil) then
    LFunc();
  end;
end;

// The app ends (its last UIApp copy): every <Name>Res still alive destroyed, the newest
// first, every closure the layer holds released, then Raven ends
func DoAppShutdown();
var
  LHold: ref UIResHold;
  LI: int64;
begin
  LI := GUIRes.Count - 1;
  while LI >= 0 do
    LHold := lock(GUIRes.Items[LI]);
    if LHold <> nil then
      LHold.Release();
    end;
    LI -= 1;
  end;
  GUIRes.Clear();
  Rset_frame_callback(nil, nil);
  Rset_app_event_callback(nil, nil);
  Rset_device_reset_callback(nil, nil);
  Rnotification_set_clicked_callback(nil, nil);
  Rnotification_set_fallback(nil, nil);
  GOnFrame := nil;
  GOnAppEvent := nil;
  GOnDeviceReset := nil;
  GOnNotifyClicked := nil;
  GNotifyFallback := nil;
  DoDropSystemUI();
  DoDropHosting();
  Rshutdown();
  DoDropVulkanLock();
  // Raven ran no task left: their closures go after it
  lock (GTaskLock) do
    GTaskSlots.DropAll();
  end;
  GTimerSlots.DropAll();
  GTimerHeld.Clear();
  // Rshutdown destroyed every widget (their OnDestroy run): what is left goes
  DoDropKept();
  GWidgetTasks.DropAll();
  GWidgetEvents.DropAll();
  GWidgetDrops.DropAll();
  GWidgetTouches.DropAll();
  GWidgetPens.DropAll();
  GWidgetGestures.DropAll();
  DoDropControls(R_INVALID_ID);
  GWindowBools.DropAll();
  GWindowKeyboards.DropAll();
  GWindowResizes.DropAll();
  GWindowDrops.DropAll();
  GWindowEvents.DropAll();
  GWindowHeld.Clear();
  GClosedSlots.DropAll();
end;

// A timer's holder is released: the timer destroyed (a one-shot timer that fired is gone
// already: Raven destroyed it), its closure released
func DoTimerGone(const ATimer: Rid; const AKey: ptr);
begin
  if Rtimer_is_valid(ATimer) <> 0 then
    Rtimer_destroy(ATimer);
  end;
  GTimerSlots.Remove(AKey);
  GTimerHeld.Remove(uint64(ATimer));
end;

forward func clink DoOnTimer(timer: Rid; user_data: ptr);

public forward type UIApp;

// ============================================================================
// The app (listing sec 3): one per program, opened by UIAppConfig.Open (or
// UIApp(name)), ended by its last copy's release: every <Name>Res still alive
// is destroyed first, every closure released, then Raven ends. Raven's memory
// is Adam's heap while it runs (a debug build's leak report counts it).
// ============================================================================

public type
  /// How the app opens, built fluently: every method returns the config, `Open` opens the
  /// app. Start one with `UIApp.Config()`. Raven's defaults: the default backend, worker
  /// threads by the CPU count, a render thread, vsync on, no validation, OS windows, the
  /// system's UI scale.
  /// @example `LApp := UIApp.Config().AppName("Notes").Backend(UIBackend.Vulkan).Open();`
  UIAppConfig = object
    hidden FBackend: UIBackend;
    hidden FAppName: string;
    hidden FWorkers: int32;
    hidden FNoRenderThread: bool;
    hidden FNoVsync: bool;
    hidden FValidation: bool;
    hidden FHeadless: bool;
    hidden FUIScale: float32;
    // A setting beyond the backend is set (Rinit_ex, else Rinit)
    hidden FFull: bool;

    /// Raven's defaults (see the type).
    init();
    begin
      self.FBackend := UIBackend.Default;
      self.FAppName := "";
      self.FWorkers := 0;
      self.FNoRenderThread := false;
      self.FNoVsync := false;
      self.FValidation := false;
      self.FHeadless := false;
      self.FUIScale := 0.0f;
      self.FFull := false;
    end;

    /// The application's name (the system's notifications, taskbar and settings show it).
    /// @param AName the name
    /// @returns this object, so calls chain
    method AppName(const AName: string): self;
    begin
      self.FAppName := AName;
      self.FFull := true;
      return self;
    end;

    /// The worker threads Raven runs (0: one a CPU core, the default).
    /// @param ACount how many
    /// @returns this object, so calls chain
    method WorkerThreads(const ACount: int32): self;
    begin
      self.FWorkers := ACount;
      self.FFull := true;
      return self;
    end;

    /// `true` to render on the UI thread rather than a render thread of its own.
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    method NoRenderThread(const AOn: bool): self;
    begin
      self.FNoRenderThread := AOn;
      self.FFull := true;
      return self;
    end;

    /// `true` to draw frames without waiting for the display (vsync off).
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    method NoVsync(const AOn: bool): self;
    begin
      self.FNoVsync := AOn;
      self.FFull := true;
      return self;
    end;

    /// `true` to turn the GPU driver's validation on (slower: finds rendering mistakes).
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    method Validation(const AOn: bool): self;
    begin
      self.FValidation := AOn;
      self.FFull := true;
      return self;
    end;

    /// `true` for no OS window: windows draw off screen and take their input by injection
    /// (tools, tests).
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    method Headless(const AOn: bool): self;
    begin
      self.FHeadless := AOn;
      self.FFull := true;
      return self;
    end;

    /// The UI scale (0: the system's, the default; 2: everything twice as big).
    /// @param AScale the scale
    /// @returns this object, so calls chain
    method UIScale(const AScale: float32): self;
    begin
      self.FUIScale := AScale;
      self.FFull := true;
      return self;
    end;

    /// The renderer (`UIBackend.Null` renders nothing: headless runs and tests).
    /// @param ABackend the backend
    /// @returns this object, so calls chain
    method Backend(const ABackend: UIBackend): self;
    begin
      self.FBackend := ABackend;
      return self;
    end;

    // Opens Raven as this config says (Rinit, or Rinit_ex when more than the backend is
    // set), Adam's heap its allocator; the app's holder, nil when Raven did not open (its
    // error reported) or is open already (the one app a program has)
    hidden const method DoOpen(): ref UIAppHold;
    var
      LDesc: RInitDesc;
      LOpened: int32;
      LHold: ref UIAppHold;
    begin
      if Ris_initialized() <> 0 then
        return nil;
      end;
      GRavenAllocator.alloc := DoRavenAlloc;
      GRavenAllocator.realloc := DoRavenRealloc;
      GRavenAllocator.free := DoRavenFree;
      GRavenAllocator.user_data := nil;
      Rset_allocator(addr of GRavenAllocator);
      if self.FFull then
        LDesc.backend := int32(self.FBackend);
        LDesc.app_name := self.FAppName;
        LDesc.worker_threads := self.FWorkers;
        LDesc.disable_render_thread := DoCBool(self.FNoRenderThread);
        LDesc.disable_vsync := DoCBool(self.FNoVsync);
        LDesc.enable_validation := DoCBool(self.FValidation);
        LDesc.headless := DoCBool(self.FHeadless);
        LDesc.ui_scale := self.FUIScale;
        LOpened := Rinit_ex(addr of LDesc);
      else
        LOpened := Rinit(int32(self.FBackend));
      end;
      if LOpened = 0 then
        return nil;
      end;
      LHold := ref UIAppHold();
      GAppHold := LHold;
      return LHold;
    end;

    /// Opens the app as configured. C: Rinit, Rinit_ex
    /// @returns the app; `IsValid()` false when Raven did not open (its error reported to
    /// `UIErrors`) or an app is open already
    const method Open(): UIApp;
    var
      LHold: ref UIAppHold;
    begin
      // the holder kept here until the app's handle shares it (Current)
      LHold := self.DoOpen();
      if LHold = nil then
        return UIApp();
      end;
      return UIApp.Current();
    end;
  end;

  /// The app: Raven itself, one per program. A shared handle: the last copy's release ends
  /// Raven (every `<Name>Res` still alive destroyed first). Open it with
  /// `UIApp.Config()...Open()` or `UIApp(name)`; run it with `Run()` (a tool) or a loop of
  /// `Frame()` (a game or an engine).
  /// @example `LApp := UIApp("Notes"); LApp.OnFrame(func(const ADelta: float64) begin Tick(ADelta); end); return LApp.Run();`
  UIApp = object
    hidden FHold: ref UIAppHold;

    /// An empty handle (holds no app: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
    end;

    /// Opens the app named `AName` with Raven's defaults: the short form of
    /// `UIApp.Config().AppName(AName).Open()`.
    /// @param AName the name
    init(const AName: string);
    var
      LConfig: UIAppConfig;
    begin
      LConfig.AppName(AName);
      self.FHold := LConfig.Open().FHold;
    end;

    /// A config with Raven's defaults, to open the app with.
    /// @returns a config with Raven's defaults, to open the app with
    static method Config(): UIAppConfig;
    var
      LConfig: UIAppConfig;
    begin
      return LConfig;
    end;

    /// The app open now (an empty handle when none is).
    /// @returns the app open now (an empty handle when none is)
    static method Current(): UIApp;
    var
      LApp: UIApp;
    begin
      LApp.FHold := lock(GAppHold);
      return LApp;
    end;

    /// `true` while this handle holds the open app.
    /// @returns `true` while this handle holds the open app
    const method IsValid(): bool;
    begin
      return (self.FHold <> nil) and (Ris_initialized() <> 0);
    end;

    /// Ends Raven now, before its last handle goes (a host ending its UI before its own
    /// device or window): every `<Name>Res` destroyed, every closure let go; each copy of the
    /// app is then empty (`IsValid()` false). C: Rshutdown
    static method Shutdown();
    var
      LHold: ref UIAppHold;
    begin
      LHold := lock(GAppHold);
      if (LHold = nil) or LHold.Ended or (Ris_initialized() = 0) then
        return;
      end;
      LHold.Ended := true;
      DoAppShutdown();
    end;

    /// `true` while Raven is open (any app). C: Ris_initialized
    /// @returns `true` while Raven is open (any app)
    static method Initialized(): bool;
    begin
      return Ris_initialized() <> 0;
    end;

    /// Raven's version, e.g. `"0.3.0"`. C: Rget_version
    /// @returns raven's version, e.g
    static method Version(): string;
    begin
      return DoRavenText(Rget_version());
    end;

    /// `true` until `Quit` is called or the last window is closed. C: Ris_running
    /// @returns `true` until `Quit` is called or the last window is closed
    const method Running(): bool;
    begin
      return Ris_running() <> 0;
    end;

    /// `true` while the system has the app paused (a phone's app in the background). C:
    /// Ris_app_paused
    /// @returns `true` while the system has the app paused (a phone's app in the background)
    const method Paused(): bool;
    begin
      return Ris_app_paused() <> 0;
    end;

    /// `true` when called on the UI thread (the one that opened the app). C: Ris_ui_thread
    /// @returns `true` when called on the UI thread (the one that opened the app)
    const method OnUIThread(): bool;
    begin
      return Ris_ui_thread() <> 0;
    end;

    /// The exit code `Quit` set (0 when none was). C: Rget_exit_code
    /// @returns the exit code `Quit` set (0 when none was)
    const method ExitCode(): int32;
    begin
      return Rget_exit_code();
    end;

    /// The seconds the last frame took. C: Rget_delta_time
    /// @returns the seconds the last frame took
    const method Delta(): float64;
    begin
      return Rget_delta_time();
    end;

    /// The seconds since the app opened. C: Rget_time
    /// @returns the seconds since the app opened
    const method Time(): float64;
    begin
      return Rget_time();
    end;

    /// Waits for the display before each frame (`true`, the default) or not. C: Rset_vsync
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    method Vsync(const AOn: bool): self;
    begin
      Rset_vsync(DoCBool(AOn));
      return self;
    end;

    /// `true` when frames wait for the display. C: Rget_vsync
    /// @returns `true` when frames wait for the display
    const method Vsync(): bool;
    begin
      return Rget_vsync() <> 0;
    end;

    /// The UI scale (2: everything twice as big). C: Rset_ui_scale
    /// @param AScale the scale
    /// @returns this object, so calls chain
    method UIScale(const AScale: float32): self;
    begin
      Rset_ui_scale(AScale);
      return self;
    end;

    /// The UI scale. C: Rget_ui_scale
    /// @returns the UI scale
    const method UIScale(): float32;
    begin
      return Rget_ui_scale();
    end;

    /// The layout direction of every window (right to left for Arabic or Hebrew). C:
    /// Rset_layout_direction
    /// @param ADirection the direction
    /// @returns this object, so calls chain
    method Direction(const ADirection: UIDirection): self;
    begin
      Rset_layout_direction(int32(ADirection));
      return self;
    end;

    /// The layout direction. C: Rget_layout_direction
    /// @returns the layout direction
    const method Direction(): UIDirection;
    begin
      return UIDirection(Rget_layout_direction());
    end;

    /// Animations on (`true`, the default) or off. C: Rset_animations_enabled
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    method Animations(const AOn: bool): self;
    begin
      Rset_animations_enabled(DoCBool(AOn));
      return self;
    end;

    /// `true` when animations are on. C: Rget_animations_enabled
    /// @returns `true` when animations are on
    const method Animations(): bool;
    begin
      return Rget_animations_enabled() <> 0;
    end;

    /// How fast animations run (1: as designed, 0.5: half speed). C: Rset_animation_speed
    /// @param ASpeed the speed
    /// @returns this object, so calls chain
    method AnimationSpeed(const ASpeed: float32): self;
    begin
      Rset_animation_speed(ASpeed);
      return self;
    end;

    /// How fast animations run. C: Rget_animation_speed
    /// @returns how fast animations run
    const method AnimationSpeed(): float32;
    begin
      return Rget_animation_speed();
    end;

    /// Animations step `ASeconds` each frame rather than by the clock (0: by the clock), for
    /// frames that come out the same every run (recordings, tests). C:
    /// Rset_animation_time_step
    /// @param ASeconds the time, in seconds
    /// @returns this object, so calls chain
    method AnimationStep(const ASeconds: float64): self;
    begin
      Rset_animation_time_step(ASeconds);
      return self;
    end;

    /// The worker threads Raven runs. C: Rget_worker_thread_count
    /// @returns the worker threads Raven runs
    const method WorkerThreads(): int32;
    begin
      return Rget_worker_thread_count();
    end;

    /// Runs the app until `Quit` is called or the last window is closed, drawing a frame
    /// whenever something changed and sleeping between (a tool's loop).
    /// @returns the exit code `Quit` set
    method Run(): int32;
    begin
      while Rwait_frame(-1.0) <> 0 do
      end;
      return Rget_exit_code();
    end;

    /// Draws one frame of every window: processes the pending events, runs the posted tasks
    /// and timers, then lays out and paints what changed (a game's loop calls it each turn).
    /// C: Rdraw_frame
    /// @returns `false` once `Quit` was called or the last window is closed
    method Frame(): bool;
    begin
      return Rdraw_frame() <> 0;
    end;

    /// Sleeps until something happens (an event, a task, a timer) or `ATimeout` seconds pass
    /// (a negative one: no limit), then draws a frame. C: Rwait_frame
    /// @param ATimeout the timeout
    /// @returns `false` once `Quit` was called or the last window is closed
    method WaitFrame(const ATimeout: float64): bool;
    begin
      return Rwait_frame(ATimeout) <> 0;
    end;

    /// Sleeps until an event comes or `ATimeout` seconds pass, drawing nothing. C:
    /// Rwait_events
    /// @param ATimeout the timeout
    method WaitEvents(const ATimeout: float64);
    begin
      Rwait_events(ATimeout);
    end;

    /// Takes the pending OS events, drawing nothing. C: Rpoll_events
    method PollEvents();
    begin
      Rpoll_events();
    end;

    /// Ends the loop with exit code 0 (`Run` returns, `Frame` gives `false`). Any thread. C:
    /// Rquit
    method Quit();
    begin
      Rquit(0);
    end;

    /// Ends the loop with exit code `ACode`. Any thread. C: Rquit
    /// @param ACode the exit code
    method Quit(const ACode: int32);
    begin
      Rquit(ACode);
    end;

    /// Wakes a `WaitFrame` / `WaitEvents` sleeping on the UI thread. Any thread. C: Rwake_up
    method WakeUp();
    begin
      Rwake_up();
    end;

    /// Acts as if the system sent the life-cycle event `AEvent` (tests). C:
    /// Rinject_app_event
    /// @param AEvent the event
    method InjectAppEvent(const AEvent: UIAppEvent);
    begin
      Rinject_app_event(int32(AEvent));
    end;

    /// Runs `AFunc` at every frame with the seconds since the frame before (nil: none). C:
    /// Rset_frame_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    method OnFrame(const AFunc: UIFrameFunc): self;
    begin
      GOnFrame := AFunc;
      if AFunc = nil then
        Rset_frame_callback(nil, nil);
      else
        Rset_frame_callback(DoOnFrame, nil);
      end;
      return self;
    end;

    /// Runs `AFunc` on each life-cycle event (nil: none). C: Rset_app_event_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    method OnAppEvent(const AFunc: UIAppEventFunc): self;
    begin
      GOnAppEvent := AFunc;
      if AFunc = nil then
        Rset_app_event_callback(nil, nil);
      else
        Rset_app_event_callback(DoOnAppEvent, nil);
      end;
      return self;
    end;

    /// Runs `AFunc` after the GPU device was lost and Raven made a new one, on the UI thread,
    /// to rebuild what the program made itself (nil: none). C: Rset_device_reset_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    method OnDeviceReset(const AFunc: UITaskFunc): self;
    begin
      GOnDeviceReset := AFunc;
      if AFunc = nil then
        Rset_device_reset_callback(nil, nil);
      else
        Rset_device_reset_callback(DoOnDeviceReset, nil);
      end;
      return self;
    end;

    /// Runs `AFunc` once on the UI thread, at the next frame. Any thread: the way a worker
    /// hands its result to the UI. C: Rtask_post
    /// @param AFunc the func it runs
    /// @example `LApp.Post(func() begin LStatus.Text("done"); end);`
    method Post(const AFunc: UITaskFunc);
    var
      LKey: ptr;
    begin
      if AFunc = nil then
        return;
      end;
      lock (GTaskLock) do
        LKey := GTaskSlots.PutOnce(AFunc);
      end;
      Rtask_post(DoOnTask, LKey);
    end;

    /// Raven's memory use. C: Rmemory_get_stats
    /// @returns raven's memory use
    const method MemoryStats(): RMemoryStats;
    var
      LStats: RMemoryStats;
    begin
      Rmemory_get_stats(addr of LStats);
      return LStats;
    end;

    /// Checks Raven's memory for damage (a debug aid). C: Rmemory_check
    /// @returns `true` when it is sound
    const method MemoryCheck(): bool;
    begin
      return Rmemory_check() <> 0;
    end;

    /// Gives the memory Raven keeps for reuse back to the heap. C: Rmemory_trim
    method MemoryTrim();
    begin
      Rmemory_trim();
    end;

    /// The clipboard's text ("" when it holds none). C: Rclipboard_get_text
    /// @returns the clipboard's text ("" when it holds none)
    static method ClipboardText(): string;
    begin
      return DoRavenText(Rclipboard_get_text());
    end;

    /// Puts `AText` on the clipboard. C: Rclipboard_set_text
    /// @param AText the text
    static method ClipboardText(const AText: string);
    begin
      Rclipboard_set_text(AText);
    end;

    /// Puts `AText` on the clipboard with `AHTML` as its formatted form (pasted into a
    /// program that takes HTML). C: Rclipboard_set_html
    /// @param AText the text
    /// @param AHTML the HTML
    static method ClipboardHTML(const AText: string; const AHTML: string);
    begin
      Rclipboard_set_html(AText, AHTML);
    end;

    /// Shows a system notification of normal urgency. C: Rnotification_show
    /// @param ATitle the title
    /// @param ABody the body
    /// @returns `true` when the system showed it (or `NotifyFallback`'s routine took it)
    static method Notify(const ATitle: string; const ABody: string): bool;
    begin
      return UIApp.Notify(ATitle, ABody, UIUrgency.Normal);
    end;

    /// Shows a system notification of urgency `AUrgency`. C: Rnotification_show
    /// @param ATitle the title
    /// @param ABody the body
    /// @param AUrgency the urgency
    /// @returns `true` when the system showed it (or `NotifyFallback`'s routine took it)
    static method Notify(const ATitle: string; const ABody: string; const AUrgency: UIUrgency): bool;
    begin
      return Rnotification_show(ATitle, ABody, int32(AUrgency)) <> 0;
    end;

    /// `true` when the system shows notifications. C: Rnotification_is_supported
    /// @returns `true` when the system shows notifications
    static method NotifySupported(): bool;
    begin
      return Rnotification_is_supported() <> 0;
    end;

    /// Runs `AFunc` for a notification the system cannot show, to show it another way (a
    /// toast in the window; nil: none). C: Rnotification_set_fallback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    method NotifyFallback(const AFunc: UINotifyFunc): self;
    begin
      GNotifyFallback := AFunc;
      if AFunc = nil then
        Rnotification_set_fallback(nil, nil);
      else
        Rnotification_set_fallback(DoOnNotifyFallback, nil);
      end;
      return self;
    end;

    /// Runs `AFunc` when the user clicks a notification the app showed (nil: none). C:
    /// Rnotification_set_clicked_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    method OnNotifyClicked(const AFunc: UITaskFunc): self;
    begin
      GOnNotifyClicked := AFunc;
      if AFunc = nil then
        Rnotification_set_clicked_callback(nil, nil);
      else
        Rnotification_set_clicked_callback(DoOnNotifyClicked, nil);
      end;
      return self;
    end;

    /// Shows `AText` as the badge on the app's taskbar button ("" removes it). C:
    /// Rtaskbar_set_badge
    /// @param AText the text
    /// @returns `true` when the system has taskbar badges
    static method TaskbarBadge(const AText: string): bool;
    begin
      return Rtaskbar_set_badge(AText) <> 0;
    end;

    /// The tasks of the app's taskbar jump list, in order (none: it is cleared). C:
    /// Rtaskbar_set_jump_list
    /// @param ATasks the tasks
    /// @returns `true` when the system has jump lists
    static method JumpList(const ATasks: array of UIJumpTask): bool;
    var
      LTexts: array of CString;
      LTasks: array of RJumpTask;
      LI: int64;
    begin
      if len(ATasks) = 0 then
        return Rtaskbar_set_jump_list(nil, 0) <> 0;
      end;
      // the texts kept as C strings while Raven reads them
      setlength(LTexts, len(ATasks) * 3);
      setlength(LTasks, len(ATasks));
      for LI := 0 to len(ATasks) - 1 do
        LTexts[LI * 3] := CString(ATasks[LI].Title);
        LTexts[LI * 3 + 1] := CString(ATasks[LI].Args);
        LTexts[LI * 3 + 2] := CString(ATasks[LI].Description);
        LTasks[LI].title := LTexts[LI * 3].Ptr;
        LTasks[LI].arguments := LTexts[LI * 3 + 1].Ptr;
        LTasks[LI].description := LTexts[LI * 3 + 2].Ptr;
      end;
      return Rtaskbar_set_jump_list(addr of LTasks[0], int32(len(LTasks))) <> 0;
    end;
  end;

  /// Raven's errors: the last one, their texts, a routine run for each, the console report.
  /// Raven reports every error as it happens (a bad id, a missing file, a bad XML
  /// attribute ...); the program sees them through `OnError` or `Report`, or asks `Last`.
  UIErrors = object
    /// The error Raven reported last (`UIErrorCode.None` when none was). C: Rerror_get_last
    /// @returns the error Raven reported last (`UIErrorCode.None` when none was)
    static method Last(): UIRavenError;
    var
      LDetail: ptr to const char;
      LSeverity: RSeverity;
      LCode: RError;
    begin
      LDetail := nil;
      LSeverity := R_SEVERITY_WEAK_WARNING;
      LCode := Rerror_get_last(addr of LDetail, addr of LSeverity);
      return UIRavenError(Code: UIErrorCode(LCode), Severity: UISeverity(LSeverity),
        Detail: DoRavenText(LDetail));
    end;

    /// The name of the error code `ACode`, e.g. `"R_ERROR_INVALID_ID"`. C: Rerror_to_string
    /// @param ACode the error code
    /// @returns the name of the error code `ACode`, e.g
    static method Text(const ACode: UIErrorCode): string;
    begin
      return DoRavenText(Rerror_to_string(int32(ACode)));
    end;

    /// The name of the severity `ASeverity`. C: Rseverity_to_string
    /// @param ASeverity the severity
    /// @returns the name of the severity `ASeverity`
    static method Text(const ASeverity: UISeverity): string;
    begin
      return DoRavenText(Rseverity_to_string(int32(ASeverity)));
    end;

    /// Runs `AFunc` for every error Raven reports, with its code, severity and detail, in
    /// place of `Report`'s console lines (nil: none). Set it before the app opens to see
    /// the errors of opening too. C: Rerror_set_callback
    /// @param AFunc the func it runs
    static method OnError(const AFunc: UIErrorFunc);
    begin
      GOnError := AFunc;
      if AFunc = nil then
        Rerror_set_callback(nil);
      else
        Rerror_set_callback(DoOnError);
      end;
    end;

    /// Writes every error Raven reports on the console, one line each: `[Raven] <code>
    /// (<severity>): <detail>`, in place of an `OnError` routine. Call it before the app
    /// opens so the errors of opening are seen too; `OnError(nil)` turns it off.
    /// @example `UIErrors.Report(); LApp := UIApp("Game");`
    static method Report();
    begin
      GOnError := nil;
      Rerror_set_callback(DoPrintRavenError);
    end;
  end;

  /// A timer: runs its routine every `AInterval` seconds (or once) on the UI thread, during
  /// a frame. A shared handle: the last copy destroys the timer, the app's end too.
  /// C: Rtimer_destroy (the last copy's release)
  /// @example `LTick := UITimerRes(1.0, true, func(const ATimer: UITimerRes) begin Refresh(); end);`
  UITimerRes = object
    hidden FHold: ref UITimerHold;

    /// An empty handle (holds no timer: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
    end;

    /// A timer running `AFunc` after `AInterval` seconds, then again every `AInterval` seconds
    /// when `ARepeat` is `true` (the app must be open). C: Rtimer_create
    /// @param AInterval the interval
    /// @param ARepeat `true` to run again every interval
    /// @param AFunc the func it runs
    init(const AInterval: float64; const ARepeat: bool; const AFunc: UITimerFunc);
    var
      LHold: ref UITimerHold;
      LWatch: weak UITimerHold;
      LKey: ptr;
      LTimer: Rid;
    begin
      if AFunc = nil then
        return;
      end;
      LKey := GTimerSlots.PutOnce(AFunc);
      LTimer := Rtimer_create(AInterval, DoCBool(ARepeat), DoOnTimer, LKey);
      if LTimer = R_INVALID_ID then
        GTimerSlots.Remove(LKey);
        return;
      end;
      LHold := ref UITimerHold();
      LHold.FTimer := LTimer;
      LHold.FKey := LKey;
      LHold.Live := true;
      LWatch := LHold;
      GTimerHeld.Put(uint64(LTimer), LWatch);
      DoTrackRes(LHold);
      self.FHold := LHold;
    end;

    /// `true` while the timer runs (a one-shot timer that fired runs no more). C:
    /// Rtimer_is_valid
    /// @returns `true` while the timer runs (a one-shot timer that fired runs no more)
    const method IsValid(): bool;
    begin
      return (self.FHold <> nil) and not self.FHold.Released and (Rtimer_is_valid(self.FHold.FTimer) <> 0);
    end;

    /// A handle to the timer `ATimer` this layer made (sharing its holder), as its routine is
    /// handed when it fires; an empty handle for any other Rid.
    /// @param ATimer the timer
    /// @returns a handle to the timer `ATimer` this layer made (sharing its holder), as its routine
    ///   is handed when it fires; an empty handle for any other Rid
    static method Of(const ATimer: Rid): UITimerRes;
    var
      LRes: UITimerRes;
      LWatch: weak UITimerHold;
    begin
      if GTimerHeld.TryGet(uint64(ATimer), LWatch) then
        LRes.FHold := lock(LWatch);
      end;
      return LRes;
    end;

    /// The timer's Rid, for .C calls (`R_INVALID_ID` when the handle holds none).
    /// @returns the timer's Rid, for .C calls (`R_INVALID_ID` when the handle holds none)
    const method Id(): Rid;
    begin
      if self.FHold = nil then
        return R_INVALID_ID;
      end;
      return self.FHold.FTimer;
    end;
  end;

// A timer fired: its closure runs with a handle sharing the timer's holder (kept while it runs)
func clink DoOnTimer(timer: Rid; user_data: ptr);
var
  LFunc: UITimerFunc;
begin
  if not GTimerSlots.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  // the handle given is one more copy of the timer's own (its holder kept while it runs)
  LFunc(UITimerRes.Of(timer));
end;

// ============================================================================
// Resources and the theme (listing sec 7): UITextureRes, UIFontRes and
// UIShaderRes are shared handles (the last copy destroys what they name, the
// app's end too); a built-in font or effect, or one a widget reads back, is a
// borrowed handle (`View`: never destroyed by it). Raven keeps no texture,
// font or shader alive for the widget, window or theme showing it, so the
// layer keeps a copy of the handle (UIResKeep) while it is set: released
// with the widget (DoOnWidgetDestroy), the window (DoDropWindow), the font it
// is a fallback or variant of (DoFontGone), or the app (DoDropKept). A tree
// item's icon is kept under its tree (GKeptItemIcons; the layer notes each
// item's tree at AddItem, Raven names none) and let go with the item, its
// tree or the tree's ClearItems. UIPixels is
// decoded RGBA8 pixels (UITextureRes.Decode, window and tray icons). UITheme
// is the app's look, colours, sizes, fonts and the themes loaded from XML.
// ============================================================================

const
  // The parts a widget's (or the theme's) kept handles sit under in GKept*
  ADAM_RAVEN_KEEP_TEXTURE: uint32 = 0;
  ADAM_RAVEN_KEEP_FONT: uint32 = 1;
  ADAM_RAVEN_KEEP_EFFECT: uint32 = 2;
  ADAM_RAVEN_KEEP_ICON: uint32 = 3;
  ADAM_RAVEN_KEEP_BACKGROUND: uint32 = 4;
  ADAM_RAVEN_KEEP_WALLPAPER: uint32 = 5;
  ADAM_RAVEN_KEEP_FALLBACK: uint32 = 6;
  // A label's or text editor's own font (UIWidget's Font is the subtree's: KEEP_FONT)
  ADAM_RAVEN_KEEP_OWN_FONT: uint32 = 7;
  // A font's variant: this + the style's value (UIFontStyle)
  ADAM_RAVEN_KEEP_VARIANT: uint32 = 16;
  // A graph node's icon: this | the node id; a tile's icon: ADAM_RAVEN_KEEP_TILE | its index
  ADAM_RAVEN_KEEP_NODE: uint32 = 2147483648;
  ADAM_RAVEN_KEEP_TILE: uint32 = 1073741824;

public forward type UIFontRes;
forward func DoFontGone(const AFont: Rid);
forward func DoKeepFont(const AOwner: Rid; const APart: uint32; const AFont: UIFontRes);

type
  // A texture's holder: the texture destroyed with the last UITextureRes copy, or when the
  // app ends first (a borrowed one, Live false, never)
  UITextureHold = object(UIResHold)
    FTexture: Rid;

    done;
    begin
      self.Release();
    end;

    override method Unload();
    begin
      Rtexture_destroy(self.FTexture);
    end;
  end;

  // A font's holder; its kept fallback and variants go with it (DoFontGone)
  UIFontHold = object(UIResHold)
    FFont: Rid;

    done;
    begin
      self.Release();
    end;

    override method Unload();
    begin
      Rfont_destroy(self.FFont);
      DoFontGone(self.FFont);
    end;
  end;

  // A shader's holder
  UIShaderHold = object(UIResHold)
    FShader: Rid;

    done;
    begin
      self.Release();
    end;

    override method Unload();
    begin
      Rshader_destroy(self.FShader);
    end;
  end;

  // Handles kept for what shows them, by (owner Rid, part): a copy of the handle is one more
  // owner, so what it names lives while it is kept
  UIResKeep<T> = object
    // The handles by key: (owner shl 32) | part
    hidden FByKey: Map<uint64, T>;
    // The owners keeping any (DropOwner's quick answer for the rest)
    hidden FOwners: Set<uint64>;

    // AValue kept as AOwner's part APart, the one kept there before let go
    method Put(const AOwner: Rid; const APart: uint32; const AValue: T);
    begin
      self.FByKey.Put((uint64(AOwner) shl 32) | uint64(APart), AValue);
      self.FOwners.Add(uint64(AOwner));
    end;

    // AOwner's part APart no longer kept (none: nothing)
    method Remove(const AOwner: Rid; const APart: uint32);
    begin
      self.FByKey.Remove((uint64(AOwner) shl 32) | uint64(APart));
    end;

    // Every part AOwner keeps let go
    method DropOwner(const AOwner: Rid);
    var
      LGone: array of uint64;
      LKey: uint64;
      LI: int64;
    begin
      if not self.FOwners.Remove(uint64(AOwner)) then
        return;
      end;
      setlength(LGone, 0);
      for LKey in self.FByKey.Keys() do
        if (LKey shr 32) = uint64(AOwner) then
          setlength(LGone, len(LGone) + 1);
          LGone[len(LGone) - 1] := LKey;
        end;
      end;
      for LI := 0 to len(LGone) - 1 do
        self.FByKey.Remove(LGone[LI]);
      end;
    end;

    // The parts AOwner keeps (none: empty)
    const method Parts(const AOwner: Rid): array of uint32;
    var
      LParts: array of uint32;
      LKey: uint64;
    begin
      setlength(LParts, 0);
      if not self.FOwners.Has(uint64(AOwner)) then
        return LParts;
      end;
      for LKey in self.FByKey.Keys() do
        if (LKey shr 32) = uint64(AOwner) then
          setlength(LParts, len(LParts) + 1);
          LParts[len(LParts) - 1] := uint32(LKey & 4294967295);
        end;
      end;
      return LParts;
    end;

    // Everything let go (the app ends)
    method DropAll();
    begin
      self.FByKey.Clear();
      self.FOwners.Clear();
    end;
  end;

public type
  /// Decoded pixels: `Width` x `Height`, four bytes each (red, green, blue, alpha), rows from
  /// the top, tightly packed. `UITextureRes.Decode` gives them; textures, window and tray
  /// icons take them.
  /// @example `LIcon := UITextureRes.Decode(LPNG); LWindow.Icon(LIcon);`
  UIPixels = record
    /// The width in pixels.
    Width: int32;
    /// The height in pixels.
    Height: int32;
    /// The pixels: `Width * Height * 4` bytes.
    RGBA: array of uint8;
  end;

  /// A picture on the GPU that images, icons, viewports, backgrounds and painters show: from
  /// an image file (PNG, JPEG, BMP, TGA, GIF, PSD, SVG), its bytes, an SVG text or pixels,
  /// decoded at once or on a worker thread (`Load`). A shared handle: the last copy destroys
  /// the texture (the app's end too); what shows it keeps a copy while it does.
  /// C: Rtexture_* (Rtexture_destroy: the last copy's release)
  /// @example `LLogo := UITextureRes("$P:../../../../res/assets/ui/logo.png"); UIImage.Create().Texture(LLogo).Stretch(UIStretch.Fit);`
  UITextureRes = object
    hidden FHold: ref UITextureHold;

    /// An empty handle (holds no texture: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
    end;

    /// The texture of the image file at `APath` (through the program's IO hooks), decoded
    /// now (empty when it cannot be read; the app must be open). C: Rtexture_create_from_file
    /// @param APath the file's path
    init(const APath: string);
    begin
      self.FHold := UITextureRes.DoMake(Rtexture_create_from_file(APath), true).FHold;
    end;

    // A handle of ATexture (R_INVALID_ID: empty), owning it when AOwned
    hidden static method DoMake(const ATexture: Rid; const AOwned: bool): UITextureRes;
    var
      LRes: UITextureRes;
      LHold: ref UITextureHold;
    begin
      if ATexture = R_INVALID_ID then
        return LRes;
      end;
      LHold := ref UITextureHold();
      LHold.FTexture := ATexture;
      LHold.Live := AOwned;
      if AOwned then
        DoTrackRes(LHold);
      end;
      LRes.FHold := LHold;
      return LRes;
    end;

    /// A borrowed handle of the texture `ATexture` (a Rid System.Raven.C gave): it never
    /// destroys it.
    /// @param ATexture the texture
    /// @returns a borrowed handle of the texture `ATexture` (a Rid System.Raven.C gave): it never
    ///   destroys it
    static method View(const ATexture: Rid): UITextureRes;
    begin
      return UITextureRes.DoMake(ATexture, false);
    end;

    /// The handle owning the texture `ATexture` a System.Raven.C call made (it destroys it with
    /// its last copy, the app's end too).
    /// @param ATexture the texture
    /// @returns the handle owning the texture `ATexture` a System.Raven.C call made (it destroys it
    ///   with its last copy, the app's end too)
    static method Adopt(const ATexture: Rid): UITextureRes;
    begin
      return UITextureRes.DoMake(ATexture, true);
    end;

    /// The texture of the image file read from `AIO` (from where it stands to its end),
    /// decoded now (empty when it cannot be read). C: Rtexture_create
    /// @param AIO the IO
    /// @returns the texture of the image file read from `AIO` (from where it stands to its end),
    ///   decoded now (empty when it cannot be read)
    static method FromIO(const AIO: IO): UITextureRes;
    var
      LData: string;
      LNone: UITextureRes;
    begin
      if not IOReadAll(AIO, LData) or (len(LData) = 0) then
        return LNone;
      end;
      return UITextureRes.DoMake(Rtexture_create(LData, uint64(len(LData))), true);
    end;

    /// The texture of the image file bytes `AData`, decoded now (Raven copies them).
    /// C: Rtexture_create
    /// @param AData the bytes
    /// @returns the texture of the image file bytes `AData`, decoded now (Raven copies them)
    static method FromMemory(const AData: array of uint8): UITextureRes;
    var
      LNone: UITextureRes;
    begin
      if len(AData) = 0 then
        return LNone;
      end;
      return UITextureRes.DoMake(Rtexture_create(ptr to const char(addr of AData[0]),
        uint64(len(AData))), true);
    end;

    /// The SVG text `ASVG` drawn into a texture at `AScale` pixels per SVG unit (widgets show
    /// it at the SVG's own size whatever the scale: `Density`). Paths, fills, strokes and
    /// gradients are drawn; text, filters and masks are not. C: Rtexture_create_from_svg
    /// @param ASVG the SVG
    /// @param AScale the scale
    /// @returns the SVG text `ASVG` drawn into a texture at `AScale` pixels per SVG unit (widgets
    ///   show it at the SVG's own size whatever the scale: `Density`)
    static method FromSVG(const ASVG: string; const AScale: float32): UITextureRes;
    var
      LNone: UITextureRes;
    begin
      if len(ASVG) = 0 then
        return LNone;
      end;
      return UITextureRes.DoMake(Rtexture_create_from_svg(ASVG, uint64(len(ASVG)), AScale),
        true);
    end;

    /// A texture of the pixels `APixels` (empty when they hold fewer bytes than their size
    /// needs). C: Rtexture_create_from_pixels
    /// @param APixels the pixels
    /// @returns a texture of the pixels `APixels` (empty when they hold fewer bytes than their size
    ///   needs)
    static method FromPixels(const APixels: UIPixels): UITextureRes;
    var
      LNone: UITextureRes;
    begin
      if (APixels.Width <= 0) or (APixels.Height <= 0) or
        (int64(len(APixels.RGBA)) < int64(APixels.Width) * int64(APixels.Height) * 4) then
        return LNone;
      end;
      return UITextureRes.DoMake(Rtexture_create_from_pixels(addr of APixels.RGBA[0],
        APixels.Width, APixels.Height), true);
    end;

    /// The texture of the image file at `APath`, decoded on a worker thread: the handle is
    /// usable at once, what shows it draws nothing until it is `Ready`.
    /// C: Rtexture_create_from_file_async
    /// @param APath the file's path
    /// @returns the texture of the image file at `APath`, decoded on a worker thread: the handle is
    ///   usable at once, what shows it draws nothing until it is `Ready`
    static method Load(const APath: string): UITextureRes;
    begin
      return UITextureRes.DoMake(Rtexture_create_from_file_async(APath), true);
    end;

    /// The texture of the image file bytes `AData`, decoded on a worker thread (Raven copies
    /// them), as `Load`. C: Rtexture_create_async
    /// @param AData the bytes
    /// @returns the texture of the image file bytes `AData`, decoded on a worker thread (Raven
    ///   copies them), as `Load`
    static method LoadMemory(const AData: array of uint8): UITextureRes;
    var
      LNone: UITextureRes;
    begin
      if len(AData) = 0 then
        return LNone;
      end;
      return UITextureRes.DoMake(Rtexture_create_async(ptr to const char(addr of AData[0]),
        uint64(len(AData))), true);
    end;

    /// The image file bytes `AData` decoded to pixels, on the calling thread (any thread),
    /// with no texture made: empty pixels (Width 0) when Raven cannot read them.
    /// C: Rimage_decode, Rpixels_free
    /// @param AData the bytes
    /// @returns the image file bytes `AData` decoded to pixels, on the calling thread (any thread),
    ///   with no texture made: empty pixels (Width 0) when Raven cannot read them
    static method Decode(const AData: array of uint8): UIPixels;
    var
      LPixels: UIPixels;
      LData: ptr to uint8;
      LWidth: int32;
      LHeight: int32;
      LI: int64;
    begin
      LPixels.Width := 0;
      LPixels.Height := 0;
      setlength(LPixels.RGBA, 0);
      if len(AData) = 0 then
        return LPixels;
      end;
      LWidth := 0;
      LHeight := 0;
      LData := Rimage_decode(addr of AData[0], uint64(len(AData)), addr of LWidth,
        addr of LHeight);
      if LData = nil then
        return LPixels;
      end;
      LPixels.Width := LWidth;
      LPixels.Height := LHeight;
      setlength(LPixels.RGBA, int64(LWidth) * int64(LHeight) * 4);
      for LI := 0 to len(LPixels.RGBA) - 1 do
        LPixels.RGBA[LI] := LData[LI];
      end;
      Rpixels_free(LData);
      return LPixels;
    end;

    /// `true` while it holds a texture Raven still has. C: Rtexture_is_valid
    /// @returns `true` while it holds a texture Raven still has
    const method IsValid(): bool;
    begin
      return (self.Id() <> R_INVALID_ID) and (Rtexture_is_valid(self.Id()) <> 0);
    end;

    /// The texture's Rid, for .C calls (`R_INVALID_ID` when the handle holds none or it is
    /// destroyed).
    /// @returns the texture's Rid, for .C calls (`R_INVALID_ID` when the handle holds none or it is
    ///   destroyed)
    const method Id(): Rid;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return R_INVALID_ID;
      end;
      return self.FHold.FTexture;
    end;

    /// `true` once it is decoded (always for one decoded at once). C: Rtexture_is_ready
    /// @returns `true` once it is decoded (always for one decoded at once)
    const method Ready(): bool;
    begin
      return Rtexture_is_ready(self.Id()) <> 0;
    end;

    /// Waits until a texture decoding on a worker thread is ready. C: Rtexture_wait
    /// @returns this object, so calls chain
    const method Wait(): self;
    begin
      Rtexture_wait(self.Id());
      return self;
    end;

    /// Its size in pixels (0 x 0 while it is not ready). C: Rtexture_get_size
    /// @returns its size in pixels (0 x 0 while it is not ready)
    const method Size(): UISize;
    var
      LWidth: int32;
      LHeight: int32;
    begin
      LWidth := 0;
      LHeight := 0;
      Rtexture_get_size(self.Id(), addr of LWidth, addr of LHeight);
      return UISize(w: float32(LWidth), h: float32(LHeight));
    end;

    /// Its pixels per logical unit: an SVG's scale, 1 otherwise. C: Rtexture_get_density
    /// @returns its pixels per logical unit: an SVG's scale, 1 otherwise
    const method Density(): float32;
    begin
      return Rtexture_get_density(self.Id());
    end;

    /// Its pixels replaced by `APixels` (their size may differ; nothing when they hold fewer
    /// bytes than their size needs). C: Rtexture_update
    /// @param APixels the pixels
    /// @returns this object, so calls chain
    const method Update(const APixels: UIPixels): self;
    begin
      if (APixels.Width <= 0) or (APixels.Height <= 0) or
        (int64(len(APixels.RGBA)) < int64(APixels.Width) * int64(APixels.Height) * 4) then
        return self;
      end;
      Rtexture_update(self.Id(), addr of APixels.RGBA[0], APixels.Width, APixels.Height);
      return self;
    end;

    /// How it is sampled when drawn at another size. C: Rtexture_set_filter
    /// @param AFilter the filter
    /// @returns this object, so calls chain
    const method Filter(const AFilter: UIFilter): self;
    begin
      Rtexture_set_filter(self.Id(), int32(AFilter));
      return self;
    end;
  end;

  /// A font for text: a TrueType / OpenType file's bytes (copied; glyphs drawn at the exact
  /// size each window scale needs), or the built-in Roboto (`Default`) and its fixed-width
  /// companion (`Monospace`). A shared handle: the last copy destroys the font (the app's end
  /// too); what shows it keeps a copy while it does. C: Rfont_* (Rfont_destroy: the last
  /// copy's release)
  /// @example `LFont := UIFontRes("$P:../../../../res/assets/fonts/Inter.ttf"); UITheme.Font(LFont);`
  UIFontRes = object
    hidden FHold: ref UIFontHold;

    /// An empty handle (holds no font: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
    end;

    /// The font file at `APath` (through the program's IO hooks; empty when it cannot be
    /// read; the app must be open). C: Rfont_create_from_file
    /// @param APath the file's path
    init(const APath: string);
    begin
      self.FHold := UIFontRes.DoMake(Rfont_create_from_file(APath), true).FHold;
    end;

    // A handle of AFont (R_INVALID_ID: empty), owning it when AOwned
    hidden static method DoMake(const AFont: Rid; const AOwned: bool): UIFontRes;
    var
      LRes: UIFontRes;
      LHold: ref UIFontHold;
    begin
      if AFont = R_INVALID_ID then
        return LRes;
      end;
      LHold := ref UIFontHold();
      LHold.FFont := AFont;
      LHold.Live := AOwned;
      if AOwned then
        DoTrackRes(LHold);
      end;
      LRes.FHold := LHold;
      return LRes;
    end;

    /// A borrowed handle of the font `AFont` (a Rid System.Raven.C gave): it never destroys
    /// it.
    /// @param AFont the font
    /// @returns a borrowed handle of the font `AFont` (a Rid System.Raven.C gave): it never
    ///   destroys it
    static method View(const AFont: Rid): UIFontRes;
    begin
      return UIFontRes.DoMake(AFont, false);
    end;

    /// The font file read from `AIO` (from where it stands to its end; empty when it cannot
    /// be read). C: Rfont_create
    /// @param AIO the IO
    /// @returns the font file read from `AIO` (from where it stands to its end; empty when it
    ///   cannot be read)
    static method FromIO(const AIO: IO): UIFontRes;
    var
      LData: string;
      LNone: UIFontRes;
    begin
      if not IOReadAll(AIO, LData) or (len(LData) = 0) then
        return LNone;
      end;
      return UIFontRes.DoMake(Rfont_create(LData, uint64(len(LData))), true);
    end;

    /// The font file bytes `AData` (Raven copies them). C: Rfont_create
    /// @param AData the bytes
    /// @returns the font file bytes `AData` (Raven copies them)
    static method FromMemory(const AData: array of uint8): UIFontRes;
    var
      LNone: UIFontRes;
    begin
      if len(AData) = 0 then
        return LNone;
      end;
      return UIFontRes.DoMake(Rfont_create(ptr to const char(addr of AData[0]),
        uint64(len(AData))), true);
    end;

    /// The font built into Raven (Roboto: Latin and Latin Extended-A), borrowed.
    /// C: Rfont_get_default
    /// @returns the font built into Raven (Roboto: Latin and Latin Extended-A), borrowed
    static method Default(): UIFontRes;
    begin
      return UIFontRes.View(Rfont_get_default());
    end;

    /// The fixed-width font built into Raven (code, the text editor with a language),
    /// borrowed. C: Rfont_get_monospace
    /// @returns the fixed-width font built into Raven (code, the text editor with a language),
    ///   borrowed
    static method Monospace(): UIFontRes;
    begin
      return UIFontRes.View(Rfont_get_monospace());
    end;

    /// `true` while it holds a font Raven still has. C: Rfont_is_valid
    /// @returns `true` while it holds a font Raven still has
    const method IsValid(): bool;
    begin
      return (self.Id() <> R_INVALID_ID) and (Rfont_is_valid(self.Id()) <> 0);
    end;

    /// The font's Rid, for .C calls (`R_INVALID_ID` when the handle holds none or it is
    /// destroyed).
    /// @returns the font's Rid, for .C calls (`R_INVALID_ID` when the handle holds none or it is
    ///   destroyed)
    const method Id(): Rid;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return R_INVALID_ID;
      end;
      return self.FHold.FFont;
    end;

    /// `AFallback` draws the characters this font lacks (an empty handle: none); kept while
    /// this font lives. C: Rfont_set_fallback
    /// @param AFallback the fallback
    /// @returns this object, so calls chain
    const method Fallback(const AFallback: UIFontRes): self;
    begin
      if self.Id() = R_INVALID_ID then
        return self;
      end;
      Rfont_set_fallback(self.Id(), AFallback.Id());
      DoKeepFont(self.Id(), ADAM_RAVEN_KEEP_FALLBACK, AFallback);
      return self;
    end;

    /// `AVariant` drawn for the style `AStyle` of this font (bold, italic ..; an empty
    /// handle: the one Raven derives, glyphs thickened or slanted); kept while this font
    /// lives. C: Rfont_set_variant
    /// @param AStyle the style
    /// @param AVariant the variant
    /// @returns this object, so calls chain
    const method Variant(const AStyle: UIFontStyle; const AVariant: UIFontRes): self;
    begin
      if self.Id() = R_INVALID_ID then
        return self;
      end;
      Rfont_set_variant(self.Id(), int32(AStyle), AVariant.Id());
      DoKeepFont(self.Id(), ADAM_RAVEN_KEEP_VARIANT + uint32(int32(AStyle)), AVariant);
      return self;
    end;

    /// The font drawn for the style `AStyle` of this one: the variant given, else the one
    /// Raven derives (it lives as long as this font), borrowed. C: Rfont_get_variant
    /// @param AStyle the style
    /// @returns the font drawn for the style `AStyle` of this one: the variant given, else the one
    ///   Raven derives (it lives as long as this font), borrowed
    const method Variant(const AStyle: UIFontStyle): UIFontRes;
    begin
      return UIFontRes.View(Rfont_get_variant(self.Id(), int32(AStyle)));
    end;

    /// The size of `AText` (UTF-8, `\n` starting lines) at the font size `ASize` (0: the
    /// theme's), in logical units at scale 1; an empty handle measures with the theme's font.
    /// C: Rfont_measure_text
    /// @param ASize the size
    /// @param AText the text
    /// @returns the size of `AText` (UTF-8, `\n` starting lines) at the font size `ASize` (0: the
    ///   theme's), in logical units at scale 1; an empty handle measures with the theme's font
    const method Measure(const ASize: float32; const AText: string): UISize;
    var
      LWidth: float32;
      LHeight: float32;
    begin
      LWidth := 0.0f;
      LHeight := 0.0f;
      Rfont_measure_text(self.Id(), ASize, AText, addr of LWidth, addr of LHeight);
      return UISize(w: LWidth, h: LHeight);
    end;
  end;

  /// A GPU effect: a SPIR-V fragment shader (written against Raven's raven_effect.glsl) that
  /// borders and painters draw, or one of Raven's built-in effects (`Effect`, borrowed). A
  /// shared handle: the last copy destroys the shader (the app's end too); what shows it keeps
  /// a copy while it does. C: Rshader_*, Reffect_* (Rshader_destroy: the last copy's release)
  /// @example `LWave := UIShaderRes("$P:wave.spv", []); LBorder.Effect(LWave, LWave.Defaults());`
  UIShaderRes = object
    hidden FHold: ref UIShaderHold;

    /// An empty handle (holds no shader: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
    end;

    /// The SPIR-V file at `APath` (a .spv; through the program's IO hooks), drawn as
    /// `AFlags` say (empty when it cannot be read). C: Rshader_create_from_file
    /// @param APath the file's path
    /// @param AFlags the flags
    init(const APath: string; const AFlags: UIShaderFlags);
    begin
      self.FHold := UIShaderRes.DoMake(Rshader_create_from_file(APath, uint32(AFlags)),
        true).FHold;
    end;

    // A handle of AShader (R_INVALID_ID: empty), owning it when AOwned
    hidden static method DoMake(const AShader: Rid; const AOwned: bool): UIShaderRes;
    var
      LRes: UIShaderRes;
      LHold: ref UIShaderHold;
    begin
      if AShader = R_INVALID_ID then
        return LRes;
      end;
      LHold := ref UIShaderHold();
      LHold.FShader := AShader;
      LHold.Live := AOwned;
      if AOwned then
        DoTrackRes(LHold);
      end;
      LRes.FHold := LHold;
      return LRes;
    end;

    /// A borrowed handle of the shader `AShader` (a Rid System.Raven.C gave): it never
    /// destroys it.
    /// @param AShader the shader
    /// @returns a borrowed handle of the shader `AShader` (a Rid System.Raven.C gave): it never
    ///   destroys it
    static method View(const AShader: Rid): UIShaderRes;
    begin
      return UIShaderRes.DoMake(AShader, false);
    end;

    /// The SPIR-V code `ASPIRV` (copied), drawn as `AFlags` say: empty when the code is not
    /// SPIR-V (a backend that refuses it reports an error and draws a rectangle).
    /// C: Rshader_create
    /// @param ASPIRV the SPIRV
    /// @param AFlags the flags
    /// @returns the SPIR-V code `ASPIRV` (copied), drawn as `AFlags` say: empty when the code is
    ///   not SPIR-V (a backend that refuses it reports an error and draws a rectangle)
    static method FromSPIRV(const ASPIRV: array of uint8; const AFlags: UIShaderFlags):
      UIShaderRes;
    var
      LNone: UIShaderRes;
    begin
      if len(ASPIRV) = 0 then
        return LNone;
      end;
      return UIShaderRes.DoMake(Rshader_create(addr of ASPIRV[0], uint64(len(ASPIRV)),
        uint32(AFlags)), true);
    end;

    /// The built-in effect `AEffect` (made the first time it is asked for), borrowed.
    /// C: Reffect_get
    /// @param AEffect the effect
    /// @returns the built-in effect `AEffect` (made the first time it is asked for), borrowed
    static method Effect(const AEffect: UIEffect): UIShaderRes;
    begin
      return UIShaderRes.View(Reffect_get(int32(AEffect)));
    end;

    /// The built-in effect named `AName` ("aurora", "shimmer", "neon", "ripple", "plasma",
    /// "grain", "spotlight", "mesh"), borrowed; empty for another name. C: Reffect_find
    /// @param AName the name
    /// @returns the built-in effect named `AName` ("aurora", "shimmer", "neon", "ripple", "plasma",
    ///   "grain", "spotlight", "mesh"), borrowed; empty for another name
    static method Effect(const AName: string): UIShaderRes;
    begin
      return UIShaderRes.View(Reffect_find(AName));
    end;

    /// The name of the built-in effect `AEffect` ("aurora" ..). C: Reffect_get_name
    /// @param AEffect the effect
    /// @returns the name of the built-in effect `AEffect` ("aurora" ..)
    static method EffectName(const AEffect: UIEffect): string;
    begin
      return DoRavenText(Reffect_get_name(int32(AEffect)));
    end;

    /// The look the built-in effect `AEffect` is drawn with when none is given.
    /// C: Reffect_get_defaults
    /// @param AEffect the effect
    /// @returns the look the built-in effect `AEffect` is drawn with when none is given
    static method EffectDefaults(const AEffect: UIEffect): RShaderLook;
    var
      LLook: RShaderLook;
    begin
      Reffect_get_defaults(int32(AEffect), addr of LLook);
      return LLook;
    end;

    /// A look with Raven's starting values (colours, parameters, radius, animation), to
    /// change and hand to `UIBorder.Effect` or `UIPainter.Shader`. C: Rshader_look_init
    /// @returns a look with Raven's starting values (colours, parameters, radius, animation), to
    ///   change and hand to `UIBorder.Effect` or `UIPainter.Shader`
    static method Look(): RShaderLook;
    var
      LLook: RShaderLook;
    begin
      Rshader_look_init(addr of LLook);
      return LLook;
    end;

    /// `true` while it holds a shader Raven still has. C: Rshader_is_valid
    /// @returns `true` while it holds a shader Raven still has
    const method IsValid(): bool;
    begin
      return (self.Id() <> R_INVALID_ID) and (Rshader_is_valid(self.Id()) <> 0);
    end;

    /// The shader's Rid, for .C calls (`R_INVALID_ID` when the handle holds none or it is
    /// destroyed).
    /// @returns the shader's Rid, for .C calls (`R_INVALID_ID` when the handle holds none or it is
    ///   destroyed)
    const method Id(): Rid;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return R_INVALID_ID;
      end;
      return self.FHold.FShader;
    end;

    /// How it is drawn (`UIShaderFlag.Backdrop`: it reads what is behind it; `Animated`:
    /// redrawn every frame). C: Rshader_get_flags
    /// @returns how it is drawn (`UIShaderFlag.Backdrop`: it reads what is behind it; `Animated`:
    ///   redrawn every frame)
    const method Flags(): UIShaderFlags;
    begin
      return UIShaderFlags(Rshader_get_flags(self.Id()));
    end;

    /// The look it is drawn with when none is given (a built-in effect's own, else
    /// `UIShaderRes.Look()`'s). C: Rshader_look_defaults
    /// @returns the look it is drawn with when none is given (a built-in effect's own, else
    ///   `UIShaderRes.Look()`'s)
    const method Defaults(): RShaderLook;
    var
      LLook: RShaderLook;
    begin
      Rshader_look_defaults(self.Id(), addr of LLook);
      return LLook;
    end;
  end;

var
  // The textures, fonts and shaders kept for what shows them (UIResKeep)
  GKeptTextures: UIResKeep<UITextureRes>;
  GKeptFonts: UIResKeep<UIFontRes>;
  GKeptShaders: UIResKeep<UIShaderRes>;
  // Tree item icons, under their tree (owner the tree, part the item's Rid): their own keep,
  // since an item's Rid may equal one of the fixed ADAM_RAVEN_KEEP_* parts; an item whose
  // tree the layer never saw sits under R_INVALID_ID until Raven deletes it
  GKeptItemIcons: UIResKeep<UITextureRes>;
  // The tree of each item the layer added (UITreeView.AddItem) or found under one
  GItemTrees: Map<uint64, Rid>;
  // The trees with any item in GItemTrees
  GItemTreesOf: Set<uint64>;

// AFont is destroyed: the fallback and variants kept for it let go
func DoFontGone(const AFont: Rid);
begin
  GKeptFonts.DropOwner(AFont);
end;

// What AOwner (a widget or a window, gone) kept let go
func DoDropKeptOf(const AOwner: Rid);
begin
  GKeptTextures.DropOwner(AOwner);
  GKeptFonts.DropOwner(AOwner);
  GKeptShaders.DropOwner(AOwner);
end;

// Everything kept let go (the app ends: DoAppShutdown)
func DoDropKept();
begin
  GKeptTextures.DropAll();
  GKeptFonts.DropAll();
  GKeptShaders.DropAll();
  GKeptItemIcons.DropAll();
  GItemTrees.Clear();
  GItemTreesOf.Clear();
end;

// ATexture kept as AOwner's part APart while it holds one, else the part let go
func DoKeepTexture(const AOwner: Rid; const APart: uint32; const ATexture: UITextureRes);
begin
  if ATexture.Id() = R_INVALID_ID then
    GKeptTextures.Remove(AOwner, APart);
  else
    GKeptTextures.Put(AOwner, APart, ATexture);
  end;
end;

// AFont kept as AOwner's part APart while it holds one, else the part let go
func DoKeepFont(const AOwner: Rid; const APart: uint32; const AFont: UIFontRes);
begin
  if AFont.Id() = R_INVALID_ID then
    GKeptFonts.Remove(AOwner, APart);
  else
    GKeptFonts.Put(AOwner, APart, AFont);
  end;
end;

// AShader kept as AOwner's part APart while it holds one, else the part let go
func DoKeepShader(const AOwner: Rid; const APart: uint32; const AShader: UIShaderRes);
begin
  if AShader.Id() = R_INVALID_ID then
    GKeptShaders.Remove(AOwner, APart);
  else
    GKeptShaders.Put(AOwner, APart, AShader);
  end;
end;

public type
  /// The app's theme: the look (`Look`), dark or light, the colours, sizes,
  /// material and font every widget takes unless it has its own, styles by widget kind and
  /// class, the text editor's token colours, and themes loaded from XML (laid over the
  /// built-in ones, kept through a look switch) and used by name. All static.
  /// C: Rtheme_*, Rlook_*
  /// @example `UITheme.Look(UILook.RavenGlassDark); UITheme.Accent(UIColor.FromHex("#3a7bd5", UIColor.Black())); UITheme.Metric(UIMetric.CornerRadius, 10.0f);`
  UITheme = object
    /// The look (Raven's own or glass, dark or light): the sizes set with `Metric` stay;
    /// colours and styles set here are lost (put them in a loaded theme to keep them).
    /// C: Rlook_set
    /// @param ALook the look
    static method Look(const ALook: UILook);
    begin
      Rlook_set(int32(ALook));
    end;

    /// The look in use. C: Rlook_get
    /// @returns the look in use
    static method Look(): UILook;
    begin
      return UILook(Rlook_get());
    end;

    /// Dark (`true`) or light colours for the look in use. C: Rtheme_set_dark
    /// @param AOn `true` to turn it on, `false` to turn it off
    static method Dark(const AOn: bool);
    begin
      Rtheme_set_dark(DoCBool(AOn));
    end;

    /// `true` while the colours are dark. C: Rtheme_is_dark
    /// @returns `true` while the colours are dark
    static method Dark(): bool;
    begin
      return Rtheme_is_dark() <> 0;
    end;

    /// Dark or light following the system's setting as it changes (`true`). C:
    /// Rtheme_follow_system
    /// @param AOn `true` to turn it on, `false` to turn it off
    static method FollowSystem(const AOn: bool);
    begin
      Rtheme_follow_system(DoCBool(AOn));
    end;

    /// `true` when the system is set to dark. C: Rtheme_get_system_dark
    /// @returns `true` when the system is set to dark
    static method SystemDark(): bool;
    begin
      return Rtheme_get_system_dark() <> 0;
    end;

    /// The accent colour (its alpha unused): selections, focus, the default buttons.
    /// C: Rtheme_set_accent
    /// @param AColor the colour
    static method Accent(const AColor: UIColor);
    begin
      Rtheme_set_accent(AColor.r, AColor.g, AColor.b);
    end;

    /// The picture behind the windows with no background of their own (an empty handle: the
    /// window colour); kept while it is set. C: Rtheme_set_wallpaper
    /// @param ATexture the texture
    static method Wallpaper(const ATexture: UITextureRes);
    begin
      Rtheme_set_wallpaper(ATexture.Id());
      DoKeepTexture(R_INVALID_ID, ADAM_RAVEN_KEEP_WALLPAPER, ATexture);
    end;

    /// The wallpaper, borrowed (empty for none). C: Rtheme_get_wallpaper
    /// @returns the wallpaper, borrowed (empty for none)
    static method Wallpaper(): UITextureRes;
    begin
      return UITextureRes.View(Rtheme_get_wallpaper());
    end;

    /// The colour of `ARole` for every widget with none of its own. C: Rtheme_set_color
    /// @param ARole the role
    /// @param AColor the colour
    static method Color(const ARole: UIColorRole; const AColor: UIColor);
    begin
      Rtheme_set_color(int32(ARole), AColor.r, AColor.g, AColor.b, AColor.a);
    end;

    /// The colour of `ARole`. C: Rtheme_get_color
    /// @param ARole the role
    /// @returns the colour of `ARole`
    static method Color(const ARole: UIColorRole): UIColor;
    var
      LColor: UIColor;
    begin
      Rtheme_get_color(int32(ARole), addr of LColor.r, addr of LColor.g, addr of LColor.b,
        addr of LColor.a);
      return LColor;
    end;

    /// The size `AMetric` (font size, corner radius, paddings ..) for every widget with none
    /// of its own; kept through a look switch. C: Rtheme_set_metric
    /// @param AMetric the metric
    /// @param AValue the value
    static method Metric(const AMetric: UIMetric; const AValue: float32);
    begin
      Rtheme_set_metric(int32(AMetric), AValue);
    end;

    /// The size `AMetric`. C: Rtheme_get_metric
    /// @param AMetric the metric
    /// @returns the size `AMetric`
    static method Metric(const AMetric: UIMetric): float32;
    begin
      return Rtheme_get_metric(int32(AMetric));
    end;

    /// What the panels are made of (solid or a glass). C: Rtheme_set_material
    /// @param AMaterial the material
    static method Material(const AMaterial: UIMaterial);
    begin
      Rtheme_set_material(int32(AMaterial));
    end;

    /// The material in use. C: Rtheme_get_material
    /// @returns the material in use
    static method Material(): UIMaterial;
    begin
      return UIMaterial(Rtheme_get_material());
    end;

    /// The font of every text with none of its own (an empty handle: Raven's own); kept
    /// while it is set. C: Rtheme_set_font
    /// @param AFont the font
    static method Font(const AFont: UIFontRes);
    begin
      Rtheme_set_font(AFont.Id());
      DoKeepFont(R_INVALID_ID, ADAM_RAVEN_KEEP_FONT, AFont);
    end;

    /// The theme's font, borrowed. C: Rtheme_get_font
    /// @returns the theme's font, borrowed
    static method Font(): UIFontRes;
    begin
      return UIFontRes.View(Rtheme_get_font());
    end;

    /// The colour of `ARole` for the widgets of the kind `AWidget` (its XML name: "Button"
    /// ..; "": every kind) with the style class `AClass` ("": whatever their classes); a
    /// style naming a kind and a class wins over one naming a class, over one naming a kind.
    /// C: Rtheme_set_style_color
    /// @param AWidget the widget
    /// @param AClass the class name
    /// @param ARole the role
    /// @param AColor the colour
    static method StyleColor(const AWidget: string; const AClass: string;
      const ARole: UIColorRole; const AColor: UIColor);
    var
      LWidget: CString;
      LClass: CString;
    begin
      LWidget := CString(AWidget);
      LClass := CString(AClass);
      Rtheme_set_style_color(LWidget.OrNil, LClass.OrNil, int32(ARole), AColor.r, AColor.g,
        AColor.b, AColor.a);
    end;

    /// The size `AMetric` for the widgets of the kind `AWidget` ("": every kind) with the
    /// style class `AClass` ("": whatever their classes), as `StyleColor`.
    /// C: Rtheme_set_style_metric
    /// @param AWidget the widget
    /// @param AClass the class name
    /// @param AMetric the metric
    /// @param AValue the value
    static method StyleMetric(const AWidget: string; const AClass: string;
      const AMetric: UIMetric; const AValue: float32);
    var
      LWidget: CString;
      LClass: CString;
    begin
      LWidget := CString(AWidget);
      LClass := CString(AClass);
      Rtheme_set_style_metric(LWidget.OrNil, LClass.OrNil, int32(AMetric), AValue);
    end;

    /// The material of the widgets of the kind `AWidget` ("": every kind) with the style
    /// class `AClass` ("": whatever their classes), as `StyleColor`.
    /// C: Rtheme_set_style_material
    /// @param AWidget the widget
    /// @param AClass the class name
    /// @param AMaterial the material
    static method StyleMaterial(const AWidget: string; const AClass: string;
      const AMaterial: UIMaterial);
    var
      LWidget: CString;
      LClass: CString;
    begin
      LWidget := CString(AWidget);
      LClass := CString(AClass);
      Rtheme_set_style_material(LWidget.OrNil, LClass.OrNil, int32(AMaterial));
    end;

    /// Every style set by kind and class removed. C: Rtheme_clear_styles
    static method ClearStyles();
    begin
      Rtheme_clear_styles();
    end;

    /// The text editors' colour of the token kind `AToken`. C: Rtheme_set_token_color
    /// @param AToken the token
    /// @param AColor the colour
    static method TokenColor(const AToken: UITokenKind; const AColor: UIColor);
    begin
      Rtheme_set_token_color(int32(AToken), AColor.r, AColor.g, AColor.b, AColor.a);
    end;

    /// The text editors' colour of the token kind `AToken`. C: Rtheme_get_token_color
    /// @param AToken the token
    /// @returns the text editors' colour of the token kind `AToken`
    static method TokenColor(const AToken: UITokenKind): UIColor;
    var
      LColor: UIColor;
    begin
      Rtheme_get_token_color(int32(AToken), addr of LColor.r, addr of LColor.g,
        addr of LColor.b, addr of LColor.a);
      return LColor;
    end;

    /// The token colours back to the look's. C: Rtheme_clear_token_colors
    static method ClearTokenColors();
    begin
      Rtheme_clear_token_colors();
    end;

    /// Loads the theme file (XML) at `APath`, ready to `Use`; loading a theme of a name that
    /// is loaded already updates every widget using it.
    /// @param APath the file's path
    /// @returns The theme's name; "" (the error reported) when it cannot be loaded.
    /// C: Rtheme_load
    static method Load(const APath: string): string;
    begin
      return DoRavenText(Rtheme_load(APath));
    end;

    /// Loads a theme from the XML text `AXML`, as `Load`. C: Rtheme_load_from_memory
    /// @param AXML the XML text
    /// @returns the theme's name; "" (the error reported) when it cannot be loaded
    static method LoadText(const AXML: string): string;
    begin
      return DoRavenText(Rtheme_load_from_memory(AXML, uint64(len(AXML))));
    end;

    /// The theme named `AName` (a built-in one, "Dark" .., or one loaded) for the app.
    /// @param AName the name
    /// @returns `false` (the error reported) when no theme has that name. C: Rtheme_use
    static method Use(const AName: string): bool;
    begin
      return Rtheme_use(AName) <> 0;
    end;

    /// The name of the theme in use ("Dark" at the start). C: Rtheme_get_name
    /// @returns the name of the theme in use ("Dark" at the start)
    static method Name(): string;
    begin
      return DoRavenText(Rtheme_get_name());
    end;

    /// The number of themes known (built in and loaded). C: Rtheme_get_count
    /// @returns the number of themes known (built in and loaded)
    static method Count(): int32;
    begin
      return Rtheme_get_count();
    end;

    /// The name of the theme `AIndex` (0 .. `Count() - 1`; "" outside). C:
    /// Rtheme_get_name_at
    /// @param AIndex the index, from 0
    /// @returns the name of the theme `AIndex` (0 .
    static method NameAt(const AIndex: int32): string;
    begin
      return DoRavenText(Rtheme_get_name_at(AIndex));
    end;

    /// Saves the theme named `AName` as an XML file at `APath`.
    /// @param APath the file's path
    /// @param AName the name
    /// @returns `false` when it cannot be written or no theme has that name. C: Rtheme_save
    static method Save(const APath: string; const AName: string): bool;
    begin
      return Rtheme_save(APath, AName) <> 0;
    end;
  end;

// ============================================================================
// Widgets (listing sec 5): UIWidget is a handle (a Rid Raven owns, never the
// widget itself), the base every widget type of System.Raven.Ext derives
// from; UILayout is how a child sits in its parent (Raven's slot). Raven
// destroys a widget with its parent, its window or Raven itself: the layer's
// destroy hook (DoOnWidgetDestroy) then releases every closure the widget held
// and runs its OnDestroy. The members naming a later part's types come with
// that part: Window (V3, below), ContextMenu (V5), UIXMLNode (V10).
// ============================================================================

public const
  /// The code `UIWidget.Find<T>` / `As<T>` raise with when there is no widget: no widget has the
  /// name searched for, or the handle names none.
  ADAM_RAVEN_EXC_NOT_FOUND: int32 = 1;
  /// The code `UIWidget.Find<T>` / `As<T>` raise with when the widget is of a kind `T` does not
  /// view (the runtime's invalid cast's code).
  ADAM_RAVEN_EXC_KIND: int32 = 13;

const
  // The events a widget's GWidgetTasks closures are held for: OnDestroy, OnAccessiblePress
  ADAM_RAVEN_WIDGET_DESTROY: int32 = 0;
  ADAM_RAVEN_WIDGET_PRESS: int32 = 1;
  // The one event each of the other widget tables holds a closure for
  ADAM_RAVEN_WIDGET_EVENT: int32 = 0;

// The text of the kinds AKinds for a message: their names joined by " or "
func DoKindsText(const AKinds: UIWidgetKinds): string;
var
  LText: string;
  LKind: UIWidgetKind;
begin
  LText := "";
  for LKind in AKinds do
    if LText <> "" then
      LText := LText + " or ";
    end;
    LText := LText + nameof(LKind);
  end;
  return LText;
end;

// The widget AWidget is gone (Raven destroyed it, its handle no longer valid): every closure
// it held released, then its OnDestroy run (a copy: the table no longer holds it)
func clink DoOnWidgetDestroy(widget: Rid; user_data: ptr);
var
  LFunc: UITaskFunc;
  LFound: bool;
begin
  LFound := GWidgetTasks.Get(widget, ADAM_RAVEN_WIDGET_DESTROY, LFunc);
  GWidgetTasks.DropOwner(widget);
  GWidgetEvents.DropOwner(widget);
  GWidgetDrops.DropOwner(widget);
  GWidgetTouches.DropOwner(widget);
  GWidgetPens.DropOwner(widget);
  GWidgetGestures.DropOwner(widget);
  DoDropControls(widget);
  DoDropKeptOf(widget);
  DoDropTreeItems(widget);
  if LFound and (LFunc <> nil) then
    LFunc();
  end;
end;

// AWidget given the layer's destroy hook: set whenever the layer holds a closure for it, so
// the closures go with the widget
func DoHookDestroy(const AWidget: Rid);
begin
  Rwidget_set_destroy_callback(AWidget, DoOnWidgetDestroy, nil);
end;

// AItem noted as an item of ATree, the tree hooked so its items' notes and icons go with it
func DoNoteTreeItem(const ATree: Rid; const AItem: Rid);
begin
  GItemTrees.Put(uint64(AItem), ATree);
  GItemTreesOf.Add(uint64(ATree));
  DoHookDestroy(ATree);
end;

// The tree of AItem: noted, or the noted tree of an ancestor (AItem then noted too);
// R_INVALID_ID when the layer saw no tree of it (items added through System.Raven.C only)
func DoTreeOfItem(const AItem: Rid): Rid;
var
  LTree: Rid;
  LUp: Rid;
begin
  LUp := AItem;
  while LUp <> R_INVALID_ID do
    if GItemTrees.TryGet(uint64(LUp), LTree) then
      if LUp <> AItem then
        DoNoteTreeItem(LTree, AItem);
      end;
      return LTree;
    end;
    LUp := Rtree_item_get_parent(LUp);
  end;
  return R_INVALID_ID;
end;

// The icons of items no noted tree holds (kept under R_INVALID_ID) let go once Raven
// deleted their item
func DoSweepLooseIcons();
var
  LParts: array of uint32;
  LI: int64;
begin
  LParts := GKeptItemIcons.Parts(R_INVALID_ID);
  for LI := 0 to len(LParts) - 1 do
    if Rtree_item_is_valid(Rid(LParts[LI])) = 0 then
      GKeptItemIcons.Remove(R_INVALID_ID, LParts[LI]);
    end;
  end;
end;

// The items of ATree Raven deleted (an item destroyed with its descendants): their notes
// and icons let go; AAll: every item of ATree (the tree gone or cleared)
func DoSweepTreeItems(const ATree: Rid; const AAll: bool);
var
  LKeys: array of uint64;
  LI: int64;
begin
  LKeys := GItemTrees.Keys();
  for LI := 0 to len(LKeys) - 1 do
    if GItemTrees.Get(LKeys[LI]) = ATree then
      if AAll or (Rtree_item_is_valid(Rid(LKeys[LI])) = 0) then
        GKeptItemIcons.Remove(ATree, uint32(LKeys[LI]));
        GItemTrees.Remove(LKeys[LI]);
      end;
    end;
  end;
  DoSweepLooseIcons();
end;

// Every item of ATree let go (its icons, its notes): the tree is gone or cleared
func DoDropTreeItems(const ATree: Rid);
begin
  GKeptItemIcons.DropOwner(ATree);
  if GItemTreesOf.Remove(uint64(ATree)) then
    DoSweepTreeItems(ATree, true);
  end;
end;

// The widget trampolines: each runs its closure on a copy (one replaced while it runs
// finishes); a closure the table no longer holds (its widget gone) is never reached
func clink DoOnWidgetEvent(widget: Rid; event: ptr to const REvent; user_data: ptr): int32;
var
  LFunc: UIEventFunc;
begin
  if not GWidgetEvents.Find(user_data, LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  return DoCBool(LFunc(event^));
end;

func clink DoOnWidgetDrop(target: Rid; event: ptr to const RDropEvent; user_data: ptr): int32;
var
  LFunc: UIDropFunc;
begin
  if not GWidgetDrops.Find(user_data, LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  return DoCBool(LFunc(event^));
end;

func clink DoOnWidgetTouch(widget: Rid; event: ptr to const RTouchEvent; user_data: ptr): int32;
var
  LFunc: UITouchFunc;
begin
  if not GWidgetTouches.Find(user_data, LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  return DoCBool(LFunc(event^));
end;

func clink DoOnWidgetPen(widget: Rid; event: ptr to const RPenEvent; user_data: ptr): int32;
var
  LFunc: UIPenFunc;
begin
  if not GWidgetPens.Find(user_data, LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  return DoCBool(LFunc(event^));
end;

func clink DoOnWidgetGesture(widget: Rid; event: ptr to const RGestureEvent; user_data: ptr): int32;
var
  LFunc: UIGestureFunc;
begin
  if not GWidgetGestures.Find(user_data, LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  return DoCBool(LFunc(event^));
end;

func clink DoOnAccessiblePress(widget: Rid; user_data: ptr);
var
  LFunc: UITaskFunc;
begin
  if not GWidgetTasks.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc();
end;

public type
  /// The parts of a child's place in its parent a `UILayout` sets (the others keep Raven's
  /// defaults).
  UILayoutPart = choices(
    Fill,     /// The part `UILayout.Fill` sets.
    Auto,     /// The part `UILayout.Auto` sets.
    Margin,   /// The part `UILayout.Margin` sets.
    HAlign,   /// The part `UILayout.HAlign` sets.
    VAlign,   /// The part `UILayout.VAlign` sets.
    MaxSize,  /// The part `UILayout.MaxSize` sets.
    Cell,     /// The part `UILayout.Cell` sets.
    Span,     /// The part `UILayout.Span` sets.
    Anchors,  /// The part `UILayout.Anchors` sets.
    At,       /// The part `UILayout.At` sets.
    Size,     /// The part `UILayout.Size` sets.
    Pivot,    /// The part `UILayout.Pivot` sets.
    Title);   /// The part `UILayout.Title` sets.
  /// A set of `UILayoutPart`.
  UILayoutParts = set of UILayoutPart;

  /// How a child sits in its parent (Raven's slot), built fluently: each method returns a copy
  /// with one more part set, `UIWidget.Add(W, L)` places a child with it, `W.Layout(L)` moves a
  /// placed one. Which parts a parent reads depends on its kind: a box's Fill / Auto, Margin,
  /// HAlign / VAlign and MaxSize; a grid's Cell and Span; a canvas's Anchors, At, Size and Pivot;
  /// a tab view's or dock area's Title. The fields are the parts' values, `Parts` says which are
  /// set: set them through the methods.
  /// @example `LRow.Add(LButton, UILayout().Fill(1).Margin(4).VAlign(UIVAlign.Center));`
  UILayout = object
    /// The parts set.
    Parts: UILayoutParts;
    /// Fill's share of the free room.
    FillShare: float32;
    /// Margin's room on the left.
    MarginLeft: float32;
    /// Margin's room on the top.
    MarginTop: float32;
    /// Margin's room on the right.
    MarginRight: float32;
    /// Margin's room on the bottom.
    MarginBottom: float32;
    /// HAlign's alignment across the slot's width.
    Horizontal: UIHAlign;
    /// VAlign's alignment across the slot's height.
    Vertical: UIVAlign;
    /// MaxSize's largest size along the parent's direction.
    Largest: float32;
    /// Cell's column.
    Column: int32;
    /// Cell's row.
    Row: int32;
    /// Span's columns.
    Columns: int32;
    /// Span's rows.
    Rows: int32;
    /// Anchors' top-left corner: its x, as a fraction of the parent's width (0..1).
    AnchorMinX: float32;
    /// Anchors' top-left corner: its y, as a fraction of the parent's height (0..1).
    AnchorMinY: float32;
    /// Anchors' bottom-right corner: its x, as a fraction of the parent's width (0..1).
    AnchorMaxX: float32;
    /// Anchors' bottom-right corner: its y, as a fraction of the parent's height (0..1).
    AnchorMaxY: float32;
    /// At's x position.
    X: float32;
    /// At's y position.
    Y: float32;
    /// Size's width.
    Width: float32;
    /// Size's height.
    Height: float32;
    /// Pivot's x, as a fraction of the child's width (0.5: its centre).
    PivotX: float32;
    /// Pivot's y, as a fraction of the child's height (0.5: its centre).
    PivotY: float32;
    /// Title's text.
    Caption: string;

    /// No part set: Raven's defaults.
    init();
    begin
      self.Parts := [];
    end;

    /// The child takes `AShare` of the room its parent has left (a box's children share it by
    /// their shares). C: Rslot_set_fill
    /// @param AShare the share
    /// @returns the child takes `AShare` of the room its parent has left (a box's children share it
    ///   by their shares)
    const method Fill(const AShare: float32): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.Fill];
      LLayout.Parts -= [UILayoutPart.Auto];
      LLayout.FillShare := AShare;
      return LLayout;
    end;

    /// The child takes the room its content wants (the default). C: Rslot_set_auto
    /// @returns the child takes the room its content wants (the default)
    const method Auto(): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.Auto];
      LLayout.Parts -= [UILayoutPart.Fill];
      return LLayout;
    end;

    /// The same room `AAll` around every side of the child. C: Rslot_set_padding
    /// @param AAll the room on every side
    /// @returns the same room `AAll` around every side of the child
    const method Margin(const AAll: float32): UILayout;
    begin
      return self.Margin(AAll, AAll, AAll, AAll);
    end;

    /// Room around the child: left, top, right, bottom. C: Rslot_set_padding
    /// @param ALeft the room on the left
    /// @param ATop the room above
    /// @param ARight the room on the right
    /// @param ABottom the room below
    /// @returns the layout with that room set
    const method Margin(const ALeft: float32; const ATop: float32; const ARight: float32;
      const ABottom: float32): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.Margin];
      LLayout.MarginLeft := ALeft;
      LLayout.MarginTop := ATop;
      LLayout.MarginRight := ARight;
      LLayout.MarginBottom := ABottom;
      return LLayout;
    end;

    /// How the child lines up across its slot's width. C: Rslot_set_halign
    /// @param AAlign the alignment
    /// @returns how the child lines up across its slot's width
    const method HAlign(const AAlign: UIHAlign): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.HAlign];
      LLayout.Horizontal := AAlign;
      return LLayout;
    end;

    /// How the child lines up across its slot's height. C: Rslot_set_valign
    /// @param AAlign the alignment
    /// @returns how the child lines up across its slot's height
    const method VAlign(const AAlign: UIVAlign): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.VAlign];
      LLayout.Vertical := AAlign;
      return LLayout;
    end;

    /// Both alignments at once. C: Rslot_set_halign, Rslot_set_valign
    /// @param AHorizontal the horizontal
    /// @param AVertical the vertical
    /// @returns the layout with both alignments set
    const method Align(const AHorizontal: UIHAlign; const AVertical: UIVAlign): UILayout;
    begin
      return self.HAlign(AHorizontal).VAlign(AVertical);
    end;

    /// The largest size the child takes along its parent's direction. C: Rslot_set_max_size
    /// @param ALargest the largest
    /// @returns the largest size the child takes along its parent's direction
    const method MaxSize(const ALargest: float32): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.MaxSize];
      LLayout.Largest := ALargest;
      return LLayout;
    end;

    /// The grid cell the child sits in. C: Rslot_set_grid
    /// @param AColumn the column, from 0
    /// @param ARow the row, from 0
    /// @returns the grid cell the child sits in
    const method Cell(const AColumn: int32; const ARow: int32): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.Cell];
      LLayout.Column := AColumn;
      LLayout.Row := ARow;
      return LLayout;
    end;

    /// The grid columns and rows the child spans from its cell. C: Rslot_set_grid_span
    /// @param AColumns the columns
    /// @param ARows the rows
    /// @returns the grid columns and rows the child spans from its cell
    const method Span(const AColumns: int32; const ARows: int32): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.Span];
      LLayout.Columns := AColumns;
      LLayout.Rows := ARows;
      return LLayout;
    end;

    /// The child's corners on a canvas as fractions of it (0, 0, 1, 1 stretches it over the
    /// whole canvas). C: Rslot_set_anchors
    /// @param AMinX the min X
    /// @param AMinY the min Y
    /// @param AMaxX the max X
    /// @param AMaxY the max Y
    /// @returns the child's corners on a canvas as fractions of it (0, 0, 1, 1 stretches it over
    ///   the whole canvas)
    const method Anchors(const AMinX: float32; const AMinY: float32; const AMaxX: float32;
      const AMaxY: float32): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.Anchors];
      LLayout.AnchorMinX := AMinX;
      LLayout.AnchorMinY := AMinY;
      LLayout.AnchorMaxX := AMaxX;
      LLayout.AnchorMaxY := AMaxY;
      return LLayout;
    end;

    /// The child's position on a canvas, from its anchors. C: Rslot_set_position
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    /// @returns the child's position on a canvas, from its anchors
    const method At(const AX: float32; const AY: float32): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.At];
      LLayout.X := AX;
      LLayout.Y := AY;
      return LLayout;
    end;

    /// The child's size on a canvas. C: Rslot_set_size
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns the child's size on a canvas
    const method Size(const AWidth: float32; const AHeight: float32): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.Size];
      LLayout.Width := AWidth;
      LLayout.Height := AHeight;
      return LLayout;
    end;

    /// The point of the child its canvas position names, as fractions of the child (0.5, 0.5
    /// its centre). C: Rslot_set_alignment
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    /// @returns the point of the child its canvas position names, as fractions of the child (0.5,
    ///   0.5 its centre)
    const method Pivot(const AX: float32; const AY: float32): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.Pivot];
      LLayout.PivotX := AX;
      LLayout.PivotY := AY;
      return LLayout;
    end;

    /// The title a tab view's tab or a dock area's panel shows for the child. C: Rslot_set_title
    /// @param AText the text
    /// @returns the title a tab view's tab or a dock area's panel shows for the child
    const method Title(const AText: string): UILayout;
    var
      LLayout: UILayout;
    begin
      LLayout := self;
      LLayout.Parts += [UILayoutPart.Title];
      LLayout.Caption := AText;
      return LLayout;
    end;
  end;

// The parts ALayout sets applied to the placed child AChild
func DoApplyLayout(const AChild: Rid; const ALayout: UILayout);
begin
  if UILayoutPart.Fill in ALayout.Parts then
    Rslot_set_fill(AChild, ALayout.FillShare);
  end;
  if UILayoutPart.Auto in ALayout.Parts then
    Rslot_set_auto(AChild);
  end;
  if UILayoutPart.Margin in ALayout.Parts then
    Rslot_set_padding(AChild, ALayout.MarginLeft, ALayout.MarginTop, ALayout.MarginRight,
      ALayout.MarginBottom);
  end;
  if UILayoutPart.HAlign in ALayout.Parts then
    Rslot_set_halign(AChild, int32(ALayout.Horizontal));
  end;
  if UILayoutPart.VAlign in ALayout.Parts then
    Rslot_set_valign(AChild, int32(ALayout.Vertical));
  end;
  if UILayoutPart.MaxSize in ALayout.Parts then
    Rslot_set_max_size(AChild, ALayout.Largest);
  end;
  if UILayoutPart.Cell in ALayout.Parts then
    Rslot_set_grid(AChild, ALayout.Column, ALayout.Row);
  end;
  if UILayoutPart.Span in ALayout.Parts then
    Rslot_set_grid_span(AChild, ALayout.Columns, ALayout.Rows);
  end;
  if UILayoutPart.Anchors in ALayout.Parts then
    Rslot_set_anchors(AChild, ALayout.AnchorMinX, ALayout.AnchorMinY, ALayout.AnchorMaxX,
      ALayout.AnchorMaxY);
  end;
  if UILayoutPart.At in ALayout.Parts then
    Rslot_set_position(AChild, ALayout.X, ALayout.Y);
  end;
  if UILayoutPart.Size in ALayout.Parts then
    Rslot_set_size(AChild, ALayout.Width, ALayout.Height);
  end;
  if UILayoutPart.Pivot in ALayout.Parts then
    Rslot_set_alignment(AChild, ALayout.PivotX, ALayout.PivotY);
  end;
  if UILayoutPart.Title in ALayout.Parts then
    Rslot_set_title(AChild, ALayout.Caption);
  end;
end;

public type
  /// A widget: a handle to one Raven owns (copying copies the handle; Raven destroys the widget
  /// with its parent, its window or the app). The base of every widget type: `Find<T>` and
  /// `As<T>` give the typed view of a widget, checking its kind. Its setters return the widget,
  /// so a tree is built in one chain (`Add` a child, `End()` back to the parent); its events
  /// take closures, released when Raven destroys the widget. `Id()` is the Rid for
  /// System.Raven.C's calls; `UIWidget.Wrap(Rid)` the handle of a Rid.
  /// @example `LName := LWindow.Content().Find<UIWidget>("name").Text();`
  UIWidget = object
    hidden FId: Rid;

    /// An empty handle (names no widget: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
      self.FId := R_INVALID_ID;
    end;

    // AId as this handle's widget
    hidden method DoSet(const AId: Rid);
    begin
      self.FId := AId;
    end;

    /// A new widget of the kind `AKind` with Raven's defaults, in no parent yet (the widget
    /// types' own `Create` give their typed handle). C: Rwidget_create
    /// @param AKind the kind
    /// @returns a new widget of the kind `AKind` with Raven's defaults, in no parent yet (the
    ///   widget types' own `Create` give their typed handle)
    static method Create(const AKind: UIWidgetKind): UIWidget;
    begin
      return UIWidget.Wrap(Rwidget_create(int32(AKind)));
    end;

    /// A widget tree made from the XML layout file `APath` (`IsValid()` false when it does
    /// not load: its error reported to `UIErrors`). C: Rwidget_create_from_xml_file
    /// @param APath the file's path
    /// @returns a widget tree made from the XML layout file `APath` (`IsValid()` false when it does
    ///   not load: its error reported to `UIErrors`)
    static method FromXML(const APath: string): UIWidget;
    begin
      return UIWidget.Wrap(Rwidget_create_from_xml_file(APath));
    end;

    /// A widget tree made from the XML layout text `AXML`. C: Rwidget_create_from_xml
    /// @param AXML the XML text
    /// @returns a widget tree made from the XML layout text `AXML`
    static method FromXMLText(const AXML: string): UIWidget;
    begin
      return UIWidget.Wrap(Rwidget_create_from_xml(AXML, uint64(len(AXML))));
    end;

    /// The handle of the widget System.Raven.C gave as `AId` (`R_INVALID_ID`: an empty one).
    /// @param AId the id
    /// @returns the handle of the widget System.Raven.C gave as `AId` (`R_INVALID_ID`: an empty
    ///   one)
    static method Wrap(const AId: Rid): UIWidget;
    var
      LWidget: UIWidget;
    begin
      LWidget.DoSet(AId);
      return LWidget;
    end;

    /// The kinds of widget this type views: every kind (each widget type restates it with its
    /// own; `Find<T>` / `As<T>` / `Is<T>` check a widget's kind against `T.Kinds()`).
    /// @returns the kinds of widget this type views: every kind (each widget type restates it with
    ///   its own; `Find<T>` / `As<T>` / `Is<T>` check a widget's kind against `T.Kinds()`)
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.VBox .. UIWidgetKind.Carousel];
    end;

    /// The widget's Rid, for System.Raven.C's calls.
    /// @returns the widget's Rid, for System.Raven.C's calls
    const method Id(): Rid;
    begin
      return self.FId;
    end;

    /// `true` while the handle names a widget (one Raven has not destroyed). C: Rwidget_is_valid
    /// @returns `true` while the handle names a widget (one Raven has not destroyed)
    const method IsValid(): bool;
    begin
      return Rwidget_is_valid(self.FId) <> 0;
    end;

    /// The widget's kind. C: Rwidget_get_type
    /// @returns the widget's kind
    const method Kind(): UIWidgetKind;
    begin
      return UIWidgetKind(Rwidget_get_type(self.FId));
    end;

    /// Destroys the widget and everything inside it (each told by its `OnDestroy`); the
    /// handles naming them are no longer valid. C: Rwidget_destroy
    const method Destroy();
    begin
      Rwidget_destroy(self.FId);
    end;

    // ---------------------------------------------------------------------------
    // The tree
    // ---------------------------------------------------------------------------

    /// Places `AChild` last inside this widget, with Raven's default layout. C: Rwidget_add_child
    /// @param AChild the child widget
    /// @returns this object, so calls chain
    const method Add(const AChild: UIWidget): self;
    begin
      Rwidget_add_child(self.FId, AChild.FId);
      return self;
    end;

    /// Places `AChild` last inside this widget, sitting as `ALayout` says. C: Rwidget_add_child,
    /// Rslot_*
    /// @param AChild the child widget
    /// @param ALayout the layout
    /// @returns this object, so calls chain
    const method Add(const AChild: UIWidget; const ALayout: UILayout): self;
    begin
      Rwidget_add_child(self.FId, AChild.FId);
      DoApplyLayout(AChild.FId, ALayout);
      return self;
    end;

    /// Places `AChild` at `AIndex` among this widget's children. C: Rwidget_insert_child
    /// @param AIndex the index, from 0
    /// @param AChild the child widget
    /// @returns this object, so calls chain
    const method Insert(const AIndex: int32; const AChild: UIWidget): self;
    begin
      Rwidget_insert_child(self.FId, AChild.FId, AIndex);
      return self;
    end;

    /// Places `AChild` at `AIndex` among this widget's children, sitting as `ALayout` says.
    /// C: Rwidget_insert_child, Rslot_*
    /// @param AIndex the index, from 0
    /// @param AChild the child widget
    /// @param ALayout the layout
    /// @returns this object, so calls chain
    const method Insert(const AIndex: int32; const AChild: UIWidget; const ALayout: UILayout): self;
    begin
      Rwidget_insert_child(self.FId, AChild.FId, AIndex);
      DoApplyLayout(AChild.FId, ALayout);
      return self;
    end;

    /// Takes `AChild` out of this widget (it is not destroyed: place it again, or destroy it).
    /// C: Rwidget_remove_child
    /// @param AChild the child widget
    /// @returns this object, so calls chain
    const method Remove(const AChild: UIWidget): self;
    begin
      Rwidget_remove_child(self.FId, AChild.FId);
      return self;
    end;

    /// Destroys every child of this widget. C: Rwidget_clear_children
    /// @returns this object, so calls chain
    const method Clear(): self;
    begin
      Rwidget_clear_children(self.FId);
      return self;
    end;

    /// How the widget sits in its parent, set to `ALayout`'s parts. C: Rslot_*
    /// @param ALayout the layout
    /// @returns this object, so calls chain
    const method Layout(const ALayout: UILayout): self;
    begin
      DoApplyLayout(self.FId, ALayout);
      return self;
    end;

    /// The widget this one is inside (an empty handle for a window's content or a widget in no
    /// parent). C: Rwidget_get_parent
    /// @returns the widget this one is inside (an empty handle for a window's content or a widget
    ///   in no parent)
    const method Parent(): UIWidget;
    begin
      return UIWidget.Wrap(Rwidget_get_parent(self.FId));
    end;

    /// The end of a child built in a chain: its parent, to go on adding there (the builder's
    /// close; the `Begin<Kind>` forms of the container types open one).
    /// @returns the end of a child built in a chain: its parent, to go on adding there (the
    ///   builder's close; the `Begin<Kind>` forms of the container types open one)
    /// @example `LPanel.Add(LTitle).Add(LRow.Add(LOk).Add(LCancel).End())`
    const method End(): UIWidget;
    begin
      return self.Parent();
    end;

    /// The children this widget holds. C: Rwidget_get_child_count
    /// @returns the children this widget holds
    const method ChildCount(): int32;
    begin
      return Rwidget_get_child_count(self.FId);
    end;

    /// The child at `AIndex` (0 .. ChildCount() - 1; an empty handle outside). C: Rwidget_get_child
    /// @param AIndex the index, from 0
    /// @returns the child at `AIndex` (0 .
    const method Child(const AIndex: int32): UIWidget;
    begin
      return UIWidget.Wrap(Rwidget_get_child(self.FId, AIndex));
    end;

    /// The name `Find` looks for (an XML layout's `Name`). C: Rwidget_set_name
    /// @param AName the name
    /// @returns this object, so calls chain
    const method Name(const AName: string): self;
    begin
      Rwidget_set_name(self.FId, AName);
      return self;
    end;

    /// The widget's name ("" for none). C: Rwidget_get_name
    /// @returns the widget's name ("" for none)
    const method Name(): string;
    begin
      return DoRavenText(Rwidget_get_name(self.FId));
    end;

    // The widget named AName inside this one, as T: raises ADAM_RAVEN_EXC_NOT_FOUND when none
    // has the name, ADAM_RAVEN_EXC_KIND when it is of a kind T does not view
    hidden const method DoFound<T>(const AName: string; const AWhat: string): T;
    var
      LId: Rid;
      LKind: UIWidgetKind;
      LWidget: T;
    begin
      LId := Rwidget_find(self.FId, AName);
      if LId = R_INVALID_ID then
        raisecode(ADAM_RAVEN_EXC_NOT_FOUND, FormatStr("{}<{}>: no widget is named '{}'", AWhat,
          nameof(T), AName));
      end;
      LKind := UIWidgetKind(Rwidget_get_type(LId));
      if not (LKind in T.Kinds()) then
        raisecode(ADAM_RAVEN_EXC_KIND, FormatStr("{}<{}>: '{}' is a {}, not a {}", AWhat,
          nameof(T), AName, nameof(LKind), DoKindsText(T.Kinds())));
      end;
      LWidget.DoSet(LId);
      return LWidget;
    end;

    /// The widget named `AName` inside this one (searched as Raven searches: the name an XML
    /// layout or `Name` gave it), as the widget type `T`.
    /// Raises `ADAM_RAVEN_EXC_NOT_FOUND` when no widget has the name and `ADAM_RAVEN_EXC_KIND`
    /// when it is of a kind `T` does not view (the message names the name and both kinds).
    /// C: Rwidget_find
    /// @param AName the name
    /// @returns the widget named `AName` inside this one (searched as Raven searches: the name an
    ///   XML layout or `Name` gave it), as the widget type `T`
    /// @example `LWindow.Content().Find<UISlider>("volume").OnChanged(func(const AValue: float32) begin .. end);`
    const method Find<T>(const AName: string): T;
    begin
      return self.DoFound<T>(AName, "Find");
    end;

    /// `true` when a widget named `AName` is inside this one and `T` views its kind.
    /// @param AName the name
    /// @returns `true` when a widget named `AName` is inside this one and `T` views its kind
    const method Has<T>(const AName: string): bool;
    var
      LId: Rid;
    begin
      LId := Rwidget_find(self.FId, AName);
      return (LId <> R_INVALID_ID) and (UIWidgetKind(Rwidget_get_type(LId)) in T.Kinds());
    end;

    /// The widget named `AName` inside this one into `AWidget` as `T`: `false` (`AWidget`
    /// unchanged) when none has the name or `T` does not view its kind.
    /// @param AName the name
    /// @param AWidget the widget
    /// @returns `true` when it was found and viewed as `T`
    const method TryFind<T>(const AName: string; var AWidget: T): bool;
    var
      LId: Rid;
    begin
      LId := Rwidget_find(self.FId, AName);
      if (LId = R_INVALID_ID) or not (UIWidgetKind(Rwidget_get_type(LId)) in T.Kinds()) then
        return false;
      end;
      AWidget.DoSet(LId);
      return true;
    end;

    /// This widget as the widget type `T`. Raises `ADAM_RAVEN_EXC_NOT_FOUND` for an empty or
    /// destroyed handle, `ADAM_RAVEN_EXC_KIND` when `T` does not view its kind.
    /// @returns this widget as the widget type `T`
    const method As<T>(): T;
    var
      LKind: UIWidgetKind;
      LWidget: T;
    begin
      if Rwidget_is_valid(self.FId) = 0 then
        raisecode(ADAM_RAVEN_EXC_NOT_FOUND, FormatStr("As<{}>: the handle names no widget", nameof(T)));
      end;
      LKind := UIWidgetKind(Rwidget_get_type(self.FId));
      if not (LKind in T.Kinds()) then
        raisecode(ADAM_RAVEN_EXC_KIND, FormatStr("As<{}>: '{}' is a {}, not a {}", nameof(T),
          self.Name(), nameof(LKind), DoKindsText(T.Kinds())));
      end;
      LWidget.DoSet(self.FId);
      return LWidget;
    end;

    /// `true` when the handle names a widget whose kind `T` views.
    /// @returns `true` when the handle names a widget whose kind `T` views
    const method Is<T>(): bool;
    begin
      return (Rwidget_is_valid(self.FId) <> 0) and
        (UIWidgetKind(Rwidget_get_type(self.FId)) in T.Kinds());
    end;

    /// The innermost widget inside this one under `APoint` (window units) that takes the
    /// pointer (an empty handle for none). C: Rwidget_hit_test
    /// @param APoint the point
    /// @returns the innermost widget inside this one under `APoint` (window units) that takes the
    ///   pointer (an empty handle for none)
    const method HitTest(const APoint: UIPoint): UIWidget;
    begin
      return UIWidget.Wrap(Rwidget_hit_test(self.FId, APoint.x, APoint.y));
    end;

    /// The innermost widget inside this one under `APoint`, whether it takes the pointer or
    /// not. C: Rwidget_pick
    /// @param APoint the point
    /// @returns the innermost widget inside this one under `APoint`, whether it takes the pointer
    ///   or not
    const method Pick(const APoint: UIPoint): UIWidget;
    begin
      return UIWidget.Wrap(Rwidget_pick(self.FId, APoint.x, APoint.y));
    end;

    // ---------------------------------------------------------------------------
    // State
    // ---------------------------------------------------------------------------

    /// Shown, hidden (its room kept) or collapsed (no room). C: Rwidget_set_visibility
    /// @param AVisibility the visibility
    /// @returns this object, so calls chain
    const method Visibility(const AVisibility: UIVisibility): self;
    begin
      Rwidget_set_visibility(self.FId, int32(AVisibility));
      return self;
    end;

    /// What `Visibility(..)` sets, read back. C: Rwidget_get_visibility
    /// @returns what `Visibility(..)` set last
    const method Visibility(): UIVisibility;
    begin
      return UIVisibility(Rwidget_get_visibility(self.FId));
    end;

    /// `Visibility(UIVisibility.Visible)`.
    /// @returns this object, so calls chain
    const method Show(): self;
    begin
      self.Visibility(UIVisibility.Visible);
      return self;
    end;

    /// `Visibility(UIVisibility.Hidden)`: not drawn, its room kept.
    /// @returns this object, so calls chain
    const method Hide(): self;
    begin
      self.Visibility(UIVisibility.Hidden);
      return self;
    end;

    /// `Visibility(UIVisibility.Collapsed)`: not drawn, no room.
    /// @returns this object, so calls chain
    const method Collapse(): self;
    begin
      self.Visibility(UIVisibility.Collapsed);
      return self;
    end;

    /// `false` greys the widget out and it takes no input (nor do its children). C:
    /// Rwidget_set_enabled
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method Enabled(const AOn: bool): self;
    begin
      Rwidget_set_enabled(self.FId, DoCBool(AOn));
      return self;
    end;

    /// What `Enabled(..)` sets, read back. C: Rwidget_is_enabled
    /// @returns `true` when `Enabled(..)` turned it on
    const method Enabled(): bool;
    begin
      return Rwidget_is_enabled(self.FId) <> 0;
    end;

    /// `false` lets the pointer pass through the widget to what is under it. C:
    /// Rwidget_set_hit_testable
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method HitTestable(const AOn: bool): self;
    begin
      Rwidget_set_hit_testable(self.FId, DoCBool(AOn));
      return self;
    end;

    /// How opaque the widget and its children are drawn (0..1). C: Rwidget_set_opacity
    /// @param AOpacity the opacity
    /// @returns this object, so calls chain
    const method Opacity(const AOpacity: float32): self;
    begin
      Rwidget_set_opacity(self.FId, AOpacity);
      return self;
    end;

    /// `true` cuts the children's drawing to the widget's rectangle. C: Rwidget_set_clipping
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method Clipping(const AOn: bool): self;
    begin
      Rwidget_set_clipping(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The text shown when the pointer rests on the widget ("" for none). C: Rwidget_set_tooltip
    /// @param AText the text
    /// @returns this object, so calls chain
    const method Tooltip(const AText: string): self;
    begin
      Rwidget_set_tooltip(self.FId, AText);
      return self;
    end;

    /// What `Tooltip(..)` sets, read back. C: Rwidget_get_tooltip
    /// @returns the text shown when the pointer rests on the widget ("" for none)
    const method Tooltip(): string;
    begin
      return DoRavenText(Rwidget_get_tooltip(self.FId));
    end;

    /// The pointer's shape over the widget. C: Rwidget_set_cursor
    /// @param ACursor the cursor
    /// @returns this object, so calls chain
    const method Cursor(const ACursor: UICursor): self;
    begin
      Rwidget_set_cursor(self.FId, int32(ACursor));
      return self;
    end;

    /// The widget's text and layout direction (`UIDirection.Inherit`: its parent's). C:
    /// Rwidget_set_direction
    /// @param ADirection the direction
    /// @returns this object, so calls chain
    const method Direction(const ADirection: UIDirection): self;
    begin
      Rwidget_set_direction(self.FId, int32(ADirection));
      return self;
    end;

    /// What `Direction(..)` sets, read back. C: Rwidget_get_direction
    /// @returns the widget's text and layout direction (`UIDirection.Inherit`: its parent's)
    const method Direction(): UIDirection;
    begin
      return UIDirection(Rwidget_get_direction(self.FId));
    end;

    /// The widget's own size (0 for a side: its content's). C: Rwidget_set_size
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    const method Size(const AWidth: float32; const AHeight: float32): self;
    begin
      Rwidget_set_size(self.FId, AWidth, AHeight);
      return self;
    end;

    /// The smallest size the widget is given. C: Rwidget_set_min_size
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    const method MinSize(const AWidth: float32; const AHeight: float32): self;
    begin
      Rwidget_set_min_size(self.FId, AWidth, AHeight);
      return self;
    end;

    /// The largest size the widget is given. C: Rwidget_set_max_size
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    const method MaxSize(const AWidth: float32; const AHeight: float32): self;
    begin
      Rwidget_set_max_size(self.FId, AWidth, AHeight);
      return self;
    end;

    /// Where the widget was laid out, in window units. C: Rwidget_get_rect
    /// @returns where the widget was laid out, in window units
    const method Rect(): UIRect;
    var
      LRect: UIRect;
    begin
      Rwidget_get_rect(self.FId, addr of LRect.x, addr of LRect.y, addr of LRect.w, addr of LRect.h);
      return LRect;
    end;

    /// The size the widget asks for. C: Rwidget_get_desired_size
    /// @returns the size the widget asks for
    const method DesiredSize(): UISize;
    var
      LSize: UISize;
    begin
      Rwidget_get_desired_size(self.FId, addr of LSize.w, addr of LSize.h);
      return LSize;
    end;

    /// `true` while the pointer is over the widget. C: Rwidget_is_hovered
    /// @returns `true` while the pointer is over the widget
    const method Hovered(): bool;
    begin
      return Rwidget_is_hovered(self.FId) <> 0;
    end;

    /// `true` lets the widget take the keyboard focus. C: Rwidget_set_focusable
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method Focusable(const AOn: bool): self;
    begin
      Rwidget_set_focusable(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Gives the widget the keyboard focus. C: Rwidget_focus
    /// @returns this object, so calls chain
    const method Focus(): self;
    begin
      Rwidget_focus(self.FId);
      return self;
    end;

    /// `true` while the widget has the keyboard focus. C: Rwidget_is_focused
    /// @returns `true` while the widget has the keyboard focus
    const method Focused(): bool;
    begin
      return Rwidget_is_focused(self.FId) <> 0;
    end;

    /// Scrolls every scroll box the widget is in until it is shown. C: Rwidget_scroll_into_view
    /// @returns this object, so calls chain
    const method ScrollIntoView(): self;
    begin
      Rwidget_scroll_into_view(self.FId);
      return self;
    end;

    /// Has the widget drawn again at the next frame. C: Rwidget_invalidate
    /// @returns this object, so calls chain
    const method Invalidate(): self;
    begin
      Rwidget_invalidate(self.FId);
      return self;
    end;

    /// The animation the widget plays each time it is shown. C: Rwidget_set_transition
    /// @param ATransition the transition
    /// @returns this object, so calls chain
    const method Transition(const ATransition: UITransition): self;
    begin
      self.Transition(ATransition, 0.0f);
      return self;
    end;

    /// The animation the widget plays each time it is shown, `ADelay` seconds after. C:
    /// Rwidget_set_transition
    /// @param ATransition the transition
    /// @param ADelay the delay
    /// @returns this object, so calls chain
    const method Transition(const ATransition: UITransition; const ADelay: float32): self;
    begin
      Rwidget_set_transition(self.FId, int32(ATransition), ADelay);
      return self;
    end;

    /// Plays the animation `ATransition` on the widget now. C: Rwidget_play_transition
    /// @param ATransition the transition
    /// @returns this object, so calls chain
    const method Play(const ATransition: UITransition): self;
    begin
      self.Play(ATransition, 0.0f);
      return self;
    end;

    /// Plays the animation `ATransition` on the widget `ADelay` seconds from now. C:
    /// Rwidget_play_transition
    /// @param ATransition the transition
    /// @param ADelay the delay
    /// @returns this object, so calls chain
    const method Play(const ATransition: UITransition; const ADelay: float32): self;
    begin
      Rwidget_play_transition(self.FId, int32(ATransition), ADelay);
      return self;
    end;

    /// `true` makes dragging the widget move its window (a custom title bar). C:
    /// Rwidget_set_window_drag
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method WindowDrag(const AOn: bool): self;
    begin
      Rwidget_set_window_drag(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The action the widget runs when it is used (a button's click ..: the app's actions). C:
    /// Rwidget_set_action
    /// @param AAction the action
    /// @returns this object, so calls chain
    const method Action(const AAction: string): self;
    begin
      Rwidget_set_action(self.FId, AAction);
      return self;
    end;

    /// What `Action(..)` sets, read back. C: Rwidget_get_action
    /// @returns the action the widget runs when it is used (a button's click ..: the app's actions)
    const method Action(): string;
    begin
      return DoRavenText(Rwidget_get_action(self.FId));
    end;

    /// A pointer of the program's own kept with the widget (Raven never reads it). C:
    /// Rwidget_set_user_handle
    /// @param AHandle the handle
    /// @returns this object, so calls chain
    const method UserHandle(const AHandle: ptr): self;
    begin
      Rwidget_set_user_handle(self.FId, AHandle);
      return self;
    end;

    /// What `UserHandle(..)` sets, read back. C: Rwidget_get_user_handle
    /// @returns a pointer of the program's own kept with the widget (Raven never reads it)
    const method UserHandle(): ptr;
    begin
      return Rwidget_get_user_handle(self.FId);
    end;

    // ---------------------------------------------------------------------------
    // Style
    // ---------------------------------------------------------------------------

    /// The colour the widget and its children draw `ARole` with (over the theme's). C:
    /// Rwidget_set_color
    /// @param ARole the role
    /// @param AColor the colour
    /// @returns this object, so calls chain
    const method Color(const ARole: UIColorRole; const AColor: UIColor): self;
    begin
      Rwidget_set_color(self.FId, int32(ARole), AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// The colour the widget draws `ARole` with. C: Rwidget_get_color
    /// @param ARole the role
    /// @returns the colour the widget draws `ARole` with
    const method Color(const ARole: UIColorRole): UIColor;
    var
      LColor: UIColor;
    begin
      Rwidget_get_color(self.FId, int32(ARole), addr of LColor.r, addr of LColor.g,
        addr of LColor.b, addr of LColor.a);
      return LColor;
    end;

    /// `ARole` back to the theme's colour. C: Rwidget_clear_color
    /// @param ARole the role
    /// @returns this object, so calls chain
    const method ClearColor(const ARole: UIColorRole): self;
    begin
      Rwidget_clear_color(self.FId, int32(ARole));
      return self;
    end;

    /// The size `AMetric` the widget and its children use (over the theme's). C:
    /// Rwidget_set_metric
    /// @param AMetric the metric
    /// @param AValue the value
    /// @returns this object, so calls chain
    const method Metric(const AMetric: UIMetric; const AValue: float32): self;
    begin
      Rwidget_set_metric(self.FId, int32(AMetric), AValue);
      return self;
    end;

    /// What `Metric(..)` sets, read back. C: Rwidget_get_metric
    /// @param AMetric the metric
    /// @returns the size `AMetric` the widget and its children use (over the theme's)
    const method Metric(const AMetric: UIMetric): float32;
    begin
      return Rwidget_get_metric(self.FId, int32(AMetric));
    end;

    /// `AMetric` back to the theme's. C: Rwidget_clear_metric
    /// @param AMetric the metric
    /// @returns this object, so calls chain
    const method ClearMetric(const AMetric: UIMetric): self;
    begin
      Rwidget_clear_metric(self.FId, int32(AMetric));
      return self;
    end;

    /// What the widget's panels are drawn as (solid, glass ..). C: Rwidget_set_material
    /// @param AMaterial the material
    /// @returns this object, so calls chain
    const method Material(const AMaterial: UIMaterial): self;
    begin
      Rwidget_set_material(self.FId, int32(AMaterial));
      return self;
    end;

    /// What `Material(..)` sets, read back. C: Rwidget_get_material
    /// @returns what the widget's panels are drawn as (solid, glass ..)
    const method Material(): UIMaterial;
    begin
      return UIMaterial(Rwidget_get_material(self.FId));
    end;

    /// A theme of their own for the widget and everything inside it, by name ("Dark", a theme
    /// `UITheme` loaded; "" follows the app's theme again).
    /// @param AName the name
    /// @returns `false` (the error reported) when no theme has that name. C: Rwidget_set_theme
    const method Theme(const AName: string): bool;
    begin
      return Rwidget_set_theme(self.FId, AName) <> 0;
    end;

    /// One of Raven's built-in themes for the widget and everything inside it. C:
    /// Rwidget_set_theme
    /// @param AKind the kind
    /// @returns this object, so calls chain
    const method Theme(const AKind: UIThemeKind): self;
    begin
      Rwidget_set_theme(self.FId, nameof(AKind));
      return self;
    end;

    /// The name of the theme the widget is drawn with. C: Rwidget_get_theme
    /// @returns the name of the theme the widget is drawn with
    const method Theme(): string;
    begin
      return DoRavenText(Rwidget_get_theme(self.FId));
    end;

    /// The widget's style classes, a space between each (a theme's rules match them). C:
    /// Rwidget_set_class
    /// @param AClasses the classes
    /// @returns this object, so calls chain
    const method Class(const AClasses: string): self;
    begin
      Rwidget_set_class(self.FId, AClasses);
      return self;
    end;

    /// What `Class(..)` sets, read back. C: Rwidget_get_class
    /// @returns the widget's style classes, a space between each (a theme's rules match them)
    const method Class(): string;
    begin
      return DoRavenText(Rwidget_get_class(self.FId));
    end;

    /// Adds the style class `AClass`. C: Rwidget_add_class
    /// @param AClass the class name
    /// @returns this object, so calls chain
    const method AddClass(const AClass: string): self;
    begin
      Rwidget_add_class(self.FId, AClass);
      return self;
    end;

    /// Takes the style class `AClass` away. C: Rwidget_remove_class
    /// @param AClass the class name
    /// @returns this object, so calls chain
    const method RemoveClass(const AClass: string): self;
    begin
      Rwidget_remove_class(self.FId, AClass);
      return self;
    end;

    /// `true` when the widget has the style class `AClass`. C: Rwidget_has_class
    /// @param AClass the class name
    /// @returns `true` when the widget has the style class `AClass`
    const method HasClass(const AClass: string): bool;
    begin
      return Rwidget_has_class(self.FId, AClass) <> 0;
    end;

    // ---------------------------------------------------------------------------
    // XML attributes and text
    // ---------------------------------------------------------------------------

    /// Sets one attribute as an XML layout writes it: any attribute of the widget's tag, its
    /// slot's and colours' too (`"Visibility"`, `"Color.Accent"`, `"Slot.Fill"` ..).
    /// @param AName the name
    /// @param AValue the text
    /// @returns `false` for an attribute the tag lacks or a value it refuses. C:
    /// Rwidget_set_attribute
    const method Attribute(const AName: string; const AValue: string): bool;
    begin
      return Rwidget_set_attribute(self.FId, AName, AValue) <> 0;
    end;

    /// The attribute `AAttribute` ("Text", "Tooltip" ..) shows the text the locale's strings
    /// give `AKey`, again whenever the language changes. C: Rwidget_set_text_key
    /// @param AAttribute the attribute
    /// @param AKey the key
    /// @returns this object, so calls chain
    const method TextKey(const AAttribute: string; const AKey: string): self;
    begin
      Rwidget_set_text_key(self.FId, AAttribute, AKey);
      return self;
    end;

    /// Sets the text the widget shows (its `Text` attribute: a label's, a button's, a check
    /// box's, a text input's, a text editor's ..).
    /// @param AText the text
    /// @returns `false` for a widget with no text. C: Rwidget_set_attribute
    const method Text(const AText: string): bool;
    begin
      return Rwidget_set_attribute(self.FId, "Text", AText) <> 0;
    end;

    /// The text the widget shows: a label's, a check box's, a text input's, a text editor's,
    /// a menu item's, a date picker's or a toast's; "" for another kind (a button's text
    /// has no reading form in Raven) or an empty handle. C: Rlabel_get_text, Rcheckbox_get_text,
    /// Rtext_input_get_text, Rtext_editor_get_text, Rmenu_item_get_text, Rdate_picker_get_text,
    /// Rtoast_get_text
    /// @returns the text the widget shows: a label's, a check box's, a text input's, a text
    ///   editor's, a menu item's, a date picker's or a toast's; "" for another kind (a button's
    ///   text has no reading form in Raven) or an empty handle
    const method Text(): string;
    var
      LKind: UIWidgetKind;
    begin
      LKind := self.Kind();
      if LKind = UIWidgetKind.Label then
        return DoRavenText(Rlabel_get_text(self.FId));
      end;
      if LKind = UIWidgetKind.CheckBox then
        return DoRavenText(Rcheckbox_get_text(self.FId));
      end;
      if LKind = UIWidgetKind.TextInput then
        return DoRavenText(Rtext_input_get_text(self.FId));
      end;
      if LKind = UIWidgetKind.TextEditor then
        return DoRavenText(Rtext_editor_get_text(self.FId));
      end;
      if LKind = UIWidgetKind.MenuItem then
        return DoRavenText(Rmenu_item_get_text(self.FId));
      end;
      if LKind = UIWidgetKind.DatePicker then
        return DoRavenText(Rdate_picker_get_text(self.FId));
      end;
      if LKind = UIWidgetKind.Toast then
        return DoRavenText(Rtoast_get_text(self.FId));
      end;
      return "";
    end;

    // ---------------------------------------------------------------------------
    // Events: each closure held until it is set again (nil: none) or Raven destroys the widget
    // ---------------------------------------------------------------------------

    /// Runs `AFunc` for each input event the widget gets, before its own handling; `AFunc`
    /// returns `true` when it handled the event (the widget's own handling skipped). C:
    /// Rwidget_set_event_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnEvent(const AFunc: UIEventFunc): self;
    begin
      if AFunc = nil then
        GWidgetEvents.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rwidget_set_event_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rwidget_set_event_callback(self.FId, DoOnWidgetEvent,
        GWidgetEvents.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` when Raven destroys the widget (`Destroy`, its parent's or window's end,
    /// the app's end); its handle is no longer valid then. C: Rwidget_set_destroy_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnDestroy(const AFunc: UITaskFunc): self;
    begin
      if AFunc = nil then
        GWidgetTasks.Clear(self.FId, ADAM_RAVEN_WIDGET_DESTROY);
        return self;
      end;
      DoHookDestroy(self.FId);
      GWidgetTasks.Put(self.FId, ADAM_RAVEN_WIDGET_DESTROY, AFunc);
      return self;
    end;

    /// Runs `AFunc` at each stage of a drag and drop over the widget (files, text, a drag of
    /// the app's own); `AFunc` returns `true` when the widget takes the drop. C:
    /// Rwidget_set_drop_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnDrop(const AFunc: UIDropFunc): self;
    begin
      if AFunc = nil then
        GWidgetDrops.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rwidget_set_drop_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rwidget_set_drop_callback(self.FId, DoOnWidgetDrop,
        GWidgetDrops.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` for each touch on the widget; `true` when it handled it. C:
    /// Rwidget_set_touch_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnTouch(const AFunc: UITouchFunc): self;
    begin
      if AFunc = nil then
        GWidgetTouches.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rwidget_set_touch_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rwidget_set_touch_callback(self.FId, DoOnWidgetTouch,
        GWidgetTouches.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` for each pen event on the widget; `true` when it handled it. C:
    /// Rwidget_set_pen_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnPen(const AFunc: UIPenFunc): self;
    begin
      if AFunc = nil then
        GWidgetPens.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rwidget_set_pen_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rwidget_set_pen_callback(self.FId, DoOnWidgetPen,
        GWidgetPens.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` for each gesture on the widget (pinch, swipe ..); `true` when it handled
    /// it. C: Rwidget_set_gesture_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnGesture(const AFunc: UIGestureFunc): self;
    begin
      if AFunc = nil then
        GWidgetGestures.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rwidget_set_gesture_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rwidget_set_gesture_callback(self.FId, DoOnWidgetGesture,
        GWidgetGestures.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// How touches on the widget act (`UITouchMode.Auto`: by its kind). C:
    /// Rwidget_set_touch_mode
    /// @param AMode the mode
    /// @returns this object, so calls chain
    const method TouchMode(const AMode: UITouchMode): self;
    begin
      Rwidget_set_touch_mode(self.FId, int32(AMode));
      return self;
    end;

    /// What `TouchMode(..)` sets, read back. C: Rwidget_get_touch_mode
    /// @returns how touches on the widget act (`UITouchMode.Auto`: by its kind)
    const method TouchMode(): UITouchMode;
    begin
      return UITouchMode(Rwidget_get_touch_mode(self.FId));
    end;

    /// `true` has the widget get gestures (OnGesture). C: Rwidget_set_touch_gestures
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method TouchGestures(const AOn: bool): self;
    begin
      Rwidget_set_touch_gestures(self.FId, DoCBool(AOn));
      return self;
    end;

    /// What `TouchGestures(..)` sets, read back. C: Rwidget_get_touch_gestures
    /// @returns `true` when `TouchGestures(..)` turned it on
    const method TouchGestures(): bool;
    begin
      return Rwidget_get_touch_gestures(self.FId) <> 0;
    end;

    /// `true` has a pen act as the mouse on the widget too. C: Rwidget_set_pen_mouse
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method PenMouse(const AOn: bool): self;
    begin
      Rwidget_set_pen_mouse(self.FId, DoCBool(AOn));
      return self;
    end;

    /// What `PenMouse(..)` sets, read back. C: Rwidget_get_pen_mouse
    /// @returns `true` when `PenMouse(..)` turned it on
    const method PenMouse(): bool;
    begin
      return Rwidget_get_pen_mouse(self.FId) <> 0;
    end;

    // ---------------------------------------------------------------------------
    // Accessibility (what screen readers are told)
    // ---------------------------------------------------------------------------

    /// The name a screen reader says for the widget. C: Rwidget_set_accessible_name
    /// @param AName the name
    /// @returns this object, so calls chain
    const method AccessibleName(const AName: string): self;
    begin
      Rwidget_set_accessible_name(self.FId, AName);
      return self;
    end;

    /// What `AccessibleName(..)` sets, read back. C: Rwidget_get_accessible_name
    /// @returns the name a screen reader says for the widget
    const method AccessibleName(): string;
    begin
      return DoRavenText(Rwidget_get_accessible_name(self.FId));
    end;

    /// The longer description a screen reader gives. C: Rwidget_set_accessible_description
    /// @param ADescription the description
    /// @returns this object, so calls chain
    const method AccessibleDescription(const ADescription: string): self;
    begin
      Rwidget_set_accessible_description(self.FId, ADescription);
      return self;
    end;

    /// What a screen reader says the widget is (`UIRole.Auto`: by its kind). C:
    /// Rwidget_set_accessible_role
    /// @param ARole the role
    /// @returns this object, so calls chain
    const method AccessibleRole(const ARole: UIRole): self;
    begin
      Rwidget_set_accessible_role(self.FId, int32(ARole));
      return self;
    end;

    /// What `AccessibleRole(..)` sets, read back. C: Rwidget_get_accessible_role
    /// @returns what a screen reader says the widget is (`UIRole.Auto`: by its kind)
    const method AccessibleRole(): UIRole;
    begin
      return UIRole(Rwidget_get_accessible_role(self.FId));
    end;

    /// `true` hides the widget and its children from screen readers. C:
    /// Rwidget_set_accessible_hidden
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method AccessibleHidden(const AOn: bool): self;
    begin
      Rwidget_set_accessible_hidden(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The widget whose text names this one for a screen reader. C:
    /// Rwidget_set_accessible_labelled_by
    /// @param ALabel the label
    /// @returns this object, so calls chain
    const method AccessibleLabelledBy(const ALabel: UIWidget): self;
    begin
      Rwidget_set_accessible_labelled_by(self.FId, ALabel.FId);
      return self;
    end;

    /// The checked state a screen reader says (a custom toggle's). C:
    /// Rwidget_set_accessible_checked
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method AccessibleChecked(const AOn: bool): self;
    begin
      Rwidget_set_accessible_checked(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Runs `AFunc` when a screen reader presses the widget (a custom control's action). C:
    /// Rwidget_set_accessible_action
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnAccessiblePress(const AFunc: UITaskFunc): self;
    begin
      if AFunc = nil then
        GWidgetTasks.Clear(self.FId, ADAM_RAVEN_WIDGET_PRESS);
        Rwidget_set_accessible_action(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rwidget_set_accessible_action(self.FId, DoOnAccessiblePress,
        GWidgetTasks.Put(self.FId, ADAM_RAVEN_WIDGET_PRESS, AFunc));
      return self;
    end;

    /// A font for the widget and everything inside it, for the texts with none of their own
    /// (a label's or text editor's own font wins; an empty handle: the theme's); kept while
    /// it is set. C: Rwidget_set_font
    /// @param AFont the font
    /// @returns this object, so calls chain
    const method Font(const AFont: UIFontRes): self;
    begin
      Rwidget_set_font(self.FId, AFont.Id());
      DoHookDestroy(self.FId);
      DoKeepFont(self.FId, ADAM_RAVEN_KEEP_FONT, AFont);
      return self;
    end;

    /// The font `Font` gave the widget, borrowed (empty for none). C: Rwidget_get_font
    /// @returns the font `Font` gave the widget, borrowed (empty for none)
    const method Font(): UIFontRes;
    begin
      return UIFontRes.View(Rwidget_get_font(self.FId));
    end;
  end;

// ============================================================================
// Windows (listing sec 4): UIWindow is a handle (a Rid Raven owns): a
// top-level window, its content a widget tree; UIWindowConfig opens one,
// set up in a chain. Raven destroys a window when it closes (Close, its
// title bar's close, its owner going) or with Raven itself; it tells no
// destroy, so the closures a window holds go when the layer next sets one
// for any window (DoSweepWindows: the windows no longer valid), when the
// window is destroyed through its handle (Destroy), or when the app ends.
// A popup's or dialog's OnClosed is a one-shot closure, taken when it runs.
// UITouch is the app's touch and pen settings, UIDrag the app's drag and
// drop. The members naming a later part's types come with that part:
// Island with UIIsland (V8).
// ============================================================================

const
  // The events a window's GWindowBools closures are held for: OnBack, OnClose
  ADAM_RAVEN_WINDOW_BACK: int32 = 0;
  ADAM_RAVEN_WINDOW_CLOSE: int32 = 1;
  // The one event each of the other window tables holds a closure for
  ADAM_RAVEN_WINDOW_EVENT: int32 = 0;

// Every closure the window AWindow held released (it is gone, or being destroyed)
func DoDropWindow(const AWindow: Rid);
begin
  GWindowBools.DropOwner(AWindow);
  GWindowKeyboards.DropOwner(AWindow);
  GWindowResizes.DropOwner(AWindow);
  GWindowDrops.DropOwner(AWindow);
  GWindowEvents.DropOwner(AWindow);
  DoDropKeptOf(AWindow);
  GWindowHeld.Remove(uint64(AWindow));
end;

// The closures of every window Raven no longer has released (Raven tells no window's
// destroy), then AWindow listed as one holding closures: before the layer sets a closure
// for AWindow
func DoSweepWindows(const AWindow: Rid);
var
  LGone: array of uint64;
  LKey: uint64;
  LI: int64;
begin
  setlength(LGone, 0);
  for LKey in GWindowHeld.Keys() do
    if Rwindow_is_valid(Rid(LKey)) = 0 then
      setlength(LGone, len(LGone) + 1);
      LGone[len(LGone) - 1] := LKey;
    end;
  end;
  for LI := 0 to len(LGone) - 1 do
    DoDropWindow(Rid(LGone[LI]));
  end;
  GWindowHeld.Put(uint64(AWindow), true);
end;

// The window trampolines: each runs its closure on a copy (one replaced while it runs
// finishes); a closure the table no longer holds (its window gone) is never reached. One
// with no closure answers as Raven does with no callback set
func clink DoOnWindowBack(window: Rid; user_data: ptr): int32;
var
  LFunc: UIAskFunc;
begin
  if not GWindowBools.Find(user_data, LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  return DoCBool(LFunc());
end;

func clink DoOnWindowClose(window: Rid; user_data: ptr): int32;
var
  LFunc: UIAskFunc;
begin
  if not GWindowBools.Find(user_data, LFunc) or (LFunc = nil) then
    return R_TRUE;
  end;
  return DoCBool(LFunc());
end;

func clink DoOnWindowKeyboard(window: Rid; visible: int32; height: float32; user_data: ptr);
var
  LFunc: UIKeyboardFunc;
begin
  if not GWindowKeyboards.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(visible <> 0, height);
end;

func clink DoOnWindowResize(window: Rid; width: int32; height: int32; user_data: ptr);
var
  LFunc: UIResizeFunc;
begin
  if not GWindowResizes.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(width, height);
end;

func clink DoOnWindowDrop(target: Rid; event: ptr to const RDropEvent; user_data: ptr): int32;
var
  LFunc: UIDropFunc;
begin
  if not GWindowDrops.Find(user_data, LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  return DoCBool(LFunc(event^));
end;

func clink DoOnWindowEvent(window: Rid; event: ptr to const REvent; user_data: ptr): int32;
var
  LFunc: UIEventFunc;
begin
  if not GWindowEvents.Find(user_data, LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  return DoCBool(LFunc(event^));
end;

// A popup or dialog closed: its one-shot closure taken (no longer held), then run
func clink DoOnClosed(content: Rid; result: int32; user_data: ptr);
var
  LFunc: UIClosedFunc;
begin
  if not GClosedSlots.Take(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(result);
end;

public forward type UIWindowConfig;

public type
  /// A top-level window: a handle naming a window Raven owns (copies name the same window).
  /// Opened by `UIWindowConfig.Open` (`UIWindow.Config()`), `UIWindow.Create` or from XML; its
  /// content is a widget tree (`Content`, `Find<T>`). Raven destroys it when it closes or
  /// with the app; its handles are then no longer valid (`IsValid()`).
  /// @example `LWindow := UIWindow.Config().Title("Notes").Size(800, 600).Center().Open();`
  UIWindow = object
    hidden FId: Rid;

    /// An empty handle (names no window: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
      self.FId := R_INVALID_ID;
    end;

    // AId as this handle's window
    hidden method DoSet(const AId: Rid);
    begin
      self.FId := AId;
    end;

    /// A window opened in a chain (`UIWindowConfig`): title, size, flags and the rest, then
    /// `Open()`.
    /// @returns a window opened in a chain (`UIWindowConfig`): title, size, flags and the rest,
    ///   then `Open()`
    static method Config(): UIWindowConfig;
    var
      LConfig: UIWindowConfig;
    begin
      return LConfig;
    end;

    /// Opens a window of the title `ATitle` and the size `AWidth` x `AHeight` (logical units),
    /// shown with Raven's defaults. C: Rwindow_create
    /// @param ATitle the title
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns the new `UIWindow`
    static method Create(const ATitle: string; const AWidth: int32; const AHeight: int32): UIWindow;
    begin
      return UIWindow.Wrap(Rwindow_create(ATitle, AWidth, AHeight, uint32(R_WINDOW_DEFAULT)));
    end;

    /// A window made from the XML window file `APath` (`IsValid()` false when it does not
    /// load: its error reported to `UIErrors`). C: Rwindow_create_from_xml_file
    /// @param APath the file's path
    /// @returns a window made from the XML window file `APath` (`IsValid()` false when it does not
    ///   load: its error reported to `UIErrors`)
    static method FromXML(const APath: string): UIWindow;
    begin
      return UIWindow.Wrap(Rwindow_create_from_xml_file(APath));
    end;

    /// A window made from the XML window text `AXML`. C: Rwindow_create_from_xml
    /// @param AXML the XML text
    /// @returns a window made from the XML window text `AXML`
    static method FromXMLText(const AXML: string): UIWindow;
    begin
      return UIWindow.Wrap(Rwindow_create_from_xml(AXML, uint64(len(AXML))));
    end;

    /// The handle of the window System.Raven.C gave as `AId` (`R_INVALID_ID`: an empty one).
    /// @param AId the id
    /// @returns the handle of the window System.Raven.C gave as `AId` (`R_INVALID_ID`: an empty
    ///   one)
    static method Wrap(const AId: Rid): UIWindow;
    var
      LWindow: UIWindow;
    begin
      LWindow.DoSet(AId);
      return LWindow;
    end;

    /// The window's Rid, for System.Raven.C's calls.
    /// @returns the window's Rid, for System.Raven.C's calls
    const method Id(): Rid;
    begin
      return self.FId;
    end;

    /// `true` while the handle names a window (one Raven has not destroyed). C:
    /// Rwindow_is_valid
    /// @returns `true` while the handle names a window (one Raven has not destroyed)
    const method IsValid(): bool;
    begin
      return Rwindow_is_valid(self.FId) <> 0;
    end;

    /// Asks the window to close, as its title bar's close does: its `OnClose` may refuse.
    /// C: Rwindow_close
    const method Close();
    begin
      Rwindow_close(self.FId);
    end;

    /// Closes the window at once (no `OnClose` asked) and destroys its content; its handles
    /// are no longer valid and its closures are released. C: Rwindow_destroy
    const method Destroy();
    begin
      DoDropWindow(self.FId);
      Rwindow_destroy(self.FId);
    end;

    // ---------------------------------------------------------------------------
    // Content and finding
    // ---------------------------------------------------------------------------

    /// `AWidget` as the window's content (the root of what it shows). C: Rwindow_set_content
    /// @param AWidget the widget
    /// @returns this object, so calls chain
    const method Content(const AWidget: UIWidget): self;
    begin
      Rwindow_set_content(self.FId, AWidget.Id());
      return self;
    end;

    /// The window's content (an empty handle when it has none). C: Rwindow_get_content
    /// @returns the window's content (an empty handle when it has none)
    const method Content(): UIWidget;
    begin
      return UIWidget.Wrap(Rwindow_get_content(self.FId));
    end;

    /// The widget named `AName` in the window's content, viewed as `T` (`UIWidget.Find<T>`).
    /// @param AName the name
    /// @returns the widget named `AName` in the window's content, viewed as `T`
    ///   (`UIWidget.Find<T>`)
    /// @raises `ADAM_RAVEN_EXC_NOT_FOUND` when none has the name, `ADAM_RAVEN_EXC_KIND` when
    /// it is of a kind `T` does not view
    const method Find<T>(const AName: string): T;
    begin
      return self.Content().Find<T>(AName);
    end;

    /// `true` when a widget of a kind `T` views is named `AName` in the window's content.
    /// @param AName the name
    /// @returns `true` when a widget of a kind `T` views is named `AName` in the window's content
    const method Has<T>(const AName: string): bool;
    begin
      return self.Content().Has<T>(AName);
    end;

    // ---------------------------------------------------------------------------
    // Title, size, place
    // ---------------------------------------------------------------------------

    /// The title its title bar and the taskbar show. C: Rwindow_set_title
    /// @param ATitle the title
    /// @returns this object, so calls chain
    const method Title(const ATitle: string): self;
    begin
      Rwindow_set_title(self.FId, ATitle);
      return self;
    end;

    /// What `Title(..)` sets, read back. C: Rwindow_get_title
    /// @returns the title its title bar and the taskbar show
    const method Title(): string;
    begin
      return DoRavenText(Rwindow_get_title(self.FId));
    end;

    /// The client area's size in logical units. C: Rwindow_set_size
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    const method Size(const AWidth: int32; const AHeight: int32): self;
    begin
      Rwindow_set_size(self.FId, AWidth, AHeight);
      return self;
    end;

    /// The client area's size in logical units. C: Rwindow_get_size
    /// @returns the client area's size in logical units
    const method Size(): UISize;
    var
      LW: int32;
      LH: int32;
      LSize: UISize;
    begin
      LW := 0;
      LH := 0;
      Rwindow_get_size(self.FId, addr of LW, addr of LH);
      LSize.w := float32(LW);
      LSize.h := float32(LH);
      return LSize;
    end;

    /// The smallest size the user can make it, in logical units. C: Rwindow_set_min_size
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    const method MinSize(const AWidth: int32; const AHeight: int32): self;
    begin
      Rwindow_set_min_size(self.FId, AWidth, AHeight);
      return self;
    end;

    /// Its top-left corner on the screen. C: Rwindow_set_position
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    /// @returns this object, so calls chain
    const method Position(const AX: int32; const AY: int32): self;
    begin
      Rwindow_set_position(self.FId, AX, AY);
      return self;
    end;

    /// Its top-left corner on the screen. C: Rwindow_get_position
    /// @returns its top-left corner on the screen
    const method Position(): UIPoint;
    var
      LX: int32;
      LY: int32;
      LPoint: UIPoint;
    begin
      LX := 0;
      LY := 0;
      Rwindow_get_position(self.FId, addr of LX, addr of LY);
      LPoint.x := float32(LX);
      LPoint.y := float32(LY);
      return LPoint;
    end;

    /// Centred on its screen. C: Rwindow_center
    /// @returns this object, so calls chain
    const method Center(): self;
    begin
      Rwindow_center(self.FId);
      return self;
    end;

    /// The client area's size in pixels (its size x its scale). C: Rwindow_get_framebuffer_size
    /// @returns the client area's size in pixels (its size x its scale)
    const method FramebufferSize(): UISize;
    var
      LW: int32;
      LH: int32;
      LSize: UISize;
    begin
      LW := 0;
      LH := 0;
      Rwindow_get_framebuffer_size(self.FId, addr of LW, addr of LH);
      LSize.w := float32(LW);
      LSize.h := float32(LH);
      return LSize;
    end;

    /// Pixels per logical unit on its screen (1.0 at 96 DPI). C: Rwindow_get_scale
    /// @returns the pixels per logical unit
    const method Scale(): float32;
    begin
      return Rwindow_get_scale(self.FId);
    end;

    /// The edges system bars and notches cover (content laid out inside them). C:
    /// Rwindow_get_safe_area
    /// @returns the edges system bars and notches cover (content laid out inside them)
    const method SafeArea(): RInsets;
    var
      LInsets: RInsets;
    begin
      Rwindow_get_safe_area(self.FId, addr of LInsets);
      return LInsets;
    end;

    /// The edges the on-screen keyboard covers (zero while it is hidden). C:
    /// Rwindow_get_keyboard_area
    /// @returns the edges the on-screen keyboard covers (zero while it is hidden)
    const method KeyboardArea(): RInsets;
    var
      LInsets: RInsets;
    begin
      Rwindow_get_keyboard_area(self.FId, addr of LInsets);
      return LInsets;
    end;

    // ---------------------------------------------------------------------------
    // State
    // ---------------------------------------------------------------------------

    /// Shows the window. C: Rwindow_show
    /// @returns this object, so calls chain
    const method Show(): self;
    begin
      Rwindow_show(self.FId);
      return self;
    end;

    /// Hides the window. C: Rwindow_hide
    /// @returns this object, so calls chain
    const method Hide(): self;
    begin
      Rwindow_hide(self.FId);
      return self;
    end;

    /// Brings it forward as the window the user works in. C: Rwindow_focus
    /// @returns this object, so calls chain
    const method Focus(): self;
    begin
      Rwindow_focus(self.FId);
      return self;
    end;

    /// Maximizes the window. C: Rwindow_maximize
    /// @returns this object, so calls chain
    const method Maximize(): self;
    begin
      Rwindow_maximize(self.FId);
      return self;
    end;

    /// Minimizes the window. C: Rwindow_minimize
    /// @returns this object, so calls chain
    const method Minimize(): self;
    begin
      Rwindow_minimize(self.FId);
      return self;
    end;

    /// Back from maximized or minimized. C: Rwindow_restore
    /// @returns this object, so calls chain
    const method Restore(): self;
    begin
      Rwindow_restore(self.FId);
      return self;
    end;

    /// True while the window is maximized. C: Rwindow_is_maximized
    /// @returns `true` when it is maximized
    const method Maximized(): bool;
    begin
      return Rwindow_is_maximized(self.FId) <> 0;
    end;

    /// True while the window is minimized. C: Rwindow_is_minimized
    /// @returns `true` when it is minimized
    const method Minimized(): bool;
    begin
      return Rwindow_is_minimized(self.FId) <> 0;
    end;

    /// `true` while it is the window the user works in. C: Rwindow_is_active
    /// @returns `true` while it is the window the user works in
    const method Active(): bool;
    begin
      return Rwindow_is_active(self.FId) <> 0;
    end;

    /// Starts the system's move of the window with the pointer (a custom header bar's drag). C:
    /// Rwindow_begin_move
    const method BeginMove();
    begin
      Rwindow_begin_move(self.FId);
    end;

    /// Starts the system's resize of the window from its edge `AEdge`. C: Rwindow_begin_resize
    /// @param AEdge the edge
    const method BeginResize(const AEdge: UIEdge);
    begin
      Rwindow_begin_resize(self.FId, int32(AEdge));
    end;

    // ---------------------------------------------------------------------------
    // Look
    // ---------------------------------------------------------------------------

    /// The colour the window is cleared to under its content. C: Rwindow_set_clear_color
    /// @param AColor the colour
    /// @returns this object, so calls chain
    const method ClearColor(const AColor: UIColor): self;
    begin
      Rwindow_set_clear_color(self.FId, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// What shows through behind its content (a transparent window's blur, acrylic, mica).
    /// @param ABackdrop the backdrop
    /// @returns `false` when the system cannot show it. C: Rwindow_set_backdrop
    const method Backdrop(const ABackdrop: UIBackdrop): bool;
    begin
      return Rwindow_set_backdrop(self.FId, int32(ABackdrop)) <> 0;
    end;

    /// What shows through behind its content, as `Backdrop(..)` set it. C: Rwindow_get_backdrop
    /// @returns the backdrop
    const method Backdrop(): UIBackdrop;
    begin
      return UIBackdrop(Rwindow_get_backdrop(self.FId));
    end;

    /// A theme of its own, by name ("Dark", a theme `UITheme` loaded; "" follows the app's).
    /// @param AName the name
    /// @returns `false` (the error reported) when no theme has that name. C: Rwindow_set_theme
    const method Theme(const AName: string): bool;
    begin
      return Rwindow_set_theme(self.FId, AName) <> 0;
    end;

    /// One of Raven's built-in themes as its own. C: Rwindow_set_theme
    /// @param AKind the kind
    /// @returns this object, so calls chain
    const method Theme(const AKind: UIThemeKind): self;
    begin
      Rwindow_set_theme(self.FId, nameof(AKind));
      return self;
    end;

    /// The name of the theme it uses. C: Rwindow_get_theme
    /// @returns the name of the theme it uses
    const method Theme(): string;
    begin
      return DoRavenText(Rwindow_get_theme(self.FId));
    end;

    /// `true` when it has a theme of its own (not the app's). C: Rwindow_has_own_theme
    /// @returns `true` when it has a theme of its own (not the app's)
    const method HasOwnTheme(): bool;
    begin
      return Rwindow_has_own_theme(self.FId) <> 0;
    end;

    /// The whole window's opacity (0 clear .. 1 opaque).
    /// @param AOpacity the opacity
    /// @returns `false` when the system cannot fade windows. C: Rwindow_set_opacity
    const method Opacity(const AOpacity: float32): bool;
    begin
      return Rwindow_set_opacity(self.FId, AOpacity) <> 0;
    end;

    /// The whole window's opacity (0 clear .. 1 opaque). C: Rwindow_get_opacity
    /// @returns the opacity
    const method Opacity(): float32;
    begin
      return Rwindow_get_opacity(self.FId);
    end;

    /// `true` keeps it above the other windows.
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns `false` when the system cannot. C: Rwindow_set_topmost
    const method Topmost(const AOn: bool): bool;
    begin
      return Rwindow_set_topmost(self.FId, DoCBool(AOn)) <> 0;
    end;

    /// The window it belongs to: kept above it and minimized with it where the window system
    /// does it, destroyed with it everywhere (an empty handle: none).
    /// @param AOwner the owner
    /// @returns `false` when the window system cannot keep it with its owner (it is still
    /// destroyed with it), or nothing changed: `AOwner` is not valid or is owned by it. C:
    /// Rwindow_set_owner
    const method Owner(const AOwner: UIWindow): bool;
    begin
      return Rwindow_set_owner(self.FId, AOwner.FId) <> 0;
    end;

    /// The window it belongs to (an empty handle: none). C: Rwindow_get_owner
    /// @returns the owner window
    const method Owner(): UIWindow;
    begin
      return UIWindow.Wrap(Rwindow_get_owner(self.FId));
    end;

    /// `true` shows it as a small picture-in-picture window over the others.
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns `false` when the system cannot. C: Rwindow_set_picture_in_picture
    const method PictureInPicture(const AOn: bool): bool;
    begin
      return Rwindow_set_picture_in_picture(self.FId, DoCBool(AOn)) <> 0;
    end;

    /// True while it shows as a picture-in-picture window. C: Rwindow_is_picture_in_picture
    /// @returns `true` when it does
    const method PictureInPicture(): bool;
    begin
      return Rwindow_is_picture_in_picture(self.FId) <> 0;
    end;

    /// Where the picture-in-picture window sits and its size. C:
    /// Rwindow_set_picture_in_picture_layout
    /// @param ACorner the corner
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    const method PipLayout(const ACorner: UIPipCorner; const AWidth: int32;
      const AHeight: int32): self;
    begin
      Rwindow_set_picture_in_picture_layout(self.FId, AWidth, AHeight, int32(ACorner));
      return self;
    end;

    /// `true` shows Raven's widget inspector for it. C: Rwindow_set_inspector
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method Inspector(const AOn: bool): self;
    begin
      Rwindow_set_inspector(self.FId, DoCBool(AOn));
      return self;
    end;

    /// True while Raven's widget inspector is shown for it. C: Rwindow_is_inspector_shown
    /// @returns `true` when it is shown
    const method InspectorShown(): bool;
    begin
      return Rwindow_is_inspector_shown(self.FId) <> 0;
    end;

    /// The inspector's own window (an empty handle while it is not shown). C:
    /// Rwindow_get_inspector
    /// @returns the inspector's own window (an empty handle while it is not shown)
    const method Inspector(): UIWindow;
    begin
      return UIWindow.Wrap(Rwindow_get_inspector(self.FId));
    end;

    /// `true` for the splash screen Raven showed at the start (destroyed once the app's main
    /// window is ready). C: Rwindow_is_splash_screen
    /// @returns `true` for the splash screen Raven showed at the start (destroyed once the app's
    ///   main window is ready)
    const method SplashScreen(): bool;
    begin
      return Rwindow_is_splash_screen(self.FId) <> 0;
    end;

    /// Draws it again at the next frame. C: Rwindow_request_redraw
    const method Redraw();
    begin
      Rwindow_request_redraw(self.FId);
    end;

    /// `true` draws it every frame (games, live views), not only when something changed. C:
    /// Rwindow_set_continuous_redraw
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method ContinuousRedraw(const AOn: bool): self;
    begin
      Rwindow_set_continuous_redraw(self.FId, DoCBool(AOn));
      return self;
    end;

    /// A pointer of the program's own kept with the window. C: Rwindow_set_user_handle
    /// @param AHandle the handle
    /// @returns this object, so calls chain
    const method UserHandle(const AHandle: ptr): self;
    begin
      Rwindow_set_user_handle(self.FId, AHandle);
      return self;
    end;

    /// What `UserHandle(..)` sets, read back. C: Rwindow_get_user_handle
    /// @returns a pointer of the program's own kept with the window
    const method UserHandle(): ptr;
    begin
      return Rwindow_get_user_handle(self.FId);
    end;

    /// The system's own window (HWND, X11 Window, wl_surface ..) into `ANative`.
    /// @param ANative receives the native window
    /// @returns `false` when the window has none (headless). C: Rwindow_get_native_handle
    const method NativeHandle(var ANative: RNativeWindow): bool;
    begin
      return Rwindow_get_native_handle(self.FId, addr of ANative) <> 0;
    end;

    /// What the window shows, as RGBA bytes (`AWidth` x `AHeight` pixels, rows from the top);
    /// empty when it cannot be captured. Waits for the frame to be drawn. C: Rwindow_capture,
    /// Rpixels_free
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns what the window shows, as RGBA bytes (`AWidth` x `AHeight` pixels, rows from the
    ///   top); empty when it cannot be captured
    const method Capture(var AWidth: int32; var AHeight: int32): array of uint8;
    var
      LPixels: ptr to uint8;
      LBytes: array of uint8;
      LI: int64;
    begin
      AWidth := 0;
      AHeight := 0;
      setlength(LBytes, 0);
      LPixels := Rwindow_capture(self.FId, addr of AWidth, addr of AHeight);
      if LPixels = nil then
        AWidth := 0;
        AHeight := 0;
        return LBytes;
      end;
      setlength(LBytes, int64(AWidth) * int64(AHeight) * 4);
      for LI := 0 to len(LBytes) - 1 do
        LBytes[LI] := LPixels[LI];
      end;
      Rpixels_free(LPixels);
      return LBytes;
    end;

    /// The last frame's timings and counts. C: Rwindow_get_frame_stats
    /// @returns the last frame's timings and counts
    const method FrameStats(): RFrameStats;
    var
      LStats: RFrameStats;
    begin
      Rwindow_get_frame_stats(self.FId, addr of LStats);
      return LStats;
    end;

    // ---------------------------------------------------------------------------
    // Focus, pointer, keyboard
    // ---------------------------------------------------------------------------

    /// The widget keys go to (an empty handle: none). C: Rwindow_get_focused_widget
    /// @returns the widget keys go to (an empty handle: none)
    const method FocusedWidget(): UIWidget;
    begin
      return UIWidget.Wrap(Rwindow_get_focused_widget(self.FId));
    end;

    /// The widget under the pointer (an empty handle: none). C: Rwindow_get_hovered_widget
    /// @returns the widget under the pointer (an empty handle: none)
    const method HoveredWidget(): UIWidget;
    begin
      return UIWidget.Wrap(Rwindow_get_hovered_widget(self.FId));
    end;

    /// No widget has the keyboard focus. C: Rwindow_clear_focus
    /// @returns this object, so calls chain
    const method ClearFocus(): self;
    begin
      Rwindow_clear_focus(self.FId);
      return self;
    end;

    /// The pointer in the window's logical units. C: Rwindow_get_mouse_position
    /// @returns the pointer in the window's logical units
    const method MousePosition(): UIPoint;
    var
      LPoint: UIPoint;
    begin
      LPoint.x := 0.0f;
      LPoint.y := 0.0f;
      Rwindow_get_mouse_position(self.FId, addr of LPoint.x, addr of LPoint.y);
      return LPoint;
    end;

    /// `true` while `AKey` is held down. C: Rwindow_is_key_down
    /// @param AKey the key
    /// @returns `true` while `AKey` is held down
    const method KeyDown(const AKey: UIKey): bool;
    begin
      return Rwindow_is_key_down(self.FId, int32(AKey)) <> 0;
    end;

    /// `true` while `AButton` is held down. C: Rwindow_is_mouse_button_down
    /// @param AButton the button
    /// @returns `true` while `AButton` is held down
    const method MouseDown(const AButton: UIPointerButton): bool;
    begin
      return Rwindow_is_mouse_button_down(self.FId, int32(AButton)) <> 0;
    end;

    /// The modifier keys held down. C: Rwindow_get_modifiers
    /// @returns the modifier keys held down
    const method Mods(): UIModifiers;
    begin
      return UIModifiers(Rwindow_get_modifiers(self.FId));
    end;

    /// `true` while the pointer is over the window. C: Rwindow_is_mouse_inside
    /// @returns `true` while the pointer is over the window
    const method MouseInside(): bool;
    begin
      return Rwindow_is_mouse_inside(self.FId) <> 0;
    end;

    /// `true` (the default) moves the focus with Tab / Shift+Tab. C: Rwindow_set_tab_navigation
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method TabNavigation(const AOn: bool): self;
    begin
      Rwindow_set_tab_navigation(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `AKey` with the modifiers `AMods` runs the action `AAction` (an action `UIActions`
    /// registered). C: Rwindow_register_shortcut
    /// @param AKey the key
    /// @param AMods the modifier keys
    /// @param AAction the action
    /// @returns this object, so calls chain
    const method Shortcut(const AKey: UIKey; const AMods: UIModifiers; const AAction: string): self;
    begin
      Rwindow_register_shortcut(self.FId, int32(AKey), uint32(AMods), AAction);
      return self;
    end;

    /// The shortcut `AKey` with `AMods` removed. C: Rwindow_unregister_shortcut
    /// @param AKey the key
    /// @param AMods the modifier keys
    /// @returns this object, so calls chain
    const method RemoveShortcut(const AKey: UIKey; const AMods: UIModifiers): self;
    begin
      Rwindow_unregister_shortcut(self.FId, int32(AKey), uint32(AMods));
      return self;
    end;

    // ---------------------------------------------------------------------------
    // Text input (IME, on-screen keyboard)
    // ---------------------------------------------------------------------------

    /// `true` while a text field has the focus (the on-screen keyboard is wanted). C:
    /// Rwindow_wants_text_input
    /// @returns `true` while a text field has the focus (the on-screen keyboard is wanted)
    const method WantsTextInput(): bool;
    begin
      return Rwindow_wants_text_input(self.FId) <> 0;
    end;

    /// The focused text field's keyboard settings into `AInfo`.
    /// @param AInfo the info
    /// @returns `false` when no text field has the focus. C: Rwindow_get_text_input_info
    const method TextInputInfo(var AInfo: RTextInputInfo): bool;
    begin
      return Rwindow_get_text_input_info(self.FId, addr of AInfo) <> 0;
    end;

    /// The focused text field's text ("" when none has the focus). C:
    /// Rwindow_get_text_input_text
    /// @returns the focused text field's text ("" when none has the focus)
    const method TextInputText(): string;
    begin
      return DoRavenText(Rwindow_get_text_input_text(self.FId));
    end;

    /// The focused text field's selection into `AStart` .. `AStop` (byte offsets).
    /// @param AStart the start
    /// @param AStop the byte offset it ends at
    /// @returns `false` when no text field has the focus. C: Rwindow_get_text_input_selection
    const method TextInputSelection(var AStart: int32; var AStop: int32): bool;
    begin
      return Rwindow_get_text_input_selection(self.FId, addr of AStart, addr of AStop) <> 0;
    end;

    /// The focused text field's selection set to `AStart` .. `AStop` (byte offsets).
    /// @param AStart the start
    /// @param AStop the byte offset it ends at
    /// @returns `false` when no text field has the focus. C: Rwindow_set_text_input_selection
    const method SelectTextInput(const AStart: int32; const AStop: int32): bool;
    begin
      return Rwindow_set_text_input_selection(self.FId, AStart, AStop) <> 0;
    end;

    /// The focused text field's bytes `AStart` .. `AStop` replaced by `AText` (an IME's commit).
    /// @param AStart the start
    /// @param AStop the byte offset it ends at
    /// @param AText the text
    /// @returns `false` when no text field has the focus. C: Rwindow_replace_text_input
    const method ReplaceTextInput(const AStart: int32; const AStop: int32; const AText: string): bool;
    begin
      return Rwindow_replace_text_input(self.FId, AStart, AStop, AText) <> 0;
    end;

    /// Where the focused text field's caret is, for an IME's candidate window (zero when none
    /// has the focus). C: Rwindow_get_text_input_rect
    /// @returns where the focused text field's caret is, for an IME's candidate window (zero when
    ///   none has the focus)
    const method TextInputRect(): UIRect;
    var
      LX: int32;
      LY: int32;
      LW: int32;
      LH: int32;
      LRect: UIRect;
    begin
      LX := 0;
      LY := 0;
      LW := 0;
      LH := 0;
      Rwindow_get_text_input_rect(self.FId, addr of LX, addr of LY, addr of LW, addr of LH);
      LRect.x := float32(LX);
      LRect.y := float32(LY);
      LRect.w := float32(LW);
      LRect.h := float32(LH);
      return LRect;
    end;

    /// Runs `AFunc` when the on-screen keyboard shows or hides (`nil`: none). C:
    /// Rwindow_set_keyboard_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnKeyboard(const AFunc: UIKeyboardFunc): self;
    begin
      if AFunc = nil then
        GWindowKeyboards.Clear(self.FId, ADAM_RAVEN_WINDOW_EVENT);
        Rwindow_set_keyboard_callback(self.FId, nil, nil);
        return self;
      end;
      DoSweepWindows(self.FId);
      Rwindow_set_keyboard_callback(self.FId, DoOnWindowKeyboard,
        GWindowKeyboards.Put(self.FId, ADAM_RAVEN_WINDOW_EVENT, AFunc));
      return self;
    end;

    // ---------------------------------------------------------------------------
    // Back, close, resize, drop, every event
    // ---------------------------------------------------------------------------

    /// Runs `AFunc` for the system's back (Android's back, a mouse's back button): `true` when
    /// it handled it (`nil`: none). C: Rwindow_set_back_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnBack(const AFunc: UIAskFunc): self;
    begin
      if AFunc = nil then
        GWindowBools.Clear(self.FId, ADAM_RAVEN_WINDOW_BACK);
        Rwindow_set_back_callback(self.FId, nil, nil);
        return self;
      end;
      DoSweepWindows(self.FId);
      Rwindow_set_back_callback(self.FId, DoOnWindowBack,
        GWindowBools.Put(self.FId, ADAM_RAVEN_WINDOW_BACK, AFunc));
      return self;
    end;

    /// `true` tells the system the window takes the back (its `OnBack` runs). C:
    /// Rwindow_set_back_enabled
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method BackEnabled(const AOn: bool): self;
    begin
      Rwindow_set_back_enabled(self.FId, DoCBool(AOn));
      return self;
    end;

    /// True while Back would be taken: a popup or dialog is open, or `BackEnabled(true)` said so.
    /// C: Rwindow_wants_back
    /// @returns `true` when it would
    const method WantsBack(): bool;
    begin
      return Rwindow_wants_back(self.FId) <> 0;
    end;

    /// Runs `AFunc` when the user asks to close the window: `true` lets it close, `false`
    /// keeps it open (`nil`: it closes). C: Rwindow_set_close_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnClose(const AFunc: UIAskFunc): self;
    begin
      if AFunc = nil then
        GWindowBools.Clear(self.FId, ADAM_RAVEN_WINDOW_CLOSE);
        Rwindow_set_close_callback(self.FId, nil, nil);
        return self;
      end;
      DoSweepWindows(self.FId);
      Rwindow_set_close_callback(self.FId, DoOnWindowClose,
        GWindowBools.Put(self.FId, ADAM_RAVEN_WINDOW_CLOSE, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the new size (logical units) when the window is resized (`nil`:
    /// none). C: Rwindow_set_resize_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnResize(const AFunc: UIResizeFunc): self;
    begin
      if AFunc = nil then
        GWindowResizes.Clear(self.FId, ADAM_RAVEN_WINDOW_EVENT);
        Rwindow_set_resize_callback(self.FId, nil, nil);
        return self;
      end;
      DoSweepWindows(self.FId);
      Rwindow_set_resize_callback(self.FId, DoOnWindowResize,
        GWindowResizes.Put(self.FId, ADAM_RAVEN_WINDOW_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` at each stage of a drag and drop over the window that no widget took:
    /// `true` when it takes the drop (`nil`: none). C: Rwindow_set_drop_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnDrop(const AFunc: UIDropFunc): self;
    begin
      if AFunc = nil then
        GWindowDrops.Clear(self.FId, ADAM_RAVEN_WINDOW_EVENT);
        Rwindow_set_drop_callback(self.FId, nil, nil);
        return self;
      end;
      DoSweepWindows(self.FId);
      Rwindow_set_drop_callback(self.FId, DoOnWindowDrop,
        GWindowDrops.Put(self.FId, ADAM_RAVEN_WINDOW_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` for every input event before any widget gets it: `true` when it handled
    /// the event, so no widget gets it (`nil`: none). C: Rwindow_set_event_hook
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnEvent(const AFunc: UIEventFunc): self;
    begin
      if AFunc = nil then
        GWindowEvents.Clear(self.FId, ADAM_RAVEN_WINDOW_EVENT);
        Rwindow_set_event_hook(self.FId, nil, nil);
        return self;
      end;
      DoSweepWindows(self.FId);
      Rwindow_set_event_hook(self.FId, DoOnWindowEvent,
        GWindowEvents.Put(self.FId, ADAM_RAVEN_WINDOW_EVENT, AFunc));
      return self;
    end;

    // ---------------------------------------------------------------------------
    // Popups, dialogs, message boxes
    // ---------------------------------------------------------------------------

    /// `true` while a popup is open in the window. C: Rwindow_has_popup
    /// @returns `true` while a popup is open in the window
    const method HasPopup(): bool;
    begin
      return Rwindow_has_popup(self.FId) <> 0;
    end;

    /// How many popups are open, the innermost last. C: Rwindow_get_popup_count
    /// @returns how many popups are open, the innermost last
    const method PopupCount(): int32;
    begin
      return Rwindow_get_popup_count(self.FId);
    end;

    /// The content of the open popup at `AIndex` (0: the outermost). C: Rwindow_get_popup
    /// @param AIndex the index, from 0
    /// @returns the content of the open popup at `AIndex` (0: the outermost)
    const method Popup(const AIndex: int32): UIWidget;
    begin
      return UIWidget.Wrap(Rwindow_get_popup(self.FId, AIndex));
    end;

    /// Every open popup closed. C: Rwindow_close_popups
    /// @returns this object, so calls chain
    const method ClosePopups(): self;
    begin
      Rwindow_close_popups(self.FId);
      return self;
    end;

    /// Opens `AContent` as a popup at `AAt` (logical units); `AOnClosed` runs once with its
    /// result when it closes (`nil`: none). C: Rpopup_open
    /// @param AContent the content widget
    /// @param AAt the point
    /// @param AOnClosed the on closed
    const method Popup(const AContent: UIWidget; const AAt: UIPoint; const AOnClosed: UIClosedFunc);
    begin
      if AOnClosed = nil then
        Rpopup_open(self.FId, AContent.Id(), AAt.x, AAt.y, nil, nil);
        return;
      end;
      Rpopup_open(self.FId, AContent.Id(), AAt.x, AAt.y, DoOnClosed, GClosedSlots.PutOnce(AOnClosed));
    end;

    /// The popup whose content is `AContent` closed with the result `AResult`. C: Rpopup_close
    /// @param AContent the content widget
    /// @param AResult the result
    static method ClosePopup(const AContent: UIWidget; const AResult: int32);
    begin
      Rpopup_close(AContent.Id(), AResult);
    end;

    /// `true` while `AContent` is open as a popup. C: Rpopup_is_open
    /// @param AContent the content widget
    /// @returns `true` while `AContent` is open as a popup
    static method PopupOpen(const AContent: UIWidget): bool;
    begin
      return Rpopup_is_open(AContent.Id()) <> 0;
    end;

    /// Opens `AContent` as a modal dialog over the window; `AOnClosed` runs once with its
    /// result when it closes (`nil`: none). C: Rdialog_open
    /// @param AContent the content widget
    /// @param AOnClosed the on closed
    const method Dialog(const AContent: UIWidget; const AOnClosed: UIClosedFunc);
    begin
      if AOnClosed = nil then
        Rdialog_open(self.FId, AContent.Id(), nil, nil);
        return;
      end;
      Rdialog_open(self.FId, AContent.Id(), DoOnClosed, GClosedSlots.PutOnce(AOnClosed));
    end;

    /// The dialog whose content is `AContent` closed with the result `AResult`. C: Rdialog_close
    /// @param AContent the content widget
    /// @param AResult the result
    static method CloseDialog(const AContent: UIWidget; const AResult: int32);
    begin
      Rdialog_close(AContent.Id(), AResult);
    end;

    /// Opens `AContent` as a modal dialog and waits (the app's frames go on) until it closes.
    /// @param AContent the content widget
    /// @returns its result. C: Rdialog_run
    const method RunDialog(const AContent: UIWidget): int32;
    begin
      return Rdialog_run(self.FId, AContent.Id());
    end;

    /// `true` while a dialog is open over the window. C: Rwindow_has_dialog
    /// @returns `true` while a dialog is open over the window
    const method HasDialog(): bool;
    begin
      return Rwindow_has_dialog(self.FId) <> 0;
    end;

    /// Shows a message box over the window and waits for the user's answer.
    /// @param ATitle the title
    /// @param AText the text
    /// @param AButtons the buttons
    /// @returns the button pressed. C: Rmessage_box
    /// @example `if LWindow.Message("Quit", "Save first?", UIMessageButtons.YesNo) = UIMessageResult.Yes then`
    const method Message(const ATitle: string; const AText: string;
      const AButtons: UIMessageButtons): UIMessageResult;
    begin
      return UIMessageResult(Rmessage_box(self.FId, ATitle, AText, int32(AButtons)));
    end;

    // ---------------------------------------------------------------------------
    // Touch, taskbar
    // ---------------------------------------------------------------------------

    /// Its own touch and pen settings (over the app's, `UITouch`). C: Rwindow_set_touch_settings
    /// @param ASettings the settings
    /// @returns this object, so calls chain
    const method TouchSettings(const ASettings: RTouchSettings): self;
    begin
      Rwindow_set_touch_settings(self.FId, addr of ASettings);
      return self;
    end;

    /// What `TouchSettings(..)` sets, read back. C: Rwindow_get_touch_settings
    /// @returns its own touch and pen settings (over the app's, `UITouch`)
    const method TouchSettings(): RTouchSettings;
    var
      LSettings: RTouchSettings;
    begin
      Rwindow_get_touch_settings(self.FId, addr of LSettings);
      return LSettings;
    end;

    /// How many fingers touch the window now. C: Rwindow_get_touch_count
    /// @returns how many fingers touch the window now
    const method TouchCount(): int32;
    begin
      return Rwindow_get_touch_count(self.FId);
    end;

    /// `true` while a pen hovers over or touches the window. C: Rwindow_is_pen_in_range
    /// @returns `true` while a pen hovers over or touches the window
    const method PenInRange(): bool;
    begin
      return Rwindow_is_pen_in_range(self.FId) <> 0;
    end;

    /// `true` while a touch, its inertia or a gesture goes on. C: Rwindow_is_touch_active
    /// @returns `true` while a touch, its inertia or a gesture goes on
    const method TouchActive(): bool;
    begin
      return Rwindow_is_touch_active(self.FId) <> 0;
    end;

    /// Moves the window's touch timing (long presses, inertia) on by `ASeconds` (tests). C:
    /// Rwindow_advance_touch
    /// @param ASeconds the time, in seconds
    /// @returns this object, so calls chain
    const method AdvanceTouch(const ASeconds: float64): self;
    begin
      Rwindow_advance_touch(self.FId, ASeconds);
      return self;
    end;

    /// The progress its taskbar button shows (`AValue` 0..1).
    /// @param AState the state
    /// @param AValue the value
    /// @returns `false` when the system shows none. C: Rwindow_set_taskbar_progress
    const method TaskbarProgress(const AState: UITaskbarProgress; const AValue: float32): bool;
    begin
      return Rwindow_set_taskbar_progress(self.FId, int32(AState), AValue) <> 0;
    end;

    /// Flashes its taskbar button (`ACritical`: until the user looks, else once).
    /// @param ACritical the critical
    /// @returns `false` when the system cannot. C: Rwindow_request_attention
    const method RequestAttention(const ACritical: bool): bool;
    begin
      return Rwindow_request_attention(self.FId, DoCBool(ACritical)) <> 0;
    end;

    // ---------------------------------------------------------------------------
    // Input made by the program (tests, automation)
    // ---------------------------------------------------------------------------

    /// The pointer moved to `AAt`. C: Rwindow_inject_mouse_move
    /// @param AAt the point
    /// @returns this object, so calls chain
    const method InjectMove(const AAt: UIPoint): self;
    begin
      Rwindow_inject_mouse_move(self.FId, AAt.x, AAt.y);
      return self;
    end;

    /// `AButton` pressed (`ADown`) or let go. C: Rwindow_inject_mouse_button
    /// @param AButton the button
    /// @param ADown `true` for pressed, `false` for let go
    /// @returns this object, so calls chain
    const method InjectButton(const AButton: UIPointerButton; const ADown: bool): self;
    begin
      Rwindow_inject_mouse_button(self.FId, int32(AButton), DoCBool(ADown));
      return self;
    end;

    /// The wheel turned by `ADelta` (x across, y up). C: Rwindow_inject_mouse_wheel
    /// @param ADelta the delta
    /// @returns this object, so calls chain
    const method InjectWheel(const ADelta: UIPoint): self;
    begin
      Rwindow_inject_mouse_wheel(self.FId, ADelta.x, ADelta.y);
      return self;
    end;

    /// `AKey` pressed (`ADown`) or let go with the modifiers `AMods`. C: Rwindow_inject_key
    /// @param AKey the key
    /// @param ADown `true` for pressed, `false` for let go
    /// @param AMods the modifier keys
    /// @returns this object, so calls chain
    const method InjectKey(const AKey: UIKey; const ADown: bool; const AMods: UIModifiers): self;
    begin
      Rwindow_inject_key(self.FId, int32(AKey), DoCBool(ADown), uint32(AMods));
      return self;
    end;

    /// `AText` typed (as a keyboard's text input). C: Rwindow_inject_text
    /// @param AText the text
    /// @returns this object, so calls chain
    const method InjectText(const AText: string): self;
    begin
      Rwindow_inject_text(self.FId, AText);
      return self;
    end;

    /// A drag from outside moved to `AAt` (`AInside` false: it left the window).
    /// @param AAt the point
    /// @param AInside the inside
    /// @returns `true` when something there takes it. C: Rwindow_inject_drag
    const method InjectDrag(const AAt: UIPoint; const AInside: bool): bool;
    begin
      return Rwindow_inject_drag(self.FId, AAt.x, AAt.y, DoCBool(AInside)) <> 0;
    end;

    /// Files `APaths` and the text `AText` dropped from outside at `AAt`.
    /// @param AAt the point
    /// @param APaths the paths
    /// @param AText the text
    /// @returns `true` when something there took the drop. C: Rwindow_inject_drop
    const method InjectDrop(const AAt: UIPoint; const APaths: StringArray; const AText: string): bool;
    var
      LPaths: CStringArray;
    begin
      LPaths := CStringArray(APaths);
      return Rwindow_inject_drop(self.FId, AAt.x, AAt.y, LPaths.Ptr, int32(len(APaths)), AText) <> 0;
    end;

    /// The system's back pressed.
    /// @returns `true` when the window handled it. C: Rwindow_inject_back
    const method InjectBack(): bool;
    begin
      return Rwindow_inject_back(self.FId) <> 0;
    end;

    /// The touch `ATouchId` at the stage `APhase` at `AAt`. C: Rwindow_inject_touch
    /// @param ATouchId the touch id
    /// @param APhase the phase
    /// @param AAt the point
    /// @returns this object, so calls chain
    const method InjectTouch(const ATouchId: int32; const APhase: UITouchPhase; const AAt: UIPoint): self;
    begin
      Rwindow_inject_touch(self.FId, ATouchId, int32(APhase), AAt.x, AAt.y);
      return self;
    end;

    /// A pen at the stage `APhase` at `AAt`: its pressure (0..1), tilt (degrees), buttons
    /// held and eraser end. C: Rwindow_inject_pen
    /// @param APhase the phase
    /// @param AAt the point
    /// @param APressure the pressure
    /// @param ATilt the tilt
    /// @param AButtons the buttons
    /// @param AEraser the eraser
    /// @returns this object, so calls chain
    const method InjectPen(const APhase: UIPenPhase; const AAt: UIPoint; const APressure: float32;
      const ATilt: UIPoint; const AButtons: UIPenButtons; const AEraser: bool): self;
    begin
      Rwindow_inject_pen(self.FId, int32(APhase), AAt.x, AAt.y, APressure, ATilt.x, ATilt.y,
        uint32(AButtons), DoCBool(AEraser));
      return self;
    end;

    /// A trackpad gesture `AKind` at the stage `APhase` at `AAt`: its scale and rotation
    /// changes, its pan and how many fingers. C: Rwindow_inject_trackpad_gesture
    /// @param AKind the kind
    /// @param APhase the phase
    /// @param AAt the point
    /// @param AScale the scale
    /// @param ARotation the rotation
    /// @param APan the pan movement
    /// @param AFingers the fingers
    /// @returns this object, so calls chain
    const method InjectGesture(const AKind: UIGestureKind; const APhase: UIGesturePhase;
      const AAt: UIPoint; const AScale: float32; const ARotation: float32; const APan: UIPoint;
      const AFingers: int32): self;
    begin
      Rwindow_inject_trackpad_gesture(self.FId, int32(AKind), int32(APhase), AAt.x, AAt.y,
        AScale, ARotation, APan.x, APan.y, AFingers);
      return self;
    end;

    /// A trackpad's two-finger scroll by `ADelta`. C: Rwindow_inject_trackpad_scroll
    /// @param ADelta the delta
    /// @returns this object, so calls chain
    const method InjectScroll(const ADelta: UIPoint): self;
    begin
      Rwindow_inject_trackpad_scroll(self.FId, ADelta.x, ADelta.y);
      return self;
    end;

    /// The trackpad's scroll ended (its fingers lifted). C: Rwindow_inject_trackpad_scroll_end
    /// @returns this object, so calls chain
    const method InjectScrollEnd(): self;
    begin
      Rwindow_inject_trackpad_scroll_end(self.FId);
      return self;
    end;

    /// The window's icon (title bar, task bar) from `APixels`; empty pixels (Width 0) go back
    /// to the default (on Windows the executable's first icon). Windows and X11; nothing
    /// for pixels holding fewer bytes than their size needs. C: Rwindow_set_icon
    /// @param APixels the pixels
    /// @returns this object, so calls chain
    const method Icon(const APixels: UIPixels): self;
    begin
      if (APixels.Width <= 0) or (APixels.Height <= 0) then
        Rwindow_set_icon(self.FId, nil, 0, 0);
        return self;
      end;
      if int64(len(APixels.RGBA)) < int64(APixels.Width) * int64(APixels.Height) * 4 then
        return self;
      end;
      Rwindow_set_icon(self.FId, addr of APixels.RGBA[0], APixels.Width, APixels.Height);
      return self;
    end;

    /// A picture behind the content, scaled to cover the window (what a glass theme's glass
    /// looks through; an empty handle removes it); kept while it is set.
    /// C: Rwindow_set_background
    /// @param ATexture the texture
    /// @returns this object, so calls chain
    const method Background(const ATexture: UITextureRes): self;
    begin
      Rwindow_set_background(self.FId, ATexture.Id());
      DoSweepWindows(self.FId);
      DoKeepTexture(self.FId, ADAM_RAVEN_KEEP_BACKGROUND, ATexture);
      return self;
    end;
  end;

  /// A window opened in a chain (`UIWindow.Config()`): each method sets one thing, `Open()`
  /// opens the window with them. Unset: an 800 x 600 window titled "", Raven's flags, place,
  /// theme and backdrop, no content.
  /// @example `LWindow := UIWindow.Config().Title("Notes").Size(800, 600).Content(LRoot).Open();`
  UIWindowConfig = object
    hidden FTitle: string;
    hidden FWidth: int32;
    hidden FHeight: int32;
    hidden FFlags: UIWindowFlags;
    hidden FMinWidth: int32;
    hidden FMinHeight: int32;
    hidden FX: int32;
    hidden FY: int32;
    hidden FCenter: bool;
    hidden FTheme: UIThemeKind;
    hidden FBackdrop: UIBackdrop;
    hidden FContent: UIWidget;
    // Which of the settings past the title, size and flags are set
    hidden FHasMinSize: bool;
    hidden FHasPosition: bool;
    hidden FHasTheme: bool;
    hidden FHasBackdrop: bool;

    /// The defaults (see the type).
    init();
    begin
      self.FTitle := "";
      self.FWidth := 800;
      self.FHeight := 600;
      self.FFlags := [];
      self.FMinWidth := 0;
      self.FMinHeight := 0;
      self.FX := 0;
      self.FY := 0;
      self.FCenter := false;
      self.FTheme := UIThemeKind.Dark;
      self.FBackdrop := UIBackdrop.None;
      self.FContent := UIWidget();
      self.FHasMinSize := false;
      self.FHasPosition := false;
      self.FHasTheme := false;
      self.FHasBackdrop := false;
    end;

    /// The title its title bar and the taskbar show.
    /// @param ATitle the title
    /// @returns this object, so calls chain
    method Title(const ATitle: string): self;
    begin
      self.FTitle := ATitle;
      return self;
    end;

    /// The client area's size in logical units.
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    method Size(const AWidth: int32; const AHeight: int32): self;
    begin
      self.FWidth := AWidth;
      self.FHeight := AHeight;
      return self;
    end;

    /// How it opens (hidden, borderless, maximized, a custom header bar ..).
    /// @param AFlags the flags
    /// @returns this object, so calls chain
    method Flags(const AFlags: UIWindowFlags): self;
    begin
      self.FFlags := AFlags;
      return self;
    end;

    /// The smallest size the user can make it.
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    method MinSize(const AWidth: int32; const AHeight: int32): self;
    begin
      self.FMinWidth := AWidth;
      self.FMinHeight := AHeight;
      self.FHasMinSize := true;
      return self;
    end;

    /// Its top-left corner on the screen (not centred).
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    /// @returns this object, so calls chain
    method Position(const AX: int32; const AY: int32): self;
    begin
      self.FX := AX;
      self.FY := AY;
      self.FHasPosition := true;
      self.FCenter := false;
      return self;
    end;

    /// Centred on its screen (no position).
    /// @returns this object, so calls chain
    method Center(): self;
    begin
      self.FCenter := true;
      self.FHasPosition := false;
      return self;
    end;

    /// One of Raven's built-in themes as its own.
    /// @param AKind the kind
    /// @returns this object, so calls chain
    method Theme(const AKind: UIThemeKind): self;
    begin
      self.FTheme := AKind;
      self.FHasTheme := true;
      return self;
    end;

    /// What shows through behind its content (a transparent window's).
    /// @param ABackdrop the backdrop
    /// @returns this object, so calls chain
    method Backdrop(const ABackdrop: UIBackdrop): self;
    begin
      self.FBackdrop := ABackdrop;
      self.FHasBackdrop := true;
      return self;
    end;

    /// `AWidget` as its content.
    /// @param AWidget the widget
    /// @returns this object, so calls chain
    method Content(const AWidget: UIWidget): self;
    begin
      self.FContent := AWidget;
      return self;
    end;

    /// Opens the window with the settings set (`IsValid()` false when Raven could not: the
    /// error reported to `UIErrors`). C: Rwindow_create
    /// @returns the window (`IsValid()` false when Raven could not open it)
    const method Open(): UIWindow;
    var
      LWindow: UIWindow;
    begin
      LWindow := UIWindow.Wrap(Rwindow_create(self.FTitle, self.FWidth, self.FHeight,
        uint32(self.FFlags)));
      if not LWindow.IsValid() then
        return LWindow;
      end;
      if self.FHasMinSize then
        LWindow.MinSize(self.FMinWidth, self.FMinHeight);
      end;
      if self.FHasPosition then
        LWindow.Position(self.FX, self.FY);
      end;
      if self.FCenter then
        LWindow.Center();
      end;
      if self.FHasTheme then
        LWindow.Theme(self.FTheme);
      end;
      if self.FHasBackdrop then
        LWindow.Backdrop(self.FBackdrop);
      end;
      if self.FContent.IsValid() then
        LWindow.Content(self.FContent);
      end;
      return LWindow;
    end;
  end;

  /// The app's touch and pen settings (each window may have its own: `UIWindow.TouchSettings`).
  UITouch = object
    /// The app's settings now. C: Rtouch_get_settings
    /// @returns the app's settings now
    static method Settings(): RTouchSettings;
    var
      LSettings: RTouchSettings;
    begin
      Rtouch_get_settings(addr of LSettings);
      return LSettings;
    end;

    /// `ASettings` as the app's. C: Rtouch_set_settings
    /// @param ASettings the settings
    static method Settings(const ASettings: RTouchSettings);
    begin
      Rtouch_set_settings(addr of ASettings);
    end;

    /// Raven's default settings. C: Rtouch_get_default_settings
    /// @returns raven's default settings
    static method Defaults(): RTouchSettings;
    var
      LSettings: RTouchSettings;
    begin
      Rtouch_get_default_settings(addr of LSettings);
      return LSettings;
    end;
  end;

  /// The app's own drag and drop: a drag started from a widget, carrying a type and data
  /// that the widget it is dropped on reads (`UIWidget.OnDrop`, `RDropEvent`).
  UIDrag = object
    /// Starts a drag from `ASource` (the pointer held on it) carrying the data `AData` of the
    /// type `AType` (the program's own name for it), showing `ALabel` by the pointer.
    /// @param ASource the source
    /// @param AType the type
    /// @param AData the data
    /// @param ALabel the label
    /// @returns `false` when a drag cannot start (one is on already). C: Rdrag_begin
    static method Begin(const ASource: UIWidget; const AType: string; const AData: string;
      const ALabel: string): bool;
    begin
      return Rdrag_begin(ASource.Id(), AType, AData, ALabel) <> 0;
    end;

    /// `true` while a drag of the app's own is on in `AWindow`. C: Rdrag_is_active
    /// @param AWindow the window
    /// @returns `true` while a drag of the app's own is on in `AWindow`
    static method Active(const AWindow: UIWindow): bool;
    begin
      return Rdrag_is_active(AWindow.Id()) <> 0;
    end;

    /// The type of the drag on in `AWindow` ("" when none). C: Rdrag_get_type
    /// @param AWindow the window
    /// @returns the type of the drag on in `AWindow` ("" when none)
    static method DataType(const AWindow: UIWindow): string;
    begin
      return DoRavenText(Rdrag_get_type(AWindow.Id()));
    end;

    /// The data of the drag on in `AWindow` ("" when none). C: Rdrag_get_data
    /// @param AWindow the window
    /// @returns the data of the drag on in `AWindow` ("" when none)
    static method Data(const AWindow: UIWindow): string;
    begin
      return DoRavenText(Rdrag_get_data(AWindow.Id()));
    end;

    /// The drag on in `AWindow` cancelled (nothing is dropped). C: Rdrag_cancel
    /// @param AWindow the window
    static method Cancel(const AWindow: UIWindow);
    begin
      Rdrag_cancel(AWindow.Id());
    end;

    /// Where the drop would land, highlighted while the drag is over it (from an `OnDrop`
    /// at its Enter / Move stage). C: Rdrop_set_highlight_rect
    /// @param ARect the rectangle
    static method Highlight(const ARect: UIRect);
    begin
      Rdrop_set_highlight_rect(ARect.x, ARect.y, ARect.w, ARect.h);
    end;
  end;

// A widget's window (its type is this part's, V3)
public extend UIWidget
  /// The window the widget is in (an empty handle when it is in none). C: Rwidget_get_window
  /// @returns the window the widget is in (an empty handle when it is in none)
  const method Window(): UIWindow;
  begin
    return UIWindow.Wrap(Rwidget_get_window(self.Id()));
  end;
end;

// The reads of Raven's event records that name a widget (listing sec 2)
public extend REvent
  /// The widget the event happened on.
  /// @returns the widget the event happened on
  const method Target(): UIWidget;
  begin
    return UIWidget.Wrap(self.target);
  end;
end;

public extend RDropEvent
  /// The widget a drag of the app's own started from (an empty handle for files or text
  /// from outside).
  /// @returns the widget a drag of the app's own started from (an empty handle for files or text
  ///   from outside)
  const method Source(): UIWidget;
  begin
    return UIWidget.Wrap(self.drag_source);
  end;
end;

public extend RTouchEvent
  /// The widget the touch is on.
  /// @returns the widget the touch is on
  const method Target(): UIWidget;
  begin
    return UIWidget.Wrap(self.target);
  end;
end;

public extend RPenEvent
  /// The widget the pen is on.
  /// @returns the widget the pen is on
  const method Target(): UIWidget;
  begin
    return UIWidget.Wrap(self.target);
  end;
end;

public extend RGestureEvent
  /// The widget the gesture is on.
  /// @returns the widget the gesture is on
  const method Target(): UIWidget;
  begin
    return UIWidget.Wrap(self.target);
  end;
end;

// The reads of Raven's event records that name a window (listing sec 2)
public extend REvent
  /// The window the event happened in.
  /// @returns the window the event happened in
  const method Window(): UIWindow;
  begin
    return UIWindow.Wrap(self.window);
  end;
end;

public extend RDropEvent
  /// The window the drag is over.
  /// @returns the window the drag is over
  const method Window(): UIWindow;
  begin
    return UIWindow.Wrap(self.window);
  end;
end;

public extend RTouchEvent
  /// The window the touch is in.
  /// @returns the window the touch is in
  const method Window(): UIWindow;
  begin
    return UIWindow.Wrap(self.window);
  end;
end;

public extend RPenEvent
  /// The window the pen is in.
  /// @returns the window the pen is in
  const method Window(): UIWindow;
  begin
    return UIWindow.Wrap(self.window);
  end;
end;

public extend RGestureEvent
  /// The window the gesture is in.
  /// @returns the window the gesture is in
  const method Window(): UIWindow;
  begin
    return UIWindow.Wrap(self.window);
  end;
end;

// ============================================================================
// Widget types (listing sec 6, V4): the layout containers and the controls.
// Each is `object(UIWidget)`, a handle like its base, with its own `Create`
// (a widget of its kind) and `Kinds` (the kinds it views, so Find<T> / As<T>
// check them); its members join UIWidget's of the same name as overloads
// (UILabel's Color(C) beside Color(Role, C): BNF sec 4, OV1). Their closures
// live in the GControl* tables, released with the widget (DoDropControls,
// from the destroy hook) or the app.
// ============================================================================

const
  // GControlTexts' second event: a text input's commit (its changes are event 0)
  ADAM_RAVEN_CONTROL_COMMIT: int32 = 1;

// The closures AWidget's controls held released (R_INVALID_ID: every one, the app ends)
func DoDropControls(const AWidget: Rid);
begin
  if AWidget = R_INVALID_ID then
    GControlTasks.DropAll();
    GControlToggles.DropAll();
    GControlIndexes.DropAll();
    GControlValues.DropAll();
    GControlValues64.DropAll();
    GControlTexts.DropAll();
    GControlDates.DropAll();
    GControlTimes.DropAll();
    GControlColors.DropAll();
    GTabCloses.DropAll();
    DoDropListControls(R_INVALID_ID);
    DoDropEditorControls(R_INVALID_ID);
    DoDropChartControls(R_INVALID_ID);
    DoDropToolControls(R_INVALID_ID);
    return;
  end;
  GControlTasks.DropOwner(AWidget);
  GControlToggles.DropOwner(AWidget);
  GControlIndexes.DropOwner(AWidget);
  GControlValues.DropOwner(AWidget);
  GControlValues64.DropOwner(AWidget);
  GControlTexts.DropOwner(AWidget);
  GControlDates.DropOwner(AWidget);
  GControlTimes.DropOwner(AWidget);
  GControlColors.DropOwner(AWidget);
  GTabCloses.DropOwner(AWidget);
  DoDropListControls(AWidget);
  DoDropEditorControls(AWidget);
  DoDropChartControls(AWidget);
  DoDropToolControls(AWidget);
end;

// The control trampolines: each runs its closure on a copy (one replaced while it runs
// finishes); a closure the table no longer holds (its widget gone) is never reached
func clink DoOnControlTask(widget: Rid; user_data: ptr);
var
  LFunc: UITaskFunc;
begin
  if not GControlTasks.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc();
end;

func clink DoOnControlToggle(widget: Rid; checked: int32; user_data: ptr);
var
  LFunc: UIToggleFunc;
begin
  if not GControlToggles.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(checked <> 0);
end;

func clink DoOnControlIndex(widget: Rid; index: int32; user_data: ptr);
var
  LFunc: UIIndexFunc;
begin
  if not GControlIndexes.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(index);
end;

func clink DoOnControlValue(widget: Rid; value: float32; user_data: ptr);
var
  LFunc: UIValueFunc;
begin
  if not GControlValues.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(value);
end;

func clink DoOnControlValue64(widget: Rid; value: float64; user_data: ptr);
var
  LFunc: UIValue64Func;
begin
  if not GControlValues64.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(value);
end;

func clink DoOnControlText(widget: Rid; text: ptr to const char; user_data: ptr);
var
  LFunc: UITextFunc;
begin
  if not GControlTexts.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(DoRavenText(text));
end;

func clink DoOnControlDate(widget: Rid; year: int32; month: int32; day: int32; user_data: ptr);
var
  LFunc: UIDateFunc;
begin
  if not GControlDates.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(year, month, day);
end;

func clink DoOnControlTime(widget: Rid; hour: int32; minute: int32; second: int32; user_data: ptr);
var
  LFunc: UITimeFunc;
begin
  if not GControlTimes.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(hour, minute, second);
end;

func clink DoOnControlColor(widget: Rid; r: float32; g: float32; b: float32; a: float32; user_data: ptr);
var
  LFunc: UIColorFunc;
begin
  if not GControlColors.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIColor(r: r, g: g, b: b, a: a));
end;

// A tab's close button: answers as Raven does with no callback (delete the page) when no
// closure is held
func clink DoOnTabClose(tab_view: Rid; index: int32; content: Rid; user_data: ptr): int32;
var
  LFunc: UITabCloseFunc;
begin
  if not GTabCloses.Find(user_data, LFunc) or (LFunc = nil) then
    return R_TRUE;
  end;
  return DoCBool(LFunc(UITab.Wrap(tab_view, content)));
end;

// The text of AItems joined by '|' (Raven's breadcrumb item list)
func DoBarList(const AItems: array of string): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  for LI := 0 to len(AItems) - 1 do
    if LI > 0 then
      LText := LText + "|";
    end;
    LText := LText + AItems[LI];
  end;
  return LText;
end;

public type
  /// A box laying its children out in a line: the base of UIVBox and UIHBox. C: Rpanel_*
  UIPanel = object(UIWidget)
    /// The kinds a panel views: VBox and HBox.
    /// @returns the kinds a panel views: VBox and HBox
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.VBox, UIWidgetKind.HBox];
    end;

    /// The gap between two children, in window units. C: Rpanel_set_spacing
    /// @param ASpacing the spacing
    /// @returns this object, so calls chain
    const method Spacing(const ASpacing: float32): self;
    begin
      Rpanel_set_spacing(self.FId, ASpacing);
      return self;
    end;

    /// What `Spacing(..)` sets, read back. C: Rpanel_get_spacing
    /// @returns the gap between two children, in window units
    const method Spacing(): float32;
    begin
      return Rpanel_get_spacing(self.FId);
    end;
  end;

  /// A box laying its children out top to bottom.
  /// @example `LBox := UIVBox.Create().Spacing(8.0f).Add(UILabel.Create("Hi"));`
  UIVBox = object(UIPanel)
    /// A new, empty vertical box. C: Rwidget_create(R_WIDGET_VBOX)
    /// @returns a new, empty vertical box
    static method Create(): UIVBox;
    var
      LWidget: UIVBox;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.VBox)));
      return LWidget;
    end;

    /// The kind a vertical box views.
    /// @returns the kind a vertical box views
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.VBox];
    end;
  end;

  /// A box laying its children out left to right (right to left in an RTL direction).
  UIHBox = object(UIPanel)
    /// A new, empty horizontal box. C: Rwidget_create(R_WIDGET_HBOX)
    /// @returns a new, empty horizontal box
    static method Create(): UIHBox;
    var
      LWidget: UIHBox;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.HBox)));
      return LWidget;
    end;

    /// The kind a horizontal box views.
    /// @returns the kind a horizontal box views
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.HBox];
    end;
  end;

  /// A grid: each child in the cell its layout names (`UILayout.Cell`, `Span`), the columns'
  /// and rows' shares of the room set by fill coefficients. C: Rgrid_*
  UIGrid = object(UIWidget)
    /// A new, empty grid. C: Rwidget_create(R_WIDGET_GRID)
    /// @returns a new, empty grid
    static method Create(): UIGrid;
    var
      LWidget: UIGrid;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Grid)));
      return LWidget;
    end;

    /// The kind a grid views.
    /// @returns the kind a grid views
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Grid];
    end;

    /// The share of the spare width column `AColumn` takes (0: as wide as its content).
    /// C: Rgrid_set_column_fill
    /// @param AColumn the column, from 0
    /// @param AFill the share of the room it takes
    /// @returns this object, so calls chain
    const method ColumnFill(const AColumn: int32; const AFill: float32): self;
    begin
      Rgrid_set_column_fill(self.FId, AColumn, AFill);
      return self;
    end;

    /// The share of the spare height row `ARow` takes (0: as tall as its content).
    /// C: Rgrid_set_row_fill
    /// @param ARow the row, from 0
    /// @param AFill the share of the room it takes
    /// @returns this object, so calls chain
    const method RowFill(const ARow: int32; const AFill: float32): self;
    begin
      Rgrid_set_row_fill(self.FId, ARow, AFill);
      return self;
    end;
  end;

  /// A grid of equal cells filled in order, `Columns` to a row. C: Runiform_grid_*
  UIUniformGrid = object(UIWidget)
    /// A new, empty uniform grid. C: Rwidget_create(R_WIDGET_UNIFORM_GRID)
    /// @returns a new, empty uniform grid
    static method Create(): UIUniformGrid;
    var
      LWidget: UIUniformGrid;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.UniformGrid)));
      return LWidget;
    end;

    /// The kind a uniform grid views.
    /// @returns the kind a uniform grid views
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.UniformGrid];
    end;

    /// The cells to a row (0: as many as fit `MinCellSize`). C: Runiform_grid_set_columns
    /// @param AColumns the columns
    /// @returns this object, so calls chain
    const method Columns(const AColumns: int32): self;
    begin
      Runiform_grid_set_columns(self.FId, AColumns);
      return self;
    end;

    /// The smallest a cell is. C: Runiform_grid_set_min_cell_size
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    const method MinCellSize(const AWidth: float32; const AHeight: float32): self;
    begin
      Runiform_grid_set_min_cell_size(self.FId, AWidth, AHeight);
      return self;
    end;
  end;

  /// Children stacked on one another, each filling the box (or placed by its layout's
  /// alignment), the last on top.
  UIOverlay = object(UIWidget)
    /// A new, empty overlay. C: Rwidget_create(R_WIDGET_OVERLAY)
    /// @returns a new, empty overlay
    static method Create(): UIOverlay;
    var
      LWidget: UIOverlay;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Overlay)));
      return LWidget;
    end;

    /// The kind an overlay views.
    /// @returns the kind an overlay views
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Overlay];
    end;
  end;

  /// A frame around one child: padding, a background, an outline, rounded corners and a
  /// shadow. C: Rborder_*
  UIBorder = object(UIWidget)
    /// A new, empty border. C: Rwidget_create(R_WIDGET_BORDER)
    /// @returns a new, empty border
    static method Create(): UIBorder;
    var
      LWidget: UIBorder;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Border)));
      return LWidget;
    end;

    /// The kind a border views.
    /// @returns the kind a border views
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Border];
    end;

    /// The room between the frame and its child, side by side. C: Rborder_set_padding
    /// @param ALeft the room on the left
    /// @param ATop the room above
    /// @param ARight the room on the right
    /// @param ABottom the room below
    /// @returns this object, so calls chain
    const method Padding(const ALeft: float32; const ATop: float32; const ARight: float32;
      const ABottom: float32): self;
    begin
      Rborder_set_padding(self.FId, ALeft, ATop, ARight, ABottom);
      return self;
    end;

    /// The same room `AAll` on every side. C: Rborder_set_padding
    /// @param AAll the room on every side
    /// @returns this object, so calls chain
    const method Padding(const AAll: float32): self;
    begin
      Rborder_set_padding(self.FId, AAll, AAll, AAll, AAll);
      return self;
    end;

    /// The colour the frame is filled with. C: Rborder_set_background
    /// @param AColor the colour
    /// @returns this object, so calls chain
    const method Background(const AColor: UIColor): self;
    begin
      Rborder_set_background(self.FId, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// An outline `AWidth` wide in `AColor` (0 wide: none). C: Rborder_set_outline
    /// @param AWidth the width
    /// @param AColor the colour
    /// @returns this object, so calls chain
    const method Outline(const AWidth: float32; const AColor: UIColor): self;
    begin
      Rborder_set_outline(self.FId, AWidth, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// Every corner rounded by `ARadius`. C: Rborder_set_corner_radius
    /// @param ARadius the radius
    /// @returns this object, so calls chain
    const method CornerRadius(const ARadius: float32): self;
    begin
      Rborder_set_corner_radius(self.FId, ARadius, ARadius, ARadius, ARadius);
      return self;
    end;

    /// Each corner rounded by its own radius. C: Rborder_set_corner_radius
    /// @param ATopLeft the top-left corner's radius
    /// @param ATopRight the top-right corner's radius
    /// @param ABottomRight the bottom-right corner's radius
    /// @param ABottomLeft the bottom-left corner's radius
    /// @returns this object, so calls chain
    const method CornerRadius(const ATopLeft: float32; const ATopRight: float32;
      const ABottomRight: float32; const ABottomLeft: float32): self;
    begin
      Rborder_set_corner_radius(self.FId, ATopLeft, ATopRight, ABottomRight, ABottomLeft);
      return self;
    end;

    /// A drop shadow blurred by `ABlur`, moved by `AOffset` (0 blur: none). C: Rborder_set_shadow
    /// @param ABlur the blur radius
    /// @param AOffset the offset
    /// @returns this object, so calls chain
    const method Shadow(const ABlur: float32; const AOffset: UIPoint): self;
    begin
      Rborder_set_shadow(self.FId, ABlur, AOffset.x, AOffset.y);
      return self;
    end;

    /// What the frame's own panel is drawn as (solid, glass ..). C: Rborder_set_material
    /// @param AMaterial the material
    /// @returns this object, so calls chain
    const method Material(const AMaterial: UIMaterial): self;
    begin
      Rborder_set_material(self.FId, int32(AMaterial));
      return self;
    end;

    /// `AShader` drawn as the border's background (under its child), with the look `ALook`
    /// (colours, parameters, radius, animation; an empty handle removes it); kept while it
    /// is set. C: Rborder_set_effect
    /// @param AShader the shader
    /// @param ALook the look
    /// @returns this object, so calls chain
    const method Effect(const AShader: UIShaderRes; const ALook: RShaderLook): self;
    begin
      Rborder_set_effect(self.FId, AShader.Id(), addr of ALook);
      DoHookDestroy(self.FId);
      DoKeepShader(self.FId, ADAM_RAVEN_KEEP_EFFECT, AShader);
      return self;
    end;

    /// `AShader` drawn as the border's background with its own default look
    /// (`AShader.Defaults()`). C: Rborder_set_effect
    /// @param AShader the shader
    /// @returns this object, so calls chain
    const method Effect(const AShader: UIShaderRes): self;
    begin
      self.Effect(AShader, AShader.Defaults());
      return self;
    end;

    /// The effect drawn, borrowed (empty for none). C: Rborder_get_effect
    /// @returns the effect drawn, borrowed (empty for none)
    const method Effect(): UIShaderRes;
    begin
      return UIShaderRes.View(Rborder_get_effect(self.FId));
    end;
  end;

  /// A box keeping its child at one width-to-height ratio. C: Rsize_box_*
  UISizeBox = object(UIWidget)
    /// A new, empty size box. C: Rwidget_create(R_WIDGET_SIZE_BOX)
