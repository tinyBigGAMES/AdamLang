      LWidget: UITimePicker;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.TimePicker)));
      return LWidget;
    end;

    /// The kind a time picker views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.TimePicker];
    end;

    /// Sets the time (`AHour` 0 .. 23). C: Rtime_picker_set_time
    const method Time(const AHour: int32; const AMinute: int32; const ASecond: int32): self;
    begin
      Rtime_picker_set_time(self.FId, AHour, AMinute, ASecond);
      return self;
    end;

    /// The time chosen. C: Rtime_picker_get_time
    const method Time(): UITime;
    var
      LTime: UITime;
    begin
      Rtime_picker_get_time(self.FId, addr of LTime.Hour, addr of LTime.Minute, addr of LTime.Second);
      return LTime;
    end;

    /// The seconds shown (and chosen) when `AOn`. C: Rtime_picker_set_seconds_visible
    const method SecondsVisible(const AOn: bool): self;
    begin
      Rtime_picker_set_seconds_visible(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The minutes move in steps of `AStep`. C: Rtime_picker_set_minute_step
    const method MinuteStep(const AStep: int32): self;
    begin
      Rtime_picker_set_minute_step(self.FId, AStep);
      return self;
    end;

    /// Runs `AFunc` with the time when it is changed. C: Rtime_picker_set_changed_callback
    const method OnChanged(const AFunc: UITimeFunc): self;
    begin
      if AFunc = nil then
        GControlTimes.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtime_picker_set_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtime_picker_set_changed_callback(self.FId, DoOnControlTime,
        GControlTimes.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// A colour chooser: a hue / saturation / value field, opacity, hex text and swatches.
  /// C: Rcolor_picker_*
  UIColorPicker = object(UIWidget)
    /// A new colour picker. C: Rcolor_picker_create
    static method Create(): UIColorPicker;
    var
      LWidget: UIColorPicker;
    begin
      LWidget.DoSet(Rcolor_picker_create());
      return LWidget;
    end;

    /// The kind a colour picker views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.ColorPicker];
    end;

    /// Sets the colour chosen. C: Rcolor_picker_set_color
    const method Color(const AColor: UIColor): self;
    begin
      Rcolor_picker_set_color(self.FId, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// The colour chosen. C: Rcolor_picker_get_color
    const method Color(): UIColor;
    var
      LColor: UIColor;
    begin
      Rcolor_picker_get_color(self.FId, addr of LColor.r, addr of LColor.g, addr of LColor.b,
        addr of LColor.a);
      return LColor;
    end;

    /// Sets the colour by hue (0 .. 360), saturation and value (0 .. 1), opacity kept.
    /// C: Rcolor_picker_set_hsv
    const method HSV(const AH: float32; const AS: float32; const AV: float32): self;
    begin
      Rcolor_picker_set_hsv(self.FId, AH, AS, AV);
      return self;
    end;

    /// The colour as hue, saturation and value (the hue kept for a grey). C: Rcolor_picker_get_hsv
    const method HSV(): UIHSV;
    var
      LHSV: UIHSV;
    begin
      Rcolor_picker_get_hsv(self.FId, addr of LHSV.h, addr of LHSV.s, addr of LHSV.v);
      return LHSV;
    end;

    /// Sets the colour from hex text ("#RRGGBB", "#RRGGBBAA"; one without opacity keeps it).
    /// @returns `false` when the text is no colour (the colour unchanged). C: Rcolor_picker_set_hex
    const method Hex(const AHex: string): bool;
    begin
      return Rcolor_picker_set_hex(self.FId, AHex) <> 0;
    end;

    /// The colour as "#RRGGBB" ("#RRGGBBAA" when opacity is shown and not full).
    /// C: Rcolor_picker_get_hex
    const method Hex(): string;
    begin
      return DoRavenText(Rcolor_picker_get_hex(self.FId));
    end;

    /// The opacity shown and chosen when `AOn`. C: Rcolor_picker_set_alpha_enabled
    const method AlphaEnabled(const AOn: bool): self;
    begin
      Rcolor_picker_set_alpha_enabled(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The colour shown beside the new one (the one being replaced). C: Rcolor_picker_set_previous_color
    const method PreviousColor(const AColor: UIColor): self;
    begin
      Rcolor_picker_set_previous_color(self.FId, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// `AColor` as the last swatch. C: Rcolor_picker_add_swatch
    const method AddSwatch(const AColor: UIColor): self;
    begin
      Rcolor_picker_add_swatch(self.FId, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// Every swatch removed. C: Rcolor_picker_clear_swatches
    const method ClearSwatches(): self;
    begin
      Rcolor_picker_clear_swatches(self.FId);
      return self;
    end;

    /// The swatches it holds. C: Rcolor_picker_get_swatch_count
    const method SwatchCount(): int32;
    begin
      return Rcolor_picker_get_swatch_count(self.FId);
    end;

    /// A button opening the picker in a popup when `AOn` (else the picker itself).
    /// C: Rcolor_picker_set_popup
    const method Popup(const AOn: bool): self;
    begin
      Rcolor_picker_set_popup(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The small form (no hex field, no swatches) when `AOn`. C: Rcolor_picker_set_compact
    const method Compact(const AOn: bool): self;
    begin
      Rcolor_picker_set_compact(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Runs `AFunc` with the colour as it is changed. C: Rcolor_picker_set_changed_callback
    const method OnChanged(const AFunc: UIColorFunc): self;
    begin
      if AFunc = nil then
        GControlColors.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rcolor_picker_set_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rcolor_picker_set_changed_callback(self.FId, DoOnControlColor,
        GControlColors.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// Short messages popping up over the content, then fading (info, success, warning,
  /// error), optionally with an action button ("Undo"). Its last text is the base's `Text()`.
  /// C: Rtoast_*
  /// @example `LToast.ActionText("Undo").OnAction(func() begin Undo(); end).Show("Deleted", 3.0);`
  UIToast = object(UIWidget)
    /// A new toast showing nothing. C: Rwidget_create(R_WIDGET_TOAST)
    static method Create(): UIToast;
    var
      LWidget: UIToast;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Toast)));
      return LWidget;
    end;

    /// The kind a toast views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Toast];
    end;

    /// Shows `AText` for `ASeconds`, of the kind `Kind` set last. C: Rtoast_show
    const method Show(const AText: string; const ASeconds: float64): self;
    begin
      Rtoast_show(self.FId, AText, ASeconds);
      return self;
    end;

    /// Shows `AText` of the kind `AKind` for `ASeconds`. C: Rtoast_show_kind
    const method Show(const AText: string; const AKind: UIToastKind; const ASeconds: float64): self;
    begin
      Rtoast_show_kind(self.FId, AText, int32(AKind), ASeconds);
      return self;
    end;

    /// Hides the message shown (the next queued one shows). C: Rtoast_hide
    const method Hide(): self;
    begin
      Rtoast_hide(self.FId);
      return self;
    end;

    /// Hides the message shown and drops the queued ones. C: Rtoast_clear
    const method Clear(): self;
    begin
      Rtoast_clear(self.FId);
      return self;
    end;

    /// `true` while a message is shown. C: Rtoast_is_shown
    const method Shown(): bool;
    begin
      return Rtoast_is_shown(self.FId) <> 0;
    end;

    /// The messages shown and queued. C: Rtoast_get_count
    const method Count(): int32;
    begin
      return Rtoast_get_count(self.FId);
    end;

    /// What a new message does to the ones shown (replace, queue after, stack).
    /// C: Rtoast_set_queue
    const method Queue(const AQueue: UIToastQueue): self;
    begin
      Rtoast_set_queue(self.FId, int32(AQueue));
      return self;
    end;

    /// C: Rtoast_get_queue
    const method Queue(): UIToastQueue;
    begin
      return UIToastQueue(Rtoast_get_queue(self.FId));
    end;

    /// The most messages stacked at once. C: Rtoast_set_max_visible
    const method MaxVisible(const ACount: int32): self;
    begin
      Rtoast_set_max_visible(self.FId, ACount);
      return self;
    end;

    /// The kind of the next messages (and of the one shown, when replacing): beside the
    /// base's `Kind()`, the widget's kind. C: Rtoast_set_kind
    const method Kind(const AKind: UIToastKind): self;
    begin
      Rtoast_set_kind(self.FId, int32(AKind));
      return self;
    end;

    /// A button at the end of the next messages ("" removes it). C: Rtoast_set_action_text
    const method ActionText(const AText: string): self;
    begin
      Rtoast_set_action_text(self.FId, AText);
      return self;
    end;

    /// Runs `AFunc` when a message's action button is pressed (the message then hides).
    /// C: Rtoast_set_action_callback
    const method OnAction(const AFunc: UITaskFunc): self;
    begin
      if AFunc = nil then
        GControlTasks.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtoast_set_action_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtoast_set_action_callback(self.FId, DoOnControlTask,
        GControlTasks.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

// ============================================================================
// Lists, trees, tables, tiles and menus (listing sec 6, V5). UIListView,
// UITreeView, UITable and UITileView are widget types as V4's; a tree's item,
// a table's column and row and a tile view's section are value handles of
// (the widget, the item or index), as UITab. A tile and a section header are
// described in Adam values (UITile, UITileHeader), never in Raven's structs:
// the texts a callback hands Raven are held (GHeldTexts) until its next call
// on the same key, since Raven reads a virtual list's / table's text and a
// tile's after the callback returns. Menus (UIMenuBar, UIMenu, UIMenuItem)
// are widgets; a menu with no parent opens anywhere (UIMenu.Open,
// UIWidget.ContextMenu). Their icons are textures (UITextureRes).
// ============================================================================

public type
  /// One item of a `UITreeView`: a handle (Raven's Rid of the item), copied freely; it names
  /// no item once Raven deleted it (with its tree, an ancestor or `Destroy`). C: Rtree_item_*
  UITreeItem = object
    hidden FItem: Rid;

    /// An empty item handle (names none).
    init();
    begin
      self.FItem := R_INVALID_ID;
    end;

    /// The handle of the tree item System.Raven.C gave as `AItem`.
    static method Wrap(const AItem: Rid): UITreeItem;
    var
      LItem: UITreeItem;
    begin
      LItem.FItem := AItem;
      return LItem;
    end;

    /// The item's Rid, for System.Raven.C's calls.
    const method Id(): Rid;
    begin
      return self.FItem;
    end;

    /// `true` while the handle names an item of a tree. C: Rtree_item_is_valid
    const method IsValid(): bool;
    begin
      return Rtree_item_is_valid(self.FItem) <> 0;
    end;

    /// Deletes the item and its descendants, their icons let go. C: Rtree_item_destroy
    const method Destroy();
    var
      LTree: Rid;
    begin
      LTree := DoTreeOfItem(self.FItem);
      Rtree_item_destroy(self.FItem);
      if LTree <> R_INVALID_ID then
        DoSweepTreeItems(LTree, false);
      else
        DoSweepLooseIcons();
      end;
    end;

    /// The item's text. C: Rtree_item_set_text
    const method Text(const AText: string): self;
    begin
      Rtree_item_set_text(self.FItem, AText);
      return self;
    end;

    /// C: Rtree_item_get_text
    const method Text(): string;
    begin
      return DoRavenText(Rtree_item_get_text(self.FItem));
    end;

    /// Shows (`true`) or hides its children. C: Rtree_item_set_expanded
    const method Expanded(const AOn: bool): self;
    begin
      Rtree_item_set_expanded(self.FItem, DoCBool(AOn));
      return self;
    end;

    /// C: Rtree_item_is_expanded
    const method Expanded(): bool;
    begin
      return Rtree_item_is_expanded(self.FItem) <> 0;
    end;

    /// A pointer the program keeps with the item (Raven never reads it).
    /// C: Rtree_item_set_user_handle
    const method UserHandle(const AHandle: ptr): self;
    begin
      Rtree_item_set_user_handle(self.FItem, AHandle);
      return self;
    end;

    /// C: Rtree_item_get_user_handle
    const method UserHandle(): ptr;
    begin
      return Rtree_item_get_user_handle(self.FItem);
    end;

    /// The item it sits under (names none for a top-level item). C: Rtree_item_get_parent
    const method Parent(): UITreeItem;
    begin
      return UITreeItem.Wrap(Rtree_item_get_parent(self.FItem));
    end;

    /// Its children. C: Rtree_item_get_child_count
    const method ChildCount(): int32;
    begin
      return Rtree_item_get_child_count(self.FItem);
    end;

    /// Its child at `AIndex` (names none outside). C: Rtree_item_get_child
    const method Child(const AIndex: int32): UITreeItem;
    begin
      return UITreeItem.Wrap(Rtree_item_get_child(self.FItem, AIndex));
    end;

    /// The colour of its text (alpha 0: the theme's). C: Rtree_item_set_text_color
    const method TextColor(const AColor: UIColor): self;
    begin
      Rtree_item_set_text_color(self.FItem, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// Adds it to (`true`) or takes it from its tree's selection. C: Rtree_item_set_selected
    const method Selected(const AOn: bool): self;
    begin
      Rtree_item_set_selected(self.FItem, DoCBool(AOn));
      return self;
    end;

    /// C: Rtree_item_is_selected
    const method Selected(): bool;
    begin
      return Rtree_item_is_selected(self.FItem) <> 0;
    end;

    /// The whole of `ATexture` as the icon before the item's text (an empty handle removes
    /// it); kept while the item shows it, let go with the item, its tree or the tree's
    /// `ClearItems`. C: Rtree_item_set_icon
    const method Icon(const ATexture: UITextureRes): self;
    begin
      self.Icon(ATexture, UIPoint(x: 0.0f, y: 0.0f), UIPoint(x: 1.0f, y: 1.0f));
      return self;
    end;

    /// A part of `ATexture` as the icon before the item's text, kept as the whole one is.
    /// `AUVMin` .. `AUVMax`: the part of the texture shown, as texture coordinates (0 .. 1)
    /// of its corners. C: Rtree_item_set_icon
    const method Icon(const ATexture: UITextureRes; const AUVMin: UIPoint;
      const AUVMax: UIPoint): self;
    var
      LTree: Rid;
    begin
      Rtree_item_set_icon(self.FItem, ATexture.Id(), AUVMin.x, AUVMin.y, AUVMax.x, AUVMax.y);
      LTree := DoTreeOfItem(self.FItem);
      if ATexture.Id() = R_INVALID_ID then
        GKeptItemIcons.Remove(LTree, uint32(self.FItem));
      else
        GKeptItemIcons.Put(LTree, uint32(self.FItem), ATexture);
      end;
      return self;
    end;
  end;

  /// One column of a `UITable`: a view of (the table, the column's index), copied freely.
  /// C: Rtable_*_column_*
  UITableColumn = object
    hidden FTable: Rid;
    hidden FColumn: int32;

    /// An empty column handle (names none).
    init();
    begin
      self.FTable := R_INVALID_ID;
      self.FColumn := -1;
    end;

    /// The column `AColumn` of the table `ATable` (a Rid).
    static method Wrap(const ATable: Rid; const AColumn: int32): UITableColumn;
    var
      LColumn: UITableColumn;
    begin
      LColumn.FTable := ATable;
      LColumn.FColumn := AColumn;
      return LColumn;
    end;

    /// The column's index (-1 when it names none).
    const method Index(): int32;
    begin
      return self.FColumn;
    end;

    /// `true` while the index is one of its table's columns. C: Rtable_get_column_count
    const method IsValid(): bool;
    begin
      return (self.FColumn >= 0) and (self.FColumn < Rtable_get_column_count(self.FTable));
    end;

    /// The column's header text. C: Rtable_set_column_header
    const method Header(const AHeader: string): self;
    begin
      Rtable_set_column_header(self.FTable, self.FColumn, AHeader);
      return self;
    end;

    /// C: Rtable_get_column_header
    const method Header(): string;
    begin
      return DoRavenText(Rtable_get_column_header(self.FTable, self.FColumn));
    end;

    /// Its width in logical units. C: Rtable_set_column_width
    const method Width(const AWidth: float32): self;
    begin
      Rtable_set_column_width(self.FTable, self.FColumn, AWidth);
      return self;
    end;

    /// The width it has on screen (a filling column takes more). C: Rtable_get_column_width
    const method Width(): float32;
    begin
      return Rtable_get_column_width(self.FTable, self.FColumn);
    end;

    /// Above 0: the share of the room the other columns leave that it takes; 0: its width
    /// only. C: Rtable_set_column_fill
    const method Fill(const AFill: float32): self;
    begin
      Rtable_set_column_fill(self.FTable, self.FColumn, AFill);
      return self;
    end;

    /// `false`: a click on its header does not sort (on by default).
    /// C: Rtable_set_column_sortable
    const method Sortable(const AOn: bool): self;
    begin
      Rtable_set_column_sortable(self.FTable, self.FColumn, DoCBool(AOn));
      return self;
    end;

    /// Where its texts sit in their cells. C: Rtable_set_column_align
    const method Align(const AAlign: UITextAlign): self;
    var
      LAlign: float32;
    begin
      LAlign := 0.0f;
      if AAlign = UITextAlign.Center then
        LAlign := 0.5f;
      end;
      if AAlign = UITextAlign.Right then
        LAlign := 1.0f;
      end;
      Rtable_set_column_align(self.FTable, self.FColumn, LAlign);
      return self;
    end;
  end;

  /// One row of a `UITable`: a view of (the table, the row's index in the order shown),
  /// copied freely; a sort or a removal before it moves the row the index names.
  /// C: Rtable_*_row_* / Rtable_*_cell*
  UITableRow = object
    hidden FTable: Rid;
    hidden FRow: int32;

    /// An empty row handle (names none).
    init();
    begin
      self.FTable := R_INVALID_ID;
      self.FRow := -1;
    end;

    /// The row `ARow` of the table `ATable` (a Rid).
    static method Wrap(const ATable: Rid; const ARow: int32): UITableRow;
    var
      LRow: UITableRow;
    begin
      LRow.FTable := ATable;
      LRow.FRow := ARow;
      return LRow;
    end;

    /// The row's index (-1 when it names none).
    const method Index(): int32;
    begin
      return self.FRow;
    end;

    /// `true` while the index is one of its table's rows. C: Rtable_get_row_count
    const method IsValid(): bool;
    begin
      return (self.FRow >= 0) and (self.FRow < Rtable_get_row_count(self.FTable));
    end;

    /// Adds it to (`true`) or takes it from the selection. C: Rtable_set_row_selected
    const method Selected(const AOn: bool): self;
    begin
      Rtable_set_row_selected(self.FTable, self.FRow, DoCBool(AOn));
      return self;
    end;

    /// C: Rtable_is_row_selected
    const method Selected(): bool;
    begin
      return Rtable_is_row_selected(self.FTable, self.FRow) <> 0;
    end;

    /// The text of its cell in the column `AColumn` (a '|' in it stays). C: Rtable_set_cell
    const method Cell(const AColumn: int32; const AText: string): self;
    begin
      Rtable_set_cell(self.FTable, self.FRow, AColumn, AText);
      return self;
    end;

    /// C: Rtable_get_cell
    const method Cell(const AColumn: int32): string;
    begin
      return DoRavenText(Rtable_get_cell(self.FTable, self.FRow, AColumn));
    end;

    /// The colour of the row's texts (a cell's own colour wins; alpha 0: the inherited one).
    /// C: Rtable_set_cell_text_color (column -1)
    const method TextColor(const AColor: UIColor): self;
    begin
      Rtable_set_cell_text_color(self.FTable, self.FRow, -1, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// Removes the row from its table (the rows after it move up). C: Rtable_remove_row
    const method Remove();
    begin
      Rtable_remove_row(self.FTable, self.FRow);
    end;
  end;

  /// One section of a `UITileView`: a view of (the tile view, the section's index), copied
  /// freely. C: Rtile_view_*_section*
  UITileSection = object
    hidden FView: Rid;
    hidden FSection: int32;

    /// An empty section handle (names none).
    init();
    begin
      self.FView := R_INVALID_ID;
      self.FSection := -1;
    end;

    /// The section `ASection` of the tile view `AView` (a Rid).
    static method Wrap(const AView: Rid; const ASection: int32): UITileSection;
    var
      LSection: UITileSection;
    begin
      LSection.FView := AView;
      LSection.FSection := ASection;
      return LSection;
    end;

    /// The section's index (-1 when it names none: a tile before the first section).
    const method Index(): int32;
    begin
      return self.FSection;
    end;

    /// `true` while the index is one of its tile view's sections.
    /// C: Rtile_view_get_section_count
    const method IsValid(): bool;
    begin
      return (self.FSection >= 0) and (self.FSection < Rtile_view_get_section_count(self.FView));
    end;

    /// Folds (`true`: its tiles neither drawn nor hit) or unfolds the section; the toggled
    /// closure is not run. C: Rtile_view_set_section_folded
    const method Folded(const AOn: bool): self;
    begin
      Rtile_view_set_section_folded(self.FView, self.FSection, DoCBool(AOn));
      return self;
    end;

    /// C: Rtile_view_is_section_folded
    const method Folded(): bool;
    begin
      return Rtile_view_is_section_folded(self.FView, self.FSection) <> 0;
    end;
  end;

  /// What a tile of a `UITileView` shows, filled by `UITileView.Items`' closure when the tile
  /// is drawn: its texts ("" for none), icon and colours (alpha 0: the theme's), starting
  /// from Raven's defaults (no icon, its whole texture, tint white).
  UITile = object
    /// The picture (an empty handle: none), kept until the tile is described again.
    Icon: UITextureRes;
    /// The part of `Icon` shown: texture coordinates (0 .. 1) of its corners.
    IconUVMin: UIPoint;
    IconUVMax: UIPoint;
    /// The name under the icon.
    Text: string;
    /// A second, dimmer line.
    Detail: string;
    /// A small text at the tile's top right.
    Badge: string;
    /// Rows layout: a third line under the detail.
    Note: string;
    /// The colour the icon is tinted with.
    Tint: UIColor;
    /// The radius of the icon's corners.
    IconRadius: float32;
    /// The colour of the name.
    TextColor: UIColor;
    /// The colour of the detail line.
    DetailColor: UIColor;
  end;

  /// What a section header of a `UITileView` shows, filled by `UITileView.Sections`'
  /// closure: the index of the section's first tile (read when the sections are given),
  /// its title and a dimmer detail after it ("" for none).
  UITileHeader = record
    First: int32;
    Text: string;
    Detail: string;
  end;

  /// A tree view's item closure: the item selected or activated.
  UITreeFunc = ref func(const AItem: UITreeItem);
  /// A tree view's right-click closure: the item under the pointer (names none in the empty
  /// space) and the point in the window (for `UIMenu.Open`).
  UITreeContextFunc = ref func(const AItem: UITreeItem; const AAt: UIPoint);
  /// A tile view's right-click closure: the tile under the pointer (-1 in the empty space)
  /// and the point in the window.
  UIIndexContextFunc = ref func(const AIndex: int32; const AAt: UIPoint);
  /// A virtual list's text closure: the text of the row `AIndex`.
  UIItemTextFunc = ref func(const AIndex: int32): string;
  /// A list's row colour closure: `true` with `AColor` set colours the row's text, `false`
  /// keeps the theme's.
  UIItemColorFunc = ref func(const AIndex: int32; var AColor: UIColor): bool;
  /// A virtual table's text closure: the text of the cell (`ARow` in the order shown).
  UICellTextFunc = ref func(const ARow: int32; const AColumn: int32): string;
  /// A table's cell colour closure: `true` with `AColor` set colours the cell's text.
  UICellColorFunc = ref func(const ARow: int32; const AColumn: int32; var AColor: UIColor): bool;
  /// A table's sort closure: the column clicked and the order asked for.
  UISortFunc = ref func(const AColumn: int32; const ADescending: bool);
  /// A tile view's tile closure: fills `ATile` for the tile `AIndex`.
  UITileFunc = ref func(const AIndex: int32; var ATile: UITile);
  /// A tile view's section closure: fills `AHeader` for the section `ASection`.
  UITileHeaderFunc = ref func(const ASection: int32; var AHeader: UITileHeader);
  /// A tile view's section closure: the section the user folded or unfolded.
  UITileSectionFunc = ref func(const ASection: UITileSection);
  /// A tile view's drag closure: the data of a drag of the selected tiles ("" keeps their
  /// indices).
  UIDragDataFunc = ref func(): string;

const
  // GControlIndexes' and GTreeItems' second event: an activation (double click, Enter); the
  // selection is event 0
  ADAM_RAVEN_CONTROL_ACTIVATE: int32 = 1;
  // The events of the closures whose texts GHeldTexts keeps, one per table a widget may use
  // at once (a tile view: its tiles, headers and drag data)
  ADAM_RAVEN_HELD_ITEMS: int32 = 0;
  ADAM_RAVEN_HELD_HEADERS: int32 = 1;
  ADAM_RAVEN_HELD_DRAG: int32 = 2;

var
  // V5's closures by (widget, event), released with the widget or the app as V4's
  GTreeItems: UISlots<UITreeFunc>;
  GTreeContexts: UISlots<UITreeContextFunc>;
  GIndexContexts: UISlots<UIIndexContextFunc>;
  GItemTexts: UISlots<UIItemTextFunc>;
  GItemColors: UISlots<UIItemColorFunc>;
  GCellTexts: UISlots<UICellTextFunc>;
  GCellColors: UISlots<UICellColorFunc>;
  GControlSorts: UISlots<UISortFunc>;
  GTileItems: UISlots<UITileFunc>;
  GTileHeaders: UISlots<UITileHeaderFunc>;
  GTileSections: UISlots<UITileSectionFunc>;
  GDragDatas: UISlots<UIDragDataFunc>;
  // The texts a text-giving callback last handed Raven, by its closure's key: kept until its
  // next call (or its widget goes), as Raven reads them after the callback returns
  GHeldTexts: Map<uint64, CStringArray>;

// The closures AWidget's lists, trees, tables and tiles held released, with the texts held
// for it (R_INVALID_ID: every one, the app ends)
func DoDropListControls(const AWidget: Rid);
var
  LEvent: uint64;
begin
  if AWidget = R_INVALID_ID then
    GTreeItems.DropAll();
    GTreeContexts.DropAll();
    GIndexContexts.DropAll();
    GItemTexts.DropAll();
    GItemColors.DropAll();
    GCellTexts.DropAll();
    GCellColors.DropAll();
    GControlSorts.DropAll();
    GTileItems.DropAll();
    GTileHeaders.DropAll();
    GTileSections.DropAll();
    GDragDatas.DropAll();
    GHeldTexts.Clear();
    return;
  end;
  GTreeItems.DropOwner(AWidget);
  GTreeContexts.DropOwner(AWidget);
  GIndexContexts.DropOwner(AWidget);
  GItemTexts.DropOwner(AWidget);
  GItemColors.DropOwner(AWidget);
  GCellTexts.DropOwner(AWidget);
  GCellColors.DropOwner(AWidget);
  GControlSorts.DropOwner(AWidget);
  GTileItems.DropOwner(AWidget);
  GTileHeaders.DropOwner(AWidget);
  GTileSections.DropOwner(AWidget);
  GDragDatas.DropOwner(AWidget);
  for LEvent := uint64(ADAM_RAVEN_HELD_ITEMS) to uint64(ADAM_RAVEN_HELD_DRAG) do
    GHeldTexts.Remove((uint64(AWidget) shl 8) | LEvent);
  end;
end;

// ATexts as C strings held under the closure key AData until its next call: the held list
func DoHoldTexts(const AData: ptr; const ATexts: array of string): CStringArray;
var
  LHeld: CStringArray;
  LI: int64;
begin
  for LI := 0 to len(ATexts) - 1 do
    LHeld.Add(ATexts[LI]);
  end;
  GHeldTexts.Put(uint64(AData), LHeld);
  return LHeld;
end;

// V5's trampolines, as V4's: each runs its closure on a copy; a closure the table no longer
// holds (its widget gone) is never reached
func clink DoOnTreeItem(tree_view: Rid; item: Rid; user_data: ptr);
var
  LFunc: UITreeFunc;
begin
  if not GTreeItems.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UITreeItem.Wrap(item));
end;

func clink DoOnTreeContext(tree_view: Rid; item: Rid; x: float32; y: float32; user_data: ptr);
var
  LFunc: UITreeContextFunc;
begin
  if not GTreeContexts.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UITreeItem.Wrap(item), UIPoint(x: x, y: y));
end;

func clink DoOnIndexContext(widget: Rid; index: int32; x: float32; y: float32; user_data: ptr);
var
  LFunc: UIIndexContextFunc;
begin
  if not GIndexContexts.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(index, UIPoint(x: x, y: y));
end;

func clink DoOnItemText(list_view: Rid; index: int32; user_data: ptr): ptr to const char;
var
  LFunc: UIItemTextFunc;
  LText: string;
  LHeld: CStringArray;
begin
  if not GItemTexts.Find(user_data, LFunc) or (LFunc = nil) then
    return nil;
  end;
  LText := LFunc(index);
  LHeld := DoHoldTexts(user_data, [LText]);
  return LHeld.Item[0];
end;

func clink DoOnCellText(table: Rid; row: int32; column: int32; user_data: ptr): ptr to const char;
var
  LFunc: UICellTextFunc;
  LText: string;
  LHeld: CStringArray;
begin
  if not GCellTexts.Find(user_data, LFunc) or (LFunc = nil) then
    return nil;
  end;
  LText := LFunc(row, column);
  LHeld := DoHoldTexts(user_data, [LText]);
  return LHeld.Item[0];
end;

func clink DoOnItemColor(list_view: Rid; index: int32; r: ptr to float32; g: ptr to float32;
  b: ptr to float32; a: ptr to float32; user_data: ptr): int32;
var
  LFunc: UIItemColorFunc;
  LColor: UIColor;
begin
  if not GItemColors.Find(user_data, LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  LColor := UIColor(r: 0.0f, g: 0.0f, b: 0.0f, a: 0.0f);
  if not LFunc(index, LColor) then
    return R_FALSE;
  end;
  r^ := LColor.r;
  g^ := LColor.g;
  b^ := LColor.b;
  a^ := LColor.a;
  return R_TRUE;
end;

func clink DoOnCellColor(table: Rid; row: int32; column: int32; r: ptr to float32;
  g: ptr to float32; b: ptr to float32; a: ptr to float32; user_data: ptr): int32;
var
  LFunc: UICellColorFunc;
  LColor: UIColor;
begin
  if not GCellColors.Find(user_data, LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  LColor := UIColor(r: 0.0f, g: 0.0f, b: 0.0f, a: 0.0f);
  if not LFunc(row, column, LColor) then
    return R_FALSE;
  end;
  r^ := LColor.r;
  g^ := LColor.g;
  b^ := LColor.b;
  a^ := LColor.a;
  return R_TRUE;
end;

func clink DoOnSort(table: Rid; column: int32; descending: int32; user_data: ptr);
var
  LFunc: UISortFunc;
begin
  if not GControlSorts.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(column, descending <> 0);
end;

// A tile described: the closure fills an Adam UITile from Raven's defaults, then its texts
// (held until the next call) and colours go into Raven's RTileItem
func clink DoOnTileItem(tile_view: Rid; index: int32; item: ptr to RTileItem; user_data: ptr);
var
  LFunc: UITileFunc;
  LTile: UITile;
  LHeld: CStringArray;
begin
  if not GTileItems.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LTile.Icon := UITextureRes();
  LTile.IconUVMin := UIPoint(x: item^.uv[0], y: item^.uv[1]);
  LTile.IconUVMax := UIPoint(x: item^.uv[2], y: item^.uv[3]);
  LTile.Text := "";
  LTile.Detail := "";
  LTile.Badge := "";
  LTile.Note := "";
  LTile.Tint := item^.Tint();
  LTile.IconRadius := item^.icon_radius;
  LTile.TextColor := item^.TextColor();
  LTile.DetailColor := item^.DetailColor();
  // an empty region (Raven's starting uv all 0) starts from the whole texture
  if (LTile.IconUVMax.x = 0.0f) and (LTile.IconUVMax.y = 0.0f) then
    LTile.IconUVMax := UIPoint(x: 1.0f, y: 1.0f);
  end;
  LFunc(index, LTile);
  LHeld := DoHoldTexts(user_data, [LTile.Text, LTile.Detail, LTile.Badge, LTile.Note]);
  item^.text := LHeld.Item[0];
  item^.detail := LHeld.Item[1];
  item^.badge := LHeld.Item[2];
  item^.note := LHeld.Item[3];
  item^.icon := LTile.Icon.Id();
  item^.uv[0] := LTile.IconUVMin.x;
  item^.uv[1] := LTile.IconUVMin.y;
  item^.uv[2] := LTile.IconUVMax.x;
  item^.uv[3] := LTile.IconUVMax.y;
  DoHookDestroy(tile_view);
  DoKeepTexture(tile_view, ADAM_RAVEN_KEEP_TILE | uint32(index), LTile.Icon);
  item^.tint[0] := LTile.Tint.r;
  item^.tint[1] := LTile.Tint.g;
  item^.tint[2] := LTile.Tint.b;
  item^.tint[3] := LTile.Tint.a;
  item^.icon_radius := LTile.IconRadius;
  item^.text_color[0] := LTile.TextColor.r;
  item^.text_color[1] := LTile.TextColor.g;
  item^.text_color[2] := LTile.TextColor.b;
  item^.text_color[3] := LTile.TextColor.a;
  item^.detail_color[0] := LTile.DetailColor.r;
  item^.detail_color[1] := LTile.DetailColor.g;
  item^.detail_color[2] := LTile.DetailColor.b;
  item^.detail_color[3] := LTile.DetailColor.a;
end;

// A section header described, as a tile is
func clink DoOnTileHeader(tile_view: Rid; section: int32; header: ptr to RTileSection; user_data: ptr);
var
  LFunc: UITileHeaderFunc;
  LHeader: UITileHeader;
  LHeld: CStringArray;
begin
  if not GTileHeaders.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LHeader := UITileHeader(First: header^.first, Text: "", Detail: "");
  LFunc(section, LHeader);
  LHeld := DoHoldTexts(user_data, [LHeader.Text, LHeader.Detail]);
  header^.first := LHeader.First;
  header^.text := LHeld.Item[0];
  header^.detail := LHeld.Item[1];
end;

func clink DoOnTileSection(tile_view: Rid; index: int32; user_data: ptr);
var
  LFunc: UITileSectionFunc;
begin
  if not GTileSections.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UITileSection.Wrap(tile_view, index));
end;

// A drag's data: "" gives nil (Raven keeps the tiles' indices); Raven copies the text
func clink DoOnDragData(tile_view: Rid; user_data: ptr): ptr to const char;
var
  LFunc: UIDragDataFunc;
  LText: string;
  LHeld: CStringArray;
begin
  if not GDragDatas.Find(user_data, LFunc) or (LFunc = nil) then
    return nil;
  end;
  LText := LFunc();
  if LText = "" then
    return nil;
  end;
  LHeld := DoHoldTexts(user_data, [LText]);
  return LHeld.Item[0];
end;

public type
  /// A list of text rows, stored or virtual (the list asks for the rows it draws), one
  /// selected. C: Rlist_view_*
  /// @example `LList := UIListView.Create(); LList.AddItem("Ada"); LList.OnActivate(func(const AIndex: int32) begin Open(AIndex); end);`
  UIListView = object(UIWidget)
    /// A new list with no rows. C: Rwidget_create(R_WIDGET_LIST_VIEW)
    static method Create(): UIListView;
    var
      LWidget: UIListView;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.ListView)));
      return LWidget;
    end;

    /// The kind a list view views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.ListView];
    end;

    /// `AText` as the last row: its index. C: Rlist_view_add_item
    const method AddItem(const AText: string): int32;
    begin
      return Rlist_view_add_item(self.FId, AText);
    end;

    /// The text of the row `AIndex`. C: Rlist_view_set_item_text
    const method Item(const AIndex: int32; const AText: string): self;
    begin
      Rlist_view_set_item_text(self.FId, AIndex, AText);
      return self;
    end;

    /// C: Rlist_view_get_item_text
    const method Item(const AIndex: int32): string;
    begin
      return DoRavenText(Rlist_view_get_item_text(self.FId, AIndex));
    end;

    /// The row `AIndex` removed (the rows after it move up). C: Rlist_view_remove_item
    const method RemoveItem(const AIndex: int32): self;
    begin
      Rlist_view_remove_item(self.FId, AIndex);
      return self;
    end;

    /// Every row removed. C: Rlist_view_clear_items
    const method ClearItems(): self;
    begin
      Rlist_view_clear_items(self.FId);
      return self;
    end;

    /// The rows it has. C: Rlist_view_get_item_count
    const method ItemCount(): int32;
    begin
      return Rlist_view_get_item_count(self.FId);
    end;

    /// Virtual mode, for large or computed data: `ACount` rows, the list storing none and
    /// running `AFunc` for the text of each row it draws. C: Rlist_view_set_virtual_items
    const method Virtual(const ACount: int32; const AFunc: UIItemTextFunc): self;
    begin
      if AFunc = nil then
        GItemTexts.Clear(self.FId, ADAM_RAVEN_HELD_ITEMS);
        Rlist_view_set_virtual_items(self.FId, ACount, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rlist_view_set_virtual_items(self.FId, ACount, DoOnItemText,
        GItemTexts.Put(self.FId, ADAM_RAVEN_HELD_ITEMS, AFunc));
      return self;
    end;

    /// Colours the rows' texts: Raven runs `AFunc` for each row it draws (stored or virtual);
    /// the colour stays on a selected or hovered row. C: Rlist_view_set_item_color_callback
    const method ItemColor(const AFunc: UIItemColorFunc): self;
    begin
      if AFunc = nil then
        GItemColors.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rlist_view_set_item_color_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rlist_view_set_item_color_callback(self.FId, DoOnItemColor,
        GItemColors.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Selects the row `AIndex` (-1: none). C: Rlist_view_set_selected
    const method Selected(const AIndex: int32): self;
    begin
      Rlist_view_set_selected(self.FId, AIndex);
      return self;
    end;

    /// The row selected (-1 for none). C: Rlist_view_get_selected
    const method Selected(): int32;
    begin
      return Rlist_view_get_selected(self.FId);
    end;

    /// Scrolls until the row `AIndex` shows. C: Rlist_view_scroll_to_item
    const method ScrollTo(const AIndex: int32): self;
    begin
      Rlist_view_scroll_to_item(self.FId, AIndex);
      return self;
    end;

    /// Runs `AFunc` with the row selected when the selection changes.
    /// C: Rlist_view_set_selection_changed_callback
    const method OnSelect(const AFunc: UIIndexFunc): self;
    begin
      if AFunc = nil then
        GControlIndexes.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rlist_view_set_selection_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rlist_view_set_selection_changed_callback(self.FId, DoOnControlIndex,
        GControlIndexes.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the row activated (double click, Enter; the widget's action runs
    /// too). C: Rlist_view_set_activated_callback
    const method OnActivate(const AFunc: UIIndexFunc): self;
    begin
      if AFunc = nil then
        GControlIndexes.Clear(self.FId, ADAM_RAVEN_CONTROL_ACTIVATE);
        Rlist_view_set_activated_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rlist_view_set_activated_callback(self.FId, DoOnControlIndex,
        GControlIndexes.Put(self.FId, ADAM_RAVEN_CONTROL_ACTIVATE, AFunc));
      return self;
    end;
  end;

  /// A tree of text items (virtualized), folding under their parents; one or several
  /// selected, draggable. C: Rtree_view_*
  /// @example `LDocs := LTree.AddItem("Docs"); LTree.AddItem(LDocs, "README.md"); LDocs.Expanded(true);`
  UITreeView = object(UIWidget)
    /// A new tree with no items. C: Rwidget_create(R_WIDGET_TREE_VIEW)
    static method Create(): UITreeView;
    var
      LWidget: UITreeView;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.TreeView)));
      return LWidget;
    end;

    /// The kind a tree view views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.TreeView];
    end;

    /// A new item `AText` as the last child of `AParent`. C: Rtree_view_add_item
    const method AddItem(const AParent: UITreeItem; const AText: string): UITreeItem;
    var
      LItem: Rid;
    begin
      LItem := Rtree_view_add_item(self.FId, AParent.Id(), AText);
      if LItem <> R_INVALID_ID then
        DoNoteTreeItem(self.FId, LItem);
      end;
      return UITreeItem.Wrap(LItem);
    end;

    /// A new top-level item `AText`, the last one. C: Rtree_view_add_item
    const method AddItem(const AText: string): UITreeItem;
    var
      LItem: Rid;
    begin
      LItem := Rtree_view_add_item(self.FId, R_INVALID_ID, AText);
      if LItem <> R_INVALID_ID then
        DoNoteTreeItem(self.FId, LItem);
      end;
      return UITreeItem.Wrap(LItem);
    end;

    /// Every item deleted. C: Rtree_view_clear_items
    const method ClearItems(): self;
    begin
      Rtree_view_clear_items(self.FId);
      DoDropTreeItems(self.FId);
      return self;
    end;

    /// Its top-level items. C: Rtree_view_get_item_count
    const method ItemCount(): int32;
    begin
      return Rtree_view_get_item_count(self.FId);
    end;

    /// Its top-level item at `AIndex` (names none outside). C: Rtree_view_get_item
    const method Item(const AIndex: int32): UITreeItem;
    begin
      return UITreeItem.Wrap(Rtree_view_get_item(self.FId, AIndex));
    end;

    /// Selects `AItem` alone (an empty handle: none). C: Rtree_view_set_selected_item
    const method Selected(const AItem: UITreeItem): self;
    begin
      Rtree_view_set_selected_item(self.FId, AItem.Id());
      return self;
    end;

    /// The item selected (the one clicked last in a multiple selection; names none for
    /// none). C: Rtree_view_get_selected_item
    const method Selected(): UITreeItem;
    begin
      return UITreeItem.Wrap(Rtree_view_get_selected_item(self.FId));
    end;

    /// Several items selectable (Ctrl + click one more, Shift + click a range).
    /// C: Rtree_view_set_multi_select
    const method MultiSelect(const AOn: bool): self;
    begin
      Rtree_view_set_multi_select(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Nothing selected. C: Rtree_view_clear_selection
    const method ClearSelection(): self;
    begin
      Rtree_view_clear_selection(self.FId);
      return self;
    end;

    /// The items selected. C: Rtree_view_get_selection_count
    const method SelectionCount(): int32;
    begin
      return Rtree_view_get_selection_count(self.FId);
    end;

    /// The selected item at `AIndex`, top to bottom. C: Rtree_view_get_selection
    const method Selection(const AIndex: int32): UITreeItem;
    begin
      return UITreeItem.Wrap(Rtree_view_get_selection(self.FId, AIndex));
    end;

    /// Scrolls (unfolding its ancestors) until `AItem` shows. C: Rtree_view_scroll_to_item
    const method ScrollTo(const AItem: UITreeItem): self;
    begin
      Rtree_view_scroll_to_item(self.FId, AItem.Id());
      return self;
    end;

    /// Items can be dragged: the selection goes to the drag with the type `AType` and, as
    /// data, the items' Rids in decimal separated by spaces ("": no drag, the default).
    /// C: Rtree_view_set_drag_type
    const method DragType(const AType: string): self;
    begin
      Rtree_view_set_drag_type(self.FId, AType);
      return self;
    end;

    /// The item at `AAt`, a point in the tree (a drop's local point; names none in the
    /// empty space). C: Rtree_view_get_item_at
    const method ItemAt(const AAt: UIPoint): UITreeItem;
    begin
      return UITreeItem.Wrap(Rtree_view_get_item_at(self.FId, AAt.x, AAt.y));
    end;

    /// Shows where a drop would go: `AItem`, or the whole tree when `AWholeTree` (an empty
    /// handle and `false`: none). C: Rtree_view_set_drop_highlight
    const method DropHighlight(const AItem: UITreeItem; const AWholeTree: bool): self;
    begin
      Rtree_view_set_drop_highlight(self.FId, AItem.Id(), DoCBool(AWholeTree));
      return self;
    end;

    /// Runs `AFunc` with the item selected (the one clicked last) when the selection
    /// changes. C: Rtree_view_set_selection_changed_callback
    const method OnSelect(const AFunc: UITreeFunc): self;
    begin
      if AFunc = nil then
        GTreeItems.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtree_view_set_selection_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtree_view_set_selection_changed_callback(self.FId, DoOnTreeItem,
        GTreeItems.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the item activated (double click, Enter; the widget's action runs
    /// too). C: Rtree_view_set_activated_callback
    const method OnActivate(const AFunc: UITreeFunc): self;
    begin
      if AFunc = nil then
        GTreeItems.Clear(self.FId, ADAM_RAVEN_CONTROL_ACTIVATE);
        Rtree_view_set_activated_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtree_view_set_activated_callback(self.FId, DoOnTreeItem,
        GTreeItems.Put(self.FId, ADAM_RAVEN_CONTROL_ACTIVATE, AFunc));
      return self;
    end;

    /// Runs `AFunc` on a right click: the item under the pointer (selected first; names none
    /// in the empty space) and the point in the window, for `UIMenu.Open`.
    /// C: Rtree_view_set_context_callback
    const method OnContext(const AFunc: UITreeContextFunc): self;
    begin
      if AFunc = nil then
        GTreeContexts.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtree_view_set_context_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtree_view_set_context_callback(self.FId, DoOnTreeContext,
        GTreeContexts.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// Rows of cells under columns (virtualized): stored rows sort themselves when a header
  /// is clicked (numbers by value, texts aside case), a virtual table asks for the cells it
  /// draws and leaves the sort to `OnSort`. Row indices are always those of the order shown.
  /// C: Rtable_*
  /// @example `LTable.AddColumn("Name", 160.0f); LTable.AddColumn("Age", 60.0f).Align(UITextAlign.Right); LTable.AddRow(["Ada", "36"]);`
  UITable = object(UIWidget)
    /// A new table with no columns. C: Rwidget_create(R_WIDGET_TABLE)
    static method Create(): UITable;
    var
      LWidget: UITable;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Table)));
      return LWidget;
    end;

    /// The kind a table views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Table];
    end;

    /// A new last column headed `AHeader`, `AWidth` wide (0 or less: Raven's 120); the stored
    /// rows get an empty cell in it. C: Rtable_add_column
    const method AddColumn(const AHeader: string; const AWidth: float32): UITableColumn;
    begin
      return UITableColumn.Wrap(self.FId, Rtable_add_column(self.FId, AHeader, AWidth));
    end;

    /// Its columns. C: Rtable_get_column_count
    const method ColumnCount(): int32;
    begin
      return Rtable_get_column_count(self.FId);
    end;

    /// Its column at `AIndex`.
    const method Column(const AIndex: int32): UITableColumn;
    begin
      return UITableColumn.Wrap(self.FId, AIndex);
    end;

    /// Every column removed, with the stored rows. C: Rtable_clear_columns
    const method ClearColumns(): self;
    begin
      Rtable_clear_columns(self.FId);
      return self;
    end;

    /// A new empty last row (none in virtual mode, or with no column). C: Rtable_add_row
    const method AddRow(): UITableRow;
    begin
      return UITableRow.Wrap(self.FId, Rtable_add_row(self.FId, nil));
    end;

    /// A new last row with the cells `ACells`, in column order (a '|' in a text stays).
    /// C: Rtable_add_row + Rtable_set_cell
    const method AddRow(const ACells: array of string): UITableRow;
    var
      LRow: int32;
      LI: int64;
    begin
      LRow := Rtable_add_row(self.FId, nil);
      if LRow >= 0 then
        for LI := 0 to len(ACells) - 1 do
          Rtable_set_cell(self.FId, LRow, int32(LI), ACells[LI]);
        end;
      end;
      return UITableRow.Wrap(self.FId, LRow);
    end;

    /// Its row at `AIndex` (in the order shown).
    const method Row(const AIndex: int32): UITableRow;
    begin
      return UITableRow.Wrap(self.FId, AIndex);
    end;

    /// The row `AIndex` removed (the rows after it move up). C: Rtable_remove_row
    const method RemoveRow(const AIndex: int32): self;
    begin
      Rtable_remove_row(self.FId, AIndex);
      return self;
    end;

    /// Every stored row removed. C: Rtable_clear_rows
    const method ClearRows(): self;
    begin
      Rtable_clear_rows(self.FId);
      return self;
    end;

    /// Its rows (stored or virtual). C: Rtable_get_row_count
    const method RowCount(): int32;
    begin
      return Rtable_get_row_count(self.FId);
    end;

    /// The text of the cell (`ARow`, `AColumn`) (a '|' in it stays). C: Rtable_set_cell
    const method Cell(const ARow: int32; const AColumn: int32; const AText: string): self;
    begin
      Rtable_set_cell(self.FId, ARow, AColumn, AText);
      return self;
    end;

    /// C: Rtable_get_cell
    const method Cell(const ARow: int32; const AColumn: int32): string;
    begin
      return DoRavenText(Rtable_get_cell(self.FId, ARow, AColumn));
    end;

    /// Virtual mode, for large or computed data: `ARows` rows, the table storing none and
    /// running `AFunc` for the text of each cell it draws. C: Rtable_set_virtual_rows
    const method Virtual(const ARows: int32; const AFunc: UICellTextFunc): self;
    begin
      if AFunc = nil then
        GCellTexts.Clear(self.FId, ADAM_RAVEN_HELD_ITEMS);
        Rtable_set_virtual_rows(self.FId, ARows, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtable_set_virtual_rows(self.FId, ARows, DoOnCellText,
        GCellTexts.Put(self.FId, ADAM_RAVEN_HELD_ITEMS, AFunc));
      return self;
    end;

    /// Colours the cells' texts: Raven runs `AFunc` for each cell it draws (it wins over
    /// `CellTextColor`). C: Rtable_set_cell_color_callback
    const method CellColor(const AFunc: UICellColorFunc): self;
    begin
      if AFunc = nil then
        GCellColors.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtable_set_cell_color_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtable_set_cell_color_callback(self.FId, DoOnCellColor,
        GCellColors.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// A stored cell's fixed text colour (`AColumn` -1: the whole row; alpha 0: the
    /// inherited one). C: Rtable_set_cell_text_color
    const method CellTextColor(const ARow: int32; const AColumn: int32; const AColor: UIColor): self;
    begin
      Rtable_set_cell_text_color(self.FId, ARow, AColumn, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// Several rows selectable (Ctrl + click one more, Shift + click a range).
    /// C: Rtable_set_multi_select
    const method MultiSelect(const AOn: bool): self;
    begin
      Rtable_set_multi_select(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The row `ARow` selected alone (-1: none). C: Rtable_set_selected
    const method Selected(const ARow: int32): self;
    begin
      Rtable_set_selected(self.FId, ARow);
      return self;
    end;

    /// The row selected (-1 for none). C: Rtable_get_selected
    const method Selected(): int32;
    begin
      return Rtable_get_selected(self.FId);
    end;

    /// Nothing selected. C: Rtable_clear_selection
    const method ClearSelection(): self;
    begin
      Rtable_clear_selection(self.FId);
      return self;
    end;

    /// The rows selected. C: Rtable_get_selection_count
    const method SelectionCount(): int32;
    begin
      return Rtable_get_selection_count(self.FId);
    end;

    /// The selected row at `AIndex`, top to bottom (-1 outside). C: Rtable_get_selection
    const method Selection(const AIndex: int32): int32;
    begin
      return Rtable_get_selection(self.FId, AIndex);
    end;

    /// Scrolls until the row `ARow` shows. C: Rtable_scroll_to_row
    const method ScrollTo(const ARow: int32): self;
    begin
      Rtable_scroll_to_row(self.FId, ARow);
      return self;
    end;

    /// Sorts by the column `AColumn` (stored rows move; -1 shows no sorted column).
    /// C: Rtable_sort
    const method Sort(const AColumn: int32; const ADescending: bool): self;
    begin
      Rtable_sort(self.FId, AColumn, DoCBool(ADescending));
      return self;
    end;

    /// The column sorted by (-1 for none). C: Rtable_get_sort_column
    const method SortColumn(): int32;
    begin
      return Rtable_get_sort_column(self.FId);
    end;

    /// `true` when sorted from the highest down. C: Rtable_is_sort_descending
    const method SortDescending(): bool;
    begin
      return Rtable_is_sort_descending(self.FId) <> 0;
    end;

    /// Shows (`true`) or hides the header row. C: Rtable_set_header_visible
    const method HeaderVisible(const AOn: bool): self;
    begin
      Rtable_set_header_visible(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Lines between the cells. C: Rtable_set_grid_lines
    const method GridLines(const AOn: bool): self;
    begin
      Rtable_set_grid_lines(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Every other row a little darker. C: Rtable_set_striped
    const method Striped(const AOn: bool): self;
    begin
      Rtable_set_striped(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Runs `AFunc` with the row selected when the selection changes.
    /// C: Rtable_set_selection_changed_callback
    const method OnSelect(const AFunc: UIIndexFunc): self;
    begin
      if AFunc = nil then
        GControlIndexes.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtable_set_selection_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtable_set_selection_changed_callback(self.FId, DoOnControlIndex,
        GControlIndexes.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the row activated (double click, Enter). C: Rtable_set_activated_callback
    const method OnActivate(const AFunc: UIIndexFunc): self;
    begin
      if AFunc = nil then
        GControlIndexes.Clear(self.FId, ADAM_RAVEN_CONTROL_ACTIVATE);
        Rtable_set_activated_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtable_set_activated_callback(self.FId, DoOnControlIndex,
        GControlIndexes.Put(self.FId, ADAM_RAVEN_CONTROL_ACTIVATE, AFunc));
      return self;
    end;

    /// Runs `AFunc` when a header is clicked to sort: the column and the order (a virtual
    /// table orders its data there). C: Rtable_set_sort_callback
    const method OnSort(const AFunc: UISortFunc): self;
    begin
      if AFunc = nil then
        GControlSorts.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtable_set_sort_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtable_set_sort_callback(self.FId, DoOnSort,
        GControlSorts.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// A grid (or rows) of tiles, an icon over a name, virtualized: the program describes each
  /// tile Raven draws (`Items`), optionally cut into foldable sections under headers
  /// (`Sections`, given after the tiles). Several tiles selectable, draggable.
  /// C: Rtile_view_*
  /// @example `LTiles.Items(len(GFiles), func(const AIndex: int32; var ATile: UITile) begin ATile.Text := GFiles[AIndex]; end);`
  UITileView = object(UIWidget)
    /// A new tile view with no tiles. C: Rwidget_create(R_WIDGET_TILE_VIEW)
    static method Create(): UITileView;
    var
      LWidget: UITileView;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.TileView)));
      return LWidget;
    end;

    /// The kind a tile view views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.TileView];
    end;

    /// `ACount` tiles, each described by `AFunc` when it is drawn; the selection is cleared
    /// and the sections removed. C: Rtile_view_set_items
    const method Items(const ACount: int32; const AFunc: UITileFunc): self;
    begin
      if AFunc = nil then
        GTileItems.Clear(self.FId, ADAM_RAVEN_HELD_ITEMS);
        Rtile_view_set_items(self.FId, ACount, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtile_view_set_items(self.FId, ACount, DoOnTileItem,
        GTileItems.Put(self.FId, ADAM_RAVEN_HELD_ITEMS, AFunc));
      return self;
    end;

    /// Draws the tiles again (their description changed, not their number).
    /// C: Rtile_view_refresh
    const method Refresh(): self;
    begin
      Rtile_view_refresh(self.FId);
      return self;
    end;

    /// Its tiles. C: Rtile_view_get_count
    const method Count(): int32;
    begin
      return Rtile_view_get_count(self.FId);
    end;

    /// The size of a tile (its name included) and of its icon (Raven's: 112 x 112, 64).
    /// C: Rtile_view_set_tile_size
    const method TileSize(const AWidth: float32; const AHeight: float32; const AIconSize: float32): self;
    begin
      Rtile_view_set_tile_size(self.FId, AWidth, AHeight, AIconSize);
      return self;
    end;

    /// The text shown when there is no tile. C: Rtile_view_set_empty_text
    const method EmptyText(const AText: string): self;
    begin
      Rtile_view_set_empty_text(self.FId, AText);
      return self;
    end;

    /// Rows layout: the width of the box an icon is drawn in (0: square, the default).
    /// C: Rtile_view_set_icon_width
    const method IconWidth(const AWidth: float32): self;
    begin
      Rtile_view_set_icon_width(self.FId, AWidth);
      return self;
    end;

    /// `ACount` sections, each header described by `AFunc` (its `First` read now, its texts
    /// when drawn), all unfolded; give them after the tiles. C: Rtile_view_set_sections
    const method Sections(const ACount: int32; const AFunc: UITileHeaderFunc): self;
    begin
      if AFunc = nil then
        GTileHeaders.Clear(self.FId, ADAM_RAVEN_HELD_HEADERS);
        Rtile_view_set_sections(self.FId, ACount, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtile_view_set_sections(self.FId, ACount, DoOnTileHeader,
        GTileHeaders.Put(self.FId, ADAM_RAVEN_HELD_HEADERS, AFunc));
      return self;
    end;

    /// Its sections. C: Rtile_view_get_section_count
    const method SectionCount(): int32;
    begin
      return Rtile_view_get_section_count(self.FId);
    end;

    /// The section `AIndex`.
    const method Section(const AIndex: int32): UITileSection;
    begin
      return UITileSection.Wrap(self.FId, AIndex);
    end;

    /// The section of the tile `AIndex` (names none before the first section).
    /// C: Rtile_view_get_section_of
    const method SectionOf(const AIndex: int32): UITileSection;
    begin
      return UITileSection.Wrap(self.FId, Rtile_view_get_section_of(self.FId, AIndex));
    end;

    /// The section whose header is at `AAt`, a point in the widget (names none elsewhere).
    /// C: Rtile_view_get_section_at
    const method SectionAt(const AAt: UIPoint): UITileSection;
    begin
      return UITileSection.Wrap(self.FId, Rtile_view_get_section_at(self.FId, AAt.x, AAt.y));
    end;

    /// Adds the tile `AIndex` to (`true`) or takes it from the selection.
    /// C: Rtile_view_set_selected
    const method Selected(const AIndex: int32; const AOn: bool): self;
    begin
      Rtile_view_set_selected(self.FId, AIndex, DoCBool(AOn));
      return self;
    end;

    /// C: Rtile_view_is_selected
    const method Selected(const AIndex: int32): bool;
    begin
      return Rtile_view_is_selected(self.FId, AIndex) <> 0;
    end;

    /// Nothing selected. C: Rtile_view_clear_selection
    const method ClearSelection(): self;
    begin
      Rtile_view_clear_selection(self.FId);
      return self;
    end;

    /// The tile `AIndex` selected alone. C: Rtile_view_select_only
    const method SelectOnly(const AIndex: int32): self;
    begin
      Rtile_view_select_only(self.FId, AIndex);
      return self;
    end;

    /// The tile clicked last (-1 for none). C: Rtile_view_get_current
    const method Current(): int32;
    begin
      return Rtile_view_get_current(self.FId);
    end;

    /// The tiles selected. C: Rtile_view_get_selection_count
    const method SelectionCount(): int32;
    begin
      return Rtile_view_get_selection_count(self.FId);
    end;

    /// The index of the `ANth` selected tile, in order. C: Rtile_view_get_selection
    const method Selection(const ANth: int32): int32;
    begin
      return Rtile_view_get_selection(self.FId, ANth);
    end;

    /// Scrolls until the tile `AIndex` shows. C: Rtile_view_scroll_to
    const method ScrollTo(const AIndex: int32): self;
    begin
      Rtile_view_scroll_to(self.FId, AIndex);
      return self;
    end;

    /// The tile at `AAt`, a point in the widget (a drop's local point; -1 elsewhere).
    /// C: Rtile_view_get_item_at
    const method ItemAt(const AAt: UIPoint): int32;
    begin
      return Rtile_view_get_item_at(self.FId, AAt.x, AAt.y);
    end;

    /// Shows the tile a drop would go to (-1: none). C: Rtile_view_set_drop_highlight
    const method DropHighlight(const AIndex: int32): self;
    begin
      Rtile_view_set_drop_highlight(self.FId, AIndex);
      return self;
    end;

    /// Tiles can be dragged: the selected ones go to the drag with the type `AType` and, as
    /// data, their indices separated by spaces or `DragData`'s text ("": no drag).
    /// C: Rtile_view_set_drag_type
    const method DragType(const AType: string): self;
    begin
      Rtile_view_set_drag_type(self.FId, AType);
      return self;
    end;

    /// The data of a drag, given by `AFunc` (paths of files ..) in place of the indices (its
    /// "" keeps them). C: Rtile_view_set_drag_data_callback
    const method DragData(const AFunc: UIDragDataFunc): self;
    begin
      if AFunc = nil then
        GDragDatas.Clear(self.FId, ADAM_RAVEN_HELD_DRAG);
        Rtile_view_set_drag_data_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtile_view_set_drag_data_callback(self.FId, DoOnDragData,
        GDragDatas.Put(self.FId, ADAM_RAVEN_HELD_DRAG, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the current tile (-1 for none) when the selection changes.
    /// C: Rtile_view_set_selection_changed_callback
    const method OnSelect(const AFunc: UIIndexFunc): self;
    begin
      if AFunc = nil then
        GControlIndexes.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtile_view_set_selection_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtile_view_set_selection_changed_callback(self.FId, DoOnControlIndex,
        GControlIndexes.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the tile activated (double click, Enter).
    /// C: Rtile_view_set_activated_callback
    const method OnActivate(const AFunc: UIIndexFunc): self;
    begin
      if AFunc = nil then
        GControlIndexes.Clear(self.FId, ADAM_RAVEN_CONTROL_ACTIVATE);
        Rtile_view_set_activated_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtile_view_set_activated_callback(self.FId, DoOnControlIndex,
        GControlIndexes.Put(self.FId, ADAM_RAVEN_CONTROL_ACTIVATE, AFunc));
      return self;
    end;

    /// Runs `AFunc` on a right click: the tile under the pointer (selected first; -1 in the
    /// empty space) and the point in the window. C: Rtile_view_set_context_callback
    const method OnContext(const AFunc: UIIndexContextFunc): self;
    begin
      if AFunc = nil then
        GIndexContexts.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtile_view_set_context_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtile_view_set_context_callback(self.FId, DoOnIndexContext,
        GIndexContexts.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the section the user folded or unfolded.
    /// C: Rtile_view_set_section_toggled_callback
    const method OnSectionToggled(const AFunc: UITileSectionFunc): self;
    begin
      if AFunc = nil then
        GTileSections.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtile_view_set_section_toggled_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtile_view_set_section_toggled_callback(self.FId, DoOnTileSection,
        GTileSections.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// One item of a `UIMenu`: a widget, made by `UIMenu.AddItem`. Its text is the base's
  /// `Text` too. C: Rmenu_item_*
  UIMenuItem = object(UIWidget)
    /// The kind a menu item views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.MenuItem];
    end;

    /// The item's text. C: Rmenu_item_set_text
    const method Text(const AText: string): self;
    begin
      Rmenu_item_set_text(self.FId, AText);
      return self;
    end;

    /// C: Rmenu_item_get_text
    const method Text(): string;
    begin
      return DoRavenText(Rmenu_item_get_text(self.FId));
    end;

    /// Shows the shortcut `AKey` with `AMods` beside the item, and runs the item when they are
    /// pressed in its menu bar's window. C: Rmenu_item_set_shortcut
    const method Shortcut(const AKey: UIKey; const AMods: UIModifiers): self;
    begin
      Rmenu_item_set_shortcut(self.FId, int32(AKey), uint32(AMods));
      return self;
    end;

    /// A shortcut hint shown in place of the formatted shortcut, binding no key ("" hides
    /// it). C: Rmenu_item_set_shortcut_text
    const method ShortcutText(const AText: string): self;
    begin
      Rmenu_item_set_shortcut_text(self.FId, AText);
      return self;
    end;

    /// The formatted shortcut shown again in place of `ShortcutText`'s.
    /// C: Rmenu_item_set_shortcut_text (NULL)
    const method ResetShortcutText(): self;
    begin
      Rmenu_item_set_shortcut_text(self.FId, nil);
      return self;
    end;

    /// The item shows a check mark that a click toggles. C: Rmenu_item_set_checkable
    const method Checkable(const AOn: bool): self;
    begin
      Rmenu_item_set_checkable(self.FId, DoCBool(AOn));
      return self;
    end;

    /// C: Rmenu_item_set_checked
    const method Checked(const AOn: bool): self;
    begin
      Rmenu_item_set_checked(self.FId, DoCBool(AOn));
      return self;
    end;

    /// C: Rmenu_item_is_checked
    const method Checked(): bool;
    begin
      return Rmenu_item_is_checked(self.FId) <> 0;
    end;

    /// Runs `AFunc` when the item is clicked (or its shortcut pressed).
    /// C: Rmenu_item_set_clicked_callback
    const method OnClick(const AFunc: UITaskFunc): self;
    begin
      if AFunc = nil then
        GControlTasks.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rmenu_item_set_clicked_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rmenu_item_set_clicked_callback(self.FId, DoOnControlTask,
        GControlTasks.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// The whole of `ATexture` as the icon before the item's text (after the check mark
    /// column; an empty handle removes it), drawn in its own colours; kept while it is set.
    /// C: Rmenu_item_set_icon
    const method Icon(const ATexture: UITextureRes): self;
    begin
      self.Icon(ATexture, UIPoint(x: 0.0f, y: 0.0f), UIPoint(x: 1.0f, y: 1.0f), false);
      return self;
    end;

    /// A part of `ATexture` as the item's icon (an empty handle removes it); kept while it is
    /// set.
    /// `AUVMin` .. `AUVMax`: the part of the texture shown, as texture coordinates (0 .. 1)
    /// of its corners; `ATint` `true`: the texture is a mask drawn in the text colour.
    /// C: Rmenu_item_set_icon
    const method Icon(const ATexture: UITextureRes; const AUVMin: UIPoint; const AUVMax: UIPoint;
      const ATint: bool): self;
    begin
      Rmenu_item_set_icon(self.FId, ATexture.Id(), AUVMin.x, AUVMin.y, AUVMax.x, AUVMax.y,
        DoCBool(ATint));
      DoHookDestroy(self.FId);
      DoKeepTexture(self.FId, ADAM_RAVEN_KEEP_ICON, ATexture);
      return self;
    end;
  end;

  /// A menu: items, separators, captions and sub-menus, in a menu bar or alone (a menu with
  /// no parent opens anywhere: `Open`, `UIWidget.ContextMenu`). C: Rmenu_*
  /// @example `LMenu := UIMenu.Create(); LMenu.AddItem("Rename").OnClick(func() begin Rename(); end); LList.ContextMenu(LMenu);`
  UIMenu = object(UIWidget)
    /// A new menu with no parent and no items. C: Rwidget_create(R_WIDGET_MENU)
    static method Create(): UIMenu;
    var
      LWidget: UIMenu;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Menu)));
      return LWidget;
    end;

    /// The kind a menu views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Menu];
    end;

    /// The menu's title (in its menu bar, or as a sub-menu's item). C: Rmenu_set_title
    const method Title(const ATitle: string): self;
    begin
      Rmenu_set_title(self.FId, ATitle);
      return self;
    end;

    /// The title's colour in an in-window bar (alpha 0: the theme's).
    /// C: Rmenu_set_title_color
    const method TitleColor(const AColor: UIColor): self;
    begin
      Rmenu_set_title_color(self.FId, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// A new last item `AText`. C: Rmenu_add_item
    const method AddItem(const AText: string): UIMenuItem;
    begin
      return UIWidget.Wrap(Rmenu_add_item(self.FId, AText)).As<UIMenuItem>();
    end;

    /// A separator line after the last item: its widget. C: Rmenu_add_separator
    const method AddSeparator(): UIWidget;
    begin
      return UIWidget.Wrap(Rmenu_add_separator(self.FId));
    end;

    /// A caption row keyboard navigation skips: its widget. C: Rmenu_add_header
    const method AddHeader(const AText: string): UIWidget;
    begin
      return UIWidget.Wrap(Rmenu_add_header(self.FId, AText));
    end;

    /// A new last sub-menu titled `ATitle`. C: Rmenu_add_menu
    const method AddMenu(const ATitle: string): UIMenu;
    begin
      return UIWidget.Wrap(Rmenu_add_menu(self.FId, ATitle)).As<UIMenu>();
    end;

    /// Opens the menu as a popup at `AAt` in `AWindow` (logical units). C: Rmenu_open
    const method Open(const AWindow: UIWindow; const AAt: UIPoint): self;
    begin
      Rmenu_open(self.FId, AWindow.Id(), AAt.x, AAt.y);
      return self;
    end;
  end;

  /// A window's menu bar: menus by title. On macOS the first one of the active window shows
  /// in the system's bar (`Native`, on by default); elsewhere it is drawn in the window.
  /// C: Rmenu_bar_*
  /// @example `LFile := LBar.AddMenu("File"); LFile.AddItem("Quit").Shortcut(UIKey.Q, [UIModifier.Ctrl]);`
  UIMenuBar = object(UIWidget)
    /// A new menu bar with no menus. C: Rwidget_create(R_WIDGET_MENU_BAR)
    static method Create(): UIMenuBar;
    var
      LWidget: UIMenuBar;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.MenuBar)));
      return LWidget;
    end;

    /// The kind a menu bar views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.MenuBar];
    end;

    /// `false` keeps the bar in the window everywhere (macOS included). C: Rmenu_bar_set_native
    const method Native(const AOn: bool): self;
    begin
      Rmenu_bar_set_native(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `true` while the system shows the bar in place of the window. C: Rmenu_bar_is_native
    const method Native(): bool;
    begin
      return Rmenu_bar_is_native(self.FId) <> 0;
    end;

    /// A new last menu titled `ATitle`. C: Rmenu_add_menu
    const method AddMenu(const ATitle: string): UIMenu;
    begin
      return UIWidget.Wrap(Rmenu_add_menu(self.FId, ATitle)).As<UIMenu>();
    end;

    /// A divider after the last title of an in-window bar: its widget.
    /// C: Rmenu_bar_add_divider
    const method AddDivider(): UIWidget;
    begin
      return UIWidget.Wrap(Rmenu_bar_add_divider(self.FId));
    end;
  end;

// The value handles' views of the widget they belong to (named after the widget types)
public extend UITableColumn
  /// The table the column is in.
  const method Table(): UITable;
  begin
    return UIWidget.Wrap(self.FTable).As<UITable>();
  end;
end;

public extend UITableRow
  /// The table the row is in.
  const method Table(): UITable;
  begin
    return UIWidget.Wrap(self.FTable).As<UITable>();
  end;
end;

public extend UITileSection
  /// The tile view the section is in.
  const method View(): UITileView;
  begin
    return UIWidget.Wrap(self.FView).As<UITileView>();
  end;
end;

// A widget's right-click menu (listing sec 5, V5)
public extend UIWidget
  /// The menu a right click on the widget opens (an empty handle: none).
  /// C: Rwidget_set_context_menu
  const method ContextMenu(const AMenu: UIMenu): self;
  begin
    Rwidget_set_context_menu(self.FId, AMenu.Id());
    return self;
  end;
end;

// The app's taskbar menu (listing sec 3, moved to V5: it names UIMenu)
public extend UIApp
  /// `AMenu`, a menu with no parent (`UIMenu.Create`), as the menu of the app's taskbar
  /// button (an empty handle removes it). C: Rtaskbar_set_menu
  /// @returns `true` when the system has taskbar menus (`false` too for a menu in a bar or
  /// in another menu)
  static method TaskbarMenu(const AMenu: UIMenu): bool;
  begin
    return Rtaskbar_set_menu(AMenu.Id()) <> 0;
  end;
end;

// The builder's opening of a child container (listing sec 0 / 9): a new widget of a widget
// type, placed in this one, handed back to fill; `End()` returns here.
public extend UIWidget
  /// A new `T` (a widget type with a `Create()`: UIVBox, UIGrid, UIBorder ..) placed last
  /// inside this widget, to fill in the chain; its `End()` comes back to this widget.
  /// @example `LRoot.Begin<UIHBox>().Add(LOk).Add(LCancel).End().Add(LStatus);`
  const method Begin<T>(): T;
  var
    LChild: T;
  begin
    LChild := T.Create();
    self.Add(LChild);
    return LChild;
  end;

  /// A new `T` placed last inside this widget, sitting as `ALayout` says.
  const method Begin<T>(const ALayout: UILayout): T;
  var
    LChild: T;
  begin
    LChild := T.Create();
    self.Add(LChild, ALayout);
    return LChild;
  end;
end;

// ============================================================================
// Editors and rich views (listing sec 6, V6). UITextEditor (a text / code
// editor: lines, cursor, selection, undo, syntax colouring by language,
// completion, markers), UIFileBrowser (a file picker inside a window),
// UIViewport (a rectangle the app's own renderer draws each frame), UICustom
// (a widget the app paints through a UIPainter) and UICarousel (pages shown
// one at a time). Their closures live in the GControl* tables and the V6
// tables below, released with the widget (DoDropEditorControls); the text a
// hover closure hands Raven is held (GHeldTexts) until its next call, as
// Raven copies it only after the callback returns.
// ============================================================================

public type
  /// A place in a text editor's text: its line and its column, both from 0.
  UITextPos = record
    Line: int32;
    Column: int32;
  end;

  /// A span of a text editor's text, from its first place up to its last.
  UITextSpan = record
    First: UITextPos;
    Last: UITextPos;
  end;

  /// One filter of a file browser's list: the name it shows ("Images") and its patterns,
  /// `;`-separated ("*.png;*.jpg"; "" for every file).
  UIFileFilter = record
    Name: string;
    Patterns: string;
  end;

  /// The drawing a `UICustom`'s paint closure gets, in the widget's own units from its
  /// top-left corner: valid during that call only (a painter kept past it draws nothing
  /// Raven shows). C: RPainter, Rdraw_*
  /// @example `LBox.OnPaint(func(const P: UIPainter; const AWidth: float32; const AHeight: float32) begin P.Rect(UIRect(x: 0.0f, y: 0.0f, w: AWidth, h: AHeight), UIColor.FromRGBA(40, 44, 52), 8.0f); end);`
  UIPainter = object
    hidden FPainter: ptr to RPainter;

    /// An empty painter (draws nothing), as a variable declared with no arguments starts.
    init();
    begin
      self.FPainter := nil;
    end;

    /// The painter of Raven's `APainter` (a paint callback's own, for System.Raven.C code).
    static method Of(const APainter: ptr to RPainter): UIPainter;
    var
      LPainter: UIPainter;
    begin
      LPainter.FPainter := APainter;
      return LPainter;
    end;

    /// `true` when it names a painter (inside a paint closure).
    const method IsValid(): bool;
    begin
      return self.FPainter <> nil;
    end;

    /// `ARect` filled with `AColor`, its corners rounded by `ARadius` (0: square). C: Rdraw_rect
    const method Rect(const ARect: UIRect; const AColor: UIColor; const ARadius: float32);
    begin
      Rdraw_rect(self.FPainter, ARect.x, ARect.y, ARect.w, ARect.h, ARadius, AColor.r, AColor.g,
        AColor.b, AColor.a);
    end;

    /// `ARect`'s outline, `AWidth` wide, in `AColor`, its corners rounded by `ARadius`.
    /// C: Rdraw_rect_outline
    const method RectOutline(const ARect: UIRect; const AWidth: float32; const AColor: UIColor;
      const ARadius: float32);
    begin
      Rdraw_rect_outline(self.FPainter, ARect.x, ARect.y, ARect.w, ARect.h, ARadius, AWidth,
        AColor.r, AColor.g, AColor.b, AColor.a);
    end;

    /// A soft shadow of `ARect` (corners rounded by `ARadius`), blurred over `ABlur` units, in
    /// `AColor`. C: Rdraw_shadow
    const method Shadow(const ARect: UIRect; const ABlur: float32; const AColor: UIColor;
      const ARadius: float32);
    begin
      Rdraw_shadow(self.FPainter, ARect.x, ARect.y, ARect.w, ARect.h, ARadius, ABlur, AColor.r,
        AColor.g, AColor.b, AColor.a);
    end;

    /// A filled circle around `ACenter`. C: Rdraw_circle
    const method Circle(const ACenter: UIPoint; const ARadius: float32; const AColor: UIColor);
    begin
      Rdraw_circle(self.FPainter, ACenter.x, ACenter.y, ARadius, AColor.r, AColor.g, AColor.b,
        AColor.a);
    end;

    /// A straight line from `AFrom` to `ATo`, `AWidth` wide. C: Rdraw_line
    const method Line(const AFrom: UIPoint; const ATo: UIPoint; const AWidth: float32;
      const AColor: UIColor);
    begin
      Rdraw_line(self.FPainter, AFrom.x, AFrom.y, ATo.x, ATo.y, AWidth, AColor.r, AColor.g,
        AColor.b, AColor.a);
    end;

    /// A cubic Bezier curve from `AFrom` to `ATo` pulled by `AControl1` and `AControl2`,
    /// `AWidth` wide. C: Rdraw_curve
    const method Curve(const AFrom: UIPoint; const AControl1: UIPoint; const AControl2: UIPoint;
      const ATo: UIPoint; const AWidth: float32; const AColor: UIColor);
    begin
      Rdraw_curve(self.FPainter, AFrom.x, AFrom.y, AControl1.x, AControl1.y, AControl2.x,
        AControl2.y, ATo.x, ATo.y, AWidth, AColor.r, AColor.g, AColor.b, AColor.a);
    end;

    /// A filled triangle with the corners `AFirst`, `ASecond` and `AThird`. C: Rdraw_triangle
    const method Triangle(const AFirst: UIPoint; const ASecond: UIPoint; const AThird: UIPoint;
      const AColor: UIColor);
    begin
      Rdraw_triangle(self.FPainter, AFirst.x, AFirst.y, ASecond.x, ASecond.y, AThird.x, AThird.y,
        AColor.r, AColor.g, AColor.b, AColor.a);
    end;

    /// `ARect` as frosted glass over what is behind it, tinted `AColor`, its corners rounded
    /// by `ARadius`. C: Rdraw_glass
    const method Glass(const ARect: UIRect; const ARadius: float32; const AColor: UIColor);
    begin
      Rdraw_glass(self.FPainter, ARect.x, ARect.y, ARect.w, ARect.h, ARadius, AColor.r, AColor.g,
        AColor.b, AColor.a);
    end;

    /// `ASpring` moved one frame toward `ATarget` as `AMotion` eases (the widget is drawn
    /// again while it moves). C: Rdraw_spring
    /// @returns the spring's value this frame
    const method Spring(var ASpring: RSpring; const ATarget: float32; const AMotion: UIMotion): float32;
    begin
      return Rdraw_spring(self.FPainter, addr of ASpring, ATarget, int32(AMotion));
    end;

    /// What is drawn from now on clipped to `ARect` (inside the clip already in place), until
    /// `PopClip`. C: Rdraw_push_clip_rect
    const method PushClip(const ARect: UIRect);
    begin
      Rdraw_push_clip_rect(self.FPainter, ARect.x, ARect.y, ARect.w, ARect.h);
    end;

    /// The clip before the last `PushClip` back. C: Rdraw_pop_clip_rect
    const method PopClip();
    begin
      Rdraw_pop_clip_rect(self.FPainter);
    end;

    /// `ATexture` stretched to `ARect`, multiplied by `ATint` (white: its own colours).
    /// C: Rdraw_image
    const method Image(const ATexture: UITextureRes; const ARect: UIRect; const ATint: UIColor);
    begin
      Rdraw_image(self.FPainter, ATexture.Id(), ARect.x, ARect.y, ARect.w, ARect.h, ATint.r,
        ATint.g, ATint.b, ATint.a);
    end;

    /// `AText` (UTF-8) in `AFont` (an empty handle: the theme's) at the size `ASize` (0: the
    /// theme's), the first line's top-left corner at `AAt`, in `AColor`. C: Rdraw_text
    const method Text(const AFont: UIFontRes; const ASize: float32; const AAt: UIPoint;
      const AColor: UIColor; const AText: string);
    begin
      Rdraw_text(self.FPainter, AFont.Id(), ASize, AAt.x, AAt.y, AText, AColor.r, AColor.g,
        AColor.b, AColor.a);
    end;

    /// `AShader` drawn over `ARect` with the look `ALook`. C: Rdraw_shader
    const method Shader(const AShader: UIShaderRes; const ARect: UIRect;
      const ALook: RShaderLook);
    begin
      Rdraw_shader(self.FPainter, AShader.Id(), ARect.x, ARect.y, ARect.w, ARect.h,
        addr of ALook);
    end;
  end;

  /// What a text editor's hover closure gets: the line and column under the pointer; it
  /// returns the tooltip shown there ("" for none).
  UIHoverFunc = ref func(const ALine: int32; const AColumn: int32): string;

  /// What a viewport's draw closure gets each frame: where to draw and the backend's handles.
  UIViewportDrawFunc = ref func(const AInfo: RViewportDrawInfo);

  /// What a custom widget's paint closure gets: its painter and its size.
  UIPaintFunc = ref func(const APainter: UIPainter; const AWidth: float32; const AHeight: float32);

  /// What a custom widget's measure closure gets: the size it wants, to set (it starts at 0 x 0;
  /// the widget is never smaller than its children).
  UIMeasureFunc = ref func(var ASize: UISize);

const
  // GHeldTexts' event of a text editor's hover text (after V5's items, headers, drag data)
  ADAM_RAVEN_HELD_HOVER: int32 = 3;
  // GControlTexts' second event of a file browser: its selection moved (event 0: a file
  // accepted)
  ADAM_RAVEN_BROWSER_SELECT: int32 = 1;

var
  // V6's closures by (widget, event), released with the widget or the app as V5's
  GHovers: UISlots<UIHoverFunc>;
  GViewportDraws: UISlots<UIViewportDrawFunc>;
  GViewportResizes: UISlots<UIResizeFunc>;
  GPaints: UISlots<UIPaintFunc>;
  GMeasures: UISlots<UIMeasureFunc>;

// The closures AWidget's editors and views held released, with its held hover text
// (R_INVALID_ID: every one, the app ends)
func DoDropEditorControls(const AWidget: Rid);
begin
  if AWidget = R_INVALID_ID then
    GHovers.DropAll();
    GViewportDraws.DropAll();
    GViewportResizes.DropAll();
    GPaints.DropAll();
    GMeasures.DropAll();
    return;
  end;
  GHovers.DropOwner(AWidget);
  GViewportDraws.DropOwner(AWidget);
  GViewportResizes.DropOwner(AWidget);
  GPaints.DropOwner(AWidget);
  GMeasures.DropOwner(AWidget);
  GHeldTexts.Remove((uint64(AWidget) shl 8) | uint64(ADAM_RAVEN_HELD_HOVER));
end;

// V6's trampolines, as V5's: each runs its closure on a copy; a closure the table no longer
// holds (its widget gone) is never reached
func clink DoOnHover(editor: Rid; line: int32; column: int32; user_data: ptr): ptr to const char;
var
  LFunc: UIHoverFunc;
  LText: string;
  LHeld: CStringArray;
begin
  if not GHovers.Find(user_data, LFunc) or (LFunc = nil) then
    return nil;
  end;
  LText := LFunc(line, column);
  LHeld := DoHoldTexts(user_data, [LText]);
  return LHeld.Item[0];
end;

func clink DoOnBrowserCancel(browser: Rid; path: ptr to const char; user_data: ptr);
var
  LFunc: UITaskFunc;
begin
  if not GControlTasks.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc();
end;

func clink DoOnViewportDraw(info: ptr to const RViewportDrawInfo; user_data: ptr);
var
  LFunc: UIViewportDrawFunc;
begin
  if not GViewportDraws.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(info^);
end;

func clink DoOnViewportResize(viewport: Rid; width: int32; height: int32; user_data: ptr);
var
  LFunc: UIResizeFunc;
begin
  if not GViewportResizes.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(width, height);
end;

func clink DoOnPaint(widget: Rid; painter: ptr to RPainter; width: float32; height: float32;
  user_data: ptr);
var
  LFunc: UIPaintFunc;
begin
  if not GPaints.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIPainter.Of(painter), width, height);
end;

func clink DoOnMeasure(widget: Rid; width: ptr to float32; height: ptr to float32; user_data: ptr);
var
  LFunc: UIMeasureFunc;
  LSize: UISize;
begin
  if not GMeasures.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LSize := UISize(w: width^, h: height^);
  LFunc(LSize);
  width^ := LSize.w;
  height^ := LSize.h;
end;

public type
  /// A text / code editor: lines, a cursor and a selection, undo, syntax colouring by a
  /// registered language, word completion, markers (errors, warnings) and tooltips. Its text
  /// is `UIWidget.Text`. C: Rtext_editor_*
  /// @example `LCode := UITextEditor.Create("begin\nend.").Language("adam").LineNumbers(true);`
  UITextEditor = object(UIWidget)
    /// A new editor holding `AText` ("" for an empty one). C: Rtext_editor_create
    static method Create(const AText: string): UITextEditor;
    var
      LWidget: UITextEditor;
    begin
      LWidget.DoSet(Rtext_editor_create(AText));
      return LWidget;
    end;

    /// The kind a text editor views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.TextEditor];
    end;

    /// The text's length in bytes (UTF-8). C: Rtext_editor_get_length
    const method Length(): int32;
    begin
      return Rtext_editor_get_length(self.FId);
    end;

    /// The lines it has (an empty text has one). C: Rtext_editor_get_line_count
    const method LineCount(): int32;
    begin
      return Rtext_editor_get_line_count(self.FId);
    end;

    /// The text of the line `ALine` (from 0), with no line break ("" past the last).
    /// C: Rtext_editor_get_line
    const method Line(const ALine: int32): string;
    begin
      return DoRavenText(Rtext_editor_get_line(self.FId, ALine));
    end;

    /// `AText` typed in at the cursor (replacing the selection), as one undo step.
    /// C: Rtext_editor_insert_text
    const method Insert(const AText: string): self;
    begin
      Rtext_editor_insert_text(self.FId, AText);
      return self;
    end;

    /// The cursor put at `APos` (kept inside the text), the selection gone.
    /// C: Rtext_editor_set_cursor
    const method Cursor(const APos: UITextPos): self;
    begin
      Rtext_editor_set_cursor(self.FId, APos.Line, APos.Column);
      return self;
    end;

    /// Where the cursor is. C: Rtext_editor_get_cursor
    const method Cursor(): UITextPos;
    var
      LLine: int32;
      LColumn: int32;
    begin
      Rtext_editor_get_cursor(self.FId, addr of LLine, addr of LColumn);
      return UITextPos(Line: LLine, Column: LColumn);
    end;

    /// The text from `ASpan.First` up to `ASpan.Last` selected (the cursor at its last place).
    /// C: Rtext_editor_select
    const method Select(const ASpan: UITextSpan): self;
    begin
      Rtext_editor_select(self.FId, ASpan.First.Line, ASpan.First.Column, ASpan.Last.Line,
        ASpan.Last.Column);
      return self;
    end;

    /// The whole text selected. C: Rtext_editor_select_all
    const method SelectAll(): self;
    begin
      Rtext_editor_select_all(self.FId);
      return self;
    end;

    /// The selection, its first place before its last (both the cursor when nothing is
    /// selected: `HasSelection`). C: Rtext_editor_get_selection
    const method Selection(): UITextSpan;
    var
      LSpan: UITextSpan;
    begin
      Rtext_editor_get_selection(self.FId, addr of LSpan.First.Line, addr of LSpan.First.Column,
        addr of LSpan.Last.Line, addr of LSpan.Last.Column);
      return LSpan;
    end;

    /// `true` when some text is selected. C: Rtext_editor_get_selection
    const method HasSelection(): bool;
    var
      LSpan: UITextSpan;
    begin
      return Rtext_editor_get_selection(self.FId, addr of LSpan.First.Line,
        addr of LSpan.First.Column, addr of LSpan.Last.Line, addr of LSpan.Last.Column) <> 0;
    end;

    /// The selected text ("" for none). C: Rtext_editor_get_selected_text
    const method SelectedText(): string;
    begin
      return DoRavenText(Rtext_editor_get_selected_text(self.FId));
    end;

    /// Scrolled so the line `ALine` shows. C: Rtext_editor_scroll_to_line
    const method ScrollToLine(const ALine: int32): self;
    begin
      Rtext_editor_scroll_to_line(self.FId, ALine);
      return self;
    end;

    /// The last edit taken back. C: Rtext_editor_undo
    const method Undo(): self;
    begin
      Rtext_editor_undo(self.FId);
      return self;
    end;

    /// The last edit taken back made again. C: Rtext_editor_redo
    const method Redo(): self;
    begin
      Rtext_editor_redo(self.FId);
      return self;
    end;

    /// `true` when there is an edit to take back. C: Rtext_editor_can_undo
    const method CanUndo(): bool;
    begin
      return Rtext_editor_can_undo(self.FId) <> 0;
    end;

    /// `true` when there is an undone edit to make again. C: Rtext_editor_can_redo
    const method CanRedo(): bool;
    begin
      return Rtext_editor_can_redo(self.FId) <> 0;
    end;

    /// The text can be read and selected but not changed by the user (`AOn`).
    /// C: Rtext_editor_set_read_only
    const method ReadOnly(const AOn: bool): self;
    begin
      Rtext_editor_set_read_only(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Long lines wrap at the editor's width (`AOn`) rather than scroll across.
    /// C: Rtext_editor_set_word_wrap
    const method WordWrap(const AOn: bool): self;
    begin
      Rtext_editor_set_word_wrap(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Line numbers shown in a gutter (`AOn`). C: Rtext_editor_set_line_numbers
    const method LineNumbers(const AOn: bool): self;
    begin
      Rtext_editor_set_line_numbers(self.FId, DoCBool(AOn));
      return self;
    end;

    /// A tab is `ASpaces` columns wide. C: Rtext_editor_set_tab_size
    const method TabSize(const ASpaces: int32): self;
    begin
      Rtext_editor_set_tab_size(self.FId, ASpaces);
      return self;
    end;

    /// The Tab key types spaces up to the next tab stop (`AOn`) rather than a tab.
    /// C: Rtext_editor_set_tab_inserts_spaces
    const method TabSpaces(const AOn: bool): self;
    begin
      Rtext_editor_set_tab_inserts_spaces(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Coloured by one of Raven's built-in syntaxes (`Language` names any registered one).
    /// C: Rtext_editor_set_syntax
    const method Syntax(const ASyntax: UISyntax): self;
    begin
      Rtext_editor_set_syntax(self.FId, int32(ASyntax));
      return self;
    end;

    /// Coloured as the registered language `AName` ("" or an unknown name: plain text).
    /// C: Rtext_editor_set_language
    const method Language(const AName: string): self;
    begin
      Rtext_editor_set_language(self.FId, AName);
      return self;
    end;

    /// The language it is coloured as ("" for plain text). C: Rtext_editor_get_language
    const method Language(): string;
    begin
      return DoRavenText(Rtext_editor_get_language(self.FId));
    end;

    /// The text shown, dimmed, while the editor is empty. C: Rtext_editor_set_placeholder
    const method Placeholder(const AText: string): self;
    begin
      Rtext_editor_set_placeholder(self.FId, AText);
      return self;
    end;

    /// The text drawn at `AZoom` times its size (1: as the theme says).
    /// C: Rtext_editor_set_zoom
    const method Zoom(const AZoom: float32): self;
    begin
      Rtext_editor_set_zoom(self.FId, AZoom);
      return self;
    end;

    /// C: Rtext_editor_get_zoom
    const method Zoom(): float32;
    begin
      return Rtext_editor_get_zoom(self.FId);
    end;

    /// The user may zoom with Ctrl + the wheel or Ctrl +/- (`AOn`).
    /// C: Rtext_editor_set_zoomable
    const method Zoomable(const AOn: bool): self;
    begin
      Rtext_editor_set_zoomable(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Markdown shown styled as it is typed (`AOn`): headings, strong, emphasis, links.
    /// C: Rtext_editor_set_markdown
    const method Markdown(const AOn: bool): self;
    begin
      Rtext_editor_set_markdown(self.FId, DoCBool(AOn));
      return self;
    end;

    /// C: Rtext_editor_get_markdown
    const method Markdown(): bool;
    begin
      return Rtext_editor_get_markdown(self.FId) <> 0;
    end;

    /// What the colouring found at `APos` (a keyword, a string, a comment ..).
    /// C: Rtext_editor_get_token
    const method Token(const APos: UITextPos): UITokenKind;
    begin
      return UITokenKind(Rtext_editor_get_token(self.FId, APos.Line, APos.Column));
    end;

    /// Completion offered as the user types (`AOn`): the words `AddCompletion` gave, those
    /// of the text (`CompletionWords`) and the language's keywords. C: Rtext_editor_set_completion
    const method Completion(const AOn: bool): self;
    begin
      Rtext_editor_set_completion(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The completion list opened at the cursor now. C: Rtext_editor_show_completions
    const method ShowCompletions(): self;
    begin
      Rtext_editor_show_completions(self.FId);
      return self;
    end;

    /// `true` while the completion list is open. C: Rtext_editor_is_completing
    const method Completing(): bool;
    begin
      return Rtext_editor_is_completing(self.FId) <> 0;
    end;

    /// `AText` offered in the completion list, `ADetail` beside it ("" for none); best
    /// added from `OnCompletion`, which runs as the list opens. C: Rtext_editor_add_completion
    const method AddCompletion(const AText: string; const ADetail: string): self;
    begin
      Rtext_editor_add_completion(self.FId, AText, ADetail);
      return self;
    end;

    /// `AText` offered in the completion list, `ADetail` beside it, `AInsert` typed in when
    /// it is picked (a snippet). C: Rtext_editor_add_completion_insert
    const method AddCompletion(const AText: string; const ADetail: string; const AInsert: string): self;
    begin
      Rtext_editor_add_completion_insert(self.FId, AText, ADetail, AInsert);
      return self;
    end;

    /// The words of the text itself offered in the completion list (`AOn`).
    /// C: Rtext_editor_set_completion_words
    const method CompletionWords(const AOn: bool): self;
    begin
      Rtext_editor_set_completion_words(self.FId, DoCBool(AOn));
      return self;
    end;

    /// A bracket or quote typed gets its closing one (`AOn`). C: Rtext_editor_set_auto_pairs
    const method AutoPairs(const AOn: bool): self;
    begin
      Rtext_editor_set_auto_pairs(self.FId, DoCBool(AOn));
      return self;
    end;

    /// A marker of the kind `AKind` under the line `ALine` from the column `AFirst` up to
    /// `ALast`, `AText` its tooltip. C: Rtext_editor_add_marker
    const method AddMarker(const ALine: int32; const AFirst: int32; const ALast: int32;
      const AKind: UIMarkKind; const AText: string): self;
    begin
      Rtext_editor_add_marker(self.FId, ALine, AFirst, ALast, int32(AKind), AText);
      return self;
    end;

    /// Every marker removed. C: Rtext_editor_clear_markers
    const method ClearMarkers(): self;
    begin
      Rtext_editor_clear_markers(self.FId);
      return self;
    end;

    /// The markers it has. C: Rtext_editor_get_marker_count
    const method MarkerCount(): int32;
    begin
      return Rtext_editor_get_marker_count(self.FId);
    end;

    /// Runs `AFunc` with the zoom when the user zooms. C: Rtext_editor_set_zoom_callback
    const method OnZoom(const AFunc: UIValueFunc): self;
    begin
      if AFunc = nil then
        GControlValues.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtext_editor_set_zoom_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtext_editor_set_zoom_callback(self.FId, DoOnControlValue,
        GControlValues.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the word typed so far as the completion list opens: it adds the
    /// words to offer (`AddCompletion`). C: Rtext_editor_set_completion_callback
    const method OnCompletion(const AFunc: UITextFunc): self;
    begin
      if AFunc = nil then
        GControlTexts.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtext_editor_set_completion_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtext_editor_set_completion_callback(self.FId, DoOnControlText,
        GControlTexts.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the line and column under the pointer resting on text with no
    /// marker: the text it returns is the tooltip ("" for none). C: Rtext_editor_set_hover_callback
    const method OnHover(const AFunc: UIHoverFunc): self;
    begin
      if AFunc = nil then
        GHovers.Clear(self.FId, ADAM_RAVEN_HELD_HOVER);
        GHeldTexts.Remove((uint64(self.FId) shl 8) | uint64(ADAM_RAVEN_HELD_HOVER));
        Rtext_editor_set_hover_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtext_editor_set_hover_callback(self.FId, DoOnHover,
        GHovers.Put(self.FId, ADAM_RAVEN_HELD_HOVER, AFunc));
      return self;
    end;

    /// Runs `AFunc` whenever the text changes (typed, pasted, undone or set).
    /// C: Rtext_editor_set_changed_callback
    const method OnChanged(const AFunc: UITaskFunc): self;
    begin
      if AFunc = nil then
        GControlTasks.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtext_editor_set_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtext_editor_set_changed_callback(self.FId, DoOnControlTask,
        GControlTasks.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// The editor's own font at the size `ASize` (0: the theme's font size); an empty handle:
    /// the theme's font, or the fixed-width one with a language. Kept while it is set.
    /// C: Rtext_editor_set_font
    const method Font(const AFont: UIFontRes; const ASize: float32): self;
    begin
      Rtext_editor_set_font(self.FId, AFont.Id(), ASize);
      DoHookDestroy(self.FId);
      DoKeepFont(self.FId, ADAM_RAVEN_KEEP_OWN_FONT, AFont);
      return self;
    end;
  end;

  /// A file picker inside a window: a folder's list with places, a path bar, a name field
  /// and the Open / Save / Cancel buttons (the system's own file dialog is apart).
  /// C: Rfile_browser_*
  /// @example `LPick := UIFileBrowser.Create().Mode(UIBrowserMode.Open).OnAccept(func(const APath: string) begin Load(APath); end);`
  UIFileBrowser = object(UIWidget)
    /// A new browser opening files in the working folder. C: Rfile_browser_create
    static method Create(): UIFileBrowser;
    var
      LWidget: UIFileBrowser;
    begin
      LWidget.DoSet(Rfile_browser_create());
      return LWidget;
    end;

    /// The kind a file browser views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.FileBrowser];
    end;

    /// What it picks: a file to open, a file to save or a folder. C: Rfile_browser_set_mode
    const method Mode(const AMode: UIBrowserMode): self;
    begin
      Rfile_browser_set_mode(self.FId, int32(AMode));
      return self;
    end;

    /// Shows the folder `APath`.
    /// @returns `false` when it cannot be read (the browser stays where it was).
    /// C: Rfile_browser_set_directory
    const method Directory(const APath: string): bool;
    begin
      return Rfile_browser_set_directory(self.FId, APath) <> 0;
    end;

    /// The folder it shows. C: Rfile_browser_get_directory
    const method Directory(): string;
    begin
      return DoRavenText(Rfile_browser_get_directory(self.FId));
    end;

    /// The folder read again (files added or removed outside). C: Rfile_browser_refresh
    const method Refresh(): self;
    begin
      Rfile_browser_refresh(self.FId);
      return self;
    end;

    /// The filters its list offers, the first one active (none: every file).
    /// C: Rfile_browser_set_filters
    const method Filters(const AFilters: array of UIFileFilter): self;
    var
      LTexts: array of CString;
      LFilters: array of RFileFilter;
      LI: int64;
    begin
      if len(AFilters) = 0 then
        Rfile_browser_set_filters(self.FId, nil, 0);
        return self;
      end;
      // the texts kept as C strings while Raven copies them; "" patterns: every file
      setlength(LTexts, len(AFilters) * 2);
      setlength(LFilters, len(AFilters));
      for LI := 0 to len(AFilters) - 1 do
        LTexts[LI * 2] := CString(AFilters[LI].Name);
        LTexts[LI * 2 + 1] := CString(AFilters[LI].Patterns);
        LFilters[LI].name := LTexts[LI * 2].Ptr;
        LFilters[LI].patterns := LTexts[LI * 2 + 1].OrNil;
      end;
      Rfile_browser_set_filters(self.FId, addr of LFilters[0], int32(len(LFilters)));
      return self;
    end;

    /// Hidden files and folders listed (`AOn`). C: Rfile_browser_set_show_hidden
    const method ShowHidden(const AOn: bool): self;
    begin
      Rfile_browser_set_show_hidden(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Several files may be picked at once (`AOn`; open mode). C: Rfile_browser_set_multiple
    const method Multiple(const AOn: bool): self;
    begin
      Rfile_browser_set_multiple(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Its name field and buttons shown (`AOn`), or only the list (a browser inside a
    /// bigger form). C: Rfile_browser_set_controls_visible
    const method ControlsVisible(const AOn: bool): self;
    begin
      Rfile_browser_set_controls_visible(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Its places column (home, drives, recent folders) shown (`AOn`).
    /// C: Rfile_browser_set_places_visible
    const method PlacesVisible(const AOn: bool): self;
    begin
      Rfile_browser_set_places_visible(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The name in its name field (save mode: the file to save). C: Rfile_browser_set_file_name
    const method FileName(const AName: string): self;
    begin
      Rfile_browser_set_file_name(self.FId, AName);
      return self;
    end;

    /// The extension a saved name with none gets ("txt"; "": the active filter's first).
    /// C: Rfile_browser_set_default_extension
    const method DefaultExtension(const AExtension: string): self;
    begin
      Rfile_browser_set_default_extension(self.FId, AExtension);
      return self;
    end;

    /// The entries picked in its list. C: Rfile_browser_get_selection_count
    const method SelectionCount(): int32;
    begin
      return Rfile_browser_get_selection_count(self.FId);
    end;

    /// The full path of the picked entry `AIndex` ("" past the last).
    /// C: Rfile_browser_get_selection
    const method Selection(const AIndex: int32): string;
    begin
      return DoRavenText(Rfile_browser_get_selection(self.FId, AIndex));
    end;

    /// The entry named `AName` in the folder shown picked (the others no longer).
    /// C: Rfile_browser_select
    const method Select(const AName: string): self;
    begin
      Rfile_browser_select(self.FId, AName);
      return self;
    end;

    /// Runs `AFunc` with the full path when the user accepts (Open / Save, Enter, a double
    /// click; with several picked, once for each). C: Rfile_browser_set_accepted_callback
    const method OnAccept(const AFunc: UITextFunc): self;
    begin
      if AFunc = nil then
        GControlTexts.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rfile_browser_set_accepted_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rfile_browser_set_accepted_callback(self.FId, DoOnControlText,
        GControlTexts.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` when the user cancels (Cancel, Escape).
    /// C: Rfile_browser_set_cancelled_callback
    const method OnCancel(const AFunc: UITaskFunc): self;
    begin
      if AFunc = nil then
        GControlTasks.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rfile_browser_set_cancelled_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rfile_browser_set_cancelled_callback(self.FId, DoOnBrowserCancel,
        GControlTasks.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the full path of the entry the user moves the selection to.
    /// C: Rfile_browser_set_selection_changed_callback
    const method OnSelect(const AFunc: UITextFunc): self;
    begin
      if AFunc = nil then
        GControlTexts.Clear(self.FId, ADAM_RAVEN_BROWSER_SELECT);
        Rfile_browser_set_selection_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rfile_browser_set_selection_changed_callback(self.FId, DoOnControlText,
        GControlTexts.Put(self.FId, ADAM_RAVEN_BROWSER_SELECT, AFunc));
      return self;
    end;
  end;

  /// A rectangle the app's own renderer draws: a texture it rendered, its draw closure
  /// each frame with the backend's handles, or a native child window. C: Rviewport_*
  /// @example `LView := UIViewport.Create().Realtime(true).OnResize(func(const AWidth: int32; const AHeight: int32) begin Resize(AWidth, AHeight); end);`
  UIViewport = object(UIWidget)
    /// A new viewport showing nothing yet. C: Rwidget_create(R_WIDGET_VIEWPORT)
    static method Create(): UIViewport;
    var
      LWidget: UIViewport;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Viewport)));
      return LWidget;
    end;

    /// The kind a viewport views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Viewport];
    end;

    /// How its texture fits its rectangle. C: Rviewport_set_stretch
    const method Stretch(const AStretch: UIStretch): self;
    begin
      Rviewport_set_stretch(self.FId, int32(AStretch));
      return self;
    end;

    /// Its texture drawn upside down (`AOn`; a bottom-up render target). C: Rviewport_set_flip_y
    const method FlipY(const AOn: bool): self;
    begin
      Rviewport_set_flip_y(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The window drawn every frame while it shows (`AOn`; a game, a 3D view), not only
    /// when something changed. C: Rviewport_set_realtime
    const method Realtime(const AOn: bool): self;
    begin
      Rviewport_set_realtime(self.FId, DoCBool(AOn));
      return self;
    end;

    /// A native child window in its rectangle (`AOn`), for a renderer that draws into a
    /// window of its own (`NativeHandle`).
    /// @returns `false` when the system or the backend has none (headless).
    /// C: Rviewport_set_native
    const method Native(const AOn: bool): bool;
    begin
      return Rviewport_set_native(self.FId, DoCBool(AOn)) <> 0;
    end;

    /// The native child window (HWND, X11 Window, wl_surface ..) into `ANative`.
    /// @returns `false` when it has none (`Native` off, headless). C: Rviewport_get_native_handle
    const method NativeHandle(var ANative: RNativeWindow): bool;
    begin
      return Rviewport_get_native_handle(self.FId, addr of ANative) <> 0;
    end;

    /// Its size in the window's pixels (its rectangle times the window's scale).
    /// C: Rviewport_get_pixel_size
    const method PixelSize(): UISize;
    var
      LWidth: int32;
      LHeight: int32;
    begin
      Rviewport_get_pixel_size(self.FId, addr of LWidth, addr of LHeight);
      return UISize(w: float32(LWidth), h: float32(LHeight));
    end;

    /// Runs `AFunc` each frame it is drawn, inside the window's render pass: where to draw
    /// and the backend's own handles (command buffer, render pass ..).
    /// C: Rviewport_set_draw_callback
    const method OnDraw(const AFunc: UIViewportDrawFunc): self;
    begin
      if AFunc = nil then
        GViewportDraws.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rviewport_set_draw_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rviewport_set_draw_callback(self.FId, DoOnViewportDraw,
        GViewportDraws.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with its new size in pixels when it changes (a render target to remake).
    /// C: Rviewport_set_resize_callback
    const method OnResize(const AFunc: UIResizeFunc): self;
    begin
      if AFunc = nil then
        GViewportResizes.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rviewport_set_resize_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rviewport_set_resize_callback(self.FId, DoOnViewportResize,
        GViewportResizes.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// The texture it shows (mode 1: one the app renders into; an empty handle: nothing);
    /// kept while it is set. C: Rviewport_set_texture
    const method Texture(const ATexture: UITextureRes): self;
    begin
      Rviewport_set_texture(self.FId, ATexture.Id());
      DoHookDestroy(self.FId);
      DoKeepTexture(self.FId, ADAM_RAVEN_KEEP_TEXTURE, ATexture);
      return self;
    end;
  end;

  /// A widget the app draws itself: its paint closure gets a `UIPainter` each time it is
  /// drawn, its measure closure says the size it wants; it may hold children too.
  /// C: Rwidget_create(R_WIDGET_CUSTOM), Rcustom_*
  /// @example `LDial := UICustom.Create().OnPaint(func(const P: UIPainter; const AWidth: float32; const AHeight: float32) begin P.Circle(UIPoint(x: AWidth / 2.0f, y: AHeight / 2.0f), 20.0f, UIColor.FromRGBA(58, 123, 213)); end);`
  UICustom = object(UIWidget)
    /// A new custom widget that draws nothing yet. C: Rwidget_create(R_WIDGET_CUSTOM)
    static method Create(): UICustom;
    var
      LWidget: UICustom;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Custom)));
      return LWidget;
    end;

    /// The kind a custom widget views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Custom];
    end;

    /// Runs `AFunc` each time the widget is drawn, with its painter (valid in the call only)
    /// and its size. C: Rcustom_set_paint_callback
    const method OnPaint(const AFunc: UIPaintFunc): self;
    begin
      if AFunc = nil then
        GPaints.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rcustom_set_paint_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rcustom_set_paint_callback(self.FId, DoOnPaint,
        GPaints.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` when the layout asks the size the widget wants: it sets the size (it
    /// starts at 0 x 0; the widget is never smaller than its children).
    /// C: Rcustom_set_measure_callback
    const method OnMeasure(const AFunc: UIMeasureFunc): self;
    begin
      if AFunc = nil then
        GMeasures.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rcustom_set_measure_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rcustom_set_measure_callback(self.FId, DoOnMeasure,
        GMeasures.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// Pages shown one at a time, sliding from one to the next: its children are the pages;
  /// arrows, dots, autoplay and looping as set. C: Rcarousel_*
  /// @example `LShow := UICarousel.Create().Add(LPage1).Add(LPage2).Loop(true).Autoplay(4.0);`
  UICarousel = object(UIWidget)
    /// A new carousel with no pages. C: Rcarousel_create
    static method Create(): UICarousel;
    var
      LWidget: UICarousel;
    begin
      LWidget.DoSet(Rcarousel_create());
      return LWidget;
    end;

    /// The kind a carousel views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Carousel];
    end;

    /// The page `APage` (from 0) shown, sliding there when `AAnimated`.
    /// C: Rcarousel_set_page
    const method Page(const APage: int32; const AAnimated: bool): self;
    begin
      Rcarousel_set_page(self.FId, APage, DoCBool(AAnimated));
      return self;
    end;

    /// The page it shows. C: Rcarousel_get_page
    const method Page(): int32;
    begin
      return Rcarousel_get_page(self.FId);
    end;

    /// The pages it has. C: Rcarousel_get_page_count
    const method PageCount(): int32;
    begin
      return Rcarousel_get_page_count(self.FId);
    end;

    /// The next page shown (after the last: the first when it loops). C: Rcarousel_next
    const method Next(): self;
    begin
      Rcarousel_next(self.FId);
      return self;
    end;

    /// The page before shown (before the first: the last when it loops). C: Rcarousel_prev
    const method Prev(): self;
    begin
      Rcarousel_prev(self.FId);
      return self;
    end;

    /// Going past the last page comes back to the first, and before the first to the last
    /// (`AOn`). C: Rcarousel_set_loop
    const method Loop(const AOn: bool): self;
    begin
      Rcarousel_set_loop(self.FId, DoCBool(AOn));
      return self;
    end;

    /// C: Rcarousel_get_loop
    const method Loop(): bool;
    begin
      return Rcarousel_get_loop(self.FId) <> 0;
    end;

    /// The next page shown every `ASeconds` (0: never). C: Rcarousel_set_autoplay
    const method Autoplay(const ASeconds: float64): self;
    begin
      Rcarousel_set_autoplay(self.FId, ASeconds);
      return self;
    end;

    /// C: Rcarousel_get_autoplay
    const method Autoplay(): float64;
    begin
      return Rcarousel_get_autoplay(self.FId);
    end;

    /// A dot for each page shown (`AOn`). C: Rcarousel_set_indicators_visible
    const method Indicators(const AOn: bool): self;
    begin
      Rcarousel_set_indicators_visible(self.FId, DoCBool(AOn));
      return self;
    end;

    /// C: Rcarousel_get_indicators_visible
    const method Indicators(): bool;
    begin
      return Rcarousel_get_indicators_visible(self.FId) <> 0;
    end;

    /// Previous / next arrows shown (`AOn`). C: Rcarousel_set_arrows_visible
    const method Arrows(const AOn: bool): self;
    begin
      Rcarousel_set_arrows_visible(self.FId, DoCBool(AOn));
      return self;
    end;

    /// C: Rcarousel_get_arrows_visible
    const method Arrows(): bool;
    begin
      return Rcarousel_get_arrows_visible(self.FId) <> 0;
    end;

    /// The pages slide across (horizontal) or up and down (vertical).
    /// C: Rcarousel_set_orientation
    const method Orientation(const AOrientation: UIOrientation): self;
    begin
      Rcarousel_set_orientation(self.FId, int32(AOrientation));
      return self;
    end;

    /// C: Rcarousel_get_orientation
    const method Orientation(): UIOrientation;
    begin
      return UIOrientation(Rcarousel_get_orientation(self.FId));
    end;

    /// Runs `AFunc` with the page shown each time it changes.
    /// C: Rcarousel_set_page_changed_callback
    const method OnChanged(const AFunc: UIIndexFunc): self;
    begin
      if AFunc = nil then
        GControlIndexes.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rcarousel_set_page_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rcarousel_set_page_changed_callback(self.FId, DoOnControlIndex,
        GControlIndexes.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

// ============================================================================
// Charts, documents and maps (listing sec 6, V7). UIPlot (series of points
// on axes, drag lines), UIChart (pie / donut slices, a gauge's value and
// bands, a heatmap's cells, a sparkline's values), UIPDFView (a PDF shown
// through PDFium, when the system has it), UIMapView (tiles the program
// hands it, markers) and UIPDFDocRes (a PDF the program writes). The parts
// Raven addresses by index (a plot's series, axes and drag lines, a chart's
// slices) or by id (a map's markers) are value views: (the widget, the
// part), copied freely, never owners. Their closures live in the GControl*
// tables and the V7 tables below, released with the widget
// (DoDropChartControls). Raven runs them for the user's actions only: a
// change made through the API tells no closure. A PDF document's pictures and
// a map's tiles are pixels: Raven takes no texture there.
// ============================================================================

public type
  /// A point in a plot's data units.
  UIPlotPoint = record
    X: float64;
    Y: float64;
  end;

  /// A place on a map, in degrees: latitude (north positive) and longitude (east positive).
  UILatLon = record
    Latitude: float64;
    Longitude: float64;
  end;

  /// How a PDF is printed (Raven's `RPdfPrintDesc`): the window the print dialog belongs to
  /// (its `Id()`; `R_INVALID_ID`: none), the job's title ("": the document's), the printer ("": the one
  /// chosen, else the default), the copies (0: one), the flags, a file the job is written to
  /// instead of a printer ("": none) and a protected document's password.
  UIPrintDesc = record
    Window: Rid;
    Title: string;
    Printer: string;
    Copies: int32;
    Flags: UIPrintFlags;
    Output: string;
    Password: string;
  end;

  /// One series of a `UIPlot`: a view of (the plot, the series' index), copied freely.
  /// Removing a series moves the ones after it down by one. C: Rplot_*_series_*
  UIPlotSeries = object
    hidden FPlot: Rid;
    hidden FSeries: int32;

    /// An empty series handle (names none).
    init();
    begin
      self.FPlot := R_INVALID_ID;
      self.FSeries := -1;
    end;

    /// The series `ASeries` of the plot `APlot` (a Rid).
    static method Wrap(const APlot: Rid; const ASeries: int32): UIPlotSeries;
    var
      LSeries: UIPlotSeries;
    begin
      LSeries.FPlot := APlot;
      LSeries.FSeries := ASeries;
      return LSeries;
    end;

    /// The series' index (-1 when it names none).
    const method Index(): int32;
    begin
      return self.FSeries;
    end;

    /// `true` while the index is one of its plot's series. C: Rplot_get_series_count
    const method IsValid(): bool;
    begin
      return (self.FSeries >= 0) and (self.FSeries < Rplot_get_series_count(self.FPlot));
    end;

    /// The name the legend shows. C: Rplot_set_series_name
    const method Name(const AName: string): self;
    begin
      Rplot_set_series_name(self.FPlot, self.FSeries, AName);
      return self;
    end;

    /// C: Rplot_get_series_name
    const method Name(): string;
    begin
      return DoRavenText(Rplot_get_series_name(self.FPlot, self.FSeries));
    end;

    /// Its points: the pairs of `AX` and `AY` (as many as the shorter has), replacing the
    /// ones it had (copied). C: Rplot_set_series_data
    const method Data(const AX: array of float64; const AY: array of float64): self;
    var
      LCount: int64;
    begin
      LCount := len(AX);
      if len(AY) < LCount then
        LCount := len(AY);
      end;
      if LCount = 0 then
        Rplot_set_series_data(self.FPlot, self.FSeries, nil, nil, 0);
        return self;
      end;
      Rplot_set_series_data(self.FPlot, self.FSeries, addr of AX[0], addr of AY[0], int32(LCount));
      return self;
    end;

    /// The pairs of `AX` and `AY` (as many as the shorter has) added after its points
    /// (copied). C: Rplot_append_series_data
    const method Append(const AX: array of float64; const AY: array of float64): self;
    var
      LCount: int64;
    begin
      LCount := len(AX);
      if len(AY) < LCount then
        LCount := len(AY);
      end;
      if LCount = 0 then
        return self;
      end;
      Rplot_append_series_data(self.FPlot, self.FSeries, addr of AX[0], addr of AY[0], int32(LCount));
      return self;
    end;

    /// The point (`AX`, `AY`) added after its points. C: Rplot_add_point
    const method Add(const AX: float64; const AY: float64): self;
    begin
      Rplot_add_point(self.FPlot, self.FSeries, AX, AY);
      return self;
    end;

    /// Every point removed. C: Rplot_clear_series_data
    const method ClearData(): self;
    begin
      Rplot_clear_series_data(self.FPlot, self.FSeries);
      return self;
    end;

    /// The points it has. C: Rplot_get_point_count
    const method PointCount(): int32;
    begin
      return Rplot_get_point_count(self.FPlot, self.FSeries);
    end;

    /// Its point `AIndex` (from 0; 0, 0 for one it does not have). C: Rplot_get_point
    const method Point(const AIndex: int32): UIPlotPoint;
    var
      LPoint: UIPlotPoint;
    begin
      LPoint.X := 0.0;
      LPoint.Y := 0.0;
      if Rplot_get_point(self.FPlot, self.FSeries, AIndex, addr of LPoint.X, addr of LPoint.Y) = 0 then
        LPoint.X := 0.0;
        LPoint.Y := 0.0;
      end;
      return LPoint;
    end;

    /// At most `AMax` points kept, the oldest leaving first (0: no limit): a live feed.
    /// C: Rplot_set_series_max_points
    const method MaxPoints(const AMax: int32): self;
    begin
      Rplot_set_series_max_points(self.FPlot, self.FSeries, AMax);
      return self;
    end;

    /// Its colour (the theme's own until set). C: Rplot_set_series_color
    const method Color(const AColor: UIColor): self;
    begin
      Rplot_set_series_color(self.FPlot, self.FSeries, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// Its line's style and width in logical units. C: Rplot_set_series_line
    const method Line(const AStyle: UILineStyle; const AWidth: float32): self;
    begin
      Rplot_set_series_line(self.FPlot, self.FSeries, int32(AStyle), AWidth);
      return self;
    end;

    /// The marker drawn at each point and its size. C: Rplot_set_series_marker
    const method Marker(const AShape: UIMarkerShape; const ASize: float32): self;
    begin
      Rplot_set_series_marker(self.FPlot, self.FSeries, int32(AShape), ASize);
      return self;
    end;

    /// Its markers filled (`AOn`) or outlined. C: Rplot_set_series_marker_filled
    const method MarkerFilled(const AOn: bool): self;
    begin
      Rplot_set_series_marker_filled(self.FPlot, self.FSeries, DoCBool(AOn));
      return self;
    end;

    /// Its line drawn in steps (`AOn`) rather than straight from point to point.
    /// C: Rplot_set_series_step
    const method Step(const AOn: bool): self;
    begin
      Rplot_set_series_step(self.FPlot, self.FSeries, DoCBool(AOn));
      return self;
    end;

    /// The area under its line filled at `AOpacity` (0: none, 1: solid).
    /// C: Rplot_set_series_fill
    const method Fill(const AOpacity: float32): self;
    begin
      Rplot_set_series_fill(self.FPlot, self.FSeries, AOpacity);
      return self;
    end;

    /// The axes it is drawn against (`UIAxis.X` / `X2`, `UIAxis.Y` / `Y2`).
    /// C: Rplot_set_series_axes
    const method Axes(const AX: UIAxis; const AY: UIAxis): self;
    begin
      Rplot_set_series_axes(self.FPlot, self.FSeries, int32(AX), int32(AY));
      return self;
    end;

    /// Shown (`AOn`) or hidden (its legend entry stays). C: Rplot_set_series_visible
    const method Visible(const AOn: bool): self;
    begin
      Rplot_set_series_visible(self.FPlot, self.FSeries, DoCBool(AOn));
      return self;
    end;

    /// C: Rplot_is_series_visible
    const method Visible(): bool;
    begin
      return Rplot_is_series_visible(self.FPlot, self.FSeries) <> 0;
    end;

    /// The series removed from its plot (the ones after it move down by one).
    /// C: Rplot_remove_series
    const method Remove();
    begin
      Rplot_remove_series(self.FPlot, self.FSeries);
    end;
  end;

  /// One axis of a `UIPlot`: a view of (the plot, the axis), copied freely.
  /// C: Rplot_*_axis_*
  UIPlotAxis = object
    hidden FPlot: Rid;
    hidden FAxis: UIAxis;

    /// An empty axis handle (names no plot).
    init();
    begin
      self.FPlot := R_INVALID_ID;
      self.FAxis := UIAxis.X;
    end;

    /// The axis `AAxis` of the plot `APlot` (a Rid).
    static method Wrap(const APlot: Rid; const AAxis: UIAxis): UIPlotAxis;
    var
      LAxis: UIPlotAxis;
    begin
      LAxis.FPlot := APlot;
      LAxis.FAxis := AAxis;
      return LAxis;
    end;

    /// Which axis it is.
    const method Axis(): UIAxis;
    begin
      return self.FAxis;
    end;

    /// The text written along it. C: Rplot_set_axis_label
    const method Label(const ALabel: string): self;
    begin
      Rplot_set_axis_label(self.FPlot, int32(self.FAxis), ALabel);
      return self;
    end;

    /// C: Rplot_get_axis_label
    const method Label(): string;
    begin
      return DoRavenText(Rplot_get_axis_label(self.FPlot, int32(self.FAxis)));
    end;

    /// Its scale: linear, logarithmic, or symmetric logarithmic (linear near 0).
    /// C: Rplot_set_axis_scale
    const method Scale(const AScale: UIAxisScale): self;
    begin
      Rplot_set_axis_scale(self.FPlot, int32(self.FAxis), int32(AScale));
      return self;
    end;

    /// C: Rplot_get_axis_scale
    const method Scale(): UIAxisScale;
    begin
      return UIAxisScale(Rplot_get_axis_scale(self.FPlot, int32(self.FAxis)));
    end;

    /// Where a symmetric logarithmic scale is linear: from -`AThreshold` to `AThreshold`.
    /// C: Rplot_set_axis_linear_threshold
    const method LinearThreshold(const AThreshold: float64): self;
    begin
      Rplot_set_axis_linear_threshold(self.FPlot, int32(self.FAxis), AThreshold);
      return self;
    end;

    /// The values it shows, from `AMin` to `AMax` (it stops fitting the data).
    /// C: Rplot_set_axis_range
    const method Range(const AMin: float64; const AMax: float64): self;
    begin
      Rplot_set_axis_range(self.FPlot, int32(self.FAxis), AMin, AMax);
      return self;
    end;

    /// The values it shows (Min, Max; Step 0). C: Rplot_get_axis_range
    const method Range(): UIRange;
    var
      LRange: UIRange;
    begin
      LRange.Min := 0.0;
      LRange.Max := 0.0;
      LRange.Step := 0.0;
      Rplot_get_axis_range(self.FPlot, int32(self.FAxis), addr of LRange.Min, addr of LRange.Max);
      return LRange;
    end;

    /// Its range follows the data (`AOn`). C: Rplot_set_axis_auto_fit
    const method AutoFit(const AOn: bool): self;
    begin
      Rplot_set_axis_auto_fit(self.FPlot, int32(self.FAxis), DoCBool(AOn));
      return self;
    end;

    /// C: Rplot_is_axis_auto_fit
    const method AutoFit(): bool;
    begin
      return Rplot_is_axis_auto_fit(self.FPlot, int32(self.FAxis)) <> 0;
    end;

    /// The C format its tick labels are written with ("%.1f"; "": Raven's own).
    /// C: Rplot_set_axis_format
    const method Format(const AFormat: string): self;
    begin
      Rplot_set_axis_format(self.FPlot, int32(self.FAxis), AFormat);
      return self;
    end;

    /// Shown (`AOn`) or hidden. C: Rplot_set_axis_visible
    const method Visible(const AOn: bool): self;
    begin
      Rplot_set_axis_visible(self.FPlot, int32(self.FAxis), DoCBool(AOn));
      return self;
    end;

    /// Grid lines drawn at its ticks (`AOn`). C: Rplot_set_axis_grid
    const method Grid(const AOn: bool): self;
    begin
      Rplot_set_axis_grid(self.FPlot, int32(self.FAxis), DoCBool(AOn));
      return self;
    end;

    /// Its values run the other way (`AOn`). C: Rplot_set_axis_inverted
    const method Inverted(const AOn: bool): self;
    begin
      Rplot_set_axis_inverted(self.FPlot, int32(self.FAxis), DoCBool(AOn));
      return self;
    end;

    /// The user may not pan or zoom it (`AOn`). C: Rplot_set_axis_locked
    const method Locked(const AOn: bool): self;
    begin
      Rplot_set_axis_locked(self.FPlot, int32(self.FAxis), DoCBool(AOn));
      return self;
    end;
  end;

  /// One drag line of a `UIPlot` (a line across it at a value, the user can drag): a view
  /// of (the plot, the line's index), copied freely. C: Rplot_*_drag_line_*
  UIDragLine = object
    hidden FPlot: Rid;
    hidden FLine: int32;

    /// An empty drag line handle (names none).
    init();
    begin
      self.FPlot := R_INVALID_ID;
      self.FLine := -1;
    end;

    /// The drag line `ALine` of the plot `APlot` (a Rid).
    static method Wrap(const APlot: Rid; const ALine: int32): UIDragLine;
    var
      LLine: UIDragLine;
    begin
      LLine.FPlot := APlot;
      LLine.FLine := ALine;
      return LLine;
    end;

    /// The line's index (-1 when it names none).
    const method Index(): int32;
    begin
      return self.FLine;
    end;

    /// `true` while the index is one of its plot's drag lines. C: Rplot_get_drag_line_count
    const method IsValid(): bool;
    begin
      return (self.FLine >= 0) and (self.FLine < Rplot_get_drag_line_count(self.FPlot));
    end;

    /// The value it stands at. C: Rplot_set_drag_line_value
    const method Value(const AValue: float64): self;
    begin
      Rplot_set_drag_line_value(self.FPlot, self.FLine, AValue);
      return self;
    end;

    /// C: Rplot_get_drag_line_value
    const method Value(): float64;
    begin
      return Rplot_get_drag_line_value(self.FPlot, self.FLine);
    end;

    /// Its colour. C: Rplot_set_drag_line_color
    const method Color(const AColor: UIColor): self;
    begin
      Rplot_set_drag_line_color(self.FPlot, self.FLine, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// The line removed from its plot (the ones after it move down by one).
    /// C: Rplot_remove_drag_line
    const method Remove();
    begin
      Rplot_remove_drag_line(self.FPlot, self.FLine);
    end;
  end;

  /// One slice of a pie or donut `UIChart`: a view of (the chart, the slice's index), copied
  /// freely. Removing a slice moves the ones after it down by one. C: Rchart_*_slice_*
  UIChartSlice = object
    hidden FChart: Rid;
    hidden FSlice: int32;

    /// An empty slice handle (names none).
    init();
    begin
      self.FChart := R_INVALID_ID;
      self.FSlice := -1;
    end;

    /// The slice `ASlice` of the chart `AChart` (a Rid).
    static method Wrap(const AChart: Rid; const ASlice: int32): UIChartSlice;
    var
      LSlice: UIChartSlice;
    begin
      LSlice.FChart := AChart;
      LSlice.FSlice := ASlice;
      return LSlice;
    end;

    /// The slice's index (-1 when it names none).
    const method Index(): int32;
    begin
      return self.FSlice;
    end;

    /// `true` while the index is one of its chart's slices. C: Rchart_get_slice_count
    const method IsValid(): bool;
    begin
      return (self.FSlice >= 0) and (self.FSlice < Rchart_get_slice_count(self.FChart));
    end;

    /// Its value (its share is its value over the chart's total). C: Rchart_set_slice_value
    const method Value(const AValue: float64): self;
    begin
      Rchart_set_slice_value(self.FChart, self.FSlice, AValue);
      return self;
    end;

    /// C: Rchart_get_slice_value
    const method Value(): float64;
    begin
      return Rchart_get_slice_value(self.FChart, self.FSlice);
    end;

    /// Its label. C: Rchart_set_slice_label
    const method Label(const ALabel: string): self;
    begin
      Rchart_set_slice_label(self.FChart, self.FSlice, ALabel);
      return self;
    end;

    /// C: Rchart_get_slice_label
    const method Label(): string;
    begin
      return DoRavenText(Rchart_get_slice_label(self.FChart, self.FSlice));
    end;

    /// Its colour (the theme's own until set). C: Rchart_set_slice_color
    const method Color(const AColor: UIColor): self;
    begin
      Rchart_set_slice_color(self.FChart, self.FSlice, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// The slice removed from its chart. C: Rchart_remove_slice
    const method Remove();
    begin
      Rchart_remove_slice(self.FChart, self.FSlice);
    end;
  end;

  /// One marker of a `UIMapView`: a view of (the map, the marker's id), copied freely; the
  /// id stays the marker's while others come and go. C: Rmap_view_*_marker_*
  UIMapMarker = object
    hidden FMap: Rid;
    hidden FMarker: int32;

    /// An empty marker handle (names none).
    init();
    begin
      self.FMap := R_INVALID_ID;
      self.FMarker := -1;
    end;

    /// The marker with the id `AMarker` on the map `AMap` (a Rid).
    static method Wrap(const AMap: Rid; const AMarker: int32): UIMapMarker;
    var
      LMarker: UIMapMarker;
    begin
      LMarker.FMap := AMap;
      LMarker.FMarker := AMarker;
      return LMarker;
    end;

    /// The marker's id (-1 when it names none).
    const method Id(): int32;
    begin
      return self.FMarker;
    end;

    /// `true` when it names a marker id (Raven gives -1 for a marker it could not add).
    const method IsValid(): bool;
    begin
      return (self.FMap <> R_INVALID_ID) and (self.FMarker >= 0);
    end;

    /// The place it stands at. C: Rmap_view_set_marker_position
    const method Position(const ALatitude: float64; const ALongitude: float64): self;
    begin
      Rmap_view_set_marker_position(self.FMap, self.FMarker, ALatitude, ALongitude);
      return self;
    end;

    /// The text shown beside it ("": none). C: Rmap_view_set_marker_label
    const method Label(const ALabel: string): self;
    begin
      Rmap_view_set_marker_label(self.FMap, self.FMarker, ALabel);
      return self;
    end;

    /// Its colour (the theme's accent until set). C: Rmap_view_set_marker_color
    const method Color(const AColor: UIColor): self;
    begin
      Rmap_view_set_marker_color(self.FMap, self.FMarker, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// The marker removed from its map. C: Rmap_view_remove_marker
    const method Remove();
    begin
      Rmap_view_remove_marker(self.FMap, self.FMarker);
    end;
  end;

  /// What `UIPlot.OnSeriesToggled` runs when the user shows or hides a series from the
  /// legend: the series and whether it is shown now.
  UISeriesToggleFunc = ref func(const ASeries: UIPlotSeries; const AVisible: bool);
  /// What `UIPlot.OnDragLine` runs while the user drags a line: the line and its value.
  UIDragLineFunc = ref func(const ALine: UIDragLine; const AValue: float64);
  /// What `UIChart.OnSliceClick` runs when the user clicks a slice: the slice and whether it
  /// is selected now.
  UISliceFunc = ref func(const ASlice: UIChartSlice; const ASelected: bool);
  /// What `UIChart.OnCellClick` runs when the user clicks a heatmap cell: its row, column
  /// and value.
  UICellFunc = ref func(const ARow: int32; const AColumn: int32; const AValue: float32);
  /// What `UIMapView.OnTile` / `OnTileCancel` run: the tile's zoom level and its column and
  /// row at that level.
  UIMapTileFunc = ref func(const AZoom: int32; const AX: int32; const AY: int32);
  /// What `UIMapView.OnMarkerClick` runs when the user clicks a marker.
  UIMarkerFunc = ref func(const AMarker: UIMapMarker);
  /// What `UIMapView.OnViewChanged` runs when the user moves the map: its center and zoom.
  UIMapViewFunc = ref func(const ALatitude: float64; const ALongitude: float64; const AZoom: float64);

const
  // GMapTiles' second event: a tile no longer wanted (event 0: a tile asked for)
  ADAM_RAVEN_MAP_TILE_CANCEL: int32 = 1;

var
  // V7's closures by (widget, event), released with the widget or the app as V6's
  GSeriesToggles: UISlots<UISeriesToggleFunc>;
  GDragLines: UISlots<UIDragLineFunc>;
  GSliceClicks: UISlots<UISliceFunc>;
  GCellClicks: UISlots<UICellFunc>;
  GMapTiles: UISlots<UIMapTileFunc>;
  GMarkerClicks: UISlots<UIMarkerFunc>;
  GMapViews: UISlots<UIMapViewFunc>;

// The closures AWidget's charts, documents and maps held released (R_INVALID_ID: every one,
// the app ends)
func DoDropChartControls(const AWidget: Rid);
begin
  if AWidget = R_INVALID_ID then
    GSeriesToggles.DropAll();
    GDragLines.DropAll();
    GSliceClicks.DropAll();
    GCellClicks.DropAll();
    GMapTiles.DropAll();
    GMarkerClicks.DropAll();
    GMapViews.DropAll();
    return;
  end;
  GSeriesToggles.DropOwner(AWidget);
  GDragLines.DropOwner(AWidget);
  GSliceClicks.DropOwner(AWidget);
  GCellClicks.DropOwner(AWidget);
  GMapTiles.DropOwner(AWidget);
  GMarkerClicks.DropOwner(AWidget);
  GMapViews.DropOwner(AWidget);
end;

// V7's trampolines, as V6's: each runs its closure on a copy; a closure the table no longer
// holds (its widget gone) is never reached
func clink DoOnSeriesToggled(plot: Rid; series: int32; visible: int32; user_data: ptr);
var
  LFunc: UISeriesToggleFunc;
begin
  if not GSeriesToggles.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIPlotSeries.Wrap(plot, series), visible <> 0);
end;

func clink DoOnDragLine(plot: Rid; line: int32; value: float64; user_data: ptr);
var
  LFunc: UIDragLineFunc;
begin
  if not GDragLines.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIDragLine.Wrap(plot, line), value);
end;

func clink DoOnSliceClick(chart: Rid; slice: int32; selected: int32; user_data: ptr);
var
  LFunc: UISliceFunc;
begin
  if not GSliceClicks.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIChartSlice.Wrap(chart, slice), selected <> 0);
end;

func clink DoOnCellClick(chart: Rid; row: int32; column: int32; value: float32; user_data: ptr);
var
  LFunc: UICellFunc;
begin
  if not GCellClicks.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(row, column, value);
end;

func clink DoOnMapTile(map: Rid; z: int32; x: int32; y: int32; user_data: ptr);
var
  LFunc: UIMapTileFunc;
begin
  if not GMapTiles.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(z, x, y);
end;

func clink DoOnMarkerClick(map: Rid; marker: int32; user_data: ptr);
var
  LFunc: UIMarkerFunc;
begin
  if not GMarkerClicks.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIMapMarker.Wrap(map, marker));
end;

func clink DoOnMapView(map: Rid; latitude: float64; longitude: float64; zoom: float64;
  user_data: ptr);
var
  LFunc: UIMapViewFunc;
begin
  if not GMapViews.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(latitude, longitude, zoom);
end;

// ALabels joined by '|', the way Raven's heatmap takes its row / column labels
func DoJoinLabels(const ALabels: array of string): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  for LI := 0 to len(ALabels) - 1 do
    if LI > 0 then
      LText := LText + "|";
    end;
    LText := LText + ALabels[LI];
  end;
  return LText;
end;

// ADesc as Raven's RPdfPrintDesc in ARaven, its texts kept as C strings in ATitle .. APassword
// (the caller's, alive through the print call); "" texts are NULL (Raven's "none")
func DoPrintDesc(const ADesc: UIPrintDesc; var ATitle: CString; var APrinter: CString;
  var AOutput: CString; var APassword: CString; var ARaven: RPdfPrintDesc);
begin
  ATitle := CString(ADesc.Title);
  APrinter := CString(ADesc.Printer);
  AOutput := CString(ADesc.Output);
  APassword := CString(ADesc.Password);
  ARaven.window := ADesc.Window;
  ARaven.title := ATitle.OrNil;
  ARaven.printer := APrinter.OrNil;
  ARaven.copies := ADesc.Copies;
  ARaven.flags := uint32(ADesc.Flags);
  ARaven.output := AOutput.OrNil;
  ARaven.password := APassword.OrNil;
end;

type
  // A PDF document's holder: the document deleted with the last UIPDFDocRes copy, or when
  // the app ends first
  UIPDFDocHold = object(UIResHold)
    FDoc: Rid;

    done;
    begin
      self.Release();
    end;

    override method Unload();
    begin
      Rpdf_document_delete(self.FDoc);
    end;
  end;

public type
  /// A plot of series of points against axes (X / Y, and X2 / Y2 on the far sides): lines,
  /// markers, steps, fills; the user pans, zooms, toggles series in the legend and drags the
  /// drag lines. C: Rplot_*
  /// @example `LPlot := UIPlot.Create().Title("Signal"); LPlot.AddSeries("sin").Data(LX, LY).Color(UIColor.FromRGBA(58, 123, 213));`
  UIPlot = object(UIWidget)
    /// A new plot with no series. C: Rwidget_create (R_WIDGET_PLOT)
    static method Create(): UIPlot;
    var
      LWidget: UIPlot;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Plot)));
      return LWidget;
    end;

    /// The kind a plot views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Plot];
    end;

    /// The title written above it. C: Rplot_set_title
    const method Title(const ATitle: string): self;
    begin
      Rplot_set_title(self.FId, ATitle);
      return self;
    end;

    /// C: Rplot_get_title
    const method Title(): string;
    begin
      return DoRavenText(Rplot_get_title(self.FId));
    end;

    /// A new series named `AName` (the legend's text), with no points. C: Rplot_add_series
    const method AddSeries(const AName: string): UIPlotSeries;
    begin
      return UIPlotSeries.Wrap(self.FId, Rplot_add_series(self.FId, AName));
    end;

    /// `ASeries` removed (the ones after it move down by one). C: Rplot_remove_series
    const method RemoveSeries(const ASeries: UIPlotSeries): self;
    begin
      Rplot_remove_series(self.FId, ASeries.Index());
      return self;
    end;

    /// Every series and drag line removed. C: Rplot_clear
    const method Clear(): self;
    begin
      Rplot_clear(self.FId);
      return self;
    end;

    /// The series it has. C: Rplot_get_series_count
    const method SeriesCount(): int32;
    begin
      return Rplot_get_series_count(self.FId);
    end;

    /// Its series `AIndex` (from 0).
    const method Series(const AIndex: int32): UIPlotSeries;
    begin
      return UIPlotSeries.Wrap(self.FId, AIndex);
    end;

    /// Its axis `AAxis`.
    const method Axis(const AAxis: UIAxis): UIPlotAxis;
    begin
      return UIPlotAxis.Wrap(self.FId, AAxis);
    end;

    /// Every axis not locked fitted to the data, following it again. C: Rplot_fit
    const method Fit(): self;
    begin
      Rplot_fit(self.FId);
      return self;
    end;

    /// Where the legend goes (`UILegendPlace.Hidden`: none). C: Rplot_set_legend
    const method Legend(const APlace: UILegendPlace): self;
    begin
      Rplot_set_legend(self.FId, int32(APlace));
      return self;
    end;

    /// Lines across it under the pointer (`AOn`). C: Rplot_set_crosshair
    const method Crosshair(const AOn: bool): self;
    begin
      Rplot_set_crosshair(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The pointer's place in data units written in a corner (`AOn`). C: Rplot_set_mouse_text
    const method MouseText(const AOn: bool): self;
    begin
      Rplot_set_mouse_text(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The point nearest the pointer shown in a tooltip (`AOn`). C: Rplot_set_tooltips
    const method Tooltips(const AOn: bool): self;
    begin
      Rplot_set_tooltips(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The pointer's place in data units in `APoint` (X / Y axes). C: Rplot_get_mouse_position
    /// @returns `true` when the pointer is over the plot's area
    const method MousePosition(var APoint: UIPlotPoint): bool;
    begin
      APoint.X := 0.0;
      APoint.Y := 0.0;
      return Rplot_get_mouse_position(self.FId, addr of APoint.X, addr of APoint.Y) <> 0;
    end;

    /// Where the data point (`AX`, `AY`) is drawn, in the plot's own units from its top-left
    /// corner (after a layout). C: Rplot_data_to_point
    const method DataToPoint(const AX: float64; const AY: float64): UIPoint;
    var
      LPoint: UIPoint;
    begin
      LPoint.x := 0.0f;
      LPoint.y := 0.0f;
      Rplot_data_to_point(self.FId, AX, AY, addr of LPoint.x, addr of LPoint.y);
      return LPoint;
    end;

    /// The data point drawn at `APoint` (the plot's own units). C: Rplot_point_to_data
    const method PointToData(const APoint: UIPoint): UIPlotPoint;
    var
      LData: UIPlotPoint;
    begin
      LData.X := 0.0;
      LData.Y := 0.0;
      Rplot_point_to_data(self.FId, APoint.x, APoint.y, addr of LData.X, addr of LData.Y);
      return LData;
    end;

    /// A new drag line across the plot at `AValue` of `AAxis`, labelled `ALabel` ("": none).
    /// C: Rplot_add_drag_line
    const method AddDragLine(const AAxis: UIAxis; const AValue: float64; const ALabel: string): UIDragLine;
    begin
      return UIDragLine.Wrap(self.FId, Rplot_add_drag_line(self.FId, int32(AAxis), AValue, ALabel));
    end;

    /// The drag lines it has. C: Rplot_get_drag_line_count
    const method DragLineCount(): int32;
    begin
      return Rplot_get_drag_line_count(self.FId);
    end;

    /// Its drag line `AIndex` (from 0).
    const method DragLine(const AIndex: int32): UIDragLine;
    begin
      return UIDragLine.Wrap(self.FId, AIndex);
    end;

    /// Runs `AFunc` each time the user pans or zooms it. C: Rplot_set_view_changed_callback
    const method OnViewChanged(const AFunc: UITaskFunc): self;
    begin
      if AFunc = nil then
        GControlTasks.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rplot_set_view_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rplot_set_view_changed_callback(self.FId, DoOnControlTask,
        GControlTasks.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the line and its value while the user drags a drag line.
    /// C: Rplot_set_drag_line_callback
    const method OnDragLine(const AFunc: UIDragLineFunc): self;
    begin
      if AFunc = nil then
        GDragLines.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rplot_set_drag_line_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rplot_set_drag_line_callback(self.FId, DoOnDragLine,
        GDragLines.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the series and whether it is shown when the user toggles it in the
    /// legend. C: Rplot_set_series_toggled_callback
    const method OnSeriesToggled(const AFunc: UISeriesToggleFunc): self;
    begin
      if AFunc = nil then
        GSeriesToggles.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rplot_set_series_toggled_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rplot_set_series_toggled_callback(self.FId, DoOnSeriesToggled,
        GSeriesToggles.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// A chart of one kind: pie or donut (slices), gauge (a value in a range, coloured bands),
  /// heatmap (a grid of cells, coloured along a scale) or sparkline (a small line of values).
  /// Each kind uses its own members; the kind may change. C: Rchart_*
  /// @example `LPie := UIChart.Create(UIChartKind.Donut).Title("Disk"); LPie.AddSlice("Used", 61.0); LPie.AddSlice("Free", 39.0);`
  UIChart = object(UIWidget)
    /// A new chart of the kind `AKind`, empty. C: Rchart_create
    static method Create(const AKind: UIChartKind): UIChart;
    var
      LWidget: UIChart;
    begin
      LWidget.DoSet(Rchart_create(int32(AKind)));
      return LWidget;
    end;

    /// The kind a chart views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Chart];
    end;

    /// The chart's kind (what it keeps of the others stays for a change back).
    /// C: Rchart_set_kind
    const method Kind(const AKind: UIChartKind): self;
    begin
      Rchart_set_kind(self.FId, int32(AKind));
      return self;
    end;

    /// Its chart kind (`Kind()` stays the widget's kind, `UIWidgetKind.Chart`).
    /// C: Rchart_get_kind
    const method ChartKind(): UIChartKind;
    begin
      return UIChartKind(Rchart_get_kind(self.FId));
    end;

    /// The title written above it. C: Rchart_set_title
    const method Title(const ATitle: string): self;
    begin
      Rchart_set_title(self.FId, ATitle);
      return self;
    end;

    /// C: Rchart_get_title
    const method Title(): string;
    begin
      return DoRavenText(Rchart_get_title(self.FId));
    end;

    /// The C format its values are written with ("%.0f%%"; "": Raven's own).
    /// C: Rchart_set_format
    const method Format(const AFormat: string): self;
    begin
      Rchart_set_format(self.FId, AFormat);
      return self;
    end;

    /// Its main colour (a gauge's arc, a sparkline's line). C: Rchart_set_color
    const method Color(const AColor: UIColor): self;
    begin
      Rchart_set_color(self.FId, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// A legend shown (`AOn`). C: Rchart_set_legend
    const method Legend(const AOn: bool): self;
    begin
      Rchart_set_legend(self.FId, DoCBool(AOn));
      return self;
    end;

    /// Every slice, band, cell and value removed. C: Rchart_clear
    const method Clear(): self;
    begin
      Rchart_clear(self.FId);
      return self;
    end;

    /// The slice or cell under the pointer (-1: none; a cell as row x columns + column).
    /// C: Rchart_get_hovered
    const method HoveredIndex(): int32;
    begin
      return Rchart_get_hovered(self.FId);
    end;

    /// A new slice labelled `ALabel` worth `AValue` (pie / donut). C: Rchart_add_slice
    const method AddSlice(const ALabel: string; const AValue: float64): UIChartSlice;
    begin
      return UIChartSlice.Wrap(self.FId, Rchart_add_slice(self.FId, ALabel, AValue));
    end;

    /// The slices it has. C: Rchart_get_slice_count
    const method SliceCount(): int32;
    begin
      return Rchart_get_slice_count(self.FId);
    end;

    /// Its slice `AIndex` (from 0).
    const method Slice(const AIndex: int32): UIChartSlice;
    begin
      return UIChartSlice.Wrap(self.FId, AIndex);
    end;

    /// The sum of its slices' values. C: Rchart_get_total
    const method Total(): float64;
    begin
      return Rchart_get_total(self.FId);
    end;

    /// The slice `AIndex` selected (pulled out; -1: none). C: Rchart_set_selected
    const method Selected(const AIndex: int32): self;
    begin
      Rchart_set_selected(self.FId, AIndex);
      return self;
    end;

    /// The selected slice (-1: none). C: Rchart_get_selected
    const method Selected(): int32;
    begin
      return Rchart_get_selected(self.FId);
    end;

    /// A donut's hole, as a share of its radius (0 .. 1). C: Rchart_set_hole
    const method Hole(const ARatio: float32): self;
    begin
      Rchart_set_hole(self.FId, ARatio);
      return self;
    end;

    /// The text written in a donut's hole, a smaller caption under it ("": none).
    /// C: Rchart_set_center_text
    const method CenterText(const AText: string; const ACaption: string): self;
    begin
      Rchart_set_center_text(self.FId, AText, ACaption);
      return self;
    end;

    /// Runs `AFunc` with the slice and whether it is selected when the user clicks one.
    /// C: Rchart_set_slice_clicked_callback
    const method OnSliceClick(const AFunc: UISliceFunc): self;
    begin
      if AFunc = nil then
        GSliceClicks.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rchart_set_slice_clicked_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rchart_set_slice_clicked_callback(self.FId, DoOnSliceClick,
        GSliceClicks.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// A gauge's range, from `AMin` to `AMax`. C: Rchart_set_range
    const method Range(const AMin: float64; const AMax: float64): self;
    begin
      Rchart_set_range(self.FId, AMin, AMax);
      return self;
    end;

    /// A gauge's range (Min, Max; Step 0). C: Rchart_get_range
    const method Range(): UIRange;
    var
      LRange: UIRange;
    begin
      LRange.Min := 0.0;
      LRange.Max := 0.0;
      LRange.Step := 0.0;
      Rchart_get_range(self.FId, addr of LRange.Min, addr of LRange.Max);
      return LRange;
    end;

    /// A gauge's value. C: Rchart_set_value
    const method Value(const AValue: float64): self;
    begin
      Rchart_set_value(self.FId, AValue);
      return self;
    end;

    /// C: Rchart_get_value
    const method Value(): float64;
    begin
      return Rchart_get_value(self.FId);
    end;

    /// A band of a gauge's arc from `AFrom` to `ATo` coloured `AColor`. C: Rchart_add_band
    const method AddBand(const AFrom: float64; const ATo: float64; const AColor: UIColor): self;
    begin
      Rchart_add_band(self.FId, AFrom, ATo, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// Every band removed. C: Rchart_clear_bands
    const method ClearBands(): self;
    begin
      Rchart_clear_bands(self.FId);
      return self;
    end;

    /// The bands a gauge has. C: Rchart_get_band_count
    const method BandCount(): int32;
    begin
      return Rchart_get_band_count(self.FId);
    end;

    /// A heatmap of `ARows` x `AColumns` cells, every one 0. C: Rchart_set_grid
    const method Grid(const ARows: int32; const AColumns: int32): self;
    begin
      Rchart_set_grid(self.FId, ARows, AColumns, nil);
      return self;
    end;

    /// A heatmap of `ARows` x `AColumns` cells, their values row by row from `AValues`
    /// (copied; one too short leaves every cell 0). C: Rchart_set_grid
    const method Grid(const ARows: int32; const AColumns: int32; const AValues: array of float32): self;
    begin
      if len(AValues) < int64(ARows) * int64(AColumns) then
        Rchart_set_grid(self.FId, ARows, AColumns, nil);
        return self;
      end;
      Rchart_set_grid(self.FId, ARows, AColumns, addr of AValues[0]);
      return self;
    end;

    /// A heatmap's rows. C: Rchart_get_row_count
    const method RowCount(): int32;
    begin
      return Rchart_get_row_count(self.FId);
    end;

    /// A heatmap's columns. C: Rchart_get_column_count
    const method ColumnCount(): int32;
    begin
      return Rchart_get_column_count(self.FId);
    end;

    /// The value of a heatmap's cell at `ARow`, `AColumn`. C: Rchart_set_cell
    const method Cell(const ARow: int32; const AColumn: int32; const AValue: float32): self;
    begin
      Rchart_set_cell(self.FId, ARow, AColumn, AValue);
      return self;
    end;

    /// C: Rchart_get_cell
    const method Cell(const ARow: int32; const AColumn: int32): float32;
    begin
      return Rchart_get_cell(self.FId, ARow, AColumn);
    end;

    /// A heatmap's row labels, the first row's first (none: no labels).
    /// C: Rchart_set_row_labels
    const method RowLabels(const ALabels: array of string): self;
    begin
      Rchart_set_row_labels(self.FId, DoJoinLabels(ALabels));
      return self;
    end;

    /// A heatmap's column labels, the first column's first (none: no labels).
    /// C: Rchart_set_column_labels
    const method ColumnLabels(const ALabels: array of string): self;
    begin
      Rchart_set_column_labels(self.FId, DoJoinLabels(ALabels));
      return self;
    end;

    /// The label of a heatmap's row `AIndex` ("": none). C: Rchart_get_row_label
    const method RowLabel(const AIndex: int32): string;
    begin
      return DoRavenText(Rchart_get_row_label(self.FId, AIndex));
    end;

    /// The label of a heatmap's column `AIndex` ("": none). C: Rchart_get_column_label
    const method ColumnLabel(const AIndex: int32): string;
    begin
      return DoRavenText(Rchart_get_column_label(self.FId, AIndex));
    end;

    /// A heatmap's colours: `ALow` for its smallest value, `AHigh` for its largest.
    /// C: Rchart_set_color_scale
    const method ColorScale(const ALow: UIColor; const AHigh: UIColor): self;
    begin
      Rchart_set_color_scale(self.FId, ALow.r, ALow.g, ALow.b, ALow.a, AHigh.r, AHigh.g, AHigh.b,
        AHigh.a);
      return self;
    end;

    /// Runs `AFunc` with the cell's row, column and value when the user clicks a heatmap
    /// cell. C: Rchart_set_cell_clicked_callback
    const method OnCellClick(const AFunc: UICellFunc): self;
    begin
      if AFunc = nil then
        GCellClicks.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rchart_set_cell_clicked_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rchart_set_cell_clicked_callback(self.FId, DoOnCellClick,
        GCellClicks.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// A sparkline's values, replacing the ones it had (copied). C: Rchart_set_values
    const method Values(const AValues: array of float32): self;
    begin
      if len(AValues) = 0 then
        Rchart_set_values(self.FId, nil, 0);
        return self;
      end;
      Rchart_set_values(self.FId, addr of AValues[0], int32(len(AValues)));
      return self;
    end;

    /// `AValue` added after a sparkline's values, the oldest leaving past `AMaxCount`
    /// (0: no limit). C: Rchart_push_value
    const method Push(const AValue: float32; const AMaxCount: int32): self;
    begin
      Rchart_push_value(self.FId, AValue, AMaxCount);
      return self;
    end;

    /// The values a sparkline has. C: Rchart_get_value_count
    const method ValueCount(): int32;
    begin
      return Rchart_get_value_count(self.FId);
    end;

    /// A sparkline's value `AIndex` (from 0, the oldest). C: Rchart_get_value_at
    const method ValueAt(const AIndex: int32): float32;
    begin
      return Rchart_get_value_at(self.FId, AIndex);
    end;

    /// The area under a sparkline filled (`AOn`). C: Rchart_set_fill
    const method Fill(const AOn: bool): self;
    begin
      Rchart_set_fill(self.FId, DoCBool(AOn));
      return self;
    end;

    /// A marker on a sparkline's last value (`AOn`). C: Rchart_set_marker
    const method Marker(const AOn: bool): self;
    begin
      Rchart_set_marker(self.FId, DoCBool(AOn));
      return self;
    end;
  end;

  /// A PDF document shown page under page, scrolled and zoomed by the user. Raven draws the
  /// pages with PDFium, opened at run time (RAVEN_PDFIUM, beside the program, or where the
  /// system looks): where it is not found the view says so and its status is
  /// `UIPDFStatus.Unavailable`. C: Rpdf_view_*
  /// @example `LDoc := UIPDFView.Create(); if not LDoc.LoadFile("manual.pdf") then println("{}", nameof(LDoc.Status())); end;`
  UIPDFView = object(UIWidget)
    /// A new PDF view, empty. C: Rwidget_create (R_WIDGET_PDF_VIEW)
    static method Create(): UIPDFView;
    var
      LWidget: UIPDFView;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.PDFView)));
      return LWidget;
    end;

    /// The kind a PDF view views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.PDFView];
    end;

    /// `true` when PDFium was found: PDF views can show documents and PDFs can be printed
    /// on Windows. C: Rpdf_is_available
    static method Available(): bool;
    begin
      return Rpdf_is_available() <> 0;
    end;

    /// The PDF file `APath` shown (read through Adam's streams). C: Rpdf_view_load_file
    /// @returns `false` when it cannot be shown (see `Status()`)
    const method LoadFile(const APath: string): bool;
    begin
      return Rpdf_view_load_file(self.FId, APath, nil) <> 0;
    end;

    /// The PDF file `APath`, protected by `APassword`, shown. C: Rpdf_view_load_file
    /// @returns `false` when it cannot be shown (see `Status()`)
    const method LoadFile(const APath: string; const APassword: string): bool;
    begin
      return Rpdf_view_load_file(self.FId, APath, APassword) <> 0;
    end;

    /// The PDF in `AData` shown (copied). C: Rpdf_view_load_memory
    /// @returns `false` when it cannot be shown (see `Status()`)
    const method LoadMemory(const AData: array of uint8): bool;
    begin
      if len(AData) = 0 then
        return Rpdf_view_load_memory(self.FId, nil, 0, nil) <> 0;
      end;
      return Rpdf_view_load_memory(self.FId, ptr to const char(addr of AData[0]), uint64(len(AData)),
        nil) <> 0;
    end;

    /// The PDF in `AData`, protected by `APassword`, shown (copied). C: Rpdf_view_load_memory
    /// @returns `false` when it cannot be shown (see `Status()`)
    const method LoadMemory(const AData: array of uint8; const APassword: string): bool;
    begin
      if len(AData) = 0 then
        return Rpdf_view_load_memory(self.FId, nil, 0, APassword) <> 0;
      end;
      return Rpdf_view_load_memory(self.FId, ptr to const char(addr of AData[0]), uint64(len(AData)),
        APassword) <> 0;
    end;

    /// The document closed: the view is empty. C: Rpdf_view_close
    const method Close(): self;
    begin
      Rpdf_view_close(self.FId);
      return self;
    end;

    /// What it shows: nothing, a document, or why it shows none. C: Rpdf_view_get_status
    const method Status(): UIPDFStatus;
    begin
      return UIPDFStatus(Rpdf_view_get_status(self.FId));
    end;

    /// The pages of the document shown. C: Rpdf_view_get_page_count
    const method PageCount(): int32;
    begin
      return Rpdf_view_get_page_count(self.FId);
    end;

    /// The size of its page `APage` (from 0) in points (1/72 inch). C: Rpdf_view_get_page_size
    const method PageSize(const APage: int32): UISize;
    var
      LSize: UISize;
    begin
      LSize.w := 0.0f;
      LSize.h := 0.0f;
      Rpdf_view_get_page_size(self.FId, APage, addr of LSize.w, addr of LSize.h);
      return LSize;
    end;

    /// Scrolled to its page `APage` (from 0). C: Rpdf_view_set_page
    const method Page(const APage: int32): self;
    begin
      Rpdf_view_set_page(self.FId, APage);
      return self;
    end;

    /// The page at the top of the view. C: Rpdf_view_get_page
    const method Page(): int32;
    begin
      return Rpdf_view_get_page(self.FId);
    end;

    /// Its zoom (1: the pages at their size; it stops fitting). C: Rpdf_view_set_zoom
    const method Zoom(const AZoom: float32): self;
    begin
      Rpdf_view_set_zoom(self.FId, AZoom);
      return self;
    end;

    /// C: Rpdf_view_get_zoom
    const method Zoom(): float32;
    begin
      return Rpdf_view_get_zoom(self.FId);
    end;

    /// How the pages fit the view: its width, a whole page, or the zoom set.
    /// C: Rpdf_view_set_fit
    const method Fit(const AFit: UIPDFFit): self;
    begin
      Rpdf_view_set_fit(self.FId, int32(AFit));
      return self;
    end;

    /// C: Rpdf_view_get_fit
    const method Fit(): UIPDFFit;
    begin
      return UIPDFFit(Rpdf_view_get_fit(self.FId));
    end;

    /// The document's title ("": none). C: Rpdf_view_get_title
    const method Title(): string;
    begin
      return DoRavenText(Rpdf_view_get_title(self.FId));
    end;

    /// The text of its page `APage` (from 0). C: Rpdf_view_get_page_text
    const method PageText(const APage: int32): string;
    begin
      return DoRavenText(Rpdf_view_get_page_text(self.FId, APage));
    end;

    /// The document shown printed as `ADesc` says (the job named after its title). Waits
    /// until the job is sent. C: Rpdf_view_print
    /// @returns `false` when cancelled or when it cannot print
    const method Print(const ADesc: UIPrintDesc): bool;
    var
      LTitle: CString;
      LPrinter: CString;
      LOutput: CString;
      LPassword: CString;
      LDesc: RPdfPrintDesc;
    begin
      DoPrintDesc(ADesc, LTitle, LPrinter, LOutput, LPassword, LDesc);
      return Rpdf_view_print(self.FId, addr of LDesc) <> 0;
    end;

    /// Runs `AFunc` with the page at the top each time the user scrolls to another.
    /// C: Rpdf_view_set_page_changed_callback
    const method OnPageChanged(const AFunc: UIIndexFunc): self;
    begin
      if AFunc = nil then
        GControlIndexes.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rpdf_view_set_page_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rpdf_view_set_page_changed_callback(self.FId, DoOnControlIndex,
        GControlIndexes.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// A slippy map of square tiles (Web Mercator, zoom 0 .. 24) the user drags and zooms, with
  /// markers. Raven fetches nothing from the network: the program hands it the tiles its
  /// tile closure asks for (`Tile` / `TileData` / `TileFailed`, from any thread), or names a
  /// folder of tile files (`TilePath`). C: Rmap_view_*
  /// @example `LMap := UIMapView.Create().TilePath("tiles/{z}/{x}/{y}.png").Center(48.8566, 2.3522).Zoom(12.0);`
  UIMapView = object(UIWidget)
    /// A new map, centered on 0, 0 at zoom 0, with no tiles. C: Rmap_view_create
    static method Create(): UIMapView;
    var
      LWidget: UIMapView;
    begin
      LWidget.DoSet(Rmap_view_create());
      return LWidget;
    end;

    /// The kind a map views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.MapView];
    end;

    /// The place at its center, at once. C: Rmap_view_set_center
    const method Center(const ALatitude: float64; const ALongitude: float64): self;
    begin
      Rmap_view_set_center(self.FId, ALatitude, ALongitude);
      return self;
    end;

    /// C: Rmap_view_get_center
    const method Center(): UILatLon;
    var
      LPlace: UILatLon;
    begin
      LPlace.Latitude := 0.0;
      LPlace.Longitude := 0.0;
      Rmap_view_get_center(self.FId, addr of LPlace.Latitude, addr of LPlace.Longitude);
      return LPlace;
    end;

    /// Its zoom (0: the whole world in one tile; each step doubles the scale), at once,
    /// kept within its zoom range. C: Rmap_view_set_zoom
    const method Zoom(const AZoom: float64): self;
    begin
      Rmap_view_set_zoom(self.FId, AZoom);
      return self;
    end;

    /// C: Rmap_view_get_zoom
    const method Zoom(): float64;
    begin
      return Rmap_view_get_zoom(self.FId);
    end;

    /// The zooms the user may reach, from `AMin` to `AMax` (within 0 .. 24).
    /// C: Rmap_view_set_zoom_range
    const method ZoomRange(const AMin: float64; const AMax: float64): self;
    begin
      Rmap_view_set_zoom_range(self.FId, AMin, AMax);
      return self;
    end;

    /// Its zoom range (Min, Max; Step 0). C: Rmap_view_get_zoom_range
    const method ZoomRange(): UIRange;
    var
      LRange: UIRange;
    begin
      LRange.Min := 0.0;
      LRange.Max := 0.0;
      LRange.Step := 0.0;
      Rmap_view_get_zoom_range(self.FId, addr of LRange.Min, addr of LRange.Max);
      return LRange;
    end;

    /// Flies to the place at `AZoom` (at once while animations are off).
    /// C: Rmap_view_animate_to
    const method AnimateTo(const ALatitude: float64; const ALongitude: float64; const AZoom: float64): self;
    begin
      Rmap_view_animate_to(self.FId, ALatitude, ALongitude, AZoom);
      return self;
    end;

    /// The place drawn at `APoint` (the map's own units from its top-left corner).
    /// C: Rmap_view_screen_to_latlon
    const method ScreenToLatLon(const APoint: UIPoint): UILatLon;
    var
      LPlace: UILatLon;
    begin
      LPlace.Latitude := 0.0;
      LPlace.Longitude := 0.0;
      Rmap_view_screen_to_latlon(self.FId, APoint.x, APoint.y, addr of LPlace.Latitude,
        addr of LPlace.Longitude);
      return LPlace;
    end;

    /// Where the place is drawn, in the map's own units from its top-left corner.
    /// C: Rmap_view_latlon_to_screen
    const method LatLonToScreen(const ALatitude: float64; const ALongitude: float64): UIPoint;
    var
      LPoint: UIPoint;
    begin
      LPoint.x := 0.0f;
      LPoint.y := 0.0f;
      Rmap_view_latlon_to_screen(self.FId, ALatitude, ALongitude, addr of LPoint.x, addr of LPoint.y);
      return LPoint;
    end;

    /// Runs `AFunc` with a tile's zoom, column and row each time the map wants a tile it does
    /// not have (on the UI thread, while it paints); the program answers with `Tile`,
    /// `TileData` or `TileFailed`. C: Rmap_view_set_tile_callback
    const method OnTile(const AFunc: UIMapTileFunc): self;
    begin
      if AFunc = nil then
        GMapTiles.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rmap_view_set_tile_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rmap_view_set_tile_callback(self.FId, DoOnMapTile,
        GMapTiles.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with a tile asked for that the map no longer wants (moved away before it
    /// came). C: Rmap_view_set_tile_cancel_callback
    const method OnTileCancel(const AFunc: UIMapTileFunc): self;
    begin
      if AFunc = nil then
        GMapTiles.Clear(self.FId, ADAM_RAVEN_MAP_TILE_CANCEL);
        Rmap_view_set_tile_cancel_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rmap_view_set_tile_cancel_callback(self.FId, DoOnMapTile,
        GMapTiles.Put(self.FId, ADAM_RAVEN_MAP_TILE_CANCEL, AFunc));
      return self;
    end;

    /// The tile `AZoom` / `AX` / `AY` as `AWidth` x `AHeight` RGBA pixels (rows from the top;
    /// copied; 1 .. 4096 on a side). C: Rmap_view_set_tile
    const method Tile(const AZoom: int32; const AX: int32; const AY: int32;
      const APixels: array of uint8; const AWidth: int32; const AHeight: int32): self;
    begin
      if (AWidth <= 0) or (AHeight <= 0) or (len(APixels) < int64(AWidth) * int64(AHeight) * 4) then
        Rmap_view_set_tile(self.FId, AZoom, AX, AY, nil, 0, 0);
        return self;
      end;
      Rmap_view_set_tile(self.FId, AZoom, AX, AY, addr of APixels[0], AWidth, AHeight);
      return self;
    end;

    /// The tile `AZoom` / `AX` / `AY` from an image file's bytes (PNG, JPEG ..; decoded).
    /// C: Rmap_view_set_tile_data
    const method TileData(const AZoom: int32; const AX: int32; const AY: int32;
      const AData: array of uint8): self;
    begin
      if len(AData) = 0 then
        Rmap_view_set_tile_data(self.FId, AZoom, AX, AY, nil, 0);
        return self;
      end;
      Rmap_view_set_tile_data(self.FId, AZoom, AX, AY, addr of AData[0], uint64(len(AData)));
      return self;
    end;

    /// The tile `AZoom` / `AX` / `AY` cannot be had (the map draws a coarser one there).
    /// C: Rmap_view_set_tile_failed
    const method TileFailed(const AZoom: int32; const AX: int32; const AY: int32): self;
    begin
      Rmap_view_set_tile_failed(self.FId, AZoom, AX, AY);
      return self;
    end;

    /// A folder of tile files the map reads itself: a path with `{z}`, `{x}` and `{y}` in it
    /// ("tiles/{z}/{x}/{y}.png"; local files only; "": none). C: Rmap_view_set_tile_path
    const method TilePath(const APath: string): self;
    begin
      Rmap_view_set_tile_path(self.FId, APath);
      return self;
    end;

    /// C: Rmap_view_get_tile_path
    const method TilePath(): string;
    begin
      return DoRavenText(Rmap_view_get_tile_path(self.FId));
    end;

    /// The size its tiles are drawn at, in logical units (16 .. 1024; 256 at first).
    /// C: Rmap_view_set_tile_size
    const method TileSize(const ASize: int32): self;
    begin
      Rmap_view_set_tile_size(self.FId, ASize);
      return self;
    end;

    /// C: Rmap_view_get_tile_size
    const method TileSize(): int32;
    begin
      return Rmap_view_get_tile_size(self.FId);
    end;

    /// The bytes of tiles it keeps (64 MB at first), the least recently drawn leaving first.
    /// C: Rmap_view_set_cache_size
    const method CacheSize(const ABytes: int64): self;
    begin
      Rmap_view_set_cache_size(self.FId, uint64(ABytes));
      return self;
    end;

    /// The bytes its tiles take now. C: Rmap_view_get_cache_usage
    const method CacheUsage(): int64;
    begin
      return int64(Rmap_view_get_cache_usage(self.FId));
    end;

    /// Every tile it has dropped (asked for again as they are drawn). C: Rmap_view_clear_tiles
    const method ClearTiles(): self;
    begin
      Rmap_view_clear_tiles(self.FId);
      return self;
    end;

    /// Where its tile `AZoom` / `AX` / `AY` stands. C: Rmap_view_get_tile_state
    const method TileState(const AZoom: int32; const AX: int32; const AY: int32): UITileState;
    begin
      return UITileState(Rmap_view_get_tile_state(self.FId, AZoom, AX, AY));
    end;

    /// A new marker at the place, labelled `ALabel` ("": none). C: Rmap_view_add_marker
    const method AddMarker(const ALatitude: float64; const ALongitude: float64; const ALabel: string): UIMapMarker;
    begin
      return UIMapMarker.Wrap(self.FId, Rmap_view_add_marker(self.FId, ALatitude, ALongitude, ALabel));
    end;

    /// Every marker removed. C: Rmap_view_clear_markers
    const method ClearMarkers(): self;
    begin
      Rmap_view_clear_markers(self.FId);
      return self;
    end;

    /// The markers it has. C: Rmap_view_get_marker_count
    const method MarkerCount(): int32;
    begin
      return Rmap_view_get_marker_count(self.FId);
    end;

    /// Runs `AFunc` with the marker the user clicks. C: Rmap_view_set_marker_clicked_callback
    const method OnMarkerClick(const AFunc: UIMarkerFunc): self;
    begin
      if AFunc = nil then
        GMarkerClicks.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rmap_view_set_marker_clicked_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rmap_view_set_marker_clicked_callback(self.FId, DoOnMarkerClick,
        GMarkerClicks.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with the map's center and zoom each time the user moves it or a move
    /// ends. C: Rmap_view_set_view_changed_callback
    const method OnViewChanged(const AFunc: UIMapViewFunc): self;
    begin
      if AFunc = nil then
        GMapViews.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rmap_view_set_view_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rmap_view_set_view_changed_callback(self.FId, DoOnMapView,
        GMapViews.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// The credit written in a corner (the tiles' source: "© OpenStreetMap"; "": none).
    /// C: Rmap_view_set_attribution
    const method Attribution(const AText: string): self;
    begin
      Rmap_view_set_attribution(self.FId, AText);
      return self;
    end;

    /// C: Rmap_view_get_attribution
    const method Attribution(): string;
    begin
      return DoRavenText(Rmap_view_get_attribution(self.FId));
    end;
  end;

  /// A PDF the program writes: pages of a size in points (1/72 inch, from the top-left, y
  /// down; A4 595.28 x 841.89), drawn with shapes, text in an embedded font (Roboto, Roboto
  /// Mono, or a TrueType font added), pictures and windows; saved, kept in memory or
  /// printed. Drawing goes to the last page added (an A4 page is added when there is none).
  /// A shared handle: the last copy deletes the document, the app's end too.
  /// C: Rpdf_document_* (Rpdf_document_delete: the last copy's release)
  /// @example `LDoc := UIPDFDocRes("Invoice"); LDoc.AddPage(595.28f, 841.89f).Font(UIPDFFont.Sans, 24.0f, [UIPDFText.Bold]).Text(UIPoint(x: 56.0f, y: 56.0f), "Invoice 2026-114"); LDoc.Save("invoice.pdf");`
  UIPDFDocRes = object
    hidden FHold: ref UIPDFDocHold;

    /// An empty handle (holds no document: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
    end;

    /// A new document with no pages, titled `ATitle` ("": no title; the app must be open).
    /// C: Rpdf_document_create, Rpdf_document_set_title
    init(const ATitle: string);
    var
      LHold: ref UIPDFDocHold;
      LDoc: Rid;
    begin
      LDoc := Rpdf_document_create();
      if LDoc = R_INVALID_ID then
        return;
      end;
      LHold := ref UIPDFDocHold();
      LHold.FDoc := LDoc;
      LHold.Live := true;
      DoTrackRes(LHold);
      self.FHold := LHold;
      if ATitle <> "" then
        Rpdf_document_set_title(LDoc, ATitle);
      end;
    end;

    /// `true` while it holds a document.
    const method IsValid(): bool;
    begin
      return (self.FHold <> nil) and not self.FHold.Released;
    end;

    /// The document's Rid, for .C calls (`R_INVALID_ID` when the handle holds none or it is
    /// deleted).
    const method Id(): Rid;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return R_INVALID_ID;
      end;
      return self.FHold.FDoc;
    end;

    /// The title readers show. C: Rpdf_document_set_title
    const method Title(const ATitle: string): self;
    begin
      Rpdf_document_set_title(self.Id(), ATitle);
      return self;
    end;

    /// The author readers show. C: Rpdf_document_set_author
    const method Author(const AAuthor: string): self;
    begin
      Rpdf_document_set_author(self.Id(), AAuthor);
      return self;
    end;

    /// The subject readers show. C: Rpdf_document_set_subject
    const method Subject(const ASubject: string): self;
    begin
      Rpdf_document_set_subject(self.Id(), ASubject);
      return self;
    end;

    /// A new page `AWidth` x `AHeight` points; drawing goes to it. C: Rpdf_document_add_page
    const method AddPage(const AWidth: float32; const AHeight: float32): self;
    begin
      Rpdf_document_add_page(self.Id(), AWidth, AHeight);
      return self;
    end;

    /// The pages it has. C: Rpdf_document_get_page_count
    const method PageCount(): int32;
    begin
      return Rpdf_document_get_page_count(self.Id());
    end;

    /// The colour shapes are filled and text is written with. C: Rpdf_document_set_fill_color
    const method FillColor(const AColor: UIColor): self;
    begin
      Rpdf_document_set_fill_color(self.Id(), AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// The colour of lines and outlines. C: Rpdf_document_set_stroke_color
    const method StrokeColor(const AColor: UIColor): self;
    begin
      Rpdf_document_set_stroke_color(self.Id(), AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// The width of lines and outlines, in points (1 at first). C: Rpdf_document_set_line_width
    const method LineWidth(const AWidth: float32): self;
    begin
      Rpdf_document_set_line_width(self.Id(), AWidth);
      return self;
    end;

    /// `ARect` filled and / or outlined as `APaint` says, its corners rounded by `ARadius`.
    /// C: Rpdf_document_draw_rect
    const method Rect(const ARect: UIRect; const ARadius: float32; const APaint: UIPDFPaints): self;
    begin
      Rpdf_document_draw_rect(self.Id(), ARect.x, ARect.y, ARect.w, ARect.h, ARadius, uint32(APaint));
      return self;
    end;

    /// The ellipse inside `ARect`, filled and / or outlined as `APaint` says.
    /// C: Rpdf_document_draw_ellipse
    const method Ellipse(const ARect: UIRect; const APaint: UIPDFPaints): self;
    begin
      Rpdf_document_draw_ellipse(self.Id(), ARect.x, ARect.y, ARect.w, ARect.h, uint32(APaint));
      return self;
    end;

    /// A line from `AFrom` to `ATo` in the stroke colour. C: Rpdf_document_draw_line
    const method Line(const AFrom: UIPoint; const ATo: UIPoint): self;
    begin
      Rpdf_document_draw_line(self.Id(), AFrom.x, AFrom.y, ATo.x, ATo.y);
      return self;
    end;

    /// A TrueType font from `AData` (copied, embedded in the file). C: Rpdf_document_add_font
    /// @returns its number for `Font`, -1 when it is not a TrueType font
    const method AddFont(const AData: array of uint8): int32;
    begin
      if len(AData) = 0 then
        return Rpdf_document_add_font(self.Id(), nil, 0);
      end;
      return Rpdf_document_add_font(self.Id(), ptr to const char(addr of AData[0]), uint64(len(AData)));
    end;

    /// A TrueType font from the file `APath` (embedded in the document).
    /// C: Rpdf_document_add_font_from_file
    /// @returns its number for `Font`, -1 when it is not a TrueType font
    const method AddFontFile(const APath: string): int32;
    begin
      return Rpdf_document_add_font_from_file(self.Id(), APath);
    end;

    /// The text written next set in one of Raven's fonts, `ASize` points, in `AStyle`.
    /// C: Rpdf_document_set_font
    const method Font(const AFont: UIPDFFont; const ASize: float32; const AStyle: UIPDFTexts): self;
    begin
      Rpdf_document_set_font(self.Id(), int32(AFont), ASize, uint32(AStyle));
      return self;
    end;

    /// The text written next set in the font `AFont` added (`AddFont`), `ASize` points, in
    /// `AStyle`. C: Rpdf_document_set_font
    const method Font(const AFont: int32; const ASize: float32; const AStyle: UIPDFTexts): self;
    begin
      Rpdf_document_set_font(self.Id(), AFont, ASize, uint32(AStyle));
      return self;
    end;

    /// The distance between two lines of text in the current font. C: Rpdf_document_get_line_height
    const method LineHeight(): float32;
    begin
      return Rpdf_document_get_line_height(self.Id());
    end;

    /// The width of `AText` in the current font, in points (its widest line).
    /// C: Rpdf_document_measure_text
    const method Measure(const AText: string): float32;
    begin
      return Rpdf_document_measure_text(self.Id(), AText);
    end;

    /// `AText` in the fill colour, the top of its first line at `AAt` ("\n" starts a line
    /// below). C: Rpdf_document_draw_text
    /// @returns its width
    const method Text(const AAt: UIPoint; const AText: string): float32;
    begin
      return Rpdf_document_draw_text(self.Id(), AAt.x, AAt.y, AText);
    end;

    /// `AText` wrapped at its spaces to fit `AWidth` from `AAt`, each line placed by `AAlign`.
    /// C: Rpdf_document_draw_paragraph
    /// @returns the height it took
    const method Paragraph(const AAt: UIPoint; const AWidth: float32; const AText: string;
      const AAlign: UIHAlign): float32;
    begin
      return Rpdf_document_draw_paragraph(self.Id(), AAt.x, AAt.y, AWidth, AText, int32(AAlign));
    end;

    /// A picture of `AWidth` x `AHeight` RGBA pixels (rows from the top) stretched over
    /// `ARect` (a width or height of 0 keeps its proportions; both 0: 96 pixels per inch).
    /// C: Rpdf_document_draw_image
    const method Image(const ARect: UIRect; const APixels: array of uint8; const AWidth: int32;
      const AHeight: int32): self;
    begin
      if (AWidth <= 0) or (AHeight <= 0) or (len(APixels) < int64(AWidth) * int64(AHeight) * 4) then
        return self;
      end;
      Rpdf_document_draw_image(self.Id(), ARect.x, ARect.y, ARect.w, ARect.h, addr of APixels[0],
        AWidth, AHeight);
      return self;
    end;

    /// What the window `AWindow` shows, as a picture over `ARect` (a size of 0 x 0: its size
    /// on the screen). C: Rpdf_document_draw_window
    /// @returns `false` when the window cannot be captured
    const method DrawWindow(const AWindow: UIWindow; const ARect: UIRect): bool;
    begin
      return Rpdf_document_draw_window(self.Id(), AWindow.Id(), ARect.x, ARect.y, ARect.w,
        ARect.h) <> 0;
    end;

    /// The document written to the file `APath`. C: Rpdf_document_save
    /// @returns `false` when it cannot be written
    const method Save(const APath: string): bool;
    begin
      return Rpdf_document_save(self.Id(), APath) <> 0;
    end;

    /// The document's file in memory (empty when it holds none). C: Rpdf_document_save_memory,
    /// Rmemory_free
    const method ToMemory(): array of uint8;
    var
      LData: ptr to char;
      LBytes: ptr to uint8;
      LSize: uint64;
      LFile: array of uint8;
      LI: int64;
    begin
      setlength(LFile, 0);
      LSize := 0;
      LData := Rpdf_document_save_memory(self.Id(), addr of LSize);
      if LData = nil then
        return LFile;
      end;
      LBytes := ptr to uint8(LData);
      setlength(LFile, int64(LSize));
      for LI := 0 to len(LFile) - 1 do
        LFile[LI] := LBytes[LI];
      end;
      Rmemory_free(ptr(LData));
      return LFile;
    end;

    /// The document printed as `ADesc` says. Waits until the job is sent.
    /// C: Rpdf_document_print
    /// @returns `false` when cancelled or when it cannot print
    const method Print(const ADesc: UIPrintDesc): bool;
    var
      LTitle: CString;
      LPrinter: CString;
      LOutput: CString;
      LPassword: CString;
      LDesc: RPdfPrintDesc;
    begin
      DoPrintDesc(ADesc, LTitle, LPrinter, LOutput, LPassword, LDesc);
      return Rpdf_document_print(self.Id(), addr of LDesc) <> 0;
    end;

    /// The PDF in `APDF` printed as `ADesc` says (Windows: the pages drawn by PDFium; macOS:
    /// the print panel; elsewhere CUPS after Raven's printer dialog). Waits until the job is
    /// sent. C: Rpdf_print
    /// @returns `false` when cancelled or when it cannot print
    static method PrintMemory(const APDF: array of uint8; const ADesc: UIPrintDesc): bool;
    var
      LTitle: CString;
      LPrinter: CString;
      LOutput: CString;
      LPassword: CString;
      LDesc: RPdfPrintDesc;
    begin
      if len(APDF) = 0 then
        return false;
      end;
      DoPrintDesc(ADesc, LTitle, LPrinter, LOutput, LPassword, LDesc);
      return Rpdf_print(addr of LDesc, ptr to const char(addr of APDF[0]), uint64(len(APDF))) <> 0;
    end;

    /// The PDF file `APath` printed as `ADesc` says. Waits until the job is sent.
    /// C: Rpdf_print_file
    /// @returns `false` when cancelled or when it cannot print
    static method PrintFile(const APath: string; const ADesc: UIPrintDesc): bool;
    var
      LTitle: CString;
      LPrinter: CString;
      LOutput: CString;
      LPassword: CString;
      LDesc: RPdfPrintDesc;
    begin
      DoPrintDesc(ADesc, LTitle, LPrinter, LOutput, LPassword, LDesc);
      return Rpdf_print_file(addr of LDesc, APath) <> 0;
    end;
  end;

// ============================================================================
// Tools and shell widgets (listing sec 6, V8). UITimeline (tracks of clips
// and keys, markers, a playhead), UINodeGraph (nodes with input / output
// pins linked by wires), UIBlockEditor (scripts of snapping blocks built
// from kinds the program declares), UIDockArea (panels docked, tabbed and
// torn off), UIIsland (a pill that unfolds; a window's own island through
// UIWindow.Island), UIHeaderBar (a window's own title bar) and
// UIBackgroundBlur (a frosted backdrop). The parts Raven names by id (a
// timeline's tracks and items, a graph's nodes, pins and links, an
// editor's blocks: 0 names none) and a dock area's panels (the panel's
// widget) are value views: (the widget, the part), copied freely, never
// owners. Their closures live in the GControl* tables and the V8 tables
// below, released with the widget (DoDropToolControls). Raven runs them for
// the user's actions only: a change made through the API tells no closure
// (UIIsland.Expanded, UITimeline.Time, a link made by Connect).
// ============================================================================

public forward type UITimelineItem;
public forward type UIGraphPin;
public forward type UIGraphLink;
public forward type UIDockArea;

public type
  /// A span of a timeline, in seconds: from `First` to `Last`.
  UITimeSpan = record
    First: float64;
    Last: float64;
  end;

  /// Where a canvas view stands: the point it is at (a node graph's center, a block
  /// editor's scroll), in canvas units, and its zoom.
  UICanvasView = record
    Place: UIPoint;
    Zoom: float32;
  end;

  /// Where a block hangs on the block it hangs from (`UIBlock.Parent`): after it (Next), in
  /// one of its mouths (Body, `Index` the mouth) or in one of its slots (Input, `Index` the
  /// slot).
  UIBlockSpot = record
    Part: UIBlockPart;
    Index: int32;
  end;

  /// One track of a `UITimeline`: a view of (the timeline, the track's id), copied freely;
  /// the id stays the track's while others come and go. C: Rtimeline_*_track_*
  UITrack = object
    hidden FTimeline: Rid;
    hidden FTrack: int32;

    /// An empty track handle (names none).
    init();
    begin
      self.FTimeline := R_INVALID_ID;
      self.FTrack := 0;
    end;

    /// The track with the id `ATrack` on the timeline `ATimeline` (a Rid).
    static method Wrap(const ATimeline: Rid; const ATrack: int32): UITrack;
    var
      LTrack: UITrack;
    begin
      LTrack.FTimeline := ATimeline;
      LTrack.FTrack := ATrack;
      return LTrack;
    end;

    /// The track's id (0 when it names none).
    const method Id(): int32;
    begin
      return self.FTrack;
    end;

    /// `true` when it names a track (Raven gives 0 for none).
    const method IsValid(): bool;
    begin
      return (self.FTimeline <> R_INVALID_ID) and (self.FTrack <> 0);
    end;

    /// The name shown in its header. C: Rtimeline_set_track_name
    const method Name(const AName: string): self;
    begin
      Rtimeline_set_track_name(self.FTimeline, self.FTrack, AName);
      return self;
    end;

    /// C: Rtimeline_get_track_name
    const method Name(): string;
    begin
      return DoRavenText(Rtimeline_get_track_name(self.FTimeline, self.FTrack));
    end;

    /// The colour of its clips (`AColor`'s alpha is not used). C: Rtimeline_set_track_color
    const method Color(const AColor: UIColor): self;
    begin
      Rtimeline_set_track_color(self.FTimeline, self.FTrack, AColor.r, AColor.g, AColor.b);
      return self;
    end;

    /// Its height in logical units (the timeline's default until set).
    /// C: Rtimeline_set_track_height
    const method Height(const AHeight: float32): self;
    begin
      Rtimeline_set_track_height(self.FTimeline, self.FTrack, AHeight);
      return self;
    end;

    /// `true`: the user cannot move, stretch or delete its items. C: Rtimeline_set_track_locked
    const method Locked(const AOn: bool): self;
    begin
      Rtimeline_set_track_locked(self.FTimeline, self.FTrack, DoCBool(AOn));
      return self;
    end;

    /// `true`: shown muted (its clips dimmed). C: Rtimeline_set_track_muted
    const method Muted(const AOn: bool): self;
    begin
      Rtimeline_set_track_muted(self.FTimeline, self.FTrack, DoCBool(AOn));
      return self;
    end;

    /// C: Rtimeline_is_track_muted
    const method Muted(): bool;
    begin
      return Rtimeline_is_track_muted(self.FTimeline, self.FTrack) <> 0;
    end;

    /// One style property of the track (as the theme's: "Clip.Radius" ..; "" or "Default"
    /// gives back the timeline's); `false` when the name or the value is not one.
    /// C: Rtimeline_set_track_style
    const method Style(const AProperty: string; const AValue: string): bool;
    begin
      return Rtimeline_set_track_style(self.FTimeline, self.FTrack, AProperty, AValue) <> 0;
    end;

    /// The track removed with its items. C: Rtimeline_remove_track
    const method Remove();
    begin
      Rtimeline_remove_track(self.FTimeline, self.FTrack);
    end;

  end;

  /// One item of a `UITimeline` (a clip, a key or a marker): a view of (the timeline, the
  /// item's id), copied freely. C: Rtimeline_*_item_*
  UITimelineItem = object
    hidden FTimeline: Rid;
    hidden FItem: int32;

    /// An empty item handle (names none).
    init();
    begin
      self.FTimeline := R_INVALID_ID;
      self.FItem := 0;
    end;

    /// The item with the id `AItem` on the timeline `ATimeline` (a Rid).
    static method Wrap(const ATimeline: Rid; const AItem: int32): UITimelineItem;
    var
      LItem: UITimelineItem;
    begin
      LItem.FTimeline := ATimeline;
      LItem.FItem := AItem;
      return LItem;
    end;

    /// The item's id (0 when it names none).
    const method Id(): int32;
    begin
      return self.FItem;
    end;

    /// `true` when it names an item (Raven gives 0 for none).
    const method IsValid(): bool;
    begin
      return (self.FTimeline <> R_INVALID_ID) and (self.FItem <> 0);
    end;

    /// What it is: a clip, a key or a marker. C: Rtimeline_get_item_type
    const method ItemKind(): UITimelineItemKind;
    begin
      return UITimelineItemKind(Rtimeline_get_item_type(self.FTimeline, self.FItem));
    end;

    /// The track it is on (none for a marker). C: Rtimeline_get_item_track
    const method Track(): UITrack;
    begin
      return UITrack.Wrap(self.FTimeline, Rtimeline_get_item_track(self.FTimeline, self.FItem));
    end;

    /// Where it starts, in seconds. C: Rtimeline_get_item_start
    const method Start(): float64;
    begin
      return Rtimeline_get_item_start(self.FTimeline, self.FItem);
    end;

    /// A clip's length in seconds (0 for a key or a marker). C: Rtimeline_get_item_length
    const method Length(): float64;
    begin
      return Rtimeline_get_item_length(self.FTimeline, self.FItem);
    end;

    /// The item moved to the track `ATrack` from `AStart` for `ALength` seconds (a key or a
    /// marker takes no length). C: Rtimeline_set_item
    const method Move(const ATrack: UITrack; const AStart: float64; const ALength: float64): self;
    begin
      Rtimeline_set_item(self.FTimeline, self.FItem, ATrack.Id(), AStart, ALength);
      return self;
    end;

    /// The text shown on it. C: Rtimeline_set_item_label
    const method Label(const ALabel: string): self;
    begin
      Rtimeline_set_item_label(self.FTimeline, self.FItem, ALabel);
      return self;
    end;

    /// C: Rtimeline_get_item_label
    const method Label(): string;
    begin
      return DoRavenText(Rtimeline_get_item_label(self.FTimeline, self.FItem));
    end;

    /// Its own colour (`AColor`'s alpha is not used). C: Rtimeline_set_item_color
    const method Color(const AColor: UIColor): self;
    begin
      Rtimeline_set_item_color(self.FTimeline, self.FItem, AColor.r, AColor.g, AColor.b);
      return self;
    end;

    /// One style property of the item, as `UITrack.Style`. C: Rtimeline_set_item_style
    const method Style(const AProperty: string; const AValue: string): bool;
    begin
      return Rtimeline_set_item_style(self.FTimeline, self.FItem, AProperty, AValue) <> 0;
    end;

    /// The item selected; `AAdd` keeps the others selected. C: Rtimeline_select
    const method Select(const AAdd: bool): self;
    begin
      Rtimeline_select(self.FTimeline, self.FItem, DoCBool(AAdd));
      return self;
    end;

    /// C: Rtimeline_is_selected
    const method Selected(): bool;
    begin
      return Rtimeline_is_selected(self.FTimeline, self.FItem) <> 0;
    end;

    /// The item removed. C: Rtimeline_remove_item
    const method Remove();
    begin
      Rtimeline_remove_item(self.FTimeline, self.FItem);
    end;
  end;

// UITrack's members naming UITimelineItem
public extend UITrack
  /// A new clip on the track from `AStart` for `ALength` seconds, labelled `ALabel`.
  /// C: Rtimeline_add_clip
  const method AddClip(const AStart: float64; const ALength: float64; const ALabel: string): UITimelineItem;
  begin
    return UITimelineItem.Wrap(self.FTimeline,
      Rtimeline_add_clip(self.FTimeline, self.FTrack, AStart, ALength, ALabel));
  end;

  /// A new key on the track at `ATime` seconds. C: Rtimeline_add_key
  const method AddKey(const ATime: float64): UITimelineItem;
  begin
    return UITimelineItem.Wrap(self.FTimeline, Rtimeline_add_key(self.FTimeline, self.FTrack, ATime));
  end;
end;

public type
  /// One node of a `UINodeGraph`: a view of (the graph, the node's id), copied freely.
  /// C: Rnode_graph_*_node_*
  UIGraphNode = object
    hidden FGraph: Rid;
    hidden FNode: int32;

    /// An empty node handle (names none).
    init();
    begin
      self.FGraph := R_INVALID_ID;
      self.FNode := 0;
    end;

    /// The node with the id `ANode` on the graph `AGraph` (a Rid).
    static method Wrap(const AGraph: Rid; const ANode: int32): UIGraphNode;
    var
      LNode: UIGraphNode;
    begin
      LNode.FGraph := AGraph;
      LNode.FNode := ANode;
      return LNode;
    end;

    /// The node's id (0 when it names none).
    const method Id(): int32;
    begin
      return self.FNode;
    end;

    /// `true` when it names a node (Raven gives 0 for none).
    const method IsValid(): bool;
    begin
      return (self.FGraph <> R_INVALID_ID) and (self.FNode <> 0);
    end;

    /// The text in its header. C: Rnode_graph_set_node_title
    const method Title(const ATitle: string): self;
    begin
      Rnode_graph_set_node_title(self.FGraph, self.FNode, ATitle);
      return self;
    end;

    /// C: Rnode_graph_get_node_title
    const method Title(): string;
    begin
      return DoRavenText(Rnode_graph_get_node_title(self.FGraph, self.FNode));
    end;

    /// Where its top left stands, in canvas units. C: Rnode_graph_set_node_position
    const method Position(const APosition: UIPoint): self;
    begin
      Rnode_graph_set_node_position(self.FGraph, self.FNode, APosition.x, APosition.y);
      return self;
    end;

    /// C: Rnode_graph_get_node_position
    const method Position(): UIPoint;
    var
      LPoint: UIPoint;
    begin
      LPoint.x := 0.0f;
      LPoint.y := 0.0f;
      Rnode_graph_get_node_position(self.FGraph, self.FNode, addr of LPoint.x, addr of LPoint.y);
      return LPoint;
    end;

    /// Its size, in canvas units (from its pins and content). C: Rnode_graph_get_node_size
    const method Size(): UISize;
    var
      LSize: UISize;
    begin
      LSize.w := 0.0f;
      LSize.h := 0.0f;
      Rnode_graph_get_node_size(self.FGraph, self.FNode, addr of LSize.w, addr of LSize.h);
      return LSize;
    end;

    /// The colour of its header (`AColor`'s alpha is not used). C: Rnode_graph_set_node_color
    const method Color(const AColor: UIColor): self;
    begin
      Rnode_graph_set_node_color(self.FGraph, self.FNode, AColor.r, AColor.g, AColor.b);
      return self;
    end;

    /// One style property of the node ("Header.Gradient", "Node.ShadowSize" ..; "" or
    /// "Default" gives back the graph's); `false` when the name or the value is not one.
    /// C: Rnode_graph_set_node_style
    const method Style(const AProperty: string; const AValue: string): bool;
    begin
      return Rnode_graph_set_node_style(self.FGraph, self.FNode, AProperty, AValue) <> 0;
    end;

    /// A widget shown in its body, under its pins (a value to edit, a preview).
    /// C: Rnode_graph_set_node_content
    const method Content(const AWidget: UIWidget): self;
    begin
      Rnode_graph_set_node_content(self.FGraph, self.FNode, AWidget.Id());
      return self;
    end;

    /// C: Rnode_graph_get_node_content
    const method Content(): UIWidget;
    begin
      return UIWidget.Wrap(Rnode_graph_get_node_content(self.FGraph, self.FNode));
    end;

    /// The name it is found by (`UINodeGraph.FindNode`). C: Rnode_graph_set_node_name
    const method Name(const AName: string): self;
    begin
      Rnode_graph_set_node_name(self.FGraph, self.FNode, AName);
      return self;
    end;

    /// C: Rnode_graph_get_node_name
    const method Name(): string;
    begin
      return DoRavenText(Rnode_graph_get_node_name(self.FGraph, self.FNode));
    end;

    /// A pointer of the program's kept with the node (Raven never reads it).
    /// C: Rnode_graph_set_node_user_data
    const method UserData(const AData: ptr): self;
    begin
      Rnode_graph_set_node_user_data(self.FGraph, self.FNode, AData);
      return self;
    end;

    /// C: Rnode_graph_get_node_user_data
    const method UserData(): ptr;
    begin
      return Rnode_graph_get_node_user_data(self.FGraph, self.FNode);
    end;

    /// The node selected; `AAdd` keeps the others selected. C: Rnode_graph_select_node
    const method Select(const AAdd: bool): self;
    begin
      Rnode_graph_select_node(self.FGraph, self.FNode, DoCBool(AAdd));
      return self;
    end;

    /// C: Rnode_graph_is_node_selected
    const method Selected(): bool;
    begin
      return Rnode_graph_is_node_selected(self.FGraph, self.FNode) <> 0;
    end;

    /// `true`: drawn as running (its outline lit). C: Rnode_graph_set_node_active
    const method Active(const AOn: bool): self;
    begin
      Rnode_graph_set_node_active(self.FGraph, self.FNode, DoCBool(AOn));
      return self;
    end;

    /// The colour it is lit with while active (`AColor`'s alpha is not used).
    /// C: Rnode_graph_set_node_active_color
    const method ActiveColor(const AColor: UIColor): self;
    begin
      Rnode_graph_set_node_active_color(self.FGraph, self.FNode, AColor.r, AColor.g, AColor.b);
      return self;
    end;

    /// `false`: the Delete key does not remove it (a graph's output, a tree's root).
    /// C: Rnode_graph_set_node_deletable
    const method Deletable(const AOn: bool): self;
    begin
      Rnode_graph_set_node_deletable(self.FGraph, self.FNode, DoCBool(AOn));
      return self;
    end;

    /// The node shown at once, without the pop-in a node added to a shown graph gets (a
    /// program rebuilding its graph). C: Rnode_graph_set_node_shown
    const method ShowAtOnce(): self;
    begin
      Rnode_graph_set_node_shown(self.FGraph, self.FNode);
      return self;
    end;

    /// A short text in a chip on its header ("": none). C: Rnode_graph_set_node_badge
    const method Badge(const AText: string): self;
    begin
      Rnode_graph_set_node_badge(self.FGraph, self.FNode, AText);
      return self;
    end;

    /// The colour of its badge (`AColor`'s alpha is not used).
    /// C: Rnode_graph_set_node_badge_color
    const method BadgeColor(const AColor: UIColor): self;
    begin
      Rnode_graph_set_node_badge_color(self.FGraph, self.FNode, AColor.r, AColor.g, AColor.b);
      return self;
    end;

    /// The node removed with its pins and links. C: Rnode_graph_remove_node
    const method Remove();
    begin
      Rnode_graph_remove_node(self.FGraph, self.FNode);
    end;

    /// `ATexture` as the icon before the node's title (an empty handle removes it); kept
    /// while it is set (the graph's, shared by any of its nodes). C: Rnode_graph_set_node_icon
    const method Icon(const ATexture: UITextureRes): self;
    begin
      Rnode_graph_set_node_icon(self.FGraph, self.FNode, ATexture.Id());
      DoHookDestroy(self.FGraph);
      DoKeepTexture(self.FGraph, ADAM_RAVEN_KEEP_NODE | uint32(self.FNode), ATexture);
      return self;
    end;
  end;

  /// One pin of a `UINodeGraph`'s node (an input or an output): a view of (the graph, the
  /// pin's id), copied freely. C: Rnode_graph_*_pin_*
  UIGraphPin = object
    hidden FGraph: Rid;
    hidden FPin: int32;

    /// An empty pin handle (names none).
    init();
    begin
      self.FGraph := R_INVALID_ID;
      self.FPin := 0;
    end;

    /// The pin with the id `APin` on the graph `AGraph` (a Rid).
    static method Wrap(const AGraph: Rid; const APin: int32): UIGraphPin;
    var
      LPin: UIGraphPin;
    begin
      LPin.FGraph := AGraph;
      LPin.FPin := APin;
      return LPin;
    end;

    /// The pin's id (0 when it names none).
    const method Id(): int32;
    begin
      return self.FPin;
    end;

    /// `true` when it names a pin (Raven gives 0 for none).
    const method IsValid(): bool;
    begin
      return (self.FGraph <> R_INVALID_ID) and (self.FPin <> 0);
    end;

    /// The node it belongs to. C: Rnode_graph_get_pin_node
    const method Node(): UIGraphNode;
    begin
      return UIGraphNode.Wrap(self.FGraph, Rnode_graph_get_pin_node(self.FGraph, self.FPin));
    end;

    /// `true` for an output pin. C: Rnode_graph_is_pin_output
    const method IsOutput(): bool;
    begin
      return Rnode_graph_is_pin_output(self.FGraph, self.FPin) <> 0;
    end;

    /// The text beside it. C: Rnode_graph_get_pin_label
    const method Label(): string;
    begin
      return DoRavenText(Rnode_graph_get_pin_label(self.FGraph, self.FPin));
    end;

    /// The type it was added with ("": links to any type). C: Rnode_graph_get_pin_type
    const method PinType(): string;
    begin
      return DoRavenText(Rnode_graph_get_pin_type(self.FGraph, self.FPin));
    end;

    /// The name it is found by (`UIGraphNode.FindPin`; its label until set).
    /// C: Rnode_graph_set_pin_name
    const method Name(const AName: string): self;
    begin
      Rnode_graph_set_pin_name(self.FGraph, self.FPin, AName);
      return self;
    end;

    /// Where it is drawn, in canvas units. C: Rnode_graph_get_pin_position
    const method Position(): UIPoint;
    var
      LPoint: UIPoint;
    begin
      LPoint.x := 0.0f;
      LPoint.y := 0.0f;
      Rnode_graph_get_pin_position(self.FGraph, self.FPin, addr of LPoint.x, addr of LPoint.y);
      return LPoint;
    end;

    /// One style property of the pin, as `UIGraphNode.Style`. C: Rnode_graph_set_pin_style
    const method Style(const AProperty: string; const AValue: string): bool;
    begin
      return Rnode_graph_set_pin_style(self.FGraph, self.FPin, AProperty, AValue) <> 0;
    end;

    /// `true`: an input taking more than one link. C: Rnode_graph_set_pin_multiple
    const method Multiple(const AOn: bool): self;
    begin
      Rnode_graph_set_pin_multiple(self.FGraph, self.FPin, DoCBool(AOn));
      return self;
    end;

    /// A short text in a chip beside it ("": none; `UINodeGraph.TagAt` finds it).
    /// C: Rnode_graph_set_pin_tag
    const method Tag(const AText: string): self;
    begin
      Rnode_graph_set_pin_tag(self.FGraph, self.FPin, AText);
      return self;
    end;

    /// `true`: its tag drawn lit. C: Rnode_graph_set_pin_tag_lit
    const method TagLit(const AOn: bool): self;
    begin
      Rnode_graph_set_pin_tag_lit(self.FGraph, self.FPin, DoCBool(AOn));
      return self;
    end;

    /// 1: drawn as the pin to go to, -1 stepped back, 0 as usual (linking in two clicks).
    /// C: Rnode_graph_set_pin_emphasis
    const method Emphasis(const AEmphasis: int32): self;
    begin
      Rnode_graph_set_pin_emphasis(self.FGraph, self.FPin, AEmphasis);
      return self;
    end;

    /// The pin removed with its links. C: Rnode_graph_remove_pin
    const method Remove();
    begin
      Rnode_graph_remove_pin(self.FGraph, self.FPin);
    end;
  end;

  /// One link of a `UINodeGraph` (a wire from an output pin to an input pin): a view of (the
  /// graph, the link's id), copied freely. C: Rnode_graph_*_link_*
  UIGraphLink = object
    hidden FGraph: Rid;
    hidden FLink: int32;

    /// An empty link handle (names none).
    init();
    begin
      self.FGraph := R_INVALID_ID;
      self.FLink := 0;
    end;

    /// The link with the id `ALink` on the graph `AGraph` (a Rid).
    static method Wrap(const AGraph: Rid; const ALink: int32): UIGraphLink;
    var
      LLink: UIGraphLink;
    begin
      LLink.FGraph := AGraph;
      LLink.FLink := ALink;
      return LLink;
    end;

    /// The link's id (0 when it names none).
    const method Id(): int32;
    begin
      return self.FLink;
    end;

    /// `true` when it names a link (Raven gives 0 for none: pins that cannot be linked).
    const method IsValid(): bool;
    begin
      return (self.FGraph <> R_INVALID_ID) and (self.FLink <> 0);
    end;

    /// The output pin it leaves from. C: Rnode_graph_get_link_output
    const method Output(): UIGraphPin;
    begin
      return UIGraphPin.Wrap(self.FGraph, Rnode_graph_get_link_output(self.FGraph, self.FLink));
    end;

    /// The input pin it arrives at. C: Rnode_graph_get_link_input
    const method Input(): UIGraphPin;
    begin
      return UIGraphPin.Wrap(self.FGraph, Rnode_graph_get_link_input(self.FGraph, self.FLink));
    end;

    /// The link shown at once, without the animation a new link gets.
    /// C: Rnode_graph_set_link_shown
    const method ShowAtOnce(): self;
    begin
      Rnode_graph_set_link_shown(self.FGraph, self.FLink);
      return self;
    end;

    /// `true`: not drawn (and never under the pointer), still linking its pins.
    /// C: Rnode_graph_set_link_hidden
    const method Hidden(const AOn: bool): self;
    begin
      Rnode_graph_set_link_hidden(self.FGraph, self.FLink, DoCBool(AOn));
      return self;
    end;

    /// The link removed. C: Rnode_graph_disconnect
    const method Disconnect();
    begin
      Rnode_graph_disconnect(self.FGraph, self.FLink);
    end;
  end;

  /// One block of a `UIBlockEditor`: a view of (the editor, the block's id), copied freely.
  /// C: Rblock_editor_* (block)
  UIBlock = object
    hidden FEditor: Rid;
    hidden FBlock: int32;

    /// An empty block handle (names none).
    init();
    begin
      self.FEditor := R_INVALID_ID;
      self.FBlock := 0;
    end;

    /// The block with the id `ABlock` in the editor `AEditor` (a Rid).
    static method Wrap(const AEditor: Rid; const ABlock: int32): UIBlock;
    var
      LBlock: UIBlock;
    begin
      LBlock.FEditor := AEditor;
      LBlock.FBlock := ABlock;
      return LBlock;
    end;

    /// The block's id (0 when it names none).
    const method Id(): int32;
    begin
      return self.FBlock;
    end;

    /// `true` when it names a block (Raven gives 0 for none).
    const method IsValid(): bool;
    begin
      return (self.FEditor <> R_INVALID_ID) and (self.FBlock <> 0);
    end;

    /// The name of its kind (`UIBlockEditor.AddKind`). C: Rblock_editor_get_kind
    const method BlockKind(): string;
    begin
      return DoRavenText(Rblock_editor_get_kind(self.FEditor, self.FBlock));
    end;

    /// The block snapped under it (none at a script's end). C: Rblock_editor_get_next
    const method Next(): UIBlock;
    begin
      return UIBlock.Wrap(self.FEditor, Rblock_editor_get_next(self.FEditor, self.FBlock));
    end;

    /// How many mouths it has (a C block's). C: Rblock_editor_get_mouth_count
    const method MouthCount(): int32;
    begin
      return Rblock_editor_get_mouth_count(self.FEditor, self.FBlock);
    end;

    /// The first block in its mouth `AMouth` (none when empty). C: Rblock_editor_get_body
    const method Body(const AMouth: int32): UIBlock;
    begin
      return UIBlock.Wrap(self.FEditor, Rblock_editor_get_body(self.FEditor, self.FBlock, AMouth));
    end;

    /// How many slots its label has. C: Rblock_editor_get_slot_count
    const method SlotCount(): int32;
    begin
      return Rblock_editor_get_slot_count(self.FEditor, self.FBlock);
    end;

    /// The value block in its slot `ASlot` (none when the slot holds a typed value).
    /// C: Rblock_editor_get_input
    const method Input(const ASlot: int32): UIBlock;
    begin
      return UIBlock.Wrap(self.FEditor, Rblock_editor_get_input(self.FEditor, self.FBlock, ASlot));
    end;

    /// The typed value of its slot `ASlot`. C: Rblock_editor_set_value
    const method Value(const ASlot: int32; const AValue: string): self;
    begin
      Rblock_editor_set_value(self.FEditor, self.FBlock, ASlot, AValue);
      return self;
    end;

    /// C: Rblock_editor_get_value
    const method Value(const ASlot: int32): string;
    begin
      return DoRavenText(Rblock_editor_get_value(self.FEditor, self.FBlock, ASlot));
    end;

    /// The block it hangs from (none at a script's top); `Spot` says where.
    /// C: Rblock_editor_get_parent
    const method Parent(): UIBlock;
    var
      LPart: RBlockPlace;
      LIndex: int32;
    begin
      LPart := 0;
      LIndex := 0;
      return UIBlock.Wrap(self.FEditor,
        Rblock_editor_get_parent(self.FEditor, self.FBlock, addr of LPart, addr of LIndex));
    end;

    /// Where it hangs on its parent (`Parent`). C: Rblock_editor_get_parent
    const method Spot(): UIBlockSpot;
    var
      LPart: RBlockPlace;
      LSpot: UIBlockSpot;
    begin
      LPart := 0;
      LSpot.Index := 0;
      Rblock_editor_get_parent(self.FEditor, self.FBlock, addr of LPart, addr of LSpot.Index);
      LSpot.Part := UIBlockPart(LPart);
      return LSpot;
    end;

    /// Its top left, in canvas units. C: Rblock_editor_get_position
    const method Position(): UIPoint;
    var
      LPoint: UIPoint;
    begin
      LPoint.x := 0.0f;
      LPoint.y := 0.0f;
      Rblock_editor_get_position(self.FEditor, self.FBlock, addr of LPoint.x, addr of LPoint.y);
      return LPoint;
    end;

    /// `true`: drawn running (a halo breathes around it). C: Rblock_editor_set_block_glow
    const method Glow(const AOn: bool): self;
    begin
      Rblock_editor_set_block_glow(self.FEditor, self.FBlock, DoCBool(AOn));
      return self;
    end;

    /// `false`: the user cannot delete it. C: Rblock_editor_set_block_deletable
    const method Deletable(const AOn: bool): self;
    begin
      Rblock_editor_set_block_deletable(self.FEditor, self.FBlock, DoCBool(AOn));
      return self;
    end;

    /// The block selected; `AAdd` keeps the others selected. C: Rblock_editor_select
    const method Select(const AAdd: bool): self;
    begin
      Rblock_editor_select(self.FEditor, self.FBlock, DoCBool(AAdd));
      return self;
    end;

    /// The block (with what hangs under it) put at `APart` / `AIndex` of `ATarget`; `false`
    /// when it does not fit there. C: Rblock_editor_attach
    const method Attach(const ATarget: UIBlock; const APart: UIBlockPart; const AIndex: int32): bool;
    begin
      return Rblock_editor_attach(self.FEditor, self.FBlock, ATarget.Id(), int32(APart), AIndex) <> 0;
    end;

    /// The block (with what hangs under it) taken out: a script of its own at `AAt` (canvas
    /// units). C: Rblock_editor_detach
    const method Detach(const AAt: UIPoint): self;
    begin
      Rblock_editor_detach(self.FEditor, self.FBlock, AAt.x, AAt.y);
      return self;
    end;

    /// The block removed with what hangs under it. C: Rblock_editor_remove_block
    const method Remove();
    begin
      Rblock_editor_remove_block(self.FEditor, self.FBlock);
    end;
  end;

  /// One panel of a `UIDockArea`: a view of (the area, the panel's widget), copied freely.
  /// C: Rdock_area_*_panel*
  UIDockPanel = object
    hidden FArea: Rid;
    hidden FPanel: Rid;

    /// An empty panel handle (names none).
    init();
    begin
      self.FArea := R_INVALID_ID;
      self.FPanel := R_INVALID_ID;
    end;

    /// The panel `APanel` (its widget's Rid) of the area `AArea` (a Rid).
    static method Wrap(const AArea: Rid; const APanel: Rid): UIDockPanel;
    var
      LPanel: UIDockPanel;
    begin
      LPanel.FArea := AArea;
      LPanel.FPanel := APanel;
      return LPanel;
    end;

    /// `true` when it names a panel.
    const method IsValid(): bool;
    begin
      return (self.FArea <> R_INVALID_ID) and (self.FPanel <> R_INVALID_ID);
    end;

    /// The panel's widget (what was docked).
    const method Panel(): UIWidget;
    begin
      return UIWidget.Wrap(self.FPanel);
    end;

    /// The panel moved to the side `ASide` of `ARelative` (an empty `UIWidget()`: of the
    /// whole area), `ASize` its share (0 .. 1). C: Rdock_area_move_panel
    const method Move(const ASide: UIDockSide; const ARelative: UIWidget; const ASize: float32): self;
    begin
      Rdock_area_move_panel(self.FArea, self.FPanel, int32(ASide), ARelative.Id(), ASize);
      return self;
    end;

    /// The text of its tab. C: Rdock_area_set_panel_title
    const method Title(const ATitle: string): self;
    begin
      Rdock_area_set_panel_title(self.FArea, self.FPanel, ATitle);
      return self;
    end;

    /// `false`: its tab has no close button. C: Rdock_area_set_panel_closable
    const method Closable(const AOn: bool): self;
    begin
      Rdock_area_set_panel_closable(self.FArea, self.FPanel, DoCBool(AOn));
      return self;
    end;

    /// The panel closed as the user's close button does (deleted, or hidden with
    /// `UIDockArea.CloseHides`). C: Rdock_area_close_panel
    const method Close();
    begin
      Rdock_area_close_panel(self.FArea, self.FPanel);
    end;

    /// The panel taken out of the layout, kept for `Open`. C: Rdock_area_hide_panel
    const method Hide(): self;
    begin
      Rdock_area_hide_panel(self.FArea, self.FPanel);
      return self;
    end;

    /// A hidden panel put back where it was. C: Rdock_area_open_panel
    const method Open(): self;
    begin
      Rdock_area_open_panel(self.FArea, self.FPanel);
      return self;
    end;

    /// `true` while it is in the layout (not hidden). C: Rdock_area_is_panel_open
    const method IsOpen(): bool;
    begin
      return Rdock_area_is_panel_open(self.FArea, self.FPanel) <> 0;
    end;

    /// Its tab brought to the front (opened first when hidden). C: Rdock_area_show_panel
    const method Show(): self;
    begin
      Rdock_area_show_panel(self.FArea, self.FPanel);
      return self;
    end;

    /// `true` while its tab is the one in front. C: Rdock_area_is_panel_shown
    const method Shown(): bool;
    begin
      return Rdock_area_is_panel_shown(self.FArea, self.FPanel) <> 0;
    end;

    /// The panel floated at `AX`, `AY` (native mode: the screen; in-window mode: the window,
    /// logical units); the window it is in now. C: Rdock_area_float_panel
    const method Float(const AX: int32; const AY: int32): UIWindow;
    begin
      return UIWindow.Wrap(Rdock_area_float_panel(self.FArea, self.FPanel, AX, AY));
    end;

    /// A floating panel put back where it was in the area. C: Rdock_area_dock_panel
    const method Dock(): self;
    begin
      Rdock_area_dock_panel(self.FArea, self.FPanel);
      return self;
    end;

    /// The window a floating panel is in (empty while docked). C: Rdock_area_get_panel_window
    const method Window(): UIWindow;
    begin
      return UIWindow.Wrap(Rdock_area_get_panel_window(self.FArea, self.FPanel));
    end;

    /// The whole of `ATexture` as the icon before the panel's title (an empty handle removes
    /// it), drawn in its own colours; kept while it is set. C: Rdock_area_set_panel_icon
    const method Icon(const ATexture: UITextureRes): self;
    begin
      self.Icon(ATexture, UIPoint(x: 0.0f, y: 0.0f), UIPoint(x: 1.0f, y: 1.0f), false);
      return self;
    end;

    /// A part of `ATexture` as the panel's icon (an empty handle removes it); kept while it
    /// is set.
    /// `AUVMin` .. `AUVMax`: the part of the texture shown, as texture coordinates (0 .. 1)
    /// of its corners; `ATint` `true`: the texture is a mask drawn in the text colour.
    /// C: Rdock_area_set_panel_icon
    const method Icon(const ATexture: UITextureRes; const AUVMin: UIPoint; const AUVMax: UIPoint;
      const ATint: bool): self;
    begin
      Rdock_area_set_panel_icon(self.FArea, self.FPanel, ATexture.Id(), AUVMin.x, AUVMin.y,
        AUVMax.x, AUVMax.y, DoCBool(ATint));
      DoHookDestroy(self.FPanel);
      DoKeepTexture(self.FPanel, ADAM_RAVEN_KEEP_ICON, ATexture);
      return self;
    end;
  end;

// UIGraphNode's and UIGraphPin's members naming the later views
public extend UIGraphNode
  /// A new input pin labelled `ALabel` of the type `AType` ("": links to any type).
  /// C: Rnode_graph_add_input
  const method AddInput(const ALabel: string; const AType: string): UIGraphPin;
  var
    LType: CString;
  begin
    // "" goes to Raven as NULL: a pin that links to any type
    LType := CString(AType);
    return UIGraphPin.Wrap(self.FGraph, Rnode_graph_add_input(self.FGraph, self.FNode, ALabel,
      LType.OrNil));
  end;

  /// A new output pin labelled `ALabel` of the type `AType` ("": links to any type).
  /// C: Rnode_graph_add_output
  const method AddOutput(const ALabel: string; const AType: string): UIGraphPin;
  var
    LType: CString;
  begin
    // "" goes to Raven as NULL: a pin that links to any type
    LType := CString(AType);
    return UIGraphPin.Wrap(self.FGraph, Rnode_graph_add_output(self.FGraph, self.FNode, ALabel,
      LType.OrNil));
  end;

  /// Its input `AIndex` (from the top, 0 first). C: Rnode_graph_get_input
  const method Input(const AIndex: int32): UIGraphPin;
  begin
    return UIGraphPin.Wrap(self.FGraph, Rnode_graph_get_input(self.FGraph, self.FNode, AIndex));
  end;

  /// Its output `AIndex` (from the top, 0 first). C: Rnode_graph_get_output
  const method Output(const AIndex: int32): UIGraphPin;
  begin
    return UIGraphPin.Wrap(self.FGraph, Rnode_graph_get_output(self.FGraph, self.FNode, AIndex));
  end;

  /// Its pin named (or labelled) `AName` (none when it has no such pin).
  /// C: Rnode_graph_find_pin
  const method FindPin(const AName: string): UIGraphPin;
  begin
    return UIGraphPin.Wrap(self.FGraph, Rnode_graph_find_pin(self.FGraph, self.FNode, AName));
  end;
end;

public extend UIGraphPin
  /// The link arriving at this input (none when unlinked). C: Rnode_graph_get_input_link
  const method InputLink(): UIGraphLink;
  begin
    return UIGraphLink.Wrap(self.FGraph, Rnode_graph_get_input_link(self.FGraph, self.FPin));
  end;
end;

public type
  /// What `UITimeline.OnTime` runs when the playhead moves (scrubbed by the user, or
  /// playing): where it is, in seconds.
  UIPlayheadFunc = ref func(const ASeconds: float64);
  /// What a `UITimeline`'s item events run: the item (`OnSelect`: the item just clicked, or
  /// none).
  UITimelineItemFunc = ref func(const AItem: UITimelineItem);
  /// What `UINodeGraph.OnConnect` runs when the user is about to link two pins that may be
  /// linked: `false` refuses (a loop, a rule of the program).
  UIGraphConnectFunc = ref func(const AOutput: UIGraphPin; const AInput: UIGraphPin): bool;
  /// What `UINodeGraph.OnLinked` / `OnUnlinked` run: the link (an unlinked one's pins can
  /// still be read).
  UIGraphLinkFunc = ref func(const ALink: UIGraphLink);
  /// What a `UINodeGraph`'s node events run: the node (`OnSelect`: the node just clicked,
  /// or none).
  UIGraphNodeFunc = ref func(const ANode: UIGraphNode);
  /// What `UINodeGraph.OnContext` runs on a right click: the node under the pointer (none on
  /// the empty canvas) and the point, in the widget.
  UIGraphContextFunc = ref func(const ANode: UIGraphNode; const AAt: UIPoint);
  /// What `UINodeGraph.OnWireDropped` / `OnPinClick` run: the pin and the point, in canvas
  /// units.
  UIGraphPinFunc = ref func(const APin: UIGraphPin; const AAt: UIPoint);
  /// What `UINodeGraph.OnCanvasActivate` runs on a double click on the empty canvas: the
  /// point, in canvas units.
  UICanvasPointFunc = ref func(const AAt: UIPoint);
  /// What a `UIBlockEditor`'s block events run: the block.
  UIBlockFunc = ref func(const ABlock: UIBlock);
  /// What `UIBlockEditor.OnContext` runs on a right click: the block under the pointer
  /// (none on the empty canvas) and the point.
  UIBlockContextFunc = ref func(const ABlock: UIBlock; const AAt: UIPoint);
  /// What `UIDockArea.OnClose` runs when the user closes a panel, before it goes: `false`
  /// keeps it.
  UIDockCloseFunc = ref func(const APanel: UIDockPanel): bool;
  /// What `UIDockArea.FloatWindow` runs when a panel leaves for a window of its own, once
  /// the window and its floating area are made: the window's content (a widget holding
  /// `AFloating`), or an empty `UIWidget()` for `AFloating` itself.
  UIDockFloatFunc = ref func(const APanel: UIDockPanel; const AWindow: UIWindow;
    const AFloating: UIDockArea): UIWidget;

const
  // The events GTimelineItems' closures are held for
  ADAM_RAVEN_TIMELINE_CHANGED: int32 = 0;
  ADAM_RAVEN_TIMELINE_SELECT: int32 = 1;
  ADAM_RAVEN_TIMELINE_ACTIVATE: int32 = 2;
  ADAM_RAVEN_TIMELINE_REMOVED: int32 = 3;
  // GGraphLinks'
  ADAM_RAVEN_GRAPH_LINKED: int32 = 0;
  ADAM_RAVEN_GRAPH_UNLINKED: int32 = 1;
  // GGraphNodes'
  ADAM_RAVEN_GRAPH_MOVED: int32 = 0;
  ADAM_RAVEN_GRAPH_SELECT: int32 = 1;
  ADAM_RAVEN_GRAPH_REMOVED: int32 = 2;
  ADAM_RAVEN_GRAPH_ACTIVATE: int32 = 3;
  // GGraphPins'
  ADAM_RAVEN_GRAPH_WIRE_DROPPED: int32 = 0;
  ADAM_RAVEN_GRAPH_PIN_CLICK: int32 = 1;
  // GBlockEvents'
  ADAM_RAVEN_BLOCK_CHANGED: int32 = 0;
  ADAM_RAVEN_BLOCK_CLICK: int32 = 1;

var
  // V8's closures by (widget, event), released with the widget or the app as V7's
  GTimelineTimes: UISlots<UIPlayheadFunc>;
  GTimelineItems: UISlots<UITimelineItemFunc>;
  GGraphConnects: UISlots<UIGraphConnectFunc>;
  GGraphLinks: UISlots<UIGraphLinkFunc>;
  GGraphNodes: UISlots<UIGraphNodeFunc>;
  GGraphContexts: UISlots<UIGraphContextFunc>;
  GGraphPins: UISlots<UIGraphPinFunc>;
  GGraphCanvas: UISlots<UICanvasPointFunc>;
  GBlockEvents: UISlots<UIBlockFunc>;
  GBlockContexts: UISlots<UIBlockContextFunc>;
  GDockCloses: UISlots<UIDockCloseFunc>;
  GDockFloats: UISlots<UIDockFloatFunc>;
  GDockChanges: UISlots<UITaskFunc>;
  GIslandChanges: UISlots<UIToggleFunc>;

// The closures AWidget's timelines, graphs, block editors, dock areas and islands held
// released (R_INVALID_ID: every one, the app ends)
func DoDropToolControls(const AWidget: Rid);
begin
  if AWidget = R_INVALID_ID then
    GTimelineTimes.DropAll();
    GTimelineItems.DropAll();
    GGraphConnects.DropAll();
    GGraphLinks.DropAll();
    GGraphNodes.DropAll();
    GGraphContexts.DropAll();
    GGraphPins.DropAll();
    GGraphCanvas.DropAll();
    GBlockEvents.DropAll();
    GBlockContexts.DropAll();
    GDockCloses.DropAll();
    GDockFloats.DropAll();
    GDockChanges.DropAll();
    GIslandChanges.DropAll();
    return;
  end;
  GTimelineTimes.DropOwner(AWidget);
  GTimelineItems.DropOwner(AWidget);
  GGraphConnects.DropOwner(AWidget);
  GGraphLinks.DropOwner(AWidget);
  GGraphNodes.DropOwner(AWidget);
  GGraphContexts.DropOwner(AWidget);
  GGraphPins.DropOwner(AWidget);
  GGraphCanvas.DropOwner(AWidget);
  GBlockEvents.DropOwner(AWidget);
  GBlockContexts.DropOwner(AWidget);
  GDockCloses.DropOwner(AWidget);
  GDockFloats.DropOwner(AWidget);
  GDockChanges.DropOwner(AWidget);
  GIslandChanges.DropOwner(AWidget);
end;

// The point x, y as a UIPoint
func DoPointOf(const AX: float32; const AY: float32): UIPoint;
var
  LPoint: UIPoint;
begin
  LPoint.x := AX;
  LPoint.y := AY;
  return LPoint;
end;

// V8's trampolines, as V7's: each runs its closure on a copy; a closure the table no longer
// holds (its widget gone) is never reached; one that asks (connect, close) is allowed
// when there is none
func clink DoOnTimelineTime(timeline: Rid; seconds: float64; user_data: ptr);
var
  LFunc: UIPlayheadFunc;
begin
  if not GTimelineTimes.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(seconds);
end;

func clink DoOnTimelineItem(timeline: Rid; item: int32; user_data: ptr);
var
  LFunc: UITimelineItemFunc;
begin
  if not GTimelineItems.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UITimelineItem.Wrap(timeline, item));
end;

func clink DoOnGraphConnect(graph: Rid; output_pin: int32; input_pin: int32;
  user_data: ptr): int32;
var
  LFunc: UIGraphConnectFunc;
begin
  if not GGraphConnects.Find(user_data, LFunc) or (LFunc = nil) then
    return R_TRUE;
  end;
  return DoCBool(LFunc(UIGraphPin.Wrap(graph, output_pin), UIGraphPin.Wrap(graph, input_pin)));
end;

func clink DoOnGraphLink(graph: Rid; item: int32; user_data: ptr);
var
  LFunc: UIGraphLinkFunc;
begin
  if not GGraphLinks.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIGraphLink.Wrap(graph, item));
end;

func clink DoOnGraphNode(graph: Rid; item: int32; user_data: ptr);
var
  LFunc: UIGraphNodeFunc;
begin
  if not GGraphNodes.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIGraphNode.Wrap(graph, item));
end;

func clink DoOnGraphContext(graph: Rid; node: int32; x: float32; y: float32; user_data: ptr);
var
  LFunc: UIGraphContextFunc;
begin
  if not GGraphContexts.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIGraphNode.Wrap(graph, node), DoPointOf(x, y));
end;

func clink DoOnGraphPin(graph: Rid; item: int32; x: float32; y: float32; user_data: ptr);
var
  LFunc: UIGraphPinFunc;
begin
  if not GGraphPins.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIGraphPin.Wrap(graph, item), DoPointOf(x, y));
end;

func clink DoOnGraphCanvas(graph: Rid; item: int32; x: float32; y: float32; user_data: ptr);
var
  LFunc: UICanvasPointFunc;
begin
  if not GGraphCanvas.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(DoPointOf(x, y));
end;

func clink DoOnBlock(editor: Rid; block: int32; user_data: ptr);
var
  LFunc: UIBlockFunc;
begin
  if not GBlockEvents.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIBlock.Wrap(editor, block));
end;

func clink DoOnBlockContext(editor: Rid; block: int32; x: float32; y: float32; user_data: ptr);
var
  LFunc: UIBlockContextFunc;
begin
  if not GBlockContexts.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(UIBlock.Wrap(editor, block), DoPointOf(x, y));
end;

func clink DoOnDockClose(area: Rid; panel: Rid; user_data: ptr): int32;
var
  LFunc: UIDockCloseFunc;
begin
  if not GDockCloses.Find(user_data, LFunc) or (LFunc = nil) then
    return R_TRUE;
  end;
  return DoCBool(LFunc(UIDockPanel.Wrap(area, panel)));
end;

func clink DoOnDockChanged(area: Rid; user_data: ptr);
var
  LFunc: UITaskFunc;
begin
  if not GDockChanges.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc();
end;

func clink DoOnIslandChanged(island: Rid; expanded: int32; user_data: ptr);
var
  LFunc: UIToggleFunc;
begin
  if not GIslandChanges.Find(user_data, LFunc) or (LFunc = nil) then
    return;
  end;
  LFunc(expanded <> 0);
end;

public type
  /// A timeline: tracks of clips and keys, markers and a playhead, scrubbed, zoomed and
  /// edited by the user (an animation, a video or a sequence editor).
  /// @example `LTimeline := UITimeline.Create().Duration(10.0); LTrack := LTimeline.AddTrack("Video"); LTrack.AddClip(0.0, 4.0, "Intro");`
  UITimeline = object(UIWidget)
    /// A new timeline, 0 seconds long, with no tracks. C: Rtimeline_create
    static method Create(): UITimeline;
    var
      LWidget: UITimeline;
    begin
      LWidget.DoSet(Rtimeline_create());
      return LWidget;
    end;

    /// The kind a timeline views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Timeline];
    end;

    /// How long it runs, in seconds. C: Rtimeline_set_duration
    const method Duration(const ASeconds: float64): self;
    begin
      Rtimeline_set_duration(self.FId, ASeconds);
      return self;
    end;

    /// C: Rtimeline_get_duration
    const method Duration(): float64;
    begin
      return Rtimeline_get_duration(self.FId);
    end;

    /// Where the playhead stands, in seconds (no closure is told). C: Rtimeline_set_time
    const method Time(const ASeconds: float64): self;
    begin
      Rtimeline_set_time(self.FId, ASeconds);
      return self;
    end;

    /// C: Rtimeline_get_time
    const method Time(): float64;
    begin
      return Rtimeline_get_time(self.FId);
    end;

    /// The frames per second its ruler and snapping count in. C: Rtimeline_set_frame_rate
    const method FrameRate(const AFramesPerSecond: float64): self;
    begin
      Rtimeline_set_frame_rate(self.FId, AFramesPerSecond);
      return self;
    end;

    /// C: Rtimeline_get_frame_rate
    const method FrameRate(): float64;
    begin
      return Rtimeline_get_frame_rate(self.FId);
    end;

    /// `false`: items are placed anywhere, not on frames and other items' edges (Alt while
    /// dragging does it for one move). C: Rtimeline_set_snapping
    const method Snapping(const AOn: bool): self;
    begin
      Rtimeline_set_snapping(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The span shown, in seconds. C: Rtimeline_set_view
    const method View(const ASpan: UITimeSpan): self;
    begin
      Rtimeline_set_view(self.FId, ASpan.First, ASpan.Last);
      return self;
    end;

    /// C: Rtimeline_get_view
    const method View(): UITimeSpan;
    var
      LSpan: UITimeSpan;
    begin
      LSpan.First := 0.0;
      LSpan.Last := 0.0;
      Rtimeline_get_view(self.FId, addr of LSpan.First, addr of LSpan.Last);
      return LSpan;
    end;

    /// `true`: the playhead runs by itself. C: Rtimeline_set_playing
    const method Playing(const AOn: bool): self;
    begin
      Rtimeline_set_playing(self.FId, DoCBool(AOn));
      return self;
    end;

    /// C: Rtimeline_is_playing
    const method Playing(): bool;
    begin
      return Rtimeline_is_playing(self.FId) <> 0;
    end;

    /// `true`: playing goes back to the start at the end. C: Rtimeline_set_loop
    const method Loop(const AOn: bool): self;
    begin
      Rtimeline_set_loop(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The width of the track-name column, in logical units. C: Rtimeline_set_header_width
    const method HeaderWidth(const AWidth: float32): self;
    begin
      Rtimeline_set_header_width(self.FId, AWidth);
      return self;
    end;

    /// The track-name column's width as laid out (0 until the timeline is laid out).
    /// C: Rtimeline_get_header_width
    const method HeaderWidth(): float32;
    begin
      return Rtimeline_get_header_width(self.FId);
    end;

    /// The height of the time ruler, in logical units. C: Rtimeline_set_ruler_height
    const method RulerHeight(const AHeight: float32): self;
    begin
      Rtimeline_set_ruler_height(self.FId, AHeight);
      return self;
    end;

    /// C: Rtimeline_get_ruler_height
    const method RulerHeight(): float32;
    begin
      return Rtimeline_get_ruler_height(self.FId);
    end;

    /// The height a track has until its own is set. C: Rtimeline_set_default_track_height
    const method DefaultTrackHeight(const AHeight: float32): self;
    begin
      Rtimeline_set_default_track_height(self.FId, AHeight);
      return self;
    end;

    /// C: Rtimeline_get_default_track_height
    const method DefaultTrackHeight(): float32;
    begin
      return Rtimeline_get_default_track_height(self.FId);
    end;

    /// The look it is drawn with. C: Rtimeline_set_preset
    const method Preset(const APreset: UIPreset): self;
    begin
      Rtimeline_set_preset(self.FId, int32(APreset));
      return self;
    end;

    /// C: Rtimeline_get_preset
    const method Preset(): UIPreset;
    begin
      return UIPreset(Rtimeline_get_preset(self.FId));
    end;

    /// A new track named `AName`, under the others. C: Rtimeline_add_track
    const method AddTrack(const AName: string): UITrack;
    begin
      return UITrack.Wrap(self.FId, Rtimeline_add_track(self.FId, AName));
    end;

    /// How many tracks it has. C: Rtimeline_get_track_count
    const method TrackCount(): int32;
    begin
      return Rtimeline_get_track_count(self.FId);
    end;

    /// Its track `AIndex` from the top (0 first). C: Rtimeline_get_track
    const method Track(const AIndex: int32): UITrack;
    begin
      return UITrack.Wrap(self.FId, Rtimeline_get_track(self.FId, AIndex));
    end;

    /// A new marker at `ATime` seconds, labelled `ALabel`. C: Rtimeline_add_marker
    const method AddMarker(const ATime: float64; const ALabel: string): UITimelineItem;
    begin
      return UITimelineItem.Wrap(self.FId, Rtimeline_add_marker(self.FId, ATime, ALabel));
    end;

    /// How many items (clips, keys, markers) it has. C: Rtimeline_get_item_count
    const method ItemCount(): int32;
    begin
      return Rtimeline_get_item_count(self.FId);
    end;

    /// Its item `AIndex`, in the order they were added (0 first). C: Rtimeline_get_item
    const method Item(const AIndex: int32): UITimelineItem;
    begin
      return UITimelineItem.Wrap(self.FId, Rtimeline_get_item(self.FId, AIndex));
    end;

    /// Every track and item removed. C: Rtimeline_clear
    const method Clear(): self;
    begin
      Rtimeline_clear(self.FId);
      return self;
    end;

    /// No item selected. C: Rtimeline_clear_selection
    const method ClearSelection(): self;
    begin
      Rtimeline_clear_selection(self.FId);
      return self;
    end;

    /// How many items are selected. C: Rtimeline_get_selection_count
    const method SelectionCount(): int32;
    begin
      return Rtimeline_get_selection_count(self.FId);
    end;

    /// Its selected item `AIndex` (0 first). C: Rtimeline_get_selected
    const method Selected(const AIndex: int32): UITimelineItem;
    begin
      return UITimelineItem.Wrap(self.FId, Rtimeline_get_selected(self.FId, AIndex));
    end;

    /// Runs `AFunc` with the playhead's time as the user scrubs it or it plays.
    /// C: Rtimeline_set_time_callback
    const method OnTime(const AFunc: UIPlayheadFunc): self;
    begin
      if AFunc = nil then
        GTimelineTimes.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtimeline_set_time_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtimeline_set_time_callback(self.FId, DoOnTimelineTime,
        GTimelineTimes.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with each item the user moves, stretches or retimes, as it happens.
    /// C: Rtimeline_set_changed_callback
    const method OnChanged(const AFunc: UITimelineItemFunc): self;
    begin
      if AFunc = nil then
        GTimelineItems.Clear(self.FId, ADAM_RAVEN_TIMELINE_CHANGED);
        Rtimeline_set_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtimeline_set_changed_callback(self.FId, DoOnTimelineItem,
        GTimelineItems.Put(self.FId, ADAM_RAVEN_TIMELINE_CHANGED, AFunc));
      return self;
    end;

    /// Runs `AFunc` when the selection changes, with the item just clicked (or none).
    /// C: Rtimeline_set_selection_callback
    const method OnSelect(const AFunc: UITimelineItemFunc): self;
    begin
      if AFunc = nil then
        GTimelineItems.Clear(self.FId, ADAM_RAVEN_TIMELINE_SELECT);
        Rtimeline_set_selection_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtimeline_set_selection_callback(self.FId, DoOnTimelineItem,
        GTimelineItems.Put(self.FId, ADAM_RAVEN_TIMELINE_SELECT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with an item the user double-clicks. C: Rtimeline_set_activated_callback
    const method OnActivate(const AFunc: UITimelineItemFunc): self;
    begin
      if AFunc = nil then
        GTimelineItems.Clear(self.FId, ADAM_RAVEN_TIMELINE_ACTIVATE);
        Rtimeline_set_activated_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtimeline_set_activated_callback(self.FId, DoOnTimelineItem,
        GTimelineItems.Put(self.FId, ADAM_RAVEN_TIMELINE_ACTIVATE, AFunc));
      return self;
    end;

    /// Runs `AFunc` with an item the user deletes (the Delete key), before it goes; without
    /// it the Delete key does nothing. C: Rtimeline_set_removed_callback
    const method OnRemoved(const AFunc: UITimelineItemFunc): self;
    begin
      if AFunc = nil then
        GTimelineItems.Clear(self.FId, ADAM_RAVEN_TIMELINE_REMOVED);
        Rtimeline_set_removed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtimeline_set_removed_callback(self.FId, DoOnTimelineItem,
        GTimelineItems.Put(self.FId, ADAM_RAVEN_TIMELINE_REMOVED, AFunc));
      return self;
    end;
  end;

  /// A node graph: nodes with input and output pins the user links with wires, pans and
  /// zooms (a shader, a material or a data-flow editor).
  /// @example `LGraph := UINodeGraph.Create(); LOut := LGraph.AddNode("Source", LAt).AddOutput("Value", "float"); LIn := LGraph.AddNode("Sink", LAt2).AddInput("Value", "float"); LGraph.Connect(LOut, LIn);`
  UINodeGraph = object(UIWidget)
    /// A new graph with no nodes. C: Rnode_graph_create
    static method Create(): UINodeGraph;
    var
      LWidget: UINodeGraph;
    begin
      LWidget.DoSet(Rnode_graph_create());
      return LWidget;
    end;

    /// The kind a node graph views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.NodeGraph];
    end;

    /// A new node titled `ATitle` with its top left at `AAt` (canvas units).
    /// C: Rnode_graph_add_node
    const method AddNode(const ATitle: string; const AAt: UIPoint): UIGraphNode;
    begin
      return UIGraphNode.Wrap(self.FId, Rnode_graph_add_node(self.FId, ATitle, AAt.x, AAt.y));
    end;

    /// Every node and link removed. C: Rnode_graph_clear
    const method Clear(): self;
    begin
      Rnode_graph_clear(self.FId);
      return self;
    end;

    /// How many nodes it has. C: Rnode_graph_get_node_count
    const method NodeCount(): int32;
    begin
      return Rnode_graph_get_node_count(self.FId);
    end;

    /// Its node `AIndex`, in the order they were added (0 first). C: Rnode_graph_get_node
    const method Node(const AIndex: int32): UIGraphNode;
    begin
      return UIGraphNode.Wrap(self.FId, Rnode_graph_get_node(self.FId, AIndex));
    end;

    /// Its node named `AName` (none when it has no such node). C: Rnode_graph_find_node
    const method FindNode(const AName: string): UIGraphNode;
    begin
      return UIGraphNode.Wrap(self.FId, Rnode_graph_find_node(self.FId, AName));
    end;

    /// The colour of the pins and wires of the type `AType` (`AColor`'s alpha is not used).
    /// C: Rnode_graph_set_type_color
    const method TypeColor(const AType: string; const AColor: UIColor): self;
    begin
      Rnode_graph_set_type_color(self.FId, AType, AColor.r, AColor.g, AColor.b);
      return self;
    end;

    /// One style property of the pins and wires of the type `AType`, as
    /// `UIGraphNode.Style`. C: Rnode_graph_set_type_style
    const method TypeStyle(const AType: string; const AProperty: string; const AValue: string): bool;
    begin
      return Rnode_graph_set_type_style(self.FId, AType, AProperty, AValue) <> 0;
    end;

    /// A new link from the output `AOutput` to the input `AInput` (none when they cannot be
    /// linked: two inputs, types that differ; no closure is told). C: Rnode_graph_connect
    const method Connect(const AOutput: UIGraphPin; const AInput: UIGraphPin): UIGraphLink;
    begin
      return UIGraphLink.Wrap(self.FId, Rnode_graph_connect(self.FId, AOutput.Id(), AInput.Id()));
    end;

    /// How many links it has. C: Rnode_graph_get_link_count
    const method LinkCount(): int32;
    begin
      return Rnode_graph_get_link_count(self.FId);
    end;

    /// Its link `AIndex` (0 first). C: Rnode_graph_get_link
    const method Link(const AIndex: int32): UIGraphLink;
    begin
      return UIGraphLink.Wrap(self.FId, Rnode_graph_get_link(self.FId, AIndex));
    end;

    /// The canvas point at its center and its zoom. C: Rnode_graph_set_view
    const method View(const AView: UICanvasView): self;
    begin
      Rnode_graph_set_view(self.FId, AView.Place.x, AView.Place.y, AView.Zoom);
      return self;
    end;

    /// C: Rnode_graph_get_view
    const method View(): UICanvasView;
    var
      LView: UICanvasView;
    begin
      LView.Place.x := 0.0f;
      LView.Place.y := 0.0f;
      LView.Zoom := 0.0f;
      Rnode_graph_get_view(self.FId, addr of LView.Place.x, addr of LView.Place.y,
        addr of LView.Zoom);
      return LView;
    end;

    /// The canvas point under `APoint` of the widget. C: Rnode_graph_to_canvas
    const method ToCanvas(const APoint: UIPoint): UIPoint;
    var
      LPoint: UIPoint;
    begin
      LPoint.x := 0.0f;
      LPoint.y := 0.0f;
      Rnode_graph_to_canvas(self.FId, APoint.x, APoint.y, addr of LPoint.x, addr of LPoint.y);
      return LPoint;
    end;

    /// The point of the widget the canvas point `APoint` is drawn at.
    /// C: Rnode_graph_from_canvas
    const method FromCanvas(const APoint: UIPoint): UIPoint;
    var
      LPoint: UIPoint;
    begin
      LPoint.x := 0.0f;
      LPoint.y := 0.0f;
      Rnode_graph_from_canvas(self.FId, APoint.x, APoint.y, addr of LPoint.x, addr of LPoint.y);
      return LPoint;
    end;

    /// The view moved and zoomed to show every node. C: Rnode_graph_frame_all
    const method FrameAll(): self;
    begin
      Rnode_graph_frame_all(self.FId);
      return self;
    end;

    /// `false`: no grid drawn behind the nodes. C: Rnode_graph_set_grid_visible
    const method GridVisible(const AOn: bool): self;
    begin
      Rnode_graph_set_grid_visible(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `true`: dots run along the wires (data flowing). C: Rnode_graph_set_flow_visible
    const method FlowVisible(const AOn: bool): self;
    begin
      Rnode_graph_set_flow_visible(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `true`: the user can pan, zoom and select, not move, link or delete.
    /// C: Rnode_graph_set_read_only
    const method ReadOnly(const AOn: bool): self;
    begin
      Rnode_graph_set_read_only(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The look it is drawn with. C: Rnode_graph_set_preset
    const method Preset(const APreset: UIPreset): self;
    begin
      Rnode_graph_set_preset(self.FId, int32(APreset));
      return self;
    end;

    /// C: Rnode_graph_get_preset
    const method Preset(): UIPreset;
    begin
      return UIPreset(Rnode_graph_get_preset(self.FId));
    end;

    /// The width every pin label takes, in logical units (0: each its own).
    /// C: Rnode_graph_set_pin_label_width
    const method PinLabelWidth(const AWidth: float32): self;
    begin
      Rnode_graph_set_pin_label_width(self.FId, AWidth);
      return self;
    end;

    /// C: Rnode_graph_get_pin_label_width
    const method PinLabelWidth(): float32;
    begin
      return Rnode_graph_get_pin_label_width(self.FId);
    end;

    /// No node selected. C: Rnode_graph_clear_selection
    const method ClearSelection(): self;
    begin
      Rnode_graph_clear_selection(self.FId);
      return self;
    end;

    /// How many nodes are selected. C: Rnode_graph_get_selection_count
    const method SelectionCount(): int32;
    begin
      return Rnode_graph_get_selection_count(self.FId);
    end;

    /// Its selected node `AIndex` (0 first). C: Rnode_graph_get_selected_node
    const method SelectedNode(const AIndex: int32): UIGraphNode;
    begin
      return UIGraphNode.Wrap(self.FId, Rnode_graph_get_selected_node(self.FId, AIndex));
    end;

    /// The node under `APoint` of the widget (none). C: Rnode_graph_get_node_at
    const method NodeAt(const APoint: UIPoint): UIGraphNode;
    begin
      return UIGraphNode.Wrap(self.FId, Rnode_graph_get_node_at(self.FId, APoint.x, APoint.y));
    end;

    /// The pin near `APoint` of the widget, or whose tag is under it (none).
    /// C: Rnode_graph_get_pin_at
    const method PinAt(const APoint: UIPoint): UIGraphPin;
    begin
      return UIGraphPin.Wrap(self.FId, Rnode_graph_get_pin_at(self.FId, APoint.x, APoint.y));
    end;

    /// The link under `APoint` of the widget (none; a hidden link never is).
    /// C: Rnode_graph_get_link_at
    const method LinkAt(const APoint: UIPoint): UIGraphLink;
    begin
      return UIGraphLink.Wrap(self.FId, Rnode_graph_get_link_at(self.FId, APoint.x, APoint.y));
    end;

    /// The pin whose tag chip is under `APoint` of the widget (none). C: Rnode_graph_get_tag_at
    const method TagAt(const APoint: UIPoint): UIGraphPin;
    begin
      return UIGraphPin.Wrap(self.FId, Rnode_graph_get_tag_at(self.FId, APoint.x, APoint.y));
    end;

    /// Runs `AFunc` when the user is about to link two pins that may be linked: `false`
    /// refuses. C: Rnode_graph_set_connect_callback
    const method OnConnect(const AFunc: UIGraphConnectFunc): self;
    begin
      if AFunc = nil then
        GGraphConnects.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rnode_graph_set_connect_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_connect_callback(self.FId, DoOnGraphConnect,
        GGraphConnects.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with a link the user made. C: Rnode_graph_set_linked_callback
    const method OnLinked(const AFunc: UIGraphLinkFunc): self;
    begin
      if AFunc = nil then
        GGraphLinks.Clear(self.FId, ADAM_RAVEN_GRAPH_LINKED);
        Rnode_graph_set_linked_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_linked_callback(self.FId, DoOnGraphLink,
        GGraphLinks.Put(self.FId, ADAM_RAVEN_GRAPH_LINKED, AFunc));
      return self;
    end;

    /// Runs `AFunc` with a link the user removes, before it goes.
    /// C: Rnode_graph_set_unlinked_callback
    const method OnUnlinked(const AFunc: UIGraphLinkFunc): self;
    begin
      if AFunc = nil then
        GGraphLinks.Clear(self.FId, ADAM_RAVEN_GRAPH_UNLINKED);
        Rnode_graph_set_unlinked_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_unlinked_callback(self.FId, DoOnGraphLink,
        GGraphLinks.Put(self.FId, ADAM_RAVEN_GRAPH_UNLINKED, AFunc));
      return self;
    end;

    /// Runs `AFunc` with each node the user moved, when the button is released.
    /// C: Rnode_graph_set_moved_callback
    const method OnMoved(const AFunc: UIGraphNodeFunc): self;
    begin
      if AFunc = nil then
        GGraphNodes.Clear(self.FId, ADAM_RAVEN_GRAPH_MOVED);
        Rnode_graph_set_moved_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_moved_callback(self.FId, DoOnGraphNode,
        GGraphNodes.Put(self.FId, ADAM_RAVEN_GRAPH_MOVED, AFunc));
      return self;
    end;

    /// Runs `AFunc` when the selection changes, with the node just clicked (or none).
    /// C: Rnode_graph_set_selection_callback
    const method OnSelect(const AFunc: UIGraphNodeFunc): self;
    begin
      if AFunc = nil then
        GGraphNodes.Clear(self.FId, ADAM_RAVEN_GRAPH_SELECT);
        Rnode_graph_set_selection_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_selection_callback(self.FId, DoOnGraphNode,
        GGraphNodes.Put(self.FId, ADAM_RAVEN_GRAPH_SELECT, AFunc));
      return self;
    end;

    /// Runs `AFunc` with a node the user deletes (the Delete key), before it goes; without
    /// it the Delete key only removes links. C: Rnode_graph_set_removed_callback
    const method OnRemoved(const AFunc: UIGraphNodeFunc): self;
    begin
      if AFunc = nil then
        GGraphNodes.Clear(self.FId, ADAM_RAVEN_GRAPH_REMOVED);
        Rnode_graph_set_removed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_removed_callback(self.FId, DoOnGraphNode,
        GGraphNodes.Put(self.FId, ADAM_RAVEN_GRAPH_REMOVED, AFunc));
      return self;
    end;

    /// Runs `AFunc` with a node the user double-clicks. C: Rnode_graph_set_activated_callback
    const method OnActivate(const AFunc: UIGraphNodeFunc): self;
    begin
      if AFunc = nil then
        GGraphNodes.Clear(self.FId, ADAM_RAVEN_GRAPH_ACTIVATE);
        Rnode_graph_set_activated_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_activated_callback(self.FId, DoOnGraphNode,
        GGraphNodes.Put(self.FId, ADAM_RAVEN_GRAPH_ACTIVATE, AFunc));
      return self;
    end;

    /// Runs `AFunc` on a right click; without it the right button does nothing.
    /// C: Rnode_graph_set_context_callback
    const method OnContext(const AFunc: UIGraphContextFunc): self;
    begin
      if AFunc = nil then
        GGraphContexts.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rnode_graph_set_context_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_context_callback(self.FId, DoOnGraphContext,
        GGraphContexts.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` on a double click on the empty canvas; without it that frames every node.
    /// C: Rnode_graph_set_canvas_activated_callback
    const method OnCanvasActivate(const AFunc: UICanvasPointFunc): self;
    begin
      if AFunc = nil then
        GGraphCanvas.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rnode_graph_set_canvas_activated_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_canvas_activated_callback(self.FId, DoOnGraphCanvas,
        GGraphCanvas.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` when a wire the user pulled from a pin is released on nothing: that pin
    /// and where (a node to connect it to). C: Rnode_graph_set_wire_dropped_callback
    const method OnWireDropped(const AFunc: UIGraphPinFunc): self;
    begin
      if AFunc = nil then
        GGraphPins.Clear(self.FId, ADAM_RAVEN_GRAPH_WIRE_DROPPED);
        Rnode_graph_set_wire_dropped_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_wire_dropped_callback(self.FId, DoOnGraphPin,
        GGraphPins.Put(self.FId, ADAM_RAVEN_GRAPH_WIRE_DROPPED, AFunc));
      return self;
    end;

    /// Runs `AFunc` with a pin clicked, not dragged (linking in two clicks); with it such a
    /// click neither detaches an input's wire nor drops a wire. C: Rnode_graph_set_pin_clicked_callback
    const method OnPinClick(const AFunc: UIGraphPinFunc): self;
    begin
      if AFunc = nil then
        GGraphPins.Clear(self.FId, ADAM_RAVEN_GRAPH_PIN_CLICK);
        Rnode_graph_set_pin_clicked_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rnode_graph_set_pin_clicked_callback(self.FId, DoOnGraphPin,
        GGraphPins.Put(self.FId, ADAM_RAVEN_GRAPH_PIN_CLICK, AFunc));
      return self;
    end;
  end;

  /// A block editor: scripts of blocks the user snaps together from a palette, built from
  /// the kinds the program declares (a visual programming surface).
  /// @example `LEditor := UIBlockEditor.Create(); LEditor.AddKind("say", "say %s", UIBlockShape.Statement, "Looks"); LEditor.AddBlock("say", LAt).Value(0, "Hello");`
  UIBlockEditor = object(UIWidget)
    /// A new editor with no kinds and no scripts. C: Rblock_editor_create
    static method Create(): UIBlockEditor;
    var
      LWidget: UIBlockEditor;
    begin
      LWidget.DoSet(Rblock_editor_create());
      return LWidget;
    end;

    /// The kind a block editor views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.BlockEditor];
    end;

    /// A new kind of block named `AName`, with its block in the palette's category
    /// `ACategory`; `ALabel` is its words and slots (%n a number, %s a text, %b a condition,
    /// %r any value, %m a choice: `SlotOptions`; {text} after a slot its default). Its
    /// index, -1 on an error. C: Rblock_editor_add_kind
    const method AddKind(const AName: string; const ALabel: string; const AShape: UIBlockShape;
      const ACategory: string): int32;
    begin
      return Rblock_editor_add_kind(self.FId, AName, ALabel, int32(AShape), ACategory);
    end;

    /// The colour of the blocks of the category `ACategory` (`AColor`'s alpha is not used).
    /// C: Rblock_editor_set_category_color
    const method CategoryColor(const ACategory: string; const AColor: UIColor): self;
    begin
      Rblock_editor_set_category_color(self.FId, ACategory, AColor.r, AColor.g, AColor.b);
      return self;
    end;

    /// `false`: no palette shown (the program adds every block). C: Rblock_editor_set_palette_visible
    const method PaletteVisible(const AOn: bool): self;
    begin
      Rblock_editor_set_palette_visible(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `false`: the kind `AKind`'s block left out of the palette. C: Rblock_editor_set_kind_visible
    const method KindVisible(const AKind: string; const AOn: bool): self;
    begin
      Rblock_editor_set_kind_visible(self.FId, AKind, DoCBool(AOn));
      return self;
    end;

    /// A new label for the kind `AKind` (its blocks keep the values of the slots still
    /// there); `false` when there is no such kind. C: Rblock_editor_set_kind_label
    const method KindLabel(const AKind: string; const ALabel: string): bool;
    begin
      return Rblock_editor_set_kind_label(self.FId, AKind, ALabel) <> 0;
    end;

    /// The choices of the %m slot `ASlot` of the kind `AKind` (empty: the slot is typed in).
    /// C: Rblock_editor_set_slot_options
    const method SlotOptions(const AKind: string; const ASlot: int32; const AOptions: array of string): self;
    var
      LText: string;
      LI: int64;
    begin
      // Raven takes the choices as one text, one per line
      LText := "";
      for LI := 0 to len(AOptions) - 1 do
        if LI > 0 then
          LText := LText + "\n";
        end;
        LText := LText + AOptions[LI];
      end;
      Rblock_editor_set_slot_options(self.FId, AKind, ASlot, LText);
      return self;
    end;

    /// A new block of the kind `AKind`, the top of a script of its own at `AAt` (canvas
    /// units); none on an error. C: Rblock_editor_add_block
    const method AddBlock(const AKind: string; const AAt: UIPoint): UIBlock;
    begin
      return UIBlock.Wrap(self.FId, Rblock_editor_add_block(self.FId, AKind, AAt.x, AAt.y));
    end;

    /// Every script removed. C: Rblock_editor_clear
    const method Clear(): self;
    begin
      Rblock_editor_clear(self.FId);
      return self;
    end;

    /// How many scripts it has. C: Rblock_editor_get_script_count
    const method ScriptCount(): int32;
    begin
      return Rblock_editor_get_script_count(self.FId);
    end;

    /// The top block of its script `AIndex` (0 first). C: Rblock_editor_get_script
    const method Script(const AIndex: int32): UIBlock;
    begin
      return UIBlock.Wrap(self.FId, Rblock_editor_get_script(self.FId, AIndex));
    end;

    /// How many blocks are selected. C: Rblock_editor_get_selection_count
    const method SelectionCount(): int32;
    begin
      return Rblock_editor_get_selection_count(self.FId);
    end;

    /// Its selected block `AIndex` (0 first). C: Rblock_editor_get_selected
    const method Selected(const AIndex: int32): UIBlock;
    begin
      return UIBlock.Wrap(self.FId, Rblock_editor_get_selected(self.FId, AIndex));
    end;

    /// The canvas point its view stands at and its zoom. C: Rblock_editor_set_view
    const method View(const AView: UICanvasView): self;
    begin
      Rblock_editor_set_view(self.FId, AView.Place.x, AView.Place.y, AView.Zoom);
      return self;
    end;

    /// C: Rblock_editor_get_view
    const method View(): UICanvasView;
    var
      LView: UICanvasView;
    begin
      LView.Place.x := 0.0f;
      LView.Place.y := 0.0f;
      LView.Zoom := 0.0f;
      Rblock_editor_get_view(self.FId, addr of LView.Place.x, addr of LView.Place.y,
        addr of LView.Zoom);
      return LView;
    end;

    /// Every script as text (for `Load`). C: Rblock_editor_save
    const method Save(): string;
    begin
      return DoRavenText(Rblock_editor_save(self.FId));
    end;

    /// The scripts replaced by those of `AText` (from `Save`); `false` when it is not such a
    /// text. C: Rblock_editor_load
    const method Load(const AText: string): bool;
    begin
      return Rblock_editor_load(self.FId, AText) <> 0;
    end;

    /// Runs `AFunc` each time the user changes a script, with the block changed.
    /// C: Rblock_editor_set_changed_callback
    const method OnChanged(const AFunc: UIBlockFunc): self;
    begin
      if AFunc = nil then
        GBlockEvents.Clear(self.FId, ADAM_RAVEN_BLOCK_CHANGED);
        Rblock_editor_set_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rblock_editor_set_changed_callback(self.FId, DoOnBlock,
        GBlockEvents.Put(self.FId, ADAM_RAVEN_BLOCK_CHANGED, AFunc));
      return self;
    end;

    /// Runs `AFunc` with a block the user clicks (to run its script).
    /// C: Rblock_editor_set_clicked_callback
    const method OnClick(const AFunc: UIBlockFunc): self;
    begin
      if AFunc = nil then
        GBlockEvents.Clear(self.FId, ADAM_RAVEN_BLOCK_CLICK);
        Rblock_editor_set_clicked_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rblock_editor_set_clicked_callback(self.FId, DoOnBlock,
        GBlockEvents.Put(self.FId, ADAM_RAVEN_BLOCK_CLICK, AFunc));
      return self;
    end;

    /// Runs `AFunc` on a right click. C: Rblock_editor_set_context_callback
    const method OnContext(const AFunc: UIBlockContextFunc): self;
    begin
      if AFunc = nil then
        GBlockContexts.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rblock_editor_set_context_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rblock_editor_set_context_callback(self.FId, DoOnBlockContext,
        GBlockContexts.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// A dock area: panels docked beside each other, tabbed, rearranged and torn off into
  /// windows of their own by the user (an IDE's or a tool's workspace).
  /// @example `LDock := UIDockArea.Create(); LDock.AddPanel(LFiles, "Files", UIDockSide.Left, UIWidget(), 0.25f);`
  UIDockArea = object(UIWidget)
    /// A new, empty dock area. C: Rdock_area_create
    static method Create(): UIDockArea;
    var
      LWidget: UIDockArea;
    begin
      LWidget.DoSet(Rdock_area_create());
      return LWidget;
    end;

    /// The kind a dock area views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.DockArea];
    end;

    /// `AWidget` docked as a panel titled `ATitle` at the side `ASide` of `ARelative` (an
    /// empty `UIWidget()`: of the whole area; with `UIDockSide.Tab`, a tab beside it),
    /// `ASize` its share (0 .. 1). C: Rdock_area_add_panel
    const method AddPanel(const AWidget: UIWidget; const ATitle: string; const ASide: UIDockSide;
      const ARelative: UIWidget; const ASize: float32): UIDockPanel;
    begin
      Rdock_area_add_panel(self.FId, AWidget.Id(), ATitle, int32(ASide), ARelative.Id(), ASize);
      return UIDockPanel.Wrap(self.FId, AWidget.Id());
    end;

    /// The panel `AWidget` (one docked here).
    const method Panel(const AWidget: UIWidget): UIDockPanel;
    begin
      return UIDockPanel.Wrap(self.FId, AWidget.Id());
    end;

    /// `true`: a tab's close button hides its panel (`UIDockPanel.Open` brings it back)
    /// instead of deleting it. C: Rdock_area_set_close_hides
    const method CloseHides(const AOn: bool): self;
    begin
      Rdock_area_set_close_hides(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `false`: the user cannot drag its panels elsewhere. C: Rdock_area_set_movable
    const method Movable(const AOn: bool): self;
    begin
      Rdock_area_set_movable(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `true`: a panel dragged out of the area floats. C: Rdock_area_set_tearable
    const method Tearable(const AOn: bool): self;
    begin
      Rdock_area_set_tearable(self.FId, DoCBool(AOn));
      return self;
    end;

    /// C: Rdock_area_is_tearable
    const method Tearable(): bool;
    begin
      return Rdock_area_is_tearable(self.FId) <> 0;
    end;

    /// Where torn-off panels float: windows of their own, or cards inside this window.
    /// C: Rdock_area_set_float_mode
    const method FloatMode(const AMode: UIDockFloat): self;
    begin
      Rdock_area_set_float_mode(self.FId, int32(AMode));
      return self;
    end;

    /// How its panels are arranged, as a short text to keep in a settings file (named by
    /// their widgets' names: unnamed panels are not in it). C: Rdock_area_save_layout
    const method SaveLayout(): string;
    begin
      return DoRavenText(Rdock_area_save_layout(self.FId));
    end;

    /// The panels arranged as `ALayout` (from `SaveLayout`); `false` when it is not such a
    /// text. C: Rdock_area_load_layout
    const method LoadLayout(const ALayout: string): bool;
    begin
      return Rdock_area_load_layout(self.FId, ALayout) <> 0;
    end;

    /// Runs `AFunc` when the user closes a panel, before it goes: `false` keeps it.
    /// C: Rdock_area_set_close_callback
    const method OnClose(const AFunc: UIDockCloseFunc): self;
    begin
      if AFunc = nil then
        GDockCloses.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rdock_area_set_close_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rdock_area_set_close_callback(self.FId, DoOnDockClose,
        GDockCloses.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` after the user moves, resizes, shows or closes a panel.
    /// C: Rdock_area_set_changed_callback
    const method OnChanged(const AFunc: UITaskFunc): self;
    begin
      if AFunc = nil then
        GDockChanges.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rdock_area_set_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rdock_area_set_changed_callback(self.FId, DoOnDockChanged,
        GDockChanges.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// An island: a pill that unfolds to show more (a call, a timer, a download), on its own
  /// or as a window's island in the camera notch (`UIWindow.Island`).
  UIIsland = object(UIWidget)
    /// A new, folded island. C: Risland_create
    static method Create(): UIIsland;
    var
      LWidget: UIIsland;
    begin
      LWidget.DoSet(Risland_create());
      return LWidget;
    end;

    /// The kind an island views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Island];
    end;

    /// Unfolded (`true`) or folded (no closure is told). C: Risland_set_expanded
    const method Expanded(const AOn: bool): self;
    begin
      Risland_set_expanded(self.FId, DoCBool(AOn));
      return self;
    end;

    /// C: Risland_is_expanded
    const method Expanded(): bool;
    begin
      return Risland_is_expanded(self.FId) <> 0;
    end;

    /// Unfolded for `ASeconds`, then folded again. C: Risland_expand_for
    const method ExpandFor(const ASeconds: float64): self;
    begin
      Risland_expand_for(self.FId, ASeconds);
      return self;
    end;

    /// `true`: it unfolds while the pointer is over it. C: Risland_set_expand_on_hover
    const method ExpandOnHover(const AOn: bool): self;
    begin
      Risland_set_expand_on_hover(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `true`: a click unfolds or folds it. C: Risland_set_expand_on_click
    const method ExpandOnClick(const AOn: bool): self;
    begin
      Risland_set_expand_on_click(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `true`: drawn attached to the top edge of its window. C: Risland_set_attached
    const method Attached(const AOn: bool): self;
    begin
      Risland_set_attached(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `true`: it goes into the screen's camera housing when there is one.
    /// C: Risland_set_notch
    const method Notch(const AOn: bool): self;
    begin
      Risland_set_notch(self.FId, DoCBool(AOn));
      return self;
    end;

    /// C: Risland_get_notch
    const method Notch(): bool;
    begin
      return Risland_get_notch(self.FId) <> 0;
    end;

    /// `true` while it is in the screen's camera housing. C: Risland_is_in_notch
    const method InNotch(): bool;
    begin
      return Risland_is_in_notch(self.FId) <> 0;
    end;

    /// Runs `AFunc` when the user unfolds or folds it: whether it is unfolded now.
    /// C: Risland_set_changed_callback
    const method OnChanged(const AFunc: UIToggleFunc): self;
    begin
      if AFunc = nil then
        GIslandChanges.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Risland_set_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Risland_set_changed_callback(self.FId, DoOnIslandChanged,
        GIslandChanges.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// A header bar: a window's own title bar (with `UIWindowFlag.CustomHeader`), dragging
  /// the window and holding its buttons.
  UIHeaderBar = object(UIWidget)
    /// A new header bar titled `ATitle`, with every button. C: Rheader_bar_create
    static method Create(const ATitle: string): UIHeaderBar;
    var
      LWidget: UIHeaderBar;
    begin
      LWidget.DoSet(Rheader_bar_create(ATitle));
      return LWidget;
    end;

    /// The kind a header bar views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.HeaderBar];
    end;

    /// Its title. C: Rheader_bar_set_title
    const method Title(const ATitle: string): self;
    begin
      Rheader_bar_set_title(self.FId, ATitle);
      return self;
    end;

    /// The window buttons it shows. C: Rheader_bar_set_buttons
    const method Buttons(const AButtons: UIHeaderButtons): self;
    begin
      Rheader_bar_set_buttons(self.FId, uint32(AButtons));
      return self;
    end;

    /// The side its buttons sit on (left on macOS, right elsewhere until set).
    /// C: Rheader_bar_set_button_side
    const method ButtonSide(const ASide: UIHAlign): self;
    begin
      Rheader_bar_set_button_side(self.FId, int32(ASide));
      return self;
    end;

    /// Where its title stands. C: Rheader_bar_set_title_align
    const method TitleAlign(const AAlign: UIHAlign): self;
    begin
      Rheader_bar_set_title_align(self.FId, int32(AAlign));
      return self;
    end;

    /// `true`: its title kept clear of the screen's camera housing. C: Rheader_bar_set_title_notch
    const method TitleNotch(const AOn: bool): self;
    begin
      Rheader_bar_set_title_notch(self.FId, DoCBool(AOn));
      return self;
    end;

    /// `false`: no background drawn (a bar floating above the content or in a glass panel).
    /// C: Rheader_bar_set_background
    const method Background(const AOn: bool): self;
    begin
      Rheader_bar_set_background(self.FId, DoCBool(AOn));
      return self;
    end;
  end;

  /// A background blur: a frosted, glass or native backdrop behind its child.
  UIBackgroundBlur = object(UIWidget)
    /// A new blur, in the theme's style. C: Rbackground_blur_create
    static method Create(): UIBackgroundBlur;
    var
      LWidget: UIBackgroundBlur;
    begin
      LWidget.DoSet(Rbackground_blur_create());
      return LWidget;
    end;

    /// The kind a background blur views.
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.BackgroundBlur];
    end;

    /// How it blurs. C: Rbackground_blur_set_style
    const method Style(const AStyle: UIBlurStyle): self;
    begin
      Rbackground_blur_set_style(self.FId, int32(AStyle));
      return self;
    end;

    /// C: Rbackground_blur_get_style
    const method Style(): UIBlurStyle;
    begin
      return UIBlurStyle(Rbackground_blur_get_style(self.FId));
    end;

    /// The blur's radius, in logical units. C: Rbackground_blur_set_radius
    const method Radius(const ARadius: float32): self;
    begin
      Rbackground_blur_set_radius(self.FId, ARadius);
      return self;
    end;

    /// C: Rbackground_blur_get_radius
    const method Radius(): float32;
    begin
      return Rbackground_blur_get_radius(self.FId);
    end;

    /// The colour laid over the blur. C: Rbackground_blur_set_tint
    const method Tint(const AColor: UIColor): self;
    begin
      Rbackground_blur_set_tint(self.FId, AColor.r, AColor.g, AColor.b, AColor.a);
      return self;
    end;

    /// The style's own tint back. C: Rbackground_blur_clear_tint
    const method ClearTint(): self;
    begin
      Rbackground_blur_clear_tint(self.FId);
      return self;
    end;

    /// How saturated what shows through is (1: as it is). C: Rbackground_blur_set_saturation
    const method Saturation(const ASaturation: float32): self;
    begin
      Rbackground_blur_set_saturation(self.FId, ASaturation);
      return self;
    end;

    /// How much grain is laid over it (0: none). C: Rbackground_blur_set_grain
    const method Grain(const AGrain: float32): self;
    begin
      Rbackground_blur_set_grain(self.FId, AGrain);
      return self;
    end;

    /// The radius of each corner, in logical units. C: Rbackground_blur_set_corner_radius
    const method CornerRadius(const ATopLeft: float32; const ATopRight: float32;
      const ABottomRight: float32; const ABottomLeft: float32): self;
    begin
      Rbackground_blur_set_corner_radius(self.FId, ATopLeft, ATopRight, ABottomRight, ABottomLeft);
      return self;
    end;

    /// The space around its child, in logical units. C: Rbackground_blur_set_padding
    const method Padding(const ALeft: float32; const ATop: float32; const ARight: float32;
      const ABottom: float32): self;
    begin
      Rbackground_blur_set_padding(self.FId, ALeft, ATop, ARight, ABottom);
      return self;
    end;

    /// The blur of the shadow under it (0: none). C: Rbackground_blur_set_shadow
    const method Shadow(const ABlur: float32): self;
    begin
      Rbackground_blur_set_shadow(self.FId, ABlur);
      return self;
    end;
  end;

func clink DoOnDockFloat(area: Rid; panel: Rid; window: Rid; floating_area: Rid;
  user_data: ptr): Rid;
var
  LFunc: UIDockFloatFunc;
begin
  if not GDockFloats.Find(user_data, LFunc) or (LFunc = nil) then
    return R_INVALID_ID;
  end;
  return LFunc(UIDockPanel.Wrap(area, panel), UIWindow.Wrap(window),
    UIWidget.Wrap(floating_area).As<UIDockArea>()).Id();
end;

// UIDockArea's float windows (their closure names UIDockArea) and UIWindow's island
public extend UIDockArea
  /// How the windows of torn-off panels are made: the window flags `AFlags` (NoResize,
  /// Borderless, CustomHeader and Transparent count) and `AFunc` making each one's content
  /// (nil: the floating area is the whole window). C: Rdock_area_set_float_window
  const method FloatWindow(const AFlags: UIWindowFlags; const AFunc: UIDockFloatFunc): self;
  begin
    if AFunc = nil then
      GDockFloats.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
      Rdock_area_set_float_window(self.FId, uint32(AFlags), nil, nil);
      return self;
    end;
    DoHookDestroy(self.FId);
    Rdock_area_set_float_window(self.FId, uint32(AFlags), DoOnDockFloat,
      GDockFloats.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
    return self;
  end;
end;

public extend UIDockPanel
  /// The area it belongs to (its home).
  const method Area(): UIDockArea;
  begin
    return UIWidget.Wrap(self.FArea).As<UIDockArea>();
  end;
end;

public extend UIWindow
  /// The window's island, in its title area or the screen's camera housing (an empty
  /// `UIIsland()`: none). C: Rwindow_set_island
  const method Island(const AIsland: UIIsland): self;
  begin
    Rwindow_set_island(self.FId, AIsland.Id());
    return self;
  end;

  /// C: Rwindow_get_island
  const method Island(): UIIsland;
  var
    LId: Rid;
    LNone: UIIsland;
  begin
    LId := Rwindow_get_island(self.FId);
    if LId = R_INVALID_ID then
      return LNone;
    end;
    return UIWidget.Wrap(LId).As<UIIsland>();
  end;
end;

// ============================================================================
// Actions, locale, accessibility, script, languages and system UI (listing
// sec 8, V9): UIActions answers Raven's actions by name (an XML layout's
// OnClicked / Action ..., a script's call), by a name's prefix, or with typed
// parameters (UIActionContext); UILocale is the translation tables (Rtr);
// UIAccessibility the text scale, contrast, motion, colour filter and the
// screen reader; UIScript Raven's own script; UISyntaxLanguage the text
// editor's language definitions (UILanguageDef); UIFileDialog the system's
// open / save / folder dialogs; UITrayRes an icon in the system tray (a
// shared handle); UIFiles the in-memory files Raven opens by path. All but
// UIFileDialog, UIActionContext and UITrayRes are static. Raven's
// Rfile_read / Rfile_write stay out (System.IO is the file job).
// ============================================================================

public type
  /// The routine answering a bound action: `ASender` is the widget that fired it (an empty
  /// `UIWidget` for one fired by a script or with no sender).
  UIActionFunc = ref func(const ASender: UIWidget);
  /// The routine answering every action named `<prefix><argument>`: `AArgument` is the rest
  /// of the name.
  UIActionPrefixFunc = ref func(const ASender: UIWidget; const AArgument: string);
  /// The routine answering an action no binding and no prefix took: `AName` is its name.
  UIActionFallbackFunc = ref func(const ASender: UIWidget; const AName: string);
  /// The language Raven's texts are in now (`UILocale.OnChanged`).
  UILocaleFunc = ref func(const ALanguage: string);
  /// A line a script logged (`UIScript.OnLog`).
  UIScriptLogFunc = ref func(const AText: string);
  /// A script diagnostic: where (`AFile`, `ALine`, `AColumn`), its code and its text
  /// (`UIScript.OnDiagnostic`).
  UIScriptDiagnosticFunc = ref func(const ASeverity: UISeverity; const ACode: string;
    const AFile: string; const ALine: int32; const AColumn: int32; const AText: string);
  /// A tray icon clicked with `AButton` (`UITrayRes.OnClick`).
  UITrayClickFunc = ref func(const AButton: UIPointerButton);

  /// The call of an action bound with parameters: its sender, name and arguments, and its
  /// answer (`Reply`, or `Fail`). Valid during that call only. C: RActionContext, Raction_get_*,
  /// Raction_return_*, Raction_fail
  /// @example `UIActions.Bind("app.save", "(path: string): bool", func(const C: UIActionContext) begin C.Reply(Save(C.Text(0))); end);`
  UIActionContext = object
    hidden FContext: ptr to RActionContext;

    /// An empty context (answers nothing), as a variable declared with no arguments starts.
    init();
    begin
      self.FContext := nil;
    end;

    /// The context Raven hands an action's callback as `AContext` (the layer's trampoline
    /// builds it).
    static method Of(const AContext: ptr to RActionContext): UIActionContext;
    var
      LContext: UIActionContext;
    begin
      LContext.FContext := AContext;
      return LContext;
    end;

    /// The widget that fired it (empty when a script called it). C: Raction_get_sender
    const method Sender(): UIWidget;
    begin
      return UIWidget.Wrap(Raction_get_sender(self.FContext));
    end;

    /// The action's name. C: Raction_get_name
    const method Name(): string;
    begin
      return DoRavenText(Raction_get_name(self.FContext));
    end;

    /// How many arguments it was given. C: Raction_get_argument_count
    const method ArgCount(): int32;
    begin
      return Raction_get_argument_count(self.FContext);
    end;

    /// Argument `AIndex` (from 0) as a number. C: Raction_get_number
    const method Number(const AIndex: int32): float64;
    begin
      return Raction_get_number(self.FContext, AIndex);
    end;

    /// Argument `AIndex` (from 0) as text. C: Raction_get_string
    const method Text(const AIndex: int32): string;
    begin
      return DoRavenText(Raction_get_string(self.FContext, AIndex));
    end;

    /// Argument `AIndex` (from 0) as `true` / `false`. C: Raction_get_bool
    const method Flag(const AIndex: int32): bool;
    begin
      return Raction_get_bool(self.FContext, AIndex) <> 0;
    end;

    /// The number it gives back (a signature with `: number`). C: Raction_return_number
    const method Reply(const AValue: float64);
    begin
      Raction_return_number(self.FContext, AValue);
    end;

    /// The text it gives back (a signature with `: string`). C: Raction_return_string
    const method Reply(const AText: string);
    begin
      Raction_return_string(self.FContext, AText);
    end;

    /// The `true` / `false` it gives back (a signature with `: bool`). C: Raction_return_bool
    const method Reply(const AValue: bool);
    begin
      Raction_return_bool(self.FContext, DoCBool(AValue));
    end;

    /// The call failed with `AMessage` (a script sees an error). C: Raction_fail
    const method Fail(const AMessage: string);
    begin
      Raction_fail(self.FContext, AMessage);
    end;
  end;

  /// The routine answering an action bound with parameters.
  UIActionCallFunc = ref func(const AContext: UIActionContext);

var
  // UIActions' tables: by exact name (Bind), with parameters (Bind with a signature), by
  // prefix in the order bound (the first that fits a name answers it), and the fallback
  GActions: Map<string, UIActionFunc>;
  GActionCalls: Map<string, UIActionCallFunc>;
  GActionPrefixes: List<string>;
  GActionPrefixFuncs: Map<string, UIActionPrefixFunc>;
  GActionFallback: UIActionFallbackFunc;
  // The single closures of UILocale.OnChanged, UIScript.OnLog / OnDiagnostic
  GOnLocale: UILocaleFunc;
  GOnScriptLog: UIScriptLogFunc;
  GOnScriptDiagnostic: UIScriptDiagnosticFunc;
  // The tray icons' OnClick closures by tray
  GTrayClicks: Map<uint64, UITrayClickFunc>;

// A bound action fired: its closure runs on a copy (one rebound while it runs finishes)
func clink DoOnAction(sender: Rid; action: ptr to const char; user_data: ptr);
var
  LFunc: UIActionFunc;
begin
  if GActions.TryGet(DoRavenText(action), LFunc) and (LFunc <> nil) then
    LFunc(UIWidget.Wrap(sender));
  end;
end;

// An action bound with parameters called
func clink DoOnActionCall(context: ptr to RActionContext; user_data: ptr);
var
  LFunc: UIActionCallFunc;
begin
  if GActionCalls.TryGet(DoRavenText(Raction_get_name(context)), LFunc) and (LFunc <> nil) then
    LFunc(UIActionContext.Of(context));
  end;
end;

// An action no binding took: the first prefix that fits it, else the fallback
func clink DoOnActionDefault(sender: Rid; action: ptr to const char; user_data: ptr);
var
  LName: string;
  LPrefix: string;
  LFunc: UIActionPrefixFunc;
  LFallback: UIActionFallbackFunc;
  LI: int64;
begin
  LName := DoRavenText(action);
  for LI := 0 to GActionPrefixes.Count - 1 do
    LPrefix := GActionPrefixes[LI];
    if StartsStr(LPrefix, LName) then
      if GActionPrefixFuncs.TryGet(LPrefix, LFunc) and (LFunc <> nil) then
        LFunc(UIWidget.Wrap(sender), Substring(LName, len(LPrefix), len(LName) - len(LPrefix)));
      end;
      return;
    end;
  end;
  LFallback := GActionFallback;
  if LFallback <> nil then
    LFallback(UIWidget.Wrap(sender), LName);
  end;
end;

// Raven's default action handler set while a prefix or the fallback is bound, else none
func DoActionDefault();
begin
  if (GActionPrefixes.Count > 0) or (GActionFallback <> nil) then
    Raction_set_default_handler(DoOnActionDefault, nil);
  else
    Raction_set_default_handler(nil, nil);
  end;
end;

func clink DoOnLocaleChanged(language: ptr to const char; user_data: ptr);
var
  LFunc: UILocaleFunc;
begin
  LFunc := GOnLocale;
  if LFunc <> nil then
    LFunc(DoRavenText(language));
  end;
end;

func clink DoOnScriptLog(message: ptr to const char; user_data: ptr);
var
  LFunc: UIScriptLogFunc;
begin
  LFunc := GOnScriptLog;
  if LFunc <> nil then
    LFunc(DoRavenText(message));
  end;
end;

func clink DoOnScriptDiagnostic(severity: RSeverity; code: ptr to const char;
  path: ptr to const char; line: int32; column: int32; text: ptr to const char; user_data: ptr);
var
  LFunc: UIScriptDiagnosticFunc;
begin
  LFunc := GOnScriptDiagnostic;
  if LFunc <> nil then
    LFunc(UISeverity(severity), DoRavenText(code), DoRavenText(path), line, column,
      DoRavenText(text));
  end;
end;

func clink DoOnTrayClicked(tray: Rid; button: RMouseButton; user_data: ptr);
var
  LFunc: UITrayClickFunc;
begin
  if GTrayClicks.TryGet(uint64(tray), LFunc) and (LFunc <> nil) then
    LFunc(UIPointerButton(button));
  end;
end;

// The app ends (DoAppShutdown, before Rshutdown): Raven's callbacks of sec 8 cleared and
// every closure of them let go
func DoDropSystemUI();
begin
  Raction_set_default_handler(nil, nil);
  Rlocale_set_changed_callback(nil, nil);
  Rscript_set_log_callback(nil, nil);
  Rscript_set_diagnostic_callback(nil, nil);
  GActions.Clear();
  GActionCalls.Clear();
  GActionPrefixes.Clear();
  GActionPrefixFuncs.Clear();
  GActionFallback := nil;
  GOnLocale := nil;
  GOnScriptLog := nil;
  GOnScriptDiagnostic := nil;
  GTrayClicks.Clear();
end;

public type
  /// Raven's actions answered by name: the name an XML layout gives a widget's `OnClicked`,
  /// `OnChanged` or `Action`, a script's call, or `Fire`. Bound by exact name, with typed
  /// parameters, or by a name's prefix; what nothing takes goes to the fallback. All static;
  /// every binding is let go when the app ends. C: Raction_*
  /// @example `UIActions.Bind("file.save", func(const S: UIWidget) begin Save(); end); UIActions.BindPrefix("theme.use.", func(const S: UIWidget; const AName: string) begin UITheme.Use(AName); end);`
  UIActions = object
    /// `AFunc` answers the action `AName`; binding a name again (either way) replaces it.
    /// C: Raction_bind
    static method Bind(const AName: string; const AFunc: UIActionFunc);
    begin
      GActionCalls.Remove(AName);
      if AFunc = nil then
        GActions.Remove(AName);
        Raction_unbind(AName);
        return;
      end;
      GActions.Put(AName, AFunc);
      Raction_bind(AName, DoOnAction, nil);
    end;

    /// `AFunc` answers the action `AName` with typed parameters and a result, as its
    /// `ASignature` says (`"(path: string): bool"`); a widget firing it hands what its event
    /// gives (a slider's value, a check box's state ..).
    /// @returns `false` (the error reported) when the signature is not valid.
    /// C: Raction_bind_with_parameters
    static method Bind(const AName: string; const ASignature: string;
      const AFunc: UIActionCallFunc): bool;
    begin
      GActions.Remove(AName);
      if AFunc = nil then
        GActionCalls.Remove(AName);
        Raction_unbind(AName);
        return true;
      end;
      if Raction_bind_with_parameters(AName, ASignature, DoOnActionCall, nil) = 0 then
        GActionCalls.Remove(AName);
        return false;
      end;
      GActionCalls.Put(AName, AFunc);
      return true;
    end;

    /// `AFunc` answers every action whose name starts with `APrefix` and has no binding of
    /// its own: the rest of the name is its argument (`"theme.use."` + `"Ember"`); prefixes
    /// are tried in the order bound, binding one again replaces its routine (`nil` removes it).
    /// C: Raction_set_default_handler
    static method BindPrefix(const APrefix: string; const AFunc: UIActionPrefixFunc);
    var
      LI: int64;
    begin
      if AFunc = nil then
        GActionPrefixFuncs.Remove(APrefix);
        LI := GActionPrefixes.IndexOf(APrefix);
        if LI >= 0 then
          GActionPrefixes.Delete(LI);
        end;
      else
        if not GActionPrefixFuncs.Has(APrefix) then
          GActionPrefixes.Add(APrefix);
        end;
        GActionPrefixFuncs.Put(APrefix, AFunc);
      end;
      DoActionDefault();
    end;

    /// `AFunc` answers every action no binding and no prefix took (`nil`: none does).
    /// C: Raction_set_default_handler
    static method Fallback(const AFunc: UIActionFallbackFunc);
    begin
      GActionFallback := AFunc;
      DoActionDefault();
    end;

    /// The action `AName` no longer answered by its binding. C: Raction_unbind
    static method Unbind(const AName: string);
    begin
      GActions.Remove(AName);
      GActionCalls.Remove(AName);
      Raction_unbind(AName);
    end;

    /// Runs the action `AName` as if `ASender` fired it (an empty `UIWidget()`: no sender).
    /// C: Raction_fire
    static method Fire(const AName: string; const ASender: UIWidget);
    begin
      Raction_fire(AName, ASender.Id());
    end;

    /// Raven's built-in actions (`app.quit`, `window.close` ..) on or off. C: Raction_set_builtins
    static method Builtins(const AOn: bool);
    begin
      Raction_set_builtins(DoCBool(AOn));
    end;

    /// `true` when `AName` is one of Raven's built-in actions. C: Raction_is_builtin
    static method IsBuiltin(const AName: string): bool;
    begin
      return Raction_is_builtin(AName) <> 0;
    end;
  end;

  /// The translation tables: texts by key in each language, loaded from CSV (a `key` column,
  /// then one column per language, the first the fallback), and the language in use.
  /// Raven's widgets show a key's text where an XML layout writes `@key`. All static.
  /// C: Rlocale_*, Rtr*
  /// @example `UILocale.LoadCSV("res/assets/ui/texts.csv"); UILocale.Language("fr"); LLabel.Text(UILocale.Tr("greeting"));`
  UILocale = object
    /// Loads (adds) the tables of the CSV file `APath`.
    /// @returns `false` (the error reported) when it does not load. C: Rlocale_load_csv
    static method LoadCSV(const APath: string): bool;
    begin
      return Rlocale_load_csv(APath) <> 0;
    end;

    /// Loads (adds) the tables of the CSV text `ACSV`, as `LoadCSV`.
    /// C: Rlocale_load_csv_from_memory
    static method LoadCSVText(const ACSV: string): bool;
    begin
      return Rlocale_load_csv_from_memory(ACSV, uint64(len(ACSV))) <> 0;
    end;

    /// Every table emptied. C: Rlocale_clear
    static method Clear();
    begin
      Rlocale_clear();
    end;

    /// `AText` as the text of `AKey` in `ALanguage`. C: Rlocale_set_text
    static method Text(const ALanguage: string; const AKey: string; const AText: string);
    begin
      Rlocale_set_text(ALanguage, AKey, AText);
    end;

    /// The text of `AKey` in the language in use (the fallback language's, else the key).
    /// C: Rtr
    static method Tr(const AKey: string): string;
    begin
      return DoRavenText(Rtr(AKey));
    end;

    /// The text of `AKey` with its `{0}` `{1}` .. replaced by `AArgs`. C: Rtr_format
    static method Tr(const AKey: string; const AArgs: StringArray): string;
    var
      LArgs: CStringArray;
    begin
      if len(AArgs) = 0 then
        return DoRavenText(Rtr_format(AKey, nil, 0));
      end;
      LArgs := CStringArray(AArgs);
      return DoRavenText(Rtr_format(AKey, LArgs.Ptr, int32(len(AArgs))));
    end;

    /// `true` when `AKey` has a text. C: Rtr_exists
    static method Has(const AKey: string): bool;
    begin
      return Rtr_exists(AKey) <> 0;
    end;

    /// The plural form of `AKey` for `ACount` (the language's `.one` / `.few` / `.other` ..
    /// key), `{n}` replaced by the count. C: Rtr_plural
    static method Plural(const AKey: string; const ACount: int32): string;
    begin
      return DoRavenText(Rtr_plural(AKey, ACount));
    end;

    /// How many languages the tables have. C: Rlocale_get_language_count
    static method LanguageCount(): int32;
    begin
      return Rlocale_get_language_count();
    end;

    /// The code of language `AIndex` (from 0). C: Rlocale_get_language_at
    static method LanguageAt(const AIndex: int32): string;
    begin
      return DoRavenText(Rlocale_get_language_at(AIndex));
    end;

    /// `ACode` as the language in use; every widget's `@key` text follows.
    /// @returns `false` when the tables have no such language. C: Rlocale_set_language
    static method Language(const ACode: string): bool;
    begin
      return Rlocale_set_language(ACode) <> 0;
    end;

    /// The code of the language in use. C: Rlocale_get_language
    static method Language(): string;
    begin
      return DoRavenText(Rlocale_get_language());
    end;

    /// The system's language code. C: Rlocale_get_system_language
    static method SystemLanguage(): string;
    begin
      return DoRavenText(Rlocale_get_system_language());
    end;

    /// `ACode` as the language a missing text comes from. C: Rlocale_set_fallback_language
    static method FallbackLanguage(const ACode: string);
    begin
      Rlocale_set_fallback_language(ACode);
    end;

    /// `true` when the language in use is written right to left. C: Rlocale_is_rtl
    static method RTL(): bool;
    begin
      return Rlocale_is_rtl() <> 0;
    end;

    /// `AValue` with `ADecimals` decimals, written the language's way. C: Rlocale_format_number
    static method FormatNumber(const AValue: float64; const ADecimals: int32): string;
    begin
      return DoRavenText(Rlocale_format_number(AValue, ADecimals));
    end;

    /// `AFunc` runs when the language in use changes (`nil`: none). C: Rlocale_set_changed_callback
    static method OnChanged(const AFunc: UILocaleFunc);
    begin
      GOnLocale := AFunc;
      if AFunc = nil then
        Rlocale_set_changed_callback(nil, nil);
      else
        Rlocale_set_changed_callback(DoOnLocaleChanged, nil);
      end;
    end;
  end;

  /// The system's accessibility settings as Raven reads them.
  UIAccessibilitySettings = record
    /// The text scale (1.0: none).
    TextScale: float32;
    /// High contrast colours.
    HighContrast: bool;
    /// Less motion (animations shortened or left out).
    ReduceMotion: bool;
    /// A screen reader running.
    ScreenReader: bool;
  end;

  /// Accessibility for every window: text scale, high contrast, an always visible focus,
  /// reduced motion, a colour filter, the system's settings, and what a screen reader says.
  /// All static. C: Raccessibility_*
  /// @example `UIAccessibility.FollowSystem(); UIAccessibility.Announce("Saved", false);`
  UIAccessibility = object
    /// Every text scaled by `AScale`. C: Raccessibility_set_text_scale
    static method TextScale(const AScale: float32);
    begin
      Raccessibility_set_text_scale(AScale);
    end;

    /// C: Raccessibility_get_text_scale
    static method TextScale(): float32;
    begin
      return Raccessibility_get_text_scale();
    end;

    /// High contrast colours on or off. C: Raccessibility_set_high_contrast
    static method HighContrast(const AOn: bool);
    begin
      Raccessibility_set_high_contrast(DoCBool(AOn));
    end;

    /// C: Raccessibility_get_high_contrast
    static method HighContrast(): bool;
    begin
      return Raccessibility_get_high_contrast() <> 0;
    end;

    /// The focus ring shown always (`true`), or only after a key. C:
    /// Raccessibility_set_focus_always_visible
    static method FocusAlwaysVisible(const AOn: bool);
    begin
      Raccessibility_set_focus_always_visible(DoCBool(AOn));
    end;

    /// C: Raccessibility_get_focus_always_visible
    static method FocusAlwaysVisible(): bool;
    begin
      return Raccessibility_get_focus_always_visible() <> 0;
    end;

    /// Animations shortened or left out (`true`). C: Raccessibility_set_reduce_motion
    static method ReduceMotion(const AOn: bool);
    begin
      Raccessibility_set_reduce_motion(DoCBool(AOn));
    end;

    /// C: Raccessibility_get_reduce_motion
    static method ReduceMotion(): bool;
    begin
      return Raccessibility_get_reduce_motion() <> 0;
    end;

    /// The colour filter every window is drawn through. C: Raccessibility_set_color_filter
    static method ColorFilter(const AFilter: UIColorFilter);
    begin
      Raccessibility_set_color_filter(int32(AFilter));
    end;

    /// C: Raccessibility_get_color_filter
    static method ColorFilter(): UIColorFilter;
    begin
      return UIColorFilter(Raccessibility_get_color_filter());
    end;

    /// The system's own settings. C: Raccessibility_get_system_settings
    static method SystemSettings(): UIAccessibilitySettings;
    var
      LC: RAccessibilitySettings;
      LSettings: UIAccessibilitySettings;
    begin
      Raccessibility_get_system_settings(addr of LC);
      LSettings.TextScale := LC.text_scale;
      LSettings.HighContrast := LC.high_contrast <> 0;
      LSettings.ReduceMotion := LC.reduce_motion <> 0;
      LSettings.ScreenReader := LC.screen_reader <> 0;
      return LSettings;
    end;

    /// The text scale, contrast and motion taken from the system's settings.
    /// C: Raccessibility_follow_system
    static method FollowSystem();
    begin
      Raccessibility_follow_system();
    end;

    /// `AText` said by the screen reader: at once (`AAssertive`), or after what it says now.
    /// C: Raccessibility_announce
    static method Announce(const AText: string; const AAssertive: bool);
    begin
      Raccessibility_announce(AText, DoCBool(AAssertive));
    end;

    /// `true` while a screen reader runs. C: Raccessibility_is_screen_reader_active
    static method ScreenReader(): bool;
    begin
      return Raccessibility_is_screen_reader_active() <> 0;
    end;
  end;

  /// Raven's own script (the `<script>` of an XML layout, or loaded here): its functions
  /// answer actions; checked, formatted, limited, with its log and diagnostics. All static.
  /// C: Rscript_*
  /// @example `UIScript.OnDiagnostic(DoReport); if not UIScript.Load(LSource, "main.rs") then return; end;`
  UIScript = object
    /// Installs the script `ASource`, named `AName` in diagnostics ("" for none).
    /// @returns `false` when it has an error (nothing of it installed). C: Rscript_load
    static method Load(const ASource: string; const AName: string): bool;
    var
      LName: CString;
    begin
      LName := CString(AName);
      return Rscript_load(ASource, uint64(len(ASource)), LName.OrNil) <> 0;
    end;

    /// Installs the script file `APath`, as `Load`. C: Rscript_load_file
    static method LoadFile(const APath: string): bool;
    begin
      return Rscript_load_file(APath) <> 0;
    end;

    /// Checks the script `ASource` (or an XML document's scripts: text starting with `<`)
    /// without running or installing anything; its diagnostics are reported.
    /// @returns the number of errors (0: none). C: Rscript_check
    static method Check(const ASource: string; const AName: string): int32;
    var
      LName: CString;
    begin
      LName := CString(AName);
      return Rscript_check(ASource, uint64(len(ASource)), LName.OrNil);
    end;

    /// Checks the script file `APath` (a .rvs or an .xml), as `Check`.
    /// @returns the number of errors (0: none), -1 when it cannot be read. C: Rscript_check_file
    static method CheckFile(const APath: string): int32;
    begin
      return Rscript_check_file(APath);
    end;

    /// `ASource` formatted, `AIndent` one level of indentation ("": four spaces).
    /// C: Rscript_format
    static method Format(const ASource: string; const AIndent: string): string;
    var
      LIndent: CString;
    begin
      LIndent := CString(AIndent);
      return DoRavenText(Rscript_format(ASource, uint64(len(ASource)), LIndent.OrNil));
    end;

    /// Every installed script removed. C: Rscript_reset
    static method Reset();
    begin
      Rscript_reset();
    end;

    /// `true` when an installed script has the function `AName`. C: Rscript_has_function
    static method HasFunction(const AName: string): bool;
    begin
      return Rscript_has_function(AName) <> 0;
    end;

    /// Scripts run (`true`) or are ignored. C: Rscript_set_enabled
    static method Enabled(const AOn: bool);
    begin
      Rscript_set_enabled(DoCBool(AOn));
    end;

    /// C: Rscript_is_enabled
    static method Enabled(): bool;
    begin
      return Rscript_is_enabled() <> 0;
    end;

    /// The most a script call may run: instructions, call depth and memory in bytes.
    /// C: Rscript_set_limits
    static method Limits(const AMaxInstructions: uint32; const AMaxDepth: int32;
      const AMaxMemory: uint64);
    begin
      Rscript_set_limits(AMaxInstructions, AMaxDepth, AMaxMemory);
    end;

    /// `AFunc` gets what scripts log (`nil`: none). C: Rscript_set_log_callback
    static method OnLog(const AFunc: UIScriptLogFunc);
    begin
      GOnScriptLog := AFunc;
      if AFunc = nil then
        Rscript_set_log_callback(nil, nil);
      else
        Rscript_set_log_callback(DoOnScriptLog, nil);
      end;
    end;

    /// `AFunc` gets every script diagnostic (`nil`: none). C: Rscript_set_diagnostic_callback
    static method OnDiagnostic(const AFunc: UIScriptDiagnosticFunc);
    begin
      GOnScriptDiagnostic := AFunc;
      if AFunc = nil then
        Rscript_set_diagnostic_callback(nil, nil);
      else
        Rscript_set_diagnostic_callback(DoOnScriptDiagnostic, nil);
      end;
    end;
  end;

  /// A language the text editor colours: its name, file extensions and words, all
  /// space-separated; "" for what it lacks. C: RLanguageDesc
  UILanguageDef = record
    /// Its name (`UITextEditor.Language`).
    Name: string;
    /// Its file extensions (`"adam"`).
    Extensions: string;
    /// Its keywords.
    Keywords: string;
    /// Its type names.
    Types: string;
    /// Its constants (`"true false nil"`).
    Constants: string;
    /// What starts a comment to the line's end (`"//"`).
    LineComment: string;
    /// What starts a block comment (`"/*"`).
    BlockCommentStart: string;
    /// What ends a block comment (`"*/"`).
    BlockCommentEnd: string;
    /// The characters quoting strings (`"\"'"`).
    StringQuotes: string;
    /// The quotes of strings that run over lines.
    MultilineStrings: string;
    /// What starts a directive line (`"#"`).
    Directive: string;
    /// What starts an annotation (`"@"`).
    Annotation: string;
    /// How it is read.
    Flags: UILanguageFlags;
    /// The language of its embedded scripts ("" for none).
    ScriptLanguage: string;
  end;

  /// The text editor's languages: declared or replaced (a built-in one too), read back,
  /// listed and found by a file's extension. All static. C: Rlanguage_*
  /// @example `LDef.Name := "adam"; LDef.Extensions := "adam"; LDef.Keywords := "module func begin end"; UISyntaxLanguage.Register(LDef);`
  UISyntaxLanguage = object
    /// Declares `ADef` (replacing the language of that name); its texts are copied.
    /// @returns `false` (the error reported) when it is not valid. C: Rlanguage_register
    static method Register(const ADef: UILanguageDef): bool;
    var
      LTexts: array[0..12] of CString;
      LDesc: RLanguageDesc;
    begin
      LTexts[0] := CString(ADef.Name);
      LTexts[1] := CString(ADef.Extensions);
      LTexts[2] := CString(ADef.Keywords);
      LTexts[3] := CString(ADef.Types);
      LTexts[4] := CString(ADef.Constants);
      LTexts[5] := CString(ADef.LineComment);
      LTexts[6] := CString(ADef.BlockCommentStart);
      LTexts[7] := CString(ADef.BlockCommentEnd);
      LTexts[8] := CString(ADef.StringQuotes);
      LTexts[9] := CString(ADef.MultilineStrings);
      LTexts[10] := CString(ADef.Directive);
      LTexts[11] := CString(ADef.Annotation);
      LTexts[12] := CString(ADef.ScriptLanguage);
      LDesc.name := LTexts[0].Ptr;
      LDesc.extensions := LTexts[1].OrNil;
      LDesc.keywords := LTexts[2].OrNil;
      LDesc.types := LTexts[3].OrNil;
      LDesc.constants := LTexts[4].OrNil;
      LDesc.line_comment := LTexts[5].OrNil;
      LDesc.block_comment_start := LTexts[6].OrNil;
      LDesc.block_comment_end := LTexts[7].OrNil;
      LDesc.string_quotes := LTexts[8].OrNil;
      LDesc.multiline_strings := LTexts[9].OrNil;
      LDesc.directive := LTexts[10].OrNil;
      LDesc.annotation := LTexts[11].OrNil;
      LDesc.flags := uint32(ADef.Flags);
      LDesc.script_language := LTexts[12].OrNil;
      return Rlanguage_register(addr of LDesc) <> 0;
    end;

    /// The language `AName` read into `ADef`.
    /// @returns `false` (ADef unchanged) when there is none. C: Rlanguage_get
    static method Find(const AName: string; var ADef: UILanguageDef): bool;
    var
      LDesc: RLanguageDesc;
    begin
      if Rlanguage_get(AName, addr of LDesc) = 0 then
        return false;
      end;
      ADef.Name := DoRavenText(LDesc.name);
      ADef.Extensions := DoRavenText(LDesc.extensions);
      ADef.Keywords := DoRavenText(LDesc.keywords);
      ADef.Types := DoRavenText(LDesc.types);
      ADef.Constants := DoRavenText(LDesc.constants);
      ADef.LineComment := DoRavenText(LDesc.line_comment);
      ADef.BlockCommentStart := DoRavenText(LDesc.block_comment_start);
      ADef.BlockCommentEnd := DoRavenText(LDesc.block_comment_end);
      ADef.StringQuotes := DoRavenText(LDesc.string_quotes);
      ADef.MultilineStrings := DoRavenText(LDesc.multiline_strings);
      ADef.Directive := DoRavenText(LDesc.directive);
      ADef.Annotation := DoRavenText(LDesc.annotation);
      ADef.Flags := UILanguageFlags(LDesc.flags);
      ADef.ScriptLanguage := DoRavenText(LDesc.script_language);
      return true;
    end;

    /// How many languages there are. C: Rlanguage_get_count
    static method Count(): int32;
    begin
      return Rlanguage_get_count();
    end;

    /// The name of language `AIndex` (from 0). C: Rlanguage_get_name
    static method Name(const AIndex: int32): string;
    begin
      return DoRavenText(Rlanguage_get_name(AIndex));
    end;

    /// The language of the file `APath` by its extension ("" for none). C: Rlanguage_for_file
    static method ForFile(const APath: string): string;
    begin
      return DoRavenText(Rlanguage_for_file(APath));
    end;
  end;

  /// The system's file dialogs (Raven's own with `UIFileDialogFlag.Raven`), built fluently
  /// and shown by `Open`, `Save` or `SelectFolder`, which wait for the user.
  /// C: RFileDialogDesc, Rfile_dialog_*
  /// @example `LFiles := UIFileDialog.Create().Title("Open").Filter("Adam", "*.adam").Open();`
  UIFileDialog = object
    hidden FParent: Rid;
    hidden FTitle: string;
    hidden FDirectory: string;
    hidden FFileName: string;
    hidden FDefaultExtension: string;
    hidden FFilters: array of UIFileFilter;
    hidden FFlags: UIFileDialogFlags;

    /// No parent, title, folder, name or filters (every file); flags none.
    init();
    begin
      self.FParent := R_INVALID_ID;
      self.FTitle := "";
      self.FDirectory := "";
      self.FFileName := "";
      self.FDefaultExtension := "";
      setlength(self.FFilters, 0);
      self.FFlags := [];
    end;

    /// A dialog with the defaults (see `init`).
    static method Create(): UIFileDialog;
    var
      LDialog: UIFileDialog;
    begin
      return LDialog;
    end;

    /// The window it belongs to (shown over it).
    method Parent(const AWindow: UIWindow): self;
    begin
      self.FParent := AWindow.Id();
      return self;
    end;

    /// Its title.
    method Title(const ATitle: string): self;
    begin
      self.FTitle := ATitle;
      return self;
    end;

    /// The folder it opens in.
    method Directory(const APath: string): self;
    begin
      self.FDirectory := APath;
      return self;
    end;

    /// The file name it offers.
    method FileName(const AName: string): self;
    begin
      self.FFileName := AName;
      return self;
    end;

    /// One more filter: the name it shows (`"Images"`) and its `;`-separated patterns
    /// (`"*.png;*.jpg"`); the first added is active.
    method Filter(const AName: string; const APatterns: string): self;
    begin
      setlength(self.FFilters, len(self.FFilters) + 1);
      self.FFilters[len(self.FFilters) - 1] := UIFileFilter(Name: AName, Patterns: APatterns);
      return self;
    end;

    /// The extension a saved name without one gets (`"adam"`).
    method DefaultExtension(const AExtension: string): self;
    begin
      self.FDefaultExtension := AExtension;
      return self;
    end;

    /// How it opens (several files, Raven's own, hidden files shown).
    method Flags(const AFlags: UIFileDialogFlags): self;
    begin
      self.FFlags := AFlags;
      return self;
    end;

    /// The files to open the user chose (several with `UIFileDialogFlag.Multiple`; empty:
    /// cancelled). C: Rfile_dialog_open, Rfile_dialog_get_result_count,
    /// Rfile_dialog_get_result
    const method Open(): StringArray;
    var
      LTexts: array of CString;
      LFilters: array of RFileFilter;
      LDesc: RFileDialogDesc;
      LPaths: StringArray;
      LCount: int32;
      LI: int32;
    begin
      setlength(LPaths, 0);
      self.DoDesc(LTexts, LFilters, LDesc);
      if Rfile_dialog_open(addr of LDesc) = nil then
        return LPaths;
      end;
      LCount := Rfile_dialog_get_result_count();
      setlength(LPaths, LCount);
      for LI := 0 to LCount - 1 do
        LPaths[LI] := DoRavenText(Rfile_dialog_get_result(LI));
      end;
      return LPaths;
    end;

    /// The file to save the user chose ("": cancelled). C: Rfile_dialog_save
    const method Save(): string;
    var
      LTexts: array of CString;
      LFilters: array of RFileFilter;
      LDesc: RFileDialogDesc;
    begin
      self.DoDesc(LTexts, LFilters, LDesc);
      return DoRavenText(Rfile_dialog_save(addr of LDesc));
    end;

    /// The folder the user chose ("": cancelled). C: Rfile_dialog_select_folder
    const method SelectFolder(): string;
    var
      LTexts: array of CString;
      LFilters: array of RFileFilter;
      LDesc: RFileDialogDesc;
    begin
      self.DoDesc(LTexts, LFilters, LDesc);
      return DoRavenText(Rfile_dialog_select_folder(addr of LDesc));
    end;

    // The C description of the dialog: its texts kept as C strings in ATexts and its filters
    // in AFilters while the dialog runs (the caller's locals); "" texts and patterns as NULL
    hidden const method DoDesc(var ATexts: array of CString; var AFilters: array of RFileFilter;
      var ADesc: RFileDialogDesc);
    var
      LI: int64;
    begin
      setlength(ATexts, 4 + len(self.FFilters) * 2);
      ATexts[0] := CString(self.FTitle);
      ATexts[1] := CString(self.FDirectory);
      ATexts[2] := CString(self.FFileName);
      ATexts[3] := CString(self.FDefaultExtension);
      setlength(AFilters, len(self.FFilters));
      for LI := 0 to len(self.FFilters) - 1 do
        ATexts[4 + LI * 2] := CString(self.FFilters[LI].Name);
        ATexts[5 + LI * 2] := CString(self.FFilters[LI].Patterns);
        AFilters[LI].name := ATexts[4 + LI * 2].Ptr;
        AFilters[LI].patterns := ATexts[5 + LI * 2].OrNil;
      end;
      ADesc.parent_ := self.FParent;
      ADesc.title := ATexts[0].OrNil;
      ADesc.directory := ATexts[1].OrNil;
      ADesc.file_name := ATexts[2].OrNil;
      ADesc.default_extension := ATexts[3].OrNil;
      ADesc.flags := uint32(self.FFlags);
      if len(AFilters) = 0 then
        ADesc.filters := nil;
        ADesc.filter_count := 0;
      else
        ADesc.filters := addr of AFilters[0];
        ADesc.filter_count := int32(len(AFilters));
      end;
    end;
  end;

  // A tray icon's holder: the icon destroyed and its closure let go with the last copy
  UITrayHold = object(UIResHold)
    FTray: Rid;

    done;
    begin
      self.Release();
    end;

    override method Unload();
    begin
      Rtray_destroy(self.FTray);
      GTrayClicks.Remove(uint64(self.FTray));
    end;
  end;

  /// An icon in the system tray (the notification area), with a tooltip, a title, a menu and
  /// a click closure. A shared handle: the last copy destroys it, the app's end too.
  /// C: Rtray_* (Rtray_destroy: the last copy's release)
  /// @example `LTray := UITrayRes(LIcon, "Adam"); LTray.Menu(LMenu).OnClick(func(const B: UIPointerButton) begin LWindow.Show(); end);`
  UITrayRes = object
    hidden FHold: ref UITrayHold;

    /// An empty handle (holds no icon: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
    end;

    /// A tray icon showing `AIcon` with the tooltip `ATooltip` (empty when the system has no
    /// tray: `Supported`). C: Rtray_create
    init(const AIcon: UIPixels; const ATooltip: string);
    var
      LHold: ref UITrayHold;
      LTray: Rid;
    begin
      LTray := Rtray_create();
      if LTray = R_INVALID_ID then
        return;
      end;
      LHold := ref UITrayHold();
      LHold.FTray := LTray;
      LHold.Live := true;
      DoTrackRes(LHold);
      self.FHold := LHold;
      self.Icon(AIcon);
      self.Tooltip(ATooltip);
    end;

    /// `true` when the system has a tray. C: Rtray_is_supported
    static method Supported(): bool;
    begin
      return Rtray_is_supported() <> 0;
    end;

    /// `true` while the handle holds a tray icon. C: Rtray_is_valid
    const method IsValid(): bool;
    begin
      return (self.FHold <> nil) and not self.FHold.Released and (Rtray_is_valid(self.FHold.FTray) <> 0);
    end;

    /// The icon's Rid, for .C calls (`R_INVALID_ID` when the handle holds none).
    const method Id(): Rid;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return R_INVALID_ID;
      end;
      return self.FHold.FTray;
    end;

    /// The picture it shows (pixels as `UIWindow.Icon`'s). C: Rtray_set_icon
    const method Icon(const AIcon: UIPixels): self;
    begin
      if (AIcon.Width <= 0) or (AIcon.Height <= 0) then
        Rtray_set_icon(self.Id(), nil, 0, 0);
        return self;
      end;
      if int64(len(AIcon.RGBA)) < int64(AIcon.Width) * int64(AIcon.Height) * 4 then
        return self;
      end;
      Rtray_set_icon(self.Id(), addr of AIcon.RGBA[0], AIcon.Width, AIcon.Height);
      return self;
    end;

    /// The text shown while the pointer rests on it. C: Rtray_set_tooltip
    const method Tooltip(const AText: string): self;
    begin
      Rtray_set_tooltip(self.Id(), AText);
      return self;
    end;

    /// The text beside it (where the system shows one). C: Rtray_set_title
    const method Title(const AText: string): self;
    begin
      Rtray_set_title(self.Id(), AText);
      return self;
    end;

    /// The menu its click opens (an empty `UIMenu()`: none). C: Rtray_set_menu
    const method Menu(const AMenu: UIMenu): self;
    begin
      Rtray_set_menu(self.Id(), AMenu.Id());
      return self;
    end;

    /// Where it is on the screen (an empty rect when the system does not tell).
    /// C: Rtray_get_rect
    const method Rect(): UIRect;
    var
      LX: int32;
      LY: int32;
      LW: int32;
      LH: int32;
    begin
      LX := 0;
      LY := 0;
      LW := 0;
      LH := 0;
      if Rtray_get_rect(self.Id(), addr of LX, addr of LY, addr of LW, addr of LH) = 0 then
        return UIRect(x: 0.0f, y: 0.0f, w: 0.0f, h: 0.0f);
      end;
      return UIRect(x: float32(LX), y: float32(LY), w: float32(LW), h: float32(LH));
    end;

    /// `AFunc` runs when it is clicked (`nil`: none). C: Rtray_set_clicked_callback
    const method OnClick(const AFunc: UITrayClickFunc): self;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return self;
      end;
      if AFunc = nil then
        GTrayClicks.Remove(uint64(self.FHold.FTray));
        Rtray_set_clicked_callback(self.FHold.FTray, nil, nil);
        return self;
      end;
      GTrayClicks.Put(uint64(self.FHold.FTray), AFunc);
      Rtray_set_clicked_callback(self.FHold.FTray, DoOnTrayClicked, nil);
      return self;
    end;
  end;

  /// Files Raven opens by path (an XML layout, a theme, a font ..) kept in memory: a path
  /// registered here is read from its bytes, never the disk. All static. A program's own
  /// files go through System.IO. C: Rfile_register_memory, Rfile_unregister_memory,
  /// Rfile_is_memory
  /// @example `UIFiles.Register("ui/main.xml", LBytes); UITheme.Load("ui/main.xml");`
  UIFiles = object
    /// The bytes `AData` (copied) as the file `APath`, replacing one registered there.
    /// @returns `false` (the error reported) when Raven refuses it. C: Rfile_register_memory
    static method Register(const APath: string; const AData: array of uint8): bool;
    begin
      if len(AData) = 0 then
        return Rfile_register_memory(APath, nil, 0, R_TRUE) <> 0;
      end;
      return Rfile_register_memory(APath, addr of AData[0], uint64(len(AData)), R_TRUE) <> 0;
    end;

    /// The file `APath` no longer in memory. C: Rfile_unregister_memory
    static method Unregister(const APath: string);
    begin
      Rfile_unregister_memory(APath);
    end;

    /// `true` when `APath` is a registered memory file. C: Rfile_is_memory
    static method IsMemory(const APath: string): bool;
    begin
      return Rfile_is_memory(APath) <> 0;
    end;
  end;

// ============================================================================
// XML windows and documents (listing sec 9, V10): UIXML is Raven's XML
// machinery (where files are looked for, auto-loading, live reload, the
// <Widget> declarations and the tags made by code), all static; UIXMLDocRes
// is a document read, changed, built and written back (a shared handle);
// UIXMLNode one node of it (a handle). A window or a widget tree made from
// XML is UIWindow.FromXML / UIWidget.FromXML (sec 4 / 5): the same typed
// handles as one built in code.
// ============================================================================

public type
  /// The routine told a file was loaded again by live reload: `APath` as the interface was
  /// made from it, `AOk` false when the file could not be used (the interface unchanged).
  UIXMLReloadFunc = ref func(const APath: string; const AOk: bool);
  /// The routine making the widget of a tag made by code (`UIXML.Tag`): `ATag` the tag as
  /// the document writes it.
  UIXMLTagCreateFunc = ref func(const ATag: string): UIWidget;
  /// The routine given each attribute of a tag made by code before Raven looks at it:
  /// `true` for one it understands, `false` to leave it to the widget.
  UIXMLTagAttributeFunc = ref func(const AWidget: UIWidget; const AName: string;
    const AValue: string): bool;

var
  // UIXML.OnReload's closure (nil: none)
  GOnXMLReload: UIXMLReloadFunc;
  // The tags made by code: their closures by the registration's key (Raven's user_data),
  // the key by the tag's lower-case name
  GXMLTagCreates: Map<uint64, UIXMLTagCreateFunc>;
  GXMLTagAttributes: Map<uint64, UIXMLTagAttributeFunc>;
  GXMLTagKeys: Map<string, uint64>;
  // The last key given
  GXMLTagLast: uint64;

func clink DoOnXMLReload(path: ptr to const char; ok: int32; user_data: ptr);
var
  LFunc: UIXMLReloadFunc;
begin
  LFunc := GOnXMLReload;
  if LFunc <> nil then
    LFunc(DoRavenText(path), ok <> 0);
  end;
end;

func clink DoOnXMLTagCreate(tag: ptr to const char; user_data: ptr): Rid;
var
  LFunc: UIXMLTagCreateFunc;
begin
  if not GXMLTagCreates.TryGet(uint64(user_data), LFunc) or (LFunc = nil) then
    return R_INVALID_ID;
  end;
  return LFunc(DoRavenText(tag)).Id();
end;

func clink DoOnXMLTagAttribute(widget: Rid; name: ptr to const char; value: ptr to const char;
  user_data: ptr): int32;
var
  LFunc: UIXMLTagAttributeFunc;
begin
  if not GXMLTagAttributes.TryGet(uint64(user_data), LFunc) or (LFunc = nil) then
    return R_FALSE;
  end;
  return DoCBool(LFunc(UIWidget.Wrap(widget), DoRavenText(name), DoRavenText(value)));
end;

// The tag ATag's closures let go (registered or not)
func DoDropXMLTag(const ATag: string);
var
  LKey: uint64;
begin
  if GXMLTagKeys.TryGet(LowerCase(ATag), LKey) then
    GXMLTagCreates.Remove(LKey);
    GXMLTagAttributes.Remove(LKey);
    GXMLTagKeys.Remove(LowerCase(ATag));
  end;
end;

type
  // An XML document's holder: the document destroyed with the last UIXMLDocRes copy, or
  // when the app ends first
  UIXMLDocHold = object(UIResHold)
    FDoc: Rid;

    done;
    begin
      self.Release();
    end;

    override method Unload();
    begin
      Rxml_document_destroy(self.FDoc);
    end;
  end;

public forward type UIXMLNode;

public type
  /// Raven's XML machinery, all static: where the files a document names are looked for
  /// (the document's folder and its subfolders, the base path, the current folder, PATH),
  /// auto-loading (the translation tables and `<Widget>` declarations found there), live
  /// reload (an interface made from a file follows the file while the app runs), the
  /// declared tags and the tags made by code, and what can be written (every tag and its
  /// attributes, for tools). C: Rxml_*
  /// @example `UIXML.BasePath("res/assets/ui"); UIXML.OnReload(func(const P: string; const AOk: bool) begin println("{} {}", P, AOk); end);`
  UIXML = object
    /// The folder looked into after the document's own, and the first one for documents
    /// given as text ("": none). C: Rxml_set_base_path
    static method BasePath(const APath: string);
    begin
      Rxml_set_base_path(APath);
    end;

    /// Where `APath`, a file a document names, is found, looked for as Raven looks (the
    /// path it would have beside the document, else in the base path, when no place holds
    /// it). C: Rxml_resolve_path
    static method ResolvePath(const APath: string): string;
    begin
      return DoRavenText(Rxml_resolve_path(APath));
    end;

    /// Auto-loading on (`true`, the default) or off: off, the register routines are the only
    /// way in. C: Rxml_set_auto_load
    static method AutoLoad(const AOn: bool);
    begin
      Rxml_set_auto_load(DoCBool(AOn));
    end;

    /// C: Rxml_get_auto_load
    static method AutoLoad(): bool;
    begin
      return Rxml_get_auto_load() <> 0;
    end;

    /// Live reload on (`true`, the default) or off: off, files are never looked at again.
    /// C: Rxml_set_live_reload
    static method LiveReload(const AOn: bool);
    begin
      Rxml_set_live_reload(DoCBool(AOn));
    end;

    /// C: Rxml_get_live_reload
    static method LiveReload(): bool;
    begin
      return Rxml_get_live_reload() <> 0;
    end;

    /// Looks at the files now (live reload looks five times a second), even with live
    /// reload off.
    /// @returns the files found changed. C: Rxml_check_files
    static method CheckFiles(): int32;
    begin
      return Rxml_check_files();
    end;

    /// `AFunc` runs each time a file was loaded again (`nil`: none): widgets built again
    /// have new handles, so it is the place to find them again. C: Rxml_set_reload_callback
    static method OnReload(const AFunc: UIXMLReloadFunc);
    begin
      GOnXMLReload := AFunc;
      if AFunc = nil then
        Rxml_set_reload_callback(nil, nil);
      else
        Rxml_set_reload_callback(DoOnXMLReload, nil);
      end;
    end;

    /// Reads the `<Widget Name="..">` declarations of the XML text `AXML` (its root, or the
    /// children of a `<Widgets>` root), so the documents loaded afterwards can use their tags.
    /// @returns the tags declared. C: Rxml_register_widgets
    static method RegisterWidgets(const AXML: string): int32;
    begin
      return Rxml_register_widgets(AXML, uint64(len(AXML)));
    end;

    /// Reads the declarations of the file `APath`, as `RegisterWidgets`.
    /// @returns the tags declared. C: Rxml_register_widgets_from_file
    static method RegisterWidgetsFile(const APath: string): int32;
    begin
      return Rxml_register_widgets_from_file(APath);
    end;

    /// The declared tag `AName` forgotten. C: Rxml_unregister_widget
    static method UnregisterWidget(const AName: string);
    begin
      Rxml_unregister_widget(AName);
    end;

    /// `true` when `AName` is a declared tag. C: Rxml_is_widget_registered
    static method WidgetRegistered(const AName: string): bool;
    begin
      return Rxml_is_widget_registered(AName) <> 0;
    end;

    /// The declared tags. C: Rxml_get_registered_widget_count
    static method RegisteredCount(): int32;
    begin
      return Rxml_get_registered_widget_count();
    end;

    /// The declared tag at `AIndex` (0 .. `RegisteredCount() - 1`). C:
    /// Rxml_get_registered_widget_name
    static method RegisteredName(const AIndex: int32): string;
    begin
      return DoRavenText(Rxml_get_registered_widget_name(AIndex));
    end;

    /// A tag made by code: documents write `<ATag ../>` as they write `<Button/>`, `ACreate`
    /// making its widget and `AAttribute` (`nil`: none) given each attribute first. A tag
    /// registered again is replaced.
    /// @returns `false` when `ATag` is one of Raven's widgets or 64 tags are registered.
    /// C: Rxml_register_tag
    static method Tag(const ATag: string; const ACreate: UIXMLTagCreateFunc;
      const AAttribute: UIXMLTagAttributeFunc): bool;
    var
      LKey: uint64;
      LOk: bool;
    begin
      if ACreate = nil then
        return false;
      end;
      GXMLTagLast := GXMLTagLast + 1;
      LKey := GXMLTagLast;
      if AAttribute = nil then
        LOk := Rxml_register_tag(ATag, DoOnXMLTagCreate, nil, ptr(LKey)) <> 0;
      else
        LOk := Rxml_register_tag(ATag, DoOnXMLTagCreate, DoOnXMLTagAttribute, ptr(LKey)) <> 0;
      end;
      if not LOk then
        return false;
      end;
      // Raven now calls with the new key: the old closures go
      DoDropXMLTag(ATag);
      GXMLTagCreates.Put(LKey, ACreate);
      if AAttribute <> nil then
        GXMLTagAttributes.Put(LKey, AAttribute);
      end;
      GXMLTagKeys.Put(LowerCase(ATag), LKey);
      return true;
    end;

    /// The tag made by code `ATag` forgotten, its closures let go. C: Rxml_unregister_tag
    static method UnregisterTag(const ATag: string);
    begin
      Rxml_unregister_tag(ATag);
      DoDropXMLTag(ATag);
    end;

    /// `true` when `ATag` is a tag made by code. C: Rxml_is_tag_registered
    static method TagRegistered(const ATag: string): bool;
    begin
      return Rxml_is_tag_registered(ATag) <> 0;
    end;

    /// Raven's tags, `<Window>` included (the declared ones: `RegisteredName`). C:
    /// Rxml_get_tag_count
    static method TagCount(): int32;
    begin
      return Rxml_get_tag_count();
    end;

    /// Raven's tag at `AIndex` (0 .. `TagCount() - 1`). C: Rxml_get_tag_name
    static method TagName(const AIndex: int32): string;
    begin
      return DoRavenText(Rxml_get_tag_name(AIndex));
    end;

    /// One line about the tag `ATag` ("" when there is nothing to say). C:
    /// Rxml_get_tag_description
    static method TagDescription(const ATag: string): string;
    begin
      return DoRavenText(Rxml_get_tag_description(ATag));
    end;

    /// The child widgets `ATag` takes: 0 none, 1 a single one, 2 any number (a declared or
    /// unknown tag: 2). C: Rxml_get_tag_children
    static method TagChildren(const ATag: string): int32;
    begin
      return Rxml_get_tag_children(ATag);
    end;

    /// The attributes `ATag` takes: its own, then every widget's, then its place's in its
    /// parent. C: Rxml_get_attribute_count
    static method AttributeCount(const ATag: string): int32;
    begin
      return Rxml_get_attribute_count(ATag);
    end;

    /// The attribute of `ATag` at `AIndex` (0 .. `AttributeCount(ATag) - 1`) into `AInfo`
    /// (its typed reads: `RXmlAttributeInfo`'s extend).
    /// @returns `false` for no such attribute. C: Rxml_get_attribute_info
    static method AttributeInfo(const ATag: string; const AIndex: int32;
      var AInfo: RXmlAttributeInfo): bool;
    begin
      return Rxml_get_attribute_info(ATag, AIndex, addr of AInfo) <> 0;
    end;
  end;

  /// An XML document as a tree of nodes, read, changed, built and written back (what an
  /// interface designer edits); comments are kept. What is built from it lives on after it.
  /// A shared handle: the last copy destroys the document and its nodes, the app's end too.
  /// C: Rxml_document_* (Rxml_document_destroy: the last copy's release)
  /// @example `LDoc := UIXMLDocRes.Create("VBox"); LDoc.Root().AddChild("Button").Attribute("Text", "Save"); LWidget := LDoc.CreateWidget();`
  UIXMLDocRes = object
    hidden FHold: ref UIXMLDocHold;

    /// An empty handle (holds no document: `IsValid()` false), as a variable declared with
    /// no arguments starts.
    init();
    begin
    end;

    /// The document of the XML file `APath` (the paths it names relative to its folder).
    /// C: Rxml_document_load
    init(const APath: string);
    begin
      self.FHold := UIXMLDocRes.DoMake(Rxml_document_load(APath), true).FHold;
    end;

    // The handle of ADoc, owning it (destroyed with the last copy) or a view
    hidden static method DoMake(const ADoc: Rid; const AOwned: bool): UIXMLDocRes;
    var
      LRes: UIXMLDocRes;
      LHold: ref UIXMLDocHold;
    begin
      if ADoc = R_INVALID_ID then
        return LRes;
      end;
      LHold := ref UIXMLDocHold();
      LHold.FDoc := ADoc;
      LHold.Live := AOwned;
      if AOwned then
        DoTrackRes(LHold);
      end;
      LRes.FHold := LHold;
      return LRes;
    end;

    /// A new document of one element, the tag `ARootTag`. C: Rxml_document_create
    static method Create(const ARootTag: string): UIXMLDocRes;
    begin
      return UIXMLDocRes.DoMake(Rxml_document_create(ARootTag), true);
    end;

    /// The document of the XML text `AXML` (`IsValid()` false when it does not read: its
    /// error reported to `UIErrors`). C: Rxml_document_parse
    static method Parse(const AXML: string): UIXMLDocRes;
    begin
      return UIXMLDocRes.DoMake(Rxml_document_parse(AXML, uint64(len(AXML)), nil), true);
    end;

    /// The document of the XML text `AXML`; a mistake in it is described in `AError`
    /// (`Message()`, line, column) and not reported (`IsValid()` false). C: Rxml_document_parse
    static method Parse(const AXML: string; var AError: RXmlError): UIXMLDocRes;
    begin
      return UIXMLDocRes.DoMake(Rxml_document_parse(AXML, uint64(len(AXML)), addr of AError), true);
    end;

    /// The document `ADoc` of System.Raven.C, borrowed (never destroyed by this handle).
    static method View(const ADoc: Rid): UIXMLDocRes;
    begin
      return UIXMLDocRes.DoMake(ADoc, false);
    end;

    /// `true` while it holds a document. C: Rxml_document_is_valid
    const method IsValid(): bool;
    begin
      return (self.FHold <> nil) and not self.FHold.Released and
        (Rxml_document_is_valid(self.FHold.FDoc) <> 0);
    end;

    /// The document's Rid, for .C calls (`R_INVALID_ID` when the handle holds none).
    const method Id(): Rid;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return R_INVALID_ID;
      end;
      return self.FHold.FDoc;
    end;

    /// Its root element. C: Rxml_document_get_root
    const method Root(): UIXMLNode;
    begin
      return UIXMLNode.Wrap(Rxml_document_get_root(self.Id()));
    end;

    /// The document as text, one element a line, tab-indented (each node's `Line()` then
    /// says where it was written). C: Rxml_document_to_string
    const method ToString(): string;
    begin
      return DoRavenText(Rxml_document_to_string(self.Id()));
    end;

    /// Writes the document to the file `APath`.
    /// @returns `false` when it could not be written. C: Rxml_document_save
    const method Save(const APath: string): bool;
    begin
      return Rxml_document_save(self.Id(), APath) <> 0;
    end;

    /// The widgets it describes (for a `<Window>` root, what the window shows: an empty
    /// handle when it is empty). C: Rxml_document_create_widget
    const method CreateWidget(): UIWidget;
    begin
      return UIWidget.Wrap(Rxml_document_create_widget(self.Id()));
    end;

    /// The window it describes. C: Rxml_document_create_window
    const method CreateWindow(): UIWindow;
    begin
      return UIWindow.Wrap(Rxml_document_create_window(self.Id()));
    end;
  end;

  /// One node of a `UIXMLDocRes`, an element or a comment: a handle (Raven's Rid of the
  /// node), copied freely; it names no node once removed or its document destroyed. A new
  /// child goes at `AIndex` among its parent's children (-1: the end). C: Rxml_node_*
  UIXMLNode = object
    hidden FNode: Rid;

    /// An empty node handle (names none).
    init();
    begin
      self.FNode := R_INVALID_ID;
    end;

    /// The handle of the node System.Raven.C gave as `ANode`.
    static method Wrap(const ANode: Rid): UIXMLNode;
    var
      LNode: UIXMLNode;
    begin
      LNode.FNode := ANode;
      return LNode;
    end;

    /// The node's Rid, for System.Raven.C's calls.
    const method Id(): Rid;
    begin
      return self.FNode;
    end;

    /// `true` while the handle names a node. C: Rxml_node_is_valid
    const method IsValid(): bool;
    begin
      return Rxml_node_is_valid(self.FNode) <> 0;
    end;

    /// `true` for a comment. C: Rxml_node_is_comment
    const method IsComment(): bool;
    begin
      return Rxml_node_is_comment(self.FNode) <> 0;
    end;

    /// The document it is in, borrowed (this handle never destroys it). C:
    /// Rxml_node_get_document
    const method Document(): UIXMLDocRes;
    begin
      return UIXMLDocRes.View(Rxml_node_get_document(self.FNode));
    end;

    /// The element's tag. C: Rxml_node_set_tag
    const method Tag(const ATag: string): self;
    begin
      Rxml_node_set_tag(self.FNode, ATag);
      return self;
    end;

    /// The element's tag ("" for a comment). C: Rxml_node_get_tag
    const method Tag(): string;
    begin
      return DoRavenText(Rxml_node_get_tag(self.FNode));
    end;

    /// The text inside the element (`<Label>this</Label>`), or the comment's. C:
    /// Rxml_node_set_text
    const method Text(const AText: string): self;
    begin
      Rxml_node_set_text(self.FNode, AText);
      return self;
    end;

    /// C: Rxml_node_get_text
    const method Text(): string;
    begin
      return DoRavenText(Rxml_node_get_text(self.FNode));
    end;

    /// Its parent (an empty handle for the root). C: Rxml_node_get_parent
    const method Parent(): UIXMLNode;
    begin
      return UIXMLNode.Wrap(Rxml_node_get_parent(self.FNode));
    end;

    /// Its children. C: Rxml_node_get_child_count
    const method ChildCount(): int32;
    begin
      return Rxml_node_get_child_count(self.FNode);
    end;

    /// Its child at `AIndex` (0 .. `ChildCount() - 1`). C: Rxml_node_get_child
    const method Child(const AIndex: int32): UIXMLNode;
    begin
      return UIXMLNode.Wrap(Rxml_node_get_child(self.FNode, AIndex));
    end;

    /// Its place among its parent's children (0 for the root). C: Rxml_node_get_index
    const method Index(): int32;
    begin
      return Rxml_node_get_index(self.FNode);
    end;

    /// A new element `ATag`, its last child. C: Rxml_node_add_child
    const method AddChild(const ATag: string): UIXMLNode;
    begin
      return UIXMLNode.Wrap(Rxml_node_add_child(self.FNode, ATag, -1));
    end;

    /// A new element `ATag`, its child at `AIndex` (-1: the end; an empty handle when it would
    /// be nested deeper than 256 levels). C: Rxml_node_add_child
    const method AddChild(const ATag: string; const AIndex: int32): UIXMLNode;
    begin
      return UIXMLNode.Wrap(Rxml_node_add_child(self.FNode, ATag, AIndex));
    end;

    /// A new comment `AText`, its last child. C: Rxml_node_add_comment
    const method AddComment(const AText: string): UIXMLNode;
    begin
      return UIXMLNode.Wrap(Rxml_node_add_comment(self.FNode, AText, -1));
    end;

    /// A new comment `AText`, its child at `AIndex` (-1: the end). C: Rxml_node_add_comment
    const method AddComment(const AText: string; const AIndex: int32): UIXMLNode;
    begin
      return UIXMLNode.Wrap(Rxml_node_add_comment(self.FNode, AText, AIndex));
    end;

    /// The element of the XML text `AXML` (one element and what it holds: a paste, a
    /// template), read and added as its last child. C: Rxml_node_add_xml
    const method AddXML(const AXML: string): UIXMLNode;
    begin
      return UIXMLNode.Wrap(Rxml_node_add_xml(self.FNode, AXML, uint64(len(AXML)), -1));
    end;

    /// The element of `AXML` added as its child at `AIndex` (-1: the end). C: Rxml_node_add_xml
    const method AddXML(const AXML: string; const AIndex: int32): UIXMLNode;
    begin
      return UIXMLNode.Wrap(Rxml_node_add_xml(self.FNode, AXML, uint64(len(AXML)), AIndex));
    end;

    /// Removes the node and what it holds (the root stays). C: Rxml_node_remove
    const method Remove();
    begin
      Rxml_node_remove(self.FNode);
    end;

    /// Moves the node, with what it holds, under `AParent` at `AIndex` (counted once it left
    /// its place; -1: the end).
    /// @returns `false` when it cannot be (the root, a parent inside it, too deep). C:
    /// Rxml_node_move
    const method Move(const AParent: UIXMLNode; const AIndex: int32): bool;
    begin
      return Rxml_node_move(self.FNode, AParent.FNode, AIndex) <> 0;
    end;

    /// A copy of the node and what it holds, right after it. C: Rxml_node_duplicate
    const method Duplicate(): UIXMLNode;
    begin
      return UIXMLNode.Wrap(Rxml_node_duplicate(self.FNode));
    end;

    /// The node as XML text. C: Rxml_node_to_string
    const method ToString(): string;
    begin
      return DoRavenText(Rxml_node_to_string(self.FNode));
    end;

    /// Its attributes. C: Rxml_node_get_attribute_count
    const method AttributeCount(): int32;
    begin
      return Rxml_node_get_attribute_count(self.FNode);
    end;

    /// The name of its attribute at `AIndex`. C: Rxml_node_get_attribute_name
    const method AttributeName(const AIndex: int32): string;
    begin
      return DoRavenText(Rxml_node_get_attribute_name(self.FNode, AIndex));
    end;

    /// The value of its attribute at `AIndex`. C: Rxml_node_get_attribute_value
    const method AttributeValue(const AIndex: int32): string;
    begin
      return DoRavenText(Rxml_node_get_attribute_value(self.FNode, AIndex));
    end;

    /// The attribute `AName` set to `AValue` (added after the others when new). C:
    /// Rxml_node_set_attribute
    const method Attribute(const AName: string; const AValue: string): self;
    begin
      Rxml_node_set_attribute(self.FNode, AName, AValue);
      return self;
    end;

    /// The value of the attribute `AName` (names compared without case; "" when it has none:
    /// `HasAttribute`). C: Rxml_node_get_attribute
    const method Attribute(const AName: string): string;
    begin
      return DoRavenText(Rxml_node_get_attribute(self.FNode, AName));
    end;

    /// `true` when it has the attribute `AName`. C: Rxml_node_get_attribute
    const method HasAttribute(const AName: string): bool;
    begin
      return Rxml_node_get_attribute(self.FNode, AName) <> nil;
    end;

    /// The attribute `AName` removed. C: Rxml_node_set_attribute
    const method RemoveAttribute(const AName: string): self;
    begin
      Rxml_node_set_attribute(self.FNode, AName, nil);
      return self;
    end;

    /// Its line (from 1) in the text the document was read from or last written to (0 for a
    /// node added since). C: Rxml_node_get_line
    const method Line(): int32;
    begin
      return Rxml_node_get_line(self.FNode);
    end;

    /// The widget (the window, for a `<Window>`) it became the last time the document was
    /// built (an empty handle: never built, destroyed since, or no widget). C:
    /// Rxml_node_get_widget
    const method Widget(): UIWidget;
    begin
      return UIWidget.Wrap(Rxml_node_get_widget(self.FNode));
    end;
  end;

// The node a widget was built from: with the XML types
public extend UIWidget
  /// The node of a document the widget was built from (an empty handle: not built from a
  /// document, or it is gone). C: Rwidget_get_xml_node
  const method XMLNode(): UIXMLNode;
  begin
    return UIXMLNode.Wrap(Rwidget_get_xml_node(self.Id()));
  end;
end;

// ============================================================================
// Hosting (listing sec 10, V10): Raven inside another program's windows.
// UIHost is Raven's host platform (no OS window of Raven's own: the program
// tells Raven its windows' size, scale, focus and input, Raven asks it for the
// cursor, the clipboard and a wake-up, UIHostPlatform's closures) and a
// render backend of the program's own (RBackendVTable); UIVulkan shares
// Raven's Vulkan device and textures with a Vulkan engine. Both static. A
// raylib program has all of it ready made: System.Raven.Raylib's RaylibHost.
// ============================================================================

public type
  /// The routine giving Raven's window `AWindow` the cursor `ACursor` (`UICursor.None`:
  /// hidden).
  UIHostCursorFunc = ref func(const AWindow: UIWindow; const ACursor: UICursor);
  /// The routine putting `AText` on the program's clipboard.
  UIHostClipboardSetFunc = ref func(const AText: string);
  /// The routine giving the program's clipboard text ("" when it holds none).
  UIHostClipboardGetFunc = ref func(): string;
  /// The routine waking the program's loop (Raven has work: a post, a timer, an animation);
  /// it runs on any thread.
  UIHostWakeFunc = ref func();
  /// The routine taking (or giving back) the program's lock on the Vulkan queue Raven shares.
  UIVulkanLockFunc = ref func();

var
  // UIHost.Register's closures (nil: none)
  GHostCursor: UIHostCursorFunc;
  GHostClipboardSet: UIHostClipboardSetFunc;
  GHostClipboardGet: UIHostClipboardGetFunc;
  GHostWake: UIHostWakeFunc;
  // The last clipboard text given Raven, kept until the next ask
  GHostClipboardText: CString;
  // UIVulkan.QueueLock's closures (nil: none)
  GVulkanLock: UIVulkanLockFunc;
  GVulkanUnlock: UIVulkanLockFunc;

func clink DoOnHostCursor(window: Rid; cursor: RCursor; user_data: ptr);
var
  LFunc: UIHostCursorFunc;
begin
  LFunc := GHostCursor;
  if LFunc <> nil then
    LFunc(UIWindow.Wrap(window), UICursor(cursor));
  end;
end;

func clink DoOnHostClipboardSet(text: ptr to const char; user_data: ptr);
var
  LFunc: UIHostClipboardSetFunc;
begin
  LFunc := GHostClipboardSet;
  if LFunc <> nil then
    LFunc(DoRavenText(text));
  end;
end;

func clink DoOnHostClipboardGet(user_data: ptr): ptr to const char;
var
  LFunc: UIHostClipboardGetFunc;
begin
  LFunc := GHostClipboardGet;
  if LFunc = nil then
    return nil;
  end;
  GHostClipboardText := CString(LFunc());
  return GHostClipboardText.Ptr;
end;

func clink DoOnHostWake(user_data: ptr);
var
  LFunc: UIHostWakeFunc;
begin
  LFunc := GHostWake;
  if LFunc <> nil then
    LFunc();
  end;
end;

func clink DoOnVulkanLock(user_data: ptr);
var
  LFunc: UIVulkanLockFunc;
begin
  LFunc := GVulkanLock;
  if LFunc <> nil then
    LFunc();
  end;
end;

func clink DoOnVulkanUnlock(user_data: ptr);
var
  LFunc: UIVulkanLockFunc;
begin
  LFunc := GVulkanUnlock;
  if LFunc <> nil then
    LFunc();
  end;
end;

// The texts of a C list of ACount C strings (Raven's extension lists)
func DoCTexts(const AList: ptr to const ptr to const char; const ACount: Ruint): StringArray;
var
  LTexts: StringArray;
  LI: int64;
begin
  if AList = nil then
    return LTexts;
  end;
  setlength(LTexts, int64(ACount));
  for LI := 0 to int64(ACount) - 1 do
    LTexts[LI] := DoRavenText(AList[LI]);
  end;
  return LTexts;
end;

// The app ends (DoAppShutdown, before Rshutdown): sec 9's and sec 10's callbacks cleared and
// their closures let go. The host platform stays registered: it is the next Rinit's choice
// (UIHost.Unregister); its closures stay with it. The Vulkan queue lock is not cleared here:
// Raven takes it only before Rinit and may still lock the queue while it shuts down
// (DoDropVulkanLock, after Rshutdown)
func DoDropHosting();
var
  LKeys: array of string;
  LI: int64;
begin
  Rxml_set_reload_callback(nil, nil);
  GOnXMLReload := nil;
  LKeys := GXMLTagKeys.Keys();
  for LI := 0 to len(LKeys) - 1 do
    Rxml_unregister_tag(LKeys[LI]);
  end;
  GXMLTagCreates.Clear();
  GXMLTagAttributes.Clear();
  GXMLTagKeys.Clear();
end;

// The app has ended (DoAppShutdown, after Rshutdown): the Vulkan queue lock UIVulkan.QueueLock
// set is cleared (Raven takes it again before the next Rinit) and its closures let go. Nothing
// when none was set
func DoDropVulkanLock();
begin
  if (GVulkanLock = nil) and (GVulkanUnlock = nil) then
    return;
  end;
  Rvulkan_set_queue_lock_callbacks(nil, nil, nil);
  GVulkanLock := nil;
  GVulkanUnlock := nil;
end;

public type
  /// What a program hosting Raven answers Raven's asks with (`UIHost.Register`): closures for
  /// the cursor, the clipboard both ways and waking the program's loop, each optional. A
  /// value, built fluently.
  /// @example `UIHost.Register(UIHostPlatform().Cursor(func(const W: UIWindow; const C: UICursor) begin SetMyCursor(C); end));`
  UIHostPlatform = object
    hidden FCursor: UIHostCursorFunc;
    hidden FClipboardSet: UIHostClipboardSetFunc;
    hidden FClipboardGet: UIHostClipboardGetFunc;
    hidden FWake: UIHostWakeFunc;

    /// No closures: Raven keeps its cursor and clipboard to itself.
    init();
    begin
    end;

    /// The cursor Raven wants over one of its windows.
    method Cursor(const AFunc: UIHostCursorFunc): self;
    begin
      self.FCursor := AFunc;
      return self;
    end;

    /// The cursor closure (`nil`: none).
    const method Cursor(): UIHostCursorFunc;
    begin
      return self.FCursor;
    end;

    /// Raven copies text to the clipboard.
    method ClipboardSet(const AFunc: UIHostClipboardSetFunc): self;
    begin
      self.FClipboardSet := AFunc;
      return self;
    end;

    /// The clipboard-copy closure (`nil`: none).
    const method ClipboardSet(): UIHostClipboardSetFunc;
    begin
      return self.FClipboardSet;
    end;

    /// Raven pastes the clipboard's text.
    method ClipboardGet(const AFunc: UIHostClipboardGetFunc): self;
    begin
      self.FClipboardGet := AFunc;
      return self;
    end;

    /// The clipboard-paste closure (`nil`: none).
    const method ClipboardGet(): UIHostClipboardGetFunc;
    begin
      return self.FClipboardGet;
    end;

    /// Raven has work for the next frame (any thread).
    method Wake(const AFunc: UIHostWakeFunc): self;
    begin
      self.FWake := AFunc;
      return self;
    end;

    /// The wake closure (`nil`: none).
    const method Wake(): UIHostWakeFunc;
    begin
      return self.FWake;
    end;
  end;

  /// Raven inside the windows of another program (an editor's panels, an engine's screen),
  /// all static. `Register` before the app opens makes it run on the host platform: Raven
  /// opens no OS window and reads no OS events; the program tells each Raven window its size
  /// and scale (in its pixels) and gives it its input (`Inject*`), and draws it with a
  /// backend of its own (`RegisterBackend`, `UIBackend.Custom`) or Raven's. C: Rhost_*,
  /// Rbackend_*
  /// @example `UIHost.Register(LPlatform); LApp := UIApp.Config().AppName("Editor").Open(); UIHost.WindowSize(LPanel, 640, 480, 1.0f);`
  UIHost = object
    /// The next app opened runs on the host platform, answering Raven with `APlatform`'s
    /// closures. C: Rhost_platform_register
    static method Register(const APlatform: UIHostPlatform);
    var
      LDesc: RHostPlatformDesc;
    begin
      GHostCursor := APlatform.Cursor();
      GHostClipboardSet := APlatform.ClipboardSet();
      GHostClipboardGet := APlatform.ClipboardGet();
      GHostWake := APlatform.Wake();
      if GHostCursor <> nil then
        LDesc.set_cursor := DoOnHostCursor;
      end;
      if GHostClipboardSet <> nil then
        LDesc.clipboard_set := DoOnHostClipboardSet;
      end;
      if GHostClipboardGet <> nil then
        LDesc.clipboard_get := DoOnHostClipboardGet;
      end;
      if GHostWake <> nil then
        LDesc.wake := DoOnHostWake;
      end;
      Rhost_platform_register(addr of LDesc);
    end;

    /// The next app opened runs on the OS's own platform again (the default), the
    /// closures let go. C: Rhost_platform_register
    static method Unregister();
    begin
      Rhost_platform_register(nil);
      GHostCursor := nil;
      GHostClipboardSet := nil;
      GHostClipboardGet := nil;
      GHostWake := nil;
      GHostClipboardText := CString();
    end;

    /// `true` while the open app runs on the host platform. C: Rhost_platform_is_active
    static method Active(): bool;
    begin
      return Rhost_platform_is_active() <> 0;
    end;

    /// `AWindow`'s size, `AWidth` x `AHeight` pixels, and its scale (pixels a UI unit). C:
    /// Rhost_window_set_size
    static method WindowSize(const AWindow: UIWindow; const AWidth: int32; const AHeight: int32;
      const AScale: float32);
    begin
      Rhost_window_set_size(AWindow.Id(), AWidth, AHeight, AScale);
    end;

    /// The edges of `AWindow` system bars and notches cover, and the height the on-screen
    /// keyboard covers (0: none). C: Rhost_window_set_insets
    static method Insets(const AWindow: UIWindow; const ASafeArea: RInsets;
      const AKeyboardHeight: int32);
    begin
      Rhost_window_set_insets(AWindow.Id(), addr of ASafeArea, AKeyboardHeight);
    end;

    /// `true` when the system's look is dark (themes following the system follow it). C:
    /// Rhost_set_system_dark
    static method SystemDark(const AOn: bool);
    begin
      Rhost_set_system_dark(DoCBool(AOn));
    end;

    /// The mouse moved to (`AX`, `AY`) pixels in `AWindow`. C: Rhost_inject_mouse_move
    static method InjectMove(const AWindow: UIWindow; const AX: int32; const AY: int32;
      const AMods: UIModifiers);
    begin
      Rhost_inject_mouse_move(AWindow.Id(), AX, AY, Ruint(uint32(AMods)));
    end;

    /// The mouse button `AButton` went down (`APressed`) or up at (`AX`, `AY`). C:
    /// Rhost_inject_mouse_button
    static method InjectButton(const AWindow: UIWindow; const AX: int32; const AY: int32;
      const AButton: UIPointerButton; const APressed: bool; const AMods: UIModifiers);
    begin
      Rhost_inject_mouse_button(AWindow.Id(), AX, AY, RMouseButton(AButton), DoCBool(APressed),
        Ruint(uint32(AMods)));
    end;

    /// The wheel turned by `AX`, `AY` notches. C: Rhost_inject_mouse_wheel
    static method InjectWheel(const AWindow: UIWindow; const AX: float32; const AY: float32;
      const AMods: UIModifiers);
    begin
      Rhost_inject_mouse_wheel(AWindow.Id(), AX, AY, Ruint(uint32(AMods)));
    end;

    /// The mouse left `AWindow` (hover ends). C: Rhost_inject_mouse_leave
    static method InjectLeave(const AWindow: UIWindow);
    begin
      Rhost_inject_mouse_leave(AWindow.Id());
    end;

    /// The key `AKey` went down (`APressed`; `ARepeat` for the system's auto-repeat) or up.
    /// C: Rhost_inject_key
    static method InjectKey(const AWindow: UIWindow; const AKey: UIKey; const APressed: bool;
      const AMods: UIModifiers; const ARepeat: bool);
    begin
      Rhost_inject_key(AWindow.Id(), RKey(AKey), DoCBool(APressed), Ruint(uint32(AMods)),
        DoCBool(ARepeat));
    end;

    /// The character `ACodepoint` (a Unicode code point) was typed. C: Rhost_inject_text
    static method InjectText(const AWindow: UIWindow; const ACodepoint: uint32);
    begin
      Rhost_inject_text(AWindow.Id(), ACodepoint);
    end;

    /// `AWindow` took (`true`) or lost the keyboard focus. C: Rhost_inject_focus
    static method InjectFocus(const AWindow: UIWindow; const AOn: bool);
    begin
      Rhost_inject_focus(AWindow.Id(), DoCBool(AOn));
    end;

    /// The user asked to close `AWindow` (its OnClose decides). C: Rhost_inject_close
    static method InjectClose(const AWindow: UIWindow);
    begin
      Rhost_inject_close(AWindow.Id());
    end;

    /// The program's render backend, for `UIBackend.Custom` (before the app opens; Raven
    /// copies the table). C: Rbackend_register
    static method RegisterBackend(const AVTable: RBackendVTable);
    begin
      Rbackend_register(addr of AVTable);
    end;

    /// The program's backend lost its device (any thread): Raven makes its textures again.
    /// C: Rbackend_device_lost
    static method DeviceLost();
    begin
      Rbackend_device_lost();
    end;

    /// A pixel buffer of `ASize` bytes Raven frees, for a backend's frame capture
    /// (`RCapture.pixels`); any thread. C: Rpixels_alloc
    static method CapturePixels(const ASize: uint64): ptr to uint8;
    begin
      return Rpixels_alloc(ASize);
    end;
  end;

  /// Raven's Vulkan device shared with a Vulkan engine (Raven on `UIBackend.Vulkan`), all
  /// static: the extensions Raven needs, an engine's own device given to Raven (before the app
  /// opens), Raven's handles read, the queue's lock, and textures over the engine's image
  /// views or shared across processes. The handles are Vulkan's, as `ptr` (`nil` off Vulkan).
  /// C: Rvulkan_*
  /// @example `LExtensions := UIVulkan.RequiredInstanceExtensions(); UIVulkan.ExternalDevice(LInstance, LGpu, LDevice, LQueue, LFamily);`
  UIVulkan = object
    /// The instance extensions Raven needs enabled. C: Rvulkan_get_required_instance_extensions
    static method RequiredInstanceExtensions(): StringArray;
    var
      LCount: Ruint;
      LList: ptr to const ptr to const char;
    begin
      LCount := 0;
      LList := Rvulkan_get_required_instance_extensions(addr of LCount);
      return DoCTexts(LList, LCount);
    end;

    /// The device extensions Raven needs enabled. C: Rvulkan_get_required_device_extensions
    static method RequiredDeviceExtensions(): StringArray;
    var
      LCount: Ruint;
      LList: ptr to const ptr to const char;
    begin
      LCount := 0;
      LList := Rvulkan_get_required_device_extensions(addr of LCount);
      return DoCTexts(LList, LCount);
    end;

    /// Raven runs on the engine's device: its `VkInstance`, `VkPhysicalDevice`, `VkDevice`,
    /// graphics `VkQueue` and that queue's family (before the app opens). C:
    /// Rvulkan_set_external_device
    static method ExternalDevice(const AInstance: ptr; const APhysicalDevice: ptr;
      const ADevice: ptr; const AQueue: ptr; const AQueueFamily: uint32);
    begin
      Rvulkan_set_external_device(AInstance, APhysicalDevice, ADevice, AQueue, AQueueFamily);
    end;

    /// `ALock` and `AUnlock` run around each of Raven's uses of a shared queue (`nil`, `nil`:
    /// none). Set it before the app opens: Raven refuses it while it runs; it stays until the
    /// app has shut down. C: Rvulkan_set_queue_lock_callbacks
    static method QueueLock(const ALock: UIVulkanLockFunc; const AUnlock: UIVulkanLockFunc);
    begin
      GVulkanLock := ALock;
      GVulkanUnlock := AUnlock;
      if (ALock = nil) and (AUnlock = nil) then
        Rvulkan_set_queue_lock_callbacks(nil, nil, nil);
      else
        Rvulkan_set_queue_lock_callbacks(DoOnVulkanLock, DoOnVulkanUnlock, nil);
      end;
    end;

    /// Raven's `VkInstance`. C: Rvulkan_get_instance
    static method Instance(): ptr;
    begin
      return Rvulkan_get_instance();
    end;

    /// Raven's `VkPhysicalDevice`. C: Rvulkan_get_physical_device
    static method PhysicalDevice(): ptr;
    begin
      return Rvulkan_get_physical_device();
    end;

    /// Raven's `VkDevice`. C: Rvulkan_get_device
    static method Device(): ptr;
    begin
      return Rvulkan_get_device();
    end;

    /// Raven's graphics `VkQueue`. C: Rvulkan_get_graphics_queue
    static method GraphicsQueue(): ptr;
    begin
      return Rvulkan_get_graphics_queue();
    end;

    /// The graphics queue's family. C: Rvulkan_get_graphics_queue_family
    static method GraphicsQueueFamily(): uint32;
    begin
      return Rvulkan_get_graphics_queue_family();
    end;

    /// Acts as if the device was lost (the recovery path, for tests). C:
    /// Rvulkan_simulate_device_lost
    static method SimulateDeviceLost();
    begin
      Rvulkan_simulate_device_lost();
    end;

    /// A texture showing the engine's `VkImageView` `AImageView` through its `VkSampler`
    /// `ASampler`, `AWidth` x `AHeight` (the engine keeps the image). C:
    /// Rvulkan_texture_create_from_image_view
    static method TextureFromImageView(const AImageView: uint64; const ASampler: uint64;
      const AWidth: int32; const AHeight: int32): UITextureRes;
    begin
      return UITextureRes.Adopt(Rvulkan_texture_create_from_image_view(AImageView, ASampler,
        AWidth, AHeight));
    end;

    /// `ATexture` shows another image view of the engine's (after it made the image again).
    /// C: Rvulkan_texture_set_image_view
    static method TextureImageView(const ATexture: UITextureRes; const AImageView: uint64;
      const ASampler: uint64; const AWidth: int32; const AHeight: int32);
    begin
      Rvulkan_texture_set_image_view(ATexture.Id(), AImageView, ASampler, AWidth, AHeight);
    end;

    /// A texture `AWidth` x `AHeight` whose memory another process can open
    /// (`SharedInfo`). C: Rvulkan_texture_create_shared
    static method SharedTexture(const AWidth: int32; const AHeight: int32): UITextureRes;
    begin
      return UITextureRes.Adopt(Rvulkan_texture_create_shared(AWidth, AHeight));
    end;

    /// The OS handle and size of a shared texture's memory into `AInfo`.
    /// @returns `false` when `ATexture` is no shared texture. C: Rvulkan_texture_get_shared_info
    static method SharedInfo(const ATexture: UITextureRes; var AInfo: RSharedTextureInfo): bool;
    begin
      return Rvulkan_texture_get_shared_info(ATexture.Id(), addr of AInfo) <> 0;
    end;
  end;

end.
