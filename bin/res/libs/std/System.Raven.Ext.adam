      return LWidget;
    end;

    /// The kind a spacer views.
    /// @returns the kind a spacer views
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Spacer];
    end;

    /// The room the spacer asks for. C: Rspacer_set_size
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    const method Size(const AWidth: float32; const AHeight: float32): self;
    begin
      Rspacer_set_size(self.FId, AWidth, AHeight);
      return self;
    end;
  end;

  /// A view scrolling one child larger than itself. C: Rscroll_box_*
  UIScrollBox = object(UIWidget)
    /// A new, empty scroll box. C: Rwidget_create(R_WIDGET_SCROLL_BOX)
