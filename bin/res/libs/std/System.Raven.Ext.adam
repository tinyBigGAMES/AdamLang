  /// Pages under a row of tabs, one page shown; each page is a child, its tab a `UITab`.
  /// C: Rtab_view_*
  /// @example `LTabs := UITabView.Create(); LTabs.AddTab("General", LGeneral).Closable(false);`
  UITabView = object(UIWidget)
    /// A new tab view with no pages. C: Rwidget_create(R_WIDGET_TAB_VIEW)
    /// @returns a new tab view with no pages
    static method Create(): UITabView;
    var
      LWidget: UITabView;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.TabView)));
      return LWidget;
    end;

    /// The kind a tab view views.
    /// @returns the kind a tab view views
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.TabView];
    end;

    /// A new page `AContent` last, under a tab titled `ATitle` (an empty tab when Raven
    /// refuses it). C: Rtab_view_add_tab
    /// @param ATitle the title
    /// @param AContent the content widget
    /// @returns a new page `AContent` last, under a tab titled `ATitle` (an empty tab when Raven
    ///   refuses it)
    const method AddTab(const ATitle: string; const AContent: UIWidget): UITab;
    begin
      if Rtab_view_add_tab(self.FId, ATitle, AContent.Id()) < 0 then
        return UITab.Wrap(self.FId, R_INVALID_ID);
      end;
      return UITab.Wrap(self.FId, AContent.Id());
    end;

    /// Shows the page at `AIndex`. C: Rtab_view_set_active
    /// @param AIndex the index, from 0
    /// @returns this object, so calls chain
    const method Active(const AIndex: int32): self;
    begin
      Rtab_view_set_active(self.FId, AIndex);
      return self;
    end;

    /// The index of the page shown (-1 for none). C: Rtab_view_get_active
    /// @returns the index of the page shown (-1 for none)
    const method Active(): int32;
    begin
      return Rtab_view_get_active(self.FId);
    end;

    /// Document tabs when `AOn` (an editor's: each with a close button, shrinking when they
    /// do not fit). C: Rtab_view_set_documents
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method Documents(const AOn: bool): self;
    begin
      Rtab_view_set_documents(self.FId, DoCBool(AOn));
      return self;
    end;

    /// The pages the view holds. C: Rtab_view_get_tab_count
    /// @returns the pages the view holds
    const method TabCount(): int32;
    begin
      return Rtab_view_get_tab_count(self.FId);
    end;

    /// The tab at `AIndex` (an empty one outside 0 .. TabCount() - 1). C: Rtab_view_get_tab
    /// @param AIndex the index, from 0
    /// @returns the tab at `AIndex` (an empty one outside 0 .
    const method Tab(const AIndex: int32): UITab;
    begin
      return UITab.Wrap(self.FId, Rtab_view_get_tab(self.FId, AIndex));
    end;

    /// The tab of the page `AContent` (an empty one when it is no page here).
    /// C: Rtab_view_find_tab
    /// @param AContent the content widget
    /// @returns the tab of the page `AContent` (an empty one when it is no page here)
    const method FindTab(const AContent: UIWidget): UITab;
    begin
      if Rtab_view_find_tab(self.FId, AContent.Id()) < 0 then
        return UITab.Wrap(self.FId, R_INVALID_ID);
      end;
      return UITab.Wrap(self.FId, AContent.Id());
    end;

    /// Runs `AFunc` with the index of the page shown when it changes.
    /// C: Rtab_view_set_changed_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnChanged(const AFunc: UIIndexFunc): self;
    begin
      if AFunc = nil then
        GControlIndexes.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtab_view_set_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtab_view_set_changed_callback(self.FId, DoOnControlIndex,
        GControlIndexes.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;

    /// Runs `AFunc` when a tab's close button is pressed: `true` deletes its page, `false`
    /// keeps it. C: Rtab_view_set_close_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnClose(const AFunc: UITabCloseFunc): self;
    begin
      if AFunc = nil then
        GTabCloses.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rtab_view_set_close_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rtab_view_set_close_callback(self.FId, DoOnTabClose,
        GTabCloses.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// One tab of a `UITabView`: a view of (the tab view, its page), copied freely; it names
  /// no tab once the page is gone. C: Rtab_view_*_tab_*
  UITab = object
    hidden FView: Rid;
    hidden FContent: Rid;

    /// An empty tab (names none).
    init();
    begin
      self.FView := R_INVALID_ID;
      self.FContent := R_INVALID_ID;
    end;

    /// The tab of the page `AContent` in the tab view `AView` (both Rids).
    /// @param AView the view
    /// @param AContent the content widget
    /// @returns the tab of the page `AContent` in the tab view `AView` (both Rids)
    static method Wrap(const AView: Rid; const AContent: Rid): UITab;
    var
      LTab: UITab;
    begin
      LTab.FView := AView;
      LTab.FContent := AContent;
      return LTab;
    end;

    /// `true` while the tab's page is one of its tab view's. C: Rtab_view_find_tab
    /// @returns `true` while the tab's page is one of its tab view's
    const method IsValid(): bool;
    begin
      return (self.FContent <> R_INVALID_ID) and (Rwidget_is_valid(self.FContent) <> 0) and
        (Rtab_view_find_tab(self.FView, self.FContent) >= 0);
    end;

    /// The tab's place among its view's (-1 when it names none). C: Rtab_view_find_tab
    /// @returns the tab's place among its view's (-1 when it names none)
    const method Index(): int32;
    begin
      if self.FContent = R_INVALID_ID then
        return -1;
      end;
      return Rtab_view_find_tab(self.FView, self.FContent);
    end;

    /// The tab view the tab is in.
    /// @returns the tab view the tab is in
    const method View(): UITabView;
    var
      LView: UITabView;
    begin
      LView := UIWidget.Wrap(self.FView).As<UITabView>();
      return LView;
    end;

    /// The page the tab shows.
    /// @returns the page the tab shows
    const method Content(): UIWidget;
    begin
      return UIWidget.Wrap(self.FContent);
    end;

    /// The tab's title. C: Rtab_view_set_tab_title
    /// @param ATitle the title
    /// @returns this object, so calls chain
    const method Title(const ATitle: string): self;
    begin
      Rtab_view_set_tab_title(self.FView, self.FContent, ATitle);
      return self;
    end;

    /// A close button on the tab when `AOn`. C: Rtab_view_set_tab_closable
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method Closable(const AOn: bool): self;
    begin
      Rtab_view_set_tab_closable(self.FView, self.FContent, DoCBool(AOn));
      return self;
    end;

    /// Shows the tab's page. C: Rtab_view_show_tab
    /// @returns this object, so calls chain
    const method Show(): self;
    begin
      Rtab_view_show_tab(self.FView, self.FContent);
      return self;
    end;

    /// The whole of `ATexture` as the icon before the title (an empty handle removes it),
    /// drawn in its own colours; kept while it is set. C: Rtab_view_set_tab_icon
    /// @param ATexture the texture
    /// @returns this object, so calls chain
    const method Icon(const ATexture: UITextureRes): self;
    begin
      self.Icon(ATexture, UIPoint(x: 0.0f, y: 0.0f), UIPoint(x: 1.0f, y: 1.0f), false);
      return self;
    end;

    /// A part of `ATexture` as the icon before the title (an empty handle removes it); kept
    /// while it is set.
    /// `AUVMin` .. `AUVMax`: the part of the texture shown, as texture coordinates (0 .. 1)
    /// of its corners; `ATint` `true`: the texture is a mask drawn in the text colour.
    /// C: Rtab_view_set_tab_icon
    /// @param ATexture the texture
    /// @param AUVMin the lowest texture coordinates (0 .. 1)
    /// @param AUVMax the highest texture coordinates (0 .. 1)
    /// @param ATint the tint colour
    /// @returns this object, so calls chain
    const method Icon(const ATexture: UITextureRes; const AUVMin: UIPoint; const AUVMax: UIPoint;
      const ATint: bool): self;
    begin
      Rtab_view_set_tab_icon(self.FView, self.FContent, ATexture.Id(), AUVMin.x, AUVMin.y,
        AUVMax.x, AUVMax.y, DoCBool(ATint));
      DoHookDestroy(self.FContent);
      DoKeepTexture(self.FContent, ADAM_RAVEN_KEEP_ICON, ATexture);
      return self;
    end;
  end;

  /// A titled header that opens and closes the content below it. C: Rexpander_*
  UIExpander = object(UIWidget)
    /// A new, closed expander titled `ATitle`. C: Rwidget_create(R_WIDGET_EXPANDER),
    /// Rexpander_set_title
    /// @param ATitle the title
    /// @returns a new, closed expander titled `ATitle`
    static method Create(const ATitle: string): UIExpander;
    var
      LWidget: UIExpander;
    begin
      LWidget.DoSet(Rwidget_create(int32(UIWidgetKind.Expander)));
      Rexpander_set_title(LWidget.FId, ATitle);
      return LWidget;
    end;

    /// The kind an expander views.
    /// @returns the kind an expander views
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Expander];
    end;

    /// The header's title. C: Rexpander_set_title
    /// @param ATitle the title
    /// @returns this object, so calls chain
    const method Title(const ATitle: string): self;
    begin
      Rexpander_set_title(self.FId, ATitle);
      return self;
    end;

    /// What `Title(..)` sets, read back. C: Rexpander_get_title
    /// @returns the header's title
    const method Title(): string;
    begin
      return DoRavenText(Rexpander_get_title(self.FId));
    end;

    /// Opens (`true`) or closes the content. C: Rexpander_set_expanded
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    const method Expanded(const AOn: bool): self;
    begin
      Rexpander_set_expanded(self.FId, DoCBool(AOn));
      return self;
    end;

    /// What `Expanded(..)` sets, read back. C: Rexpander_is_expanded
    /// @returns `true` when `Expanded(..)` turned it on
    const method Expanded(): bool;
    begin
      return Rexpander_is_expanded(self.FId) <> 0;
    end;

    /// Runs `AFunc` with the new state when the expander opens or closes.
    /// C: Rexpander_set_changed_callback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    const method OnChanged(const AFunc: UIToggleFunc): self;
    begin
      if AFunc = nil then
        GControlToggles.Clear(self.FId, ADAM_RAVEN_WIDGET_EVENT);
        Rexpander_set_changed_callback(self.FId, nil, nil);
        return self;
      end;
      DoHookDestroy(self.FId);
      Rexpander_set_changed_callback(self.FId, DoOnControlToggle,
        GControlToggles.Put(self.FId, ADAM_RAVEN_WIDGET_EVENT, AFunc));
      return self;
    end;
  end;

  /// A line or block of text, plain or Markdown (links run `OnLink`), optionally selectable.
  /// Its text is the base's `Text`. C: Rlabel_*
  /// @example `UILabel.Create("Ready").TextSize(18.0f).Color(UIColor.FromRGBA(80, 200, 120));`
  UILabel = object(UIWidget)
    /// A new label showing `AText`. C: Rlabel_create
    /// @param AText the text
    /// @returns a new label showing `AText`
    static method Create(const AText: string): UILabel;
