  UIMessageButtons = choices(
    Ok = 912,      /// An OK button. C: R_MESSAGE_OK
    OkCancel,      /// OK and Cancel. C: R_MESSAGE_OK_CANCEL
    YesNo,         /// Yes and No. C: R_MESSAGE_YES_NO
    YesNoCancel);  /// Yes, No and Cancel. C: R_MESSAGE_YES_NO_CANCEL

  /// The button a message box was closed with (`R_MESSAGE_RESULT_*`).
  UIMessageResult = choices(
    Cancel = 0,  /// Dismissed (Escape), or the Cancel button. C: R_MESSAGE_RESULT_CANCEL
    Ok,          /// OK. C: R_MESSAGE_RESULT_OK
    Yes,         /// Yes. C: R_MESSAGE_RESULT_YES
    No);         /// No. C: R_MESSAGE_RESULT_NO

  /// An animation's feel (`R_MOTION_*`).
  UIMotion = choices(
    Snappy = 800,  /// Fast, no bounce: hover, highlights. C: R_MOTION_SNAPPY
    Smooth,        /// Slower, no bounce: scrolling, fades, sizes. C: R_MOTION_SMOOTH
    Bouncy,        /// Runs a little past the target and comes back: switches, popups, pressed buttons. C: R_MOTION_BOUNCY
    Wobbly);       /// Swings several times around the target: things that fly in or get dropped. C: R_MOTION_WOBBLY

  /// A built-in shader effect (`R_EFFECT_*`).
  UIEffect = choices(
    Aurora = 2880,  /// Soft lights that drift slowly: color, color2; params: speed, scale, intensity, -. Animated. C: R_EFFECT_AURORA
    Shimmer,        /// A band of light that sweeps across (loading placeholders): color = base, color2 = light; params: speed, width, angle, -. Animated. C: R_EFFECT_SHIMMER
    Neon,           /// A glowing edge whose colors run around the shape: color, color2; params: speed, width, glow, -. Animated. C: R_EFFECT_NEON
    Ripple,         /// Rings that ripple what is behind, like water (reads the backdrop): color = tint; params: speed, strength, density, center x (0..1). Animated. C: R_EFFECT_RIPPLE
    Plasma,         /// Bands of color that flow into each other: color, color2; params: speed, scale, contrast, -. Animated. C: R_EFFECT_PLASMA
    Grain,          /// A gradient with the fine grain of film: color (top left) to color2 (bottom right); params: grain, angle, -, -. Animated grain. C: R_EFFECT_GRAIN
    Spotlight,      /// A soft light that follows a point: color = light, color2 = background; params: x, y (0..1), radius (0..1), -. C: R_EFFECT_SPOTLIGHT
    Mesh);          /// Four colors blended across the surface, slowly moving: color, color2 and their mix; params: speed, -, -, -. Animated. C: R_EFFECT_MESH

