        return self;
      end;
      DoHookDestroy(self.FId);
      Rtext_input_set_committed_callback(self.FId, DoOnControlText,
        GControlTexts.Put(self.FId, ADAM_RAVEN_CONTROL_COMMIT, AFunc));
      return self;
    end;
  end;

