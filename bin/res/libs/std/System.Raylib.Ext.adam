  const method Transform(const M: Matrix): Vector2;
  begin
    return Vector2Transform(self, M);
  end;

  /// The point `T` of the way to `B` (0 here, 1 at `B`). C: Vector2Lerp
  /// @param B the end
  /// @param T the amount
  /// @returns the point `T` of the way to `B` (0 here, 1 at `B`)
  const method Lerp(const B: Vector2; const T: float32): Vector2;
  begin
    return Vector2Lerp(self, B, T);
  end;

