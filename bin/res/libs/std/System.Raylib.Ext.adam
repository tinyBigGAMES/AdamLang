      const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawLineEx(self.DoAt(), AStart, AEnd, AThick, AColor);
      end;
      return self;
    end;

    /// Lines joining `APoints` in turn. C: ImageDrawLineStrip
    /// @param APoints the points
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method LineStrip(const APoints: array of Vector2; const AColor: Color): self;
    begin
      if (self.FHold <> nil) and (len(APoints) > 0) then
        ImageDrawLineStrip(self.DoAt(), addr of APoints[0], int32(len(APoints)), AColor);
      end;
      return self;
    end;

    /// A filled triangle (corners counter-clockwise). C: ImageDrawTriangle
    /// @param AA the first corner
    /// @param AB the second corner
    /// @param AC the third corner
    /// @param AColor the colour
    /// @returns this object, so calls chain
