      LColors := LoadImageColors(self.Handle());
      if LColors = nil then
        return LResultArray;
      end;
      LCount := int64(self.Width()) * int64(self.Height());
      setlength(LResultArray, LCount);
      for LI := 0 to LCount - 1 do
