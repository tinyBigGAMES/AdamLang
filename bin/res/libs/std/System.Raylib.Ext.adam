    /// @param AThick the line thickness
    /// @param AColor the colour
    static method PolyLines(const ACenter: Vector2; const ASides: int32; const ARadius: float32;
      const ARotation: float32; const AThick: float32; const AColor: Color);
    begin
      DrawPolyLinesEx(ACenter, ASides, ARadius, ARotation, AThick, AColor);
    end;

    /// A filled circle. C: DrawCircle / DrawCircleV
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AColor the colour
    static method Circle(const ACenter: Vector2; const ARadius: float32; const AColor: Color);
    begin
      DrawCircleV(ACenter, ARadius, AColor);
    end;

    /// A circle shaded from `AInner` at its center to `AOuter` at its edge.
    /// C: DrawCircleGradient
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AInner the colour at the centre
    /// @param AOuter the colour at the edge
    static method CircleGradient(const ACenter: Vector2; const ARadius: float32;
      const AInner: Color; const AOuter: Color);
    begin
      DrawCircleGradient(ACenter, ARadius, AInner, AOuter);
    end;

    /// A filled slice of a circle, angles in degrees. C: DrawCircleSector
    /// @param ASegments the slice's segments (0: raylib picks)
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AStartAngle the start angle, in degrees
    /// @param AEndAngle the end angle, in degrees
    /// @param AColor the colour
    static method CircleSector(const ACenter: Vector2; const ARadius: float32;
      const AStartAngle: float32; const AEndAngle: float32; const ASegments: int32;
      const AColor: Color);
    begin
      DrawCircleSector(ACenter, ARadius, AStartAngle, AEndAngle, ASegments, AColor);
    end;

    /// A circle slice's outline. C: DrawCircleSectorLines
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AStartAngle the start angle, in degrees
    /// @param AEndAngle the end angle, in degrees
    /// @param ASegments how many segments
    /// @param AColor the colour
    static method CircleSectorLines(const ACenter: Vector2; const ARadius: float32;
      const AStartAngle: float32; const AEndAngle: float32; const ASegments: int32;
      const AColor: Color);
    begin
      DrawCircleSectorLines(ACenter, ARadius, AStartAngle, AEndAngle, ASegments, AColor);
    end;

    /// A circle slice's outline `AThick` wide. C: DrawCircleSectorLinesEx
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AStartAngle the start angle, in degrees
    /// @param AEndAngle the end angle, in degrees
    /// @param ASegments how many segments
