    /// while this handle is.
    /// @param AIndex the index, from 0
    /// @returns glyph `AIndex` (0 to Count() - 1; an empty one outside): its image is borrowed, alive while this handle is
    const method Glyph(const AIndex: int32): GlyphInfo;
    var
      LNone: GlyphInfo;
    begin
      if (self.FHold = nil) or (AIndex < 0) or (AIndex >= self.FHold.FCount) then
        return LNone;
