  /// Component-wise difference. C: Vector4Subtract
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise difference
  operator -(const A: Vector4; const B: Vector4): Vector4;
  begin
    return Vector4Subtract(A, B);
  end;

  /// `S` taken from each component. C: Vector4SubtractValue
  /// @param A the left operand
  /// @param S the right operand
  /// @returns `S` taken from each component
  operator -(const A: Vector4; const S: float32): Vector4;
  begin
    return Vector4SubtractValue(A, S);
  end;

  /// Component-wise product (not the quaternion product: `Product`). C: Vector4Multiply
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise product (not the quaternion product: `Product`)
  operator *(const A: Vector4; const B: Vector4): Vector4;
  begin
    return Vector4Multiply(A, B);
  end;

  /// The vector scaled by `S`. C: Vector4Scale
  /// @param A the left operand
  /// @param S the right operand
  /// @returns the vector scaled by `S`
  operator *(const A: Vector4; const S: float32): Vector4;
  begin
    return Vector4Scale(A, S);
  end;

  /// Component-wise quotient. C: Vector4Divide
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise quotient
  operator /(const A: Vector4; const B: Vector4): Vector4;
  begin
    return Vector4Divide(A, B);
  end;

  /// The vector divided by `S`. C: Vector4Scale by 1 / S
  /// @param A the left operand
  /// @param S the right operand
  /// @returns the vector divided by `S`
  operator /(const A: Vector4; const S: float32): Vector4;
  begin
    return Vector4Scale(A, 1.0f / S);
  end;

  /// True when equal within raymath's epsilon. C: Vector4Equals
  /// @param A the left operand
  /// @param B the right operand
  /// @returns `true` when equal within raymath's epsilon
  operator =(const A: Vector4; const B: Vector4): bool;
  begin
    return Vector4Equals(A, B) <> 0;
  end;

  /// True when they differ beyond raymath's epsilon. C: Vector4Equals
  /// @param A the left operand
  /// @param B the right operand
  /// @returns `true` when they differ beyond raymath's epsilon
  operator <>(const A: Vector4; const B: Vector4): bool;
  begin
    return Vector4Equals(A, B) = 0;
  end;

  /// The vector negated. C: Vector4Negate
  /// @returns the vector negated
  const method Negate(): Vector4;
  begin
    return Vector4Negate(self);
  end;

  /// Each component's reciprocal. C: Vector4Invert
  /// @returns each component's reciprocal
  const method Invert(): Vector4;
  begin
    return Vector4Invert(self);
  end;

  /// The vector's length. C: Vector4Length
  /// @returns the vector's length
  const method Length(): float32;
  begin
    return Vector4Length(self);
  end;

  /// The squared length. C: Vector4LengthSqr
  /// @returns the squared length
  const method LengthSqr(): float32;
  begin
    return Vector4LengthSqr(self);
  end;

  /// The vector (or quaternion) at length 1. C: Vector4Normalize
  /// @returns the vector (or quaternion) at length 1
  const method Normalize(): Vector4;
  begin
    return Vector4Normalize(self);
  end;

  /// The dot product with `B`. C: Vector4DotProduct
  /// @param B the other `Vector4`
  /// @returns the dot product with `B`
  const method Dot(const B: Vector4): float32;
  begin
    return Vector4DotProduct(self, B);
  end;

  /// The distance to `B`. C: Vector4Distance
  /// @param B the other `Vector4`
  /// @returns the distance to `B`
  const method Distance(const B: Vector4): float32;
  begin
    return Vector4Distance(self, B);
  end;

  /// The squared distance to `B`. C: Vector4DistanceSqr
  /// @param B the other `Vector4`
  /// @returns the squared distance to `B`
  const method DistanceSqr(const B: Vector4): float32;
  begin
    return Vector4DistanceSqr(self, B);
  end;

  /// Component-wise minimum with `B`. C: Vector4Min
  /// @param B the other `Vector4`
  /// @returns the component-wise minimum with `B`
  const method Min(const B: Vector4): Vector4;
  begin
    return Vector4Min(self, B);
  end;

  /// Component-wise maximum with `B`. C: Vector4Max
  /// @param B the other `Vector4`
  /// @returns the component-wise maximum with `B`
  const method Max(const B: Vector4): Vector4;
  begin
    return Vector4Max(self, B);
  end;

  /// The point `T` of the way to `B` (component-wise; a quaternion's is `Nlerp` / `Slerp`).
  /// C: Vector4Lerp
  /// @param B the other `Vector4`
  /// @param T how far along, 0 to 1
  /// @returns the point `T` of the way to `B` (component-wise; a quaternion's is `Nlerp` / `Slerp`)
  const method Lerp(const B: Vector4; const T: float32): Vector4;
  begin
    return Vector4Lerp(self, B, T);
  end;

  /// The point moved toward `ATarget` by at most `AMaxDistance`. C: Vector4MoveTowards
  /// @param ATarget the target
  /// @param AMaxDistance the max distance
  /// @returns the point moved toward `ATarget` by at most `AMaxDistance`
  const method MoveTowards(const ATarget: Vector4; const AMaxDistance: float32): Vector4;
  begin
    return Vector4MoveTowards(self, ATarget, AMaxDistance);
  end;

  /// The quaternion product (Hamilton) self x `B`. C: QuaternionMultiply
  /// @param B the quaternion it is multiplied by
  /// @returns the quaternion product (Hamilton) self x `B`
  const method Product(const B: Quaternion): Quaternion;
  begin
    return QuaternionMultiply(self, B);
  end;

  /// The quaternion's inverse (conjugate over the squared length). C: QuaternionInvert
  /// @returns the quaternion's inverse (conjugate over the squared length)
  const method QInvert(): Quaternion;
  begin
    return QuaternionInvert(self);
  end;

  /// The normalized linear interpolation `T` of the way to `B`. C: QuaternionNlerp
  /// @param B the quaternion it turns towards
  /// @param T how far along, 0 to 1
  /// @returns the normalized linear interpolation `T` of the way to `B`
  const method Nlerp(const B: Quaternion; const T: float32): Quaternion;
  begin
    return QuaternionNlerp(self, B, T);
  end;

  /// The spherical linear interpolation `T` of the way to `B`. C: QuaternionSlerp
  /// @param B the quaternion it turns towards
  /// @param T how far along, 0 to 1
  /// @returns the spherical linear interpolation `T` of the way to `B`
  const method Slerp(const B: Quaternion; const T: float32): Quaternion;
  begin
    return QuaternionSlerp(self, B, T);
  end;

  /// The cubic Hermite spline point at `T`. C: QuaternionCubicHermiteSpline
  /// @param AQ1 the first rotation
  /// @param AOutTangent1 the out tangent1
  /// @param AQ2 the second rotation
  /// @param AInTangent2 the in tangent2
  /// @param T how far along, 0 to 1
  /// @returns the cubic Hermite spline point at `T`
  static method CubicHermite(const AQ1: Quaternion; const AOutTangent1: Quaternion;
    const AQ2: Quaternion; const AInTangent2: Quaternion; const T: float32): Quaternion;
  begin
    return QuaternionCubicHermiteSpline(AQ1, AOutTangent1, AQ2, AInTangent2, T);
  end;

  /// The rotation that turns `AFrom` onto `ATo`. C: QuaternionFromVector3ToVector3
  /// @param AFrom the direction turned from
  /// @param ATo the direction turned onto
  /// @returns the rotation that turns `AFrom` onto `ATo`
  static method FromTo(const AFrom: Vector3; const ATo: Vector3): Quaternion;
  begin
    return QuaternionFromVector3ToVector3(AFrom, ATo);
  end;

  /// The rotation of a matrix. C: QuaternionFromMatrix
  /// @param M the matrix
  /// @returns the rotation of a matrix
  static method FromMatrix(const M: Matrix): Quaternion;
  begin
    return QuaternionFromMatrix(M);
  end;

  /// The quaternion's rotation matrix. C: QuaternionToMatrix
  /// @returns the quaternion's rotation matrix
  const method ToMatrix(): Matrix;
  begin
    return QuaternionToMatrix(self);
  end;

  /// The rotation of `AAngle` radians about `AAxis`. C: QuaternionFromAxisAngle
  /// @param AAxis the axis
  /// @param AAngle the angle
  /// @returns the rotation of `AAngle` radians about `AAxis`
  static method FromAxisAngle(const AAxis: Vector3; const AAngle: float32): Quaternion;
  begin
    return QuaternionFromAxisAngle(AAxis, AAngle);
  end;

  /// The quaternion's rotation as an axis and an angle in radians. C: QuaternionToAxisAngle
  /// @param AAxis set to the axis
  /// @param AAngle set to the angle
  const method ToAxisAngle(var AAxis: Vector3; var AAngle: float32);
  begin
    QuaternionToAxisAngle(self, addr of AAxis, addr of AAngle);
  end;

  /// The rotation of the Euler angles in radians. C: QuaternionFromEuler
  /// @param APitch the pitch angle, in radians
  /// @param AYaw the yaw
  /// @param ARoll the roll
  /// @returns the rotation of the Euler angles in radians
  static method FromEuler(const APitch: float32; const AYaw: float32; const ARoll: float32): Quaternion;
  begin
    return QuaternionFromEuler(APitch, AYaw, ARoll);
  end;

  /// The quaternion's Euler angles in radians (pitch, yaw, roll). C: QuaternionToEuler
  /// @returns the quaternion's Euler angles in radians (pitch, yaw, roll)
  const method ToEuler(): Vector3;
  begin
    return QuaternionToEuler(self);
  end;

  /// The quaternion transformed by `M`. C: QuaternionTransform
  /// @param M the matrix
  /// @returns the quaternion transformed by `M`
  const method Transform(const M: Matrix): Quaternion;
  begin
    return QuaternionTransform(self, M);
  end;
end;

// Matrix math (raymath's Matrix*), column-major as OpenGL's.
// @example `LWorld := Matrix.Scale(2.0f, 2.0f, 2.0f) * Matrix.RotateY(LAngle);`
public extend Matrix
  /// The identity matrix. C: MatrixIdentity
  /// @returns the identity matrix
  static method Identity(): Matrix;
  begin
    return MatrixIdentity();
  end;

  /// A translation. C: MatrixTranslate
  /// @param AX the x coordinate
  /// @param AY the y coordinate
  /// @param AZ the z coordinate
  /// @returns a translation
  static method Translate(const AX: float32; const AY: float32; const AZ: float32): Matrix;
  begin
    return MatrixTranslate(AX, AY, AZ);
  end;

  /// A rotation of `AAngle` radians about `AAxis`. C: MatrixRotate
  /// @param AAxis the axis
  /// @param AAngle the angle
  /// @returns a rotation of `AAngle` radians about `AAxis`
  static method Rotate(const AAxis: Vector3; const AAngle: float32): Matrix;
  begin
    return MatrixRotate(AAxis, AAngle);
  end;

  /// A rotation about x, radians. C: MatrixRotateX
  /// @param AAngle the angle
  /// @returns a rotation about x, radians
  static method RotateX(const AAngle: float32): Matrix;
  begin
    return MatrixRotateX(AAngle);
  end;

  /// A rotation about y, radians. C: MatrixRotateY
  /// @param AAngle the angle
  /// @returns a rotation about y, radians
  static method RotateY(const AAngle: float32): Matrix;
  begin
    return MatrixRotateY(AAngle);
  end;

  /// A rotation about z, radians. C: MatrixRotateZ
  /// @param AAngle the angle
  /// @returns a rotation about z, radians
  static method RotateZ(const AAngle: float32): Matrix;
  begin
    return MatrixRotateZ(AAngle);
  end;

  /// The rotations about x, y then z, radians. C: MatrixRotateXYZ
  /// @param AAngles the angles
  /// @returns the rotations about x, y then z, radians
  static method RotateXYZ(const AAngles: Vector3): Matrix;
  begin
    return MatrixRotateXYZ(AAngles);
  end;

  /// The rotations about z, y then x, radians. C: MatrixRotateZYX
  /// @param AAngles the angles
  /// @returns the rotations about z, y then x, radians
  static method RotateZYX(const AAngles: Vector3): Matrix;
  begin
    return MatrixRotateZYX(AAngles);
  end;

  /// A scaling. C: MatrixScale
  /// @param AX the x coordinate
  /// @param AY the y coordinate
  /// @param AZ the z coordinate
  /// @returns a scaling
  static method Scale(const AX: float32; const AY: float32; const AZ: float32): Matrix;
  begin
    return MatrixScale(AX, AY, AZ);
  end;

  /// A perspective frustum. C: MatrixFrustum
  /// @param ALeft the left of the view volume
  /// @param ARight the right of the view volume
  /// @param ABottom the bottom of the view volume
  /// @param ATop the top of the view volume
  /// @param ANear the near clip distance
  /// @param AFar the far clip distance
  /// @returns a perspective frustum
  static method Frustum(const ALeft: float64; const ARight: float64; const ABottom: float64;
    const ATop: float64; const ANear: float64; const AFar: float64): Matrix;
  begin
    return MatrixFrustum(ALeft, ARight, ABottom, ATop, ANear, AFar);
  end;

  /// A perspective projection, `AFovY` in radians. C: MatrixPerspective
  /// @param AFovY the fov Y
  /// @param AAspect the aspect
  /// @param ANear the near clip distance
  /// @param AFar the far clip distance
  /// @returns a perspective projection, `AFovY` in radians
  static method Perspective(const AFovY: float64; const AAspect: float64; const ANear: float64;
    const AFar: float64): Matrix;
  begin
    return MatrixPerspective(AFovY, AAspect, ANear, AFar);
  end;

  /// An orthographic projection. C: MatrixOrtho
  /// @param ALeft the left of the view volume
  /// @param ARight the right of the view volume
  /// @param ABottom the bottom of the view volume
  /// @param ATop the top of the view volume
  /// @param ANear the near clip distance
  /// @param AFar the far clip distance
  /// @returns an orthographic projection
  static method Ortho(const ALeft: float64; const ARight: float64; const ABottom: float64;
    const ATop: float64; const ANear: float64; const AFar: float64): Matrix;
  begin
    return MatrixOrtho(ALeft, ARight, ABottom, ATop, ANear, AFar);
  end;

  /// A view matrix from `AEye` looking at `ATarget`. C: MatrixLookAt
  /// @param AEye the eye position
  /// @param ATarget the target
  /// @param AUp the up direction
  /// @returns a view matrix from `AEye` looking at `ATarget`
  static method LookAt(const AEye: Vector3; const ATarget: Vector3; const AUp: Vector3): Matrix;
  begin
    return MatrixLookAt(AEye, ATarget, AUp);
  end;

  /// The transform of a translation, a rotation and a scale. C: MatrixCompose
  /// @param AT the translation
  /// @param AR the rotation
  /// @param AS the scale
  /// @returns the transform of a translation, a rotation and a scale
  static method Compose(const AT: Vector3; const AR: Quaternion; const AS: Vector3): Matrix;
  begin
    return MatrixCompose(AT, AR, AS);
  end;

  /// Element-wise sum. C: MatrixAdd
  /// @param A the left operand
  /// @param B the right operand
  /// @returns element-wise sum
  operator +(const A: Matrix; const B: Matrix): Matrix;
  begin
    return MatrixAdd(A, B);
  end;

  /// Element-wise difference. C: MatrixSubtract
  /// @param A the left operand
  /// @param B the right operand
  /// @returns element-wise difference
  operator -(const A: Matrix; const B: Matrix): Matrix;
  begin
    return MatrixSubtract(A, B);
  end;

  /// The matrix product: `A` applied first, then `B` (raymath's order). C: MatrixMultiply
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the matrix product: `A` applied first, then `B` (raymath's order)
  operator *(const A: Matrix; const B: Matrix): Matrix;
  begin
    return MatrixMultiply(A, B);
  end;

  /// Each element scaled by `S`. C: MatrixMultiplyValue
  /// @param A the left operand
  /// @param S the right operand
  /// @returns each element scaled by `S`
  operator *(const A: Matrix; const S: float32): Matrix;
  begin
    return MatrixMultiplyValue(A, S);
  end;

  /// The determinant. C: MatrixDeterminant
  /// @returns the determinant
  const method Determinant(): float32;
  begin
    return MatrixDeterminant(self);
  end;

  /// The trace (the diagonal's sum). C: MatrixTrace
  /// @returns the trace (the diagonal's sum)
  const method Trace(): float32;
  begin
    return MatrixTrace(self);
  end;

  /// The transpose. C: MatrixTranspose
  /// @returns the transpose
  const method Transpose(): Matrix;
  begin
    return MatrixTranspose(self);
  end;

  /// The inverse. C: MatrixInvert
  /// @returns the inverse
  const method Invert(): Matrix;
  begin
    return MatrixInvert(self);
  end;

  /// The matrix as a translation, a rotation and a scale. C: MatrixDecompose
  /// @param AT receives the translation
  /// @param AR receives the rotation
  /// @param AS receives the scale
  const method Decompose(var AT: Vector3; var AR: Quaternion; var AS: Vector3);
  begin
    MatrixDecompose(self, addr of AT, addr of AR, addr of AS);
  end;

  /// The 16 elements, column-major (m0, m1, m2 ..). C: MatrixToFloatV
  /// @returns the 16 elements, column-major (m0, m1, m2 ..)
  const method ToArray(): array[0..15] of float32;
  begin
    return MatrixToFloat(self);
  end;
end;

// Color jobs (raylib's Color*, Fade, GetColor ...). The named colours stay the .C unit's
// constants (WHITE, RAYWHITE, RED ...), already Color values.
// @example `DrawText("hi", 10, 10, 20, RED.Fade(0.5f));`
public extend Color
  /// The colour web pages and Raven themes write: `#RGB`, `#RGBA`, `#RRGGBB` or `#RRGGBBAA`
  /// (the `#` optional, digits in either case; no alpha is opaque).
  /// @param AHex the colour's text
  /// @param ADefault returned when `AHex` is none of those forms
  /// @returns the colour, or `ADefault`
  static method Hex(const AHex: string; const ADefault: Color): Color;
  begin
    return ColorFromHex(AHex, ADefault);
  end;

  /// The colour of a 0xRRGGBBAA value. C: GetColor
  /// @param AHex the hex
  /// @returns the colour of a 0xRRGGBBAA value
  static method FromInt(const AHex: uint32): Color;
  begin
    return GetColor(AHex);
  end;

  /// The colour as 0xRRGGBBAA. C: ColorToInt
  /// @returns the colour as 0xRRGGBBAA
  const method ToInt(): int32;
  begin
    return ColorToInt(self);
  end;

  /// The colour of a hue (0..360), saturation and value (0..1). C: ColorFromHSV
  /// @param AH the hue, in degrees (0 to 360)
  /// @param AS the saturation, 0 to 1
  /// @param AV the value (brightness), 0 to 1
  /// @returns the colour of a hue (0..360), saturation and value (0..1)
  static method FromHSV(const AH: float32; const AS: float32; const AV: float32): Color;
  begin
    return ColorFromHSV(AH, AS, AV);
  end;

  /// The colour as (hue, saturation, value). C: ColorToHSV
  /// @returns the colour as (hue, saturation, value)
  const method ToHSV(): Vector3;
  begin
    return ColorToHSV(self);
  end;

  /// The colour of components 0..1. C: ColorFromNormalized
  /// @param AN the colour as (r, g, b, a), each 0 to 1
  /// @returns the colour of components 0..1
  static method FromNormalized(const AN: Vector4): Color;
  begin
    return ColorFromNormalized(AN);
  end;

  /// The colour's components 0..1. C: ColorNormalize
  /// @returns the colour's components 0..1
  const method Normalized(): Vector4;
  begin
    return ColorNormalize(self);
  end;

  /// True when every component is equal. C: ColorIsEqual
  /// @param A the left operand
  /// @param B the right operand
  /// @returns `true` when every component is equal
  operator =(const A: Color; const B: Color): bool;
  begin
    return ColorIsEqual(A, B);
  end;

  /// True when any component differs. C: ColorIsEqual
  /// @param A the left operand
  /// @param B the right operand
  /// @returns `true` when any component differs
  operator <>(const A: Color; const B: Color): bool;
  begin
    return not ColorIsEqual(A, B);
  end;

  /// The colour with its alpha times `AAlpha` (0..1). C: Fade
  /// @param AAlpha the alpha
  /// @returns the colour with its alpha times `AAlpha` (0..1)
  const method Fade(const AAlpha: float32): Color;
  begin
    return Fade(self, AAlpha);
  end;

  /// The colour with its alpha set to `AAlpha` (0..1). C: ColorAlpha
  /// @param AAlpha the alpha
  /// @returns the colour with its alpha set to `AAlpha` (0..1)
  const method Alpha(const AAlpha: float32): Color;
  begin
    return ColorAlpha(self, AAlpha);
  end;

  /// The colour multiplied by `ATint`. C: ColorTint
  /// @param ATint the tint colour
  /// @returns the colour multiplied by `ATint`
  const method Tint(const ATint: Color): Color;
  begin
    return ColorTint(self, ATint);
  end;

  /// The colour brightened (> 0) or darkened (< 0) by `AFactor` (-1..1). C: ColorBrightness
  /// @param AFactor the factor
  /// @returns the colour brightened (> 0) or darkened (< 0) by `AFactor` (-1..1)
  const method Brightness(const AFactor: float32): Color;
  begin
    return ColorBrightness(self, AFactor);
  end;

  /// The colour's contrast changed by `AContrast` (-1..1). C: ColorContrast
  /// @param AContrast the contrast
  /// @returns the colour's contrast changed by `AContrast` (-1..1)
  const method Contrast(const AContrast: float32): Color;
  begin
    return ColorContrast(self, AContrast);
  end;

  /// The colour `T` of the way to `B`. C: ColorLerp
  /// @param B the other `Color`
  /// @param T how far along, 0 to 1
  /// @returns the colour `T` of the way to `B`
  const method Lerp(const B: Color; const T: float32): Color;
  begin
    return ColorLerp(self, B, T);
  end;

  /// `ASrc` tinted by `ATint` blended over this colour. C: ColorAlphaBlend
  /// @param ASrc the src
  /// @param ATint the tint colour
  /// @returns `ASrc` tinted by `ATint` blended over this colour
  const method AlphaBlend(const ASrc: Color; const ATint: Color): Color;
  begin
    return ColorAlphaBlend(self, ASrc, ATint);
  end;

  /// The colour of one pixel in format `AFormat` at `AP`. C: GetPixelColor
  /// @param AP where the pixel is read
  /// @param AFormat the pixel format
  /// @returns the colour of one pixel in format `AFormat` at `AP`
  static method FromPixel(const AP: ptr to const; const AFormat: Pixel): Color;
  begin
    return GetPixelColor(AP, int32(AFormat));
  end;

  /// Writes the colour as one pixel in format `AFormat` at `AP`. C: SetPixelColor
  /// @param AP where the pixel is written
  /// @param AFormat the pixel format
  const method ToPixel(const AP: ptr; const AFormat: Pixel);
  begin
    SetPixelColor(AP, self, int32(AFormat));
  end;

  /// The bytes of a `AWidth` x `AHeight` image in format `AFormat`. C: GetPixelDataSize
  /// @param AWidth the width
  /// @param AHeight the height
  /// @param AFormat the pixel format
  /// @returns the bytes of a `AWidth` x `AHeight` image in format `AFormat`
  static method PixelDataSize(const AWidth: int32; const AHeight: int32; const AFormat: Pixel): int32;
  begin
    return GetPixelDataSize(AWidth, AHeight, int32(AFormat));
  end;
end;

// Rectangle jobs: its collisions and parts.
// @example `if LPlayer.Overlaps(LWall) then Stop(); end;`
public extend Rectangle
  /// True when the rectangles overlap. C: CheckCollisionRecs
  /// @param B the other `Rectangle`
  /// @returns `true` when the rectangles overlap
  const method Overlaps(const B: Rectangle): bool;
  begin
    return CheckCollisionRecs(self, B);
  end;

  /// The rectangle where both overlap (empty when they do not). C: GetCollisionRec
  /// @param B the other `Rectangle`
  /// @returns the rectangle where both overlap (empty when they do not)
  const method Overlap(const B: Rectangle): Rectangle;
  begin
    return GetCollisionRec(self, B);
  end;

  /// True when the circle overlaps the rectangle. C: CheckCollisionCircleRec
  /// @param ACenter the centre
  /// @param ARadius the radius
  /// @returns `true` when the circle overlaps the rectangle
  const method OverlapsCircle(const ACenter: Vector2; const ARadius: float32): bool;
  begin
    return CheckCollisionCircleRec(ACenter, ARadius, self);
  end;

  /// True when `AP` is inside. C: CheckCollisionPointRec
  /// @param AP the point
  /// @returns `true` when `AP` is inside
  const method Contains(const AP: Vector2): bool;
  begin
    return CheckCollisionPointRec(AP, self);
  end;

  /// The top-left corner.
  /// @returns the top-left corner
  const method Position(): Vector2;
  begin
    return Vector2(x: self.x, y: self.y);
  end;

  /// The width and height.
  /// @returns the width and height
  const method Size(): Vector2;
  begin
    return Vector2(x: self.width, y: self.height);
  end;

  /// The centre point.
  /// @returns the centre point
  const method Center(): Vector2;
  begin
    return Vector2(x: self.x + self.width * 0.5f, y: self.y + self.height * 0.5f);
  end;

  /// The rectangle moved by `AD`.
  /// @param AD the offset
  /// @returns the rectangle moved by `AD`
  const method Moved(const AD: Vector2): Rectangle;
  begin
    return Rectangle(x: self.x + AD.x, y: self.y + AD.y, width: self.width, height: self.height);
  end;

  /// The rectangle grown by `AD` on every side (shrunk when `AD` < 0).
  /// @param AD how much on each side
  /// @returns the rectangle grown by `AD` on every side (shrunk when `AD` < 0)
  const method Grown(const AD: float32): Rectangle;
  begin
    return Rectangle(x: self.x - AD, y: self.y - AD, width: self.width + AD * 2.0f,
      height: self.height + AD * 2.0f);
  end;
end;

// Ray hit tests (raylib's GetRayCollision*).
public extend Ray
  /// Where the ray hits the sphere. C: GetRayCollisionSphere
  /// @param ACenter the centre
  /// @param ARadius the radius
  /// @returns where the ray hits the sphere
  const method HitSphere(const ACenter: Vector3; const ARadius: float32): RayCollision;
  begin
    return GetRayCollisionSphere(self, ACenter, ARadius);
  end;

  /// Where the ray hits the box. C: GetRayCollisionBox
  /// @param ABox the box
  /// @returns where the ray hits the box
  const method HitBox(const ABox: BoundingBox): RayCollision;
  begin
    return GetRayCollisionBox(self, ABox);
  end;

  /// Where the ray hits the triangle. C: GetRayCollisionTriangle
  /// @param AP1 the first point
  /// @param AP2 the second point
  /// @param AP3 the third point
  /// @returns where the ray hits the triangle
  const method HitTriangle(const AP1: Vector3; const AP2: Vector3; const AP3: Vector3): RayCollision;
  begin
    return GetRayCollisionTriangle(self, AP1, AP2, AP3);
  end;

  /// Where the ray hits the quad. C: GetRayCollisionQuad
  /// @param AP1 the first point
  /// @param AP2 the second point
  /// @param AP3 the third point
  /// @param AP4 the fourth point
  /// @returns where the ray hits the quad
  const method HitQuad(const AP1: Vector3; const AP2: Vector3; const AP3: Vector3;
    const AP4: Vector3): RayCollision;
  begin
    return GetRayCollisionQuad(self, AP1, AP2, AP3, AP4);
  end;
end;

// BoundingBox collisions.
public extend BoundingBox
  /// True when the boxes overlap. C: CheckCollisionBoxes
  /// @param B the other `BoundingBox`
  /// @returns `true` when the boxes overlap
  const method Overlaps(const B: BoundingBox): bool;
  begin
    return CheckCollisionBoxes(self, B);
  end;

  /// True when the sphere overlaps the box. C: CheckCollisionBoxSphere
  /// @param ACenter the centre
  /// @param ARadius the radius
  /// @returns `true` when the sphere overlaps the box
  const method OverlapsSphere(const ACenter: Vector3; const ARadius: float32): bool;
  begin
    return CheckCollisionBoxSphere(self, ACenter, ARadius);
  end;

  /// True when the two spheres overlap. C: CheckCollisionSpheres
  /// @param AC1 the first sphere's centre
  /// @param AR1 the first sphere's radius
  /// @param AC2 the second sphere's centre
  /// @param AR2 the second sphere's radius
  /// @returns `true` when the two spheres overlap
  static method SpheresOverlap(const AC1: Vector3; const AR1: float32; const AC2: Vector3;
    const AR2: float32): bool;
  begin
    return CheckCollisionSpheres(AC1, AR1, AC2, AR2);
  end;
end;

// Camera2D jobs; `Begin` / `End` draw through it inside the frame (letterboxed).
public extend Camera2D
  /// A camera looking at `ATarget`, shown at `AOffset` of the screen.
  /// @param ATarget the target
  /// @param AOffset the offset
  /// @param ARotation the rotation
  /// @param AZoom the zoom
  /// @returns a camera looking at `ATarget`, shown at `AOffset` of the screen
  static method Make(const ATarget: Vector2; const AOffset: Vector2; const ARotation: float32;
    const AZoom: float32): Camera2D;
  begin
    return Camera2D(offset: AOffset, target: ATarget, rotation: ARotation, zoom: AZoom);
  end;

  /// The camera's view matrix. C: GetCameraMatrix2D
  /// @returns the camera's view matrix
  const method Matrix(): Matrix;
  begin
    return GetCameraMatrix2D(self);
  end;

  /// Starts drawing through this camera inside the frame. C: BeginMode2D, letterboxed
  const method Begin();
  begin
    BeginFrameMode2D(self);
  end;

  /// Ends the camera's drawing. C: EndMode2D
  static method End();
  begin
    EndFrameMode2D();
  end;
end;

// Camera3D (raylib's Camera) jobs; `Begin` / `End` draw through it inside the frame.
public extend Camera3D
  /// A camera at `APosition` looking at `ATarget`, `AFovY` in degrees.
  /// @param APosition the position
  /// @param ATarget the target
  /// @param AUp the up direction
  /// @param AFovY the fov Y
  /// @param AProjection the projection
  /// @returns a camera at `APosition` looking at `ATarget`, `AFovY` in degrees
  static method Make(const APosition: Vector3; const ATarget: Vector3; const AUp: Vector3;
    const AFovY: float32; const AProjection: Projection): Camera3D;
  begin
    return Camera3D(position: APosition, target: ATarget, up: AUp, fovy: AFovY,
      projection: int32(AProjection));
  end;

  /// The camera's view matrix. C: GetCameraMatrix
  /// @returns the camera's view matrix
  const method Matrix(): Matrix;
  begin
    return GetCameraMatrix(self);
  end;

  /// Moves the camera by raylib's built-in controls for `AStyle`. C: UpdateCamera
  /// @param AStyle the style
  method Update(const AStyle: CameraStyle);
  begin
    UpdateCamera(addr of self, int32(AStyle));
  end;

  /// Moves and turns the camera (rotation in degrees: yaw, pitch, roll) and zooms it.
  /// C: UpdateCameraPro
  /// @param AMovement the movement
  /// @param ARotation the rotation
  /// @param AZoom the zoom
  method Update(const AMovement: Vector3; const ARotation: Vector3; const AZoom: float32);
  begin
    UpdateCameraPro(addr of self, AMovement, ARotation, AZoom);
  end;

  /// Starts drawing through this camera inside the frame. C: BeginMode3D, letterboxed
  const method Begin();
  begin
    BeginFrameMode3D(self);
  end;

  /// Ends the camera's drawing. C: EndMode3D
  static method End();
  begin
    EndFrameMode3D();
  end;
end;

// Drawing goes into ATarget (RenderTextureRes.Begin, Draw.BeginTexture): inside a frame the
// frame's camera and clip end first (the texture is drawn in its own pixels)
func DoBeginTexture(const ATarget: RenderTexture2D);
begin
  DoFrameLive();
  if GFrame.Open and GFrame.Drawing and not GFrame.InTexture then
    EndMode2D();
    EndScissorMode();
  end;
  GFrame.InTexture := true;
  BeginTextureMode(ATarget);
end;

// Ends DoBeginTexture: drawing goes to the window again, inside a frame through the frame's
// camera and clip as BeginFrame set them
func DoEndTexture();
begin
  EndTextureMode();
  DoFrameLive();
  GFrame.InTexture := false;
  if GFrame.Open and GFrame.Drawing then
    BeginMode2D(GFrame.Camera);
    DoFrameClip();
  end;
end;

// An automation event's kind (its `type_` as an AutomationKind).
// @example `if LRun.Event(LI).Kind() = AutomationKind.KeyDown then LKeys := LKeys + 1; end;`
public extend AutomationEvent
  /// The event's kind (AutomationKind.None for a value raylib does not make).
  /// @returns the event's kind (AutomationKind.None for a value raylib does not make)
  const method Kind(): AutomationKind;
  begin
    if self.type_ > uint32(AutomationKind.SetTargetFPS) then
      return AutomationKind.None;
    end;
    return AutomationKind(int32(self.type_));
  end;
end;

// ============================================================================
// Resources (sec 6): every <Name>Res is a shared handle over a hidden holder
// (a ref to it: a copy shares, the last copy unloads; `Copy()` makes a new
// one). The GPU holders (textures, render textures, fonts, shaders, meshes,
// materials) are listed while they live: the Window's last release unloads
// every one still alive before CloseWindow, and one released after its
// window went (a program's own CloseWindow) frees only its CPU part. A
// default value (no init) holds nothing: its reads give raylib's empty
// record, its changes do nothing.
// `Adopt` takes a .C record over (unloaded with the last copy), `View` borrows
// a texture another owns (never unloaded). Assets mounts the source every
// path loads from (SetRaylibIOSource): the examples' assets.zip.
// ============================================================================

type
  // A resource's holder: its C record unloaded once (Release), at the last copy's release or
  // at the window's close
  ResHold = object
    // The window its GPU part lives on, as DoWindowId names it (0: a CPU resource)
    WindowId: uint64;
    // It owns its record (false for a view, or one raylib could not make)
    Live: bool;
    // Unloaded: its record is gone (the handle's reads give the empty one)
    Released: bool;

    // The record's unload; AWhole false when its window went (the GPU part with it)
    virtual method Unload(const AWhole: bool);
    begin
    end;

    // Unloads once: nothing for a view or a holder unloaded already. A GPU part whose window
    // is gone is not unloaded (it went with the window).
    method Release();
    begin
      if not self.Live or self.Released then
        return;
      end;
      self.Released := true;
      self.Unload((self.WindowId = 0) or (DoWindowId() = self.WindowId));
    end;

    // Its window is being destroyed: the GPU part goes with it, the CPU part is freed
    method Abandon();
    begin
      if not self.Live or self.Released then
        return;
      end;
      self.Released := true;
      self.Unload(false);
    end;
  end;

  ImageHold = object(ResHold)
    FImage: Image;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      UnloadImage(self.FImage);
    end;
  end;

  GlyphsHold = object(ResHold)
    FGlyphs: ptr to GlyphInfo;
    FCount: int32;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      UnloadFontData(self.FGlyphs, self.FCount);
    end;
  end;

  TextureHold = object(ResHold)
    FTexture: Texture2D;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      if AWhole then
        UnloadTexture(self.FTexture);
      end;
    end;
  end;

  RenderTextureHold = object(ResHold)
    FTarget: RenderTexture2D;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      if AWhole then
        UnloadRenderTexture(self.FTarget);
      end;
    end;
  end;

  FontHold = object(ResHold)
    FFont: Font;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      if AWhole then
        UnloadFont(self.FFont);
        return;
      end;
      // The atlas went with the window: UnloadFont's CPU part only (its glyph images and the
      // rectangles raylib allocated)
      UnloadFontData(self.FFont.glyphs, self.FFont.glyphCount);
      MemFree(self.FFont.recs);
    end;
  end;

  // A shader's holder: listed only when it owns a program (raylib's default shader, which
  // raylib keeps, never unloaded; a program that failed still owns its location table)
  ShaderHold = object(ResHold)
    FShader: Shader;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      if AWhole then
        UnloadShader(self.FShader);
        return;
      end;
      // The program went with the window: the location table only
      MemFree(self.FShader.locs);
    end;
  end;

  // A mesh's holder: its vertex data (CPU) and buffers (GPU); a model's meshes are holders
  // of their own, so a mesh lives as long as any model or MeshRes still uses it
  MeshHold = object(ResHold)
    FMesh: Mesh;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      if AWhole then
        UnloadMesh(self.FMesh);
        return;
      end;
      // The buffers went with the window: UnloadMesh's CPU part only
      MemFree(self.FMesh.vboId);
      MemFree(self.FMesh.vertices);
      MemFree(self.FMesh.texcoords);
      MemFree(self.FMesh.normals);
      MemFree(self.FMesh.colors);
      MemFree(self.FMesh.tangents);
      MemFree(self.FMesh.texcoords2);
      MemFree(self.FMesh.indices);
      MemFree(self.FMesh.boneWeights);
      MemFree(self.FMesh.boneIndices);
      MemFree(self.FMesh.animVertices);
      MemFree(self.FMesh.animNormals);
    end;
  end;

  // A set of animations LoadModelAnimations gave (one array, unloaded whole)
  AnimationsHold = object
    FAnims: ptr to ModelAnimation;
    FCount: int32;

    done;
    begin
      if self.FAnims <> nil then
        UnloadModelAnimations(self.FAnims, self.FCount);
      end;
    end;
  end;

  // Assets.Mount's source: closed at Unmount, or at the program's end
  AssetsHold = object
    Source: IOSource;
    // Mount opened it (an archive): closed with the holder
    Owned: bool;

    done;
    begin
      SetRaylibIOSource(nil);
      if self.Owned then
        IOSourceClose(self.Source);
      end;
    end;
  end;

var
  // The GPU holders alive (watched, not held), unloaded by DoReleaseGPU; entries whose holder
  // is gone are dropped once the list reaches GGPUHoldsRoom
  GGPUHolds: List<weak ResHold>;
  GGPUHoldsRoom: int64;
  // The audio holders alive (sounds, music, streams, videos), watched the same way and
  // unloaded by DoReleaseAudio before the audio device closes
  GAudioRes: List<weak ResHold>;
  GAudioResRoom: int64;
  // The mounted source (nil: none)
  GAssets: ref AssetsHold;

// Lists AHold in AHolds (watched, not held); once the list reaches ARoom the watched holders
// that are gone leave first, then there is room for as many again (64 the least)
func DoTrackIn(var AHolds: List<weak ResHold>; var ARoom: int64; const AHold: ref ResHold);
var
  LWatch: weak ResHold;
  LI: int64;
begin
  if AHolds.Count >= ARoom then
    LI := AHolds.Count - 1;
    while LI >= 0 do
      if not alive(AHolds.Items[LI]) then
        AHolds.Delete(LI);
      end;
      LI -= 1;
    end;
    ARoom := AHolds.Count * 2;
    if ARoom < 64 then
      ARoom := 64;
    end;
  end;
  LWatch := AHold;
  AHolds.Add(LWatch);
end;

// Lists AHold as a GPU holder (DoReleaseGPU unloads it if it is still alive then)
func DoTrackGPU(const AHold: ref ResHold);
begin
  DoTrackIn(GGPUHolds, GGPUHoldsRoom, AHold);
end;

// Lists AHold as an audio holder (DoReleaseAudio unloads it if it is still alive then)
func DoTrackAudio(const AHold: ref ResHold);
begin
  DoTrackIn(GAudioRes, GAudioResRoom, AHold);
end;

// Unloads every audio resource still alive (the audio device is about to close), the newest
// first (a sound alias before the sound it shares): a copy released later does nothing
func DoReleaseAudio();
var
  LHold: ref ResHold;
  LI: int64;
begin
  LI := GAudioRes.Count - 1;
  while LI >= 0 do
    LHold := lock(GAudioRes.Items[LI]);
    if LHold <> nil then
      LHold.Release();
    end;
    LI -= 1;
  end;
  GAudioRes.Clear();
end;

// Unloads every GPU resource still alive (the window is about to close): a copy released
// later does nothing
func DoReleaseGPU();
var
  LHold: ref ResHold;
  LI: int64;
begin
  for LI := 0 to GGPUHolds.Count - 1 do
    LHold := lock(GGPUHolds.Items[LI]);
    if LHold <> nil then
      LHold.Release();
    end;
  end;
  GGPUHolds.Clear();
end;

// The window AWindow (its DoWindowId) is being destroyed (the platform unit's notice, a
// program's own CloseWindow too): its GPU holders are abandoned
func DoGPUGone(const AWindow: uint64);
var
  LHold: ref ResHold;
  LI: int64;
begin
  if AWindow = 0 then
    return;
  end;
  LI := GGPUHolds.Count - 1;
  while LI >= 0 do
    LHold := lock(GGPUHolds.Items[LI]);
    if LHold = nil then
      GGPUHolds.Delete(LI);
    else
      if LHold.WindowId = AWindow then
        LHold.Abandon();
        GGPUHolds.Delete(LI);
      end;
    end;
    LI -= 1;
  end;
end;

// A holder of AImage (owned: unloaded with it; nothing to own for an image raylib could not
// make)
func DoImageHold(const AImage: Image): ref ImageHold;
var
  LHold: ref ImageHold;
begin
  LHold := ref ImageHold();
  LHold.FImage := AImage;
  LHold.Live := IsImageValid(AImage);
  return LHold;
end;

// A holder of ATexture on the window open now: owned (AOwned) and listed, or a view
func DoTextureHold(const ATexture: Texture2D; const AOwned: bool): ref TextureHold;
var
  LHold: ref TextureHold;
begin
  LHold := ref TextureHold();
  LHold.FTexture := ATexture;
  LHold.WindowId := DoWindowId();
  LHold.Live := AOwned and (LHold.WindowId <> 0) and IsTextureValid(ATexture);
  if LHold.Live then
    DoTrackGPU(LHold);
  end;
  return LHold;
end;

// A holder of ATarget on the window open now, owned and listed
func DoRenderTextureHold(const ATarget: RenderTexture2D): ref RenderTextureHold;
var
  LHold: ref RenderTextureHold;
begin
  LHold := ref RenderTextureHold();
  LHold.FTarget := ATarget;
  LHold.WindowId := DoWindowId();
  LHold.Live := (LHold.WindowId <> 0) and IsRenderTextureValid(ATarget);
  if LHold.Live then
    DoTrackGPU(LHold);
  end;
  return LHold;
end;

// A holder of AFont on the window open now: owned (AOwned) and listed, or raylib's default
// font (never unloaded)
func DoFontHold(const AFont: Font; const AOwned: bool): ref FontHold;
var
  LHold: ref FontHold;
begin
  LHold := ref FontHold();
  LHold.FFont := AFont;
  LHold.WindowId := DoWindowId();
  LHold.Live := AOwned and (LHold.WindowId <> 0) and IsFontValid(AFont) and
    (AFont.texture.id <> GetFontDefault().texture.id);
  if LHold.Live then
    DoTrackGPU(LHold);
  end;
  return LHold;
end;

// A holder of AShader on the window open now: owned and listed unless it is raylib's
// default shader (raylib keeps that one)
func DoShaderHold(const AShader: Shader): ref ShaderHold;
var
  LHold: ref ShaderHold;
begin
  LHold := ref ShaderHold();
  LHold.FShader := AShader;
  LHold.WindowId := DoWindowId();
  LHold.Live := (LHold.WindowId <> 0) and (AShader.locs <> nil) and
    (AShader.id <> rlGetShaderIdDefault());
  if LHold.Live then
    DoTrackGPU(LHold);
  end;
  return LHold;
end;

// A holder of AMesh on the window open now, owned (its data and buffers) and listed
func DoMeshHold(const AMesh: Mesh): ref MeshHold;
var
  LHold: ref MeshHold;
begin
  LHold := ref MeshHold();
  LHold.FMesh := AMesh;
  LHold.WindowId := DoWindowId();
  LHold.Live := LHold.WindowId <> 0;
  if LHold.Live then
    DoTrackGPU(LHold);
  end;
  return LHold;
end;

var
  // The shader ShaderRes.Begin / Draw.BeginShader made current: kept alive until its End
  GShaderHold: ref ShaderHold;

// The values one element of a uniform of AType takes (a vec3 three, a float one)
func DoUniformParts(const AType: UniformType): int64;
begin
  if (AType = UniformType.Vec2) or (AType = UniformType.IVec2) or
    (AType = UniformType.UIVec2) then
    return 2;
  end;
  if (AType = UniformType.Vec3) or (AType = UniformType.IVec3) or
    (AType = UniformType.UIVec3) then
    return 3;
  end;
  if (AType = UniformType.Vec4) or (AType = UniformType.IVec4) or
    (AType = UniformType.UIVec4) then
    return 4;
  end;
  return 1;
end;

// True for a uniform of floats (float, vec2, vec3, vec4)
func DoUniformFloats(const AType: UniformType): bool;
begin
  return (AType = UniformType.Float) or (AType = UniformType.Vec2) or
    (AType = UniformType.Vec3) or (AType = UniformType.Vec4);
end;

// The bytes of AData raylib allocated (ASize of them) as an array; the C memory given back
func DoBytes(const AData: ptr to uint8; const ASize: int32): array of uint8;
var
  LBytes: array of uint8;
  LI: int64;
begin
  setlength(LBytes, 0);
  if AData = nil then
    return LBytes;
  end;
  setlength(LBytes, int64(ASize));
  for LI := 0 to int64(ASize) - 1 do
    LBytes[LI] := AData[LI];
  end;
  MemFree(AData);
  return LBytes;
end;

public type
  /// The source every resource path loads from: raylib's loads (images, textures, fonts,
  /// models, sounds, ...) read entries of it by their own names. The examples mount the
  /// shared assets.
  /// C: SetLoadFileDataCallback / SetSaveFileDataCallback / SetLoadFileTextCallback /
  /// SetSaveFileTextCallback (Mount sets all four)
  /// @example `if not Assets.Mount("$P:../../../../assets.zip", "Adam") then return 1; end;`
  Assets = object
    /// Mounts the zip archive at `AArchive` (its password `APassword`, "" for none), closed
    /// again at Unmount or the program's end. A source mounted before goes first.
    /// @param AArchive the archive
    /// @param APassword the password
    /// @returns false when the archive cannot be opened or used (nothing mounted then)
    static method Mount(const AArchive: string; const APassword: string): bool;
    var
      LSource: IOSource;
    begin
      Assets.Unmount();
      LSource := CreateZipIOSource(AArchive, APassword);
      if LSource = nil then
        return false;
      end;
      if not SetRaylibIOSource(LSource) then
        IOSourceClose(LSource);
        return false;
      end;
      GAssets := ref AssetsHold();
      GAssets.Source := LSource;
      GAssets.Owned := true;
      return true;
    end;

    /// Mounts `ASource` (the program keeps it: Unmount never closes it). A source mounted
    /// before goes first.
    /// @param ASource the source
    /// @returns false when it cannot be used (nil, no room): nothing mounted then
    static method Mount(const ASource: IOSource): bool;
    begin
      Assets.Unmount();
      if (ASource = nil) or not SetRaylibIOSource(ASource) then
        return false;
      end;
      GAssets := ref AssetsHold();
      GAssets.Source := ASource;
      GAssets.Owned := false;
      return true;
    end;

    /// Paths load from the disk again; an archive Mount opened is closed.
    static method Unmount();
    begin
      GAssets := nil;
    end;

    /// True while a source is mounted.
    /// @returns `true` while a source is mounted
    static method Mounted(): bool;
    begin
      return GAssets <> nil;
    end;
  end;

  /// A font's glyphs as raylib loads them from a font file's bytes (each with its own image),
  /// for `ImageRes.FontAtlas`: a shared handle, unloaded with the last copy.
  /// C: LoadFontData / UnloadFontData
  /// @example `LGlyphs := GlyphsRes(LTTF, 32, [], FontKind.Default); LAtlas := ImageRes.FontAtlas(LGlyphs, LRecs, 32, 2, 0);`
  GlyphsRes = object
    hidden FHold: ref GlyphsHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing), as a
    /// variable declared with no arguments starts.
    init();
    begin
    end;

    /// The glyphs of the font file `AData` at `ASize` pixels: those of `ACodepoints`, or
    /// raylib's default 95 for none. C: LoadFontData
    /// @param AData the bytes
    /// @param ASize the size
    /// @param ACodepoints the codepoints
    /// @param AKind the kind
    init(const AData: array of uint8; const ASize: int32; const ACodepoints: array of int32;
      const AKind: FontKind);
    var
      LCount: int32;
      LGlyphs: ptr to GlyphInfo;
    begin
      self.FHold := ref GlyphsHold();
      if len(AData) = 0 then
        return;
      end;
      LCount := 0;
      if len(ACodepoints) = 0 then
        LGlyphs := LoadFontData(addr of AData[0], int32(len(AData)), ASize, nil, 0,
          int32(AKind), addr of LCount);
      else
        LGlyphs := LoadFontData(addr of AData[0], int32(len(AData)), ASize,
          addr of ACodepoints[0], int32(len(ACodepoints)), int32(AKind), addr of LCount);
      end;
      self.FHold.FGlyphs := LGlyphs;
      self.FHold.FCount := LCount;
      self.FHold.Live := LGlyphs <> nil;
    end;

