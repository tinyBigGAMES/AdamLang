    end;

    /// A triangle's outline `AThick` wide. C: DrawTriangleLinesEx
    /// @param AA the first corner
    /// @param AB the second corner
    /// @param AC the third corner
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method TriangleLines(const AA: Vector2; const AB: Vector2; const AC: Vector2;
      const AThick: float32; const AColor: Color);
    begin
      DrawTriangleLinesEx(AA, AB, AC, AThick, AColor);
    end;

    /// A triangle fan: the first point is the center (nothing for fewer than three).
    /// C: DrawTriangleFan
    /// @param APoints the points
    /// @param AColor the colour
    static method TriangleFan(const APoints: array of Vector2; const AColor: Color);
    begin
      if len(APoints) = 0 then
        return;
      end;
      DrawTriangleFan(addr of APoints[0], int32(len(APoints)), AColor);
    end;

    /// A triangle strip (nothing for fewer than three points). C: DrawTriangleStrip
    /// @param APoints the points
    /// @param AColor the colour
    static method TriangleStrip(const APoints: array of Vector2; const AColor: Color);
    begin
      if len(APoints) = 0 then
        return;
      end;
      DrawTriangleStrip(addr of APoints[0], int32(len(APoints)), AColor);
    end;

    // ---- rectangles ----

    /// A filled rectangle. C: DrawRectangle / DrawRectangleV / DrawRectangleRec
    /// @param ARect the rectangle
    /// @param AColor the colour
    /// @example `Draw.Rect(Rectangle(x: 10, y: 10, width: 100, height: 40), DARKBLUE);`
    static method Rect(const ARect: Rectangle; const AColor: Color);
    begin
      DrawRectangleRec(ARect, AColor);
    end;

    /// A filled rectangle turned `ARotation` degrees about `AOrigin` (relative to its
    /// corner, which lands at the rectangle's x, y). C: DrawRectanglePro
    /// @param ARect the rectangle
    /// @param AOrigin the origin
    /// @param ARotation the rotation
    /// @param AColor the colour
    static method Rect(const ARect: Rectangle; const AOrigin: Vector2; const ARotation: float32;
      const AColor: Color);
    begin
      DrawRectanglePro(ARect, AOrigin, ARotation, AColor);
    end;

    /// A rectangle shaded from `ATop` down to `ABottom`. C: DrawRectangleGradientV
    /// @param ARect the rectangle
    /// @param ATop the top colour
    /// @param ABottom the bottom colour
    static method RectGradientV(const ARect: Rectangle; const ATop: Color; const ABottom: Color);
    begin
      // raylib's own V form, on the float rectangle (its int form only rounds first)
      DrawRectangleGradientEx(ARect, ATop, ABottom, ABottom, ATop);
    end;

    /// A rectangle shaded from `ALeft` across to `ARight`. C: DrawRectangleGradientH
    /// @param ARect the rectangle
    /// @param ALeft the left colour
    /// @param ARight the right colour
    static method RectGradientH(const ARect: Rectangle; const ALeft: Color; const ARight: Color);
    begin
      DrawRectangleGradientEx(ARect, ALeft, ALeft, ARight, ARight);
    end;

    /// A rectangle shaded between its corners' colors. C: DrawRectangleGradientEx
    /// @param ATopLeft the top-left corner's color, then bottom-left, bottom-right, top-right
    /// @param ARect the rectangle
    /// @param ABottomLeft the bottom-left corner's colour
    /// @param ABottomRight the bottom-right corner's colour
    /// @param ATopRight the top-right corner's colour
    static method RectGradient(const ARect: Rectangle; const ATopLeft: Color;
      const ABottomLeft: Color; const ABottomRight: Color; const ATopRight: Color);
    begin
      DrawRectangleGradientEx(ARect, ATopLeft, ABottomLeft, ABottomRight, ATopRight);
    end;

    /// A rectangle's outline, one unit wide. C: DrawRectangleLines
    /// @param ARect the rectangle
    /// @param AColor the colour
    static method RectLines(const ARect: Rectangle; const AColor: Color);
    begin
      DrawRectangleLinesEx(ARect, 1.0f, AColor);
    end;

    /// A rectangle's outline `AThick` wide, inside the rectangle. C: DrawRectangleLinesEx
    /// @param ARect the rectangle
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method RectLines(const ARect: Rectangle; const AThick: float32; const AColor: Color);
    begin
      DrawRectangleLinesEx(ARect, AThick, AColor);
    end;

