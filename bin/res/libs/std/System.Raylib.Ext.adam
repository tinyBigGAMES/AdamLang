    static method FontAtlas(const AGlyphs: GlyphsRes; var ARecs: array of Rectangle;
      const ASize: int32; const APadding: int32; const APacking: int32): ImageRes;
    var
      LRecs: ptr to Rectangle;
      LCount: int32;
      LAtlas: Image;
      LI: int64;
