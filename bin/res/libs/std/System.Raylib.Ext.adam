    begin
      if self.IsValid() then
        PauseSound(self.Handle());
      end;
      return self;
    end;

    /// Plays on from where it paused. C: ResumeSound
    /// @returns this object, so calls chain
    method Resume(): self;
    begin
      if self.IsValid() then
        ResumeSound(self.Handle());
      end;
      return self;
    end;

    /// True while it plays. C: IsSoundPlaying
    /// @returns `true` while it plays
    const method Playing(): bool;
    begin
      return self.IsValid() and IsSoundPlaying(self.Handle());
    end;

    /// Its volume as a level a person sets, 0 (silent) to 1 (full; clamped): equal steps
    /// sound like equal steps (System.Math's PerceivedVolume over raylib's linear gain).
    /// C: SetSoundVolume
    /// @param AVolume the volume, 0 (silent) to 1 (full)
    /// @returns this object, so calls chain
    method Volume(const AVolume: float32): self;
    begin
      if self.IsValid() then
        SetSoundVolume(self.Handle(), PerceivedVolume(AVolume, 1.0f));
      end;
      return self;
    end;

    /// Its pitch (1: as recorded). C: SetSoundPitch
    /// @param APitch the pitch
    /// @returns this object, so calls chain
    method Pitch(const APitch: float32): self;
    begin
      if self.IsValid() then
        SetSoundPitch(self.Handle(), APitch);
      end;
      return self;
    end;

    /// Its pan, 0 (left) to 1 (right), 0.5 the middle. C: SetSoundPan
    /// @param APan the pan
    /// @returns this object, so calls chain
    method Pan(const APan: float32): self;
    begin
      if self.IsValid() then
        SetSoundPan(self.Handle(), APan);
      end;
      return self;
    end;

    /// Replaces its samples with `AFrames` frames at `AData` (its own format). C: UpdateSound
    /// @param AData the data
    /// @param AFrames the frames
    /// @returns this object, so calls chain
    method Update(const AData: ptr to const; const AFrames: int32): self;
    begin
      if self.IsValid() then
        UpdateSound(self.Handle(), AData, AFrames);
      end;
      return self;
    end;
  end;

public extend WaveRes
  /// The wave as a sound (the device must be open). C: LoadSoundFromWave
  /// @returns the wave as a sound (the device must be open)
  const method ToSound(): SoundRes;
  begin
    return SoundRes.FromWave(self);
  end;
end;

public type
  /// Music, decoded as it plays (call `Update()` once a frame): a shared handle, unloaded
  /// with the last copy or the device's close. Needs the audio device.
  /// C: UnloadMusicStream (the last copy's release)
  /// @example `LSong := MusicRes("res/assets/audio/music/song01.ogg").Looping(true).Play(); ... LSong.Update();`
  MusicRes = object
    hidden FHold: ref MusicHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing).
    init();
    begin
    end;

    /// Opens the music file at `APath` (from the mounted source). C: LoadMusicStream
    /// @param APath the file's path
    init(const APath: string);
    begin
      self.FHold := DoMusicHold(LoadMusicStream(APath), false);
    end;

    /// Opens music of type `AType` (".ogg" ...) read from `AIO` while it plays (the IO stays
    /// the caller's: open until the last copy goes).
    /// @param AIO the IO
    /// @param AType the type
    /// @returns the new `MusicRes`
    static method FromIO(const AIO: IO; const AType: string): MusicRes;
    var
      LRes: MusicRes;
    begin
      LRes.FHold := DoMusicHold(LoadMusicStreamIO(AIO, AType), true);
      return LRes;
    end;

    /// Opens music of type `AType` (".ogg" ...) from the file bytes `AData` (kept with it
    /// while it plays). C: LoadMusicStreamFromMemory
    /// @param AType the type
    /// @param AData the bytes
    /// @returns the new `MusicRes`
    static method FromMemory(const AType: string; const AData: array of uint8): MusicRes;
    var
      LRes: MusicRes;
      LNone: Music;
      LData: array of uint8;
    begin
      if len(AData) = 0 then
        LRes.FHold := DoMusicHold(LNone, false);
        return LRes;
      end;
      // raylib decodes from the bytes as it plays: the holder keeps its own copy
      LData := AData;
      LRes.FHold := DoMusicHold(LoadMusicStreamFromMemory(AType, addr of LData[0],
        int32(len(LData))), false);
      LRes.FHold.FData := LData;
      return LRes;
    end;

    /// The .C music (borrowed, for .C calls; an empty one when none is held).
    /// @returns the .C music (borrowed, for .C calls; an empty one when none is held)
    const method Handle(): Music;
    var
      LNone: Music;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return LNone;
      end;
      return self.FHold.FMusic;
    end;

    /// True when it holds music the device can play. C: IsMusicValid
    /// @returns `true` when it holds music the device can play
    const method IsValid(): bool;
    begin
      return IsMusicValid(self.Handle());
    end;

    /// Plays it (from its start, or from where it paused). C: PlayMusicStream
    /// @returns this object, so calls chain
    method Play(): self;
    begin
      if self.IsValid() then
        PlayMusicStream(self.Handle());
      end;
      return self;
    end;

    /// Stops it (back to its start). C: StopMusicStream
    /// @returns this object, so calls chain
    method Stop(): self;
    begin
      if self.IsValid() then
        StopMusicStream(self.Handle());
      end;
      return self;
    end;

    /// Pauses it where it is. C: PauseMusicStream
    /// @returns this object, so calls chain
    method Pause(): self;
    begin
      if self.IsValid() then
        PauseMusicStream(self.Handle());
      end;
      return self;
    end;

    /// Plays on from where it paused. C: ResumeMusicStream
    /// @returns this object, so calls chain
    method Resume(): self;
    begin
      if self.IsValid() then
        ResumeMusicStream(self.Handle());
      end;
      return self;
    end;

    /// Decodes the next part into its buffers: once a frame while it plays.
    /// C: UpdateMusicStream
    method Update();
    begin
      if self.IsValid() then
        UpdateMusicStream(self.Handle());
      end;
    end;

    /// True while it plays. C: IsMusicStreamPlaying
    /// @returns `true` while it plays
    const method Playing(): bool;
    begin
      return self.IsValid() and IsMusicStreamPlaying(self.Handle());
    end;

    /// Moves it to `ASeconds` from its start. C: SeekMusicStream
    /// @param ASeconds the time, in seconds
    /// @returns this object, so calls chain
    method Seek(const ASeconds: float32): self;
    begin
      if self.IsValid() then
        SeekMusicStream(self.Handle(), ASeconds);
      end;
      return self;
    end;

    /// Its volume as a level a person sets, 0 (silent) to 1 (full; clamped): equal steps
    /// sound like equal steps (System.Math's PerceivedVolume over raylib's linear gain).
    /// C: SetMusicVolume
    /// @param AVolume the volume, 0 (silent) to 1 (full)
    /// @returns this object, so calls chain
    method Volume(const AVolume: float32): self;
    begin
      if self.IsValid() then
        SetMusicVolume(self.Handle(), PerceivedVolume(AVolume, 1.0f));
      end;
      return self;
    end;

    /// Its pitch (1: as recorded). C: SetMusicPitch
    /// @param APitch the pitch
    /// @returns this object, so calls chain
    method Pitch(const APitch: float32): self;
    begin
      if self.IsValid() then
        SetMusicPitch(self.Handle(), APitch);
      end;
      return self;
    end;

    /// Its pan, 0 (left) to 1 (right), 0.5 the middle. C: SetMusicPan
    /// @param APan the pan
    /// @returns this object, so calls chain
    method Pan(const APan: float32): self;
    begin
      if self.IsValid() then
        SetMusicPan(self.Handle(), APan);
      end;
      return self;
    end;

    /// Plays again from its start at its end (true) or stops there. C: music.looping
    /// @param ALoop `true` to loop
    /// @returns this object, so calls chain
    method Looping(const ALoop: bool): self;
    begin
      if self.IsValid() then
        self.FHold.FMusic.looping := ALoop;
      end;
      return self;
    end;

    /// True when it plays again from its start at its end. C: music.looping
    /// @returns `true` when it plays again from its start at its end
    const method Looping(): bool;
    begin
      return self.Handle().looping;
    end;

    /// Its length in seconds. C: GetMusicTimeLength
    /// @returns its length in seconds
    const method Length(): float32;
    begin
      if not self.IsValid() then
        return 0.0f;
      end;
      return GetMusicTimeLength(self.Handle());
    end;

    /// The seconds played since its start. C: GetMusicTimePlayed
    /// @returns the seconds played since its start
    const method Played(): float32;
    begin
      if not self.IsValid() then
        return 0.0f;
      end;
      return GetMusicTimePlayed(self.Handle());
    end;
  end;

  /// A raw audio stream the program feeds (Update with frames, or a Callback raylib calls
  /// for them): a shared handle, unloaded with the last copy or the device's close. Needs
