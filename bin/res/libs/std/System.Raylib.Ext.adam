  /// C: UnloadAudioStream (the last copy's release)
  /// @example `LTone := AudioStreamRes(44100, 32, 1).Callback(func(ABuffer: ptr; AFrames: uint32) begin Sine(ABuffer, AFrames); end).Play();`
  AudioStreamRes = object
    hidden FHold: ref AudioStreamHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing).
    init();
    begin
    end;

    /// A stream of `ASampleRate` Hz, `ASampleSize` bits (8, 16 or 32: float) and `AChannels`
    /// channels. C: LoadAudioStream
    /// @param ASampleRate the sample rate
    /// @param ASampleSize the sample size
    /// @param AChannels the channels
    init(const ASampleRate: uint32; const ASampleSize: uint32; const AChannels: uint32);
    begin
