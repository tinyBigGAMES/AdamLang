  /// The vector scaled by `S`. C: Vector3Scale
  /// @param A the left operand
  /// @param S the right operand
  /// @returns the vector scaled by `S`
  operator *(const A: Vector3; const S: float32): Vector3;
  begin
    return Vector3Scale(A, S);
  end;

  /// Component-wise quotient. C: Vector3Divide
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise quotient
  operator /(const A: Vector3; const B: Vector3): Vector3;
  begin
    return Vector3Divide(A, B);
  end;

  /// The vector divided by `S`. C: Vector3Scale by 1 / S
  /// @param A the left operand
  /// @param S the right operand
  /// @returns the vector divided by `S`
  operator /(const A: Vector3; const S: float32): Vector3;
  begin
    return Vector3Scale(A, 1.0f / S);
  end;

  /// True when equal within raymath's epsilon. C: Vector3Equals
  /// @param A the left operand
  /// @param B the right operand
  /// @returns `true` when equal within raymath's epsilon
  operator =(const A: Vector3; const B: Vector3): bool;
  begin
    return Vector3Equals(A, B) <> 0;
