  const method Clamp(const ALo: float32; const AHi: float32): Vector3;
  begin
    return Vector3ClampValue(self, ALo, AHi);
  end;

  /// The barycentric coordinates (u, v, w) of `AP` in the triangle. C: Vector3Barycenter
  /// @param AP the point
  /// @param AA the first corner
  /// @param AB the second corner
  /// @param AC the third corner
  /// @returns the barycentric coordinates (u, v, w) of `AP` in the triangle
  static method Barycenter(const AP: Vector3; const AA: Vector3; const AB: Vector3;
    const AC: Vector3): Vector3;
