    /// @param ARoundness 0 (square) to 1 (the short side a half circle)
    /// @param ASegments the segments per corner (0: raylib picks)
    /// @param ARect the rectangle
    /// @param AColor the colour
    static method RectRounded(const ARect: Rectangle; const ARoundness: float32;
      const ASegments: int32; const AColor: Color);
    begin
