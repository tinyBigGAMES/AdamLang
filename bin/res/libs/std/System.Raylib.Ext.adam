    end;

    /// A filled ring (or a slice of one), angles in degrees. C: DrawRing
    /// @param ACenter the centre
    /// @param AInner the inner radius
    /// @param AOuter the outer radius
    /// @param AStartAngle the start angle, in degrees
    /// @param AEndAngle the end angle, in degrees
    /// @param ASegments how many segments
    /// @param AColor the colour
    static method Ring(const ACenter: Vector2; const AInner: float32; const AOuter: float32;
      const AStartAngle: float32; const AEndAngle: float32; const ASegments: int32;
      const AColor: Color);
    begin
      DrawRing(ACenter, AInner, AOuter, AStartAngle, AEndAngle, ASegments, AColor);
    end;

    /// A ring's outline. C: DrawRingLines
    /// @param ACenter the centre
    /// @param AInner the inner radius
    /// @param AOuter the outer radius
    /// @param AStartAngle the start angle, in degrees
    /// @param AEndAngle the end angle, in degrees
    /// @param ASegments how many segments
    /// @param AColor the colour
    static method RingLines(const ACenter: Vector2; const AInner: float32; const AOuter: float32;
      const AStartAngle: float32; const AEndAngle: float32; const ASegments: int32;
      const AColor: Color);
    begin
      DrawRingLines(ACenter, AInner, AOuter, AStartAngle, AEndAngle, ASegments, AColor);
    end;

    /// A ring's outline `AThick` wide. C: DrawRingLinesEx
    /// @param ACenter the centre
    /// @param AInner the inner radius
    /// @param AOuter the outer radius
    /// @param AStartAngle the start angle, in degrees
    /// @param AEndAngle the end angle, in degrees
    /// @param ASegments how many segments
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method RingLines(const ACenter: Vector2; const AInner: float32; const AOuter: float32;
      const AStartAngle: float32; const AEndAngle: float32; const ASegments: int32;
      const AThick: float32; const AColor: Color);
    begin
      DrawRingLinesEx(ACenter, AInner, AOuter, AStartAngle, AEndAngle, ASegments, AThick, AColor);
    end;

    // ---- splines (the whole spline; a Segment* one piece of it) ----

    /// Straight lines through `APoints`, `AThick` wide (nothing for fewer than two).
    /// C: DrawSplineLinear
    /// @param APoints the points
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method SplineLinear(const APoints: array of Vector2; const AThick: float32;
      const AColor: Color);
    begin
      if len(APoints) = 0 then
        return;
      end;
      DrawSplineLinear(addr of APoints[0], int32(len(APoints)), AThick, AColor);
    end;

    /// A B-spline over `APoints` (at least four). C: DrawSplineBasis
    /// @param APoints the points
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method SplineBasis(const APoints: array of Vector2; const AThick: float32;
      const AColor: Color);
    begin
      if len(APoints) = 0 then
        return;
      end;
      DrawSplineBasis(addr of APoints[0], int32(len(APoints)), AThick, AColor);
    end;

    /// A Catmull-Rom spline through `APoints` (at least four). C: DrawSplineCatmullRom
    /// @param APoints the points
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method SplineCatmullRom(const APoints: array of Vector2; const AThick: float32;
      const AColor: Color);
    begin
      if len(APoints) = 0 then
        return;
      end;
      DrawSplineCatmullRom(addr of APoints[0], int32(len(APoints)), AThick, AColor);
    end;

    /// Quadratic Bezier pieces: point, control, point, control, .. point.
    /// C: DrawSplineBezierQuadratic
    /// @param APoints the points
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method SplineBezierQuadratic(const APoints: array of Vector2; const AThick: float32;
      const AColor: Color);
    begin
      if len(APoints) = 0 then
        return;
      end;
      DrawSplineBezierQuadratic(addr of APoints[0], int32(len(APoints)), AThick, AColor);
    end;

    /// Cubic Bezier pieces: point, control, control, point, control, control, .. point.
    /// C: DrawSplineBezierCubic
    /// @param APoints the points
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method SplineBezierCubic(const APoints: array of Vector2; const AThick: float32;
      const AColor: Color);
    begin
      if len(APoints) = 0 then
        return;
      end;
      DrawSplineBezierCubic(addr of APoints[0], int32(len(APoints)), AThick, AColor);
    end;

    /// One straight piece. C: DrawSplineSegmentLinear
    /// @param AStart the start
    /// @param AEnd the end
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method SegmentLinear(const AStart: Vector2; const AEnd: Vector2;
      const AThick: float32; const AColor: Color);
    begin
      DrawSplineSegmentLinear(AStart, AEnd, AThick, AColor);
    end;

    /// One B-spline piece over four points. C: DrawSplineSegmentBasis
    /// @param AP1 the first point
    /// @param AP2 the second point
    /// @param AP3 the third point
    /// @param AP4 the fourth point
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method SegmentBasis(const AP1: Vector2; const AP2: Vector2; const AP3: Vector2;
      const AP4: Vector2; const AThick: float32; const AColor: Color);
    begin
      DrawSplineSegmentBasis(AP1, AP2, AP3, AP4, AThick, AColor);
    end;

    /// One Catmull-Rom piece over four points. C: DrawSplineSegmentCatmullRom
    /// @param AP1 the first point
    /// @param AP2 the second point
    /// @param AP3 the third point
    /// @param AP4 the fourth point
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method SegmentCatmullRom(const AP1: Vector2; const AP2: Vector2; const AP3: Vector2;
      const AP4: Vector2; const AThick: float32; const AColor: Color);
    begin
      DrawSplineSegmentCatmullRom(AP1, AP2, AP3, AP4, AThick, AColor);
    end;

    /// One quadratic Bezier piece. C: DrawSplineSegmentBezierQuadratic
    /// @param AStart the start
    /// @param AControl the control
    /// @param AEnd the end
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method SegmentBezierQuadratic(const AStart: Vector2; const AControl: Vector2;
      const AEnd: Vector2; const AThick: float32; const AColor: Color);
    begin
      DrawSplineSegmentBezierQuadratic(AStart, AControl, AEnd, AThick, AColor);
    end;

    /// One cubic Bezier piece. C: DrawSplineSegmentBezierCubic
    /// @param AStart the start
    /// @param AControl1 the first control point
    /// @param AControl2 the second control point
    /// @param AEnd the end
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method SegmentBezierCubic(const AStart: Vector2; const AControl1: Vector2;
      const AControl2: Vector2; const AEnd: Vector2; const AThick: float32; const AColor: Color);
    begin
      DrawSplineSegmentBezierCubic(AStart, AControl1, AControl2, AEnd, AThick, AColor);
    end;

    // ---- text (the default font; FontRes forms come with FontRes) ----

    /// `AText` in raylib's default font, `ASize` units high (10 at least, as raylib's
    /// DrawText). C: DrawText
    /// @param AText the text
    /// @param APos the position
    /// @param ASize the size
    /// @param AColor the colour
    /// @example `Draw.Text("Game Over", Vector2(x: 8, y: 8), 20.0f, WHITE);`
    static method Text(const AText: string; const APos: Vector2; const ASize: float32;
      const AColor: Color);
    var
      LSize: float32;
    begin
      // DrawText's own rules on floats: the default font's size 10 the least, its spacing
      // one unit per whole 10
      LSize := Max(ASize, 10.0f);
      DrawTextEx(GetFontDefault(), AText, APos, LSize, float32(Trunc(LSize / 10.0f)), AColor);
    end;

    /// The frames per second, in green (orange, red as it drops). C: DrawFPS
    /// @param APos the position
    static method FPS(const APos: Vector2);
    begin
      DrawFPS(DoRound(APos.x), DoRound(APos.y));
    end;

    // ---- textures ----

    /// `ATexture` at `APos`, multiplied by `ATint`. C: DrawTexture / DrawTextureV
    /// @param ATexture the texture
    /// @param APos the position
    /// @param ATint the tint colour
    /// @example `Draw.Texture(LHero, LHeroPos, WHITE);`
    static method Texture(const ATexture: TextureRes; const APos: Vector2; const ATint: Color);
    begin
      DrawTextureV(ATexture.Handle(), APos, ATint);
    end;

    /// `ATexture` turned `ARotation` degrees about its corner and scaled by `AScale`.
    /// C: DrawTextureEx
    /// @param ATexture the texture
    /// @param APos the position
    /// @param ARotation the rotation
    /// @param AScale the scale
    /// @param ATint the tint colour
    static method Texture(const ATexture: TextureRes; const APos: Vector2;
      const ARotation: float32; const AScale: float32; const ATint: Color);
    begin
      DrawTextureEx(ATexture.Handle(), APos, ARotation, AScale, ATint);
    end;

    /// The part `ASource` of `ATexture` at `APos` (a negative width or height flips it).
    /// C: DrawTextureRec
    /// @param ATexture the texture
    /// @param ASource the source
    /// @param APos the position
    /// @param ATint the tint colour
    static method Texture(const ATexture: TextureRes; const ASource: Rectangle;
      const APos: Vector2; const ATint: Color);
    begin
      DrawTextureRec(ATexture.Handle(), ASource, APos, ATint);
    end;

    /// The part `ASource` of `ATexture` scaled into `ADest`, turned `ARotation` degrees about
    /// `AOrigin` (from the destination's corner). C: DrawTexturePro
    /// @param ATexture the texture
    /// @param ASource the source
    /// @param ADest the rectangle drawn into
    /// @param AOrigin the origin
    /// @param ARotation the rotation
    /// @param ATint the tint colour
    static method Texture(const ATexture: TextureRes; const ASource: Rectangle;
      const ADest: Rectangle; const AOrigin: Vector2; const ARotation: float32;
      const ATint: Color);
    begin
      DrawTexturePro(ATexture.Handle(), ASource, ADest, AOrigin, ARotation, ATint);
    end;

    /// `ATarget`'s picture at `APos`, the right way up. C: DrawTextureRec (rows flipped)
    /// @param ATarget the target
    /// @param APos the position
    /// @param ATint the tint colour
    static method Texture(const ATarget: RenderTextureRes; const APos: Vector2;
      const ATint: Color);
    begin
      DrawTextureRec(ATarget.Handle().texture, DoUpright(ATarget, DoWhole(ATarget)), APos,
        ATint);
    end;

    /// `ATarget`'s picture the right way up, turned `ARotation` degrees about its corner and
    /// scaled by `AScale`. C: DrawTexturePro (rows flipped)
    /// @param ATarget the target
    /// @param APos the position
    /// @param ARotation the rotation
    /// @param AScale the scale
    /// @param ATint the tint colour
    static method Texture(const ATarget: RenderTextureRes; const APos: Vector2;
      const ARotation: float32; const AScale: float32; const ATint: Color);
    begin
      DrawTexturePro(ATarget.Handle().texture, DoUpright(ATarget, DoWhole(ATarget)),
        Rectangle(x: APos.x, y: APos.y, width: float32(ATarget.Width()) * AScale,
        height: float32(ATarget.Height()) * AScale), Vector2(x: 0.0f, y: 0.0f), ARotation,
        ATint);
    end;

    /// The part `ASource` of `ATarget`'s picture (in its pixels, top-down) at `APos`, the
    /// right way up. C: DrawTextureRec (rows flipped)
    /// @param ATarget the target
    /// @param ASource the source
    /// @param APos the position
    /// @param ATint the tint colour
    static method Texture(const ATarget: RenderTextureRes; const ASource: Rectangle;
      const APos: Vector2; const ATint: Color);
    begin
      DrawTextureRec(ATarget.Handle().texture, DoUpright(ATarget, ASource), APos, ATint);
    end;

    /// The part `ASource` of `ATarget`'s picture scaled into `ADest`, the right way up,
    /// turned `ARotation` degrees about `AOrigin`. C: DrawTexturePro (rows flipped)
    /// @param ATarget the target
    /// @param ASource the source
    /// @param ADest the rectangle drawn into
    /// @param AOrigin the origin
    /// @param ARotation the rotation
    /// @param ATint the tint colour
    /// @example `Draw.Texture(LCanvas, Rectangle(x: 0, y: 0, width: 160, height: 90), Rectangle(x: 0, y: 0, width: 320, height: 180), Vector2(x: 0, y: 0), 0.0f, WHITE);`
    static method Texture(const ATarget: RenderTextureRes; const ASource: Rectangle;
      const ADest: Rectangle; const AOrigin: Vector2; const ARotation: float32;
      const ATint: Color);
    begin
      DrawTexturePro(ATarget.Handle().texture, DoUpright(ATarget, ASource), ADest, AOrigin,
        ARotation, ATint);
    end;

    /// `AVideo`'s frame at `APos` (nothing before its first frame).
    /// @param AVideo the video
    /// @param APos the position
    /// @param ATint the tint colour
    /// @example `LIntro.Update(); Draw.Video(LIntro, Vector2(x: 0.0f, y: 0.0f), WHITE);`
    static method Video(const AVideo: VideoRes; const APos: Vector2; const ATint: Color);
    begin
      Draw.Video(AVideo, DoWholeVideo(AVideo), Rectangle(x: APos.x, y: APos.y,
        width: float32(AVideo.Width()), height: float32(AVideo.Height())),
        Vector2(x: 0.0f, y: 0.0f), 0.0f, ATint);
    end;

    /// `AVideo`'s frame turned `ARotation` degrees about its corner and scaled by `AScale`.
    /// @param AVideo the video
    /// @param APos the position
    /// @param ARotation the rotation
    /// @param AScale the scale
    /// @param ATint the tint colour
    static method Video(const AVideo: VideoRes; const APos: Vector2; const ARotation: float32;
      const AScale: float32; const ATint: Color);
    begin
      Draw.Video(AVideo, DoWholeVideo(AVideo), Rectangle(x: APos.x, y: APos.y,
        width: float32(AVideo.Width()) * AScale, height: float32(AVideo.Height()) * AScale),
        Vector2(x: 0.0f, y: 0.0f), ARotation, ATint);
    end;

    /// The part `ASource` (in its pixels) of `AVideo`'s frame at `APos`.
    /// @param AVideo the video
    /// @param ASource the source
    /// @param APos the position
    /// @param ATint the tint colour
    static method Video(const AVideo: VideoRes; const ASource: Rectangle; const APos: Vector2;
      const ATint: Color);
    begin
      Draw.Video(AVideo, ASource, Rectangle(x: APos.x, y: APos.y, width: ASource.width,
        height: ASource.height), Vector2(x: 0.0f, y: 0.0f), 0.0f, ATint);
    end;

    /// The part `ASource` of `AVideo`'s frame scaled into `ADest`, turned `ARotation`
    /// degrees about `AOrigin` (from the destination's corner).
    /// @param AVideo the video
    /// @param ASource the source
    /// @param ADest the rectangle drawn into
    /// @param AOrigin the origin
    /// @param ARotation the rotation
    /// @param ATint the tint colour
    /// @example `Draw.Video(LIntro, Rectangle(x: 0, y: 0, width: 320, height: 180), Rectangle(x: 0, y: 0, width: 640, height: 360), Vector2(x: 0, y: 0), 0.0f, WHITE);`
    static method Video(const AVideo: VideoRes; const ASource: Rectangle;
      const ADest: Rectangle; const AOrigin: Vector2; const ARotation: float32;
      const ATint: Color);
    begin
      DrawVideoPro(AVideo.Handle(), ASource, ADest, AOrigin, ARotation, ATint);
    end;

    // The whole of AVideo's frame
    hidden static method DoWholeVideo(const AVideo: VideoRes): Rectangle;
    begin
      return Rectangle(x: 0.0f, y: 0.0f, width: float32(AVideo.Width()),
        height: float32(AVideo.Height()));
    end;

    // The whole of ATarget's picture, top-down
    hidden static method DoWhole(const ATarget: RenderTextureRes): Rectangle;
    begin
      return Rectangle(x: 0.0f, y: 0.0f, width: float32(ATarget.Width()),
        height: float32(ATarget.Height()));
    end;

    // ASource (top-down, in ATarget's pixels) as the rows OpenGL holds: bottom-up, so the
    // height is negative and the top is counted from the bottom
    hidden static method DoUpright(const ATarget: RenderTextureRes;
      const ASource: Rectangle): Rectangle;
    begin
      return Rectangle(x: ASource.x, y: float32(ATarget.Height()) - ASource.y - ASource.height,
        width: ASource.width, height: -ASource.height);
    end;

    /// `ATexture` stretched into `ADest` by `AInfo` (a 9-patch or 3-patch: the corners kept,
    /// the edges and middle stretched), turned `ARotation` degrees about `AOrigin`.
    /// C: DrawTextureNPatch
    /// @param ATexture the texture
    /// @param AInfo the info
    /// @param ADest the rectangle drawn into
    /// @param AOrigin the origin
    /// @param ARotation the rotation
    /// @param ATint the tint colour
    static method NPatch(const ATexture: TextureRes; const AInfo: NPatchInfo;
      const ADest: Rectangle; const AOrigin: Vector2; const ARotation: float32;
      const ATint: Color);
    begin
      DrawTextureNPatch(ATexture.Handle(), AInfo, ADest, AOrigin, ARotation, ATint);
    end;

    // ---- text in a font ----

    /// `AText` in `AFont` at `ASize`, `ASpacing` between glyphs. C: DrawTextEx
    /// @param AFont the font
    /// @param AText the text
    /// @param APos the position
    /// @param ASize the size
    /// @param ASpacing the spacing
    /// @param ATint the tint colour
    /// @example `Draw.Text(LMono, "Score 100", Vector2(x: 8, y: 8), 16.0f, 1.0f, WHITE);`
    static method Text(const AFont: FontRes; const AText: string; const APos: Vector2;
      const ASize: float32; const ASpacing: float32; const ATint: Color);
    begin
      DrawTextEx(AFont.Handle(), AText, APos, ASize, ASpacing, ATint);
    end;

    /// `AText` in `AFont` turned `ARotation` degrees about `AOrigin`. C: DrawTextPro
    /// @param AFont the font
    /// @param AText the text
    /// @param APos the position
    /// @param AOrigin the origin
    /// @param ARotation the rotation
    /// @param ASize the size
    /// @param ASpacing the spacing
    /// @param ATint the tint colour
    static method Text(const AFont: FontRes; const AText: string; const APos: Vector2;
      const AOrigin: Vector2; const ARotation: float32; const ASize: float32;
      const ASpacing: float32; const ATint: Color);
    begin
      DrawTextPro(AFont.Handle(), AText, APos, AOrigin, ARotation, ASize, ASpacing, ATint);
    end;

    /// One codepoint's glyph in `AFont`. C: DrawTextCodepoint
    /// @param AFont the font
    /// @param ACodepoint the codepoint
    /// @param APos the position
    /// @param ASize the size
    /// @param ATint the tint colour
    static method Codepoint(const AFont: FontRes; const ACodepoint: int32; const APos: Vector2;
      const ASize: float32; const ATint: Color);
    begin
      DrawTextCodepoint(AFont.Handle(), ACodepoint, APos, ASize, ATint);
    end;

    /// The glyphs of `ACodepoints` in `AFont` (nothing for none). C: DrawTextCodepoints
    /// @param AFont the font
    /// @param ACodepoints the codepoints
    /// @param APos the position
    /// @param ASize the size
    /// @param ASpacing the spacing
    /// @param ATint the tint colour
    static method Codepoints(const AFont: FontRes; const ACodepoints: array of int32;
      const APos: Vector2; const ASize: float32; const ASpacing: float32; const ATint: Color);
    begin
      if len(ACodepoints) = 0 then
        return;
      end;
      DrawTextCodepoints(AFont.Handle(), addr of ACodepoints[0], int32(len(ACodepoints)), APos,
        ASize, ASpacing, ATint);
    end;

    // ---- 3D (between Begin3D and End3D) ----

    /// A 3D line. C: DrawLine3D
    /// @param AStart the start
    /// @param AEnd the end
    /// @param AColor the colour
    static method Line3D(const AStart: Vector3; const AEnd: Vector3; const AColor: Color);
    begin
      DrawLine3D(AStart, AEnd, AColor);
    end;

    /// A 3D point. C: DrawPoint3D
    /// @param APos the position
    /// @param AColor the colour
    static method Point3D(const APos: Vector3; const AColor: Color);
    begin
      DrawPoint3D(APos, AColor);
    end;

    /// A circle turned `AAngle` degrees about `AAxis`. C: DrawCircle3D
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AAxis the axis
    /// @param AAngle the angle
    /// @param AColor the colour
    static method Circle3D(const ACenter: Vector3; const ARadius: float32; const AAxis: Vector3;
      const AAngle: float32; const AColor: Color);
    begin
      DrawCircle3D(ACenter, ARadius, AAxis, AAngle, AColor);
    end;

    /// A filled 3D triangle (corners counter-clockwise). C: DrawTriangle3D
    /// @param AA the first corner
    /// @param AB the second corner
    /// @param AC the third corner
    /// @param AColor the colour
    static method Triangle3D(const AA: Vector3; const AB: Vector3; const AC: Vector3;
      const AColor: Color);
    begin
      DrawTriangle3D(AA, AB, AC, AColor);
    end;

    /// A 3D triangle strip (nothing for fewer than three points). C: DrawTriangleStrip3D
    /// @param APoints the points
    /// @param AColor the colour
    static method TriangleStrip3D(const APoints: array of Vector3; const AColor: Color);
    begin
      if len(APoints) = 0 then
        return;
      end;
      DrawTriangleStrip3D(addr of APoints[0], int32(len(APoints)), AColor);
    end;

    /// A filled box centered at `APos`. C: DrawCube / DrawCubeV
    /// @param ASize its width, height and length
    /// @param APos the position
    /// @param AColor the colour
    static method Cube(const APos: Vector3; const ASize: Vector3; const AColor: Color);
    begin
      DrawCubeV(APos, ASize, AColor);
    end;

    /// A box's edges. C: DrawCubeWires / DrawCubeWiresV
    /// @param APos the position
    /// @param ASize the size
    /// @param AColor the colour
    static method CubeWires(const APos: Vector3; const ASize: Vector3; const AColor: Color);
    begin
      DrawCubeWiresV(APos, ASize, AColor);
    end;

    /// A filled sphere. C: DrawSphere
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AColor the colour
    static method Sphere(const ACenter: Vector3; const ARadius: float32; const AColor: Color);
    begin
      DrawSphere(ACenter, ARadius, AColor);
    end;

    /// A filled sphere of `ARings` rings and `ASlices` slices. C: DrawSphereEx
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param ARings how many rings
    /// @param ASlices how many slices
    /// @param AColor the colour
    static method Sphere(const ACenter: Vector3; const ARadius: float32; const ARings: int32;
      const ASlices: int32; const AColor: Color);
    begin
      DrawSphereEx(ACenter, ARadius, ARings, ASlices, AColor);
    end;

    /// A sphere's wires. C: DrawSphereWires
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param ARings how many rings
    /// @param ASlices how many slices
    /// @param AColor the colour
    static method SphereWires(const ACenter: Vector3; const ARadius: float32;
      const ARings: int32; const ASlices: int32; const AColor: Color);
    begin
      DrawSphereWires(ACenter, ARadius, ARings, ASlices, AColor);
    end;

    /// A filled cylinder (a cone when a radius is 0) standing on `APos`. C: DrawCylinder
    /// @param APos the position
    /// @param ARadiusTop the radius top
    /// @param ARadiusBottom the radius bottom
    /// @param AHeight the height
    /// @param ASides how many sides
    /// @param AColor the colour
    static method Cylinder(const APos: Vector3; const ARadiusTop: float32;
      const ARadiusBottom: float32; const AHeight: float32; const ASides: int32;
      const AColor: Color);
    begin
      DrawCylinder(APos, ARadiusTop, ARadiusBottom, AHeight, ASides, AColor);
    end;

    /// A filled cylinder from `AStart` to `AEnd`. C: DrawCylinderEx
    /// @param AStart the start
    /// @param AEnd the end
    /// @param AStartRadius the start radius
    /// @param AEndRadius the end radius
    /// @param ASides how many sides
    /// @param AColor the colour
    static method Cylinder(const AStart: Vector3; const AEnd: Vector3; const AStartRadius: float32;
      const AEndRadius: float32; const ASides: int32; const AColor: Color);
    begin
      DrawCylinderEx(AStart, AEnd, AStartRadius, AEndRadius, ASides, AColor);
    end;

    /// A cylinder's wires, standing on `APos`. C: DrawCylinderWires
    /// @param APos the position
    /// @param ARadiusTop the radius top
    /// @param ARadiusBottom the radius bottom
    /// @param AHeight the height
    /// @param ASides how many sides
    /// @param AColor the colour
    static method CylinderWires(const APos: Vector3; const ARadiusTop: float32;
      const ARadiusBottom: float32; const AHeight: float32; const ASides: int32;
      const AColor: Color);
    begin
      DrawCylinderWires(APos, ARadiusTop, ARadiusBottom, AHeight, ASides, AColor);
    end;

    /// A cylinder's wires from `AStart` to `AEnd`. C: DrawCylinderWiresEx
    /// @param AStart the start
    /// @param AEnd the end
    /// @param AStartRadius the start radius
    /// @param AEndRadius the end radius
    /// @param ASides how many sides
    /// @param AColor the colour
    static method CylinderWires(const AStart: Vector3; const AEnd: Vector3;
      const AStartRadius: float32; const AEndRadius: float32; const ASides: int32;
      const AColor: Color);
    begin
      DrawCylinderWiresEx(AStart, AEnd, AStartRadius, AEndRadius, ASides, AColor);
    end;

    /// A filled capsule from `AStart` to `AEnd`. C: DrawCapsule
    /// @param AStart the start
    /// @param AEnd the end
    /// @param ARadius the radius
    /// @param ASlices how many slices
    /// @param ARings how many rings
    /// @param AColor the colour
    static method Capsule(const AStart: Vector3; const AEnd: Vector3; const ARadius: float32;
      const ASlices: int32; const ARings: int32; const AColor: Color);
    begin
      // raylib's order is rings, then slices
      DrawCapsule(AStart, AEnd, ARadius, ARings, ASlices, AColor);
    end;

    /// A capsule's wires. C: DrawCapsuleWires
    /// @param AStart the start
    /// @param AEnd the end
    /// @param ARadius the radius
    /// @param ASlices how many slices
    /// @param ARings how many rings
    /// @param AColor the colour
    static method CapsuleWires(const AStart: Vector3; const AEnd: Vector3;
      const ARadius: float32; const ASlices: int32; const ARings: int32; const AColor: Color);
    begin
      DrawCapsuleWires(AStart, AEnd, ARadius, ARings, ASlices, AColor);
    end;

    /// A flat plane on the XZ axes. C: DrawPlane
    /// @param ACenter the centre
    /// @param ASize the size
    /// @param AColor the colour
    static method Plane(const ACenter: Vector3; const ASize: Vector2; const AColor: Color);
    begin
      DrawPlane(ACenter, ASize, AColor);
    end;

    /// A ray as a line from its position along its direction. C: DrawRay
    /// @param ARay the ray
    /// @param AColor the colour
    static method Ray(const ARay: Ray; const AColor: Color);
    begin
      DrawRay(ARay, AColor);
    end;

    /// A grid on the XZ plane centered on the origin. C: DrawGrid
    /// @param ASlices the lines each way
    /// @param ASpacing the spacing
    static method Grid(const ASlices: int32; const ASpacing: float32);
    begin
      DrawGrid(ASlices, ASpacing);
    end;

    /// A bounding box's edges. C: DrawBoundingBox
    /// @param ABox the box
    /// @param AColor the colour
    static method Box(const ABox: BoundingBox; const AColor: Color);
    begin
      DrawBoundingBox(ABox, AColor);
    end;

    /// `ATexture` facing `ACamera` at `APos`, `AScale` units high. C: DrawBillboard
    /// @param ACamera the camera
    /// @param ATexture the texture
    /// @param APos the position
    /// @param AScale the scale
    /// @param ATint the tint colour
    static method Billboard(const ACamera: Camera3D; const ATexture: TextureRes;
      const APos: Vector3; const AScale: float32; const ATint: Color);
    begin
      DrawBillboard(ACamera, ATexture.Handle(), APos, AScale, ATint);
    end;

    /// The part `ASource` of `ATexture` facing `ACamera`, `ASize` units. C: DrawBillboardRec
    /// @param ACamera the camera
    /// @param ATexture the texture
    /// @param ASource the source
    /// @param APos the position
    /// @param ASize the size
    /// @param ATint the tint colour
    static method Billboard(const ACamera: Camera3D; const ATexture: TextureRes;
      const ASource: Rectangle; const APos: Vector3; const ASize: Vector2; const ATint: Color);
    begin
      DrawBillboardRec(ACamera, ATexture.Handle(), ASource, APos, ASize, ATint);
    end;

    /// The part `ASource` of `ATexture` facing `ACamera` with `AUp` as its up, turned
    /// `ARotation` degrees about `AOrigin`. C: DrawBillboardPro
    /// @param ACamera the camera
    /// @param ATexture the texture
    /// @param ASource the source
    /// @param APos the position
    /// @param AUp the up direction
    /// @param ASize the size
    /// @param AOrigin the origin
    /// @param ARotation the rotation
    /// @param ATint the tint colour
    static method Billboard(const ACamera: Camera3D; const ATexture: TextureRes;
      const ASource: Rectangle; const APos: Vector3; const AUp: Vector3; const ASize: Vector2;
      const AOrigin: Vector2; const ARotation: float32; const ATint: Color);
    begin
      DrawBillboardPro(ACamera, ATexture.Handle(), ASource, APos, AUp, ASize, AOrigin,
        ARotation, ATint);
    end;
  end;

  /// A point on a spline: `AT` runs 0 to 1 along it. C: GetSplinePoint*
  /// @example `LShip := Spline.CatmullRom(LP1, LP2, LP3, LP4, LTime);`
  Spline = object
    /// On a straight piece. C: GetSplinePointLinear
    /// @param AStart the start
    /// @param AEnd the end
    /// @param AT how far along, 0 to 1
    /// @returns the point `AT` of the way along the piece
    static method Linear(const AStart: Vector2; const AEnd: Vector2; const AT: float32): Vector2;
    begin
      return GetSplinePointLinear(AStart, AEnd, AT);
    end;

    /// On a B-spline piece. C: GetSplinePointBasis
    /// @param AP1 the first point
    /// @param AP2 the second point
    /// @param AP3 the third point
    /// @param AP4 the fourth point
    /// @param AT how far along, 0 to 1
    /// @returns the point `AT` of the way along the piece
    static method Basis(const AP1: Vector2; const AP2: Vector2; const AP3: Vector2;
      const AP4: Vector2; const AT: float32): Vector2;
    begin
      return GetSplinePointBasis(AP1, AP2, AP3, AP4, AT);
    end;

    /// On a Catmull-Rom piece (AP2 at 0, AP3 at 1). C: GetSplinePointCatmullRom
    /// @param AP1 the first point
    /// @param AP2 the second point
    /// @param AP3 the third point
    /// @param AP4 the fourth point
    /// @param AT how far along, 0 to 1
    /// @returns the point `AT` of the way along the piece
    static method CatmullRom(const AP1: Vector2; const AP2: Vector2; const AP3: Vector2;
      const AP4: Vector2; const AT: float32): Vector2;
    begin
      return GetSplinePointCatmullRom(AP1, AP2, AP3, AP4, AT);
    end;

    /// On a quadratic Bezier piece. C: GetSplinePointBezierQuadratic
    /// @param AStart the start
    /// @param AControl the control
    /// @param AEnd the end
    /// @param AT how far along, 0 to 1
    /// @returns the point `AT` of the way along the piece
    static method BezierQuadratic(const AStart: Vector2; const AControl: Vector2;
      const AEnd: Vector2; const AT: float32): Vector2;
    begin
      return GetSplinePointBezierQuadratic(AStart, AControl, AEnd, AT);
    end;

    /// On a cubic Bezier piece. C: GetSplinePointBezierCubic
    /// @param AStart the start
    /// @param AControl1 the first control point
    /// @param AControl2 the second control point
    /// @param AEnd the end
    /// @param AT how far along, 0 to 1
    /// @returns the point `AT` of the way along the piece
    static method BezierCubic(const AStart: Vector2; const AControl1: Vector2;
      const AControl2: Vector2; const AEnd: Vector2; const AT: float32): Vector2;
    begin
      return GetSplinePointBezierCubic(AStart, AControl1, AControl2, AEnd, AT);
    end;
  end;

// ============================================================================
// rlgl (sec 8): raylib's low-level GL layer as the static GL, each routine
// rlgl's own name without its rl prefix (rlglInit / rlglClose are Init /
// Close), in Adam types: Matrix, Vector2 / 3, Color, choices for its enums
// and GL constants. rlgl's groups raylib shares reuse this layer's choices
// (Blend, Pixel, UniformType, AttribType: one name per job); the rest are
// GL*. Low-level by nature: ids are GL object numbers, buffers plain
// pointers, and nothing made here is released for the program.
// ============================================================================

public type
  /// The GL raylib runs on, rlgl's `rlGlVersion` values.
  GLVersion = choices(
    Software,     /// Software rendering. C: RL_OPENGL_SOFTWARE
    OpenGL11,     /// OpenGL 1.1. C: RL_OPENGL_11
    OpenGL21,     /// OpenGL 2.1 (GLSL 120). C: RL_OPENGL_21
    OpenGL33,     /// OpenGL 3.3 (GLSL 330). C: RL_OPENGL_33
    OpenGL43,     /// OpenGL 4.3 (using GLSL 330). C: RL_OPENGL_43
    OpenGLES20,   /// OpenGL ES 2.0 (GLSL 100). C: RL_OPENGL_ES_20
    OpenGLES30);  /// OpenGL ES 3.0 (GLSL 300 es). C: RL_OPENGL_ES_30

  /// The faces culled, rlgl's `rlCullMode` values.
  GLCull = choices(
    Front,  /// The front faces. C: RL_CULL_FACE_FRONT
    Back);  /// The back faces. C: RL_CULL_FACE_BACK

  /// A framebuffer attachment point, rlgl's `rlFramebufferAttachType` values.
  GLAttachType = choices(
    Color0,          /// Framebuffer attachment type: color 0. C: RL_ATTACHMENT_COLOR_CHANNEL0
    Color1,          /// Framebuffer attachment type: color 1. C: RL_ATTACHMENT_COLOR_CHANNEL1
    Color2,          /// Framebuffer attachment type: color 2. C: RL_ATTACHMENT_COLOR_CHANNEL2
    Color3,          /// Framebuffer attachment type: color 3. C: RL_ATTACHMENT_COLOR_CHANNEL3
    Color4,          /// Framebuffer attachment type: color 4. C: RL_ATTACHMENT_COLOR_CHANNEL4
    Color5,          /// Framebuffer attachment type: color 5. C: RL_ATTACHMENT_COLOR_CHANNEL5
    Color6,          /// Framebuffer attachment type: color 6. C: RL_ATTACHMENT_COLOR_CHANNEL6
    Color7,          /// Framebuffer attachment type: color 7. C: RL_ATTACHMENT_COLOR_CHANNEL7
    Depth = 100,     /// Framebuffer attachment type: depth. C: RL_ATTACHMENT_DEPTH
    Stencil = 200);  /// Framebuffer attachment type: stencil. C: RL_ATTACHMENT_STENCIL

  /// What a framebuffer attachment is, rlgl's `rlFramebufferAttachTextureType` values.
  GLAttachTextureType = choices(
    CubemapPositiveX,     /// Framebuffer texture attachment type: cubemap, +X side. C: RL_ATTACHMENT_CUBEMAP_POSITIVE_X
    CubemapNegativeX,     /// Framebuffer texture attachment type: cubemap, -X side. C: RL_ATTACHMENT_CUBEMAP_NEGATIVE_X
    CubemapPositiveY,     /// Framebuffer texture attachment type: cubemap, +Y side. C: RL_ATTACHMENT_CUBEMAP_POSITIVE_Y
    CubemapNegativeY,     /// Framebuffer texture attachment type: cubemap, -Y side. C: RL_ATTACHMENT_CUBEMAP_NEGATIVE_Y
    CubemapPositiveZ,     /// Framebuffer texture attachment type: cubemap, +Z side. C: RL_ATTACHMENT_CUBEMAP_POSITIVE_Z
    CubemapNegativeZ,     /// Framebuffer texture attachment type: cubemap, -Z side. C: RL_ATTACHMENT_CUBEMAP_NEGATIVE_Z
    Texture2D = 100,      /// Framebuffer texture attachment type: texture2d. C: RL_ATTACHMENT_TEXTURE2D
    RenderBuffer = 200);  /// Framebuffer texture attachment type: renderbuffer. C: RL_ATTACHMENT_RENDERBUFFER

  /// The matrix stack GL's transforms change (RL_MODELVIEW, RL_PROJECTION, RL_TEXTURE).
  GLMatrix = choices(
    Modelview = 5888,  /// The modelview matrix (`GL_MODELVIEW`). C: RL_MODELVIEW
    Projection,        /// The projection matrix (`GL_PROJECTION`). C: RL_PROJECTION
    Texture);          /// The texture matrix (`GL_TEXTURE`). C: RL_TEXTURE

  /// The primitives GL.Begin draws (RL_LINES, RL_TRIANGLES, RL_QUADS).
  GLMode = choices(
    Lines = 1,      /// Lines (`GL_LINES`). C: RL_LINES
    Triangles = 4,  /// Triangles (`GL_TRIANGLES`). C: RL_TRIANGLES
    Quads = 7);     /// Quads (`GL_QUADS`). C: RL_QUADS

  /// A shader stage (RL_FRAGMENT_SHADER, RL_VERTEX_SHADER, RL_COMPUTE_SHADER).
  GLShaderType = choices(
    Fragment = 35632,  /// The fragment stage (`GL_FRAGMENT_SHADER`). C: RL_FRAGMENT_SHADER
    Vertex,            /// The vertex stage (`GL_VERTEX_SHADER`). C: RL_VERTEX_SHADER
    Compute = 37305);  /// The compute stage (`GL_COMPUTE_SHADER`). C: RL_COMPUTE_SHADER

  /// A GPU buffer's usage hint (RL_STREAM_DRAW ..).
  GLUsage = choices(
    StreamDraw = 35040,   /// Stream draw use (`GL_STREAM_DRAW`). C: RL_STREAM_DRAW
    StreamRead,           /// Stream read use (`GL_STREAM_READ`). C: RL_STREAM_READ
    StreamCopy,           /// Stream copy use (`GL_STREAM_COPY`). C: RL_STREAM_COPY
    StaticDraw = 35044,   /// Static draw use (`GL_STATIC_DRAW`). C: RL_STATIC_DRAW
    StaticRead,           /// Static read use (`GL_STATIC_READ`). C: RL_STATIC_READ
    StaticCopy,           /// Static copy use (`GL_STATIC_COPY`). C: RL_STATIC_COPY
    DynamicDraw = 35048,  /// Dynamic draw use (`GL_DYNAMIC_DRAW`). C: RL_DYNAMIC_DRAW
    DynamicRead,          /// Dynamic read use (`GL_DYNAMIC_READ`). C: RL_DYNAMIC_READ
    DynamicCopy);         /// Dynamic copy use (`GL_DYNAMIC_COPY`). C: RL_DYNAMIC_COPY

  /// A vertex attribute's component type (RL_UNSIGNED_BYTE, RL_FLOAT).
  GLDataType = choices(
    UnsignedByte = 5121,  /// Unsigned byte components (`GL_UNSIGNED_BYTE`). C: RL_UNSIGNED_BYTE
    Float = 5126);        /// Float components (`GL_FLOAT`). C: RL_FLOAT

  /// A texture parameter GL.TextureParameters / CubemapParameters sets
  /// (RL_TEXTURE_MAG_FILTER ..).
  GLTexParam = choices(
    MagFilter = 10240,         /// The mag filter parameter (`GL_TEXTURE_MAG_FILTER`). C: RL_TEXTURE_MAG_FILTER
    MinFilter,                 /// The min filter parameter (`GL_TEXTURE_MIN_FILTER`). C: RL_TEXTURE_MIN_FILTER
    WrapS,                     /// The wrap S parameter (`GL_TEXTURE_WRAP_S`). C: RL_TEXTURE_WRAP_S
    WrapT,                     /// The wrap T parameter (`GL_TEXTURE_WRAP_T`). C: RL_TEXTURE_WRAP_T
    Anisotropic = 12288,       /// Anisotropic filter (custom identifier). C: RL_TEXTURE_FILTER_ANISOTROPIC
    MipmapBiasRatio = 16384);  /// Texture mipmap bias, percentage ratio (custom identifier). C: RL_TEXTURE_MIPMAP_BIAS_RATIO

  /// A GL texture filter for MagFilter / MinFilter (RL_TEXTURE_FILTER_NEAREST ..).
  GLTexFilter = choices(
    Nearest = 9728,     /// Nearest filtering (`GL_NEAREST`). C: RL_TEXTURE_FILTER_NEAREST
    Linear,             /// Linear filtering (`GL_LINEAR`). C: RL_TEXTURE_FILTER_LINEAR
    MipNearest = 9984,  /// Mip nearest filtering (`GL_NEAREST_MIPMAP_NEAREST`). C: RL_TEXTURE_FILTER_MIP_NEAREST
    LinearMipNearest,   /// Linear mip nearest filtering (`GL_LINEAR_MIPMAP_NEAREST`). C: RL_TEXTURE_FILTER_LINEAR_MIP_NEAREST
    NearestMipLinear,   /// Nearest mip linear filtering (`GL_NEAREST_MIPMAP_LINEAR`). C: RL_TEXTURE_FILTER_NEAREST_MIP_LINEAR
    MipLinear);         /// Mip linear filtering (`GL_LINEAR_MIPMAP_LINEAR`). C: RL_TEXTURE_FILTER_MIP_LINEAR

  /// A GL texture wrap for WrapS / WrapT (RL_TEXTURE_WRAP_REPEAT ..).
  GLTexWrap = choices(
    Repeat = 10497,        /// Repeat wrapping (`GL_REPEAT`). C: RL_TEXTURE_WRAP_REPEAT
    Clamp = 33071,         /// Clamp wrapping (`GL_CLAMP_TO_EDGE`). C: RL_TEXTURE_WRAP_CLAMP
    MirrorRepeat = 33648,  /// Mirror repeat wrapping (`GL_MIRRORED_REPEAT`). C: RL_TEXTURE_WRAP_MIRROR_REPEAT
    MirrorClamp = 34626);  /// Mirror clamp wrapping (`GL_MIRROR_CLAMP_EXT`). C: RL_TEXTURE_WRAP_MIRROR_CLAMP

  /// A blend factor (RL_ZERO, RL_ONE, RL_SRC_COLOR ..).
  GLBlendFactor = choices(
    Zero,                    /// The zero factor (`GL_ZERO`). C: RL_ZERO
    One,                     /// The one factor (`GL_ONE`). C: RL_ONE
    SrcColor = 768,          /// The src color factor (`GL_SRC_COLOR`). C: RL_SRC_COLOR
    OneMinusSrcColor,        /// The one minus src color factor (`GL_ONE_MINUS_SRC_COLOR`). C: RL_ONE_MINUS_SRC_COLOR
    SrcAlpha,                /// The src alpha factor (`GL_SRC_ALPHA`). C: RL_SRC_ALPHA
    OneMinusSrcAlpha,        /// The one minus src alpha factor (`GL_ONE_MINUS_SRC_ALPHA`). C: RL_ONE_MINUS_SRC_ALPHA
    DstAlpha,                /// The dst alpha factor (`GL_DST_ALPHA`). C: RL_DST_ALPHA
    OneMinusDstAlpha,        /// The one minus dst alpha factor (`GL_ONE_MINUS_DST_ALPHA`). C: RL_ONE_MINUS_DST_ALPHA
    DstColor,                /// The dst color factor (`GL_DST_COLOR`). C: RL_DST_COLOR
    OneMinusDstColor,        /// The one minus dst color factor (`GL_ONE_MINUS_DST_COLOR`). C: RL_ONE_MINUS_DST_COLOR
    SrcAlphaSaturate,        /// The src alpha saturate factor (`GL_SRC_ALPHA_SATURATE`). C: RL_SRC_ALPHA_SATURATE
    ConstantColor = 32769,   /// The constant color factor (`GL_CONSTANT_COLOR`). C: RL_CONSTANT_COLOR
    OneMinusConstantColor,   /// The one minus constant color factor (`GL_ONE_MINUS_CONSTANT_COLOR`). C: RL_ONE_MINUS_CONSTANT_COLOR
    ConstantAlpha,           /// The constant alpha factor (`GL_CONSTANT_ALPHA`). C: RL_CONSTANT_ALPHA
    OneMinusConstantAlpha);  /// The one minus constant alpha factor (`GL_ONE_MINUS_CONSTANT_ALPHA`). C: RL_ONE_MINUS_CONSTANT_ALPHA

  /// A blend equation (RL_FUNC_ADD, RL_MIN, RL_MAX, RL_FUNC_SUBTRACT, RL_FUNC_REVERSE_SUBTRACT).
  GLBlendEquation = choices(
    Add = 32774,       /// The add equation (`GL_FUNC_ADD`). C: RL_FUNC_ADD
    Min,               /// The min equation (`GL_MIN`). C: RL_MIN
    Max,               /// The max equation (`GL_MAX`). C: RL_MAX
    Subtract = 32778,  /// The subtract equation (`GL_FUNC_SUBTRACT`). C: RL_FUNC_SUBTRACT
    ReverseSubtract);  /// The reverse subtract equation (`GL_FUNC_REVERSE_SUBTRACT`). C: RL_FUNC_REVERSE_SUBTRACT

  /// A framebuffer binding target (RL_READ_FRAMEBUFFER, RL_DRAW_FRAMEBUFFER).
  GLFramebufferTarget = choices(
    Read = 36008,  /// The read target (`GL_READ_FRAMEBUFFER`). C: RL_READ_FRAMEBUFFER
    Draw);         /// The draw target (`GL_DRAW_FRAMEBUFFER`). C: RL_DRAW_FRAMEBUFFER

  /// rlgl, raylib's GL layer: the matrix stack, immediate-mode vertices, GL state, render
  /// batches, vertex buffers and arrays, textures, framebuffers, shaders and compute.
  /// @example `GL.PushMatrix(); GL.Translate(10.0f, 0.0f, 0.0f); GL.Begin(GLMode.Quads); GL.Color(RED); GL.Vertex(LCorner); GL.End(); GL.PopMatrix();`
  GL = object
    // ---- the matrix stack ----

    /// The stack the transforms change. C: rlMatrixMode
    /// @param AMode the mode
    static method MatrixMode(const AMode: GLMatrix);
    begin
      rlMatrixMode(int32(AMode));
    end;

    /// Saves the current matrix on the stack. C: rlPushMatrix
    static method PushMatrix();
    begin
      rlPushMatrix();
    end;

    /// Restores the matrix saved last. C: rlPopMatrix
    static method PopMatrix();
    begin
      rlPopMatrix();
    end;

    /// The current matrix becomes the identity. C: rlLoadIdentity
    static method LoadIdentity();
    begin
      rlLoadIdentity();
    end;

    /// Moves by (`AX`, `AY`, `AZ`). C: rlTranslatef
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    /// @param AZ the z coordinate
    static method Translate(const AX: float32; const AY: float32; const AZ: float32);
    begin
      rlTranslatef(AX, AY, AZ);
    end;

    /// Turns `AAngle` degrees about the axis (`AX`, `AY`, `AZ`). C: rlRotatef
    /// @param AAngle the angle
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    /// @param AZ the z coordinate
    static method Rotate(const AAngle: float32; const AX: float32; const AY: float32;
      const AZ: float32);
    begin
      rlRotatef(AAngle, AX, AY, AZ);
    end;

    /// Scales by (`AX`, `AY`, `AZ`). C: rlScalef
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    /// @param AZ the z coordinate
    static method Scale(const AX: float32; const AY: float32; const AZ: float32);
    begin
      rlScalef(AX, AY, AZ);
    end;

    /// Multiplies the current matrix by `AMatrix`. C: rlMultMatrixf
    /// @param AMatrix the matrix
    static method MultMatrix(const AMatrix: Matrix);
    var
      LValues: array[0..15] of float32;
    begin
      // rlgl takes the 16 floats column-major, as raymath's MatrixToFloatV gives them
      LValues := AMatrix.ToArray();
      rlMultMatrixf(addr of LValues[0]);
    end;

    /// A perspective projection by its clip planes. C: rlFrustum
    /// @param ALeft the left of the view volume
    /// @param ARight the right of the view volume
    /// @param ABottom the bottom of the view volume
    /// @param ATop the top of the view volume
    /// @param ANear the near clip distance
    /// @param AFar the far clip distance
    static method Frustum(const ALeft: float64; const ARight: float64; const ABottom: float64;
      const ATop: float64; const ANear: float64; const AFar: float64);
    begin
      rlFrustum(ALeft, ARight, ABottom, ATop, ANear, AFar);
    end;

    /// An orthographic projection by its clip planes. C: rlOrtho
    /// @param ALeft the left of the view volume
    /// @param ARight the right of the view volume
    /// @param ABottom the bottom of the view volume
    /// @param ATop the top of the view volume
    /// @param ANear the near clip distance
    /// @param AFar the far clip distance
    static method Ortho(const ALeft: float64; const ARight: float64; const ABottom: float64;
      const ATop: float64; const ANear: float64; const AFar: float64);
    begin
      rlOrtho(ALeft, ARight, ABottom, ATop, ANear, AFar);
    end;

    /// The viewport, in framebuffer pixels. C: rlViewport
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    /// @param AWidth the width
    /// @param AHeight the height
    static method Viewport(const AX: int32; const AY: int32; const AWidth: int32;
      const AHeight: int32);
    begin
      rlViewport(AX, AY, AWidth, AHeight);
    end;

    /// The near / far clip planes raylib's 3D modes project with. C: rlSetClipPlanes
    /// @param ANear the near clip distance
    /// @param AFar the far clip distance
    static method SetClipPlanes(const ANear: float64; const AFar: float64);
    begin
      rlSetClipPlanes(ANear, AFar);
    end;

    /// The near clip plane. C: rlGetCullDistanceNear
    /// @returns the near clip plane
    static method GetCullDistanceNear(): float64;
    begin
      return rlGetCullDistanceNear();
    end;

    /// The far clip plane. C: rlGetCullDistanceFar
    /// @returns the far clip plane
    static method GetCullDistanceFar(): float64;
    begin
      return rlGetCullDistanceFar();
    end;

    // ---- immediate-mode vertices ----

    /// Starts a primitive run: the vertices up to End make `AMode`'s shapes. C: rlBegin
    /// @param AMode the mode
    static method Begin(const AMode: GLMode);
    begin
      rlBegin(int32(AMode));
    end;

    /// Ends Begin's run. C: rlEnd
    static method End();
    begin
      rlEnd();
    end;

    /// A vertex at whole (`AX`, `AY`). C: rlVertex2i
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    static method Vertex(const AX: int32; const AY: int32);
    begin
      rlVertex2i(AX, AY);
    end;

    /// A vertex at (`AX`, `AY`). C: rlVertex2f
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    static method Vertex(const AX: float32; const AY: float32);
    begin
      rlVertex2f(AX, AY);
    end;

    /// A vertex at (`AX`, `AY`, `AZ`). C: rlVertex3f
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    /// @param AZ the z coordinate
    static method Vertex(const AX: float32; const AY: float32; const AZ: float32);
    begin
      rlVertex3f(AX, AY, AZ);
    end;

    /// A vertex at `APoint`. C: rlVertex2f
    /// @param APoint the point
    static method Vertex(const APoint: Vector2);
    begin
      rlVertex2f(APoint.x, APoint.y);
    end;

    /// A vertex at `APoint`. C: rlVertex3f
    /// @param APoint the point
    static method Vertex(const APoint: Vector3);
    begin
      rlVertex3f(APoint.x, APoint.y, APoint.z);
    end;

    /// The next vertices' texture coordinate. C: rlTexCoord2f
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    static method TexCoord(const AX: float32; const AY: float32);
    begin
      rlTexCoord2f(AX, AY);
    end;

    /// The next vertices' texture coordinate. C: rlTexCoord2f
    /// @param ACoord the coord
    static method TexCoord(const ACoord: Vector2);
    begin
      rlTexCoord2f(ACoord.x, ACoord.y);
    end;

    /// The next vertices' normal. C: rlNormal3f
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    /// @param AZ the z coordinate
    static method Normal(const AX: float32; const AY: float32; const AZ: float32);
    begin
      rlNormal3f(AX, AY, AZ);
    end;

    /// The next vertices' normal. C: rlNormal3f
    /// @param ANormal the normal
    static method Normal(const ANormal: Vector3);
    begin
      rlNormal3f(ANormal.x, ANormal.y, ANormal.z);
    end;

    /// The next vertices' color. C: rlColor4ub
    /// @param AColor the colour
    static method Color(const AColor: Color);
    begin
      rlColor4ub(AColor.r, AColor.g, AColor.b, AColor.a);
    end;

    /// The next vertices' color, opaque, its parts 0 to 1. C: rlColor3f
    /// @param AR the red part, 0 to 1
    /// @param AG the green part, 0 to 1
    /// @param AB the blue part, 0 to 1
    static method Color(const AR: float32; const AG: float32; const AB: float32);
    begin
      rlColor3f(AR, AG, AB);
    end;

    /// The next vertices' color, its parts 0 to 1. C: rlColor4f
    /// @param AR the red part, 0 to 1
    /// @param AG the green part, 0 to 1
    /// @param AB the blue part, 0 to 1
    /// @param AA the alpha part, 0 to 1
    static method Color(const AR: float32; const AG: float32; const AB: float32;
      const AA: float32);
    begin
      rlColor4f(AR, AG, AB, AA);
    end;

    // ---- vertex arrays, buffers and attributes ----

    /// Binds the vertex array `AVaoId`; false when vertex arrays are not supported.
    /// C: rlEnableVertexArray
    /// @param AVaoId the vao id
    /// @returns `true` when it was bound
    static method EnableVertexArray(const AVaoId: uint32): bool;
    begin
      return rlEnableVertexArray(AVaoId);
    end;

    /// Unbinds the vertex array. C: rlDisableVertexArray
    static method DisableVertexArray();
    begin
      rlDisableVertexArray();
    end;

    /// Binds the vertex buffer `AId`. C: rlEnableVertexBuffer
    /// @param AId the id
    static method EnableVertexBuffer(const AId: uint32);
    begin
      rlEnableVertexBuffer(AId);
    end;

    /// Unbinds the vertex buffer. C: rlDisableVertexBuffer
    static method DisableVertexBuffer();
    begin
      rlDisableVertexBuffer();
    end;

    /// Binds the element (index) buffer `AId`. C: rlEnableVertexBufferElement
    /// @param AId the id
    static method EnableVertexBufferElement(const AId: uint32);
    begin
      rlEnableVertexBufferElement(AId);
    end;

    /// Unbinds the element (index) buffer. C: rlDisableVertexBufferElement
    static method DisableVertexBufferElement();
    begin
      rlDisableVertexBufferElement();
    end;

    /// Turns the vertex attribute `AIndex` on. C: rlEnableVertexAttribute
    /// @param AIndex the index, from 0
    static method EnableVertexAttribute(const AIndex: uint32);
    begin
      rlEnableVertexAttribute(AIndex);
    end;

    /// Turns the vertex attribute `AIndex` off. C: rlDisableVertexAttribute
    /// @param AIndex the index, from 0
    static method DisableVertexAttribute(const AIndex: uint32);
    begin
      rlDisableVertexAttribute(AIndex);
    end;

    /// GL 1.1's client state array `AAttribType` (GL_VERTEX_ARRAY ..) reading `ABuffer`.
    /// C: rlEnableStatePointer
    /// @param AAttribType the attrib type
    /// @param ABuffer the buffer
    static method EnableStatePointer(const AAttribType: int32; const ABuffer: ptr);
    begin
      rlEnableStatePointer(AAttribType, ABuffer);
    end;

    /// Turns a client state array off (OpenGL 1.1). C: rlDisableStatePointer
    /// @param AAttribType the array's attribute type
    static method DisableStatePointer(const AAttribType: int32);
    begin
      rlDisableStatePointer(AAttribType);
    end;

    /// A new vertex array's id (0 when not supported). C: rlLoadVertexArray
    /// @returns a new vertex array's id (0 when not supported)
    static method LoadVertexArray(): uint32;
    begin
      return rlLoadVertexArray();
    end;

    /// A new vertex buffer holding `ASize` bytes from `ABuffer` (nil: room only).
    /// C: rlLoadVertexBuffer
    /// @param ABuffer the buffer
    /// @param ASize the size
    /// @param ADynamic `true` for a buffer meant to be updated
    /// @returns a new vertex buffer holding `ASize` bytes from `ABuffer` (nil: room only)
    static method LoadVertexBuffer(const ABuffer: ptr to const; const ASize: int32;
      const ADynamic: bool): uint32;
    begin
      return rlLoadVertexBuffer(ABuffer, ASize, ADynamic);
    end;

    /// A new element (index) buffer holding `ASize` bytes from `ABuffer`.
    /// C: rlLoadVertexBufferElement
    /// @param ABuffer the buffer
    /// @param ASize the size
    /// @param ADynamic `true` for a buffer meant to be updated
    /// @returns a new element (index) buffer holding `ASize` bytes from `ABuffer`
    static method LoadVertexBufferElement(const ABuffer: ptr to const; const ASize: int32;
      const ADynamic: bool): uint32;
    begin
      return rlLoadVertexBufferElement(ABuffer, ASize, ADynamic);
    end;

    /// Writes `ADataSize` bytes from `AData` into the vertex buffer `AId` at byte `AOffset`.
    /// C: rlUpdateVertexBuffer
    /// @param AId the id
    /// @param AData the data
    /// @param ADataSize the data size
    /// @param AOffset the offset
    static method UpdateVertexBuffer(const AId: uint32; const AData: ptr to const;
      const ADataSize: int32; const AOffset: int32);
    begin
      rlUpdateVertexBuffer(AId, AData, ADataSize, AOffset);
    end;

    /// Writes `ADataSize` bytes from `AData` into the element buffer `AId` at byte `AOffset`.
    /// C: rlUpdateVertexBufferElements
    /// @param AId the id
    /// @param AData the data
    /// @param ADataSize the data size
    /// @param AOffset the offset
    static method UpdateVertexBufferElements(const AId: uint32; const AData: ptr to const;
      const ADataSize: int32; const AOffset: int32);
    begin
      rlUpdateVertexBufferElements(AId, AData, ADataSize, AOffset);
    end;

    /// Deletes the vertex array `AVaoId`. C: rlUnloadVertexArray
    /// @param AVaoId the vertex array's id
    static method UnloadVertexArray(const AVaoId: uint32);
    begin
      rlUnloadVertexArray(AVaoId);
    end;

    /// Deletes the vertex buffer `AVboId`. C: rlUnloadVertexBuffer
    /// @param AVboId the buffer's id
    static method UnloadVertexBuffer(const AVboId: uint32);
    begin
      rlUnloadVertexBuffer(AVboId);
    end;

    /// Attribute `AIndex` reads `ACompSize` components of `AType` per vertex, `AStride`
    /// bytes apart, from byte `AOffset` of the bound buffer. C: rlSetVertexAttribute
    /// @param AIndex the index, from 0
    /// @param ACompSize the comp size
    /// @param AType the type
    /// @param ANormalized the normalized
    /// @param AStride the stride
    /// @param AOffset the offset
    static method SetVertexAttribute(const AIndex: uint32; const ACompSize: int32;
      const AType: GLDataType; const ANormalized: bool; const AStride: int32;
      const AOffset: int32);
    begin
      rlSetVertexAttribute(AIndex, ACompSize, int32(AType), ANormalized, AStride, AOffset);
    end;

    /// Attribute `AIndex` advances once per `ADivisor` instances (0: per vertex).
    /// C: rlSetVertexAttributeDivisor
    /// @param AIndex the index, from 0
    /// @param ADivisor the divisor
    static method SetVertexAttributeDivisor(const AIndex: uint32; const ADivisor: int32);
    begin
      rlSetVertexAttributeDivisor(AIndex, ADivisor);
    end;

    /// The value attribute location `ALocIndex` takes when no buffer feeds it.
    /// C: rlSetVertexAttributeDefault
    /// @param ALocIndex the shader location
    /// @param AValue the value
    /// @param AType the type
    /// @param ACount how many
    static method SetVertexAttributeDefault(const ALocIndex: int32; const AValue: ptr to const;
      const AType: AttribType; const ACount: int32);
    begin
      rlSetVertexAttributeDefault(ALocIndex, AValue, int32(AType), ACount);
    end;

    /// Draws `ACount` vertices of the bound array from `AOffset`. C: rlDrawVertexArray
    /// @param AOffset the offset
    /// @param ACount how many
    static method DrawVertexArray(const AOffset: int32; const ACount: int32);
    begin
      rlDrawVertexArray(AOffset, ACount);
    end;

    /// Draws `ACount` indexed vertices from `AOffset` (`ABuffer`: the indices, nil for the
    /// bound element buffer). C: rlDrawVertexArrayElements
    /// @param AOffset the offset
    /// @param ACount how many
    /// @param ABuffer the buffer
    static method DrawVertexArrayElements(const AOffset: int32; const ACount: int32;
      const ABuffer: ptr to const);
    begin
      rlDrawVertexArrayElements(AOffset, ACount, ABuffer);
    end;

    /// Draws `AInstances` copies of `ACount` vertices from `AOffset`.
    /// C: rlDrawVertexArrayInstanced
    /// @param AOffset the offset
    /// @param ACount how many
    /// @param AInstances the instances
    static method DrawVertexArrayInstanced(const AOffset: int32; const ACount: int32;
      const AInstances: int32);
    begin
      rlDrawVertexArrayInstanced(AOffset, ACount, AInstances);
    end;

    /// Draws `AInstances` copies of `ACount` indexed vertices from `AOffset`.
    /// C: rlDrawVertexArrayElementsInstanced
    /// @param AOffset the offset
    /// @param ACount how many
    /// @param ABuffer the buffer
    /// @param AInstances the instances
    static method DrawVertexArrayElementsInstanced(const AOffset: int32; const ACount: int32;
      const ABuffer: ptr to const; const AInstances: int32);
    begin
      rlDrawVertexArrayElementsInstanced(AOffset, ACount, ABuffer, AInstances);
    end;

    // ---- textures ----

    /// The texture unit the next texture binds go to. C: rlActiveTextureSlot
    /// @param ASlot the slot
    static method ActiveTextureSlot(const ASlot: int32);
    begin
      rlActiveTextureSlot(ASlot);
    end;

    /// Binds the texture `AId`. C: rlEnableTexture
    /// @param AId the id
    static method EnableTexture(const AId: uint32);
    begin
      rlEnableTexture(AId);
    end;

    /// Unbinds the 2D texture. C: rlDisableTexture
    static method DisableTexture();
    begin
      rlDisableTexture();
    end;

    /// Binds the cubemap `AId`. C: rlEnableTextureCubemap
    /// @param AId the id
    static method EnableTextureCubemap(const AId: uint32);
    begin
