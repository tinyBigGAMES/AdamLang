    /// @param ARect the rectangle
    /// @param ARoundness the roundness
    /// @param ASegments how many segments
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method RectRoundedLines(const ARect: Rectangle; const ARoundness: float32;
