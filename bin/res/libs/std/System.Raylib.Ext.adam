  ImageRes = object
    hidden FHold: ref ImageHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing), as a
    /// variable declared with no arguments starts.
    init();
    begin
    end;

    // The image changed in place (nil when this value holds none)
    hidden method DoAt(): ptr to Image;
    begin
      if self.FHold = nil then
        return nil;
      end;
      return addr of self.FHold.FImage;
    end;

    /// Loads the image file at `APath` (from the mounted source). C: LoadImage
    /// @param APath the file's path
