    return QuaternionIdentity();
  end;

  /// Component-wise sum. C: Vector4Add
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise sum
  operator +(const A: Vector4; const B: Vector4): Vector4;
