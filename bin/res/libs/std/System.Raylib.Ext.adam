    var
      LColors: ptr to Color;
      LResultArray: array of Color;
      LCount: int32;
      LI: int64;
    begin
      setlength(LResultArray, 0);
      if not self.IsValid() then
        return LResultArray;
      end;
      LCount := 0;
      LColors := LoadImagePalette(self.Handle(), AMaxSize, addr of LCount);
      if LColors = nil then
        return LResultArray;
      end;
      setlength(LResultArray, int64(LCount));
      for LI := 0 to int64(LCount) - 1 do
