      const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawTriangle(self.DoAt(), AA, AB, AC, AColor);
      end;
      return self;
    end;

    /// A triangle shaded between its corners' colors. C: ImageDrawTriangleGradient
    /// @param AA the first corner
    /// @param AB the second corner
    /// @param AC the third corner
    /// @param AColorA the color A
    /// @param AColorB the color B
    /// @param AColorC the color C
    /// @returns this object, so calls chain
    method TriangleGradient(const AA: Vector2; const AB: Vector2; const AC: Vector2;
      const AColorA: Color; const AColorB: Color; const AColorC: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawTriangleGradient(self.DoAt(), AA, AB, AC, AColorA, AColorB, AColorC);
      end;
      return self;
    end;

    /// A triangle's edges. C: ImageDrawTriangleLines
    /// @param AA the first corner
    /// @param AB the second corner
    /// @param AC the third corner
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method TriangleLines(const AA: Vector2; const AB: Vector2; const AC: Vector2;
      const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawTriangleLines(self.DoAt(), AA, AB, AC, AColor);
      end;
      return self;
    end;

    /// A triangle fan (the first point its center). C: ImageDrawTriangleFan
    /// @param APoints the points
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method TriangleFan(const APoints: array of Vector2; const AColor: Color): self;
    begin
      if (self.FHold <> nil) and (len(APoints) > 0) then
        ImageDrawTriangleFan(self.DoAt(), addr of APoints[0], int32(len(APoints)), AColor);
      end;
      return self;
    end;

    /// A triangle strip. C: ImageDrawTriangleStrip
    /// @param APoints the points
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method TriangleStrip(const APoints: array of Vector2; const AColor: Color): self;
    begin
      if (self.FHold <> nil) and (len(APoints) > 0) then
        ImageDrawTriangleStrip(self.DoAt(), addr of APoints[0], int32(len(APoints)), AColor);
      end;
      return self;
    end;

    /// A filled rectangle. C: ImageDrawRectangle / ImageDrawRectangleV / ImageDrawRectangleRec
    /// @param ARect the rectangle
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method Rect(const ARect: Rectangle; const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawRectangleRec(self.DoAt(), ARect, AColor);
      end;
      return self;
    end;

    /// A filled rectangle turned `ARotation` degrees about `AOrigin` (from its corner).
    /// C: ImageDrawRectanglePro
    /// @param ARect the rectangle
    /// @param AOrigin the origin
    /// @param ARotation the rotation
    /// @param AColor the colour
    /// @returns this object, so calls chain
