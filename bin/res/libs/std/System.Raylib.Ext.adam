    end;

    // ---- drawing on the image (Draw's names; image pixels) ----

    /// Fills the image with `AColor`. C: ImageClearBackground
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method Clear(const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageClearBackground(self.DoAt(), AColor);
      end;
      return self;
    end;

    /// One pixel. C: ImageDrawPixel / ImageDrawPixelV
    /// @param APos the position
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method Pixel(const APos: Vector2; const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawPixelV(self.DoAt(), APos, AColor);
      end;
      return self;
    end;

    /// A one-pixel line. C: ImageDrawLine / ImageDrawLineV
    /// @param AStart the start
    /// @param AEnd the end
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method Line(const AStart: Vector2; const AEnd: Vector2; const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawLineV(self.DoAt(), AStart, AEnd, AColor);
