  /// The vector reflected off a surface of normal `ANormal`. C: Vector3Reflect
  /// @param ANormal the normal
  /// @returns the vector reflected off a surface of normal `ANormal`
  const method Reflect(const ANormal: Vector3): Vector3;
  begin
    return Vector3Reflect(self, ANormal);
