    /// @param AColor the colour
    static method CircleSectorLines(const ACenter: Vector2; const ARadius: float32;
      const AStartAngle: float32; const AEndAngle: float32; const ASegments: int32;
      const AThick: float32; const AColor: Color);
    begin
      DrawCircleSectorLinesEx(ACenter, ARadius, AStartAngle, AEndAngle, ASegments, AThick,
        AColor);
    end;

    /// A circle's outline. C: DrawCircleLines / DrawCircleLinesV
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AColor the colour
    static method CircleLines(const ACenter: Vector2; const ARadius: float32;
      const AColor: Color);
    begin
      DrawCircleLinesV(ACenter, ARadius, AColor);
    end;

    /// A circle's outline `AThick` wide. C: DrawCircleLinesEx
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method CircleLines(const ACenter: Vector2; const ARadius: float32;
      const AThick: float32; const AColor: Color);
    begin
      DrawCircleLinesEx(ACenter, ARadius, AThick, AColor);
    end;

    /// A filled ellipse. C: DrawEllipse / DrawEllipseV
    /// @param ACenter the centre
    /// @param ARadiusH the horizontal radius
    /// @param ARadiusV the vertical radius
    /// @param AColor the colour
    static method Ellipse(const ACenter: Vector2; const ARadiusH: float32;
      const ARadiusV: float32; const AColor: Color);
    begin
      DrawEllipseV(ACenter, ARadiusH, ARadiusV, AColor);
    end;

    /// An ellipse's outline. C: DrawEllipseLines / DrawEllipseLinesV
    /// @param ACenter the centre
    /// @param ARadiusH the horizontal radius
    /// @param ARadiusV the vertical radius
    /// @param AColor the colour
    static method EllipseLines(const ACenter: Vector2; const ARadiusH: float32;
      const ARadiusV: float32; const AColor: Color);
    begin
      DrawEllipseLinesV(ACenter, ARadiusH, ARadiusV, AColor);
    end;

    /// An ellipse's outline `AThick` wide. C: DrawEllipseLinesEx
    /// @param ACenter the centre
    /// @param ARadiusH the horizontal radius
    /// @param ARadiusV the vertical radius
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method EllipseLines(const ACenter: Vector2; const ARadiusH: float32;
