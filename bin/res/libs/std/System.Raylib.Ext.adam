  const method Refract(const ANormal: Vector2; const R: float32): Vector2;
  begin
    return Vector2Refract(self, ANormal, R);
  end;

  /// Component-wise minimum with `B`. C: Vector2Min
  /// @param B the other `Vector2`
  /// @returns the component-wise minimum with `B`
  const method Min(const B: Vector2): Vector2;
  begin
    return Vector2Min(self, B);
  end;

  /// Component-wise maximum with `B`. C: Vector2Max
  /// @param B the other `Vector2`
  /// @returns the component-wise maximum with `B`
  const method Max(const B: Vector2): Vector2;
  begin
    return Vector2Max(self, B);
  end;

