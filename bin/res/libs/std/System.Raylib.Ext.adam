    begin
      return rlLoadShaderProgramCompute(AComputeId);
    end;

    /// Unloads a compiled stage. C: rlUnloadShader
    /// @param AId the id
    static method UnloadShader(const AId: uint32);
    begin
      rlUnloadShader(AId);
    end;

    /// Deletes the shader program `AId`. C: rlUnloadShaderProgram
    /// @param AId the program's id
    static method UnloadShaderProgram(const AId: uint32);
    begin
      rlUnloadShaderProgram(AId);
    end;

    /// The location of the uniform `AName` in the program `AId` (-1: none).
    /// C: rlGetLocationUniform
    /// @param AId the id
    /// @param AName the name
    /// @returns the location of the uniform `AName` in the program `AId` (-1: none)
    static method GetLocationUniform(const AId: uint32; const AName: string): int32;
    begin
      return rlGetLocationUniform(AId, AName);
    end;

    /// The location of the attribute `AName` in the program `AId` (-1: none).
    /// C: rlGetLocationAttrib
    /// @param AId the id
    /// @param AName the name
    /// @returns the location of the attribute `AName` in the program `AId` (-1: none)
    static method GetLocationAttrib(const AId: uint32; const AName: string): int32;
    begin
      return rlGetLocationAttrib(AId, AName);
    end;

    /// Sets `ACount` elements of `AType` from `AValue` at location `ALocIndex` of the
    /// enabled program. C: rlSetUniform
    /// @param ALocIndex the shader location
    /// @param AValue the value
    /// @param AType the type
    /// @param ACount how many
    static method SetUniform(const ALocIndex: int32; const AValue: ptr to const;
      const AType: UniformType; const ACount: int32);
    begin
      rlSetUniform(ALocIndex, AValue, int32(AType), ACount);
    end;

    /// Sets the matrix uniform at `ALocIndex` of the enabled program. C: rlSetUniformMatrix
    /// @param ALocIndex the shader location
    /// @param AMatrix the matrix
    static method SetUniformMatrix(const ALocIndex: int32; const AMatrix: Matrix);
    begin
      rlSetUniformMatrix(ALocIndex, AMatrix);
    end;

    /// Sets the matrix array at location `ALocIndex`. C: rlSetUniformMatrices
    /// @param ALocIndex the shader location
    /// @param AMatrices the matrices
    static method SetUniformMatrices(const ALocIndex: int32; const AMatrices: array of Matrix);
    begin
      if len(AMatrices) = 0 then
        return;
      end;
      rlSetUniformMatrices(ALocIndex, addr of AMatrices[0], int32(len(AMatrices)));
    end;

    /// Binds the texture `ATextureId` to the sampler at location `ALocIndex`.
    /// C: rlSetUniformSampler
    /// @param ALocIndex the shader location
    /// @param ATextureId the texture id
    static method SetUniformSampler(const ALocIndex: int32; const ATextureId: uint32);
    begin
      rlSetUniformSampler(ALocIndex, ATextureId);
    end;

    /// The program (and its locations) raylib's batch draws with. C: rlSetShader
    /// @param AId the id
    /// @param ALocs the locs
    static method SetShader(const AId: uint32; const ALocs: ptr to int32);
    begin
      rlSetShader(AId, ALocs);
    end;

    /// Binds the program `AId`. C: rlEnableShader
    /// @param AId the id
    static method EnableShader(const AId: uint32);
    begin
      rlEnableShader(AId);
    end;

    /// Unbinds the shader program. C: rlDisableShader
    static method DisableShader();
    begin
      rlDisableShader();
    end;

    // ---- compute and shader storage buffers ----

    /// Runs the bound compute program over `AGroupX` x `AGroupY` x `AGroupZ` work groups.
    /// C: rlComputeShaderDispatch
    /// @param AGroupX the group X
    /// @param AGroupY the group Y
    /// @param AGroupZ the group Z
    static method ComputeShaderDispatch(const AGroupX: uint32; const AGroupY: uint32;
      const AGroupZ: uint32);
    begin
      rlComputeShaderDispatch(AGroupX, AGroupY, AGroupZ);
    end;

    /// A new shader storage buffer of `ASize` bytes from `AData` (nil: zeroed).
    /// C: rlLoadShaderBuffer
    /// @param ASize the size
    /// @param AData the data
    /// @param AUsage the usage
    /// @returns a new shader storage buffer of `ASize` bytes from `AData` (nil: zeroed)
    static method LoadShaderBuffer(const ASize: uint32; const AData: ptr to const;
      const AUsage: GLUsage): uint32;
    begin
      return rlLoadShaderBuffer(ASize, AData, int32(AUsage));
    end;

    /// Deletes the shader buffer `AId`. C: rlUnloadShaderBuffer
    /// @param AId the buffer's id
    static method UnloadShaderBuffer(const AId: uint32);
    begin
      rlUnloadShaderBuffer(AId);
    end;

    /// Writes `ASize` bytes from `AData` into the buffer `AId` at byte `AOffset`.
    /// C: rlUpdateShaderBuffer
    /// @param AId the id
    /// @param AData the data
    /// @param ASize the size
    /// @param AOffset the offset
    static method UpdateShaderBuffer(const AId: uint32; const AData: ptr to const;
      const ASize: uint32; const AOffset: uint32);
    begin
      rlUpdateShaderBuffer(AId, AData, ASize, AOffset);
    end;

    /// Binds the buffer `AId` to binding point `AIndex`. C: rlBindShaderBuffer
    /// @param AId the id
    /// @param AIndex the index, from 0
    static method BindShaderBuffer(const AId: uint32; const AIndex: uint32);
    begin
      rlBindShaderBuffer(AId, AIndex);
    end;

    /// Reads `ACount` bytes of the buffer `AId` from byte `AOffset` into `ADest`.
    /// C: rlReadShaderBuffer
    /// @param AId the id
    /// @param ADest where the bytes go
    /// @param ACount how many
    /// @param AOffset the offset
    static method ReadShaderBuffer(const AId: uint32; const ADest: ptr; const ACount: uint32;
      const AOffset: uint32);
    begin
      rlReadShaderBuffer(AId, ADest, ACount, AOffset);
    end;

    /// Copies `ACount` bytes between two buffers. C: rlCopyShaderBuffer
    /// @param ADestId the dest id
    /// @param ASrcId the src id
    /// @param ADestOffset the dest offset
    /// @param ASrcOffset the src offset
    /// @param ACount how many
    static method CopyShaderBuffer(const ADestId: uint32; const ASrcId: uint32;
      const ADestOffset: uint32; const ASrcOffset: uint32; const ACount: uint32);
    begin
      rlCopyShaderBuffer(ADestId, ASrcId, ADestOffset, ASrcOffset, ACount);
    end;

    /// The buffer `AId`'s size in bytes. C: rlGetShaderBufferSize
    /// @param AId the id
    /// @returns the buffer `AId`'s size in bytes
    static method GetShaderBufferSize(const AId: uint32): uint32;
    begin
      return rlGetShaderBufferSize(AId);
    end;

    /// Binds the texture `AId` as image unit `AIndex` for compute programs.
    /// C: rlBindImageTexture
    /// @param AId the id
    /// @param AIndex the index, from 0
    /// @param AFormat the pixel format
    /// @param AReadOnly the read only
    static method BindImageTexture(const AId: uint32; const AIndex: uint32;
      const AFormat: Pixel; const AReadOnly: bool);
    begin
      rlBindImageTexture(AId, AIndex, int32(AFormat), AReadOnly);
    end;

    // ---- matrices ----

    /// The modelview matrix. C: rlGetMatrixModelview
    /// @returns the modelview matrix
    static method GetMatrixModelview(): Matrix;
    begin
      return rlGetMatrixModelview();
    end;

    /// The projection matrix. C: rlGetMatrixProjection
    /// @returns the projection matrix
    static method GetMatrixProjection(): Matrix;
    begin
      return rlGetMatrixProjection();
    end;

    /// The current transform (the matrix Translate / Rotate / Scale build). C: rlGetMatrixTransform
    /// @returns the current transform (the matrix Translate / Rotate / Scale build)
    static method GetMatrixTransform(): Matrix;
    begin
      return rlGetMatrixTransform();
    end;

    /// Eye `AEye`'s projection in stereo rendering (0 left, 1 right).
    /// C: rlGetMatrixProjectionStereo
    /// @param AEye the eye, 0 (left) or 1 (right)
    /// @returns eye `AEye`'s projection in stereo rendering (0 left, 1 right)
    static method GetMatrixProjectionStereo(const AEye: int32): Matrix;
    begin
      return rlGetMatrixProjectionStereo(AEye);
    end;

    /// Eye `AEye`'s view offset in stereo rendering (0 left, 1 right).
    /// C: rlGetMatrixViewOffsetStereo
    /// @param AEye the eye, 0 (left) or 1 (right)
    /// @returns eye `AEye`'s view offset in stereo rendering (0 left, 1 right)
    static method GetMatrixViewOffsetStereo(const AEye: int32): Matrix;
    begin
      return rlGetMatrixViewOffsetStereo(AEye);
    end;

    /// Sets the projection matrix. C: rlSetMatrixProjection
    /// @param AProjection the projection matrix
    static method SetMatrixProjection(const AProjection: Matrix);
    begin
      rlSetMatrixProjection(AProjection);
    end;

    /// Sets the modelview matrix. C: rlSetMatrixModelview
    /// @param AView the view matrix
    static method SetMatrixModelview(const AView: Matrix);
    begin
      rlSetMatrixModelview(AView);
    end;

    /// The stereo pair's projections. C: rlSetMatrixProjectionStereo
    /// @param ARight the right eye's matrix
    /// @param ALeft the left eye's matrix
    static method SetMatrixProjectionStereo(const ARight: Matrix; const ALeft: Matrix);
    begin
      rlSetMatrixProjectionStereo(ARight, ALeft);
    end;

    /// The stereo pair's view offsets. C: rlSetMatrixViewOffsetStereo
    /// @param ARight the right eye's matrix
    /// @param ALeft the left eye's matrix
    static method SetMatrixViewOffsetStereo(const ARight: Matrix; const ALeft: Matrix);
    begin
      rlSetMatrixViewOffsetStereo(ARight, ALeft);
    end;

    // ---- quick shapes ----

    /// Draws a unit cube (raylib's skybox and cubemap work). C: rlLoadDrawCube
    static method LoadDrawCube();
    begin
      rlLoadDrawCube();
    end;

    /// Draws a full-viewport quad (raylib's post-processing work). C: rlLoadDrawQuad
    static method LoadDrawQuad();
    begin
      rlLoadDrawQuad();
    end;
  end;

end.
