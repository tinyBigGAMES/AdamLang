  /// @param AAngle the angle in radians
  /// @returns the vector rotated by `AAngle` radians
  const method Rotate(const AAngle: float32): Vector2;
  begin
    return Vector2Rotate(self, AAngle);
  end;

  /// The point moved toward `ATarget` by at most `AMaxDistance`. C: Vector2MoveTowards
  /// @param ATarget where it moves to
  /// @param AMaxDistance the longest step
  /// @returns the point moved toward `ATarget` by at most `AMaxDistance`
  const method MoveTowards(const ATarget: Vector2; const AMaxDistance: float32): Vector2;
  begin
    return Vector2MoveTowards(self, ATarget, AMaxDistance);
  end;

