  /// @param ANormal the normal
  /// @param R the ratio of the refractive indices
  /// @returns the (normalized) vector refracted through a surface of normal `ANormal`, `R` the ratio of the refractive indices
  const method Refract(const ANormal: Vector3; const R: float32): Vector3;
  begin
    return Vector3Refract(self, ANormal, R);
  end;

  /// Component-wise minimum with `B`. C: Vector3Min
  /// @param B the other `Vector3`
  /// @returns the component-wise minimum with `B`
  const method Min(const B: Vector3): Vector3;
  begin
    return Vector3Min(self, B);
  end;

  /// Component-wise maximum with `B`. C: Vector3Max
  /// @param B the other `Vector3`
  /// @returns the component-wise maximum with `B`
  const method Max(const B: Vector3): Vector3;
  begin
    return Vector3Max(self, B);
  end;

  /// Each component clamped between `ALo`'s and `AHi`'s. C: Vector3Clamp
  /// @param ALo the lowest components
  /// @param AHi the highest components
  /// @returns each component clamped between `ALo`'s and `AHi`'s
  const method Clamp(const ALo: Vector3; const AHi: Vector3): Vector3;
  begin
    return Vector3Clamp(self, ALo, AHi);
