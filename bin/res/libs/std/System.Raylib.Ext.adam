  /// @param Q the rotation
  /// @returns the vector rotated by the quaternion `Q`
  const method RotateBy(const Q: Quaternion): Vector3;
  begin
    return Vector3RotateByQuaternion(self, Q);
  end;

  /// The vector rotated `AAngle` radians about `AAxis`. C: Vector3RotateByAxisAngle
  /// @param AAxis the axis
  /// @param AAngle the angle
  /// @returns the vector rotated `AAngle` radians about `AAxis`
  const method RotateBy(const AAxis: Vector3; const AAngle: float32): Vector3;
  begin
    return Vector3RotateByAxisAngle(self, AAxis, AAngle);
  end;

  /// The point moved toward `ATarget` by at most `AMaxDistance`. C: Vector3MoveTowards
  /// @param ATarget the target
  /// @param AMaxDistance the max distance
  /// @returns the point moved toward `ATarget` by at most `AMaxDistance`
  const method MoveTowards(const ATarget: Vector3; const AMaxDistance: float32): Vector3;
  begin
    return Vector3MoveTowards(self, ATarget, AMaxDistance);
