      const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawRectanglePro(self.DoAt(), ARect, AOrigin, ARotation, AColor);
      end;
      return self;
    end;

    /// A rectangle's one-pixel edges. C: ImageDrawRectangleLines
    /// @param ARect the rectangle
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method RectLines(const ARect: Rectangle; const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawRectangleLinesEx(self.DoAt(), ARect, 1, AColor);
      end;
      return self;
    end;

    /// A rectangle's edges `AThick` pixels wide. C: ImageDrawRectangleLinesEx
    /// @param ARect the rectangle
    /// @param AThick the line thickness
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method RectLines(const ARect: Rectangle; const AThick: int32; const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawRectangleLinesEx(self.DoAt(), ARect, AThick, AColor);
      end;
      return self;
    end;

    /// A rectangle shaded between its corners' colors. C: ImageDrawRectangleGradientEx
    /// @param ATopLeft the top-left corner's color, then bottom-left, bottom-right, top-right
