  /// @param ALo the low corner
  /// @param AHi the high corner
  /// @returns each component clamped between `ALo`'s and `AHi`'s
  const method Clamp(const ALo: Vector2; const AHi: Vector2): Vector2;
  begin
    return Vector2Clamp(self, ALo, AHi);
  end;

  /// The vector with its length clamped between `ALo` and `AHi`. C: Vector2ClampValue
  /// @param ALo the shortest length
  /// @param AHi the longest length
  /// @returns the vector with its length clamped between `ALo` and `AHi`
  const method Clamp(const ALo: float32; const AHi: float32): Vector2;
  begin
    return Vector2ClampValue(self, ALo, AHi);
  end;

  /// True when the point is inside `R`. C: CheckCollisionPointRec
  /// @param R the rectangle
  /// @returns `true` when the point is inside `R`
  const method In(const R: Rectangle): bool;
  begin
    return CheckCollisionPointRec(self, R);
  end;

  /// True when the point is inside the circle. C: CheckCollisionPointCircle
  /// @param ACenter the circle's centre
  /// @param ARadius its radius
  /// @returns `true` when the point is inside the circle
  const method InCircle(const ACenter: Vector2; const ARadius: float32): bool;
  begin
    return CheckCollisionPointCircle(self, ACenter, ARadius);
  end;

  /// True when the point is inside the triangle. C: CheckCollisionPointTriangle
  /// @param AP1 the first point
  /// @param AP2 the second point
  /// @param AP3 the third point
  /// @returns `true` when the point is inside the triangle
  const method InTriangle(const AP1: Vector2; const AP2: Vector2; const AP3: Vector2): bool;
  begin
    return CheckCollisionPointTriangle(self, AP1, AP2, AP3);
  end;

  /// True when the point is on the line from `AP1` to `AP2`, within `AThreshold` pixels.
  /// C: CheckCollisionPointLine
  /// @param AP1 the first point
  /// @param AP2 the second point
  /// @param AThreshold the threshold
  /// @returns `true` when the point is on the line from `AP1` to `AP2`, within `AThreshold` pixels
  const method OnLine(const AP1: Vector2; const AP2: Vector2; const AThreshold: int32): bool;
  begin
    return CheckCollisionPointLine(self, AP1, AP2, AThreshold);
  end;

  /// True when the point is inside the polygon `APoints` (false for an empty one).
  /// C: CheckCollisionPointPoly
  /// @param APoints the polygon's corners in order
  /// @returns `true` when the point is inside the polygon `APoints` (false for an empty one)
  const method InPoly(const APoints: array of Vector2): bool;
  begin
    if len(APoints) = 0 then
      return false;
    end;
    return CheckCollisionPointPoly(self, addr of APoints[0], int32(len(APoints)));
  end;

  /// True when the segments cross; `AAt` is then where. C: CheckCollisionLines
  /// @param AAt the crossing point, set when they cross
  /// @param AS1 the first line's start
  /// @param AE1 the first line's end
  /// @param AS2 the second line's start
  /// @param AE2 the second line's end
  /// @returns `true` when the segments cross; `AAt` is then where
  static method LinesCross(const AS1: Vector2; const AE1: Vector2; const AS2: Vector2;
    const AE2: Vector2; var AAt: Vector2): bool;
  begin
    return CheckCollisionLines(AS1, AE1, AS2, AE2, addr of AAt);
  end;

  /// True when the two circles overlap (touching counts). C: CheckCollisionCircles
  /// @param AC1 the first circle's centre
  /// @param AR1 its radius
  /// @param AC2 the second circle's centre
  /// @param AR2 its radius
  /// @returns `true` when the two circles overlap (touching counts)
  /// @example `if Vector2.CirclesOverlap(LShip, 12.0f, LRock, 20.0f) then Explode(); end;`
  static method CirclesOverlap(const AC1: Vector2; const AR1: float32; const AC2: Vector2;
    const AR2: float32): bool;
  begin
    return CheckCollisionCircles(AC1, AR1, AC2, AR2);
  end;

  /// True when the circle touches the segment from `AP1` to `AP2`. C: CheckCollisionCircleLine
  /// @param ACenter the circle's centre
  /// @param ARadius its radius
  /// @param AP1 the segment's start
  /// @param AP2 the segment's end
  /// @returns `true` when the circle touches the segment from `AP1` to `AP2`
  /// @example `if Vector2.CircleOverlapsLine(LBall, 8.0f, LWallA, LWallB) then Bounce(); end;`
  static method CircleOverlapsLine(const ACenter: Vector2; const ARadius: float32;
    const AP1: Vector2; const AP2: Vector2): bool;
  begin
    return CheckCollisionCircleLine(ACenter, ARadius, AP1, AP2);
  end;

  /// The screen point as a world point of `ACam`. C: GetScreenToWorld2D
  /// @param ACam the camera
  /// @returns the screen point as a world point of `ACam`
  const method ScreenToWorld(const ACam: Camera2D): Vector2;
  begin
    return GetScreenToWorld2D(self, ACam);
  end;

  /// The world point of `ACam` as a screen point. C: GetWorldToScreen2D
  /// @param ACam the camera
  /// @returns the world point of `ACam` as a screen point
  const method WorldToScreen(const ACam: Camera2D): Vector2;
  begin
    return GetWorldToScreen2D(self, ACam);
  end;

  /// The ray from `ACam` through this screen point (the window's size). C: GetScreenToWorldRay
  /// @param ACam the camera
  /// @returns the ray from `ACam` through this screen point (the window's size)
  const method ScreenToRay(const ACam: Camera3D): Ray;
  begin
    return GetScreenToWorldRay(self, ACam);
  end;

  /// The ray from `ACam` through this point of a `AWidth` x `AHeight` view.
  /// C: GetScreenToWorldRayEx
  /// @param ACam the camera
  /// @param AWidth the width
  /// @param AHeight the height
  /// @returns the ray from `ACam` through this point of a `AWidth` x `AHeight` view
  const method ScreenToRay(const ACam: Camera3D; const AWidth: int32; const AHeight: int32): Ray;
  begin
    return GetScreenToWorldRayEx(self, ACam, AWidth, AHeight);
  end;
end;

// Vector3 math (raymath's Vector3*) and its camera transforms.
// @example `LDir := (LTarget - LPos).Normalize();`
public extend Vector3
  /// The vector (0, 0, 0). C: Vector3Zero
  /// @returns the vector (0, 0, 0)
  static method Zero(): Vector3;
  begin
    return Vector3Zero();
  end;

  /// The vector (1, 1, 1). C: Vector3One
  /// @returns the vector (1, 1, 1)
  static method One(): Vector3;
  begin
    return Vector3One();
  end;

  /// Component-wise sum. C: Vector3Add
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise sum
  operator +(const A: Vector3; const B: Vector3): Vector3;
  begin
    return Vector3Add(A, B);
  end;

  /// `S` added to each component. C: Vector3AddValue
  /// @param A the left operand
  /// @param S the right operand
  /// @returns `S` added to each component
  operator +(const A: Vector3; const S: float32): Vector3;
  begin
    return Vector3AddValue(A, S);
  end;

  /// Component-wise difference. C: Vector3Subtract
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise difference
  operator -(const A: Vector3; const B: Vector3): Vector3;
  begin
    return Vector3Subtract(A, B);
  end;

  /// `S` taken from each component. C: Vector3SubtractValue
  /// @param A the left operand
  /// @param S the right operand
  /// @returns `S` taken from each component
