        SetAudioStreamPan(self.Handle(), APan);
      end;
      return self;
    end;

    /// Has raylib's audio thread call `AFunc` for frames whenever the stream needs them
    /// (nil: none, fed by Update again); the closure is kept while the stream may call it.
    /// C: SetAudioStreamCallback
    /// @param AFunc the func it runs
    /// @returns this object, so calls chain
    method Callback(const AFunc: AudioFunc): self;
    var
      LOld: CCallback<AudioCallback>;
    begin
      if not self.IsValid() then
        return self;
      end;
      // The old closure stays alive until raylib (under its audio lock) no longer calls it
      LOld := self.FHold.FCallback;
      if AFunc = nil then
        self.FHold.FCallback := CCallback<AudioCallback>();
      else
        self.FHold.FCallback := CCallback<AudioCallback>(AFunc);
      end;
      SetAudioStreamCallback(self.FHold.FStream, self.FHold.FCallback.Func());
      return self;
    end;

    /// Runs `AProcessor` over the stream's frames (after any attached before it), kept
    /// alive until Detach or the stream goes. Attaching one attached already does nothing
    /// more. C: AttachAudioStreamProcessor
    /// @param AProcessor the processor
    /// @returns this object, so calls chain
    method Attach(const AProcessor: AudioProcessor): self;
    begin
      if not self.IsValid() or not AProcessor.IsValid() then
        return self;
      end;
      if DoProcessorIndex(self.FHold.FProcessors, AProcessor) < 0 then
        AttachAudioStreamProcessor(self.FHold.FStream, AProcessor.Func());
        self.FHold.FProcessors.Add(AProcessor);
      end;
      return self;
    end;

    /// Stops running `AProcessor` (the value Attach was given, or a copy of it).
    /// C: DetachAudioStreamProcessor
    /// @param AProcessor the processor
    /// @returns this object, so calls chain
    method Detach(const AProcessor: AudioProcessor): self;
    var
      LI: int64;
    begin
      if not self.IsValid() then
        return self;
      end;
      LI := DoProcessorIndex(self.FHold.FProcessors, AProcessor);
      if LI >= 0 then
        DetachAudioStreamProcessor(self.FHold.FStream, AProcessor.Func());
        self.FHold.FProcessors.Delete(LI);
      end;
      return self;
    end;
  end;

  /// A video's status handler: called with its new status on every change (Play, Pause,
  /// Stop, and its end when it does not loop).
  /// @example `LIntro.OnStatus(func(const AStatus: VideoStatus) begin LEnded := AStatus = VideoStatus.VideoStopped; end);`
  VideoStatusHandler = ref func(const AStatus: VideoStatus);

  /// An MPEG-1 video (pl_mpeg) with its MP2 audio, played as MusicRes is: `Play()`, then
  /// `Update()` once a frame and `Draw.Video` it. A shared handle, unloaded with the last
  /// copy, the window's close or the audio device's. The sound plays when the audio device
  /// was open at the load. It loads with no window: frames are uploaded once one is open.
  /// @example `LIntro := VideoRes("res/assets/videos/intro.mpg").Looping(true).Play(); ... LIntro.Update(); Draw.Video(LIntro, Vector2(x: 0, y: 0), WHITE);`
  VideoRes = object
    hidden FHold: ref VideoHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing).
    init();
    begin
    end;

    /// Opens the .mpg at `APath` (an entry of the mounted source, else a file).
    /// @param APath the file's path
    init(const APath: string);
    var
      LIO: IO;
    begin
      if GAssets = nil then
        self.FHold := DoVideoHold(LoadVideo(APath));
        return;
      end;
      LIO := IOSourceOpen(GAssets.Source, APath);
      if LIO = nil then
        // Not an entry of the source: the real file system, as every mounted path goes
        // (System.HookIO's path source rule)
        self.FHold := DoVideoHold(LoadVideo(APath));
        return;
      end;
      // The video owns the entry's IO (closed with it)
      self.FHold := DoVideoHold(DoVideoRecord(DoVideoOpen(LIO, true, APath)));
    end;

    /// Opens a video read from `AIO` (the IO stays the caller's: open while the video is);
    /// `AName` names it.
    /// @param AIO the IO
    /// @param AName the name
    /// @returns the new `VideoRes`
    static method FromIO(const AIO: IO; const AName: string): VideoRes;
    var
      LRes: VideoRes;
    begin
      LRes.FHold := DoVideoHold(LoadVideoIO(AIO, AName));
      return LRes;
    end;

    /// The .C video (borrowed, for the procedural calls; an empty one when none is held).
    /// @returns the .C video (borrowed, for the procedural calls; an empty one when none is held)
    const method Handle(): Video;
    var
      LNone: Video;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return LNone;
      end;
      return DoVideoRecord(self.FHold.FPlayer);
    end;

    /// True when it holds a video.
    /// @returns `true` when it holds a video
    const method IsValid(): bool;
    begin
      return IsVideoValid(self.Handle());
    end;

    // The window its frames were uploaded to, noted once its first frame is (so that
    // window's destruction abandons its textures)
    hidden method DoBind();
    begin
      if (self.FHold = nil) or (self.FHold.WindowId <> 0) or (self.FHold.FPlayer = nil) then
        return;
      end;
      if self.FHold.FPlayer^.Decided then
        self.FHold.WindowId := DoWindowId();
      end;
    end;

    /// Plays it (from where it paused, or from its start).
    /// @returns this object, so calls chain
    method Play(): self;
    begin
      PlayVideo(self.Handle());
      return self;
    end;

    /// Pauses it, its frame still drawn.
    /// @returns this object, so calls chain
    method Pause(): self;
    begin
      PauseVideo(self.Handle());
      return self;
    end;

    /// Stops it (back to its start, no frame drawn until it plays).
    /// @returns this object, so calls chain
    method Stop(): self;
    begin
      StopVideo(self.Handle());
      return self;
    end;

    /// Plays on by the time since the last update: once a frame.
    method Update();
    begin
      UpdateVideo(self.Handle());
      self.DoBind();
    end;

    /// Plays on by `ASeconds` (a fixed step).
    /// @param ASeconds the time, in seconds
    method Update(const ASeconds: float64);
    begin
      UpdateVideo(self.Handle(), ASeconds);
      self.DoBind();
    end;

    /// Moves it to `ASeconds` from its start.
    /// @param ASeconds the time, in seconds
    /// @returns false when it holds no video or cannot seek there
    method Seek(const ASeconds: float64): bool;
    begin
      return SeekVideo(self.Handle(), ASeconds);
    end;

    /// Where it stands (stopped, playing, paused).
    /// @returns where it stands (stopped, playing, paused)
    const method Status(): VideoStatus;
    begin
      return GetVideoStatus(self.Handle());
    end;

    /// True while it plays.
    /// @returns `true` while it plays
    const method Playing(): bool;
    begin
      return IsVideoPlaying(self.Handle());
    end;

    /// Plays again from its start at its end (true) or stops there.
    /// @param ALoop `true` to loop
    /// @returns this object, so calls chain
    method Looping(const ALoop: bool): self;
    begin
      SetVideoLooping(self.Handle(), ALoop);
      return self;
    end;

    /// True when it plays again from its start at its end.
    /// @returns `true` when it plays again from its start at its end
    const method Looping(): bool;
    begin
      return IsVideoLooping(self.Handle());
    end;

    /// Its sound's volume as a level a person sets, 0 (silent) to 1 (full; clamped): equal
    /// steps sound like equal steps (System.Math's PerceivedVolume).
    /// @param AVolume the volume, 0 (silent) to 1 (full)
    /// @returns this object, so calls chain
    method Volume(const AVolume: float32): self;
    begin
      SetVideoVolume(self.Handle(), AVolume);
      return self;
    end;

    /// Its sound's volume level (as Volume(AVolume) set it).
    /// @returns its sound's volume level (as Volume(AVolume) set it)
    const method Volume(): float32;
    begin
      return GetVideoVolume(self.Handle());
    end;

    /// Calls `AHandler` with its new status on every change (nil: none). The handler is
    /// kept while the video is.
    /// @param AHandler the handler
    /// @returns this object, so calls chain
    method OnStatus(const AHandler: VideoStatusHandler): self;
    var
      LOld: CCallback<VideoStatusCallback>;
    begin
      if not self.IsValid() then
        return self;
      end;
      LOld := self.FHold.FStatus;
      if AHandler = nil then
        self.FHold.FStatus := CCallback<VideoStatusCallback>();
      else
        // The player's callback gives the name too: the handler is the video's own
        self.FHold.FStatus := CCallback<VideoStatusCallback>(
          func(const AStatus: VideoStatus; const AName: ptr to const char)
          begin
            AHandler(AStatus);
          end);
      end;
      SetVideoStatusCallback(self.Handle(), self.FHold.FStatus.Func());
      return self;
    end;

    /// True when it has a sound track.
    /// @returns `true` when it has a sound track
    const method HasAudio(): bool;
    begin
      return HasVideoAudio(self.Handle());
    end;

    /// True when its frames are converted on the GPU (decided at its first frame with a
    /// window).
    /// @returns `true` when its frames are converted on the GPU (decided at its first frame with a window)
    const method ShaderUsed(): bool;
    begin
      return IsVideoShaderUsed(self.Handle());
    end;

    /// Its frames per second.
    /// @returns its frames per second
    const method FrameRate(): float64;
    begin
      return GetVideoFrameRate(self.Handle());
    end;

    /// Its length in seconds.
    /// @returns its length in seconds
    const method Duration(): float64;
    begin
      return GetVideoDuration(self.Handle());
    end;

    /// The seconds played since its start.
    /// @returns the seconds played since its start
    const method Time(): float64;
    begin
      return GetVideoTime(self.Handle());
    end;

    /// Its sound's sample rate in Hz (0: no sound).
    /// @returns its sound's sample rate in Hz (0: no sound)
    const method SampleRate(): int32;
    begin
      return GetVideoSampleRate(self.Handle());
    end;

    /// Its frame width in pixels.
    /// @returns its frame width in pixels
    const method Width(): int32;
    begin
      return self.Handle().width;
    end;

    /// Its frame height in pixels.
    /// @returns its frame height in pixels
    const method Height(): int32;
    begin
      return self.Handle().height;
    end;
  end;

// ============================================================================
// Automation, VR and dropped files (sec 6): an automation event list records
// input frame by frame and plays it back (AutomationRes; the list in use is
// kept alive while raylib records into it), a VR stereo config renders a
// stereo pair (VRStereoRes), Dropped reads the files dropped on the window.
// ============================================================================

var
  // The events raylib records into (SetAutomationEventList keeps this address): the list in
  // use's, nil when none is
  GAutomationList: ptr to AutomationEventList;

type
  // An automation event list's holder (memory only); FList is the record raylib records into
  // while it is the list in use
  AutomationHold = object(ResHold)
    FList: AutomationEventList;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      // raylib records into the list in use every frame: it lets this one go first
      if GAutomationList = addr of self.FList then
        StopAutomationEventRecording();
        SetAutomationEventList(nil);
        GAutomationList := nil;
      end;
      UnloadAutomationEventList(self.FList);
    end;
  end;

  // A VR stereo config's holder (memory only)
  VRStereoHold = object(ResHold)
    FConfig: VrStereoConfig;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      UnloadVrStereoConfig(self.FConfig);
    end;
  end;

var
  // The list in use (AutomationRes.Use), kept alive while raylib records into it
  GAutomationUsed: ref AutomationHold;

// A holder of AList (live when raylib gave it its events)
func DoAutomationHold(const AList: AutomationEventList): ref AutomationHold;
var
  LHold: ref AutomationHold;
begin
  LHold := ref AutomationHold();
  LHold.FList := AList;
  LHold.Live := AList.events <> nil;
  return LHold;
end;

public type
  /// An automation event list: the input events of each frame recorded into it (the list in
  /// use, `Use`) and played back one by one, saved to and loaded from raylib's .rae text. A
  /// shared handle: a copy shares the events, the last copy unloads them; the list in use is
  /// kept alive until another is used.
  /// C: UnloadAutomationEventList (the last copy's release)
  /// @example `LRun: AutomationRes(4096); LRun.Use(); AutomationRes.StartRecording();`
  AutomationRes = object
    hidden FHold: ref AutomationHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing).
    init();
    begin
    end;

    /// A list with room for `ACapacity` events, none recorded yet (raylib's own empty list,
    /// LoadAutomationEventList(NULL), has room for its MAX_AUTOMATION_EVENTS). Holds nothing
    /// for a capacity below 1. C: LoadAutomationEventList
    /// @param ACapacity how many events it can record
    init(const ACapacity: int32);
    var
      LList: AutomationEventList;
    begin
      if ACapacity < 1 then
        return;
      end;
      // raylib frees the events with its own allocator (UnloadAutomationEventList), so they
      // come from it (MemAlloc, zeroed)
      LList.events := ptr to AutomationEvent(MemAlloc(uint32(ACapacity) *
        uint32(size(AutomationEvent))));
      if LList.events <> nil then
        LList.capacity := uint32(ACapacity);
      end;
      LList.count := 0;
      self.FHold := DoAutomationHold(LList);
    end;

    /// Loads the .rae events at `APath` (from the mounted source). A missing or bad file
    /// gives an empty list with raylib's room (Count 0), raylib's rule.
    /// C: LoadAutomationEventList
    /// @param APath the file's path
    init(const APath: string);
    begin
      self.FHold := DoAutomationHold(LoadAutomationEventList(APath));
    end;

    /// Takes the .C list `AList` over: unloaded with the last copy.
    /// @param AList the list
    /// @returns the new `AutomationRes`
    static method Adopt(const AList: AutomationEventList): AutomationRes;
    var
      LRes: AutomationRes;
    begin
      LRes.FHold := DoAutomationHold(AList);
      return LRes;
    end;

    /// Loads .rae events from `AIO` (the IO stays the caller's; nil gives raylib's empty
    /// list).
    /// @param AIO the IO
    /// @returns the new `AutomationRes`
    static method FromIO(const AIO: IO): AutomationRes;
    begin
      return AutomationRes.Adopt(LoadAutomationEventListIO(AIO));
    end;

    /// True when it holds a list (its room for events).
    /// @returns `true` when it holds a list (its room for events)
    const method IsValid(): bool;
    begin
      return (self.FHold <> nil) and self.FHold.Live and not self.FHold.Released;
    end;

    /// The .C list (borrowed, for .C calls; an empty one when none is held).
    /// @returns the .C list (borrowed, for .C calls; an empty one when none is held)
    const method Handle(): AutomationEventList;
    var
      LNone: AutomationEventList;
    begin
      if not self.IsValid() then
        return LNone;
      end;
      return self.FHold.FList;
    end;

    /// Makes it the list raylib records into (kept alive while it is the one in use, until
    /// another is used). C: SetAutomationEventList
    method Use();
    begin
      if not self.IsValid() then
        return;
      end;
      // The new list goes in before the old holder is let go, so the old one's unload never
      // finds itself in use
      GAutomationList := addr of self.FHold.FList;
      SetAutomationEventList(GAutomationList);
      GAutomationUsed := self.FHold;
    end;

    /// The frame recording counts from (frame numbers are relative to it).
    /// C: SetAutomationEventBaseFrame
    /// @param AFrame the frame
    static method BaseFrame(const AFrame: int32);
    begin
      SetAutomationEventBaseFrame(AFrame);
    end;

    /// Starts recording each frame's input events into the list in use (nothing when no
    /// list is: raylib would record into none). C: StartAutomationEventRecording
    static method StartRecording();
    begin
      if GAutomationList = nil then
        return;
      end;
      StartAutomationEventRecording();
    end;

    /// Stops recording. C: StopAutomationEventRecording
    static method StopRecording();
    begin
      StopAutomationEventRecording();
    end;

    /// How many events it holds (recording adds to it).
    /// @returns how many events it holds (recording adds to it)
    const method Count(): int32;
    begin
      if not self.IsValid() then
        return 0;
      end;
      return int32(self.FHold.FList.count);
    end;

    /// Event `AIndex` (0 to Count() - 1; an empty one outside).
    /// @param AIndex the index, from 0
    /// @returns event `AIndex` (0 to Count() - 1; an empty one outside)
    const method Event(const AIndex: int32): AutomationEvent;
    var
      LNone: AutomationEvent;
    begin
      if (AIndex < 0) or (AIndex >= self.Count()) then
        return LNone;
      end;
      return self.FHold.FList.events[AIndex];
    end;

    /// Plays `AEvent` back: raylib takes it as that frame's input. C: PlayAutomationEvent
    /// @param AEvent the event
    /// @example `if LRun.Event(LNext).frame = LFrame then AutomationRes.Play(LRun.Event(LNext)); end;`
    static method Play(const AEvent: AutomationEvent);
    begin
      PlayAutomationEvent(AEvent);
    end;

    /// Saves the events to `APath` as .rae text; false when it holds none or the write
    /// fails. C: ExportAutomationEventList
    /// @param APath the file's path
    /// @returns `true` when the file was written
    const method Export(const APath: string): bool;
    begin
      if not self.IsValid() then
        return false;
      end;
      return ExportAutomationEventList(self.FHold.FList, APath);
    end;
  end;

  /// A VR stereo config: the projections, view offsets and lens values raylib computes for a
  /// headset, drawn through between Begin and End (a stereo pair, one half per eye; raylib's
  /// pattern draws it into a render texture, then through a lens distortion shader set from
  /// `Handle()`'s values). A shared handle: a copy shares it.
  /// C: UnloadVrStereoConfig (the last copy's release)
  /// @example `LVR: VRStereoRes(LDevice); Draw.BeginTexture(LTarget); LVR.Begin(); Draw.Begin3D(LCam); Draw.Grid(10, 1.0f); Draw.End3D(); VRStereoRes.End(); Draw.EndTexture();`
  VRStereoRes = object
    hidden FHold: ref VRStereoHold;

    /// An empty handle (holds nothing: `IsValid()` false, its Begin does nothing).
    init();
    begin
    end;

    /// The config for the headset `ADevice`. C: LoadVrStereoConfig
    /// @param ADevice the device
    init(const ADevice: VrDeviceInfo);
    begin
      self.FHold := ref VRStereoHold();
      self.FHold.FConfig := LoadVrStereoConfig(ADevice);
      self.FHold.Live := true;
    end;

    /// True when it holds a config.
    /// @returns `true` when it holds a config
    const method IsValid(): bool;
    begin
      return (self.FHold <> nil) and self.FHold.Live and not self.FHold.Released;
    end;

    /// The .C config (a copy, for .C calls and the distortion shader's values; an empty one
    /// when none is held).
    /// @returns the .C config (a copy, for .C calls and the distortion shader's values; an empty one when none is held)
    const method Handle(): VrStereoConfig;
    var
      LNone: VrStereoConfig;
    begin
      if not self.IsValid() then
        return LNone;
      end;
      return self.FHold.FConfig;
    end;

    /// Drawing renders the stereo pair through this config until End. C: BeginVrStereoMode
    const method Begin();
    begin
      if not self.IsValid() then
        return;
      end;
      BeginVrStereoMode(self.FHold.FConfig);
    end;

    /// Ends Begin: drawing is single again. C: EndVrStereoMode
    static method End();
    begin
      EndVrStereoMode();
    end;
  end;

  /// The files dropped on the window: raylib keeps the last drop until it is read.
  /// @example `if Dropped.Any() then for LPath in Dropped.Files() do Load(LPath); end; end;`
  Dropped = object
    /// True when files were dropped since the last Files(). C: IsFileDropped
    /// @returns `true` when files were dropped since the last Files()
    static method Any(): bool;
    begin
      return IsFileDropped();
    end;

    /// The paths of the files dropped (empty when none were), clearing the drop.
    /// C: LoadDroppedFiles / UnloadDroppedFiles
    /// @returns the paths of the files dropped (empty when none were), clearing the drop
    static method Files(): array of string;
    var
      LList: FilePathList;
      LPaths: array of string;
      LI: int64;
    begin
      LList := LoadDroppedFiles();
      setlength(LPaths, int64(LList.count));
      for LI := 0 to int64(LList.count) - 1 do
        LPaths[LI] := StringFromC(LList.paths[LI]);
      end;
      UnloadDroppedFiles(LList);
      return LPaths;
    end;
  end;

// ============================================================================
// The window, the frame, time (sec 3): the entry point. Window is the frame
// window (InitFrameWindow's DPI-scaled, letterboxed window) as an object: a
// copy shares it, the last copy's done closes it. WindowConfig builds one
// fluently (`Window.Config().Size(800, 450).Title("Game").TargetFPS(60)
// .Open()`); `LWin: Window(800, 450, "Game");` is the short form. Monitor,
// Time, Clipboard, Log and Random are static: raylib's one of each.
// ============================================================================

public type
  /// The routine Log.Handler hands raylib's trace log to: each line's level and its text,
  /// formatted (a closure, so it may hold what it writes to).
  /// @example `Log.Handler(func(const ALevel: LogLevel; const AText: string) begin LLines.Add(AText); end);`
  LogHandler = ref func(const ALevel: LogLevel; const AText: string);

var
  // The Window values holding raylib's window and the window they hold (its DoWindowId, 0: none):
  // the last one's done closes it. A value holding a window closed since (by CloseWindow)
  // holds nothing any more, so it never closes a window opened after it.
  GWindowHolds: int64;
  GWindowHeld: uint64;
  // Log.Handler's routine (nil: raylib writes its own log)
  GLogHandler: LogHandler;

// One more Window value holding the frame window open now: its DoWindowId (0: no frame
// window to hold, nothing counted). Only the frame window is a Window's: a plain raylib window
// (InitWindow) is the program's own, never closed by a Window value's done. A window other
// than the one held starts a new count (the one held was closed by CloseWindow).
func DoWindowHold(): uint64;
var
  LId: uint64;
begin
  DoFrameLive();
  if not GFrame.Open then
    return 0;
  end;
  LId := DoWindowId();
  if LId = 0 then
    return 0;
  end;
  if LId <> GWindowHeld then
    GWindowHeld := LId;
    GWindowHolds := 0;
  end;
  GWindowHolds += 1;
  return LId;
end;

// A copy of a Window value holding AId: counted while that window is the one held
func DoWindowShare(const AId: uint64): uint64;
begin
  if (AId = 0) or (AId <> GWindowHeld) then
    return 0;
  end;
  GWindowHolds += 1;
  return AId;
end;

// raylib's SetExitKey (Window.SetExitKey's work: a method of the same name cannot call the
// bare routine)
func DoSetExitKey(const AKey: Key);
begin
  SetExitKey(int32(AKey));
end;

// A Window value holding AId goes: the last one closes the window while it is open
func DoWindowRelease(const AId: uint64);
begin
  if (AId = 0) or (AId <> GWindowHeld) or (GWindowHolds <= 0) then
    return;
  end;
  GWindowHolds -= 1;
  if GWindowHolds = 0 then
    GWindowHeld := 0;
    if DoWindowId() = AId then
      // Every GPU resource still alive goes while its context does (a copy released
      // later does nothing)
      DoReleaseGPU();
      CloseWindow();
    end;
  end;
end;

// raylib's trace log callback while Log.Handler has a routine: the line formatted
// (System.IO's FormatCList over raylib's va_list) and handed on
func clink DoTraceLogCall(logLevel: int32; text: ptr to const char; args: ptr);
var
  LHandler: LogHandler;
begin
  LHandler := GLogHandler;
  if LHandler = nil then
    return;
  end;
  LHandler(LogLevel(logLevel), FormatCList(text, args));
end;

// The C text ARaylibText (raylib's, nil for none) as a string ("" for nil)
func DoRaylibText(const ARaylibText: ptr to const char): string;
begin
  if ARaylibText = nil then
    return "";
  end;
  return StringFromC(ARaylibText);
end;

// AImages as the open window's icons: one by SetWindowIcon, more by SetWindowIcons (raylib
// copies the pixels, so the images need not outlive the call)
func DoSetIcons(const AImages: array of ImageRes);
var
  LImages: array of Image;
  LI: int64;
begin
  if len(AImages) = 1 then
    SetWindowIcon(AImages[0].Handle());
    return;
  end;
  if len(AImages) = 0 then
    SetWindowIcons(nil, 0);
    return;
  end;
  setlength(LImages, len(AImages));
  for LI := 0 to len(AImages) - 1 do
    LImages[LI] := AImages[LI].Handle();
  end;
  SetWindowIcons(addr of LImages[0], int32(len(LImages)));
end;

public forward type Window;

public type
  /// A frame window's settings, built fluently: every method returns the config, `Open`
  /// opens the window. Start one with `Window.Config()`.
  /// @example `LWin := Window.Config().Size(800, 450).Title("Game").TargetFPS(60).Open();`
  WindowConfig = object
    hidden FWidth: int32;
    hidden FHeight: int32;
    hidden FTitle: string;
    hidden FFlags: WindowFlags;
    hidden FZoom: float32;
    hidden FIntegerScale: bool;
    hidden FFrameColor: Color;
    hidden FBarColor: Color;
    // 0: raylib's default (no target frame rate)
    hidden FFPS: int32;
    // Key.Escape: raylib's default
    hidden FExitKey: Key;
    // 0 x 0: none set
    hidden FMinWidth: int32;
    hidden FMinHeight: int32;
    hidden FMaxWidth: int32;
    hidden FMaxHeight: int32;
    // The icons set as the window opens (none: @exeicon's, or raylib's)
    hidden FIcons: array of ImageRes;

    /// raylib's defaults: an 800 x 450 base, no title, no flags (the frame window is always
    /// resizable), zoom 1, a white frame with black bars, no target frame rate, Escape
    /// closes it
    init();
    begin
      self.FWidth := 800;
      self.FHeight := 450;
      self.FTitle := "";
      self.FFlags := [];
      self.FZoom := 1.0f;
      self.FIntegerScale := false;
      self.FFrameColor := WHITE;
      self.FBarColor := BLACK;
      self.FFPS := 0;
      self.FExitKey := Key.Escape;
      self.FMinWidth := 0;
      self.FMinHeight := 0;
      self.FMaxWidth := 0;
      self.FMaxHeight := 0;
    end;

    /// The base (virtual) size everything is drawn in.
    /// @param ABaseWidth the base width, more than 0
    /// @param ABaseHeight the base height, more than 0
    /// @returns this object, so calls chain
    method Size(const ABaseWidth: int32; const ABaseHeight: int32): self;
    begin
      self.FWidth := ABaseWidth;
      self.FHeight := ABaseHeight;
      return self;
    end;

    /// The window's title.
    /// @param AText the text
    /// @returns this object, so calls chain
    method Title(const AText: string): self;
    begin
      self.FTitle := AText;
      return self;
    end;

    /// raylib's window flags, set before the window opens. C: SetConfigFlags
    /// @param AFlags the flags
    /// @returns this object, so calls chain
    /// @example `Window.Config().Flags([WindowFlag.VSyncHint, WindowFlag.Msaa4xHint])`
    method Flags(const AFlags: WindowFlags): self;
    begin
      self.FFlags := AFlags;
      return self;
    end;

    /// The window's normal size: base x AZoom x the monitor's scale.
    /// @param AZoom the zoom
    /// @returns this object, so calls chain
    method Zoom(const AZoom: float32): self;
    begin
      self.FZoom := AZoom;
      return self;
    end;

    /// The letterbox kept a whole multiple of the base size (pixel art). C:
    /// SetFrameIntegerScale
    /// @param AOn `true` to turn it on, `false` to turn it off
    /// @returns this object, so calls chain
    method IntegerScale(const AOn: bool): self;
    begin
      self.FIntegerScale := AOn;
      return self;
    end;

    /// The colour the frame is cleared to each BeginFrame.
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method Color(const AColor: Color): self;
    begin
      self.FFrameColor := AColor;
      return self;
    end;

    /// The colour of the bars outside the frame.
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method BarColor(const AColor: Color): self;
    begin
      self.FBarColor := AColor;
      return self;
    end;

    /// The frame rate EndFrame waits for (0: no wait). C: SetTargetFPS
    /// @param AFPS the FPS
    /// @returns this object, so calls chain
    method TargetFPS(const AFPS: int32): self;
    begin
      self.FFPS := AFPS;
      return self;
    end;

    /// The key that closes the window (Key.Null: none). C: SetExitKey
    /// @param AKey the key
    /// @returns this object, so calls chain
    method ExitKey(const AKey: Key): self;
    begin
      self.FExitKey := AKey;
      return self;
    end;

    /// The smallest size the window may be resized to, in window units. C: SetWindowMinSize
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    method MinSize(const AWidth: int32; const AHeight: int32): self;
    begin
      self.FMinWidth := AWidth;
      self.FMinHeight := AHeight;
      return self;
    end;

    /// The largest size the window may be resized to, in window units. C: SetWindowMaxSize
    /// @param AWidth the width
    /// @param AHeight the height
    /// @returns this object, so calls chain
    method MaxSize(const AWidth: int32; const AHeight: int32): self;
    begin
      self.FMaxWidth := AWidth;
      self.FMaxHeight := AHeight;
      return self;
    end;

    /// The window's icon, set as it opens (R8G8B8A8; the @exeicon icon otherwise).
    /// C: SetWindowIcon
    /// @param AImage the image
    /// @returns this object, so calls chain
    method Icon(const AImage: ImageRes): self;
    begin
      setlength(self.FIcons, 1);
      self.FIcons[0] := AImage;
      return self;
    end;

    /// The window's icons, sizes the OS picks from, set as it opens (each R8G8B8A8; none:
    /// the @exeicon icon). C: SetWindowIcons
    /// @param AImages the images
    /// @returns this object, so calls chain
    method Icons(const AImages: array of ImageRes): self;
    var
      LI: int64;
    begin
      setlength(self.FIcons, len(AImages));
      for LI := 0 to len(AImages) - 1 do
        self.FIcons[LI] := AImages[LI];
      end;
      return self;
    end;

    /// Opens the frame window with these settings (InitFrameWindow): `Ready()` is false on
    /// the Window when it could not open (a base size of 0 or less, a raylib window already
    /// open, or raylib could not make one).
    /// @returns the window: the last copy of it closes it
    const method Open(): Window;
    begin
      SetFrameZoom(self.FZoom);
      SetFrameIntegerScale(self.FIntegerScale);
      SetFrameColor(self.FFrameColor);
      SetFrameBarColor(self.FBarColor);
      if uint32(self.FFlags) <> 0u then
        SetConfigFlags(uint32(self.FFlags));
      end;
      if InitFrameWindow(self.FWidth, self.FHeight, self.FTitle) then
        if self.FFPS > 0 then
          System.Raylib.C.SetTargetFPS(self.FFPS);
        end;
        SetExitKey(int32(self.FExitKey));
        if (self.FMinWidth > 0) and (self.FMinHeight > 0) then
          SetWindowMinSize(self.FMinWidth, self.FMinHeight);
        end;
        if (self.FMaxWidth > 0) and (self.FMaxHeight > 0) then
          SetWindowMaxSize(self.FMaxWidth, self.FMaxHeight);
        end;
        if len(self.FIcons) > 0 then
          DoSetIcons(self.FIcons);
        end;
      end;
      return Window();
    end;
  end;

  /// The frame window (raylib's one window per program): a base (virtual) size drawn
  /// DPI-scaled and letterboxed, in base units between BeginFrame and EndFrame. A copy
  /// shares the window; the last copy's done closes it.
  /// C: InitWindow (WindowConfig.Open, `init`) / CloseWindow (the last copy's done)
  /// @example `LWin: Window(800, 450, "Game"); while LWin.Running() do LWin.BeginFrame(); DrawCircle(400, 225, 50.0f, RED); LWin.EndFrame(); end;`
  Window = object
    // The window this value holds, its DoWindowId (0: none)
    hidden FWindowId: uint64;

    /// The frame window open now, if any (`Ready()` false when none is): what
    /// WindowConfig.Open gives.
    init();
    begin
      self.FWindowId := DoWindowHold();
    end;

    /// Opens the frame window at a base size of ABaseWidth x ABaseHeight (InitFrameWindow,
    /// the frame's settings as they are): the short form of `Window.Config()...Open()`.
    /// @param ABaseWidth the base width, more than 0
    /// @param ABaseHeight the base height, more than 0
    /// @param ATitle the window's title
    init(const ABaseWidth: int32; const ABaseHeight: int32; const ATitle: string);
    begin
      InitFrameWindow(ABaseWidth, ABaseHeight, ATitle);
      self.FWindowId := DoWindowHold();
    end;

    /// One more hold on the same window: it stays open while any copy is held.
    /// @param ASource the window value copied
    copy(const ASource: Window);
    begin
      self.FWindowId := DoWindowShare(ASource.FWindowId);
    end;

    /// Lets this hold go: the last one closes the window.
    done;
    begin
      DoWindowRelease(self.FWindowId);
    end;

    /// A window's settings with raylib's defaults, to build fluently.
    /// @returns a window's settings with raylib's defaults, to build fluently
    /// @example `LWin := Window.Config().Size(320, 180).Zoom(3.0f).IntegerScale(true).Open();`
    static method Config(): WindowConfig;
    begin
      return WindowConfig();
    end;

    /// True while the window is open and not asked to close (its close button, the exit
    /// key): the loop's condition. C: not WindowShouldClose (events are polled by EndFrame)
    /// @returns `true` while the window is open and not asked to close (its close button, the exit key): the loop's condition
    const method Running(): bool;
    begin
      return self.Ready() and not WindowShouldClose();
    end;

    /// Begins a frame: BeginDrawing, then the frame in base units (the bars cleared, the
    /// frame filled with its colour). C: BeginDrawing
    method BeginFrame();
    begin
      // No window, nothing to draw on (raylib's BeginDrawing needs its GL context)
      if not self.Ready() then
        return;
      end;
      BeginDrawing();
      DoBeginFrame();
    end;

    /// Ends the frame and shows it (events polled, the target frame rate waited for).
    /// C: EndDrawing
    method EndFrame();
    begin
      if not self.Ready() then
        return;
      end;
      DoEndFrame();
      EndDrawing();
    end;

    /// Clears what is being drawn into to AColor: the window (inside BeginFrame / EndFrame),
    /// or a render texture between its Begin and End. C: ClearBackground
    /// @param AColor the colour
    method Clear(const AColor: Color);
    begin
      if self.Ready() then
        ClearBackground(AColor);
      end;
    end;

    /// Holds drawing to the frame again (after an EndScissorMode of the program's own).
    method RestoreClip();
    begin
      RestoreFrameClip();
    end;

    // -- The window's state

    /// True while this value's window is open. C: IsWindowReady
    /// @returns `true` while this value's window is open
    const method Ready(): bool;
    begin
      return (self.FWindowId <> 0) and (DoWindowId() = self.FWindowId);
    end;

    /// True while the window is fullscreen. C: IsWindowFullscreen
    /// @returns `true` while the window is fullscreen
    const method Fullscreen(): bool;
    begin
      return self.Ready() and IsWindowFullscreen();
    end;

    /// True while the window is hidden. C: IsWindowHidden
    /// @returns `true` while the window is hidden
    const method Hidden(): bool;
    begin
      return self.Ready() and IsWindowHidden();
    end;

    /// True while the window is minimized. C: IsWindowMinimized
    /// @returns `true` while the window is minimized
    const method Minimized(): bool;
    begin
      return self.Ready() and IsWindowMinimized();
    end;

    /// True while the window is maximized. C: IsWindowMaximized
    /// @returns `true` while the window is maximized
    const method Maximized(): bool;
    begin
      return self.Ready() and IsWindowMaximized();
    end;

    /// True while the window has the keyboard focus. C: IsWindowFocused
    /// @returns `true` while the window has the keyboard focus
    const method Focused(): bool;
    begin
      return self.Ready() and IsWindowFocused();
    end;

    /// True when the window was resized in the last frame. C: IsWindowResized
    /// @returns `true` when the window was resized in the last frame
    const method Resized(): bool;
    begin
      return self.Ready() and IsWindowResized();
    end;

    /// True when every flag of AFlags is set on the window (an empty set: true).
    /// C: IsWindowState, each flag
    /// @param AFlags the flags
    /// @returns `true` when every flag of AFlags is set on the window (an empty set: true)
    const method HasFlags(const AFlags: WindowFlags): bool;
    var
      LFlag: WindowFlag;
    begin
      if not self.Ready() then
        return false;
      end;
      for LFlag in AFlags do
        // A flag's value is its bit (WindowFlag's rule)
        if not IsWindowState(1u shl uint32(LFlag)) then
          return false;
        end;
      end;
      return true;
    end;

    /// Sets AFlags on the open window. C: SetWindowState
    /// @param AFlags the flags
    method SetFlags(const AFlags: WindowFlags);
    begin
      SetWindowState(uint32(AFlags));
    end;

    /// Clears AFlags on the open window. C: ClearWindowState
    /// @param AFlags the flags
    method ClearFlags(const AFlags: WindowFlags);
    begin
      ClearWindowState(uint32(AFlags));
    end;

    /// Exclusive fullscreen on or off (the monitor takes the window's size; `Fullscreen()`
    /// tells which), the frame letterboxed in it as in the window. C: ToggleFullscreen
    method ToggleFullscreen();
    begin
      if self.Ready() then
        ToggleFullscreen();
      end;
    end;

    /// Borderless windowed on or off: the window, undecorated, covers the monitor it is on
    /// at the desktop's own mode, the frame letterboxed in it; off, it is back at its place
    /// and size (`Borderless()` tells which). The frame does it itself, a move and a resize,
    /// so it stays on its own monitor on every desktop (a window manager's fullscreen can
    /// spread over every monitor). C: ToggleBorderlessWindowed
    method ToggleBorderless();
    begin
      if self.Ready() then
        DoToggleFrameBorderless();
      end;
    end;

    /// True while the window is borderless (ToggleBorderless).
    /// @returns `true` while the window is borderless (ToggleBorderless)
    const method Borderless(): bool;
    begin
      return self.Ready() and GFrame.Borderless;
    end;

    /// Maximizes the window (a resizable one). C: MaximizeWindow
    method Maximize();
    begin
      MaximizeWindow();
    end;

    /// Minimizes the window (a resizable one). C: MinimizeWindow
    method Minimize();
    begin
      MinimizeWindow();
    end;

    /// The window back from maximized or minimized. C: RestoreWindow
    method Restore();
    begin
      RestoreWindow();
    end;

    /// Gives the window the input focus. C: SetWindowFocused
    method Focus();
    begin
      SetWindowFocused();
    end;

    /// The window's opacity, 0 (clear) to 1 (opaque). C: SetWindowOpacity
    /// @param AOpacity the opacity
    method SetOpacity(const AOpacity: float32);
    begin
      SetWindowOpacity(AOpacity);
    end;

    /// Sets the window's title. C: SetWindowTitle
    /// @param AText the new title
    method SetTitle(const AText: string);
    begin
      SetWindowTitle(AText);
    end;

    /// The window's place on the screen, in window units. C: SetWindowPosition
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    method SetPosition(const AX: int32; const AY: int32);
    begin
      SetWindowPosition(AX, AY);
    end;

    /// Moves the window to monitor AMonitor (Monitor.Count's range). C: SetWindowMonitor
    /// @param AMonitor the monitor's index
    method SetMonitor(const AMonitor: int32);
    begin
      SetWindowMonitor(AMonitor);
    end;

    /// The window's size in window units (the frame letterboxed in it). C: SetWindowSize
    /// @param AWidth the width
    /// @param AHeight the height
    method SetSize(const AWidth: int32; const AHeight: int32);
    begin
      SetWindowSize(AWidth, AHeight);
    end;

    /// The smallest size the user can make the window. C: SetWindowMinSize
    /// @param AWidth the width
    /// @param AHeight the height
    method SetMinSize(const AWidth: int32; const AHeight: int32);
    begin
      SetWindowMinSize(AWidth, AHeight);
    end;

    /// The largest size the user can make the window. C: SetWindowMaxSize
    /// @param AWidth the width
    /// @param AHeight the height
    method SetMaxSize(const AWidth: int32; const AHeight: int32);
    begin
      SetWindowMaxSize(AWidth, AHeight);
    end;

    /// The key that closes the window from now on (Key.Null: none, the program's own close
    /// only), as WindowConfig.ExitKey set it at the open. C: SetExitKey
    /// @param AKey the key
    method SetExitKey(const AKey: Key);
    begin
      DoSetExitKey(AKey);
    end;

    /// The window's place on the screen. C: GetWindowPosition
    /// @returns the window's place on the screen
    const method Position(): Vector2;
    begin
      return GetWindowPosition();
    end;

    /// The monitor's scale (DPI / 96 on each axis, as raylib reports it). C: GetWindowScaleDPI
    /// @returns the monitor's scale (DPI / 96 on each axis, as raylib reports it)
    const method ScaleDPI(): Vector2;
    begin
      return GetWindowScaleDPI();
    end;

    /// The DPI the window is shown at now (96: scale 1; 96 with no window): Windows the
    /// window's own, X11's Xft.dpi.
    /// @returns the DPI the window is shown at now (96: scale 1; 96 with no window): Windows the window's own, X11's Xft.dpi
    const method DPI(): int32;
    begin
      return GetWindowDPI();
    end;

    /// The window's width in screen coordinates. C: GetScreenWidth
    /// @returns the width
    const method ScreenWidth(): int32;
    begin
      return GetScreenWidth();
    end;

    /// The window's height in screen coordinates. C: GetScreenHeight
    /// @returns the height
    const method ScreenHeight(): int32;
    begin
      return GetScreenHeight();
    end;

    /// The width of the framebuffer drawn to, in pixels (more than the screen width on a high-DPI screen). C: GetRenderWidth
    /// @returns the width
    const method RenderWidth(): int32;
    begin
      return GetRenderWidth();
    end;

    /// The height of the framebuffer drawn to, in pixels (more than the screen height on a high-DPI screen). C: GetRenderHeight
    /// @returns the height
    const method RenderHeight(): int32;
    begin
      return GetRenderHeight();
    end;

    /// The native window (an HWND on Windows, an X11 Window on linux), for OS calls.
    /// C: GetWindowHandle
    /// @returns the native window (an HWND on Windows, an X11 Window on linux), for OS calls
    const method Handle(): ptr;
    begin
      return GetWindowHandle();
    end;

    // -- The frame (base units)

    /// The base width (0 with no window).
    /// @returns the base width (0 with no window)
    const method Width(): int32;
    begin
      return GetFrameWidth();
    end;

    /// The base height (0 with no window).
    /// @returns the base height (0 with no window)
    const method Height(): int32;
    begin
      return GetFrameHeight();
    end;

    /// The monitor's scale the window is sized for: `DPI()` / 96 (the letterbox's own scale,
    /// window units per base unit, is `Camera().zoom`).
    /// @returns the monitor's scale the window is sized for: `DPI()` / 96 (the letterbox's own scale, window units per base unit, is `Camera().zoom`)
    const method Scale(): float32;
    begin
      return GetFrameScale();
    end;

    /// The zoom the window's normal size takes.
    /// @returns the zoom the window's normal size takes
    const method Zoom(): float32;
    begin
      return GetFrameZoom();
    end;

    /// A new zoom: the window takes base x AZoom x the monitor's scale.
    /// @param AZoom the zoom
    method SetZoom(const AZoom: float32);
    begin
      SetFrameZoom(AZoom);
    end;

    /// The frame's rectangle in the window now, in window units.
    /// @returns the frame's rectangle in the window now, in window units
    const method Letterbox(): Rectangle;
    begin
      return GetFrameLetterbox();
    end;

    /// The camera the frame draws through (base units into the letterbox).
    /// @returns the camera the frame draws through (base units into the letterbox)
    const method Camera(): Camera2D;
    begin
      return GetFrameCamera();
    end;

    /// The colour the frame is cleared to each BeginFrame.
    property Color: Color
    read
    begin
      return GetFrameColor();
    end;
    write(AColor)
    begin
      SetFrameColor(AColor);
    end;

    /// The colour of the bars outside the frame.
    property BarColor: Color
    read
    begin
      return GetFrameBarColor();
    end;
    write(AColor)
    begin
      SetFrameBarColor(AColor);
    end;

    /// The letterbox kept a whole multiple of the base size. 
    property IntegerScale: bool
    read
    begin
      return IsFrameIntegerScale();
    end;
    write(AOn)
    begin
      SetFrameIntegerScale(AOn);
    end;

    /// Waits for an event in EndFrame instead of polling (an app that redraws only on
    /// input). C: EnableEventWaiting / DisableEventWaiting
    /// @param AOn `true` to turn it on, `false` to turn it off
    method WaitEvents(const AOn: bool);
    begin
      if AOn then
        EnableEventWaiting();
      else
        DisableEventWaiting();
      end;
    end;

    /// Shows what was drawn (a custom loop with raylib's SUPPORT_CUSTOM_FRAME_CONTROL).
    /// C: SwapScreenBuffer
    method SwapBuffers();
    begin
      SwapScreenBuffer();
    end;

    /// Takes the input events since the last call (a custom loop with SwapBuffers: EndFrame
    /// polls them itself). C: PollInputEvents
    method PollEvents();
    begin
      PollInputEvents();
    end;

    /// Saves the window's picture as a PNG at APath. C: TakeScreenshot
    /// @param APath the file's path
    method Screenshot(const APath: string);
    begin
      TakeScreenshot(APath);
    end;

    /// What the window shows so far this frame, at its real pixel size, as an image: call it
    /// between BeginFrame and EndFrame, after the drawing (raylib's pending batch is drawn
    /// first). After EndFrame the back buffer belongs to the next frame. C: LoadImageFromScreen
    /// @returns what the window shows so far this frame, at its real pixel size, as an image: call it between BeginFrame and EndFrame, after the drawing (raylib's pending batch is drawn first)
    const method Snapshot(): ImageRes;
    begin
      if not self.Ready() then
        return ImageRes();
      end;
      rlDrawRenderBatchActive();
      return ImageRes.Adopt(LoadImageFromScreen());
    end;

    /// The window's icon (R8G8B8A8). C: SetWindowIcon
    /// @param AImage the image
    method SetIcon(const AImage: ImageRes);
    begin
      SetWindowIcon(AImage.Handle());
    end;

    /// The window's icons, sizes the OS picks from (each R8G8B8A8; none: raylib's default).
    /// C: SetWindowIcons
    /// @param AImages the images
    method SetIcons(const AImages: array of ImageRes);
    begin
      DoSetIcons(AImages);
    end;

    // -- The frame's rules, with no window

    /// The letterbox a base size takes in a window size: the largest rectangle of the base's
    /// aspect, centred.
    /// @param AWindowWidth the window width
    /// @param AWindowHeight the window height
    /// @param ABaseWidth the frame's base width
    /// @param ABaseHeight the frame's base height
    /// @returns the letterbox a base size takes in a window size: the largest rectangle of the base's aspect, centred
    static method LetterboxRect(const AWindowWidth: int32; const AWindowHeight: int32;
      const ABaseWidth: int32; const ABaseHeight: int32): Rectangle;
    begin
      return DoLetterbox(AWindowWidth, AWindowHeight, ABaseWidth, ABaseHeight);
    end;

    /// The letterbox a base size takes in a window size, a whole multiple of the base (1 at
    /// the least).
    /// @param AWindowWidth the window width
    /// @param AWindowHeight the window height
    /// @param ABaseWidth the frame's base width
    /// @param ABaseHeight the frame's base height
    /// @returns the letterbox a base size takes in a window size, a whole multiple of the base (1 at the least)
    static method IntegerLetterboxRect(const AWindowWidth: int32; const AWindowHeight: int32;
      const ABaseWidth: int32; const ABaseHeight: int32): Rectangle;
    begin
      return DoIntegerLetterbox(AWindowWidth, AWindowHeight, ABaseWidth, ABaseHeight, 1.0f);
    end;

    /// The window size a base size opens at for a DPI (scale DPI / 96).
    /// @param ABaseWidth the frame's base width
    /// @param ABaseHeight the frame's base height
    /// @param ADPI the DPI
    /// @returns the window size a base size opens at for a DPI (scale DPI / 96)
    static method ScaledFrameSize(const ABaseWidth: int32; const ABaseHeight: int32;
      const ADPI: int32): Vector2;
    begin
      return DoScaledSize(ABaseWidth, ABaseHeight, ADPI);
    end;

    /// A window point in base units through a letterbox (clamped to the base). C:
    /// GetFramePoint
    /// @param APoint the point
    /// @param ALetterbox the letterbox
    /// @param ABaseWidth the frame's base width
    /// @param ABaseHeight the frame's base height
    /// @returns a window point in base units through a letterbox (clamped to the base)
    static method FramePoint(const APoint: Vector2; const ALetterbox: Rectangle;
      const ABaseWidth: int32; const ABaseHeight: int32): Vector2;
    begin
      return DoFramePoint(APoint, ALetterbox, ABaseWidth, ABaseHeight);
    end;
  end;

  /// The monitors (raylib's numbering, 0 the first).
  Monitor = object
    /// How many monitors are connected. C: GetMonitorCount
    /// @returns the number of monitors
    static method Count(): int32;
    begin
      return GetMonitorCount();
    end;

    /// The monitor the window is on. C: GetCurrentMonitor
    /// @returns the monitor the window is on
    static method Current(): int32;
    begin
      return GetCurrentMonitor();
    end;

    /// The monitor's name ("" when there is none of that number). C: GetMonitorName
    /// @param AMonitor the monitor's index
    /// @returns the monitor's name ("" when there is none of that number)
    static method Name(const AMonitor: int32): string;
    begin
      return DoRaylibText(GetMonitorName(AMonitor));
    end;

    /// Monitor `AMonitor`'s top-left corner on the desktop, in screen coordinates. C: GetMonitorPosition
    /// @param AMonitor the monitor's index
    /// @returns the corner
    static method Position(const AMonitor: int32): Vector2;
    begin
      return GetMonitorPosition(AMonitor);
    end;

    /// The monitor's current video mode's width. C: GetMonitorWidth
    /// @param AMonitor the monitor's index
    /// @returns the monitor's current video mode's width
    static method Width(const AMonitor: int32): int32;
    begin
      return GetMonitorWidth(AMonitor);
    end;

    /// The monitor's current video mode's height. C: GetMonitorHeight
    /// @param AMonitor the monitor's index
    /// @returns the monitor's current video mode's height
    static method Height(const AMonitor: int32): int32;
    begin
      return GetMonitorHeight(AMonitor);
    end;

    /// In millimetres. C: GetMonitorPhysicalWidth
    /// @param AMonitor the monitor's index
    /// @returns the width in millimetres
    static method PhysicalWidth(const AMonitor: int32): int32;
    begin
      return GetMonitorPhysicalWidth(AMonitor);
    end;

    /// In millimetres. C: GetMonitorPhysicalHeight
    /// @param AMonitor the monitor's index
    /// @returns the height in millimetres
    static method PhysicalHeight(const AMonitor: int32): int32;
    begin
      return GetMonitorPhysicalHeight(AMonitor);
    end;

    /// Monitor `AMonitor`'s refresh rate, in hertz. C: GetMonitorRefreshRate
    /// @param AMonitor the monitor's index
    /// @returns the rate
    static method RefreshRate(const AMonitor: int32): int32;
    begin
      return GetMonitorRefreshRate(AMonitor);
    end;
  end;

  /// The frame clock.
  /// @example `LPos := LPos + LVel * Time.Delta();`
  Time = object
    /// The frames per second now. C: GetFPS
    /// @returns the frames per second now
    static method FPS(): int32;
    begin
      return GetFPS();
    end;

    /// The last frame's time in seconds. C: GetFrameTime
    /// @returns the last frame's time in seconds
    static method Delta(): float32;
    begin
      return GetFrameTime();
    end;

    /// Seconds since the window opened. C: GetTime
    /// @returns the seconds since the window opened
    static method Now(): float64;
    begin
      return GetTime();
    end;

    /// The frame rate EndFrame waits for (0: no wait). C: SetTargetFPS
    /// @param AFPS the FPS
    static method SetTargetFPS(const AFPS: int32);
    begin
      System.Raylib.C.SetTargetFPS(AFPS);
    end;

    /// Waits ASeconds (raylib's precise wait). C: WaitTime
    /// @param ASeconds the time, in seconds
    static method Wait(const ASeconds: float64);
    begin
      WaitTime(ASeconds);
    end;
  end;

  /// The system clipboard (needs the window open).
  Clipboard = object
    /// The clipboard's text ("" when it holds none). C: GetClipboardText
    /// @returns the clipboard's text ("" when it holds none)
    static method Text(): string;
    begin
      return DoRaylibText(GetClipboardText());
    end;

    /// Puts `AText` on the clipboard. C: SetClipboardText
    /// @param AText the text
    static method SetText(const AText: string);
    begin
      SetClipboardText(AText);
    end;

    /// The clipboard's image (an empty one when it holds none). C: GetClipboardImage
    /// @returns the clipboard's image (an empty one when it holds none)
    static method Image(): ImageRes;
    begin
      return ImageRes.Adopt(GetClipboardImage());
    end;
  end;

  /// raylib's trace log.
  /// @example `Log.Level(LogLevel.Warning);`
  Log = object
    /// The lowest level written (LogLevel.None: nothing). C: SetTraceLogLevel
    /// @param ALevel the level
    static method Level(const ALevel: LogLevel);
    begin
      SetTraceLogLevel(int32(ALevel));
    end;

    /// Writes AText to the log at ALevel (as is: no format). C: TraceLog
    /// @param ALevel the level
    /// @param AText the text
    static method Write(const ALevel: LogLevel; const AText: string);
    var
      LText: CString;
    begin
      LText := CString(AText);
      TraceLog(int32(ALevel), "%s", LText.Ptr);
    end;

    /// Hands every log line, formatted, to AHandler in place of raylib's own output (nil:
    /// raylib's output again). The level filter (Level) still applies. C: SetTraceLogCallback
    /// @param AHandler the handler
    static method Handler(const AHandler: LogHandler);
    begin
      GLogHandler := AHandler;
      if AHandler = nil then
        SetTraceLogCallback(nil);
      else
        SetTraceLogCallback(DoTraceLogCall);
      end;
    end;
  end;

  /// raylib's random numbers (one generator for the program).
  Random = object
    /// Seeds the generator (a run with the same seed gives the same numbers). C: SetRandomSeed
    /// @param ASeed the seed
    static method Seed(const ASeed: uint32);
    begin
      SetRandomSeed(ASeed);
    end;

    /// A number from ALow to AHigh, both included. C: GetRandomValue
    /// @param ALow the lowest number
    /// @param AHigh the highest number
    /// @returns a number from ALow to AHigh, both included
    static method Value(const ALow: int32; const AHigh: int32): int32;
    begin
      return GetRandomValue(ALow, AHigh);
    end;

    /// ACount numbers from ALow to AHigh with no repeat; none for a count of 0 or less or
    /// more than the range holds. C: LoadRandomSequence / UnloadRandomSequence
    /// @param ACount how many
    /// @param ALow the lowest number
    /// @param AHigh the highest number
    /// @returns the numbers
    static method Sequence(const ACount: int32; const ALow: int32; const AHigh: int32): array of int32;
    var
      LNumbers: ptr to int32;
      LResultArray: array of int32;
      LI: int64;
    begin
      setlength(LResultArray, 0);
      if ACount <= 0 then
        return LResultArray;
      end;
      LNumbers := LoadRandomSequence(uint32(ACount), ALow, AHigh);
      if LNumbers = nil then
        return LResultArray;
      end;
      setlength(LResultArray, int64(ACount));
      for LI := 0 to int64(ACount) - 1 do
        LResultArray[LI] := LNumbers[LI];
      end;
      UnloadRandomSequence(LNumbers);
      return LResultArray;
    end;
  end;

// ============================================================================
// Input (sec 4): Keyboard, Mouse and Touch are static (raylib's one of each,
// read each frame after EndFrame polled the events); a Gamepad is a value
// naming one pad (`Gamepad(0)`). Keys, buttons and gestures are sec 1's
// choices; the mouse in window pixels (Position) or base units (FramePosition).
// ============================================================================

const
  // raylib's MAX_GAMEPADS: a pad's index is 0 to one less
  ADAM_RAYLIB_MAX_GAMEPADS: int32 = 4;

public type
  /// The keyboard (the window's focus).
  /// @example `if Keyboard.Pressed(Key.Space) then Jump(); end;`
  Keyboard = object
    /// True in the frame AKey went down. C: IsKeyPressed
    /// @param AKey the key
    /// @returns `true` in the frame AKey went down
    static method Pressed(const AKey: Key): bool;
    begin
      return IsKeyPressed(int32(AKey));
    end;

    /// True in a frame the system repeats a held AKey. C: IsKeyPressedRepeat
    /// @param AKey the key
    /// @returns `true` in a frame the system repeats a held AKey
    static method PressedRepeat(const AKey: Key): bool;
    begin
      return IsKeyPressedRepeat(int32(AKey));
    end;

    /// True while AKey is held. C: IsKeyDown
    /// @param AKey the key
    /// @returns `true` while AKey is held
    static method Down(const AKey: Key): bool;
    begin
      return IsKeyDown(int32(AKey));
    end;

    /// True in the frame AKey came up. C: IsKeyReleased
    /// @param AKey the key
    /// @returns `true` in the frame AKey came up
    static method Released(const AKey: Key): bool;
    begin
      return IsKeyReleased(int32(AKey));
    end;

    /// True while AKey is not held. C: IsKeyUp
    /// @param AKey the key
    /// @returns `true` while AKey is not held
    static method Up(const AKey: Key): bool;
    begin
      return IsKeyUp(int32(AKey));
    end;

    /// The next key pressed this frame, from raylib's queue (Key.Null when it is empty).
    /// C: GetKeyPressed
    /// @returns the next key pressed this frame, from raylib's queue (Key.Null when it is empty)
    static method Next(): Key;
    begin
      return Key(GetKeyPressed());
    end;

    /// The next character typed this frame (a Unicode code point), from raylib's queue (0
    /// when it is empty). C: GetCharPressed
    /// @returns the next character typed this frame (a Unicode code point), from raylib's queue (0 when it is empty)
    static method NextChar(): int32;
    begin
      return GetCharPressed();
    end;

    /// The character AKey types in the keyboard's layout ("" for a key that types none,
    /// Escape or an arrow). C: GetKeyName
    /// @param AKey the key
    /// @returns the character AKey types in the keyboard's layout ("" for a key that types none, Escape or an arrow)
    static method Name(const AKey: Key): string;
    begin
      return DoRaylibText(GetKeyName(int32(AKey)));
    end;
  end;

  /// The mouse and its cursor.
  /// @example `if Mouse.Pressed(Button.Left) then Fire(Mouse.FramePosition()); end;`
  Mouse = object
    /// True in the frame AButton went down. C: IsMouseButtonPressed
    /// @param AButton the button
    /// @returns `true` in the frame AButton went down
    static method Pressed(const AButton: Button): bool;
    begin
      return IsMouseButtonPressed(int32(AButton));
    end;

    /// True while AButton is held. C: IsMouseButtonDown
    /// @param AButton the button
    /// @returns `true` while AButton is held
    static method Down(const AButton: Button): bool;
    begin
      return IsMouseButtonDown(int32(AButton));
    end;

    /// True in the frame AButton came up. C: IsMouseButtonReleased
    /// @param AButton the button
    /// @returns `true` in the frame AButton came up
    static method Released(const AButton: Button): bool;
    begin
      return IsMouseButtonReleased(int32(AButton));
    end;

    /// True while AButton is not held. C: IsMouseButtonUp
    /// @param AButton the button
    /// @returns `true` while AButton is not held
    static method Up(const AButton: Button): bool;
    begin
      return IsMouseButtonUp(int32(AButton));
    end;

    /// The mouse's x in window pixels. C: GetMouseX
    /// @returns the mouse's x in window pixels
    static method X(): int32;
    begin
      return GetMouseX();
    end;

    /// The mouse's y in window pixels. C: GetMouseY
    /// @returns the mouse's y in window pixels
    static method Y(): int32;
    begin
      return GetMouseY();
    end;

    /// The mouse in window pixels (SetOffset / SetScale applied). C: GetMousePosition
    /// @returns the mouse in window pixels (SetOffset / SetScale applied)
    static method Position(): Vector2;
    begin
      return GetMousePosition();
    end;

    /// The mouse in the frame's base units, as BeginFrame took it (clamped to the frame).
    /// @returns the mouse in the frame's base units, as BeginFrame took it (clamped to the frame)
    static method FramePosition(): Vector2;
    begin
      return GetFrameMousePosition();
    end;

    /// How far the mouse moved since the last frame, in window pixels. C: GetMouseDelta
    /// @returns how far the mouse moved since the last frame, in window pixels
    static method Delta(): Vector2;
    begin
      return GetMouseDelta();
    end;

    /// The wheel's move this frame (the larger of its two axes). C: GetMouseWheelMove
    /// @returns the wheel's move this frame (the larger of its two axes)
    static method Wheel(): float32;
    begin
      return GetMouseWheelMove();
    end;

    /// The wheel's move this frame on both axes. C: GetMouseWheelMoveV
    /// @returns the wheel's move this frame on both axes
    static method WheelV(): Vector2;
    begin
      return GetMouseWheelMoveV();
    end;

    /// Moves the system cursor to AX, AY in window pixels. C: SetMousePosition
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    static method SetPosition(const AX: int32; const AY: int32);
    begin
      SetMousePosition(AX, AY);
    end;

    /// What Position adds to the cursor's place (before SetScale). C: SetMouseOffset
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    static method SetOffset(const AX: int32; const AY: int32);
    begin
      SetMouseOffset(AX, AY);
    end;

    /// What Position scales the offset cursor's place by. C: SetMouseScale
    /// @param AX the x coordinate
    /// @param AY the y coordinate
    static method SetScale(const AX: float32; const AY: float32);
    begin
      SetMouseScale(AX, AY);
    end;

    /// The cursor's shape over the window. C: SetMouseCursor
    /// @param ACursor the cursor
    static method SetCursor(const ACursor: Cursor);
    begin
      SetMouseCursor(int32(ACursor));
    end;

    /// Shows the mouse cursor. C: ShowCursor
    static method Show();
    begin
      ShowCursor();
    end;

    /// Hides the mouse cursor. C: HideCursor
    static method Hide();
    begin
      HideCursor();
    end;

    /// True while the cursor is hidden. C: IsCursorHidden
    /// @returns `true` while the cursor is hidden
    static method Hidden(): bool;
    begin
      return IsCursorHidden();
    end;

    /// The cursor shown and free again (after Disable). C: EnableCursor
    static method Enable();
    begin
      EnableCursor();
    end;

    /// The cursor hidden and held in the window (a first-person camera reads Delta).
    /// C: DisableCursor
    static method Disable();
    begin
      DisableCursor();
    end;

    /// True while the cursor is over the window. C: IsCursorOnScreen
    /// @returns `true` while the cursor is over the window
    static method OnScreen(): bool;
    begin
      return IsCursorOnScreen();
    end;
  end;

  /// One gamepad, by its index (0 to 3): a pad that is not there reads as nothing held.
  /// @example `LPad: Gamepad(0); if LPad.Down(PadButton.RightFaceDown) then Jump(); end;`
  Gamepad = object
    hidden FIndex: int32;

    /// The gamepad AIndex (0 to 3; any other index is never available).
    /// @param AIndex the index, from 0
    init(const AIndex: int32);
    begin
      self.FIndex := AIndex;
    end;

    // True when the index names one of raylib's pads (raylib checks only the top)
    hidden const method DoValid(): bool;
    begin
      return (self.FIndex >= 0) and (self.FIndex < ADAM_RAYLIB_MAX_GAMEPADS);
    end;

    /// The pad's index.
    /// @returns the pad's index
    const method Index(): int32;
    begin
      return self.FIndex;
    end;

    /// True while the pad is connected. C: IsGamepadAvailable
    /// @returns `true` while the pad is connected
    const method Available(): bool;
    begin
      return self.DoValid() and IsGamepadAvailable(self.FIndex);
    end;

    /// The pad's name ("" when it is not there). C: GetGamepadName
    /// @returns the pad's name ("" when it is not there)
    const method Name(): string;
    begin
      if not self.Available() then
        return "";
      end;
      return DoRaylibText(GetGamepadName(self.FIndex));
    end;

    /// True in the frame AButton went down. C: IsGamepadButtonPressed
    /// @param AButton the button
    /// @returns `true` in the frame AButton went down
    const method Pressed(const AButton: PadButton): bool;
    begin
      return self.DoValid() and IsGamepadButtonPressed(self.FIndex, int32(AButton));
    end;

    /// True while AButton is held. C: IsGamepadButtonDown
    /// @param AButton the button
    /// @returns `true` while AButton is held
    const method Down(const AButton: PadButton): bool;
    begin
      return self.DoValid() and IsGamepadButtonDown(self.FIndex, int32(AButton));
    end;

    /// True in the frame AButton came up. C: IsGamepadButtonReleased
    /// @param AButton the button
    /// @returns `true` in the frame AButton came up
    const method Released(const AButton: PadButton): bool;
    begin
      return self.DoValid() and IsGamepadButtonReleased(self.FIndex, int32(AButton));
    end;

    /// True while AButton is not held (a pad that is not there: true). C: IsGamepadButtonUp
    /// @param AButton the button
    /// @returns `true` while AButton is not held (a pad that is not there: true)
    const method Up(const AButton: PadButton): bool;
    begin
      return (not self.DoValid()) or IsGamepadButtonUp(self.FIndex, int32(AButton));
    end;

    /// The last button pressed on any pad (PadButton.Unknown: none). C: GetGamepadButtonPressed
    /// @returns the last button pressed on any pad (PadButton.Unknown: none)
    static method Next(): PadButton;
    begin
      return PadButton(GetGamepadButtonPressed());
    end;

    /// How many axes the pad has (0 when it is not there). C: GetGamepadAxisCount
    /// @returns how many axes the pad has (0 when it is not there)
    const method AxisCount(): int32;
    begin
      if not self.DoValid() then
        return 0;
      end;
      return GetGamepadAxisCount(self.FIndex);
    end;

    /// AAxis's place, -1 to 1 (a trigger 0 to 1 on some pads; 0 when it is not there).
    /// C: GetGamepadAxisMovement
    /// @param AAxis the axis
    /// @returns the axis's place
    const method Axis(const AAxis: PadAxis): float32;
    begin
      if not self.DoValid() then
        return 0.0f;
      end;
      return GetGamepadAxisMovement(self.FIndex, int32(AAxis));
    end;

    /// Shakes the pad: the motors' strengths 0 to 1 for ASeconds. C: SetGamepadVibration
    /// @param ALeft the left motor's strength, 0 to 1
    /// @param ARight the right motor's strength, 0 to 1
    /// @param ASeconds the time, in seconds
    method Vibrate(const ALeft: float32; const ARight: float32; const ASeconds: float32);
    begin
      if self.DoValid() then
        SetGamepadVibration(self.FIndex, ALeft, ARight, ASeconds);
      end;
    end;

    /// Adds SDL_GameControllerDB mapping lines for pads raylib does not know; what raylib
    /// returns (1 when they were taken). C: SetGamepadMappings
    /// @param AMappings the mappings
    /// @returns raylib's result (1 when the lines were taken)
    static method Mappings(const AMappings: string): int32;
    begin
      return SetGamepadMappings(AMappings);
    end;
  end;

  /// Touch points and gestures (a touch screen; on a desktop the mouse's left button is
  /// touch point 0).
  /// @example `Touch.Enable([TouchGesture.Tap, TouchGesture.Drag]); if Touch.Detected(TouchGesture.Tap) then Select(); end;`
  Touch = object
    /// Touch point 0's x in window pixels. C: GetTouchX
    /// @returns touch point 0's x, in window pixels
    static method X(): int32;
    begin
      return GetTouchX();
    end;

    /// Touch point 0's y in window pixels. C: GetTouchY
    /// @returns touch point 0's y, in window pixels
    static method Y(): int32;
    begin
      return GetTouchY();
    end;

    /// Touch point AIndex's place in window pixels. C: GetTouchPosition
    /// @param AIndex the index, from 0
    /// @returns the point's place, in window pixels
    static method Position(const AIndex: int32): Vector2;
    begin
      return GetTouchPosition(AIndex);
    end;

    /// Touch point AIndex's id (-1 for none). C: GetTouchPointId
    /// @param AIndex the index, from 0
    /// @returns the point's id (-1 for none)
    static method PointId(const AIndex: int32): int32;
    begin
      return GetTouchPointId(AIndex);
    end;

    /// How many points touch now. C: GetTouchPointCount
    /// @returns how many points touch now
    static method Count(): int32;
    begin
      return GetTouchPointCount();
    end;

    /// The gestures raylib looks for (all by default). C: SetGesturesEnabled
    /// @param AGestures the gestures
    static method Enable(const AGestures: TouchGestures);
    begin
      SetGesturesEnabled(uint32(AGestures));
    end;

    /// True when AGesture was made this frame. C: IsGestureDetected
    /// @param AGesture the gesture
    /// @returns `true` when AGesture was made this frame
    static method Detected(const AGesture: TouchGesture): bool;
    begin
      // A gesture's value is its bit (TouchGesture's rule)
      return IsGestureDetected(1u shl uint32(AGesture));
    end;

    /// The gesture made last, as a set: one member, or none when there was none.
    /// C: GetGestureDetected
    /// @returns the gesture made last, as a set: one member, or none when there was none
    static method Last(): TouchGestures;
    begin
      return TouchGestures(uint32(GetGestureDetected()));
    end;

    /// How long the hold gesture lasts, in seconds. C: GetGestureHoldDuration
    /// @returns how long the hold gesture lasts, in seconds
    static method HoldDuration(): float32;
    begin
      return GetGestureHoldDuration();
    end;

    /// The drag gesture's move. C: GetGestureDragVector
    /// @returns the drag gesture's move
    static method DragVector(): Vector2;
    begin
      return GetGestureDragVector();
    end;

    /// The drag gesture's angle in degrees. C: GetGestureDragAngle
    /// @returns the drag gesture's angle in degrees
    static method DragAngle(): float32;
    begin
      return GetGestureDragAngle();
    end;

    /// The pinch gesture's move. C: GetGesturePinchVector
    /// @returns the pinch gesture's move
    static method PinchVector(): Vector2;
    begin
      return GetGesturePinchVector();
    end;

    /// The pinch gesture's angle in degrees. C: GetGesturePinchAngle
    /// @returns the pinch gesture's angle in degrees
    static method PinchAngle(): float32;
    begin
      return GetGesturePinchAngle();
    end;
  end;

// ============================================================================
// Drawing (sec 5): Draw is static, everything between BeginFrame / EndFrame in
// the frame's base units. One name per job: raylib's V / Ex / Rec / Pro forms
// are overloads (the float forms, so base units keep their fractions), a
// thickness is the overload with `AThick`. Spline gives a point on a spline.
// The members drawing a resource (textures, fonts, shaders, render textures,
// video, billboards, the shapes texture, VR) come with their <Name>Res types.
// ============================================================================

var
  // The texture Draw.ShapesTexture set: kept alive while raylib draws shapes with it
  GShapesTexture: TextureRes;

public type
  /// Draws shapes, lines, text and 3D primitives, in the frame's base units (between
  /// BeginFrame and EndFrame; the 3D ones between Begin3D and End3D).
  /// @example `Draw.Circle(Vector2(x: 160, y: 90), 20.0f, RED);`
  Draw = object
    // ---- modes ----

    /// Starts drawing through `ACamera` inside the frame (letterboxed). C: BeginMode2D
    /// @param ACamera the camera, in base units
    /// @example `Draw.Begin2D(LCamera); Draw.Rect(LWall, GRAY); Draw.End2D();`
    static method Begin2D(const ACamera: Camera2D);
    begin
      BeginFrameMode2D(ACamera);
    end;

    /// Ends Begin2D: drawing is through the frame's own camera again. C: EndMode2D
    static method End2D();
    begin
      EndFrameMode2D();
    end;

    /// Starts drawing a 3D scene through `ACamera` inside the frame (its projection at the
    /// base size's aspect, its viewport the letterbox). C: BeginMode3D
    /// @param ACamera the 3D camera
    /// @example `Draw.Begin3D(LCamera); Draw.Grid(10, 1.0f); Draw.End3D();`
    static method Begin3D(const ACamera: Camera3D);
    begin
      BeginFrameMode3D(ACamera);
    end;

    /// Ends Begin3D: drawing is in base units through the frame's camera and clip again.
    /// C: EndMode3D
    static method End3D();
    begin
      EndFrameMode3D();
    end;

    /// Starts blending what is drawn by `ABlend`. C: BeginBlendMode
    /// @param ABlend the blend mode
    /// @example `Draw.BeginBlend(Blend.Additive); Draw.Circle(LSpark, 4.0f, ORANGE); Draw.EndBlend();`
    static method BeginBlend(const ABlend: Blend);
    begin
      BeginBlendMode(int32(ABlend));
    end;

    /// Ends BeginBlend: alpha blending again. C: EndBlendMode
    static method EndBlend();
    begin
      EndBlendMode();
    end;

    /// Drawing lands in `ATarget`, in its pixels, until EndTexture (inside a frame too: the
    /// frame comes back at EndTexture). C: BeginTextureMode
    /// @param ATarget the target
    /// @example `Draw.BeginTexture(LCanvas); Draw.Clear(BLANK); Draw.Circle(LDot, 4.0f, RED); Draw.EndTexture();`
    static method BeginTexture(const ATarget: RenderTextureRes);
    begin
      DoBeginTexture(ATarget.Handle());
    end;

    /// Ends BeginTexture: drawing goes to the window (and the frame) again. C: EndTextureMode
    static method EndTexture();
    begin
      DoEndTexture();
    end;

    /// Drawing goes through `AShader` until EndShader (the shader kept alive until then).
    /// C: BeginShaderMode
    /// @param AShader the shader
    /// @example `Draw.BeginShader(LGlow); Draw.Texture(LScene, Vector2Zero(), WHITE); Draw.EndShader();`
    static method BeginShader(const AShader: ShaderRes);
    begin
      AShader.Begin();
    end;

    /// Ends BeginShader: raylib's default shader again. C: EndShaderMode
    static method EndShader();
    begin
      ShaderRes.End();
    end;

    /// Drawing renders the stereo pair through `AConfig` until EndVR. C: BeginVrStereoMode
    /// @param AConfig the config
    /// @example `Draw.BeginTexture(LTarget); Draw.BeginVR(LVR); Draw.Begin3D(LCam); Draw.Grid(10, 1.0f); Draw.End3D(); Draw.EndVR(); Draw.EndTexture();`
    static method BeginVR(const AConfig: VRStereoRes);
    begin
      AConfig.Begin();
    end;

    /// Ends BeginVR: drawing is single again. C: EndVrStereoMode
    static method EndVR();
    begin
      VRStereoRes.End();
    end;

    /// The texture and its part `ARect` raylib's shapes are drawn with (kept alive while set).
    /// C: SetShapesTexture
    /// @param ATexture the texture
    /// @param ARect the rectangle
    static method ShapesTexture(const ATexture: TextureRes; const ARect: Rectangle);
    begin
      GShapesTexture := ATexture;
      SetShapesTexture(ATexture.Handle(), ARect);
    end;

    /// The texture raylib's shapes are drawn with (a view: raylib's default white pixel
    /// unless ShapesTexture set one). C: GetShapesTexture
    /// @returns the texture raylib's shapes are drawn with (a view: raylib's default white pixel unless ShapesTexture set one)
    static method ShapesTexture(): TextureRes;
    begin
      return TextureRes.View(GetShapesTexture());
    end;

    /// The part of the shapes texture raylib's shapes use. C: GetShapesTextureRectangle
    /// @returns the part of the shapes texture raylib's shapes use
    static method ShapesTextureRect(): Rectangle;
    begin
      return GetShapesTextureRectangle();
    end;

    /// Holds drawing to `ARect`, in base units: inside the frame it is mapped through the
    /// frame's camera and kept within the letterbox. C: BeginScissorMode
    /// @param ARect the area drawing is held to
    /// @example `Draw.BeginScissor(LPanel); Draw.Text(LLog, LPanel.Position(), 10.0f, WHITE); Draw.EndScissor();`
    static method BeginScissor(const ARect: Rectangle);
    var
      LLeft: float32;
      LTop: float32;
      LRight: float32;
      LBottom: float32;
      LWidth: int32;
      LHeight: int32;
    begin
      DoFrameLive();
      if not DoFrameActive() then
        BeginScissorMode(DoRound(ARect.x), DoRound(ARect.y), DoRound(ARect.width),
          DoRound(ARect.height));
        return;
      end;
      // The frame's camera is T(offset) S(zoom) (target 0, no rotation): base units to window
      // units, then the letterbox's edges cut what reaches past them
      LLeft := Max(GFrame.Camera.offset.x + GFrame.Camera.zoom * ARect.x, GFrame.Letterbox.x);
      LTop := Max(GFrame.Camera.offset.y + GFrame.Camera.zoom * ARect.y, GFrame.Letterbox.y);
      LRight := Min(GFrame.Camera.offset.x + GFrame.Camera.zoom * (ARect.x + ARect.width),
        GFrame.Letterbox.x + GFrame.Letterbox.width);
      LBottom := Min(GFrame.Camera.offset.y + GFrame.Camera.zoom * (ARect.y + ARect.height),
        GFrame.Letterbox.y + GFrame.Letterbox.height);
      LWidth := DoRound(LRight) - DoRound(LLeft);
      LHeight := DoRound(LBottom) - DoRound(LTop);
      // An area wholly outside the letterbox holds drawing to nothing
      if LWidth < 0 then
        LWidth := 0;
      end;
      if LHeight < 0 then
        LHeight := 0;
      end;
      BeginScissorMode(DoRound(LLeft), DoRound(LTop), LWidth, LHeight);
    end;

    /// Ends BeginScissor: inside the frame drawing is held to the letterbox again (the
    /// frame's clip), else nothing holds it. C: EndScissorMode
    static method EndScissor();
    begin
      EndScissorMode();
      DoFrameLive();
      if DoFrameActive() then
        DoFrameClip();
      end;
    end;

    // ---- pixels, lines ----

    /// One pixel at `APos`. C: DrawPixel / DrawPixelV
    /// @param APos the position
    /// @param AColor the colour
    static method Pixel(const APos: Vector2; const AColor: Color);
    begin
      DrawPixelV(APos, AColor);
    end;

    /// A line from `AStart` to `AEnd`. C: DrawLine / DrawLineV
    /// @param AStart the start
    /// @param AEnd the end
    /// @param AColor the colour
    /// @example `Draw.Line(LFrom, LTo, WHITE);`
    static method Line(const AStart: Vector2; const AEnd: Vector2; const AColor: Color);
    begin
      DrawLineV(AStart, AEnd, AColor);
    end;

    /// A line `AThick` wide. C: DrawLineEx
    /// @param AStart the start
    /// @param AEnd the end
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method Line(const AStart: Vector2; const AEnd: Vector2; const AThick: float32;
      const AColor: Color);
    begin
      DrawLineEx(AStart, AEnd, AThick, AColor);
    end;

    /// Lines joining `APoints` in order (nothing for fewer than two). C: DrawLineStrip
    /// @param APoints the points
    /// @param AColor the colour
    static method LineStrip(const APoints: array of Vector2; const AColor: Color);
    begin
      if len(APoints) = 0 then
        return;
      end;
      DrawLineStrip(addr of APoints[0], int32(len(APoints)), AColor);
    end;

    /// A cubic-eased curve from `AStart` to `AEnd`, `AThick` wide. C: DrawLineBezier
    /// @param AStart the start
    /// @param AEnd the end
    /// @param AThick the line thickness
    /// @param AColor the colour
    static method LineBezier(const AStart: Vector2; const AEnd: Vector2; const AThick: float32;
      const AColor: Color);
    begin
      DrawLineBezier(AStart, AEnd, AThick, AColor);
    end;

    /// A dashed line: `ADash` drawn, `ASpace` left, in turn. C: DrawLineDashed
    /// @param AStart the start
    /// @param AEnd the end
    /// @param ADash the dash
    /// @param ASpace the space
    /// @param AColor the colour
    static method LineDashed(const AStart: Vector2; const AEnd: Vector2; const ADash: int32;
      const ASpace: int32; const AColor: Color);
    begin
      DrawLineDashed(AStart, AEnd, ADash, ASpace, AColor);
    end;

    // ---- triangles ----

    /// A filled triangle (corners counter-clockwise). C: DrawTriangle
    /// @param AA the first corner
    /// @param AB the second corner
    /// @param AC the third corner
    /// @param AColor the colour
    static method Triangle(const AA: Vector2; const AB: Vector2; const AC: Vector2;
      const AColor: Color);
    begin
      DrawTriangle(AA, AB, AC, AColor);
    end;

    /// A filled triangle shaded between its corners' colors. C: DrawTriangleGradient
    /// @param AA the first corner
    /// @param AB the second corner
    /// @param AC the third corner
    /// @param AColorA the color A
    /// @param AColorB the color B
    /// @param AColorC the color C
    static method Triangle(const AA: Vector2; const AB: Vector2; const AC: Vector2;
      const AColorA: Color; const AColorB: Color; const AColorC: Color);
    begin
      DrawTriangleGradient(AA, AB, AC, AColorA, AColorB, AColorC);
    end;

    /// A triangle's outline. C: DrawTriangleLines
    /// @param AA the first corner
    /// @param AB the second corner
    /// @param AC the third corner
    /// @param AColor the colour
    static method TriangleLines(const AA: Vector2; const AB: Vector2; const AC: Vector2;
      const AColor: Color);
    begin
