  static method CubicHermite(const AV1: Vector3; const ATangent1: Vector3; const AV2: Vector3;
    const ATangent2: Vector3; const AAmount: float32): Vector3;
  begin
    return Vector3CubicHermite(AV1, ATangent1, AV2, ATangent2, AAmount);
