  This file is covered by the Adam Runtime Exception
  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.Raylib.Ext.adam - raylib as Adam objects, over System.Raylib.C (the
  .C unit stays usable beside it; a program imports both, AD.5b). Every
  routine of System.Raylib.C has its home here (a member's `C:` tag names
  the raylib routines it covers) or in the std unit already doing its job
  (files, text, hashes, compression: System.IO, System.SysUtils, System.Hash,
  System.Base64, System.Zlib.Ext); the row raylib\raylib_coverage proves it.

  The value types are the .C unit's own records (Vector2, Vector3,
  Quaternion, Matrix, Color, Rectangle, Ray, BoundingBox, Camera2D,
  Camera3D) given methods and operators by `extend`, so a value goes
  straight into a .C call and back.

  Window is the frame window (raylib's one window per program) as an
  object: a base (virtual) size drawn DPI-scaled (base x zoom x DPI / 96)
  and letterboxed, in base units between BeginFrame and EndFrame (they hold
  BeginDrawing / EndDrawing too), the aspect kept on resize, maximize and
  fullscreen, bars outside it; it follows a DPI change. A copy shares it,
  the last copy's done closes it. It is built fluently by WindowConfig
  (`Window.Config().Size(800, 450).Title("Game").Open()`) or opened by
  `LWin: Window(800, 450, "Game");`. Camera2D / Camera3D Begin / End draw
  the program's camera through the letterbox (the 3D scene at the base
  size's aspect). Monitor, Time, Clipboard, Log (its Handler a closure over
  raylib's formatted trace log), Random, Keyboard, Mouse, Touch, Draw (one
  name per job), Spline and GL (rlgl) are static; a Gamepad is a value
  naming one pad (`Gamepad(0)`).

  Resources are <Name>Res objects, shared handles over the C record (a copy
  shares, the last copy unloads; `Adopt` takes a .C record over, `Handle()`
  lends it back): ImageRes (CPU pixels, changed and drawn on in fluent
  chains), TextureRes, RenderTextureRes, FontRes, GlyphsRes, ShaderRes,
  MeshRes, MaterialRes, ModelRes, ModelAnimationRes; WaveRes, SoundRes,
  MusicRes, AudioStreamRes and VideoRes (MPEG-1 through pl_mpeg, its frame
  drawn by Draw.Video) over the AudioDevice (audio callbacks and processors
  are closures, run on raylib's audio thread); AutomationRes, VRStereoRes.
  Teardown is order-proof: the Window's last release unloads every GPU
  resource still alive before CloseWindow, the AudioDevice's last release
  every sound, music, stream and video before CloseAudioDevice, a window the
  program closes itself gives up its GPU resources with it, and a copy
  released later does nothing.

  Loading: by path from the source Assets mounts (a zip, any IOSource: its
  files become raylib's whole file system through the four file callbacks
  and System.HookIO's path source, so loaders reading siblings, a glTF's
  .bin or an OBJ's .mtl, find them by their path), by IO (`FromIO`) or from
  memory (`FromMemory`). An IO form registers the IO for the call
  (RegisterIO) and hands raylib's own file-name loader the path
  `io://<n>/file<type>`, read through the hooked fopen / fread / fseek, so
  the result is the file-name form's for a file of the same bytes; an IO
  that cannot be registered loads as a missing file. A music stream's IO
  stays registered until the music is unloaded.

  The program icon, with no call of the program's own: the icon @exeicon
  gives is set on raylib's window as GLFW makes it (the platform unit's
  hook); a program's own Window.SetIcon later wins.

  The unit names no OS: the hooked C names it calls (fopen, fread ..) are
  the HookIO platform unit's the target triple picks, and the frame's DPI,
  native window and window hooks are System.Raylib.Ext.Win64's /
  System.Raylib.Ext.Linux64's.
*******************************************************************************/

module unit System.Raylib.Ext;

// System.IO / System.Math come before System.Raylib.C: a bare name two imports export is the
// last one's (BNF sec 1), and raylib's Vector2 / FileExists are this unit's
import System.SysUtils, System.Collections, System.IO, System.Math, System.LibC.C, System.Raylib.C,
  System.CustomIO, System.HookIO, System.HookIO.Core, System.pl_mpeg.C
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64, System.Raylib.Ext.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64, System.Raylib.Ext.Linux64
@endif
  ;

const
  // The prefix no registration ever gives: its paths open as missing files
  ADAM_RAYLIB_NO_PREFIX: string = "io://0";
  // The first room a source callback's whole-file read takes, doubled as it fills
  ADAM_RAYLIB_READ_START: int64 = 65536;
  // The most bytes raylib's int counts
  ADAM_RAYLIB_READ_MAX: int64 = 2147483647;
  // The maps of a material (raylib's MAX_MATERIAL_MAPS, config.h)
  ADAM_RAYLIB_MATERIAL_MAPS: int64 = 12;

var
  // The IOSource SetRaylibIOSource last made HookIO's path source (nil: none).
  // SetRaylibIOSource is one setting for the program, not for several threads
  // at once (as raylib's callbacks are not), so it needs no lock.
  GPathSource: IOSource;
  // The prefix of the IOSource SetRaylibIOSource made raylib's file system
  // ("" when none), under GSourceLock. The lock is held only to read or swap
  // the text, never while a file is opened (the hooks take their own).
  GSourceLock: mutex;
  GSourcePrefix: string;
  // The prefix each music stream from LoadMusicStreamIO keeps registered until
  // UnloadMusicStreamIO, by the stream's ctxData address (unique while it
  // plays), under GMusicLock
  GMusicLock: mutex;
  GMusicPrefixes: Map<uint64, string>;

// Records ASource as the path source SetRaylibIOSource set
func DoRememberPathSource(const ASource: IOSource);
begin
  GPathSource := ASource;
end;

// Unsets HookIO's path source when it is still the one SetRaylibIOSource set; a
// path source the program set since (SetIOPathSource) stays
func DoForgetPathSource();
begin
  if GPathSource <> nil then
    HookIOResetPathSourceIf(GPathSource);
  end;
  GPathSource := nil;
end;

// The current source's prefix ("" when none), read under its lock
func DoSourcePrefix(): string;
var
  LPrefix: string;
begin
  lock (GSourceLock) do
    LPrefix := GSourcePrefix;
  end;
  return LPrefix;
end;

// True when AName holds "io://" at AAt
func DoIsIOPath(const AName: string; const AAt: int64): bool;
begin
  if len(AName) - AAt < 5 then
    return false;
  end;
  return (AName[AAt] = 'i') and (AName[AAt + 1] = 'o') and (AName[AAt + 2] = ':') and
    (AName[AAt + 3] = '/') and (AName[AAt + 4] = '/');
end;

// The path raylib's AFileName names in the current source: an io:// path as it
// is (an IO form's own; after any leading "./" or ".\", which raylib writes
// before a folder with no root, as HookIO reads it), any other as
// `<prefix>/<name>` with '\' turned to '/' and every leading "./" or '/' dropped
// (a source's paths are relative). With no source set, AFileName as it is.
func DoSourcePath(const AFileName: ptr to const char): string;
var
  LName: string;
  LPrefix: string;
  LSkip: int64;
  LAt: int64;
  LI: int64;
  LDropping: bool;
begin
  LName := "";
  if AFileName <> nil then
    LName := StringFromC(AFileName);
  end;
  LPrefix := DoSourcePrefix();
  if len(LPrefix) = 0 then
    return LName;
  end;
  // An IO form's own path, behind the current-folder steps raylib adds
  LSkip := 0;
  while (len(LName) >= LSkip + 2) and (LName[LSkip] = '.') and
    ((LName[LSkip + 1] = '/') or (LName[LSkip + 1] = '\\')) do
    LSkip := LSkip + 2;
  end;
  if DoIsIOPath(LName, LSkip) then
    return LName;
  end;
  for LI := 0 to len(LName) - 1 do
    if LName[LI] = '\\' then
      LName[LI] := '/';
    end;
  end;
  // Every leading "./" and '/', in any order
  LAt := 0;
  LDropping := true;
  while LDropping do
    LDropping := false;
    if (len(LName) - LAt >= 2) and (LName[LAt] = '.') and (LName[LAt + 1] = '/') then
      LAt := LAt + 2;
      LDropping := true;
    else
      if (len(LName) - LAt >= 1) and (LName[LAt] = '/') then
        LAt := LAt + 1;
        LDropping := true;
      end;
    end;
  end;
  return LPrefix + "/" + Substring(LName, LAt, len(LName) - LAt);
end;

// The whole file at APath, opened with AMode through the hooks, in memory from
// raylib's allocator (UnloadFileData / UnloadFileText free it) with AExtra zero
// bytes after it. nil (ASize 0) when it cannot be opened or read, is empty
// (raylib's loaders give nil for an empty file), or holds more than an int counts.
func DoReadFile(const APath: string; const AMode: ptr to const char; const AExtra: int64;
  var ASize: int32): ptr to uint8;
var
  LFile: ptr;
  LData: ptr to uint8;
  LGrown: ptr to uint8;
  LCapacity: int64;
  LCount: int64;
  LGrow: int64;
  LWant: int64;
  LGot: int64;
  LFailed: bool;
  LI: int64;
begin
  ASize := 0;
  LFile := fopen(APath, AMode);
  if LFile = nil then
    return nil;
  end;
  LData := nil;
  LCapacity := 0;
  LCount := 0;
  LFailed := false;
  while true do
    // Room for one more byte past the count and the extra zero bytes
    if LCount + AExtra + 1 > LCapacity then
      LGrow := ADAM_RAYLIB_READ_START;
      if LCapacity > 0 then
        LGrow := LCapacity * 2;
      end;
      if LGrow > ADAM_RAYLIB_READ_MAX then
        LFailed := true;
        leave;
      end;
      LGrown := ptr to uint8(MemRealloc(LData, uint32(LGrow)));
      if LGrown = nil then
        LFailed := true;
        leave;
      end;
      LData := LGrown;
      LCapacity := LGrow;
    end;
    LWant := LCapacity - LCount - AExtra;
    LGot := fread(LData + LCount, 1, LWant, LFile);
    LCount := LCount + LGot;
    if LGot < LWant then
      LFailed := ferror(LFile) <> 0;
      leave;
    end;
  end;
  fclose(LFile);
  if LFailed or (LCount = 0) then
    MemFree(LData);
    return nil;
  end;
  for LI := 0 to AExtra - 1 do
    LData[LCount + LI] := 0;
  end;
  ASize := int32(LCount);
  return LData;
end;

// raylib's file callbacks while a source is set: each opens the source's path
// through the hooks, as raylib's own file functions would open it
func clink DoLoadData(fileName: ptr to const char; dataSize: ptr to int32): ptr to uint8;
var
  LSize: int32;
  LData: ptr to uint8;
begin
  LData := DoReadFile(DoSourcePath(fileName), "rb", 0, LSize);
  if LData = nil then
    TraceLog(LOG_WARNING, "FILEIO: [%s] Failed to load file from the IO source", fileName);
  end;
  if dataSize <> nil then
    dataSize^ := LSize;
  end;
  return LData;
end;

func clink DoLoadText(fileName: ptr to const char): ptr to char;
var
  LSize: int32;
  LText: ptr to char;
begin
  // Text mode, as raylib's LoadFileText opens a file
  LText := ptr to char(DoReadFile(DoSourcePath(fileName), "rt", 1, LSize));
  if LText = nil then
    TraceLog(LOG_WARNING, "FILEIO: [%s] Failed to load text file from the IO source", fileName);
  end;
  return LText;
end;

func clink DoSaveData(fileName: ptr to const char; data: ptr to const; dataSize: int32): bool;
var
  LPath: string;
  LFile: ptr;
  LWritten: int64;
  LWant: int64;
  LClosed: bool;
begin
  LPath := DoSourcePath(fileName);
  LFile := nil;
  LFile := fopen(LPath, "wb");
  if LFile = nil then
    TraceLog(LOG_WARNING, "FILEIO: [%s] Failed to save file to the IO source", fileName);
    return false;
  end;
  LWritten := 0;
  LWant := 0;
  if dataSize > 0 then
    LWant := dataSize;
  end;
  if (data <> nil) and (LWant > 0) then
    LWritten := fwrite(ptr(data), 1, LWant, LFile);
  end;
  LClosed := fclose(LFile) = 0;
  return LClosed and (LWritten = LWant);
end;

func clink DoSaveText(fileName: ptr to const char; text: ptr to const char): bool;
var
  LPath: string;
  LFile: ptr;
  LOk: bool;
begin
  LPath := DoSourcePath(fileName);
  // Text mode, as raylib's SaveFileText opens a file
  LFile := nil;
  LFile := fopen(LPath, "wt");
  if LFile = nil then
    TraceLog(LOG_WARNING, "FILEIO: [%s] Failed to save text file to the IO source", fileName);
    return false;
  end;
  LOk := (text = nil) or (fputs(text, LFile) >= 0);
  if fclose(LFile) <> 0 then
    LOk := false;
  end;
  return LOk;
end;

// Makes APrefix ("" for none) the current source and points raylib's four file
// callbacks at it (none: raylib's own file functions); the prefix it replaces,
// for the caller to unregister
func DoInstallSource(const APrefix: string): string;
var
  LReplaced: string;
  LSet: bool;
begin
  LSet := len(APrefix) <> 0;
  lock (GSourceLock) do
    LReplaced := GSourcePrefix;
    GSourcePrefix := APrefix;
  end;
  if LSet then
    SetLoadFileDataCallback(DoLoadData);
    SetSaveFileDataCallback(DoSaveData);
    SetLoadFileTextCallback(DoLoadText);
    SetSaveFileTextCallback(DoSaveText);
  else
    SetLoadFileDataCallback(nil);
    SetSaveFileDataCallback(nil);
    SetLoadFileTextCallback(nil);
    SetSaveFileTextCallback(nil);
  end;
  return LReplaced;
end;

// Keeps APrefix for the music stream AKey
func DoKeepMusic(const AKey: ptr; const APrefix: string);
begin
  lock (GMusicLock) do
    GMusicPrefixes.Put(uint64(AKey), APrefix);
  end;
end;

// Takes (removes) the prefix kept for the music stream AKey; "" when none is
func DoTakeMusic(const AKey: ptr): string;
var
  LPrefix: string;
begin
  LPrefix := "";
  lock (GMusicLock) do
    if GMusicPrefixes.TryGet(uint64(AKey), LPrefix) then
      GMusicPrefixes.Remove(uint64(AKey));
    end;
  end;
  return LPrefix;
end;

// A letter folded to lower case, as raylib's IsFileExtension compares
func DoLowerChar(const AChar: char): char;
begin
  if (AChar >= 'A') and (AChar <= 'Z') then
    return char(uint8(AChar) - uint8('A') + uint8('a'));
  end;
  return AChar;
end;

// True when AFileType (".ttf", ".PNG", ...) is one of the ';'-separated
// extensions in AList, letter case aside, as raylib's IsFileExtension compares
func DoIsType(const AFileType: ptr to const char; const AList: string): bool;
var
  LType: string;
  LItems: array of string;
  LI: int64;
  LJ: int64;
  LSame: bool;
begin
  if AFileType = nil then
    return false;
  end;
  LType := StringFromC(AFileType);
  LItems := SplitString(AList, ";");
  for LI := 0 to len(LItems) - 1 do
    if len(LItems[LI]) = len(LType) then
      LSame := true;
      for LJ := 0 to len(LType) - 1 do
        if DoLowerChar(LType[LJ]) <> DoLowerChar(LItems[LI][LJ]) then
          LSame := false;
          leave;
        end;
      end;
      if LSame then
        return true;
      end;
    end;
  end;
  return false;
end;

// AIO registered with HookIO for one call: its prefix, or the prefix no
// registration gives when AIO cannot be registered
func DoRegister(const AIO: IO): string;
var
  LPrefix: string;
begin
  LPrefix := RegisterIO(AIO);
  if len(LPrefix) = 0 then
    return ADAM_RAYLIB_NO_PREFIX;
  end;
  return LPrefix;
end;

// ASource registered with HookIO for one call, as DoRegister
func DoRegisterSource(const ASource: IOSource): string;
var
  LPrefix: string;
begin
  LPrefix := RegisterIOSource(ASource);
  if len(LPrefix) = 0 then
    return ADAM_RAYLIB_NO_PREFIX;
  end;
  return LPrefix;
end;

// Ends DoRegister's / DoRegisterSource's registration
func DoUnregister(const APrefix: string);
begin
  if APrefix <> ADAM_RAYLIB_NO_PREFIX then
    UnregisterIO(APrefix);
  end;
end;

// The path raylib is handed: `<prefix>/file<type>` (no type: `<prefix>/file`)
func DoPath(const APrefix: string; const AFileType: ptr to const char): string;
begin
  if AFileType = nil then
    return APrefix + "/file";
  end;
  return APrefix + "/file" + StringFromC(AFileType);
end;

// Loads an image from an IO as LoadImage loads one from a file (raylib's
// own LoadImage reads it through the hooks); unload with UnloadImage.
func LoadImageIO(const AIO: IO; const AFileType: ptr to const char): Image;
var
  LPrefix: string;
  LPath: string;
  LImage: Image;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoPath(LPrefix, AFileType);
  LImage := LoadImage(LPath);
  DoUnregister(LPrefix);
  return LImage;
end;

// Loads a texture from an IO as LoadTexture loads one from a file
// (raylib's own LoadTexture reads it through the hooks); unload with
// UnloadTexture. Needs a window, as LoadTexture does.
func LoadTextureIO(const AIO: IO; const AFileType: ptr to const char): Texture2D;
var
  LPrefix: string;
  LPath: string;
  LTexture: Texture2D;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoPath(LPrefix, AFileType);
  LTexture := LoadTexture(LPath);
  DoUnregister(LPrefix);
  return LTexture;
end;

// Loads a font from an IO as LoadFontEx loads one from a file (raylib's
// own LoadFontEx reads it through the hooks), at AFontSize with the given
// codepoints (nil and 0 for raylib's default set); unload with UnloadFont.
// Needs a window.
func LoadFontExIO(const AIO: IO; const AFileType: ptr to const char;
  const AFontSize: int32; const ACodepoints: ptr to const int32; const ACodepointCount: int32): Font;
var
  LPrefix: string;
  LPath: string;
  LFont: Font;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoPath(LPrefix, AFileType);
  LFont := LoadFontEx(LPath, AFontSize, ACodepoints, ACodepointCount);
  DoUnregister(LPrefix);
  return LFont;
end;

// Loads wave data from an IO as LoadWave loads it from a file (raylib's
// own LoadWave reads it through the hooks); unload with UnloadWave.
func LoadWaveIO(const AIO: IO; const AFileType: ptr to const char): Wave;
var
  LPrefix: string;
  LPath: string;
  LWave: Wave;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoPath(LPrefix, AFileType);
  LWave := LoadWave(LPath);
  DoUnregister(LPrefix);
  return LWave;
end;

// Loads a sound (a sound effect, fully in memory) from an IO as LoadSound
// loads one from a file (raylib's own LoadSound reads it through the
// hooks); unload with UnloadSound. Needs the audio device, as LoadSound
// does.
func LoadSoundIO(const AIO: IO; const AFileType: ptr to const char): Sound;
var
  LPrefix: string;
  LPath: string;
  LSound: Sound;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoPath(LPrefix, AFileType);
  LSound := LoadSound(LPath);
  DoUnregister(LPrefix);
  return LSound;
end;

// Loads a music stream from an IO as LoadMusicStream loads one from a
// file: raylib's own LoadMusicStream opens it through the hooks, and every
// read and seek while it plays goes to the IO (nothing is read ahead into
// memory but what raylib itself reads). The IO stays registered until
// UnloadMusicStreamIO, so it must stay open while the music plays. Unload
// with UnloadMusicStreamIO, never UnloadMusicStream. Needs the audio
// device.
func LoadMusicStreamIO(const AIO: IO; const AFileType: ptr to const char): Music;
var
  LPrefix: string;
  LPath: string;
  LMusic: Music;
begin
  LPrefix := DoRegister(AIO);
  LPath := DoPath(LPrefix, AFileType);
  LMusic := LoadMusicStream(LPath);
  if LMusic.ctxData = nil then
    DoUnregister(LPrefix);
    return LMusic;
  end;
  if LPrefix <> ADAM_RAYLIB_NO_PREFIX then
    DoKeepMusic(LMusic.ctxData, LPrefix);
  end;
  return LMusic;
end;

// Unloads a music stream LoadMusicStreamIO gave (UnloadMusicStream), then
// ends its IO's registration. The IO stays the caller's, to close after.
func UnloadMusicStreamIO(const AMusic: Music);
var
  LPrefix: string;
begin
  LPrefix := DoTakeMusic(AMusic.ctxData);
  UnloadMusicStream(AMusic);
  if len(LPrefix) <> 0 then
    UnregisterIO(LPrefix);
  end;
end;

// Loads a shader from two IOs as LoadShader loads one from two files
// (raylib's own LoadShader reads them through the hooks); unload with
// UnloadShader. Needs a window.
func LoadShaderIO(const AVertex: IO; const AFragment: IO): Shader;
var
  LVertexPrefix: string;
  LFragmentPrefix: string;
  LVertexPath: CString;
  LFragmentPath: CString;
  LShader: Shader;
begin
  LVertexPath := CString();
  LFragmentPath := CString();
  LVertexPrefix := ADAM_RAYLIB_NO_PREFIX;
  LFragmentPrefix := ADAM_RAYLIB_NO_PREFIX;
  if AVertex <> nil then
    LVertexPrefix := DoRegister(AVertex);
    LVertexPath := CString(DoPath(LVertexPrefix, ".vs"));
  end;
  if AFragment <> nil then
    LFragmentPrefix := DoRegister(AFragment);
    LFragmentPath := CString(DoPath(LFragmentPrefix, ".fs"));
  end;
  // LoadShader takes nil for raylib's default shader: a source not given leaves its path ""
  LShader := LoadShader(LVertexPath.OrNil, LFragmentPath.OrNil);
  DoUnregister(LVertexPrefix);
  DoUnregister(LFragmentPrefix);
  return LShader;
end;

// Loads an automation event list from an IO as LoadAutomationEventList
// loads one from a file (raylib's own loader reads it through the hooks);
// unload with UnloadAutomationEventList.
func LoadAutomationEventListIO(const AIO: IO): AutomationEventList;
var
  LPrefix: string;
  LPath: string;
  LList: AutomationEventList;
begin
  if AIO = nil then
    return LoadAutomationEventList(nil);
  end;
  LPrefix := DoRegister(AIO);
  LPath := DoPath(LPrefix, ".rae");
  LList := LoadAutomationEventList(LPath);
  DoUnregister(LPrefix);
  return LList;
end;

// Makes an IOSource raylib's file system: raylib's file callbacks
// (SetLoadFileDataCallback, SetLoadFileTextCallback and the Save pair)
// then open every file name raylib loads or saves in the source, by that
// name as a path in it ('\' as '/', a leading "./" or '/' dropped), through
// the hooks; text loads and saves in text mode, as raylib's own. Paths the
// IO forms hand raylib (`io://...`) still reach their IO. nil restores
// raylib's own file functions (the callbacks set to NULL). raylib keeps
// one set of callbacks for the process with no user data, so this is one
// setting for the whole program, and not for several threads at once, as
// raylib's callbacks are not. The source stays the caller's: unset it
// (nil) before closing it. Setting it replaces callbacks set by
// SetLoadFileDataCallback and the others, and nil leaves none set. It also
// makes the source HookIO's path source (SetIOPathSource), so the files
// raylib's decoders open by plain path themselves (music streams) come
// from it too; nil unsets that path source when it is still the one set
// here (one the program set since with SetIOPathSource stays).
func SetRaylibIOSource(const ASource: IOSource): bool;
var
  LPrefix: string;
  LReplaced: string;
begin
  LPrefix := "";
  if ASource <> nil then
    LPrefix := RegisterIOSource(ASource);
    if len(LPrefix) = 0 then
      return false;
    end;
  end;
  // The plain paths raylib's own decoders open (music streams) bypass the
  // callbacks: the path source routes them to the same source. nil unsets only
  // the path source set here, never one the program set itself.
  if ASource <> nil then
    if not SetIOPathSource(ASource) then
      UnregisterIO(LPrefix);
      return false;
    end;
    DoRememberPathSource(ASource);
  else
    DoForgetPathSource();
  end;
  LReplaced := DoInstallSource(LPrefix);
  if len(LReplaced) <> 0 then
    UnregisterIO(LReplaced);
  end;
  return true;
end;

// ---------------------------------------------------------------------------------------------
// The frame window (pcpp's raylib_ext frame): a window opened at a base (virtual) size x the
// zoom x the monitor's scale (DPI / 96), drawn in base units through a letterboxed Camera2D,
// the mouse mapped back to them. The DPI is the OS's, asked through the platform unit.
// ---------------------------------------------------------------------------------------------

// GLFW names raylib links statically (its header is not shipped): the monitor list and a
// monitor's work area
func glfwGetMonitors(const ACount: ptr to int32): ptr to ptr; external "raylib";
func glfwGetMonitorWorkarea(const AMonitor: ptr; const AX: ptr to int32; const AY: ptr to int32;
  const AWidth: ptr to int32; const AHeight: ptr to int32); external "raylib";

const
  // The DPI the base size is drawn for (scale 1)
  ADAM_RAYLIB_BASE_DPI: int32 = 96;

type
  // The frame as it stands
  FrameWindow = record
    Open: bool;
    BaseWidth: int32;
    BaseHeight: int32;
    DPI: int32;
    // FLAG_WINDOW_HIGHDPI was set too: raylib sized the window and maps the mouse itself, so
    // the frame window never resizes for the DPI (no stacking)
    RaylibScales: bool;
    // SetFrameIntegerScale: the letterbox a whole multiple of the base size
    IntegerScale: bool;
    // SetFrameZoom: the window's normal size is base x Zoom x the DPI scale
    Zoom: float32;
    FrameColor: Color;
    BarColor: Color;
    Camera: Camera2D;
    Letterbox: Rectangle;
    Mouse: Vector2;
    LastDPICheck: float64;
    // The native window (Windows' HWND, X11's Window id): its destruction is the frame's close
    NativeWindow: uint64;
    // Between BeginFrame and EndFrame
    Drawing: bool;
    // Between a render texture's Begin and End: the frame's camera and clip are off
    InTexture: bool;
    // Borderless (Window.ToggleBorderless): undecorated over its monitor, and the place and
    // size it goes back to
    Borderless: bool;
    RestoreX: int32;
    RestoreY: int32;
    RestoreWidth: int32;
    RestoreHeight: int32;
  end;

var
  // The frame (raylib's one window per program; raylib's calls are one thread's, so no lock);
  // GFrameReady false until its settings got their defaults (DoFrameState)
  GFrame: FrameWindow;
  GFrameReady: bool;

// AFrame as no frame window: zeroed, the DPI the base's, the colours WHITE / BLACK, no
// integer scale, zoom 1
func DoFrameDefaults(var AFrame: FrameWindow);
begin
  AFrame.Open := false;
  AFrame.BaseWidth := 0;
  AFrame.BaseHeight := 0;
  AFrame.DPI := ADAM_RAYLIB_BASE_DPI;
  AFrame.RaylibScales := false;
  AFrame.IntegerScale := false;
  AFrame.Zoom := 1.0f;
  AFrame.FrameColor := WHITE;
  AFrame.BarColor := BLACK;
  AFrame.Camera.offset := Vector2(x: 0.0f, y: 0.0f);
  AFrame.Camera.target := Vector2(x: 0.0f, y: 0.0f);
  AFrame.Camera.rotation := 0.0f;
  AFrame.Camera.zoom := 0.0f;
  AFrame.Letterbox := Rectangle(x: 0.0f, y: 0.0f, width: 0.0f, height: 0.0f);
  AFrame.Mouse := Vector2(x: 0.0f, y: 0.0f);
  AFrame.LastDPICheck := 0.0;
  AFrame.NativeWindow := 0;
  AFrame.Drawing := false;
  AFrame.InTexture := false;
  AFrame.Borderless := false;
  AFrame.RestoreX := 0;
  AFrame.RestoreY := 0;
  AFrame.RestoreWidth := 0;
  AFrame.RestoreHeight := 0;
end;

// AFrame back to "no frame window", the frame and bar colours, the integer-scale rule and
// the zoom (the program's settings) kept
func DoFrameReset(var AFrame: FrameWindow);
var
  LFrameColor: Color;
  LBarColor: Color;
  LIntegerScale: bool;
  LZoom: float32;
begin
  LFrameColor := AFrame.FrameColor;
  LBarColor := AFrame.BarColor;
  LIntegerScale := AFrame.IntegerScale;
  LZoom := AFrame.Zoom;
  DoFrameDefaults(AFrame);
  AFrame.FrameColor := LFrameColor;
  AFrame.BarColor := LBarColor;
  AFrame.IntegerScale := LIntegerScale;
  AFrame.Zoom := LZoom;
end;

// The frame's settings given their defaults the first time it is read
func DoFrameState();
begin
  if not GFrameReady then
    DoFrameDefaults(GFrame);
    GFrameReady := true;
  end;
end;

// The frame as it stands, read by every frame routine. Its close is seen as its native
// window goes (DoFrameWindowGone, from CloseWindow through GLFW), so a window opened after it
// is never taken for the frame; a frame whose raylib window is not there is closed too.
func DoFrameLive();
begin
  DoFrameState();
  if GFrame.Open and not IsWindowReady() then
    DoFrameReset(GFrame);
  end;
end;

// True when drawing goes through the frame: a frame window is open and no render texture
// takes the drawing (inside one, the frame's modes are raylib's own)
func DoFrameActive(): bool;
begin
  return GFrame.Open and not GFrame.InTexture;
end;

forward func DoGPUGone(const AWindow: uint64);

var
  // raylib's window as the layer knows it: the id of the window open now, its native window
  // number, and whether that window has gone (a later window, even one the OS gives the
  // same number, takes a new id)
  GWindowId: uint64;
  GWindowIdNative: uint64;
  GWindowIdGone: bool;

// The platform unit's notice: the native window AWindow goes (the frame's own: closed); the
// GPU resources on it go with it, and its id is never given again
func DoFrameWindowGone(const AWindow: uint64);
var
  LId: uint64;
begin
  LId := 0;
  if (AWindow <> 0) and (AWindow = GWindowIdNative) and not GWindowIdGone then
    LId := GWindowId;
    GWindowIdGone := true;
  end;
  DoGPUGone(LId);
  DoFrameState();
  if GFrame.Open and (AWindow <> 0) and (AWindow = GFrame.NativeWindow) then
    DoFrameReset(GFrame);
  end;
end;

// raylib's window as an id of the layer's own, one per window raylib opens (0 when none is
// open): what a Window value and a GPU resource keep to know their window. Native numbers
// can come back for a later window (X11 reuses a closed window's XID); ids never do
func DoWindowId(): uint64;
var
  LNative: uint64;
begin
  if not IsWindowReady() then
    return 0;
  end;
  LNative := RaylibPlatformNativeWindow(GetWindowHandle());
  if (LNative <> GWindowIdNative) or GWindowIdGone then
    GWindowId += 1;
    GWindowIdNative := LNative;
    GWindowIdGone := false;
    // Its close is heard whoever closes it (a plain raylib window's too)
    RaylibPlatformSetWindowGone(DoFrameWindowGone);
  end;
  return GWindowId;
end;

// The DPI raylib's window is shown at now (the platform's answer; the base DPI when it has
// none)
func DoQueryDPI(): int32;
var
  LDPI: int32;
begin
  // No window, no native handle to ask (raylib's GetWindowHandle reads GLFW's window)
  if not IsWindowReady() then
    return ADAM_RAYLIB_BASE_DPI;
  end;
  LDPI := RaylibPlatformQueryDPI(GetWindowHandle());
  if LDPI <= 0 then
    return ADAM_RAYLIB_BASE_DPI;
  end;
  return LDPI;
end;

// C's lround of a float32 / float64 (halfway away from zero) as an int32
func DoRound(const AValue: float32): int32;
begin
  return int32(lroundf(AValue));
end;

func DoRound(const AValue: float64): int32;
begin
  return int32(lround(AValue));
end;

// The frame's base size x its zoom, each side rounded: the window's normal size at 96 DPI
// (the DPI scale goes on top, DoScaledSize)
func DoZoomedWidth(): int32;
begin
  return DoRound(float32(GFrame.BaseWidth) * GFrame.Zoom);
end;

func DoZoomedHeight(): int32;
begin
  return DoRound(float32(GFrame.BaseHeight) * GFrame.Zoom);
end;

// ABase scaled for ADPI, each side rounded
func DoScaledSize(const ABaseWidth: int32; const ABaseHeight: int32; const ADPI: int32): Vector2;
var
  LScale: float64;
begin
  LScale := float64(ADPI) / float64(ADAM_RAYLIB_BASE_DPI);
  return Vector2(x: float32(DoRound(float64(ABaseWidth) * LScale)),
    y: float32(DoRound(float64(ABaseHeight) * LScale)));
end;

// The rectangle (window units) that fits ABase's aspect into AWindow, centred, bars outside
// it; the whole window when a size is 0 or less
func DoLetterbox(const AWindowWidth: int32; const AWindowHeight: int32; const ABaseWidth: int32;
  const ABaseHeight: int32): Rectangle;
var
  LRect: Rectangle;
  LWindowRatio: float32;
  LBaseRatio: float32;
begin
  LRect := Rectangle(x: 0.0f, y: 0.0f, width: float32(AWindowWidth), height: float32(AWindowHeight));
  if (AWindowWidth <= 0) or (AWindowHeight <= 0) or (ABaseWidth <= 0) or (ABaseHeight <= 0) then
    return LRect;
  end;
  LWindowRatio := float32(AWindowWidth) / float32(AWindowHeight);
  LBaseRatio := float32(ABaseWidth) / float32(ABaseHeight);
  if LWindowRatio >= LBaseRatio then
    // Wider than the frame: bars left and right
    LRect.width := float32(AWindowHeight) * LBaseRatio;
    LRect.x := (float32(AWindowWidth) - LRect.width) / 2.0f;
  else
    // Taller than the frame: bars above and below
    LRect.height := float32(AWindowWidth) / LBaseRatio;
    LRect.y := (float32(AWindowHeight) - LRect.height) / 2.0f;
  end;
  return LRect;
end;

// The rectangle (window units) of the largest WHOLE multiple of ABase that fits into
// AWindow, centred on whole pixels, bars around it. The multiple is taken in framebuffer
// pixels (APixelsPerUnit of them per window unit), so each base pixel covers the same square
// of real pixels on a scaled display too. A window smaller than one base size gets the fit
// rule instead (never an empty frame); a size of 0 gives the whole window.
func DoIntegerLetterbox(const AWindowWidth: int32; const AWindowHeight: int32;
  const ABaseWidth: int32; const ABaseHeight: int32; const APixelsPerUnit: float32): Rectangle;
var
  LPixelWidth: int32;
  LPixelHeight: int32;
  LMultiple: int32;
  LWidth: int32;
  LHeight: int32;
  LX: int32;
  LY: int32;
begin
  if (AWindowWidth <= 0) or (AWindowHeight <= 0) or (ABaseWidth <= 0) or (ABaseHeight <= 0) or
    (APixelsPerUnit <= 0.0f) then
    return DoLetterbox(AWindowWidth, AWindowHeight, ABaseWidth, ABaseHeight);
  end;
  LPixelWidth := DoRound(float32(AWindowWidth) * APixelsPerUnit);
  LPixelHeight := DoRound(float32(AWindowHeight) * APixelsPerUnit);
  LMultiple := LPixelWidth div ABaseWidth;
  if LPixelHeight div ABaseHeight < LMultiple then
    LMultiple := LPixelHeight div ABaseHeight;
  end;
  if LMultiple < 1 then
    return DoLetterbox(AWindowWidth, AWindowHeight, ABaseWidth, ABaseHeight);
  end;
  // Whole pixels throughout: the size is exact, the centring rounds down
  LWidth := ABaseWidth * LMultiple;
  LHeight := ABaseHeight * LMultiple;
  LX := (LPixelWidth - LWidth) div 2;
  LY := (LPixelHeight - LHeight) div 2;
  return Rectangle(x: float32(LX) / APixelsPerUnit, y: float32(LY) / APixelsPerUnit,
    width: float32(LWidth) / APixelsPerUnit, height: float32(LHeight) / APixelsPerUnit);
end;

// The frame's letterbox for the window as it is now, under its rule (fit, or a whole
// multiple): the one rule BeginFrame, the mouse and GetFrameLetterbox share
func DoLetterboxNow(): Rectangle;
var
  LPixelsPerUnit: float32;
begin
  if not GFrame.IntegerScale then
    return DoLetterbox(GetScreenWidth(), GetScreenHeight(), GFrame.BaseWidth, GFrame.BaseHeight);
  end;
  // Framebuffer pixels per window unit: more than 1 when raylib scales the window itself
  // (FLAG_WINDOW_HIGHDPI)
  LPixelsPerUnit := 1.0f;
  if GetScreenWidth() > 0 then
    LPixelsPerUnit := float32(GetRenderWidth()) / float32(GetScreenWidth());
  end;
  return DoIntegerLetterbox(GetScreenWidth(), GetScreenHeight(), GFrame.BaseWidth,
    GFrame.BaseHeight, LPixelsPerUnit);
end;

// AValue held to [ALow, AHigh] (std::clamp's rule)
func DoClamp(const AValue: float32; const ALow: float32; const AHigh: float32): float32;
begin
  if AValue < ALow then
    return ALow;
  end;
  if AHigh < AValue then
    return AHigh;
  end;
  return AValue;
end;

// A window point (window units) in frame units through the letterbox ALetterbox of a ABase
// frame, clamped to the frame and rounded
func DoFramePoint(const APoint: Vector2; const ALetterbox: Rectangle; const ABaseWidth: int32;
  const ABaseHeight: int32): Vector2;
var
  LX: float32;
  LY: float32;
begin
  if (ALetterbox.width <= 0.0f) or (ALetterbox.height <= 0.0f) or (ABaseWidth <= 0) or
    (ABaseHeight <= 0) then
    return Vector2(x: 0.0f, y: 0.0f);
  end;
  LX := (APoint.x - ALetterbox.x) * float32(ABaseWidth) / ALetterbox.width;
  LY := (APoint.y - ALetterbox.y) * float32(ABaseHeight) / ALetterbox.height;
  return Vector2(x: float32(DoRound(DoClamp(LX, 0.0f, float32(ABaseWidth - 1)))),
    y: float32(DoRound(DoClamp(LY, 0.0f, float32(ABaseHeight - 1)))));
end;

// The window at the base size x the zoom x the scale (a window at its normal size only:
// fullscreen, borderless, maximized and minimized are the system's), centred on its
// monitor's work area when ACenter
func DoApplyScale(const ACenter: bool);
var
  LSize: Vector2;
  LMonitor: int32;
  LMonitors: ptr to ptr;
  LCount: int32;
  LAreaX: int32;
  LAreaY: int32;
  LAreaWidth: int32;
  LAreaHeight: int32;
  LPosition: Vector2;
  LLeft: int32;
  LTop: int32;
begin
  DoFrameLive();
  if GFrame.RaylibScales or GFrame.Borderless or IsWindowFullscreen() or
    IsWindowState(uint32(FLAG_BORDERLESS_WINDOWED_MODE)) or IsWindowMaximized() or
    IsWindowMinimized() then
    return;
  end;
  LSize := DoScaledSize(DoZoomedWidth(), DoZoomedHeight(), GFrame.DPI);
  SetWindowSize(int32(LSize.x), int32(LSize.y));
  if not ACenter then
    return;
  end;

  LCount := 0;
  LAreaX := 0;
  LAreaY := 0;
  LAreaWidth := 0;
  LAreaHeight := 0;
  LMonitor := GetCurrentMonitor();
  LMonitors := glfwGetMonitors(addr of LCount);
  if (LMonitors <> nil) and (LMonitor >= 0) and (LMonitor < LCount) then
    glfwGetMonitorWorkarea(LMonitors[LMonitor], addr of LAreaX, addr of LAreaY,
      addr of LAreaWidth, addr of LAreaHeight);
  end;
  if (LAreaWidth <= 0) or (LAreaHeight <= 0) then
    LPosition := GetMonitorPosition(LMonitor);
    LAreaX := int32(LPosition.x);
    LAreaY := int32(LPosition.y);
    LAreaWidth := GetMonitorWidth(LMonitor);
    LAreaHeight := GetMonitorHeight(LMonitor);
  end;
  // Centred; a window larger than the area starts at its top left
  LLeft := (LAreaWidth - int32(LSize.x)) div 2;
  if LLeft < 0 then
    LLeft := 0;
  end;
  LTop := (LAreaHeight - int32(LSize.y)) div 2;
  if LTop < 0 then
    LTop := 0;
  end;
  SetWindowPosition(LAreaX + LLeft, LAreaY + LTop);
end;

// The DPI asked again when its check is due (each frame on Windows, a cheap call; once a
// second on X11, a round trip to the server); a change resizes the window
// The frame window borderless on or off (Window.ToggleBorderless's work): undecorated, placed
// and sized to the monitor it is on, then back to its place and size. Done by the frame itself
// with plain moves and resizes, never the window manager's fullscreen: GLFW's (raylib's
// ToggleBorderlessWindowed) asks for a monitor's fullscreen, which some window managers spread
// over every monitor (WSLg) and restore wrongly
func DoToggleFrameBorderless();
var
  LMonitor: int32;
  LPlace: Vector2;
  LWidth: int32;
  LHeight: int32;
begin
  DoFrameLive();
  if not GFrame.Open then
    return;
  end;
  if GFrame.Borderless then
    GFrame.Borderless := false;
    ClearWindowState(uint32(FLAG_WINDOW_UNDECORATED));
    SetWindowSize(GFrame.RestoreWidth, GFrame.RestoreHeight);
    SetWindowPosition(GFrame.RestoreX, GFrame.RestoreY);
    return;
  end;
  LMonitor := GetCurrentMonitor();
  LPlace := GetMonitorPosition(LMonitor);
  LWidth := GetMonitorWidth(LMonitor);
  LHeight := GetMonitorHeight(LMonitor);
  if (LWidth <= 0) or (LHeight <= 0) then
    return;
  end;
  // Where it goes back to: its place and size now
  LPlace := GetWindowPosition();
  GFrame.RestoreX := int32(LPlace.x);
  GFrame.RestoreY := int32(LPlace.y);
  GFrame.RestoreWidth := GetScreenWidth();
  GFrame.RestoreHeight := GetScreenHeight();
  GFrame.Borderless := true;
  LPlace := GetMonitorPosition(LMonitor);
  SetWindowState(uint32(FLAG_WINDOW_UNDECORATED));
  SetWindowPosition(int32(LPlace.x), int32(LPlace.y));
  SetWindowSize(LWidth, LHeight);
end;

func DoFollowDPI();
var
  LDPI: int32;
begin
  if GetTime() - GFrame.LastDPICheck < ADAM_RAYLIB_DPI_CHECK_SECONDS then
    return;
  end;
  GFrame.LastDPICheck := GetTime();
  LDPI := DoQueryDPI();
  if LDPI = GFrame.DPI then
    return;
  end;
  GFrame.DPI := LDPI;
  DoApplyScale(false);
end;

// The frame's clip: drawing held to the letterbox, in whole window units (BeginFrame's and
// RestoreFrameClip's one rule)
func DoFrameClip();
begin
  BeginScissorMode(DoRound(GFrame.Letterbox.x), DoRound(GFrame.Letterbox.y),
    DoRound(GFrame.Letterbox.width), DoRound(GFrame.Letterbox.height));
end;

// ACamera (in base units) composed with the frame's camera: raylib's BeginMode2D replaces
// the matrix, so the two are folded into one. The frame's camera is T(offset) S(zoom) (target
// 0, no rotation); a uniform scale commutes with a rotation, so the product is again one
// Camera2D
func DoFrameCompose(const ACamera: Camera2D): Camera2D;
var
  LResult: Camera2D;
begin
  LResult := ACamera;
  LResult.offset.x := GFrame.Camera.offset.x + GFrame.Camera.zoom * ACamera.offset.x;
  LResult.offset.y := GFrame.Camera.offset.y + GFrame.Camera.zoom * ACamera.offset.y;
  LResult.zoom := GFrame.Camera.zoom * ACamera.zoom;
  return LResult;
end;

// The letterbox in framebuffer pixels, as rlViewport takes it: HIGHDPI renders above the
// window's size (render / screen is the pixel scale), and GL's viewport origin is the
// framebuffer's bottom-left corner
func DoFrameViewport();
var
  LScaleX: float32;
  LScaleY: float32;
  LX: int32;
  LWidth: int32;
  LHeight: int32;
  LBottom: int32;
begin
  LScaleX := 1.0f;
  LScaleY := 1.0f;
  if (GetScreenWidth() > 0) and (GetScreenHeight() > 0) then
    LScaleX := float32(GetRenderWidth()) / float32(GetScreenWidth());
    LScaleY := float32(GetRenderHeight()) / float32(GetScreenHeight());
  end;
  LX := DoRound(GFrame.Letterbox.x * LScaleX);
  LWidth := DoRound(GFrame.Letterbox.width * LScaleX);
  LHeight := DoRound(GFrame.Letterbox.height * LScaleY);
  LBottom := DoRound((GFrame.Letterbox.y + GFrame.Letterbox.height) * LScaleY);
  rlViewport(LX, GetRenderHeight() - LBottom, LWidth, LHeight);
end;

// ACamera's projection at the frame's base aspect: raylib's BeginMode3D rule (rcore.c), with
// the base size in place of the framebuffer's
func DoFrameProjection(const ACamera: Camera3D);
var
  LAspect: float64;
  LNear: float64;
  LFar: float64;
  LTop: float64;
  LRight: float64;
begin
  LAspect := float64(GFrame.BaseWidth) / float64(GFrame.BaseHeight);
  LNear := rlGetCullDistanceNear();
  LFar := rlGetCullDistanceFar();
  rlMatrixMode(RL_PROJECTION);
  rlLoadIdentity();
  if ACamera.projection = CAMERA_PERSPECTIVE then
    LTop := LNear * tan(float64(ACamera.fovy) * 0.5 * float64(DEG2RAD));
    LRight := LTop * LAspect;
    rlFrustum(-LRight, LRight, -LTop, LTop, LNear, LFar);
  else
    if ACamera.projection = CAMERA_ORTHOGRAPHIC then
      LTop := float64(ACamera.fovy) / 2.0;
      LRight := LTop * LAspect;
      rlOrtho(-LRight, LRight, -LTop, LTop, LNear, LFar);
    end;
  end;
  rlMatrixMode(RL_MODELVIEW);
end;

// Opens raylib's window as a frame window: ABaseWidth x ABaseHeight is the base (virtual)
// size everything is drawn in. The window opens at the base size x the frame's zoom
// (SetFrameZoom, 1 by default) x the monitor's scale (GetFrameDPI / 96), centred on its
// monitor's work area, resizable, and takes a new size when the DPI changes (a move to
// another monitor). Draw between BeginFrame and EndFrame in base units; on resize, maximize
// or fullscreen the frame keeps its aspect (letterboxed, or a whole multiple with
// SetFrameIntegerScale), bars outside it. SetConfigFlags before it adds flags (raylib's).
// CloseWindow closes the frame too (GetFrameWidth 0 again, the frame and bar colours, the
// integer scale and the zoom kept).
func InitFrameWindow(const ABaseWidth: int32; const ABaseHeight: int32;
  const ATitle: ptr to const char): bool;
begin
  DoFrameLive();
  // A frame has a size; one window per program (raylib's rule)
  if (ABaseWidth <= 0) or (ABaseHeight <= 0) or IsWindowReady() then
    return false;
  end;
  RaylibPlatformSetWindowGone(DoFrameWindowGone);
  GFrame.BaseWidth := ABaseWidth;
  GFrame.BaseHeight := ABaseHeight;
  // At the zoomed size (raylib scales it on top itself with FLAG_WINDOW_HIGHDPI; otherwise
  // DoApplyScale does below)
  SetConfigFlags(uint32(FLAG_WINDOW_RESIZABLE));
  InitWindow(DoZoomedWidth(), DoZoomedHeight(), ATitle);
  if not IsWindowReady() then
    GFrame.BaseWidth := 0;
    GFrame.BaseHeight := 0;
    return false;
  end;
  GFrame.Open := true;
  GFrame.NativeWindow := RaylibPlatformNativeWindow(GetWindowHandle());
  GFrame.RaylibScales := IsWindowState(uint32(FLAG_WINDOW_HIGHDPI));
  GFrame.DPI := DoQueryDPI();
  GFrame.LastDPICheck := GetTime();
  DoApplyScale(true);
  return true;
end;

// BeginFrame's work (Window.BeginFrame's too)
func DoBeginFrame();
begin
  DoFrameLive();
  if not GFrame.Open then
    return;
  end;
  DoFollowDPI();
  // The letterbox follows the window's size as it is now (a resize needs no call)
  GFrame.Letterbox := DoLetterboxNow();
  GFrame.Camera.offset := Vector2(x: GFrame.Letterbox.x, y: GFrame.Letterbox.y);
  GFrame.Camera.target := Vector2(x: 0.0f, y: 0.0f);
  GFrame.Camera.rotation := 0.0f;
  GFrame.Camera.zoom := GFrame.Letterbox.width / float32(GFrame.BaseWidth);
  // The bars: the whole window; then the frame, clipped to it
  ClearBackground(GFrame.BarColor);
  DoFrameClip();
  BeginMode2D(GFrame.Camera);
  GFrame.Drawing := true;
  DrawRectangle(0, 0, GFrame.BaseWidth, GFrame.BaseHeight, GFrame.FrameColor);
  GFrame.Mouse := DoFramePoint(GetMousePosition(), GFrame.Letterbox, GFrame.BaseWidth,
    GFrame.BaseHeight);
end;

// EndFrame's work (Window.EndFrame's too)
func DoEndFrame();
begin
  DoFrameLive();
  if not GFrame.Open then
    return;
  end;
  // A render texture left open ends first (its own camera and clip are raylib's)
  if GFrame.InTexture then
    EndTextureMode();
    GFrame.InTexture := false;
  end;
  GFrame.Drawing := false;
  EndMode2D();
  EndScissorMode();
end;

// Begins drawing the frame (inside BeginDrawing): the whole window cleared to the bar
// colour, then drawing held to the letterbox in base units (GetFrameCamera's Camera2D), the
// frame filled with its colour, and the mouse taken (GetFrameMousePosition). Does nothing
// with no frame window.
func BeginFrame();
begin
  DoBeginFrame();
end;

// Ends BeginFrame: drawing is in window units again, unclipped (for a HUD over the bars).
// Does nothing with no frame window.
func EndFrame();
begin
  DoEndFrame();
end;

// Draws through ACamera (in base units) inside the frame: raylib's BeginMode2D would replace
// the frame's camera, so use this pair inside BeginFrame / EndFrame. With no frame window it
// is raylib's BeginMode2D.
func BeginFrameMode2D(const ACamera: Camera2D);
begin
  DoFrameLive();
  if not DoFrameActive() then
    BeginMode2D(ACamera);
    return;
  end;
  BeginMode2D(DoFrameCompose(ACamera));
end;

// Ends BeginFrameMode2D: drawing is in base units through the frame's own camera again.
// With no frame window it is raylib's EndMode2D.
func EndFrameMode2D();
begin
  DoFrameLive();
  // Back to the frame's own camera (raylib's EndMode2D would leave window units)
  if not DoFrameActive() then
    EndMode2D();
    return;
  end;
  BeginMode2D(GFrame.Camera);
end;

// Draws a 3D scene through ACamera inside the frame: the scene's projection is at the base
// size's aspect and its viewport the letterbox, where raylib's BeginMode3D takes the whole
// window's aspect, so use this pair inside BeginFrame / EndFrame. With no frame window it is
// raylib's BeginMode3D.
func BeginFrameMode3D(const ACamera: Camera3D);
begin
  DoFrameLive();
  // raylib's BeginMode3D first: the batch drawn, the 2D projection saved, the view matrix,
  // the depth test; then the projection and the viewport are the letterbox's (the frame's
  // Camera2D and clip stay as they are)
  BeginMode3D(ACamera);
  if not DoFrameActive() then
    return;
  end;
  DoFrameProjection(ACamera);
  DoFrameViewport();
end;

// Ends BeginFrameMode3D: drawing is in base units through the frame's own camera and clip
// again, as BeginFrame set them. With no frame window it is raylib's EndMode3D.
func EndFrameMode3D();
begin
  // raylib's EndMode3D: the batch drawn, the 2D projection back, the depth test off; then
  // raylib's own viewport (desktop GLFW sets no render offset) and the frame's camera and
  // clip, as BeginFrame left them
  EndMode3D();
  DoFrameLive();
  if not DoFrameActive() then
    return;
  end;
  rlViewport(0, 0, GetRenderWidth(), GetRenderHeight());
  BeginMode2D(GFrame.Camera);
  DoFrameClip();
end;

// Turns the frame's clip on again, as BeginFrame set it (drawing held to the letterbox): for
// code between BeginFrame and EndFrame that turned raylib's scissor off or changed it. Does
// nothing with no frame window.
func RestoreFrameClip();
begin
  DoFrameLive();
  if not DoFrameActive() then
    return;
  end;
  DoFrameClip();
end;

// The frame's base width (InitFrameWindow's); 0 with no frame window.
func GetFrameWidth(): int32;
begin
  DoFrameLive();
  return GFrame.BaseWidth;
end;

// The frame's base height (InitFrameWindow's); 0 with no frame window.
func GetFrameHeight(): int32;
begin
  DoFrameLive();
  return GFrame.BaseHeight;
end;

// The DPI the frame window is sized for (the monitor's, followed as it changes); 96 with no
// frame window.
func GetFrameDPI(): int32;
begin
  DoFrameLive();
  return GFrame.DPI;
end;

// The monitor's scale the frame window is sized for: GetFrameDPI / 96.
func GetFrameScale(): float32;
begin
  return float32(GetFrameDPI()) / 96.0f;
end;

// The DPI raylib's window is shown at now (a frame window or not; the monitor's): Windows
// the window's own, X11's Xft.dpi; 96 when the OS gives none.
func GetWindowDPI(): int32;
begin
  return DoQueryDPI();
end;

// The mouse at BeginFrame, in base units, clamped to the frame (0 to the base size - 1) and
// rounded; 0, 0 with no frame window.
func GetFrameMousePosition(): Vector2;
begin
  DoFrameLive();
  return GFrame.Mouse;
end;

// The Camera2D BeginFrame draws through (its offset is the letterbox's top left, its zoom
// window units per base unit): for raylib's own world / screen mapping.
func GetFrameCamera(): Camera2D;
begin
  DoFrameLive();
  return GFrame.Camera;
end;

// Sets the colour the frame is filled with at BeginFrame (WHITE by default).
func SetFrameColor(const AColor: Color);
begin
  DoFrameLive();
  GFrame.FrameColor := AColor;
end;

// The colour the frame is filled with at BeginFrame.
func GetFrameColor(): Color;
begin
  DoFrameLive();
  return GFrame.FrameColor;
end;

// Sets the colour of the bars around the frame (BLACK by default).
func SetFrameBarColor(const AColor: Color);
begin
  DoFrameLive();
  GFrame.BarColor := AColor;
end;

// The colour of the bars around the frame.
func GetFrameBarColor(): Color;
begin
  DoFrameLive();
  return GFrame.BarColor;
end;

// Turns integer scaling on or off: on, the frame is the largest whole multiple of the base
// size that fits the window (GetIntegerLetterboxRect's rule, taken in real framebuffer
// pixels), so every base pixel is the same square of screen pixels (pixel art); off (the
// default), it fills the window at its aspect (GetLetterboxRect's rule). It may be set before
// InitFrameWindow and holds until changed; BeginFrame, GetFrameMousePosition and
// GetFrameLetterbox follow it at once.
func SetFrameIntegerScale(const AEnabled: bool);
begin
  DoFrameLive();
  GFrame.IntegerScale := AEnabled;
end;

// Whether the frame is integer scaled (SetFrameIntegerScale).
func IsFrameIntegerScale(): bool;
begin
  DoFrameLive();
  return GFrame.IntegerScale;
end;

// Sets the frame's zoom: the window's normal size is the base size x the zoom x the
// monitor's scale (a 320 x 180 game at zoom 4 opens at 1280 x 720 on a 96 DPI monitor);
// drawing stays in base units, the frame only bigger when the window is bigger. Set it
// before InitFrameWindow for the first size; on an open frame window the window takes its
// new normal size at once (not while fullscreen, maximized or minimized). A zoom of 0 or less
// is 1. It holds until changed, over a CloseWindow too.
func SetFrameZoom(const AZoom: float32);
begin
  DoFrameLive();
  // A zoom of 0 or less (or not a number) is no zoom: 1
  if AZoom > 0.0f then
    GFrame.Zoom := AZoom;
  else
    GFrame.Zoom := 1.0f;
  end;
  if GFrame.Open then
    DoApplyScale(false);
  end;
end;

// The frame's zoom (SetFrameZoom).
func GetFrameZoom(): float32;
begin
  DoFrameLive();
  return GFrame.Zoom;
end;

// The frame's rectangle in the window now, in window units, under its rule (fit, or a whole
// multiple with SetFrameIntegerScale): where BeginFrame draws the frame this frame. Code that
// maps between the window and the frame outside BeginFrame / EndFrame uses it; empty with no
// frame window.
func GetFrameLetterbox(): Rectangle;
begin
  DoFrameLive();
  if not GFrame.Open then
    return Rectangle(x: 0.0f, y: 0.0f, width: 0.0f, height: 0.0f);
  end;
  return DoLetterboxNow();
end;

// ---------------------------------------------------------------------------------------------
// The video player (pcpp's raylib_ext video; CONCEPT from sfml_ext's sfx::Video::Impl, in
// raylib's procedural form): pl_mpeg decodes an MPEG-1 video with its MP2 audio from a
// CustomIO IO; the audio goes through a raylib AudioStream fed from UpdateVideo on the
// caller's thread; a frame is three plane textures drawn through a YCbCr -> RGB shader
// (pl_mpeg_player_gl.c's Rec. 601 matrix), or, where the shader does not load, one RGBA
// texture converted on the CPU (the same picture). GPU resources are made at the first frame
// decoded with a window open, so a video can be loaded before InitWindow.
// ---------------------------------------------------------------------------------------------

public type
  /// Where a video stands: VideoStopped (at its start, no frame shown until it plays),
  /// VideoPlaying, or VideoPaused (where it was, its frame still drawn). A video starts
  /// stopped; one that does not loop is stopped again at its end.
  /// @example `if GetVideoStatus(LIntro) = VideoStatus.VideoStopped then PlayVideo(LIntro); end;`
  /// @since 0.1
  /// @see GetVideoStatus
  VideoStatus = choices(
    VideoStopped,  /// Stopped: at its start (or its end, when it does not loop), no frame shown until it plays.
    VideoPlaying,  /// Playing.
    VideoPaused);  /// Paused where it was, its frame still drawn.

  /// Called on every change of a video's status: by PlayVideo, PauseVideo and StopVideo when
  /// they change it, and by UpdateVideo at the end of a video that does not loop
  /// (VideoStopped). A call that changes nothing (PlayVideo on a playing video) calls nothing,
  /// and neither does UnloadVideo.
  /// @example `func OnVideo(const AStatus: VideoStatus; const AName: ptr to const char); begin ... end;`
  /// @since 0.1
  /// @see SetVideoStatusCallback
  VideoStatusCallback = func(const AStatus: VideoStatus; const AName: ptr to const char);

  /// An MPEG-1 video (pl_mpeg) with its MP2 audio, used as raylib's Music is: load it with
  /// LoadVideo, LoadVideoIO or LoadVideoZip, PlayVideo it, call UpdateVideo once a frame and
  /// DrawVideo it, then UnloadVideo it. The record is a handle: copies name the same video.
  /// Every routine takes a video that did not load (ctxData nil) and does nothing with it,
  /// giving 0, false or VideoStopped.
  /// @example `LIntro := LoadVideoZip("$P:assets.zip", "res/assets/videos/intro.mpg", ""); PlayVideo(LIntro);`
  /// @since 0.1
  /// @see LoadVideo
  Video = record
    /// The player; nil when the video did not load (IsVideoValid)
    ctxData: ptr;
    /// The frame width in pixels; 0 when the video did not load
    width: int32;
    /// The frame height in pixels; 0 when the video did not load
    height: int32;
  end;

const
  // The audio stream's chunk, in sample frames, and the most the queue holds (seconds of
  // sound); two channels always (a mono track decodes as two equal channels)
  ADAM_RAYLIB_VIDEO_CHUNK_FRAMES: int32 = 4096;
  ADAM_RAYLIB_VIDEO_QUEUE_SECONDS: int32 = 2;
  ADAM_RAYLIB_VIDEO_CHANNELS: int32 = 2;
  // pl_mpeg_player_gl.c's fragment shader in raylib's GLSL 330 form: the Y plane is
  // texture0, Cb / Cr half its size with the same padding (so the same coordinates); Rec. 601
  // video range; colDiffuse / fragColor keep a tint
  ADAM_RAYLIB_VIDEO_SHADER: string = R"(#version 330
in vec2 fragTexCoord;
in vec4 fragColor;
uniform sampler2D texture0;
uniform sampler2D texture_cb;
uniform sampler2D texture_cr;
uniform vec4 colDiffuse;
out vec4 finalColor;
const mat4 rec601 = mat4(
    1.16438,  0.00000,  1.59603, -0.87079,
    1.16438, -0.39176, -0.81297,  0.52959,
    1.16438,  2.01723,  0.00000, -1.08139,
    0.0,      0.0,      0.0,      1.0);
void main()
{
    float y = texture(texture0, fragTexCoord).r;
    float cb = texture(texture_cb, fragTexCoord).r;
    float cr = texture(texture_cr, fragTexCoord).r;
    finalColor = vec4(y, cb, cr, 1.0) * rec601 * colDiffuse * fragColor;
}
)";

type
  // One video's player, behind Video.ctxData: made by create (zeroed), never moved (pl_mpeg
  // keeps the address of Stream), freed by DoVideoClose: its buffers are getmem blocks
  // freed there, its name a string destroy releases.
  VideoPlayer = record
    Plm: ptr to plm_t;
    Stream: plm_stream_t;
    Source: IO;
    OwnsSource: bool;
    // The name the status callback is given
    Name: string;
    Width: int32;
    Height: int32;
    Status: VideoStatus;
    Loop: bool;
    Volume: float32;
    Callback: VideoStatusCallback;
    // GPU state: decided at the first frame with a window (Decided)
    Decided: bool;
    GPU: bool;
    YuvShader: Shader;
    LocCb: int32;
    LocCr: int32;
    PlaneY: Texture2D;
    PlaneCb: Texture2D;
    PlaneCr: Texture2D;
    // The CPU path's RGBA texture and its pixels (Width x Height x 4 bytes)
    Frame: Texture2D;
    Pixels: ptr to uint8;
    // The frame the last decode gave (the video callback's), nil when none
    Pending: ptr to plm_frame_t;
    HasFrame: bool;
    // Audio: the video has a track (HasTrack); the stream plays it when the audio device
    // was ready at the load (HasAudio)
    HasTrack: bool;
    HasAudio: bool;
    SampleRate: int32;
    Audio: AudioStream;
    AudioStarted: bool;
    // The decoded samples waiting for the stream: a ring of QueueMax int16 samples (whole
    // sample frames: they come and go in pairs), QueueCount of them from QueueHead
    Queue: ptr to int16;
    QueueHead: int64;
    QueueCount: int64;
    QueueMax: int64;
    // One stream chunk (ADAM_RAYLIB_VIDEO_CHUNK_FRAMES sample frames)
    Chunk: ptr to int16;
    // PerformanceCounter at the last update (or play)
    Last: int64;
  end;

// The player behind a Video's ctxData (nil: no player)
func DoPlayer(const AContext: ptr): ptr to VideoPlayer;
begin
  return ptr to VideoPlayer(AContext);
end;

// pl_mpeg's read callback: up to count bytes of the player's IO (0 at its end or a failure)
func clink DoVideoRead(user: ptr; dest: ptr; count: uint64): uint64;
var
  LGot: int64;
begin
  LGot := IORead(DoPlayer(user)^.Source, dest, int64(count));
  if LGot > 0 then
    return uint64(LGot);
  end;
  return 0;
end;

// pl_mpeg's seek callback: the player's IO to position from its start (1 when it got there)
func clink DoVideoSeek(user: ptr; position: uint64): int32;
begin
  if IOSeek(DoPlayer(user)^.Source, int64(position), SeekOrigin.FromStart) = int64(position) then
    return 1;
  end;
  return 0;
end;

// pl_mpeg's video decode callback: the newest frame kept for the update to upload
func clink DoVideoOnFrame(self_: ptr to plm_t; frame: ptr to plm_frame_t; user: ptr);
begin
  DoPlayer(user)^.Pending := frame;
end;

// One sample into the queue; a full queue drops its oldest sample (so a pair of pushes drops
// a whole sample frame from the front)
func DoVideoQueuePush(const APlayer: ptr to VideoPlayer; const ASample: int16);
begin
  APlayer^.Queue[(APlayer^.QueueHead + APlayer^.QueueCount) mod APlayer^.QueueMax] := ASample;
  if APlayer^.QueueCount < APlayer^.QueueMax then
    APlayer^.QueueCount := APlayer^.QueueCount + 1;
  else
    APlayer^.QueueHead := (APlayer^.QueueHead + 1) mod APlayer^.QueueMax;
  end;
end;

// pl_mpeg's audio decode callback: the samples (two channels, -1 .. 1) as int16 into the
// queue (rounded half away from zero, std::lround's rule)
func clink DoVideoOnSamples(self_: ptr to plm_t; samples: ptr to plm_samples_t; user: ptr);
var
  LPlayer: ptr to VideoPlayer;
  LCount: int64;
  LI: int64;
  LValue: float32;
begin
  LPlayer := DoPlayer(user);
  if not LPlayer^.HasAudio then
    return;
  end;
  LCount := int64(samples^.count) * int64(ADAM_RAYLIB_VIDEO_CHANNELS);
  for LI := 0 to LCount - 1 do
    LValue := DoClamp(samples^.interleaved[LI], -1.0f, 1.0f);
    DoVideoQueuePush(LPlayer, int16(lroundf(LValue * 32767.0f)));
  end;
end;

// A grayscale texture of AWidth x AHeight (one byte a pixel), point filtered: each Cb / Cr
// sample then covers its 2x2 luma block as in plm_frame_to_rgba, so the shader draws the CPU
// path's picture (an RGBA texture, raylib's default point filter) at every scale; bilinear
// chroma blends across every color edge and gives a different picture. An empty texture
// (id 0) when it cannot be made.
func DoVideoPlane(const AWidth: int32; const AHeight: int32): Texture2D;
var
  LImage: Image;
  LTexture: Texture2D;
  LSize: int64;
begin
  LSize := int64(AWidth) * int64(AHeight);
  LImage.data := getmem(LSize);
  if LImage.data = nil then
    return LTexture;
  end;
  memset(LImage.data, 0, uint64(LSize));
  LImage.width := AWidth;
  LImage.height := AHeight;
  LImage.mipmaps := 1;
  LImage.format := PIXELFORMAT_UNCOMPRESSED_GRAYSCALE;
  LTexture := LoadTextureFromImage(LImage);
  freemem(LImage.data);
  if LTexture.id <> 0 then
    SetTextureFilter(LTexture, TEXTURE_FILTER_POINT);
  end;
  return LTexture;
end;

// One plane into its texture, made (or made again) at the plane's size
func DoVideoUpload(var ATexture: Texture2D; const APlane: plm_plane_t): bool;
var
  LWidth: int32;
  LHeight: int32;
begin
  LWidth := int32(APlane.width);
  LHeight := int32(APlane.height);
  if (ATexture.id = 0) or (ATexture.width <> LWidth) or (ATexture.height <> LHeight) then
    if ATexture.id <> 0 then
      UnloadTexture(ATexture);
    end;
    ATexture := DoVideoPlane(LWidth, LHeight);
    if ATexture.id = 0 then
      return false;
    end;
  end;
  UpdateTexture(ATexture, APlane.data);
  return true;
end;

// The GPU / CPU choice, once, with a window: the shader when it loads, else the RGBA
// texture and its pixel buffer. False while no window is open (nothing decided).
func DoVideoDecide(const APlayer: ptr to VideoPlayer): bool;
var
  LImage: Image;
  LNone: Shader;
  LSize: int64;
begin
  if APlayer^.Decided then
    return true;
  end;
  if not IsWindowReady() then
    return false;
  end;
  APlayer^.YuvShader := LoadShaderFromMemory(nil, ADAM_RAYLIB_VIDEO_SHADER);
  // raylib hands back its default shader when the code does not compile: not this video's
  APlayer^.GPU := (APlayer^.YuvShader.id <> 0) and
    (APlayer^.YuvShader.id <> rlGetShaderIdDefault());
  if APlayer^.GPU then
    APlayer^.LocCb := GetShaderLocation(APlayer^.YuvShader, "texture_cb");
    APlayer^.LocCr := GetShaderLocation(APlayer^.YuvShader, "texture_cr");
  else
    APlayer^.YuvShader := LNone;
    // plm_frame_to_rgba leaves the alpha bytes as they are: opaque
    LSize := int64(APlayer^.Width) * int64(APlayer^.Height) * 4;
    APlayer^.Pixels := ptr to uint8(getmem(LSize));
    if APlayer^.Pixels <> nil then
      memset(APlayer^.Pixels, 255, uint64(LSize));
      LImage.data := APlayer^.Pixels;
      LImage.width := APlayer^.Width;
      LImage.height := APlayer^.Height;
      LImage.mipmaps := 1;
      LImage.format := PIXELFORMAT_UNCOMPRESSED_R8G8B8A8;
      APlayer^.Frame := LoadTextureFromImage(LImage);
    end;
  end;
  APlayer^.Decided := true;
  return true;
end;

// Back to the start: the audio stopped and emptied, no frame shown
func DoVideoRewind(const APlayer: ptr to VideoPlayer);
begin
  if APlayer^.HasAudio then
    StopAudioStream(APlayer^.Audio);
  end;
  APlayer^.QueueHead := 0;
  APlayer^.QueueCount := 0;
  APlayer^.AudioStarted := false;
  if APlayer^.Plm <> nil then
    plm_rewind(APlayer^.Plm);
  end;
  APlayer^.Pending := nil;
  APlayer^.HasFrame := false;
end;

// Everything a player holds freed (its own IO closed), then the player
func DoVideoClose(var APlayer: ptr to VideoPlayer);
begin
  if APlayer = nil then
    return;
  end;
  DoVideoRewind(APlayer);
  if APlayer^.HasAudio then
    UnloadAudioStream(APlayer^.Audio);
  end;
  if APlayer^.Plm <> nil then
    plm_destroy(APlayer^.Plm);
  end;
  if APlayer^.GPU then
    UnloadShader(APlayer^.YuvShader);
  end;
  if APlayer^.PlaneY.id <> 0 then
    UnloadTexture(APlayer^.PlaneY);
  end;
  if APlayer^.PlaneCb.id <> 0 then
    UnloadTexture(APlayer^.PlaneCb);
  end;
  if APlayer^.PlaneCr.id <> 0 then
    UnloadTexture(APlayer^.PlaneCr);
  end;
  if APlayer^.Frame.id <> 0 then
    UnloadTexture(APlayer^.Frame);
  end;
  if APlayer^.Pixels <> nil then
    freemem(APlayer^.Pixels);
  end;
  if APlayer^.Queue <> nil then
    freemem(APlayer^.Queue);
  end;
  if APlayer^.Chunk <> nil then
    freemem(APlayer^.Chunk);
  end;
  if APlayer^.OwnsSource and (APlayer^.Source <> nil) then
    IOClose(APlayer^.Source);
  end;
  destroy(APlayer);
end;

// The player's audio: a stream when the video has a track and the audio device is ready
// (else the video plays silently), its queue and chunk, pl_mpeg's audio decode set up. The
// audio is turned off when there is no stream to play it.
func DoVideoOpenAudio(const APlayer: ptr to VideoPlayer);
begin
  if APlayer^.HasTrack and IsAudioDeviceReady() then
    SetAudioStreamBufferSizeDefault(ADAM_RAYLIB_VIDEO_CHUNK_FRAMES);
    APlayer^.Audio := LoadAudioStream(uint32(APlayer^.SampleRate), 16,
      uint32(ADAM_RAYLIB_VIDEO_CHANNELS));
    SetAudioStreamBufferSizeDefault(0);
    APlayer^.HasAudio := IsAudioStreamValid(APlayer^.Audio);
  end;
  if APlayer^.HasAudio then
    APlayer^.QueueMax := int64(APlayer^.SampleRate) * int64(ADAM_RAYLIB_VIDEO_CHANNELS) *
      int64(ADAM_RAYLIB_VIDEO_QUEUE_SECONDS);
    APlayer^.Queue := ptr to int16(getmem(APlayer^.QueueMax * size(int16)));
    APlayer^.Chunk := ptr to int16(getmem(int64(ADAM_RAYLIB_VIDEO_CHUNK_FRAMES) *
      int64(ADAM_RAYLIB_VIDEO_CHANNELS) * size(int16)));
    if (APlayer^.Queue = nil) or (APlayer^.Chunk = nil) then
      // No room for the sound: the video plays silently
      UnloadAudioStream(APlayer^.Audio);
      APlayer^.HasAudio := false;
    end;
  end;
  if APlayer^.HasAudio then
    SetAudioStreamVolume(APlayer^.Audio, PerceivedVolume(APlayer^.Volume, 1.0f));
    plm_set_audio_enabled(APlayer^.Plm, 1);
    plm_set_audio_stream(APlayer^.Plm, 0);
    plm_set_audio_decode_callback(APlayer^.Plm, DoVideoOnSamples, APlayer);
    // Two MP2 frames ahead of the video, as sfml_ext's player decodes them
    plm_set_audio_lead_time(APlayer^.Plm,
      float64(PLM_AUDIO_SAMPLES_PER_FRAME) * 2.0 / float64(APlayer^.SampleRate));
  else
    plm_set_audio_enabled(APlayer^.Plm, 0);
  end;
end;

// A player over ASource (taken: closed on a failure when AOwns); nil when it is no MPEG-1
// video (no headers, no video stream, no size)
func DoVideoOpen(const ASource: IO; const AOwns: bool; const AName: string): ptr to VideoPlayer;
var
  LPlayer: ptr to VideoPlayer;
  LSize: int64;
  LPlm: ptr to plm_t;
  LValid: bool;
begin
  if ASource = nil then
    return nil;
  end;
  LSize := IOSize(ASource);
  if LSize <= 0 then
    if AOwns then
      IOClose(ASource);
    end;
    return nil;
  end;
  create(LPlayer);
  LPlayer^.Source := ASource;
  LPlayer^.OwnsSource := AOwns;
  LPlayer^.Name := AName;
  LPlayer^.Status := VideoStatus.VideoStopped;
  LPlayer^.Volume := 1.0f;
  LPlayer^.LocCb := -1;
  LPlayer^.LocCr := -1;
  IOSeek(ASource, 0, SeekOrigin.FromStart);
  LPlayer^.Stream.read := DoVideoRead;
  LPlayer^.Stream.seek := DoVideoSeek;
  LPlayer^.Stream.length := uint64(LSize);
  LPlayer^.Stream.user := LPlayer;
  LPlm := plm_create_with_stream(addr of LPlayer^.Stream);
  LValid := false;
  if LPlm <> nil then
    LValid := (plm_has_headers(LPlm) <> 0) and (plm_get_num_video_streams(LPlm) >= 1) and
      (plm_get_width(LPlm) > 0) and (plm_get_height(LPlm) > 0);
  end;
  if not LValid then
    if LPlm <> nil then
      plm_destroy(LPlm);
    end;
    DoVideoClose(LPlayer);
    return nil;
  end;
  LPlayer^.Plm := LPlm;
  LPlayer^.Width := plm_get_width(LPlm);
  LPlayer^.Height := plm_get_height(LPlm);
  LPlayer^.SampleRate := plm_get_samplerate(LPlm);
  LPlayer^.HasTrack := (plm_get_num_audio_streams(LPlm) > 0) and (LPlayer^.SampleRate > 0);
  DoVideoOpenAudio(LPlayer);
  plm_set_video_decode_callback(LPlm, DoVideoOnFrame, LPlayer);
  plm_set_loop(LPlm, 0);
  return LPlayer;
end;

// The video's record from a player (nil: the empty record)
func DoVideoRecord(const APlayer: ptr to VideoPlayer): Video;
var
  LVideo: Video;
begin
  if APlayer <> nil then
    LVideo.ctxData := APlayer;
    LVideo.width := APlayer^.Width;
    LVideo.height := APlayer^.Height;
  end;
  return LVideo;
end;

// A status change told to the player's callback (none set: nothing)
func DoVideoNotify(const APlayer: ptr to VideoPlayer);
var
  LCallback: VideoStatusCallback;
begin
  LCallback := APlayer^.Callback;
  if LCallback <> nil then
    LCallback(APlayer^.Status, APlayer^.Name);
  end;
end;

// The status changes: each true when it changed the status
func DoVideoPlay(const APlayer: ptr to VideoPlayer): bool;
begin
  if APlayer^.Status = VideoStatus.VideoPlaying then
    return false;
  end;
  // The audio resumes where it paused; from the start, once a decode gave its first samples
  // (no silence ahead of the picture)
  if APlayer^.HasAudio and APlayer^.AudioStarted then
    ResumeAudioStream(APlayer^.Audio);
  end;
  APlayer^.Status := VideoStatus.VideoPlaying;
  APlayer^.Last := PerformanceCounter();
  return true;
end;

func DoVideoPause(const APlayer: ptr to VideoPlayer): bool;
begin
  if APlayer^.Status <> VideoStatus.VideoPlaying then
    return false;
  end;
  if APlayer^.HasAudio and APlayer^.AudioStarted then
    PauseAudioStream(APlayer^.Audio);
  end;
  APlayer^.Status := VideoStatus.VideoPaused;
  return true;
end;

func DoVideoStop(const APlayer: ptr to VideoPlayer): bool;
begin
  if APlayer^.Status = VideoStatus.VideoStopped then
    return false;
  end;
  DoVideoRewind(APlayer);
  APlayer^.Status := VideoStatus.VideoStopped;
  return true;
end;

// The audio stream fed: every processed buffer gets the next chunk of the queue, silence
// where it has none (an underrun keeps the stream going)
func DoVideoFeed(const APlayer: ptr to VideoPlayer);
var
  LWant: int64;
  LTake: int64;
  LI: int64;
begin
  if (not APlayer^.HasAudio) or (not APlayer^.AudioStarted) then
    return;
  end;
  LWant := int64(ADAM_RAYLIB_VIDEO_CHUNK_FRAMES) * int64(ADAM_RAYLIB_VIDEO_CHANNELS);
  while IsAudioStreamProcessed(APlayer^.Audio) do
    LTake := APlayer^.QueueCount;
    if LTake > LWant then
      LTake := LWant;
    end;
    for LI := 0 to LWant - 1 do
      if LI < LTake then
        APlayer^.Chunk[LI] := APlayer^.Queue[(APlayer^.QueueHead + LI) mod APlayer^.QueueMax];
      else
        APlayer^.Chunk[LI] := 0;
      end;
    end;
    APlayer^.QueueHead := (APlayer^.QueueHead + LTake) mod APlayer^.QueueMax;
    APlayer^.QueueCount := APlayer^.QueueCount - LTake;
    UpdateAudioStream(APlayer^.Audio, APlayer^.Chunk, ADAM_RAYLIB_VIDEO_CHUNK_FRAMES);
  end;
end;

// The decoded frame (Pending) uploaded, once a window is open: the three planes for the
// shader, else the CPU conversion into the RGBA texture
func DoVideoShowPending(const APlayer: ptr to VideoPlayer);
begin
  if APlayer^.Pending = nil then
    return;
  end;
  if not DoVideoDecide(APlayer) then
    return;
  end;
  if APlayer^.GPU then
    if DoVideoUpload(APlayer^.PlaneY, APlayer^.Pending^.y) and
      DoVideoUpload(APlayer^.PlaneCb, APlayer^.Pending^.cb) and
      DoVideoUpload(APlayer^.PlaneCr, APlayer^.Pending^.cr) then
      APlayer^.HasFrame := true;
    end;
  else
    if APlayer^.Frame.id <> 0 then
      plm_frame_to_rgba(APlayer^.Pending, APlayer^.Pixels, APlayer^.Width * 4);
      UpdateTexture(APlayer^.Frame, APlayer^.Pixels);
      APlayer^.HasFrame := true;
    end;
  end;
end;

// One update of ASeconds (< 0: the real time since the last update): the decode, the last
// frame's upload (a window open), the audio's start and feed, and the end of a video that
// does not loop (back to its start, stopped). True when the end changed the status.
func DoVideoUpdate(const APlayer: ptr to VideoPlayer; const ASeconds: float64): bool;
var
  LNow: int64;
  LStep: float64;
begin
  if APlayer^.Status <> VideoStatus.VideoPlaying then
    return false;
  end;
  LNow := PerformanceCounter();
  LStep := ASeconds;
  if LStep < 0.0 then
    LStep := float64(LNow - APlayer^.Last) / float64(PerformanceFrequency());
  end;
  APlayer^.Last := LNow;
  APlayer^.Pending := nil;
  if LStep > 0.0 then
    plm_decode(APlayer^.Plm, LStep);
  end;
  DoVideoShowPending(APlayer);
  APlayer^.Pending := nil;
  if APlayer^.HasAudio and (not APlayer^.AudioStarted) and (APlayer^.QueueCount > 0) then
    APlayer^.AudioStarted := true;
    DoVideoFeed(APlayer);
    PlayAudioStream(APlayer^.Audio);
  else
    DoVideoFeed(APlayer);
  end;
  // pl_mpeg starts a looping video again itself; one that does not loop stops at its start
  if plm_has_ended(APlayer^.Plm) <> 0 then
    DoVideoRewind(APlayer);
    APlayer^.Status := VideoStatus.VideoStopped;
    return true;
  end;
  return false;
end;

// Loads a video from an IO: an MPEG-1 video (with or without MP2 audio) read through the IO
// while it plays, so the IO must stay open until UnloadVideo (which leaves it open: it stays
// the caller's). The audio plays through raylib's audio device when it is ready
// (InitAudioDevice first); without it the video plays silently. A window is not needed to
// load: frames are uploaded once one is open.
func LoadVideoIO(const AIO: IO; const AName: string): Video;
begin
  return DoVideoRecord(DoVideoOpen(AIO, false, AName));
end;

// Loads a video from a file (UTF-8 path; $P: / $D: prefixes resolved): LoadVideoIO's rules
// over a file IO the video owns.
func LoadVideo(const AFileName: string): Video;
begin
  return DoVideoRecord(DoVideoOpen(CreateFileIO(AFileName, FileMode.Read), true, AFileName));
end;

// True when the video loaded (ctxData set)
func IsVideoValid(const AVideo: Video): bool;
begin
  return AVideo.ctxData <> nil;
end;

// Plays the video (from where it paused, or from its start)
func PlayVideo(const AVideo: Video);
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer <> nil then
    if DoVideoPlay(LPlayer) then
      DoVideoNotify(LPlayer);
    end;
  end;
end;

// Pauses a playing video where it is
func PauseVideo(const AVideo: Video);
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer <> nil then
    if DoVideoPause(LPlayer) then
      DoVideoNotify(LPlayer);
    end;
  end;
end;

// Stops the video back at its start (no frame shown until it plays)
func StopVideo(const AVideo: Video);
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer <> nil then
    if DoVideoStop(LPlayer) then
      DoVideoNotify(LPlayer);
    end;
  end;
end;

// Moves the player to ASeconds (pl_mpeg clamps it to the video): the audio emptied as a rewind does,
// pl_mpeg's exact seek (its video callback gives the frame at that time, its audio callback
// the first samples after it), that frame uploaded at once (a window open), the clock reset
// so the next update steps from here. A stopped video is paused at its new place. True when
// pl_mpeg got there.
func DoVideoSeekTo(const APlayer: ptr to VideoPlayer; const ASeconds: float64): bool;
var
  LTime: float64;
begin
  // pl_mpeg clamps the time to its video itself; only NaN passes both of its compares, so
  // anything not above 0 is the start here
  LTime := ASeconds;
  if not (LTime > 0.0) then
    LTime := 0.0;
  end;
  if APlayer^.HasAudio then
    StopAudioStream(APlayer^.Audio);
  end;
  APlayer^.QueueHead := 0;
  APlayer^.QueueCount := 0;
  APlayer^.AudioStarted := false;
  APlayer^.Pending := nil;
  if plm_seek(APlayer^.Plm, LTime, 1) = 0 then
    // pl_mpeg found no frame there: the video stays where its decoder now is, unshown
    APlayer^.HasFrame := false;
    return false;
  end;
  DoVideoShowPending(APlayer);
  APlayer^.Pending := nil;
  APlayer^.Last := PerformanceCounter();
  if APlayer^.Status = VideoStatus.VideoStopped then
    APlayer^.Status := VideoStatus.VideoPaused;
  end;
  return true;
end;

// Moves the video to `ASeconds` from its start, the frame at that time shown at once (a
// window open), as a seek bar does. The time is clamped to the video (below 0 or NaN: its
// start; past its last frame: that frame). A playing video plays on from there, a paused one
// stays paused there, and a stopped one is paused there (the status callback told), so its
// frame is drawn; PlayVideo then plays from that place. The audio picks up at the new place
// with no sound from the old one.
// pl_mpeg found no frame (the video then shows none until it plays on)
func SeekVideo(const AVideo: Video; const ASeconds: float64): bool;
var
  LPlayer: ptr to VideoPlayer;
  LWasStopped: bool;
  LSought: bool;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return false;
  end;
  LWasStopped := LPlayer^.Status = VideoStatus.VideoStopped;
  LSought := DoVideoSeekTo(LPlayer, ASeconds);
  if LWasStopped and (LPlayer^.Status <> VideoStatus.VideoStopped) then
    DoVideoNotify(LPlayer);
  end;
  return LSought;
end;

// Advances a playing video by the real time since its last update (call once a frame):
// decodes, uploads the newest frame, feeds the audio; the end of a video that does not loop
// stops it at its start.
func UpdateVideo(const AVideo: Video);
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer <> nil then
    if DoVideoUpdate(LPlayer, -1.0) then
      DoVideoNotify(LPlayer);
    end;
  end;
end;

// UpdateVideo by a given step instead of the real time
func UpdateVideo(const AVideo: Video; const ASeconds: float64);
var
  LPlayer: ptr to VideoPlayer;
  LStep: float64;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return;
  end;
  LStep := ASeconds;
  // Not a positive step (NaN included): nothing decoded
  if not (LStep > 0.0) then
    LStep := 0.0;
  end;
  if DoVideoUpdate(LPlayer, LStep) then
    DoVideoNotify(LPlayer);
  end;
end;

// The video's status
func GetVideoStatus(const AVideo: Video): VideoStatus;
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return VideoStatus.VideoStopped;
  end;
  return LPlayer^.Status;
end;

// True while the video plays
func IsVideoPlaying(const AVideo: Video): bool;
begin
  return GetVideoStatus(AVideo) = VideoStatus.VideoPlaying;
end;

// Sets whether the video starts again at its end
func SetVideoLooping(const AVideo: Video; const ALoop: bool);
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return;
  end;
  LPlayer^.Loop := ALoop;
  if ALoop then
    plm_set_loop(LPlayer^.Plm, 1);
  else
    plm_set_loop(LPlayer^.Plm, 0);
  end;
end;

// True when the video starts again at its end
func IsVideoLooping(const AVideo: Video): bool;
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return false;
  end;
  return LPlayer^.Loop;
end;

// Sets the video's volume, 0 .. 1 (clamped; NaN as 0), heard through System.Math's
// PerceivedVolume so equal steps sound equal
func SetVideoVolume(const AVideo: Video; const AVolume: float32);
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return;
  end;
  if AVolume > 0.0f then
    LPlayer^.Volume := DoClamp(AVolume, 0.0f, 1.0f);
  else
    LPlayer^.Volume := 0.0f;
  end;
  if LPlayer^.HasAudio then
    SetAudioStreamVolume(LPlayer^.Audio, PerceivedVolume(LPlayer^.Volume, 1.0f));
  end;
end;

// The video's volume as set (0 .. 1)
func GetVideoVolume(const AVideo: Video): float32;
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return 0.0f;
  end;
  return LPlayer^.Volume;
end;

// Sets the routine called on every status change (nil: none)
func SetVideoStatusCallback(const AVideo: Video;
  const ACallback: VideoStatusCallback);
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer <> nil then
    LPlayer^.Callback := ACallback;
  end;
end;

// The video's frame rate (frames a second); 0 with no video
func GetVideoFrameRate(const AVideo: Video): float64;
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return 0.0;
  end;
  return plm_get_framerate(LPlayer^.Plm);
end;

// The video's length in seconds (the last frame's start plus one frame)
func GetVideoDuration(const AVideo: Video): float64;
var
  LPlayer: ptr to VideoPlayer;
  LSeconds: float64;
  LRate: float64;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return 0.0;
  end;
  // pl_mpeg's duration spans the first frame's start to the last frame's start: the video
  // plays one frame longer
  LSeconds := plm_get_duration(LPlayer^.Plm);
  LRate := plm_get_framerate(LPlayer^.Plm);
  if LRate > 0.0 then
    LSeconds := LSeconds + 1.0 / LRate;
  end;
  return LSeconds;
end;

// Where the video is, in seconds from its start
func GetVideoTime(const AVideo: Video): float64;
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return 0.0;
  end;
  return plm_get_time(LPlayer^.Plm);
end;

// True when the video has an audio track (whether or not the audio device plays it)
func HasVideoAudio(const AVideo: Video): bool;
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return false;
  end;
  return LPlayer^.HasTrack;
end;

// The audio track's sample rate (0 with none)
func GetVideoSampleRate(const AVideo: Video): int32;
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return 0;
  end;
  return LPlayer^.SampleRate;
end;

// True when the video is drawn through its YCbCr shader (else converted on the CPU);
// decided at the first frame with a window open
func IsVideoShaderUsed(const AVideo: Video): bool;
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return false;
  end;
  return LPlayer^.GPU;
end;

// Draws part of the current frame (ASource in the frame's pixels) placed, scaled and rotated
// as DrawTexturePro draws; nothing before the first frame
func DrawVideoPro(const AVideo: Video; const ASource: Rectangle;
  const ADest: Rectangle; const AOrigin: Vector2; const ARotation: float32; const ATint: Color);
var
  LPlayer: ptr to VideoPlayer;
begin
  LPlayer := DoPlayer(AVideo.ctxData);
  if LPlayer = nil then
    return;
  end;
  if not LPlayer^.HasFrame then
    return;
  end;
  if LPlayer^.GPU then
    BeginShaderMode(LPlayer^.YuvShader);
    SetShaderValueTexture(LPlayer^.YuvShader, LPlayer^.LocCb, LPlayer^.PlaneCb);
    SetShaderValueTexture(LPlayer^.YuvShader, LPlayer^.LocCr, LPlayer^.PlaneCr);
    DrawTexturePro(LPlayer^.PlaneY, ASource, ADest, AOrigin, ARotation, ATint);
    EndShaderMode();
  else
    DrawTexturePro(LPlayer^.Frame, ASource, ADest, AOrigin, ARotation, ATint);
  end;
end;

// A `Color` from its text as web pages and Raven themes write it: `#RGB`, `#RGBA`, `#RRGGBB`
// or `#RRGGBBAA` (hex digits in either case, the `#` optional). With no alpha the colour is
// opaque; a short form repeats each digit (`#F80` is `#FF8800`).
func ColorFromHex(const AHex: string; const ADefault: Color): Color;
var
  LRGBA: uint32;
begin
  if not TryHexToRGBA(AHex, LRGBA) then
    return ADefault;
  end;
  return Color(r: uint8(LRGBA shr 24), g: uint8((LRGBA shr 16) & 255), b: uint8((LRGBA shr 8) & 255),
    a: uint8(LRGBA & 255));
end;

// ============================================================================
// The object layer's choices and sets (PLAN-RAVENAPI part 1 sec 1). Each is
// raylib's own group with raylib's own values, so `int32(Key.A)` is KEY_A and
// `Key(GetKeyPressed())` is the key raylib gave. A bit-flag group is a set of
// a choices type whose value is the flag's bit number (FLAG_VSYNC_HINT = 64 is
// bit 6, WindowFlag.VSyncHint = 6), so `uint32(LFlags)` is raylib's mask and
// `WindowFlags(N)` the set a mask holds. The .C unit's int32 aliases
// (KeyboardKey, BlendMode ..) keep their names; these take short ones.
// ============================================================================

public type
  /// A keyboard key, raylib's `KeyboardKey` values (`KEY_A` is `Key.A`).
  /// @example `if IsKeyPressed(int32(Key.Space)) then Jump(); end;`
  Key = choices(
    Null = 0,          /// No key, for none pressed. C: KEY_NULL
    Space = 32,        /// The space key. C: KEY_SPACE
    Apostrophe = 39,   /// The apostrophe key. C: KEY_APOSTROPHE
    Comma = 44,        /// The comma key. C: KEY_COMMA
    Minus = 45,        /// The minus key. C: KEY_MINUS
    Period = 46,       /// The period key. C: KEY_PERIOD
    Slash = 47,        /// The slash key. C: KEY_SLASH
    Zero = 48,         /// The 0 key. C: KEY_ZERO
    One,               /// The 1 key. C: KEY_ONE
    Two,               /// The 2 key. C: KEY_TWO
    Three,             /// The 3 key. C: KEY_THREE
    Four,              /// The 4 key. C: KEY_FOUR
    Five,              /// The 5 key. C: KEY_FIVE
    Six,               /// The 6 key. C: KEY_SIX
    Seven,             /// The 7 key. C: KEY_SEVEN
    Eight,             /// The 8 key. C: KEY_EIGHT
    Nine,              /// The 9 key. C: KEY_NINE
    Semicolon = 59,    /// The semicolon key. C: KEY_SEMICOLON
    Equal = 61,        /// The equal key. C: KEY_EQUAL
    A = 65,            /// The A key. C: KEY_A
    B,                 /// The B key. C: KEY_B
    C,                 /// The C key. C: KEY_C
    D,                 /// The D key. C: KEY_D
    E,                 /// The E key. C: KEY_E
    F,                 /// The F key. C: KEY_F
    G,                 /// The G key. C: KEY_G
    H,                 /// The H key. C: KEY_H
    I,                 /// The I key. C: KEY_I
    J,                 /// The J key. C: KEY_J
    K,                 /// The K key. C: KEY_K
    L,                 /// The L key. C: KEY_L
    M,                 /// The M key. C: KEY_M
    N,                 /// The N key. C: KEY_N
    O,                 /// The O key. C: KEY_O
    P,                 /// The P key. C: KEY_P
    Q,                 /// The Q key. C: KEY_Q
    R,                 /// The R key. C: KEY_R
    S,                 /// The S key. C: KEY_S
    T,                 /// The T key. C: KEY_T
    U,                 /// The U key. C: KEY_U
    V,                 /// The V key. C: KEY_V
    W,                 /// The W key. C: KEY_W
    X,                 /// The X key. C: KEY_X
    Y,                 /// The Y key. C: KEY_Y
    Z,                 /// The Z key. C: KEY_Z
    LeftBracket = 91,  /// The left bracket key. C: KEY_LEFT_BRACKET
    Backslash,         /// The backslash key. C: KEY_BACKSLASH
    RightBracket,      /// The right bracket key. C: KEY_RIGHT_BRACKET
    Grave = 96,        /// The grave key. C: KEY_GRAVE
    Escape = 256,      /// The escape key. C: KEY_ESCAPE
    Enter,             /// The enter key. C: KEY_ENTER
    Tab,               /// The tab key. C: KEY_TAB
    Backspace,         /// The backspace key. C: KEY_BACKSPACE
    Insert,            /// The insert key. C: KEY_INSERT
    Delete,            /// The delete key. C: KEY_DELETE
    Right,             /// The right key. C: KEY_RIGHT
    Left,              /// The left key. C: KEY_LEFT
    Down,              /// The down key. C: KEY_DOWN
    Up,                /// The up key. C: KEY_UP
    PageUp,            /// The page up key. C: KEY_PAGE_UP
    PageDown,          /// The page down key. C: KEY_PAGE_DOWN
    Home,              /// The home key. C: KEY_HOME
    End,               /// The end key. C: KEY_END
    CapsLock = 280,    /// The caps lock key. C: KEY_CAPS_LOCK
    ScrollLock,        /// The scroll lock key. C: KEY_SCROLL_LOCK
    NumLock,           /// The num lock key. C: KEY_NUM_LOCK
    PrintScreen,       /// The print screen key. C: KEY_PRINT_SCREEN
    Pause,             /// The pause key. C: KEY_PAUSE
    F1 = 290,          /// The F1 key. C: KEY_F1
    F2,                /// The F2 key. C: KEY_F2
    F3,                /// The F3 key. C: KEY_F3
    F4,                /// The F4 key. C: KEY_F4
    F5,                /// The F5 key. C: KEY_F5
    F6,                /// The F6 key. C: KEY_F6
    F7,                /// The F7 key. C: KEY_F7
    F8,                /// The F8 key. C: KEY_F8
    F9,                /// The F9 key. C: KEY_F9
    F10,               /// The F10 key. C: KEY_F10
    F11,               /// The F11 key. C: KEY_F11
    F12,               /// The F12 key. C: KEY_F12
    Kp0 = 320,         /// The keypad 0 key. C: KEY_KP_0
    Kp1,               /// The keypad 1 key. C: KEY_KP_1
    Kp2,               /// The keypad 2 key. C: KEY_KP_2
    Kp3,               /// The keypad 3 key. C: KEY_KP_3
    Kp4,               /// The keypad 4 key. C: KEY_KP_4
    Kp5,               /// The keypad 5 key. C: KEY_KP_5
    Kp6,               /// The keypad 6 key. C: KEY_KP_6
    Kp7,               /// The keypad 7 key. C: KEY_KP_7
    Kp8,               /// The keypad 8 key. C: KEY_KP_8
    Kp9,               /// The keypad 9 key. C: KEY_KP_9
    KpDecimal,         /// The keypad decimal key. C: KEY_KP_DECIMAL
    KpDivide,          /// The keypad divide key. C: KEY_KP_DIVIDE
    KpMultiply,        /// The keypad multiply key. C: KEY_KP_MULTIPLY
    KpSubtract,        /// The keypad subtract key. C: KEY_KP_SUBTRACT
    KpAdd,             /// The keypad add key. C: KEY_KP_ADD
    KpEnter,           /// The keypad enter key. C: KEY_KP_ENTER
    KpEqual,           /// The keypad equal key. C: KEY_KP_EQUAL
    LeftShift = 340,   /// The left shift key. C: KEY_LEFT_SHIFT
    LeftControl,       /// The left control key. C: KEY_LEFT_CONTROL
    LeftAlt,           /// The left alt key. C: KEY_LEFT_ALT
    LeftSuper,         /// The left super key. C: KEY_LEFT_SUPER
    RightShift,        /// The right shift key. C: KEY_RIGHT_SHIFT
    RightControl,      /// The right control key. C: KEY_RIGHT_CONTROL
    RightAlt,          /// The right alt key. C: KEY_RIGHT_ALT
    RightSuper,        /// The right super key. C: KEY_RIGHT_SUPER
    KbMenu,            /// The keyboard menu key. C: KEY_KB_MENU
    Back = 4,          /// The back key. C: KEY_BACK
    Menu = 5,          /// The menu key. C: KEY_MENU
    VolumeUp = 24,     /// The volume up key. C: KEY_VOLUME_UP
    VolumeDown = 25);  /// The volume down key. C: KEY_VOLUME_DOWN

  /// A mouse button, raylib's `MouseButton` values.
  Button = choices(
    Left,     /// The left mouse button. C: MOUSE_BUTTON_LEFT
    Right,    /// The right mouse button. C: MOUSE_BUTTON_RIGHT
    Middle,   /// The middle mouse button. C: MOUSE_BUTTON_MIDDLE
    Side,     /// The side mouse button. C: MOUSE_BUTTON_SIDE
    Extra,    /// The extra mouse button. C: MOUSE_BUTTON_EXTRA
    Forward,  /// The forward mouse button. C: MOUSE_BUTTON_FORWARD
    Back);    /// The back mouse button. C: MOUSE_BUTTON_BACK

  /// A mouse cursor shape, raylib's `MouseCursor` values.
  Cursor = choices(
    Default,       /// Default pointer shape. C: MOUSE_CURSOR_DEFAULT
    Arrow,         /// Arrow shape. C: MOUSE_CURSOR_ARROW
    IBeam,         /// Text writing cursor shape. C: MOUSE_CURSOR_IBEAM
    Crosshair,     /// Cross shape. C: MOUSE_CURSOR_CROSSHAIR
    PointingHand,  /// Pointing hand cursor. C: MOUSE_CURSOR_POINTING_HAND
    ResizeEW,      /// Horizontal resize/move arrow shape. C: MOUSE_CURSOR_RESIZE_EW
    ResizeNS,      /// Vertical resize/move arrow shape. C: MOUSE_CURSOR_RESIZE_NS
    ResizeNWSE,    /// Top-left to bottom-right diagonal resize/move arrow shape. C: MOUSE_CURSOR_RESIZE_NWSE
    ResizeNESW,    /// The top-right to bottom-left diagonal resize/move arrow shape. C: MOUSE_CURSOR_RESIZE_NESW
    ResizeAll,     /// The omnidirectional resize/move cursor shape. C: MOUSE_CURSOR_RESIZE_ALL
    NotAllowed);   /// The operation-not-allowed shape. C: MOUSE_CURSOR_NOT_ALLOWED

  /// A gamepad button, raylib's `GamepadButton` values.
  PadButton = choices(
    Unknown,         /// Unknown button, for error checking. C: GAMEPAD_BUTTON_UNKNOWN
    LeftFaceUp,      /// Gamepad left DPAD up button. C: GAMEPAD_BUTTON_LEFT_FACE_UP
    LeftFaceRight,   /// Gamepad left DPAD right button. C: GAMEPAD_BUTTON_LEFT_FACE_RIGHT
    LeftFaceDown,    /// Gamepad left DPAD down button. C: GAMEPAD_BUTTON_LEFT_FACE_DOWN
    LeftFaceLeft,    /// Gamepad left DPAD left button. C: GAMEPAD_BUTTON_LEFT_FACE_LEFT
    RightFaceUp,     /// Gamepad right button up (i.e. PS3: Triangle, Xbox: Y). C: GAMEPAD_BUTTON_RIGHT_FACE_UP
    RightFaceRight,  /// Gamepad right button right (i.e. PS3: Circle, Xbox: B). C: GAMEPAD_BUTTON_RIGHT_FACE_RIGHT
    RightFaceDown,   /// Gamepad right button down (i.e. PS3: Cross, Xbox: A). C: GAMEPAD_BUTTON_RIGHT_FACE_DOWN
    RightFaceLeft,   /// Gamepad right button left (i.e. PS3: Square, Xbox: X). C: GAMEPAD_BUTTON_RIGHT_FACE_LEFT
    LeftTrigger1,    /// Gamepad top/back trigger left (first), it could be a trailing button. C: GAMEPAD_BUTTON_LEFT_TRIGGER_1
    LeftTrigger2,    /// Gamepad top/back trigger left (second), it could be a trailing button. C: GAMEPAD_BUTTON_LEFT_TRIGGER_2
    RightTrigger1,   /// Gamepad top/back trigger right (first), it could be a trailing button. C: GAMEPAD_BUTTON_RIGHT_TRIGGER_1
    RightTrigger2,   /// Gamepad top/back trigger right (second), it could be a trailing button. C: GAMEPAD_BUTTON_RIGHT_TRIGGER_2
    MiddleLeft,      /// Gamepad center buttons, left one (i.e. PS3: Select). C: GAMEPAD_BUTTON_MIDDLE_LEFT
    Middle,          /// Gamepad center buttons, middle one (i.e. PS3: PS, Xbox: XBOX). C: GAMEPAD_BUTTON_MIDDLE
    MiddleRight,     /// Gamepad center buttons, right one (i.e. PS3: Start). C: GAMEPAD_BUTTON_MIDDLE_RIGHT
    LeftThumb,       /// Gamepad joystick pressed button left. C: GAMEPAD_BUTTON_LEFT_THUMB
    RightThumb);     /// Gamepad joystick pressed button right. C: GAMEPAD_BUTTON_RIGHT_THUMB

  /// A gamepad axis, raylib's `GamepadAxis` values.
  PadAxis = choices(
    LeftX,          /// Gamepad left stick X axis. C: GAMEPAD_AXIS_LEFT_X
    LeftY,          /// Gamepad left stick Y axis. C: GAMEPAD_AXIS_LEFT_Y
    RightX,         /// Gamepad right stick X axis. C: GAMEPAD_AXIS_RIGHT_X
    RightY,         /// Gamepad right stick Y axis. C: GAMEPAD_AXIS_RIGHT_Y
    LeftTrigger,    /// Gamepad back trigger left, pressure level: [1..-1]. C: GAMEPAD_AXIS_LEFT_TRIGGER
    RightTrigger);  /// Gamepad back trigger right, pressure level: [1..-1]. C: GAMEPAD_AXIS_RIGHT_TRIGGER

  /// A window flag; its value is the bit of raylib's `ConfigFlags` mask
  /// (`FLAG_VSYNC_HINT` = 64 = bit 6 = `WindowFlag.VSyncHint`).
  WindowFlag = choices(
    FullscreenMode = 1,       /// Set to run program in fullscreen. C: FLAG_FULLSCREEN_MODE
    Resizable = 2,            /// Set to allow resizable window. C: FLAG_WINDOW_RESIZABLE
    Undecorated = 3,          /// Set to disable window decoration (frame and buttons). C: FLAG_WINDOW_UNDECORATED
    Transparent = 4,          /// Set to allow transparent framebuffer. C: FLAG_WINDOW_TRANSPARENT
    Msaa4xHint = 5,           /// Set to try enabling MSAA 4X. C: FLAG_MSAA_4X_HINT
    VSyncHint = 6,            /// Set to try enabling V-Sync on GPU. C: FLAG_VSYNC_HINT
    Hidden = 7,               /// Set to hide window. C: FLAG_WINDOW_HIDDEN
    AlwaysRun = 8,            /// Set to allow windows running while minimized. C: FLAG_WINDOW_ALWAYS_RUN
    Minimized = 9,            /// Set to minimize window (iconify). C: FLAG_WINDOW_MINIMIZED
    Maximized = 10,           /// Set to maximize window (expanded to monitor). C: FLAG_WINDOW_MAXIMIZED
    Unfocused = 11,           /// Set to window non focused. C: FLAG_WINDOW_UNFOCUSED
    Topmost = 12,             /// Set to window always on top. C: FLAG_WINDOW_TOPMOST
    HighDPI = 13,             /// Set to support HighDPI. C: FLAG_WINDOW_HIGHDPI
    MousePassthrough = 14,    /// Set to support mouse passthrough, only supported when FLAG_WINDOW_UNDECORATED. C: FLAG_WINDOW_MOUSE_PASSTHROUGH
    BorderlessWindowed = 15,  /// Set to run program in borderless windowed mode. C: FLAG_BORDERLESS_WINDOWED_MODE
    InterlacedHint = 16);     /// Set to try enabling interlaced video format (for V3D). C: FLAG_INTERLACED_HINT

  /// A set of window flags: `uint32(LFlags)` is raylib's `ConfigFlags` mask, `WindowFlags(N)`
  /// the set a mask holds.
  /// @example `SetConfigFlags(uint32([WindowFlag.Resizable, WindowFlag.VSyncHint]));`
  WindowFlags = set of WindowFlag;

  /// A trace log level, raylib's `TraceLogLevel` values.
  LogLevel = choices(
    All,      /// Display all logs. C: LOG_ALL
    Trace,    /// Trace logging, intended for internal use only. C: LOG_TRACE
    Debug,    /// Debug logging, used for internal debugging, it should be disabled on release builds. C: LOG_DEBUG
    Info,     /// Info logging, used for program execution info. C: LOG_INFO
    Warning,  /// Warning logging, used on recoverable failures. C: LOG_WARNING
    Error,    /// Error logging, used on unrecoverable failures. C: LOG_ERROR
    Fatal,    /// Fatal logging, used to abort program: exit(EXIT_FAILURE). C: LOG_FATAL
    None);    /// Disable logging. C: LOG_NONE

  /// A pixel format, raylib's `PixelFormat` values.
  Pixel = choices(
    Gray = 1,      /// 8 bit per pixel (no alpha). C: PIXELFORMAT_UNCOMPRESSED_GRAYSCALE
    GrayAlpha,     /// 8*2 bpp (2 channels). C: PIXELFORMAT_UNCOMPRESSED_GRAY_ALPHA
    R5G6B5,        /// 16 bpp. C: PIXELFORMAT_UNCOMPRESSED_R5G6B5
    R8G8B8,        /// 24 bpp. C: PIXELFORMAT_UNCOMPRESSED_R8G8B8
    R5G5B5A1,      /// 16 bpp (1 bit alpha). C: PIXELFORMAT_UNCOMPRESSED_R5G5B5A1
    R4G4B4A4,      /// 16 bpp (4 bit alpha). C: PIXELFORMAT_UNCOMPRESSED_R4G4B4A4
    R8G8B8A8,      /// 32 bpp. C: PIXELFORMAT_UNCOMPRESSED_R8G8B8A8
    R32,           /// 32 bpp (1 channel - float). C: PIXELFORMAT_UNCOMPRESSED_R32
    R32G32B32,     /// 32*3 bpp (3 channels - float). C: PIXELFORMAT_UNCOMPRESSED_R32G32B32
    R32G32B32A32,  /// 32*4 bpp (4 channels - float). C: PIXELFORMAT_UNCOMPRESSED_R32G32B32A32
    R16,           /// 16 bpp (1 channel - half float). C: PIXELFORMAT_UNCOMPRESSED_R16
    R16G16B16,     /// 16*3 bpp (3 channels - half float). C: PIXELFORMAT_UNCOMPRESSED_R16G16B16
    R16G16B16A16,  /// 16*4 bpp (4 channels - half float). C: PIXELFORMAT_UNCOMPRESSED_R16G16B16A16
    Dxt1RGB,       /// 4 bpp (no alpha). C: PIXELFORMAT_COMPRESSED_DXT1_RGB
    Dxt1RGBA,      /// 4 bpp (1 bit alpha). C: PIXELFORMAT_COMPRESSED_DXT1_RGBA
    Dxt3RGBA,      /// 8 bpp. C: PIXELFORMAT_COMPRESSED_DXT3_RGBA
    Dxt5RGBA,      /// 8 bpp. C: PIXELFORMAT_COMPRESSED_DXT5_RGBA
    Etc1RGB,       /// 4 bpp. C: PIXELFORMAT_COMPRESSED_ETC1_RGB
    Etc2RGB,       /// 4 bpp. C: PIXELFORMAT_COMPRESSED_ETC2_RGB
    Etc2EacRGBA,   /// 8 bpp. C: PIXELFORMAT_COMPRESSED_ETC2_EAC_RGBA
    PvrtRGB,       /// 4 bpp. C: PIXELFORMAT_COMPRESSED_PVRT_RGB
    PvrtRGBA,      /// 4 bpp. C: PIXELFORMAT_COMPRESSED_PVRT_RGBA
    Astc4x4RGBA,   /// Astc4x4RGBA pixels. C: PIXELFORMAT_COMPRESSED_ASTC_4x4_RGBA
    Astc8x8RGBA);  /// Astc8x8RGBA pixels. C: PIXELFORMAT_COMPRESSED_ASTC_8x8_RGBA

  /// A texture filter, raylib's `TextureFilter` values.
  Filter = choices(
    Point,            /// No filter, pixel approximation. C: TEXTURE_FILTER_POINT
    Bilinear,         /// Linear filtering. C: TEXTURE_FILTER_BILINEAR
    Trilinear,        /// Trilinear filtering (linear with mipmaps). C: TEXTURE_FILTER_TRILINEAR
    Anisotropic4x,    /// Anisotropic filtering 4x. C: TEXTURE_FILTER_ANISOTROPIC_4X
    Anisotropic8x,    /// Anisotropic filtering 8x. C: TEXTURE_FILTER_ANISOTROPIC_8X
    Anisotropic16x);  /// Anisotropic filtering 16x. C: TEXTURE_FILTER_ANISOTROPIC_16X

  /// A texture wrap mode, raylib's `TextureWrap` values.
  WrapMode = choices(
    Repeat,        /// Repeats texture in tiled mode. C: TEXTURE_WRAP_REPEAT
    Clamp,         /// Clamps texture to edge pixel in tiled mode. C: TEXTURE_WRAP_CLAMP
    MirrorRepeat,  /// Mirrors and repeats the texture in tiled mode. C: TEXTURE_WRAP_MIRROR_REPEAT
    MirrorClamp);  /// Mirrors and clamps to border the texture in tiled mode. C: TEXTURE_WRAP_MIRROR_CLAMP

  /// A cubemap layout, raylib's `CubemapLayout` values.
  CubeLayout = choices(
    AutoDetect,         /// Automatically detect layout type. C: CUBEMAP_LAYOUT_AUTO_DETECT
    LineVertical,       /// Layout is defined by a vertical line with faces. C: CUBEMAP_LAYOUT_LINE_VERTICAL
    LineHorizontal,     /// Layout is defined by a horizontal line with faces. C: CUBEMAP_LAYOUT_LINE_HORIZONTAL
    CrossThreeByFour,   /// Layout is defined by a 3x4 cross with cubemap faces. C: CUBEMAP_LAYOUT_CROSS_THREE_BY_FOUR
    CrossFourByThree);  /// Layout is defined by a 4x3 cross with cubemap faces. C: CUBEMAP_LAYOUT_CROSS_FOUR_BY_THREE

  /// A font kind, raylib's `FontType` values.
  FontKind = choices(
    Default,  /// Default font generation, anti-aliased. C: FONT_DEFAULT
    Bitmap,   /// Bitmap font generation, no anti-aliasing. C: FONT_BITMAP
    Sdf);     /// SDF font generation, requires external shader. C: FONT_SDF

  /// A blend mode, raylib's `BlendMode` values.
  Blend = choices(
    Alpha,             /// Blend textures considering alpha (default). C: BLEND_ALPHA
    Additive,          /// Blend textures adding colors. C: BLEND_ADDITIVE
    Multiplied,        /// Blend textures multiplying colors. C: BLEND_MULTIPLIED
    AddColors,         /// Blend textures adding colors (alternative). C: BLEND_ADD_COLORS
    SubtractColors,    /// Blend textures subtracting colors (alternative). C: BLEND_SUBTRACT_COLORS
    AlphaPremultiply,  /// Blend premultiplied textures considering alpha. C: BLEND_ALPHA_PREMULTIPLY
    Custom,            /// Blend textures using custom src/dst factors (use rlSetBlendFactors()). C: BLEND_CUSTOM
    CustomSeparate);   /// Blend textures using custom rgb/alpha separate src/dst factors (use rlSetBlendFactorsSeparate()). C: BLEND_CUSTOM_SEPARATE

  /// A touch gesture; its value is the bit of raylib's `Gesture` mask (`GESTURE_TAP` = 1 =
  /// bit 0).
  TouchGesture = choices(
    Tap,         /// Tap gesture. C: GESTURE_TAP
    DoubleTap,   /// Double tap gesture. C: GESTURE_DOUBLETAP
    Hold,        /// Hold gesture. C: GESTURE_HOLD
    Drag,        /// Drag gesture. C: GESTURE_DRAG
    SwipeRight,  /// Swipe right gesture. C: GESTURE_SWIPE_RIGHT
    SwipeLeft,   /// Swipe left gesture. C: GESTURE_SWIPE_LEFT
    SwipeUp,     /// Swipe up gesture. C: GESTURE_SWIPE_UP
    SwipeDown,   /// Swipe down gesture. C: GESTURE_SWIPE_DOWN
    PinchIn,     /// Pinch in gesture. C: GESTURE_PINCH_IN
    PinchOut);   /// Pinch out gesture. C: GESTURE_PINCH_OUT

  /// A set of touch gestures: `uint32(LGestures)` is raylib's mask, `TouchGestures(N)` the set
  /// a mask holds.
  TouchGestures = set of TouchGesture;

  /// A camera update style, raylib's `CameraMode` values.
  CameraStyle = choices(
    Custom,        /// Camera custom, controlled by user (UpdateCamera() does nothing). C: CAMERA_CUSTOM
    Free,          /// Camera free mode. C: CAMERA_FREE
    Orbital,       /// Camera orbital, around target, zoom supported. C: CAMERA_ORBITAL
    FirstPerson,   /// Camera first person. C: CAMERA_FIRST_PERSON
    ThirdPerson);  /// Camera third person. C: CAMERA_THIRD_PERSON

  /// A camera projection, raylib's `CameraProjection` values.
  Projection = choices(
    Perspective,    /// Perspective projection. C: CAMERA_PERSPECTIVE
    Orthographic);  /// Orthographic projection. C: CAMERA_ORTHOGRAPHIC

  /// An n-patch layout, raylib's `NPatchLayout` values.
  NPatch = choices(
    NinePatch,              /// Npatch layout: 3x3 tiles. C: NPATCH_NINE_PATCH
    ThreePatchVertical,     /// Npatch layout: 1x3 tiles. C: NPATCH_THREE_PATCH_VERTICAL
    ThreePatchHorizontal);  /// Npatch layout: 3x1 tiles. C: NPATCH_THREE_PATCH_HORIZONTAL

  /// A material map index, raylib's `MaterialMapIndex` values.
  MapIndex = choices(
    Albedo,      /// Albedo material (same as: MATERIAL_MAP_DIFFUSE). C: MATERIAL_MAP_ALBEDO
    Metalness,   /// Metalness material (same as: MATERIAL_MAP_SPECULAR). C: MATERIAL_MAP_METALNESS
    Normal,      /// Normal material. C: MATERIAL_MAP_NORMAL
    Roughness,   /// Roughness material. C: MATERIAL_MAP_ROUGHNESS
    Occlusion,   /// Ambient occlusion material. C: MATERIAL_MAP_OCCLUSION
    Emission,    /// Emission material. C: MATERIAL_MAP_EMISSION
    Height,      /// Heightmap material. C: MATERIAL_MAP_HEIGHT
    Cubemap,     /// Cubemap material (NOTE: Uses GL_TEXTURE_CUBE_MAP). C: MATERIAL_MAP_CUBEMAP
    Irradiance,  /// Irradiance material (NOTE: Uses GL_TEXTURE_CUBE_MAP). C: MATERIAL_MAP_IRRADIANCE
    Prefilter,   /// Prefilter material (NOTE: Uses GL_TEXTURE_CUBE_MAP). C: MATERIAL_MAP_PREFILTER
    Brdf);       /// Brdf material. C: MATERIAL_MAP_BRDF

  /// A shader location index, raylib's `ShaderLocationIndex` values.
  ShaderLoc = choices(
    VertexPosition,     /// Shader location: vertex attribute: position. C: SHADER_LOC_VERTEX_POSITION
    VertexTexcoord01,   /// Shader location: vertex attribute: texcoord01. C: SHADER_LOC_VERTEX_TEXCOORD01
    VertexTexcoord02,   /// Shader location: vertex attribute: texcoord02. C: SHADER_LOC_VERTEX_TEXCOORD02
    VertexNormal,       /// Shader location: vertex attribute: normal. C: SHADER_LOC_VERTEX_NORMAL
    VertexTangent,      /// Shader location: vertex attribute: tangent. C: SHADER_LOC_VERTEX_TANGENT
    VertexColor,        /// Shader location: vertex attribute: color. C: SHADER_LOC_VERTEX_COLOR
    MatrixMvp,          /// Shader location: matrix uniform: model-view-projection. C: SHADER_LOC_MATRIX_MVP
    MatrixView,         /// Shader location: matrix uniform: view (camera transform). C: SHADER_LOC_MATRIX_VIEW
    MatrixProjection,   /// Shader location: matrix uniform: projection. C: SHADER_LOC_MATRIX_PROJECTION
    MatrixModel,        /// Shader location: matrix uniform: model (transform). C: SHADER_LOC_MATRIX_MODEL
    MatrixNormal,       /// Shader location: matrix uniform: normal. C: SHADER_LOC_MATRIX_NORMAL
    VectorView,         /// Shader location: vector uniform: view. C: SHADER_LOC_VECTOR_VIEW
    ColorDiffuse,       /// Shader location: vector uniform: diffuse color. C: SHADER_LOC_COLOR_DIFFUSE
    ColorSpecular,      /// Shader location: vector uniform: specular color. C: SHADER_LOC_COLOR_SPECULAR
    ColorAmbient,       /// Shader location: vector uniform: ambient color. C: SHADER_LOC_COLOR_AMBIENT
    MapAlbedo,          /// Shader location: sampler2d texture: albedo (same as: SHADER_LOC_MAP_DIFFUSE). C: SHADER_LOC_MAP_ALBEDO
    MapMetalness,       /// Shader location: sampler2d texture: metalness (same as: SHADER_LOC_MAP_SPECULAR). C: SHADER_LOC_MAP_METALNESS
    MapNormal,          /// Shader location: sampler2d texture: normal. C: SHADER_LOC_MAP_NORMAL
    MapRoughness,       /// Shader location: sampler2d texture: roughness. C: SHADER_LOC_MAP_ROUGHNESS
    MapOcclusion,       /// Shader location: sampler2d texture: occlusion. C: SHADER_LOC_MAP_OCCLUSION
    MapEmission,        /// Shader location: sampler2d texture: emission. C: SHADER_LOC_MAP_EMISSION
    MapHeight,          /// Shader location: sampler2d texture: heightmap. C: SHADER_LOC_MAP_HEIGHT
    MapCubemap,         /// Shader location: samplerCube texture: cubemap. C: SHADER_LOC_MAP_CUBEMAP
    MapIrradiance,      /// Shader location: samplerCube texture: irradiance. C: SHADER_LOC_MAP_IRRADIANCE
    MapPrefilter,       /// Shader location: samplerCube texture: prefilter. C: SHADER_LOC_MAP_PREFILTER
    MapBrdf,            /// Shader location: sampler2d texture: brdf. C: SHADER_LOC_MAP_BRDF
    VertexBoneIds,      /// Shader location: vertex attribute: bone indices. C: SHADER_LOC_VERTEX_BONEIDS
    VertexBoneWeights,  /// Shader location: vertex attribute: bone weights. C: SHADER_LOC_VERTEX_BONEWEIGHTS
    BoneMatrices,       /// Shader location: matrix attribute: bone transforms (animation). C: SHADER_LOC_MATRIX_BONETRANSFORMS
    VertexInstanceTx);  /// Shader location: vertex attribute: instance transforms. C: SHADER_LOC_VERTEX_INSTANCETRANSFORM

  /// A shader uniform data type, raylib's `ShaderUniformDataType` values.
  UniformType = choices(
    Float,       /// Shader uniform type: float. C: SHADER_UNIFORM_FLOAT
    Vec2,        /// Shader uniform type: vec2 (2 float). C: SHADER_UNIFORM_VEC2
    Vec3,        /// Shader uniform type: vec3 (3 float). C: SHADER_UNIFORM_VEC3
    Vec4,        /// Shader uniform type: vec4 (4 float). C: SHADER_UNIFORM_VEC4
    Int,         /// Shader uniform type: int. C: SHADER_UNIFORM_INT
    IVec2,       /// Shader uniform type: ivec2 (2 int). C: SHADER_UNIFORM_IVEC2
    IVec3,       /// Shader uniform type: ivec3 (3 int). C: SHADER_UNIFORM_IVEC3
    IVec4,       /// Shader uniform type: ivec4 (4 int). C: SHADER_UNIFORM_IVEC4
    UInt,        /// Shader uniform type: unsigned int. C: SHADER_UNIFORM_UINT
    UIVec2,      /// Shader uniform type: uivec2 (2 unsigned int). C: SHADER_UNIFORM_UIVEC2
    UIVec3,      /// Shader uniform type: uivec3 (3 unsigned int). C: SHADER_UNIFORM_UIVEC3
    UIVec4,      /// Shader uniform type: uivec4 (4 unsigned int). C: SHADER_UNIFORM_UIVEC4
    Sampler2D);  /// Shader uniform type: sampler2d. C: SHADER_UNIFORM_SAMPLER2D

  /// A shader attribute data type, raylib's `ShaderAttributeDataType` values.
  AttribType = choices(
    Float,  /// Shader attribute type: float. C: SHADER_ATTRIB_FLOAT
    Vec2,   /// Shader attribute type: vec2 (2 float). C: SHADER_ATTRIB_VEC2
    Vec3,   /// Shader attribute type: vec3 (3 float). C: SHADER_ATTRIB_VEC3
    Vec4);  /// Shader attribute type: vec4 (4 float). C: SHADER_ATTRIB_VEC4

  /// What an automation event records, raylib's `AutomationEventType` values (rcore's own:
  /// raylib.h keeps them out, so an AutomationEvent's `type_` is one of these).
  AutomationKind = choices(
    None,               /// A none event.
    KeyUp,              /// A key up event.
    KeyDown,            /// A key down event.
    KeyPressed,         /// A key pressed event.
    KeyReleased,        /// A key released event.
    MouseButtonUp,      /// A mouse button up event.
    MouseButtonDown,    /// A mouse button down event.
    MousePosition,      /// A mouse position event.
    MouseWheelMotion,   /// A mouse wheel motion event.
    GamepadConnect,     /// A gamepad connect event.
    GamepadDisconnect,  /// A gamepad disconnect event.
    GamepadButtonUp,    /// A gamepad button up event.
    GamepadButtonDown,  /// A gamepad button down event.
    GamepadAxisMotion,  /// A gamepad axis motion event.
    TouchUp,            /// A touch up event.
    TouchDown,          /// A touch down event.
    TouchPosition,      /// A touch position event.
    Gesture,            /// A gesture event.
    WindowClose,        /// A window close event.
    WindowMaximize,     /// A window maximize event.
    WindowMinimize,     /// A window minimize event.
    WindowResize,       /// A window resize event.
    TakeScreenshot,     /// A take screenshot event.
    SetTargetFPS);      /// A set target FPS event.

// ============================================================================
// The value types (sec 2): the .C unit's own records given methods and
// operators by `extend`, so a value from this layer goes straight into a .C
// call and back. Each member is raymath's / raylib's routine of the same job
// (named in its doc); `=` / `<>` compare as raymath's *Equals does (a relative
// epsilon), never bit for bit.
// ============================================================================

// Vector2 math (raymath's Vector2*), its 2D collisions and its camera transforms.
// @example `LPos := LPos + LVel * GetFrameTime();`
public extend Vector2
  /// The vector (0, 0). C: Vector2Zero
  /// @returns the vector (0, 0)
  static method Zero(): Vector2;
  begin
    return Vector2Zero();
  end;

  /// The vector (1, 1). C: Vector2One
  /// @returns the vector (1, 1)
  static method One(): Vector2;
  begin
    return Vector2One();
  end;

  /// Component-wise sum. C: Vector2Add
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise sum
  operator +(const A: Vector2; const B: Vector2): Vector2;
  begin
    return Vector2Add(A, B);
  end;

  /// `S` added to each component. C: Vector2AddValue
  /// @param A the left operand
  /// @param S the right operand
  /// @returns `S` added to each component
  operator +(const A: Vector2; const S: float32): Vector2;
  begin
    return Vector2AddValue(A, S);
  end;

  /// Component-wise difference. C: Vector2Subtract
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise difference
  operator -(const A: Vector2; const B: Vector2): Vector2;
  begin
    return Vector2Subtract(A, B);
  end;

  /// `S` taken from each component. C: Vector2SubtractValue
  /// @param A the left operand
  /// @param S the right operand
  /// @returns `S` taken from each component
  operator -(const A: Vector2; const S: float32): Vector2;
  begin
    return Vector2SubtractValue(A, S);
  end;

  /// Component-wise product. C: Vector2Multiply
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise product
  operator *(const A: Vector2; const B: Vector2): Vector2;
  begin
    return Vector2Multiply(A, B);
  end;

  /// The vector scaled by `S`. C: Vector2Scale
  /// @param A the left operand
  /// @param S the right operand
  /// @returns the vector scaled by `S`
  operator *(const A: Vector2; const S: float32): Vector2;
  begin
    return Vector2Scale(A, S);
  end;

  /// Component-wise quotient. C: Vector2Divide
  /// @param A the left operand
  /// @param B the right operand
  /// @returns the component-wise quotient
  operator /(const A: Vector2; const B: Vector2): Vector2;
  begin
    return Vector2Divide(A, B);
  end;

  /// The vector divided by `S`. C: Vector2Scale by 1 / S
  /// @param A the left operand
  /// @param S the right operand
  /// @returns the vector divided by `S`
  operator /(const A: Vector2; const S: float32): Vector2;
  begin
    return Vector2Scale(A, 1.0f / S);
  end;

  /// True when the vectors are equal within raymath's epsilon. C: Vector2Equals
  /// @param A the left operand
  /// @param B the right operand
  /// @returns `true` when the vectors are equal within raymath's epsilon
  operator =(const A: Vector2; const B: Vector2): bool;
  begin
    return Vector2Equals(A, B) <> 0;
  end;

  /// True when the vectors differ beyond raymath's epsilon. C: Vector2Equals
  /// @param A the left operand
  /// @param B the right operand
  /// @returns `true` when the vectors differ beyond raymath's epsilon
  operator <>(const A: Vector2; const B: Vector2): bool;
  begin
    return Vector2Equals(A, B) = 0;
  end;

  /// The vector negated. C: Vector2Negate
  /// @returns the vector negated
  const method Negate(): Vector2;
  begin
    return Vector2Negate(self);
  end;

  /// Each component's reciprocal (1 / x, 1 / y). C: Vector2Invert
  /// @returns each component's reciprocal (1 / x, 1 / y)
  const method Invert(): Vector2;
  begin
    return Vector2Invert(self);
  end;

  /// The vector's length. C: Vector2Length
  /// @returns the vector's length
  const method Length(): float32;
  begin
    return Vector2Length(self);
  end;

  /// The vector's squared length (no square root). C: Vector2LengthSqr
  /// @returns the vector's squared length (no square root)
  const method LengthSqr(): float32;
  begin
    return Vector2LengthSqr(self);
  end;

  /// The dot product with `B`. C: Vector2DotProduct
  /// @param B the other vector
  /// @returns the dot product with `B`
  const method Dot(const B: Vector2): float32;
  begin
    return Vector2DotProduct(self, B);
  end;

  /// The 2D cross product (the z of the 3D one) with `B`. C: Vector2CrossProduct
  /// @param B the other vector
  /// @returns the 2D cross product (the z of the 3D one) with `B`
  const method Cross(const B: Vector2): float32;
  begin
    return Vector2CrossProduct(self, B);
  end;

  /// The distance to `B`. C: Vector2Distance
  /// @param B the other point
  /// @returns the distance to `B`
  const method Distance(const B: Vector2): float32;
  begin
    return Vector2Distance(self, B);
  end;

  /// The squared distance to `B`. C: Vector2DistanceSqr
  /// @param B the other point
  /// @returns the squared distance to `B`
  const method DistanceSqr(const B: Vector2): float32;
