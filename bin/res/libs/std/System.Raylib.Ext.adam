    /// @param ABottomRight the bottom-right corner's colour
    /// @param ATopRight the top-right corner's colour
    /// @returns this object, so calls chain
    method RectGradient(const ARect: Rectangle; const ATopLeft: Color; const ABottomLeft: Color;
      const ABottomRight: Color; const ATopRight: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawRectangleGradientEx(self.DoAt(), ARect, ATopLeft, ABottomLeft, ABottomRight,
          ATopRight);
      end;
      return self;
    end;

    /// A filled circle. C: ImageDrawCircle / ImageDrawCircleV
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method Circle(const ACenter: Vector2; const ARadius: int32; const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawCircleV(self.DoAt(), ACenter, ARadius, AColor);
      end;
      return self;
    end;

    /// A circle's outline. C: ImageDrawCircleLines / ImageDrawCircleLinesV
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method CircleLines(const ACenter: Vector2; const ARadius: int32; const AColor: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawCircleLinesV(self.DoAt(), ACenter, ARadius, AColor);
      end;
      return self;
    end;

    /// A circle shaded from `AInner` at its center to `AOuter`. C: ImageDrawCircleGradient
    /// @param ACenter the centre
    /// @param ARadius the radius
    /// @param AInner the colour at the centre
    /// @param AOuter the colour at the edge
    /// @returns this object, so calls chain
    method CircleGradient(const ACenter: Vector2; const ARadius: float32; const AInner: Color;
      const AOuter: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawCircleGradient(self.DoAt(), ACenter, ARadius, AInner, AOuter);
      end;
      return self;
    end;

    /// `ASource` drawn at `APos`, multiplied by `ATint`. C: ImageDrawImage
    /// @param ASource the source
    /// @param APos the position
    /// @param ATint the tint colour
    /// @returns this object, so calls chain
    method Image(const ASource: ImageRes; const APos: Vector2; const ATint: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawImage(self.DoAt(), ASource.Handle(), DoRound(APos.x), DoRound(APos.y), ATint);
      end;
      return self;
    end;

    /// `ASource` turned `ARotation` degrees and scaled by `AScale` at `APos`.
    /// C: ImageDrawImageEx
    /// @param ASource the source
    /// @param APos the position
    /// @param ARotation the rotation
    /// @param AScale the scale
    /// @param ATint the tint colour
    /// @returns this object, so calls chain
    method Image(const ASource: ImageRes; const APos: Vector2; const ARotation: float32;
      const AScale: float32; const ATint: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawImageEx(self.DoAt(), ASource.Handle(), APos, ARotation, AScale, ATint);
      end;
      return self;
    end;

    /// The part `ASourceRect` of `ASource` at `APos`. C: ImageDrawImageRec
    /// @param ASource the source
    /// @param ASourceRect the source rect
    /// @param APos the position
    /// @param ATint the tint colour
    /// @returns this object, so calls chain
    method Image(const ASource: ImageRes; const ASourceRect: Rectangle; const APos: Vector2;
      const ATint: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawImageRec(self.DoAt(), ASource.Handle(), ASourceRect, APos, ATint);
      end;
      return self;
    end;

    /// The part `ASourceRect` of `ASource` scaled into `ADestRect`. C: ImageDrawImagePro
    /// @param ASource the source
    /// @param ASourceRect the source rect
    /// @param ADestRect the dest rect
    /// @param ATint the tint colour
    /// @returns this object, so calls chain
    method Image(const ASource: ImageRes; const ASourceRect: Rectangle;
      const ADestRect: Rectangle; const ATint: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawImagePro(self.DoAt(), ASource.Handle(), ASourceRect, ADestRect,
          Vector2(x: 0.0f, y: 0.0f), 0.0f, ATint);
      end;
      return self;
    end;

    /// The part `ASourceRect` of `ASource` scaled into `ADestRect`, turned `ARotation` degrees
    /// about `AOrigin` (from the destination's corner). C: ImageDrawImagePro
    /// @param ASource the source
    /// @param ASourceRect the source rect
    /// @param ADestRect the dest rect
    /// @param AOrigin the origin
    /// @param ARotation the rotation
    /// @param ATint the tint colour
    /// @returns this object, so calls chain
    method Image(const ASource: ImageRes; const ASourceRect: Rectangle;
      const ADestRect: Rectangle; const AOrigin: Vector2; const ARotation: float32;
      const ATint: Color): self;
    begin
      if self.FHold <> nil then
        ImageDrawImagePro(self.DoAt(), ASource.Handle(), ASourceRect, ADestRect, AOrigin,
          ARotation, ATint);
      end;
      return self;
    end;

    // ---- out ----

    /// Saves the image at `APath` (its extension the format: .png, .bmp, .qoi ...).
    /// C: ExportImage
    /// @param APath the file's path
    /// @returns `true` when the file was written
    const method Export(const APath: string): bool;
    begin
      return self.IsValid() and ExportImage(self.Handle(), APath);
    end;

    /// The image as the bytes of a file of type `AType` (".png" ...; none when it cannot be
    /// written). C: ExportImageToMemory
    /// @param AType the type
    /// @returns the image as the bytes of a file of type `AType` (".png" ...; none when it cannot be written)
    const method ExportToMemory(const AType: string): array of uint8;
    var
      LSize: int32;
      LData: ptr to uint8;
    begin
      LSize := 0;
      LData := nil;
      if self.IsValid() then
        LData := ExportImageToMemory(self.Handle(), AType, addr of LSize);
      end;
      return DoBytes(LData, LSize);
    end;

    /// Saves the pixels as a C header at `APath`. C: ExportImageAsCode
    /// @param APath the file's path
    /// @returns `true` when the file was written
    const method ExportAsCode(const APath: string): bool;
    begin
      return self.IsValid() and ExportImageAsCode(self.Handle(), APath);
    end;
  end;

  /// A texture on the GPU (the window must be open): loaded, made from an image, drawn by
  /// `Draw.Texture`. A shared handle: the last copy unloads it, the window's close too.
  /// C: UnloadTexture (the last copy's release)
  /// @example `LTex: TextureRes("images/adam.png"); LTex.SetFilter(Filter.Bilinear); Draw.Texture(LTex, Vector2(x: 8, y: 8), WHITE);`
  TextureRes = object
    hidden FHold: ref TextureHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing), as a
    /// variable declared with no arguments starts.
    init();
    begin
    end;

    /// Loads the image file at `APath` (from the mounted source) as a texture. C: LoadTexture
    /// @param APath the file's path
    init(const APath: string);
    begin
      self.FHold := DoTextureHold(LoadTexture(APath), true);
    end;

    /// Takes the .C texture `ATexture` over: unloaded with the last copy (or the window).
    /// @param ATexture the texture
    /// @returns the new `TextureRes`
    static method Adopt(const ATexture: Texture2D): TextureRes;
    var
      LRes: TextureRes;
    begin
      LRes.FHold := DoTextureHold(ATexture, true);
      return LRes;
    end;

    /// A view of `ATexture`, which another owns: never unloaded through it, valid while its
    /// owner keeps it (a render texture's, a font's atlas, a .C texture of the program's).
    /// @param ATexture the texture
    /// @returns a view of `ATexture`, which another owns: never unloaded through it, valid while its owner keeps it (a render texture's, a font's atlas, a .C texture of the program's)
    static method View(const ATexture: Texture2D): TextureRes;
    var
      LRes: TextureRes;
    begin
      LRes.FHold := DoTextureHold(ATexture, false);
      return LRes;
    end;

    /// Loads an image of type `AType` (".png" ...) from `AIO` as a texture.
    /// @param AIO the IO
    /// @param AType the type
    /// @returns the new `TextureRes`
    static method FromIO(const AIO: IO; const AType: string): TextureRes;
    begin
      return TextureRes.Adopt(LoadTextureIO(AIO, AType));
    end;

    /// `AImage`'s pixels as a texture. C: LoadTextureFromImage
    /// @param AImage the image
    /// @returns `AImage`'s pixels as a texture
    static method FromImage(const AImage: ImageRes): TextureRes;
    begin
      return TextureRes.Adopt(LoadTextureFromImage(AImage.Handle()));
    end;

    /// A cubemap from `AImage`'s six faces laid out as `ALayout`. C: LoadTextureCubemap
    /// @param AImage the image
    /// @param ALayout the layout
    /// @returns a cubemap from `AImage`'s six faces laid out as `ALayout`
    static method Cubemap(const AImage: ImageRes; const ALayout: CubeLayout): TextureRes;
    begin
      return TextureRes.Adopt(LoadTextureCubemap(AImage.Handle(), int32(ALayout)));
    end;

    /// The .C texture (borrowed, for .C calls; raylib's empty texture when none is held).
    /// @returns the .C texture (borrowed, for .C calls; raylib's empty texture when none is held)
    const method Handle(): Texture2D;
    var
      LNone: Texture2D;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return LNone;
      end;
      return self.FHold.FTexture;
    end;

    /// True when the texture is on the GPU. C: IsTextureValid
    /// @returns `true` when the texture is on the GPU
    const method IsValid(): bool;
    begin
      return IsTextureValid(self.Handle());
    end;

    /// The width in pixels.
    /// @returns the width in pixels
    const method Width(): int32;
    begin
      return self.Handle().width;
    end;

    /// The height in pixels.
    /// @returns the height in pixels
    const method Height(): int32;
    begin
      return self.Handle().height;
    end;

    /// The size in pixels.
    /// @returns the size in pixels
    const method Size(): Vector2;
    begin
      return Vector2(x: float32(self.Width()), y: float32(self.Height()));
    end;

    /// The mipmap levels (1: the texture alone).
    /// @returns the mipmap levels (1: the texture alone)
    const method Mipmaps(): int32;
    begin
      return self.Handle().mipmaps;
    end;

    /// The pixel format.
    /// @returns the pixel format
    const method Format(): Pixel;
    begin
      return Pixel(self.Handle().format);
    end;

    /// Replaces every pixel with `APixels` (the texture's size and format). C: UpdateTexture
    /// @param APixels the pixels
    method Update(const APixels: ptr to const);
    begin
      UpdateTexture(self.Handle(), APixels);
    end;

    /// Replaces the pixels of `ARect` with `APixels`. C: UpdateTextureRec
    /// @param ARect the rectangle
    /// @param APixels the pixels
    method Update(const ARect: Rectangle; const APixels: ptr to const);
    begin
      UpdateTextureRec(self.Handle(), ARect, APixels);
    end;

    /// Adds every mipmap level. C: GenTextureMipmaps
    /// @returns this object, so calls chain
    method GenMipmaps(): self;
    begin
      if (self.FHold <> nil) and not self.FHold.Released then
        GenTextureMipmaps(addr of self.FHold.FTexture);
      end;
      return self;
    end;

    /// How the texture is sampled when scaled. C: SetTextureFilter
    /// @param AFilter the filter
    /// @returns this object, so calls chain
    method SetFilter(const AFilter: Filter): self;
    begin
      SetTextureFilter(self.Handle(), int32(AFilter));
      return self;
    end;

    /// How the texture repeats past its edges. C: SetTextureWrap
    /// @param AWrap the wrap mode
    /// @returns this object, so calls chain
    method SetWrap(const AWrap: WrapMode): self;
    begin
      SetTextureWrap(self.Handle(), int32(AWrap));
      return self;
    end;

    /// The texture's pixels back as an image. C: LoadImageFromTexture
    /// @returns the texture's pixels back as an image
    const method ToImage(): ImageRes;
    begin
      return ImageRes.Adopt(LoadImageFromTexture(self.Handle()));
    end;
  end;

  /// A texture drawn into (raylib's framebuffer object): drawing between `Begin` and `End`
  /// lands in it, in its own pixels, then `Draw.Texture` shows it the right way up. A shared
  /// handle: the last copy unloads it, the window's close too.
  /// C: UnloadRenderTexture (the last copy's release)
  /// @example `LCanvas: RenderTextureRes(160, 90); LCanvas.Begin(); Draw.Circle(Vector2(x: 80, y: 45), 20.0f, RED); RenderTextureRes.End();`
  RenderTextureRes = object
    hidden FHold: ref RenderTextureHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing), as a
    /// variable declared with no arguments starts.
    init();
    begin
    end;

    /// A `AWidth` x `AHeight` render texture (RGBA, with a depth buffer). C: LoadRenderTexture
    /// @param AWidth the width
    /// @param AHeight the height
    init(const AWidth: int32; const AHeight: int32);
    begin
      self.FHold := DoRenderTextureHold(LoadRenderTexture(AWidth, AHeight));
    end;

    /// A `AWidth` x `AHeight` render texture of pixel format `AFormat`. C: LoadRenderTextureEx
    /// @param AWidth the width
    /// @param AHeight the height
    /// @param AFormat the pixel format
    init(const AWidth: int32; const AHeight: int32; const AFormat: Pixel);
    begin
      self.FHold := DoRenderTextureHold(LoadRenderTextureEx(AWidth, AHeight, int32(AFormat)));
    end;

    /// Takes the .C render texture `ATarget` over: unloaded with the last copy (or the window).
    /// @param ATarget the target
    /// @returns the new `RenderTextureRes`
    static method Adopt(const ATarget: RenderTexture2D): RenderTextureRes;
    var
      LRes: RenderTextureRes;
    begin
      LRes.FHold := DoRenderTextureHold(ATarget);
      return LRes;
    end;

    /// The .C render texture (borrowed, for .C calls; an empty one when none is held).
    /// @returns the .C render texture (borrowed, for .C calls; an empty one when none is held)
    const method Handle(): RenderTexture2D;
    var
      LNone: RenderTexture2D;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return LNone;
      end;
      return self.FHold.FTarget;
    end;

    /// True when the render texture is on the GPU. C: IsRenderTextureValid
    /// @returns `true` when the render texture is on the GPU
    const method IsValid(): bool;
    begin
      return IsRenderTextureValid(self.Handle());
    end;

    /// Its color texture (a view: valid while this render texture lives). Drawn as it is, it
    /// is upside down (OpenGL's rows): `Draw.Texture` of the render texture itself is not.
    /// @returns its color texture (a view: valid while this render texture lives)
    const method Texture(): TextureRes;
    begin
      return TextureRes.View(self.Handle().texture);
    end;

    /// Its depth texture (a view, as Texture).
    /// @returns its depth texture (a view, as Texture)
    const method Depth(): TextureRes;
    begin
      return TextureRes.View(self.Handle().depth);
    end;

    /// The width in pixels.
    /// @returns the width in pixels
    const method Width(): int32;
    begin
      return self.Handle().texture.width;
    end;

    /// The height in pixels.
    /// @returns the height in pixels
    const method Height(): int32;
    begin
      return self.Handle().texture.height;
    end;

    /// Drawing lands in this texture, in its pixels, until End (inside a frame too: the frame
    /// comes back at End). C: BeginTextureMode
    const method Begin();
    begin
      DoBeginTexture(self.Handle());
    end;

    /// Ends Begin: drawing goes to the window (and the frame) again. C: EndTextureMode
    static method End();
    begin
      DoEndTexture();
    end;
  end;

  /// A font: its glyph atlas on the GPU (the window must be open), drawn by `Draw.Text`. A
  /// shared handle: the last copy unloads it, the window's close too; `FontRes.Default()`
  /// is raylib's own font (never unloaded).
  /// C: UnloadFont (the last copy's release)
  /// @example `LMono: FontRes("fonts/JetBrainsMonoRegular.ttf", 32); Draw.Text(LMono, "Score", Vector2(x: 8, y: 8), 32.0f, 1.0f, WHITE);`
  FontRes = object
    hidden FHold: ref FontHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing), as a
    /// variable declared with no arguments starts.
    init();
    begin
    end;

    /// Loads the font file at `APath` (from the mounted source) at its default size.
    /// C: LoadFont
    /// @param APath the file's path
    init(const APath: string);
    begin
      self.FHold := DoFontHold(LoadFont(APath), true);
    end;

    /// Loads the font file at `APath` at `ASize` pixels, raylib's default 95 glyphs.
    /// C: LoadFontEx
    /// @param APath the file's path
    /// @param ASize the size
    init(const APath: string; const ASize: int32);
    begin
      self.FHold := DoFontHold(LoadFontEx(APath, ASize, nil, 0), true);
    end;

    /// Loads the font file at `APath` at `ASize` pixels, the glyphs of `ACodepoints` (none:
    /// raylib's default 95). C: LoadFontEx
    /// @param APath the file's path
    /// @param ASize the size
    /// @param ACodepoints the codepoints
    init(const APath: string; const ASize: int32; const ACodepoints: array of int32);
    begin
      if len(ACodepoints) = 0 then
        self.FHold := DoFontHold(LoadFontEx(APath, ASize, nil, 0), true);
        return;
      end;
      self.FHold := DoFontHold(LoadFontEx(APath, ASize, addr of ACodepoints[0],
        int32(len(ACodepoints))), true);
    end;

    /// Takes the .C font `AFont` over: unloaded with the last copy (or the window; raylib's
    /// default font never is).
    /// @param AFont the font
    /// @returns the new `FontRes`
    static method Adopt(const AFont: Font): FontRes;
    var
      LRes: FontRes;
    begin
      LRes.FHold := DoFontHold(AFont, true);
      return LRes;
    end;

    /// raylib's default font (never unloaded). C: GetFontDefault
    /// @returns raylib's default font (never unloaded)
    static method Default(): FontRes;
    var
      LRes: FontRes;
    begin
      LRes.FHold := DoFontHold(GetFontDefault(), false);
      return LRes;
    end;

    /// Loads a font of type `AType` (".ttf" ...) from `AIO` at `ASize` pixels, raylib's
    /// default 95 glyphs.
    /// @param AIO the IO
    /// @param AType the type
    /// @param ASize the size
    /// @returns the new `FontRes`
    static method FromIO(const AIO: IO; const AType: string; const ASize: int32): FontRes;
    begin
      return FontRes.Adopt(LoadFontExIO(AIO, AType, ASize, nil, 0));
    end;

    /// Loads a font of type `AType` (".ttf" ...) from the file bytes `AData` at `ASize`
    /// pixels, the glyphs of `ACodepoints` (none: raylib's default 95). C: LoadFontFromMemory
    /// @param AType the type
    /// @param AData the bytes
    /// @param ASize the size
    /// @param ACodepoints the codepoints
    /// @returns the new `FontRes`
    static method FromMemory(const AType: string; const AData: array of uint8;
      const ASize: int32; const ACodepoints: array of int32): FontRes;
    var
      LNone: Font;
    begin
      if len(AData) = 0 then
        return FontRes.Adopt(LNone);
      end;
      if len(ACodepoints) = 0 then
        return FontRes.Adopt(LoadFontFromMemory(AType, addr of AData[0], int32(len(AData)),
          ASize, nil, 0));
      end;
      return FontRes.Adopt(LoadFontFromMemory(AType, addr of AData[0], int32(len(AData)),
        ASize, addr of ACodepoints[0], int32(len(ACodepoints))));
    end;

    /// A bitmap font from `AImage`: glyphs in a row from `AFirstChar`, parted by the key color
    /// `AKey`. C: LoadFontFromImage
    /// @param AImage the image
    /// @param AKey the key
    /// @param AFirstChar the first char
    /// @returns a bitmap font from `AImage`: glyphs in a row from `AFirstChar`, parted by the key color `AKey`
    static method FromImage(const AImage: ImageRes; const AKey: Color;
      const AFirstChar: int32): FontRes;
    begin
      return FontRes.Adopt(LoadFontFromImage(AImage.Handle(), AKey, AFirstChar));
    end;

    /// The glyphs of the font file `AData` (for ImageRes.FontAtlas): GlyphsRes's own init.
    /// C: LoadFontData
    /// @param AData the bytes
    /// @param ASize the size
    /// @param ACodepoints the codepoints
    /// @param AKind the kind
    /// @returns the glyphs of the font file `AData` (for ImageRes.FontAtlas): GlyphsRes's own init
    static method Glyphs(const AData: array of uint8; const ASize: int32;
      const ACodepoints: array of int32; const AKind: FontKind): GlyphsRes;
    begin
      return GlyphsRes(AData, ASize, ACodepoints, AKind);
    end;

    /// The .C font (borrowed, for .C calls; raylib's default font when none is held).
    /// @returns the .C font (borrowed, for .C calls; raylib's default font when none is held)
    const method Handle(): Font;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return GetFontDefault();
      end;
      return self.FHold.FFont;
    end;

    /// True when the font holds glyphs and an atlas. C: IsFontValid
    /// @returns `true` when the font holds glyphs and an atlas
    const method IsValid(): bool;
    begin
      return IsFontValid(self.Handle());
    end;

    /// The size the glyphs were made at.
    /// @returns the size the glyphs were made at
    const method BaseSize(): int32;
    begin
      return self.Handle().baseSize;
    end;

    /// How many glyphs the font holds.
    /// @returns how many glyphs the font holds
    const method GlyphCount(): int32;
    begin
      return self.Handle().glyphCount;
    end;

    /// The padding around each glyph in the atlas.
    /// @returns the padding around each glyph in the atlas
    const method GlyphPadding(): int32;
    begin
      return self.Handle().glyphPadding;
    end;

    /// The size `AText` takes at `ASize`, `ASpacing` between glyphs. C: MeasureTextEx
    /// @param AText the text
    /// @param ASize the size
    /// @param ASpacing the spacing
    /// @returns the size `AText` takes at `ASize`, `ASpacing` between glyphs
    const method Measure(const AText: string; const ASize: float32;
      const ASpacing: float32): Vector2;
    begin
      return MeasureTextEx(self.Handle(), AText, ASize, ASpacing);
    end;

    /// The width `AText` takes at `ASize` by raylib's DrawText rules (10 the least, one unit
    /// of spacing per whole 10): `Draw.Text`'s default-font form, measured. C: MeasureText
    /// @param AText the text
    /// @param ASize the size
    /// @returns the width `AText` takes at `ASize` by raylib's DrawText rules (10 the least, one unit of spacing per whole 10): `Draw.Text`'s default-font form, measured
    /// @example `LW := FontRes.Default().Measure("Game Over", 20);`
    const method Measure(const AText: string; const ASize: int32): int32;
    var
      LSize: float32;
    begin
      LSize := Max(float32(ASize), 10.0f);
      return int32(Trunc(MeasureTextEx(self.Handle(), AText, LSize,
        float32(Trunc(LSize / 10.0f))).x));
    end;

    /// The size the codepoints `ACodepoints` take. C: MeasureTextCodepoints
    /// @param ACodepoints the codepoints
    /// @param ASize the size
    /// @param ASpacing the spacing
    /// @returns the size the codepoints `ACodepoints` take
    const method Measure(const ACodepoints: array of int32; const ASize: float32;
      const ASpacing: float32): Vector2;
    begin
      if len(ACodepoints) = 0 then
        return Vector2(x: 0.0f, y: 0.0f);
      end;
      return MeasureTextCodepoints(self.Handle(), addr of ACodepoints[0],
        int32(len(ACodepoints)), ASize, ASpacing);
    end;

    /// The index of codepoint `ACodepoint`'s glyph ('?''s when the font lacks it).
    /// C: GetGlyphIndex
    /// @param ACodepoint the codepoint
    /// @returns the index of codepoint `ACodepoint`'s glyph ('?''s when the font lacks it)
    const method GlyphIndex(const ACodepoint: int32): int32;
    begin
      return GetGlyphIndex(self.Handle(), ACodepoint);
    end;

    /// Codepoint `ACodepoint`'s glyph. C: GetGlyphInfo
    /// @param ACodepoint the codepoint
    /// @returns codepoint `ACodepoint`'s glyph
    const method Glyph(const ACodepoint: int32): GlyphInfo;
    begin
      return GetGlyphInfo(self.Handle(), ACodepoint);
    end;

    /// Codepoint `ACodepoint`'s rectangle in the atlas. C: GetGlyphAtlasRec
    /// @param ACodepoint the codepoint
    /// @returns codepoint `ACodepoint`'s rectangle in the atlas
    const method GlyphRect(const ACodepoint: int32): Rectangle;
    begin
      return GetGlyphAtlasRec(self.Handle(), ACodepoint);
    end;

    /// The glyph atlas (a view: valid while this font lives).
    /// @returns the glyph atlas (a view: valid while this font lives)
    const method Atlas(): TextureRes;
    begin
      return TextureRes.View(self.Handle().texture);
    end;

    /// Saves the font as a C header at `APath`. C: ExportFontAsCode
    /// @param APath the file's path
    /// @returns `true` when the file was written
    const method ExportAsCode(const APath: string): bool;
    begin
      return self.IsValid() and ExportFontAsCode(self.Handle(), APath);
    end;

    /// The gap between lines of a text with line breaks, for every font. C: SetTextLineSpacing
    /// @param ASpacing the spacing
    static method LineSpacing(const ASpacing: int32);
    begin
      SetTextLineSpacing(ASpacing);
    end;
  end;

// The image members that name TextureRes or FontRes (declared above them: a type is visible
// only after its declaration)
public extend ImageRes
  /// `ATexture`'s pixels as a new image. C: LoadImageFromTexture
  /// @param ATexture the texture
  /// @returns `ATexture`'s pixels as a new image
  static method FromTexture(const ATexture: TextureRes): ImageRes;
  begin
    return ATexture.ToImage();
  end;

  /// An image `AWidth` x `AHeight` holding `AText` (raylib's test pattern). C: GenImageText
  /// @param AWidth the width
  /// @param AHeight the height
  /// @param AText the text
  /// @returns an image `AWidth` x `AHeight` holding `AText` (raylib's test pattern)
  static method FromText(const AWidth: int32; const AHeight: int32; const AText: string): ImageRes;
  begin
    return ImageRes.Adopt(GenImageText(AWidth, AHeight, AText));
  end;

  /// An image of `AText` in raylib's default font at `ASize`. C: ImageText
  /// @param AText the text
  /// @param ASize the size
  /// @param AColor the colour
  /// @returns an image of `AText` in raylib's default font at `ASize`
  static method FromText(const AText: string; const ASize: int32; const AColor: Color): ImageRes;
  begin
    return ImageRes.Adopt(ImageText(AText, ASize, AColor));
  end;

  /// An image of `AText` in `AFont` at `ASize`, `ASpacing` between glyphs. C: ImageTextEx
  /// @param AFont the font
  /// @param AText the text
  /// @param ASize the size
  /// @param ASpacing the spacing
  /// @param ATint the tint colour
  /// @returns an image of `AText` in `AFont` at `ASize`, `ASpacing` between glyphs
  static method FromText(const AFont: FontRes; const AText: string; const ASize: float32;
    const ASpacing: float32; const ATint: Color): ImageRes;
  begin
    return ImageRes.Adopt(ImageTextEx(AFont.Handle(), AText, ASize, ASpacing, ATint));
  end;

  /// `AText` in raylib's default font at `ASize` pixels. C: ImageDrawText
  /// @param AText the text
  /// @param APos the position
  /// @param ASize the size
  /// @param AColor the colour
  /// @returns `AText` in raylib's default font at `ASize` pixels
  method Text(const AText: string; const APos: Vector2; const ASize: int32;
    const AColor: Color): ImageRes;
  begin
    if self.FHold <> nil then
      ImageDrawText(addr of self.FHold.FImage, AText, DoRound(APos.x), DoRound(APos.y), ASize,
        AColor);
    end;
    return self;
  end;

  /// `AText` in `AFont` at `ASize`, `ASpacing` between glyphs. C: ImageDrawTextEx
  /// @param AFont the font
  /// @param AText the text
  /// @param APos the position
  /// @param ASize the size
  /// @param ASpacing the spacing
  /// @param ATint the tint colour
  /// @returns `AText` in `AFont` at `ASize`, `ASpacing` between glyphs
  method Text(const AFont: FontRes; const AText: string; const APos: Vector2;
    const ASize: float32; const ASpacing: float32; const ATint: Color): ImageRes;
  begin
    if self.FHold <> nil then
      ImageDrawTextEx(addr of self.FHold.FImage, AFont.Handle(), AText, APos, ASize, ASpacing,
        ATint);
    end;
    return self;
  end;

  /// `AText` in `AFont` turned `ARotation` degrees about `AOrigin`. C: ImageDrawTextPro
  /// @param AFont the font
  /// @param AText the text
  /// @param APos the position
  /// @param AOrigin the origin
  /// @param ARotation the rotation
  /// @param ASize the size
  /// @param ASpacing the spacing
  /// @param ATint the tint colour
  /// @returns `AText` in `AFont` turned `ARotation` degrees about `AOrigin`
  method Text(const AFont: FontRes; const AText: string; const APos: Vector2;
    const AOrigin: Vector2; const ARotation: float32; const ASize: float32;
    const ASpacing: float32; const ATint: Color): ImageRes;
  begin
    if self.FHold <> nil then
      ImageDrawTextPro(addr of self.FHold.FImage, AFont.Handle(), AText, APos, AOrigin,
        ARotation, ASize, ASpacing, ATint);
    end;
    return self;
  end;

  /// The image as a texture (the window must be open). C: LoadTextureFromImage
  /// @returns the image as a texture (the window must be open)
  const method ToTexture(): TextureRes;
  begin
    return TextureRes.FromImage(self);
  end;

  /// The image's six faces, laid out as `ALayout`, as a cubemap. C: LoadTextureCubemap
  /// @param ALayout the layout
  /// @returns the image's six faces, laid out as `ALayout`, as a cubemap
  const method ToCubemap(const ALayout: CubeLayout): TextureRes;
  begin
    return TextureRes.Cubemap(self, ALayout);
  end;
end;

// ============================================================================
// The 3D resources (sec 6): shaders, materials, meshes, models and their
// animations, on the same holders. A model's meshes and materials are holders
// of their own: `Mesh(I)` / `Material(I)` share them (they outlive the model
// if kept), `SetMaterial` / `FromMesh` share a Res into the model, and the
// textures a model's loader made are unloaded with their material.
// ============================================================================

public type
  /// A GPU shader program (vertex + fragment): a shared handle, unloaded with the last copy
  /// or the window's close. Draws between `Begin` and `End` go through it.
  /// C: UnloadShader (the last copy's release)
  /// @example `LGlow := ShaderRes("", "res/assets/shaders/glow.fs"); LGlow.Set(LGlow.Location("strength"), 0.5f);`
  ShaderRes = object
    hidden FHold: ref ShaderHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing), as a
    /// variable declared with no arguments starts.
    init();
    begin
    end;

    /// Loads and links the shader files at `AVertexPath` / `AFragmentPath` (from the mounted
    /// source); "" takes raylib's default for that stage. C: LoadShader
    /// @param AVertexPath the vertex path
    /// @param AFragmentPath the fragment path
    init(const AVertexPath: string; const AFragmentPath: string);
    var
      LVertex: CString;
      LFragment: CString;
    begin
      LVertex := CString(AVertexPath);
      LFragment := CString(AFragmentPath);
      self.FHold := DoShaderHold(LoadShader(LVertex.OrNil, LFragment.OrNil));
    end;

    /// Takes the .C shader `AShader` over: unloaded with the last copy (or the window).
    /// @param AShader the shader
    /// @returns the new `ShaderRes`
    static method Adopt(const AShader: Shader): ShaderRes;
    var
      LRes: ShaderRes;
    begin
      LRes.FHold := DoShaderHold(AShader);
      return LRes;
    end;

    /// Compiles and links the GLSL sources `AVertex` / `AFragment`; "" takes raylib's
    /// default for that stage. C: LoadShaderFromMemory
    /// @param AVertex the vertex
    /// @param AFragment the fragment
    /// @returns the new `ShaderRes`
    static method FromCode(const AVertex: string; const AFragment: string): ShaderRes;
    var
      LVertex: CString;
      LFragment: CString;
    begin
      LVertex := CString(AVertex);
      LFragment := CString(AFragment);
      return ShaderRes.Adopt(LoadShaderFromMemory(LVertex.OrNil, LFragment.OrNil));
    end;

    /// Loads the stages from `AVertex` / `AFragment` (nil takes raylib's default for that
    /// stage).
    /// @param AVertex the vertex
    /// @param AFragment the fragment
    /// @returns the new `ShaderRes`
    static method FromIO(const AVertex: IO; const AFragment: IO): ShaderRes;
    begin
      return ShaderRes.Adopt(LoadShaderIO(AVertex, AFragment));
    end;

    /// The .C shader (borrowed, for .C calls; raylib's empty shader when none is held).
    /// @returns the .C shader (borrowed, for .C calls; raylib's empty shader when none is held)
    const method Handle(): Shader;
    var
      LNone: Shader;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return LNone;
      end;
      return self.FHold.FShader;
    end;

    /// True when the program is linked on the GPU. C: IsShaderValid
    /// @returns `true` when the program is linked on the GPU
    const method IsValid(): bool;
    begin
      return IsShaderValid(self.Handle());
    end;

    /// The location of the uniform `AName` (-1 when the program has none). C: GetShaderLocation
    /// @param AName the name
    /// @returns the location of the uniform `AName` (-1 when the program has none)
    const method Location(const AName: string): int32;
    begin
      return GetShaderLocation(self.Handle(), AName);
    end;

    /// The location of the vertex attribute `AName` (-1 when the program has none).
    /// C: GetShaderLocationAttrib
    /// @param AName the name
    /// @returns the location of the vertex attribute `AName` (-1 when the program has none)
    const method Attrib(const AName: string): int32;
    begin
      return GetShaderLocationAttrib(self.Handle(), AName);
    end;

    /// Makes raylib's drawing feed `ALoc` through `ALocation` (a uniform or an attribute of
    /// this program, from Location / Attrib). C: shader.locs[]
    /// @param ALoc the loc
    /// @param ALocation the location
    /// @returns this object, so calls chain
    method SetLoc(const ALoc: ShaderLoc; const ALocation: int32): self;
    var
      LShader: Shader;
    begin
      LShader := self.Handle();
      if LShader.locs <> nil then
        LShader.locs[int64(ALoc)] := ALocation;
      end;
      return self;
    end;

    /// Sets the float uniform at `ALocation`. C: SetShaderValue
    /// @param ALocation the location
    /// @param AValue the value
    /// @returns this object, so calls chain
    method Set(const ALocation: int32; const AValue: float32): self;
    begin
      SetShaderValue(self.Handle(), ALocation, addr of AValue, int32(UniformType.Float));
      return self;
    end;

    /// Sets the int uniform (or sampler unit) at `ALocation`. C: SetShaderValue
    /// @param ALocation the location
    /// @param AValue the value
    /// @returns this object, so calls chain
    method Set(const ALocation: int32; const AValue: int32): self;
    begin
      SetShaderValue(self.Handle(), ALocation, addr of AValue, int32(UniformType.Int));
      return self;
    end;

    /// Sets the vec2 uniform at `ALocation`. C: SetShaderValue
    /// @param ALocation the location
    /// @param AValue the value
    /// @returns this object, so calls chain
    method Set(const ALocation: int32; const AValue: Vector2): self;
    begin
      SetShaderValue(self.Handle(), ALocation, addr of AValue, int32(UniformType.Vec2));
      return self;
    end;

    /// Sets the vec3 uniform at `ALocation`. C: SetShaderValue
    /// @param ALocation the location
    /// @param AValue the value
    /// @returns this object, so calls chain
    method Set(const ALocation: int32; const AValue: Vector3): self;
    begin
      SetShaderValue(self.Handle(), ALocation, addr of AValue, int32(UniformType.Vec3));
      return self;
    end;

    /// Sets the vec4 uniform at `ALocation`. C: SetShaderValue
    /// @param ALocation the location
    /// @param AValue the value
    /// @returns this object, so calls chain
    method Set(const ALocation: int32; const AValue: Vector4): self;
    begin
      SetShaderValue(self.Handle(), ALocation, addr of AValue, int32(UniformType.Vec4));
      return self;
    end;

    /// Sets the vec4 uniform at `ALocation` to `AColor` normalized (each channel 0..1).
    /// C: SetShaderValue, ColorNormalize
    /// @param ALocation the location
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method Set(const ALocation: int32; const AColor: Color): self;
    var
      LValue: Vector4;
    begin
      LValue := ColorNormalize(AColor);
      SetShaderValue(self.Handle(), ALocation, addr of LValue, int32(UniformType.Vec4));
      return self;
    end;

    /// Sets the uniform array at `ALocation` from `AValues` as elements of `AType` (a vec3
    /// takes three values each; an int / uint type takes each value as a whole number).
    /// C: SetShaderValueV
    /// @param ALocation the location
    /// @param AValues the values
    /// @param AType the type
    /// @returns this object, so calls chain
    method Set(const ALocation: int32; const AValues: array of float32;
      const AType: UniformType): self;
    var
      LParts: int64;
      LCount: int64;
      LWhole: array of int32;
      LI: int64;
    begin
      LParts := DoUniformParts(AType);
      LCount := len(AValues) div LParts;
      if LCount = 0 then
        return self;
      end;
      if DoUniformFloats(AType) then
        SetShaderValueV(self.Handle(), ALocation, addr of AValues[0], int32(AType),
          int32(LCount));
        return self;
      end;
      // An int / uint / sampler element: the values as whole numbers (truncated)
      setlength(LWhole, LCount * LParts);
      for LI := 0 to LCount * LParts - 1 do
        LWhole[LI] := int32(Trunc(float64(AValues[LI])));
      end;
      SetShaderValueV(self.Handle(), ALocation, addr of LWhole[0], int32(AType), int32(LCount));
      return self;
    end;

    /// Sets the mat4 uniform at `ALocation`. C: SetShaderValueMatrix
    /// @param ALocation the location
    /// @param AMatrix the matrix
    /// @returns this object, so calls chain
    method Set(const ALocation: int32; const AMatrix: Matrix): self;
    begin
      SetShaderValueMatrix(self.Handle(), ALocation, AMatrix);
      return self;
    end;

    /// Binds `ATexture` to the sampler uniform at `ALocation`. C: SetShaderValueTexture
    /// @param ALocation the location
    /// @param ATexture the texture
    /// @returns this object, so calls chain
    method Set(const ALocation: int32; const ATexture: TextureRes): self;
    begin
      SetShaderValueTexture(self.Handle(), ALocation, ATexture.Handle());
      return self;
    end;

    /// Drawing goes through this shader until End (the shader kept alive until then).
    /// C: BeginShaderMode
    const method Begin();
    begin
      GShaderHold := self.FHold;
      BeginShaderMode(self.Handle());
    end;

    /// Ends Begin: raylib's default shader again. C: EndShaderMode
    static method End();
    begin
      EndShaderMode();
      GShaderHold := nil;
    end;
  end;

type
  // A material's holder: its maps (always its own) and the textures / shader it loaded
  // (FOwnTex / FOwnShader). A texture or shader set from a Res is kept alive here instead
  // (FKeepTex / FKeepShader, the Res values: a copy shares) and never unloaded by the material. raylib's UnloadMaterial
  // would unload whatever the maps hold, a shared texture included, so the unload is its own.
  MaterialHold = object(ResHold)
    FMaterial: Material;
    // Per map (ADAM_RAYLIB_MATERIAL_MAPS): the material loaded the map's texture
    FOwnTex: array of bool;
    // Per map: a texture set from a TextureRes, kept alive (an empty handle for none)
    FKeepTex: array of TextureRes;
    FOwnShader: bool;
    // A shader set from a ShaderRes, kept alive
    FKeepShader: ShaderRes;

    done;
    begin
      self.Release();
    end;

    // True when map AMap's texture is also owned by another of the material's maps (raylib's
    // glTF loader gives one texture to the metalness and roughness maps)
    const method SharedTexture(const AMap: int64): bool;
    var
      LId: uint32;
      LI: int64;
    begin
      LId := self.FMaterial.maps[AMap].texture.id;
      for LI := 0 to ADAM_RAYLIB_MATERIAL_MAPS - 1 do
        if (LI <> AMap) and self.FOwnTex[LI] and (self.FMaterial.maps[LI].texture.id = LId) then
          return true;
        end;
      end;
      return false;
    end;

    // Map AMap's texture is replaced: one the material loaded is unloaded now (unless
    // another map still holds it), a kept one let go
    method DropTexture(const AMap: int64);
    var
      LNone: TextureRes;
    begin
      if self.FOwnTex[AMap] then
        if not self.SharedTexture(AMap) and (DoWindowId() = self.WindowId) then
          rlUnloadTexture(self.FMaterial.maps[AMap].texture.id);
        end;
        self.FOwnTex[AMap] := false;
      end;
      self.FKeepTex[AMap] := LNone;
    end;

    // The shader is replaced: one the material loaded is unloaded now, a kept one let go
    method DropShader();
    var
      LNone: ShaderRes;
    begin
      if self.FOwnShader then
        if DoWindowId() = self.WindowId then
          UnloadShader(self.FMaterial.shader);
        else
          MemFree(self.FMaterial.shader.locs);
        end;
        self.FOwnShader := false;
      end;
      self.FKeepShader := LNone;
    end;

    override method Unload(const AWhole: bool);
    var
      LI: int64;
    begin
      if self.FMaterial.maps = nil then
        return;
      end;
      for LI := 0 to ADAM_RAYLIB_MATERIAL_MAPS - 1 do
        // A texture two maps own is unloaded at the last of them
        if AWhole and self.FOwnTex[LI] and not self.SharedTexture(LI) then
          rlUnloadTexture(self.FMaterial.maps[LI].texture.id);
        end;
        self.FOwnTex[LI] := false;
      end;
      if self.FOwnShader then
        if AWhole then
          UnloadShader(self.FMaterial.shader);
        else
          MemFree(self.FMaterial.shader.locs);
        end;
      end;
      MemFree(self.FMaterial.maps);
    end;
  end;

// A holder of AMaterial on the window open now, owning its maps and what it loaded: every
// map texture but raylib's default one, its shader unless it is raylib's default
func DoMaterialHold(const AMaterial: Material): ref MaterialHold;
var
  LHold: ref MaterialHold;
  LId: uint32;
  LI: int64;
begin
  LHold := ref MaterialHold();
  LHold.FMaterial := AMaterial;
  LHold.WindowId := DoWindowId();
  setlength(LHold.FOwnTex, ADAM_RAYLIB_MATERIAL_MAPS);
  setlength(LHold.FKeepTex, ADAM_RAYLIB_MATERIAL_MAPS);
  for LI := 0 to ADAM_RAYLIB_MATERIAL_MAPS - 1 do
    LHold.FOwnTex[LI] := false;
    if AMaterial.maps <> nil then
      LId := AMaterial.maps[LI].texture.id;
      LHold.FOwnTex[LI] := (LId <> 0) and (LId <> rlGetTextureIdDefault());
    end;
  end;
  LHold.FOwnShader := (AMaterial.shader.id <> 0) and (AMaterial.shader.locs <> nil) and
    (AMaterial.shader.id <> rlGetShaderIdDefault());
  LHold.Live := AMaterial.maps <> nil;
  if LHold.Live and (LHold.WindowId <> 0) then
    DoTrackGPU(LHold);
  end;
  return LHold;
end;

public type
  /// A material: a shader and its maps (a texture, a colour and a value each), what a mesh is
  /// drawn with. A shared handle, unloaded with the last copy or the window's close: the
  /// textures and shader it loaded go with it, one set from a Res is kept alive by it.
  /// C: UnloadMaterial (the last copy's release)
  /// @example `LSkin := MaterialRes.Default().SetTexture(MapIndex.Albedo, LTex).SetColor(MapIndex.Albedo, GOLD);`
  MaterialRes = object
    hidden FHold: ref MaterialHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing), as a
    /// variable declared with no arguments starts.
    init();
    begin
    end;

    /// Takes the .C material `AMaterial` over: its maps, and the textures and shader that
    /// are not raylib's defaults, unloaded with the last copy (or the window).
    /// @param AMaterial the material
    /// @returns the new `MaterialRes`
    static method Adopt(const AMaterial: Material): MaterialRes;
    var
      LRes: MaterialRes;
    begin
      LRes.FHold := DoMaterialHold(AMaterial);
      return LRes;
    end;

    /// raylib's default material (its default shader, a white albedo). C: LoadMaterialDefault
    /// @returns raylib's default material (its default shader, a white albedo)
    static method Default(): MaterialRes;
    begin
      return MaterialRes.Adopt(LoadMaterialDefault());
    end;

    /// The materials of the file at `APath` (an .mtl, from the mounted source; its textures
    /// load beside it). C: LoadMaterials
    /// @param APath the file's path
    /// @returns the materials of the file at `APath` (an .mtl, from the mounted source; its textures load beside it)
    static method Load(const APath: string): array of MaterialRes;
    var
      LCount: int32;
      LMaterials: ptr to Material;
      LResult: array of MaterialRes;
      LI: int64;
    begin
      LCount := 0;
      LMaterials := LoadMaterials(APath, addr of LCount);
      setlength(LResult, 0);
      if LMaterials = nil then
        return LResult;
      end;
      setlength(LResult, int64(LCount));
      for LI := 0 to int64(LCount) - 1 do
        LResult[LI] := MaterialRes.Adopt(LMaterials[LI]);
      end;
      // The records are the holders' now: raylib's array alone is given back
      MemFree(LMaterials);
      return LResult;
    end;

    /// The .C material (borrowed, for .C calls; raylib's empty material when none is held).
    /// @returns the .C material (borrowed, for .C calls; raylib's empty material when none is held)
    const method Handle(): Material;
    var
      LNone: Material;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return LNone;
      end;
      return self.FHold.FMaterial;
    end;

    /// True when the material has its maps and a shader. C: IsMaterialValid
    /// @returns `true` when the material has its maps and a shader
    const method IsValid(): bool;
    begin
      return IsMaterialValid(self.Handle());
    end;

    /// Map `AMap` takes `ATexture` (kept alive by the material; a texture the material
    /// loaded for that map is unloaded). C: SetMaterialTexture
    /// @param AMap the map
    /// @param ATexture the texture
    /// @returns this object, so calls chain
    method SetTexture(const AMap: MapIndex; const ATexture: TextureRes): self;
    var
      LHold: ref MaterialHold;
    begin
      LHold := self.FHold;
      if (LHold = nil) or LHold.Released or (LHold.FMaterial.maps = nil) then
        return self;
      end;
      LHold.DropTexture(int64(AMap));
      LHold.FKeepTex[int64(AMap)] := ATexture;
      SetMaterialTexture(addr of LHold.FMaterial, int32(AMap), ATexture.Handle());
      return self;
    end;

    /// Map `AMap`'s colour (the albedo map's tints the texture).
    /// @param AMap the map
    /// @param AColor the colour
    /// @returns this object, so calls chain
    method SetColor(const AMap: MapIndex; const AColor: Color): self;
    var
      LMaterial: Material;
    begin
      LMaterial := self.Handle();
      if LMaterial.maps <> nil then
        LMaterial.maps[int64(AMap)].color := AColor;
      end;
      return self;
    end;

    /// Map `AMap`'s value (a strength the shader reads: metalness, roughness ...).
    /// @param AMap the map
    /// @param AValue the value
    /// @returns this object, so calls chain
    method SetValue(const AMap: MapIndex; const AValue: float32): self;
    var
      LMaterial: Material;
    begin
      LMaterial := self.Handle();
      if LMaterial.maps <> nil then
        LMaterial.maps[int64(AMap)].value := AValue;
      end;
      return self;
    end;

    /// The material draws through `AShader` (kept alive by it; a shader the material loaded
    /// is unloaded).
    /// @param AShader the shader
    /// @returns this object, so calls chain
    method SetShader(const AShader: ShaderRes): self;
    var
      LHold: ref MaterialHold;
    begin
      LHold := self.FHold;
      if (LHold = nil) or LHold.Released then
        return self;
      end;
      LHold.DropShader();
      LHold.FKeepShader := AShader;
      LHold.FMaterial.shader := AShader.Handle();
      return self;
    end;
  end;

  /// A mesh: vertex data on the CPU and its buffers on the GPU (uploaded as it is made). A
  /// shared handle, unloaded with the last copy or the window's close; a model's meshes are
  /// MeshRes too, so a mesh lives while any model or handle still uses it.
  /// C: UnloadMesh (the last copy's release)
  /// @example `LBall := MeshRes.Sphere(1.0f, 16, 16); LBall.Draw(MaterialRes.Default(), MatrixIdentity());`
  MeshRes = object
    hidden FHold: ref MeshHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing), as a
    /// variable declared with no arguments starts.
    init();
    begin
    end;

    /// Takes the .C mesh `AMesh` over: its data and buffers unloaded with the last copy (or
    /// the window).
    /// @param AMesh the mesh
    /// @returns the new `MeshRes`
    static method Adopt(const AMesh: Mesh): MeshRes;
    var
      LRes: MeshRes;
    begin
      LRes.FHold := DoMeshHold(AMesh);
      return LRes;
    end;

    /// A flat polygon of `ASides` sides. C: GenMeshPoly
    /// @param ASides how many sides
    /// @param ARadius the radius
    /// @returns a flat polygon of `ASides` sides
    static method Poly(const ASides: int32; const ARadius: float32): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshPoly(ASides, ARadius));
    end;

    /// A flat plane `AWidth` x `ALength`, `AResX` x `AResZ` quads. C: GenMeshPlane
    /// @param AWidth the width
    /// @param ALength the length
    /// @param AResX the res X
    /// @param AResZ the res Z
    /// @returns a flat plane `AWidth` x `ALength`, `AResX` x `AResZ` quads
    static method Plane(const AWidth: float32; const ALength: float32; const AResX: int32;
      const AResZ: int32): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshPlane(AWidth, ALength, AResX, AResZ));
    end;

    /// A box. C: GenMeshCube
    /// @param AWidth the width
    /// @param AHeight the height
    /// @param ALength the length
    /// @returns a box
    static method Cube(const AWidth: float32; const AHeight: float32;
      const ALength: float32): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshCube(AWidth, AHeight, ALength));
    end;

    /// A sphere of `ARings` rings and `ASlices` slices. C: GenMeshSphere
    /// @param ARadius the radius
    /// @param ARings how many rings
    /// @param ASlices how many slices
    /// @returns a sphere of `ARings` rings and `ASlices` slices
    static method Sphere(const ARadius: float32; const ARings: int32;
      const ASlices: int32): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshSphere(ARadius, ARings, ASlices));
    end;

    /// A half sphere (no base). C: GenMeshHemiSphere
    /// @param ARadius the radius
    /// @param ARings how many rings
    /// @param ASlices how many slices
    /// @returns a half sphere (no base)
    static method HemiSphere(const ARadius: float32; const ARings: int32;
      const ASlices: int32): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshHemiSphere(ARadius, ARings, ASlices));
    end;

    /// A cylinder. C: GenMeshCylinder
    /// @param ARadius the radius
    /// @param AHeight the height
    /// @param ASlices how many slices
    /// @returns a cylinder
    static method Cylinder(const ARadius: float32; const AHeight: float32;
      const ASlices: int32): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshCylinder(ARadius, AHeight, ASlices));
    end;

    /// A cone (its base `ARadius`). C: GenMeshCone
    /// @param ARadius the radius
    /// @param AHeight the height
    /// @param ASlices how many slices
    /// @returns a cone (its base `ARadius`)
    static method Cone(const ARadius: float32; const AHeight: float32;
      const ASlices: int32): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshCone(ARadius, AHeight, ASlices));
    end;

    /// A torus (`ASize` its tube's radius). C: GenMeshTorus
    /// @param ARadius the radius
    /// @param ASize the size
    /// @param ARadSeg the rad seg
    /// @param ASides how many sides
    /// @returns a torus (`ASize` its tube's radius)
    static method Torus(const ARadius: float32; const ASize: float32; const ARadSeg: int32;
      const ASides: int32): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshTorus(ARadius, ASize, ARadSeg, ASides));
    end;

    /// A trefoil knot. C: GenMeshKnot
    /// @param ARadius the radius
    /// @param ASize the size
    /// @param ARadSeg the rad seg
    /// @param ASides how many sides
    /// @returns a trefoil knot
    static method Knot(const ARadius: float32; const ASize: float32; const ARadSeg: int32;
      const ASides: int32): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshKnot(ARadius, ASize, ARadSeg, ASides));
    end;

    /// A terrain from `AImage`'s brightness, `ASize` its extent. C: GenMeshHeightmap
    /// @param AImage the image
    /// @param ASize the size
    /// @returns a terrain from `AImage`'s brightness, `ASize` its extent
    static method Heightmap(const AImage: ImageRes; const ASize: Vector3): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshHeightmap(AImage.Handle(), ASize));
    end;

    /// Walls from `AImage` (a white pixel a cube of `ACubeSize`). C: GenMeshCubicmap
    /// @param AImage the image
    /// @param ACubeSize the cube size
    /// @returns the new `MeshRes`
    static method Cubicmap(const AImage: ImageRes; const ACubeSize: Vector3): MeshRes;
    begin
      return MeshRes.Adopt(GenMeshCubicmap(AImage.Handle(), ACubeSize));
    end;

    /// The .C mesh (borrowed, for .C calls; raylib's empty mesh when none is held).
    /// @returns the .C mesh (borrowed, for .C calls; raylib's empty mesh when none is held)
    const method Handle(): Mesh;
    var
      LNone: Mesh;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return LNone;
      end;
      return self.FHold.FMesh;
    end;

    /// True when the mesh's buffers are on the GPU (it can be drawn).
    /// @returns `true` when the mesh's buffers are on the GPU (it can be drawn)
    const method IsValid(): bool;
    begin
      return self.Handle().vboId <> nil;
    end;

    /// The vertices.
    /// @returns the vertices
    const method VertexCount(): int32;
    begin
      return self.Handle().vertexCount;
    end;

    /// The triangles.
    /// @returns the triangles
    const method TriangleCount(): int32;
    begin
      return self.Handle().triangleCount;
    end;

    /// Puts the vertex data on the GPU (`ADynamic`: buffers meant for UpdateBuffer); a mesh
    /// made here is uploaded already, so this is for an adopted one. C: UploadMesh
    /// @param ADynamic `true` for a buffer meant to be updated
    /// @returns this object, so calls chain
    method Upload(const ADynamic: bool): self;
    begin
      if (self.FHold <> nil) and not self.FHold.Released then
        UploadMesh(addr of self.FHold.FMesh, ADynamic);
      end;
      return self;
    end;

    /// Replaces `ASize` bytes at `AOffset` of vertex buffer `AIndex` with `AData`.
    /// C: UpdateMeshBuffer
    /// @param AIndex the index, from 0
    /// @param AData the data
    /// @param ASize the size
    /// @param AOffset the offset
    /// @returns this object, so calls chain
    method UpdateBuffer(const AIndex: int32; const AData: ptr to const; const ASize: int32;
      const AOffset: int32): self;
    begin
      UpdateMeshBuffer(self.Handle(), AIndex, AData, ASize, AOffset);
      return self;
    end;

    /// Computes the tangents (for normal maps). C: GenMeshTangents
    /// @returns this object, so calls chain
    method GenTangents(): self;
    begin
      if (self.FHold <> nil) and not self.FHold.Released then
        GenMeshTangents(addr of self.FHold.FMesh);
      end;
      return self;
    end;

    /// The box around the vertices. C: GetMeshBoundingBox
    /// @returns the box around the vertices
    const method Bounds(): BoundingBox;
    begin
      return GetMeshBoundingBox(self.Handle());
    end;

    /// Draws the mesh with `AMaterial`, placed by `ATransform` (inside Begin3D). C: DrawMesh
    /// @param AMaterial the material
    /// @param ATransform the transform
    const method Draw(const AMaterial: MaterialRes; const ATransform: Matrix);
    begin
      if not self.IsValid() or (AMaterial.Handle().maps = nil) then
        return;
      end;
      DrawMesh(self.Handle(), AMaterial.Handle(), ATransform);
    end;

    /// Draws the mesh once per transform of `ATransforms` (a shader that reads the instance
    /// transform attribute). C: DrawMeshInstanced
    /// @param AMaterial the material
    /// @param ATransforms the transforms
    const method DrawInstanced(const AMaterial: MaterialRes; const ATransforms: array of Matrix);
    begin
      if not self.IsValid() or (AMaterial.Handle().maps = nil) or (len(ATransforms) = 0) then
        return;
      end;
      DrawMeshInstanced(self.Handle(), AMaterial.Handle(), addr of ATransforms[0],
        int32(len(ATransforms)));
    end;

    /// Writes the mesh as an .obj file. C: ExportMesh
    /// @param APath the file's path
    /// @returns `true` when the file was written
    const method Export(const APath: string): bool;
    begin
      return ExportMesh(self.Handle(), APath);
    end;

    /// Writes the mesh as a C header of arrays. C: ExportMeshAsCode
    /// @param APath the file's path
    /// @returns `true` when the file was written
    const method ExportAsCode(const APath: string): bool;
    begin
      return ExportMeshAsCode(self.Handle(), APath);
    end;
  end;

// The ray member that names MeshRes (declared above it)
public extend Ray
  /// Where the ray meets `AMesh` placed by `ATransform` (its vertex data). C: GetRayCollisionMesh
  /// @param AMesh the mesh
  /// @param ATransform the transform
  /// @returns where the ray meets `AMesh` placed by `ATransform` (its vertex data)
  const method HitMesh(const AMesh: MeshRes; const ATransform: Matrix): RayCollision;
  var
    LNone: RayCollision;
  begin
    if AMesh.Handle().vertices = nil then
      return LNone;
    end;
    return GetRayCollisionMesh(self, AMesh.Handle(), ATransform);
  end;
end;

public type
  /// One animation clip of a set LoadModelAnimations reads from a model file: a shared
  /// handle on the set, unloaded with the last copy of any of its clips.
  /// @example `LClips := ModelAnimationRes.Load("res/assets/models/robot.glb"); LRobot.Animate(LClips[0], LFrame);`
  ModelAnimationRes = object
    hidden FHold: ref AnimationsHold;
    hidden FIndex: int64;

    /// An empty handle (holds nothing: `IsValid()` false), as a variable declared with no
    /// arguments starts.
    init();
    begin
    end;

    /// Takes the set `AAnimations` of `ACount` clips over (LoadModelAnimations's result):
    /// unloaded with the last copy of its clips. C: UnloadModelAnimations
    /// @param AAnimations the animations
    /// @param ACount how many
    /// @returns a handle for each clip
    static method Adopt(const AAnimations: ptr to ModelAnimation;
      const ACount: int32): array of ModelAnimationRes;
    var
      LHold: ref AnimationsHold;
      LResult: array of ModelAnimationRes;
      LI: int64;
    begin
      setlength(LResult, 0);
      if AAnimations = nil then
        return LResult;
      end;
      LHold := ref AnimationsHold();
      LHold.FAnims := AAnimations;
      LHold.FCount := ACount;
      setlength(LResult, int64(ACount));
      for LI := 0 to int64(ACount) - 1 do
        LResult[LI].FHold := LHold;
        LResult[LI].FIndex := LI;
      end;
      return LResult;
    end;

    /// The animation clips of the model file at `APath` (from the mounted source).
    /// C: LoadModelAnimations
    /// @param APath the file's path
    /// @returns the animation clips of the model file at `APath` (from the mounted source)
    static method Load(const APath: string): array of ModelAnimationRes;
    var
      LCount: int32;
      LAnims: ptr to ModelAnimation;
    begin
      LCount := 0;
      LAnims := LoadModelAnimations(APath, addr of LCount);
      return ModelAnimationRes.Adopt(LAnims, LCount);
    end;

    /// The .C clip (borrowed, for .C calls; raylib's empty clip when none is held).
    /// @returns the .C clip (borrowed, for .C calls; raylib's empty clip when none is held)
    const method Handle(): ModelAnimation;
    var
      LNone: ModelAnimation;
    begin
      if self.FHold = nil then
        return LNone;
      end;
      return self.FHold.FAnims[self.FIndex];
    end;

    /// True when the handle holds a clip with frames.
    /// @returns `true` when the handle holds a clip with frames
    const method IsValid(): bool;
    begin
      return self.Handle().keyframePoses <> nil;
    end;

    /// The clip's name (as the model file gives it).
    /// @returns the clip's name (as the model file gives it)
    const method Name(): string;
    var
      LClip: ModelAnimation;
      LCount: int64;
    begin
      LClip := self.Handle();
      // raylib's name field holds 32 chars, NUL ended when shorter
      LCount := 0;
      while (LCount < 32) and (LClip.name[LCount] <> char(0)) do
        LCount += 1;
      end;
      return StringFromC(addr of LClip.name[0], LCount);
    end;

    /// The bones each frame poses.
    /// @returns the bones each frame poses
    const method BoneCount(): int32;
    begin
      return int32(self.Handle().boneCount);
    end;

    /// The frames.
    /// @returns the frames
    const method FrameCount(): int32;
    begin
      return self.Handle().keyframeCount;
    end;
  end;

type
  // A model's holder: raylib's model record, whose meshes / materials arrays are copies of
  // its slots' records (DoModelSync writes them before every use; a slot shares its MeshRes /
  // MaterialRes, so Mesh(I) / Material(I) / SetMaterial / FromMesh all share). Its own
  // memory is CPU only (the arrays, the skeleton, the pose).
  ModelHold = object
    FModel: Model;
    FMeshes: array of MeshRes;
    FMaterials: array of MaterialRes;

    done;
    begin
      // UnloadModel's own part (the meshes and materials are the slots')
      MemFree(self.FModel.meshes);
      MemFree(self.FModel.materials);
      MemFree(self.FModel.meshMaterial);
      MemFree(self.FModel.skeleton.bones);
      MemFree(self.FModel.skeleton.bindPose);
      MemFree(self.FModel.currentPose);
      MemFree(self.FModel.boneMatrices);
    end;
  end;

// A holder of AModel: each of its meshes and materials becomes a Res of its own (so the
// textures a loader made are unloaded with their material: raylib's UnloadModel leaves them)
func DoModelHold(const AModel: Model): ref ModelHold;
var
  LHold: ref ModelHold;
  LI: int64;
begin
  LHold := ref ModelHold();
  LHold.FModel := AModel;
  setlength(LHold.FMeshes, int64(AModel.meshCount));
  for LI := 0 to int64(AModel.meshCount) - 1 do
    LHold.FMeshes[LI] := MeshRes.Adopt(AModel.meshes[LI]);
  end;
  setlength(LHold.FMaterials, int64(AModel.materialCount));
  for LI := 0 to int64(AModel.materialCount) - 1 do
    LHold.FMaterials[LI] := MaterialRes.Adopt(AModel.materials[LI]);
  end;
  return LHold;
end;

// Writes AHold's slots' records into raylib's model arrays (a mesh's buffers or a
// material's shader may have changed through its own handle since).
// @returns false when there is no model or a slot is gone or empty (nothing to draw then)
func DoModelSync(const AHold: ref ModelHold): bool;
var
  LMesh: Mesh;
  LMaterial: Material;
  LI: int64;
begin
  if (AHold = nil) or (len(AHold.FMeshes) = 0) then
    return false;
  end;
  for LI := 0 to len(AHold.FMeshes) - 1 do
    LMesh := AHold.FMeshes[LI].Handle();
    if LMesh.vboId = nil then
      return false;
    end;
    AHold.FModel.meshes[LI] := LMesh;
  end;
  for LI := 0 to len(AHold.FMaterials) - 1 do
    LMaterial := AHold.FMaterials[LI].Handle();
    if LMaterial.maps = nil then
      return false;
    end;
    AHold.FModel.materials[LI] := LMaterial;
  end;
  return true;
end;

public type
  /// A model: meshes, the materials they are drawn with, and (for an animated file) a
  /// skeleton. A shared handle; its meshes and materials are MeshRes / MaterialRes of their
  /// own, unloaded with their last user (the window's close too).
  /// C: UnloadModel (the last copy's release)
  /// @example `LRobot: ModelRes("res/assets/models/robot.glb"); LRobot.Draw(Vector3Zero(), 1.0f, WHITE);`
  ModelRes = object
    hidden FHold: ref ModelHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing), as a
    /// variable declared with no arguments starts.
    init();
    begin
    end;

    /// Loads the model file at `APath` (glTF / glb, OBJ, IQM, VOX, M3D; its materials and
    /// textures from beside it in the mounted source). C: LoadModel
    /// @param APath the file's path
    init(const APath: string);
    begin
      self.FHold := DoModelHold(LoadModel(APath));
    end;

    /// Takes the .C model `AModel` over (its meshes, materials, the textures and shaders its
    /// materials hold that are not raylib's defaults, its skeleton).
    /// @param AModel the model
    /// @returns the new `ModelRes`
    static method Adopt(const AModel: Model): ModelRes;
    var
      LRes: ModelRes;
    begin
      LRes.FHold := DoModelHold(AModel);
      return LRes;
    end;

    /// A model of `AMesh` alone (shared: the mesh stays `AMesh`'s too) with raylib's default
    /// material. C: LoadModelFromMesh
    /// @param AMesh the mesh
    /// @returns a model of `AMesh` alone (shared: the mesh stays `AMesh`'s too) with raylib's default material
    static method FromMesh(const AMesh: MeshRes): ModelRes;
    var
      LRes: ModelRes;
      LHold: ref ModelHold;
    begin
      if not AMesh.IsValid() then
        return LRes;
      end;
      LHold := ref ModelHold();
      LHold.FModel := LoadModelFromMesh(AMesh.Handle());
      setlength(LHold.FMeshes, 1);
      LHold.FMeshes[0] := AMesh;
      setlength(LHold.FMaterials, 1);
      LHold.FMaterials[0] := MaterialRes.Adopt(LHold.FModel.materials[0]);
      LRes.FHold := LHold;
      return LRes;
    end;

    /// The .C model (borrowed, for .C calls; raylib's empty model when none is held).
    /// @returns the .C model (borrowed, for .C calls; raylib's empty model when none is held)
    const method Handle(): Model;
    var
      LNone: Model;
    begin
      if not DoModelSync(self.FHold) then
        return LNone;
      end;
      return self.FHold.FModel;
    end;

    /// True when every mesh is on the GPU with a material. C: IsModelValid
    /// @returns `true` when every mesh is on the GPU with a material
    const method IsValid(): bool;
    begin
      return IsModelValid(self.Handle());
    end;

    /// The box around every mesh, through the model's transform. C: GetModelBoundingBox
    /// @returns the box around every mesh, through the model's transform
    const method Bounds(): BoundingBox;
    begin
      return GetModelBoundingBox(self.Handle());
    end;

    /// The meshes.
    /// @returns the meshes
    const method MeshCount(): int32;
    begin
      if self.FHold = nil then
        return 0;
      end;
      return int32(len(self.FHold.FMeshes));
    end;

    /// The materials.
    /// @returns the materials
    const method MaterialCount(): int32;
    begin
      if self.FHold = nil then
        return 0;
      end;
      return int32(len(self.FHold.FMaterials));
    end;

    /// Mesh `AIndex` (shared with the model; an empty handle out of range).
    /// @param AIndex the index, from 0
    /// @returns mesh `AIndex` (shared with the model; an empty handle out of range)
    const method Mesh(const AIndex: int32): MeshRes;
    var
      LNone: MeshRes;
    begin
      if (AIndex < 0) or (AIndex >= self.MeshCount()) then
        return LNone;
      end;
      return self.FHold.FMeshes[int64(AIndex)];
    end;

    /// Material `AIndex` (shared with the model: a change shows in the model; an empty
    /// handle out of range).
    /// @param AIndex the index, from 0
    /// @returns material `AIndex` (shared with the model: a change shows in the model; an empty handle out of range)
    const method Material(const AIndex: int32): MaterialRes;
    var
      LNone: MaterialRes;
    begin
      if (AIndex < 0) or (AIndex >= self.MaterialCount()) then
        return LNone;
      end;
      return self.FHold.FMaterials[int64(AIndex)];
    end;

    /// Mesh `AMesh` is drawn with material `AMaterial` (both in range, else no change).
    /// C: SetModelMeshMaterial
    /// @param AMesh the mesh
    /// @param AMaterial the material's index
    /// @returns this object, so calls chain
    method SetMeshMaterial(const AMesh: int32; const AMaterial: int32): self;
    begin
      if (AMesh < 0) or (AMesh >= self.MeshCount()) or (AMaterial < 0) or
        (AMaterial >= self.MaterialCount()) then
        return self;
      end;
      self.FHold.FModel.meshMaterial[int64(AMesh)] := AMaterial;
      return self;
    end;

    /// Material slot `AIndex` takes `AMaterial` (shared; the slot's material before goes
    /// with its last user). In range, else no change.
    /// @param AIndex the index, from 0
    /// @param AMaterial the material
    /// @returns this object, so calls chain
    method SetMaterial(const AIndex: int32; const AMaterial: MaterialRes): self;
    begin
      if (AIndex < 0) or (AIndex >= self.MaterialCount()) or not AMaterial.IsValid() then
        return self;
      end;
      self.FHold.FMaterials[int64(AIndex)] := AMaterial;
      return self;
    end;

    /// The model's transform (applied to every mesh as it is drawn).
    property Transform: Matrix
    read
    begin
      if self.FHold = nil then
        return MatrixIdentity();
      end;
      return self.FHold.FModel.transform;
    end;
    write(ATransform)
    begin
      if self.FHold <> nil then
        self.FHold.FModel.transform := ATransform;
      end;
    end;

    /// Draws the model at `APosition`, scaled, tinted (inside Begin3D). C: DrawModel
    /// @param APosition the position
    /// @param AScale the scale
    /// @param ATint the tint colour
    const method Draw(const APosition: Vector3; const AScale: float32; const ATint: Color);
    begin
      if DoModelSync(self.FHold) then
        DrawModel(self.FHold.FModel, APosition, AScale, ATint);
      end;
    end;

    /// Draws the model at `APosition`, turned `AAngle` degrees about `AAxis`, scaled per axis.
    /// C: DrawModelEx
    /// @param APosition the position
    /// @param AAxis the axis
    /// @param AAngle the angle
    /// @param AScale the scale
    /// @param ATint the tint colour
    const method Draw(const APosition: Vector3; const AAxis: Vector3; const AAngle: float32;
      const AScale: Vector3; const ATint: Color);
    begin
      if DoModelSync(self.FHold) then
        DrawModelEx(self.FHold.FModel, APosition, AAxis, AAngle, AScale, ATint);
      end;
    end;

    /// Draws the model's triangle edges. C: DrawModelWires
    /// @param APosition the position
    /// @param AScale the scale
    /// @param ATint the tint colour
    const method DrawWires(const APosition: Vector3; const AScale: float32; const ATint: Color);
    begin
      if DoModelSync(self.FHold) then
        DrawModelWires(self.FHold.FModel, APosition, AScale, ATint);
      end;
    end;

    /// Draws the model's triangle edges, turned and scaled per axis. C: DrawModelWiresEx
    /// @param APosition the position
    /// @param AAxis the axis
    /// @param AAngle the angle
    /// @param AScale the scale
    /// @param ATint the tint colour
    const method DrawWires(const APosition: Vector3; const AAxis: Vector3;
      const AAngle: float32; const AScale: Vector3; const ATint: Color);
    begin
      if DoModelSync(self.FHold) then
        DrawModelWiresEx(self.FHold.FModel, APosition, AAxis, AAngle, AScale, ATint);
      end;
    end;

    /// Poses the model at frame `AFrame` of `AClip` (fractions blend neighbouring frames).
    /// C: UpdateModelAnimation
    /// @param AClip the clip
    /// @param AFrame the frame
    method Animate(const AClip: ModelAnimationRes; const AFrame: float32);
    begin
      if AClip.IsValid() and DoModelSync(self.FHold) then
        UpdateModelAnimation(self.FHold.FModel, AClip.Handle(), AFrame);
      end;
    end;

    /// Poses the model between frame `AFrameA` of `AClipA` and frame `AFrameB` of `AClipB`
    /// (`ABlend` 0: A alone, 1: B alone). C: UpdateModelAnimationEx
    /// @param AClipA the clip A
    /// @param AFrameA the frame A
    /// @param AClipB the clip B
    /// @param AFrameB the frame B
    /// @param ABlend the blend
    method Animate(const AClipA: ModelAnimationRes; const AFrameA: float32;
      const AClipB: ModelAnimationRes; const AFrameB: float32; const ABlend: float32);
    begin
      if AClipA.IsValid() and AClipB.IsValid() and DoModelSync(self.FHold) then
        UpdateModelAnimationEx(self.FHold.FModel, AClipA.Handle(), AFrameA, AClipB.Handle(),
          AFrameB, ABlend);
      end;
    end;

    /// True when `AClip` poses this model's skeleton (the same bones). C: IsModelAnimationValid
    /// @param AClip the clip
    /// @returns `true` when `AClip` poses this model's skeleton (the same bones)
    const method Fits(const AClip: ModelAnimationRes): bool;
    begin
      if not AClip.IsValid() or (self.FHold = nil) then
        return false;
      end;
      return IsModelAnimationValid(self.FHold.FModel, AClip.Handle());
    end;
  end;

// ============================================================================
// Audio and video (sec 6): the audio device, waves, sounds, music, raw audio
// streams and MPEG-1 videos as shared handles on the same holders as the GPU
// resources. AudioDevice opens raylib's audio device (a copy shares it, the
// last copy's done closes it), first unloading every sound, music, stream
// and video still alive, so a global SoundRes never outlives the device.
// A wave is plain memory (no device needed). Audio callbacks and processors
// are closures, run on the audio device's own thread (CCallback<T>).
// ============================================================================

public type
  /// A routine raylib's audio thread calls with sample frames: an audio stream's callback
  /// (it fills `ABuffer` with `AFrames` frames) or a processor (it changes them in place,
  /// float32 samples, interleaved). A closure, so it may hold what it reads or writes; it
  /// runs on the audio thread, while raylib holds its audio lock.
  /// @example `LTone.Callback(func(ABuffer: ptr; AFrames: uint32) begin FillTone(ABuffer, AFrames); end);`
  AudioFunc = ref func(ABuffer: ptr; AFrames: uint32);

  /// An audio processor: a closure raylib runs over sample frames (float32, interleaved, in
  /// place) as they go to the speakers, attached to one stream (`AudioStreamRes.Attach`) or
  /// to everything mixed (`AudioDevice.AttachMixed`). A copy is the same processor, so the
  /// value attached is the one to detach.
  /// @example `LHalf := AudioProcessor(func(ABuffer: ptr; AFrames: uint32) begin Scale(ABuffer, AFrames, 0.5f); end); LStream.Attach(LHalf);`
  AudioProcessor = object
    hidden FCall: CCallback<AudioCallback>;

    /// No processor (`IsValid()` false: attaching it does nothing).
    init();
    begin
    end;

    /// A processor running `AFunc` on each block of frames.
    /// @param AFunc the closure the audio thread runs
    init(const AFunc: AudioFunc);
    begin
      if AFunc <> nil then
        self.FCall := CCallback<AudioCallback>(AFunc);
      end;
    end;

    /// True when it runs a closure.
    /// @returns whether it can be attached
    const method IsValid(): bool;
    begin
      return self.FCall.IsValid();
    end;

    /// The C function pointer raylib calls (nil when empty): for the .C attach calls, which
    /// then need this value kept alive while attached.
    /// @returns the thunk as raylib's AudioCallback
    const method Func(): AudioCallback;
    begin
      return self.FCall.Func();
    end;
  end;

type
  // A wave's holder (memory only)
  WaveHold = object(ResHold)
    FWave: Wave;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      UnloadWave(self.FWave);
    end;
  end;

  // A sound's holder; an alias (LoadSoundAlias) holds the sound whose data it plays, so that
  // one outlives it
  SoundHold = object(ResHold)
    FSound: Sound;
    FSource: ref SoundHold;

    done;
    begin
      self.Release();
    end;

    // Nothing is left to unload once the device is gone (raylib's buffers went with it)
    override method Unload(const AWhole: bool);
    begin
      if not IsAudioDeviceReady() then
        return;
      end;
      if self.FSource <> nil then
        UnloadSoundAlias(self.FSound);
      else
        UnloadSound(self.FSound);
      end;
    end;
  end;

  // A music stream's holder: one from an IO keeps its IO registered (UnloadMusicStreamIO),
  // one from memory keeps the file bytes raylib decodes while it plays
  MusicHold = object(ResHold)
    FMusic: Music;
    FFromIO: bool;
    FData: array of uint8;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    begin
      if IsAudioDeviceReady() then
        if self.FFromIO then
          UnloadMusicStreamIO(self.FMusic);
        else
          UnloadMusicStream(self.FMusic);
        end;
        return;
      end;
      // The device is gone with the stream: only the IO's registration is the holder's
      if self.FFromIO then
        UnregisterIO(DoTakeMusic(self.FMusic.ctxData));
      end;
    end;
  end;

  // An audio stream's holder: its callback and the processors attached to it, kept alive
  // while raylib may call them (detached before the stream goes)
  AudioStreamHold = object(ResHold)
    FStream: AudioStream;
    FCallback: CCallback<AudioCallback>;
    FProcessors: List<AudioProcessor>;

    done;
    begin
      self.Release();
    end;

    override method Unload(const AWhole: bool);
    var
      LI: int64;
    begin
      if not IsAudioDeviceReady() then
        return;
      end;
      for LI := 0 to self.FProcessors.Count - 1 do
        DetachAudioStreamProcessor(self.FStream, self.FProcessors.Items[LI].Func());
      end;
      UnloadAudioStream(self.FStream);
    end;
  end;

  // A video's holder (its player, LoadVideo's): listed with the GPU holders and the audio
  // ones, its window known once its first frame is shown (DoVideoBind); its status callback
  // kept alive while the player may call it
  VideoHold = object(ResHold)
    FPlayer: ptr to VideoPlayer;
    FStatus: CCallback<VideoStatusCallback>;

    done;
    begin
      self.Release();
    end;

    // The GPU part is left when its window went (AWhole false), the audio stream when the
    // device did; the rest (decoder, buffers, its own IO) is freed
    override method Unload(const AWhole: bool);
    begin
      if self.FPlayer = nil then
        return;
      end;
      if not AWhole then
        self.FPlayer^.GPU := false;
        self.FPlayer^.PlaneY.id := 0;
        self.FPlayer^.PlaneCb.id := 0;
        self.FPlayer^.PlaneCr.id := 0;
        self.FPlayer^.Frame.id := 0;
      end;
      if not IsAudioDeviceReady() then
        self.FPlayer^.HasAudio := false;
      end;
      DoVideoClose(self.FPlayer);
    end;
  end;

var
  // The AudioDevice values holding the device and the session they hold (0: none): the
  // last one's done closes it. A value from a session closed since holds nothing.
  GAudioHolds: int64;
  GAudioHeld: int64;
  GAudioSessions: int64;
  // The mixed processors attached (AudioDevice.AttachMixed), kept alive while attached
  GAudioMixed: List<AudioProcessor>;

// One more AudioDevice value holding the device as it is now: its session (0: no device
// open, nothing counted)
func DoAudioHold(): int64;
begin
  if not IsAudioDeviceReady() then
    return 0;
  end;
  if GAudioHeld = 0 then
    GAudioSessions += 1;
    GAudioHeld := GAudioSessions;
    GAudioHolds := 0;
  end;
  GAudioHolds += 1;
  return GAudioHeld;
end;

// A copy of an AudioDevice value holding ASession: counted while that session is held
func DoAudioShare(const ASession: int64): int64;
begin
  if (ASession = 0) or (ASession <> GAudioHeld) then
    return 0;
  end;
  GAudioHolds += 1;
  return ASession;
end;

// An AudioDevice value holding ASession goes: the last one unloads every audio resource
// still alive, detaches the mixed processors and closes the device
func DoAudioRelease(const ASession: int64);
var
  LI: int64;
begin
  if (ASession = 0) or (ASession <> GAudioHeld) or (GAudioHolds <= 0) then
    return;
  end;
  GAudioHolds -= 1;
  if GAudioHolds <> 0 then
    return;
  end;
  GAudioHeld := 0;
  if not IsAudioDeviceReady() then
    return;
  end;
  DoReleaseAudio();
  for LI := 0 to GAudioMixed.Count - 1 do
    DetachAudioMixedProcessor(GAudioMixed.Items[LI].Func());
  end;
  GAudioMixed.Clear();
  CloseAudioDevice();
end;

// The index of AProcessor (a copy of it: the same thunk) in AList (-1: none)
func DoProcessorIndex(const AList: List<AudioProcessor>;
  const AProcessor: AudioProcessor): int64;
var
  LI: int64;
begin
  for LI := 0 to AList.Count - 1 do
    if ptr(AList.Items[LI].Func()) = ptr(AProcessor.Func()) then
      return LI;
    end;
  end;
  return -1;
end;

// A holder of AWave (owned; nothing to own for a wave raylib could not load)
func DoWaveHold(const AWave: Wave): ref WaveHold;
var
  LHold: ref WaveHold;
begin
  LHold := ref WaveHold();
  LHold.FWave := AWave;
  LHold.Live := IsWaveValid(AWave);
  return LHold;
end;

// A holder of ASound (an alias of ASource's sound when ASource is set), listed for the
// device's close
func DoSoundHold(const ASound: Sound; const ASource: ref SoundHold): ref SoundHold;
var
  LHold: ref SoundHold;
begin
  LHold := ref SoundHold();
  LHold.FSound := ASound;
  LHold.FSource := ASource;
  LHold.Live := IsSoundValid(ASound);
  if LHold.Live then
    DoTrackAudio(LHold);
  end;
  return LHold;
end;

// A holder of AMusic (AFromIO: LoadMusicStreamIO's), listed for the device's close
func DoMusicHold(const AMusic: Music; const AFromIO: bool): ref MusicHold;
var
  LHold: ref MusicHold;
begin
  LHold := ref MusicHold();
  LHold.FMusic := AMusic;
  LHold.FFromIO := AFromIO;
  LHold.Live := IsMusicValid(AMusic);
  if LHold.Live then
    DoTrackAudio(LHold);
  end;
  return LHold;
end;

// A holder of AStream, listed for the device's close
func DoAudioStreamHold(const AStream: AudioStream): ref AudioStreamHold;
var
  LHold: ref AudioStreamHold;
begin
  LHold := ref AudioStreamHold();
  LHold.FStream := AStream;
  LHold.Live := IsAudioStreamValid(AStream);
  if LHold.Live then
    DoTrackAudio(LHold);
  end;
  return LHold;
end;

// A holder of AVideo's player, listed for the window's close and the device's
func DoVideoHold(const AVideo: Video): ref VideoHold;
var
  LHold: ref VideoHold;
begin
  LHold := ref VideoHold();
  LHold.FPlayer := DoPlayer(AVideo.ctxData);
  LHold.WindowId := 0;
  LHold.Live := LHold.FPlayer <> nil;
  if LHold.Live then
    DoTrackGPU(LHold);
    DoTrackAudio(LHold);
  end;
  return LHold;
end;

public type
  /// raylib's audio device: open while any copy is held (a copy shares it; the last copy's
  /// done unloads every sound, music, stream and video still alive, then closes it). Sounds,
  /// music and streams need it open; waves do not. C: InitAudioDevice / CloseAudioDevice
  /// @example `LAudio: AudioDevice; LAudio.Volume := 0.8f; LCoin := SoundRes("res/assets/audio/sfx/coin_pickup.ogg");`
  AudioDevice = object
    // The device session this value holds (0: none)
    hidden FSession: int64;

    /// Opens the device (holds the one open already, if any). `Ready()` false when no
    /// device could be opened. C: InitAudioDevice
    init();
    begin
      if not IsAudioDeviceReady() then
        InitAudioDevice();
      end;
      self.FSession := DoAudioHold();
    end;

    /// One more hold on the same device: it stays open while any copy is held.
    /// @param ASource the device value copied
    copy(const ASource: AudioDevice);
    begin
      self.FSession := DoAudioShare(ASource.FSession);
    end;

    /// Lets this hold go: the last one closes the device (every sound, music, stream and
    /// video still alive unloaded first).
    done;
    begin
      DoAudioRelease(self.FSession);
    end;

    /// True while the device is open. C: IsAudioDeviceReady
    /// @returns whether sounds play
    const method Ready(): bool;
    begin
      return (self.FSession <> 0) and (self.FSession = GAudioHeld) and IsAudioDeviceReady();
    end;

    /// The master volume as a level a person sets, 0 (silent) to 1 (full; clamped): equal
    /// steps sound like equal steps (System.Math's PerceivedVolume / PerceivedLevel over
    /// raylib's linear gain). C: GetMasterVolume / SetMasterVolume
    property Volume: float32
    read
    begin
      return PerceivedLevel(GetMasterVolume(), 1.0f);
    end;
    write(AVolume)
    begin
      SetMasterVolume(PerceivedVolume(AVolume, 1.0f));
    end;

    /// The buffer size, in sample frames, of the streams loaded after it (0: raylib's).
    /// C: SetAudioStreamBufferSizeDefault
    /// @param AFrames the frames of each buffer
    static method BufferSize(const AFrames: int32);
    begin
      SetAudioStreamBufferSizeDefault(AFrames);
    end;

    /// Runs `AProcessor` over everything mixed, kept alive until DetachMixed or the
    /// device's close. C: AttachAudioMixedProcessor
    /// @param AProcessor the processor
    /// @returns false when the device is not open or the processor is empty (nothing
    ///   attached); attaching one already attached does nothing more
    static method AttachMixed(const AProcessor: AudioProcessor): bool;
    begin
      if not IsAudioDeviceReady() or not AProcessor.IsValid() then
        return false;
      end;
      if DoProcessorIndex(GAudioMixed, AProcessor) < 0 then
        AttachAudioMixedProcessor(AProcessor.Func());
        GAudioMixed.Add(AProcessor);
      end;
      return true;
    end;

    /// Stops running `AProcessor` (the value AttachMixed was given, or a copy of it) over the
    /// mix. C: DetachAudioMixedProcessor
    /// @param AProcessor the processor
    static method DetachMixed(const AProcessor: AudioProcessor);
    var
      LI: int64;
    begin
      LI := DoProcessorIndex(GAudioMixed, AProcessor);
      if LI < 0 then
        return;
      end;
      if IsAudioDeviceReady() then
        DetachAudioMixedProcessor(AProcessor.Func());
      end;
      GAudioMixed.Delete(LI);
    end;
  end;

  /// Wave data (samples in memory, no device needed): a shared handle, unloaded with the
  /// last copy. Its changes (Crop, ToFormat) change it for every copy; `Copy()` gives one of
  /// its own.
  /// C: UnloadWave (the last copy's release)
  /// @example `LHit := WaveRes("res/assets/audio/sfx/explo_rock.ogg").Crop(0, 22050); LSound := LHit.ToSound();`
  WaveRes = object
    hidden FHold: ref WaveHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing).
    init();
    begin
    end;

    // The wave changed in place (nil when this value holds none)
    hidden method DoAt(): ptr to Wave;
    begin
      if (self.FHold = nil) or not self.FHold.Live or self.FHold.Released then
        return nil;
      end;
      return addr of self.FHold.FWave;
    end;

    /// Loads the sound file at `APath` (from the mounted source: .wav, .ogg, .mp3, .qoa,
    /// .flac). C: LoadWave
    /// @param APath the file's path
    init(const APath: string);
    begin
      self.FHold := DoWaveHold(LoadWave(APath));
    end;

    /// Takes the .C wave `AWave` over: unloaded with the last copy.
    /// @param AWave the wave
    /// @returns the new `WaveRes`
    static method Adopt(const AWave: Wave): WaveRes;
    var
      LRes: WaveRes;
    begin
      LRes.FHold := DoWaveHold(AWave);
      return LRes;
    end;

    /// Loads a wave of type `AType` (".wav" ...) from `AIO` (the IO stays the caller's).
    /// @param AIO the IO
    /// @param AType the type
    /// @returns the new `WaveRes`
    static method FromIO(const AIO: IO; const AType: string): WaveRes;
    begin
      return WaveRes.Adopt(LoadWaveIO(AIO, AType));
    end;

    /// Loads a wave of type `AType` (".wav" ...) from the file bytes `AData`.
    /// C: LoadWaveFromMemory
    /// @param AType the type
    /// @param AData the bytes
    /// @returns the new `WaveRes`
    static method FromMemory(const AType: string; const AData: array of uint8): WaveRes;
    var
      LNone: Wave;
    begin
      if len(AData) = 0 then
        return WaveRes.Adopt(LNone);
      end;
      return WaveRes.Adopt(LoadWaveFromMemory(AType, addr of AData[0], int32(len(AData))));
    end;

    /// The .C wave (borrowed, for .C calls; an empty one when none is held).
    /// @returns the .C wave (borrowed, for .C calls; an empty one when none is held)
    const method Handle(): Wave;
    var
      LNone: Wave;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return LNone;
      end;
      return self.FHold.FWave;
    end;

    /// True when it holds sample data. C: IsWaveValid
    /// @returns `true` when it holds sample data
    const method IsValid(): bool;
    begin
      return IsWaveValid(self.Handle());
    end;

    /// A wave of its own with the same samples. C: WaveCopy
    /// @returns a wave of its own with the same samples
    const method Copy(): WaveRes;
    var
      LNone: Wave;
    begin
      if not self.IsValid() then
        return WaveRes.Adopt(LNone);
      end;
      return WaveRes.Adopt(WaveCopy(self.Handle()));
    end;

    /// Keeps the frames `AFirst` up to (not including) `ALast` only. C: WaveCrop
    /// @param AFirst the first frame kept
    /// @param ALast the frame the kept ones end before
    /// @returns this object, so calls chain
    method Crop(const AFirst: int32; const ALast: int32): self;
    var
      LWave: ptr to Wave;
    begin
      LWave := self.DoAt();
      if LWave <> nil then
        WaveCrop(LWave, AFirst, ALast);
      end;
      return self;
    end;

    /// Converts the samples to `ASampleRate` Hz, `ASampleSize` bits (8, 16 or 32: float) and
    /// `AChannels` channels. C: WaveFormat
    /// @param ASampleRate the sample rate
    /// @param ASampleSize the sample size
    /// @param AChannels the channels
    /// @returns this object, so calls chain
    method ToFormat(const ASampleRate: int32; const ASampleSize: int32;
      const AChannels: int32): self;
    var
      LWave: ptr to Wave;
    begin
      LWave := self.DoAt();
      if LWave <> nil then
        WaveFormat(LWave, ASampleRate, ASampleSize, AChannels);
      end;
      return self;
    end;

    /// The samples as float32 (-1 .. 1), interleaved: Frames() x Channels() of them.
    /// C: LoadWaveSamples / UnloadWaveSamples
    /// @returns the samples as float32 (-1 .
    const method Samples(): array of float32;
    var
      LResult: array of float32;
      LSamples: ptr to float32;
      LCount: int64;
      LI: int64;
    begin
      if not self.IsValid() then
        return LResult;
      end;
      LSamples := LoadWaveSamples(self.Handle());
      if LSamples = nil then
        return LResult;
      end;
      LCount := int64(self.Handle().frameCount) * int64(self.Handle().channels);
      setlength(LResult, LCount);
      for LI := 0 to LCount - 1 do
        LResult[LI] := LSamples[LI];
      end;
      UnloadWaveSamples(LSamples);
      return LResult;
    end;

    /// Its length in sample frames.
    /// @returns its length in sample frames
    const method Frames(): int32;
    begin
      return int32(self.Handle().frameCount);
    end;

    /// Its sample rate in Hz.
    /// @returns its sample rate in Hz
    const method SampleRate(): int32;
    begin
      return int32(self.Handle().sampleRate);
    end;

    /// Bits per sample (8, 16 or 32).
    /// @returns the bits per sample (8, 16 or 32)
    const method SampleSize(): int32;
    begin
      return int32(self.Handle().sampleSize);
    end;

    /// Its channels (1 mono, 2 stereo).
    /// @returns its channels (1 mono, 2 stereo)
    const method Channels(): int32;
    begin
      return int32(self.Handle().channels);
    end;

    /// Writes the wave to the file `APath` (.wav or .qoa). C: ExportWave
    /// @param APath the file's path
    /// @returns false when it could not be written
    const method Export(const APath: string): bool;
    begin
      return self.IsValid() and ExportWave(self.Handle(), APath);
    end;

    /// Writes the samples as a C header to `APath`. C: ExportWaveAsCode
    /// @param APath the file's path
    /// @returns false when it could not be written
    const method ExportAsCode(const APath: string): bool;
    begin
      return self.IsValid() and ExportWaveAsCode(self.Handle(), APath);
    end;
  end;

  /// A sound effect (fully in memory, played at once): a shared handle, unloaded with the last
  /// copy or the device's close. Needs the audio device. `Alias()` gives one more voice of
  /// the same data, to play over itself.
  /// C: UnloadSound (the last copy's release)
  /// @example `LCoin := SoundRes("res/assets/audio/sfx/coin_pickup.ogg").Volume(0.6f); LCoin.Play();`
  SoundRes = object
    hidden FHold: ref SoundHold;

    /// An empty handle (holds nothing: `IsValid()` false, its changes do nothing).
    init();
    begin
    end;

    /// Loads the sound file at `APath` (from the mounted source). C: LoadSound
    /// @param APath the file's path
    init(const APath: string);
    var
      LNone: ref SoundHold;
    begin
      self.FHold := DoSoundHold(LoadSound(APath), LNone);
    end;

    /// Takes the .C sound `ASound` over: unloaded with the last copy (or the device).
    /// @param ASound the sound
    /// @returns the new `SoundRes`
    static method Adopt(const ASound: Sound): SoundRes;
    var
      LRes: SoundRes;
      LNone: ref SoundHold;
    begin
      LRes.FHold := DoSoundHold(ASound, LNone);
      return LRes;
    end;

    /// Loads a sound of type `AType` (".wav" ...) from `AIO` (the IO stays the caller's).
    /// @param AIO the IO
    /// @param AType the type
    /// @returns the new `SoundRes`
    static method FromIO(const AIO: IO; const AType: string): SoundRes;
    begin
      return SoundRes.Adopt(LoadSoundIO(AIO, AType));
    end;

    /// A sound of `AWave`'s samples (copied: the wave may go). C: LoadSoundFromWave
    /// @param AWave the wave
    /// @returns a sound of `AWave`'s samples (copied: the wave may go)
    static method FromWave(const AWave: WaveRes): SoundRes;
    var
      LNone: Sound;
    begin
      if not AWave.IsValid() then
        return SoundRes.Adopt(LNone);
      end;
      return SoundRes.Adopt(LoadSoundFromWave(AWave.Handle()));
    end;

    /// The .C sound (borrowed, for .C calls; an empty one when none is held).
    /// @returns the .C sound (borrowed, for .C calls; an empty one when none is held)
    const method Handle(): Sound;
    var
      LNone: Sound;
    begin
      if (self.FHold = nil) or self.FHold.Released then
        return LNone;
      end;
      return self.FHold.FSound;
    end;

    /// True when it holds a sound the device can play. C: IsSoundValid
    /// @returns `true` when it holds a sound the device can play
    const method IsValid(): bool;
    begin
      return IsSoundValid(self.Handle());
    end;

    /// One more voice playing this sound's data (its own volume, pitch, pan, position): the
    /// data stays while any alias does. C: LoadSoundAlias / UnloadSoundAlias
    /// @returns the new alias
    const method Alias(): SoundRes;
    var
      LRes: SoundRes;
      LSource: ref SoundHold;
    begin
      if not self.IsValid() then
        return LRes;
      end;
      // An alias of an alias plays the same data: it holds the sound that owns it
      LSource := self.FHold;
      if LSource.FSource <> nil then
        LSource := LSource.FSource;
      end;
      LRes.FHold := DoSoundHold(LoadSoundAlias(LSource.FSound), LSource);
      return LRes;
    end;

    /// Plays it from its start. C: PlaySound
    /// @returns this object, so calls chain
    method Play(): self;
    begin
      if self.IsValid() then
        PlaySound(self.Handle());
      end;
      return self;
    end;

    /// Stops it. C: StopSound
    /// @returns this object, so calls chain
    method Stop(): self;
    begin
      if self.IsValid() then
        StopSound(self.Handle());
      end;
      return self;
    end;

    /// Pauses it where it is. C: PauseSound
    /// @returns this object, so calls chain
