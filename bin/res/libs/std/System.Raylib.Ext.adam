// stays component-wise as Vector4Multiply; the Hamilton product is `Product`.
// @example `LRot := Quaternion.FromAxisAngle(Vector3(x: 0.0f, y: 1.0f, z: 0.0f), 0.5f);`
public extend Vector4
  /// The vector (0, 0, 0, 0). C: Vector4Zero
