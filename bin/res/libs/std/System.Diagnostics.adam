-------------------------------------------------------------------------------
  System.Diagnostics.adam - timing: Stopwatch and GetTimeStamp (PaskalCPP's
  Diagnostics, rewritten in Adam)

  A Stopwatch measures elapsed time over System.IO's high-resolution clock
  (PerformanceCounter / PerformanceFrequency). A new one is stopped at
  zero; Start runs it, Stop freezes the total, Start again adds on to it;
  Reset stops it at zero, Restart is zero and running. Start on a running
  one and Stop on a stopped one change nothing. Elapsed ticks are in the
  clock's units (Frequency per second), so ticks agree with milliseconds
  through Frequency. GetTimeStamp is the clock's reading itself.

  Target-neutral (PROJECT AT.3): the clock is System.IO's, whose platform
  unit holds the OS call; nothing here names an OS.
*******************************************************************************/

module unit System.Diagnostics;

import System.IO;

public const
  // Milliseconds in a second (ElapsedMilliseconds' scale)
  ADAM_DIAGNOSTICS_MS_PER_SECOND: int64 = 1000;

public type
  // Elapsed time over the high-resolution clock: stopped at zero when made
  Stopwatch = object
    // The ticks of every finished run (Start .. Stop) added up
    Total: int64;
    // The clock's reading at the running span's Start (meaningful while Running)
    StartedAt: int64;
    // True between Start and Stop
    Running: bool;

    // Stopped at zero
    init();
    begin
      self.Total := 0;
      self.StartedAt := 0;
      self.Running := false;
    end;

    // Runs it from where it stands; running already, nothing changes
    method Start();
    begin
      if not self.Running then
        self.StartedAt := PerformanceCounter();
        self.Running := true;
      end;
    end;

    // Freezes the total, the running span added on; stopped already, nothing changes
    method Stop();
    begin
      if self.Running then
        self.Total := self.Total + (PerformanceCounter() - self.StartedAt);
        self.Running := false;
      end;
    end;

    // Stopped at zero
    method Reset();
    begin
      self.Total := 0;
      self.StartedAt := 0;
      self.Running := false;
    end;

    // Zero and running again
    method Restart();
    begin
      self.Total := 0;
      self.StartedAt := PerformanceCounter();
      self.Running := true;
    end;

    // True while it runs
    method IsRunning(): bool;
    begin
      return self.Running;
    end;

    // The ticks elapsed (Frequency per second): the total, and the running span so far
    method ElapsedTicks(): int64;
    begin
      if self.Running then
        return self.Total + (PerformanceCounter() - self.StartedAt);
      end;
      return self.Total;
    end;

    // The whole milliseconds elapsed (ElapsedTicks scaled by Frequency, rounded down)
    method ElapsedMilliseconds(): int64;
    var
      LTicks: int64;
      LFrequency: int64;
    begin
      LTicks := self.ElapsedTicks();
      LFrequency := PerformanceFrequency();
      // Whole seconds and the rest apart, so ticks * 1000 never overflows int64
      return (LTicks div LFrequency) * ADAM_DIAGNOSTICS_MS_PER_SECOND +
        ((LTicks mod LFrequency) * ADAM_DIAGNOSTICS_MS_PER_SECOND) div LFrequency;
    end;

    // The clock's ticks per second (above 0)
    method Frequency(): int64;
    begin
      return PerformanceFrequency();
    end;
  end;

// A new Stopwatch, already running
public func cpplink StartNew(): Stopwatch;
var
  LWatch: Stopwatch;
begin
  LWatch.Start();
  return LWatch;
end;

// The high-resolution clock's reading now, in Stopwatch ticks (only the difference of two
// readings means anything)
public func cpplink GetTimeStamp(): int64;
begin
  return PerformanceCounter();
end;

end.
