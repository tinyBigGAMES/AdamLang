-------------------------------------------------------------------------------
  System.TOML.Ext.adam - TOML documents in Adam, over tomlc17's C API
  (System.TOML.C): a TOMLDocument parses a text or a file (read by
  System.Runtime's ReadFileBytes: target-neutral), then hands out its
  values by path with typed getters. Every getter returns false on a
  failure and leaves the reason in ErrorText, in Adam's form
  "file(line,col): message": a parse error at the place tomlc17 reports, a
  value error at the value it is about. What tomlc17 hands back is freed by
  the document's done (or its next parse); no getter result needs freeing.

  A path is keys joined by '.', each bare (A-Z a-z 0-9 _ -) or "quoted"
  (\" and \\ escaped: TOMLQuoteKey writes one), an array's item as [N]
  after a key or another item: `servers[0].ports[1]`, `"a.b".c`. The empty
  path is the document's top table (Count / KeyAt over it).
  TOMLQuoteString writes a value as a TOML basic string, for a program
  that writes a .toml file (a document is read-only).
  Target-neutral: no OS named.
*******************************************************************************/

module unit System.TOML.Ext;

import System.SysUtils, System.Runtime, System.TOML.C;

public type
  /// The kind of a value (TOML v1.0's kinds), as KindOf gives it.
  TOMLKind = choices(
    Missing,         /// The path names no value.
    String,          /// A string.
    Integer,         /// A whole number (int64).
    Float,           /// A float (float64).
    Boolean,         /// true or false.
    LocalDate,       /// A date with no time or offset.
    LocalTime,       /// A time with no date or offset.
    LocalDateTime,   /// A date and a time, no offset.
    OffsetDateTime,  /// A date and a time with an offset from UTC.
    Array,           /// An array.
    Table);          /// A table.

  /// A date / time value's parts, as GetDateTime gives them; those its Kind does not hold are 0
  /// (a LocalDate has no time, a LocalTime no date, only an OffsetDateTime an offset).
  TOMLDateTime = record
    /// Which of the four date / time kinds it is.
    Kind: TOMLKind;
    /// The year.
    Year: int32;
    /// The month, 1 .. 12.
    Month: int32;
    /// The day of the month, 1 .. 31.
    Day: int32;
    /// The hour, 0 .. 23.
    Hour: int32;
    /// The minute, 0 .. 59.
    Minute: int32;
    /// The second, 0 .. 60.
    Second: int32;
    /// The microsecond, 0 .. 999999.
    Microsecond: int32;
    /// The offset from UTC in minutes east (an OffsetDateTime's only).
    OffsetMinutes: int32;
  end;

const
  // The errors a document reports (after "file(line,col): ")
  ADAM_TOML_MSG_NO_DOCUMENT: string = "no document has been parsed";
  ADAM_TOML_MSG_READ_FAILED: string = "the file cannot be read";
  ADAM_TOML_MSG_TOO_LARGE: string = "the text is larger than 2 GB";
  ADAM_TOML_MSG_NO_ROOM: string = "out of memory";
  ADAM_TOML_MSG_BAD_PATH: string = "bad path ";
  ADAM_TOML_MSG_AT_BYTE: string = " at byte ";
  ADAM_TOML_MSG_NOT_FOUND: string = " not found";
  ADAM_TOML_MSG_IS: string = " is ";
  ADAM_TOML_MSG_NOT: string = ", not ";
  ADAM_TOML_MSG_OUT_OF_RANGE: string = " is out of range (";
  ADAM_TOML_MSG_ITEMS: string = " items)";
  ADAM_TOML_MSG_KEYS: string = " keys)";
  ADAM_TOML_MSG_NO_KEY: string = " has no key ";
  ADAM_TOML_MSG_DOCUMENT: string = "the document";
  ADAM_TOML_MSG_TABLE: string = "a table";
  ADAM_TOML_MSG_ARRAY: string = "an array";
  ADAM_TOML_MSG_LIST: string = "an array or a table";
  ADAM_TOML_MSG_STAMP: string = "a date or a time";
  // The name errors carry when ParseText is given none
  ADAM_TOML_TEXT_NAME: string = "<text>";
  // The most bytes tomlc17 takes in one parse (its length is a C int)
  ADAM_TOML_MAX_TEXT: int64 = 2147483647;
  // The bytes of toml_result_t's errmsg (tomlc17.h: char errmsg[200])
  ADAM_TOML_ERRMSG_SIZE: int64 = 200;

// The message tomlc17 left in AResult's ErrMsg (NUL-terminated in its array)
func DoErrText(const AResult: toml_result_t): string;
var
  LCount: int64;
  LText: string;
  LI: int64;
begin
  LCount := 0;
  while (LCount < int64(ADAM_TOML_ERRMSG_SIZE)) and (int32(AResult.errmsg[LCount]) <> 0) do
    LCount := LCount + 1;
  end;
  LText := "";
  if LCount = 0 then
    return LText;
  end;
  setlength(LText, LCount);
  for LI := 0 to LCount - 1 do
    LText[LI] := AResult.errmsg[LI];
  end;
  return LText;
end;

// The TOMLKind of tomlc17's kind AKind
func DoKindOf(const AKind: int32): TOMLKind;
begin
  if AKind = TOML_STRING then
    return TOMLKind.String;
  end;
  if AKind = TOML_INT64 then
    return TOMLKind.Integer;
  end;
  if AKind = TOML_FP64 then
    return TOMLKind.Float;
  end;
  if AKind = TOML_BOOLEAN then
    return TOMLKind.Boolean;
  end;
  if AKind = TOML_DATE then
    return TOMLKind.LocalDate;
  end;
  if AKind = TOML_TIME then
    return TOMLKind.LocalTime;
  end;
  if AKind = TOML_DATETIME then
    return TOMLKind.LocalDateTime;
  end;
  if AKind = TOML_DATETIMETZ then
    return TOMLKind.OffsetDateTime;
  end;
  if AKind = TOML_ARRAY then
    return TOMLKind.Array;
  end;
  if AKind = TOML_TABLE then
    return TOMLKind.Table;
  end;
  return TOMLKind.Missing;
end;

// tomlc17's kind AKind in words, for an error ("a string", "an integer", ...)
func DoKindText(const AKind: int32): string;
begin
  if AKind = TOML_STRING then
    return "a string";
  end;
  if AKind = TOML_INT64 then
    return "an integer";
  end;
  if AKind = TOML_FP64 then
    return "a float";
  end;
  if AKind = TOML_BOOLEAN then
    return "a boolean";
  end;
  if AKind = TOML_DATE then
    return "a local date";
  end;
  if AKind = TOML_TIME then
    return "a local time";
  end;
  if AKind = TOML_DATETIME then
    return "a local date-time";
  end;
  if AKind = TOML_DATETIMETZ then
    return "an offset date-time";
  end;
  if AKind = TOML_ARRAY then
    return ADAM_TOML_MSG_ARRAY;
  end;
  if AKind = TOML_TABLE then
    return ADAM_TOML_MSG_TABLE;
  end;
  return "an unknown value";
end;

// AText placed at AFile: "AFile(ALine,ACol): AText", "AFile(ALine): AText" when the column is
// not known (0), "AFile: AText" when the line is not either, AText alone with no file
func DoAt(const AFile: string; const ALine: int64; const ACol: int64; const AText: string): string;
begin
  if AFile = "" then
    return AText;
  end;
  if ALine <= 0 then
    return AFile + ": " + AText;
  end;
  if ACol <= 0 then
    return AFile + "(" + IntToStr(ALine) + "): " + AText;
  end;
  return AFile + "(" + IntToStr(ALine) + "," + IntToStr(ACol) + "): " + AText;
end;

// tomlc17's parse error AMessage placed at AFile: its "(line L, col C) " or "(line L) " lead
// becomes the place; a message of any other shape is placed at the file alone
func DoParseErrorText(const AFile: string; const AMessage: string): string;
var
  LComma: int64;
  LClose: int64;
  LLine: int64;
  LCol: int64;
begin
  LClose := IndexOf(") ", AMessage, 0);
  if (not StartsStr("(line ", AMessage)) or (LClose < 0) then
    return DoAt(AFile, 0, 0, AMessage);
  end;
  LCol := 0;
  LComma := IndexOf(", col ", AMessage, 0);
  if (LComma < 0) or (LComma > LClose) then
    // "(line L) message": the line alone
    LComma := LClose;
  else
    if not TryStrToInt(Substring(AMessage, LComma + 6, LClose - LComma - 6), LCol) then
      return DoAt(AFile, 0, 0, AMessage);
    end;
  end;
  if not TryStrToInt(Substring(AMessage, 6, LComma - 6), LLine) then
    return DoAt(AFile, 0, 0, AMessage);
  end;
  return DoAt(AFile, LLine, LCol, Substring(AMessage, LClose + 2, len(AMessage) - LClose - 2));
end;

// APath as an error names it: quoted, or "the document" for the empty path
func DoPathText(const APath: string): string;
begin
  if APath = "" then
    return ADAM_TOML_MSG_DOCUMENT;
  end;
  return "\"" + APath + "\"";
end;

// The error of a path that does not parse: APath and the byte AAt where it went wrong
func DoBadPath(const APath: string; const AAt: int64): string;
begin
  return ADAM_TOML_MSG_BAD_PATH + "\"" + APath + "\"" + ADAM_TOML_MSG_AT_BYTE + IntToStr(AAt);
end;

// True when AChar may stand in a bare key (A-Z a-z 0-9 _ -)
func DoIsBareChar(const AChar: char): bool;
begin
  if (AChar >= 'A') and (AChar <= 'Z') then
    return true;
  end;
  if (AChar >= 'a') and (AChar <= 'z') then
    return true;
  end;
  if (AChar >= '0') and (AChar <= '9') then
    return true;
  end;
  return (AChar = '_') or (AChar = '-');
end;

// The key at AAt in APath, bare or "quoted" (\" and \\ its only escapes), AAt moved past it;
// false when there is none there
func DoReadKey(const APath: string; var AAt: int64; var AKey: string): bool;
begin
  AKey := "";
  if AAt >= len(APath) then
    return false;
  end;
  if APath[AAt] <> '"' then
    while (AAt < len(APath)) and DoIsBareChar(APath[AAt]) do
      AKey := AKey + APath[AAt];
      AAt := AAt + 1;
    end;
    return AKey <> "";
  end;
  // A quoted key: up to its closing quote
  AAt := AAt + 1;
  while AAt < len(APath) do
    if APath[AAt] = '"' then
      AAt := AAt + 1;
      return true;
    end;
    if APath[AAt] = '\\' then
      AAt := AAt + 1;
      if AAt >= len(APath) then
        return false;
      end;
      if (APath[AAt] <> '"') and (APath[AAt] <> '\\') then
        return false;
      end;
    end;
    AKey := AKey + APath[AAt];
    AAt := AAt + 1;
  end;
  return false;
end;

// The index in "[N]" at AAt in APath (decimal digits only), AAt moved past its ']'; false
// when there is none there
func DoReadIndex(const APath: string; var AAt: int64; var AIndex: int64): bool;
var
  LStart: int64;
begin
  AIndex := 0;
  if (AAt >= len(APath)) or (APath[AAt] <> '[') then
    return false;
  end;
  AAt := AAt + 1;
  LStart := AAt;
  while (AAt < len(APath)) and (APath[AAt] >= '0') and (APath[AAt] <= '9') do
    AAt := AAt + 1;
  end;
  if (AAt = LStart) or (AAt >= len(APath)) or (APath[AAt] <> ']') then
    return false;
  end;
  if not TryStrToInt(Substring(APath, LStart, AAt - LStart), AIndex) then
    return false;
  end;
  AAt := AAt + 1;
  return true;
end;

// The index of the key AKey in the table ATable, -1 when it has none
func DoFindKey(const ATable: toml_datum_t; const AKey: string): int64;
var
  LI: int64;
  LJ: int64;
  LKey: ptr to const char;
  LSame: bool;
begin
  for LI := 0 to int64(ATable.u.tab.size) - 1 do
    if int64(ATable.u.tab.len[LI]) = len(AKey) then
      LKey := ATable.u.tab.key[LI];
      LSame := true;
      LJ := 0;
      while LSame and (LJ < len(AKey)) do
        LSame := LKey[LJ] = AKey[LJ];
        LJ := LJ + 1;
      end;
      if LSame then
        return LI;
      end;
    end;
  end;
  return -1;
end;

// One key step of a path walk: the key at AAt in APath looked up in ADatum (APrefix the path
// walked so far), ADatum its value; false with AError (ADatum unchanged: the error's place),
// ABadPath set when the error is the path's own (no key there)
func DoStepKey(const APath: string; const APrefix: string; var AAt: int64;
  var ADatum: toml_datum_t; var AError: string; var ABadPath: bool): bool;
var
  LKey: string;
  LIndex: int64;
begin
  if not DoReadKey(APath, AAt, LKey) then
    AError := DoBadPath(APath, AAt);
    ABadPath := true;
    return false;
  end;
  if ADatum.type_ <> TOML_TABLE then
    AError := DoPathText(APrefix) + ADAM_TOML_MSG_IS + DoKindText(ADatum.type_) + ADAM_TOML_MSG_NOT +
      ADAM_TOML_MSG_TABLE;
    return false;
  end;
  LIndex := DoFindKey(ADatum, LKey);
  if LIndex < 0 then
    AError := DoPathText(Substring(APath, 0, AAt)) + ADAM_TOML_MSG_NOT_FOUND;
    return false;
  end;
  ADatum := ADatum.u.tab.value[LIndex];
  return true;
end;

// One item step of a path walk: the "[N]" at AAt in APath taken from the array ADatum
// (APrefix the path walked so far), ADatum the item; false with AError (ADatum unchanged),
// ABadPath set when the error is the path's own (no "[N]" there)
func DoStepIndex(const APath: string; const APrefix: string; var AAt: int64;
  var ADatum: toml_datum_t; var AError: string; var ABadPath: bool): bool;
var
  LIndex: int64;
begin
  if not DoReadIndex(APath, AAt, LIndex) then
    AError := DoBadPath(APath, AAt);
    ABadPath := true;
    return false;
  end;
  if ADatum.type_ <> TOML_ARRAY then
    AError := DoPathText(APrefix) + ADAM_TOML_MSG_IS + DoKindText(ADatum.type_) + ADAM_TOML_MSG_NOT +
      ADAM_TOML_MSG_ARRAY;
    return false;
  end;
  if LIndex >= int64(ADatum.u.arr.size) then
    AError := DoPathText(Substring(APath, 0, AAt)) + ADAM_TOML_MSG_OUT_OF_RANGE +
      IntToStr(int64(ADatum.u.arr.size)) + ADAM_TOML_MSG_ITEMS;
    return false;
  end;
  ADatum := ADatum.u.arr.elem[LIndex];
  return true;
end;

// The value at APath under the table ARoot (the header's path form) in ADatum; false with
// AError and the place of the value the walk stopped at (ALine / ACol; 0 for an error of the
// path's own, which is the caller's and has no place in the document)
func DoSeek(const ARoot: toml_datum_t; const APath: string; var ADatum: toml_datum_t;
  var AError: string; var ALine: int64; var ACol: int64): bool;
var
  LAt: int64;
  LPrefix: string;
  LOk: bool;
  LBadPath: bool;
begin
  ADatum := ARoot;
  AError := "";
  LAt := 0;
  LOk := true;
  LBadPath := false;
  while LOk and (LAt < len(APath)) do
    LPrefix := Substring(APath, 0, LAt);
    if APath[LAt] = '[' then
      LOk := DoStepIndex(APath, LPrefix, LAt, ADatum, AError, LBadPath);
    else
      // A key: the first step, or one after a '.'
      if LAt > 0 then
        if APath[LAt] <> '.' then
          AError := DoBadPath(APath, LAt);
          LBadPath := true;
          LOk := false;
        else
          LAt := LAt + 1;
        end;
      end;
      if LOk then
        LOk := DoStepKey(APath, LPrefix, LAt, ADatum, AError, LBadPath);
      end;
    end;
  end;
  ALine := int64(ADatum.lineno);
  ACol := int64(ADatum.colno);
  if LBadPath then
    ALine := 0;
    ACol := 0;
  end;
  return LOk;
end;

// The date / time parts of the stamp ADatum (one of the four date / time kinds)
func DoDateTimeOf(const ADatum: toml_datum_t): TOMLDateTime;
var
  LValue: TOMLDateTime;
begin
  LValue.Kind := DoKindOf(ADatum.type_);
  LValue.Year := 0;
  LValue.Month := 0;
  LValue.Day := 0;
  LValue.Hour := 0;
  LValue.Minute := 0;
  LValue.Second := 0;
  LValue.Microsecond := 0;
  LValue.OffsetMinutes := 0;
  if ADatum.type_ <> TOML_TIME then
    LValue.Year := int32(ADatum.u.ts.year);
    LValue.Month := int32(ADatum.u.ts.month);
    LValue.Day := int32(ADatum.u.ts.day);
  end;
  if ADatum.type_ <> TOML_DATE then
    LValue.Hour := int32(ADatum.u.ts.hour);
    LValue.Minute := int32(ADatum.u.ts.minute);
    LValue.Second := int32(ADatum.u.ts.second);
    LValue.Microsecond := ADatum.u.ts.usec;
  end;
  if ADatum.type_ = TOML_DATETIMETZ then
    LValue.OffsetMinutes := int32(ADatum.u.ts.tz);
  end;
  return LValue;
end;

/// A key as one key of a path: bare when it can be, else quoted (`"` and `\` escaped).
/// @param AKey the key
/// @returns the path key
/// @example `LDoc.GetString("servers." + TOMLQuoteKey("eu.west") + ".host", LHost);`
public func cpplink TOMLQuoteKey(const AKey: string): string;
var
  LBare: bool;
  LText: string;
  LI: int64;
begin
  LBare := AKey <> "";
  for LI := 0 to len(AKey) - 1 do
    if not DoIsBareChar(AKey[LI]) then
      LBare := false;
    end;
  end;
  if LBare then
    return AKey;
  end;
  LText := "\"";
  for LI := 0 to len(AKey) - 1 do
    if (AKey[LI] = '"') or (AKey[LI] = '\\') then
      LText := LText + "\\";
    end;
    LText := LText + AKey[LI];
  end;
  return LText + "\"";
end;

// The upper-case hex digit of AValue (0..15), as a one-byte text
func DoHexDigit(const AValue: int32): string;
begin
  if AValue < 10 then
    return "" + char(uint8(48 + AValue));
  end;
  return "" + char(uint8(55 + AValue));
end;

// AChar as it is written inside a TOML basic string: '"' and '\' escaped, a control byte
// (below 0x20, and 0x7F) as TOML's \b \t \n \f \r or \u00XX, any other byte as it is
func DoTOMLStringChar(const AChar: char): string;
var
  LByte: int32;
begin
  LByte := int32(uint8(AChar));
  if (AChar = '"') or (AChar = '\\') then
    return "\\" + AChar;
  end;
  if LByte = 8 then
    return "\\b";
  end;
  if LByte = 9 then
    return "\\t";
  end;
  if LByte = 10 then
    return "\\n";
  end;
  if LByte = 12 then
    return "\\f";
  end;
  if LByte = 13 then
    return "\\r";
  end;
  if (LByte < 32) or (LByte = 127) then
    return "\\u00" + DoHexDigit(LByte div 16) + DoHexDigit(LByte mod 16);
  end;
  return "" + AChar;
end;

/// A text as a TOML basic string, to write into a .toml file: in double quotes, `"` and
/// `\` escaped, a control byte as `\b \t \n \f \r` or `\u00XX` (UTF-8 passes through).
/// @param AText the text
/// @returns the TOML string
/// @example `WriteLine(LFile, "name = " + TOMLQuoteString(LName));`
public func cpplink TOMLQuoteString(const AText: string): string;
var
  LText: string;
  LI: int64;
begin
  LText := "\"";
  for LI := 0 to len(AText) - 1 do
    LText := LText + DoTOMLStringChar(AText[LI]);
  end;
  return LText + "\"";
end;

public type
  /// A parsed TOML document: ParseText or ParseFile, then its values by path through the
  /// typed getters, each false with ErrorText on a failure. What tomlc17 hands back is freed by
  /// its done or its next parse; no getter result needs freeing.
  /// @example `if LDoc.ParseFile("game.toml") and LDoc.GetInt64("window.width", LWidth) then ... end;`
  TOMLDocument = object
    // tomlc17's result of the last parse, freed by Release when Held
    hidden Parsed: toml_result_t;
    hidden Held: bool;
    // The name errors are placed at: the file's path, or the name ParseText was given
    hidden SourceName: string;
    // The last failure in "file(line,col): message" form; "" after a success
    hidden LastError: string;

    /// A document with nothing parsed yet.
    init();
    begin
      self.Held := false;
      self.SourceName := "";
      self.LastError := "";
    end;

    /// Frees the last parse's result, if one is held (done and the next parse do it too).
    method Release();
    begin
      if self.Held then
        toml_free(self.Parsed);
        self.Held := false;
      end;
    end;

    /// Frees the last parse's result.
    done;
    begin
      self.Release();
    end;

    /// Records an error placed at a line and column of the document, as the getters do, for a
    /// caller that checks a value itself (Find, then its own rule).
    /// @param ALine the line (0: not known)
    /// @param ACol the column (0: not known)
    /// @param AText the message
    /// @returns false, always (what a failing getter returns)
    method Fail(const ALine: int64; const ACol: int64; const AText: string): bool;
    begin
      self.LastError := DoAt(self.SourceName, ALine, ACol, AText);
      return false;
    end;

    // The ACount bytes at AText parsed under SourceName; false with the parse error
    hidden method DoParse(const AText: ptr to const char; const ACount: int64): bool;
    begin
      if ACount > ADAM_TOML_MAX_TEXT then
        return self.Fail(0, 0, ADAM_TOML_MSG_TOO_LARGE);
      end;
      // tomlc17 keeps copies of what it needs: the name and the text are borrowed for the call
      self.Parsed := toml_parse_named(AText, int32(ACount), self.SourceName);
      self.Held := true;
      if not self.Parsed.ok then
        self.LastError := DoParseErrorText(self.SourceName, DoErrText(self.Parsed));
        return false;
      end;
      self.LastError := "";
      return true;
    end;

    /// Parses TOML text.
    /// @param AText the TOML text
    /// @param ASourceName the name errors are placed at ("" for `<text>`)
    /// @returns false with ErrorText when it is no valid TOML
    method ParseText(const AText: string; const ASourceName: string): bool;
    var
      LOk: bool;
    begin
      self.Release();
      self.SourceName := ASourceName;
      if ASourceName = "" then
        self.SourceName := ADAM_TOML_TEXT_NAME;
      end;
      LOk := self.DoParse(AText, len(AText));
      return LOk;
    end;

    /// Reads and parses a TOML file, its path naming it in errors.
    /// @param APath the file (relative to the working folder)
    /// @returns false with ErrorText when it cannot be read or is no valid TOML
    method ParseFile(const APath: string): bool;
    var
      LBytes: ptr;
      LCount: int64;
      LOk: bool;
    begin
      self.Release();
      self.SourceName := APath;
      LBytes := ReadFileBytes(APath, LCount);
      if LBytes = nil then
        return self.Fail(0, 0, ADAM_TOML_MSG_READ_FAILED);
      end;
      LOk := self.DoParse(ptr to const char(LBytes), LCount);
      freemem(LBytes);
      return LOk;
    end;

    /// The last failure, in `file(line,col): message` form.
    /// @returns the reason, or "" after a success
    const method ErrorText(): string;
    begin
      return self.LastError;
    end;

    /// Whether the last parse succeeded.
    /// @returns true when it did
    const method IsParsed(): bool;
    begin
      return self.Held and self.Parsed.ok;
    end;

    /// The raw tomlc17 value a path names, for a caller that reads it itself (its line and
    /// column, a kind no getter covers).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the top table)
    /// @param ADatum receives the value
    /// @returns false with ErrorText (at the value it is about) on a failure
    method Find(const APath: string; var ADatum: toml_datum_t): bool;
    var
      LError: string;
      LLine: int64;
      LCol: int64;
    begin
      if not self.IsParsed() then
        return self.Fail(0, 0, ADAM_TOML_MSG_NO_DOCUMENT);
      end;
      if not DoSeek(self.Parsed.toptab, APath, ADatum, LError, LLine, LCol) then
        return self.Fail(LLine, LCol, LError);
      end;
      self.LastError := "";
      return true;
    end;

    // The value ADatum (APath's) checked to be of tomlc17's kind AKind; false with the error
    // at the value when it is not (AWanted names what was wanted)
    hidden method Expect(const APath: string; const ADatum: toml_datum_t; const AKind: int32;
      const AWanted: string): bool;
    begin
      if ADatum.type_ = AKind then
        return true;
      end;
      return self.Fail(int64(ADatum.lineno), int64(ADatum.colno), DoPathText(APath) +
        ADAM_TOML_MSG_IS + DoKindText(ADatum.type_) + ADAM_TOML_MSG_NOT + AWanted);
    end;

    /// Whether a path names a value (no error recorded either way).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the top table)
    /// @returns true when it does
    const method Has(const APath: string): bool;
    var
      LDatum: toml_datum_t;
      LError: string;
      LLine: int64;
      LCol: int64;
    begin
      if not self.IsParsed() then
        return false;
      end;
      return DoSeek(self.Parsed.toptab, APath, LDatum, LError, LLine, LCol);
    end;

    /// The kind of the value a path names (no error recorded).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the top table)
    /// @returns the kind; Missing when it names none
    const method KindOf(const APath: string): TOMLKind;
    var
      LDatum: toml_datum_t;
      LError: string;
      LLine: int64;
      LCol: int64;
    begin
      if not self.IsParsed() then
        return TOMLKind.Missing;
      end;
      if not DoSeek(self.Parsed.toptab, APath, LDatum, LError, LLine, LCol) then
        return TOMLKind.Missing;
      end;
      return DoKindOf(LDatum.type_);
    end;

    /// Reads the string a path names.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the top table)
    /// @param AValue receives the string
    /// @returns false with ErrorText (at the value it is about) on a failure
    method GetString(const APath: string; var AValue: string): bool;
    var
      LDatum: toml_datum_t;
    begin
      if not self.Find(APath, LDatum) then
        return false;
      end;
      if not self.Expect(APath, LDatum, TOML_STRING, DoKindText(TOML_STRING)) then
        return false;
      end;
      AValue := StringFromC(LDatum.u.str.ptr_, int64(LDatum.u.str.len));
      return true;
    end;

    /// Reads the integer a path names.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the top table)
    /// @param AValue receives the integer
    /// @returns false with ErrorText (at the value it is about) on a failure
    method GetInt64(const APath: string; var AValue: int64): bool;
    var
      LDatum: toml_datum_t;
    begin
      if not self.Find(APath, LDatum) then
        return false;
      end;
      if not self.Expect(APath, LDatum, TOML_INT64, DoKindText(TOML_INT64)) then
        return false;
      end;
      AValue := LDatum.u.int64_;
      return true;
    end;

    /// Reads the float a path names (an integer is not taken: TOML keeps the two apart).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the top table)
    /// @param AValue receives the float
    /// @returns false with ErrorText (at the value it is about) on a failure
    method GetFloat64(const APath: string; var AValue: float64): bool;
    var
      LDatum: toml_datum_t;
    begin
      if not self.Find(APath, LDatum) then
        return false;
      end;
      if not self.Expect(APath, LDatum, TOML_FP64, DoKindText(TOML_FP64)) then
        return false;
      end;
      AValue := LDatum.u.fp64;
      return true;
    end;

    /// Reads the boolean a path names.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the top table)
    /// @param AValue receives the boolean
    /// @returns false with ErrorText (at the value it is about) on a failure
    method GetBool(const APath: string; var AValue: bool): bool;
    var
      LDatum: toml_datum_t;
    begin
      if not self.Find(APath, LDatum) then
        return false;
      end;
      if not self.Expect(APath, LDatum, TOML_BOOLEAN, DoKindText(TOML_BOOLEAN)) then
        return false;
      end;
      AValue := LDatum.u.boolean;
      return true;
    end;

    /// Reads the date / time a path names (any of the four kinds).
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the top table)
    /// @param AValue receives its parts
    /// @returns false with ErrorText (at the value it is about) on a failure
    method GetDateTime(const APath: string; var AValue: TOMLDateTime): bool;
    var
      LDatum: toml_datum_t;
    begin
      if not self.Find(APath, LDatum) then
        return false;
      end;
      if (LDatum.type_ < TOML_DATE) or (LDatum.type_ > TOML_DATETIMETZ) then
        return self.Expect(APath, LDatum, TOML_DATE, ADAM_TOML_MSG_STAMP);
      end;
      AValue := DoDateTimeOf(LDatum);
      return true;
    end;

    /// How many items the array, or keys the table, a path names holds.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the top table)
    /// @param ACount receives the count
    /// @returns false with ErrorText (at the value it is about) on a failure
    method Count(const APath: string; var ACount: int64): bool;
    var
      LDatum: toml_datum_t;
    begin
      if not self.Find(APath, LDatum) then
        return false;
      end;
      if LDatum.type_ = TOML_ARRAY then
        ACount := int64(LDatum.u.arr.size);
        return true;
      end;
      if not self.Expect(APath, LDatum, TOML_TABLE, ADAM_TOML_MSG_LIST) then
        return false;
      end;
      ACount := int64(LDatum.u.tab.size);
      return true;
    end;

    /// One key of the table a path names, in the document's order; its value is at
    /// `APath + "." + TOMLQuoteKey(AKey)`.
    /// @param APath the path (keys joined by `.`, an item as `[N]`; "" the top table)
    /// @param AIndex the key's place (0-based)
    /// @param AKey receives the key
    /// @returns false with ErrorText (at the value it is about) on a failure
    method KeyAt(const APath: string; const AIndex: int64; var AKey: string): bool;
    var
      LDatum: toml_datum_t;
    begin
      if not self.Find(APath, LDatum) then
        return false;
      end;
      if not self.Expect(APath, LDatum, TOML_TABLE, ADAM_TOML_MSG_TABLE) then
        return false;
      end;
      if (AIndex < 0) or (AIndex >= int64(LDatum.u.tab.size)) then
        return self.Fail(int64(LDatum.lineno), int64(LDatum.colno), DoPathText(APath) +
          ADAM_TOML_MSG_NO_KEY + IntToStr(AIndex) + " (" + IntToStr(int64(LDatum.u.tab.size)) +
          ADAM_TOML_MSG_KEYS);
      end;
      AKey := StringFromC(LDatum.u.tab.key[AIndex], int64(LDatum.u.tab.len[AIndex]));
      return true;
    end;
  end;

end.
