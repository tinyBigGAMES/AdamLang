-------------------------------------------------------------------------------
  System.Hash.adam - message digests: MD5 (RFC 1321), SHA-1 (FIPS 180-4)
  and SHA-256 (FIPS 180-4), written in Adam.

  A Hasher takes its input in pieces (Update, as often as it comes: a file
  read in blocks, a stream) and gives the digest at Final; ComputeHash is
  the one-call form for bytes or text already in hand. A digest is its raw
  bytes (16 / 20 / 32); DigestToHex writes it the way tools print it.
  MD5 and SHA-1 are broken for security (collisions are made at will): use
  them to check data against a known digest or to key a cache, SHA-256 for
  anything an attacker could choose. CRC-32 is System.Zlib.Ext's ZlibCRC32.

  Target-neutral (PROJECT AT.3): pure Adam over no OS and no C library, so
  every target gives the same digest for the same bytes.
*******************************************************************************/

module unit System.Hash;

import System.SysUtils;

public type
  /// The digest a `Hasher` (or `ComputeHash`) makes.
  /// - `MD5`: 16 bytes (RFC 1321): file checks and cache keys only, never security.
  /// - `SHA1`: 20 bytes (FIPS 180-4): the same caution as MD5 (git's object names use it).
  /// - `SHA256`: 32 bytes (FIPS 180-4): the one to pick when in doubt.
  HashKind = choices(MD5, SHA1, SHA256);

const
  // Every kind works on 64-byte blocks, the last one padded with its bit length in 8 bytes
  ADAM_HASH_BLOCK_SIZE: int64 = 64;
  ADAM_HASH_LENGTH_AT: int64 = 56;
  // MD5's round constants: floor(abs(sin(i + 1)) * 2^32) (RFC 1321 sec 3.4)
  ADAM_HASH_MD5_K: array[0..63] of uint32 = [
    0xD76AA478, 0xE8C7B756, 0x242070DB, 0xC1BDCEEE, 0xF57C0FAF, 0x4787C62A,
    0xA8304613, 0xFD469501, 0x698098D8, 0x8B44F7AF, 0xFFFF5BB1, 0x895CD7BE,
    0x6B901122, 0xFD987193, 0xA679438E, 0x49B40821, 0xF61E2562, 0xC040B340,
    0x265E5A51, 0xE9B6C7AA, 0xD62F105D, 0x02441453, 0xD8A1E681, 0xE7D3FBC8,
    0x21E1CDE6, 0xC33707D6, 0xF4D50D87, 0x455A14ED, 0xA9E3E905, 0xFCEFA3F8,
    0x676F02D9, 0x8D2A4C8A, 0xFFFA3942, 0x8771F681, 0x6D9D6122, 0xFDE5380C,
    0xA4BEEA44, 0x4BDECFA9, 0xF6BB4B60, 0xBEBFBC70, 0x289B7EC6, 0xEAA127FA,
    0xD4EF3085, 0x04881D05, 0xD9D4D039, 0xE6DB99E5, 0x1FA27CF8, 0xC4AC5665,
    0xF4292244, 0x432AFF97, 0xAB9423A7, 0xFC93A039, 0x655B59C3, 0x8F0CCC92,
    0xFFEFF47D, 0x85845DD1, 0x6FA87E4F, 0xFE2CE6E0, 0xA3014314, 0x4E0811A1,
    0xF7537E82, 0xBD3AF235, 0x2AD7D2BB, 0xEB86D391
  ];
  // MD5's left rotations, four per round, by round (RFC 1321 sec 3.4)
  ADAM_HASH_MD5_SHIFT: array[0..15] of uint32 = [
    7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21
  ];
  // SHA-256's round constants: the first 32 bits of the fractional parts of the cube roots of
  // the first 64 primes (FIPS 180-4 sec 4.2.2)
  ADAM_HASH_SHA256_K: array[0..63] of uint32 = [
    0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5, 0x3956C25B, 0x59F111F1,
    0x923F82A4, 0xAB1C5ED5, 0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
    0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174, 0xE49B69C1, 0xEFBE4786,
    0x0FC19DC6, 0x240CA1CC, 0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
    0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7, 0xC6E00BF3, 0xD5A79147,
    0x06CA6351, 0x14292967, 0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
    0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85, 0xA2BFE8A1, 0xA81A664B,
    0xC24B8B70, 0xC76C51A3, 0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
    0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5, 0x391C0CB3, 0x4ED8AA4A,
    0x5B9CCA4F, 0x682E6FF3, 0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
    0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2
  ];
  // SHA-256's start state: the fractional parts of the square roots of the first 8 primes
  // (FIPS 180-4 sec 5.3.3)
  ADAM_HASH_SHA256_H: array[0..7] of uint32 = [
    0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19
  ];
  // SHA-1's round constants, one per 20 rounds (FIPS 180-4 sec 4.2.1)
  ADAM_HASH_SHA1_K: array[0..3] of uint32 = [0x5A827999, 0x6ED9EBA1, 0x8F1BBCDC, 0xCA62C1D6];
  // The digits DigestToHex writes (lowercase: how md5sum / sha256sum print a digest)
  ADAM_HASH_HEX_DIGITS: string = "0123456789abcdef";

// AValue rotated left by ACount bits (0 < ACount < 32)
func DoRotl(const AValue: uint32; const ACount: uint32): uint32;
begin
  return (AValue shl ACount) | (AValue shr (uint32(32) - ACount));
end;

// AValue rotated right by ACount bits (0 < ACount < 32)
func DoRotr(const AValue: uint32; const ACount: uint32): uint32;
begin
  return (AValue shr ACount) | (AValue shl (uint32(32) - ACount));
end;

public type
  /// A digest made from input given in pieces: make one for a kind, `Update` it with each
  /// piece in order, then `Final` gives the digest and makes it fresh again, ready for the
  /// next input. Pieces may be any size (one byte, a whole file); the digest is that of all
  /// of them joined. A copy carries its progress: two copies go on apart.
  /// @example `LHash := Hasher(HashKind.SHA256); LHash.Update("abc"); println(DigestToHex(LHash.Final()));`
  Hasher = object
    // The digest it makes
    hidden Algorithm: HashKind;
    // The chaining state: MD5 4 words, SHA-1 5, SHA-256 8
    hidden State: array[0..7] of uint32;
    // The block being filled
    hidden Block: array[0..63] of uint8;
    // The bytes of Block filled so far (below ADAM_HASH_BLOCK_SIZE between calls)
    hidden Filled: int64;
    // The bytes taken since the start (the padding's length field counts them in bits)
    hidden Total: uint64;

    // The full Block through MD5's compression (RFC 1321 sec 3.4): words little-endian
    hidden method DoMD5();
    var
      LWords: array[0..15] of uint32;
      LA: uint32;
      LB: uint32;
      LC: uint32;
      LD: uint32;
      LF: uint32;
      LNext: uint32;
      LWord: int64;
      LI: int64;
    begin
      for LI := 0 to 15 do
        LWords[LI] := uint32(self.Block[LI * 4]) | (uint32(self.Block[LI * 4 + 1]) shl 8) |
          (uint32(self.Block[LI * 4 + 2]) shl 16) | (uint32(self.Block[LI * 4 + 3]) shl 24);
      end;
      LA := self.State[0];
      LB := self.State[1];
      LC := self.State[2];
      LD := self.State[3];
      for LI := 0 to 63 do
        // Each round of 16 steps has its own mixing function and word order
        match LI of
          0..15:
            LF := (LB & LC) | (~LB & LD);
            LWord := LI;
          16..31:
            LF := (LD & LB) | (~LD & LC);
            LWord := (5 * LI + 1) mod 16;
          32..47:
            LF := LB xor LC xor LD;
            LWord := (3 * LI + 5) mod 16;
        else
          LF := LC xor (LB | ~LD);
          LWord := (7 * LI) mod 16;
        end;
        LNext := LD;
        LD := LC;
        LC := LB;
        LB := LB + DoRotl(LA + LF + ADAM_HASH_MD5_K[LI] + LWords[LWord],
          ADAM_HASH_MD5_SHIFT[(LI div 16) * 4 + LI mod 4]);
        LA := LNext;
      end;
      self.State[0] := self.State[0] + LA;
      self.State[1] := self.State[1] + LB;
      self.State[2] := self.State[2] + LC;
      self.State[3] := self.State[3] + LD;
    end;

    // The full Block through SHA-1's compression (FIPS 180-4 sec 6.1.2): words big-endian
    hidden method DoSHA1();
    var
      LWords: array[0..79] of uint32;
      LA: uint32;
      LB: uint32;
      LC: uint32;
      LD: uint32;
      LE: uint32;
      LF: uint32;
      LNext: uint32;
      LI: int64;
    begin
      for LI := 0 to 15 do
        LWords[LI] := (uint32(self.Block[LI * 4]) shl 24) | (uint32(self.Block[LI * 4 + 1]) shl 16) |
          (uint32(self.Block[LI * 4 + 2]) shl 8) | uint32(self.Block[LI * 4 + 3]);
      end;
      // The message schedule: each later word the rotated mix of four before it
      for LI := 16 to 79 do
        LWords[LI] := DoRotl(LWords[LI - 3] xor LWords[LI - 8] xor LWords[LI - 14] xor
          LWords[LI - 16], 1);
      end;
      LA := self.State[0];
      LB := self.State[1];
      LC := self.State[2];
      LD := self.State[3];
      LE := self.State[4];
      for LI := 0 to 79 do
        // Ch, Parity, Maj, Parity: one per 20 rounds
        match LI div 20 of
          0:
            LF := (LB & LC) | (~LB & LD);
          2:
            LF := (LB & LC) | (LB & LD) | (LC & LD);
        else
          LF := LB xor LC xor LD;
        end;
        LNext := DoRotl(LA, 5) + LF + LE + ADAM_HASH_SHA1_K[LI div 20] + LWords[LI];
        LE := LD;
        LD := LC;
        LC := DoRotl(LB, 30);
        LB := LA;
        LA := LNext;
      end;
      self.State[0] := self.State[0] + LA;
      self.State[1] := self.State[1] + LB;
      self.State[2] := self.State[2] + LC;
      self.State[3] := self.State[3] + LD;
      self.State[4] := self.State[4] + LE;
    end;

    // The full Block through SHA-256's compression (FIPS 180-4 sec 6.2.2): words big-endian
    hidden method DoSHA256();
    var
      LWords: array[0..63] of uint32;
      LWork: array[0..7] of uint32;
      LSmall0: uint32;
      LSmall1: uint32;
      LFirst: uint32;
      LSecond: uint32;
      LI: int64;
      LK: int64;
    begin
      for LI := 0 to 15 do
        LWords[LI] := (uint32(self.Block[LI * 4]) shl 24) | (uint32(self.Block[LI * 4 + 1]) shl 16) |
          (uint32(self.Block[LI * 4 + 2]) shl 8) | uint32(self.Block[LI * 4 + 3]);
      end;
      // The message schedule: sigma0 / sigma1 of earlier words (FIPS 180-4 sec 4.1.2)
      for LI := 16 to 63 do
        LSmall0 := DoRotr(LWords[LI - 15], 7) xor DoRotr(LWords[LI - 15], 18) xor
          (LWords[LI - 15] shr 3);
        LSmall1 := DoRotr(LWords[LI - 2], 17) xor DoRotr(LWords[LI - 2], 19) xor
          (LWords[LI - 2] shr 10);
        LWords[LI] := LWords[LI - 16] + LSmall0 + LWords[LI - 7] + LSmall1;
      end;
      // LWork holds a .. h in order
      for LK := 0 to 7 do
        LWork[LK] := self.State[LK];
      end;
      for LI := 0 to 63 do
        // T1 = h + Sigma1(e) + Ch(e, f, g) + K + W; T2 = Sigma0(a) + Maj(a, b, c)
        LFirst := LWork[7] + (DoRotr(LWork[4], 6) xor DoRotr(LWork[4], 11) xor
          DoRotr(LWork[4], 25)) + ((LWork[4] & LWork[5]) xor (~LWork[4] & LWork[6])) +
          ADAM_HASH_SHA256_K[LI] + LWords[LI];
        LSecond := (DoRotr(LWork[0], 2) xor DoRotr(LWork[0], 13) xor DoRotr(LWork[0], 22)) +
          ((LWork[0] & LWork[1]) xor (LWork[0] & LWork[2]) xor (LWork[1] & LWork[2]));
        for LK := 7 downto 1 do
          LWork[LK] := LWork[LK - 1];
        end;
        LWork[4] := LWork[4] + LFirst;
        LWork[0] := LFirst + LSecond;
      end;
      for LK := 0 to 7 do
        self.State[LK] := self.State[LK] + LWork[LK];
      end;
    end;

    // The full Block through this kind's compression
    hidden method DoCompress();
    begin
      match self.Algorithm of
        HashKind.MD5:
          self.DoMD5();
        HashKind.SHA1:
          self.DoSHA1();
      else
        self.DoSHA256();
      end;
    end;

    // ACount bytes at AData added to the input, every block filled compressed at once
    hidden method DoTake(const AData: ptr to const uint8; const ACount: int64);
    var
      LI: int64;
    begin
      for LI := 0 to ACount - 1 do
        self.Block[self.Filled] := AData[LI];
        self.Filled := self.Filled + 1;
        if self.Filled = ADAM_HASH_BLOCK_SIZE then
          self.DoCompress();
          self.Filled := 0;
        end;
      end;
      self.Total := self.Total + uint64(ACount);
    end;

    // One zero or padding byte into the block, compressed when it fills (Final's padding:
    // never counted in Total)
    hidden method DoPad(const AByte: uint8);
    begin
      self.Block[self.Filled] := AByte;
      self.Filled := self.Filled + 1;
      if self.Filled = ADAM_HASH_BLOCK_SIZE then
        self.DoCompress();
        self.Filled := 0;
      end;
    end;

    /// Starts over: no input taken, the kind kept.
    method Reset();
    var
      LK: int64;
    begin
      for LK := 0 to 7 do
        self.State[LK] := 0;
      end;
      match self.Algorithm of
        HashKind.MD5, HashKind.SHA1:
          self.State[0] := 0x67452301;
          self.State[1] := 0xEFCDAB89;
          self.State[2] := 0x98BADCFE;
          self.State[3] := 0x10325476;
          if self.Algorithm = HashKind.SHA1 then
            self.State[4] := 0xC3D2E1F0;
          end;
      else
        for LK := 0 to 7 do
          self.State[LK] := ADAM_HASH_SHA256_H[LK];
        end;
      end;
      self.Filled := 0;
      self.Total := 0;
    end;

    /// A SHA-256 hasher with no input yet (`Hasher(HashKind.SHA256)`).
    init();
    begin
      self.Algorithm := HashKind.SHA256;
      self.Reset();
    end;

    /// A hasher for `AKind` with no input yet.
    /// @param AKind the digest to make
    init(const AKind: HashKind);
    begin
      self.Algorithm := AKind;
      self.Reset();
    end;

    /// The digest this hasher makes.
    /// @returns its kind
    const method Kind(): HashKind;
    begin
      return self.Algorithm;
    end;

    /// The bytes of `ABytes` added to the input.
    /// @param ABytes the next piece (empty adds nothing)
    method Update(const ABytes: ByteArray);
    begin
      if len(ABytes) > 0 then
        self.DoTake(addr of ABytes[0], len(ABytes));
      end;
    end;

    /// The UTF-8 bytes of `AText` added to the input (no terminating zero).
    /// @param AText the next piece ("" adds nothing)
    method Update(const AText: string);
    begin
      if len(AText) > 0 then
        self.DoTake(ptr to const uint8(addr of AText[0]), len(AText));
      end;
    end;

    /// `ACount` bytes of memory at `AData` added to the input: a buffer a C library or a
    /// file read filled.
    /// @param AData the first byte (nil only with `ACount` 0)
    /// @param ACount how many bytes (0 or below adds nothing)
    method Update(const AData: ptr to const; const ACount: int64);
    begin
      if ACount > 0 then
        self.DoTake(ptr to const uint8(AData), ACount);
      end;
    end;

    /// The digest of all the input so far; the hasher then starts over (same kind).
    /// @returns the digest's bytes: 16 for MD5, 20 for SHA-1, 32 for SHA-256
    method Final(): ByteArray;
    var
      LBits: uint64;
      LDigest: ByteArray;
      LWords: int64;
      LI: int64;
    begin
      LBits := self.Total * 8;
      // 0x80, zeros up to the length field, then the bit length in 8 bytes (MD5 little-endian,
      // SHA big-endian): the length field always ends a block
      self.DoPad(0x80);
      while self.Filled <> ADAM_HASH_LENGTH_AT do
        self.DoPad(0);
      end;
      for LI := 0 to 7 do
        if self.Algorithm = HashKind.MD5 then
          self.DoPad(uint8((LBits shr uint64(8 * LI)) & 0xFF));
        else
          self.DoPad(uint8((LBits shr uint64(8 * (7 - LI))) & 0xFF));
        end;
      end;
      match self.Algorithm of
        HashKind.MD5:
          LWords := 4;
        HashKind.SHA1:
          LWords := 5;
      else
        LWords := 8;
      end;
      setlength(LDigest, LWords * 4);
      for LI := 0 to LWords * 4 - 1 do
        if self.Algorithm = HashKind.MD5 then
          LDigest[LI] := uint8((self.State[LI div 4] shr uint32(8 * (LI mod 4))) & 0xFF);
        else
          LDigest[LI] := uint8((self.State[LI div 4] shr uint32(8 * (3 - LI mod 4))) & 0xFF);
        end;
      end;
      self.Reset();
      return LDigest;
    end;
  end;

/// The `AKind` digest of `ABytes` in one call (a `Hasher` given them all at once).
/// @param AKind the digest to make
/// @param ABytes the input
/// @returns the digest's bytes
/// @example `LDigest := ComputeHash(HashKind.MD5, LBytes);`
public func cpplink ComputeHash(const AKind: HashKind; const ABytes: ByteArray): ByteArray;
var
  LHasher: Hasher;
begin
  LHasher := Hasher(AKind);
  LHasher.Update(ABytes);
  return LHasher.Final();
end;

/// The `AKind` digest of the UTF-8 bytes of `AText` in one call.
/// @param AKind the digest to make
/// @param AText the input
/// @returns the digest's bytes
/// @example `println(DigestToHex(ComputeHash(HashKind.SHA256, "abc")));`
public func cpplink ComputeHash(const AKind: HashKind; const AText: string): ByteArray;
var
  LHasher: Hasher;
begin
  LHasher := Hasher(AKind);
  LHasher.Update(AText);
  return LHasher.Final();
end;

/// A digest written as lowercase hex, two digits a byte, as md5sum / sha256sum print it.
/// @param ADigest the digest's bytes (any bytes: an empty array gives "")
/// @returns the hex text
/// @example `DigestToHex(ComputeHash(HashKind.MD5, ""))` is `"d41d8cd98f00b204e9800998ecf8427e"`
public func cpplink DigestToHex(const ADigest: ByteArray): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  setlength(LText, len(ADigest) * 2);
  for LI := 0 to len(ADigest) - 1 do
    LText[LI * 2] := ADAM_HASH_HEX_DIGITS[int64(ADigest[LI] shr 4)];
    LText[LI * 2 + 1] := ADAM_HASH_HEX_DIGITS[int64(ADigest[LI] & 0x0F)];
  end;
  return LText;
end;

end.
