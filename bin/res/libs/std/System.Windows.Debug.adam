public func clink SymCleanup(AProcess: uint64): int32; external "dbghelp";
func clink LocalFree(AMemory: ptr): ptr; external "kernel32";
func clink FormatMessageW(AFlags: uint32; ASource: ptr; AMessageId: uint32; ALanguageId: uint32;
  var ABuffer: WideBuffer; ASize: uint32; AArguments: ptr): uint32; external "kernel32";

/// The system's own message for the Win32 error ACode, its line end and a final '.' cut
/// ("Windows error N" when the system has none)
/// @param ACode the Win32 error code
/// @returns the message
public func WinErrorText(const ACode: uint32): string;
var
  LBox: own WideBox;
  LCount: uint32;
  LText: string;
begin
  LBox := own WideBox();
  LCount := FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM |
    FORMAT_MESSAGE_IGNORE_INSERTS, nil, ACode, 0, LBox.Data,
    ADAM_WINDOWS_DEBUG_TEXT_MAX, nil);
  if LCount = 0 then
    return "Windows error " + UIntToStr(uint64(ACode));
  end;
  LText := Trim(WideToUTF8(LBox.Data, int32(LCount)));
  if EndsStr(".", LText) then
    LText := Substring(LText, 0, len(LText) - 1);
  end;
  return LText;
end;

/// WinErrorText of the calling thread's last error
/// @returns the message
public func WinLastErrorText(): string;
begin
  return WinErrorText(GetLastError());
end;

/// The UTF-16 text AText points to, up to its 0 (at most ADAM_WINDOWS_DEBUG_TEXT_MAX units),
/// as a string; nil gives ""
/// @param AText the UTF-16 text, or nil
/// @returns the text, or ""
public func DbgWideText(const AText: ptr to const uint16): string;
var
  LBox: own WideBox;
  LCount: int64;
begin
  if AText = nil then
    return "";
  end;
  LBox := own WideBox();
  LCount := 0;
  while (LCount < int64(ADAM_WINDOWS_DEBUG_TEXT_MAX)) and (AText[LCount] <> 0) do
    LBox.Data[LCount] := AText[LCount];
    LCount := LCount + 1;
  end;
  return WideToUTF8(LBox.Data, int32(LCount));
end;

/// ASymbol's name (NameLen units, never past the room it has) as a string
/// @param ASymbol the symbol
/// @returns its name
public func DbgSymbolName(const ASymbol: DebugSymbolInfo): string;
var
  LBox: own WideBox;
  LCount: int64;
  LIndex: int64;
begin
  LCount := int64(ASymbol.NameLen);
  if LCount > int64(MAX_SYM_NAME) then
    LCount := int64(MAX_SYM_NAME);
  end;
  LBox := own WideBox();
  for LIndex := 0 to LCount - 1 do
    LBox.Data[LIndex] := ASymbol.Name[LIndex];
  end;
  return WideToUTF8(LBox.Data, int32(LCount));
end;

/// The name of type ATypeId in the module at ABase (TI_GET_SYMNAME, its text freed); "" when
/// the type has none
/// @param AProcess the process DbgHelp works on
/// @param ABase the module's base
/// @param ATypeId the type
/// @returns its name, or ""
public func SymTypeName(const AProcess: uint64; const ABase: uint64;
  const ATypeId: uint32): string;
var
  LText: ptr to uint16;
  LName: string;
begin
  LText := nil;
  if SymGetTypeInfo(AProcess, ABase, ATypeId, TI_GET_SYMNAME,
    ptr(addr of LText)) = 0 then
    return "";
  end;
  LName := DbgWideText(LText);
  LocalFree(ptr(LText));
  return LName;
end;

end.
