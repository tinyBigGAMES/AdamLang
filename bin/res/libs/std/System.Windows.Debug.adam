-------------------------------------------------------------------------------
  System.Windows.Debug.adam - the Win32 debugging API, declared for Adam
  (x86_64-windows-gnu only)

  The kernel32 calls a debugger makes (CreateProcessW under
  DEBUG_ONLY_THIS_PROCESS, WaitForDebugEvent / ContinueDebugEvent, the
  thread context, the debuggee's memory, its threads, a pipe for its output)
  and the records they read and write, laid out as Win64 lays them out:
  DEBUG_EVENT (DEBUG_EVENT, 176 bytes, its union an inline overlay),
  CONTEXT (the x64 CONTEXT, 1232 bytes, which the API needs 16-byte
  aligned: a caller points it into a buffer it aligned itself). Handles and
  addresses in the debuggee are uint64. WinErrorText is the system's own
  message for an error code, for a report.

  DbgHelp (dbghelp.dll, shipped with Windows) reads a program's PDB: a
  module loaded at a base (SymLoadModuleExW), a symbol by name or address
  (SymFromNameW / SymFromAddrW: DebugSymbolInfo, SYMBOL_INFOW with room for
  its name), a source line by address or file and line
  (SymGetLineFromAddrW64 / SymGetLineFromNameW64: IMAGEHLP_LINEW64,
  IMAGEHLP_LINEW64), the parameters and locals of a routine
  (SymSetScopeFromAddr, then SymEnumSymbolsW), a module's symbols of one
  kind, nested ones too (SymSearchW: a routine's labels), a type's facts
  (SymGetTypeInfo), the source files it names (SymEnumSourceFilesW), the
  lines after one (SymGetLineNextW64), a thread's frames (StackWalk64:
  STACKFRAME64, the debuggee's memory read by the caller's own
  routine). The console the debugger runs in: whether a standard handle is
  one (GetConsoleMode), its Ctrl+C / Ctrl+Break taken by a handler
  (SetConsoleCtrlHandler; the program in a process group of its own does
  not get them). Its text in is UTF-16 (a ptr to const uint16, nil
  where DbgHelp allows NULL); DbgWideText, DbgSymbolName and SymTypeName
  turn its text out into a string.

  Adam's debugger reaches Windows only through this unit (its Win64 parts,
  Adam.Debug.*.Win64); nothing above those parts imports it. A linux64
  debugger adds its own unit over ptrace beside it.
*******************************************************************************/

module unit System.Windows.Debug;

import System.SysUtils, System.Windows.SDK, System.Windows;

public const
  /// Windows' `DEBUG_ONLY_THIS_PROCESS`: CreateProcessW's flags: the new process is debugged by this one (not its children)
  DEBUG_ONLY_THIS_PROCESS: uint32 = 0x2;
  /// Windows' `CREATE_NEW_PROCESS_GROUP`: ... in a process group of its own: the console's Ctrl+C is not its (the debugger's, D4)
  CREATE_NEW_PROCESS_GROUP: uint32 = 0x200;

  /// Windows' `EXCEPTION_DEBUG_EVENT`: DEBUG_EVENT's dwDebugEventCode
  EXCEPTION_DEBUG_EVENT: uint32 = 1;
  /// Windows' `CREATE_THREAD_DEBUG_EVENT`: DEBUG_EVENT's dwDebugEventCode
  CREATE_THREAD_DEBUG_EVENT: uint32 = 2;
  /// Windows' `CREATE_PROCESS_DEBUG_EVENT`: DEBUG_EVENT's dwDebugEventCode
  CREATE_PROCESS_DEBUG_EVENT: uint32 = 3;
  /// Windows' `EXIT_THREAD_DEBUG_EVENT`: DEBUG_EVENT's dwDebugEventCode
  EXIT_THREAD_DEBUG_EVENT: uint32 = 4;
  /// Windows' `EXIT_PROCESS_DEBUG_EVENT`: DEBUG_EVENT's dwDebugEventCode
  EXIT_PROCESS_DEBUG_EVENT: uint32 = 5;
  /// Windows' `LOAD_DLL_DEBUG_EVENT`: DEBUG_EVENT's dwDebugEventCode
  LOAD_DLL_DEBUG_EVENT: uint32 = 6;
  /// Windows' `UNLOAD_DLL_DEBUG_EVENT`: DEBUG_EVENT's dwDebugEventCode
  UNLOAD_DLL_DEBUG_EVENT: uint32 = 7;
  /// Windows' `OUTPUT_DEBUG_STRING_EVENT`: DEBUG_EVENT's dwDebugEventCode
  OUTPUT_DEBUG_STRING_EVENT: uint32 = 8;
  /// Windows' `RIP_EVENT`: DEBUG_EVENT's dwDebugEventCode
  RIP_EVENT: uint32 = 9;

  /// Windows' `DBG_CONTINUE`: ContinueDebugEvent's status: the event is handled / an exception goes to the program
  DBG_CONTINUE: uint32 = 0x00010002;
  /// Windows' `DBG_EXCEPTION_NOT_HANDLED`: ContinueDebugEvent's status: the event is handled / an exception goes to the program
  DBG_EXCEPTION_NOT_HANDLED: uint32 = 0x80010001;

  /// Windows' `EXCEPTION_BREAKPOINT`: EXCEPTION_RECORD's ExceptionCode: an int3, a trap-flag step
  EXCEPTION_BREAKPOINT: uint32 = 0x80000003;
  /// Windows' `EXCEPTION_SINGLE_STEP`: EXCEPTION_RECORD's ExceptionCode: an int3, a trap-flag step
  EXCEPTION_SINGLE_STEP: uint32 = 0x80000004;

  /// Windows' `CONTEXT_ALL`: CONTEXT's ContextFlags: CONTEXT_ALL for AMD64 (control, integer, segments, floating
  /// point, debug registers)
  CONTEXT_ALL: uint32 = 0x0010001F;
  /// The trap flag in EFlags: one instruction, then a single-step exception
  ADAM_WINDOWS_TRAP_FLAG: uint32 = 0x100;
  /// The bytes of a CONTEXT and the alignment GetThreadContext / SetThreadContext need
  ADAM_WINDOWS_CONTEXT_SIZE: int64 = 1232;
  /// The alignment GetThreadContext / SetThreadContext need for a CONTEXT.
  ADAM_WINDOWS_CONTEXT_ALIGN: int64 = 16;

  /// Windows' `PAGE_EXECUTE_READWRITE`: VirtualProtectEx's protection for a code byte the debugger writes
  PAGE_EXECUTE_READWRITE: uint32 = 0x40;
  /// Windows' `ERROR_SEM_TIMEOUT`: WaitForDebugEvent's error when no event came in time
  ERROR_SEM_TIMEOUT: uint32 = 121;
  /// Windows' `ERROR_FILENAME_EXCED_RANGE`: The error of a path or command line too long for Win32
  ERROR_FILENAME_EXCED_RANGE: uint32 = 206;
  /// SuspendThread / ResumeThread's failure
  ADAM_WINDOWS_THREAD_FAILED: uint32 = 0xFFFFFFFF;
  /// The UTF-16 units GetFinalPathNameByHandleW and WinErrorText write at most
  ADAM_WINDOWS_DEBUG_TEXT_MAX: uint32 = 32767;

  /// Windows' `FORMAT_MESSAGE_FROM_SYSTEM`: FormatMessageW: the system's message table, its inserts left as they are
  FORMAT_MESSAGE_FROM_SYSTEM: uint32 = 0x1000;
  /// Windows' `FORMAT_MESSAGE_IGNORE_INSERTS`: FormatMessageW: the system's message table, its inserts left as they are
  FORMAT_MESSAGE_IGNORE_INSERTS: uint32 = 0x200;

  /// Windows' `CTRL_C_EVENT`: A console control handler's events: Ctrl+C, Ctrl+Break
  CTRL_C_EVENT: uint32 = 0;
  /// Windows' `CTRL_BREAK_EVENT`: A console control handler's events: Ctrl+C, Ctrl+Break
  CTRL_BREAK_EVENT: uint32 = 1;

  /// Windows' `SYMOPT_UNDNAME`: DbgHelp: SymSetOptions' options (undecorated names, source lines, no error box, no
  /// _NT_SYMBOL_PATH, no prompt)
  SYMOPT_UNDNAME: uint32 = 0x2;
  /// Windows' `SYMOPT_LOAD_LINES`: DbgHelp: SymSetOptions' options (undecorated names, source lines, no error box, no
  /// _NT_SYMBOL_PATH, no prompt)
  SYMOPT_LOAD_LINES: uint32 = 0x10;
  /// Windows' `SYMOPT_FAIL_CRITICAL_ERRORS`: DbgHelp: SymSetOptions' options (undecorated names, source lines, no error box, no
  /// _NT_SYMBOL_PATH, no prompt)
  SYMOPT_FAIL_CRITICAL_ERRORS: uint32 = 0x200;
  /// Windows' `SYMOPT_IGNORE_NT_SYMPATH`: DbgHelp: SymSetOptions' options (undecorated names, source lines, no error box, no
  /// _NT_SYMBOL_PATH, no prompt)
  SYMOPT_IGNORE_NT_SYMPATH: uint32 = 0x1000;
  /// Windows' `SYMOPT_NO_PROMPTS`: DbgHelp: SymSetOptions' options (undecorated names, source lines, no error box, no
  /// _NT_SYMBOL_PATH, no prompt)
  SYMOPT_NO_PROMPTS: uint32 = 0x80000;

  /// Windows' `SYMFLAG_REGREL`: SYMBOL_INFOW's Flags: a value relative to a register, a parameter, a local
  SYMFLAG_REGREL: uint32 = 0x10;
  /// Windows' `SYMFLAG_TLSREL`: A thread-local value (its Address the offset in the module's TLS block)
  SYMFLAG_TLSREL: uint32 = 0x4000;
  /// Windows' `SYMFLAG_PARAMETER`: A thread-local value (its Address the offset in the module's TLS block)
  SYMFLAG_PARAMETER: uint32 = 0x40;
  /// Windows' `SYMFLAG_LOCAL`: A thread-local value (its Address the offset in the module's TLS block)
  SYMFLAG_LOCAL: uint32 = 0x80;

  /// Windows' `SymTagFunction`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagFunction: uint32 = 5;
  /// Windows' `SymTagData`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagData: uint32 = 7;
  /// Windows' `SymTagLabel`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagLabel: uint32 = 9;
  /// Windows' `SymTagPublicSymbol`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagPublicSymbol: uint32 = 10;
  /// Windows' `SymTagUDT`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagUDT: uint32 = 11;
  /// Windows' `SymTagEnum`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagEnum: uint32 = 12;
  /// Windows' `SymTagFunctionType`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagFunctionType: uint32 = 13;
  /// Windows' `SymTagPointerType`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagPointerType: uint32 = 14;
  /// Windows' `SymTagArrayType`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagArrayType: uint32 = 15;
  /// Windows' `SymTagBaseType`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagBaseType: uint32 = 16;
  /// Windows' `SymTagTypedef`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagTypedef: uint32 = 17;
  /// Windows' `SymTagThunk`: SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagThunk: uint32 = 27;

  /// Windows' `TI_GET_SYMTAG`: IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  /// a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_GET_SYMTAG: uint32 = 0;
  /// Windows' `TI_GET_SYMNAME`: IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  /// a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_GET_SYMNAME: uint32 = 1;
  /// Windows' `TI_GET_LENGTH`: IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  /// a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_GET_LENGTH: uint32 = 2;
  /// Windows' `TI_GET_TYPE`: IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  /// a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_GET_TYPE: uint32 = 3;
  /// Windows' `TI_GET_BASETYPE`: IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  /// a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_GET_BASETYPE: uint32 = 5;
  /// Windows' `TI_FINDCHILDREN`: IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  /// a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_FINDCHILDREN: uint32 = 7;
  /// Windows' `TI_GET_OFFSET`: IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  /// a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_GET_OFFSET: uint32 = 10;
  /// Windows' `TI_GET_VALUE`: IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  /// a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_GET_VALUE: uint32 = 11;
  /// Windows' `TI_GET_COUNT`: IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  /// a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_GET_COUNT: uint32 = 12;
  /// Windows' `TI_GET_CHILDRENCOUNT`: IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  /// a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_GET_CHILDRENCOUNT: uint32 = 13;
  /// Windows' `TI_GET_BITPOSITION`: a bitfield member's first bit in its unit (fails for any other member)
  TI_GET_BITPOSITION: uint32 = 14;
  /// Windows' `TI_GET_ADDRESS`: a symbol's address (a uint64)
  TI_GET_ADDRESS: uint32 = 22;

  /// Windows' `SYMSEARCH_ALLITEMS`: SymSearchW's options: nested symbols too (a routine's labels)
  SYMSEARCH_ALLITEMS: uint32 = 0x08;

  /// Windows' `VT_I2`: TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_I2: uint16 = 2;
  /// Windows' `VT_I4`: TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_I4: uint16 = 3;
  /// Windows' `VT_I1`: TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_I1: uint16 = 16;
  /// Windows' `VT_UI1`: TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_UI1: uint16 = 17;
  /// Windows' `VT_UI2`: TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_UI2: uint16 = 18;
  /// Windows' `VT_UI4`: TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_UI4: uint16 = 19;
  /// Windows' `VT_I8`: TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_I8: uint16 = 20;
  /// Windows' `VT_UI8`: TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_UI8: uint16 = 21;
  /// Windows' `VT_INT`: TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_INT: uint16 = 22;
  /// Windows' `VT_UINT`: TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_UINT: uint16 = 23;

  /// Windows' `btVoid`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btVoid: uint32 = 1;
  /// Windows' `btChar`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btChar: uint32 = 2;
  /// Windows' `btWChar`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btWChar: uint32 = 3;
  /// Windows' `btInt`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btInt: uint32 = 6;
  /// Windows' `btUInt`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btUInt: uint32 = 7;
  /// Windows' `btFloat`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btFloat: uint32 = 8;
  /// Windows' `btBool`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btBool: uint32 = 10;
  /// Windows' `btLong`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btLong: uint32 = 13;
  /// Windows' `btULong`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btULong: uint32 = 14;
  /// Windows' `btChar16`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btChar16: uint32 = 30;
  /// Windows' `btChar32`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btChar32: uint32 = 31;
  /// Windows' `btChar8`: BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btChar8: uint32 = 32;

  /// Windows' `AddrModeFlat`: StackWalk64's flat addresses (its machine, IMAGE_FILE_MACHINE_AMD64, is System.Windows')
  AddrModeFlat: uint32 = 3;

  /// The SizeOfStruct DbgHelp checks: SYMBOL_INFOW (its name's first unit included) and
  /// IMAGEHLP_LINEW64; the UTF-16 units a DebugSymbolInfo holds of a name; the children a
  /// DebugFindChildren holds
  ADAM_WINDOWS_SYMBOL_INFO_SIZE: uint32 = 88;
  /// The bytes of an IMAGEHLP_LINEW64 (its SizeOfStruct).
  ADAM_WINDOWS_LINE_INFO_SIZE: uint32 = 40;
  /// Windows' `MAX_SYM_NAME`.
  MAX_SYM_NAME: uint32 = 2000;
  /// The children a DebugFindChildren holds.
  ADAM_WINDOWS_FIND_CHILDREN_MAX: uint32 = 256;

public type
  /// Windows' `EXCEPTION_RECORD` (152 bytes): the exception, where it happened, its parameters
  EXCEPTION_RECORD = record
    /// Windows' `EXCEPTION_RECORD.ExceptionCode`.
    ExceptionCode: uint32;
    /// Windows' `EXCEPTION_RECORD.ExceptionFlags`.
    ExceptionFlags: uint32;
    /// Windows' `EXCEPTION_RECORD.ExceptionRecord`.
    ExceptionRecord: uint64;
    /// Windows' `EXCEPTION_RECORD.ExceptionAddress`.
    ExceptionAddress: uint64;
    /// Windows' `EXCEPTION_RECORD.NumberParameters`.
    NumberParameters: uint32;
    /// Windows' `EXCEPTION_RECORD.ExceptionInformation`.
    ExceptionInformation: array[0..14] of uint64;
  end;

  /// Windows' `EXCEPTION_DEBUG_INFO`: EXCEPTION_DEBUG_INFO
  EXCEPTION_DEBUG_INFO = record
    /// Windows' `EXCEPTION_DEBUG_INFO.ExceptionRecord`.
    ExceptionRecord: EXCEPTION_RECORD;
    /// Windows' `EXCEPTION_DEBUG_INFO.dwFirstChance`.
    dwFirstChance: uint32;
  end;

  /// Windows' `CREATE_THREAD_DEBUG_INFO`: CREATE_THREAD_DEBUG_INFO
  CREATE_THREAD_DEBUG_INFO = record
    /// Windows' `CREATE_THREAD_DEBUG_INFO.hThread`.
    hThread: uint64;
    /// Windows' `CREATE_THREAD_DEBUG_INFO.lpThreadLocalBase`.
    lpThreadLocalBase: uint64;
    /// Windows' `CREATE_THREAD_DEBUG_INFO.lpStartAddress`.
    lpStartAddress: uint64;
  end;

  /// Windows' `CREATE_PROCESS_DEBUG_INFO` (File is the debugger's to close)
  CREATE_PROCESS_DEBUG_INFO = record
    /// Windows' `CREATE_PROCESS_DEBUG_INFO.hFile`.
    hFile: uint64;
    /// Windows' `CREATE_PROCESS_DEBUG_INFO.hProcess`.
    hProcess: uint64;
    /// Windows' `CREATE_PROCESS_DEBUG_INFO.hThread`.
    hThread: uint64;
    /// Windows' `CREATE_PROCESS_DEBUG_INFO.lpBaseOfImage`.
    lpBaseOfImage: uint64;
    /// Windows' `CREATE_PROCESS_DEBUG_INFO.dwDebugInfoFileOffset`.
    dwDebugInfoFileOffset: uint32;
    /// Windows' `CREATE_PROCESS_DEBUG_INFO.nDebugInfoSize`.
    nDebugInfoSize: uint32;
    /// Windows' `CREATE_PROCESS_DEBUG_INFO.lpThreadLocalBase`.
    lpThreadLocalBase: uint64;
    /// Windows' `CREATE_PROCESS_DEBUG_INFO.lpStartAddress`.
    lpStartAddress: uint64;
    /// Windows' `CREATE_PROCESS_DEBUG_INFO.lpImageName`.
    lpImageName: uint64;
    /// Windows' `CREATE_PROCESS_DEBUG_INFO.fUnicode`.
    fUnicode: uint16;
  end;

  /// Windows' `EXIT_THREAD_DEBUG_INFO`.
  EXIT_THREAD_DEBUG_INFO = record
    /// Windows' `EXIT_THREAD_DEBUG_INFO.dwExitCode`.
    dwExitCode: uint32;
  end;

  /// Windows' `EXIT_PROCESS_DEBUG_INFO`.
  EXIT_PROCESS_DEBUG_INFO = record
    /// Windows' `EXIT_PROCESS_DEBUG_INFO.dwExitCode`.
    dwExitCode: uint32;
  end;

  /// Windows' `LOAD_DLL_DEBUG_INFO` (File is the debugger's to close)
  LOAD_DLL_DEBUG_INFO = record
    /// Windows' `LOAD_DLL_DEBUG_INFO.hFile`.
    hFile: uint64;
    /// Windows' `LOAD_DLL_DEBUG_INFO.lpBaseOfDll`.
    lpBaseOfDll: uint64;
    /// Windows' `LOAD_DLL_DEBUG_INFO.dwDebugInfoFileOffset`.
    dwDebugInfoFileOffset: uint32;
    /// Windows' `LOAD_DLL_DEBUG_INFO.nDebugInfoSize`.
    nDebugInfoSize: uint32;
    /// Windows' `LOAD_DLL_DEBUG_INFO.lpImageName`.
    lpImageName: uint64;
    /// Windows' `LOAD_DLL_DEBUG_INFO.fUnicode`.
    fUnicode: uint16;
  end;

  /// Windows' `UNLOAD_DLL_DEBUG_INFO`: UNLOAD_DLL_DEBUG_INFO
  UNLOAD_DLL_DEBUG_INFO = record
    /// Windows' `UNLOAD_DLL_DEBUG_INFO.lpBaseOfDll`.
    lpBaseOfDll: uint64;
  end;

  /// Windows' `OUTPUT_DEBUG_STRING_INFO`: OUTPUT_DEBUG_STRING_INFO
  OUTPUT_DEBUG_STRING_INFO = record
    /// Windows' `OUTPUT_DEBUG_STRING_INFO.lpDebugStringData`.
    lpDebugStringData: uint64;
    /// Windows' `OUTPUT_DEBUG_STRING_INFO.fUnicode`.
    fUnicode: uint16;
    /// Windows' `OUTPUT_DEBUG_STRING_INFO.nDebugStringLength`.
    nDebugStringLength: uint16;
  end;

  /// Windows' `RIP_INFO`: RIP_INFO
  RIP_INFO = record
    /// Windows' `RIP_INFO.dwError`.
    dwError: uint32;
    /// Windows' `RIP_INFO.dwType`.
    dwType: uint32;
  end;

  /// Windows' `DEBUG_EVENT` (176 bytes): the event's code, its process and thread, and the code's
  /// record in the union at offset 16
  DEBUG_EVENT = record
    /// Windows' `DEBUG_EVENT.dwDebugEventCode`.
    dwDebugEventCode: uint32;
    /// Windows' `DEBUG_EVENT.dwProcessId`.
    dwProcessId: uint32;
    /// Windows' `DEBUG_EVENT.dwThreadId`.
    dwThreadId: uint32;
    /// Windows' `DEBUG_EVENT.u`.
    u: overlay
      Exception: EXCEPTION_DEBUG_INFO;
      CreateThread: CREATE_THREAD_DEBUG_INFO;
      CreateProcessInfo: CREATE_PROCESS_DEBUG_INFO;
      ExitThread: EXIT_THREAD_DEBUG_INFO;
      ExitProcess: EXIT_PROCESS_DEBUG_INFO;
      LoadDll: LOAD_DLL_DEBUG_INFO;
      UnloadDll: UNLOAD_DLL_DEBUG_INFO;
      DebugString: OUTPUT_DEBUG_STRING_INFO;
      RipInfo: RIP_INFO;
    end;
  end;

  /// Windows' `CONTEXT`: The x64 CONTEXT (1232 bytes; 16-byte aligned where the API reads or writes it)
  CONTEXT = record
    /// Windows' `CONTEXT.P1Home`.
    P1Home: uint64;
    /// Windows' `CONTEXT.P2Home`.
    P2Home: uint64;
    /// Windows' `CONTEXT.P3Home`.
    P3Home: uint64;
    /// Windows' `CONTEXT.P4Home`.
    P4Home: uint64;
    /// Windows' `CONTEXT.P5Home`.
    P5Home: uint64;
    /// Windows' `CONTEXT.P6Home`.
    P6Home: uint64;
    /// Windows' `CONTEXT.ContextFlags`.
    ContextFlags: uint32;
    /// Windows' `CONTEXT.MxCsr`.
    MxCsr: uint32;
    /// Windows' `CONTEXT.SegCs`.
    SegCs: uint16;
    /// Windows' `CONTEXT.SegDs`.
    SegDs: uint16;
    /// Windows' `CONTEXT.SegEs`.
    SegEs: uint16;
    /// Windows' `CONTEXT.SegFs`.
    SegFs: uint16;
    /// Windows' `CONTEXT.SegGs`.
    SegGs: uint16;
    /// Windows' `CONTEXT.SegSs`.
    SegSs: uint16;
    /// Windows' `CONTEXT.EFlags`.
    EFlags: uint32;
    /// Windows' `CONTEXT.Dr0`.
    Dr0: uint64;
    /// Windows' `CONTEXT.Dr1`.
    Dr1: uint64;
    /// Windows' `CONTEXT.Dr2`.
    Dr2: uint64;
    /// Windows' `CONTEXT.Dr3`.
    Dr3: uint64;
    /// Windows' `CONTEXT.Dr6`.
    Dr6: uint64;
    /// Windows' `CONTEXT.Dr7`.
    Dr7: uint64;
    /// Windows' `CONTEXT.Rax`.
    Rax: uint64;
    /// Windows' `CONTEXT.Rcx`.
    Rcx: uint64;
    /// Windows' `CONTEXT.Rdx`.
    Rdx: uint64;
    /// Windows' `CONTEXT.Rbx`.
    Rbx: uint64;
    /// Windows' `CONTEXT.Rsp`.
    Rsp: uint64;
    /// Windows' `CONTEXT.Rbp`.
    Rbp: uint64;
    /// Windows' `CONTEXT.Rsi`.
    Rsi: uint64;
    /// Windows' `CONTEXT.Rdi`.
    Rdi: uint64;
    /// Windows' `CONTEXT.R8`.
    R8: uint64;
    /// Windows' `CONTEXT.R9`.
    R9: uint64;
    /// Windows' `CONTEXT.R10`.
    R10: uint64;
    /// Windows' `CONTEXT.R11`.
    R11: uint64;
    /// Windows' `CONTEXT.R12`.
    R12: uint64;
    /// Windows' `CONTEXT.R13`.
    R13: uint64;
    /// Windows' `CONTEXT.R14`.
    R14: uint64;
    /// Windows' `CONTEXT.R15`.
    R15: uint64;
    /// Windows' `CONTEXT.Rip`.
    Rip: uint64;
    /// Windows' `CONTEXT.FltSave`: XMM_SAVE_AREA32 (FltSave), as its bytes
    FltSave: array[0..63] of uint64;
    /// Windows' `CONTEXT.VectorRegister`: VectorRegister[26] (M128A each), as its bytes
    VectorRegister: array[0..51] of uint64;
    /// Windows' `CONTEXT.VectorControl`: VectorRegister[26] (M128A each), as its bytes
    VectorControl: uint64;
    /// Windows' `CONTEXT.DebugControl`: VectorRegister[26] (M128A each), as its bytes
    DebugControl: uint64;
    /// Windows' `CONTEXT.LastBranchToRip`: VectorRegister[26] (M128A each), as its bytes
    LastBranchToRip: uint64;
    /// Windows' `CONTEXT.LastBranchFromRip`: VectorRegister[26] (M128A each), as its bytes
    LastBranchFromRip: uint64;
    /// Windows' `CONTEXT.LastExceptionToRip`: VectorRegister[26] (M128A each), as its bytes
    LastExceptionToRip: uint64;
    /// Windows' `CONTEXT.LastExceptionFromRip`: VectorRegister[26] (M128A each), as its bytes
    LastExceptionFromRip: uint64;
  end;

  /// SYMBOL_INFOW (88 bytes) with room for a name of MAX_SYM_NAME units: set
  /// SizeOfStruct to ADAM_WINDOWS_SYMBOL_INFO_SIZE and MaxNameLen to MAX_SYM_NAME
  DebugSymbolInfo = record
    /// SYMBOL_INFOW's `SizeOfStruct`: set to ADAM_WINDOWS_SYMBOL_INFO_SIZE.
    SizeOfStruct: uint32;
    /// SYMBOL_INFOW's `TypeIndex`: the symbol's type.
    TypeIndex: uint32;
    /// SYMBOL_INFOW's `Reserved`.
    Reserved: array[0..1] of uint64;
    /// SYMBOL_INFOW's `Index`.
    Index: uint32;
    /// SYMBOL_INFOW's `Size`: the symbol's size in bytes.
    Size: uint32;
    /// SYMBOL_INFOW's `ModBase`: the base of its module.
    ModBase: uint64;
    /// SYMBOL_INFOW's `Flags` (SYMFLAG_*).
    Flags: uint32;
    /// SYMBOL_INFOW's `Value`.
    Value: uint64;
    /// SYMBOL_INFOW's `Address`.
    Address: uint64;
    /// SYMBOL_INFOW's `Register`.
    Register: uint32;
    /// SYMBOL_INFOW's `Scope`.
    Scope: uint32;
    /// SYMBOL_INFOW's `Tag` (a SymTag* value).
    Tag: uint32;
    /// SYMBOL_INFOW's `NameLen`: the units of Name used.
    NameLen: uint32;
    /// SYMBOL_INFOW's `MaxNameLen`: set to MAX_SYM_NAME.
    MaxNameLen: uint32;
    /// SYMBOL_INFOW's `Name`, with room for MAX_SYM_NAME units (DbgSymbolName reads it).
    Name: array[0..1999] of uint16;
  end;

  /// Windows' `IMAGEHLP_LINEW64` (40 bytes): set SizeOfStruct to ADAM_WINDOWS_LINE_INFO_SIZE; FileName
  /// points into DbgHelp's own memory (DbgWideText reads it)
  IMAGEHLP_LINEW64 = record
    /// Windows' `IMAGEHLP_LINEW64.SizeOfStruct`.
    SizeOfStruct: uint32;
    /// Windows' `IMAGEHLP_LINEW64.Key`.
    Key: ptr;
    /// Windows' `IMAGEHLP_LINEW64.LineNumber`.
    LineNumber: uint32;
    /// Windows' `IMAGEHLP_LINEW64.FileName`.
    FileName: ptr to const uint16;
    /// Windows' `IMAGEHLP_LINEW64.Address`.
    Address: uint64;
  end;

  /// TI_FINDCHILDREN_PARAMS with room for ADAM_WINDOWS_FIND_CHILDREN_MAX children: set Count
  /// (TI_GET_CHILDRENCOUNT's) and Start 0
  DebugFindChildren = record
    /// TI_FINDCHILDREN_PARAMS' `Count`: TI_GET_CHILDRENCOUNT's.
    Count: uint32;
    /// TI_FINDCHILDREN_PARAMS' `Start`: set to 0.
    Start: uint32;
    /// TI_FINDCHILDREN_PARAMS' `ChildId`: the children's type ids.
    ChildId: array[0..255] of uint32;
  end;

  /// Windows' `PSYM_ENUMERATESYMBOLS_CALLBACKW`: SymEnumSymbolsW's callback: each symbol, its size, the caller's context; 0 stops
  PSYM_ENUMERATESYMBOLS_CALLBACKW = func clink(ASymbol: ptr to const DebugSymbolInfo;
    ASymbolSize: uint32; AContext: ptr): int32;

  // SOURCEFILEW: one source file a module's PDB names (FileName in DbgHelp's own memory)
  /// Windows' `SOURCEFILEW`: SOURCEFILEW: one source file a module's PDB names (FileName in DbgHelp's own memory)
  SOURCEFILEW = record
    /// Windows' `SOURCEFILEW.ModBase`.
    ModBase: uint64;
    /// Windows' `SOURCEFILEW.FileName`.
    FileName: ptr to const uint16;
  end;

  /// Windows' `PSYM_ENUMSOURCEFILES_CALLBACKW`: SymEnumSourceFilesW's callback: each source file, the caller's context; 0 stops
  PSYM_ENUMSOURCEFILES_CALLBACKW = func clink(ASource: ptr to const SOURCEFILEW;
    AContext: ptr): int32;

  /// VARIANT (24 bytes) as TI_GET_VALUE writes an enum value: its kind, then the value's bytes
  DebugVariant = record
    /// VARIANT's `vt`: the value's kind.
    Kind: uint16;
    /// VARIANT's `wReserved1`.
    Reserved1: uint16;
    /// VARIANT's `wReserved2`.
    Reserved2: uint16;
    /// VARIANT's `wReserved3`.
    Reserved3: uint16;
    /// The value's first 8 bytes.
    Value: uint64;
    /// The value's next 8 bytes.
    Extra: uint64;
  end;

  /// Windows' `ADDRESS64` (16 bytes): an address and its mode (AddrModeFlat)
  ADDRESS64 = record
    /// Windows' `ADDRESS64.Offset`.
    Offset: uint64;
    /// Windows' `ADDRESS64.Segment`.
    Segment: uint16;
    /// Windows' `ADDRESS64.Mode`.
    Mode: uint32;
  end;

  /// Windows' `STACKFRAME64` (264 bytes): one frame StackWalk64 found; set AddrPC / AddrFrame / AddrStack
  /// (flat) before the first call, every other byte zero. KdHelp (KDHELP64) is only DbgHelp's
  STACKFRAME64 = record
    /// Windows' `STACKFRAME64.AddrPC`.
    AddrPC: ADDRESS64;
    /// Windows' `STACKFRAME64.AddrReturn`.
    AddrReturn: ADDRESS64;
    /// Windows' `STACKFRAME64.AddrFrame`.
    AddrFrame: ADDRESS64;
    /// Windows' `STACKFRAME64.AddrStack`.
    AddrStack: ADDRESS64;
    /// Windows' `STACKFRAME64.AddrBStore`.
    AddrBStore: ADDRESS64;
    /// Windows' `STACKFRAME64.FuncTableEntry`.
    FuncTableEntry: ptr;
    /// Windows' `STACKFRAME64.Params`.
    Params: array[0..3] of uint64;
    /// Windows' `STACKFRAME64.Far`.
    Far: int32;
    /// Windows' `STACKFRAME64.Virtual`.
    Virtual: int32;
    /// Windows' `STACKFRAME64.Reserved`.
    Reserved: array[0..2] of uint64;
    /// Windows' `STACKFRAME64.KdHelp`.
    KdHelp: array[0..13] of uint64;
  end;

  /// Windows' `PREAD_PROCESS_MEMORY_ROUTINE64`: StackWalk64's routines: the debuggee's memory (bytes at an address into a buffer, how
  /// many read; 0 fails), a function table entry for an address (SymFunctionTableAccess64),
  /// the base of the module holding an address (SymGetModuleBase64)
  PREAD_PROCESS_MEMORY_ROUTINE64 = func clink(AProcess: uint64; AAddress: uint64; ABuffer: ptr;
    ASize: uint32; ARead: ptr to uint32): int32;
  /// Windows' `PFUNCTION_TABLE_ACCESS_ROUTINE64`.
  PFUNCTION_TABLE_ACCESS_ROUTINE64 = func clink(AProcess: uint64; AAddress: uint64): ptr;
  /// Windows' `PGET_MODULE_BASE_ROUTINE64`.
  PGET_MODULE_BASE_ROUTINE64 = func clink(AProcess: uint64; AAddress: uint64): uint64;

  /// Windows' `PHANDLER_ROUTINE`: SetConsoleCtrlHandler's handler (PHANDLER_ROUTINE): run on a thread of the OS's for a
  /// console event (CTRL_*); nonzero = handled
  PHANDLER_ROUTINE = func clink(ACtrlType: uint32): int32;

