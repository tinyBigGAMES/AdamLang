  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.Windows.Debug.adam - the Win32 debugging API, declared for Adam
  (x86_64-windows-gnu only)

  The kernel32 calls a debugger makes (CreateProcessW under
  DEBUG_ONLY_THIS_PROCESS, WaitForDebugEvent / ContinueDebugEvent, the
  thread context, the debuggee's memory, its threads, a pipe for its output)
  and the records they read and write, laid out as Win64 lays them out:
  DebugEventInfo (DEBUG_EVENT, 176 bytes, its union an inline overlay),
  ThreadContext (the x64 CONTEXT, 1232 bytes, which the API needs 16-byte
  aligned: a caller points it into a buffer it aligned itself). Handles and
  addresses in the debuggee are uint64. WinErrorText is the system's own
  message for an error code, for a report.

  DbgHelp (dbghelp.dll, shipped with Windows) reads a program's PDB: a
  module loaded at a base (SymLoadModuleExW), a symbol by name or address
  (SymFromNameW / SymFromAddrW: DebugSymbolInfo, SYMBOL_INFOW with room for
  its name), a source line by address or file and line
  (SymGetLineFromAddrW64 / SymGetLineFromNameW64: DebugLineInfo,
  IMAGEHLP_LINEW64), the parameters and locals of a routine
  (SymSetScopeFromAddr, then SymEnumSymbolsW), a module's symbols of one
  kind, nested ones too (SymSearchW: a routine's labels), a type's facts
  (SymGetTypeInfo), the source files it names (SymEnumSourceFilesW), the
  lines after one (SymGetLineNextW64), a thread's frames (StackWalk64:
  DebugStackFrame64, the debuggee's memory read by the caller's own
  routine). The console the debugger runs in: whether a standard handle is
  one (GetConsoleMode), its Ctrl+C / Ctrl+Break taken by a handler
  (SetConsoleCtrlHandler; the program in a process group of its own does
  not get them). Its text in is UTF-16 (a ptr to const uint16, nil
  where DbgHelp allows NULL); DbgWideText, DbgSymbolName and SymTypeName
  turn its text out into a string.

  Adam's debugger reaches Windows only through this unit (its Win64 parts,
  Adam.Debug.*.Win64); nothing above those parts imports it. A linux64
  debugger adds its own unit over ptrace beside it.
*******************************************************************************/

module unit System.Windows.Debug;

import System.SysUtils, System.Windows;

public const
  // CreateProcessW's flags: the new process is debugged by this one (not its children)
  DEBUG_ONLY_THIS_PROCESS: uint32 = 0x2;
  // ... in a process group of its own: the console's Ctrl+C is not its (the debugger's, D4)
  CREATE_NEW_PROCESS_GROUP: uint32 = 0x200;

  // DEBUG_EVENT's dwDebugEventCode
  EXCEPTION_DEBUG_EVENT: uint32 = 1;
  CREATE_THREAD_DEBUG_EVENT: uint32 = 2;
  CREATE_PROCESS_DEBUG_EVENT: uint32 = 3;
  EXIT_THREAD_DEBUG_EVENT: uint32 = 4;
  EXIT_PROCESS_DEBUG_EVENT: uint32 = 5;
  LOAD_DLL_DEBUG_EVENT: uint32 = 6;
  UNLOAD_DLL_DEBUG_EVENT: uint32 = 7;
  OUTPUT_DEBUG_STRING_EVENT: uint32 = 8;
  RIP_EVENT: uint32 = 9;

  // ContinueDebugEvent's status: the event is handled / an exception goes to the program
  DBG_CONTINUE: uint32 = 0x00010002;
  DBG_EXCEPTION_NOT_HANDLED: uint32 = 0x80010001;

  // EXCEPTION_RECORD's ExceptionCode: an int3, a trap-flag step
  EXCEPTION_BREAKPOINT: uint32 = 0x80000003;
  EXCEPTION_SINGLE_STEP: uint32 = 0x80000004;

  // CONTEXT's ContextFlags: CONTEXT_ALL for AMD64 (control, integer, segments, floating
  // point, debug registers)
  CONTEXT_ALL: uint32 = 0x0010001F;
  // The trap flag in EFlags: one instruction, then a single-step exception
  ADAM_WINDOWS_TRAP_FLAG: uint32 = 0x100;
  // The bytes of a CONTEXT and the alignment GetThreadContext / SetThreadContext need
  ADAM_WINDOWS_CONTEXT_SIZE: int64 = 1232;
  ADAM_WINDOWS_CONTEXT_ALIGN: int64 = 16;

  // VirtualProtectEx's protection for a code byte the debugger writes
  PAGE_EXECUTE_READWRITE: uint32 = 0x40;
  // WaitForDebugEvent's error when no event came in time
  ERROR_SEM_TIMEOUT: uint32 = 121;
  // The error of a path or command line too long for Win32
  ERROR_FILENAME_EXCED_RANGE: uint32 = 206;
  // SuspendThread / ResumeThread's failure
  ADAM_WINDOWS_THREAD_FAILED: uint32 = 0xFFFFFFFF;
  // The UTF-16 units GetFinalPathNameByHandleW and WinErrorText write at most
  ADAM_WINDOWS_DEBUG_TEXT_MAX: uint32 = 32767;

  // FormatMessageW: the system's message table, its inserts left as they are
  FORMAT_MESSAGE_FROM_SYSTEM: uint32 = 0x1000;
  FORMAT_MESSAGE_IGNORE_INSERTS: uint32 = 0x200;

  // A console control handler's events: Ctrl+C, Ctrl+Break
  CTRL_C_EVENT: uint32 = 0;
  CTRL_BREAK_EVENT: uint32 = 1;

  // DbgHelp: SymSetOptions' options (undecorated names, source lines, no error box, no
  // _NT_SYMBOL_PATH, no prompt)
  SYMOPT_UNDNAME: uint32 = 0x2;
  SYMOPT_LOAD_LINES: uint32 = 0x10;
  SYMOPT_FAIL_CRITICAL_ERRORS: uint32 = 0x200;
  SYMOPT_IGNORE_NT_SYMPATH: uint32 = 0x1000;
  SYMOPT_NO_PROMPTS: uint32 = 0x80000;

  // SYMBOL_INFOW's Flags: a value relative to a register, a parameter, a local
  SYMFLAG_REGREL: uint32 = 0x10;
  // A thread-local value (its Address the offset in the module's TLS block)
  SYMFLAG_TLSREL: uint32 = 0x4000;
  SYMFLAG_PARAMETER: uint32 = 0x40;
  SYMFLAG_LOCAL: uint32 = 0x80;

  // SymTagEnum: a symbol's or a type's kind (SYMBOL_INFOW's Tag, TI_GET_SYMTAG)
  SymTagFunction: uint32 = 5;
  SymTagData: uint32 = 7;
  SymTagLabel: uint32 = 9;
  SymTagPublicSymbol: uint32 = 10;
  SymTagUDT: uint32 = 11;
  SymTagEnum: uint32 = 12;
  SymTagFunctionType: uint32 = 13;
  SymTagPointerType: uint32 = 14;
  SymTagArrayType: uint32 = 15;
  SymTagBaseType: uint32 = 16;
  SymTagTypedef: uint32 = 17;

  // IMAGEHLP_SYMBOL_TYPE_INFO: what SymGetTypeInfo writes (TI_GET_LENGTH a uint64, TI_GET_SYMNAME
  // a LocalAlloc'd UTF-16 text, TI_FINDCHILDREN a DebugFindChildren, the rest a uint32)
  TI_GET_SYMTAG: uint32 = 0;
  TI_GET_SYMNAME: uint32 = 1;
  TI_GET_LENGTH: uint32 = 2;
  TI_GET_TYPE: uint32 = 3;
  TI_GET_BASETYPE: uint32 = 5;
  TI_FINDCHILDREN: uint32 = 7;
  TI_GET_OFFSET: uint32 = 10;
  TI_GET_VALUE: uint32 = 11;
  TI_GET_COUNT: uint32 = 12;
  TI_GET_CHILDRENCOUNT: uint32 = 13;
  // a bitfield member's first bit in its unit (fails for any other member)
  TI_GET_BITPOSITION: uint32 = 14;
  // a symbol's address (a uint64)
  TI_GET_ADDRESS: uint32 = 22;

  // SymSearchW's options: nested symbols too (a routine's labels)
  SYMSEARCH_ALLITEMS: uint32 = 0x08;

  // TI_GET_VALUE's VARIANT kinds (DebugVariant.Kind) an enum value comes as
  VT_I2: uint16 = 2;
  VT_I4: uint16 = 3;
  VT_I1: uint16 = 16;
  VT_UI1: uint16 = 17;
  VT_UI2: uint16 = 18;
  VT_UI4: uint16 = 19;
  VT_I8: uint16 = 20;
  VT_UI8: uint16 = 21;
  VT_INT: uint16 = 22;
  VT_UINT: uint16 = 23;

  // BasicType (TI_GET_BASETYPE): DbgHelp's kinds of a builtin type
  btVoid: uint32 = 1;
  btChar: uint32 = 2;
  btWChar: uint32 = 3;
  btInt: uint32 = 6;
  btUInt: uint32 = 7;
  btFloat: uint32 = 8;
  btBool: uint32 = 10;
  btLong: uint32 = 13;
  btULong: uint32 = 14;
  btChar16: uint32 = 30;
  btChar32: uint32 = 31;
  btChar8: uint32 = 32;

  // StackWalk64: the x64 machine, flat addresses
  IMAGE_FILE_MACHINE_AMD64: uint32 = 0x8664;
  AddrModeFlat: uint32 = 3;

  // The SizeOfStruct DbgHelp checks: SYMBOL_INFOW (its name's first unit included) and
  // IMAGEHLP_LINEW64; the UTF-16 units a DebugSymbolInfo holds of a name; the children a
  // DebugFindChildren holds
  ADAM_WINDOWS_SYMBOL_INFO_SIZE: uint32 = 88;
  ADAM_WINDOWS_LINE_INFO_SIZE: uint32 = 40;
  MAX_SYM_NAME: uint32 = 2000;
  ADAM_WINDOWS_FIND_CHILDREN_MAX: uint32 = 256;

public type
  // EXCEPTION_RECORD (152 bytes): the exception, where it happened, its parameters
  ExceptionRecord64 = record
    ExceptionCode: uint32;
    ExceptionFlags: uint32;
    NestedRecord: uint64;
    ExceptionAddress: uint64;
    NumberParameters: uint32;
    ExceptionInformation: array[0..14] of uint64;
  end;

  // EXCEPTION_DEBUG_INFO
  ExceptionDebugInfo = record
    Exception: ExceptionRecord64;
    FirstChance: uint32;
  end;

  // CREATE_THREAD_DEBUG_INFO
  CreateThreadDebugInfo = record
    Thread: uint64;
    ThreadLocalBase: uint64;
    StartAddress: uint64;
  end;

  // CREATE_PROCESS_DEBUG_INFO (File is the debugger's to close)
  CreateProcessDebugInfo = record
    File: uint64;
    Process: uint64;
    Thread: uint64;
    BaseOfImage: uint64;
    DebugInfoFileOffset: uint32;
    DebugInfoSize: uint32;
    ThreadLocalBase: uint64;
    StartAddress: uint64;
    ImageName: uint64;
    Unicode: uint16;
  end;

  // EXIT_THREAD_DEBUG_INFO / EXIT_PROCESS_DEBUG_INFO
  ExitDebugInfo = record
    ExitCode: uint32;
  end;

  // LOAD_DLL_DEBUG_INFO (File is the debugger's to close)
  LoadDllDebugInfo = record
    File: uint64;
    BaseOfDll: uint64;
    DebugInfoFileOffset: uint32;
    DebugInfoSize: uint32;
    ImageName: uint64;
    Unicode: uint16;
  end;

  // UNLOAD_DLL_DEBUG_INFO
  UnloadDllDebugInfo = record
    BaseOfDll: uint64;
  end;

  // OUTPUT_DEBUG_STRING_INFO
  OutputDebugStringInfo = record
    DebugStringData: uint64;
    Unicode: uint16;
    DebugStringLength: uint16;
  end;

  // RIP_INFO
  RipDebugInfo = record
    Error: uint32;
    RipType: uint32;
  end;

  // DEBUG_EVENT (176 bytes): the event's code, its process and thread, and the code's
  // record in the union at offset 16
  DebugEventInfo = record
    DebugEventCode: uint32;
    ProcessId: uint32;
    ThreadId: uint32;
    Info: overlay
      Exception: ExceptionDebugInfo;
      CreateThread: CreateThreadDebugInfo;
      CreateProcessInfo: CreateProcessDebugInfo;
      ExitThread: ExitDebugInfo;
      ExitProcess: ExitDebugInfo;
      LoadDll: LoadDllDebugInfo;
      UnloadDll: UnloadDllDebugInfo;
      DebugString: OutputDebugStringInfo;
      Rip: RipDebugInfo;
    end;
  end;

  // The x64 CONTEXT (1232 bytes; 16-byte aligned where the API reads or writes it)
  ThreadContext = record
    P1Home: uint64;
    P2Home: uint64;
    P3Home: uint64;
    P4Home: uint64;
    P5Home: uint64;
    P6Home: uint64;
    ContextFlags: uint32;
    MxCsr: uint32;
    SegCs: uint16;
    SegDs: uint16;
    SegEs: uint16;
    SegFs: uint16;
    SegGs: uint16;
    SegSs: uint16;
    EFlags: uint32;
    Dr0: uint64;
    Dr1: uint64;
    Dr2: uint64;
    Dr3: uint64;
    Dr6: uint64;
    Dr7: uint64;
    Rax: uint64;
    Rcx: uint64;
    Rdx: uint64;
    Rbx: uint64;
    Rsp: uint64;
    Rbp: uint64;
    Rsi: uint64;
    Rdi: uint64;
    R8: uint64;
    R9: uint64;
    R10: uint64;
    R11: uint64;
    R12: uint64;
    R13: uint64;
    R14: uint64;
    R15: uint64;
    Rip: uint64;
    // XMM_SAVE_AREA32 (FltSave), as its bytes
    FltSave: array[0..63] of uint64;
    // VectorRegister[26] (M128A each), as its bytes
    VectorRegister: array[0..51] of uint64;
    VectorControl: uint64;
    DebugControl: uint64;
    LastBranchToRip: uint64;
    LastBranchFromRip: uint64;
    LastExceptionToRip: uint64;
    LastExceptionFromRip: uint64;
  end;

  // SECURITY_ATTRIBUTES
  DebugSecurityAttributes = record
    StructSize: uint32;
    SecurityDescriptor: ptr;
    InheritHandle: int32;
  end;

  // STARTUPINFOW
  DebugStartupInfo = record
    Cb: uint32;
    Reserved: ptr;
    Desktop: ptr;
    Title: ptr;
    X: uint32;
    Y: uint32;
    XSize: uint32;
    YSize: uint32;
    XCountChars: uint32;
    YCountChars: uint32;
    FillAttribute: uint32;
    Flags: uint32;
    ShowWindow: uint16;
    CbReserved2: uint16;
    Reserved2: ptr;
    StdInput: uint64;
    StdOutput: uint64;
    StdError: uint64;
  end;

  // PROCESS_INFORMATION
  DebugProcessInformation = record
    Process: uint64;
    Thread: uint64;
    ProcessId: uint32;
    ThreadId: uint32;
  end;

  // A WideBuffer on the heap (a 64 KB text kept off a routine's stack frame)
  DebugWideBox = final object
    Data: WideBuffer;
  end;

  // SYMBOL_INFOW (88 bytes) with room for a name of MAX_SYM_NAME units: set
  // StructSize to ADAM_WINDOWS_SYMBOL_INFO_SIZE and MaxNameLen to MAX_SYM_NAME
  DebugSymbolInfo = record
    StructSize: uint32;
    TypeIndex: uint32;
    Reserved: array[0..1] of uint64;
    Index: uint32;
    Size: uint32;
    ModBase: uint64;
    Flags: uint32;
    Value: uint64;
    Address: uint64;
    Register: uint32;
    Scope: uint32;
    Tag: uint32;
    NameLen: uint32;
    MaxNameLen: uint32;
    Name: array[0..1999] of uint16;
  end;

  // IMAGEHLP_LINEW64 (40 bytes): set StructSize to ADAM_WINDOWS_LINE_INFO_SIZE; FileName
  // points into DbgHelp's own memory (DbgWideText reads it)
  DebugLineInfo = record
    StructSize: uint32;
    Key: ptr;
    LineNumber: uint32;
    FileName: ptr to const uint16;
    Address: uint64;
  end;

  // TI_FINDCHILDREN_PARAMS with room for ADAM_WINDOWS_FIND_CHILDREN_MAX children: set Count
  // (TI_GET_CHILDRENCOUNT's) and Start 0
  DebugFindChildren = record
    Count: uint32;
    Start: uint32;
    ChildId: array[0..255] of uint32;
  end;

  // SymEnumSymbolsW's callback: each symbol, its size, the caller's context; 0 stops
  DebugEnumSymbolsCallback = routine clink(ASymbol: ptr to const DebugSymbolInfo;
    ASymbolSize: uint32; AContext: ptr): int32;

  // SOURCEFILEW: one source file a module's PDB names (FileName in DbgHelp's own memory)
  DebugSourceFile = record
    ModBase: uint64;
    FileName: ptr to const uint16;
  end;

  // SymEnumSourceFilesW's callback: each source file, the caller's context; 0 stops
  DebugEnumSourceFilesCallback = routine clink(ASource: ptr to const DebugSourceFile;
    AContext: ptr): int32;

  // VARIANT (24 bytes) as TI_GET_VALUE writes an enum value: its kind, then the value's bytes
  DebugVariant = record
    Kind: uint16;
    Reserved1: uint16;
    Reserved2: uint16;
    Reserved3: uint16;
    Value: uint64;
    Extra: uint64;
  end;

  // ADDRESS64 (16 bytes): an address and its mode (AddrModeFlat)
  DebugAddress64 = record
    Offset: uint64;
    Segment: uint16;
    Mode: uint32;
  end;

  // STACKFRAME64 (264 bytes): one frame StackWalk64 found; set AddrPC / AddrFrame / AddrStack
  // (flat) before the first call, every other byte zero. KdHelp (KDHELP64) is only DbgHelp's
  DebugStackFrame64 = record
    AddrPC: DebugAddress64;
    AddrReturn: DebugAddress64;
    AddrFrame: DebugAddress64;
    AddrStack: DebugAddress64;
    AddrBStore: DebugAddress64;
    FuncTableEntry: ptr;
    Params: array[0..3] of uint64;
    IsFar: int32;
    IsVirtual: int32;
    Reserved: array[0..2] of uint64;
    KdHelp: array[0..13] of uint64;
  end;

  // StackWalk64's routines: the debuggee's memory (bytes at an address into a buffer, how
  // many read; 0 fails), a function table entry for an address (SymFunctionTableAccess64),
  // the base of the module holding an address (SymGetModuleBase64)
  DebugReadMemoryCallback = routine clink(AProcess: uint64; AAddress: uint64; ABuffer: ptr;
    ASize: uint32; ARead: ptr to uint32): int32;
  DebugFunctionTableCallback = routine clink(AProcess: uint64; AAddress: uint64): ptr;
  DebugModuleBaseCallback = routine clink(AProcess: uint64; AAddress: uint64): uint64;

  // SetConsoleCtrlHandler's handler (PHANDLER_ROUTINE): run on a thread of the OS's for a
  // console event (CTRL_*); nonzero = handled
  DebugConsoleCtrlHandler = routine clink(ACtrlType: uint32): int32;

public routine clink CreateProcessW(var AApplication: WideBuffer; var ACommandLine: WideBuffer;
  AProcessAttributes: ptr; AThreadAttributes: ptr; AInheritHandles: int32; AFlags: uint32;
  AEnvironment: ptr; var ACurrentDirectory: WideBuffer; var AStartup: DebugStartupInfo;
  var AInfo: DebugProcessInformation): int32; external "kernel32";
public routine clink WaitForDebugEvent(var AEvent: DebugEventInfo; AMilliseconds: uint32): int32;
  external "kernel32";
public routine clink ContinueDebugEvent(AProcessId: uint32; AThreadId: uint32;
  AStatus: uint32): int32; external "kernel32";
public routine clink DebugBreakProcess(AProcess: uint64): int32; external "kernel32";
public routine clink TerminateProcess(AProcess: uint64; AExitCode: uint32): int32;
  external "kernel32";
public routine clink GetThreadContext(AThread: uint64; AContext: ptr): int32; external "kernel32";
public routine clink SetThreadContext(AThread: uint64; AContext: ptr): int32; external "kernel32";
public routine clink ReadProcessMemory(AProcess: uint64; AAddress: uint64; ABuffer: ptr;
  ASize: uint64; var ARead: uint64): int32; external "kernel32";
public routine clink WriteProcessMemory(AProcess: uint64; AAddress: uint64; ABuffer: ptr to const;
  ASize: uint64; var AWritten: uint64): int32; external "kernel32";
public routine clink VirtualProtectEx(AProcess: uint64; AAddress: uint64; ASize: uint64;
  ANewProtect: uint32; var AOldProtect: uint32): int32; external "kernel32";
public routine clink FlushInstructionCache(AProcess: uint64; AAddress: uint64;
  ASize: uint64): int32; external "kernel32";
public routine clink SuspendThread(AThread: uint64): uint32; external "kernel32";
public routine clink ResumeThread(AThread: uint64): uint32; external "kernel32";
public routine clink GetFinalPathNameByHandleW(AFile: uint64; var ABuffer: WideBuffer;
  ASize: uint32; AFlags: uint32): uint32; external "kernel32";
public routine clink CreatePipe(var ARead: uint64; var AWrite: uint64;
  var AAttributes: DebugSecurityAttributes; ASize: uint32): int32; external "kernel32";
public routine clink SetHandleInformation(AHandle: uint64; AMask: uint32; AFlags: uint32): int32;
  external "kernel32";
public routine clink CreateFileW(var AFileName: WideBuffer; AAccess: uint32; AShare: uint32;
  var AAttributes: DebugSecurityAttributes; ADisposition: uint32; AFlags: uint32;
  ATemplate: uint64): uint64; external "kernel32";
public routine clink PeekNamedPipe(APipe: uint64; ABuffer: ptr; ASize: uint32; ARead: ptr;
  var AAvailable: uint32; ALeft: ptr): int32; external "kernel32";
public routine clink ReadFile(AFile: uint64; ABuffer: ptr; AToRead: uint32; var ARead: uint32;
  AOverlapped: ptr): int32; external "kernel32";
public routine clink WaitForSingleObject(AHandle: uint64; AMilliseconds: uint32): uint32;
  external "kernel32";
public routine clink GetExitCodeProcess(AProcess: uint64; var AExitCode: uint32): int32;
  external "kernel32";
public routine clink GetStdHandle(AStdHandle: uint32): uint64; external "kernel32";
public routine clink GetConsoleMode(AConsole: uint64; var AMode: uint32): int32;
  external "kernel32";
public routine clink SetConsoleCtrlHandler(AHandler: DebugConsoleCtrlHandler; AAdd: int32): int32;
  external "kernel32";
public routine clink CloseHandle(AHandle: uint64): int32; external "kernel32";
public routine clink GetLastError(): uint32; external "kernel32";
public routine clink SymSetOptions(AOptions: uint32): uint32; external "dbghelp";
public routine clink SymInitializeW(AProcess: uint64; ASearchPath: ptr to const uint16;
  AInvadeProcess: int32): int32; external "dbghelp";
public routine clink SymLoadModuleExW(AProcess: uint64; AFile: uint64; AImageName: ptr to const uint16;
  AModuleName: ptr to const uint16; ABase: uint64; ASize: uint32; AData: ptr;
  AFlags: uint32): uint64; external "dbghelp";
public routine clink SymFromNameW(AProcess: uint64; ASymbolName: ptr to const uint16;
  var ASymbol: DebugSymbolInfo): int32; external "dbghelp";
public routine clink SymFromAddrW(AProcess: uint64; AAddress: uint64; var ADisplacement: uint64;
  var ASymbol: DebugSymbolInfo): int32; external "dbghelp";
public routine clink SymGetLineFromAddrW64(AProcess: uint64; AAddress: uint64;
  var ADisplacement: uint32; var ALine: DebugLineInfo): int32; external "dbghelp";
public routine clink SymGetLineFromNameW64(AProcess: uint64; AModuleName: ptr to const uint16;
  AFileName: ptr to const uint16; ALineNumber: uint32; var ADisplacement: int32;
  var ALine: DebugLineInfo): int32; external "dbghelp";
public routine clink SymSetScopeFromAddr(AProcess: uint64; AAddress: uint64): int32;
  external "dbghelp";
public routine clink SymEnumSymbolsW(AProcess: uint64; ABase: uint64; AMask: ptr to const uint16;
  ACallback: DebugEnumSymbolsCallback; AContext: ptr): int32; external "dbghelp";
// Every symbol of a module of the SymTagEnum ATag (0 any), nested ones too with
// SYMSEARCH_ALLITEMS, given to ACallback
public routine clink SymSearchW(AProcess: uint64; ABase: uint64; AIndex: uint32; ATag: uint32;
  AMask: ptr to const uint16; AAddress: uint64; ACallback: DebugEnumSymbolsCallback;
  AContext: ptr; AOptions: uint32): int32; external "dbghelp";
public routine clink SymGetTypeInfo(AProcess: uint64; ABase: uint64; ATypeId: uint32;
  AKind: uint32; AInfo: ptr): int32; external "dbghelp";
public routine clink SymGetLineNextW64(AProcess: uint64; var ALine: DebugLineInfo): int32;
  external "dbghelp";
public routine clink SymEnumSourceFilesW(AProcess: uint64; ABase: uint64;
  AMask: ptr to const uint16; ACallback: DebugEnumSourceFilesCallback; AContext: ptr): int32;
  external "dbghelp";
public routine clink SymFunctionTableAccess64(AProcess: uint64; AAddress: uint64): ptr;
  external "dbghelp";
public routine clink SymGetModuleBase64(AProcess: uint64; AAddress: uint64): uint64;
  external "dbghelp";
public routine clink StackWalk64(AMachine: uint32; AProcess: uint64; AThread: uint64;
  var AFrame: DebugStackFrame64; AContext: ptr; AReadMemory: DebugReadMemoryCallback;
  AFunctionTable: DebugFunctionTableCallback; AModuleBase: DebugModuleBaseCallback;
  ATranslate: ptr): int32; external "dbghelp";
public routine clink SymUnloadModule64(AProcess: uint64; ABase: uint64): int32;
  external "dbghelp";
public routine clink SymCleanup(AProcess: uint64): int32; external "dbghelp";
routine clink LocalFree(AMemory: ptr): ptr; external "kernel32";
routine clink FormatMessageW(AFlags: uint32; ASource: ptr; AMessageId: uint32; ALanguageId: uint32;
  var ABuffer: WideBuffer; ASize: uint32; AArguments: ptr): uint32; external "kernel32";

// The system's own message for the Win32 error ACode, its line end and a final '.' cut
// ("Windows error N" when the system has none)
public routine WinErrorText(const ACode: uint32): string;
var
  LBox: own DebugWideBox;
  LCount: uint32;
  LText: string;
begin
  LBox := own DebugWideBox();
  LCount := FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM |
    FORMAT_MESSAGE_IGNORE_INSERTS, nil, ACode, 0, LBox.Data,
    ADAM_WINDOWS_DEBUG_TEXT_MAX, nil);
  if LCount = 0 then
    return "Windows error " + UIntToStr(uint64(ACode));
  end;
  LText := Trim(WideToUtf8(LBox.Data, int32(LCount)));
  if EndsStr(".", LText) then
    LText := Substring(LText, 0, len(LText) - 1);
  end;
  return LText;
end;

// WinErrorText of the calling thread's last error
public routine WinLastErrorText(): string;
begin
  return WinErrorText(GetLastError());
end;

// The UTF-16 text AText points to, up to its 0 (at most ADAM_WINDOWS_DEBUG_TEXT_MAX units),
// as a string; nil gives ""
public routine DbgWideText(const AText: ptr to const uint16): string;
var
  LBox: own DebugWideBox;
  LCount: int64;
begin
  if AText = nil then
    return "";
  end;
  LBox := own DebugWideBox();
  LCount := 0;
  while (LCount < int64(ADAM_WINDOWS_DEBUG_TEXT_MAX)) and (AText[LCount] <> 0) do
    LBox.Data[LCount] := AText[LCount];
    LCount := LCount + 1;
  end;
  return WideToUtf8(LBox.Data, int32(LCount));
end;

// ASymbol's name (NameLen units, never past the room it has) as a string
public routine DbgSymbolName(const ASymbol: DebugSymbolInfo): string;
var
  LBox: own DebugWideBox;
  LCount: int64;
  LIndex: int64;
begin
  LCount := int64(ASymbol.NameLen);
  if LCount > int64(MAX_SYM_NAME) then
    LCount := int64(MAX_SYM_NAME);
  end;
  LBox := own DebugWideBox();
  for LIndex := 0 to LCount - 1 do
    LBox.Data[LIndex] := ASymbol.Name[LIndex];
  end;
  return WideToUtf8(LBox.Data, int32(LCount));
end;

// The name of type ATypeId in the module at ABase (TI_GET_SYMNAME, its text freed); "" when
// the type has none
public routine SymTypeName(const AProcess: uint64; const ABase: uint64;
  const ATypeId: uint32): string;
var
  LText: ptr to uint16;
  LName: string;
begin
  LText := nil;
  if SymGetTypeInfo(AProcess, ABase, ATypeId, TI_GET_SYMNAME,
    ptr(addr of LText)) = 0 then
    return "";
  end;
  LName := DbgWideText(LText);
  LocalFree(ptr(LText));
  return LName;
end;

end.
