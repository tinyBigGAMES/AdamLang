-------------------------------------------------------------------------------
  System.Base64.adam - Base64 (RFC 4648 sec 4, the standard alphabet with
  '=' padding), written in Adam: bytes or text to Base64 text and back.

  Encoding writes the padded form on one line. Decoding takes what mail,
  PEM files and data URLs carry: whitespace between characters is
  skipped, the padding may be left off; anything else outside the
  alphabet, a '=' before the end, or a lone last character (6 bits: no
  byte) makes it fail, so a decode never guesses.

  Target-neutral (PROJECT AT.3): pure Adam, the same text on every target.
*******************************************************************************/

module unit System.Base64;

import System.SysUtils;

const
  // The standard alphabet (RFC 4648 Table 1), a digit's value its index
  ADAM_BASE64_DIGITS: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  // DoDigitValue's answer for a byte outside the alphabet
  ADAM_BASE64_NOT_DIGIT: int32 = -1;

// ACount bytes at AData as Base64 text, padded with '='
func DoEncode(const AData: ptr to const uint8; const ACount: int64): string;
var
  LText: string;
  LGroup: uint32;
  LLeft: int64;
  LAt: int64;
  LI: int64;
begin
  LText := "";
  // Every 3 bytes (a cut last group included) are 4 characters
  setlength(LText, ((ACount + 2) div 3) * 4);
  LAt := 0;
  LI := 0;
  while LI < ACount do
    LLeft := ACount - LI;
    LGroup := uint32(AData[LI]) shl 16;
    if LLeft > 1 then
      LGroup := LGroup | (uint32(AData[LI + 1]) shl 8);
    end;
    if LLeft > 2 then
      LGroup := LGroup | uint32(AData[LI + 2]);
    end;
    LText[LAt] := ADAM_BASE64_DIGITS[int64((LGroup shr 18) & 0x3F)];
    LText[LAt + 1] := ADAM_BASE64_DIGITS[int64((LGroup shr 12) & 0x3F)];
    // A group of 1 byte has 2 digits + "==", of 2 bytes 3 digits + "="
    if LLeft > 1 then
      LText[LAt + 2] := ADAM_BASE64_DIGITS[int64((LGroup shr 6) & 0x3F)];
    else
      LText[LAt + 2] := '=';
    end;
    if LLeft > 2 then
      LText[LAt + 3] := ADAM_BASE64_DIGITS[int64(LGroup & 0x3F)];
    else
      LText[LAt + 3] := '=';
    end;
    LAt := LAt + 4;
    LI := LI + 3;
  end;
  return LText;
end;

// The value (0..63) of the alphabet's character AChar, ADAM_BASE64_NOT_DIGIT for any other
func DoDigitValue(const AChar: char): int32;
begin
  match AChar of
    'A'..'Z':
      return int32(uint8(AChar)) - int32(uint8('A'));
    'a'..'z':
      return int32(uint8(AChar)) - int32(uint8('a')) + 26;
    '0'..'9':
      return int32(uint8(AChar)) - int32(uint8('0')) + 52;
    '+':
      return 62;
    '/':
      return 63;
  else
    return ADAM_BASE64_NOT_DIGIT;
  end;
end;

// True for the whitespace a decode skips: space, tab, CR, LF
func DoIsSpace(const AChar: char): bool;
begin
  return (AChar = ' ') or (AChar = '\t') or (AChar = '\r') or (AChar = '\n');
end;

// AText decoded into ABytes (the rules in this unit's header); false, ABytes empty, when it
// is not Base64
func DoDecode(const AText: string; var ABytes: ByteArray): bool;
var
  LGroup: uint32;
  LDigits: int64;
  LPads: int64;
  LCount: int64;
  LValue: int32;
  LI: int64;
begin
  setlength(ABytes, 0);
  // At most 3 bytes for each 4 characters: sized once, cut to what was written at the end
  setlength(ABytes, ((len(AText) + 3) div 4) * 3);
  LGroup := 0;
  LDigits := 0;
  LPads := 0;
  LCount := 0;
  for LI := 0 to len(AText) - 1 do
    if not DoIsSpace(AText[LI]) then
      if AText[LI] = '=' then
        // Padding only ends a group of 2 or 3 digits, and nothing but more padding follows
        if (LDigits < 2) or (LDigits + LPads >= 4) then
          setlength(ABytes, 0);
          return false;
        end;
        LPads := LPads + 1;
      else
        LValue := DoDigitValue(AText[LI]);
        if (LValue = ADAM_BASE64_NOT_DIGIT) or (LPads > 0) then
          setlength(ABytes, 0);
          return false;
        end;
        LGroup := (LGroup shl 6) | uint32(LValue);
        LDigits := LDigits + 1;
        if LDigits = 4 then
          ABytes[LCount] := uint8((LGroup shr 16) & 0xFF);
          ABytes[LCount + 1] := uint8((LGroup shr 8) & 0xFF);
          ABytes[LCount + 2] := uint8(LGroup & 0xFF);
          LCount := LCount + 3;
          LGroup := 0;
          LDigits := 0;
        end;
      end;
    end;
  end;
  // A cut last group: 2 digits are 1 byte, 3 digits 2 bytes; 1 digit holds no byte
  if LDigits = 1 then
    setlength(ABytes, 0);
    return false;
  end;
  if LDigits = 2 then
    ABytes[LCount] := uint8((LGroup shr 4) & 0xFF);
    LCount := LCount + 1;
  end;
  if LDigits = 3 then
    ABytes[LCount] := uint8((LGroup shr 10) & 0xFF);
    ABytes[LCount + 1] := uint8((LGroup shr 2) & 0xFF);
    LCount := LCount + 2;
  end;
  // Padding with nothing to pad (a whole last group) is not Base64
  if (LPads > 0) and (LDigits = 0) then
    setlength(ABytes, 0);
    return false;
  end;
  setlength(ABytes, LCount);
  return true;
end;

/// `ABytes` as Base64 text (the standard alphabet, padded with `=`, one line).
/// @param ABytes the bytes (empty gives "")
/// @returns the Base64 text
/// @example `Base64Encode(LPng)` for a `data:image/png;base64,` URL
public func cpplink Base64Encode(const ABytes: ByteArray): string;
begin
  if len(ABytes) = 0 then
    return "";
  end;
  return DoEncode(addr of ABytes[0], len(ABytes));
end;

/// The UTF-8 bytes of `AText` as Base64 text.
/// @param AText the text ("" gives "")
/// @returns the Base64 text
/// @example `Base64Encode("Adam")` is `"QWRhbQ=="`
public func cpplink Base64Encode(const AText: string): string;
begin
  if len(AText) = 0 then
    return "";
  end;
  return DoEncode(ptr to const uint8(addr of AText[0]), len(AText));
end;

/// Base64 text decoded to bytes: whitespace skipped, padding optional; anything else outside
/// the standard alphabet, a `=` before the end or a lone last character fails.
/// @param AText the Base64 text ("" decodes to no bytes)
/// @param ABytes the bytes it holds (empty on a failure)
/// @returns true when `AText` is Base64
/// @example `if Base64Decode(LField, LBytes) then WriteAllBytes("icon.png", LBytes); end;`
public func cpplink Base64Decode(const AText: string; var ABytes: ByteArray): bool;
begin
  return DoDecode(AText, ABytes);
end;

/// Base64 text decoded to text: its bytes taken as they are (UTF-8 when they were text).
/// @param AText the Base64 text
/// @param ADecoded the text it holds ("" on a failure)
/// @returns true when `AText` is Base64
/// @example `Base64Decode("QWRhbQ==", LName)` gives `"Adam"`
public func cpplink Base64Decode(const AText: string; var ADecoded: string): bool;
var
  LBytes: ByteArray;
  LI: int64;
begin
  ADecoded := "";
  if not DoDecode(AText, LBytes) then
    return false;
  end;
  setlength(ADecoded, len(LBytes));
  for LI := 0 to len(LBytes) - 1 do
    ADecoded[LI] := char(LBytes[LI]);
  end;
  return true;
end;

end.
