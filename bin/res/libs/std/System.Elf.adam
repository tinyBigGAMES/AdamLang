-------------------------------------------------------------------------------
  System.Elf.adam - the ELF file format's own names (elf.h), each once (AD.5a)

  The constants of the ELF64 object, executable and shared object formats
  and of the x86_64 psABI's relocations, in elf.h's own names and values
  (glibc's elf.h; every value checked against it), each in the type of the
  field it goes in: e_ident's bytes, e_type / e_machine, sh_type / sh_flags,
  the special section indices, a symbol's binding / type / visibility, the
  section group flag, the x86_64 relocation types, p_type / p_flags,
  d_tag and the dynamic flags. Adam's ELF format part (Adam.Elf.*) writes
  and reads them; a later linux runtime or tool imports them from here,
  never declaring one again. No routine, no record: the layouts are written
  byte by byte by their users. Target-neutral (an ELF file is made on any
  host), imports nothing.
*******************************************************************************/

module unit System.Elf;

public const
  // e_ident: its size, the magic bytes, and the values of its class, data, version and
  // OS / ABI bytes at their indices
  EI_NIDENT: int32 = 16;
  ELFMAG0: uint8 = 0x7F;
  ELFMAG1: uint8 = 0x45;
  ELFMAG2: uint8 = 0x4C;
  ELFMAG3: uint8 = 0x46;
  EI_CLASS: int32 = 4;
  EI_DATA: int32 = 5;
  EI_VERSION: int32 = 6;
  EI_OSABI: int32 = 7;
  EI_ABIVERSION: int32 = 8;
  ELFCLASS64: uint8 = 2;
  ELFDATA2LSB: uint8 = 1;
  ELFOSABI_SYSV: uint8 = 0;
  EV_CURRENT: uint32 = 1;

  // e_type and e_machine
  ET_NONE: uint16 = 0;
  ET_REL: uint16 = 1;
  ET_EXEC: uint16 = 2;
  ET_DYN: uint16 = 3;
  EM_X86_64: uint16 = 0x3E;

  // sh_type
  SHT_NULL: uint32 = 0;
  SHT_PROGBITS: uint32 = 1;
  SHT_SYMTAB: uint32 = 2;
  SHT_STRTAB: uint32 = 3;
  SHT_RELA: uint32 = 4;
  SHT_HASH: uint32 = 5;
  SHT_DYNAMIC: uint32 = 6;
  SHT_NOTE: uint32 = 7;
  SHT_NOBITS: uint32 = 8;
  SHT_REL: uint32 = 9;
  SHT_DYNSYM: uint32 = 11;
  SHT_INIT_ARRAY: uint32 = 14;
  SHT_FINI_ARRAY: uint32 = 15;
  SHT_PREINIT_ARRAY: uint32 = 16;
  SHT_GROUP: uint32 = 17;
  SHT_SYMTAB_SHNDX: uint32 = 18;
  SHT_GNU_HASH: uint32 = 0x6FFFFFF6;
  SHT_GNU_verdef: uint32 = 0x6FFFFFFD;
  SHT_GNU_verneed: uint32 = 0x6FFFFFFE;
  SHT_GNU_versym: uint32 = 0x6FFFFFFF;
  SHT_X86_64_UNWIND: uint32 = 0x70000001;

  // sh_flags
  SHF_WRITE: uint64 = 0x1;
  SHF_ALLOC: uint64 = 0x2;
  SHF_EXECINSTR: uint64 = 0x4;
  SHF_MERGE: uint64 = 0x10;
  SHF_STRINGS: uint64 = 0x20;
  SHF_INFO_LINK: uint64 = 0x40;
  SHF_LINK_ORDER: uint64 = 0x80;
  SHF_GROUP: uint64 = 0x200;
  SHF_TLS: uint64 = 0x400;
  SHF_COMPRESSED: uint64 = 0x800;
  SHF_EXCLUDE: uint64 = 0x80000000;

  // A section group's flag word: a COMDAT group
  GRP_COMDAT: uint32 = 0x1;

  // The special section indices (st_shndx, e_shstrndx)
  SHN_UNDEF: uint16 = 0;
  SHN_LORESERVE: uint16 = 0xFF00;
  SHN_ABS: uint16 = 0xFFF1;
  SHN_COMMON: uint16 = 0xFFF2;
  SHN_XINDEX: uint16 = 0xFFFF;

  // st_info: a symbol's binding (its high 4 bits) and type (its low 4); st_other: its
  // visibility (the low 2 bits)
  STB_LOCAL: uint8 = 0;
  STB_GLOBAL: uint8 = 1;
  STB_WEAK: uint8 = 2;
  STB_GNU_UNIQUE: uint8 = 10;
  STT_NOTYPE: uint8 = 0;
  STT_OBJECT: uint8 = 1;
  STT_FUNC: uint8 = 2;
  STT_SECTION: uint8 = 3;
  STT_FILE: uint8 = 4;
  STT_COMMON: uint8 = 5;
  STT_TLS: uint8 = 6;
  STT_GNU_IFUNC: uint8 = 10;
  STV_DEFAULT: uint8 = 0;
  STV_INTERNAL: uint8 = 1;
  STV_HIDDEN: uint8 = 2;
  STV_PROTECTED: uint8 = 3;

  // The x86_64 relocation types (r_info's low 32 bits)
  R_X86_64_NONE: uint32 = 0;
  R_X86_64_64: uint32 = 1;
  R_X86_64_PC32: uint32 = 2;
  R_X86_64_GOT32: uint32 = 3;
  R_X86_64_PLT32: uint32 = 4;
  R_X86_64_COPY: uint32 = 5;
  R_X86_64_GLOB_DAT: uint32 = 6;
  R_X86_64_JUMP_SLOT: uint32 = 7;
  R_X86_64_RELATIVE: uint32 = 8;
  R_X86_64_GOTPCREL: uint32 = 9;
  R_X86_64_32: uint32 = 10;
  R_X86_64_32S: uint32 = 11;
  R_X86_64_16: uint32 = 12;
  R_X86_64_PC16: uint32 = 13;
  R_X86_64_8: uint32 = 14;
  R_X86_64_PC8: uint32 = 15;
  R_X86_64_DTPMOD64: uint32 = 16;
  R_X86_64_DTPOFF64: uint32 = 17;
  R_X86_64_TPOFF64: uint32 = 18;
  R_X86_64_TLSGD: uint32 = 19;
  R_X86_64_TLSLD: uint32 = 20;
  R_X86_64_DTPOFF32: uint32 = 21;
  R_X86_64_GOTTPOFF: uint32 = 22;
  R_X86_64_TPOFF32: uint32 = 23;
  R_X86_64_PC64: uint32 = 24;
  R_X86_64_GOTOFF64: uint32 = 25;
  R_X86_64_GOTPC32: uint32 = 26;
  R_X86_64_SIZE32: uint32 = 32;
  R_X86_64_SIZE64: uint32 = 33;
  R_X86_64_GOTPC32_TLSDESC: uint32 = 34;
  R_X86_64_TLSDESC_CALL: uint32 = 35;
  R_X86_64_TLSDESC: uint32 = 36;
  R_X86_64_IRELATIVE: uint32 = 37;
  R_X86_64_RELATIVE64: uint32 = 38;
  R_X86_64_GOTPCRELX: uint32 = 41;
  R_X86_64_REX_GOTPCRELX: uint32 = 42;

  // p_type and p_flags
  PT_NULL: uint32 = 0;
  PT_LOAD: uint32 = 1;
  PT_DYNAMIC: uint32 = 2;
  PT_INTERP: uint32 = 3;
  PT_NOTE: uint32 = 4;
  PT_PHDR: uint32 = 6;
  PT_TLS: uint32 = 7;
  PT_GNU_EH_FRAME: uint32 = 0x6474E550;
  PT_GNU_STACK: uint32 = 0x6474E551;
  PT_GNU_RELRO: uint32 = 0x6474E552;
  PT_GNU_PROPERTY: uint32 = 0x6474E553;
  PF_X: uint32 = 0x1;
  PF_W: uint32 = 0x2;
  PF_R: uint32 = 0x4;

  // d_tag
  DT_NULL: int64 = 0;
  DT_NEEDED: int64 = 1;
  DT_PLTRELSZ: int64 = 2;
  DT_PLTGOT: int64 = 3;
  DT_HASH: int64 = 4;
  DT_STRTAB: int64 = 5;
  DT_SYMTAB: int64 = 6;
  DT_RELA: int64 = 7;
  DT_RELASZ: int64 = 8;
  DT_RELAENT: int64 = 9;
  DT_STRSZ: int64 = 10;
  DT_SYMENT: int64 = 11;
  DT_INIT: int64 = 12;
  DT_FINI: int64 = 13;
  DT_SONAME: int64 = 14;
  DT_RPATH: int64 = 15;
  DT_SYMBOLIC: int64 = 16;
  DT_PLTREL: int64 = 20;
  DT_DEBUG: int64 = 21;
  DT_TEXTREL: int64 = 22;
  DT_JMPREL: int64 = 23;
  DT_BIND_NOW: int64 = 24;
  DT_INIT_ARRAY: int64 = 25;
  DT_FINI_ARRAY: int64 = 26;
  DT_INIT_ARRAYSZ: int64 = 27;
  DT_FINI_ARRAYSZ: int64 = 28;
  DT_RUNPATH: int64 = 29;
  DT_FLAGS: int64 = 30;
  DT_PREINIT_ARRAY: int64 = 32;
  DT_PREINIT_ARRAYSZ: int64 = 33;
  DT_GNU_HASH: int64 = 0x6FFFFEF5;
  DT_VERSYM: int64 = 0x6FFFFFF0;
  DT_RELACOUNT: int64 = 0x6FFFFFF9;
  DT_FLAGS_1: int64 = 0x6FFFFFFB;
  DT_VERNEED: int64 = 0x6FFFFFFE;
  DT_VERNEEDNUM: int64 = 0x6FFFFFFF;

  // DT_FLAGS / DT_FLAGS_1 bits, the version records' values
  DF_ORIGIN: uint64 = 0x1;
  DF_SYMBOLIC: uint64 = 0x2;
  DF_TEXTREL: uint64 = 0x4;
  DF_BIND_NOW: uint64 = 0x8;
  DF_STATIC_TLS: uint64 = 0x10;
  DF_1_NOW: uint64 = 0x1;
  DF_1_ORIGIN: uint64 = 0x80;
  DF_1_PIE: uint64 = 0x08000000;
  VER_NEED_CURRENT: uint16 = 1;
  VER_FLG_WEAK: uint16 = 0x2;
end.
