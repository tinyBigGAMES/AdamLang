// The query family: a virtual path answered as fopen would find it (DoAccess / DoStat),
// anything else glibc's. glibc before 2.33 has no stat / stat64 / lstat / lstat64 symbol (C
// reached them through __xstat and its kin, _STAT_VER 1): the real call falls back on those
public routine access(const APath: ptr to const char; const AMode: int32): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: AccessFn;
begin
  if DoAccess(APath, AMode, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealAccess, ptr to const char("access"));
  if LFound = nil then
    return -1;
  end;
  LReal := AccessFn(LFound);
  return LReal(APath, AMode);
end;

// The real stat-like call AName on APath, else its __xstat-like AOldName with _STAT_VER
routine DoRealStat(const APath: ptr to const char; const ABuf: ptr; var ASlot: ptr;
  const AName: ptr to const char; var AOldSlot: ptr; const AOldName: ptr to const char): int32;
var
  LFound: ptr;
  LStat: StatFn;
  LXstat: XstatFn;
begin
  LFound := HookReal(ASlot, AName);
  if LFound <> nil then
    LStat := StatFn(LFound);
    return LStat(APath, ABuf);
  end;
  LFound := DoReal(AOldSlot, AOldName);
  if LFound = nil then
    return -1;
  end;
  LXstat := XstatFn(LFound);
  return LXstat(_STAT_VER, APath, ABuf);
end;
public routine stat(const APath: ptr to const char; const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoStat(APath, ABuf, LResult) then
    return LResult;
  end;
  return DoRealStat(APath, ABuf, GRealStat, ptr to const char("stat"), GRealXstat,
    ptr to const char("__xstat"));
end;
public routine stat64(const APath: ptr to const char; const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoStat(APath, ABuf, LResult) then
    return LResult;
  end;
  return DoRealStat(APath, ABuf, GRealStat64, ptr to const char("stat64"), GRealXstat64,
    ptr to const char("__xstat64"));
end;
public routine lstat(const APath: ptr to const char; const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoStat(APath, ABuf, LResult) then
    return LResult;
  end;
  return DoRealStat(APath, ABuf, GRealLstat, ptr to const char("lstat"), GRealLxstat,
    ptr to const char("__lxstat"));
end;
public routine lstat64(const APath: ptr to const char; const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoStat(APath, ABuf, LResult) then
    return LResult;
  end;
  return DoRealStat(APath, ABuf, GRealLstat64, ptr to const char("lstat64"), GRealLxstat64,
    ptr to const char("__lxstat64"));
end;

// The real __xstat-like call AName with AVersion
routine DoRealXstat(const AVersion: int32; const APath: ptr to const char; const ABuf: ptr;
  var ASlot: ptr; const AName: ptr to const char): int32;
var
  LFound: ptr;
  LXstat: XstatFn;
begin
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LXstat := XstatFn(LFound);
  return LXstat(AVersion, APath, ABuf);
end;
public routine __xstat(const AVersion: int32; const APath: ptr to const char; const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoStat(APath, ABuf, LResult) then
    return LResult;
  end;
  return DoRealXstat(AVersion, APath, ABuf, GRealXstat, ptr to const char("__xstat"));
end;
public routine __xstat64(const AVersion: int32; const APath: ptr to const char;
  const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoStat(APath, ABuf, LResult) then
    return LResult;
  end;
  return DoRealXstat(AVersion, APath, ABuf, GRealXstat64, ptr to const char("__xstat64"));
end;
public routine __lxstat(const AVersion: int32; const APath: ptr to const char; const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoStat(APath, ABuf, LResult) then
    return LResult;
  end;
  return DoRealXstat(AVersion, APath, ABuf, GRealLxstat, ptr to const char("__lxstat"));
end;
public routine __lxstat64(const AVersion: int32; const APath: ptr to const char;
  const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoStat(APath, ABuf, LResult) then
    return LResult;
  end;
  return DoRealXstat(AVersion, APath, ABuf, GRealLxstat64, ptr to const char("__lxstat64"));
end;

// The descriptor family: a handle's descriptor (fileno's, or a hooked open's of a virtual path:
// DoFdOpen) runs on the handle (the DoFd* calls), anything else is glibc's. glibc before 2.33
// has no fstat / fstat64 symbol (C reached them through __fxstat and its kin, _STAT_VER 1): the
// real call falls back on those, as the stat family's does

// The real open-like call AName (ASlot its slot): -1 with ENOSYS when glibc has none
routine DoRealOpen(const APath: ptr to const char; const AFlags: int32; const AMode: uint32;
  var ASlot: ptr; const AName: ptr to const char): int32;
var
  LFound: ptr;
  LOpen: OpenFn;
begin
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LOpen := OpenFn(LFound);
  return LOpen(APath, AFlags, AMode);
end;

// open / open64 (the same on a 64-bit target): the mode after the flags is read only with
// O_CREAT or O_TMPFILE, as glibc's open reads it
public routine open(const APath: ptr to const char; const AFlags: int32; ...): int32;
var
  LResult: int32;
  LMode: int32;
begin
  LMode := 0;
  if ((AFlags & O_CREAT) <> 0) or ((AFlags & O_TMPFILE) = O_TMPFILE) then
    LMode := varargs.next(int32);
  end;
  if DoFdOpen(APath, AFlags, LResult) then
    return LResult;
  end;
  return DoRealOpen(APath, AFlags, uint32(LMode), GRealOpen, ptr to const char("open"));
end;
public routine open64(const APath: ptr to const char; const AFlags: int32; ...): int32;
var
  LResult: int32;
  LMode: int32;
begin
  LMode := 0;
  if ((AFlags & O_CREAT) <> 0) or ((AFlags & O_TMPFILE) = O_TMPFILE) then
    LMode := varargs.next(int32);
  end;
  if DoFdOpen(APath, AFlags, LResult) then
    return LResult;
  end;
  return DoRealOpen(APath, AFlags, uint32(LMode), GRealOpen64,
    ptr to const char("open64"));
end;

// The real __open_2-like call AName (ASlot its slot): -1 with ENOSYS when glibc has none
routine DoRealOpen2(const APath: ptr to const char; const AFlags: int32; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LFound: ptr;
  LOpen: Open2Fn;
begin
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LOpen := Open2Fn(LFound);
  return LOpen(APath, AFlags);
end;

// __open_2 / __open64_2 (_FORTIFY_SOURCE's open with no mode): O_CREAT or O_TMPFILE goes to
// glibc's, which ends the program as a fortify failure before it looks at the path
public routine __open_2(const APath: ptr to const char; const AFlags: int32): int32;
var
  LResult: int32;
begin
  if (((AFlags & O_CREAT) = 0) and ((AFlags & O_TMPFILE) <> O_TMPFILE)) and
    DoFdOpen(APath, AFlags, LResult) then
    return LResult;
  end;
  return DoRealOpen2(APath, AFlags, GRealOpen2, ptr to const char("__open_2"));
end;
public routine __open64_2(const APath: ptr to const char; const AFlags: int32): int32;
var
  LResult: int32;
begin
  if (((AFlags & O_CREAT) = 0) and ((AFlags & O_TMPFILE) <> O_TMPFILE)) and
    DoFdOpen(APath, AFlags, LResult) then
    return LResult;
  end;
  return DoRealOpen2(APath, AFlags, GRealOpen64Of2, ptr to const char("__open64_2"));
end;

public routine read(const AFile: int32; const ABuffer: ptr; const ACount: uint64): int64;
var
  LHandle: ptr to HookHandle;
  LClosed: bool;
  LAnswer: int64;
  LFound: ptr;
  LRead: FdReadFn;
begin
  LHandle := DoFindDescriptor(AFile, LClosed);
  if LHandle <> nil then
    LAnswer := DoFdRead(LHandle, LClosed, ABuffer, ACount, false, 0);
    DoReleaseHandle(LHandle);
    return LAnswer;
  end;
  LFound := DoReal(GRealRead, ptr to const char("read"));
  if LFound = nil then
    return -1;
  end;
  LRead := FdReadFn(LFound);
  return LRead(AFile, ABuffer, ACount);
end;

// __read_chk (_FORTIFY_SOURCE's read): a count past the buffer's size ends the program
public routine __read_chk(const AFile: int32; const ABuffer: ptr; const ACount: uint64;
  const ABufferSize: uint64): int64;
var
  LHandle: ptr to HookHandle;
  LClosed: bool;
  LAnswer: int64;
  LFound: ptr;
  LRead: FdReadChkFn;
begin
  if ACount > ABufferSize then
    __chk_fail();
  end;
  LHandle := DoFindDescriptor(AFile, LClosed);
  if LHandle <> nil then
    LAnswer := DoFdRead(LHandle, LClosed, ABuffer, ACount, false, 0);
    DoReleaseHandle(LHandle);
    return LAnswer;
  end;
  LFound := DoReal(GRealReadChk, ptr to const char("__read_chk"));
  if LFound = nil then
    return -1;
  end;
  LRead := FdReadChkFn(LFound);
  return LRead(AFile, ABuffer, ACount, ABufferSize);
end;

// The real pread-like call AName (ASlot its slot): -1 with ENOSYS when glibc has none
routine DoRealPread(const AFile: int32; const ABuffer: ptr; const ACount: uint64;
  const AOffset: int64; var ASlot: ptr; const AName: ptr to const char): int64;
var
  LFound: ptr;
  LRead: FdPreadFn;
begin
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LRead := FdPreadFn(LFound);
  return LRead(AFile, ABuffer, ACount, AOffset);
end;

// pread / pread64 (the same on a 64-bit target)
public routine pread(const AFile: int32; const ABuffer: ptr; const ACount: uint64;
  const AOffset: int64): int64;
var
  LHandle: ptr to HookHandle;
  LClosed: bool;
  LAnswer: int64;
begin
  LHandle := DoFindDescriptor(AFile, LClosed);
  if LHandle <> nil then
    LAnswer := DoFdRead(LHandle, LClosed, ABuffer, ACount, true, AOffset);
    DoReleaseHandle(LHandle);
    return LAnswer;
  end;
  return DoRealPread(AFile, ABuffer, ACount, AOffset, GRealPread, ptr to const char("pread"));
end;
public routine pread64(const AFile: int32; const ABuffer: ptr; const ACount: uint64;
  const AOffset: int64): int64;
var
  LHandle: ptr to HookHandle;
  LClosed: bool;
  LAnswer: int64;
begin
  LHandle := DoFindDescriptor(AFile, LClosed);
  if LHandle <> nil then
    LAnswer := DoFdRead(LHandle, LClosed, ABuffer, ACount, true, AOffset);
    DoReleaseHandle(LHandle);
    return LAnswer;
  end;
  return DoRealPread(AFile, ABuffer, ACount, AOffset, GRealPread64, ptr to const char("pread64"));
end;

// The real __pread_chk-like call AName (ASlot its slot): -1 with ENOSYS when glibc has none
routine DoRealPreadChk(const AFile: int32; const ABuffer: ptr; const ACount: uint64;
  const AOffset: int64; const ABufferSize: uint64; var ASlot: ptr;
  const AName: ptr to const char): int64;
var
  LFound: ptr;
  LRead: FdPreadChkFn;
begin
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LRead := FdPreadChkFn(LFound);
  return LRead(AFile, ABuffer, ACount, AOffset, ABufferSize);
end;

// __pread_chk / __pread64_chk (_FORTIFY_SOURCE's pread): a count past the buffer's size ends
// the program
public routine __pread_chk(const AFile: int32; const ABuffer: ptr; const ACount: uint64;
  const AOffset: int64; const ABufferSize: uint64): int64;
var
  LHandle: ptr to HookHandle;
  LClosed: bool;
  LAnswer: int64;
begin
  if ACount > ABufferSize then
    __chk_fail();
  end;
  LHandle := DoFindDescriptor(AFile, LClosed);
  if LHandle <> nil then
    LAnswer := DoFdRead(LHandle, LClosed, ABuffer, ACount, true, AOffset);
    DoReleaseHandle(LHandle);
    return LAnswer;
  end;
  return DoRealPreadChk(AFile, ABuffer, ACount, AOffset, ABufferSize, GRealPreadChk,
    ptr to const char("__pread_chk"));
end;
public routine __pread64_chk(const AFile: int32; const ABuffer: ptr; const ACount: uint64;
  const AOffset: int64; const ABufferSize: uint64): int64;
var
  LHandle: ptr to HookHandle;
  LClosed: bool;
  LAnswer: int64;
begin
  if ACount > ABufferSize then
    __chk_fail();
  end;
  LHandle := DoFindDescriptor(AFile, LClosed);
  if LHandle <> nil then
    LAnswer := DoFdRead(LHandle, LClosed, ABuffer, ACount, true, AOffset);
    DoReleaseHandle(LHandle);
    return LAnswer;
  end;
  return DoRealPreadChk(AFile, ABuffer, ACount, AOffset, ABufferSize, GRealPread64Chk,
    ptr to const char("__pread64_chk"));
end;

