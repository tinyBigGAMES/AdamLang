// fgetws and fgetws_unlocked: up to ACount - 1 characters, to and with a newline
public routine fgetws(const AText: ptr to uint32; const ACount: int32; const AFile: ptr): ptr to uint32;
begin
  return DoGetsWide(AText, ACount, AFile, GRealFgetws, ptr to const char("fgetws"));
end;
public routine fgetws_unlocked(const AText: ptr to uint32; const ACount: int32;
  const AFile: ptr): ptr to uint32;
begin
  return DoGetsWide(AText, ACount, AFile, GRealFgetwsUnlocked, ptr to const char("fgetws_unlocked"));
end;

// A fortified fgetws on a handle (fgetws_chk.c): as DoGetsChk, ASize in characters
routine DoGetsWideChk(const AText: ptr to uint32; const ASize: uint64; const ACount: int32;
  const AFile: ptr; var AResult: ptr to uint32): bool;
var
  LCall: HookCall;
begin
  AResult := nil;
  if not DoOwns(AFile) then
    return false;
  end;
  if ACount <= 0 then
    return true;
  end;
  LCall := DoCall(HookOp.GetsWide, 0);
  LCall.Wide := AText;
  LCall.Size := int64(ACount);
  LCall.ItemSize := int64(ASize);
  LCall.Origin := 1;
  if not DoWith(AFile, LCall) then
    return false;
  end;
  if LCall.Answer < 0 then
    __chk_fail();
  end;
  if LCall.Answer <> 0 then
    AResult := AText;
  end;
  return true;
end;
public routine __fgetws_chk(const AText: ptr to uint32; const ASize: uint64; const ACount: int32;
  const AFile: ptr): ptr to uint32;
var
  LResult: ptr to uint32;
  LFound: ptr;
  LReal: FgetwsChkFn;
begin
  if DoGetsWideChk(AText, ASize, ACount, AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFgetwsChk, ptr to const char("__fgetws_chk"));
  if LFound = nil then
    return nil;
  end;
  LReal := FgetwsChkFn(LFound);
  return LReal(AText, ASize, ACount, AFile);
end;
public routine __fgetws_unlocked_chk(const AText: ptr to uint32; const ASize: uint64;
  const ACount: int32; const AFile: ptr): ptr to uint32;
var
  LResult: ptr to uint32;
  LFound: ptr;
  LReal: FgetwsChkFn;
begin
  if DoGetsWideChk(AText, ASize, ACount, AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFgetwsUnlockedChk, ptr to const char("__fgetws_unlocked_chk"));
  if LFound = nil then
    return nil;
  end;
  LReal := FgetwsChkFn(LFound);
  return LReal(AText, ASize, ACount, AFile);
end;

