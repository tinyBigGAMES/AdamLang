// The real lseek-like call AName (ASlot its slot): -1 with ENOSYS when glibc has none
routine DoRealLseek(const AFile: int32; const AOffset: int64; const AWhence: int32;
  var ASlot: ptr; const AName: ptr to const char): int64;
var
  LFound: ptr;
  LSeek: LseekFn;
begin
