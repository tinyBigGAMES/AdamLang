// The real mmap-like call AName (ASlot its slot): MAP_FAILED with ENOSYS when glibc has none
routine DoRealMmap(const AAddress: ptr; const ALength: uint64; const AProt: int32;
  const AFlags: int32; const AFile: int32; const AOffset: int64; var ASlot: ptr;
  const AName: ptr to const char): ptr;
var
  LFound: ptr;
  LMap: MmapFn;
begin
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return ptr(ADAM_HOOKIO_MAP_FAILED);
  end;
  LMap := MmapFn(LFound);
  return LMap(AAddress, ALength, AProt, AFlags, AFile, AOffset);
end;

// mmap / mmap64 (the same on a 64-bit target); munmap and mprotect stay glibc's (a handle's
// mapping is an anonymous one)
public routine mmap(const AAddress: ptr; const ALength: uint64; const AProt: int32;
  const AFlags: int32; const AFile: int32; const AOffset: int64): ptr;
var
  LResult: ptr;
begin
  if DoFdMap(AAddress, ALength, AProt, AFlags, AFile, AOffset, LResult) then
    return LResult;
  end;
  return DoRealMmap(AAddress, ALength, AProt, AFlags, AFile, AOffset, GRealMmap,
    ptr to const char("mmap"));
end;
public routine mmap64(const AAddress: ptr; const ALength: uint64; const AProt: int32;
  const AFlags: int32; const AFile: int32; const AOffset: int64): ptr;
var
  LResult: ptr;
begin
  if DoFdMap(AAddress, ALength, AProt, AFlags, AFile, AOffset, LResult) then
    return LResult;
  end;
  return DoRealMmap(AAddress, ALength, AProt, AFlags, AFile, AOffset, GRealMmap64,
    ptr to const char("mmap64"));
end;

public routine close(const AFile: int32): int32;
var
  LAnswer: int32;
  LFound: ptr;
  LClose: FdIntFn;
begin
  if DoFdClose(AFile, LAnswer) then
    return LAnswer;
  end;
  LFound := DoReal(GRealClose, ptr to const char("close"));
  if LFound = nil then
    return -1;
  end;
  LClose := FdIntFn(LFound);
  return LClose(AFile);
end;

// dup / dup2 / dup3: a copy of a handle's number is another number on its description (shared
// place and rights, as the kernel's); a copy onto a handle's number takes it over
public routine dup(const AFile: int32): int32;
var
  LResult: int32;
  LFound: ptr;
  LDup: FdIntFn;
begin
  if DoFdCopy(AFile, 0, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealDup, ptr to const char("dup"));
  if LFound = nil then
    return -1;
  end;
  LDup := FdIntFn(LFound);
  return LDup(AFile);
end;
public routine dup2(const AFile: int32; const ATarget: int32): int32;
var
  LResult: int32;
begin
  if DoFdCopyTo(AFile, ATarget, false, 0, LResult) then
    return LResult;
  end;
  return DoRealCopyTo(AFile, ATarget, false, 0);
end;
public routine dup3(const AFile: int32; const ATarget: int32; const AFlags: int32): int32;
var
  LResult: int32;
begin
  if DoFdCopyTo(AFile, ATarget, true, AFlags, LResult) then
    return LResult;
  end;
  return DoRealCopyTo(AFile, ATarget, true, AFlags);
end;

// The real fcntl-like call AName (ASlot its slot) with AArg: -1 with ENOSYS when glibc has none
routine DoRealFcntl(const AFile: int32; const ACommand: int32; const AArg: uint64;
  var ASlot: ptr; const AName: ptr to const char): int32;
var
  LFound: ptr;
  LFcntl: FcntlFn;
begin
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LFcntl := FcntlFn(LFound);
  return LFcntl(AFile, ACommand, AArg);
end;

// fcntl / fcntl64 (the same on a 64-bit target): the one argument after the command is read as
// a register's word (an int or a pointer, as glibc's own fcntl reads it)
public routine fcntl(const AFile: int32; const ACommand: int32; ...): int32;
var
  LArg: uint64;
  LResult: int32;
begin
  LArg := varargs.next(uint64);
  if DoFdControl(AFile, ACommand, LArg, LResult) then
    return LResult;
  end;
  return DoRealFcntl(AFile, ACommand, LArg, GRealFcntl, ptr to const char("fcntl"));
end;
public routine fcntl64(const AFile: int32; const ACommand: int32; ...): int32;
var
  LArg: uint64;
  LResult: int32;
begin
  LArg := varargs.next(uint64);
  if DoFdControl(AFile, ACommand, LArg, LResult) then
    return LResult;
  end;
  return DoRealFcntl(AFile, ACommand, LArg, GRealFcntl64, ptr to const char("fcntl64"));
end;

// fdopen of a handle's number: a FILE on its description (DoFdStream)
public routine fdopen(const AFile: int32; const AMode: ptr to const char): ptr;
var
  LResult: ptr;
  LFound: ptr;
  LOpen: FdopenFn;
begin
  if DoFdStream(AFile, AMode, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFdopen, ptr to const char("fdopen"));
  if LFound = nil then
    return nil;
  end;
  LOpen := FdopenFn(LFound);
  return LOpen(AFile, AMode);
end;

// The real fstat-like call AName on AFile, else its __fxstat-like AOldName with _STAT_VER
routine DoRealFstat(const AFile: int32; const ABuf: ptr; var ASlot: ptr;
  const AName: ptr to const char; var AOldSlot: ptr; const AOldName: ptr to const char): int32;
var
  LFound: ptr;
  LStat: FstatFn;
  LXstat: FxstatFn;
begin
  LFound := HookReal(ASlot, AName);
  if LFound <> nil then
    LStat := FstatFn(LFound);
    return LStat(AFile, ABuf);
  end;
  LFound := DoReal(AOldSlot, AOldName);
  if LFound = nil then
    return -1;
  end;
  LXstat := FxstatFn(LFound);
  return LXstat(_STAT_VER, AFile, ABuf);
end;
public routine fstat(const AFile: int32; const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoFdStat(AFile, ABuf, LResult) then
    return LResult;
  end;
  return DoRealFstat(AFile, ABuf, GRealFstat, ptr to const char("fstat"), GRealFxstat,
    ptr to const char("__fxstat"));
end;
public routine fstat64(const AFile: int32; const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoFdStat(AFile, ABuf, LResult) then
    return LResult;
  end;
  return DoRealFstat(AFile, ABuf, GRealFstat64, ptr to const char("fstat64"), GRealFxstat64,
    ptr to const char("__fxstat64"));
end;

// The real __fxstat-like call AName with AVersion
routine DoRealFxstat(const AVersion: int32; const AFile: int32; const ABuf: ptr;
  var ASlot: ptr; const AName: ptr to const char): int32;
var
  LFound: ptr;
  LXstat: FxstatFn;
begin
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LXstat := FxstatFn(LFound);
  return LXstat(AVersion, AFile, ABuf);
end;
public routine __fxstat(const AVersion: int32; const AFile: int32; const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoFdStat(AFile, ABuf, LResult) then
    return LResult;
  end;
  return DoRealFxstat(AVersion, AFile, ABuf, GRealFxstat, ptr to const char("__fxstat"));
end;
public routine __fxstat64(const AVersion: int32; const AFile: int32; const ABuf: ptr): int32;
var
  LResult: int32;
begin
  if DoFdStat(AFile, ABuf, LResult) then
    return LResult;
  end;
  return DoRealFxstat(AVersion, AFile, ABuf, GRealFxstat64, ptr to const char("__fxstat64"));
end;

