// fgetpos / fsetpos and their 64 forms (one fpos_t on a 64-bit target)
public routine fgetpos(const AFile: ptr; const APos: ptr to fpos_t): int32;
begin
  return DoPosFile(HookOp.GetPos, AFile, APos, GRealFgetpos, ptr to const char("fgetpos"));
