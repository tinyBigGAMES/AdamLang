// fflush: a handle syncs (its IO flushed); nil flushes every open handle's written bytes and
// every real stream (glibc's _IO_flush_all), EOF when any failed
routine DoFflush(const AFile: ptr; var ASlot: ptr; const AName: ptr to const char): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FileIntFn;
begin
  if AFile = nil then
    LResult := DoFlushAll();
    LFound := DoReal(ASlot, AName);
    if LFound <> nil then
      LReal := FileIntFn(LFound);
      if LReal(nil) <> 0 then
        LResult := ADAM_HOOKIO_EOF;
      end;
    end;
    return LResult;
  end;
  return DoFileInt(HookOp.Flush, ADAM_HOOKIO_EOF, AFile, ASlot, AName);
end;
public routine fflush(const AFile: ptr): int32;
begin
  return DoFflush(AFile, GRealFflush, ptr to const char("fflush"));
end;
public routine fflush_unlocked(const AFile: ptr): int32;
begin
  return DoFflush(AFile, GRealFflushUnlocked, ptr to const char("fflush_unlocked"));
end;

// setvbuf: the model's buffering (the caller's array used as glibc uses it)
public routine setvbuf(const AFile: ptr; const ABuffer: ptr to char; const AMode: int32;
  const ASize: uint64): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: SetvbufFn;
begin
  LCall := DoCall(HookOp.Setvbuf, ADAM_HOOKIO_EOF);
  LCall.Buffer := ptr to uint8(ABuffer);
  LCall.Value := AMode;
  LCall.Size := int64(ASize);
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(GRealSetvbuf, ptr to const char("setvbuf"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := SetvbufFn(LFound);
  return LReal(AFile, ABuffer, AMode, ASize);
end;

// setbuffer (iosetbuffer.c) and setbuf (setbuffer with BUFSIZ)
routine DoSetbufferFile(const AFile: ptr; const ABuffer: ptr to char; const ASize: uint64): bool;
var
  LCall: HookCall;
begin
  LCall := DoCall(HookOp.Setbuffer, 0);
  LCall.Buffer := ptr to uint8(ABuffer);
  LCall.Size := int64(ASize);
  return DoWith(AFile, LCall);
end;
public routine setbuffer(const AFile: ptr; const ABuffer: ptr to char; const ASize: uint64);
var
  LFound: ptr;
  LReal: SetbufferFn;
begin
  if DoSetbufferFile(AFile, ABuffer, ASize) then
    return;
  end;
  LFound := DoReal(GRealSetbuffer, ptr to const char("setbuffer"));
  if LFound = nil then
    return;
  end;
  LReal := SetbufferFn(LFound);
  LReal(AFile, ABuffer, ASize);
end;
public routine setbuf(const AFile: ptr; const ABuffer: ptr to char);
var
  LFound: ptr;
  LReal: SetbufFn;
begin
  if DoSetbufferFile(AFile, ABuffer, BUFSIZ) then
    return;
  end;
  LFound := DoReal(GRealSetbuf, ptr to const char("setbuf"));
  if LFound = nil then
    return;
  end;
  LReal := SetbufFn(LFound);
  LReal(AFile, ABuffer);
end;
// setlinebuf: setvbuf(_IOLBF) with no array
public routine setlinebuf(const AFile: ptr);
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FileVoidFn;
begin
  LCall := DoCall(HookOp.Setvbuf, ADAM_HOOKIO_EOF);
  LCall.Value := _IOLBF;
  if DoWith(AFile, LCall) then
    return;
  end;
  LFound := DoReal(GRealSetlinebuf, ptr to const char("setlinebuf"));
  if LFound = nil then
    return;
  end;
  LReal := FileVoidFn(LFound);
  LReal(AFile);
end;

// fileno / fileno_unlocked: a handle's descriptor (DoDescriptorLocked: reserved at the first
// ask; -1 with errno when none can be)
public routine fileno(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Fileno, -1, AFile, GRealFileno, ptr to const char("fileno"));
end;
public routine fileno_unlocked(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Fileno, -1, AFile, GRealFilenoUnlocked,
    ptr to const char("fileno_unlocked"));
end;

// The stream locks: nothing on a handle (every call takes the handle's own lock)
public routine flockfile(const AFile: ptr);
var
  LFound: ptr;
  LReal: FileVoidFn;
begin
  if DoOwns(AFile) then
    return;
  end;
  LFound := DoReal(GRealFlockfile, ptr to const char("flockfile"));
  if LFound = nil then
    return;
  end;
  LReal := FileVoidFn(LFound);
  LReal(AFile);
end;
public routine funlockfile(const AFile: ptr);
var
  LFound: ptr;
  LReal: FileVoidFn;
begin
  if DoOwns(AFile) then
    return;
  end;
  LFound := DoReal(GRealFunlockfile, ptr to const char("funlockfile"));
  if LFound = nil then
    return;
  end;
  LReal := FileVoidFn(LFound);
  LReal(AFile);
end;
public routine ftrylockfile(const AFile: ptr): int32;
var
  LFound: ptr;
  LReal: FileIntFn;
begin
  if DoOwns(AFile) then
    return 0;
  end;
  LFound := DoReal(GRealFtrylockfile, ptr to const char("ftrylockfile"));
  if LFound = nil then
    return -1;
  end;
  LReal := FileIntFn(LFound);
  return LReal(AFile);
end;

// fwide: the orientation (AMode > 0 wide, < 0 byte, 0 only asks)
public routine fwide(const AFile: ptr; const AMode: int32): int32;
var
  LCall: HookCall;
