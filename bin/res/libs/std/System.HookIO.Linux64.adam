public routine fputc(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.Put, AChar, AFile, GRealFputc, ptr to const char("fputc"));
end;
public routine putc(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.Put, AChar, AFile, GRealPutc, ptr to const char("putc"));
end;
public routine fputc_unlocked(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.PutUnlocked, AChar, AFile, GRealFputcUnlocked,
    ptr to const char("fputc_unlocked"));
end;
public routine putc_unlocked(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.PutUnlocked, AChar, AFile, GRealPutcUnlocked,
    ptr to const char("putc_unlocked"));
end;
public routine _IO_putc(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.Put, AChar, AFile, GRealIOPutc, ptr to const char("_IO_putc"));
end;
// putw: an int's bytes (0, or EOF)
public routine putw(const AWord: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.PutWord, AWord, AFile, GRealPutw, ptr to const char("putw"));
end;
// __overflow: where glibc's inline putc_unlocked falls when the put area is full (a handle's
// always is)
public routine __overflow(const AFile: ptr; const AChar: int32): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: OverflowFn;
begin
  LCall := DoCall(HookOp.Overflow, ADAM_HOOKIO_EOF);
  LCall.Value := AChar;
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(GRealOverflow, ptr to const char("__overflow"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := OverflowFn(LFound);
  return LReal(AFile, AChar);
end;

// fputs and fputs_unlocked: the text's bytes (1, or EOF)
