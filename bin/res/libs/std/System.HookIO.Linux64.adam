  end;
  LSeek := LseekFn(LFound);
  return LSeek(AFile, AOffset, AWhence);
end;

// lseek / lseek64 (the same on a 64-bit target)
public routine lseek(const AFile: int32; const AOffset: int64; const AWhence: int32): int64;
var
  LHandle: ptr to HookHandle;
  LClosed: bool;
  LAnswer: int64;
begin
  LHandle := DoFindDescriptor(AFile, LClosed);
  if LHandle <> nil then
    LAnswer := DoFdSeek(LHandle, LClosed, AOffset, AWhence);
    DoReleaseHandle(LHandle);
    return LAnswer;
  end;
  return DoRealLseek(AFile, AOffset, AWhence, GRealLseek, ptr to const char("lseek"));
end;
