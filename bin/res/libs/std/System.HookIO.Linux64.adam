// __fsetlocking: the stream's locking kind, _IO_USER_LOCK kept as glibc keeps it (1
// FSETLOCKING_INTERNAL, 2 FSETLOCKING_BYCALLER; 0 only asks)
public routine __fsetlocking(const AFile: ptr; const AType: int32): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FsetlockingFn;
begin
  LCall := DoCall(HookOp.Locking, 1);
  LCall.Value := AType;
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(GRealFsetlocking, ptr to const char("__fsetlocking"));
  if LFound = nil then
    return 1;
  end;
  LReal := FsetlockingFn(LFound);
  return LReal(AFile, AType);
end;

// The formatted prints (fprintf and its family): glibc's own formatting, the text put on a
// handle (DoPrint); anything else to the real vfprintf / __vfprintf_chk with the arguments as
// a C va_list
routine DoRealPrint(const AFile: ptr; const AFlag: int32; const AFormat: ptr to const char;
  const AArgs: ptr): int32;
var
  LFound: ptr;
  LPrint: VfprintfFn;
  LPrintChk: VfprintfChkFn;
begin
  if AFlag >= 0 then
    LFound := DoReal(GRealVfprintfChk, ptr to const char("__vfprintf_chk"));
    if LFound = nil then
      return -1;
    end;
    LPrintChk := VfprintfChkFn(LFound);
    return LPrintChk(AFile, AFlag, AFormat, AArgs);
  end;
  LFound := DoReal(GRealVfprintf, ptr to const char("vfprintf"));
  if LFound = nil then
    return -1;
  end;
  LPrint := VfprintfFn(LFound);
  return LPrint(AFile, AFormat, AArgs);
end;
public routine fprintf(const AFile: ptr; const AFormat: ptr to const char; ...): int32;
var
  LAnswer: int32;
begin
  if DoPrint(AFile, -1, AFormat, varargs.clist(), LAnswer) then
    return LAnswer;
  end;
  return DoRealPrint(AFile, -1, AFormat, varargs.clist());
end;
public routine vfprintf(const AFile: ptr; const AFormat: ptr to const char; const AArgs: ptr): int32;
var
  LAnswer: int32;
begin
  if DoPrint(AFile, -1, AFormat, AArgs, LAnswer) then
    return LAnswer;
  end;
  return DoRealPrint(AFile, -1, AFormat, AArgs);
end;
public routine __fprintf_chk(const AFile: ptr; const AFlag: int32; const AFormat: ptr to const char;
  ...): int32;
var
  LAnswer: int32;
begin
  if DoPrint(AFile, AFlag, AFormat, varargs.clist(), LAnswer) then
    return LAnswer;
  end;
  return DoRealPrint(AFile, AFlag, AFormat, varargs.clist());
end;
public routine __vfprintf_chk(const AFile: ptr; const AFlag: int32; const AFormat: ptr to const char;
  const AArgs: ptr): int32;
var
  LAnswer: int32;
begin
  if DoPrint(AFile, AFlag, AFormat, AArgs, LAnswer) then
    return LAnswer;
  end;
  return DoRealPrint(AFile, AFlag, AFormat, AArgs);
end;

// The wide formatted prints (fwprintf and its family): as the byte ones (DoPrintWide)
routine DoRealPrintWide(const AFile: ptr; const AFlag: int32; const AFormat: ptr to const uint32;
  const AArgs: ptr): int32;
var
  LFound: ptr;
  LPrint: VfwprintfFn;
  LPrintChk: VfwprintfChkFn;
begin
  if AFlag >= 0 then
    LFound := DoReal(GRealVfwprintfChk, ptr to const char("__vfwprintf_chk"));
    if LFound = nil then
      return -1;
    end;
    LPrintChk := VfwprintfChkFn(LFound);
    return LPrintChk(AFile, AFlag, AFormat, AArgs);
  end;
  LFound := DoReal(GRealVfwprintf, ptr to const char("vfwprintf"));
  if LFound = nil then
    return -1;
  end;
  LPrint := VfwprintfFn(LFound);
  return LPrint(AFile, AFormat, AArgs);
end;
public routine fwprintf(const AFile: ptr; const AFormat: ptr to const uint32; ...): int32;
var
  LAnswer: int32;
begin
  if DoPrintWide(AFile, -1, AFormat, varargs.clist(), LAnswer) then
    return LAnswer;
  end;
  return DoRealPrintWide(AFile, -1, AFormat, varargs.clist());
end;
public routine vfwprintf(const AFile: ptr; const AFormat: ptr to const uint32; const AArgs: ptr): int32;
var
  LAnswer: int32;
begin
  if DoPrintWide(AFile, -1, AFormat, AArgs, LAnswer) then
    return LAnswer;
  end;
  return DoRealPrintWide(AFile, -1, AFormat, AArgs);
end;
public routine __fwprintf_chk(const AFile: ptr; const AFlag: int32; const AFormat: ptr to const uint32;
  ...): int32;
var
  LAnswer: int32;
begin
  if DoPrintWide(AFile, AFlag, AFormat, varargs.clist(), LAnswer) then
    return LAnswer;
  end;
  return DoRealPrintWide(AFile, AFlag, AFormat, varargs.clist());
end;
public routine __vfwprintf_chk(const AFile: ptr; const AFlag: int32;
  const AFormat: ptr to const uint32; const AArgs: ptr): int32;
var
  LAnswer: int32;
begin
  if DoPrintWide(AFile, AFlag, AFormat, AArgs, LAnswer) then
    return LAnswer;
  end;
  return DoRealPrintWide(AFile, AFlag, AFormat, AArgs);
end;

