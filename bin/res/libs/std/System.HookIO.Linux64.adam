-------------------------------------------------------------------------------
  System.HookIO.Linux64.adam - System.HookIO's platform unit for
  x86_64-linux-gnu: glibc's C file calls on Adam streams

  The hooks are System.HookAbi's link-time kind: public routines of glibc's
  C names, so they bind every reference in the final link, the runtime's
  own `external` fwrite (its printing) included. A FILE that is not a
  HookIO handle goes to the real function (HookReal: libc.so.6's, found
  once through dlsym): real files and printing work as before. The
  registry, the path sources and the IO-level opens are System.HookIO.Core's;
  HookIOStreamOf is this unit's answer to System.HookIO's FileIO.

  A handle is Adam's own object, never a glibc FILE: it is told by its
  address in the open list and is valid only with the names hooked here.
  It begins as glibc's struct _IO_FILE does (_IO_FILE, its flags kept in
  step and its buffer areas empty), so glibc's inline getc_unlocked /
  putc_unlocked / feof_unlocked / ferror_unlocked, which read those fields
  straight, fall into the hooked __uflow / __overflow and see the handle's
  end and error state. The registry and the open list share one lock, never
  held while CustomIO runs. Every handle on one registered IO shares that
  IO's stream lock (they share its position); a source entry's handle has a
  lock of its own.

  Modes are read as glibc's _IO_new_file_fopen reads them: r, w or a, then
  up to six of + x b m c e (anything else ignored) to a ',' or the end; an
  unknown first letter is EINVAL; x makes a creating open (w, a) fail with
  EEXIST when the target exists; ",ccs=<charset>" after the last letter
  read orients the stream wide with that charset (glibc's strip: letters,
  digits and _ - . , : upper-cased, "//" added), a charset iconv does not
  know failing the open with EINVAL. An unregistered prefix, a missing
  entry or a path the source refuses is ENOENT; an entry the source does
  not offer in the mode is EACCES; w on a read-only IO is EACCES.

  Every byte call on a handle runs on a model of glibc 2.39's libio as its
  sources state it (fileops.c, genops.c, iofread.c, iofgets.c, iogetline.c,
  iogetdelim.c, ioungetc.c, ioftell.c, ioseekoff.c, iosetvbuf.c,
  iosetbuffer.c, iofflush.c, iofclose.c, freopen.c), its fields held as
  glibc holds them (HookLibio: the get, put and reserve areas as addresses,
  the backup area an ungetc past the buffer's start opens, _offset), so a
  C library sees on a handle what glibc gives on a real file of the same
  bytes: 4096-byte fills (the size glibc gives a file whose st_blksize is
  the one this unit's stat reports), freads and fwrites of whole blocks
  straight to the IO, glibc's fseek (a seek inside the buffer only moving
  in it, block-aligned read-ahead), its ftell (an appending stream's going
  to the end, ungot bytes before the first read not counted), the
  descriptor stepped back over read-ahead before a write lands and at an
  fflush of a reading stream, line-buffered and unbuffered streams,
  setvbuf / setbuffer with the caller's array filled as glibc fills it,
  EOF sticky until cleared (C99), and every handle's unflushed bytes
  written at exit as glibc's _IO_cleanup writes its streams'. Two places
  where glibc's own pointers go wrong keep the stream as the caller stands
  in it instead: setvbuf while ungot bytes sit in the backup area (glibc
  reads freed memory there) keeps the ungot bytes, then the IO from the
  caller's place; ungetc on a stream putting bytes (glibc opens the backup
  area beside a live put area and its next flush seeks the descriptor by
  the distance between the two blocks; its fflush leaves the put flag on,
  so after one too) leaves put mode first, as an fseek would, so the ungot
  byte is read, then the IO from the caller's place. A seek the IO refuses
  is EINVAL (a target the IO does not allow, past a fixed IO's end) or,
  for an IO that cannot seek at all, ESPIPE. An IO that cannot seek (no
  Seek callback) is a pipe / FIFO as glibc meets one: every lseek ESPIPE
  whatever the target, reads and writes in order at the IO's own place,
  and the bytes a scan looks ahead at read once and kept for the stream's
  next reads (a pipe gives no byte twice).

  A wide stream (fwide > 0, a wide call on an unoriented one, or a ccs=
  open) runs on a model of glibc's wide libio as its sources state it
  (wfileops.c, wgenops.c, wfiledoalloc.c, iofwide.c, iofgetws.c,
  iofputws.c, ioungetwc.c): its _wide_data areas held as glibc holds them
  (HookWide: the wide get, put, reserve and backup areas of wchar_t's as
  addresses, the reserve area as many characters as the byte buffer has
  bytes) over a codecvt on iconv between glibc's wchar_t and the stream's
  charset (the ccs= one, else the LC_CTYPE codeset when it turned wide, as
  glibc's _IO_fwide takes it; output with //TRANSLIT, as glibc's
  __GCONV_TRANSLIT). The charset's encoding is read from the iconv
  descriptor's own gconv step and its shift state saved and set back as
  glibc's _IO_last_state is (the descriptor holds glibc's
  __gconv_step_data), so characters are converted a buffer at a time and
  ftell, fseek and fflush count buffered characters back to bytes as glibc
  does (a fixed-width charset's bytes per character, else the conversion
  run again). The orientation rules are glibc's: a byte write or formatted
  call on a wide stream (fwrite, fputs, fprintf, fscanf) and a wide call on
  a byte stream fail. Where glibc's wide code goes wrong the stream is kept
  sane instead: fseek on a stream with no wide buffer yet (glibc converts
  into a NULL area and loops forever) makes one first; a seek whose target
  splits a character (glibc converts again forever) takes the whole
  characters before it; fputwc after ungetwc of another character (glibc
  puts from inside the backup area and writes past it) leaves the backup
  area first, as the byte model does; a fill after input that made no
  character keeps the bytes it moved (glibc's read_end -= avail); a
  backup area freed by a fill is forgotten (glibc leaves its pointer).
  fseek from SEEK_CUR while ungot characters wait aborts the program, as
  glibc's ioseekoff.c does.

  fprintf and its family format with glibc's own vasprintf (the _chk forms
  with __vasprintf_chk, the wide ones into an open_wmemstream with glibc's
  vfwprintf / __vfwprintf_chk) and hand the text to the handle's put area
  in one piece (a wide one's through _IO_wfile_xsputn). A byte scan
  (fscanf, __isoc99_fscanf and the rest of the family) runs glibc's own
  scan over a stand-in fopencookie FILE that reads what the handle would
  read next (its buffered bytes, then its IO; only the buffered ones once
  EOF is seen), then moves the handle on by exactly what the scan used
  (glibc's ftell of the stand-in): the place and feof after a scan are what
  a real file of the same bytes gives. A fopencookie FILE is byte-only, so
  a wide scan's stand-in is a real wide FILE: the handle's next characters
  as UTF-8 in a temporary file opened "r,ccs=UTF-8" and unlinked; the
  handle then takes, as getwc takes them, the characters the scan used. A
  stand-in that met its end while the handle has more is made again larger
  and the scan run again over a copy of its va_list.

  freopen (and freopen64) on a handle reopens it in place (the same FILE*
  comes back): the stream is synced and closed first, then the path opened
  in the new mode, orientation reset; a path that is neither virtual nor a
  path source's opens the disk file as an entry of a folder IOSource the
  handle owns, by fopen's rules; no path reopens the handle's own path in
  the new mode (POSIX's meaning). A failed reopen leaves the stream closed
  and no longer a handle. A real FILE reopened onto a virtual path is the C
  runtime's object and fails as glibc fails it (ENOENT). flockfile,
  funlockfile and ftrylockfile are nothing on a handle (0 from the try);
  pclose closes a handle as glibc's pclose closes any stream (it is fclose).

  A handle has a file descriptor as glibc's FILE has one: fileno answers a
  number the kernel reserved for it (glibc's open of /dev/null, read-only,
  closed on exec, so no other open gets the number while it is held), made
  at its first fileno and given back at fclose. The descriptor family on
  that number runs on the handle as the kernel runs it on the FILE's real
  file (the libio model's own descriptor: the same place): read, pread,
  write, pwrite, lseek (SEEK_SET / CUR / END), fstat (a regular file of the
  IO's size, a FIFO for an IO that cannot seek), mmap (a private anonymous
  mapping filled with the IO's bytes from the offset: a shared writable one
  cannot reach the IO and is ENODEV) and close (then the descriptor's calls
  and the stream's own reads, writes and seeks are EBADF, as glibc's are on
  a closed _fileno, and fclose reports EOF with EBADF; the number stays
  reserved until that fclose, so no other open meets the stream).
  dup, dup2, dup3 and fcntl's F_DUPFD / F_DUPFD_CLOEXEC give a handle's
  descriptor another number on the same open file description (one place,
  one set of rights, as the kernel's), reserved as the first is; F_GETFL
  answers the description's access mode and O_APPEND, F_SETFL sets its
  O_APPEND; every other command is glibc's on the reservation. fdopen of a
  handle's descriptor opens a new stream whose system calls run on that
  description (glibc's rules: EINVAL for a right the descriptor lacks, "a"
  sets O_APPEND and a write-only one starts at the end). A description
  outlives the stream that opened it while another number or stream still
  uses it, and closes with the last of them.
  open and open64 (and _FORTIFY_SOURCE's __open_2 / __open64_2) of a
  virtual path, or one the path source holds, open a handle as fopen would
  (the kernel's O_* rules: O_CREAT / O_EXCL / O_TRUNC / O_APPEND, the
  access mode's rights) and answer its descriptor; close(2) of it closes the
  handle. Every other descriptor and path is glibc's. The query family (access, stat,
  stat64, lstat, lstat64 and glibc's __xstat / __xstat64 / __lxstat /
  __lxstat64) answers a virtual path as fopen would find it: a regular
  file, readable by all, writable as an "r+" open would be, never
  executable, one link, its size, a 4096-byte block, no times.
*******************************************************************************/

module unit System.HookIO.Linux64;

import System.SysUtils, System.Runtime, System.HookAbi, System.CustomIO, System.HookIO.Core;

public const
  // C's WEOF (glibc's wint_t is 32 bits, WEOF 0xFFFFFFFF): what the hooked wide calls return
  // on a failure
  ADAM_HOOKIO_WEOF: int32 = -1;

const
  // libio's _flags bits (libio.h): the magic in the high half, then the stream's state
  _IO_MAGIC: uint32 = 0xFBAD0000u;
  _IO_USER_BUF: uint32 = 0x0001u;
  _IO_UNBUFFERED: uint32 = 0x0002u;
  _IO_NO_READS: uint32 = 0x0004u;
  _IO_NO_WRITES: uint32 = 0x0008u;
  _IO_EOF_SEEN: uint32 = 0x0010u;
  _IO_ERR_SEEN: uint32 = 0x0020u;
  _IO_LINKED: uint32 = 0x0080u;
  _IO_IN_BACKUP: uint32 = 0x0100u;
  _IO_LINE_BUF: uint32 = 0x0200u;
  _IO_TIED_PUT_GET: uint32 = 0x0400u;
  _IO_CURRENTLY_PUTTING: uint32 = 0x0800u;
  _IO_IS_APPENDING: uint32 = 0x1000u;
  _IO_IS_FILEBUF: uint32 = 0x2000u;
  _IO_USER_LOCK: uint32 = 0x8000u;
  // stdio.h: setvbuf's modes, setbuf's size
  _IOFBF: int32 = 0;
  _IOLBF: int32 = 1;
  _IONBF: int32 = 2;
  BUFSIZ: uint64 = 8192u;
  // libioP.h's seek directions (SEEK_SET / CUR / END) and _IOS_INPUT | _IOS_OUTPUT, the mode
  // fseek / fsetpos / rewind pass _IO_seekoff_unlocked (0: ftell's)
  _IO_seek_set: int32 = 0;
  _IO_seek_cur: int32 = 1;
  _IO_seek_end: int32 = 2;
  ADAM_HOOKIO_SEEK_MODE: int32 = 3;
  // errno.h (x86_64 glibc): what the runtime's set lacks
  ESPIPE: int32 = 29;
  EAGAIN: int32 = 11;
  ENODEV: int32 = 19;
  ENOTDIR: int32 = 20;
  EMFILE: int32 = 24;
  // fcntl.h (x86_64): open's access modes and the flags a virtual open reads
  O_ACCMODE: int32 = 3;
  O_RDONLY: int32 = 0;
  O_WRONLY: int32 = 1;
  O_RDWR: int32 = 2;
  O_CREAT: int32 = 0x40;
  O_EXCL: int32 = 0x80;
  O_TRUNC: int32 = 0x200;
  O_APPEND: int32 = 0x400;
  O_DIRECTORY: int32 = 0x10000;
  O_CLOEXEC: int32 = 0x80000;
  O_TMPFILE: int32 = 0x410000;
  // fcntl.h (x86_64): the commands a handle's descriptor answers itself (a copy, the status
  // flags); every other one is glibc's on the reservation
  F_DUPFD: int32 = 0;
  F_GETFL: int32 = 3;
  F_SETFL: int32 = 4;
  F_DUPFD_CLOEXEC: int32 = 1030;
  // sys/mman.h: a mapping's write right, its sharing, an anonymous one, mmap's failure
  // (MAP_FAILED, (void *) -1)
  PROT_WRITE: int32 = 2;
  MAP_SHARED: int32 = 1;
  MAP_PRIVATE: int32 = 2;
  MAP_ANONYMOUS: int32 = 0x20;
  ADAM_HOOKIO_MAP_FAILED: uint64 = 18446744073709551615u;
  // x86_64 Linux's page: an mmap offset is a multiple of it
  ADAM_HOOKIO_PAGE_SIZE: int64 = 4096;
  // The file a handle's descriptor is reserved on (glibc's open of it, read-only, closed on
  // exec): the kernel hands out the number, so no other open ever gets it while it is held
  ADAM_HOOKIO_RESERVE_PATH: string = "/dev/null";
  // sys/stat.h: a FIFO (a handle on an IO that cannot seek), a regular file, the read and
  // write bits of owner, group and other
  S_IFIFO: uint32 = 0x1000u;
  S_IFREG: uint32 = 0x8000u;
  S_IRUSR: uint32 = 0x0100u;
  S_IWUSR: uint32 = 0x0080u;
  S_IRGRP: uint32 = 0x0020u;
  S_IWGRP: uint32 = 0x0010u;
  S_IROTH: uint32 = 0x0004u;
  S_IWOTH: uint32 = 0x0002u;
  // unistd.h: access's modes
  F_OK: int32 = 0;
  X_OK: int32 = 1;
  W_OK: int32 = 2;
  R_OK: int32 = 4;
  // sys/stat.h (x86_64): the struct version __xstat / __lxstat take (_STAT_VER_LINUX)
  _STAT_VER: int32 = 1;
  // langinfo.h: nl_langinfo's CODESET
  CODESET: int32 = 14;
  // iconv's (size_t) -1, its failure
  ADAM_HOOKIO_ICONV_FAILED: uint64 = 18446744073709551615u;
  // E2BIG: iconv's "the output is full" (errno.h)
  E2BIG: int32 = 7;
  // The block size a handle's stat reports (st_blksize), so the buffer glibc's
  // _IO_file_doallocate gives a file of that block size (filedoalloc.c: st_blksize below
  // BUFSIZ): a handle's fills are 4096 bytes, as a real file's on a 4096-byte block device
  ADAM_HOOKIO_BLOCK_SIZE: int64 = 4096;
  // genops.c's _IO_default_pbackfail: the first backup area an ungetc opens
  ADAM_HOOKIO_BACKUP_SIZE: int64 = 128;
  // libioP.h's _IO_pos_BAD: _offset unknown
  ADAM_HOOKIO_POS_BAD: int64 = -1;
  // getdelim's first line buffer (iogetdelim.c) and SSIZE_MAX
  ADAM_HOOKIO_GETDELIM_START: uint64 = 120u;
  ADAM_HOOKIO_SSIZE_MAX: int64 = 9223372036854775807;
  // The largest size_t: fread / fwrite's product wraps past it as glibc's does
  ADAM_HOOKIO_MAX_SIZE: uint64 = 18446744073709551615u;
  // A line's end
  ADAM_HOOKIO_NEWLINE: int32 = 10;
  // The bytes one wide character takes at most in any charset iconv writes (MB_LEN_MAX 16)
  ADAM_HOOKIO_MB_MAX: int64 = 16;
  // The characters a wide scan's stand-in is given first (four times as many each time it is
  // too few)
  ADAM_HOOKIO_WIDE_SCAN_STEP: int64 = 4096;
  // The bytes of a wchar_t (glibc: 32 bits)
  ADAM_HOOKIO_WCHAR_BYTES: int64 = 4;
  // glibc's gconv layout an iconv descriptor points to (gconv.h, 2.39 x86_64): struct
  // __gconv_info's __steps at 8 and its __gconv_step_data array from 16 (48 bytes each,
  // __statep at 32 pointing at its own __state at 40); a __gconv_step's __min_needed_from at
  // 72, __max_needed_from at 76, __stateful at 88. The most steps a descriptor is taken to have
  ADAM_HOOKIO_GCONV_STEPS: int64 = 8;
  ADAM_HOOKIO_GCONV_DATA: int64 = 16;
  ADAM_HOOKIO_GCONV_DATA_SIZE: int64 = 48;
  ADAM_HOOKIO_GCONV_STATEP: int64 = 32;
  ADAM_HOOKIO_GCONV_STATE: int64 = 40;
  ADAM_HOOKIO_GCONV_MIN_FROM: int64 = 72;
  ADAM_HOOKIO_GCONV_MAX_FROM: int64 = 76;
  ADAM_HOOKIO_GCONV_STATEFUL: int64 = 88;
  ADAM_HOOKIO_GCONV_MAX_STEPS: int64 = 16;
  // glibc's WEOF returned as an off64_t (do_ftell_wide / _IO_wfile_seekoff's failures)
  ADAM_HOOKIO_WEOF_OFFSET: int64 = 4294967295;
  // A SysV x86_64 va_list's bytes (__va_list_tag: two counts and two pointers)
  ADAM_HOOKIO_VA_LIST_BYTES: int64 = 24;
  // mkstemp's template for a wide scan's stand-in
  ADAM_HOOKIO_STAND_IN_PATH: string = "/tmp/adam-hookio-XXXXXX";

// A handle names the handle its description is on (Desc), declared below
forward type HookHandle;

type
  // The bytes one wide character takes at most in a charset (ADAM_HOOKIO_MB_MAX)
  HookMbBytes = array[0..15] of uint8;

  // glibc's struct _IO_FILE (bits/types/struct_FILE.h), 216 bytes on x86_64: a handle begins
  // with it, so a C library holding the handle as a FILE* finds glibc's fields where its inline
  // macros read them. Only _flags (kept in step with the model's EOF / error bits), _fileno
  // (-1), _offset and _mode are set; the buffer areas stay nil, so every inline read or write
  // falls into __uflow / __overflow. __pad5 is pad5 ('__' names are the compiler's)
  _IO_FILE = record
    _flags: int32;
    _IO_read_ptr: ptr;
    _IO_read_end: ptr;
    _IO_read_base: ptr;
    _IO_write_base: ptr;
    _IO_write_ptr: ptr;
    _IO_write_end: ptr;
    _IO_buf_base: ptr;
    _IO_buf_end: ptr;
    _IO_save_base: ptr;
    _IO_backup_base: ptr;
    _IO_save_end: ptr;
    _markers: ptr;
    _chain: ptr;
    _fileno: int32;
    _flags2: int32;
    _old_offset: int64;
    _cur_column: uint16;
    _vtable_offset: int8;
    _shortbuf: array[0..0] of char;
    _lock: ptr;
    _offset: int64;
    _codecvt: ptr;
    _wide_data: ptr;
    _freeres_list: ptr;
    _freeres_buf: ptr;
    pad5: uint64;
    _mode: int32;
    _unused2: array[0..19] of char;
  end;

  // The state of the handle's libio FILE, glibc's fields as glibc holds them (libio.h): Flags
  // its _flags; the get area ReadBase / ReadPtr / ReadEnd, the put area WriteBase / WritePtr /
  // WriteEnd and the reserve area BufBase / BufEnd as addresses (0 is NULL), so the model's
  // arithmetic and comparisons are glibc's own; SaveBase / BackupBase / SaveEnd the backup
  // area's (while _IO_IN_BACKUP is set the get area is the backup area and these hold the main
  // one's, as glibc swaps them). Offset: _offset, the descriptor's place when known
  // (ADAM_HOOKIO_POS_BAD: not). CurColumn: _cur_column. Orientation: _mode (-1 byte, 0 not yet,
  // 1 wide). ShortBuf: _shortbuf, the one-byte reserve area of an unbuffered stream. A buffer
  // the model made (no _IO_USER_BUF) and the backup area are getmem's, freed by the model
  HookLibio = record
    Flags: uint32;
    ReadPtr: uint64;
    ReadEnd: uint64;
    ReadBase: uint64;
    WriteBase: uint64;
    WritePtr: uint64;
    WriteEnd: uint64;
    BufBase: uint64;
    BufEnd: uint64;
    SaveBase: uint64;
    BackupBase: uint64;
    SaveEnd: uint64;
    Offset: int64;
    CurColumn: uint32;
    Orientation: int32;
    ShortBuf: uint8;
  end;

  // A saved conversion state (DoCvSave): Size bytes of an iconv descriptor's step data (0: not
  // saved), at most ADAM_HOOKIO_GCONV_MAX_STEPS steps' worth
  HookCvState = record
    Size: int64;
    Data: array[0..767] of uint8;
  end;

  // A wide stream's _wide_data (libio.h's struct _IO_wide_data) as glibc holds it: the wide get
  // area ReadBase / ReadPtr / ReadEnd, put area WriteBase / WritePtr / WriteEnd, reserve area
  // BufBase / BufEnd and backup area SaveBase / BackupBase / SaveEnd as addresses of wchar_t's
  // (0 is NULL; swapped with the get area while _IO_IN_BACKUP is set, as the byte ones are);
  // UserBuf: _IO_FLAGS2_USER_WBUF (the reserve area is ShortBuf, _shortbuf, not freed);
  // LastState: _IO_last_state (ToWide's state saved by DoCvSave); the codecvt: Charset, a ccs=
  // open's charset as glibc's strip writes it ("UTF-8//"), "" for the LC_CTYPE codeset taken
  // when the stream turned wide (Codeset); ToWide / ToBytes the iconv descriptors (nil until
  // the stream is wide; ToBytes with //TRANSLIT); Encoding: __libio_codecvt_encoding's answer
  HookWide = record
    ReadPtr: uint64;
    ReadEnd: uint64;
    ReadBase: uint64;
    WriteBase: uint64;
    WritePtr: uint64;
    WriteEnd: uint64;
    BufBase: uint64;
    BufEnd: uint64;
    SaveBase: uint64;
    BackupBase: uint64;
    SaveEnd: uint64;
    UserBuf: bool;
    ShortBuf: uint32;
    LastState: HookCvState;
    Charset: string;
    Codeset: string;
    ToWide: ptr;
    ToBytes: ptr;
    Encoding: int32;
  end;

  // A conversion run's answer (glibc's enum __codecvt_result, less __codecvt_noconv)
  HookCv = choices(Ok, Partial, Error);

  // An open handle, what a hooked open returns in place of a FILE*. Head: glibc's FILE head (its
  // address is the handle's). Base: the neutral part (System.HookIO.Core's HookStream) the core
  // opens fill: Stream, Owned, Position (the descriptor's place: what glibc's read / write /
  // lseek move), Lock (the stream lock that guards every field and every call on Stream),
  // Source / EntryName / Temporary, OwnedSource. Readable / Writable: the descriptor's rights
  // (O_RDONLY, O_WRONLY, O_RDWR by the mode); Appending: O_APPEND (every write lands at the
  // IO's end). Closed: fclose ran. Path: the path the handle opened (freopen with no path opens
  // it again). Users: the open list and every call that found the handle; the last one frees
  // it. Io: glibc's FILE state (HookLibio). Wide: a wide stream's _wide_data and conversion.
  // Pipe: the IO cannot seek (IOCanSeek false at the open), a pipe / FIFO: read(2) and write(2)
  // go to the IO at its own place, lseek(2) is ESPIPE. Replay / ReplayNext: on a Pipe handle the
  // bytes a scan's look ahead read from the IO (DoPeekIO) and the descriptor's own reads have
  // not taken yet, from ReplayNext on (DoSysRead takes them before the IO).
  // Descriptor: the handle's file descriptor (-1: none yet), a number the kernel reserved for
  // it (ADAM_HOOKIO_RESERVE_PATH) at its first fileno or at the open(2) that made it, listed in
  // GDescriptors while held; DescriptorOwned: open(2) made the handle (close(2) closes it);
  // DescriptorClosed: close(2) ran on a fileno one (its calls and the stream's own system
  // calls EBADF, as glibc's on a closed _fileno; the number stays reserved until fclose).
  // Desc: the handle whose open file description (IO, place, rights, a pipe's replay) this
  // FILE's system calls run on, nil: its own; an fdopen of a handle's descriptor sets it (one
  // user of it held; the FILE shares its stream lock)
  HookHandle = record
    Head: _IO_FILE;
    Base: HookStream;
    Readable: bool;
    Writable: bool;
    Appending: bool;
    Closed: bool;
    Pipe: bool;
    Replay: array of uint8;
    ReplayNext: int64;
    Path: string;
    Users: int64;
    Io: HookLibio;
    Wide: HookWide;
    Descriptor: int32;
    DescriptorOwned: bool;
    DescriptorClosed: bool;
    Desc: ptr to HookHandle;
  end;

  // One descriptor number on a handle's description (GDescriptors): Number (a reservation the
  // kernel made, ADAM_HOOKIO_RESERVE_PATH), Handle (the description, one user of it held),
  // Closed (close(2) ran on it while an open FILE holds it as its _fileno: its calls EBADF, the
  // number kept until that FILE's fclose, so no other open meets the stream)
  HookDescriptor = record
    Number: int32;
    Handle: ptr to HookHandle;
    Closed: bool;
  end;

  // What a mode string asks for beyond the core's HookOpenMode (glibc's _IO_new_file_fopen):
  // the ccs= charset as strip writes it ("" for none)
  HookModeExtra = record
    Charset: string;
  end;

  // The stream calls DoWith runs on a handle
  HookOp = choices(Read, Write, Get, GetUnlocked, Gets, Getline, Unget, Put, PutUnlocked, Puts,
    Peek, Uflow, Underflow, Overflow, GetWide, GetsWide, UngetWide, PutWide, PutWideRaw, PutsWide,
    Orient,
    Seek, Tell, Rewind, GetPos, SetPos, AtEnd, Failed, ClearError, Flush, Setvbuf, Setbuffer,
    Fileno, Pending, Reading, Writing, Readable, Writable, LineBuffered, BufferSize, Purge,
    Print, PrintWide, PrintCheck, PrintWideCheck, Scan, ScanWide, GetWord, PutWord, Locking);

  // One call's arguments and answer: Buffer / Size / ItemSize (fread / fwrite / fgets / a
  // print's text; a fortified fgets' buffer size, with Origin 1), Offset / Origin (fseek; fread
  // and fwrite's item count in Offset), Value (a character, a mode), Line / LineSize
  // (getdelim's), Text / TextCount (a print's or a wide one's text), Scan* (a scan's real
  // function, format, va_list and whether it is wide), Answer (until the call runs, the
  // failure value)
  HookCall = record
    Op: HookOp;
    Buffer: ptr to uint8;
    Size: int64;
    ItemSize: int64;
    Offset: int64;
    Origin: int32;
    Value: int32;
    Line: ptr to ptr;
    LineSize: ptr to uint64;
    Wide: ptr to uint32;
    ScanReal: ptr;
    ScanFormat: ptr;
    ScanArgs: ptr;
    Answer: int64;
  end;

  // glibc's cookie_io_functions_t (stdio.h): the stand-in FILE's callbacks
  cookie_io_functions_t = record
    read: routine clink(ACookie: ptr; ABuffer: ptr to uint8; ASize: uint64): int64;
    write: routine clink(ACookie: ptr; ABuffer: ptr to const uint8; ASize: uint64): int64;
    seek: routine clink(ACookie: ptr; APosition: ptr to int64; AWhence: int32): int32;
    close: routine clink(ACookie: ptr): int32;
  end;

  // What a byte scan's stand-in reads: the handle's next bytes as its own reads would give them
  // (Pending / PendingLeft: the backup area's ungot bytes, then Main / MainLeft: the main get
  // area's, then the IO from Position unless AtEnd: glibc's sticky EOF). Delivered: the bytes
  // handed out, what the stand-in's ftell starts from
  HookCookie = record
    Handle: ptr to HookHandle;
    Pending: uint64;
    PendingLeft: int64;
    Main: uint64;
    MainLeft: int64;
    Position: int64;
    AtEnd: bool;
    Delivered: int64;
  end;

  // glibc's fpos_t (_G_fpos_t, x86_64): the place and the conversion state
  fpos_t = record
    pos: int64;
    state: uint64;
  end;

  // glibc's struct stat / stat64 (x86_64, 144 bytes: bits/struct_stat.h); its fields keep
  // the header's names (__pad0 / __glibc_reserved as pad0 / reserved: '__' names are the
  // compiler's), the times as seconds and nanoseconds
  HookStat = record
    st_dev: uint64;
    st_ino: uint64;
    st_nlink: uint64;
    st_mode: uint32;
    st_uid: uint32;
    st_gid: uint32;
    pad0: int32;
    st_rdev: uint64;
    st_size: int64;
    st_blksize: int64;
    st_blocks: int64;
    st_atime: int64;
    st_atimensec: int64;
    st_mtime: int64;
    st_mtimensec: int64;
    st_ctime: int64;
    st_ctimensec: int64;
    reserved: array[0..2] of int64;
  end;

  // The real functions' types, called through HookReal's slots
  FopenFn = routine(const APath: ptr to const char; const AMode: ptr to const char): ptr;
  FreopenFn = routine(const APath: ptr to const char; const AMode: ptr to const char;
    const AFile: ptr): ptr;
  FileIntFn = routine(const AFile: ptr): int32;
  FileVoidFn = routine(const AFile: ptr);
  FileSizeFn = routine(const AFile: ptr): uint64;
  CharFileFn = routine(const AChar: int32; const AFile: ptr): int32;
  OverflowFn = routine(const AFile: ptr; const AChar: int32): int32;
  TransferFn = routine(const ABuffer: ptr; const ASize: uint64; const ACount: uint64;
    const AFile: ptr): uint64;
  TransferChkFn = routine(const ABuffer: ptr; const ABufferSize: uint64; const ASize: uint64;
    const ACount: uint64; const AFile: ptr): uint64;
  FgetsFn = routine(const AText: ptr to char; const ACount: int32; const AFile: ptr): ptr to char;
  FgetsChkFn = routine(const AText: ptr to char; const ASize: uint64; const ACount: int32;
    const AFile: ptr): ptr to char;
  FputsFn = routine(const AText: ptr to const char; const AFile: ptr): int32;
  GetdelimFn = routine(const ALine: ptr to ptr; const ASize: ptr to uint64; const ADelim: int32;
    const AFile: ptr): int64;
  GetlineFn = routine(const ALine: ptr to ptr; const ASize: ptr to uint64; const AFile: ptr): int64;
  FseekFn = routine(const AFile: ptr; const AOffset: int64; const AOrigin: int32): int32;
  FtellFn = routine(const AFile: ptr): int64;
  FposFn = routine(const AFile: ptr; const APos: ptr to fpos_t): int32;
  SetvbufFn = routine(const AFile: ptr; const ABuffer: ptr to char; const AMode: int32;
    const ASize: uint64): int32;
  SetbufferFn = routine(const AFile: ptr; const ABuffer: ptr to char; const ASize: uint64);
  SetbufFn = routine(const AFile: ptr; const ABuffer: ptr to char);
  FwideFn = routine(const AFile: ptr; const AMode: int32): int32;
  FsetlockingFn = routine(const AFile: ptr; const AType: int32): int32;
  VfprintfFn = routine(const AFile: ptr; const AFormat: ptr to const char; const AArgs: ptr): int32;
  VfprintfChkFn = routine(const AFile: ptr; const AFlag: int32; const AFormat: ptr to const char;
    const AArgs: ptr): int32;
  VfwprintfFn = routine(const AFile: ptr; const AFormat: ptr to const uint32; const AArgs: ptr): int32;
  VfwprintfChkFn = routine(const AFile: ptr; const AFlag: int32; const AFormat: ptr to const uint32;
    const AArgs: ptr): int32;
  VfscanfFn = routine(const AFile: ptr; const AFormat: ptr; const AArgs: ptr): int32;
  WideFileFn = routine(const AFile: ptr): uint32;
  WideCharFn = routine(const AChar: uint32; const AFile: ptr): uint32;
  FgetwsFn = routine(const AText: ptr to uint32; const ACount: int32; const AFile: ptr): ptr to uint32;
  FgetwsChkFn = routine(const AText: ptr to uint32; const ASize: uint64; const ACount: int32;
    const AFile: ptr): ptr to uint32;
  FputwsFn = routine(const AText: ptr to const uint32; const AFile: ptr): int32;
  AccessFn = routine(const APath: ptr to const char; const AMode: int32): int32;
  StatFn = routine(const APath: ptr to const char; const ABuf: ptr): int32;
  XstatFn = routine(const AVersion: int32; const APath: ptr to const char; const ABuf: ptr): int32;
  OpenFn = routine(const APath: ptr to const char; const AFlags: int32; const AMode: uint32): int32;
  Open2Fn = routine(const APath: ptr to const char; const AFlags: int32): int32;
  FdIntFn = routine(const AFile: int32): int32;
  FdReadFn = routine(const AFile: int32; const ABuffer: ptr; const ACount: uint64): int64;
  FdReadChkFn = routine(const AFile: int32; const ABuffer: ptr; const ACount: uint64;
    const ABufferSize: uint64): int64;
  FdWriteFn = routine(const AFile: int32; const ABuffer: ptr to const; const ACount: uint64): int64;
  FdPreadFn = routine(const AFile: int32; const ABuffer: ptr; const ACount: uint64;
    const AOffset: int64): int64;
  FdPreadChkFn = routine(const AFile: int32; const ABuffer: ptr; const ACount: uint64;
    const AOffset: int64; const ABufferSize: uint64): int64;
  FdPwriteFn = routine(const AFile: int32; const ABuffer: ptr to const; const ACount: uint64;
    const AOffset: int64): int64;
  LseekFn = routine(const AFile: int32; const AOffset: int64; const AWhence: int32): int64;
  MmapFn = routine(const AAddress: ptr; const ALength: uint64; const AProt: int32;
    const AFlags: int32; const AFile: int32; const AOffset: int64): ptr;
  FstatFn = routine(const AFile: int32; const ABuf: ptr): int32;
  FxstatFn = routine(const AVersion: int32; const AFile: int32; const ABuf: ptr): int32;
  FcntlFn = routine(const AFile: int32; const ACommand: int32; const AArg: uint64): int32;
  Dup2Fn = routine(const AFile: int32; const ATarget: int32): int32;
  Dup3Fn = routine(const AFile: int32; const ATarget: int32; const AFlags: int32): int32;
  FdopenFn = routine(const AFile: int32; const AMode: ptr to const char): ptr;

// glibc's C functions this unit calls itself, none of which takes a FILE*: the line buffer
// getdelim hands the caller (malloc / realloc, the caller frees it), the text vasprintf /
// __vasprintf_chk hand back (free), the wide text a memstream holds, the stand-ins' FILEs (a
// wide scan's temporary file: mkstemp, unlink; its write and close glibc's through their
// slots), iconv, the abort of a failed _chk
// check, glibc's abort of a wide seek from the current place over ungot characters, the
// rights a virtual mmap's pages end with (mprotect)
routine malloc(const ASize: uint64): ptr; external "c";
routine realloc(const APointer: ptr; const ASize: uint64): ptr; external "c";
routine free(const APointer: ptr); external "c";
routine vasprintf(const AText: ptr to ptr to char; const AFormat: ptr to const char;
  const AArgs: ptr): int32; external "c";
routine __vasprintf_chk(const AText: ptr to ptr to char; const AFlag: int32;
  const AFormat: ptr to const char; const AArgs: ptr): int32; external "c";
routine open_wmemstream(const AText: ptr to ptr to uint32; const ASize: ptr to uint64): ptr;
  external "c";
routine clink fopencookie(ACookie: ptr; AMode: ptr to const char;
  AFunctions: cookie_io_functions_t): ptr; external "c";
routine iconv_open(const ATo: ptr to const char; const AFrom: ptr to const char): ptr; external "c";
routine iconv(const ADescriptor: ptr; const AIn: ptr to ptr to uint8; const AInLeft: ptr to uint64;
  const AOut: ptr to ptr to uint8; const AOutLeft: ptr to uint64): uint64; external "c";
routine iconv_close(const ADescriptor: ptr): int32; external "c";
routine nl_langinfo(const AItem: int32): ptr to const char; external "c";
routine mkstemp(const ATemplate: ptr to char): int32; external "c";
routine mprotect(const AAddress: ptr; const ALength: uint64; const AProt: int32): int32;
  external "c";
routine unlink(const APath: ptr to const char): int32; external "c";
routine __chk_fail(); noreturn; external "c";
routine abort(); noreturn; external "c";
// glibc's stdout (a FILE * data object): a line or unbuffered handle's fill flushes it when it
// is line buffered (fileops.c _IO_new_file_underflow)
var
  stdout: ptr; external "c";

var
  GHandles: array of ptr to HookHandle;
  // How many handles are open (atomic): while it is 0 no address is a handle
  GOpenCount: int64;
  // The descriptor numbers on handles' descriptions (each holds one user of its handle), under
  // GLock; how many (atomic): while it is 0 no descriptor is a handle's
  GDescriptors: array of HookDescriptor;
  GDescriptorCount: int64;
  // Whether the exit flush is registered (DoExitFlush, once, at the first open), under GLock
  GExitArmed: bool;
  // HookReal's slots of the real functions
  GRealFopen: ptr;
  GRealFopen64: ptr;
  GRealFreopen: ptr;
  GRealFreopen64: ptr;
  GRealFclose: ptr;
  GRealPclose: ptr;
  GRealFread: ptr;
  GRealFreadUnlocked: ptr;
  GRealFreadChk: ptr;
  GRealFreadUnlockedChk: ptr;
  GRealFwrite: ptr;
  GRealFwriteUnlocked: ptr;
  GRealFgetc: ptr;
  GRealGetc: ptr;
  GRealFgetcUnlocked: ptr;
  GRealGetcUnlocked: ptr;
  GRealIOGetc: ptr;
  GRealGetw: ptr;
  GRealFgets: ptr;
  GRealFgetsUnlocked: ptr;
  GRealFgetsChk: ptr;
  GRealFgetsUnlockedChk: ptr;
  GRealGetdelim: ptr;
  GRealUnderGetdelim: ptr;
  GRealGetline: ptr;
  GRealUngetc: ptr;
  GRealFputc: ptr;
  GRealPutc: ptr;
  GRealFputcUnlocked: ptr;
  GRealPutcUnlocked: ptr;
  GRealIOPutc: ptr;
  GRealPutw: ptr;
  GRealFputs: ptr;
  GRealFputsUnlocked: ptr;
  GRealPeekc: ptr;
  GRealUflow: ptr;
  GRealUnderflow: ptr;
  GRealOverflow: ptr;
  GRealFeof: ptr;
  GRealFeofUnlocked: ptr;
  GRealIOFeof: ptr;
  GRealFerror: ptr;
  GRealFerrorUnlocked: ptr;
  GRealIOFerror: ptr;
  GRealClearerr: ptr;
  GRealClearerrUnlocked: ptr;
  GRealFseek: ptr;
  GRealFseeko: ptr;
  GRealFseeko64: ptr;
  GRealFtell: ptr;
  GRealFtello: ptr;
  GRealFtello64: ptr;
  GRealRewind: ptr;
  GRealFgetpos: ptr;
  GRealFgetpos64: ptr;
  GRealFsetpos: ptr;
  GRealFsetpos64: ptr;
  GRealFflush: ptr;
  GRealFflushUnlocked: ptr;
  GRealSetvbuf: ptr;
  GRealSetbuf: ptr;
  GRealSetbuffer: ptr;
  GRealSetlinebuf: ptr;
  GRealFileno: ptr;
  GRealFilenoUnlocked: ptr;
  GRealFlockfile: ptr;
  GRealFunlockfile: ptr;
  GRealFtrylockfile: ptr;
  GRealFwide: ptr;
  GRealFpending: ptr;
  GRealFreading: ptr;
  GRealFwriting: ptr;
  GRealFreadable: ptr;
  GRealFwritable: ptr;
  GRealFlbf: ptr;
  GRealFbufsize: ptr;
  GRealFpurge: ptr;
  GRealFsetlocking: ptr;
  GRealVfprintf: ptr;
  GRealVfprintfChk: ptr;
  GRealVfwprintf: ptr;
  GRealVfwprintfChk: ptr;
  GRealVfscanf: ptr;
  GRealIsoc99Vfscanf: ptr;
  GRealVfwscanf: ptr;
  GRealIsoc99Vfwscanf: ptr;
  GRealFgetwc: ptr;
  GRealGetwc: ptr;
  GRealFgetwcUnlocked: ptr;
  GRealGetwcUnlocked: ptr;
  GRealFgetws: ptr;
  GRealFgetwsUnlocked: ptr;
  GRealFgetwsChk: ptr;
  GRealFgetwsUnlockedChk: ptr;
  GRealUngetwc: ptr;
  GRealFputwc: ptr;
  GRealPutwc: ptr;
  GRealFputwcUnlocked: ptr;
  GRealPutwcUnlocked: ptr;
  GRealFputws: ptr;
  GRealFputwsUnlocked: ptr;
  GRealAccess: ptr;
  GRealStat: ptr;
  GRealStat64: ptr;
  GRealLstat: ptr;
  GRealLstat64: ptr;
  GRealXstat: ptr;
  GRealXstat64: ptr;
  GRealLxstat: ptr;
  GRealLxstat64: ptr;
  GRealOpen: ptr;
  GRealOpen64: ptr;
  GRealOpen2: ptr;
  GRealOpen64Of2: ptr;
  GRealRead: ptr;
  GRealReadChk: ptr;
  GRealPread: ptr;
  GRealPread64: ptr;
  GRealPreadChk: ptr;
  GRealPread64Chk: ptr;
  GRealWrite: ptr;
  GRealPwrite: ptr;
  GRealPwrite64: ptr;
  GRealLseek: ptr;
  GRealLseek64: ptr;
  GRealMmap: ptr;
  GRealMmap64: ptr;
  GRealClose: ptr;
  GRealFstat: ptr;
  GRealFstat64: ptr;
  GRealFxstat: ptr;
  GRealFxstat64: ptr;
  GRealDup: ptr;
  GRealDup2: ptr;
  GRealDup3: ptr;
  GRealFcntl: ptr;
  GRealFcntl64: ptr;
  GRealFdopen: ptr;
  // The real functions the scans, the wide prints and the stand-ins call (never hooked
  // through these slots: their FILE is a real one)
  GRealCookieFclose: ptr;
  GRealCookieFtell: ptr;
  GRealCookieFeof: ptr;
  GRealStandInFopen: ptr;
  GRealMemFclose: ptr;
  GRealMemVfwprintf: ptr;
  GRealMemVfwprintfChk: ptr;

// --- the open list -------------------------------------------------------------------------

// The exit flush of open handles' written bytes, defined below
forward routine DoExitFlush();

// Records AHandle as open. The first open registers the exit flush (System.Runtime's AtExit):
// a C exit-time routine registered before it runs after it, the heap report last
routine DoAddHandle(const AHandle: ptr to HookHandle);
var
  LCount: int64;
begin
  lock (GLock) do
    LCount := len(GHandles);
    setlength(GHandles, LCount + 1);
    GHandles[LCount] := AHandle;
    atomicadd(GOpenCount, 1);
    if not GExitArmed then
      GExitArmed := true;
      AtExit(DoExitFlush);
    end;
  end;
end;

// The handle behind AFile with one more user (given back with DoReleaseHandle), or nil when
// AFile is not one (a real FILE, nil). While no handle is open no lock is taken
routine DoFindHandle(const AFile: ptr): ptr to HookHandle;
var
  LHandle: ptr to HookHandle;
  LI: int64;
begin
  if (AFile = nil) or (atomicload(GOpenCount) = 0) then
    return nil;
  end;
  lock (GLock) do
    for LI := 0 to len(GHandles) - 1 do
      LHandle := GHandles[LI];
      if ptr(LHandle) = AFile then
        LHandle->Users := LHandle->Users + 1;
        return LHandle;
      end;
    end;
  end;
  return nil;
end;

// Takes AFile out of the open list: its handle, still holding the open list's user, or nil
// when AFile is not one
routine DoTakeHandle(const AFile: ptr): ptr to HookHandle;
var
  LHandle: ptr to HookHandle;
  LCount: int64;
  LI: int64;
begin
  if (AFile = nil) or (atomicload(GOpenCount) = 0) then
    return nil;
  end;
  LHandle := nil;
  lock (GLock) do
    LCount := len(GHandles);
    LI := 0;
    while (LI < LCount) and (ptr(GHandles[LI]) <> AFile) do
      LI := LI + 1;
    end;
    if LI < LCount then
      LHandle := GHandles[LI];
      while LI < LCount - 1 do
        GHandles[LI] := GHandles[LI + 1];
        LI := LI + 1;
      end;
      setlength(GHandles, LCount - 1);
      atomicadd(GOpenCount, -1);
    end;
  end;
  return LHandle;
end;

// The model's own memory freed: its buffers (unless the caller's: _IO_USER_BUF, the wide
// _shortbuf) and its backup area (a wide stream's wide one), wherever the get areas stand;
// every area cleared. The iconv descriptors are closed
routine DoFreeModel(const AHandle: ptr to HookHandle);
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LWideBackup: bool;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  // The backup area's block: the get area's base while in it, else the save base (the flag is
  // the wide area's on a wide stream)
  LWideBackup := ((LIo->Flags & _IO_IN_BACKUP) <> 0u) and (LIo->Orientation > 0);
  if ((LIo->Flags & _IO_IN_BACKUP) <> 0u) and (not LWideBackup) then
    if LIo->ReadBase <> 0u then
      freemem(ptr(LIo->ReadBase));
    end;
  else
    if LIo->SaveBase <> 0u then
      freemem(ptr(LIo->SaveBase));
    end;
  end;
  if LWideBackup then
    if LWide->ReadBase <> 0u then
      freemem(ptr(LWide->ReadBase));
    end;
  else
    if LWide->SaveBase <> 0u then
      freemem(ptr(LWide->SaveBase));
    end;
  end;
  if (LIo->BufBase <> 0u) and ((LIo->Flags & _IO_USER_BUF) = 0u) then
    freemem(ptr(LIo->BufBase));
  end;
  if (LWide->BufBase <> 0u) and (not LWide->UserBuf) then
    freemem(ptr(LWide->BufBase));
  end;
  LIo->Flags := LIo->Flags & (~_IO_IN_BACKUP);
  LIo->ReadPtr := 0u;
  LIo->ReadEnd := 0u;
  LIo->ReadBase := 0u;
  LIo->WriteBase := 0u;
  LIo->WritePtr := 0u;
  LIo->WriteEnd := 0u;
  LIo->BufBase := 0u;
  LIo->BufEnd := 0u;
  LIo->SaveBase := 0u;
  LIo->BackupBase := 0u;
  LIo->SaveEnd := 0u;
  LWide->ReadPtr := 0u;
  LWide->ReadEnd := 0u;
  LWide->ReadBase := 0u;
  LWide->WriteBase := 0u;
  LWide->WritePtr := 0u;
  LWide->WriteEnd := 0u;
  LWide->BufBase := 0u;
  LWide->BufEnd := 0u;
  LWide->SaveBase := 0u;
  LWide->BackupBase := 0u;
  LWide->SaveEnd := 0u;
  LWide->UserBuf := false;
  LWide->LastState.Size := 0;
  if LWide->ToWide <> nil then
    iconv_close(LWide->ToWide);
    LWide->ToWide := nil;
  end;
  if LWide->ToBytes <> nil then
    iconv_close(LWide->ToBytes);
    LWide->ToBytes := nil;
  end;
end;

// Gives back one user of a handle, defined below
forward routine DoReleaseHandle(const AHandle: ptr to HookHandle);

// Frees a handle no one holds any more, its stream lock's user given back first (and the
// description an fdopen FILE that never closed still names)
routine DoFreeHandle(const AHandle: ptr to HookHandle);
var
  LHandle: ptr to HookHandle;
  LDesc: ptr to HookHandle;
begin
  if AHandle->Desc <> nil then
    LDesc := AHandle->Desc;
    AHandle->Desc := nil;
    DoReleaseHandle(LDesc);
  end;
  HookIOReleaseLock(AHandle->Base.Lock);
  DoFreeModel(AHandle);
  LHandle := AHandle;
  destroy(LHandle);
end;

// Gives back one user of AHandle; the last one frees it
routine DoReleaseHandle(const AHandle: ptr to HookHandle);
var
  LFree: bool;
begin
  lock (GLock) do
    AHandle->Users := AHandle->Users - 1;
    LFree := AHandle->Users = 0;
  end;
  if LFree then
    DoFreeHandle(AHandle);
  end;
end;

// The FILE head brought in step with the model: glibc's inline feof_unlocked / ferror_unlocked
// read _flags, and _mode is the orientation
routine DoMirror(const AHandle: ptr to HookHandle);
begin
  AHandle->Head._flags := int32(AHandle->Io.Flags);
  AHandle->Head._mode := AHandle->Io.Orientation;
  AHandle->Head._offset := AHandle->Io.Offset;
end;

// The handle whose description AHandle's system calls run on: an fdopen FILE's descriptor's
// handle (Desc), else AHandle itself
routine DoDescOf(const AHandle: ptr to HookHandle): ptr to HookHandle;
begin
  if AHandle->Desc <> nil then
    return AHandle->Desc;
  end;
  return AHandle;
end;

// --- the descriptor: glibc's read / write / lseek / fstat, on the handle's IO ---------------

// Moves the IO to the handle's Position: another handle on the same IO may have left it
// elsewhere. False: the IO cannot go there. A Pipe handle's IO has only its own place, where
// every read and write lands (true)
routine DoSyncLocked(const AHandle: ptr to HookHandle): bool;
begin
  if AHandle->Pipe then
    return true;
  end;
  if IOTell(AHandle->Base.Stream) = AHandle->Base.Position then
    return true;
  end;
  return IOSeek(AHandle->Base.Stream, AHandle->Base.Position, SeekOrigin.FromStart) =
    AHandle->Base.Position;
end;

// A Pipe handle's Replay bytes, up to ASize, moved into AData (the count): a pipe's read(2)
// hands out what it holds, so a short count is a whole read
routine DoTakeReplay(const AHandle: ptr to HookHandle; const AData: uint64; const ASize: int64): int64;
var
  LOut: ptr to uint8;
  LCount: int64;
begin
  LOut := ptr to uint8(AData);
  LCount := 0;
  while (LCount < ASize) and (AHandle->ReplayNext < len(AHandle->Replay)) do
    LOut[LCount] := AHandle->Replay[AHandle->ReplayNext];
    AHandle->ReplayNext := AHandle->ReplayNext + 1;
    LCount := LCount + 1;
  end;
  if AHandle->ReplayNext >= len(AHandle->Replay) then
    setlength(AHandle->Replay, 0);
    AHandle->ReplayNext := 0;
  end;
  return LCount;
end;

// read(2) of up to ASize bytes into AData at the place of description AHandle: the count (0
// at the end), or -1 with errno: a description without read rights EBADF, an IO that cannot
// read EIO.
// A Pipe handle reads its Replay bytes first, then the IO in order
routine DoDescRead(const AHandle: ptr to HookHandle; const AData: uint64; const ASize: int64): int64;
var
  LGot: int64;
begin
  if not AHandle->Readable then
    SetCErrno(ADAM_ERRNO_EBADF);
    return -1;
  end;
  if ASize <= 0 then
    return 0;
  end;
  if not DoSyncLocked(AHandle) then
    SetCErrno(ADAM_ERRNO_EIO);
    return -1;
  end;
  if AHandle->Pipe and (AHandle->ReplayNext < len(AHandle->Replay)) then
    LGot := DoTakeReplay(AHandle, AData, ASize);
  else
    LGot := IORead(AHandle->Base.Stream, ptr(AData), ASize);
  end;
  if LGot < 0 then
    LGot := 0;
  end;
  AHandle->Base.Position := AHandle->Base.Position + LGot;
  if (LGot = 0) and (IOStatus(AHandle->Base.Stream) <> IOState.Eof) then
    SetCErrno(ADAM_ERRNO_EIO);
    return -1;
  end;
  return LGot;
end;

// write(2) of ASize bytes at AData at the place of description AHandle (O_APPEND: the IO's
// end first). The count written, or -1 with errno: no write rights EBADF, nothing written
// ENOSPC
routine DoDescWrite(const AHandle: ptr to HookHandle; const AData: uint64; const ASize: int64): int64;
var
  LEnd: int64;
  LGot: int64;
begin
  if not AHandle->Writable then
    SetCErrno(ADAM_ERRNO_EBADF);
    return -1;
  end;
  if ASize <= 0 then
    return 0;
  end;
  // O_APPEND on a pipe changes nothing: every write lands after the last
  if AHandle->Appending and (not AHandle->Pipe) then
    LEnd := IOSeek(AHandle->Base.Stream, 0, SeekOrigin.FromEnd);
    if LEnd >= 0 then
      AHandle->Base.Position := LEnd;
    end;
  end;
  if not DoSyncLocked(AHandle) then
    SetCErrno(ADAM_ERRNO_EIO);
    return -1;
  end;
  LGot := IOWrite(AHandle->Base.Stream, ptr(AData), ASize);
  if LGot <= 0 then
    SetCErrno(ADAM_ERRNO_ENOSPC);
    return -1;
  end;
  AHandle->Base.Position := AHandle->Base.Position + LGot;
  return LGot;
end;

// The IO's size, as fstat's st_size of a regular file; false when the IO cannot tell (not a
// regular file: glibc's seek from the end then asks the descriptor)
routine DoSysSize(const AHandle: ptr to HookHandle; var ASize: int64): bool;
begin
  ASize := IOSize(DoDescOf(AHandle)->Base.Stream);
  return ASize >= 0;
end;

// lseek(2): description AHandle's place to AOffset from ADir (SEEK_SET / CUR / END). The new
// place, or -1 with errno: before the start, or a target the IO refuses, EINVAL; an IO that
// cannot seek ESPIPE
routine DoDescSeek(const AHandle: ptr to HookHandle; const AOffset: int64; const ADir: int32): int64;
var
  LTarget: int64;
  LEnd: int64;
  LGot: int64;
begin
  // A pipe / FIFO seeks nowhere, whatever the target (the kernel's no_llseek: ESPIPE before
  // the offset is looked at)
  if AHandle->Pipe then
    SetCErrno(ESPIPE);
    return -1;
  end;
  LTarget := AOffset;
  if ADir = _IO_seek_cur then
    LTarget := AHandle->Base.Position + AOffset;
  end;
  if ADir = _IO_seek_end then
    if not DoSysSize(AHandle, LEnd) then
      LEnd := IOSeek(AHandle->Base.Stream, 0, SeekOrigin.FromEnd);
      if LEnd < 0 then
        SetCErrno(ESPIPE);
        return -1;
      end;
    end;
    LTarget := LEnd + AOffset;
  end;
  if LTarget < 0 then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return -1;
  end;
  LGot := IOSeek(AHandle->Base.Stream, LTarget, SeekOrigin.FromStart);
  if LGot <> LTarget then
    // An IO that seeks but not there refuses the target (EINVAL); one that cannot even stay
    // where it is cannot seek (ESPIPE). The IO is left at the descriptor's place
    if IOSeek(AHandle->Base.Stream, AHandle->Base.Position, SeekOrigin.FromStart) =
      AHandle->Base.Position then
      SetCErrno(ADAM_ERRNO_EINVAL);
    else
      SetCErrno(ESPIPE);
    end;
    return -1;
  end;
  AHandle->Base.Position := LTarget;
  return LTarget;
end;

// A FILE's own system calls (libio's, through its descriptor): EBADF once close(2) ran on its
// _fileno (glibc's calls on a closed _fileno), else read(2) / write(2) / lseek(2) on its
// description (DoDescOf)
routine DoSysRead(const AHandle: ptr to HookHandle; const AData: uint64; const ASize: int64): int64;
begin
  if AHandle->DescriptorClosed then
    SetCErrno(ADAM_ERRNO_EBADF);
    return -1;
  end;
  return DoDescRead(DoDescOf(AHandle), AData, ASize);
end;
routine DoSysWrite(const AHandle: ptr to HookHandle; const AData: uint64; const ASize: int64): int64;
begin
  if AHandle->DescriptorClosed then
    SetCErrno(ADAM_ERRNO_EBADF);
    return -1;
  end;
  return DoDescWrite(DoDescOf(AHandle), AData, ASize);
end;
routine DoSysSeek(const AHandle: ptr to HookHandle; const AOffset: int64; const ADir: int32): int64;
begin
  if AHandle->DescriptorClosed then
    SetCErrno(ADAM_ERRNO_EBADF);
    return -1;
  end;
  return DoDescSeek(DoDescOf(AHandle), AOffset, ADir);
end;

// The IO's own flush (write(2) reaching the file): 0, or EOF with the error flag and EIO
routine DoFlushIOLocked(const AHandle: ptr to HookHandle): int32;
var
  LStream: IO;
begin
  if not AHandle->Writable then
    return 0;
  end;
  LStream := DoDescOf(AHandle)->Base.Stream;
  if (LStream = nil) or IOFlush(LStream) then
    return 0;
  end;
  AHandle->Io.Flags := AHandle->Io.Flags | _IO_ERR_SEEN;
  SetCErrno(ADAM_ERRNO_EIO);
  return ADAM_HOOKIO_EOF;
end;

// --- glibc's libio, on the model (glibc 2.39 libio/genops.c, fileops.c) ---------------------

// The byte at the address AAt
routine DoByteAt(const AAt: uint64): int32;
var
  LByte: ptr to uint8;
begin
  LByte := ptr to uint8(AAt);
  return int32(LByte^);
end;

// The byte AValue stored at the address AAt
routine DoPutByteAt(const AAt: uint64; const AValue: int32);
var
  LByte: ptr to uint8;
begin
  LByte := ptr to uint8(AAt);
  LByte^ := uint8(AValue & 0xFF);
end;

// ACount bytes copied from the address ASource to the address ADest (no overlap)
routine DoCopy(const ADest: uint64; const ASource: uint64; const ACount: int64);
begin
  CopyBytes(ptr to uint8(ADest), ptr to const uint8(ASource), ACount);
end;

// A scan's look ahead: up to ASize bytes of the IO at APosition (the descriptor's place or
// past it, read in order) into AData, the descriptor left where it is. A seekable IO is read
// there. A Pipe handle's IO cannot give a byte twice: the bytes already looked at come from
// Replay, new ones are read from the IO and kept in Replay for the descriptor's own reads
// (DoSysRead). The count, 0 at the end, -1 when the IO failed
routine DoPeekIO(const AHandle: ptr to HookHandle; const APosition: int64; const AData: uint64;
  const ASize: int64): int64;
var
  LAt: int64;
  LKept: int64;
  LCount: int64;
  LGot: int64;
  LDesc: ptr to HookHandle;
begin
  LDesc := DoDescOf(AHandle);
  if not LDesc->Pipe then
    if IOSeek(LDesc->Base.Stream, APosition, SeekOrigin.FromStart) <> APosition then
      return -1;
    end;
  else
    // APosition as an index into Replay (ReplayNext is the descriptor's place)
    LAt := LDesc->ReplayNext + (APosition - LDesc->Base.Position);
    LKept := len(LDesc->Replay);
    if (LAt < LDesc->ReplayNext) or (LAt > LKept) then
      return -1;
    end;
    if LAt < LKept then
      LCount := LKept - LAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      DoCopy(AData, uint64(addr of LDesc->Replay[LAt]), LCount);
      return LCount;
    end;
  end;
  LGot := IORead(LDesc->Base.Stream, ptr(AData), ASize);
  if LGot < 0 then
    return -1;
  end;
  if (LGot = 0) and (IOStatus(LDesc->Base.Stream) <> IOState.Eof) then
    return -1;
  end;
  if LDesc->Pipe and (LGot > 0) then
    LKept := len(LDesc->Replay);
    setlength(LDesc->Replay, LKept + LGot);
    DoCopy(uint64(addr of LDesc->Replay[LKept]), AData, LGot);
  end;
  return LGot;
end;

// The 64-bit word at the address AAt
routine DoWordAt(const AAt: uint64): uint64;
var
  LWord: ptr to uint64;
begin
  LWord := ptr to uint64(AAt);
  return LWord^;
end;

// The 32-bit int at the address AAt
routine DoInt32At(const AAt: uint64): int32;
var
  LValue: ptr to int32;
begin
  LValue := ptr to int32(AAt);
  return LValue^;
end;

// The wchar_t at the address AAt
routine DoWideAt(const AAt: uint64): uint32;
var
  LChar: ptr to uint32;
begin
  LChar := ptr to uint32(AAt);
  return LChar^;
end;

// The wchar_t AValue stored at the address AAt
routine DoPutWideAt(const AAt: uint64; const AValue: uint32);
var
  LChar: ptr to uint32;
begin
  LChar := ptr to uint32(AAt);
  LChar^ := AValue;
end;

// The wchar_t's from the address AStart to AEnd (glibc's wchar_t * difference; negative when
// AEnd is below AStart)
routine DoWideCount(const AStart: uint64; const AEnd: uint64): int64;
begin
  return (int64(AEnd) - int64(AStart)) div ADAM_HOOKIO_WCHAR_BYTES;
end;

// The address ACount wchar_t's past AAt (before it when ACount is negative)
routine DoWideStep(const AAt: uint64; const ACount: int64): uint64;
begin
  return uint64(int64(AAt) + ACount * ADAM_HOOKIO_WCHAR_BYTES);
end;

// _IO_setg: the get area
routine DoSetg(const AIo: ptr to HookLibio; const ABase: uint64; const APtr: uint64;
  const AEnd: uint64);
begin
  AIo->ReadBase := ABase;
  AIo->ReadPtr := APtr;
  AIo->ReadEnd := AEnd;
end;

// _IO_setp: the put area
routine DoSetp(const AIo: ptr to HookLibio; const APtr: uint64; const AEnd: uint64);
begin
  AIo->WriteBase := APtr;
  AIo->WritePtr := APtr;
  AIo->WriteEnd := AEnd;
end;

// _IO_setb: the reserve area, the old one freed unless it was the caller's; AOwned: the model
// made the new one (no _IO_USER_BUF)
routine DoSetb(const AIo: ptr to HookLibio; const ABase: uint64; const AEnd: uint64;
  const AOwned: bool);
begin
  if (AIo->BufBase <> 0u) and ((AIo->Flags & _IO_USER_BUF) = 0u) then
    freemem(ptr(AIo->BufBase));
  end;
  AIo->BufBase := ABase;
  AIo->BufEnd := AEnd;
  if AOwned then
    AIo->Flags := AIo->Flags & (~_IO_USER_BUF);
  else
    AIo->Flags := AIo->Flags | _IO_USER_BUF;
  end;
end;

// _IO_file_doallocate (filedoalloc.c): a buffer of the descriptor's block size (a handle's
// stat reports ADAM_HOOKIO_BLOCK_SIZE, below BUFSIZ, so glibc takes it); EOF when there is no
// memory
routine DoDoallocate(const AIo: ptr to HookLibio): int32;
var
  LBuffer: ptr;
begin
  LBuffer := getmem(ADAM_HOOKIO_BLOCK_SIZE);
  if LBuffer = nil then
    return ADAM_HOOKIO_EOF;
  end;
  DoSetb(AIo, uint64(LBuffer), uint64(LBuffer) + uint64(ADAM_HOOKIO_BLOCK_SIZE), true);
  return 1;
end;

// _IO_doallocbuf: a buffer unless there is one; an unbuffered byte stream (or a failed
// allocation) the one-byte _shortbuf
routine DoDoallocbuf(const AIo: ptr to HookLibio);
begin
  if AIo->BufBase <> 0u then
    return;
  end;
  if ((AIo->Flags & _IO_UNBUFFERED) = 0u) or (AIo->Orientation > 0) then
    if DoDoallocate(AIo) <> ADAM_HOOKIO_EOF then
      return;
    end;
  end;
  DoSetb(AIo, uint64(addr of AIo->ShortBuf), uint64(addr of AIo->ShortBuf) + 1u, false);
end;

// _IO_switch_to_main_get_area: from the backup area back to the main get area, at its start
routine DoSwitchToMainGetArea(const AIo: ptr to HookLibio);
var
  LSwap: uint64;
begin
  AIo->Flags := AIo->Flags & (~_IO_IN_BACKUP);
  LSwap := AIo->ReadEnd;
  AIo->ReadEnd := AIo->SaveEnd;
  AIo->SaveEnd := LSwap;
  LSwap := AIo->ReadBase;
  AIo->ReadBase := AIo->SaveBase;
  AIo->SaveBase := LSwap;
  AIo->ReadPtr := AIo->ReadBase;
end;

// _IO_switch_to_backup_area: the get area becomes the backup area, at its end
routine DoSwitchToBackupArea(const AIo: ptr to HookLibio);
var
  LSwap: uint64;
begin
  AIo->Flags := AIo->Flags | _IO_IN_BACKUP;
  LSwap := AIo->ReadEnd;
  AIo->ReadEnd := AIo->SaveEnd;
  AIo->SaveEnd := LSwap;
  LSwap := AIo->ReadBase;
  AIo->ReadBase := AIo->SaveBase;
  AIo->SaveBase := LSwap;
  AIo->ReadPtr := AIo->ReadEnd;
end;

// _IO_free_backup_area: the backup area freed (the main get area current first)
routine DoFreeBackupArea(const AIo: ptr to HookLibio);
begin
  if (AIo->Flags & _IO_IN_BACKUP) <> 0u then
    DoSwitchToMainGetArea(AIo);
  end;
  if AIo->SaveBase <> 0u then
    freemem(ptr(AIo->SaveBase));
  end;
  AIo->SaveBase := 0u;
  AIo->SaveEnd := 0u;
  AIo->BackupBase := 0u;
end;

// save_for_backup (genops.c) as it runs on a stream with no markers (a handle never has any):
// libio's least marker is then the end itself, nothing is appended, and the backup base goes
// to the backup area's end (all of it free)
routine DoSaveForBackup(const AIo: ptr to HookLibio): int32;
begin
  AIo->BackupBase := AIo->SaveEnd;
  return 0;
end;

forward routine DoFileOverflow(const AHandle: ptr to HookHandle; const AChar: int32): int32;
forward routine DoFileUnderflow(const AHandle: ptr to HookHandle): int32;
// The wide model's, defined with it below
forward routine DoWdoWrite(const AHandle: ptr to HookHandle; const AData: uint64;
  const ACount: int64): int32;
forward routine DoWfileOverflow(const AHandle: ptr to HookHandle; const AChar: int64): int64;
forward routine DoSync(const AHandle: ptr to HookHandle): int32;
forward routine DoFreeWbackupArea(const AHandle: ptr to HookHandle);
forward routine DoSwitchToWgetMode(const AHandle: ptr to HookHandle): int32;
forward routine DoWdefaultPbackfail(const AHandle: ptr to HookHandle; const AChar: uint32): int64;
forward routine DoWfileSeekoff(const AHandle: ptr to HookHandle; const AOffset: int64;
  const ADir: int32; const AMode: int32): int64;

// new_do_write (fileops.c): ACount bytes at AData to the descriptor, which first steps back
// over read-ahead (read_end not at write_base); an appending stream's place is unknown after.
// The get and put areas then start empty at the buffer (a line or unbuffered byte stream's put
// area at no room). The count written
routine DoNewDoWrite(const AHandle: ptr to HookHandle; const AData: uint64; const ACount: int64): int64;
var
  LIo: ptr to HookLibio;
  LPlace: int64;
  LCount: int64;
  LDone: int64;
  LGot: int64;
  LAt: int64;
begin
  LIo := addr of AHandle->Io;
  if (LIo->Flags & _IO_IS_APPENDING) <> 0u then
    LIo->Offset := ADAM_HOOKIO_POS_BAD;
  else
    if LIo->ReadEnd <> LIo->WriteBase then
      LPlace := DoSysSeek(AHandle, int64(LIo->WriteBase - LIo->ReadEnd), _IO_seek_cur);
      if LPlace = ADAM_HOOKIO_POS_BAD then
        return 0;
      end;
      LIo->Offset := LPlace;
    end;
  end;
  // _IO_new_file_write: write(2) until all is written or it fails (the error flag)
  LDone := 0;
  while LDone < ACount do
    LGot := DoSysWrite(AHandle, AData + uint64(LDone), ACount - LDone);
    if LGot < 0 then
      LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
      leave;
    end;
    LDone := LDone + LGot;
  end;
  if LIo->Offset >= 0 then
    LIo->Offset := LIo->Offset + LDone;
  end;
  LCount := LDone;
  // _IO_adjust_column: the column after the bytes (the last newline's distance from the end)
  if (LIo->CurColumn <> 0u) and (LCount > 0) then
    LAt := LCount;
    while (LAt > 0) and (DoByteAt(AData + uint64(LAt - 1)) <> ADAM_HOOKIO_NEWLINE) do
      LAt := LAt - 1;
    end;
    if LAt > 0 then
      LIo->CurColumn := uint32(LCount - LAt) + 1u;
    else
      LIo->CurColumn := LIo->CurColumn + uint32(LCount);
    end;
  end;
  DoSetg(LIo, LIo->BufBase, LIo->BufBase, LIo->BufBase);
  LIo->WriteBase := LIo->BufBase;
  LIo->WritePtr := LIo->BufBase;
  if (LIo->Orientation <= 0) and ((LIo->Flags & (_IO_LINE_BUF | _IO_UNBUFFERED)) <> 0u) then
    LIo->WriteEnd := LIo->BufBase;
  else
    LIo->WriteEnd := LIo->BufEnd;
  end;
  return LCount;
end;

// _IO_new_do_write: 0 when all ACount bytes were written (or none asked), else EOF
routine DoDoWrite(const AHandle: ptr to HookHandle; const AData: uint64; const ACount: int64): int32;
begin
  if (ACount = 0) or (DoNewDoWrite(AHandle, AData, ACount) = ACount) then
    return 0;
  end;
  return ADAM_HOOKIO_EOF;
end;

// _IO_do_flush: the put area's bytes written (a wide stream's wide put area's characters)
routine DoDoFlush(const AHandle: ptr to HookHandle): int32;
begin
  if AHandle->Io.Orientation > 0 then
    return DoWdoWrite(AHandle, AHandle->Wide.WriteBase,
      DoWideCount(AHandle->Wide.WriteBase, AHandle->Wide.WritePtr));
  end;
  return DoDoWrite(AHandle, AHandle->Io.WriteBase,
    int64(AHandle->Io.WritePtr - AHandle->Io.WriteBase));
end;

// _IO_switch_to_get_mode: written bytes flushed (_IO_OVERFLOW: a wide stream's jumps' wide
// overflow), the get area taken up where the put area stood
routine DoSwitchToGetMode(const AHandle: ptr to HookHandle): int32;
var
  LIo: ptr to HookLibio;
begin
  LIo := addr of AHandle->Io;
  if LIo->WritePtr > LIo->WriteBase then
    if LIo->Orientation > 0 then
      if DoWfileOverflow(AHandle, int64(ADAM_HOOKIO_WEOF)) = int64(ADAM_HOOKIO_WEOF) then
        return ADAM_HOOKIO_EOF;
      end;
    else
      if DoFileOverflow(AHandle, ADAM_HOOKIO_EOF) = ADAM_HOOKIO_EOF then
        return ADAM_HOOKIO_EOF;
      end;
    end;
  end;
  if (LIo->Flags & _IO_IN_BACKUP) <> 0u then
    LIo->ReadBase := LIo->BackupBase;
  else
    LIo->ReadBase := LIo->BufBase;
    if LIo->WritePtr > LIo->ReadEnd then
      LIo->ReadEnd := LIo->WritePtr;
    end;
  end;
  LIo->ReadPtr := LIo->WritePtr;
  LIo->WriteBase := LIo->ReadPtr;
  LIo->WritePtr := LIo->ReadPtr;
  LIo->WriteEnd := LIo->ReadPtr;
  LIo->Flags := LIo->Flags & (~_IO_CURRENTLY_PUTTING);
  return 0;
end;

// glibc's stdout flushed when it is line buffered and linked (fileops.c: a line or unbuffered
// stream's fill does it); its _flags read from its own FILE head
routine DoFlushLineStdout();
var
  LHead: ptr to int32;
  LFlags: uint32;
  LFound: ptr;
  LFlush: FileIntFn;
begin
  if stdout = nil then
    return;
  end;
  LHead := ptr to int32(stdout);
  LFlags := uint32(LHead^);
  if (LFlags & (_IO_LINKED | _IO_NO_WRITES | _IO_LINE_BUF)) = (_IO_LINKED | _IO_LINE_BUF) then
    // stdout is a real FILE: glibc's own fflush
    LFound := HookReal(GRealFflush, ptr to const char("fflush"));
    if LFound <> nil then
      LFlush := FileIntFn(LFound);
      LFlush(stdout);
    end;
  end;
end;

// _IO_new_file_underflow: the next byte without taking it, after a fill if the get area is
// empty; EOF at the end (sticky: _IO_EOF_SEEN) or on a failure (_IO_ERR_SEEN; a stream that
// cannot read EBADF)
routine DoFileUnderflow(const AHandle: ptr to HookHandle): int32;
var
  LIo: ptr to HookLibio;
  LCount: int64;
begin
  LIo := addr of AHandle->Io;
  if (LIo->Flags & _IO_EOF_SEEN) <> 0u then
    return ADAM_HOOKIO_EOF;
  end;
  if (LIo->Flags & _IO_NO_READS) <> 0u then
    LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
    SetCErrno(ADAM_ERRNO_EBADF);
    return ADAM_HOOKIO_EOF;
  end;
  if LIo->ReadPtr < LIo->ReadEnd then
    return DoByteAt(LIo->ReadPtr);
  end;
  if LIo->BufBase = 0u then
    // Maybe there is a push back area already
    if LIo->SaveBase <> 0u then
      freemem(ptr(LIo->SaveBase));
      LIo->SaveBase := 0u;
      LIo->SaveEnd := 0u;
      LIo->BackupBase := 0u;
      LIo->Flags := LIo->Flags & (~_IO_IN_BACKUP);
    end;
    DoDoallocbuf(LIo);
  end;
  if (LIo->Flags & (_IO_LINE_BUF | _IO_UNBUFFERED)) <> 0u then
    DoFlushLineStdout();
  end;
  DoSwitchToGetMode(AHandle);
  DoSetg(LIo, LIo->BufBase, LIo->BufBase, LIo->BufBase);
  DoSetp(LIo, LIo->BufBase, LIo->BufBase);
  LCount := DoSysRead(AHandle, LIo->BufBase, int64(LIo->BufEnd - LIo->BufBase));
  if LCount <= 0 then
    if LCount = 0 then
      LIo->Flags := LIo->Flags | _IO_EOF_SEEN;
    else
      LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
      LCount := 0;
    end;
  end;
  LIo->ReadEnd := LIo->ReadEnd + uint64(LCount);
  if LCount = 0 then
    // A stream read to its end may change hands: the descriptor's place is no longer known
    LIo->Offset := ADAM_HOOKIO_POS_BAD;
    return ADAM_HOOKIO_EOF;
  end;
  if LIo->Offset <> ADAM_HOOKIO_POS_BAD then
    LIo->Offset := LIo->Offset + LCount;
  end;
  return DoByteAt(LIo->ReadPtr);
end;

// _IO_new_file_overflow: AChar (EOF: none, only a flush) into the put area, which is set up
// from the get area when the stream was reading; a full buffer flushed first; an unbuffered
// stream, or a line-buffered one at a newline, flushed after. The byte, or EOF (a stream that
// cannot write: the error flag and EBADF)
routine DoFileOverflow(const AHandle: ptr to HookHandle; const AChar: int32): int32;
var
  LIo: ptr to HookLibio;
  LBackup: uint64;
  LStep: uint64;
begin
  LIo := addr of AHandle->Io;
  if (LIo->Flags & _IO_NO_WRITES) <> 0u then
    LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
    SetCErrno(ADAM_ERRNO_EBADF);
    return ADAM_HOOKIO_EOF;
  end;
  if ((LIo->Flags & _IO_CURRENTLY_PUTTING) = 0u) or (LIo->WriteBase = 0u) then
    if LIo->WriteBase = 0u then
      DoDoallocbuf(LIo);
      DoSetg(LIo, LIo->BufBase, LIo->BufBase, LIo->BufBase);
    end;
    if (LIo->Flags & _IO_IN_BACKUP) <> 0u then
      LBackup := LIo->ReadEnd - LIo->ReadPtr;
      DoFreeBackupArea(LIo);
      LStep := LIo->ReadBase - LIo->BufBase;
      if LBackup < LStep then
        LStep := LBackup;
      end;
      LIo->ReadBase := LIo->ReadBase - LStep;
      LIo->ReadPtr := LIo->ReadBase;
    end;
    if LIo->ReadPtr = LIo->BufEnd then
      LIo->ReadEnd := LIo->BufBase;
      LIo->ReadPtr := LIo->BufBase;
    end;
    LIo->WritePtr := LIo->ReadPtr;
    LIo->WriteBase := LIo->WritePtr;
    LIo->WriteEnd := LIo->BufEnd;
    LIo->ReadBase := LIo->ReadEnd;
    LIo->ReadPtr := LIo->ReadEnd;
    LIo->Flags := LIo->Flags | _IO_CURRENTLY_PUTTING;
    if (LIo->Orientation <= 0) and ((LIo->Flags & (_IO_LINE_BUF | _IO_UNBUFFERED)) <> 0u) then
      LIo->WriteEnd := LIo->WritePtr;
    end;
  end;
  if AChar = ADAM_HOOKIO_EOF then
    return DoDoWrite(AHandle, LIo->WriteBase, int64(LIo->WritePtr - LIo->WriteBase));
  end;
  // The buffer is really full
  if LIo->WritePtr = LIo->BufEnd then
    if DoDoFlush(AHandle) = ADAM_HOOKIO_EOF then
      return ADAM_HOOKIO_EOF;
    end;
  end;
  DoPutByteAt(LIo->WritePtr, AChar);
  LIo->WritePtr := LIo->WritePtr + 1u;
  if ((LIo->Flags & _IO_UNBUFFERED) <> 0u) or
    (((LIo->Flags & _IO_LINE_BUF) <> 0u) and ((AChar & 0xFF) = ADAM_HOOKIO_NEWLINE)) then
    if DoDoWrite(AHandle, LIo->WriteBase, int64(LIo->WritePtr - LIo->WriteBase)) =
      ADAM_HOOKIO_EOF then
      return ADAM_HOOKIO_EOF;
    end;
  end;
  return AChar & 0xFF;
end;

// _IO_new_file_sync: written bytes flushed, the descriptor stepped back over read-ahead (an IO
// that cannot seek is let be); the descriptor's place unknown after. 0 or EOF
routine DoFileSync(const AHandle: ptr to HookHandle): int32;
var
  LIo: ptr to HookLibio;
  LDelta: int64;
  LResult: int32;
  LPlace: int64;
begin
  LIo := addr of AHandle->Io;
  LResult := 0;
  if LIo->WritePtr > LIo->WriteBase then
    if DoDoFlush(AHandle) <> 0 then
      return ADAM_HOOKIO_EOF;
    end;
  end;
  LDelta := int64(LIo->ReadPtr - LIo->ReadEnd);
  if LDelta <> 0 then
    LPlace := DoSysSeek(AHandle, LDelta, _IO_seek_cur);
    if LPlace <> ADAM_HOOKIO_POS_BAD then
      LIo->ReadEnd := LIo->ReadPtr;
    else
      if CErrno() <> ESPIPE then
        LResult := ADAM_HOOKIO_EOF;
      end;
    end;
  end;
  if LResult <> ADAM_HOOKIO_EOF then
    LIo->Offset := ADAM_HOOKIO_POS_BAD;
  end;
  return LResult;
end;

// _IO_default_uflow, the underflow taken: the next byte, or EOF
routine DoDefaultUflow(const AHandle: ptr to HookHandle): int32;
var
  LByte: int32;
begin
  LByte := DoFileUnderflow(AHandle);
  if LByte = ADAM_HOOKIO_EOF then
    return ADAM_HOOKIO_EOF;
  end;
  LByte := DoByteAt(AHandle->Io.ReadPtr);
  AHandle->Io.ReadPtr := AHandle->Io.ReadPtr + 1u;
  return LByte;
end;

// _IO_fwide (iofwide.c) with its mode folded to -1 / 0 / 1: the orientation, set once (0 only
// asks). A stream turning wide takes its conversion (DoOpenConversion), defined below
forward routine DoOpenConversion(const AHandle: ptr to HookHandle): bool;
routine DoFwide(const AHandle: ptr to HookHandle; const AMode: int32): int32;
var
  LMode: int32;
begin
  LMode := 0;
  if AMode < 0 then
    LMode := -1;
  end;
  if AMode > 0 then
    LMode := 1;
  end;
  if (AHandle->Io.Orientation <> 0) or (LMode = 0) then
    return AHandle->Io.Orientation;
  end;
  if LMode > 0 then
    // glibc asserts its conversion loads; a charset iconv lacks leaves the stream unoriented
    if not DoOpenConversion(AHandle) then
      return AHandle->Io.Orientation;
    end;
  end;
  AHandle->Io.Orientation := LMode;
  return LMode;
end;

// The body __uflow / __underflow share once the orientation is checked: put mode left, the get
// area's byte, else the main get area after the backup one, else the backup area freed and the
// file's underflow (ATake: the byte is taken, __uflow; else only looked at, __underflow)
routine DoFlowBody(const AHandle: ptr to HookHandle; const ATake: bool): int32;
var
  LIo: ptr to HookLibio;
  LByte: int32;
begin
  LIo := addr of AHandle->Io;
  if (LIo->Flags & _IO_CURRENTLY_PUTTING) <> 0u then
    if DoSwitchToGetMode(AHandle) = ADAM_HOOKIO_EOF then
      return ADAM_HOOKIO_EOF;
    end;
  end;
  if LIo->ReadPtr < LIo->ReadEnd then
    LByte := DoByteAt(LIo->ReadPtr);
    if ATake then
      LIo->ReadPtr := LIo->ReadPtr + 1u;
    end;
    return LByte;
  end;
  if (LIo->Flags & _IO_IN_BACKUP) <> 0u then
    DoSwitchToMainGetArea(LIo);
    if LIo->ReadPtr < LIo->ReadEnd then
      LByte := DoByteAt(LIo->ReadPtr);
      if ATake then
        LIo->ReadPtr := LIo->ReadPtr + 1u;
      end;
      return LByte;
    end;
  end;
  if LIo->SaveBase <> 0u then
    DoFreeBackupArea(LIo);
  end;
  if ATake then
    return DoDefaultUflow(AHandle);
  end;
  return DoFileUnderflow(AHandle);
end;

// __uflow (genops.c): a wide stream refuses (EOF); an unoriented one turns byte-oriented; then
// the next byte taken
routine DoUflow(const AHandle: ptr to HookHandle): int32;
begin
  if DoFwide(AHandle, -1) <> -1 then
    return ADAM_HOOKIO_EOF;
  end;
  return DoFlowBody(AHandle, true);
end;

// __underflow (genops.c): as DoUflow, the byte only looked at
routine DoUnderflow(const AHandle: ptr to HookHandle): int32;
begin
  if DoFwide(AHandle, -1) <> -1 then
    return ADAM_HOOKIO_EOF;
  end;
  return DoFlowBody(AHandle, false);
end;

// __overflow (genops.c): an unoriented stream turns byte-oriented, then _IO_OVERFLOW (a wide
// stream's jumps' wide overflow, AChar as a wide character: EOF its WEOF, a flush)
routine DoOverflow(const AHandle: ptr to HookHandle; const AChar: int32): int32;
begin
  if AHandle->Io.Orientation = 0 then
    DoFwide(AHandle, -1);
  end;
  if AHandle->Io.Orientation > 0 then
    return int32(DoWfileOverflow(AHandle, int64(AChar)));
  end;
  return DoFileOverflow(AHandle, AChar);
end;

// getc's _IO_getc_unlocked: a byte of the get area, else __uflow
routine DoGetc(const AHandle: ptr to HookHandle): int32;
var
  LByte: int32;
begin
  if AHandle->Io.ReadPtr < AHandle->Io.ReadEnd then
    LByte := DoByteAt(AHandle->Io.ReadPtr);
    AHandle->Io.ReadPtr := AHandle->Io.ReadPtr + 1u;
    return LByte;
  end;
  return DoUflow(AHandle);
end;

// putc's _IO_putc_unlocked: a byte into the put area's room, else __overflow
routine DoPutc(const AHandle: ptr to HookHandle; const AChar: int32): int32;
begin
  if AHandle->Io.WritePtr < AHandle->Io.WriteEnd then
    DoPutByteAt(AHandle->Io.WritePtr, AChar);
    AHandle->Io.WritePtr := AHandle->Io.WritePtr + 1u;
    return AChar & 0xFF;
  end;
  return DoOverflow(AHandle, AChar & 0xFF);
end;

// _IO_peekc_unlocked: the next byte without taking it (the get area's, else __underflow)
routine DoPeekc(const AHandle: ptr to HookHandle): int32;
begin
  if AHandle->Io.ReadPtr >= AHandle->Io.ReadEnd then
    if DoUnderflow(AHandle) = ADAM_HOOKIO_EOF then
      return ADAM_HOOKIO_EOF;
    end;
  end;
  return DoByteAt(AHandle->Io.ReadPtr);
end;

// _IO_default_pbackfail: AChar given back where the get area cannot simply step back: into the
// backup area (opened at 128 bytes, doubled when full). The byte, or EOF (no memory)
routine DoPbackfail(const AHandle: ptr to HookHandle; const AChar: int32): int32;
var
  LIo: ptr to HookLibio;
  LArea: ptr;
  LOld: int64;
  LNew: int64;
begin
  LIo := addr of AHandle->Io;
  if (LIo->ReadPtr > LIo->ReadBase) and ((LIo->Flags & _IO_IN_BACKUP) = 0u) and
    (DoByteAt(LIo->ReadPtr - 1u) = AChar) then
    LIo->ReadPtr := LIo->ReadPtr - 1u;
    return AChar;
  end;
  if (LIo->Flags & _IO_IN_BACKUP) = 0u then
    // The main get area must stay logically after the backup area
    if (LIo->ReadPtr > LIo->ReadBase) and (LIo->SaveBase <> 0u) then
      if DoSaveForBackup(LIo) <> 0 then
        return ADAM_HOOKIO_EOF;
      end;
    else
      if LIo->SaveBase = 0u then
        LArea := getmem(ADAM_HOOKIO_BACKUP_SIZE);
        if LArea = nil then
          return ADAM_HOOKIO_EOF;
        end;
        LIo->SaveBase := uint64(LArea);
        LIo->SaveEnd := LIo->SaveBase + uint64(ADAM_HOOKIO_BACKUP_SIZE);
        LIo->BackupBase := LIo->SaveEnd;
      end;
    end;
    LIo->ReadBase := LIo->ReadPtr;
    DoSwitchToBackupArea(LIo);
  else
    if LIo->ReadPtr <= LIo->ReadBase then
      // The backup area is full: doubled, its bytes at the new one's end
      LOld := int64(LIo->ReadEnd - LIo->ReadBase);
      LNew := 2 * LOld;
      LArea := getmem(LNew);
      if LArea = nil then
        return ADAM_HOOKIO_EOF;
      end;
      DoCopy(uint64(LArea) + uint64(LNew - LOld), LIo->ReadBase, LOld);
      freemem(ptr(LIo->ReadBase));
      DoSetg(LIo, uint64(LArea), uint64(LArea) + uint64(LNew - LOld), uint64(LArea) + uint64(LNew));
      LIo->BackupBase := LIo->ReadPtr;
    end;
  end;
  LIo->ReadPtr := LIo->ReadPtr - 1u;
  DoPutByteAt(LIo->ReadPtr, AChar);
  return AChar;
end;

// _IO_sputbackc: AChar (a byte) given back; a success clears the end flag. A stream putting
// bytes leaves put mode first (its bytes flushed, _IO_switch_to_get_mode): glibc's ungetc there
// opens a backup area beside a live put area, and its next flush seeks the descriptor by the
// distance between the two blocks (C leaves an ungetc after a write without an fflush or a
// seek undefined; glibc's own fflush leaves the put flag on, so the same happens after one), so
// a handle reads the ungot byte, then the file at the caller's place (a wide stream leaves its
// wide put mode the same way, and gives the byte back through the wide pbackfail, as glibc's
// wide jumps do)
routine DoSputbackc(const AHandle: ptr to HookHandle; const AChar: int32): int32;
var
  LIo: ptr to HookLibio;
  LResult: int32;
begin
  LIo := addr of AHandle->Io;
  if (LIo->Flags & _IO_CURRENTLY_PUTTING) <> 0u then
    if LIo->Orientation > 0 then
      if DoSwitchToWgetMode(AHandle) = ADAM_HOOKIO_EOF then
        return ADAM_HOOKIO_EOF;
      end;
    else
      if DoSwitchToGetMode(AHandle) = ADAM_HOOKIO_EOF then
        return ADAM_HOOKIO_EOF;
      end;
    end;
  end;
  if (LIo->ReadPtr > LIo->ReadBase) and (DoByteAt(LIo->ReadPtr - 1u) = AChar) then
    LIo->ReadPtr := LIo->ReadPtr - 1u;
    LResult := AChar;
  else
    if LIo->Orientation > 0 then
      // _IO_PBACKFAIL: a wide stream's jumps' _IO_wdefault_pbackfail
      LResult := int32(DoWdefaultPbackfail(AHandle, uint32(AChar & 0xFF)));
    else
      LResult := DoPbackfail(AHandle, AChar);
    end;
  end;
  if LResult <> ADAM_HOOKIO_EOF then
    LIo->Flags := LIo->Flags & (~_IO_EOF_SEEN);
  end;
  return LResult;
end;

// _IO_default_xsputn: ACount bytes at AData through the put area's room, __overflow for each
// byte past it; the count put
routine DoDefaultXsputn(const AHandle: ptr to HookHandle; const AData: uint64; const ACount: int64): int64;
var
  LIo: ptr to HookLibio;
  LMore: int64;
  LCount: int64;
  LFrom: uint64;
begin
  LIo := addr of AHandle->Io;
  LMore := ACount;
  LFrom := AData;
  if LMore <= 0 then
    return 0;
  end;
  while true do
    if LIo->WritePtr < LIo->WriteEnd then
      LCount := int64(LIo->WriteEnd - LIo->WritePtr);
      if LCount > LMore then
        LCount := LMore;
      end;
      DoCopy(LIo->WritePtr, LFrom, LCount);
      LIo->WritePtr := LIo->WritePtr + uint64(LCount);
      LFrom := LFrom + uint64(LCount);
      LMore := LMore - LCount;
    end;
    if LMore = 0 then
      leave;
    end;
    if DoFileOverflow(AHandle, DoByteAt(LFrom)) = ADAM_HOOKIO_EOF then
      leave;
    end;
    LFrom := LFrom + 1u;
    LMore := LMore - 1;
  end;
  return ACount - LMore;
end;

// _IO_new_file_xsputn: ACount bytes at AData: the put area's room first (a line-buffered
// stream's up to its last newline, then a flush), then the buffer flushed, whole blocks
// straight to the descriptor, the rest through the buffer. The count put, or ADAM_HOOKIO_MAX_SIZE
// (C's (size_t) EOF) when the flush failed with nothing left to put
routine DoFileXsputn(const AHandle: ptr to HookHandle; const AData: uint64; const ACount: int64): uint64;
var
  LIo: ptr to HookLibio;
  LFrom: uint64;
  LToDo: int64;
  LMustFlush: bool;
  LCount: int64;
  LAt: int64;
  LBlock: int64;
  LDoWrite: int64;
  LWritten: int64;
begin
  LIo := addr of AHandle->Io;
  LFrom := AData;
  LToDo := ACount;
  LMustFlush := false;
  LCount := 0;
  if ACount <= 0 then
    return 0u;
  end;
  if ((LIo->Flags & _IO_LINE_BUF) <> 0u) and ((LIo->Flags & _IO_CURRENTLY_PUTTING) <> 0u) then
    LCount := int64(LIo->BufEnd - LIo->WritePtr);
    if LCount >= ACount then
      LAt := ACount;
      while LAt > 0 do
        LAt := LAt - 1;
        if DoByteAt(LFrom + uint64(LAt)) = ADAM_HOOKIO_NEWLINE then
          LCount := LAt + 1;
          LMustFlush := true;
          leave;
        end;
      end;
    end;
  else
    if LIo->WriteEnd > LIo->WritePtr then
      LCount := int64(LIo->WriteEnd - LIo->WritePtr);
    end;
  end;
  if LCount > 0 then
    if LCount > LToDo then
      LCount := LToDo;
    end;
    DoCopy(LIo->WritePtr, LFrom, LCount);
    LIo->WritePtr := LIo->WritePtr + uint64(LCount);
    LFrom := LFrom + uint64(LCount);
    LToDo := LToDo - LCount;
  end;
  if (LToDo > 0) or LMustFlush then
    if DoFileOverflow(AHandle, ADAM_HOOKIO_EOF) = ADAM_HOOKIO_EOF then
      // Nothing else to put: the caller must not hear that everything was
      if LToDo = 0 then
        return ADAM_HOOKIO_MAX_SIZE;
      end;
      return uint64(ACount - LToDo);
    end;
    // Whole blocks straight to the descriptor
    LBlock := int64(LIo->BufEnd - LIo->BufBase);
    LDoWrite := LToDo;
    if LBlock >= 128 then
      LDoWrite := LToDo - (LToDo mod LBlock);
    end;
    if LDoWrite > 0 then
      LWritten := DoNewDoWrite(AHandle, LFrom, LDoWrite);
      LToDo := LToDo - LWritten;
      if LWritten < LDoWrite then
        return uint64(ACount - LToDo);
      end;
    end;
    // The rest through the buffer (a line-buffered stream's way included)
    if LToDo > 0 then
      LToDo := LToDo - DoDefaultXsputn(AHandle, LFrom + uint64(LDoWrite), LToDo);
    end;
  end;
  return uint64(ACount - LToDo);
end;

// _IO_file_xsgetn: up to ACount bytes into AData: the get area's (the backup area's, then the
// main one's), refills while less than a buffer is wanted, else whole blocks read straight
// into AData; the end or a failure sets its flag. The count read
routine DoFileXsgetn(const AHandle: ptr to HookHandle; const AData: uint64; const ACount: int64): int64;
var
  LIo: ptr to HookLibio;
  LWant: int64;
  LHave: int64;
  LTo: uint64;
  LCount: int64;
  LBlock: int64;
begin
  LIo := addr of AHandle->Io;
  LWant := ACount;
  LTo := AData;
  if LIo->BufBase = 0u then
    // Maybe there is a push back area already (glibc frees it and keeps reading the get
    // area as it stands: the area freed is never read before the switch below)
    if (LIo->SaveBase <> 0u) and ((LIo->Flags & _IO_IN_BACKUP) = 0u) then
      freemem(ptr(LIo->SaveBase));
      LIo->SaveBase := 0u;
      LIo->SaveEnd := 0u;
      LIo->BackupBase := 0u;
    end;
    DoDoallocbuf(LIo);
  end;
  while LWant > 0 do
    LHave := int64(LIo->ReadEnd - LIo->ReadPtr);
    if LWant <= LHave then
      DoCopy(LTo, LIo->ReadPtr, LWant);
      LIo->ReadPtr := LIo->ReadPtr + uint64(LWant);
      LWant := 0;
    else
      if LHave > 0 then
        DoCopy(LTo, LIo->ReadPtr, LHave);
        LTo := LTo + uint64(LHave);
        LWant := LWant - LHave;
        LIo->ReadPtr := LIo->ReadPtr + uint64(LHave);
      end;
      // A backup area read: the main get area next
      if (LIo->Flags & _IO_IN_BACKUP) <> 0u then
        DoSwitchToMainGetArea(LIo);
        skip;
      end;
      // Less than a buffer wanted: a fill, then the copy again
      if (LIo->BufBase <> 0u) and (LWant < int64(LIo->BufEnd - LIo->BufBase)) then
        if DoUnderflow(AHandle) = ADAM_HOOKIO_EOF then
          leave;
        end;
        skip;
      end;
      DoSetg(LIo, LIo->BufBase, LIo->BufBase, LIo->BufBase);
      DoSetp(LIo, LIo->BufBase, LIo->BufBase);
      // Whole blocks read straight to the caller
      LCount := LWant;
      if LIo->BufBase <> 0u then
        LBlock := int64(LIo->BufEnd - LIo->BufBase);
        if LBlock >= 128 then
          LCount := LCount - (LWant mod LBlock);
        end;
      end;
      LCount := DoSysRead(AHandle, LTo, LCount);
      if LCount <= 0 then
        if LCount = 0 then
          LIo->Flags := LIo->Flags | _IO_EOF_SEEN;
        else
          LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
        end;
        leave;
      end;
      LTo := LTo + uint64(LCount);
      LWant := LWant - LCount;
      if LIo->Offset <> ADAM_HOOKIO_POS_BAD then
        LIo->Offset := LIo->Offset + LCount;
      end;
    end;
  end;
  return ACount - LWant;
end;

// do_ftell (fileops.c): the place a seek to 0 from here would give, the buffer's unread bytes
// taken off and its unflushed ones added (an appending stream's measured from the IO's end);
// EOF (errno set) when the descriptor cannot tell or the place is negative (EINVAL)
routine DoTellRaw(const AHandle: ptr to HookHandle): int64;
var
  LIo: ptr to HookLibio;
  LResult: int64;
  LOffset: int64;
  LUnflushed: bool;
  LAppending: bool;
begin
  LIo := addr of AHandle->Io;
  LOffset := 0;
  if LIo->BufBase <> 0u then
    LUnflushed := LIo->WritePtr > LIo->WriteBase;
    LAppending := (LIo->Flags & _IO_IS_APPENDING) <> 0u;
    if LUnflushed and LAppending then
      LResult := DoSysSeek(AHandle, 0, _IO_seek_end);
      if LResult = ADAM_HOOKIO_POS_BAD then
        return ADAM_HOOKIO_EOF;
      end;
      LIo->Offset := LResult;
    end;
    if not LUnflushed then
      LOffset := LOffset - int64(LIo->ReadEnd - LIo->ReadPtr);
    else
      if LAppending then
        LOffset := LOffset + int64(LIo->WritePtr - LIo->WriteBase);
      else
        LOffset := LOffset + int64(LIo->WritePtr - LIo->ReadEnd);
      end;
    end;
  end;
  if LIo->Offset <> ADAM_HOOKIO_POS_BAD then
    LResult := LIo->Offset;
  else
    LResult := DoSysSeek(AHandle, 0, _IO_seek_cur);
  end;
  if LResult = ADAM_HOOKIO_EOF then
    return LResult;
  end;
  LResult := LResult + LOffset;
  if LResult < 0 then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return ADAM_HOOKIO_EOF;
  end;
  return LResult;
end;

// _IO_new_file_seekoff: AMode 0 is ftell's (DoTellRaw); else a seek to AOffset from ADir:
// written bytes flushed, a seek inside the buffer only moving in it, else block-aligned
// read-ahead (or a bare seek, "dumb", for a stream that cannot read or an origin it cannot
// make absolute); the end flag cleared. The new place, or EOF
routine DoFileSeekoff(const AHandle: ptr to HookHandle; const AOffset: int64; const ADir: int32;
  const AMode: int32): int64;
var
  LIo: ptr to HookLibio;
  LOffset: int64;
  LDir: int32;
  LExact: bool;
  LWriting: bool;
  LSize: int64;
  LStart: int64;
  LNewOffset: int64;
  LDelta: int64;
  LBlock: int64;
  LResult: int64;
  LCount: int64;
  LDumb: bool;
begin
  LIo := addr of AHandle->Io;
  if AMode = 0 then
    return DoTellRaw(AHandle);
  end;
  LOffset := AOffset;
  LDir := ADir;
  LDumb := false;
  // POSIX: after an fflush the file offset must be exact
  LExact := (LIo->ReadBase = LIo->ReadEnd) and (LIo->WriteBase = LIo->WritePtr);
  LWriting := (LIo->WritePtr > LIo->WriteBase) or ((LIo->Flags & _IO_CURRENTLY_PUTTING) <> 0u);
  if LWriting and (DoSwitchToGetMode(AHandle) <> 0) then
    return ADAM_HOOKIO_EOF;
  end;
  if LIo->BufBase = 0u then
    // A push back area already there (glibc frees it as the get area's base)
    if LIo->ReadBase <> 0u then
      freemem(ptr(LIo->ReadBase));
      LIo->Flags := LIo->Flags & (~_IO_IN_BACKUP);
      LIo->SaveBase := 0u;
      LIo->SaveEnd := 0u;
      LIo->BackupBase := 0u;
    end;
    DoDoallocbuf(LIo);
    DoSetp(LIo, LIo->BufBase, LIo->BufBase);
    DoSetg(LIo, LIo->BufBase, LIo->BufBase, LIo->BufBase);
  end;
  if LDir = _IO_seek_cur then
    // The read-ahead taken off
    LOffset := LOffset - int64(LIo->ReadEnd - LIo->ReadPtr);
    if LIo->Offset = ADAM_HOOKIO_POS_BAD then
      LDumb := true;
    else
      LOffset := LOffset + LIo->Offset;
      if LOffset < 0 then
        SetCErrno(ADAM_ERRNO_EINVAL);
        return ADAM_HOOKIO_EOF;
      end;
      LDir := _IO_seek_set;
    end;
  else
    if LDir = _IO_seek_end then
      if DoSysSize(AHandle, LSize) then
        LOffset := LOffset + LSize;
        LDir := _IO_seek_set;
      else
        LDumb := true;
      end;
    end;
  end;
  if not LDumb then
    DoFreeBackupArea(LIo);
    // A place inside the current buffer: only the get area moves
    if (LIo->Offset <> ADAM_HOOKIO_POS_BAD) and (LIo->ReadBase <> 0u) and
      ((LIo->Flags & _IO_IN_BACKUP) = 0u) then
      LStart := LIo->Offset - int64(LIo->ReadEnd - LIo->BufBase);
      if (LOffset >= LStart) and (LOffset < LIo->Offset) then
        DoSetg(LIo, LIo->BufBase, LIo->BufBase + uint64(LOffset - LStart), LIo->ReadEnd);
        DoSetp(LIo, LIo->BufBase, LIo->BufBase);
        LIo->Flags := LIo->Flags & (~_IO_EOF_SEEN);
        // resync: the descriptor put back where the model has it
        if LIo->Offset >= 0 then
          DoSysSeek(AHandle, LIo->Offset, _IO_seek_set);
        end;
        return LOffset;
      end;
    end;
    if (LIo->Flags & _IO_NO_READS) <> 0u then
      LDumb := true;
    end;
  end;
  if not LDumb then
    // A block boundary, for the kernel's page management
    LBlock := int64(LIo->BufEnd - LIo->BufBase);
    LNewOffset := LOffset & (~(LBlock - 1));
    LDelta := LOffset - LNewOffset;
    if LDelta > LBlock then
      LNewOffset := LOffset;
      LDelta := 0;
    end;
    LResult := DoSysSeek(AHandle, LNewOffset, _IO_seek_set);
    if LResult < 0 then
      return ADAM_HOOKIO_EOF;
    end;
    if LDelta = 0 then
      LCount := 0;
    else
      if LExact then
        LCount := DoSysRead(AHandle, LIo->BufBase, LDelta);
      else
        LCount := DoSysRead(AHandle, LIo->BufBase, LBlock);
      end;
      if LCount < LDelta then
        // Not allowed to read: the rest by a seek
        if LCount = ADAM_HOOKIO_EOF then
          LOffset := LDelta;
        else
          LOffset := LDelta - LCount;
        end;
        LDir := _IO_seek_cur;
        LDumb := true;
      end;
    end;
    if not LDumb then
      DoSetg(LIo, LIo->BufBase, LIo->BufBase + uint64(LDelta), LIo->BufBase + uint64(LCount));
      DoSetp(LIo, LIo->BufBase, LIo->BufBase);
      LIo->Offset := LResult + LCount;
      LIo->Flags := LIo->Flags & (~_IO_EOF_SEEN);
      return LOffset;
    end;
  end;
  // dumb: a bare seek of the descriptor
  LResult := DoSysSeek(AHandle, LOffset, LDir);
  if LResult <> ADAM_HOOKIO_EOF then
    LIo->Flags := LIo->Flags & (~_IO_EOF_SEEN);
    LIo->Offset := LResult;
    DoSetg(LIo, LIo->BufBase, LIo->BufBase, LIo->BufBase);
    DoSetp(LIo, LIo->BufBase, LIo->BufBase);
  end;
  return LResult;
end;

// _IO_seekoff_unlocked (ioseekoff.c): an origin it does not know is EINVAL; a seek (AMode not
// 0) drops the backup area first, a byte stream's seek from here counting the ungot bytes off
// (a wide stream's aborts the program, as glibc's does); then the file's seekoff (a wide stream's
// jumps' _IO_wfile_seekoff)
routine DoSeekoffUnlocked(const AHandle: ptr to HookHandle; const AOffset: int64; const ADir: int32;
  const AMode: int32): int64;
var
  LIo: ptr to HookLibio;
  LOffset: int64;
begin
  LIo := addr of AHandle->Io;
  LOffset := AOffset;
  if (ADir <> _IO_seek_cur) and (ADir <> _IO_seek_set) and (ADir <> _IO_seek_end) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return ADAM_HOOKIO_EOF;
  end;
  if AMode <> 0 then
    if (LIo->Orientation > 0) and (AHandle->Wide.SaveBase <> 0u) then
      if (ADir = _IO_seek_cur) and ((LIo->Flags & _IO_IN_BACKUP) <> 0u) then
        // glibc aborts here (ioseekoff.c), and so does a handle
        abort();
      end;
      DoFreeWbackupArea(AHandle);
    end;
    if (LIo->Orientation <= 0) and (LIo->SaveBase <> 0u) then
      if (ADir = _IO_seek_cur) and ((LIo->Flags & _IO_IN_BACKUP) <> 0u) then
        LOffset := LOffset - int64(LIo->ReadEnd - LIo->ReadPtr);
      end;
      DoFreeBackupArea(LIo);
    end;
  end;
  if LIo->Orientation > 0 then
    return DoWfileSeekoff(AHandle, LOffset, ADir, AMode);
  end;
  return DoFileSeekoff(AHandle, LOffset, ADir, AMode);
end;

// ftell (ioftell.c): the place, a byte stream's ungot bytes in the backup area counted off; -1
// with errno (EIO when the model set none)
routine DoTell(const AHandle: ptr to HookHandle): int64;
var
  LPlace: int64;
begin
  LPlace := DoSeekoffUnlocked(AHandle, 0, _IO_seek_cur, 0);
  if LPlace <> ADAM_HOOKIO_POS_BAD then
    if ((AHandle->Io.Flags & _IO_IN_BACKUP) <> 0u) and (AHandle->Io.Orientation <= 0) then
      LPlace := LPlace - int64(AHandle->Io.SaveEnd - AHandle->Io.SaveBase);
    end;
  end;
  if LPlace = ADAM_HOOKIO_POS_BAD then
    if CErrno() = 0 then
      SetCErrno(ADAM_ERRNO_EIO);
    end;
    return -1;
  end;
  return LPlace;
end;

// fseek's _IO_fseek: 0, or -1
routine DoSeek(const AHandle: ptr to HookHandle; const AOffset: int64; const ADir: int32): int64;
begin
  if DoSeekoffUnlocked(AHandle, AOffset, ADir, ADAM_HOOKIO_SEEK_MODE) = ADAM_HOOKIO_POS_BAD then
    return -1;
  end;
  return 0;
end;

// _IO_new_file_setbuf over _IO_default_setbuf: the stream synced, the new reserve area (nil
// or no size: unbuffered, the one-byte _shortbuf), every area empty at it. nil-like false when
// the sync failed. glibc reads freed memory here while ungot bytes sit in the backup area (its
// sync steps over the backup area and the get area is left on the freed buffer): a handle then
// keeps the ungot bytes as they are, steps the descriptor back over the main get area's
// read-ahead and takes up the new buffer empty after them. A wide stream syncs as glibc's
// _IO_wfile_sync does (its wide areas are not freed here)
routine DoFileSetbuf(const AHandle: ptr to HookHandle; const ABuffer: uint64; const ASize: int64): bool;
var
  LIo: ptr to HookLibio;
  LAhead: int64;
  LPlace: int64;
begin
  LIo := addr of AHandle->Io;
  if ((LIo->Flags & _IO_IN_BACKUP) <> 0u) and (LIo->Orientation <= 0) then
    if LIo->WritePtr > LIo->WriteBase then
      if DoDoFlush(AHandle) <> 0 then
        return false;
      end;
    end;
    // The main get area's unread bytes (save area while in the backup one)
    LAhead := int64(LIo->SaveEnd - LIo->SaveBase);
    if LAhead <> 0 then
      LPlace := DoSysSeek(AHandle, -LAhead, _IO_seek_cur);
      if (LPlace = ADAM_HOOKIO_POS_BAD) and (CErrno() <> ESPIPE) then
        return false;
      end;
    end;
    LIo->Offset := ADAM_HOOKIO_POS_BAD;
  else
    if DoSync(AHandle) = ADAM_HOOKIO_EOF then
      return false;
    end;
  end;
  if (ABuffer = 0u) or (ASize = 0) then
    LIo->Flags := LIo->Flags | _IO_UNBUFFERED;
    DoSetb(LIo, uint64(addr of LIo->ShortBuf), uint64(addr of LIo->ShortBuf) + 1u, false);
  else
    LIo->Flags := LIo->Flags & (~_IO_UNBUFFERED);
    DoSetb(LIo, ABuffer, ABuffer + uint64(ASize), false);
  end;
  if ((LIo->Flags & _IO_IN_BACKUP) <> 0u) and (LIo->Orientation <= 0) then
    // The main get area, after the backup one, starts empty at the new buffer
    LIo->SaveBase := LIo->BufBase;
    LIo->SaveEnd := LIo->BufBase;
  else
    DoSetg(LIo, LIo->BufBase, LIo->BufBase, LIo->BufBase);
  end;
  DoSetp(LIo, LIo->BufBase, LIo->BufBase);
  return true;
end;

// setvbuf (iosetvbuf.c): AMode _IOFBF / _IOLBF / _IONBF, ABuffer the caller's array (nil: the
// model's own, made now for _IOFBF if there is none); 0, or EOF for a mode it does not know or
// a failed sync (errno untouched by the refusal)
routine DoSetvbuf(const AHandle: ptr to HookHandle; const ABuffer: uint64; const AMode: int32;
  const ASize: uint64): int32;
var
  LIo: ptr to HookLibio;
  LBuffer: uint64;
  LSize: uint64;
begin
  LIo := addr of AHandle->Io;
  LBuffer := ABuffer;
  LSize := ASize;
  if AMode = _IOFBF then
    LIo->Flags := LIo->Flags & (~(_IO_LINE_BUF | _IO_UNBUFFERED));
    if LBuffer = 0u then
      if LIo->BufBase = 0u then
        if DoDoallocate(LIo) < 0 then
          return ADAM_HOOKIO_EOF;
        end;
        LIo->Flags := LIo->Flags & (~_IO_LINE_BUF);
      end;
      return 0;
    end;
  else
    if AMode = _IOLBF then
      LIo->Flags := LIo->Flags & (~_IO_UNBUFFERED);
      LIo->Flags := LIo->Flags | _IO_LINE_BUF;
      if LBuffer = 0u then
        return 0;
      end;
    else
      if AMode = _IONBF then
        LIo->Flags := LIo->Flags & (~_IO_LINE_BUF);
        LIo->Flags := LIo->Flags | _IO_UNBUFFERED;
        LBuffer := 0u;
        LSize := 0u;
      else
        return ADAM_HOOKIO_EOF;
      end;
    end;
  end;
  if not DoFileSetbuf(AHandle, LBuffer, int64(LSize)) then
    return ADAM_HOOKIO_EOF;
  end;
  return 0;
end;

// _IO_setbuffer (iosetbuffer.c): not line buffered; nil is unbuffered
routine DoSetbuffer(const AHandle: ptr to HookHandle; const ABuffer: uint64; const ASize: uint64);
var
  LSize: uint64;
begin
  AHandle->Io.Flags := AHandle->Io.Flags & (~_IO_LINE_BUF);
  LSize := ASize;
  if ABuffer = 0u then
    LSize := 0u;
  end;
  DoFileSetbuf(AHandle, ABuffer, int64(LSize));
end;

// _IO_getline_info (iogetline.c): up to ACount bytes into ABuffer up to and with ADelim (kept
// when AExtract > 0, given back when below 0); the count stored
routine DoGetline(const AHandle: ptr to HookHandle; const ABuffer: uint64; const ACount: int64;
  const ADelim: int32; const AExtract: int32): int64;
var
  LIo: ptr to HookLibio;
  LTo: uint64;
  LLeft: int64;
  LLength: int64;
  LByte: int32;
  LFound: int64;
  LI: int64;
begin
  LIo := addr of AHandle->Io;
  LTo := ABuffer;
  LLeft := ACount;
  if LIo->Orientation = 0 then
    DoFwide(AHandle, -1);
  end;
  while LLeft <> 0 do
    LLength := int64(LIo->ReadEnd - LIo->ReadPtr);
    if LLength <= 0 then
      LByte := DoUflow(AHandle);
      if LByte = ADAM_HOOKIO_EOF then
        leave;
      end;
      if LByte = ADelim then
        if AExtract > 0 then
          DoPutByteAt(LTo, LByte);
          LTo := LTo + 1u;
        else
          if AExtract < 0 then
            DoSputbackc(AHandle, LByte);
          end;
        end;
        return int64(LTo - ABuffer);
      end;
      DoPutByteAt(LTo, LByte);
      LTo := LTo + 1u;
      LLeft := LLeft - 1;
    else
      if LLength >= LLeft then
        LLength := LLeft;
      end;
      LFound := -1;
      LI := 0;
      while LI < LLength do
        if DoByteAt(LIo->ReadPtr + uint64(LI)) = ADelim then
          LFound := LI;
          leave;
        end;
        LI := LI + 1;
      end;
      if LFound >= 0 then
        LLength := LFound;
        if AExtract > 0 then
          LLength := LLength + 1;
        end;
        DoCopy(LTo, LIo->ReadPtr, LLength);
        LTo := LTo + uint64(LLength);
        LIo->ReadPtr := LIo->ReadPtr + uint64(LFound);
        if AExtract >= 0 then
          LIo->ReadPtr := LIo->ReadPtr + 1u;
        end;
        return int64(LTo - ABuffer);
      end;
      DoCopy(LTo, LIo->ReadPtr, LLength);
      LIo->ReadPtr := LIo->ReadPtr + uint64(LLength);
      LTo := LTo + uint64(LLength);
      LLeft := LLeft - LLength;
    end;
  end;
  return int64(LTo - ABuffer);
end;

// --- the wide model (glibc 2.39 libio/wfileops.c, wgenops.c, wfiledoalloc.c, iofwide.c) ----

// The text of the C string AText (nil: "")
routine DoCText(const AText: ptr to const char): string;
begin
  if AText = nil then
    return "";
  end;
  return StringFromC(AText);
end;

// The bytes of an iconv descriptor's conversion state: every step's __gconv_step_data (the
// shift state and the invocation count glibc's conversions keep there). 0 when the descriptor
// is not laid out as glibc 2.39's (a step's __statep not pointing at its own __state): its
// state is then not saved
routine DoCvStateSize(const ADescriptor: ptr): int64;
var
  LInfo: uint64;
  LSteps: int64;
  LI: int64;
  LData: uint64;
begin
  if (ADescriptor = nil) or (uint64(ADescriptor) = ADAM_HOOKIO_ICONV_FAILED) then
    return 0;
  end;
  LInfo := uint64(ADescriptor);
  LSteps := int64(DoWordAt(LInfo));
  if (LSteps < 1) or (LSteps > ADAM_HOOKIO_GCONV_MAX_STEPS) then
    return 0;
  end;
  for LI := 0 to LSteps - 1 do
    LData := LInfo + uint64(ADAM_HOOKIO_GCONV_DATA + LI * ADAM_HOOKIO_GCONV_DATA_SIZE);
    if DoWordAt(LData + uint64(ADAM_HOOKIO_GCONV_STATEP)) <>
      LData + uint64(ADAM_HOOKIO_GCONV_STATE) then
      return 0;
    end;
  end;
  return LSteps * ADAM_HOOKIO_GCONV_DATA_SIZE;
end;

// ADescriptor's conversion state copied into AState (a __mbstate_t copy, as glibc's
// _IO_last_state = _IO_state)
routine DoCvSave(const ADescriptor: ptr; var AState: HookCvState);
var
  LSize: int64;
begin
  LSize := DoCvStateSize(ADescriptor);
  AState.Size := LSize;
  if LSize > 0 then
    DoCopy(uint64(addr of AState.Data[0]), uint64(ADescriptor) + uint64(ADAM_HOOKIO_GCONV_DATA), LSize);
  end;
end;

// ADescriptor's conversion state set back to AState (one DoCvSave made of it)
routine DoCvLoad(const ADescriptor: ptr; var AState: HookCvState);
begin
  if (AState.Size > 0) and (DoCvStateSize(ADescriptor) = AState.Size) then
    DoCopy(uint64(ADescriptor) + uint64(ADAM_HOOKIO_GCONV_DATA), uint64(addr of AState.Data[0]),
      AState.Size);
  end;
end;

// __libio_codecvt_encoding, read from the descriptor's first step as glibc reads its
// codecvt's __cd_in.step: -1 for a stateful charset, the bytes of every character for a
// fixed-width one, 0 for a variable-width one (and for a layout this unit does not know)
routine DoCvEncoding(const ADescriptor: ptr): int32;
var
  LStep: uint64;
  LMin: int32;
  LMax: int32;
begin
  if DoCvStateSize(ADescriptor) = 0 then
    return 0;
  end;
  LStep := DoWordAt(uint64(ADescriptor) + uint64(ADAM_HOOKIO_GCONV_STEPS));
  if LStep = 0u then
    return 0;
  end;
  if DoInt32At(LStep + uint64(ADAM_HOOKIO_GCONV_STATEFUL)) <> 0 then
    return -1;
  end;
  LMin := DoInt32At(LStep + uint64(ADAM_HOOKIO_GCONV_MIN_FROM));
  LMax := DoInt32At(LStep + uint64(ADAM_HOOKIO_GCONV_MAX_FROM));
  if (LMin < 1) or (LMin > int32(ADAM_HOOKIO_MB_MAX)) then
    return 0;
  end;
  if LMin = LMax then
    return LMin;
  end;
  return 0;
end;

// One conversion run of ADescriptor from AFrom..AFromEnd into ATo..AToEnd (addresses), where
// it stopped in AFromStop / AToStop, answered as __libio_codecvt_in / _out answer: Ok when
// all the input was taken, Partial when the output is full or the input ends inside a
// character, Error at input that is no character. errno is left as it was
routine DoCvRun(const ADescriptor: ptr; const AFrom: uint64; const AFromEnd: uint64;
  var AFromStop: uint64; const ATo: uint64; const AToEnd: uint64; var AToStop: uint64): HookCv;
var
  LIn: ptr to uint8;
  LInLeft: uint64;
  LOut: ptr to uint8;
  LOutLeft: uint64;
  LErrno: int32;
  LFailure: int32;
  LGot: uint64;
begin
  AFromStop := AFrom;
  AToStop := ATo;
  if AFromEnd <= AFrom then
    // gconv's __GCONV_EMPTY_INPUT (iconv with no input would reset the state instead)
    return HookCv.Ok;
  end;
  if AToEnd <= ATo then
    // gconv's __GCONV_FULL_OUTPUT before a byte is taken
    return HookCv.Partial;
  end;
  LIn := ptr to uint8(AFrom);
  LInLeft := AFromEnd - AFrom;
  LOut := ptr to uint8(ATo);
  LOutLeft := AToEnd - ATo;
  LErrno := CErrno();
  LGot := iconv(ADescriptor, addr of LIn, addr of LInLeft, addr of LOut, addr of LOutLeft);
  LFailure := CErrno();
  SetCErrno(LErrno);
  AFromStop := uint64(LIn);
  AToStop := uint64(LOut);
  if LGot <> ADAM_HOOKIO_ICONV_FAILED then
    return HookCv.Ok;
  end;
  if LFailure = ADAM_ERRNO_EILSEQ then
    return HookCv.Error;
  end;
  return HookCv.Partial;
end;

// __libio_codecvt_length: how many of the bytes AFrom..AFromEnd make at most AMax characters
// (ToWide's state moves on with them, as glibc's statep does)
routine DoCvLength(const AHandle: ptr to HookHandle; const AFrom: uint64; const AFromEnd: uint64;
  const AMax: int64): int64;
var
  LBuffer: ptr;
  LStop: uint64;
  LOutStop: uint64;
begin
  if (AMax <= 0) or (AFromEnd <= AFrom) then
    return 0;
  end;
  LBuffer := getmem(AMax * ADAM_HOOKIO_WCHAR_BYTES);
  if LBuffer = nil then
    return 0;
  end;
  DoCvRun(AHandle->Wide.ToWide, AFrom, AFromEnd, LStop, uint64(LBuffer),
    DoWideStep(uint64(LBuffer), AMax), LOutStop);
  freemem(LBuffer);
  return int64(LStop - AFrom);
end;

// iconv between the stream's charset and glibc's wchar_t ("WCHAR_T"): a ccs= open's, else the
// LC_CTYPE codeset now (nl_langinfo(CODESET), as _IO_fwide's __wcsmbs_clone_conv takes it);
// output transliterates (glibc's __GCONV_TRANSLIT). The charset's encoding read from its step,
// the start state kept as _IO_last_state. False when iconv knows no such charset
routine DoOpenConversion(const AHandle: ptr to HookHandle): bool;
var
  LCharset: string;
  LIn: string;
  LOut: string;
  LCIn: ptr to char;
  LCOut: ptr to char;
  LWide: ptr to char;
  LToWide: ptr;
  LToBytes: ptr;
begin
  if AHandle->Wide.ToWide <> nil then
    return true;
  end;
  LCharset := AHandle->Wide.Charset;
  if len(LCharset) = 0 then
    AHandle->Wide.Codeset := DoCText(nl_langinfo(CODESET));
    LIn := AHandle->Wide.Codeset;
    LOut := AHandle->Wide.Codeset + "//TRANSLIT";
  else
    // strip's form already ends in "//"
    LIn := LCharset;
    LOut := LCharset + "TRANSLIT";
  end;
  LCIn := StringToC(LIn);
  LCOut := StringToC(LOut);
  LWide := StringToC("WCHAR_T");
  LToWide := iconv_open(LWide, LCIn);
  LToBytes := iconv_open(LCOut, LWide);
  freemem(LCIn);
  freemem(LCOut);
  freemem(LWide);
  if (uint64(LToWide) = ADAM_HOOKIO_ICONV_FAILED) or (uint64(LToBytes) = ADAM_HOOKIO_ICONV_FAILED) then
    if uint64(LToWide) <> ADAM_HOOKIO_ICONV_FAILED then
      iconv_close(LToWide);
    end;
    if uint64(LToBytes) <> ADAM_HOOKIO_ICONV_FAILED then
      iconv_close(LToBytes);
    end;
    SetCErrno(ADAM_ERRNO_EINVAL);
    return false;
  end;
  AHandle->Wide.ToWide := LToWide;
  AHandle->Wide.ToBytes := LToBytes;
  AHandle->Wide.Encoding := DoCvEncoding(LToWide);
  DoCvSave(LToWide, AHandle->Wide.LastState);
  return true;
end;

// _IO_wsetg: the wide get area
routine DoWsetg(const AWide: ptr to HookWide; const ABase: uint64; const APtr: uint64;
  const AEnd: uint64);
begin
  AWide->ReadBase := ABase;
  AWide->ReadPtr := APtr;
  AWide->ReadEnd := AEnd;
end;

// _IO_wsetp: the wide put area
routine DoWsetp(const AWide: ptr to HookWide; const APtr: uint64; const AEnd: uint64);
begin
  AWide->WriteBase := APtr;
  AWide->WritePtr := APtr;
  AWide->WriteEnd := AEnd;
end;

// _IO_wsetb: the wide reserve area, the old one freed unless it was not the model's
// (_IO_FLAGS2_USER_WBUF: the _shortbuf); AOwned: the model made the new one
routine DoWsetb(const AWide: ptr to HookWide; const ABase: uint64; const AEnd: uint64;
  const AOwned: bool);
begin
  if (AWide->BufBase <> 0u) and (not AWide->UserBuf) then
    freemem(ptr(AWide->BufBase));
  end;
  AWide->BufBase := ABase;
  AWide->BufEnd := AEnd;
  AWide->UserBuf := not AOwned;
end;

// _IO_wfile_doallocate (wfiledoalloc.c): the byte buffer made first if there is none, then as
// many characters as it has bytes (a caller's byte buffer: as many as its bytes hold); EOF
// when there is no memory
routine DoWdoallocate(const AHandle: ptr to HookHandle): int32;
var
  LIo: ptr to HookLibio;
  LSize: int64;
  LBuffer: ptr;
begin
  LIo := addr of AHandle->Io;
  if LIo->BufBase = 0u then
    DoDoallocate(LIo);
  end;
  LSize := int64(LIo->BufEnd - LIo->BufBase);
  if (LIo->Flags & _IO_USER_BUF) <> 0u then
    LSize := (LSize + ADAM_HOOKIO_WCHAR_BYTES - 1) div ADAM_HOOKIO_WCHAR_BYTES;
  end;
  if LSize <= 0 then
    return ADAM_HOOKIO_EOF;
  end;
  LBuffer := getmem(LSize * ADAM_HOOKIO_WCHAR_BYTES);
  if LBuffer = nil then
    return ADAM_HOOKIO_EOF;
  end;
  DoWsetb(addr of AHandle->Wide, uint64(LBuffer), DoWideStep(uint64(LBuffer), LSize), true);
  return 1;
end;

// _IO_wdoallocbuf: a wide buffer unless there is one; an unbuffered stream (or a failed
// allocation) the one-character _shortbuf
routine DoWdoallocbuf(const AHandle: ptr to HookHandle);
var
  LWide: ptr to HookWide;
begin
  LWide := addr of AHandle->Wide;
  if LWide->BufBase <> 0u then
    return;
  end;
  if (AHandle->Io.Flags & _IO_UNBUFFERED) = 0u then
    if DoWdoallocate(AHandle) <> ADAM_HOOKIO_EOF then
      return;
    end;
  end;
  DoWsetb(LWide, uint64(addr of LWide->ShortBuf), DoWideStep(uint64(addr of LWide->ShortBuf), 1),
    false);
end;

// _IO_switch_to_main_wget_area: from the wide backup area back to the main get area, at its
// start
routine DoSwitchToMainWgetArea(const AHandle: ptr to HookHandle);
var
  LWide: ptr to HookWide;
  LSwap: uint64;
begin
  LWide := addr of AHandle->Wide;
  AHandle->Io.Flags := AHandle->Io.Flags & (~_IO_IN_BACKUP);
  LSwap := LWide->ReadEnd;
  LWide->ReadEnd := LWide->SaveEnd;
  LWide->SaveEnd := LSwap;
  LSwap := LWide->ReadBase;
  LWide->ReadBase := LWide->SaveBase;
  LWide->SaveBase := LSwap;
  LWide->ReadPtr := LWide->ReadBase;
end;

// _IO_switch_to_wbackup_area: the wide get area becomes the backup area, at its end
routine DoSwitchToWbackupArea(const AHandle: ptr to HookHandle);
var
  LWide: ptr to HookWide;
  LSwap: uint64;
begin
  LWide := addr of AHandle->Wide;
  AHandle->Io.Flags := AHandle->Io.Flags | _IO_IN_BACKUP;
  LSwap := LWide->ReadEnd;
  LWide->ReadEnd := LWide->SaveEnd;
  LWide->SaveEnd := LSwap;
  LSwap := LWide->ReadBase;
  LWide->ReadBase := LWide->SaveBase;
  LWide->SaveBase := LSwap;
  LWide->ReadPtr := LWide->ReadEnd;
end;

// _IO_free_wbackup_area: the wide backup area freed (the main get area current first)
routine DoFreeWbackupArea(const AHandle: ptr to HookHandle);
var
  LWide: ptr to HookWide;
begin
  LWide := addr of AHandle->Wide;
  if (AHandle->Io.Flags & _IO_IN_BACKUP) <> 0u then
    DoSwitchToMainWgetArea(AHandle);
  end;
  if LWide->SaveBase <> 0u then
    freemem(ptr(LWide->SaveBase));
  end;
  LWide->SaveBase := 0u;
  LWide->SaveEnd := 0u;
  LWide->BackupBase := 0u;
end;

// _IO_wdo_write: ACount characters at AData converted into the byte put area (a spare
// MB_LEN_MAX bytes when it has less room) and written as they are made; then every wide area
// empty at the wide buffer (a line or unbuffered stream's put area at no room). 0, or WEOF
// when a write failed or a character does not convert
routine DoWdoWrite(const AHandle: ptr to HookHandle; const AData: uint64; const ACount: int64): int32;
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LData: uint64;
  LToDo: int64;
  LResult: HookCv;
  LNewData: uint64;
  LSpare: HookMbBytes;
  LWriteBase: uint64;
  LWritePtr: uint64;
  LBufEnd: uint64;
  LOutStop: uint64;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  LData := AData;
  LToDo := ACount;
  if LToDo > 0 then
    if (LIo->WriteEnd = LIo->WritePtr) and (LIo->WriteEnd <> LIo->WriteBase) then
      if DoDoWrite(AHandle, LIo->WriteBase, int64(LIo->WritePtr - LIo->WriteBase)) =
        ADAM_HOOKIO_EOF then
        return ADAM_HOOKIO_WEOF;
      end;
    end;
    while true do
      if int64(LIo->BufEnd) - int64(LIo->WritePtr) < ADAM_HOOKIO_MB_MAX then
        // Room for at least one multibyte character
        LWriteBase := uint64(addr of LSpare[0]);
        LWritePtr := LWriteBase;
        LBufEnd := LWriteBase + uint64(ADAM_HOOKIO_MB_MAX);
      else
        LWritePtr := LIo->WritePtr;
        LWriteBase := LIo->WriteBase;
        LBufEnd := LIo->BufEnd;
      end;
      LResult := DoCvRun(LWide->ToBytes, LData, DoWideStep(LData, LToDo), LNewData, LWritePtr,
        LBufEnd, LOutStop);
      // What was made so far written out
      if DoDoWrite(AHandle, LWriteBase, int64(LOutStop - LWriteBase)) = ADAM_HOOKIO_EOF then
        return ADAM_HOOKIO_WEOF;
      end;
      LToDo := LToDo - DoWideCount(LData, LNewData);
      if (LResult <> HookCv.Ok) and ((LResult <> HookCv.Partial) or (LNewData = LData)) then
        leave;
      end;
      LData := LNewData;
      if LToDo <= 0 then
        leave;
      end;
    end;
  end;
  DoWsetg(LWide, LWide->BufBase, LWide->BufBase, LWide->BufBase);
  LWide->WriteBase := LWide->BufBase;
  LWide->WritePtr := LWide->BufBase;
  if (LIo->Flags & (_IO_LINE_BUF | _IO_UNBUFFERED)) <> 0u then
    LWide->WriteEnd := LWide->BufBase;
  else
    LWide->WriteEnd := LWide->BufEnd;
  end;
  if LToDo = 0 then
    return 0;
  end;
  return ADAM_HOOKIO_WEOF;
end;

// ACount bytes moved from the address ASource down to ADest (ADest below ASource: memmove's
// overlap read front to back)
routine DoMoveDown(const ADest: uint64; const ASource: uint64; const ACount: int64);
var
  LI: int64;
begin
  for LI := 0 to ACount - 1 do
    DoPutByteAt(ADest + uint64(LI), DoByteAt(ASource + uint64(LI)));
  end;
end;

// _IO_wfile_underflow: the next character without taking it: bytes left in the byte get area
// converted first, else a fill of the byte buffer converted into the wide one (a character cut
// by the fill's end kept in an MB_LEN_MAX spare and read on). WEOF at the end (sticky), on a
// failure (the error flag; a stream that cannot read EBADF) and on bytes that are no character
// (EILSEQ). glibc's two slips are kept sane: a freed byte or wide backup area is forgotten (its
// pointer is left dangling there), and bytes moved down after input that made no character end
// where they were moved to (glibc's read_end -= avail)
routine DoWfileUnderflow(const AHandle: ptr to HookHandle): int64;
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LStatus: HookCv;
  LReadStop: uint64;
  LOutStop: uint64;
  LCount: int64;
  LAvail: int64;
  LSpare: HookMbBytes;
  LSpareCount: int64;
  LFrom: uint64;
  LTo: uint64;
  LToCopy: int64;
  LUsed: int64;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  // C99 requires EOF to be sticky
  if (LIo->Flags & _IO_EOF_SEEN) <> 0u then
    return int64(ADAM_HOOKIO_WEOF);
  end;
  if (LIo->Flags & _IO_NO_READS) <> 0u then
    LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
    SetCErrno(ADAM_ERRNO_EBADF);
    return int64(ADAM_HOOKIO_WEOF);
  end;
  if LWide->ReadPtr < LWide->ReadEnd then
    return int64(DoWideAt(LWide->ReadPtr));
  end;
  // Maybe there is something left in the external buffer
  if LIo->ReadPtr < LIo->ReadEnd then
    DoCvSave(LWide->ToWide, LWide->LastState);
    LWide->ReadBase := LWide->BufBase;
    LWide->ReadPtr := LWide->BufBase;
    LStatus := DoCvRun(LWide->ToWide, LIo->ReadPtr, LIo->ReadEnd, LReadStop, LWide->ReadPtr,
      LWide->BufEnd, LOutStop);
    LWide->ReadEnd := LOutStop;
    LIo->ReadBase := LIo->ReadPtr;
    LIo->ReadPtr := LReadStop;
    if LWide->ReadPtr < LWide->ReadEnd then
      return int64(DoWideAt(LWide->ReadPtr));
    end;
    if LStatus = HookCv.Error then
      SetCErrno(ADAM_ERRNO_EILSEQ);
      LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
      return int64(ADAM_HOOKIO_WEOF);
    end;
    // The rest of the read buffer moved to its start
    LAvail := int64(LIo->ReadEnd - LIo->ReadPtr);
    DoMoveDown(LIo->BufBase, LIo->ReadPtr, LAvail);
    LIo->ReadEnd := LIo->BufBase + uint64(LAvail);
    LIo->ReadBase := LIo->BufBase;
    LIo->ReadPtr := LIo->BufBase;
  else
    LIo->ReadBase := LIo->BufBase;
    LIo->ReadPtr := LIo->BufBase;
    LIo->ReadEnd := LIo->BufBase;
  end;
  if LIo->BufBase = 0u then
    // Maybe there is a push back area already
    if LIo->SaveBase <> 0u then
      freemem(ptr(LIo->SaveBase));
      LIo->SaveBase := 0u;
      LIo->SaveEnd := 0u;
      LIo->BackupBase := 0u;
      LIo->Flags := LIo->Flags & (~_IO_IN_BACKUP);
    end;
    DoDoallocbuf(LIo);
    LIo->ReadBase := LIo->BufBase;
    LIo->ReadPtr := LIo->BufBase;
    LIo->ReadEnd := LIo->BufBase;
  end;
  LIo->WriteBase := LIo->BufBase;
  LIo->WritePtr := LIo->BufBase;
  LIo->WriteEnd := LIo->BufBase;
  if LWide->BufBase = 0u then
    // Maybe there is a wide push back area already
    if LWide->SaveBase <> 0u then
      freemem(ptr(LWide->SaveBase));
      LWide->SaveBase := 0u;
      LWide->SaveEnd := 0u;
      LWide->BackupBase := 0u;
      LIo->Flags := LIo->Flags & (~_IO_IN_BACKUP);
    end;
    DoWdoallocbuf(AHandle);
  end;
  if (LIo->Flags & (_IO_LINE_BUF | _IO_UNBUFFERED)) <> 0u then
    DoFlushLineStdout();
  end;
  DoSwitchToGetMode(AHandle);
  DoWsetg(LWide, LWide->BufBase, LWide->BufBase, LWide->BufBase);
  DoWsetp(LWide, LWide->BufBase, LWide->BufBase);
  LSpareCount := 0;
  // glibc's "again": read on until the bytes make a character, the end or a failure
  while true do
    LCount := DoSysRead(AHandle, LIo->ReadEnd, int64(LIo->BufEnd - LIo->ReadEnd));
    if LCount <= 0 then
      if (LCount = 0) and (LSpareCount = 0) then
        LIo->Flags := LIo->Flags | _IO_EOF_SEEN;
        LIo->Offset := ADAM_HOOKIO_POS_BAD;
      else
        LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
        LCount := 0;
      end;
    end;
    LIo->ReadEnd := LIo->ReadEnd + uint64(LCount);
    if LCount = 0 then
      if LSpareCount <> 0 then
        // Bytes in the external buffer that convert to nothing
        SetCErrno(ADAM_ERRNO_EILSEQ);
      end;
      return int64(ADAM_HOOKIO_WEOF);
    end;
    if LIo->Offset <> ADAM_HOOKIO_POS_BAD then
      LIo->Offset := LIo->Offset + LCount;
    end;
    // Now the read input converted
    DoCvSave(LWide->ToWide, LWide->LastState);
    LIo->ReadBase := LIo->ReadPtr;
    LFrom := LIo->ReadPtr;
    LTo := LIo->ReadEnd;
    LToCopy := LCount;
    if LSpareCount <> 0 then
      LToCopy := ADAM_HOOKIO_MB_MAX - LSpareCount;
      if LCount < LToCopy then
        LToCopy := LCount;
      end;
      DoCopy(uint64(addr of LSpare[LSpareCount]), LFrom, LToCopy);
      LSpareCount := LSpareCount + LToCopy;
      LFrom := uint64(addr of LSpare[0]);
      LTo := LFrom + uint64(LSpareCount);
    end;
    LStatus := DoCvRun(LWide->ToWide, LFrom, LTo, LReadStop, LWide->ReadEnd, LWide->BufEnd,
      LOutStop);
    LWide->ReadEnd := LOutStop;
    if LSpareCount <> 0 then
      LUsed := int64(LReadStop) - int64(uint64(addr of LSpare[0])) - (LSpareCount - LToCopy);
      if LUsed > 0 then
        LIo->ReadPtr := LIo->ReadPtr + uint64(LUsed);
      end;
    else
      LIo->ReadPtr := LReadStop;
    end;
    if LWide->ReadEnd <> LWide->BufBase then
      return int64(DoWideAt(LWide->ReadPtr));
    end;
    if LStatus = HookCv.Error then
      SetCErrno(ADAM_ERRNO_EILSEQ);
      LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
      return int64(ADAM_HOOKIO_WEOF);
    end;
    // The read bytes make no complete character: read again
    if LSpareCount = 0 then
      if LIo->ReadBase < LIo->ReadPtr then
        // Some input used that made no character: the rest moved down and read on after it
        LAvail := int64(LIo->ReadEnd - LIo->ReadPtr);
        DoMoveDown(LIo->ReadBase, LIo->ReadPtr, LAvail);
        LIo->ReadPtr := LIo->ReadBase;
        LIo->ReadEnd := LIo->ReadBase + uint64(LAvail);
        skip;
      end;
      LSpareCount := int64(LIo->ReadEnd - LIo->ReadPtr);
      if LSpareCount >= ADAM_HOOKIO_MB_MAX then
        SetCErrno(ADAM_ERRNO_EILSEQ);
        LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
        return int64(ADAM_HOOKIO_WEOF);
      end;
      DoCopy(uint64(addr of LSpare[0]), LIo->ReadPtr, LSpareCount);
    else
      LUsed := int64(LReadStop) - int64(uint64(addr of LSpare[0]));
      if LUsed > 0 then
        DoMoveDown(uint64(addr of LSpare[0]), LReadStop, LSpareCount - LUsed);
        LSpareCount := LSpareCount - LUsed;
      end;
      if LSpareCount = ADAM_HOOKIO_MB_MAX then
        SetCErrno(ADAM_ERRNO_EILSEQ);
        LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
        return int64(ADAM_HOOKIO_WEOF);
      end;
    end;
    LIo->ReadPtr := LIo->ReadBase;
    LIo->ReadEnd := LIo->ReadBase;
  end;
end;

// _IO_wfile_overflow: AChar (WEOF, -1: none, only a flush) into the wide put area, set up from
// the get areas when the stream was reading; a full wide buffer flushed first; an unbuffered
// stream, or a line-buffered one at a newline, flushed after. The character, WEOF (a stream
// that cannot write: the error flag and EBADF), or the flush's 0 / EOF. A stream reading in
// its wide backup area (glibc would put from inside the backup area and write past it) leaves
// it first as the byte model's overflow does
routine DoWfileOverflow(const AHandle: ptr to HookHandle; const AChar: int64): int64;
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LBackup: int64;
  LStep: int64;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  if (LIo->Flags & _IO_NO_WRITES) <> 0u then
    LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
    SetCErrno(ADAM_ERRNO_EBADF);
    return int64(ADAM_HOOKIO_WEOF);
  end;
  // Currently reading, or no buffer yet
  if ((LIo->Flags & _IO_CURRENTLY_PUTTING) = 0u) or (LWide->WriteBase = 0u) then
    if LWide->WriteBase = 0u then
      DoWdoallocbuf(AHandle);
      DoFreeWbackupArea(AHandle);
      DoWsetg(LWide, LWide->BufBase, LWide->BufBase, LWide->BufBase);
      if LIo->WriteBase = 0u then
        DoDoallocbuf(LIo);
        DoSetg(LIo, LIo->BufBase, LIo->BufBase, LIo->BufBase);
      end;
    else
      if (LIo->Flags & _IO_IN_BACKUP) <> 0u then
        LBackup := DoWideCount(LWide->ReadPtr, LWide->ReadEnd);
        DoFreeWbackupArea(AHandle);
        LStep := DoWideCount(LWide->BufBase, LWide->ReadBase);
        if LBackup < LStep then
          LStep := LBackup;
        end;
        LWide->ReadBase := DoWideStep(LWide->ReadBase, -LStep);
        LWide->ReadPtr := LWide->ReadBase;
      end;
      // A read area at the buffer's end slides forward one block, to make room
      if LWide->ReadPtr = LWide->BufEnd then
        LIo->ReadEnd := LIo->BufBase;
        LIo->ReadPtr := LIo->BufBase;
        LWide->ReadEnd := LWide->BufBase;
        LWide->ReadPtr := LWide->BufBase;
      end;
    end;
    LWide->WritePtr := LWide->ReadPtr;
    LWide->WriteBase := LWide->WritePtr;
    LWide->WriteEnd := LWide->BufEnd;
    LWide->ReadBase := LWide->ReadEnd;
    LWide->ReadPtr := LWide->ReadEnd;
    LIo->WritePtr := LIo->ReadPtr;
    LIo->WriteBase := LIo->WritePtr;
    LIo->WriteEnd := LIo->BufEnd;
    LIo->ReadBase := LIo->ReadEnd;
    LIo->ReadPtr := LIo->ReadEnd;
    LIo->Flags := LIo->Flags | _IO_CURRENTLY_PUTTING;
    if (LIo->Flags & (_IO_LINE_BUF | _IO_UNBUFFERED)) <> 0u then
      LWide->WriteEnd := LWide->WritePtr;
    end;
  end;
  if AChar = int64(ADAM_HOOKIO_WEOF) then
    return int64(DoDoFlush(AHandle));
  end;
  // The buffer is really full
  if LWide->WritePtr = LWide->BufEnd then
    if DoDoFlush(AHandle) = ADAM_HOOKIO_EOF then
      return int64(ADAM_HOOKIO_WEOF);
    end;
  end;
  DoPutWideAt(LWide->WritePtr, uint32(AChar & 0xFFFFFFFF));
  LWide->WritePtr := DoWideStep(LWide->WritePtr, 1);
  if ((LIo->Flags & _IO_UNBUFFERED) <> 0u) or
    (((LIo->Flags & _IO_LINE_BUF) <> 0u) and (AChar = int64(ADAM_HOOKIO_NEWLINE))) then
    if DoDoFlush(AHandle) = ADAM_HOOKIO_EOF then
      return int64(ADAM_HOOKIO_WEOF);
    end;
  end;
  return AChar;
end;

// _IO_switch_to_wget_mode: written characters flushed, the wide get area taken up where the
// wide put area stood
routine DoSwitchToWgetMode(const AHandle: ptr to HookHandle): int32;
var
  LWide: ptr to HookWide;
begin
  LWide := addr of AHandle->Wide;
  if LWide->WritePtr > LWide->WriteBase then
    if DoWfileOverflow(AHandle, int64(ADAM_HOOKIO_WEOF)) = int64(ADAM_HOOKIO_WEOF) then
      return ADAM_HOOKIO_EOF;
    end;
  end;
  if (AHandle->Io.Flags & _IO_IN_BACKUP) <> 0u then
    LWide->ReadBase := LWide->BackupBase;
  else
    LWide->ReadBase := LWide->BufBase;
    if LWide->WritePtr > LWide->ReadEnd then
      LWide->ReadEnd := LWide->WritePtr;
    end;
  end;
  LWide->ReadPtr := LWide->WritePtr;
  LWide->WriteBase := LWide->ReadPtr;
  LWide->WritePtr := LWide->ReadPtr;
  LWide->WriteEnd := LWide->ReadPtr;
  AHandle->Io.Flags := AHandle->Io.Flags & (~_IO_CURRENTLY_PUTTING);
  return 0;
end;

// _IO_wfile_sync: written characters flushed, the descriptor stepped back over read-ahead (the
// unread characters' bytes: a fixed-width charset's bytes per character, else the bytes the
// characters read so far took, converted again from _IO_last_state); an IO that cannot seek is
// let be; the descriptor's place unknown after. 0 or WEOF
routine DoWfileSync(const AHandle: ptr to HookHandle): int32;
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LDelta: int64;
  LResult: int32;
  LRead: int64;
  LNread: int64;
  LPlace: int64;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  LResult := 0;
  if LWide->WritePtr > LWide->WriteBase then
    if DoDoFlush(AHandle) <> 0 then
      return ADAM_HOOKIO_WEOF;
    end;
  end;
  LDelta := DoWideCount(LWide->ReadEnd, LWide->ReadPtr);
  if LDelta <> 0 then
    if LWide->Encoding > 0 then
      // A fixed number of input bytes for each wide character
      LDelta := LDelta * int64(LWide->Encoding);
    else
      // The input the characters up to the reading place needed
      LRead := DoWideCount(LWide->ReadBase, LWide->ReadPtr);
      DoCvLoad(LWide->ToWide, LWide->LastState);
      LNread := DoCvLength(AHandle, LIo->ReadBase, LIo->ReadEnd, LRead);
      LIo->ReadPtr := LIo->ReadBase + uint64(LNread);
      LDelta := -(int64(LIo->ReadEnd - LIo->ReadBase) - LNread);
    end;
    LPlace := DoSysSeek(AHandle, LDelta, _IO_seek_cur);
    if LPlace <> ADAM_HOOKIO_POS_BAD then
      LWide->ReadEnd := LWide->ReadPtr;
      LIo->ReadEnd := LIo->ReadPtr;
    else
      // An unseekable device's refusal is ignored
      if CErrno() <> ESPIPE then
        LResult := ADAM_HOOKIO_WEOF;
      end;
    end;
  end;
  if LResult <> ADAM_HOOKIO_WEOF then
    LIo->Offset := ADAM_HOOKIO_POS_BAD;
  end;
  return LResult;
end;

// adjust_wide_data (wfileops.c): the bytes ReadBase..ReadPtr of the byte get area taken as
// read: their characters (a fixed-width charset's counted, else converted when AConvert or the
// charset is not fixed-width) into the wide get area from its base, all of them read. 0, or -1
// with the error flag on bytes that are no character. glibc runs the conversion again from the
// start while it answers partial, forever when the place splits a character: a handle takes
// the whole characters before it
routine DoAdjustWideData(const AHandle: ptr to HookHandle; const AConvert: bool): int32;
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LStatus: HookCv;
  LReadStop: uint64;
  LOutStop: uint64;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  if (not AConvert) and (LWide->Encoding > 0) then
    LWide->ReadEnd := DoWideStep(LWide->ReadEnd,
      int64(LIo->ReadPtr - LIo->ReadBase) div int64(LWide->Encoding));
  else
    DoCvSave(LWide->ToWide, LWide->LastState);
    LStatus := DoCvRun(LWide->ToWide, LIo->ReadBase, LIo->ReadPtr, LReadStop, LWide->ReadBase,
      LWide->BufEnd, LOutStop);
    LWide->ReadEnd := LOutStop;
    if LStatus = HookCv.Error then
      LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
      return -1;
    end;
  end;
  // As if everything up to there were read
  LWide->ReadPtr := LWide->ReadEnd;
  return 0;
end;

// do_ftell_wide (wfileops.c): the place a seek to 0 from here would give: unread characters'
// bytes taken off (a fixed-width charset's bytes per character, else what the characters read
// so far took, converted again from _IO_last_state), unflushed characters' bytes added (a
// fixed-width charset's, else their conversion's, run on a copy of the state); an appending
// stream's measured from the IO's end. -1 with EINVAL while ungot characters wait in the
// backup area; EOF (errno set) when the descriptor cannot tell or the place is negative;
// glibc's WEOF as an off64_t (ADAM_HOOKIO_WEOF_OFFSET) when unflushed characters do not convert
routine DoTellWide(const AHandle: ptr to HookHandle): int64;
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LResult: int64;
  LOffset: int64;
  LUnflushed: bool;
  LAppending: bool;
  LReadBase: uint64;
  LReadPtr: uint64;
  LReadEnd: uint64;
  LDelta: int64;
  LNread: int64;
  LNow: HookCvState;
  LOut: ptr;
  LStop: uint64;
  LOutStop: uint64;
  LStatus: HookCv;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  LOffset := 0;
  // No point looking for offsets in a buffer not made yet
  if LWide->BufBase <> 0u then
    LUnflushed := LWide->WritePtr > LWide->WriteBase;
    LAppending := (LIo->Flags & _IO_IS_APPENDING) <> 0u;
    if LUnflushed and LAppending then
      LResult := DoSysSeek(AHandle, 0, _IO_seek_end);
      if LResult = ADAM_HOOKIO_POS_BAD then
        return ADAM_HOOKIO_EOF;
      end;
      LIo->Offset := LResult;
    end;
    if (LIo->Flags & _IO_IN_BACKUP) <> 0u then
      if LWide->ReadPtr < LWide->ReadEnd then
        SetCErrno(ADAM_ERRNO_EINVAL);
        return -1;
      end;
      // Nothing in the backup area: the main get area's pointers, the state untouched
      LReadBase := LWide->SaveBase;
      LReadPtr := LReadBase;
      LReadEnd := LWide->SaveEnd;
    else
      LReadBase := LWide->ReadBase;
      LReadPtr := LWide->ReadPtr;
      LReadEnd := LWide->ReadEnd;
    end;
    if not LUnflushed then
      if LWide->Encoding > 0 then
        LOffset := LOffset - DoWideCount(LReadPtr, LReadEnd) * int64(LWide->Encoding);
        LOffset := LOffset - int64(LIo->ReadEnd - LIo->ReadPtr);
      else
        LDelta := DoWideCount(LReadBase, LReadPtr);
        DoCvSave(LWide->ToWide, LNow);
        DoCvLoad(LWide->ToWide, LWide->LastState);
        LNread := DoCvLength(AHandle, LIo->ReadBase, LIo->ReadEnd, LDelta);
        DoCvLoad(LWide->ToWide, LNow);
        LOffset := LOffset - (int64(LIo->ReadEnd - LIo->ReadBase) - LNread);
      end;
    else
      if LWide->Encoding > 0 then
        LOffset := LOffset + DoWideCount(LWide->WriteBase, LWide->WritePtr) * int64(LWide->Encoding);
      else
        LDelta := DoWideCount(LWide->WriteBase, LWide->WritePtr);
        LOut := getmem(LDelta * ADAM_HOOKIO_WCHAR_BYTES);
        if LOut = nil then
          return ADAM_HOOKIO_WEOF_OFFSET;
        end;
        DoCvSave(LWide->ToBytes, LNow);
        LStatus := DoCvRun(LWide->ToBytes, LWide->WriteBase, LWide->WritePtr, LStop, uint64(LOut),
          uint64(LOut) + uint64(LDelta * ADAM_HOOKIO_WCHAR_BYTES), LOutStop);
        DoCvLoad(LWide->ToBytes, LNow);
        freemem(LOut);
        if LStatus <> HookCv.Ok then
          return ADAM_HOOKIO_WEOF_OFFSET;
        end;
        LOffset := LOffset + int64(LOutStop - uint64(LOut));
      end;
      // _IO_read_end is not the place in append mode: the write base after the seek above
      if LAppending then
        LOffset := LOffset + int64(LIo->WritePtr - LIo->WriteBase);
      else
        LOffset := LOffset + (int64(LIo->WritePtr) - int64(LIo->ReadEnd));
      end;
    end;
  end;
  if LIo->Offset <> ADAM_HOOKIO_POS_BAD then
    LResult := LIo->Offset;
  else
    LResult := DoSysSeek(AHandle, 0, _IO_seek_cur);
  end;
  if LResult = ADAM_HOOKIO_EOF then
    return LResult;
  end;
  LResult := LResult + LOffset;
  if LResult < 0 then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return ADAM_HOOKIO_EOF;
  end;
  return LResult;
end;

// _IO_wfile_seekoff: AMode 0 is ftell's (DoTellWide); else a seek to AOffset from ADir: written
// characters flushed, a seek inside the byte buffer only moving in it (its characters counted
// or converted again), else block-aligned read-ahead converted, or a bare seek ("dumb") for a
// stream that cannot read, an origin it cannot make absolute or bytes that are no character;
// the end flag cleared. A stream with no wide buffer yet is given one here (glibc converts
// into a NULL area and loops forever). The new place, EOF, or ADAM_HOOKIO_WEOF_OFFSET when the
// flush failed (glibc's WEOF as an off64_t, which fseek takes for success)
routine DoWfileSeekoff(const AHandle: ptr to HookHandle; const AOffset: int64; const ADir: int32;
  const AMode: int32): int64;
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LOffset: int64;
  LDir: int32;
  LExact: bool;
  LWriting: bool;
  LDumb: bool;
  LDelta: int64;
  LNread: int64;
  LSize: int64;
  LStart: int64;
  LNewOffset: int64;
  LBlock: int64;
  LResult: int64;
  LCount: int64;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  if AMode = 0 then
    return DoTellWide(AHandle);
  end;
  LOffset := AOffset;
  LDir := ADir;
  LDumb := false;
  // POSIX: after an fflush the file offset must be exact
  LExact := (LWide->ReadBase = LWide->ReadEnd) and (LWide->WriteBase = LWide->WritePtr);
  LWriting := (LWide->WritePtr > LWide->WriteBase) or ((LIo->Flags & _IO_CURRENTLY_PUTTING) <> 0u);
  if LWriting and (DoSwitchToWgetMode(AHandle) <> 0) then
    return ADAM_HOOKIO_WEOF_OFFSET;
  end;
  if LWide->BufBase = 0u then
    // A push back area already there (glibc frees it as the wide get area's base)
    if LWide->ReadBase <> 0u then
      freemem(ptr(LWide->ReadBase));
      LIo->Flags := LIo->Flags & (~_IO_IN_BACKUP);
      LWide->SaveBase := 0u;
      LWide->SaveEnd := 0u;
      LWide->BackupBase := 0u;
    end;
    DoDoallocbuf(LIo);
    DoWdoallocbuf(AHandle);
    DoSetp(LIo, LIo->BufBase, LIo->BufBase);
    DoSetg(LIo, LIo->BufBase, LIo->BufBase, LIo->BufBase);
    DoWsetp(LWide, LWide->BufBase, LWide->BufBase);
    DoWsetg(LWide, LWide->BufBase, LWide->BufBase, LWide->BufBase);
  end;
  if LDir = _IO_seek_cur then
    // The read-ahead taken off: the byte place of the wide reading place
    if LWide->Encoding > 0 then
      LOffset := LOffset - DoWideCount(LWide->ReadPtr, LWide->ReadEnd) * int64(LWide->Encoding);
      LOffset := LOffset - int64(LIo->ReadEnd - LIo->ReadPtr);
    else
      LDelta := DoWideCount(LWide->ReadBase, LWide->ReadPtr);
      DoCvLoad(LWide->ToWide, LWide->LastState);
      LNread := DoCvLength(AHandle, LIo->ReadBase, LIo->ReadEnd, LDelta);
      LIo->ReadPtr := LIo->ReadBase + uint64(LNread);
      LWide->ReadEnd := LWide->ReadPtr;
      LOffset := LOffset - (int64(LIo->ReadEnd - LIo->ReadBase) - LNread);
    end;
    if LIo->Offset = ADAM_HOOKIO_POS_BAD then
      LDumb := true;
    else
      LOffset := LOffset + LIo->Offset;
      LDir := _IO_seek_set;
    end;
  else
    if LDir = _IO_seek_end then
      if DoSysSize(AHandle, LSize) then
        LOffset := LOffset + LSize;
        LDir := _IO_seek_set;
      else
        LDumb := true;
      end;
    end;
  end;
  if not LDumb then
    DoFreeWbackupArea(AHandle);
    // A place inside the current buffer: only the get areas move
    if (LIo->Offset <> ADAM_HOOKIO_POS_BAD) and (LIo->ReadBase <> 0u) and
      ((LIo->Flags & _IO_IN_BACKUP) = 0u) then
      LStart := LIo->Offset - int64(LIo->ReadEnd - LIo->BufBase);
      if (LOffset >= LStart) and (LOffset < LIo->Offset) then
        DoSetg(LIo, LIo->BufBase, LIo->BufBase + uint64(LOffset - LStart), LIo->ReadEnd);
        DoSetp(LIo, LIo->BufBase, LIo->BufBase);
        DoWsetg(LWide, LWide->BufBase, LWide->BufBase, LWide->BufBase);
        DoWsetp(LWide, LWide->BufBase, LWide->BufBase);
        if DoAdjustWideData(AHandle, false) <> 0 then
          LDumb := true;
        else
          LIo->Flags := LIo->Flags & (~_IO_EOF_SEEN);
          // resync: the descriptor put back where the model has it
          if LIo->Offset >= 0 then
            DoSysSeek(AHandle, LIo->Offset, _IO_seek_set);
          end;
          return LOffset;
        end;
      end;
    end;
    if (LIo->Flags & _IO_NO_READS) <> 0u then
      LDumb := true;
    end;
  end;
  if not LDumb then
    // A block boundary, for the kernel's page management
    LBlock := int64(LIo->BufEnd - LIo->BufBase);
    LNewOffset := LOffset & (~(LBlock - 1));
    LDelta := LOffset - LNewOffset;
    if LDelta > LBlock then
      LNewOffset := LOffset;
      LDelta := 0;
    end;
    LResult := DoSysSeek(AHandle, LNewOffset, _IO_seek_set);
    if LResult < 0 then
      return ADAM_HOOKIO_EOF;
    end;
    if LDelta = 0 then
      LCount := 0;
    else
      if LExact then
        LCount := DoSysRead(AHandle, LIo->BufBase, LDelta);
      else
        LCount := DoSysRead(AHandle, LIo->BufBase, LBlock);
      end;
      if LCount < LDelta then
        // Not allowed to read: the rest by a seek
        if LCount = ADAM_HOOKIO_EOF then
          LOffset := LDelta;
        else
          LOffset := LDelta - LCount;
        end;
        LDir := _IO_seek_cur;
        LDumb := true;
      end;
    end;
    if not LDumb then
      DoSetg(LIo, LIo->BufBase, LIo->BufBase + uint64(LDelta), LIo->BufBase + uint64(LCount));
      DoSetp(LIo, LIo->BufBase, LIo->BufBase);
      DoWsetg(LWide, LWide->BufBase, LWide->BufBase, LWide->BufBase);
      DoWsetp(LWide, LWide->BufBase, LWide->BufBase);
      if DoAdjustWideData(AHandle, true) <> 0 then
        LDumb := true;
      else
        LIo->Offset := LResult + LCount;
        LIo->Flags := LIo->Flags & (~_IO_EOF_SEEN);
        return LOffset;
      end;
    end;
  end;
  // dumb: a bare seek of the descriptor
  LResult := DoSysSeek(AHandle, LOffset, LDir);
  if LResult <> ADAM_HOOKIO_EOF then
    LIo->Flags := LIo->Flags & (~_IO_EOF_SEEN);
    LIo->Offset := LResult;
    DoSetg(LIo, LIo->BufBase, LIo->BufBase, LIo->BufBase);
    DoSetp(LIo, LIo->BufBase, LIo->BufBase);
    DoWsetg(LWide, LWide->BufBase, LWide->BufBase, LWide->BufBase);
    DoWsetp(LWide, LWide->BufBase, LWide->BufBase);
  end;
  return LResult;
end;

// _IO_SYNC: the wide jumps' sync on a wide stream, the file's on any other. 0 or EOF
routine DoSync(const AHandle: ptr to HookHandle): int32;
begin
  if AHandle->Io.Orientation > 0 then
    return DoWfileSync(AHandle);
  end;
  return DoFileSync(AHandle);
end;

// _IO_wdefault_uflow: the next character taken after the wide underflow, or WEOF
routine DoWdefaultUflow(const AHandle: ptr to HookHandle): int64;
var
  LChar: int64;
begin
  LChar := DoWfileUnderflow(AHandle);
  if LChar = int64(ADAM_HOOKIO_WEOF) then
    return LChar;
  end;
  LChar := int64(DoWideAt(AHandle->Wide.ReadPtr));
  AHandle->Wide.ReadPtr := DoWideStep(AHandle->Wide.ReadPtr, 1);
  return LChar;
end;

// __wuflow / __wunderflow (wgenops.c): a byte stream refuses (WEOF), an unoriented one turns
// wide; put mode left, the wide get area's character, else the main get area after the backup
// one, else the backup area freed and the wide underflow (ATake: the character taken, __wuflow;
// else only looked at, __wunderflow, which frees the wide backup area only while a byte one is
// there, as glibc's _IO_have_backup reads it)
routine DoWflow(const AHandle: ptr to HookHandle; const ATake: bool): int64;
var
  LWide: ptr to HookWide;
  LChar: int64;
begin
  LWide := addr of AHandle->Wide;
  if DoFwide(AHandle, 1) <> 1 then
    return int64(ADAM_HOOKIO_WEOF);
  end;
  if (AHandle->Io.Flags & _IO_CURRENTLY_PUTTING) <> 0u then
    if DoSwitchToWgetMode(AHandle) = ADAM_HOOKIO_EOF then
      return int64(ADAM_HOOKIO_WEOF);
    end;
  end;
  if LWide->ReadPtr < LWide->ReadEnd then
    LChar := int64(DoWideAt(LWide->ReadPtr));
    if ATake then
      LWide->ReadPtr := DoWideStep(LWide->ReadPtr, 1);
    end;
    return LChar;
  end;
  if (AHandle->Io.Flags & _IO_IN_BACKUP) <> 0u then
    DoSwitchToMainWgetArea(AHandle);
    if LWide->ReadPtr < LWide->ReadEnd then
      LChar := int64(DoWideAt(LWide->ReadPtr));
      if ATake then
        LWide->ReadPtr := DoWideStep(LWide->ReadPtr, 1);
      end;
      return LChar;
    end;
  end;
  if ATake then
    if LWide->SaveBase <> 0u then
      DoFreeWbackupArea(AHandle);
    end;
    return DoWdefaultUflow(AHandle);
  end;
  if AHandle->Io.SaveBase <> 0u then
    DoFreeWbackupArea(AHandle);
  end;
  return DoWfileUnderflow(AHandle);
end;

// __woverflow (wgenops.c): an unoriented stream turns wide, then the overflow (a byte stream's
// is the byte one, as glibc's jumps are)
routine DoWoverflow(const AHandle: ptr to HookHandle; const AChar: int64): int64;
begin
  if AHandle->Io.Orientation = 0 then
    DoFwide(AHandle, 1);
  end;
  if AHandle->Io.Orientation < 0 then
    return int64(DoFileOverflow(AHandle, int32(AChar & 0xFFFFFFFF)));
  end;
  return DoWfileOverflow(AHandle, AChar);
end;

// _IO_getwc_unlocked: a character of the wide get area, else __wuflow
routine DoGetwc(const AHandle: ptr to HookHandle): int64;
var
  LChar: int64;
begin
  if AHandle->Wide.ReadPtr >= AHandle->Wide.ReadEnd then
    return DoWflow(AHandle, true);
  end;
  LChar := int64(DoWideAt(AHandle->Wide.ReadPtr));
  AHandle->Wide.ReadPtr := DoWideStep(AHandle->Wide.ReadPtr, 1);
  return LChar;
end;

// _IO_putwc_unlocked (putwc, putwc_unlocked: no orientation check): AChar into the wide put
// area, else __woverflow
routine DoPutwc(const AHandle: ptr to HookHandle; const AChar: uint32): int64;
begin
  if AHandle->Wide.WritePtr >= AHandle->Wide.WriteEnd then
    return DoWoverflow(AHandle, int64(AChar));
  end;
  DoPutWideAt(AHandle->Wide.WritePtr, AChar);
  AHandle->Wide.WritePtr := DoWideStep(AHandle->Wide.WritePtr, 1);
  return int64(AChar);
end;

// _IO_wdefault_xsputn: ACount characters at AData into the wide put area, __woverflow
// whenever it is full. The count put
routine DoWdefaultXsputn(const AHandle: ptr to HookHandle; const AData: uint64; const ACount: int64): int64;
var
  LWide: ptr to HookWide;
  LMore: int64;
  LFrom: uint64;
  LCount: int64;
  LChar: int64;
begin
  LWide := addr of AHandle->Wide;
  LMore := ACount;
  LFrom := AData;
  if LMore <= 0 then
    return 0;
  end;
  while true do
    // Space available
    LCount := DoWideCount(LWide->WritePtr, LWide->WriteEnd);
    if LCount > 0 then
      if LCount > LMore then
        LCount := LMore;
      end;
      DoCopy(LWide->WritePtr, LFrom, LCount * ADAM_HOOKIO_WCHAR_BYTES);
      LWide->WritePtr := DoWideStep(LWide->WritePtr, LCount);
      LFrom := DoWideStep(LFrom, LCount);
      LMore := LMore - LCount;
    end;
    if LMore = 0 then
      leave;
    end;
    LChar := int64(DoWideAt(LFrom));
    LFrom := DoWideStep(LFrom, 1);
    if DoWoverflow(AHandle, LChar) = int64(ADAM_HOOKIO_WEOF) then
      leave;
    end;
    LMore := LMore - 1;
  end;
  return ACount - LMore;
end;

// _IO_wfile_xsputn: ACount characters at AData: as many as the wide put area takes copied (a
// line-buffered stream's up to its last newline, then flushed), the rest through
// _IO_wdefault_xsputn. The count put
routine DoWfileXsputn(const AHandle: ptr to HookHandle; const AData: uint64; const ACount: int64): int64;
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LToDo: int64;
  LFrom: uint64;
  LMustFlush: bool;
  LCount: int64;
  LAt: int64;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  if ACount <= 0 then
    return 0;
  end;
  LToDo := ACount;
  LFrom := AData;
  LMustFlush := false;
  // First the space available in the buffer
  LCount := DoWideCount(LWide->WritePtr, LWide->WriteEnd);
  if ((LIo->Flags & _IO_LINE_BUF) <> 0u) and ((LIo->Flags & _IO_CURRENTLY_PUTTING) <> 0u) then
    LCount := DoWideCount(LWide->WritePtr, LWide->BufEnd);
    if LCount >= ACount then
      LAt := ACount;
      while LAt > 0 do
        LAt := LAt - 1;
        if DoWideAt(DoWideStep(AData, LAt)) = uint32(ADAM_HOOKIO_NEWLINE) then
          LCount := LAt + 1;
          LMustFlush := true;
          leave;
        end;
      end;
    end;
  end;
  // Then the buffer filled
  if LCount > 0 then
    if LCount > LToDo then
      LCount := LToDo;
    end;
    DoCopy(LWide->WritePtr, LFrom, LCount * ADAM_HOOKIO_WCHAR_BYTES);
    LWide->WritePtr := DoWideStep(LWide->WritePtr, LCount);
    LFrom := DoWideStep(LFrom, LCount);
    LToDo := LToDo - LCount;
  end;
  if LToDo > 0 then
    LToDo := LToDo - DoWdefaultXsputn(AHandle, LFrom, LToDo);
  end;
  if LMustFlush and (LWide->WritePtr <> LWide->WriteBase) then
    DoWdoWrite(AHandle, LWide->WriteBase, DoWideCount(LWide->WriteBase, LWide->WritePtr));
  end;
  return ACount - LToDo;
end;

// _IO_wdefault_pbackfail: AChar given back where _IO_sputbackwc could not step back: glibc first
// compares the BYTE before the byte get area's place with AChar and, when they match, steps
// that byte back and stores nothing (kept as glibc does it; a place at the byte buffer's start,
// where glibc reads before it, compares as no match); else the wide backup area (opened at 128
// characters at the main area's place, doubled when full) takes it. AChar, or WEOF when there
// is no memory
routine DoWdefaultPbackfail(const AHandle: ptr to HookHandle; const AChar: uint32): int64;
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LArea: ptr;
  LOld: int64;
  LNew: int64;
  LMatch: bool;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  LMatch := false;
  if (LWide->ReadPtr > LWide->ReadBase) and ((LIo->Flags & _IO_IN_BACKUP) = 0u) and
    (LIo->ReadPtr > LIo->BufBase) and (LIo->BufBase <> 0u) then
    LMatch := uint32(DoByteAt(LIo->ReadPtr - 1u)) = AChar;
  end;
  if LMatch then
    LIo->ReadPtr := LIo->ReadPtr - 1u;
    return int64(AChar);
  end;
  if (LIo->Flags & _IO_IN_BACKUP) = 0u then
    // The main get area must logically follow the backup area
    if (LWide->ReadPtr > LWide->ReadBase) and (LWide->SaveBase <> 0u) then
      // save_for_wbackup with no markers: nothing to keep, the backup base at its end
      LWide->BackupBase := LWide->SaveEnd;
    else
      if LWide->SaveBase = 0u then
        // No backup buffer: one of 128 characters
        LArea := getmem(ADAM_HOOKIO_BACKUP_SIZE * ADAM_HOOKIO_WCHAR_BYTES);
        if LArea = nil then
          return int64(ADAM_HOOKIO_WEOF);
        end;
        LWide->SaveBase := uint64(LArea);
        LWide->SaveEnd := DoWideStep(uint64(LArea), ADAM_HOOKIO_BACKUP_SIZE);
        LWide->BackupBase := LWide->SaveEnd;
      end;
    end;
    LWide->ReadBase := LWide->ReadPtr;
    DoSwitchToWbackupArea(AHandle);
  else
    if LWide->ReadPtr <= LWide->ReadBase then
      // The backup area full: twice its size, its characters at the new one's end
      LOld := DoWideCount(LWide->ReadBase, LWide->ReadEnd);
      LNew := 2 * LOld;
      LArea := getmem(LNew * ADAM_HOOKIO_WCHAR_BYTES);
      if LArea = nil then
        return int64(ADAM_HOOKIO_WEOF);
      end;
      DoCopy(DoWideStep(uint64(LArea), LNew - LOld), LWide->ReadBase, LOld * ADAM_HOOKIO_WCHAR_BYTES);
      freemem(ptr(LWide->ReadBase));
      DoWsetg(LWide, uint64(LArea), DoWideStep(uint64(LArea), LNew - LOld),
        DoWideStep(uint64(LArea), LNew));
      LWide->BackupBase := LWide->ReadPtr;
    end;
  end;
  LWide->ReadPtr := DoWideStep(LWide->ReadPtr, -1);
  DoPutWideAt(LWide->ReadPtr, AChar);
  return int64(AChar);
end;

// _IO_sputbackwc: AChar given back: the wide get area steps back over it when it is the last
// character read, else _IO_PBACKFAIL (a wide stream's _IO_wdefault_pbackfail; a byte stream's
// jumps' byte one, AChar as its byte, as glibc's ungetwc reaches it); the end flag cleared
// unless it failed
routine DoSputbackwc(const AHandle: ptr to HookHandle; const AChar: uint32): int64;
var
  LWide: ptr to HookWide;
  LResult: int64;
begin
  LWide := addr of AHandle->Wide;
  if (LWide->ReadPtr > LWide->ReadBase) and (DoWideAt(DoWideStep(LWide->ReadPtr, -1)) = AChar) then
    LWide->ReadPtr := DoWideStep(LWide->ReadPtr, -1);
    LResult := int64(AChar);
  else
    if AHandle->Io.Orientation > 0 then
      LResult := DoWdefaultPbackfail(AHandle, AChar);
    else
      LResult := int64(DoPbackfail(AHandle, int32(AChar)));
      if LResult = int64(ADAM_HOOKIO_EOF) then
        LResult := int64(ADAM_HOOKIO_WEOF);
      end;
    end;
  end;
  if LResult <> int64(ADAM_HOOKIO_WEOF) then
    AHandle->Io.Flags := AHandle->Io.Flags & (~_IO_EOF_SEEN);
  end;
  return LResult;
end;

// fgetwc on a handle (getwc.c): the stream turns wide (a byte one refuses: WEOF), then getwc's
// _IO_getwc_unlocked
routine DoGetWideLocked(const AHandle: ptr to HookHandle): int64;
begin
  if DoFwide(AHandle, 1) <> 1 then
    return int64(ADAM_HOOKIO_WEOF);
  end;
  return DoGetwc(AHandle);
end;

// fputwc on a handle (fputwc.c): the stream turns wide (a byte one refuses: WEOF), then
// _IO_putwc_unlocked
routine DoPutWideCall(const AHandle: ptr to HookHandle; const AChar: uint32): int64;
begin
  if DoFwide(AHandle, 1) <> 1 then
    return int64(ADAM_HOOKIO_WEOF);
  end;
  return DoPutwc(AHandle, AChar);
end;

// ungetwc (ioungetwc.c): the stream turned wide first (WEOF too), its answer not looked at;
// WEOF gives nothing back; else _IO_sputbackwc (a byte stream's byte pbackfail, as glibc's)
routine DoUngetWideLocked(const AHandle: ptr to HookHandle; const AChar: uint32): int64;
begin
  DoFwide(AHandle, 1);
  if AChar = uint32(ADAM_HOOKIO_WEOF) then
    return int64(ADAM_HOOKIO_WEOF);
  end;
  return DoSputbackwc(AHandle, AChar);
end;

// fgetws (iofgetws.c) on a handle: up to Size - 1 characters into Wide, to and with a
// newline, then a 0; 1, or 0 (C's nil) when nothing was read, on this call's error, or for a
// count of 0 or less (glibc's checks: 1 stores only the 0). A fortified one (fgetws_chk.c,
// Origin 1, the buffer's size in ItemSize) as DoCallGets' fortified form
routine DoGetsWideLocked(const AHandle: ptr to HookHandle; const ACall: HookCall): int64;
var
  LOldError: uint32;
  LCount: int64;
  LChar: int64;
  LResult: int64;
  LLimit: int64;
  LChecked: bool;
  LText: ptr to uint32;
begin
  LText := ACall.Wide;
  LChecked := ACall.Origin = 1;
  if ACall.Size <= 0 then
    return 0;
  end;
  if (ACall.Size = 1) and (not LChecked) then
    LText[0] := 0u;
    return 1;
  end;
  if DoFwide(AHandle, 1) <> 1 then
    return 0;
  end;
  LLimit := ACall.Size - 1;
  if LChecked and (uint64(ACall.ItemSize) < uint64(LLimit)) then
    LLimit := ACall.ItemSize;
  end;
  LOldError := AHandle->Io.Flags & _IO_ERR_SEEN;
  AHandle->Io.Flags := AHandle->Io.Flags & (~_IO_ERR_SEEN);
  LCount := 0;
  while LCount < LLimit do
    LChar := DoGetWideLocked(AHandle);
    if LChar = int64(ADAM_HOOKIO_WEOF) then
      leave;
    end;
    LText[LCount] := uint32(LChar);
    LCount := LCount + 1;
    if LChar = int64(ADAM_HOOKIO_NEWLINE) then
      leave;
    end;
  end;
  LResult := 1;
  if (LCount = 0) or (((AHandle->Io.Flags & _IO_ERR_SEEN) <> 0u) and (CErrno() <> EAGAIN)) then
    LResult := 0;
  else
    if LChecked and (uint64(LCount) >= uint64(ACall.ItemSize)) then
      LResult := -1;
    else
      LText[LCount] := 0u;
    end;
  end;
  AHandle->Io.Flags := AHandle->Io.Flags | LOldError;
  return LResult;
end;

// fputws (iofputws.c) on a handle: the stream turns wide (a byte one refuses), then AText's
// characters through _IO_wfile_xsputn; glibc's 1, or EOF when not all of them were put
routine DoPutsWideLocked(const AHandle: ptr to HookHandle; const AText: ptr to const uint32): int64;
var
  LCount: int64;
begin
  LCount := 0;
  while AText[LCount] <> 0u do
    LCount := LCount + 1;
  end;
  if DoFwide(AHandle, 1) <> 1 then
    return -1;
  end;
  if DoWfileXsputn(AHandle, uint64(AText), LCount) <> LCount then
    return -1;
  end;
  return 1;
end;

// --- the calls ------------------------------------------------------------------------------

// fread (iofread.c): ACall.Size bytes (the product, wrapped as glibc's size_t) through
// _IO_sgetn; whole items counted (the count itself when all were read)
routine DoCallRead(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LGot: int64;
begin
  if (ACall.Size = 0) or (ACall.ItemSize = 0) then
    ACall.Answer := 0;
    return;
  end;
  LGot := DoFileXsgetn(AHandle, uint64(ACall.Buffer), ACall.Size);
  if LGot = ACall.Size then
    ACall.Answer := ACall.Offset;
  else
    ACall.Answer := int64(uint64(LGot) div uint64(ACall.ItemSize));
  end;
end;

// fwrite (iofwrite.c): a byte stream (a wide one writes nothing) puts the bytes through
// _IO_sputn; the count when all (or glibc's (size_t) EOF) went, else the whole items
routine DoCallWrite(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LWritten: uint64;
begin
  if (ACall.Size = 0) or (ACall.ItemSize = 0) then
    ACall.Answer := 0;
    return;
  end;
  LWritten := 0u;
  if DoFwide(AHandle, -1) = -1 then
    LWritten := DoFileXsputn(AHandle, uint64(ACall.Buffer), ACall.Size);
  end;
  if (LWritten = uint64(ACall.Size)) or (LWritten = ADAM_HOOKIO_MAX_SIZE) then
    ACall.Answer := ACall.Offset;
  else
    ACall.Answer := int64(LWritten div uint64(ACall.ItemSize));
  end;
end;

// fgets (iofgets.c): up to Size - 1 bytes, to and with a newline, then a 0; Answer 1, or 0
// (C's nil) for no room, nothing read, or this call's error (the old error flag put back). A
// fortified one (fgets_chk.c, Origin 1, the buffer's size in ItemSize): no special case for a
// count of 1, at most ItemSize bytes, and a line of ItemSize or more Answer -1 (the caller's
// __chk_fail)
routine DoCallGets(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LOldError: uint32;
  LCount: int64;
  LLimit: int64;
  LChecked: bool;
begin
  ACall.Answer := 0;
  LChecked := ACall.Origin = 1;
  if ACall.Size <= 0 then
    return;
  end;
  if (ACall.Size = 1) and (not LChecked) then
    ACall.Buffer[0] := 0;
    ACall.Answer := 1;
    return;
  end;
  LLimit := ACall.Size - 1;
  if LChecked and (uint64(ACall.ItemSize) < uint64(LLimit)) then
    LLimit := ACall.ItemSize;
  end;
  LOldError := AHandle->Io.Flags & _IO_ERR_SEEN;
  AHandle->Io.Flags := AHandle->Io.Flags & (~_IO_ERR_SEEN);
  LCount := DoGetline(AHandle, uint64(ACall.Buffer), LLimit, ADAM_HOOKIO_NEWLINE, 1);
  if (LCount = 0) or (((AHandle->Io.Flags & _IO_ERR_SEEN) <> 0u) and (CErrno() <> EAGAIN)) then
    ACall.Answer := 0;
  else
    if LChecked and (uint64(LCount) >= uint64(ACall.ItemSize)) then
      ACall.Answer := -1;
    else
      ACall.Buffer[LCount] := 0;
      ACall.Answer := 1;
    end;
  end;
  AHandle->Io.Flags := AHandle->Io.Flags | LOldError;
end;

// getdelim (iogetdelim.c): a line to and with the delimiter Value into *Line (malloc'd /
// realloc'd as glibc does, 120 bytes first: the caller frees it), its size in *LineSize; the
// count, or -1 (an error flag already set, no line or size given: EINVAL and the error flag,
// nothing read before the end, no memory)
routine DoCallGetdelim(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LIo: ptr to HookLibio;
  LLength: int64;
  LCurrent: int64;
  LNeeded: uint64;
  LBigger: uint64;
  LFound: int64;
  LI: int64;
  LLine: ptr;
  LGrown: ptr;
begin
  LIo := addr of AHandle->Io;
  ACall.Answer := -1;
  if (LIo->Flags & _IO_ERR_SEEN) <> 0u then
    return;
  end;
  if (ACall.Line = nil) or (ACall.LineSize = nil) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
    return;
  end;
  if (ACall.Line^ = nil) or (ACall.LineSize^ = 0u) then
    ACall.LineSize^ := ADAM_HOOKIO_GETDELIM_START;
    LLine := malloc(ADAM_HOOKIO_GETDELIM_START);
    ACall.Line^ := LLine;
    if LLine = nil then
      LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
      return;
    end;
  end;
  LCurrent := 0;
  LLength := int64(LIo->ReadEnd - LIo->ReadPtr);
  if LLength <= 0 then
    if DoUnderflow(AHandle) = ADAM_HOOKIO_EOF then
      return;
    end;
    LLength := int64(LIo->ReadEnd - LIo->ReadPtr);
  end;
  while true do
    LFound := -1;
    for LI := 0 to LLength - 1 do
      if DoByteAt(LIo->ReadPtr + uint64(LI)) = ACall.Value then
        LFound := LI;
        leave;
      end;
    end;
    if LFound >= 0 then
      LLength := LFound + 1;
    end;
    if LLength >= ADAM_HOOKIO_SSIZE_MAX - LCurrent then
      SetCErrno(ADAM_ERRNO_EOVERFLOW);
      LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
      return;
    end;
    LNeeded := uint64(LCurrent + LLength + 1);
    if LNeeded > ACall.LineSize^ then
      // Grow exponentially, at least to what is needed
      LBigger := 2u * ACall.LineSize^;
      if LNeeded > LBigger then
        LBigger := LNeeded;
      end;
      LGrown := realloc(ACall.Line^, LBigger);
      if LGrown = nil then
        LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
        return;
      end;
      ACall.Line^ := LGrown;
      ACall.LineSize^ := LBigger;
    end;
    DoCopy(uint64(ACall.Line^) + uint64(LCurrent), LIo->ReadPtr, LLength);
    LIo->ReadPtr := LIo->ReadPtr + uint64(LLength);
    LCurrent := LCurrent + LLength;
    if (LFound >= 0) or (DoUnderflow(AHandle) = ADAM_HOOKIO_EOF) then
      leave;
    end;
    LLength := int64(LIo->ReadEnd - LIo->ReadPtr);
  end;
  DoPutByteAt(uint64(ACall.Line^) + uint64(LCurrent), 0);
  ACall.Answer := LCurrent;
end;

// fputs (iofputs.c): a byte stream puts the Size bytes; 1, or EOF
routine DoCallPuts(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  ACall.Answer := ADAM_HOOKIO_EOF;
  if (DoFwide(AHandle, -1) = -1) and
    (DoFileXsputn(AHandle, uint64(ACall.Buffer), ACall.Size) = uint64(ACall.Size)) then
    ACall.Answer := 1;
  end;
end;

// ungetc (ioungetc.c): EOF refused; else the byte given back
routine DoCallUnget(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  if ACall.Value = ADAM_HOOKIO_EOF then
    ACall.Answer := ADAM_HOOKIO_EOF;
    return;
  end;
  ACall.Answer := DoSputbackc(AHandle, ACall.Value & 0xFF);
end;

// fflush of one handle (iofflush.c): _IO_SYNC, then the IO's own flush; 0 or EOF
routine DoCallFlush(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  ACall.Answer := ADAM_HOOKIO_EOF;
  if DoSync(AHandle) <> 0 then
    return;
  end;
  ACall.Answer := DoFlushIOLocked(AHandle);
end;

// fgetpos (iofgetpos.c): the place into *Buffer (an fpos_t; no conversion state: iconv's
// charsets keep none a handle could hand back); 0, or EOF (errno: EIO when none was set)
routine DoCallGetPos(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LPlace: int64;
  LPos: ptr to fpos_t;
begin
  ACall.Answer := ADAM_HOOKIO_EOF;
  LPlace := DoTell(AHandle);
  if LPlace < 0 then
    return;
  end;
  LPos := ptr to fpos_t(ACall.Buffer);
  LPos->pos := LPlace;
  LPos->state := 0u;
  ACall.Answer := 0;
end;

// fsetpos (iofsetpos.c): a seek to the place in *Buffer; 0, or EOF (errno: EIO when none was
// set)
routine DoCallSetPos(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LPos: ptr to fpos_t;
begin
  LPos := ptr to fpos_t(ACall.Buffer);
  if DoSeekoffUnlocked(AHandle, LPos->pos, _IO_seek_set, ADAM_HOOKIO_SEEK_MODE) =
    ADAM_HOOKIO_POS_BAD then
    if CErrno() = 0 then
      SetCErrno(ADAM_ERRNO_EIO);
    end;
    ACall.Answer := ADAM_HOOKIO_EOF;
    return;
  end;
  ACall.Answer := 0;
end;

// __fpurge: the backup area dropped, the get area's unread bytes and the put area's unwritten
// ones thrown away (a wide stream's wide areas' characters)
routine DoCallPurge(const AHandle: ptr to HookHandle);
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  if LIo->Orientation > 0 then
    if (LIo->Flags & _IO_IN_BACKUP) <> 0u then
      DoFreeWbackupArea(AHandle);
    end;
    LWide->ReadEnd := LWide->ReadPtr;
    LWide->WritePtr := LWide->WriteBase;
    return;
  end;
  if (LIo->Flags & _IO_IN_BACKUP) <> 0u then
    DoFreeBackupArea(LIo);
  end;
  LIo->ReadEnd := LIo->ReadPtr;
  LIo->WritePtr := LIo->WriteBase;
end;

// getw: an int's 4 bytes read (_IO_sgetn); EOF when fewer came
routine DoCallGetWord(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LWord: int32;
begin
  ACall.Answer := ADAM_HOOKIO_EOF;
  LWord := 0;
  if DoFileXsgetn(AHandle, uint64(addr of LWord), 4) = 4 then
    ACall.Answer := int64(LWord);
  end;
end;

// putw: an int's 4 bytes written (_IO_sputn); 0, or EOF
routine DoCallPutWord(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LWord: int32;
begin
  LWord := ACall.Value;
  ACall.Answer := ADAM_HOOKIO_EOF;
  if DoFileXsputn(AHandle, uint64(addr of LWord), 4) = 4u then
    ACall.Answer := 0;
  end;
end;

// What glibc's vfprintf / vfwprintf check before they format (vfprintf-internal.c ARGCHECK,
// ORIENT): a stream that cannot write fails (the error flag, EBADF), one of the other
// orientation refuses; Answer 0 when the print may go on, else -1
routine DoCallPrintCheck(const AHandle: ptr to HookHandle; var ACall: HookCall; const AWide: bool);
begin
  ACall.Answer := -1;
  if (AHandle->Io.Flags & _IO_NO_WRITES) <> 0u then
    AHandle->Io.Flags := AHandle->Io.Flags | _IO_ERR_SEEN;
    SetCErrno(ADAM_ERRNO_EBADF);
    return;
  end;
  if AWide then
    if DoFwide(AHandle, 1) <> 1 then
      return;
    end;
  else
    if DoFwide(AHandle, -1) <> -1 then
      return;
    end;
  end;
  ACall.Answer := 0;
end;

// __fsetlocking (__fsetlocking.c): 2 (FSETLOCKING_BYCALLER) when _IO_USER_LOCK is set, else 1
// (FSETLOCKING_INTERNAL); Value 1 clears it, 2 sets it, 0 only asks
routine DoCallLocking(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  ACall.Answer := 1;
  if (AHandle->Io.Flags & _IO_USER_LOCK) <> 0u then
    ACall.Answer := 2;
  end;
  if ACall.Value <> 0 then
    AHandle->Io.Flags := AHandle->Io.Flags & (~_IO_USER_LOCK);
    if ACall.Value = 2 then
      AHandle->Io.Flags := AHandle->Io.Flags | _IO_USER_LOCK;
    end;
  end;
end;

// A formatted print's text (vasprintf's, Size bytes at Buffer) put on a handle as glibc's
// vfprintf puts it: a stream that cannot write fails at once (the error flag, EBADF), a wide
// one refuses; the count, or -1 when the text did not all go
routine DoCallPrint(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  ACall.Answer := -1;
  if (AHandle->Io.Flags & _IO_NO_WRITES) <> 0u then
    AHandle->Io.Flags := AHandle->Io.Flags | _IO_ERR_SEEN;
    SetCErrno(ADAM_ERRNO_EBADF);
    return;
  end;
  if DoFwide(AHandle, -1) <> -1 then
    return;
  end;
  if ACall.Size > 0 then
    if DoFileXsputn(AHandle, uint64(ACall.Buffer), ACall.Size) <> uint64(ACall.Size) then
      return;
    end;
  end;
  ACall.Answer := ACall.Size;
end;

// A wide formatted print's text (Size characters at Wide) put as glibc's vfwprintf puts it
// (_IO_sputn: _IO_wfile_xsputn): a stream that cannot write fails at once (the error flag,
// EBADF), a byte one refuses; the count, or -1
routine DoCallPrintWide(const AHandle: ptr to HookHandle; var ACall: HookCall);
begin
  ACall.Answer := -1;
  if (AHandle->Io.Flags & _IO_NO_WRITES) <> 0u then
    AHandle->Io.Flags := AHandle->Io.Flags | _IO_ERR_SEEN;
    SetCErrno(ADAM_ERRNO_EBADF);
    return;
  end;
  if DoFwide(AHandle, 1) <> 1 then
    return;
  end;
  if DoWfileXsputn(AHandle, uint64(ACall.Wide), ACall.Size) <> ACall.Size then
    return;
  end;
  ACall.Answer := ACall.Size;
end;

// --- the scan's stand-in -----------------------------------------------------------------

// The stand-in's read callback: the handle's next bytes as its own reads would give them (the
// backup area's, the main get area's, then the IO from the descriptor's place, which the scan
// leaves where it was; nothing past the end once EOF is seen). The count, 0 at the end, -1
// when the IO failed
routine clink DoCookieRead(ACookie: ptr; ABuffer: ptr to uint8; ASize: uint64): int64;
var
  LCookie: ptr to HookCookie;
  LCount: int64;
  LGot: int64;
  LWant: int64;
begin
  LCookie := ptr to HookCookie(ACookie);
  LWant := int64(ASize);
  LCount := 0;
  if LCookie->PendingLeft > 0 then
    LCount := LCookie->PendingLeft;
    if LCount > LWant then
      LCount := LWant;
    end;
    DoCopy(uint64(ABuffer), LCookie->Pending, LCount);
    LCookie->Pending := LCookie->Pending + uint64(LCount);
    LCookie->PendingLeft := LCookie->PendingLeft - LCount;
  else
    if LCookie->MainLeft > 0 then
      LCount := LCookie->MainLeft;
      if LCount > LWant then
        LCount := LWant;
      end;
      DoCopy(uint64(ABuffer), LCookie->Main, LCount);
      LCookie->Main := LCookie->Main + uint64(LCount);
      LCookie->MainLeft := LCookie->MainLeft - LCount;
    else
      if LCookie->AtEnd or (not LCookie->Handle->Readable) then
        return 0;
      end;
      LGot := DoPeekIO(LCookie->Handle, LCookie->Position, uint64(ABuffer), LWant);
      if LGot < 0 then
        return -1;
      end;
      LCookie->Position := LCookie->Position + LGot;
      LCount := LGot;
    end;
  end;
  LCookie->Delivered := LCookie->Delivered + LCount;
  return LCount;
end;

// The stand-in's seek callback: only asked where it stands (glibc's ftell of it: the bytes
// handed out); any other seek is refused
routine clink DoCookieSeek(ACookie: ptr; APosition: ptr to int64; AWhence: int32): int32;
var
  LCookie: ptr to HookCookie;
begin
  LCookie := ptr to HookCookie(ACookie);
  if (AWhence = _IO_seek_cur) and (APosition^ = 0) then
    APosition^ := LCookie->Delivered;
    return 0;
  end;
  return -1;
end;

// The real function AName (HookReal fills ASlot once); nil with ENOSYS when the C runtime has
// no such function
routine DoReal(var ASlot: ptr; const AName: ptr to const char): ptr;
var
  LFound: ptr;
begin
  LFound := HookReal(ASlot, AName);
  if LFound = nil then
    SetCErrno(ADAM_ERRNO_ENOSYS);
  end;
  return LFound;
end;

// The real fclose of AFile, a real FILE (a stand-in, a memstream), through ASlot
routine DoRealClose(var ASlot: ptr; const AFile: ptr);
var
  LFound: ptr;
  LClose: FileIntFn;
begin
  LFound := DoReal(ASlot, ptr to const char("fclose"));
  if LFound <> nil then
    LClose := FileIntFn(LFound);
    LClose(AFile);
  end;
end;

// --- descriptors: numbers on a handle's description (fileno, open(2), dup, fdopen) ---------

// A new reserved descriptor: glibc's open of ADAM_HOOKIO_RESERVE_PATH (read-only, closed on
// exec), so the number is the kernel's and no other open gets it while it is held; -1 with
// glibc's errno (EMFILE ..)
routine DoReserveDescriptor(): int32;
var
  LFound: ptr;
  LOpen: OpenFn;
begin
  LFound := DoReal(GRealOpen, ptr to const char("open"));
  if LFound = nil then
    return -1;
  end;
  LOpen := OpenFn(LFound);
  return LOpen(ADAM_HOOKIO_RESERVE_PATH, O_RDONLY | O_CLOEXEC, 0u);
end;

// glibc's close of AFile (errno left as it was): a reservation given back, a wide scan's
// stand-in file
routine DoCloseReal(const AFile: int32);
var
  LFound: ptr;
  LClose: FdIntFn;
  LError: int32;
begin
  LError := CErrno();
  LFound := DoReal(GRealClose, ptr to const char("close"));
  if LFound <> nil then
    LClose := FdIntFn(LFound);
    LClose(AFile);
  end;
  SetCErrno(LError);
end;

// The real fcntl(F_DUPFD_CLOEXEC) of reservation AFile: a new reservation on the same file, the
// kernel's lowest free number at or above AMin (closed on exec, as every reservation); -1 with
// glibc's errno (EINVAL, EMFILE ..)
routine DoReserveCopy(const AFile: int32; const AMin: int32): int32;
var
  LFound: ptr;
  LFcntl: FcntlFn;
begin
  LFound := DoReal(GRealFcntl, ptr to const char("fcntl"));
  if LFound = nil then
    return -1;
  end;
  LFcntl := FcntlFn(LFound);
  return LFcntl(AFile, F_DUPFD_CLOEXEC, uint64(int64(AMin)));
end;

// The index of number AFile in GDescriptors, -1 when it is no handle's (the caller holds GLock)
routine DoNumberAtLocked(const AFile: int32): int64;
var
  LI: int64;
begin
  for LI := 0 to len(GDescriptors) - 1 do
    if GDescriptors[LI].Number = AFile then
      return LI;
    end;
  end;
  return -1;
end;

// AFile listed as a number on description ADesc, one user of it taken (the caller holds GLock)
routine DoListNumberLocked(const AFile: int32; const ADesc: ptr to HookHandle);
var
  LCount: int64;
begin
  ADesc->Users := ADesc->Users + 1;
  LCount := len(GDescriptors);
  setlength(GDescriptors, LCount + 1);
  GDescriptors[LCount].Number := AFile;
  GDescriptors[LCount].Handle := ADesc;
  GDescriptors[LCount].Closed := false;
  atomicadd(GDescriptorCount, 1);
end;

// GDescriptors' entry AAt taken out (the caller holds GLock): its description, the user the
// entry held now the caller's
routine DoUnlistLocked(const AAt: int64): ptr to HookHandle;
var
  LDesc: ptr to HookHandle;
  LCount: int64;
  LI: int64;
begin
  LDesc := GDescriptors[AAt].Handle;
  LCount := len(GDescriptors);
  LI := AAt;
  while LI < LCount - 1 do
    GDescriptors[LI] := GDescriptors[LI + 1];
    LI := LI + 1;
  end;
  setlength(GDescriptors, LCount - 1);
  atomicadd(GDescriptorCount, -1);
  return LDesc;
end;

// True when an open FILE of a user's (not one open(2) made) holds AFile as its _fileno (the
// caller holds GLock); AMark: each such FILE's descriptor closed (DescriptorClosed), as the
// kernel's close of the number leaves it
routine DoHoldersLocked(const AFile: int32; const AMark: bool): bool;
var
  LHandle: ptr to HookHandle;
  LFound: bool;
  LI: int64;
begin
  LFound := false;
  for LI := 0 to len(GHandles) - 1 do
    LHandle := GHandles[LI];
    if (LHandle->Descriptor = AFile) and (not LHandle->DescriptorOwned) then
      LFound := true;
      if AMark then
        LHandle->DescriptorClosed := true;
      end;
    end;
  end;
  return LFound;
end;

// True when a number names description ADesc (the caller holds GLock)
routine DoNamedLocked(const ADesc: ptr to HookHandle): bool;
var
  LI: int64;
begin
  for LI := 0 to len(GDescriptors) - 1 do
    if GDescriptors[LI].Handle = ADesc then
      return true;
    end;
  end;
  return false;
end;

// fclose, defined below
forward routine DoClose(const AFile: ptr; var AResult: int32): bool;

// A number on description ADesc given up (its entry out of GDescriptors, the entry's user now
// the caller's): a description no FILE of a user's holds (DescriptorOwned: open(2)'s, or one
// an fclose left to its other numbers) that no number names any more closes (fclose's work),
// then that user is given back. 0, or -1 with EIO when that close failed
routine DoGiveUpNumber(const ADesc: ptr to HookHandle): int32;
var
  LLast: bool;
  LResult: int32;
  LAnswer: int32;
begin
  LLast := false;
  lock (GLock) do
    if ADesc->DescriptorOwned and (not ADesc->Closed) then
      LLast := not DoNamedLocked(ADesc);
    end;
  end;
  LAnswer := 0;
  if LLast then
    if DoClose(ptr(ADesc), LResult) and (LResult <> 0) then
      SetCErrno(ADAM_ERRNO_EIO);
      LAnswer := -1;
    end;
  end;
  DoReleaseHandle(ADesc);
  return LAnswer;
end;

// AHandle's descriptor (the caller holds its stream lock): the one it holds, else a new
// reservation listed as a number on its description (DoDescOf) and written to the FILE head's
// _fileno; -1 with errno when no descriptor can be reserved, or EBADF when a dup2 / dup3 took
// its number over. A success leaves errno as it was
routine DoDescriptorLocked(const AHandle: ptr to HookHandle): int32;
var
  LFile: int32;
  LError: int32;
begin
  if AHandle->Descriptor >= 0 then
    return AHandle->Descriptor;
  end;
  if AHandle->DescriptorClosed then
    SetCErrno(ADAM_ERRNO_EBADF);
    return -1;
  end;
  LError := CErrno();
  LFile := DoReserveDescriptor();
  if LFile < 0 then
    return -1;
  end;
  SetCErrno(LError);
  AHandle->Descriptor := LFile;
  AHandle->Head._fileno := LFile;
  lock (GLock) do
    DoListNumberLocked(LFile, DoDescOf(AHandle));
  end;
  return LFile;
end;

// The description number AFile names, with one more user (given back with DoReleaseHandle),
// or nil when AFile is not a handle's; AClosed: close(2) ran on it (the number kept for its
// FILE). While no handle holds one no lock is taken
routine DoFindDescriptor(const AFile: int32; var AClosed: bool): ptr to HookHandle;
var
  LHandle: ptr to HookHandle;
  LAt: int64;
begin
  AClosed := false;
  if (AFile < 0) or (atomicload(GDescriptorCount) = 0) then
    return nil;
  end;
  lock (GLock) do
    LAt := DoNumberAtLocked(AFile);
    if LAt >= 0 then
      LHandle := GDescriptors[LAt].Handle;
      LHandle->Users := LHandle->Users + 1;
      AClosed := GDescriptors[LAt].Closed;
      return LHandle;
    end;
  end;
  return nil;
end;

// AHandle's FILE gives up its descriptor (fclose, a failed freopen): its _fileno cleared; the
// number stays reserved, closed (DoHoldersLocked), while another open FILE holds it as its own
// (an fdopen of fileno's number), else it is given back: out of GDescriptors, the reservation
// closed, DoGiveUpNumber on its description. Nothing when it holds none
routine DoDropDescriptor(const AHandle: ptr to HookHandle);
var
  LFile: int32;
  LDesc: ptr to HookHandle;
  LAt: int64;
begin
  LFile := AHandle->Descriptor;
  if LFile < 0 then
    return;
  end;
  LDesc := nil;
  lock (GLock) do
    AHandle->Descriptor := -1;
    AHandle->DescriptorOwned := false;
    AHandle->DescriptorClosed := false;
    AHandle->Head._fileno := -1;
    LAt := DoNumberAtLocked(LFile);
    if LAt >= 0 then
      if DoHoldersLocked(LFile, true) then
        GDescriptors[LAt].Closed := true;
      else
        LDesc := DoUnlistLocked(LAt);
      end;
    end;
  end;
  if LDesc <> nil then
    DoCloseReal(LFile);
    DoGiveUpNumber(LDesc);
  end;
end;

// True when AHandle's description is another's too (the caller holds GLock): a number other
// than its own _fileno names it, or an open FILE other than it runs its system calls on it
// through another number (an fdopen of a dup)
routine DoSharedLocked(const AHandle: ptr to HookHandle): bool;
var
  LOther: ptr to HookHandle;
  LI: int64;
begin
  for LI := 0 to len(GDescriptors) - 1 do
    if (GDescriptors[LI].Handle = AHandle) and
      (GDescriptors[LI].Number <> AHandle->Descriptor) then
      return true;
    end;
  end;
  for LI := 0 to len(GHandles) - 1 do
    LOther := GHandles[LI];
    if (LOther <> AHandle) and (LOther->Desc = AHandle) and
      (LOther->Descriptor <> AHandle->Descriptor) then
      return true;
    end;
  end;
  return false;
end;

// AHandle's description moved to a new internal handle when another number or FILE still uses
// it (DoSharedLocked; the caller holds AHandle's stream lock and is closing its stream): the
// kernel's open file description outlives the FILE that opened it. The new handle takes the
// IO (its ownership, entry use and folder source), the place, the rights and a pipe's replay,
// shares the stream lock and is DescriptorOwned (it closes with its last number:
// DoGiveUpNumber); those numbers and FILEs move onto it with their users. AHandle is left with
// no IO; its own number, and a FILE sharing that number, stay on it. Nothing when the
// description is AHandle's alone, when AHandle runs on another's (Desc), or when no handle
// can be made (they stay on it)
routine DoMoveDescriptionLocked(const AHandle: ptr to HookHandle);
var
  LDesc: ptr to HookHandle;
  LOther: ptr to HookHandle;
  LEmpty: array of uint8;
  LShared: bool;
  LI: int64;
begin
  if AHandle->Desc <> nil then
    return;
  end;
  lock (GLock) do
    LShared := DoSharedLocked(AHandle);
  end;
  if not LShared then
    return;
  end;
  create(LDesc);
  if LDesc = nil then
    return;
  end;
  LDesc->Users := 1;
  LDesc->Base := AHandle->Base;
  LDesc->Readable := AHandle->Readable;
  LDesc->Writable := AHandle->Writable;
  LDesc->Appending := AHandle->Appending;
  LDesc->Pipe := AHandle->Pipe;
  LDesc->Replay := AHandle->Replay;
  LDesc->ReplayNext := AHandle->ReplayNext;
  LDesc->Path := AHandle->Path;
  LDesc->Io.Flags := _IO_MAGIC | _IO_IS_FILEBUF | _IO_NO_READS | _IO_NO_WRITES | _IO_TIED_PUT_GET;
  LDesc->Io.Offset := ADAM_HOOKIO_POS_BAD;
  LDesc->Head._fileno := -1;
  LDesc->Descriptor := -1;
  LDesc->DescriptorOwned := true;
  LDesc->DescriptorClosed := false;
  DoMirror(LDesc);
  lock (GLock) do
    LDesc->Base.Lock->Users := LDesc->Base.Lock->Users + 1;
    for LI := 0 to len(GDescriptors) - 1 do
      if (GDescriptors[LI].Handle = AHandle) and
        (GDescriptors[LI].Number <> AHandle->Descriptor) then
        GDescriptors[LI].Handle := LDesc;
        LDesc->Users := LDesc->Users + 1;
        AHandle->Users := AHandle->Users - 1;
      end;
    end;
    for LI := 0 to len(GHandles) - 1 do
      LOther := GHandles[LI];
      if (LOther <> AHandle) and (LOther->Desc = AHandle) and
        (LOther->Descriptor <> AHandle->Descriptor) then
        LOther->Desc := LDesc;
        LDesc->Users := LDesc->Users + 1;
        AHandle->Users := AHandle->Users - 1;
      end;
    end;
  end;
  AHandle->Base.Stream := nil;
  AHandle->Base.Owned := false;
  AHandle->Base.Source := nil;
  AHandle->Base.EntryName := "";
  AHandle->Base.Temporary := false;
  AHandle->Base.OwnedSource := nil;
  AHandle->Replay := LEmpty;
  AHandle->ReplayNext := 0;
  DoAddHandle(LDesc);
end;

// The characters of a wide area from AFrom to ATo added to AChars (ACount of them held so
// far, at most AWant)
routine DoScanTake(var AChars: array of uint32; var ACount: int64; const AFrom: uint64;
  const ATo: uint64; const AWant: int64);
var
  LAt: uint64;
begin
  LAt := AFrom;
  while (LAt < ATo) and (ACount < AWant) do
    AChars[ACount] := DoWideAt(LAt);
    ACount := ACount + 1;
    LAt := DoWideStep(LAt, 1);
  end;
end;

// The characters a wide scan's stand-in is given: the handle's next ones as its own reads
// would give them, at most AWant: the wide get area's (the backup area's, then the main
// one's), then the byte get area's bytes and the IO's from the descriptor's place (unless the
// end was seen) converted on from where the stream's conversion stands (its state set back
// after). AMore: AWant were found and the stream may have more. Bytes that are no character
// end them, as they end the stream's own reads
routine DoScanChars(const AHandle: ptr to HookHandle; const AWant: int64; var AChars: array of uint32;
  var AMore: bool);
var
  LIo: ptr to HookLibio;
  LWide: ptr to HookWide;
  LCount: int64;
  LState: HookCvState;
  LPending: array of uint8;
  LPendingAt: int64;
  LPendingCount: int64;
  LPosition: int64;
  LAtEnd: bool;
  LStatus: HookCv;
  LStop: uint64;
  LOutStop: uint64;
  LGot: int64;
  LMade: int64;
  LLeft: int64;
begin
  LIo := addr of AHandle->Io;
  LWide := addr of AHandle->Wide;
  setlength(AChars, AWant);
  LCount := 0;
  AMore := false;
  DoScanTake(AChars, LCount, LWide->ReadPtr, LWide->ReadEnd, AWant);
  if (LIo->Flags & _IO_IN_BACKUP) <> 0u then
    DoScanTake(AChars, LCount, LWide->SaveBase, LWide->SaveEnd, AWant);
  end;
  // The bytes not yet converted: the byte get area's, then the IO's (ADAM_HOOKIO_BLOCK_SIZE at
  // a time)
  LPendingCount := int64(LIo->ReadEnd - LIo->ReadPtr);
  setlength(LPending, LPendingCount + ADAM_HOOKIO_BLOCK_SIZE);
  if LPendingCount > 0 then
    DoCopy(uint64(addr of LPending[0]), LIo->ReadPtr, LPendingCount);
  end;
  LPendingAt := 0;
  LPosition := DoDescOf(AHandle)->Base.Position;
  LAtEnd := ((LIo->Flags & _IO_EOF_SEEN) <> 0u) or (not AHandle->Readable);
  DoCvSave(LWide->ToWide, LState);
  while LCount < AWant do
    LStatus := HookCv.Ok;
    if LPendingCount > LPendingAt then
      LStatus := DoCvRun(LWide->ToWide, uint64(addr of LPending[LPendingAt]),
        uint64(addr of LPending[0]) + uint64(LPendingCount), LStop,
        uint64(addr of AChars[LCount]), DoWideStep(uint64(addr of AChars[0]), AWant), LOutStop);
      LMade := DoWideCount(uint64(addr of AChars[LCount]), LOutStop);
      LCount := LCount + LMade;
      LPendingAt := int64(LStop) - int64(uint64(addr of LPending[0]));
    end;
    if (LCount >= AWant) or (LStatus = HookCv.Error) then
      leave;
    end;
    if LAtEnd then
      leave;
    end;
    // More bytes: what is left moved to the front, a block of the IO after it
    LLeft := LPendingCount - LPendingAt;
    if (LLeft > 0) and (LPendingAt > 0) then
      DoMoveDown(uint64(addr of LPending[0]), uint64(addr of LPending[LPendingAt]), LLeft);
    end;
    LPendingCount := LLeft;
    LPendingAt := 0;
    setlength(LPending, LPendingCount + ADAM_HOOKIO_BLOCK_SIZE);
    LGot := DoPeekIO(AHandle, LPosition, uint64(addr of LPending[LPendingCount]),
      ADAM_HOOKIO_BLOCK_SIZE);
    if LGot <= 0 then
      LAtEnd := true;
    else
      LPosition := LPosition + LGot;
      LPendingCount := LPendingCount + LGot;
    end;
  end;
  DoCvLoad(LWide->ToWide, LState);
  AMore := LCount >= AWant;
  setlength(AChars, LCount);
end;

// The UTF-8 bytes of the character AChar (1 to 4)
routine DoUtf8Length(const AChar: uint32): int64;
begin
  if AChar < 0x80u then
    return 1;
  end;
  if AChar < 0x800u then
    return 2;
  end;
  if AChar < 0x10000u then
    return 3;
  end;
  return 4;
end;

// AChar's UTF-8 stored at AText[AAt..]; the index after it
routine DoUtf8Put(var AText: array of uint8; const AAt: int64; const AChar: uint32): int64;
begin
  if AChar < 0x80u then
    AText[AAt] := uint8(AChar);
    return AAt + 1;
  end;
  if AChar < 0x800u then
    AText[AAt] := uint8(0xC0u | (AChar shr 6));
    AText[AAt + 1] := uint8(0x80u | (AChar & 0x3Fu));
    return AAt + 2;
  end;
  if AChar < 0x10000u then
    AText[AAt] := uint8(0xE0u | (AChar shr 12));
    AText[AAt + 1] := uint8(0x80u | ((AChar shr 6) & 0x3Fu));
    AText[AAt + 2] := uint8(0x80u | (AChar & 0x3Fu));
    return AAt + 3;
  end;
  AText[AAt] := uint8(0xF0u | ((AChar shr 18) & 0x07u));
  AText[AAt + 1] := uint8(0x80u | ((AChar shr 12) & 0x3Fu));
  AText[AAt + 2] := uint8(0x80u | ((AChar shr 6) & 0x3Fu));
  AText[AAt + 3] := uint8(0x80u | (AChar & 0x3Fu));
  return AAt + 4;
end;

// A wide scan's stand-in: a real wide FILE (a fopencookie FILE is byte-only) reading the UTF-8
// of AChars: a temporary file (mkstemp) written with it, opened "r,ccs=UTF-8" by glibc's own
// fopen, then unlinked. nil (errno set) when it cannot be made
routine DoWideStandIn(var AChars: array of uint32): ptr;
var
  LText: array of uint8;
  LSize: int64;
  LAt: int64;
  LI: int64;
  LPath: ptr to char;
  LMode: ptr to char;
  LFd: int32;
  LDone: int64;
  LGot: int64;
  LFound: ptr;
  LWrite: FdWriteFn;
  LFopen: FopenFn;
  LFile: ptr;
begin
  LSize := 0;
  for LI := 0 to len(AChars) - 1 do
    LSize := LSize + DoUtf8Length(AChars[LI]);
  end;
  setlength(LText, LSize + 1);
  LAt := 0;
  for LI := 0 to len(AChars) - 1 do
    LAt := DoUtf8Put(LText, LAt, AChars[LI]);
  end;
  LPath := StringToC(ADAM_HOOKIO_STAND_IN_PATH);
  LFd := mkstemp(LPath);
  if LFd < 0 then
    freemem(LPath);
    return nil;
  end;
  // glibc's write and close (the stand-in's file is never a handle's)
  LDone := 0;
  LFound := DoReal(GRealWrite, ptr to const char("write"));
  if LFound <> nil then
    LWrite := FdWriteFn(LFound);
    while LDone < LSize do
      LGot := LWrite(LFd, ptr(addr of LText[LDone]), uint64(LSize - LDone));
      if LGot <= 0 then
        leave;
      end;
      LDone := LDone + LGot;
    end;
  end;
  DoCloseReal(LFd);
  LFile := nil;
  if LDone = LSize then
    LFound := DoReal(GRealStandInFopen, ptr to const char("fopen"));
    if LFound <> nil then
      LFopen := FopenFn(LFound);
      LMode := StringToC("r,ccs=UTF-8");
      LFile := LFopen(LPath, LMode);
      freemem(LMode);
    end;
  end;
  unlink(LPath);
  freemem(LPath);
  return LFile;
end;

// A wide scan on a handle (vfwscanf / __isoc99_vfwscanf: ScanReal): glibc's own scan over a
// stand-in wide FILE of the handle's next characters (DoScanChars, DoWideStandIn), then the
// characters whose UTF-8 the scan used (the stand-in's ftell) taken as getwc takes them (and,
// when the stand-in met its end, the handle's end looked for the same way). A stand-in that
// met its end while the handle has more is made again with four times the characters and the
// scan run again over a copy of its va_list (glibc's scan does the same on the same input).
// Refused first as glibc refuses: a stream that cannot read (EBADF, no error flag), a byte
// one. The scan's answer
routine DoCallScanWide(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LIo: ptr to HookLibio;
  LArgs: array[0..2] of uint64;
  LWant: int64;
  LChars: array of uint32;
  LMore: bool;
  LStandIn: ptr;
  LScan: VfscanfFn;
  LTell: FtellFn;
  LFeof: FileIntFn;
  LFound: ptr;
  LUsed: int64;
  LAtEnd: bool;
  LBytes: int64;
  LTake: int64;
  LI: int64;
  LErrno: int32;
begin
  LIo := addr of AHandle->Io;
  ACall.Answer := int64(ADAM_HOOKIO_WEOF);
  if (LIo->Flags & _IO_NO_READS) <> 0u then
    SetCErrno(ADAM_ERRNO_EBADF);
    return;
  end;
  if DoFwide(AHandle, 1) <> 1 then
    return;
  end;
  // A put area in use is flushed first, as the scan's first read would (__wuflow)
  if (LIo->Flags & _IO_CURRENTLY_PUTTING) <> 0u then
    if DoSwitchToWgetMode(AHandle) = ADAM_HOOKIO_EOF then
      return;
    end;
  end;
  DoCopy(uint64(addr of LArgs[0]), uint64(ACall.ScanArgs), ADAM_HOOKIO_VA_LIST_BYTES);
  LWant := ADAM_HOOKIO_WIDE_SCAN_STEP;
  LUsed := 0;
  LAtEnd := false;
  while true do
    DoScanChars(AHandle, LWant, LChars, LMore);
    LErrno := CErrno();
    LStandIn := DoWideStandIn(LChars);
    if LStandIn = nil then
      LIo->Flags := LIo->Flags | _IO_ERR_SEEN;
      return;
    end;
    SetCErrno(LErrno);
    DoCopy(uint64(ACall.ScanArgs), uint64(addr of LArgs[0]), ADAM_HOOKIO_VA_LIST_BYTES);
    LScan := VfscanfFn(ACall.ScanReal);
    ACall.Answer := int64(LScan(LStandIn, ACall.ScanFormat, ACall.ScanArgs));
    LUsed := 0;
    LFound := DoReal(GRealCookieFtell, ptr to const char("ftell"));
    if LFound <> nil then
      LTell := FtellFn(LFound);
      LUsed := LTell(LStandIn);
    end;
    LAtEnd := false;
    LFound := DoReal(GRealCookieFeof, ptr to const char("feof"));
    if LFound <> nil then
      LFeof := FileIntFn(LFound);
      LAtEnd := LFeof(LStandIn) <> 0;
    end;
    DoRealClose(GRealCookieFclose, LStandIn);
    if not (LAtEnd and LMore) then
      leave;
    end;
    LWant := LWant * 4;
  end;
  if LUsed < 0 then
    LUsed := 0;
  end;
  // The characters whose UTF-8 the scan used, taken
  LBytes := 0;
  LTake := 0;
  while (LTake < len(LChars)) and (LBytes + DoUtf8Length(LChars[LTake]) <= LUsed) do
    LBytes := LBytes + DoUtf8Length(LChars[LTake]);
    LTake := LTake + 1;
  end;
  for LI := 1 to LTake do
    if DoGetwc(AHandle) = int64(ADAM_HOOKIO_WEOF) then
      leave;
    end;
  end;
  // The end the stand-in met, met here too
  if LAtEnd then
    DoWflow(AHandle, false);
  end;
end;

// A scan on a handle (glibc's vfscanf / __isoc99_vfscanf: ScanReal; a wide one, AWide:
// DoCallScanWide) over a stand-in fopencookie FILE reading what the handle would read next,
// then the handle moved on by exactly what the scan used (the stand-in's ftell): the bytes
// taken through the model as getc would take them (and, when the stand-in met the end, the
// handle's end found the same way). Refused first as glibc refuses: a stream that cannot read
// (EBADF, no error flag), a wide one. The scan's answer
routine DoCallScan(const AHandle: ptr to HookHandle; var ACall: HookCall; const AWide: bool);
var
  LIo: ptr to HookLibio;
  LCookie: HookCookie;
  LFunctions: cookie_io_functions_t;
  LMode: ptr to char;
  LStandIn: ptr;
  LScan: VfscanfFn;
  LTell: FtellFn;
  LFeof: FileIntFn;
  LFound: ptr;
  LUsed: int64;
  LAtEnd: bool;
  LI: int64;
begin
  if AWide then
    DoCallScanWide(AHandle, ACall);
    return;
  end;
  LIo := addr of AHandle->Io;
  ACall.Answer := ADAM_HOOKIO_EOF;
  if (LIo->Flags & _IO_NO_READS) <> 0u then
    SetCErrno(ADAM_ERRNO_EBADF);
    return;
  end;
  if DoFwide(AHandle, -1) <> -1 then
    return;
  end;
  // A put area in use is flushed first, as the scan's first read would
  if (LIo->Flags & _IO_CURRENTLY_PUTTING) <> 0u then
    if DoSwitchToGetMode(AHandle) = ADAM_HOOKIO_EOF then
      return;
    end;
  end;
  LCookie.Handle := AHandle;
  LCookie.Delivered := 0;
  LCookie.Position := DoDescOf(AHandle)->Base.Position;
  LCookie.AtEnd := (LIo->Flags & _IO_EOF_SEEN) <> 0u;
  if (LIo->Flags & _IO_IN_BACKUP) <> 0u then
    LCookie.Pending := LIo->ReadPtr;
    LCookie.PendingLeft := int64(LIo->ReadEnd - LIo->ReadPtr);
    LCookie.Main := LIo->SaveBase;
    LCookie.MainLeft := int64(LIo->SaveEnd - LIo->SaveBase);
  else
    LCookie.Pending := 0u;
    LCookie.PendingLeft := 0;
    LCookie.Main := LIo->ReadPtr;
    LCookie.MainLeft := int64(LIo->ReadEnd - LIo->ReadPtr);
  end;
  LFunctions.read := DoCookieRead;
  LFunctions.write := nil;
  LFunctions.seek := DoCookieSeek;
  LFunctions.close := nil;
  LMode := StringToC("r");
  LStandIn := fopencookie(addr of LCookie, LMode, LFunctions);
  freemem(LMode);
  if LStandIn = nil then
    return;
  end;
  LScan := VfscanfFn(ACall.ScanReal);
  ACall.Answer := int64(LScan(LStandIn, ACall.ScanFormat, ACall.ScanArgs));
  LUsed := 0;
  LFound := DoReal(GRealCookieFtell, ptr to const char("ftell"));
  if LFound <> nil then
    LTell := FtellFn(LFound);
    LUsed := LTell(LStandIn);
  end;
  LAtEnd := false;
  LFound := DoReal(GRealCookieFeof, ptr to const char("feof"));
  if LFound <> nil then
    LFeof := FileIntFn(LFound);
    LAtEnd := LFeof(LStandIn) <> 0;
  end;
  DoRealClose(GRealCookieFclose, LStandIn);
  if LUsed < 0 then
    LUsed := 0;
  end;
  // The bytes used, taken as getc takes them; the end the stand-in met, met here too
  for LI := 1 to LUsed do
    if DoGetc(AHandle) = ADAM_HOOKIO_EOF then
      leave;
    end;
  end;
  if LAtEnd and (LIo->ReadPtr >= LIo->ReadEnd) then
    DoFlowBody(AHandle, false);
  end;
end;

// --- running a call on a handle -------------------------------------------------------------

// __fpending: the put area's unwritten bytes (a wide stream's characters)
routine DoPendingCount(const AHandle: ptr to HookHandle): int64;
begin
  if AHandle->Io.Orientation > 0 then
    return DoWideCount(AHandle->Wide.WriteBase, AHandle->Wide.WritePtr);
  end;
  return int64(AHandle->Io.WritePtr - AHandle->Io.WriteBase);
end;

// __fbufsize: the buffer's bytes (a wide stream's wide buffer's characters)
routine DoBufferCount(const AHandle: ptr to HookHandle): int64;
begin
  if AHandle->Io.Orientation > 0 then
    return DoWideCount(AHandle->Wide.BufBase, AHandle->Wide.BufEnd);
  end;
  return int64(AHandle->Io.BufEnd - AHandle->Io.BufBase);
end;

// A call of AOp whose answer, until it runs, is AFail; no arguments yet
routine DoCall(const AOp: HookOp; const AFail: int64): HookCall;
var
  LCall: HookCall;
begin
  LCall.Op := AOp;
  LCall.Buffer := nil;
  LCall.Size := 0;
  LCall.ItemSize := 0;
  LCall.Offset := 0;
  LCall.Origin := 0;
  LCall.Value := 0;
  LCall.Line := nil;
  LCall.LineSize := nil;
  LCall.Wide := nil;
  LCall.ScanReal := nil;
  LCall.ScanFormat := nil;
  LCall.ScanArgs := nil;
  LCall.Answer := AFail;
  return LCall;
end;

// C's truth value of a flag test: 1 or 0
routine DoFlagValue(const AFlag: bool): int64;
begin
  if AFlag then
    return 1;
  end;
  return 0;
end;

// ACall run on AHandle, under its stream lock; the FILE head brought in step after
routine DoRun(const AHandle: ptr to HookHandle; var ACall: HookCall);
var
  LIo: ptr to HookLibio;
begin
  LIo := addr of AHandle->Io;
  match ACall.Op of
    HookOp.Read: DoCallRead(AHandle, ACall);
    HookOp.Write: DoCallWrite(AHandle, ACall);
    HookOp.Get: ACall.Answer := DoGetc(AHandle);
    HookOp.GetUnlocked: ACall.Answer := DoGetc(AHandle);
    HookOp.Gets: DoCallGets(AHandle, ACall);
    HookOp.Getline: DoCallGetdelim(AHandle, ACall);
    HookOp.Unget: DoCallUnget(AHandle, ACall);
    HookOp.Put: ACall.Answer := DoPutc(AHandle, ACall.Value);
    HookOp.PutUnlocked: ACall.Answer := DoPutc(AHandle, ACall.Value);
    HookOp.Puts: DoCallPuts(AHandle, ACall);
    HookOp.Peek: ACall.Answer := DoPeekc(AHandle);
    HookOp.Uflow: ACall.Answer := DoUflow(AHandle);
    HookOp.Underflow: ACall.Answer := DoUnderflow(AHandle);
    HookOp.Overflow: ACall.Answer := DoOverflow(AHandle, ACall.Value);
    HookOp.GetWide: ACall.Answer := DoGetWideLocked(AHandle);
    HookOp.GetsWide: ACall.Answer := DoGetsWideLocked(AHandle, ACall);
    HookOp.UngetWide: ACall.Answer := DoUngetWideLocked(AHandle, uint32(ACall.Value));
    HookOp.PutWide: ACall.Answer := DoPutWideCall(AHandle, uint32(ACall.Value));
    HookOp.PutWideRaw: ACall.Answer := DoPutwc(AHandle, uint32(ACall.Value));
    HookOp.PutsWide: ACall.Answer := DoPutsWideLocked(AHandle, ACall.Wide);
    HookOp.Orient: ACall.Answer := DoFwide(AHandle, ACall.Value);
    HookOp.Seek: ACall.Answer := DoSeek(AHandle, ACall.Offset, ACall.Origin);
    HookOp.Tell: ACall.Answer := DoTell(AHandle);
    HookOp.Rewind: DoSeekoffUnlocked(AHandle, 0, _IO_seek_set, ADAM_HOOKIO_SEEK_MODE);
    HookOp.GetPos: DoCallGetPos(AHandle, ACall);
    HookOp.SetPos: DoCallSetPos(AHandle, ACall);
    HookOp.AtEnd: ACall.Answer := DoFlagValue((LIo->Flags & _IO_EOF_SEEN) <> 0u);
    HookOp.Failed: ACall.Answer := DoFlagValue((LIo->Flags & _IO_ERR_SEEN) <> 0u);
    HookOp.ClearError: LIo->Flags := LIo->Flags & (~(_IO_EOF_SEEN | _IO_ERR_SEEN));
    HookOp.Flush: DoCallFlush(AHandle, ACall);
    HookOp.Setvbuf: ACall.Answer := DoSetvbuf(AHandle, uint64(ACall.Buffer), ACall.Value, uint64(ACall.Size));
    HookOp.Setbuffer: DoSetbuffer(AHandle, uint64(ACall.Buffer), uint64(ACall.Size));
    HookOp.Fileno: ACall.Answer := DoDescriptorLocked(AHandle);
    HookOp.Pending: ACall.Answer := DoPendingCount(AHandle);
    HookOp.Reading: ACall.Answer := DoFlagValue(((LIo->Flags & _IO_NO_WRITES) <> 0u) or
      (((LIo->Flags & (_IO_CURRENTLY_PUTTING | _IO_NO_READS)) = 0u) and (LIo->ReadBase <> 0u)));
    HookOp.Writing: ACall.Answer := int64(LIo->Flags & (_IO_NO_READS | _IO_CURRENTLY_PUTTING));
    HookOp.Readable: ACall.Answer := DoFlagValue((LIo->Flags & _IO_NO_READS) = 0u);
    HookOp.Writable: ACall.Answer := DoFlagValue((LIo->Flags & _IO_NO_WRITES) = 0u);
    HookOp.LineBuffered: ACall.Answer := int64(LIo->Flags & _IO_LINE_BUF);
    HookOp.BufferSize: ACall.Answer := DoBufferCount(AHandle);
    HookOp.Purge: DoCallPurge(AHandle);
    HookOp.Print: DoCallPrint(AHandle, ACall);
    HookOp.PrintWide: DoCallPrintWide(AHandle, ACall);
    HookOp.PrintCheck: DoCallPrintCheck(AHandle, ACall, false);
    HookOp.PrintWideCheck: DoCallPrintCheck(AHandle, ACall, true);
    HookOp.Locking: DoCallLocking(AHandle, ACall);
    HookOp.Scan: DoCallScan(AHandle, ACall, false);
    HookOp.ScanWide: DoCallScan(AHandle, ACall, true);
    HookOp.GetWord: DoCallGetWord(AHandle, ACall);
    HookOp.PutWord: DoCallPutWord(AHandle, ACall);
  end;
  if ACall.Op = HookOp.Rewind then
    LIo->Flags := LIo->Flags & (~(_IO_EOF_SEEN | _IO_ERR_SEEN));
  end;
  DoMirror(AHandle);
end;

// Runs ACall on AFile's handle under its stream lock. False: AFile is not a HookIO handle (the
// hook then calls the C runtime). A handle closed by a call that raced this one fails with
// EBADF (the call does not run; its answer stays the failure value)
routine DoWith(const AFile: ptr; var ACall: HookCall): bool;
var
  LHandle: ptr to HookHandle;
begin
  LHandle := DoFindHandle(AFile);
  if LHandle = nil then
    return false;
  end;
  lock (LHandle->Base.Lock->Lock) do
    if LHandle->Closed then
      SetCErrno(ADAM_ERRNO_EBADF);
    else
      DoRun(LHandle, ACall);
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// True when AFile is a HookIO handle
routine DoOwns(const AFile: ptr): bool;
var
  LHandle: ptr to HookHandle;
begin
  LHandle := DoFindHandle(AFile);
  if LHandle = nil then
    return false;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// --- opens -----------------------------------------------------------------------------------

// glibc's strip (fileops.c) of a ccs= charset: letters, digits and _ - . , : kept upper-cased
// (the C locale's), a third '/' ends it, then "//" until there are two
routine DoStripCharset(const AText: string): string;
var
  LOut: string;
  LSlashes: int32;
  LI: int64;
  LChar: char;
begin
  LOut := "";
  LSlashes := 0;
  LI := 0;
  while LI < len(AText) do
    LChar := AText[LI];
    if ((LChar >= 'a') and (LChar <= 'z')) then
      LOut := LOut + char(int32(LChar) - 32);
    else
      if ((LChar >= 'A') and (LChar <= 'Z')) or ((LChar >= '0') and (LChar <= '9')) or
        (LChar = '_') or (LChar = '-') or (LChar = '.') or (LChar = ',') or (LChar = ':') then
        LOut := LOut + LChar;
      else
        if LChar = '/' then
          LSlashes := LSlashes + 1;
          if LSlashes = 3 then
            leave;
          end;
          LOut := LOut + "/";
        end;
      end;
    end;
    LI := LI + 1;
  end;
  while LSlashes < 2 do
    LOut := LOut + "/";
    LSlashes := LSlashes + 1;
  end;
  return LOut;
end;

// AMode as glibc's _IO_new_file_fopen reads it: r, w or a (anything else: false, fopen's
// EINVAL), then up to six letters to a ',' or the end: + (read and write), x (exclusive), b,
// and m / c / e or anything else ignored; ",ccs=<charset>" after the last of + x b (or the
// first letter) names the stream's charset (AExtra.Charset, stripped; glibc takes the raw
// text upper-cased when strip leaves nothing)
routine DoParseMode(const AMode: string; var AResult: HookOpenMode; var AExtra: HookModeExtra): bool;
var
  LAt: int64;
  LChar: char;
  LLast: int64;
  LFind: int64;
  LEnd: int64;
  LRaw: string;
  LCharset: string;
  LI: int64;
begin
  AResult.First := 'r';
  AResult.Mode := FileMode.Read;
  AResult.Plus := false;
  AResult.Text := false;
  AResult.Exclusive := false;
  AResult.Temporary := false;
  AResult.Encoded := false;
  AResult.Encoding := 0;
  AExtra.Charset := "";
  if len(AMode) = 0 then
    return false;
  end;
  LChar := AMode[0];
  if LChar = 'r' then
    AResult.Mode := FileMode.Read;
  else
    if LChar = 'w' then
      AResult.Mode := FileMode.Write;
    else
      if LChar = 'a' then
        AResult.Mode := FileMode.Append;
      else
        return false;
      end;
    end;
  end;
  AResult.First := LChar;
  LLast := 0;
  LAt := 1;
  while (LAt < 7) and (LAt < len(AMode)) do
    LChar := AMode[LAt];
    if (LChar = ',') or (LChar = '\0') then
      leave;
    end;
    if LChar = '+' then
      AResult.Plus := true;
      LLast := LAt;
    end;
    if LChar = 'x' then
      AResult.Exclusive := true;
      LLast := LAt;
    end;
    if LChar = 'b' then
      LLast := LAt;
    end;
    LAt := LAt + 1;
  end;
  if AResult.Plus then
    AResult.Mode := FileMode.ReadWrite;
  end;
  // strstr(last_recognized + 1, ",ccs=")
  LFind := LLast + 1;
  while LFind + 5 <= len(AMode) do
    if Substring(AMode, LFind, 5) = ",ccs=" then
      LEnd := LFind + 5;
      while (LEnd < len(AMode)) and (AMode[LEnd] <> ',') do
        LEnd := LEnd + 1;
      end;
      LRaw := Substring(AMode, LFind + 5, LEnd - (LFind + 5));
      LCharset := DoStripCharset(LRaw);
      if len(LCharset) = 2 then
        // upstr: the raw text upper-cased
        LCharset := "";
        for LI := 0 to len(LRaw) - 1 do
          if (LRaw[LI] >= 'a') and (LRaw[LI] <= 'z') then
            LCharset := LCharset + char(int32(LRaw[LI]) - 32);
          else
            LCharset := LCharset + LRaw[LI];
          end;
        end;
      end;
      AExtra.Charset := LCharset;
      AResult.Encoded := true;
      leave;
    end;
    LFind := LFind + 1;
  end;
  return true;
end;

// Undoes an open that succeeded but cannot be handed out: closes the handle's own IO, gives its
// entry use back, closes a folder source of its own and frees the handle. errno is kept
routine DoAbandon(const AHandle: ptr to HookHandle);
var
  LError: int32;
begin
  LError := CErrno();
  if AHandle->Base.Owned then
    IOClose(AHandle->Base.Stream);
  end;
  AHandle->Base.Stream := nil;
  HookIOGiveBackEntry(addr of AHandle->Base, true);
  HookIOCloseOwnedSource(addr of AHandle->Base);
  DoFreeHandle(AHandle);
  SetCErrno(LError);
end;

// The open once a path named its target. AFound: AEntry is the registered IO or IOSource the
// path names (false: nothing is registered under it, ENOENT once the mode is read); ARest: ""
// or "/<entry>"; APath: the path as given (kept for freopen with no path); ACallerErrno: errno
// as the caller left it (a successful open leaves it so). The new handle, or nil with errno set
routine DoOpenOn(const AFound: bool; const AEntry: HookEntry; const ARest: string;
  const APath: string; const AMode: string; const ACallerErrno: int32): ptr;
var
  LParsed: HookOpenMode;
  LExtra: HookModeExtra;
  LHandle: ptr to HookHandle;
  LOpened: bool;
  LPlace: int64;
begin
  // glibc reads the mode before it touches the file
  if not DoParseMode(AMode, LParsed, LExtra) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return nil;
  end;
  if not AFound then
    SetCErrno(ADAM_ERRNO_ENOENT);
    return nil;
  end;
  // O_EXCL: a creating open (w, a) fails when its target exists
  if LParsed.Exclusive and (LParsed.First <> 'r') and HookIOExists(AEntry, ARest) then
    SetCErrno(ADAM_ERRNO_EEXIST);
    return nil;
  end;
  create(LHandle);
  if LHandle = nil then
    SetCErrno(ADAM_ERRNO_ENOMEM);
    return nil;
  end;
  LHandle->Users := 1;
  LHandle->Path := APath;
  LHandle->Readable := (LParsed.First = 'r') or LParsed.Plus;
  LHandle->Writable := (LParsed.First <> 'r') or LParsed.Plus;
  LHandle->Appending := LParsed.First = 'a';
  // _IO_new_file_init + _IO_file_open: a closed filebuf's flags, then the mode's read / write
  // rights (+ keeps only the appending bit)
  LHandle->Io.Flags := _IO_MAGIC | _IO_IS_FILEBUF | _IO_TIED_PUT_GET | _IO_LINKED;
  if not LHandle->Readable then
    LHandle->Io.Flags := LHandle->Io.Flags | _IO_NO_READS;
  end;
  if not LHandle->Writable then
    LHandle->Io.Flags := LHandle->Io.Flags | _IO_NO_WRITES;
  end;
  if LHandle->Appending then
    LHandle->Io.Flags := LHandle->Io.Flags | _IO_IS_APPENDING;
  end;
  LHandle->Io.Offset := ADAM_HOOKIO_POS_BAD;
  LHandle->Io.Orientation := 0;
  LHandle->Head._fileno := -1;
  LHandle->Descriptor := -1;
  LHandle->DescriptorOwned := false;
  LHandle->DescriptorClosed := false;
  LHandle->Wide.Charset := LExtra.Charset;
  // errno is set by the open that fails
  if AEntry.Stream <> nil then
    LOpened := HookIOOpenShared(AEntry, LParsed, addr of LHandle->Base);
  else
    LOpened := HookIOOpenEntry(AEntry.Source, ARest, LParsed, addr of LHandle->Base);
  end;
  if not LOpened then
    DoFreeHandle(LHandle);
    return nil;
  end;
  // An IO with no Seek callback is a pipe / FIFO to glibc: S_ISFIFO, lseek ESPIPE
  LHandle->Pipe := not IOCanSeek(LHandle->Base.Stream);
  LHandle->ReplayNext := 0;
  // A write-only appending open sends the descriptor to the end (the offset cache untouched:
  // _IO_file_open); "a+" stays at 0
  if LHandle->Appending and (not LHandle->Readable) then
    lock (LHandle->Base.Lock->Lock) do
      LPlace := IOSeek(LHandle->Base.Stream, 0, SeekOrigin.FromEnd);
      if LPlace >= 0 then
        LHandle->Base.Position := LPlace;
      end;
    end;
  end;
  SetCErrno(ACallerErrno);
  // A ccs= open turns wide now; a charset iconv lacks fails the open (EINVAL)
  if len(LExtra.Charset) > 0 then
    if not DoOpenConversion(LHandle) then
      SetCErrno(ADAM_ERRNO_EINVAL);
      DoAbandon(LHandle);
      return nil;
    end;
    LHandle->Io.Orientation := 1;
  end;
  DoMirror(LHandle);
  DoAddHandle(LHandle);
  SetCErrno(ACallerErrno);
  return ptr(LHandle);
end;

// A hooked open of APath in AMode (both UTF-8). False: neither a virtual path nor one the path
// source holds (HookIOResolve), the caller passes it to the C runtime with errno as it came.
// True: handled; AResult is the new handle, or nil with errno set
routine DoOpenText(const APath: string; const AMode: string; var AResult: ptr): bool;
var
  LEntry: HookEntry;
  LRest: string;
  LId: uint64;
  LFound: bool;
  LCallerErrno: int32;
begin
  LCallerErrno := CErrno();
  AResult := nil;
  if not HookIOResolve(APath, LId, LRest) then
    SetCErrno(LCallerErrno);
    return false;
  end;
  LEntry.Id := 0;
  LEntry.Stream := nil;
  LEntry.Source := nil;
  LEntry.Lock := nil;
  // The open's own work (the source's real files) never maps a plain path
  HookIOEnterPathWork();
  LFound := false;
  if LId <> 0u then
    LFound := HookIOFind(LId, LEntry);
  end;
  SetCErrno(LCallerErrno);
  AResult := DoOpenOn(LFound, LEntry, LRest, APath, AMode, LCallerErrno);
  // The entry's stream lock user HookIOFind took (a handle holds its own)
  HookIOReleaseLock(LEntry.Lock);
  HookIOLeavePathWork();
  return true;
end;

// A hooked open of the C texts APath and AMode, as DoOpenText; false for a nil path
routine DoOpen(const APath: ptr to const char; const AMode: ptr to const char;
  var AResult: ptr): bool;
begin
  AResult := nil;
  if APath = nil then
    return false;
  end;
  return DoOpenText(StringFromC(APath), DoCText(AMode), AResult);
end;

// --- the query family -----------------------------------------------------------------------

// access on a virtual path (or one the path source holds): AResult 0, or -1 with errno: a mode
// past R_OK | W_OK | X_OK EINVAL, missing ENOENT, X_OK (never executable) or W_OK where an
// "r+" open would fail EACCES. False: not such a path
routine DoAccess(const APath: ptr to const char; const AMode: int32; var AResult: int32): bool;
var
  LPath: string;
  LRest: string;
  LId: uint64;
  LQuery: HookQuery;
begin
  AResult := -1;
  if APath = nil then
    return false;
  end;
  LPath := StringFromC(APath);
  if not HookIOResolve(LPath, LId, LRest) then
    return false;
  end;
  if (AMode & (~(R_OK | W_OK | X_OK))) <> 0 then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return true;
  end;
  if not HookIOQuery(LPath, LQuery) then
    SetCErrno(ADAM_ERRNO_ENOENT);
    return true;
  end;
  if not LQuery.Found then
    return true;
  end;
  if (AMode & X_OK) <> 0 then
    SetCErrno(ADAM_ERRNO_EACCES);
    return true;
  end;
  if ((AMode & W_OK) <> 0) and (not LQuery.Writable) then
    SetCErrno(ADAM_ERRNO_EACCES);
    return true;
  end;
  AResult := 0;
  return true;
end;

// ABuf (a struct stat / stat64, HookStat) filled for a virtual file of AType (S_IFREG, a
// handle on an IO that cannot seek S_IFIFO) and ASize bytes: readable by all, writable by all
// when AWritable, one link, its size in 512-byte blocks, a 4096-byte block
// (ADAM_HOOKIO_BLOCK_SIZE), no device, owner or times (0)
routine DoFillStat(const ABuf: ptr; const AType: uint32; const ASize: int64; const AWritable: bool);
var
  LStat: ptr to HookStat;
  LMode: uint32;
begin
  LMode := AType | S_IRUSR | S_IRGRP | S_IROTH;
  if AWritable then
    LMode := LMode | S_IWUSR | S_IWGRP | S_IWOTH;
  end;
  LStat := ptr to HookStat(ABuf);
  LStat->st_dev := 0u;
  LStat->st_ino := 0u;
  LStat->st_nlink := 1u;
  LStat->st_mode := LMode;
  LStat->st_uid := 0u;
  LStat->st_gid := 0u;
  LStat->pad0 := 0;
  LStat->st_rdev := 0u;
  LStat->st_size := ASize;
  LStat->st_blksize := ADAM_HOOKIO_BLOCK_SIZE;
  LStat->st_blocks := (ASize + 511) div 512;
  LStat->st_atime := 0;
  LStat->st_atimensec := 0;
  LStat->st_mtime := 0;
  LStat->st_mtimensec := 0;
  LStat->st_ctime := 0;
  LStat->st_ctimensec := 0;
  LStat->reserved[0] := 0;
  LStat->reserved[1] := 0;
  LStat->reserved[2] := 0;
end;

// The stat family on a virtual path: AResult 0 with ABuf filled as DoFillStat fills a regular
// file (writable as an "r+" open would be), or -1 with errno (missing ENOENT). False: not
// such a path
routine DoStat(const APath: ptr to const char; const ABuf: ptr; var AResult: int32): bool;
var
  LQuery: HookQuery;
begin
  AResult := -1;
  if APath = nil then
    return false;
  end;
  if not HookIOQuery(StringFromC(APath), LQuery) then
    return false;
  end;
  if not LQuery.Found then
    return true;
  end;
  DoFillStat(ABuf, S_IFREG, LQuery.Size, LQuery.Writable);
  AResult := 0;
  return true;
end;

// --- closes, flushes, reopens --------------------------------------------------------------

// _IO_new_file_close_it on a handle under its stream lock: a stream putting bytes flushes them
// (a wide one's characters through its conversion), its own IO closed (a shared description's
// moved: DoMoveDescriptionLocked), every area freed; the flags a
// closed filebuf's. False when the flush or the close failed (the handle closes anyway)
routine DoCloseItLocked(const AHandle: ptr to HookHandle): bool;
var
  LIo: ptr to HookLibio;
  LOk: bool;
begin
  LIo := addr of AHandle->Io;
  LOk := true;
  if ((LIo->Flags & _IO_NO_WRITES) = 0u) and ((LIo->Flags & _IO_CURRENTLY_PUTTING) <> 0u) then
    if DoDoFlush(AHandle) <> 0 then
      LOk := false;
    end;
  end;
  // A description other numbers or FILEs still use lives on without this stream (the IO stays
  // open with it); an fdopen FILE has none of its own (Base.Stream nil)
  DoMoveDescriptionLocked(AHandle);
  if AHandle->Writable and (AHandle->Base.Stream <> nil) and (not IOFlush(AHandle->Base.Stream)) then
    LOk := false;
  end;
  AHandle->Closed := true;
  if AHandle->Base.Owned and (not IOClose(AHandle->Base.Stream)) then
    LOk := false;
  end;
  AHandle->Base.Stream := nil;
  setlength(AHandle->Replay, 0);
  AHandle->ReplayNext := 0;
  DoFreeModel(AHandle);
  LIo->Flags := _IO_MAGIC | _IO_IS_FILEBUF | _IO_NO_READS | _IO_NO_WRITES | _IO_TIED_PUT_GET;
  LIo->Offset := ADAM_HOOKIO_POS_BAD;
  DoMirror(AHandle);
  return LOk;
end;

// Closes AHandle's stream where it stands (fclose takes it out of the open list first, freopen
// keeps it there): DoCloseItLocked, an fdopen FILE's description given back, its entry use
// given back, a folder source of its own closed. False when a step failed
routine DoShutHandle(const AHandle: ptr to HookHandle): bool;
var
  LOk: bool;
  LDesc: ptr to HookHandle;
begin
  LOk := true;
  LDesc := nil;
  lock (AHandle->Base.Lock->Lock) do
    if not AHandle->Closed then
      LOk := DoCloseItLocked(AHandle);
    end;
    LDesc := AHandle->Desc;
    AHandle->Desc := nil;
  end;
  // An fdopen FILE's description: its number keeps it (DoDropDescriptor gives that up)
  if LDesc <> nil then
    DoReleaseHandle(LDesc);
  end;
  HookIOGiveBackEntry(addr of AHandle->Base, true);
  if not HookIOCloseOwnedSource(addr of AHandle->Base) then
    LOk := false;
  end;
  return LOk;
end;

// A hooked fclose (iofclose.c). False: not a HookIO handle, the caller passes it to the C
// runtime. True: closed; AResult 0, or EOF when the flush or closing its own IO failed (the
// handle closes anyway). The handle is freed when the last call holding it gives it back
routine DoClose(const AFile: ptr; var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
  LOk: bool;
  LGone: bool;
begin
  AResult := 0;
  LHandle := DoTakeHandle(AFile);
  if LHandle = nil then
    return false;
  end;
  // glibc's fclose of a FILE whose _fileno close(2) closed: its own close fails (EBADF)
  LGone := LHandle->DescriptorClosed;
  LOk := DoShutHandle(LHandle);
  DoDropDescriptor(LHandle);
  DoReleaseHandle(LHandle);
  if LGone then
    SetCErrno(ADAM_ERRNO_EBADF);
    LOk := false;
  end;
  if not LOk then
    AResult := ADAM_HOOKIO_EOF;
  end;
  return true;
end;

// The open handles, each with one more user (the caller gives them back): copied out under the
// registry lock
routine DoOpenHandles(): array of ptr to HookHandle;
var
  LOpen: array of ptr to HookHandle;
  LHandle: ptr to HookHandle;
  LI: int64;
begin
  lock (GLock) do
    setlength(LOpen, len(GHandles));
    for LI := 0 to len(GHandles) - 1 do
      LHandle := GHandles[LI];
      LHandle->Users := LHandle->Users + 1;
      LOpen[LI] := LHandle;
    end;
  end;
  return LOpen;
end;

// fflush(NULL)'s half for HookIO, glibc's _IO_flush_all: every open handle with bytes in its
// put area flushes them (its overflow with EOF), then its IO's own flush; 0, or EOF when any
// failed
routine DoFlushAll(): int32;
var
  LOpen: array of ptr to HookHandle;
  LHandle: ptr to HookHandle;
  LResult: int32;
  LI: int64;
begin
  LResult := 0;
  if atomicload(GOpenCount) = 0 then
    return LResult;
  end;
  LOpen := DoOpenHandles();
  for LI := 0 to len(LOpen) - 1 do
    LHandle := LOpen[LI];
    lock (LHandle->Base.Lock->Lock) do
      if not LHandle->Closed then
        // _IO_flush_all: a byte stream's put area, a wide one's wide put area (_IO_OVERFLOW)
        if LHandle->Io.Orientation > 0 then
          if LHandle->Wide.WritePtr > LHandle->Wide.WriteBase then
            if DoWfileOverflow(LHandle, int64(ADAM_HOOKIO_WEOF)) = int64(ADAM_HOOKIO_WEOF) then
              LResult := ADAM_HOOKIO_EOF;
            end;
          end;
        else
          if LHandle->Io.WritePtr > LHandle->Io.WriteBase then
            if DoFileOverflow(LHandle, ADAM_HOOKIO_EOF) = ADAM_HOOKIO_EOF then
              LResult := ADAM_HOOKIO_EOF;
            end;
          end;
        end;
        if DoFlushIOLocked(LHandle) <> 0 then
          LResult := ADAM_HOOKIO_EOF;
        end;
        DoMirror(LHandle);
      end;
    end;
    DoReleaseHandle(LHandle);
  end;
  return LResult;
end;

// glibc writes every stream's unflushed bytes at exit (_IO_cleanup's _IO_flush_all); an open
// handle's do the same, registered by the first open (DoAddHandle). The handle stays open
// (a later call on it still works on the model); nothing can report a failure at exit
routine DoExitFlush();
begin
  DoFlushAll();
end;

// Takes AFile out of the open list and gives the list's user back (a failed freopen leaves the
// stream closed, its descriptor with it); a call still holding the handle keeps it alive until
// it gives it back
routine DoForgetHandle(const AFile: ptr);
var
  LHandle: ptr to HookHandle;
begin
  LHandle := DoTakeHandle(AFile);
  if LHandle <> nil then
    DoDropDescriptor(LHandle);
    DoReleaseHandle(LHandle);
  end;
end;

// A freopen onto a path that is neither virtual nor a path source's: the file opens as an
// entry of a folder IOSource over its folder (CustomIO's file IOs take every fopen mode), and
// the source is handed back in ASource for the handle to own (HookIOCloseOwnedSource). The new
// handle, or nil with errno set (ENOENT when the folder does not exist) and ASource nil
routine DoOpenReal(const APath: string; const AMode: string; const ACallerErrno: int32;
  var ASource: IOSource): ptr;
var
  LEntry: HookEntry;
  LFolder: string;
  LName: string;
  LCut: int64;
  LResult: ptr;
  LError: int32;
begin
  ASource := nil;
  // The last separator; -1: a bare name, the current folder's as fopen's
  LCut := len(APath) - 1;
  while (LCut >= 0) and (not HookIOIsSeparator(APath[LCut])) do
    LCut := LCut - 1;
  end;
  if LCut < 0 then
    LFolder := ".";
    LName := APath;
  else
    // "/name" keeps the root as its folder
    LFolder := Substring(APath, 0, LCut);
    if len(LFolder) = 0 then
      LFolder := "/";
    end;
    LName := Substring(APath, LCut + 1, len(APath) - LCut - 1);
  end;
  HookIOEnterPathWork();
  ASource := CreateFolderIOSource(LFolder);
  if ASource = nil then
    HookIOLeavePathWork();
    SetCErrno(ADAM_ERRNO_ENOENT);
    return nil;
  end;
  LEntry.Id := 0;
  LEntry.Stream := nil;
  LEntry.Source := ASource;
  LEntry.Lock := nil;
  SetCErrno(ACallerErrno);
  LResult := DoOpenOn(true, LEntry, "/" + LName, APath, AMode, ACallerErrno);
  HookIOLeavePathWork();
  if LResult <> nil then
    return LResult;
  end;
  LError := CErrno();
  IOSourceClose(ASource);
  ASource := nil;
  SetCErrno(LError);
  return nil;
end;

// A hooked freopen (freopen.c). False: AFile is not a HookIO handle (a real FILE, or nil): the
// caller passes the call to the C runtime, whatever the path. True: answered; AResult is AFile,
// reopened in place, or nil (errno set) when the reopen failed. glibc's order: the stream
// synced (_IO_SYNC), closed, then APath (no path: the one the handle opened) opened in AMode,
// orientation reset; the stream keeps its address: the new handle's state moves into the
// record AFile names (its users stay) and the new handle is freed. A path that is neither
// virtual nor a path source's opens as an entry of a folder source over its folder
// (DoOpenReal). A failed open leaves the stream closed and out of the open list
routine DoReopen(const APath: ptr to const char; const AMode: ptr to const char;
  const AFile: ptr; var AResult: ptr): bool;
var
  LOld: ptr to HookHandle;
  LNew: ptr to HookHandle;
  LOldLock: ptr to HookStreamLock;
  LUsers: int64;
  LDescriptor: int32;
  LDescriptorOwned: bool;
  LPrevDesc: ptr to HookHandle;
  LOther: ptr to HookHandle;
  LAt: int64;
  LI: int64;
  LNewFile: ptr;
  LSource: IOSource;
  LCallerErrno: int32;
  LPath: string;
  LMode: string;
begin
  AResult := nil;
  LCallerErrno := CErrno();
  LOld := DoFindHandle(AFile);
  if LOld = nil then
    return false;
  end;
  LMode := DoCText(AMode);
  lock (LOld->Base.Lock->Lock) do
    if APath = nil then
      LPath := LOld->Path;
    else
      LPath := StringFromC(APath);
    end;
    if not LOld->Closed then
      DoSync(LOld);
    end;
  end;
  DoShutHandle(LOld);
  LNewFile := nil;
  LSource := nil;
  SetCErrno(LCallerErrno);
  if not DoOpenText(LPath, LMode, LNewFile) then
    SetCErrno(LCallerErrno);
    LNewFile := DoOpenReal(LPath, LMode, LCallerErrno, LSource);
  end;
  if LNewFile = nil then
    DoForgetHandle(AFile);
    DoReleaseHandle(LOld);
    return true;
  end;
  LNew := DoTakeHandle(LNewFile);
  if LNew = nil then
    DoForgetHandle(AFile);
    DoReleaseHandle(LOld);
    if LSource <> nil then
      IOSourceClose(LSource);
    end;
    SetCErrno(ADAM_ERRNO_EBADF);
    return true;
  end;
  // The new state at the old address (a fresh open holds no area that points into its own
  // record): the old record keeps its users and its descriptor (glibc's freopen gives the new
  // file the old number; a close(2) of it undone, the file being open again); its closed
  // stream's lock is given back and the new one's taken over, so the freed new record gives no
  // lock back
  lock (GLock) do
    LUsers := LOld->Users;
    LOldLock := LOld->Base.Lock;
    LDescriptor := LOld->Descriptor;
    LDescriptorOwned := LOld->DescriptorOwned;
    LOld^ := LNew^;
    LOld->Users := LUsers;
    LOld->Descriptor := LDescriptor;
    LOld->DescriptorOwned := LDescriptorOwned;
    LOld->DescriptorClosed := false;
    LOld->Head._fileno := LDescriptor;
    LNew->Base.Lock := nil;
    LNew->Wide.ToWide := nil;
    LNew->Wide.ToBytes := nil;
    // The number names the reopened file (freopen's close and open of it), open again; a FILE
    // fdopen made on it takes the new stream lock (the old one is LOldLock, still held)
    LPrevDesc := nil;
    if LDescriptor >= 0 then
      LAt := DoNumberAtLocked(LDescriptor);
      if LAt >= 0 then
        GDescriptors[LAt].Closed := false;
        if GDescriptors[LAt].Handle <> LOld then
          LPrevDesc := GDescriptors[LAt].Handle;
          GDescriptors[LAt].Handle := LOld;
          LOld->Users := LOld->Users + 1;
        end;
      end;
    end;
    for LI := 0 to len(GHandles) - 1 do
      LOther := GHandles[LI];
      if (LOther->Desc = LOld) and (LOther->Base.Lock <> LOld->Base.Lock) then
        LOther->Base.Lock->Users := LOther->Base.Lock->Users - 1;
        LOther->Base.Lock := LOld->Base.Lock;
        LOld->Base.Lock->Users := LOld->Base.Lock->Users + 1;
      end;
    end;
  end;
  if LPrevDesc <> nil then
    DoGiveUpNumber(LPrevDesc);
  end;
  LOld->Base.OwnedSource := LSource;
  // glibc: result->_mode = 0 (a ccs= reopen is wide again by its open)
  if len(LOld->Wide.Charset) = 0 then
    LOld->Io.Orientation := 0;
  end;
  DoMirror(LOld);
  HookIOReleaseLock(LOldLock);
  DoFreeHandle(LNew);
  DoReleaseHandle(LOld);
  AResult := AFile;
  return true;
end;

// The IO behind a handle a hooked open returned: the registered IO, or the entry's IO for a
// source; nil for a C runtime FILE or nil (System.HookIO's FileIO)
public routine HookIOStreamOf(const AFile: ptr): IO;
var
  LHandle: ptr to HookHandle;
  LStream: IO;
begin
  LHandle := DoFindHandle(AFile);
  if LHandle = nil then
    return nil;
  end;
  lock (LHandle->Base.Lock->Lock) do
    LStream := DoDescOf(LHandle)->Base.Stream;
  end;
  DoReleaseHandle(LHandle);
  return LStream;
end;

// --- descriptor calls on a handle ------------------------------------------------------------
// A handle's descriptor (fileno's, the one a hooked open(2) of a virtual path made, or a dup of
// either) is a number on the handle's description in the libio model (Base.Position its
// place, DoDescRead / DoDescWrite / DoDescSeek / DoSysSize its system calls), so a C library
// mixing fileno and fread on one FILE, reading a virtual file through open / fstat / read /
// lseek / mmap / close, or dup / fdopen of such a descriptor, sees what glibc gives on a real
// file of the same bytes

// read(2)'s count as the model takes it (ssize_t: at most SSIZE_MAX, as the kernel clamps)
routine DoFdCount(const ACount: uint64): int64;
begin
  if ACount > uint64(ADAM_HOOKIO_SSIZE_MAX) then
    return ADAM_HOOKIO_SSIZE_MAX;
  end;
  return int64(ACount);
end;

// pread / pwrite / mmap's place: AHandle's descriptor moved to AOffset, its place before that
// in AKeep (the caller puts it back: these calls leave the place where it was). False with
// errno: a pipe ESPIPE, a negative offset EINVAL, a target the IO refuses (DoDescSeek's)
routine DoFdPlace(const AHandle: ptr to HookHandle; const AOffset: int64; var AKeep: int64): bool;
begin
  AKeep := AHandle->Base.Position;
  if AHandle->Pipe then
    SetCErrno(ESPIPE);
    return false;
  end;
  if AOffset < 0 then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return false;
  end;
  return DoDescSeek(AHandle, AOffset, _IO_seek_set) >= 0;
end;

// True when AOffset is at or past the end of AHandle's IO (a pread / mmap there reads nothing:
// the kernel's answer, where the IO refuses the seek)
routine DoFdPastEnd(const AHandle: ptr to HookHandle; const AOffset: int64): bool;
var
  LSize: int64;
begin
  if AHandle->Pipe or (AOffset < 0) then
    return false;
  end;
  if not DoSysSize(AHandle, LSize) then
    return false;
  end;
  return AOffset >= LSize;
end;

// True (EBADF set) when a number on description AHandle can take no call: the description
// closed, or close(2) ran on the number (AClosed). The caller holds the stream lock
routine DoFdGone(const AHandle: ptr to HookHandle; const AClosed: bool): bool;
begin
  if AHandle->Closed or AClosed then
    SetCErrno(ADAM_ERRNO_EBADF);
    return true;
  end;
  return false;
end;

// read(2) (APositioned false) or pread(2) at AOffset (the place kept) on a number on
// description AHandle (AClosed: close(2) ran on it): the count, 0 at the end, or -1 with
// errno (DoDescRead's, DoFdPlace's, EBADF)
routine DoFdRead(const AHandle: ptr to HookHandle; const AClosed: bool; const ABuffer: ptr;
  const ACount: uint64; const APositioned: bool; const AOffset: int64): int64;
var
  LKeep: int64;
  LGot: int64;
  LError: int32;
begin
  LGot := -1;
  lock (AHandle->Base.Lock->Lock) do
    if not DoFdGone(AHandle, AClosed) then
      if not APositioned then
        LGot := DoDescRead(AHandle, uint64(ABuffer), DoFdCount(ACount));
      else
        LError := CErrno();
        if DoFdPlace(AHandle, AOffset, LKeep) then
          LGot := DoDescRead(AHandle, uint64(ABuffer), DoFdCount(ACount));
          AHandle->Base.Position := LKeep;
        else
          if DoFdPastEnd(AHandle, AOffset) then
            SetCErrno(LError);
            LGot := 0;
          end;
        end;
      end;
    end;
  end;
  return LGot;
end;

// write(2) (APositioned false) or pwrite(2) at AOffset (the place kept) on a number on
// description AHandle (AClosed as DoFdRead's): the count, or -1 with errno (DoDescWrite's,
// DoFdPlace's, EBADF)
routine DoFdWrite(const AHandle: ptr to HookHandle; const AClosed: bool;
  const ABuffer: ptr to const; const ACount: uint64; const APositioned: bool;
  const AOffset: int64): int64;
var
  LKeep: int64;
  LGot: int64;
begin
  LGot := -1;
  lock (AHandle->Base.Lock->Lock) do
    if not DoFdGone(AHandle, AClosed) then
      if not APositioned then
        LGot := DoDescWrite(AHandle, uint64(ABuffer), DoFdCount(ACount));
      else
        if DoFdPlace(AHandle, AOffset, LKeep) then
          LGot := DoDescWrite(AHandle, uint64(ABuffer), DoFdCount(ACount));
          AHandle->Base.Position := LKeep;
        end;
      end;
    end;
  end;
  return LGot;
end;

// lseek(2) on a number on description AHandle (AClosed as DoFdRead's): DoDescSeek; a
// direction past SEEK_END (SEEK_DATA / SEEK_HOLE: a virtual file has no holes to ask about)
// EINVAL, as is any unknown one
routine DoFdSeek(const AHandle: ptr to HookHandle; const AClosed: bool; const AOffset: int64;
  const AWhence: int32): int64;
var
  LGot: int64;
begin
  LGot := -1;
  lock (AHandle->Base.Lock->Lock) do
    if not DoFdGone(AHandle, AClosed) then
      if (AWhence < _IO_seek_set) or (AWhence > _IO_seek_end) then
        SetCErrno(ADAM_ERRNO_EINVAL);
      else
        LGot := DoDescSeek(AHandle, AOffset, AWhence);
      end;
    end;
  end;
  return LGot;
end;

// fstat(2) of descriptor AFile when it is a handle's: AResult 0 with ABuf filled (DoFillStat:
// a regular file of the IO's size, a FIFO of size 0 for an IO that cannot seek or tell its
// size; writable when the handle or its IO writes), or -1 with EBADF. False: not a handle's
routine DoFdStat(const AFile: int32; const ABuf: ptr; var AResult: int32): bool;
var
  LHandle: ptr to HookHandle;
  LClosed: bool;
  LSize: int64;
  LType: uint32;
begin
  AResult := -1;
  LHandle := DoFindDescriptor(AFile, LClosed);
  if LHandle = nil then
    return false;
  end;
  lock (LHandle->Base.Lock->Lock) do
    if not DoFdGone(LHandle, LClosed) then
      LType := S_IFREG;
      if LHandle->Pipe then
        LType := S_IFIFO;
      end;
      if LHandle->Pipe or (not DoSysSize(LHandle, LSize)) then
        LSize := 0;
      end;
      DoFillStat(ABuf, LType, LSize, LHandle->Writable or IOCanWrite(LHandle->Base.Stream));
      AResult := 0;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// mmap(2) of descriptor AFile when it is a handle's: a private anonymous mapping of ALength
// bytes (at AAddress as the caller's flags ask) holding the IO's bytes from AOffset (past the
// IO's end zeros, as a real file's last page), then given the rights AProt asks. glibc's mmap
// makes the mapping, so its address, MAP_FIXED and the rest are the kernel's. AResult the
// mapping, or MAP_FAILED with errno: a closed descriptor EBADF; no length, a negative or
// unaligned offset EINVAL; an IO that cannot seek ENODEV (a pipe cannot be mapped); a
// descriptor without read rights EACCES; a shared writable mapping EACCES without write
// rights, else ENODEV (a virtual file has no pages a write could reach the IO through).
// False: not a handle's
routine DoFdMap(const AAddress: ptr; const ALength: uint64; const AProt: int32;
  const AFlags: int32; const AFile: int32; const AOffset: int64; var AResult: ptr): bool;
var
  LHandle: ptr to HookHandle;
  LFound: ptr;
  LMap: MmapFn;
  LPages: ptr;
  LAt: uint64;
  LGot: int64;
  LKeep: int64;
  LError: int32;
  LFail: int32;
  LClosed: bool;
begin
  AResult := ptr(ADAM_HOOKIO_MAP_FAILED);
  LHandle := DoFindDescriptor(AFile, LClosed);
  if LHandle = nil then
    return false;
  end;
  LError := CErrno();
  lock (LHandle->Base.Lock->Lock) do
    LFail := 0;
    if LHandle->Closed or LClosed then
      LFail := ADAM_ERRNO_EBADF;
    end;
    if (LFail = 0) and ((ALength = 0u) or (AOffset < 0) or
      ((AOffset mod ADAM_HOOKIO_PAGE_SIZE) <> 0)) then
      LFail := ADAM_ERRNO_EINVAL;
    end;
    if (LFail = 0) and LHandle->Pipe then
      LFail := ENODEV;
    end;
    if (LFail = 0) and (not LHandle->Readable) then
      LFail := ADAM_ERRNO_EACCES;
    end;
    if (LFail = 0) and ((AFlags & MAP_SHARED) <> 0) and ((AProt & PROT_WRITE) <> 0) then
      if LHandle->Writable then
        LFail := ENODEV;
      else
        LFail := ADAM_ERRNO_EACCES;
      end;
    end;
    if LFail <> 0 then
      SetCErrno(LFail);
    else
      LFound := DoReal(GRealMmap, ptr to const char("mmap"));
      if LFound <> nil then
        LMap := MmapFn(LFound);
        // Written while it is filled, its sharing private and anonymous whatever was asked
        LPages := LMap(AAddress, ALength, AProt | PROT_WRITE,
          (AFlags & (~(MAP_SHARED | MAP_PRIVATE))) | MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
        if uint64(LPages) <> ADAM_HOOKIO_MAP_FAILED then
          // The bytes from AOffset (an offset the IO cannot reach is past its end: zeros)
          if DoFdPlace(LHandle, AOffset, LKeep) then
            LAt := 0u;
            while LAt < ALength do
              LGot := DoDescRead(LHandle, uint64(LPages) + LAt, DoFdCount(ALength - LAt));
              if LGot <= 0 then
                leave;
              end;
              LAt := LAt + uint64(LGot);
            end;
          end;
          LHandle->Base.Position := LKeep;
          if (AProt & PROT_WRITE) = 0 then
            mprotect(LPages, ALength, AProt);
          end;
          SetCErrno(LError);
          AResult := LPages;
        end;
      end;
    end;
  end;
  DoReleaseHandle(LHandle);
  return true;
end;

// close(2) of number AFile when it is a handle's. False: not a handle's. True: AResult 0, or
// -1 with errno: closed already EBADF; the description's last number closing it (an open(2)
// or one an fclose left) with a failed flush or close EIO. A number an open FILE holds as its
// _fileno stays reserved, closed (its calls and the FILE's system calls EBADF, as glibc's on
// a closed _fileno) until that fclose; any other is given back (DoGiveUpNumber)
routine DoFdClose(const AFile: int32; var AResult: int32): bool;
var
  LDesc: ptr to HookHandle;
  LAt: int64;
  LFound: bool;
begin
  AResult := -1;
  if (AFile < 0) or (atomicload(GDescriptorCount) = 0) then
    return false;
  end;
  LFound := false;
  LDesc := nil;
  lock (GLock) do
    LAt := DoNumberAtLocked(AFile);
    if LAt >= 0 then
      LFound := true;
      if GDescriptors[LAt].Closed then
        SetCErrno(ADAM_ERRNO_EBADF);
      else
        if DoHoldersLocked(AFile, true) then
          GDescriptors[LAt].Closed := true;
          AResult := 0;
        else
          LDesc := DoUnlistLocked(LAt);
          if LDesc->Descriptor = AFile then
            LDesc->Descriptor := -1;
            LDesc->Head._fileno := -1;
          end;
        end;
      end;
    end;
  end;
  if LDesc <> nil then
    DoCloseReal(AFile);
    AResult := DoGiveUpNumber(LDesc);
  end;
  return LFound;
end;

// AHandle's rights made the descriptor's (the caller holds its stream lock): read with
// O_RDONLY or O_RDWR, write with O_WRONLY or O_RDWR (the libio flags in step), and O_APPEND's
// writes at the IO's end
routine DoFdRights(const AHandle: ptr to HookHandle; const AAccess: int32; const AAppend: bool);
begin
  AHandle->Readable := AAccess <> O_WRONLY;
  AHandle->Writable := AAccess <> O_RDONLY;
  AHandle->Io.Flags := AHandle->Io.Flags & (~(_IO_NO_READS | _IO_NO_WRITES));
  if not AHandle->Readable then
    AHandle->Io.Flags := AHandle->Io.Flags | _IO_NO_READS;
  end;
  if not AHandle->Writable then
    AHandle->Io.Flags := AHandle->Io.Flags | _IO_NO_WRITES;
  end;
  if AAppend then
    AHandle->Appending := true;
    AHandle->Io.Flags := AHandle->Io.Flags | _IO_IS_APPENDING;
  end;
  DoMirror(AHandle);
end;

// A hooked open(2) of APath with AFlags. False: not a virtual path nor one the path source
// holds (HookIOQuery), the caller passes it to glibc with errno as it came. True: AResult the
// new descriptor (a handle opened as fopen opens the path, DescriptorOwned), or -1 with errno.
// The open's rules are the kernel's on a regular file: O_ACCMODE 3 EINVAL; O_DIRECTORY
// ENOTDIR; missing without O_CREAT ENOENT; O_CREAT | O_EXCL on one that exists EEXIST; O_CREAT
// makes a missing one and O_TRUNC empties one with write rights ("w+"), anything else keeps
// the bytes ("r", "r+": a read-only open never asks for write rights); then the rights are
// O_ACCMODE's and O_APPEND's. The handle's own refusals are fopen's (EACCES: a mode the IO
// or source does not offer). Other flags (O_CLOEXEC, O_NONBLOCK, O_NOFOLLOW ..) change nothing
// on a virtual file; its descriptor is closed on exec always (ADAM_HOOKIO_RESERVE_PATH)
routine DoFdOpen(const APath: ptr to const char; const AFlags: int32; var AResult: int32): bool;
var
  LPath: string;
  LQuery: HookQuery;
  LAccess: int32;
  LMode: string;
  LFile: ptr;
  LHandle: ptr to HookHandle;
  LError: int32;
  LCallerErrno: int32;
  LClosed: int32;
begin
  AResult := -1;
  if APath = nil then
    return false;
  end;
  LCallerErrno := CErrno();
  LPath := StringFromC(APath);
  if not HookIOQuery(LPath, LQuery) then
    return false;
  end;
  LAccess := AFlags & O_ACCMODE;
  if LAccess = O_ACCMODE then
    SetCErrno(ADAM_ERRNO_EINVAL);
    return true;
  end;
  if (AFlags & O_DIRECTORY) <> 0 then
    if LQuery.Found then
      SetCErrno(ENOTDIR);
    end;
    return true;
  end;
  if LQuery.Found then
    if ((AFlags & O_CREAT) <> 0) and ((AFlags & O_EXCL) <> 0) then
      SetCErrno(ADAM_ERRNO_EEXIST);
      return true;
    end;
  else
    // HookIOQuery set ENOENT
    if (AFlags & O_CREAT) = 0 then
      return true;
    end;
  end;
  if (not LQuery.Found) or (((AFlags & O_TRUNC) <> 0) and (LAccess <> O_RDONLY)) then
    LMode := "w+";
  else
    if LAccess = O_RDONLY then
      LMode := "r";
    else
      LMode := "r+";
    end;
  end;
  SetCErrno(LCallerErrno);
  LFile := nil;
  if not DoOpenText(LPath, LMode, LFile) then
    SetCErrno(ADAM_ERRNO_ENOENT);
    return true;
  end;
  if LFile = nil then
    return true;
  end;
  LHandle := DoFindHandle(LFile);
  if LHandle = nil then
    SetCErrno(ADAM_ERRNO_EBADF);
    return true;
  end;
  lock (LHandle->Base.Lock->Lock) do
    DoFdRights(LHandle, LAccess, (AFlags & O_APPEND) <> 0);
    AResult := DoDescriptorLocked(LHandle);
    if AResult >= 0 then
      LHandle->DescriptorOwned := true;
    end;
  end;
  DoReleaseHandle(LHandle);
  if AResult < 0 then
    LError := CErrno();
    DoClose(LFile, LClosed);
    SetCErrno(LError);
    return true;
  end;
  SetCErrno(LCallerErrno);
  return true;
end;

// dup(2) / fcntl(F_DUPFD, F_DUPFD_CLOEXEC) of number AFile when it is a handle's: another
// number on its description, the lowest free one at or above AMin (DoReserveCopy). False: not
// a handle's. True: AResult the number, or -1 with errno: closed EBADF, glibc's (EINVAL,
// EMFILE ..)
routine DoFdCopy(const AFile: int32; const AMin: int32; var AResult: int32): bool;
var
  LDesc: ptr to HookHandle;
  LClosed: bool;
  LNew: int32;
begin
  AResult := -1;
  LDesc := DoFindDescriptor(AFile, LClosed);
  if LDesc = nil then
    return false;
  end;
  if LClosed or LDesc->Closed then
    SetCErrno(ADAM_ERRNO_EBADF);
  else
    LNew := DoReserveCopy(AFile, AMin);
    if LNew >= 0 then
      lock (GLock) do
        DoListNumberLocked(LNew, LDesc);
      end;
      AResult := LNew;
    end;
  end;
  DoReleaseHandle(LDesc);
  return true;
end;

// Number ATarget's entry taken out for a dup2 / dup3 onto it (the kernel's copy has replaced its
// reservation, so nothing is closed): its description, the entry's user now the caller's, or
// nil when it is no handle's. A handle holding it as its _fileno holds no descriptor any more:
// a FILE of a user's answers EBADF to its system calls, fileno and fclose (the caller holds
// GLock)
routine DoTakeNumberLocked(const ATarget: int32): ptr to HookHandle;
var
  LHandle: ptr to HookHandle;
  LAt: int64;
  LI: int64;
begin
  LAt := DoNumberAtLocked(ATarget);
  if LAt < 0 then
    return nil;
  end;
  for LI := 0 to len(GHandles) - 1 do
    LHandle := GHandles[LI];
    if LHandle->Descriptor = ATarget then
      LHandle->Descriptor := -1;
      LHandle->Head._fileno := -1;
      if not LHandle->DescriptorOwned then
        LHandle->DescriptorClosed := true;
      end;
    end;
  end;
  return DoUnlistLocked(LAt);
end;

// The real dup2 (AThree false) or dup3 with AFlags of AFile onto ATarget: ATarget, or -1 with
// glibc's errno
routine DoRealCopyTo(const AFile: int32; const ATarget: int32; const AThree: bool;
  const AFlags: int32): int32;
var
  LFound: ptr;
  LDup2: Dup2Fn;
  LDup3: Dup3Fn;
begin
  if AThree then
    LFound := DoReal(GRealDup3, ptr to const char("dup3"));
    if LFound = nil then
      return -1;
    end;
    LDup3 := Dup3Fn(LFound);
    return LDup3(AFile, ATarget, AFlags);
  end;
  LFound := DoReal(GRealDup2, ptr to const char("dup2"));
  if LFound = nil then
    return -1;
  end;
  LDup2 := Dup2Fn(LFound);
  return LDup2(AFile, ATarget);
end;

// dup2(2) (AThree false) or dup3(2) with AFlags of AFile onto ATarget when either is a
// handle's. False: neither is (glibc's). True: AResult ATarget, or -1 with errno: AFile a
// closed number EBADF; dup3 onto itself or with a flag other than O_CLOEXEC EINVAL (dup2 onto
// itself: ATarget, nothing done); glibc's. The kernel's copy replaces ATarget (a handle's
// number there taken out: DoTakeNumberLocked, its description given up); a copy of a handle's
// number is a reservation (closed on exec, as every one) listed on its description, a copy of
// any other is glibc's own
routine DoFdCopyTo(const AFile: int32; const ATarget: int32; const AThree: bool;
  const AFlags: int32; var AResult: int32): bool;
var
  LDesc: ptr to HookHandle;
  LOld: ptr to HookHandle;
  LClosed: bool;
  LListed: bool;
  LGot: int32;
begin
  AResult := -1;
  LDesc := DoFindDescriptor(AFile, LClosed);
  LListed := false;
  if (LDesc = nil) and (ATarget >= 0) and (atomicload(GDescriptorCount) > 0) then
    lock (GLock) do
      LListed := DoNumberAtLocked(ATarget) >= 0;
    end;
  end;
  if (LDesc = nil) and (not LListed) then
    return false;
  end;
  if (LDesc <> nil) and (LClosed or LDesc->Closed) then
    SetCErrno(ADAM_ERRNO_EBADF);
    DoReleaseHandle(LDesc);
    return true;
  end;
  if AThree and ((AFile = ATarget) or ((AFlags & (~O_CLOEXEC)) <> 0)) then
    SetCErrno(ADAM_ERRNO_EINVAL);
    if LDesc <> nil then
      DoReleaseHandle(LDesc);
    end;
    return true;
  end;
  if AFile = ATarget then
    // dup2 onto itself (AFile a handle's: AFile = ATarget means LDesc is set)
    AResult := ATarget;
    DoReleaseHandle(LDesc);
    return true;
  end;
  if LDesc <> nil then
    LGot := DoRealCopyTo(AFile, ATarget, true, O_CLOEXEC);
  else
    LGot := DoRealCopyTo(AFile, ATarget, AThree, AFlags);
  end;
  if LGot >= 0 then
    lock (GLock) do
      LOld := DoTakeNumberLocked(ATarget);
      if LDesc <> nil then
        DoListNumberLocked(ATarget, LDesc);
      end;
    end;
    if LOld <> nil then
      DoGiveUpNumber(LOld);
    end;
    AResult := ATarget;
  end;
  if LDesc <> nil then
    DoReleaseHandle(LDesc);
  end;
  return true;
end;

// fcntl's F_GETFL of description AHandle: its access mode (O_RDONLY, O_WRONLY, O_RDWR) and
// O_APPEND (the caller holds its stream lock)
routine DoFdStatusFlags(const AHandle: ptr to HookHandle): int32;
var
  LFlags: int32;
begin
  LFlags := O_RDONLY;
  if AHandle->Readable and AHandle->Writable then
    LFlags := O_RDWR;
  else
    if AHandle->Writable then
      LFlags := O_WRONLY;
    end;
  end;
  if AHandle->Appending then
    LFlags := LFlags | O_APPEND;
  end;
  return LFlags;
end;

// fcntl(2) / fcntl64 of number AFile with ACommand and its argument AArg when AFile is a
// handle's. False: not a handle's, or an open number given a command glibc runs on its
// reservation (F_GETFD, F_SETFD, locks ..). True: AResult as the kernel answers: F_DUPFD /
// F_DUPFD_CLOEXEC another number at or above AArg (DoFdCopy's); F_GETFL the description's
// flags (DoFdStatusFlags); F_SETFL 0, its O_APPEND as AArg says (the other status flags change
// nothing on a virtual file); -1 with EBADF on a closed number, whatever the command
routine DoFdControl(const AFile: int32; const ACommand: int32; const AArg: uint64;
  var AResult: int32): bool;
var
  LDesc: ptr to HookHandle;
  LClosed: bool;
  LOurs: bool;
begin
  AResult := -1;
  LDesc := DoFindDescriptor(AFile, LClosed);
  if LDesc = nil then
    return false;
  end;
  LOurs := (ACommand = F_DUPFD) or (ACommand = F_DUPFD_CLOEXEC) or (ACommand = F_GETFL) or
    (ACommand = F_SETFL);
  if LClosed or LDesc->Closed then
    SetCErrno(ADAM_ERRNO_EBADF);
    DoReleaseHandle(LDesc);
    return true;
  end;
  if not LOurs then
    DoReleaseHandle(LDesc);
    return false;
  end;
  if (ACommand = F_DUPFD) or (ACommand = F_DUPFD_CLOEXEC) then
    DoReleaseHandle(LDesc);
    return DoFdCopy(AFile, int32(int64(AArg)), AResult);
  end;
  lock (LDesc->Base.Lock->Lock) do
    if ACommand = F_GETFL then
      AResult := DoFdStatusFlags(LDesc);
    else
      LDesc->Appending := (int32(int64(AArg)) & O_APPEND) <> 0;
      AResult := 0;
    end;
  end;
  DoReleaseHandle(LDesc);
  return true;
end;

// fdopen(3) of number AFile in AMode when AFile is a handle's (iofdopen.c). False: not a
// handle's (glibc's). True: AResult a new FILE whose system calls run on AFile's description
// (Desc; its stream lock shared, AFile its _fileno, given back at its fclose), or nil with
// errno: a closed number EBADF; a bad mode, or one asking for a right the description lacks,
// EINVAL; a charset iconv lacks EINVAL; no memory ENOMEM. "a" sets the description's
// O_APPEND, and a write-only "a" moves its place to the end (an IO that cannot seek stays)
routine DoFdStream(const AFile: int32; const AMode: ptr to const char; var AResult: ptr): bool;
var
  LDesc: ptr to HookHandle;
  LHandle: ptr to HookHandle;
  LParsed: HookOpenMode;
  LExtra: HookModeExtra;
  LClosed: bool;
  LReads: bool;
  LWrites: bool;
  LFail: int32;
  LCallerErrno: int32;
begin
  AResult := nil;
  LDesc := DoFindDescriptor(AFile, LClosed);
  if LDesc = nil then
    return false;
  end;
  LCallerErrno := CErrno();
  LFail := 0;
  if LClosed or LDesc->Closed then
    LFail := ADAM_ERRNO_EBADF;
  end;
  if (LFail = 0) and (not DoParseMode(DoCText(AMode), LParsed, LExtra)) then
    LFail := ADAM_ERRNO_EINVAL;
  end;
  if LFail = 0 then
    LReads := (LParsed.First = 'r') or LParsed.Plus;
    LWrites := (LParsed.First <> 'r') or LParsed.Plus;
    lock (LDesc->Base.Lock->Lock) do
      if (LReads and (not LDesc->Readable)) or (LWrites and (not LDesc->Writable)) then
        LFail := ADAM_ERRNO_EINVAL;
      else
        if LParsed.First = 'a' then
          LDesc->Appending := true;
          if (not LReads) and (DoDescSeek(LDesc, 0, _IO_seek_end) < 0) and
            (CErrno() <> ESPIPE) then
            LFail := CErrno();
          end;
        end;
      end;
    end;
  end;
  if LFail = 0 then
    create(LHandle);
    if LHandle = nil then
      LFail := ADAM_ERRNO_ENOMEM;
    end;
  end;
  if LFail <> 0 then
    DoReleaseHandle(LDesc);
    SetCErrno(LFail);
    return true;
  end;
  // DoOpenOn's FILE, on AFile's description: the lookup's user of it is the FILE's (Desc)
  LHandle->Users := 1;
  LHandle->Readable := LReads;
  LHandle->Writable := LWrites;
  LHandle->Appending := LParsed.First = 'a';
  LHandle->Io.Flags := _IO_MAGIC | _IO_IS_FILEBUF | _IO_TIED_PUT_GET | _IO_LINKED;
  if not LReads then
    LHandle->Io.Flags := LHandle->Io.Flags | _IO_NO_READS;
  end;
  if not LWrites then
    LHandle->Io.Flags := LHandle->Io.Flags | _IO_NO_WRITES;
  end;
  if LHandle->Appending then
    LHandle->Io.Flags := LHandle->Io.Flags | _IO_IS_APPENDING;
  end;
  LHandle->Io.Offset := ADAM_HOOKIO_POS_BAD;
  LHandle->Io.Orientation := 0;
  LHandle->Head._fileno := AFile;
  LHandle->Descriptor := AFile;
  LHandle->DescriptorOwned := false;
  LHandle->DescriptorClosed := false;
  LHandle->Wide.Charset := LExtra.Charset;
  LHandle->Desc := LDesc;
  lock (GLock) do
    LHandle->Base.Lock := LDesc->Base.Lock;
    LHandle->Base.Lock->Users := LHandle->Base.Lock->Users + 1;
  end;
  if len(LExtra.Charset) > 0 then
    if not DoOpenConversion(LHandle) then
      DoFreeHandle(LHandle);
      SetCErrno(ADAM_ERRNO_EINVAL);
      return true;
    end;
    LHandle->Io.Orientation := 1;
  end;
  DoMirror(LHandle);
  DoAddHandle(LHandle);
  SetCErrno(LCallerErrno);
  AResult := ptr(LHandle);
  return true;
end;

// --- the hooks' shapes --------------------------------------------------------------------

// A hooked C function of int (FILE*) form: AOp on a handle, anything else to the real function
// AName (ASlot its slot; AFail with ENOSYS when the C runtime has none)
routine DoFileInt(const AOp: HookOp; const AFail: int32; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FileIntFn;
begin
  LCall := DoCall(AOp, AFail);
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return AFail;
  end;
  LReal := FileIntFn(LFound);
  return LReal(AFile);
end;

// A hooked C function of size_t (FILE*) form (__fpending, __fbufsize): as DoFileInt
routine DoFileSize(const AOp: HookOp; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): uint64;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FileSizeFn;
begin
  LCall := DoCall(AOp, 0);
  if DoWith(AFile, LCall) then
    return uint64(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return 0u;
  end;
  LReal := FileSizeFn(LFound);
  return LReal(AFile);
end;

// A hooked C function of void (FILE*) form: AOp on a handle, anything else to AName
routine DoFileVoid(const AOp: HookOp; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char);
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FileVoidFn;
begin
  LCall := DoCall(AOp, 0);
  if DoWith(AFile, LCall) then
    return;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return;
  end;
  LReal := FileVoidFn(LFound);
  LReal(AFile);
end;

// A hooked C function of int (int, FILE*) form: AOp with AChar on a handle (EOF when it
// fails), anything else to AName
routine DoCharFile(const AOp: HookOp; const AChar: int32; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: CharFileFn;
begin
  LCall := DoCall(AOp, ADAM_HOOKIO_EOF);
  LCall.Value := AChar;
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := CharFileFn(LFound);
  return LReal(AChar, AFile);
end;

// A hooked C function of wint_t (FILE*) form: AOp on a handle (WEOF when it fails), anything
// else to AName
routine DoWideFile(const AOp: HookOp; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): uint32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: WideFileFn;
begin
  LCall := DoCall(AOp, int64(ADAM_HOOKIO_WEOF));
  if DoWith(AFile, LCall) then
    return uint32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return uint32(ADAM_HOOKIO_WEOF);
  end;
  LReal := WideFileFn(LFound);
  return LReal(AFile);
end;

// A hooked C function of wint_t (wchar_t, FILE*) form: AOp with AChar on a handle (WEOF when it
// fails), anything else to AName
routine DoWideCharFile(const AOp: HookOp; const AChar: uint32; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): uint32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: WideCharFn;
begin
  LCall := DoCall(AOp, int64(ADAM_HOOKIO_WEOF));
  LCall.Value := int32(AChar);
  if DoWith(AFile, LCall) then
    return uint32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return uint32(ADAM_HOOKIO_WEOF);
  end;
  LReal := WideCharFn(LFound);
  return LReal(AChar, AFile);
end;

// A hooked fread / fwrite form (AOp Read / Write) of ACount items of ASize bytes at ABuffer,
// the product wrapped as glibc's size_t is: a handle moves them, anything else goes to AName
routine DoTransfer(const AOp: HookOp; const ABuffer: ptr; const ASize: uint64; const ACount: uint64;
  const AFile: ptr; var ASlot: ptr; const AName: ptr to const char): uint64;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: TransferFn;
begin
  LCall := DoCall(AOp, 0);
  LCall.Buffer := ptr to uint8(ABuffer);
  LCall.ItemSize := int64(ASize);
  LCall.Size := int64(ASize * ACount);
  LCall.Offset := int64(ACount);
  if DoWith(AFile, LCall) then
    return uint64(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return 0u;
  end;
  LReal := TransferFn(LFound);
  return LReal(ABuffer, ASize, ACount, AFile);
end;

// A hooked fgets form: up to ACount - 1 bytes into AText on a handle, anything else to AName
routine DoGets(const AText: ptr to char; const ACount: int32; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): ptr to char;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FgetsFn;
begin
  LCall := DoCall(HookOp.Gets, 0);
  LCall.Buffer := ptr to uint8(AText);
  LCall.Size := int64(ACount);
  if DoWith(AFile, LCall) then
    if LCall.Answer = 0 then
      return nil;
    end;
    return AText;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return nil;
  end;
  LReal := FgetsFn(LFound);
  return LReal(AText, ACount, AFile);
end;

// A hooked fgetws form: up to ACount - 1 characters into AText on a handle, anything else to
// AName
routine DoGetsWide(const AText: ptr to uint32; const ACount: int32; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): ptr to uint32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FgetwsFn;
begin
  LCall := DoCall(HookOp.GetsWide, 0);
  LCall.Wide := AText;
  LCall.Size := int64(ACount);
  if DoWith(AFile, LCall) then
    if LCall.Answer = 0 then
      return nil;
    end;
    return AText;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return nil;
  end;
  LReal := FgetwsFn(LFound);
  return LReal(AText, ACount, AFile);
end;

// A hooked fputs form: AText's bytes on a handle, anything else to AName
routine DoPuts(const AText: ptr to const char; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FputsFn;
begin
  LCall := DoCall(HookOp.Puts, ADAM_HOOKIO_EOF);
  LCall.Buffer := ptr to uint8(uint64(AText));
  LCall.Size := CTextLength(AText);
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := FputsFn(LFound);
  return LReal(AText, AFile);
end;

// A hooked fputws form: AText's characters on a handle, anything else to AName
routine DoPutsWide(const AText: ptr to const uint32; const AFile: ptr; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FputwsFn;
begin
  LCall := DoCall(HookOp.PutsWide, -1);
  LCall.Wide := ptr to uint32(uint64(AText));
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := FputwsFn(LFound);
  return LReal(AText, AFile);
end;

// A hooked fseek form (AOffset from AOrigin): 0 or -1 on a handle, anything else to AName
routine DoSeekFile(const AFile: ptr; const AOffset: int64; const AOrigin: int32; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FseekFn;
begin
  LCall := DoCall(HookOp.Seek, -1);
  LCall.Offset := AOffset;
  LCall.Origin := AOrigin;
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := FseekFn(LFound);
  return LReal(AFile, AOffset, AOrigin);
end;

// A hooked ftell form: the place on a handle (-1 with errno), anything else to AName
routine DoTellFile(const AFile: ptr; var ASlot: ptr; const AName: ptr to const char): int64;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FtellFn;
begin
  LCall := DoCall(HookOp.Tell, -1);
  if DoWith(AFile, LCall) then
    return LCall.Answer;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := FtellFn(LFound);
  return LReal(AFile);
end;

// A hooked fgetpos / fsetpos form (AOp GetPos / SetPos) of APos on a handle, anything else to
// AName
routine DoPosFile(const AOp: HookOp; const AFile: ptr; const APos: ptr to fpos_t; var ASlot: ptr;
  const AName: ptr to const char): int32;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: FposFn;
begin
  LCall := DoCall(AOp, ADAM_HOOKIO_EOF);
  LCall.Buffer := ptr to uint8(APos);
  if DoWith(AFile, LCall) then
    return int32(LCall.Answer);
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := FposFn(LFound);
  return LReal(AFile, APos);
end;

// A hooked getdelim form (ADelim; getline: '\n') on a handle, anything else to AName
routine DoGetdelimFile(const ALine: ptr to ptr; const ASize: ptr to uint64; const ADelim: int32;
  const AFile: ptr; var ASlot: ptr; const AName: ptr to const char): int64;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: GetdelimFn;
begin
  LCall := DoCall(HookOp.Getline, -1);
  LCall.Line := ALine;
  LCall.LineSize := ASize;
  LCall.Value := ADelim;
  if DoWith(AFile, LCall) then
    return LCall.Answer;
  end;
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return -1;
  end;
  LReal := GetdelimFn(LFound);
  return LReal(ALine, ASize, ADelim, AFile);
end;

// A formatted print of AFormat over the C va_list AArgs on a handle: the text made by glibc's
// vasprintf (AFlag >= 0: __vasprintf_chk with that fortify flag), then put in one piece
// (DoCallPrint). False: AFile is no handle. True: AAnswer is the count, or -1 (the text could
// not be made: vasprintf's errno)
routine DoPrint(const AFile: ptr; const AFlag: int32; const AFormat: ptr to const char;
  const AArgs: ptr; var AAnswer: int32): bool;
var
  LText: ptr to char;
  LCount: int32;
  LCall: HookCall;
begin
  AAnswer := -1;
  LCall := DoCall(HookOp.PrintCheck, -1);
  if not DoWith(AFile, LCall) then
    return false;
  end;
  if LCall.Answer <> 0 then
    return true;
  end;
  LText := nil;
  if AFlag >= 0 then
    LCount := __vasprintf_chk(addr of LText, AFlag, AFormat, AArgs);
  else
    LCount := vasprintf(addr of LText, AFormat, AArgs);
  end;
  if LCount < 0 then
    // The text could not be made (vasprintf's errno): nothing was written
    return true;
  end;
  LCall := DoCall(HookOp.Print, -1);
  LCall.Buffer := ptr to uint8(LText);
  LCall.Size := int64(LCount);
  if not DoWith(AFile, LCall) then
    free(ptr(LText));
    return false;
  end;
  free(ptr(LText));
  AAnswer := int32(LCall.Answer);
  return true;
end;

// A wide formatted print of AFormat over AArgs on a handle: the text made by glibc's vfwprintf
// (AFlag >= 0: __vfwprintf_chk) into an open_wmemstream, then each character put
// (DoCallPrintWide). False: AFile is no handle. True: AAnswer is the count, or -1
routine DoPrintWide(const AFile: ptr; const AFlag: int32; const AFormat: ptr to const uint32;
  const AArgs: ptr; var AAnswer: int32): bool;
var
  LText: ptr to uint32;
  LSize: uint64;
  LMemory: ptr;
  LFound: ptr;
  LPrint: VfwprintfFn;
  LPrintChk: VfwprintfChkFn;
  LCount: int32;
  LCall: HookCall;
begin
  AAnswer := -1;
  LCall := DoCall(HookOp.PrintWideCheck, -1);
  if not DoWith(AFile, LCall) then
    return false;
  end;
  if LCall.Answer <> 0 then
    return true;
  end;
  LText := nil;
  LSize := 0u;
  LMemory := open_wmemstream(addr of LText, addr of LSize);
  if LMemory = nil then
    return true;
  end;
  LCount := -1;
  if AFlag >= 0 then
    LFound := DoReal(GRealMemVfwprintfChk, ptr to const char("__vfwprintf_chk"));
    if LFound <> nil then
      LPrintChk := VfwprintfChkFn(LFound);
      LCount := LPrintChk(LMemory, AFlag, AFormat, AArgs);
    end;
  else
    LFound := DoReal(GRealMemVfwprintf, ptr to const char("vfwprintf"));
    if LFound <> nil then
      LPrint := VfwprintfFn(LFound);
      LCount := LPrint(LMemory, AFormat, AArgs);
    end;
  end;
  DoRealClose(GRealMemFclose, LMemory);
  if LCount < 0 then
    if LText <> nil then
      free(ptr(LText));
    end;
    return true;
  end;
  LCall := DoCall(HookOp.PrintWide, -1);
  LCall.Wide := LText;
  LCall.Size := int64(LCount);
  if not DoWith(AFile, LCall) then
    free(ptr(LText));
    return false;
  end;
  free(ptr(LText));
  AAnswer := int32(LCall.Answer);
  return true;
end;

// A scan on a handle (AOp Scan / ScanWide) with the real scan function AReal: DoCallScan.
// False: AFile is no handle
routine DoScan(const AOp: HookOp; const AFile: ptr; const AReal: ptr; const AFormat: ptr;
  const AArgs: ptr; var AAnswer: int32): bool;
var
  LCall: HookCall;
begin
  LCall := DoCall(AOp, ADAM_HOOKIO_EOF);
  LCall.ScanReal := AReal;
  LCall.ScanFormat := AFormat;
  LCall.ScanArgs := AArgs;
  if not DoWith(AFile, LCall) then
    return false;
  end;
  AAnswer := int32(LCall.Answer);
  return true;
end;

// A hooked vfscanf form: a handle's scan by glibc's own AName over the stand-in, anything else
// to AName; ENOSYS (EOF) when the C runtime has none
routine DoScanFile(const AOp: HookOp; const AFile: ptr; const AFormat: ptr; const AArgs: ptr;
  var ASlot: ptr; const AName: ptr to const char): int32;
var
  LFound: ptr;
  LAnswer: int32;
  LReal: VfscanfFn;
begin
  LFound := DoReal(ASlot, AName);
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  if DoScan(AOp, AFile, LFound, AFormat, AArgs, LAnswer) then
    return LAnswer;
  end;
  LReal := VfscanfFn(LFound);
  return LReal(AFile, AFormat, AArgs);
end;

// --- the hooks: glibc's names (public: their plain C names) ---------------------------------
// Each hands a path or a FILE that is not HookIO's to the real function, found once (System.
// HookAbi's HookReal: libc.so.6's through dlsym); when the C runtime has no such function the
// call fails with ENOSYS.

// fopen: a virtual path opens a handle (see the unit header)
public routine fopen(const APath: ptr to const char; const AMode: ptr to const char): ptr;
var
  LFile: ptr;
  LFound: ptr;
  LReal: FopenFn;
begin
  if DoOpen(APath, AMode, LFile) then
    return LFile;
  end;
  LFound := DoReal(GRealFopen, ptr to const char("fopen"));
  if LFound = nil then
    return nil;
  end;
  LReal := FopenFn(LFound);
  return LReal(APath, AMode);
end;

// fopen64 (a large-file open: the same on a 64-bit target)
public routine fopen64(const APath: ptr to const char; const AMode: ptr to const char): ptr;
var
  LFile: ptr;
  LFound: ptr;
  LReal: FopenFn;
begin
  if DoOpen(APath, AMode, LFile) then
    return LFile;
  end;
  LFound := DoReal(GRealFopen64, ptr to const char("fopen64"));
  if LFound = nil then
    return nil;
  end;
  LReal := FopenFn(LFound);
  return LReal(APath, AMode);
end;

// freopen: a handle is reopened in place (DoReopen), whatever the path; a real FILE goes to the
// C runtime, whatever the path
public routine freopen(const APath: ptr to const char; const AMode: ptr to const char;
  const AFile: ptr): ptr;
var
  LFile: ptr;
  LFound: ptr;
  LReal: FreopenFn;
begin
  if DoReopen(APath, AMode, AFile, LFile) then
    return LFile;
  end;
  LFound := DoReal(GRealFreopen, ptr to const char("freopen"));
  if LFound = nil then
    return nil;
  end;
  LReal := FreopenFn(LFound);
  return LReal(APath, AMode, AFile);
end;

// freopen64: freopen
public routine freopen64(const APath: ptr to const char; const AMode: ptr to const char;
  const AFile: ptr): ptr;
var
  LFile: ptr;
  LFound: ptr;
  LReal: FreopenFn;
begin
  if DoReopen(APath, AMode, AFile, LFile) then
    return LFile;
  end;
  LFound := DoReal(GRealFreopen64, ptr to const char("freopen64"));
  if LFound = nil then
    return nil;
  end;
  LReal := FreopenFn(LFound);
  return LReal(APath, AMode, AFile);
end;

// fclose: a handle is closed (its own IO with it), anything else goes to the C runtime
public routine fclose(const AFile: ptr): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FileIntFn;
begin
  if DoClose(AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFclose, ptr to const char("fclose"));
  if LFound = nil then
    return ADAM_HOOKIO_EOF;
  end;
  LReal := FileIntFn(LFound);
  return LReal(AFile);
end;

// pclose: glibc's is fclose of the stream (a popen one waits for its process): a handle closes
public routine pclose(const AFile: ptr): int32;
var
  LResult: int32;
  LFound: ptr;
  LReal: FileIntFn;
begin
  if DoClose(AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealPclose, ptr to const char("pclose"));
  if LFound = nil then
    return -1;
  end;
  LReal := FileIntFn(LFound);
  return LReal(AFile);
end;

// fread and fread_unlocked: a handle reads through its libio model (size_t's bits in int64, as
// System.HookIO.Win64 takes them)
public routine fread(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AFile: ptr): int64;
begin
  return int64(DoTransfer(HookOp.Read, ABuffer, uint64(ASize), uint64(ACount), AFile, GRealFread,
    ptr to const char("fread")));
end;
public routine fread_unlocked(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AFile: ptr): int64;
begin
  return int64(DoTransfer(HookOp.Read, ABuffer, uint64(ASize), uint64(ACount), AFile, GRealFreadUnlocked,
    ptr to const char("fread_unlocked")));
end;

// glibc's fortified fread check (fread_chk.c): a product past size_t or past the buffer's
// ABufferSize bytes aborts (__chk_fail)
routine DoFreadCheck(const ABufferSize: uint64; const ASize: uint64; const ACount: uint64);
var
  LBytes: uint64;
begin
  LBytes := ASize * ACount;
  if (ACount | ASize) >= 4294967296u then
    if (ASize <> 0u) and ((LBytes div ASize) <> ACount) then
      __chk_fail();
    end;
  end;
  if LBytes > ABufferSize then
    __chk_fail();
  end;
end;

// __fread_chk / __fread_unlocked_chk (C built with -D_FORTIFY_SOURCE): glibc's check, then fread
public routine __fread_chk(const ABuffer: ptr; const ABufferSize: uint64; const ASize: uint64;
  const ACount: uint64; const AFile: ptr): uint64;
var
  LFound: ptr;
  LReal: TransferChkFn;
begin
  if DoOwns(AFile) then
    DoFreadCheck(ABufferSize, ASize, ACount);
    return DoTransfer(HookOp.Read, ABuffer, ASize, ACount, AFile, GRealFread,
      ptr to const char("fread"));
  end;
  LFound := DoReal(GRealFreadChk, ptr to const char("__fread_chk"));
  if LFound = nil then
    return 0u;
  end;
  LReal := TransferChkFn(LFound);
  return LReal(ABuffer, ABufferSize, ASize, ACount, AFile);
end;
public routine __fread_unlocked_chk(const ABuffer: ptr; const ABufferSize: uint64;
  const ASize: uint64; const ACount: uint64; const AFile: ptr): uint64;
var
  LFound: ptr;
  LReal: TransferChkFn;
begin
  if DoOwns(AFile) then
    DoFreadCheck(ABufferSize, ASize, ACount);
    return DoTransfer(HookOp.Read, ABuffer, ASize, ACount, AFile, GRealFreadUnlocked,
      ptr to const char("fread_unlocked"));
  end;
  LFound := DoReal(GRealFreadUnlockedChk, ptr to const char("__fread_unlocked_chk"));
  if LFound = nil then
    return 0u;
  end;
  LReal := TransferChkFn(LFound);
  return LReal(ABuffer, ABufferSize, ASize, ACount, AFile);
end;

// fwrite and fwrite_unlocked: a handle writes through its libio model
public routine fwrite(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AFile: ptr): int64;
begin
  return int64(DoTransfer(HookOp.Write, ABuffer, uint64(ASize), uint64(ACount), AFile, GRealFwrite,
    ptr to const char("fwrite")));
end;
public routine fwrite_unlocked(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AFile: ptr): int64;
begin
  return int64(DoTransfer(HookOp.Write, ABuffer, uint64(ASize), uint64(ACount), AFile, GRealFwriteUnlocked,
    ptr to const char("fwrite_unlocked")));
end;

// The byte reads: getc's macro body on a handle (the get area's byte, else __uflow)
public routine fgetc(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Get, ADAM_HOOKIO_EOF, AFile, GRealFgetc, ptr to const char("fgetc"));
end;
public routine getc(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Get, ADAM_HOOKIO_EOF, AFile, GRealGetc, ptr to const char("getc"));
end;
public routine fgetc_unlocked(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.GetUnlocked, ADAM_HOOKIO_EOF, AFile, GRealFgetcUnlocked,
    ptr to const char("fgetc_unlocked"));
end;
public routine getc_unlocked(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.GetUnlocked, ADAM_HOOKIO_EOF, AFile, GRealGetcUnlocked,
    ptr to const char("getc_unlocked"));
end;
public routine _IO_getc(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Get, ADAM_HOOKIO_EOF, AFile, GRealIOGetc, ptr to const char("_IO_getc"));
end;
// getw: an int's bytes (EOF when fewer came)
public routine getw(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.GetWord, ADAM_HOOKIO_EOF, AFile, GRealGetw, ptr to const char("getw"));
end;
// _IO_peekc_locked: the next byte, not taken
public routine _IO_peekc_locked(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Peek, ADAM_HOOKIO_EOF, AFile, GRealPeekc,
    ptr to const char("_IO_peekc_locked"));
end;
// __uflow / __underflow: where glibc's inline getc_unlocked falls when the get area is empty
// (a handle's always is)
public routine __uflow(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Uflow, ADAM_HOOKIO_EOF, AFile, GRealUflow, ptr to const char("__uflow"));
end;
public routine __underflow(const AFile: ptr): int32;
begin
  return DoFileInt(HookOp.Underflow, ADAM_HOOKIO_EOF, AFile, GRealUnderflow,
    ptr to const char("__underflow"));
end;

// fgets and fgets_unlocked: up to ACount - 1 bytes, to and with a newline
public routine fgets(const AText: ptr to char; const ACount: int32; const AFile: ptr): ptr to char;
begin
  return DoGets(AText, ACount, AFile, GRealFgets, ptr to const char("fgets"));
end;
public routine fgets_unlocked(const AText: ptr to char; const ACount: int32;
  const AFile: ptr): ptr to char;
begin
  return DoGets(AText, ACount, AFile, GRealFgetsUnlocked, ptr to const char("fgets_unlocked"));
end;

// A fortified fgets on a handle (fgets_chk.c): nothing for ACount <= 0; at most ACount - 1 and
// ASize bytes; a line of ASize or more aborts (__chk_fail). False: AFile is no handle
routine DoGetsChk(const AText: ptr to char; const ASize: uint64; const ACount: int32;
  const AFile: ptr; var AResult: ptr to char): bool;
var
  LCall: HookCall;
begin
  AResult := nil;
  if not DoOwns(AFile) then
    return false;
  end;
  if ACount <= 0 then
    return true;
  end;
  LCall := DoCall(HookOp.Gets, 0);
  LCall.Buffer := ptr to uint8(AText);
  LCall.Size := int64(ACount);
  LCall.ItemSize := int64(ASize);
  LCall.Origin := 1;
  if not DoWith(AFile, LCall) then
    return false;
  end;
  if LCall.Answer < 0 then
    __chk_fail();
  end;
  if LCall.Answer <> 0 then
    AResult := AText;
  end;
  return true;
end;

// __fgets_chk / __fgets_unlocked_chk (C built with -D_FORTIFY_SOURCE)
public routine __fgets_chk(const AText: ptr to char; const ASize: uint64; const ACount: int32;
  const AFile: ptr): ptr to char;
var
  LResult: ptr to char;
  LFound: ptr;
  LReal: FgetsChkFn;
begin
  if DoGetsChk(AText, ASize, ACount, AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFgetsChk, ptr to const char("__fgets_chk"));
  if LFound = nil then
    return nil;
  end;
  LReal := FgetsChkFn(LFound);
  return LReal(AText, ASize, ACount, AFile);
end;
public routine __fgets_unlocked_chk(const AText: ptr to char; const ASize: uint64;
  const ACount: int32; const AFile: ptr): ptr to char;
var
  LResult: ptr to char;
  LFound: ptr;
  LReal: FgetsChkFn;
begin
  if DoGetsChk(AText, ASize, ACount, AFile, LResult) then
    return LResult;
  end;
  LFound := DoReal(GRealFgetsUnlockedChk, ptr to const char("__fgets_unlocked_chk"));
  if LFound = nil then
    return nil;
  end;
  LReal := FgetsChkFn(LFound);
  return LReal(AText, ASize, ACount, AFile);
end;

// getdelim / __getdelim / getline: a whole line into the caller's malloc'd buffer
public routine getdelim(const ALine: ptr to ptr; const ASize: ptr to uint64; const ADelim: int32;
  const AFile: ptr): int64;
begin
  return DoGetdelimFile(ALine, ASize, ADelim, AFile, GRealGetdelim, ptr to const char("getdelim"));
end;
public routine __getdelim(const ALine: ptr to ptr; const ASize: ptr to uint64; const ADelim: int32;
  const AFile: ptr): int64;
begin
  return DoGetdelimFile(ALine, ASize, ADelim, AFile, GRealUnderGetdelim,
    ptr to const char("__getdelim"));
end;
public routine getline(const ALine: ptr to ptr; const ASize: ptr to uint64; const AFile: ptr): int64;
var
  LCall: HookCall;
  LFound: ptr;
  LReal: GetlineFn;
begin
  LCall := DoCall(HookOp.Getline, -1);
  LCall.Line := ALine;
  LCall.LineSize := ASize;
  LCall.Value := ADAM_HOOKIO_NEWLINE;
  if DoWith(AFile, LCall) then
    return LCall.Answer;
  end;
  LFound := DoReal(GRealGetline, ptr to const char("getline"));
  if LFound = nil then
    return -1;
  end;
  LReal := GetlineFn(LFound);
  return LReal(ALine, ASize, AFile);
end;

// ungetc: a byte given back (the backup area past the buffer's start)
public routine ungetc(const AChar: int32; const AFile: ptr): int32;
begin
  return DoCharFile(HookOp.Unget, AChar, AFile, GRealUngetc, ptr to const char("ungetc"));
end;

