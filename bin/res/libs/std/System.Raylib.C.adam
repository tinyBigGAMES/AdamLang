  b09: float32;
  b10: float32;
  b11: float32;
  invDet: float32;
begin
  result := Matrix(m0: 0.0f);
  a00 := mat.m0;
  a01 := mat.m1;
  a02 := mat.m2;
  a03 := mat.m3;
  a10 := mat.m4;
  a11 := mat.m5;
  a12 := mat.m6;
