  RL_ATTACHMENT_COLOR_CHANNEL3: int32 = 3;
  RL_ATTACHMENT_COLOR_CHANNEL4: int32 = 4;
  RL_ATTACHMENT_COLOR_CHANNEL5: int32 = 5;
  RL_ATTACHMENT_COLOR_CHANNEL6: int32 = 6;
  RL_ATTACHMENT_COLOR_CHANNEL7: int32 = 7;
  RL_ATTACHMENT_DEPTH: int32 = 100;
  RL_ATTACHMENT_STENCIL: int32 = 200;
  RL_ATTACHMENT_CUBEMAP_POSITIVE_X: int32 = 0;
  RL_ATTACHMENT_CUBEMAP_NEGATIVE_X: int32 = 1;
  RL_ATTACHMENT_CUBEMAP_POSITIVE_Y: int32 = 2;
  RL_ATTACHMENT_CUBEMAP_NEGATIVE_Y: int32 = 3;
  RL_ATTACHMENT_CUBEMAP_POSITIVE_Z: int32 = 4;
  RL_ATTACHMENT_CUBEMAP_NEGATIVE_Z: int32 = 5;
  RL_ATTACHMENT_TEXTURE2D: int32 = 100;
  RL_ATTACHMENT_RENDERBUFFER: int32 = 200;
  RL_CULL_FACE_FRONT: int32 = 0;
  RL_CULL_FACE_BACK: int32 = 1;

public type
  Vector2 = record
    x: float32;
    y: float32;
  end;

  Vector3 = record
    x: float32;
    y: float32;
    z: float32;
  end;

  Vector4 = record
    x: float32;
    y: float32;
    z: float32;
    w: float32;
  end;

  Quaternion = Vector4;

  Matrix = record
    m0: float32;
    m4: float32;
    m8: float32;
    m12: float32;
    m1: float32;
    m5: float32;
    m9: float32;
    m13: float32;
    m2: float32;
    m6: float32;
    m10: float32;
    m14: float32;
    m3: float32;
    m7: float32;
    m11: float32;
    m15: float32;
  end;

  Color = record
    r: uint8;
    g: uint8;
    b: uint8;
    a: uint8;
  end;

  Rectangle = record
    x: float32;
    y: float32;
    width: float32;
    height: float32;
  end;

  Image = record
    data: ptr;
    width: int32;
    height: int32;
    mipmaps: int32;
    format: int32;
  end;

  Texture = record
    id: uint32;
    width: int32;
    height: int32;
    mipmaps: int32;
    format: int32;
  end;

  Texture2D = Texture;
  TextureCubemap = Texture;

  RenderTexture = record
    id: uint32;
    texture: Texture;
    depth: Texture;
  end;

  RenderTexture2D = RenderTexture;

  NPatchInfo = record
    source: Rectangle;
    left: int32;
    top: int32;
    right: int32;
    bottom: int32;
    layout: int32;
  end;

  GlyphInfo = record
    value: int32;
    offsetX: int32;
    offsetY: int32;
    advanceX: int32;
    image: Image;
  end;

  Font = record
    baseSize: int32;
    glyphCount: int32;
    glyphPadding: int32;
    texture: Texture2D;
    recs: ptr to Rectangle;
    glyphs: ptr to GlyphInfo;
  end;

  Camera3D = record
    position: Vector3;
    target: Vector3;
    up: Vector3;
    fovy: float32;
    projection: int32;
  end;

  Camera = Camera3D;

  Camera2D = record
    offset: Vector2;
    target: Vector2;
    rotation: float32;
    zoom: float32;
  end;

  Mesh = record
    vertexCount: int32;
    triangleCount: int32;
    vertices: ptr to float32;
    texcoords: ptr to float32;
    texcoords2: ptr to float32;
    normals: ptr to float32;
    tangents: ptr to float32;
    colors: ptr to uint8;
    indices: ptr to uint16;
    boneCount: int32;
    boneIndices: ptr to uint8;
    boneWeights: ptr to float32;
    animVertices: ptr to float32;
    animNormals: ptr to float32;
    vaoId: uint32;
    vboId: ptr to uint32;
  end;

  Shader = record
    id: uint32;
    locs: ptr to int32;
  end;

  MaterialMap = record
    texture: Texture2D;
    color: Color;
    value: float32;
  end;

  Material = record
    shader: Shader;
    maps: ptr to MaterialMap;
    params: array[0..3] of float32;
  end;

  Transform = record
    translation: Vector3;
    rotation: Quaternion;
    scale: Vector3;
  end;

  ModelAnimPose = ptr to Transform;

  BoneInfo = record
    name: array[0..31] of char;
    parent_: int32;
  end;

  ModelSkeleton = record
    boneCount: uint32;
    bones: ptr to BoneInfo;
    bindPose: ModelAnimPose;
  end;

  Model = record
    transform: Matrix;
    meshCount: int32;
    materialCount: int32;
    meshes: ptr to Mesh;
    materials: ptr to Material;
    meshMaterial: ptr to int32;
    skeleton: ModelSkeleton;
    currentPose: ModelAnimPose;
    boneMatrices: ptr to Matrix;
  end;

  ModelAnimation = record
    name: array[0..31] of char;
    boneCount: uint32;
    keyframeCount: int32;
    keyframePoses: ptr to ModelAnimPose;
  end;

  Ray = record
    position: Vector3;
    direction: Vector3;
  end;

  RayCollision = record
    hit: bool;
    distance: float32;
    point: Vector3;
    normal: Vector3;
  end;

  BoundingBox = record
    min: Vector3;
    max: Vector3;
  end;

  Wave = record
    frameCount: uint32;
    sampleRate: uint32;
    sampleSize: uint32;
    channels: uint32;
    data: ptr;
  end;

  rAudioBuffer = record
  end;

  rAudioProcessor = record
  end;

  AudioStream = record
    buffer: ptr to rAudioBuffer;
    processor: ptr to rAudioProcessor;
    sampleRate: uint32;
    sampleSize: uint32;
    channels: uint32;
  end;

  Sound = record
    stream: AudioStream;
    frameCount: uint32;
  end;

  Music = record
    stream: AudioStream;
    frameCount: uint32;
    looping: bool;
    ctxType: int32;
    ctxData: ptr;
  end;

  VrDeviceInfo = record
    hResolution: int32;
    vResolution: int32;
    hScreenSize: float32;
    vScreenSize: float32;
    eyeToScreenDistance: float32;
    lensSeparationDistance: float32;
    interpupillaryDistance: float32;
    lensDistortionValues: array[0..3] of float32;
    chromaAbCorrection: array[0..3] of float32;
  end;

  VrStereoConfig = record
    projection: array[0..1] of Matrix;
    viewOffset: array[0..1] of Matrix;
    leftLensCenter: array[0..1] of float32;
    rightLensCenter: array[0..1] of float32;
    leftScreenCenter: array[0..1] of float32;
    rightScreenCenter: array[0..1] of float32;
    scale: array[0..1] of float32;
    scaleIn: array[0..1] of float32;
  end;

  FilePathList = record
    count: uint32;
    paths: ptr to ptr to char;
  end;

  AutomationEvent = record
    frame: uint32;
    type_: uint32;
    params: array[0..3] of int32;
  end;

  AutomationEventList = record
    capacity: uint32;
    count: uint32;
    events: ptr to AutomationEvent;
  end;

  ConfigFlags = int32;
  TraceLogLevel = int32;
  KeyboardKey = int32;
  MouseButton = int32;
  MouseCursor = int32;
  GamepadButton = int32;
  GamepadAxis = int32;
  MaterialMapIndex = int32;
  ShaderLocationIndex = int32;
  ShaderUniformDataType = int32;
  ShaderAttributeDataType = int32;
  PixelFormat = int32;
  TextureFilter = int32;
  TextureWrap = int32;
  CubemapLayout = int32;
  FontType = int32;
  BlendMode = int32;
  Gesture = int32;
  CameraMode = int32;
  CameraProjection = int32;
  NPatchLayout = int32;

  TraceLogCallback = routine clink(logLevel: int32; text: ptr to const char; args: ptr);
  LoadFileDataCallback = routine clink(fileName: ptr to const char; dataSize: ptr to int32): ptr to uint8;
  SaveFileDataCallback = routine clink(fileName: ptr to const char; data: ptr to const; dataSize: int32): bool;
  LoadFileTextCallback = routine clink(fileName: ptr to const char): ptr to char;
  SaveFileTextCallback = routine clink(fileName: ptr to const char; text: ptr to const char): bool;
  AudioCallback = routine clink(bufferData: ptr; frames: uint32);

  float3 = record
    v: array[0..2] of float32;
  end;

  float16 = record
    v: array[0..15] of float32;
  end;

  rlVertexBuffer = record
    elementCount: int32;
    vertices: ptr to float32;
    texcoords: ptr to float32;
    normals: ptr to float32;
    colors: ptr to uint8;
    indices: ptr to uint32;
    vaoId: uint32;
    vboId: array[0..4] of uint32;
  end;

  rlDrawCall = record
    mode: int32;
    vertexCount: int32;
    vertexAlignment: int32;
    textureId: uint32;
  end;

  rlRenderBatch = record
    bufferCount: int32;
    currentBuffer: int32;
    vertexBuffer: ptr to rlVertexBuffer;
    draws: ptr to rlDrawCall;
    drawCounter: int32;
    currentDepth: float32;
  end;

  rlGlVersion = int32;
  rlTraceLogLevel = int32;
  rlPixelFormat = int32;
  rlTextureFilter = int32;
  rlBlendMode = int32;
  rlShaderLocationIndex = int32;
  rlShaderUniformDataType = int32;
  rlShaderAttributeDataType = int32;
  rlFramebufferAttachType = int32;
  rlFramebufferAttachTextureType = int32;
  rlCullMode = int32;

