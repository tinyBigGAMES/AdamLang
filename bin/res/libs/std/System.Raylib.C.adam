public routine cpplink MatrixDecompose(const mat: Matrix; const translation: ptr to Vector3;
  const rotation: ptr to Quaternion; const scale: ptr to Vector3);
var
  eps: float32;
  matColumns: array[0..2] of Vector3;
  shear: array[0..2] of float32;
  scl: Vector3;
  stabilizer: float32;
  i: int32;
  rotationMatrix: Matrix;
begin
  eps := 9.999999717180685e-10f;
  translation->x := mat.m12;
  translation->y := mat.m13;
  translation->z := mat.m14;
  matColumns := [Vector3(x: mat.m0, y: mat.m1, z: mat.m2), Vector3(x: mat.m4, y: mat.m5, z: mat.m6), Vector3(x: mat.m8, y: mat.m9, z: mat.m10)];
  shear := [0.0f, 0.0f, 0.0f];
  scl := Vector3(x: 0.0f);
  stabilizer := eps;
  i := 0;
  while (i < 3) do
    stabilizer := fmaxf(stabilizer, fabsf(matColumns[i].x));
    stabilizer := fmaxf(stabilizer, fabsf(matColumns[i].y));
    stabilizer := fmaxf(stabilizer, fabsf(matColumns[i].z));
    i++;
  end;
  matColumns[0] := Vector3Scale(matColumns[0], (1.0f / stabilizer));
  matColumns[1] := Vector3Scale(matColumns[1], (1.0f / stabilizer));
  matColumns[2] := Vector3Scale(matColumns[2], (1.0f / stabilizer));
  scl.x := Vector3Length(matColumns[0]);
  if (scl.x > eps) then
    matColumns[0] := Vector3Scale(matColumns[0], (1.0f / scl.x));
  end;
  shear[0] := Vector3DotProduct(matColumns[0], matColumns[1]);
  matColumns[1] := Vector3Subtract(matColumns[1], Vector3Scale(matColumns[0], shear[0]));
  scl.y := Vector3Length(matColumns[1]);
  if (scl.y > eps) then
    matColumns[1] := Vector3Scale(matColumns[1], (1.0f / scl.y));
    shear[0] /= scl.y;
  end;
  shear[1] := Vector3DotProduct(matColumns[0], matColumns[2]);
  matColumns[2] := Vector3Subtract(matColumns[2], Vector3Scale(matColumns[0], shear[1]));
  shear[2] := Vector3DotProduct(matColumns[1], matColumns[2]);
  matColumns[2] := Vector3Subtract(matColumns[2], Vector3Scale(matColumns[1], shear[2]));
  scl.z := Vector3Length(matColumns[2]);
  if (scl.z > eps) then
    matColumns[2] := Vector3Scale(matColumns[2], (1.0f / scl.z));
    shear[1] /= scl.z;
    shear[2] /= scl.z;
  end;
  if (Vector3DotProduct(matColumns[0], Vector3CrossProduct(matColumns[1], matColumns[2])) < 0.0f) then
    scl := Vector3Negate(scl);
    matColumns[0] := Vector3Negate(matColumns[0]);
    matColumns[1] := Vector3Negate(matColumns[1]);
    matColumns[2] := Vector3Negate(matColumns[2]);
  end;
  scale^ := Vector3Scale(scl, stabilizer);
  rotationMatrix := Matrix(m0: matColumns[0].x, m4: matColumns[1].x, m8: matColumns[2].x, m12: 0.0f, m1: matColumns[0].y, m5: matColumns[1].y, m9: matColumns[2].y, m13: 0.0f, m2: matColumns[0].z, m6: matColumns[1].z, m10: matColumns[2].z, m14: 0.0f, m3: 0.0f, m7: 0.0f, m11: 0.0f, m15: 1.0f);
  rotation^ := QuaternionFromMatrix(rotationMatrix);
end;

public routine CLITERAL<T>(const type_: T): T;
begin
  return T(type_);
end;

public routine MatrixToFloat(const mat: Matrix): array[0..15] of float32;
begin
  return MatrixToFloatV(mat).v;
end;

public routine Vector3ToFloat(const vec: Vector3): array[0..2] of float32;
begin
  return Vector3ToFloatV(vec).v;
end;

end.
