public routine cpplink MatrixRotateXYZ(const angle: Vector3): Matrix;
var
  result: Matrix;
  cosz: float32;
  sinz: float32;
  cosy: float32;
  siny: float32;
  cosx: float32;
  sinx: float32;
begin
  result := Matrix(m0: 1.0f, m4: 0.0f, m8: 0.0f, m12: 0.0f, m1: 0.0f, m5: 1.0f, m9: 0.0f, m13: 0.0f, m2: 0.0f, m6: 0.0f, m10: 1.0f, m14: 0.0f, m3: 0.0f, m7: 0.0f, m11: 0.0f, m15: 1.0f);
  cosz := cosf((-angle.z));
  sinz := sinf((-angle.z));
  cosy := cosf((-angle.y));
  siny := sinf((-angle.y));
  cosx := cosf((-angle.x));
  sinx := sinf((-angle.x));
  result.m0 := (cosz * cosy);
  result.m1 := (((cosz * siny) * sinx) - (sinz * cosx));
  result.m2 := (((cosz * siny) * cosx) + (sinz * sinx));
  result.m4 := (sinz * cosy);
  result.m5 := (((sinz * siny) * sinx) + (cosz * cosx));
  result.m6 := (((sinz * siny) * cosx) - (cosz * sinx));
  result.m8 := (-siny);
  result.m9 := (cosy * sinx);
  result.m10 := (cosy * cosx);
  return result;
end;

public routine cpplink MatrixRotateZYX(const angle: Vector3): Matrix;
var
  result: Matrix;
  cz: float32;
  sz: float32;
  cy: float32;
  sy: float32;
  cx: float32;
  sx: float32;
begin
  result := Matrix(m0: 0.0f);
  cz := cosf(angle.z);
  sz := sinf(angle.z);
  cy := cosf(angle.y);
  sy := sinf(angle.y);
  cx := cosf(angle.x);
  sx := sinf(angle.x);
  result.m0 := (cz * cy);
  result.m4 := (((cz * sy) * sx) - (cx * sz));
  result.m8 := ((sz * sx) + ((cz * cx) * sy));
  result.m12 := 0.0f;
  result.m1 := (cy * sz);
  result.m5 := ((cz * cx) + ((sz * sy) * sx));
  result.m9 := (((cx * sz) * sy) - (cz * sx));
  result.m13 := 0.0f;
  result.m2 := (-sy);
  result.m6 := (cy * sx);
  result.m10 := (cy * cx);
  result.m14 := 0.0f;
  result.m3 := 0.0f;
  result.m7 := 0.0f;
  result.m11 := 0.0f;
  result.m15 := 1.0f;
  return result;
end;

