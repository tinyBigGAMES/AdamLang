public routine cpplink MatrixFrustum(const left: float64; const right: float64;
  const bottom: float64; const top: float64; const nearPlane: float64;
  const farPlane: float64): Matrix;
var
  result: Matrix;
  rl: float32;
  tb: float32;
  fn: float32;
begin
  result := Matrix(m0: 0.0f);
  rl := float32((right - left));
  tb := float32((top - bottom));
  fn := float32((farPlane - nearPlane));
  result.m0 := ((float32(nearPlane) * 2.0f) / rl);
  result.m1 := 0.0f;
  result.m2 := 0.0f;
  result.m3 := 0.0f;
  result.m4 := 0.0f;
  result.m5 := ((float32(nearPlane) * 2.0f) / tb);
  result.m6 := 0.0f;
  result.m7 := 0.0f;
  result.m8 := ((float32(right) + float32(left)) / rl);
  result.m9 := ((float32(top) + float32(bottom)) / tb);
  result.m10 := ((-(float32(farPlane) + float32(nearPlane))) / fn);
  result.m11 := (-1.0f);
  result.m12 := 0.0f;
  result.m13 := 0.0f;
  result.m14 := ((-((float32(farPlane) * float32(nearPlane)) * 2.0f)) / fn);
  result.m15 := 0.0f;
  return result;
end;

public routine cpplink MatrixPerspective(const fovY: float64; const aspect: float64;
  const nearPlane: float64; const farPlane: float64): Matrix;
var
  result: Matrix;
  top: float64;
  bottom: float64;
  right: float64;
  left: float64;
  rl: float32;
  tb: float32;
  fn: float32;
begin
  result := Matrix(m0: 0.0f);
  top := (nearPlane * tan((fovY * 0.5)));
  bottom := (-top);
  right := (top * aspect);
  left := (-right);
  rl := float32((right - left));
  tb := float32((top - bottom));
  fn := float32((farPlane - nearPlane));
  result.m0 := ((float32(nearPlane) * 2.0f) / rl);
  result.m5 := ((float32(nearPlane) * 2.0f) / tb);
  result.m8 := ((float32(right) + float32(left)) / rl);
  result.m9 := ((float32(top) + float32(bottom)) / tb);
  result.m10 := ((-(float32(farPlane) + float32(nearPlane))) / fn);
  result.m11 := (-1.0f);
  result.m14 := ((-((float32(farPlane) * float32(nearPlane)) * 2.0f)) / fn);
  return result;
end;

public routine cpplink MatrixOrtho(const left: float64; const right: float64; const bottom: float64;
  const top: float64; const nearPlane: float64; const farPlane: float64): Matrix;
var
  result: Matrix;
  rl: float32;
  tb: float32;
  fn: float32;
begin
  result := Matrix(m0: 0.0f);
  rl := float32((right - left));
  tb := float32((top - bottom));
  fn := float32((farPlane - nearPlane));
  result.m0 := (2.0f / rl);
  result.m1 := 0.0f;
  result.m2 := 0.0f;
  result.m3 := 0.0f;
  result.m4 := 0.0f;
  result.m5 := (2.0f / tb);
  result.m6 := 0.0f;
  result.m7 := 0.0f;
  result.m8 := 0.0f;
  result.m9 := 0.0f;
  result.m10 := ((-2.0f) / fn);
  result.m11 := 0.0f;
  result.m12 := ((-(float32(left) + float32(right))) / rl);
  result.m13 := ((-(float32(top) + float32(bottom))) / tb);
  result.m14 := ((-(float32(farPlane) + float32(nearPlane))) / fn);
  result.m15 := 1.0f;
  return result;
end;

public routine cpplink MatrixLookAt(const eye: Vector3; const target: Vector3;
  const up: Vector3): Matrix;
var
  result: Matrix;
  length: float32;
  ilength: float32;
  vz: Vector3;
  v: Vector3;
  vx: Vector3;
  vy: Vector3;
begin
  result := Matrix(m0: 0.0f);
  length := 0.0f;
  ilength := 0.0f;
  vz := Vector3(x: (eye.x - target.x), y: (eye.y - target.y), z: (eye.z - target.z));
  v := vz;
  length := sqrtf((((v.x * v.x) + (v.y * v.y)) + (v.z * v.z)));
  if (length = 0.0f) then
    length := 1.0f;
  end;
  ilength := (1.0f / length);
  vz.x *= ilength;
  vz.y *= ilength;
  vz.z *= ilength;
  vx := Vector3(x: ((up.y * vz.z) - (up.z * vz.y)), y: ((up.z * vz.x) - (up.x * vz.z)), z: ((up.x * vz.y) - (up.y * vz.x)));
  v := vx;
  length := sqrtf((((v.x * v.x) + (v.y * v.y)) + (v.z * v.z)));
  if (length = 0.0f) then
    length := 1.0f;
  end;
  ilength := (1.0f / length);
  vx.x *= ilength;
  vx.y *= ilength;
  vx.z *= ilength;
  vy := Vector3(x: ((vz.y * vx.z) - (vz.z * vx.y)), y: ((vz.z * vx.x) - (vz.x * vx.z)), z: ((vz.x * vx.y) - (vz.y * vx.x)));
  result.m0 := vx.x;
  result.m1 := vy.x;
  result.m2 := vz.x;
  result.m3 := 0.0f;
  result.m4 := vx.y;
  result.m5 := vy.y;
  result.m6 := vz.y;
  result.m7 := 0.0f;
  result.m8 := vx.z;
  result.m9 := vy.z;
  result.m10 := vz.z;
  result.m11 := 0.0f;
  result.m12 := (-(((vx.x * eye.x) + (vx.y * eye.y)) + (vx.z * eye.z)));
  result.m13 := (-(((vy.x * eye.x) + (vy.y * eye.y)) + (vy.z * eye.z)));
  result.m14 := (-(((vz.x * eye.x) + (vz.y * eye.y)) + (vz.z * eye.z)));
  result.m15 := 1.0f;
  return result;
end;

