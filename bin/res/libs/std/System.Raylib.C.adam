  cosres := cosf(angle);
  sinres := sinf(angle);
  result.m5 := cosres;
  result.m6 := sinres;
  result.m9 := (-sinres);
  result.m10 := cosres;
  return result;
end;

public routine cpplink MatrixRotateY(const angle: float32): Matrix;
