public routine cpplink MatrixRotate(const axis: Vector3; const angle: float32): Matrix;
var
  result: Matrix;
  x: float32;
  y: float32;
  z: float32;
  lengthSquared: float32;
  ilength: float32;
  sinres: float32;
  cosres: float32;
  t: float32;
begin
  result := Matrix(m0: 0.0f);
  x := axis.x;
  y := axis.y;
  z := axis.z;
  lengthSquared := (((x * x) + (y * y)) + (z * z));
  if ((lengthSquared <> 1.0f) and (lengthSquared <> 0.0f)) then
    ilength := (1.0f / sqrtf(lengthSquared));
    x *= ilength;
    y *= ilength;
    z *= ilength;
  end;
  sinres := sinf(angle);
  cosres := cosf(angle);
  t := (1.0f - cosres);
  result.m0 := (((x * x) * t) + cosres);
  result.m1 := (((y * x) * t) + (z * sinres));
  result.m2 := (((z * x) * t) - (y * sinres));
  result.m3 := 0.0f;
  result.m4 := (((x * y) * t) - (z * sinres));
  result.m5 := (((y * y) * t) + cosres);
  result.m6 := (((z * y) * t) + (x * sinres));
  result.m7 := 0.0f;
  result.m8 := (((x * z) * t) + (y * sinres));
  result.m9 := (((y * z) * t) - (x * sinres));
  result.m10 := (((z * z) * t) + cosres);
  result.m11 := 0.0f;
  result.m12 := 0.0f;
  result.m13 := 0.0f;
  result.m14 := 0.0f;
  result.m15 := 1.0f;
  return result;
end;

public routine cpplink MatrixRotateX(const angle: float32): Matrix;
