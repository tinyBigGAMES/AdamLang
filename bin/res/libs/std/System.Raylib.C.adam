public routine cpplink MatrixCompose(const translation: Vector3; const rotation: Quaternion;
  const scale: Vector3): Matrix;
var
  right: Vector3;
  up: Vector3;
  forward_: Vector3;
  temp: Vector3;
  result: Matrix;
begin
  right := Vector3(x: 1.0f, y: 0.0f, z: 0.0f);
  up := Vector3(x: 0.0f, y: 1.0f, z: 0.0f);
  forward_ := Vector3(x: 0.0f, y: 0.0f, z: 1.0f);
  right.x *= scale.x;
  right.y *= scale.x;
  right.z *= scale.x;
  up.x *= scale.y;
  up.y *= scale.y;
  up.z *= scale.y;
  forward_.x *= scale.z;
  forward_.y *= scale.z;
  forward_.z *= scale.z;
  temp := right;
  right.x := (((temp.x * ((((rotation.x * rotation.x) + (rotation.w * rotation.w)) - (rotation.y * rotation.y)) - (rotation.z * rotation.z))) + (temp.y * (((2.0f * rotation.x) * rotation.y) - ((2.0f * rotation.w) * rotation.z)))) + (temp.z * (((2.0f * rotation.x) * rotation.z) + ((2.0f * rotation.w) * rotation.y))));
  right.y := (((temp.x * (((2.0f * rotation.w) * rotation.z) + ((2.0f * rotation.x) * rotation.y))) + (temp.y * ((((rotation.w * rotation.w) - (rotation.x * rotation.x)) + (rotation.y * rotation.y)) - (rotation.z * rotation.z)))) + (temp.z * ((((-2.0f) * rotation.w) * rotation.x) + ((2.0f * rotation.y) * rotation.z))));
  right.z := (((temp.x * ((((-2.0f) * rotation.w) * rotation.y) + ((2.0f * rotation.x) * rotation.z))) + (temp.y * (((2.0f * rotation.w) * rotation.x) + ((2.0f * rotation.y) * rotation.z)))) + (temp.z * ((((rotation.w * rotation.w) - (rotation.x * rotation.x)) - (rotation.y * rotation.y)) + (rotation.z * rotation.z))));
  temp := up;
  up.x := (((temp.x * ((((rotation.x * rotation.x) + (rotation.w * rotation.w)) - (rotation.y * rotation.y)) - (rotation.z * rotation.z))) + (temp.y * (((2.0f * rotation.x) * rotation.y) - ((2.0f * rotation.w) * rotation.z)))) + (temp.z * (((2.0f * rotation.x) * rotation.z) + ((2.0f * rotation.w) * rotation.y))));
  up.y := (((temp.x * (((2.0f * rotation.w) * rotation.z) + ((2.0f * rotation.x) * rotation.y))) + (temp.y * ((((rotation.w * rotation.w) - (rotation.x * rotation.x)) + (rotation.y * rotation.y)) - (rotation.z * rotation.z)))) + (temp.z * ((((-2.0f) * rotation.w) * rotation.x) + ((2.0f * rotation.y) * rotation.z))));
  up.z := (((temp.x * ((((-2.0f) * rotation.w) * rotation.y) + ((2.0f * rotation.x) * rotation.z))) + (temp.y * (((2.0f * rotation.w) * rotation.x) + ((2.0f * rotation.y) * rotation.z)))) + (temp.z * ((((rotation.w * rotation.w) - (rotation.x * rotation.x)) - (rotation.y * rotation.y)) + (rotation.z * rotation.z))));
  temp := forward_;
  forward_.x := (((temp.x * ((((rotation.x * rotation.x) + (rotation.w * rotation.w)) - (rotation.y * rotation.y)) - (rotation.z * rotation.z))) + (temp.y * (((2.0f * rotation.x) * rotation.y) - ((2.0f * rotation.w) * rotation.z)))) + (temp.z * (((2.0f * rotation.x) * rotation.z) + ((2.0f * rotation.w) * rotation.y))));
  forward_.y := (((temp.x * (((2.0f * rotation.w) * rotation.z) + ((2.0f * rotation.x) * rotation.y))) + (temp.y * ((((rotation.w * rotation.w) - (rotation.x * rotation.x)) + (rotation.y * rotation.y)) - (rotation.z * rotation.z)))) + (temp.z * ((((-2.0f) * rotation.w) * rotation.x) + ((2.0f * rotation.y) * rotation.z))));
  forward_.z := (((temp.x * ((((-2.0f) * rotation.w) * rotation.y) + ((2.0f * rotation.x) * rotation.z))) + (temp.y * (((2.0f * rotation.w) * rotation.x) + ((2.0f * rotation.y) * rotation.z)))) + (temp.z * ((((rotation.w * rotation.w) - (rotation.x * rotation.x)) - (rotation.y * rotation.y)) + (rotation.z * rotation.z))));
  result := Matrix(m0: right.x, m4: up.x, m8: forward_.x, m12: translation.x, m1: right.y, m5: up.y, m9: forward_.y, m13: translation.y, m2: right.z, m6: up.z, m10: forward_.z, m14: translation.z, m3: 0.0f, m7: 0.0f, m11: 0.0f, m15: 1.0f);
  return result;
