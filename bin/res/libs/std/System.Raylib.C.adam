public routine cpplink Clamp(const value: float32; const min: float32; const max: float32): float32;
var
  result: float32;
begin
  result := ((value < min) ? min : value);
  if (result > max) then
    result := max;
  end;
  return result;
end;

public routine cpplink Lerp(const start: float32; const end_: float32;
  const amount: float32): float32;
var
  result: float32;
begin
  result := (start + (amount * (end_ - start)));
  return result;
end;

public routine cpplink Normalize(const value: float32; const start: float32;
  const end_: float32): float32;
var
  result: float32;
begin
  result := ((value - start) / (end_ - start));
  return result;
end;

public routine cpplink Remap(const value: float32; const inputStart: float32;
  const inputEnd: float32; const outputStart: float32; const outputEnd: float32): float32;
var
  result: float32;
begin
  result := ((((value - inputStart) / (inputEnd - inputStart)) * (outputEnd - outputStart)) + outputStart);
  return result;
end;

public routine cpplink Wrap(const value: float32; const min: float32; const max: float32): float32;
var
  result: float32;
begin
  result := (value - ((max - min) * floorf(((value - min) / (max - min)))));
  return result;
end;

public routine cpplink FloatEquals(const x: float32; const y: float32): int32;
var
  result: int32;
begin
  result := int32((fabsf((x - y)) <= (9.999999974752427e-07f * fmaxf(1.0f, fmaxf(fabsf(x), fabsf(y))))));
  return result;
end;

public routine cpplink Vector2Zero(): Vector2;
var
  result: Vector2;
begin
  result := Vector2(x: 0.0f, y: 0.0f);
  return result;
end;

public routine cpplink Vector2One(): Vector2;
var
  result: Vector2;
begin
  result := Vector2(x: 1.0f, y: 1.0f);
  return result;
end;

public routine cpplink Vector2Add(const v1: Vector2; const v2: Vector2): Vector2;
var
  result: Vector2;
begin
  result := Vector2(x: (v1.x + v2.x), y: (v1.y + v2.y));
  return result;
end;

public routine cpplink Vector2AddValue(const v: Vector2; const add: float32): Vector2;
var
  result: Vector2;
begin
  result := Vector2(x: (v.x + add), y: (v.y + add));
  return result;
end;

public routine cpplink Vector2Subtract(const v1: Vector2; const v2: Vector2): Vector2;
var
  result: Vector2;
begin
  result := Vector2(x: (v1.x - v2.x), y: (v1.y - v2.y));
  return result;
end;

public routine cpplink Vector2SubtractValue(const v: Vector2; const sub: float32): Vector2;
var
  result: Vector2;
begin
  result := Vector2(x: (v.x - sub), y: (v.y - sub));
  return result;
end;

public routine cpplink Vector2Length(const v: Vector2): float32;
var
  result: float32;
begin
  result := sqrtf(((v.x * v.x) + (v.y * v.y)));
  return result;
end;

public routine cpplink Vector2LengthSqr(const v: Vector2): float32;
var
  result: float32;
begin
  result := ((v.x * v.x) + (v.y * v.y));
  return result;
end;

public routine cpplink Vector2DotProduct(const v1: Vector2; const v2: Vector2): float32;
var
  result: float32;
begin
  result := ((v1.x * v2.x) + (v1.y * v2.y));
  return result;
end;

public routine cpplink Vector2CrossProduct(const v1: Vector2; const v2: Vector2): float32;
var
  result: float32;
begin
  result := ((v1.x * v2.y) - (v1.y * v2.x));
  return result;
end;

public routine cpplink Vector2Distance(const v1: Vector2; const v2: Vector2): float32;
var
  result: float32;
begin
  result := sqrtf((((v1.x - v2.x) * (v1.x - v2.x)) + ((v1.y - v2.y) * (v1.y - v2.y))));
  return result;
end;

public routine cpplink Vector2DistanceSqr(const v1: Vector2; const v2: Vector2): float32;
var
  result: float32;
begin
  result := (((v1.x - v2.x) * (v1.x - v2.x)) + ((v1.y - v2.y) * (v1.y - v2.y)));
  return result;
end;

public routine cpplink Vector2Angle(const v1: Vector2; const v2: Vector2): float32;
var
  result: float32;
  dot: float32;
  det: float32;
begin
  result := 0.0f;
  dot := ((v1.x * v2.x) + (v1.y * v2.y));
  det := ((v1.x * v2.y) - (v1.y * v2.x));
  result := atan2f(det, dot);
  return result;
end;

public routine cpplink Vector2LineAngle(const start: Vector2; const end_: Vector2): float32;
var
  result: float32;
begin
  result := 0.0f;
  result := (-atan2f((end_.y - start.y), (end_.x - start.x)));
  return result;
end;

public routine cpplink Vector2Scale(const v: Vector2; const scale: float32): Vector2;
var
  result: Vector2;
begin
  result := Vector2(x: (v.x * scale), y: (v.y * scale));
  return result;
end;

public routine cpplink Vector2Multiply(const v1: Vector2; const v2: Vector2): Vector2;
var
  result: Vector2;
begin
  result := Vector2(x: (v1.x * v2.x), y: (v1.y * v2.y));
  return result;
end;

public routine cpplink Vector2Negate(const v: Vector2): Vector2;
var
  result: Vector2;
begin
  result := Vector2(x: (-v.x), y: (-v.y));
  return result;
end;

public routine cpplink Vector2Divide(const v1: Vector2; const v2: Vector2): Vector2;
var
  result: Vector2;
begin
  result := Vector2(x: (v1.x / v2.x), y: (v1.y / v2.y));
  return result;
end;

public routine cpplink Vector2Normalize(const v: Vector2): Vector2;
var
  result: Vector2;
  length: float32;
  ilength: float32;
begin
  result := Vector2(x: 0.0f);
  length := sqrtf(((v.x * v.x) + (v.y * v.y)));
  if (length > 0.0f) then
    ilength := (1.0f / length);
    result.x := (v.x * ilength);
    result.y := (v.y * ilength);
  end;
  return result;
end;

public routine cpplink Vector2Transform(const v: Vector2; const mat: Matrix): Vector2;
var
  result: Vector2;
  x: float32;
  y: float32;
  z: float32;
begin
  result := Vector2(x: 0.0f);
  x := v.x;
  y := v.y;
  z := 0.0f;
  result.x := ((((mat.m0 * x) + (mat.m4 * y)) + (mat.m8 * z)) + mat.m12);
  result.y := ((((mat.m1 * x) + (mat.m5 * y)) + (mat.m9 * z)) + mat.m13);
  return result;
end;

public routine cpplink Vector2Lerp(const v1: Vector2; const v2: Vector2;
