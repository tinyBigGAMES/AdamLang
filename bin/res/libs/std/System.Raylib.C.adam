  b10 := ((a21 * a33) - (a23 * a31));
  b11 := ((a22 * a33) - (a23 * a32));
  invDet := (1.0f / ((((((b00 * b11) - (b01 * b10)) + (b02 * b09)) + (b03 * b08)) - (b04 * b07)) + (b05 * b06)));
