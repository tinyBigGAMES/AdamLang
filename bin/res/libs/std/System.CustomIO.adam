-------------------------------------------------------------------------------
  System.CustomIO.adam - streams in the style of SDL3's custom IO (PaskalCPP's
  CustomIO). An IO is a stream behind a table of callbacks (an IOInterface:
  Read, Write, Seek, Tell, Size, Flush, Close, Truncate), so a routine that
  takes an IO reads memory, a file or anything a program writes itself:
  CreateIO(AInterface, AUserData) makes an IO from any interface. The IO
  routines (IORead, IOWrite, IOSeek, IOTell, IOSize, IOFlush, IOTruncate,
  IOClose, IOStatus) call through the table and keep the stream's state: a
  callback left nil is a clean failure, never a crash; IOCanWrite / IOCanSeek
  say up front whether the stream can write / move. IOReadFull /
  IOWriteFull move a count through any short reads or writes a stream gives;
  IOReadAll reads a stream to its end into a string; IOSameContent compares
  two streams to their ends; IOCopy copies one stream to its end into another.

  CreateMemoryIO makes an IO over the caller's memory (read-only, or read /
  write within its size) or over a buffer of its own that grows as it is
  written. CreateFileIO makes an IO over a file opened in one of C's fopen
  modes (FileMode), its path UTF-8: `$P:` (either case) the folder of the
  program's exe, `$D:` and `$S:` the working folder.

  An IOSource opens IOs by path (SDL3's storage, read side), so a format with
  several files opens its siblings through the source it came from: an
  IOSourceInterface of callbacks behind CreateIOSource, used through
  IOSourceOpen, IOSourceExists, IOSourceSize, IOSourceRemove,
  IOSourceCanRemove and IOSourceClose, which check and normalize every path
  (relative, `/` separated, no `..` above the root) before a callback sees
  it. CreateFolderIOSource makes a source over a folder.

  CreateZipIOSource makes a read-only source over a zip archive read through
  an IO or a file: its central directory is read once (ZIP64, stored and
  deflated entries, ZipCrypto, names in UTF-8, CP437 or the Info-ZIP Unicode
  Path field) and each entry opens as a read-only IO that seeks without
  reading from the start again. CreateZipFileIO opens one entry of an
  archive; GetZipEntryInfo reads an entry's size and CRC-32 without opening
  it. minizip (System.Minizip.C) reads the archive through the IO, zlib
  (System.Zlib.C) inflates in place, ZipCrypto is decrypted here.

  Target-neutral: files and folders through System.Runtime's file-handle and
  path routines, no OS named. Outside the compiler's dependency path (not in
  the shared subset, DESIGN sec 10): it takes `addr of`.
*******************************************************************************/

module unit System.CustomIO;

import System.SysUtils, System.Runtime, System.Zlib.C, System.Minizip.C;

public type
  // The state of an IO after its last operation, read with IOStatus. A short count from
  // IORead / IOWrite says why here: Eof (no more to read), Error, ReadOnly (the IO cannot
  // write), WriteOnly (it cannot read), NotReady (a non-blocking source has nothing yet)
  IOState = choices(Ready, Error, Eof, NotReady, ReadOnly, WriteOnly);

  // Where IOSeek counts its offset from
  SeekOrigin = choices(FromStart, FromCurrent, FromEnd);

  // How CreateFileIO opens its file, by C's fopen rules: Read ("rb") the file must exist,
  // read-only; Write ("wb") created or emptied, write-only; ReadWrite ("r+b") the file must
  // exist, kept, read and write; Append ("ab") created when missing, write-only, every write
  // lands at the end whatever the position
  FileMode = choices(Read, Write, ReadWrite, Append);

  // The callbacks of an IOInterface. Each takes the user pointer given to CreateIO. Read /
  // Write move up to ASize bytes and return the count moved; a short count sets AState (Eof,
  // Error, NotReady), which comes in as Ready. Seek returns the new position or -1; Tell the
  // position or -1; Size the size in bytes or -1 when the stream has none. Flush writes out
  // anything buffered (false on failure, AState says why). Close releases the stream's own
  // resources (false when that failed). Truncate sets the size to ASize bytes (>= 0):
  // shorter drops the tail, longer adds zero bytes (false on failure, AState says why)
  IOReadCallback = func(const AUserData: ptr; const ABuffer: ptr; const ASize: int64;
    var AState: IOState): int64;
  IOWriteCallback = func(const AUserData: ptr; const ABuffer: ptr to const; const ASize: int64;
    var AState: IOState): int64;
  IOSeekCallback = func(const AUserData: ptr; const AOffset: int64;
    const AOrigin: SeekOrigin): int64;
  IOTellCallback = func(const AUserData: ptr): int64;
  IOSizeCallback = func(const AUserData: ptr): int64;
  IOFlushCallback = func(const AUserData: ptr; var AState: IOState): bool;
  IOCloseCallback = func(const AUserData: ptr): bool;
  IOTruncateCallback = func(const AUserData: ptr; const ASize: int64;
    var AState: IOState): bool;

  // The table of callbacks behind an IO (SDL3's SDL_IOStreamInterface). Fill the routines
  // the stream supports and leave the rest nil: the IO routines turn a nil callback into a
  // failure with the state set. Truncate is optional: a stream that cannot change its size
  // leaves it nil
  IOInterface = record
    Read: IOReadCallback;
    Write: IOWriteCallback;
    Seek: IOSeekCallback;
    Tell: IOTellCallback;
    Size: IOSizeCallback;
    Flush: IOFlushCallback;
    Close: IOCloseCallback;
    Truncate: IOTruncateCallback;
  end;

  // What an IO points at: the callbacks CreateIO was given, the user pointer every callback
  // receives, the state after the last operation. Reach it only through the IO routines
  IOStream = record
    Callbacks: IOInterface;
    UserData: ptr;
    State: IOState;
  end;

  // A stream: made by CreateIO or a Create*IO routine, used through the IO routines, ended
  // with IOClose. nil is no stream (a Create* that failed)
  IO = ptr to IOStream;

  // The callbacks of an IOSourceInterface. Each takes the user pointer given to
  // CreateIOSource and an entry path already in canonical form (relative, `/` separated, no
  // `.` or `..`). Open returns the entry's IO in AMode, or nil (missing, or a mode the source
  // does not offer); Exists is true when the entry exists and can be opened (a folder is not
  // one); Size is the entry's size in bytes or -1 when it does not exist; Close releases the
  // source's own resources (false when that failed; IOs already opened stay valid until their
  // own IOClose); Remove deletes the entry (false when it does not exist or the source
  // refuses)
  IOSourceOpenCallback = func(const AUserData: ptr; const APath: string;
    const AMode: FileMode): IO;
  IOSourceExistsCallback = func(const AUserData: ptr; const APath: string): bool;
  IOSourceSizeCallback = func(const AUserData: ptr; const APath: string): int64;
  IOSourceCloseCallback = func(const AUserData: ptr): bool;
  IOSourceRemoveCallback = func(const AUserData: ptr; const APath: string): bool;

  // The table of callbacks behind an IOSource (SDL3's SDL_StorageInterface, read side): a
  // source opens IOs by path, so a format with several files (a glTF and its .bin, an .obj
  // and its .mtl) opens its siblings through the source it came from. The IOSource routines
  // check and normalize a path before any callback sees it. Leave a callback nil when the
  // source has no such operation; Remove is optional (nil: the source deletes nothing, as a
  // read-only one)
  IOSourceInterface = record
    Open: IOSourceOpenCallback;
    Exists: IOSourceExistsCallback;
    Size: IOSourceSizeCallback;
    Close: IOSourceCloseCallback;
    Remove: IOSourceRemoveCallback;
  end;

  // What an IOSource points at: the callbacks CreateIOSource was given and the user pointer
  // every callback receives. Reach it only through the IOSource routines
  IOSourceRecord = record
    Callbacks: IOSourceInterface;
    UserData: ptr;
  end;

  // A source of IOs by path: made by CreateIOSource or a Create*IOSource routine, used
  // through the IOSource routines, ended with IOSourceClose. nil is no source (a Create*
  // that failed)
  IOSource = ptr to IOSourceRecord;

const
  // The bytes IOReadAll and IOCopy move per step (their chunk arrays are 0..65535), and the
  // bytes IOSameContent compares per step (its arrays are 0..4095)
  ADAM_CUSTOMIO_CHUNK: int64 = 65536;
  ADAM_CUSTOMIO_COMPARE: int64 = 4096;
  // An owned memory block's first capacity, and the capacity past which doubling would
  // overflow (2^62 - 1): past it a block grows to exactly what is needed
  ADAM_CUSTOMIO_GROW_START: int64 = 256;
  ADAM_CUSTOMIO_GROW_LIMIT: int64 = 4611686018427387903;
  // The largest int64: a position plus a count past it is no room at all
  ADAM_CUSTOMIO_INT64_MAX: int64 = 9223372036854775807;
  // A zip entry under ADAM_CUSTOMIO_ZIP_WHOLE_LIMIT bytes is read whole when opened. A
  // deflated entry read in place keeps an access point about every ADAM_CUSTOMIO_ZIP_SPAN
  // output bytes, an encrypted stored one every ADAM_CUSTOMIO_ZIP_KEY_SPAN; the archive gives
  // ADAM_CUSTOMIO_ZIP_CHUNK compressed bytes per step; a deflate point remembers
  // ADAM_CUSTOMIO_ZIP_WINDOW bytes of output (deflate's window); the ZipCrypto header in
  // front of an encrypted entry's data is ADAM_CUSTOMIO_ZIP_CRYPT_HEADER bytes; zlib's crc32
  // takes a 32-bit count, so it is handed at most ADAM_CUSTOMIO_ZIP_CRC_PIECE bytes at once
  ADAM_CUSTOMIO_ZIP_WHOLE_LIMIT: int64 = 262144;
  ADAM_CUSTOMIO_ZIP_SPAN: int64 = 1048576;
  ADAM_CUSTOMIO_ZIP_KEY_SPAN: int64 = 65536;
  ADAM_CUSTOMIO_ZIP_CHUNK: int64 = 16384;
  ADAM_CUSTOMIO_ZIP_WINDOW: int64 = 32768;
  ADAM_CUSTOMIO_ZIP_CRYPT_HEADER: int64 = 12;
  ADAM_CUSTOMIO_ZIP_CRC_PIECE: int64 = 1073741824;
  // The zip writer reads its files ADAM_CUSTOMIO_ZIP_WRITE_CHUNK bytes per step (the progress
  // routine's steps); an entry whose name holds a byte of 0x80 or above gets general purpose
  // bit 11, ADAM_CUSTOMIO_ZIP_UTF8_FLAG (the name is UTF-8); a file of
  // ADAM_CUSTOMIO_ZIP64_LIMIT bytes or more is written as ZIP64
  ADAM_CUSTOMIO_ZIP_WRITE_CHUNK: int64 = 65536;
  ADAM_CUSTOMIO_ZIP_UTF8_FLAG: uint32 = 2048;
  ADAM_CUSTOMIO_ZIP64_LIMIT: int64 = 4294967295;
  // CP437's characters 0x80 .. 0xFF as Unicode code points, indexed by the byte (a name
  // without the UTF-8 flag is CP437, APPNOTE appendix D; the values are Python's cp437 codec)
  ADAM_CUSTOMIO_ZIP_CP437: array[128..255] of uint32 = [
    0x00C7, 0x00FC, 0x00E9, 0x00E2, 0x00E4, 0x00E0, 0x00E5, 0x00E7,
    0x00EA, 0x00EB, 0x00E8, 0x00EF, 0x00EE, 0x00EC, 0x00C4, 0x00C5,
    0x00C9, 0x00E6, 0x00C6, 0x00F4, 0x00F6, 0x00F2, 0x00FB, 0x00F9,
    0x00FF, 0x00D6, 0x00DC, 0x00A2, 0x00A3, 0x00A5, 0x20A7, 0x0192,
    0x00E1, 0x00ED, 0x00F3, 0x00FA, 0x00F1, 0x00D1, 0x00AA, 0x00BA,
    0x00BF, 0x2310, 0x00AC, 0x00BD, 0x00BC, 0x00A1, 0x00AB, 0x00BB,
    0x2591, 0x2592, 0x2593, 0x2502, 0x2524, 0x2561, 0x2562, 0x2556,
    0x2555, 0x2563, 0x2551, 0x2557, 0x255D, 0x255C, 0x255B, 0x2510,
    0x2514, 0x2534, 0x252C, 0x251C, 0x2500, 0x253C, 0x255E, 0x255F,
    0x255A, 0x2554, 0x2569, 0x2566, 0x2560, 0x2550, 0x256C, 0x2567,
    0x2568, 0x2564, 0x2565, 0x2559, 0x2558, 0x2552, 0x2553, 0x256B,
    0x256A, 0x2518, 0x250C, 0x2588, 0x2584, 0x258C, 0x2590, 0x2580,
    0x03B1, 0x00DF, 0x0393, 0x03C0, 0x03A3, 0x03C3, 0x00B5, 0x03C4,
    0x03A6, 0x0398, 0x03A9, 0x03B4, 0x221E, 0x03C6, 0x03B5, 0x2229,
    0x2261, 0x00B1, 0x2265, 0x2264, 0x2320, 0x2321, 0x00F7, 0x2248,
    0x00B0, 0x2219, 0x00B7, 0x221A, 0x207F, 0x00B2, 0x25A0, 0x00A0
  ];

type
  // A memory IO's user data. Caller memory: Capacity = DataSize at first, never grows.
  // Owned: the block grows (doubling) as writes pass its end, and IOClose frees it
  MemoryData = record
    Data: ptr to uint8;
    DataSize: int64;
    Capacity: int64;
    Position: int64;
    Owned: bool;
  end;

  // A file IO's user data: the runtime's file handle, and whether every write lands at the
  // end (FileMode.Append, C's "a": the end is sought before each write)
  FileData = record
    Handle: uint64;
    Append: bool;
  end;

  // A folder source's user data: the folder every entry path is relative to (create /
  // destroy build and free it, its string released with it)
  FolderData = record
    Root: string;
  end;

// ACount zero bytes at ADest
func DoZero(const ADest: ptr to uint8; const ACount: int64);
var
  LI: int64;
begin
  for LI := 0 to ACount - 1 do
    ADest[LI] := 0;
  end;
end;

// True when the ACount bytes at ALeft and ARight are the same
func DoSameBytes(const ALeft: ptr to const uint8; const ARight: ptr to const uint8;
  const ACount: int64): bool;
var
  LI: int64;
begin
  for LI := 0 to ACount - 1 do
    if ALeft[LI] <> ARight[LI] then
      return false;
    end;
  end;
  return true;
end;

// The ACount bytes at ABytes added to the end of AData
func DoAppendBytes(var AData: string; const ABytes: ptr to const uint8; const ACount: int64);
var
  LOld: int64;
  LI: int64;
begin
  if ACount <= 0 then
    return;
  end;
  LOld := len(AData);
  setlength(AData, LOld + ACount);
  for LI := 0 to ACount - 1 do
    AData[LOld + LI] := char(ABytes[LI]);
  end;
end;

// Makes an IO from a table of callbacks and the user pointer they receive (SDL3's
// SDL_OpenIO). The interface is copied; the user pointer is the caller's and is never freed
// by the IO (its Close callback may free it). The new IO's state is Ready; nil when there is
// no room
public func cpplink CreateIO(const AInterface: IOInterface; const AUserData: ptr): IO;
var
  LIO: IO;
begin
  create(LIO);
  if LIO = nil then
    return nil;
  end;
  LIO->Callbacks := AInterface;
  LIO->UserData := AUserData;
  LIO->State := IOState.Ready;
  return LIO;
end;

// Reads up to ASize bytes into ABuffer: the count read, 0 to ASize (0 for a nil IO or ASize
// 0 or less). A short count means the end, an error or no data yet: IOStatus tells which
// (Eof, Error, NotReady, or WriteOnly when the IO cannot read)
public func cpplink IORead(const AIO: IO; const ABuffer: ptr; const ASize: int64): int64;
var
  LRead: IOReadCallback;
  LCount: int64;
begin
  if AIO = nil then
    return 0;
  end;
  if ASize <= 0 then
    return 0;
  end;
  if ABuffer = nil then
    AIO->State := IOState.Error;
    return 0;
  end;
  LRead := AIO->Callbacks.Read;
  if LRead = nil then
    AIO->State := IOState.WriteOnly;
    return 0;
  end;
  AIO->State := IOState.Ready;
  LCount := LRead(AIO->UserData, ABuffer, ASize, AIO->State);
  // A callback outside 0 .. ASize broke its contract: an error, held in range
  if LCount < 0 then
    AIO->State := IOState.Error;
    return 0;
  end;
  if LCount > ASize then
    AIO->State := IOState.Error;
    return ASize;
  end;
  // A short read the callback did not explain is the end of the stream
  if (LCount < ASize) and (AIO->State = IOState.Ready) then
    AIO->State := IOState.Eof;
  end;
  return LCount;
end;

// Writes up to ASize bytes from ABuffer: the count written, 0 to ASize (0 for a nil IO or
// ASize 0 or less). A short count means an error or no room yet: IOStatus tells which
// (Error, NotReady, or ReadOnly when the IO cannot write)
public func cpplink IOWrite(const AIO: IO; const ABuffer: ptr to const; const ASize: int64): int64;
var
  LWrite: IOWriteCallback;
  LCount: int64;
begin
  if AIO = nil then
    return 0;
  end;
  if ASize <= 0 then
    return 0;
  end;
  if ABuffer = nil then
    AIO->State := IOState.Error;
    return 0;
  end;
  LWrite := AIO->Callbacks.Write;
  if LWrite = nil then
    AIO->State := IOState.ReadOnly;
    return 0;
  end;
  AIO->State := IOState.Ready;
  LCount := LWrite(AIO->UserData, ABuffer, ASize, AIO->State);
  if LCount < 0 then
    AIO->State := IOState.Error;
    return 0;
  end;
  if LCount > ASize then
    AIO->State := IOState.Error;
    return ASize;
  end;
  // A short write the callback did not explain is an error
  if (LCount < ASize) and (AIO->State = IOState.Ready) then
    AIO->State := IOState.Error;
  end;
  return LCount;
end;

// Moves the stream's position to AOffset counted from AOrigin: the new position, or -1
// (state Error) when it cannot move there. A move that succeeds sets the state Ready (an Eof
// is over)
public func cpplink IOSeek(const AIO: IO; const AOffset: int64; const AOrigin: SeekOrigin): int64;
var
  LSeek: IOSeekCallback;
  LPosition: int64;
begin
  if AIO = nil then
    return -1;
  end;
  LSeek := AIO->Callbacks.Seek;
  if LSeek = nil then
    AIO->State := IOState.Error;
    return -1;
  end;
  LPosition := LSeek(AIO->UserData, AOffset, AOrigin);
  if LPosition < 0 then
    AIO->State := IOState.Error;
    return -1;
  end;
  AIO->State := IOState.Ready;
  return LPosition;
end;

// The stream's current position, or -1 when the IO has none (state Error)
public func cpplink IOTell(const AIO: IO): int64;
var
  LTell: IOTellCallback;
  LPosition: int64;
begin
  if AIO = nil then
    return -1;
  end;
  LTell := AIO->Callbacks.Tell;
  if LTell = nil then
    AIO->State := IOState.Error;
    return -1;
  end;
  LPosition := LTell(AIO->UserData);
  if LPosition < 0 then
    AIO->State := IOState.Error;
    return -1;
  end;
  return LPosition;
end;

// The stream's size in bytes, or -1 when it has none (a pipe, a nil IO)
public func cpplink IOSize(const AIO: IO): int64;
var
  LSizeOf: IOSizeCallback;
  LSize: int64;
begin
  if AIO = nil then
    return -1;
  end;
  LSizeOf := AIO->Callbacks.Size;
  if LSizeOf = nil then
    return -1;
  end;
  LSize := LSizeOf(AIO->UserData);
  if LSize < 0 then
    return -1;
  end;
  return LSize;
end;

// Writes out anything the stream has buffered: true when flushed (or nothing to flush: an IO
// with no Flush callback), false on failure
public func cpplink IOFlush(const AIO: IO): bool;
var
  LFlush: IOFlushCallback;
  LOk: bool;
begin
  if AIO = nil then
    return false;
  end;
  LFlush := AIO->Callbacks.Flush;
  if LFlush = nil then
    return true;
  end;
  AIO->State := IOState.Ready;
  LOk := LFlush(AIO->UserData, AIO->State);
  if (not LOk) and (AIO->State = IOState.Ready) then
    AIO->State := IOState.Error;
  end;
  return LOk;
end;

// Sets the stream's size to ASize bytes, as ftruncate does: shorter drops the tail, longer
// adds zero bytes. A stream that cannot write cannot change its size (state ReadOnly); one
// without a Truncate callback cannot either (state Error). Where the position lands is the
// stream's rule: a file IO keeps it (it may then lie past the end, as with fseek); a memory
// IO, which never sits past its end, moves back to the new end. False for a nil IO, a
// negative size (state Error) or a refused or failed change (IOStatus tells which)
public func cpplink IOTruncate(const AIO: IO; const ASize: int64): bool;
var
  LTruncate: IOTruncateCallback;
  LOk: bool;
begin
  if AIO = nil then
    return false;
  end;
  if ASize < 0 then
    AIO->State := IOState.Error;
    return false;
  end;
  if AIO->Callbacks.Write = nil then
    AIO->State := IOState.ReadOnly;
    return false;
  end;
  LTruncate := AIO->Callbacks.Truncate;
  if LTruncate = nil then
    AIO->State := IOState.Error;
    return false;
  end;
  AIO->State := IOState.Ready;
  LOk := LTruncate(AIO->UserData, ASize, AIO->State);
  if (not LOk) and (AIO->State = IOState.Ready) then
    AIO->State := IOState.Error;
  end;
  return LOk;
end;

// Ends the stream: calls its Close callback, then frees the IO, which is gone afterwards
// whatever the result. False for a nil IO or when the Close callback failed
public func cpplink IOClose(const AIO: IO): bool;
var
  LClose: IOCloseCallback;
  LOk: bool;
  LStream: IO;
begin
  if AIO = nil then
    return false;
  end;
  LOk := true;
  LClose := AIO->Callbacks.Close;
  if LClose <> nil then
    LOk := LClose(AIO->UserData);
  end;
  // destroy writes nil into its variable, so the const parameter goes through a local
  LStream := AIO;
  destroy(LStream);
  return LOk;
end;

// The state after the stream's last operation: why a count came up short (Error for a nil IO)
public func cpplink IOStatus(const AIO: IO): IOState;
begin
  if AIO = nil then
    return IOState.Error;
  end;
  return AIO->State;
end;

// True when the stream can write (it has a Write callback), so a caller can refuse up front
// what IOWrite would not do later, as an open for writing refuses a read-only file (a
// read-only memory IO, a Read file IO, a zip entry cannot); false for a nil IO
public func cpplink IOCanWrite(const AIO: IO): bool;
begin
  if AIO = nil then
    return false;
  end;
  return AIO->Callbacks.Write <> nil;
end;

// True when the stream can move (it has a Seek callback): one without (a pipe, a socket, a
// generator's output) reads and writes only at its own place, as a pipe does; false for a
// nil IO
public func cpplink IOCanSeek(const AIO: IO): bool;
begin
  if AIO = nil then
    return false;
  end;
  return AIO->Callbacks.Seek <> nil;
end;

// Reads ASize bytes into ABuffer, calling IORead until they are all in or a read gives
// nothing (the end, an error, a non-blocking source with nothing yet): a stream may answer
// one IORead with fewer bytes than it has. The count read: ASize, or fewer when the stream
// stopped first (IOStatus says why); 0 for a nil IO or ASize 0 or less
public func cpplink IOReadFull(const AIO: IO; const ABuffer: ptr; const ASize: int64): int64;
var
  LBytes: ptr to uint8;
  LDone: int64;
  LGot: int64;
begin
  if (AIO = nil) or (ASize <= 0) then
    return 0;
  end;
  LBytes := ptr to uint8(ABuffer);
  LDone := 0;
  while LDone < ASize do
    LGot := IORead(AIO, ptr(LBytes + LDone), ASize - LDone);
    if LGot <= 0 then
      return LDone;
    end;
    LDone := LDone + LGot;
  end;
  return LDone;
end;

// Writes ASize bytes from ABuffer, calling IOWrite until they are all out or a write takes
// nothing (an error, a full or non-blocking stream). The count written: ASize, or fewer when
// the stream stopped first (IOStatus says why); 0 for a nil IO or ASize 0 or less
public func cpplink IOWriteFull(const AIO: IO; const ABuffer: ptr to const; const ASize: int64): int64;
var
  LBytes: ptr to const uint8;
  LDone: int64;
  LPut: int64;
begin
  if (AIO = nil) or (ASize <= 0) then
    return 0;
  end;
  LBytes := ptr to const uint8(ABuffer);
  LDone := 0;
  while LDone < ASize do
    LPut := IOWrite(AIO, LBytes + LDone, ASize - LDone);
    if LPut <= 0 then
      return LDone;
    end;
    LDone := LDone + LPut;
  end;
  return LDone;
end;

// Reads a stream from where it stands to its end into AData, as bytes (a string holds any
// bytes, zeros included). A stream with a size reads exactly the rest; one without (IOSize
// -1) reads in chunks until its end. True when the stream was read to its end; false (AData
// "") for a nil IO or a read that failed (state Error) or stopped short of the end
public func cpplink IOReadAll(const AIO: IO; var AData: string): bool;
var
  LChunk: array[0..65535] of uint8;
  LSize: int64;
  LPosition: int64;
  LRest: int64;
  LDone: int64;
  LWant: int64;
  LGot: int64;
  LI: int64;
begin
  AData := "";
  if AIO = nil then
    return false;
  end;
  LSize := IOSize(AIO);
  LPosition := IOTell(AIO);
  if (LSize >= 0) and (LPosition >= 0) and (LSize >= LPosition) then
    // The rest of a sized stream: the string sized once, filled chunk by chunk
    LRest := LSize - LPosition;
    setlength(AData, LRest);
    LDone := 0;
    while LDone < LRest do
      LWant := LRest - LDone;
      if LWant > ADAM_CUSTOMIO_CHUNK then
        LWant := ADAM_CUSTOMIO_CHUNK;
      end;
      LGot := IOReadFull(AIO, ptr(addr of LChunk[0]), LWant);
      if LGot <> LWant then
        AData := "";
        return false;
      end;
      for LI := 0 to LGot - 1 do
        AData[LDone + LI] := char(LChunk[LI]);
      end;
      LDone := LDone + LGot;
    end;
    return true;
  end;
  // No size: chunks until the stream says it ended
  while true do
    LGot := IOReadFull(AIO, ptr(addr of LChunk[0]), ADAM_CUSTOMIO_CHUNK);
    DoAppendBytes(AData, addr of LChunk[0], LGot);
    if LGot < ADAM_CUSTOMIO_CHUNK then
      if IOStatus(AIO) = IOState.Eof then
        return true;
      end;
      AData := "";
      return false;
    end;
  end;
end;

// True when two streams hold the same bytes from where each stands to its end (both are read
// to the end; their positions move); false when they differ, either is nil, or either fails
// a read before its end
public func cpplink IOSameContent(const ALeft: IO; const ARight: IO): bool;
var
  LLeft: array[0..4095] of uint8;
  LRight: array[0..4095] of uint8;
  LGotLeft: int64;
  LGotRight: int64;
begin
  if (ALeft = nil) or (ARight = nil) then
    return false;
  end;
  while true do
    LGotLeft := IOReadFull(ALeft, ptr(addr of LLeft[0]), ADAM_CUSTOMIO_COMPARE);
    LGotRight := IOReadFull(ARight, ptr(addr of LRight[0]), ADAM_CUSTOMIO_COMPARE);
    if LGotLeft <> LGotRight then
      return false;
    end;
    if LGotLeft < ADAM_CUSTOMIO_COMPARE then
      // The end of both, or a failed read on both: only the end is the same
      if (IOStatus(ALeft) = IOState.Error) or (IOStatus(ARight) = IOState.Error) then
        return false;
      end;
      return DoSameBytes(addr of LLeft[0], addr of LRight[0], LGotLeft);
    end;
    if not DoSameBytes(addr of LLeft[0], addr of LRight[0], ADAM_CUSTOMIO_COMPARE) then
      return false;
    end;
  end;
end;

// Copies a stream from where it stands to its end into another, where that one stands, in
// chunks (a stream of any size, sized or not; both positions move). The bytes copied; -1 when
// either is nil, a read failed (state Error) or a write stopped short (the bytes written up
// to there stay in ADest)
public func cpplink IOCopy(const ASource: IO; const ADest: IO): int64;
var
  LChunk: array[0..65535] of uint8;
  LGot: int64;
  LTotal: int64;
begin
  if (ASource = nil) or (ADest = nil) then
    return -1;
  end;
  LTotal := 0;
  while true do
    LGot := IOReadFull(ASource, ptr(addr of LChunk[0]), ADAM_CUSTOMIO_CHUNK);
    if LGot > 0 then
      if IOWriteFull(ADest, ptr(addr of LChunk[0]), LGot) <> LGot then
        return -1;
      end;
    end;
    LTotal := LTotal + LGot;
    if LGot < ADAM_CUSTOMIO_CHUNK then
      // A short chunk is the end, or a read that failed before it
      if IOStatus(ASource) = IOState.Error then
        return -1;
      end;
      return LTotal;
    end;
  end;
end;

// Grows an owned memory block to hold at least ANeeded bytes (doubling from
// ADAM_CUSTOMIO_GROW_START); false when there is no room
func MemoryGrow(const AMemory: ptr to MemoryData; const ANeeded: int64): bool;
var
  LCapacity: int64;
  LBlock: ptr;
begin
  LCapacity := AMemory->Capacity;
  if LCapacity < ADAM_CUSTOMIO_GROW_START then
    LCapacity := ADAM_CUSTOMIO_GROW_START;
  end;
  while LCapacity < ANeeded do
    // Doubling stops short of overflow: past the limit take exactly what is needed
    if LCapacity > ADAM_CUSTOMIO_GROW_LIMIT then
      LCapacity := ANeeded;
    else
      LCapacity := LCapacity * 2;
    end;
  end;
  if AMemory->Data = nil then
    LBlock := getmem(LCapacity);
  else
    LBlock := resizemem(ptr(AMemory->Data), LCapacity);
  end;
  if LBlock = nil then
    return false;
  end;
  AMemory->Data := ptr to uint8(LBlock);
  AMemory->Capacity := LCapacity;
  return true;
end;

func MemoryRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64;
  var AState: IOState): int64;
var
  LMemory: ptr to MemoryData;
  LCount: int64;
begin
  LMemory := ptr to MemoryData(AUserData);
  LCount := LMemory->DataSize - LMemory->Position;
  if LCount > ASize then
    LCount := ASize;
  end;
  if LCount <= 0 then
    AState := IOState.Eof;
    return 0;
  end;
  CopyBytes(ptr to uint8(ABuffer), LMemory->Data + LMemory->Position, LCount);
  LMemory->Position := LMemory->Position + LCount;
  if LCount < ASize then
    AState := IOState.Eof;
  end;
  return LCount;
end;

func MemoryWrite(const AUserData: ptr; const ABuffer: ptr to const; const ASize: int64;
  var AState: IOState): int64;
var
  LMemory: ptr to MemoryData;
  LCount: int64;
begin
  LMemory := ptr to MemoryData(AUserData);
  LCount := ASize;
  // Position + ASize past int64 is no room at all
  if LCount > ADAM_CUSTOMIO_INT64_MAX - LMemory->Position then
    AState := IOState.Error;
    return 0;
  end;
  if LMemory->Position + LCount > LMemory->Capacity then
    if LMemory->Owned then
      if not MemoryGrow(LMemory, LMemory->Position + LCount) then
        AState := IOState.Error;
        return 0;
      end;
    else
      // Caller memory never grows: write what fits
      LCount := LMemory->Capacity - LMemory->Position;
    end;
  end;
  if LCount <= 0 then
    AState := IOState.Error;
    return 0;
  end;
  CopyBytes(LMemory->Data + LMemory->Position, ptr to const uint8(ABuffer), LCount);
  LMemory->Position := LMemory->Position + LCount;
  if LMemory->Position > LMemory->DataSize then
    LMemory->DataSize := LMemory->Position;
  end;
  if LCount < ASize then
    AState := IOState.Error;
  end;
  return LCount;
end;

func MemorySeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
var
  LMemory: ptr to MemoryData;
  LBase: int64;
begin
  LMemory := ptr to MemoryData(AUserData);
  LBase := 0;
  if AOrigin = SeekOrigin.FromCurrent then
    LBase := LMemory->Position;
  end;
  if AOrigin = SeekOrigin.FromEnd then
    LBase := LMemory->DataSize;
  end;
  // The target must lie in 0 .. DataSize; compared without forming it (no overflow)
  if AOffset > LMemory->DataSize - LBase then
    return -1;
  end;
  if AOffset < -LBase then
    return -1;
  end;
  LMemory->Position := LBase + AOffset;
  return LMemory->Position;
end;

func MemoryTell(const AUserData: ptr): int64;
var
  LMemory: ptr to MemoryData;
begin
  LMemory := ptr to MemoryData(AUserData);
  return LMemory->Position;
end;

func MemorySize(const AUserData: ptr): int64;
var
  LMemory: ptr to MemoryData;
begin
  LMemory := ptr to MemoryData(AUserData);
  return LMemory->DataSize;
end;

// Memory has nothing buffered
func MemoryFlush(const AUserData: ptr; var AState: IOState): bool;
begin
  return true;
end;

// The size moves within the block: an owned block grows to hold it, caller memory only up to
// its capacity. Bytes the IO gains read as zero; the position, which never lies past the
// end, moves back to a shorter end
func MemoryTruncate(const AUserData: ptr; const ASize: int64; var AState: IOState): bool;
var
  LMemory: ptr to MemoryData;
begin
  LMemory := ptr to MemoryData(AUserData);
  if ASize > LMemory->Capacity then
    if not LMemory->Owned then
      AState := IOState.Error;
      return false;
    end;
    if not MemoryGrow(LMemory, ASize) then
      AState := IOState.Error;
      return false;
    end;
  end;
  if ASize > LMemory->DataSize then
    DoZero(LMemory->Data + LMemory->DataSize, ASize - LMemory->DataSize);
  end;
  LMemory->DataSize := ASize;
  if LMemory->Position > ASize then
    LMemory->Position := ASize;
  end;
  return true;
end;

func MemoryClose(const AUserData: ptr): bool;
var
  LMemory: ptr to MemoryData;
begin
  LMemory := ptr to MemoryData(AUserData);
  if LMemory->Owned and (LMemory->Data <> nil) then
    freemem(LMemory->Data);
  end;
  destroy(LMemory);
  return true;
end;

// The memory IO's callbacks; a read-only one has no Write and no Truncate
func MemoryInterface(const AReadOnly: bool): IOInterface;
var
  LInterface: IOInterface;
begin
  LInterface.Read := MemoryRead;
  LInterface.Write := nil;
  LInterface.Truncate := nil;
  if not AReadOnly then
    LInterface.Write := MemoryWrite;
    LInterface.Truncate := MemoryTruncate;
  end;
  LInterface.Seek := MemorySeek;
  LInterface.Tell := MemoryTell;
  LInterface.Size := MemorySize;
  LInterface.Flush := MemoryFlush;
  LInterface.Close := MemoryClose;
  return LInterface;
end;

// A memory IO over ALength bytes at AData (owned: a block of its own, AData nil); nil when
// there is no room
func DoCreateMemory(const AData: ptr; const ALength: int64; const AReadOnly: bool;
  const AOwned: bool): IO;
var
  LMemory: ptr to MemoryData;
  LIO: IO;
begin
  create(LMemory);
  if LMemory = nil then
    return nil;
  end;
  LMemory->Data := ptr to uint8(AData);
  LMemory->DataSize := ALength;
  LMemory->Capacity := ALength;
  LMemory->Owned := AOwned;
  LIO := CreateIO(MemoryInterface(AReadOnly), ptr(LMemory));
  if LIO = nil then
    destroy(LMemory);
  end;
  return LIO;
end;

// Makes an IO over the caller's memory: ASize bytes at AData, read-only or read / write. It
// never grows: a write past the end is a short count (state Error), a seek outside 0 ..
// ASize fails, IOTruncate moves the size only within those ASize bytes. The memory stays the
// caller's and must outlive the IO. AReadOnly true: IOWrite fails with state ReadOnly. Nil
// when AData / ASize are not a valid block (nil is valid only with ASize 0)
public func cpplink CreateMemoryIO(const AData: ptr; const ASize: int64; const AReadOnly: bool): IO;
begin
  if ASize < 0 then
    return nil;
  end;
  if (AData = nil) and (ASize > 0) then
    return nil;
  end;
  return DoCreateMemory(AData, ASize, AReadOnly, false);
end;

// Makes a read / write IO over the caller's memory (CreateMemoryIO with AReadOnly false)
public func cpplink CreateMemoryIO(const AData: ptr; const ASize: int64): IO;
begin
  return CreateMemoryIO(AData, ASize, false);
end;

// Makes a read / write IO over a buffer of its own, empty at first, that grows as writes
// pass its end; IOClose frees the buffer
public func cpplink CreateMemoryIO(): IO;
begin
  return DoCreateMemory(nil, 0, false, true);
end;

// The runtime's seek origin of AOrigin
func DoRuntimeOrigin(const AOrigin: SeekOrigin): int32;
begin
  if AOrigin = SeekOrigin.FromCurrent then
    return ADAM_SEEK_CURRENT;
  end;
  if AOrigin = SeekOrigin.FromEnd then
    return ADAM_SEEK_END;
  end;
  return ADAM_SEEK_START;
end;

// The runtime's file mode of AMode
func DoRuntimeMode(const AMode: FileMode): int32;
begin
  if AMode = FileMode.Write then
    return ADAM_FILE_WRITE;
  end;
  if AMode = FileMode.ReadWrite then
    return ADAM_FILE_READ_WRITE;
  end;
  if AMode = FileMode.Append then
    return ADAM_FILE_APPEND;
  end;
  return ADAM_FILE_READ;
end;

// The file IO's callbacks: the user pointer is the FileData CreateFileIO made. The runtime's
// handle buffers nothing, so a read after a write (or the reverse) needs no seek between, a
// flush has nothing to write out, and a size change sees every byte written
func FileRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64;
  var AState: IOState): int64;
var
  LFile: ptr to FileData;
  LBytes: ptr to uint8;
  LDone: int64;
  LGot: int64;
begin
  LFile := ptr to FileData(AUserData);
  LBytes := ptr to uint8(ABuffer);
  LDone := 0;
  // A handle read may give fewer bytes than asked before the end: read until the end
  while LDone < ASize do
    LGot := ReadFileHandle(LFile->Handle, ptr(LBytes + LDone), ASize - LDone);
    if LGot < 0 then
      AState := IOState.Error;
      return LDone;
    end;
    if LGot = 0 then
      leave;
    end;
    LDone := LDone + LGot;
  end;
  return LDone;
end;

func FileWrite(const AUserData: ptr; const ABuffer: ptr to const; const ASize: int64;
  var AState: IOState): int64;
var
  LFile: ptr to FileData;
  LBytes: ptr to const uint8;
  LDone: int64;
  LPut: int64;
begin
  LFile := ptr to FileData(AUserData);
  // Append: the end first, whatever the position (C's "a")
  if LFile->Append then
    if SeekFileHandle(LFile->Handle, 0, ADAM_SEEK_END) < 0 then
      AState := IOState.Error;
      return 0;
    end;
  end;
  LBytes := ptr to const uint8(ABuffer);
  LDone := 0;
  while LDone < ASize do
    LPut := WriteFileHandle(LFile->Handle, LBytes + LDone, ASize - LDone);
    if LPut <= 0 then
      AState := IOState.Error;
      return LDone;
    end;
    LDone := LDone + LPut;
  end;
  return LDone;
end;

func FileSeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
var
  LFile: ptr to FileData;
begin
  LFile := ptr to FileData(AUserData);
  return SeekFileHandle(LFile->Handle, AOffset, DoRuntimeOrigin(AOrigin));
end;

func FileTell(const AUserData: ptr): int64;
var
  LFile: ptr to FileData;
begin
  LFile := ptr to FileData(AUserData);
  return SeekFileHandle(LFile->Handle, 0, ADAM_SEEK_CURRENT);
end;

func FileSize(const AUserData: ptr): int64;
var
  LFile: ptr to FileData;
begin
  LFile := ptr to FileData(AUserData);
  return FileHandleSize(LFile->Handle);
end;

// Nothing is buffered: every write is already the file's
func FileFlush(const AUserData: ptr; var AState: IOState): bool;
begin
  return true;
end;

func FileClose(const AUserData: ptr): bool;
var
  LFile: ptr to FileData;
begin
  LFile := ptr to FileData(AUserData);
  CloseFileHandle(LFile->Handle);
  destroy(LFile);
  return true;
end;

// The size changes through the open file, never by the path it was opened by; the position
// is kept (it may then lie past the end)
func FileTruncate(const AUserData: ptr; const ASize: int64; var AState: IOState): bool;
var
  LFile: ptr to FileData;
begin
  LFile := ptr to FileData(AUserData);
  if not TruncateFileHandle(LFile->Handle, ASize) then
    AState := IOState.Error;
    return false;
  end;
  return true;
end;

// The file IO's callbacks for a mode: Read has no Write and no Truncate, Write and Append
// have no Read
func FileInterface(const AMode: FileMode): IOInterface;
var
  LInterface: IOInterface;
begin
  LInterface.Read := nil;
  LInterface.Write := nil;
  LInterface.Truncate := nil;
  if (AMode = FileMode.Read) or (AMode = FileMode.ReadWrite) then
    LInterface.Read := FileRead;
  end;
  if AMode <> FileMode.Read then
    LInterface.Write := FileWrite;
    LInterface.Truncate := FileTruncate;
  end;
  LInterface.Seek := FileSeek;
  LInterface.Tell := FileTell;
  LInterface.Size := FileSize;
  LInterface.Flush := FileFlush;
  LInterface.Close := FileClose;
  return LInterface;
end;

// True when APath starts with one of the path prefixes ($P:, $D:, $S:, $R:, either case)
func DoHasPrefix(const APath: string): bool;
var
  LKind: char;
begin
  if len(APath) < 3 then
    return false;
  end;
  if (APath[0] <> '$') or (APath[2] <> ':') then
    return false;
  end;
  LKind := APath[1];
  return (LKind = 'P') or (LKind = 'p') or (LKind = 'D') or (LKind = 'd') or (LKind = 'S') or
    (LKind = 's') or (LKind = 'R') or (LKind = 'r');
end;

// The folder of the program's exe ("" when the runtime cannot read its path)
func DoProgramFolder(): string;
var
  LPath: string;
begin
  LPath := ProgramFilePath();
  if LPath = "" then
    return "";
  end;
  return ExtractFileDir(LPath);
end;

// APath as the runtime opens it, its blanks trimmed: after `$P:` (either case) the folder of
// the program's exe joined to the rest; after `$D:` or `$S:` the rest (relative to the working
// folder); "" for `$R:` (the project root is the compiler's build-time prefix) or a prefix
// with nothing after it. Any other path is left as it is
func DoFilePath(const APath: string): string;
var
  LPath: string;
  LRest: string;
  LKind: char;
  LFolder: string;
begin
  LPath := Trim(APath);
  if not DoHasPrefix(LPath) then
    return LPath;
  end;
  LKind := LPath[1];
  LRest := Trim(Substring(LPath, 3, len(LPath) - 3));
  if (LRest = "") or (LKind = 'R') or (LKind = 'r') then
    return "";
  end;
  if (LKind = 'P') or (LKind = 'p') then
    LFolder := DoProgramFolder();
    if LFolder = "" then
      return "";
    end;
    return LFolder + "/" + LRest;
  end;
  return LRest;
end;

// A file IO over APath, a path as the runtime opens it (DoFilePath's result: no prefix left),
// opened in AMode; nil when APath is "" or the file cannot be opened so. CreateFileIO and the
// folder source open their files here
func DoOpenFile(const APath: string; const AMode: FileMode): IO;
var
  LHandle: uint64;
  LOpened: bool;
  LFile: ptr to FileData;
  LIO: IO;
begin
  if APath = "" then
    return nil;
  end;
  LHandle := 0;
  LOpened := OpenFileHandle(APath, DoRuntimeMode(AMode), LHandle);
  if not LOpened then
    return nil;
  end;
  create(LFile);
  if LFile = nil then
    CloseFileHandle(LHandle);
    return nil;
  end;
  LFile->Handle := LHandle;
  LFile->Append := (AMode = FileMode.Append);
  LIO := CreateIO(FileInterface(AMode), ptr(LFile));
  if LIO = nil then
    CloseFileHandle(LHandle);
    destroy(LFile);
  end;
  return LIO;
end;

// Makes an IO over a file, opened in one of C's fopen modes (see FileMode); APath is UTF-8,
// `$P:` the folder of the program's exe, `$D:` / `$S:` the working folder. A Read IO fails
// IOWrite with state ReadOnly, a Write or Append one fails IORead with state WriteOnly. A file
// may be positioned past its end, as with fseek; a write there fills the gap with zero bytes.
// IOClose closes the file. Nil when the file cannot be opened in that mode (a missing file
// for Read / ReadWrite, a folder, no permission)
public func cpplink CreateFileIO(const APath: string; const AMode: FileMode): IO;
begin
  return DoOpenFile(DoFilePath(APath), AMode);
end;


// True for a byte no source path may hold: `\` and `:` (a second separator and a drive on
// Windows), the characters Windows refuses in a name, and the control characters
func DoSourceBadChar(const AChar: char): bool;
begin
  if uint8(AChar) < 0x20 then
    return true;
  end;
  return (AChar = '\\') or (AChar = ':') or (AChar = '<') or (AChar = '>') or (AChar = '"') or
    (AChar = '|') or (AChar = '?') or (AChar = '*');
end;

// True when ASegment is a Windows device name (CON, PRN, AUX, NUL, COM1-9, LPT1-9) in any
// case, with or without an extension. Windows opens the device for such a name in any
// folder; it is refused on every target, so a source path means the same file everywhere
func DoSourceDevice(const ASegment: string): bool;
var
  LEnd: int64;
  LStem: string;
  LPrefix: string;
begin
  // The stem: the bytes before the first '.'
  LEnd := 0;
  while (LEnd < len(ASegment)) and (ASegment[LEnd] <> '.') do
    LEnd := LEnd + 1;
  end;
  // Windows drops trailing spaces before the extension ("CON .txt" is CON)
  while (LEnd > 0) and (ASegment[LEnd - 1] = ' ') do
    LEnd := LEnd - 1;
  end;
  LStem := UpperCase(Substring(ASegment, 0, LEnd));
  if (LStem = "CON") or (LStem = "PRN") or (LStem = "AUX") or (LStem = "NUL") then
    return true;
  end;
  if len(LStem) <> 4 then
    return false;
  end;
  LPrefix := Substring(LStem, 0, 3);
  if (LPrefix <> "COM") and (LPrefix <> "LPT") then
    return false;
  end;
  return (LStem[3] >= '1') and (LStem[3] <= '9');
end;

// An IOSource path in its one canonical form, "" when it is refused. The path is relative,
// `/` separated, UTF-8. `.` segments drop out and `..` removes the segment before it
// (lexically, as in a zip); a `..` that would climb above the source's root is refused.
// Refused too: an empty path or segment (a leading, doubled or trailing `/`), a bad byte
// (DoSourceBadChar), a segment ending in `.` or a space (Windows drops those, so two names
// would mean one file), a device name, and a path that names the root itself
func DoSourceNormalize(const APath: string): string;
var
  LSegments: StringArray;
  LParts: StringArray;
  LCount: int64;
  LSegment: string;
  LLast: char;
  LI: int64;
begin
  if APath = "" then
    return "";
  end;
  for LI := 0 to len(APath) - 1 do
    if DoSourceBadChar(APath[LI]) then
      return "";
    end;
  end;
  LSegments := SplitString(APath, "/");
  setlength(LParts, len(LSegments));
  LCount := 0;
  for LI := 0 to len(LSegments) - 1 do
    LSegment := LSegments[LI];
    if LSegment = "" then
      return "";
    end;
    if LSegment = ".." then
      if LCount = 0 then
        return "";
      end;
      LCount := LCount - 1;
    else
      if LSegment <> "." then
        LLast := LSegment[len(LSegment) - 1];
        if (LLast = '.') or (LLast = ' ') then
          return "";
        end;
        if DoSourceDevice(LSegment) then
          return "";
        end;
        LParts[LCount] := LSegment;
        LCount := LCount + 1;
      end;
    end;
  end;
  // No part left: the path named the root itself
  return JoinStrings(LParts, "/", 0, LCount);
end;

// Makes an IOSource from a table of callbacks and the user pointer they receive. The
// interface is copied; the user pointer is the caller's and is never freed by the source
// (its Close callback may free it). Nil when there is no room
public func cpplink CreateIOSource(const AInterface: IOSourceInterface; const AUserData: ptr): IOSource;
var
  LSource: IOSource;
begin
  create(LSource);
  if LSource = nil then
    return nil;
  end;
  LSource->Callbacks := AInterface;
  LSource->UserData := AUserData;
  return LSource;
end;

// Opens an entry of the source as an IO in AMode (a read-only source offers only Read). The
// path is relative to the source, `/` separated, UTF-8; `.` and `..` are resolved (a `..`
// above the source's root is refused). Refused before the source is asked: an absolute or
// empty path, an empty segment (`a//b`, a trailing `/`), `\`, `:`, the other characters
// Windows refuses in a name, a segment ending in `.` or a space, and a Windows device name
// (`nul`, `com1.txt`), on every target alike. Nil for a refused path, a missing entry, a mode
// not offered, a nil source or no Open callback
public func cpplink IOSourceOpen(const ASource: IOSource; const APath: string; const AMode: FileMode): IO;
var
  LOpen: IOSourceOpenCallback;
  LPath: string;
begin
  if ASource = nil then
    return nil;
  end;
  LOpen := ASource->Callbacks.Open;
  if LOpen = nil then
    return nil;
  end;
  LPath := DoSourceNormalize(APath);
  if LPath = "" then
    return nil;
  end;
  return LOpen(ASource->UserData, LPath, AMode);
end;

// Opens an entry of the source for reading (IOSourceOpen with FileMode.Read)
public func cpplink IOSourceOpen(const ASource: IOSource; const APath: string): IO;
begin
  return IOSourceOpen(ASource, APath, FileMode.Read);
end;

// True when the source has the entry (a file it can open; a folder is not an entry). The
// path follows IOSourceOpen's rules; a refused path does not exist. False too for a nil
// source or no Exists callback
public func cpplink IOSourceExists(const ASource: IOSource; const APath: string): bool;
var
  LExists: IOSourceExistsCallback;
  LPath: string;
begin
  if ASource = nil then
    return false;
  end;
  LExists := ASource->Callbacks.Exists;
  if LExists = nil then
    return false;
  end;
  LPath := DoSourceNormalize(APath);
  if LPath = "" then
    return false;
  end;
  return LExists(ASource->UserData, LPath);
end;

// The size in bytes of an entry of the source, without opening it. The path follows
// IOSourceOpen's rules. -1 for no such entry, a refused path, a nil source or no Size
// callback (any negative size the callback gives is -1)
public func cpplink IOSourceSize(const ASource: IOSource; const APath: string): int64;
var
  LSizeOf: IOSourceSizeCallback;
  LPath: string;
  LSize: int64;
begin
  if ASource = nil then
    return -1;
  end;
  LSizeOf := ASource->Callbacks.Size;
  if LSizeOf = nil then
    return -1;
  end;
  LPath := DoSourceNormalize(APath);
  if LPath = "" then
    return -1;
  end;
  LSize := LSizeOf(ASource->UserData, LPath);
  if LSize < 0 then
    return -1;
  end;
  return LSize;
end;

// Deletes an entry of the source. The path follows IOSourceOpen's rules. IOs already opened
// on the entry stay valid; whether the entry can go while one is open is the source's (a
// folder source on Windows refuses while a file IO on it is open). False for a missing
// entry, a refused path, a source that refused, a nil source or no Remove callback (a source
// that deletes nothing, such as a zip)
public func cpplink IOSourceRemove(const ASource: IOSource; const APath: string): bool;
var
  LRemove: IOSourceRemoveCallback;
  LPath: string;
begin
  if ASource = nil then
    return false;
  end;
  LRemove := ASource->Callbacks.Remove;
  if LRemove = nil then
    return false;
  end;
  LPath := DoSourceNormalize(APath);
  if LPath = "" then
    return false;
  end;
  return LRemove(ASource->UserData, LPath);
end;

// True when the source can delete entries (it has a Remove callback), so a caller can refuse
// up front what IOSourceRemove would not do later (a zip source cannot); false for a nil
// source
public func cpplink IOSourceCanRemove(const ASource: IOSource): bool;
begin
  if ASource = nil then
    return false;
  end;
  return ASource->Callbacks.Remove <> nil;
end;

// Ends the source: calls its Close callback, then frees the IOSource. IOs opened from it stay
// valid until their own IOClose. False for a nil source or when the Close callback failed
public func cpplink IOSourceClose(const ASource: IOSource): bool;
var
  LClose: IOSourceCloseCallback;
  LOk: bool;
  LRecord: IOSource;
begin
  if ASource = nil then
    return false;
  end;
  LOk := true;
  LClose := ASource->Callbacks.Close;
  if LClose <> nil then
    LOk := LClose(ASource->UserData);
  end;
  // destroy writes nil into its variable, so the const parameter goes through a local
  LRecord := ASource;
  destroy(LRecord);
  return LOk;
end;

// The file an entry of a folder source names: the folder joined with the canonical entry
// path, as the runtime opens it (the folder is never "": CreateFolderIOSource refuses it)
func DoFolderFile(const AUserData: ptr; const APath: string): string;
var
  LFolder: ptr to FolderData;
  LRoot: string;
  LLast: char;
begin
  LFolder := ptr to FolderData(AUserData);
  LRoot := LFolder->Root;
  LLast := LRoot[len(LRoot) - 1];
  if (LLast = '/') or (LLast = '\\') then
    return LRoot + APath;
  end;
  return LRoot + "/" + APath;
end;

// What is at an entry of a folder source (the runtime's ADAM_PATH_*), ASize the size of a
// file; ADAM_PATH_NONE when its path cannot be made
func DoFolderKind(const AUserData: ptr; const APath: string; var ASize: int64): int32;
var
  LText: string;
  LKind: int32;
begin
  ASize := 0;
  LText := DoFolderFile(AUserData, APath);
  LKind := PathKind(LText, ASize);
  return LKind;
end;

// The folder source's callbacks: an entry is a file under the folder, opened as a file IO
func FolderOpen(const AUserData: ptr; const APath: string; const AMode: FileMode): IO;
begin
  return DoOpenFile(DoFolderFile(AUserData, APath), AMode);
end;

func FolderExists(const AUserData: ptr; const APath: string): bool;
var
  LSize: int64;
begin
  return DoFolderKind(AUserData, APath, LSize) = ADAM_PATH_FILE;
end;

func FolderSize(const AUserData: ptr; const APath: string): int64;
var
  LSize: int64;
begin
  if DoFolderKind(AUserData, APath, LSize) <> ADAM_PATH_FILE then
    return -1;
  end;
  return LSize;
end;

// Deletes the entry's file; false when it is not a file (a folder is not an entry) or the
// file system refuses (a read-only file, one open in a file IO on Windows)
func FolderRemove(const AUserData: ptr; const APath: string): bool;
var
  LSize: int64;
  LText: string;
  LOk: bool;
begin
  if DoFolderKind(AUserData, APath, LSize) <> ADAM_PATH_FILE then
    return false;
  end;
  LText := DoFolderFile(AUserData, APath);
  LOk := RemoveFile(LText);
  return LOk;
end;

// Frees the folder source's user data
func FolderClose(const AUserData: ptr): bool;
var
  LFolder: ptr to FolderData;
begin
  LFolder := ptr to FolderData(AUserData);
  destroy(LFolder);
  return true;
end;

// The folder source's callback table
func FolderInterface(): IOSourceInterface;
var
  LInterface: IOSourceInterface;
begin
  LInterface.Open := FolderOpen;
  LInterface.Exists := FolderExists;
  LInterface.Size := FolderSize;
  LInterface.Close := FolderClose;
  LInterface.Remove := FolderRemove;
  return LInterface;
end;

// Makes an IOSource over a folder: every entry is a file under it, its IOs file IOs
// (CreateFileIO's rules, every FileMode). The folder's path is UTF-8, with CreateFileIO's
// prefixes (`$P:` the folder of the program's exe, `$D:` / `$S:` the working folder); entry
// paths are relative to it (IOSourceOpen's rules), so nothing outside the folder is reached
// by a `..`. Opening in Write or Append creates the file, never a folder; IOSourceRemove
// deletes the entry's file. Nil when the path is not an existing folder
public func cpplink CreateFolderIOSource(const APath: string): IOSource;
var
  LPath: string;
  LSize: int64;
  LFolder: ptr to FolderData;
  LSource: IOSource;
begin
  LPath := DoFilePath(APath);
  if LPath = "" then
    return nil;
  end;
  LSize := 0;
  if PathKind(LPath, LSize) <> ADAM_PATH_FOLDER then
    return nil;
  end;
  create(LFolder);
  if LFolder = nil then
    return nil;
  end;
  LFolder->Root := LPath;
  LSource := CreateIOSource(FolderInterface(), ptr(LFolder));
  if LSource = nil then
    destroy(LFolder);
  end;
  return LSource;
end;

// The zip source. minizip (System.Minizip.C) reads the archive THROUGH its IO: minizip's
// zlib_filefunc64_def is the bridge below (ZipBridge*), which reads, seeks and tells on that
// IO. The directory is read once into a table of entries. An entry IO reads its data whole
// through minizip when it is small, else in place: stored bytes straight from the archive,
// deflated ones through zlib (System.Zlib.C) from access points, ZipCrypto decrypted here
type
  // How a zip entry IO reads. Whole: under ADAM_CUSTOMIO_ZIP_WHOLE_LIMIT, read whole through
  // minizip when opened (its CRC check), seek free. Direct: stored, not encrypted: bytes
  // read in place at any offset. Decode: deflated, or stored and encrypted: read in place
  // from access points (zran: about every ADAM_CUSTOMIO_ZIP_SPAN bytes of output, the byte /
  // bit the deflate stream stands at and its last 32 KB of output; for an encrypted entry
  // the ZipCrypto keys there too, stored entries every ADAM_CUSTOMIO_ZIP_KEY_SPAN), so a seek
  // decodes at most one interval; points are made as the output first passes them. Direct
  // and Decode check the CRC as Python's zipfile does: over the output from 0 to the
  // furthest point ever read (the frontier); the frontier reaching the end with another CRC
  // fails the IO
  ZipKind = choices(Whole, Direct, Decode);

  // The ZipCrypto keys (minizip's crypt.h schedule, APPNOTE 6.1), copied by value
  ZipKeys = record
    Key0: uint32;
    Key1: uint32;
    Key2: uint32;
  end;

  // The archive a zip source reads, shared by the source and every entry IO opened from it
  // (an entry IO stays valid after IOSourceClose): Refs counts them, and the last one to let
  // go closes the archive when it is Owned (the source opened it by path). Single-threaded,
  // as every IO is
  ZipArchiveData = record
    Stream: IO;
    Owned: bool;
    Refs: int64;
  end;

  // The bridge's state: minizip's stream and opaque pointer both point here. Archive holds
  // one reference, the source's; Failed is set when a seek or tell failed (minizip's
  // testerror)
  ZipBridgeData = record
    Archive: ptr to ZipArchiveData;
    Failed: bool;
  end;

  // One entry of the directory: its canonical path, where minizip finds it again (by file position, never by name) and what reading it
  // needs. Compressed counts an encryption header in; DosDate is the DOS date shl 16 | the
  // DOS time (the password check of a bit-3 entry); Compression is minizip's method (0
  // stored, Z_DEFLATED); Flags bit 0 encrypted, bit 3 sizes and CRC after the data
  ZipEntryData = record
    EntryName: string;
    Position: unz64_file_pos;
    Compressed: int64;
    Uncompressed: int64;
    Crc: uint32;
    DosDate: uint32;
    Compression: uint32;
    Flags: uint32;
  end;

  // A zip source's user data: the bridge, minizip's file table and handle on the archive,
  // the password ("" when there is none) and the directory (EntryCount entries in the
  // archive's order, room for len(Entries)), read once when the source is made; create /
  // destroy build and free it, its strings and directory released with it
  ZipTableData = record
    Bridge: ZipBridgeData;
    Funcs: zlib_filefunc64_def;
    Handle: unzFile;
    Password: string;
    Entries: array of ZipEntryData;
    EntryCount: int64;
  end;

  // A place decoding starts again from. InAt and KeysAt count from the entry's first data
  // byte (past the ZipCrypto header). OutAt: the output offset it stands at; InAt: the first
  // whole compressed byte still to read; Bits (deflated): bits of the byte before InAt still
  // unread; KeysAt (encrypted): where Keys hold (at or before the first byte read); Window
  // (deflated): the output before OutAt, up to 32 KB (WindowCount bytes, nil when none)
  ZipPointData = record
    OutAt: int64;
    InAt: int64;
    Bits: int32;
    KeysAt: int64;
    Keys: ZipKeys;
    Window: ptr to uint8;
    WindowCount: int64;
  end;

  // A zip entry IO's user data; the entry's facts are copied in, since the IO outlives its
  // source. Whole: the entry's bytes. Direct and Decode: Archive (one reference, let go when
  // the IO closes), DataStart (the archive offset of the first data byte), DataSize (the
  // compressed bytes from there), the frontier and the CRC of the output up to it. Decode:
  // the cursor (InAt the next compressed byte the archive gives, OutAt the output offset of
  // the next byte decoded, Keys the keys for the byte at InAt), where Input's bytes start
  // and the keys there (ChunkAt / ChunkKeys) and the same for the chunk read before it,
  // Input (the compressed bytes read, decrypted; Inflater's next_in / avail_in walk them for
  // both kinds, a stored entry never calls inflate), Ring (deflated: the output by offset
  // mod 32 KB, the windows of new points) and the points (PointCount, Points[0] at 0)
  ZipEntryIOData = record
    Kind: ZipKind;
    EntrySize: int64;
    EntryCrc: uint32;
    EntryDosDate: uint32;
    EntryFlags: uint32;
    Position: int64;
    Failed: bool;
    Whole: ptr to uint8;
    Archive: ptr to ZipArchiveData;
    DataStart: int64;
    DataSize: int64;
    Deflated: bool;
    Encrypted: bool;
    Frontier: int64;
    FrontierCrc: uint32;
    CursorValid: bool;
    InAt: int64;
    OutAt: int64;
    Keys: ZipKeys;
    ChunkAt: int64;
    ChunkKeys: ZipKeys;
    PrevChunkAt: int64;
    PrevChunkKeys: ZipKeys;
    Input: ptr to uint8;
    Inflater: z_stream;
    InflaterReady: bool;
    Ring: ptr to uint8;
    Points: ptr to ZipPointData;
    PointCount: int64;
    PointCapacity: int64;
  end;

// The 16-bit and 32-bit little-endian values at AAt
func DoZipU16(const AAt: ptr to const uint8): uint32;
begin
  return uint32(AAt[0]) | (uint32(AAt[1]) shl 8);
end;

func DoZipU32(const AAt: ptr to const uint8): uint32;
begin
  return uint32(AAt[0]) | (uint32(AAt[1]) shl 8) | (uint32(AAt[2]) shl 16) |
    (uint32(AAt[3]) shl 24);
end;

// CP437's character AByte (0x80 .. 0xFF) as a Unicode code point, from ADAM_CUSTOMIO_ZIP_CP437
func DoZipCp437(const AByte: uint8): uint32;
begin
  return ADAM_CUSTOMIO_ZIP_CP437[AByte];
end;

// ACode added to the end of AText as UTF-8
func DoZipAppendCode(var AText: string; const ACode: uint32);
var
  LAt: int64;
begin
  LAt := len(AText);
  setlength(AText, LAt + 4);
  EncodeUtf8Char(AText, LAt, ACode);
  setlength(AText, LAt);
end;

// A CP437 name (ACount bytes at AName) as UTF-8
func DoZipCp437Text(const AName: ptr to const uint8; const ACount: int64): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  for LI := 0 to ACount - 1 do
    if AName[LI] < 0x80 then
      DoZipAppendCode(LText, uint32(AName[LI]));
    else
      DoZipAppendCode(LText, DoZipCp437(AName[LI]));
    end;
  end;
  return LText;
end;

// The Info-ZIP Unicode Path field (0x7075) in an entry's extra data (AExtraCount bytes at
// AExtra; minizip hands it over raw): its UTF-8 name when its CRC is the raw name's (a stale
// one, left by a rename, is ignored), else "". A field running past the extra data ends the
// walk: minizip's own reading decides the entry
func DoZipUnicodePath(const ARaw: ptr to const uint8; const ARawCount: int64;
  const AExtra: ptr to const uint8; const AExtraCount: int64): string;
var
  LAt: int64;
  LId: uint32;
  LField: int64;
  LData: ptr to const uint8;
  LCrc: uint32;
begin
  LAt := 0;
  while AExtraCount - LAt >= 4 do
    LId := DoZipU16(AExtra + LAt);
    LField := int64(DoZipU16(AExtra + LAt + 2));
    LData := AExtra + LAt + 4;
    if AExtraCount - LAt - 4 < LField then
      leave;
    end;
    if (LId = 0x7075) and (LField >= 5) and (LData[0] = 1) then
      LCrc := uint32(crc32(0, ARaw, uInt(ARawCount)));
      if LCrc = DoZipU32(LData + 1) then
        return StringFromC(ptr to const char(LData + 5), LField - 5);
      end;
    end;
    LAt := LAt + 4 + LField;
  end;
  return "";
end;

// Takes one more reference on the archive
func DoZipHold(const AArchive: ptr to ZipArchiveData);
begin
  AArchive->Refs := AArchive->Refs + 1;
end;

// Lets go of a reference: the last one closes an owned archive and frees the record; false
// when that close failed
func DoZipLetGo(const AArchive: ptr to ZipArchiveData): bool;
var
  LOk: bool;
  LRecord: ptr to ZipArchiveData;
begin
  if AArchive = nil then
    return true;
  end;
  AArchive->Refs := AArchive->Refs - 1;
  if AArchive->Refs > 0 then
    return true;
  end;
  LOk := true;
  if AArchive->Owned and (AArchive->Stream <> nil) then
    LOk := IOClose(AArchive->Stream);
  end;
  // destroy writes nil into its variable, so the const parameter goes through a local
  LRecord := AArchive;
  destroy(LRecord);
  return LOk;
end;

// Reads ASize bytes from the archive's position, calling IORead until they are all in or it
// returns 0 (a user IO may return short counts that are not the end); the count read
func DoZipReadLoop(const AArchive: ptr to ZipArchiveData; const ABuffer: ptr to uint8;
  const ASize: int64): int64;
var
  LDone: int64;
  LGot: int64;
begin
  LDone := 0;
  while LDone < ASize do
    LGot := IORead(AArchive->Stream, ptr(ABuffer + LDone), ASize - LDone);
    if (LGot <= 0) or (LGot > ASize - LDone) then
      leave;
    end;
    LDone := LDone + LGot;
  end;
  return LDone;
end;

// Reads ASize bytes at archive offset AAt: the count read (short at the end or on an
// error), or -1 when the seek failed. Every read seeks first, so the source and its entry
// IOs share the archive's one position safely
func DoZipReadAt(const AArchive: ptr to ZipArchiveData; const AAt: int64;
  const ABuffer: ptr to uint8; const ASize: int64): int64;
begin
  if IOSeek(AArchive->Stream, AAt, SeekOrigin.FromStart) <> AAt then
    return -1;
  end;
  return DoZipReadLoop(AArchive, ABuffer, ASize);
end;
// minizip's file functions over the archive's IO. Their parameters are plain and typed as
// the zlib_filefunc64_def routine types take them (C's const void * a ptr to const). Open:
// the archive is open already (the source's IO), so the stream is the bridge itself
func ZipBridgeOpen(AOpaque: voidpf; AFileName: ptr to const; AMode: int32): voidpf;
begin
  return AOpaque;
end;

// Reads ASize bytes from the archive's position (DoZipReadLoop)
func ZipBridgeRead(AOpaque: voidpf; AStream: voidpf; ABuffer: ptr; ASize: uLong): uLong;
var
  LBridge: ptr to ZipBridgeData;
begin
  LBridge := ptr to ZipBridgeData(AStream);
  return uLong(DoZipReadLoop(LBridge->Archive, ptr to uint8(ABuffer), int64(ASize)));
end;

// Writes ASize bytes at the archive's position (the zip writer; minizip's unzip side never
// writes); a short count fails the bridge
func ZipBridgeWrite(AOpaque: voidpf; AStream: voidpf; ABuffer: ptr to const; ASize: uLong):
  uLong;
var
  LBridge: ptr to ZipBridgeData;
  LDone: int64;
begin
  LBridge := ptr to ZipBridgeData(AStream);
  LDone := IOWriteFull(LBridge->Archive->Stream, ABuffer, int64(ASize));
  if LDone < int64(ASize) then
    LBridge->Failed := true;
  end;
  if LDone < 0 then
    return 0;
  end;
  return uLong(LDone);
end;

// The archive's position; all ones (C's (ZPOS64_T)-1) when the tell failed
func ZipBridgeTell(AOpaque: voidpf; AStream: voidpf): ZPOS64_T;
var
  LBridge: ptr to ZipBridgeData;
  LAt: int64;
begin
  LBridge := ptr to ZipBridgeData(AStream);
  LAt := IOTell(LBridge->Archive->Stream);
  if LAt < 0 then
    LBridge->Failed := true;
    LAt := -1;
  end;
  return ZPOS64_T(LAt);
end;

// 0 when the seek landed, -1 when it failed (minizip's contract). minizip moves back over an
// entry's extra field with a relative seek whose offset is a negative number wrapped into
// the unsigned ZPOS64_T (its own fopen table hands that to fseeko64, which reads it as
// signed), so a relative (current / end) offset is the two's-complement int64; only a
// from-start offset must fit in int64 as it is
func ZipBridgeSeek(AOpaque: voidpf; AStream: voidpf; AOffset: ZPOS64_T;
  AOrigin: int32): clong;
var
  LBridge: ptr to ZipBridgeData;
  LOrigin: SeekOrigin;
  LKnown: bool;
begin
  LBridge := ptr to ZipBridgeData(AStream);
  LKnown := false;
  LOrigin := SeekOrigin.FromStart;
  if (AOrigin = ZLIB_FILEFUNC_SEEK_SET) and (AOffset <= ZPOS64_T(ADAM_CUSTOMIO_INT64_MAX)) then
    LKnown := true;
  end;
  if AOrigin = ZLIB_FILEFUNC_SEEK_CUR then
    LOrigin := SeekOrigin.FromCurrent;
    LKnown := true;
  end;
  if AOrigin = ZLIB_FILEFUNC_SEEK_END then
    LOrigin := SeekOrigin.FromEnd;
    LKnown := true;
  end;
  if not LKnown then
    LBridge->Failed := true;
    return -1;
  end;
  if IOSeek(LBridge->Archive->Stream, int64(AOffset), LOrigin) < 0 then
    LBridge->Failed := true;
    return -1;
  end;
  return 0;
end;

// The archive stays open: the source closes it (opened by path) or the caller does
func ZipBridgeClose(AOpaque: voidpf; AStream: voidpf): int32;
begin
  return 0;
end;

func ZipBridgeError(AOpaque: voidpf; AStream: voidpf): int32;
var
  LBridge: ptr to ZipBridgeData;
begin
  LBridge := ptr to ZipBridgeData(AStream);
  if LBridge->Failed then
    return -1;
  end;
  return 0;
end;

// AEntry added to the end of ATable's directory (the room doubles as it fills)
func DoZipAddEntry(const ATable: ptr to ZipTableData; const AEntry: ZipEntryData);
var
  LCapacity: int64;
begin
  if ATable->EntryCount = len(ATable->Entries) then
    LCapacity := len(ATable->Entries) * 2;
    if LCapacity = 0 then
      LCapacity := 16;
    end;
    setlength(ATable->Entries, LCapacity);
  end;
  ATable->Entries[ATable->EntryCount] := AEntry;
  ATable->EntryCount := ATable->EntryCount + 1;
end;

// True when AEntry's canonical path is APath
func DoZipSameName(const AEntry: ptr to ZipEntryData; const APath: string): bool;
begin
  return AEntry->EntryName = APath;
end;

// The entry a canonical source path names, or nil. Of two entries with one name the later
// is found (as Python's zipfile): the walk starts at the end
func DoZipFind(const ATable: ptr to ZipTableData; const APath: string): ptr to ZipEntryData;
var
  LI: int64;
  LEntry: ptr to ZipEntryData;
begin
  LI := ATable->EntryCount - 1;
  while LI >= 0 do
    LEntry := addr of ATable->Entries[LI];
    if DoZipSameName(LEntry, APath) then
      return LEntry;
    end;
    LI := LI - 1;
  end;
  return nil;
end;

// Records minizip's current entry (AInfo, its raw name ARawCount bytes at ARaw, its extra
// data AExtraCount bytes at AExtra) in the directory; false when minizip cannot give its
// place, a size passes int64 or there is no room. The name is UTF-8 when flag bit 11 says
// so, else the Unicode Path field's when it is current, else CP437. A folder (a name ending
// in `/`) is not an entry, nor is a name no source path reaches (absolute, climbing out,
// `\`: IOSourceOpen's rules); both are passed over
func DoZipRecord(const ATable: ptr to ZipTableData; const AInfo: unz_file_info64;
  const ARaw: ptr to const uint8; const ARawCount: int64; const AExtra: ptr to const uint8;
  const AExtraCount: int64): bool;
var
  LText: string;
  LName: string;
  LEntry: ZipEntryData;
begin
  if (AInfo.compressed_size > ZPOS64_T(ADAM_CUSTOMIO_INT64_MAX)) or
    (AInfo.uncompressed_size > ZPOS64_T(ADAM_CUSTOMIO_INT64_MAX)) then
    return false;
  end;
  if (AInfo.flag & 0x0800) <> 0 then
    LText := StringFromC(ptr to const char(ARaw), ARawCount);
  else
    LText := DoZipUnicodePath(ARaw, ARawCount, AExtra, AExtraCount);
    if LText = "" then
      LText := DoZipCp437Text(ARaw, ARawCount);
    end;
  end;
  if (len(LText) > 0) and (LText[len(LText) - 1] = '/') then
    return true;
  end;
  LName := DoSourceNormalize(LText);
  if LName = "" then
    return true;
  end;
  if unzGetFilePos64(ATable->Handle, addr of LEntry.Position) <> UNZ_OK then
    return false;
  end;
  LEntry.Compressed := int64(AInfo.compressed_size);
  LEntry.Uncompressed := int64(AInfo.uncompressed_size);
  LEntry.Crc := uint32(AInfo.crc);
  LEntry.DosDate := uint32(AInfo.dosDate);
  LEntry.Compression := uint32(AInfo.compression_method);
  LEntry.Flags := uint32(AInfo.flag);
  LEntry.EntryName := LName;
  DoZipAddEntry(ATable, LEntry);
  return true;
end;

// Reads minizip's current entry into the directory (DoZipRecord); false when minizip cannot
// read its header or there is no room. minizip is asked twice: for the name's and the extra
// data's sizes, then for their bytes
func DoZipEntry(const ATable: ptr to ZipTableData): bool;
var
  LInfo: unz_file_info64;
  LRaw: ptr to uint8;
  LExtra: ptr to uint8;
  LRawCount: int64;
  LExtraCount: int64;
  LOk: bool;
begin
  DoZero(ptr to uint8(ptr(addr of LInfo)), size(unz_file_info64));
  if unzGetCurrentFileInfo64(ATable->Handle, addr of LInfo, nil, 0, nil, 0, nil, 0) <> UNZ_OK then
    return false;
  end;
  LRawCount := int64(LInfo.size_filename);
  LExtraCount := int64(LInfo.size_file_extra);
  // One byte more than asked for each, so a count of 0 still has a buffer
  LRaw := ptr to uint8(getmem(LRawCount + 1));
  if LRaw = nil then
    return false;
  end;
  LExtra := ptr to uint8(getmem(LExtraCount + 1));
  if LExtra = nil then
    freemem(LRaw);
    return false;
  end;
  LOk := unzGetCurrentFileInfo64(ATable->Handle, addr of LInfo, ptr to char(ptr(LRaw)),
    uLong(LRawCount), ptr(LExtra), uLong(LExtraCount), nil, 0) = UNZ_OK;
  if LOk then
    LOk := DoZipRecord(ATable, LInfo, LRaw, LRawCount, LExtra, LExtraCount);
  end;
  freemem(LRaw);
  freemem(LExtra);
  return LOk;
end;

// Walks minizip's directory once into the entry table; false when an entry cannot be read (a
// bad header signature) or the bridge failed. An archive with no entries has an empty table
// (minizip's first-file call would read a header that is not there)
func DoZipDirectory(const ATable: ptr to ZipTableData): bool;
var
  LGlobal: unz_global_info64;
  LStatus: int32;
begin
  DoZero(ptr to uint8(ptr(addr of LGlobal)), size(unz_global_info64));
  if unzGetGlobalInfo64(ATable->Handle, addr of LGlobal) <> UNZ_OK then
    return false;
  end;
  if LGlobal.number_entry = 0 then
    return not ATable->Bridge.Failed;
  end;
  LStatus := unzGoToFirstFile(ATable->Handle);
  while LStatus = UNZ_OK do
    if not DoZipEntry(ATable) then
      return false;
    end;
    LStatus := unzGoToNextFile(ATable->Handle);
  end;
  return (LStatus = UNZ_END_OF_LIST_OF_FILE) and not ATable->Bridge.Failed;
end;

// Frees a zip source's user data: closes minizip's handle and lets go of the source's
// reference on the archive (the last reference closes an owned archive); false when
// minizip's close or the archive's failed
func DoZipFree(const ATable: ptr to ZipTableData): bool;
var
  LOk: bool;
  LRecord: ptr to ZipTableData;
begin
  if ATable = nil then
    return true;
  end;
  LOk := true;
  if ATable->Handle <> nil then
    LOk := unzClose(ATable->Handle) = UNZ_OK;
  end;
  if not DoZipLetGo(ATable->Bridge.Archive) then
    LOk := false;
  end;
  // destroy writes nil into its variable, so the const parameter goes through a local
  LRecord := ATable;
  destroy(LRecord);
  return LOk;
end;

// Opens AArchive with minizip through the bridge and reads its directory: the zip source's
// user data, or nil when minizip refuses the archive (no end record, cut short, a bad
// signature, several disks), an entry cannot be read or there is no room. From the call on,
// an owned archive (AOwned) is this side's: closed here when the source cannot be made,
// else by the last of the source and its entry IOs to let go
func DoZipCreate(const AArchive: IO; const AOwned: bool; const APassword: string): ptr to ZipTableData;
var
  LArchive: ptr to ZipArchiveData;
  LTable: ptr to ZipTableData;
begin
  create(LArchive);
  if LArchive = nil then
    if AOwned then
      IOClose(AArchive);
    end;
    return nil;
  end;
  LArchive->Stream := AArchive;
  LArchive->Owned := AOwned;
  LArchive->Refs := 1;
  // create zeroes it: every field nil, 0 or false until set
  create(LTable);
  if LTable = nil then
    DoZipLetGo(LArchive);
    return nil;
  end;
  // The table holds the record's first reference
  LTable->Bridge.Archive := LArchive;
  LTable->Password := APassword;
  LTable->Funcs.zopen64_file := ZipBridgeOpen;
  LTable->Funcs.zread_file := ZipBridgeRead;
  LTable->Funcs.zwrite_file := ZipBridgeWrite;
  LTable->Funcs.ztell64_file := ZipBridgeTell;
  LTable->Funcs.zseek64_file := ZipBridgeSeek;
  LTable->Funcs.zclose_file := ZipBridgeClose;
  LTable->Funcs.zerror_file := ZipBridgeError;
  LTable->Funcs.opaque := ptr(addr of LTable->Bridge);
  // The path is unused: the bridge's open hands back the open archive
  LTable->Handle := unzOpen2_64(ptr to const char(""), addr of LTable->Funcs);
  if (LTable->Handle = nil) or not DoZipDirectory(LTable) then
    DoZipFree(LTable);
    return nil;
  end;
  return LTable;
end;

// One step of ZipCrypto's CRC (the raw CRC-32 step, no pre / post inversion) over AByte,
// through zlib's table
func DoZipCrcByte(const ATable: ptr to const z_crc_t; const ACrc: uint32;
  const AByte: uint32): uint32;
begin
  return ATable[int64((ACrc xor AByte) & 0xFF)] xor (ACrc shr 8);
end;

// The keys moved on by one plain byte (crypt.h's update_keys)
func DoZipUpdateKeys(var AKeys: ZipKeys; const ATable: ptr to const z_crc_t;
  const AByte: uint32);
begin
  AKeys.Key0 := DoZipCrcByte(ATable, AKeys.Key0, AByte);
  AKeys.Key1 := AKeys.Key1 + (AKeys.Key0 & 0xFF);
  AKeys.Key1 := AKeys.Key1 * uint32(134775813) + 1;
  AKeys.Key2 := DoZipCrcByte(ATable, AKeys.Key2, AKeys.Key1 shr 24);
end;

// The keys for a password (crypt.h's init_keys)
func DoZipInitKeys(var AKeys: ZipKeys; const APassword: string);
var
  LTable: ptr to const z_crc_t;
  LI: int64;
begin
  LTable := get_crc_table();
  AKeys.Key0 := 305419896;
  AKeys.Key1 := 591751049;
  AKeys.Key2 := 878082192;
  for LI := 0 to len(APassword) - 1 do
    DoZipUpdateKeys(AKeys, LTable, uint32(uint8(APassword[LI])));
  end;
end;

// Decrypts ACount bytes in place, moving AKeys on (crypt.h's zdecode). Every byte of a
// ZipCrypto entry passes through here, so the loop is written for speed: the keys live in
// locals for the whole run (written back once at the end) and decrypt_byte / update_keys
// are spelled out inline (crypt.h's steps, update_keys as DoZipUpdateKeys does it), with no
// call or record write per byte (a debug build inlines nothing)
func DoZipDecrypt(var AKeys: ZipKeys; const ABytes: ptr to uint8; const ACount: int64);
var
  LTable: ptr to const z_crc_t;
  LI: int64;
  LByte: uint32;
  LTemp: uint32;
  LKey0: uint32;
  LKey1: uint32;
  LKey2: uint32;
begin
  LTable := get_crc_table();
  LKey0 := AKeys.Key0;
  LKey1 := AKeys.Key1;
  LKey2 := AKeys.Key2;
  for LI := 0 to ACount - 1 do
    // decrypt_byte: the keystream byte from Key2
    LTemp := (LKey2 & 0xFFFF) | 2;
    LByte := uint32(ABytes[LI]) xor (((LTemp * (LTemp xor 1)) shr 8) & 0xFF);
    ABytes[LI] := uint8(LByte);
    // update_keys over the plain byte: Key0 a CRC step, Key1 the LCG, Key2 a CRC step of
    // Key1's top byte
    LKey0 := LTable[int64((LKey0 xor LByte) & 0xFF)] xor (LKey0 shr 8);
    LKey1 := (LKey1 + (LKey0 & 0xFF)) * uint32(134775813) + 1;
    LKey2 := LTable[int64((LKey2 xor (LKey1 shr 24)) & 0xFF)] xor (LKey2 shr 8);
  end;
  AKeys.Key0 := LKey0;
  AKeys.Key1 := LKey1;
  AKeys.Key2 := LKey2;
end;

// ACrc continued over ACount bytes at ABytes (zlib's crc32 takes 32-bit counts)
func DoZipCrc(const ACrc: uint32; const ABytes: ptr to const uint8; const ACount: int64): uint32;
var
  LCrc: uint32;
  LAt: ptr to const uint8;
  LLeft: int64;
  LCount: int64;
begin
  LCrc := ACrc;
  LAt := ABytes;
  LLeft := ACount;
  while LLeft > 0 do
    LCount := LLeft;
    if LCount > ADAM_CUSTOMIO_ZIP_CRC_PIECE then
      LCount := ADAM_CUSTOMIO_ZIP_CRC_PIECE;
    end;
    LCrc := uint32(crc32(uLong(LCrc), LAt, uInt(LCount)));
    LAt := LAt + LCount;
    LLeft := LLeft - LCount;
  end;
  return LCrc;
end;
// ACount output bytes at offset AAt: the part past the frontier goes into the CRC; the
// frontier at the end with another CRC than the directory's fails the IO. Bytes that start
// past the frontier (a direct read after a seek) leave it where it is
func DoZipFrontier(const AIO: ptr to ZipEntryIOData; const AAt: int64;
  const ABytes: ptr to const uint8; const ACount: int64);
var
  LEnd: int64;
  LSkip: int64;
begin
  LEnd := AAt + ACount;
  if (AAt > AIO->Frontier) or (LEnd <= AIO->Frontier) then
    return;
  end;
  LSkip := AIO->Frontier - AAt;
  AIO->FrontierCrc := DoZipCrc(AIO->FrontierCrc, ABytes + LSkip, ACount - LSkip);
  AIO->Frontier := LEnd;
  if (AIO->Frontier >= AIO->EntrySize) and (AIO->FrontierCrc <> AIO->EntryCrc) then
    AIO->Failed := true;
  end;
end;

// The ZipCrypto check (APPNOTE 6.1.6): the 12-byte header at the data's start, decrypted
// with the password, ends in the CRC's high byte (the DOS time's when bit 3 puts the CRC
// after the data). minizip never checks it, so a wrong password would only show as garbage.
// True when it fits; AKeys are then the keys for the data's first byte
func DoZipPasswordFits(const AIO: ptr to ZipEntryIOData; const ATable: ptr to ZipTableData;
  var AKeys: ZipKeys): bool;
var
  // ADAM_CUSTOMIO_ZIP_CRYPT_HEADER bytes
  LHeader: array[0..11] of uint8;
  LCheck: uint32;
begin
  if DoZipReadAt(ATable->Bridge.Archive, AIO->DataStart, addr of LHeader[0],
    ADAM_CUSTOMIO_ZIP_CRYPT_HEADER) <> ADAM_CUSTOMIO_ZIP_CRYPT_HEADER then
    return false;
  end;
  DoZipInitKeys(AKeys, ATable->Password);
  DoZipDecrypt(AKeys, addr of LHeader[0], ADAM_CUSTOMIO_ZIP_CRYPT_HEADER);
  LCheck := (AIO->EntryCrc shr 24) & 0xFF;
  if (AIO->EntryFlags & 0x0008) <> 0 then
    LCheck := (AIO->EntryDosDate shr 8) & 0xFF;
  end;
  return uint32(LHeader[11]) = LCheck;
end;

// Reads the whole entry through minizip (its current file is the entry); false on a read
// error, a size other than the directory's or a CRC mismatch (minizip's close reports it
// once all was read)
func DoZipReadWhole(const ATable: ptr to ZipTableData; const AIO: ptr to ZipEntryIOData): bool;
var
  LSize: int64;
  LText: CString;
  LPassword: ptr to const char;
  LMethod: int32;
  LLevel: int32;
  LDone: int64;
  LGot: int32;
  LAsk: int64;
  LMore: uint8;
  LClosed: int32;
begin
  LSize := AIO->EntrySize;
  // minizip takes nil for no password: the text shared through a CString while it reads
  LText := CString(ATable->Password);
  LPassword := nil;
  if AIO->Encrypted then
    LPassword := LText.Ptr;
  end;
  // One byte more than the size, so an empty entry still has a buffer
  AIO->Whole := ptr to uint8(getmem(LSize + 1));
  if AIO->Whole = nil then
    return false;
  end;
  LMethod := 0;
  LLevel := 0;
  if unzOpenCurrentFile3(ATable->Handle, addr of LMethod, addr of LLevel, 0, LPassword) <> UNZ_OK then
    return false;
  end;
  LDone := 0;
  LGot := 1;
  while (LDone < LSize) and (LGot > 0) do
    LAsk := LSize - LDone;
    if LAsk > ADAM_CUSTOMIO_CHUNK then
      LAsk := ADAM_CUSTOMIO_CHUNK;
    end;
    LGot := unzReadCurrentFile(ATable->Handle, ptr(AIO->Whole + LDone), uint32(LAsk));
    if LGot > 0 then
      LDone := LDone + LGot;
    end;
  end;
  // One more read must find the end: an entry longer than its size is broken
  if (LGot >= 0) and (LDone = LSize) then
    LMore := 0;
    LGot := unzReadCurrentFile(ATable->Handle, ptr(addr of LMore), 1);
  end;
  LClosed := unzCloseCurrentFile(ATable->Handle);
  return (LDone = LSize) and (LGot = 0) and (LClosed = UNZ_OK) and not ATable->Bridge.Failed;
end;

// Frees an entry IO's user data, letting go of its archive reference; false when the last
// reference's close of the archive failed
func DoZipEntryFree(const AIO: ptr to ZipEntryIOData): bool;
var
  LOk: bool;
  LI: int64;
  LRecord: ptr to ZipEntryIOData;
begin
  if AIO = nil then
    return true;
  end;
  if AIO->InflaterReady then
    inflateEnd(addr of AIO->Inflater);
  end;
  LOk := true;
  if AIO->Archive <> nil then
    LOk := DoZipLetGo(AIO->Archive);
  end;
  for LI := 0 to AIO->PointCount - 1 do
    if AIO->Points[LI].Window <> nil then
      freemem(AIO->Points[LI].Window);
    end;
  end;
  if AIO->Points <> nil then
    freemem(AIO->Points);
  end;
  if AIO->Whole <> nil then
    freemem(AIO->Whole);
  end;
  if AIO->Input <> nil then
    freemem(AIO->Input);
  end;
  if AIO->Ring <> nil then
    freemem(AIO->Ring);
  end;
  // destroy writes nil into its variable, so the const parameter goes through a local
  LRecord := AIO;
  destroy(LRecord);
  return LOk;
end;

// APoint added to the end of AIO's points (the room doubles as it fills); false when there
// is no room
func DoZipAddPoint(const AIO: ptr to ZipEntryIOData; const APoint: ZipPointData): bool;
var
  LCapacity: int64;
  LPoints: ptr to ZipPointData;
begin
  if AIO->PointCount = AIO->PointCapacity then
    LCapacity := AIO->PointCapacity * 2;
    if LCapacity = 0 then
      LCapacity := 8;
    end;
    LPoints := ptr to ZipPointData(getmem(LCapacity * size(ZipPointData)));
    if LPoints = nil then
      return false;
    end;
    if AIO->Points <> nil then
      CopyBytes(ptr to uint8(ptr(LPoints)), ptr to uint8(ptr(AIO->Points)),
        AIO->PointCount * size(ZipPointData));
      freemem(AIO->Points);
    end;
    AIO->Points := LPoints;
    AIO->PointCapacity := LCapacity;
  end;
  AIO->Points[AIO->PointCount] := APoint;
  AIO->PointCount := AIO->PointCount + 1;
  return true;
end;

// The output offset of AIO's last point
func DoZipLastPoint(const AIO: ptr to ZipEntryIOData): int64;
begin
  return AIO->Points[AIO->PointCount - 1].OutAt;
end;

// inflateInit2_ for raw deflate (-15: a zip entry has no zlib header), zlib's version and
// z_stream's size passed as zlib.h's inflateInit2 macro passes them
func DoZipInflateInit(const AIO: ptr to ZipEntryIOData): int32;
var
  LCode: int32;
begin
  LCode := inflateInit2_(addr of AIO->Inflater, -15, ZLIB_VERSION,
    int32(size(z_stream)));
  return LCode;
end;

// Finds where the entry's data starts: minizip, asked for the entry raw and without a
// password, stops at the first data byte (the ZipCrypto header when there is one), its
// position counting the data before the archive (a self-extractor) in. An encrypted entry
// needs the password and its header must fit it (AKeys are then the data's first byte's);
// DataStart / DataSize are then past the header. False when any of that fails
func DoZipDataStart(const ATable: ptr to ZipTableData; const AEntry: ptr to ZipEntryData;
  const AIO: ptr to ZipEntryIOData; var AKeys: ZipKeys): bool;
var
  LMethod: int32;
  LLevel: int32;
  LStart: ZPOS64_T;
begin
  if AIO->Encrypted and (len(ATable->Password) = 0) then
    return false;
  end;
  ATable->Bridge.Failed := false;
  LMethod := 0;
  LLevel := 0;
  if unzGoToFilePos64(ATable->Handle, addr of AEntry->Position) <> UNZ_OK then
    return false;
  end;
  if unzOpenCurrentFile3(ATable->Handle, addr of LMethod, addr of LLevel, 1, nil) <> UNZ_OK then
    return false;
  end;
  LStart := unzGetCurrentFileZStreamPos64(ATable->Handle);
  unzCloseCurrentFile(ATable->Handle);
  if (LStart = 0) or (LStart > ZPOS64_T(ADAM_CUSTOMIO_INT64_MAX)) then
    return false;
  end;
  AIO->DataStart := int64(LStart);
  AIO->DataSize := AEntry->Compressed;
  if not AIO->Encrypted then
    return true;
  end;
  if (AIO->DataSize < ADAM_CUSTOMIO_ZIP_CRYPT_HEADER) or
    not DoZipPasswordFits(AIO, ATable, AKeys) then
    return false;
  end;
  AIO->DataStart := AIO->DataStart + ADAM_CUSTOMIO_ZIP_CRYPT_HEADER;
  AIO->DataSize := AIO->DataSize - ADAM_CUSTOMIO_ZIP_CRYPT_HEADER;
  return true;
end;

// Sets up an entry IO that reads in place: Direct for a stored entry that is not
// encrypted, else Decode with its first point at 0 (AKeys, the keys for the data's first
// byte). Stored entries have as many data bytes as output bytes. False for a method other
// than stored / deflated, a stored size that does not match, or no room
func DoZipInPlace(const ATable: ptr to ZipTableData; const AEntry: ptr to ZipEntryData;
  const AIO: ptr to ZipEntryIOData; const AKeys: ZipKeys): bool;
var
  LStored: bool;
  LFirst: ZipPointData;
begin
  LStored := AEntry->Compression = 0;
  if (not LStored) and (not AIO->Deflated) then
    return false;
  end;
  if LStored and (AIO->DataSize <> AEntry->Uncompressed) then
    return false;
  end;
  AIO->Archive := ATable->Bridge.Archive;
  DoZipHold(AIO->Archive);
  if LStored and not AIO->Encrypted then
    AIO->Kind := ZipKind.Direct;
    return true;
  end;
  AIO->Kind := ZipKind.Decode;
  AIO->Input := ptr to uint8(getmem(ADAM_CUSTOMIO_ZIP_CHUNK));
  if AIO->Input = nil then
    return false;
  end;
  if AIO->Deflated then
    AIO->Ring := ptr to uint8(getmem(ADAM_CUSTOMIO_ZIP_WINDOW));
    if AIO->Ring = nil then
      return false;
    end;
  end;
  DoZero(ptr to uint8(ptr(addr of LFirst)), size(ZipPointData));
  LFirst.Keys := AKeys;
  return DoZipAddPoint(AIO, LFirst);
end;

// Opens the entry a canonical source path names for reading: the entry IO's user data, or
// nil when the zip does not have it, it is encrypted and the password is missing or wrong,
// its method is neither stored nor deflated (in place), it cannot be read whole (a read
// error, a CRC mismatch), or there is no room
func DoZipEntryOpen(const ATable: ptr to ZipTableData; const APath: string): ptr to ZipEntryIOData;
var
  LEntry: ptr to ZipEntryData;
  LIO: ptr to ZipEntryIOData;
  LKeys: ZipKeys;
begin
  LEntry := DoZipFind(ATable, APath);
  if LEntry = nil then
    return nil;
  end;
  // create zeroes it: every field nil, 0 or false until set
  create(LIO);
  if LIO = nil then
    return nil;
  end;
  LIO->EntrySize := LEntry->Uncompressed;
  LIO->EntryCrc := LEntry->Crc;
  LIO->EntryDosDate := LEntry->DosDate;
  LIO->EntryFlags := LEntry->Flags;
  LIO->Encrypted := (LEntry->Flags & 0x0001) <> 0;
  LIO->Deflated := LEntry->Compression = uint32(Z_DEFLATED);
  LKeys.Key0 := 0;
  LKeys.Key1 := 0;
  LKeys.Key2 := 0;
  if not DoZipDataStart(ATable, LEntry, LIO, LKeys) then
    DoZipEntryFree(LIO);
    return nil;
  end;
  // A small entry: read whole now, the archive no longer needed
  if LIO->EntrySize < ADAM_CUSTOMIO_ZIP_WHOLE_LIMIT then
    LIO->Kind := ZipKind.Whole;
    if not DoZipReadWhole(ATable, LIO) then
      DoZipEntryFree(LIO);
      return nil;
    end;
    return LIO;
  end;
  if not DoZipInPlace(ATable, LEntry, LIO, LKeys) then
    DoZipEntryFree(LIO);
    return nil;
  end;
  return LIO;
end;
// Reads the next chunk of compressed bytes into Input, decrypted, for the decoder (InAt short
// of DataSize); false when the archive gave fewer
func DoZipFill(const AIO: ptr to ZipEntryIOData): bool;
var
  LCount: int64;
begin
  LCount := AIO->DataSize - AIO->InAt;
  if LCount > ADAM_CUSTOMIO_ZIP_CHUNK then
    LCount := ADAM_CUSTOMIO_ZIP_CHUNK;
  end;
  AIO->PrevChunkAt := AIO->ChunkAt;
  AIO->PrevChunkKeys := AIO->ChunkKeys;
  AIO->ChunkAt := AIO->InAt;
  AIO->ChunkKeys := AIO->Keys;
  if DoZipReadAt(AIO->Archive, AIO->DataStart + AIO->InAt, AIO->Input, LCount) <> LCount then
    return false;
  end;
  if AIO->Encrypted then
    DoZipDecrypt(AIO->Keys, AIO->Input, LCount);
  end;
  AIO->InAt := AIO->InAt + LCount;
  AIO->Inflater.next_in := AIO->Input;
  AIO->Inflater.avail_in := uInt(LCount);
  return true;
end;

// A deflate point where inflate stopped at a block boundary (zran's addpoint): the byte /
// bit the stream stands at, the keys for the first byte a restart reads (it reads the byte
// before InAt when Bits is not 0) and the last 32 KB of output; false when there is no room
func DoZipInflatePoint(const AIO: ptr to ZipEntryIOData): bool;
var
  LPoint: ZipPointData;
  LFirst: int64;
  LKeep: int64;
  LI: int64;
begin
  DoZero(ptr to uint8(ptr(addr of LPoint)), size(ZipPointData));
  LPoint.OutAt := AIO->OutAt;
  LPoint.Bits := AIO->Inflater.data_type & 7;
  LPoint.InAt := AIO->InAt - int64(AIO->Inflater.avail_in);
  LFirst := LPoint.InAt;
  if LPoint.Bits <> 0 then
    LFirst := LFirst - 1;
  end;
  // InAt lies in the chunk Input holds, so the first byte read is in it or is the last
  // byte of the chunk before
  if LFirst >= AIO->ChunkAt then
    LPoint.KeysAt := AIO->ChunkAt;
    LPoint.Keys := AIO->ChunkKeys;
  else
    LPoint.KeysAt := AIO->PrevChunkAt;
    LPoint.Keys := AIO->PrevChunkKeys;
  end;
  LKeep := AIO->OutAt;
  if LKeep > ADAM_CUSTOMIO_ZIP_WINDOW then
    LKeep := ADAM_CUSTOMIO_ZIP_WINDOW;
  end;
  LPoint.Window := ptr to uint8(getmem(LKeep + 1));
  if LPoint.Window = nil then
    return false;
  end;
  LPoint.WindowCount := LKeep;
  for LI := 0 to LKeep - 1 do
    LPoint.Window[LI] := AIO->Ring[(AIO->OutAt - LKeep + LI) mod ADAM_CUSTOMIO_ZIP_WINDOW];
  end;
  if not DoZipAddPoint(AIO, LPoint) then
    freemem(LPoint.Window);
    return false;
  end;
  return true;
end;

// Up to AMax next output bytes of a deflated entry into ADest (nil: discarded): the count, 0
// at the stream's end, -1 on an error (bad data, the stream cut short, no room for a point)
func DoZipInflateStep(const AIO: ptr to ZipEntryIOData; const ADest: ptr to uint8;
  const AMax: int64): int64;
var
  LRingAt: int64;
  LRoom: int64;
  LTo: ptr to uint8;
  LInBefore: uInt;
  LStatus: int32;
  LMade: int64;
begin
  while true do
    if (AIO->Inflater.avail_in = 0) and (AIO->InAt < AIO->DataSize) and not DoZipFill(AIO) then
      return -1;
    end;
    // Output goes into the ring at its offset, then to ADest
    LRingAt := AIO->OutAt mod ADAM_CUSTOMIO_ZIP_WINDOW;
    LRoom := ADAM_CUSTOMIO_ZIP_WINDOW - LRingAt;
    if LRoom > AMax then
      LRoom := AMax;
    end;
    LTo := AIO->Ring + LRingAt;
    LInBefore := AIO->Inflater.avail_in;
    AIO->Inflater.next_out := LTo;
    AIO->Inflater.avail_out := uInt(LRoom);
    // Z_BLOCK: inflate also stops at every block boundary, where a point can be
    LStatus := inflate(addr of AIO->Inflater, Z_BLOCK);
    LMade := LRoom - int64(AIO->Inflater.avail_out);
    if (LStatus <> Z_OK) and (LStatus <> Z_STREAM_END) and (LStatus <> Z_BUF_ERROR) then
      return -1;
    end;
    if LMade > 0 then
      if ADest <> nil then
        CopyBytes(ADest, LTo, LMade);
      end;
      DoZipFrontier(AIO, AIO->OutAt, LTo, LMade);
      AIO->OutAt := AIO->OutAt + LMade;
    end;
    // data_type bit 128: stopped at a block boundary; bit 64: after the last block
    if ((AIO->Inflater.data_type & 128) <> 0) and ((AIO->Inflater.data_type & 64) = 0) and
      (AIO->OutAt > DoZipLastPoint(AIO) + ADAM_CUSTOMIO_ZIP_SPAN) then
      if not DoZipInflatePoint(AIO) then
        return -1;
      end;
    end;
    if LMade > 0 then
      return LMade;
    end;
    if LStatus = Z_STREAM_END then
      return 0;
    end;
    // Nothing read, nothing made: the stream is cut short (or stuck)
    if AIO->Inflater.avail_in = LInBefore then
      return -1;
    end;
  end;
end;

// Up to AMax next output bytes of an encrypted stored entry into ADest (nil: discarded): the
// count, 0 at the end, -1 on a read error or no room for a point. A point (keys only) is
// kept at a chunk start every ADAM_CUSTOMIO_ZIP_KEY_SPAN bytes
func DoZipStoredStep(const AIO: ptr to ZipEntryIOData; const ADest: ptr to uint8;
  const AMax: int64): int64;
var
  LPoint: ZipPointData;
  LCount: int64;
  LFrom: ptr to const uint8;
begin
  if AIO->Inflater.avail_in = 0 then
    if AIO->InAt >= AIO->DataSize then
      return 0;
    end;
    if AIO->InAt >= DoZipLastPoint(AIO) + ADAM_CUSTOMIO_ZIP_KEY_SPAN then
      DoZero(ptr to uint8(ptr(addr of LPoint)), size(ZipPointData));
      LPoint.OutAt := AIO->InAt;
      LPoint.InAt := AIO->InAt;
      LPoint.KeysAt := AIO->InAt;
      LPoint.Keys := AIO->Keys;
      if not DoZipAddPoint(AIO, LPoint) then
        return -1;
      end;
    end;
    if not DoZipFill(AIO) then
      return -1;
    end;
  end;
  LCount := int64(AIO->Inflater.avail_in);
  if LCount > AMax then
    LCount := AMax;
  end;
  LFrom := AIO->Inflater.next_in;
  if ADest <> nil then
    CopyBytes(ADest, LFrom, LCount);
  end;
  DoZipFrontier(AIO, AIO->OutAt, LFrom, LCount);
  AIO->Inflater.next_in := LFrom + LCount;
  AIO->Inflater.avail_in := AIO->Inflater.avail_in - uInt(LCount);
  AIO->OutAt := AIO->OutAt + LCount;
  return LCount;
end;

// The decoder's next step, by the entry's kind
func DoZipStep(const AIO: ptr to ZipEntryIOData; const ADest: ptr to uint8;
  const AMax: int64): int64;
begin
  if AIO->Deflated then
    return DoZipInflateStep(AIO, ADest, AMax);
  end;
  return DoZipStoredStep(AIO, ADest, AMax);
end;

// Primes a deflated entry's restart at APoint, whose first byte read is AFirst (zran's
// extract): inflate reset (or set up), given the bits of the byte before InAt and the
// point's window, the ring filled from it so points made later get their windows. False
// when the archive or zlib failed
func DoZipRestartInflate(const AIO: ptr to ZipEntryIOData; const APoint: ZipPointData;
  const AFirst: int64): bool;
var
  LReset: int32;
  LByte: uint8;
  LI: int64;
begin
  if AIO->InflaterReady then
    LReset := inflateReset(addr of AIO->Inflater);
  else
    LReset := DoZipInflateInit(AIO);
  end;
  if LReset <> Z_OK then
    return false;
  end;
  AIO->InflaterReady := true;
  AIO->Inflater.next_in := AIO->Input;
  AIO->Inflater.avail_in := 0;
  if APoint.Bits <> 0 then
    LByte := 0;
    if DoZipReadAt(AIO->Archive, AIO->DataStart + AFirst, addr of LByte, 1) <> 1 then
      return false;
    end;
    if AIO->Encrypted then
      DoZipDecrypt(AIO->Keys, addr of LByte, 1);
    end;
    AIO->InAt := AFirst + 1;
    AIO->ChunkAt := AIO->InAt;
    AIO->ChunkKeys := AIO->Keys;
    if inflatePrime(addr of AIO->Inflater, APoint.Bits, int32(LByte) shr (8 - APoint.Bits)) <> Z_OK then
      return false;
    end;
  end;
  if APoint.WindowCount > 0 then
    if inflateSetDictionary(addr of AIO->Inflater, APoint.Window, uInt(APoint.WindowCount)) <> Z_OK then
      return false;
    end;
    for LI := 0 to APoint.WindowCount - 1 do
      AIO->Ring[(APoint.OutAt - APoint.WindowCount + LI) mod ADAM_CUSTOMIO_ZIP_WINDOW] :=
        APoint.Window[LI];
    end;
  end;
  return true;
end;

// Puts the decoder at APoint: the keys moved on from KeysAt to the first byte read (an
// encrypted entry's bytes up to it decrypted and dropped), the cursor there, inflate primed
// for a deflated entry. False when the archive or zlib failed
func DoZipRestart(const AIO: ptr to ZipEntryIOData; const APoint: ZipPointData): bool;
var
  LFirst: int64;
  LAt: int64;
  LCount: int64;
begin
  LFirst := APoint.InAt;
  if APoint.Bits <> 0 then
    LFirst := LFirst - 1;
  end;
  AIO->CursorValid := false;
  AIO->Keys := APoint.Keys;
  if AIO->Encrypted then
    LAt := APoint.KeysAt;
    while LAt < LFirst do
      LCount := LFirst - LAt;
      if LCount > ADAM_CUSTOMIO_ZIP_CHUNK then
        LCount := ADAM_CUSTOMIO_ZIP_CHUNK;
      end;
      if DoZipReadAt(AIO->Archive, AIO->DataStart + LAt, AIO->Input, LCount) <> LCount then
        return false;
      end;
      DoZipDecrypt(AIO->Keys, AIO->Input, LCount);
      LAt := LAt + LCount;
    end;
  end;
  AIO->InAt := LFirst;
  AIO->ChunkAt := LFirst;
  AIO->ChunkKeys := AIO->Keys;
  AIO->PrevChunkAt := LFirst;
  AIO->PrevChunkKeys := AIO->Keys;
  AIO->Inflater.next_in := AIO->Input;
  AIO->Inflater.avail_in := 0;
  if AIO->Deflated then
    if not DoZipRestartInflate(AIO, APoint, LFirst) then
      return false;
    end;
  end;
  AIO->OutAt := APoint.OutAt;
  AIO->CursorValid := true;
  return true;
end;

// The index of the last point at or before output offset AAt (Points[0] is at 0; the points
// are in output order)
func DoZipPointBefore(const AIO: ptr to ZipEntryIOData; const AAt: int64): int64;
var
  LLow: int64;
  LHigh: int64;
  LMid: int64;
begin
  LLow := 0;
  LHigh := AIO->PointCount - 1;
  while LLow < LHigh do
    LMid := (LLow + LHigh + 1) div 2;
    if AIO->Points[LMid].OutAt <= AAt then
      LLow := LMid;
    else
      LHigh := LMid - 1;
    end;
  end;
  return LLow;
end;

// Reads ASize bytes (at most what is left) at the position of a Decode entry: from the
// cursor when it is at or before the position with no point nearer, else from the last
// point at or before it; the count read
func DoZipDecodeRead(const AIO: ptr to ZipEntryIOData; const ABuffer: ptr to uint8;
  const ASize: int64): int64;
var
  LPoint: int64;
  LFrom: ZipPointData;
  LDone: int64;
  LGot: int64;
begin
  LPoint := DoZipPointBefore(AIO, AIO->Position);
  if (not AIO->CursorValid) or (AIO->OutAt > AIO->Position) or
    (AIO->Points[LPoint].OutAt > AIO->OutAt) then
    // A copy: restarting adds no point, but the points are not held across it
    LFrom := AIO->Points[LPoint];
    if not DoZipRestart(AIO, LFrom) then
      AIO->Failed := true;
      return 0;
    end;
  end;
  // Up to the position, the output dropped
  while AIO->OutAt < AIO->Position do
    if DoZipStep(AIO, nil, AIO->Position - AIO->OutAt) <= 0 then
      AIO->Failed := true;
      AIO->CursorValid := false;
      return 0;
    end;
  end;
  LDone := 0;
  while LDone < ASize do
    // ASize is at most what is left, so the end here is an error too
    LGot := DoZipStep(AIO, ABuffer + LDone, ASize - LDone);
    if LGot <= 0 then
      AIO->Failed := true;
      AIO->CursorValid := false;
      leave;
    end;
    LDone := LDone + LGot;
  end;
  AIO->Position := AIO->Position + LDone;
  return LDone;
end;

// Reads ASize bytes (at most what is left) at the position of a Direct entry, in place; the
// count read
func DoZipDirectRead(const AIO: ptr to ZipEntryIOData; const ABuffer: ptr to uint8;
  const ASize: int64): int64;
var
  LGot: int64;
begin
  LGot := DoZipReadAt(AIO->Archive, AIO->DataStart + AIO->Position, ABuffer, ASize);
  if LGot < ASize then
    AIO->Failed := true;
  end;
  if LGot < 0 then
    LGot := 0;
  end;
  DoZipFrontier(AIO, AIO->Position, ABuffer, LGot);
  AIO->Position := AIO->Position + LGot;
  return LGot;
end;

// The entry IO's read: up to ASize bytes into ABuffer, the count read (short at the end, or
// with Failed set after an error)
func DoZipEntryRead(const AIO: ptr to ZipEntryIOData; const ABuffer: ptr to uint8;
  const ASize: int64): int64;
var
  LCount: int64;
begin
  LCount := AIO->EntrySize - AIO->Position;
  if LCount > ASize then
    LCount := ASize;
  end;
  if LCount <= 0 then
    return 0;
  end;
  if AIO->Kind = ZipKind.Whole then
    CopyBytes(ABuffer, AIO->Whole + AIO->Position, LCount);
    AIO->Position := AIO->Position + LCount;
    return LCount;
  end;
  if AIO->Kind = ZipKind.Direct then
    return DoZipDirectRead(AIO, ABuffer, LCount);
  end;
  return DoZipDecodeRead(AIO, ABuffer, LCount);
end;

// The zip entry IO's callbacks: the user pointer is the ZipEntryIOData DoZipEntryOpen made.
// Read: a read error or a CRC mismatch is the IO's error (every later read fails too); a
// short count otherwise is the end
func ZipEntryRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64;
  var AState: IOState): int64;
var
  LIO: ptr to ZipEntryIOData;
  LCount: int64;
begin
  LIO := ptr to ZipEntryIOData(AUserData);
  LCount := 0;
  if not LIO->Failed then
    LCount := DoZipEntryRead(LIO, ptr to uint8(ABuffer), ASize);
  end;
  if LIO->Failed then
    AState := IOState.Error;
  end;
  return LCount;
end;

// The new position, or -1 when the target lies outside 0 .. the entry's size (as the memory
// IO). Only the position moves; the next read decodes
func ZipEntrySeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
var
  LIO: ptr to ZipEntryIOData;
  LBase: int64;
begin
  LIO := ptr to ZipEntryIOData(AUserData);
  LBase := 0;
  if AOrigin = SeekOrigin.FromCurrent then
    LBase := LIO->Position;
  end;
  if AOrigin = SeekOrigin.FromEnd then
    LBase := LIO->EntrySize;
  end;
  // The target must lie in 0 .. size; compared without forming it (no overflow)
  if (AOffset > LIO->EntrySize - LBase) or (AOffset < -LBase) then
    return -1;
  end;
  LIO->Position := LBase + AOffset;
  return LIO->Position;
end;

func ZipEntryTell(const AUserData: ptr): int64;
var
  LIO: ptr to ZipEntryIOData;
begin
  LIO := ptr to ZipEntryIOData(AUserData);
  return LIO->Position;
end;

func ZipEntrySize(const AUserData: ptr): int64;
var
  LIO: ptr to ZipEntryIOData;
begin
  LIO := ptr to ZipEntryIOData(AUserData);
  return LIO->EntrySize;
end;

// Frees the entry IO, letting go of its archive reference
func ZipEntryClose(const AUserData: ptr): bool;
begin
  return DoZipEntryFree(ptr to ZipEntryIOData(AUserData));
end;

// The zip entry IO's callback table: read-only, nothing to flush or truncate
func ZipEntryInterface(): IOInterface;
var
  LInterface: IOInterface;
begin
  LInterface.Read := ZipEntryRead;
  LInterface.Write := nil;
  LInterface.Seek := ZipEntrySeek;
  LInterface.Tell := ZipEntryTell;
  LInterface.Size := ZipEntrySize;
  LInterface.Flush := nil;
  LInterface.Close := ZipEntryClose;
  LInterface.Truncate := nil;
  return LInterface;
end;
// The zip source's callbacks: the user pointer is the ZipTableData DoZipCreate made. Open:
// an entry as a read-only IO; nil for any other mode, a missing entry, a missing or wrong
// password, a method other than stored / deflated, or an entry that cannot be read
func ZipOpen(const AUserData: ptr; const APath: string; const AMode: FileMode): IO;
var
  LEntry: ptr to ZipEntryIOData;
  LIO: IO;
begin
  if AMode <> FileMode.Read then
    return nil;
  end;
  LEntry := DoZipEntryOpen(ptr to ZipTableData(AUserData), APath);
  if LEntry = nil then
    return nil;
  end;
  LIO := CreateIO(ZipEntryInterface(), ptr(LEntry));
  if LIO = nil then
    DoZipEntryFree(LEntry);
  end;
  return LIO;
end;

func ZipExists(const AUserData: ptr; const APath: string): bool;
begin
  return DoZipFind(ptr to ZipTableData(AUserData), APath) <> nil;
end;

func ZipSize(const AUserData: ptr; const APath: string): int64;
var
  LEntry: ptr to ZipEntryData;
begin
  LEntry := DoZipFind(ptr to ZipTableData(AUserData), APath);
  if LEntry = nil then
    return -1;
  end;
  return LEntry->Uncompressed;
end;

// Frees the directory, letting go of the source's hold on the archive (the last holder
// closes an owned archive); false when a close failed
func ZipClose(const AUserData: ptr): bool;
begin
  return DoZipFree(ptr to ZipTableData(AUserData));
end;

// The zip source's callback table: read-only, so no Remove
func ZipInterface(): IOSourceInterface;
var
  LInterface: IOSourceInterface;
begin
  LInterface.Open := ZipOpen;
  LInterface.Exists := ZipExists;
  LInterface.Size := ZipSize;
  LInterface.Close := ZipClose;
  LInterface.Remove := nil;
  return LInterface;
end;

// A zip source over AArchive: minizip opens it through the bridge and the directory is read
// once; nil when AArchive is nil, minizip refuses it or an entry cannot be read. An owned
// archive (AOwned) is the source's from the call on: closed here when the source cannot be
// made, else by the last of the source and its entry IOs to let go
func ZipCreate(const AArchive: IO; const AOwned: bool; const APassword: string): IOSource;
var
  LTable: ptr to ZipTableData;
  LSource: IOSource;
begin
  if AArchive = nil then
    return nil;
  end;
  LTable := DoZipCreate(AArchive, AOwned, APassword);
  if LTable = nil then
    return nil;
  end;
  LSource := CreateIOSource(ZipInterface(), ptr(LTable));
  if LSource = nil then
    DoZipFree(LTable);
  end;
  return LSource;
end;

// One entry of a fresh zip source as an IO; the source is closed at once (the entry IO
// keeps the archive open on its own)
func ZipEntryOf(const ASource: IOSource; const AEntry: string): IO;
var
  LIO: IO;
begin
  if ASource = nil then
    return nil;
  end;
  LIO := IOSourceOpen(ASource, AEntry);
  IOSourceClose(ASource);
  return LIO;
end;

// Makes a read-only IOSource over a zip archive read through an IO: the archive may be a
// file, memory, an entry of another source or any IO that reads and seeks. Its central
// directory is read once, here: ZIP64 archives, data before the archive (a self-extractor)
// and names in UTF-8, CP437 or an Info-ZIP Unicode Path field are read. Entry paths follow
// IOSourceOpen's rules and match the archive's names exactly (case included, on every
// target); a folder is not an entry, a name no path can reach (absolute, `..` above the
// root, `\`) is never found, and of two entries with one name the later is found.
// IOSourceSize gives an entry's uncompressed size; IOSourceOpen opens an entry
// (FileMode.Read only) as a read-only IO that seeks without reading from the start again
// (stored and deflated entries, ZipCrypto encrypted or not): an entry under 256 KB is read
// whole when opened, a larger one in place. An encrypted entry opens only with the right
// password. A CRC that does not match gives nil from the open (small entry) or fails the
// read that reaches the end (large entry, state Error). An entry IO stays valid after
// IOSourceClose. The archive IO stays the caller's: never closed by the source, its
// position moved by every read, it must outlive the source and its entry IOs. APassword is
// the password for the encrypted entries ("" for none). Nil when AArchive is nil or not a
// valid zip (no end record, cut short, a bad signature, several disks)
public func cpplink CreateZipIOSource(const AArchive: IO; const APassword: string): IOSource;
begin
  return ZipCreate(AArchive, false, APassword);
end;

// Makes a read-only IOSource over a zip archive read through an IO, with no password
// (CreateZipIOSource(AArchive, ""))
public func cpplink CreateZipIOSource(const AArchive: IO): IOSource;
begin
  return ZipCreate(AArchive, false, "");
end;

// Makes a read-only IOSource over a zip file: CreateZipIOSource over the file opened as
// CreateFileIO(APath, FileMode.Read) opens it (UTF-8, `$P:` / `$D:` / `$S:`). The source
// owns that file: it is closed once the source (IOSourceClose) and every entry IO opened
// from it (IOClose) are closed. Nil when the file cannot be opened or is not a valid zip
public func cpplink CreateZipIOSource(const APath: string; const APassword: string): IOSource;
begin
  return ZipCreate(CreateFileIO(APath, FileMode.Read), true, APassword);
end;

// Makes a read-only IOSource over a zip file, with no password (CreateZipIOSource(APath,
// ""))
public func cpplink CreateZipIOSource(const APath: string): IOSource;
begin
  return ZipCreate(CreateFileIO(APath, FileMode.Read), true, "");
end;

// Opens one entry of a zip archive read through an IO as a read-only IO: IOSourceOpen on
// CreateZipIOSource(AArchive, APassword), the source closed again at once (the entry IO
// keeps what it needs). Reading, seeking, passwords and CRC as CreateZipIOSource says; the
// archive is the caller's and must outlive the IO. Nil when it is not a valid zip, has no
// such entry, the password is missing or wrong, or the entry cannot be read
public func cpplink CreateZipFileIO(const AArchive: IO; const AEntry: string; const APassword: string): IO;
begin
  return ZipEntryOf(ZipCreate(AArchive, false, APassword), AEntry);
end;

// Opens one entry of a zip archive read through an IO, with no password
// (CreateZipFileIO(AArchive, AEntry, ""))
public func cpplink CreateZipFileIO(const AArchive: IO; const AEntry: string): IO;
begin
  return ZipEntryOf(ZipCreate(AArchive, false, ""), AEntry);
end;

// Opens one entry of a zip file as a read-only IO: the file opened as
// CreateZipIOSource(APath, APassword) opens it, and closed when the IO is (IOClose). Nil
// when the file cannot be opened or is not a valid zip, has no such entry, the password is
// missing or wrong, or the entry cannot be read
public func cpplink CreateZipFileIO(const APath: string; const AEntry: string; const APassword: string): IO;
begin
  return ZipEntryOf(ZipCreate(CreateFileIO(APath, FileMode.Read), true, APassword), AEntry);
end;

// Opens one entry of a zip file, with no password (CreateZipFileIO(APath, AEntry, ""))
public func cpplink CreateZipFileIO(const APath: string; const AEntry: string): IO;
begin
  return ZipEntryOf(ZipCreate(CreateFileIO(APath, FileMode.Read), true, ""), AEntry);
end;

public type
  // What a zip's central directory records about one entry, read by GetZipEntryInfo without
  // opening or decoding the entry: Size, its uncompressed size in bytes; Crc, the CRC-32 of
  // its uncompressed bytes as the directory records it (the CRC an entry IO checks its bytes
  // against)
  ZipEntryInfo = record
    Size: int64;
    Crc: uint32;
  end;

// Reads an entry's uncompressed size and CRC-32 from a zip file's central directory, without
// opening or decoding the entry: a cache of an extracted entry compares its file against
// these to know it is current. The zip is opened as CreateZipIOSource(APath, APassword)
// opens it and closed again before the call returns. The directory is never encrypted, so
// an encrypted entry's info reads with any password; APassword is kept so the call names
// the archive the way CreateZipFileIO does. AInfo is set when the call succeeds and left as
// it was otherwise. True when the zip has the entry; false when the file cannot be opened
// or is not a valid zip, the path is refused or no entry has it
public func cpplink GetZipEntryInfo(const APath: string; const AEntry: string; const APassword: string;
  var AInfo: ZipEntryInfo): bool;
var
  LSource: IOSource;
  LPath: string;
  LEntry: ptr to ZipEntryData;
  LSize: int64;
  LCrc: uint32;
begin
  LSource := ZipCreate(CreateFileIO(APath, FileMode.Read), true, APassword);
  if LSource = nil then
    return false;
  end;
  LPath := DoSourceNormalize(AEntry);
  if LPath = "" then
    IOSourceClose(LSource);
    return false;
  end;
  LEntry := DoZipFind(ptr to ZipTableData(LSource->UserData), LPath);
  if LEntry = nil then
    IOSourceClose(LSource);
    return false;
  end;
  LSize := LEntry->Uncompressed;
  LCrc := LEntry->Crc;
  IOSourceClose(LSource);
  AInfo.Size := LSize;
  AInfo.Crc := LCrc;
  return true;
end;

// The zip writer (ZipDirectoryContents), on minizip's zip side (System.Minizip.C) through the
// same bridge the zip source reads with (ZipBridge*), here over a file IO opened for writing:
// the archive and every file are read and written through System.Runtime's file handles, a
// folder walked with ListFolder and PathKind, an entry's date from FileLocalTime. minizip
// encrypts an entry itself (ZipCrypto) when it is given the password and the entry's CRC,
// so a file is read twice: its CRC first, then its bytes
public type
  // Called by ZipDirectoryContents for each entry it writes: once with APercent 0 and
  // ANewFile true before the entry's first byte, then with the percent of its bytes written
  // and ANewFile false (100 last; an empty file gets 0 then 100). AUserData is the pointer
  // given to ZipDirectoryContents, AEntry the entry's name in the archive (UTF-8, `/`
  // separated), APercent 0 to 100, ANewFile true on the entry's first call
  ZipProgress = func(const AUserData: ptr; const AEntry: string; const APercent: int32;
    const ANewFile: bool);

var
  // Why the last ZipDirectoryContents failed ("" when it succeeded): its step and the path
  GZipLastError: string;

// Records AText as the reason the zip write failed; false, for `return DoZipWriteFail(...)`
func DoZipWriteFail(const AText: string): bool;
begin
  GZipLastError := AText;
  return false;
end;

// APath (UTF-8; `$P:`, `$D:`, `$S:` as CreateFileIO takes them) made full by the runtime
// (FullPath: the working folder joined, "." and ".." folded as text), '/' between folders,
// no '/' at the end but a drive root's ("C:/"); "" when it cannot be made
func DoZipFullPath(const APath: string): string;
var
  LPath: string;
  LBlock: ptr;
  LCount: int64;
  LFull: string;
begin
  LPath := DoFilePath(APath);
  if LPath = "" then
    return "";
  end;
  LCount := 0;
  LBlock := FullPath(LPath, LCount);
  if LBlock = nil then
    return "";
  end;
  LFull := ReplaceStr(StringFromC(ptr to const char(LBlock), LCount), "\\", "/");
  freemem(LBlock);
  while (len(LFull) > 1) and EndsStr("/", LFull) and
    not ((len(LFull) = 3) and (LFull[1] = ':')) do
    LFull := Substring(LFull, 0, len(LFull) - 1);
  end;
  return LFull;
end;

// What is at the full path APath (PathKind's ADAM_PATH_* value); ADAM_PATH_NONE when the
// path has no C text (no room)
func DoZipPathKind(const APath: string): int32;
var
  LSize: int64;
  LKind: int32;
begin
  LSize := 0;
  LKind := PathKind(APath, LSize);
  return LKind;
end;

// True when the full path APath is itself a link (PathIsLink); false when the path has no C
// text (no room)
func DoZipIsLink(const APath: string): bool;
var
  LLink: bool;
begin
  LLink := PathIsLink(APath);
  return LLink;
end;

// AFolder's path with a '/' after it (a drive root has its own): the text every path below
// it starts with
func DoZipFolderPrefix(const AFolder: string): string;
begin
  if EndsStr("/", AFolder) then
    return AFolder;
  end;
  return AFolder + "/";
end;

// True when AText holds no byte of 0x80 or above
func DoZipIsAscii(const AText: string): bool;
var
  LI: int64;
begin
  for LI := 0 to len(AText) - 1 do
    if uint8(AText[LI]) >= 0x80 then
      return false;
    end;
  end;
  return true;
end;

// The names ListFolder gives for the full folder path AFolder into ANames; false (the reason
// recorded) when the folder cannot be listed
func DoZipFolderNames(const AFolder: string; var ANames: StringArray): bool;
var
  LBlock: ptr;
  LCount: int64;
  LChars: ptr to const char;
  LAt: int64;
  LLength: int64;
  LNames: int64;
begin
  setlength(ANames, 0);
  LCount := 0;
  LBlock := ListFolder(AFolder, LCount);
  if LBlock = nil then
    return DoZipWriteFail("cannot list " + AFolder);
  end;
  // Each name ends at its NUL
  LChars := ptr to const char(LBlock);
  LAt := 0;
  LNames := 0;
  while LAt < LCount do
    LLength := 0;
    while LChars[LAt + LLength] <> char(0) do
      LLength := LLength + 1;
    end;
    setlength(ANames, LNames + 1);
    ANames[LNames] := StringFromC(addr of LChars[LAt], LLength);
    LNames := LNames + 1;
    LAt := LAt + LLength + 1;
  end;
  freemem(LBlock);
  return true;
end;

// Every regular file below the full folder path AFolder (its subfolders walked too) added to
// AFiles as its full path, AArchive (the archive's full path) left out; a name that is gone
// by the time it is asked about is skipped. False (the reason recorded) when a folder cannot
// be listed
func DoZipWalk(const AFolder: string; const AArchive: string; var AFiles: StringArray): bool;
var
  LNames: StringArray;
  LI: int64;
  LPath: string;
  LKind: int32;
  LCount: int64;
begin
  if not DoZipFolderNames(AFolder, LNames) then
    return false;
  end;
  for LI := 0 to len(LNames) - 1 do
    LPath := DoZipFolderPrefix(AFolder) + LNames[LI];
    LKind := DoZipPathKind(LPath);
    if (LKind = ADAM_PATH_FILE) and (LPath <> AArchive) then
      LCount := len(AFiles);
      setlength(AFiles, LCount + 1);
      AFiles[LCount] := LPath;
    end;
    // A folder that is a link (a symbolic link, a junction) is not walked, as C++'s
    // recursive_directory_iterator does not: one that points above itself would never end
    if (LKind = ADAM_PATH_FOLDER) and not DoZipIsLink(LPath) then
      if not DoZipWalk(LPath, AArchive, AFiles) then
        return false;
      end;
    end;
  end;
  return true;
end;

// Every regular file below the full folder path AFolder into AFiles as its full path, in
// byte order of the paths (they share ARoot's prefix, so this is the byte order of the entry
// names: the same archive whatever order the system lists the files in), AArchive left
// out. False (the reason recorded) when AFolder is not inside ARoot, is no folder, or a
// folder cannot be listed
func DoZipListFiles(const AFolder: string; const ARoot: string; const AArchive: string;
  var AFiles: StringArray): bool;
begin
  setlength(AFiles, 0);
  // The folder must lie inside the root: the root itself, or a path below it
  if (AFolder <> ARoot) and not StartsStr(DoZipFolderPrefix(ARoot), AFolder) then
    return DoZipWriteFail(AFolder + " is not inside the root " + ARoot);
  end;
  // A missing folder or a file is no folder to pack
  if DoZipPathKind(AFolder) <> ADAM_PATH_FOLDER then
    return DoZipWriteFail(AFolder + " is not a folder");
  end;
  if not DoZipWalk(AFolder, AArchive, AFiles) then
    return false;
  end;
  SortStrings(AFiles);
  return true;
end;

// The file AFile's (C text) last write time in minizip's local date form (tm_mon 0..11,
// tm_year the full year) into ADate; 1980-01-01 (the earliest date an entry holds) when it
// cannot be read or lies before it
func DoZipFileTime(const AFile: ptr to const char; var ADate: tm_zip);
var
  LYear: int32;
  LMonth: int32;
  LDay: int32;
  LHour: int32;
  LMinute: int32;
  LSecond: int32;
begin
  ADate.tm_sec := 0;
  ADate.tm_min := 0;
  ADate.tm_hour := 0;
  ADate.tm_mday := 1;
  ADate.tm_mon := 0;
  ADate.tm_year := 1980;
  if not FileLocalTime(AFile, LYear, LMonth, LDay, LHour, LMinute, LSecond) then
    return;
  end;
  if LYear < 1980 then
    return;
  end;
  ADate.tm_sec := LSecond;
  ADate.tm_min := LMinute;
  ADate.tm_hour := LHour;
  ADate.tm_mday := LDay;
  ADate.tm_mon := LMonth - 1;
  ADate.tm_year := LYear;
end;

// Reports one step of an entry's progress, when a routine was handed in
func DoZipReport(const AProgress: ZipProgress; const AUserData: ptr; const AName: string;
  const APercent: int32; const ANewFile: bool);
var
  LProgress: ZipProgress;
begin
  LProgress := AProgress;
  if LProgress <> nil then
    LProgress(AUserData, AName, APercent, ANewFile);
  end;
end;

// AIO's CRC-32 and size, read through from its start in ABuffer's chunks, then AIO set back
// to its start (the password header needs the CRC before the data); false (the reason
// recorded) when the file APath cannot be read
func DoZipFileCrc(const AIO: IO; const APath: string; const ABuffer: ptr to uint8;
  var ACrc: uint32; var ASize: int64): bool;
var
  LGot: int64;
begin
  ACrc := 0;
  ASize := 0;
  LGot := ADAM_CUSTOMIO_ZIP_WRITE_CHUNK;
  while LGot = ADAM_CUSTOMIO_ZIP_WRITE_CHUNK do
    LGot := IOReadFull(AIO, ptr(ABuffer), ADAM_CUSTOMIO_ZIP_WRITE_CHUNK);
    if LGot > 0 then
      ACrc := uint32(crc32(uLong(ACrc), ABuffer, uInt(LGot)));
      ASize := ASize + LGot;
    end;
  end;
  // The last read stopped short: at the end (Eof) or on an error
  if IOStatus(AIO) = IOState.Error then
    return DoZipWriteFail("cannot read " + APath);
  end;
  if IOSeek(AIO, 0, SeekOrigin.FromStart) <> 0 then
    return DoZipWriteFail("cannot read " + APath + " again");
  end;
  return true;
end;

// Begins the entry AName for the file APath in AZip: deflated at the best level, its file's
// date, ZipCrypto with APassword ("" for none) over ACrc, bit 11 for a name that is
// not ASCII, ZIP64 for ASize bytes past the 32-bit sizes. False (the reason recorded) when
// minizip refuses it
func DoZipOpenEntry(const AZip: zipFile; const APath: string; const AName: string;
  const APassword: string; const ACrc: uint32; const ASize: int64): bool;
var
  LPassword: CString;
  LInfo: zip_fileinfo;
  LFlags: uint32;
  LZip64: int32;
  LResult: int32;
begin
  DoZero(ptr to uint8(ptr(addr of LInfo)), size(zip_fileinfo));
  DoZipFileTime(APath, LInfo.tmz_date);
  LFlags := 0;
  if not DoZipIsAscii(AName) then
    LFlags := ADAM_CUSTOMIO_ZIP_UTF8_FLAG;
  end;
  LZip64 := 0;
  if ASize >= ADAM_CUSTOMIO_ZIP64_LIMIT then
    LZip64 := 1;
  end;
  // minizip takes nil for no password
  LPassword := CString(APassword);
  LResult := zipOpenNewFileInZip4_64(AZip, AName, addr of LInfo, nil, 0,
    nil, 0, nil, Z_DEFLATED, Z_BEST_COMPRESSION, 0, -MAX_WBITS, DEF_MEM_LEVEL,
    Z_DEFAULT_STRATEGY, LPassword.OrNil, uLong(ACrc), 0, uLong(LFlags), LZip64);
  if LResult <> ZIP_OK then
    return DoZipWriteFail("cannot start the entry " + AName + " in the archive");
  end;
  return true;
end;

// AIO's bytes (ASize of them, its CRC taken already) written into the entry AName begun in
// AZip, the progress reported before the first byte and after each chunk. False (the reason
// recorded) when a write fails, the file APath cannot be read, or it is no longer ASize
// bytes long (it changed between the two reads)
func DoZipEntryData(const AZip: zipFile; const AIO: IO; const APath: string;
  const AName: string; const ABuffer: ptr to uint8; const ASize: int64;
  const AProgress: ZipProgress; const AUserData: ptr): bool;
var
  LGot: int64;
  LDone: int64;
begin
  DoZipReport(AProgress, AUserData, AName, 0, true);
  LDone := 0;
  LGot := ADAM_CUSTOMIO_ZIP_WRITE_CHUNK;
  while LGot = ADAM_CUSTOMIO_ZIP_WRITE_CHUNK do
    LGot := IOReadFull(AIO, ptr(ABuffer), ADAM_CUSTOMIO_ZIP_WRITE_CHUNK);
    if LGot > 0 then
      if zipWriteInFileInZip(AZip, ptr(ABuffer), uint32(LGot)) <> ZIP_OK then
        return DoZipWriteFail("cannot write the entry " + AName + " into the archive");
      end;
      LDone := LDone + LGot;
      // Past ASize the file grew: it is no longer the file whose CRC was taken
      if LDone > ASize then
        return DoZipWriteFail(APath + " changed while it was packed");
      end;
      // ASize > 0 here: LDone is above 0 and at most ASize
      DoZipReport(AProgress, AUserData, AName, int32((LDone * 100) div ASize), false);
    end;
  end;
  if IOStatus(AIO) = IOState.Error then
    return DoZipWriteFail("cannot read " + APath);
  end;
  if LDone <> ASize then
    return DoZipWriteFail(APath + " changed while it was packed");
  end;
  if ASize = 0 then
    DoZipReport(AProgress, AUserData, AName, 100, false);
  end;
  return true;
end;

// Writes the file APath as the entry AName: its CRC read in a first pass, then the entry
// begun and its bytes written, the entry always closed once begun. False (the reason
// recorded) when the file cannot be read, changed between the passes, or the entry cannot
// be written
func DoZipAddFile(const AZip: zipFile; const APath: string; const AName: string;
  const APassword: string; const ABuffer: ptr to uint8; const AProgress: ZipProgress;
  const AUserData: ptr): bool;
var
  LIO: IO;
  LCrc: uint32;
  LSize: int64;
  LOk: bool;
  LClosed: int32;
begin
  LIO := DoOpenFile(APath, FileMode.Read);
  if LIO = nil then
    return DoZipWriteFail("cannot open " + APath);
  end;
  LOk := DoZipFileCrc(LIO, APath, ABuffer, LCrc, LSize);
  if LOk then
    LOk := DoZipOpenEntry(AZip, APath, AName, APassword, LCrc, LSize);
    if LOk then
      LOk := DoZipEntryData(AZip, LIO, APath, AName, ABuffer, LSize, AProgress, AUserData);
      // Called whatever the writes gave: a begun entry is always closed
      LClosed := zipCloseFileInZip(AZip);
      if (LClosed <> ZIP_OK) and LOk then
        LOk := DoZipWriteFail("cannot finish the entry " + AName + " in the archive");
      end;
    end;
  end;
  IOClose(LIO);
  return LOk;
end;

// Every file of AFiles (full paths, each starting with the root's APrefixCount-byte prefix,
// which the entry's name drops) added to AZip in order; false (the reason recorded) at the
// first that fails
func DoZipWriteEntries(const AZip: zipFile; const AFiles: StringArray;
  const APrefixCount: int64; const APassword: string; const ABuffer: ptr to uint8;
  const AProgress: ZipProgress; const AUserData: ptr): bool;
var
  LI: int64;
  LPath: string;
  LName: string;
begin
  for LI := 0 to len(AFiles) - 1 do
    LPath := AFiles[LI];
    LName := Substring(LPath, APrefixCount, len(LPath) - APrefixCount);
    if not DoZipAddFile(AZip, LPath, LName, APassword, ABuffer, AProgress, AUserData) then
      return false;
    end;
  end;
  return true;
end;

// The archive AArchive (a full path) written new with AFiles' entries through minizip's zip
// side over a file IO and the bridge; the archive is always closed once begun. False (the
// reason recorded) when it cannot be created, an entry fails, or its directory cannot be
// written (an archive begun is then incomplete)
func DoZipWriteArchive(const AArchive: string; const AFiles: StringArray;
  const APrefixCount: int64; const APassword: string; const ABuffer: ptr to uint8;
  const AProgress: ZipProgress; const AUserData: ptr): bool;
var
  LIO: IO;
  LArchive: ZipArchiveData;
  LBridge: ZipBridgeData;
  LFuncs: zlib_filefunc64_def;
  LZip: zipFile;
  LOk: bool;
  LClosed: int32;
begin
  LIO := DoOpenFile(AArchive, FileMode.Write);
  if LIO = nil then
    return DoZipWriteFail("cannot create the archive " + AArchive);
  end;
  // The bridge's archive record is this routine's own: nothing else holds it, so it is
  // never let go through DoZipLetGo, and the IO is closed here
  LArchive.Stream := LIO;
  LArchive.Owned := false;
  LArchive.Refs := 1;
  LBridge.Archive := addr of LArchive;
  LBridge.Failed := false;
  DoZero(ptr to uint8(ptr(addr of LFuncs)), size(zlib_filefunc64_def));
  LFuncs.zopen64_file := ZipBridgeOpen;
  LFuncs.zread_file := ZipBridgeRead;
  LFuncs.zwrite_file := ZipBridgeWrite;
  LFuncs.ztell64_file := ZipBridgeTell;
  LFuncs.zseek64_file := ZipBridgeSeek;
  LFuncs.zclose_file := ZipBridgeClose;
  LFuncs.zerror_file := ZipBridgeError;
  LFuncs.opaque := ptr(addr of LBridge);
  // The path is unused: the bridge's open hands back the open archive
  LZip := zipOpen2_64(ptr to const char(""), APPEND_STATUS_CREATE, nil, addr of LFuncs);
  if LZip = nil then
    IOClose(LIO);
    return DoZipWriteFail("cannot create the archive " + AArchive);
  end;
  LOk := DoZipWriteEntries(LZip, AFiles, APrefixCount, APassword, ABuffer, AProgress,
    AUserData);
  // Called whatever the entries gave: the archive is always closed
  LClosed := zipClose(LZip, nil);
  if (LClosed <> ZIP_OK) and LOk then
    LOk := DoZipWriteFail("cannot finish the archive " + AArchive + " (its directory)");
  end;
  if not IOClose(LIO) and LOk then
    LOk := DoZipWriteFail("cannot finish the archive " + AArchive);
  end;
  return LOk;
end;

// The listed AFiles written into AArchive (full paths; ARoot the full root, whose prefix the
// entry names drop), with the chunk buffer made here and freed again
func DoZipWrite(const AArchive: string; const ARoot: string; const AFiles: StringArray;
  const APassword: string; const AProgress: ZipProgress; const AUserData: ptr): bool;
var
  LBuffer: ptr to uint8;
  LOk: bool;
begin
  LBuffer := ptr to uint8(getmem(ADAM_CUSTOMIO_ZIP_WRITE_CHUNK));
  if LBuffer = nil then
    return DoZipWriteFail("out of memory");
  end;
  LOk := DoZipWriteArchive(AArchive, AFiles, len(DoZipFolderPrefix(ARoot)), APassword,
    LBuffer, AProgress, AUserData);
  freemem(LBuffer);
  return LOk;
end;

// Writes every file under a folder (its subfolders too) into a new zip archive (Delphi's
// TZipFile.ZipDirectoryContents, archive first): deflated at the best level, each entry
// ZipCrypto encrypted with APassword unless it is "", with its file's modification time, the
// entries in byte order of their names (the same archive whatever order the system lists
// the files in). An entry is named by its file's path below ARoot with `/` (ARoot "" =
// AFolder itself): ZipDirectoryContents("$P:assets.zip", "$P:res/assets", "secret", "$P:")
// names them res/assets/... A name that is not ASCII is stored as UTF-8 (general purpose
// bit 11); a file of 4 GB or more is stored as ZIP64. Every path is UTF-8 and taken as
// CreateFileIO takes it (`$P:`, `$D:`, `$S:`), then made full ("." and ".." folded). An
// archive inside AFolder is left out; an existing archive is replaced. AProgress (nil for
// none) is called for each entry's progress with AUserData. The result reads back with
// CreateZipIOSource / CreateZipFileIO. True when every file is in the archive; false (the
// reason in ZipLastError) when AFolder is not an existing folder inside ARoot (no archive is
// written then), a file cannot be read or the archive cannot be written (an archive begun is
// then incomplete)
public func cpplink ZipDirectoryContents(const AArchive: string; const AFolder: string;
  const APassword: string; const ARoot: string; const AProgress: ZipProgress;
  const AUserData: ptr): bool;
var
  LFolder: string;
  LRoot: string;
  LArchive: string;
  LFiles: StringArray;
begin
  GZipLastError := "";
  LFolder := DoZipFullPath(AFolder);
  if LFolder = "" then
    return DoZipWriteFail(AFolder + " is not a folder");
  end;
  LRoot := LFolder;
  if ARoot <> "" then
    LRoot := DoZipFullPath(ARoot);
    if LRoot = "" then
      return DoZipWriteFail(LFolder + " is not inside the root " + ARoot);
    end;
  end;
  // The archive's full path is known before the walk, so a listing leaves it out
  LArchive := DoZipFullPath(AArchive);
  if not DoZipListFiles(LFolder, LRoot, LArchive, LFiles) then
    return false;
  end;
  if LArchive = "" then
    return DoZipWriteFail("cannot create the archive " + AArchive);
  end;
  return DoZipWrite(LArchive, LRoot, LFiles, APassword, AProgress, AUserData);
end;

// Writes every file under a folder into a new zip archive, its entries named below ARoot,
// with no progress routine (ZipDirectoryContents(AArchive, AFolder, APassword, ARoot, nil,
// nil))
public func cpplink ZipDirectoryContents(const AArchive: string; const AFolder: string;
  const APassword: string; const ARoot: string): bool;
begin
  return ZipDirectoryContents(AArchive, AFolder, APassword, ARoot, nil, nil);
end;

// Writes every file under a folder into a new zip archive, its entries named below the
// folder itself, with no progress routine (ZipDirectoryContents(AArchive, AFolder,
// APassword, "", nil, nil))
public func cpplink ZipDirectoryContents(const AArchive: string; const AFolder: string;
  const APassword: string): bool;
begin
  return ZipDirectoryContents(AArchive, AFolder, APassword, "", nil, nil);
end;

// Writes every file under a folder into a new zip archive with no password, its entries
// named below the folder itself, with no progress routine (ZipDirectoryContents(AArchive,
// AFolder, "", "", nil, nil))
public func cpplink ZipDirectoryContents(const AArchive: string; const AFolder: string): bool;
begin
  return ZipDirectoryContents(AArchive, AFolder, "", "", nil, nil);
end;

// Why the last ZipDirectoryContents failed: the step and the path ("cannot create the
// archive ...", "... is not a folder", "... changed while it was packed"); "" when it
// succeeded. The runtime reports no system error text, so a reason names the step only
public func cpplink ZipLastError(): string;
begin
  return GZipLastError;
end;

end.
