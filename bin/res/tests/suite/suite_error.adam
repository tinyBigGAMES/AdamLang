-------------------------------------------------------------------------------
  suite_error.adam - adamtest's error kind: the reports adam gives are
  exactly the markers (one with its column and text, one in a block comment
  with its column only), and adam exits 1
*******************************************************************************/

/*
@@test
  kind error
  -- a '#' is no token (LX0004); a string's "//" is no marker
@@end
*/

module exe suite_error;

var
  G: string;

begin
  G := "// ERROR LX9999";
# // ERROR LX0004@1: unexpected character '#'
  G := "x"; # /* // ERROR LX0004@13 // */
end.
