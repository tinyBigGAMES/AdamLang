/*
@@test
  kind cli
  args "--no-banner" "help" "pack"
  exitcode 0
  | USAGE:
  |   adam pack [<folder>] [options]
  |
  | Zip the assets folder of the project whose project.toml is in <folder> (default: the current folder) into <name>.dat in its output folder, with its pack password
  |
  | OPTIONS:
  |   --no-banner  Print no banner: for scripts and tests
  |   -q, --quiet  Print only the reports: no banner, no phase or status lines (scripts, tests)
  |   --heap       Print adam's own heap report as it ends (allocations, frees, what leaked)
  |   -h, --help   Show the help of the command given (else adam's)
  |
  | EXAMPLES:
  |   adam pack mygame
@@end
*/

module exe suite_cli_help_pack;

begin
end.
