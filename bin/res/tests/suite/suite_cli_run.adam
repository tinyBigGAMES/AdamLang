-------------------------------------------------------------------------------
  suite_cli_run.adam - build -r: the build's phase and status lines first
  (flushed before the program starts), then the program itself on adam's
  own stdout: the arguments after '--' as it got them (one with a blank,
  one that looks like an adam option: both its own), its heap line, and
  adam's exit code is the program's (3)
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--no-banner" "<DIR>/suite_cli_run.adam" "-o" "." "-r" "--" "a" "b c" "-q"
  exitcode 3
  | Parsed 1 unit (<NUM> lines), 3 from .acu in <NUM>s
  | Analyzed in <NUM>s
  | Lowered <NUM> units (<NUM> routines) in <NUM>s
  | Generated <NUM> bytes of code in <NUM>s
  | Linked suite_cli_run.exe (libraries: 3) in <NUM>s
  | Built <DIR>/suite_cli_run.adam -> <OUT>/bin/<CELL>/suite_cli_run.exe in <NUM>s
  | [a]
  | [b c]
  | [-q]
  | [Heap] Allocs: 3, Frees: 3, Leaked: 0
@@end
*/

module exe suite_cli_run;

routine exit(const ACode: int32); external "ucrtbase";

// Every argument in brackets, one a line; in a routine of its own so its strings are released
// when it returns, before exit ends the process
routine ShowArguments();
var
  LIndex: int32;
begin
  for LIndex := 1 to paramcount() do
    println("[{}]", paramstr(LIndex));
  end;
end;

begin
  ShowArguments();
  exit(3);
end.
