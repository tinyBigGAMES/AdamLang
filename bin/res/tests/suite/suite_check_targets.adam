-------------------------------------------------------------------------------
  suite_check_targets.adam - adamtest's check kind with a targets line (LX7b):
  adam check -t <triple> for each target, each its own cell, one set of
  markers for all; each cell takes its own target's lines under @ifdef
*******************************************************************************/

/*
@@test
  kind check
  targets x86_64-windows-gnu x86_64-linux-gnu
@@end
*/

module exe suite_check_targets;

const
  // Each target's own line: the cell checks the one its -t defines
@ifdef TARGET_X86_64_LINUX_GNU
  ROW_TARGET: string = "x86_64-linux-gnu";
@else
  ROW_TARGET: string = "x86_64-windows-gnu";
@endif

begin
  println("{}", ROW_TARGET);
end.
