-------------------------------------------------------------------------------
  suite_err_duplicate.adam - a name declared twice in one scope (SM0004,
  reported at each later declaration against the first): a module variable
  and a constant, a routine's locals (a third declaration of a name too), a
  var block among statements; overloads and a forward type with its
  declaration are no duplicates.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe suite_err_duplicate;

forward type TNode;

type
  TNode = record
    N: int32;
  end;

var
  GA: int32;
  GB: int32;

const
  GB: int32 = 1; // ERROR SM0004@3: 'GB' is already declared in this scope (first at line 40)

// Two overloads share a name
func Twice(const AValue: int32): int32;
begin
  return AValue * 2;
end;

func Twice(const AValue: int64): int64;
begin
  return AValue * 2;
end;

func Locals(const AValue: int32);
var
  LX: int32;
  LY: int32;
  LX: int64; // ERROR SM0004@3: 'LX' is already declared in this scope (first at line 58)
  LX: bool; // ERROR SM0004@3: 'LX' is already declared in this scope (first at line 58)
begin
  LY := AValue;
  if LY > 0 then
    var LZ: int32;
    var LZ: int64; // ERROR SM0004@9: 'LZ' is already declared in this scope (first at line 65)
    LZ := 1;
  end;
end;

begin
  Locals(Twice(2));
end.
