-------------------------------------------------------------------------------
  suite_deps_helper.adam - a dep test with a dep of its own
  (suite_deps_base, built before it): suite_deps names only this one, so
  the base is reached through the chain. suite_deps runs the exe it writes
  with one argument and shows its output.
*******************************************************************************/

/*
@@test
  kind dep
  deps suite.suite_deps_base
@@end
*/

module exe suite_deps_helper;

begin
  println("helper built, argument [{}]", paramstr(1));
end.
