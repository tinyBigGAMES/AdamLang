/*
@@test
  kind cli
  args "--no-banner" "help" "lsp"
  exitcode 0
  | USAGE:
  |   adam lsp [options]
  |
  | Serve the Language Server Protocol on stdin / stdout, for an editor's diagnostics
  |
  | OPTIONS:
  |   --no-banner  Print no banner: for scripts and tests
  |   -q, --quiet  Print only the reports: no banner, no phase or status lines (scripts, tests)
  |   -h, --help   Show the help of the command given (else adam's)
  |
  | EXAMPLES:
  |   adam lsp
@@end
*/

module exe suite_cli_help_lsp;

begin
end.
