-------------------------------------------------------------------------------
  suite_error_targets.adam - adamtest's error kind with a targets line (LX7b):
  adam check -t <triple> for each target, each its own cell; the reports
  each gives are exactly the markers, and adam exits 1 in each
*******************************************************************************/

/*
@@test
  kind error
  targets x86_64-windows-gnu x86_64-linux-gnu
  -- a '#' is no token (LX0004), on either target
@@end
*/

module exe suite_error_targets;

var
  G: string;

begin
  G := "x"; # // ERROR LX0004@13: unexpected character '#'
end.
