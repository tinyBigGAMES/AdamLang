-------------------------------------------------------------------------------
  suite_cli_dotted.adam - a main module whose name holds a '.': the name
  with .adam added wins when that file is there, so `adam check
  <BIN>/res/libs/std/System.SysUtils` reads System.SysUtils.adam (never
  System.adam): its report names that file (a unit is no main module,
  PR0004), exit 1 (PLAN-EXT X3)
*******************************************************************************/

/*
@@test
  kind cli
  args "check" "--quiet" "<BIN>/res/libs/std/System.SysUtils"
  exitcode 1
  | <BIN>/res/libs/std/System.SysUtils.adam(<NUM>,<NUM>): Error PR0004: the unit 'System.SysUtils' cannot be the main module: a unit builds nothing of its own
@@end
*/

module exe suite_cli_dotted;

begin
end.
