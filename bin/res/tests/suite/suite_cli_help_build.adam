/*
@@test
  kind cli
  args "--no-banner" "help" "build"
  exitcode 0
  | USAGE:
  |   adam build <file> [options]
  |
  | Build the program whose main module is <file> into an exe
  |
  | OPTIONS:
  |   -o, --output <dir>  The exe's folder (else the main module's @outputpath, else output under the working folder)
  |   --no-banner         Print no banner: for scripts and tests
  |   -h, --help          Show the help of the command given (else adam's)
  |
  | EXAMPLES:
  |   adam build hello.adam
  |   adam build hello.adam -o bin
@@end
*/

module exe suite_cli_help_build;

begin
end.
