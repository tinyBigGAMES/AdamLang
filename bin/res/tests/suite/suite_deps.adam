-------------------------------------------------------------------------------
  suite_deps.adam - adamtest's deps: this run row names one dep,
  suite_deps_helper, whose own dep is suite_deps_base. Both are built into
  the output root before this row builds (the base first), never counted
  in the tally. The row runs each exe they wrote (args: the output root,
  then the two exes) and shows its exit code and every line it printed, so
  it passes only when both were built.
*******************************************************************************/

/*
@@test
  kind run
  deps suite.suite_deps_helper
  args "<OUT>" "<OUT>/suite_deps_helper.exe" "<OUT>/suite_deps_base.exe"
  | suite_deps_helper.exe: started, exit 0
  | > helper built, argument [from suite_deps]
  | > [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | suite_deps_base.exe: started, exit 0
  | > base built, 1 argument(s)
  | > [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe suite_deps;

import System.SysUtils, System.Windows;

// Runs the exe APath in AWorkDir with one argument, then shows its exit code and each line it
// printed (a blank one dropped)
routine RunOne(const APath: string; const AWorkDir: string);
var
  LArgs: StringArray;
  LOutput: string;
  LExit: uint32;
  LLines: StringArray;
  LI: int64;
begin
  setlength(LArgs, 1);
  LArgs[0] := "from suite_deps";
  LOutput := "";
  LExit := 0;
  if not RunProcess(APath, LArgs, AWorkDir, LOutput, LExit) then
    println("{}: not started", ExtractFileName(APath));
    return;
  end;
  println("{}: started, exit {}", ExtractFileName(APath), LExit);
  LLines := SplitString(LOutput, "\n");
  for LI := 0 to len(LLines) - 1 do
    if TrimRight(LLines[LI]) <> "" then
      println("> {}", TrimRight(LLines[LI]));
    end;
  end;
end;

begin
  RunOne(paramstr(2), paramstr(1));
  RunOne(paramstr(3), paramstr(1));
end.
