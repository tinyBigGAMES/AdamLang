  suite_cli_host_linux_dap.adam - `adam dap` on a Linux host (LX7a, LX7b):
  the host has no debugger part, so the command is CL0033 (not an unknown
  command), exit 2
*******************************************************************************/

/*
@@test
  kind cli
  targets x86_64-linux-gnu
  args "dap"
  exitcode 2
  | Error CL0033: 'dap' is not available on this host: this adam has no debugger for x86_64-linux-gnu programs
@@end
*/

module exe suite_cli_host_linux_dap;

begin
end.
