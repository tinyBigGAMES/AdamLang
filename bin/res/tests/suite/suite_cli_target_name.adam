@@test
  kind cli
  args "--no-banner" "-t" "win64" "build" "<DIR>/suite_cli_target_name.adam" "-o" "."
  exitcode 2
  | Error CL0009: 'win64' is not a target; the targets: x86_64-windows-gnu, x86_64-linux-gnu; see 'adam help build'
@@end
*/

module exe suite_cli_target_name;

begin
end.
