  suite_cli.adam - adamtest's cli kind: adam run with args, its exit code
  and output lines compared. A command line mistake (check with no file):
  the banner first, then one Error line naming the help to see, exit 2
*******************************************************************************/

/*
@@test
  kind cli
  args "check"
  exitcode 2
  | Adam v0.1.0
  |
  | Error CL0003: 'check' needs the main module's file: adam check <file>; see 'adam help check'
@@end
*/

module exe suite_cli;

begin
end.
