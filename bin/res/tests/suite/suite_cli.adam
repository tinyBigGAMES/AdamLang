/*
@@test
  kind cli
  args "check"
  exitcode 2
  | Error CL0003: 'check' needs the main module's file: adam check <file>
  | Hint CL0001: usage: adam build <file> [-o <dir>] (the program whose main module is <file> built into <dir>, else the folder its @outputpath names, else output under the working folder); adam check <file> (the front end on the program whose main module is <file>, its diagnostics printed); adam help
@@end
*/

module exe suite_cli;

begin
end.
