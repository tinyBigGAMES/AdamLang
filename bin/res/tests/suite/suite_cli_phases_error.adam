-------------------------------------------------------------------------------
  suite_cli_phases_error.adam - a build that fails in Analyze (a name
  declared nowhere): the Parse line, then no phase line from the one that
  failed on, then the report; no status line, exit 1
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--no-banner" "<DIR>/suite_cli_phases_error.adam" "-o" "."
  exitcode 1
  | Parsed 1 unit (<NUM> lines), 4 from .acu in <NUM>s
  | <DIR>/suite_cli_phases_error.adam(34,3): Error SM0021: 'NotDeclaredAnywhere' is not declared
@@end
*/

module exe suite_cli_phases_error;

begin
  NotDeclaredAnywhere := 1;
end.
