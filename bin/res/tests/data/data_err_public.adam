-------------------------------------------------------------------------------
  data_err_public.adam - Break step of data_public (BNF row 20). pcpp's
  `exported` is no keyword since 2026-11-07: before a routine at module
  level it is a bare identifier where a declaration must start (PR0001),
  and the routine after it is still read. A private declaration of the
  unit fixtures\PublicUnit.adam is not reached through it (SM0006), a name
  it does not hold is SM0005; each is reported once, at the qualified name
  (the type pass says nothing more about it or about the unit before it).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_public;

@addmodulepath "$P:res/tests/data/fixtures";

import PublicUnit;

exported routine Gone(); // ERROR PR0001@1: expected a declaration (var, const, type, routine, forward or public), found 'exported'
begin
end;

var
  GValue: int32;

begin
  GValue := PublicUnit.PrivateLimit; // ERROR SM0006@13: 'PrivateLimit' is not public in 'PublicUnit'
  GValue := PublicUnit.NoSuchLimit; // ERROR SM0005@13: 'PublicUnit' has no 'NoSuchLimit'
end.
