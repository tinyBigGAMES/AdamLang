-------------------------------------------------------------------------------
  data_strconst_bytes.adam - A string literal or constant to a C string of
  8-bit integers (BNF sec 4, his OK 2026-11-22, PLAN-XML X2b): a string
  const passes to a ptr to const uint8 / int8 as to a ptr to const char (its
  text and a NUL, read-only), through an alias of uint8 (libxml2's xmlChar)
  too; a literal so, an assignment to a ptr to const uint8 variable, a
  pointer cast of a literal
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | uint8 5
  | int8 3
  | alias 5
  | var 120 3
  | cast 2
  | joined 6
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe data_strconst_bytes;

type
  // libxml2's character type: C's unsigned char
  xmlChar = uint8;

const
  GREETING: string = "hello";
  JOINED: string = "ab" + "cdef";

// The length of the C string P of unsigned bytes, to its NUL
routine ULen(const P: ptr to const uint8): int64;
var
  LI: int64;
begin
  LI := 0;
  while P[LI] <> 0 do
    LI := LI + 1;
  end;
  return LI;
end;

// The length of the C string P of signed bytes, to its NUL
routine SLen(const P: ptr to const int8): int64;
var
  LI: int64;
begin
  LI := 0;
  while P[LI] <> 0 do
    LI := LI + 1;
  end;
  return LI;
end;

// The length of the xmlChar string P, to its NUL
routine XLen(const P: ptr to const xmlChar): int64;
var
  LI: int64;
begin
  LI := 0;
  while P[LI] <> 0 do
    LI := LI + 1;
  end;
  return LI;
end;

var
  LBytes: ptr to const uint8;
begin
  println("uint8 {}", ULen(GREETING));
  println("int8 {}", SLen("abc"));
  println("alias {}", XLen(GREETING));
  LBytes := "xyz";
  println("var {} {}", LBytes[0], ULen(LBytes));
  println("cast {}", ULen(ptr to const uint8("hi")));
  println("joined {}", ULen(JOINED));
end.
