-------------------------------------------------------------------------------
  data_init.adam - Data: module variables whose initializers are not
  constant (M3.4b). They run before the program block: every module's
  after the modules it imports, each module once, each module's in
  declaration order. This module imports InitUnit before InitBase, and
  InitUnit imports InitBase, so the trace lines 1 (InitBase), 2 and 3
  (InitUnit), 4 (here) prove the order; 100 opens the block. The values
  show each initializer read what the one before it set; a constant
  initializer (GFolded) runs nothing; a conversion lands at its own width
  (GNarrow); one that computes zero (GZeroLater) stays zero; a variable set
  by its initializer is written again in the block.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 1
  | 2
  | 3
  | 4
  | 100
  | 10
  | 15
  | 30
  | 10
  | 31
  | 8
  | -15
  | 0
  | 41
@@end
*/

module exe data_init;

@addmodulepath "$P:res/tests/data/fixtures";

import InitUnit, InitBase;

// Its line (4), then GSecond plus one
routine MainValue(): int64;
begin
  Trace(4);
  return GSecond + 1;
end;

var
  GMain: int64 = MainValue();
  GFolded: int32 = 4 * 2;
  GNarrow: int8 = int8(-GUnit);
  GZeroLater: int32 = GBase - 10;

begin
  Trace(100);
  Trace(GBase);
  Trace(GUnit);
  Trace(GSecond);
  Trace(GCopy);
  Trace(GMain);
  Trace(GFolded);
  Trace(GNarrow);
  Trace(GZeroLater);
  GMain := GMain + GBase;
  Trace(GMain);
end.
