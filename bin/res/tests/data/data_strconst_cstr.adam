-------------------------------------------------------------------------------
  data_strconst_cstr.adam - A string constant to a C string (BNF sec 4,
  user 2026-11-17, M9i): a string const passes to a ptr to const char as
  the literal it holds does (its text and a NUL, read-only), a wstring
  const to a ptr to const wchar; a parenthesized one, a folded
  concatenation, an assignment to a ptr to const char variable
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | text hello 5
  | wide 4
  | var hello
  | paren 5
  | joined 6
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe data_strconst_cstr;

import System.SysUtils;

const
  GREETING: string = "hello";
  WIDE: wstring = "wide";
  JOINED: string = "ab" + "cdef";

// The C string P's length, to its NUL
func CLen(const P: ptr to const char): int64;
var
  LI: int64;
begin
  LI := 0;
  while P[LI] <> char(0) do
    LI := LI + 1;
  end;
  return LI;
end;

// The wide C string P's length in units, to its NUL unit
func WLen(const P: ptr to const wchar): int64;
var
  LI: int64;
begin
  LI := 0;
  while P[LI] <> wchar(0) do
    LI := LI + 1;
  end;
  return LI;
end;

var
  LText: ptr to const char;
begin
  println("text {} {}", StringFromC(GREETING), CLen(GREETING));
  println("wide {}", WLen(WIDE));
  LText := GREETING;
  println("var {}", StringFromC(LText));
  println("paren {}", CLen((GREETING)));
  println("joined {}", CLen(JOINED));
end.
