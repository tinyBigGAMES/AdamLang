-------------------------------------------------------------------------------
  data_sections.adam - Data: initialize and finalize sections (M3.4c). The
  run order: every module variable's initializer (11, SectUnit's GEarly,
  reading GStage before any section set it: 0), then the initialize chain
  with every import before its importer (10 SectBase, 21 SectUnit after an
  early `return;`, 32 here), the program block (100, GEarly's 0), then the
  finalize chain in reverse (39 here, 29 SectUnit, 19 SectBase). This module
  imports SectUnit before SectBase, so only a computed order gets it right.
  The block leaves by `return;`: the finalize chain still runs (999 never
  shows) and the exit code stays 0.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 11
  | 10
  | 21
  | 32
  | 100
  | 0
  | 39
  | 29
  | 19
  | [Adam Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe data_sections;

@addmodulepath "$P:res/tests/data/fixtures";

import SectUnit, SectBase;

initialize
begin
  Trace(30 + GStage);
end;

finalize
begin
  Trace(39);
end;

begin
  Trace(100);
  Trace(GEarly);
  if GStage = 2 then
    return;
  end;
  Trace(999);
end.
