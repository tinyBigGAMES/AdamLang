-------------------------------------------------------------------------------
  data_err_decls.adam - Break step of declarations (AUD4 5.5): a forward
  type held by value before its full declaration (SM0300; behind ptr to,
  ref or a routine type's parameter it is fine, and by value once the full
  one is declared), an external variable given an initializer (SM0301) or
  declared in a body or a routine (SM0302), a const whose value is a call or
  a variable (SM0202), and a body variable reusing a parameter's or a
  local's name (SM0004: a body's own statements share its routine's scope)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_decls;

forward type TNode;

type
  TBox = record
    Item: TNode; // ERROR SM0300@11
    Items: array[0..1] of TNode; // ERROR SM0300@27
    Link: ptr to TNode;
    Visit: routine(const AN: TNode): int32;
  end;
  TNode = record
    Value: int32;
    Next: ptr to TNode;
  end;
  TLater = record
    Node: TNode;
  end;

var
  data_err_counter: int32 = 1; external; // ERROR SM0301@29
  GCount: int32 = 3;

routine Three(): int32;
begin
  return 3;
end;

const
  CCall: int32 = Three(); // ERROR SM0202@18
  CVar: int32 = GCount; // ERROR SM0202@17
  CFold: int32 = 2 * 3 + 1;
  CText: string = "a" + "b";

routine Use(const AP: int32): int32;
var
  LN: int32 = 1;
  data_err_local: int32; external; // ERROR SM0302@3
begin
  var LN: int32 = 2; // ERROR SM0004@7
  var AP: int32 = 3; // ERROR SM0004@7
  var data_err_body: int32; external; // ERROR SM0302@7
  return LN + AP;
end;

begin
end.
