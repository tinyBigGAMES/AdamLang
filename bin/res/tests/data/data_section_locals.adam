-------------------------------------------------------------------------------
  data_section_locals.adam - Data: initialize and finalize sections with
  their own local blocks (BNF sec 1: a section is a routine body; AUD3 /
  AUDIT 2.8). The imported unit's sections first (fixtures\SectLocals: var,
  const and type blocks, an early `return;`), then this module's initialize:
  a const, a type and a var block, an object with a done (ended as the
  section ends), a string and a type block among its statements; the
  program block; then the finalize chain in reverse, each with a var block.
  Every string is released: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | unit 41
  | init 7 ab 3
  | init done
  | body
  | final 9
  | unit finalize
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe data_section_locals;

@addmodulepath "$P:res/tests/data/fixtures";

import SectLocals;

initialize
const
  CSeven: int32 = 7;
type
  TNote = object
    S: string;

    done;
    begin
      println("init {}", self.S);
    end;
  end;
var
  LNote: TNote;
  LText: string;
  LN: int32;
begin
  LText := "a";
  LText := LText + "b";
  type TSmall = int8;
  var LSmall: TSmall = 3;
  println("init {} {} {}", CSeven, LText, LSmall);
  LNote.S := "done";
  LN := CSeven;
end;

finalize
var
  LN: int32;
begin
  LN := 9;
  println("final {}", LN);
end;

begin
  println("body");
end.
