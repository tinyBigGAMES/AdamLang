-------------------------------------------------------------------------------
  data_err_strconst_cstr.adam - Break step of a string constant to a C
  string (BNF sec 4, M9i): only a constant converts (its text is known when
  the program is built); a string variable stored into a ptr local is not
  kept alive (SM0759, PLAN-RAVENAPI F4: keep it in a CString; as an argument
  it is borrowed for the call, F3); never a string const to a ptr to const wchar or a wstring const to
  a ptr to const char (the const's type is its width), nor to a ptr to char
  (C could write through it)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_strconst_cstr;

const
  GREETING: string = "hello";
  WIDE: wstring = "wide";

func CLen(const P: ptr to const char): int64;
begin
  return 0;
end;

var
  LText: string;
  LNarrow: ptr to const char;
  LWide: ptr to const wchar;
  LWritable: ptr to char;
  LCount: int64;
begin
  LText := "hello";
  LNarrow := GREETING;
  LWide := WIDE;
  // A string argument is borrowed as C text for the call (F3): no error
  LCount := CLen(LText);
  LNarrow := LText; // ERROR SM0759@14
  LWide := GREETING; // ERROR SM0200@12
  LNarrow := WIDE; // ERROR SM0200@14
  LWritable := GREETING; // ERROR SM0200@16
end.
