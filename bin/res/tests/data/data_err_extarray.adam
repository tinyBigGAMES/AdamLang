  data_err_extarray.adam - Break step of lib_extarray (PLAN-XML X2c, BNF sec
  4): an external variable of array[0..] of T holds plain data (SM0727), no
  element ending in a flexible member (SM0729); it is a module variable only
  (SM0302), never a parameter's type (SM0728); only an index or addr of takes
  it (SM0730: a value, a len)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_extarray;

type
  TGood = record
    N: int32;
    D: array[0..] of int32;
  end;

var
  ExtA: array[0..] of int32; external;
  ExtS: array[0..] of string; external; // ERROR SM0727@23
  ExtG: array[0..] of TGood; external; // ERROR SM0729@23
  LCopy: int32;
  LP: ptr to int32;

func TakeAll(const AAll: array[0..] of int32); // ERROR SM0728@26
begin
end;

func Body();
var
  LLocal: array[0..] of int32; external; // ERROR SM0302@3
begin
end;

begin
  LCopy := ExtA[1];
  LP := addr of ExtA;
  LP := addr of ExtA[0];
  println("{}", len(ExtA)); // ERROR SM0730@21: the external array 'ExtA' has no size: only an index or addr of takes it (ExtA[i]; addr of ExtA is where it starts)
  LP := ExtA; // ERROR SM0730@9: the external array 'ExtA' has no size: only an index or addr of takes it (ExtA[i]; addr of ExtA is where it starts)
  println("{}", LCopy);
end.
