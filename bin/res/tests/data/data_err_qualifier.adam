  data_err_qualifier.adam - Break step of qualified names (AUD4 5.7): a
  dotted type's qualifier is a bare name first, so a parameter, local or
  module declaration of the imported unit's spelling hides the unit
  (SM0007 at the type); where nothing hides it the unit's type is reached.
  A bare name two imports export is the last one's (BNF sec 1, as Delphi):
  no error
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_qualifier;

@addmodulepath "$P:res/tests/data/fixtures";

import PublicUnit;

var
  GNode: PublicUnit.PublicNode;

func Hidden();
var
  PublicUnit: int32 = 1;
  LNode: PublicUnit.PublicNode; // ERROR SM0007@10
begin
end;

func Param(const PublicUnit: int32);
var
  LNode: PublicUnit.PublicNode; // ERROR SM0007@10
begin
end;

func Seen();
var
  LNode: PublicUnit.PublicNode;
begin
end;

begin
end.
