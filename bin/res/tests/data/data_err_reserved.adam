-------------------------------------------------------------------------------
  data_err_reserved.adam - the reserved prefix (AUD8, pcpp's SM0017): no name
  a declaration declares starts with __adam, the prefix of every symbol the
  compiler makes (__adam_entry, __adam_test_<module>_<n>, ...), so none can
  collide with them: a const, a type, a field, a method, a property, an embed,
  a choice value, a var, a local, a routine and a parameter, each at its name.
  ADAM_ and a name holding __adam past its start are free.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_reserved;

const
  __adam_k: int32 = 1; // ERROR SM0017@3: '__adam_k' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise
  ADAM_FREE: int32 = 2;

type
  __adam_t = int32; // ERROR SM0017@3: '__adam_t' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise
  TChoice = choices(First, __adam_c); // ERROR SM0017@28: '__adam_c' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise
  TInner = object
    Count: int32;
  end;
  TBox = object
    __adam_f: int32; // ERROR SM0017@5: '__adam_f' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise
    embed __adam_e: TInner; // ERROR SM0017@11: '__adam_e' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise
    Free__adam: int32;
    method __adam_m(); // ERROR SM0017@12: '__adam_m' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise
    begin
    end;
    property __adam_p: int32 read Free__adam; // ERROR SM0017@14: '__adam_p' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise
  end;

var
  __adam_v: int32; // ERROR SM0017@3: '__adam_v' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise

routine __adam_r(const __adam_a: int32); // ERROR SM0017@9: '__adam_r' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise // ERROR SM0017@24: '__adam_a' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise
var
  __adam_l: int32; // ERROR SM0017@3: '__adam_l' starts with '__adam', which the compiler keeps for the symbols it makes: name it otherwise
begin
  __adam_l := __adam_a;
end;

begin
end.
