-------------------------------------------------------------------------------
  data_err_ptr_const.adam - Break step of the untyped ptr to const (BNF
  sec 4, M9h0): it points at no type (P^ and P[i] SM0253, P->F SM0250), it
  converts with no cast to nothing but itself (the untyped ptr and a typed
  ptr would drop its const: SM0200), and a pointer cast keeps its const (a
  ptr to T of it is SM0265); a ptr to const T and ptr(..) are clean
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_ptr_const;

type
  Pair = record
    X: int32;
  end;

var
  GAny: ptr to const;
  GPlain: ptr;
  GTyped: ptr to int32;
  GConst: ptr to const int32;
  GPair: ptr to const Pair;
  GX: int32;

begin
  GAny := nil;
  GConst := ptr to const int32(GAny);
  GPlain := ptr(GAny);
  GPair := ptr to const Pair(GAny);
  GX := GAny^; // ERROR SM0253@9
  GX := GAny[0]; // ERROR SM0253@9
  GX := GAny->X; // ERROR SM0250@9
  GPlain := GAny; // ERROR SM0200@13
  GTyped := GAny; // ERROR SM0200@13
  GTyped := ptr to int32(GAny); // ERROR SM0265@26
end.
