-------------------------------------------------------------------------------
  data_public.adam - Data: `public` is the one word that makes a declaration
  public (BNF row 20; pcpp's `exported` dropped 2026-11-07). The unit
  fixtures\PublicUnit.adam declares each kind public: a const read bare and
  as PublicUnit.PublicLimit, a var read and written here (its private
  routine sees the write), a forward type completed as a self-referencing
  record and chained here, a routine called. `exported` is an identifier
  now: a routine of that name is declared and called.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | limit 40
  | count 2
  | sum 15
  | chain 5
  | unit.name 40
  | exported 7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe data_public;

@addmodulepath "$P:res/tests/data/fixtures";

import System.SysUtils, PublicUnit;

// A routine named exported: an identifier, no keyword (BNF row 20)
func exported(): int32;
begin
  return 7;
end;

// ALabel and AValue on one line
func Show(const ALabel: string; const AValue: int64);
begin
  println("{}", ALabel + " " + IntToStr(AValue));
end;

var
  GFirst: PublicNode;
  GSecond: PublicNode;

begin
  Show("limit", int64(PublicLimit));
  Show("count", int64(PublicCount));
  PublicCount := 5;
  // PrivateCount 1 + PublicCount 5 + PrivateLimit 9, all read inside the unit
  Show("sum", int64(PublicSum()));
  GSecond.Value := 3;
  GSecond.Next := nil;
  GFirst.Value := 2;
  GFirst.Next := addr of GSecond;
  Show("chain", int64(GFirst.Value + GFirst.Next^.Value));
  Show("unit.name", int64(PublicUnit.PublicLimit));
  Show("exported", int64(exported()));
end.
