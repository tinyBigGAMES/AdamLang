-------------------------------------------------------------------------------
  data_aggregate.adam - Aggregate data (M3.5g2). Record constants whose
  literals fold live in read-only data: their fields read back, a nested
  record and bitfields among them, and a whole constant copied into a local.
  A record variable whose literal folds starts with its bytes and stays
  writable; one initialized from a constant, and one whose literal calls a
  routine, are filled at the entry. A local record constant lives in its
  routine's frame. Values are shown through ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 7
  | -2
  | 6
  | 3
  | 5
  | 21
  | -9
  | 5
  | 258
  | 1
  | -2
  | 8
  | 5
  | 23
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe data_aggregate;

func malloc(const ASize: uint64): ptr; external "ucrtbase";
func puts(const AText: ptr): int32; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  TPair = record
    A: int32;
    B: int64;
  end;

  TBits = record
    Lo: uint8 : 3;
    Hi: uint8 : 5;
    N: int16;
  end;

  TBox = record
    P: TPair;
    Tag: int8;
    Bits: TBits;
  end;

// AV doubled (a value no constant folds)
func Twice(const AV: int32): int32;
begin
  return AV * 2;
end;

const
  KPair: TPair = TPair(A: 7, B: -2);
  KBox: TBox = TBox(P: TPair(A: 1, B: 6), Tag: 3, Bits: TBits(Lo: 5, Hi: 21, N: -9));

var
  GPair: TPair = TPair(A: 258, B: 1);
  GCopy: TPair = KPair;
  GRun: TPair = TPair(A: Twice(4), B: 5);

// AValue in decimal, one line
func ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

func Run();
const
  LK: TPair = TPair(A: 11, B: 12);
var
  LP: TPair;
begin
  // A constant's fields, a nested record's and its bitfields
  ShowInt(KPair.A);
  ShowInt(KPair.B);
  ShowInt(KBox.P.B);
  ShowInt(KBox.Tag);
  ShowInt(KBox.Bits.Lo);
  ShowInt(KBox.Bits.Hi);
  ShowInt(KBox.Bits.N);

  // A whole constant copied into a local
  LP := KPair;
  ShowInt(LP.A + LP.B);

  // A variable starting with its bytes, still writable
  ShowInt(GPair.A);
  GPair.A := 1;
  ShowInt(GPair.A);

  // Filled at the entry: from a constant, and through a call
  ShowInt(GCopy.B);
  ShowInt(GRun.A);
  ShowInt(GRun.B);

  // A local record constant
  ShowInt(LK.A + LK.B);
end;

begin
  Run();
end.
