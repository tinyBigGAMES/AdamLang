-------------------------------------------------------------------------------
  data_ptr_const.adam - The untyped ptr to const (BNF sec 4, user
  2026-11-16, M9h0): `ptr to const` with no type after it, C's
  `const void *`. The untyped ptr, a ptr to T and a ptr to const T convert
  to it with no cast (a variable, a field, a parameter, a result); a
  pointer cast gives it a type again (a ptr to const T, or the untyped ptr
  by ptr(..)) and the bytes are read through that; nil is one; a
  `ptr to const(..)` cast takes an integer of pointer width; it is 8 bytes.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | size 8
  | first 7
  | second 9
  | field 7
  | nil true
  | same true
  | back 7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe data_ptr_const;

type
  Holder = record
    Data: ptr to const;
  end;

var
  GBytes: array[0..1] of uint8;
  GHolder: Holder;
  GAny: ptr to const;
  GPlain: ptr;
  GTyped: ptr to uint8;
  GConst: ptr to const uint8;
  GWord: uint64;

// The byte AData points at, as C's const void * is read: cast to a typed ptr to const
func clink FirstByte(const AData: ptr to const): uint8;
begin
  return (ptr to const uint8(AData))^;
end;

// AData handed back as it came
func Pass(const AData: ptr to const): ptr to const;
begin
  return AData;
end;

begin
  GBytes[0] := 7;
  GBytes[1] := 9;
  println("size {}", size(ptr to const));
  GTyped := addr of GBytes[0];
  GAny := GTyped;
  println("first {}", FirstByte(GAny));
  GConst := addr of GBytes[1];
  println("second {}", FirstByte(GConst));
  GHolder.Data := addr of GBytes[0];
  println("field {}", FirstByte(GHolder.Data));
  GAny := nil;
  println("nil {}", GAny = nil);
  GPlain := addr of GBytes[0];
  GAny := Pass(GPlain);
  println("same {}", GAny = ptr to const(GPlain));
  GWord := uint64(ptr(GAny));
  println("back {}", FirstByte(ptr to const(GWord)));
end.
