-------------------------------------------------------------------------------
  data_vars.adam - Data: scalar module variables (M3.4a). Every width starts
  at its initializer, one without (or with zero) starts zeroed; each is
  read, stepped, compound-assigned and written; a module variable passed
  as a var argument; this module's private GCount and the imported unit's
  private GCount never meet; the unit's public GShared written here and
  read there; `addr of` a module variable handed to ucrtbase's memset.
  Values are shown through ucrtbase (_i64toa / _ui64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | -5
  | 200
  | -300
  | 65000
  | -70000
  | 4000000000
  | -5000000000
  | f9ccd8a1c5080000
  | 1
  | 65
  | 0
  | 0
  | 7
  | 3
  | -6
  | 0
  | 5
  | 5032704
  | -1
  | 2
  | 4
  | 7
  | 11
  | 0
  | 65535
  | [Adam Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe data_vars;

@addmodulepath "$P:res/tests/data/fixtures";

import DataUnit;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine memset(const ADest: ptr; const AByte: int32; const ACount: uint64): ptr; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine _ui64toa(const AValue: uint64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

var
  GI8: int8 = -5;
  GU8: uint8 = 200;
  GI16: int16 = -300;
  GU16: uint16 = 65000;
  GI32: int32 = -70000;
  GU32: uint32 = 4000000000;
  GI64: int64 = -5000000000;
  GU64: uint64 = 18000000000000000000u;
  GBool: bool = true;
  GChar: char = 'A';
  GZero: int32;
  GZeroInit: int64 = 0;
  GCount: int32 = 7;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue's bits in hex, one line
routine ShowHex(const AValue: uint64);
begin
  puts(_ui64toa(AValue, malloc(32), 16));
end;

// One added to the variable AX names
routine Bump(var AX: int32);
begin
  AX += 1;
end;

routine Run();
begin
  // Starting values: each width's initializer, then the zeroed ones
  ShowInt(GI8);
  ShowInt(GU8);
  ShowInt(GI16);
  ShowInt(GU16);
  ShowInt(GI32);
  ShowInt(GU32);
  ShowInt(GI64);
  ShowHex(GU64);
  if GBool then
    ShowInt(1);
  else
    ShowInt(0);
  end;
  ShowInt(int32(GChar));
  ShowInt(GZero);
  ShowInt(GZeroInit);
  ShowInt(GCount);
  ShowInt(UnitCount());

  // Written: a step, a wrap at uint8, compound assignments, a zeroed int64 stored
  --GI8;
  ShowInt(GI8);
  GU8 := 255;
  ++GU8;
  ShowInt(GU8);
  GI32 += 70005;
  ShowInt(GI32);
  GU32 += 300000000;
  ShowInt(GU32);
  GZeroInit := -1;
  ShowInt(GZeroInit);

  // A module variable as a var argument
  Bump(GZero);
  Bump(GZero);
  ShowInt(GZero);

  // The unit's private GCount moves, this module's stays
  BumpUnit();
  ShowInt(UnitCount());
  ShowInt(GCount);

  // The unit's public variable written here, read there
  GShared := 11;
  ShowInt(UnitShared());

  // addr of a module variable, written through by memset
  memset(addr of GI64, 0, 8);
  ShowInt(GI64);
  memset(addr of GU16, 255, 2);
  ShowInt(GU16);
end;

begin
  Run();
end.
