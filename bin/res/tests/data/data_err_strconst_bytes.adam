-------------------------------------------------------------------------------
  data_err_strconst_bytes.adam - Break step of a string to a C string of
  8-bit integers (BNF sec 4, PLAN-XML X2b): a string variable stored into a
  ptr local is not kept alive (SM0759, PLAN-RAVENAPI F4; as an argument it is
  borrowed for the call, F3), nor does a wstring const convert, nor a literal
  or const to a ptr to uint8 (C could write through it), nor a string const to a
  ptr to const of a wider integer (a literal is UTF-16 text there, F3)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_strconst_bytes;

const
  GREETING: string = "hello";
  WIDE: wstring = "wide";

func ULen(const P: ptr to const uint8): int64;
begin
  return 0;
end;

var
  LText: string;
  LBytes: ptr to const uint8;
  LWritable: ptr to uint8;
  LWords: ptr to const uint16;
  LCount: int64;
begin
  LText := "hello";
  LBytes := GREETING;
  // A string argument is borrowed as C text for the call (F3): no error
  LCount := ULen(LText);
  LBytes := LText; // ERROR SM0759@13
  LBytes := WIDE; // ERROR SM0200@13
  LWritable := "abc"; // ERROR SM0200@16
  LWritable := GREETING; // ERROR SM0200@16
  // A literal is UTF-16 text for a ptr to const uint16 (F3); a string const keeps its width
  LWords := "abc";
  LWords := GREETING; // ERROR SM0200@13
end.
