-------------------------------------------------------------------------------
  data_err_strconst_bytes.adam - Break step of a string to a C string of
  8-bit integers (BNF sec 4, PLAN-XML X2b): a string variable never converts
  (SM0404 / SM0200), nor a wstring const, nor a literal or const to a ptr to
  uint8 (C could write through it), nor to a ptr to const of a wider integer
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_strconst_bytes;

const
  GREETING: string = "hello";
  WIDE: wstring = "wide";

routine ULen(const P: ptr to const uint8): int64;
begin
  return 0;
end;

var
  LText: string;
  LBytes: ptr to const uint8;
  LWritable: ptr to uint8;
  LWords: ptr to const uint16;
  LCount: int64;
begin
  LText := "hello";
  LBytes := GREETING;
  LCount := ULen(LText); // ERROR SM0404@18
  LBytes := LText; // ERROR SM0200@13
  LBytes := WIDE; // ERROR SM0200@13
  LWritable := "abc"; // ERROR SM0200@16
  LWritable := GREETING; // ERROR SM0200@16
  LWords := "abc"; // ERROR SM0200@13
end.
