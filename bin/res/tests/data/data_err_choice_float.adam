-------------------------------------------------------------------------------
  data_err_choice_float.adam - Break step of choices (AUD5): a choice value
  is an int64, so a float there is SM0200 at it (pcpp's), not SM0202;
  integer values are clean
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_choice_float;

type
  TC = choices(cA = 1.5); // ERROR SM0200@21
  TD = choices(dA = 2, dB = 3);

begin
end.
