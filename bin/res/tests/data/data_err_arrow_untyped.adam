-------------------------------------------------------------------------------
  data_err_arrow_untyped.adam - Break step of pointers (AUD5): '->' is an
  operator the untyped ptr does not take: SM0250 at the operand (pcpp's),
  naming the cast that gives it a type; through a typed pointer it is clean
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe data_err_arrow_untyped;

type
  Pair = record
    X: int32;
  end;

var
  LU: ptr;
  LP: ptr to Pair;
  LX: int32;

begin
  LU := nil;
  LP := nil;
  LX := LP->X;
  LX := LU->X; // ERROR SM0250@9
end.
