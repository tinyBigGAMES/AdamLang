-------------------------------------------------------------------------------
  xml_xinclude.adam - System.XML.Ext's XInclude (PLAN-XML X3d2) on both
  targets (the linux ELF run through RunElf): a book this row writes read
  with [XmlReadOption.XInclude] from a file, a text and a memory IO (an
  XML include, a parse="text" one, an xi:fallback taken for a target that
  is missing), and without the option (the xi:include element kept); an
  xi:include as the root element; TryFromString with the option; a
  missing target with no fallback and an included document that is no
  well-formed XML fail the read (ErrorText names the include's line, or
  the included document); with bin\assets.zip as this thread's path
  source an include reads a zip entry (DoLoadResource). The [Heap] line
  shows every block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | file chapters 2 ids 1 2 title Two note [a & b] fallback true includes 0
  | plain chapters 1 kept true
  | text chapters 2 note [a & b]
  | io chapters 2 note [a & b]
  | root chapter 2 Two
  | try true chapter
  | missing [<text>(2): could not load xml_xinclude_none.xml, and no fallback was found]
  | broken [xml_xinclude_bad.xml(2,22): Opening and ending tag mismatch: title line 2 and chapter]
  | zip theme Teal
  | removed true true true true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_xinclude;

import System.SysUtils, System.IO, System.CustomIO, System.HookIO, System.XML.Ext;

const
  BOOK_FILE: string = "xml_xinclude_book.xml";
  PART_FILE: string = "xml_xinclude_part.xml";
  NOTE_FILE: string = "xml_xinclude_note.txt";
  BAD_FILE: string = "xml_xinclude_bad.xml";
  XI: string = " xmlns:xi=\"http://www.w3.org/2001/XInclude\"";
  BOOK: string = "<book" + XI + ">\n" +
    "<chapter id=\"1\"/>\n" +
    "<xi:include href=\"xml_xinclude_part.xml\"/>\n" +
    "<note><xi:include href=\"xml_xinclude_note.txt\" parse=\"text\"/></note>\n" +
    "<xi:include href=\"xml_xinclude_none.xml\">" +
    "<xi:fallback><missing/></xi:fallback></xi:include>\n" +
    "</book>";
  PART: string = "<chapter id=\"2\"><title>Two</title></chapter>";
  BAD: string = "<chapter>\n<title>Oops</chapter>";
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";
  ASSETS_PASSWORD: string = "Adam";

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// "chapters <n>": how many chapter elements ABook holds
routine Chapters(const ABook: Xml): string;
var
  LNode: Xml;
  LCount: int64;
begin
  LCount := 0;
  for LNode in ABook.Elements("chapter") do
    LCount := LCount + 1;
  end;
  return "chapters " + IntToStr(LCount);
end;

var
  LBook: Xml;
  LIds: string;
  LNode: Xml;
  LText: string;
  LIO: IO;
  LZip: IOSource;
  LOk: bool;
begin
  WriteAllText(BOOK_FILE, BOOK);
  WriteAllText(PART_FILE, PART);
  WriteAllText(NOTE_FILE, "a & b");
  WriteAllText(BAD_FILE, BAD);

  // From a file: the part merged, the text included, the fallback taken, no xi:include left
  LBook := Xml.FromFile(BOOK_FILE, [XmlReadOption.XInclude]);
  LIds := "";
  for LNode in LBook.Elements("chapter") do
    LIds := LIds + " " + LNode.Get("id");
  end;
  println("file {} ids{} title {} note [{}] fallback {} includes {}", Chapters(LBook), LIds,
    LBook.SelectFirst("chapter/title").Text(), LBook.FindChild("note").InnerText(),
    BoolText(not LBook.FindChild("missing").IsNull()),
    LBook.Evaluate("count(//*[local-name() = 'include'])", 0));

  // No option: the document as it is
  LBook := Xml.FromFile(BOOK_FILE);
  println("plain {} kept {}", Chapters(LBook),
    BoolText(not LBook.FindChild("xi:include").IsNull()));

  // From a text and an IO: hrefs relative to the working folder
  LBook := Xml.FromString(BOOK, [XmlReadOption.XInclude]);
  println("text {} note [{}]", Chapters(LBook), LBook.FindChild("note").InnerText());
  LText := BOOK;
  LIO := CreateMemoryIO(ptr(addr of LText[0]), len(LText), true);
  LBook := Xml.FromIO(LIO, [XmlReadOption.XInclude]);
  IOClose(LIO);
  println("io {} note [{}]", Chapters(LBook), LBook.FindChild("note").InnerText());

  // An xi:include as the root element is replaced too
  LBook := Xml.FromString("<xi:include" + XI + " href=\"xml_xinclude_part.xml\"/>",
    [XmlReadOption.XInclude]);
  println("root {} {} {}", LBook.Name(), LBook.Get("id"), LBook.FindChild("title").Text());
  LOk := Xml.TryFromString("<w" + XI + "><xi:include href=\"xml_xinclude_part.xml\"/></w>",
    [XmlReadOption.XInclude], LBook);
  println("try {} {}", BoolText(LOk), LBook.FirstElement().Name());

  // A missing target with no fallback, and an included document that is no well-formed XML
  LBook := Xml.FromString("<w" + XI + ">\n<xi:include href=\"xml_xinclude_none.xml\"/>\n</w>",
    [XmlReadOption.XInclude]);
  println("missing [{}]", LBook.ErrorText());
  LBook := Xml.FromString("<w" + XI + ">\n<xi:include href=\"xml_xinclude_bad.xml\"/>\n</w>",
    [XmlReadOption.XInclude]);
  println("broken [{}]", LBook.ErrorText());

  // An include read from bin\assets.zip through this thread's path source
  LZip := CreateZipIOSource(ASSETS_ZIP, ASSETS_PASSWORD);
  SetIOThreadPathSource(LZip);
  LBook := Xml.FromString("<ui" + XI +
    "><xi:include href=\"res/assets/ui/raven_theme.xml\"/></ui>", [XmlReadOption.XInclude]);
  SetIOThreadPathSource(nil);
  println("zip theme {}", LBook.FirstElement().Get("Name"));
  // The documents let go before the zip closes
  LBook := Xml.FromString("<done/>");
  LNode := LBook;
  IOSourceClose(LZip);

  println("removed {} {} {} {}", BoolText(DeleteFile(BOOK_FILE)),
    BoolText(DeleteFile(PART_FILE)), BoolText(DeleteFile(NOTE_FILE)),
    BoolText(DeleteFile(BAD_FILE)));
end.
