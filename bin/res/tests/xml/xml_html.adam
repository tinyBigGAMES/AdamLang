-------------------------------------------------------------------------------
  xml_html.adam - System.XML.Ext's HTML reads (PLAN-XML X3d2) on both
  targets (the linux ELF run through RunElf): FromHtmlString on a page
  with an unclosed p and a void br (the same node API: Name, Get,
  Elements, XPath Select / Evaluate, InnerText, a named entity), the html
  / head / body elements implied around a bare fragment, ToString writing
  HTML (<br>, no XML declaration), FromHtmlFile on a page this row writes
  and SaveToFile writing HTML back, FromHtmlIO over a memory IO and
  SaveToIO writing HTML to one, the instance forms ParseHtml /
  LoadFromHtmlFile / LoadFromHtmlIO, and a missing file (ErrorText). The
  [Heap] line shows every block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | page html title Hi paragraphs 2 class lead [OneTwo] last [Three © 2026]
  | markup <p class="lead">One<br>Two</p>
  | implied html body p [bare]
  | file Docs items 3 saved true br true decl false
  | io Docs items 3 saved true br true decl false
  | forms true true true Docs
  | missing [xml_html_none.html: the file cannot be opened]
  | removed true true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_html;

import System.SysUtils, System.IO, System.CustomIO, System.XML.Ext;

const
  PAGE: string = "<html><head><title>Hi</title></head><body>" +
    "<p class=\"lead\">One<br>Two<p>Three &copy; 2026</body></html>";
  DOCS: string = "<!DOCTYPE html>\n<html>\n<head><title>Docs</title></head>\n<body>\n" +
    "<ul><li>a<li>b<li>c</ul>\n</body>\n</html>\n";
  DOCS_FILE: string = "xml_html_docs.html";
  SAVED_FILE: string = "xml_html_saved.html";

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LPage: Xml;
  LFirst: Xml;
  LText: string;
  LSaved: string;
  LIO: IO;
  LOk1: bool;
  LOk2: bool;
  LOk3: bool;
begin
  // An unclosed p, a void br and a named entity, read as a browser reads them
  LPage := Xml.FromHtmlString(PAGE);
  LFirst := LPage.SelectFirst("//p");
  println("page {} title {} paragraphs {} class {} [{}] last [{}]", LPage.Name(),
    LPage.SelectFirst("head/title").Text(), LPage.Evaluate("count(//p)", 0), LFirst.Get("class"),
    LFirst.InnerText(), LPage.SelectFirst("//p[2]").InnerText());
  println("markup {}", LFirst.ToString());

  // A bare fragment: html / body implied around it
  LPage := Xml.FromHtmlString("<p>bare");
  println("implied {} {} {} [{}]", LPage.Name(), LPage.FirstElement().Name(),
    LPage.FirstElement().FirstElement().Name(), LPage.InnerText());

  // A file this row writes, saved back as HTML
  WriteAllText(DOCS_FILE, DOCS);
  LPage := Xml.FromHtmlFile(DOCS_FILE);
  LSaved := "";
  println("file {} items {} saved {} br {} decl {}", LPage.SelectFirst("//title").Text(),
    LPage.Evaluate("count(//li)", 0),
    BoolText(Xml.FromHtmlString(PAGE).SaveToFile(SAVED_FILE) and ReadAllText(SAVED_FILE, LSaved)),
    BoolText(IndexOf("<br>", LSaved, 0) >= 0), BoolText(IndexOf("<?xml", LSaved, 0) >= 0));

  // A memory IO
  LText := DOCS;
  LIO := CreateMemoryIO(ptr(addr of LText[0]), len(LText), true);
  LPage := Xml.FromHtmlIO(LIO);
  IOClose(LIO);
  // Saved back to a memory IO as HTML, then read back from it as text
  LIO := CreateMemoryIO();
  LOk1 := Xml.FromHtmlString(PAGE).SaveToIO(LIO, false);
  IOSeek(LIO, 0, SeekOrigin.FromStart);
  LSaved := Xml.FromHtmlIO(LIO).ToString();
  IOClose(LIO);
  println("io {} items {} saved {} br {} decl {}", LPage.SelectFirst("//title").Text(),
    LPage.Evaluate("count(//li)", 0), BoolText(LOk1), BoolText(IndexOf("<br>", LSaved, 0) >= 0),
    BoolText(IndexOf("<?xml", LSaved, 0) >= 0));

  // The instance forms
  LOk1 := LPage.ParseHtml(PAGE);
  LOk2 := LPage.LoadFromHtmlFile(DOCS_FILE);
  LIO := CreateMemoryIO(ptr(addr of LText[0]), len(LText), true);
  LOk3 := LPage.LoadFromHtmlIO(LIO);
  IOClose(LIO);
  println("forms {} {} {} {}", BoolText(LOk1), BoolText(LOk2), BoolText(LOk3),
    LPage.SelectFirst("//title").Text());

  println("missing [{}]", Xml.FromHtmlFile("xml_html_none.html").ErrorText());
  println("removed {} {}", BoolText(DeleteFile(DOCS_FILE)), BoolText(DeleteFile(SAVED_FILE)));
end.
