-------------------------------------------------------------------------------
  xml_write.adam - System.XML.Ext builds, changes and writes documents
  (PLAN-XML X3b) on both targets: Xml.New with attributes of every kind,
  escaped text, a comment and a CDATA section (ToString compact); a
  default and a prefixed namespace (DeclareNamespace, "prefix:local"); a
  pretty form; every refused change (no XML name, an undeclared prefix,
  "--" in a comment, "]]>" in a CDATA section, an xmlns attribute) leaves
  the tree as it was; SetText and Remove keep a view of a node taken out
  readable; round trips through a file and a memory IO; an ISO-8859-1
  save is 4 bytes longer than the UTF-8 one (its declaration +5, the é -1)
  and reads back the same; an encoding libxml2 lacks and a missing value
  write nothing. The [Heap] line shows every block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | built <cfg version="2" big="9000000000" ratio="0.5" on="true" name="a&lt;b"><item>a &amp; b</item><!--note--><![CDATA[<raw>]]></cfg>
  | typed 2 9000000000 0.5 true a<b
  | svg <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><use xlink:href="#a"/></svg>
  | use http://www.w3.org/2000/svg #a
  | prefixed <x:root xmlns:x="urn:x"><x:leaf/></x:root> leaf urn:x
  | <list>
  |   <a/>
  |   <b k="v"/>
  | </list>
  | new errors [<new>: not an XML name: 1bad] [<new>: no namespace URI is given for the prefix p]
  | refused true true <list><a/><b k="v"/></list>
  | set text <cfg version="2" big="9000000000" ratio="0.5" on="true" name="a&lt;b">plain</cfg> old a & b true
  | remove true false <list><a/></list> v
  | attribute true false
  | file true true removed true
  | io true true
  | latin1 true 4 café
  | refused saves false false []
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_write;

import System.SysUtils, System.IO, System.CustomIO, System.XML.Ext;

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LDoc: Xml;
  LItem: Xml;
  LSvg: Xml;
  LUse: Xml;
  LPrefixed: Xml;
  LLeaf: Xml;
  LList: Xml;
  LB: Xml;
  LWord: Xml;
  LBad: Xml;
  LMemory: IO;
  LUtf8: IO;
  LLatin: IO;
  LText: string;
  LOk: bool;
begin
  // Built: attributes of every kind, escaped text, a comment and a CDATA section
  LDoc := Xml.New("cfg");
  LDoc.SetAttribute("version", int32(2)).SetAttribute("big", int64(9000000000));
  LDoc.SetAttribute("ratio", 0.5).SetAttribute("on", true).SetAttribute("name", "a<b");
  LDoc.AddElement("item", "a & b");
  LDoc.AddComment("note").AddCData("<raw>");
  println("built {}", LDoc.ToString());
  println("typed {} {} {} {} {}", LDoc.Get("version", int32(0)), LDoc.Get("big", int64(0)),
    FloatToStr(LDoc.Get("ratio", 0.0)), BoolText(LDoc.Get("on", false)), LDoc.Get("name"));

  // Namespaces: a default one with a prefixed one beside it, then a prefixed root
  LSvg := Xml.New("svg", "http://www.w3.org/2000/svg");
  LSvg.DeclareNamespace("xlink", "http://www.w3.org/1999/xlink");
  LUse := LSvg.AddElement("use").SetAttribute("xlink:href", "#a");
  println("svg {}", LSvg.ToString());
  println("use {} {}", LUse.NamespaceUri(), LUse.Get("xlink:href"));
  LPrefixed := Xml.New("x:root", "urn:x");
  LLeaf := LPrefixed.AddElement("x:leaf");
  println("prefixed {} {} {}", LPrefixed.ToString(), LLeaf.LocalName(), LLeaf.NamespaceUri());

  // Pretty: an element per line
  LList := Xml.New("list");
  LList.AddElement("a");
  LList.AddElement("b").SetAttribute("k", "v");
  println("{}", LList.ToPrettyString());

  // Refused: nothing changes
  println("new errors [{}] [{}]", Xml.New("1bad").ErrorText(), Xml.New("p:r").ErrorText());
  LList.AddComment("a--b").AddComment("end-").AddCData("x]]>y");
  LList.SetAttribute("xmlns", "u").SetAttribute("q:k", "v").SetAttribute("a b", "v");
  println("refused {} {} {}", BoolText(LList.AddElement("q:z").IsNull()),
    BoolText(LList.AddElement("a b").IsNull()), LList.ToString());

  // SetText and Remove: a view of a node taken out stays readable
  LItem := LDoc.FindChild("item");
  LDoc.SetText("plain");
  println("set text {} old {} {}", LDoc.ToString(), LItem.Text(), BoolText(LItem.Parent().IsNull()));
  LB := LList.FindChild("b");
  println("remove {} {} {} {}", BoolText(LB.Remove()), BoolText(LB.Remove()), LList.ToString(),
    LB.Get("k"));
  println("attribute {} {}", BoolText(LDoc.RemoveAttribute("big")),
    BoolText(LDoc.RemoveAttribute("big")));

  // Round trips: a file (pretty) and a memory IO (compact) read back the same
  LText := LDoc.ToString();
  println("file {} {} removed {}", BoolText(LDoc.SaveToFile("xml_write.xml")),
    BoolText(Xml.FromFile("xml_write.xml").ToString() = LText),
    BoolText(DeleteFile("xml_write.xml")));
  LMemory := CreateMemoryIO();
  LOk := LSvg.SaveToIO(LMemory, false);
  IOSeek(LMemory, 0, SeekOrigin.FromStart);
  println("io {} {}", BoolText(LOk), BoolText(Xml.FromIO(LMemory).ToString() = LSvg.ToString()));

  // Encodings: ISO-8859-1 is the declaration's 5 bytes longer, the é one byte shorter
  LWord := Xml.New("w").AddText("café");
  LUtf8 := CreateMemoryIO();
  LLatin := CreateMemoryIO();
  LWord.SaveToIO(LUtf8, false);
  LOk := LWord.SaveToIO(LLatin, false, "ISO-8859-1");
  IOSeek(LLatin, 0, SeekOrigin.FromStart);
  println("latin1 {} {} {}", BoolText(LOk), IOSize(LLatin) - IOSize(LUtf8),
    Xml.FromIO(LLatin).Text());

  // An encoding libxml2 lacks and a missing value write nothing
  LBad := Xml.New("1bad");
  println("refused saves {} {} [{}]", BoolText(LWord.SaveToIO(LMemory, true, "NO-SUCH-CODE")),
    BoolText(LBad.SaveToIO(LMemory)), LBad.ToString());

  IOClose(LLatin);
  IOClose(LUtf8);
  IOClose(LMemory);
end.
