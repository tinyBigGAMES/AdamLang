-------------------------------------------------------------------------------
  xml_reader.adam - System.XML.Ext's pull reader (PLAN-XML X3e) on both
  targets (the linux ELF run through RunELF): a walk over a text (every
  node's kind, name, depth, text; a subtree skipped), the typed attribute
  reads, ReadInnerXML / ReadOuterXML, ReadSubtree's copy outliving the
  reader's moves, a file this row writes and a memory IO, the Tiled map in
  bin\assets.zip through this thread's path source, an XInclude read, XML
  that is not well-formed stopping the walk (IsValid / ErrorText), a
  missing file and a reader never made. The [Heap] line shows every block
  freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | walk <shop@0 #top <item@1 'Apple' </item <item@1/ <p:note@1 [a<b] </p:note <skip.. <item@1 <name@2 'Pear' </name </item </shop
  | item 1 2.5 true none false count 3 line 4
  | inner <name>Pear</name> outer <item id="3"><name>Pear</name></item>
  | subtree item Pear 3
  | file items 3 io items 3
  | zip coins 6 layers 2
  | xinclude items 4
  | broken false [<text>(3,5): Opening and ending tag mismatch: b line 2 and a]
  | missing false [xml_reader_none.xml: the file cannot be opened]
  | unmade false []
  | removed true true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_reader;

import System.SysUtils, System.IO, System.CustomIO, System.HookIO, System.XML.Ext;

const
  DOC: string = "<?xml version=\"1.0\"?>\n<shop xmlns:p=\"urn:p\">\n<!--top-->\n" +
    "<item id=\"1\" price=\"2.5\" sold=\"true\">Apple</item>\n<item id=\"2\"/>\n" +
    "<p:note><![CDATA[a<b]]></p:note>\n<skip><deep><deeper/></deep></skip>\n" +
    "<item id=\"3\"><name>Pear</name></item>\n</shop>";
  DOC_FILE: string = "xml_reader_shop.xml";
  PART_FILE: string = "xml_reader_part.xml";
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";
  ASSETS_PASSWORD: string = "Adam";

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// The node the reader is on as a token: <name@depth (/ when empty), </name, 'text',
// [cdata], #comment, ? otherwise
func Token(const AReader: XMLReader): string;
var
  LKind: XMLReaderNode;
  LText: string;
begin
  LKind := AReader.Kind();
  if LKind = XMLReaderNode.Element then
    LText := "<" + AReader.Name() + "@" + IntToStr(AReader.Depth());
    if AReader.IsEmptyElement() then
      LText := LText + "/";
    end;
    return LText;
  end;
  if LKind = XMLReaderNode.EndElement then
    return "</" + AReader.Name();
  end;
  if LKind = XMLReaderNode.Text then
    return "'" + AReader.Value() + "'";
  end;
  if LKind = XMLReaderNode.CData then
    return "[" + AReader.Value() + "]";
  end;
  if LKind = XMLReaderNode.Comment then
    return "#" + AReader.Value();
  end;
  return "?";
end;

// How many item elements AReader reads to its end
func CountItems(const AReader: XMLReader): int64;
var
  LCount: int64;
begin
  LCount := 0;
  while AReader.Read() do
    if (AReader.Kind() = XMLReaderNode.Element) and (AReader.Name() = "item") then
      LCount := LCount + 1;
    end;
  end;
  return LCount;
end;

var
  LReader: XMLReader;
  LNone: XMLReader;
  LSubtree: XML;
  LWalk: string;
  LText: string;
  LIO: IO;
  LZip: IOSource;
  LCoins: int64;
  LLayers: int64;
begin
  // A walk: every node in order, the skip element's subtree passed over
  LReader := XMLReader.FromString(DOC);
  LWalk := "";
  while LReader.Read() do
    if (LReader.Kind() = XMLReaderNode.Element) and (LReader.Name() = "skip") then
      LWalk := LWalk + " <skip..";
      LReader.Skip();
    end;
    LWalk := LWalk + " " + Token(LReader);
  end;
  println("walk{}", LWalk);

  // Attributes, the markup forms and a subtree copy
  LReader := XMLReader.FromString(DOC);
  while LReader.Read() and (LReader.Name() <> "item") do
  end;
  println("item {} {} {} none {} count {} line {}", LReader.Get("id", 0),
    LReader.Get("price", 0.0), BoolText(LReader.Get("sold", false)),
    BoolText(LReader.Has("none")), LReader.AttributeCount(), LReader.Line());
  while LReader.Read() and (LReader.Get("id") <> "3") do
  end;
  println("inner {} outer {}", LReader.ReadInnerXML(), LReader.ReadOuterXML());
  LSubtree := LReader.ReadSubtree();
  while LReader.Read() do
  end;
  println("subtree {} {} {}", LSubtree.Name(), LSubtree.SelectFirst("name").Text(),
    LSubtree.Get("id"));

  // A file and a memory IO
  WriteAllText(DOC_FILE, DOC);
  LText := DOC;
  LIO := CreateMemoryIO(ptr(addr of LText[0]), len(LText), true);
  println("file items {} io items {}", CountItems(XMLReader.FromFile(DOC_FILE)),
    CountItems(XMLReader.FromIO(LIO)));
  IOClose(LIO);

  // The Tiled map in bin\assets.zip, read node by node
  LZip := CreateZipIOSource(ASSETS_ZIP, ASSETS_PASSWORD);
  SetIOThreadPathSource(LZip);
  LReader := XMLReader.FromFile("res/assets/maps/overworld.tmx");
  LCoins := 0;
  LLayers := 0;
  while LReader.Read() do
    if LReader.Kind() = XMLReaderNode.Element then
      if (LReader.Name() = "object") and (LReader.Get("type") = "pickup") then
        LCoins := LCoins + 1;
      end;
      if LReader.Name() = "layer" then
        LLayers := LLayers + 1;
      end;
    end;
  end;
  SetIOThreadPathSource(nil);
  println("zip coins {} layers {}", LCoins, LLayers);
  LReader := LNone;
  IOSourceClose(LZip);

  // An XInclude read: the part's item read in the include's place
  WriteAllText(PART_FILE, "<item id=\"4\"/>");
  println("xinclude items {}", CountItems(XMLReader.FromString(
    "<w xmlns:xi=\"http://www.w3.org/2001/XInclude\"><item/><item/><item/>" +
    "<xi:include href=\"xml_reader_part.xml\"/></w>", [XMLReadOption.XInclude])));

  // XML that is not well-formed stops the walk; a missing file; a reader never made
  LReader := XMLReader.FromString("<a>\n<b>\n</a>");
  while LReader.Read() do
  end;
  println("broken {} [{}]", BoolText(LReader.IsValid()), LReader.ErrorText());
  LReader := XMLReader.FromFile("xml_reader_none.xml");
  println("missing {} [{}]", BoolText(LReader.IsValid()), LReader.ErrorText());
  println("unmade {} [{}]", BoolText(LNone.Read()), LNone.ErrorText());
  println("removed {} {}", BoolText(DeleteFile(DOC_FILE)), BoolText(DeleteFile(PART_FILE)));
end.
