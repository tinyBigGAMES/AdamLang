-------------------------------------------------------------------------------
  xml_zip.adam - System.XML.Ext's file form reads bin\assets.zip through
  HookIO (PLAN-XML X3a) on both targets (the linux ELF run through RunElf):
  through an io:// prefix of the zip (RegisterIOSource) the Raven theme
  res/assets/ui/theme_aurora.xml (its attributes, a child's colors); with
  the zip as this thread's path source (SetIOThreadPathSource) the Tiled
  map res/assets/maps/overworld.tmx by its own name (size, its title
  property, the tileset it names, its layers, the coins' values) and the
  tileset res/assets/maps/tinytown.tsx that map names, read relative to the
  map's folder (its image, the blocked tiles); an entry the zip lacks fails
  as a missing file does. The [Heap] line shows every block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | theme Theme name Aurora look RavenDark radius 10 window #070D1A styles 8
  | map 30 x 17 tiles 16 title Tiny Town tileset tinytown.tsx
  | layers ground decor
  | coins 6 sum 210 spawn player 32,128
  | tileset tinytown 132 tiles image ../tilesets/tinytown/tinytown.png blocked true
  | missing [res/assets/maps/none.tmx: the file cannot be opened]
  | closed true true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_zip;

import System.SysUtils, System.CustomIO, System.HookIO, System.XML.Ext;

const
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";
  ASSETS_PASSWORD: string = "Adam";
  MAP_FOLDER: string = "res/assets/maps/";

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LZip: IOSource;
  LPrefix: string;
  LTheme: Xml;
  LMap: Xml;
  LTileset: Xml;
  LNode: Xml;
  LProperty: Xml;
  LText: string;
  LCount: int64;
  LSum: int64;
  LSpawn: string;
begin
  LZip := CreateZipIOSource(ASSETS_ZIP, ASSETS_PASSWORD);

  // An io:// prefix: libxml2's own open of "<prefix>/<entry>" reads the zip
  LPrefix := RegisterIOSource(LZip);
  LTheme := Xml.FromFile(LPrefix + "/res/assets/ui/theme_aurora.xml");
  LCount := 0;
  for LNode in LTheme.Elements("Style") do
    LCount := LCount + 1;
  end;
  println("theme {} name {} look {} radius {} window {} styles {}", LTheme.Name(),
    LTheme.Get("Name"), LTheme.Get("Look"), LTheme.Get("CornerRadius", int32(0)),
    LTheme.FindChild("Colors").Get("Window"), LCount);
  UnregisterIO(LPrefix);

  // The zip as this thread's path source: entries by their own names
  SetIOThreadPathSource(LZip);
  LMap := Xml.FromFile(MAP_FOLDER + "overworld.tmx");
  LText := "";
  for LProperty in LMap.FindChild("properties").Elements("property") do
    if LProperty.Get("name") = "title" then
      LText := LProperty.Get("value");
    end;
  end;
  println("map {} x {} tiles {} title {} tileset {}", LMap.Get("width", int32(0)),
    LMap.Get("height", int32(0)), LMap.Get("tilewidth", int32(0)), LText,
    LMap.FindChild("tileset").Get("source"));
  LText := "";
  for LNode in LMap.Elements("layer") do
    LText := LText + " " + LNode.Get("name");
  end;
  println("layers{}", LText);
  LCount := 0;
  LSum := 0;
  LSpawn := "";
  for LNode in LMap.FindChild("objectgroup").Elements("object") do
    if LNode.Get("type") = "pickup" then
      LCount := LCount + 1;
      for LProperty in LNode.FindAll("property") do
        LSum := LSum + LProperty.Get("value", int64(0));
      end;
    end;
    if LNode.Get("name") = "spawn" then
      LSpawn := LNode.Get("type") + " " + LNode.Get("x") + "," + LNode.Get("y");
    end;
  end;
  println("coins {} sum {} spawn {}", LCount, LSum, LSpawn);

  // The tileset the map names, relative to the map's folder
  LTileset := Xml.FromFile(MAP_FOLDER + LMap.FindChild("tileset").Get("source"));
  LProperty := LTileset.FindChild("tile").FindChild("properties").FindChild("property");
  println("tileset {} {} tiles image {} blocked {}", LTileset.Get("name"),
    LTileset.Get("tilecount", int32(0)), LTileset.FindChild("image").Get("source"),
    BoolText(LProperty.Get("value", false)));

  println("missing [{}]", Xml.FromFile(MAP_FOLDER + "none.tmx").ErrorText());
  SetIOThreadPathSource(nil);

  // The documents let go before the zip closes
  LTheme := Xml.FromString("<done/>");
  LMap := LTheme;
  LTileset := LTheme;
  LNode := LTheme;
  LProperty := LTheme;
  println("closed {} {}", BoolText(LTheme.Name() = "done"), BoolText(IOSourceClose(LZip)));
end.
