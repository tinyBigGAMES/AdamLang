-------------------------------------------------------------------------------
  xml_c14n.adam - System.XML.Ext's canonical XML (PLAN-XML X3e) on both
  targets (the linux ELF run through RunElf): a document with unsorted
  attributes, unused and used namespaces, comments and empty elements
  written as C14N 1.0 (the whole document, without and with comments),
  C14N 1.1, a subtree inclusive (every namespace in scope) and exclusive
  (only those used), SaveCanonicalToIO and SaveCanonicalToFile giving the
  same bytes, two spellings of one document giving one canonical form,
  and a missing value. The [Heap] line shows every block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | doc <doc xmlns="urn:d" xmlns:a="urn:a" xmlns:u="urn:unused"><e a="1" b="2" a:z="3"></e><a:x></a:x></doc>
  | comments <!--c-->
  | <doc xmlns="urn:d" xmlns:a="urn:a" xmlns:u="urn:unused"><e a="1" b="2" a:z="3"></e><!--in--><a:x></a:x></doc>
  | c14n11 <doc xmlns="urn:d" xmlns:a="urn:a" xmlns:u="urn:unused"><e a="1" b="2" a:z="3"></e><a:x></a:x></doc>
  | inclusive <e xmlns="urn:d" xmlns:a="urn:a" xmlns:u="urn:unused" a="1" b="2" a:z="3"></e>
  | exclusive <e xmlns="urn:d" xmlns:a="urn:a" a="1" b="2" a:z="3"></e>
  | io true true file true true same true
  | missing [] false
  | removed true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_c14n;

import System.SysUtils, System.IO, System.CustomIO, System.XML.Ext;

const
  DOC: string = "<?xml version=\"1.0\"?>\n<!--c-->\n" +
    "<doc xmlns=\"urn:d\" xmlns:a=\"urn:a\" xmlns:u=\"urn:unused\"><e b=\"2\" a=\"1\" a:z=\"3\"/>" +
    "<!--in--><a:x/></doc>";
  SAME: string = "<doc xmlns:u='urn:unused' xmlns:a='urn:a' xmlns='urn:d'>" +
    "<e a:z='3' a='1' b='2'></e><a:x></a:x></doc>";
  C14N_FILE: string = "xml_c14n_out.xml";

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LDoc: Xml;
  LAll: Xml;
  LE: Xml;
  LMissing: Xml;
  LMemory: IO;
  LText: string;
  LSize: int64;
  LOk: bool;
  LRead: bool;
begin
  LDoc := Xml.FromString(DOC);
  LAll := LDoc.Parent();
  LE := LDoc.FirstElement();
  println("doc {}", LAll.ToCanonical());
  println("comments {}", LAll.ToCanonical(XmlCanonicalForm.C14N, true));
  println("c14n11 {}", LAll.ToCanonical(XmlCanonicalForm.C14N11, false));
  println("inclusive {}", LE.ToCanonical());
  println("exclusive {}", LE.ToCanonical(XmlCanonicalForm.ExclusiveC14N, false));

  // The IO and file forms give the same bytes
  LMemory := CreateMemoryIO();
  LOk := LAll.SaveCanonicalToIO(LMemory);
  LSize := IOSize(LMemory);
  IOClose(LMemory);
  LText := "";
  LRead := LAll.SaveCanonicalToFile(C14N_FILE) and ReadAllText(C14N_FILE, LText);
  println("io {} {} file {} {} same {}", BoolText(LOk),
    BoolText(LSize = len(LAll.ToCanonical())), BoolText(LRead),
    BoolText(LText = LAll.ToCanonical()),
    BoolText(Xml.FromString(SAME).ToCanonical() = LDoc.ToCanonical()));

  println("missing [{}] {}", LMissing.ToCanonical(),
    BoolText(LMissing.SaveCanonicalToFile(C14N_FILE)));
  println("removed {}", BoolText(DeleteFile(C14N_FILE)));
end.
