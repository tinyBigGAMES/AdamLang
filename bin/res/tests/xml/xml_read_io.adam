  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  xml_read_io.adam - System.XML.Ext's file and IO reads (PLAN-XML X3a) on both
  targets (the linux ELF run through RunElf): Xml.FromFile of a disk file
  this row writes (a relative path), Xml.FromIO over a memory IO read in
  pieces through libxml2's IO callbacks (a text larger than one piece; the
  IO is not closed by the read and is read to its end), FromIO from the
  IO's current place, Parse / LoadFromFile / LoadFromIO into an existing
  value (a success clears an earlier ErrorText), and TryFromString's true
  case. The [Heap] line shows every libxml2 block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | written true
  | file config debug true level 3
  | io items 2000 last 1999 sum 1999000 open true at end true
  | from place inner
  | reuse true true true error []
  | try true answer 42
  | removed true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_read_io;

import System.SysUtils, System.IO, System.CustomIO, System.XML.Ext;

const
  FILE_NAME: string = "xml_read_io.xml";
  FILE_TEXT: string = "<config debug=\"true\"><level>3</level></config>";
  PLACE_TEXT: string = "skip<inner/>";

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LDoc: Xml;
  LItem: Xml;
  LText: string;
  LPlace: string;
  LIO: IO;
  LPlaceIO: IO;
  LI: int64;
  LCount: int64;
  LSum: int64;
  LLast: int64;
  LOk1: bool;
  LOk2: bool;
  LOk3: bool;
begin
  println("written {}", BoolText(WriteAllText(FILE_NAME, FILE_TEXT)));
  LDoc := Xml.FromFile(FILE_NAME);
  println("file {} debug {} level {}", LDoc.Name(), BoolText(LDoc.Get("debug", false)),
    LDoc.FindChild("level").Text());

  // Big enough that libxml2 asks the IO for it in several pieces
  LText := "<items>";
  for LI := 0 to 1999 do
    LText := LText + "<i v=\"" + IntToStr(LI) + "\"/>";
  end;
  LText := LText + "</items>";
  LIO := CreateMemoryIO(ptr(addr of LText[0]), len(LText), true);
  LDoc := Xml.FromIO(LIO);
  LCount := 0;
  LSum := 0;
  LLast := -1;
  for LItem in LDoc.Elements("i") do
    LCount := LCount + 1;
    LLast := LItem.Get("v", int64(-1));
    LSum := LSum + LLast;
  end;
  println("io items {} last {} sum {} open {} at end {}", LCount, LLast, LSum,
    BoolText(IOStatus(LIO) <> IOState.Error), BoolText(IOTell(LIO) = len(LText)));
  IOClose(LIO);

  // From the IO's current place, not its start
  LPlace := PLACE_TEXT;
  LPlaceIO := CreateMemoryIO(ptr(addr of LPlace[0]), len(LPlace), true);
  IOSeek(LPlaceIO, 4, SeekOrigin.FromStart);
  println("from place {}", Xml.FromIO(LPlaceIO).Name());
  IOClose(LPlaceIO);

  // Into an existing value: a failure first, then the three forms succeed
  LDoc.Parse("<broken");
  LOk1 := LDoc.Parse("<a/>");
  LOk2 := LDoc.LoadFromFile(FILE_NAME);
  LIO := CreateMemoryIO(ptr(addr of LText[0]), len(LText), true);
  LOk3 := LDoc.LoadFromIO(LIO);
  IOClose(LIO);
  println("reuse {} {} {} error [{}]", BoolText(LOk1), BoolText(LOk2), BoolText(LOk3),
    LDoc.ErrorText());

  println("try {} answer {}", BoolText(Xml.TryFromString("<q answer=\"42\"/>", LDoc)),
    LDoc.Get("answer", int32(0)));
  println("removed {}", BoolText(DeleteFile(FILE_NAME)));
end.
