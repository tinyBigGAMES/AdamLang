-------------------------------------------------------------------------------
  xml_c_smoke.adam - libxml2 v2.15.4 through the std unit System.XML.C
  (PLAN-XML X2) on both targets (the linux ELF run through RunELF): a
  document parsed from memory, its root's name, an attribute (xmlGetProp,
  freed through the xmlFree variable), an XPath count through the
  xmlXPathNodeSetGetLength macro routine ([macro_params]), libxml2's
  xmlStringText read as an external array[0..] of xmlChar (X2c), then the
  document, the XPath objects and the parser let go
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | parsed true
  | root catalog
  | id c1
  | items 3
  | content Adam
  | text text
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_c_smoke;

import System.SysUtils, System.XML.C;

const
  SMOKE_XML: string = "<catalog id=\"c1\"><item>Adam</item><item>XML</item><item>libxml2</item></catalog>";

// The C string AText of xmlChar as an Adam string ("" for nil)
func Text(const AText: ptr to const xmlChar): string;
begin
  if AText = nil then
    return "";
  end;
  return StringFromC(ptr to const char(AText));
end;

var
  LDoc: ptr to xmlDoc;
  LRoot: ptr to xmlNode;
  LId: ptr to xmlChar;
  LContext: ptr to xmlXPathContext;
  LItems: ptr to xmlXPathObject;
  LContent: ptr to xmlChar;
begin
  LDoc := xmlReadMemory(SMOKE_XML, int32(len(SMOKE_XML)), "smoke.xml", nil, 0);
  println("parsed {}", LDoc <> nil);
  LRoot := xmlDocGetRootElement(LDoc);
  println("root {}", Text(LRoot^.name));
  LId := xmlGetProp(LRoot, "id");
  println("id {}", Text(LId));
  xmlFree(ptr(LId));
  LContext := xmlXPathNewContext(LDoc);
  LItems := xmlXPathEvalExpression("//item", LContext);
  println("items {}", xmlXPathNodeSetGetLength(LItems^.nodesetval));
  LContent := xmlNodeGetContent(LItems^.nodesetval^.nodeTab[0]);
  println("content {}", Text(LContent));
  xmlFree(ptr(LContent));
  println("text {}", Text(addr of xmlStringText));
  xmlXPathFreeObject(LItems);
  xmlXPathFreeContext(LContext);
  xmlFreeDoc(LDoc);
  xmlCleanupParser();
end.
