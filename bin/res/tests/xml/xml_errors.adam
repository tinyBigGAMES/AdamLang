-------------------------------------------------------------------------------
  xml_errors.adam - System.XML.Ext's read failures (PLAN-XML X3a) on both
  targets (the linux ELF run through RunElf), each a missing value with
  its ErrorText in the unit's own words and nothing printed by libxml2: a
  text that is no well-formed XML ("<text>(line,col): message", the first
  error), a mismatched end tag on a later line, an empty text, a file that
  is not there ("path: the file cannot be opened"), a malformed file
  ("path(line,col): ..."), a nil IO and a malformed IO ("<io>(..)"),
  TryFromString false; a success after a failure clears ErrorText. The
  [Heap] line shows every libxml2 block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | broken true [<text>(1,9): attributes construct error]
  | mismatch [<text>(3,5): Opening and ending tag mismatch: b line 2 and c]
  | empty [<text>(1,1): Document is empty]
  | nofile [xml_errors_none.xml: the file cannot be opened]
  | badfile [xml_errors_bad.xml(1,10): Premature end of data in tag x line 1]
  | noio [<io>: no IO]
  | badio [<io>(1,5): StartTag: invalid element name]
  | try false null true
  | cleared [] root ok
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_errors;

import System.SysUtils, System.IO, System.CustomIO, System.XML.Ext;

const
  BAD_FILE: string = "xml_errors_bad.xml";
  BAD_IO_TEXT: string = "<a><1/></a>";

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LDoc: Xml;
  LIO: IO;
  LText: string;
begin
  LDoc := Xml.FromString("<a b='1'");
  println("broken {} [{}]", BoolText(LDoc.IsNull()), LDoc.ErrorText());
  println("mismatch [{}]", Xml.FromString("<a>\n<b>\n</c></a>").ErrorText());
  println("empty [{}]", Xml.FromString("").ErrorText());
  println("nofile [{}]", Xml.FromFile("xml_errors_none.xml").ErrorText());
  WriteAllText(BAD_FILE, "<root><x>");
  println("badfile [{}]", Xml.FromFile(BAD_FILE).ErrorText());
  DeleteFile(BAD_FILE);
  println("noio [{}]", Xml.FromIO(nil).ErrorText());
  LText := BAD_IO_TEXT;
  LIO := CreateMemoryIO(ptr(addr of LText[0]), len(LText), true);
  println("badio [{}]", Xml.FromIO(LIO).ErrorText());
  IOClose(LIO);
  println("try {} null {}", BoolText(Xml.TryFromString("<<", LDoc)), BoolText(LDoc.IsNull()));
  LDoc.Parse("<ok/>");
  println("cleared [{}] root {}", LDoc.ErrorText(), LDoc.Name());
end.
