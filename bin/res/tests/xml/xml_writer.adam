-------------------------------------------------------------------------------
  xml_writer.adam - System.XML.Ext's streaming writer (PLAN-XML X3e) on
  both targets (the linux ELF run through RunELF): a pretty document to a
  text (declaration, doctype, comment, typed attributes, escaped text, a
  default and a prefixed namespace, CDATA, an instruction, raw markup),
  the same compact, a file and a memory IO read back by XML, Close ending
  open elements, a call with no element open failing (IsValid / ErrorText,
  later calls writing nothing) and a file that cannot be created. The
  [Heap] line shows every block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | <?xml version="1.0" encoding="UTF-8"?>
  | <!DOCTYPE config
  | SYSTEM "config.dtd">
  | <!--generated-->
  | <config version="2" big="9000000000" ratio="0.5" on="true">
  |   <title>Tom &amp; Jerry</title>
  |   <svg xmlns="http://www.w3.org/2000/svg"/>
  |   <p:item p:k="v" xmlns:p="urn:p"/>
  |   <code><![CDATA[<raw>]]></code>
  | <?pi x?>
  |   <t>1 &lt; 2</t>
  | <raw/></config>
  | compact <?xml version="1.0" encoding="UTF-8"?>
  | <!DOCTYPE config SYSTEM "config.dtd"><!--generated--><config version="2" big="9000000000" ratio="0.5" on="true"><title>Tom &amp; Jerry</title><svg xmlns="http://www.w3.org/2000/svg"/><p:item p:k="v" xmlns:p="urn:p"/><code><![CDATA[<raw>]]></code><?pi x?><t>1 &lt; 2</t><raw/></config>
  | file true config 2 Tom & Jerry
  | io true 3
  | closed <list><a/></list>
  | failed false [<text>: the XML cannot be written] true false
  | create false [xml_writer_none/out.xml: the file cannot be created]
  | removed true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_writer;

import System.SysUtils, System.IO, System.CustomIO, System.XML.Ext;

const
  OUT_FILE: string = "xml_writer_out.xml";

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// A small document written to AWriter
func WriteConfig(const AWriter: XMLWriter);
begin
  AWriter.StartDocument().WriteDocType("config", "", "config.dtd").WriteComment("generated")
    .StartElement("config").WriteAttribute("version", 2).WriteAttribute("big", int64(9000000000))
    .WriteAttribute("ratio", 0.5).WriteAttribute("on", true)
    .WriteElement("title", "Tom & Jerry")
    .StartElement("svg", "http://www.w3.org/2000/svg").EndElement()
    .StartElement("p:item", "urn:p").WriteAttribute("p:k", "v").EndElement()
    .StartElement("code").WriteCData("<raw>").EndElement()
    .WriteInstruction("pi", "x")
    .StartElement("t").WriteText("1 < 2").EndElement()
    .WriteRaw("<raw/>")
    .EndElement().EndDocument();
end;

var
  LOut: XMLWriter;
  LFailed: XMLWriter;
  LMemory: IO;
  LDoc: XML;
  LOk: bool;
begin
  LOut := XMLWriter.ToText();
  WriteConfig(LOut);
  LOk := LOut.Close();
  print("{}", LOut.Text());

  LOut := XMLWriter.ToText(false);
  WriteConfig(LOut);
  LOut.Close();
  // A compact document ends in the one newline EndDocument writes
  println("compact {}", TrimRight(LOut.Text()));

  // A file and a memory IO, read back by XML
  LOut := XMLWriter.ToFile(OUT_FILE);
  WriteConfig(LOut);
  LOk := LOut.Close();
  LDoc := XML.FromFile(OUT_FILE);
  println("file {} {} {} {}", BoolText(LOk), LDoc.Name(), LDoc.Get("version"),
    LDoc.FindChild("title").Text());
  LMemory := CreateMemoryIO();
  LOut := XMLWriter.ToIO(LMemory, false);
  LOut.StartElement("n").WriteElement("i", "1").WriteElement("i", "2").WriteElement("i", "3");
  LOk := LOut.Close();
  IOSeek(LMemory, 0, SeekOrigin.FromStart);
  println("io {} {}", BoolText(LOk), XML.FromIO(LMemory).ElementCount());
  IOClose(LMemory);

  // Close ends the elements still open
  LOut := XMLWriter.ToText(false);
  LOut.StartElement("list").StartElement("a");
  LOut.Close();
  println("closed {}", TrimRight(LOut.Text()));

  // A call with no element open fails; later calls write nothing
  LFailed := XMLWriter.ToText(false);
  LFailed.EndElement();
  LFailed.WriteElement("late", "x");
  println("failed {} [{}] {} {}", BoolText(LFailed.IsValid()), LFailed.ErrorText(),
    BoolText(LFailed.Text() = ""), BoolText(LFailed.Close()));
  LOut := XMLWriter.ToFile("xml_writer_none/out.xml");
  println("create {} [{}]", BoolText(LOut.IsValid()), LOut.ErrorText());
  println("removed {}", BoolText(DeleteFile(OUT_FILE)));
end.
