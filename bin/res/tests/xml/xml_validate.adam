-------------------------------------------------------------------------------
  xml_validate.adam - System.XML.Ext's validation (PLAN-XML X3d) on both
  targets (the linux ELF run through RunElf): a DTD, an XML Schema and a
  RelaxNG schema compiled once (from a string, a file this row writes and
  a memory IO) and each run on a valid and an invalid document, every
  finding listed with its line; a document checked against its own DTD
  (and one with none); a schema that is no well-formed XML and one that
  does not compile (IsValid / ErrorText, and Validate's one finding); a
  missing value. The [Heap] line shows every libxml2 block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | dtd valid true 0 bad false 2
  | finding 1: Element note content does not follow the DTD, expecting (to , body), got (to extra)
  | finding 3: No declaration for element extra
  | own valid true none false [no DTD found!]
  | xsd file valid true 0 bad false 1
  | finding 2: Element 'item', attribute 'price': 'cheap' is not a valid value of the atomic type 'xs:decimal'.
  | rng io valid true 0 bad false 1
  | finding 1: Element point failed to validate attributes
  | kinds Dtd Xsd RelaxNG
  | broken false [<text>(1,6): Couldn't find end of Start Tag oops line 1]
  | not compiled false [<text>(1): Element '{http://www.w3.org/2001/XMLSchema}element': The attribute 'name' is required but missing.] findings 1
  | missing false [no document to validate]
  | removed true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_validate;

import System.SysUtils, System.IO, System.CustomIO, System.XML.Ext;

const
  NOTE_DTD: string = "<!ELEMENT note (to, body)>" +
    "<!ELEMENT to (#PCDATA)><!ELEMENT body (#PCDATA)>";
  NOTE_GOOD: string = "<note>\n<to>Ann</to>\n<body>Hi</body>\n</note>";
  NOTE_BAD: string = "<note>\n<to>Ann</to>\n<extra/>\n</note>";
  OWN_GOOD: string = "<!DOCTYPE note [<!ELEMENT note (#PCDATA)>]><note>x</note>";
  SHOP_XSD: string = "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\">" +
    "<xs:element name=\"shop\"><xs:complexType><xs:sequence>" +
    "<xs:element name=\"item\" maxOccurs=\"unbounded\"><xs:complexType>" +
    "<xs:attribute name=\"price\" type=\"xs:decimal\" use=\"required\"/>" +
    "</xs:complexType></xs:element></xs:sequence></xs:complexType></xs:element></xs:schema>";
  SHOP_GOOD: string = "<shop>\n<item price=\"2.50\"/>\n</shop>";
  SHOP_BAD: string = "<shop>\n<item price=\"cheap\"/>\n</shop>";
  POINT_RNG: string = "<element name=\"point\" xmlns=\"http://relaxng.org/ns/structure/1.0\">" +
    "<attribute name=\"x\"><text/></attribute><attribute name=\"y\"><text/></attribute></element>";
  POINT_GOOD: string = "<point x=\"1\" y=\"2\"/>";
  POINT_BAD: string = "<point x=\"1\"/>";
  BAD_XSD: string = "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\">" +
    "<xs:element/></xs:schema>";
  XSD_FILE: string = "xml_validate.xsd";

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// The kind as text
func KindText(const AKind: XmlSchemaKind): string;
begin
  if AKind = XmlSchemaKind.Dtd then
    return "Dtd";
  end;
  if AKind = XmlSchemaKind.Xsd then
    return "Xsd";
  end;
  return "RelaxNG";
end;

// One line per finding: "  line: message"
func PrintFindings(const AFindings: XmlFindings);
var
  LI: int64;
begin
  for LI := 0 to len(AFindings) - 1 do
    println("finding {}: {}", AFindings[LI].Line, AFindings[LI].Message);
  end;
end;

// "name valid <ok> <count> bad <ok> <count>", then the bad document's findings
func Check(const AName: string; const ASchema: XmlSchema; const AGood: string;
  const ABad: string);
var
  LGoodFindings: XmlFindings;
  LBadFindings: XmlFindings;
  LGood: bool;
  LBad: bool;
begin
  LGood := Xml.FromString(AGood).Validate(ASchema, LGoodFindings);
  LBad := Xml.FromString(ABad).Validate(ASchema, LBadFindings);
  println("{} valid {} {} bad {} {}", AName, BoolText(LGood), len(LGoodFindings), BoolText(LBad),
    len(LBadFindings));
  PrintFindings(LBadFindings);
end;

var
  LDtd: XmlSchema;
  LXsd: XmlSchema;
  LRng: XmlSchema;
  LBroken: XmlSchema;
  LFindings: XmlFindings;
  LMissing: Xml;
  LText: string;
  LIO: IO;
  LOk: bool;
begin
  LDtd := XmlSchema.FromString(XmlSchemaKind.Dtd, NOTE_DTD);
  Check("dtd", LDtd, NOTE_GOOD, NOTE_BAD);

  LOk := Xml.FromString("<note>x</note>").Validate(LFindings);
  println("own valid {} none {} [{}]", BoolText(Xml.FromString(OWN_GOOD).Validate()),
    BoolText(LOk), LFindings[0].Message);

  WriteAllText(XSD_FILE, SHOP_XSD);
  LXsd := XmlSchema.FromFile(XmlSchemaKind.Xsd, XSD_FILE);
  Check("xsd file", LXsd, SHOP_GOOD, SHOP_BAD);

  LText := POINT_RNG;
  LIO := CreateMemoryIO(ptr(addr of LText[0]), len(LText), true);
  LRng := XmlSchema.FromIO(XmlSchemaKind.RelaxNG, LIO);
  IOClose(LIO);
  Check("rng io", LRng, POINT_GOOD, POINT_BAD);
  println("kinds {} {} {}", KindText(LDtd.Kind()), KindText(LXsd.Kind()), KindText(LRng.Kind()));

  // A schema that is no well-formed XML, and a well-formed one that does not compile
  LBroken := XmlSchema.FromString(XmlSchemaKind.Xsd, "<oops");
  println("broken {} [{}]", BoolText(LBroken.IsValid()), LBroken.ErrorText());
  LBroken := XmlSchema.FromString(XmlSchemaKind.Xsd, BAD_XSD);
  LOk := Xml.FromString(SHOP_GOOD).Validate(LBroken, LFindings);
  println("not compiled {} [{}] findings {}", BoolText(LBroken.IsValid()), LBroken.ErrorText(),
    len(LFindings));

  LOk := LMissing.Validate(LDtd, LFindings);
  println("missing {} [{}]", BoolText(LOk), LFindings[0].Message);
  println("removed {}", BoolText(DeleteFile(XSD_FILE)));
end.
