  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  xml_xpath.adam - System.XML.Ext's XPath 1.0 (PLAN-XML X3c) on both targets
  (the linux ELF run through RunElf): Select (a node-set as a `for .. in`
  sequence, left early too), SelectFirst, Evaluate as a string / int32 /
  int64 / float64 / bool (the default on a failure, a NaN or a fraction),
  each from a string and from an XmlPath compiled once and run on two
  documents; prefixes in scope on the context node bound by themselves, a
  default namespace reached only through RegisterNamespace; $variables of
  each kind (one rebound); attribute results (Kind, Name, Text, Parent,
  Line, markup) and namespace-axis results; a compile error and two run
  errors in ErrorText ("" after a run that works); a result that is no
  node-set; a missing value; and the document and DTD nodes' Text (""; it
  used to read a field their records do not have). The [Heap] line shows
  every libxml2 block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | default ns items 0 bound 3
  | names apple bread cheese
  | priced bread cheese
  | sum true
  | first 1 last cheese text Text missing true
  | attr Attribute m:price price m urn:money value 7 parent item line 1 markup [m:price="7"]
  | all attrs 3
  | ns 3 m urn:money on shop kind Namespace
  | vars bread cheese 1 false
  | reuse 4 3 valid true
  | bad compile false [<xpath>(1,8): Invalid expression]
  | bad prefix -1 [<xpath>: Undefined namespace prefix: q]
  | bad variable none [<xpath>: Undefined variable: nope]
  | after [] 3
  | not a set 0
  | int32 3 fraction -1 bool true
  | doc Document [] root parent Document [] dtd Other []
  | missing 0 none
  | left early 1
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_xpath;

import System.SysUtils, System.XML.Ext;

const
  SHOP_TEXT: string = "<!DOCTYPE shop>" +
    "<shop xmlns=\"urn:shop\" xmlns:m=\"urn:money\" name=\"corner\">" +
    "<item id=\"1\" m:price=\"2.5\">apple</item>" +
    "<item id=\"2\" m:price=\"10\">bread</item>" +
    "<item id=\"3\" m:price=\"7\" sold=\"yes\">cheese</item>" +
    "</shop>";
  OTHER_TEXT: string = "<a><b/><c/></a>";
  SHOP_URI: string = "urn:shop";

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// The kind as text
func KindText(const AKind: XmlKind): string;
begin
  if AKind = XmlKind.Element then
    return "Element";
  end;
  if AKind = XmlKind.Text then
    return "Text";
  end;
  if AKind = XmlKind.Attribute then
    return "Attribute";
  end;
  if AKind = XmlKind.Namespace then
    return "Namespace";
  end;
  if AKind = XmlKind.Document then
    return "Document";
  end;
  if AKind = XmlKind.Missing then
    return "Missing";
  end;
  return "Other";
end;

var
  LShop: Xml;
  LOther: Xml;
  LItem: Xml;
  LAttr: Xml;
  LDoc: Xml;
  LMissing: Xml;
  LItems: XmlPath;
  LPriced: XmlPath;
  LCount: XmlPath;
  LById: XmlPath;
  LByName: XmlPath;
  LFlag: XmlPath;
  LBad: XmlPath;
  LText: string;
  LNsCount: int64;
  LNsLine: string;
  LSteps: int64;
begin
  LShop := Xml.FromString(SHOP_TEXT);

  // XPath has no default namespace: unprefixed item names no item here until a prefix is bound
  LItems := XmlPath.Compile("s:item").RegisterNamespace("s", SHOP_URI);
  println("default ns items {} bound {}", LShop.Evaluate("count(item)", int64(0)),
    LShop.Evaluate(XmlPath.Compile("count(s:item)").RegisterNamespace("s", SHOP_URI), int64(0)));

  LText := "";
  for LItem in LShop.Select(LItems) do
    LText := LText + " " + LItem.Text();
  end;
  println("names{}", LText);

  // m is declared on shop, so in scope without RegisterNamespace
  LPriced := XmlPath.Compile("s:item[@m:price > 5]").RegisterNamespace("s", SHOP_URI);
  LText := "";
  for LItem in LShop.Select(LPriced) do
    LText := LText + " " + LItem.Text();
  end;
  println("priced{}", LText);
  println("sum {}", BoolText(LShop.Evaluate("sum(*/@m:price)", 0.0) = 19.5));

  LItem := LShop.SelectFirst(LItems);
  println("first {} last {} text {} missing {}", LItem.Get("id"),
    LShop.SelectFirst(XmlPath.Compile("s:item[last()]").RegisterNamespace("s", SHOP_URI)).Text(),
    KindText(LItem.SelectFirst("text()").Kind()), BoolText(LShop.SelectFirst("nothing").IsNull()));

  // An attribute result
  LItem := LShop.SelectFirst("*[@sold]");
  LAttr := LItem.SelectFirst("@m:price");
  println("attr {} {} {} {} {} value {} parent {} line {} markup [{}]", KindText(LAttr.Kind()),
    LAttr.Name(), LAttr.LocalName(), LAttr.Prefix(), LAttr.NamespaceUri(), LAttr.Text(),
    LAttr.Parent().Name(), LAttr.Line(), LAttr.ToString());
  LNsCount := 0;
  for LAttr in LItem.Select("@*") do
    LNsCount := LNsCount + 1;
  end;
  println("all attrs {}", LNsCount);

  // The namespace axis: xml, the default one and m
  LNsCount := 0;
  LNsLine := "";
  for LAttr in LShop.Select("namespace::*") do
    LNsCount := LNsCount + 1;
    if LAttr.Name() = "m" then
      LNsLine := LAttr.Name() + " " + LAttr.Text() + " on " + LAttr.Parent().Name() + " kind " +
        KindText(LAttr.Kind());
    end;
  end;
  println("ns {} {}", LNsCount, LNsLine);

  // $variables: a number, rebound; a string; a boolean
  LById := XmlPath.Compile("string(s:item[@id = $id])").RegisterNamespace("s", SHOP_URI);
  LById := LById.SetVariable("id", int32(2));
  LText := LShop.Evaluate(LById);
  LById := LById.SetVariable("id", int64(3));
  LByName := XmlPath.Compile("string(*[. = $name]/@id)").SetVariable("name", "apple");
  LFlag := XmlPath.Compile("$flag and true()").SetVariable("flag", false);
  println("vars {} {} {} {}", LText, LShop.Evaluate(LById), LShop.Evaluate(LByName),
    BoolText(LShop.Evaluate(LFlag, true)));

  // One compiled expression on two documents
  LOther := Xml.FromString(OTHER_TEXT);
  LCount := XmlPath.Compile("count(//*)");
  println("reuse {} {} valid {}", LShop.Evaluate(LCount, int64(0)), LOther.Evaluate(LCount, int64(0)),
    BoolText(LCount.IsValid()));

  // Errors: a compile error, an unbound prefix, an unbound variable; "" after a run that works
  LBad := XmlPath.Compile("s:item[");
  println("bad compile {} [{}]", BoolText(LBad.IsValid()), LBad.ErrorText());
  LBad := XmlPath.Compile("count(q:x)");
  LSteps := LShop.Evaluate(LBad, int64(-1));
  println("bad prefix {} [{}]", LSteps, LBad.ErrorText());
  LBad := XmlPath.Compile("$nope");
  LText := LShop.Evaluate(LBad, "none");
  println("bad variable {} [{}]", LText, LBad.ErrorText());
  // The same compiled code, now with $nope bound: the run works and clears the error
  LBad := LBad.SetVariable("nope", int32(3));
  LSteps := LShop.Evaluate(LBad, int64(0));
  println("after [{}] {}", LBad.ErrorText(), LSteps);

  // A result that is no node-set selects nothing
  LNsCount := 0;
  for LItem in LShop.Select("count(*)") do
    LNsCount := LNsCount + 1;
  end;
  println("not a set {}", LNsCount);
  println("int32 {} fraction {} bool {}", LShop.Evaluate("count(*)", int32(0)),
    LShop.Evaluate("1 div 2", int64(-1)), BoolText(LShop.Evaluate("count(*) > 2", false)));

  // The document node and the DTD node have no content field: their Text is ""
  LDoc := LShop.SelectFirst("/");
  println("doc {} [{}] root parent {} [{}] dtd {} [{}]", KindText(LDoc.Kind()), LDoc.Text(),
    KindText(LShop.Parent().Kind()), LShop.Parent().Text(), KindText(LDoc.FirstChild().Kind()),
    LDoc.FirstChild().Text());

  LNsCount := 0;
  for LItem in LMissing.Select("*") do
    LNsCount := LNsCount + 1;
  end;
  println("missing {} {}", LNsCount, LMissing.Evaluate("string(*)", "none"));

  // A sequence left early
  LSteps := 0;
  for LItem in LShop.Select(LItems) do
    LSteps := LSteps + 1;
    leave;
  end;
  println("left early {}", LSteps);
end.
