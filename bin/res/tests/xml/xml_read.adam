-------------------------------------------------------------------------------
  xml_read.adam - System.XML.Ext's read surface (PLAN-XML X3a) on both targets
  (the linux ELF run through RunElf): Xml.FromString gives the root element;
  its name, local name, prefix and namespace; the kinds; Text (own text,
  CDATA joined) and InnerText (all below); Line; attributes by plain and
  prefixed name, Get as a string and in the default's type (int32 / int64
  / float64 / bool, a bad value or a missing one the default), TryGet,
  AttributeCount / AttributeNames / Attributes; Children (blank-only text
  dropped, a comment kept), Elements and Elements(name), FindChild,
  FindAll through nested levels (the node itself not counted), the sibling
  and parent walk, Root from a deep node; a walk past the end and a missing
  name give missing values whose every read is empty. The [Heap] line
  shows every libxml2 block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | root lib:library local library prefix lib ns urn:adam:lib kind Element line 2
  | attrs 3 version id lib:owner
  | attr version 2 id 7 owner Jarrod missing none
  | typed 7 7 2.5 true 9 -1 false
  | try true 7 false
  | pairs version=2 id=7 lib:owner=Jarrod
  | children 4 elements 3 count 4 3
  | kinds Comment Element Element Element
  | comment [ shelf list ]
  | books Dune Hyperion Solaris
  | named 2
  | find Hyperion year 1989
  | all 4 Dune Hyperion Solaris Ender
  | text [Dune] inner [Dune] cdata [a < b] mixed [one  two] innermixed [one inner two]
  | walk next Solaris prev Dune parent shelf root lib:library
  | edge true true true true
  | missing true  0 0 true 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe xml_read;

import System.SysUtils, System.XML.Ext;

const
  DOC: string = R"(<?xml version="1.0"?>
<lib:library xmlns:lib="urn:adam:lib" version="2" id="7" lib:owner="Jarrod">
  <!-- shelf list -->
  <shelf name="sf">
    <book year="1965"><title>Dune</title></book>
    <book year="1989"><title>Hyperion</title></book>
    <book year="1961"><title>Solaris</title></book>
  </shelf>
  <note><![CDATA[a < b]]></note>
  <mixed>one <b>inner</b> two<shelf><book><title>Ender</title></book></shelf></mixed>
</lib:library>)";

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// A kind's name
func KindText(const AKind: XmlKind): string;
begin
  if AKind = XmlKind.Element then
    return "Element";
  end;
  if AKind = XmlKind.Comment then
    return "Comment";
  end;
  if AKind = XmlKind.Text then
    return "Text";
  end;
  if AKind = XmlKind.Missing then
    return "Missing";
  end;
  return "Other";
end;

var
  LRoot: Xml;
  LShelf: Xml;
  LNode: Xml;
  LMixed: Xml;
  LMissing: Xml;
  LAttr: XmlAttribute;
  LNames: StringArray;
  LText: string;
  LCount: int64;
  LElems: int64;
  LValue: int64;
  LBad: int64;
  LOk: bool;
begin
  LRoot := Xml.FromString(DOC);
  println("root {} local {} prefix {} ns {} kind {} line {}", LRoot.Name(), LRoot.LocalName(),
    LRoot.Prefix(), LRoot.NamespaceUri(), KindText(LRoot.Kind()), LRoot.Line());

  LNames := LRoot.AttributeNames();
  println("attrs {} {} {} {}", LRoot.AttributeCount(), LNames[0], LNames[1], LNames[2]);
  println("attr version {} id {} owner {} missing {}", LRoot.Get("version"), LRoot.Get("id"),
    LRoot.Get("lib:owner"), LRoot.Get("owner", "none"));
  println("typed {} {} {} {} {} {} {}", LRoot.Get("id", int32(0)), LRoot.Get("id", int64(0)),
    FloatToStr(LRoot.Get("version", 0.0) + 0.5), BoolText(LRoot.Has("version")),
    LRoot.Get("none", int32(9)), LRoot.Get("lib:owner", int32(-1)),
    BoolText(LRoot.Get("version", false)));
  LValue := 0;
  LBad := 0;
  LOk := LRoot.TryGet("id", LValue);
  println("try {} {} {}", BoolText(LOk), LValue, BoolText(LRoot.TryGet("lib:owner", LBad)));

  LText := "";
  for LAttr in LRoot.Attributes() do
    LText := LText + " " + LAttr.Name + "=" + LAttr.Value;
  end;
  println("pairs{}", LText);

  LCount := 0;
  for LNode in LRoot.Children() do
    LCount := LCount + 1;
  end;
  LElems := 0;
  for LNode in LRoot.Elements() do
    LElems := LElems + 1;
  end;
  println("children {} elements {} count {} {}", LCount, LElems, LRoot.ChildCount(),
    LRoot.ElementCount());
  LText := "";
  for LNode in LRoot.Children() do
    LText := LText + " " + KindText(LNode.Kind());
  end;
  println("kinds{}", LText);
  println("comment [{}]", LRoot.FirstChild().Text());

  LShelf := LRoot.FindChild("shelf");
  LText := "";
  for LNode in LShelf.Elements("book") do
    LText := LText + " " + LNode.FindChild("title").Text();
  end;
  println("books{}", LText);
  LCount := 0;
  for LNode in LShelf.FindAll("title") do
    if LNode.Text() <> "Dune" then
      LCount := LCount + 1;
    end;
  end;
  println("named {}", LCount);
  LNode := LShelf.FirstElement().NextElement();
  println("find {} year {}", LNode.FindChild("title").Text(), LNode.Get("year", int32(0)));

  LCount := 0;
  LText := "";
  for LNode in LRoot.FindAll("title") do
    LCount := LCount + 1;
    LText := LText + " " + LNode.Text();
  end;
  println("all {}{}", LCount, LText);

  LMixed := LRoot.FindChild("mixed");
  println("text [{}] inner [{}] cdata [{}] mixed [{}] innermixed [{}]",
    LShelf.FirstElement().FindChild("title").Text(), LShelf.FirstElement().InnerText(),
    LRoot.FindChild("note").Text(), LMixed.Text(),
    Substring(LMixed.InnerText(), 0, 13));

  LNode := LShelf.FirstElement().NextElement();
  println("walk next {} prev {} parent {} root {}",
    LNode.NextElement().FindChild("title").Text(),
    LNode.PreviousElement().FindChild("title").Text(), LNode.Parent().Name(),
    LNode.FindChild("title").FirstChild().Root().Name());

  println("edge {} {} {} {}", BoolText(LShelf.LastElement().NextElement().IsNull()),
    BoolText(LShelf.FirstElement().PreviousElement().IsNull()),
    BoolText(LRoot.FindChild("nothing").IsNull()),
    BoolText(LShelf.FirstElement().FindChild("title").FirstChild().FirstChild().IsNull()));

  LMissing := LRoot.FindChild("nothing").FindChild("deeper");
  LCount := 0;
  for LNode in LMissing.FindAll("title") do
    LCount := LCount + 1;
  end;
  println("missing {} {} {} {} {} {}", BoolText(LMissing.IsNull()), LMissing.Name(),
    LMissing.Get("x", int32(0)), LMissing.AttributeCount(),
    BoolText(LMissing.Root().IsNull()), LCount);
end.
