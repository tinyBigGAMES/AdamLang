-------------------------------------------------------------------------------
  coff_extras.adam - `external` routines of the static lib
  fixtures\libcoffx.a (coffx_extras.c beside it) whose clang object needs
  the C runtime (DESIGN sec 7): adam links only what it reaches of the
  ABI's archives in res/libs/system/<triple> and imports the rest from
  ucrtbase. coffx_length calls strlen (compiler-rt's weak definition, bound
  to its alias), coffx_scale divides an __int128 (__divti3), coffx_deep
  probes a 16 KB frame (___chkstk_ms; each of these a COMDAT section of
  compiler-rt's one object, kept with its associative .pdata / .xdata),
  coffx_upper reads toupper through __imp_toupper (ucrtbase's import slot).
  Values: strlen("static") 6, of "" 0; 7 * 10^12 / 3 truncated
  2333333333333; -9 * 10^12 / 4 = -2250000000000; buffer[5] + 1 = 6;
  (char)16000 is 0x80, -128 signed, + 1 = -127; toupper('a') 65, of '3' 51.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | coffx_length 6
  | coffx_length 0
  | coffx_scale 2333333333333
  | coffx_scale -2250000000000
  | coffx_deep 6
  | coffx_deep -127
  | coffx_upper 65
  | coffx_upper 51
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe coff_extras;

@addlibrarypath "$P:res/tests/coff/fixtures";

import System.SysUtils;

func clink coffx_length(AText: ptr to const char): int64; external "coffx";
func clink coffx_scale(AValue: int64; ADivisor: int64): int64; external "coffx";
func clink coffx_deep(AIndex: int32): int32; external "coffx";
func clink coffx_upper(ALetter: int32): int32; external "coffx";

// ALabel and AValue on one line
func Show(const ALabel: string; const AValue: int64);
begin
  println("{}", ALabel + " " + IntToStr(AValue));
end;

begin
  Show("coffx_length", coffx_length(ptr to const char("static")));
  Show("coffx_length", coffx_length(ptr to const char("")));
  Show("coffx_scale", coffx_scale(7, 3));
  Show("coffx_scale", coffx_scale(-9, 4));
  Show("coffx_deep", int64(coffx_deep(5)));
  Show("coffx_deep", int64(coffx_deep(16000)));
  Show("coffx_upper", int64(coffx_upper(97)));
  Show("coffx_upper", int64(coffx_upper(51)));
end.
