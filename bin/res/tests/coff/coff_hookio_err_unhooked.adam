-------------------------------------------------------------------------------
  coff_hookio_err_unhooked.adam - the COFF linker refuses a hooked link
  that keeps a stream name of ucrt's (PLAN-LINUX64 LX3d3c2d, EL0009's
  twin): the program links System.HookIO.Win64 (its fopen and the rest of
  the hooks are the program's own) and calls _get_stream_buffer_pointers,
  a ucrtbase export that takes a FILE * and answers with pointers into
  ucrt's own FILE, which a handle has not: LK0009 at its declaration.
  puts takes no stream and links as ever.
*******************************************************************************/

/*
@@test
  kind cli
  targets x86_64-windows-gnu
  args "build" "--quiet" "<DIR>/coff_hookio_err_unhooked.adam" "-o" "." "-t" "x86_64-windows-gnu"
  exitcode 1
  | <DIR>/coff_hookio_err_unhooked.adam(39,1): Error LK0009: '_get_stream_buffer_pointers' takes a C stream (FILE *), which System.HookIO in this program does not hook: a stream System.HookIO opened would reach the C runtime's own code
@@end
*/

module exe coff_hookio_err_unhooked;

import System.SysUtils, System.CustomIO, System.HookIO, System.HookIO.Win64;

func clink _get_stream_buffer_pointers(AFile: ptr; ABase: ptr; ANext: ptr; ACount: ptr):
  int32; external "ucrtbase";
func clink puts(AText: ptr to const char): int32; external "ucrtbase";

var
  LFile: ptr;
  LBase: ptr;
  LNext: ptr;
  LCount: ptr;

begin
  LFile := fopen(ptr to const char("io://1/x"), ptr to const char("rb"));
  if LFile <> nil then
    _get_stream_buffer_pointers(LFile, addr of LBase, addr of LNext, addr of LCount);
    fclose(LFile);
  end;
  puts(ptr to const char("never"));
end.
