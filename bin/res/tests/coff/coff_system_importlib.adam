-------------------------------------------------------------------------------
  coff_system_importlib.adam - XW1 (LX7b): a win64 program's system DLL is
  bound through the import library shipped in res\libs\system\x86_64-windows-gnu
  (<dll>.lib, made by zig from mingw-w64's .def), the same file on either
  host: a routine kernel32 does not export is LK0003 naming that kernel32.lib,
  never a DLL of the host's own folder. A cli row for both hosts (a linux
  adam builds the win64 program as a win64 adam does)
*******************************************************************************/

/*
@@test
  kind cli
  targets x86_64-windows-gnu x86_64-linux-gnu
  args "build" "--quiet" "<DIR>/coff_system_importlib.adam" "-o" "." "-t" "x86_64-windows-gnu"
  exitcode 1
  | <DIR>/coff_system_importlib.adam(36,1): Error LK0003: routine 'XW1NotInKernel32' is not exported by '<BIN>/res/libs/system/x86_64-windows-gnu/kernel32.lib'
@@end
*/

module exe coff_system_importlib;

func clink XW1NotInKernel32(): uint64; external "kernel32";

begin
  if XW1NotInKernel32() > 0 then
    println("{}", "never");
  end;
end.
