-------------------------------------------------------------------------------
  coff_pdb_dbghelp_sample.adam - the dep of coff_pdb_dbghelp (M7e): a debug
  program whose PDB DbgHelp reads. Its routine Area has parameters and
  locals of a builtin, a record and a choices type; GCount and GLabel are
  its globals. The row reads its lines by number, so a change here moves
  the row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe coff_pdb_dbghelp_sample;

type
  Point = record
    X: int32;
    Y: int32;
  end;

  Shade = choices(Light, Dark);

var
  GCount: int32;
  GLabel: string;

// The routine the row reads: parameters, locals of each kind
func Area(const AWidth: int32; const AHeight: int32): int64;
var
  LArea: int64;
  LCorner: Point;
  LShade: Shade;
begin
  LCorner.X := AWidth;
  LCorner.Y := AHeight;
  LShade := Shade.Dark;
  LArea := int64(LCorner.X) * int64(LCorner.Y);
  if LShade = Shade.Dark then
    LArea := LArea + 1;
  end;
  return LArea;
end;

begin
  GLabel := "area";
  GCount := 1;
  println("{} {}", GLabel, Area(3, 4));
end.
