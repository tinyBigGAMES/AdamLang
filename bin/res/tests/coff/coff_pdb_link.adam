  | record # ldata 'coff_pdb_link.LRecord' type # at #
  | record # ldata 'coff_pdb_link.LSame' type # at #
  | record # ldata 'coff_pdb_link.LMissing' type # at #
  | record # ldata 'coff_pdb_link.LDiffers' type # at #
  | record # ldata 'coff_pdb_link.LDisorder' type # at #
  | record # ldata 'coff_pdb_link.LAbsolute' type # at #
  | record # ldata 'coff_pdb_link.LNames' type # at #
  | record # ldata 'coff_pdb_link.LInOwn' type # at #
  | record # ldata 'coff_pdb_link.LSeen' type # at #
  | record # ldata 'coff_pdb_link.LHasLine' type # at #
  | record # ldata 'coff_pdb_link.LNumber' type # at #
  | record # ldata 'coff_pdb_link.LText' type # at #
  | record # ldata 'coff_pdb_link.LI' type # at #
  | record # ldata 'coff_pdb_link.LS' type # at #
  | lines file '$P:res/tests/coff/coff_pdb_link.adam': 209 228 234 235 236 237 238 239 241 245 247 251 257 258 259 261 262 263 265 269 275 276 277 278 279 281 282 284 287 291 296 297 298 300 301 302 303 305 314 319 320 321 322 323 324 325 326 332 337 338 340 341 342 343 345 347 349 350 352 353 355 359 364 365 366 367 368 369 370 372 373 375 376 378 379 381 382 383 385 386 388 389 391 392 394 427 429 430 432 433 434 435 438 439 440 441 442 443 444 445 446 449 450 451 452 454 455 456 457 459 460 461 462 464 465 467 468 469 470 471 472 473 474 476 477 478 480 481 482 483 485 486 488 489 491 492 494 495 496 497 500 501 505 506 507 509 510 511 513 514 518 519 521 523 524 525 528 529 530 531 535 536 537 540 541 542 543 546 547 548 549
  | checks missing 0 differs 0 disorder 0 absolute 0 names true
  | done
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe coff_pdb_link;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Pdb.Msf, Adam.Pdb.Writer;

type
  // The sample's types: a record, a choices type
  Point = record
    X: int32;
    Y: int32;
  end;
  Shade = choices(Light, Dark);

var
  GCount: int64;
  GOrigin: Point;

// The sample's routine: parameters, locals of each kind
func Area(const AWidth: int32; const AHeight: int32): int64;
var
  LArea: int64;
  LCorner: Point;
  LShade: Shade;
begin
  LCorner.X := AWidth;
  LCorner.Y := AHeight;
  LShade := Shade.Dark;
  LArea := int64(LCorner.X) * int64(LCorner.Y);
  if LShade = Shade.Dark then
    GCount := GCount + 1;
  end;
  return LArea;
end;

// The AWidth-byte little-endian value at AAt of ABytes
func Get(const ABytes: ByteArray; const AAt: int64; const AWidth: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, AWidth));
end;

// The NUL-ended text at AAt of ABytes
func TextAt(const ABytes: ByteArray; const AAt: int64): string;
var
  LText: string;
  LStop: int64;
  LI: int64;
begin
  LStop := AAt;
  while (LStop < len(ABytes)) and (ABytes[LStop] <> 0) do
    LStop := LStop + 1;
  end;
  setlength(LText, LStop - AAt);
  for LI := 0 to LStop - AAt - 1 do
    LText[LI] := char(ABytes[AAt + LI]);
  end;
  return LText;
end;

// ALine with every hex number (a word holding "0x": an offset, an address) written as #
func Stripped(const ALine: string): string;
var
  LWords: StringArray;
  LOut: string;
  LI: int64;
begin
  LWords := SplitString(ALine, " ");
  LOut := "";
  for LI := 0 to len(LWords) - 1 do
    if LI > 0 then
      LOut := LOut + " ";
    end;
    if IndexOf("0x", LWords[LI], 0) >= 0 then
      LOut := LOut + "#";
    else
      LOut := LOut + LWords[LI];
    end;
  end;
  return LOut;
end;

// The number after AKey in ALine (" stream 12" -> 12); -1 when AKey is not there
func NumberAfter(const ALine: string; const AKey: string): int64;
var
  LAt: int64;
  LEnd: int64;
begin
  LAt := IndexOf(AKey, ALine, 0);
  if LAt < 0 then
    return -1;
  end;
  LAt := LAt + len(AKey);
  LEnd := LAt;
  while (LEnd < len(ALine)) and (ALine[LEnd] <> ' ') do
    LEnd := LEnd + 1;
  end;
  return StrToIntDef(Substring(ALine, LAt, LEnd - LAt), -1);
end;

// The PDB's TPI stream: each type record's offset by its index - 0x1000
var
  GTypes: ByteArray;
  GTypeAt: Int64Array;

// The TPI stream ATpi indexed into GTypes / GTypeAt
func IndexTypes(const ATpi: ByteArray);
var
  LAt: int64;
  LCount: int64;
  LI: int64;
begin
  GTypes := ATpi;
  LCount := Get(ATpi, 12, 4) - Get(ATpi, 8, 4);
  setlength(GTypeAt, LCount);
  LAt := Get(ATpi, 4, 4);
  for LI := 0 to LCount - 1 do
    GTypeAt[LI] := LAt;
    LAt := LAt + Get(ATpi, LAt, 2) + 2;
  end;
end;

// The type AIndex by its Adam name: a builtin its index, a record / object / overlay /
// choices type its name, a pointer "ptr to" its target's
func TypeText(const AIndex: int64): string;
var
  LAt: int64;
  LLeaf: int64;
begin
  if AIndex < 0x1000 then
    return "0x" + IntToHex(uint64(AIndex), 4);
  end;
  LAt := GTypeAt[AIndex - 0x1000];
  LLeaf := Get(GTypes, LAt + 2, 2);
  if LLeaf = 0x1002 then
    return "ptr to " + TypeText(Get(GTypes, LAt + 4, 4));
  end;
  if (LLeaf = 0x1504) or (LLeaf = 0x1505) then
    // count, properties, fields, derived, vtable shape, then a size below 0x8000
    return TextAt(GTypes, LAt + 22);
  end;
  if LLeaf = 0x1506 then
    return TextAt(GTypes, LAt + 14);
  end;
  if LLeaf = 0x1507 then
    return TextAt(GTypes, LAt + 16);
  end;
  return "leaf 0x" + IntToHex(uint64(LLeaf), 4);
end;

// The symbols (ASize bytes) of module stream AStream of AReader, the kinds the sample has
func PrintModule(const AReader: ref MsfReader; const AStream: int64; const ASize: int64);
var
  LBytes: ByteArray;
  LAt: int64;
  LKind: int64;
begin
  LBytes := AReader.Stream(AStream);
  LAt := 4;
  while LAt < ASize do
    LKind := Get(LBytes, LAt + 2, 2);
    if LKind = 0x1101 then
      println("  objname '{}'", TextAt(LBytes, LAt + 8));
    end;
    if LKind = 0x113C then
      println("  compile '{}'", TextAt(LBytes, LAt + 26));
    end;
    if (LKind = 0x110F) or (LKind = 0x1110) then
      println("  proc '{}' local {}", TextAt(LBytes, LAt + 39), LKind = 0x110F);
    end;
    if LKind = 0x1012 then
      println("  frameproc");
    end;
    if LKind = 0x113E then
      println("    local {} {} param {}", TextAt(LBytes, LAt + 10), TypeText(Get(LBytes, LAt + 4, 4)),
        (Get(LBytes, LAt + 8, 2) & 1) <> 0);
    end;
    if (LKind = 0x110C) or (LKind = 0x110D) then
      println("  data {} {}", TextAt(LBytes, LAt + 14), TypeText(Get(LBytes, LAt + 4, 4)));
    end;
    if LKind = 0x1108 then
      println("  udt {} {}", TextAt(LBytes, LAt + 8), TypeText(Get(LBytes, LAt + 4, 4)));
    end;
    if LKind = 0x0006 then
      println("  end");
    end;
    LAt := LAt + Get(LBytes, LAt, 2) + 2;
  end;
end;

var
  LExePath: string;
  LExe: ByteArray;
  LPdb: ByteArray;
  LReader: ref MsfReader;
  LInfo: ByteArray;
  LLines: StringArray;
  LLine: string;
  LPe: int64;
  LSections: int64;
  LTable: int64;
  LRva: int64;
  LAt: int64;
  LEntry: int64;
  LRecord: int64;
  LSame: bool;
  LMissing: int64;
  LDiffers: int64;
  LDisorder: int64;
  LAbsolute: int64;
  LNames: int64;
  LInOwn: bool;
  LSeen: string;
  LHasLine: BoolArray;
  LNumber: int64;
  LText: string;
  LI: int64;
  LS: int64;

begin
  // the sample runs: Area of 3 x 4
  println("area {} count {}", Area(3, 4), GCount);
  LExePath := ProgramFilePath();
  // the plain spelling however the program was started (adamtest starts it in the long one)
  println("program path plain {}", not StartsStr("\\\\?\\", LExePath));
  if not ReadAllBytes(LExePath, LExe) or not ReadAllBytes(ChangeFileExt(LExePath, ".pdb"), LPdb) then
    println("cannot read the exe or its pdb");
    return 1;
  end;
  // the exe's debug directory (data directory 6), found through the section table
  LPe := Get(LExe, 0x3C, 4);
  LSections := Get(LExe, LPe + 6, 2);
  LTable := LPe + 24 + Get(LExe, LPe + 20, 2);
  LRva := Get(LExe, LPe + 24 + 112 + 6 * 8, 4);
  LEntry := -1;
  for LS := 0 to LSections - 1 do
    LAt := LTable + LS * 40;
    if (LRva >= Get(LExe, LAt + 12, 4)) and (LRva < Get(LExe, LAt + 12, 4) + Get(LExe, LAt + 8, 4)) then
      LEntry := LRva - Get(LExe, LAt + 12, 4) + Get(LExe, LAt + 20, 4);
    end;
  end;
  println("debug directory size {} type {}", Get(LExe, LPe + 24 + 112 + 6 * 8 + 4, 4), Get(LExe, LEntry + 12, 4));
  LRecord := Get(LExe, LEntry + 24, 4);
  println("  record 0x{} age {} name '{}' size {}", IntToHex(uint64(Get(LExe, LRecord, 4)), 8),
    Get(LExe, LRecord + 20, 4), TextAt(LExe, LRecord + 24), Get(LExe, LEntry + 16, 4));
  // the PDB: its GUID and age the exe's
  LReader := ref MsfReader(LPdb);
  if not LReader.IsRead() then
    println("pdb not read: {}", LReader.Reason);
    return 1;
  end;
  LInfo := LReader.Stream(1);
  LSame := Get(LInfo, 8, 4) = Get(LExe, LRecord + 20, 4);
  for LI := 0 to 15 do
    LSame := LSame and (LInfo[12 + LI] = LExe[LRecord + 4 + LI]);
  end;
  println("identity same {} signature from guid {}", LSame, Get(LInfo, 4, 4) = Get(LExe, LRecord + 4, 4));
  IndexTypes(LReader.Stream(2));
  // every table checked; the file names; the sample's own module and the linker's
  LLines := SplitString(PdbText(LPdb), "\n");
  LMissing := 0;
  LDiffers := 0;
  LDisorder := 0;
  LAbsolute := 0;
  LNames := 0;
  LInOwn := false;
  LSeen := "";
  // this file's lines
  setlength(LHasLine, 1000);
  for LI := 0 to len(LHasLine) - 1 do
    LHasLine[LI] := false;
  end;
  for LI := 0 to len(LLines) - 1 do
    LLine := LLines[LI];
    if EndsStr(" missing", LLine) then
      LMissing := LMissing + 1;
    end;
    if EndsStr(" differs", LLine) then
      LDiffers := LDiffers + 1;
    end;
    if StartsStr("  hash records ", LLine) and not EndsStr(" in order", LLine) then
      LDisorder := LDisorder + 1;
    end;
    if StartsStr("  name +", LLine) then
      LNames := LNames + 1;
      // a drive or a root: an absolute path (a `$P:` name is the compiler's folder)
      if (IndexOf(":/", LLine, 0) >= 0) or (IndexOf(":\\", LLine, 0) >= 0) or
        (IndexOf("'/", LLine, 0) >= 0) then
        if IndexOf("'$P:", LLine, 0) < 0 then
          LAbsolute := LAbsolute + 1;
        end;
      end;
      if IndexOf("coff_pdb_link.adam", LLine, 0) >= 0 then
        println("name {}", Stripped(Trim(LLine)));
      end;
    end;
    // the DBI's module lines: the sample's (its stream decoded) and the linker's
    if StartsStr("  module ", LLine) then
      if IndexOf("'coff_pdb_link.exe' object", LLine, 0) >= 0 then
        println("module 'coff_pdb_link.exe' symbols {}", NumberAfter(LLine, " symbols ") > 0);
      end;
      if IndexOf("'coff_pdb_link' object", LLine, 0) >= 0 then
        println("module 'coff_pdb_link' files {}", NumberAfter(LLine, " files "));
        PrintModule(LReader, NumberAfter(LLine, " stream "), NumberAfter(LLine, " symbols "));
      end;
      if IndexOf("'* Linker *' object", LLine, 0) >= 0 then
        println("module '* Linker *' symbols {}", NumberAfter(LLine, " symbols "));
      end;
    end;
    // the sample module's lines (PdbText's module block): each line number once
    if StartsStr("module ", LLine) then
      LInOwn := IndexOf("'coff_pdb_link'", LLine, 0) >= 0;
    end;
    if LInOwn and StartsStr("    file ", LLine) then
      // its name alone (a block's count is the code's)
      LSeen := Trim(LLine);
      if IndexOf(" count ", LSeen, 0) >= 0 then
        LSeen := Substring(LSeen, 0, IndexOf(" count ", LSeen, 0));
      end;
    end;
    if LInOwn and StartsStr("      +", LLine) then
      LNumber := NumberAfter(LLine, " line ");
      if (LNumber > 0) and (LNumber < len(LHasLine)) then
        LHasLine[LNumber] := true;
      end;
    end;
    // its globals and UDTs among the globals
    if StartsStr("  record ", LLine) and ((IndexOf("'coff_pdb_link.", LLine, 0) >= 0) or
      (IndexOf(" udt 'Point'", LLine, 0) >= 0) or (IndexOf(" udt 'Shade'", LLine, 0) >= 0)) then
      println("{}", Stripped(Trim(LLine)));
    end;
  end;
  LText := "";
  for LI := 1 to len(LHasLine) - 1 do
    if LHasLine[LI] then
      LText := LText + " " + IntToStr(LI);
    end;
  end;
  println("lines {}:{}", Stripped(LSeen), LText);
  println("checks missing {} differs {} disorder {} absolute {} names {}", LMissing, LDiffers,
    LDisorder, LAbsolute, LNames > 0);
  println("done");
end.
