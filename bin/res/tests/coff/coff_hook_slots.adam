-------------------------------------------------------------------------------
  coff_hook_slots.adam - hooks reached through a static library's import
  slots (Adam.Coff.Linker: `__imp_` + a name the program defines is a
  local slot holding the program's routine). fseeko64: libminizip.a's
  ioapi reads __imp_fseeko64, which libcextras' alias member defines with
  fseeko64 itself (that member is not loaded beside a hook: no second
  definition, FO0003); its real function is ucrtbase's _fseeki64.
  SetFilePointer: libminizip.a's iowin32 reads __imp_SetFilePointer, a
  kernel32 export; its real function comes from HookReal's library form.
  A zip is written, then opened by both file layers: each hook counts its
  calls and the real seek keeps the zip readable (its one entry listed).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | zip open true
  | zip close 0
  | unz open true
  | entries 1
  | unz close 0
  | fseeko64 hooked true
  | win32 open true
  | entries 1
  | win32 close 0
  | SetFilePointer hooked true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe coff_hook_slots;

import System.SysUtils, System.HookAbi, System.Zlib.C, System.Minizip.C;

type
  Fseeko64Fn = func(const AStream: ptr; const AOffset: int64; const AWhence: int32): int32;
  SetFilePointerFn = func(const AFile: uint64; const ADistance: int32;
    const AHigh: ptr to int32; const AMethod: uint32): uint32;

// iowin32's file layer (Windows-only, so not in System.Minizip.C)
func fill_win32_filefunc64A(const AFuncs: ptr to zlib_filefunc64_def); external "minizip";

var
  // The hooks' slots of the real functions, and the calls each hook saw
  GRealSeek: ptr;
  GRealPointer: ptr;
  GSeeks: int64;
  GPointers: int64;
  GZip: ptr;
  GUnzip: ptr;
  GGlobal: unz_global_info64;
  GFuncs: zlib_filefunc64_def;
  GText: array[0..3] of uint8;

// The hook of MinGW's fseeko64: counted, then ucrtbase's _fseeki64
public func fseeko64(const AStream: ptr; const AOffset: int64; const AWhence: int32): int32;
var
  LReal: Fseeko64Fn;
begin
  GSeeks := GSeeks + 1;
  LReal := Fseeko64Fn(HookReal(GRealSeek, ptr to const char("_fseeki64")));
  return LReal(AStream, AOffset, AWhence);
end;

// The hook of kernel32's SetFilePointer: counted, then kernel32's
public func SetFilePointer(const AFile: uint64; const ADistance: int32;
  const AHigh: ptr to int32; const AMethod: uint32): uint32;
var
  LReal: SetFilePointerFn;
begin
  GPointers := GPointers + 1;
  LReal := SetFilePointerFn(HookReal(GRealPointer, ptr to const char("kernel32.dll"),
    ptr to const char("SetFilePointer")));
  return LReal(AFile, ADistance, AHigh, AMethod);
end;

// AValue as true / false
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// ALabel and AValue on one line
func Show(const ALabel: string; const AValue: int64);
begin
  println("{}", ALabel + " " + IntToStr(AValue));
end;

// ALabel and AValue on one line
func ShowBool(const ALabel: string; const AValue: bool);
begin
  println("{}", ALabel + " " + BoolText(AValue));
end;

begin
  GText[0] := uint8(65);
  GText[1] := uint8(100);
  GText[2] := uint8(97);
  GText[3] := uint8(109);
  GZip := zipOpen64(ptr to const char("coff_hook_slots.zip"), APPEND_STATUS_CREATE);
  ShowBool("zip open", GZip <> nil);
  zipOpenNewFileInZip64(GZip, ptr to const char("a.txt"), nil, nil, 0, nil, 0, nil, Z_DEFLATED,
    Z_DEFAULT_COMPRESSION, 0);
  zipWriteInFileInZip(GZip, addr of GText[0], 4);
  zipCloseFileInZip(GZip);
  Show("zip close", int64(zipClose(GZip, nil)));

  // minizip's default file layer: ioapi's seek through __imp_fseeko64
  GUnzip := unzOpen64(ptr to const char("coff_hook_slots.zip"));
  ShowBool("unz open", GUnzip <> nil);
  unzGetGlobalInfo64(GUnzip, addr of GGlobal);
  Show("entries", int64(GGlobal.number_entry));
  Show("unz close", int64(unzClose(GUnzip)));
  ShowBool("fseeko64 hooked", GSeeks > 0);

  // iowin32's file layer: its seek through __imp_SetFilePointer
  fill_win32_filefunc64A(addr of GFuncs);
  GUnzip := unzOpen2_64(ptr to const char("coff_hook_slots.zip"), addr of GFuncs);
  ShowBool("win32 open", GUnzip <> nil);
  unzGetGlobalInfo64(GUnzip, addr of GGlobal);
  Show("entries", int64(GGlobal.number_entry));
  Show("win32 close", int64(unzClose(GUnzip)));
  ShowBool("SetFilePointer hooked", GPointers > 0);
end.
