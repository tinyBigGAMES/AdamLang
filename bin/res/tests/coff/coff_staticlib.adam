-------------------------------------------------------------------------------
  coff_staticlib.adam - `external` routines whose libraries are the static
  libs fixtures\libcoffl.a and libcoffa.a (prebuilt release artifacts, their
  .c beside them): adam links the clang objects that define them into the
  exe and it runs. coffl_sum pulls coffl_main.o in, whose coffl_helper and
  coffl_counter pull coffl_helper.o in (one coffl_shared COMDAT kept of the
  two); the values need every relocation kind the objects carry: REL32 to
  the other object, to .bss, .data and .rdata and through the .refptr
  COMDAT, ADDR64 in coffl_names and .refptr, ADDR32NB in .pdata.
  coffl_sum(1, 2) = coffl_helper(1) (3 + 5) + 2 + 2 + 5; coffl_sum(2, 10) =
  (6 + 5) + 10 + 10 + 5; coffl_bytesum adds the bytes of "linked" and
  "objects"; coffl_scaled truncates a * 2.5; coffa_add (the second library)
  adds.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | coffl_sum 17
  | coffl_sum 36
  | coffl_bytesum 631
  | coffl_bytesum 746
  | coffl_scaled 7
  | coffl_scaled -7
  | coffa_add 3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe coff_staticlib;

@addlibrarypath "$P:res/tests/coff/fixtures";

import System.SysUtils;

func clink coffl_sum(AA: int32; AB: int32): int32; external "coffl";
func clink coffl_bytesum(AI: int32): int32; external "coffl";
func clink coffl_scaled(AA: int32): int32; external "coffl";
func clink coffa_add(AA: int32; AB: int32): int32; external "coffa";

// ALabel and AValue on one line
func Show(const ALabel: string; const AValue: int32);
begin
  println("{}", ALabel + " " + IntToStr(int64(AValue)));
end;

begin
  Show("coffl_sum", coffl_sum(1, 2));
  Show("coffl_sum", coffl_sum(2, 10));
  Show("coffl_bytesum", coffl_bytesum(0));
  Show("coffl_bytesum", coffl_bytesum(1));
  Show("coffl_scaled", coffl_scaled(3));
  Show("coffl_scaled", coffl_scaled(-3));
  Show("coffa_add", coffa_add(1, 2));
end.
