-------------------------------------------------------------------------------
  coff_staticlib.adam - an `external` routine whose library is the static
  lib fixtures\libcoffa.a (no short import; a prebuilt release artifact):
  LK0005 at the declaration until PLAN-ADAM M3.13c links a static
  library's objects; the build fails (exit 1).
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/coff_staticlib.adam" "-o" "."
  exitcode 1
  | <DIR>/coff_staticlib.adam(35,1): Error LK0005: '<DIR>/fixtures/libcoffa.a' holds no routine imported by name: a static library's objects are not linked by adam yet
@@end
*/

module exe coff_staticlib;

@addlibrarypath "$P:res/tests/coff/fixtures";

routine clink coffa_add(AA: int32; AB: int32): int32; external "coffa";

begin
  if coffa_add(1, 2) = 3 then
    println("{}", "added");
  end;
end.
