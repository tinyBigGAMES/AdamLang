-------------------------------------------------------------------------------
  coff_hookio_plain_stream.adam - a link that does not hook the C
  runtime's streams keeps ucrt's stream names (PLAN-LINUX64 LX3d3c2d): no
  System.HookIO, so fopen is ucrtbase's and _get_stream_buffer_pointers
  stays an import of ucrtbase.dll; the build is clean (only a hooked link
  refuses an unhooked stream name, LK0009).
*******************************************************************************/

/*
@@test
  kind cli
  targets x86_64-windows-gnu
  args "build" "--quiet" "<DIR>/coff_hookio_plain_stream.adam" "-o" "." "-t" "x86_64-windows-gnu"
  exitcode 0
@@end
*/

module exe coff_hookio_plain_stream;

func clink fopen(APath: ptr to const char; AMode: ptr to const char): ptr; external "ucrtbase";
func clink fclose(AFile: ptr): int32; external "ucrtbase";
func clink _get_stream_buffer_pointers(AFile: ptr; ABase: ptr; ANext: ptr; ACount: ptr):
  int32; external "ucrtbase";

var
  LFile: ptr;
  LBase: ptr;
  LNext: ptr;
  LCount: ptr;

begin
  LFile := fopen(ptr to const char("NUL"), ptr to const char("rb"));
  if LFile <> nil then
    _get_stream_buffer_pointers(LFile, addr of LBase, addr of LNext, addr of LCount);
    fclose(LFile);
  end;
end.
