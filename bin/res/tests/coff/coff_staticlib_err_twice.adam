-------------------------------------------------------------------------------
  coff_staticlib_err_twice.adam - the program defines coffl_helper itself
  (public clink: the plain C name; a private routine binds an internal
  one), and coffl_sum's object (coffl_main.o of
  fixtures\libcoffl.a) pulls coffl_helper.o in for coffl_counter, which
  defines coffl_helper again: FO0003 at the declaration of coffl_sum, the
  reference that pulled the objects in; the build fails.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/coff_staticlib_err_twice.adam" "-o" "."
  exitcode 1
  | <DIR>/coff_staticlib_err_twice.adam(37,1): Error FO0003: 'coffl_helper' is defined twice: 'libcoffl.a(coffl_helper.o)' defines it again
@@end
*/

module exe coff_staticlib_err_twice;

@addlibrarypath "$P:res/tests/coff/fixtures";

func clink coffl_sum(AA: int32; AB: int32): int32; external "coffl";

public func clink coffl_helper(AA: int32): int32;
begin
  return AA;
end;

begin
  if coffl_sum(1, 2) > 0 then
    println("{}", "never");
  end;
end.
