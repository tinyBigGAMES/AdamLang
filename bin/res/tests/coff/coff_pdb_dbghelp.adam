  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  coff_pdb_dbghelp.adam - DbgHelp reads Adam's PDB (M7e): the dep
  coff_pdb_dbghelp_sample, built debug, is loaded into DbgHelp (no process:
  a made-up process handle, the image read from its file, its PDB found
  beside it by the RSDS entry's file name). Read back through System.Windows.
  Debug's bindings: the routine Area by name (its kind, size, type), its
  first line by address and that line back to the same address by file and
  number, two statement lines inside it, its parameters and locals with
  their types by Adam name (builtins by DbgHelp's kind and size, Point a
  structure with its fields and offsets, Shade an enum), the globals GCount
  and GLabel by name, a name the PDB lacks not found.
*******************************************************************************/

/*
@@test
  kind run
  deps coff.coff_pdb_dbghelp_sample
  args "<OUT>/bin/<CELL>/coff_pdb_dbghelp_sample.exe"
  exitcode 0
  | initialized true
  | loaded true
  | routine true
  |   name coff_pdb_dbghelp_sample.Area function size true type routine
  | line by address true
  |   file '$P:res/tests/coff/coff_pdb_dbghelp_sample.adam' line 44 displacement 0 at start true
  | line by name true
  |   same address true line 44 displacement 0
  | line 53 in Area true
  | line 54 in Area true
  | line 55 in Area true
  | line 56 in Area false
  | line 57 in Area true
  | scope true
  |   param AWidth int 4 flags 0x00D0
  |   param AHeight int 4 flags 0x00D0
  |   local LArea int 8 flags 0x0090
  |   local LCorner Point flags 0x0090
  |   local LShade Shade flags 0x0090
  | enum true
  | local LCorner true
  | record Point size 8 fields 2
  |   field X offset 0 int 4
  |   field Y offset 4 int 4
  | global true
  |   name coff_pdb_dbghelp_sample.GCount data type int 4
  | global true
  |   name coff_pdb_dbghelp_sample.GLabel data type string
  | missing false
  | cleanup true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe coff_pdb_dbghelp;

import System.SysUtils, System.Windows, System.Windows.Debug;

var
  // DbgHelp's handle for this session: no process is read, so any unique value
  GProcess: uint64;
  GBase: uint64;
  GBoxA: own DebugWideBox;
  GBoxB: own DebugWideBox;
  GSample: string;
  GFile: string;
  GSymbol: DebugSymbolInfo;
  GLine: IMAGEHLP_LINEW64;
  GBack: IMAGEHLP_LINEW64;
  GAreaAt: uint64;
  GAreaSize: uint64;
  GFirstLine: uint32;
  GLineAt: uint32;
  GDisplacement: uint32;
  GOffset: int32;
  GChildren: DebugFindChildren;
  GCount: uint32;
  GIndex: int32;
  GFieldOffset: uint32;
  GFieldType: uint32;
  GPointType: uint32;
  GRecordSize: uint64;

// AText as UTF-16 in ABuffer, the text's first unit
routine WideAt(const AText: string; var ABuffer: WideBuffer): ptr to const uint16;
begin
  Utf8ToWide(AText, ABuffer);
  return ptr to const uint16(addr of ABuffer[0]);
end;

// DbgHelp's kind of a builtin type by its name
routine BaseText(const AKind: uint32): string;
begin
  if AKind = btVoid then
    return "void";
  end;
  if AKind = btChar then
    return "char";
  end;
  if AKind = btWChar then
    return "wchar";
  end;
  if AKind = btInt then
    return "int";
  end;
  if AKind = btUInt then
    return "uint";
  end;
  if AKind = btFloat then
    return "float";
  end;
  if AKind = btBool then
    return "bool";
  end;
  if AKind = btLong then
    return "long";
  end;
  if AKind = btULong then
    return "ulong";
  end;
  return "basic " + UIntToStr(uint64(AKind));
end;

// Type AType of the module at ABase as DbgHelp sees it: a builtin by its kind and size, a
// pointer or array by its element, a structure / enum / typedef by its name
routine TypeText(const ABase: uint64; const AType: uint32): string;
var
  LTag: uint32;
  LKind: uint32;
  LLength: uint64;
  LInner: uint32;
begin
  LTag := 0;
  if SymGetTypeInfo(GProcess, ABase, AType, TI_GET_SYMTAG, ptr(addr of LTag)) = 0 then
    return "no type";
  end;
  if LTag = SymTagBaseType then
    LKind := 0;
    LLength := 0;
    SymGetTypeInfo(GProcess, ABase, AType, TI_GET_BASETYPE, ptr(addr of LKind));
    SymGetTypeInfo(GProcess, ABase, AType, TI_GET_LENGTH, ptr(addr of LLength));
    return BaseText(LKind) + " " + UIntToStr(LLength);
  end;
  if (LTag = SymTagPointerType) or (LTag = SymTagArrayType) then
    LInner := 0;
    SymGetTypeInfo(GProcess, ABase, AType, TI_GET_TYPE, ptr(addr of LInner));
    if LTag = SymTagPointerType then
      return "ptr to " + TypeText(ABase, LInner);
    end;
    return "array of " + TypeText(ABase, LInner);
  end;
  if LTag = SymTagFunctionType then
    return "routine";
  end;
  if (LTag = SymTagUDT) or (LTag = SymTagEnum) or
    (LTag = SymTagTypedef) then
    return SymTypeName(GProcess, ABase, AType);
  end;
  return "tag " + UIntToStr(uint64(LTag));
end;

// A symbol's kind by its tag
routine TagText(const ATag: uint32): string;
begin
  if ATag = SymTagFunction then
    return "function";
  end;
  if ATag = SymTagData then
    return "data";
  end;
  if ATag = SymTagPublicSymbol then
    return "public";
  end;
  return "tag " + UIntToStr(uint64(ATag));
end;

// SymEnumSymbolsW's callback: one line per parameter / local of the scope
routine clink OnSymbol(ASymbol: ptr to const DebugSymbolInfo; ASymbolSize: uint32;
  AContext: ptr): int32;
var
  LKind: string;
begin
  LKind := "symbol";
  if (ASymbol->Flags & SYMFLAG_LOCAL) <> 0 then
    LKind := "local";
  end;
  if (ASymbol->Flags & SYMFLAG_PARAMETER) <> 0 then
    LKind := "param";
  end;
  println("  {} {} {} flags 0x{}", LKind, DbgSymbolName(ASymbol^),
    TypeText(ASymbol->ModBase, ASymbol->TypeIndex), IntToHex(uint64(ASymbol->Flags), 4));
  return 1;
end;

// The symbol AName in the sample module into GSymbol
routine Find(const AName: string): bool;
begin
  GSymbol.SizeOfStruct := ADAM_WINDOWS_SYMBOL_INFO_SIZE;
  GSymbol.MaxNameLen := MAX_SYM_NAME;
  return SymFromNameW(GProcess, WideAt("sample!" + AName, GBoxA.Data), GSymbol) <> 0;
end;

// Whether line ALine of the sample's file is code inside Area
routine LineInArea(const ALine: uint32): bool;
begin
  GBack.SizeOfStruct := ADAM_WINDOWS_LINE_INFO_SIZE;
  GOffset := 0;
  if SymGetLineFromNameW64(GProcess, WideAt("sample", GBoxA.Data), WideAt(GFile, GBoxB.Data),
    ALine, GOffset, GBack) = 0 then
    return false;
  end;
  return (GOffset = 0) and (GBack.LineNumber = ALine) and (GBack.Address > GAreaAt) and
    (GBack.Address < GAreaAt + GAreaSize);
end;

begin
  GProcess := 0xADA4;
  GBoxA := own DebugWideBox();
  GBoxB := own DebugWideBox();
  GSample := ReplaceStr(paramstr(1), "/", "\\");

  SymSetOptions(SYMOPT_UNDNAME | SYMOPT_LOAD_LINES |
    SYMOPT_FAIL_CRITICAL_ERRORS | SYMOPT_IGNORE_NT_SYMPATH |
    SYMOPT_NO_PROMPTS);
  println("initialized {}", SymInitializeW(GProcess, WideAt(ExtractFileDir(GSample),
    GBoxA.Data), 0) <> 0);
  GBase := SymLoadModuleExW(GProcess, 0, WideAt(GSample, GBoxA.Data), WideAt("sample",
    GBoxB.Data), 0x10000000, 0, nil, 0);
  println("loaded {}", GBase = 0x10000000);

  // The routine by name, its first line by address and back by file and number
  println("routine {}", Find("coff_pdb_dbghelp_sample.Area"));
  GAreaAt := GSymbol.Address;
  GAreaSize := uint64(GSymbol.Size);
  println("  name {} {} size {} type {}", DbgSymbolName(GSymbol), TagText(GSymbol.Tag),
    GAreaSize > 0, TypeText(GSymbol.ModBase, GSymbol.TypeIndex));
  GLine.SizeOfStruct := ADAM_WINDOWS_LINE_INFO_SIZE;
  GDisplacement := 1;
  println("line by address {}", SymGetLineFromAddrW64(GProcess, GAreaAt, GDisplacement,
    GLine) <> 0);
  GFile := DbgWideText(GLine.FileName);
  GFirstLine := GLine.LineNumber;
  println("  file '{}' line {} displacement {} at start {}", GFile, GFirstLine, GDisplacement,
    GLine.Address = GAreaAt);
  GBack.SizeOfStruct := ADAM_WINDOWS_LINE_INFO_SIZE;
  GOffset := 1;
  println("line by name {}", SymGetLineFromNameW64(GProcess, WideAt("sample", GBoxA.Data),
    WideAt(GFile, GBoxB.Data), GFirstLine, GOffset, GBack) <> 0);
  println("  same address {} line {} displacement {}", GBack.Address = GAreaAt,
    GBack.LineNumber, GOffset);
  for GLineAt := 53 to 57 do
    println("line {} in Area {}", GLineAt, LineInArea(GLineAt));
  end;

  // Its parameters and locals
  println("scope {}", SymSetScopeFromAddr(GProcess, GAreaAt) <> 0);
  println("enum {}", SymEnumSymbolsW(GProcess, 0, nil, OnSymbol, nil) <> 0);

  // The record type of LCorner: its size and fields
  GSymbol.SizeOfStruct := ADAM_WINDOWS_SYMBOL_INFO_SIZE;
  GSymbol.MaxNameLen := MAX_SYM_NAME;
  println("local LCorner {}", SymFromNameW(GProcess, WideAt("LCorner", GBoxA.Data),
    GSymbol) <> 0);
  GPointType := GSymbol.TypeIndex;
  GRecordSize := 0;
  SymGetTypeInfo(GProcess, GBase, GPointType, TI_GET_LENGTH, ptr(addr of GRecordSize));
  GCount := 0;
  SymGetTypeInfo(GProcess, GBase, GPointType, TI_GET_CHILDRENCOUNT, ptr(addr of GCount));
  println("record {} size {} fields {}", SymTypeName(GProcess, GBase, GPointType), GRecordSize,
    GCount);
  GChildren.Count := GCount;
  GChildren.Start := 0;
  if SymGetTypeInfo(GProcess, GBase, GPointType, TI_FINDCHILDREN,
    ptr(addr of GChildren)) <> 0 then
    for GIndex := 0 to int32(GCount) - 1 do
      GFieldOffset := 0;
      GFieldType := 0;
      SymGetTypeInfo(GProcess, GBase, GChildren.ChildId[GIndex], TI_GET_OFFSET,
        ptr(addr of GFieldOffset));
      SymGetTypeInfo(GProcess, GBase, GChildren.ChildId[GIndex], TI_GET_TYPE,
        ptr(addr of GFieldType));
      println("  field {} offset {} {}", SymTypeName(GProcess, GBase, GChildren.ChildId[GIndex]),
        GFieldOffset, TypeText(GBase, GFieldType));
    end;
  end;

  // The globals by name, a name the PDB lacks
  println("global {}", Find("coff_pdb_dbghelp_sample.GCount"));
  println("  name {} {} type {}", DbgSymbolName(GSymbol), TagText(GSymbol.Tag),
    TypeText(GSymbol.ModBase, GSymbol.TypeIndex));
  println("global {}", Find("coff_pdb_dbghelp_sample.GLabel"));
  println("  name {} {} type {}", DbgSymbolName(GSymbol), TagText(GSymbol.Tag),
    TypeText(GSymbol.ModBase, GSymbol.TypeIndex));
  println("missing {}", Find("coff_pdb_dbghelp_sample.NoSuchName"));
  println("cleanup {}", SymCleanup(GProcess) <> 0);
end.
