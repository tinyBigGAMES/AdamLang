module exe coff_pdb_msf;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Pdb.Msf, Adam.Pdb.Writer;

// A whole record of AKind over APayload: its length, its kind, the payload, then to a
// 4-byte end zeros (a symbol) or LF_PAD bytes (a type)
routine MakeRecord(const AKind: int64; const APayload: ref MsfBytes; const AIsType: bool): ByteArray;
var
  LOut: ref MsfBytes;
begin
  LOut := ref MsfBytes();
  LOut.Put(0, 2);
  LOut.Put(uint64(AKind), 2);
  LOut.PutBytes(APayload.Bytes());
  while (LOut.Count & 3) <> 0 do
    if AIsType then
      LOut.Put(uint64(0xF0 + (4 - (LOut.Count & 3))), 1);
    else
      LOut.Put(0, 1);
    end;
  end;
  LOut.Patch(0, uint64(LOut.Count - 2), 2);
  return LOut.Bytes();
end;

// An S_GPROC32 / S_LPROC32 of AKind named AText at section 1 offset AOffset, ASize bytes
routine MakeProc(const AKind: int64; const AText: string; const AOffset: int64;
  const ASize: int64): ByteArray;
var
  LPayload: ref MsfBytes;
begin
  LPayload := ref MsfBytes();
  // parent, end, next (the writer sets the first two), size, debug start / end, type
  LPayload.Put(0, 4);
  LPayload.Put(0, 4);
  LPayload.Put(0, 4);
  LPayload.Put(uint64(ASize), 4);
  LPayload.Put(4, 4);
  LPayload.Put(uint64(ASize - 4), 4);
  LPayload.Put(0x1001, 4);
  LPayload.Put(uint64(AOffset), 4);
  LPayload.Put(1, 2);
  LPayload.Put(0, 1);
  LPayload.PutText(AText);
  return MakeRecord(AKind, LPayload, false);
end;

// An S_GDATA32 / S_LDATA32 of AKind named AText of type AType at section 2 offset AOffset
routine MakeData(const AKind: int64; const AText: string; const AType: int64;
  const AOffset: int64): ByteArray;
var
  LPayload: ref MsfBytes;
begin
  LPayload := ref MsfBytes();
  LPayload.Put(uint64(AType), 4);
  LPayload.Put(uint64(AOffset), 4);
  LPayload.Put(2, 2);
  LPayload.PutText(AText);
  return MakeRecord(AKind, LPayload, false);
end;

// An S_UDT naming AText the type AType
routine MakeUdt(const AText: string; const AType: int64): ByteArray;
var
  LPayload: ref MsfBytes;
begin
  LPayload := ref MsfBytes();
  LPayload.Put(uint64(AType), 4);
  LPayload.PutText(AText);
  return MakeRecord(0x1108, LPayload, false);
end;

// An S_END
routine MakeEnd(): ByteArray;
var
  LPayload: ref MsfBytes;
begin
  LPayload := ref MsfBytes();
  return MakeRecord(0x0006, LPayload, false);
end;

// An S_OBJNAME of the object AText
routine MakeObjName(const AText: string): ByteArray;
var
  LPayload: ref MsfBytes;
begin
  LPayload := ref MsfBytes();
  LPayload.Put(0, 4);
  LPayload.PutText(AText);
  return MakeRecord(0x1101, LPayload, false);
end;

// An LF_STRUCTURE named AText (unique name AUnique) of ACount fields in AFields, ASize
// bytes, with the properties AProperties
routine MakeStructure(const AText: string; const AUnique: string; const ACount: int64;
  const AFields: int64; const ASize: int64; const AProperties: int64): ByteArray;
var
  LPayload: ref MsfBytes;
begin
  LPayload := ref MsfBytes();
  LPayload.Put(uint64(ACount), 2);
  LPayload.Put(uint64(AProperties), 2);
  LPayload.Put(uint64(AFields), 4);
  LPayload.Put(0, 4);
  LPayload.Put(0, 4);
  LPayload.Put(uint64(ASize), 2);
  LPayload.PutText(AText);
  LPayload.PutText(AUnique);
  return MakeRecord(0x1505, LPayload, true);
end;

// ACount bytes of a pattern a stream's place shows through (each byte its index's low 8
// bits mixed with ASeed)
routine Pattern(const ACount: int64; const ASeed: int64): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, ACount);
  for LI := 0 to ACount - 1 do
    LBytes[LI] := uint8((LI * 7 + ASeed + (LI div 512)) & 255);
  end;
  return LBytes;
end;

// True when ALeft and ARight hold the same bytes
routine Same(const ALeft: ByteArray; const ARight: ByteArray): bool;
var
  LI: int64;
begin
  if len(ALeft) <> len(ARight) then
    return false;
  end;
  for LI := 0 to len(ALeft) - 1 do
    if ALeft[LI] <> ARight[LI] then
      return false;
    end;
  end;
  return true;
end;

// The streams of AWriter compared with the reader's of its file: "same" or the first
// stream that differs
routine CompareStreams(const AWriter: ref MsfWriter; const AFile: ByteArray): string;
var
  LReader: ref MsfReader;
  LS: int64;
begin
  LReader := ref MsfReader(AFile);
  if not LReader.IsRead() then
    return "not read: " + LReader.Reason;
  end;
  if LReader.StreamCount() <> AWriter.StreamCount() then
    return "stream count " + IntToStr(LReader.StreamCount());
  end;
  for LS := 0 to AWriter.StreamCount() - 1 do
    if not Same(AWriter.StreamAt(LS), LReader.Stream(LS)) then
      return "stream " + IntToStr(LS) + " differs";
    end;
  end;
  return "same";
end;

// A section header named AText: virtual size, address, characteristics
routine AddHeader(const AHeaders: ref MsfBytes; const AText: string; const ASize: int64;
  const AAddress: int64; const ACharacteristics: int64);
var
  LI: int64;
begin
  for LI := 0 to 7 do
    if LI < len(AText) then
      AHeaders.Put(uint64(uint8(AText[LI])), 1);
    else
      AHeaders.Put(0, 1);
    end;
  end;
  AHeaders.Put(uint64(ASize), 4);
  AHeaders.Put(uint64(AAddress), 4);
  // raw size and pointers, counts
  AHeaders.PutZeros(20);
  AHeaders.Put(uint64(ACharacteristics), 4);
end;

// The made PDB input (see the header)
routine MakeInput(): ref PdbInput;
var
  LInput: ref PdbInput;
  LModule: ref PdbModule;
  LLines: ref PdbLines;
  LPayload: ref MsfBytes;
  LHeaders: ref MsfBytes;
  LI: int64;
begin
  LInput := ref PdbInput(0x8664);
  for LI := 0 to 15 do
    LInput.Guid[LI] := uint8(0x10 + LI);
  end;
  LInput.Signature := 0x12345678;
  // Types: an arg list, a procedure, Point's forward record, its fields, Point, a pointer
  LPayload := ref MsfBytes();
  LPayload.Put(0, 4);
  LInput.AddType(MakeRecord(0x1201, LPayload, true));
  LPayload := ref MsfBytes();
  LPayload.Put(0x0003, 4);
  LPayload.Put(0, 1);
  LPayload.Put(0, 1);
  LPayload.Put(0, 2);
  LPayload.Put(0x1000, 4);
  LInput.AddType(MakeRecord(0x1008, LPayload, true));
  LInput.AddType(MakeStructure("Point", "m.Point", 0, 0, 0, 0x0280));
  LPayload := ref MsfBytes();
  LPayload.Put(0x150D, 2);
  LPayload.Put(3, 2);
  LPayload.Put(0x0074, 4);
  LPayload.Put(0, 2);
  LPayload.PutText("X");
  LPayload.Put(0xF1, 1);
  LPayload.Put(0x150D, 2);
  LPayload.Put(3, 2);
  LPayload.Put(0x0074, 4);
  LPayload.Put(4, 2);
  LPayload.PutText("Y");
  LInput.AddType(MakeRecord(0x1203, LPayload, true));
  LInput.AddType(MakeStructure("Point", "m.Point", 2, 0x1003, 8, 0x0200));
  LPayload := ref MsfBytes();
  LPayload.Put(0x1002, 4);
  LPayload.Put(0x1000C, 4);
  LInput.AddType(MakeRecord(0x1002, LPayload, true));
  // An id: Point's source line in module 1
  LPayload := ref MsfBytes();
  LPayload.Put(0x1004, 4);
  LPayload.Put(0, 4);
  LPayload.Put(3, 4);
  LPayload.Put(1, 2);
  LInput.AddId(MakeRecord(0x1607, LPayload, true));
  // Module 0: every routing kind, a block inside a procedure, lines over two files
  LModule := LInput.AddModule("m.adam", "m.acu");
  LModule.AddFile("m.adam");
  LModule.AddFile("inc.adam");
  LModule.AddSymbol(MakeObjName("m.acu"));
  LModule.AddSymbol(MakeUdt("Point", 0x1004));
  LModule.AddSymbol(MakeProc(0x1110, "m.Main", 0x10, 0x20));
  LPayload := ref MsfBytes();
  LPayload.Put(8, 4);
  LPayload.Put(0x0074, 4);
  LPayload.Put(335, 2);
  LPayload.PutText("LCount");
  LModule.AddSymbol(MakeRecord(0x1111, LPayload, false));
  LPayload := ref MsfBytes();
  LPayload.Put(0, 4);
  LPayload.Put(0, 4);
  LPayload.Put(8, 4);
  LPayload.Put(0x14, 4);
  LPayload.Put(1, 2);
  LPayload.PutText("");
  LModule.AddSymbol(MakeRecord(0x1103, LPayload, false));
  LModule.AddSymbol(MakeUdt("LocalT", 0x1004));
  LModule.AddSymbol(MakeEnd());
  LModule.AddSymbol(MakeEnd());
  LModule.AddSymbol(MakeProc(0x110F, "m.Helper", 0x30, 0x10));
  LModule.AddSymbol(MakeEnd());
  LModule.AddSymbol(MakeData(0x110D, "m.GCount", 0x0074, 0));
  LModule.AddSymbol(MakeData(0x110C, "m.GLocal", 0x1004, 8));
  LPayload := ref MsfBytes();
  LPayload.Put(0x0074, 4);
  LPayload.Put(7, 2);
  LPayload.PutText("m.SEVEN");
  LModule.AddSymbol(MakeRecord(0x1107, LPayload, false));
  LLines := ref PdbLines(1, 0x10, 0x20);
  LLines.Add(0, 3, 0);
  LLines.Add(4, 4, 0);
  LLines.Add(0x10, 1, 1);
  LLines.Add(0x18, 5, 0);
  LModule.AddLines(LLines);
  LLines := ref PdbLines(1, 0x30, 0x10);
  LLines.Add(0, 9, 0);
  LModule.AddLines(LLines);
  // Module 1: the same S_UDT (one global), a procedure
  LModule := LInput.AddModule("n.adam", "n.acu");
  LModule.AddFile("n.adam");
  LModule.AddSymbol(MakeObjName("n.acu"));
  LModule.AddSymbol(MakeUdt("Point", 0x1004));
  LModule.AddSymbol(MakeProc(0x1110, "n.Run", 0x40, 0x8));
  LModule.AddSymbol(MakeEnd());
  LLines := ref PdbLines(1, 0x40, 0x8);
  LLines.Add(0, 2, 0);
  LModule.AddLines(LLines);
  // Contributions out of order, publics, the section headers
  LInput.AddContribution(2, 0, 0x10, 0xC0000040, 0);
  LInput.AddContribution(1, 0x40, 0x8, 0x60000020, 1);
  LInput.AddContribution(1, 0x10, 0x30, 0x60000020, 0);
  LInput.AddPublic("main", 1, 0x10, true);
  LInput.AddPublic("m_GCount", 2, 0, false);
  LInput.AddPublic("n_Run", 1, 0x40, true);
  LInput.AddPublic("aaa", 2, 8, false);
  LHeaders := ref MsfBytes();
  AddHeader(LHeaders, ".text", 0x48, 0x1000, 0x60000020);
  AddHeader(LHeaders, ".data", 0x10, 0x2000, 0xC0000040);
  LInput.SectionHeaders := LHeaders.Bytes();
  return LInput;
end;

var
  LMsf: ref MsfWriter;
  LReader: ref MsfReader;
  LPdb: ref MsfWriter;
  LFile: ByteArray;
  LAgain: ByteArray;

begin
  // The MSF: an empty stream, a small one, one past two intervals of 512 blocks
  LMsf := ref MsfWriter(512);
  LMsf.AddStream(Pattern(0, 0));
  LMsf.AddStream(Pattern(100, 3));
  LMsf.AddStream(Pattern(600000, 5));
  LMsf.AddStream(Pattern(512, 9));
  LFile := LMsf.Write();
  LReader := ref MsfReader(LFile);
  print("{}", MsfText(LReader));
  println("msf round trip {}", CompareStreams(LMsf, LFile));
  // A file the reader refuses: its length cut by one block
  setlength(LFile, len(LFile) - 512);
  LReader := ref MsfReader(LFile);
  print("{}", MsfText(LReader));
  // The PDB
  LPdb := PdbStreams(MakeInput(), ADAM_MSF_BLOCK_SIZE);
  LFile := LPdb.Write();
  println("pdb round trip {}", CompareStreams(LPdb, LFile));
  LAgain := WritePdb(MakeInput());
  if Same(LFile, LAgain) then
    println("pdb written twice: same bytes");
  else
    println("pdb written twice: differs");
  end;
  print("{}", PdbText(LFile));
  println("done");
end.
