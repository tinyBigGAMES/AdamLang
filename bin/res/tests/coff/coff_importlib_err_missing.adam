-------------------------------------------------------------------------------
  coff_importlib_err_missing.adam - an `external` routine the import lib
  fixtures\libk32sub.dll.a does not give: LK0003 at the declaration, naming
  the lib as adam found it through $P:, which the expected line spells with
  adamtest's <BIN> hole (the folder of the adam.exe run).
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/coff_importlib_err_missing.adam" "-o" "."
  exitcode 1
  | <DIR>/coff_importlib_err_missing.adam(35,1): Error LK0003: routine 'NotInK32Sub' is not exported by '<BIN>/res/tests/coff/fixtures/libk32sub.dll.a'
@@end
*/

module exe coff_importlib_err_missing;

@addlibrarypath "$P:res/tests/coff/fixtures";

routine clink NotInK32Sub(): uint64; external "k32sub";

begin
  if NotInK32Sub() > 0 then
    println("{}", "never");
  end;
end.
