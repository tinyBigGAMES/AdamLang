-------------------------------------------------------------------------------
  coff_object.adam - Adam.Coff.Reader (imported from the compiler's own
  src\, beside bin\) reads each object of the prebuilt link fixture
  fixtures\libcoffl.a (clang objects; its .c beside it), each a slice of the
  archive's bytes, and every damaged form it reports. The section,
  relocation and symbol lines are the objects' bytes as llvm-readobj
  --sections --relocs --symbols reads them: a section's number, name,
  Characteristics, alignment, raw size, relocation count and a COMDAT's
  selection and Number; a relocation's section, offset, type and symbol
  index; every symbol record's index, name, value, section number, type,
  storage class and aux count (aux records are not lines).
*******************************************************************************/

/*
@@test
  kind run
  args "<DIR>/fixtures/libcoffl.a"
  exitcode 0
  | object coffl_main.o: machine 0x8664, 10 sections, 33 symbol records
  | section 1 .text flags 0x60500020 align 16 size 166 relocs 6
  | section 2 .data flags 0xC0500040 align 16 size 16 relocs 2
  | section 3 .bss flags 0xC0500080 align 16 size 16 relocs 0
  | section 4 .xdata flags 0x40300040 align 4 size 32 relocs 0
  | section 5 .rdata flags 0x40400040 align 8 size 23 relocs 0
  | section 6 .data$coffl_shared flags 0xC0301040 align 4 size 4 relocs 0 comdat 2 number 6
  | section 7 .rdata$.refptr.coffl_counter flags 0x40401040 align 8 size 8 relocs 1 comdat 2 number 7
  | section 8 .debug$S flags 0x42300040 align 4 size 144 relocs 0
  | section 9 .pdata flags 0x40300040 align 4 size 36 relocs 9
  | section 10 .llvm_addrsig flags 0x00100800 align 1 size 1 relocs 0
  | reloc 1 0x12 type 4 -> 15 .refptr.coffl_counter
  | reloc 1 0x24 type 4 -> 24 coffl_zeroes
  | reloc 1 0x2C type 4 -> 25 coffl_helper
  | reloc 1 0x37 type 4 -> 12 coffl_shared
  | reloc 1 0x5A type 4 -> 27 coffl_names
  | reloc 1 0x9C type 4 -> 8 .rdata
  | reloc 2 0x0 type 1 -> 29 coffl_first
  | reloc 2 0x8 type 1 -> 8 .rdata
  | reloc 7 0x0 type 1 -> 30 coffl_counter
  | reloc 9 0x0 type 3 -> 0 .text
  | reloc 9 0x4 type 3 -> 0 .text
  | reloc 9 0x8 type 3 -> 6 .xdata
  | reloc 9 0xC type 3 -> 0 .text
  | reloc 9 0x10 type 3 -> 0 .text
  | reloc 9 0x14 type 3 -> 6 .xdata
  | reloc 9 0x18 type 3 -> 0 .text
  | reloc 9 0x1C type 3 -> 0 .text
  | reloc 9 0x20 type 3 -> 6 .xdata
  | symbol 0 .text value 0 section 1 type 0 class 3 aux 1
  | symbol 2 .data value 0 section 2 type 0 class 3 aux 1
  | symbol 4 .bss value 0 section 3 type 0 class 3 aux 1
  | symbol 6 .xdata value 0 section 4 type 0 class 3 aux 1
  | symbol 8 .rdata value 0 section 5 type 0 class 3 aux 1
  | symbol 10 .data$coffl_shared value 0 section 6 type 0 class 3 aux 1
  | symbol 12 coffl_shared value 0 section 6 type 0 class 2 aux 0
  | symbol 13 .rdata$.refptr.coffl_counter value 0 section 7 type 0 class 3 aux 1
  | symbol 15 .refptr.coffl_counter value 0 section 7 type 0 class 2 aux 0
  | symbol 16 .debug$S value 0 section 8 type 0 class 3 aux 1
  | symbol 18 .pdata value 0 section 9 type 0 class 3 aux 1
  | symbol 20 .llvm_addrsig value 0 section 10 type 0 class 3 aux 1
  | symbol 22 @feat.00 value 0 section -1 type 0 class 3 aux 0
  | symbol 23 coffl_sum value 0 section 1 type 32 class 2 aux 0
  | symbol 24 coffl_zeroes value 0 section 3 type 0 class 3 aux 0
  | symbol 25 coffl_helper value 0 section 0 type 0 class 2 aux 0
  | symbol 26 coffl_bytesum value 80 section 1 type 32 class 2 aux 0
  | symbol 27 coffl_names value 0 section 2 type 0 class 2 aux 0
  | symbol 28 coffl_scaled value 144 section 1 type 32 class 2 aux 0
  | symbol 29 coffl_first value 8 section 5 type 0 class 3 aux 0
  | symbol 30 coffl_counter value 0 section 0 type 0 class 2 aux 0
  | symbol 31 .file value 0 section -2 type 0 class 103 aux 1
  | object coffl_helper.o: machine 0x8664, 9 sections, 25 symbol records
  | section 1 .text flags 0x60500020 align 16 size 42 relocs 3
  | section 2 .data flags 0xC0300040 align 4 size 0 relocs 0
  | section 3 .bss flags 0xC0300080 align 4 size 4 relocs 0
  | section 4 .xdata flags 0x40300040 align 4 size 16 relocs 0
  | section 5 .rdata flags 0x40400040 align 8 size 16 relocs 0
  | section 6 .data$coffl_shared flags 0xC0301040 align 4 size 4 relocs 0 comdat 2 number 6
  | section 7 .debug$S flags 0x42300040 align 4 size 148 relocs 0
  | section 8 .pdata flags 0x40300040 align 4 size 24 relocs 6
  | section 9 .llvm_addrsig flags 0x00100800 align 1 size 0 relocs 0
  | reloc 1 0x9 type 4 -> 12 coffl_shared
  | reloc 1 0x1C type 4 -> 8 .rdata
  | reloc 1 0x24 type 4 -> 8 .rdata
  | reloc 8 0x0 type 3 -> 0 .text
  | reloc 8 0x4 type 3 -> 0 .text
  | reloc 8 0x8 type 3 -> 6 .xdata
  | reloc 8 0xC type 3 -> 0 .text
  | reloc 8 0x10 type 3 -> 0 .text
  | reloc 8 0x14 type 3 -> 6 .xdata
  | symbol 0 .text value 0 section 1 type 0 class 3 aux 1
  | symbol 2 .data value 0 section 2 type 0 class 3 aux 1
  | symbol 4 .bss value 0 section 3 type 0 class 3 aux 1
  | symbol 6 .xdata value 0 section 4 type 0 class 3 aux 1
  | symbol 8 .rdata value 0 section 5 type 0 class 3 aux 1
  | symbol 10 .data$coffl_shared value 0 section 6 type 0 class 3 aux 1
  | symbol 12 coffl_shared value 0 section 6 type 0 class 2 aux 0
  | symbol 13 .debug$S value 0 section 7 type 0 class 3 aux 1
  | symbol 15 .pdata value 0 section 8 type 0 class 3 aux 1
  | symbol 17 .llvm_addrsig value 0 section 9 type 0 class 3 aux 1
  | symbol 19 @feat.00 value 0 section -1 type 0 class 3 aux 0
  | symbol 20 coffl_helper value 0 section 1 type 32 class 2 aux 0
  | symbol 21 coffl_half value 16 section 1 type 32 class 2 aux 0
  | symbol 22 coffl_counter value 0 section 3 type 0 class 2 aux 0
  | symbol 23 .file value 0 section -2 type 0 class 103 aux 1
  | Error OB0001: 'cut header' is damaged: its file header runs past its end
  | Error OB0001: 'cut sections' is damaged: its section table runs past its end
  | Error OB0001: 'cut symbols' is damaged: its symbol table runs past its end
  | Error OB0001: 'cut strings' is damaged: its string table runs past its end
  | Error OB0001: 'bad symbol name' is damaged: symbol 0 names a place its string table does not hold
  | Error OB0001: 'aux past' is damaged: symbol 0 says 1 auxiliary records follow it, past its symbol table
  | Error OB0001: 'bad section name' is damaged: section 1 names a place its string table does not hold
  | Error OB0001: 'bad align' is damaged: section 1 has an alignment field that names no alignment
  | Error OB0001: 'data past end' is damaged: section 1 says its data runs past its end
  | Error OB0001: 'relocs past end' is damaged: section 1 says its relocations run past its end
  | Error OB0001: 'count of 0' is damaged: section 1 keeps its relocation count in its first relocation, and that count is 0
  | Error OB0001: 'reloc to nowhere' is damaged: section 1 has a relocation to symbol 5, past its symbol table
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe coff_object;

@addmodulepath "$P:../src";

import System.SysUtils, System.Windows, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics,
  Adam.Coff.Archive, Adam.Coff.Reader;

// AValue as 0x and AWidth hex digits at least
routine Hex(const AValue: int64; const AWidth: int32): string;
begin
  return "0x" + IntToHex(uint64(AValue), AWidth);
end;

// The section line of AObject's section AIndex (0-based)
routine SectionLine(const AObject: CoffObjectData; const AIndex: int64): string;
var
  LSection: CoffSection;
  LLine: string;
begin
  LSection := AObject.Sections[AIndex];
  LLine := "section " + IntToStr(AIndex + 1) + " " + LSection.SectionName + " flags " +
    Hex(LSection.Characteristics, 8) + " align " + IntToStr(LSection.Align) + " size " +
    IntToStr(LSection.DataSize) + " relocs " + IntToStr(LSection.RelocCount);
  if LSection.Selection <> 0 then
    LLine := LLine + " comdat " + IntToStr(LSection.Selection) + " number " +
      IntToStr(LSection.Associated);
  end;
  return LLine;
end;

// The relocation lines of AObject's section AIndex (0-based)
routine PrintRelocs(const AObject: CoffObjectData; const AIndex: int64);
var
  LSection: CoffSection;
  LReloc: CoffReloc;
  LR: int64;
begin
  LSection := AObject.Sections[AIndex];
  for LR := LSection.RelocFirst to LSection.RelocFirst + LSection.RelocCount - 1 do
    LReloc := AObject.Relocs[LR];
    println("{}", "reloc " + IntToStr(AIndex + 1) + " " + Hex(LReloc.Offset, 1) + " type " +
      IntToStr(LReloc.RelocType) + " -> " + IntToStr(LReloc.SymbolIndex) + " " +
      AObject.Symbols[LReloc.SymbolIndex].SymbolName);
  end;
end;

// The symbol line of AObject's symbol record AIndex
routine SymbolLine(const AObject: CoffObjectData; const AIndex: int64): string;
var
  LSymbol: CoffSymbol;
begin
  LSymbol := AObject.Symbols[AIndex];
  return "symbol " + IntToStr(AIndex) + " " + LSymbol.SymbolName + " value " +
    IntToStr(LSymbol.SymbolValue) + " section " + IntToStr(LSymbol.SectionNumber) + " type " +
    IntToStr(LSymbol.SymbolType) + " class " + IntToStr(LSymbol.StorageClass) + " aux " +
    IntToStr(LSymbol.AuxCount);
end;

// The ASize bytes at AStart of ABytes read as the object ALabel: its dump, or its report
routine DumpObject(const ABytes: ByteArray; const AStart: int64; const ASize: int64;
  const ALabel: string);
var
  LReports: ref Diagnostics;
  LObject: CoffObjectData;
  LI: int64;
begin
  LReports := ref Diagnostics(100);
  if not ReadCoffObject(ABytes, AStart, ASize, ALabel, NoPlace(), LReports, LObject) then
    LReports.PrintAll();
    return;
  end;
  println("{}", "object " + ALabel + ": machine " + Hex(LObject.Machine, 4) + ", " +
    IntToStr(len(LObject.Sections)) + " sections, " + IntToStr(len(LObject.Symbols)) +
    " symbol records");
  for LI := 0 to len(LObject.Sections) - 1 do
    println("{}", SectionLine(LObject, LI));
  end;
  for LI := 0 to len(LObject.Sections) - 1 do
    PrintRelocs(LObject, LI);
  end;
  for LI := 0 to len(LObject.Symbols) - 1 do
    if not LObject.Symbols[LI].IsAux then
      println("{}", SymbolLine(LObject, LI));
    end;
  end;
end;

// Every COFF object member of the archive APath (an argument: a fixture's full path)
routine DumpArchive(const APath: string);
var
  LBytes: ByteArray;
  LReports: ref Diagnostics;
  LArchive: ArchiveData;
  LMember: ArchiveMember;
  LI: int64;
begin
  if not ReadAllBytes(APath, LBytes) then
    println("{}", ExtractFileName(APath) + " cannot be read");
    return;
  end;
  LReports := ref Diagnostics(100);
  if not ReadArchive(LBytes, ExtractFileName(APath), NoPlace(), LReports, LArchive) then
    LReports.PrintAll();
    return;
  end;
  for LI := 0 to len(LArchive.Members) - 1 do
    LMember := LArchive.Members[LI];
    if LMember.Kind = MemberKind.CoffObject then
      DumpObject(LBytes, LMember.DataAt, LMember.Size, LMember.MemberName);
    end;
  end;
end;

// AValue's low ACount bytes appended to ABytes, little-endian
routine Le(var ABytes: ByteArray; const AValue: int64; const ACount: int64);
var
  LAt: int64;
begin
  LAt := len(ABytes);
  setlength(ABytes, LAt + ACount);
  PutLe(ABytes, LAt, uint64(AValue), ACount);
end;

// ACount zero bytes appended to ABytes
routine Zeros(var ABytes: ByteArray; const ACount: int64);
var
  LI: int64;
begin
  for LI := 1 to ACount do
    Le(ABytes, 0, 1);
  end;
end;

// An 8-byte name field holding AText (8 bytes at most), zero-padded
routine NameField(var ABytes: ByteArray; const AText: string);
var
  LI: int64;
begin
  for LI := 0 to len(AText) - 1 do
    Le(ABytes, int64(uint8(AText[LI])), 1);
  end;
  Zeros(ABytes, 8 - len(AText));
end;

// A file header: x64, ASections sections, the symbol table at ASymbolsAt with ACount records
routine FileHeader(var ABytes: ByteArray; const ASections: int64; const ASymbolsAt: int64;
  const ACount: int64);
begin
  Le(ABytes, 0x8664, 2);
  Le(ABytes, ASections, 2);
  Le(ABytes, 0, 4);
  Le(ABytes, ASymbolsAt, 4);
  Le(ABytes, ACount, 4);
  Le(ABytes, 0, 2);
  Le(ABytes, 0, 2);
end;

// A section header: AName, ARawSize bytes of raw data at ARawAt, ARelocCount relocations at
// ARelocsAt, the flags AFlags
routine SectionHeader(var ABytes: ByteArray; const AName: string; const ARawSize: int64;
  const ARawAt: int64; const ARelocsAt: int64; const ARelocCount: int64; const AFlags: int64);
begin
  NameField(ABytes, AName);
  Le(ABytes, 0, 4);
  Le(ABytes, 0, 4);
  Le(ABytes, ARawSize, 4);
  Le(ABytes, ARawAt, 4);
  Le(ABytes, ARelocsAt, 4);
  Le(ABytes, 0, 4);
  Le(ABytes, ARelocCount, 2);
  Le(ABytes, 0, 2);
  Le(ABytes, AFlags, 4);
end;

// A symbol record: a short name AName (or, when empty, the string table offset ALongAt), in
// section 1, STATIC, with AAux aux records
routine SymbolRecord(var ABytes: ByteArray; const AName: string; const ALongAt: int64;
  const AAux: int64);
begin
  if AName = "" then
    Le(ABytes, 0, 4);
    Le(ABytes, ALongAt, 4);
  else
    NameField(ABytes, AName);
  end;
  Le(ABytes, 0, 4);
  Le(ABytes, 1, 2);
  Le(ABytes, 0, 2);
  Le(ABytes, 3, 1);
  Le(ABytes, AAux, 1);
end;

// A relocation record: at AOffset, to symbol ASymbol, of type AType
routine RelocRecord(var ABytes: ByteArray; const AOffset: int64; const ASymbol: int64;
  const AType: int64);
begin
  Le(ABytes, AOffset, 4);
  Le(ABytes, ASymbol, 4);
  Le(ABytes, AType, 2);
end;

// One damaged object: ABytes read whole under ALabel (its report)
routine Damaged(const ALabel: string; const ABytes: ByteArray);
begin
  DumpObject(ABytes, 0, len(ABytes), ALabel);
end;

// Every damaged form the reader reports, one object each (section headers at 20, their data
// and relocations at 60)
routine DumpDamaged();
var
  LBytes: ByteArray;
  LNone: ByteArray;
begin
  LBytes := LNone;
  Zeros(LBytes, 10);
  Damaged("cut header", LBytes);
  LBytes := LNone;
  FileHeader(LBytes, 1, 0, 0);
  Damaged("cut sections", LBytes);
  LBytes := LNone;
  FileHeader(LBytes, 0, 20, 5);
  Damaged("cut symbols", LBytes);
  LBytes := LNone;
  FileHeader(LBytes, 0, 20, 1);
  SymbolRecord(LBytes, "a", 0, 0);
  Damaged("cut strings", LBytes);
  LBytes := LNone;
  FileHeader(LBytes, 0, 20, 1);
  SymbolRecord(LBytes, "", 100, 0);
  Le(LBytes, 4, 4);
  Damaged("bad symbol name", LBytes);
  LBytes := LNone;
  FileHeader(LBytes, 0, 20, 1);
  SymbolRecord(LBytes, "a", 0, 1);
  Le(LBytes, 4, 4);
  Damaged("aux past", LBytes);
  LBytes := LNone;
  FileHeader(LBytes, 1, 0, 0);
  SectionHeader(LBytes, "/99", 0, 0, 0, 0, 0x40000040);
  Damaged("bad section name", LBytes);
  LBytes := LNone;
  FileHeader(LBytes, 1, 0, 0);
  SectionHeader(LBytes, ".x", 0, 0, 0, 0, 0x40F00040);
  Damaged("bad align", LBytes);
  LBytes := LNone;
  FileHeader(LBytes, 1, 0, 0);
  SectionHeader(LBytes, ".x", 100, 60, 0, 0, 0x40000040);
  Damaged("data past end", LBytes);
  LBytes := LNone;
  FileHeader(LBytes, 1, 0, 0);
  SectionHeader(LBytes, ".x", 0, 0, 60, 2, 0x40000040);
  Damaged("relocs past end", LBytes);
  // IMAGE_SCN_LNK_NRELOC_OVFL, 0xFFFF in the count, the first record's count 0
  LBytes := LNone;
  FileHeader(LBytes, 1, 0, 0);
  SectionHeader(LBytes, ".x", 0, 0, 60, 0xFFFF, 0x41000040);
  RelocRecord(LBytes, 0, 0, 0);
  Damaged("count of 0", LBytes);
  LBytes := LNone;
  FileHeader(LBytes, 1, 0, 0);
  SectionHeader(LBytes, ".x", 0, 0, 60, 1, 0x40000040);
  RelocRecord(LBytes, 0, 5, 4);
  Damaged("reloc to nowhere", LBytes);
end;

begin
  DumpArchive(paramstr(1));
  DumpDamaged();
end.
