-------------------------------------------------------------------------------
  coff_archive.adam - Adam.COFF.Archive (imported from the compiler's own
  src\, beside bin\) reads the prebuilt fixtures in fixtures\ (a static lib
  of two clang objects and an import lib; release artifacts, their .c / .def
  beside them) and every damaged form it reports. The member and symbol
  lines are the archives' bytes as an ar dump reads them: offsets, sizes,
  names, the short imports' fields. A byte outside 32..126 in a name prints
  as \xHH.
*******************************************************************************/

/*
@@test
  kind run
  args "<DIR>/fixtures/libcoffa.a" "<DIR>/fixtures/libcoffi.dll.a"
  exitcode 0
  | libcoffa.a: 5 members, 3 symbols
  | member / SymbolIndex at 8 size 50
  | member / SymbolIndex at 118 size 56
  | member // NameTable at 234 size 30
  | member coffa_one.o COFFObject at 324 size 855
  | member coffa_two_with_a_long_name.o COFFObject at 1240 size 925
  | symbol coffa_add -> 324
  | symbol coffa_twice -> 1240
  | symbol coffa_value -> 1240
  | libcoffi.dll.a: 8 members, 8 symbols
  | member / SymbolIndex at 8 size 198
  | member / SymbolIndex at 266 size 210
  | member coffi.dll COFFObject at 536 size 364
  | member coffi.dll COFFObject at 960 size 127
  | member coffi.dll COFFObject at 1148 size 161
  | member coffi.dll ShortImport at 1370 size 42: coffi_hello from coffi.dll, Code, Name, hint 0, machine 34404, by name 'coffi_hello'
  | member coffi.dll ShortImport at 1472 size 42: coffi_count from coffi.dll, Data, Name, hint 0, machine 34404, by name 'coffi_count'
  | member coffi.dll ShortImport at 1574 size 47: coffi_by_ordinal from coffi.dll, Code, Ordinal, hint 7, machine 34404, by name ''
  | symbol __IMPORT_DESCRIPTOR_coffi -> 536
  | symbol __NULL_IMPORT_DESCRIPTOR -> 960
  | symbol \x7fcoffi_NULL_THUNK_DATA -> 1148
  | symbol __imp_coffi_hello -> 1370
  | symbol coffi_hello -> 1370
  | symbol __imp_coffi_count -> 1472
  | symbol __imp_coffi_by_ordinal -> 1574
  | symbol coffi_by_ordinal -> 1574
  | Error AR0001: 'no signature' is not an archive: it does not start with !<arch>
  | Error AR0002: 'cut header' is damaged: the member header at offset 8 runs past the file's end
  | Error AR0002: 'bad size' is damaged: the member header at offset 8 has no size a decimal number gives
  | Error AR0002: 'bad end' is damaged: the member header at offset 8 does not end with its two marker bytes (0x60 0x0A)
  | Error AR0002: 'data past end' is damaged: the member header at offset 8 says its data runs past the file's end
  | Error AR0003: 'no long-name table' is damaged: the member at offset 8 names '/0' in the long-name table, which the archive does not have
  | Error AR0005: 'cut import' is damaged: the short import member at offset 8 does not hold the two names its size says
  | Error AR0004: 'index to nowhere' is damaged: its symbol index points at offset 999, where no member starts
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe coff_archive;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics,
  Adam.COFF.Archive;

// AKind as the dump prints it
func KindText(const AKind: MemberKind): string;
begin
  match AKind of
    MemberKind.SymbolIndex: return "SymbolIndex";
    MemberKind.NameTable: return "NameTable";
    MemberKind.COFFObject: return "COFFObject";
    MemberKind.ShortImport: return "ShortImport";
  end;
  return "";
end;

// AKind as the dump prints it
func ImportKindText(const AKind: ImportKind): string;
begin
  match AKind of
    ImportKind.Code: return "Code";
    ImportKind.Data: return "Data";
    ImportKind.Constant: return "Constant";
    ImportKind.Reserved: return "Reserved";
  end;
  return "";
end;

// ANaming as the dump prints it
func NamingText(const ANaming: ImportNaming): string;
begin
  match ANaming of
    ImportNaming.Ordinal: return "Ordinal";
    ImportNaming.Name: return "Name";
    ImportNaming.NoPrefix: return "NoPrefix";
    ImportNaming.Undecorate: return "Undecorate";
    ImportNaming.ExportAs: return "ExportAs";
    ImportNaming.Reserved: return "Reserved";
  end;
  return "";
end;

// AText with every byte outside 32..126 as \xHH
func Shown(const AText: string): string;
var
  LDigits: string;
  LText: string;
  LI: int64;
  LByte: int64;
begin
  LDigits := "0123456789abcdef";
  LText := "";
  for LI := 0 to len(AText) - 1 do
    LByte := int64(uint8(AText[LI]));
    if (LByte < 32) or (LByte > 126) then
      LText := LText + "\\x" + LDigits[LByte div 16] + LDigits[LByte mod 16];
    else
      LText := LText + AText[LI];
    end;
  end;
  return LText;
end;

// One member's dump line
func MemberLine(const AMember: ArchiveMember): string;
var
  LLine: string;
begin
  LLine := "member " + Shown(AMember.MemberName) + " " + KindText(AMember.Kind) + " at " +
    IntToStr(AMember.HeaderAt) + " size " + IntToStr(AMember.Size);
  if AMember.Kind = MemberKind.ShortImport then
    LLine := LLine + ": " + Shown(AMember.ImportSymbol) + " from " + Shown(AMember.ImportDLL) +
      ", " + ImportKindText(AMember.Imported) + ", " + NamingText(AMember.Naming) + ", hint " +
      IntToStr(AMember.OrdinalHint) + ", machine " + IntToStr(AMember.ImportMachine) +
      ", by name '" + ImportNameOf(AMember) + "'";
  end;
  return LLine;
end;

// Reads ABytes as the archive ALabel: its dump, or the reports it gives
func Dump(const ALabel: string; const ABytes: ByteArray);
var
  LReports: ref Diagnostics;
  LArchive: ArchiveData;
  LI: int64;
begin
  LReports := ref Diagnostics(100);
  if not ReadArchive(ABytes, ALabel, NoPlace(), LReports, LArchive) then
    LReports.PrintAll();
    return;
  end;
  println("{}", ALabel + ": " + IntToStr(len(LArchive.Members)) + " members, " +
    IntToStr(len(LArchive.Symbols)) + " symbols");
  for LI := 0 to len(LArchive.Members) - 1 do
    println("{}", MemberLine(LArchive.Members[LI]));
  end;
  for LI := 0 to len(LArchive.Symbols) - 1 do
    println("{}", "symbol " + Shown(LArchive.Symbols[LI].SymbolName) + " -> " +
      IntToStr(LArchive.Members[LArchive.Symbols[LI].Member].HeaderAt));
  end;
end;

// The file APath (an argument: a fixture's full path) read and dumped under its file name
func DumpFile(const APath: string);
var
  LBytes: ByteArray;
begin
  if not ReadAllBytes(APath, LBytes) then
    println("{}", ExtractFileName(APath) + " cannot be read");
    return;
  end;
  Dump(ExtractFileName(APath), LBytes);
end;

// AText's bytes
func BytesOf(const AText: string): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(AText));
  for LI := 0 to len(AText) - 1 do
    LBytes[LI] := uint8(AText[LI]);
  end;
  return LBytes;
end;

// ABytes with the byte AByte added at its end (bytes no UTF-8 string literal holds)
func Plus(const ABytes: ByteArray; const AByte: int64): ByteArray;
var
  LBytes: ByteArray;
begin
  LBytes := ABytes;
  setlength(LBytes, len(LBytes) + 1);
  LBytes[len(LBytes) - 1] := uint8(AByte);
  return LBytes;
end;

// AText padded with blanks to AWidth
func Padded(const AText: string; const AWidth: int64): string;
begin
  return AText + StringOfChar(' ', AWidth - len(AText));
end;

// A member header: the name field ANameField, the size field ASizeField, the end AEnd
func Header(const ANameField: string; const ASizeField: string; const AEnd: string): string;
begin
  return Padded(ANameField, 16) + StringOfChar(' ', 32) + Padded(ASizeField, 10) + AEnd;
end;

// Every damaged form the reader reports, one archive each
func DumpDamaged();
var
  LSig: string;
  LEnd: string;
  LBytes: ByteArray;
begin
  LSig := "!<arch>\n";
  LEnd := "`\n";
  Dump("no signature", BytesOf("hello"));
  Dump("cut header", BytesOf(LSig + "short"));
  Dump("bad size", BytesOf(LSig + Header("a/", "abc", LEnd)));
  Dump("bad end", BytesOf(LSig + Header("a/", "0", "xx")));
  Dump("data past end", BytesOf(LSig + Header("a/", "100", LEnd)));
  Dump("no long-name table", BytesOf(LSig + Header("/0", "0", LEnd)));
  // A short import's 00 00 FF FF and nothing after it
  LBytes := Plus(Plus(Plus(Plus(BytesOf(LSig + Header("a/", "4", LEnd)), 0), 0), 0xFF), 0xFF);
  Dump("cut import", LBytes);
  // A symbol index of one symbol 's' at offset 999 (big endian: 00 00 00 01, 00 00 03 E7)
  LBytes := BytesOf(LSig + Header("/", "10", LEnd));
  LBytes := Plus(Plus(Plus(Plus(LBytes, 0), 0), 0), 1);
  LBytes := Plus(Plus(Plus(Plus(LBytes, 0), 0), 0x03), 0xE7);
  LBytes := Plus(Plus(LBytes, 0x73), 0);
  Dump("index to nowhere", LBytes);
end;

begin
  DumpFile(paramstr(1));
  DumpFile(paramstr(2));
  DumpDamaged();
end.
