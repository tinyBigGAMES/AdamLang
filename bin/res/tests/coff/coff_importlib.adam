-------------------------------------------------------------------------------
  coff_importlib.adam - two `external` routines whose library is the import
  lib fixtures\libk32sub.dll.a (kernel32's GetCurrentProcessId and
  GetTickCount64; a prebuilt release artifact, k32sub.def beside it), found
  by BNF sec 2's search before any DLL; the exe imports them from the DLL
  the import lib names (kernel32.dll) and runs.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ticks counted
  | process id read
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe coff_importlib;

@addlibrarypath "$P:res/tests/coff/fixtures";

func clink GetCurrentProcessId(): uint32; external "k32sub";
func clink GetTickCount64(): uint64; external "k32sub";

begin
  if GetTickCount64() > 0 then
    println("{}", "ticks counted");
  end;
  if GetCurrentProcessId() > 0 then
    println("{}", "process id read");
  end;
end.
