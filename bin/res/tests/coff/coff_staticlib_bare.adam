/*
@@test
  kind run
  exitcode 0
  | coffa_add 7
@@end
*/

module exe coff_staticlib_bare;

@addlibrarypath "$P:res/tests/coff/fixtures";
@linklibrary "coffa";

func clink coffa_add(AA: int32; AB: int32): int32; external;

begin
  SetHeapReport(false);
  println("coffa_add {}", coffa_add(3, 4));
end.
