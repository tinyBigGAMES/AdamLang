-------------------------------------------------------------------------------
  coff_staticlib_err_missing.adam - an `external` routine the static lib
  fixtures\libcoffl.a does not define: no object of it is linked for it, so
  it stays undefined, LK0001 at its declaration; the build fails.
*******************************************************************************/

/*
@@test
  kind cli
  targets x86_64-windows-gnu
  args "build" "--quiet" "<DIR>/coff_staticlib_err_missing.adam" "-o" "."
  exitcode 1
  | <DIR>/coff_staticlib_err_missing.adam(35,1): Error LK0001: 'coffl_nothing' is used, but nothing in the program defines it
@@end
*/

module exe coff_staticlib_err_missing;

@addlibrarypath "$P:res/tests/coff/fixtures";

func clink coffl_nothing(): int32; external "coffl";

begin
  if coffl_nothing() > 0 then
    println("{}", "never");
  end;
end.
