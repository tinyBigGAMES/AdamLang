-------------------------------------------------------------------------------
  coff_extras_err_missing.adam - coffx_orphan pulls coffx_orphan.c's object
  in, which needs coffx_nowhere (called) and __imp_coffx_nowhere_imp (its
  import slot read): no static library or C runtime archive defines them
  and ucrtbase exports neither name, so both stay undefined, LK0001 at the
  declaration that pulled the object in; the build fails.
*******************************************************************************/

/*
@@test
  kind cli
  targets x86_64-windows-gnu
  args "build" "--quiet" "<DIR>/coff_extras_err_missing.adam" "-o" "."
  exitcode 1
  | <DIR>/coff_extras_err_missing.adam(38,1): Error LK0001: 'coffx_nowhere' is used, but nothing in the program defines it
  | <DIR>/coff_extras_err_missing.adam(38,1): Error LK0001: '__imp_coffx_nowhere_imp' is used, but nothing in the program defines it
@@end
*/

module exe coff_extras_err_missing;

@addlibrarypath "$P:res/tests/coff/fixtures";

func clink coffx_orphan(AA: int32): int32; external "coffx";

begin
  if coffx_orphan(1) > 0 then
    println("{}", "never");
  end;
end.
