-------------------------------------------------------------------------------
  coff_minizip_io.adam - a program over libminizip.a and libzlib.a
  (res/libs/vendor), both of minizip's file layers: a zip written through
  zipOpen64's default ioapi (fopen64 / fseeko64 / ftello64, MinGW's old
  names: libcextras' aliases of ucrtbase's fopen / _fseeki64 / _ftelli64,
  reached by __imp_), read back through iowin32's functions
  (fill_win32_filefunc64A: CreateFileA, ReadFile, SetFilePointer, ..
  imported from kernel32, the C runtime's second DLL). One entry deflated
  in, listed, read and its bytes checked by zlib's crc32.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | zip open true
  | new entry 0
  | write 0
  | close entry 0
  | zip close 0
  | unz open true
  | first 0
  | name coff_minizip_io.txt
  | open entry 0
  | read 17
  | text adam over minizip
  | crc 3877037506
  | close entry 0
  | unz close 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe coff_minizip_io;

import System.SysUtils;

// minizip's zip.h / unzip.h / iowin32.h and zlib's crc32, declared here until H1's
// System.Minizip.C and System.Zlib.C
func clink zipOpen64(APath: ptr to const char; AAppend: int32): ptr; external "minizip";
func clink zipOpenNewFileInZip64(AFile: ptr; AName: ptr to const char; AInfo: ptr;
  AExtraLocal: ptr; ALocalSize: uint32; AExtraGlobal: ptr; AGlobalSize: uint32;
  AComment: ptr to const char; AMethod: int32; ALevel: int32; AZip64: int32): int32;
  external "minizip";
func clink zipWriteInFileInZip(AFile: ptr; ABuffer: ptr to const char; ALength: uint32): int32;
  external "minizip";
func clink zipCloseFileInZip(AFile: ptr): int32; external "minizip";
func clink zipClose(AFile: ptr; AComment: ptr to const char): int32; external "minizip";
func clink fill_win32_filefunc64A(AFuncs: ptr); external "minizip";
func clink unzOpen2_64(APath: ptr to const char; AFuncs: ptr): ptr; external "minizip";
func clink unzGoToFirstFile(AFile: ptr): int32; external "minizip";
func clink unzGetCurrentFileInfo64(AFile: ptr; AInfo: ptr; AName: ptr to char;
  ANameSize: uint32; AExtra: ptr; AExtraSize: uint32; AComment: ptr to char;
  ACommentSize: uint32): int32; external "minizip";
func clink unzOpenCurrentFile(AFile: ptr): int32; external "minizip";
func clink unzReadCurrentFile(AFile: ptr; ABuffer: ptr; ALength: uint32): int32;
  external "minizip";
func clink unzCloseCurrentFile(AFile: ptr): int32; external "minizip";
func clink unzClose(AFile: ptr): int32; external "minizip";
func clink crc32(ACrc: uint32; ABuffer: ptr; ALength: uint32): uint32; external "zlib";

// ALabel and AValue on one line
func Show(const ALabel: string; const AValue: int64);
begin
  println("{}", ALabel + " " + IntToStr(AValue));
end;

// ALabel and AText on one line
func ShowText(const ALabel: string; const AText: string);
begin
  println("{}", ALabel + " " + AText);
end;

// ALabel and true / false on one line
func ShowBool(const ALabel: string; const AValue: bool);
begin
  if AValue then
    ShowText(ALabel, "true");
  else
    ShowText(ALabel, "false");
  end;
end;

// The NUL-terminated text at AText as a string
func CText(const AText: ptr to const char): string;
var
  LText: string;
  LAt: int64;
begin
  LText := "";
  LAt := 0;
  while int32(AText[LAt]) <> 0 do
    LText := LText + AText[LAt];
    LAt := LAt + 1;
  end;
  return LText;
end;

const
  // Z_DEFLATED and Z_DEFAULT_COMPRESSION (zlib.h)
  ZIP_DEFLATED: int32 = 8;
  ZIP_DEFAULT_LEVEL: int32 = -1;

var
  GZip: ptr;
  GUnzip: ptr;
  GRead: int32;
  // zlib_filefunc64_def (ioapi.h): seven routine pointers and the opaque
  GFuncs: array[0..7] of ptr;
  // unz_file_info64 (unzip.h), room to spare
  GInfo: array[0..31] of int64;
  GName: array[0..63] of char;
  GBuffer: array[0..63] of char;

begin
  GZip := zipOpen64(ptr to const char("coff_minizip_io.zip"), 0);
  ShowBool("zip open", GZip <> nil);
  Show("new entry", int64(zipOpenNewFileInZip64(GZip, ptr to const char("coff_minizip_io.txt"),
    nil, nil, 0, nil, 0, nil, ZIP_DEFLATED, ZIP_DEFAULT_LEVEL, 0)));
  Show("write", int64(zipWriteInFileInZip(GZip, ptr to const char("adam over minizip"), 17)));
  Show("close entry", int64(zipCloseFileInZip(GZip)));
  Show("zip close", int64(zipClose(GZip, nil)));

  fill_win32_filefunc64A(addr of GFuncs[0]);
  GUnzip := unzOpen2_64(ptr to const char("coff_minizip_io.zip"), addr of GFuncs[0]);
  ShowBool("unz open", GUnzip <> nil);
  Show("first", int64(unzGoToFirstFile(GUnzip)));
  unzGetCurrentFileInfo64(GUnzip, addr of GInfo[0], addr of GName[0], 63, nil, 0, nil, 0);
  ShowText("name", CText(addr of GName[0]));
  Show("open entry", int64(unzOpenCurrentFile(GUnzip)));
  GRead := unzReadCurrentFile(GUnzip, addr of GBuffer[0], 63);
  Show("read", int64(GRead));
  ShowText("text", CText(addr of GBuffer[0]));
  Show("crc", int64(crc32(0, addr of GBuffer[0], uint32(GRead))));
  Show("close entry", int64(unzCloseCurrentFile(GUnzip)));
  Show("unz close", int64(unzClose(GUnzip)));
end.
