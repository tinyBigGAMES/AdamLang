-------------------------------------------------------------------------------
  coff_zlib_gz.adam - a program over libzlib.a (res/libs/vendor): zlib's gz
  file path, whose objects call MinGW's old names open / write / read /
  close (moldname's aliases of ucrtbase's _open ..). Adam links no import
  library: the names come from libcextras' alias members (a weak X jumping
  through __imp_<ucrtbase name>, __imp_X a pointer to X). A line written
  through gzopen "wb" / gzputs / gzclose, read back through gzopen "rb" /
  gzread / gzclose.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | open write true
  | puts 14
  | close write 0
  | open read true
  | read 14
  | text adam over zlib
  | close read 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe coff_zlib_gz;

import System.SysUtils;

// zlib's gz routines (zlib.h), declared here until H1's System.Zlib.C
func clink gzopen(APath: ptr to const char; AMode: ptr to const char): ptr;
  external "zlib";
func clink gzputs(AFile: ptr; AText: ptr to const char): int32; external "zlib";
func clink gzread(AFile: ptr; ABuffer: ptr; ALength: uint32): int32; external "zlib";
func clink gzclose(AFile: ptr): int32; external "zlib";

// ALabel and AValue on one line
func Show(const ALabel: string; const AValue: int64);
begin
  println("{}", ALabel + " " + IntToStr(AValue));
end;

// ALabel and AText on one line
func ShowText(const ALabel: string; const AText: string);
begin
  println("{}", ALabel + " " + AText);
end;

// ALabel and true / false on one line
func ShowBool(const ALabel: string; const AValue: bool);
begin
  if AValue then
    ShowText(ALabel, "true");
  else
    ShowText(ALabel, "false");
  end;
end;

// The NUL-terminated text at AText as a string
func CText(const AText: ptr to const char): string;
var
  LText: string;
  LAt: int64;
begin
  LText := "";
  LAt := 0;
  while int32(AText[LAt]) <> 0 do
    LText := LText + AText[LAt];
    LAt := LAt + 1;
  end;
  return LText;
end;

var
  GFile: ptr;
  GBuffer: array[0..63] of char;

begin
  GFile := gzopen(ptr to const char("coff_zlib_gz.gz"), ptr to const char("wb"));
  ShowBool("open write", GFile <> nil);
  Show("puts", int64(gzputs(GFile, ptr to const char("adam over zlib"))));
  Show("close write", int64(gzclose(GFile)));

  GFile := gzopen(ptr to const char("coff_zlib_gz.gz"), ptr to const char("rb"));
  ShowBool("open read", GFile <> nil);
  Show("read", int64(gzread(GFile, addr of GBuffer[0], 63)));
  ShowText("text", CText(addr of GBuffer[0]));
  Show("close read", int64(gzclose(GFile)));
end.
