-------------------------------------------------------------------------------
  thread_cthread_plain.adam - Threads: a plain routine (no clink, no
  CCallback) given to the OS's own thread call (pthread_create /
  CreateThread) as a value enters the thread C made as an Adam callback
  does (PLAN-LINUX64 LX4c3, BNF sec 6's CB1 note): a raise nothing inside
  catches is reported by the thread's last catching scope, the routine's
  outer entry (`unhandled exception 1: <text>` on stderr), and the process
  ends with exit code 1 while main waits in the join (its next line never
  prints); main holds nothing, so nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 1
  | start
  | unhandled exception 1: from the c thread
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_cthread_plain;

@ifdef TARGET_X86_64_LINUX_GNU
import System.Linux;
@else
import System.Windows;
@endif

@ifdef TARGET_X86_64_LINUX_GNU
// pthread_create's start routine, a plain routine: a raise nothing in it catches
func ThreadBody(AArgument: ptr): ptr;
begin
  raise("from the c thread");
end;
@else
// CreateThread's start routine, a plain routine: a raise nothing in it catches
func ThreadBody(AParameter: ptr): uint32;
begin
  raise("from the c thread");
end;
@endif

// One thread started by the OS's own call, then waited for
func RunCThread();
var
@ifdef TARGET_X86_64_LINUX_GNU
  LThread: uint64;
@else
  LHandle: uint64;
@endif
begin
@ifdef TARGET_X86_64_LINUX_GNU
  LThread := 0;
  if pthread_create(LThread, nil, ThreadBody, nil) <> 0 then
    println("no thread");
    return;
  end;
  pthread_join(LThread, nil);
@else
  LHandle := CreateThread(nil, 0, ThreadBody, nil, 0, nil);
  if LHandle = 0 then
    println("no thread");
    return;
  end;
  WaitForSingleObject(LHandle, INFINITE);
  CloseHandle(LHandle);
@endif
  println("never");
end;

begin
  println("start");
  RunCThread();
end.
