-------------------------------------------------------------------------------
  thread_cthread_variadic.adam - Threads: a clink variadic routine given as
  a value enters the thread C made too (PLAN-LINUX64 LX4c4): its value's
  entry is variadic itself and passes the C va_list of its own variadic
  arguments on to the routine's core (its body over its fixed parameters
  and that list), so CallbackEnter runs first and a C-made thread gets the
  outer entry's last catching scope. Sum called directly (its forwarder to
  its core), then through a variadic routine value (the entry, an Adam
  thread: the core with the list passed on), each reading its arguments;
  then Worker started by the OS's own thread call (pthread_create /
  CreateThread, as a C library calls a variadic callback such as libxml2's
  xmlGenericErrorFunc on a thread of its own: the OS calls it with its one
  fixed argument, reached through an overlay of the two routine types): a
  raise nothing inside catches is reported by the outer entry (`unhandled
  exception 1: <text>` on stderr) and the process ends with exit code 1
  while main waits in the join (its next line never prints); main holds
  nothing, so nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 1
  | direct 42
  | value 6
  | start
  | unhandled exception 1: from the variadic c thread 7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_cthread_variadic;

@ifdef TARGET_X86_64_LINUX_GNU
import System.SysUtils, System.Linux;
@else
import System.SysUtils, System.Windows.SDK, System.Windows;
@endif

type
  // Sum as a value: a variadic routine type
  SumFunc = func(const ACount: int32; ...): int64;

@ifdef TARGET_X86_64_LINUX_GNU
  // Worker as a value, and as pthread_create's start routine (the OS passes its one
  // argument and no variadic ones)
  WorkerFunc = func(const AArgument: ptr; ...): ptr;
  WorkerCast = overlay
    Variadic: WorkerFunc;
    Start: func(AArgument: ptr): ptr;
  end;
@else
  // Worker as a value, and as CreateThread's start routine (the OS passes its one
  // argument and no variadic ones)
  WorkerFunc = func(const AParameter: ptr; ...): uint32;
  WorkerCast = overlay
    Variadic: WorkerFunc;
    Start: func(AParameter: ptr): uint32;
  end;
@endif

var
  // The number the thread's raise names
  GSeven: int64;

// The ACount int32s after ACount, summed
func Sum(const ACount: int32; ...): int64;
var
  LSum: int64;
  LI: int32;
begin
  LSum := 0;
  for LI := 1 to ACount do
    LSum := LSum + int64(varargs.next(int32));
  end;
  return LSum;
end;

@ifdef TARGET_X86_64_LINUX_GNU
// The thread's start routine, a clink variadic: a raise nothing in it catches
func Worker(const AArgument: ptr; ...): ptr;
begin
  raise("from the variadic c thread " + IntToStr((ptr to int64(AArgument))^));
end;
@else
// The thread's start routine, a clink variadic: a raise nothing in it catches
func Worker(const AParameter: ptr; ...): uint32;
begin
  raise("from the variadic c thread " + IntToStr((ptr to int64(AParameter))^));
end;
@endif

// Worker started by the OS's own call, then waited for
func RunCThread();
var
  LCast: WorkerCast;
@ifdef TARGET_X86_64_LINUX_GNU
  LThread: uint64;
@else
  LHandle: uint64;
@endif
begin
  LCast.Variadic := Worker;
@ifdef TARGET_X86_64_LINUX_GNU
  LThread := 0;
  if pthread_create(LThread, nil, LCast.Start, addr of GSeven) <> 0 then
    println("no thread");
    return;
  end;
  pthread_join(LThread, nil);
@else
  LHandle := CreateThread(nil, 0, LCast.Start, addr of GSeven, 0, nil);
  if LHandle = 0 then
    println("no thread");
    return;
  end;
  WaitForSingleObject(LHandle, INFINITE);
  CloseHandle(LHandle);
@endif
  println("never");
end;

var
  GSum: SumFunc;

begin
  GSeven := 7;
  println("direct {}", Sum(2, 20, 22));
  GSum := Sum;
  println("value {}", GSum(3, 1, 2, 3));
  println("start");
  RunCThread();
end.
