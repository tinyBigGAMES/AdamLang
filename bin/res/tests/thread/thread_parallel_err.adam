-------------------------------------------------------------------------------
  thread_parallel_err.adam - Break step of thread_parallel (BNF sec 5 for
  parallel, sec 7 workerindex / workercount; PLAN-ADAM T2): a return in the
  body (SM0709); workerindex() / workercount() outside a body, a nested
  routine's body included (SM0710); a varargs read in the body (SM0711);
  the loop's own iterator read in its bound (SM0712); bounds of a type a
  for cannot step (SM0601); the iterator written in the body (SM0602).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe thread_parallel_err;

var
  GWorker: int64;

// A return cannot leave the body
routine Find(): int64;
begin
  for parallel I := 1 to 3 do
    if I = 2 then
      return 2; // ERROR SM0709@7: return cannot leave a for parallel's body (leave stops it)
    end;
  end;
  return 0;
end;

// The body's workers never see the routine's varargs
routine Sum(const ACount: int32; ...): int64;
var
  LSum: int64;
begin
  LSum := 0;
  for parallel I := 1 to ACount do
    atomicadd(LSum, int64(varargs.next(int32))); // ERROR SM0711@27: a for parallel's body cannot read its routine's varargs
  end;
  return LSum;
end;

// A routine called from a body is no body of its own
routine Worker(): int64;
begin
  return workercount(); // ERROR SM0710@10: workercount() is only known inside a for parallel's body
end;

begin
  GWorker := workerindex(); // ERROR SM0710@14: workerindex() is only known inside a for parallel's body
  for parallel I := 1 to I do // ERROR SM0712@26: 'I' is the for parallel's own iterator: its bounds and workers cannot read it
    GWorker := Worker();
  end;
  for parallel S := "a" to "b" do // ERROR SM0601@3: a for iterator is an integer, char, wchar or a choice, got 'string'
    GWorker := 0;
  end;
  for parallel I := 1 to 2 do
    I := 5; // ERROR SM0602@5: 'I' is the for iterator: the loop body cannot write it
  end;
end.
