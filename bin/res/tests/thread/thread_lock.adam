-------------------------------------------------------------------------------
  thread_lock.adam - mutex, lock and trylock (BNF sec 4 mutex, sec 5 lock /
  trylock; PLAN-ADAM H4t5): a mutex is 16 bytes; four tasks count 100000
  rounds each under a module mutex and under a record field's mutex, no
  update lost (a plain counter loses them: a devbox scratch); the thread
  holding a mutex takes it again, and a return out of both locks lets go of
  both; a leave out of a lock on an array element, and a raise out of one,
  let go too; a local mutex starts free. Whether a mutex is free is asked
  from another thread (a trylock there), since its holder would take it
  again. trylock against a thread holding the mutex: one try is not taken,
  a wait of 20 ms is not taken, a wait of 10 s is taken once the holder lets
  go.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | size 16
  | count 400000
  | safe 400000
  | twice 2 free
  | leaves 3 free
  | caught
  | raises free
  | local
  | busy
  | busy after 20 ms
  | taken once let go
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_lock;

import System.SysUtils;

const
  // Each counting task's rounds
  ROUNDS: int64 = 100000;

type
  // A counter and the mutex that guards it
  Guarded = record
    Lock: mutex;
    Count: int64;
  end;

var
  GLock: mutex;
  GCount: int64;
  GSafe: Guarded;
  GLocks: array[0..1] of mutex;
  GHeld: mutex;
  GReady: int32;
  GRelease: int32;

// ARounds increments of GCount under GLock and of GSafe.Count under its own mutex
routine Count(const ARounds: int64);
var
  LI: int64;
begin
  for LI := 1 to ARounds do
    lock (GLock) do
      GCount := GCount + 1;
    end;
    lock (GSafe.Lock) do
      GSafe.Count := GSafe.Count + 1;
    end;
  end;
end;

// GLock taken again by the thread holding it; the return lets go of it twice
routine Twice(): int64;
begin
  lock (GLock) do
    lock (GLock) do
      return 2;
    end;
  end;
end;

// A leave out of a lock inside a loop lets go of the mutex
routine Leaves(): int64;
var
  LN: int64;
begin
  LN := 0;
  while true do
    lock (GLocks[1]) do
      LN := LN + 1;
      if LN = 3 then
        leave;
      end;
    end;
  end;
  return LN;
end;

// A raise out of a lock's statements lets go of the mutex on its way out
routine Raises();
begin
  lock (GLocks[0]) do
    raise("inside");
  end;
end;

// A local mutex starts free
routine Local();
var
  LLock: mutex;
begin
  lock (LLock) do
    println("local");
  end;
end;

// True when the mutex AWhich names (0 GLock, 1 GLocks[0], 2 GLocks[1]) is free: a trylock
// on the calling thread takes it
routine Probe(const AWhich: int32): bool;
begin
  if AWhich = 0 then
    trylock (GLock) do
      return true;
    end;
    return false;
  end;
  if AWhich = 1 then
    trylock (GLocks[0]) do
      return true;
    end;
    return false;
  end;
  trylock (GLocks[1]) do
    return true;
  else
    return false;
  end;
end;

// "free" or "held": the mutex AWhich names (Probe) asked from another thread
routine FreeText(const AWhich: int32): string;
var
  LFree: task bool;
begin
  LFree := async Probe(AWhich);
  if await LFree then
    return "free";
  end;
  return "held";
end;

// Holds GHeld until main says to let go, telling main once it holds it
routine Holder();
begin
  lock (GHeld) do
    atomicstore(GReady, 1);
    while atomicload(GRelease) = 0 do
      // main's word not given yet
    end;
  end;
end;

var
  LT1: task;
  LT2: task;
  LT3: task;
  LT4: task;
  LHold: task;

begin
  println("{}", "size " + IntToStr(size(mutex)));
  LT1 := async Count(ROUNDS);
  LT2 := async Count(ROUNDS);
  LT3 := async Count(ROUNDS);
  LT4 := async Count(ROUNDS);
  await LT1;
  await LT2;
  await LT3;
  await LT4;
  println("{}", "count " + IntToStr(GCount));
  println("{}", "safe " + IntToStr(GSafe.Count));
  println("{}", "twice " + IntToStr(Twice()) + " " + FreeText(0));
  println("{}", "leaves " + IntToStr(Leaves()) + " " + FreeText(2));
  guard
    Raises();
  except
    println("caught");
  end;
  println("{}", "raises " + FreeText(1));
  Local();
  LHold := async Holder();
  while atomicload(GReady) = 0 do
    // the holder has not taken GHeld yet
  end;
  trylock (GHeld) do
    println("taken while held");
  else
    println("busy");
  end;
  trylock (GHeld) wait 20 do
    println("taken while held");
  else
    println("busy after 20 ms");
  end;
  atomicstore(GRelease, 1);
  trylock (GHeld) wait 10000 do
    println("taken once let go");
  end;
  await LHold;
end.
