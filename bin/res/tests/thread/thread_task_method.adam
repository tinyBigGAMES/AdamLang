-------------------------------------------------------------------------------
  thread_task_method.adam - Tasks of a method's call and of a variadic
  routine's call (BNF sec 6 async; PLAN-ADAM T1). A method runs on an object
  reached through a ref (the task holds it: the object outlives the ref's
  nil and ends with the task) or through a ptr (`P->M()`, `P^.M()`: the
  caller keeps it). Its dispatch is read at the async: a parent's ref
  holding a descendant runs the override, an interface's ref runs the
  object's method through its itable; a const method with a string argument
  and result; an inherited method of a plain parent part (the upcast past
  the vptr); an embed's method; a plain task of a method. A nil ref raises
  at the async, in the caller. A clink variadic's extra arguments (int32s,
  an 8-byte record) and a cpplink one's typed pack (strings, a record, an
  int32) are copied at the async at their own types (a later change does
  not reach the call), a variadic routine value's too. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | sum 5
  | done a
  | kind double
  | label b
  | tag 42
  | reading 6
  | done b
  | area 16
  | done square
  | ptr 11
  | deref 13
  | note 13
  | nil caught
  | clink 60
  | pair 8
  | join a-bc
  | mixed 7 100 5 s
  | value 9
  | done local
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_task_method;

import System.SysUtils;

type
  // Two int32s: an 8-byte record, in a register past a clink variadic's fixed parameter
  TPair = record
    A: int32;
    B: int32;
  end;

  // A plain parent part: its method runs on the part, past the descendant's vptr
  TTagged = object
    Tag: int64;

    method TagPlus(const AValue: int64): int64;
    begin
      return self.Tag + AValue;
    end;
  end;

  // A meter embedded in a counter: its method runs on the embed
  TMeter = object
    R: int64;

    method Reading(): int64;
    begin
      return self.R * 2;
    end;
  end;

  // A counter: plain, const, virtual and result-less methods, a done that says when it ends
  TCounter = object(TTagged)
    N: int64;
    Name: string;
    embed M: TMeter;

    method Add(const AValue: int64): int64;
    begin
      self.N := self.N + AValue;
      return self.N;
    end;

    const method Label(const APrefix: string): string;
    begin
      return APrefix + " " + self.Name;
    end;

    virtual method Kind(): string;
    begin
      return "counter";
    end;

    method Note();
    begin
      println("note {}", self.N);
    end;

    done;
    begin
      println("done {}", self.Name);
    end;
  end;

  // A descendant: its override runs through the vtable read at the async
  TDouble = object(TCounter)
    override method Kind(): string;
    begin
      return "double";
    end;
  end;

  IArea = interface
    method Area(): int64;
  end;

  // An interface's object: its method runs through the itable read at the async
  TSquare = object implements IArea
    Side: int64;

    virtual method Area(): int64;
    begin
      return self.Side * self.Side;
    end;

    done;
    begin
      println("done square");
    end;
  end;

  // A variadic routine value's type
  TSum = func(const ACount: int32; ...): int64;

// The ACount int32s after ACount, summed (clink: C's varargs)
func SumInts(const ACount: int32; ...): int64;
var
  LSum: int64;
  LI: int32;
begin
  LSum := 0;
  for LI := 1 to ACount do
    LSum := LSum + int64(varargs.next(int32));
  end;
  return LSum;
end;

// AN plus the halves of the TPair after it (clink: an 8-byte record in its slot)
func PairSum(const AN: int32; ...): int64;
var
  LPair: TPair;
begin
  LPair := varargs.next(TPair);
  return int64(AN) + int64(LPair.A) + int64(LPair.B);
end;

// The strings after ASep joined by it (cpplink: a typed pack of managed items)
func cpplink Join(const ASep: string; ...): string;
var
  LResult: string;
  LI: int32;
begin
  LResult := "";
  for LI := 1 to varargs.count do
    if LI > 1 then
      LResult := LResult + ASep;
    end;
    LResult := LResult + varargs.next(string);
  end;
  return LResult;
end;

// An int32, a TPair and a string read back from the pack, one line
func cpplink Mixed(...): string;
var
  LN: int32;
  LPair: TPair;
  LText: string;
begin
  LN := varargs.next(int32);
  LPair := varargs.next(TPair);
  LText := varargs.next(string);
  return FormatStr("{} {} {} {}", LN, LPair.A, LPair.B, LText);
end;

func Tests();
var
  LCounter: ref TCounter;
  LDouble: ref TDouble;
  LBase: ref TCounter;
  LSquare: ref TSquare;
  LArea: ref IArea;
  LNone: ref TCounter;
  LLocal: TCounter;
  LPtr: ptr to TCounter;
  LPair: TPair;
  LWord: string;
  LFn: TSum;
  LSum: task int64;
  LText: task string;
  LPlain: task;
begin
  // a ref's object: the task holds it past the ref's nil, it ends with the task
  LCounter := ref TCounter();
  LCounter.Name := "a";
  LSum := async LCounter.Add(5);
  LCounter := nil;
  println("sum {}", await LSum);
  LSum := nil;
  // through a parent's ref: the override, the const method, the parent part, the embed
  LDouble := ref TDouble();
  LDouble.Name := "b";
  LDouble.Tag := 40;
  LDouble.M.R := 3;
  LBase := LDouble;
  LText := async LBase.Kind();
  println("kind {}", await LText);
  LText := async LBase.Label("label");
  println("{}", await LText);
  LSum := async LDouble.TagPlus(2);
  println("tag {}", await LSum);
  LSum := async LDouble.Reading();
  println("reading {}", await LSum);
  LText := nil;
  LSum := nil;
  LBase := nil;
  LDouble := nil;
  // an interface's ref: the object's method through its itable
  LSquare := ref TSquare();
  LSquare.Side := 4;
  LArea := LSquare;
  LSquare := nil;
  LSum := async LArea.Area();
  LArea := nil;
  println("area {}", await LSum);
  LSum := nil;
  // through a ptr: the caller keeps the object
  LLocal.N := 10;
  LLocal.Name := "local";
  LPtr := addr of LLocal;
  LSum := async LPtr->Add(1);
  println("ptr {}", await LSum);
  LSum := async LPtr^.Add(2);
  println("deref {}", await LSum);
  LPlain := async LPtr->Note();
  await LPlain;
  // a nil ref raises at the async
  guard
    LSum := async LNone.Add(1);
    println("never");
  except
    println("nil caught");
  end;
  // variadic calls: the extra arguments copied at the async
  LSum := async SumInts(3, 10, 20, 30);
  println("clink {}", await LSum);
  LPair.A := 2;
  LPair.B := 5;
  LSum := async PairSum(1, LPair);
  LPair.A := 100;
  println("pair {}", await LSum);
  LWord := "a";
  LText := async Join("-", LWord, "b" + "c");
  LWord := "x";
  println("join {}", await LText);
  LText := async Mixed(7, LPair, "s");
  println("mixed {}", await LText);
  LFn := SumInts;
  LSum := async LFn(2, 4, 5);
  println("value {}", await LSum);
end;

begin
  Tests();
  println("end");
end.
