-------------------------------------------------------------------------------
  thread_fault.adam - Threads: a hardware fault on another thread is a raise
  there (BNF sec 5): one in a for parallel body is raised again after the
  barrier, one in an async block by its await, each caught by the caller's
  guard with the fault's code and text (3 Access violation); nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | parallel 3 Access violation
  | await 3 Access violation
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_fault;

var
  GNil: ptr to int64;

func Faults();
var
  LTask: task;
begin
  guard
    for parallel (2) I := 1 to 4 do
      if I = 3 then
        GNil[0] := I;
      end;
    end;
  except
    println("parallel {} {}", exccode(), excmsg());
  end;
  LTask := async begin
    GNil[0] := 1;
  end;
  guard
    await LTask;
  except
    println("await {} {}", exccode(), excmsg());
  end;
end;

begin
  GNil := nil;
  Faults();
  println("end");
end.
