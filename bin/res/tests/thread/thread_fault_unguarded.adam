-------------------------------------------------------------------------------
  thread_fault_unguarded.adam - Threads: a hardware fault no guard takes on a
  started thread ends the program as on the main thread (BNF sec 1): passed by
  the thread's last catching scope (the runtime's ThreadRun), it is reported
  on stderr, `unhandled exception 3: Access violation`, and the process ends
  at once with exit code 1 while main waits in ThreadJoin: no teardown, no heap
  report.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 1
  | start
  | unhandled exception 3: Access violation
@@end
*/

module exe thread_fault_unguarded;

import System.Runtime;

// The thread's entry: a write through the nil pointer it is given
func Worker(const AArg: ptr);
var
  LTarget: ptr to int64;
begin
  LTarget := ptr to int64(AArg);
  LTarget[0] := 1;
end;

var
  LThread: ptr;
begin
  println("start");
  FlushOutput();
  LThread := ThreadStart(Worker, nil);
  ThreadJoin(LThread);
  println("never");
end.
