-------------------------------------------------------------------------------
  thread_async_block_err.adam - Break step of thread_async_block (BNF sec 6
  async block; PLAN-ADAM T4): a return in the block (SM0713); a write to a
  variable or parameter the block copies, by an assignment, ++, to a field
  of it, or as a for's iterator (SM0714); a varargs read in the block
  (SM0715); self and parent in a method's block (SM0716); a leave and a
  workerindex() that would reach past the block (SM0607, SM0710). A module
  variable is no copy: the block writes it.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe thread_async_block_err;

var
  GSum: int64;
  GTask: task;

type
  TPair = record
    X: int64;
  end;

  TBase = object
    N: int64;

    method Get(): int64;
    begin
      return self.N;
    end;
  end;

  TThing = object(TBase)
    // self may be gone before the task runs
    method Spawn();
    begin
      GTask := async begin
        GSum := self.N; // ERROR SM0716@17: an async block cannot use self: the object may be gone before the task runs
        GSum := parent.Get(); // ERROR SM0716@17: an async block cannot use parent: the object may be gone before the task runs
      end;
    end;
  end;

// A return cannot leave the block
routine Leaves();
begin
  GTask := async begin
    return; // ERROR SM0713@5: return cannot leave an async block (its task ends at the block's end)
  end;
end;

// The block reads copies: it writes none of them
routine Writes(ACount: int64);
var
  LPair: TPair;
  LI: int64;
begin
  GTask := async begin
    ACount := 1; // ERROR SM0714@5: an async block cannot write 'ACount': it reads its own copy, taken at the async
    LI++; // ERROR SM0714@5: an async block cannot write 'LI': it reads its own copy, taken at the async
    LPair.X := 2; // ERROR SM0714@5: an async block cannot write 'LPair': it reads its own copy, taken at the async
    for LI := 1 to 2 do // ERROR SM0714@5: an async block cannot write 'LI': it reads its own copy, taken at the async
      GSum := GSum + LI;
    end;
  end;
end;

// The block never sees the routine's varargs
routine Sum(const ACount: int32; ...);
begin
  GTask := async begin
    GSum := int64(varargs.next(int32)); // ERROR SM0715@19: an async block cannot read its routine's varargs
  end;
end;

begin
  while GSum < 10 do
    GTask := async begin
      leave; // ERROR SM0607@7: leave outside a loop or match
    end;
    GSum := GSum + 1;
  end;
  for parallel I := 1 to 2 do
    GTask := async begin
      GSum := workerindex(); // ERROR SM0710@15: workerindex() is only known inside a for parallel's body
    end;
  end;
end.
