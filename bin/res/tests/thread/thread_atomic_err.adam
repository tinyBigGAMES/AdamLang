-------------------------------------------------------------------------------
  thread_atomic_err.adam - Break step of thread_atomic (BNF sec 7, PLAN-ADAM
  H4t2a): what an atomic cannot act on, each SM0409 naming its signature.
  atomicadd of a ptr; an int16 or a float64 place; a constant parameter, a
  literal or a property (no storage to lock); a wrong count of arguments; a
  value that does not convert to the place's type (a string, a float).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe thread_atomic_err;

type
  // An object with a property: a property is no place an atomic acts on
  Box = object
    FSize: int64;
    property Size: int64 read FSize; write FSize;
  end;

var
  GCount: int64;
  GSlot: ptr;
  GShort: int16;
  GReal: float64;
  GBox: Box;

// Each atomic refused
func Refused(const AValue: int64);
begin
  atomicadd(GSlot, nil); // ERROR SM0409@3: 'atomicadd' takes (int32, int64, uint32 or uint64 variable, its type)
  atomicload(GShort); // ERROR SM0409@3: 'atomicload' takes (int32, int64, uint32, uint64 or ptr variable)
  atomicswap(GReal, 1.0); // ERROR SM0409@3: 'atomicswap' takes (int32, int64, uint32, uint64 or ptr variable, its type)
  atomicadd(AValue, 1); // ERROR SM0409@3: 'atomicadd' takes (int32, int64, uint32 or uint64 variable, its type)
  atomicload(5); // ERROR SM0409@3: 'atomicload' takes (int32, int64, uint32, uint64 or ptr variable)
  atomicswap(GBox.Size, 3); // ERROR SM0409@3: 'atomicswap' takes (int32, int64, uint32, uint64 or ptr variable, its type)
  atomiccas(GCount, 1); // ERROR SM0409@3: 'atomiccas' takes (int32, int64, uint32, uint64 or ptr variable, its type, its type)
  atomicstore(GCount, "x"); // ERROR SM0409@3: 'atomicstore' takes (int32, int64, uint32, uint64 or ptr variable, its type)
  atomicadd(GCount, GReal); // ERROR SM0409@3: 'atomicadd' takes (int32, int64, uint32 or uint64 variable, its type)
end;

begin
  Refused(1);
end.
