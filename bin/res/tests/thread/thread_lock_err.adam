-------------------------------------------------------------------------------
  thread_lock_err.adam - Break step of thread_lock (BNF sec 4 mutex, sec 5
  lock / trylock; PLAN-ADAM H4t5): lock / trylock of something that is no
  mutex place, an int64 and a call's value (SM0620); trylock's wait that is
  no int64 (SM0200); a value holding a mutex copied (SM0621): a parameter by
  value or const, a result, an initializer, an assignment of a mutex and of
  a record holding one. A var parameter of a mutex is fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe thread_lock_err;

type
  // A record holding a mutex
  Guarded = record
    Lock: mutex;
    Count: int64;
  end;

var
  GLock: mutex;
  GOther: mutex;
  GCount: int64;
  GSafe: Guarded;
  GCopy: Guarded;

// A mutex by value and by const: copies
func ByValue(AMutex: mutex; // ERROR SM0621@14: parameter 'AMutex' of type 'mutex' holds a mutex, which is never copied: make it a var parameter
  const AConst: mutex); // ERROR SM0621@3: parameter 'AConst' of type 'mutex' holds a mutex, which is never copied: make it a var parameter
begin
end;

// A mutex by var: the caller's own
func ByVar(var AMutex: mutex);
begin
  lock (AMutex) do
    GCount := GCount + 1;
  end;
end;

// A record holding a mutex as a result: a copy
func Make(): Guarded; // ERROR SM0621@14: 'Make' returns 'Guarded', which holds a mutex: a mutex is never copied
var
  LGuarded: Guarded;
begin
  return LGuarded;
end;

// An int64
func Number(): int64;
begin
  return 1;
end;

func Locks();
var
  LInit: mutex = GLock; // ERROR SM0621@18: variable 'LInit' of type 'mutex' holds a mutex: it starts unlocked and takes no initializer
begin
  lock (GCount) do // ERROR SM0620@9: lock takes a mutex variable, field or element, not 'GCount'
    GCount := 1;
  end;
  trylock (Number()) do // ERROR SM0620@12: trylock takes a mutex variable, field or element, not 'Number()'
    GCount := 2;
  end;
  trylock (GLock) wait "soon" do // ERROR SM0200@24: 'string' does not convert implicitly to 'int64'
    GCount := 3;
  end;
  GLock := GOther; // ERROR SM0621@3: 'GLock' of type 'mutex' holds a mutex, which is never assigned
  GCopy := GSafe; // ERROR SM0621@3: 'GCopy' of type 'Guarded' holds a mutex, which is never assigned
  ByVar(GLock);
end;

begin
  Locks();
end.
