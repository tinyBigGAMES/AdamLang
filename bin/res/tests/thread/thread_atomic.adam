-------------------------------------------------------------------------------
  thread_atomic.adam - Threads: the atomics (BNF sec 7, PLAN-ADAM H4t2a) on
  the program's one thread, every place form. atomicadd gives the old value
  (10, then 15 after -20), atomicload the value (-5), atomicswap the old one
  (-5, then 100), atomicstore writes (77); atomiccas leaves the place when it
  differs (false, 77) and writes when it equals (true, 1); atomicadd as a
  statement (3), through a var parameter (3, then 8) and a deref (8, then
  17); int32 wraps (2147483647 + 1 = -2147483648), uint64 wraps (3 + 2^64 - 2
  = 1); an array element (4), a record field (0; a uint32 cas 0 -> 255), a
  threadstatic (5, then 6), a ptr (swap from nil, a cas that fails on a
  non-nil, one that writes nil back) and a local (7 -> 9). Contention across
  threads is proven by H4t2b's rows.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 10
  | 15
  | 15
  | -5
  | -5
  | 100
  | 77
  | false
  | 77
  | true
  | 1
  | 3
  | 3
  | 8
  | 8
  | 17
  | 2147483647
  | -2147483648
  | 0
  | 3
  | 1
  | 0
  | 4
  | 0
  | true
  | 255
  | 5
  | 6
  | true
  | false
  | true
  | true
  | 9
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_atomic;

import System.SysUtils;

type
  // A record whose fields are atomic places
  Counter = record
    Hits: int64;
    Mask: uint32;
  end;

threadstatic
  GLocal: int32 = 5;

var
  GCount: int64 = 10;
  GCountPtr: ptr to int64;
  GWide: uint64;
  GSmall: int32 = 2147483647;
  GSlot: ptr;
  GTable: array[0..2] of int32;
  GCounter: Counter;

// AValue raised by AStep atomically (a var parameter is a place); its old value
routine BumpBy(var AValue: int64; const AStep: int64): int64;
begin
  return atomicadd(AValue, AStep);
end;

// "true" or "false" for AValue
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// A local uint32 written by a cas that holds (7 -> 9)
routine LocalCas(): string;
var
  LValue: uint32;
begin
  LValue := 7;
  if not atomiccas(LValue, 7, 9) then
    return "cas failed";
  end;
  return IntToStr(int64(LValue));
end;

begin
  println("{}", IntToStr(atomicadd(GCount, 5)));
  println("{}", IntToStr(GCount));
  println("{}", IntToStr(atomicadd(GCount, -20)));
  println("{}", IntToStr(atomicload(GCount)));
  println("{}", IntToStr(atomicswap(GCount, 100)));
  println("{}", IntToStr(GCount));
  atomicstore(GCount, 77);
  println("{}", IntToStr(GCount));
  println("{}", BoolText(atomiccas(GCount, 76, 1)));
  println("{}", IntToStr(GCount));
  println("{}", BoolText(atomiccas(GCount, 77, 1)));
  println("{}", IntToStr(GCount));
  atomicadd(GCount, 2);
  println("{}", IntToStr(GCount));
  println("{}", IntToStr(BumpBy(GCount, 5)));
  println("{}", IntToStr(GCount));
  GCountPtr := addr of GCount;
  println("{}", IntToStr(atomicadd(GCountPtr^, 9)));
  println("{}", IntToStr(GCount));
  println("{}", IntToStr(atomicadd(GSmall, 1)));
  println("{}", IntToStr(GSmall));
  println("{}", IntToStr(int64(atomicadd(GWide, 3u))));
  println("{}", IntToStr(int64(atomicadd(GWide, 18446744073709551614u))));
  println("{}", IntToStr(int64(GWide)));
  println("{}", IntToStr(atomicadd(GTable[1], 4)));
  println("{}", IntToStr(GTable[0] + GTable[1] + GTable[2]));
  println("{}", IntToStr(atomicadd(GCounter.Hits, 2)));
  println("{}", BoolText(atomiccas(GCounter.Mask, 0, 0xFF)));
  println("{}", IntToStr(int64(atomicload(GCounter.Mask))));
  println("{}", IntToStr(atomicadd(GLocal, 1)));
  println("{}", IntToStr(GLocal));
  println("{}", BoolText(atomicswap(GSlot, GCountPtr) = nil));
  println("{}", BoolText(atomiccas(GSlot, nil, nil)));
  println("{}", BoolText(atomiccas(GSlot, GCountPtr, nil)));
  println("{}", BoolText(atomicload(GSlot) = nil));
  println("{}", LocalCas());
end.
