-------------------------------------------------------------------------------
  thread_fault_ctimer.adam - Threads: a plain routine given to C as a value
  and run on a thread glibc starts itself (timer_create's SIGEV_THREAD: no
  slot the pthread_create hook sees, PLAN-LINUX64 LX4c3) enters that thread
  as an Adam callback does: a raise inside is caught by its guard, a stack
  overflow inside is caught by its guard (4 Stack overflow; the thread's
  alternate signal stack made at the entry), and the thread's end gives back
  what it held (nothing leaks).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | timer raise 1 from the timer
  | timer 4 Stack overflow
  | fired
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_fault_ctimer;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "thread_fault_ctimer runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

import System.Linux;

const
  // How long main waits for the timer's routine, in 10 ms steps (5 s)
  WAIT_STEPS: int64 = 500;

var
  GV: int64;
  // 1 once the timer's routine has run
  GDone: int64;

// A recursion with no end: every frame holds 2 KB, so the stack runs out
func Deep(const AN: int64): int64;
var
  LBuf: array[0..255] of int64;
begin
  LBuf[AN mod 256] := AN;
  return Deep(AN + 1) + LBuf[0];
end;

// The timer's routine (glibc calls it on a thread it starts): a raise and a stack
// overflow, each caught by its own guard
func clink TimerBody(AValue: ptr);
begin
  guard
    raise("from the timer");
  except
    println("timer raise {} {}", exccode(), excmsg());
  end;
  guard
    GV := Deep(0);
  except
    println("timer {} {}", exccode(), excmsg());
  end;
  atomicstore(GDone, 1);
end;

// One timer firing once, 1 ms from now, waited for, then deleted
func RunTimer();
var
  LEvent: sigevent;
  LTimer: ptr;
  LTimes: itimerspec;
  LStep: timespec;
  LI: int64;
begin
  LEvent.sigev_value := nil;
  LEvent.sigev_signo := 0;
  LEvent.sigev_notify := SIGEV_THREAD;
  LEvent.sigev_notify_function := TimerBody;
  LEvent.sigev_notify_attributes := nil;
  LTimer := nil;
  if timer_create(CLOCK_MONOTONIC, addr of LEvent, LTimer) <> 0 then
    println("no timer");
    return;
  end;
  LTimes.it_interval.tv_sec := 0;
  LTimes.it_interval.tv_nsec := 0;
  LTimes.it_value.tv_sec := 0;
  LTimes.it_value.tv_nsec := 1000000;
  if timer_settime(LTimer, 0, addr of LTimes, nil) <> 0 then
    println("not armed");
    timer_delete(LTimer);
    return;
  end;
  LStep.tv_sec := 0;
  LStep.tv_nsec := 10000000;
  LI := 0;
  while (atomicload(GDone) = 0) and (LI < WAIT_STEPS) do
    nanosleep(addr of LStep, nil);
    LI := LI + 1;
  end;
  timer_delete(LTimer);
  if atomicload(GDone) = 0 then
    println("not fired");
    return;
  end;
  println("fired");
end;

begin
  GV := 0;
  GDone := 0;
  RunTimer();
  println("end");
end.
