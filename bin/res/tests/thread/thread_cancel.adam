-------------------------------------------------------------------------------
  thread_cancel.adam - cancel / cancelled (BNF sec 7; PLAN-ADAM T3): a task
  spinning until cancelled() ends once cancel(T) ran; cancelled(T) false
  before the cancel and true after; a nil task's cancel does nothing and it
  is never cancelled; cancelled() on the main thread is false; the workers
  of a for parallel inside a task's call see that task's flag; a call that
  raises once cancelled has its raise raised again by await.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | before false
  | after true
  | spun true
  | nil false
  | main false
  | workers 4
  | raised stopped by cancel
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_cancel;

// Spins until its task is cancelled: true once it saw the flag
routine Spin(): bool;
begin
  while not cancelled() do
  end;
  return cancelled();
end;

// A for parallel whose four iterations each wait for the task's flag; the iterations
// that saw it
routine Workers(): int64;
var
  LSeen: int64;
begin
  LSeen := 0;
  for parallel (4) I := 1 to 4 do
    while not cancelled() do
    end;
    atomicadd(LSeen, 1);
  end;
  return LSeen;
end;

// Raises once its task is cancelled
routine Stoppable(): int64;
begin
  while not cancelled() do
  end;
  raise("stopped by cancel");
end;

routine Tests();
var
  LSpin: task bool;
  LNone: task bool;
  LWorkers: task int64;
  LStop: task int64;
begin
  LSpin := async Spin();
  println("before {}", cancelled(LSpin));
  cancel(LSpin);
  println("after {}", cancelled(LSpin));
  println("spun {}", await LSpin);

  cancel(LNone);
  println("nil {}", cancelled(LNone));
  println("main {}", cancelled());

  LWorkers := async Workers();
  cancel(LWorkers);
  println("workers {}", await LWorkers);

  LStop := async Stoppable();
  cancel(LStop);
  guard
    println("never {}", await LStop);
  except
    println("raised {}", excmsg());
  end;
end;

begin
  Tests();
end.
