-------------------------------------------------------------------------------
  thread_task_detach.adam - Tasks (BNF sec 4 task type, PLAN-ADAM M3.8g0b3):
  a discarded task detaches. Its temporary ends with its statement and the
  task's thread holds its own reference, so the routine that dropped it
  never waits: Drop returns while its task is still blocked (the old
  blocking release would hang there). The task runs on to its end; the
  program's exit waits for every running task before any module's teardown,
  so the task's line prints after the block's last line and before the
  finalize's, and fifty quick discarded tasks (their threads joined as later
  tasks start, the rest at the exit) all ended by then. Nothing leaked.
*******************************************************************************/

/*
@@test
  kind run
  | dropped
  | main end
  | task ran: go
  | tasks ended: 51
  | finalize
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_task_detach;

var
  // Set by the program block's last line: the waiting task's call goes on from there
  GGo: int64;
  // Every call that ended, counted by the tasks themselves
  GEnded: int64;
  LI: int64;

// A call that waits until the program block lets it go, then prints its text
routine Waiter(const AText: string);
begin
  while atomicload(GGo) = 0 do
  end;
  println("task ran: {}", AText);
  atomicadd(GEnded, 1);
end;

// A call that ends at once
routine Quick();
begin
  atomicadd(GEnded, 1);
end;

// A task started and dropped: the routine's end does not wait for it
routine Drop();
begin
  async Waiter("go");
end;

finalize
begin
  println("tasks ended: {}", atomicload(GEnded));
  println("finalize");
end;

begin
  Drop();
  println("dropped");
  for LI := 1 to 50 do
    async Quick();
  end;
  println("main end");
  atomicstore(GGo, 1);
end.
