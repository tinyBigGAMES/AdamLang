-------------------------------------------------------------------------------
  thread_static_err_lower.adam - Break step of thread_static (PLAN-ADAM
  H4t1): a threadstatic variable of a managed type (a string) or of a type
  holding one (a record with a string field) is LW0001 at its name until
  H4t3 releases each thread's copy when the thread ends.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/thread_static_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/thread_static_err_lower.adam(42,3): Error LW0001: code generation does not handle a threadstatic variable 'GName' of a managed type yet
  | <DIR>/thread_static_err_lower.adam(43,3): Error LW0001: code generation does not handle a threadstatic variable 'GPair' of a managed type yet
@@end
*/

module exe thread_static_err_lower;

type
  // A record holding a managed field
  Pair = record
    Name: string;
    Count: int32;
  end;

threadstatic
  GName: string;
  GPair: Pair;

begin
  GPair.Count := 1;
end.
