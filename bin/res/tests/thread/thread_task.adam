-------------------------------------------------------------------------------
  thread_task.adam - Tasks (BNF sec 4 task type, sec 6 async / await, sec 7
  ready; PLAN-ADAM H4t4): an int64 result awaited twice (the same result);
  ready after the await, and of a nil task; a string argument copied when the
  task starts (the variable changed after it does not reach the call) and a
  string result; a record argument and result (by value); a call through a
  routine value awaited at once; a plain task awaited as a statement. A task
  never awaited detaches: thread_task_detach.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | square 49
  | again 49
  | ready
  | nil not ready
  | hello one
  | swap 2 1
  | value 9
  | note plain
  | end two
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_task;

import System.SysUtils;

type
  // A pair of numbers: an aggregate argument and result of a task
  Pair = record
    Left: int64;
    Right: int64;
  end;

  // A routine value's type, a task started through a variable of it
  IntFn = routine(const AValue: int64): int64;

// The square of AValue
routine Square(const AValue: int64): int64;
begin
  return AValue * AValue;
end;

// A text made from AName: a managed argument and result
routine Greet(const AName: string): string;
begin
  return "hello " + AName;
end;

// APair with its halves swapped
routine Swap(const APair: Pair): Pair;
var
  LResult: Pair;
begin
  LResult.Left := APair.Right;
  LResult.Right := APair.Left;
  return LResult;
end;

// A call with no result: it prints on its task's thread
routine Note(const AText: string);
begin
  println("{}", "note " + AText);
end;

var
  LSquare: task int64;
  LGreet: task string;
  LSwap: task Pair;
  LNote: task;
  LNone: task int64;
  LName: string;
  LPair: Pair;
  LFn: IntFn;
  LResult: Pair;
begin
  LSquare := async Square(7);
  println("{}", "square " + IntToStr(await LSquare));
  println("{}", "again " + IntToStr(await LSquare));
  if ready(LSquare) then
    println("{}", "ready");
  end;
  if not ready(LNone) then
    println("{}", "nil not ready");
  end;
  LName := "one";
  LGreet := async Greet(LName);
  LName := "two";
  println("{}", await LGreet);
  LPair.Left := 1;
  LPair.Right := 2;
  LSwap := async Swap(LPair);
  LResult := await LSwap;
  println("{}", "swap " + IntToStr(LResult.Left) + " " + IntToStr(LResult.Right));
  LFn := Square;
  println("{}", "value " + IntToStr(await async LFn(3)));
  LNote := async Note("plain");
  await LNote;
  println("{}", "end " + LName);
end.
