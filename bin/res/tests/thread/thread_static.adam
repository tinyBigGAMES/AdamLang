-------------------------------------------------------------------------------
  thread_static.adam - Threads: threadstatic variables of plain types (BNF
  sec 3, PLAN-ADAM H4t1), on the program's one thread. Each starts at its
  constant initializer or zero (GCount 41, GZero 0, GSmall -3, GFlag false,
  GTable all zero); it is read and written in place (42), through a var
  parameter (43) and through `addr of` (53); an array's elements by index
  (0 + 9 + 18 = 27); a public one (7 * 6 = 42); a bool set (true); a plain
  module variable beside them is untouched (5 + 53 = 58). Every thread's
  own copy is proven by H4t2's rows.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | 41
  | 0
  | -3
  | false
  | 42
  | 43
  | 53
  | 27
  | 42
  | true
  | 58
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_static;

import System.SysUtils;

threadstatic
  GCount: int64 = 41;
  GZero: int32;
  GSmall: int8 = -3;
  GFlag: bool;
  GTable: array[0..3] of int32;

public threadstatic
  GShared: int32 = 7;

var
  GPlain: int64 = 5;
  GPointer: ptr to int64;

// AValue raised by one (a thread-local variable reached by reference)
func Bump(var AValue: int64);
begin
  AValue := AValue + 1;
end;

// "true" or "false" for AValue
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

begin
  println("{}", IntToStr(GCount));
  println("{}", IntToStr(GZero));
  println("{}", IntToStr(GSmall));
  println("{}", BoolText(GFlag));
  GCount := GCount + 1;
  println("{}", IntToStr(GCount));
  Bump(GCount);
  println("{}", IntToStr(GCount));
  GPointer := addr of GCount;
  GPointer^ := GPointer^ + 10;
  println("{}", IntToStr(GCount));
  GTable[2] := 9;
  GTable[3] := GTable[2] * 2;
  println("{}", IntToStr(GTable[0] + GTable[2] + GTable[3]));
  GShared := GShared * 6;
  println("{}", IntToStr(GShared));
  GFlag := true;
  println("{}", BoolText(GFlag));
  println("{}", IntToStr(GPlain + GCount));
end.
