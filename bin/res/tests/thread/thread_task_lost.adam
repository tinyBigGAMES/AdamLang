-------------------------------------------------------------------------------
  thread_task_lost.adam - Tasks (BNF sec 4 task type, PLAN-ADAM H4t4,
  M3.8g0b3): a task never awaited whose call raised. Dropped, it detaches
  (Drop returns at once: "dropped" prints), and its call raises once the
  program block lets it go; its thread then holds the last reference, so the
  task's done runs there and ends the program as on a raise nothing caught,
  with the call's code and text (`unhandled exception 1: <text>` on stderr,
  exit code 1); the block, waiting for that end, never prints its last line.
  The end runs the exit handlers (BNF sec 1), so the heap report prints: the
  program ends from inside the task's done, before its descriptor releases
  the raise's text and frees the task's block, so those two are leaked.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 1
  | start
  | dropped
  | unhandled exception 1: lost 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 2
  | thread_task_lost.adam(56,9): 1 leak, 23 bytes, string
  |   thread_task_lost.adam(62,9)
  | thread_task_lost.adam(62,3): 1 leak, 80 bytes, task
  |   thread_task_lost.adam(67,3)
@@end
*/

module exe thread_task_lost;

import System.SysUtils;

var
  // Set by the program block once it printed: the task's call raises from there
  GGo: int64;

// A call that raises on its task's thread, once the program block lets it go
routine Lost();
begin
  while atomicload(GGo) = 0 do
  end;
  raise("lost " + IntToStr(2));
end;

// A task started and dropped: the routine's end does not wait for it
routine Drop();
begin
  async Lost();
end;

begin
  println("start");
  Drop();
  println("dropped");
  atomicstore(GGo, 1);
  // The task's raise ends the program
  while true do
  end;
end.
