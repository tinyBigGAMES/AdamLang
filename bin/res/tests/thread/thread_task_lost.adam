-------------------------------------------------------------------------------
  thread_task_lost.adam - Tasks (BNF sec 4 task type, PLAN-ADAM H4t4): a task
  never awaited whose call raised: its last release (the end of the routine
  that started it) waits for its thread, then ends the program as on a raise
  nothing caught, with the call's code and text (`unhandled exception 1:
  <text>` on stderr, exit code 1); the caller's next line never prints.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 1
  | start
  | unhandled exception 1: lost 2
@@end
*/

module exe thread_task_lost;

import System.SysUtils;

// A call that raises on its task's thread
routine Lost();
begin
  raise("lost " + IntToStr(2));
end;

// A task started and dropped: the routine's end releases it
routine Drop();
begin
  async Lost();
end;

begin
  println("start");
  Drop();
  println("never");
end.
