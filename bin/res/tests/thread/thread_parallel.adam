  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  thread_parallel.adam - for parallel (BNF sec 5, sec 7 workerindex /
  workercount; PLAN-ADAM T2): a sum over 1..1000 into a shared local by
  atomicadd; each iteration writing its own element through a var
  parameter; a downto over 4 given workers, each index in range and the
  count 4 everywhere; 0 workers runs on 1; an empty range runs nothing;
  leave and skip on one worker (deterministic); a raise in the body raised
  again after the barrier (its text kept); a var block in the body private
  to each iteration (a string built and released per pass, no leak); a
  nested for parallel with no count runs on its worker alone; a method's
  body reading self's fields; a char iterator; an int64 iterator past
  int32's range; a uint8 downto to 0.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | sum 500500
  | squares 285
  | downto 100 bad 0 count 4
  | zero 1
  | empty 0
  | leave 9
  | skip 50
  | raised seven
  | digits 192
  | nested 16 inner 1
  | method 30
  | chars 5
  | wide 3
  | bytes 11
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_parallel;

import System.SysUtils;

type
  Squares = array[0..9] of int64;

  // An object whose method's for parallel reads its fields through self
  TBag = object
    Base: int64;
    Total: int64;

    method Run();
    begin
      for parallel I := 1 to 3 do
        atomicadd(self.Total, self.Base * I);
      end;
    end;
  end;

// Each element of AOut its index squared, each iteration writing its own
func Fill(var AOut: Squares);
begin
  for parallel I := 0 to 9 do
    AOut[I] := I * I;
  end;
end;

func Tests();
var
  LSum: int64;
  LCount: int64;
  LBad: int64;
  LWorkers: int64;
  LOut: Squares;
  LI: int64;
  LBag: TBag;
begin
  LSum := 0;
  for parallel I := 1 to 1000 do
    atomicadd(LSum, int64(I));
  end;
  println("sum {}", LSum);

  Fill(LOut);
  LSum := 0;
  for LI := 0 to 9 do
    LSum := LSum + LOut[LI];
  end;
  println("squares {}", LSum);

  LCount := 0;
  LBad := 0;
  LWorkers := 0;
  for parallel (4) I := 100 downto 1 do
    atomicadd(LCount, 1);
    if (workerindex() < 0) or (workerindex() >= workercount()) or (workercount() <> 4) then
      atomicadd(LBad, 1);
    end;
    atomicstore(LWorkers, workercount());
  end;
  println("downto {} bad {} count {}", LCount, LBad, LWorkers);

  for parallel (0) I := 1 to 20 do
    atomicstore(LWorkers, workercount());
  end;
  println("zero {}", LWorkers);

  LCount := 0;
  for parallel I := 5 to 1 do
    atomicadd(LCount, 1);
  end;
  println("empty {}", LCount);

  LCount := 0;
  for parallel (1) I := 1 to 100 do
    if I = 10 then
      leave;
    end;
    atomicadd(LCount, 1);
  end;
  println("leave {}", LCount);

  LCount := 0;
  for parallel (1) I := 1 to 100 do
    if (I % 2) = 1 then
      skip;
    end;
    atomicadd(LCount, 1);
  end;
  println("skip {}", LCount);

  guard
    for parallel I := 1 to 50 do
      if I = 7 then
        raise("seven");
      end;
    end;
  except
    println("raised {}", excmsg());
  end;

  LCount := 0;
  for parallel I := 1 to 100 do
    var LText: string;
    LText := IntToStr(int64(I));
    atomicadd(LCount, len(LText));
  end;
  println("digits {}", LCount);

  LCount := 0;
  LBad := 0;
  for parallel (2) I := 0 to 3 do
    for parallel J := 0 to 3 do
      atomicadd(LCount, 1);
      atomicstore(LBad, workercount());
    end;
  end;
  println("nested {} inner {}", LCount, LBad);

  LBag.Base := 5;
  LBag.Total := 0;
  LBag.Run();
  println("method {}", LBag.Total);

  LCount := 0;
  for parallel C := 'a' to 'e' do
    atomicadd(LCount, 1);
  end;
  println("chars {}", LCount);

  LCount := 0;
  for parallel W := 3000000000 to 3000000002 do
    if W > 2999999999 then
      atomicadd(LCount, 1);
    end;
  end;
  println("wide {}", LCount);

  LCount := 0;
  for parallel B := uint8(10) downto uint8(0) do
    atomicadd(LCount, 1);
  end;
  println("bytes {}", LCount);
end;

begin
  Tests();
end.
