-------------------------------------------------------------------------------
  thread_task_err.adam - Break step of thread_task (BNF sec 6 async / await,
  sec 7 ready; PLAN-ADAM H4t4): async of a name that is no call, and of an
  intrinsic's call (SM0701); async of a call passing a var parameter (SM0702);
  await of something that is no task (SM0703); await of a plain task used as
  a value (SM0704); ready of something that is no task (SM0409).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe thread_task_err;

var
  GCount: int64;
  GTask: task int64;
  GPlain: task;
  GText: string;

// A routine with a var parameter
routine Bump(var AValue: int64);
begin
  AValue := AValue + 1;
end;

// A routine with no result
routine Nothing();
begin
end;

begin
  GTask := async GCount; // ERROR SM0701@12: async needs a call of a routine, not 'GCount'
  GTask := async len(GText); // ERROR SM0701@12: async needs a call of a routine, not 'len(...)'
  GPlain := async Bump(GCount); // ERROR SM0702@13: async cannot pass var parameter 'AValue': the caller's variable may be gone before the call ends
  GCount := await GCount; // ERROR SM0703@13: await needs a task, not 'int64'
  GCount := await GPlain; // ERROR SM0704@13: await of a plain task is a statement: its call has no value
  GPlain := async Nothing();
  if ready(GCount) then // ERROR SM0409@6: 'ready' takes (task)
    Nothing();
  end;
end.
