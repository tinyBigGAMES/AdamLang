-------------------------------------------------------------------------------
  thread_task_lifetime.adam - tasks holding value objects whose type runs code
  where they are copied or ended (M3.10g g5): a value argument is copied into
  the task as it starts and the call takes it (the callee ends it); a const
  argument's copy is the task's, ended with it; a result moves from the call
  into the task, an await copies it out, and the task's last holder ends the
  one it holds. Each task is awaited before the next line prints. The [Heap]
  line shows nothing leaked.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | init 1
  | init 2
  | copy 101
  | show 101
  | done 101
  | copy 101
  | peek 101
  | free peek
  | done 101
  | init 3
  | copy 103
  | done 2
  | got 103
  | free make
  | done 3
  | done 103
  | done 1
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_task_lifetime;

var
  Counter: int64;

type
  TItem = object
    Id: int64;

    init();
    begin
      Counter := Counter + 1;
      self.Id := Counter;
      println("init {}", self.Id);
    end;

    copy(const ASource: TItem);
    begin
      self.Id := ASource.Id + 100;
      println("copy {}", self.Id);
    end;

    done;
    begin
      println("done {}", self.Id);
    end;
  end;

// A value parameter: the call's own, it ends it
routine Show(AItem: TItem);
begin
  println("show {}", AItem.Id);
end;

// A const parameter: the task's copy, ended with the task
routine Peek(const AItem: TItem);
begin
  println("peek {}", AItem.Id);
end;

// A result made in the task: moved into it
routine Make(): TItem;
var
  LItem: TItem;
begin
  return LItem;
end;

routine Run();
var
  LItem: TItem;
  LGot: TItem;
  LShow: task;
  LPeek: task;
  LMake: task TItem;
begin
  LShow := async Show(LItem);
  await LShow;
  LShow := nil;
  LPeek := async Peek(LItem);
  await LPeek;
  println("free peek");
  LPeek := nil;
  LMake := async Make();
  LGot := await LMake;
  println("got {}", LGot.Id);
  println("free make");
  LMake := nil;
end;

begin
  Counter := 0;
  Run();
  println("end");
end.
