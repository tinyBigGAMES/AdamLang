-------------------------------------------------------------------------------
  thread_shared_write.adam - Threads: shared arrays and strings written from
  threads (BNF sec 5). A for parallel whose body writes elements of an array
  or a string that another variable shares makes it unshared once, before
  any worker starts: every worker writes the one buffer, the other holder
  keeps its old value (a global array, a captured string, a field through
  self, many rounds). A write that still finds a non-local array shared on a
  worker (a routine the body calls takes a second holder, or writes a global
  shared with another variable) raises code 15 `shared array written from
  threads`, raised again after the loop; outside threaded code copy on write
  is unchanged.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | rounds 20 sum 49995000 copy 0
  | text xxxxxxxx kept abcdefgh
  | field 1 2 3 4 kept 0
  | held raised 15 shared array written from threads
  | called raised 15 shared array written from threads
  | single 5 kept 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_shared_write;

import System.SysUtils;

type
  // An object whose method's for parallel writes its own array field through self
  Board = object
    FCells: array of int64;

    method Fill();
    begin
      for parallel I := 0 to len(self.FCells) - 1 do
        self.FCells[I] := I + 1;
      end;
    end;
  end;

var
  GValues: array of int64;
  GCopy: array of int64;
  GTable: array of int64;
  GTableCopy: array of int64;

// A second holder of GValues taken, then an element of GValues written: the write finds it
// shared on a worker
func HoldAndWrite(const AIndex: int64);
var
  LHold: array of int64;
begin
  LHold := GValues;
  GValues[AIndex] := 0;
end;

// A write the loop's body does not name: GTable is written by this routine alone
func Put(const AIndex: int64);
begin
  GTable[AIndex mod 10] := AIndex;
end;

var
  LI: int64;
  LRound: int32;
  LSum: int64;
  LCopySum: int64;
  LText: string;
  LKept: string;
  LBoard: Board;
  LFields: array of int64;
  LSingle: array of int64;
begin
  // raven_parallel's shape: GValues shared with GCopy at each loop's start
  LCopySum := 0;
  for LRound := 1 to 20 do
    // a new array of zeros each round, then shared
    setlength(GValues, 0);
    setlength(GValues, 10000);
    GCopy := GValues;
    for parallel I := 0 to 9999 do
      GValues[I] := I;
    end;
    for LI := 0 to 9999 do
      LCopySum := LCopySum + GCopy[LI];
    end;
  end;
  LSum := 0;
  for LI := 0 to 9999 do
    LSum := LSum + GValues[LI];
  end;
  println("rounds 20 sum {} copy {}", LSum, LCopySum);

  // a captured string shared with another variable
  LKept := "abcdefgh";
  LText := LKept;
  for parallel (4) I := 0 to 7 do
    LText[I] := 'x';
  end;
  println("text {} kept {}", LText, LKept);

  // a field reached through self
  setlength(LBoard.FCells, 4);
  LFields := LBoard.FCells;
  LBoard.Fill();
  println("field {} {} {} {} kept {}", LBoard.FCells[0], LBoard.FCells[1], LBoard.FCells[2],
    LBoard.FCells[3], LFields[0]);

  // a second holder a called routine takes: its write finds GValues shared on a worker
  guard
    for parallel (4) I := 0 to 99 do
      HoldAndWrite(I);
    end;
  except
    println("held raised {} {}", exccode(), excmsg());
  end;

  // a global a called routine writes: the body names no write, the check catches it
  setlength(GTable, 10);
  GTableCopy := GTable;
  guard
    for parallel (4) I := 0 to 99 do
      Put(I);
    end;
  except
    println("called raised {} {}", exccode(), excmsg());
  end;

  // outside threaded code: copy on write as before
  setlength(LSingle, 1);
  GValues := LSingle;
  GValues[0] := 5;
  println("single {} kept {}", GValues[0], LSingle[0]);
end.
