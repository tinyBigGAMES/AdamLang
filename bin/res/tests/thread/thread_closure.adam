-------------------------------------------------------------------------------
  thread_closure.adam - closures across threads (BNF sec 4 closure type,
  sec 5 for parallel, sec 6 async; PLAN-RAVENAPI F2c): for parallel workers
  call one closure that adds into a captured local (atomicadd through its
  box); closures made in a parallel body over its iterator and run there;
  a closure as an async call's result, still counting after its task; a
  shared closure copied by every worker (its counts atomic); a closure that
  drops the last other holder of itself while it runs (the call holds it).
  Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | sum 5050
  | made 110
  | async 41 42
  | copies 50
  | drop 1 true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_closure;

type
  Counter = ref func(): int64;
  Sink = ref func(const AN: int64);

func MakeCounter(const AStart: int64): Counter;
var
  LCount: int64;
begin
  LCount := AStart;
  return func(): int64
  begin
    LCount := LCount + 1;
    return LCount;
  end;
end;

// Every worker calls one closure, which adds into the routine's local through its box
func ParallelSum(): int64;
var
  LSum: int64;
  LAdd: Sink;
begin
  LAdd := func(const AN: int64)
  begin
    atomicadd(LSum, AN);
  end;
  for parallel I := 1 to 100 do
    LAdd(int64(I));
  end;
  return LSum;
end;

// A closure made on each worker over the iterator, run there
func ParallelMade(): int64;
var
  LTotal: int64;
begin
  for parallel I := 1 to 10 do
    var LTimes: Counter;
    LTimes := func(): int64
    begin
      return int64(I) * 2;
    end;
    atomicadd(LTotal, LTimes());
  end;
  return LTotal;
end;

var
  GTask: task Counter;
  GAsync: Counter;
  GShared: Counter;
  GCopies: int64;
  GSelf: Counter;

// A closure whose run drops GSelf, the last holder besides the call's own
func MakeDropper(): Counter;
var
  LRuns: int64;
begin
  return func(): int64
  begin
    GSelf := nil;
    LRuns := LRuns + 1;
    return LRuns;
  end;
end;

begin
  println("sum {}", ParallelSum());
  println("made {}", ParallelMade());
  GTask := async MakeCounter(40);
  GAsync := await GTask;
  GTask := nil;
  println("async {} {}", GAsync(), GAsync());
  GAsync := nil;
  GShared := MakeCounter(0);
  for parallel I := 1 to 50 do
    var LMine: Counter;
    LMine := GShared;
    if LMine <> nil then
      atomicadd(GCopies, 1);
    end;
  end;
  GShared := nil;
  println("copies {}", GCopies);
  GSelf := MakeDropper();
  println("drop {} {}", GSelf(), GSelf = nil);
end.
