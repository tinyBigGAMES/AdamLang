-------------------------------------------------------------------------------
  thread_run.adam - Threads: the runtime's threads and lock (PLAN-ADAM H4t2b)
  under contention. Four threads (ThreadStart, ThreadJoin) each run 100000
  rounds of: atomicadd on one shared int64 (4 x 100000 = 400000), a copy of
  one shared string and one shared dynamic array (their counts raised and
  dropped by every thread at once: still whole after, "42 ok" and 3), a new
  string (the heap counts from every thread), and a plain int64 raised
  under the runtime's lock (LockCreate .. LockFree: 400000, no round lost).
  Then 1000 raises each, caught in the thread (4 x 1000 = 4000), every
  thread's raise in flight its own (threadstatic) and released as the
  thread ends (Leaked 0). A threadstatic starts at its initializer on each
  thread (-1) and keeps each thread's own value (0 .. 3); main's is still -1.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | count 400000
  | guarded 400000
  | text 42 ok
  | numbers 3
  | caught 4000
  | thread 0 started -1 saw 0
  | thread 1 started -1 saw 1
  | thread 2 started -1 saw 2
  | thread 3 started -1 saw 3
  | main -1
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_run;

import System.SysUtils, System.Runtime;

threadstatic
  GMine: int64 = -1;

var
  // Each thread's index (its argument points at its own element), handle, and what it
  // found in GMine at its start and its end
  GIndex: array[0..3] of int64;
  GThreads: array[0..3] of ptr;
  GStart: array[0..3] of int64;
  GSeen: array[0..3] of int64;
  // What every thread shares
  GCount: int64;
  GGuarded: int64;
  GCaught: int32;
  GLock: ptr;
  GText: string;
  GNumbers: array of int32;

// One thread's work; AArg points at its index in GIndex
routine Worker(const AArg: ptr);
var
  LIndex: ptr to int64;
  LI: int32;
  LText: string;
  LNumbers: array of int32;
  LMade: string;
begin
  LIndex := ptr to int64(AArg);
  GStart[LIndex^] := GMine;
  GMine := LIndex^;
  for LI := 1 to 100000 do
    atomicadd(GCount, 1);
    LText := GText;
    LNumbers := GNumbers;
    LMade := IntToStr(LI);
    LockEnter(GLock);
    GGuarded := GGuarded + 1;
    LockLeave(GLock);
  end;
  for LI := 1 to 1000 do
    guard
      raise("thread " + IntToStr(LIndex^));
    except
      atomicadd(GCaught, 1);
    end;
  end;
  GSeen[LIndex^] := GMine;
end;

var
  LI: int32;
begin
  GText := IntToStr(42) + " ok";
  setlength(GNumbers, 3);
  GLock := LockCreate();
  for LI := 0 to 3 do
    GIndex[LI] := LI;
  end;
  for LI := 0 to 3 do
    GThreads[LI] := ThreadStart(Worker, ptr(addr of GIndex[LI]));
  end;
  for LI := 0 to 3 do
    ThreadJoin(GThreads[LI]);
  end;
  LockFree(GLock);
  println("{}", "count " + IntToStr(GCount));
  println("{}", "guarded " + IntToStr(GGuarded));
  println("{}", "text " + GText);
  println("{}", "numbers " + IntToStr(len(GNumbers)));
  println("{}", "caught " + IntToStr(GCaught));
  for LI := 0 to 3 do
    println("{}", "thread " + IntToStr(LI) + " started " + IntToStr(GStart[LI]) + " saw " +
      IntToStr(GSeen[LI]));
  end;
  println("{}", "main " + IntToStr(GMine));
end.
