-------------------------------------------------------------------------------
  thread_fault_cthread.adam - Threads: a thread C code started (the OS's own
  thread call, pthread_create / CreateThread, never Adam's runtime) gets its
  fault state as an Adam thread does (PLAN-LINUX64 LX4c2): a stack overflow
  in the clink routine it runs is caught by that routine's guard (4 Stack
  overflow), twice (the guard pages are back for the second), and the
  thread's end releases its copies like any thread's (nothing leaks).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | c thread 4 Stack overflow
  | c thread 4 Stack overflow
  | joined
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_fault_cthread;

@ifdef TARGET_X86_64_LINUX_GNU
import System.Linux;
@else
import System.Windows;
@endif

var
  GV: int64;

// A recursion with no end: every frame holds 2 KB, so the stack runs out
func Deep(const AN: int64): int64;
var
  LBuf: array[0..255] of int64;
begin
  LBuf[AN mod 256] := AN;
  return Deep(AN + 1) + LBuf[0];
end;

// The thread's work: two stack overflows, each caught by its own guard
func Overflows();
begin
  guard
    GV := Deep(0);
  except
    println("c thread {} {}", exccode(), excmsg());
  end;
  guard
    GV := Deep(0);
  except
    println("c thread {} {}", exccode(), excmsg());
  end;
end;

@ifdef TARGET_X86_64_LINUX_GNU
// pthread_create's start routine (C calls it)
func clink ThreadBody(AArgument: ptr): ptr;
begin
  Overflows();
  return nil;
end;
@else
// CreateThread's start routine (C calls it)
func clink ThreadBody(AParameter: ptr): uint32;
begin
  Overflows();
  return 0;
end;
@endif

// One thread started by the OS's own call, then waited for
func RunCThread();
var
@ifdef TARGET_X86_64_LINUX_GNU
  LThread: uint64;
@else
  LHandle: uint64;
@endif
begin
@ifdef TARGET_X86_64_LINUX_GNU
  LThread := 0;
  if pthread_create(LThread, nil, ThreadBody, nil) <> 0 then
    println("no thread");
    return;
  end;
  pthread_join(LThread, nil);
@else
  LHandle := CreateThread(nil, 0, ThreadBody, nil, 0, nil);
  if LHandle = 0 then
    println("no thread");
    return;
  end;
  WaitForSingleObject(LHandle, INFINITE);
  CloseHandle(LHandle);
@endif
  println("joined");
end;

begin
  GV := 0;
  RunCThread();
  println("end");
end.
