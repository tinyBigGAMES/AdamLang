-------------------------------------------------------------------------------
  thread_cancel_err.adam - Break step of thread_cancel (BNF sec 7; PLAN-ADAM
  T3): cancel of something that is no task, and with no argument; cancelled
  of something that is no task, and with two arguments (SM0409).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe thread_cancel_err;

var
  GCount: int64;
  GTask: task int64;
  GDone: bool;

begin
  cancel(GCount); // ERROR SM0409@3: 'cancel' takes (task)
  cancel(); // ERROR SM0409@3: 'cancel' takes (task)
  GDone := cancelled(GCount); // ERROR SM0409@12: 'cancelled' takes () or (task)
  GDone := cancelled(GTask, GTask); // ERROR SM0409@12: 'cancelled' takes () or (task)
end.
