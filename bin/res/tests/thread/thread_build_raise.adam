-------------------------------------------------------------------------------
  thread_build_raise.adam - a raise while a task's object is built (G1c4):
  a const argument's copy that raises, a value argument's (the call's to
  take), an argument that raises as it is made, an async block's capture
  copy that raises: the task is released (with the async's hidden slot,
  after the except part), its end ending only the copies made before it.
  A build that raises nothing ends them all, the last made first. The order lines are the proof; ends counts every done (none
  run over a copy never made), the [Heap] line shows nothing leaked
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | copy a'
  | copy c'
  | peek a' c'
  | done c'
  | done a'
  | copy a'
  | caught bad copy
  | done a'
  | copy a'
  | caught bad copy
  | done a'
  | copy a'
  | caught bad arg
  | done a'
  | copy a'
  | caught bad copy
  | done a'
  | ends 15
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_build_raise;

var
  Ends: int64;

type
  // A copy of the tag "bad" raises; only a copy says so at its done, every done counts
  TRes = object
    Tag: string;
    Copied: bool;

    copy(const ASource: TRes);
    begin
      if ASource.Tag = "bad" then
        raise("bad copy");
      end;
      self.Tag := ASource.Tag + "'";
      self.Copied := true;
      println("copy {}", self.Tag);
    end;

    done;
    begin
      Ends := Ends + 1;
      if self.Copied then
        println("done {}", self.Tag);
      end;
    end;
  end;

// Const parameters: the task's copies, ended with it
routine Peek2(const A: TRes; const B: TRes);
begin
  println("peek {} {}", A.Tag, B.Tag);
end;

// Value parameters: the call takes the copies
routine Take2(A: TRes; B: TRes);
begin
  println("take {} {}", A.Tag, B.Tag);
end;

// An argument that raises while it is made
routine Bad(): TRes;
begin
  raise("bad arg");
end;

routine RunGood();
var
  LA: TRes;
  LC: TRes;
  LT: task;
begin
  LA.Tag := "a";
  LC.Tag := "c";
  LT := async Peek2(LA, LC);
  await LT;
  LT := nil;
end;

routine RunConst();
var
  LA: TRes;
  LB: TRes;
  LT: task;
begin
  LA.Tag := "a";
  LB.Tag := "bad";
  guard
    LT := async Peek2(LA, LB);
    await LT;
  except
    println("{}", "caught " + excmsg());
  end;
end;

routine RunTaken();
var
  LA: TRes;
  LB: TRes;
  LT: task;
begin
  LA.Tag := "a";
  LB.Tag := "bad";
  guard
    LT := async Take2(LA, LB);
    await LT;
  except
    println("{}", "caught " + excmsg());
  end;
end;

routine RunArg();
var
  LA: TRes;
  LT: task;
begin
  LA.Tag := "a";
  guard
    LT := async Peek2(LA, Bad());
    await LT;
  except
    println("{}", "caught " + excmsg());
  end;
end;

routine RunBlock();
var
  LA: TRes;
  LB: TRes;
  LT: task;
begin
  LA.Tag := "a";
  LB.Tag := "bad";
  guard
    LT := async begin
      println("block {} {}", LA.Tag, LB.Tag);
    end;
    await LT;
  except
    println("{}", "caught " + excmsg());
  end;
end;

begin
  RunGood();
  RunConst();
  RunTaken();
  RunArg();
  RunBlock();
  println("ends {}", Ends);
end.
