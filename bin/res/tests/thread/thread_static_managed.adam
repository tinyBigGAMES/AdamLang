-------------------------------------------------------------------------------
  thread_static_managed.adam - Threads: threadstatic variables of managed
  types (PLAN-ADAM H4t3, BNF sec 3): a string, a wstring, a dynamic array,
  a ref and a record holding a string. Every thread's copy starts at its
  constant initializer (a literal's text) or zero ("" and nil); four
  threads (ThreadStart) each find that start, then set new values. Each
  thread's copies are released as it ends (the exe's thread callback), so
  each thread's object has ended (its done counted: 4) before the joins
  return; main's copies keep their start meanwhile and are released at the
  program's end, so nothing leaks (Leaked 0).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | thread 0 started start [] 0 4 0 nil
  | thread 1 started start [] 0 4 0 nil
  | thread 2 started start [] 0 4 0 nil
  | thread 3 started start [] 0 4 0 nil
  | thread 0 kept name 0 [pair 0] 1 100
  | thread 1 kept name 1 [pair 1] 2 101
  | thread 2 kept name 2 [pair 2] 3 102
  | thread 3 kept name 3 [pair 3] 4 103
  | ended 4
  | main started start [] 0 4 0 nil
  | main kept name 9 [pair 9] 10 109
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_static_managed;

import System.SysUtils, System.Runtime;

var
  // How many Box objects have ended (their done), on any thread
  GEnded: int32;

type
  // A record holding a managed field
  Pair = record
    Name: string;
    Count: int32;
  end;

  // An object whose end is counted: a thread's box is released with its copies
  Box = object
    Value: int64;

    done;
    begin
      atomicadd(GEnded, 1);
    end;
  end;

threadstatic
  GName: string = "start";
  GWide: wstring = "wide";
  GNumbers: array of int32;
  GBox: ref Box;
  GPair: Pair;

var
  // Each thread's index (its argument points at its own element) and handle, and what
  // it found in its copies at its start and kept in them at its end
  GIndex: array[0..3] of int64;
  GThreads: array[0..3] of ptr;
  GStarted: array[0..3] of string;
  GKept: array[0..3] of string;

// The calling thread's copies as they start: the name, the pair's name and count, the
// wide text's units, the numbers' length, and whether the box is nil
func Started(): string;
var
  LBox: string;
begin
  LBox := "box";
  if GBox = nil then
    LBox := "nil";
  end;
  return GName + " [" + GPair.Name + "] " + IntToStr(GPair.Count) + " " + IntToStr(len(GWide)) +
    " " + IntToStr(len(GNumbers)) + " " + LBox;
end;

// The calling thread's copies given new values from AIndex: a new name and pair name, the
// numbers' length AIndex + 1, a new box holding 100 + AIndex
func Fill(const AIndex: int64);
begin
  GName := "name " + IntToStr(AIndex);
  GPair.Name := "pair " + IntToStr(AIndex);
  setlength(GNumbers, AIndex + 1);
  GBox := ref Box;
  GBox.Value := 100 + AIndex;
end;

// The calling thread's copies after Fill: the name, the pair's name, the numbers' length
// and the box's value
func Kept(): string;
begin
  return GName + " [" + GPair.Name + "] " + IntToStr(len(GNumbers)) + " " + IntToStr(GBox.Value);
end;

// One thread's work; AArg points at its index in GIndex
func Worker(const AArg: ptr);
var
  LIndex: ptr to int64;
begin
  LIndex := ptr to int64(AArg);
  GStarted[LIndex^] := Started();
  Fill(LIndex^);
  GKept[LIndex^] := Kept();
end;

var
  LI: int32;
begin
  for LI := 0 to 3 do
    GIndex[LI] := LI;
  end;
  for LI := 0 to 3 do
    GThreads[LI] := ThreadStart(Worker, ptr(addr of GIndex[LI]));
  end;
  for LI := 0 to 3 do
    ThreadJoin(GThreads[LI]);
  end;
  for LI := 0 to 3 do
    println("{}", "thread " + IntToStr(LI) + " started " + GStarted[LI]);
  end;
  for LI := 0 to 3 do
    println("{}", "thread " + IntToStr(LI) + " kept " + GKept[LI]);
  end;
  println("{}", "ended " + IntToStr(GEnded));
  println("{}", "main started " + Started());
  Fill(9);
  println("{}", "main kept " + Kept());
end.
