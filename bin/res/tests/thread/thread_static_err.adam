-------------------------------------------------------------------------------
  thread_static_err.adam - Break step of thread_static (BNF sec 3, PLAN-ADAM
  H4t1): what a threadstatic variable cannot be. External, given init
  arguments, or an object value is SM0700 at its name; an initializer that
  is no constant is SM0202 at the initializer; a threadstatic block inside
  a body is PR0057 at the word (its variable stays the body's own).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe thread_static_err;

type
  // An object held by value: built once, at the program's start
  Box = object
    Value: int32;
  end;

// A value known only at run time
func Seed(): int64;
begin
  return 3;
end;

threadstatic
  GOut: int32; external "ucrtbase"; // ERROR SM0700@3: threadstatic 'GOut' cannot be external: each thread starts with its own copy of a constant
  GBuilt: int32(1); // ERROR SM0700@3: threadstatic 'GBuilt' cannot be given init arguments: each thread starts with its own copy of a constant
  GBox: Box; // ERROR SM0700@3: threadstatic 'GBox' cannot be an object or interface value (a ref, own or weak holds one): each thread starts with its own copy of a constant
  GLate: int64 = Seed(); // ERROR SM0202@18: a threadstatic variable's initializer must be a constant

begin
  threadstatic LLocal: int32; // ERROR PR0057@3: 'threadstatic' stands only at module level: a body's own declarations are its own
  begin
    LLocal := 1;
  end;
end.
