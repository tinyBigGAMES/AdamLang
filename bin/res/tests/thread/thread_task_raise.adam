-------------------------------------------------------------------------------
  thread_task_raise.adam - Tasks (BNF sec 6 await, PLAN-ADAM H4t4): a raise
  of a task's call is raised again by each await of it: a guarded await is
  caught, a second one too, and a third nothing catches ends the program as
  the call's own raise would (`unhandled exception 1: <its text>` on stderr,
  exit code 1), its code and text kept by the task. The frames unwind to the
  entry's catch, so the task is released, and the end runs the exit
  handlers (BNF sec 1): the heap report prints, nothing leaked.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 1
  | start
  | caught
  | caught again
  | unhandled exception 1: boom one
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_task_raise;

// A call that raises on its task's thread
routine Boom(const AText: string): int64;
begin
  raise("boom " + AText);
end;

var
  LBoom: task int64;
  LValue: int64;
begin
  println("start");
  LBoom := async Boom("one");
  guard
    LValue := await LBoom;
    println("never");
  except
    println("caught");
  end;
  guard
    LValue := await LBoom;
  except
    println("caught again");
  end;
  LValue := await LBoom;
  println("never");
end.
