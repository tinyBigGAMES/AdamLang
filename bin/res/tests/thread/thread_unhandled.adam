-------------------------------------------------------------------------------
  thread_unhandled.adam - Threads: a raise nothing catches in a started
  thread (PLAN-ADAM H4t2b) ends the program as on the main thread: the
  thread's own catching scope (the runtime's ThreadRun) reports the thread's
  own raise, `unhandled exception 1: <text>` on stderr after what was
  printed, and the process ends with exit code 1 while main waits in
  ThreadJoin (its next line never prints). Main's own raise, caught before
  the thread starts, is not the one reported. The end runs the exit
  handlers (BNF sec 1), so the heap report prints: main never returns from
  ThreadJoin, so what it holds is leaked: its program block's two string
  temporaries (IntToStr's text and the concatenation, released at the
  block's end) and the started thread's block (freed by the join).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 1
  | start
  | main caught
  | unhandled exception 1: from the thread
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 3
@@end
*/

module exe thread_unhandled;

import System.SysUtils, System.Runtime;

// The thread's entry: a raise nothing in it catches
routine Worker(const AArg: ptr);
begin
  raise("from the " + "thread");
end;

var
  LThread: ptr;
begin
  println("start");
  guard
    raise("main " + IntToStr(1));
  except
    println("main caught");
  end;
  LThread := ThreadStart(Worker, nil);
  ThreadJoin(LThread);
  println("never");
end.
