-------------------------------------------------------------------------------
  thread_async_block.adam - async blocks (BNF sec 6, PLAN-ADAM T4): the
  routine's variables, parameters and record the block reads are copied at
  the async (the block, held until the routine changed them, still sees the
  old values); a block returned from its routine runs after the routine has
  ended, over a statement local, a for over its own iterator and a leave; a
  folded constant is read as it is; a value object is copied at the async
  and its copy ended with the task; a raise in the block is raised again by
  await; cancelled() in the block is its own task's flag; a for parallel and
  an async block inside a block read the block's copies. Nothing leaked.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | copy 7 first 1 2
  | after 8 second 3
  | outlived hi!hi!
  | init 1
  | copy 101
  | item 101
  | done 101
  | items end
  | done 1
  | raised block boom
  | cancelled true
  | nested 1055
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe thread_async_block;

var
  // Lets a block go on once the routine has changed what it copied
  GGo: int64;
  // What the blocks add up
  GSum: int64;
  // Written by a block that outlives its routine
  GText: string;
  // The items made so far
  Counter: int64;

type
  TPair = record
    X: int64;
    Y: int64;
  end;

  // An object whose init, copy and done say so
  TItem = object
    Id: int64;

    init();
    begin
      Counter := Counter + 1;
      self.Id := Counter;
      println("init {}", self.Id);
    end;

    copy(const ASource: TItem);
    begin
      self.Id := ASource.Id + 100;
      println("copy {}", self.Id);
    end;

    done;
    begin
      println("done {}", self.Id);
    end;
  end;

// The block's copies are taken at the async: what the routine writes after is not seen
routine Copies();
var
  LCount: int64;
  LName: string;
  LPair: TPair;
  LTask: task;
begin
  LCount := 7;
  LName := "fir" + "st";
  LPair.X := 1;
  LPair.Y := 2;
  LTask := async begin
    while atomicload(GGo) = 0 do
    end;
    println("copy {} {} {} {}", LCount, LName, LPair.X, LPair.Y);
  end;
  LCount := 8;
  LName := "sec" + "ond";
  LPair.X := 3;
  atomicstore(GGo, 1);
  await LTask;
  println("after {} {} {}", LCount, LName, LPair.X);
end;

// A block that runs on after its routine returned: its parameter and local are copies
routine Start(const AText: string; const ACount: int64): task;
var
  LText: string;
begin
  LText := AText + "!";
  return async begin
    var LI: int64;
    GText := "";
    for LI := 1 to ACount do
      GText := GText + LText;
      if LI = 2 then
        leave;
      end;
    end;
  end;
end;

// A value object is copied into the task at the async; the task's end ends the copy
routine Items();
var
  LItem: TItem;
  LTask: task;
begin
  LTask := async begin
    println("item {}", LItem.Id);
  end;
  await LTask;
  LTask := nil;
  println("items end");
end;

// A raise of the block, a cancel of its task
routine Ends();
var
  LTask: task;
begin
  LTask := async begin
    raise("block boom");
  end;
  guard
    await LTask;
  except
    println("raised {}", excmsg());
  end;
  LTask := async begin
    while not cancelled() do
    end;
    println("cancelled {}", cancelled());
  end;
  cancel(LTask);
  await LTask;
end;

// A for parallel and an async block inside a block read the block's copies; a folded
// constant is read as it is
routine Nested();
var
  LLimit: int64;
  LTask: task;
begin
  LLimit := 10;
  const LScale: int64 = 100;
  LTask := async begin
    var LIn: task;
    for parallel I := 1 to LLimit do
      atomicadd(GSum, I);
    end;
    LIn := async begin
      atomicadd(GSum, LLimit * LScale);
    end;
    await LIn;
  end;
  await LTask;
  println("nested {}", GSum);
end;

var
  LOut: task;
begin
  Counter := 0;
  GGo := 0;
  GSum := 0;
  Copies();
  LOut := Start("hi", 5);
  await LOut;
  println("outlived {}", GText);
  Items();
  Ends();
  Nested();
end.
