-------------------------------------------------------------------------------
  json_walk.adam - System.Json's walks and edits (PLAN-ADAM J3): Keys,
  Items walked by for .. in (an array's items, an object's values),
  Pairs, ForEach with its user pointer; a view's change seen through
  the root (one shared tree), a view outliving the Json it came from;
  Remove, Merge (a key replaced, one added, a non-object ignored), Clone
  (its own tree: a change to it not seen in the original). The [Heap] line
  shows every yyjson block freed with the last view.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | keys a,b,c
  | items 1 2 3
  | values 1 [2] {"x":3}
  | pairs a=1 b=[2] c={"x":3}
  | foreach 6 3
  | view {"a":1,"b":[2,9],"c":{"x":3,"y":true}}
  | outlived {"x":5}
  | remove {"a":1,"c":{"x":3,"y":true}} 2
  | merge {"a":7,"c":{"x":3,"y":true},"d":"new"}
  | merge ignored {"a":7,"c":{"x":3,"y":true},"d":"new"}
  | clone {"a":7,"c":{"x":3,"y":true},"d":"new","e":0} {"a":7,"c":{"x":3,"y":true},"d":"new"}
  | clone missing true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe json_walk;

import System.SysUtils, System.Json;

// ForEach's callback: AItem's number added to the int64 at AUserData
routine SumItem(const AItem: Json; const AUserData: ptr);
var
  LSum: ptr to int64;
begin
  LSum := ptr to int64(AUserData);
  LSum^ := LSum^ + AItem.AsInt64(0);
end;

// A view of a nested object of a Json that ends here
routine MakeView(): Json;
var
  LRoot: Json;
begin
  LRoot.BeginObject("a").Add("x", 5).EndObject();
  return LRoot.Get("a");
end;

var
  LDoc: Json;
  LItem: Json;
  LView: Json;
  LOther: Json;
  LCopy: Json;
  LList: Json;
  LText: string;
  LPairs: array of JsonPair;
  LI: int64;
  LSum: int64;
begin
  LDoc.Parse("{\"a\":1,\"b\":[2],\"c\":{\"x\":3}}");
  println("keys {}", JoinStrings(LDoc.Keys(), ","));
  LList.Parse("[1,2,3]");
  LText := "items";
  for LItem in LList.Items() do
    LText := LText + " " + LItem.AsString("");
  end;
  println("{}", LText);
  LText := "values";
  for LItem in LDoc.Items() do
    LText := LText + " " + LItem.ToString();
  end;
  println("{}", LText);
  LPairs := LDoc.Pairs();
  LText := "pairs";
  for LI := 0 to len(LPairs) - 1 do
    LText := LText + " " + LPairs[LI].NodeName + "=" + LPairs[LI].Value.ToString();
  end;
  println("{}", LText);
  LSum := 0;
  LList.ForEach(SumItem, addr of LSum);
  println("foreach {} {}", LSum, LList.Count());

  // A view changes the shared tree
  LView := LDoc.Get("b");
  LView.Add(9);
  LDoc.Get("c").Add("y", true);
  println("view {}", LDoc.ToString());
  println("outlived {}", MakeView().ToString());

  LDoc.Remove("b").Remove("none");
  println("remove {} {}", LDoc.ToString(), LDoc.Count());
  LOther.Parse("{\"a\":7,\"d\":\"new\"}");
  LDoc.Merge(LOther);
  println("merge {}", LDoc.ToString());
  LDoc.Merge(LList).Merge(LDoc.Get("none"));
  println("merge ignored {}", LDoc.ToString());
  LCopy := LDoc.Clone();
  LCopy.Add("e", 0);
  println("clone {} {}", LCopy.ToString(), LDoc.ToString());
  println("clone missing {}", LDoc.Get("none").Clone().IsNull());
end.
