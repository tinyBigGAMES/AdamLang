  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  json_build.adam - System.Json's builder (PLAN-ADAM J3): a plain Json is an
  empty object; AddString / AddInt / AddFloat / AddBool / AddJson /
  AddNull keyed into an object, AppendString .. AppendNull into an array, AddRaw (a bad text adds nothing), AddStrings /
  AddIntegers / AddDoubles, nested BeginObject / BeginArray / AppendObject closed by
  EndObject / EndArray (a chain on returned copies closes what it opened, an
  End of the wrong kind closes nothing), an Add that does not fit its
  container changes nothing, a Json added copied (later changes to it not
  seen), NaN written as null; ToString, ToPrettyString with 2, 4 and 0 spaces. The [Heap] line shows every yyjson block freed.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | fresh {} 0 true
  | flat {"name":"adam","n":3,"big":9000000000,"pi":0.5,"ok":false,"none":null}
  | nested {"a":{"b":[1,"two",true,null,{"c":2.5}]},"d":1}
  | wrong end {"x":[1]}
  | misfit {"k":[]}
  | raw {"r":{"q":[1,2]},"s":"x"}
  | lists {"s":["a","b"],"i":[1,-2],"f":[0.25]}
  | copy {"inner":{"v":1}} {"v":1,"w":2}
  | nan {"nan":null}
  | pretty2
  | {
  |   "a": {
  |     "b": [
  |       1,
  |       2
  |     ]
  |   },
  |   "e": {}
  | }
  | pretty4
  | {
  |     "a": {
  |         "b": [
  |             1,
  |             2
  |         ]
  |     },
  |     "e": {}
  | }
  | pretty0
  | {
  | "a": {
  | "b": [
  | 1,
  | 2
  | ]
  | },
  | "e": {}
  | }
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe json_build;

import System.SysUtils, System.Json;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LFresh: Json;
  LFlat: Json;
  LNested: Json;
  LWrong: Json;
  LMisfit: Json;
  LRaw: Json;
  LLists: Json;
  LInner: Json;
  LOuter: Json;
  LNan: Json;
  LPretty: Json;
  LStrings: StringArray;
  LInts: Int64Array;
  LReals: array of float64;
  LZero: float64;
begin
  println("fresh {} {} {}", LFresh.ToString(), LFresh.Count(), BoolText(LFresh.IsObject()));

  LFlat.AddString("name", "adam").AddInt("n", 3).AddInt("big", 9000000000).AddFloat("pi", 0.5);
  LFlat.AddBool("ok", false).AddNull("none");
  println("flat {}", LFlat.ToString());

  LNested.BeginObject("a").BeginArray("b").AppendInt(1).AppendString("two").AppendBool(true).AppendNull();
  LNested.AppendObject().AddFloat("c", 2.5).EndObject().EndArray().EndObject().AddInt("d", 1);
  println("nested {}", LNested.ToString());

  // EndObject while an array is open closes nothing: the 1 still goes into the array
  LWrong.BeginArray("x").EndObject().AppendInt(1).EndArray();
  println("wrong end {}", LWrong.ToString());

  // A keyed Add into an array and a bare one into the object change nothing
  LMisfit.BeginArray("k").AddInt("no", 1).EndArray().AppendInt(7);
  println("misfit {}", LMisfit.ToString());

  LRaw.AddRaw("r", "{\"q\":[1,2]}").AddRaw("bad", "{\"q\":").AddString("s", "x");
  println("raw {}", LRaw.ToString());

  setlength(LStrings, 2);
  LStrings[0] := "a";
  LStrings[1] := "b";
  setlength(LInts, 2);
  LInts[0] := 1;
  LInts[1] := -2;
  setlength(LReals, 1);
  LReals[0] := 0.25;
  LLists.AddStrings("s", LStrings).AddIntegers("i", LInts).AddDoubles("f", LReals);
  println("lists {}", LLists.ToString());

  LInner.AddInt("v", 1);
  LOuter.AddJson("inner", LInner);
  LInner.AddInt("w", 2);
  println("copy {} {}", LOuter.ToString(), LInner.ToString());

  LZero := 0.0;
  LNan.AddFloat("nan", LZero / LZero);
  println("nan {}", LNan.ToString());

  LPretty.BeginObject("a").BeginArray("b").AppendInt(1).AppendInt(2).EndArray().EndObject();
  LPretty.BeginObject("e").EndObject();
  println("pretty2");
  println("{}", LPretty.ToPrettyString(2));
  println("pretty4");
  println("{}", LPretty.ToPrettyString(4));
  println("pretty0");
  println("{}", LPretty.ToPrettyString(0));
end.
