-------------------------------------------------------------------------------
  json_hookio.adam - System.Json's file forms are hooked (PLAN-ADAM J3, his
  word 2026-11-18): SaveToFile / LoadFromFile / Json.FromFile go through
  yyjson's own C file calls, so with System.HookIO imported an io:// path
  writes and reads a registered IO (a memory IO: its size the text's) and
  an IOSource's entry (a folder source: the entry is a disk file, seen by
  System.IO); a missing entry fails with yyjson's reason. The [Heap] line
  shows every block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | memory save true size 17
  | memory load {"k":"v","n":[1]}
  | source save true on disk true
  | source load {"k":"v","n":[1]}
  | source missing true
  | closed true true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe json_hookio;

import System.SysUtils, System.IO, System.CustomIO, System.HookIO, System.Json;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LDoc: Json;
  LMemory: IO;
  LSource: IOSource;
  LPrefix: string;
  LSourcePrefix: string;
  LOk: bool;
begin
  LDoc.Add("k", "v").BeginArray("n").Add(1).EndArray();

  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  LOk := LDoc.SaveToFile(LPrefix + "/doc.json", false);
  println("memory save {} size {}", BoolText(LOk), IOSize(LMemory));
  println("memory load {}", Json.FromFile(LPrefix + "/doc.json").ToString());

  LSource := CreateFolderIOSource(".");
  LSourcePrefix := RegisterIOSource(LSource);
  LOk := LDoc.SaveToFile(LSourcePrefix + "/json_hookio_entry.json", true);
  println("source save {} on disk {}", BoolText(LOk), BoolText(FileExists("json_hookio_entry.json")));
  println("source load {}", Json.FromFile(LSourcePrefix + "/json_hookio_entry.json").ToString());
  println("source missing {}", BoolText(Json.FromFile(LSourcePrefix + "/json_hookio_none.json").IsNull()));

  println("closed {} {}", BoolText(UnregisterIO(LSourcePrefix) and IOSourceClose(LSource)),
    BoolText(UnregisterIO(LPrefix) and IOClose(LMemory)));
end.
