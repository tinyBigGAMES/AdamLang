-------------------------------------------------------------------------------
  json_hookio.adam - System.JSON.Ext's file forms are hooked (PLAN-ADAM J3, his
  word 2026-11-18): SaveToFile / LoadFromFile / Json.FromFile go through
  yyjson's own C file calls, so with System.HookIO imported an io:// path
  writes and reads a registered IO (a memory IO: its size the text's) and
  an IOSource's entry (a folder source: the entry is a disk file, seen by
  System.IO); a missing entry fails with yyjson's reason. With bin\assets.zip
  as this thread's path source (SetIOThreadPathSource) Json.FromFile reads
  res/assets/data/config.json by its own plain name, not resolved against
  the working folder (PLAN-XML JP1), and an entry the zip lacks is missing.
  The [Heap] line shows every block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | memory save true size 17
  | memory load {"k":"v","n":[1]}
  | source save true on disk true
  | source load {"k":"v","n":[1]}
  | source missing true
  | thread title PaskalCPP JSON config width 800 players 3 first Ada
  | thread missing true
  | closed true true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe json_hookio;

import System.SysUtils, System.IO, System.CustomIO, System.HookIO, System.JSON.Ext;

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

const
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";
  ASSETS_PASSWORD: string = "Adam";

var
  LDoc: Json;
  LConfig: Json;
  LZip: IOSource;
  LMemory: IO;
  LSource: IOSource;
  LPrefix: string;
  LSourcePrefix: string;
  LOk: bool;
begin
  LDoc.Add("k", "v").BeginArray("n").Add(1).EndArray();

  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  LOk := LDoc.SaveToFile(LPrefix + "/doc.json", false);
  println("memory save {} size {}", BoolText(LOk), IOSize(LMemory));
  println("memory load {}", Json.FromFile(LPrefix + "/doc.json").ToString());

  LSource := CreateFolderIOSource(".");
  LSourcePrefix := RegisterIOSource(LSource);
  LOk := LDoc.SaveToFile(LSourcePrefix + "/json_hookio_entry.json", true);
  println("source save {} on disk {}", BoolText(LOk), BoolText(FileExists("json_hookio_entry.json")));
  println("source load {}", Json.FromFile(LSourcePrefix + "/json_hookio_entry.json").ToString());
  println("source missing {}", BoolText(Json.FromFile(LSourcePrefix + "/json_hookio_none.json").IsNull()));

  // The zip as this thread's path source: an entry by its own plain name
  LZip := CreateZipIOSource(ASSETS_ZIP, ASSETS_PASSWORD);
  SetIOThreadPathSource(LZip);
  LConfig := Json.FromFile("res/assets/data/config.json");
  println("thread title {} width {} players {} first {}", LConfig.Get("title").AsString(),
    LConfig.Get("window.width").AsInt32(), LConfig.Get("players").Count(),
    LConfig.Get("players[0]").AsString());
  println("thread missing {}", BoolText(Json.FromFile("res/assets/data/none.json").IsNull()));
  SetIOThreadPathSource(nil);
  LConfig := Json.FromString("{}");

  println("closed {} {}", BoolText(UnregisterIO(LSourcePrefix) and IOSourceClose(LSource)),
    BoolText(UnregisterIO(LPrefix) and IOClose(LMemory) and IOSourceClose(LZip)));
end.
