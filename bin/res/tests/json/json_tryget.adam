-------------------------------------------------------------------------------
  json_tryget.adam - System.Json's literal paths and strict reads (PLAN-ADAM
  J3c, StdApp.JSON's Get / Has / TryGet* with ALiteral): Get / Has with a
  literal key ("a.b" one member, not a path; false on a non-object and on
  a fresh Json); TryGetString / TryGetInt32 / TryGetInt64 / TryGetBoolean
  / TryGetObject / TryGetArray true for their own kind only (a number is
  no string, "7" no number, 2.5 no whole number, a value past int32 no
  int32), AValue the kind's zero on a false, the object / array a view
  sharing the tree; each again with ALiteral. The [Heap] line shows every
  block freed.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | literal 1 2 true false true false
  | fresh false missing
  | string true x false [] false []
  | int32 true 7 false 0 false 0 false 0
  | int64 true 9000000000 true 1 true 2 false 0
  | bool true true false false
  | object true 1 false 0
  | array true 2 false 0
  | shared {"a.b":1,"a":{"b":2},"s":"x","n":7,"r":2.5,"t":"7","big":9000000000,"ok":true,"o":{"k":1,"new":5},"l":[1,2]}
  | lit true y true 3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe json_tryget;

import System.SysUtils, System.Json;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LDoc: Json;
  LFresh: Json;
  LView: Json;
  LText: string;
  LSmall: int32;
  LWide: int64;
  LFlag: bool;
  LOk: bool;
begin
  LDoc.Parse("{\"a.b\":1,\"a\":{\"b\":2},\"s\":\"x\",\"n\":7,\"r\":2.5,\"t\":\"7\",\"big\":9000000000,\"ok\":true,\"o\":{\"k\":1},\"l\":[1,2]}");
  println("literal {} {} {} {} {} {}", LDoc.Get("a.b", true).AsInt64(), LDoc.Get("a.b", false).AsInt64(),
    BoolText(LDoc.Has("a.b", true)), BoolText(LDoc.Has("l[0]", true)), BoolText(LDoc.Has("l[0]", false)),
    BoolText(LDoc.Get("l").Has("0", true)));
  println("fresh {} {}", BoolText(LFresh.Has("x", true)), LFresh.Get("x", true).AsString("missing"));

  LOk := LDoc.TryGetString("s", LText);
  print("string {} {}", BoolText(LOk), LText);
  LOk := LDoc.TryGetString("n", LText);
  print(" {} [{}]", BoolText(LOk), LText);
  LOk := LDoc.TryGetString("zz", LText);
  println(" {} [{}]", BoolText(LOk), LText);

  LOk := LDoc.TryGetInt32("n", LSmall);
  print("int32 {} {}", BoolText(LOk), LSmall);
  LOk := LDoc.TryGetInt32("big", LSmall);
  print(" {} {}", BoolText(LOk), LSmall);
  LOk := LDoc.TryGetInt32("r", LSmall);
  print(" {} {}", BoolText(LOk), LSmall);
  LOk := LDoc.TryGetInt32("t", LSmall);
  println(" {} {}", BoolText(LOk), LSmall);

  LOk := LDoc.TryGetInt64("big", LWide);
  print("int64 {} {}", BoolText(LOk), LWide);
  LOk := LDoc.TryGetInt64("a.b", LWide, true);
  print(" {} {}", BoolText(LOk), LWide);
  LOk := LDoc.TryGetInt64("a.b", LWide, false);
  print(" {} {}", BoolText(LOk), LWide);
  LOk := LDoc.TryGetInt64("ok", LWide);
  println(" {} {}", BoolText(LOk), LWide);

  LOk := LDoc.TryGetBoolean("ok", LFlag);
  print("bool {} {}", BoolText(LOk), BoolText(LFlag));
  LOk := LDoc.TryGetBoolean("n", LFlag);
  println(" {} {}", BoolText(LOk), BoolText(LFlag));

  LOk := LDoc.TryGetObject("o", LView);
  print("object {} {}", BoolText(LOk), LView.Count());
  LView.Add("new", 5);
  LOk := LDoc.TryGetObject("l", LView);
  println(" {} {}", BoolText(LOk), LView.Count());

  LOk := LDoc.TryGetArray("l", LView);
  print("array {} {}", BoolText(LOk), LView.Count());
  LOk := LDoc.TryGetArray("o", LView);
  println(" {} {}", BoolText(LOk), LView.Count());

  println("shared {}", LDoc.ToString());

  LDoc.Add("x.y", "y");
  LOk := LDoc.TryGetString("x.y", LText, true);
  print("lit {} {}", BoolText(LOk), LText);
  LDoc.BeginObject("p.q").Add("r", 3).EndObject();
  LOk := LDoc.TryGetObject("p.q", LView, true);
  println(" {} {}", BoolText(LOk), LView.Get("r").AsInt64());
end.
