-------------------------------------------------------------------------------
  json_overload.adam - System.JSON's overloaded surface (PLAN-ADAM J3b, on
  MO1's method overloads): Add(key, value) picked by the value's type (a
  string, an int literal, an int64 / uint32 / uint64 variable (the
  largest uint64 kept exact), a float64, a bool, a Json),
  Add(value) of each kind and AddNull() into an array, the bare
  BeginObject() / BeginArray() in an array; Contains of a string and of a
  whole number; every As*() form (a present value, then a missing one: the
  kind's zero value) beside As*(ADefault); ToPrettyString() = the 2-space
  form; SaveToFile(path) and SaveToIO(io) write pretty (the text equal to
  ToPrettyString()), their (.., false) forms compact. The [Heap] line shows
  every block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | keyed {"s":"x","i":3,"w":9000000000,"u":18446744073709551615,"f":0.5,"b":true,"z":null,"sub":{"v":1}}
  | bare ["t",7,5,1.5,false,null,{"k":1},[2,{"v":1}]]
  | contains true true false false
  | present x 3 3 3 3 0.5 0.5 true
  | zero [] 0 0 0 0 0 0 false
  | defaults d -1 -2 5 6 2.5 1.5 true
  | pretty true
  | file true true
  | io true true true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe json_overload;

import System.SysUtils, System.IO, System.CustomIO, System.JSON;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LDoc: Json;
  LSub: Json;
  LList: Json;
  LNone: Json;
  LWide: int64;
  LBig: uint64;
  LCount: uint32;
  LText: string;
  LMemory: IO;
  LOk: bool;
begin
  LWide := 9000000000;
  LBig := ~uint64(0);
  LCount := 5;
  LSub.Add("v", 1);
  LDoc.Add("s", "x").Add("i", 3).Add("w", LWide).Add("u", LBig).Add("f", 0.5).Add("b", true).AddNull("z").Add("sub", LSub);
  println("keyed {}", LDoc.ToString());

  LList.BeginArray("a").Add("t").Add(7).Add(LCount).Add(1.5).Add(false).AddNull();
  LList.BeginObject().Add("k", 1).EndObject().BeginArray().Add(2).Add(LSub).EndArray().EndArray();
  println("bare {}", LList.Get("a").ToString());

  println("contains {} {} {} {}", BoolText(LList.Get("a").Contains("t")), BoolText(LList.Get("a").Contains(7)),
    BoolText(LList.Get("a").Contains("u")), BoolText(LList.Get("a").Contains(8)));

  println("present {} {} {} {} {} {} {} {}", LDoc.Get("s").AsString(), LDoc.Get("i").AsInt64(), LDoc.Get("i").AsInt32(),
    LDoc.Get("i").AsUInt64(), LDoc.Get("i").AsUInt32(), FloatToStr(LDoc.Get("f").AsDouble()),
    FloatToStr(float64(LDoc.Get("f").AsSingle())), BoolText(LDoc.Get("b").AsBoolean()));
  LNone := LDoc.Get("nope");
  println("zero [{}] {} {} {} {} {} {} {}", LNone.AsString(), LNone.AsInt64(), LNone.AsInt32(), LNone.AsUInt64(),
    LNone.AsUInt32(), FloatToStr(LNone.AsDouble()), FloatToStr(float64(LNone.AsSingle())), BoolText(LNone.AsBoolean()));
  println("defaults {} {} {} {} {} {} {} {}", LNone.AsString("d"), LNone.AsInt64(-1), LNone.AsInt32(-2), LNone.AsUInt64(5),
    LNone.AsUInt32(6), FloatToStr(LNone.AsDouble(2.5)), FloatToStr(float64(LNone.AsSingle(1.5))), BoolText(LNone.AsBoolean(true)));

  println("pretty {}", BoolText(LDoc.ToPrettyString() = LDoc.ToPrettyString(2)));

  LOk := LDoc.SaveToFile("json_overload_pretty.json");
  ReadAllText("json_overload_pretty.json", LText);
  println("file {} {}", BoolText(LOk and (LText = LDoc.ToPrettyString())),
    BoolText(LDoc.SaveToFile("json_overload_compact.json", false) and ReadAllText("json_overload_compact.json", LText) and
    (LText = LDoc.ToString())));

  LMemory := CreateMemoryIO();
  LOk := LDoc.SaveToIO(LMemory);
  IOSeek(LMemory, 0, SeekOrigin.FromStart);
  IOReadAll(LMemory, LText);
  println("io {} {} {}", BoolText(LOk), BoolText(LText = LDoc.ToPrettyString()),
    BoolText(Json.FromIO(LMemory).ToString() = "null"));
  IOClose(LMemory);
end.
