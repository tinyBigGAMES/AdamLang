-------------------------------------------------------------------------------
  json_read.adam - System.JSON.Ext's readers (PLAN-ADAM J3, J3b): Parse, then Get /
  Has by path (keys, items, [N] first, a "quoted" key with a dot and an
  escaped quote, the empty path, a path that names nothing, a malformed
  one), the As* getters on every kind (a string
  read as a number, a real truncated, a value past the type's range, the
  string "TRUE" as a boolean), the As*Array forms, the Is* tests, Count /
  First / Last / Contains (a string, a whole number); the failures: a bad text placed at its line and
  column (Parse false, JSON.FromString a missing value with the same
  ErrorText; JSON.TryFromString true / false, J3d), a missing value read. The [Heap] line shows every yyjson
  block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | parse true []
  | paths adam 2 30 x
  | items 7 9 c
  | quoted 1 2
  | self 9
  | missing true 0 dflt -1 false
  | malformed true true true
  | has true true false false
  | ints 3 -4 7 -7 12 0 99
  | range 0 5 0 5 4294967295 9000000000 18446744073709551615 0
  | reals 0.5 2 12.5 0
  | bools true true false true false
  | strings 7 0.5 true [7,8] {"y":"x"} dflt
  | arrays a,7,true 1,2,3 1,2,3 0.5,2,3
  | kinds true true true true true true
  | kinds missing true false false
  | count 17 3 0 0
  | first 1 3 true
  | contains true false true false false
  | bad false <text>(2,7): unexpected character, expected a JSON value
  | bad from false true <text>(2,7): unexpected character, expected a JSON value
  | try true 5 false true <text>(1,2): unexpected end of data
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe json_read;

import System.SysUtils, System.JSON.Ext;

const
  TEXT: string = "{\"name\":\"adam\",\"tags\":[\"a\",7,true],\"server\":{\"ports\":[80,2,30],\"host\":\"x\"},\"grid\":[[7,8],[9,\"c\"]],\"a.b\":{\"q\\\"\":2},\"n\":3,\"neg\":-4,\"r\":0.5,\"s\":\"12\",\"t\":\"TRUE\",\"big\":9000000000,\"u\":18446744073709551615,\"nul\":null,\"o\":{\"y\":\"x\"},\"real\":12.5,\"list\":[1,2,3],\"reals\":[0.5,2,3]}";

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// An array's items as text, for JoinStrings
func DoInts(const AJSON: JSON): StringArray;
var
  LValues: array of int32;
  LText: StringArray;
  LI: int64;
begin
  LValues := AJSON.AsInt32Array();
  setlength(LText, len(LValues));
  for LI := 0 to len(LValues) - 1 do
    LText[LI] := IntToStr(int64(LValues[LI]));
  end;
  return LText;
end;

func DoInt64s(const AJSON: JSON): StringArray;
var
  LValues: Int64Array;
  LText: StringArray;
  LI: int64;
begin
  LValues := AJSON.AsInt64Array();
  setlength(LText, len(LValues));
  for LI := 0 to len(LValues) - 1 do
    LText[LI] := IntToStr(LValues[LI]);
  end;
  return LText;
end;

func DoReals(const AJSON: JSON): StringArray;
var
  LValues: array of float64;
  LText: StringArray;
  LI: int64;
begin
  LValues := AJSON.AsDoubleArray();
  setlength(LText, len(LValues));
  for LI := 0 to len(LValues) - 1 do
    LText[LI] := FloatToStr(LValues[LI]);
  end;
  return LText;
end;

var
  LDoc: JSON;
  LBad: JSON;
  LFrom: JSON;
  LTry: JSON;
  LOk: bool;
  LTryBad: bool;
begin
  LOk := LDoc.Parse(TEXT);
  println("parse {} [{}]", BoolText(LOk), LDoc.ErrorText());
  println("paths {} {} {} {}", LDoc.Get("name").AsString(""), LDoc.Get("server.ports[1]").AsInt64(0),
    LDoc.Get("server").Get("ports[2]").AsInt64(0), LDoc.Get("server.host").AsString(""));
  println("items {} {} {}", LDoc.Get("grid[0][0]").AsInt64(0), LDoc.Get("grid[1][0]").AsInt64(0),
    LDoc.Get("grid").Get("[1][1]").AsString(""));
  println("quoted {} {}", LDoc.Get("\"a.b\"").Count(), LDoc.Get("\"a.b\".\"q\\\"\"").AsInt64(0));
  println("self {}", LDoc.Get("grid[1]").Get("").Get("[0]").AsInt64(0));
  println("missing {} {} {} {} {}", BoolText(LDoc.Get("nope.x").IsNull()), LDoc.Get("nope").Count(),
    LDoc.Get("nope").AsString("dflt"), LDoc.Get("server.ports[3]").AsInt64(-1),
    BoolText(LDoc.Get("tags[-1]").Has("")));
  println("malformed {} {} {}", BoolText(LDoc.Get("server.").IsNull()), BoolText(LDoc.Get("grid[x]").IsNull()),
    BoolText(LDoc.Get("\"open").IsNull()));
  println("has {} {} {} {}", BoolText(LDoc.Has("server.ports[2]")), BoolText(LDoc.Has("")),
    BoolText(LDoc.Has("server.ports[3]")), BoolText(LDoc.Has("name.x")));
  println("ints {} {} {} {} {} {} {}", LDoc.Get("n").AsInt32(0), LDoc.Get("neg").AsInt64(0), LDoc.Get("tags[1]").AsInt32(0),
    LDoc.Get("tags[1]").AsInt32(0) * -1, LDoc.Get("s").AsInt64(0), LDoc.Get("r").AsInt64(0), LDoc.Get("o").AsInt64(99));
  println("range {} {} {} {} {} {} {} {}", LDoc.Get("big").AsInt32(0), LDoc.Get("big").AsInt32(5), LDoc.Get("neg").AsUInt32(0),
    LDoc.Get("neg").AsUInt64(5), LDoc.Get("u").AsUInt32(4294967295), LDoc.Get("big").AsUInt64(0),
    LDoc.Get("u").AsUInt64(0), LDoc.Get("u").AsInt64(0));
  println("reals {} {} {} {}", FloatToStr(LDoc.Get("r").AsDouble(0.0)), FloatToStr(LDoc.Get("tags[1]").AsDouble(0.0) - 5.0),
    FloatToStr(float64(LDoc.Get("real").AsSingle(0.0))), FloatToStr(LDoc.Get("name").AsDouble(0.0)));
  println("bools {} {} {} {} {}", BoolText(LDoc.Get("tags[2]").AsBoolean(false)), BoolText(LDoc.Get("t").AsBoolean(false)),
    BoolText(LDoc.Get("r").AsBoolean(false) and false), BoolText(LDoc.Get("n").AsBoolean(false)), BoolText(LDoc.Get("name").AsBoolean(false)));
  println("strings {} {} {} {} {} {}", LDoc.Get("tags[1]").AsString(""), LDoc.Get("r").AsString(""), LDoc.Get("tags[2]").AsString(""),
    LDoc.Get("grid[0]").AsString(""), LDoc.Get("o").AsString(""), LDoc.Get("nul").AsString("dflt"));
  println("arrays {} {} {} {}", JoinStrings(LDoc.Get("tags").AsStringArray(), ","),
    JoinStrings(DoInts(LDoc.Get("list")), ","), JoinStrings(DoInt64s(LDoc.Get("list")), ","),
    JoinStrings(DoReals(LDoc.Get("reals")), ","));
  println("kinds {} {} {} {} {} {}", BoolText(LDoc.Get("nul").IsNull()), BoolText(LDoc.Get("o").IsObject()),
    BoolText(LDoc.Get("list").IsArray()), BoolText(LDoc.Get("r").IsNumber()), BoolText(LDoc.Get("s").IsString()),
    BoolText(LDoc.Get("tags[2]").IsBoolean()));
  println("kinds missing {} {} {}", BoolText(LDoc.Get("zz").IsNull()), BoolText(LDoc.Get("zz").IsObject()),
    BoolText(LDoc.Get("zz").IsArray()));
  println("count {} {} {} {}", LDoc.Count(), LDoc.Get("tags").Count(), LDoc.Get("n").Count(),
    LDoc.Get("zz").Count());
  println("first {} {} {}", LDoc.Get("list").First().AsInt64(0), LDoc.Get("list").Last().AsInt64(0),
    BoolText(LDoc.Get("o").First().IsNull()));
  println("contains {} {} {} {} {}", BoolText(LDoc.Get("tags").Contains("a")), BoolText(LDoc.Get("tags").Contains("b")),
    BoolText(LDoc.Get("tags").Contains(7)), BoolText(LDoc.Get("tags").Contains(8)),
    BoolText(LDoc.Get("o").Contains("x")));
  LOk := LBad.Parse("{\"a\":1,\n \"b\": ]");
  println("bad {} {}", BoolText(LOk), LBad.ErrorText());
  LFrom := JSON.FromString("{\"a\":1,\n \"b\": ]");
  println("bad from {} {} {}", BoolText(LFrom.Has("a")), BoolText(LFrom.IsNull()), LFrom.ErrorText());
  LOk := JSON.TryFromString("{\"k\":5}", LTry);
  LTryBad := JSON.TryFromString("{", LFrom);
  println("try {} {} {} {} {}", BoolText(LOk), LTry.Get("k").AsInt64(), BoolText(LTryBad),
    BoolText(LFrom.IsNull()), LFrom.ErrorText());
end.
