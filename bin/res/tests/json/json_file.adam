-------------------------------------------------------------------------------
  json_file.adam - System.JSON.Ext's files and IOs (PLAN-ADAM J3, J3b): a value
  saved pretty and compact by SaveToFile and read back by LoadFromFile /
  JSON.FromFile (a view saves its own subtree), written to a memory IO by
  SaveToIO and read back from its start by JSON.FromIO; the
  failures: a missing file (ErrorText with yyjson's reason), a folder that
  does not exist to save into, a missing value saved, an IO holding no
  valid JSON (placed as "<io>(line,col)"), no IO. The [Heap] line
  shows every block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | save true true
  | pretty {"a":1,"b":[true,null]}
  | compact {"a":1,"b":[true,null]} 23
  | view [true,null]
  | io true {"a":1,"b":[true,null]}
  | missing false json_file_none.json: the file cannot be opened
  | save fails false false
  | bad io false <io>(1,4): unexpected end of data
  | no io false <io>: no IO
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe json_file;

import System.SysUtils, System.IO, System.CustomIO, System.JSON.Ext;

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LDoc: JSON;
  LBack: JSON;
  LText: string;
  LMemory: IO;
  LOk: bool;
begin
  LDoc.Add("a", 1).BeginArray("b").Add(true).AddNull().EndArray();
  println("save {} {}", BoolText(LDoc.SaveToFile("json_file_pretty.json", true)),
    BoolText(LDoc.SaveToFile("json_file_compact.json", false)));
  println("pretty {}", JSON.FromFile("json_file_pretty.json").ToString());
  LOk := LBack.LoadFromFile("json_file_compact.json");
  ReadAllText("json_file_compact.json", LText);
  println("compact {} {}", LBack.ToString(), len(LText));
  LDoc.Get("b").SaveToFile("json_file_view.json", false);
  println("view {}", JSON.FromFile("json_file_view.json").ToString());

  LMemory := CreateMemoryIO();
  LOk := LDoc.SaveToIO(LMemory, true);
  IOSeek(LMemory, 0, SeekOrigin.FromStart);
  println("io {} {}", BoolText(LOk), JSON.FromIO(LMemory).ToString());
  IOClose(LMemory);

  LOk := LBack.LoadFromFile("json_file_none.json");
  println("missing {} {}", BoolText(LOk), LBack.ErrorText());
  println("save fails {} {}", BoolText(LDoc.SaveToFile("json_file_no_dir/x.json", true)),
    BoolText(LDoc.Get("zz").SaveToFile("json_file_zz.json", true)));

  LMemory := CreateMemoryIO();
  LText := "[1,";
  IOWriteFull(LMemory, addr of LText[0], len(LText));
  IOSeek(LMemory, 0, SeekOrigin.FromStart);
  LOk := LBack.LoadFromIO(LMemory);
  println("bad io {} {}", BoolText(LOk), LBack.ErrorText());
  IOClose(LMemory);
  LMemory := nil;
  LOk := LBack.LoadFromIO(LMemory);
  println("no io {} {}", BoolText(LOk), LBack.ErrorText());
end.
