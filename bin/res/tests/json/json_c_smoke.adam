-------------------------------------------------------------------------------
  json_c_smoke.adam - System.JSON.C over libyyjson.a (res/libs/vendor): a
  document parsed by yyjson_read, each value kind read through the inline
  routines System.JSON.C translates (the type names by yyjson_get_type_desc's
  switch, a string compared by yyjson_equals_str over libc.a's strlen /
  memcmp, an array walked by index and an object by its iterator: the
  const-dropping pointer step of unsafe_yyjson_get_next), a mutable copy
  edited (values made by unsafe_yyjson_mut_val's pool step `p += n`, a key
  removed), written into a fixed buffer by yyjson's pool allocator (calls
  through its function fields), read back; a cut document fails with
  YYJSON_READ_ERROR_UNEXPECTED_END and a message; both documents freed
  (yyjson_doc_free calls through the allocator's free field)
  (PLAN-ADAM J2)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | root object
  | size 6
  | name string adam
  | name len 4
  | name equals true
  | name equals other false
  | n uint 3
  | pi real 0.5
  | ok true
  | none null
  | list array 3
  | list sum 6
  | list item 2 3
  | key 0 name
  | key 5 none
  | keys 6
  | copy size 6
  | edited size 7
  | written {"name":"adam","n":3,"pi":0.5,"ok":true,"list":[1,2,3,4],"lang":"adam"}
  | reread values 17
  | reread lang adam
  | bad doc false
  | bad code true
  | bad message true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe json_c_smoke;

import System.SysUtils, System.LibC.C, System.JSON.C;

type
  // the pool allocator's memory: what yyjson writes needs no free
  Pool = array[0..8191] of uint8;

const
  TEXT: string = "{\"name\":\"adam\",\"n\":3,\"pi\":0.5,\"ok\":true,\"list\":[1,2,3],\"none\":null}";
  BAD: string = "{\"name\":";

var
  GPool: Pool;

// The NUL-terminated text at AText as a string; "(nil)" for none
func CText(const AText: ptr to const char): string;
var
  LText: string;
  LLength: int64;
  LAt: int64;
begin
  if AText = nil then
    return "(nil)";
  end;
  LLength := int64(strlen(AText));
  setlength(LText, LLength);
  for LAt := 0 to LLength - 1 do
    LText[LAt] := AText[LAt];
  end;
  return LText;
end;

// ALabel, the type name of AValue and AText (when there is one) on one line
func ShowValue(const ALabel: string; const AValue: ptr to const yyjson_val; const AText: string);
begin
  if AText = "" then
    println("{} {}", ALabel, CText(yyjson_get_type_desc(AValue)));
  else
    println("{} {} {}", ALabel, CText(yyjson_get_type_desc(AValue)), AText);
  end;
end;

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

var
  LDoc: ptr to yyjson_doc;
  LRoot: ptr to yyjson_val;
  LValue: ptr to yyjson_val;
  LList: ptr to yyjson_val;
  LIter: yyjson_obj_iter;
  LKey: ptr to yyjson_val;
  LMut: ptr to yyjson_mut_doc;
  LMutRoot: ptr to yyjson_mut_val;
  LAlc: yyjson_alc;
  LWritten: ptr to char;
  LLength: uint64;
  LBack: ptr to yyjson_doc;
  LErr: yyjson_read_err;
  LBad: ptr to yyjson_doc;
  LBadText: string;
  LSum: int64;
  LCount: int64;
  LI: uint64;
begin
  LDoc := yyjson_read(TEXT, uint64(len(TEXT)), YYJSON_READ_NOFLAG);
  LRoot := yyjson_doc_get_root(LDoc);
  println("root {}", CText(yyjson_get_type_desc(LRoot)));
  println("size {}", yyjson_obj_size(LRoot));

  LValue := yyjson_obj_get(LRoot, "name");
  ShowValue("name", LValue, CText(yyjson_get_str(LValue)));
  println("name len {}", yyjson_get_len(LValue));
  println("name equals {}", BoolText(yyjson_equals_str(LValue, "adam")));
  println("name equals other {}", BoolText(yyjson_equals_str(LValue, "adams")));
  LValue := yyjson_obj_get(LRoot, "n");
  ShowValue("n", LValue, IntToStr(yyjson_get_int(LValue)));
  LValue := yyjson_obj_get(LRoot, "pi");
  ShowValue("pi", LValue, FloatToStr(yyjson_get_real(LValue)));
  ShowValue("ok", yyjson_obj_get(LRoot, "ok"), "");
  ShowValue("none", yyjson_obj_get(LRoot, "none"), "");

  // an array by index: each step from the first element by its size (get_next)
  LList := yyjson_obj_get(LRoot, "list");
  ShowValue("list", LList, IntToStr(int64(yyjson_arr_size(LList))));
  LSum := 0;
  for LI := 0 to yyjson_arr_size(LList) - 1 do
    LSum := LSum + yyjson_get_int(yyjson_arr_get(LList, LI));
  end;
  println("list sum {}", LSum);
  println("list item 2 {}", yyjson_get_int(yyjson_arr_get(LList, 2)));

  // an object by its iterator: each key, then its value
  LCount := 0;
  yyjson_obj_iter_init(LRoot, addr of LIter);
  LKey := yyjson_obj_iter_next(addr of LIter);
  while LKey <> nil do
    if (LCount = 0) or (LCount = 5) then
      println("key {} {}", LCount, CText(yyjson_get_str(LKey)));
    end;
    LCount := LCount + 1;
    LKey := yyjson_obj_iter_next(addr of LIter);
  end;
  println("keys {}", LCount);

  // a mutable copy, edited: two values added, one removed
  LMut := yyjson_doc_mut_copy(LDoc, nil);
  LMutRoot := yyjson_mut_doc_get_root(LMut);
  println("copy size {}", yyjson_mut_obj_size(LMutRoot));
  yyjson_mut_arr_add_int(LMut, yyjson_mut_obj_get(LMutRoot, "list"), 4);
  yyjson_mut_obj_add_str(LMut, LMutRoot, "lang", "adam");
  yyjson_mut_obj_add_null(LMut, LMutRoot, "extra");
  yyjson_mut_obj_remove_key(LMutRoot, "none");
  println("edited size {}", yyjson_mut_obj_size(LMutRoot));
  yyjson_mut_obj_remove_key(LMutRoot, "extra");

  // written into the pool (nothing to free), read back
  yyjson_alc_pool_init(addr of LAlc, addr of GPool[0], uint64(size(Pool)));
  LLength := 0;
  LWritten := yyjson_mut_write_opts(LMut, YYJSON_WRITE_NOFLAG, addr of LAlc, addr of LLength, nil);
  println("written {}", CText(LWritten));
  LBack := yyjson_read(LWritten, LLength, YYJSON_READ_NOFLAG);
  println("reread values {}", yyjson_doc_get_val_count(LBack));
  println("reread lang {}", CText(yyjson_get_str(yyjson_obj_get(yyjson_doc_get_root(LBack), "lang"))));

  // a cut document: no document, the error said (read_opts takes the text writable)
  LBadText := BAD;
  LBad := yyjson_read_opts(addr of LBadText[0], uint64(len(LBadText)), YYJSON_READ_NOFLAG, nil,
    addr of LErr);
  println("bad doc {}", BoolText(LBad <> nil));
  println("bad code {}", BoolText(LErr.code = YYJSON_READ_ERROR_UNEXPECTED_END));
  println("bad message {}", BoolText(LErr.msg <> nil));

  yyjson_doc_free(LBack);
  yyjson_mut_doc_free(LMut);
  yyjson_doc_free(LDoc);
end.
