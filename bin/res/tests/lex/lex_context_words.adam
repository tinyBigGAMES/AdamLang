-------------------------------------------------------------------------------
  lex_context_words.adam - the Lexer's context word table (ContextWord,
  BNF sec 4 / 5 / 6), read from the compiler's own src\: ContextWords lists
  every word once, in order (each after the one before it, so none twice);
  ContextWordText spells each one and IsContextWord matches exactly that
  spelling (case-sensitive: "As", "asx" and "" match nothing); the Lexer
  reads each as an identifier (KeywordKind), and none is a reserved word or
  a builtin type word (ReservedWords).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | count 34
  | words abstract as async await copy defer done embed extend final from hash hidden implements init interface is lock name noreturn override own parallel property read ref sequence static task trylock wait weak write yield
  | ordered 34
  | matched 34
  | identifiers 34
  | reserved 0
  | near false false false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lex_context_words;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Compiler.Lexer;

// True when AText is one of AList's words
func Listed(const AList: StringArray; const AText: string): bool;
var
  LI: int64;
begin
  for LI := 0 to len(AList) - 1 do
    if AList[LI] = AText then
      return true;
    end;
  end;
  return false;
end;

var
  LWords: StringArray;
  LKeywords: StringArray;
  LTypes: StringArray;
  LWord: ContextWord;
  LI: int64;
  LOrdered: int64;
  LMatched: int64;
  LIdentifiers: int64;
  LReserved: int64;
begin
  LWords := ContextWords();
  println("count {}", len(LWords));
  println("words {}", JoinStrings(LWords, " "));

  // Each word after the one before it: listed once, never twice
  LOrdered := 1;
  for LI := 1 to len(LWords) - 1 do
    if LWords[LI - 1] < LWords[LI] then
      LOrdered := LOrdered + 1;
    end;
  end;
  println("ordered {}", LOrdered);

  // The list in ContextWord's order, each spelling matching its own value
  LI := 0;
  LMatched := 0;
  for LWord := ContextWord.Abstract to ContextWord.Yield do
    if (LWords[LI] = ContextWordText(LWord)) and IsContextWord(LWords[LI], LWord) then
      LMatched := LMatched + 1;
    end;
    LI := LI + 1;
  end;
  println("matched {}", LMatched);

  // Never reserved: the Lexer gives each one as an identifier
  LKeywords := ReservedWords(false);
  LTypes := ReservedWords(true);
  LIdentifiers := 0;
  LReserved := 0;
  for LI := 0 to len(LWords) - 1 do
    if KeywordKind(LWords[LI]) = TokenKind.Identifier then
      LIdentifiers := LIdentifiers + 1;
    end;
    if Listed(LKeywords, LWords[LI]) or Listed(LTypes, LWords[LI]) then
      LReserved := LReserved + 1;
    end;
  end;
  println("identifiers {}", LIdentifiers);
  println("reserved {}", LReserved);

  // Exactly the spelling: case-sensitive, no prefix, nothing for the empty text
  println("near {} {} {}", IsContextWord("As", ContextWord.As),
    IsContextWord("asx", ContextWord.As), IsContextWord("", ContextWord.As));
end.
