-------------------------------------------------------------------------------
  lex_err_forms.adam - break steps of lex_forms (B3): a separator that ends
  a number (the quote starts a character literal never closed), two
  separators in a row (an empty character literal the declaration does not
  expect), a hex float with a separator or with no p exponent, a suffix no
  number takes, a digit its base does not allow, an integer past uint64, a
  leading 0, a raw string delimiter holding a blank, an unknown \N name, an
  incomplete \u and an unknown escape (a warning); a raw string never
  closed is lex_err_raw_open. A fault that takes the rest of its line takes its ';' too: the
  parser picks up again after the next one, so a plain declaration follows it
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe lex_err_forms;

const
  CEnd: int32 = /* // ERROR LX0001@92: the character literal is not closed on its line */ 1';
  CPad1: int32 = 0;
  CDouble: int32 = 1''0; // ERROR PR0001@21: expected ';', found ''''
  CHexSep: float64 = 0x1'0p1; // ERROR LX0005@22: the hex float '0x1'0p1' takes no digit separators
  CNoExp: float64 = 0x1.8; // ERROR LX0005@21: the hex float '0x1.8' needs a 'p' exponent
  CSuffix: int64 = 10q; // ERROR LX0005@20: 'q' is not a suffix of the number '10'
  CBinDigit: int32 = 0b102; // ERROR LX0005@22: '0b102' has a digit its base does not allow
  CTooBig: uint64 = 18'446'744'073'709'551'616u; // ERROR LX0006@21: '18'446'744'073'709'551'616u' does not fit any integer type (uint64 is the largest)
  COctal: int32 = 017; // ERROR LX0007@19: '017' starts with 0, and Adam has no octal literals: write '17' for the decimal value
  CDelim: string = /* // ERROR LX0010@145: the raw string delimiter 'a' is invalid: at most 16 characters, none of ( ) \ blanks or controls */ R"a b(x)a b";
  CPad2: int32 = 0;
  CName: string = "\N{NO SUCH NAME}"; // ERROR PR0009@19: invalid string literal: 'NO SUCH NAME' is not a valid Unicode character name
  CUcn: string = "\u12"; // ERROR PR0009@18: invalid string literal: incomplete universal character name
  CEscape: string = "\q"; // WARN PR0021@21: string literal: unknown escape sequence '\q'

begin
  println("never runs");
end.
