-------------------------------------------------------------------------------
  lex_context_words_use.adam - every context word (the Lexer's ContextWord
  table, BNF sec 4 / 5 / 6) where the Parser reads it from that table, and
  the same words as plain names: the object words (implements, embed, init,
  copy, done, property read / hidden write, static, hidden, override final,
  abstract, operator hash, final object, ref object, extend), the owner
  words and the dynamic type tests (own, ref, weak, is, as), the statement
  and expression words (defer, sequence, yield, yield from, lock, trylock
  wait, async, await, task, for parallel), noreturn and external's name;
  then each word as a record field, as a local variable (is, as, name,
  defer, yield, from, wait, read, write) and `for parallel := ..` as a plain
  for over a variable named parallel.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | names 48
  | fields 34
  | area 36 size 6 tag 7 one 1 half 3 doubled 72 inner 7
  | done 1
  | is leaf 3
  | shared 5
  | locked
  | tried
  | awaited 42
  | slots 14
  | numbers done
  | sum 6
  | external 18
  | sealed 4
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lex_context_words_use;

import System.SysUtils;

var
  // The Base values ended so far (Base's done counts them)
  GDone: int64;
  GLock: mutex;

type
  // Every context word as a field name: an identifier off its grammar spot
  Words = record
    abstract: int32;
    as: int32;
    async: int32;
    await: int32;
    copy: int32;
    defer: int32;
    done: int32;
    embed: int32;
    extend: int32;
    final: int32;
    from: int32;
    hash: int32;
    hidden: int32;
    implements: int32;
    init: int32;
    interface: int32;
    is: int32;
    lock: int32;
    name: int32;
    noreturn: int32;
    override: int32;
    own: int32;
    parallel: int32;
    property: int32;
    read: int32;
    ref: int32;
    sequence: int32;
    static: int32;
    task: int32;
    trylock: int32;
    wait: int32;
    weak: int32;
    write: int32;
    yield: int32;
  end;

  // An interface with a method and a read-only property (Base's Size)
  IShape = interface
    method Area(): int64;
    property Size: int64 read;
  end;

  // What Base embeds
  Part = record
    Width: int64;
  end;

  // The object words as syntax
  Base = object implements IShape
    FSide: int64;
    FTag: int64;
    embed Inner: Part;

    init(const ASide: int64);
    begin
      self.FSide := ASide;
      self.FTag := 7;
      self.Inner.Width := ASide + 1;
    end;

    copy(const ASource: Base);
    begin
      self.FSide := ASource.FSide;
      self.FTag := ASource.FTag;
      self.Inner := ASource.Inner;
    end;

    done;
    begin
      GDone := GDone + 1;
    end;

    virtual method Area(): int64;
    begin
      return self.FSide * self.FSide;
    end;

    virtual property Size: int64 read FSide;

    virtual property Tag: int64 read FTag; hidden write FTag;

    static method One(): int64;
    begin
      return 1;
    end;

    hidden method Half(): int64;
    begin
      return self.FSide div 2;
    end;

    method Halved(): int64;
    begin
      return self.Half();
    end;

    operator hash(const A: Base): uint64;
    begin
      return hash(A.FSide);
    end;
  end;

  // abstract, then override final below it
  Shape = object
    virtual method Sides(): int64; abstract;
  end;

  Leaf = object(Shape)
    override final method Sides(): int64;
    begin
      return 3;
    end;
  end;

  // No type derives from it
  Sealed = final object
    FN: int64;
  end;

  // Lives only in a ref block
  Shared = ref object
    FN: int64;
  end;

// A method added to Base from outside it
extend Base
  method Doubled(): int64;
  begin
    return self.Area() * 2;
  end;
end;

// Never comes back
func Stop(const ACode: int32); noreturn;
begin
  Halt(ACode);
end;

// Bound by external's name to the program's own C symbol
public func clink TwiceWord(const AN: int32): int32;
begin
  return AN * 2;
end;

func DoubledWord(const AN: int32): int32; external name "TwiceWord";

// 2, 3
func Inner(): sequence of int32;
begin
  yield 2;
  yield 3;
end;

// 1, then Inner's values; its defer runs when it ends
func Numbers(): sequence of int32;
begin
  defer println("numbers done");
  yield 1;
  yield from Inner();
end;

// What the async call gives
func Pick(): int32;
begin
  return 42;
end;

// The statement and expression words as plain variable names
func Names(): int64;
var
  is: int64;
  as: int64;
  name: int64;
  defer: int64;
  yield: int64;
  from: int64;
  wait: int64;
  read: int64;
  write: int64;
  parallel: int64;
  LTotal: int64;
begin
  is := 1;
  as := 2;
  name := 3;
  defer := 4;
  yield := 5;
  from := 6;
  wait := 7;
  read := 8;
  write := 9;
  LTotal := 0;
  // a plain for over a variable named parallel
  for parallel := 1 to 2 do
    LTotal := LTotal + parallel;
  end;
  return is + as + name + defer + yield + from + wait + read + write + LTotal;
end;

// A Base built, read through every member kind and ended (its done runs)
func ShowBase();
var
  LBase: own Base;
begin
  LBase := own Base(6);
  println("area {} size {} tag {} one {} half {} doubled {} inner {}", LBase.Area(),
    LBase.Size, LBase.Tag, Base.One(), LBase.Halved(), LBase.Doubled(), LBase.Inner.Width);
end;

var
  LWords: Words;
  LFields: int32;
  LShape: ref Shape;
  LShared: ref Shared;
  LWeak: weak Shared;
  LBack: ref Shared;
  LTask: task int32;
  LSlots: array[0..3] of int64;
  LSlotSum: int64;
  LI: int64;
  LN: int32;
  LSum: int32;
  LSealed: Sealed;
begin
  println("names {}", Names());

  LWords.abstract := 1;
  LWords.as := 1;
  LWords.async := 1;
  LWords.await := 1;
  LWords.copy := 1;
  LWords.defer := 1;
  LWords.done := 1;
  LWords.embed := 1;
  LWords.extend := 1;
  LWords.final := 1;
  LWords.from := 1;
  LWords.hash := 1;
  LWords.hidden := 1;
  LWords.implements := 1;
  LWords.init := 1;
  LWords.interface := 1;
  LWords.is := 1;
  LWords.lock := 1;
  LWords.name := 1;
  LWords.noreturn := 1;
  LWords.override := 1;
  LWords.own := 1;
  LWords.parallel := 1;
  LWords.property := 1;
  LWords.read := 1;
  LWords.ref := 1;
  LWords.sequence := 1;
  LWords.static := 1;
  LWords.task := 1;
  LWords.trylock := 1;
  LWords.wait := 1;
  LWords.weak := 1;
  LWords.write := 1;
  LWords.yield := 1;
  LFields := LWords.abstract + LWords.as + LWords.async + LWords.await + LWords.copy +
    LWords.defer + LWords.done + LWords.embed + LWords.extend + LWords.final + LWords.from +
    LWords.hash + LWords.hidden + LWords.implements + LWords.init + LWords.interface + LWords.is +
    LWords.lock + LWords.name + LWords.noreturn + LWords.override + LWords.own + LWords.parallel +
    LWords.property + LWords.read + LWords.ref + LWords.sequence + LWords.static + LWords.task +
    LWords.trylock + LWords.wait + LWords.weak + LWords.write + LWords.yield;
  println("fields {}", LFields);

  ShowBase();
  println("done {}", GDone);

  LShape := ref Leaf();
  if LShape is Leaf then
    println("is leaf {}", (LShape as Leaf).Sides());
  end;

  LShared := ref Shared();
  LShared.FN := 5;
  LWeak := LShared;
  LBack := lock(LWeak);
  println("shared {}", LBack.FN);

  lock (GLock) do
    println("locked");
  end;
  trylock (GLock) wait 10 do
    println("tried");
  else
    println("busy");
  end;

  LTask := async Pick();
  println("awaited {}", await LTask);

  for parallel (2) LK := 0 to 3 do
    LSlots[LK] := LK * LK;
  end;
  LSlotSum := 0;
  for LI := 0 to 3 do
    LSlotSum := LSlotSum + LSlots[LI];
  end;
  println("slots {}", LSlotSum);

  LSum := 0;
  for LN in Numbers() do
    LSum := LSum + LN;
  end;
  println("sum {}", LSum);

  println("external {}", DoubledWord(9));

  LSealed.FN := 4;
  println("sealed {}", LSealed.FN);

  if GDone < 0 then
    Stop(1);
  end;
end.
