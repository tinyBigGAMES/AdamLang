-------------------------------------------------------------------------------
  lex_forms.adam - lexical forms (BNF sec 2, B3): digit separators in
  decimal, hex and binary numbers; the integer suffixes u, ll / LL, ull /
  ULL and z; 0x / 0X / 0b / 0B prefixes; hex floats with a p exponent; raw
  strings with and without a delimiter (a quote, a backslash and a newline
  kept as written); the escapes \x, \u, \U and \N{name} in a string and in
  a character; each value printed back
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | max 18446744073709551615
  | million 1000000
  | hex 255 255 3735928559
  | bin 165 5
  | suffix 10 10 10 10 7 42
  | hexfloat 12 0.25 1.5
  | raw a "raw" \n string
  | plain C:\dir\file
  | lines one
  | two
  | escapes A é α 😀
  | chars 65 233 945
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lex_forms;

const
  CMax: uint64 = 18'446'744'073'709'551'615u;
  CMillion: int64 = 1'000'000;
  CHexLow: int32 = 0xff;
  CHexHigh: int32 = 0XFF;
  CHexSplit: uint32 = 0xDEAD'BEEFu;
  CBin: int32 = 0b1010'0101;
  CBinUpper: int32 = 0B101;
  CLL: int64 = 10ll;
  CLLUpper: int64 = 10LL;
  CULL: uint64 = 10ull;
  CULLUpper: uint64 = 10ULL;
  CZ: int64 = 7z;
  CU: uint32 = 42u;
  CHexFloat: float64 = 0x1.8p3;
  CHexSmall: float64 = 0x1p-2;
  CHexUpper: float64 = 0X1.8P0;
  CRaw: string = R"xy(a "raw" \n string)xy";
  CPlain: string = R"(C:\dir\file)";
  CLines: string = R"(one
two)";

var
  LA: char;
  LB: wchar;
  LC: wchar;

begin
  println("max {}", CMax);
  println("million {}", CMillion);
  println("hex {} {} {}", CHexLow, CHexHigh, CHexSplit);
  println("bin {} {}", CBin, CBinUpper);
  println("suffix {} {} {} {} {} {}", CLL, CLLUpper, CULL, CULLUpper, CZ, CU);
  println("hexfloat {} {} {}", CHexFloat, CHexSmall, CHexUpper);
  println("raw {}", CRaw);
  println("plain {}", CPlain);
  println("lines {}", CLines);
  println("escapes \x41 \u00E9 \N{GREEK SMALL LETTER ALPHA} \U0001F600");
  LA := '\x41';
  LB := '\u00E9';
  LC := '\N{GREEK SMALL LETTER ALPHA}';
  println("chars {} {} {}", int32(LA), int32(LB), int32(LC));
end.
