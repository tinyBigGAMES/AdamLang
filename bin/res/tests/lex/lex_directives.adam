-------------------------------------------------------------------------------
  lex_directives.adam - the Lexer's directive table (Directive, BNF sec 2),
  read from the compiler's own src\: DirectiveRow's facts for every
  directive in order (its spelling, build or conditional, the shape of its
  argument, main module only, at most once, version info, which argument
  is a path, may stand in a body, its two value words); DirectiveOf finds
  each by its spelling and IsDirective matches exactly that spelling
  (case-sensitive: "@Optimize", a spelling of none and "" name nothing).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | @optimize build Name main true single false version false path -1 body false values |
  | @subsystem build Name main true single true version false path -1 body false values console|gui
  | @addverinfo build Name main true single true version false path -1 body false values on|off
  | @unitTestMode build Name main true single true version false path -1 body false values on|off
  | @vimajor build NumberOrConst main true single true version true path -1 body false values |
  | @viminor build NumberOrConst main true single true version true path -1 body false values |
  | @vipatch build NumberOrConst main true single true version true path -1 body false values |
  | @viproductname build TextOrConst main true single true version true path -1 body false values |
  | @videscription build TextOrConst main true single true version true path -1 body false values |
  | @vifilename build TextOrConst main true single true version true path -1 body false values |
  | @vicompanyname build TextOrConst main true single true version true path -1 body false values |
  | @vicopyright build TextOrConst main true single true version true path -1 body false values |
  | @exeicon build TextOrConst main true single true version false path 0 body false values |
  | @addmodulepath build Text main true single false version false path 0 body false values |
  | @outputpath build Text main true single true version false path 0 body false values |
  | @target build Text main false single false version false path -1 body false values |
  | @copydll build Text main false single false version false path 0 body false values |
  | @linklibrary build Text main false single false version false path -1 body false values |
  | @addlibrarypath build Text main false single false version false path 0 body false values |
  | @breakpoint build Bare main false single false version false path -1 body true values |
  | @message build Message main false single false version false path -1 body true values |
  | @addresdata build KeyPath main false single false version false path 1 body false values |
  | @define conditional Name main false single false version false path -1 body true values |
  | @undef conditional Name main false single false version false path -1 body true values |
  | @ifdef conditional Name main false single false version false path -1 body true values |
  | @ifndef conditional Name main false single false version false path -1 body true values |
  | @elseif conditional Name main false single false version false path -1 body true values |
  | @else conditional Bare main false single false version false path -1 body true values |
  | @endif conditional Bare main false single false version false path -1 body true values |
  | found 29
  | none false false false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lex_directives;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Compiler.Lexer;

var
  LDirective: Directive;
  LFound: Directive;
  LRow: DirectiveInfo;
  LKind: string;
  LCount: int64;
begin
  // Every row of the table, in Directive's order
  LCount := 0;
  for LDirective := Directive.Optimize to Directive.Endif do
    LRow := DirectiveRow(LDirective);
    LKind := "build";
    if LRow.Conditional then
      LKind := "conditional";
    end;
    println("{} {} {} main {} single {} version {} path {} body {} values {}|{}", LRow.Spelling,
      LKind, nameof(LRow.Shape), LRow.MainOnly, LRow.Single, LRow.Version, LRow.PathArgument,
      LRow.InBody, LRow.FirstValue, LRow.SecondValue);
    // DirectiveOf finds it again by its spelling, IsDirective matches it
    if DirectiveOf(LRow.Spelling, LFound) and (LFound = LDirective) and
      IsDirective(LRow.Spelling, LDirective) and (DirectiveText(LDirective) = LRow.Spelling) then
      LCount := LCount + 1;
    end;
  end;
  println("found {}", LCount);

  // Exactly the spelling: case-sensitive, nothing for a spelling of none or the empty text
  println("none {} {} {}", DirectiveOf("@Optimize", LFound), DirectiveOf("@nope", LFound),
    DirectiveOf("", LFound));
end.
