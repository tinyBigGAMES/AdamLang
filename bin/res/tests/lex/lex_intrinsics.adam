-------------------------------------------------------------------------------
  lex_intrinsics.adam - the Lexer's intrinsic table (Intrinsic, BNF sec 7
  and sec 8's asserts), read from the compiler's own src\: IntrinsicRow's
  facts for every intrinsic in order (its spelling, a statement or a value,
  whether its argument may be a type, its family, internal: the runtime's
  reserved thunk name); IntrinsicOf finds each by its spelling and
  IsIntrinsic matches exactly that spelling (case-sensitive: "Len", a
  spelling of none and "" name nothing; None has no spelling).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | len value type false Plain internal false
  | size value type true Plain internal false
  | utf8 value type false Plain internal false
  | paramcount value type false Plain internal false
  | paramstr value type false Plain internal false
  | getmem value type false Plain internal false
  | resizemem value type false Plain internal false
  | exccode value type false Plain internal false
  | excmsg value type false Plain internal false
  | alive value type false Plain internal false
  | lock value type false Plain internal false
  | ready value type false Plain internal false
  | atomicadd value type false Atomic internal false
  | atomicswap value type false Atomic internal false
  | atomiccas value type false Atomic internal false
  | atomicload value type false Atomic internal false
  | ProjectPassword value type false Plain internal false
  | FormatStr value type false Plain internal false
  | create statement type false Plain internal false
  | destroy statement type false Plain internal false
  | freemem statement type false Plain internal false
  | setlength statement type false Plain internal false
  | raise statement type false Plain internal false
  | raisecode statement type false Plain internal false
  | print statement type false Plain internal false
  | println statement type false Plain internal false
  | atomicstore statement type false Atomic internal false
  | testAssert statement type false Assert internal false
  | testAssertTrue statement type false Assert internal false
  | testAssertFalse statement type false Assert internal false
  | testAssertNil statement type false Assert internal false
  | testAssertNotNil statement type false Assert internal false
  | testFail statement type false Assert internal false
  | testAssertEqualInt statement type false Assert internal false
  | testAssertEqualUInt statement type false Assert internal false
  | testAssertEqualFloat statement type false Assert internal false
  | testAssertEqualStr statement type false Assert internal false
  | testAssertEqualBool statement type false Assert internal false
  | testAssertEqualPtr statement type false Assert internal false
  | workerindex value type false Plain internal false
  | workercount value type false Plain internal false
  | cancel statement type false Plain internal false
  | cancelled value type false Plain internal false
  | pull value type false Plain internal false
  | byteswap value type false Bit internal false
  | leadingzeros value type false Bit internal false
  | trailingzeros value type false Bit internal false
  | popcount value type false Bit internal false
  | hash value type false Plain internal false
  | __adam_cthunk value type true Plain internal true
  | nameof value type true Plain internal false
  | sourcehash value type false Plain internal false
  | found 52
  | none false false false ""
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lex_intrinsics;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Compiler.Lexer;

var
  LIntrinsic: Intrinsic;
  LFound: Intrinsic;
  LRow: IntrinsicInfo;
  LForm: string;
  LCount: int64;
begin
  // Every row of the table, in Intrinsic's order (None, before them, is no intrinsic)
  LCount := 0;
  for LIntrinsic := Intrinsic.Len to Intrinsic.SourceHash do
    LRow := IntrinsicRow(LIntrinsic);
    LForm := "value";
    if LRow.Statement then
      LForm := "statement";
    end;
    println("{} {} type {} {} internal {}", LRow.Spelling, LForm, LRow.TypeArgument,
      nameof(LRow.Family), LRow.Internal);
    // IntrinsicOf finds it again by its spelling, IsIntrinsic matches it
    if IntrinsicOf(LRow.Spelling, LFound) and (LFound = LIntrinsic) and
      IsIntrinsic(LRow.Spelling, LIntrinsic) and (IntrinsicText(LIntrinsic) = LRow.Spelling) then
      LCount := LCount + 1;
    end;
  end;
  println("found {}", LCount);

  // Exactly the spelling: case-sensitive, nothing for a spelling of none or the empty text
  println("none {} {} {} \"{}\"", IntrinsicOf("Len", LFound), IntrinsicOf("nope", LFound),
    IntrinsicOf("", LFound), IntrinsicText(Intrinsic.None));
end.
