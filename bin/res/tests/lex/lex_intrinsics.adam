  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  lex_intrinsics.adam - the Lexer's intrinsic table (Intrinsic, BNF sec 7
  and sec 8's asserts), read from the compiler's own src\: IntrinsicRow's
  facts for every intrinsic in order (its spelling, a statement or a value,
  whether its argument may be a type, its family, internal: the runtime's
  reserved thunk name, the signature SM0409 names); IntrinsicOf finds each by its spelling and
  IsIntrinsic matches exactly that spelling (case-sensitive: "Len", a
  spelling of none and "" name nothing; None has no spelling).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | len value type false Plain internal false sig '(string, wstring or array)'
  | size value type true Plain internal false sig '(a type)'
  | utf8 value type false Plain internal false sig '(wstring)'
  | paramcount value type false Plain internal false sig '()'
  | paramstr value type false Plain internal false sig '(int32)'
  | getmem value type false Plain internal false sig '(int64)'
  | resizemem value type false Plain internal false sig '(pointer, int64)'
  | exccode value type false Plain internal false sig '()'
  | excmsg value type false Plain internal false sig '()'
  | alive value type false Plain internal false sig '(weak)'
  | lock value type false Plain internal false sig '(weak)'
  | ready value type false Plain internal false sig '(task)'
  | atomicadd value type false Atomic internal false sig '(int32, int64, uint32 or uint64 variable, its type)'
  | atomicswap value type false Atomic internal false sig '(int32, int64, uint32, uint64 or ptr variable, its type)'
  | atomiccas value type false Atomic internal false sig '(int32, int64, uint32, uint64 or ptr variable, its type, its type)'
  | atomicload value type false Atomic internal false sig '(int32, int64, uint32, uint64 or ptr variable)'
  | ProjectPassword value type false Plain internal false sig '()'
  | FormatStr value type false Plain internal false sig '(format string, its arguments)'
  | create statement type false Plain internal false sig '(record or overlay pointer variable)'
  | destroy statement type false Plain internal false sig '(record or overlay pointer variable)'
  | freemem statement type false Plain internal false sig '(pointer)'
  | setlength statement type false Plain internal false sig '(dynamic array or string variable, int64)'
  | raise statement type false Plain internal false sig '(string)'
  | raisecode statement type false Plain internal false sig '(int32, string)'
  | print statement type false Plain internal false sig ''
  | println statement type false Plain internal false sig ''
  | atomicstore statement type false Atomic internal false sig '(int32, int64, uint32, uint64 or ptr variable, its type)'
  | testAssert statement type false Assert internal false sig '(bool)'
  | testAssertTrue statement type false Assert internal false sig '(bool)'
  | testAssertFalse statement type false Assert internal false sig '(bool)'
  | testAssertNil statement type false Assert internal false sig '(pointer)'
  | testAssertNotNil statement type false Assert internal false sig '(pointer)'
  | testFail statement type false Assert internal false sig '(string)'
  | testAssertEqualInt statement type false Assert internal false sig '(int64, int64)'
  | testAssertEqualUInt statement type false Assert internal false sig '(uint64, uint64)'
  | testAssertEqualFloat statement type false Assert internal false sig '(float64, float64)'
  | testAssertEqualStr statement type false Assert internal false sig '(string, string)'
  | testAssertEqualBool statement type false Assert internal false sig '(bool, bool)'
  | testAssertEqualPtr statement type false Assert internal false sig '(pointer, pointer)'
  | workerindex value type false Plain internal false sig '()'
  | workercount value type false Plain internal false sig '()'
  | cancel statement type false Plain internal false sig '(task)'
  | cancelled value type false Plain internal false sig '() or (task)'
  | pull value type false Plain internal false sig '(sequence of T, a variable of type T)'
  | byteswap value type false Bit internal false sig '(an integer)'
  | leadingzeros value type false Bit internal false sig '(an integer)'
  | trailingzeros value type false Bit internal false sig '(an integer)'
  | popcount value type false Bit internal false sig '(an integer)'
  | hash value type false Plain internal false sig '(a value)'
  | __adam_cthunk value type true Plain internal true sig '(a type)'
  | nameof value type true Plain internal false sig '(a choices value, or a type)'
  | sourcehash value type false Plain internal false sig '()'
  | found 52
  | none false false false ""
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lex_intrinsics;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Compiler.Lexer;

var
  LIntrinsic: Intrinsic;
  LFound: Intrinsic;
  LRow: IntrinsicInfo;
  LForm: string;
  LCount: int64;
begin
  // Every row of the table, in Intrinsic's order (None, before them, is no intrinsic)
  LCount := 0;
  for LIntrinsic := Intrinsic.Len to Intrinsic.SourceHash do
    LRow := IntrinsicRow(LIntrinsic);
    LForm := "value";
    if LRow.Statement then
      LForm := "statement";
    end;
    println("{} {} type {} {} internal {} sig '{}'", LRow.Spelling, LForm, LRow.TypeArgument,
      nameof(LRow.Family), LRow.Internal, LRow.Signature);
    // IntrinsicOf finds it again by its spelling, IsIntrinsic matches it
    if IntrinsicOf(LRow.Spelling, LFound) and (LFound = LIntrinsic) and
      IsIntrinsic(LRow.Spelling, LIntrinsic) and (IntrinsicText(LIntrinsic) = LRow.Spelling) then
      LCount := LCount + 1;
    end;
  end;
  println("found {}", LCount);

  // Exactly the spelling: case-sensitive, nothing for a spelling of none or the empty text
  println("none {} {} {} \"{}\"", IntrinsicOf("Len", LFound), IntrinsicOf("nope", LFound),
    IntrinsicOf("", LFound), IntrinsicText(Intrinsic.None));
end.
