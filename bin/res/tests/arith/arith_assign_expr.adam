-------------------------------------------------------------------------------
  arith_assign_expr.adam - assignment as an expression (BNF sec 6 assign
  expr, AUD3 / AUDIT 2.3): its value is its target's after the write, right
  associative: a chain of := sets every target; a compound form's value is
  the new value; the value converts where it is used (an int32 target in an
  int64 chain); used as an argument and in a condition; a string chain (each
  holds the text, no leak), a string += as a value; a record chain; a target
  whose index calls a routine (called once, the value read from the same
  element); a bitfield target's value is the bits it keeps (9 into a 3-bit
  field reads 1, a run-time 9: a constant there is SEM's).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | chain 4 4 4
  | compound 13 13
  | wide 7 7
  | arg 9 9
  | cond 5
  | text ab ab ab
  | joined abc abc
  | record 3 4 3 4
  | index 1 9 9
  | bits 1 1
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe arith_assign_expr;

type
  TPoint = record
    X: int64;
    Y: int64;
  end;

  TBits = record
    A: uint8 : 3;
    B: uint8 : 5;
  end;

var
  GCalls: int64;

// The next index, counted
routine NextIndex(): int64;
begin
  GCalls := GCalls + 1;
  return 2;
end;

routine Run();
var
  LA: int32;
  LB: int32;
  LC: int32;
  LN: int32;
  LW: int64;
  LS: string;
  LT: string;
  LU: string;
  LP: TPoint;
  LQ: TPoint;
  LR: TPoint;
  LArr: array[0..3] of int64;
  LV: int64;
  LBits: TBits;
  LK: uint8;
begin
  LA := LB := LC := 4;
  println("chain {} {} {}", LA, LB, LC);
  LN := 10;
  LA := LN += 3;
  println("compound {} {}", LA, LN);
  LW := LN := 7;
  println("wide {} {}", LW, LN);
  println("arg {} {}", LC := 9, LC);
  if (LB := 5) > 4 then
    println("cond {}", LB);
  end;
  LS := LT := LU := "ab";
  println("text {} {} {}", LS, LT, LU);
  LS := LT += "c";
  println("joined {} {}", LS, LT);
  LP.X := 3;
  LP.Y := 4;
  LR := LQ := LP;
  println("record {} {} {} {}", LQ.X, LQ.Y, LR.X, LR.Y);
  LV := LArr[NextIndex()] := 9;
  println("index {} {} {}", GCalls, LV, LArr[2]);
  LK := LBits.A := uint8(LN + 2);
  println("bits {} {}", LK, LBits.A);
end;

begin
  Run();
end.
