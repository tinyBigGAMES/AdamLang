  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  arith_forms.adam - Arith: the rest of BNF sec 6's integer / bool forms
  (M3.2f). `? :` picks a branch and runs only that one (Mark shows 99 when
  it runs), its branches meeting at one type, a bool result, nested, a
  condition of `and`, pointers, stored; `<=>` at the signed / unsigned edge,
  promoted 8-bit operands, int64 and uint64, stored, compared; prefix and
  postfix `++` / `--` as statements and as values, wrapping at every width,
  char and wchar; the compound assignments += -= *= %= &= |= <<= >>=, a
  signed >>= arithmetic and an unsigned one logical, 8 / 16-bit targets
  computed at int32 and truncated back (int8 -128 %= -1 is 0, no fault), a
  shift count of another type, 64-bit targets. Values are shown through
  ucrtbase (_i64toa / _ui64toa + puts); a bool as 0 / 1.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 5
  | 7
  | 99
  | 1
  | 99
  | 2
  | -3
  | 5000000000
  | 1
  | 2
  | 10
  | 1
  | 1
  | 42
  | -1
  | 1
  | 0
  | 1
  | -1
  | -1
  | 1
  | -1
  | 1
  | 6
  | 7
  | 6
  | 5
  | 5
  | 6
  | 7
  | 7
  | 5
  | -128
  | 127
  | 0
  | 255
  | 32767
  | 0
  | -2147483648
  | 4294967295
  | -9223372036854775808
  | 18446744073709551615
  | 66
  | 0
  | 15
  | -5
  | 15
  | 3
  | 2
  | 7
  | 56
  | 14
  | -4
  | 268435455
  | 5
  | 0
  | -56
  | 144
  | -64
  | 0
  | 24464
  | 16
  | 1099511627776
  | -1
  | 15
  | 615
  | 15
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe arith_forms;

func malloc(const ASize: uint64): ptr; external "ucrtbase";
func puts(const AText: ptr): int32; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
func _ui64toa(const AValue: uint64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
func exit(const ACode: int32); external "ucrtbase";

// AValue in decimal, one line
func ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue (unsigned) in decimal, one line
func ShowUInt(const AValue: uint64);
begin
  puts(_ui64toa(AValue, malloc(32), 10));
end;

// AValue as 0 / 1, one line
func ShowBool(const AValue: bool);
begin
  ShowInt(int64(AValue));
end;

// Shows 99 (it ran), then gives AValue: the branch ? : did not pick must not run
func Mark(const AValue: int32): int32;
begin
  ShowInt(99);
  return AValue;
end;

func Run();
var
  LA: int32;
  LB: int32;
  LR: int32;
  LU: uint32;
  LI8: int8;
  LU8: uint8;
  LI16: int16;
  LU16: uint16;
  LBig: int64;
  LU64: uint64;
  LOneU: uint64;
  LCount: uint8;
  LC: char;
  LW: wchar;
  LT: bool;
  LF: bool;
  LP: ptr;
  LQ: ptr;
begin
  // ? : picks a branch
  LA := 5;
  LB := 7;
  LT := true;
  LF := false;
  ShowInt(LA < LB ? LA : LB);
  ShowInt(LA > LB ? LA : LB);
  // only the chosen branch runs
  ShowInt(LT ? Mark(1) : Mark(2));
  ShowInt(LF ? Mark(1) : Mark(2));
  // the branches meet at one type: the int8 widens to int64
  LI8 := -3;
  LBig := 5000000000;
  ShowInt(LT ? LI8 : LBig);
  ShowInt(LF ? LI8 : LBig);
  // a bool result, a nested ? :, a condition of and
  ShowBool(LA < LB ? LT : LF);
  ShowInt(LA > 6 ? 1 : (LB > 6 ? 2 : 3));
  ShowInt((LA = 5) and (LB = 7) ? 10 : 20);
  // pointers
  LP := malloc(8);
  LQ := nil;
  ShowBool((LT ? LP : LQ) = LP);
  ShowBool((LF ? LP : LQ) = nil);
  // stored, then used
  LR := LT ? 40 : 50;
  LR := LR + 2;
  ShowInt(LR);

  // <=> at the signed edge, both ways and equal
  LA := -1;
  LB := 0;
  ShowInt(LA <=> LB);
  ShowInt(LB <=> LA);
  ShowInt(LA <=> LA);
  // unsigned: 4294967295 is above 0
  LU := 4294967295;
  ShowInt(LU <=> 0);
  // promoted 8-bit operands, int64, uint64
  LI8 := -128;
  LU8 := 255;
  ShowInt(LI8 <=> LU8);
  LBig := -5000000000;
  ShowInt(LBig <=> 5);
  LU64 := 18446744073709551615u;
  LOneU := 1u;
  ShowInt(LU64 <=> LOneU);
  // stored, and compared
  LR := LA <=> LB;
  ShowInt(LR);
  ShowBool((LA <=> LB) < 0);

  // ++ / -- as statements
  LA := 5;
  LA++;
  ShowInt(LA);
  ++LA;
  ShowInt(LA);
  LA--;
  ShowInt(LA);
  --LA;
  ShowInt(LA);
  // as values: postfix the old one, prefix the new one
  ShowInt(LA++);
  ShowInt(LA);
  ShowInt(++LA);
  ShowInt(LA--);
  ShowInt(--LA);
  // wrapping at every width
  LI8 := 127;
  LI8++;
  ShowInt(LI8);
  LI8--;
  ShowInt(LI8);
  LU8 := 255;
  ShowInt(++LU8);
  ShowInt(--LU8);
  LI16 := -32768;
  LI16--;
  ShowInt(LI16);
  LU16 := 65535;
  LU16++;
  ShowInt(LU16);
  LA := 2147483647;
  LA++;
  ShowInt(LA);
  LU := 0;
  LU--;
  ShowInt(LU);
  LBig := 9223372036854775807;
  LBig++;
  ShowInt(LBig);
  LU64 := 0u;
  LU64--;
  ShowUInt(LU64);
  // char and wchar
  LC := char(65);
  LC++;
  ShowInt(int64(LC));
  LW := wchar(65535);
  LW++;
  ShowInt(int64(LW));

  // compound assignments on int32
  LA := 10;
  LA += 5;
  ShowInt(LA);
  LA -= 20;
  ShowInt(LA);
  LA *= -3;
  ShowInt(LA);
  LA %= 4;
  ShowInt(LA);
  LA &= 2;
  ShowInt(LA);
  LA |= 5;
  ShowInt(LA);
  LA <<= 3;
  ShowInt(LA);
  LA >>= 2;
  ShowInt(LA);
  // a signed >>= is arithmetic, an unsigned one logical; an unsigned %=
  LA := -16;
  LA >>= 2;
  ShowInt(LA);
  LU := 4294967280;
  LU >>= 4;
  ShowInt(LU);
  LU := 4294967295;
  LU %= 10;
  ShowInt(LU);
  // 8 / 16-bit targets compute at int32 and truncate back
  LI8 := -128;
  LI8 %= -1;
  ShowInt(LI8);
  LI8 := 100;
  LI8 += 100;
  ShowInt(LI8);
  LU8 := 200;
  LU8 *= 2;
  ShowInt(LU8);
  LI8 := -128;
  LI8 >>= 1;
  ShowInt(LI8);
  LU8 := 128;
  LU8 <<= 1;
  ShowInt(LU8);
  LI16 := 300;
  LI16 *= 300;
  ShowInt(LI16);
  // a shift count of another type; 64-bit targets
  LCount := 4;
  LA := 1;
  LA <<= LCount;
  ShowInt(LA);
  LBig := 1;
  LBig <<= 40;
  ShowInt(LBig);
  LBig := -7;
  LBig %= 3;
  ShowInt(LBig);
  LBig += LA;
  ShowInt(LBig);
  LU64 := 18446744073709551615u;
  LU64 %= 1000u;
  ShowUInt(LU64);
  LU64 := 18446744073709551615u;
  LU64 >>= 60;
  ShowUInt(LU64);
end;

begin
  Run();
  exit(0);
end.
