-------------------------------------------------------------------------------
  arith_nameof_err.adam - Break step of arith_nameof (BNF sec 7, NM1): what
  nameof refuses, each SM0409 naming its signature: an integer, a float, a
  string, a bool and a record value (none a choices value, none a type); no
  argument and two.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe arith_nameof_err;

type
  Shade = choices(Light, Dark);

  Spot = record
    X: int32;
  end;

func Refused();
var
  LS: string;
  LSpot: Spot;
begin
  LS := nameof(7); // ERROR SM0409@16: 'nameof' takes (a choices value, or a type)
  LS := nameof(1.5); // ERROR SM0409@16: 'nameof' takes (a choices value, or a type)
  LS := nameof("ab"); // ERROR SM0409@16: 'nameof' takes (a choices value, or a type)
  LS := nameof(true); // ERROR SM0409@16: 'nameof' takes (a choices value, or a type)
  LS := nameof(LSpot); // ERROR SM0409@16: 'nameof' takes (a choices value, or a type)
  LS := nameof(); // ERROR SM0409@9: 'nameof' takes (a choices value, or a type)
  LS := nameof(Shade.Dark, Shade.Light); // ERROR SM0409@9: 'nameof' takes (a choices value, or a type)
end;

begin
  Refused();
end.
