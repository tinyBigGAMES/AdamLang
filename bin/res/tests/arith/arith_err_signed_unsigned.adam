-------------------------------------------------------------------------------
  arith_err_signed_unsigned.adam - Break step of the common type (AUD5): a
  signed operand that the usual arithmetic conversions would make unsigned
  is SM0251 naming the cast (int32 + uint32 meets at uint32, so -1 would
  become 4294967295), for arithmetic and comparisons, a negative constant
  too; a constant >= 0 converts exactly and stays silent.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe arith_err_signed_unsigned;

const
  KNeg: int32 = -2;
  KPos: int32 = 2;

var
  LA: int32 = -1;
  LU: uint32 = 1;
  LR: int64;
  LW: uint32;

begin
  LR := LA + LU; // ERROR SM0251@9
  LW := LU * KNeg; // ERROR SM0251@14
  LW := LU * KPos;
  if LA < LU then // ERROR SM0251@6
    println("less");
  end;
  println("{} {}", LR, LW);
end.
