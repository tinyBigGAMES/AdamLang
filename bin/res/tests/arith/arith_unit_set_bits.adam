-------------------------------------------------------------------------------
  arith_unit_set_bits.adam - a set of a unit's choices type cast to and
  from an integer in the module that imports it (F6a): the choices are
  numbered when the cast is judged, even though the program's own module is
  checked before the unit's (it gave SM0761 "0 is not": the members had no
  numbers yet); a bare set literal of them casts the same way.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | mods 5 true
  | options 36 true
  | literal 10 36
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe arith_unit_set_bits;

@addmodulepath "$P:res/tests/arith/fixtures";

import ArithSetUnit;

var
  LMods: Modifiers;
  LOptions: Options;
begin
  LMods := Modifiers(int32(5));
  println("mods {} {}", int32(LMods), LMods = [Modifier.Shift, Modifier.Alt]);
  LOptions := Options(uint32(36));
  println("options {} {}", uint32(LOptions), LOptions = [Option.Hidden, Option.Borderless]);
  println("literal {} {}", int32([Modifier.Ctrl, Modifier.Super]), int32([Option.Hidden, Option.Borderless]));
end.
