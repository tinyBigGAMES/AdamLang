-------------------------------------------------------------------------------
  arith_div.adam - Arith: division (M3.2d). div / mod and mod's spelling %
  truncate toward zero, the remainder taking the dividend's sign, for every
  sign of both operands; MIN div 1, MAX div -1; unsigned division at 32
  and 64 bits past the signed range; 8 / 16-bit operands divide as their
  promoted int32 (-128 div -1 is 128); a constant divisor. Values are shown
  through ucrtbase (_i64toa / _ui64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 3
  | 1
  | -3
  | -1
  | -3
  | 1
  | 3
  | -1
  | -1
  | -2147483648
  | 0
  | -2147483647
  | 2147483647
  | 5
  | 1
  | -9223372036854775808
  | -922337203685477580
  | -7
  | 1844674407370955161
  | 5
  | 128
  | 28
  | 4
  | -4681
  | -1
  | 33
  | 1
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe arith_div;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine _ui64toa(const AValue: uint64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue in decimal, unsigned, one line
routine ShowUInt(const AValue: uint64);
begin
  puts(_ui64toa(AValue, malloc(32), 10));
end;

routine Run();
var
  LA: int32;
  LB: int32;
  LU32: uint32;
  LV32: uint32;
  LBig: int64;
  LTen: int64;
  LU64: uint64;
  LTenU: uint64;
  LI8: int8;
  LJ8: int8;
  LU8: uint8;
  LV8: uint8;
  LI16: int16;
  LJ16: int16;
begin
  // int32, every sign of both operands: 7 / 2, -7 / 2, 7 / -2, -7 / -2 (quotient, then
  // remainder: toward zero, the remainder's sign the dividend's)
  LA := 7;
  LB := 2;
  ShowInt(LA div LB);
  ShowInt(LA mod LB);
  LA := -7;
  ShowInt(LA div LB);
  ShowInt(LA mod LB);
  LA := 7;
  LB := -2;
  ShowInt(LA div LB);
  ShowInt(LA mod LB);
  LA := -7;
  ShowInt(LA div LB);
  ShowInt(LA mod LB);
  // % is mod: -7 % 3
  LB := 3;
  ShowInt(LA % LB);
  // MIN div 1, MIN mod 1, MAX div -1
  LA := -2147483648;
  LB := 1;
  ShowInt(LA div LB);
  ShowInt(LA mod LB);
  LA := 2147483647;
  LB := -1;
  ShowInt(LA div LB);
  // uint32 past int32's range: 4294967295 div 2, mod 10, div 4294967294
  LU32 := 4294967295;
  LV32 := 2;
  ShowInt(LU32 div LV32);
  LV32 := 10;
  ShowInt(LU32 mod LV32);
  LV32 := 4294967294;
  ShowInt(LU32 div LV32);
  // int64: MIN div 1; -9223372036854775807 div 10, mod 10
  LBig := -9223372036854775807 - 1;
  LTen := 1;
  ShowInt(LBig div LTen);
  LBig := -9223372036854775807;
  LTen := 10;
  ShowInt(LBig div LTen);
  ShowInt(LBig mod LTen);
  // uint64 past int64's range: 18446744073709551615 div 10, mod 10
  LU64 := 18446744073709551615u;
  LTenU := 10u;
  ShowUInt(LU64 div LTenU);
  ShowUInt(LU64 mod LTenU);
  // 8 / 16-bit operands divide as int32: -128 div -1 is 128; 200 div 7, mod 7; -32768
  // div 7, mod 7
  LI8 := -128;
  LJ8 := -1;
  ShowInt(LI8 div LJ8);
  LU8 := 200;
  LV8 := 7;
  ShowInt(LU8 div LV8);
  ShowInt(LU8 mod LV8);
  LI16 := -32768;
  LJ16 := 7;
  ShowInt(LI16 div LJ16);
  ShowInt(LI16 mod LJ16);
  // A constant divisor
  LA := 100;
  ShowInt(LA div 3);
  ShowInt(LA mod 3);
end;

begin
  Run();
  exit(0);
end.
