-------------------------------------------------------------------------------
  arith_err_set_bits.adam - Break step of F6a's set <-> integer casts: a
  member's value that is no bit of the integer is SM0761 at the cast's
  operand, naming it: 16 in uint8, a negative member, a member valued 64
  (past every integer, either way round), a range set reaching 64; a float
  is still no cast of a set (SM0264). A uint8 into the set (any width goes
  in) and a set that fits stay silent.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe arith_err_set_bits;

type
  WindowFlag = choices(FullscreenMode = 1, Interlaced = 16);
  WindowFlags = set of WindowFlag;
  Signed = choices(Minus = -1, Zero);
  Signeds = set of Signed;
  Big = choices(Low, High = 64);
  Bigs = set of Big;
  Wide = set of 60..64;

var
  LFlags: WindowFlags;
  LSigned: Signeds;
  LBig: Bigs;
  LWide: Wide;
  LByte: uint8;
  LWord: uint64;
  LFloat: float64;
begin
  LByte := uint8(LFlags); // ERROR SM0761@18
  LFlags := WindowFlags(LByte);
  LWord := uint64(LSigned); // ERROR SM0761@19
  LSigned := Signeds(LWord); // ERROR SM0761@22
  LWord := uint64(LBig); // ERROR SM0761@19
  LBig := Bigs(LWord); // ERROR SM0761@16
  LWord := uint64(LWide); // ERROR SM0761@19
  LFloat := float64(LFlags); // ERROR SM0264@21
  LWord := uint64(LFlags);
end.
