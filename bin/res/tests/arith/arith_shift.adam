-------------------------------------------------------------------------------
  arith_shift.adam - Arith: shifts (M3.2c). shl / shr and their spellings
  << / >> by counts 0, 1 and width - 1; a right shift of a signed value is
  arithmetic (sar), of an unsigned one logical (shr); 8 / 16-bit left
  operands shift as their promoted int32; a count keeps its own type
  (uint8 here) and a constant count works too. Values are shown through
  ucrtbase (_i64toa / _ui64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 1
  | 2
  | -2147483648
  | -4
  | -1
  | 2147483644
  | 1
  | -9223372036854775808
  | -1
  | 1
  | fffffffffffffff
  | -64
  | -16777216
  | -1
  | 1099511627776
  | 12
  | -4
  | 40
  | [Adam Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe arith_shift;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine _ui64toa(const AValue: uint64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue's bits in hex, one line
routine ShowHex(const AValue: uint64);
begin
  puts(_ui64toa(AValue, malloc(32), 16));
end;

routine Run();
var
  LA: int32;
  LN: int32;
  LU32: uint32;
  LBig: int64;
  LU64: uint64;
  LI8: int8;
  LU8: uint8;
  LI16: int16;
  LCount8: uint8;
begin
  // int32: counts 0, 1, 31 (1 shl 31 is MIN); a signed right shift keeps the sign
  LA := 1;
  LN := 0;
  ShowInt(LA shl LN);
  LN := 1;
  ShowInt(LA shl LN);
  LN := 31;
  ShowInt(LA shl LN);
  LA := -8;
  LN := 1;
  ShowInt(LA shr LN);
  LN := 31;
  ShowInt(LA shr LN);
  // uint32: 4294967288 = 0xFFFFFFF8, a logical right shift brings in zeroes
  LU32 := 4294967288;
  LN := 1;
  ShowInt(LU32 shr LN);
  LN := 31;
  ShowInt(LU32 shr LN);
  // int64 and uint64 at count 63, and 4
  LBig := 1;
  LN := 63;
  ShowInt(LBig shl LN);
  LBig := -1;
  ShowInt(LBig shr LN);
  LU64 := 18446744073709551615u;
  ShowHex(LU64 shr LN);
  LN := 4;
  ShowHex(LU64 shr LN);
  // 8 / 16-bit left operands shift as int32: -128 sar 1, 255 shl 24 (0xFF000000), -32768
  // sar 15
  LI8 := -128;
  LN := 1;
  ShowInt(LI8 shr LN);
  LU8 := 255;
  LN := 24;
  ShowInt(LU8 shl LN);
  LI16 := -32768;
  LN := 15;
  ShowInt(LI16 shr LN);
  // A uint8 count on an int64, the << / >> spellings, a constant count
  LBig := 1;
  LCount8 := 40;
  ShowInt(LBig shl LCount8);
  LA := 3;
  LN := 2;
  ShowInt(LA << LN);
  LA := -16;
  ShowInt(LA >> LN);
  LA := 5;
  ShowInt(LA shl 3);
end;

begin
  Run();
  exit(0);
end.
