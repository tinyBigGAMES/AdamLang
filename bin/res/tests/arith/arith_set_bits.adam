-------------------------------------------------------------------------------
  arith_set_bits.adam - Set <-> integer casts by the members' values as bit
  numbers (F6a, BNF sec 6), as C flag enums are (FLAG_X = 1 << n): a set of
  a choices type whose values start at 1 (bit 0 named by no member) to
  uint32 and back, the empty set, bits no member names left out on the way
  in (bit 0, bit 20), a member valued 63 through uint64, a range set
  (3..10) to uint16 and from -1 (every member), a set whose members fit
  uint8, and the cast as a C-style argument. Both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | flags 65542
  | empty 0
  | in true true true false false
  | back 65542
  | wide 9223372036854775809
  | wide in true false true
  | range 1032
  | range all 2040 true true
  | small 128
  | arg 65542
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe arith_set_bits;

type
  // raylib's ConfigFlags values: FLAG_FULLSCREEN_MODE = 0x2 is bit 1, so the member is 1
  WindowFlag = choices(FullscreenMode = 1, Resizable, Undecorated, Hidden, Minimized,
    Interlaced = 16);
  WindowFlags = set of WindowFlag;
  // A member valued 63: the top bit of a 64-bit integer
  Gesture = choices(Tap, DoubleTap, Hold, Wide = 63);
  Gestures = set of Gesture;
  // A range set: its values are its members
  Bits = set of 3..10;
  // Every value fits 8 bits
  Small = choices(First, Last = 7);
  Smalls = set of Small;

// A C-style flags parameter
func TakeFlags(const AFlags: uint32): uint32;
begin
  return AFlags;
end;

// C's flags as the set (bits no member names left out)
func FromC(const AFlags: uint32): WindowFlags;
begin
  return WindowFlags(AFlags);
end;

var
  LFlags: WindowFlags;
  LEmpty: WindowFlags;
  LBack: WindowFlags;
  LGestures: Gestures;
  LWide: uint64;
  LRange: Bits;
  LAll: Bits;
  LMinus: int32;
  LSmall: Smalls;
begin
  LFlags := [WindowFlag.FullscreenMode, WindowFlag.Resizable, WindowFlag.Interlaced];
  println("flags {}", uint32(LFlags));
  println("empty {}", uint32(LEmpty));
  // bit 0 (no member is 0) and bit 20 (past Interlaced) are left out
  LBack := FromC(uint32(1) | uint32(2) | uint32(4) | uint32(65536) | uint32(1048576));
  println("in {} {} {} {} {}", WindowFlag.FullscreenMode in LBack, WindowFlag.Resizable in LBack,
    WindowFlag.Interlaced in LBack, WindowFlag.Undecorated in LBack, WindowFlag.Hidden in LBack);
  println("back {}", uint32(LBack));
  LGestures := [Gesture.Tap, Gesture.Wide];
  LWide := uint64(LGestures);
  println("wide {}", LWide);
  LGestures := Gestures(LWide | uint64(4));
  println("wide in {} {} {}", Gesture.Wide in LGestures, Gesture.DoubleTap in LGestures,
    Gesture.Hold in LGestures);
  LRange := [3, 10];
  println("range {}", uint16(LRange));
  LMinus := -1;
  LAll := Bits(LMinus);
  println("range all {} {} {}", uint32(LAll), 3 in LAll, 10 in LAll);
  LSmall := [Small.Last];
  println("small {}", uint8(LSmall));
  println("arg {}", TakeFlags(uint32(LFlags)));
end.
