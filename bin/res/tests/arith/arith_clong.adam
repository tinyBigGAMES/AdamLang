-------------------------------------------------------------------------------
  arith_clong.adam - Arith: the builtin clong / culong (C's long and unsigned
  long), sized by the target: 4 bytes on win64. Size, the range ends, the
  unsigned wrap, a clink call through each (ucrtbase's labs takes and
  returns a long, strtoul returns an unsigned long), the implicit widenings,
  and the type C's integer rank gives a mixed expression (clong ranks above
  int32 at the same width), shown by the overload it picks. Values are shown
  through ucrtbase (_i64toa / _ui64toa + puts), as arith_cast's.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 4
  | 4
  | 2147483647
  | -2147483648
  | 4294967295
  | 0
  | 42
  | 4000000000
  | -7
  | 9
  | clong
  | clong
  | int64
  | int64
  | uint64
  | culong
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe arith_clong;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr to const char): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr to const char;
  external "ucrtbase";
routine _ui64toa(const AValue: uint64; const ABuffer: ptr; const ARadix: int32): ptr to const char;
  external "ucrtbase";
routine labs(const AValue: clong): clong; external "ucrtbase";
routine strtoul(const AText: ptr to const char; const AEnd: ptr; const ABase: int32): culong;
  external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue in decimal, one line
routine ShowUInt(const AValue: uint64);
begin
  puts(_ui64toa(AValue, malloc(32), 10));
end;

// The name of the builtin type an expression of that type picks (overloads, C++ linkage)
routine KindOf(const AValue: int32): ptr to const char;
begin
  return "int32";
end;

routine KindOf(const AValue: clong): ptr to const char;
begin
  return "clong";
end;

routine KindOf(const AValue: culong): ptr to const char;
begin
  return "culong";
end;

routine KindOf(const AValue: int64): ptr to const char;
begin
  return "int64";
end;

routine KindOf(const AValue: uint64): ptr to const char;
begin
  return "uint64";
end;

var
  LC: clong;
  LU: culong;
  LI: int32;
  LL: int64;
  LQ: uint64;

begin
  ShowInt(size(clong));
  ShowInt(size(culong));
  LC := 2147483647;
  ShowInt(LC);
  LI := -2147483647 - 1;
  LC := LI;
  ShowInt(LC);
  LU := 4294967295;
  ShowUInt(LU);
  LU := LU + 1;
  ShowUInt(LU);
  ShowInt(labs(-42));
  ShowUInt(strtoul("4000000000", nil, 10));
  LI := -7;
  LC := LI;
  LL := LC;
  ShowInt(LL);
  LU := 4294967295;
  LQ := LU - 4294967286u;
  ShowUInt(LQ);
  puts(KindOf(LI + LC));
  puts(KindOf(LC + LI));
  puts(KindOf(LC + LL));
  puts(KindOf(LL + LU));
  puts(KindOf(LU + LQ));
  puts(KindOf(LU + LU));
end.
