-------------------------------------------------------------------------------
  arith_clong_err_range.adam - Arith: clong / culong's range is the target's
  (32 bits on win64): a constant past either end is refused, a negative one
  meets culong refused, and a signed / unsigned mix needs a cast as any other
  (clong with culong meets at culong: the clong side is the one refused).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe arith_clong_err_range;

var
  LC: clong;
  LU: culong;
  LL: int64;

begin
  LC := 2147483648; // ERROR SM0200@9: 2147483648 does not fit in 'clong' (-2147483648..2147483647)
  LC := -2147483649; // ERROR SM0200@9: -2147483649 does not fit in 'clong' (-2147483648..2147483647)
  LU := 4294967296; // ERROR SM0200@9: 4294967296 does not fit in 'culong' (0..4294967295)
  LU := -1; // ERROR SM0200@9: -1 does not fit in 'culong' (0..4294967295)
  LU := LC + LU; // ERROR SM0251@9: '+' would convert signed 'clong' to unsigned 'culong': write culong(...)
  LC := LL; // ERROR SM0200@9: 'int64' does not convert implicitly to 'clong'; write clong(...)
end.
