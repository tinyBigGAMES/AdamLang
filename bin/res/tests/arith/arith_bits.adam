-------------------------------------------------------------------------------
  arith_bits.adam - Arith: the bit intrinsics (BNF sec 7, PLAN-ADAM M9j0).
  byteswap / leadingzeros / trailingzeros / popcount of run-time values of
  every integer width, signed and unsigned (a signed value's bits as they
  are), 0 counting its width, and the same intrinsics of constants folded
  (in typed consts and an array bound). Every level runs with the same
  output: the Show routines are public (each keeps its body, so the bit ops
  are selected at every level), Folded* are not (inlined at safe / fast /
  small, their constant argument folded through the optimizer's SCCP).
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | u8 171 0 0 5
  | u8 0 8 8 0
  | u8 1 7 0 1
  | u8 128 0 7 1
  | i8 -1 0 0 8
  | i8 -128 0 7 1
  | u16 13330 3 2 5
  | u16 0 16 16 0
  | i16 -257 0 1 15
  | u32 2018915346 3 3 13
  | u32 0 32 32 0
  | i32 -1 0 0 32
  | i32 16777216 31 0 1
  | u64 578437695752307201 7 3 13
  | u64 0 64 64 0
  | i64 -1 0 0 64
  | i64 6148914691236517205 1 0 32
  | u64 128 0 63 1
  | const 13330 31 64 8 4 -257
  | folded 65280 8 48 8
  | folded16 255 0 8 8
@@end
*/

module exe arith_bits;

const
  KSwap16: uint16 = byteswap(uint16(0x1234));
  KLead: int32 = leadingzeros(uint32(1));
  KTrail: int32 = trailingzeros(int64(0));
  KPop: int32 = popcount(0xFF);
  KSwapSigned: int16 = byteswap(int16(-2));

public func ShowU8(const AValue: uint8);
begin
  println("u8 {} {} {} {}", byteswap(AValue), leadingzeros(AValue), trailingzeros(AValue),
    popcount(AValue));
end;

public func ShowI8(const AValue: int8);
begin
  println("i8 {} {} {} {}", byteswap(AValue), leadingzeros(AValue), trailingzeros(AValue),
    popcount(AValue));
end;

public func ShowU16(const AValue: uint16);
begin
  println("u16 {} {} {} {}", byteswap(AValue), leadingzeros(AValue), trailingzeros(AValue),
    popcount(AValue));
end;

public func ShowI16(const AValue: int16);
begin
  println("i16 {} {} {} {}", byteswap(AValue), leadingzeros(AValue), trailingzeros(AValue),
    popcount(AValue));
end;

public func ShowU32(const AValue: uint32);
begin
  println("u32 {} {} {} {}", byteswap(AValue), leadingzeros(AValue), trailingzeros(AValue),
    popcount(AValue));
end;

public func ShowI32(const AValue: int32);
begin
  println("i32 {} {} {} {}", byteswap(AValue), leadingzeros(AValue), trailingzeros(AValue),
    popcount(AValue));
end;

public func ShowU64(const AValue: uint64);
begin
  println("u64 {} {} {} {}", byteswap(AValue), leadingzeros(AValue), trailingzeros(AValue),
    popcount(AValue));
end;

public func ShowI64(const AValue: int64);
begin
  println("i64 {} {} {} {}", byteswap(AValue), leadingzeros(AValue), trailingzeros(AValue),
    popcount(AValue));
end;

// Not public: inlined at safe / fast / small, AValue then a constant the optimizer folds
func Folded(const AValue: uint64);
begin
  println("folded {} {} {} {}", byteswap(AValue), leadingzeros(AValue), trailingzeros(AValue),
    popcount(AValue));
end;

// As Folded, of a narrow signed value (the widened counts fold too)
func Folded16(const AValue: int16);
begin
  println("folded16 {} {} {} {}", byteswap(AValue), leadingzeros(AValue), trailingzeros(AValue),
    popcount(AValue));
end;

func Run();
var
  LFixed: array[0..popcount(uint8(0x0F)) - 1] of int8;
begin
  ShowU8(0xAB);
  ShowU8(0);
  ShowU8(1);
  ShowU8(0x80);
  ShowI8(-1);
  ShowI8(-128);
  ShowU16(0x1234);
  ShowU16(0);
  ShowI16(-2);
  ShowU32(0x12345678);
  ShowU32(0);
  ShowI32(-1);
  ShowI32(1);
  ShowU64(0x0102030405060708);
  ShowU64(0);
  ShowI64(-1);
  ShowI64(0x5555555555555555);
  ShowU64(0x8000000000000000);
  println("const {} {} {} {} {} {}", KSwap16, KLead, KTrail, KPop, len(LFixed), KSwapSigned);
  Folded(0x00FF000000000000);
  Folded16(-256);
end;

begin
  // the heap report is a debug build's alone: off, so every level prints the same
  SetHeapReport(false);
  Run();
end.
