-------------------------------------------------------------------------------
  arith_set_literal_bits.adam - A set literal cast to an integer (BNF sec 6
  F6a, his (a) 2026-11-24, R1): no set type is needed, bit int64(M) set
  for each member M of its items, as a C flag mask: constant and run-time
  items, a span (none when it runs backwards), the members' own values (a
  flag enum's), parentheses, the empty literal (0); it agrees with the cast
  of the same members through their set type.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | const 5 span 14 empty 0
  | flags 36 36
  | run 8 12 0
  | each ok
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe arith_set_literal_bits;

type
  Pick = choices(A, B, C, D);
  WindowFlag = choices(Resizable = 2, Hidden = 7, VSync = 5);
  WindowFlags = set of WindowFlag;

const
  ALL: array[0..3] of Pick = [Pick.A, Pick.B, Pick.C, Pick.D];

var
  GFlags: WindowFlags;
  GAt: Pick;
  GLast: Pick;
  GOk: bool;
  GI: int64;

begin
  println("const {} span {} empty {}", uint8([Pick.A, Pick.C]), uint32([Pick.B .. Pick.D]),
    uint16([]));
  GFlags := [WindowFlag.Resizable, WindowFlag.VSync];
  println("flags {} {}", uint32([WindowFlag.Resizable, WindowFlag.VSync]), uint32(GFlags));
  GAt := Pick.D;
  GLast := Pick.C;
  println("run {} {} {}", uint64([GAt]), uint64(([GLast .. GAt])), uint64([GAt .. GLast]));
  GOk := true;
  for GI := 0 to 3 do
    if uint32([ALL[GI]]) <> (uint32(1) shl uint32(GI)) then
      GOk := false;
    end;
  end;
  if GOk then
    println("each ok");
  else
    println("each wrong");
  end;
end.
