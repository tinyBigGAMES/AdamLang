-------------------------------------------------------------------------------
  arith_clong_err_mangle.adam - Arith: a cpplink routine over clong / culong
  takes C++'s long / unsigned long in its Itanium name (codes l / m, as
  clang mangles them for this triple; the module is its namespace). A clink
  routine spelling that name takes the same symbol: the second definition
  is SM0024, naming the symbol (a C++ symbol: no longer only C ones, which
  reached the sections as a second definition and stopped the compiler).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe arith_clong_err_mangle;

public routine cpplink ClongPair(const AA: clong; const AB: culong): int32;
begin
  return int32(AA) + int32(AB);
end;

public routine clink _ZN22arith_clong_err_mangle9ClongPairElm(): int32; // ERROR SM0024@8: symbol '_ZN22arith_clong_err_mangle9ClongPairElm' is defined twice: 'arith_clong_err_mangle.ClongPair' defines it already
begin
  return 0;
end;

var
  LA: int32;
  LB: int32;

begin
  LA := ClongPair(1, 2);
  LB := _ZN22arith_clong_err_mangle9ClongPairElm();
  LA := LA + LB;
end.
