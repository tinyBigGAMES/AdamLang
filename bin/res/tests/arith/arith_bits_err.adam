-------------------------------------------------------------------------------
  arith_bits_err.adam - Break step of arith_bits (BNF sec 7, PLAN-ADAM M9j0):
  what a bit intrinsic refuses, each SM0409 naming its signature: a float, a
  bool, a char, a string and a choices value; no argument and two.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe arith_bits_err;

type
  Shade = choices(Light, Dark);

routine Refused();
var
  LN: int32;
begin
  LN := popcount(1.5); // ERROR SM0409@18: 'popcount' takes (an integer)
  LN := leadingzeros(true); // ERROR SM0409@22: 'leadingzeros' takes (an integer)
  LN := trailingzeros('a'); // ERROR SM0409@23: 'trailingzeros' takes (an integer)
  LN := byteswap("ab"); // ERROR SM0409@18: 'byteswap' takes (an integer)
  LN := popcount(Shade.Dark); // ERROR SM0409@18: 'popcount' takes (an integer)
  LN := popcount(); // ERROR SM0409@9: 'popcount' takes (an integer)
  LN := leadingzeros(1, 2); // ERROR SM0409@9: 'leadingzeros' takes (an integer)
end;

begin
  Refused();
end.
