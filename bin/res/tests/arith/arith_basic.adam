-------------------------------------------------------------------------------
  arith_basic.adam - Arith: mul, bitwise and / or / xor, unary minus, ~ and
  unary plus (M3.2b), and + / - through the same path. Each op at its
  width's edges with C++'s rules: 8 / 16-bit operands promote to int32, a
  signed and an unsigned operand of one width meet as unsigned, a wider
  operand widens the other, and every result wraps modulo 2^n (MIN * MIN,
  -MIN). Values are shown through ucrtbase (_i64toa / _ui64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | -2147479015
  | -42
  | -9223372036709301616
  | 1
  | 16384
  | 65025
  | 1073741824
  | 4294967294
  | fffffffffffffffd
  | 10000000000
  | 8
  | 14
  | 6
  | 255
  | -127
  | 127
  | 32768
  | -9223372036854775808
  | 8000000000000001
  | 8000000000000000
  | -2147483647
  | -2147483648
  | -2147483648
  | 128
  | 4294967295
  | -1
  | -1
  | -6
  | ffffffffffffffff
  | 255
  | -128
  | 2
  | -9223372036854775808
  | -2147483648
  | -1
@@end
*/

module exe arith_basic;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine _ui64toa(const AValue: uint64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue's bits in hex, one line
routine ShowHex(const AValue: uint64);
begin
  puts(_ui64toa(AValue, malloc(32), 16));
end;

routine Run();
var
  LA: int32;
  LB: int32;
  LNeg32: int32;
  LMin32: int32;
  LI8: int8;
  LU8: uint8;
  LI16: int16;
  LU16: uint16;
  LU32: uint32;
  LTwoU: uint32;
  LBig: int64;
  LNeg64: int64;
  LMin64: int64;
  LU64: uint64;
  LThree: uint64;
  LHigh: uint64;
  LOne: uint64;
  LZero64: uint64;
begin
  // mul: int32 wraps (46341^2 = 2147488281), int64 wraps (3037000500^2), uint32 and
  // uint64 wrap, 8 / 16-bit operands promote (no wrap at their width), uint32(-1) * 2
  // wraps as uint32 (int32 to uint32 is no implicit conversion: SM0200), int32 * int64 is
  // int64
  LA := 46341;
  LB := 46341;
  ShowInt(LA * LB);
  LA := -7;
  LB := 6;
  ShowInt(LA * LB);
  LBig := 3037000500;
  ShowInt(LBig * LBig);
  LU32 := 4294967295;
  ShowInt(LU32 * LU32);
  LI8 := -128;
  ShowInt(LI8 * LI8);
  LU8 := 255;
  ShowInt(LU8 * LU8);
  LI16 := -32768;
  ShowInt(LI16 * LI16);
  LNeg32 := -1;
  LTwoU := 2;
  ShowInt(uint32(LNeg32) * LTwoU);
  LU64 := 18446744073709551615u;
  LThree := 3u;
  ShowHex(LU64 * LThree);
  LA := 100000;
  LBig := 100000;
  ShowInt(LA * LBig);
  // and / or / xor: 12 = 1100, 10 = 1010; a promoted int8 -128 is 0xFFFFFF80, a promoted
  // int16 -32768 0xFFFF8000
  LA := 12;
  LB := 10;
  ShowInt(LA & LB);
  ShowInt(LA | LB);
  ShowInt(LA xor LB);
  LB := 255;
  ShowInt(LNeg32 & LB);
  LU8 := 1;
  ShowInt(LI8 | LU8);
  ShowInt(LI8 xor LNeg32);
  LU16 := 65535;
  ShowInt(LU16 & LI16);
  LBig := 9223372036854775807;
  LNeg64 := -1;
  ShowInt(LBig xor LNeg64);
  LHigh := 9223372036854775808u;
  LOne := 1u;
  ShowHex(LHigh | LOne);
  ShowHex(LHigh & LU64);
  // Unary minus wraps at MIN, a promoted int8 negates at 32 bits, a uint32 negates as
  // uint32; ~ complements the promoted value; unary plus promotes only
  LA := 2147483647;
  ShowInt(-LA);
  LMin32 := -LA - 1;
  ShowInt(LMin32);
  ShowInt(-LMin32);
  ShowInt(-LI8);
  LU32 := 1;
  ShowInt(-LU32);
  LA := 0;
  ShowInt(~LA);
  LU8 := 0;
  ShowInt(~LU8);
  LI16 := 5;
  ShowInt(~LI16);
  LZero64 := 0u;
  ShowHex(~LZero64);
  LU8 := 255;
  ShowInt(+LU8);
  ShowInt(+LI8);
  LNeg64 := -2;
  ShowInt(-LNeg64);
  LMin64 := -LBig - 1;
  ShowInt(-LMin64);
  // + and - on the same path: int32 wraps, a promoted uint8 goes below zero
  LA := 2147483647;
  LB := 1;
  ShowInt(LA + LB);
  LU8 := 0;
  ShowInt(LU8 - LB);
end;

begin
  Run();
  exit(0);
end.
