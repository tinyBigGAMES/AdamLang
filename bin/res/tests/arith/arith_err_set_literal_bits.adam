-------------------------------------------------------------------------------
  arith_err_set_literal_bits.adam - Break step of a set literal cast to an
  integer (F6a, R1): its items' choices type must have every value a bit
  of the integer (SM0761 at the literal: 16 in uint8, a value of 64), its
  items are one choices type (SM0200), and items of no choices type have
  no bits (SM0264).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe arith_err_set_literal_bits;

type
  Flag = choices(Low = 1, High = 16);
  Big = choices(Small, Huge = 64);
  Other = choices(One);

var
  LByte: uint8;
  LWord: uint64;

begin
  LByte := uint8([Flag.Low]); // ERROR SM0761@18
  LWord := uint64([Big.Small]); // ERROR SM0761@19
  LWord := uint64([Flag.Low, Other.One]); // ERROR SM0200@30
  LWord := uint64([1, 2]); // ERROR SM0264@20
  LWord := uint64([Flag.Low, Flag.High]);
end.
