-------------------------------------------------------------------------------
  arith_nameof.adam - nameof(X) (BNF sec 7, NM1): a choices value's name,
  folded for a constant (a const's initializer too) and found at run time
  for a value known only then (a cast of a variable, a parameter, a field),
  explicit values included; a value no name carries gives its number (a
  constant and a run-time one); a type's name: a declared type, an alias's
  own name, a builtin, a type written in place, a generic routine's type
  parameter named per instance. The run-time names are temporaries: nothing
  leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | const Dark Dark High
  | run Light Dark Blue
  | level Low High
  | unnamed 9 9 15
  | param Dark field High
  | joined kind=Blue!
  | types Shape Code int64 ptr to int32
  | generic Shape int32 Shade
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe arith_nameof;

type
  Shade = choices(Light, Dark, Blue);
  Level = choices(Low = 10, High = 20);
  Code = int32;

  Shape = object
    Sides: int32;
  end;

  Holder = record
    Rank: Level;
  end;

const
  // folded: a constant string
  DARK_NAME: string = nameof(Shade.Dark);

// A type parameter's name, per instance
func TypeName<T>(): string;
begin
  return nameof(T);
end;

// A parameter's value, named at run time
func ShadeName(const AShade: Shade): string;
begin
  return nameof(AShade);
end;

func Tests();
var
  LI: int32;
  LShade: Shade;
  LLevel: Level;
  LHolder: Holder;
  LText: string;
begin
  println("const {} {} {}", DARK_NAME, nameof(Shade.Dark), nameof(Level.High));
  print("run");
  for LI := 0 to 2 do
    LShade := Shade(LI);
    print(" {}", nameof(LShade));
  end;
  println("");
  LI := 10;
  LLevel := Level(LI);
  print("level {}", nameof(LLevel));
  LI := 20;
  println(" {}", nameof(Level(LI)));
  LI := 9;
  println("unnamed {} {} {}", nameof(Shade(9)), nameof(Shade(LI)), nameof(Level(LI + 6)));
  LHolder.Rank := Level.High;
  println("param {} field {}", ShadeName(Shade.Dark), nameof(LHolder.Rank));
  LShade := Shade.Blue;
  LText := "kind=" + nameof(LShade) + "!";
  println("joined {}", LText);
  println("types {} {} {} {}", nameof(Shape), nameof(Code), nameof(int64), nameof(ptr to int32));
  println("generic {} {} {}", TypeName<Shape>(), TypeName<int32>(), TypeName<Shade>());
end;

begin
  Tests();
  println("end");
end.
