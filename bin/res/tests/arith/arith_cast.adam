-------------------------------------------------------------------------------
  arith_cast.adam - Arith: conversions (M3.2a). Implicit widening by the
  source's signedness (int8 / int16 / int32 sign-extend, uint8 / uint16 /
  uint32 zero-extend), explicit casts that truncate (modulo 2^n, as C), char
  (signed) and wchar, a choices value, bool to an integer, and a pointer
  through uint64 and back. Values are shown through ucrtbase (_i64toa /
  _ui64toa + puts), so every line goes through the C runtime in order.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | -128
  | 255
  | -32768
  | 65535
  | -2147483648
  | 4294967295
  | 4294967295
  | 44
  | -56
  | 255
  | -1
  | 4294967294
  | fffffffffffffffe
  | -1
  | -56
  | 65535
  | 2
  | 1
  | 7
  | [Adam Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe arith_cast;

type
  Color = choices(Red, Green, Blue);

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine _ui64toa(const AValue: uint64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue's bits in hex, one line
routine ShowHex(const AValue: uint64);
begin
  puts(_ui64toa(AValue, malloc(32), 16));
end;

routine Run();
var
  LI8: int8;
  LU8: uint8;
  LI16: int16;
  LU16: uint16;
  LI32: int32;
  LU32: uint32;
  LBig: int64;
  LNeg32: int32;
  LNeg64: int64;
  LU64: uint64;
  LC: char;
  LW: wchar;
  LTwo: int32;
  LColor: Color;
  LB: bool;
  LText: ptr;
  LBits: uint64;
begin
  // Implicit widening to int64 at the argument
  LI8 := -128;
  ShowInt(LI8);
  LU8 := 255;
  ShowInt(LU8);
  LI16 := -32768;
  ShowInt(LI16);
  LU16 := 65535;
  ShowInt(LU16);
  LI32 := -2147483648;
  ShowInt(LI32);
  LU32 := 4294967295;
  ShowInt(LU32);
  ShowInt(int64(LU32));
  // Truncation: 300 = 0x12C -> 0x2C, 200 = 0xC8 -> -56
  LBig := 300;
  ShowInt(int8(LBig));
  LBig := 200;
  ShowInt(int8(LBig));
  LNeg32 := -1;
  ShowInt(uint8(LNeg32));
  ShowInt(int16(LU32));
  LNeg64 := -2;
  ShowInt(uint32(LNeg64));
  ShowHex(uint64(LNeg64));
  LU64 := 18446744073709551615u;
  ShowInt(int64(LU64));
  // char is signed: 200 -> -56; wchar is 16 bits unsigned: -1 -> 65535
  LI32 := 200;
  LC := char(LI32);
  ShowInt(int32(LC));
  LW := wchar(LNeg32);
  ShowInt(int64(LW));
  // A choices value from an integer and back
  LTwo := 2;
  LColor := Color(LTwo);
  ShowInt(int64(LColor));
  // bool to an integer is 0 / 1
  LB := true;
  ShowInt(int64(LB));
  // A pointer through uint64 and back
  LText := _i64toa(7, malloc(32), 10);
  LBits := uint64(LText);
  puts(ptr(LBits));
end;

begin
  Run();
  exit(0);
end.
