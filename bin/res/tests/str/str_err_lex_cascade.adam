-------------------------------------------------------------------------------
  str_err_lex_cascade.adam - one lexer fault, one error (AA.4): a string
  literal never closed is LX0001 and nothing more, neither in its constant
  declaration nor in its statement (no PR0001 for the ')' or ';' it took);
  the next declaration and the next statement start clean, so a real
  missing ';' after them is still PR0001
*******************************************************************************/

module exe str_err_lex_cascade;

/*
@@test
  kind error
@@end
*/

const
  CBroken: string = /* // ERROR LX0001@92: the string literal is not closed on its line */ "never closed;
  CFine: int32 = 3;

routine Run();
var
  LX: int32;
begin
  println(/* // ERROR LX0001@82: the string literal is not closed on its line */ "open);
  LX := CFine;
  LX := 2 // ERROR PR0001@10: expected ';', found 'println'
  println("{}", LX);
end;

begin
  Run();
end.
