-------------------------------------------------------------------------------
  str_core.adam - Strings as values (M3.8b, DESIGN sec 8): literals, string
  locals (empty to start, a literal initializer), assignment, copies that
  stay independent when either side is given a new value, concatenation of
  strings, literals and chars, the empty string, `LS := LS`, print / println
  with string arguments. Cleanup on every exit path: a return from inside a
  loop, the end after leave and skip, a later return; the [Heap] line counts
  every block a concatenation or a char's string made, all freed (a
  literal's block is constant: never counted).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | xyz abc
  | xyz-abc
  | xyz-abc!
  | xyz-abc! xyz-abc!?
  | [] init
  | xyz
  | r10
  | pxxx
  | r20
  | pxxx
  | r30
  | [Heap] Allocs: 22, Frees: 22, Leaked: 0
@@end
*/

module exe str_core;

// Copies, concatenation and the empty string: 6 blocks, every one freed at the exit
routine Copies();
var
  LA: string;
  LB: string;
  LS: string;
  LE: string;
  LInit: string = "init";
begin
  // A copy keeps its value when the original is given another
  LA := "abc";
  LB := LA;
  LA := "xyz";
  println("{} {}", LA, LB);

  // Two concatenations: 2 blocks
  LS := LA + "-" + LB;
  println("{}", LS);

  // A char's string and the concatenation: 2 blocks
  LS := LS + '!';
  println("{}", LS);

  // LB shares LS's block; LS then gets a new one (2 blocks): LB keeps the old text
  LB := LS;
  LS := LS + '?';
  println("{} {}", LB, LS);

  // Storing a variable's own value keeps it; the empty string prints nothing
  LS := LS;
  println("[{}] {}", LE, LInit);

  // Empty + a literal is the literal itself: no block
  LE := LE + LA;
  println("{}", LE);
end;

// A string grown in a loop, each pass a char's string and a concatenation; AMode 0 returns
// from inside the loop (4 blocks), 1 and 2 leave it at its third pass (6 blocks) and return
// later by two different returns
routine Paths(const AMode: int32): int32;
var
  LS: string;
  LI: int32;
begin
  LS := "p";
  for LI := 0 to 9 do
    LS := LS + 'x';
    if LI = 1 then
      if AMode = 0 then
        return 10;
      end;
      skip;
    end;
    if LI = 2 then
      leave;
    end;
  end;
  println("{}", LS);
  if AMode = 1 then
    return 20;
  end;
  return 30;
end;

routine Run();
begin
  Copies();
  if Paths(0) = 10 then
    println("r10");
  end;
  if Paths(1) = 20 then
    println("r20");
  end;
  if Paths(2) = 30 then
    println("r30");
  end;
end;

begin
  Run();
end.
