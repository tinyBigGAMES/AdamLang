  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_formatstr_runtime_range.adam - static arrays and sets under a format
  known only at run time (M3.8i3, BNF sec 7): the pack item's facts carry
  every level of the range (a static array's count and stride, a set's
  member range, each element's kind and facts), the runtime reads
  libc++'s range-format-spec when the call runs (fill, align, width, `n`,
  `s` / `?s`, the element's spec after `:`, nested levels) and writes
  what print's build-time range writers write. Each case is written by
  both paths, the literal and a string variable holding the same text,
  and the two compared (a DIFF line names a mismatch): arrays of every
  element form, nested arrays, sets of integers, chars, choices and bool,
  arrays of sets, widths from arguments at every level in the fields'
  numbering, ranges beside scalars, FormatStr in a loop; print / println
  too. Then every refusal libc++'s range_formatter gives when it runs,
  caught (code 1 and its text), print writing nothing before its raise,
  and the raises both paths share when they run. Leaked 0.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | [[[1, -20, 300]][1, -20, 300][[1, -14, 12c]][0x1, -0x14, 0x12c][[+0001, -0020, +0300]][   [1, -20, 300]][*[1:::, -20:, 300:]*][1, -20, 300 ][[  1, -20, 300]]]
  | [[[1, -20, 300]  ][[   1,  -20,  300]][1, -20, 300]]
  | [[[1, -20, 300]][             1,            -20,            300][ [1, -20, 300]]]
  | [[[33, 48, 90]][[100001, 110000, 1011010]][[!, 0, Z]][[21, 30, 5A]][éé[33, 48, 90]éé]]
  | [[[1.5, -0.25]][[1.50, -0.25]][1.500000e+00, -2.500000e-01][[     1.5,    -0.25]][[    1.5,    -0.2]]]
  | [[[true, false]][[1, 0]][true, false][[  true,  false]]]
  | [[[42]][42][[42] ]]
  | [[[1, -2, 3]][[+1, -2, +3]]]
  | [[[[1, 2, 3], [4, 5, 6]]][[1, 2, 3], [4, 5, 6]][[1, 2, 3, 4, 5, 6]][1, 2, 3, 4, 5, 6][[[1, 2, 3], [4, 5, 6]]][[[  1,   2,   3], [  4,   5,   6]]][[*[1, 2, 3]*, *[4, 5, 6]*]]]
  | [[[[  1,   2,   3], [  4,   5,   6]]][[[1, 2, 3]    , [4, 5, 6]    ]][[[ 1,  2,  3], [ 4,  5,  6]]]]
  | [[[[1, 2, 3]  , [4, 5, 6]  ]  ][[[1, 2, 3]  , [4, 5, 6]  ]][ 1,  2,  3,  4,  5,  6]]
  | [[["a", "b\"c", "中"]]["a", "b\"c", "中"][[a, b"c, 中]][[a, b"c, 中]][[   a,  b"c,   中]][["a", "b\"c", "中"]][["a", "b\"c", "中"]]["a", "b\"c", "中"][[a, b, ]]]
  | [[['h', 'i', '"', '\'']]['h', 'i', '"', '\''][hi"']["hi\"'"][    hi"'][**"hi\"'"***][[h, i, ", ']][[104, 105, 34, 39]][['h', 'i', '"', '\'']][[h, i, ", ']]]
  | [[中]["中"][中  ]["中"     ]]
  | [[['é', '\'']][[é, ']]['é', '\''][["w", "x\u{a0}"]][[w, x ]][[  w,  x ]]]
  | [[["p\"", nil]][[p", nil]]["p\"", nil][["qé\"", nil]][[qé", nil]][["qé\"", "nil"]][[  p",  nil]]]
  | [[[Green, Red, Color(7)]][[Green, Red, Color(7)]][Green, Red, Color(7)][[ Green,    Red, Color(7)]][["Green", "Red", "Color(7)"]]]
  | [[[["a", "b"], ["c", "d"]]][[["a", "b"], ["c", "d"]]][[[a, b], [c, d]]]["a", "b", "c", "d"][[["a", "b"], ["c", "d"]]][[["a", "b"], ["c", "d"]]]]
  | [[[1, 3, 4, 5]][1, 3, 4, 5][[1, 3, 4, 5]][0x1, 0x3, 0x4, 0x5][[+01, +03, +04, +05]][    [1, 3, 4, 5]][[1::, 3::, 4::, 5::]][1, 3, 4, 5  ][[ 1,  3,  4,  5]]]
  | [[[1, 3, 4, 5]   ][[  1,   3,   4,   5]][1, 3, 4, 5 ]]
  | [[[]][][[]   ][    ]]
  | [[[1, 50, 64, 65, 100]][[1, 110010, 1000000, 1000001, 1100100]][  1,  50,  64,  65, 100]]
  | [[[-3, 0, 3]][[-3, +0, +3]]]
  | [[['"', '\'', 'a', 'c']][[", ', a, c]]['"', '\'', 'a', 'c'][[", ', a, c]][[34, 39, 97, 99]][['"', '\'', 'a', 'c']][[  ",   ',   a,   c]][['"', '\'', 'a', 'c']   ]]
  | [[['\x{c8}', 'A', 'z']][[200, 65, 122]][['\x{c8}', 'A', 'z']][['\x{c8}', 'A', 'z']    ]]
  | [["'ac]["\"'ac"][  "'ac]]
  | [[[Red, Blue]][[Red, Blue]][Red, Blue][[   Red,   Blue]][["Red", "Blue"]][ [Red, Blue]  ]]
  | [[[false, true]][false, true][[0, 1]]]
  | [[[[0, 7], [2]]][[0, 7], [2]][[0, 7, 2]][[[0, 7], [2]]][[[0, 7]   , [2]      ]][[[0, 7]  , [2]     ]]]
  | [7| [1, -20, 300]|[   1,  -20,  300]|x]
  | [[*[1:::, -20:, 300:]*]["hi\"'"][  [1, 3, 4, 5]]]
  | [[*[1:::, -20:, 300:]*]["hi\"'"][  [1, 3, 4, 5]]]
  | [[[3, 4]][0, 1, 3, 4, 5]]
  | print path:
  | [[1, -20, 300]|1, 3, 4, 5|['h', 'i', '"', '\'']]
  | [[1, -20, 300]|1, 3, 4, 5|['h', 'i', '"', '\'']]
  | ["hi\"'"]
  | [[1, -20, 300]|1, 3, 4, 5|['h', 'i', '"', '\'']]
  | 1 [Type m requires a pair or a tuple with two elements]
  | 1 [Type s requires character type as formatting argument]
  | 1 [Type ?s requires character type as formatting argument]
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The width option should not have a leading zero]
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The fill option contains an invalid value]
  | 1 [The replacement field misses a terminating '}']
  | 1 [The replacement field misses a terminating '}']
  | 1 [The replacement field misses a terminating '}']
  | 1 [The argument index value is too large for the number of arguments supplied]
  | 1 [The replacement field misses a terminating '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The n option and type s can't be used together]
  | 1 [The n option and type ?s can't be used together]
  | 1 [Type s and an underlying format specification can't be used together]
  | 1 [Type ?s and an underlying format specification can't be used together]
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [Type s and an underlying format specification can't be used together]
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The type option contains an invalid value for an integer formatting argument]
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier for a character does not allow the sign option]
  | 1 [Type s requires character type as formatting argument]
  | 1 [Type ?s requires character type as formatting argument]
  | 1 [The type option contains an invalid value for an integer formatting argument]
  | 1 [Type m requires a pair or a tuple with two elements]
  | 1 [The n option and type s can't be used together]
  | 1 [Type ?s and an underlying format specification can't be used together]
  | 1 [Type ?s requires character type as formatting argument]
  | 1 [The type option contains an invalid value for a string formatting argument]
  | 1 [Type m requires a pair or a tuple with two elements]
  | 1 [An argument index may not have a negative value]
  | 1 [An argument index may not have a negative value]
  | 1 [An argument index may not have a negative value]
  | 1 [An argument index may not have a negative value]
  | 1 [Replacement argument isn't a standard signed or unsigned integer type]
  | 1 [Replacement argument isn't a standard signed or unsigned integer type]
  | 1 [Integral value outside the range of the char type]
  | 1 [Integral value outside the range of the char type]
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_formatstr_runtime_range;

type
  Color = choices(Red, Green, Blue);
  Ints = array[0..2] of int32;
  Letters = array[0..3] of char;
  Small = set of 0..7;
  Mid = set of 1..100;
  Chars = set of char;
  Colors = set of Color;
  Signed = set of -3..3;
  Bools = set of bool;

// ALiteral (the build-time path's text) and ARunTime (the run-time path's) compared: the
// text in brackets when they are the same, else both
routine Same(const ALiteral: string; const ARunTime: string);
begin
  if ALiteral = ARunTime then
    println("[{}]", ARunTime);
  else
    println("DIFF [{}] [{}]", ALiteral, ARunTime);
  end;
end;

// The raise FormatStr(AFormat, AValue) gives (its code and text), or "no raise" and the text
routine RaiseInts(const AFormat: string; const AValue: Ints);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInts' check with an int32 argument after the range
routine RaiseIntsWidth(const AFormat: string; const AValue: Ints; const AWidth: int32);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue, AWidth);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInts' check with a bool argument after the range
routine RaiseIntsBool(const AFormat: string; const AValue: Ints; const AWidth: bool);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue, AWidth);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInts' check for an array of char
routine RaiseLetters(const AFormat: string; const AValue: Letters);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInts' check for a set of a small integer range
routine RaiseSmall(const AFormat: string; const AValue: Small);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInts' check for a set of chars
routine RaiseChars(const AFormat: string; const AValue: Chars);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInts' check for a set of a choices type
routine RaiseColors(const AFormat: string; const AValue: Colors);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// Arrays of integers, floats, bools; one element; a char-bounded array; nested arrays
routine Arrays();
var
  LF: string;
  LI: Ints;
  LU: array[1..3] of uint8;
  LD: array[0..1] of float64;
  LB: array[0..1] of bool;
  LOne: array[5..5] of int64;
  LR: array['a'..'c'] of int16;
  LM: array[0..1] of Ints;
begin
  LI[0] := 1;
  LI[1] := -20;
  LI[2] := 300;
  LF := "[{}][{:n}][{::x}][{:n:#x}][{::+05}][{:>16}][{:*^20::<4}][{:12n}][{:<14:>3}]";
  Same(FormatStr("[{}][{:n}][{::x}][{:n:#x}][{::+05}][{:>16}][{:*^20::<4}][{:12n}][{:<14:>3}]",
    LI, LI, LI, LI, LI, LI, LI, LI, LI), FormatStr(LF, LI, LI, LI, LI, LI, LI, LI, LI, LI));
  LF := "[{:{}}][{::{}}][{:^{}n}]";
  Same(FormatStr("[{:{}}][{::{}}][{:^{}n}]", LI, 15, LI, 4, LI, 9),
    FormatStr(LF, LI, 15, LI, 4, LI, 9));
  LF := "[{0}][{0:n:{1}}][{0:>{1}}]";
  Same(FormatStr("[{0}][{0:n:{1}}][{0:>{1}}]", LI, 14), FormatStr(LF, LI, 14));
  LU[1] := 33;
  LU[2] := 48;
  LU[3] := 90;
  LF := "[{}][{::b}][{::c}][{::X}][{:é^16}]";
  Same(FormatStr("[{}][{::b}][{::c}][{::X}][{:é^16}]", LU, LU, LU, LU, LU),
    FormatStr(LF, LU, LU, LU, LU, LU));
  LD[0] := 1.5;
  LD[1] := -0.25;
  LF := "[{}][{::.2f}][{:n:e}][{::8}][{::{}.{}f}]";
  Same(FormatStr("[{}][{::.2f}][{:n:e}][{::8}][{::{}.{}f}]", LD, LD, LD, LD, LD, 7, 1),
    FormatStr(LF, LD, LD, LD, LD, LD, 7, 1));
  LB[0] := true;
  LB[1] := false;
  LF := "[{}][{::d}][{:n}][{::>6}]";
  Same(FormatStr("[{}][{::d}][{:n}][{::>6}]", LB, LB, LB, LB), FormatStr(LF, LB, LB, LB, LB));
  LOne[5] := 42;
  LF := "[{}][{:n}][{:5}]";
  Same(FormatStr("[{}][{:n}][{:5}]", LOne, LOne, LOne), FormatStr(LF, LOne, LOne, LOne));
  LR['a'] := 1;
  LR['b'] := -2;
  LR['c'] := 3;
  LF := "[{}][{::+}]";
  Same(FormatStr("[{}][{::+}]", LR, LR), FormatStr(LF, LR, LR));
  LM[0][0] := 1;
  LM[0][1] := 2;
  LM[0][2] := 3;
  LM[1][0] := 4;
  LM[1][1] := 5;
  LM[1][2] := 6;
  LF := "[{}][{:n}][{::n}][{:n:n}][{:::x}][{:>24:<12:>3}][{::*^11}]";
  Same(FormatStr("[{}][{:n}][{::n}][{:n:n}][{:::x}][{:>24:<12:>3}][{::*^11}]", LM, LM, LM, LM, LM,
    LM, LM), FormatStr(LF, LM, LM, LM, LM, LM, LM, LM));
  // every level's width from an argument: each nested level read again per element, its ids
  // the same each time
  LF := "[{:{}:{}:{}}][{::{}}][{:::{}}]";
  Same(FormatStr("[{:{}:{}:{}}][{::{}}][{:::{}}]", LM, 30, 12, 3, LM, 13, LM, 2),
    FormatStr(LF, LM, 30, 12, 3, LM, 13, LM, 2));
  LF := "[{0:{1}:{2}}][{0::{2}}][{0:n:n:{3}}]";
  Same(FormatStr("[{0:{1}:{2}}][{0::{2}}][{0:n:n:{3}}]", LM, 28, 11, 2),
    FormatStr(LF, LM, 28, 11, 2));
end;

// Arrays of strings, chars, wchars, wstrings, C texts, choices; nested arrays of strings
routine Texts();
var
  LF: string;
  LS: array[0..2] of string;
  LC: Letters;
  LH: array[0..2] of char;
  LW: array[0..1] of wchar;
  LT: array[0..1] of wstring;
  LP: array[0..1] of ptr to const char;
  LWP: array[0..1] of ptr to const wchar;
  LK: array[0..2] of Color;
  LSS: array[0..1] of array[0..1] of string;
begin
  LS[0] := "a";
  LS[1] := "b\"c";
  LS[2] := "\U00004E2D";
  LF := "[{}][{:n}][{::}][{::s}][{::>4}][{::?}][{:16}][{:^16n}][{::.1}]";
  Same(FormatStr("[{}][{:n}][{::}][{::s}][{::>4}][{::?}][{:16}][{:^16n}][{::.1}]", LS, LS, LS,
    LS, LS, LS, LS, LS, LS), FormatStr(LF, LS, LS, LS, LS, LS, LS, LS, LS, LS));
  LC[0] := 'h';
  LC[1] := 'i';
  LC[2] := '"';
  LC[3] := '\'';
  LF := "[{}][{:n}][{:s}][{:?s}][{:>8s}][{:*^12?s}][{::c}][{::d}][{::?}][{::}]";
  Same(FormatStr("[{}][{:n}][{:s}][{:?s}][{:>8s}][{:*^12?s}][{::c}][{::d}][{::?}][{::}]", LC, LC,
    LC, LC, LC, LC, LC, LC, LC, LC), FormatStr(LF, LC, LC, LC, LC, LC, LC, LC, LC, LC, LC));
  LH[0] := char(0xE4);
  LH[1] := char(0xB8);
  LH[2] := char(0xAD);
  LF := "[{:s}][{:?s}][{:4s}][{:{}?s}]";
  Same(FormatStr("[{:s}][{:?s}][{:4s}][{:{}?s}]", LH, LH, LH, LH, 9),
    FormatStr(LF, LH, LH, LH, LH, 9));
  LW[0] := wchar(0xE9);
  LW[1] := wchar(39);
  LT[0] := "w";
  LT[1] := "x\U000000A0";
  LF := "[{}][{::}][{:n}][{}][{::}][{::>3}]";
  Same(FormatStr("[{}][{::}][{:n}][{}][{::}][{::>3}]", LW, LW, LW, LT, LT, LT),
    FormatStr(LF, LW, LW, LW, LT, LT, LT));
  LP[0] := ptr to const char("p\"");
  LP[1] := nil;
  LWP[0] := ptr to const wchar("q\U000000E9\"");
  LWP[1] := nil;
  LF := "[{}][{::}][{:n}][{}][{::}][{::?}][{::>4}]";
  Same(FormatStr("[{}][{::}][{:n}][{}][{::}][{::?}][{::>4}]", LP, LP, LP, LWP, LWP, LWP, LP),
    FormatStr(LF, LP, LP, LP, LWP, LWP, LWP, LP));
  LK[0] := Color.Green;
  LK[1] := Color.Red;
  LK[2] := Color(7);
  LF := "[{}][{::}][{:n}][{::>6}][{::?}]";
  Same(FormatStr("[{}][{::}][{:n}][{::>6}][{::?}]", LK, LK, LK, LK, LK),
    FormatStr(LF, LK, LK, LK, LK, LK));
  LSS[0][0] := "a";
  LSS[0][1] := "b";
  LSS[1][0] := "c";
  LSS[1][1] := "d";
  LF := "[{}][{::}][{:::}][{:n:n}][{:16}][{:::?}]";
  Same(FormatStr("[{}][{::}][{:::}][{:n:n}][{:16}][{:::?}]", LSS, LSS, LSS, LSS, LSS, LSS),
    FormatStr(LF, LSS, LSS, LSS, LSS, LSS, LSS));
end;

// Sets of integers (an empty one, a negative low bound), chars, choices, bool; arrays of sets
routine Sets();
var
  LF: string;
  LS: Small;
  LE: Small;
  LM: Mid;
  LG: Signed;
  LC: Chars;
  LK: Colors;
  LB: Bools;
  LA: array[0..1] of Small;
begin
  LS := [1, 3..5];
  LF := "[{}][{:n}][{::x}][{:n:#x}][{::+03}][{:>16}][{:*^20::<3}][{:12n}][{:<14:>2}]";
  Same(FormatStr("[{}][{:n}][{::x}][{:n:#x}][{::+03}][{:>16}][{:*^20::<3}][{:12n}][{:<14:>2}]",
    LS, LS, LS, LS, LS, LS, LS, LS, LS), FormatStr(LF, LS, LS, LS, LS, LS, LS, LS, LS, LS));
  LF := "[{:{}}][{::{}}][{:^{}n}]";
  Same(FormatStr("[{:{}}][{::{}}][{:^{}n}]", LS, 15, LS, 3, LS, 11),
    FormatStr(LF, LS, 15, LS, 3, LS, 11));
  LF := "[{}][{:n}][{:5}][{:>4n}]";
  Same(FormatStr("[{}][{:n}][{:5}][{:>4n}]", LE, LE, LE, LE), FormatStr(LF, LE, LE, LE, LE));
  LM := [1, 50, 64, 65, 100];
  LF := "[{}][{::b}][{:n:3}]";
  Same(FormatStr("[{}][{::b}][{:n:3}]", LM, LM, LM), FormatStr(LF, LM, LM, LM));
  LG := [3, -3, 0];
  LF := "[{}][{::+}]";
  Same(FormatStr("[{}][{::+}]", LG, LG), FormatStr(LF, LG, LG));
  LC := ['a', 'c', '"', '\''];
  LF := "[{}][{::}][{:n}][{::c}][{::d}][{::?}][{::>3}][{:24}]";
  Same(FormatStr("[{}][{::}][{:n}][{::c}][{::d}][{::?}][{::>3}][{:24}]", LC, LC, LC, LC, LC, LC,
    LC, LC), FormatStr(LF, LC, LC, LC, LC, LC, LC, LC, LC));
  // char(200), Adam's lowest char member, only in forms that escape or number it (its plain
  // form is a lone byte no expect line holds)
  LC := ['z', char(200), 'A'];
  LF := "[{}][{::d}][{::?}][{:24}]";
  Same(FormatStr("[{}][{::d}][{::?}][{:24}]", LC, LC, LC, LC), FormatStr(LF, LC, LC, LC, LC));
  LC := ['a', 'c', '"', '\''];
  LF := "[{:s}][{:?s}][{:>6s}]";
  Same(FormatStr("[{:s}][{:?s}][{:>6s}]", LC, LC, LC), FormatStr(LF, LC, LC, LC));
  LK := [Color.Blue, Color.Red];
  LF := "[{}][{::}][{:n}][{::>6}][{::?}][{:^14}]";
  Same(FormatStr("[{}][{::}][{:n}][{::>6}][{::?}][{:^14}]", LK, LK, LK, LK, LK, LK),
    FormatStr(LF, LK, LK, LK, LK, LK, LK));
  LB := [true, false];
  LF := "[{}][{:n}][{::d}]";
  Same(FormatStr("[{}][{:n}][{::d}]", LB, LB, LB), FormatStr(LF, LB, LB, LB));
  LA[0] := [7, 0];
  LA[1] := [2];
  LF := "[{}][{:n}][{::n}][{:::x}][{:>18:<9}][{::{}}]";
  Same(FormatStr("[{}][{:n}][{::n}][{:::x}][{:>18:<9}][{::{}}]", LA, LA, LA, LA, LA, LA, 8),
    FormatStr(LF, LA, LA, LA, LA, LA, LA, 8));
end;

// Ranges beside scalars in one numbering; one format in a loop (its scratch strings emptied
// each time); a set expression; print / println with a run-time format
routine Mixed();
var
  LF: string;
  LI: Ints;
  LC: Letters;
  LS: Small;
  LK: int32;
begin
  LI[0] := 1;
  LI[1] := -20;
  LI[2] := 300;
  LC[0] := 'h';
  LC[1] := 'i';
  LC[2] := '"';
  LC[3] := '\'';
  LS := [1, 3..5];
  LF := "{}|{:>{}}|{:{}:{}}|{}";
  Same(FormatStr("{}|{:>{}}|{:{}:{}}|{}", 7, LI, 14, LI, 18, 4, "x"),
    FormatStr(LF, 7, LI, 14, LI, 18, 4, "x"));
  LF := "[{:*^20::<4}][{:?s}][{:>14}]";
  for LK := 1 to 2 do
    Same(FormatStr("[{:*^20::<4}][{:?s}][{:>14}]", LI, LC, LS), FormatStr(LF, LI, LC, LS));
  end;
  LF := "[{}][{:n}]";
  Same(FormatStr("[{}][{:n}]", LS * [3, 4, 7], LS + [0]), FormatStr(LF, LS * [3, 4, 7], LS + [0]));
  println("print path:");
  LF := "[{}|{:n:x}|{:>12}]";
  println("[{}|{:n:x}|{:>12}]", LI, LS, LC);
  println(LF, LI, LS, LC);
  print("[{:?s}]\n", LC);
  print(LF + "\n", LI, LS, LC);
end;

// Every refusal libc++'s range_formatter gives a spec when it runs, caught; print writing
// nothing before its raise; the raises both paths share (a width argument, an element's
// `c`), the literal path's first
routine Raises();
var
  LS: string;
  LF: string;
  LI: Ints;
  LC: Letters;
  LSet: Small;
  LChars: Chars;
  LColors: Colors;
  LNeg: int32;
begin
  LI[0] := 33;
  LI[1] := 300;
  LI[2] := 34;
  LC[0] := 'a';
  LC[1] := 'b';
  LC[2] := 'c';
  LC[3] := 'd';
  LSet := [1, 2];
  LChars := ['a'];
  LColors := [Color.Red];
  // the range's own fields and its type
  RaiseInts("{:m}", LI);
  RaiseInts("{:s}", LI);
  RaiseInts("{:?s}", LI);
  RaiseInts("{:?}", LI);
  RaiseInts("{:?x}", LI);
  RaiseInts("{:+}", LI);
  RaiseInts("{:#}", LI);
  RaiseInts("{:05}", LI);
  RaiseInts("{:.2}", LI);
  RaiseInts("{:nn}", LI);
  RaiseInts("{:{<5}", LI);
  RaiseInts("{:n", LI);
  RaiseInts("{:5", LI);
  RaiseInts("{:", LI);
  RaiseInts("{:{}}", LI);
  RaiseIntsWidth("{:{}", LI, 5);
  // s / ?s with n or an element spec
  RaiseLetters("{:?}", LC);
  RaiseLetters("{:ns}", LC);
  RaiseLetters("{:n?s}", LC);
  RaiseLetters("{:s:c}", LC);
  RaiseLetters("{:?s:c}", LC);
  RaiseLetters("{:sx}", LC);
  RaiseLetters("{:s:}", LC);
  // the element's spec, read by the element's own formatter
  RaiseInts("{::q}", LI);
  RaiseInts("{::s}", LI);
  RaiseInts("{:::}", LI);
  RaiseInts("{::5x5}", LI);
  RaiseInts("{::.1}", LI);
  RaiseLetters("{::+}", LC);
  // sets
  RaiseSmall("{:s}", LSet);
  RaiseSmall("{:?s}", LSet);
  RaiseSmall("{::?}", LSet);
  RaiseSmall("{:m}", LSet);
  RaiseChars("{:ns}", LChars);
  RaiseChars("{:?s:}", LChars);
  RaiseColors("{:?s}", LColors);
  RaiseColors("{::d}", LColors);
  // print writes nothing before its raise
  LF := "pre{:m}";
  guard
    println(LF, LI);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
  // the raises both paths give when they run: the literal path's, then the run-time path's
  LNeg := -1;
  guard
    LS := FormatStr("{:{}}", LI, LNeg);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
  RaiseIntsWidth("{:{}}", LI, LNeg);
  guard
    LS := FormatStr("{::{}}", LI, LNeg);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
  RaiseIntsWidth("{::{}}", LI, LNeg);
  guard
    LS := FormatStr("{:{}}", LI, true);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
  RaiseIntsBool("{:{}}", LI, true);
  guard
    LS := FormatStr("{::c}", LI);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
  RaiseInts("{::c}", LI);
end;

begin
  Arrays();
  Texts();
  Sets();
  Mixed();
  Raises();
  println("done {}", 0);
end.
