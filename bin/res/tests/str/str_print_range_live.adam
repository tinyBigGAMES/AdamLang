-------------------------------------------------------------------------------
  str_print_range_live.adam - the range scratch strings of a print / println
  / FormatStr end with their statement, as every other temporary does
  (M3.8g0b2): System.Runtime's HeapLive read before and after each statement
  shows nothing left live by a range with a width (one level and two), a
  FormatStr whose text a local keeps (its block only), the same print in a
  loop, a FormatStr in an if condition (ended before the branch runs), and a
  `?s` range of chars; the heap report clean at the end.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | [   [1, -20, 300]]
  | width 0
  | [[  [1, -20, 300],   [1, -20, 300]]]
  | two levels 0
  | formatstr kept 1
  | [[1, -20, 300]     ]
  | [ [1, -20, 300] ]
  | [ [1, -20, 300]  ]
  | [  [1, -20, 300]  ]
  | loop 0
  | condition 0
  | [    "hi"]
  | debug chars 0
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_print_range_live;

routine Show(const AWhat: string; const ABefore: int64);
begin
  println("{} {}", AWhat, HeapLive() - ABefore);
end;

routine Ranges();
var
  LI: array[0..2] of int32;
  LM: array[0..1] of array[0..2] of int32;
  LC: array[0..1] of char;
  LText: string;
  LBefore: int64;
  LK: int64;
begin
  LI[0] := 1;
  LI[1] := -20;
  LI[2] := 300;
  LM[0] := LI;
  LM[1] := LI;
  LC[0] := 'h';
  LC[1] := 'i';
  LBefore := HeapLive();
  println("[{:>16}]", LI);
  Show("width", LBefore);
  LBefore := HeapLive();
  println("[{:>34:>15}]", LM);
  Show("two levels", LBefore);
  LBefore := HeapLive();
  LText := FormatStr("[{:<18}]", LI);
  Show("formatstr kept", LBefore);
  println("{}", LText);
  LText := "";
  LBefore := HeapLive();
  for LK := 1 to 3 do
    println("[{:^{}}]", LI, 14 + LK);
  end;
  Show("loop", LBefore);
  LBefore := HeapLive();
  if len(FormatStr("{:>20}", LI)) = 20 then
    Show("condition", LBefore);
  end;
  LBefore := HeapLive();
  println("[{:>8?s}]", LC);
  Show("debug chars", LBefore);
end;

begin
  Ranges();
  println("done 0");
end.
