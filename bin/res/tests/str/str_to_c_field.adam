  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_to_c_field.adam - a string stored into a C string field (PLAN-RAVENAPI
  F4, BNF sec 6): a string of no constant text stored into a ptr to const
  char / uint8 field (a wstring into a ptr to const uint16 / wchar one) of a
  local or module variable, through value fields and static-array elements
  (a constant or a variable index), gives the field its own text, kept by
  the variable's hidden holder: the text stays readable after the string
  variable changes (copy on write) or is emptied, until the field is stored
  again (another string, nil, a C pointer) or the variable ends. A whole
  copy into another variable (an assignment, a local's initializer, one
  that comes before the store in a loop) carries the holder's texts; a copy
  from a value with no holder empties the target's. A func literal storing
  into a captured variable keeps the text with it. Scope ends, an early
  exit and an unwind release every holder: the [Heap] line. A wchar field
  is the UTF-32 copy where wchar_t is 32 bits. The same lines on both
  targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | local 5 hello
  | after 5 hello []
  | module 6 module
  | nested 4 100
  | items 3 two 5 three
  | loop 0 1 2
  | again 7 another
  | nil true
  | cptr 3 lit
  | copy 5 first 6 second
  | init 5 first
  | loopcopy 2 b1
  | emptied true 6 second
  | closure 7 closure
  | exit 4
  | unwind 6 raised
  | wide 3 233 3 55357
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_to_c_field;

import System.SysUtils;

@ifdef TARGET_X86_64_LINUX_GNU
func strlen(const AText: ptr to const char): uint64; external "c";
@else
func strlen(const AText: ptr to const char): uint64; external "ucrtbase";
@endif

type
  Item = record
    Label: ptr to const char;
    Size: int32;
  end;

  Inner = record
    Note: ptr to const uint8;
  end;

  Config = record
    Title: ptr to const char;
    Count: int32;
    Deep: Inner;
    Items: array[0..3] of Item;
  end;

  Wide = record
    Units: ptr to const uint16;
    Chars: ptr to const wchar;
  end;

  Action = ref func();

var
  GCfg: Config;

// AText as a string of no constant text (a new block: a constant's would be folded)
func Made(const AText: string): string;
begin
  return AText + "";
end;

// The C string AText as an Adam string (its bytes up to the NUL)
func TextOf(const AText: ptr to const char): string;
var
  LText: string;
  LN: int64;
begin
  LText := "";
  if AText = nil then
    return LText;
  end;
  LN := 0;
  while AText[LN] <> char(0) do
    LText := LText + AText[LN];
    LN := LN + 1;
  end;
  return LText;
end;

// The bytes of AText (unsigned char) before its NUL
func ByteCount(const AText: ptr to const uint8): int64;
var
  LN: int64;
begin
  LN := 0;
  while AText[LN] <> 0 do
    LN := LN + 1;
  end;
  return LN;
end;

// The wchar_t units of AText before its 0 unit
func UnitCount(const AText: ptr to const wchar): int64;
var
  LN: int64;
begin
  LN := 0;
  while AText[LN] <> wchar(0) do
    LN := LN + 1;
  end;
  return LN;
end;

// The UTF-16 units of AText before its 0 unit
func Utf16Count(const AText: ptr to const uint16): int64;
var
  LN: int64;
begin
  LN := 0;
  while AText[LN] <> 0 do
    LN := LN + 1;
  end;
  return LN;
end;

// A copy of a Config from no variable (a call's result): its fields hold no borrowed text
func Plain(): Config;
var
  LCfg: Config;
begin
  LCfg.Count := 1;
  return LCfg;
end;

// A text stored into a local's field, the routine left early: the holder freed at that exit
func EarlyExit(const AFlag: bool): int64;
var
  LCfg: Config;
  LName: string;
begin
  LName := Made("exit");
  LCfg.Title := LName;
  if AFlag then
    return int64(strlen(LCfg.Title));
  end;
  return 0;
end;

// A text stored into a local's field, then a raise: the holder freed as it unwinds
func Raises();
var
  LCfg: Config;
  LName: string;
begin
  LName := Made("raised");
  LCfg.Title := LName;
  println("unwind {} {}", strlen(LCfg.Title), TextOf(LCfg.Title));
  raise("raised");
end;

// A local initialized by a copy of one whose field holds a borrowed text: its own holder
func InitCopy();
var
  LA: Config;
  LName: string;
begin
  LName := Made("first");
  LA.Title := LName;
  var LB: Config = LA;
  LA.Title := nil;
  LName := "";
  println("init {} {}", strlen(LB.Title), TextOf(LB.Title));
end;

var
  LCfg: Config;
  LCopy: Config;
  LName: string;
  LOther: string;
  LI: int32;
  LLoop: Config;
  LSaved: Config;
  LRun: Action;
  LW: wstring;
  LWide: Wide;
begin
  // a local's field keeps the text it was given
  LName := Made("hello");
  LCfg.Title := LName;
  println("local {} {}", strlen(LCfg.Title), TextOf(LCfg.Title));
  LName[0] := 'j';
  LName := "";
  println("after {} {} [{}]", strlen(LCfg.Title), TextOf(LCfg.Title), LName);
  // a module variable's field
  GCfg.Title := Made("module");
  println("module {} {}", strlen(GCfg.Title), TextOf(GCfg.Title));
  // a nested record's field (ptr to const uint8)
  LCfg.Deep.Note := Made("deep");
  println("nested {} {}", ByteCount(LCfg.Deep.Note), LCfg.Deep.Note[0]);
  // static-array elements: a constant index, then a variable one
  LCfg.Items[2].Label := Made("two");
  LI := 3;
  LCfg.Items[LI].Label := Made("three");
  println("items {} {} {} {}", strlen(LCfg.Items[2].Label), TextOf(LCfg.Items[2].Label),
    strlen(LCfg.Items[LI].Label), TextOf(LCfg.Items[LI].Label));
  for LI := 0 to 2 do
    LCfg.Items[LI].Label := IntToStr(LI);
  end;
  println("loop {} {} {}", TextOf(LCfg.Items[0].Label), TextOf(LCfg.Items[1].Label),
    TextOf(LCfg.Items[2].Label));
  // stored again: the old text let go
  LCfg.Title := Made("another");
  println("again {} {}", strlen(LCfg.Title), TextOf(LCfg.Title));
  LCfg.Title := nil;
  println("nil {}", LCfg.Title = nil);
  LCfg.Title := "lit";
  println("cptr {} {}", strlen(LCfg.Title), TextOf(LCfg.Title));
  // a whole copy carries the holder's texts
  LCfg.Title := Made("first");
  LCopy := LCfg;
  LCfg.Title := Made("second");
  println("copy {} {} {} {}", strlen(LCopy.Title), TextOf(LCopy.Title), strlen(LCfg.Title),
    TextOf(LCfg.Title));
  InitCopy();
  LCopy := Plain();
  // a copy before the store, in a loop: the copy's holder is made from the store's
  for LI := 0 to 1 do
    LSaved := LLoop;
    LOther := "b" + IntToStr(LI);
    LLoop.Title := LOther;
  end;
  LSaved := LLoop;
  LOther := "";
  println("loopcopy {} {}", strlen(LSaved.Title), TextOf(LSaved.Title));
  // a copy from a value with no holder empties the target's
  println("emptied {} {} {}", LCopy.Title = nil, strlen(LCfg.Title), TextOf(LCfg.Title));
  // a func literal storing into a captured variable
  LRun := func()
  begin
    LCfg.Title := Made("closure");
  end;
  LRun();
  println("closure {} {}", strlen(LCfg.Title), TextOf(LCfg.Title));
  println("exit {}", EarlyExit(true));
  guard
    Raises();
  except
    // the raise reached here
  end;
  // a wstring into ptr to const uint16 (zero-copy) and ptr to const wchar fields
  LW := "héy";
  LW := LW + "";
  LWide.Units := LW;
  LWide.Chars := LW;
  LW := "h😀";
  LW := LW + "";
  LWide.Units := LW;
  println("wide {} {} {} {}", UnitCount(LWide.Chars), int64(LWide.Chars[1]), Utf16Count(LWide.Units),
    int64(LWide.Units[1]));
end.
