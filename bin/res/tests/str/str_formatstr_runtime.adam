  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_formatstr_runtime.adam - a format known only at run time (M3.8i1,
  BNF sec 7): any string that is no literal or string const is read when
  the call runs (the runtime's FormatRun over the arguments' typed pack).
  Each case is written by both paths, the build-time literal and a string
  variable holding the same text, and the two compared (a DIFF line names
  a mismatch): every scalar and text kind, choices (a name and an unnamed
  number), C strings and nil, pointers, `{n}`, `{{` / `}}`, an unnamed
  argument, the empty format, a format from a call, a concatenation and a
  parameter, print / println with a run-time format. Then every raise
  libc++'s parser gives a placeholder without a spec, caught (code 1 and
  its text), print writing nothing before it. Leaked 0.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | -128 255 -9223372036854775808 18446744073709551615 65535
  | -300 4000000000 -7 -5 7
  | true false [A] [é]
  | [hi] [wé] []
  | [abc] [nil] [nil]
  | 0x0 0x0
  | pointer same
  | routine same
  | Green Blue Color(7)
  | 1.5 0.1 1e+300 -0
  | b a b 10
  | {x} 5 }{
  | 8 9
  | 8 8
  | 1 unnamed
  | empty [] 0
  | no fields
  | <42>
  | ab 3
  | p 9
  | println 1 two
  | print 3.25
  | plain {}
  | 1 [The format string terminates at a '{']
  | 1 [The format string contains an invalid escape sequence]
  | 1 [The format string contains an invalid escape sequence]
  | 1 [The argument index should end with a ':' or a '}']
  | 1 [The format string terminates at a '{']
  | 1 [The argument index starts with an invalid character]
  | 1 [The argument index value is too large for the number of arguments supplied]
  | 1 [Using automatic argument numbering in manual argument numbering mode]
  | 1 [Using manual argument numbering in automatic argument numbering mode]
  | 1 [The argument index should end with a ':' or a '}']
  | 1 [The replacement field misses a terminating '}']
  | 1 [The replacement field misses a terminating '}']
  | 1 [The numeric value of the format specifier is too large]
  | 1 [The numeric value of the format specifier is too large]
  | 1 [The argument index value is too large for the number of arguments supplied]
  | 1 [The argument index value is too large for the number of arguments supplied]
  | no raise [ok 2 1]
  | print raised [The format string terminates at a '{']
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_formatstr_runtime;

type
  Color = choices(Red, Green, Blue);

// ALiteral (the build-time path's text) and ARunTime (the run-time path's) compared: the
// text when they are the same, else both
routine Same(const ALiteral: string; const ARunTime: string);
begin
  if ALiteral = ARunTime then
    println("{}", ARunTime);
  else
    println("DIFF [{}] [{}]", ALiteral, ARunTime);
  end;
end;

// The same check for a text that differs from run to run (an address): only ALabel
routine SameQuiet(const ALabel: string; const ALiteral: string; const ARunTime: string);
begin
  if ALiteral = ARunTime then
    println("{} same", ALabel);
  else
    println("DIFF {} [{}] [{}]", ALabel, ALiteral, ARunTime);
  end;
end;

// FormatStr over the format AFormat a parameter holds
routine FromParam(const AFormat: string; const AValue: int32): string;
begin
  return FormatStr(AFormat, AValue);
end;

// The raise FormatStr(AFormat, ..) gives with one or two arguments (ATwo): its code and
// its text, or "no raise"
routine Raises(const AFormat: string; const ATwo: bool);
var
  LS: string;
begin
  guard
    if ATwo then
      LS := FormatStr(AFormat, 1, 2);
    else
      LS := FormatStr(AFormat, 1);
    end;
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

var
  LF: string;
  LI64: int64;
  LU64: uint64;
  LW: wstring;
  LEmpty: string;
  LC: ptr to const char;
  LCNil: ptr to const char;
  LWNil: ptr to wchar;
  LP: ptr;
  LTyped: ptr to int32;
  LValue: int32;
  LColor: Color;
  LOut: string;
begin
  LI64 := -9223372036854775807 - 1;
  LU64 := 18446744073709551615u;
  LF := "{} {} {} {} {}";
  Same(FormatStr("{} {} {} {} {}", int8(-128), uint8(255), LI64, LU64, uint16(65535)),
    FormatStr(LF, int8(-128), uint8(255), LI64, LU64, uint16(65535)));
  LF := "{} {} {} {} {}";
  Same(FormatStr("{} {} {} {} {}", int16(-300), uint32(4000000000u), int32(-7), clong(-5), culong(7)),
    FormatStr(LF, int16(-300), uint32(4000000000u), int32(-7), clong(-5), culong(7)));
  LF := "{} {} [{}] [{}]";
  Same(FormatStr("{} {} [{}] [{}]", true, false, 'A', wchar(233)),
    FormatStr(LF, true, false, 'A', wchar(233)));
  LW := "wé";
  LEmpty := "";
  LF := "[{}] [{}] [{}]";
  Same(FormatStr("[{}] [{}] [{}]", "hi", LW, LEmpty), FormatStr(LF, "hi", LW, LEmpty));
  LC := ptr to const char("abc");
  LCNil := nil;
  LWNil := nil;
  LF := "[{}] [{}] [{}]";
  Same(FormatStr("[{}] [{}] [{}]", LC, LCNil, LWNil), FormatStr(LF, LC, LCNil, LWNil));
  LValue := 5;
  LTyped := addr of LValue;
  LP := nil;
  LF := "{} {}";
  Same(FormatStr("{} {}", LP, nil), FormatStr(LF, LP, nil));
  LF := "{} {}";
  SameQuiet("pointer", FormatStr("{} {}", LTyped, addr of LValue), FormatStr(LF, LTyped, addr of LValue));
  LF := "{}";
  SameQuiet("routine", FormatStr("{}", Same), FormatStr(LF, Same));
  LColor := Color.Blue;
  LF := "{} {} {}";
  Same(FormatStr("{} {} {}", Color.Green, LColor, Color(7)), FormatStr(LF, Color.Green, LColor, Color(7)));
  LF := "{} {} {} {}";
  Same(FormatStr("{} {} {} {}", 1.5, float32(0.1), 1e300, -0.0), FormatStr(LF, 1.5, float32(0.1), 1e300, -0.0));
  LF := "{1} {0} {1} {2}";
  Same(FormatStr("{1} {0} {1} {2}", 'a', 'b', 10), FormatStr(LF, 'a', 'b', 10));
  LF := "{{x}} {} }}{{";
  Same(FormatStr("{{x}} {} }}{{", 5), FormatStr(LF, 5));
  LF := "{:} {:}";
  Same(FormatStr("{:} {:}", 8, 9), FormatStr(LF, 8, 9));
  LF := "{0:} {0}";
  Same(FormatStr("{0:} {0}", 8), FormatStr(LF, 8));
  LF := "{} unnamed";
  Same(FormatStr("{} unnamed", 1, 2), FormatStr(LF, 1, 2));
  LF := "";
  LOut := FormatStr(LF, 3);
  println("empty [{}] {}", LOut, len(LOut));
  LF := "no fields";
  Same(FormatStr("no fields"), FormatStr(LF));
  Same(FormatStr("<{}>", 42), FormatStr(FormatStr("<{}{}>", "{", "}"), 42));
  Same(FormatStr("ab {}", 3), FormatStr("ab" + " {}", 3));
  Same(FormatStr("p {}", 9), FromParam("p {}", 9));
  LF := "println {} {}";
  println(LF, 1, "two");
  LF := "print {}\n";
  print(LF, 3.25);
  LF := "plain {{}}\n";
  print(LF);
  Raises("{", false);
  Raises("}", false);
  Raises("a}b", false);
  Raises("{0", false);
  Raises("{{{", false);
  Raises("{x}", false);
  Raises("{} {}", false);
  Raises("{0} {}", true);
  Raises("{} {0}", true);
  Raises("{01}", false);
  Raises("{:", false);
  Raises("{0:x", false);
  Raises("{99999999999}", false);
  Raises("{2147483648}", false);
  Raises("{2147483647}", false);
  Raises("{1}", false);
  Raises("ok {1} {0}", true);
  guard
    LF := "before {} {";
    print(LF, 1);
  except
    println("print raised [{}]", excmsg());
  end;
  println("done {}", 0);
end.
