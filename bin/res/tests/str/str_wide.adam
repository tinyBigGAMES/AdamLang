  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_wide.adam - wstring (M3.8d, DESIGN sec 8): UTF-16 units in the string
  block layout. Wide literals are type-driven (BNF sec 9: a literal that
  converts to wstring / wchar is UTF-16; a pair for a code point past
  U+FFFF), len counts units, utf8() turns a wstring into a string (an
  unpaired surrogate becomes U+FFFD, the empty wstring the empty string),
  values copy independently (copy on write), cleanup on every exit, concat
  (wstring, literal, wchar, an empty side), `+=`, comparisons (unit by unit,
  unsigned: U+E000 is above a pair's high unit, while its UTF-8 is below),
  index read and write, setlength (grow with zero units, shrink, 0, from
  empty) and a match on a wstring subject. The [Adam Heap] line counts every
  block made (a literal's block never), all freed.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | len units
  | pair units
  | wide char
  | abc héllo a😀b
  | utf8 empty
  | one One
  | One OnE
  | ONe
  | exit freed
  | abc-😀
  | abcx
  | empty side
  | éabc
  | abcabc abcabc!
  | eq lit
  | ne
  | lt
  | gt
  | le ge
  | prefix lt
  | empty lt
  | three way
  | unit order
  | byte order
  | hello he
  | grown zeros
  | h
  | emptied
  | from empty 3
  | is red
  | is green or blue
  | is green or blue
  | other
  | concat subject
  | x😀y
  | x�zy
  | x�zy
  | [Adam Heap] Allocs: 42, Frees: 42, Leaked: 0
@@end
*/

module exe str_wide;

// Wide literals: ASCII, a non-ASCII char, a pair (2 units), the empty wstring; a wide char
// literal (a non-ASCII one, into a wchar); utf8 of each (3 blocks, the empty one none)
routine Literals();
var
  LA: wstring;
  LB: wstring;
  LC: wstring;
  LE: wstring;
  LCh: wchar;
begin
  LA := "abc";
  LB := "héllo";
  LC := "a\U0001F600b";
  if (len(LA) = 3) and (len(LB) = 5) and (len(LC) = 4) and (len(LE) = 0) then
    println("len units");
  end;
  if (LC[1] = wchar(0xD83D)) and (LC[2] = wchar(0xDE00)) then
    println("pair units");
  end;
  LCh := 'é';
  if LB[1] = LCh then
    println("wide char");
  end;
  println("{} {} {}", utf8(LA), utf8(LB), utf8(LC));
  if utf8(LE) = "" then
    println("utf8 empty");
  end;
end;

// Values copy independently: a literal's block copied before a write (1 block), a shared
// block copied (1), a block held alone written in place; utf8 of each print (5)
routine Copies();
var
  LA: wstring;
  LB: wstring;
  LC: wstring;
begin
  LA := "one";
  LB := LA;
  LB[0] := 'O';
  println("{} {}", utf8(LA), utf8(LB));
  LA := LA;
  LC := LB;
  LC[2] := 'E';
  println("{} {}", utf8(LB), utf8(LC));
  LB[1] := 'N';
  println("{}", utf8(LB));
end;

// A return from inside a loop: a wchar's wstring and its join (2 blocks), then two turns of
// the loop (4: the char temporary's earlier block released by the next), all freed there
routine Exits(const AStop: int32);
var
  LW: wstring;
  LI: int32;
begin
  LW := "a";
  LW += 'b';
  for LI := 0 to 3 do
    LW += 'c';
    if LI = AStop then
      return;
    end;
  end;
  println("bad exit");
end;

// Concatenation: two joins (2 blocks), a wchar side (its wstring and the join: 2), an empty
// side (the other side itself: none), a literal side (1); utf8 of each print (3)
routine Concats();
var
  LA: wstring;
  LC: wstring;
  LE: wstring;
  LS: wstring;
begin
  LA := "abc";
  LC := "\U0001F600";
  LS := LA + "-" + LC;
  println("{}", utf8(LS));
  LS := LA + 'x';
  println("{}", utf8(LS));
  LS := LE + LA;
  if LS = LA then
    println("empty side");
  end;
  LS := "é" + LA;
  println("{}", utf8(LS));
end;

// `+=`: a literal onto the empty wstring is the literal itself (no block), a wchar (its
// wstring and the join: 2), the wstring itself (1), a copy then grown (1); utf8 (2)
routine Compound();
var
  LT: wstring;
  LU: wstring;
begin
  LT += "ab";
  LT += 'c';
  LT += LT;
  LU := LT;
  LU += "!";
  println("{} {}", utf8(LT), utf8(LU));
end;

// Comparisons: literals and locals, a prefix, the empty wstring, <=>; U+E000 against a
// pair's high unit (0xD83D): above as units, below as UTF-8 bytes (utf8: 2 blocks)
routine Compares();
var
  LA: wstring;
  LB: wstring;
  LE: wstring;
  LX: wstring;
  LY: wstring;
begin
  LA := "abc";
  LB := "abd";
  if LA = "abc" then
    println("eq lit");
  end;
  if LA <> LB then
    println("ne");
  end;
  if LA < LB then
    println("lt");
  end;
  if LB > LA then
    println("gt");
  end;
  if (LA <= "abc") and (LA >= "abc") then
    println("le ge");
  end;
  if "ab" < LA then
    println("prefix lt");
  end;
  if LE < LA then
    println("empty lt");
  end;
  if ((LA <=> LB) = -1) and ((LB <=> LA) = 1) and ((LA <=> LA) = 0) then
    println("three way");
  end;
  LX := "";
  LY := "\U0001F600";
  if LX > LY then
    println("unit order");
  end;
  if utf8(LX) < utf8(LY) then
    println("byte order");
  end;
end;

// len and setlength: a literal's block shrunk into a new one (1 block), grown in place with
// zero units, shrunk in place, emptied (freed), grown from empty (1); utf8 (3)
routine Lengths();
var
  LS: wstring;
  LT: wstring;
begin
  LS := "hello";
  LT := LS;
  setlength(LT, 2);
  println("{} {}", utf8(LS), utf8(LT));
  setlength(LT, 4);
  if (len(LT) = 4) and (LT[2] = wchar(0)) and (LT[3] = wchar(0)) then
    println("grown zeros");
  end;
  setlength(LT, 1);
  println("{}", utf8(LT));
  setlength(LT, 0);
  if len(LT) = 0 then
    println("emptied");
  end;
  setlength(LT, 3);
  if len(LT) = 3 then
    println("from empty 3");
  end;
end;

// A match on a wstring subject: each label compared exactly as units (a non-ASCII one too),
// several on one arm, else; a concatenation as the subject (1 block)
routine Matches();
var
  LS: wstring;
  LI: int32;
begin
  for LI := 0 to 3 do
    match LI of
      0: LS := "red";
      1: LS := "grün";
      2: LS := "blue";
    else
      LS := "gray";
    end;
    match LS of
      "red": println("is red");
      "grün", "blue": println("is green or blue");
    else
      println("other");
    end;
  end;
  match LS + "!" of
    "gray": println("bad subject");
    "gray!": println("concat subject");
  end;
end;

// utf8 of unpaired surrogates: a pair whole (1 block), its low unit overwritten (the
// literal's block copied: 1) leaves a lone high unit, then a lone low unit written in
// place; each U+FFFD (utf8: 2)
routine Surrogates();
var
  LW: wstring;
begin
  LW := "x\U0001F600y";
  println("{}", utf8(LW));
  LW[2] := 'z';
  println("{}", utf8(LW));
  LW[1] := wchar(0xDC00);
  println("{}", utf8(LW));
end;

begin
  Literals();
  Copies();
  Exits(1);
  println("exit freed");
  Concats();
  Compound();
  Compares();
  Lengths();
  Matches();
  Surrogates();
end.
