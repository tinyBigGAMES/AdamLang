  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_to_c_field_literal.adam - a record literal whose C string fields are
  given strings of no constant text (PLAN-RAVENAPI F4b, BNF sec 6): assigned
  whole to a local or module variable, or a field or element of one, or
  initializing one (a local, a statement's var, a module variable), each
  field borrows its string and the variable's holder keeps the text after
  the string variable changes; nested record literals and a static array
  literal's elements (of records, and of C strings) borrow the same way;
  assigned again, the old texts are let go; a field the literal leaves out
  holds nil. A wchar field is the UTF-32 copy where wchar_t is 32 bits.
  Scope ends and module teardown release every holder: the [Heap] line. The
  same lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | init 4 init 1
  | assign 6 assign 2 true
  | nested 1 a 4 deep
  | part 4 part
  | items 2 i0 2 i1 2
  | texts 2 t0 true
  | again 5 again
  | statement 4 stmt
  | module 6 module 3 gvar
  | wide 3 233 3 55357
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_to_c_field_literal;

@ifdef TARGET_X86_64_LINUX_GNU
func strlen(const AText: ptr to const char): uint64; external "c";
@else
func strlen(const AText: ptr to const char): uint64; external "ucrtbase";
@endif

type
  Item = record
    Label: ptr to const char;
    Size: int32;
  end;

  Inner = record
    Note: ptr to const char;
  end;

  Config = record
    Title: ptr to const char;
    Count: int32;
    Deep: Inner;
  end;

  Pair = array[0..1] of Item;

  Texts = record
    Lines: array[0..1] of ptr to const char;
  end;

  Wide = record
    Units: ptr to const uint16;
    Chars: ptr to const wchar;
  end;

// AText as a string of no constant text (a new block: a constant's would be folded)
func Made(const AText: string): string;
begin
  return AText + "";
end;

// The C string AText as an Adam string (its bytes up to the NUL)
func TextOf(const AText: ptr to const char): string;
var
  LText: string;
  LN: int64;
begin
  LText := "";
  if AText = nil then
    return LText;
  end;
  LN := 0;
  while AText[LN] <> char(0) do
    LText := LText + AText[LN];
    LN := LN + 1;
  end;
  return LText;
end;

// The wchar_t units of AText before its 0 unit
func UnitCount(const AText: ptr to const wchar): int64;
var
  LN: int64;
begin
  LN := 0;
  while AText[LN] <> wchar(0) do
    LN := LN + 1;
  end;
  return LN;
end;

// The UTF-16 units of AText before its 0 unit
func Utf16Count(const AText: ptr to const uint16): int64;
var
  LN: int64;
begin
  LN := 0;
  while AText[LN] <> 0 do
    LN := LN + 1;
  end;
  return LN;
end;

// A local initialized by a literal: its holder freed at the routine's end
func InitLocal();
var
  LCfg: Config = Config(Title: Made("init"), Count: 1);
begin
  println("init {} {} {}", strlen(LCfg.Title), TextOf(LCfg.Title), LCfg.Count);
end;

var
  GCfg: Config;
  GInit: Config = Config(Title: Made("gvar"), Count: 3);

var
  LCfg: Config;
  LName: string;
  LPair: Pair;
  LTexts: Texts;
  LW: wstring;
  LV: wstring;
  LWide: Wide;
begin
  InitLocal();
  // assigned whole: each field borrows, the field left out holds nil
  LName := Made("assign");
  LCfg := Config(Title: LName, Count: 2);
  LName := "";
  println("assign {} {} {} {}", strlen(LCfg.Title), TextOf(LCfg.Title), LCfg.Count, LCfg.Deep.Note = nil);
  // a nested record literal
  LCfg := Config(Title: Made("a"), Deep: Inner(Note: Made("deep")));
  println("nested {} {} {} {}", strlen(LCfg.Title), TextOf(LCfg.Title), strlen(LCfg.Deep.Note),
    TextOf(LCfg.Deep.Note));
  // a literal into a field of the variable
  LCfg.Deep := Inner(Note: Made("part"));
  println("part {} {}", strlen(LCfg.Deep.Note), TextOf(LCfg.Deep.Note));
  // a static array literal of record literals, one of C strings
  LPair := [Item(Label: Made("i0"), Size: 1), Item(Label: Made("i1"), Size: 2)];
  println("items {} {} {} {} {}", strlen(LPair[0].Label), TextOf(LPair[0].Label), strlen(LPair[1].Label),
    TextOf(LPair[1].Label), LPair[1].Size);
  LTexts := Texts(Lines: [Made("t0"), nil]);
  println("texts {} {} {}", strlen(LTexts.Lines[0]), TextOf(LTexts.Lines[0]), LTexts.Lines[1] = nil);
  // assigned again: the old texts let go
  LCfg := Config(Title: Made("again"));
  println("again {} {}", strlen(LCfg.Title), TextOf(LCfg.Title));
  // a statement's var initialized by a literal
  var LStmt: Config = Config(Title: Made("stmt"));
  println("statement {} {}", strlen(LStmt.Title), TextOf(LStmt.Title));
  // module variables: assigned, and initialized at the entry
  GCfg := Config(Title: Made("module"));
  println("module {} {} {} {}", strlen(GCfg.Title), TextOf(GCfg.Title), GInit.Count, TextOf(GInit.Title));
  // wstrings into ptr to const uint16 (zero-copy) and ptr to const wchar fields
  LW := "héy";
  LW := LW + "";
  LV := "h😀";
  LV := LV + "";
  LWide := Wide(Units: LV, Chars: LW);
  LW := "";
  LV := "";
  println("wide {} {} {} {}", UnitCount(LWide.Chars), int64(LWide.Chars[1]), Utf16Count(LWide.Units),
    int64(LWide.Units[1]));
end.
