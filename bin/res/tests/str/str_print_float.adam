-------------------------------------------------------------------------------
  str_print_float.adam - print / println write a float32 / float64 as
  std::format does (H4u3): the fewest digits that read back as the same
  value, fixed unless scientific is shorter (fixed on a tie, two exponent
  digits at least); the edges (the least denormal, the greatest finite),
  values computed at run time (1 / 3), powers of two whose nearest decimal
  misses but the next one up reads back (2^-1017, float32 2^87), infinities,
  NaNs and zeros of either sign.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0.1 1.5 100 1e+16
  | 123456789012345680 1e-04 0.001
  | 0.3333333333333333 0.6666666666666666
  | -2.5 123456 0.000123
  | 5e-324 1.7976931348623157e+308 9007199254740992
  | 1e+21 7.120236347223045e-307
  | inf -inf nan -nan -0
  | [0]
  | 0.1 16777216 0.33333334
  | 3.4028235e+38 1e-45 -0.75
  | 1.5474251e+26 inf -inf -0 nan
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_print_float;

// The float64 whose bits are ABits
routine Float64Of(const ABits: uint64): float64;
var
  LBits: uint64;
  LValue: ptr to const float64;
begin
  LBits := ABits;
  LValue := ptr to const float64(addr of LBits);
  return LValue[0];
end;

// The float32 whose bits are ABits
routine Float32Of(const ABits: uint32): float32;
var
  LBits: uint32;
  LValue: ptr to const float32;
begin
  LBits := ABits;
  LValue := ptr to const float32(addr of LBits);
  return LValue[0];
end;

routine Forms();
var
  LOne: float64;
  LThree: float64;
  LOne32: float32;
  LThree32: float32;
begin
  println("{} {} {} {}", 0.1, 1.5, 100.0, 1e16);
  println("{} {} {}", 1.2345678901234568e17, 0.0001, 0.001);
  LOne := 1.0;
  LThree := 3.0;
  println("{} {}", LOne / LThree, 2.0 / LThree);
  println("{} {} {}", -2.5, 123456.0, 0.000123);
  println("{} {} {}", Float64Of(1), Float64Of(0x7FEFFFFFFFFFFFFF), 9007199254740992.0);
  println("{} {}", 1e21, Float64Of(0x0060000000000000));
  println("{} {} {} {} {}", Float64Of(0x7FF0000000000000), Float64Of(0xFFF0000000000000u),
    Float64Of(0x7FF8000000000000), Float64Of(0xFFF8000000000000u), Float64Of(0x8000000000000000u));
  print("[{}]", 0.0);
  println("");
  LOne32 := float32(1.0);
  LThree32 := float32(3.0);
  println("{} {} {}", float32(0.1), float32(16777216.0), LOne32 / LThree32);
  println("{} {} {}", Float32Of(0x7F7FFFFF), Float32Of(1), float32(-0.75));
  println("{} {} {} {} {}", Float32Of(0x6B000000), Float32Of(0x7F800000), Float32Of(0xFF800000),
    Float32Of(0x80000000), Float32Of(0x7FC00000));
end;

begin
  Forms();
end.
