-------------------------------------------------------------------------------
  str_err_to_c_field.adam - Break step of str_to_c_field (PLAN-RAVENAPI F4,
  BNF sec 6): a string is stored into a C string field only where a hidden
  holder keeps its text, a field of this module's local or module variable
  reached through value fields and static-array elements. Through a pointer
  or a deref, into a var parameter's record, an object's field, a dynamic
  array's element or a plain pointer variable it is SM0759 naming CString;
  returning a variable whose field holds a borrowed string, or copying it
  into a dynamic array's element or a var parameter, is SM0760. Exit 1, no
  exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/str_err_to_c_field.adam" "-o" "."
  exitcode 1
  | <DIR>/str_err_to_c_field.adam(57,17): Error SM0759: a string stored into 'ACfg.Title' (a 'ptr to const char') would not be kept alive: only a field of this module's local or module variable, reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(87,18): Error SM0759: a string stored into 'LPtr^.Title' (a 'ptr to const char') would not be kept alive: only a field of this module's local or module variable, reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(88,18): Error SM0759: a string stored into 'LPtr->Title' (a 'ptr to const char') would not be kept alive: only a field of this module's local or module variable, reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(89,17): Error SM0759: a string stored into 'LObj.Title' (a 'ptr to const char') would not be kept alive: only a field of this module's local or module variable, reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(91,21): Error SM0759: a string stored into 'LList[...].Title' (a 'ptr to const char') would not be kept alive: only a field of this module's local or module variable, reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(92,12): Error SM0759: a string stored into 'LText' (a 'ptr to const char') would not be kept alive: only a field of this module's local or module variable, reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(73,11): Error SM0760: 'LCfg' holds strings borrowed by its C string fields: copying it into 'ACfg' would not keep them alive (copy it into a local or module variable of this module, or keep the texts in CStrings, System.SysUtils)
  | <DIR>/str_err_to_c_field.adam(94,15): Error SM0760: 'LCfg' holds strings borrowed by its C string fields: copying it into 'LList[...]' would not keep them alive (copy it into a local or module variable of this module, or keep the texts in CStrings, System.SysUtils)
  | <DIR>/str_err_to_c_field.adam(65,10): Error SM0760: 'LCfg' holds strings borrowed by its C string fields: returning it would not keep them alive (copy it into a local or module variable of this module, or keep the texts in CStrings, System.SysUtils)
@@end
*/

module exe str_err_to_c_field;

type
  Config = record
    Title: ptr to const char;
  end;

  Holder = object
    Title: ptr to const char;
  end;

func Fill(var ACfg: Config; const AName: string);
begin
  ACfg.Title := AName;
end;

func Back(const AName: string): Config;
var
  LCfg: Config;
begin
  LCfg.Title := AName;
  return LCfg;
end;

func Out(var ACfg: Config; const AName: string);
var
  LCfg: Config;
begin
  LCfg.Title := AName;
  ACfg := LCfg;
end;

var
  LName: string;
  LCfg: Config;
  LPtr: ptr to Config;
  LObj: Holder;
  LList: array of Config;
  LText: ptr to const char;
begin
  LName := "text";
  LName := LName + "";
  LPtr := addr of LCfg;
  LPtr^.Title := LName;
  LPtr->Title := LName;
  LObj.Title := LName;
  setlength(LList, 1);
  LList[0].Title := LName;
  LText := LName;
  LCfg.Title := LName;
  LList[0] := LCfg;
end.
