  | <DIR>/str_err_to_c_field.adam(106,18): Error SM0759: a string stored into 'LPtr^.Title' (a 'ptr to const char') would not be kept alive: only a field of a local variable or of a module variable (this module's, or another's public one), reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(107,18): Error SM0759: a string stored into 'LPtr->Title' (a 'ptr to const char') would not be kept alive: only a field of a local variable or of a module variable (this module's, or another's public one), reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(108,17): Error SM0759: a string stored into 'LObj.Title' (a 'ptr to const char') would not be kept alive: only a field of a local variable or of a module variable (this module's, or another's public one), reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(110,21): Error SM0759: a string stored into 'LList[...].Title' (a 'ptr to const char') would not be kept alive: only a field of a local variable or of a module variable (this module's, or another's public one), reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(111,12): Error SM0759: a string stored into 'LText' (a 'ptr to const char') would not be kept alive: only a field of a local variable or of a module variable (this module's, or another's public one), reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(91,24): Error SM0759: a string stored into 'Config.Title' (a 'ptr to const char') would not be kept alive: only a field of a local variable or of a module variable (this module's, or another's public one), reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(114,21): Error SM0759: a string stored into 'Config.Title' (a 'ptr to const char') would not be kept alive: only a field of a local variable or of a module variable (this module's, or another's public one), reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(115,29): Error SM0759: a string stored into 'Config.Title' (a 'ptr to const char') would not be kept alive: only a field of a local variable or of a module variable (this module's, or another's public one), reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(116,14): Error SM0759: a string stored into '[...][0]' (a 'ptr to const char') would not be kept alive: only a field of a local variable or of a module variable (this module's, or another's public one), reached through value fields and static-array elements, keeps the text it is given (keep it in a CString, System.SysUtils, where C holds it)
  | <DIR>/str_err_to_c_field.adam(81,11): Error SM0760: 'LCfg' holds strings borrowed by its C string fields: copying it into 'ACfg' would not keep them alive (copy it into a local or module variable, or keep the texts in CStrings, System.SysUtils)
  | <DIR>/str_err_to_c_field.adam(113,15): Error SM0760: 'LCfg' holds strings borrowed by its C string fields: copying it into 'LList[...]' would not keep them alive (copy it into a local or module variable, or keep the texts in CStrings, System.SysUtils)
  | <DIR>/str_err_to_c_field.adam(73,10): Error SM0760: 'LCfg' holds strings borrowed by its C string fields: returning it would not keep them alive (copy it into a local or module variable, or keep the texts in CStrings, System.SysUtils)
@@end
*/

module exe str_err_to_c_field;

type
  Config = record
    Title: ptr to const char;
  end;

  Holder = object
    Title: ptr to const char;
  end;

func Fill(var ACfg: Config; const AName: string);
begin
  ACfg.Title := AName;
end;

func Back(const AName: string): Config;
var
  LCfg: Config;
begin
  LCfg.Title := AName;
  return LCfg;
end;

func Out(var ACfg: Config; const AName: string);
var
  LCfg: Config;
begin
  LCfg.Title := AName;
  ACfg := LCfg;
end;

func Use(const ACfg: Config): bool;
begin
  return ACfg.Title <> nil;
end;

func Made(const AName: string): Config;
begin
  return Config(Title: AName);
end;

var
  LName: string;
  LCfg: Config;
  LPtr: ptr to Config;
  LObj: Holder;
  LList: array of Config;
  LText: ptr to const char;
  LTexts: array of ptr to const char;
begin
  LName := "text";
  LName := LName + "";
  LPtr := addr of LCfg;
  LPtr^.Title := LName;
  LPtr->Title := LName;
  LObj.Title := LName;
  setlength(LList, 1);
  LList[0].Title := LName;
  LText := LName;
  LCfg.Title := LName;
  LList[0] := LCfg;
  Use(Config(Title: LName));
  LList[0] := Config(Title: LName);
  LTexts := [LName];
end.
