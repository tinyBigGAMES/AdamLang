  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_to_c_arg.adam - a string argument borrowed as a C string (PLAN-RAVENAPI
  F3, BNF sec 6): a string of any kind (a local, a parameter, a module
  variable, a record field, an element, a concatenation, a call's result, a
  conditional) given to a value or const ptr to const char / uint8 / int8
  parameter, a wstring to a ptr to const uint16 (C's char16_t) one, passes
  its own text with no copy: C's strlen reads it, an empty string is a
  static NUL, a text holding a \0 ends there for C. A wstring to a ptr to
  const wchar is C's wchar_t string: its own text where wchar_t is 16 bits
  (x86_64-windows-gnu), a UTF-32 copy freed after the call where it is 32
  (x86_64-linux-gnu); a wide literal likewise (wcslen reads both). A module variable the callee drops while it
  reads the text is held by the call (the text read in full after the drop,
  freed at the call's end). A routine value and an overload pick take it too.
  The [Heap] line: no block made for any C string, all freed. The same lines
  on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | local 5 param 5
  | empty 0 0
  | nul 1
  | concat 9 call 4
  | field 6 element 3
  | cond 2 3
  | bytes 5 5
  | wide 5 233 0 5 5
  | utf16 3 55357 3
  | dropped 11 []
  | value 5 pick ptr
  | after 5 hello
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_to_c_arg;

import System.SysUtils;

@ifdef TARGET_X86_64_LINUX_GNU
func strlen(const AText: ptr to const char): uint64; external "c";
func wcslen(const AText: ptr to const wchar): uint64; external "c";
@else
func strlen(const AText: ptr to const char): uint64; external "ucrtbase";
func wcslen(const AText: ptr to const wchar): uint64; external "ucrtbase";
@endif

type
  Named = record
    Title: string;
  end;

  Counter = func(const AText: ptr to const char): int64;

var
  GText: string;

// The bytes of the C string AText before its NUL, counted by hand
func ByteCount(const AText: ptr to const uint8): int64;
var
  LN: int64;
begin
  LN := 0;
  while AText[LN] <> 0 do
    LN := LN + 1;
  end;
  return LN;
end;

// The bytes of the C string AText (signed char) before its NUL
func SignedCount(const AText: ptr to const int8): int64;
var
  LN: int64;
begin
  LN := 0;
  while AText[LN] <> 0 do
    LN := LN + 1;
  end;
  return LN;
end;

// The wchar_t units of the C wide string AText before its 0 unit
func UnitCount(const AText: ptr to const wchar): int64;
var
  LN: int64;
begin
  LN := 0;
  while AText[LN] <> wchar(0) do
    LN := LN + 1;
  end;
  return LN;
end;

// The UTF-16 units of the char16_t string AText before its 0 unit
func Utf16Count(const AText: ptr to const uint16): int64;
var
  LN: int64;
begin
  LN := 0;
  while AText[LN] <> 0 do
    LN := LN + 1;
  end;
  return LN;
end;

// The unit at AIndex of the wchar_t string AText, as a number
func WideAt(const AText: ptr to const wchar; const AIndex: int64): int64;
begin
  return int64(AText[AIndex]);
end;

// The unit at AIndex of the char16_t string AText
func Utf16At(const AText: ptr to const uint16; const AIndex: int64): int64;
begin
  return int64(AText[AIndex]);
end;

// GText dropped while its text, borrowed as AText, is read: the call holds it
func DropAndCount(const AText: ptr to const char): int64;
begin
  GText := "";
  return int64(strlen(AText));
end;

func Passed(const AText: string): int64;
begin
  return int64(strlen(AText));
end;

func Picked(const AText: ptr to const char): string;
begin
  return "ptr";
end;

func Picked(const AN: int32): string;
begin
  return "int";
end;

func CountC(const AText: ptr to const char): int64;
begin
  return int64(strlen(AText));
end;

var
  LS: string;
  LEmpty: string;
  LNul: string;
  LRec: Named;
  LList: array of string;
  LFlag: bool;
  LW: wstring;
  LNoW: wstring;
  LFn: Counter;
begin
  LS := "hel" + "lo";
  LS := LS + "";
  println("local {} param {}", strlen(LS), Passed(LS));
  LEmpty := "";
  println("empty {} {}", strlen(LEmpty), ByteCount(LEmpty));
  LNul := "a\0b";
  println("nul {}", strlen(LNul));
  println("concat {} call {}", strlen(LS + "!" + IntToStr(123)), strlen(IntToStr(1234)));
  LRec.Title := "record";
  setlength(LList, 2);
  LList[1] := "two" + "";
  println("field {} element {}", strlen(LRec.Title), strlen(LList[1]));
  LFlag := true;
  println("cond {} {}", strlen(LFlag ? "ab" : LS), strlen((not LFlag) ? LS : LList[1]));
  println("bytes {} {}", ByteCount(LS), SignedCount(LS));
  LW := "héllo";
  println("wide {} {} {} {} {}", UnitCount(LW), WideAt(LW, 1), UnitCount(LNoW), wcslen(LW),
    wcslen("héllo"));
  LW := "h😀";
  println("utf16 {} {} {}", Utf16Count(LW), Utf16At(LW, 1), Utf16Count("h😀"));
  GText := "dropped" + IntToStr(1234);
  println("dropped {} [{}]", DropAndCount(GText), GText);
  LFn := CountC;
  println("value {} pick {}", LFn(LS), Picked(LS));
  LS[0] := 'h';
  println("after {} {}", strlen(LS), LS);
end.
