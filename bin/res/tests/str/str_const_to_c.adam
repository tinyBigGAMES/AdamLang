-------------------------------------------------------------------------------
  str_const_to_c.adam - a constant expression of string type converts to a
  C string as its literal does (BNF sec 4 / 6: any expression folded to a
  string constant, not only a named one): a concatenation of literals and
  constants given to a ptr to const char parameter, stored into a C string
  field or a ptr to const char variable (a static text, no holder), a
  wstring constant expression to a ptr to const uint16 one. The same lines
  on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | arg 4 field 11 Adam 0.1
  | var 8 paren 2
  | wide 6
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_const_to_c;

@ifdef TARGET_X86_64_LINUX_GNU
func strlen(const AText: ptr to const char): uint64; external "c";
@else
func strlen(const AText: ptr to const char): uint64; external "ucrtbase";
@endif

const
  VERSION: string = "0.1";
  WIDE_HEAD: wstring = "wide";

type
  Config = record
    Title: ptr to const char;
  end;

// The UTF-16 units of AText before its 0 unit
func UTF16Count(const AText: ptr to const uint16): int64;
var
  LN: int64;
begin
  LN := 0;
  while AText[LN] <> 0 do
    LN := LN + 1;
  end;
  return LN;
end;

var
  LCFG: Config;
  LText: ptr to const char;
begin
  LCFG.Title := "Adam " + VERSION + " ok";
  println("arg {} field {} {} {}", strlen("ab" + "cd"), strlen(LCFG.Title), "Adam", VERSION);
  LText := VERSION + "-" + "beta";
  println("var {} paren {}", strlen(LText), strlen(("x" + "y")));
  println("wide {}", UTF16Count(WIDE_HEAD + "ly"));
end.
