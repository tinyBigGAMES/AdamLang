-------------------------------------------------------------------------------
  str_err_wide.adam - Break step of str_wide (M3.8e): a char literal beside a
  wchar takes the wchar form, but only a literal does: a char variable against
  a wchar meets at no type (SM0250); a literal no wchar unit holds is the
  parser's PR0054 alone (no second report on the comparison); a literal too
  large for a char beside a char stays SM0023; a char, a char literal or a
  wchar is no string or wstring value (SM0200: no implicit conversion).
  Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "<DIR>/str_err_wide.adam" "-o" "."
  exitcode 1
  | <DIR>/str_err_wide.adam(54,14): Error PR0054: invalid character literal: the character is too large for a char or a wchar
  | <DIR>/str_err_wide.adam(51,6): Error SM0250: operator '=' does not take 'char' and 'wchar'
  | <DIR>/str_err_wide.adam(60,9): Error SM0200: 'char' does not convert implicitly to 'string'
  | <DIR>/str_err_wide.adam(61,9): Error SM0200: 'char' does not convert implicitly to 'string'
  | <DIR>/str_err_wide.adam(62,9): Error SM0200: 'wchar' does not convert implicitly to 'wstring'
  | <DIR>/str_err_wide.adam(63,9): Error SM0200: 'char' does not convert implicitly to 'wstring'
  | <DIR>/str_err_wide.adam(57,14): Error SM0023: invalid character literal for 'char': the character is too large for a char
@@end
*/

module exe str_err_wide;

routine Forms();
var
  LS: string;
  LW: wstring;
  LC: char;
  LWc: wchar;
begin
  LW := "ab";
  LS := "ab";
  if LC = LWc then
    println("a");
  end;
  if LW[0] = '😀' then
    println("b");
  end;
  if LS[0] = 'é' then
    println("c");
  end;
  LS := LC;
  LS := 'z';
  LW := LWc;
  LW := 'q';
end;

begin
  Forms();
end.
