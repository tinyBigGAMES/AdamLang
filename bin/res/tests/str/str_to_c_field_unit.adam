-------------------------------------------------------------------------------
  str_to_c_field_unit.adam - a string stored into a C string field of
  another module's public variable (PLAN-RAVENAPI F4b, BNF sec 6): the
  unit's public module variables get their hidden holders at the unit's own
  compile (kept in its .acu), so a store from this module, through value
  fields and static-array elements, keeps its text after the string
  variable changes; the unit's own store too; a whole copy from the unit's
  variable into a local carries its texts, a local's copy into the unit's
  variable gives them to its holder, a record literal assigned to it
  borrows its strings into that holder. The unit's teardown releases the
  holders: the [Heap] line. The same lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | store 6 stored []
  | list 4 list 5 note1
  | unit 4 own!
  | copy 4 own! true
  | back 5 local
  | literal 3 lit 2 n0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_to_c_field_unit;

@addmodulepath "$P:res/tests/str/fixtures";

import StrCFieldUnit;

@ifdef TARGET_X86_64_LINUX_GNU
func strlen(const AText: ptr to const char): uint64; external "c";
@else
func strlen(const AText: ptr to const char): uint64; external "ucrtbase";
@endif

// AText as a string of no constant text (a new block: a constant's would be folded)
func Made(const AText: string): string;
begin
  return AText + "";
end;

var
  LName: string;
  LCopy: UConfig;
  LLocal: UConfig;
begin
  // a store into the unit's variable from here: its holder keeps the text
  LName := Made("stored");
  UCFG.Title := LName;
  LName := "";
  println("store {} {} [{}]", strlen(UCFG.Title), UTextOf(UCFG.Title), LName);
  // a static array's element, a nested static array's element
  UList[1].Title := Made("list");
  UList[0].Notes[1] := Made("note1");
  println("list {} {} {} {}", strlen(UList[1].Title), UTextOf(UList[1].Title),
    strlen(UList[0].Notes[1]), UTextOf(UList[0].Notes[1]));
  // the unit's own store
  USetTitle(Made("own") + "!");
  println("unit {} {}", strlen(UCFG.Title), UTextOf(UCFG.Title));
  // the unit's variable copied into a local: the local's holder takes the texts
  LCopy := UCFG;
  UCFG.Title := nil;
  println("copy {} {} {}", strlen(LCopy.Title), UTextOf(LCopy.Title), UCFG.Title = nil);
  // a local copied into the unit's variable: its holder takes the local's texts
  LLocal.Title := Made("local");
  UCFG := LLocal;
  LLocal.Title := nil;
  println("back {} {}", strlen(UCFG.Title), UTextOf(UCFG.Title));
  // a record literal assigned to the unit's variable borrows into its holder
  LName := Made("lit");
  UCFG := UConfig(Title: LName, Count: 2, Notes: [Made("n0"), nil]);
  LName := "";
  println("literal {} {} {} {}", strlen(UCFG.Title), UTextOf(UCFG.Title), UCFG.Count, UTextOf(UCFG.Notes[0]));
end.
