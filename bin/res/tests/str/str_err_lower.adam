-------------------------------------------------------------------------------
  str_err_lower.adam - Break step of str (M3.8b .. M3.8e): every string form
  whose milestone is later stops adam build with LW0001 at its node, never as
  pointer code: a dynamic array of strings (M3.9), a record holding one (its
  texts cannot be mapped yet, reported at the variable), a print argument
  that is no string and a wstring print argument (M3.8f). Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "<DIR>/str_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/str_err_lower.adam(45,3): Error LW0001: code generation does not handle type 'array of string' yet
  | <DIR>/str_err_lower.adam(47,3): Error LW0001: code generation does not handle the texts of type 'array of string' yet
  | <DIR>/str_err_lower.adam(49,17): Error LW0001: code generation does not handle a print argument of type 'int32' yet
  | <DIR>/str_err_lower.adam(50,17): Error LW0001: code generation does not handle a print argument of type 'wstring' yet
@@end
*/

module exe str_err_lower;

type
  TList = record
    Title: string;
    Items: array of string;
  end;

routine Forms();
var
  LD: array of string;
  LW: wstring;
  LL: TList;
begin
  println("{}", 5);
  println("{}", LW);
end;

begin
  Forms();
end.
