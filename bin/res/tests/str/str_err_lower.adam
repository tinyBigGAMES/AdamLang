-------------------------------------------------------------------------------
  str_err_lower.adam - Break step of str (M3.8b .. M3.8e): every string form
  whose milestone is later stops adam build with LW0001 at its node, never as
  pointer code: a print argument that is no string and a wstring print
  argument (M3.8f; dynamic arrays of strings and records holding them are
  M3.9a's, dyn\dyn_local). Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/str_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/str_err_lower.adam(39,17): Error LW0001: code generation does not handle a print argument of type 'int32' yet
  | <DIR>/str_err_lower.adam(40,17): Error LW0001: code generation does not handle a print argument of type 'wstring' yet
@@end
*/

module exe str_err_lower;

routine Forms();
var
  LW: wstring;
begin
  println("{}", 5);
  println("{}", LW);
end;

begin
  Forms();
end.
