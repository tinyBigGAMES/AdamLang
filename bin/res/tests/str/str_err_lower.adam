-------------------------------------------------------------------------------
  str_err_lower.adam - Break step of str (M3.8b .. M3.8e): every string form
  whose milestone is later stops adam build with LW0001 at its node, never as
  pointer code: a dynamic array print argument, of an integer and of strings
  (M3.9; static arrays and sets print since M3.8f6 / M3.8f6b; dynamic arrays
  of strings and records holding them are M3.9a's, dyn\dyn_local). Exit 1, no
  exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/str_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/str_err_lower.adam(41,17): Error LW0001: code generation does not handle a print argument of type 'array of int32' yet
  | <DIR>/str_err_lower.adam(42,17): Error LW0001: code generation does not handle a print argument of type 'array of string' yet
@@end
*/

module exe str_err_lower;

routine Forms();
var
  LD: array of int32;
  LT: array of string;
begin
  println("{}", LD);
  println("{}", LT);
end;

begin
  Forms();
end.
