-------------------------------------------------------------------------------
  str_err_lower.adam - Break step of str (M3.8b .. M3.8e): every string form
  whose milestone is later stops adam build with LW0001 at its node, never as
  pointer code: a set print argument and an array print argument (M3.8f6;
  dynamic arrays of strings and records holding them are M3.9a's,
  dyn\dyn_local). Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/str_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/str_err_lower.adam(43,17): Error LW0001: code generation does not handle a print argument of type 'Small' yet
  | <DIR>/str_err_lower.adam(44,17): Error LW0001: code generation does not handle a print argument of type 'array[0..1] of int32' yet
@@end
*/

module exe str_err_lower;

type
  Small = set of 0..7;

routine Forms();
var
  LS: Small;
  LA: array[0..1] of int32;
begin
  println("{}", LS);
  println("{}", LA);
end;

begin
  Forms();
end.
