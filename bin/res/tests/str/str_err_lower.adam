-------------------------------------------------------------------------------
  str_err_lower.adam - Break step of str (M3.8b, M3.8c): every string form
  whose milestone is later stops adam build with LW0001 at its node, never as
  pointer code: a module string variable, a string parameter, a write into a
  field's bytes, a `+=` on a field, an assignment to a field, setlength on a
  field (fields: M3.8e), a print argument that is no string. Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "<DIR>/str_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/str_err_lower.adam(46,3): Error LW0001: code generation does not handle type 'string' yet
  | <DIR>/str_err_lower.adam(48,14): Error LW0001: code generation does not handle type 'string' yet
  | <DIR>/str_err_lower.adam(59,3): Error LW0001: code generation does not handle a write through an index yet
  | <DIR>/str_err_lower.adam(60,3): Error LW0001: code generation does not handle the += operator yet
  | <DIR>/str_err_lower.adam(61,3): Error LW0001: code generation does not handle the := operator yet
  | <DIR>/str_err_lower.adam(62,3): Error LW0001: code generation does not handle setlength on the member access 'Title' yet
  | <DIR>/str_err_lower.adam(63,17): Error LW0001: code generation does not handle a print argument of type 'int32' yet
@@end
*/

module exe str_err_lower;

type
  TNamed = record
    Title: string;
  end;

var
  GS: string;

routine Take(const AText: string);
begin
end;

routine Forms();
var
  LA: string;
  LB: string;
  LR: TNamed;
begin
  LA := LB;
  LR.Title[0] := 'x';
  LR.Title += "x";
  LR.Title := LA;
  setlength(LR.Title, 2);
  println("{}", 5);
end;

begin
  Forms();
end.
