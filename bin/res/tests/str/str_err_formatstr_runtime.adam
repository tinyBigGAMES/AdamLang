-------------------------------------------------------------------------------
  str_err_formatstr_runtime.adam - Break step of str_formatstr_runtime
  (M3.8i1): any string is a format (BNF sec 7), any other type is SM0500 at
  the format, for print, println and FormatStr alike: an integer, a wstring
  (a variable, a parameter), a C string, a char. A run-time format still
  types its arguments when the program is built: SM0425 at an argument with
  no print form.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe str_err_formatstr_runtime;

type
  TRec = record
    X: int32;
  end;

func Forms(const AWide: wstring);
var
  LS: string;
  LN: int32;
  LW: wstring;
  LC: ptr to const char;
  LF: string;
  LR: TRec;
begin
  LS := FormatStr(LN, 1); // ERROR SM0500@19: format string 'LN' is of type 'int32', not string: print, println and FormatStr take their format as a string
  LS := FormatStr(LW, 1); // ERROR SM0500@19: format string 'LW' is of type 'wstring', not string: print, println and FormatStr take their format as a string
  println(AWide, 1); // ERROR SM0500@11: format string 'AWide' is of type 'wstring', not string: print, println and FormatStr take their format as a string
  print(LC, 1); // ERROR SM0500@9: format string 'LC' is of type 'ptr to const char', not string: print, println and FormatStr take their format as a string
  println('x'); // ERROR SM0500@11: format string ''x'' is of type 'char', not string: print, println and FormatStr take their format as a string
  LS := FormatStr(LF, LR); // ERROR SM0425@23: 'TRec' cannot be printed: print the fields of a record, object or overlay
end;

begin
  Forms("w");
end.
