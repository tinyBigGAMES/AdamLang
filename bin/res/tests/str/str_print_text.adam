  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_print_text.adam - text specs (M3.8f4), as libc++'s std::format writes
  them (truth: tests\probe\adam_fmt\fmt_text_oracle.pcpp): width and
  precision by display width over extended grapheme clusters (East Asian
  wide 2 columns, combining marks, emoji zwj sequences, flags, an emoji
  modifier, Hangul jamo, an indic conjunct; a precision never splits a
  cluster and rounds down past a wide one; a precision or width from an
  argument; a fill of any width counted as one column); the debug form `?`
  of strings (\t \n \r \" \\ kept, \u{...} for separators and others and an
  extend after an escape, \x{..} for each byte of ill-formed UTF-8, cut by
  the precision after escaping) and of chars (apostrophes, padded by bytes);
  a wchar, a wstring (an unpaired surrogate U+FFFD), a ptr to char / wchar
  (nil "nil") and a choices value through the string formatter; FormatStr;
  the empty string; a precision argument's three raises.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | [abc   ][   abc][  abc  ][abc***][abc][ab][ab    ][][   a][abc]
  | [a][ab   ][][  ab  ]
  | [ab][   ab]
  | [中文字  ][中][中文][][ 中文字  ][   中文][中文字][中文字]
  | [aéx  ][a][aé][aéx][  aé]
  | [👨‍👩‍👧  ][👨‍👩‍👧][][🇺🇸🇫🇷    ][🇺🇸🇫🇷][🇺🇸🇫🇷][👍🏽x ][👍🏽][👍🏽x]
  | [각z  ][][각][क्षिz  ][क्षि][क्षिz]
  | [中中ab中中][ab😀😀][ééééa]
  | ["a\tb\n\"q\"\\'"]["a\tb\n\"q\"\\'"]["a\t][  "a\tb\n\"q\"\\'"]["a\tb\n\"q\"\\'"*]
  | ["\u{1}\u{7f}\u{a0}\u{301}|\t\u{301}|á|\u{200b}\u{3000}é\r"]
  | ["中😀 🇺🇸"]["中😀 🇺🇸"    ]["中😀]
  | ["a\x{ff}\x{c3}x\x{ed}\x{a0}\x{80}\x{c0}\x{80}"][12][3]["a\x]
  | ['a']['a'  ][ 'a' ][*'a']
  | ['\'']['"']['\\']['\n']['\t']['\u{0}'][' ']['\x{c8}']['\x{c8}' ][  '\x{c8}']
  | [é  ][  é]["é"]["é"  ][é]
  | [中 ]["中"][][中]
  | [�  ]["�"]
  | ["\t"]
  | ["'"]
  | [a😀b   ][a][a😀]["a😀b\u{a0}"]["a😀b\u{a0}"]["a😀b]
  | [x�y  ]["x�y"]
  | [hi"  ][h]["hi\""][ "hi\""]
  | [nil  ]["nil"][n]
  | [wé\  ][wé]["wé\\"]
  | [nil  ]["nil"]
  | ["Green"]["Blue"  ][Red][   "G    ]["Color(7)"][Co]
  | [  ab   ]["a\tb"]["]
  | [   ][""][][*""*][    ]
  | [An argument index may not have a negative value]
  | [The value of the argument index exceeds its maximum value]
  | [Replacement argument isn't a standard signed or unsigned integer type]
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_print_text;

type
  Color = choices(Red, Green, Blue);

routine Plain();
var
  LS: string;
  LCjk: string;
  LComb: string;
  LFam: string;
  LFlags: string;
  LThumb: string;
  LJamo: string;
  LIndic: string;
begin
  LS := "abc";
  println("[{:6}][{:>6}][{:^7}][{:*<6}][{:s}][{:.2}][{:6.2}][{:.0}][{:>4.1}][{:.9}]", LS, LS, LS, LS, LS, LS, LS, LS, LS, LS);
  println("[{:.{}}][{:{}.{}}][{:.{}}][{:^{}.{}}]", LS, 1, LS, 5, 2, LS, 0, LS, 6, 2);
  println("[{0:.{1}}][{0:>{2}.{1}}]", LS, 2, 5);
  LCjk := "\U00004E2D\U00006587\U00005B57";
  println("[{:8}][{:.3}][{:.4}][{:.1}][{:^9}][{:>7.5}][{:.6}][{:-^4}]", LCjk, LCjk, LCjk, LCjk, LCjk, LCjk, LCjk, LCjk);
  LComb := "ae\U00000301x";
  println("[{:5}][{:.1}][{:.2}][{:.3}][{:>4.2}]", LComb, LComb, LComb, LComb, LComb);
  LFam := "\U0001F468\U0000200D\U0001F469\U0000200D\U0001F467";
  LFlags := "\U0001F1FA\U0001F1F8\U0001F1EB\U0001F1F7";
  LThumb := "\U0001F44D\U0001F3FDx";
  println("[{:4}][{:.2}][{:.1}][{:6}][{:.2}][{:.3}][{:4}][{:.2}][{:.3}]", LFam, LFam, LFam, LFlags, LFlags, LFlags, LThumb, LThumb, LThumb);
  LJamo := "\U00001100\U00001161\U000011A8z";
  LIndic := "\U00000915\U0000094D\U00000937\U0000093Fz";
  println("[{:5}][{:.1}][{:.2}][{:4}][{:.1}][{:.2}]", LJamo, LJamo, LJamo, LIndic, LIndic, LIndic);
  println("[{:\U00004E2D^6}][{:\U0001F600<4}][{:\U000000E9>5.1}]", "ab", "ab", "ab");
end;

routine Debug();
var
  LS: string;
  LBad: string;
  LC: char;
begin
  LS := "a\tb\n\"q\"\\'";
  println("[{:?}][{:16?}][{:.4?}][{:>18?}][{:*^17?}]", LS, LS, LS, LS, LS);
  LS := "\U00000001\U0000007F\U000000A0\U00000301|\t\U00000301|a\U00000301|\U0000200B\U00003000\U000000E9\r";
  println("[{:?}]", LS);
  LS := "\U00004E2D\U0001F600 \U0001F1FA\U0001F1F8";
  println("[{:?}][{:12?}][{:.5?}]", LS, LS, LS);
  // ill-formed UTF-8: a stray byte, a cut sequence, a surrogate's, an overlong one; its
  // width and precision by the bytes they write (one column per ill-formed sequence)
  LBad := "a";
  LBad := LBad + char(255);
  LBad := LBad + char(0xC3);
  LBad := LBad + "x";
  LBad := LBad + char(0xED);
  LBad := LBad + char(0xA0);
  LBad := LBad + char(0x80);
  LBad := LBad + char(0xC0);
  LBad := LBad + char(0x80);
  println("[{:?}][{}][{}][{:.4?}]", LBad, len(FormatStr("{:9}", LBad)), len(FormatStr("{:.3}", LBad)), LBad);
  LC := 'a';
  println("[{:?}][{:5?}][{:^5?}][{:*>4?}]", LC, LC, LC, LC);
  LC := '\'';
  print("[{:?}]", LC);
  LC := '"';
  print("[{:?}]", LC);
  LC := '\\';
  print("[{:?}]", LC);
  LC := char(10);
  print("[{:?}]", LC);
  LC := char(9);
  print("[{:?}]", LC);
  LC := char(0);
  print("[{:?}]", LC);
  LC := ' ';
  print("[{:?}]", LC);
  LC := char(200);
  println("[{:?}][{:9?}][{:>10?}]", LC, LC, LC);
end;

routine Wide();
var
  LW: wchar;
  LT: wstring;
  LCText: ptr to const char;
  LWText: ptr to const wchar;
begin
  LW := wchar(0xE9);
  println("[{:3}][{:>3}][{:?}][{:5?}][{:s}]", LW, LW, LW, LW, LW);
  LW := wchar(0x4E2D);
  println("[{:3}][{:?}][{:.1}][{:.2}]", LW, LW, LW, LW);
  LW := wchar(0xD800);
  println("[{:3}][{:?}]", LW, LW);
  LW := wchar(9);
  println("[{:?}]", LW);
  LW := wchar(39);
  println("[{:?}]", LW);
  LT := "a\U0001F600b\U000000A0";
  println("[{:7}][{:.2}][{:.3}][{:?}][{:9?}][{:.5?}]", LT, LT, LT, LT, LT, LT);
  LT := "x";
  LT := LT + wchar(0xDC00);
  LT := LT + "y";
  println("[{:5}][{:?}]", LT, LT);
  LCText := ptr to const char("hi\"");
  println("[{:5}][{:.1}][{:?}][{:>7?}]", LCText, LCText, LCText, LCText);
  LCText := nil;
  println("[{:5}][{:?}][{:.1}]", LCText, LCText, LCText);
  LWText := ptr to const wchar("w\U000000E9\\");
  println("[{:5}][{:.2}][{:?}]", LWText, LWText, LWText);
  LWText := nil;
  println("[{:5}][{:?}]", LWText, LWText);
  println("[{:?}][{:8?}][{:.3}][{:^9.2?}][{:?}][{:.2}]", Color.Green, Color.Blue, Color.Red, Color.Green, Color(7), Color(7));
end;

// FormatStr writes the same text; the empty string; a precision from an argument of 0; the
// three raises of a precision argument (negative, past the maximum, no integer)
routine Extra();
var
  LS: string;
  LE: string;
  LNeg: int32;
  LHuge: uint64;
begin
  LS := FormatStr("[{:^7.2}][{:?}][{:.1?}]", "abcd", "a\tb", "\U00004E2D\U00006587");
  println("{}", LS);
  LE := "";
  println("[{:3}][{:?}][{:.2}][{:*^4?}][{:4.{}}]", LE, LE, LE, LE, "abc", 0);
  LNeg := -1;
  guard
    LS := FormatStr("{:.{}}", "ab", LNeg);
  except
    println("[{}]", excmsg());
  end;
  LHuge := 18446744073709551615u;
  guard
    LS := FormatStr("{:.{}}", "ab", LHuge);
  except
    println("[{}]", excmsg());
  end;
  guard
    println("{:.{}}", Color.Red, true);
  except
    println("[{}]", excmsg());
  end;
end;

begin
  Plain();
  Debug();
  Wide();
  Extra();
end.
