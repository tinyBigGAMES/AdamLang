-------------------------------------------------------------------------------
  str_err_fmt.adam - Break step of str (M3.8f1): print / println checked as
  PaskalCPP's clang checks std::format when the program is built, each with
  PaskalCPP's code and text (witnessed by pcpp on
  tests\probe\adam_fmt\fmt_err.pcpp). SM0425 at an argument with no print form
  (a record, an array of records, an overload set); SM0500 at a format that
  is no string literal or string const holding one (a variable, a
  concatenation); SM0502 at a format that does not fit: a lone brace either
  way, automatic and manual ids mixed, an id past the arguments, a placeholder
  with no argument left, a spec its argument's form does not take (a type
  letter, zero padding or a precision on a string or an int, a sign on a
  choices value or a bool, `#` on a char, `L` on a string, `s` on a range of
  ints), a width taken from a bool, a char or a float, a leading zero in an
  id, a `{` fill, a `}` ending the spec early. A choices value's width from a
  bool is std::format's check when it runs (a handle): no error here. Exit 1,
  no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/str_err_fmt.adam" "-o" "."
  exitcode 1
  | <DIR>/str_err_fmt.adam(98,17): Error SM0425: 'TRec' cannot be printed: print the fields of a record, object or overlay
  | <DIR>/str_err_fmt.adam(99,17): Error SM0425: 'array[0..1] of TRec' cannot be printed: print the fields of a record, object or overlay
  | <DIR>/str_err_fmt.adam(100,17): Error SM0425: 'Twice' cannot be printed: an overload set or a method has no single address
  | <DIR>/str_err_fmt.adam(101,11): Error SM0500: format string 'LS' is not a string literal or a string const holding one: a format string is checked against its arguments when the program is built
  | <DIR>/str_err_fmt.adam(102,11): Error SM0500: format string '"a" + "b"' is not a string literal or a string const holding one: a format string is checked against its arguments when the program is built
  | <DIR>/str_err_fmt.adam(103,11): Error SM0502: format string CFmt does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(104,11): Error SM0502: format string "{" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(105,11): Error SM0502: format string "}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(106,11): Error SM0502: format string "{0} {}" does not fit the 2 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(107,11): Error SM0502: format string "{1}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(108,11): Error SM0502: format string "{}" does not fit the 0 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(109,11): Error SM0502: format string "{:x}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(110,11): Error SM0502: format string "{:05}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(111,11): Error SM0502: format string "{:.2}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(112,11): Error SM0502: format string "{:+}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(113,11): Error SM0502: format string "{:+}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(114,11): Error SM0502: format string "{:c}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(115,11): Error SM0502: format string "{:p}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(116,11): Error SM0502: format string "{:#}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(117,11): Error SM0502: format string "{:L}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(118,11): Error SM0502: format string "{:s}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(119,11): Error SM0502: format string "{:{}}" does not fit the 2 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(120,11): Error SM0502: format string "{:{}}" does not fit the 2 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(121,11): Error SM0502: format string "{:{}}" does not fit the 2 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(122,11): Error SM0502: format string "{00}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(123,11): Error SM0502: format string "{:{>5}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  | <DIR>/str_err_fmt.adam(124,11): Error SM0502: format string "{:}>5}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
@@end
*/

module exe str_err_fmt;

type
  TColor = choices(Red, Green, Blue);

  TRec = record
    X: int32;
  end;

const
  CFmt: string = "{} {}";

// An overload set: no single address to print
routine Twice(const AN: int32): int32;
begin
  return AN * 2;
end;

routine Twice(const AS: string): string;
begin
  return AS + AS;
end;

routine Forms();
var
  LS: string;
  LR: TRec;
  LRA: array[0..1] of TRec;
  LA: array[0..1] of int32;
begin
  println("{}", LR);
  println("{}", LRA);
  println("{}", Twice);
  println(LS, 1);
  println("a" + "b", 1);
  println(CFmt, 1);
  println("{", 1);
  println("}", 1);
  println("{0} {}", 1, 2);
  println("{1}", 1);
  println("{}");
  println("{:x}", "s");
  println("{:05}", "s");
  println("{:.2}", 1);
  println("{:+}", TColor.Red);
  println("{:+}", true);
  println("{:c}", 1.5);
  println("{:p}", 1);
  println("{:#}", 'c');
  println("{:L}", "s");
  println("{:s}", LA);
  println("{:{}}", 1, true);
  println("{:{}}", 1, 'c');
  println("{:{}}", 1, 1.5);
  println("{00}", 1);
  println("{:{>5}", 1);
  println("{:}>5}", 1);
  println("{:{}}", TColor.Red, true);
end;

begin
  Forms();
end.
