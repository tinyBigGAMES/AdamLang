-------------------------------------------------------------------------------
  str_formatstr_runtime_dynamic.adam - dynamic arrays under a format known
  only at run time (AUD3, BNF sec 7): the pack item's facts carry every
  level (the count read from the block when it runs), the runtime writing
  what print's build-time range writers write. Each case by both paths, the
  literal and a string variable holding the same text, compared (a DIFF
  line names a mismatch): brackets, `n`, an element spec, widths; an empty
  array; strings; `s` of chars; dynamic in static, static in dynamic,
  dynamic in dynamic; println too. Leaked 0.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | [[[1, -20, 300]][1, -20, 300][[1, -14, 12c]][   [1, -20, 300]][[  1, -20, 300]]]
  | [[[]][][[]  ]]
  | [[["a", "b"]][[a, b]][hi]]
  | [[[[1, 2], [3]]][[[1], []]][[[1, 2], [3, 4]]]]
  | [[1, -20, 300]]
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_formatstr_runtime_dynamic;

// ALiteral's text when ARunTime's is the same, else both after DIFF
routine Same(const ALiteral: string; const ARunTime: string);
begin
  if ALiteral = ARunTime then
    println("[{}]", ARunTime);
  else
    println("DIFF [{}] [{}]", ALiteral, ARunTime);
  end;
end;

routine Run();
var
  LF: string;
  LD: array of int32;
  LE: array of int32;
  LS: array of string;
  LC: array of char;
  LN: array of array of int32;
  LM: array[0..1] of array of int32;
  LP: array of array[0..1] of int32;
begin
  LD := [1, -20, 300];
  LF := "[{}][{:n}][{::x}][{:>16}][{:<14:>3}]";
  Same(FormatStr("[{}][{:n}][{::x}][{:>16}][{:<14:>3}]", LD, LD, LD, LD, LD),
    FormatStr(LF, LD, LD, LD, LD, LD));
  LF := "[{}][{:n}][{:4}]";
  Same(FormatStr("[{}][{:n}][{:4}]", LE, LE, LE), FormatStr(LF, LE, LE, LE));
  LS := ["a", "b"];
  LC := ['h', 'i'];
  LF := "[{}][{::}][{:s}]";
  Same(FormatStr("[{}][{::}][{:s}]", LS, LS, LC), FormatStr(LF, LS, LS, LC));
  LN := [[1, 2], [3]];
  LM[0] := [1];
  LP := [[1, 2], [3, 4]];
  LF := "[{}][{}][{}]";
  Same(FormatStr("[{}][{}][{}]", LN, LM, LP), FormatStr(LF, LN, LM, LP));
  LF := "[{}]";
  println(LF, LD);
end;

begin
  Run();
end.
