  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_ops.adam - String operators (M3.8c, DESIGN sec 8): = <> < <= > >= and
  <=> (bytes compared unsigned, the shorter first; a false outcome too), `+=`
  with a string, a literal, a char and the string itself, index read and
  write (copy on write: a shared block and a literal's block are copied, a
  block the variable holds alone is written in place; through `addr of` and
  a `++` step too), len, setlength (shrink, grow with zeros, the same length,
  0, from empty; a shared or literal block copied), and a match on a string
  subject (a variable, a concatenation; several labels, else). The [Adam
  Heap] line counts every block made, all freed: a literal's block is never
  counted, a resize in place makes none.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | eq lit
  | ne
  | lt
  | gt
  | le ge
  | prefix lt
  | empty lt
  | empty eq
  | not gt
  | unsigned bytes
  | three way
  | concat eq
  | abcabc abcabc!
  | read x
  | xyz Xyz
  | XYz
  | Lit
  | xyZ
  | xyZ xzZ
  | len 5
  | len 0
  | hello he
  | grown zeros
  | h
  | emptied
  | from empty 3
  | is red
  | is green or blue
  | is green or blue
  | other
  | concat subject
  | [Heap] Allocs: 13, Frees: 13, Leaked: 0
@@end
*/

module exe str_ops;

// Comparisons: literals and locals, a prefix, the empty string, a byte above 127 (unsigned),
// <=>, a concatenation as an operand (1 block)
routine Compares();
var
  LA: string;
  LB: string;
  LE: string;
begin
  LA := "abc";
  LB := "abd";
  if LA = "abc" then
    println("eq lit");
  end;
  if LA <> LB then
    println("ne");
  end;
  if LA < LB then
    println("lt");
  end;
  if LB > LA then
    println("gt");
  end;
  if (LA <= "abc") and (LA >= "abc") then
    println("le ge");
  end;
  if "ab" < LA then
    println("prefix lt");
  end;
  if LE < LA then
    println("empty lt");
  end;
  if LE = "" then
    println("empty eq");
  end;
  if LA > LB then
    println("bad gt");
  else
    println("not gt");
  end;
  LA := "a";
  LB := "é";
  if LA < LB then
    println("unsigned bytes");
  end;
  if ((LA <=> LB) = -1) and ((LB <=> LA) = 1) and ((LA <=> LA) = 0) then
    println("three way");
  end;
  if LA + "x" = "ax" then
    println("concat eq");
  end;
end;

// `+=`: a literal onto the empty string is the literal itself (no block), a char (its
// string and the join: 2 blocks), the string itself (1), a copy then grown (1)
routine Compound();
var
  LS: string;
  LT: string;
begin
  LS += "ab";
  LS += 'c';
  LS += LS;
  LT := LS;
  LT += "!";
  println("{} {}", LS, LT);
end;

// Index read and write: LA made on the heap (2 blocks), a shared block copied before its
// write (1), a block held alone written in place, a literal's block copied (1), a write
// through `addr of`, a `++` step on a shared block (1)
routine Indexing();
var
  LA: string;
  LB: string;
  LC: string;
  LD: string;
  LP: ptr to char;
begin
  LA := "xy";
  LA += 'z';
  if LA[0] = 'x' then
    println("read x");
  end;
  LB := LA;
  LB[0] := 'X';
  println("{} {}", LA, LB);
  LB[1] := 'Y';
  println("{}", LB);
  LC := "lit";
  LC[0] := 'L';
  println("{}", LC);
  LP := addr of LA[2];
  LP^ := 'Z';
  println("{}", LA);
  LD := LA;
  LD[1]++;
  println("{} {}", LA, LD);
end;

// len and setlength: a literal's block shrunk into a new one (1 block), grown in place with
// zeros, the same length, shrunk in place, emptied (freed), grown from empty (1)
routine Lengths();
var
  LS: string;
  LT: string;
begin
  LS := "hello";
  if len(LS) = 5 then
    println("len 5");
  end;
  if len(LT) = 0 then
    println("len 0");
  end;
  LT := LS;
  setlength(LT, 2);
  println("{} {}", LS, LT);
  setlength(LT, 4);
  if (len(LT) = 4) and (LT[2] = char(0)) and (LT[3] = char(0)) then
    println("grown zeros");
  end;
  setlength(LT, 4);
  setlength(LT, 1);
  println("{}", LT);
  setlength(LT, 0);
  if len(LT) = 0 then
    println("emptied");
  end;
  setlength(LT, 3);
  if len(LT) = 3 then
    println("from empty 3");
  end;
end;

// A match on a string subject: each label compared exactly, several on one arm, else; a
// concatenation as the subject (1 block)
routine Matches();
var
  LS: string;
  LI: int32;
begin
  for LI := 0 to 3 do
    match LI of
      0: LS := "red";
      1: LS := "green";
      2: LS := "blue";
    else
      LS := "gray";
    end;
    match LS of
      "red": println("is red");
      "green", "blue": println("is green or blue");
    else
      println("other");
    end;
  end;
  match LS + "!" of
    "gray": println("bad subject");
    "gray!": println("concat subject");
  end;
end;

begin
  Compares();
  Compound();
  Indexing();
  Lengths();
  Matches();
end.
