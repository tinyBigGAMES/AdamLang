-------------------------------------------------------------------------------
  str_err_to_c_arg.adam - Break step of str_to_c_arg (PLAN-RAVENAPI F3, BNF
  sec 6): a string variable is borrowed as a C string only as an argument
  to a value or const ptr to const char / uint8 / int8 (wstring: wchar)
  parameter: to a ptr to char (it would drop const), a ptr to const of
  another type, a wstring to a ptr to const char or a string to a ptr to
  const wchar the argument is SM0404, to a var parameter SM0405; an
  assignment and a return are SM0200. Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/str_err_to_c_arg.adam" "-o" "."
  exitcode 1
  | <DIR>/str_err_to_c_arg.adam(69,10): Error SM0200: 'string' does not convert implicitly to 'ptr to const char'
  | <DIR>/str_err_to_c_arg.adam(79,11): Error SM0404: argument 1 of 'Mutable': 'string' does not convert implicitly to 'ptr to char'
  | <DIR>/str_err_to_c_arg.adam(80,8): Error SM0404: argument 1 of 'Ints': 'string' does not convert implicitly to 'ptr to const int32'
  | <DIR>/str_err_to_c_arg.adam(81,10): Error SM0404: argument 1 of 'Narrow': 'wstring' does not convert implicitly to 'ptr to const char'
  | <DIR>/str_err_to_c_arg.adam(82,8): Error SM0404: argument 1 of 'Wide': 'string' does not convert implicitly to 'ptr to const wchar'
  | <DIR>/str_err_to_c_arg.adam(83,8): Error SM0405: var parameter 'AText' needs a variable of type 'ptr to const char'
  | <DIR>/str_err_to_c_arg.adam(84,9): Error SM0200: 'string' does not convert implicitly to 'ptr to const char'
@@end
*/

module exe str_err_to_c_arg;

func Mutable(const AText: ptr to char): int64;
begin
  return 0;
end;

func Ints(const AText: ptr to const int32): int64;
begin
  return 0;
end;

func Narrow(const AText: ptr to const char): int64;
begin
  return 0;
end;

func Wide(const AText: ptr to const wchar): int64;
begin
  return 0;
end;

func Slot(var AText: ptr to const char): int64;
begin
  return 0;
end;

func Back(const AText: string): ptr to const char;
begin
  return AText;
end;

var
  LS: string;
  LW: wstring;
  LP: ptr to const char;
begin
  LS := "text";
  LW := "wide";
  Mutable(LS);
  Ints(LS);
  Narrow(LW);
  Wide(LS);
  Slot(LS);
  LP := LS;
  Back(LS);
end.
