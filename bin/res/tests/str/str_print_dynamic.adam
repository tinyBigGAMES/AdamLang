-------------------------------------------------------------------------------
  str_print_dynamic.adam - print / println / FormatStr write a dynamic array
  as a range as they write a static one (AUD3, AUDIT 2.6; std::format's
  range_formatter, as str_print_range): brackets and ", ", `n`, an element
  spec, the range's width; an empty one; strings in the debug form; `s` /
  `?s` of chars; nested levels, dynamic in static and static in dynamic; a
  record's dynamic field; a call's result, static and dynamic, written
  straight from it; FormatStr's text.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | [[1, -20, 300]][1, -20, 300][[1, -14, 12c]][   [1, -20, 300]]
  | [[]][][[]  ]
  | [["a", "b\"c"]][[a, b"c]]
  | [hi]["hi"]
  | [[[1, 2], [3]]][[[1], []]][[[1, 2], [3, 4]]]
  | [[5, 6]]
  | [[2, 4, 6, 8]][[7, 8]]
  | [1, -20, 300]
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_print_dynamic;

type
  Quad = array[0..3] of int32;
  Holder = record
    Items: array of int32;
  end;

// 2, 4, 6, 8
routine Doubled(): Quad;
var
  LQ: Quad;
begin
  LQ := [2, 4, 6, 8];
  return LQ;
end;

// 7, 8
routine Pair(): array of int32;
begin
  return [7, 8];
end;

routine Run();
var
  LD: array of int32;
  LE: array of int32;
  LS: array of string;
  LC: array of char;
  LN: array of array of int32;
  LM: array[0..1] of array of int32;
  LP: array of array[0..1] of int32;
  LH: Holder;
begin
  LD := [1, -20, 300];
  println("[{}][{:n}][{::x}][{:>16}]", LD, LD, LD, LD);
  println("[{}][{:n}][{:4}]", LE, LE, LE);
  LS := ["a", "b\"c"];
  println("[{}][{::}]", LS, LS);
  LC := ['h', 'i'];
  println("[{:s}][{:?s}]", LC, LC);
  LN := [[1, 2], [3]];
  LM[0] := [1];
  LP := [[1, 2], [3, 4]];
  println("[{}][{}][{}]", LN, LM, LP);
  LH.Items := [5, 6];
  println("[{}]", LH.Items);
  println("[{}][{}]", Doubled(), Pair());
  println("{}", FormatStr("{}", LD));
end;

begin
  Run();
end.
