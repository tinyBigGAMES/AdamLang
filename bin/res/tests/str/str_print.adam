  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_print.adam - print / println write every printable form but floats,
  sets and arrays (H4u2): integers at their edges (int8, uint8, int64,
  uint64, uint16), bools, a char, a wchar (past ASCII, and a lone surrogate
  as U+FFFD), a wstring (a surrogate pair, the empty one, one long enough to
  fill the writer's buffer), a ptr to char / wchar (nil and text), a pointer,
  nil, a routine value, choices values by name and out of range as Type(N),
  arguments placed by number and one no placeholder names.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | -128 255 -9223372036854775808 18446744073709551615 65535
  | true false true
  | [A]
  | [é]
  | [�]
  | [a😀b]
  | []
  | [😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀]
  | [nil]
  | [hi]
  | [nil]
  | [wé]
  | 0x1a2b 0x0
  | 0x0
  | Green Blue Color(7)
  | Low High Tri(5)
  | 2 1
  | 1 only
  | 5 apples
  | 7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_print;

type
  Color = choices(Red, Green, Blue);
  Tri = choices(Low = -2, Mid, High);
  Callback = func();

func Forms();
var
  LI8: int8;
  LU8: uint8;
  LMin: int64;
  LMax: uint64;
  LU16: uint16;
  LFlag: bool;
  LC: char;
  LW: wchar;
  LText: wstring;
  LLong: wstring;
  LCText: ptr to const char;
  LWText: ptr to const wchar;
  LAddress: ptr;
  LFn: Callback;
  LColor: Color;
  LTri: Tri;
  LN: int32;
  LI: int32;
begin
  LI8 := -128;
  LU8 := 255;
  LMin := -9223372036854775807 - 1;
  LMax := 18446744073709551615u;
  LU16 := 65535;
  println("{} {} {} {} {}", LI8, LU8, LMin, LMax, LU16);
  LFlag := true;
  println("{} {} {}", LFlag, not LFlag, 3 > 2);
  LC := 'A';
  println("[{}]", LC);
  LW := wchar(0xE9);
  println("[{}]", LW);
  LW := wchar(0xD800);
  println("[{}]", LW);
  LText := "a\U0001F600b";
  println("[{}]", LText);
  LText := "";
  println("[{}]", LText);
  // 65 code points of 4 bytes: the writer's 256-byte buffer is written once full
  for LI := 1 to 65 do
    LLong := LLong + "\U0001F600";
  end;
  println("[{}]", LLong);
  LCText := nil;
  println("[{}]", LCText);
  LCText := ptr to const char("hi");
  println("[{}]", LCText);
  LWText := nil;
  println("[{}]", LWText);
  LWText := ptr to const wchar("w\U000000E9");
  println("[{}]", LWText);
  LAddress := ptr(int64(0x1A2B));
  println("{} {}", LAddress, nil);
  LFn := nil;
  println("{}", LFn);
  LN := 7;
  LColor := Color.Green;
  println("{} {} {}", LColor, Color.Blue, Color(LN));
  LN := 5;
  LTri := Tri.Low;
  println("{} {} {}", LTri, Tri.High, Tri(LN));
  println("{1} {0}", 1, 2);
  println("{} only", 1, 2);
  println("{} apples", 5);
  print("{}", 7);
  println("");
end;

begin
  Forms();
end.
