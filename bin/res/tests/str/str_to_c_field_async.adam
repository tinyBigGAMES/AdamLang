  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_to_c_field_async.adam - `async F(X)` given a variable whose C string
  fields hold borrowed strings (PLAN-RAVENAPI F4b, BNF sec 6): the task's
  copy of the argument carries the holder's texts in the task's own holder,
  so the task reads them after the caller let them go (the field stored
  again, the string variable emptied, the blocks reused); a part of the
  variable (a nested record, a static array of records), a const and a
  value parameter, a method's call, and another module's public variable.
  Each task's holder is released at its end: the [Heap] line. The same
  lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | whole 5 async
  | part 4 deep
  | items 3 two
  | value 5 value
  | method 6 method
  | unit 4 unit
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_to_c_field_async;

@addmodulepath "$P:res/tests/str/fixtures";

import System.SysUtils, StrCFieldUnit;

@ifdef TARGET_X86_64_LINUX_GNU
func strlen(const AText: ptr to const char): uint64; external "c";
@else
func strlen(const AText: ptr to const char): uint64; external "ucrtbase";
@endif

var
  GGo: int64;

// AText as a string of no constant text (a new block: a constant's would be folded)
func Made(const AText: string): string;
begin
  return AText + "";
end;

// Waits for the caller's go, then the length and text of AText
func Shown(const AText: ptr to const char): string;
begin
  while atomicload(GGo) = 0 do
  end;
  return IntToStr(int64(strlen(AText))) + " " + UTextOf(AText);
end;

type
  Item = record
    Label: ptr to const char;
  end;

  Inner = record
    Note: ptr to const char;
  end;

  Config = record
    Title: ptr to const char;
    Deep: Inner;
    Items: array[0..2] of Item;
  end;

  Reader = object
    Calls: int64;

    method Read(const ACFG: Config): string;
    begin
      return Shown(ACFG.Title);
    end;
  end;

  Action = ref func();

func Whole(const ACFG: Config): string;
begin
  return Shown(ACFG.Title);
end;

func Part(const AInner: Inner): string;
begin
  return Shown(AInner.Note);
end;

func Items(const AItems: array[0..2] of Item): string;
begin
  return Shown(AItems[2].Label);
end;

// A value parameter: the call takes the task's copy
func Value(ACFG: Config): string;
begin
  return Shown(ACFG.Title);
end;

func UnitTitle(const ACFG: UConfig): string;
begin
  return Shown(ACFG.Title);
end;

var
  LCFG: Config;
  LName: string;
  LJunk: string;
  LTask: task string;
  LReader: ref Reader;
  LDrop: Action;
begin
  // the caller lets the texts go (stored again, the string emptied, a new block made in
  // their place), then lets the task read
  LDrop := func()
  begin
    LCFG.Title := nil;
    LCFG.Deep.Note := nil;
    LCFG.Items[2].Label := nil;
    LName := "";
    LJunk := Made("xxxxxxxx");
    atomicstore(GGo, 1);
  end;
  LName := Made("async");
  LCFG.Title := LName;
  LTask := async Whole(LCFG);
  LDrop();
  println("whole {}", await LTask);
  atomicstore(GGo, 0);
  LName := Made("deep");
  LCFG.Deep.Note := LName;
  LTask := async Part(LCFG.Deep);
  LDrop();
  println("part {}", await LTask);
  atomicstore(GGo, 0);
  LName := Made("two");
  LCFG.Items[2].Label := LName;
  LTask := async Items(LCFG.Items);
  LDrop();
  println("items {}", await LTask);
  atomicstore(GGo, 0);
  LName := Made("value");
  LCFG.Title := LName;
  LTask := async Value(LCFG);
  LDrop();
  println("value {}", await LTask);
  atomicstore(GGo, 0);
  LReader := ref Reader();
  LName := Made("method");
  LCFG.Title := LName;
  LTask := async LReader.Read(LCFG);
  LDrop();
  println("method {}", await LTask);
  atomicstore(GGo, 0);
  UCFG.Title := Made("unit");
  LTask := async UnitTitle(UCFG);
  UCFG.Title := nil;
  LDrop();
  println("unit {}", await LTask);
  LTask := nil;
  LDrop := nil;
end.
