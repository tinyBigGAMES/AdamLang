-------------------------------------------------------------------------------
  str_print_wide_c.adam - print / println / FormatStr of a ptr to const wchar
  (a C wide string, C's wchar_t units: UTF-16 on x86_64-windows-gnu, UTF-32
  on x86_64-linux-gnu, found on PLAN-RAVENAPI F3): a wide literal cast to
  one, a wstring borrowed as one (F3: a UTF-32 copy where wchar_t is 32 bits)
  and nil print the same UTF-8 text on both targets, a code point past
  U+FFFF included, a text longer than one write's buffer too.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | lit héllo😀
  | arg [wide é😀]
  | nil nil
  | long 300 300
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_print_wide_c;

import System.SysUtils;

// The C wide string AText printed between brackets
func Show(const AText: ptr to const wchar);
begin
  println("arg [{}]", AText);
end;

// The text FormatStr makes of the C wide string AText
func Formatted(const AText: ptr to const wchar): string;
begin
  return FormatStr("{}", AText);
end;

var
  LW: wstring;
  LNil: ptr to const wchar;
  LLong: wstring;
  LI: int32;
begin
  println("lit {}", ptr to const wchar("héllo😀"));
  LW := "wide é😀";
  Show(LW);
  LNil := nil;
  println("nil {}", LNil);
  for LI := 1 to 100 do
    LLong := LLong + "aé";
  end;
  println("long {} {}", len(Formatted(LLong)), len(utf8(LLong)));
end.
