-------------------------------------------------------------------------------
  str_err_formatstr.adam - Break step of str_formatstr (M3.8f2b): FormatStr
  is checked as print is: SM0409 with no format; SM0500 at a format that is
  no string literal or string const holding one; SM0502 at a format that
  does not fit (a placeholder with no argument, a spec its argument's form
  does not take, a string const's); SM0425 at an argument with no print form
  (a record, an overload set).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe str_err_formatstr;

type
  TRec = record
    X: int32;
  end;

const
  CFmt: string = "{} {}";

// An overload set: no single address to print
routine Twice(const AN: int32): int32;
begin
  return AN * 2;
end;

routine Twice(const AS: string): string;
begin
  return AS + AS;
end;

routine Forms();
var
  LS: string;
  LT: string;
  LR: TRec;
begin
  LS := FormatStr(); // ERROR SM0409@9: 'FormatStr' takes (format string, its arguments)
  LS := FormatStr(LT, 1); // ERROR SM0500@19: format string 'LT' is not a string literal or a string const holding one: a format string is checked against its arguments when the program is built
  LS := FormatStr("{}"); // ERROR SM0502@19: format string "{}" does not fit the 0 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  LS := FormatStr("{:x}", "s"); // ERROR SM0502@19: format string "{:x}" does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  LS := FormatStr(CFmt, 1); // ERROR SM0502@19: format string CFmt does not fit the 1 argument(s) after it: each {} takes the next argument, and its format spec must suit that argument's type
  LS := FormatStr("{}", LR); // ERROR SM0425@25: 'TRec' cannot be printed: print the fields of a record, object or overlay
  LS := FormatStr("{}", Twice); // ERROR SM0425@25: 'Twice' cannot be printed: an overload set or a method has no single address
end;

begin
  Forms();
end.
