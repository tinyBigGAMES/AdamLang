-------------------------------------------------------------------------------
  str_calls.adam - Strings across routines and inside aggregates (M3.8e,
  DESIGN sec 8). A value parameter is the callee's own copy (changing it
  leaves the caller's alone); a const parameter under C linkage is a copy
  too, under C++ linkage a reference (it sees the caller's variable change);
  a var parameter changes the caller's variable, field or element. Text
  results: a local's, a concatenation's, one returned from inside a loop, a
  discarded one, one in a loop (each pass releases the last), one under
  utf8, a `? :` with a concatenation on one side. Records and static arrays
  holding texts: copies stay independent (a write into a shared field's
  bytes copies it first), a record literal, a parent part's fields, a record
  or an array passed by value and by const reference, returned, assigned in
  a loop; module variables (a string, an array of strings, a record) set in
  a routine and released at the program's end. The [Adam Heap] line counts
  every block, all freed.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | abc Xbc!
  | abcabc
  | abc+#
  | lit
  | abc+#x
  | Q!
  | abw
  | aaa|
  | aa
  | aaa|.
  | a? none
  | one* none | one*2 none
  | renamed/none
  | one*
  | one*~ None
  | none
  | lit one*2x
  | lit+#
  | on
  | loop* nloop
  | renamed/nr
  | in* t0 in*t2 | qi q0 in*t2!
  | c cn ce
  | zzz!
  | end
  | a ab abc+# | a ab! abc
  | aab!abc
  | aababc+#
  | global+1
  | later
  | changed
  | changed! changed! g* ng
  | [Adam Heap] Allocs: 81, Frees: 81, Leaked: 0
@@end
*/

module exe str_calls;

type
  TNamed = record
    Title: string;
    Count: int32;
    Note: string;
  end;

  TTriple = array[0..2] of string;

  TPair = record
    Inner: TNamed;
    Tags: TTriple;
  end;

  TChild = record(TNamed)
    Extra: string;
  end;

var
  GS: string = "global";
  GNames: array[0..1] of string;
  GRec: TNamed;

// A value parameter is the callee's own: `+=` and a write into its bytes stay here
routine Change(AText: string): string;
begin
  AText += "!";
  AText[0] := 'X';
  if AText[1] = 'b' then
    return AText;
  end;
  AText[0] := 'Q';
  return AText;
end;

// A const parameter under C linkage: read only
routine Twice(const AText: string): string;
begin
  return AText + AText;
end;

// A var parameter: the caller's text grows, its length set, its last byte written
routine Grow(var AText: string);
begin
  AText += "+";
  setlength(AText, len(AText) + 1);
  AText[len(AText) - 1] := '#';
end;

// A const parameter under C++ linkage is a reference: any value reaches it
routine cpplink Echo(const AText: string): string;
begin
  return AText;
end;

// A wstring parameter and result
routine Wide(const AText: wstring): wstring;
begin
  return AText + "w";
end;

// 'a' added per pass; the third pass returns from inside the loop
routine Build(const AN: int32): string;
var
  LS: string;
  LI: int32;
begin
  for LI := 1 to AN do
    LS += 'a';
    if LI = 3 then
      return LS + "|";
    end;
  end;
  return LS;
end;

// `? :` over a concatenation and a literal
routine Pick(const AFlag: bool; const AText: string): string;
begin
  return AFlag ? AText + "?" : "none";
end;

routine Values();
var
  LA: string;
  LB: string;
begin
  LA := "ab";
  LA += 'c';
  LB := Change(LA);
  println("{} {}", LA, LB);
  println("{}", Twice(LA));
  Grow(LA);
  println("{}", LA);
  println("{}", Echo("lit"));
  println("{}", Echo(LA + "x"));
  Change("drop");
  println("{}", Change("q"));
  println("{}", utf8(Wide("ab")));
end;

routine Results();
var
  LS: string;
  LI: int32;
begin
  println("{}", Build(5));
  println("{}", Build(2));
  for LI := 1 to 3 do
    LS := Build(LI) + ".";
  end;
  println("{}", LS);
  println("{} {}", Pick(true, "a"), Pick(false, "a"));
end;

// A record result built in a local
routine MakeNamed(const ATitle: string; const ACount: int32): TNamed;
var
  LR: TNamed;
begin
  LR.Title := ATitle + "*";
  LR.Count := ACount;
  LR.Note := "n" + ATitle;
  return LR;
end;

// A record by value: the callee's own copy
routine Rename(ANamed: TNamed): string;
begin
  ANamed.Title := "renamed";
  return ANamed.Title + "/" + ANamed.Note;
end;

// A var record: its field grows, a byte of a shared field written (copy on write)
routine Retitle(var ANamed: TNamed);
begin
  ANamed.Title += "~";
  ANamed.Note[0] := 'N';
end;

// A record local cleaned up on a return from inside a loop and at the end
routine Early(const AStop: int32): string;
var
  LR: TNamed;
  LI: int32;
begin
  for LI := 0 to 5 do
    LR.Title := LR.Title + "z";
    if LI = AStop then
      return LR.Title + "!";
    end;
  end;
  return "end";
end;

routine Records();
var
  LR: TNamed;
  LCopy: TNamed;
  LP: TPair;
  LQ: TPair;
  LC: TChild;
  LI: int32;
begin
  LR := MakeNamed("one", 1);
  LCopy := LR;
  LCopy.Title += "2";
  println("{} {} | {} {}", LR.Title, LR.Note, LCopy.Title, LCopy.Note);
  println("{}", Rename(LR));
  println("{}", LR.Title);
  Retitle(LR);
  println("{} {}", LR.Title, LR.Note);
  println("{}", LCopy.Note);
  LR := TNamed(Title: "lit", Count: 7, Note: LCopy.Title + "x");
  println("{} {}", LR.Title, LR.Note);
  Grow(LR.Title);
  println("{}", LR.Title);
  setlength(LR.Note, 2);
  println("{}", LR.Note);
  for LI := 1 to 3 do
    LR := MakeNamed("loop", LI);
  end;
  println("{} {}", LR.Title, LR.Note);
  MakeNamed("drop", 0);
  println("{}", Rename(MakeNamed("r", 2)));
  LP.Inner := MakeNamed("in", 1);
  LP.Tags[0] := "t0";
  LP.Tags[2] := LP.Inner.Title + "t2";
  LQ := LP;
  LQ.Tags[0] := "q0";
  LQ.Inner.Title := "qi";
  LQ.Tags[2] += "!";
  println("{} {} {} | {} {} {}", LP.Inner.Title, LP.Tags[0], LP.Tags[2], LQ.Inner.Title,
    LQ.Tags[0], LQ.Tags[2]);
  LC.Title := "c";
  LC.Extra := LC.Title + "e";
  LC.Note := "cn";
  println("{} {} {}", LC.Title, LC.Note, LC.Extra);
  println("{}", Early(2));
  println("{}", Early(9));
end;

// A static array by value (C linkage: the callee's copy) and by const reference
routine Join(const AItems: TTriple): string;
begin
  return AItems[0] + AItems[1] + AItems[2];
end;

routine cpplink JoinRef(const AItems: TTriple): string;
begin
  return AItems[0] + AItems[1] + AItems[2];
end;

routine Arrays();
var
  LA: TTriple;
  LB: TTriple;
begin
  LA[0] := "a";
  LA[1] := LA[0] + "b";
  LA[2] := LA[1] + "c";
  LB := LA;
  LB[1] += "!";
  Grow(LA[2]);
  println("{} {} {} | {} {} {}", LA[0], LA[1], LA[2], LB[0], LB[1], LB[2]);
  println("{}", Join(LB));
  println("{}", JoinRef(LA));
end;

// Under C linkage the callee holds its own copy while the global changes
routine Snapshot(const AText: string): string;
begin
  GS := "later";
  return AText;
end;

// Under C++ linkage the parameter is the global itself
routine cpplink Alias(const AText: string): string;
begin
  GS := "changed";
  return AText;
end;

routine Globals();
begin
  GS := GS + "+1";
  println("{}", Snapshot(GS));
  println("{}", GS);
  GS := GS + "2";
  println("{}", Alias(GS));
  GNames[0] := GS + "!";
  GNames[1] := GNames[0];
  GRec := MakeNamed("g", 3);
  println("{} {} {} {}", GNames[0], GNames[1], GRec.Title, GRec.Note);
end;

begin
  Values();
  Results();
  Records();
  Arrays();
  Globals();
end.
