-------------------------------------------------------------------------------
  str_formatstr.adam - FormatStr (M3.8f2b) gives the text print writes:
  every form of str_print through FormatStr, each line its print text
  (integers at their edges, bools, char, wchar, wstrings, C strings,
  pointers, nil, routine values, choices, numbered arguments, an unnamed
  one); then FormatStr's own uses: a string const format, the empty text
  (nil, length 0), a result's length, results kept and added to in a loop,
  one in another's arguments, floats, a result passed to a routine and one
  compared. Leaked 0: each call's string is its slot's, released.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | -128 255 -9223372036854775808 18446744073709551615 65535
  | true false true
  | [A]
  | [é]
  | [�]
  | [a😀b]
  | []
  | [😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀]
  | [nil]
  | [hi]
  | [nil]
  | [wé]
  | 0x1a2b 0x0
  | 0x0
  | Green Blue Color(7)
  | Low High Tri(5)
  | 2 1
  | 1 only
  | 5 apples
  | 7
  | 1 + 2 = 3
  | [] 0 5
  | [1][2][3] [3]
  | <1-2>
  | 0.1 1e+16 0.3333333333333333 -0.75
  | hi!
  | true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_formatstr;

type
  Color = choices(Red, Green, Blue);
  Tri = choices(Low = -2, Mid, High);
  Callback = func();

const
  CFmt: string = "{} + {} = {}";

// The string AText printed: a FormatStr result passed as a const string
func Echo(const AText: string);
begin
  println("{}", AText);
end;

// FormatStr's own uses: a string const format, the empty text, its length, a result
// added to in a loop (the call's slot reused each pass), one inside another's arguments,
// floats, a result passed on and one compared
func Uses();
var
  LS: string;
  LKept: string;
  LD: float64;
  LF: float32;
  LI: int32;
begin
  println("{}", FormatStr(CFmt, 1, 2, 3));
  LS := FormatStr("");
  println("[{}] {} {}", LS, len(LS), len(FormatStr("{}", 12345)));
  LS := "";
  for LI := 1 to 3 do
    LKept := FormatStr("[{}]", LI);
    LS := LS + LKept;
  end;
  println("{} {}", LS, LKept);
  println("{}", FormatStr("<{}>", FormatStr("{}-{}", 1, 2)));
  LD := 1.0;
  LD := LD / 3.0;
  LF := 0.75;
  println("{}", FormatStr("{} {} {} {}", 0.1, 1e16, LD, -LF));
  Echo(FormatStr("{}!", "hi"));
  println("{}", FormatStr("{}", 42) = "42");
end;

func Forms();
var
  LI8: int8;
  LU8: uint8;
  LMin: int64;
  LMax: uint64;
  LU16: uint16;
  LFlag: bool;
  LC: char;
  LW: wchar;
  LText: wstring;
  LLong: wstring;
  LCText: ptr to const char;
  LWText: ptr to const wchar;
  LAddress: ptr;
  LFn: Callback;
  LColor: Color;
  LTri: Tri;
  LN: int32;
  LI: int32;
  LS: string;
begin
  LI8 := -128;
  LU8 := 255;
  LMin := -9223372036854775807 - 1;
  LMax := 18446744073709551615u;
  LU16 := 65535;
  LS := FormatStr("{} {} {} {} {}", LI8, LU8, LMin, LMax, LU16);
  println("{}", LS);
  LFlag := true;
  LS := FormatStr("{} {} {}", LFlag, not LFlag, 3 > 2);
  println("{}", LS);
  LC := 'A';
  LS := FormatStr("[{}]", LC);
  println("{}", LS);
  LW := wchar(0xE9);
  LS := FormatStr("[{}]", LW);
  println("{}", LS);
  LW := wchar(0xD800);
  LS := FormatStr("[{}]", LW);
  println("{}", LS);
  LText := "a\U0001F600b";
  LS := FormatStr("[{}]", LText);
  println("{}", LS);
  LText := "";
  LS := FormatStr("[{}]", LText);
  println("{}", LS);
  // 65 code points of 4 bytes: the writer's 256-byte buffer is written once full
  for LI := 1 to 65 do
    LLong := LLong + "\U0001F600";
  end;
  LS := FormatStr("[{}]", LLong);
  println("{}", LS);
  LCText := nil;
  LS := FormatStr("[{}]", LCText);
  println("{}", LS);
  LCText := ptr to const char("hi");
  LS := FormatStr("[{}]", LCText);
  println("{}", LS);
  LWText := nil;
  LS := FormatStr("[{}]", LWText);
  println("{}", LS);
  LWText := ptr to const wchar("w\U000000E9");
  LS := FormatStr("[{}]", LWText);
  println("{}", LS);
  LAddress := ptr(int64(0x1A2B));
  LS := FormatStr("{} {}", LAddress, nil);
  println("{}", LS);
  LFn := nil;
  LS := FormatStr("{}", LFn);
  println("{}", LS);
  LN := 7;
  LColor := Color.Green;
  LS := FormatStr("{} {} {}", LColor, Color.Blue, Color(LN));
  println("{}", LS);
  LN := 5;
  LTri := Tri.Low;
  LS := FormatStr("{} {} {}", LTri, Tri.High, Tri(LN));
  println("{}", LS);
  LS := FormatStr("{1} {0}", 1, 2);
  println("{}", LS);
  LS := FormatStr("{} only", 1, 2);
  println("{}", LS);
  LS := FormatStr("{} apples", 5);
  println("{}", LS);
  LS := FormatStr("{}", 7);
  println("{}", LS);
end;

begin
  Forms();
  Uses();
end.
