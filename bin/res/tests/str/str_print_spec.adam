  was not distributed with this file, You can obtain one
  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_print_spec.adam - print's specs of integers, bools, chars, pointers
  and choices values (M3.8f3), each line as libc++'s std::format writes it
  (truth: tests\probe\adam_fmt\fmt_spec_oracle.pcpp, built by pcpp): fill
  (a multi-byte one too), align, width (written, or taken from an int, a
  uint8 or an int64 argument, 0 included), sign, `#` (every base, octal 0
  without its prefix), `0` (ignored after an alignment), b B o x X d c, `L`
  (the C locale's), negative numbers and the edges, a char as its unsigned
  code, pointers (p, P, zero padding); then a pointer that is not nil, a
  choices value out of range, FormatStr's text with specs, and what libc++
  throws as the format runs, raised (a `c` out of char's range, signed and
  unsigned; a negative width; one past its maximum; a choices value's width
  from a bool).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | [   42][42   ][ 42  ][   42][**42***][42--]
  | [+5][ 5][5][-5][-5]
  | [11111111][11111111][377][ff][FF][255]
  | [0b11111111][0B11111111][0377][0xff][0XFF][255][0]
  | [00000042][+0000042][0x000000ff][0b00000101][000000ff][42      ][   42   ]
  | [-ff][-0xff][-0000042][-0X00000FF][-10][ 0xff]
  | [-8000000000000000][-0b10000000][+255][FFFFFFFFFFFFFFFF]
  | [A][B  ][  C][ D ]
  | [   7][7   ][**7**]
  | [  7][    7][      3]
  | [éé42ééé][😀😀42][xéé]
  | [1234567][1234567][true]
  | [true  ][  true][ false ][true][1][0x1][0][+1][000001][0xxx]
  | [A  ][  A][ A ][A][65][0x41][+65][065][1000001][***A]
  | [200][c8]
  | [         0x0][0x0         ][    0x0     ][0x0][0X0][0x0000000000000000][  0x0][**0X0**]
  | [Green   ][    Blue][   Red   ][Green**][Blue]
  | [ 200][-1][0b101][H][ffff]
  | [  1][ 1][5]
  | [    0x1a2b][0X1A2B][0x1a2b###][0x00001a2b]
  | [  Color(7)][Color(7)  ]
  | [    42][0xff][true ][-0042]
  | [Integral value outside the range of the char type]
  | [Integral value outside the range of the char type]
  | [An argument index may not have a negative value]
  | [The value of the argument index exceeds its maximum value]
  | [Replacement argument isn't a standard signed or unsigned integer type]
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_print_spec;

type
  Color = choices(Red, Green, Blue);

func Forms();
var
  LMin: int64;
  LMax: uint64;
  LI8: int8;
  LU8: uint8;
  LU8b: uint8;
  LI8m: int8;
  LU8c: uint8;
  LU8d: uint8;
  LU16: uint16;
  LW8: uint8;
  LW64: int64;
  LC: char;
  LC2: char;
  LP: ptr;
  LAddress: ptr;
  LN: int32;
  LNeg: int64;
  LHuge: uint64;
  LS: string;
begin
  LMin := -9223372036854775807 - 1;
  LMax := 18446744073709551615u;
  LI8 := -128;
  LU8 := 255;
  LU8b := 200;
  LI8m := -1;
  LU8c := 5;
  LU8d := 72;
  LU16 := 65535;
  LW8 := 3;
  LW64 := 2;
  LC := 'A';
  LC2 := char(200);
  LP := nil;
  println("[{:5}][{:<5}][{:^5}][{:>5}][{:*^7}][{:-<4}]", 42, 42, 42, 42, 42, 42);
  println("[{:+}][{: }][{:-}][{:+}][{: }]", 5, 5, 5, -5, -5);
  println("[{:b}][{:B}][{:o}][{:x}][{:X}][{:d}]", 255, 255, 255, 255, 255, 255);
  println("[{:#b}][{:#B}][{:#o}][{:#x}][{:#X}][{:#d}][{:#o}]", 255, 255, 255, 255, 255, 255, 0);
  println("[{:08}][{:+08}][{:#010x}][{:#010b}][{:08x}][{:<08}][{:^08}]", 42, 42, 255, 5, 255, 42, 42);
  println("[{:x}][{:#x}][{:08}][{:#010X}][{:+o}][{: #x}]", -255, -255, -42, -255, -8, 255);
  println("[{:x}][{:#b}][{:+}][{:X}]", LMin, LI8, LU8, LMax);
  println("[{:c}][{:3c}][{:>3c}][{:^3c}]", 65, 66, 67, 68);
  println("[{:{}}][{:<{}}][{:*^{}}]", 7, 4, 7, 4, 7, 5);
  println("[{0:{1}}][{0:>{2}}][{1:{0}}]", 7, 3, 5);
  println("[{:é^7}][{:😀>4}][{:é<3}]", 42, 42, 'x');
  println("[{:L}][{:Ld}][{:L}]", 1234567, 1234567, true);
  println("[{:6}][{:>6}][{:^7}][{:s}][{:d}][{:#x}][{:b}][{:+d}][{:06d}][{:x<4d}]", true, true, false, true, true, true, false, true, true, false);
  println("[{:3}][{:>3}][{:^3}][{:c}][{:d}][{:#x}][{:+d}][{:03d}][{:b}][{:*>4}]", LC, LC, LC, LC, LC, LC, LC, LC, LC, LC);
  println("[{:d}][{:x}]", LC2, LC2);
  println("[{:12}][{:<12}][{:^12}][{:p}][{:P}][{:018}][{:>5}][{:*^7P}]", LP, LP, LP, LP, LP, LP, LP, LP);
  println("[{:8}][{:>8}][{:^9}][{:*<7}][{:s}]", Color.Green, Color.Blue, Color.Red, Color.Green, Color.Blue);
  println("[{:4}][{:x}][{:#b}][{:c}][{:04x}]", LU8b, LI8m, LU8c, LU8d, LU16);
  println("[{:{}}][{:{}}][{:{}}]", 1, LW8, 1, LW64, 5, 0);
  LAddress := ptr(int64(0x1A2B));
  println("[{:10}][{:P}][{:#<9}][{:010}]", LAddress, LAddress, LAddress, LAddress);
  LN := 7;
  println("[{:>10}][{:<10}]", Color(LN), Color(LN));
  LS := FormatStr("[{:>6}][{:#x}][{:^5}][{:05}]", 42, 255, true, -42);
  println("{}", LS);
  guard
    print("{:c}", 200);
  except
    println("[{}]", excmsg());
  end;
  LU8 := 128;
  guard
    LS := FormatStr("{:c}", LU8);
  except
    println("[{}]", excmsg());
  end;
  LNeg := -1;
  guard
    LS := FormatStr("{:{}}", 1, LNeg);
  except
    println("[{}]", excmsg());
  end;
  LHuge := 18446744073709551615u;
  guard
    LS := FormatStr("{:{}}", 1, LHuge);
  except
    println("[{}]", excmsg());
  end;
  guard
    println("{:{}}", Color.Red, true);
  except
    println("[{}]", excmsg());
  end;
end;

begin
  Forms();
end.
