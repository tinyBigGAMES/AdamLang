  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  str_print_set.adam - print / println / FormatStr write a set as a range
  (M3.8f6b; truth tests\probe\adam_fmt\fmt_set_oracle.pcpp): its members in
  ascending order in brackets with ", ", `n`, the set's own fill / align /
  width (an argument's width too), an element spec after `:`, the debug form
  of a char member, a choices member by its name (`?` quoted), an empty set,
  a set of a small range, of a range past one word, of char, of a choices
  type, sets inside an array; the raises of a width argument with no text of
  that print written before them; Adam's own: FormatStr's text, a scratch
  reused in a loop and from an except block, a record's set field, set
  expressions as arguments, char(200) in a set of char (signed char: the
  lowest member), `s` / `?s` on a set of char, a negative low bound, a
  65536-member set, a set of bool.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | [[1, 3, 4, 5]][1, 3, 4, 5][[1, 3, 4, 5]][0x1, 0x3, 0x4, 0x5][[+01, +03, +04, +05]][    [1, 3, 4, 5]][[1::, 3::, 4::, 5::]][1, 3, 4, 5  ][[ 1,  3,  4,  5]]
  | [[1, 3, 4, 5]   ][[  1,   3,   4,   5]][1, 3, 4, 5 ]
  | [[1, 3, 4, 5]][   1,    3,    4,    5][[1, 3, 4, 5]]
  | [[]][][[]   ][    ]
  | [[1, 50, 64, 65, 100]][[1, 110010, 1000000, 1000001, 1100100]][  1,  50,  64,  65, 100]
  | [[10, 15, 20]][[012, 017, 024]][[A, F, 14]]
  | [[0, 31, 32, 63]][0, 37, 40, 77]
  | [[[0, 7], []]][[0, 7], []][[0, 7, ]][[[0, 7], []]][[[0, 7]   , []       ]]
  | [['"', '\'', 'a', 'c']][[", ', a, c]]['"', '\'', 'a', 'c'][[", ', a, c]][[34, 39, 97, 99]][['"', '\'', 'a', 'c']][[  ",   ',   a,   c]][['"', '\'', 'a', 'c']]
  | [['A', 'z']][[65, 122]]
  | [['\x{c8}', 'z']][[200, 122]]
  | [[Red, Blue]][[Red, Blue]][Red, Blue][[   Red,   Blue]][["Red", "Blue"]][ [Red, Blue]  ]
  | [[]][]
  | [An argument index may not have a negative value]
  | [An argument index may not have a negative value]
  | [Replacement argument isn't a standard signed or unsigned integer type]
  | [[1, 3, 4, 5]][  [1, 3, 4, 5]][0x1, 0x3, 0x4, 0x5]
  | [**[1, 3, 4, 5]**]
  | [**[1, 3, 4, 5]**]
  | [  [1, 3, 4, 5]][x]
  | [[2, 6]][2, 6]
  | [[3, 4]][0, 1, 3, 4, 5]
  | [['\x{c8}', 'A', 'z']][[200, 65, 122]]
  | ["'ac]["\"'ac"][  "'ac]
  | [[-3, 0, 3]][[-3, +0, +3]]
  | [[0, 1000, 65535]]
  | [[true]]
  | [[false, true]][false, true]
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_print_set;

type
  Color = choices(Red, Green, Blue);
  Small = set of 0..7;
  Mid = set of 1..100;
  Teens = set of 10..20;
  Wide = set of 0..63;
  Chars = set of char;
  Colors = set of Color;

routine Numbers();
var
  LS: Small;
  LE: Small;
  LM: Mid;
  LT: Teens;
  LW: Wide;
  LA: array[0..1] of Small;
begin
  LS := [1, 3..5];
  println("[{}][{:n}][{::x}][{:n:#x}][{::+03}][{:>16}][{:*^20::<3}][{:12n}][{:<14:>2}]", LS, LS, LS, LS, LS, LS, LS, LS, LS);
  println("[{:{}}][{::{}}][{:^{}n}]", LS, 15, LS, 3, LS, 11);
  println("[{0}][{0:n:{1}}][{0:>{1}}]", LS, 4);
  println("[{}][{:n}][{:5}][{:>4n}]", LE, LE, LE, LE);
  LM := [1, 50, 64, 65, 100];
  println("[{}][{::b}][{:n:3}]", LM, LM, LM);
  LT := [10, 20, 15];
  println("[{}][{::#o}][{::X}]", LT, LT, LT);
  LW := [0, 31, 32, 63];
  println("[{}][{:n:o}]", LW, LW);
  LA[0] := [7, 0];
  println("[{}][{:n}][{::n}][{:::x}][{:>18:<9}]", LA, LA, LA, LA, LA);
end;

routine Texts();
var
  LC: Chars;
  LH: Chars;
  LHA: array[0..1] of char;
  LK: Colors;
  LN: Colors;
begin
  LC := ['a', 'c', '"', '\''];
  println("[{}][{::}][{:n}][{::c}][{::d}][{::?}][{::>3}][{:20}]", LC, LC, LC, LC, LC, LC, LC, LC);
  LH := ['z', char(0x41)];
  println("[{}][{::d}]", LH, LH);
  // pcpp refuses char(200) in a set of char (Extra holds it in a set): its element form, from an
  // array, is the truth for Adam's set holding it
  LHA[0] := char(200);
  LHA[1] := 'z';
  println("[{}][{::d}]", LHA, LHA);
  LK := [Color.Blue, Color.Red];
  println("[{}][{::}][{:n}][{::>6}][{::?}][{:^14}]", LK, LK, LK, LK, LK, LK);
  println("[{}][{:n}]", LN, LN);
end;

// A width argument's raises at the set and at its element, an element's `c` out of range,
// and the text before a raise in the same print
routine Raises();
var
  LM: Mid;
  LNeg: int32;
begin
  LM := [33, 99];
  LNeg := -1;
  guard
    println("pre[{:{}}]", LM, LNeg);
  except
    println("[{}]", excmsg());
  end;
  guard
    println("pre[{::{}}]", LM, LNeg);
  except
    println("[{}]", excmsg());
  end;
  guard
    println("pre[{:{}}]", LM, true);
  except
    println("[{}]", excmsg());
  end;
end;

type
  Holder = record
    Flags: Small;
  end;
  Signed = set of -3..3;
  Huge = set of 0..65535;
  Bools = set of bool;

// FormatStr writes print's text; one set written twice in a loop (its scratch string
// emptied each time) and from an except block; a record's set field; char(200) in a set
// of char; `s` / `?s`; a negative low bound; the widest set; a set of bool
routine Extra();
var
  LS: Small;
  LR: Holder;
  LC: Chars;
  LG: Signed;
  LH: Huge;
  LB: Bools;
  LK: int32;
begin
  LS := [1, 3..5];
  println("{}", FormatStr("[{}][{:>14}][{:n:#x}]", LS, LS, LS));
  for LK := 1 to 2 do
    println("{}", FormatStr("[{:*^16}]", LS));
  end;
  guard
    raise("x");
  except
    println("[{:>14}][{}]", LS, excmsg());
  end;
  LR.Flags := [2, 6];
  println("[{}][{:n}]", LR.Flags, LR.Flags);
  println("[{}][{:n}]", LS * [3, 4, 7], LS + [0]);
  LC := ['z', char(200), 'A'];
  println("[{}][{::d}]", LC, LC);
  LC := ['a', 'c', '"', '\''];
  println("[{:s}][{:?s}][{:>6s}]", LC, LC, LC);
  LG := [3, -3, 0];
  println("[{}][{::+}]", LG, LG);
  LH := [65535, 0, 1000];
  println("[{}]", LH);
  LB := [true];
  println("[{}]", LB);
  LB += [false];
  println("[{}][{:n}]", LB, LB);
end;

begin
  Numbers();
  Texts();
  Raises();
  Extra();
end.
