-------------------------------------------------------------------------------
  str_formatstr_runtime_spec.adam - format specs under a format known only
  at run time (M3.8i2, BNF sec 7): libc++'s std-format-spec read when the
  call runs (the runtime's DoRunSpec) into the same words the build-time
  path writes, then the same SinkSpec* routines. Each case is written by
  both paths, the literal and a string variable holding the same text,
  and the two compared (a DIFF line names a mismatch): fill (a UTF-8 one
  too) and align, sign, `#`, `0`, widths and precisions written and taken
  from an argument (`{}` and `{n}`, in the fields' numbering), `L`, every
  type letter of every form (integers, bool, char, floats, pointers,
  strings, wstring, wchar, C text, nil, choices). Then every refusal
  libc++ gives a spec when it runs, caught (code 1 and its text): fields
  a formatter does not read, a type letter it refuses, a text form's own
  checks, a nested argument id or value that does not fit, and the order
  libc++ checks them in. Leaked 0.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | [   42|42   | 42  |   42|**42***]
  | [+5 5  5 -5 -5]
  | [0xff 0XFF 0b101 0B101 010 ff 10 255]
  | [-0000042 +0000042 0x000000ff 7        00000BEE]
  | [A   B éééé7 éé8ééé 1234567 89]
  | [-1 ffffffffffffffff 11001000 -0x8000000000000000 -3]
  | [    7|  x|ab  ]
  | [     3|  6| true ]
  | [3.14|   1.500e+00|abcd]
  | [9|9]
  | [  true|false|1|0x1| false |000001]
  | [  A|B|67|0x44|'E'|'F' |G]
  | [3.142|1.234500e+03|1.200000E-04|1e+20|1E-20|1p+0|1.FFP+7|2.500000]
  | [+1.23e+04|-00003.500|2.00000|7.|    0.1     |10.0*****| 1.25]
  | [0.10|     inf|+nan|1.677722e+07|0.5|2e+01]
  | [0x0|0X0|   0x0|0x0000|0x0  |**0x0**]
  | address same
  | routine same
  | [ hello|hi    | abc  |xy|s|"q\"t"|---abc---|  "a\tb"]
  | [  wé|  é  |"\n"|ab|  nil|"abc"|é     ]
  | [  Green|"Red"|Blu|Green***| Color(9)]
  | [{  1} 2 a]
  | print path:
  |     7|2.2
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The width option should not have a leading zero]
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The type option contains an invalid value for a string formatting argument]
  | 1 [The type option contains an invalid value for a string formatting argument]
  | 1 [The width option should not have a leading zero]
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The type option contains an invalid value for an integer formatting argument]
  | 1 [The type option contains an invalid value for an integer formatting argument]
  | 1 [The type option contains an invalid value for an integer formatting argument]
  | 1 [The format specifier for an integer does not allow the sign option]
  | 1 [The format specifier for an integer does not allow the alternate form option]
  | 1 [The format specifier for an integer does not allow the zero-padding option]
  | 1 [Integral value outside the range of the char type]
  | 1 [Integral value outside the range of the char type]
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier for a bool does not allow the sign option]
  | 1 [The format specifier for a bool does not allow the alternate form option]
  | 1 [The format specifier for a bool does not allow the zero-padding option]
  | 1 [The type option contains an invalid value for a bool formatting argument]
  | 1 [The type option contains an invalid value for a bool formatting argument]
  | 1 [The format specifier for a character does not allow the sign option]
  | 1 [The format specifier for a character does not allow the alternate form option]
  | 1 [The format specifier for a character does not allow the zero-padding option]
  | 1 [The type option contains an invalid value for a character formatting argument]
  | 1 [The type option contains an invalid value for a floating-point formatting argument]
  | 1 [The type option contains an invalid value for a floating-point formatting argument]
  | 1 [The precision option does not contain a value or an argument index]
  | 1 [End of input while parsing format specifier precision]
  | 1 [The precision option does not contain a value or an argument index]
  | 1 [The type option contains an invalid value for a pointer formatting argument]
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The format specifier should consume the input or end with a '}']
  | 1 [The fill option contains an invalid value]
  | 1 [The format string contains an invalid escape sequence]
  | 1 [The format specifier contains malformed Unicode characters]
  | 1 [The format specifier contains malformed Unicode characters]
  | 1 [The argument index value is too large for the number of arguments supplied]
  | 1 [The argument index value is too large for the number of arguments supplied]
  | 1 [End of input while parsing an argument index]
  | 1 [The argument index starts with an invalid character]
  | 1 [Using manual argument numbering in automatic argument numbering mode]
  | 1 [The argument index is invalid]
  | 1 [Using automatic argument numbering in manual argument numbering mode]
  | 1 [Using manual argument numbering in automatic argument numbering mode]
  | 1 [The numeric value of the format specifier is too large]
  | 1 [The numeric value of the format specifier is too large]
  | 1 [An argument index may not have a negative value]
  | 1 [The value of the argument index exceeds its maximum value]
  | 1 [The value of the argument index exceeds its maximum value]
  | 1 [Replacement argument isn't a standard signed or unsigned integer type]
  | 1 [Replacement argument isn't a standard signed or unsigned integer type]
  | 1 [Using automatic argument numbering in manual argument numbering mode]
  | 1 [The argument index value is too large for the number of arguments supplied]
  | 1 [The format specifier for an integer does not allow the sign option]
  | 1 [Integral value outside the range of the char type]
  | 1 [The replacement field misses a terminating '}']
  | 1 [Using manual argument numbering in automatic argument numbering mode]
  | 1 [An argument index may not have a negative value]
  | 1 [The argument index is invalid]
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe str_formatstr_runtime_spec;

type
  Color = choices(Red, Green, Blue);

// ALiteral (the build-time path's text) and ARunTime (the run-time path's) compared: the
// text in brackets when they are the same, else both
routine Same(const ALiteral: string; const ARunTime: string);
begin
  if ALiteral = ARunTime then
    println("[{}]", ARunTime);
  else
    println("DIFF [{}] [{}]", ALiteral, ARunTime);
  end;
end;

// The same check for a text that differs from run to run (an address): only ALabel
routine SameQuiet(const ALabel: string; const ALiteral: string; const ARunTime: string);
begin
  if ALiteral = ARunTime then
    println("{} same", ALabel);
  else
    println("DIFF {} [{}] [{}]", ALabel, ALiteral, ARunTime);
  end;
end;

// The raise FormatStr(AFormat, AValue) gives (its code and text), or "no raise" and the text
routine RaiseInt(const AFormat: string; const AValue: int32);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInt's check for a string argument
routine RaiseText(const AFormat: string; const AValue: string);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInt's check for a bool argument
routine RaiseBool(const AFormat: string; const AValue: bool);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInt's check for a char argument
routine RaiseChar(const AFormat: string; const AValue: char);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInt's check for a float64 argument
routine RaiseFloat(const AFormat: string; const AValue: float64);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInt's check for a ptr argument
routine RaisePtr(const AFormat: string; const AValue: ptr);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseInt's check for an int32 and the int64 a nested width or precision may take
routine RaiseWidth(const AFormat: string; const AValue: int32; const AWidth: int64);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue, AWidth);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseWidth's check with a uint32 width
routine RaiseWidthU32(const AFormat: string; const AValue: int32; const AWidth: uint32);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue, AWidth);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseWidth's check with a string width (no integer)
routine RaiseWidthText(const AFormat: string; const AValue: int32; const AWidth: string);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue, AWidth);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

// RaiseWidth's check with a char width (no standard integer)
routine RaiseWidthChar(const AFormat: string; const AValue: int32; const AWidth: char);
var
  LS: string;
begin
  guard
    LS := FormatStr(AFormat, AValue, AWidth);
    println("no raise [{}]", LS);
  except
    println("{} [{}]", exccode(), excmsg());
  end;
end;

var
  LF: string;
  LW: wstring;
  LC: ptr to const char;
  LCNil: ptr to const char;
  LP: ptr;
  LValue: int32;
  LTyped: ptr to int32;
  LColor: Color;
  LBad: string;
  LZero: float64;
begin
  // integers: fill, align, sign, #, 0, width, every integer letter, c, L
  LF := "{:5}|{:<5}|{:^5}|{:>5}|{:*^7}";
  Same(FormatStr("{:5}|{:<5}|{:^5}|{:>5}|{:*^7}", 42, 42, 42, 42, 42),
    FormatStr(LF, 42, 42, 42, 42, 42));
  LF := "{:+} {:-} {: } {:+} {: }";
  Same(FormatStr("{:+} {:-} {: } {:+} {: }", 5, 5, 5, -5, -5), FormatStr(LF, 5, 5, 5, -5, -5));
  LF := "{:#x} {:#X} {:#b} {:#B} {:#o} {:x} {:o} {:d}";
  Same(FormatStr("{:#x} {:#X} {:#b} {:#B} {:#o} {:x} {:o} {:d}", 255, 255, 5, 5, 8, 255, 8, 255),
    FormatStr(LF, 255, 255, 5, 5, 8, 255, 8, 255));
  LF := "{:08} {:+08} {:#010x} {:<08} {:08X}";
  Same(FormatStr("{:08} {:+08} {:#010x} {:<08} {:08X}", -42, 42, 255, 7, 3054),
    FormatStr(LF, -42, 42, 255, 7, 3054));
  LF := "{:c} {:>3c} {:é>5} {:é^6} {:L} {:Ld}";
  Same(FormatStr("{:c} {:>3c} {:é>5} {:é^6} {:L} {:Ld}", 65, 66, 7, 8, 1234567, 89),
    FormatStr(LF, 65, 66, 7, 8, 1234567, 89));
  LF := "{:x} {:x} {:b} {:#x} {:d}";
  Same(FormatStr("{:x} {:x} {:b} {:#x} {:d}", int8(-1), 18446744073709551615u, uint8(200),
    int64(-9223372036854775807 - 1), clong(-3)),
    FormatStr(LF, int8(-1), 18446744073709551615u, uint8(200), int64(-9223372036854775807 - 1),
    clong(-3)));
  // widths and precisions an argument gives, automatic and manual, every integer type
  LF := "{:{}}|{:>{}}|{:<{}}";
  Same(FormatStr("{:{}}|{:>{}}|{:<{}}", 7, 5, 'x', uint8(3), "ab", uint64(4)),
    FormatStr(LF, 7, 5, 'x', uint8(3), "ab", uint64(4)));
  LF := "{0:{1}}|{1:{0}}|{2:^{1}}";
  Same(FormatStr("{0:{1}}|{1:{0}}|{2:^{1}}", 3, 6, true), FormatStr(LF, 3, 6, true));
  LF := "{:.{}f}|{:{}.{}e}|{:.{}}";
  Same(FormatStr("{:.{}f}|{:{}.{}e}|{:.{}}", 3.14159, int16(2), 1.5, clong(12), culong(3), "abcdef",
    int8(4)), FormatStr(LF, 3.14159, int16(2), 1.5, clong(12), culong(3), "abcdef", int8(4)));
  LF := "{:{}}|{:{}}";
  Same(FormatStr("{:{}}|{:{}}", 9, 0, 9, uint32(1)), FormatStr(LF, 9, 0, 9, uint32(1)));
  // bool and char
  LF := "{:>6}|{:s}|{:d}|{:#x}|{:^7}|{:06b}";
  Same(FormatStr("{:>6}|{:s}|{:d}|{:#x}|{:^7}|{:06b}", true, false, true, true, false, true),
    FormatStr(LF, true, false, true, true, false, true));
  LF := "{:>3}|{:c}|{:d}|{:#x}|{:?}|{:<4?}|{:L}";
  Same(FormatStr("{:>3}|{:c}|{:d}|{:#x}|{:?}|{:<4?}|{:L}", 'A', 'B', 'C', 'D', 'E', 'F', 'G'),
    FormatStr(LF, 'A', 'B', 'C', 'D', 'E', 'F', 'G'));
  // floats: every letter, precision, sign, #, 0, inf / nan, float32
  LF := "{:.3f}|{:e}|{:E}|{:g}|{:G}|{:a}|{:A}|{:F}";
  Same(FormatStr("{:.3f}|{:e}|{:E}|{:g}|{:G}|{:a}|{:A}|{:F}", 3.14159, 1234.5, 0.00012, 1e20,
    1e-20, 1.0, 255.5, 2.5), FormatStr(LF, 3.14159, 1234.5, 0.00012, 1e20, 1e-20, 1.0, 255.5, 2.5));
  LF := "{:+.2e}|{:010.3f}|{:#g}|{:#.0f}|{:^12}|{:*<9.1f}|{: }";
  Same(FormatStr("{:+.2e}|{:010.3f}|{:#g}|{:#.0f}|{:^12}|{:*<9.1f}|{: }", 12345.678, -3.5, 2.0, 7.0,
    0.1, 9.96, 1.25), FormatStr(LF, 12345.678, -3.5, 2.0, 7.0, 0.1, 9.96, 1.25));
  LF := "{:.2f}|{:08}|{:+}|{:e}|{:L}|{:.0e}";
  LZero := 0.0;
  Same(FormatStr("{:.2f}|{:08}|{:+}|{:e}|{:L}|{:.0e}", float32(0.1), 1.0 / LZero,
    -(LZero / LZero), float32(16777216.0), 0.5, 15.0), FormatStr(LF, float32(0.1), 1.0 / LZero,
    -(LZero / LZero), float32(16777216.0), 0.5, 15.0));
  // pointers: nil, p / P, width, zero padding; an address by both paths
  LP := nil;
  LF := "{:p}|{:P}|{:>6}|{:06}|{:<5p}|{:*^7}";
  Same(FormatStr("{:p}|{:P}|{:>6}|{:06}|{:<5p}|{:*^7}", LP, LP, LP, LP, nil, LP),
    FormatStr(LF, LP, LP, LP, LP, nil, LP));
  LValue := 5;
  LTyped := addr of LValue;
  LF := "{:>24}|{:P}|{:020p}";
  SameQuiet("address", FormatStr("{:>24}|{:P}|{:020p}", LTyped, addr of LValue, LTyped),
    FormatStr(LF, LTyped, addr of LValue, LTyped));
  LF := "{:>20}";
  SameQuiet("routine", FormatStr("{:>20}", Same), FormatStr(LF, Same));
  // text forms: string, wstring, wchar, C text, nil, choices
  LF := "{:>6}|{:<6}|{:^6}|{:.2}|{:s}|{:?}|{:-^9.3s}|{:>8?}";
  Same(FormatStr("{:>6}|{:<6}|{:^6}|{:.2}|{:s}|{:?}|{:-^9.3s}|{:>8?}", "hello", "hi", "abc",
    "xyz", "s", "q\"t", "abcdef", "a\tb"), FormatStr(LF, "hello", "hi", "abc", "xyz", "s", "q\"t",
    "abcdef", "a\tb"));
  LW := "wé";
  LC := ptr to const char("abc");
  LCNil := nil;
  LF := "{:>4}|{:^5}|{:?}|{:.2}|{:>5}|{:?}|{:<6s}";
  Same(FormatStr("{:>4}|{:^5}|{:?}|{:.2}|{:>5}|{:?}|{:<6s}", LW, wchar(233), wchar(10), LC, LCNil,
    LC, "é"), FormatStr(LF, LW, wchar(233), wchar(10), LC, LCNil, LC, "é"));
  LColor := Color.Green;
  LF := "{:>7}|{:?}|{:.3}|{:*<8s}|{:>9}";
  Same(FormatStr("{:>7}|{:?}|{:.3}|{:*<8s}|{:>9}", LColor, Color.Red, Color.Blue, LColor, Color(9)),
    FormatStr(LF, LColor, Color.Red, Color.Blue, LColor, Color(9)));
  // escapes beside a spec, and an empty spec beside one
  LF := "{{{:3}}} {:} {:x}";
  Same(FormatStr("{{{:3}}} {:} {:x}", 1, 2, 10), FormatStr(LF, 1, 2, 10));
  println("print path:");
  LF := "{:>5}|{:.1f}";
  println(LF, 7, 2.25);
  // fields a formatter does not read, type letters it refuses, a text form's checks
  RaiseText("{:+}", "a");
  RaiseText("{:#}", "a");
  RaiseText("{:05}", "a");
  RaiseText("{:L}", "a");
  RaiseText("{:x}", "a");
  RaiseText("{:d}", "a");
  RaiseInt("{:00}", 1);
  RaiseInt("{:.2}", 1);
  RaiseInt("{:z}", 1);
  RaiseInt("{:s}", 1);
  RaiseInt("{:f}", 1);
  RaiseInt("{:?}", 1);
  RaiseInt("{:+c}", 65);
  RaiseInt("{:#c}", 65);
  RaiseInt("{:0c}", 65);
  RaiseInt("{:c}", 300);
  RaiseInt("{:c}", -129);
  RaiseInt("{:>5x5}", 1);
  RaiseBool("{:+}", true);
  RaiseBool("{:#s}", true);
  RaiseBool("{:05}", true);
  RaiseBool("{:c}", true);
  RaiseBool("{:?}", true);
  RaiseChar("{:+?}", 'a');
  RaiseChar("{:#}", 'a');
  RaiseChar("{:0c}", 'a');
  RaiseChar("{:s}", 'a');
  RaiseFloat("{:x}", 1.0);
  RaiseFloat("{:d}", 1.0);
  RaiseFloat("{:.}", 1.0);
  RaiseFloat("{:.", 1.0);
  RaiseFloat("{:.x}", 1.0);
  RaisePtr("{:x}", nil);
  RaisePtr("{:#}", nil);
  RaisePtr("{:+}", nil);
  RaisePtr("{:.2}", nil);
  // fill and align
  RaiseInt("{:{<5}", 1);
  RaiseInt("{:}<5}", 1);
  LBad := "{:" + char(int64(255) & 0xFF) + ">5}";
  RaiseInt(LBad, 1);
  LBad := "{:" + char(int64(195) & 0xFF) + "}";
  RaiseInt(LBad, 1);
  // nested argument ids and their values
  RaiseInt("{:{}}", 1);
  RaiseInt("{:{}", 1);
  RaiseInt("{:{", 1);
  RaiseInt("{:{x}}", 1);
  RaiseInt("{:{1x}}", 1);
  RaiseInt("{:{:}}", 1);
  RaiseInt("{0:{}}", 1);
  RaiseInt("{:{0}}", 1);
  RaiseInt("{:99999999999}", 1);
  RaiseInt("{:2147483648}", 1);
  RaiseWidth("{:{}}", 1, -1);
  RaiseWidth("{:{}}", 1, 2147483648);
  RaiseWidthU32("{:{}}", 1, 3000000000u);
  RaiseWidthText("{:{}}", 1, "x");
  RaiseWidthChar("{:{}}", 1, 'c');
  RaiseWidth("{0:{1}} {}", 1, 2);
  RaiseFloat("{:.{}f}", 1.0);
  // libc++'s order: the spec's own refusal, then the argument's width, then the '}'
  RaiseInt("{:+c", 300);
  RaiseInt("{:c", 300);
  RaiseInt("{:5", 1);
  RaiseWidth("{:{1}x", 1, -2);
  RaiseWidth("{0:{1}x", 1, -2);
  RaiseWidth("{0:{1x}}", 1, 2);
  println("done {}", 0);
end.
