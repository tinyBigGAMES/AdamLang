-------------------------------------------------------------------------------
  lsp_watch.adam - Adam's language server's watched files (M11b L8):
  Adam.Lsp.Server (imported from the compiler's own src\) serves a scripted
  client over a channel of the row's; each message is printed short.

  A client that takes registrations: the main sample (a buffer) imports a
  unit on the disk and names a folder by @addmodulepath; its check
  registers the unit's file and the folder (the std units it reads too:
  "+ others"), and the client's response is taken quietly. The unit is
  rewritten on the disk (WatchValue renamed) once request 2 is answered;
  workspace/didChangeWatchedFiles checks the main sample again (now an
  error), the set unchanged (no request). Opening the unit leaves its file
  out (a new registration, then the old one's unregistration); closing it
  puts it back. A second session whose client does not take registrations
  sends none (its didChangeWatchedFiles still checks the open documents
  again).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | == a client that takes registrations
  | <- 1 result
  | -> diagnostics lsp_watch_main.adam v1
  | -> register adam-watch-reg-1 adam-watch-1 workspace/didChangeWatchedFiles: lsp_watch_libs lsp_watch_unit.adam + others
  | <- 2 lsp_watch_unit.adam 2:15-2:25
  | == unit rewritten
  | -> diagnostics lsp_watch_main.adam v1
  |    7:16 SM0021 'WatchValue' is not declared
  | -> diagnostics lsp_watch_unit.adam v1
  | -> register adam-watch-reg-2 adam-watch-2 workspace/didChangeWatchedFiles: lsp_watch_libs + others
  | -> client/unregisterCapability adam-watch-unreg-1 adam-watch-1 workspace/didChangeWatchedFiles
  | -> diagnostics lsp_watch_unit.adam v-1
  | -> register adam-watch-reg-3 adam-watch-3 workspace/didChangeWatchedFiles: lsp_watch_libs lsp_watch_unit.adam + others
  | -> client/unregisterCapability adam-watch-unreg-2 adam-watch-2 workspace/didChangeWatchedFiles
  | <- 3 null
  | == exit 0
  | == a client that does not
  | <- 1 result
  | -> diagnostics lsp_watch_main.adam v1
  | -> diagnostics lsp_watch_main.adam v1
  | <- 2 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_watch;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Protocol.Transport, Adam.Lsp.Server;

// The main sample (a buffer)
routine MainText(): string;
begin
  return
    "module exe lsp_watch_main;\n" +
    "\n" +
    "@addmodulepath \"$P:lsp_watch_libs\";\n" +
    "\n" +
    "import lsp_watch_unit;\n" +
    "\n" +
    "begin\n" +
    "  println(\"{}\", WatchValue());\n" +
    "end.\n";
end;

// The unit on the disk, its routine named AName
routine UnitText(const AName: string): string;
begin
  return
    "module unit lsp_watch_unit;\n" +
    "\n" +
    "public routine " + AName + "(): int32;\n" +
    "begin\n" +
    "  return 7;\n" +
    "end;\n" +
    "\n" +
    "end.\n";
end;

// The last part of a URI's path
routine FileOf(const AUri: string): string;
var
  LParts: StringArray;
begin
  LParts := SplitString(AUri, "/");
  return LParts[len(LParts) - 1];
end;

// A Range object as start line:character-end line:character
routine RangeText(const ARange: Json): string;
begin
  return IntToStr(ARange.Get("start.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("start.character").AsInt64()) + "-" +
    IntToStr(ARange.Get("end.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("end.character").AsInt64());
end;

type
  // The client's side
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FTogether: BoolArray;
    // The row's folder ('/' form, ending in '/'): watched paths in it are printed by name
    FFolder: string;
    // The unit's file, rewritten once the response to request FRewriteId is written
    FUnitPath: string;
    FRewriteId: int64;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: Json): Json;
    var
      LMessage: Json;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId, sent with the one before when ATogether
    method Request(const AId: int64; const AMethod: string; const AParams: Json;
      const ATogether: bool);
    var
      LMessage: Json;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString(), ATogether);
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: Json; const ATogether: bool);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString(), ATogether);
    end;

    // The client's null response to the server's request AId
    method Answer(const AId: string);
    var
      LMessage: Json;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("id", AId);
      LMessage.AddNull("result");
      self.Raw(LMessage.ToString(), false);
    end;

    // ABody framed
    method Raw(const ABody: string; const ATogether: bool);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FTogether, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FTogether[LCount] := ATogether;
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // The next message waits only when it was sent together with the one before
    override method HasPending(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FStarts) - 1 do
        if self.FStarts[LI] >= self.FAt then
          return self.FTogether[LI];
        end;
      end;
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // A watched path short: its name in the row's folder, else "" (the std's and the
    // runtime's units: counted as others)
    method Short(const APath: string): string;
    begin
      if StartsText(self.FFolder, APath) then
        return Substring(APath, len(self.FFolder), len(APath) - len(self.FFolder));
      end;
      return "";
    end;

    // The server's request AMessage, short
    method PrintRequest(const AMessage: Json);
    var
      LItems: array of Json;
      LWatchers: array of Json;
      LLine: string;
      LOthers: int64;
      LName: string;
      LI: int64;
    begin
      if AMessage.Get("method").AsString() = "client/registerCapability" then
        LItems := AMessage.Get("params.registrations").Items();
        LWatchers := LItems[0].Get("registerOptions.watchers").Items();
        LLine := "-> register " + AMessage.Get("id").AsString() + " " +
          LItems[0].Get("id").AsString() + " " + LItems[0].Get("method").AsString() + ":";
        LOthers := 0;
        for LI := 0 to len(LWatchers) - 1 do
          LName := self.Short(LWatchers[LI].Get("globPattern").AsString());
          if LName = "" then
            LOthers := LOthers + 1;
          else
            LLine := LLine + " " + LName;
          end;
        end;
        if LOthers > 0 then
          LLine := LLine + " + others";
        end;
        println("{}", LLine);
        return;
      end;
      LItems := AMessage.Get("params.unregisterations").Items();
      println("-> {} {} {} {}", AMessage.Get("method").AsString(), AMessage.Get("id").AsString(),
        LItems[0].Get("id").AsString(), LItems[0].Get("method").AsString());
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: Json;
      LItems: array of Json;
      LI: int64;
      LMethod: string;
    begin
      LMessage := Json.FromString(ABody);
      if not LMessage.Has("method") then
        if LMessage.Has("error") then
          println("<- {} error {}: {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("error.code").AsInt64(), LMessage.Get("error.message").AsString());
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LMessage.Get("id").AsInt64());
        else
          if LMessage.Has("result.capabilities") then
            println("<- {} result", LMessage.Get("id").AsInt64());
          else
            println("<- {} {} {}", LMessage.Get("id").AsInt64(),
              FileOf(LMessage.Get("result.uri").AsString()),
              RangeText(LMessage.Get("result.range")));
          end;
        end;
        // The unit changes on the disk once this request is answered
        if LMessage.Get("id").AsInt64() = self.FRewriteId then
          WriteAllText(self.FUnitPath, UnitText("WatchRenamed"));
          println("== unit rewritten");
        end;
        return;
      end;
      if LMessage.Has("id") then
        self.PrintRequest(LMessage);
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "textDocument/publishDiagnostics" then
        println("-> diagnostics {} v{}", FileOf(LMessage.Get("params.uri").AsString()),
          LMessage.Get("params.version").AsInt64(-1));
        LItems := LMessage.Get("params.diagnostics").Items();
        for LI := 0 to len(LItems) - 1 do
          println("   {}:{} {} {}", LItems[LI].Get("range.start.line").AsInt64(),
            LItems[LI].Get("range.start.character").AsInt64(),
            LItems[LI].Get("code").AsString(""), LItems[LI].Get("message").AsString(""));
        end;
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// didOpen's params: AUri with AText at version 1
routine OpenParams(const AUri: string; const AText: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.Add("languageId", "adam");
  LJson.Add("version", 1);
  LJson.Add("text", AText);
  LJson.EndObject();
  return LJson;
end;

// A document's params with its URI only (didClose's)
routine UriParams(const AUri: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.EndObject();
  return LJson;
end;

// initialize's params: AWatch the client takes watcher registrations
routine InitParams(const AWatch: bool): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("capabilities");
  LJson.BeginObject("workspace");
  LJson.BeginObject("didChangeWatchedFiles");
  LJson.Add("dynamicRegistration", AWatch);
  LJson.EndObject();
  LJson.EndObject();
  LJson.EndObject();
  return LJson;
end;

// didChangeWatchedFiles' params: AUri changed
routine ChangedParams(const AUri: string): Json;
var
  LJson: Json;
begin
  LJson.BeginArray("changes");
  LJson.BeginObject();
  LJson.Add("uri", AUri);
  LJson.Add("type", 2);
  LJson.EndObject();
  LJson.EndArray();
  return LJson;
end;

// A definition request (AId) at ALine / ACharacter of AUri
routine DefinitionParams(const AUri: string; const ALine: int64; const ACharacter: int64): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.EndObject();
  LJson.BeginObject("position");
  LJson.Add("line", ALine);
  LJson.Add("character", ACharacter);
  LJson.EndObject();
  return LJson;
end;

// A channel for the row's folder AFolder, the unit's file AUnitPath
routine NewChannel(const AFolder: string; const AUnitPath: string): ref ScriptChannel;
var
  LChannel: ref ScriptChannel;
begin
  LChannel := ref ScriptChannel();
  LChannel.FFolder := AFolder;
  LChannel.FUnitPath := AUnitPath;
  LChannel.FRewriteId := -1;
  return LChannel;
end;

var
  GC: ref ScriptChannel;
  GNone: Json;
  GPaths: StringArray;
  GFolder: string;
  GMainUri: string;
  GUnitPath: string;
  GUnitUri: string;
  GCode: int32;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GUnitPath := ResolvePath("$P:lsp_watch_unit.adam");
  GFolder := ReplaceStr(ExtractFileDir(GUnitPath), "\\", "/") + "/";
  ForceDirectories(ResolvePath("$P:lsp_watch_libs"));
  WriteAllText(GUnitPath, UnitText("WatchValue"));
  GMainUri := "file:///" + GFolder + "lsp_watch_main.adam";
  GUnitUri := "file:///" + GFolder + "lsp_watch_unit.adam";

  println("== a client that takes registrations");
  GC := NewChannel(GFolder, GUnitPath);
  GC.FRewriteId := 2;
  GC.Request(1, "initialize", InitParams(true), false);
  GC.Notify("textDocument/didOpen", OpenParams(GMainUri, MainText()), false);
  GC.Answer("adam-watch-reg-1");
  GC.Request(2, "textDocument/definition", DefinitionParams(GMainUri, 7, 17), false);
  GC.Notify("workspace/didChangeWatchedFiles", ChangedParams(GUnitUri), false);
  GC.Notify("textDocument/didOpen", OpenParams(GUnitUri, UnitText("WatchRenamed")), false);
  GC.Notify("textDocument/didClose", UriParams(GUnitUri), false);
  GC.Request(3, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  GCode := RunLsp(ref ProtocolTransport(GC), GPaths);
  println("== exit {}", GCode);

  println("== a client that does not");
  WriteAllText(GUnitPath, UnitText("WatchValue"));
  GC := NewChannel(GFolder, GUnitPath);
  GC.Request(1, "initialize", InitParams(false), false);
  GC.Notify("textDocument/didOpen", OpenParams(GMainUri, MainText()), false);
  GC.Notify("workspace/didChangeWatchedFiles", ChangedParams(GUnitUri), false);
  GC.Request(2, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  GCode := RunLsp(ref ProtocolTransport(GC), GPaths);
  println("== exit {}", GCode);
end.
