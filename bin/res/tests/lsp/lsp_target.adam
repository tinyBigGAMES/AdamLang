-------------------------------------------------------------------------------
  lsp_target.adam - Adam's language server checks for the client's target
  (an editor's toolbar): Adam.Lsp.Server (imported from the compiler's own
  src\) serves a scripted client over a channel of the row's; each message
  is printed short.

  A buffer limited to x86_64-linux-gnu (its @ifndef / @message error
  guard) is clean for a client that gives that target at initialize
  (initializationOptions.target); workspace/didChangeConfiguration to
  x86_64-windows-gnu checks it again (the guard's SM0108), back to
  x86_64-linux-gnu clean again. The same target again checks nothing; a
  triple Adam has no target for is told (window/logMessage) and the target
  kept (nothing checked). A buffer naming its own @target keeps it whatever
  the client gives (as a build's -t under --defaults). A client that gives
  no target gets the built-in default (the guard's SM0108).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | == a client with a target
  | <- 1 result
  | -> diagnostics lsp_target_main.adam v1
  | == x86_64-windows-gnu
  | -> diagnostics lsp_target_main.adam v1
  |    3:0 SM0108 x86_64-linux-gnu only
  | == x86_64-linux-gnu
  | -> diagnostics lsp_target_main.adam v1
  | == the same again
  | == a triple Adam has no target for
  | -> window/logMessage Invalid parameters for "workspace/didChangeConfiguration"
  | <- 2 null
  | == exit 0
  | == a buffer naming its own @target
  | <- 1 result
  | -> diagnostics lsp_target_main.adam v1
  |    4:0 SM0108 x86_64-linux-gnu only
  | <- 2 null
  | == exit 0
  | == a client with no target
  | <- 1 result
  | -> diagnostics lsp_target_main.adam v1
  |    3:0 SM0108 x86_64-linux-gnu only
  | <- 2 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_target;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Protocol.Transport, Adam.Lsp.Server;

// The main sample (a buffer), limited to x86_64-linux-gnu; AOwnTarget names its own
// @target (x86_64-windows-gnu)
routine MainText(const AOwnTarget: bool): string;
var
  LTarget: string;
begin
  LTarget := "";
  if AOwnTarget then
    LTarget := "@target \"x86_64-windows-gnu\";\n";
  end;
  return
    "module exe lsp_target_main;\n" +
    LTarget +
    "\n" +
    "@ifndef TARGET_X86_64_LINUX_GNU\n" +
    "@message error \"x86_64-linux-gnu only\";\n" +
    "@endif\n" +
    "\n" +
    "begin\n" +
    "end.\n";
end;

// The last part of a URI's path
routine FileOf(const AUri: string): string;
var
  LParts: StringArray;
begin
  LParts := SplitString(AUri, "/");
  return LParts[len(LParts) - 1];
end;

type
  // The client's side
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    // The label of request id 10 + n (a "$/label" request the server refuses as unknown:
    // its error response comes in order, before what the next message does)
    FLabels: StringArray;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: Json): Json;
    var
      LMessage: Json;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId
    method Request(const AId: int64; const AMethod: string; const AParams: Json);
    var
      LMessage: Json;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString());
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: Json);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString());
    end;

    // ABody framed
    method Raw(const ABody: string);
    begin
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // No message waits: every notification is checked at once (each one idles)
    override method HasPending(): bool;
    begin
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: Json;
      LItems: array of Json;
      LI: int64;
      LMethod: string;
    begin
      LMessage := Json.FromString(ABody);
      if not LMessage.Has("method") then
        if LMessage.Has("error") and (LMessage.Get("id").AsInt64() >= 10) then
          println("== {}", self.FLabels[LMessage.Get("id").AsInt64() - 10]);
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LMessage.Get("id").AsInt64());
        else
          println("<- {} result", LMessage.Get("id").AsInt64());
        end;
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "textDocument/publishDiagnostics" then
        println("-> diagnostics {} v{}", FileOf(LMessage.Get("params.uri").AsString()),
          LMessage.Get("params.version").AsInt64(-1));
        LItems := LMessage.Get("params.diagnostics").Items();
        for LI := 0 to len(LItems) - 1 do
          println("   {}:{} {} {}", LItems[LI].Get("range.start.line").AsInt64(),
            LItems[LI].Get("range.start.character").AsInt64(),
            LItems[LI].Get("code").AsString(""), LItems[LI].Get("message").AsString(""));
        end;
        return;
      end;
      if LMethod = "window/logMessage" then
        println("-> {} {}", LMethod, LMessage.Get("params.message").AsString());
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// didOpen's params: AUri with AText at version 1
routine OpenParams(const AUri: string; const AText: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.Add("languageId", "adam");
  LJson.Add("version", 1);
  LJson.Add("text", AText);
  LJson.EndObject();
  return LJson;
end;

// initialize's params: ATarget the client's target, none when AHasTarget is false
routine InitParams(const AHasTarget: bool; const ATarget: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("capabilities");
  LJson.EndObject();
  if AHasTarget then
    LJson.BeginObject("initializationOptions");
    LJson.Add("target", ATarget);
    LJson.EndObject();
  end;
  return LJson;
end;

// didChangeConfiguration's params: the client's target ATarget
routine TargetParams(const ATarget: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("settings");
  LJson.Add("target", ATarget);
  LJson.EndObject();
  return LJson;
end;

// A session: AOwnTarget the buffer's own @target, the client's initialize target ATarget
// (none when AHasTarget is false), then each of AChanges a didChangeConfiguration printed
// under its name
routine RunSession(const APaths: StringArray; const AUri: string; const AOwnTarget: bool;
  const AHasTarget: bool; const ATarget: string; const AChanges: StringArray;
  const ALabels: StringArray);
var
  LChannel: ref ScriptChannel;
  LNone: Json;
  LI: int64;
  LCode: int32;
begin
  LChannel := ref ScriptChannel();
  LChannel.FLabels := ALabels;
  LChannel.Request(1, "initialize", InitParams(AHasTarget, ATarget));
  LChannel.Notify("textDocument/didOpen", OpenParams(AUri, MainText(AOwnTarget)));
  for LI := 0 to len(AChanges) - 1 do
    LChannel.Request(10 + LI, "$/label", LNone);
    LChannel.Notify("workspace/didChangeConfiguration", TargetParams(AChanges[LI]));
  end;
  LChannel.Request(2, "shutdown", LNone);
  LChannel.Notify("exit", LNone);
  LCode := RunLsp(ref ProtocolTransport(LChannel), APaths);
  println("== exit {}", LCode);
end;
var
  GPaths: StringArray;
  GFolder: string;
  GUri: string;
  GChanges: StringArray;
  GLabels: StringArray;
  GNone: StringArray;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GFolder := ReplaceStr(ExtractFileDir(ResolvePath("$P:lsp_target_main.adam")), "\\", "/") + "/";
  GUri := "file:///" + GFolder + "lsp_target_main.adam";
  setlength(GNone, 0);

  println("== a client with a target");
  setlength(GChanges, 4);
  setlength(GLabels, 4);
  GChanges[0] := "x86_64-windows-gnu";
  GLabels[0] := "x86_64-windows-gnu";
  GChanges[1] := "x86_64-linux-gnu";
  GLabels[1] := "x86_64-linux-gnu";
  GChanges[2] := "x86_64-linux-gnu";
  GLabels[2] := "the same again";
  GChanges[3] := "x86_64-bogus-gnu";
  GLabels[3] := "a triple Adam has no target for";
  RunSession(GPaths, GUri, false, true, "x86_64-linux-gnu", GChanges, GLabels);

  println("== a buffer naming its own @target");
  RunSession(GPaths, GUri, true, true, "x86_64-linux-gnu", GNone, GNone);

  println("== a client with no target");
  RunSession(GPaths, GUri, false, false, "", GNone, GNone);
end.
