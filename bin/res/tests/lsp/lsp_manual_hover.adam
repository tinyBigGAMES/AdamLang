-------------------------------------------------------------------------------
  lsp_manual_hover.adam - hover (M11b L9)

  Resting the mouse on a name shows its declaration in a code box. A name
  from another file also shows that file's name under the box.

  How to check: hover each name a CHECK line names (on the code line below
  it) and compare the box with the text after "->".
  Needs lsp_manual_unit.adam in the same folder.
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_hover;

import lsp_manual_unit;

type
  Point = record
    X: int32;
    Y: int32;
  end;

const
  Limit: int32 = 10;

var
  GPoint: Point;
  GTotal: int32;

func Add(const AA: int32; const AB: int32): int32;
begin
  // CHECK: AA -> const AA: int32
  return AA + AB;
end;

func Show(const AN: int32);
begin
end;

func Show(const AS: string);
begin
end;

begin
  // CHECK: GPoint -> var GPoint: Point
  // CHECK: X      -> X: int32 (a field, reached through GPoint.)
  GPoint.X := 1;

  // CHECK: Add   -> func Add(const AA: int32; const AB: int32): int32
  // CHECK: Limit -> const Limit: int32 = 10
  GTotal := Add(Limit, GPoint.X);

  // CHECK: lsp_manual_unit -> module unit lsp_manual_unit; and
  //                           *lsp_manual_unit.adam* below the box
  // CHECK: Twice -> func Twice(const AX: int32): int32, its doc
  //                 ("Doubles a value." ...), and *lsp_manual_unit.adam*
  GTotal := lsp_manual_unit.Twice(GTotal);

  // CHECK: Show -> func Show(const AN: int32) only (an overload set:
  //                the check picked the one that takes an int32)
  Show(GTotal);
  // CHECK: Show -> func Show(const AS: string) only
  Show("text");

  // CHECK: println -> nothing (an intrinsic: no declaration)
  println("{}", GTotal);

  // CHECK: Point (in the type block above) -> type Point = record
  // CHECK: GTotal on its own declaration line above -> var GTotal: int32
end.
