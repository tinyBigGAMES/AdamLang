-------------------------------------------------------------------------------
  lsp_tokens.adam - Adam's language server's semantic tokens (M11b L2):
  Adam.LSP.Server (imported from the compiler's own src\) serves scripted
  clients over a channel of the row's; every semantic token is printed by
  its line as word:kind (kw keyword, ty type, ns namespace, st struct, cl
  class, if interface, en enum, em enumMember, tp typeParameter, fn
  function, me method, pr property, va variable, pa parameter, ma macro;
  +d declaration, +r readonly).

  Session tokens (utf-16): initialize names the legend, full and the
  word lists (keywords, types, context words); the sample (every declaration kind, a generic, a generator,
  a unit-qualified call, a record literal, defer / yield / sequence /
  property / read as keywords, an @ifdef whose inactive branch is
  uncoloured, an undeclared name left uncoloured, a name after an emoji)
  opened with the request sent together: checked first (its diagnostics),
  then coloured; a URI not open is null, no URI an error -32602; a change
  sent with the request is checked again first (the error gone, the name a
  variable); an untitled: document (no file) gets the Lexer's colours, its
  names none. Session utf8: the emoji's line in UTF-8 bytes.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | == tokens
  | <- 1 result
  |    positionEncoding utf-16
  |    tokens keyword type namespace struct class interface enum enumMember typeParameter function method property variable parameter macro
  |    modifiers declaration readonly
  |    full true
  |    keywords module .. literal
  |    types int8 int16 int32 int64 uint8 uint16 uint32 uint64 clong culong float32 float64 bool char wchar string wstring
  |    contextWords abstract .. yield
  | -> diagnostics v1
  |    48:4 SM0021
  | <- 2 result
  |    0 module:kw exe:kw lsp_tokens_main:ns+d
  |    2 import:kw System:ns SysUtils:ns
  |    4 const:kw
  |    5 ADAM_ROW_LIMIT:va+d+r int32:ty
  |    7 type:kw
  |    8 Color:en+d choices:kw Red:em+d Green:em+d
  |    9 IShape:if+d interface:kw
  |    10 method:kw Area:me+d int32:ty
  |    11 end:kw
  |    12 Point:st+d record:kw
  |    13 X:pr+d int32:ty
  |    14 end:kw
  |    15 Box:cl+d object:kw
  |    16 FSide:pr+d int32:ty
  |    17 property:kw Side:pr+d int32:ty read:kw FSide:pr
  |    18 method:kw Grow:me+d const:kw AStep:pa+d int32:ty
  |    19 begin:kw
  |    20 self:kw FSide:pr self:kw FSide:pr AStep:pa
  |    21 end:kw
  |    22 end:kw
  |    24 var:kw
  |    25 GText:va+d string:ty
  |    26 GBox:va+d Box:cl
  |    28 func:kw Pick:fn+d T:tp+d const:kw AValue:pa+d T:tp T:tp
  |    29 begin:kw
  |    30 return:kw AValue:pa
  |    31 end:kw
  |    33 func:kw Count:fn+d sequence:kw of:kw int32:ty
  |    34 begin:kw
  |    35 yield:kw ADAM_ROW_LIMIT:va+r
  |    36 end:kw
  |    38 begin:kw
  |    39 defer:kw println:fn GText:va
  |    40 GText:va GText:va System:ns SysUtils:ns IntToStr:fn Pick:fn int32:ty
  |    41 GBox:va Grow:me Point:st X:pr X:pr
  |    42 @ifdef:ma
  |    43 GText:va
  |    44 @else:ma
  |    46 @endif:ma
  |    47 if:kw Color:en Red:em Color:en Green:em then:kw
  |    49 end:kw
  |    50 end:kw
  | <- 3 null
  | <- 4 error -32602: Invalid parameters for "textDocument/semanticTokens/full"
  | -> diagnostics v2
  | <- 5 result
  |    0 module:kw exe:kw lsp_tokens_main:ns+d
  |    2 import:kw System:ns SysUtils:ns
  |    4 const:kw
  |    5 ADAM_ROW_LIMIT:va+d+r int32:ty
  |    7 type:kw
  |    8 Color:en+d choices:kw Red:em+d Green:em+d
  |    9 IShape:if+d interface:kw
  |    10 method:kw Area:me+d int32:ty
  |    11 end:kw
  |    12 Point:st+d record:kw
  |    13 X:pr+d int32:ty
  |    14 end:kw
  |    15 Box:cl+d object:kw
  |    16 FSide:pr+d int32:ty
  |    17 property:kw Side:pr+d int32:ty read:kw FSide:pr
  |    18 method:kw Grow:me+d const:kw AStep:pa+d int32:ty
  |    19 begin:kw
  |    20 self:kw FSide:pr self:kw FSide:pr AStep:pa
  |    21 end:kw
  |    22 end:kw
  |    24 var:kw
  |    25 GText:va+d string:ty
  |    26 GBox:va+d Box:cl
  |    28 func:kw Pick:fn+d T:tp+d const:kw AValue:pa+d T:tp T:tp
  |    29 begin:kw
  |    30 return:kw AValue:pa
  |    31 end:kw
  |    33 func:kw Count:fn+d sequence:kw of:kw int32:ty
  |    34 begin:kw
  |    35 yield:kw ADAM_ROW_LIMIT:va+r
  |    36 end:kw
  |    38 begin:kw
  |    39 defer:kw println:fn GText:va
  |    40 GText:va GText:va System:ns SysUtils:ns IntToStr:fn Pick:fn int32:ty
  |    41 GBox:va Grow:me Point:st X:pr X:pr
  |    42 @ifdef:ma
  |    43 GText:va
  |    44 @else:ma
  |    46 @endif:ma
  |    47 if:kw Color:en Red:em Color:en Green:em then:kw
  |    48 GText:va
  |    49 end:kw
  |    50 end:kw
  | -> diagnostics v1
  | <- 6 result
  |    0 var:kw int32:ty
  | <- 7 null
  | == exit 0
  | == utf8
  | <- 1 result
  |    positionEncoding utf-8
  |    tokens keyword type namespace struct class interface enum enumMember typeParameter function method property variable parameter macro
  |    modifiers declaration readonly
  |    full true
  |    keywords module .. literal
  |    types int8 int16 int32 int64 uint8 uint16 uint32 uint64 clong culong float32 float64 bool char wchar string wstring
  |    contextWords abstract .. yield
  | -> diagnostics v1
  |    48:4 SM0021
  | <- 2 result
  |    40 GText:va@2 GText:va@19 System:ns@28 SysUtils:ns@35 IntToStr:fn@44 Pick:fn@53 int32:ty@58
  | <- 3 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_tokens;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Protocol.Transport, Adam.LSP.Server;

const
  ADAM_ROW_EMOJI: string = "\xF0\x9F\x98\x80";

// The sample: AFixed puts GText where the undeclared GMissing is
func SampleText(const AFixed: bool): string;
var
  LMissing: string;
begin
  LMissing := "GMissing";
  if AFixed then
    LMissing := "GText ";
  end;
  return "module exe lsp_tokens_main;\n" +
    "\n" +
    "import System.SysUtils;\n" +
    "\n" +
    "const\n" +
    "  ADAM_ROW_LIMIT: int32 = 3;\n" +
    "\n" +
    "type\n" +
    "  Color = choices(Red, Green);\n" +
    "  IShape = interface\n" +
    "    method Area(): int32;\n" +
    "  end;\n" +
    "  Point = record\n" +
    "    X: int32;\n" +
    "  end;\n" +
    "  Box = object\n" +
    "    FSide: int32;\n" +
    "    property Side: int32 read FSide;\n" +
    "    method Grow(const AStep: int32);\n" +
    "    begin\n" +
    "      self.FSide := self.FSide + AStep;\n" +
    "    end;\n" +
    "  end;\n" +
    "\n" +
    "var\n" +
    "  GText: string;\n" +
    "  GBox: Box;\n" +
    "\n" +
    "func Pick<T>(const AValue: T): T;\n" +
    "begin\n" +
    "  return AValue;\n" +
    "end;\n" +
    "\n" +
    "func Count(): sequence of int32;\n" +
    "begin\n" +
    "  yield ADAM_ROW_LIMIT;\n" +
    "end;\n" +
    "\n" +
    "begin\n" +
    "  defer println(\"{}\", GText);\n" +
    "  GText := \"" + ADAM_ROW_EMOJI + "\"; GText := System.SysUtils.IntToStr(Pick<int32>(1));\n" +
    "  GBox.Grow(Point(X: 2).X);\n" +
    "@ifdef DEBUG\n" +
    "  GText := \"debug\";\n" +
    "@else\n" +
    "  GText := Hidden;\n" +
    "@endif\n" +
    "  if Color.Red = Color.Green then\n" +
    "    " + LMissing + " := \"x\";\n" +
    "  end;\n" +
    "end.\n";
end;

// The short name of the legend's token type AType
func KindName(const AType: int64): string;
const
  NAMES: array[0..14] of string = ["kw", "ty", "ns", "st", "cl", "if", "en", "em", "tp", "fn",
    "me", "pr", "va", "pa", "ma"];
begin
  if (AType < 0) or (AType > 14) then
    return "?" + IntToStr(AType);
  end;
  return NAMES[AType];
end;

// The byte index in ALine of the character AUnits counts in: UTF-16 units when AUTF16, else
// bytes
func ByteIndex(const ALine: string; const AUnits: int64; const AUTF16: bool): int64;
var
  LAt: int64;
  LCount: int64;
  LLead: int64;
begin
  if not AUTF16 then
    return AUnits;
  end;
  LAt := 0;
  LCount := 0;
  while (LAt < len(ALine)) and (LCount < AUnits) do
    LLead := int64(uint8(ALine[LAt]));
    if LLead >= 0xF0 then
      LAt := LAt + 4;
      LCount := LCount + 2;
    else
      if LLead >= 0xE0 then
        LAt := LAt + 3;
      else
        if LLead >= 0xC0 then
          LAt := LAt + 2;
        else
          LAt := LAt + 1;
        end;
      end;
      LCount := LCount + 1;
    end;
  end;
  return LAt;
end;

// AText's lines (split at LF)
func LinesOf(const AText: string): StringArray;
var
  LLines: StringArray;
  LStart: int64;
  LI: int64;
  LCount: int64;
begin
  setlength(LLines, 0);
  LStart := 0;
  for LI := 0 to len(AText) - 1 do
    if AText[LI] = '\n' then
      LCount := len(LLines);
      setlength(LLines, LCount + 1);
      LLines[LCount] := Substring(AText, LStart, LI - LStart);
      LStart := LI + 1;
    end;
  end;
  if LStart < len(AText) then
    LCount := len(LLines);
    setlength(LLines, LCount + 1);
    LLines[LCount] := Substring(AText, LStart, len(AText) - LStart);
  end;
  return LLines;
end;

// AList's texts joined by spaces
func Joined(const AList: JSON): string;
var
  LItems: array of JSON;
  LText: string;
  LI: int64;
begin
  LItems := AList.Items();
  LText := "";
  for LI := 0 to len(LItems) - 1 do
    if LI > 0 then
      LText := LText + " ";
    end;
    LText := LText + LItems[LI].AsString();
  end;
  return LText;
end;

type
  // The client's side (see the header)
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FTogether: BoolArray;
    // The texts the tokens are read against, by request id; positions counted in UTF-16
    // units when FUTF16; FOnly: the one line printed (-1 every line)
    FTextIds: Int64Array;
    FTexts: StringArray;
    FUTF16: bool;
    FOnly: int64;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: JSON): JSON;
    var
      LMessage: JSON;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId, sent with the one before when ATogether
    method Request(const AId: int64; const AMethod: string; const AParams: JSON;
      const ATogether: bool);
    var
      LMessage: JSON;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString(), ATogether);
    end;

    // A semantic tokens request AId for AURI, its answer read against AText
    method Tokens(const AId: int64; const AURI: string; const AText: string;
      const ATogether: bool);
    var
      LParams: JSON;
      LCount: int64;
    begin
      LParams.BeginObject("textDocument");
      LParams.Add("uri", AURI);
      LParams.EndObject();
      LCount := len(self.FTextIds);
      setlength(self.FTextIds, LCount + 1);
      setlength(self.FTexts, LCount + 1);
      self.FTextIds[LCount] := AId;
      self.FTexts[LCount] := AText;
      self.Request(AId, "textDocument/semanticTokens/full", LParams, ATogether);
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: JSON; const ATogether: bool);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString(), ATogether);
    end;

    // ABody framed
    method Raw(const ABody: string; const ATogether: bool);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FTogether, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FTogether[LCount] := ATogether;
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // The next message waits only when it was sent together with the one before
    override method HasPending(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FStarts) - 1 do
        if self.FStarts[LI] >= self.FAt then
          return self.FTogether[LI];
        end;
      end;
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // The tokens of the response AId, by line: word:kind
    method PrintTokens(const AId: int64; const AData: JSON);
    var
      LItems: array of JSON;
      LLines: StringArray;
      LText: string;
      LLine: int64;
      LCharacter: int64;
      LShown: int64;
      LOut: string;
      LWord: string;
      LStart: int64;
      LEnd: int64;
      LModifiers: int64;
      LI: int64;
    begin
      LText := "";
      for LI := 0 to len(self.FTextIds) - 1 do
        if self.FTextIds[LI] = AId then
          LText := self.FTexts[LI];
        end;
      end;
      LLines := LinesOf(LText);
      LItems := AData.Items();
      LLine := 0;
      LCharacter := 0;
      LShown := -1;
      LOut := "";
      LI := 0;
      while LI + 4 < len(LItems) do
        if LItems[LI].AsInt64() > 0 then
          LLine := LLine + LItems[LI].AsInt64();
          LCharacter := LItems[LI + 1].AsInt64();
        else
          LCharacter := LCharacter + LItems[LI + 1].AsInt64();
        end;
        if LLine <> LShown then
          if (LOut <> "") and ((self.FOnly < 0) or (LShown = self.FOnly)) then
            println("{}", LOut);
          end;
          LShown := LLine;
          LOut := "   " + IntToStr(LLine);
        end;
        LStart := ByteIndex(LLines[LLine], LCharacter, self.FUTF16);
        LEnd := ByteIndex(LLines[LLine], LCharacter + LItems[LI + 2].AsInt64(), self.FUTF16);
        LWord := Substring(LLines[LLine], LStart, LEnd - LStart);
        LOut := LOut + " " + LWord + ":" + KindName(LItems[LI + 3].AsInt64());
        LModifiers := LItems[LI + 4].AsInt64();
        if (LModifiers & 1) <> 0 then
          LOut := LOut + "+d";
        end;
        if (LModifiers & 2) <> 0 then
          LOut := LOut + "+r";
        end;
        if self.FOnly >= 0 then
          LOut := LOut + "@" + IntToStr(LCharacter);
        end;
        LI := LI + 5;
      end;
      if (LOut <> "") and ((self.FOnly < 0) or (LShown = self.FOnly)) then
        println("{}", LOut);
      end;
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: JSON;
      LItems: array of JSON;
      LI: int64;
      LMethod: string;
      LWords: array of JSON;
    begin
      LMessage := JSON.FromString(ABody);
      if not LMessage.Has("method") then
        if LMessage.Has("error") then
          println("<- {} error {}: {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("error.code").AsInt64(), LMessage.Get("error.message").AsString());
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LMessage.Get("id").AsInt64());
          return;
        end;
        println("<- {} result", LMessage.Get("id").AsInt64());
        if LMessage.Has("result.capabilities") then
          println("   positionEncoding {}",
            LMessage.Get("result.capabilities.positionEncoding").AsString());
          println("   tokens {}",
            Joined(LMessage.Get("result.capabilities.semanticTokensProvider.legend.tokenTypes")));
          println("   modifiers {}", Joined(LMessage.Get(
            "result.capabilities.semanticTokensProvider.legend.tokenModifiers")));
          println("   full {}",
            LMessage.Get("result.capabilities.semanticTokensProvider.full").AsBoolean());
          LWords := LMessage.Get("result.capabilities.experimental.adamWords.keywords").Items();
          println("   keywords {} .. {}", LWords[0].AsString(),
            LWords[len(LWords) - 1].AsString());
          println("   types {}",
            Joined(LMessage.Get("result.capabilities.experimental.adamWords.types")));
          LWords := LMessage.Get("result.capabilities.experimental.adamWords.contextWords").Items();
          println("   contextWords {} .. {}", LWords[0].AsString(),
            LWords[len(LWords) - 1].AsString());
        end;
        if LMessage.Has("result.data") then
          self.PrintTokens(LMessage.Get("id").AsInt64(), LMessage.Get("result.data"));
        end;
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "textDocument/publishDiagnostics" then
        println("-> diagnostics v{}", LMessage.Get("params.version").AsInt64(-1));
        LItems := LMessage.Get("params.diagnostics").Items();
        for LI := 0 to len(LItems) - 1 do
          println("   {}:{} {}", LItems[LI].Get("range.start.line").AsInt64(),
            LItems[LI].Get("range.start.character").AsInt64(),
            LItems[LI].Get("code").AsString(""));
        end;
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// A session over AChannel: its exit code printed
func DoServe(const ATitle: string; const AChannel: ref ScriptChannel; const APaths: StringArray);
var
  LCode: int32;
begin
  println("== {}", ATitle);
  LCode := RunLSP(ref ProtocolTransport(AChannel), APaths);
  println("== exit {}", LCode);
end;

// didOpen's params: AURI with AText at version 1
func OpenParams(const AURI: string; const AText: string): JSON;
var
  LJSON: JSON;
begin
  LJSON.BeginObject("textDocument");
  LJSON.Add("uri", AURI);
  LJSON.Add("languageId", "adam");
  LJSON.Add("version", 1);
  LJSON.Add("text", AText);
  LJSON.EndObject();
  return LJSON;
end;

// didChange's params: AURI at AVersion, its whole text AText
func ReplaceParams(const AURI: string; const AVersion: int64; const AText: string): JSON;
var
  LJSON: JSON;
  LChange: JSON;
begin
  LJSON.BeginObject("textDocument");
  LJSON.Add("uri", AURI);
  LJSON.Add("version", AVersion);
  LJSON.EndObject();
  LChange.Add("text", AText);
  LJSON.BeginArray("contentChanges");
  LJSON.Add(LChange);
  LJSON.EndArray();
  return LJSON;
end;

var
  GC: ref ScriptChannel;
  GNone: JSON;
  GPaths: StringArray;
  GURI: string;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GURI := "file:///" + ReplaceStr(ResolvePath("$P:lsp_tokens_main.adam"), "\\", "/");

  // Session tokens
  GC := ref ScriptChannel();
  GC.FUTF16 := true;
  GC.FOnly := -1;
  GC.Request(1, "initialize", GNone, false);
  GC.Notify("textDocument/didOpen", OpenParams(GURI, SampleText(false)), false);
  GC.Tokens(2, GURI, SampleText(false), true);
  GC.Tokens(3, "file:///nowhere/x.adam", "", false);
  GC.Request(4, "textDocument/semanticTokens/full", GNone, false);
  GC.Notify("textDocument/didChange", ReplaceParams(GURI, 2, SampleText(true)), false);
  GC.Tokens(5, GURI, SampleText(true), true);
  GC.Notify("textDocument/didOpen", OpenParams("untitled:u", "var x: int32;\n"), false);
  GC.Tokens(6, "untitled:u", "var x: int32;\n", true);
  GC.Request(7, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  DoServe("tokens", GC, GPaths);

  // Session utf8: the emoji's line (40) in bytes
  GC := ref ScriptChannel();
  GC.FUTF16 := false;
  GC.FOnly := 40;
  GC.Request(1, "initialize", JSON.FromString("{\"capabilities\": {\"general\": " +
    "{\"positionEncodings\": [\"utf-8\"]}}}"), false);
  GC.Notify("textDocument/didOpen", OpenParams(GURI, SampleText(false)), false);
  GC.Tokens(2, GURI, SampleText(false), true);
  GC.Request(3, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  DoServe("utf8", GC, GPaths);
end.
