-------------------------------------------------------------------------------
  lsp_outline.adam - Adam's language server's document outline (M11b L4):
  Adam.Lsp.Server (imported from the compiler's own src\) serves a scripted
  client over a channel of the row's; each DocumentSymbol is printed as its
  kind, name, [detail], range and name range, its children below it.

  The sample's outline: the module as the one entry, its import, a const, a
  choices type (enum, its values), a record with an anonymous overlay (its
  fields in its place), an interface, an object (a field, init, property,
  method, done), a routine with a local record type (its field and operator;
  the local variable not listed), a variable, the initialize section and a
  test; a URI not open is null, a request with no document an error -32602.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | <- 1 result documentSymbol true workspaceSymbol true
  | -> diagnostics v1
  | <- 2 1 symbols
  |   2 lsp_outline_main 0:0-77:0 name 1:11-1:27
  |     2 System.SysUtils 3:7-3:22 name 3:7-3:22
  |     14 ADAM_ROW_LIMIT [int32] 6:2-6:28 name 6:2-6:16
  |     10 Color 9:2-9:30 name 9:2-9:7
  |       22 Red 9:18-9:21 name 9:18-9:21
  |       22 Green 9:23-9:28 name 9:23-9:28
  |     23 Tagged 10:2-16:6 name 10:2-10:8
  |       8 Tag [int8] 11:4-11:14 name 11:4-11:7
  |       8 L [int64] 13:6-13:15 name 13:6-13:7
  |       8 S [int16] 14:6-14:15 name 14:6-14:7
  |     11 IShape 17:2-19:6 name 17:2-17:8
  |       6 Area [(): int32] 18:4-18:25 name 18:11-18:15
  |     5 Square 20:2-38:6 name 20:2-20:8
  |       8 FSide [int32] 21:11-21:24 name 21:11-21:16
  |       9 init [(const ASide: int32)] 23:4-26:8 name 23:4-23:8
  |       7 Side [int32] 28:4-28:36 name 28:13-28:17
  |       6 Area [(): int32] 30:4-33:8 name 30:19-30:23
  |       6 done 35:4-37:8 name 35:4-35:8
  |     12 Twice [(const AValue: int32): int32] 40:0-59:4 name 40:8-40:13
  |       23 Pair 42:2-52:6 name 42:2-42:6
  |         8 A [int32] 43:4-43:13 name 43:4-43:5
  |         25 operator + [(const AL: Pair; const AR: Pair): Pair] 45:4-51:8 name 45:13-45:14
  |     13 GSquare [ref Square] 62:2-62:22 name 62:2-62:9
  |     12 initialize 64:0-67:4 name 64:0-64:10
  |     24 the square 74:0-76:4 name 74:5-74:17
  | <- 3 null
  | <- 4 error -32602: Invalid parameters for "textDocument/documentSymbol"
  | <- 90 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_outline;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.Json, Adam.Protocol.Transport, Adam.Lsp.Server;

// The sample
routine SampleText(): string;
begin
  return
    "/// The outline sample.\n" +
    "module exe lsp_outline_main;\n" +
    "\n" +
    "import System.SysUtils;\n" +
    "\n" +
    "const\n" +
    "  ADAM_ROW_LIMIT: int32 = 3;\n" +
    "\n" +
    "type\n" +
    "  Color = choices(Red, Green);\n" +
    "  Tagged = record\n" +
    "    Tag: int8;\n" +
    "    overlay\n" +
    "      L: int64;\n" +
    "      S: int16;\n" +
    "    end;\n" +
    "  end;\n" +
    "  IShape = interface\n" +
    "    method Area(): int32;\n" +
    "  end;\n" +
    "  Square = object implements IShape\n" +
    "    hidden FSide: int32;\n" +
    "\n" +
    "    init(const ASide: int32);\n" +
    "    begin\n" +
    "      self.FSide := ASide;\n" +
    "    end;\n" +
    "\n" +
    "    property Side: int32 read FSide;\n" +
    "\n" +
    "    virtual method Area(): int32;\n" +
    "    begin\n" +
    "      return self.FSide * self.FSide;\n" +
    "    end;\n" +
    "\n" +
    "    done;\n" +
    "    begin\n" +
    "    end;\n" +
    "  end;\n" +
    "\n" +
    "routine Twice(const AValue: int32): int32;\n" +
    "type\n" +
    "  Pair = record\n" +
    "    A: int32;\n" +
    "\n" +
    "    operator +(const AL: Pair; const AR: Pair): Pair;\n" +
    "    var\n" +
    "      LR: Pair;\n" +
    "    begin\n" +
    "      LR.A := AL.A + AR.A;\n" +
    "      return LR;\n" +
    "    end;\n" +
    "  end;\n" +
    "var\n" +
    "  LP: Pair;\n" +
    "begin\n" +
    "  LP.A := AValue;\n" +
    "  LP := LP + LP;\n" +
    "  return LP.A;\n" +
    "end;\n" +
    "\n" +
    "var\n" +
    "  GSquare: ref Square;\n" +
    "\n" +
    "initialize\n" +
    "begin\n" +
    "  GSquare := nil;\n" +
    "end;\n" +
    "\n" +
    "begin\n" +
    "  GSquare := ref Square(ADAM_ROW_LIMIT);\n" +
    "  println(\"{} {}\", Twice(GSquare.Area()), IntToStr(int64(Color.Green)));\n" +
    "end.\n" +
    "\n" +
    "test \"the square\"\n" +
    "begin\n" +
    "end;\n";
end;

// The last part of a URI's path
routine FileOf(const AUri: string): string;
var
  LParts: StringArray;
begin
  LParts := SplitString(AUri, "/");
  return LParts[len(LParts) - 1];
end;

// A Range object as start line:character-end line:character
routine RangeText(const ARange: Json): string;
begin
  return IntToStr(ARange.Get("start.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("start.character").AsInt64()) + "-" +
    IntToStr(ARange.Get("end.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("end.character").AsInt64());
end;

// A DocumentSymbol (selectionRange) with its children, or a SymbolInformation (location),
// as one line each at ADepth
routine PrintSymbol(const AItem: Json; const ADepth: int64);
var
  LIndent: string;
  LText: string;
  LChildren: array of Json;
  LI: int64;
begin
  LIndent := "";
  for LI := 1 to ADepth do
    LIndent := LIndent + "  ";
  end;
  LText := LIndent + IntToStr(AItem.Get("kind").AsInt64()) + " " + AItem.Get("name").AsString();
  if AItem.Has("location") then
    if AItem.Has("containerName") then
      LText := LText + " in " + AItem.Get("containerName").AsString();
    end;
    println("{} {} {}", LText, FileOf(AItem.Get("location.uri").AsString()),
      RangeText(AItem.Get("location.range")));
    return;
  end;
  if AItem.Has("detail") then
    LText := LText + " [" + AItem.Get("detail").AsString() + "]";
  end;
  println("{} {} name {}", LText, RangeText(AItem.Get("range")),
    RangeText(AItem.Get("selectionRange")));
  if AItem.Has("children") then
    LChildren := AItem.Get("children").Items();
    for LI := 0 to len(LChildren) - 1 do
      PrintSymbol(LChildren[LI], ADepth + 1);
    end;
  end;
end;

type
  // The client's side
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FTogether: BoolArray;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: Json): Json;
    var
      LMessage: Json;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId, sent with the one before when ATogether
    method Request(const AId: int64; const AMethod: string; const AParams: Json;
      const ATogether: bool);
    var
      LMessage: Json;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString(), ATogether);
    end;

    // A position request AMethod (AId) at ALine / ACharacter of AUri
    method At(const AId: int64; const AMethod: string; const AUri: string; const ALine: int64;
      const ACharacter: int64; const ATogether: bool);
    var
      LParams: Json;
    begin
      LParams.BeginObject("textDocument");
      LParams.Add("uri", AUri);
      LParams.EndObject();
      LParams.BeginObject("position");
      LParams.Add("line", ALine);
      LParams.Add("character", ACharacter);
      LParams.EndObject();
      self.Request(AId, AMethod, LParams, ATogether);
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: Json; const ATogether: bool);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString(), ATogether);
    end;

    // ABody framed
    method Raw(const ABody: string; const ATogether: bool);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FTogether, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FTogether[LCount] := ATogether;
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // The next message waits only when it was sent together with the one before
    override method HasPending(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FStarts) - 1 do
        if self.FStarts[LI] >= self.FAt then
          return self.FTogether[LI];
        end;
      end;
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: Json;
      LItems: array of Json;
      LI: int64;
      LMethod: string;
    begin
      LMessage := Json.FromString(ABody);
      if not LMessage.Has("method") then
        if LMessage.Has("error") then
          println("<- {} error {}: {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("error.code").AsInt64(), LMessage.Get("error.message").AsString());
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LMessage.Get("id").AsInt64());
          return;
        end;
        if LMessage.Has("result.capabilities") then
          println("<- {} result documentSymbol {} workspaceSymbol {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("result.capabilities.documentSymbolProvider").AsBoolean(),
            LMessage.Get("result.capabilities.workspaceSymbolProvider").AsBoolean());
          return;
        end;
        LItems := LMessage.Get("result").Items();
        println("<- {} {} symbols", LMessage.Get("id").AsInt64(), len(LItems));
        for LI := 0 to len(LItems) - 1 do
          PrintSymbol(LItems[LI], 1);
        end;
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "textDocument/publishDiagnostics" then
        println("-> diagnostics v{}", LMessage.Get("params.version").AsInt64(-1));
        LItems := LMessage.Get("params.diagnostics").Items();
        for LI := 0 to len(LItems) - 1 do
          println("   {}:{} {} {}", LItems[LI].Get("range.start.line").AsInt64(),
            LItems[LI].Get("range.start.character").AsInt64(),
            LItems[LI].Get("code").AsString(""), LItems[LI].Get("message").AsString(""));
        end;
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// textDocument/documentSymbol's params for AUri ("": none)
routine SymbolParams(const AUri: string): Json;
var
  LJson: Json;
begin
  if AUri <> "" then
    LJson.BeginObject("textDocument");
    LJson.Add("uri", AUri);
    LJson.EndObject();
  end;
  return LJson;
end;

// didOpen's params: AUri with AText at version 1
routine OpenParams(const AUri: string; const AText: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.Add("languageId", "adam");
  LJson.Add("version", 1);
  LJson.Add("text", AText);
  LJson.EndObject();
  return LJson;
end;

var
  GC: ref ScriptChannel;
  GNone: Json;
  GPaths: StringArray;
  GUri: string;
  GText: string;
  GCode: int32;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GUri := "file:///" + ReplaceStr(ResolvePath("$P:lsp_outline_main.adam"), "\\", "/");
  GText := SampleText();
  GC := ref ScriptChannel();
  GC.Request(1, "initialize", GNone, false);
  GC.Notify("textDocument/didOpen", OpenParams(GUri, GText), false);
  GC.Request(2, "textDocument/documentSymbol", SymbolParams(GUri), true);
  GC.Request(3, "textDocument/documentSymbol", SymbolParams("file:///nowhere/x.adam"), false);
  GC.Request(4, "textDocument/documentSymbol", GNone, false);
  GC.Request(90, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  GCode := RunLsp(ref ProtocolTransport(GC), GPaths);
  println("== exit {}", GCode);
end.
