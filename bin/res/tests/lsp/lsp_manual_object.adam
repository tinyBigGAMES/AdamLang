-------------------------------------------------------------------------------
  lsp_manual_object.adam - the editor on every object member kind
  (M11b L9)

  The outline, hover, Go to Definition, completion, inlay hints and Format
  Document know each member an object or interface declares: init, done,
  copy, properties (plain, indexed, default), operators, embeds, hidden
  members, const, static and virtual methods.

  How to check: open this file in the editor (no problems are shown).

  CHECK Ctrl+Shift+O lists (indented = a child; [kind] = the icon):
    Shape                      [interface]
      Area                     [method]       (): int32
      Title                    [property]     string
    Counter                    [class]
      FN                       [field]        int32
      N                        [property]     int32
    Box                        [class]
      FName, FSize, C          [field]
      init                     [constructor]  (const AName: string; const ASize: int32)
      copy                     [constructor]  (const ASource: Box)
      done                     [method]
      Area                     [method]       (): int32
      Title                    [property]     string
      Twice                    [method]       (): int32
      Unit                     [method]       (): int32   (static)
      Size                     [property]     int32
      operator =, operator <>  [operator]     (const A: Box; const B: Box): bool
    Square                     [class]
      init                     [constructor]
      Area                     [method]
    Show, GS, GQ, GT
  CHECK hover shows each declaration as written:
    the word init           init(const AName: string; const ASize: int32)
                            and its doc comment "Builds a named box"
    done                    done
    Area in Box             virtual method Area(): int32
    Area in Shape           method Area(): int32
    Twice (in the body)     const method Twice(): int32
    Unit (in the body)      static method Unit(): int32
    Title in Box            virtual property Title: string read FName
                            and "The box's title"
    FSize                   hidden FSize: int32
    C                       embed C: Counter
    N in GS.N := 5          property N: int32 read FN; write FN
  CHECK F12 (Go to Definition): GS.N goes to N in Counter, Box.Unit to
    Unit, parent.init(...) in Square to Box's init.
  CHECK type `GS.` in the body: FName, C, then FN and N (Counter's members,
    reached through the embed C, right after it), Area, Title, Twice, Size;
    FSize is not offered (hidden), nor Unit (static: written Box.Unit()). Inside a Box
    method `self.` also offers FSize. `Box.` offers Unit.
  CHECK inlay hints: AName: / ASize: before the arguments of GS, GT and
    own Square(...); AS: before GS in Show(GS).
  CHECK Format Document changes nothing (the Size property keeps its read
    body one in and default; on its own line).
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_object;

type
  /// Something with an area
  Shape = interface
    method Area(): int32;
    property Title: string read;
  end;
  Counter = object
    FN: int32;
    property N: int32 read FN; write FN;
  end;
  /// The base box
  Box = object implements Shape
    FName: string;
    hidden FSize: int32;
    embed C: Counter;
    /// Builds a named box
    init(const AName: string; const ASize: int32);
    begin
      self.FName := AName;
      self.FSize := ASize;
    end;
    copy(const ASource: Box);
    begin
      self.FName := ASource.FName;
      self.FSize := ASource.FSize;
    end;
    done;
    begin
      println("done {}", self.FName);
    end;
    virtual method Area(): int32;
    begin
      return self.FSize * self.FSize;
    end;
    /// The box's title
    virtual property Title: string read FName;
    const method Twice(): int32;
    begin
      return self.FSize * 2;
    end;
    static method Unit(): int32;
    begin
      return 1;
    end;
    property Size[const AScale: int32]: int32
      read
      begin
        return self.FSize * AScale;
      end;
      default;
    operator =(const A: Box; const B: Box): bool;
    begin
      return A.FSize = B.FSize;
    end;
    operator <>(const A: Box; const B: Box): bool;
    begin
      return A.FSize <> B.FSize;
    end;
  end;
  Square = object(Box)
    init(const AName: string; const ASize: int32);
    begin
      parent.init(AName, ASize);
    end;
    override method Area(): int32;
    begin
      return parent.Area() + 1;
    end;
  end;

routine Show(var AS: Shape);
begin
  println("{} {}", AS.Title, AS.Area());
end;

var
  GS: Box("box", 3);
  GQ: own Square;
  GT: Box("other", 3);

begin
  GQ := own Square("sq", 2);
  Show(GS);
  GS.N := 5;
  println("{} {} {} {} {}", GS.Twice(), GS[2], GQ.Area(), GS = GT, Box.Unit());
  if GQ is Square then
    println("square");
  end;
end.
