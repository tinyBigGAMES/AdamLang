-------------------------------------------------------------------------------
  lsp_hover_words.adam - hover on the words the language itself defines
  (HK1): Adam.LSP.Server (imported from the compiler's own src\) serves a
  scripted client; each hover is printed as its range and its Markdown.

  The heading and text come from the Lexer's one tables (IntrinsicRow's
  Signature and Doc, KeywordDoc, DirectiveRow's Doc, ContextWordDoc), the
  ones the docs reference reads. Hovers: intrinsics (len, FormatStr,
  println with its format-led arguments, the statement setlength), a
  keyword (func), a builtin type word (int32), a context word (defer), a
  build directive (@optimize) and a conditional one (@ifdef); a keyword
  inside a comment and inside a string is null (the Lexer's token decides);
  a context word used as a variable's name (name) is that variable; `end.`
  is the keyword end; a cursor just after a word (func) finds it.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | <- 1 result hover true definition true
  | -> diagnostics v1
  | <- 2 hover 17:9-17:12 markdown
  |    | ```adam
  |    | len(string, wstring or array)
  |    | ```
  |    |
  |    | The length of a string, a wstring or an array: `len("four")` is 4.
  |    |
  |    | *intrinsic*
  | <- 3 hover 22:11-22:20 markdown
  |    | ```adam
  |    | FormatStr(format string, its arguments)
  |    | ```
  |    |
  |    | The text `print` would write, as a string: `FormatStr("{} + {}", 1, 2)` is `1 + 2`.
  |    |
  |    | *intrinsic*
  | <- 4 hover 25:2-25:9 markdown
  |    | ```adam
  |    | println(..)
  |    | ```
  |    |
  |    | Writes formatted text to the console and ends the line: `println("{} items", LCount)`
  |    |
  |    | *intrinsic*
  | <- 5 hover 23:2-23:11 markdown
  |    | ```adam
  |    | setlength(dynamic array or string variable, int64)
  |    | ```
  |    |
  |    | Sets the length of a dynamic array or a string: `setlength(LItems, 10)`
  |    |
  |    | *intrinsic*
  | <- 6 hover 14:0-14:4 markdown
  |    | ```adam
  |    | func
  |    | ```
  |    |
  |    | Declares a routine: `func Add(const A: int32; const B: int32): int32;`. Also a routine type `func(..)` and a func literal `func(..) begin .. end` (a closure).
  |    |
  |    | *keyword*
  | <- 7 hover 10:19-10:24 markdown
  |    | ```adam
  |    | int32
  |    | ```
  |    |
  |    | A signed 32-bit integer, -2147483648 to 2147483647.
  |    |
  |    | *builtin type*
  | <- 8 hover 16:2-16:7 markdown
  |    | ```adam
  |    | defer
  |    | ```
  |    |
  |    | Runs a statement when its enclosing statement list ends, however it ends (return, leave, raise): `defer CloseFile(LF);`
  |    |
  |    | *context word*
  | <- 9 hover 2:0-2:9 markdown
  |    | ```adam
  |    | @optimize
  |    | ```
  |    |
  |    | The build's optimization level: `@optimize debug;` (or safe, fast, small). Only in the main module's prologue; `adam -opt` wins over it.
  |    |
  |    | *directive*
  | <- 10 hover 3:0-3:6 markdown
  |    | ```adam
  |    | @ifdef
  |    | ```
  |    |
  |    | Compiles what follows only when the name is defined: `@ifdef DEBUG .. @endif`
  |    |
  |    | *directive*
  | <- 11 null
  | <- 12 null
  | <- 13 hover 24:2-24:6 markdown
  |    | ```adam
  |    | var name: int32
  |    | ```
  | <- 14 hover 26:0-26:3 markdown
  |    | ```adam
  |    | end
  |    | ```
  |    |
  |    | Closes a block, a type (`record .. end`) or a statement (`if .. end;`); the main block ends with `end.`
  |    |
  |    | *keyword*
  | <- 15 hover 14:0-14:4 markdown
  |    | ```adam
  |    | func
  |    | ```
  |    |
  |    | Declares a routine: `func Add(const A: int32; const B: int32): int32;`. Also a routine type `func(..)` and a func literal `func(..) begin .. end` (a closure).
  |    |
  |    | *keyword*
  | <- 16 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_hover_words;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Protocol.Transport, Adam.LSP.Server;

// The sample: every kind of word the language defines, and the places that are none
func SampleText(): string;
begin
  return
    "module exe lsp_words_main;\n" +
    "\n" +
    "@optimize debug;\n" +
    "@ifdef DEBUG\n" +
    "@define FAST\n" +
    "@endif\n" +
    "\n" +
    "import System.SysUtils;\n" +
    "\n" +
    "var\n" +
    "  GItems: array of int32;\n" +
    "  GName: string;\n" +
    "  name: int32;\n" +
    "\n" +
    "func Count(): int64;\n" +
    "begin\n" +
    "  defer println(\"done\");\n" +
    "  return len(GItems);\n" +
    "end;\n" +
    "\n" +
    "begin\n" +
    "  // if in a comment\n" +
    "  GName := FormatStr(\"{} if\", 1);\n" +
    "  setlength(GItems, 2);\n" +
    "  name := 3;\n" +
    "  println(\"{} {}\", GName, Count());\n" +
    "end.\n";
end;

// The 0-based character of the ANth (1-based) AWord on the 0-based line ALine of AText
// (ASCII: bytes and UTF-16 units alike)
func At(const AText: string; const ALine: int64; const AWord: string; const ANth: int64): int64;
var
  LLines: StringArray;
  LAt: int64;
  LI: int64;
begin
  LLines := SplitString(AText, "\n");
  LAt := -1;
  for LI := 1 to ANth do
    LAt := IndexOf(AWord, LLines[ALine], LAt + 1);
  end;
  return LAt;
end;

// The last part of a URI's path
func FileOf(const AURI: string): string;
var
  LParts: StringArray;
begin
  LParts := SplitString(AURI, "/");
  return LParts[len(LParts) - 1];
end;

// A Range object as start line:character-end line:character
func RangeText(const ARange: JSON): string;
begin
  return IntToStr(ARange.Get("start.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("start.character").AsInt64()) + "-" +
    IntToStr(ARange.Get("end.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("end.character").AsInt64());
end;

type
  // The client's side
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FTogether: BoolArray;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: JSON): JSON;
    var
      LMessage: JSON;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId, sent with the one before when ATogether
    method Request(const AId: int64; const AMethod: string; const AParams: JSON;
      const ATogether: bool);
    var
      LMessage: JSON;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString(), ATogether);
    end;

    // A position request AMethod (AId) at ALine / ACharacter of AURI
    method At(const AId: int64; const AMethod: string; const AURI: string; const ALine: int64;
      const ACharacter: int64; const ATogether: bool);
    var
      LParams: JSON;
    begin
      LParams.BeginObject("textDocument");
      LParams.Add("uri", AURI);
      LParams.EndObject();
      LParams.BeginObject("position");
      LParams.Add("line", ALine);
      LParams.Add("character", ACharacter);
      LParams.EndObject();
      self.Request(AId, AMethod, LParams, ATogether);
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: JSON; const ATogether: bool);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString(), ATogether);
    end;

    // ABody framed
    method Raw(const ABody: string; const ATogether: bool);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FTogether, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FTogether[LCount] := ATogether;
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // The next message waits only when it was sent together with the one before
    override method HasPending(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FStarts) - 1 do
        if self.FStarts[LI] >= self.FAt then
          return self.FTogether[LI];
        end;
      end;
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: JSON;
      LItems: array of JSON;
      LLines: StringArray;
      LI: int64;
      LMethod: string;
    begin
      LMessage := JSON.FromString(ABody);
      if not LMessage.Has("method") then
        if LMessage.Has("error") then
          println("<- {} error {}: {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("error.code").AsInt64(), LMessage.Get("error.message").AsString());
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LMessage.Get("id").AsInt64());
          return;
        end;
        if LMessage.Has("result.capabilities") then
          println("<- {} result hover {} definition {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("result.capabilities.hoverProvider").AsBoolean(),
            LMessage.Get("result.capabilities.definitionProvider").AsBoolean());
          return;
        end;
        if LMessage.Has("result.contents") then
          println("<- {} hover {} {}", LMessage.Get("id").AsInt64(),
            RangeText(LMessage.Get("result.range")),
            LMessage.Get("result.contents.kind").AsString());
          LLines := SplitString(LMessage.Get("result.contents.value").AsString(), "\n");
          for LI := 0 to len(LLines) - 1 do
            if LLines[LI] = "" then
              println("   |");
            else
              println("   | {}", LLines[LI]);
            end;
          end;
          return;
        end;
        println("<- {} {} {}", LMessage.Get("id").AsInt64(),
          FileOf(LMessage.Get("result.uri").AsString()), RangeText(LMessage.Get("result.range")));
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "textDocument/publishDiagnostics" then
        println("-> diagnostics v{}", LMessage.Get("params.version").AsInt64(-1));
        LItems := LMessage.Get("params.diagnostics").Items();
        for LI := 0 to len(LItems) - 1 do
          println("   {}:{} {} {}", LItems[LI].Get("range.start.line").AsInt64(),
            LItems[LI].Get("range.start.character").AsInt64(),
            LItems[LI].Get("code").AsString(""), LItems[LI].Get("message").AsString(""));
        end;
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// didOpen's params: AURI with AText at version 1
func OpenParams(const AURI: string; const AText: string): JSON;
var
  LJSON: JSON;
begin
  LJSON.BeginObject("textDocument");
  LJSON.Add("uri", AURI);
  LJSON.Add("languageId", "adam");
  LJSON.Add("version", 1);
  LJSON.Add("text", AText);
  LJSON.EndObject();
  return LJSON;
end;

var
  GC: ref ScriptChannel;
  GNone: JSON;
  GPaths: StringArray;
  GURI: string;
  GText: string;
  GCode: int32;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GURI := "file:///" + ReplaceStr(ResolvePath("$P:lsp_words_main.adam"), "\\", "/");
  GText := SampleText();
  GC := ref ScriptChannel();
  GC.Request(1, "initialize", GNone, false);
  GC.Notify("textDocument/didOpen", OpenParams(GURI, GText), false);
  GC.At(2, "textDocument/hover", GURI, 17, At(GText, 17, "len", 1), true);
  GC.At(3, "textDocument/hover", GURI, 22, At(GText, 22, "FormatStr", 1), false);
  GC.At(4, "textDocument/hover", GURI, 25, At(GText, 25, "println", 1), false);
  GC.At(5, "textDocument/hover", GURI, 23, At(GText, 23, "setlength", 1), false);
  GC.At(6, "textDocument/hover", GURI, 14, At(GText, 14, "func", 1), false);
  GC.At(7, "textDocument/hover", GURI, 10, At(GText, 10, "int32", 1), false);
  GC.At(8, "textDocument/hover", GURI, 16, At(GText, 16, "defer", 1), false);
  GC.At(9, "textDocument/hover", GURI, 2, At(GText, 2, "@optimize", 1), false);
  GC.At(10, "textDocument/hover", GURI, 3, At(GText, 3, "@ifdef", 1), false);
  GC.At(11, "textDocument/hover", GURI, 21, At(GText, 21, "if", 1), false);
  GC.At(12, "textDocument/hover", GURI, 22, At(GText, 22, "if", 1), false);
  GC.At(13, "textDocument/hover", GURI, 24, At(GText, 24, "name", 1), false);
  GC.At(14, "textDocument/hover", GURI, 26, At(GText, 26, "end", 1), false);
  // Just after the word: the cursor at func's end
  GC.At(15, "textDocument/hover", GURI, 14, At(GText, 14, "func", 1) + 4, false);
  GC.Request(16, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  GCode := RunLSP(ref ProtocolTransport(GC), GPaths);
  println("== exit {}", GCode);
end.
