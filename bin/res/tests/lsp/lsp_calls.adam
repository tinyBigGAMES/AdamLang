-------------------------------------------------------------------------------
  lsp_calls.adam - Adam's language server's call hierarchy (M11b L6):
  Adam.Lsp.Server (imported from the compiler's own src\) serves a scripted
  client over a channel of the row's; each item is printed as its name,
  kind, detail, file, range, selection range and whether its data holds a
  key, each call with its ranges.

  prepare: a forward's name gives its full routine (Leaf), a use gives the
  routine it calls (Middle), a generic routine's use the template (Pick), a
  method's use the method (Counter.Bump); an intrinsic (println) and a
  keyword give null. incoming / outgoing: found by the item's data key
  (Middle's callers: Counter.Bump and the module), else by its selection
  range (Middle's calls: Leaf twice and Pick; Leaf's caller Middle; Pick's
  callers: Middle and the module, its instances' copies once; Bump's calls
  and caller). An item with no place and no data is an error -32602; a URI
  naming no file text finds nothing; prepare in a URI not open is null.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | <- 1 result callHierarchy true
  | -> diagnostics v1
  | <- 2 1 items
  |    item Leaf kind 12 [(const AValue: int32): int32] lsp_calls_main.adam 16:0-19:4 sel 16:8-16:12 key true
  | <- 3 1 items
  |    item Middle kind 12 [(const AValue: int32): int32] lsp_calls_main.adam 11:0-14:4 sel 11:8-11:14 key true
  | <- 4 1 items
  |    item Pick kind 12 [<T>(const AValue: T): T] lsp_calls_main.adam 6:0-9:4 sel 6:8-6:12 key true
  | <- 5 1 items
  |    item Bump kind 6 [(): int32] lsp_calls_main.adam 28:4-32:8 sel 28:11-28:15 key true
  | <- 6 null
  | <- 7 null
  | <- 8 2 items
  |    from Bump kind 6 [(): int32] lsp_calls_main.adam 28:4-32:8 sel 28:11-28:15 key true
  |      at 30:21-30:27
  |    from lsp_calls_main kind 2 [] lsp_calls_main.adam 0:0-43:0 sel 0:11-0:25 key true
  |      at 40:25-40:31
  | <- 9 2 items
  |    to Leaf kind 12 [(const AValue: int32): int32] lsp_calls_main.adam 16:0-19:4 sel 16:8-16:12 key true
  |      at 13:9-13:13
  |      at 13:24-13:28
  |    to Pick kind 12 [<T>(const AValue: T): T] lsp_calls_main.adam 6:0-9:4 sel 6:8-6:12 key true
  |      at 13:29-13:33
  | <- 10 1 items
  |    from Middle kind 12 [(const AValue: int32): int32] lsp_calls_main.adam 11:0-14:4 sel 11:8-11:14 key true
  |      at 13:9-13:13
  |      at 13:24-13:28
  | <- 11 2 items
  |    from Middle kind 12 [(const AValue: int32): int32] lsp_calls_main.adam 11:0-14:4 sel 11:8-11:14 key true
  |      at 13:29-13:33
  |    from lsp_calls_main kind 2 [] lsp_calls_main.adam 0:0-43:0 sel 0:11-0:25 key true
  |      at 41:25-41:29
  | <- 12 1 items
  |    to Middle kind 12 [(const AValue: int32): int32] lsp_calls_main.adam 11:0-14:4 sel 11:8-11:14 key true
  |      at 30:21-30:27
  | <- 13 1 items
  |    from lsp_calls_main kind 2 [] lsp_calls_main.adam 0:0-43:0 sel 0:11-0:25 key true
  |      at 40:46-40:50
  | <- 14 error -32602: Invalid parameters for "callHierarchy/incomingCalls"
  | <- 15 0 items
  | <- 16 null
  | <- 17 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_calls;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Protocol.Transport, Adam.Lsp.Server;

// The sample
routine SampleText(): string;
begin
  return
    "module exe lsp_calls_main;\n" +
    "\n" +
    "import System.SysUtils;\n" +
    "\n" +
    "forward routine Leaf(const AValue: int32): int32;\n" +
    "\n" +
    "routine Pick<T>(const AValue: T): T;\n" +
    "begin\n" +
    "  return AValue;\n" +
    "end;\n" +
    "\n" +
    "routine Middle(const AValue: int32): int32;\n" +
    "begin\n" +
    "  return Leaf(AValue) + Leaf(Pick<int32>(AValue));\n" +
    "end;\n" +
    "\n" +
    "routine Leaf(const AValue: int32): int32;\n" +
    "begin\n" +
    "  return AValue + 1;\n" +
    "end;\n" +
    "\n" +
    "type\n" +
    "  Counter = object\n" +
    "    FCount: int32;\n" +
    "    init();\n" +
    "    begin\n" +
    "      self.FCount := 0;\n" +
    "    end;\n" +
    "    method Bump(): int32;\n" +
    "    begin\n" +
    "      self.FCount := Middle(self.FCount);\n" +
    "      return self.FCount;\n" +
    "    end;\n" +
    "  end;\n" +
    "\n" +
    "var\n" +
    "  GCounter: ref Counter;\n" +
    "\n" +
    "begin\n" +
    "  GCounter := ref Counter();\n" +
    "  println(\"{}\", IntToStr(Middle(1) + GCounter.Bump()));\n" +
    "  println(\"{}\", IntToStr(Pick(2)));\n" +
    "end.\n";
end;

// The 0-based character of the ANth (1-based) AWord on the 0-based line ALine of AText
// (ASCII: bytes and UTF-16 units alike)
routine At(const AText: string; const ALine: int64; const AWord: string; const ANth: int64): int64;
var
  LLines: StringArray;
  LAt: int64;
  LI: int64;
begin
  LLines := SplitString(AText, "\n");
  LAt := -1;
  for LI := 1 to ANth do
    LAt := IndexOf(AWord, LLines[ALine], LAt + 1);
  end;
  return LAt;
end;

// The last part of a URI's path
routine FileOf(const AUri: string): string;
var
  LParts: StringArray;
begin
  LParts := SplitString(AUri, "/");
  return LParts[len(LParts) - 1];
end;

// A Range object as start line:character-end line:character
routine RangeText(const ARange: Json): string;
begin
  return IntToStr(ARange.Get("start.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("start.character").AsInt64()) + "-" +
    IntToStr(ARange.Get("end.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("end.character").AsInt64());
end;

type
  // The client's side
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FTogether: BoolArray;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: Json): Json;
    var
      LMessage: Json;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId, sent with the one before when ATogether
    method Request(const AId: int64; const AMethod: string; const AParams: Json;
      const ATogether: bool);
    var
      LMessage: Json;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString(), ATogether);
    end;

    // A position request AMethod (AId) at ALine / ACharacter of AUri
    method At(const AId: int64; const AMethod: string; const AUri: string; const ALine: int64;
      const ACharacter: int64; const ATogether: bool);
    var
      LParams: Json;
    begin
      LParams.BeginObject("textDocument");
      LParams.Add("uri", AUri);
      LParams.EndObject();
      LParams.BeginObject("position");
      LParams.Add("line", ALine);
      LParams.Add("character", ACharacter);
      LParams.EndObject();
      self.Request(AId, AMethod, LParams, ATogether);
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: Json; const ATogether: bool);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString(), ATogether);
    end;

    // ABody framed
    method Raw(const ABody: string; const ATogether: bool);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FTogether, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FTogether[LCount] := ATogether;
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // The next message waits only when it was sent together with the one before
    override method HasPending(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FStarts) - 1 do
        if self.FStarts[LI] >= self.FAt then
          return self.FTogether[LI];
        end;
      end;
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // A CallHierarchyItem, short (its data's key only as there or not: it holds a path)
    method ItemText(const AItem: Json): string;
    begin
      return AItem.Get("name").AsString() + " kind " + IntToStr(AItem.Get("kind").AsInt64()) +
        " [" + AItem.Get("detail").AsString("") + "] " + FileOf(AItem.Get("uri").AsString()) + " " +
        RangeText(AItem.Get("range")) + " sel " + RangeText(AItem.Get("selectionRange")) +
        " key " + BoolToStr(AItem.Has("data.key"));
    end;

    // A prepare item, or an incoming / outgoing call with its ranges
    method PrintItem(const AItem: Json);
    var
      LRanges: array of Json;
      LText: string;
      LI: int64;
    begin
      if AItem.Has("name") then
        println("   item {}", self.ItemText(AItem));
        return;
      end;
      if AItem.Has("from") then
        LText := "from " + self.ItemText(AItem.Get("from"));
      else
        LText := "to " + self.ItemText(AItem.Get("to"));
      end;
      println("   {}", LText);
      LRanges := AItem.Get("fromRanges").Items();
      for LI := 0 to len(LRanges) - 1 do
        println("     at {}", RangeText(LRanges[LI]));
      end;
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: Json;
      LItems: array of Json;
      LI: int64;
      LMethod: string;
    begin
      LMessage := Json.FromString(ABody);
      if not LMessage.Has("method") then
        if LMessage.Has("error") then
          println("<- {} error {}: {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("error.code").AsInt64(), LMessage.Get("error.message").AsString());
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LMessage.Get("id").AsInt64());
          return;
        end;
        if LMessage.Has("result.capabilities") then
          println("<- {} result callHierarchy {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("result.capabilities.callHierarchyProvider").AsBoolean());
          return;
        end;
        LItems := LMessage.Get("result").Items();
        println("<- {} {} items", LMessage.Get("id").AsInt64(), len(LItems));
        for LI := 0 to len(LItems) - 1 do
          self.PrintItem(LItems[LI]);
        end;
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "textDocument/publishDiagnostics" then
        println("-> diagnostics v{}", LMessage.Get("params.version").AsInt64(-1));
        LItems := LMessage.Get("params.diagnostics").Items();
        for LI := 0 to len(LItems) - 1 do
          println("   {}:{} {} {}", LItems[LI].Get("range.start.line").AsInt64(),
            LItems[LI].Get("range.start.character").AsInt64(),
            LItems[LI].Get("code").AsString(""), LItems[LI].Get("message").AsString(""));
        end;
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// didOpen's params: AUri with AText at version 1
routine OpenParams(const AUri: string; const AText: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.Add("languageId", "adam");
  LJson.Add("version", 1);
  LJson.Add("text", AText);
  LJson.EndObject();
  return LJson;
end;

// incoming / outgoing params: an item of AUri whose name starts at ALine / ACharacter, its
// data key AKey ("" none)
routine CallParams(const AUri: string; const ALine: int64; const ACharacter: int64;
  const AKey: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("item");
  LJson.Add("name", "x");
  LJson.Add("kind", 12);
  LJson.Add("uri", AUri);
  LJson.BeginObject("range");
  LJson.BeginObject("start");
  LJson.Add("line", ALine);
  LJson.Add("character", ACharacter);
  LJson.EndObject();
  LJson.BeginObject("end");
  LJson.Add("line", ALine);
  LJson.Add("character", ACharacter);
  LJson.EndObject();
  LJson.EndObject();
  LJson.BeginObject("selectionRange");
  LJson.BeginObject("start");
  LJson.Add("line", ALine);
  LJson.Add("character", ACharacter);
  LJson.EndObject();
  LJson.BeginObject("end");
  LJson.Add("line", ALine);
  LJson.Add("character", ACharacter);
  LJson.EndObject();
  LJson.EndObject();
  if AKey <> "" then
    LJson.BeginObject("data");
    LJson.Add("key", AKey);
    LJson.EndObject();
  end;
  LJson.EndObject();
  return LJson;
end;

// An item with no place and no data
routine NoItemParams(): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("item");
  LJson.Add("name", "x");
  LJson.EndObject();
  return LJson;
end;

var
  GC: ref ScriptChannel;
  GNone: Json;
  GPaths: StringArray;
  GUri: string;
  GText: string;
  GCode: int32;
  GKey: string;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GUri := "file:///" + ReplaceStr(ResolvePath("$P:lsp_calls_main.adam"), "\\", "/");
  GText := SampleText();
  GC := ref ScriptChannel();
  GC.Request(1, "initialize", GNone, false);
  GC.Notify("textDocument/didOpen", OpenParams(GUri, GText), false);
  GKey := ResolvePath("$P:lsp_calls_main.adam") + "|12:9";
  GC.At(2, "textDocument/prepareCallHierarchy", GUri, 4, At(GText, 4, "Leaf", 1), true);
  GC.At(3, "textDocument/prepareCallHierarchy", GUri, 40, At(GText, 40, "Middle", 1), false);
  GC.At(4, "textDocument/prepareCallHierarchy", GUri, 41, At(GText, 41, "Pick", 1), false);
  GC.At(5, "textDocument/prepareCallHierarchy", GUri, 40, At(GText, 40, "Bump", 1), false);
  GC.At(6, "textDocument/prepareCallHierarchy", GUri, 40, At(GText, 40, "println", 1), false);
  GC.At(7, "textDocument/prepareCallHierarchy", GUri, 39, At(GText, 39, "begin", 1), false);
  GC.Request(8, "callHierarchy/incomingCalls", CallParams(GUri, 0, 0, GKey), false);
  GC.Request(9, "callHierarchy/outgoingCalls", CallParams(GUri, 11, 8, ""), false);
  GC.Request(10, "callHierarchy/incomingCalls", CallParams(GUri, 16, 8, ""), false);
  GC.Request(11, "callHierarchy/incomingCalls", CallParams(GUri, 6, 8, ""), false);
  GC.Request(12, "callHierarchy/outgoingCalls", CallParams(GUri, 28, 11, ""), false);
  GC.Request(13, "callHierarchy/incomingCalls", CallParams(GUri, 28, 11, ""), false);
  GC.Request(14, "callHierarchy/incomingCalls", NoItemParams(), false);
  GC.Request(15, "callHierarchy/incomingCalls", CallParams("file:///nowhere/x.adam", 0, 0, ""), false);
  GC.At(16, "textDocument/prepareCallHierarchy", "file:///nowhere/x.adam", 0, 0, false);
  GC.Request(17, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  GCode := RunLsp(ref ProtocolTransport(GC), GPaths);
  println("== exit {}", GCode);
end.
