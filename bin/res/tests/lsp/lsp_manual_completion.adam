  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  lsp_manual_completion.adam - completion (Ctrl+Space, '.', '->') (M11b L9)

  Typing a name, or '.' / '->' after one, opens a list of what can be
  written there: the names the place can see first (locals and parameters
  before it, the module's own), then builtin types and intrinsics, the
  imported units and their public names, the runtime's, keywords and
  statement snippets. After '.' / '->': the members of what is on the left.

  How to check: put the cursor where a CHECK line says (on the code line
  below it), press Ctrl+Space, and compare the TOP of the list with the
  text after "->" (the editor filters by what is typed, case aside).
  Needs lsp_manual_unit.adam in the same folder.
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_completion;

import lsp_manual_unit;

type
  Base = object
    Z: int32;
    hidden H: int32;
  end;
  Point = object(Base)
    X: int32;
    Y: int32;
    method Move(const ADX: int32);
    begin
      // CHECK: right after the first "self." -> X, Y, Move, then Z and H
      //        (the parent's; H is hidden, reached here inside a method of
      //        Base's descendant)
      self.X := self.X + ADX;
    end;
  end;
  Col = choices(Red, Green, Blue);

var
  GPoint: Point;
  GPtr: ptr to Point;
  GCount: int32;
  GColor: Col;

routine Sum(const AFrom: int32; const ATo: int32): int32;
var
  LTotal: int32;
  LStep: int32;
  GCount: int32;
begin
  LStep := 1;
  GCount := 0;
  // CHECK: after the L of the first LTotal -> LTotal, LStep (the locals)
  LTotal := AFrom + ATo;
  // CHECK: after the G of GCount -> GCount ONCE (the local hides the
  //        global), GPoint, GPtr, GColor
  GCount := GCount + LStep;
  // CHECK: after the A of AFrom -> AFrom, ATo (the parameters)
  return LTotal + AFrom;
end;

routine Reset();
begin
  GCount := 0;
end;

begin
  // CHECK: right after "GPoint." -> X, Y, Move (inserted as Move(ADX)),
  //        then Z (from the parent object Base); not H (hidden: only
  //        inside the methods of Base and of its descendants)
  GPoint.X := 1;

  GPtr := addr of GPoint;
  // CHECK: right after "GPtr->" -> X, Y, Move, Z (the object pointed to)
  GPtr->Y := 2;
  // CHECK: right after "GPtr^." -> X, Y, Move, Z (the same object, Pascal
  //        form: ^ dereferences, . picks the member)
  GPtr^.Y := 3;

  // CHECK: right after "lsp_manual_unit." -> Twice (only what the unit
  //        makes public)
  GCount := lsp_manual_unit.Twice(GPoint.X);

  // CHECK: after the Tw of Twice -> Twice (an imported unit's public name);
  //        choosing it writes Twice(AX)
  GCount := Twice(GCount);

  // CHECK: right after "Col." -> Red, Green, Blue
  GColor := Col.Green;

  // CHECK: after the Su of Sum -> Sum; choosing it writes Sum(AFrom, ATo)
  //        with the cursor on AFrom (Tab moves to ATo)
  GCount := Sum(1, 2);

  // CHECK: after the Re of Reset -> Reset; choosing it writes Reset() with
  //        no argument placeholders (it has no parameters)
  Reset();

  // CHECK: inside the string, after "G" -> no list (not code)
  // CHECK: after "// G" in this comment -> no list (not code)
  println("Gone");

  // CHECK: typing "wh" on a new line here -> while and the snippet
  //        "while ... end" (a statement form, its body a tab stop)
end.
