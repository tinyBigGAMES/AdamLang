-------------------------------------------------------------------------------
  lsp_manual_inlay_hints.adam - parameter-name hints at calls (M11b L9)

  At each call the editor shows the parameter's name in grey before each
  argument, e.g. Add(AA: 1, AB: 2): the names of the routine the check
  bound the call to. The hints are not text: they cannot be selected and
  are not saved.

  How to check: each CHECK line lists the hints the call below it shows,
  in order. "none" = that argument shows no hint.
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_inlay_hints;

type
  Fn = routine(const AP: int32; const AQ: int32): int32;
  Obj = object
    F: int32;
    method Put(const AV: int32);
    begin
    end;
  end;

forward routine Fw(const AA: int32): int32;

routine Add(const AA: int32; var AB: int32): int32;
begin
  return AA + AB;
end;

routine Ov(const AN: int32; const AK: int32);
begin
end;

routine Ov(const AN: string);
begin
end;

routine Dz(const AU: int32);
begin
end;

routine Dz(const AW: string);
begin
end;

routine V(const AN: int32; ...);
begin
end;

routine Fw(const AA: int32): int32;
begin
  return AA;
end;

routine CallValue(const AFn: Fn): int32;
begin
  // CHECK: AP: before 4, AQ: before 5 (a routine VALUE: its type's names)
  return AFn(4, 5);
end;

var
  AB: int32;
  LB: int32;
  LO: Obj;

begin
  // CHECK: AA: before 1 + 2 (at its start); none before AB: the argument
  //        is already spelled like its parameter
  AB := Add(1 + 2, AB);

  // CHECK: AA: before 8, AB: before LB (a var parameter is hinted too)
  AB := Add(8, LB);

  // CHECK: AN: before 1, AK: before 2 (an overload set: the check picked
  //        Ov(AN; AK), the one taking two arguments); AN: before "s"
  Ov(1, 2);
  Ov("s");

  // CHECK: AU: before 1 (Dz(AU: int32)); AW: before "t" (Dz(AW: string))
  Dz(1);
  Dz("t");

  // CHECK: AN: before 1, none before 2 and 3 (the variadic tail)
  V(1, 2, 3);

  // CHECK: AV: before 6 (a method)
  LO.Put(6);

  // CHECK: AA: before Add, and inside it AA: before 7, none before AB
  //        (nested calls; Fw is a forward: the names of its routine)
  AB := Fw(Add(7, AB));

  // CHECK: none in println's arguments (an intrinsic); AA: before 9,
  //        AB: before LB (after a non-ASCII text: Äc)
  println("Äc"); AB := Add(9, LB);
end.
