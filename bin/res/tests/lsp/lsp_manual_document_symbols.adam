-------------------------------------------------------------------------------
  lsp_manual_document_symbols.adam - outline, breadcrumbs, Ctrl+Shift+O
  (M11b L9)

  The editor lists this file's declarations as a tree: the outline view,
  the breadcrumbs above the text and Ctrl+Shift+O all show it. Clicking an
  entry selects its NAME.

  How to check: press Ctrl+Shift+O and compare the list with the tree
  below (indented = a child; [kind] = the icon; then the grey detail):

    lsp_manual_document_symbols    [module]
      lsp_manual_unit              [module]    (the import)
      Max                          [constant]  int32
      Rec                          [struct]
        A                          [field]     int32
        B                          [field]     int32   (from the overlay)
        C                          [field]     uint8   (from the overlay)
      Obj                          [class]
        F                          [field]     int32
        Put                        [method]    (const AV: int32)
      Col                          [enum]
        Red                        [enum member]
        Green                      [enum member]
      Alias                        [type parameter]
      Fw                           [function]  (const AA: int32): int32
      Outer                        [function]  (): int32
        Loc                        [type parameter]  (a local type; local
                                               vars are not listed)
      Fw                           [function]  (const AA: int32): int32
      GV                           [variable]  int32
      initialize                   [function]
      first                        [event]     (a test block)

  Needs lsp_manual_unit.adam in the same folder.
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_document_symbols;

import
  lsp_manual_unit;

const
  Max: int32 = 10;

type
  Rec = record
    A: int32;
    overlay
      B: int32;
      C: uint8;
    end;
  end;
  Obj = object
    F: int32;
    method Put(const AV: int32);
    begin
    end;
  end;
  Col = choices(Red, Green);
  Alias = int32;

forward routine Fw(const AA: int32): int32;

routine Outer(): int32;
type
  Loc = int32;
var
  LX: Loc;
begin
  LX := 0;
  return LX;
end;

routine Fw(const AA: int32): int32;
begin
  return AA;
end;

var
  GV: int32;

initialize
begin
end;

begin
  GV := Fw(Max) + lsp_manual_unit.Twice(1);
end.

test "first"
begin
end;
