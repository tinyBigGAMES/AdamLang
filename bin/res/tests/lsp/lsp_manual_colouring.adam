-------------------------------------------------------------------------------
  lsp_manual_colouring.adam - keyword, type and name colouring (M11b L9)

  The language server colours Adam's own words from the real lexer and
  every name by what the check resolved it to. The word lists come from the
  server too (nothing is baked into the editor).

  How to check:
    1. Open this file. Every word a CHECK line lists has the colour the
       CHECK names.
    2. Colours are case-sensitive: `Begin` and `INT32` are not words of the
       language and stay plain when typed as code.
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_colouring;

// CHECK keyword colour: module exe type record end var const routine begin
//       return if then else while do for to defer
// CHECK type colour: int8 int16 int32 int64 uint8 uint16 uint32 uint64
//       float32 float64 bool char wchar string wstring, and the type All
// CHECK: the field names A .. O in the field colour, Limit as a constant,
//        Count as a function, AN as a parameter, LI / LSum as variables
type
  All = record
    A: int8;
    B: int16;
    C: int32;
    D: int64;
    E: uint8;
    F: uint16;
    G: uint32;
    H: uint64;
    I: float32;
    J: float64;
    K: bool;
    L: char;
    M: wchar;
    N: string;
    O: wstring;
  end;

const
  Limit: int32 = 10;

// CHECK: the branch @ifdef leaves out (NEVER_DEFINED) is plain: no keyword,
//        type or name colour inside it
@ifdef NEVER_DEFINED
func Hidden(): int32;
begin
  return 1;
end;
@endif

func Count(const AN: int32): int32;
var
  LI: int32;
  LSum: int32;
begin
  LSum := 0;
  defer println("{}", LSum);
  for LI := 1 to AN do
    if LI < Limit then
      LSum := LSum + LI;
    else
      LSum := LSum - 1;
    end;
  end;
  while LSum > 100 do
    LSum := LSum - 100;
  end;
  return LSum;
end;

var
  GAll: All;

begin
  GAll.C := Count(5);
end.
