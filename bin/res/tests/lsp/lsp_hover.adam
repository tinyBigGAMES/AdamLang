-------------------------------------------------------------------------------
  lsp_hover.adam - Adam's language server's hover and the `///` doc comments
  (M11b L3, BNF sec 9): Adam.LSP.Server (imported from the compiler's own
  src\) serves a scripted client over a channel of the row's; each hover is
  printed as its range and its Markdown, line by line.

  The sample documents the module, a const, a type, a choice value (a
  trailing line: the last name before it), fields (a trailing line; a block
  winning over a trailing one), a routine with every tag
  (a run-on @param, an unknown @word as text, an indented @example) and a
  local; its diagnostics show the two doc comments that document nothing
  (PR0073 hints: a blank line after a block, a trailing one on a statement)
  and none for `////`. Hovers: a const, a routine (deprecated first, then
  the summary, Parameters, Returns, Raises, Since, See also, Example), a
  parameter (no doc of its own), a local, a member, a named type, a choice
  value, a field, the module, a std routine read from its compiled unit
  (System.Math's doc kept in the .acu), a unit name, and a keyword (its
  Lexer row, HK1; the words themselves: lsp_hover_words);
  the two from System.Math end with that file's name (M11b L9, pcpp's). A
  parameter shows its mode (`const`); a second file (L9d, L9e): a hidden
  field as written, an init's own word, its const parameter, a property
  through its accessors (`read FSize; write FSize`) and one read through
  its accessor's body (`read`).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | <- 1 result hover true definition true
  | -> diagnostics v1
  |    39:0 PR0073 doc comment documents nothing
  |    45:25 PR0073 doc comment documents nothing
  | <- 2 hover 54:19-54:33 markdown
  |    | ```adam
  |    | const ADAM_ROW_LIMIT: int32 = 3
  |    | ```
  |    |
  |    | How many rows.
  | <- 3 hover 54:14-54:18 markdown
  |    | ```adam
  |    | func Pick(const AValue: int32): int32
  |    | ```
  |    |
  |    | **Deprecated:** use Twice
  |    |
  |    | Picks a value.
  |    |
  |    | More text with **bold**.
  |    | @custom stays text
  |    |
  |    | **Parameters**
  |    | - `AValue`: the value given back
  |    |
  |    | **Returns:** AValue itself
  |    |
  |    | **Raises:** nothing
  |    |
  |    | **Since:** 0.3
  |    |
  |    | **See also:** `Twice`
  |    |
  |    | **Example**
  |    | ```adam
  |    | LX := Pick(1);
  |    |   LX := LX + 1;
  |    | ```
  | <- 4 hover 35:9-35:15 markdown
  |    | ```adam
  |    | const AValue: int32
  |    | ```
  | <- 5 hover 46:9-46:16 markdown
  |    | ```adam
  |    | var LDouble: int32
  |    | ```
  |    |
  |    | The local's doc.
  | <- 6 hover 54:9-54:10 markdown
  |    | ```adam
  |    | X: int32
  |    | ```
  |    |
  |    | The across part.
  | <- 7 hover 50:10-50:15 markdown
  |    | ```adam
  |    | type Point = record
  |    | ```
  | <- 8 hover 56:11-56:14 markdown
  |    | ```adam
  |    | Color.Red
  |    | ```
  | <- 9 hover 56:23-56:28 markdown
  |    | ```adam
  |    | Color.Green
  |    | ```
  |    |
  |    | Green's doc.
  | <- 10 hover 15:4-15:5 markdown
  |    | ```adam
  |    | Y: int32
  |    | ```
  |    |
  |    | The up part.
  | <- 11 hover 16:4-16:5 markdown
  |    | ```adam
  |    | W: int32
  |    | ```
  |    |
  |    | The depth part.
  | <- 12 hover 1:11-1:25 markdown
  |    | ```adam
  |    | module exe lsp_hover_main
  |    | ```
  |    |
  |    | The sample program.
  | <- 13 hover 55:13-55:28 markdown
  |    | ```adam
  |    | func cpplink PerceivedVolume(const ALevel: float64; const AMax: float64): float64
  |    | ```
  |    |
  |    | PerceivedVolume over the default 50 dB range.
  |    |
  |    | **Parameters**
  |    | - `ALevel`: the level, 0 (silent) to 1 (full)
  |    | - `AMax`: the volume at level 1
  |    |
  |    | **Returns:** the linear volume, 0 to AMax
  |    |
  |    | **Since:** 0.2
  |    |
  |    | **See also:** `PerceivedLevel`
  |    |
  |    | **Example**
  |    | ```adam
  |    | LMusic.setVolume(PerceivedVolume(LSlider, 100.0));
  |    | ```
  |    |
  |    | *System.Math.adam*
  | <- 14 hover 3:24-3:35 markdown
  |    | ```adam
  |    | module unit System.Math
  |    | ```
  |    |
  |    | *System.Math.adam*
  | <- 15 hover 56:2-56:4 markdown
  |    | ```adam
  |    | if
  |    | ```
  |    |
  |    | Runs its statements when the condition is true: `if X > 0 then .. else .. end;`
  |    |
  |    | *keyword*
  | -> diagnostics v1
  | <- 17 hover 4:11-4:16 markdown
  |    | ```adam
  |    | hidden FSize: int32
  |    | ```
  | <- 18 hover 6:4-6:8 markdown
  |    | ```adam
  |    | init(const ASize: int32)
  |    | ```
  | <- 19 hover 6:15-6:20 markdown
  |    | ```adam
  |    | const ASize: int32
  |    | ```
  | <- 20 hover 24:5-24:9 markdown
  |    | ```adam
  |    | property Size: int32 read FSize; write FSize
  |    | ```
  | <- 21 hover 24:16-24:21 markdown
  |    | ```adam
  |    | property Twice: int32 read
  |    | ```
  | <- 16 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_hover;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Protocol.Transport, Adam.LSP.Server;

// The sample
func SampleText(): string;
begin
  return
    "/// The sample program.\n" +
    "module exe lsp_hover_main;\n" +
    "\n" +
    "import System.SysUtils, System.Math;\n" +
    "\n" +
    "const\n" +
    "  /// How many rows.\n" +
    "  ADAM_ROW_LIMIT: int32 = 3;\n" +
    "\n" +
    "type\n" +
    "  /// A colour.\n" +
    "  Color = choices(Red, Green); /// Green's doc.\n" +
    "  Point = record\n" +
    "    X: int32; /// The across part.\n" +
    "    /// The up part.\n" +
    "    Y: int32; /// loses to the block\n" +
    "    W: int32; /// The depth part.\n" +
    "  end;\n" +
    "\n" +
    "/// Picks a value.\n" +
    "///\n" +
    "/// More text with **bold**.\n" +
    "/// @param AValue the value\n" +
    "///   given back\n" +
    "/// @returns AValue itself\n" +
    "/// @raises nothing\n" +
    "/// @see Twice\n" +
    "/// @deprecated use Twice\n" +
    "/// @since 0.3\n" +
    "/// @custom stays text\n" +
    "/// @example\n" +
    "///     LX := Pick(1);\n" +
    "///       LX := LX + 1;\n" +
    "func Pick(const AValue: int32): int32;\n" +
    "begin\n" +
    "  return AValue;\n" +
    "end;\n" +
    "\n" +
    "//// four slashes: a plain comment\n" +
    "/// documents nothing: a blank line follows\n" +
    "\n" +
    "func Twice(const AValue: int32): int32;\n" +
    "var\n" +
    "  LDouble: int32; /// The local's doc.\n" +
    "begin\n" +
    "  LDouble := AValue * 2; /// documents nothing\n" +
    "  return LDouble;\n" +
    "end;\n" +
    "\n" +
    "var\n" +
    "  GPoint: Point;\n" +
    "  GVolume: float64;\n" +
    "\n" +
    "begin\n" +
    "  GPoint.X := Pick(ADAM_ROW_LIMIT) + Twice(1);\n" +
    "  GVolume := PerceivedVolume(0.5, 100.0);\n" +
    "  if Color.Red = Color.Green then\n" +
    "    GPoint.W := 1;\n" +
    "  end;\n" +
    "  println(\"{}\", IntToStr(GPoint.X));\n" +
    "end.\n";
end;

// The objects' sample (L9d, L9e): a hidden field, an init and its const parameter, a
// property over a field and one read through its accessor
func ObjectsText(): string;
begin
  return
    "module exe lsp_hover_objects;\n" +
    "\n" +
    "type\n" +
    "  Box = object\n" +
    "    hidden FSize: int32;\n" +
    "\n" +
    "    init(const ASize: int32);\n" +
    "    begin\n" +
    "      self.FSize := ASize;\n" +
    "    end;\n" +
    "\n" +
    "    property Size: int32 read FSize; write FSize;\n" +
    "    property Twice: int32\n" +
    "      read\n" +
    "      begin\n" +
    "        return self.FSize * 2;\n" +
    "      end;\n" +
    "  end;\n" +
    "\n" +
    "var\n" +
    "  GB: ref Box;\n" +
    "\n" +
    "begin\n" +
    "  GB := ref Box(3);\n" +
    "  GB.Size := GB.Twice + GB.Size;\n" +
    "end.\n";
end;

// The 0-based character of the ANth (1-based) AWord on the 0-based line ALine of AText
// (ASCII: bytes and UTF-16 units alike)
func At(const AText: string; const ALine: int64; const AWord: string; const ANth: int64): int64;
var
  LLines: StringArray;
  LAt: int64;
  LI: int64;
begin
  LLines := SplitString(AText, "\n");
  LAt := -1;
  for LI := 1 to ANth do
    LAt := IndexOf(AWord, LLines[ALine], LAt + 1);
  end;
  return LAt;
end;

// The last part of a URI's path
func FileOf(const AURI: string): string;
var
  LParts: StringArray;
begin
  LParts := SplitString(AURI, "/");
  return LParts[len(LParts) - 1];
end;

// A Range object as start line:character-end line:character
func RangeText(const ARange: JSON): string;
begin
  return IntToStr(ARange.Get("start.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("start.character").AsInt64()) + "-" +
    IntToStr(ARange.Get("end.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("end.character").AsInt64());
end;

type
  // The client's side
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FTogether: BoolArray;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: JSON): JSON;
    var
      LMessage: JSON;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId, sent with the one before when ATogether
    method Request(const AId: int64; const AMethod: string; const AParams: JSON;
      const ATogether: bool);
    var
      LMessage: JSON;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString(), ATogether);
    end;

    // A position request AMethod (AId) at ALine / ACharacter of AURI
    method At(const AId: int64; const AMethod: string; const AURI: string; const ALine: int64;
      const ACharacter: int64; const ATogether: bool);
    var
      LParams: JSON;
    begin
      LParams.BeginObject("textDocument");
      LParams.Add("uri", AURI);
      LParams.EndObject();
      LParams.BeginObject("position");
      LParams.Add("line", ALine);
      LParams.Add("character", ACharacter);
      LParams.EndObject();
      self.Request(AId, AMethod, LParams, ATogether);
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: JSON; const ATogether: bool);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString(), ATogether);
    end;

    // ABody framed
    method Raw(const ABody: string; const ATogether: bool);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FTogether, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FTogether[LCount] := ATogether;
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // The next message waits only when it was sent together with the one before
    override method HasPending(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FStarts) - 1 do
        if self.FStarts[LI] >= self.FAt then
          return self.FTogether[LI];
        end;
      end;
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: JSON;
      LItems: array of JSON;
      LLines: StringArray;
      LI: int64;
      LMethod: string;
    begin
      LMessage := JSON.FromString(ABody);
      if not LMessage.Has("method") then
        if LMessage.Has("error") then
          println("<- {} error {}: {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("error.code").AsInt64(), LMessage.Get("error.message").AsString());
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LMessage.Get("id").AsInt64());
          return;
        end;
        if LMessage.Has("result.capabilities") then
          println("<- {} result hover {} definition {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("result.capabilities.hoverProvider").AsBoolean(),
            LMessage.Get("result.capabilities.definitionProvider").AsBoolean());
          return;
        end;
        if LMessage.Has("result.contents") then
          println("<- {} hover {} {}", LMessage.Get("id").AsInt64(),
            RangeText(LMessage.Get("result.range")),
            LMessage.Get("result.contents.kind").AsString());
          LLines := SplitString(LMessage.Get("result.contents.value").AsString(), "\n");
          for LI := 0 to len(LLines) - 1 do
            if LLines[LI] = "" then
              println("   |");
            else
              println("   | {}", LLines[LI]);
            end;
          end;
          return;
        end;
        println("<- {} {} {}", LMessage.Get("id").AsInt64(),
          FileOf(LMessage.Get("result.uri").AsString()), RangeText(LMessage.Get("result.range")));
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "textDocument/publishDiagnostics" then
        println("-> diagnostics v{}", LMessage.Get("params.version").AsInt64(-1));
        LItems := LMessage.Get("params.diagnostics").Items();
        for LI := 0 to len(LItems) - 1 do
          println("   {}:{} {} {}", LItems[LI].Get("range.start.line").AsInt64(),
            LItems[LI].Get("range.start.character").AsInt64(),
            LItems[LI].Get("code").AsString(""), LItems[LI].Get("message").AsString(""));
        end;
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// didOpen's params: AURI with AText at version 1
func OpenParams(const AURI: string; const AText: string): JSON;
var
  LJSON: JSON;
begin
  LJSON.BeginObject("textDocument");
  LJSON.Add("uri", AURI);
  LJSON.Add("languageId", "adam");
  LJSON.Add("version", 1);
  LJSON.Add("text", AText);
  LJSON.EndObject();
  return LJSON;
end;

var
  GC: ref ScriptChannel;
  GNone: JSON;
  GPaths: StringArray;
  GURI: string;
  GText: string;
  GObjectsURI: string;
  GObjects: string;
  GCode: int32;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GURI := "file:///" + ReplaceStr(ResolvePath("$P:lsp_hover_main.adam"), "\\", "/");
  GText := SampleText();
  GObjectsURI := "file:///" + ReplaceStr(ResolvePath("$P:lsp_hover_objects.adam"), "\\", "/");
  GObjects := ObjectsText();
  GC := ref ScriptChannel();
  GC.Request(1, "initialize", GNone, false);
  GC.Notify("textDocument/didOpen", OpenParams(GURI, GText), false);
  GC.At(2, "textDocument/hover", GURI, 54, At(GText, 54, "ADAM_ROW_LIMIT", 1), true);
  GC.At(3, "textDocument/hover", GURI, 54, At(GText, 54, "Pick", 1), false);
  GC.At(4, "textDocument/hover", GURI, 35, At(GText, 35, "AValue", 1), false);
  GC.At(5, "textDocument/hover", GURI, 46, At(GText, 46, "LDouble", 1), false);
  GC.At(6, "textDocument/hover", GURI, 54, At(GText, 54, "X", 1), false);
  GC.At(7, "textDocument/hover", GURI, 50, At(GText, 50, "Point", 2), false);
  GC.At(8, "textDocument/hover", GURI, 56, At(GText, 56, "Red", 1), false);
  GC.At(9, "textDocument/hover", GURI, 56, At(GText, 56, "Green", 1), false);
  GC.At(10, "textDocument/hover", GURI, 15, At(GText, 15, "Y", 1), false);
  GC.At(11, "textDocument/hover", GURI, 16, At(GText, 16, "W", 1), false);
  GC.At(12, "textDocument/hover", GURI, 1, At(GText, 1, "_main", 1), false);
  GC.At(13, "textDocument/hover", GURI, 55, At(GText, 55, "PerceivedVolume", 1), false);
  GC.At(14, "textDocument/hover", GURI, 3, At(GText, 3, "Math", 1), false);
  GC.At(15, "textDocument/hover", GURI, 56, At(GText, 56, "if", 1), false);
  GC.Notify("textDocument/didOpen", OpenParams(GObjectsURI, GObjects), false);
  GC.At(17, "textDocument/hover", GObjectsURI, 4, At(GObjects, 4, "FSize", 1), true);
  GC.At(18, "textDocument/hover", GObjectsURI, 6, At(GObjects, 6, "init", 1), false);
  GC.At(19, "textDocument/hover", GObjectsURI, 6, At(GObjects, 6, "ASize", 1), false);
  GC.At(20, "textDocument/hover", GObjectsURI, 24, At(GObjects, 24, "Size", 1), false);
  GC.At(21, "textDocument/hover", GObjectsURI, 24, At(GObjects, 24, "Twice", 1), false);
  GC.Request(16, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  GCode := RunLSP(ref ProtocolTransport(GC), GPaths);
  println("== exit {}", GCode);
end.
