  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  lsp_server.adam - Adam's language server (M11b L1): Adam.Lsp.Server
  (imported from the compiler's own src\) serves scripted clients over a
  channel of the row's (messages in order, each flagged when it is sent
  together with the one before, so the server finds it waiting; every
  message the server writes printed short: <- a response, -> a
  notification).

  Session lifecycle: a request before initialize refused, a notification
  before it dropped, initialize (utf-8 picked from the client's list), a
  second initialize refused, an unknown request (a string id echoed), a $/
  notification ignored, shutdown, a request after it refused, exit: 0.
  Session noshutdown: exit with no shutdown: 1 (utf-16 with no list).
  Session gone: the input ends: 1. Session bad: no JSON, a batch, a wrong
  jsonrpc, no method, an id that is no number or string, a response taken
  quietly, a bad header; then didOpen with no text, didChange of a URI not
  open, a change whose range is no position (the document is still
  checked: an untitled: URI names no file, so its diagnostics are empty),
  didClose with no URI. Session uri: Adam.Lsp.Uri's forms (a drive's slash,
  percent forms, a host, another scheme; a path's spaces, UTF-8 and UNC).
  Session diagnostics (utf-16) over two files the row writes beside itself,
  clean main on disk, a unit with an error and a warning: main opened with
  an error (the buffer, not the disk) after an emoji (its column in UTF-16
  units), the closed import's error alone; two changes sent together fix it
  in one check; the import opened fixed speaks for itself; main checked
  again leaves it alone; the import closed is cleared; main checked again
  finds its disk error; main closed clears both; shutdown, exit 0. Session
  utf8: the same error placed in UTF-8 bytes, a ranged change in bytes.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | == lifecycle
  | <- 1 error -32002: The server is not initialized
  | <- 2 result
  |    positionEncoding utf-8
  |    sync openClose true change 2
  |    server adam
  | <- 3 error -32600: The server is already initialized
  | <- "abc" error -32601: Unhandled method "foo/bar"
  | <- 4 null
  | <- 5 error -32600: The server is shut down
  | == exit 0
  | == noshutdown
  | <- 1 result
  |    positionEncoding utf-16
  |    sync openClose true change 2
  |    server adam
  | == exit 1
  | == gone
  | <- 1 result
  |    positionEncoding utf-16
  |    sync openClose true change 2
  |    server adam
  | == exit 1
  | == bad
  | <- null error -32700: Invalid JSON
  | <- null error -32600: Invalid JSON-RPC message
  | <- 7 error -32600: Invalid JSON-RPC message
  | <- 8 error -32600: Invalid JSON-RPC message
  | <- null error -32600: Invalid JSON-RPC message
  | -> log 1: A message with a malformed header was skipped
  | <- 1 result
  |    positionEncoding utf-16
  |    sync openClose true change 2
  |    server adam
  | -> log 1: Invalid parameters for "textDocument/didOpen"
  | -> log 1: Invalid parameters for "textDocument/didChange"
  | -> log 1: Invalid parameters for "textDocument/didChange"
  | -> diagnostics untitled:a v1
  | -> log 1: Invalid parameters for "textDocument/didClose"
  | == exit 1
  | == uri
  |    file:///C:/a%20b/c.adam -> C:/a b/c.adam
  |    file:///c%3A/Dev/x.adam -> c:/Dev/x.adam
  |    FILE:///d:/y.adam -> d:/y.adam
  |    file://host/share/x.adam -> //host/share/x.adam
  |    file:///home/u/%E2%82%AC.adam -> /home/u/€.adam
  |    file:///a%zz%4 -> /a%zz%4
  |    untitled:Untitled-1 -> no file
  |    file:///C:/a%20b/%C3%BC.adam
  |    file://host/share/x.adam
  |    file:///home/u/50%25%231.adam
  |    A/%
  | == diagnostics
  | <- 1 result
  |    positionEncoding utf-16
  |    sync openClose true change 2
  |    server adam
  | -> diagnostics lsp_diag_main.adam v1
  |    8:17-8:25 error adam SM0021: 'GMissing' is not declared
  | -> diagnostics LspDiagUnit.adam
  |    5:2-5:8 error adam SM0255: 'AValue' cannot be assigned
  | -> diagnostics lsp_diag_main.adam v3
  | -> diagnostics LspDiagUnit.adam
  |    5:2-5:8 error adam SM0255: 'AValue' cannot be assigned
  | -> diagnostics LspDiagUnit.adam v1
  | -> diagnostics lsp_diag_main.adam v4
  | -> diagnostics LspDiagUnit.adam
  | -> diagnostics lsp_diag_main.adam v5
  | -> diagnostics LspDiagUnit.adam
  |    5:2-5:8 error adam SM0255: 'AValue' cannot be assigned
  | -> diagnostics lsp_diag_main.adam
  | -> diagnostics LspDiagUnit.adam
  | <- 2 null
  | == exit 0
  | == utf8
  | <- 1 result
  |    positionEncoding utf-8
  |    sync openClose true change 2
  |    server adam
  | -> diagnostics lsp_diag_main.adam v1
  |    8:19-8:27 error adam SM0021: 'GMissing' is not declared
  | -> diagnostics LspDiagUnit.adam
  |    5:2-5:8 error adam SM0255: 'AValue' cannot be assigned
  | -> diagnostics lsp_diag_main.adam v2
  | -> diagnostics LspDiagUnit.adam
  |    5:2-5:8 error adam SM0255: 'AValue' cannot be assigned
  | <- 2 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_server;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.JSON, Adam.Protocol.Transport, Adam.Lsp.Uri,
  Adam.Lsp.Server;

const
  ADAM_ROW_MAIN: string = "lsp_diag_main.adam";
  ADAM_ROW_UNIT: string = "LspDiagUnit.adam";
  ADAM_ROW_EMOJI: string = "\xF0\x9F\x98\x80";

// The main module's text: AError puts its undeclared name on line 9, after an emoji
routine MainText(const AError: bool): string;
var
  LLine: string;
begin
  LLine := "  GText := \"" + ADAM_ROW_EMOJI + "\";";
  if AError then
    LLine := LLine + " GMissing := 1;";
  end;
  return "module exe lsp_diag_main;\n" +
    "\n" +
    "import LspDiagUnit;\n" +
    "\n" +
    "var\n" +
    "  GText: string;\n" +
    "\n" +
    "begin\n" +
    LLine + "\n" +
    "  println(\"{} {}\", GText, Twice(2));\n" +
    "end.\n";
end;

// The unit's text: AFaulty adds a line that writes a const parameter (an error) after a return
// (a warning: unreachable)
routine UnitText(const AFaulty: bool): string;
var
  LBody: string;
begin
  LBody := "  return AValue * 2;\n";
  if AFaulty then
    LBody := LBody + "  AValue := 0;\n";
  end;
  return "module unit LspDiagUnit;\n" +
    "\n" +
    "public routine Twice(const AValue: int32): int32;\n" +
    "begin\n" +
    LBody +
    "end;\n" +
    "\n" +
    "end.\n";
end;

// The index of the last '/' in AText; -1 when it has none
routine LastSlash(const AText: string): int64;
var
  LI: int64;
begin
  LI := len(AText) - 1;
  while (LI >= 0) and (AText[LI] <> '/') do
    LI := LI - 1;
  end;
  return LI;
end;

// The severity's name
routine SeverityText(const ASeverity: int64): string;
begin
  if ASeverity = 1 then
    return "error";
  end;
  if ASeverity = 2 then
    return "warning";
  end;
  if ASeverity = 3 then
    return "information";
  end;
  return "hint";
end;

// A position as line:character
routine PositionText(const APosition: Json): string;
begin
  return IntToStr(APosition.Get("line").AsInt64()) + ":" +
    IntToStr(APosition.Get("character").AsInt64());
end;

type
  // The client's side (see the header)
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FTogether: BoolArray;
    // The sample folder: a URI there is printed by its name, a message's path as <dir>
    FDir: string;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: Json): Json;
    var
      LMessage: Json;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId, sent with the one before when ATogether
    method Request(const AId: int64; const AMethod: string; const AParams: Json;
      const ATogether: bool);
    var
      LMessage: Json;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString(), ATogether);
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: Json; const ATogether: bool);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString(), ATogether);
    end;

    // ABody framed as it is
    method Raw(const ABody: string; const ATogether: bool);
    begin
      self.RawFramed("Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody, ATogether);
    end;

    // AText sent as it is (its own header)
    method RawFramed(const AText: string; const ATogether: bool);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FTogether, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FTogether[LCount] := ATogether;
      self.FInput := self.FInput + AText;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // The next message waits only when it was sent together with the one before (a client
    // waits for the server otherwise)
    override method HasPending(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FStarts) - 1 do
        if self.FStarts[LI] >= self.FAt then
          return self.FTogether[LI];
        end;
      end;
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // AText with the sample folder as <dir>
    method Shown(const AText: string): string;
    begin
      if self.FDir = "" then
        return AText;
      end;
      return ReplaceStr(ReplaceStr(AText, "\\", "/"), self.FDir, "<dir>");
    end;

    // A URI as the row shows it: its last part, and a word when it is not in the sample folder
    method UriText(const AUri: string): string;
    var
      LPath: string;
      LName: string;
    begin
      LName := Substring(AUri, LastSlash(AUri) + 1, len(AUri) - LastSlash(AUri) - 1);
      if StartsStr("untitled:", AUri) then
        return AUri;
      end;
      if not UriToPath(AUri, LPath) then
        return LName + " (no file URI)";
      end;
      if not SamePath(ExtractFileDir(ResolvePath(LPath)), self.FDir) then
        return LName + " (outside the sample folder)";
      end;
      return LName;
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: Json;
      LId: string;
      LItems: array of Json;
      LI: int64;
      LMethod: string;
    begin
      LMessage := Json.FromString(ABody);
      if not LMessage.Has("method") then
        LId := "null";
        if LMessage.Get("id").IsString() then
          LId := "\"" + LMessage.Get("id").AsString() + "\"";
        end;
        if LMessage.Get("id").IsNumber() then
          LId := IntToStr(LMessage.Get("id").AsInt64());
        end;
        if LMessage.Has("error") then
          println("<- {} error {}: {}", LId, LMessage.Get("error.code").AsInt64(),
            LMessage.Get("error.message").AsString());
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LId);
          return;
        end;
        println("<- {} result", LId);
        if LMessage.Has("result.capabilities") then
          println("   positionEncoding {}",
            LMessage.Get("result.capabilities.positionEncoding").AsString());
          println("   sync openClose {} change {}",
            LMessage.Get("result.capabilities.textDocumentSync.openClose").AsBoolean(),
            LMessage.Get("result.capabilities.textDocumentSync.change").AsInt64());
          println("   server {}", LMessage.Get("result.serverInfo.name").AsString());
        end;
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "window/logMessage" then
        println("-> log {}: {}", LMessage.Get("params.type").AsInt64(),
          LMessage.Get("params.message").AsString());
        return;
      end;
      if LMethod = "textDocument/publishDiagnostics" then
        if LMessage.Has("params.version") then
          println("-> diagnostics {} v{}", self.UriText(LMessage.Get("params.uri").AsString()),
            LMessage.Get("params.version").AsInt64());
        else
          println("-> diagnostics {}", self.UriText(LMessage.Get("params.uri").AsString()));
        end;
        LItems := LMessage.Get("params.diagnostics").Items();
        for LI := 0 to len(LItems) - 1 do
          println("   {}-{} {} {} {}: {}", PositionText(LItems[LI].Get("range.start")),
            PositionText(LItems[LI].Get("range.end")),
            SeverityText(LItems[LI].Get("severity").AsInt64()),
            LItems[LI].Get("source").AsString(), LItems[LI].Get("code").AsString(""),
            self.Shown(LItems[LI].Get("message").AsString()));
        end;
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// A session over AChannel: its exit code printed
routine DoServe(const ATitle: string; const AChannel: ref ScriptChannel; const APaths: StringArray);
var
  LCode: int32;
begin
  println("== {}", ATitle);
  LCode := RunLsp(ref ProtocolTransport(AChannel), APaths);
  println("== exit {}", LCode);
end;

// initialize's params with the client's encodings AEncodings ("" for no list)
routine InitParams(const AEncodings: string): Json;
var
  LJson: Json;
begin
  if AEncodings = "" then
    LJson.Add("processId", 0);
    return LJson;
  end;
  LJson := Json.FromString("{\"capabilities\": {\"general\": {\"positionEncodings\": " +
    AEncodings + "}}}");
  return LJson;
end;

// didOpen's params: AUri with AText at version 1
routine OpenParams(const AUri: string; const AText: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.Add("languageId", "adam");
  LJson.Add("version", 1);
  LJson.Add("text", AText);
  LJson.EndObject();
  return LJson;
end;

// A params object holding the text document AUri alone
routine UriParams(const AUri: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.EndObject();
  return LJson;
end;

// didChange's params: AUri at AVersion, the text from ALine:AFrom to ALine:ATo now AText
routine ChangeParams(const AUri: string; const AVersion: int64; const ALine: int64;
  const AFrom: int64; const ATo: int64; const AText: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.Add("version", AVersion);
  LJson.EndObject();
  LJson.BeginArray("contentChanges");
  LJson.Add(Json.FromString("{\"range\": {\"start\": {\"line\": " + IntToStr(ALine) +
    ", \"character\": " + IntToStr(AFrom) + "}, \"end\": {\"line\": " + IntToStr(ALine) +
    ", \"character\": " + IntToStr(ATo) + "}}, \"text\": \"" + AText + "\"}"));
  LJson.EndArray();
  return LJson;
end;

// didChange's params: AUri at AVersion, its whole text AText
routine ReplaceParams(const AUri: string; const AVersion: int64; const AText: string): Json;
var
  LJson: Json;
  LChange: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.Add("version", AVersion);
  LJson.EndObject();
  LChange.Add("text", AText);
  LJson.BeginArray("contentChanges");
  LJson.Add(LChange);
  LJson.EndArray();
  return LJson;
end;

// The file URI a client like VS Code sends for APath: a drive letter lower-case, its colon as %3A
routine ClientUri(const APath: string): string;
var
  LPath: string;
begin
  LPath := ReplaceStr(APath, "\\", "/");
  if (len(LPath) >= 2) and (LPath[1] = ':') then
    return "file:///" + LowerCase(Substring(LPath, 0, 1)) + "%3A" +
      Substring(LPath, 2, len(LPath) - 2);
  end;
  return "file://" + LPath;
end;

// UriToPath of AUri printed
routine ShowUriToPath(const AUri: string);
var
  LPath: string;
begin
  if UriToPath(AUri, LPath) then
    println("   {} -> {}", AUri, LPath);
  else
    println("   {} -> no file", AUri);
  end;
end;

var
  GC: ref ScriptChannel;
  GNone: Json;
  GNoPaths: StringArray;
  GPaths: StringArray;
  GDir: string;
  GMainUri: string;
  GUnitUri: string;

begin
  setlength(GNoPaths, 0);
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GDir := ExtractFileDir(ResolvePath("$P:" + ADAM_ROW_MAIN));

  // Session lifecycle
  GC := ref ScriptChannel();
  GC.Request(1, "textDocument/hover", GNone, false);
  GC.Notify("textDocument/didOpen", OpenParams("untitled:early", "x"), false);
  GC.Request(2, "initialize", InitParams("[\"utf-32x\", 7, \"utf-8\", \"utf-16\"]"), false);
  GC.Notify("initialized", GNone, false);
  GC.Request(3, "initialize", InitParams(""), false);
  GC.Raw("{\"jsonrpc\": \"2.0\", \"id\": \"abc\", \"method\": \"foo/bar\"}", false);
  GC.Notify("$/cancelRequest", GNone, false);
  GC.Request(4, "shutdown", GNone, false);
  GC.Request(5, "initialize", InitParams(""), false);
  GC.Notify("textDocument/didOpen", OpenParams("untitled:late", "x"), false);
  GC.Notify("exit", GNone, false);
  DoServe("lifecycle", GC, GNoPaths);

  // Session noshutdown
  GC := ref ScriptChannel();
  GC.Request(1, "initialize", InitParams(""), false);
  GC.Notify("exit", GNone, false);
  DoServe("noshutdown", GC, GNoPaths);

  // Session gone
  GC := ref ScriptChannel();
  GC.Request(1, "initialize", InitParams(""), false);
  DoServe("gone", GC, GNoPaths);

  // Session bad
  GC := ref ScriptChannel();
  GC.Raw("{not json", false);
  GC.Raw("[1, 2]", false);
  GC.Raw("{\"jsonrpc\": \"1.0\", \"id\": 7, \"method\": \"initialize\"}", false);
  GC.Raw("{\"jsonrpc\": \"2.0\", \"id\": 8}", false);
  GC.Raw("{\"jsonrpc\": \"2.0\", \"id\": true, \"method\": \"initialize\"}", false);
  GC.Raw("{\"jsonrpc\": \"2.0\", \"id\": 9, \"result\": null}", false);
  GC.RawFramed("Content-Size: 2\r\n\r\n", false);
  GC.Request(1, "initialize", InitParams(""), false);
  GC.Notify("textDocument/didOpen", UriParams("untitled:a"), false);
  GC.Notify("textDocument/didChange", ReplaceParams("untitled:nope", 2, "y"), false);
  GC.Notify("textDocument/didOpen", OpenParams("untitled:a", "x"), false);
  GC.Raw("{\"jsonrpc\": \"2.0\", \"method\": \"textDocument/didChange\", \"params\": " +
    "{\"textDocument\": {\"uri\": \"untitled:a\", \"version\": 2}, \"contentChanges\": " +
    "[{\"range\": {\"start\": {\"line\": 0}}, \"text\": \"y\"}]}}", true);
  GC.Notify("textDocument/didClose", GNone, false);
  GC.Notify("exit", GNone, false);
  DoServe("bad", GC, GNoPaths);

  // Session uri
  println("== uri");
  ShowUriToPath("file:///C:/a%20b/c.adam");
  ShowUriToPath("file:///c%3A/Dev/x.adam");
  ShowUriToPath("FILE:///d:/y.adam");
  ShowUriToPath("file://host/share/x.adam");
  ShowUriToPath("file:///home/u/%E2%82%AC.adam");
  ShowUriToPath("file:///a%zz%4");
  ShowUriToPath("untitled:Untitled-1");
  println("   {}", PathToUri("C:\\a b\\\xC3\xBC.adam"));
  println("   {}", PathToUri("\\\\host\\share\\x.adam"));
  println("   {}", PathToUri("/home/u/50%#1.adam"));
  println("   {}", PercentDecode("%41%2f%"));

  // Session diagnostics: the samples on disk, main clean, the unit faulty
  if not (WriteAllText(GDir + "/" + ADAM_ROW_MAIN, MainText(false)) and
    WriteAllText(GDir + "/" + ADAM_ROW_UNIT, UnitText(true))) then
    println("cannot write the samples in {}", GDir);
    Halt(1);
  end;
  GMainUri := ClientUri(GDir + "/" + ADAM_ROW_MAIN);
  GUnitUri := ClientUri(GDir + "/" + ADAM_ROW_UNIT);
  GC := ref ScriptChannel();
  GC.FDir := ReplaceStr(GDir, "\\", "/");
  GC.Request(1, "initialize", InitParams(""), false);
  GC.Notify("initialized", GNone, false);
  // main with an error in its buffer only
  GC.Notify("textDocument/didOpen", OpenParams(GMainUri, MainText(true)), false);
  // two changes sent together: one check; the error's 14 bytes after the emoji's 2 units
  GC.Notify("textDocument/didChange", ChangeParams(GMainUri, 2, 8, 16, 31, ""), false);
  GC.Notify("textDocument/didChange", ChangeParams(GMainUri, 3, 9, 0, 0, "  // fixed\\n"), true);
  // the import opened fixed: its own check
  GC.Notify("textDocument/didOpen", OpenParams(GUnitUri, UnitText(false)), false);
  // main again: the open import is left to itself
  GC.Notify("textDocument/didChange", ReplaceParams(GMainUri, 4, MainText(false)), false);
  // the import closed: cleared; main again: the disk's error
  GC.Notify("textDocument/didClose", UriParams(GUnitUri), false);
  GC.Notify("textDocument/didChange", ReplaceParams(GMainUri, 5, MainText(false)), false);
  // main closed: its own and the import's go
  GC.Notify("textDocument/didClose", UriParams(GMainUri), false);
  GC.Request(2, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  DoServe("diagnostics", GC, GPaths);

  // Session utf8: the same error in UTF-8 bytes; a ranged change counted in bytes
  GC := ref ScriptChannel();
  GC.FDir := ReplaceStr(GDir, "\\", "/");
  GC.Request(1, "initialize", InitParams("[\"utf-8\"]"), false);
  GC.Notify("textDocument/didOpen", OpenParams(GMainUri, MainText(true)), false);
  GC.Notify("textDocument/didChange", ChangeParams(GMainUri, 2, 8, 18, 33, ""), false);
  GC.Request(2, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  DoServe("utf8", GC, GPaths);
end.
