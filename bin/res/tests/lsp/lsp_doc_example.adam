-------------------------------------------------------------------------------
  lsp_doc_example.adam - LSP2: a doc comment's @example as hover shows it
  (Adam.LSP.Docs' DocMarkdown, BNF sec 9): one that opens with a code span
  (the std's `@example `code` (note)`) is that code fenced, its note as
  prose under the fence, inline code in the note kept; a bare @example's
  lines are the fence's code, their shared indent taken off; a span of two
  backticks holds one; an unclosed span, and a span with no note, as said.
  Each Markdown line printed between [ ]
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | case 1
  | [Picks.]
  | []
  | [**Example**]
  | [```adam]
  | [Pick(1)]
  | [```]
  | []
  | [(a note with `code`)]
  | case 2
  | [**Example**]
  | [```adam]
  | [LX := Pick(1);]
  | [  LX := LX + 1;]
  | [```]
  | case 3
  | [**Example**]
  | [```adam]
  | [A`B]
  | [```]
  | []
  | [is two]
  | case 4
  | [**Example**]
  | [```adam]
  | [`Pick(1) (open)]
  | [```]
  | case 5
  | [**Example**]
  | [```adam]
  | [Pick(1)]
  | [```]
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_doc_example;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.LSP.Docs;

// The Markdown of the doc text ADoc, case ACase, each line between [ ]
func Show(const ACase: int32; const ADoc: string);
var
  LLines: StringArray;
  LI: int64;
begin
  println("case {}", ACase);
  LLines := SplitString(DocMarkdown(ADoc), "\n");
  for LI := 0 to len(LLines) - 1 do
    println("[{}]", LLines[LI]);
  end;
end;

begin
  Show(1, "Picks.\n@example `Pick(1)` (a note with `code`)");
  Show(2, "@example\n    LX := Pick(1);\n      LX := LX + 1;");
  Show(3, "@example ``A`B`` is two");
  Show(4, "@example `Pick(1) (open)");
  Show(5, "@example `Pick(1)`");
end.
