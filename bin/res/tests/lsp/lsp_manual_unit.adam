-------------------------------------------------------------------------------
  lsp_manual_unit.adam - the unit the manual LSP files import (M11b L9)

  lsp_manual_hover, lsp_manual_definition, lsp_manual_doc_comments,
  lsp_manual_completion and lsp_manual_workspace_symbols import it to show
  what the editor does with a name from ANOTHER file: hover names this
  file, go to definition opens it.

  How to check: open it on its own: no squiggles (a unit is checked, not
  built).
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module unit lsp_manual_unit;

/// Doubles a value.
///
/// Declared in **lsp_manual_unit.adam**: hovering a use of it in another
/// file shows this text and the file name below it.
/// @param AX the value to double
/// @returns `AX` times two
public func Twice(const AX: int32): int32;
begin
  return AX * 2;
end;

end.
