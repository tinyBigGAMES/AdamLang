-------------------------------------------------------------------------------
  lsp_manual_definition.adam - go to definition (M11b L9)

  F12 (or Ctrl+click) on a name jumps to the name in its declaration.

  How to check: put the cursor on each name a CHECK line names (on the code
  line below it), press F12 and compare where the cursor lands with the
  text after "->".
  Needs lsp_manual_unit.adam in the same folder.
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_definition;

// CHECK: lsp_manual_unit (this import) -> opens lsp_manual_unit.adam at its
//        module name
import lsp_manual_unit;

type
  Colour = choices(Red, Green, Blue);

forward func Twin(const AA: int32): int32;

func Pick(const AN: int32);
begin
end;

func Pick(const AS: string);
begin
end;

// The full declaration of the forward above
func Twin(const AA: int32): int32;
begin
  return AA;
end;

var
  GCount: int32;
  GColour: Colour;

begin
  // CHECK: GCount (the first one) -> its declaration in the var block
  // CHECK: Twin -> the FULL routine (below the Pick routines), not the
  //                forward line
  GCount := Twin(1);

  // CHECK: Pick -> the Pick(const AN: int32) routine only (an overload set:
  //                the check picked the one that takes an int32)
  Pick(GCount);

  // CHECK: GCount (after for) -> its declaration in the var block
  for GCount := 1 to 3 do
    Pick("x");
  end;

  // CHECK: Green  -> the value Green inside choices(...)
  // CHECK: Colour -> the type Colour
  GColour := Colour.Green;

  // CHECK: lsp_manual_unit -> opens lsp_manual_unit.adam at its module name
  // CHECK: Twice           -> opens lsp_manual_unit.adam at the routine Twice
  GCount := lsp_manual_unit.Twice(GCount);

  // CHECK: Twin on the forward line above -> the full routine Twin
end.
