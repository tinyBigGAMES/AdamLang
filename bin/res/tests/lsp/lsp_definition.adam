-------------------------------------------------------------------------------
  lsp_definition.adam - Adam's language server's go-to-definition (M11b L3):
  Adam.Lsp.Server (imported from the compiler's own src\) serves a scripted
  client over a channel of the row's; each Location is printed as its file's
  name and its range.

  Definitions from the uses in the sample: a const, a routine, a
  parameter, a local, a variable, a member (a field), a named type, a
  choice value, a declaration's own name (itself), the module's name, an
  imported unit's name (its module's name in the std file), a std routine
  read from its compiled unit (System.Math.adam: the .acu keeps no name
  place, the name found from its first token), and a keyword (null); a
  URI not open is null, a request with no position an error -32602.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | <- 1 result hover true definition true
  | -> diagnostics v1
  |    39:0 PR0073 doc comment documents nothing
  |    45:25 PR0073 doc comment documents nothing
  | <- 2 lsp_definition_main.adam 7:2-7:16
  | <- 3 lsp_definition_main.adam 41:8-41:13
  | <- 4 lsp_definition_main.adam 41:20-41:26
  | <- 5 lsp_definition_main.adam 43:2-43:9
  | <- 6 lsp_definition_main.adam 50:2-50:8
  | <- 7 lsp_definition_main.adam 13:4-13:5
  | <- 8 lsp_definition_main.adam 12:2-12:7
  | <- 9 lsp_definition_main.adam 11:23-11:28
  | <- 10 lsp_definition_main.adam 41:8-41:13
  | <- 11 lsp_definition_main.adam 1:11-1:30
  | <- 12 System.SysUtils.adam 41:12-41:27
  | <- 13 System.Math.adam 387:15-387:30
  | <- 14 null
  | <- 15 null
  | <- 16 error -32602: Invalid parameters for "textDocument/definition"
  | <- 17 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_definition;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.Json, Adam.Protocol.Transport, Adam.Lsp.Server;

// The sample
routine SampleText(): string;
begin
  return
    "/// The sample program.\n" +
    "module exe lsp_definition_main;\n" +
    "\n" +
    "import System.SysUtils, System.Math;\n" +
    "\n" +
    "const\n" +
    "  /// How many rows.\n" +
    "  ADAM_ROW_LIMIT: int32 = 3;\n" +
    "\n" +
    "type\n" +
    "  /// A colour.\n" +
    "  Color = choices(Red, Green); /// Green's doc.\n" +
    "  Point = record\n" +
    "    X: int32; /// The across part.\n" +
    "    /// The up part.\n" +
    "    Y: int32; /// loses to the block\n" +
    "    W: int32; /// The depth part.\n" +
    "  end;\n" +
    "\n" +
    "/// Picks a value.\n" +
    "///\n" +
    "/// More text with **bold**.\n" +
    "/// @param AValue the value\n" +
    "///   given back\n" +
    "/// @returns AValue itself\n" +
    "/// @raises nothing\n" +
    "/// @see Twice\n" +
    "/// @deprecated use Twice\n" +
    "/// @since 0.3\n" +
    "/// @custom stays text\n" +
    "/// @example\n" +
    "///     LX := Pick(1);\n" +
    "///       LX := LX + 1;\n" +
    "routine Pick(const AValue: int32): int32;\n" +
    "begin\n" +
    "  return AValue;\n" +
    "end;\n" +
    "\n" +
    "//// four slashes: a plain comment\n" +
    "/// documents nothing: a blank line follows\n" +
    "\n" +
    "routine Twice(const AValue: int32): int32;\n" +
    "var\n" +
    "  LDouble: int32; /// The local's doc.\n" +
    "begin\n" +
    "  LDouble := AValue * 2; /// documents nothing\n" +
    "  return LDouble;\n" +
    "end;\n" +
    "\n" +
    "var\n" +
    "  GPoint: Point;\n" +
    "  GVolume: float64;\n" +
    "\n" +
    "begin\n" +
    "  GPoint.X := Pick(ADAM_ROW_LIMIT) + Twice(1);\n" +
    "  GVolume := PerceivedVolume(0.5, 100.0);\n" +
    "  if Color.Red = Color.Green then\n" +
    "    GPoint.W := 1;\n" +
    "  end;\n" +
    "  println(\"{}\", IntToStr(GPoint.X));\n" +
    "end.\n";
end;

// The 0-based character of the ANth (1-based) AWord on the 0-based line ALine of AText
// (ASCII: bytes and UTF-16 units alike)
routine At(const AText: string; const ALine: int64; const AWord: string; const ANth: int64): int64;
var
  LLines: StringArray;
  LAt: int64;
  LI: int64;
begin
  LLines := SplitString(AText, "\n");
  LAt := -1;
  for LI := 1 to ANth do
    LAt := IndexOf(AWord, LLines[ALine], LAt + 1);
  end;
  return LAt;
end;

// The last part of a URI's path
routine FileOf(const AUri: string): string;
var
  LParts: StringArray;
begin
  LParts := SplitString(AUri, "/");
  return LParts[len(LParts) - 1];
end;

// A Range object as start line:character-end line:character
routine RangeText(const ARange: Json): string;
begin
  return IntToStr(ARange.Get("start.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("start.character").AsInt64()) + "-" +
    IntToStr(ARange.Get("end.line").AsInt64()) + ":" +
    IntToStr(ARange.Get("end.character").AsInt64());
end;

type
  // The client's side
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FTogether: BoolArray;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: Json): Json;
    var
      LMessage: Json;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId, sent with the one before when ATogether
    method Request(const AId: int64; const AMethod: string; const AParams: Json;
      const ATogether: bool);
    var
      LMessage: Json;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString(), ATogether);
    end;

    // A position request AMethod (AId) at ALine / ACharacter of AUri
    method At(const AId: int64; const AMethod: string; const AUri: string; const ALine: int64;
      const ACharacter: int64; const ATogether: bool);
    var
      LParams: Json;
    begin
      LParams.BeginObject("textDocument");
      LParams.Add("uri", AUri);
      LParams.EndObject();
      LParams.BeginObject("position");
      LParams.Add("line", ALine);
      LParams.Add("character", ACharacter);
      LParams.EndObject();
      self.Request(AId, AMethod, LParams, ATogether);
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: Json; const ATogether: bool);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString(), ATogether);
    end;

    // ABody framed
    method Raw(const ABody: string; const ATogether: bool);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FTogether, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FTogether[LCount] := ATogether;
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // The next message waits only when it was sent together with the one before
    override method HasPending(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FStarts) - 1 do
        if self.FStarts[LI] >= self.FAt then
          return self.FTogether[LI];
        end;
      end;
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: Json;
      LItems: array of Json;
      LLines: StringArray;
      LI: int64;
      LMethod: string;
    begin
      LMessage := Json.FromString(ABody);
      if not LMessage.Has("method") then
        if LMessage.Has("error") then
          println("<- {} error {}: {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("error.code").AsInt64(), LMessage.Get("error.message").AsString());
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LMessage.Get("id").AsInt64());
          return;
        end;
        if LMessage.Has("result.capabilities") then
          println("<- {} result hover {} definition {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("result.capabilities.hoverProvider").AsBoolean(),
            LMessage.Get("result.capabilities.definitionProvider").AsBoolean());
          return;
        end;
        if LMessage.Has("result.contents") then
          println("<- {} hover {} {}", LMessage.Get("id").AsInt64(),
            RangeText(LMessage.Get("result.range")),
            LMessage.Get("result.contents.kind").AsString());
          LLines := SplitString(LMessage.Get("result.contents.value").AsString(), "\n");
          for LI := 0 to len(LLines) - 1 do
            if LLines[LI] = "" then
              println("   |");
            else
              println("   | {}", LLines[LI]);
            end;
          end;
          return;
        end;
        println("<- {} {} {}", LMessage.Get("id").AsInt64(),
          FileOf(LMessage.Get("result.uri").AsString()), RangeText(LMessage.Get("result.range")));
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "textDocument/publishDiagnostics" then
        println("-> diagnostics v{}", LMessage.Get("params.version").AsInt64(-1));
        LItems := LMessage.Get("params.diagnostics").Items();
        for LI := 0 to len(LItems) - 1 do
          println("   {}:{} {} {}", LItems[LI].Get("range.start.line").AsInt64(),
            LItems[LI].Get("range.start.character").AsInt64(),
            LItems[LI].Get("code").AsString(""), LItems[LI].Get("message").AsString(""));
        end;
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// didOpen's params: AUri with AText at version 1
routine OpenParams(const AUri: string; const AText: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.Add("languageId", "adam");
  LJson.Add("version", 1);
  LJson.Add("text", AText);
  LJson.EndObject();
  return LJson;
end;

var
  GC: ref ScriptChannel;
  GNone: Json;
  GPaths: StringArray;
  GUri: string;
  GText: string;
  GCode: int32;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GUri := "file:///" + ReplaceStr(ResolvePath("$P:lsp_definition_main.adam"), "\\", "/");
  GText := SampleText();
  GC := ref ScriptChannel();
  GC.Request(1, "initialize", GNone, false);
  GC.Notify("textDocument/didOpen", OpenParams(GUri, GText), false);
  GC.At(2, "textDocument/definition", GUri, 54, At(GText, 54, "ADAM_ROW_LIMIT", 1), true);
  GC.At(3, "textDocument/definition", GUri, 54, At(GText, 54, "Twice", 1), false);
  GC.At(4, "textDocument/definition", GUri, 45, At(GText, 45, "AValue", 1), false);
  GC.At(5, "textDocument/definition", GUri, 46, At(GText, 46, "LDouble", 1), false);
  GC.At(6, "textDocument/definition", GUri, 54, At(GText, 54, "GPoint", 1), false);
  GC.At(7, "textDocument/definition", GUri, 54, At(GText, 54, "X", 1), false);
  GC.At(8, "textDocument/definition", GUri, 50, At(GText, 50, "Point", 2), false);
  GC.At(9, "textDocument/definition", GUri, 56, At(GText, 56, "Green", 1), false);
  GC.At(10, "textDocument/definition", GUri, 41, At(GText, 41, "Twice", 1), false);
  GC.At(11, "textDocument/definition", GUri, 1, At(GText, 1, "_main", 1), false);
  GC.At(12, "textDocument/definition", GUri, 3, At(GText, 3, "SysUtils", 1), false);
  GC.At(13, "textDocument/definition", GUri, 55, At(GText, 55, "PerceivedVolume", 1), false);
  GC.At(14, "textDocument/definition", GUri, 56, At(GText, 56, "then", 1), false);
  GC.At(15, "textDocument/definition", "file:///nowhere/x.adam", 0, 0, false);
  GC.Request(16, "textDocument/definition", GNone, false);
  GC.Request(17, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  GCode := RunLsp(ref ProtocolTransport(GC), GPaths);
  println("== exit {}", GCode);
end.
