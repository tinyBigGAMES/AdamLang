-------------------------------------------------------------------------------
  lsp_format.adam - Adam's language server's formatting (M11b L7):
  Adam.Lsp.Server (imported from the compiler's own src\) serves a scripted
  client over a channel of the row's; the client applies each answer's
  TextEdits to its own copy of the buffer and prints the result, a line a
  row in brackets (trailing blanks show).

  formatting with the defaults: one item per line, blocks / arms / members
  / an inline accessor one in, the var / const / type block words at their
  level, R3 spacing (operators, ':' / ',' / ';', calls and headings hug),
  comments kept at their code's level, blank lines at most one, a long
  return broken at its outermost '+'. The result formatted again gives no
  edits (idempotent). rangeFormatting keeps the edits in its range only
  (the Add heading's line); the options tabSize 4 and
  adam.spaceAroundOperators false re-indent and close the operators. A
  buffer with a parser error is refused: a window/showMessage warning and
  no edits (the sample's Semantics error, a for over a constant, does not
  stop it); several blanks written after a word or a ',' stay (alignment,
  as pcpp); a URI not open is null; no URI, or a range request with no
  range, is an error -32602. The first session ends with no shutdown (exit
  1), the second with one (exit 0).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | <- 1 result formatting true range true
  | -> diagnostics v1 1
  | <- 2 49 edits
  |    [module exe lsp_format_main;]
  |    [import System.SysUtils, System.IO;]
  |    [const]
  |    [  X: int32 = 1;]
  |    [  Y: int32 = 2;   // the second]
  |    [type]
  |    [  Point = record]
  |    [    X: int32;]
  |    [    Y: int32;]
  |    [  end;]
  |    [  Box = object]
  |    [    FSize: int32;]
  |    [    property Size: int32]
  |    [      read]
  |    [      begin]
  |    [        return self.FSize;]
  |    [      end;]
  |    [    method Grow(const ABy: int32);]
  |    [    begin]
  |    [      self.FSize := self.FSize + ABy;]
  |    [    end;]
  |    [  end;]
  |    []
  |    [func Add(const ALeft: int32; const ARight: int32): int32;]
  |    [var]
  |    [  LSum: int32;]
  |    [begin]
  |    [  LSum := ALeft + ARight;]
  |    [  if LSum > 10 then]
  |    [    return -LSum;]
  |    [  else]
  |    [    // doubled]
  |    [    LSum := LSum * 2;]
  |    [  end;]
  |    [  match LSum of]
  |    [    1, 2:]
  |    [      println("small");]
  |    [  else]
  |    [    println("other");]
  |    [  end;]
  |    [  return LSum;]
  |    [end;]
  |    []
  |    [func Long(): int32;]
  |    [begin]
  |    [  return Add(1000000, 2000000) + Add(3000000, 4000000) + Add(5000000, 6000000) +]
  |    [    Add(7, 8);]
  |    [end;]
  |    []
  |    [begin]
  |    [  println("{}", Add(1, 2));]
  |    [  for X := 0 to   Long() do]
  |    [    println("{}",  X);]
  |    [  end;]
  |    [end.]
  | == exit 1
  | <- 1 result formatting true range true
  | -> diagnostics v1 1
  | -> diagnostics v2 1
  | <- 3 0 edits
  | -> diagnostics v3 1
  | <- 4 7 edits
  |    [module exe lsp_format_main;]
  |    [import System.SysUtils,]
  |    [    System.IO;]
  |    [const]
  |    [X:int32=1;]
  |    [  Y: int32 = 2;   // the second]
  |    [type]
  |    [  Point = record]
  |    [  X: int32;]
  |    [     Y: int32;]
  |    [  end;]
  |    [  Box = object]
  |    [  FSize: int32;]
  |    [  property Size: int32]
  |    [  read]
  |    [  begin]
  |    [  return self.FSize;]
  |    [  end;]
  |    [  method Grow(const ABy: int32) ;]
  |    [  begin]
  |    [  self.FSize:=self.FSize+ABy;]
  |    [  end;]
  |    [  end;]
  |    []
  |    [func Add(const ALeft: int32; const ARight: int32): int32;]
  |    [var]
  |    [LSum: int32;]
  |    [begin]
  |    [  LSum:=ALeft+ARight;]
  |    [ if LSum>10 then]
  |    [ return -LSum;]
  |    [ else]
  |    [  // doubled]
  |    [ LSum := LSum * 2;]
  |    [ end;]
  |    [  match LSum of]
  |    [  1, 2: println("small");]
  |    [  else]
  |    [  println("other");]
  |    [  end;]
  |    [  return LSum;]
  |    [end;]
  |    []
  |    []
  |    []
  |    [func Long(): int32;]
  |    [begin]
  |    [  return Add(1000000, 2000000) + Add(3000000, 4000000) + Add(5000000, 6000000) + Add(7, 8);]
  |    [end;]
  |    []
  |    [begin]
  |    [  println("{}", Add(1,2));]
  |    [  for X := 0 to   Long() do]
  |    [  println("{}",  X);  end;]
  |    [end.]
  | <- 5 63 edits
  |    [module exe lsp_format_main;]
  |    [import System.SysUtils, System.IO;]
  |    [const]
  |    [    X: int32 = 1;]
  |    [    Y: int32 = 2;   // the second]
  |    [type]
  |    [    Point = record]
  |    [        X: int32;]
  |    [        Y: int32;]
  |    [    end;]
  |    [    Box = object]
  |    [        FSize: int32;]
  |    [        property Size: int32]
  |    [            read]
  |    [            begin]
  |    [                return self.FSize;]
  |    [            end;]
  |    [        method Grow(const ABy: int32);]
  |    [        begin]
  |    [            self.FSize := self.FSize+ABy;]
  |    [        end;]
  |    [    end;]
  |    []
  |    [func Add(const ALeft: int32; const ARight: int32): int32;]
  |    [var]
  |    [    LSum: int32;]
  |    [begin]
  |    [    LSum := ALeft+ARight;]
  |    [    if LSum>10 then]
  |    [        return -LSum;]
  |    [    else]
  |    [        // doubled]
  |    [        LSum := LSum*2;]
  |    [    end;]
  |    [    match LSum of]
  |    [        1, 2:]
  |    [            println("small");]
  |    [    else]
  |    [        println("other");]
  |    [    end;]
  |    [    return LSum;]
  |    [end;]
  |    []
  |    [func Long(): int32;]
  |    [begin]
  |    [    return Add(1000000, 2000000)+Add(3000000, 4000000)+Add(5000000, 6000000)+]
  |    [        Add(7, 8);]
  |    [end;]
  |    []
  |    [begin]
  |    [    println("{}", Add(1, 2));]
  |    [    for X := 0 to   Long() do]
  |    [        println("{}",  X);]
  |    [    end;]
  |    [end.]
  | -> diagnostics v1 2
  | -> showMessage 2: The file was not formatted: it has syntax errors
  | <- 6 0 edits
  | <- 7 null
  | <- 8 error -32602: Invalid parameters for "textDocument/formatting"
  | <- 9 error -32602: Invalid parameters for "textDocument/rangeFormatting"
  | <- 10 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_format;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Protocol.Transport, Adam.Lsp.Server;

// The sample, written untidily
func SampleText(): string;
begin
  return
    "module exe lsp_format_main;\n" +
    "import System.SysUtils,\n" +
    "    System.IO;\n" +
    "const\n" +
    "X:int32=1;\n" +
    "  Y: int32 = 2;   // the second\n" +
    "type\n" +
    "  Point = record\n" +
    "  X: int32;\n" +
    "     Y: int32;\n" +
    "  end;\n" +
    "  Box = object\n" +
    "  FSize: int32;\n" +
    "  property Size: int32\n" +
    "  read\n" +
    "  begin\n" +
    "  return self.FSize;\n" +
    "  end;\n" +
    "  method Grow(const ABy: int32) ;\n" +
    "  begin\n" +
    "  self.FSize:=self.FSize+ABy;\n" +
    "  end;\n" +
    "  end;\n" +
    "\n" +
    "func Add ( const ALeft : int32 ; const ARight : int32 ) : int32;\n" +
    "var\n" +
    "LSum: int32;\n" +
    "begin\n" +
    "  LSum:=ALeft+ARight;\n" +
    " if LSum>10 then\n" +
    " return -LSum;\n" +
    " else\n" +
    "  // doubled\n" +
    " LSum := LSum * 2;\n" +
    " end;\n" +
    "  match LSum of\n" +
    "  1, 2: println(\"small\");\n" +
    "  else\n" +
    "  println(\"other\");\n" +
    "  end;\n" +
    "  return LSum;\n" +
    "end;\n" +
    "\n" +
    "\n" +
    "\n" +
    "func Long(): int32;\n" +
    "begin\n" +
    "  return Add(1000000, 2000000) + Add(3000000, 4000000) + Add(5000000, 6000000) + Add(7, 8);\n" +
    "end;\n" +
    "\n" +
    "begin\n" +
    "  println(\"{}\", Add(1,2));\n" +
    "  for X := 0 to   Long() do\n" +
    "  println(\"{}\",  X);  end;\n" +
    "end.\n";
end;

// A buffer the parser stops in
func BadText(): string;
begin
  return "module exe lsp_format_bad;\nbegin\n  GX :=  ;\nend.\n";
end;

// The byte offset of the 0-based ALine / ACharacter of AText (ASCII: characters are bytes)
func OffsetOf(const AText: string; const ALine: int64; const ACharacter: int64): int64;
var
  LLine: int64;
  LAt: int64;
begin
  LLine := 0;
  LAt := 0;
  while (LLine < ALine) and (LAt < len(AText)) do
    if AText[LAt] = '\n' then
      LLine := LLine + 1;
    end;
    LAt := LAt + 1;
  end;
  return LAt + ACharacter;
end;

// AEdits (TextEdit objects, in buffer order) applied to AText, the last first
func Apply(const AText: string; const AEdits: array of Json): string;
var
  LText: string;
  LStart: int64;
  LEnd: int64;
  LI: int64;
begin
  LText := AText;
  LI := len(AEdits) - 1;
  while LI >= 0 do
    LStart := OffsetOf(AText, AEdits[LI].Get("range.start.line").AsInt64(),
      AEdits[LI].Get("range.start.character").AsInt64());
    LEnd := OffsetOf(AText, AEdits[LI].Get("range.end.line").AsInt64(),
      AEdits[LI].Get("range.end.character").AsInt64());
    LText := Substring(LText, 0, LStart) + AEdits[LI].Get("newText").AsString() +
      Substring(LText, LEnd, len(LText) - LEnd);
    LI := LI - 1;
  end;
  return LText;
end;

// AText's lines, each in brackets (the last line ending ends the text: no empty line after)
func PrintText(const AText: string);
var
  LLines: StringArray;
  LI: int64;
begin
  LLines := SplitString(AText, "\n");
  for LI := 0 to len(LLines) - 1 do
    if (LI = len(LLines) - 1) and (LLines[LI] = "") then
      leave;
    end;
    println("   [{}]", LLines[LI]);
  end;
end;

type
  // The client's side: Bases[id] the buffer a formatting request id was sent over (its
  // edits are applied to it and the result printed), Last the last result
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FTogether: BoolArray;
    Bases: StringArray;
    Last: string;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: Json): Json;
    var
      LMessage: Json;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId
    method Request(const AId: int64; const AMethod: string; const AParams: Json);
    var
      LMessage: Json;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString());
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: Json);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString());
    end;

    // ABody framed
    method Raw(const ABody: string);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FTogether, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FTogether[LCount] := false;
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    override method HasPending(): bool;
    begin
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: Json;
      LItems: array of Json;
      LMethod: string;
      LId: int64;
    begin
      LMessage := Json.FromString(ABody);
      if not LMessage.Has("method") then
        if LMessage.Has("error") then
          println("<- {} error {}: {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("error.code").AsInt64(), LMessage.Get("error.message").AsString());
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LMessage.Get("id").AsInt64());
          return;
        end;
        if LMessage.Has("result.capabilities") then
          println("<- {} result formatting {} range {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("result.capabilities.documentFormattingProvider").AsBoolean(),
            LMessage.Get("result.capabilities.documentRangeFormattingProvider").AsBoolean());
          return;
        end;
        LId := LMessage.Get("id").AsInt64();
        LItems := LMessage.Get("result").Items();
        println("<- {} {} edits", LId, len(LItems));
        if (LId < len(self.Bases)) and (len(LItems) > 0) then
          self.Last := Apply(self.Bases[LId], LItems);
          PrintText(self.Last);
        end;
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "textDocument/publishDiagnostics" then
        println("-> diagnostics v{} {}", LMessage.Get("params.version").AsInt64(-1),
          len(LMessage.Get("params.diagnostics").Items()));
        return;
      end;
      if LMethod = "window/showMessage" then
        println("-> showMessage {}: {}", LMessage.Get("params.type").AsInt64(),
          LMessage.Get("params.message").AsString());
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// didOpen's params: AUri with AText at version 1
func OpenParams(const AUri: string; const AText: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.Add("languageId", "adam");
  LJson.Add("version", 1);
  LJson.Add("text", AText);
  LJson.EndObject();
  return LJson;
end;

// didChange's params: all of AUri's text replaced by AText at AVersion
func ChangeParams(const AUri: string; const AVersion: int64; const AText: string): Json;
var
  LJson: Json;
begin
  LJson.BeginObject("textDocument");
  LJson.Add("uri", AUri);
  LJson.Add("version", AVersion);
  LJson.EndObject();
  LJson.BeginArray("contentChanges");
  LJson.BeginObject();
  LJson.Add("text", AText);
  LJson.EndObject();
  LJson.EndArray();
  return LJson;
end;

// formatting's params for AUri ("" none): tabSize ATab; AClose: adam.spaceAroundOperators
// false
func FormatParams(const AUri: string; const ATab: int64; const AClose: bool): Json;
var
  LJson: Json;
begin
  if AUri <> "" then
    LJson.BeginObject("textDocument");
    LJson.Add("uri", AUri);
    LJson.EndObject();
  end;
  LJson.BeginObject("options");
  LJson.Add("tabSize", ATab);
  LJson.Add("insertSpaces", true);
  if AClose then
    LJson.Add("adam.spaceAroundOperators", false);
  end;
  LJson.EndObject();
  return LJson;
end;

// rangeFormatting's params: AUri over the 0-based lines AFirst to ALast (exclusive, at its
// line's start); ARange false: none
func RangeParams(const AUri: string; const AFirst: int64; const ALast: int64;
  const ARange: bool): Json;
var
  LJson: Json;
begin
  LJson := FormatParams(AUri, 2, false);
  if ARange then
    LJson.BeginObject("range");
    LJson.BeginObject("start");
    LJson.Add("line", AFirst);
    LJson.Add("character", 0);
    LJson.EndObject();
    LJson.BeginObject("end");
    LJson.Add("line", ALast);
    LJson.Add("character", 0);
    LJson.EndObject();
    LJson.EndObject();
  end;
  return LJson;
end;

var
  GC: ref ScriptChannel;
  GNone: Json;
  GPaths: StringArray;
  GUri: string;
  GBadUri: string;
  GFormatted: string;
  GCode: int32;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GUri := "file:///" + ReplaceStr(ResolvePath("$P:lsp_format_main.adam"), "\\", "/");
  GBadUri := "file:///" + ReplaceStr(ResolvePath("$P:lsp_format_bad.adam"), "\\", "/");
  GC := ref ScriptChannel();
  setlength(GC.Bases, 3);
  GC.Bases[2] := SampleText();
  GC.Request(1, "initialize", GNone);
  GC.Notify("textDocument/didOpen", OpenParams(GUri, SampleText()));
  GC.Request(2, "textDocument/formatting", FormatParams(GUri, 2, false));
  GCode := RunLsp(ref ProtocolTransport(GC), GPaths);
  println("== exit {}", GCode);
  // The result formatted again: no edits; then the range and the options over the sample
  GFormatted := GC.Last;
  GC := ref ScriptChannel();
  setlength(GC.Bases, 6);
  GC.Bases[3] := GFormatted;
  GC.Bases[4] := SampleText();
  GC.Bases[5] := SampleText();
  GC.Request(1, "initialize", GNone);
  GC.Notify("textDocument/didOpen", OpenParams(GUri, SampleText()));
  GC.Notify("textDocument/didChange", ChangeParams(GUri, 2, GFormatted));
  GC.Request(3, "textDocument/formatting", FormatParams(GUri, 2, false));
  GC.Notify("textDocument/didChange", ChangeParams(GUri, 3, SampleText()));
  GC.Request(4, "textDocument/rangeFormatting", RangeParams(GUri, 24, 25, true));
  GC.Request(5, "textDocument/formatting", FormatParams(GUri, 4, true));
  GC.Notify("textDocument/didOpen", OpenParams(GBadUri, BadText()));
  GC.Request(6, "textDocument/formatting", FormatParams(GBadUri, 2, false));
  GC.Request(7, "textDocument/formatting", FormatParams("file:///nowhere/x.adam", 2, false));
  GC.Request(8, "textDocument/formatting", FormatParams("", 2, false));
  GC.Request(9, "textDocument/rangeFormatting", RangeParams(GUri, 0, 1, false));
  GC.Request(10, "shutdown", GNone);
  GC.Notify("exit", GNone);
  GCode := RunLsp(ref ProtocolTransport(GC), GPaths);
  println("== exit {}", GCode);
end.
