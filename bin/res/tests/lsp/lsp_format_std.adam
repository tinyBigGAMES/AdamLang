-------------------------------------------------------------------------------
  lsp_format_std.adam - Adam's formatter over every std and runtime unit
  (M11b L7): each unit is checked as the language server checks a buffer
  (Adam.Driver.Compiler, the std / runtime module paths), formatted with
  the defaults (Adam.Lsp.Format, imported from the compiler's own src\),
  the result checked again (no lexer / conditional / parser error) and
  formatted again: no edits (formatting is idempotent). A unit refused, one
  whose result does not check, or one formatted twice that still changes
  is printed with what happened; all of them passing, one line.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | units <NUM> idempotent
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_format_std;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Compiler.Diagnostics, Adam.Driver.Compiler,
  Adam.Lsp.Format;

var
  GPaths: StringArray;

// A check of APath, its text AText given when it is not "" (the module paths the server's)
routine CheckOf(const APath: string; const AText: string): ref Compiler;
var
  LCompiler: ref Compiler;
  LI: int64;
begin
  LCompiler := ref Compiler();
  for LI := 0 to len(GPaths) - 1 do
    LCompiler.AddModulePath(GPaths[LI]);
  end;
  if AText <> "" then
    LCompiler.GiveText(APath, AText);
  end;
  LCompiler.CheckDocument(APath);
  return LCompiler;
end;

// The number of ACheck's lexer / conditional / parser errors
routine SyntaxErrors(const ACheck: ref Compiler): int64;
var
  LCount: int64;
  LCode: string;
  LI: int64;
begin
  LCount := 0;
  for LI := 0 to ACheck.Reports.Count - 1 do
    LCode := ACheck.Reports.Items[LI].Code;
    if ACheck.Reports.Items[LI].IsError() and (StartsStr("LX", LCode) or StartsStr("CD", LCode) or
      StartsStr("PR", LCode)) then
      LCount := LCount + 1;
    end;
  end;
  return LCount;
end;

// The unit APath through both rounds: true when it passes (else what happened printed)
routine FormatTwice(const APath: string): bool;
var
  LCheck: ref Compiler;
  LText: string;
  LFirst: LspFormatResult;
  LSecond: LspFormatResult;
begin
  LCheck := CheckOf(APath, "");
  LText := "";
  if not LCheck.LoadedText(APath, LText) then
    println("{}: not read", ExtractFileName(APath));
    return false;
  end;
  LFirst := FormatSource(LText, LCheck.Tree, LCheck.MainModule, SyntaxErrors(LCheck) = 0,
    FormatDefaults());
  if LFirst.Refusal <> LspFormatRefusal.None then
    println("{}: refused", ExtractFileName(APath));
    return false;
  end;
  LCheck := CheckOf(APath, LFirst.Text);
  if SyntaxErrors(LCheck) > 0 then
    println("{}: the result has {} syntax errors", ExtractFileName(APath), SyntaxErrors(LCheck));
    return false;
  end;
  LSecond := FormatSource(LFirst.Text, LCheck.Tree, LCheck.MainModule, true, FormatDefaults());
  if LSecond.Refusal <> LspFormatRefusal.None then
    println("{}: refused the second time", ExtractFileName(APath));
    return false;
  end;
  if len(LSecond.Edits) > 0 then
    println("{}: {} edits the second time, the first at byte {}", ExtractFileName(APath),
      len(LSecond.Edits), LSecond.Edits[0].StartOffset);
    return false;
  end;
  return true;
end;

var
  GFiles: StringArray;
  GCount: int64;
  GGood: bool;
  GI: int64;
  GJ: int64;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GCount := 0;
  GGood := true;
  for GI := 0 to len(GPaths) - 1 do
    GetFiles(GPaths[GI], GFiles);
    for GJ := 0 to len(GFiles) - 1 do
      if ExtractFileExt(GFiles[GJ]) <> ".adam" then
        skip;
      end;
      GCount := GCount + 1;
      if not FormatTwice(GPaths[GI] + "/" + GFiles[GJ]) then
        GGood := false;
      end;
    end;
  end;
  if GGood then
    println("units {} idempotent", GCount);
  end;
end.
