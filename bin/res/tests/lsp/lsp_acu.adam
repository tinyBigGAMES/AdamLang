-------------------------------------------------------------------------------
  lsp_acu.adam - LSP1: the language server's check (Compiler.CheckDocument)
  takes each imported unit with a current .acu from it, as a build does, so
  a document's first hover / definition is not a parse of every source. A
  lib build (in this process: the .acu's compiler is the check's) writes the
  sample's units' .acu into its @outputpath; then three checks of its main
  module, each by a fresh Compiler as the server makes one: the unit and the
  runtime come from their .acu (NodeFlag.Compiled), the main module from its
  source; again with the unit's text given as it is on the disk (an open,
  unchanged buffer: still its .acu); and with an edited text given for it
  (an open buffer that moved: parsed from that text, the new routine the
  main module now calls found there)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | build errors false
  | check disk errors false
  | check disk unit compiled true
  | check disk runtime compiled true
  | check disk main compiled false
  | check same errors false
  | check same unit compiled true
  | check same runtime compiled true
  | check edited errors false
  | check edited unit compiled false
  | check edited runtime compiled true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_acu;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Compiler.AST, Adam.Driver.Compiler;

const
  // The samples, beside this exe; their units' .acu below the output root
  ADAM_SAMPLE_UNIT: string = "LSPACUUnit.adam";
  ADAM_SAMPLE_MAIN: string = "lsp_acu_main.adam";
  ADAM_SAMPLE_OUTPUT: string = "$P:../../..";

// The sample unit; AEdited: a second routine its importer calls (an edited buffer)
func UnitText(const AEdited: bool): string;
var
  LText: string;
begin
  LText :=
    "module unit LSPACUUnit;\n" +
    "\n" +
    "public func LSPACUValue(): int32;\n" +
    "begin\n" +
    "  return 7;\n" +
    "end;\n";
  if AEdited then
    LText := LText +
      "\n" +
      "public func LSPACUEdited(): int32;\n" +
      "begin\n" +
      "  return 8;\n" +
      "end;\n";
  end;
  return LText + "\nend.\n";
end;

// The sample main module, a lib (no link), calling ACall, its output folder AOutput
func MainText(const ACall: string; const AOutput: string): string;
begin
  return
    "module lib lsp_acu_main;\n" +
    "\n" +
    "@outputpath \"" + AOutput + "\";\n" +
    "\n" +
    "import LSPACUUnit;\n" +
    "\n" +
    "public func LSPACUTwice(): int32;\n" +
    "begin\n" +
    "  return " + ACall + "() * 2;\n" +
    "end;\n" +
    "\n" +
    "end.\n";
end;

// A Compiler with the std's and the runtime's module paths
func NewCompiler(): ref Compiler;
var
  LCompiler: ref Compiler;
begin
  LCompiler := ref Compiler();
  LCompiler.AddModulePath(ResolvePath("$P:../../../../res/libs/std"));
  LCompiler.AddModulePath(ResolvePath("$P:../../../../res/runtime"));
  return LCompiler;
end;

// True when the module AName of ACompiler's tree was read from its .acu
func IsCompiled(const ACompiler: ref Compiler; const AName: string): bool;
var
  LModule: int64;
  LI: int64;
begin
  for LI := 0 to ACompiler.Tree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
    LModule := ACompiler.Tree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
    if ACompiler.Tree[LModule].Text = AName then
      return ACompiler.Tree[LModule].HasFlag(NodeFlag.Compiled);
    end;
  end;
  return false;
end;

// One check of the main module AMain as the server makes it (a fresh Compiler), the
// unit AUnit's text given as AUnitText ("": none, the disk's); AWithMain: the main
// module's own line too
func CheckOnce(const ALabel: string; const AMain: string; const AUnit: string;
  const AUnitText: string; const AWithMain: bool);
var
  LCompiler: ref Compiler;
begin
  LCompiler := NewCompiler();
  if AUnitText <> "" then
    LCompiler.GiveText(AUnit, AUnitText);
  end;
  LCompiler.CheckDocument(AMain);
  println("check {} errors {}", ALabel, BoolToStr(LCompiler.Reports.HasErrors()));
  if LCompiler.Reports.HasErrors() then
    LCompiler.PrintReports();
  end;
  println("check {} unit compiled {}", ALabel, BoolToStr(IsCompiled(LCompiler, "LSPACUUnit")));
  println("check {} runtime compiled {}", ALabel,
    BoolToStr(IsCompiled(LCompiler, "System.Runtime")));
  if AWithMain then
    println("check {} main compiled {}", ALabel,
      BoolToStr(IsCompiled(LCompiler, "lsp_acu_main")));
  end;
end;

var
  GUnit: string;
  GMain: string;
  GOutput: string;
  GCompiler: ref Compiler;

begin
  GUnit := ResolvePath("$P:" + ADAM_SAMPLE_UNIT);
  GMain := ResolvePath("$P:" + ADAM_SAMPLE_MAIN);
  GOutput := ResolvePath(ADAM_SAMPLE_OUTPUT);
  if not WriteAllText(GUnit, UnitText(false)) or
    not WriteAllText(GMain, MainText("LSPACUValue", GOutput)) then
    println("cannot write the samples");
    Halt(1);
  end;
  // The units' .acu, written by this process's compiler
  GCompiler := NewCompiler();
  GCompiler.Build(GMain, "");
  println("build errors {}", BoolToStr(GCompiler.Reports.HasErrors()));
  if GCompiler.Reports.HasErrors() then
    GCompiler.PrintReports();
    Halt(1);
  end;
  CheckOnce("disk", GMain, GUnit, "", true);
  CheckOnce("same", GMain, GUnit, UnitText(false), false);
  // The main module now calls the edited buffer's new routine: found only in that text
  if not WriteAllText(GMain, MainText("LSPACUEdited", GOutput)) then
    println("cannot write the main module");
    Halt(1);
  end;
  CheckOnce("edited", GMain, GUnit, UnitText(true), false);
end.
