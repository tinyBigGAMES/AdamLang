-------------------------------------------------------------------------------
  lsp_stdio_linux.adam - adam lsp on a Linux host's standard input and output
  (LX7a's Protocol.Stdio.Linux64, LX7b): the linux adam (<ADAM> to an
  x86_64-linux-gnu program: the twin beside adam.exe) serves a client whose
  messages are a file read as its stdin: initialize answered with the
  server's capabilities, shutdown answered with a null result, exit ends it
  with 0 (shutdown first)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  args "<ADAM>"
  exitcode 0
  | ok started
  | ok exit 0
  | ok initialize answered
  | ok capabilities
  | ok shutdown answered
  | done
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_stdio_linux;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "lsp_stdio_linux runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

import System.SysUtils, System.IO, System.Process, System.Linux;

type
  // The server's output, every line joined with a '|' after it
  Lines = object implements ProcessOutput
    Text: string;

    virtual method Output(const AText: string);
    begin
      self.Text := self.Text + AText + "|";
    end;
  end;

  // The server's stdin: Input, a file of the client's messages; never a terminal
  FileHost = object implements ProcessHost
    Input: uint64;

    virtual method InitialSize(var ACols: int32; var ARows: int32): bool;
    begin
      return false;
    end;

    virtual method StdInput(): uint64;
    begin
      return self.Input;
    end;

    virtual method Start(const ATerminal: ref ProcessTerminal): bool;
    begin
      return false;
    end;

    virtual method Stop();
    begin
    end;
  end;

// "ok <what>" when AOk holds, else "FAIL <what>"
func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
  end;
end;

// The LSP frame of ABody: its Content-Length header, a blank line, the body
func Framed(const ABody: string): string;
begin
  return "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
end;

var
  LPath: string;
  LFile: int32;
  LHost: ref FileHost;
  LLines: ref Lines;
  LArgs: StringArray;
  LExit: uint32;
  LOk: bool;

begin
  LPath := TempDir() + "/adam_lx7b_lsp_input.txt";
  LFile := -1;
  if WriteAllText(LPath,
    Framed("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":" +
      "{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}") +
    Framed("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}") +
    Framed("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}") +
    Framed("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")) then
    LFile := open(LPath, O_RDONLY);
  end;
  LHost := ref FileHost();
  LHost.Input := uint64(LFile);
  LLines := ref Lines();
  setlength(LArgs, 1);
  LArgs[0] := "lsp";
  LExit := 9;
  LOk := (LFile >= 0) and RunELF(paramstr(1), LArgs, "", LExit, LLines, ProcessCapture.Pipes,
    LHost);
  if LFile >= 0 then
    close(LFile);
  end;
  DeleteFile(LPath);
  Check("started", LOk);
  Check("exit 0", LExit = 0);
  Check("initialize answered", IndexOf("\"id\":1,", LLines.Text, 0) >= 0);
  Check("capabilities", IndexOf("\"capabilities\":", LLines.Text, 0) >= 0);
  Check("shutdown answered", IndexOf("\"id\":2,\"result\":null", LLines.Text, 0) >= 0);
  println("done");
end.
