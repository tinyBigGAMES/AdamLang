-------------------------------------------------------------------------------
  lsp_manual_doc_comments.adam - `///` doc comments in hover (M11b L9)

  `///` lines are documentation (BNF sec 9): Markdown, plus tags at a
  line's start:
    @param Name text   @returns text   @raises text   @see Name
    @deprecated text   @since text     @example (code lines follow)
  A block of own-line `///` lines documents the declaration on the next
  line; a `///` after code on a line documents that line's declaration (the
  block wins when both are there). `//` and `////` are plain comments; a
  `///` that documents nothing is a hint (PR0073). Hover shows the doc
  under the declaration's code box.

  How to check: hover each name a CHECK line names (in the body at the end)
  and compare with the text after "->"; the Problems list shows the one
  hint the last CHECK of the var block names.
  Needs lsp_manual_unit.adam in the same folder.
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_doc_comments;

import lsp_manual_unit;

/// Clamps a value to a range.
///
/// Values below `AMin` give `AMin`; values above `AMax` give **AMax**.
/// @param AValue the value to clamp
/// @param AMin   lower bound (inclusive)
/// @param AMax   upper bound (inclusive); must not be
///   below `AMin`
/// @returns the clamped value
/// @raises nothing
/// @since 0.1
/// @see Wrap
/// @deprecated use Wrap where a cycle is wanted
/// @example
///   LX := Clamp(15, 0, 10);  // 10
///   LY := Clamp(-3, 0, 10);  // 0
routine Clamp(const AValue: int32; const AMin: int32; const AMax: int32): int32;
begin
  if AValue < AMin then
    return AMin;
  end;
  if AValue > AMax then
    return AMax;
  end;
  return AValue;
end;

/// Wraps a value into `0 .. ASize - 1`.
routine Wrap(const AValue: int32; const ASize: int32): int32;
begin
  return AValue mod ASize;
end;

type
  /// A colour channel set.
  Rgb = record
    /// Red, 0 .. 255.
    R: uint8;
    G: uint8;
    B: uint8; /// Blue, 0 .. 255 (a trailing doc).
  end;

  /// Traffic light states.
  Light = choices(
    /// Stop.
    Red,
    Amber,
    /// Go.
    Green);

var
  /// The current colour.
  GColour: Rgb;
  // A plain comment: not documentation.
  GPlain: int32;
  //// Four slashes: not documentation either.
  GFour: int32;
  /// Detached by the blank line below: documents nothing (the hint PR0073)

  GDetached: int32;
  GLight: Light;

begin
  // CHECK: Clamp -> its code box, then in this order: "Deprecated: use Wrap
  //        where a cycle is wanted", the two summary paragraphs (AMin in
  //        code style, AMax bold), Parameters (AValue, AMin, AMax: its text
  //        joined into one line), Returns, Raises, Since 0.1, See also Wrap,
  //        Example as an Adam code block (two lines, indent removed)
  GPlain := Clamp(15, 0, 10);

  // CHECK: Wrap -> "Wraps a value into 0 .. ASize - 1." (the range in code)
  GFour := Wrap(GPlain, 4);

  // CHECK: GColour -> "The current colour."   R -> "Red, 0 .. 255."
  // CHECK: G -> no documentation (the line above it is a field, not ///)
  // CHECK: B -> "Blue, 0 .. 255 (a trailing doc)."
  GColour.R := 1;
  GColour.G := 2;
  GColour.B := 3;

  // CHECK: Light -> "Traffic light states."   Red -> "Stop."
  //        Amber -> no documentation           Green -> "Go."
  GLight := Light.Red;
  GLight := Light.Amber;
  GLight := Light.Green;

  // CHECK: GPlain, GFour, GDetached -> no documentation
  GDetached := GPlain + GFour;

  // CHECK: Twice -> its doc from lsp_manual_unit.adam, Parameters (AX),
  //        Returns, and *lsp_manual_unit.adam*
  GDetached := lsp_manual_unit.Twice(GDetached);
end.
