-------------------------------------------------------------------------------
  lsp_manual_diagnostics_syntax.adam - a syntax error while you type
  (M11b L9)

  This file has a syntax mistake on purpose: a missing ';'. The rest of the
  file keeps working around it: other mistakes are still underlined, hover,
  go to definition and the parameter hints still show.

  How to check:
    1. Open this file. The first CHECK: a red squiggle right after the 1
       (where the ';' was expected). Hover it: "expected ';', found
       'GText'" (PR0001).
    2. The second CHECK: GCount's second declaration is underlined too,
       although the file has a syntax error.
    3. Hover that GText: var GText: string; F12 jumps to its
       declaration.
    4. The last CHECK: hover Add and see its declaration; the call shows
       the hints AA: and AB:.
    5. Type the ';' after the 1 WITHOUT saving: that squiggle goes, the
       GCount one stays.
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_diagnostics_syntax;

routine Add(const AA: int32; const AB: int32): int32;
begin
  return AA + AB;
end;

var
  GCount: int32;
  // CHECK: GCount on the line below is underlined: it is already declared
  GCount: int32; // ERROR SM0004@3: is already declared in this scope
  GText: string;

begin
  // CHECK: the ';' after the 1 below is missing: the squiggle is right after
  //        the 1; hover GText on the next line -> var GText: string; F12
  //        jumps to its declaration (the line still parses: nothing skipped)
  GCount := 1 // ERROR PR0001@14: expected ';', found 'GText'
  GText := "y";

  // CHECK: hover Add -> routine Add(const AA: int32; const AB: int32): int32
  //        hints: AA: before 3, AB: before 4
  GCount := Add(3, 4);
end.
