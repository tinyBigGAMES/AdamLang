-------------------------------------------------------------------------------
  lsp_manual_diagnostics.adam - the editor's squiggles while you type
  (M11b L9)

  This file has mistakes ON PURPOSE. The editor checks the text as you type
  (no build needed) and underlines each mistake. Every CHECK below says
  which mistake is underlined and where; the Problems list shows the same.

  How to check:
    1. Open this file. Every line marked CHECK has a red squiggle under the
       word it names, nowhere else.
    2. Hover a squiggle: the message is the one the CHECK names.
    3. Fix one (follow its FIX note) WITHOUT saving: its squiggle goes
       within a moment; the other stays.
    4. Undo the fix: the squiggle comes back.
    5. The disk counts too (watched files): open lsp_manual_hover.adam and
       leave it open, then open lsp_manual_unit.adam in Notepad (NOT the
       editor) and rename Twice to Twice2; save. Within about two seconds
       lsp_manual_hover.adam underlines its use of Twice (SM0021 'Twice'
       is not declared ...). Rename it back in Notepad and save: the
       squiggle goes, without touching lsp_manual_hover.adam.
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_diagnostics;

routine Add(const AA: int32; const AB: int32): int32;
begin
  return AA + AB;
end;

var
  GCount: int32;
  // CHECK: GCount on the line below is underlined:
  //        SM0004 'GCount' is already declared in this scope (first at line 52)
  // FIX:   rename it, e.g. GCount2
  GCount: int32; // ERROR SM0004@3: is already declared in this scope
  GText: string;

begin
  // CHECK: the "x" inside Add(...) is underlined:
  //        SM0404 argument 1 of 'Add': 'string' does not convert implicitly to
  //        'int32'
  // FIX:   pass a number, e.g. Add(1, 2)
  GText := "x";
  Add("x", 2); // ERROR SM0404@7: does not convert implicitly to 'int32'
end.
