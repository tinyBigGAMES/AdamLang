-------------------------------------------------------------------------------
  lsp_manual_workspace_symbols.adam - Go to Symbol in Workspace (M11b L9)

  Ctrl+T (Go > Go to Symbol in Workspace) lists the declarations of every
  module the open files reach, a type's members under the type's name, and
  narrows the list as you type (its letters in order, case aside). A unit
  that is not open gives only what it makes public. Picking an entry opens
  its file at the name.

  How to check: open this file, press Ctrl+T and type each text a CHECK
  line gives; compare the list with the text after "->".
    CHECK: twi -> Twice (lsp_manual_unit.adam), Twins (this file)
    CHECK: shade -> Shade, and its member Hue (in Shade) when typing "hue"
    CHECK: zzzq -> nothing (no matching symbols)
  Needs lsp_manual_unit.adam in the same folder.
*******************************************************************************/

/*
@@test
  kind manual
@@end
*/

module exe lsp_manual_workspace_symbols;

import lsp_manual_unit;

type
  Shade = record
    Hue: int32;
  end;

func Twins(const AN: int32): int32;
begin
  return lsp_manual_unit.Twice(AN);
end;

begin
  println("{}", Twins(2));
end.
