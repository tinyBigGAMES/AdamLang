-------------------------------------------------------------------------------
  lsp_completion.adam - Adam's language server's completion (M11b L5):
  Adam.LSP.Server (imported from the compiler's own src\) serves a scripted
  client over a channel of the row's; each list is printed as its count and
  its items (kind, label, [detail], what is inserted, snippet or not).

  Positions inside the sample's words: "ldo" (a local, the prefix matched
  case aside), "Twi" (a routine: its call snippet, a tab stop per
  parameter), after "GPoint." (a record's fields), after "GCounter." (a ref
  to an object: its method, no hidden field, no static method), after
  "self." in a method (the hidden field too), after "Counter." (a type: its
  static method), after "Color." (choice values), "Perc" after
  "System.Math." (a unit's public routine), "whi" (the keyword and its
  statement snippet); in a comment, in a string and after a plain '>' none.
  Then the user types "GPoint." on a line of its own (didChange: a parse
  error): its fields still. A URI not open is null, a request with no
  position an error -32602. A second file's hidden field (L9c, SM0019's
  rule): listed after "self." and after a value of the method's own type in
  a descendant's method, not after a value of the parent's type, nor
  outside the methods.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | <- 1 result triggers . >
  | -> diagnostics v1
  | <- 2 1 items
  |    6 LDouble [int32]
  | <- 3 1 items
  |    3 Twice [(const AValue: int32): int32] -> Twice(${1:AValue}) (snippet)
  | <- 4 2 items
  |    5 X [int32]
  |    5 Y [int32]
  | <- 5 1 items
  |    2 Bump [(const ABy: int32; const ATimes: int32)] -> Bump(${1:ABy}, ${2:ATimes}) (snippet)
  | <- 6 2 items
  |    5 FCount [int32]
  |    2 Bump [(const ABy: int32; const ATimes: int32)] -> Bump(${1:ABy}, ${2:ATimes}) (snippet)
  | <- 7 1 items
  |    2 Zero [(): int32] -> Zero()
  | <- 8 2 items
  |    20 Red
  |    20 Green
  | <- 9 2 items
  |    3 PerceivedVolume [(const ALevel: float64; const AMax: float64; const ARangeDb: float64): float64] -> PerceivedVolume(${1:ALevel}, ${2:AMax}, ${3:ARangeDb}) (snippet)
  |    3 PerceivedLevel [(const AVolume: float64; const AMax: float64; const ARangeDb: float64): float64] -> PerceivedLevel(${1:AVolume}, ${2:AMax}, ${3:ARangeDb}) (snippet)
  | <- 10 2 items
  |    14 while
  |    15 while ... end [while statement] -> while ${1:condition} do\n\t$0\nend; (snippet)
  | <- 11 0 items
  | <- 12 0 items
  | <- 13 0 items
  | -> diagnostics v2
  |    54:0 PR0001 expected a member name, found the end of the file
  |    53:4 PR0001 expected ';', found the end of the file
  |    43:0 PR0063 the 'begin' here is never closed
  |    53:0 SM0009 'Point' has no member 'end'
  |    52:2 SM0613 statement has no effect: its value is computed and dropped
  | <- 14 2 items
  |    5 X [int32]
  |    5 Y [int32]
  | <- 15 null
  | <- 16 error -32602: Invalid parameters for "textDocument/completion"
  | -> diagnostics v1
  | <- 17 3 items
  |    2 Use [(const AOther: ref Derived; const ABase: ref Base): int32] -> Use(${1:AOther}, ${2:ABase}) (snippet)
  |    5 FBase [int32]
  |    2 Get [(): int32] -> Get()
  | <- 18 3 items
  |    2 Use [(const AOther: ref Derived; const ABase: ref Base): int32] -> Use(${1:AOther}, ${2:ABase}) (snippet)
  |    5 FBase [int32]
  |    2 Get [(): int32] -> Get()
  | <- 19 1 items
  |    2 Get [(): int32] -> Get()
  | <- 20 2 items
  |    2 Use [(const AOther: ref Derived; const ABase: ref Base): int32] -> Use(${1:AOther}, ${2:ABase}) (snippet)
  |    2 Get [(): int32] -> Get()
  | <- 90 null
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lsp_completion;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.JSON.Ext, Adam.Protocol.Transport, Adam.LSP.Server;

// The sample
func SampleText(): string;
begin
  return
    "/// The completion sample.\n" +
    "module exe lsp_completion_main;\n" +
    "\n" +
    "import System.SysUtils, System.Math;\n" +
    "\n" +
    "type\n" +
    "  Color = choices(Red, Green);\n" +
    "  Point = record\n" +
    "    X: int32;\n" +
    "    Y: int32;\n" +
    "  end;\n" +
    "  Counter = object\n" +
    "    hidden FCount: int32;\n" +
    "\n" +
    "    init();\n" +
    "    begin\n" +
    "      self.FCount := 0;\n" +
    "    end;\n" +
    "\n" +
    "    method Bump(const ABy: int32; const ATimes: int32);\n" +
    "    begin\n" +
    "      self.FCount := self.FCount + ABy * ATimes;\n" +
    "    end;\n" +
    "\n" +
    "    static method Zero(): int32;\n" +
    "    begin\n" +
    "      return 0;\n" +
    "    end;\n" +
    "  end;\n" +
    "\n" +
    "func Twice(const AValue: int32): int32;\n" +
    "var\n" +
    "  LDouble: int32;\n" +
    "begin\n" +
    "  LDouble := AValue * 2; // the doubled value\n" +
    "  return LDouble;\n" +
    "end;\n" +
    "\n" +
    "var\n" +
    "  GPoint: Point;\n" +
    "  GCounter: ref Counter;\n" +
    "  GVolume: float64;\n" +
    "\n" +
    "begin\n" +
    "  GCounter := ref Counter();\n" +
    "  GCounter.Bump(1, Counter.Zero());\n" +
    "  GPoint.X := Twice(3);\n" +
    "  GVolume := System.Math.PerceivedVolume(0.5, 100.0);\n" +
    "  while GPoint.X > 100 do\n" +
    "    GPoint.Y := 1;\n" +
    "  end;\n" +
    "  println(\"{} {}\", IntToStr(int64(GPoint.X)), IntToStr(int64(Color.Green)));\n" +
    "end.\n";
end;

// The sample with "GPoint." typed on a line of its own before its end
func TypedText(): string;
begin
  return
    "/// The completion sample.\n" +
    "module exe lsp_completion_main;\n" +
    "\n" +
    "import System.SysUtils, System.Math;\n" +
    "\n" +
    "type\n" +
    "  Color = choices(Red, Green);\n" +
    "  Point = record\n" +
    "    X: int32;\n" +
    "    Y: int32;\n" +
    "  end;\n" +
    "  Counter = object\n" +
    "    hidden FCount: int32;\n" +
    "\n" +
    "    init();\n" +
    "    begin\n" +
    "      self.FCount := 0;\n" +
    "    end;\n" +
    "\n" +
    "    method Bump(const ABy: int32; const ATimes: int32);\n" +
    "    begin\n" +
    "      self.FCount := self.FCount + ABy * ATimes;\n" +
    "    end;\n" +
    "\n" +
    "    static method Zero(): int32;\n" +
    "    begin\n" +
    "      return 0;\n" +
    "    end;\n" +
    "  end;\n" +
    "\n" +
    "func Twice(const AValue: int32): int32;\n" +
    "var\n" +
    "  LDouble: int32;\n" +
    "begin\n" +
    "  LDouble := AValue * 2; // the doubled value\n" +
    "  return LDouble;\n" +
    "end;\n" +
    "\n" +
    "var\n" +
    "  GPoint: Point;\n" +
    "  GCounter: ref Counter;\n" +
    "  GVolume: float64;\n" +
    "\n" +
    "begin\n" +
    "  GCounter := ref Counter();\n" +
    "  GCounter.Bump(1, Counter.Zero());\n" +
    "  GPoint.X := Twice(3);\n" +
    "  GVolume := System.Math.PerceivedVolume(0.5, 100.0);\n" +
    "  while GPoint.X > 100 do\n" +
    "    GPoint.Y := 1;\n" +
    "  end;\n" +
    "  println(\"{} {}\", IntToStr(int64(GPoint.X)), IntToStr(int64(Color.Green)));\n" +
    "  GPoint.\n" +
    "end.\n";
end;

// The hidden members' sample (L9c): a descendant's method reaches its parent's hidden
// field through self and through a value of its own type, not through a value of the
// parent's type; outside the methods none is listed
func HiddenText(): string;
begin
  return
    "module exe lsp_completion_hidden;\n" +
    "\n" +
    "type\n" +
    "  Base = object\n" +
    "    hidden FBase: int32;\n" +
    "\n" +
    "    init();\n" +
    "    begin\n" +
    "      self.FBase := 1;\n" +
    "    end;\n" +
    "\n" +
    "    method Get(): int32;\n" +
    "    begin\n" +
    "      return self.FBase;\n" +
    "    end;\n" +
    "  end;\n" +
    "  Derived = object(Base)\n" +
    "    init();\n" +
    "    begin\n" +
    "      self.FBase := 2;\n" +
    "    end;\n" +
    "\n" +
    "    method Use(const AOther: ref Derived; const ABase: ref Base): int32;\n" +
    "    begin\n" +
    "      AOther.FBase := self.FBase;\n" +
    "      return ABase.Get();\n" +
    "    end;\n" +
    "  end;\n" +
    "\n" +
    "var\n" +
    "  GD: ref Derived;\n" +
    "  GB: ref Base;\n" +
    "\n" +
    "begin\n" +
    "  GD := ref Derived();\n" +
    "  GB := ref Base();\n" +
    "  println(\"{} {}\", GD.Use(GD, GB), GB.Get());\n" +
    "end.\n";
end;

// The 0-based character of the ANth (1-based) AWord on the 0-based line ALine of AText
// (ASCII: bytes and UTF-16 units alike)
func At(const AText: string; const ALine: int64; const AWord: string; const ANth: int64): int64;
var
  LLines: StringArray;
  LAt: int64;
  LI: int64;
begin
  LLines := SplitString(AText, "\n");
  LAt := -1;
  for LI := 1 to ANth do
    LAt := IndexOf(AWord, LLines[ALine], LAt + 1);
  end;
  return LAt;
end;

type
  // The client's side
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FTogether: BoolArray;

    // AParams as the params of a message (none when AParams has no key)
    method DoMessage(const AMethod: string; const AParams: JSON): JSON;
    var
      LMessage: JSON;
    begin
      LMessage.Add("jsonrpc", "2.0");
      LMessage.Add("method", AMethod);
      if AParams.Count() > 0 then
        LMessage.Add("params", AParams);
      end;
      return LMessage;
    end;

    // A request of AMethod with id AId, sent with the one before when ATogether
    method Request(const AId: int64; const AMethod: string; const AParams: JSON;
      const ATogether: bool);
    var
      LMessage: JSON;
    begin
      LMessage := self.DoMessage(AMethod, AParams);
      LMessage.Add("id", AId);
      self.Raw(LMessage.ToString(), ATogether);
    end;

    // A position request AMethod (AId) at ALine / ACharacter of AURI
    method At(const AId: int64; const AMethod: string; const AURI: string; const ALine: int64;
      const ACharacter: int64; const ATogether: bool);
    var
      LParams: JSON;
    begin
      LParams.BeginObject("textDocument");
      LParams.Add("uri", AURI);
      LParams.EndObject();
      LParams.BeginObject("position");
      LParams.Add("line", ALine);
      LParams.Add("character", ACharacter);
      LParams.EndObject();
      self.Request(AId, AMethod, LParams, ATogether);
    end;

    // A notification of AMethod
    method Notify(const AMethod: string; const AParams: JSON; const ATogether: bool);
    begin
      self.Raw(self.DoMessage(AMethod, AParams).ToString(), ATogether);
    end;

    // ABody framed
    method Raw(const ABody: string; const ATogether: bool);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FTogether, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FTogether[LCount] := ATogether;
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // The next message waits only when it was sent together with the one before
    override method HasPending(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FStarts) - 1 do
        if self.FStarts[LI] >= self.FAt then
          return self.FTogether[LI];
        end;
      end;
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // One message the server wrote, short
    method Print(const ABody: string);
    var
      LMessage: JSON;
      LItems: array of JSON;
      LI: int64;
      LMethod: string;
      LText: string;
    begin
      LMessage := JSON.FromString(ABody);
      if not LMessage.Has("method") then
        if LMessage.Has("error") then
          println("<- {} error {}: {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("error.code").AsInt64(), LMessage.Get("error.message").AsString());
          return;
        end;
        if LMessage.Get("result").IsNull() then
          println("<- {} null", LMessage.Get("id").AsInt64());
          return;
        end;
        if LMessage.Has("result.capabilities") then
          println("<- {} result triggers {} {}", LMessage.Get("id").AsInt64(),
            LMessage.Get("result.capabilities.completionProvider.triggerCharacters").Items()[0].AsString(),
            LMessage.Get("result.capabilities.completionProvider.triggerCharacters").Items()[1].AsString());
          return;
        end;
        LItems := LMessage.Get("result.items").Items();
        println("<- {} {} items", LMessage.Get("id").AsInt64(), len(LItems));
        for LI := 0 to len(LItems) - 1 do
          LText := "   " + IntToStr(LItems[LI].Get("kind").AsInt64()) + " " +
            LItems[LI].Get("label").AsString();
          if LItems[LI].Has("detail") then
            LText := LText + " [" + LItems[LI].Get("detail").AsString() + "]";
          end;
          if LItems[LI].Has("insertText") then
            LText := LText + " -> " + ReplaceStr(ReplaceStr(LItems[LI].Get("insertText").AsString(),
              "\n", "\\n"), "\t", "\\t");
          end;
          if LItems[LI].Has("insertTextFormat") then
            LText := LText + " (snippet)";
          end;
          println("{}", LText);
        end;
        return;
      end;
      LMethod := LMessage.Get("method").AsString();
      if LMethod = "textDocument/publishDiagnostics" then
        println("-> diagnostics v{}", LMessage.Get("params.version").AsInt64(-1));
        LItems := LMessage.Get("params.diagnostics").Items();
        for LI := 0 to len(LItems) - 1 do
          println("   {}:{} {} {}", LItems[LI].Get("range.start.line").AsInt64(),
            LItems[LI].Get("range.start.character").AsInt64(),
            LItems[LI].Get("code").AsString(""), LItems[LI].Get("message").AsString(""));
        end;
        return;
      end;
      println("-> {}", LMethod);
    end;
  end;

// textDocument/completion's params: AURI at ALine / ACharacter, ATrigger the trigger
// character ("": none)
func CompleteParams(const AURI: string; const ALine: int64; const ACharacter: int64;
  const ATrigger: string): JSON;
var
  LJSON: JSON;
begin
  LJSON.BeginObject("textDocument");
  LJSON.Add("uri", AURI);
  LJSON.EndObject();
  LJSON.BeginObject("position");
  LJSON.Add("line", ALine);
  LJSON.Add("character", ACharacter);
  LJSON.EndObject();
  if ATrigger <> "" then
    LJSON.BeginObject("context");
    LJSON.Add("triggerKind", 2);
    LJSON.Add("triggerCharacter", ATrigger);
    LJSON.EndObject();
  end;
  return LJSON;
end;

// didChange's params: AURI's whole text AText at version AVersion
func ChangeParams(const AURI: string; const AVersion: int64; const AText: string): JSON;
var
  LJSON: JSON;
begin
  LJSON.BeginObject("textDocument");
  LJSON.Add("uri", AURI);
  LJSON.Add("version", AVersion);
  LJSON.EndObject();
  LJSON.BeginArray("contentChanges");
  LJSON.BeginObject();
  LJSON.Add("text", AText);
  LJSON.EndObject();
  LJSON.EndArray();
  return LJSON;
end;

// didOpen's params: AURI with AText at version 1
func OpenParams(const AURI: string; const AText: string): JSON;
var
  LJSON: JSON;
begin
  LJSON.BeginObject("textDocument");
  LJSON.Add("uri", AURI);
  LJSON.Add("languageId", "adam");
  LJSON.Add("version", 1);
  LJSON.Add("text", AText);
  LJSON.EndObject();
  return LJSON;
end;

var
  GC: ref ScriptChannel;
  GNone: JSON;
  GPaths: StringArray;
  GURI: string;
  GText: string;
  GHiddenURI: string;
  GHidden: string;
  GCode: int32;

begin
  setlength(GPaths, 2);
  GPaths[0] := ResolvePath("$P:../../../../res/libs/std");
  GPaths[1] := ResolvePath("$P:../../../../res/runtime");
  GURI := "file:///" + ReplaceStr(ResolvePath("$P:lsp_completion_main.adam"), "\\", "/");
  GHiddenURI := "file:///" + ReplaceStr(ResolvePath("$P:lsp_completion_hidden.adam"), "\\", "/");
  GText := SampleText();
  GC := ref ScriptChannel();
  GC.Request(1, "initialize", GNone, false);
  GC.Notify("textDocument/didOpen", OpenParams(GURI, GText), false);
  GC.Request(2, "textDocument/completion", CompleteParams(GURI, 34, At(GText, 34, "LDouble", 1) + 3, ""), true);
  GC.Request(3, "textDocument/completion", CompleteParams(GURI, 46, At(GText, 46, "Twice", 1) + 3, ""), false);
  GC.Request(4, "textDocument/completion", CompleteParams(GURI, 46, At(GText, 46, "GPoint.", 1) + 7, "."), false);
  GC.Request(5, "textDocument/completion", CompleteParams(GURI, 45, At(GText, 45, "GCounter.", 1) + 9, "."), false);
  GC.Request(6, "textDocument/completion", CompleteParams(GURI, 21, At(GText, 21, "self.", 1) + 5, "."), false);
  GC.Request(7, "textDocument/completion", CompleteParams(GURI, 45, At(GText, 45, "Counter.", 2) + 8, "."), false);
  GC.Request(8, "textDocument/completion", CompleteParams(GURI, 51, At(GText, 51, "Color.", 1) + 6, "."), false);
  GC.Request(9, "textDocument/completion", CompleteParams(GURI, 47, At(GText, 47, "PerceivedVolume", 1) + 4, ""), false);
  GC.Request(10, "textDocument/completion", CompleteParams(GURI, 48, At(GText, 48, "while", 1) + 3, ""), false);
  GC.Request(11, "textDocument/completion", CompleteParams(GURI, 34, At(GText, 34, "doubled", 1) + 3, ""), false);
  GC.Request(12, "textDocument/completion", CompleteParams(GURI, 51, At(GText, 51, "{} {}", 1) + 1, ""), false);
  GC.Request(13, "textDocument/completion", CompleteParams(GURI, 48, At(GText, 48, ">", 1) + 1, ">"), false);
  GC.Notify("textDocument/didChange", ChangeParams(GURI, 2, TypedText()), false);
  GC.Request(14, "textDocument/completion", CompleteParams(GURI, 52, 9, "."), true);
  GC.Request(15, "textDocument/completion", CompleteParams("file:///nowhere/x.adam", 0, 0, ""), false);
  GC.Request(16, "textDocument/completion", GNone, false);
  GHidden := HiddenText();
  GC.Notify("textDocument/didOpen", OpenParams(GHiddenURI, GHidden), false);
  GC.Request(17, "textDocument/completion", CompleteParams(GHiddenURI, 24, At(GHidden, 24, "self.", 1) + 5, "."), true);
  GC.Request(18, "textDocument/completion", CompleteParams(GHiddenURI, 24, At(GHidden, 24, "AOther.", 1) + 7, "."), false);
  GC.Request(19, "textDocument/completion", CompleteParams(GHiddenURI, 25, At(GHidden, 25, "ABase.", 1) + 6, "."), false);
  GC.Request(20, "textDocument/completion", CompleteParams(GHiddenURI, 36, At(GHidden, 36, "GD.", 1) + 3, "."), false);
  GC.Request(90, "shutdown", GNone, false);
  GC.Notify("exit", GNone, false);
  GCode := RunLSP(ref ProtocolTransport(GC), GPaths);
  println("== exit {}", GCode);
end.
