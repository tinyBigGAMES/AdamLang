-------------------------------------------------------------------------------
  call_err_overload_linkage.adam - Break step of routine declarations
  (AUD4 5.5): a variadic routine shares its name with no other routine
  (SM0330, either order), a forward and its full declaration agree on the
  linkage (SM0306: cpplink against the default clink), and a routine value
  fills a routine type of its own linkage only (SM0200). clink written or
  not is one linkage (BNF sec 3 / 4): those pairs stay silent
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_overload_linkage;

routine Show(...); // ERROR SM0330@1
begin
  println("{}", varargs.count);
end;

routine Show(AN: int32);
begin
  println("{}", AN);
end;

routine Tell(AN: int32);
begin
  println("{}", AN);
end;

routine Tell(AS: string; ...); // ERROR SM0330@1
begin
  println("{}", AS);
end;

forward routine cpplink Pair(AN: int32);
routine Pair(AN: int32); // ERROR SM0306@1
begin
end;

forward routine clink Same(AN: int32);
routine Same(AN: int32);
begin
end;

routine Double(AN: int32): int32;
begin
  return AN * 2;
end;

var
  LC: routine clink(AN: int32): int32;
  LP: routine cpplink(AN: int32): int32;

begin
  LC := Double;
  LP := Double; // ERROR SM0200@9
end.
