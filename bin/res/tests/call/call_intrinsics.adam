-------------------------------------------------------------------------------
  call_intrinsics.adam - The intrinsics that need no string or object (M3.7e,
  BNF sec 7), each a call of its System.Runtime routine: getmem(N) a block of
  N bytes, written and read back through a typed pointer; resizemem(P, N)
  growing it with its contents kept, and resizemem(nil, N) allocating;
  freemem(P), and freemem(nil) doing nothing; paramcount() the arguments
  after the program's name (this row runs with three). Used as values, as
  statements and inside expressions.
*******************************************************************************/

/*
@@test
  kind run
  args "alpha" "beta" "gamma"
  exitcode 0
  | 3
  | 4
  | 10 20 30 40
  | 10 20 30 40 50 60 70 80
  | 7 8
  | 1
  | [Heap] Allocs: 2, Frees: 2, Leaked: 0
@@end
*/

module exe call_intrinsics;

routine puts(const AText: ptr): int32; external "ucrtbase";
routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine sprintf(const ABuffer: ptr; const AFormat: ptr to const char; ...): int32; external "msvcrt";

// AValue on a line of its own
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

routine Run();
var
  LBuf: array[0..127] of char;
  LInts: ptr to int32;
  LMore: ptr to int32;
  LTwo: ptr to int64;
  LI: int32;
begin
  // paramcount as a value and inside an expression
  ShowInt(int64(paramcount()));
  ShowInt(int64(paramcount() + 1));

  // getmem: four int32s written and read back
  LInts := ptr to int32(getmem(4 * size(int32)));
  for LI := 0 to 3 do
    LInts[LI] := (LI + 1) * 10;
  end;
  sprintf(addr of LBuf, ptr to const char("%d %d %d %d"), LInts[0], LInts[1], LInts[2], LInts[3]);
  puts(addr of LBuf);

  // resizemem: grown to eight, the first four kept
  LMore := ptr to int32(resizemem(LInts, 8 * size(int32)));
  for LI := 4 to 7 do
    LMore[LI] := (LI + 1) * 10;
  end;
  sprintf(addr of LBuf, ptr to const char("%d %d %d %d %d %d %d %d"), LMore[0], LMore[1], LMore[2],
    LMore[3], LMore[4], LMore[5], LMore[6], LMore[7]);
  puts(addr of LBuf);
  freemem(LMore);

  // resizemem of nil allocates
  LTwo := ptr to int64(resizemem(nil, 2 * size(int64)));
  LTwo[0] := 7;
  LTwo[1] := 8;
  sprintf(addr of LBuf, ptr to const char("%I64d %I64d"), LTwo[0], LTwo[1]);
  puts(addr of LBuf);
  freemem(LTwo);

  // freemem of nil does nothing
  freemem(nil);
  ShowInt(1);
end;

begin
  Run();
end.
