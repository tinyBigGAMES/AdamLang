-------------------------------------------------------------------------------
  call_closure_async.adam - async through a closure value (BNF sec 6 async,
  PLAN-RAVENAPI F2a): the task holds the closure (a holder of its own), so
  it runs after the variable that held it is cleared; the closure's capture
  is shared by the task's call. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | task 16
  | again 17
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_closure_async;

type
  Work = ref func(const AN: int64): int64;

func MakeWork(const AFactor: int64): Work;
var
  LCalls: int64;
begin
  return func(const AN: int64): int64
  begin
    LCalls := LCalls + 1;
    return AN * AFactor + LCalls;
  end;
end;

var
  GWork: Work;
  GKeep: Work;
  GTask: task int64;

begin
  GWork := MakeWork(3);
  GKeep := GWork;
  GTask := async GWork(5);
  GWork := nil;
  println("task {}", await GTask);
  println("again {}", GKeep(5));
  GTask := nil;
  GKeep := nil;
  println("end");
end.
