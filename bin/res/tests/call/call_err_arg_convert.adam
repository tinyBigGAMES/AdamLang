-------------------------------------------------------------------------------
  call_err_arg_convert.adam - Break step of calls (AUD5): an argument that
  does not convert to its parameter is SM0404 naming the argument and the
  callee (pcpp's report): a value the cast would take (the hint), a
  constant that does not fit, a routine value of another signature, a
  method another level's overload hides. The same values elsewhere (an
  assignment) stay SM0200.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_arg_convert;

type
  Fn = func(AN: int32): int32;

  Base = object
    method Put(const AN: int32);
    begin
      println("{}", AN);
    end;
  end;

  Derived = object(Base)
    method Put(const AText: string);
    begin
      println("{}", AText);
    end;
  end;

func Take8(AN: int8);
begin
  println("{}", AN);
end;

func Twice(AN: int32): int32;
begin
  return AN * 2;
end;

func Wide(AN: int64): int32;
begin
  return int32(AN);
end;

func Apply(const AFn: Fn; const AN: int32): int32;
begin
  return AFn(AN);
end;

var
  LBig: int32 = 300;
  LSmall: int8;
  LD: Derived;

begin
  Take8(LBig); // ERROR SM0404@9
  Take8(300); // ERROR SM0404@9
  println("{}", Apply(Twice, 1));
  println("{}", Apply(Wide, 1)); // ERROR SM0404@23
  LD.Put(5); // ERROR SM0404@10
  LSmall := LBig; // ERROR SM0200@13
end.
