/*
@@test
  kind error
@@end
*/

module exe call_err_keyword_name;

type
  object = int32; // ERROR PR0001@3: expected an identifier, found 'object'
  Pair = record
    var: int32; // ERROR PR0001@5: expected an identifier, found 'var'
    Second: int32;
  end;

const
  type: int32 = 1; // ERROR PR0001@3: expected an identifier, found 'type'
  Fine: int32 = 2;

var
  end: int32; // ERROR PR0001@3: expected an identifier, found 'end'
  Other: int32;

threadstatic
  module: int32; // ERROR PR0001@3: expected an identifier, found 'module'

func Show(const func: int32; const AN: int32): int32; // ERROR PR0001@17: expected an identifier, found 'func'
var
  while: int32; // ERROR PR0001@3: expected an identifier, found 'while'
begin
  var if: int32 = AN; // ERROR PR0001@7: expected an identifier, found 'if'
  return AN + Fine;
end;

func begin(): int32; // ERROR PR0001@6: expected an identifier, found 'begin'
begin
  return 0;
end;

begin
  Other := Show(1, 2);
end.
