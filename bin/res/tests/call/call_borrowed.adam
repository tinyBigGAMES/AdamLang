-------------------------------------------------------------------------------
  call_borrowed.adam - A const managed parameter passed by value is
  borrowed (SU2.8 e3): the callee adds no holder and releases none. An
  argument the callee could drop is held by the call instead, released as
  its statement ends. Holders shows a block's holders, read through its
  slot. A local, a chain of borrowed parameters and a call through a
  routine value add none (1); a value parameter keeps its own (2); a module
  variable, a local whose address is taken and a deref (the callee drops
  the variable through a pointer: SU2.8 e4 leaves out only a hold no
  callee can need, call_effects), a local passed to a
  var parameter of the same call and a field are held (2, or alive after
  the callee drops the variable: its done runs after the statement); a
  text and a dynamic array the callee drops live through the call; so do
  a method's self and an accessor's object whose holder the callee drops,
  the block a var parameter's element lies in, and the object a const
  parameter by reference (C++ linkage: it aliases the caller's field) lies
  in; a raise with a held argument leaks nothing (its hold ends at the
  routine's exit).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | local 1
  | value 2
  | chain 1
  | through a value 1
  | global 2
  | address 2
  | done 4
  | deref 2
  | done 6
  | var and const 9
  | done 9
  | field 5
  | done 5
  | text 77
  | done 3
  | dropped 1
  | drop 7
  | done 7
  | 4242!
  | array 55
  | self 11
  | done 11
  | accessor 13
  | done 13
  | var element 42
  | by reference 99
  | caught 8
  | done 8
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_borrowed;

import System.SysUtils;

// GBox set to nil (a Box's method and accessor drop the variable that holds it)
forward func DropBox();

type
  Box = object
    FValue: int64;

    done;
    begin
      println("done {}", self.FValue);
    end;

    // The module variable that holds it dropped: the call's hold keeps self alive
    method Vanish(): int64;
    begin
      DropBox();
      return self.FValue;
    end;

    property Gone: int64
      read
      begin
        DropBox();
        return self.FValue;
      end;
  end;

  Shelf = object
    FBox: ref Box;
  end;

  Holder = object
    FName: string;
    FCounts: array of int64;
  end;

  BoxRead = func(const ABox: ref Box): int64;

var
  GBox: ref Box;
  GText: string;
  GArr: array of int64;
  GHolder: ref Holder;
  GAt: ptr to ref Box;

func DropBox();
begin
  GBox := nil;
end;

// The holders of ABox's block, read through its slot (a block's first word)
func Holders(const ABox: ref Box): int64;
var
  LSlot: ptr to const ptr;
  LWords: ptr to int64;
begin
  LSlot := ptr to const ptr(addr of ABox);
  LWords := ptr to int64(LSlot^);
  return LWords[0];
end;

// A value parameter: its own holder
func Keep(ABox: ref Box): int64;
begin
  return Holders(ABox);
end;

// A borrowed parameter passed on: borrowed again
func Show(const ABox: ref Box): int64;
begin
  return Holders(ABox);
end;

// The var parameter's variable dropped: the const one still reads its object
func Swap(var ASlot: ref Box; const ABox: ref Box): int64;
begin
  ASlot := nil;
  return ABox.FValue;
end;

// The shelf's box dropped: the const one still reads it
func ClearShelf(const AShelf: ref Shelf; const ABox: ref Box): int64;
begin
  AShelf.FBox := nil;
  return ABox.FValue;
end;

func Echo(const AText: string): string;
begin
  return AText;
end;

// The module variable dropped: the call's hold keeps the object
func Drop(const ABox: ref Box): int64;
begin
  GBox := nil;
  println("dropped {}", Holders(ABox));
  return ABox.FValue;
end;

func DropText(const AText: string): string;
begin
  GText := "";
  return AText + "!";
end;

func DropArr(const AArr: array of int64): int64;
begin
  setlength(GArr, 0);
  return AArr[1];
end;

// The array a var parameter's element lies in dropped: the call holds the block
func Bump(var ACount: int64): int64;
begin
  setlength(GHolder.FCounts, 0);
  ACount := ACount + 1;
  return ACount;
end;

// A const parameter by reference (C++ linkage) aliases the caller's field: the object the
// field lies in dropped, the call holds its block, so the field still reads
func cpplink KeepName(const AText: string): string;
begin
  GHolder := nil;
  return AText;
end;

// The variable GAt points at dropped through the pointer: the call's hold keeps the object
func DropAt(const ABox: ref Box): int64;
var
  LCount: int64;
begin
  LCount := Holders(ABox);
  GAt^ := nil;
  return LCount + ABox.FValue - ABox.FValue;
end;

func Fail(const ABox: ref Box);
begin
  GBox := nil;
  raise(IntToStr(ABox.FValue));
end;

func Run();
var
  LMine: ref Box;
  LOther: ref Box;
  LAt: ptr to ref Box;
  LSwap: ref Box;
  LShelf: ref Shelf;
  LText: string;
  LRead: BoxRead;
begin
  LMine := ref Box();
  LMine.FValue := 3;
  println("local {}", Holders(LMine));
  println("value {}", Keep(LMine));
  println("chain {}", Show(LMine));
  LRead := Holders;
  println("through a value {}", LRead(LMine));
  println("global {}", LRead(GBox));
  LOther := ref Box();
  LOther.FValue := 4;
  GAt := addr of LOther;
  println("address {}", DropAt(LOther));
  LOther := ref Box();
  LOther.FValue := 6;
  LAt := addr of LOther;
  GAt := LAt;
  println("deref {}", DropAt(LAt^));
  LSwap := ref Box();
  LSwap.FValue := 9;
  println("var and const {}", Swap(LSwap, LSwap));
  LShelf := ref Shelf();
  LShelf.FBox := ref Box();
  LShelf.FBox.FValue := 5;
  println("field {}", ClearShelf(LShelf, LShelf.FBox));
  LText := IntToStr(77);
  println("text {}", Echo(LText));
end;

begin
  GBox := ref Box();
  GBox.FValue := 7;
  Run();
  println("drop {}", Drop(GBox));
  GText := IntToStr(4242);
  println("{}", DropText(GText));
  setlength(GArr, 3);
  GArr[1] := 55;
  println("array {}", DropArr(GArr));
  GBox := ref Box();
  GBox.FValue := 11;
  println("self {}", GBox.Vanish());
  GBox := ref Box();
  GBox.FValue := 13;
  println("accessor {}", GBox.Gone);
  GHolder := ref Holder();
  setlength(GHolder.FCounts, 3);
  GHolder.FCounts[1] := 41;
  println("var element {}", Bump(GHolder.FCounts[1]));
  GHolder.FName := IntToStr(99);
  println("by reference {}", KeepName(GHolder.FName));
  GBox := ref Box();
  GBox.FValue := 8;
  guard
    Fail(GBox);
  except
    println("caught {}", excmsg());
  end;
end.
