-------------------------------------------------------------------------------
  call_variadic_clink.adam - Adam clink variadic routines with a body
  (M3.7c). The routine stores its argument registers past its fixed
  parameters in their home places at entry, so varargs.next(T) walks one
  8-byte place per argument from the first one past the fixed parameters:
  in a loop (the cursor kept across blocks), with no extra argument, with
  one, three and four fixed parameters (the first variadic one in rdx, r9
  and on the stack), past a hidden result pointer (an aggregate result).
  Each type reads back as the caller promoted it: the narrow integers, a
  bool and a char from an int32, a float32 from a float64; int32 / uint32 /
  int64 / uint64 / ptr as they are; floats in register places (a variadic
  caller copied them into the integer register the routine homes) and on
  the stack. An aggregate of 1, 2, 4 or 8 bytes comes in its place, any
  other size (12, 3) as the address of the caller's copy, in registers and
  on the stack (M3.7b's caller side, read back here by Adam). Also called
  through a variadic routine value.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 6
  | 21
  | 0
  | 42
  | 0
  | -5 250 -300 60000 1 Q -7 4000000000
  | -9000000000 18000000000000000000 0.25 2.500 str
  | 1.5000 2.2500 3.1250 4.0625
  | 1 -2 | 3 4 5 | 10 20 30 | 7 8
  | 3 4 5
  | 11 22 33
  | 10056
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe call_variadic_clink;

func puts(const AText: ptr): int32; external "ucrtbase";
func malloc(const ASize: uint64): ptr; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
func sprintf(const ABuffer: ptr; const AFormat: ptr to const char; ...): int32; external "msvcrt";

type
  TPair = record
    A: int32;
    B: int32;
  end;

  TTriple = record
    A: int32;
    B: int32;
    C: int32;
  end;

  TRgb = record
    R: uint8;
    G: uint8;
    B: uint8;
  end;

  TSum = func(const ACount: int32; ...): int64;

// AValue on a line of its own
func ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// The ACount int32s after ACount, summed (the cursor moves on in a loop)
func SumInts(const ACount: int32; ...): int64;
var
  LSum: int64;
  LI: int32;
begin
  LSum := 0;
  for LI := 1 to ACount do
    LSum := LSum + int64(varargs.next(int32));
  end;
  return LSum;
end;

// One argument of each scalar kind read back and written into ABuffer, two lines
func Kinds(const ABuffer: ptr; ...);
var
  LI8: int8;
  LU8: uint8;
  LI16: int16;
  LU16: uint16;
  LB: bool;
  LC: char;
  LI32: int32;
  LU32: uint32;
  LI64: int64;
  LU64: uint64;
  LF32: float32;
  LF64: float64;
  LS: ptr to const char;
begin
  LI8 := varargs.next(int8);
  LU8 := varargs.next(uint8);
  LI16 := varargs.next(int16);
  LU16 := varargs.next(uint16);
  LB := varargs.next(bool);
  LC := varargs.next(char);
  LI32 := varargs.next(int32);
  LU32 := varargs.next(uint32);
  LI64 := varargs.next(int64);
  LU64 := varargs.next(uint64);
  LF32 := varargs.next(float32);
  LF64 := varargs.next(float64);
  LS := varargs.next(ptr to const char);
  sprintf(ABuffer, ptr to const char("%d %d %d %d %d %c %d %u"), LI8, LU8, LI16, LU16, LB, LC,
    LI32, LU32);
  puts(ABuffer);
  sprintf(ABuffer, ptr to const char("%I64d %I64u %.2f %.3f %s"), LI64, LU64, LF32, LF64, LS);
  puts(ABuffer);
end;

// Four float64s: three in the homed registers (rdx, r8, r9), one on the stack
func Floats(const ABuffer: ptr; ...);
var
  LA: float64;
  LB: float64;
  LC: float64;
  LD: float64;
begin
  LA := varargs.next(float64);
  LB := varargs.next(float64);
  LC := varargs.next(float64);
  LD := varargs.next(float64);
  sprintf(ABuffer, ptr to const char("%.4f %.4f %.4f %.4f"), LA, LB, LC, LD);
  puts(ABuffer);
end;

// Aggregates: a TPair in its place (rdx), a TTriple and a TRgb by the address of the
// caller's copy (r8, r9), a TPair on the stack
func Aggs(const ABuffer: ptr; ...);
var
  LP: TPair;
  LT: TTriple;
  LR: TRgb;
  LQ: TPair;
begin
  LP := varargs.next(TPair);
  LT := varargs.next(TTriple);
  LR := varargs.next(TRgb);
  LQ := varargs.next(TPair);
  sprintf(ABuffer, ptr to const char("%d %d | %d %d %d | %d %d %d | %d %d"), LP.A, LP.B, LT.A,
    LT.B, LT.C, LR.R, LR.G, LR.B, LQ.A, LQ.B);
  puts(ABuffer);
end;

// A hidden result pointer first: the variadic arguments start one place later
func MakeTriple(const AFirst: int32; ...): TTriple;
var
  LT: TTriple;
begin
  LT.A := AFirst;
  LT.B := varargs.next(int32);
  LT.C := varargs.next(int32);
  return LT;
end;

// Four fixed parameters: no register to home, the first variadic argument on the stack
func Four(const AA: int32; const AB: int32; const AC: int32; const AD: int32; ...): int64;
var
  LE: int32;
  LF: int64;
begin
  LE := varargs.next(int32);
  LF := varargs.next(int64);
  return int64(AA + AB + AC + AD) * 1000 + int64(LE) * 10 + LF;
end;

func Run();
var
  LBuf: array[0..127] of char;
  LSum: TSum;
  LI8: int8;
  LU8: uint8;
  LI16: int16;
  LU16: uint16;
  LI32: int32;
  LU32: uint32;
  LBig: int64;
  LHuge: uint64;
  LF32: float32;
  LF64: float64;
  LTriple: TTriple;
begin
  // A loop over the arguments, from 3 and from 6 (past the fourth place), and none
  ShowInt(SumInts(3, 1, 2, 3));
  ShowInt(SumInts(6, 1, 2, 3, 4, 5, 6));
  ShowInt(SumInts(0));

  // Through a variadic routine value
  LSum := SumInts;
  ShowInt(LSum(2, 40, 2));
  ShowInt(LSum(0));

  // Every scalar kind
  LI8 := -5;
  LU8 := 250;
  LI16 := -300;
  LU16 := 60000;
  LI32 := -7;
  LU32 := 4000000000u;
  LBig := -9000000000;
  LHuge := 18000000000000000000u;
  LF32 := 0.25;
  LF64 := 2.5;
  Kinds(addr of LBuf, LI8, LU8, LI16, LU16, true, 'Q', LI32, LU32, LBig, LHuge, LF32, LF64,
    ptr to const char("str"));

  // Floats in register places and on the stack
  Floats(addr of LBuf, 1.5, 2.25, 3.125, 4.0625);

  // Aggregates both ways
  LTriple := TTriple(A: 3, B: 4, C: 5);
  Aggs(addr of LBuf, TPair(A: 1, B: -2), LTriple, TRgb(R: 10, G: 20, B: 30), TPair(A: 7, B: 8));

  // The caller's copy was read, its own value is unchanged
  sprintf(addr of LBuf, ptr to const char("%d %d %d"), LTriple.A, LTriple.B, LTriple.C);
  puts(addr of LBuf);

  // Past a hidden result pointer
  LTriple := MakeTriple(11, 22, 33);
  sprintf(addr of LBuf, ptr to const char("%d %d %d"), LTriple.A, LTriple.B, LTriple.C);
  puts(addr of LBuf);

  // Four fixed parameters, the variadic ones on the stack
  ShowInt(Four(1, 2, 3, 4, 5, int64(6)));
end;

begin
  Run();
end.
