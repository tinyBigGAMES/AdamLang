-------------------------------------------------------------------------------
  call_err_literal_place.adam - Break step of `literal` parameters (BNF sec 4
  param, LX4f2): only a func or method declaration's own parameter may be
  literal (SM0769): never one of a func type, a closure type, a func
  literal or an external func (no call of those is one the build checks);
  a forward and its full declaration agree on the mode (SM0306)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_literal_place;

type
  Fn = func(literal AName: string); // ERROR SM0769@13
  Closure = ref func(literal AN: int32); // ERROR SM0769@22

func Ext(literal AName: ptr to const char): int32; external "c"; // ERROR SM0769@10

forward func Mode(const AN: int32);

func Mode(literal AN: int32); // ERROR SM0306@1
begin
  println("{}", AN);
end;

var
  LFn: Fn;
  LClosure: Closure;

begin
  LClosure := func(literal AN: int32) begin println("{}", AN); end; // ERROR SM0769@20
  Mode(1);
end.
