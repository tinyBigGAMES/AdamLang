-------------------------------------------------------------------------------
  call_values.adam - Routine values and calls through them (M3.7a). A
  routine named as a value is its code address (an external's, its import
  entry's value); a value is held in a local, a module variable (one with
  an initializer), a record field and an array element, passed as an
  argument and returned; compared with nil and with another value; called
  through each holder and through a call's result. Signatures through a
  value: a var parameter, a const aggregate under C linkage (a copy) and
  under C++ linkage (a reference), an aggregate result (the hidden
  pointer); an overloaded routine (C++ linkage) fills a cpplink slot; an
  external (ucrtbase labs) as a value; C calls an Adam routine back
  (ucrtbase qsort's comparator). Values are shown through ucrtbase
  (_i64toa + puts); a bool as 0 / 1.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 10
  | 15
  | 1
  | 0
  | 1
  | 1
  | 0
  | 9
  | 12
  | 42
  | 14
  | 21
  | -7
  | 16
  | 24
  | 8
  | 12
  | 42
  | 6
  | 12
  | 33
  | 133
  | 12
  | 1
  | 1
  | 3
  | 5
  | 9
  | [Adam Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe call_values;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine labs(const AN: int32): int32; external "ucrtbase";

type
  TFn = routine(const AN: int32): int32;
  TBump = routine(var AN: int32);

  // 12 bytes: under C linkage a const one is a copy, under C++ a reference; as a result
  // it comes back through the hidden pointer
  TTrip = record
    A: int32;
    B: int32;
    C: int32;
  end;

  TSum = routine(const AR: TTrip): int32;
  TMake = routine(const AN: int32): TTrip;
  TCppSum = routine cpplink(const AR: TTrip): int32;

  // C's qsort comparator
  TCompare = routine(const AA: ptr; const AB: ptr): int32;

  // A routine value as a field
  TOps = record
    Op: TFn;
    Bias: int32;
  end;

routine qsort(const ABase: ptr; const ACount: uint64; const ASize: uint64;
  const ACompare: TCompare); external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue as 1 or 0, one line
routine ShowBool(const AValue: bool);
begin
  if AValue then
    ShowInt(1);
  else
    ShowInt(0);
  end;
end;

routine Twice(const AN: int32): int32;
begin
  return AN * 2;
end;

routine Thrice(const AN: int32): int32;
begin
  return AN * 3;
end;

routine Negate(const AN: int32): int32;
begin
  return -AN;
end;

// AF called with AN (a routine value as a parameter)
routine Apply(const AF: TFn; const AN: int32): int32;
begin
  return AF(AN);
end;

// Twice for 0, else Thrice (a routine value as a result)
routine Pick(const AWhich: int32): TFn;
begin
  if AWhich = 0 then
    return Twice;
  end;
  return Thrice;
end;

routine Bump(var AN: int32);
begin
  AN := AN + 1;
end;

routine Sum3(const AR: TTrip): int32;
begin
  return AR.A + AR.B + AR.C;
end;

routine MakeTrip(const AN: int32): TTrip;
begin
  return TTrip(A: AN, B: AN + 1, C: AN + 2);
end;

routine cpplink SumCpp(const AR: TTrip): int32;
begin
  return AR.A + AR.B + AR.C;
end;

// Overloads: C++ linkage without the word (BNF sec 4); the TTrip one fills a cpplink slot
routine Over(const AR: TTrip): int32;
begin
  return AR.A + AR.B + AR.C + 100;
end;

routine Over(const AN: int64): int64;
begin
  return AN;
end;

// qsort's comparator over int32 elements: below 0, 0, above 0
routine CompareInt(const AA: ptr; const AB: ptr): int32;
var
  LA: ptr to int32;
  LB: ptr to int32;
begin
  LA := ptr to int32(AA);
  LB := ptr to int32(AB);
  if LA[0] < LB[0] then
    return -1;
  end;
  if LA[0] > LB[0] then
    return 1;
  end;
  return 0;
end;

var
  GFn: TFn;
  GInit: TFn = Twice;

routine Run();
var
  LF: TFn;
  LG: TFn;
  LOps: TOps;
  LTable: array[0..2] of TFn;
  LB: TBump;
  LS: TSum;
  LM: TMake;
  LC: TCppSum;
  LA: TFn;
  LTrip: TTrip;
  LX: int32;
  LSort: array[0..3] of int32;
  LI: int64;
begin
  // A local, assigned and called
  LF := Twice;
  ShowInt(LF(5));
  LF := Thrice;
  ShowInt(LF(5));

  // nil and equality
  LF := nil;
  ShowBool(LF = nil);
  LF := Twice;
  ShowBool(LF = nil);
  ShowBool(LF <> nil);
  ShowBool(LF = Twice);
  LG := Thrice;
  ShowBool(LF = LG);

  // Module variables: assigned, and one with an initializer
  GFn := Thrice;
  ShowInt(GFn(3));
  ShowInt(GInit(6));

  // A field and array elements
  LOps.Op := Twice;
  LOps.Bias := 0;
  ShowInt(LOps.Op(21));
  LTable[0] := Twice;
  LTable[1] := Thrice;
  LTable[2] := Negate;
  for LI := 0 to 2 do
    ShowInt(LTable[LI](7));
  end;

  // As an argument and as a result (a call's result called)
  ShowInt(Apply(Twice, 8));
  ShowInt(Apply(LG, 8));
  ShowInt(Pick(0)(4));
  ShowInt(Pick(1)(4));

  // A var parameter through a value
  LB := Bump;
  LX := 41;
  LB(LX);
  ShowInt(LX);

  // A const aggregate (C: a copy), an aggregate result (the hidden pointer)
  LTrip := TTrip(A: 1, B: 2, C: 3);
  LS := Sum3;
  ShowInt(LS(LTrip));
  LM := MakeTrip;
  LTrip := LM(10);
  ShowInt(LTrip.C);

  // C++ linkage through a value: a const aggregate by reference; an overload fills it
  LC := SumCpp;
  ShowInt(LC(LTrip));
  LC := Over;
  ShowInt(LC(LTrip));

  // An external as a value
  LA := labs;
  ShowInt(LA(-12));
  ShowBool(LA = labs);

  // C calls an Adam routine back
  LSort[0] := 5;
  LSort[1] := 3;
  LSort[2] := 9;
  LSort[3] := 1;
  qsort(addr of LSort, 4, 4, CompareInt);
  for LI := 0 to 3 do
    ShowInt(LSort[LI]);
  end;
end;

begin
  Run();
end.
