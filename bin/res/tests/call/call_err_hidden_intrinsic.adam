-------------------------------------------------------------------------------
  call_err_hidden_intrinsic.adam - Break step of names (AUD5): a routine
  named as an intrinsic (size) hides it in its module, so size(int32) calls
  the routine: the type there is SM0411 at it (pcpp's), not SM0269; a value
  argument calls the routine cleanly
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_hidden_intrinsic;

routine size(AN: int32): int32;
begin
  return AN;
end;

var
  LN: int32;

begin
  LN := size(3);
  LN := size(int32); // ERROR SM0411@14
end.
