-------------------------------------------------------------------------------
  call_err_intrinsic_arg_place.adam - Break step of intrinsics (AUD5): an
  intrinsic given the right number of arguments, one of the wrong type, is
  SM0409 at that argument (pcpp's place), the first that does not fit; the
  wrong count is SM0409 at the call; a constant div / mod by zero is SM0257
  at the zero
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_intrinsic_arg_place;

routine RaiseInt();
begin
  raise(5); // ERROR SM0409@9
end;

routine RaiseWideCode(const AN: int64);
begin
  raisecode(AN, "x"); // ERROR SM0409@13
end;

routine RaiseIntText();
begin
  raisecode(1, 2); // ERROR SM0409@16
end;

var
  LN: int64;
  LU: uint64;
  LA: array of int32;
  LP: ptr;
  LS: string;

begin
  LU := 2;
  LN := len(5); // ERROR SM0409@13
  LP := getmem("x"); // ERROR SM0409@16
  LS := paramstr("x"); // ERROR SM0409@18
  LN := len(LS, LS); // ERROR SM0409@9
  setlength(LN, 3); // ERROR SM0409@13
  setlength(LA, LU); // ERROR SM0409@17
  LN := 5 div 0; // ERROR SM0257@15
  LN := 7 mod (2 - 2); // ERROR SM0257@15
end.
