-------------------------------------------------------------------------------
  call_effects.adam - A borrowed argument the callee could drop is held by
  the call (SU2.8 e3), unless the callee's write summary proves it cannot
  (SU2.8 e4): what it may write (fields, module variables, var parameters'
  targets), through every routine it runs, the done of an object it ends
  included. Holders shows a block's holders, read through its slot: 1 when
  the hold is left out, 2 when the call holds it. A module variable passed
  to a routine that writes nothing (1); a field the callee leaves alone
  beside one it writes (1) and the field it writes (2, its value read after
  the drop); a module variable a routine below writes (2) and one it does
  not (1); a var parameter's target written below (2) and a local there
  instead (1); the done of an object the callee ends writing the variable
  (2) and another one (1); a method's own field passed on to a routine that
  writes another field of its type (1) and the same field (2: the field is
  named, so the object the method runs on is never guessed at).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | untouched 1
  | other field 1
  | spare 21
  | same field 2
  | below 2
  | below other 1
  | var target 2
  | var other 1
  | done 2
  | done other 1
  | self field 1
  | self same field 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_effects;

import System.SysUtils;

// GTrap set to nil (a Trap's done)
forward func DropTrap();

type
  Box = object
    FValue: int64;
  end;

// A box passed on by a Keeper's method (writes GSpareKeeper's FOther, never its FBox)
forward func ClearSpare(const ABox: ref Box): int64;

type
  Shelf = object
    FBox: ref Box;
    FSpare: ref Box;
  end;

  // Its methods pass its own fields on (held through self)
  Keeper = object
    FBox: ref Box;
    FOther: ref Box;

    method UseBox(): int64;
    begin
      return ClearSpare(self.FBox);
    end;

    method UseOther(): int64;
    begin
      return ClearSpare(self.FOther);
    end;
  end;

  // Ending one drops GTrap
  Trap = object
    FTag: int64;

    done;
    begin
      DropTrap();
    end;
  end;

var
  GBox: ref Box;
  GKept: ref Box;
  GSlot: ref Box;
  GTarget: ref Box;
  GTrap: ref Box;
  GShelf: ref Shelf;
  GKeeper: ref Keeper;
  GSpareKeeper: ref Keeper;

func DropTrap();
begin
  GTrap := nil;
end;

// The holders of a box (below)
forward func Holders(const ABox: ref Box): int64;

func ClearSpare(const ABox: ref Box): int64;
var
  LCount: int64;
begin
  LCount := Holders(ABox);
  GSpareKeeper.FOther := nil;
  return LCount + ABox.FValue - ABox.FValue;
end;

// The holders of ABox's block, read through its slot (a block's first word)
func Holders(const ABox: ref Box): int64;
var
  LSlot: ptr to const ptr;
  LWords: ptr to int64;
begin
  LSlot := ptr to const ptr(addr of ABox);
  LWords := ptr to int64(LSlot^);
  return LWords[0];
end;

// Writes nothing
func Look(const ABox: ref Box): int64;
begin
  return Holders(ABox);
end;

// Writes a shelf's FSpare, never its FBox; ABox still read after the write
func Restock(const AShelf: ref Shelf; const ABox: ref Box): int64;
var
  LCount: int64;
begin
  LCount := Holders(ABox);
  AShelf.FSpare := nil;
  if ABox.FValue = 21 then
    println("spare {}", ABox.FValue);
  end;
  return LCount;
end;

// Writes GSlot
func Clear();
begin
  GSlot := nil;
end;

// Writes GSlot through the routine it calls
func Deeper(const ABox: ref Box): int64;
var
  LCount: int64;
begin
  LCount := Holders(ABox);
  Clear();
  return LCount;
end;

// Writes its var parameter's target
func Wipe(var ASlot: ref Box);
begin
  ASlot := nil;
end;

// Writes its var parameter's target through the routine it calls
func Pass(var ASlot: ref Box; const ABox: ref Box): int64;
var
  LCount: int64;
begin
  LCount := Holders(ABox);
  Wipe(ASlot);
  return LCount + ABox.FValue - ABox.FValue;
end;

// Ends a Trap (its done writes GTrap)
func Spring(const ABox: ref Box): int64;
var
  LCount: int64;
  LTrap: ref Trap;
begin
  LCount := Holders(ABox);
  LTrap := ref Trap();
  LTrap := nil;
  return LCount + ABox.FValue - ABox.FValue;
end;

func Run();
var
  LLocal: ref Box;
begin
  GBox := ref Box();
  GKept := ref Box();
  println("untouched {}", Look(GBox));
  GShelf := ref Shelf();
  GShelf.FBox := ref Box();
  GShelf.FSpare := ref Box();
  GShelf.FSpare.FValue := 21;
  println("other field {}", Restock(GShelf, GShelf.FBox));
  GShelf.FSpare := ref Box();
  GShelf.FSpare.FValue := 21;
  println("same field {}", Restock(GShelf, GShelf.FSpare));
  GSlot := ref Box();
  println("below {}", Deeper(GSlot));
  println("below other {}", Deeper(GKept));
  GTarget := ref Box();
  println("var target {}", Pass(GTarget, GTarget));
  LLocal := ref Box();
  println("var other {}", Pass(LLocal, GKept));
  GTrap := ref Box();
  println("done {}", Spring(GTrap));
  println("done other {}", Spring(GKept));
  GKeeper := ref Keeper();
  GKeeper.FBox := ref Box();
  GKeeper.FOther := ref Box();
  GSpareKeeper := GKeeper;
  println("self field {}", GKeeper.UseBox());
  GKeeper.FOther := ref Box();
  println("self same field {}", GKeeper.UseOther());
end;

begin
  Run();
end.
