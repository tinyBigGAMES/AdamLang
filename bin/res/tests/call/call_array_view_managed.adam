-------------------------------------------------------------------------------
  call_array_view_managed.adam - `const array of T` views over managed
  elements (BNF sec 6, AS2): a routine that stores its view, returns it or
  compares it takes it as an array value at its entry, a static array's
  strings then copied (each one more holder), so the caller's later change
  is not seen; a dynamic array's block is shared, not copied. A view read
  where it lies holds nothing. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | joined a1b2c3
  | kept a1b2c3 now Zb2c3
  | back a1b2c3
  | same true
  | shared a1b2c3 len 3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_array_view_managed;

import System.SysUtils;

type
  Names = array[0..2] of string;

var
  GNames: Names;
  GKept: array of string;
  GDyn: array of string;
  GBack: array of string;

func Join(const AItems: array of string): string;
var
  LText: string;
  LItem: string;
begin
  LText := "";
  for LItem in AItems do
    LText := LText + LItem;
  end;
  return LText;
end;

func Keep(const AItems: array of string);
begin
  GKept := AItems;
end;

func Back(const AItems: array of string): array of string;
begin
  return AItems;
end;

func Same(const AItems: array of string; const AOther: array of string): bool;
begin
  return AItems = AOther;
end;

func Build(const APrefix: string; const AN: int64): string;
begin
  return APrefix + IntToStr(AN);
end;

begin
  GNames[0] := Build("a", 1);
  GNames[1] := Build("b", 2);
  GNames[2] := Build("c", 3);
  println("joined {}", Join(GNames));
  Keep(GNames);
  GNames[0] := "Z";
  println("kept {} now {}", Join(GKept), Join(GNames));
  GNames[0] := Build("a", 1);
  GBack := Back(GNames);
  println("back {}", Join(GBack));
  println("same {}", Same(GNames, GBack));
  setlength(GDyn, 3);
  GDyn[0] := Build("a", 1);
  GDyn[1] := Build("b", 2);
  GDyn[2] := Build("c", 3);
  Keep(GDyn);
  println("shared {} len {}", Join(GKept), len(GKept));
  setlength(GKept, 0);
  setlength(GDyn, 0);
  setlength(GBack, 0);
  GNames[0] := "";
  GNames[1] := "";
  GNames[2] := "";
end.
