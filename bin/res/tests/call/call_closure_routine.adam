-------------------------------------------------------------------------------
  call_closure_routine.adam - routines as closures (BNF sec 4 closure type,
  PLAN-RAVENAPI F2a): a routine named as a value is a closure through a
  static adapter (nothing built at run time), as an argument too; a cpplink
  one takes its const string by reference (the adapter passes it on); a
  routine value's closure keeps the code it was made from; a generic routine
  named as a closure takes its type arguments from the closure type; a
  captureless func literal fits a plain func slot and a func cpplink one.
  Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | add 5
  | run 9
  | shout hey!
  | value 30
  | max 9
  | plain 42
  | cpp 5
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_closure_routine;

type
  BinOp = ref func(const A: int64; const B: int64): int64;
  TextFn = ref func(const A: string): string;
  PlainOp = func(const A: int64; const B: int64): int64;
  CppOp = func cpplink(const A: int64; const B: int64): int64;

func Add(const A: int64; const B: int64): int64;
begin
  return A + B;
end;

func cpplink Shout(const A: string): string;
begin
  return A + "!";
end;

func Max<T>(const A: T; const B: T): T;
begin
  if A > B then
    return A;
  end;
  return B;
end;

func Run(const AOp: BinOp; const A: int64; const B: int64): int64;
begin
  return AOp(A, B);
end;

var
  GOp: BinOp;
  GText: TextFn;
  GPlain: PlainOp;
  GCpp: CppOp;

begin
  GOp := Add;
  println("add {}", GOp(2, 3));
  println("run {}", Run(Add, 4, 5));
  GText := Shout;
  println("shout {}", GText("hey"));
  GPlain := Add;
  GOp := GPlain;
  GPlain := nil;
  println("value {}", GOp(10, 20));
  GOp := Max;
  println("max {}", GOp(3, 9));
  GPlain := func(const A: int64; const B: int64): int64
  begin
    return A * B;
  end;
  println("plain {}", GPlain(6, 7));
  GCpp := func(const A: int64; const B: int64): int64
  begin
    return A - B;
  end;
  println("cpp {}", GCpp(9, 4));
  GOp := nil;
  GText := nil;
end.
