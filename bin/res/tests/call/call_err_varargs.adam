-------------------------------------------------------------------------------
  call_err_varargs.adam - Break step of call_variadic_clink (M3.7c, BNF
  sec 4 and sec 6). varargs is read only inside a variadic routine (SM0417:
  in a routine that is not variadic, in the module's block); a clink
  variadic (no linkage word, or clink written) has only next, as a C caller
  passes no types or count (SM0418: count, get, reset, copy, kind); clist
  (the C va_list, PLAN-LINUX64 LX3d3c2b0) is a clink variadic's alone, a
  cpplink one's arguments being a typed pack (SM0434); a clink variadic with
  a body needs a fixed parameter before '...' (SM0325), an external one does
  not. next and clist in a clink variadic, and an external clink variadic
  without fixed parameters, are fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_varargs;

// An external one may have no fixed parameter
func printf(...): int32; external "msvcrt";

func NoFixed(...); // ERROR SM0325@14: 'NoFixed' has C linkage and a body: it needs a fixed parameter before '...' (C reads the extra arguments from the last fixed one)
begin
end;

func Plain(const AN: int32): int32;
begin
  return varargs.next(int32); // ERROR SM0417@10: varargs outside a variadic routine
end;

func PlainList(const AN: int32): ptr;
begin
  return varargs.clist(); // ERROR SM0417@10: varargs outside a variadic routine
end;

func Clink(const AN: int32; ...): int32;
var
  LV: int32;
  LP: ptr;
begin
  LV := varargs.next(int32);
  LP := varargs.clist();
  LV := varargs.count; // ERROR SM0418@9: varargs.count needs a cpplink variadic: a C caller passes no types or count
  LV := varargs.get(0, int32); // ERROR SM0418@9: varargs.get needs a cpplink variadic: a C caller passes no types or count
  varargs.reset(); // ERROR SM0418@3: varargs.reset needs a cpplink variadic: a C caller passes no types or count
  println("{}", varargs.kind(0)); // ERROR SM0418@17: varargs.kind needs a cpplink variadic: a C caller passes no types or count
  return LV;
end;

func clink ClinkWritten(const AN: int32; ...);
var
  LC: varargs;
begin
  LC := varargs.copy(); // ERROR SM0418@9: varargs.copy needs a cpplink variadic: a C caller passes no types or count
end;

func cpplink CppList(...): ptr;
begin
  return varargs.clist(); // ERROR SM0434@10: varargs.clist() needs a clink variadic: a cpplink variadic's arguments are a typed pack, not a C va_list
end;

begin
  varargs.next(int32); // ERROR SM0417@3: varargs outside a variadic routine
end.
