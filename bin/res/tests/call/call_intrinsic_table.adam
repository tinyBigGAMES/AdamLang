-------------------------------------------------------------------------------
  call_intrinsic_table.adam - the intrinsics through the paths that read
  the Lexer's intrinsic table (IT1): each call dispatched by the Intrinsic
  its declaration keeps, never by its spelling. Value intrinsics (len of a
  string, a dynamic array and a static array, size and nameof of a type,
  nameof folded and at run time, FormatStr, utf8, hash, paramcount), the bit
  family folded and at run time, the atomic family (atomicstore the
  statement among them), the statements (setlength, getmem / resizemem /
  freemem, create / destroy, raise and raisecode with exccode / excmsg in
  the except part), and the asserts' runtime routine (testAssertTrue).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | len 4 3 4
  | size 4 8
  | nameof Green Hue Blue
  | format 7-x
  | utf8 3
  | hash true
  | params true
  | bits 13330 31 3 8
  | bits run 13330 31 3 8
  | atomic 1 3 true 9 9 4
  | memory 16 resized
  | record 5
  | raise 1 boom
  | raisecode 7 seven
  | assert ok
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_intrinsic_table;

type
  // A choices type nameof names, and its values
  Hue = choices(Red, Green, Blue);

  // A record create / destroy make and free on the heap
  Cell = record
    Value: int64;
  end;

const
  // The bit family folded (Folding: byteswap, leadingzeros, trailingzeros, popcount)
  KSwap: uint16 = byteswap(uint16(0x1234));
  KLead: int32 = leadingzeros(uint32(1));
  KTrail: int32 = trailingzeros(uint32(8));
  KPop: int32 = popcount(uint64(255));

var
  GText: string;
  GItems: array of int64;
  GFour: array[0..3] of int32;
  GHue: Hue;
  GWide: wstring;
  GSwapIn: uint16;
  GLeadIn: uint32;
  GTrailIn: uint32;
  GPopIn: uint64;
  GCount: int64;
  GBlock: ptr;
  GCell: ptr to Cell;

begin
  // len of a managed string and dynamic array (setlength first), of a static array
  GText := "abcd";
  setlength(GItems, 3);
  println("len {} {} {}", len(GText), len(GItems), len(GFour));

  // size and nameof take a type argument (the Parser's TypeArgument path)
  println("size {} {}", size(int32), size(int64));
  GHue := Hue.Blue;
  println("nameof {} {} {}", nameof(Hue.Green), nameof(Hue), nameof(GHue));

  // FormatStr, utf8, hash, paramcount: value intrinsics, some run by the runtime
  println("format {}", FormatStr("{}-{}", 7, "x"));
  GWide := "abc";
  println("utf8 {}", len(utf8(GWide)));
  println("hash {}", hash(int64(42)) = hash(int64(42)));
  println("params {}", paramcount() >= 0);

  // The bit family, folded (the constants) and at run time (the variables)
  println("bits {} {} {} {}", KSwap, KLead, KTrail, KPop);
  GSwapIn := 0x1234;
  GLeadIn := 1;
  GTrailIn := 8;
  GPopIn := 255;
  println("bits run {} {} {} {}", byteswap(GSwapIn), leadingzeros(GLeadIn),
    trailingzeros(GTrailIn), popcount(GPopIn));

  // The atomic family: add (the old value), swap, cas, store (a statement), load
  GCount := 1;
  print("atomic {} ", atomicadd(GCount, 2));
  print("{} ", atomicswap(GCount, 7));
  print("{} ", atomiccas(GCount, 7, 9));
  print("{} ", GCount);
  print("{} ", atomicload(GCount));
  atomicstore(GCount, 4);
  println("{}", GCount);

  // getmem / resizemem / freemem, statements and values the runtime runs
  GBlock := getmem(16);
  print("memory 16 ");
  GBlock := resizemem(GBlock, 64);
  if GBlock <> nil then
    println("resized");
  end;
  freemem(GBlock);

  // create / destroy: a record on the heap
  create(GCell);
  GCell^.Value := 5;
  println("record {}", GCell^.Value);
  destroy(GCell);

  // raise and raisecode, their code and text read in the except part
  guard
    raise("boom");
  except
    println("raise {} {}", exccode(), excmsg());
  end;
  guard
    raisecode(7, "seven");
  except
    println("raisecode {} {}", exccode(), excmsg());
  end;

  // an assert: its runtime routine (TestAssertTrue) by the Assert family
  testAssertTrue(GCount = 4);
  println("assert ok");
end.
