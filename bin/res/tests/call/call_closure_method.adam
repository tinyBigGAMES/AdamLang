-------------------------------------------------------------------------------
  call_closure_method.adam - a method named as a value (BNF sec 4, PLAN-
  RAVENAPI F2b): a closure bound to its object, which it holds (the object
  lives on after its ref is gone); a virtual method dispatches when called;
  the overload of the closure's shape is taken; a const method; as an
  argument; through a ref interface's itable; through an own; self in a ref
  object's method; a nil ref raises code 3 where it is bound. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | bump 1 2
  | done c
  | dispatch 2
  | add 7
  | name d
  | twice 20
  | intf 13
  | done d
  | own 1
  | done o
  | panel 1 2
  | 3 access through a nil own / ref
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_closure_method;

type
  Getter = ref func(): int64;
  Namer = ref func(): string;
  Step = ref func(const AN: int64): int64;

  ICount = interface
    method Bump(): int64;
  end;

  Counter = object implements ICount
    N: int64;
    Label: string;

    init(const ALabel: string);
    begin
      self.Label := ALabel;
    end;

    done;
    begin
      println("done {}", self.Label);
    end;

    virtual method Bump(): int64;
    begin
      self.N := self.N + 1;
      return self.N;
    end;

    method Add(const AN: int64): int64;
    begin
      self.N := self.N + AN;
      return self.N;
    end;

    method Add(const AN: int64; const AM: int64): int64;
    begin
      self.N := self.N + AN * AM;
      return self.N;
    end;

    const method Name(): string;
    begin
      return self.Label;
    end;
  end;

  Double = object(Counter)
    init(const ALabel: string);
    begin
      parent.init(ALabel);
    end;

    override method Bump(): int64;
    begin
      self.N := self.N + 2;
      return self.N;
    end;
  end;

  Panel = ref object
    Hits: int64;

    method Hit(): int64;
    begin
      self.Hits := self.Hits + 1;
      return self.Hits;
    end;

    method Handler(): Getter;
    begin
      return self.Hit;
    end;
  end;

func Twice(const AGet: Getter): int64;
begin
  return AGet() + AGet();
end;

var
  GC: ref Counter;
  GD: ref Counter;
  GO: own Counter;
  GI: ref ICount;
  GP: ref Panel;
  GNone: ref Counter;
  GGet: Getter;
  GStep: Step;
  GName: Namer;

begin
  GC := ref Counter("c");
  GGet := GC.Bump;
  GC := nil;
  println("bump {} {}", GGet(), GGet());
  GGet := nil;
  GD := ref Double("d");
  GGet := GD.Bump;
  println("dispatch {}", GGet());
  GStep := GD.Add;
  println("add {}", GStep(5));
  GName := GD.Name;
  println("name {}", GName());
  println("twice {}", Twice(GD.Bump));
  GI := GD;
  GGet := GI.Bump;
  println("intf {}", GGet());
  GD := nil;
  GI := nil;
  GStep := nil;
  GName := nil;
  GGet := nil;
  GO := own Counter("o");
  GGet := GO.Bump;
  println("own {}", GGet());
  GGet := nil;
  GO := nil;
  GP := ref Panel();
  GGet := GP.Handler();
  GP := nil;
  println("panel {} {}", GGet(), GGet());
  GGet := nil;
  guard
    GGet := GNone.Bump;
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("end");
end.
