  call_err_external_name.adam - Break step of call_external_name (M9e0a,
  BNF sec 3): an external clause's name "..." is a linker symbol's shape
  (PR0067): not empty, no blank, no control character (an empty one,
  one holding a blank).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_external_name;

routine A(): int32; external "ucrtbase" name ""; // ERROR PR0067@46: '' is not a symbol name: an external clause's name is the linker symbol, not empty, no blank or control character
routine B(): int32; external "ucrtbase" name "a b"; // ERROR PR0067@46: 'a b' is not a symbol name: an external clause's name is the linker symbol, not empty, no blank or control character

begin
end.
