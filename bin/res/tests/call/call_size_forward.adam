-------------------------------------------------------------------------------
  call_size_forward.adam - size(T) of a type declared `forward` first: the
  name resolves to the forward, whose full declaration gives the layout
  (Folding through Types.DeclaredTypeOf). Node: ptr 8 + int32 4 = 12,
  aligned to 8 = 16; Pair: an overlay of int64 and int32 = 8; a ptr to the
  forward type 8; arithmetic over the folded size (2 * 16 + 1 = 33).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | size Node 16
  | size Pair 8
  | size ptr to Node 8
  | twice Node + 1 33
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_size_forward;

import System.SysUtils;

forward type Node;
forward type Pair;

type
  Node = record
    Next: ptr to Node;
    Value: int32;
  end;

  Pair = overlay
    Wide: int64;
    Narrow: int32;
  end;

// ALabel and AValue on one line
func Show(const ALabel: string; const AValue: int64);
begin
  println("{}", ALabel + " " + IntToStr(AValue));
end;

begin
  Show("size Node", int64(size(Node)));
  Show("size Pair", int64(size(Pair)));
  Show("size ptr to Node", int64(size(ptr to Node)));
  Show("twice Node + 1", int64(2 * size(Node) + 1));
end.
