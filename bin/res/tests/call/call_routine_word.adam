-------------------------------------------------------------------------------
  call_routine_word.adam - the old spelling `routine` while PLAN-FUNC's
  bootstrap lasts (FN1..FN3): it reads as `func`, one keyword, so the two
  words mix in one module (a forward in one word, its full declaration in
  the other; a routine type in either).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 7 10
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_routine_word;

forward routine Twice(const AN: int32): int32;

type
  Unary = func(const AN: int32): int32;
  OldUnary = routine(const AN: int32): int32;

func Twice(const AN: int32): int32;
begin
  return AN * 2;
end;

routine Inc(const AN: int32): int32;
begin
  return AN + 1;
end;

var
  LNew: Unary;
  LOld: OldUnary;
begin
  LNew := Inc;
  LOld := Twice;
  println("{} {}", LNew(6), LOld(5));
end.
