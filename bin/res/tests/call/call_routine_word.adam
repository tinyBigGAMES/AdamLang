-------------------------------------------------------------------------------
  call_routine_word.adam - `routine` is no keyword (PLAN-FUNC FN4: `func`
  replaced it): the word is a plain identifier in every name place, here a
  func's name, a record field and a routine value's source.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 10 6
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_routine_word;

type
  Job = record
    routine: int32;
  end;

func routine(const AN: int32): int32;
begin
  return AN * 2;
end;

var
  GJob: Job;
  GDouble: func(const AN: int32): int32;
begin
  GJob.routine := 5;
  GDouble := routine;
  println("{} {}", routine(GJob.routine), GDouble(3));
end.
