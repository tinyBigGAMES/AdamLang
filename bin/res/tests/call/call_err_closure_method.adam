-------------------------------------------------------------------------------
  call_err_closure_method.adam - Break step of methods as values (BNF sec 4
  O13, PLAN-RAVENAPI F2b): a method bound to a value object (a local, a
  field's, through a ptr, a plain object's self) is SM0432 naming its
  object; one put in a plain func slot is SM0432 (no routine value).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_closure_method;

type
  Getter = ref func(): int64;
  Plain = func(): int64;

  Item = object
    N: int64;

    method Get(): int64;
    begin
      return self.N;
    end;

    method Wrong(): Getter;
    begin
      return self.Get; // ERROR SM0432@14
    end;
  end;

  Holder = object
    Inner: Item;
  end;

var
  GItem: Item;
  GRef: ref Item;
  GPtr: ptr to Item;
  GHold: ref Holder;
  GGet: Getter;
  GPlain: Plain;

begin
  GGet := GItem.Get; // ERROR SM0432@11
  GPlain := GRef.Get; // ERROR SM0432@13
  GGet := GPtr->Get; // ERROR SM0432@11
  GGet := GHold.Inner.Get; // ERROR SM0432@11
end.
