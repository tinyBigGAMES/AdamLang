-------------------------------------------------------------------------------
  call_variadic_c.adam - Calls of a C variadic routine (M3.7b). msvcrt's
  sprintf reads its variadic arguments from the home area its integer
  registers are spilled to, so a float there is passed in its xmm register
  and its integer one. The extra arguments take C's default promotions: a
  bool, an int8 / uint8 / int16 / uint16 and a char reach int32, a float32
  float64; int64 / uint64 and a C string as they are; floats in register
  slots and on the stack; a long mixed list; a call through a variadic
  routine value (its result too). Each buffer is shown with puts. The C
  strings: a string literal cast to (or given straight to) a ptr to const
  char is its bytes and a NUL, to a ptr to const wchar its UTF-16 units and
  a NUL unit (ucrtbase strlen / wcslen).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 7 -3
  | -5 250 -300 60000 1
  | -9000000000 18000000000000000000
  | 2.50 0.250
  | 1 2 3 4.5 5.5
  | hi!
  | A
  | 7 x 1.5 z 123456789012
  | 3
  | 2+3
  | 5
  | 7
  | [Adam Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe call_variadic_c;

routine puts(const AText: ptr): int32; external "ucrtbase";
routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine sprintf(const ABuffer: ptr; const AFormat: ptr to const char; ...): int32; external "msvcrt";
routine strlen(const AText: ptr to const char): uint64; external "ucrtbase";
routine wcslen(const AText: ptr to const wchar): uint64; external "ucrtbase";

type
  TSprintf = routine(const ABuffer: ptr; const AFormat: ptr to const char; ...): int32;

routine Run();
var
  LBuf: array[0..127] of char;
  LI8: int8;
  LU8: uint8;
  LI16: int16;
  LU16: uint16;
  LB: bool;
  LBig: int64;
  LHuge: uint64;
  LF64: float64;
  LF32: float32;
  LP: TSprintf;
  LCount: int32;
begin
  // Two int32s
  sprintf(addr of LBuf, ptr to const char("%d %d"), 7, -3);
  puts(addr of LBuf);

  // The narrow integers and a bool promoted to int32
  LI8 := -5;
  LU8 := 250;
  LI16 := -300;
  LU16 := 60000;
  LB := true;
  sprintf(addr of LBuf, ptr to const char("%d %d %d %d %d"), LI8, LU8, LI16, LU16, LB);
  puts(addr of LBuf);

  // int64 and uint64 as they are
  LBig := -9000000000;
  LHuge := 18000000000000000000u;
  sprintf(addr of LBuf, ptr to const char("%I64d %I64u"), LBig, LHuge);
  puts(addr of LBuf);

  // Floats in register slots (xmm2 + r8, xmm3 + r9), a float32 promoted
  LF64 := 2.5;
  LF32 := 0.25;
  sprintf(addr of LBuf, ptr to const char("%.2f %.3f"), LF64, LF32);
  puts(addr of LBuf);

  // Floats on the stack
  sprintf(addr of LBuf, ptr to const char("%d %d %d %.1f %.1f"), 1, 2, 3, 4.5, 5.5);
  puts(addr of LBuf);

  // A C string and a char
  sprintf(addr of LBuf, ptr to const char("%s!"), ptr to const char("hi"));
  puts(addr of LBuf);
  sprintf(addr of LBuf, ptr to const char("%c"), 'A');
  puts(addr of LBuf);

  // A long mixed list
  sprintf(addr of LBuf, ptr to const char("%d %s %.1f %c %I64d"), 7, ptr to const char("x"),
    1.5, 'z', 123456789012);
  puts(addr of LBuf);

  // Through a variadic routine value, its result too
  LP := sprintf;
  LCount := LP(addr of LBuf, ptr to const char("%d+%d"), 2, 3);
  puts(_i64toa(LCount, malloc(32), 10));
  puts(addr of LBuf);

  // A literal given straight to a ptr to const char; a wide one as UTF-16 units (an
  // emoji past 0xFFFF is a surrogate pair: h, é, l, l, o and two units)
  puts(_i64toa(int64(strlen("hello")), malloc(32), 10));
  puts(_i64toa(int64(wcslen("héllo😀")), malloc(32), 10));
end;

begin
  Run();
end.
