-------------------------------------------------------------------------------
  call_err_closure.adam - Break step of closures (PLAN-RAVENAPI F2a): a
  linkage on a closure type and a variadic func literal are SM0754; a func
  literal capturing a var parameter or a plain object's self is SM0755, one
  reading its routine's varargs SM0756; a capturing literal in a plain func
  slot is SM0757; two closures compare only against nil (SM0250).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_closure;

type
  Bad = ref func cpplink(); // ERROR SM0754@13
  Fine = ref func(const A: int64): int64;
  Plain = func(const A: int64): int64;

  Item = object
    V: int64;

    method Make(): Fine;
    begin
      return func(const A: int64): int64
      begin
        return self.V + A; // ERROR SM0755@16
      end;
    end;
  end;

func Bump(var AN: int64): Fine;
begin
  return func(const A: int64): int64
  begin
    return AN + A; // ERROR SM0755@12
  end;
end;

func Spread(const ACount: int32; ...): Fine;
begin
  return func(const A: int64): int64
  begin
    return A + int64(varargs.next(int32)); // ERROR SM0756@22
  end;
end;

func Slot(): int64;
var
  LK: int64;
  LP: Plain;
begin
  LK := 3;
  LP := func(const A: int64): int64 // ERROR SM0757@9
  begin
    return A + LK;
  end;
  return LP(1);
end;

var
  GOne: Fine;
  GTwo: Fine;
  GSpread: Fine;

begin
  GSpread := func(const A: int64; ...): int64 // ERROR SM0754@14
  begin
    return A;
  end;
  if GOne = GTwo then // ERROR SM0250@6
    println("same");
  end;
end.
