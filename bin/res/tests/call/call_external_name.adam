-------------------------------------------------------------------------------
  call_external_name.adam - an external clause's name "..." (M9e0a, BNF
  sec 3, his OK 2026-11-16): a routine binds the C symbol it names under
  another Adam name, with a library string, a library constant (name is a
  context word: `external name name "abs"`) or no library (its own symbol); `external
  name;` still names the library constant called name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 5 6
  | 7 9
  | 3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_external_name;

import System.SysUtils;

const
  // a library constant named name: `external name name "..."` reads it as the library
  name: string = "ucrtbase";

// Adam names that are not C's: each binds the symbol its name "..." gives
func CLength(const AText: ptr to const char): uint64; external "ucrtbase" name "strlen";
func CAbs(const AN: int32): int32; external name name "abs";
// no library named: the program's own objects resolve it (Twice's public C symbol)
public func clink Twice(const AN: int32): int32;
begin
  return AN * 2;
end;

func Doubled(const AN: int32): int32; external name "Twice";
// `external name;` still names the library constant name, the symbol the Adam name
func strlen(const AText: ptr to const char): uint64; external name;

var
  LText: ptr to char;
  LSix: ptr to char;
begin
  LText := StringToC("hello");
  LSix := StringToC("abcdef");
  println("{} {}", CLength(LText), strlen(LSix));
  freemem(LText);
  freemem(LSix);
  println("{} {}", CAbs(-7), Doubled(-9) + 27);
  println("{}", CAbs(3));
end.
