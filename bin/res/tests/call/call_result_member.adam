-------------------------------------------------------------------------------
  call_result_member.adam - A field read of a call's result (PLAN-SELFHOST
  S4, BNF sec 6): a record returned by a routine and by a method, then one
  of its fields read (a choice, an integer, a text, a field of a nested
  record), through parentheses, in a condition beside a bool as Adam's own
  folder does (`self.DoConstOf(ALeft).Kind = ConstKind.String`), twice in
  one expression and in loops (the result slot used again each pass, a
  text field released each time: the heap report balances).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 7
  | 42
  | 42
  | routine text
  | blue
  | 12
  | 30
  | green
  | green yes
  | blue no
  | flag no
  | 50
  | 60
  | other
  | green
  | other
  | green!
  | other?
  | green?
  | other?
  | [Heap] Allocs: 4, Frees: 4, Leaked: 0
@@end
*/

module exe call_result_member;

routine puts(const AText: ptr): int32; external "ucrtbase";
routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  Shade = choices(Red, Green, Blue);

  TInner = record
    X: int64;
  end;

  TValue = record
    Kind: Shade;
    Bits: uint64;
    Text: string;
    Inner: TInner;
  end;

  TFolder = object
    Base: int64;

    // The value at AAt: Red at 0, Green at 1, Blue past it; its text the shade's
    // ("green" or "other"); Bits Base + AAt, Inner.X Base * AAt
    const method ValueOf(const AAt: int64): TValue;
    var
      LValue: TValue;
    begin
      if AAt = 0 then
        LValue.Kind := Shade.Red;
      else
        if AAt = 1 then
          LValue.Kind := Shade.Green;
        else
          LValue.Kind := Shade.Blue;
        end;
      end;
      if LValue.Kind = Shade.Green then
        LValue.Text := "green";
      else
        LValue.Text := "other";
      end;
      LValue.Bits := uint64(self.Base + AAt);
      LValue.Inner.X := self.Base * AAt;
      return LValue;
    end;

    // The folder's form: a field of the method's own result, beside a bool
    const method IsGreen(const AFlag: bool; const AAt: int64): bool;
    begin
      return AFlag and (self.ValueOf(AAt).Kind = Shade.Green);
    end;
  end;

// AValue on a line of its own
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// A Blue value holding AText, Bits 7, Inner.X 42
routine MakeValue(const AText: string): TValue;
var
  LValue: TValue;
begin
  LValue.Kind := Shade.Blue;
  LValue.Bits := 7;
  LValue.Text := AText;
  LValue.Inner.X := 42;
  return LValue;
end;

routine Run();
var
  LFolder: TFolder;
  LTotal: int64;
  LI: int64;
begin
  // a routine's result: an integer, a nested record's field, through parentheses, a text
  ShowInt(int64(MakeValue("a").Bits));
  ShowInt(MakeValue("b").Inner.X);
  ShowInt((MakeValue("c")).Inner.X);
  println("{}", MakeValue("routine text").Text);
  if MakeValue("d").Kind = Shade.Blue then
    println("blue");
  end;

  // a method's result
  LFolder.Base := 10;
  ShowInt(int64(LFolder.ValueOf(2).Bits));
  ShowInt(LFolder.ValueOf(3).Inner.X);
  println("{}", LFolder.ValueOf(1).Text);

  // beside a bool, both ways
  if LFolder.IsGreen(true, 1) then
    println("green yes");
  end;
  if not LFolder.IsGreen(true, 2) then
    println("blue no");
  end;
  if not LFolder.IsGreen(false, 1) then
    println("flag no");
  end;

  // two results in one expression
  ShowInt(LFolder.ValueOf(2).Inner.X + LFolder.ValueOf(3).Inner.X);

  // in loops: the result slot used again each pass
  LTotal := 0;
  for LI := 1 to 3 do
    LTotal := LTotal + LFolder.ValueOf(LI).Inner.X;
  end;
  ShowInt(LTotal);
  for LI := 0 to 2 do
    println("{}", LFolder.ValueOf(LI).Text);
  end;

  // a text field holding a heap block (a concatenation's), once and in a loop: each
  // result's hold on it released with its slot
  println("{}", MakeValue(LFolder.ValueOf(1).Text + "!").Text);
  for LI := 0 to 2 do
    println("{}", MakeValue(LFolder.ValueOf(LI).Text + "?").Text);
  end;
end;

begin
  Run();
end.
