-------------------------------------------------------------------------------
  call_func_keyword.adam - the keyword `func` (PLAN-FUNC, his word
  2026-11-23, BNF sec 3 / 4): a routine declared, forwarded, typed (a named
  routine type, a field, a parameter), public clink / cpplink, external,
  generic and noreturn, every form spelled with `func`.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 5 101 11
  | 8 12 7
  | 9 -4
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_func_keyword;

// a forward names the routine before its full declaration
forward func Later(const AN: int32): int32;

type
  // a named routine type, and one written as a field's type
  Op = func(const AA: int32; const AB: int32): int32;
  Holder = record
    OnDone: func(const AN: int32): int32;
  end;

func Add(const AA: int32; const AB: int32): int32;
begin
  return AA + AB;
end;

func Later(const AN: int32): int32;
begin
  return AN + 100;
end;

// a routine type as a parameter's type
func Apply(const AOp: func(const AA: int32; const AB: int32): int32; const AN: int32): int32;
begin
  return AOp(AN, AN + 1);
end;

public func clink CTwice(const AN: int32): int32;
begin
  return AN * 2;
end;

public func cpplink CppThrice(const AN: int32): int32;
begin
  return AN * 3;
end;

func CAbs(const AN: int32): int32; external "ucrtbase" name "abs";

func Max<T>(const A: T; const B: T): T;
begin
  if A > B then
    return A;
  end;
  return B;
end;

func Stop(const ACode: int32); noreturn;
begin
  Halt(ACode);
end;

var
  LOp: Op;
  LHolder: Holder;
begin
  LOp := Add;
  LHolder.OnDone := Later;
  println("{} {} {}", LOp(2, 3), LHolder.OnDone(1), Apply(Add, 5));
  println("{} {} {}", CTwice(4), CppThrice(4), CAbs(-7));
  println("{} {}", Max<int32>(3, 9), Max<int64>(-4, -8));
  if LOp(1, 1) = 5 then
    Stop(3);
  end;
end.
