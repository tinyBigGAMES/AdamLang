-------------------------------------------------------------------------------
  call_variadic_ctext.adam - CV1 (BNF sec 6, his OK 2026-11-24): a string
  or wstring in a C variadic's '...' travels as its C text, as F3 borrows
  one for a ptr to const char / wchar parameter: a literal and a constant
  as their static C string, a local, a module variable (held through the
  call), a concatenation's and a call's temporaries, the empty text; a
  wstring as C's wchar_t text (a UTF-32 copy on x86_64-linux-gnu). C's
  snprintf formats them beside ints and floats; an Adam clink variadic
  reads one with next(ptr to const char). The same lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | [lit] [konst]
  | [var7] [glob]
  | [var7!] [made]
  | [] [7 var7 1.5]
  | [wide]
  | echo var7 lit
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_variadic_ctext;

import System.SysUtils;

@ifdef TARGET_X86_64_LINUX_GNU
func snprintf(const ABuffer: ptr; const ASize: uint64; const AFormat: ptr to const char; ...): int32;
  external "c";
@else
func snprintf(const ABuffer: ptr; const ASize: uint64; const AFormat: ptr to const char; ...): int32;
  external "msvcrt" name "_snprintf";
@endif

type
  TextBuffer = array[0..255] of char;

const
  KONST: string = "konst";

var
  GText: string;
  GBuffer: TextBuffer;

// The text snprintf left in GBuffer
func Formatted(): string;
begin
  return StringFromC(addr of GBuffer[0]);
end;

// A string from a call: a temporary of its own
func Made(): string;
begin
  return "ma" + "de";
end;

// An Adam clink variadic: a C caller's string is its C text
func Echo(const ACount: int32; ...): string;
var
  LResult: string;
  LI: int32;
begin
  LResult := "echo";
  for LI := 1 to ACount do
    LResult := LResult + " " + StringFromC(varargs.next(ptr to const char));
  end;
  return LResult;
end;

var
  LName: string;
  LEmpty: string;
  LWide: wstring;
  LLine: string;

begin
  LName := "var" + IntToStr(7);
  LEmpty := "";
  GText := "gl" + "ob";
  LWide := "wide";
  snprintf(addr of GBuffer[0], 256, "[%s] [%s]", "lit", KONST);
  println(Formatted());
  snprintf(addr of GBuffer[0], 256, "[%s] [%s]", LName, GText);
  println(Formatted());
  snprintf(addr of GBuffer[0], 256, "[%s] [%s]", LName + "!", Made());
  println(Formatted());
  snprintf(addr of GBuffer[0], 256, "[%s] [%d %s %.1f]", LEmpty, 7, LName, 1.5);
  println(Formatted());
  snprintf(addr of GBuffer[0], 256, "[%ls]", LWide);
  println(Formatted());
  LLine := Echo(2, LName, "lit");
  println(LLine);
end.
