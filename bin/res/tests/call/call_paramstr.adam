-------------------------------------------------------------------------------
  call_paramstr.adam - paramstr(N) (PLAN-SELFHOST S4, BNF sec 7), a call of
  System.Runtime's ParamStr: argument N as a new string the caller holds
  (released at the frame's exit, so the heap report balances). This row runs
  with three arguments, the last one empty: each read by a constant index,
  the empty one and the indexes outside the list (past the end, negative)
  giving "", index 0 the exe's own name; read in a loop through a variable
  as Adam's own command line reader does, used inside a concatenation, and
  read past the end through a variable.
*******************************************************************************/

/*
@@test
  kind run
  args "alpha" "beta two" ""
  exitcode 0
  | [alpha]
  | [beta two]
  | []
  | []
  | []
  | named
  | []
  | 13
  | [alpha/beta two]
  | []
  | [Heap] Allocs: 9, Frees: 9, Leaked: 0
@@end
*/

module exe call_paramstr;

routine puts(const AText: ptr): int32; external "ucrtbase";
routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

// AValue on a line of its own
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AText between brackets on a line of its own (an empty text shows as [])
routine Show(const AText: string);
begin
  println("[{}]", AText);
end;

routine Run();
var
  LIndex: int32;
  LArg: string;
  LJoined: string;
  LTotal: int64;
begin
  // each argument by a constant index, the empty one, one past the end, a negative one
  Show(paramstr(1));
  Show(paramstr(2));
  Show(paramstr(3));
  Show(paramstr(4));
  Show(paramstr(-1));

  // index 0: the exe's own name
  if len(paramstr(0)) > 0 then
    println("named");
  end;

  // as the command line reader walks the arguments: each read through a variable
  LIndex := 1;
  LTotal := 0;
  while LIndex <= paramcount() do
    LArg := paramstr(LIndex);
    LTotal := LTotal + int64(len(LArg));
    if LIndex = paramcount() then
      Show(LArg);
    end;
    LIndex := LIndex + 1;
  end;
  ShowInt(LTotal);

  // inside a concatenation, one index computed
  LJoined := paramstr(1) + "/" + paramstr(LIndex - 2);
  Show(LJoined);

  // the one after the last, through a variable
  Show(paramstr(LIndex));
end;

begin
  Run();
end.
