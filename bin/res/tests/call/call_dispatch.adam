-------------------------------------------------------------------------------
  call_dispatch.adam - A dispatched call and the release of a polymorphic
  object run only code in sight when no other module can extend the type
  (SU2.8 e5): the write summary of a dispatched method is its own code's and
  every override's below it, the release of a polymorphic object every
  descendant's done. Each case passes a module variable to a routine that
  counts its holders (read through its slot: 1 when the hold is left out, 2
  when the call holds it), then runs the method or the release. A virtual
  method whose override writes nothing (1); one whose override writes the
  variable passed (2) and another one (1); an abstract method whose
  override writes nothing (1); an override final one that writes nothing
  above a level that writes the variable (1); an inherited call (parent) of
  a method that writes it (2); a release of a base-typed object whose
  descendant's done writes the variable (2) and another one (1).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | quiet 1
  | override writes 2
  | override other 1
  | abstract 1
  | final 1
  | parent 2
  | poly done 2
  | poly other 1
  | area 9
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_dispatch;

import System.SysUtils;

type
  Box = object
    FValue: int64;
  end;

var
  GSlot: ref Box;
  GKept: ref Box;
  GTrap: ref Box;
  GArea: int64;

// The holders of ABox's block, read through its slot (a block's first word)
func Holders(const ABox: ref Box): int64;
var
  LSlot: ptr to const ptr;
  LWords: ptr to int64;
begin
  LSlot := ptr to const ptr(addr of ABox);
  LWords := ptr to int64(LSlot^);
  return LWords[0];
end;

type
  // Neither level writes anything
  Quiet = object
    virtual method Act();
    begin
    end;
  end;

  QuietMore = object(Quiet)
    override method Act();
    begin
      GArea := GArea + 0;
    end;
  end;

  // Its override writes GSlot
  Loud = object
    virtual method Act();
    begin
    end;
  end;

  LoudMore = object(Loud)
    override method Act();
    begin
      GSlot := nil;
    end;
  end;

  // Whose only body is its override's
  Shape = object
    virtual method Area(): int64; abstract;
  end;

  Square = object(Shape)
    FSide: int64;

    override method Area(): int64;
    begin
      return self.FSide * self.FSide;
    end;
  end;

  // Its override is final: no level below may change it
  Top = object
    virtual method Peek();
    begin
      GSlot := nil;
    end;
  end;

  Bottom = object(Top)
    override final method Peek();
    begin
    end;
  end;

  // An inherited call of LoudMore's method from a level below it
  LoudLeaf = object(LoudMore)
    override method Act();
    begin
    end;

    method Ask();
    begin
      parent.Act();
    end;
  end;

  // Ending a Cage may end a Tiger, whose done writes GTrap
  Cage = object
    FTag: int64;

    virtual method Tag(): int64;
    begin
      return self.FTag;
    end;
  end;

  Tiger = object(Cage)
    done;
    begin
      GTrap := nil;
    end;
  end;

func QuietProbe(const ABox: ref Box; const AObj: ref Quiet): int64;
var
  LCount: int64;
begin
  LCount := Holders(ABox);
  AObj.Act();
  return LCount;
end;

func LoudProbe(const ABox: ref Box; const AObj: ref Loud): int64;
var
  LCount: int64;
begin
  LCount := Holders(ABox);
  AObj.Act();
  return LCount;
end;

func ShapeProbe(const ABox: ref Box; const AObj: ref Shape): int64;
var
  LCount: int64;
begin
  LCount := Holders(ABox);
  GArea := AObj.Area();
  return LCount;
end;

func BottomProbe(const ABox: ref Box; const AObj: ref Bottom): int64;
var
  LCount: int64;
begin
  LCount := Holders(ABox);
  AObj.Peek();
  return LCount;
end;

func LeafProbe(const ABox: ref Box; const AObj: ref LoudLeaf): int64;
var
  LCount: int64;
begin
  LCount := Holders(ABox);
  AObj.Ask();
  return LCount;
end;

// Ends a base-typed object that is a Tiger
func Release(const ABox: ref Box): int64;
var
  LCount: int64;
  LCage: ref Cage;
begin
  LCount := Holders(ABox);
  LCage := ref Tiger();
  LCage := nil;
  return LCount + ABox.FValue - ABox.FValue;
end;

func Run();
var
  LSquare: ref Square;
begin
  GKept := ref Box();
  GSlot := ref Box();
  println("quiet {}", QuietProbe(GSlot, ref QuietMore()));
  println("override writes {}", LoudProbe(GSlot, ref LoudMore()));
  GSlot := ref Box();
  println("override other {}", LoudProbe(GKept, ref LoudMore()));
  GSlot := ref Box();
  LSquare := ref Square();
  LSquare.FSide := 3;
  println("abstract {}", ShapeProbe(GSlot, LSquare));
  println("final {}", BottomProbe(GSlot, ref Bottom()));
  println("parent {}", LeafProbe(GSlot, ref LoudLeaf()));
  GTrap := ref Box();
  println("poly done {}", Release(GTrap));
  println("poly other {}", Release(GKept));
  println("area {}", GArea);
end;

begin
  Run();
end.
