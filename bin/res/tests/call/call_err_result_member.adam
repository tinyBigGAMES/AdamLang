-------------------------------------------------------------------------------
  call_err_result_member.adam - Break step of call_result_member
  (PLAN-SELFHOST S4): a call's result is a value, not storage, so a field of
  it is never written: an assignment to it and a compound assignment
  (SM0255), a var argument of it (SM0405) are refused; reading it is fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_result_member;

type
  TValue = record
    Bits: int64;
  end;

routine MakeValue(): TValue;
var
  LValue: TValue;
begin
  LValue.Bits := 7;
  return LValue;
end;

routine Bump(var AValue: int64);
begin
  AValue := AValue + 1;
end;

routine Run();
var
  LBits: int64;
begin
  LBits := MakeValue().Bits;
  MakeValue().Bits := 1; // ERROR SM0255@3: 'MakeValue().Bits' cannot be assigned
  MakeValue().Bits += 1; // ERROR SM0255@3: 'MakeValue().Bits' cannot be assigned
  Bump(MakeValue().Bits); // ERROR SM0405@8: var parameter 'AValue' needs a variable of type 'int64'
end;

begin
  Run();
end.
