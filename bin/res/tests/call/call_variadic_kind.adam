-------------------------------------------------------------------------------
  call_variadic_kind.adam - varargs.kind(I) (M3.8h, BNF sec 6): a cpplink
  variadic asks what each argument is before it reads it, as a value of
  System.Runtime's VarKind. Every kind a pack carries, by the literal typing
  rule and by locals of each type; a run-time formatter that matches on the
  kind and reads each argument by get at its own type; kind of a varargs
  local (a copy). The pack's checks raise as pcpp's do: kind and get past
  the count or below 0 (code 9), get and next of another type (code 8, the
  cursor left where it was, so the next right read takes that argument).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0 Int8
  | 1 Int16
  | 2 Int32
  | 3 Int64
  | 4 UInt8
  | 5 UInt16
  | 6 UInt32
  | 7 UInt64
  | 8 CLong
  | 9 CULong
  | 10 Float32
  | 11 Float64
  | 12 Bool
  | 13 Char
  | 14 WChar
  | 15 String
  | 16 WString
  | 17 Ptr
  | 18 Pointer
  | 19 StaticArray
  | 20 DynamicArray
  | 21 Set
  | 22 Choices
  | 23 Record
  | 24 Routine
  | 25 Ref
  | show: i1 l5000000000 f2.5 stwo bfalse cz ?UInt8 ?Choices
  | none:
  | copy 3 Int32 String
  | copy next a
  | 9 varargs.kind: argument 2 does not exist (count 2)
  | 9 varargs.kind: argument -1 does not exist (count 2)
  | 9 varargs.get: argument 5 does not exist (count 2)
  | 8 varargs.get(int64): argument 1 is string
  | 8 varargs.next(string): argument 0 is int32
  | next 10
  | next eleven
  | 9 varargs.next: argument 2 does not exist (count 2)
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_variadic_kind;

import System.Runtime;

type
  TColor = choices(Red, Green);
  TColors = set of TColor;
  TAction = func();

  TPair = record
    A: int32;
    B: int32;
  end;

  TBox = object
    V: int32;
  end;

// Does nothing: a routine value's target
func Nothing();
begin
end;

// Each argument's index and kind, one line each
func cpplink Kinds(...);
var
  LI: int32;
begin
  for LI := 0 to varargs.count - 1 do
    println("{} {}", LI, varargs.kind(LI));
  end;
end;

// A run-time formatter: each argument written by its kind, read by get at its own type
func cpplink Show(const ATitle: string; ...): string;
var
  LText: string;
  LI: int32;
begin
  LText := ATitle + ":";
  for LI := 0 to varargs.count - 1 do
    match varargs.kind(LI) of
      VarKind.Int32: LText := LText + FormatStr(" i{}", varargs.get(LI, int32));
      VarKind.Int64: LText := LText + FormatStr(" l{}", varargs.get(LI, int64));
      VarKind.Float64: LText := LText + FormatStr(" f{}", varargs.get(LI, float64));
      VarKind.String: LText := LText + " s" + varargs.get(LI, string);
      VarKind.Bool: LText := LText + FormatStr(" b{}", varargs.get(LI, bool));
      VarKind.Char: LText := LText + FormatStr(" c{}", varargs.get(LI, char));
    else
      LText := LText + FormatStr(" ?{}", varargs.kind(LI));
    end;
  end;
  return LText;
end;

// kind through a varargs local, a copy taken after one read
func cpplink CopyKinds(...);
var
  LCopy: varargs;
begin
  varargs.next(int32);
  LCopy := varargs.copy();
  println("copy {} {} {}", LCopy.count, LCopy.kind(0), LCopy.kind(1));
  println("copy next {}", LCopy.next(string));
end;

// The checks: kind / get out of range, get / next of another type; next's cursor stays
func cpplink Checks(...);
var
  LI: int32;
begin
  LI := varargs.count;
  guard
    println("{}", varargs.kind(LI));
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    println("{}", varargs.kind(-1));
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    println("{}", varargs.get(5, int32));
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    println("{}", varargs.get(1, int64));
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    println("{}", varargs.next(string));
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("next {}", varargs.next(int32));
  println("next {}", varargs.next(string));
  guard
    println("{}", varargs.next(int32));
  except
    println("{} {}", exccode(), excmsg());
  end;
end;

func Run();
var
  LI8: int8;
  LI16: int16;
  LU8: uint8;
  LU16: uint16;
  LU64: uint64;
  LCL: clong;
  LCUL: culong;
  LWC: wchar;
  LWS: wstring;
  LStatic: array[0..1] of int32;
  LDynamic: array of int32;
  LSet: TColors;
  LAction: TAction;
  LBox: ref TBox;
begin
  LI8 := -1;
  LI16 := -2;
  LU8 := 3;
  LU16 := 4;
  LU64 := 5;
  LCL := 6;
  LCUL := 7;
  LWC := 'W';
  LWS := "wide";
  LStatic[0] := 1;
  LStatic[1] := 2;
  setlength(LDynamic, 2);
  LSet := [TColor.Red];
  LAction := Nothing;
  LBox := ref TBox();
  Kinds(LI8, LI16, 7, 5000000000, LU8, LU16, 0xFFFFFFFF, LU64, LCL, LCUL, 0.75f, 2.5, true,
    'Q', LWC, "text", LWS, nil, ptr to const char("c"), LStatic, LDynamic, LSet,
    TColor.Green, TPair(A: 1, B: 2), LAction, LBox);
  Kinds();
  println("{}", Show("show", 1, 5000000000, 2.5, "two", false, 'z', LU8, TColor.Red));
  println("{}", Show("none"));
  CopyKinds(1, "a", 2.5);
  Checks(10, "eleven");
end;

begin
  Run();
  println("done {}", 0);
end.
