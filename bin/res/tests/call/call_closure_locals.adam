-------------------------------------------------------------------------------
  call_closure_locals.adam - A func literal's own var / const / type blocks
  (FL1, BNF sec 6): a loop counter, a typed constant and a local record type;
  a local whose initializer names a variable of the enclosing routine (a
  capture through the initializer); a managed local (a string) released at
  each call's end; a nested literal capturing the literal's own local (one
  per call); a captureless literal with locals in a plain func slot.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | sum 55
  | scaled 30
  | pair 3 4
  | text abcabc
  | nested 1 2 1
  | plain 6
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_closure_locals;

import System.SysUtils;

type
  Fn = ref func(const A: int64): int64;
  Maker = ref func(): Fn;
  Plain = func(const A: int64): int64;

func Run();
var
  LSum: Fn;
  LScale: int64;
  LScaled: Fn;
  LPair: Fn;
  LText: ref func(const A: int64): string;
  LMaker: Maker;
  LA: Fn;
  LB: Fn;
  LPlain: Plain;
begin
  // A loop counter of its own
  LSum := func(const A: int64): int64
    var
      LI: int64;
      LTotal: int64;
    begin
      LTotal := 0;
      for LI := 1 to A do
        LTotal := LTotal + LI;
      end;
      return LTotal;
    end;
  println("sum {}", LSum(10));

  // A local initialized from the routine's variable (captured), and a typed constant
  LScale := 3;
  LScaled := func(const A: int64): int64
    const
      TEN: int64 = 10;
    var
      LBy: int64 = LScale;
    begin
      return A * LBy * TEN;
    end;
  println("scaled {}", LScaled(1));

  // A local record type
  LPair := func(const A: int64): int64
    type
      Pair = record
        X: int64;
        Y: int64;
      end;
    var
      LP: Pair;
    begin
      LP.X := A;
      LP.Y := A + 1;
      print("pair {} {}", LP.X, LP.Y);
      return LP.X + LP.Y;
    end;
  LPair(3);
  println("");

  // A managed local, released at each call's end
  LText := func(const A: int64): string
    var
      LS: string;
      LI: int64;
    begin
      LS := "";
      for LI := 1 to A do
        LS := LS + "abc";
      end;
      return LS;
    end;
  println("text {}", LText(2));

  // A nested literal capturing the literal's own local: one per call
  LMaker := func(): Fn
    var
      LCount: int64;
    begin
      LCount := 0;
      return func(const A: int64): int64
        begin
          LCount := LCount + A;
          return LCount;
        end;
    end;
  LA := LMaker();
  LB := LMaker();
  print("nested {}", LA(1));
  print(" {}", LA(1));
  println(" {}", LB(1));

  // Captureless with locals: a plain func slot takes it
  LPlain := func(const A: int64): int64
    var
      LD: int64;
    begin
      LD := A * 2;
      return LD;
    end;
  println("plain {}", LPlain(3));
end;

begin
  Run();
end.
