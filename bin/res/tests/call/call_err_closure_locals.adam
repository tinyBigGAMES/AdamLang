-------------------------------------------------------------------------------
  call_err_closure_locals.adam - Break step of a func literal's body (FL1):
  no 'begin' after its heading (or its own blocks) is PR0001 at the token
  found, its tokens up to its own 'end' skipped; no '(' after 'func' is
  PR0001; the compiler goes on to the next statement either way.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_closure_locals;

type
  Fn = ref func(const A: int64): int64;

func Run();
var
  LF: Fn;
  LG: Fn;
begin
  LG := func; // ERROR PR0001@13
  LF := func(const A: int64): int64
    return A; // ERROR PR0001@5
  end;
end;

begin
  Run();
end.
