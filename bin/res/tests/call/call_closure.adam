-------------------------------------------------------------------------------
  call_closure.adam - closures (BNF sec 4 closure type, sec 6 func literal,
  PLAN-RAVENAPI F2a): a local captured by reference outlives its call (its
  box); copies of a closure share it; two closures of one call share its
  variables, a value parameter too; a for control variable is one variable
  (closures made in the loop see its current value); a const string
  parameter captured by value; a literal inside a literal capturing from
  both, over a statement local; = / <> nil; a nil closure's call raises
  code 3. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | count 6 7 8
  | share 1107 11 7
  | in loop 1
  | in loop 2
  | in loop 3
  | loop 7 70
  | greet hi ann1 hi bob2
  | nest 77 84
  | nil true true
  | 3 call of a nil closure
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_closure;

import System.SysUtils;

type
  Counter = ref func(): int64;
  Action = ref func();
  TextFn = ref func(const A: string): string;

// A local captured by reference: the closure outlives the call (the box is its own)
func MakeCounter(const AStart: int64): Counter;
var
  LCount: int64;
begin
  LCount := AStart;
  return func(): int64
  begin
    LCount := LCount + 1;
    return LCount;
  end;
end;

// One call's closures share its variables, a value parameter too: one writes, one reads
func Share(AStep: int64);
var
  LTotal: int64;
  LBump: Action;
  LPeek: Counter;
begin
  LBump := func()
  begin
    LTotal := LTotal + AStep;
    AStep := AStep + 1;
  end;
  LPeek := func(): int64
  begin
    return LTotal * 100 + AStep;
  end;
  LBump();
  LBump();
  println("share {} {} {}", LPeek(), LTotal, AStep);
end;

// A for control variable is one variable: closures made in the loop see its current value
func Loop();
var
  LI: int64;
  LFirst: Counter;
  LLast: Counter;
begin
  for LI := 1 to 3 do
    if LI = 1 then
      LFirst := func(): int64
      begin
        return LI;
      end;
    end;
    LLast := func(): int64
    begin
      return LI * 10;
    end;
    println("in loop {}", LFirst());
  end;
  LI := 7;
  println("loop {} {}", LFirst(), LLast());
end;

// A const string parameter captured by value beside a local the closure counts in
func Greeter(const APrefix: string): TextFn;
var
  LCount: int64;
begin
  return func(const A: string): string
  begin
    LCount := LCount + 1;
    return APrefix + A + IntToStr(LCount);
  end;
end;

// A literal inside a literal: the inner one captures the outer's statement local (one per
// call of the outer closure) and the routine's local through the outer's closure
func Nest(const ABase: int64): Counter;
var
  LOuter: int64;
begin
  LOuter := ABase;
  return func(): int64
  begin
    var LInner: int64 = 2;
    var LTwice: Counter;
    LTwice := func(): int64
    begin
      LInner := LInner + 1;
      return LOuter * LInner;
    end;
    LOuter := LOuter + 1;
    return LTwice() + LTwice();
  end;
end;

var
  GCount: Counter;
  GCopy: Counter;
  GGreet: TextFn;
  GNest: Counter;
  GNone: Action;

begin
  GCount := MakeCounter(5);
  GCopy := GCount;
  println("count {} {} {}", GCount(), GCopy(), GCount());
  Share(5);
  Loop();
  GGreet := Greeter("hi ");
  println("greet {} {}", GGreet("ann"), GGreet("bob"));
  GNest := Nest(10);
  println("nest {} {}", GNest(), GNest());
  println("nil {} {}", GNone = nil, GCount <> nil);
  guard
    GNone();
  except
    println("{} {}", exccode(), excmsg());
  end;
  GCount := nil;
  GCopy := nil;
  GGreet := nil;
  GNest := nil;
end.
