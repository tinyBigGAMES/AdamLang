-------------------------------------------------------------------------------
  call_array_view_async.adam - `const array of T` views where the callee
  runs after the call (BNF sec 6, AS2): `async F(A)` copies a static
  array's elements into the task's own array at the async (a later change
  of the caller's is not seen); a generator takes its view as an array
  value in its ramp; a view parameter passed to an async call is taken as
  an array value. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | task 6
  | dyn 10
  | each 100 2 3
  | relay 105
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_array_view_async;

var
  GFixed: array[0..2] of int64;
  GDyn: array of int64;
  GTask: task int64;
  GValue: int64;

func Total(const AItems: array of int64): int64;
var
  LSum: int64;
  LItem: int64;
begin
  LSum := 0;
  for LItem in AItems do
    LSum := LSum + LItem;
  end;
  return LSum;
end;

func Each(const AItems: array of int64): sequence of int64;
var
  LItem: int64;
begin
  for LItem in AItems do
    yield LItem;
  end;
end;

func Relay(const AItems: array of int64): int64;
var
  LTask: task int64;
begin
  LTask := async Total(AItems);
  return await LTask;
end;

begin
  GFixed[0] := 1;
  GFixed[1] := 2;
  GFixed[2] := 3;
  GTask := async Total(GFixed);
  GFixed[0] := 100;
  println("task {}", await GTask);
  setlength(GDyn, 4);
  GDyn[0] := 1;
  GDyn[1] := 2;
  GDyn[2] := 3;
  GDyn[3] := 4;
  GTask := async Total(GDyn);
  println("dyn {}", await GTask);
  GTask := nil;
  print("each");
  for GValue in Each(GFixed) do
    print(" {}", GValue);
  end;
  println("");
  println("relay {}", Relay(GFixed));
  setlength(GDyn, 0);
end.
