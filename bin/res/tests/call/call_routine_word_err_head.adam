-------------------------------------------------------------------------------
  call_routine_word_err_head.adam - Break step of call_routine_word: a
  word that starts no declaration (the old `routine`, pcpp-style
  `procedure`, a stray assignment) is ONE PR0001 at the word: the skip after
  it (Adam.Compiler.Parser DoSkipDeclaration) passes the junk's parameter
  list, its local blocks (a record kept balanced) and its begin .. end ';'
  body, so nothing in them reports again, and the func after it and the
  module's own block (end '.') are still read.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_routine_word_err_head;

routine Inc(const AN: int32): int32; // ERROR PR0001@1: expected a declaration (var, const, type, func, forward or public), found 'routine'
type
  Pair = record
    A: int32;
  end;
var
  LP: Pair;
begin
  if AN > 0 then
    LP.A := AN;
  end;
  return LP.A + 1;
end;

func Twice(const AN: int32): int32;
begin
  return AN * 2;
end;

procedure Show(); // ERROR PR0001@1: expected a declaration (var, const, type, func, forward or public), found 'procedure'
begin
  println("{}", Twice(3));
end;

stray := 1; // ERROR PR0001@1: expected a declaration (var, const, type, func, forward or public), found 'stray'

begin
  println("{}", Twice(2));
end.
