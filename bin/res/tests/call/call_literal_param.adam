-------------------------------------------------------------------------------
  call_literal_param.adam - `literal` parameters (BNF sec 4 param, PLAN-LINUX64
  LX4f2): an argument is a constant expression (a literal, a constant's name,
  a folded expression, parenthesized) or the calling func's own literal
  parameter passed on; the parameter reads as a const one. Covered: a string
  and an integer literal parameter, a forward declaration and its full one,
  a method's literal parameter, a literal passed on through two funcs.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | direct 0
  | named 2
  | folded 5
  | paren 1
  | passed 1
  | twice 1
  | forward 3
  | method 4 lines
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_literal_param;

const
  // A constant's name as a literal argument
  NAME: string = "named";
  COUNT: int32 = 2;

type
  // A method's literal parameter
  Printer = object
    Unit: string;
    method Show(literal ACount: int32);
    begin
      println("method {} {}", ACount, self.Unit);
    end;
  end;

// A literal parameter declared ahead of its body: the forward and the full one agree
forward func Later(literal AN: int32);

func Show(literal AName: string; const AN: int32);
begin
  println("{} {}", AName, AN);
end;

// The caller's own literal parameter passed on (Show records the forward)
func Pass(literal AName: string);
begin
  Show(AName, 1);
end;

// Passed on twice
func PassTwice(literal AName: string);
begin
  Pass(AName);
end;

func Later(literal AN: int32);
begin
  println("forward {}", AN);
end;

var
  LPrinter: Printer;

begin
  Show("direct", 0);
  Show(NAME, COUNT);
  Show("folded", 2 + 3);
  Show(("paren"), 1);
  Pass("passed");
  PassTwice("twice");
  Later(3);
  LPrinter.Unit := "lines";
  LPrinter.Show(COUNT * 2);
end.
