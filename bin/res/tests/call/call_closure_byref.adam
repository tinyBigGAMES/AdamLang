-------------------------------------------------------------------------------
  call_closure_byref.adam - A routine, a routine variable and a method bound
  to its ref object given as a closure (F2a / F2b) to a const `ref func`
  parameter that binds by reference (a method's or an init's: C++ linkage,
  BNF sec 4): the closure made as a value and passed from a slot holding it
  (no place of its own), through a value construction's init (VC1), a
  declaration's init arguments, an object's method and a module routine of
  C++ linkage; the same closure given to a plain routine (by value) beside.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | plain 10
  | construct 10
  | declared 10
  | method 15
  | cpplink 10
  | variable 10
  | bound 1 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_closure_byref;

import System.SysUtils;

type
  Fn = ref func(const A: int32): int32;
  Getter = ref func(): int64;

  // An object whose init and method take a closure by reference
  Holder = object
    F: Fn;

    init();
    begin
      self.F := nil;
    end;

    init(const AF: Fn);
    begin
      self.F := AF;
    end;

    method Apply(const AF: Fn): int32;
    begin
      return AF(5) + 5;
    end;
  end;

  // A ref object whose method is bound as a closure (F2b)
  Panel = ref object
    Hits: int64;

    method Hit(): int64;
    begin
      self.Hits := self.Hits + 1;
      return self.Hits;
    end;
  end;

  // An object whose init takes a bound method by reference
  Caller = object
    G: Getter;

    init();
    begin
      self.G := nil;
    end;

    init(const AG: Getter);
    begin
      self.G := AG;
    end;
  end;

func Twice(const A: int32): int32;
begin
  return A * 2;
end;

// A plain routine: the closure by value
func Take(const AF: Fn): int32;
begin
  return AF(5);
end;

// A routine of C++ linkage: the closure by reference
func cpplink TakeCpp(const AF: Fn): int32;
begin
  return AF(5);
end;

var
  LH: Holder;
  LD: Holder(Twice);
  LRoutine: func(const A: int32): int32;
  LPanel: ref Panel;
  LC: Caller;

begin
  println("plain {}", Take(Twice));
  LH := Holder(Twice);
  println("construct {}", LH.F(5));
  println("declared {}", LD.F(5));
  println("method {}", LH.Apply(Twice));
  println("cpplink {}", TakeCpp(Twice));
  LRoutine := Twice;
  LH := Holder(LRoutine);
  println("variable {}", LH.F(5));
  LPanel := ref Panel();
  LC := Caller(LPanel.Hit);
  println("bound {} {}", LC.G(), LC.G());
end.
