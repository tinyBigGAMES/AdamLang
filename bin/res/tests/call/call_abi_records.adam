-------------------------------------------------------------------------------
  call_abi_records.adam - records by value through x86_64-windows-gnu's
  ABI part (Adam.Win64.Abi, imported from the compiler's own src\, beside
  bin\): 1, 2, 4 or 8 bytes as one integer piece by position (a float-only
  record too), copied whole into a stack place past the fourth, any other
  size the address of the caller's copy; a result of those sizes in rax,
  its place not passed and taking no position (a variadic function's homes
  start one place sooner), any other through its place in rcx
  (PLAN-LINUX64 LX1a2)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | (ptr[8 align 4: i 0+8]): void
  | arg 0 pieces rcx@0+8
  | result none
  | outgoing 32
  | arg 0 rcx
  | arg 1 pieces rdx@0+4
  | result none
  | outgoing 32
  | (ptr[12 align 4: i 0+12]): void
  | arg 0 rcx
  | result none
  | outgoing 32
  | arg 0 rcx
  | arg 1 rdx
  | arg 2 r8
  | arg 3 r9
  | arg 4 stack call +32 entry +40 bytes 2
  | result none
  | outgoing 40
  | (result ptr[8 align 8: i 0+8], int64, float64): ptr
  | arg 0 none
  | arg 1 rcx
  | arg 2 xmm1
  | result pieces rax@0+8
  | outgoing 32
  | arg 0 rcx
  | arg 1 rdx
  | result rax
  | outgoing 32
  | home rdx entry +16
  | home r8 entry +24
  | home r9 entry +32
  | first entry +16
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_abi_records;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Backend.Ssa, Adam.Backend.Parts, Adam.Win64.Abi;

// An aggregate of ASize bytes aligned to AAlign, its leaves ALeaves' triples (offset,
// bytes, 1 for a float's), each aligned to its own bytes
func Aggregate(const ASize: int64; const AAlign: int64; const ALeaves: array of int64): ref IrAggregate;
var
  LShape: ref IrAggregate;
  LI: int64;
begin
  LShape := ref IrAggregate(ASize, AAlign);
  LI := 0;
  while LI < len(ALeaves) do
    LShape.AddLeaf(ALeaves[LI], ALeaves[LI + 1], ALeaves[LI + 1], ALeaves[LI + 2] = 1);
    LI := LI + 3;
  end;
  return LShape;
end;

// A signature of AResult: AShaped's aggregates first (each a shaped parameter), then the
// scalars ATypes; with APlace the first aggregate is the result's place
func Signature(const AResult: IrType; const APlace: bool; const AShaped: array of ref IrAggregate;
  const ATypes: array of IrType): ref IrSignature;
var
  LSignature: ref IrSignature;
  LI: int64;
begin
  LSignature := ref IrSignature(AResult);
  LSignature.ResultPlace := APlace;
  for LI := 0 to len(AShaped) - 1 do
    LSignature.AddShapedParam(AShaped[LI]);
  end;
  for LI := 0 to len(ATypes) - 1 do
    LSignature.AddParam(ATypes[LI]);
  end;
  return LSignature;
end;

// A void signature of AScalars int64 parameters, then an aggregate of AShape
func After(const AScalars: int64; const AShape: ref IrAggregate): ref IrSignature;
var
  LSignature: ref IrSignature;
  LI: int64;
begin
  LSignature := ref IrSignature(IrType.Void);
  for LI := 1 to AScalars do
    LSignature.AddParam(IrType.Int64);
  end;
  LSignature.AddShapedParam(AShape);
  return LSignature;
end;

// The signature's text (when AText), then its layout
func Show(const AAbi: ref Win64Abi; const ASignature: ref IrSignature; const AText: bool);
begin
  if AText then
    println(ASignature.Text());
  end;
  print(AAbi.LayoutCall(ASignature).Text());
end;

var
  GAbi: ref Win64Abi;
  GVariadic: ref IrSignature;

begin
  GAbi := ref Win64Abi();
  // 8 bytes in its integer register; a float-only 4-byte record in an integer register too
  Show(GAbi, Signature(IrType.Void, false, [Aggregate(8, 4, [0, 4, 0, 4, 4, 0])], []), true);
  Show(GAbi, After(1, Aggregate(4, 4, [0, 4, 1])), false);
  // 12 bytes: the address of the caller's copy
  Show(GAbi, Signature(IrType.Void, false, [Aggregate(12, 4, [0, 4, 0, 4, 4, 0, 8, 4, 0])], []), true);
  // past the fourth: its 2 bytes copied into the stack place
  Show(GAbi, After(4, Aggregate(2, 2, [0, 2, 0])), false);
  // results: 8 bytes in rax (the place takes no position), 16 through the place
  Show(GAbi, Signature(IrType.Pointer, true, [Aggregate(8, 8, [0, 8, 0])], [IrType.Int64,
    IrType.Float64]), true);
  Show(GAbi, Signature(IrType.Pointer, true, [Aggregate(16, 8, [0, 8, 0, 8, 8, 0])], [IrType.Int64]),
    false);
  // a variadic function of an 8-byte result and one ptr: its homes from rdx
  GVariadic := Signature(IrType.Pointer, true, [Aggregate(8, 8, [0, 8, 0])], [IrType.Pointer]);
  GVariadic.Variadic := true;
  print(GAbi.LayoutVarargs(GVariadic).Text());
end.
