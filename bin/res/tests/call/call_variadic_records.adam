-------------------------------------------------------------------------------
  call_variadic_records.adam - aggregates by value through a clink
  variadic call, placed by the ABI part as named ones (PLAN-LINUX64
  LX1b2: the call's operand carries the record's shape): a 16-byte
  { float64; int64 }, an 8-byte { float32; float32 }, a 5-byte record and
  a 24-byte one, in registers and on the stack, read back by
  varargs.next(T) as the ABI part's VariadicAggregate says (win64: the
  bytes of an 8-byte record in its place, any other size the address of
  the caller's copy); the caller's records unchanged; the same call made
  through async (the task's copies passed with their shapes)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 1 | 2.5 -7 | 0.5 0.25 | 1 2 3 4 5 | 10 20 30 | 99
  | sum 168
  | 2.5 -7 0.5 1 30
  | 2 | 2.5 -7 | 0.5 0.25 | 1 2 3 4 5 | 10 20 30 | 99
  | task 169
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_variadic_records;

type
  TMixed = record
    D: float64;
    N: int64;
  end;

  TFloats = record
    X: float32;
    Y: float32;
  end;

  TFive = record
    A: uint8;
    B: uint8;
    C: uint8;
    D: uint8;
    E: uint8;
  end;

  TBig = record
    A: int64;
    B: int64;
    C: int64;
  end;

// The records after ATag, then an int32, printed on one line; their integers summed with
// ATag and the int32
func Show(const ATag: int32; ...): int64;
var
  LM: TMixed;
  LF: TFloats;
  LV: TFive;
  LB: TBig;
  LE: int32;
begin
  LM := varargs.next(TMixed);
  LF := varargs.next(TFloats);
  LV := varargs.next(TFive);
  LB := varargs.next(TBig);
  LE := varargs.next(int32);
  println("{} | {} {} | {} {} | {} {} {} {} {} | {} {} {} | {}", ATag, LM.D, LM.N, LF.X, LF.Y,
    LV.A, LV.B, LV.C, LV.D, LV.E, LB.A, LB.B, LB.C, LE);
  return int64(ATag) + LM.N + int64(LV.A) + int64(LV.B) + int64(LV.C) + int64(LV.D) +
    int64(LV.E) + LB.A + LB.B + LB.C + int64(LE);
end;

var
  GM: TMixed;
  GF: TFloats;
  GV: TFive;
  GB: TBig;
  GTask: task int64;

begin
  GM.D := 2.5;
  GM.N := -7;
  GF.X := 0.5;
  GF.Y := 0.25;
  GV.A := 1;
  GV.B := 2;
  GV.C := 3;
  GV.D := 4;
  GV.E := 5;
  GB.A := 10;
  GB.B := 20;
  GB.C := 30;
  println("sum {}", Show(1, GM, GF, GV, GB, 99));
  // the callee read copies: the caller's records as they were
  println("{} {} {} {} {}", GM.D, GM.N, GF.X, GV.A, GB.C);
  GTask := async Show(2, GM, GF, GV, GB, 99);
  // the task copied them at the async
  GM.N := 1000;
  println("task {}", await GTask);
end.
