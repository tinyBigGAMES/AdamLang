-------------------------------------------------------------------------------
  call_err_literal_arg.adam - Break step of `literal` parameters (BNF sec 4
  param, LX4f2): an argument that is no constant nor the calling func's own
  literal parameter is SM0770 naming the parameter and the func (a
  variable, a call's result, a const parameter passed on); a func taking a
  literal parameter is no value of a func type (its calls would go
  unchecked: SM0200)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_literal_arg;

type
  Fn = func(const AName: string);

func Take(literal AName: string);
begin
  println("{}", AName);
end;

func Name(): string;
begin
  return "made";
end;

// A const parameter is no constant: its every call may pass another value
func Plain(const AName: string);
begin
  Take(AName); // ERROR SM0770@8
end;

var
  LName: string;
  LFn: Fn;

begin
  LName := "kept";
  Take(LName); // ERROR SM0770@8
  Take(Name()); // ERROR SM0770@8
  Take("constant");
  Plain(LName);
  LFn := Take; // ERROR SM0200@10
end.
