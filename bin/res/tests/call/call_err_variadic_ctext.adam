-------------------------------------------------------------------------------
  call_err_variadic_ctext.adam - Break step of call_variadic_ctext (CV1,
  BNF sec 6): a C variadic's '...' takes plain values (a string or wstring
  goes as its C text), so a dynamic array, a record holding a string, a
  ref, a closure or an object there is SM0765; a clink variadic's
  varargs.next of a string (or of any type C cannot pass) is SM0766.
  Plain values, strings, a cpplink variadic's string and next(ptr to const
  char) are fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_variadic_ctext;

func printf(const AFormat: ptr to const char; ...): int32; external "msvcrt";

type
  Named = record
    Text: string;
  end;
  Counter = object
    Count: int32;
  end;
  Action = ref func();

func cpplink Packed(...);
begin
end;

func Reads(const ACount: int32; ...): int32;
var
  LText: string;
  LPointer: ptr to const char;
begin
  LPointer := varargs.next(ptr to const char);
  LText := varargs.next(string); // ERROR SM0766@12: varargs.next(string) in a clink variadic: a C caller passes plain values (a C string: next(ptr to const char))
  return ACount;
end;

var
  LNumbers: array of int32;
  LNamed: Named;
  LShared: ref Counter;
  LAction: Action;
  LCounter: Counter;
  LText: string;

begin
  LText := "fine";
  printf("%s %d %.1f %s", LText, 3, 1.5, "lit");
  Packed(LText, LNumbers);
  printf("%p", LNumbers); // ERROR SM0765@16: a 'array of int32' cannot go to a C variadic's '...': C reads plain values (a string goes as its C text)
  printf("%p", LNamed); // ERROR SM0765@16: a 'Named' cannot go to a C variadic's '...': C reads plain values (a string goes as its C text)
  printf("%p", LShared); // ERROR SM0765@16: a 'ref Counter' cannot go to a C variadic's '...': C reads plain values (a string goes as its C text)
  printf("%p", LAction); // ERROR SM0765@16: a 'ref func()' cannot go to a C variadic's '...': C reads plain values (a string goes as its C text)
  printf("%p", LCounter); // ERROR SM0765@16: a 'Counter' cannot go to a C variadic's '...': C reads plain values (a string goes as its C text)
end.
