-------------------------------------------------------------------------------
  call_closure_self.adam - a ref object's self captured (BNF sec 6 func
  literal, PLAN-RAVENAPI F2a, F2a0): the closure holds the object as a ref,
  so it lives on after the last other ref is gone, beside a captured
  parameter of its method; its done runs when the closure goes. Nothing
  leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | tick 12
  | tick 14
  | done 14
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_closure_self;

type
  Tick = ref func(): int64;

  Clock = ref object
    Ticks: int64;

    init(const AStart: int64);
    begin
      self.Ticks := AStart;
    end;

    done;
    begin
      println("done {}", self.Ticks);
    end;

    method Ticker(const AStep: int64): Tick;
    begin
      return func(): int64
      begin
        self.Ticks := self.Ticks + AStep;
        return self.Ticks;
      end;
    end;
  end;

var
  GClock: ref Clock;
  GTick: Tick;

begin
  GClock := ref Clock(10);
  GTick := GClock.Ticker(2);
  GClock := nil;
  println("tick {}", GTick());
  println("tick {}", GTick());
  GTick := nil;
  println("end");
end.
