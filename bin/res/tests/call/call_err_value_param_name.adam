-------------------------------------------------------------------------------
  call_err_value_param_name.adam - Break step (PLAN-ADAM SU2.3): a routine
  type owns no parameter name (one type for every signature of its key), so
  a call through a routine value names a var parameter (SM0405, SM0702) as
  the value's written type does: FirstBump and Bump are one type, each call
  names its own declaration's parameter; a value no declaration holds (a
  call's result) names it by position
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_value_param_name;

type
  // Made first: the routine type both declarations share
  FirstBump = func(var AFirst: int64);
  // The same type, its parameter written with another name
  Bump = func(var AOut: int64);
  // Bump again, through an alias
  BumpAlias = Bump;

var
  GFirst: FirstBump;
  GBump: Bump;
  GAlias: BumpAlias;
  GPlain: task;

func Pick(): Bump;
begin
  return GBump;
end;

func Run();
var
  LValue: int64;
begin
  LValue := 1;
  GBump(5); // ERROR SM0405@9: var parameter 'AOut' needs a variable of type 'int64'
  GFirst(5); // ERROR SM0405@10: var parameter 'AFirst' needs a variable of type 'int64'
  GAlias(5); // ERROR SM0405@10: var parameter 'AOut' needs a variable of type 'int64'
  Pick()(5); // ERROR SM0405@10: var parameter '#1' needs a variable of type 'int64'
  GPlain := async GBump(LValue); // ERROR SM0702@13: async cannot pass var parameter 'AOut': the caller's variable may be gone before the call ends
  GPlain := async GFirst(LValue); // ERROR SM0702@13: async cannot pass var parameter 'AFirst': the caller's variable may be gone before the call ends
  GPlain := async Pick()(LValue); // ERROR SM0702@13: async cannot pass var parameter '#1': the caller's variable may be gone before the call ends
end;

begin
  Run();
end.
