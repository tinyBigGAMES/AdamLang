-------------------------------------------------------------------------------
  call_variadic_pack.adam - Adam cpplink variadic routines, the typed pack
  (M3.7d, BNF sec 6). The caller copies every extra argument at its own
  static type (the literal typing rule: an integer literal is int32, a
  larger one int64, 0xFFFFFFFF uint32, a float literal float64, with f
  float32, nil ptr) and passes the pack as one hidden pointer after the
  fixed parameters. The routine reads it: count, next(T) in a loop and of
  every scalar kind with no promotion, get(I, T) leaving the cursor where
  it is, reset(), aggregates of 8 and 12 bytes by next and get. A local of
  type varargs set from varargs.copy() (at its declaration and by an
  assignment) keeps its own cursor and has the same members, a copy of it
  too. With no fixed parameter, past a hidden result pointer, with four
  fixed parameters (the pack on the stack), through a routine value, and
  the arguments evaluated left to right.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0
  | 3
  | 106
  | 7
  | 7 5000000000 4294967295 2.50 0.75 Q 1 1
  | -5 60000 str
  | 10 30 20 10 30
  | 1 2 2 3 3 1 1 4 4 1
  | 1 -2 | 3 4 5 | 5
  | 2 5 6
  | 1 2 3
  | 109
  | 1006
  | 5
@@end
*/

module exe call_variadic_pack;

routine puts(const AText: ptr): int32; external "ucrtbase";
routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine sprintf(const ABuffer: ptr; const AFormat: ptr to const char; ...): int32; external "msvcrt";

type
  TPair = record
    A: int32;
    B: int32;
  end;

  TTriple = record
    A: int32;
    B: int32;
    C: int32;
  end;

  TPackSum = routine cpplink(const ABase: int64; ...): int64;

var
  GTick: int32;

// AValue on a line of its own
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// The next tick: 1, 2, 3, ... (shows the order arguments run in)
routine Tick(): int32;
begin
  GTick := GTick + 1;
  return GTick;
end;

// The number of arguments: no fixed parameter
routine cpplink CountOf(...): int32;
begin
  return varargs.count;
end;

// ABase plus every int32 after it, read by next in a loop over count
routine cpplink SumAll(const ABase: int64; ...): int64;
var
  LSum: int64;
  LI: int32;
begin
  LSum := ABase;
  for LI := 1 to varargs.count do
    LSum := LSum + int64(varargs.next(int32));
  end;
  return LSum;
end;

// One argument of each kind read back at its own type, two lines
routine cpplink Kinds(const ABuffer: ptr; ...);
var
  LI32: int32;
  LI64: int64;
  LU32: uint32;
  LF64: float64;
  LF32: float32;
  LC: char;
  LB: bool;
  LP: ptr;
  LI8: int8;
  LU16: uint16;
  LS: ptr to const char;
begin
  LI32 := varargs.next(int32);
  LI64 := varargs.next(int64);
  LU32 := varargs.next(uint32);
  LF64 := varargs.next(float64);
  LF32 := varargs.next(float32);
  LC := varargs.next(char);
  LB := varargs.next(bool);
  LP := varargs.next(ptr);
  LI8 := varargs.next(int8);
  LU16 := varargs.next(uint16);
  LS := varargs.next(ptr to const char);
  sprintf(ABuffer, ptr to const char("%d %I64d %u %.2f %.2f %c %d %d"), LI32, LI64, LU32, LF64,
    LF32, LC, LB, LP = nil);
  puts(ABuffer);
  sprintf(ABuffer, ptr to const char("%d %u %s"), LI8, LU16, LS);
  puts(ABuffer);
end;

// get reads any argument and leaves the cursor; reset rewinds it
routine cpplink Pick(const ABuffer: ptr; ...);
var
  LA: int32;
  LB: int32;
  LC: int32;
  LD: int32;
  LE: int32;
begin
  LA := varargs.next(int32);
  LB := varargs.get(2, int32);
  LC := varargs.next(int32);
  varargs.reset();
  LD := varargs.next(int32);
  LE := varargs.get(varargs.count - 1, int32);
  sprintf(ABuffer, ptr to const char("%d %d %d %d %d"), LA, LB, LC, LD, LE);
  puts(ABuffer);
end;

// Copies keep their own cursors: one taken at entry, one after a read, a copy of a copy
routine cpplink Copies(const ABuffer: ptr; ...);
var
  LAtEntry: varargs = varargs.copy();
  LFirst: varargs;
  LSecond: varargs;
  LA: int32;
  LB: int32;
  LC: int32;
  LD: int32;
  LE: int32;
  LF: int32;
  LG: int32;
  LH: int32;
  LI: int32;
  LJ: int32;
begin
  LA := varargs.next(int32);
  LFirst := varargs.copy();
  LB := varargs.next(int32);
  LC := LFirst.next(int32);
  LD := LFirst.next(int32);
  LE := varargs.next(int32);
  LSecond := LFirst.copy();
  LFirst.reset();
  LF := LFirst.next(int32);
  LG := LSecond.get(0, int32);
  LH := LSecond.count;
  LI := LSecond.next(int32);
  LJ := LAtEntry.next(int32);
  sprintf(ABuffer, ptr to const char("%d %d %d %d %d %d %d %d %d %d"), LA, LB, LC, LD, LE, LF,
    LG, LH, LI, LJ);
  puts(ABuffer);
end;

// Aggregates: a TPair (8 bytes) and a TTriple (12) by next, the TTriple again by get
routine cpplink Aggs(const ABuffer: ptr; ...);
var
  LP: TPair;
  LT: TTriple;
  LU: TTriple;
begin
  LP := varargs.next(TPair);
  LT := varargs.next(TTriple);
  LU := varargs.get(1, TTriple);
  sprintf(ABuffer, ptr to const char("%d %d | %d %d %d | %d"), LP.A, LP.B, LT.A, LT.B, LT.C, LU.C);
  puts(ABuffer);
end;

// A hidden result pointer first, the pack after it
routine cpplink MakeTriple(...): TTriple;
var
  LT: TTriple;
begin
  LT.A := varargs.count;
  LT.B := varargs.next(int32);
  LT.C := varargs.get(1, int32);
  return LT;
end;

// The first three arguments by get, in their order
routine cpplink Three(const ABuffer: ptr; ...);
begin
  sprintf(ABuffer, ptr to const char("%d %d %d"), varargs.get(0, int32), varargs.get(1, int32),
    varargs.get(2, int32));
  puts(ABuffer);
end;

// Four fixed parameters: the pack's pointer is the fifth argument, on the stack
routine cpplink Four(const AA: int32; const AB: int32; const AC: int32; const AD: int32; ...): int64;
begin
  return int64(AA + AB + AC + AD) * 10 + int64(varargs.next(int32));
end;

routine Run();
var
  LBuf: array[0..127] of char;
  LI8: int8;
  LU16: uint16;
  LTriple: TTriple;
  LFn: TPackSum;
begin
  // count with none and with three, no fixed parameter
  ShowInt(int64(CountOf()));
  ShowInt(int64(CountOf(1, 2.5, 'x')));

  // A loop over count
  ShowInt(SumAll(100, 1, 2, 3));
  ShowInt(SumAll(7));

  // Every kind at its own type
  LI8 := -5;
  LU16 := 60000;
  Kinds(addr of LBuf, 7, 5000000000, 0xFFFFFFFF, 2.5, 0.75f, 'Q', true, nil, LI8, LU16,
    ptr to const char("str"));

  // get, next and reset
  Pick(addr of LBuf, 10, 20, 30);

  // Copies
  Copies(addr of LBuf, 1, 2, 3, 4);

  // Aggregates
  LTriple := TTriple(A: 3, B: 4, C: 5);
  Aggs(addr of LBuf, TPair(A: 1, B: -2), LTriple);

  // Past a hidden result pointer
  LTriple := MakeTriple(5, 6);
  sprintf(addr of LBuf, ptr to const char("%d %d %d"), LTriple.A, LTriple.B, LTriple.C);
  puts(addr of LBuf);

  // The arguments run left to right
  Three(addr of LBuf, Tick(), Tick(), Tick());

  // The pack on the stack
  ShowInt(Four(1, 2, 3, 4, 9));

  // Through a routine value
  LFn := SumAll;
  ShowInt(LFn(1000, 1, 2, 3));
  ShowInt(LFn(5));
end;

begin
  Run();
end.
