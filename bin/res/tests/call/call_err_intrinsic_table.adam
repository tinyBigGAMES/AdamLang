-------------------------------------------------------------------------------
  call_err_intrinsic_table.adam - Break step of call_intrinsic_table: an
  intrinsic given arguments it does not take, SM0409 naming it by the
  table's spelling and its signature (an atomic's, a bit intrinsic's, a
  statement's, size's missing type argument, a no-argument intrinsic's);
  size of a value is SM0410.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_intrinsic_table;

var
  GCount: int64;
  GReal: float64;
  GText: string;

begin
  atomicload(GReal); // ERROR SM0409@3: 'atomicload' takes (int32, int64, uint32, uint64 or ptr variable)
  atomicstore(GCount, "x"); // ERROR SM0409@3: 'atomicstore' takes (int32, int64, uint32, uint64 or ptr variable, its type)
  GCount := popcount(GText); // ERROR SM0409@22: 'popcount' takes (an integer)
  setlength(GCount, 2); // ERROR SM0409@13: 'setlength' takes (dynamic array or string variable, int64)
  GCount := size(1 + 2); // ERROR SM0410@18: size takes a type, and '1 + 2' is a value: write size(its type)
  GCount := size(); // ERROR SM0409@13: 'size' takes (a type)
  GCount := paramcount(1); // ERROR SM0409@13: 'paramcount' takes ()
end.
