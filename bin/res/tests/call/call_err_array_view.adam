-------------------------------------------------------------------------------
  call_err_array_view.adam - Break step of `const array of T` views (BNF
  sec 6, AS2): only a const parameter borrows a static array; a var
  `array of T` still takes none, and a static array of another element
  type is no view of `array of T` (SM0405 / SM0404 at the argument).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_array_view;

var
  GFixed: array[0..2] of int32;

func Fill(var AItems: array of int32);
begin
  setlength(AItems, 1);
end;

func Wide(const AItems: array of int64): int64;
begin
  return len(AItems);
end;

begin
  Fill(GFixed); // ERROR SM0405@8
  println("{}", Wide(GFixed)); // ERROR SM0404@22
end.
