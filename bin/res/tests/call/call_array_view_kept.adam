-------------------------------------------------------------------------------
  call_array_view_kept.adam - A `const array of T` parameter also used as an
  array value (assigned to a variable) keeps its view for every view read
  (BNF sec 6, AS2): an index, len, for .. in and a pass on to another view
  parameter read the caller's view, as in a routine that only reads its
  view. So a write to the caller's static array during the call is seen
  through the index while the kept value is the copy taken at the entry; a
  dynamic array's value shares its block (a write to the caller's array
  copies, the view still reads the block it was called with). Captured by a
  func literal, the parameter is read from the literal's own copy.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | static kept 10 view 99 len 3 total 149 walk 149
  | dynamic kept 1 view 1 len 4 total 10 walk 10
  | after 99 1
  | captured 23
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_array_view_kept;

type
  Triple = array[0..2] of int32;

var
  GFixed: Triple;
  GDyn: array of int32;
  GKept: array of int32;

// The sum of AItems' elements, through its view
func Total(const AItems: array of int32): int64;
var
  LSum: int64;
  LI: int64;
begin
  LSum := 0;
  for LI := 0 to len(AItems) - 1 do
    LSum := LSum + AItems[LI];
  end;
  return LSum;
end;

// AItems kept as GKept's value, then the caller's array written, then read through the
// view: an index, len, a pass on and a for .. in
func Keep(const AName: string; const AItems: array of int32);
var
  LWalk: int64;
  LItem: int32;
begin
  GKept := AItems;
  if AName = "static" then
    GFixed[0] := 99;
  else
    GDyn[0] := 99;
  end;
  LWalk := 0;
  for LItem in AItems do
    LWalk := LWalk + LItem;
  end;
  println("{} kept {} view {} len {} total {} walk {}", AName, GKept[0], AItems[0], len(AItems),
    Total(AItems), LWalk);
end;

// AItems kept as GKept's value and captured by a func literal, which reads its own copy
func KeepCaptured(const AItems: array of int32): int64;
var
  LRead: ref func(): int64;
begin
  GKept := AItems;
  LRead := func(): int64
  begin
    return AItems[1];
  end;
  return LRead() + len(AItems);
end;

begin
  GFixed[0] := 10;
  GFixed[1] := 20;
  GFixed[2] := 30;
  setlength(GDyn, 4);
  GDyn[0] := 1;
  GDyn[1] := 2;
  GDyn[2] := 3;
  GDyn[3] := 4;
  Keep("static", GFixed);
  Keep("dynamic", GDyn);
  println("after {} {}", GDyn[0], GKept[0]);
  println("captured {}", KeepCaptured(GFixed));
  setlength(GKept, 0);
  setlength(GDyn, 0);
end.
