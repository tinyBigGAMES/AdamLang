-------------------------------------------------------------------------------
  call_err_size_value.adam - Break step of size (AUD5): size takes a type,
  so a variable or an expression there is SM0410 at that argument (pcpp's
  code); a type, named or written, is clean
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_size_value;

var
  LN: int64;

begin
  LN := size(int32);
  LN := size(ptr to int64);
  LN := size(LN); // ERROR SM0410@14
  LN := size(LN + 1); // ERROR SM0410@14
end.
