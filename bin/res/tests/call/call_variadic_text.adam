-------------------------------------------------------------------------------
  call_variadic_text.adam - managed items in a cpplink variadic's typed pack
  (M3.8g, BNF sec 6): a string, a wstring and a ref passed as extra
  arguments and read back by next(T) / get(I, T). The caller's item is its
  block borrowed, as for a const parameter: a variable's, a literal's, a
  const's, the empty string, and a temporary's (a concatenation, a call's
  result, FormatStr's, a ref made in place) kept until the statement ends.
  The routine reads it like any place's value: concatenated, returned,
  stored past the call (a holder of its own: the caller's later change does
  not reach it), read through a copy() of the pack, mixed with scalars, a
  pack call as another's item. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | abc;lit;abcx;;loc;konst;
  | 
  | one
  | c
  | 1-2;abcabc;
  | abc zzz
  | zzz!
  | 7 seven Q 2.5 wide
  | widewide
  | ab|ab
  | held/x
  | temp/y
  | done temp
  | done held
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_variadic_text;

type
  TNote = object
    Text: string;

    init(const AText: string);
    begin
      self.Text := AText;
    end;

    done;
    begin
      println("done {}", self.Text);
    end;
  end;

const
  CName: string = "konst";

var
  GA: string;
  GW: wstring;
  GKeep: string;
  GNote: ref TNote;

// Every item by next in a loop over count, each followed by ';'
func cpplink Join(...): string;
var
  LResult: string;
  LI: int32;
begin
  LResult := "";
  for LI := 1 to varargs.count do
    LResult := LResult + varargs.next(string) + ";";
  end;
  return LResult;
end;

// The item at AIndex by get, returned as it is
func cpplink Pick(const AIndex: int32; ...): string;
begin
  return varargs.get(AIndex, string);
end;

// The first item stored in a module variable: it outlives the call
func cpplink Keep(...);
begin
  GKeep := varargs.next(string);
end;

// A scalar, a string, a char, a float and a wstring in one pack
func cpplink Mixed(...): string;
begin
  return FormatStr("{} {} {} {} {}", varargs.next(int32), varargs.next(string),
    varargs.next(char), varargs.next(float64), varargs.next(wstring));
end;

// Two wstring items joined
func cpplink WideJoin(...): wstring;
var
  LW: wstring;
begin
  LW := varargs.next(wstring);
  LW := LW + varargs.next(wstring);
  return LW;
end;

// The first item read twice: by the pack, then by a copy taken at entry
func cpplink Twice(...): string;
var
  LCopy: varargs = varargs.copy();
  LFirst: string;
begin
  LFirst := varargs.next(string);
  return LFirst + "|" + LCopy.next(string);
end;

// A ref item held by a local while the routine runs
func cpplink NoteText(...): string;
var
  LNote: ref TNote;
begin
  LNote := varargs.next(ref TNote);
  return LNote.Text + "/" + varargs.get(1, string);
end;

func Run();
var
  LLocal: string;
begin
  GA := "abc";
  LLocal := "loc";

  // a variable, a literal, a concatenation, the empty string, a local, a const
  println("{}", Join(GA, "lit", GA + "x", "", LLocal, CName));
  println("{}", Join());

  // get, and a pack call's result as another call's item
  println("{}", Pick(1, "zero", "one", "two"));
  println("{}", Pick(0, Pick(2, "a", "b", "c"), "d"));
  println("{}", Join(FormatStr("{}-{}", 1, 2), Pick(0, GA + GA)));

  // stored past the call, then the caller's variable changes
  Keep(GA);
  GA := "zzz";
  println("{} {}", GKeep, GA);
  Keep(GA + "!");
  println("{}", GKeep);

  // mixed with scalars, a wstring item
  GW := "wide";
  println("{}", Mixed(7, "seven", 'Q', 2.5, GW));
  println("{}", WideJoin(GW, GW));

  // a copy of the pack reads the same block
  println("{}", Twice("ab"));

  // a ref: a variable's, then one made in place
  GNote := ref TNote("held");
  println("{}", NoteText(GNote, "x"));
  println("{}", NoteText(ref TNote("temp"), "y"));
  GNote := nil;
  println("end");
end;

begin
  Run();
end.
