-------------------------------------------------------------------------------
  call_err_pack.adam - Break step of call_variadic_pack (M3.7d, BNF sec 4
  and sec 6). varargs is only the type of a variadic routine's local (SM0422:
  a module variable, a parameter, a local of a routine that is not variadic,
  a part of another type), set only from a pack's copy (SM0422: an
  initializer or an assignment from another local). On a varargs local, next
  and get take a type (SM0013), each member its own argument count (SM0401),
  and it has no other member (SM0009). After `.next(` on a receiver that is
  no varargs local the call is an ordinary one and a type there is no value
  (SM0269). A local copied at its declaration, count and get on it, and
  varargs.get are fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe call_err_pack;

type
  TBox = record
    next: routine(const AV: int32): int32;
  end;

var
  GPack: varargs; // ERROR SM0422@10: 'varargs' is only the type of a variadic routine's local, set from a varargs.copy()

routine TakesPack(const AP: varargs); // ERROR SM0422@29: 'varargs' is only the type of a variadic routine's local, set from a varargs.copy()
begin
end;

routine NotVariadic();
var
  LP: varargs; // ERROR SM0422@7: 'varargs' is only the type of a variadic routine's local, set from a varargs.copy()
  LQ: ptr to varargs; // ERROR SM0422@14: 'varargs' is only the type of a variadic routine's local, set from a varargs.copy()
begin
end;

routine cpplink Reads(const AN: int32; ...): int32;
var
  LGood: varargs = varargs.copy();
  LBad: varargs = LGood; // ERROR SM0422@19: 'varargs' is only the type of a variadic routine's local, set from a varargs.copy()
  LV: int32;
  LBox: TBox;
begin
  LBad := LGood; // ERROR SM0422@11: 'varargs' is only the type of a variadic routine's local, set from a varargs.copy()
  LV := LGood.next(5); // ERROR SM0013@20: '5' is not a type
  LV := LGood.next(); // ERROR SM0401@9: 'LGood.next' takes 1 argument(s), 0 given
  LV := LGood.get(0); // ERROR SM0401@9: 'LGood.get' takes 2 argument(s), 1 given
  LGood.reset(1); // ERROR SM0401@3: 'LGood.reset' takes 0 argument(s), 1 given
  LGood.kind(); // ERROR SM0401@3: 'LGood.kind' takes 1 argument(s), 0 given
  LV := LGood.size; // ERROR SM0009@9: 'varargs' has no member 'size'
  LV := LBox.next(int32); // ERROR SM0269@19: 'int32' is a type, not a value
  LV := LGood.get(0, int32) + LGood.count + varargs.get(1, int32);
  return LV;
end;

begin
end.
