-------------------------------------------------------------------------------
  call_array_view.adam - A static array passed to a `const array of T`
  parameter is borrowed as a view, no copy (BNF sec 6, AS2): len, an index
  and for .. in read it as a dynamic array's; it passes on to another view
  parameter as it is, under every linkage (a plain routine, cpplink, clink,
  a method, a routine value, a closure). A dynamic array, an empty one, a
  typed constant and a literal pass the same way; a write to the caller's
  array during the call is seen through the view (borrowed, not copied).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | static len 3 total 60
  | dynamic len 4 total 10
  | empty len 0 total 0
  | const len 3 total 6
  | literal len 2 total 15
  | first 10 last 30
  | cpplink 60
  | clink 60
  | method 160
  | value 60
  | closure 120
  | borrowed 99
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe call_array_view;

type
  Triple = array[0..2] of int32;
  Summer = func(const AItems: array of int32): int64;
  SummerRef = ref func(const AItems: array of int32): int64;

  Bag = object
    FBase: int64;

    method Total(const AItems: array of int32): int64;
    var
      LSum: int64;
      LI: int64;
    begin
      LSum := self.FBase;
      for LI := 0 to len(AItems) - 1 do
        LSum := LSum + AItems[LI];
      end;
      return LSum;
    end;
  end;

const
  SQUARE: Triple = [1, 2, 3];

var
  GFixed: Triple;
  GDyn: array of int32;
  GEmpty: array of int32;
  GBag: Bag;
  GSummer: Summer;
  GSummerRef: SummerRef;

func Total(const AItems: array of int32): int64;
var
  LSum: int64;
  LItem: int32;
begin
  LSum := 0;
  for LItem in AItems do
    LSum := LSum + LItem;
  end;
  return LSum;
end;

func Show(const AName: string; const AItems: array of int32);
begin
  println("{} len {} total {}", AName, len(AItems), Total(AItems));
end;

func Ends(const AItems: array of int32);
begin
  println("first {} last {}", AItems[0], AItems[len(AItems) - 1]);
end;

func cpplink CppTotal(const AItems: array of int32): int64;
begin
  return Total(AItems);
end;

func clink CTotal(const AItems: array of int32): int64;
begin
  return CppTotal(AItems);
end;

func Peek(const AItems: array of int32): int32;
begin
  GFixed[0] := 99;
  return AItems[0];
end;

begin
  GFixed[0] := 10;
  GFixed[1] := 20;
  GFixed[2] := 30;
  setlength(GDyn, 4);
  GDyn[0] := 1;
  GDyn[1] := 2;
  GDyn[2] := 3;
  GDyn[3] := 4;
  Show("static", GFixed);
  Show("dynamic", GDyn);
  Show("empty", GEmpty);
  Show("const", SQUARE);
  Show("literal", [7, 8]);
  Ends(GFixed);
  println("cpplink {}", CppTotal(GFixed));
  println("clink {}", CTotal(GFixed));
  GBag.FBase := 100;
  println("method {}", GBag.Total(GFixed));
  GSummer := Total;
  println("value {}", GSummer(GFixed));
  GSummerRef := func(const AItems: array of int32): int64
  begin
    return Total(AItems) * 2;
  end;
  println("closure {}", GSummerRef(GFixed));
  GSummerRef := nil;
  println("borrowed {}", Peek(GFixed));
  setlength(GDyn, 0);
end.
