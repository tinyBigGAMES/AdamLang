-------------------------------------------------------------------------------
  ssa_sites_release.adam - Allocation sites are debug-only (M3.12b): the
  compiler in this row's process lowers a sample that allocates twice, as a
  debug build and as a release one (Compiler.SetLevel(OptLevel.Safe), as
  -opt safe sets it), its own unit lowered alone (LowerUnit). The
  debug lowering holds the unit's site table (__adam_allocsites_ and the
  unit's name) and stores into the runtime's GAllocSite; the release
  one holds neither, so its runtime calls compile as they would without sites.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | debug table 1
  | debug stores true
  | release table 0
  | release stores 0
  | done
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe ssa_sites_release;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Core.Common, Adam.Compiler.AST, Adam.Backend.Ssa,
  Adam.Backend.Lowering, Adam.Driver.Compiler;

const
  // The sample's file name, written beside this exe
  ADAM_SAMPLE_FILE: string = "ssa_sites_release_sample.adam";
  // The sample unit's site table's data symbol (Lowering's ADAM_LOWERING_SITES_SYMBOL, '_'
  // and the unit's name: SU2.4) and the end of the runtime's GAllocSite blob's symbol (its
  // Itanium name: the length, the name, the closing E, as _ZN6System7RuntimeL10GAllocSiteE
  // ends)
  ADAM_SITES_SYMBOL: string = "__adam_allocsites_ssa_sites_release_sample";
  ADAM_SITE_VARIABLE: string = "10GAllocSiteE";

// The sample program's text: a string grown, a dynamic array set
func SampleText(): string;
var
  LText: string;
begin
  LText := "module exe ssa_sites_release_sample;\n";
  LText := LText + "\n";
  LText := LText + "var\n";
  LText := LText + "  GText: string;\n";
  LText := LText + "  GNums: array of int32;\n";
  LText := LText + "\n";
  LText := LText + "begin\n";
  LText := LText + "  GText := GText + \"ab\";\n";
  LText := LText + "  setlength(GNums, 4);\n";
  LText := LText + "end.\n";
  return LText;
end;

// The sample checked and lowered, a debug build when ADebug, else a release one; nil
// after a report (printed)
func Lowered(const ASample: string; const ADebug: bool): ref IrModule;
var
  LCompiler: ref Compiler;
  LModule: ref IrModule;
begin
  LCompiler := ref Compiler();
  LCompiler.AddModulePath(ResolvePath("$P:../../../../res/libs/std"));
  LCompiler.AddModulePath(ResolvePath("$P:../../../../res/runtime"));
  // the build's level before the front end: every file's DEBUG / RELEASE define reads it
  if ADebug then
    LCompiler.SetLevel(OptLevel.Debug);
  else
    LCompiler.SetLevel(OptLevel.Safe);
  end;
  LCompiler.Check(ASample);
  if LCompiler.Reports.HasErrors() or (LCompiler.PickedTarget = nil) then
    LCompiler.PrintReports();
    return nil;
  end;
  // the sample's own unit (the tree lists the main module first), lowered alone (SU2.4)
  LModule := LowerUnit(LCompiler.Tree, LCompiler.PickedTarget, LCompiler.Reports,
    LCompiler.Tree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, 0));
  if LCompiler.Reports.HasErrors() then
    LCompiler.PrintReports();
    return nil;
  end;
  return LModule;
end;

// How many data blobs of AModule are the site table
func TableCount(const AModule: ref IrModule): int64;
var
  LCount: int64;
  LI: int64;
begin
  LCount := 0;
  for LI := 1 to AModule.DataCount - 1 do
    if AModule.DataAt(LI).Symbol = ADAM_SITES_SYMBOL then
      LCount := LCount + 1;
    end;
  end;
  return LCount;
end;

// How many instructions of AModule take the address of the runtime's GAllocSite (one per
// site store: Lowering's DoStoreSite)
func StoreCount(const AModule: ref IrModule): int64;
var
  LSite: int64;
  LCount: int64;
  LI: int64;
begin
  LSite := 0;
  for LI := 1 to AModule.DataCount - 1 do
    if EndsStr(ADAM_SITE_VARIABLE, AModule.DataAt(LI).Symbol) then
      LSite := LI;
    end;
  end;
  LCount := 0;
  for LI := 1 to AModule.InstrCount - 1 do
    if (AModule.InstrAt(LI).Kind = IrOp.ThreadAddress) and (AModule.InstrAt(LI).Link = LSite) then
      LCount := LCount + 1;
    end;
  end;
  return LCount;
end;

var
  LSample: string;
  LDebug: ref IrModule;
  LRelease: ref IrModule;

begin
  LSample := ResolvePath("$P:" + ADAM_SAMPLE_FILE);
  if not WriteAllText(LSample, SampleText()) then
    println("cannot write {}", LSample);
    Halt(1);
  end;
  LDebug := Lowered(LSample, true);
  LRelease := Lowered(LSample, false);
  if (LDebug = nil) or (LRelease = nil) then
    Halt(1);
  end;
  println("debug table {}", TableCount(LDebug));
  println("debug stores {}", StoreCount(LDebug) > 0);
  println("release table {}", TableCount(LRelease));
  println("release stores {}", StoreCount(LRelease));
  println("done");
end.
