-------------------------------------------------------------------------------
  ssa_debuginfo.adam - A debug build's debug information (M7a): the
  compiler (imported from its own src\, beside bin\) runs in this process on
  a small sample program it writes beside its exe, lowers the sample's own
  module alone (LowerUnit, SU2.4), generates it for the target's parts
  (GenerateSections, a debug build) and prints the sample's part of the
  debug information it hands out (DebugInfoText): each routine with its
  parameters and locals (frame offsets) and line rows, each module
  variable, and every type they reach with its fields / values.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | function ssa_debuginfo_sample.Area at ssa_debuginfo_sample.adam(15) prologue true frame sp
  |   param AWidth: 1:int32 at +0
  |   param AHeight: 1:int32 at +4
  |   local LArea: 1:int32 at +8
  |   local LPoint: 2:ptr to Point at +16
  |   line 15,1
  |   line 15,35
  |   line 15,14
  |   line 15,35
  |   line 17,3
  |   line 18,3
  |   line 20,21
  |   line 20,3
  |   line 21,12
  |   line 21,21
  |   line 21,12
  |   line 21,31
  |   line 21,12
  |   line 21,3
  |   line 22,10
  |   line 22,3
  | function __adam_block_ssa_debuginfo_sample at ssa_debuginfo_sample.adam(1) prologue true frame sp
  |   line 1,1
  |   line 26,3
  |   line 27,22
  |   line 27,16
  |   line 27,3
  |   line 27,10
  |   line 27,3
  |   line 28,17
  |   line 28,24
  |   line 28,17
  |   line 28,3
  |   line 25,1
  |   line 28,17
  |   line 27,3
  | function __adam_varinit_ssa_debuginfo_sample at ssa_debuginfo_sample.adam(1) prologue false frame sp
  |   line 1,1
  | function __adam_start_ssa_debuginfo_sample at ssa_debuginfo_sample.adam(1) prologue false frame sp
  |   line 1,1
  | global ssa_debuginfo_sample.GOrigin: 3:Point
  | global ssa_debuginfo_sample.GShade: 4:Shade
  | global ssa_debuginfo_sample.GCells: 5:array[0..3] of int64
  | type 1 int32 signed size 4
  | type 2 ptr to Point pointer size 8 of 3:Point
  | type 3 Point record size 8
  |   field X: 1:int32 at +0
  |   field Y: 1:int32 at +4
  | type 4 Shade choices size 4
  |   value Red = 0
  |   value Green = 1
  |   value Blue = 2
  | type 5 array[0..3] of int64 array size 32 of 6:int64 count 4
  | type 6 int64 signed size 8
  | sections true
  | done
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe ssa_debuginfo;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Compiler.SourceText, Adam.Compiler.AST,
  Adam.Backend.Ssa, Adam.Backend.Lowering, Adam.Backend.Sections, Adam.Backend.Targets,
  Adam.Backend.Generate, Adam.Backend.DebugInfo, Adam.Driver.Compiler;

const
  // The sample's file name, written beside this exe
  ADAM_SAMPLE_FILE: string = "ssa_debuginfo_sample.adam";

// The sample program's text, one line per element
routine SampleText(): string;
var
  LText: string;
begin
  LText := "module exe ssa_debuginfo_sample;\n";
  LText := LText + "\n";
  LText := LText + "type\n";
  LText := LText + "  Point = record\n";
  LText := LText + "    X: int32;\n";
  LText := LText + "    Y: int32;\n";
  LText := LText + "  end;\n";
  LText := LText + "  Shade = choices(Red, Green, Blue);\n";
  LText := LText + "\n";
  LText := LText + "var\n";
  LText := LText + "  GOrigin: Point;\n";
  LText := LText + "  GShade: Shade;\n";
  LText := LText + "  GCells: array[0..3] of int64;\n";
  LText := LText + "\n";
  LText := LText + "routine Area(const AWidth: int32; const AHeight: int32): int32;\n";
  LText := LText + "var\n";
  LText := LText + "  LArea: int32;\n";
  LText := LText + "  LPoint: ptr to Point;\n";
  LText := LText + "begin\n";
  LText := LText + "  LPoint := addr of GOrigin;\n";
  LText := LText + "  LArea := AWidth * AHeight + LPoint^.X;\n";
  LText := LText + "  return LArea;\n";
  LText := LText + "end;\n";
  LText := LText + "\n";
  LText := LText + "begin\n";
  LText := LText + "  GShade := Shade.Green;\n";
  LText := LText + "  GCells[1] := int64(Area(3, 4));\n";
  LText := LText + "  println(\"{}\", GCells[1]);\n";
  LText := LText + "end.\n";
  return LText;
end;

var
  LCompiler: ref Compiler;
  LModule: ref IrModule;
  LBackend: ref Backend;
  LSet: ref SectionSet;
  LDebug: ref DebugModule;
  LSample: string;
  LUnit: int64;
  LI: int64;

begin
  LSample := ResolvePath("$P:" + ADAM_SAMPLE_FILE);
  if not WriteAllText(LSample, SampleText()) then
    println("cannot write {}", LSample);
    Halt(1);
  end;
  LCompiler := ref Compiler();
  LCompiler.AddModulePath(ResolvePath("$P:../../../../res/libs/std"));
  LCompiler.AddModulePath(ResolvePath("$P:../../../../res/runtime"));
  LCompiler.Check(LSample);
  if LCompiler.Reports.HasErrors() or (LCompiler.PickedTarget = nil) then
    LCompiler.PrintReports();
    Halt(1);
  end;
  LBackend := PickBackend(LCompiler.PickedTarget.Triple(), LCompiler.Tree[ADAM_AST_PROGRAM].Place,
    LCompiler.Reports);
  if LBackend = nil then
    LCompiler.PrintReports();
    Halt(1);
  end;
  // The sample's own module, lowered alone (SU2.4) and generated (a debug build)
  LUnit := 0;
  for LI := 0 to LCompiler.Tree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
    if ExtractFileName(LCompiler.Tree[LCompiler.Tree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module,
      LI)].Place.FileName) = ADAM_SAMPLE_FILE then
      LUnit := LCompiler.Tree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI);
    end;
  end;
  if LUnit = 0 then
    println("no sample module");
    Halt(1);
  end;
  LModule := LowerUnit(LCompiler.Tree, LCompiler.PickedTarget, LCompiler.Reports, LUnit);
  if LCompiler.Reports.HasErrors() then
    LCompiler.PrintReports();
    Halt(1);
  end;
  LSet := GenerateSections(LModule, LBackend, LCompiler.Tree, LCompiler.PickedTarget, LDebug);
  if LDebug = nil then
    println("no debug information");
    Halt(1);
  end;
  print("{}", DebugInfoText(LDebug, ADAM_SAMPLE_FILE));
  println("sections {}", LSet.SectionCount > 1);
  println("done");
end.
