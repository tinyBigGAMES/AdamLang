  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  ssa_places.adam - The SSA's places: the compiler (imported from its own
  src\, beside bin\) runs in this process on a small sample program it
  writes beside its exe, lowers every unit of it alone (LowerUnit, SU2.4)
  and then the program's parts (LowerProgramParts), and dumps each IR with
  every AST node's place (Adam.Backend.Ssa's Dump). Each instruction of the
  sample's own code prints as its op and the place Lowering stamped on it
  (a debug build, the default: the parts' entry hands the site list to
  HeapSiteList first); then the count of instructions in the whole program
  (the runtime's included) whose node has no place, which must be 0.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | param ssa_places_sample.adam(3,15)
  | slot ssa_places_sample.adam(3,15)
  | store ssa_places_sample.adam(3,15)
  | load ssa_places_sample.adam(5,10)
  | load ssa_places_sample.adam(5,19)
  | add ssa_places_sample.adam(5,10)
  | ret ssa_places_sample.adam(5,3)
  | const ssa_places_sample.adam(12,19)
  | call ssa_places_sample.adam(12,13)
  | address ssa_places_sample.adam(12,3)
  | store ssa_places_sample.adam(12,3)
  | address ssa_places_sample.adam(13,6)
  | load ssa_places_sample.adam(13,6)
  | const ssa_places_sample.adam(13,15)
  | cmp ssa_places_sample.adam(13,6)
  | branch ssa_places_sample.adam(13,3)
  | ret ssa_places_sample.adam(11,1)
  | address ssa_places_sample.adam(14,15)
  | load ssa_places_sample.adam(14,15)
  | const ssa_places_sample.adam(14,24)
  | sub ssa_places_sample.adam(14,15)
  | address ssa_places_sample.adam(14,5)
  | store ssa_places_sample.adam(14,5)
  | jump ssa_places_sample.adam(13,3)
  | jump ssa_places_sample.adam(11,1)
  | ret ssa_places_sample.adam(1,1)
  | ret ssa_places_sample.adam(1,1)
  | ret ssa_places_sample.adam(1,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | codeaddr ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | address ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | codeaddr ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | codeaddr ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | const ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | unreachable ssa_places_sample.adam(11,1)
  | ret ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | ret ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | call ssa_places_sample.adam(11,1)
  | ret ssa_places_sample.adam(11,1)
  | unplaced 0
  | done
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe ssa_places;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Compiler.SourceText, Adam.Compiler.AST,
  Adam.Backend.Ssa, Adam.Backend.Lowering, Adam.Driver.Compiler;

const
  // The sample's file name, written beside this exe
  ADAM_SAMPLE_FILE: string = "ssa_places_sample.adam";

// The sample program's text, one line per element
routine SampleText(): string;
var
  LText: string;
begin
  LText := "module exe ssa_places_sample;\n";
  LText := LText + "\n";
  LText := LText + "routine Twice(const AValue: int32): int32;\n";
  LText := LText + "begin\n";
  LText := LText + "  return AValue + AValue;\n";
  LText := LText + "end;\n";
  LText := LText + "\n";
  LText := LText + "var\n";
  LText := LText + "  GTotal: int32;\n";
  LText := LText + "\n";
  LText := LText + "begin\n";
  LText := LText + "  GTotal := Twice(20);\n";
  LText := LText + "  if GTotal > 30 then\n";
  LText := LText + "    GTotal := GTotal - 1;\n";
  LText := LText + "  end;\n";
  LText := LText + "end.\n";
  return LText;
end;

// Each node's place in ATree as "file(line,col)" (the file's name alone), "" for a node
// with none; indexed by node id
routine NodePlaces(const ATree: ref SyntaxTree): StringArray;
var
  LPlaces: StringArray;
  LPlace: SourcePlace;
  LI: int64;
begin
  setlength(LPlaces, ATree.Count);
  for LI := 1 to ATree.Count - 1 do
    LPlace := ATree[LI].Place;
    if LPlace.IsNone() then
      LPlaces[LI] := "";
    else
      LPlaces[LI] := ExtractFileName(LPlace.FileName) + "(" + IntToStr(int64(LPlace.Line)) +
        "," + IntToStr(int64(LPlace.Column)) + ")";
    end;
  end;
  return LPlaces;
end;

// The op of an instruction's dumped text ALine (its place cut off): the word after
// "iN =", or the first word of an instruction that makes no value
routine OpOf(const ALine: string): string;
var
  LWords: StringArray;
begin
  LWords := SplitString(Trim(ALine), " ");
  if (len(LWords) > 2) and (LWords[1] = "=") then
    return LWords[2];
  end;
  return LWords[0];
end;

// AModule's dump read with APlaces: its instruction lines (indented four spaces) placed in
// the sample printed, every one with no place counted into AUnplaced (the first few shown)
routine ShowModule(const AModule: ref IrModule; const APlaces: StringArray;
  var AUnplaced: int64);
var
  LLines: StringArray;
  LParts: StringArray;
  LI: int64;
begin
  LLines := SplitString(AModule.Dump(APlaces), "\n");
  for LI := 0 to len(LLines) - 1 do
    if StartsStr("    ", LLines[LI]) then
      LParts := SplitString(LLines[LI], ";");
      if len(LParts) < 2 then
        AUnplaced := AUnplaced + 1;
        if AUnplaced <= 10 then
          println("unplaced: {}", Trim(LLines[LI]));
        end;
      else
        if StartsStr(ADAM_SAMPLE_FILE + "(", Trim(LParts[1])) then
          println("{} {}", OpOf(LParts[0]), Trim(LParts[1]));
        end;
      end;
    end;
  end;
end;

var
  LCompiler: ref Compiler;
  LModule: ref IrModule;
  LSample: string;
  LPlaces: StringArray;
  LUnplaced: int64;
  LI: int64;

begin
  LSample := ResolvePath("$P:" + ADAM_SAMPLE_FILE);
  if not WriteAllText(LSample, SampleText()) then
    println("cannot write {}", LSample);
    Halt(1);
  end;
  LCompiler := ref Compiler();
  LCompiler.AddModulePath(ResolvePath("$P:../../../../res/libs/std"));
  LCompiler.AddModulePath(ResolvePath("$P:../../../../res/runtime"));
  LCompiler.Check(LSample);
  if LCompiler.Reports.HasErrors() or (LCompiler.PickedTarget = nil) then
    LCompiler.PrintReports();
    Halt(1);
  end;
  // Every unit lowered alone, in the tree's order, then the program's parts (SU2.4)
  LPlaces := NodePlaces(LCompiler.Tree);
  LUnplaced := 0;
  for LI := 0 to LCompiler.Tree.CountOf(ADAM_AST_PROGRAM, NodeRole.Module) - 1 do
    LModule := LowerUnit(LCompiler.Tree, LCompiler.PickedTarget, LCompiler.Reports,
      LCompiler.Tree.NthOf(ADAM_AST_PROGRAM, NodeRole.Module, LI));
    if LCompiler.Reports.HasErrors() then
      LCompiler.PrintReports();
      Halt(1);
    end;
    ShowModule(LModule, LPlaces, LUnplaced);
  end;
  LModule := LowerProgramParts(LCompiler.Tree, LCompiler.PickedTarget, LCompiler.Reports);
  if LCompiler.Reports.HasErrors() then
    LCompiler.PrintReports();
    Halt(1);
  end;
  ShowModule(LModule, LPlaces, LUnplaced);
  println("unplaced {}", LUnplaced);
  println("done");
end.
