-------------------------------------------------------------------------------
  raven_coverage.adam - ALL of Raven proven, not claimed (PLAN-RAVENAPI V10,
  listing sec 12): every public func of System.Raven.C has a home, read from
  the std sources a release ships. A home is a System.Raven.Ext or
  System.Raven.Raylib member whose `///` doc names the routine in a `C:` tag
  (the names after `C:` to the line's end, on into the next `///` line while
  the tag is empty or ends with `/` or `,`), the std job doing its work
  (STD_HOMES: Raven's memory, task, URL and file routines; one name per job,
  AD.9), or a routine the layer keeps to itself (HIDDEN, with why). Each std
  job `<unit>.<func>` must be a public func of that unit; a word with no
  unit is the language's own (`getmem`, `async` ..). A routine with no home,
  one homed twice, a STD_HOMES / HIDDEN name Raven lacks and a std job its
  unit lacks each fail the row, named on their own line.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | raven 1375 layer 1360 std 7 hidden 8
  | uncovered 0 doubled 0 unknown 0 missing 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_coverage;

import System.SysUtils, System.IO, System.Collections;

type
  // A Raven routine whose job the std (or the language) already does, or one the layer keeps
  // to itself: Jobs says where, or why
  StdHome = record
    // The System.Raven.C name
    Routine: string;
    // Where its job is done, space separated: `<unit>.<func>`, or a word of the language;
    // for a hidden one, why it has no member
    Jobs: string;
  end;

const
  // The std folder, as the row's exe in output\bin\<triple>\<mode> sees it
  STD_FOLDER: string = "$P:../../../../res/libs/std/";
  // What opens a `.C` unit's public routine line
  RAVEN_FUNC: string = "public func clink ";
  // The std homes (listing sec 11)
  STD_HOMES: array[0..6] of StdHome = [
    StdHome(Routine: "Rmemory_alloc", Jobs: "getmem"),
    StdHome(Routine: "Rmemory_realloc", Jobs: "resizemem"),
    StdHome(Routine: "Rtask_run_async", Jobs: "async"),
    StdHome(Routine: "Rparallel_for", Jobs: "for parallel"),
    StdHome(Routine: "Ropen_url", Jobs: "System.Process.OpenURL"),
    StdHome(Routine: "Rfile_read", Jobs: "System.IO.ReadAllBytes"),
    StdHome(Routine: "Rfile_write", Jobs: "System.IO.WriteAllBytes")
  ];
  // The routines the layer keeps to itself
  HIDDEN: array[0..7] of StdHome = [
    StdHome(Routine: "Rset_allocator", Jobs: "Raven's allocator is Adam's heap (UIAppConfig)"),
    StdHome(Routine: "Rallocator_get_system", Jobs: "Raven's allocator is Adam's heap (UIAppConfig)"),
    StdHome(Routine: "Rtheme_apply", Jobs: "deprecated by Raven: UITheme.Look (Rlook_set)"),
    StdHome(Routine: "Rlabel_set_text", Jobs: "UIWidget.Text sets the Text attribute of any kind"),
    StdHome(Routine: "Rbutton_set_text", Jobs: "UIWidget.Text sets the Text attribute of any kind"),
    StdHome(Routine: "Rcheckbox_set_text", Jobs: "UIWidget.Text sets the Text attribute of any kind"),
    StdHome(Routine: "Rtext_input_set_text", Jobs: "UIWidget.Text sets the Text attribute of any kind"),
    StdHome(Routine: "Rtext_editor_set_text", Jobs: "UIWidget.Text sets the Text attribute of any kind")
  ];

var
  // System.Raven.C's routines in their order, and as a set
  GRaven: List<string>;
  GRavenSet: Set<string>;
  // The routines a System.Raven.Ext / System.Raven.Raylib `C:` tag names
  GTagged: Set<string>;
  // A std unit's text by its name, read once
  GUnits: Map<string, string>;

// True for a byte an Adam / C name is made of
func IsNameChar(const AChar: char): bool;
begin
  return ((AChar >= 'a') and (AChar <= 'z')) or ((AChar >= 'A') and (AChar <= 'Z')) or
    ((AChar >= '0') and (AChar <= '9')) or (AChar = '_');
end;

// The std unit AUnit's source (STD_FOLDER + AUnit + ".adam"), read at its first use
func UnitText(const AUnit: string; var AText: string): bool;
var
  LText: string;
begin
  if GUnits.TryGet(AUnit, AText) then
    return true;
  end;
  if not ReadAllText(ResolvePath(STD_FOLDER + AUnit + ".adam"), LText) then
    println("cannot read {}.adam", AUnit);
    return false;
  end;
  GUnits[AUnit] := LText;
  AText := LText;
  return true;
end;

// AText's lines, their line ends dropped
func LinesOf(const AText: string): StringArray;
var
  LLines: StringArray;
  LI: int64;
begin
  LLines := SplitString(AText, "\n");
  for LI := 0 to len(LLines) - 1 do
    LLines[LI] := TrimRight(LLines[LI]);
  end;
  return LLines;
end;

// System.Raven.C's public routines, read into GRaven / GRavenSet
func ReadRaven(): bool;
var
  LText: string;
  LLines: StringArray;
  LI: int64;
  LAt: int64;
  LName: string;
begin
  if not UnitText("System.Raven.C", LText) then
    return false;
  end;
  LLines := LinesOf(LText);
  for LI := 0 to len(LLines) - 1 do
    if StartsStr(RAVEN_FUNC, LLines[LI]) then
      // The name runs from after the prefix to the first byte no name has ('(', ';', ':')
      LAt := len(RAVEN_FUNC);
      while (LAt < len(LLines[LI])) and IsNameChar(LLines[LI][LAt]) do
        LAt += 1;
      end;
      LName := Substring(LLines[LI], len(RAVEN_FUNC), LAt - len(RAVEN_FUNC));
      GRaven.Add(LName);
      GRavenSet.Add(LName);
    end;
  end;
  return true;
end;

// The Raven routines ATag names (any other word in it, prose, is passed over) into GTagged
func NoteTag(const ATag: string);
var
  LAt: int64;
  LStart: int64;
  LWord: string;
begin
  LAt := 0;
  while LAt < len(ATag) do
    if not IsNameChar(ATag[LAt]) then
      LAt += 1;
    else
      LStart := LAt;
      while (LAt < len(ATag)) and IsNameChar(ATag[LAt]) do
        LAt += 1;
      end;
      LWord := Substring(ATag, LStart, LAt - LStart);
      if GRavenSet.Has(LWord) then
        GTagged.Add(LWord);
      end;
    end;
  end;
end;

// AUnit's `C:` tags, read into GTagged
func ReadTags(const AUnit: string): bool;
var
  LText: string;
  LLines: StringArray;
  LI: int64;
  LLine: string;
  LAt: int64;
  LTag: string;
  LGoesOn: bool;
begin
  if not UnitText(AUnit, LText) then
    return false;
  end;
  LLines := LinesOf(LText);
  LGoesOn := false;
  for LI := 0 to len(LLines) - 1 do
    LLine := Trim(LLines[LI]);
    if not StartsStr("///", LLine) then
      LGoesOn := false;
    else
      LAt := IndexOf("C:", LLine, 0);
      LTag := "";
      if LAt >= 0 then
        LTag := Substring(LLine, LAt + 2, len(LLine));
      else
        if LGoesOn then
          LTag := Substring(LLine, 3, len(LLine));
        end;
      end;
      if LTag <> "" then
        NoteTag(LTag);
      end;
      // A tag ending with "C:", '/' or ',' names more routines on the next doc line
      LTag := TrimRight(LTag);
      if LTag = "" then
        LGoesOn := LAt >= 0;
      else
        LGoesOn := (LTag[len(LTag) - 1] = '/') or (LTag[len(LTag) - 1] = ',');
      end;
    end;
  end;
  return true;
end;

// True when AText (a std unit's source) declares the public func AFunc
func HasPublicFunc(const AText: string; const AFunc: string): bool;
begin
  return (IndexOf("\npublic func cpplink " + AFunc + "(", AText, 0) >= 0) or
    (IndexOf("\npublic func " + AFunc + "(", AText, 0) >= 0);
end;

// The std jobs AJobs of the Raven routine ARoutine that no unit declares, each on its line
func MissingJobs(const ARoutine: string; const AJobs: string): int32;
var
  LJobs: StringArray;
  LI: int64;
  LDot: int64;
  LAt: int64;
  LText: string;
  LMissing: int32;
begin
  LMissing := 0;
  LJobs := SplitString(AJobs, " ");
  for LI := 0 to len(LJobs) - 1 do
    // `<unit>.<func>`: the unit is all before the last '.'; no '.' is the language's own
    LDot := -1;
    for LAt := 0 to len(LJobs[LI]) - 1 do
      if LJobs[LI][LAt] = '.' then
        LDot := LAt;
      end;
    end;
    if LDot >= 0 then
      if not UnitText(Substring(LJobs[LI], 0, LDot), LText) or
        not HasPublicFunc(LText, Substring(LJobs[LI], LDot + 1, len(LJobs[LI]))) then
        println("missing {} {}", ARoutine, LJobs[LI]);
        LMissing += 1;
      end;
    end;
  end;
  return LMissing;
end;

var
  GHomed: Set<string>;
  GI: int64;
  GLayer: int32;
  GUncovered: int32;
  GDoubled: int32;
  GUnknown: int32;
  GMissing: int32;

begin
  if not ReadRaven() or not ReadTags("System.Raven.Ext") or not ReadTags("System.Raven.Raylib") then
    return 1;
  end;
  GUncovered := 0;
  GDoubled := 0;
  GUnknown := 0;
  GMissing := 0;
  // The std homes: a routine Raven has, homed once, its jobs where they are said to be
  for GI := 0 to len(STD_HOMES) - 1 do
    if not GRavenSet.Has(STD_HOMES[GI].Routine) then
      println("unknown {}", STD_HOMES[GI].Routine);
      GUnknown += 1;
    end;
    if GTagged.Has(STD_HOMES[GI].Routine) or GHomed.Has(STD_HOMES[GI].Routine) then
      println("doubled {}", STD_HOMES[GI].Routine);
      GDoubled += 1;
    end;
    GHomed.Add(STD_HOMES[GI].Routine);
    GMissing += MissingJobs(STD_HOMES[GI].Routine, STD_HOMES[GI].Jobs);
  end;
  // The hidden ones: a routine Raven has, homed once, no member's tag
  for GI := 0 to len(HIDDEN) - 1 do
    if not GRavenSet.Has(HIDDEN[GI].Routine) then
      println("unknown {}", HIDDEN[GI].Routine);
      GUnknown += 1;
    end;
    if GTagged.Has(HIDDEN[GI].Routine) or GHomed.Has(HIDDEN[GI].Routine) then
      println("doubled {}", HIDDEN[GI].Routine);
      GDoubled += 1;
    end;
    GHomed.Add(HIDDEN[GI].Routine);
  end;
  // Every Raven routine: a layer member's tag, a std home or hidden
  GLayer := 0;
  for GI := 0 to GRaven.Count - 1 do
    if GTagged.Has(GRaven[GI]) then
      GLayer += 1;
    else
      if not GHomed.Has(GRaven[GI]) then
        println("uncovered {}", GRaven[GI]);
        GUncovered += 1;
      end;
    end;
  end;
  println("raven {} layer {} std {} hidden {}", GRaven.Count, GLayer, len(STD_HOMES), len(HIDDEN));
  println("uncovered {} doubled {} unknown {} missing {}", GUncovered, GDoubled, GUnknown,
    GMissing);
end.
