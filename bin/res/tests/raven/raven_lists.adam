-------------------------------------------------------------------------------
  raven_lists.adam - System.Raven.Ext's lists, trees, tables, tiles and menus
  (PLAN-RAVENAPI V5) on Raven's null backend, headless: each widget type's
  Create gives a widget of its kind; a list's stored rows round-trip and a
  virtual list's text comes from its closure (held for Raven past the call);
  a tree's items nest, select, keep a user handle and go with Destroy; a
  table's columns and rows (a '|' kept in a cell) sort by value, a virtual
  table's cells come from its closure; a tile view counts its tiles and
  sections, folds one and selects; a menu bar's menus hold typed items,
  separators and sub-menus (a sub-menu's items its children). In a headless
  window the tiles and headers are described by their closures (UITile /
  UITileHeader), a click on a list row runs OnSelect, a menu item's shortcut
  runs its OnClick; every closure and held text is released with its widget
  or the app: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | kinds true true true true true true
  | list 2 b B 1
  | virtual 1000 row 7
  | tree 1 2 BNF.md Docs README.md true
  | multi 2 true
  | handle true
  | gone false 1
  | table 2 3 Ada|Lovelace Age
  | sorted Bob 1 false Zoe
  | row true 1 Lovelace
  | cells 50 r7c1
  | tiles 6 2 1 true
  | select 1 3
  | taskbar true false
  | menu false Quit true true true 1
  | drawn true true
  | clicks select 0 quit 1
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_lists;

import System.SysUtils, System.Raven.C, System.Raven.Ext;

var
  GMark: int64;
  GSelected: int32;
  GQuits: int64;
  GTiles: int64;
  GHeaders: int64;

// A few frames of the app
func Frames(var AApp: UIApp);
var
  LI: int64;
begin
  for LI := 1 to 5 do
    AApp.WaitFrame(0.01);
  end;
end;

func Tests();
var
  LApp: UIApp;
  LWindow: Rid;
  LRoot: UIVBox;
  LList: UIListView;
  LVirtual: UIListView;
  LTree: UITreeView;
  LDocs: UITreeItem;
  LReadme: UITreeItem;
  LBnf: UITreeItem;
  LTable: UITable;
  LCells: UITable;
  LRow: UITableRow;
  LTiles: UITileView;
  LBar: UIMenuBar;
  LFile: UIMenu;
  LRecent: UIMenu;
  LQuit: UIMenuItem;
  LContext: UIMenu;
  LB: UIRect;
begin
  LApp := UIApp.Config().AppName("raven_lists").Backend(UIBackend.Null).Headless(true)
    .NoRenderThread(true).Open();
  GSelected := -1;

  // kinds: each type views its own
  LList := UIListView.Create();
  LTree := UITreeView.Create();
  LTable := UITable.Create();
  LTiles := UITileView.Create();
  LBar := UIMenuBar.Create().Native(false);
  LContext := UIMenu.Create();
  println("kinds {} {} {} {} {} {}", LList.Is<UIListView>(), LTree.Is<UITreeView>(),
    LTable.Is<UITable>(), LTiles.Is<UITileView>(), LBar.Is<UIMenuBar>(), LContext.Is<UIMenu>());

  // a list's stored rows
  LList.AddItem("a");
  LList.AddItem("b");
  LList.AddItem("c");
  LList.RemoveItem(0);
  println("list {} {} {} {}", LList.ItemCount(), LList.Item(0), LList.Item(0, "B").Item(0),
    LList.Selected(1).Selected());

  // a virtual list: its text from the closure, held past the call
  LVirtual := UIListView.Create().Virtual(1000, func(const AIndex: int32): string
  begin
    return "row " + IntToStr(AIndex);
  end);
  println("virtual {} {}", LVirtual.ItemCount(), LVirtual.Item(7));
  LVirtual.Destroy();

  // a tree's items
  LDocs := LTree.AddItem("Docs");
  LReadme := LTree.AddItem(LDocs, "README.md");
  LBnf := LTree.AddItem(LDocs, "BNF.md");
  LDocs.Expanded(true);
  LTree.Selected(LReadme);
  println("tree {} {} {} {} {} {}", LTree.ItemCount(), LDocs.ChildCount(), LDocs.Child(1).Text(),
    LBnf.Parent().Text(), LTree.Selected().Text(), LDocs.Expanded());
  LTree.MultiSelect(true);
  LBnf.Selected(true);
  println("multi {} {}", LTree.SelectionCount(), LTree.Selection(1).Id() = LBnf.Id());
  LReadme.UserHandle(addr of GMark);
  println("handle {}", LReadme.UserHandle() = addr of GMark);
  LReadme.Destroy();
  println("gone {} {}", LReadme.IsValid(), LDocs.ChildCount());

  // a table's columns and rows: a '|' stays in a cell, numbers sort by value
  LTable.AddColumn("Name", 160.0f);
  LTable.AddColumn("Age", 60.0f).Align(UITextAlign.Right).Sortable(true);
  LTable.AddRow(["Zoe", "20"]);
  LTable.AddRow(["Ada|Lovelace", "36"]);
  LTable.AddRow(["Bob", "3"]);
  println("table {} {} {} {}", LTable.ColumnCount(), LTable.RowCount(), LTable.Cell(1, 0),
    LTable.Column(1).Header());
  LTable.Sort(1, false);
  println("sorted {} {} {} {}", LTable.Row(0).Cell(0), LTable.SortColumn(), LTable.SortDescending(),
    LTable.Row(1).Cell(0));
  LRow := LTable.AddRow();
  LRow.Cell(0, "Lovelace").Selected(true);
  println("row {} {} {}", LRow.IsValid(), LTable.SelectionCount(), LTable.Row(3).Cell(0));

  // a virtual table: its cells from the closure
  LCells := UITable.Create();
  LCells.AddColumn("A", 0.0f);
  LCells.AddColumn("B", 0.0f);
  LCells.Virtual(50, func(const ARow: int32; const AColumn: int32): string
  begin
    return "r" + IntToStr(ARow) + "c" + IntToStr(AColumn);
  end);
  println("cells {} {}", LCells.RowCount(), LCells.Cell(7, 1));
  LCells.Destroy();

  // a tile view: tiles cut into sections, one folded; a selection
  LTiles.Items(6, func(const AIndex: int32; var ATile: UITile)
  begin
    GTiles := GTiles + 1;
    ATile.Text := "tile " + IntToStr(AIndex);
    ATile.Badge := "new";
  end);
  LTiles.Sections(2, func(const ASection: int32; var AHeader: UITileHeader)
  begin
    GHeaders := GHeaders + 1;
    AHeader.First := ASection * 3;
    AHeader.Text := "Group " + IntToStr(ASection);
  end);
  println("tiles {} {} {} {}", LTiles.Count(), LTiles.SectionCount(), LTiles.SectionOf(4).Index(),
    LTiles.Section(1).Folded(true).Folded());
  LTiles.Section(1).Folded(false);
  LTiles.Selected(1, true).Selected(2, true);
  LTiles.SelectOnly(3);
  println("select {} {}", LTiles.SelectionCount(), LTiles.Selection(0));

  // menus: a bar's menus hold typed items, separators and sub-menus
  LFile := LBar.AddMenu("File");
  LQuit := LFile.AddItem("Quit").Shortcut(UIKey.Q, [UIModifier.Ctrl]);
  LFile.AddSeparator();
  LRecent := LFile.AddMenu("Recent");
  LRecent.AddItem("raven_lists.adam");
  LContext.AddItem("Rename");
  LList.ContextMenu(LContext);
  println("taskbar {} {}", UIApp.TaskbarMenu(LContext), UIApp.TaskbarMenu(LRecent));
  println("menu {} {} {} {} {} {}", LBar.Native(), LQuit.Text(), LQuit.Is<UIMenuItem>(),
    LQuit.Checkable(true).Checked(true).Checked(), LRecent.Is<UIMenu>(), LRecent.ChildCount());

  // in a headless window: tiles and headers drawn through their closures, a click selects a
  // list row, a shortcut runs a menu item
  LRoot := UIVBox.Create();
  LRoot.Add(LBar, UILayout().Auto()).Add(LList, UILayout().Fill(1.0f)).Add(LTiles, UILayout().Fill(2.0f));
  LWindow := Rwindow_create("raven_lists", 400, 400, R_WINDOW_DEFAULT);
  Rwindow_set_content(LWindow, LRoot.Id());
  LList.OnSelect(func(const AIndex: int32)
  begin
    GSelected := AIndex;
  end);
  LQuit.OnClick(func()
  begin
    GQuits := GQuits + 1;
  end);
  Frames(LApp);
  println("drawn {} {}", GTiles > 0, GHeaders > 0);
  LB := LList.Rect();
  Rwindow_inject_mouse_move(LWindow, LB.x + 10.0f, LB.y + 8.0f);
  Rwindow_inject_mouse_button(LWindow, R_MOUSE_LEFT, R_TRUE);
  Rwindow_inject_mouse_button(LWindow, R_MOUSE_LEFT, R_FALSE);
  Frames(LApp);
  Rwindow_inject_key(LWindow, int32(UIKey.Q), R_TRUE, uint32([UIModifier.Ctrl]));
  Rwindow_inject_key(LWindow, int32(UIKey.Q), R_FALSE, uint32([UIModifier.Ctrl]));
  Frames(LApp);
  println("clicks select {} quit {}", GSelected, GQuits);

  LTree.Destroy();
  LTable.Destroy();
  UIApp.TaskbarMenu(UIMenu());
  LContext.Destroy();
  Rwindow_destroy(LWindow);
end;

begin
  Tests();
  println("end");
end.
