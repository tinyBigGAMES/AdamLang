-------------------------------------------------------------------------------
  raven_host.adam - System.Raven.Ext's hosting (PLAN-RAVENAPI V10, listing
  sec 10) on Raven's null backend, headless: an app opened on the host
  platform (UIHost.Register before it, Active while it runs); its windows
  sized and their insets set by the program; a click and typed text
  injected reach a button's closure and a text input; Raven's clipboard
  goes through the program's closures both ways; the other injections, the
  system's dark look, a lost device (the app's reset closure runs) and a
  capture buffer; UIVulkan's reads off Vulkan and its queue lock set
  before the app opens (Raven refuses it while it runs) and cleared after
  Raven has shut down; UIApp.Shutdown ending Raven before the app's last
  copy, a later app opening again on the OS's platform (UIHost.Unregister).
  Raven reports no error through it all (UIErrors.OnError counts them; an
  app's end once cleared the queue lock while Raven still ran). Every
  closure is released when the app ends: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | before false
  | host true true
  | click 1
  | typed A
  | clipboard to-host from-host
  | inject true
  | reset 1
  | capture true
  | vulkan true true true true
  | shutdown false false false
  | again true false
  | errors 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_host;

import System.SysUtils, System.Raven.C, System.Raven.Ext;

func Frames(var AApp: UIApp; const ACount: int32);
var
  LI: int32;
begin
  for LI := 1 to ACount do
    AApp.Frame();
  end;
end;

func Tests();
var
  LApp: UIApp;
  LPlatform: UIHostPlatform;
  LCopied: string;
  LWakes: int32;
  LClicks: int32;
  LResets: int32;
  LButtonWindow: UIWindow;
  LButton: UIButton;
  LInputWindow: UIWindow;
  LInput: UITextInput;
  LInsets: RInsets;
  LPixels: ptr to uint8;
  LExtensions: StringArray;
  LErrors: int32;
begin
  // Every error Raven reports is counted (and shown, so a failing run says which); its warnings
  // (the lost device below is one) are not errors
  LErrors := 0;
  UIErrors.OnError(func(const ACode: UIErrorCode; const ASeverity: UISeverity; const ADetail: string)
    begin
      if (ASeverity = UISeverity.Error) or (ASeverity = UISeverity.Fatal) then
        LErrors += 1;
        println("raven error {}", ADetail);
      end;
    end);
  println("before {}", UIHost.Active());
  LCopied := "";
  LWakes := 0;
  LPlatform := UIHostPlatform()
    .ClipboardSet(func(const AText: string) begin LCopied := AText; end)
    .ClipboardGet(func(): string begin return "from-host"; end)
    .Wake(func() begin LWakes += 1; end);
  UIHost.Register(LPlatform);
  // The Vulkan queue lock: Raven takes it only before the app opens; the app's end clears it
  UIVulkan.QueueLock(func() begin end, func() begin end);
  LApp := UIApp.Config().AppName("raven_host").Backend(UIBackend.Null).Headless(true)
    .NoRenderThread(true).Open();
  println("host {} {}", LApp.IsValid(), UIHost.Active());

  // A click injected at the button's middle
  LClicks := 0;
  LButtonWindow := UIWindow.Create("buttons", 200, 100);
  LButton := UIButton.Create("Go");
  LButton.OnClick(func() begin LClicks += 1; end);
  LButtonWindow.Content(LButton);
  UIHost.WindowSize(LButtonWindow, 200, 100, 1.0f);
  Frames(LApp, 2);
  UIHost.InjectMove(LButtonWindow, 100, 50, []);
  UIHost.InjectButton(LButtonWindow, 100, 50, UIPointerButton.Left, true, []);
  Frames(LApp, 1);
  UIHost.InjectButton(LButtonWindow, 100, 50, UIPointerButton.Left, false, []);
  Frames(LApp, 2);
  println("click {}", LClicks);

  // Text typed into a focused input
  LInputWindow := UIWindow.Create("inputs", 200, 60);
  LInput := UITextInput.Create();
  LInputWindow.Content(LInput);
  UIHost.WindowSize(LInputWindow, 200, 60, 1.0f);
  Frames(LApp, 2);
  UIHost.InjectFocus(LInputWindow, true);
  UIHost.InjectButton(LInputWindow, 100, 30, UIPointerButton.Left, true, []);
  UIHost.InjectButton(LInputWindow, 100, 30, UIPointerButton.Left, false, []);
  Frames(LApp, 1);
  UIHost.InjectText(LInputWindow, 65);
  Frames(LApp, 2);
  println("typed {}", LInput.Text());

  // Raven's clipboard is the program's
  Rclipboard_set_text("to-host");
  println("clipboard {} {}", LCopied, StringFromC(Rclipboard_get_text()));

  // The other injections, the look, the insets
  UIHost.InjectWheel(LButtonWindow, 0.0f, 1.0f, [UIModifier.Shift]);
  UIHost.InjectKey(LInputWindow, UIKey.Backspace, true, [], false);
  UIHost.InjectKey(LInputWindow, UIKey.Backspace, false, [], false);
  UIHost.InjectLeave(LButtonWindow);
  UIHost.InjectFocus(LInputWindow, false);
  UIHost.SystemDark(true);
  LInsets := RInsets(top: 10.0f, right: 0.0f, bottom: 0.0f, left: 0.0f);
  UIHost.Insets(LButtonWindow, LInsets, 0);
  Frames(LApp, 1);
  println("inject {}", LInput.Text() = "");

  // A lost device: Raven makes its textures again and tells the app
  LResets := 0;
  LApp.OnDeviceReset(func() begin LResets += 1; end);
  UIHost.DeviceLost();
  Frames(LApp, 2);
  println("reset {}", LResets);

  // A capture buffer Raven frees
  LPixels := UIHost.CapturePixels(64);
  println("capture {}", LPixels <> nil);
  Rpixels_free(LPixels);

  // Vulkan's reads off Vulkan
  LExtensions := UIVulkan.RequiredInstanceExtensions();
  println("vulkan {} {} {} {}", UIVulkan.Instance() = nil, UIVulkan.Device() = nil,
    UIVulkan.GraphicsQueue() = nil, len(LExtensions) >= 0);

  // Raven ends before the app's last copy goes
  UIApp.Shutdown();
  println("shutdown {} {} {}", LApp.IsValid(), UIApp.Initialized(), LButtonWindow.IsValid());
  LApp := UIApp();

  // The OS's platform again for the next app
  UIHost.Unregister();
  LApp := UIApp.Config().AppName("raven_host again").Backend(UIBackend.Null).Headless(true)
    .NoRenderThread(true).Open();
  println("again {} {}", LApp.IsValid(), UIHost.Active());
  UIApp.Shutdown();
  println("errors {}", LErrors);
  UIErrors.OnError(nil);
end;

begin
  Tests();
end.
