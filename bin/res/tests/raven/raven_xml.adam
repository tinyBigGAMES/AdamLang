  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  raven_xml.adam - System.Raven.Ext's XML (PLAN-RAVENAPI V10, listing sec 9)
  on Raven's null backend, headless: auto-loading and live reload switched,
  a path resolved; a <Widget> declaration registered, listed and forgotten;
  a tag made by code building its widget and taking an attribute (Raven's
  own tags refused); what can be written (tags, children, attributes); a
  document built in code (children at an index, comments, attributes read
  without case, removed, duplicated, moved, XML pasted), written as text,
  saved and loaded again, read from text (a mistake described, not
  reported), built into widgets whose nodes are known both ways, and into
  a window; a node's document borrowed; nodes gone with their document.
  Every closure is released when the app ends: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | switches false false true
  | declared 1 true true false
  | tag true true 1 7 true false false
  | tags true true 2 0 true true
  | doc VBox 3 Label 1 Save true 1 Text Save false true
  | edit 5 true true Slider true
  | text true true true
  | parse false true true true VBox
  | built true true true true true
  | window true
  | borrowed true true
  | gone false false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_xml;

import System.SysUtils, System.IO, System.Raven.C, System.Raven.Ext;

const
  DECLARATIONS: string = "<Widgets><Widget Name=\"Field\" Label=\"Name\"><HBox><Label Text=\"{Label}:\"/></HBox></Widget></Widgets>";

func Tests();
var
  LApp: UIApp;
  LMade: int32;
  LLevel: string;
  LFound: bool;
  LI: int32;
  LBuilt: UIWidget;
  LInfo: RXmlAttributeInfo;
  LDoc: UIXMLDocRes;
  LRoot: UIXMLNode;
  LButton: UIXMLNode;
  LCopy: UIXMLNode;
  LPasted: UIXMLNode;
  LError: RXmlError;
  LBad: UIXMLDocRes;
  LGood: UIXMLDocRes;
  LLoaded: UIXMLDocRes;
  LPath: string;
  LView: UIXMLDocRes;
  LWidget: UIWidget;
  LWindow: UIWindow;
begin
  LApp := UIApp.Config().AppName("raven_xml").Backend(UIBackend.Null).Headless(true)
    .NoRenderThread(true).Open();

  // Switches and paths
  UIXML.AutoLoad(false);
  UIXML.LiveReload(false);
  UIXML.BasePath("");
  UIXML.OnReload(func(const APath: string; const AOk: bool) begin println("reloaded {}", APath); end);
  println("switches {} {} {}", UIXML.AutoLoad(), UIXML.LiveReload(),
    (UIXML.ResolvePath("raven_xml_none.xml") <> "") and (UIXML.CheckFiles() >= 0));

  // A <Widget> declaration
  LFound := false;
  print("declared {} {}", UIXML.RegisterWidgets(DECLARATIONS), UIXML.WidgetRegistered("Field"));
  for LI := 0 to UIXML.RegisteredCount() - 1 do
    if UIXML.RegisteredName(LI) = "Field" then
      LFound := true;
    end;
  end;
  UIXML.UnregisterWidget("Field");
  println(" {} {}", LFound, UIXML.WidgetRegistered("Field"));

  // A tag made by code
  LMade := 0;
  LLevel := "";
  LFound := UIXML.Tag("Gauge", func(const ATag: string): UIWidget begin LMade += 1; return UILabel.Create(ATag); end,
    func(const AWidget: UIWidget; const AName: string; const AValue: string): bool
    begin
      if LowerCase(AName) = "level" then
        LLevel := AValue;
        return true;
      end;
      return false;
    end);
  LBuilt := UIWidget.FromXMLText("<VBox><Gauge Name=\"g\" Level=\"7\"/></VBox>");
  print("tag {} {} {} {} {}", LFound, UIXML.TagRegistered("Gauge"), LMade, LLevel,
    LBuilt.Find<UIWidget>("g").IsValid());
  LBuilt.Destroy();
  UIXML.UnregisterTag("Gauge");
  println(" {} {}", UIXML.TagRegistered("Gauge"), UIXML.Tag("Button", func(const ATag: string): UIWidget begin return UIWidget(); end, nil));

  // What can be written
  println("tags {} {} {} {} {} {}", (UIXML.TagCount() > 0) and (UIXML.TagName(0) <> ""),
    UIXML.TagDescription("Button") <> "", UIXML.TagChildren("VBox"), UIXML.TagChildren("Slider"),
    UIXML.AttributeCount("Button") > 0, UIXML.AttributeInfo("Button", 0, LInfo) and (LInfo.Name() <> ""));

  // A document built in code
  LDoc := UIXMLDocRes.Create("VBox");
  LRoot := LDoc.Root();
  LButton := LRoot.AddChild("Button").Attribute("Text", "Save");
  LRoot.AddComment("the tools");
  LRoot.AddChild("Label", 0).Text("hi");
  print("doc {} {} {} {} {} {} {} {} {}", LRoot.Tag(), LRoot.ChildCount(), LRoot.Child(0).Tag(),
    LButton.Index(), LButton.Attribute("text"), LButton.HasAttribute("TEXT"), LButton.AttributeCount(),
    LButton.AttributeName(0), LButton.AttributeValue(0));
  LButton.RemoveAttribute("Text");
  println(" {} {}", LButton.HasAttribute("Text"), LRoot.Child(2).IsComment());
  LButton.Attribute("Text", "Save");
  LCopy := LButton.Duplicate();
  LPasted := LRoot.AddXML("<Slider Name=\"volume\"/>");
  println("edit {} {} {} {} {}", LRoot.ChildCount(), LCopy.Index() = LButton.Index() + 1,
    LCopy.Move(LRoot, 0) and (LRoot.Child(0).Id() = LCopy.Id()), LPasted.Tag(),
    LButton.Document().Id() = LDoc.Id());

  // Written as text, saved and loaded
  LPath := ResolvePath("raven_xml_doc.xml", TempDir());
  println("text {} {} {}", IndexOf("<Button", LDoc.ToString(), 0) >= 0,
    (LButton.Line() >= 1) and (IndexOf("Slider", LPasted.ToString(), 0) >= 0),
    LDoc.Save(LPath) and UIXMLDocRes(LPath).IsValid());
  LLoaded := UIXMLDocRes(LPath);
  DeleteFile(LPath);

  // Read from text: a mistake described, not reported
  LBad := UIXMLDocRes.Parse("<VBox><Button></VBox>", LError);
  LGood := UIXMLDocRes.Parse("<VBox><Label Text=\"x\"/></VBox>");
  println("parse {} {} {} {} {}", LBad.IsValid(), LError.line >= 1, LError.Message() <> "",
    LGood.IsValid(), LLoaded.Root().Tag());

  // Built into widgets: each node knows its widget, each widget its node
  LWidget := LDoc.CreateWidget();
  println("built {} {} {} {} {}", LWidget.IsValid(), LWidget.XMLNode().Id() = LRoot.Id(),
    LButton.Widget().IsValid(), LButton.Widget().XMLNode().Id() = LButton.Id(),
    LWidget.Find<UIWidget>("volume").IsValid());
  LWidget.Destroy();

  // Into a window
  LGood := UIXMLDocRes.Parse("<Window Title=\"T\" Width=\"200\" Height=\"100\"><Label Text=\"x\"/></Window>");
  LWindow := LGood.CreateWindow();
  println("window {}", LWindow.IsValid());
  LWindow.Destroy();

  // A node's document is borrowed: letting go of it leaves the document
  LView := LButton.Document();
  LView := UIXMLDocRes();
  println("borrowed {} {}", LDoc.IsValid(), LButton.IsValid());

  // The document goes, its nodes with it
  LDoc := UIXMLDocRes();
  println("gone {} {}", LButton.IsValid(), LRoot.IsValid());
  UIXML.OnReload(nil);
end;

begin
  Tests();
end.
