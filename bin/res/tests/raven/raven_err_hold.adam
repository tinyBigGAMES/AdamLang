  raven_err_hold.adam - System.Raven.Ext's resource holders stay inside the
  unit: UITrayHold, the tray icon's holder, is not public (as UITextureHold,
  UIFontHold .. are not), so a program naming it is refused (SM0021). The
  tray handle a program uses, UITrayRes, stays public.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe raven_err_hold;

import System.Raven.Ext;

var
  LTray: UITrayRes;
  LHold: UITrayHold; // ERROR SM0021@10: 'UITrayHold' is not declared
  LTexture: UITextureHold; // ERROR SM0021@13: 'UITextureHold' is not declared

begin
end.
