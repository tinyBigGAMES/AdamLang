-------------------------------------------------------------------------------
  raven_editors.adam - System.Raven.Ext's editors and rich views (PLAN-RAVENAPI
  V6) on Raven's null backend, headless: each widget type's Create gives a
  widget of its kind; a text editor's lines, cursor, insert, undo / redo and
  selection round-trip (UITextPos / UITextSpan), its OnChanged runs for an
  insert, an undo and a redo, its colouring language and tokens read back and
  its markers count; a file browser reads a folder, refuses a missing one and
  takes filters and a name; a carousel steps through its pages (stopping at
  the last, looping when set) and reads back its switches. In a headless
  window a custom widget's measure closure sizes it and its paint closure
  draws through a UIPainter (shapes, clip, a spring), and a viewport's resize
  closure gets its pixel size; every closure is released with its widget or
  the app: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | kinds true true true true true
  | lines 2 beta 10 alpha|beta
  | cursor 1 2
  | insert beXta true 1
  | undo beta true 2
  | redo beXta 3
  | select alpha true 0 5
  | language C Comment Text
  | modes true 1.5 Markdown
  | markers 2 0
  | browser true false true 0
  | carousel 3 1 2 2 0 2
  | switches true 2.5 false true Vertical
  | measured 120 40
  | painted true 0.25
  | viewport true false false
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_editors;

import System.SysUtils, System.Raven.C, System.Raven.Ext;

var
  GChanges: int64;
  GPaints: int64;
  GResizes: int64;
  GSpring: RSpring;
  GSpringValue: float32;

// A few frames of the app
func Frames(var AApp: UIApp);
var
  LI: int64;
begin
  for LI := 1 to 5 do
    AApp.WaitFrame(0.01);
  end;
end;

func Tests();
var
  LApp: UIApp;
  LWindow: Rid;
  LRoot: UIHBox;
  LEditor: UITextEditor;
  LBrowser: UIFileBrowser;
  LView: UIViewport;
  LBox: UICustom;
  LShow: UICarousel;
  LSpan: UITextSpan;
  LNative: RNativeWindow;
  LFolder: string;
  LB: UIRect;
begin
  LApp := UIApp.Config().AppName("raven_editors").Backend(UIBackend.Null).Headless(true)
    .NoRenderThread(true).Open();

  // kinds: each type views its own
  LEditor := UITextEditor.Create("alpha\nbeta");
  LBrowser := UIFileBrowser.Create();
  LView := UIViewport.Create();
  LBox := UICustom.Create();
  LShow := UICarousel.Create();
  println("kinds {} {} {} {} {}", LEditor.Is<UITextEditor>(), LBrowser.Is<UIFileBrowser>(),
    LView.Is<UIViewport>(), LBox.Is<UICustom>(), LShow.Is<UICarousel>());

  // a text editor's lines, cursor, edits and selection
  println("lines {} {} {} {}", LEditor.LineCount(), LEditor.Line(1), LEditor.Length(),
    LEditor.Line(0) + "|" + LEditor.Line(1));
  LEditor.OnChanged(func()
  begin
    GChanges := GChanges + 1;
  end);
  LEditor.Cursor(UITextPos(Line: 1, Column: 2));
  println("cursor {} {}", LEditor.Cursor().Line, LEditor.Cursor().Column);
  LEditor.Insert("X");
  println("insert {} {} {}", LEditor.Line(1), LEditor.CanUndo(), GChanges);
  LEditor.Undo();
  println("undo {} {} {}", LEditor.Line(1), LEditor.CanRedo(), GChanges);
  LEditor.Redo();
  println("redo {} {}", LEditor.Line(1), GChanges);
  LEditor.Select(UITextSpan(First: UITextPos(Line: 0, Column: 0), Last: UITextPos(Line: 0, Column: 5)));
  LSpan := LEditor.Selection();
  println("select {} {} {} {}", LEditor.SelectedText(), LEditor.HasSelection(), LSpan.First.Column,
    LSpan.Last.Column);

  // colouring by a language: a comment's token, plain text past the line
  LEditor.Text("int x; // hi");
  LEditor.Syntax(UISyntax.C);
  println("language {} {} {}", LEditor.Language(), nameof(LEditor.Token(UITextPos(Line: 0, Column: 8))),
    nameof(LEditor.Token(UITextPos(Line: 0, Column: 40))));
  LEditor.Markdown(true).Zoom(1.5f).ReadOnly(true).WordWrap(true).LineNumbers(true).TabSize(2)
    .TabSpaces(true).Placeholder("type here").Zoomable(true).Completion(true).CompletionWords(true)
    .AutoPairs(true).AddCompletion("begin", "keyword").AddCompletion("proc", "snippet", "func ()");
  println("modes {} {} {}", LEditor.Markdown(), LEditor.Zoom(), LEditor.Language());
  LEditor.AddMarker(0, 0, 3, UIMarkKind.Error, "bad").AddMarker(0, 4, 5, UIMarkKind.Info, "x");
  print("markers {} ", LEditor.MarkerCount());
  println("{}", LEditor.ClearMarkers().MarkerCount());
  LEditor.OnZoom(func(const AValue: float32) begin end).OnCompletion(func(const AText: string) begin end)
    .OnHover(func(const ALine: int32; const AColumn: int32): string
  begin
    return "line " + IntToStr(ALine);
  end);

  // a file browser: the working folder, a missing one, filters and a name
  LFolder := LBrowser.Directory();
  LBrowser.Mode(UIBrowserMode.Save).Filters([UIFileFilter(Name: "Adam", Patterns: "*.adam"),
    UIFileFilter(Name: "All", Patterns: "")]).FileName("out.adam").DefaultExtension("adam")
    .ShowHidden(true).Multiple(false).ControlsVisible(true).PlacesVisible(false).Select("no-such")
    .Refresh();
  LBrowser.OnAccept(func(const APath: string) begin end).OnCancel(func() begin end)
    .OnSelect(func(const APath: string) begin end);
  println("browser {} {} {} {}", LFolder <> "", LBrowser.Directory("no/such/folder/here"),
    LBrowser.Directory() = LFolder, LBrowser.SelectionCount());

  // a carousel's pages: stops at the last, loops when set
  LShow.Add(UILabel.Create("one")).Add(UILabel.Create("two")).Add(UILabel.Create("three"));
  print("carousel {} ", LShow.PageCount());
  print("{} ", LShow.Page(1, false).Page());
  print("{} ", LShow.Next().Page());
  print("{} ", LShow.Next().Page());
  LShow.Loop(true);
  print("{} ", LShow.Next().Page());
  println("{}", LShow.Prev().Page());
  LShow.Autoplay(2.5).Indicators(false).Arrows(true).Orientation(UIOrientation.Vertical);
  LShow.OnChanged(func(const AIndex: int32) begin end);
  println("switches {} {} {} {} {}", LShow.Loop(), LShow.Autoplay(), LShow.Indicators(), LShow.Arrows(),
    nameof(LShow.Orientation()));

  // in a headless window: a custom widget measured and painted, a viewport sized
  LBox.OnMeasure(func(var ASize: UISize)
  begin
    ASize.w := 120.0f;
    ASize.h := 40.0f;
  end);
  LBox.OnPaint(func(const APainter: UIPainter; const AWidth: float32; const AHeight: float32)
  var
    LColor: UIColor;
  begin
    GPaints := GPaints + 1;
    LColor := UIColor.FromRGBA(58, 123, 213);
    APainter.Shadow(UIRect(x: 2.0f, y: 2.0f, w: AWidth - 4.0f, h: AHeight - 4.0f), 6.0f, LColor, 4.0f);
    APainter.Rect(UIRect(x: 0.0f, y: 0.0f, w: AWidth, h: AHeight), LColor, 4.0f);
    APainter.PushClip(UIRect(x: 0.0f, y: 0.0f, w: AWidth / 2.0f, h: AHeight));
    APainter.RectOutline(UIRect(x: 1.0f, y: 1.0f, w: AWidth - 2.0f, h: AHeight - 2.0f), 1.0f, LColor, 4.0f);
    APainter.Circle(UIPoint(x: 20.0f, y: 20.0f), 8.0f, LColor);
    APainter.PopClip();
    APainter.Line(UIPoint(x: 0.0f, y: 0.0f), UIPoint(x: AWidth, y: AHeight), 2.0f, LColor);
    APainter.Curve(UIPoint(x: 0.0f, y: 0.0f), UIPoint(x: 30.0f, y: 0.0f), UIPoint(x: 60.0f, y: 40.0f),
      UIPoint(x: 90.0f, y: 40.0f), 1.5f, LColor);
    APainter.Triangle(UIPoint(x: 0.0f, y: 0.0f), UIPoint(x: 10.0f, y: 0.0f), UIPoint(x: 5.0f, y: 8.0f), LColor);
    APainter.Glass(UIRect(x: 0.0f, y: 0.0f, w: 30.0f, h: 20.0f), 4.0f, LColor);
    GSpringValue := APainter.Spring(GSpring, 0.25f, UIMotion.Snappy);
  end);
  LView.Stretch(UIStretch.Fit).FlipY(true).Realtime(false).OnResize(func(const AWidth: int32; const AHeight: int32)
  begin
    GResizes := GResizes + 1;
  end).OnDraw(func(const AInfo: RViewportDrawInfo) begin end);
  GSpring.value := 0.25f;
  LRoot := UIHBox.Create();
  LRoot.Add(LBox, UILayout().Auto().VAlign(UIVAlign.Top)).Add(LView, UILayout().Fill(1.0f)).Add(LEditor, UILayout().Fill(1.0f))
    .Add(LShow, UILayout().Fill(1.0f));
  LWindow := Rwindow_create("raven_editors", 600, 300, R_WINDOW_DEFAULT);
  Rwindow_set_content(LWindow, LRoot.Id());
  Frames(LApp);
  LB := LBox.Rect();
  println("measured {} {}", int32(LB.w), int32(LB.h));
  println("painted {} {}", GPaints > 0, GSpringValue);
  println("viewport {} {} {}", (GResizes > 0) and (LView.PixelSize().w > 0.0f), LView.Native(true),
    LView.NativeHandle(LNative));

  LBrowser.Destroy();
  Rwindow_destroy(LWindow);
end;

begin
  Tests();
  println("end");
end.
