  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  raven_charts.adam - System.Raven.Ext's charts, documents and maps
  (PLAN-RAVENAPI V7) on Raven's null backend, headless: each widget type's
  Create gives a widget of its kind; a plot's series take, append and read
  back points, are named, hidden and removed, its axes and drag lines read
  back what is set; a chart's pie slices total and select, a gauge keeps its
  range, value and bands, a heatmap its cells and labels, a sparkline its
  values; a PDF view refuses bytes that are no PDF (unavailable without
  PDFium) and keeps its zoom and fit; a PDF the program writes measures its
  text and comes out as a PDF file in memory; a map keeps its center, zoom
  range, tiles' size and path, attribution and markers. Every closure is
  released with its widget, the document with its last handle: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | kinds true true true true Donut
  | series 2 sin cos
  | points 3 2 4
  | append 5 6 0
  | visible false true
  | axis time Log 1 10 false
  | lines 2 0.5 1
  | removed 1 cos
  | pie 2 100 B 70 1
  | slices 1 B 90
  | gauge Gauge 0 200 120 2
  | heatmap 2 3 6 r1 c3
  | sparkline 4 3 9
  | pdfview false true 0 None Page
  | document false true 1 true true true
  | file true true
  | map 48856 2352 12 2 18 18
  | tiles 512 tiles/{z}/{x}/{y}.png OSM None 0
  | markers 2 1 0
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_charts;

import System.Raven.C, System.Raven.Ext;

func Tests();
var
  LApp: UIApp;
  LPlot: UIPlot;
  LChart: UIChart;
  LView: UIPDFView;
  LMap: UIMapView;
  LSin: UIPlotSeries;
  LCos: UIPlotSeries;
  LPoint: UIPlotPoint;
  LRange: UIRange;
  LLine: UIDragLine;
  LSlice: UIChartSlice;
  LEmpty: UIPDFDocRes;
  LDoc: UIPDFDocRes;
  LFile: array of uint8;
  LPlace: UILatLon;
  LMarker: UIMapMarker;
  LStatus: UIPDFStatus;
begin
  LApp := UIApp.Config().AppName("raven_charts").Backend(UIBackend.Null).Headless(true)
    .NoRenderThread(true).Open();

  // kinds: each type views its own
  LPlot := UIPlot.Create();
  LChart := UIChart.Create(UIChartKind.Donut);
  LView := UIPDFView.Create();
  LMap := UIMapView.Create();
  println("kinds {} {} {} {} {}", LPlot.Is<UIPlot>(), LChart.Is<UIChart>(), LView.Is<UIPDFView>(),
    LMap.Is<UIMapView>(), nameof(LChart.ChartKind()));

  // a plot's series: points set, appended, added, read back and cleared
  LPlot.Title("Signal").Legend(UILegendPlace.TopRight).Crosshair(true).MouseText(true).Tooltips(true);
  LSin := LPlot.AddSeries("sin");
  LCos := LPlot.AddSeries("cos");
  println("series {} {} {}", LPlot.SeriesCount(), LSin.Name(), LPlot.Series(1).Name());
  LSin.Data([0.0, 1.0, 2.0], [0.0, 4.0, 8.0]);
  LPoint := LSin.Point(1);
  println("points {} {} {}", LSin.PointCount(), int32(LPoint.X * 2.0), int32(LPoint.Y));
  LSin.Append([3.0], [6.0]).Add(4.0, 2.0);
  LPoint := LSin.Point(3);
  print("append {} {} ", LSin.PointCount(), int32(LPoint.Y));
  println("{}", LSin.ClearData().PointCount());
  LSin.Color(UIColor.FromRGBA(58, 123, 213)).Line(UILineStyle.Dashed, 2.0f)
    .Marker(UIMarkerShape.Circle, 4.0f).MarkerFilled(true).Step(true).Fill(0.25f).MaxPoints(100)
    .Axes(UIAxis.X, UIAxis.Y2).Visible(false);
  println("visible {} {}", LSin.Visible(), LCos.Visible());

  // its axes
  LPlot.Axis(UIAxis.X).Label("time").Scale(UIAxisScale.Log).Range(1.0, 10.0).Format("%.1f")
    .Grid(true).Inverted(false).Locked(false).Visible(true).LinearThreshold(1.0);
  LRange := LPlot.Axis(UIAxis.X).Range();
  println("axis {} {} {} {} {}", LPlot.Axis(UIAxis.X).Label(), nameof(LPlot.Axis(UIAxis.X).Scale()),
    int32(LRange.Min), int32(LRange.Max), LPlot.Axis(UIAxis.X).AutoFit());

  // drag lines
  LLine := LPlot.AddDragLine(UIAxis.X, 0.5, "start");
  LPlot.AddDragLine(UIAxis.Y, 2.0, "");
  print("lines {} {} ", LPlot.DragLineCount(), LLine.Value());
  println("{}", int32(LPlot.DragLine(1).Value(1.0).Color(UIColor.FromRGBA(200, 40, 40)).Value()));
  LPlot.OnViewChanged(func() begin end).OnDragLine(func(const ALine: UIDragLine; const AValue: float64) begin end)
    .OnSeriesToggled(func(const ASeries: UIPlotSeries; const AVisible: bool) begin end);
  LSin.Remove();
  println("removed {} {}", LPlot.SeriesCount(), LPlot.Series(0).Name());

  // a chart: pie slices
  LChart.Title("Disk").Format("%.0f").Legend(true).Hole(0.5f).CenterText("61%", "used");
  LChart.AddSlice("A", 30.0);
  LSlice := LChart.AddSlice("B", 70.0);
  LChart.Selected(1);
  println("pie {} {} {} {} {}", LChart.SliceCount(), int32(LChart.Total()), LSlice.Label(),
    int32(LSlice.Value()), LChart.Selected());
  LChart.Slice(0).Remove();
  LChart.Slice(0).Value(90.0).Color(UIColor.FromRGBA(40, 160, 90));
  println("slices {} {} {}", LChart.SliceCount(), LChart.Slice(0).Label(), int32(LChart.Total()));
  LChart.OnSliceClick(func(const ASlice: UIChartSlice; const ASelected: bool) begin end);

  // a gauge
  LChart.Kind(UIChartKind.Gauge).Range(0.0, 200.0).Value(120.0)
    .AddBand(0.0, 100.0, UIColor.FromRGBA(40, 160, 90)).AddBand(100.0, 200.0, UIColor.FromRGBA(200, 40, 40));
  LRange := LChart.Range();
  println("gauge {} {} {} {} {}", nameof(LChart.ChartKind()), int32(LRange.Min), int32(LRange.Max),
    int32(LChart.Value()), LChart.BandCount());

  // a heatmap
  LChart.Kind(UIChartKind.Heatmap).Grid(2, 3, [1.0f, 2.0f, 3.0f, 4.0f, 5.0f, 6.0f])
    .RowLabels(["r0", "r1"]).ColumnLabels(["c1", "c2", "c3"])
    .ColorScale(UIColor.FromRGBA(0, 0, 0), UIColor.FromRGBA(255, 255, 255));
  LChart.OnCellClick(func(const ARow: int32; const AColumn: int32; const AValue: float32) begin end);
  println("heatmap {} {} {} {} {}", LChart.RowCount(), LChart.ColumnCount(), int32(LChart.Cell(1, 2)),
    LChart.RowLabel(1), LChart.ColumnLabel(2));

  // a sparkline
  LChart.Kind(UIChartKind.Sparkline).Values([1.0f, 5.0f, 3.0f]).Push(9.0f, 0).Fill(true).Marker(true)
    .Color(UIColor.FromRGBA(58, 123, 213));
  println("sparkline {} {} {}", LChart.ValueCount(), int32(LChart.ValueAt(2)), int32(LChart.ValueAt(3)));

  // a PDF view: bytes that are no PDF refused (no PDFium: unavailable); zoom and fit
  LStatus := UIPDFStatus.Error;
  if not UIPDFView.Available() then
    LStatus := UIPDFStatus.Unavailable;
  end;
  print("pdfview {} {} {} ", LView.LoadMemory([uint8(1), uint8(2), uint8(3)]), LView.Status() = LStatus,
    LView.PageCount());
  LView.Zoom(2.0f);
  print("{} ", nameof(LView.Fit()));
  println("{}", nameof(LView.Fit(UIPDFFit.Page).Fit()));
  LView.OnPageChanged(func(const AIndex: int32) begin end);
  LView.Close();

  // a PDF the program writes
  LDoc := UIPDFDocRes("raven_charts");
  print("document {} {} ", LEmpty.IsValid(), LDoc.IsValid());
  LDoc.Author("Adam").Subject("V7").AddPage(595.28f, 841.89f).Font(UIPDFFont.Sans, 12.0f, [UIPDFText.Bold]);
  LDoc.FillColor(UIColor.FromRGBA(40, 44, 52)).StrokeColor(UIColor.FromRGBA(58, 123, 213)).LineWidth(2.0f)
    .Rect(UIRect(x: 56.0f, y: 56.0f, w: 200.0f, h: 40.0f), 6.0f, [UIPDFPaint.Fill, UIPDFPaint.Stroke])
    .Ellipse(UIRect(x: 56.0f, y: 120.0f, w: 80.0f, h: 40.0f), [UIPDFPaint.Stroke])
    .Line(UIPoint(x: 56.0f, y: 200.0f), UIPoint(x: 300.0f, y: 200.0f))
    .Image(UIRect(x: 56.0f, y: 220.0f, w: 20.0f, h: 20.0f), [uint8(255), uint8(0), uint8(0), uint8(255)], 1, 1);
  println("{} {} {} {}", LDoc.PageCount(), LDoc.Measure("Hello") > 0.0f, LDoc.LineHeight() > 0.0f,
    LDoc.Text(UIPoint(x: 56.0f, y: 260.0f), "Hello") > 0.0f);
  LDoc.Paragraph(UIPoint(x: 56.0f, y: 300.0f), 200.0f, "A paragraph wrapped at its spaces.", UIHAlign.Left);
  LFile := LDoc.ToMemory();
  println("file {} {}", len(LFile) > 100, (LFile[0] = uint8(37)) and (LFile[1] = uint8(80)) and
    (LFile[2] = uint8(68)) and (LFile[3] = uint8(70)));

  // a map
  LMap.Center(48.8566, 2.3522).ZoomRange(2.0, 18.0).Zoom(12.0);
  LPlace := LMap.Center();
  LRange := LMap.ZoomRange();
  print("map {} {} {} {} {} ", int32(LPlace.Latitude * 1000.0), int32(LPlace.Longitude * 1000.0),
    int32(LMap.Zoom()), int32(LRange.Min), int32(LRange.Max));
  println("{}", int32(LMap.Zoom(20.0).Zoom()));
  LMap.TileSize(512).TilePath("tiles/{z}/{x}/{y}.png").Attribution("OSM").CacheSize(1048576);
  println("tiles {} {} {} {} {}", LMap.TileSize(), LMap.TilePath(), LMap.Attribution(),
    nameof(LMap.TileState(0, 0, 0)), LMap.CacheUsage());
  LMarker := LMap.AddMarker(48.8584, 2.2945, "Eiffel");
  LMap.AddMarker(48.8606, 2.3376, "Louvre").Color(UIColor.FromRGBA(200, 40, 40));
  LMarker.Position(48.8583, 2.2944).Label("Tour Eiffel");
  print("markers {} ", LMap.MarkerCount());
  LMarker.Remove();
  print("{} ", LMap.MarkerCount());
  println("{}", LMap.ClearMarkers().MarkerCount());
  LMap.OnTile(func(const AZoom: int32; const AX: int32; const AY: int32) begin end)
    .OnTileCancel(func(const AZoom: int32; const AX: int32; const AY: int32) begin end)
    .OnMarkerClick(func(const AMarker: UIMapMarker) begin end)
    .OnViewChanged(func(const ALatitude: float64; const ALongitude: float64; const AZoom: float64) begin end);

  LPlot.Destroy();
  LChart.Destroy();
  LView.Destroy();
  LMap.Destroy();
end;

begin
  Tests();
  println("end");
end.
