-------------------------------------------------------------------------------
  raven_window.adam - System.Raven.Ext's windows (PLAN-RAVENAPI V3,
  listing sec 4) on Raven's headless Null backend: a window opened by
  UIWindowConfig in one chain (title, size, min size, content), its content
  found through the window, its title and size changed and read back, a
  widget's Window() and an event's Window() naming it; the window's event
  hook seeing the injected pointer; a popup open (HasPopup, PopupCount,
  PopupOpen) then closed with its result told to its OnClosed once; a
  dialog the same; no drag on (UIDrag); no touch; an OnClose that refuses
  keeping the window open, one that agrees letting it close; a second
  window owned by the first, Raven destroying it, the sweep releasing its
  closures; Destroy() making the handle invalid. Every closure is released
  with its window or the app: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | config raven_window 320x200 valid true
  | content root find true has true false
  | title renamed size 400x300
  | widget window true none false
  | hook true window true
  | popup true 1 open true
  | popup closed 5 1 false
  | dialog true
  | dialog closed 7 1 false
  | drag false touch 0
  | refused true asked 1
  | owned true
  | agreed false asked 2
  | swept true
  | destroyed false
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_window;

import System.SysUtils, System.Raven.C, System.Raven.Ext;

var
  GHooked: int64;
  GHookWindow: bool;
  GWindowId: Rid;
  GPopupResult: int32;
  GPopupCalls: int64;
  GDialogResult: int32;
  GDialogCalls: int64;
  GAsked: int64;
  GResized: int64;

// The app's frames run ACount times (the injected input handled, closes done)
func Frames(var AApp: UIApp; const ACount: int64);
var
  LI: int64;
begin
  for LI := 1 to ACount do
    AApp.WaitFrame(0.01);
  end;
end;

func Tests();
var
  LConfig: UIAppConfig;
  LApp: UIApp;
  LWindow: UIWindow;
  LSecond: UIWindow;
  LRoot: UIWidget;
  LButton: UIWidget;
  LPopup: UIWidget;
  LDialog: UIWidget;
  LSize: UISize;
  LAt: UIPoint;
begin
  LConfig := UIApp.Config().AppName("raven_window").Backend(UIBackend.Null);
  LApp := LConfig.Headless(true).NoRenderThread(true).Open();

  // opened in one chain, its content found through the window
  LButton := UIWidget.Create(UIWidgetKind.Button).Name("go");
  LRoot := UIWidget.Create(UIWidgetKind.VBox).Name("root").Add(LButton, UILayout().Fill(1.0f));
  LWindow := UIWindow.Config().Title("raven_window").Size(320, 200).MinSize(100, 80)
    .Content(LRoot).Open();
  GWindowId := LWindow.Id();
  LSize := LWindow.Size();
  println("config {} {}x{} valid {}", LWindow.Title(), int32(LSize.w), int32(LSize.h),
    LWindow.IsValid());
  println("content {} find {} has {} {}", LWindow.Content().Name(),
    LWindow.Find<UIWidget>("go").IsValid(), LWindow.Has<UIWidget>("go"),
    LWindow.Has<UIWidget>("nobody"));
  LSize := LWindow.Title("renamed").Size(400, 300).Size();
  println("title {} size {}x{}", LWindow.Title(), int32(LSize.w), int32(LSize.h));
  println("widget window {} none {}", LButton.Window().Id() = LWindow.Id(),
    UIWidget.Create(UIWidgetKind.Label).Window().IsValid());

  // the event hook sees the injected pointer before any widget
  LWindow.OnEvent(func(const AEvent: REvent): bool
  begin
    GHooked := GHooked + 1;
    if AEvent.Window().Id() = GWindowId then
      GHookWindow := true;
    end;
    return false;
  end);
  Frames(LApp, 2);
  LAt.x := 20.0f;
  LAt.y := 20.0f;
  LWindow.InjectMove(LAt).InjectButton(UIPointerButton.Left, true)
    .InjectButton(UIPointerButton.Left, false);
  Frames(LApp, 3);
  println("hook {} window {}", GHooked > 0, GHookWindow);
  LWindow.OnEvent(nil);

  // a popup and a dialog, each told its result once
  LPopup := UIWidget.Create(UIWidgetKind.Label);
  LPopup.Text("menu");
  LWindow.Popup(LPopup, LAt, func(const AResult: int32)
  begin
    GPopupResult := AResult;
    GPopupCalls := GPopupCalls + 1;
  end);
  Frames(LApp, 2);
  println("popup {} {} open {}", LWindow.HasPopup(), LWindow.PopupCount(),
    UIWindow.PopupOpen(LPopup));
  UIWindow.ClosePopup(LPopup, 5);
  Frames(LApp, 2);
  println("popup closed {} {} {}", GPopupResult, GPopupCalls, LWindow.HasPopup());
  LDialog := UIWidget.Create(UIWidgetKind.Label);
  LDialog.Text("sure?");
  LWindow.Dialog(LDialog, func(const AResult: int32)
  begin
    GDialogResult := AResult;
    GDialogCalls := GDialogCalls + 1;
  end);
  Frames(LApp, 2);
  println("dialog {}", LWindow.HasDialog());
  UIWindow.CloseDialog(LDialog, 7);
  Frames(LApp, 2);
  println("dialog closed {} {} {}", GDialogResult, GDialogCalls, LWindow.HasDialog());
  println("drag {} touch {}", UIDrag.Active(LWindow), LWindow.TouchCount());

  // a second window: an OnClose that refuses keeps it, one that agrees lets it close
  LSecond := UIWindow.Create("second", 200, 100);
  LSecond.OnClose(func(): bool
  begin
    GAsked := GAsked + 1;
    return false;
  end);
  LSecond.Close();
  Frames(LApp, 2);
  println("refused {} asked {}", LSecond.IsValid(), GAsked);
  // headless: no window system keeps it with its owner (false), the owner is still set
  LSecond.Owner(LWindow);
  println("owned {}", LSecond.Owner().Id() = LWindow.Id());
  LSecond.OnResize(func(const AWidth: int32; const AHeight: int32)
  begin
    GResized := GResized + 1;
  end);
  LSecond.OnClose(func(): bool
  begin
    GAsked := GAsked + 1;
    return true;
  end);
  LSecond.Close();
  Frames(LApp, 2);
  println("agreed {} asked {}", LSecond.IsValid(), GAsked);

  // its closures go when a closure is next set for any window (Raven told no destroy)
  LWindow.OnKeyboard(func(const AVisible: bool; const AHeight: float32)
  begin
  end);
  println("swept {}", not LSecond.IsValid());
  LWindow.OnKeyboard(nil);

  LWindow.Destroy();
  println("destroyed {}", LWindow.IsValid());
end;

begin
  Tests();
  println("end");
end.
