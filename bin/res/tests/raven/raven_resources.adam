-------------------------------------------------------------------------------
  raven_resources.adam - System.Raven.Ext's resources and theme
  (PLAN-RAVENAPI V9) on Raven's null backend, headless: textures from pixels,
  PNG bytes, an IO and SVG text read back their size and density, decode to
  pixels and update; the last copy of a handle destroys the texture, a
  borrowed view never does; what shows a texture, font or shader (an image,
  viewport, window background, tab / tree / menu / dock / node icon, label,
  editor, border, the theme) keeps it while it is set and lets it go with
  itself; built-in fonts measure and derive variants; built-in effects are
  found by kind and name; the theme keeps its look, colours, sizes,
  material, font, wallpaper and token colours, and loads, uses and saves an
  XML theme. Every closure and handle is released: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | pixels true 2 2 1 true
  | updated 3 1
  | decoded 2 1 255 0 128 0
  | png true 2 1 true
  | io true 2 1
  | svg true 8 4 2
  | empty false false false false
  | shared true true false
  | view true true
  | kept true false
  | keeps true true false
  | tree true false
  | window true false
  | fonts true true true true true
  | font kept true true false
  | effects aurora true true false true
  | border true true
  | theme false true RavenGlassDark 9 Glass 128
  | theme font true true
  | wallpaper true true false
  | tokens 1
  | xml Night true Night true Night
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_resources;

import System.CustomIO, System.Raven.C, System.Raven.Ext;

const
  // A 2 x 1 PNG: a red pixel, then a half-transparent blue one
  PNG_BYTES: array[0..70] of uint8 = [
    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82,
    0, 0, 0, 2, 0, 0, 0, 1, 8, 6, 0, 0, 0, 244, 34, 127,
    138, 0, 0, 0, 14, 73, 68, 65, 84, 120, 218, 99, 248, 207, 192, 0,
    66, 13, 0, 15, 122, 3, 126, 106, 129, 49, 225, 0, 0, 0, 0, 73,
    69, 78, 68, 174, 66, 96, 130];

// AWidth x AHeight pixels, every one opaque grey
func Grey(const AWidth: int32; const AHeight: int32): UIPixels;
var
  LPixels: UIPixels;
  LI: int64;
begin
  LPixels.Width := AWidth;
  LPixels.Height := AHeight;
  setlength(LPixels.RGBA, int64(AWidth) * int64(AHeight) * 4);
  for LI := 0 to len(LPixels.RGBA) - 1 do
    LPixels.RGBA[LI] := 128;
  end;
  LPixels.RGBA[3] := 255;
  return LPixels;
end;

// A point
func At(const AX: float32; const AY: float32): UIPoint;
var
  LPoint: UIPoint;
begin
  LPoint.x := AX;
  LPoint.y := AY;
  return LPoint;
end;

// true while Raven still has the texture ATexture
func Alive(const ATexture: Rid): bool;
begin
  return Rtexture_is_valid(ATexture) <> 0;
end;

func Textures();
var
  LTexture: UITextureRes;
  LCopy: UITextureRes;
  LView: UITextureRes;
  LPixels: UIPixels;
  LBytes: array of uint8;
  LIO: IO;
  LSize: UISize;
  LId: Rid;
  LI: int64;
begin
  // from pixels: size, density, ready; then other pixels of another size
  LTexture := UITextureRes.FromPixels(Grey(2, 2)).Filter(UIFilter.Nearest);
  LSize := LTexture.Size();
  println("pixels {} {} {} {} {}", LTexture.IsValid(), int32(LSize.w), int32(LSize.h),
    int32(LTexture.Density()), LTexture.Ready());
  LTexture.Update(Grey(3, 1));
  LSize := LTexture.Size();
  println("updated {} {}", int32(LSize.w), int32(LSize.h));

  // PNG bytes decoded to pixels (no texture), then made a texture, at once and on a worker
  LPixels := UITextureRes.Decode(PNG_BYTES);
  println("decoded {} {} {} {} {} {}", LPixels.Width, LPixels.Height, LPixels.RGBA[0],
    LPixels.RGBA[2], LPixels.RGBA[7], len(UITextureRes.Decode([1, 2, 3]).RGBA));
  LTexture := UITextureRes.FromMemory(PNG_BYTES);
  LSize := LTexture.Size();
  LCopy := UITextureRes.LoadMemory(PNG_BYTES).Wait();
  println("png {} {} {} {}", LTexture.IsValid(), int32(LSize.w), int32(LSize.h), LCopy.Ready());

  // the same bytes through an IO
  setlength(LBytes, len(PNG_BYTES));
  for LI := 0 to len(LBytes) - 1 do
    LBytes[LI] := PNG_BYTES[LI];
  end;
  LIO := CreateMemoryIO(addr of LBytes[0], int64(len(LBytes)), true);
  LTexture := UITextureRes.FromIO(LIO);
  IOClose(LIO);
  LSize := LTexture.Size();
  println("io {} {} {}", LTexture.IsValid(), int32(LSize.w), int32(LSize.h));

  // SVG text at 2 pixels per unit: twice its size, density 2
  LTexture := UITextureRes.FromSVG("<svg xmlns='http://www.w3.org/2000/svg' width='4' " +
    "height='2'><rect width='4' height='2' fill='#f00'/></svg>", 2.0f);
  LSize := LTexture.Size();
  println("svg {} {} {} {}", LTexture.IsValid(), int32(LSize.w), int32(LSize.h),
    int32(LTexture.Density()));

  // nothing made from nothing: no bytes, pixels short of their size, a missing file
  LPixels := Grey(2, 2);
  setlength(LPixels.RGBA, 4);
  setlength(LBytes, 0);
  println("empty {} {} {} {}", UITextureRes.FromMemory(LBytes).IsValid(),
    UITextureRes.FromPixels(LPixels).IsValid(), UITextureRes("no/such/file.png").IsValid(),
    UITextureRes().IsValid());

  // shared: a copy keeps the texture after the first handle lets go; the last one destroys it
  LTexture := UITextureRes.FromPixels(Grey(1, 1));
  LId := LTexture.Id();
  LCopy := LTexture;
  LTexture := UITextureRes();
  print("shared {} ", Alive(LId));
  print("{} ", LCopy.Id() = LId);
  LCopy := UITextureRes();
  println("{}", Alive(LId));

  // a borrowed view never destroys what it names
  LTexture := UITextureRes.FromPixels(Grey(1, 1));
  LView := UITextureRes.View(LTexture.Id());
  LView := UITextureRes();
  print("view {} ", LTexture.IsValid());
  LId := LTexture.Id();
  LView := UITextureRes.View(LId);
  LTexture := UITextureRes();
  // the owner gone, the view names a destroyed texture
  println("{}", not LView.IsValid());
end;

func Keeps();
var
  LTexture: UITextureRes;
  LImage: UIImage;
  LViewport: UIViewport;
  LTabs: UITabView;
  LPage: UIVBox;
  LTree: UITreeView;
  LItem: UITreeItem;
  LBar: UIMenuBar;
  LDock: UIDockArea;
  LFiles: UIVBox;
  LGraph: UINodeGraph;
  LRoot: UIVBox;
  LWindow: UIWindow;
  LId: Rid;
  LIcons: Rid;
  LBack: Rid;
begin
  // an image keeps its texture while it shows it, and lets it go with itself
  LTexture := UITextureRes.FromPixels(Grey(1, 1));
  LId := LTexture.Id();
  LImage := UIImage.Create().Texture(LTexture);
  LTexture := UITextureRes();
  print("kept {} ", Alive(LId));
  LImage.Destroy();
  println("{}", Alive(LId));

  // a viewport, then another texture for it: the first one let go
  LViewport := UIViewport.Create().Texture(UITextureRes.FromPixels(Grey(1, 1)));
  LTexture := UITextureRes.FromPixels(Grey(1, 1));
  LId := LTexture.Id();
  LViewport.Texture(LTexture);
  LTexture := UITextureRes();
  print("keeps {} ", Alive(LId));

  // one icon on a tab, a menu item, a dock panel and a graph node: kept until the last goes
  LTexture := UITextureRes.FromPixels(Grey(2, 2));
  LIcons := LTexture.Id();
  LTabs := UITabView.Create();
  LPage := UIVBox.Create();
  LTabs.AddTab("Page", LPage).Icon(LTexture);
  LBar := UIMenuBar.Create().Native(false);
  LBar.AddMenu("File").AddItem("Open").Icon(LTexture, At(0.0f, 0.0f), At(0.5f, 0.5f),
    true);
  LDock := UIDockArea.Create();
  LFiles := UIVBox.Create();
  LDock.AddPanel(LFiles, "Files", UIDockSide.Left, UIWidget(), 0.25f).Icon(LTexture);
  LGraph := UINodeGraph.Create();
  LGraph.AddNode("Source", At(0.0f, 0.0f)).Icon(LTexture);
  LTexture := UITextureRes();
  LViewport.Destroy();
  LTabs.Destroy();
  LBar.Destroy();
  LDock.Destroy();
  print("{} ", Alive(LIcons));
  LGraph.Destroy();
  println("{}", Alive(LId) or Alive(LIcons));

  // a tree item keeps its icon until its icon changes (Raven names no tree of an item)
  LTexture := UITextureRes.FromPixels(Grey(1, 1));
  LId := LTexture.Id();
  LTree := UITreeView.Create();
  LItem := LTree.AddItem("Docs").Icon(LTexture);
  LTexture := UITextureRes();
  print("tree {} ", Alive(LId));
  LItem.Icon(UITextureRes());
  println("{}", Alive(LId));
  LTree.Destroy();

  // a window's background, let go with the window
  LTexture := UITextureRes.FromPixels(Grey(4, 4));
  LBack := LTexture.Id();
  LRoot := UIVBox.Create();
  LWindow := UIWindow.Config().Title("raven_resources").Size(320, 200).Content(LRoot).Open();
  LWindow.Background(LTexture).Icon(Grey(16, 16));
  LTexture := UITextureRes();
  print("window {} ", Alive(LBack));
  LWindow.Destroy();
  println("{}", Alive(LBack));
end;

func Fonts();
var
  LDefault: UIFontRes;
  LMono: UIFontRes;
  LLabel: UILabel;
  LEditor: UITextEditor;
  LSize: UISize;
begin
  LDefault := UIFontRes.Default();
  LMono := UIFontRes.Monospace();
  LSize := LDefault.Measure(16.0f, "Hello");
  println("fonts {} {} {} {} {}", LDefault.IsValid(), LMono.IsValid(),
    (LSize.w > 0.0f) and (LSize.h > 0.0f), LDefault.Variant(UIFontStyle.Bold).IsValid(),
    not UIFontRes("no/such/font.ttf").IsValid());

  // a widget's font reads back; a label's and an editor's own are set
  LLabel := UILabel.Create("Hello");
  LLabel.Font(LMono);
  LEditor := UITextEditor.Create("x := 1;");
  LEditor.Font(LMono, 14.0f);
  LEditor.Font(LDefault);
  print("font kept {} ", LEditor.Font().Id() = LDefault.Id());
  LLabel.Destroy();
  LEditor.Destroy();
  // a fallback and a variant set and cleared: built-in fonts are borrowed, never destroyed
  LDefault.Fallback(LMono).Variant(UIFontStyle.Italic, LMono);
  LDefault.Fallback(UIFontRes()).Variant(UIFontStyle.Italic, UIFontRes());
  println("{} {}", LMono.IsValid(), UIFontRes().IsValid());
end;

func Shaders();
var
  LAurora: UIShaderRes;
  LBorder: UIBorder;
  LLook: RShaderLook;
  LShader: Rid;
begin
  LAurora := UIShaderRes.Effect(UIEffect.Aurora);
  println("effects {} {} {} {} {}", UIShaderRes.EffectName(UIEffect.Aurora), LAurora.IsValid(),
    UIShaderRes.Effect("neon").Id() = UIShaderRes.Effect(UIEffect.Neon).Id(),
    UIShaderRes.Effect("no such effect").IsValid(),
    not UIShaderRes.FromSPIRV([1, 2, 3, 4], [UIShaderFlag.Animated]).IsValid());

  // a border's effect with a look of its own, read back; then its default look
  LLook := UIShaderRes.Look();
  LLook.radius := 8.0f;
  LBorder := UIBorder.Create().Effect(LAurora, LLook);
  LShader := LBorder.Effect().Id();
  LBorder.Effect(UIShaderRes.Effect(UIEffect.Neon));
  println("border {} {}", LShader = LAurora.Id(),
    LBorder.Effect().Id() = UIShaderRes.Effect(UIEffect.Neon).Id());
  LBorder.Destroy();
end;

func Theme();
var
  LColor: UIColor;
  LTexture: UITextureRes;
  LName: string;
  LPath: string;
  LId: Rid;
begin
  UITheme.Apply(UIThemeKind.Light);
  print("theme {} ", UITheme.Dark());
  UITheme.Dark(true);
  print("{} ", UITheme.Dark());
  UITheme.Look(UILook.RavenGlassDark);
  print("{} ", nameof(UITheme.Look()));
  UITheme.Metric(UIMetric.CornerRadius, 9.0f);
  print("{} ", int32(UITheme.Metric(UIMetric.CornerRadius)));
  UITheme.Material(UIMaterial.Glass);
  print("{} ", nameof(UITheme.Material()));
  LColor.r := 1.0f;
  LColor.g := 0.5f;
  LColor.b := 0.0f;
  LColor.a := 1.0f;
  UITheme.Color(UIColorRole.Accent, LColor);
  // the colour comes back as Raven keeps it: 0.5 is 128 of 255
  println("{}", int32(UITheme.Color(UIColorRole.Accent).g * 255.0f + 0.5f));
  UITheme.StyleColor("Button", "danger", UIColorRole.Accent, LColor);
  UITheme.StyleMetric("", "big", UIMetric.ControlHeight, 40.0f);
  UITheme.StyleMaterial("Slider", "", UIMaterial.Solid);
  UITheme.ClearStyles();

  // the theme's font and wallpaper are kept while set
  UITheme.Font(UIFontRes.Monospace());
  print("theme font {} ", UITheme.Font().Id() = UIFontRes.Monospace().Id());
  UITheme.Font(UIFontRes());
  println("{}", UITheme.Font().Id() <> UIFontRes.Monospace().Id());
  LTexture := UITextureRes.FromPixels(Grey(2, 2));
  LId := LTexture.Id();
  UITheme.Wallpaper(LTexture);
  LTexture := UITextureRes();
  print("wallpaper {} {} ", Alive(LId), UITheme.Wallpaper().Id() = LId);
  UITheme.Wallpaper(UITextureRes());
  println("{}", Alive(LId));

  // a token colour read back, then the look's again
  UITheme.TokenColor(UITokenKind.Keyword, LColor);
  println("tokens {}", int32(UITheme.TokenColor(UITokenKind.Keyword).r));
  UITheme.ClearTokenColors();

  // an XML theme loaded, used, saved and loaded again from its file
  LName := UITheme.LoadText("<Theme Name='Night' Accent='#FF9F0A'><Colors Panel='#101018' " +
    "Text='#FFF4E0'/><Metrics CornerRadius='6'/></Theme>");
  print("xml {} {} ", LName, UITheme.Use(LName));
  print("{} ", UITheme.Name());
  LPath := "$P:raven_resources_night.xml";
  print("{} ", UITheme.Save(LPath, LName) and (UITheme.Count() > 0) and
    (UITheme.NameAt(0) <> ""));
  println("{}", UITheme.Load(LPath));
end;

func Tests();
var
  LApp: UIApp;
begin
  LApp := UIApp.Config().AppName("raven_resources").Backend(UIBackend.Null).Headless(true)
    .NoRenderThread(true).Open();
  Textures();
  Keeps();
  Fonts();
  Shaders();
  Theme();
end;

begin
  Tests();
  println("end");
end.
