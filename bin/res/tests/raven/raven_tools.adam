-------------------------------------------------------------------------------
  raven_tools.adam - System.Raven.Ext's tools and shell widgets
  (PLAN-RAVENAPI V8) on Raven's null backend, headless: each widget type's
  Create gives a widget of its kind; a timeline keeps its duration, rate,
  playhead, view, sizes and look, its tracks and items (clips, keys, markers)
  read back, move, select and go; a node graph's nodes, pins and links are
  added, found, linked (a wrong-way link refused), moved, selected and
  removed; a block editor's kinds make blocks that attach in a mouth, detach,
  and save and load as text; a dock area's panels hide, open, show and keep
  their layout; an island unfolds and sits on a window; a header bar and a
  background blur keep what is set. Every closure is released with its
  widget: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | kinds true true true true true true true
  | timeline 10 30 5 1 5
  | sizes 0 24 30 Neon false
  | tracks 2 Audio true
  | items 3 Clip Key Marker false Audio
  | clip 1 2 Audio Opening false
  | selection 2 true 0
  | removed 2 1 0 0
  | nodes 2 Source Sink 10 20
  | pins true false float 0 Any true
  | links 1 true true false
  | graph 2 2 0 Blueprint 80 true
  | unlinked 0 1 0
  | blocks 0 1 2 false false
  | attach true 1 true true Body say 1 1
  | detach 2 false Hello true 2 false
  | dock true false true true true false
  | layout true true true
  | island true true false true false
  | blur Frosted 12
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_tools;

import System.Raven.C, System.Raven.Ext;

// A point in canvas or widget units
func At(const AX: float32; const AY: float32): UIPoint;
var
  LPoint: UIPoint;
begin
  LPoint.x := AX;
  LPoint.y := AY;
  return LPoint;
end;

func Tests();
var
  LApp: UIApp;
  LTimeline: UITimeline;
  LGraph: UINodeGraph;
  LEditor: UIBlockEditor;
  LDock: UIDockArea;
  LIsland: UIIsland;
  LBar: UIHeaderBar;
  LBlur: UIBackgroundBlur;
  LSpan: UITimeSpan;
  LVideo: UITrack;
  LAudio: UITrack;
  LClip: UITimelineItem;
  LKey: UITimelineItem;
  LMark: UITimelineItem;
  LSource: UIGraphNode;
  LSink: UIGraphNode;
  LOut: UIGraphPin;
  LIn: UIGraphPin;
  LAny: UIGraphPin;
  LLink: UIGraphLink;
  LView: UICanvasView;
  LPlace: UIPoint;
  LRepeat: UIBlock;
  LSay: UIBlock;
  LText: string;
  LFiles: UIVBox;
  LCode: UIVBox;
  LPanel: UIDockPanel;
  LRoot: UIVBox;
  LWindow: UIWindow;
  LNoIsland: UIIsland;
begin
  LApp := UIApp.Config().AppName("raven_tools").Backend(UIBackend.Null).Headless(true)
    .NoRenderThread(true).Open();

  // kinds: each type views its own
  LTimeline := UITimeline.Create();
  LGraph := UINodeGraph.Create();
  LEditor := UIBlockEditor.Create();
  LDock := UIDockArea.Create();
  LIsland := UIIsland.Create();
  LBar := UIHeaderBar.Create("Tools");
  LBlur := UIBackgroundBlur.Create();
  println("kinds {} {} {} {} {} {} {}", LTimeline.Is<UITimeline>(), LGraph.Is<UINodeGraph>(),
    LEditor.Is<UIBlockEditor>(), LDock.Is<UIDockArea>(), LIsland.Is<UIIsland>(),
    LBar.Is<UIHeaderBar>(), LBlur.Is<UIBackgroundBlur>());

  // a timeline: duration, rate, playhead and the span shown
  LTimeline.Duration(10.0).FrameRate(30.0).Time(2.5).Snapping(false).Loop(true).Playing(false);
  LSpan.First := 1.0;
  LSpan.Last := 5.0;
  LTimeline.View(LSpan);
  LSpan := LTimeline.View();
  println("timeline {} {} {} {} {}", int32(LTimeline.Duration()), int32(LTimeline.FrameRate()),
    int32(LTimeline.Time() * 2.0), int32(LSpan.First), int32(LSpan.Last));
  // HeaderWidth() reads the column as laid out: 0 here (headless, in no window)
  LTimeline.HeaderWidth(120.0f).RulerHeight(24.0f).DefaultTrackHeight(30.0f).Preset(UIPreset.Neon);
  println("sizes {} {} {} {} {}", int32(LTimeline.HeaderWidth()), int32(LTimeline.RulerHeight()),
    int32(LTimeline.DefaultTrackHeight()), nameof(LTimeline.Preset()), LTimeline.Playing());

  // its tracks
  LVideo := LTimeline.AddTrack("Video");
  LAudio := LTimeline.AddTrack("Audio");
  LAudio.Muted(true).Locked(false).Height(40.0f).Color(UIColor.FromRGBA(58, 123, 213));
  println("tracks {} {} {}", LTimeline.TrackCount(), LTimeline.Track(1).Name(), LAudio.Muted());

  // its items: a clip, a key and a marker
  LClip := LVideo.AddClip(0.0, 4.0, "Intro");
  LKey := LAudio.AddKey(1.5);
  LMark := LTimeline.AddMarker(3.0, "Cue");
  println("items {} {} {} {} {} {}", LTimeline.ItemCount(), nameof(LClip.ItemKind()),
    nameof(LKey.ItemKind()), nameof(LMark.ItemKind()), LMark.Track().IsValid(), LKey.Track().Name());
  LClip.Move(LAudio, 1.0, 2.0).Label("Opening").Color(UIColor.FromRGBA(200, 40, 40));
  println("clip {} {} {} {} {}", int32(LClip.Start()), int32(LClip.Length()), LClip.Track().Name(),
    LClip.Label(), LClip.Style("NoSuchProperty", "1"));

  // selection
  LClip.Select(false);
  LKey.Select(true);
  print("selection {} {} ", LTimeline.SelectionCount(), LTimeline.Selected(1).Selected());
  println("{}", LTimeline.ClearSelection().SelectionCount());
  LTimeline.OnTime(func(const ASeconds: float64) begin end)
    .OnChanged(func(const AItem: UITimelineItem) begin end)
    .OnSelect(func(const AItem: UITimelineItem) begin end)
    .OnActivate(func(const AItem: UITimelineItem) begin end)
    .OnRemoved(func(const AItem: UITimelineItem) begin end);

  // items and tracks removed
  LKey.Remove();
  print("removed {} ", LTimeline.ItemCount());
  LVideo.Remove();
  print("{} ", LTimeline.TrackCount());
  LTimeline.Clear();
  println("{} {}", LTimeline.TrackCount(), LTimeline.ItemCount());

  // a node graph: nodes found by name, placed
  LSource := LGraph.AddNode("Source", At(0.0f, 0.0f)).Name("src");
  LSink := LGraph.AddNode("Sink", At(200.0f, 0.0f)).Color(UIColor.FromRGBA(40, 160, 90));
  LSource.Position(At(10.0f, 20.0f)).Badge("1").BadgeColor(UIColor.FromRGBA(200, 40, 40))
    .Deletable(true).Active(false).UserData(nil);
  LPlace := LSource.Position();
  println("nodes {} {} {} {} {}", LGraph.NodeCount(), LGraph.FindNode("src").Title(),
    LGraph.Node(1).Title(), int32(LPlace.x), int32(LPlace.y));

  // its pins
  LOut := LSource.AddOutput("Value", "float");
  LIn := LSink.AddInput("Value", "float");
  LAny := LSink.AddInput("Any", "");
  LAny.Multiple(true).Tag("x").TagLit(false).Emphasis(0);
  println("pins {} {} {} {} {} {}", LOut.IsOutput(), LIn.IsOutput(), LIn.PinType(),
    len(LAny.PinType()), LSink.Input(1).Label(), LSink.FindPin("Any").Id() = LAny.Id());

  // links: an output to an input; an input to an output refused
  LLink := LGraph.Connect(LOut, LIn);
  println("links {} {} {} {}", LGraph.LinkCount(), LLink.Output().Id() = LOut.Id(),
    LIn.InputLink().Id() = LLink.Id(), LGraph.Connect(LIn, LOut).IsValid());

  // view, selection and look
  LView.Place := At(50.0f, 60.0f);
  LView.Zoom := 2.0f;
  LGraph.View(LView).GridVisible(true).FlowVisible(true).ReadOnly(false).Preset(UIPreset.Blueprint)
    .PinLabelWidth(80.0f).TypeColor("float", UIColor.FromRGBA(58, 123, 213));
  LSource.Select(false);
  LSink.Select(true);
  print("graph {} {} ", int32(LGraph.View().Zoom), LGraph.SelectionCount());
  println("{} {} {} {}", LGraph.ClearSelection().SelectionCount(), nameof(LGraph.Preset()),
    int32(LGraph.PinLabelWidth()), LSource.UserData() = nil);
  LGraph.OnConnect(func(const AOutput: UIGraphPin; const AInput: UIGraphPin): bool begin return true; end)
    .OnLinked(func(const ALink: UIGraphLink) begin end)
    .OnUnlinked(func(const ALink: UIGraphLink) begin end)
    .OnMoved(func(const ANode: UIGraphNode) begin end)
    .OnSelect(func(const ANode: UIGraphNode) begin end)
    .OnRemoved(func(const ANode: UIGraphNode) begin end)
    .OnActivate(func(const ANode: UIGraphNode) begin end)
    .OnContext(func(const ANode: UIGraphNode; const AAt: UIPoint) begin end)
    .OnCanvasActivate(func(const AAt: UIPoint) begin end)
    .OnWireDropped(func(const APin: UIGraphPin; const AAt: UIPoint) begin end)
    .OnPinClick(func(const APin: UIGraphPin; const AAt: UIPoint) begin end);

  // links and nodes removed
  LLink.Disconnect();
  print("unlinked {} ", LGraph.LinkCount());
  LSource.Remove();
  print("{} ", LGraph.NodeCount());
  println("{}", LGraph.Clear().NodeCount());

  // a block editor: kinds, then blocks of them
  print("blocks {} ", LEditor.AddKind("say", "say %s", UIBlockShape.Statement, "Looks"));
  print("{} ", LEditor.AddKind("repeat", "repeat %n", UIBlockShape.C, "Control"));
  print("{} ", LEditor.AddKind("pick", "pick %m", UIBlockShape.Reporter, "Operators"));
  LEditor.SlotOptions("pick", 0, ["one", "two"]).CategoryColor("Looks", UIColor.FromRGBA(150, 90, 220))
    .PaletteVisible(true).KindVisible("pick", true);
  println("{} {}", LEditor.AddBlock("nope", At(0.0f, 0.0f)).IsValid(), LEditor.KindLabel("nope", "x"));
  LRepeat := LEditor.AddBlock("repeat", At(0.0f, 0.0f));
  LSay := LEditor.AddBlock("say", At(0.0f, 100.0f));
  LSay.Value(0, "Hello").Glow(false).Deletable(true);
  println("attach {} {} {} {} {} {} {} {}", LSay.Attach(LRepeat, UIBlockPart.Body, 0),
    LEditor.ScriptCount(), LRepeat.Body(0).Id() = LSay.Id(), LSay.Parent().Id() = LRepeat.Id(),
    nameof(LSay.Spot().Part), LSay.BlockKind(), LRepeat.MouthCount(), LRepeat.SlotCount());
  LSay.Detach(At(0.0f, 200.0f));
  print("detach {} {} {} ", LEditor.ScriptCount(), LSay.Parent().IsValid(), LSay.Value(0));
  LText := LEditor.Save();
  LEditor.Clear();
  print("{} ", LEditor.Load(LText));
  println("{} {}", LEditor.ScriptCount(), LEditor.Load("not a script"));
  LEditor.OnChanged(func(const ABlock: UIBlock) begin end)
    .OnClick(func(const ABlock: UIBlock) begin end)
    .OnContext(func(const ABlock: UIBlock; const AAt: UIPoint) begin end);

  // a dock area: panels hidden, opened, shown
  LFiles := UIVBox.Create();
  LFiles.Name("files");
  LCode := UIVBox.Create();
  LCode.Name("code");
  LPanel := LDock.AddPanel(LFiles, "Files", UIDockSide.Left, UIWidget(), 0.25f);
  LDock.AddPanel(LCode, "Code", UIDockSide.Right, UIWidget(), 0.75f).Title("Code 2").Closable(false);
  print("dock {} ", LPanel.IsOpen());
  LPanel.Hide();
  print("{} ", LPanel.IsOpen());
  LPanel.Open().Show();
  print("{} {} ", LPanel.IsOpen(), LPanel.Shown());
  LDock.CloseHides(true).Movable(true).Tearable(true).FloatMode(UIDockFloat.InWindow);
  println("{} {}", LDock.Tearable(), LPanel.Window().IsValid());
  LText := LDock.SaveLayout();
  println("layout {} {} {}", len(LText) > 0, LDock.LoadLayout(LText), LPanel.Area().Id() = LDock.Id());
  LDock.OnClose(func(const APanel: UIDockPanel): bool begin return true; end)
    .OnChanged(func() begin end)
    .FloatWindow([UIWindowFlag.CustomHeader],
      func(const APanel: UIDockPanel; const AWindow: UIWindow; const AFloating: UIDockArea): UIWidget
      var
        LNone: UIWidget;
      begin
        return LNone;
      end);

  // an island: unfolded, in a window
  LIsland.Expanded(true).ExpandOnHover(true).ExpandOnClick(true).Attached(true).Notch(true);
  print("island {} {} {} ", LIsland.Expanded(), LIsland.Notch(), LIsland.InNotch());
  LIsland.OnChanged(func(const AOn: bool) begin end);
  LRoot := UIVBox.Create();
  LWindow := UIWindow.Config().Title("raven_tools").Size(320, 200).Content(LRoot).Open();
  LWindow.Island(LIsland);
  print("{} ", LWindow.Island().Id() = LIsland.Id());
  LWindow.Island(LNoIsland);
  println("{}", LWindow.Island().IsValid());

  // a header bar and a background blur
  LBar.Title("Tools 2").Buttons([UIHeaderButton.Close, UIHeaderButton.Minimize])
    .ButtonSide(UIHAlign.Left).TitleAlign(UIHAlign.Center).TitleNotch(true).Background(false);
  LBlur.Style(UIBlurStyle.Frosted).Radius(12.0f).Tint(UIColor.FromRGBA(255, 255, 255, 64))
    .ClearTint().Saturation(1.2f).Grain(0.1f).CornerRadius(8.0f, 8.0f, 8.0f, 8.0f)
    .Padding(4.0f, 4.0f, 4.0f, 4.0f).Shadow(6.0f);
  println("blur {} {}", nameof(LBlur.Style()), int32(LBlur.Radius()));

  LWindow.Destroy();
  LTimeline.Destroy();
  LGraph.Destroy();
  LEditor.Destroy();
  LDock.Destroy();
  LIsland.Destroy();
  LBar.Destroy();
  LBlur.Destroy();
end;

begin
  Tests();
  println("end");
end.
