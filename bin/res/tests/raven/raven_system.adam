-------------------------------------------------------------------------------
  raven_system.adam - System.Raven.Ext's actions and system UI (PLAN-RAVENAPI
  V9 part 2) on Raven's null backend, headless: actions answered by name,
  with typed parameters (from a script's call), by prefix and by the
  fallback, rebound and unbound, built-ins told apart; translation tables
  from CSV text (languages, texts, arguments, plurals, the changed closure);
  the accessibility settings; a script loaded, checked (its diagnostics),
  formatted, logging and calling an Adam action; a language declared for the
  text editor, read back and found by a file's extension; in-memory files;
  a tray icon when the system has a tray. Every closure is released when the
  app ends: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | actions 1 1 0 true
  | prefix Ember fallback zzz true false
  | script true log hi true true true true
  | call true 2 5 t.add
  | locale 2 fr true Bonjour Salut Ada 3 fichiers false true fr
  | access 1.5 true true Grayscale false
  | language true adamtest module func true
  | files true true false
  | tray true
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_system;

import System.SysUtils, System.Raven.C, System.Raven.Ext;

const
  LOCALE_CSV: string = "key,en,fr\nhello,Hello,Bonjour\ngreet,Hi {0},Salut {0}\nfiles.one,{n} file,{n} fichier\nfiles.other,{n} files,{n} fichiers\n";
  SCRIPT_TEXT: string = "fn t.calc(): number {\n  return t.add(2, 3);\n}\nfn t.hello() {\n  app.log(\"hi\");\n}\n";

var
  GGo: int32;
  GSum: float64;
  GArgs: int32;
  GCallName: string;
  GNoSender: bool;

func Actions();
var
  LArg: string;
  LMissed: string;
begin
  // by name: fired, rebound (the new routine answers), unbound (none does)
  GGo := 0;
  GNoSender := false;
  UIActions.Bind("t.go", func(const ASender: UIWidget) begin GGo += 1; GNoSender := ASender.Id() = R_INVALID_ID; end);
  UIActions.Fire("t.go", UIWidget());
  print("actions {} ", GGo);
  UIActions.Bind("t.go", func(const ASender: UIWidget) begin GGo += 10; end);
  UIActions.Unbind("t.go");
  UIActions.Fire("t.go", UIWidget());
  print("{} ", GGo);
  GGo := 0;
  UIActions.Bind("t.go", func(const ASender: UIWidget) begin GGo += 1; end);
  UIActions.Bind("t.go", nil);
  UIActions.Fire("t.go", UIWidget());
  println("{} {}", GGo, GNoSender);

  // by prefix, then the fallback for what nothing takes
  LArg := "";
  LMissed := "";
  UIActions.BindPrefix("t.use.", func(const ASender: UIWidget; const AArgument: string) begin LArg := AArgument; end);
  UIActions.Fallback(func(const ASender: UIWidget; const AName: string) begin LMissed := AName; end);
  UIActions.Fire("t.use.Ember", UIWidget());
  UIActions.Fire("zzz", UIWidget());
  println("prefix {} fallback {} {} {}", LArg, LMissed, UIActions.IsBuiltin("theme.dark"),
    UIActions.IsBuiltin("t.use.Ember"));
  UIActions.BindPrefix("t.use.", nil);
  UIActions.Fallback(nil);
end;

func Script();
var
  LLog: string;
  LDiagnostics: int32;
  LBound: bool;
begin
  // an action with typed parameters, called by a script
  LBound := UIActions.Bind("t.add", "(a: number, b: number): number",
    func(const C: UIActionContext)
    begin
      GArgs := C.ArgCount();
      GCallName := C.Name();
      GSum := C.Number(0) + C.Number(1);
      C.Reply(GSum);
    end);
  LLog := "";
  LDiagnostics := 0;
  UIScript.OnLog(func(const AText: string) begin LLog := AText; end);
  UIScript.OnDiagnostic(func(const ASeverity: UISeverity; const ACode: string; const AFile: string;
    const ALine: int32; const AColumn: int32; const AText: string)
    begin
      LDiagnostics += 1;
    end);
  print("script {} ", UIScript.Load(SCRIPT_TEXT, "t.rvs"));
  UIActions.Fire("t.hello", UIWidget());
  print("log {} {} ", LLog, UIScript.HasFunction("t.calc"));
  UIActions.Fire("t.calc", UIWidget());
  print("{} ", UIScript.Check("fn t.bad( {", "bad.rvs") > 0);
  print("{} ", LDiagnostics > 0);
  println("{}", len(UIScript.Format(SCRIPT_TEXT, "")) > 0);
  println("call {} {} {} {}", LBound, GArgs, int32(GSum), GCallName);
  UIScript.OnLog(nil);
  UIScript.OnDiagnostic(nil);
  UIScript.Reset();
end;

func Locale();
var
  LChanged: string;
begin
  LChanged := "";
  UILocale.OnChanged(func(const ALanguage: string) begin LChanged := ALanguage; end);
  UILocale.LoadCSVText(LOCALE_CSV);
  print("locale {} {} ", UILocale.LanguageCount(), UILocale.LanguageAt(1));
  print("{} {} ", UILocale.Language("fr"), UILocale.Tr("hello"));
  print("{} ", UILocale.Tr("greet", ["Ada"]));
  print("{} ", UILocale.Plural("files", 3));
  println("{} {} {}", UILocale.Has("nope"), UILocale.Has("hello"), LChanged);
  UILocale.OnChanged(nil);
  UILocale.Clear();
end;

func Access();
begin
  UIAccessibility.TextScale(1.5f);
  UIAccessibility.HighContrast(true);
  UIAccessibility.ReduceMotion(true);
  UIAccessibility.ColorFilter(UIColorFilter.Grayscale);
  print("access {} {} {} ", UIAccessibility.TextScale(), UIAccessibility.HighContrast(),
    UIAccessibility.ReduceMotion());
  println("{} {}", nameof(UIAccessibility.ColorFilter()), UIAccessibility.ScreenReader());
  UIAccessibility.TextScale(1.0f);
  UIAccessibility.HighContrast(false);
  UIAccessibility.ReduceMotion(false);
  UIAccessibility.ColorFilter(UIColorFilter.None);
end;

func Language();
var
  LDef: UILanguageDef;
  LRead: UILanguageDef;
begin
  LDef.Name := "adamtest";
  LDef.Extensions := "adt";
  LDef.Keywords := "module func begin end";
  LDef.LineComment := "//";
  LDef.Flags := [UILanguageFlag.IgnoreCase];
  print("language {} {} ", UISyntaxLanguage.Register(LDef), UISyntaxLanguage.ForFile("a.adt"));
  UISyntaxLanguage.Find("adamtest", LRead);
  println("{} {}", Substring(LRead.Keywords, 0, 11),
    UILanguageFlag.IgnoreCase in LRead.Flags);
end;

func Files();
var
  LBytes: array of uint8;
begin
  setlength(LBytes, 3);
  LBytes[0] := 65;
  LBytes[1] := 66;
  LBytes[2] := 67;
  print("files {} {} ", UIFiles.Register("mem/raven_system.txt", LBytes),
    UIFiles.IsMemory("mem/raven_system.txt"));
  UIFiles.Unregister("mem/raven_system.txt");
  println("{}", UIFiles.IsMemory("mem/raven_system.txt"));
end;

func Tray();
var
  LIcon: UIPixels;
  LTray: UITrayRes;
  LI: int64;
begin
  LIcon.Width := 16;
  LIcon.Height := 16;
  setlength(LIcon.RGBA, 16 * 16 * 4);
  for LI := 0 to len(LIcon.RGBA) - 1 do
    LIcon.RGBA[LI] := 200;
  end;
  LTray := UITrayRes(LIcon, "raven_system");
  LTray.Title("raven").OnClick(func(const AButton: UIPointerButton) begin end);
  // a tray icon exists exactly when the system has a tray
  println("tray {}", LTray.IsValid() = UITrayRes.Supported());
end;

func Tests();
var
  LApp: UIApp;
begin
  LApp := UIApp.Config().AppName("raven_system").Backend(UIBackend.Null).Headless(true)
    .NoRenderThread(true).Open();
  Actions();
  Script();
  Locale();
  Access();
  Language();
  Files();
  Tray();
end;

begin
  Tests();
  println("end");
end.
