-------------------------------------------------------------------------------
  raven_controls.adam - System.Raven.Ext's layout containers and controls
  (PLAN-RAVENAPI V4) on Raven's null backend, headless: each widget type's
  Create gives a widget of its kind and Kinds views only it (UIPanel both
  boxes); Find<T> / As<T> type them; Begin<T> opens a child container in a
  chain and End comes back; a type's members join UIWidget's of their name
  (UILabel.Color(text colour) beside Color(role, colour), UIToast.Kind(K)
  beside Kind()). Each container's and control's settings round-trip:
  spacing, switcher index, tabs (add, count, find, title, active), expander,
  label (markdown, selectable, plain text), check box, slider and spin box
  (ranges as UIRange, the value kept inside), progress, text input, combo
  box, rating, pagination, breadcrumb ('|'-joined items, truncate), date
  and time pickers (UIDate / UITime), colour picker (colour, hex, HSV,
  swatches), toast (shown, count, text). In a headless window an injected
  click runs a button's OnClick and a check box's OnChanged; every closure
  is released with its widget or the app: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | kinds true true false true true
  | typed true true 13
  | builder HBox 2 VBox root
  | join 1 true Label
  | panel 6 switch 1
  | tabs 2 1 true true 1
  | expander Info true
  | label true true Bold
  | check true
  | slider 100 50 10
  | spin 2.5 5 true
  | progress 0.25
  | input true true Email Search abc
  | combo 3 b 1
  | rating 7.5 10
  | pages 10 3
  | crumbs 3 Adam 2
  | date 2026 11 25 2026-11-25
  | time 13 45 30
  | color 1 #FF0000 0 1 1 2
  | toast true 1 Saved Stack
  | clicks 1 changed true
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_controls;

import System.SysUtils, System.Raven.C, System.Raven.Ext;

var
  GClicks: int64;
  GChanged: bool;

// The code As<T> raises with for a widget of a kind T does not view
func DoKindCode(const ARoot: UIWidget): int64;
var
  LSlider: UISlider;
begin
  guard
    LSlider := ARoot.Find<UIWidget>("go").As<UISlider>();
    return 0;
  except
    return exccode();
  end;
end;

// A left click in the middle of ARect, then a few frames
func Click(var AApp: UIApp; const AWindow: Rid; const ARect: UIRect);
var
  LI: int64;
begin
  Rwindow_inject_mouse_move(AWindow, ARect.x + ARect.w * 0.5f, ARect.y + ARect.h * 0.5f);
  Rwindow_inject_mouse_button(AWindow, R_MOUSE_LEFT, R_TRUE);
  Rwindow_inject_mouse_button(AWindow, R_MOUSE_LEFT, R_FALSE);
  for LI := 1 to 5 do
    AApp.WaitFrame(0.01);
  end;
end;

func Tests();
var
  LApp: UIApp;
  LWindow: Rid;
  LRoot: UIVBox;
  LRow: UIHBox;
  LLabel: UILabel;
  LButton: UIButton;
  LCheck: UICheckBox;
  LTabs: UITabView;
  LPageOne: UIVBox;
  LPageTwo: UIVBox;
  LExpander: UIExpander;
  LSwitch: UISwitcher;
  LSlider: UISlider;
  LSpin: UISpinBox;
  LProgress: UIProgressBar;
  LInput: UITextInput;
  LCombo: UIComboBox;
  LRating: UIRating;
  LPages: UIPagination;
  LCrumbs: UIBreadcrumb;
  LDate: UIDatePicker;
  LTime: UITimePicker;
  LPicker: UIColorPicker;
  LToast: UIToast;
  LColor: UIColor;
  LHSV: UIHSV;
  LRange: UIRange;
  LDay: UIDate;
  LClock: UITime;
  LB: UIRect;
  LI: int64;
begin
  LApp := UIApp.Config().AppName("raven_controls").Backend(UIBackend.Null).Headless(true)
    .NoRenderThread(true).Open();

  // kinds: each type views its own; UIPanel views both boxes
  LLabel := UILabel.Create("Hi").Name("title");
  println("kinds {} {} {} {} {}", LLabel.Kind() = UIWidgetKind.Label,
    UIWidgetKind.HBox in UIPanel.Kinds(), UIWidgetKind.HBox in UIVBox.Kinds(),
    UISpacer.Create(4.0f, 4.0f).Is<UISpacer>(), UIColorPicker.Create().Is<UIColorPicker>());

  // a tree in one chain: Begin<T> opens the row, End() comes back to the root
  LButton := UIButton.Create("Go").Name("go");
  LCheck := UICheckBox.Create("On").Name("on");
  LRoot := UIVBox.Create().Name("root");
  LRow := LRoot.Begin<UIHBox>(UILayout().Auto());
  LRow.Add(LButton).Add(LCheck).End().Add(LLabel);
  println("typed {} {} {}", LRoot.Find<UIButton>("go").IsValid(), LRoot.Find<UIWidget>("on").As<UICheckBox>().Is<UICheckBox>(),
    DoKindCode(LRoot));
  println("builder {} {} {} {}", nameof(LRoot.Child(0).Kind()), LRoot.Child(0).ChildCount(),
    nameof(LRoot.Kind()), LRow.End().Name());

  // a type's members join UIWidget's of their name
  LLabel.Color(UIColorRole.Text, UIColor(r: 1.0f, g: 0.0f, b: 0.0f, a: 1.0f)).Color(UIColor.White());
  LColor := LLabel.Color(UIColorRole.Text);
  LToast := UIToast.Create().Kind(UIToastKind.Success);
  println("join {} {} {}", int64(LColor.r), LToast.Kind() = UIWidgetKind.Toast, nameof(LLabel.Kind()));

  // containers
  LSwitch := UISwitcher.Create().Add(UILabel.Create("a")).Add(UILabel.Create("b")).Index(1);
  println("panel {} switch {}", int64(UIHBox.Create().Spacing(6.0f).Spacing()), LSwitch.Index());
  LPageOne := UIVBox.Create();
  LPageTwo := UIVBox.Create();
  LTabs := UITabView.Create();
  LTabs.AddTab("One", LPageOne);
  LTabs.AddTab("Tab", LPageTwo).Title("Two").Closable(true);
  LTabs.Active(1);
  println("tabs {} {} {} {} {}", LTabs.TabCount(), LTabs.Active(), LTabs.FindTab(LPageTwo).IsValid(),
    LTabs.Tab(1).Content().Id() = LPageTwo.Id(), LTabs.Tab(1).Index());
  LExpander := UIExpander.Create("Info").Expanded(true);
  println("expander {} {}", LExpander.Title(), LExpander.Expanded());

  // controls
  LLabel.Markdown(true).Selectable(true).Text("**Bold**");
  println("label {} {} {}", LLabel.Markdown(), LLabel.Selectable(), LLabel.PlainText());
  println("check {}", LCheck.Checked(true).Checked());
  LSlider := UISlider.Create().Range(0.0f, 100.0f).Step(1.0f).Value(50.0f);
  LRange := LSlider.Range();
  println("slider {} {} {}", int64(LRange.Max), int64(LSlider.Value()), int64(LSlider.Range(0.0f, 10.0f).Value()));
  LSpin := UISpinBox.Create().Range(0.0, 5.0).Value(2.5).Buttons(true);
  println("spin {} {} {}", LSpin.Value(), int64(LSpin.Value(9.0).Value()), LSpin.Buttons());
  println("progress {}", UIProgressBar.Create().Value(0.25f).Value());
  LInput := UITextInput.Create().Password(true).ReadOnly(true).InputType(UIInputType.Email)
    .ReturnKey(UIReturnKey.Search);
  LInput.Text("abc");
  println("input {} {} {} {} {}", LInput.Password(), LInput.ReadOnly(), nameof(LInput.InputType()),
    nameof(LInput.ReturnKey()), LInput.Text());
  LCombo := UIComboBox.Create();
  LCombo.AddItem("a");
  LCombo.AddItem("b");
  LCombo.AddItem("c");
  println("combo {} {} {}", LCombo.ItemCount(), LCombo.Item(1), LCombo.Selected(1).Selected());
  LRating := UIRating.Create().Max(10).AllowHalf(true).Value(7.5f);
  println("rating {} {}", LRating.Value(), LRating.Max());
  LPages := UIPagination.Create().PageCount(10).Page(3);
  println("pages {} {}", LPages.PageCount(), LPages.Page());
  LCrumbs := UIBreadcrumb.Create().Items(["Home", "Docs", "Adam"]);
  println("crumbs {} {} {}", LCrumbs.ItemCount(), LCrumbs.Item(2), LCrumbs.Truncate(2).ItemCount());
  LDate := UIDatePicker.Create().Date(2026, 11, 25).Format("YYYY-MM-DD");
  LDay := LDate.Date();
  println("date {} {} {} {}", LDay.Year, LDay.Month, LDay.Day, LDate.Text());
  LTime := UITimePicker.Create().SecondsVisible(true).Time(13, 45, 30);
  LClock := LTime.Time();
  println("time {} {} {}", LClock.Hour, LClock.Minute, LClock.Second);
  LPicker := UIColorPicker.Create().Color(UIColor(r: 1.0f, g: 0.0f, b: 0.0f, a: 1.0f))
    .AddSwatch(UIColor.White()).AddSwatch(UIColor.Black());
  LHSV := LPicker.HSV();
  println("color {} {} {} {} {} {}", int64(LPicker.Color().r), LPicker.Hex(), int64(LHSV.h),
    int64(LHSV.s), int64(LHSV.v), LPicker.SwatchCount());
  LToast.Queue(UIToastQueue.Stack).Show("Saved", 3.0);
  println("toast {} {} {} {}", LToast.Shown(), LToast.Count(), LToast.Text(), nameof(LToast.Queue()));

  // in a headless window: an injected click runs the button's and the check box's closures
  LWindow := Rwindow_create("raven_controls", 400, 200, R_WINDOW_DEFAULT);
  Rwindow_set_content(LWindow, LRoot.Id());
  LCheck.Checked(false);
  LButton.OnClick(func()
  begin
    GClicks := GClicks + 1;
  end);
  LCheck.OnChanged(func(const AOn: bool)
  begin
    GChanged := AOn;
  end);
  for LI := 1 to 5 do
    LApp.WaitFrame(0.01);
  end;
  LB := LButton.Rect();
  Click(LApp, LWindow, LB);
  LB := LCheck.Rect();
  Click(LApp, LWindow, LB);
  println("clicks {} changed {}", GClicks, GChanged);

  LSwitch.Destroy();
  LTabs.Destroy();
  LExpander.Destroy();
  LSlider.Destroy();
  LSpin.Destroy();
  LInput.Destroy();
  LCombo.Destroy();
  LRating.Destroy();
  LPages.Destroy();
  LCrumbs.Destroy();
  LDate.Destroy();
  LTime.Destroy();
  LPicker.Destroy();
  LToast.Destroy();
  Rwindow_destroy(LWindow);
end;

begin
  Tests();
  println("end");
end.
