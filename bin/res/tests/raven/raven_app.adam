-------------------------------------------------------------------------------
  raven_app.adam - System.Raven.Ext's first layer (PLAN-RAVENAPI V1) on
  Raven's null backend, headless: the choices carry Raven's own values and
  a flag set casts to Raven's mask (and back); UIColor from bytes, hex text
  and hue / saturation / value, its hex text, alpha, mix and `=`; UIPoint's
  operators, UIRect's hit test and centre; the std hex pair (TryHexToRGBA /
  RGBAToHex) on every form and a bad text; REvent's typed reads. The app:
  opened by its config (Adam's heap as Raven's allocator), Current shares
  it, a second open is refused; UIErrors.OnError's closure sees the error a
  bad widget id makes and UIErrors.Last / Text agree; OnFrame, a repeating
  and a one-shot UITimerRes and a posted task run during frames (the timer
  handed its own handle); the app's settings round-trip; Quit sets the exit
  code. The app's end destroys the timer still held, every closure is
  released, and Raven's blocks are all freed (Leaked 0).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | key 65 32 273 digit 48
  | error 113 none 112 severity 130
  | flags 6 back true mods true
  | widget 527 566
  | hex #3A7BD5 #FF000080 #00FF00 #808080 bad true
  | color true false alpha #3A7BD580
  | point true rect true false center 5 5
  | rgba true FFFFFFFF true 00FF0088 false false #3A7BD5 #3A7BD5FF
  | event true true true true A
  | open true initialized true version true
  | current true second false
  | error seen true true true
  | ran true true 1 true self true
  | timer valid true once valid false
  | scale true animations false rtl true
  | quit 7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_app;

import System.SysUtils, System.Raven.C, System.Raven.Ext;

var
  GErrors: int64;
  GLastCode: UIErrorCode;
  GFrames: int64;
  GTicks: int64;
  GOnce: int64;
  GPosted: int64;
  GSelfValid: bool;

// The choices' values are Raven's constants; a flag set casts to and from Raven's mask
func ShowChoices();
var
  LMods: UIModifiers;
begin
  println("key {} {} {} digit {}", int32(UIKey.A), int32(UIKey.Space), int32(UIKey.F1), int32(UIKey.Key0));
  println("error {} none {} severity {}", int32(UIErrorCode.InvalidId), int32(UIErrorCode.None),
    int32(UISeverity.Error));
  LMods := UIModifiers(R_MOD_SHIFT | R_MOD_ALT);
  println("flags {} back {} mods {}", int32([UIWindowFlag.Hidden, UIWindowFlag.Borderless]),
    UIWindowFlags(R_WINDOW_HIDDEN | R_WINDOW_BORDERLESS) = [UIWindowFlag.Hidden, UIWindowFlag.Borderless],
    LMods = [UIModifier.Shift, UIModifier.Alt]);
  println("widget {} {}", int32(UIWidgetKind.Label), int32(UIWidgetKind.Carousel));
end;

// UIColor, UIPoint, UIRect and the std hex pair
func ShowValues();
var
  LColor: UIColor;
  LH: float32;
  LS: float32;
  LV: float32;
  LRect: UIRect;
  LCenter: UIPoint;
  LRGBA: uint32;
  LShort: bool;
  LHalf: bool;
  LBad: bool;
  LBadLength: bool;
begin
  LColor := UIColor.FromHex("#3a7bd5", UIColor.Black());
  println("hex {} {} {} {} bad {}", LColor.Hex(), UIColor.FromRGBA(255, 0, 0, 128).Hex(),
    UIColor.FromHSV(120.0f, 1.0f, 1.0f).Hex(), UIColor.Black().Lerp(UIColor.White(), 0.5f).Hex(),
    UIColor.FromHex("zz", UIColor.White()) = UIColor.White());
  UIColor.FromHSV(240.0f, 0.5f, 1.0f).ToHSV(LH, LS, LV);
  println("color {} {} alpha {}", (int32(LH + 0.5f) = 240) and (int32(LS * 10.0f + 0.5f) = 5),
    LColor = UIColor.White(), LColor.WithAlpha(0.5f).Hex());
  LRect := UIRect(x: 0.0f, y: 0.0f, w: 10.0f, h: 10.0f);
  LCenter := LRect.Center();
  println("point {} rect {} {} center {} {}",
    (UIPoint(x: 1.0f, y: 2.0f) + UIPoint(x: 3.0f, y: 4.0f)) * 2.0f = UIPoint(x: 8.0f, y: 12.0f),
    LRect.Contains(UIPoint(x: 5.0f, y: 5.0f)), LRect.Contains(UIPoint(x: 10.0f, y: 5.0f)),
    int32(LCenter.x), int32(LCenter.y));
  LShort := TryHexToRGBA("FFF", LRGBA);
  print("rgba {} {} ", LShort, IntToHex(uint64(LRGBA), 8));
  LHalf := TryHexToRGBA("#0f08", LRGBA);
  LBad := TryHexToRGBA("#12345g", LRGBA);
  LBadLength := TryHexToRGBA("#12345", LRGBA);
  println("{} {} {} {} {} {}", LHalf, IntToHex(uint64(LRGBA), 8), LBad, LBadLength,
    RGBAToHex(0x3A7BD5FF, false), RGBAToHex(0x3A7BD5FF, true));
end;

// REvent's typed reads of a key event made by hand
func ShowEvent();
var
  LEvent: REvent;
begin
  LEvent.type_ := R_EVENT_KEY_DOWN;
  LEvent.key := R_KEY_ENTER;
  LEvent.modifiers := Ruint(R_MOD_CTRL);
  LEvent.repeat_ := R_TRUE;
  LEvent.codepoint := 0x41;
  println("event {} {} {} {} {}", LEvent.Kind() = UIEventKind.KeyDown, LEvent.Key() = UIKey.Enter,
    LEvent.Mods() = [UIModifier.Ctrl], LEvent.Repeat(), LEvent.Char());
end;

var
  LConfig: UIAppConfig;
  LApp: UIApp;
  LWindow: Rid;
  LTimer: UITimerRes;
  LOnce: UITimerRes;
  LI: int64;
begin
  ShowChoices();
  ShowValues();
  ShowEvent();
  UIErrors.OnError(func(const ACode: UIErrorCode; const ASeverity: UISeverity; const ADetail: string)
  begin
    GErrors := GErrors + 1;
    GLastCode := ACode;
  end);
  LConfig := UIApp.Config().AppName("raven_app").Backend(UIBackend.Null);
  LApp := LConfig.Headless(true).NoRenderThread(true).Open();
  println("open {} initialized {} version {}", LApp.IsValid(), UIApp.Initialized(), len(UIApp.Version()) > 0);
  println("current {} second {}", UIApp.Current().IsValid(), UIApp("again").IsValid());
  // a widget id Raven never made: an error its closure sees
  Rwidget_set_attribute(Rid(123456), "Text", "x");
  println("error seen {} {} {}", GErrors > 0, GLastCode = UIErrorCode.InvalidId, UIErrors.Last().Code = GLastCode);
  // a headless window keeps the frames going
  LWindow := Rwindow_create("raven_app", 200, 100, R_WINDOW_DEFAULT);
  LApp.OnFrame(func(const ADelta: float64)
  begin
    GFrames := GFrames + 1;
  end);
  LTimer := UITimerRes(0.01, true, func(const ATimer: UITimerRes)
  begin
    GTicks := GTicks + 1;
    GSelfValid := ATimer.IsValid();
  end);
  LOnce := UITimerRes(0.0, false, func(const ATimer: UITimerRes)
  begin
    GOnce := GOnce + 1;
  end);
  LApp.Post(func()
  begin
    GPosted := GPosted + 1;
  end);
  LI := 0;
  while (LI < 400) and ((GTicks < 3) or (GOnce < 1) or (GPosted < 1)) do
    LApp.WaitFrame(0.01);
    LI := LI + 1;
  end;
  println("ran {} {} {} {} self {}", GFrames > 0, GTicks >= 3, GOnce, GPosted = 1, GSelfValid);
  println("timer valid {} once valid {}", LTimer.IsValid(), LOnce.IsValid());
  LApp.UIScale(2.0f).Animations(false).Direction(UIDirection.RTL);
  println("scale {} animations {} rtl {}", LApp.UIScale() = 2.0f, LApp.Animations(),
    LApp.Direction() = UIDirection.RTL);
  LApp.Quit(7);
  println("quit {}", LApp.ExitCode());
  Rwindow_destroy(LWindow);
  UIErrors.OnError(nil);
end.
