-------------------------------------------------------------------------------
  raven_widget.adam - System.Raven.Ext's widget base (PLAN-RAVENAPI V2) on
  Raven's null backend, headless: a tree built in one chain (Create, Name,
  Add with a UILayout, Insert, End back to the parent), read back (Parent,
  ChildCount, Child, Kind); UIWidget.Kinds holds every kind and a widget
  type of the row's own (LabelView) restates it with one; Find / Has /
  TryFind / As / Is through both, the wrong kind and a missing name raising
  their codes with messages naming the name and both kinds; an XML layout
  made from text. In a headless window: the layout's fills share the row
  (1 : 3), HitTest finds the button, injected mouse input reaches its
  OnEvent closure with the button as the event's Target. State, style and
  accessibility round-trip (visibility, enabled, tooltip, name, classes,
  metric, colour, theme by kind and by name, an unknown theme refused,
  accessible name and role); Text sets and reads a label's. Destroying a
  parent tells its child's OnDestroy and its own, the handles then invalid;
  every closure is released with its widget or the app: nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | kinds 55 one 1 label true
  | tree root 3 Label Button Spacer end root parent root
  | find true true has true false try true false
  | wrong 13 Find<LabelView>: 'go' is a Button, not a Label
  | missing 1 Find<UIWidget>: no widget is named 'nobody'
  | as true 13 As<LabelView>: 'go' is a Button, not a Label
  | is true false false
  | xml VBox 2 T true
  | fill true hit true
  | event true target true
  | state true false tip true name true class true false
  | style metric true color true theme Light true unknown false errors true
  | access true true text Hi
  | destroyed 2 false false
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raven_widget;

import System.SysUtils, System.Raven.C, System.Raven.Ext;

type
  // A widget type of the row's own: a view of label widgets only (as the layer's own widget
  // types restate Kinds)
  LabelView = object(UIWidget)
    static method Kinds(): UIWidgetKinds;
    begin
      return [UIWidgetKind.Label];
    end;
  end;

var
  GEvents: int64;
  GTargetIsButton: bool;
  GButtonId: Rid;
  GTold: int64;
  GErrors: int64;

// The kinds of the base and of LabelView
func ShowKinds();
var
  LKind: UIWidgetKind;
  LCount: int64;
  LOne: int64;
begin
  LCount := 0;
  for LKind in UIWidget.Kinds() do
    LCount := LCount + 1;
  end;
  LOne := 0;
  for LKind in LabelView.Kinds() do
    LOne := LOne + 1;
  end;
  println("kinds {} one {} label {}", LCount, LOne, UIWidgetKind.Label in LabelView.Kinds());
end;

// Finding by name and viewing by kind
func ShowFinding(const ARoot: UIWidget);
var
  LView: LabelView;
  LOther: LabelView;
  LButton: UIWidget;
begin
  LView := ARoot.Find<LabelView>("title");
  println("find {} {} has {} {} try {} {}", LView.IsValid(), ARoot.Find<UIWidget>("go").IsValid(),
    ARoot.Has<LabelView>("title"), ARoot.Has<LabelView>("go"),
    ARoot.TryFind<LabelView>("title", LOther), ARoot.TryFind<LabelView>("go", LOther));
  guard
    LView := ARoot.Find<LabelView>("go");
    println("not reached");
  except
    println("wrong {} {}", exccode(), excmsg());
  end;
  guard
    LButton := ARoot.Find<UIWidget>("nobody");
    println("not reached");
  except
    println("missing {} {}", exccode(), excmsg());
  end;
  LButton := ARoot.Find<UIWidget>("go");
  guard
    LView := LButton.As<LabelView>();
    println("not reached");
  except
    println("as {} {} {}", ARoot.Find<UIWidget>("title").As<LabelView>().IsValid(), exccode(), excmsg());
  end;
  println("is {} {} {}", ARoot.Find<UIWidget>("title").Is<LabelView>(), LButton.Is<LabelView>(),
    UIWidget().Is<UIWidget>());
end;

func Tests();
var
  LConfig: UIAppConfig;
  LApp: UIApp;
  LWindow: Rid;
  LRoot: UIWidget;
  LTitle: UIWidget;
  LButton: UIWidget;
  LSpacer: UIWidget;
  LXML: UIWidget;
  LParent: UIWidget;
  LChild: UIWidget;
  LColor: UIColor;
  LA: UIRect;
  LB: UIRect;
  LI: int64;
begin
  ShowKinds();
  UIErrors.OnError(func(const ACode: UIErrorCode; const ASeverity: UISeverity; const ADetail: string)
  begin
    GErrors := GErrors + 1;
  end);
  LConfig := UIApp.Config().AppName("raven_widget").Backend(UIBackend.Null);
  LApp := LConfig.Headless(true).NoRenderThread(true).Open();

  // a tree in one chain: the spacer inserted first, the title and the button after it
  LTitle := UIWidget.Create(UIWidgetKind.Label).Name("title");
  LButton := UIWidget.Create(UIWidgetKind.Button).Name("go");
  LSpacer := UIWidget.Create(UIWidgetKind.Spacer).Name("gap");
  LRoot := UIWidget.Create(UIWidgetKind.HBox).Name("root")
    .Add(LTitle, UILayout().Fill(1.0f))
    .Add(LButton, UILayout().Fill(3.0f).Margin(0.0f).VAlign(UIVAlign.Fill))
    .Insert(2, LSpacer, UILayout().Auto());
  println("tree {} {} {} {} {} end {} parent {}", LRoot.Name(), LRoot.ChildCount(),
    nameof(LRoot.Child(0).Kind()), nameof(LRoot.Child(1).Kind()), nameof(LRoot.Child(2).Kind()),
    LButton.Add(UIWidget()).End().Name(), LTitle.Parent().Name());
  ShowFinding(LRoot);
  LXML := UIWidget.FromXMLText("<VBox Name=\"box\"><Label Name=\"title\" Text=\"T\"/><Button Name=\"go\" Text=\"Go\"/></VBox>");
  println("xml {} {} {} {}", nameof(LXML.Kind()), LXML.ChildCount(), LXML.Find<LabelView>("title").Text(),
    LXML.Find<UIWidget>("go").Is<UIWidget>());
  LXML.Destroy();

  // in a headless window: the fills share the row, the button takes the pointer
  LWindow := Rwindow_create("raven_widget", 400, 100, R_WINDOW_DEFAULT);
  Rwindow_set_content(LWindow, LRoot.Id());
  GButtonId := LButton.Id();
  LButton.OnEvent(func(const AEvent: REvent): bool
  begin
    GEvents := GEvents + 1;
    if AEvent.Target().Id() = GButtonId then
      GTargetIsButton := true;
    end;
    return false;
  end);
  for LI := 1 to 5 do
    LApp.WaitFrame(0.01);
  end;
  LA := LTitle.Rect();
  LB := LButton.Rect();
  println("fill {} hit {}", (LA.w > 0.0f) and (LB.w > LA.w * 2.5f),
    LRoot.HitTest(LB.Center()).Id() = LButton.Id());
  Rwindow_inject_mouse_move(LWindow, LB.x + 10.0f, LB.y + 10.0f);
  Rwindow_inject_mouse_button(LWindow, R_MOUSE_LEFT, R_TRUE);
  Rwindow_inject_mouse_button(LWindow, R_MOUSE_LEFT, R_FALSE);
  for LI := 1 to 5 do
    LApp.WaitFrame(0.01);
  end;
  println("event {} target {}", GEvents > 0, GTargetIsButton);

  // state, style, accessibility, text
  LTitle.Hide().Enabled(false).Tooltip("tip").Name("heading").Class("big").AddClass("bold");
  println("state {} {} tip {} name {} class {} {}", LTitle.Visibility() = UIVisibility.Hidden,
    LTitle.Enabled(), LTitle.Tooltip() = "tip", LRoot.Has<LabelView>("heading"),
    LTitle.HasClass("bold"), LTitle.RemoveClass("bold").HasClass("bold"));
  LTitle.Show().Enabled(true);
  LTitle.Metric(UIMetric.FontSize, 21.0f).Color(UIColorRole.Text, UIColor(r: 1.0f, g: 0.0f, b: 0.0f, a: 1.0f));
  LColor := LTitle.Color(UIColorRole.Text);
  LTitle.Theme(UIThemeKind.Light);
  println("style metric {} color {} theme {} {} unknown {} errors {}", LTitle.Metric(UIMetric.FontSize) = 21.0f,
    (LColor.r = 1.0f) and (LColor.g = 0.0f), LTitle.Theme(), LTitle.Theme(""), LTitle.Theme("NoSuchTheme"),
    GErrors > 0);
  LButton.AccessibleName("Start").AccessibleRole(UIRole.Button);
  LTitle.Text("Hi");
  println("access {} {} text {}", LButton.AccessibleName() = "Start", LButton.AccessibleRole() = UIRole.Button,
    LTitle.Text());

  // a destroyed parent tells its child and itself; the handles are then invalid
  LChild := UIWidget.Create(UIWidgetKind.Label).OnDestroy(func()
  begin
    GTold := GTold + 1;
  end);
  LParent := UIWidget.Create(UIWidgetKind.VBox).Add(LChild).OnDestroy(func()
  begin
    GTold := GTold + 1;
  end);
  LParent.Destroy();
  println("destroyed {} {} {}", GTold, LChild.IsValid(), LParent.IsValid());

  LButton.OnEvent(nil);
  Rwindow_destroy(LWindow);
  UIErrors.OnError(nil);
end;

begin
  Tests();
  println("end");
end.
