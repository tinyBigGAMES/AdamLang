-------------------------------------------------------------------------------
  raylib_draw.adam - System.Raylib.Ext's object layer, the drawing part
  (PLAN-RAVENAPI R4) over a hidden frame window: Spline's points on each
  kind of piece (the values raylib's formulas give), then one frame that
  draws through every Draw member: the 2D and 3D modes, blending, a
  scissor inside the letterbox and one wholly outside it, every shape,
  line, spline and 3D primitive, the default font's text, and the
  point-list members given an empty list (they draw nothing). The frame
  ends as the frame's own clip and camera, so the window closes clean.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | linear 5.000 10.000
  | quadratic 10.000 10.000
  | cubic 5.000 7.500
  | basis 6.000 1.000
  | catmullrom 6.000 0.000 12.000 6.000
  | drawn true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raylib_draw;

import System.SysUtils, System.Raylib.C, System.Raylib.Ext;

const
  // A spline's four points: P2 to P3 is the piece a Catmull-Rom or B-spline segment draws
  CURVE: array[0..3] of Vector2 = [Vector2(x: 0.0f, y: 0.0f), Vector2(x: 6.0f, y: 0.0f),
    Vector2(x: 12.0f, y: 6.0f), Vector2(x: 18.0f, y: 0.0f)];
  // One quadratic Bezier piece: point, control, point
  QUAD: array[0..2] of Vector2 = [Vector2(x: 0.0f, y: 0.0f), Vector2(x: 6.0f, y: 12.0f),
    Vector2(x: 12.0f, y: 0.0f)];
  // A 3D strip of two triangles
  STRIP: array[0..3] of Vector3 = [Vector3(x: 0.0f, y: 0.0f, z: 0.0f),
    Vector3(x: 1.0f, y: 0.0f, z: 0.0f), Vector3(x: 0.0f, y: 1.0f, z: 0.0f),
    Vector3(x: 1.0f, y: 1.0f, z: 0.0f)];

// Spline's points (no window needed)
func Points();
var
  LP: Vector2;
  LAt0: Vector2;
  LAt1: Vector2;
begin
  LP := Spline.Linear(Vector2(x: 0.0f, y: 0.0f), Vector2(x: 10.0f, y: 20.0f), 0.5f);
  println("linear {:.3f} {:.3f}", LP.x, LP.y);
  LP := Spline.BezierQuadratic(Vector2(x: 0.0f, y: 0.0f), Vector2(x: 10.0f, y: 20.0f),
    Vector2(x: 20.0f, y: 0.0f), 0.5f);
  println("quadratic {:.3f} {:.3f}", LP.x, LP.y);
  LP := Spline.BezierCubic(Vector2(x: 0.0f, y: 0.0f), Vector2(x: 0.0f, y: 10.0f),
    Vector2(x: 10.0f, y: 10.0f), Vector2(x: 10.0f, y: 0.0f), 0.5f);
  println("cubic {:.3f} {:.3f}", LP.x, LP.y);
  // A B-spline piece starts at (P1 + 4 P2 + P3) / 6
  LP := Spline.Basis(CURVE[0], CURVE[1], CURVE[2], CURVE[3], 0.0f);
  println("basis {:.3f} {:.3f}", LP.x, LP.y);
  // A Catmull-Rom piece runs from P2 (at 0) to P3 (at 1)
  LAt0 := Spline.CatmullRom(CURVE[0], CURVE[1], CURVE[2], CURVE[3], 0.0f);
  LAt1 := Spline.CatmullRom(CURVE[0], CURVE[1], CURVE[2], CURVE[3], 1.0f);
  println("catmullrom {:.3f} {:.3f} {:.3f} {:.3f}", LAt0.x, LAt0.y, LAt1.x, LAt1.y);
end;

// One frame through every Draw member; the window's value closes it at the end
func Frame();
var
  LWin: Window;
  LNone: array of Vector2;
  LNone3D: array of Vector3;
  LCenter: Vector2;
  LRect: Rectangle;
  LCamera: Camera2D;
  LCamera3D: Camera3D;
begin
  Log.Level(LogLevel.None);
  LWin := Window.Config().Size(320, 180).Flags([WindowFlag.Hidden]).Open();
  LCenter := Vector2(x: 160.0f, y: 90.0f);
  LRect := Rectangle(x: 20.0f, y: 20.0f, width: 80.0f, height: 40.0f);
  LCamera := Camera2D.Make(Vector2(x: 0.0f, y: 0.0f), Vector2(x: 0.0f, y: 0.0f), 0.0f, 1.0f);
  LCamera3D := Camera3D.Make(Vector3(x: 4.0f, y: 4.0f, z: 4.0f), Vector3(x: 0.0f, y: 0.0f,
    z: 0.0f), Vector3(x: 0.0f, y: 1.0f, z: 0.0f), 45.0f, Projection.Perspective);

  LWin.BeginFrame();
  // Pixels, lines, triangles
  Draw.Pixel(LCenter, WHITE);
  Draw.Line(Vector2(x: 0.0f, y: 0.0f), LCenter, RED);
  Draw.Line(Vector2(x: 0.0f, y: 0.0f), LCenter, 3.0f, RED);
  Draw.LineStrip(CURVE, GREEN);
  Draw.LineBezier(Vector2(x: 0.0f, y: 0.0f), LCenter, 2.0f, BLUE);
  Draw.LineDashed(Vector2(x: 0.0f, y: 170.0f), Vector2(x: 300.0f, y: 170.0f), 6, 4, GRAY);
  Draw.Triangle(Vector2(x: 10.0f, y: 10.0f), Vector2(x: 0.0f, y: 30.0f),
    Vector2(x: 20.0f, y: 30.0f), YELLOW);
  Draw.Triangle(Vector2(x: 10.0f, y: 10.0f), Vector2(x: 0.0f, y: 30.0f),
    Vector2(x: 20.0f, y: 30.0f), RED, GREEN, BLUE);
  Draw.TriangleLines(Vector2(x: 10.0f, y: 10.0f), Vector2(x: 0.0f, y: 30.0f),
    Vector2(x: 20.0f, y: 30.0f), WHITE);
  Draw.TriangleLines(Vector2(x: 10.0f, y: 10.0f), Vector2(x: 0.0f, y: 30.0f),
    Vector2(x: 20.0f, y: 30.0f), 2.0f, WHITE);
  Draw.TriangleFan(CURVE, ORANGE);
  Draw.TriangleStrip(CURVE, PURPLE);
  // Rectangles
  Draw.Rect(LRect, DARKBLUE);
  Draw.Rect(LRect, Vector2(x: 40.0f, y: 20.0f), 30.0f, SKYBLUE);
  Draw.RectGradientV(LRect, RED, BLUE);
  Draw.RectGradientH(LRect, RED, BLUE);
  Draw.RectGradient(LRect, RED, GREEN, BLUE, YELLOW);
  Draw.RectLines(LRect, WHITE);
  Draw.RectLines(LRect, 2.0f, WHITE);
  Draw.RectRounded(LRect, 0.5f, 6, MAROON);
  Draw.RectRoundedLines(LRect, 0.5f, 6, WHITE);
  Draw.RectRoundedLines(LRect, 0.5f, 6, 2.0f, WHITE);
  // Polygons, circles, ellipses, rings
  Draw.Poly(LCenter, 6, 20.0f, 0.0f, LIME);
  Draw.PolyLines(LCenter, 6, 20.0f, 0.0f, WHITE);
  Draw.PolyLines(LCenter, 6, 20.0f, 0.0f, 2.0f, WHITE);
  Draw.Circle(LCenter, 12.0f, GOLD);
  Draw.CircleGradient(LCenter, 12.0f, WHITE, BLACK);
  Draw.CircleSector(LCenter, 12.0f, 0.0f, 90.0f, 8, PINK);
  Draw.CircleSectorLines(LCenter, 12.0f, 0.0f, 90.0f, 8, WHITE);
  Draw.CircleSectorLines(LCenter, 12.0f, 0.0f, 90.0f, 8, 2.0f, WHITE);
  Draw.CircleLines(LCenter, 14.0f, WHITE);
  Draw.CircleLines(LCenter, 14.0f, 2.0f, WHITE);
  Draw.Ellipse(LCenter, 30.0f, 10.0f, BEIGE);
  Draw.EllipseLines(LCenter, 30.0f, 10.0f, WHITE);
  Draw.EllipseLines(LCenter, 30.0f, 10.0f, 2.0f, WHITE);
  Draw.Ring(LCenter, 20.0f, 30.0f, 0.0f, 270.0f, 16, VIOLET);
  Draw.RingLines(LCenter, 20.0f, 30.0f, 0.0f, 270.0f, 16, WHITE);
  Draw.RingLines(LCenter, 20.0f, 30.0f, 0.0f, 270.0f, 16, 2.0f, WHITE);
  // Splines and their pieces
  Draw.SplineLinear(CURVE, 2.0f, GREEN);
  Draw.SplineBasis(CURVE, 2.0f, GREEN);
  Draw.SplineCatmullRom(CURVE, 2.0f, GREEN);
  Draw.SplineBezierQuadratic(QUAD, 2.0f, GREEN);
  Draw.SplineBezierCubic(CURVE, 2.0f, GREEN);
  Draw.SegmentLinear(CURVE[0], CURVE[1], 2.0f, BLUE);
  Draw.SegmentBasis(CURVE[0], CURVE[1], CURVE[2], CURVE[3], 2.0f, BLUE);
  Draw.SegmentCatmullRom(CURVE[0], CURVE[1], CURVE[2], CURVE[3], 2.0f, BLUE);
  Draw.SegmentBezierQuadratic(CURVE[0], CURVE[1], CURVE[2], 2.0f, BLUE);
  Draw.SegmentBezierCubic(CURVE[0], CURVE[1], CURVE[2], CURVE[3], 2.0f, BLUE);
  // Point lists with no points draw nothing
  Draw.LineStrip(LNone, RED);
  Draw.TriangleFan(LNone, RED);
  Draw.TriangleStrip(LNone, RED);
  Draw.SplineLinear(LNone, 2.0f, RED);
  Draw.SplineBasis(LNone, 2.0f, RED);
  Draw.SplineCatmullRom(LNone, 2.0f, RED);
  Draw.SplineBezierQuadratic(LNone, 2.0f, RED);
  Draw.SplineBezierCubic(LNone, 2.0f, RED);
  // Text, sizes below the default font's 10 held at 10
  Draw.Text("Adam", Vector2(x: 8.0f, y: 8.0f), 20.0f, WHITE);
  Draw.Text("small", Vector2(x: 8.0f, y: 40.0f), 4.0f, WHITE);
  Draw.FPS(Vector2(x: 240.0f, y: 8.0f));
  // Modes: a 2D camera, blending, a scissor inside and one wholly outside the frame
  Draw.Begin2D(LCamera);
  Draw.Rect(LRect, GREEN);
  Draw.End2D();
  Draw.BeginBlend(Blend.Additive);
  Draw.Circle(LCenter, 8.0f, ORANGE);
  Draw.EndBlend();
  Draw.BeginScissor(LRect);
  Draw.Circle(LCenter, 80.0f, RED);
  Draw.EndScissor();
  Draw.BeginScissor(Rectangle(x: -500.0f, y: -500.0f, width: 10.0f, height: 10.0f));
  Draw.Circle(LCenter, 80.0f, RED);
  Draw.EndScissor();
  // 3D
  Draw.Begin3D(LCamera3D);
  Draw.Grid(10, 1.0f);
  Draw.Line3D(Vector3(x: 0.0f, y: 0.0f, z: 0.0f), Vector3(x: 1.0f, y: 1.0f, z: 1.0f), RED);
  Draw.Point3D(Vector3(x: 0.0f, y: 1.0f, z: 0.0f), RED);
  Draw.Circle3D(Vector3(x: 0.0f, y: 0.0f, z: 0.0f), 1.0f, Vector3(x: 1.0f, y: 0.0f, z: 0.0f),
    90.0f, BLUE);
  Draw.Triangle3D(STRIP[0], STRIP[1], STRIP[2], GREEN);
  Draw.TriangleStrip3D(STRIP, GREEN);
  Draw.TriangleStrip3D(LNone3D, RED);
  Draw.Cube(Vector3(x: 0.0f, y: 0.5f, z: 0.0f), Vector3(x: 1.0f, y: 1.0f, z: 1.0f), RED);
  Draw.CubeWires(Vector3(x: 0.0f, y: 0.5f, z: 0.0f), Vector3(x: 1.0f, y: 1.0f, z: 1.0f),
    MAROON);
  Draw.Sphere(Vector3(x: 2.0f, y: 0.5f, z: 0.0f), 0.5f, BLUE);
  Draw.Sphere(Vector3(x: 2.0f, y: 0.5f, z: 0.0f), 0.5f, 8, 8, BLUE);
  Draw.SphereWires(Vector3(x: 2.0f, y: 0.5f, z: 0.0f), 0.5f, 8, 8, WHITE);
  Draw.Cylinder(Vector3(x: -2.0f, y: 0.0f, z: 0.0f), 0.2f, 0.5f, 1.0f, 8, GREEN);
  Draw.Cylinder(Vector3(x: -2.0f, y: 0.0f, z: 0.0f), Vector3(x: -2.0f, y: 1.0f, z: 0.0f),
    0.5f, 0.2f, 8, GREEN);
  Draw.CylinderWires(Vector3(x: -2.0f, y: 0.0f, z: 0.0f), 0.2f, 0.5f, 1.0f, 8, WHITE);
  Draw.CylinderWires(Vector3(x: -2.0f, y: 0.0f, z: 0.0f), Vector3(x: -2.0f, y: 1.0f, z: 0.0f),
    0.5f, 0.2f, 8, WHITE);
  Draw.Capsule(Vector3(x: 0.0f, y: 0.0f, z: 2.0f), Vector3(x: 0.0f, y: 1.0f, z: 2.0f), 0.3f,
    8, 4, GOLD);
  Draw.CapsuleWires(Vector3(x: 0.0f, y: 0.0f, z: 2.0f), Vector3(x: 0.0f, y: 1.0f, z: 2.0f),
    0.3f, 8, 4, WHITE);
  Draw.Plane(Vector3(x: 0.0f, y: 0.0f, z: 0.0f), Vector2(x: 4.0f, y: 4.0f), DARKGRAY);
  Draw.Ray(Ray(position: Vector3(x: 0.0f, y: 0.0f, z: 0.0f), direction: Vector3(x: 0.0f,
    y: 1.0f, z: 0.0f)), YELLOW);
  Draw.Box(BoundingBox(min: Vector3(x: -1.0f, y: 0.0f, z: -1.0f), max: Vector3(x: 1.0f,
    y: 1.0f, z: 1.0f)), LIME);
  Draw.End3D();
  LWin.EndFrame();
  println("drawn {}", IsWindowReady());
end;

begin
  Points();
  Frame();
  // AV.9: nothing is left open whatever the checks above did
  if IsWindowReady() then
    CloseWindow();
  end;
end.
