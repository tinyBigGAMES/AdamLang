  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  raylib_image.adam - System.Raylib.Ext's resources, the CPU part (PLAN-
  RAVENAPI R5), with no window: Assets mounts bin\assets.zip and an
  ImageRes loads from it by the entry's name; images are generated, changed
  in place through fluent chains, drawn on and read back pixel by pixel; a
  copy of the handle shares the pixels while Copy() makes new ones (the
  palette counts no fully clear pixel, as raylib's); the
  image goes to PNG bytes and back; a GlyphsRes loads a font file's glyphs
  and ImageRes.FontAtlas packs them; an empty handle reads as nothing and
  ignores its changes. Every image is freed by its last copy (the [Heap]
  line), the archive by Unmount.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | mounted true
  | logo true 512 512 R8G8B8A8
  | fill 230 41 55 255
  | shared 0 121 241 255
  | copy 0 228 48 255 kept 0 121 241 255
  | chain 4 2 rotated 2 4
  | drawn 230 41 55 255 corner 0 0 0 0
  | colors 16 palette 1
  | border 2.000 2.000 4.000 4.000
  | gray Gray 1 channel Gray
  | png true 4 4 230 41 55 255
  | made 8 8 8 8 8 8
  | glyphs 95 32 0 atlas true 95
  | empty false 0 0 0 0
  | mounted false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raylib_image;

import System.SysUtils, System.Raylib.C, System.Raylib.Ext;

const
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";

func Show(const ALabel: string; const AColor: Color);
begin
  println("{} {} {} {} {}", ALabel, AColor.r, AColor.g, AColor.b, AColor.a);
end;

// A font file's bytes, read through the mounted source as raylib reads it
func FontBytes(const APath: string): array of uint8;
var
  LSize: int32;
  LData: ptr to uint8;
  LBytes: array of uint8;
  LI: int64;
begin
  LSize := 0;
  LData := LoadFileData(APath, addr of LSize);
  setlength(LBytes, int64(LSize));
  for LI := 0 to int64(LSize) - 1 do
    LBytes[LI] := LData[LI];
  end;
  if LData <> nil then
    UnloadFileData(LData);
  end;
  return LBytes;
end;

func Run();
var
  LLogo: ImageRes;
  LFill: ImageRes;
  LShared: ImageRes;
  LCopy: ImageRes;
  LChain: ImageRes;
  LCanvas: ImageRes;
  LBorder: ImageRes;
  LGray: ImageRes;
  LBack: ImageRes;
  LEmpty: ImageRes;
  LPNG: array of uint8;
  LRect: Rectangle;
  LGlyphs: GlyphsRes;
  LAtlas: ImageRes;
  LRecs: array of Rectangle;
  LNoCodepoints: array of int32;
begin
  Log.Level(LogLevel.None);
  println("mounted {}", Assets.Mount(ASSETS_ZIP, "Adam"));

  // Loaded from the mounted zip by the entry's own name
  LLogo := ImageRes("res/assets/images/adam.png");
  println("logo {} {} {} {}", LLogo.IsValid(), LLogo.Width(), LLogo.Height(), LLogo.Format());

  LFill := ImageRes.Color(4, 4, RED);
  Show("fill", LFill.Pixel(0, 0));

  // A copy of the handle shares the pixels; Copy() makes new ones
  LShared := LFill;
  LShared.Clear(BLUE);
  Show("shared", LFill.Pixel(1, 1));
  LCopy := LFill.Copy();
  LCopy.Clear(GREEN);
  println("copy {} {} {} {} kept {} {} {} {}", LCopy.Pixel(0, 0).r, LCopy.Pixel(0, 0).g,
    LCopy.Pixel(0, 0).b, LCopy.Pixel(0, 0).a, LFill.Pixel(0, 0).r, LFill.Pixel(0, 0).g,
    LFill.Pixel(0, 0).b, LFill.Pixel(0, 0).a);

  // In place, fluent: each change returns the image
  LChain := ImageRes.Color(8, 4, WHITE).Resize(4, 2).FlipVertical();
  print("chain {} {}", LChain.Width(), LChain.Height());
  LChain.RotateCW();
  println(" rotated {} {}", LChain.Width(), LChain.Height());

  // Drawing on an image, read back by pixel
  LCanvas := ImageRes.Color(4, 4, BLANK);
  LCanvas.Rect(Rectangle(x: 1.0f, y: 1.0f, width: 2.0f, height: 2.0f), RED)
    .Line(Vector2(x: 1.0f, y: 1.0f), Vector2(x: 2.0f, y: 1.0f), RED)
    .Pixel(Vector2(x: 2.0f, y: 2.0f), RED)
    .Circle(Vector2(x: 2.0f, y: 2.0f), 0, RED)
    .Triangle(Vector2(x: 1.0f, y: 1.0f), Vector2(x: 1.0f, y: 2.0f), Vector2(x: 2.0f, y: 2.0f),
      RED)
    .RectLines(Rectangle(x: 1.0f, y: 1.0f, width: 2.0f, height: 2.0f), RED)
    .Image(LFill.Copy().Clear(RED), Rectangle(x: 0.0f, y: 0.0f, width: 1.0f, height: 1.0f),
      Vector2(x: 1.0f, y: 1.0f), WHITE);
  print("drawn {} {} {} {}", LCanvas.Pixel(1, 1).r, LCanvas.Pixel(1, 1).g, LCanvas.Pixel(1, 1).b,
    LCanvas.Pixel(1, 1).a);
  println(" corner {} {} {} {}", LCanvas.Pixel(0, 0).r, LCanvas.Pixel(0, 0).g,
    LCanvas.Pixel(0, 0).b, LCanvas.Pixel(0, 0).a);
  println("colors {} palette {}", len(LCanvas.Colors()), len(LCanvas.Palette(8)));

  // The opaque part of an image with a clear edge
  LBorder := ImageRes.Color(8, 8, BLANK);
  LBorder.Rect(Rectangle(x: 2.0f, y: 2.0f, width: 4.0f, height: 4.0f), WHITE);
  LRect := LBorder.AlphaBorder(0.5f);
  println("border {:.3f} {:.3f} {:.3f} {:.3f}", LRect.x, LRect.y, LRect.width, LRect.height);

  LGray := LCanvas.Copy().ToFormat(Pixel.Gray);
  println("gray {} {} channel {}", LGray.Format(), LGray.Mipmaps(), LCanvas.Channel(0).Format());

  // To PNG bytes and back
  LPNG := LCanvas.ExportToMemory(".png");
  LBack := ImageRes.FromMemory(".png", LPNG);
  println("png {} {} {} {} {} {} {}", len(LPNG) > 0, LBack.Width(), LBack.Height(),
    LBack.Pixel(1, 1).r, LBack.Pixel(1, 1).g, LBack.Pixel(1, 1).b, LBack.Pixel(1, 1).a);

  println("made {} {} {} {} {} {}", ImageRes.Checked(8, 8, 2, 2, RED, BLUE).Width(),
    ImageRes.GradientLinear(8, 8, 0, RED, BLUE).Width(),
    ImageRes.GradientRadial(8, 8, 0.5f, RED, BLUE).Height(),
    ImageRes.WhiteNoise(8, 8, 0.5f).Width(), ImageRes.PerlinNoise(8, 8, 0, 0, 1.0f).Width(),
    ImageRes.Cellular(8, 8, 4).Height());

  // A font file's glyphs (raylib's default 95), packed into an atlas
  setlength(LNoCodepoints, 0);
  LGlyphs := FontRes.Glyphs(FontBytes("res/assets/fonts/KenneyMiniSquareMono.ttf"), 16,
    LNoCodepoints, FontKind.Default);
  LAtlas := ImageRes.FontAtlas(LGlyphs, LRecs, 16, 2, 0);
  println("glyphs {} {} {} atlas {} {}", LGlyphs.Count(), LGlyphs.Glyph(0).value,
    LGlyphs.Glyph(-1).value, LAtlas.IsValid(), len(LRecs));

  // An empty handle reads as nothing and ignores its changes
  LEmpty.Crop(Rectangle(x: 0.0f, y: 0.0f, width: 1.0f, height: 1.0f)).Clear(RED);
  println("empty {} {} {} {} {}", LEmpty.IsValid(), LEmpty.Width(), LEmpty.Height(),
    len(LEmpty.Colors()), len(LEmpty.ExportToMemory(".png")));

  Assets.Unmount();
  println("mounted {}", Assets.Mounted());
end;

begin
  Run();
end.
