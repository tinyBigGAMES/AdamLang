-------------------------------------------------------------------------------
  raylib_automation.adam - System.Raylib.Ext's automation events and dropped
  files (PLAN-RAVENAPI R8), over a hidden frame window: empty handles and a
  capacity below 1 hold nothing; StartRecording with no list in use records
  nothing (a played key goes through); a list of its own capacity, in use,
  records a played key held over a frame (its AutomationKind and key), is
  exported as .rae and loaded back by path, by IO and from nil; the list in
  use outlives its last handle while raylib records into it; a kind raylib
  does not make reads None; no files were dropped.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | empty false 0 false false
  | open true
  | guard true
  | recorded true key true released false
  | export true path true io true nil true 0 adopt true 0
  | pinned true
  | kind true true
  | dropped false 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raylib_automation;

import System.SysUtils, System.IO, System.CustomIO, System.Raylib.C, System.Raylib.Ext;

const
  // Written beside the row's exe, removed before it ends
  EVENTS_FILE: string = "$P:raylib_automation.rae";

// A played key event: AKind for raylib's KEY_A
func KeyEvent(const AKind: AutomationKind): AutomationEvent;
begin
  return AutomationEvent(frame: 0, type_: uint32(AKind), params: [KEY_A, 0, 0, 0]);
end;

// True when AList holds a key-down event of KEY_A
func HasKeyDown(const AList: AutomationRes): bool;
var
  LI: int32;
  LEvent: AutomationEvent;
begin
  for LI := 0 to AList.Count() - 1 do
    LEvent := AList.Event(LI);
    if (LEvent.Kind() = AutomationKind.KeyDown) and (LEvent.params[0] = KEY_A) then
      return true;
    end;
  end;
  return false;
end;

// One frame of the hidden window (raylib records the list in use at its end)
func OneFrame(var AWin: Window);
begin
  AWin.BeginFrame();
  AWin.Clear(BLACK);
  AWin.EndFrame();
end;

func Run();
var
  LWin: Window;
  LEmpty: AutomationRes;
  LNone: AutomationRes;
  LRun: AutomationRes;
  LBack: AutomationRes;
  LFromIO: AutomationRes;
  LFromNil: AutomationRes;
  LAdopted: AutomationRes;
  LTemp: AutomationRes;
  LIO: IO;
  LPath: string;
  LSaved: bool;
  LRecorded: bool;
  LOdd: AutomationEvent;
begin
  Log.Level(LogLevel.None);
  LNone := AutomationRes(0);
  println("empty {} {} {} {}", LEmpty.IsValid(), LEmpty.Count(), LEmpty.Export(EVENTS_FILE),
    LNone.IsValid());

  LWin := Window.Config().Size(64, 64).Flags([WindowFlag.Hidden]).Open();
  println("open {}", LWin.Ready());

  // No list in use: StartRecording does nothing, so a played event goes through
  AutomationRes.StartRecording();
  AutomationRes.Play(KeyEvent(AutomationKind.KeyDown));
  println("guard {}", IsKeyDown(KEY_A));

  // The key held over a frame is recorded into the list in use
  LRun := AutomationRes(16);
  LRun.Use();
  AutomationRes.BaseFrame(0);
  AutomationRes.StartRecording();
  OneFrame(LWin);
  AutomationRes.StopRecording();
  LRecorded := LRun.Count() >= 1;
  AutomationRes.Play(KeyEvent(AutomationKind.KeyUp));
  println("recorded {} key {} released {}", LRecorded, HasKeyDown(LRun), IsKeyDown(KEY_A));

  // Saved as .rae and loaded back three ways
  LPath := ResolvePath(EVENTS_FILE);
  LSaved := LRun.Export(LPath);
  LBack := AutomationRes(LPath);
  LIO := CreateFileIO(LPath, FileMode.Read);
  LFromIO := AutomationRes.FromIO(LIO);
  IOClose(LIO);
  LFromNil := AutomationRes.FromIO(nil);
  LAdopted := AutomationRes.Adopt(LoadAutomationEventList(nil));
  println("export {} path {} io {} nil {} {} adopt {} {}", LSaved,
    (LBack.Count() = LRun.Count()) and HasKeyDown(LBack),
    (LFromIO.Count() = LRun.Count()) and HasKeyDown(LFromIO), LFromNil.IsValid(),
    LFromNil.Count(), LAdopted.IsValid(), LAdopted.Count());
  DeleteFile(LPath);

  // The list in use outlives its last handle while raylib records into it
  LTemp := AutomationRes(4);
  LTemp.Use();
  LTemp := AutomationRes();
  AutomationRes.StartRecording();
  OneFrame(LWin);
  AutomationRes.StopRecording();
  LRun.Use();
  println("pinned {}", not LTemp.IsValid());

  LOdd.type_ := 99;
  println("kind {} {}", LOdd.Kind() = AutomationKind.None,
    KeyEvent(AutomationKind.KeyDown).Kind() = AutomationKind.KeyDown);
  println("dropped {} {}", Dropped.Any(), len(Dropped.Files()));
end;

begin
  Run();
end.
