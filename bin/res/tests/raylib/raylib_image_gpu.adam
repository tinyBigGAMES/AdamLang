-------------------------------------------------------------------------------
  raylib_image_gpu.adam - System.Raylib.Ext's resources, the GPU part
  (PLAN-RAVENAPI R5), over a hidden frame window opened with an icon:
  TextureRes loaded from the mounted assets, made from an image and back,
  changed (filter, wrap, mipmaps, a rectangle of pixels); a RenderTextureRes
  drawn into inside the frame (the frame's camera and clip come back after
  it) and its views; FontRes loaded at a size, measured (MeasureText's
  rules through FontRes.Default()), its glyphs and atlas; images of text;
  the window's icons and snapshot; and one frame drawing every Draw member
  that takes a resource (textures of each form, render textures upright,
  the n-patch, text in a font, a render texture drawn into another the
  right way up (whole and a part), codepoints, billboards, the shapes texture).
  Then the order-proof teardown: a texture kept in a global past the
  window's close is unloaded by the window's last release (a later release
  does nothing), and the textures of a window the program closes itself
  (raylib's own CloseWindow) are given up with it.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | open true
  | texture true 512 512 R8G8B8A8 mipmaps 10
  | image 230 41 55 255 updated 0 121 241 255
  | target true 32 16 views true 32 true
  | frame true clip true
  | font true 32 95 measure true default true
  | glyph 33 65 atlas true default true
  | text true true 64 32 logo 512
  | upright true true part true
  | drawn true snapshot true
  | kept true
  | teardown false image true
  | abandoned false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raylib_image_gpu;

import System.SysUtils, System.Raylib.C, System.Raylib.Ext;

const
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";
  LOGO: string = "res/assets/images/adam.png";
  MONO: string = "res/assets/fonts/JetBrainsMonoRegular.ttf";

var
  // Kept past the window's close: the window's last release unloads them first
  GKeep: TextureRes;
  GKeepImage: ImageRes;

// One frame through every Draw member that takes a resource
func DrawAll(var AWin: Window; const ATex: TextureRes; const ATarget: RenderTextureRes;
  const AFont: FontRes);
var
  LCamera: Camera3D;
  LInfo: NPatchInfo;
  LCodepoints: array of int32;
  LWhole: Rectangle;
begin
  LWhole := Rectangle(x: 0.0f, y: 0.0f, width: 16.0f, height: 16.0f);
  LInfo.source := LWhole;
  LInfo.left := 4;
  LInfo.top := 4;
  LInfo.right := 4;
  LInfo.bottom := 4;
  LInfo.layout := int32(NPatch.NinePatch);
  setlength(LCodepoints, 2);
  LCodepoints[0] := 65;
  LCodepoints[1] := 66;
  LCamera := Camera3D(position: Vector3(x: 0.0f, y: 2.0f, z: 6.0f),
    target: Vector3(x: 0.0f, y: 0.0f, z: 0.0f), up: Vector3(x: 0.0f, y: 1.0f, z: 0.0f),
    fovy: 45.0f, projection: int32(Projection.Perspective));

  AWin.BeginFrame();
  Draw.Texture(ATex, Vector2(x: 0.0f, y: 0.0f), WHITE);
  Draw.Texture(ATex, Vector2(x: 4.0f, y: 4.0f), 30.0f, 0.1f, WHITE);
  Draw.Texture(ATex, LWhole, Vector2(x: 8.0f, y: 8.0f), WHITE);
  Draw.Texture(ATex, LWhole, Rectangle(x: 10.0f, y: 10.0f, width: 32.0f, height: 32.0f),
    Vector2(x: 16.0f, y: 16.0f), 45.0f, WHITE);
  Draw.Texture(ATarget, Vector2(x: 40.0f, y: 0.0f), WHITE);
  Draw.Texture(ATarget, Vector2(x: 40.0f, y: 20.0f), 10.0f, 2.0f, WHITE);
  Draw.Texture(ATarget, Rectangle(x: 0.0f, y: 0.0f, width: 16.0f, height: 8.0f),
    Vector2(x: 80.0f, y: 0.0f), WHITE);
  Draw.Texture(ATarget, Rectangle(x: 0.0f, y: 0.0f, width: 32.0f, height: 16.0f),
    Rectangle(x: 80.0f, y: 20.0f, width: 64.0f, height: 32.0f), Vector2(x: 0.0f, y: 0.0f),
    0.0f, WHITE);
  Draw.NPatch(ATex, LInfo, Rectangle(x: 150.0f, y: 0.0f, width: 40.0f, height: 20.0f),
    Vector2(x: 0.0f, y: 0.0f), 0.0f, WHITE);
  Draw.Text(AFont, "Adam", Vector2(x: 0.0f, y: 100.0f), 16.0f, 1.0f, WHITE);
  Draw.Text(AFont, "Adam", Vector2(x: 60.0f, y: 100.0f), Vector2(x: 0.0f, y: 0.0f), 15.0f,
    16.0f, 1.0f, WHITE);
  Draw.Codepoint(AFont, 65, Vector2(x: 120.0f, y: 100.0f), 16.0f, WHITE);
  Draw.Codepoints(AFont, LCodepoints, Vector2(x: 140.0f, y: 100.0f), 16.0f, 1.0f, WHITE);
  Draw.ShapesTexture(ATex, LWhole);
  Draw.Rect(Rectangle(x: 200.0f, y: 100.0f, width: 10.0f, height: 10.0f), WHITE);
  Draw.ShapesTexture(Draw.ShapesTexture(), Draw.ShapesTextureRect());
  Draw.Begin3D(LCamera);
  Draw.Billboard(LCamera, ATex, Vector3(x: 0.0f, y: 0.0f, z: 0.0f), 1.0f, WHITE);
  Draw.Billboard(LCamera, ATex, LWhole, Vector3(x: 1.0f, y: 0.0f, z: 0.0f),
    Vector2(x: 1.0f, y: 1.0f), WHITE);
  Draw.Billboard(LCamera, ATex, LWhole, Vector3(x: -1.0f, y: 0.0f, z: 0.0f),
    Vector3(x: 0.0f, y: 1.0f, z: 0.0f), Vector2(x: 1.0f, y: 1.0f), Vector2(x: 0.5f, y: 0.5f),
    20.0f, WHITE);
  Draw.End3D();
  AWin.EndFrame();
end;

func Run();
var
  LWin: Window;
  LIcons: array of ImageRes;
  LTex: TextureRes;
  LSmall: TextureRes;
  LPixels: array of Color;
  LTarget: RenderTextureRes;
  LOut: RenderTextureRes;
  LPart: RenderTextureRes;
  LDrawn: ImageRes;
  LWhole: ImageRes;
  LHalf: ImageRes;
  LFont: FontRes;
  LCamera: Camera2D;
  LLetterbox: Rectangle;
  LClip: bool;
begin
  Log.Level(LogLevel.None);
  Assets.Mount(ASSETS_ZIP, "Adam");
  LWin := Window.Config().Size(320, 180).Flags([WindowFlag.Hidden])
    .Icon(ImageRes.Color(16, 16, RED)).Open();
  println("open {}", LWin.Ready());
  setlength(LIcons, 2);
  LIcons[0] := ImageRes.Color(16, 16, BLUE);
  LIcons[1] := ImageRes.Color(32, 32, BLUE);
  LWin.SetIcons(LIcons);
  LWin.SetIcon(LIcons[0]);

  LTex := TextureRes(LOGO);
  LTex.SetFilter(Filter.Trilinear).SetWrap(WrapMode.Clamp).GenMipmaps();
  println("texture {} {} {} {} mipmaps {}", LTex.IsValid(), LTex.Width(), LTex.Height(),
    LTex.Format(), LTex.Mipmaps());

  // An image to a texture and back; a rectangle of its pixels replaced
  LSmall := ImageRes.Color(4, 4, RED).ToTexture();
  print("image {} {} {} {}", LSmall.ToImage().Pixel(0, 0).r, LSmall.ToImage().Pixel(0, 0).g,
    LSmall.ToImage().Pixel(0, 0).b, LSmall.ToImage().Pixel(0, 0).a);
  setlength(LPixels, 4);
  LPixels[0] := BLUE;
  LPixels[1] := BLUE;
  LPixels[2] := BLUE;
  LPixels[3] := BLUE;
  LSmall.Update(Rectangle(x: 0.0f, y: 0.0f, width: 2.0f, height: 2.0f), addr of LPixels[0]);
  println(" updated {} {} {} {}", LSmall.ToImage().Pixel(1, 1).r,
    LSmall.ToImage().Pixel(1, 1).g, LSmall.ToImage().Pixel(1, 1).b,
    LSmall.ToImage().Pixel(1, 1).a);

  LTarget := RenderTextureRes(32, 16);
  println("target {} {} {} views {} {} {}", LTarget.IsValid(), LTarget.Width(),
    LTarget.Height(), LTarget.Texture().IsValid(), LTarget.Texture().Width(),
    LTarget.Depth().Width() = 32);

  // Inside the frame: the render texture takes the drawing in its own pixels, then the
  // frame's camera and clip are back
  LWin.BeginFrame();
  LTarget.Begin();
  LWin.Clear(BLUE);
  Draw.Rect(Rectangle(x: 0.0f, y: 0.0f, width: 16.0f, height: 8.0f), RED);
  RenderTextureRes.End();
  Draw.BeginTexture(LTarget);
  Draw.Pixel(Vector2(x: 31.0f, y: 15.0f), GREEN);
  Draw.EndTexture();
  LCamera := LWin.Camera();
  LLetterbox := LWin.Letterbox();
  LClip := LLetterbox.width > 0.0f;
  LWin.EndFrame();
  println("frame {} clip {}", LCamera.zoom > 0.0f, LClip);

  LFont := FontRes(MONO, 32);
  println("font {} {} {} measure {} default {}", LFont.IsValid(), LFont.BaseSize(),
    LFont.GlyphCount(), LFont.Measure("ab", 32.0f, 0.0f).x > 0.0f,
    FontRes.Default().Measure("Game Over", 20) = MeasureText("Game Over", 20));
  println("glyph {} {} atlas {} default {}", LFont.GlyphIndex(65), LFont.Glyph(65).value,
    LFont.Atlas().IsValid(), FontRes.Default().IsValid());
  println("text {} {} {} {} logo {}", ImageRes.FromText(LFont, "Hi", 32.0f, 1.0f, WHITE).IsValid(),
    ImageRes.FromText("Hi", 20, WHITE).IsValid(),
    ImageRes.FromText(64, 32, "T").Width(), ImageRes.FromText(64, 32, "T").Height(),
    ImageRes.FromTexture(LTex).Width());

  // Drawn the right way up: the whole picture, and its top-left part, drawn into another
  // render texture keep the rows as the first holds them (red on top, blue below)
  LOut := RenderTextureRes(32, 16);
  LPart := RenderTextureRes(32, 16);
  LWin.BeginFrame();
  LOut.Begin();
  LWin.Clear(BLANK);
  Draw.Texture(LTarget, Vector2(x: 0.0f, y: 0.0f), WHITE);
  RenderTextureRes.End();
  Draw.BeginTexture(LPart);
  LWin.Clear(BLUE);
  Draw.Texture(LTarget, Rectangle(x: 0.0f, y: 0.0f, width: 16.0f, height: 8.0f),
    Vector2(x: 0.0f, y: 0.0f), WHITE);
  Draw.EndTexture();
  LWin.EndFrame();
  LDrawn := LTarget.Texture().ToImage();
  LWhole := LOut.Texture().ToImage();
  LHalf := LPart.Texture().ToImage();
  println("upright {} {} part {}", ColorIsEqual(LDrawn.Pixel(0, 0), LWhole.Pixel(0, 0)) and
    ColorIsEqual(LDrawn.Pixel(0, 15), LWhole.Pixel(0, 15)),
    not ColorIsEqual(LDrawn.Pixel(0, 0), LDrawn.Pixel(0, 15)),
    ColorIsEqual(LDrawn.Pixel(0, 0), LHalf.Pixel(0, 0)) and
    ColorIsEqual(LDrawn.Pixel(0, 15), LHalf.Pixel(0, 15)));

  DrawAll(LWin, LTex, LTarget, LFont);
  println("drawn {} snapshot {}", LWin.Ready(), LWin.Snapshot().IsValid());

  // Kept past the window: the window's last release (the end of Run) unloads it first
  GKeep := LTex;
  GKeepImage := LTex.ToImage();
  println("kept {}", GKeep.IsValid());
end;

// A window the program closes itself (raylib's own CloseWindow): its textures go with it
func Abandon();
var
  LWin: Window;
  LTex: TextureRes;
begin
  LWin := Window.Config().Size(64, 64).Flags([WindowFlag.Hidden]).Open();
  LTex := ImageRes.Color(4, 4, RED).ToTexture();
  CloseWindow();
  println("abandoned {}", LTex.IsValid());
end;

begin
  Run();
  println("teardown {} image {}", GKeep.IsValid(), GKeepImage.Width() = 512);
  Abandon();
  Assets.Unmount();
  if IsWindowReady() then
    CloseWindow();
  end;
end.
