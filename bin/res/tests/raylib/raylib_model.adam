  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  raylib_model.adam - System.Raylib.Ext's 3D resources (PLAN-RAVENAPI R6),
  over a hidden frame window: ShaderRes from code (locations, attributes,
  every Set form, SetLoc, a failed link, raylib's default), MeshRes made by
  each generator and from an image (counts, bounds, tangents, a ray hit),
  MaterialRes (the default, an .mtl's with its texture, maps changed, a
  texture and a shader set and kept), ModelRes from a glTF with its
  animation clips (posed, blended, fitted), from an OBJ, and from a mesh
  (shared both ways: a model's mesh and material outlive it, a material set
  into it shows), its transform; one frame drawing every model / mesh form
  through Draw.BeginShader and ShaderRes.Begin. Then the order-proof
  teardown: a model kept in a global past the window's close is unloaded by
  the window's last release, and a window the program closes itself
  (raylib's own CloseWindow) gives its meshes up with it.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | open true
  | shader true glow true tint true missing -1 attrib 0 loc true
  | broken false default true
  | cube true 24 12 bounds -0.5 0.5 tangents true
  | shapes true true true true true true true true true true
  | hit true 4.5 miss false
  | material true color 230 41 55 texture true shader true
  | mtl 1 true texture true
  | robot true meshes true materials true bounds true
  | clips true named true frames true fits true
  | alien true 4 texture true
  | shared 24 same true color 0 121 241 transform 2
  | outlives true true
  | drawn true
  | kept true
  | teardown false
  | abandoned false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raylib_model;

import System.SysUtils, System.Raylib.C, System.Raylib.Ext;

const
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";
  ROBOT: string = "res/assets/models/robot.glb";
  ALIEN: string = "res/assets/models/alien/alien.obj";
  ALIEN_MTL: string = "res/assets/models/alien/alien.mtl";
  LOGO: string = "res/assets/images/adam.png";

var
  // Kept past the window's close: the window's last release unloads its meshes first
  GKeep: ModelRes;

// The GLSL 330 stages of the row's shader (raylib's attribute and mvp names)
func VertexCode(): string;
begin
  return "#version 330\n" +
    "in vec3 vertexPosition;\n" +
    "in mat4 instanceTransform;\n" +
    "uniform mat4 mvp;\n" +
    "void main() { gl_Position = mvp * vec4(vertexPosition, 1.0); }\n";
end;

func FragmentCode(): string;
begin
  return "#version 330\n" +
    "uniform vec4 uTint;\n" +
    "uniform float uGlow;\n" +
    "uniform vec3 uArr[2];\n" +
    "uniform int uMode;\n" +
    "uniform mat4 uSpin;\n" +
    "uniform sampler2D uTex;\n" +
    "out vec4 finalColor;\n" +
    "void main() {\n" +
    "  vec4 LBase = uTint * uGlow + vec4(uArr[0] + uArr[1], 0.0) * float(uMode);\n" +
    "  finalColor = uSpin * LBase + texture(uTex, vec2(0.5));\n" +
    "}\n";
end;

// One frame through every model / mesh draw, inside a shader
func DrawAll(var AWin: Window; const AShader: ShaderRes; const AModel: ModelRes;
  const AMesh: MeshRes; const AMaterial: MaterialRes);
var
  LCamera: Camera3D;
  LMany: array of Matrix;
  LAxis: Vector3;
  LScale: Vector3;
begin
  LCamera := Camera3D(position: Vector3(x: 0.0f, y: 2.0f, z: 6.0f),
    target: Vector3(x: 0.0f, y: 0.0f, z: 0.0f), up: Vector3(x: 0.0f, y: 1.0f, z: 0.0f),
    fovy: 45.0f, projection: int32(Projection.Perspective));
  LAxis := Vector3(x: 0.0f, y: 1.0f, z: 0.0f);
  LScale := Vector3(x: 1.0f, y: 1.0f, z: 1.0f);
  setlength(LMany, 2);
  LMany[0] := MatrixTranslate(-1.0f, 0.0f, 0.0f);
  LMany[1] := MatrixTranslate(1.0f, 0.0f, 0.0f);

  AWin.BeginFrame();
  Draw.Begin3D(LCamera);
  AModel.Draw(Vector3(x: 0.0f, y: 0.0f, z: 0.0f), 1.0f, WHITE);
  AModel.Draw(Vector3(x: 1.0f, y: 0.0f, z: 0.0f), LAxis, 45.0f, LScale, WHITE);
  AModel.DrawWires(Vector3(x: 0.0f, y: 0.0f, z: 0.0f), 1.0f, GREEN);
  AModel.DrawWires(Vector3(x: 1.0f, y: 0.0f, z: 0.0f), LAxis, 45.0f, LScale, GREEN);
  AMesh.Draw(AMaterial, MatrixIdentity());
  AMesh.DrawInstanced(AMaterial, LMany);
  Draw.BeginShader(AShader);
  AMesh.Draw(MaterialRes.Default(), MatrixTranslate(0.0f, 1.0f, 0.0f));
  Draw.EndShader();
  AShader.Begin();
  AModel.Draw(Vector3(x: 0.0f, y: -1.0f, z: 0.0f), 0.5f, WHITE);
  ShaderRes.End();
  Draw.End3D();
  AWin.EndFrame();
end;

func Run();
var
  LWin: Window;
  LShader: ShaderRes;
  LGlow: int32;
  LArr: array of float32;
  LCube: MeshRes;
  LBox: BoundingBox;
  LRay: Ray;
  LHit: RayCollision;
  LMat: MaterialRes;
  LTex: TextureRes;
  LMtl: array of MaterialRes;
  LRobot: ModelRes;
  LClips: array of ModelAnimationRes;
  LAlien: ModelRes;
  LShared: ModelRes;
  LBlue: MaterialRes;
  LKeptMesh: MeshRes;
  LKeptMat: MaterialRes;
begin
  Log.Level(LogLevel.None);
  Assets.Mount(ASSETS_ZIP, "Adam");
  LWin := Window.Config().Size(320, 180).Flags([WindowFlag.Hidden]).Open();
  println("open {}", LWin.Ready());

  LShader := ShaderRes.FromCode(VertexCode(), FragmentCode());
  LGlow := LShader.Location("uGlow");
  setlength(LArr, 6);
  LArr[0] := 0.1f;
  LArr[1] := 0.2f;
  LArr[2] := 0.3f;
  LArr[3] := 0.4f;
  LArr[4] := 0.5f;
  LArr[5] := 0.6f;
  LShader.Set(LGlow, 0.5f).Set(LShader.Location("uTint"), RED)
    .Set(LShader.Location("uArr"), LArr, UniformType.Vec3).Set(LShader.Location("uMode"), 1)
    .Set(LShader.Location("uSpin"), MatrixIdentity())
    .Set(LShader.Location("uTint"), Vector4(x: 1.0f, y: 1.0f, z: 1.0f, w: 1.0f))
    .SetLoc(ShaderLoc.ColorDiffuse, LShader.Location("uTint"));
  println("shader {} glow {} tint {} missing {} attrib {} loc {}", LShader.IsValid(),
    LGlow >= 0, LShader.Location("uTint") >= 0, LShader.Location("nope"),
    LShader.Attrib("vertexPosition"),
    LShader.Handle().locs[int64(ShaderLoc.ColorDiffuse)] = LShader.Location("uTint"));
  println("broken {} default {}", ShaderRes.FromCode("", "not glsl").IsValid(),
    ShaderRes("", "").IsValid());

  LCube := MeshRes.Cube(1.0f, 1.0f, 1.0f);
  LBox := LCube.Bounds();
  LCube.GenTangents();
  println("cube {} {} {} bounds {} {} tangents {}", LCube.IsValid(), LCube.VertexCount(),
    LCube.TriangleCount(), LBox.min.x, LBox.max.y, LCube.Handle().tangents <> nil);
  println("shapes {} {} {} {} {} {} {} {} {} {}", MeshRes.Poly(6, 1.0f).IsValid(),
    MeshRes.Plane(2.0f, 2.0f, 2, 2).IsValid(), MeshRes.Sphere(1.0f, 8, 8).IsValid(),
    MeshRes.HemiSphere(1.0f, 8, 8).IsValid(), MeshRes.Cylinder(1.0f, 2.0f, 8).IsValid(),
    MeshRes.Cone(1.0f, 2.0f, 8).IsValid(), MeshRes.Torus(1.0f, 0.3f, 8, 8).IsValid(),
    MeshRes.Knot(1.0f, 0.3f, 8, 8).IsValid(),
    MeshRes.Heightmap(ImageRes.Color(8, 8, GRAY), Vector3(x: 4.0f, y: 1.0f, z: 4.0f)).IsValid(),
    MeshRes.Cubicmap(ImageRes.Color(4, 4, WHITE), Vector3(x: 1.0f, y: 1.0f, z: 1.0f)).IsValid());

  LRay := Ray(position: Vector3(x: 0.0f, y: 0.0f, z: 5.0f),
    direction: Vector3(x: 0.0f, y: 0.0f, z: -1.0f));
  LHit := LRay.HitMesh(LCube, MatrixIdentity());
  println("hit {} {} miss {}", LHit.hit, LHit.distance,
    LRay.HitMesh(LCube, MatrixTranslate(5.0f, 0.0f, 0.0f)).hit);

  LTex := TextureRes(LOGO);
  LMat := MaterialRes.Default().SetColor(MapIndex.Albedo, RED).SetValue(MapIndex.Metalness, 0.5f)
    .SetTexture(MapIndex.Albedo, LTex).SetShader(LShader);
  println("material {} color {} {} {} texture {} shader {}", LMat.IsValid(),
    LMat.Handle().maps[0].color.r, LMat.Handle().maps[0].color.g,
    LMat.Handle().maps[0].color.b, LMat.Handle().maps[0].texture.id = LTex.Handle().id,
    LMat.Handle().shader.id = LShader.Handle().id);
  LMtl := MaterialRes.Load(ALIEN_MTL);
  println("mtl {} {} texture {}", len(LMtl), LMtl[0].IsValid(),
    LMtl[0].Handle().maps[0].texture.id <> rlGetTextureIdDefault());

  LRobot := ModelRes(ROBOT);
  LBox := LRobot.Bounds();
  println("robot {} meshes {} materials {} bounds {}", LRobot.IsValid(), LRobot.MeshCount() > 0,
    LRobot.MaterialCount() > 0, LBox.max.y > LBox.min.y);
  LClips := ModelAnimationRes.Load(ROBOT);
  LRobot.Animate(LClips[0], 1.0f);
  LRobot.Animate(LClips[0], 1.0f, LClips[len(LClips) - 1], 2.0f, 0.5f);
  println("clips {} named {} frames {} fits {}", len(LClips) > 1, len(LClips[0].Name()) > 0,
    LClips[0].FrameCount() > 0, LRobot.Fits(LClips[0]) and (LClips[0].BoneCount() > 0));

  LAlien := ModelRes(ALIEN);
  println("alien {} {} texture {}", LAlien.IsValid(), LAlien.MeshCount(),
    LAlien.Material(LAlien.MaterialCount() - 1).Handle().maps[0].texture.id <>
    rlGetTextureIdDefault());

  LShared := ModelRes.FromMesh(LCube);
  LBlue := MaterialRes.Default();
  LShared.SetMaterial(0, LBlue).SetMeshMaterial(0, 0);
  LShared.Material(0).SetColor(MapIndex.Albedo, BLUE);
  LShared.Transform := MatrixScale(2.0f, 2.0f, 2.0f);
  println("shared {} same {} color {} {} {} transform {}", LShared.Mesh(0).VertexCount(),
    LShared.Mesh(0).Handle().vaoId = LCube.Handle().vaoId, LBlue.Handle().maps[0].color.r,
    LBlue.Handle().maps[0].color.g, LBlue.Handle().maps[0].color.b,
    LShared.Transform.m0);

  DrawAll(LWin, LShader, LShared, LCube, LMat);

  // A model's mesh and material outlive it
  LKeptMesh := LAlien.Mesh(0);
  LKeptMat := LAlien.Material(0);
  LAlien := ModelRes();
  println("outlives {} {}", LKeptMesh.IsValid(), LKeptMat.IsValid());

  DrawAll(LWin, LShader, LRobot, LCube, LMtl[0]);
  println("drawn {}", LWin.Ready());

  // Kept past the window: the window's last release (the end of Run) unloads it first
  GKeep := LRobot;
  println("kept {}", GKeep.IsValid());
end;

// A window the program closes itself (raylib's own CloseWindow): its meshes go with it
func Abandon();
var
  LWin: Window;
  LMesh: MeshRes;
begin
  LWin := Window.Config().Size(64, 64).Flags([WindowFlag.Hidden]).Open();
  LMesh := MeshRes.Cube(1.0f, 1.0f, 1.0f);
  CloseWindow();
  println("abandoned {}", LMesh.IsValid());
end;

begin
  Run();
  println("teardown {}", GKeep.IsValid());
  Abandon();
  Assets.Unmount();
  if IsWindowReady() then
    CloseWindow();
  end;
end.
