-------------------------------------------------------------------------------
  raylib_window.adam - System.Raylib.Ext's object layer, the window part
  (PLAN-RAVENAPI R2): a hidden frame window opened by WindowConfig's fluent
  chain, its state, flags, frame settings (properties) and one frame drawn;
  a copy shares the window and its done leaves it open, a second Window
  while it is open is the same window, the last value's done closes it
  (AV.9). Log.Handler takes raylib's trace log formatted (a closure: our
  own Write and a printf line over raylib's va_list), Random's seed and
  sequences, Time and Monitor, and the frame's rules as static methods.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | open true 320 180 true
  | flags true true false
  | color 230 241 228 true
  | frame true
  | shared true true
  | second true 320
  | log 4 50% hidden
  | fmt 4 n=7 s=ab f=1.50
  | quiet true
  | closed true true
  | random 5 15 0 3
  | time true monitor true
  | rules 100.000 0.000 800.000 450.000 / 50.000 25.000 1600.000 900.000
  | rules 1200.000 675.000 / 50.000 25.000
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raylib_window;

import System.SysUtils, System.Raylib.C, System.Raylib.Ext;

var
  // The last line Log.Handler was given, its level, and how many it was given
  GLast: string;
  GLevel: LogLevel;
  GCount: int64;

// A copy of AWin, gone at the return: the window stays open (the caller's value holds it)
func Share(const AWin: Window): bool;
var
  LCopy: Window;
begin
  LCopy := AWin;
  return LCopy.Ready();
end;

// The window's life: every check while it is open; its value's done closes it at the end
func Run();
var
  LWin: Window;
  LOther: Window;
  LSeen: int64;
  LFirst: uint8;
begin
  // Every raylib line goes to the handler from here (none to stdout)
  Log.Handler(func(const ALevel: LogLevel; const AText: string)
  begin
    GLevel := ALevel;
    GLast := AText;
    GCount += 1;
  end);
  LWin := Window.Config().Size(320, 180).Title("raylib_window").Flags([WindowFlag.Hidden])
    .Color(RED).BarColor(BLUE).TargetFps(30).ExitKey(Key.Null).Open();
  println("open {} {} {} {}", LWin.Ready(), LWin.Width(), LWin.Height(), GCount > 0);
  println("flags {} {} {}", LWin.Hidden(), LWin.HasFlags([WindowFlag.Hidden, WindowFlag.Resizable]),
    LWin.HasFlags([WindowFlag.Topmost]));
  // RED's red, then the property written: GREEN's green
  LFirst := LWin.Color.r;
  LWin.Color := GREEN;
  LWin.IntegerScale := true;
  println("color {} {} {} {}", LFirst, LWin.BarColor.b, LWin.Color.g, LWin.IntegerScale);
  LWin.BeginFrame();
  DrawRectangle(10, 10, 100, 50, WHITE);
  LWin.EndFrame();
  println("frame {}", LWin.Running());
  println("shared {} {}", Share(LWin), LWin.Ready());
  LOther := Window(100, 100, "second");
  println("second {} {}", LOther.Ready(), LOther.Width());
  // Our own text (no format applied), then a printf line raylib formats
  Log.Write(LogLevel.Warning, "50% hidden");
  println("log {} {}", int32(GLevel), GLast);
  TraceLog(LOG_WARNING, "n=%d s=%s f=%.2f", 7, "ab", 1.5);
  println("fmt {} {}", int32(GLevel), GLast);
  // The handler taken off: raylib's own output again, nothing more seen here
  Log.Handler(nil);
  Log.Level(LogLevel.None);
  LSeen := GCount;
  Log.Write(LogLevel.Error, "unseen");
  println("quiet {}", GCount = LSeen);
end;

var
  LSequence: array of int32;
  LSum: int64;
  LI: int64;
  LBox: Rectangle;
  LPoint: Vector2;
  LSize: Vector2;
  // After Run: no frame window open, so this value holds none
  LAfter: Window;

begin
  Run();
  LAfter := Window();
  println("closed {} {}", not IsWindowReady(), LAfter.Width() = 0);
  // AV.9: nothing is left open whatever the checks above did
  if IsWindowReady() then
    CloseWindow();
  end;

  Random.Seed(7);
  LSequence := Random.Sequence(5, 1, 5);
  LSum := 0;
  for LI := 0 to len(LSequence) - 1 do
    LSum += int64(LSequence[LI]);
  end;
  println("random {} {} {} {}", len(LSequence), LSum, len(Random.Sequence(10, 1, 5)),
    Random.Value(3, 3));
  println("time {} monitor {}", Time.Now() >= 0.0, Monitor.Count() >= 0);

  LBox := Window.LetterboxRect(1000, 450, 800, 450);
  print("rules {:.3f} {:.3f} {:.3f} {:.3f}", LBox.x, LBox.y, LBox.width, LBox.height);
  LBox := Window.IntegerLetterboxRect(1700, 950, 800, 450);
  println(" / {:.3f} {:.3f} {:.3f} {:.3f}", LBox.x, LBox.y, LBox.width, LBox.height);
  LSize := Window.ScaledFrameSize(800, 450, 144);
  LPoint := Window.FramePoint(Vector2(x: 150.0f, y: 25.0f),
    Rectangle(x: 100.0f, y: 0.0f, width: 800.0f, height: 450.0f), 800, 450);
  println("rules {:.3f} {:.3f} / {:.3f} {:.3f}", LSize.x, LSize.y, LPoint.x, LPoint.y);
end.
