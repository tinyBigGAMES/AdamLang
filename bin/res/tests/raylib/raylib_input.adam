-------------------------------------------------------------------------------
  raylib_input.adam - System.Raylib.Ext's object layer, the input part
  (PLAN-RAVENAPI R3) over a hidden frame window that takes no input: the
  keyboard's states and queues (nothing held, nothing queued; a key that
  types no character has no name), the mouse's buttons and wheel, its
  offset and scale read back through Position (the cursor itself never
  moved), the cursor hidden and shown; gamepads by index (one out of range
  is never available and reads as nothing held); touch points and the
  gesture set raylib looks for. Every value is the same with or without a
  real pad, keyboard or mouse on the machine.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | keys false false false true 0 0 []
  | mouse false false true 0.000
  | offset 10.000 20.000 scale true
  | cursor true false
  | pad false false true 0 0.000 [] -1
  | pad ok true
  | touch 0 false 0 0.000
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raylib_input;

import System.SysUtils, System.Raylib.C, System.Raylib.Ext;

// The checks while the window is open; its value's done closes it at the end
func Run();
var
  LWin: Window;
  LBefore: Vector2;
  LAfter: Vector2;
  LScaled: Vector2;
  // An index out of raylib's range, and pad 0 (a Gamepad always names its index)
  LOut: Gamepad(7);
  LFirst: Gamepad(0);
begin
  Log.Level(LogLevel.None);
  LWin := Window.Config().Size(320, 180).Flags([WindowFlag.Hidden]).Open();
  LWin.BeginFrame();
  LWin.EndFrame();

  println("keys {} {} {} {} {} {} [{}]", Keyboard.Pressed(Key.A), Keyboard.Down(Key.Space),
    Keyboard.Released(Key.Enter), Keyboard.Up(Key.Escape), int32(Keyboard.Next()),
    Keyboard.NextChar(), Keyboard.Name(Key.Escape));

  println("mouse {} {} {} {:.3f}", Mouse.Pressed(Button.Left), Mouse.Down(Button.Right),
    Mouse.Up(Button.Middle), Mouse.Wheel());

  // Position adds the offset to the cursor's place, then scales it (the cursor stays put)
  LBefore := Mouse.Position();
  Mouse.SetOffset(10, 20);
  LAfter := Mouse.Position();
  Mouse.SetOffset(0, 0);
  Mouse.SetScale(2.0f, 2.0f);
  LScaled := Mouse.Position();
  Mouse.SetScale(1.0f, 1.0f);
  println("offset {:.3f} {:.3f} scale {}", LAfter.x - LBefore.x, LAfter.y - LBefore.y,
    (LScaled.x = LBefore.x * 2.0f) and (LScaled.y = LBefore.y * 2.0f));

  Mouse.SetCursor(Cursor.Crosshair);
  Mouse.Hide();
  print("cursor {}", Mouse.Hidden());
  Mouse.Show();
  Mouse.SetCursor(Cursor.Default);
  println(" {}", Mouse.Hidden());

  // An index out of raylib's range: never available, nothing held, no axes
  LOut.Vibrate(1.0f, 1.0f, 0.1f);
  println("pad {} {} {} {} {:.3f} [{}] {}", LOut.Available(), LOut.Down(PadButton.LeftFaceUp),
    LOut.Up(PadButton.RightTrigger1), LOut.AxisCount(), LOut.Axis(PadAxis.LeftX), LOut.Name(),
    Gamepad(-1).Index());
  // Pad 0 may or may not be connected on this machine: either way it answers sensibly
  println("pad ok {}", LFirst.Available() or ((LFirst.Name() = "") and (LFirst.AxisCount() >= 0)));

  Touch.Enable([TouchGesture.Tap, TouchGesture.Drag]);
  println("touch {} {} {} {:.3f}", Touch.Count(), Touch.Detected(TouchGesture.Tap),
    uint32(Touch.Last()), Touch.HoldDuration());
end;

begin
  Run();
  // AV.9: nothing is left open whatever the checks above did
  if IsWindowReady() then
    CloseWindow();
  end;
end.
