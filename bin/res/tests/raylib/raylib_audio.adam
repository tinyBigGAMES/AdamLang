-------------------------------------------------------------------------------
  raylib_audio.adam - System.Raylib.Ext's audio and video resources
  (PLAN-RAVENAPI R7) from the mounted assets.zip: WaveRes (its facts, a
  copy of its own, crop, format, samples, from memory, a missing file),
  then AudioDevice (ready, the master volume a perceived level), SoundRes
  (played, stopped, its fluent settings, from a wave, aliases that keep
  its data when it goes),
  MusicRes from a path, an IO and memory (length, looping, played, seek),
  AudioStreamRes with a closure callback and a processor run on raylib's
  audio thread, a mixed processor on the device, and VideoRes (its facts,
  the status handler closure, pause, stop, looping, the volume clamped, a
  fixed step, a missing entry) drawn in a hidden window through every
  Draw.Video form. Then the order-proof teardown: a sound kept in a global
  past the device's close is unloaded by the device's last release, and a
  video kept past the window's close by the window's.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | wave true frames true copy true crop 1000 own true
  | format 22050 16 1 samples true
  | memory true empty false missing false 0
  | device true volume true gain true
  | sound true playing true stopped true chain true
  | fromwave true towave true
  | alias true kept true twice true
  | music true length true looping true playing true played true
  | music io true memory true empty false
  | stream true callback true processor true detached true
  | mixed true attached true called true
  | video true size true rate true audio true stopped true
  | status playing 1 paused 2 stopped 3 none 3
  | looping true volume true true step true
  | video io true missing false 0
  | drawn true
  | kept true true
  | teardown false false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raylib_audio;

import System.SysUtils, System.IO, System.Math, System.CustomIO, System.Raylib.C, System.Raylib.Ext;

const
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";
  COIN: string = "res/assets/audio/sfx/coin_pickup.ogg";
  SONG: string = "res/assets/audio/music/song01.ogg";
  INTRO: string = "res/assets/videos/intro.mpg";

var
  // Kept past the device's close: its last release unloads it first
  GKeepSound: SoundRes;
  // Kept past the window's close: its last release unloads it first
  GKeepVideo: VideoRes;

// The bytes of the assets.zip entry AEntry (none when it cannot be read)
func ZipBytes(const AEntry: string): array of uint8;
var
  LIO: IO;
  LAll: string;
  LBytes: array of uint8;
  LI: int64;
begin
  LIO := CreateZipFileIO(ASSETS_ZIP, AEntry, "Adam");
  if LIO = nil then
    return LBytes;
  end;
  if IOReadAll(LIO, LAll) then
    setlength(LBytes, len(LAll));
    for LI := 0 to len(LAll) - 1 do
      LBytes[LI] := uint8(LAll[LI]);
    end;
  end;
  IOClose(LIO);
  return LBytes;
end;

// AName when AOk, else FAIL (the row's line shows which)
func BoolName(const AOk: bool; const AName: string): string;
begin
  if AOk then
    return AName;
  end;
  return "FAIL";
end;

// Waits (up to two seconds) for ACount^ to pass 0: the audio thread's calls
func WaitCalls(const ACount: ptr to int64): bool;
var
  LI: int32;
begin
  for LI := 1 to 200 do
    if ACount^ > 0 then
      return true;
    end;
    Delay(10);
  end;
  return ACount^ > 0;
end;

func Waves();
var
  LWave: WaveRes;
  LCopy: WaveRes;
  LBad: WaveRes;
  LMem: WaveRes;
  LEmpty: array of uint8;
begin
  LWave := WaveRes(COIN);
  LCopy := LWave.Copy();
  LWave.Crop(0, 1000);
  println("wave {} frames {} copy {} crop {} own {}", LWave.IsValid(), LCopy.Frames() > 1000,
    LCopy.IsValid(), LWave.Frames(), LCopy.Frames() > 1000);
  LCopy.ToFormat(22050, 16, 1);
  println("format {} {} {} samples {}", LCopy.SampleRate(), LCopy.SampleSize(),
    LCopy.Channels(), int64(len(LCopy.Samples())) = int64(LCopy.Frames()));
  LMem := WaveRes.FromMemory(".ogg", ZipBytes(COIN));
  LBad := WaveRes("res/assets/audio/sfx/none.ogg");
  println("memory {} empty {} missing {} {}", LMem.IsValid(),
    WaveRes.FromMemory(".ogg", LEmpty).IsValid(), LBad.IsValid(), LBad.Frames());
end;

func Sounds();
var
  LSound: SoundRes;
  LAlias: SoundRes;
  LTwice: SoundRes;
  LWave: WaveRes;
begin
  LSound := SoundRes(COIN);
  LSound.Play();
  println("sound {} playing {} stopped {} chain {}", LSound.IsValid(), LSound.Playing(),
    not LSound.Stop().Playing(), LSound.Volume(0.5f).Pitch(1.5f).Pan(0.25f).IsValid());
  LWave := WaveRes(COIN);
  println("fromwave {} towave {}", SoundRes.FromWave(LWave).IsValid(),
    LWave.ToSound().IsValid());
  LAlias := LSound.Alias();
  LTwice := LAlias.Alias();
  // The alias keeps the data when the sound's own handle goes
  LSound := SoundRes();
  LAlias.Play();
  println("alias {} kept {} twice {}", LAlias.IsValid(), LAlias.Playing(), LTwice.IsValid());
  LAlias.Stop();
  GKeepSound := LTwice;
end;

func Musics();
var
  LMusic: MusicRes;
  LIO: IO;
  LFromIO: MusicRes;
  LEmpty: array of uint8;
begin
  LMusic := MusicRes(SONG).Looping(true).Play();
  LMusic.Update();
  Delay(50);
  LMusic.Update();
  println("music {} length {} looping {} playing {} played {}", LMusic.IsValid(),
    LMusic.Length() > 1.0f, LMusic.Looping(), LMusic.Playing(),
    LMusic.Seek(1.0f).Played() >= 0.0f);
  LMusic.Stop();
  LIO := CreateZipFileIO(ASSETS_ZIP, SONG, "Adam");
  LFromIO := MusicRes.FromIO(LIO, ".ogg");
  println("music io {} memory {} empty {}", LFromIO.IsValid(),
    MusicRes.FromMemory(".ogg", ZipBytes(SONG)).IsValid(),
    MusicRes.FromMemory(".ogg", LEmpty).IsValid());
  // The IO stays the caller's: closed once the music that reads it is gone
  LFromIO := MusicRes();
  IOClose(LIO);
end;

func Streams();
var
  LStream: AudioStreamRes;
  LFills: int64;
  LRuns: int64;
  LMixes: int64;
  LGain: AudioProcessor;
  LMix: AudioProcessor;
begin
  LStream := AudioStreamRes(44100, 32, 1).Callback(func(ABuffer: ptr; AFrames: uint32)
    var
      LOut: ptr to float32;
      LI: int64;
    begin
      // Silence: float32 samples, one channel
      LOut := ptr to float32(ABuffer);
      for LI := 0 to int64(AFrames) - 1 do
        LOut[LI] := 0.0f;
      end;
      LFills := LFills + 1;
    end);
  LGain := AudioProcessor(func(ABuffer: ptr; AFrames: uint32)
    begin
      LRuns := LRuns + 1;
    end);
  LStream.Attach(LGain).Play();
  println("stream {} callback {} processor {} detached {}", LStream.IsValid(),
    WaitCalls(addr of LFills), WaitCalls(addr of LRuns), LStream.Detach(LGain).IsValid());
  LMix := AudioProcessor(func(ABuffer: ptr; AFrames: uint32)
    begin
      LMixes := LMixes + 1;
    end);
  println("mixed {} attached {} called {}", LMix.IsValid(), AudioDevice.AttachMixed(LMix),
    WaitCalls(addr of LMixes));
  AudioDevice.DetachMixed(LMix);
  LStream.Stop();
end;

func Videos(var AWin: Window);
var
  LVideo: VideoRes;
  LBad: VideoRes;
  LIO: IO;
  LFromIO: VideoRes;
  LLast: VideoStatus;
  LCalls: int32;
  LPlayed: int32;
  LPaused: int32;
  LStopped: int32;
  LOk: bool;
begin
  LVideo := VideoRes(INTRO);
  println("video {} size {} rate {} audio {} stopped {}", LVideo.IsValid(),
    (LVideo.Width() > 0) and (LVideo.Height() > 0), LVideo.FrameRate() > 0.0,
    LVideo.HasAudio() = (LVideo.SampleRate() > 0), LVideo.Status() = VideoStatus.VideoStopped);
  LVideo.OnStatus(func(const AStatus: VideoStatus)
    begin
      LLast := AStatus;
      LCalls := LCalls + 1;
    end);
  LVideo.Play();
  LPlayed := LCalls;
  LOk := LLast = VideoStatus.VideoPlaying;
  LVideo.Pause();
  LPaused := LCalls;
  LOk := LOk and (LLast = VideoStatus.VideoPaused);
  LVideo.Stop();
  LStopped := LCalls;
  LOk := LOk and (LLast = VideoStatus.VideoStopped);
  // No handler: the next change calls nothing
  LVideo.OnStatus(nil).Play();
  println("status {} {} {} {} {} {} none {}", BoolName(LOk, "playing"), LPlayed,
    "paused", LPaused, "stopped", LStopped, LCalls);
  LVideo.Update(0.1);
  println("looping {} volume {} {} step {}", LVideo.Looping(true).Looping(),
    LVideo.Volume(2.0f).Volume() = 1.0f, LVideo.Volume(-1.0f).Volume() = 0.0f,
    LVideo.Time() > 0.0);
  LIO := CreateZipFileIO(ASSETS_ZIP, INTRO, "Adam");
  LFromIO := VideoRes.FromIO(LIO, "intro.mpg");
  LBad := VideoRes("res/assets/videos/none.mpg");
  println("video io {} missing {} {}", LFromIO.IsValid(), LBad.IsValid(), LBad.Width());
  LFromIO := VideoRes();
  IOClose(LIO);

  // Drawn in a hidden window: every Draw.Video form
  AWin := Window.Config().Size(320, 180).Flags([WindowFlag.Hidden]).Open();
  LVideo.Volume(0.0f);
  LVideo.Update(0.1);
  AWin.BeginFrame();
  Draw.Video(LVideo, Vector2(x: 0.0f, y: 0.0f), WHITE);
  Draw.Video(LVideo, Vector2(x: 10.0f, y: 10.0f), 15.0f, 0.5f, WHITE);
  Draw.Video(LVideo, Rectangle(x: 0.0f, y: 0.0f, width: 32.0f, height: 32.0f),
    Vector2(x: 20.0f, y: 20.0f), WHITE);
  Draw.Video(LVideo, Rectangle(x: 0.0f, y: 0.0f, width: float32(LVideo.Width()),
    height: float32(LVideo.Height())), Rectangle(x: 0.0f, y: 0.0f, width: 160.0f,
    height: 90.0f), Vector2(x: 0.0f, y: 0.0f), 0.0f, WHITE);
  AWin.EndFrame();
  println("drawn {}", AWin.Ready() and LVideo.IsValid());
  GKeepVideo := LVideo;
end;

func Run();
var
  LAudio: AudioDevice;
  // The window outlives Videos: its last release (Run's end) unloads the kept video
  LWin: Window;
begin
  Waves();
  LAudio.Volume := 0.5f;
  // A level: it reads back as set, raylib's linear gain well under it (PerceivedVolume)
  println("device {} volume {} gain {}", LAudio.Ready(),
    SameValue(float64(LAudio.Volume), 0.5, 0.001), GetMasterVolume() < 0.25f);
  // Silent from here: everything plays (callbacks, processors, positions) at volume 0
  LAudio.Volume := 0.0f;
  Sounds();
  Musics();
  Streams();
  Videos(LWin);
  println("kept {} {}", GKeepSound.IsValid(), GKeepVideo.IsValid());
end;

begin
  Log.Level(LogLevel.None);
  Assets.Mount(ASSETS_ZIP, "Adam");
  Run();
  println("teardown {} {}", GKeepSound.IsValid(), GKeepVideo.IsValid());
  Assets.Unmount();
  if IsWindowReady() then
    CloseWindow();
  end;
  if IsAudioDeviceReady() then
    CloseAudioDevice();
  end;
end.
