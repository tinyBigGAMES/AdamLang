-------------------------------------------------------------------------------
  raylib_coverage.adam - "ALL of raylib" proven, not claimed (PLAN-RAVENAPI
  sec 9): every public func of System.Raylib.C has a home, read from the
  std sources a release ships. A home is either a System.Raylib.Ext member
  whose `///` doc names the routine in a `C:` tag (the names after `C:` to
  the line's end, on into the next `///` line while the tag ends with `/`;
  rlgl's routines are the GL members'), or the std job doing its work
  (STD_HOMES below: raylib's file, text, hash, compression and memory
  routines; one name per job, AD.9). Each std job `<unit>.<func>` must be a
  public func of that unit; a word with no unit is the language's own
  (`:=`, `len`, `getmem` ..). A routine with no home, one with both a tag
  and a std home, one listed twice, a STD_HOMES name raylib lacks and a std
  job its unit lacks each fail the row, named on their own line.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | raylib 782 layer 698 gl 163 std 84
  | uncovered 0 doubled 0 unknown 0 missing 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe raylib_coverage;

import System.SysUtils, System.IO, System.Collections;

type
  // A raylib routine whose job the std (or the language) already does
  StdHome = record
    // The System.Raylib.C name
    Routine: string;
    // Where its job is done, space separated: `<unit>.<func>`, or a word of the language
    Jobs: string;
  end;

const
  // The std folder, as the row's exe in output\bin\<triple>\<mode> sees it
  STD_FOLDER: string = "$P:../../../../res/libs/std/";
  // What opens a `.C` unit's public routine line
  RAYLIB_FUNC: string = "public func clink ";
  // The std homes (PLAN-RAVENAPI-RAYLIB.md sec 7's R9 MAP)
  STD_HOMES: array[0..83] of StdHome = [
    StdHome(Routine: "OpenURL", Jobs: "System.Process.OpenURL"),
    StdHome(Routine: "MemAlloc", Jobs: "getmem"),
    StdHome(Routine: "MemRealloc", Jobs: "resizemem"),
    StdHome(Routine: "MemFree", Jobs: "freemem"),
    StdHome(Routine: "LoadFileData", Jobs: "System.IO.ReadAllBytes"),
    StdHome(Routine: "UnloadFileData", Jobs: "System.IO.ReadAllBytes"),
    StdHome(Routine: "SaveFileData", Jobs: "System.IO.WriteAllBytes"),
    StdHome(Routine: "ExportDataAsCode", Jobs: "@addresdata System.ResData.FindResData"),
    StdHome(Routine: "LoadFileText", Jobs: "System.IO.ReadAllText"),
    StdHome(Routine: "UnloadFileText", Jobs: "System.IO.ReadAllText"),
    StdHome(Routine: "SaveFileText", Jobs: "System.IO.WriteAllText"),
    StdHome(Routine: "FileRename", Jobs: "System.IO.RenameFile"),
    StdHome(Routine: "FileRemove", Jobs: "System.IO.DeleteFile"),
    StdHome(Routine: "FileCopy", Jobs: "System.IO.CopyFile"),
    StdHome(Routine: "FileMove", Jobs: "System.IO.RenameFile"),
    StdHome(Routine: "FileTextReplace", Jobs: "System.IO.ReadAllText System.SysUtils.ReplaceStr System.IO.WriteAllText"),
    StdHome(Routine: "FileTextFindIndex", Jobs: "System.IO.ReadAllText System.SysUtils.IndexOf"),
    StdHome(Routine: "FileExists", Jobs: "System.IO.FileExists"),
    StdHome(Routine: "DirectoryExists", Jobs: "System.IO.DirectoryExists"),
    StdHome(Routine: "IsFileExtension", Jobs: "System.SysUtils.MatchesGlob System.SysUtils.ExtractFileExt"),
    StdHome(Routine: "IsFileHidden", Jobs: "System.IO.IsFileHidden"),
    StdHome(Routine: "GetFileLength", Jobs: "System.IO.FileSize"),
    StdHome(Routine: "GetFileModTime", Jobs: "System.IO.FileWriteTime"),
    StdHome(Routine: "GetFileExtension", Jobs: "System.SysUtils.ExtractFileExt"),
    StdHome(Routine: "GetFileName", Jobs: "System.SysUtils.ExtractFileName"),
    StdHome(Routine: "GetFileNameWithoutExt", Jobs: "System.SysUtils.ChangeFileExt System.SysUtils.ExtractFileName"),
    StdHome(Routine: "GetDirectoryPath", Jobs: "System.SysUtils.ExtractFileDir"),
    StdHome(Routine: "GetPrevDirectoryPath", Jobs: "System.SysUtils.ExtractFileDir"),
    StdHome(Routine: "GetWorkingDirectory", Jobs: "System.IO.CurrentDir"),
    StdHome(Routine: "GetApplicationDirectory", Jobs: "System.IO.ExeDir"),
    StdHome(Routine: "MakeDirectory", Jobs: "System.IO.ForceDirectories"),
    StdHome(Routine: "ChangeDirectory", Jobs: "System.IO.SetCurrentDir"),
    StdHome(Routine: "IsPathFile", Jobs: "System.IO.FileExists"),
    StdHome(Routine: "IsPathDirectory", Jobs: "System.IO.DirectoryExists"),
    StdHome(Routine: "IsPathAbsolute", Jobs: "System.IO.IsPathAbsolute"),
    StdHome(Routine: "IsFileNameValid", Jobs: "System.SysUtils.IsFileNameValid"),
    StdHome(Routine: "LoadDirectoryFiles", Jobs: "System.IO.GetFiles"),
    StdHome(Routine: "LoadDirectoryFilesEx", Jobs: "System.IO.GetFiles"),
    StdHome(Routine: "UnloadDirectoryFiles", Jobs: "System.IO.GetFiles"),
    StdHome(Routine: "GetDirectoryFileCount", Jobs: "System.IO.GetFiles len"),
    StdHome(Routine: "GetDirectoryFileCountEx", Jobs: "System.IO.GetFiles len"),
    StdHome(Routine: "CompressData", Jobs: "System.Zlib.Ext.ZlibDeflate"),
    StdHome(Routine: "DecompressData", Jobs: "System.Zlib.Ext.ZlibInflate"),
    StdHome(Routine: "EncodeDataBase64", Jobs: "System.Base64.Base64Encode"),
    StdHome(Routine: "DecodeDataBase64", Jobs: "System.Base64.Base64Decode"),
    StdHome(Routine: "ComputeCRC32", Jobs: "System.Zlib.Ext.ZlibCRC32"),
    StdHome(Routine: "ComputeMD5", Jobs: "System.Hash.ComputeHash System.Hash.DigestToHex"),
    StdHome(Routine: "ComputeSHA1", Jobs: "System.Hash.ComputeHash System.Hash.DigestToHex"),
    StdHome(Routine: "ComputeSHA256", Jobs: "System.Hash.ComputeHash System.Hash.DigestToHex"),
    StdHome(Routine: "LoadUTF8", Jobs: "System.SysUtils.StringFromCodepoints"),
    StdHome(Routine: "UnloadUTF8", Jobs: "System.SysUtils.StringFromCodepoints"),
    StdHome(Routine: "LoadCodepoints", Jobs: "System.SysUtils.StringToCodepoints"),
    StdHome(Routine: "UnloadCodepoints", Jobs: "System.SysUtils.StringToCodepoints"),
    StdHome(Routine: "GetCodepointCount", Jobs: "System.SysUtils.UTF8Length"),
    StdHome(Routine: "GetCodepoint", Jobs: "System.SysUtils.DecodeUTF8Char"),
    StdHome(Routine: "GetCodepointNext", Jobs: "System.SysUtils.DecodeUTF8Char"),
    StdHome(Routine: "GetCodepointPrevious", Jobs: "System.SysUtils.DecodeUTF8CharBefore"),
    StdHome(Routine: "CodepointToUTF8", Jobs: "System.SysUtils.EncodeUTF8Char"),
    StdHome(Routine: "LoadTextLines", Jobs: "System.SysUtils.SplitString"),
    StdHome(Routine: "UnloadTextLines", Jobs: "System.SysUtils.SplitString"),
    StdHome(Routine: "TextCopy", Jobs: ":="),
    StdHome(Routine: "TextIsEqual", Jobs: "="),
    StdHome(Routine: "TextLength", Jobs: "len"),
    StdHome(Routine: "TextFormat", Jobs: "FormatStr"),
    StdHome(Routine: "TextSubtext", Jobs: "System.SysUtils.Substring"),
    StdHome(Routine: "TextRemoveSpaces", Jobs: "System.SysUtils.ReplaceStr"),
    StdHome(Routine: "GetTextBetween", Jobs: "System.SysUtils.Between"),
    StdHome(Routine: "TextReplace", Jobs: "System.SysUtils.ReplaceStr"),
    StdHome(Routine: "TextReplaceAlloc", Jobs: "System.SysUtils.ReplaceStr"),
    StdHome(Routine: "TextReplaceBetween", Jobs: "System.SysUtils.ReplaceBetween"),
    StdHome(Routine: "TextReplaceBetweenAlloc", Jobs: "System.SysUtils.ReplaceBetween"),
    StdHome(Routine: "TextInsert", Jobs: "System.SysUtils.Substring +"),
    StdHome(Routine: "TextInsertAlloc", Jobs: "System.SysUtils.Substring +"),
    StdHome(Routine: "TextJoin", Jobs: "System.SysUtils.JoinStrings"),
    StdHome(Routine: "TextSplit", Jobs: "System.SysUtils.SplitString"),
    StdHome(Routine: "TextAppend", Jobs: "+"),
    StdHome(Routine: "TextFindIndex", Jobs: "System.SysUtils.IndexOf"),
    StdHome(Routine: "TextToUpper", Jobs: "System.SysUtils.UpperCase"),
    StdHome(Routine: "TextToLower", Jobs: "System.SysUtils.LowerCase"),
    StdHome(Routine: "TextToPascal", Jobs: "System.SysUtils.PascalCase"),
    StdHome(Routine: "TextToSnake", Jobs: "System.SysUtils.SnakeCase"),
    StdHome(Routine: "TextToCamel", Jobs: "System.SysUtils.CamelCase"),
    StdHome(Routine: "TextToInteger", Jobs: "System.SysUtils.TryStrToInt System.SysUtils.StrToIntDef"),
    StdHome(Routine: "TextToFloat", Jobs: "System.SysUtils.TryStrToFloat")
  ];

var
  // System.Raylib.C's routines in their order, and as a set
  GRaylib: List<string>;
  GRaylibSet: Set<string>;
  // The routines a System.Raylib.Ext `C:` tag names
  GTagged: Set<string>;
  // A std unit's text by its name, read once
  GUnits: Map<string, string>;

// True for a byte an Adam / C name is made of
func IsNameChar(const AChar: char): bool;
begin
  return ((AChar >= 'a') and (AChar <= 'z')) or ((AChar >= 'A') and (AChar <= 'Z')) or
    ((AChar >= '0') and (AChar <= '9')) or (AChar = '_');
end;

// The std unit AUnit's source (STD_FOLDER + AUnit + ".adam"), read at its first use
func UnitText(const AUnit: string; var AText: string): bool;
var
  LText: string;
begin
  if GUnits.TryGet(AUnit, AText) then
    return true;
  end;
  if not ReadAllText(ResolvePath(STD_FOLDER + AUnit + ".adam"), LText) then
    println("cannot read {}.adam", AUnit);
    return false;
  end;
  GUnits[AUnit] := LText;
  AText := LText;
  return true;
end;

// AText's lines, their line ends dropped
func LinesOf(const AText: string): StringArray;
var
  LLines: StringArray;
  LI: int64;
begin
  LLines := SplitString(AText, "\n");
  for LI := 0 to len(LLines) - 1 do
    LLines[LI] := TrimRight(LLines[LI]);
  end;
  return LLines;
end;

// System.Raylib.C's public routines, read into GRaylib / GRaylibSet
func ReadRaylib(): bool;
var
  LText: string;
  LLines: StringArray;
  LI: int64;
  LAt: int64;
  LName: string;
begin
  if not UnitText("System.Raylib.C", LText) then
    return false;
  end;
  LLines := LinesOf(LText);
  for LI := 0 to len(LLines) - 1 do
    if StartsStr(RAYLIB_FUNC, LLines[LI]) then
      // The name runs from after the prefix to the first byte no name has ('(', ';', ':')
      LAt := len(RAYLIB_FUNC);
      while (LAt < len(LLines[LI])) and IsNameChar(LLines[LI][LAt]) do
        LAt += 1;
      end;
      LName := Substring(LLines[LI], len(RAYLIB_FUNC), LAt - len(RAYLIB_FUNC));
      GRaylib.Add(LName);
      GRaylibSet.Add(LName);
    end;
  end;
  return true;
end;

// The raylib routines ATag names (any other word in it, prose, is passed over) into GTagged
func NoteTag(const ATag: string);
var
  LAt: int64;
  LStart: int64;
  LWord: string;
begin
  LAt := 0;
  while LAt < len(ATag) do
    if not IsNameChar(ATag[LAt]) then
      LAt += 1;
    else
      LStart := LAt;
      while (LAt < len(ATag)) and IsNameChar(ATag[LAt]) do
        LAt += 1;
      end;
      LWord := Substring(ATag, LStart, LAt - LStart);
      if GRaylibSet.Has(LWord) then
        GTagged.Add(LWord);
      end;
    end;
  end;
end;

// System.Raylib.Ext's `C:` tags, read into GTagged
func ReadTags(): bool;
var
  LText: string;
  LLines: StringArray;
  LI: int64;
  LLine: string;
  LAt: int64;
  LTag: string;
  LGoesOn: bool;
begin
  if not UnitText("System.Raylib.Ext", LText) then
    return false;
  end;
  LLines := LinesOf(LText);
  LGoesOn := false;
  for LI := 0 to len(LLines) - 1 do
    LLine := Trim(LLines[LI]);
    if not StartsStr("///", LLine) then
      LGoesOn := false;
    else
      LAt := IndexOf("C:", LLine, 0);
      LTag := "";
      if LAt >= 0 then
        LTag := Substring(LLine, LAt + 2, len(LLine));
      else
        if LGoesOn then
          LTag := Substring(LLine, 3, len(LLine));
        end;
      end;
      if LTag <> "" then
        NoteTag(LTag);
      end;
      // A tag ending in '/' names more routines on the next doc line
      LTag := TrimRight(LTag);
      LGoesOn := (LTag <> "") and (LTag[len(LTag) - 1] = '/');
    end;
  end;
  return true;
end;

// True when AText (a std unit's source) declares the public func AFunc
func HasPublicFunc(const AText: string; const AFunc: string): bool;
begin
  return (IndexOf("\npublic func cpplink " + AFunc + "(", AText, 0) >= 0) or
    (IndexOf("\npublic func " + AFunc + "(", AText, 0) >= 0);
end;

// The std jobs AJobs of the raylib routine ARoutine that no unit declares, each on its line
func MissingJobs(const ARoutine: string; const AJobs: string): int32;
var
  LJobs: StringArray;
  LI: int64;
  LDot: int64;
  LAt: int64;
  LText: string;
  LMissing: int32;
begin
  LMissing := 0;
  LJobs := SplitString(AJobs, " ");
  for LI := 0 to len(LJobs) - 1 do
    // `<unit>.<func>`: the unit is all before the last '.'; no '.' is the language's own
    LDot := -1;
    for LAt := 0 to len(LJobs[LI]) - 1 do
      if LJobs[LI][LAt] = '.' then
        LDot := LAt;
      end;
    end;
    if LDot >= 0 then
      if not UnitText(Substring(LJobs[LI], 0, LDot), LText) or
        not HasPublicFunc(LText, Substring(LJobs[LI], LDot + 1, len(LJobs[LI]))) then
        println("missing {} {}", ARoutine, LJobs[LI]);
        LMissing += 1;
      end;
    end;
  end;
  return LMissing;
end;

var
  GHomed: Set<string>;
  GI: int64;
  GLayer: int32;
  GGL: int32;
  GUncovered: int32;
  GDoubled: int32;
  GUnknown: int32;
  GMissing: int32;

begin
  if not ReadRaylib() or not ReadTags() then
    return 1;
  end;
  GUncovered := 0;
  GDoubled := 0;
  GUnknown := 0;
  GMissing := 0;
  // The std homes: a routine raylib has, homed once, its jobs where they are said to be
  for GI := 0 to len(STD_HOMES) - 1 do
    if not GRaylibSet.Has(STD_HOMES[GI].Routine) then
      println("unknown {}", STD_HOMES[GI].Routine);
      GUnknown += 1;
    end;
    if GTagged.Has(STD_HOMES[GI].Routine) or GHomed.Has(STD_HOMES[GI].Routine) then
      println("doubled {}", STD_HOMES[GI].Routine);
      GDoubled += 1;
    end;
    GHomed.Add(STD_HOMES[GI].Routine);
    GMissing += MissingJobs(STD_HOMES[GI].Routine, STD_HOMES[GI].Jobs);
  end;
  // Every raylib routine: a layer member's tag or a std home
  GLayer := 0;
  GGL := 0;
  for GI := 0 to GRaylib.Count - 1 do
    if GTagged.Has(GRaylib[GI]) then
      GLayer += 1;
      if StartsStr("rl", GRaylib[GI]) then
        GGL += 1;
      end;
    else
      if not GHomed.Has(GRaylib[GI]) then
        println("uncovered {}", GRaylib[GI]);
        GUncovered += 1;
      end;
    end;
  end;
  println("raylib {} layer {} gl {} std {}", GRaylib.Count, GLayer, GGL, len(STD_HOMES));
  println("uncovered {} doubled {} unknown {} missing {}", GUncovered, GDoubled, GUnknown,
    GMissing);
end.
