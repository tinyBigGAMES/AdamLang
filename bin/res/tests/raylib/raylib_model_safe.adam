-------------------------------------------------------------------------------
  raylib_model_safe.adam - System.Raylib.Ext's 3D resources built at
  -opt safe: the inliner's body copies of Ext's methods make dynamic
  arrays of Res objects (a model's MeshRes / MaterialRes slots, an .mtl's
  materials, a file's animation clips), whose element routines must be
  lowered after the copies (Lowering's resumable DoEndBodies; before, one
  was left with no body and the optimizer stopped). Over a hidden window.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  levels safe
  | open true
  | alien true 4 true true
  | mtl 1 true
  | robot true clips true
  | shared 24 true
@@end
*/

module exe raylib_model_safe;

import System.SysUtils, System.Raylib.C, System.Raylib.Ext;

const
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";
  ROBOT: string = "res/assets/models/robot.glb";
  ALIEN: string = "res/assets/models/alien/alien.obj";
  ALIEN_MTL: string = "res/assets/models/alien/alien.mtl";

func Run();
var
  LWin: Window;
  LAlien: ModelRes;
  LMtl: array of MaterialRes;
  LRobot: ModelRes;
  LClips: array of ModelAnimationRes;
  LShared: ModelRes;
begin
  Log.Level(LogLevel.None);
  Assets.Mount(ASSETS_ZIP, "Adam");
  LWin := Window.Config().Size(160, 90).Flags([WindowFlag.Hidden]).Open();
  println("open {}", LWin.Ready());
  LAlien := ModelRes(ALIEN);
  println("alien {} {} {} {}", LAlien.IsValid(), LAlien.MeshCount(), LAlien.MaterialCount() > 0,
    LAlien.Mesh(0).IsValid());
  LMtl := MaterialRes.Load(ALIEN_MTL);
  println("mtl {} {}", len(LMtl), LMtl[0].IsValid());
  LRobot := ModelRes(ROBOT);
  LClips := ModelAnimationRes.Load(ROBOT);
  println("robot {} clips {}", LRobot.IsValid(), len(LClips) > 1);
  LShared := ModelRes.FromMesh(MeshRes.Cube(1.0f, 1.0f, 1.0f));
  println("shared {} {}", LShared.Mesh(0).VertexCount(), LShared.IsValid());
end;

begin
  Run();
  Assets.Unmount();
  if IsWindowReady() then
    CloseWindow();
  end;
end.
