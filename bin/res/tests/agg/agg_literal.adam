-------------------------------------------------------------------------------
  agg_literal.adam - Aggregates: record literals (M3.5g). A literal into a
  local's initializer leaves the fields it does not name zero; fields given
  in their declared order (BNF sec 6); a literal reading the record it is
  assigned to sees the old values (built apart, then copied); values that
  are not constant; bitfields sharing one lane, the lane's byte read back
  (5 | 21 shl 3 = 173); a nested literal and an array field copied from a
  local, the copy independent; a literal in a loop zeroes again each time;
  a module variable initialized by a literal at the entry. Values are shown
  through ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 1
  | 0
  | -7
  | 5000000000
  | 10
  | -7
  | 6
  | 3
  | 5
  | 21
  | -2
  | 173
  | 8
  | 9
  | 3
  | 44
  | 0
  | 44
  | 1
  | 2
  | 3
  | 4
  | 9
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_literal;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  TPair = record
    A: int32;
    B: int64;
  end;

  TBits = record
    Lo: uint8 : 3;
    Hi: uint8 : 5;
    N: int16;
  end;

  TBox = record
    P: TPair;
    Tag: int8;
    Arr: array[0..2] of int16;
  end;

var
  GPair: TPair = TPair(A: 4, B: 9);

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

routine Run();
var
  LP: TPair = TPair(A: 1);
  LQ: TPair;
  LBits: TBits;
  LBox: TBox;
  LArr: array[0..2] of int16;
  LBp: ptr to uint8;
  LI: int32;
begin
  // A field the literal does not name is zero
  ShowInt(LP.A);
  ShowInt(LP.B);

  // Fields in any order
  LQ := TPair(A: -7, B: 5000000000);
  ShowInt(LQ.A);
  ShowInt(LQ.B);

  // Reading the record being assigned: the old values
  LQ := TPair(A: int32(LQ.B - 4999999990), B: LQ.A);
  ShowInt(LQ.A);
  ShowInt(LQ.B);

  // Values that are not constant
  LI := 3;
  LP := TPair(A: LI * 2, B: LI);
  ShowInt(LP.A);
  ShowInt(LP.B);

  // Bitfields sharing one lane, beside a plain field
  LBits := TBits(Lo: 5, Hi: 21, N: -2);
  ShowInt(LBits.Lo);
  ShowInt(LBits.Hi);
  ShowInt(LBits.N);
  LBp := ptr to uint8(addr of LBits);
  ShowInt(LBp[0]);

  // A nested literal and an array field copied from a local
  LArr[1] := 44;
  LBox := TBox(P: TPair(A: 8, B: 9), Tag: 3, Arr: LArr);
  ShowInt(LBox.P.A);
  ShowInt(LBox.P.B);
  ShowInt(LBox.Tag);
  ShowInt(LBox.Arr[1]);
  ShowInt(LBox.Arr[0]);
  LArr[1] := 0;
  ShowInt(LBox.Arr[1]);

  // A literal in a loop zeroes again each time (LP.B was 3)
  for LI := 1 to 3 do
    LP := TPair(A: LI);
    ShowInt(LP.A + LP.B);
  end;

  // A module variable initialized by a literal at the entry
  ShowInt(GPair.A);
  ShowInt(GPair.B);
end;

begin
  Run();
end.
