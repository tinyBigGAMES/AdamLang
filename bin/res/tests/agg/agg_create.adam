-------------------------------------------------------------------------------
  agg_create.adam - Aggregates: create / destroy (BNF sec 7, H4u1). A record
  behind a local pointer starts zeroed, is written and destroyed to nil; a
  module variable's the same, destroyed twice (the second, of nil, does
  nothing); an overlay starts zeroed through its widest member; a record
  declared `forward` first, created into a field reached through a deref and
  destroyed there; a record holding a string and a dynamic array has both
  released by destroy (Leaked 0).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | point x 0
  | point y 0
  | point sum 4
  | point is nil
  | module y 40
  | module is nil
  | pair wide 0
  | pair wide 5
  | next value 9
  | next next 0
  | next is nil
  | name len 0
  | name len 4
  | items 14
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_create;

import System.SysUtils;

forward type Node;

type
  Point = record
    X: int32;
    Y: int64;
  end;

  Pair = overlay
    Wide: int64;
    Narrow: int32;
  end;

  Node = record
    Next: ptr to Node;
    Value: int32;
  end;

  Named = record
    Name: string;
    Items: array of int64;
    Count: int32;
  end;

var
  GPoint: ptr to Point;

// ALabel and AValue on one line
routine Show(const ALabel: string; const AValue: int64);
begin
  println("{}", ALabel + " " + IntToStr(AValue));
end;

routine Run();
var
  LP: ptr to Point;
  LO: ptr to Pair;
  LN: ptr to Node;
  LM: ptr to Named;
  LA: string;
  LB: string;
begin
  // A record: zeroed, written, destroyed to nil
  create(LP);
  Show("point x", LP^.X);
  Show("point y", LP^.Y);
  LP^.X := 7;
  LP^.Y := -3;
  Show("point sum", LP^.X + LP^.Y);
  destroy(LP);
  if LP = nil then
    println("{}", "point is nil");
  end;

  // A module variable; destroy of nil does nothing
  create(GPoint);
  GPoint^.Y := 40;
  Show("module y", GPoint^.Y);
  destroy(GPoint);
  destroy(GPoint);
  if GPoint = nil then
    println("{}", "module is nil");
  end;

  // An overlay: zeroed through its widest member
  create(LO);
  Show("pair wide", LO^.Wide);
  LO^.Narrow := 5;
  Show("pair wide", LO^.Wide);
  destroy(LO);

  // A record declared forward first, created into a field through a deref
  create(LN);
  create(LN^.Next);
  LN^.Next^.Value := 9;
  Show("next value", LN^.Next^.Value);
  Show("next next", int64(uint64(LN^.Next^.Next)));
  destroy(LN^.Next);
  if LN^.Next = nil then
    println("{}", "next is nil");
  end;
  destroy(LN);

  // A string and a dynamic array field released by destroy
  create(LM);
  Show("name len", len(LM^.Name));
  LA := "ab";
  LB := "cd";
  LM^.Name := LA + LB;
  setlength(LM^.Items, 3);
  LM^.Items[1] := 11;
  Show("name len", len(LM^.Name));
  Show("items", LM^.Items[1] + len(LM^.Items));
  destroy(LM);
end;

begin
  Run();
end.
