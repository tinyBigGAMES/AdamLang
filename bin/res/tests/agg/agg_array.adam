-------------------------------------------------------------------------------
  agg_array.adam - Aggregates: static arrays (M3.5f). A local and a module
  array start zeroed; element offsets read back through `addr of`, the
  index less the low bound times the element size: integer bounds from 1,
  negative bounds, char bounds past 127 read as Win64's signed char
  (char(200)..char(30) is -56..30), choices bounds; elements written and
  read by a constant and by a variable index (an int8 index widened by its
  sign, a char index by the target's); a whole array copied by `:=` into a
  local and a module variable, each copy independent of its source; an
  array of records (a record element copied whole) and an array of arrays
  (a row copied whole). Values are shown through ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0
  | 0
  | 0
  | 8
  | 10
  | 40
  | 20
  | 6
  | -7
  | 9
  | 33
  | 1
  | 86
  | 50
  | 5
  | 8
  | 5000000000
  | 10
  | 99
  | 40
  | 40
  | 20
  | 7
  | -1
  | 8
  | 10
  | 300
  | 1
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_array;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  K = choices(Red, Green, Blue);

  TInts = array[1..4] of int32;
  TNegs = array[-3..2] of int16;
  TChars = array[char(200)..char(30)] of int8;
  TKs = array[K.Green..K.Blue] of int64;

  TPair = record
    A: int32;
    B: int8;
  end;

  TPairs = array[0..2] of TPair;
  TRow = array[0..2] of int16;
  TGrid = array[0..1] of TRow;

var
  GInts: TInts;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// The bytes from AStart to AElement
routine Gap(const AElement: ptr; const AStart: ptr): int64;
begin
  return ptr to uint8(AElement) - ptr to uint8(AStart);
end;

routine Run();
var
  LA: TInts;
  LB: TInts;
  LN: TNegs;
  LC: TChars;
  LK: TKs;
  LP: TPairs;
  LG: TGrid;
  LI: int32 = 2;
  LJ: int8 = -2;
  LCh: char = char(250);
begin
  // A local and a module array start zeroed
  ShowInt(LA[1]);
  ShowInt(LA[4]);
  ShowInt(GInts[3]);

  // Integer bounds from 1: element 3 is (3 - 1) int32s in
  ShowInt(Gap(addr of LA[3], addr of LA));
  LA[1] := 10;
  LA[4] := 40;
  ShowInt(LA[1]);
  ShowInt(LA[4]);
  LA[LI] := 20;
  ShowInt(LA[2]);

  // Negative bounds: element 0 is three int16s in; an int8 index widened by its sign
  ShowInt(Gap(addr of LN[0], addr of LN));
  LN[-3] := -7;
  LN[2] := 9;
  ShowInt(LN[-3]);
  ShowInt(LN[2]);
  LN[LJ] := 33;
  ShowInt(LN[-2]);

  // Char bounds past 127: char(201) is -55, one in from -56; char(30) 86 in; a char
  // variable holding char(250) (-6) 50 in
  ShowInt(Gap(addr of LC[char(201)], addr of LC));
  ShowInt(Gap(addr of LC[char(30)], addr of LC));
  ShowInt(Gap(addr of LC[LCh], addr of LC));
  LC[char(200)] := 5;
  ShowInt(LC[char(200)]);

  // Choices bounds: Blue is one int64 past Green
  ShowInt(Gap(addr of LK[K.Blue], addr of LK));
  LK[K.Green] := 5000000000;
  ShowInt(LK[K.Green]);

  // A whole array copied, independent of its source
  LB := LA;
  LB[1] := 99;
  ShowInt(LA[1]);
  ShowInt(LB[1]);
  ShowInt(LB[4]);
  GInts := LA;
  ShowInt(GInts[4]);

  // An array of records: element 2's B is two 8-byte records and 4 bytes in; a record
  // element copied whole
  ShowInt(Gap(addr of LP[2].B, addr of LP));
  LP[1].A := 7;
  LP[1].B := -1;
  LP[2] := LP[1];
  LP[1].A := 8;
  ShowInt(LP[2].A);
  ShowInt(LP[2].B);
  ShowInt(LP[1].A);

  // An array of arrays: row 1's element 2 is one 6-byte row and two int16s in; a row
  // copied whole
  ShowInt(Gap(addr of LG[1][2], addr of LG));
  LG[0][1] := 300;
  LG[1] := LG[0];
  LG[0][1] := 1;
  ShowInt(LG[1][1]);
  ShowInt(LG[0][1]);
end;

begin
  Run();
end.
