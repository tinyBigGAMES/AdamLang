-------------------------------------------------------------------------------
  agg_align.adam - Aggregates: locals aligned above the stack's 16 bytes
  (M3.5c). Each such local's address is a multiple of its alignment (32,
  64, 256: the last takes and rsp's 32-bit immediate) in a realigned frame;
  a realigned frame reads its fifth and sixth arguments from the stack
  (off its frame register), saves rdi / rsi beside rbp (a record copy) and
  calls itself, each level aligned again, and every return gives back the
  caller's stack. Values are shown through ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0
  | 0
  | 7
  | 0
  | 0
  | 660
  | 0
  | 2
  | 0
  | 1
  | 0
  | 0
  | 0
  | 0
  | 0
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_align;

func malloc(const ASize: uint64): ptr; external "ucrtbase";
func puts(const AText: ptr): int32; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  TWide = record align(32)
    A: int32;
    B: int64;
  end;

  THuge = record align(64)
    C: int32;
  end;

  TGiant = record align(256)
    G: int64;
  end;

  TPlain = record
    D: int64;
    E: int64;
  end;

// AValue in decimal, one line
func ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AAddress modulo AAlign (0: aligned)
func Misalign(const AAddress: ptr; const AAlign: uint64): int64;
begin
  return int64(uint64(AAddress) mod AAlign);
end;

// Six arguments: the fifth and sixth arrive on the stack, read off the frame register of
// this realigned frame; returns their sum with the first four
func Stacked(const A1: int64; const A2: int64; const A3: int64; const A4: int64;
  const A5: int64; const A6: int64): int64;
var
  LG: TGiant;
  LW: TWide;
begin
  ShowInt(Misalign(addr of LG, 256));
  ShowInt(Misalign(addr of LW, 32));
  LW.B := A5 + A6;
  return LW.B + A1 + A2 + A3 + A4;
end;

// A realigned frame that also saves rdi / rsi (a record copy) and calls itself
func Nested(const ADepth: int64);
var
  LH: THuge;
  LP: TPlain;
  LQ: TPlain;
begin
  ShowInt(Misalign(addr of LH, 64));
  LP.D := ADepth;
  LQ := LP;
  ShowInt(LQ.D);
  if ADepth > 0 then
    Nested(ADepth - 1);
  end;
  ShowInt(Misalign(addr of LH, 64));
end;

func Run();
var
  LA: TWide;
  LB: TWide;
begin
  ShowInt(Misalign(addr of LA, 32));
  ShowInt(Misalign(addr of LB, 32));
  LA.A := 7;
  LB := LA;
  ShowInt(LB.A);
  ShowInt(Stacked(1, 2, 3, 4, 50, 600));
  Nested(2);
end;

begin
  Run();
end.
