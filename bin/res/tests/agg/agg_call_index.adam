-------------------------------------------------------------------------------
  agg_call_index.adam - An index read of a static array that is no place
  (PLAN-RAVENAPI R1 interrupt): a call's array result is indexed where the
  call leaves it, a nested array's element and a method chain's array too,
  each index checked against the array's bounds.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | three 20 30
  | grid 6
  | chain 12
  | sum 60
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_call_index;

type
  Triple = array[0..2] of int32;
  Grid = array[0..1] of Triple;

  Box = object
    FScale: int32;

    method Items(): Triple;
    var
      LItems: Triple;
    begin
      LItems[0] := 4 * self.FScale;
      LItems[1] := 8 * self.FScale;
      LItems[2] := 12 * self.FScale;
      return LItems;
    end;
  end;

var
  GBox: Box;
  GAt: int64;
  GSum: int64;

func Three(): Triple;
var
  LItems: Triple;
begin
  LItems[0] := 10;
  LItems[1] := 20;
  LItems[2] := 30;
  return LItems;
end;

func MakeGrid(): Grid;
var
  LGrid: Grid;
  LI: int64;
  LJ: int64;
begin
  for LI := 0 to 1 do
    for LJ := 0 to 2 do
      LGrid[LI][LJ] := int32(LI * 3 + LJ + 1);
    end;
  end;
  return LGrid;
end;

begin
  GAt := 2;
  println("three {} {}", Three()[1], Three()[GAt]);
  println("grid {}", MakeGrid()[1][2]);
  GBox.FScale := 1;
  println("chain {}", GBox.Items()[GAt]);
  GSum := 0;
  for GAt := 0 to 2 do
    GSum := GSum + Three()[GAt];
  end;
  println("sum {}", GSum);
end.
