-------------------------------------------------------------------------------
  agg_len_static.adam - Aggregates: len of a static array (AUD3, AUDIT 2.4).
  len of a local, a const parameter, a module variable, a record field, an
  element's field, a deref (P^) and an array type with offset and choices
  bounds; the length is the type's element count, while the argument still
  runs for its effects (the index's call runs once, its print shown).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | local 4
  | param 4
  | module 3
  | field 5
  | index ran
  | element 2
  | deref 4
  | offset 5
  | choices 3
  | sum 10
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_len_static;

type
  Color = choices(Red, Green, Blue);
  Quad = array[0..3] of int32;
  Holder = record
    Items: array[1..5] of int64;
  end;
  Cell = record
    Pair: array[0..1] of int32;
  end;

var
  GTriple: array[0..2] of int32;

// The index 1, shown when it runs
func One(): int32;
begin
  println("index ran");
  return 1;
end;

// The length of AQuad, a const parameter
func QuadLength(const AQuad: Quad): int64;
begin
  return len(AQuad);
end;

func Run();
var
  LQ: Quad;
  LH: Holder;
  LCells: array[0..2] of Cell;
  LP: ptr to Quad;
  LO: array[-2..2] of int32;
  LN: array[Color.Red..Color.Blue] of int32;
  LI: int64;
  LSum: int64;
begin
  println("local {}", len(LQ));
  println("param {}", QuadLength(LQ));
  println("module {}", len(GTriple));
  println("field {}", len(LH.Items));
  println("element {}", len(LCells[One()].Pair));
  LP := addr of LQ;
  println("deref {}", len(LP^));
  println("offset {}", len(LO));
  println("choices {}", len(LN));
  LSum := 0;
  for LI := 0 to len(LP^) - 1 do
    LSum := LSum + LI + 1;
  end;
  println("sum {}", LSum);
end;

begin
  Run();
end.
