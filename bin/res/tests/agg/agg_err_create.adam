-------------------------------------------------------------------------------
  agg_err_create.adam - Break step of agg_create (BNF sec 7, H4u1). create /
  destroy take a pointer variable to a record or an overlay (SM0409 naming
  that signature): a pointer to an int32, the untyped ptr, a call's result
  (no variable), a literal, two arguments, none. A pointer to an object is
  SM0361 at the argument, naming the own / ref that builds and frees one.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_create;

type
  Point = record
    X: int32;
  end;

  Thing = object
    FValue: int32;
  end;

var
  GPoint: Point;

// A pointer that is no variable
routine PointAt(): ptr to Point;
begin
  return addr of GPoint;
end;

routine Run();
var
  LP: ptr to Point;
  LI: ptr to int32;
  LU: ptr;
  LT: ptr to Thing;
begin
  create(LI); // ERROR SM0409@10: 'create' takes (record or overlay pointer variable)
  destroy(LI); // ERROR SM0409@11: 'destroy' takes (record or overlay pointer variable)
  create(LU); // ERROR SM0409@10: 'create' takes (record or overlay pointer variable)
  destroy(LU); // ERROR SM0409@11: 'destroy' takes (record or overlay pointer variable)
  create(PointAt()); // ERROR SM0409@10: 'create' takes (record or overlay pointer variable)
  destroy(PointAt()); // ERROR SM0409@11: 'destroy' takes (record or overlay pointer variable)
  create(5); // ERROR SM0409@10: 'create' takes (record or overlay pointer variable)
  create(LP, LP); // ERROR SM0409@3: 'create' takes (record or overlay pointer variable)
  destroy(); // ERROR SM0409@3: 'destroy' takes (record or overlay pointer variable)
  create(LT); // ERROR SM0361@10: create does not build an object ('Thing' is one): write own Thing(...) or ref Thing(...)
  destroy(LT); // ERROR SM0361@11: destroy does not free an object ('Thing' is one): the own or ref that holds it frees it
end;

begin
  Run();
end.
