-------------------------------------------------------------------------------
  agg_err_unnamed_bits.adam - Break step of agg_unnamed_bits (M9e0c, BNF
  sec 4): an unnamed field is a padding bitfield, so it needs a width
  (SM0731); its width is 0 .. the type's bits (SM0315), a named one's still
  1 .. bits; no name reaches it (`R._` is no member).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_unnamed_bits;

type
  TNoWidth = record
    A: int32;
    _: int32; // ERROR SM0731@5: an unnamed field is a padding bitfield: give it a width (_: int32 : N; 0 ends the open unit)
  end;

  TWide = record
    _: int32 : 33; // ERROR SM0315@16: bitfield width 33 outside 0..32
    A: int32 : 0; // ERROR SM0315@16: bitfield width 0 outside 1..32
  end;

  TOk = record
    A: int32 : 3;
    _: int32 : 5;
  end;

var
  LOk: TOk;
begin
  LOk._ := 1; // ERROR SM0009@3: 'TOk' has no member '_'
end.
