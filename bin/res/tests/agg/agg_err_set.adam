-------------------------------------------------------------------------------
  agg_err_set.adam - Break step of sets (BNF sec 4 set type, AUD4 5.3): the
  element form takes char, bool or a choices type (an integer type names its
  range: SM0318; set of wchar: SM0319; anything else: SM0329); a set literal's
  constant element lies in the set's range (SM0200) and a constant range's low
  bound is not above its high (SM0267); an array of sets has no order (< on it
  is SM0250)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_set;

type
  TInts = set of int32; // ERROR SM0318@18
  TWide = set of wchar; // ERROR SM0319@18
  TText = set of string; // ERROR SM0329@18
  TDigits = set of 0..9;
  TPair = array[0..1] of TDigits;

var
  LD: TDigits;
  LA: TPair;
  LB: TPair;

begin
  LD := [1, 9];
  LD := [5..1]; // ERROR SM0267@10
  LD := [10]; // ERROR SM0200@10
  LD := [2..12]; // ERROR SM0200@13
  if LA < LB then // ERROR SM0250@6
    println("{}", "never");
  end;
end.
