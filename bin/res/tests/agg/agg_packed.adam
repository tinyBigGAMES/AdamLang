-------------------------------------------------------------------------------
  agg_packed.adam - a packed record's fields (BNF PLAN-RECORDS M8, AUD4
  5.2): a plain read, write, copy and scalar compound operator on a field
  that may be misaligned stay legal, and so does a const argument of it;
  a field whose type aligns to 1 (an int8, a packed record) binds by address
  as any field does, a packed record's own address is aligned to its type,
  a non-packed record's fields reached through a pointer are aligned
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 5 6 2 9
  | 3 4
  | 12
  | 8 2
@@end
*/

module exe agg_packed;

type
  TS = set of 0..15;
  TPk = record packed
    C: int8;
    I: int32;
    S: TS;
  end;
  TBox = record packed
    D: int8;
    K: TPk;
  end;
  TBase = record
    X: int32;
  end;

routine BumpByte(var AN: int8);
begin
  AN += 1;
end;

routine Twice(const AN: int32): int32;
begin
  return AN * 2;
end;

routine Grow(var AB: TBase);
begin
  AB.X := AB.X + 1;
end;

var
  LP: TPk;
  LB: TBox;
  LQ: ptr to TPk;
  LR: ptr to int8;
  LBase: TBase;
  LPB: ptr to TBase;
  LIn: int32;

begin
  SetHeapReport(false);
  LP.C := 4;
  LP.I := 5;
  LP.S := [1];
  LP.I += 1;
  BumpByte(LP.C);
  LP.S := LP.S + [5];
  LIn := 0;
  if 1 in LP.S then
    LIn := LIn + 1;
  end;
  if 5 in LP.S then
    LIn := LIn + 1;
  end;
  println("{} {} {} {}", LP.C, LP.I, LIn, LB.D + 9);
  LR := addr of LB.K.C;
  LR^ := 3;
  LQ := addr of LB.K;
  LQ->I := 4;
  println("{} {}", LB.K.C, LB.K.I);
  println("{}", Twice(LP.I));
  LPB := addr of LBase;
  Grow(LPB^);
  Grow(LBase);
  LBase.X := LBase.X + 6;
  println("{} {}", LBase.X, LB.K.C - 1);
end.
