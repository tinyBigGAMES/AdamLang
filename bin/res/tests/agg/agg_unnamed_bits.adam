-------------------------------------------------------------------------------
  agg_unnamed_bits.adam - unnamed bitfields (M9e0c, BNF sec 4, his OK
  2026-11-16): `_: T : N;` pads N bits of a unit (C's `T : N;`), any number
  of them, none reachable; `_: T : 0;` by the target's rule (Microsoft's on
  x86_64-windows-gnu): after a bitfield it ends the unit and aligns the
  next member to T, after anything else it is ignored. Read back as the
  record's raw bytes.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 1 167
  | 8 9 6
  | 2 1 2
  | 8 4
  | 2 240
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_unnamed_bits;

type
  // A in bits 0..2, 2 padding bits, B in bits 5..7
  TPad = record
    A: uint8 : 3;
    _: uint8 : 2;
    B: uint8 : 3;
  end;

  // the zero width ends A's unit: B starts the next one at 4
  TEnd = record
    A: uint32 : 4;
    _: uint32 : 0;
    B: uint32 : 4;
  end;

  // after a plain field a zero width is ignored: Y at 1, size 2
  TIgnored = record
    X: uint8;
    _: uint32 : 0;
    Y: uint8;
  end;

  // after a bitfield it aligns the next member to uint32: B at 4, size 8
  TAligned = record
    A: uint8 : 1;
    _: uint32 : 0;
    B: uint8;
  end;

  // two unnamed ones in one record
  TTwo = record
    _: uint16 : 4;
    V: uint16 : 4;
    _: uint16 : 8;
  end;

var
  LPad: TPad;
  LEnd: TEnd;
  LIgnored: TIgnored;
  LAligned: TAligned;
  LTwo: TTwo;
  LRaw: ptr to uint8;
begin
  LPad.A := 7;
  LPad.B := 5;
  LRaw := ptr to uint8(addr of LPad);
  println("{} {}", size(TPad), LRaw[0]);

  LEnd.A := 9;
  LEnd.B := 6;
  LRaw := ptr to uint8(addr of LEnd);
  println("{} {} {}", size(TEnd), LRaw[0], LRaw[4]);

  LIgnored.X := 1;
  LIgnored.Y := 2;
  LRaw := ptr to uint8(addr of LIgnored);
  println("{} {} {}", size(TIgnored), LRaw[0], LRaw[1]);

  LAligned.B := 4;
  LRaw := ptr to uint8(addr of LAligned);
  println("{} {}", size(TAligned), LRaw[4]);

  LTwo.V := 15;
  LRaw := ptr to uint8(addr of LTwo);
  println("{} {}", size(TTwo), LRaw[0]);
end.
