-------------------------------------------------------------------------------
  agg_array_compare.adam - Aggregates: arrays compare element by element
  (AUD3, AUDIT 2.5; BNF sec 6). Static arrays by = <> < <= > >= <=>; a
  nested static array; string elements; a float NaN element (equal to
  nothing, skipped by an order: the next pair decides); set elements by =; dynamic arrays by
  content, not by block (two blocks of the same values are equal), a
  shorter prefix below the longer, empty ones equal; each operand runs
  once, left first.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | static true false
  | changed false true
  | order true false true false
  | three -1 1 0
  | nested true false
  | text true -1
  | nan false true
  | nan order -1
  | sets true false
  | dynamic true false
  | prefix true -1 1
  | empty true 0
  | left
  | right
  | once true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_array_compare;

type
  Quad = array[0..3] of int32;
  Grid = array[0..1] of Quad;
  Small = set of 0..7;

var
  GQ: Quad;

// GQ, shown as the side it stands for
func Side(const AText: string): Quad;
begin
  println(AText);
  return GQ;
end;

func Run();
var
  LA: Quad;
  LB: Quad;
  LG: Grid;
  LH: Grid;
  LS: array[0..1] of string;
  LT: array[0..1] of string;
  LF: array[0..1] of float64;
  LE: array[0..1] of float64;
  LZero: float64;
  LSa: array[0..1] of Small;
  LSb: array[0..1] of Small;
  LD: array of int32;
  LC: array of int32;
  LShort: array of int32;
  LNone: array of int32;
  LNil: array of int32;
begin
  LA := [1, 2, 3, 4];
  LB := LA;
  println("static {} {}", LA = LB, LA <> LB);
  LB[3] := 5;
  println("changed {} {}", LA = LB, LA <> LB);
  println("order {} {} {} {}", LA < LB, LA > LB, LA <= LB, LA >= LB);
  println("three {} {} {}", LA <=> LB, LB <=> LA, LA <=> LA);
  LG[0] := LA;
  LG[1] := LB;
  LH := LG;
  println("nested {} {}", LG = LH, LG < LH);
  LS := ["ab", "cd"];
  LT := ["ab", "ce"];
  println("text {} {}", LS < LT, LS <=> LT);
  LZero := 0.0;
  LF := [LZero / LZero, 1.0];
  LE := LF;
  println("nan {} {}", LF = LE, LF <> LE);
  LE[1] := 2.0;
  println("nan order {}", LF <=> LE);
  LSa[0] := [1, 2];
  LSa[1] := [7];
  LSb := LSa;
  println("sets {} {}", LSa = LSb, LSa <> LSb);
  LD := [1, 2, 3];
  LC := [1, 2];
  setlength(LC, 3);
  LC[2] := 3;
  println("dynamic {} {}", LD = LC, LD <> LC);
  LShort := [1, 2];
  println("prefix {} {} {}", LShort < LD, LShort <=> LD, LD <=> LShort);
  LNone := [];
  println("empty {} {}", LNone = LNil, LNone <=> LNil);
  GQ := LA;
  println("once {}", Side("left") = Side("right"));
end;

begin
  Run();
end.
