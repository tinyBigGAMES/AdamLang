-------------------------------------------------------------------------------
  agg_err_huge.adam - Break step of bounds (AUD4 5.4): a static array or a
  set range whose member count passes an int64 (every int64 value) is too
  large, SM0277 for the array, SM0321 for the set, never left unknown
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_huge;

type
  TA = array[-9223372036854775807 - 1..9223372036854775807] of uint8; // ERROR SM0277@8
  TS = set of -9223372036854775807 - 1..9223372036854775807; // ERROR SM0321@8

begin
end.
