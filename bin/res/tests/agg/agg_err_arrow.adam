-------------------------------------------------------------------------------
  agg_err_arrow.adam - Break step of qualified names (AUD4 5.4): '->'
  reaches through a pointer, so a choices type's value or a module's name
  reached with it is SM0014 ("reach its names with '.'")
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_arrow;

import System.SysUtils;

type
  TColor = choices(cRed, cGreen, cBlue);

var
  LC: TColor;
  LS: string;

begin
  LC := TColor.cGreen;
  LC := TColor->cRed; // ERROR SM0014@9
  LS := System.SysUtils->IntToStr(5); // ERROR SM0014@9
end.
