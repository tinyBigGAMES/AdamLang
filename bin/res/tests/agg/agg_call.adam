begin
  LW := Weigh(ptr to uint8(addr of AValue), 11);
  Fill(ptr to uint8(addr of AValue), 11, 0);
  return LW;
end;

routine Echo11(const AValue: T11): T11;
begin
  return AValue;
end;

routine Make12(const ASeed: int64): T12;
var
  LR: T12;
begin
  Fill(ptr to uint8(addr of LR), 12, ASeed);
  return LR;
end;

routine Take12(AValue: T12): int64;
var
  LW: int64;
begin
  LW := Weigh(ptr to uint8(addr of AValue), 12);
  Fill(ptr to uint8(addr of AValue), 12, 0);
  return LW;
end;

routine Echo12(const AValue: T12): T12;
begin
  return AValue;
end;

