  | 2
  | 3
  | 1
  | 14
  | -16
  | 10000000000
  | 42
  | 1
  | 0
  | 1
  | 0
  | 3
  | 2
  | -3
  | -2
  | 5000000
  | 7
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_call;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  // One record per size 1..17, its bytes one byte array
  T1 = record B: array[0..0] of uint8; end;
  T2 = record B: array[0..1] of uint8; end;
  T3 = record B: array[0..2] of uint8; end;
  T4 = record B: array[0..3] of uint8; end;
  T5 = record B: array[0..4] of uint8; end;
  T6 = record B: array[0..5] of uint8; end;
  T7 = record B: array[0..6] of uint8; end;
  T8 = record B: array[0..7] of uint8; end;
  T9 = record B: array[0..8] of uint8; end;
  T10 = record B: array[0..9] of uint8; end;
  T11 = record B: array[0..10] of uint8; end;
  T12 = record B: array[0..11] of uint8; end;
  T13 = record B: array[0..12] of uint8; end;
  T14 = record B: array[0..13] of uint8; end;
  T15 = record B: array[0..14] of uint8; end;
  T16 = record B: array[0..15] of uint8; end;
  T17 = record B: array[0..16] of uint8; end;

  // 8 bytes aligned 4 (a register), 12 bytes (a copy / a hidden result)
  TPair = record
    A: int32;
    B: int32;
  end;

  TTrip = record
    A: int32;
    B: int32;
    C: int32;
  end;

  // 24 bytes (a copy / a hidden result), 8 bytes (a register)
  TArr3 = array[0..2] of int64;
  TArr2 = array[0..1] of int32;

  // 1 byte (a register), two words (a copy / a hidden result)
  TSmall = set of 0..7;
  TMid = set of 1..100;

  // C's ldiv_t (8 bytes on LLP64: long is 32 bits) and lldiv_t (16 bytes)
  TLDiv = record
    Quot: int32;
    Rem: int32;
  end;

  TLLDiv = record
    Quot: int64;
    Rem: int64;
  end;

routine ldiv(const ANum: int32; const ADen: int32): TLDiv; external "ucrtbase";
routine lldiv(const ANum: int64; const ADen: int64): TLLDiv; external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue as 1 or 0, one line
routine ShowBool(const AValue: bool);
begin
  if AValue then
    ShowInt(1);
  else
    ShowInt(0);
  end;
end;

// ACount bytes at AAt written ASeed, ASeed + 1, ...
routine Fill(const AAt: ptr to uint8; const ACount: int64; const ASeed: int64);
var
  LI: int64;
begin
  for LI := 0 to ACount - 1 do
    AAt[LI] := uint8(ASeed + LI);
  end;
end;

// The sum of ACount bytes at AAt, each times its position + 1 (so order counts)
routine Weigh(const AAt: ptr to const uint8; const ACount: int64): int64;
var
  LI: int64;
  LSum: int64;
begin
  LSum := 0;
  for LI := 0 to ACount - 1 do
    LSum := LSum + (LI + 1) * int64(AAt[LI]);
  end;
  return LSum;
end;

// Per size N: MakeN builds a TN from a seed (a result); TakeN weighs its copy then
// clobbers it (by value, no mode: the caller's value stays); EchoN hands its argument
// back (in and out)
routine Make1(const ASeed: int64): T1;
var
  LR: T1;
begin
  Fill(ptr to uint8(addr of LR), 1, ASeed);
  return LR;
end;

routine Take1(AValue: T1): int64;
var
  LW: int64;
begin
  LW := Weigh(ptr to uint8(addr of AValue), 1);
  Fill(ptr to uint8(addr of AValue), 1, 0);
  return LW;
end;

routine Echo1(const AValue: T1): T1;
begin
  return AValue;
end;

routine Make2(const ASeed: int64): T2;
var
  LR: T2;
begin
  Fill(ptr to uint8(addr of LR), 2, ASeed);
