var
  LR: T13;
begin
  Fill(ptr to uint8(addr of LR), 13, ASeed);
  return LR;
end;

routine Take13(AValue: T13): int64;
var
  LW: int64;
begin
  LW := Weigh(ptr to uint8(addr of AValue), 13);
  Fill(ptr to uint8(addr of AValue), 13, 0);
  return LW;
end;

routine Echo13(const AValue: T13): T13;
begin
  return AValue;
end;

routine Make14(const ASeed: int64): T14;
var
  LR: T14;
begin
  Fill(ptr to uint8(addr of LR), 14, ASeed);
  return LR;
end;

routine Take14(AValue: T14): int64;
var
  LW: int64;
begin
  LW := Weigh(ptr to uint8(addr of AValue), 14);
  Fill(ptr to uint8(addr of AValue), 14, 0);
  return LW;
end;

routine Echo14(const AValue: T14): T14;
begin
  return AValue;
end;

routine Make15(const ASeed: int64): T15;
var
  LR: T15;
begin
  Fill(ptr to uint8(addr of LR), 15, ASeed);
  return LR;
end;

routine Take15(AValue: T15): int64;
var
  LW: int64;
begin
  LW := Weigh(ptr to uint8(addr of AValue), 15);
  Fill(ptr to uint8(addr of AValue), 15, 0);
  return LW;
end;

routine Echo15(const AValue: T15): T15;
begin
  return AValue;
end;

routine Make16(const ASeed: int64): T16;
var
  LR: T16;
begin
  Fill(ptr to uint8(addr of LR), 16, ASeed);
  return LR;
end;

routine Take16(AValue: T16): int64;
var
  LW: int64;
begin
  LW := Weigh(ptr to uint8(addr of AValue), 16);
  Fill(ptr to uint8(addr of AValue), 16, 0);
  return LW;
end;

routine Echo16(const AValue: T16): T16;
begin
  return AValue;
end;

routine Make17(const ASeed: int64): T17;
var
  LR: T17;
begin
  Fill(ptr to uint8(addr of LR), 17, ASeed);
  return LR;
end;

routine Take17(AValue: T17): int64;
var
  LW: int64;
begin
  LW := Weigh(ptr to uint8(addr of AValue), 17);
  Fill(ptr to uint8(addr of AValue), 17, 0);
  return LW;
end;

routine Echo17(const AValue: T17): T17;
begin
  return AValue;
end;

// Five aggregates in one call: registers rcx / rdx / r8 / r9, the fifth on the stack
routine Mix(const AA: T3; const AB: T8; const AC: T17; const AD: T1; const AE: T16);
begin
  ShowInt(Weigh(ptr to const uint8(addr of AA), 3));
  ShowInt(Weigh(ptr to const uint8(addr of AB), 8));
  ShowInt(Weigh(ptr to const uint8(addr of AC), 17));
  ShowInt(Weigh(ptr to const uint8(addr of AD), 1));
  ShowInt(Weigh(ptr to const uint8(addr of AE), 16));
end;

// A hidden result beside a scalar argument: AValue with ADelta added to every byte
routine Shift17(const ADelta: int64; const AValue: T17): T17;
var
  LR: T17;
  LI: int64;
begin
  LR := AValue;
  for LI := 0 to 16 do
    LR.B[LI] := uint8(int64(LR.B[LI]) + ADelta);
  end;
  return LR;
end;

// AP with its fields swapped (8 bytes: a register both ways)
routine Swap(const AP: TPair): TPair;
begin
  return TPair(A: AP.B, B: AP.A);
end;

// AT rotated left one field (12 bytes: a copy in, a hidden result out)
routine Rot(const AT: TTrip): TTrip;
begin
  return TTrip(A: AT.B, B: AT.C, C: AT.A);
end;

// Every element of AArr doubled (24 bytes)
routine Doubled(const AArr: TArr3): TArr3;
var
  LR: TArr3;
  LI: int64;
begin
  for LI := 0 to 2 do
    LR[LI] := AArr[LI] * 2;
  end;
  return LR;
end;

// The sum of AArr's two elements (8 bytes: a register)
routine Sum2(const AArr: TArr2): int64;
begin
  return AArr[0] + AArr[1];
end;

// ASet with 7 added (1 byte: a register both ways)
routine WithSeven(const ASet: TSmall): TSmall;
begin
  return ASet + [7];
end;

// ASet with 10 added (two words: a copy in, a hidden result out)
routine WithTen(const ASet: TMid): TMid;
begin
  return ASet + [10];
end;

var
  // A module variable initialized from a call (a hidden result at the entry)
  GTwelve: T12 = Make12(4);

routine Run();
var
  L1: T1;
  L2: T2;
  L3: T3;
  L4: T4;
  L5: T5;
  L6: T6;
  L7: T7;
  L8: T8;
  L9: T9;
  L10: T10;
  L11: T11;
  L12: T12;
  L13: T13;
  L14: T14;
  L15: T15;
  L16: T16;
  L17: T17;
  LInit: T9 = Make9(3);
  LPair: TPair;
  LTrip: TTrip;
  LArr: TArr3;
  LTwo: TArr2;
  LSmall: TSmall;
  LMid: TMid;
  LDiv: TLDiv;
  LLDiv: TLLDiv;
begin
  // Every size in, out and through; the caller's value after TakeN clobbered its copy
  L1 := Make1(1);
  ShowInt(Take1(L1));
  ShowInt(Take1(Echo1(L1)));
  ShowInt(Weigh(ptr to uint8(addr of L1), 1));
  L2 := Make2(2);
  ShowInt(Take2(L2));
  ShowInt(Take2(Echo2(L2)));
  ShowInt(Weigh(ptr to uint8(addr of L2), 2));
  L3 := Make3(3);
  ShowInt(Take3(L3));
  ShowInt(Take3(Echo3(L3)));
  ShowInt(Weigh(ptr to uint8(addr of L3), 3));
  L4 := Make4(4);
  ShowInt(Take4(L4));
  ShowInt(Take4(Echo4(L4)));
  ShowInt(Weigh(ptr to uint8(addr of L4), 4));
  L5 := Make5(5);
  ShowInt(Take5(L5));
  ShowInt(Take5(Echo5(L5)));
  ShowInt(Weigh(ptr to uint8(addr of L5), 5));
  L6 := Make6(6);
  ShowInt(Take6(L6));
  ShowInt(Take6(Echo6(L6)));
  ShowInt(Weigh(ptr to uint8(addr of L6), 6));
  L7 := Make7(7);
  ShowInt(Take7(L7));
  ShowInt(Take7(Echo7(L7)));
  ShowInt(Weigh(ptr to uint8(addr of L7), 7));
  L8 := Make8(8);
  ShowInt(Take8(L8));
  ShowInt(Take8(Echo8(L8)));
  ShowInt(Weigh(ptr to uint8(addr of L8), 8));
  L9 := Make9(9);
  ShowInt(Take9(L9));
  ShowInt(Take9(Echo9(L9)));
  ShowInt(Weigh(ptr to uint8(addr of L9), 9));
  L10 := Make10(10);
  ShowInt(Take10(L10));
  ShowInt(Take10(Echo10(L10)));
  ShowInt(Weigh(ptr to uint8(addr of L10), 10));
  L11 := Make11(11);
  ShowInt(Take11(L11));
  ShowInt(Take11(Echo11(L11)));
  ShowInt(Weigh(ptr to uint8(addr of L11), 11));
  L12 := Make12(12);
  ShowInt(Take12(L12));
  ShowInt(Take12(Echo12(L12)));
  ShowInt(Weigh(ptr to uint8(addr of L12), 12));
  L13 := Make13(13);
  ShowInt(Take13(L13));
  ShowInt(Take13(Echo13(L13)));
  ShowInt(Weigh(ptr to uint8(addr of L13), 13));
  L14 := Make14(14);
  ShowInt(Take14(L14));
  ShowInt(Take14(Echo14(L14)));
  ShowInt(Weigh(ptr to uint8(addr of L14), 14));
  L15 := Make15(15);
  ShowInt(Take15(L15));
  ShowInt(Take15(Echo15(L15)));
  ShowInt(Weigh(ptr to uint8(addr of L15), 15));
  L16 := Make16(16);
  ShowInt(Take16(L16));
  ShowInt(Take16(Echo16(L16)));
  ShowInt(Weigh(ptr to uint8(addr of L16), 16));
  L17 := Make17(17);
  ShowInt(Take17(L17));
  ShowInt(Take17(Echo17(L17)));
  ShowInt(Weigh(ptr to uint8(addr of L17), 17));

  // Five call results as arguments, the fifth on the stack
  Mix(Make3(1), Make8(2), Make17(3), Make1(4), Make16(5));

  // A hidden result assigned back over its own argument
  L17 := Shift17(1, L17);
  ShowInt(Weigh(ptr to uint8(addr of L17), 17));

  // A local's and a module variable's initializer from a call
  ShowInt(Weigh(ptr to uint8(addr of LInit), 9));
  ShowInt(Weigh(ptr to uint8(addr of GTwelve), 12));

  // Records of int32 fields
  LPair := Swap(TPair(A: 5, B: -6));
  ShowInt(LPair.A);
  ShowInt(LPair.B);
  LTrip.A := 1;
  LTrip.B := 2;
  LTrip.C := 3;
  LTrip := Rot(LTrip);
  ShowInt(LTrip.A);
  ShowInt(LTrip.B);
  ShowInt(LTrip.C);

  // Static arrays
  LArr[0] := 7;
  LArr[1] := -8;
  LArr[2] := 5000000000;
  LArr := Doubled(LArr);
  ShowInt(LArr[0]);
  ShowInt(LArr[1]);
  ShowInt(LArr[2]);
  LTwo[0] := 40;
  LTwo[1] := 2;
  ShowInt(Sum2(LTwo));

  // Sets
  LSmall := WithSeven(LSmall);
  ShowBool(7 in LSmall);
  ShowBool(3 in LSmall);
  LMid := WithTen(LMid);
  ShowBool(10 in LMid);
  ShowBool(11 in LMid);

  // C results: ldiv_t in rax, lldiv_t through the hidden pointer
  LDiv := ldiv(17, 5);
  ShowInt(LDiv.Quot);
  ShowInt(LDiv.Rem);
  LDiv := ldiv(-17, 5);
  ShowInt(LDiv.Quot);
  ShowInt(LDiv.Rem);
  LLDiv := lldiv(5000000007, 1000);
  ShowInt(LLDiv.Quot);
  ShowInt(LLDiv.Rem);
end;

begin
  Run();
end.
