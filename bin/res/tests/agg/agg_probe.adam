-------------------------------------------------------------------------------
  agg_probe.adam - Aggregates: frames past a page are probed (M3.5c2).
  Windows commits a thread's stack a page at a time through its guard
  page; a frame reaching more than a page below its saves touches every
  page in order before the prologue reserves it. A 64 KB frame (two
  32 KB records, a record copy saving rdi / rsi) writes its far end first
  and calls itself eight deep (past 512 KB, far beyond the image's initial
  commit), its two register arguments read after the probe; a realigned
  frame (align(8192)) past a page lands aligned. Values are shown through
  ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0
  | 5
  | 0
  | 11
  | 22
  | 33
  | 44
  | 55
  | 66
  | 77
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_probe;

func malloc(const ASize: uint64): ptr; external "ucrtbase";
func puts(const AText: ptr): int32; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  // Records doubling from 16 bytes to 32 KB: A is each one's first half, B its second
  T16 = record
    A: int64;
    B: int64;
  end;

  T32 = record
    A: T16;
    B: T16;
  end;

  T64 = record
    A: T32;
    B: T32;
  end;

  T128 = record
    A: T64;
    B: T64;
  end;

  T256 = record
    A: T128;
    B: T128;
  end;

  T512 = record
    A: T256;
    B: T256;
  end;

  T1K = record
    A: T512;
    B: T512;
  end;

  T2K = record
    A: T1K;
    B: T1K;
  end;

  T4K = record
    A: T2K;
    B: T2K;
  end;

  T8K = record
    A: T4K;
    B: T4K;
  end;

  T16K = record
    A: T8K;
    B: T8K;
  end;

  T32K = record
    A: T16K;
    B: T16K;
  end;

  // Two pages' alignment: a realigned frame past a page
  TPage = record align(8192)
    P: int64;
  end;

// AValue in decimal, one line
func ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AAddress modulo AAlign (0: aligned)
func Misalign(const AAddress: ptr; const AAlign: uint64): int64;
begin
  return int64(uint64(AAddress) mod AAlign);
end;

// A realigned frame past a page: its local aligned, written and read
func Aligned();
var
  LR: TPage;
begin
  LR.P := 5;
  ShowInt(Misalign(addr of LR, 8192));
  ShowInt(LR.P);
end;

// A 64 KB frame: its lowest bytes written first (the far end from the saves), then its
// highest, copied whole, then ADepth more frames below it; shows ADepth * (1 + AStep) on
// the way back (both arguments arrive in registers the probe must leave alone)
func Deep(const ADepth: int64; const AStep: int64);
var
  LBig: T32K;
  LCopy: T32K;
begin
  LBig.A.A.A.A.A.A.A.A.A.A.A.A := ADepth;
  LBig.B.B.B.B.B.B.B.B.B.B.B.B := ADepth * AStep;
  LCopy := LBig;
  if ADepth > 0 then
    Deep(ADepth - 1, AStep);
  end;
  ShowInt(LCopy.A.A.A.A.A.A.A.A.A.A.A.A + LCopy.B.B.B.B.B.B.B.B.B.B.B.B);
end;

begin
  Aligned();
  Deep(7, 10);
end.
