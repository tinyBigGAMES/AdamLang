-------------------------------------------------------------------------------
  agg_unit_forward.adam - a unit's public forward type held by value in the
  module that imports it (BNF sec 3: the full declaration follows in the
  unit): the importer sees the unit whole, so its full declaration counts
  wherever it stands (it had been SM0300, the use's place compared with the
  unit's own offsets); the unit's routine type naming the forward type
  called through the importer's value
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 8 7 14
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_unit_forward;

@addmodulepath "$P:res/tests/agg/fixtures";

import AggForwardUnit;

var
  LNode: UNode;
  LNodes: array[0..1] of UNode;
begin
  LNode.V := 7;
  LNode.F := UTwice;
  LNodes[1] := LNode;
  println("{} {} {}", size(UNode) div 2, LNodes[1].V, LNodes[1].F(LNode));
end.
