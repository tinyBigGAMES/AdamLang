-------------------------------------------------------------------------------
  agg_forward_code.adam - a forward type held by value in code (BNF sec 3,
  J3c): a method's local and a routine's local of a record whose full
  declaration follows them in the module, both complete there (code is checked after every declaration of its module);
  the method's signature returns an array of it (behind a dynamic array).
  A field before the full declaration stays SM0300 (data\data_err_decls).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 42 2 7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_forward_code;

forward type TItem;

type
  TBox = object
    Count: int32;

    // A later-declared record held by value in a local and returned in an array
    method Make(): array of TItem;
    var
      LItem: TItem;
      LItems: array of TItem;
    begin
      LItem.Value := 41 + self.Count;
      setlength(LItems, 2);
      LItems[0] := LItem;
      LItems[1].Value := 2;
      return LItems;
    end;
  end;

routine Seven(): int32;
var
  LItem: TItem;
begin
  LItem.Value := 7;
  return LItem.Value;
end;

type
  TItem = record
    Value: int32;
  end;

var
  LBox: TBox;
  LMade: array of TItem;
begin
  LBox.Count := 1;
  LMade := LBox.Make();
  println("{} {} {}", LMade[0].Value, LMade[1].Value, Seven());
end.
