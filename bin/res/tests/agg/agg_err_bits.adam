-------------------------------------------------------------------------------
  agg_err_bits.adam - Break step of agg_bits (M3.5e2 / M3.5e3). A constant
  stored into a bitfield must fit its width (BNF F37, SM0200 naming the type
  as 'T : width' with its range): signed for int32 and char (the target's
  char, signed on Win64) and a choices type, unsigned for uint8 and wchar,
  by `:=` and in a record literal's field; the values at the edges fit. A
  bitfield has no address (SM0262): `addr of` one, and one given to a var
  parameter.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_bits;

type
  TTri = choices(Low = -2, Mid, High);

  TBits = record
    B: int32 : 3;
    U: uint8 : 4;
    C: char : 6;
    W: wchar : 9;
    T: TTri : 2;
  end;

func Take(var AV: int32);
begin
end;

func Run();
var
  LR: TBits;
  LP: ptr to int32;
begin
  LR.B := 100; // ERROR SM0200@11: 100 does not fit in 'int32 : 3' (-4..3)
  LR.U := 16; // ERROR SM0200@11: 16 does not fit in 'uint8 : 4' (0..15)
  LR.C := char(40); // ERROR SM0200@11: 40 does not fit in 'char : 6' (-32..31)
  LR.W := wchar(600); // ERROR SM0200@11: 600 does not fit in 'wchar : 9' (0..511)
  LR.T := TTri(5); // ERROR SM0200@11: 5 does not fit in 'TTri : 2' (-2..1)
  LR := TBits(B: -5); // ERROR SM0200@18: -5 does not fit in 'int32 : 3' (-4..3)
  LR.B := -4;
  LR.B := 3;
  LR.U := 15;
  LR.C := char(-32);
  LR.W := wchar(511);
  LR.T := TTri(1);
  LR := TBits(B: -4, U: 0);
  LP := addr of LR.B; // ERROR SM0262@17: the bitfield 'B' has no address: it cannot be taken with 'addr of' or passed to a var parameter
  Take(LR.B); // ERROR SM0262@8: the bitfield 'B' has no address: it cannot be taken with 'addr of' or passed to a var parameter
end;

begin
  Run();
end.
