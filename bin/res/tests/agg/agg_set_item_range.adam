-------------------------------------------------------------------------------
  agg_set_item_range.adam - A set literal's computed item above its set's
  members (PLAN-SELFHOST S4): it raises PaskalCPP's EXC_SET_RANGE (11) with
  its text, nothing after it runs, and nothing caught reports it (exit 1).
  The local text the frame holds is released as the raise unwinds it.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 1
  | start
  | unhandled exception 11: set element 9 is out of range 0..7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_set_item_range;

type
  TSmall = set of 0..7;

routine Run();
var
  LS: TSmall;
  LX: int32;
  LNote: string;
begin
  LNote := "held";
  LX := 9;
  println("start");
  LS := [1, LX];
  println("not reached {}", LNote);
end;

begin
  Run();
end.
