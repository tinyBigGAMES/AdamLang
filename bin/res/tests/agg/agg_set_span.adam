-------------------------------------------------------------------------------
  agg_set_span.adam - A set literal's span with a bound computed at run time
  (BNF sec 6 set literal, PLAN-ADAM B2; pcpp's make_set): [LA..LB] sets each
  member from low to high; a constant bound beside a computed one; a span
  with low above high is empty and raises nothing; a char span and a
  choices span; spans and single items mixed, in a loop (the literal starts
  empty each pass); a low below the set's members raises EXC_SET_RANGE (11)
  naming the low, a high above them names the high, both caught; an empty
  span outside the members still raises nothing.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 2 3 4 5
  | 0 1 2 6
  | empty true
  | false true true false
  | false true true false
  | 1 3 4 5 7
  | pass 0: 0 1
  | pass 1: 1 2
  | pass 2: 2 3
  | low 11: set element -1 is out of range 0..31
  | high 11: set element 40 is out of range 0..31
  | outside empty true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_set_span;

import System.SysUtils;

type
  TSmall = set of 0..31;
  TColor = choices(Red, Green, Blue, Gray);
  TColors = set of TColor;
  TLetters = set of 'a'..'z';

var
  GA: int32 = 2;
  GB: int32 = 5;
  GLow: char = 'b';
  GHigh: char = 'd';
  GFirst: TColor = TColor.Green;
  GSet: TSmall;
  GC: TColors;
  GL: TLetters;
  GK: int32;

// AS's members, low to high, joined by spaces
routine Members(const AS: TSmall): string;
var
  LI: int32;
  LText: string;
begin
  LText := "";
  for LI := 0 to 31 do
    if LI in AS then
      if LText <> "" then
        LText := LText + " ";
      end;
      LText := LText + IntToStr(LI);
    end;
  end;
  return LText;
end;

begin
  GSet := [GA..GB];
  println("{}", Members(GSet));
  GSet := [0..GA - 1, GB + 1..6, GA];
  println("{}", Members(GSet));
  GSet := [GB..GA];
  println("empty {}", GSet = []);
  GL := [GLow..GHigh];
  println("{} {} {} {}", 'a' in GL, 'b' in GL, 'd' in GL,
    'e' in GL);
  GC := [GFirst..TColor.Blue];
  println("{} {} {} {}", TColor.Red in GC, TColor.Green in GC,
    TColor.Blue in GC, TColor.Gray in GC);
  GSet := [1, GA + 1..GB, 7];
  println("{}", Members(GSet));
  for GK := 0 to 2 do
    GSet := [GK..GK + 1];
    println("pass {}: {}", GK, Members(GSet));
  end;
  guard
    GSet := [GA - 3..GB];
  except
    println("low {}: {}", exccode(), excmsg());
  end;
  guard
    GSet := [GA..GB * 8];
  except
    println("high {}: {}", exccode(), excmsg());
  end;
  GSet := [GB * 8..GA - 3];
  println("outside empty {}", GSet = []);
end.
