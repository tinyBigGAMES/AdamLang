-------------------------------------------------------------------------------
  agg_ptr.adam - Aggregates: pointers (M3.5a). A local and a module
  variable read and written through `addr of` / `&` and both deref forms
  (`P^`, `*P`, compound and stepped); a heap block of int32 indexed (`P[i]`,
  a negative index, an index of a moved ptr), moved (`ptr + n`, `n + ptr`,
  `ptr - n`, `+=`, `-=`, `++`, `--`) and measured (`ptr - ptr`, both
  signs); int16, uint8 and int64 views of the same bytes (each scaled by
  its own element size); `addr of` an element and of a deref. Values are
  shown through ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 7
  | 10
  | -4
  | 42
  | 30
  | 70
  | 20
  | 10
  | 6
  | -6
  | 70
  | 60
  | 90
  | 0
  | 50
  | 30
  | 10
  | -65526
  | 20
  | 8
  | 4
  | 4
  | 2
  | 214748364840
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_ptr;

func malloc(const ASize: uint64): ptr; external "ucrtbase";
func puts(const AText: ptr): int32; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

var
  GCount: int32 = 41;

// AValue in decimal, one line
func ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

func Run();
var
  LX: int32;
  LY: int32;
  LI: int32;
  LP: ptr to int32;
  LQ: ptr to int32;
  LW: ptr to int16;
  LB: ptr to uint8;
  LL: ptr to int64;
begin
  // A local through addr of and both deref forms
  LX := 5;
  LP := addr of LX;
  LP^ := LP^ + 2;
  ShowInt(LX);
  *LP += 3;
  ShowInt(LX);
  LP := &LY;
  LP^ := -4;
  ShowInt(LY);

  // A module variable through addr of, stepped through the ptr
  LP := addr of GCount;
  ++LP^;
  ShowInt(GCount);

  // A heap block of ten int32: indexed, moved, stepped, measured
  LP := ptr to int32(malloc(40));
  for LI := 0 to 9 do
    LP[LI] := LI * 10;
  end;
  ShowInt(LP[3]);
  LQ := LP + 7;
  ShowInt(LQ^);
  LQ := 2 + LP;
  ShowInt(*LQ);
  LQ := LQ - 1;
  ShowInt(LQ^);
  LQ := LP + 6;
  ShowInt(LQ - LP);
  ShowInt(LP - LQ);
  ++LQ;
  ShowInt(LQ^);
  LQ--;
  ShowInt(LQ^);
  LQ += 3;
  ShowInt(LQ^);
  LQ -= 9;
  ShowInt(LQ^);
  ShowInt((LQ + 4)[1]);
  LQ := LP + 5;
  ShowInt(LQ[-2]);

  // Views of the same bytes, each scaled by its own element size
  LW := ptr to int16(LP);
  ShowInt(LW[2]);
  LW[3] := -1;
  ShowInt(LP[1]);
  LB := ptr to uint8(LP + 2);
  ShowInt(LB[0]);
  ShowInt(LB - ptr to uint8(LP));

  // addr of an element and of a deref
  LQ := addr of LP[4];
  ShowInt(LQ - LP);
  LQ := addr of LQ^;
  ShowInt(LQ - LP);

  // An int64 view: two elements apart is 16 bytes, an element spans two int32
  ShowInt(ptr to int64(LP + 4) - ptr to int64(LP));
  LL := ptr to int64(LP);
  ShowInt(LL[2]);
end;

begin
  Run();
end.
