-------------------------------------------------------------------------------
  agg_overlay.adam - Aggregates: overlays and anonymous parts (M3.5d). An
  overlay local starts zeroed in every byte, a wide field that is not the
  first included, even in a frame another routine just filled with -1;
  field offsets read back through `addr of` against the C layout on Win64
  (every field of an overlay at its start, an anonymous record inside an
  overlay, an anonymous overlay in a record, and record > overlay > record
  > overlay nested, the only nesting BNF allows: a record holds anonymous
  overlays, an overlay anonymous records); a field read through another of
  the overlay, at every level of that nesting; `->` and `P^.F` on an
  overlay; a whole overlay copied by `:=`, independent of its source; an
  anonymous overlay's neighbours untouched by its writes; module variables
  zeroed, written through one field, read through another. Values are
  shown through ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0
  | 0
  | 0
  | 0
  | 0
  | 4
  | 8
  | 8
  | 16
  | 8
  | 12
  | 16
  | 136
  | 30600
  | 1432778632
  | 287454020
  | 8589934593
  | 8589934847
  | 2
  | 0
  | -1
  | -65536
  | 5
  | 6
  | 44
  | 300
  | 1288490188809
  | 0
  | 0
  | 0
  | 65535
  | [Adam Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_overlay;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  TWord = overlay
    I: int64;
    B: uint8;
    W: uint16;
    record
      Lo: uint32;
      Hi: uint32;
    end;
  end;

  TSmallFirst = overlay
    B: uint8;
    Q: int64;
  end;

  TTagged = record
    Tag: int8;
    overlay
      L: int64;
      S: int16;
    end;
    After: int32;
  end;

  TDeep = record
    K: int16;
    overlay
      record
        M: int8;
        overlay
          N: int32;
          P: int8;
        end;
      end;
      Wide: int64;
    end;
    Z: int8;
  end;

  TDirty = record
    A: int64;
    B: int64;
    C: int64;
    D: int64;
  end;

var
  GWord: TWord;
  GTag: TTagged;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// The bytes from ARecord's start to AField
routine Gap(const AField: ptr; const ARecord: ptr): int64;
begin
  return ptr to uint8(AField) - ptr to uint8(ARecord);
end;

// Fills a frame's worth of stack with -1: the stack Fresh() reuses next
routine Dirty();
var
  LD: TDirty;
begin
  LD.A := -1;
  LD.B := -1;
  LD.C := -1;
  LD.D := -1;
end;

// An overlay local whose wide field is not its first: every byte reads 0
routine Fresh();
var
  LS: TSmallFirst;
begin
  ShowInt(LS.Q);
  ShowInt(LS.B);
end;

routine Run();
var
  LW: TWord;
  LW2: TWord;
  LT: TTagged;
  LD: TDeep;
  LPw: ptr to TWord;
begin
  // An overlay local starts zeroed in every byte
  ShowInt(LW.I);
  ShowInt(LW.Hi);
  Dirty();
  Fresh();

  // Offsets: every field of an overlay at its start, anonymous parts as members
  ShowInt(Gap(addr of LW.W, addr of LW));
  ShowInt(Gap(addr of LW.Hi, addr of LW));
  ShowInt(Gap(addr of LT.L, addr of LT));
  ShowInt(Gap(addr of LT.S, addr of LT));
  ShowInt(Gap(addr of LT.After, addr of LT));
  ShowInt(Gap(addr of LD.M, addr of LD));
  ShowInt(Gap(addr of LD.N, addr of LD));
  ShowInt(Gap(addr of LD.Z, addr of LD));

  // A field read through another of the overlay (0x1122334455667788)
  LW.I := 1234605616436508552;
  ShowInt(LW.B);
  ShowInt(LW.W);
  ShowInt(LW.Lo);
  ShowInt(LW.Hi);
  LW.Lo := 1;
  LW.Hi := 2;
  ShowInt(LW.I);

  // Through a ptr: `->` writes, `P^.F` reads
  LPw := addr of LW;
  LPw->B := 255;
  ShowInt(LPw^.I);

  // A whole overlay copied by `:=`, independent of its source
  LW2 := LW;
  LW.I := 0;
  ShowInt(LW2.Hi);
  ShowInt(LW.Hi);

  // An anonymous overlay in a record: shared storage, its neighbours untouched
  LT.Tag := 5;
  LT.After := 6;
  LT.L := -1;
  ShowInt(LT.S);
  LT.S := 0;
  ShowInt(LT.L);
  ShowInt(LT.Tag);
  ShowInt(LT.After);

  // An anonymous overlay inside an anonymous record inside an anonymous overlay: its
  // fields read alone and through the outer overlay's wide field
  LD.N := 300;
  LD.M := 9;
  LD.Z := 10;
  ShowInt(LD.P);
  ShowInt(LD.N);
  ShowInt(LD.Wide);
  ShowInt(LD.K);

  // Module variables: zeroed in every byte, written through one field, read through another
  ShowInt(GTag.L);
  ShowInt(GWord.Hi);
  GWord.W := 65535;
  ShowInt(GWord.I);
end;

begin
  Run();
end.
