  agg_err_set_literal_kind.adam - Break step of set literals (AUD5): every
  element is of an ordinal type and all of one family (integers of any
  width are one): SM0266 at the first that is not, the literal's one
  report (pcpp's rule), before the set's own element type is asked.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_set_literal_kind;

type
  Digits = set of 0..9;

var
  LD: Digits;
  LSmall: int8 = 3;

begin
  LD := [1, 'a']; // ERROR SM0266@13
  LD := [1.5]; // ERROR SM0266@10
  LD := [1, LSmall, 2 .. 4];
  println("{}", 3 in LD);
end.
