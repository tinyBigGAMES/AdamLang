  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  agg_set_item.adam - A set literal's item that is not constant (PLAN-SELFHOST
  S4, BNF sec 4): the literal is built when it runs, its constant items and
  spans beside the computed ones. A computed item alone, mixed with constant
  ones and a span, twice; in += and -=; in a loop (the literal starts empty
  each pass: the masks sum to 255); compared with a set; a member in a set's
  second word; a choices item; Adam's own forms (`self.Flags += [AFlag]` in a
  method, `AFlags += [LFlag]` on a var parameter); an unsigned item. Values
  are shown through ucrtbase (_i64toa + puts); agg_set_item_range and
  agg_set_item_below show an item outside the set.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 8
  | 107
  | 8
  | 10
  | 2
  | 255
  | 1
  | 0
  | 1
  | 0
  | 1
  | 0
  | 1
  | 1
  | 0
  | 1
  | 1
  | 0
  | 16
  | [Adam Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_set_item;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  TSmall = set of 0..7;
  TMid = set of 1..100;
  TColor = choices(Red, Green, Blue);
  TColors = set of TColor;
  TFlag = choices(Done, Open, Hidden, Moved);
  TFlags = set of TFlag;

  TNode = object
    Flags: TFlags;

    // Adam's AST form: a flag added through self
    method AddFlag(const AFlag: TFlag);
    begin
      self.Flags += [AFlag];
    end;
  end;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AB as 1 or 0, one line
routine ShowBool(const AB: bool);
begin
  if AB then
    ShowInt(1);
  else
    ShowInt(0);
  end;
end;

// AS's members as a mask: bit N set when N is a member
routine Bits(const AS: TSmall): int64;
var
  LX: int32;
  LBits: int64;
begin
  LBits := 0;
  for LX := 0 to 7 do
    if LX in AS then
      LBits += 1 shl LX;
    end;
  end;
  return LBits;
end;

// Adam's parser form: a flag added to a var parameter's set
routine AddTo(var AFlags: TFlags; const AFlag: TFlag);
var
  LFlag: TFlag;
begin
  LFlag := AFlag;
  AFlags += [LFlag];
end;

routine Run();
var
  LS: TSmall;
  LM: TMid;
  LK: TColors;
  LFlags: TFlags;
  LNode: TNode;
  LX: int32;
  LY: int32;
  LZ: int32;
  LI: int32;
  LTotal: int64;
  LColor: TColor;
  LU: uint8;
begin
  // a computed item alone, beside constant items and a span, twice
  LX := 3;
  LY := 6;
  LS := [LX];
  ShowInt(Bits(LS));
  LS := [0, LX, 5..6, LY - 5];
  ShowInt(Bits(LS));
  LS := [LX, LX];
  ShowInt(Bits(LS));

  // the compound forms
  LS := [1];
  LS += [LX];
  ShowInt(Bits(LS));
  LS -= [LX];
  ShowInt(Bits(LS));

  // in a loop: built empty each pass, so one bit each time
  LTotal := 0;
  for LI := 0 to 7 do
    LS := [LI];
    LTotal := LTotal + Bits(LS);
  end;
  ShowInt(LTotal);

  // compared with a set
  LS := [LX];
  ShowBool(LS = [LX]);
  LS := [LY];
  ShowBool(LS = [LX]);

  // a member in the second word of a set of 1..100
  LZ := 70;
  LM := [LZ];
  ShowBool(70 in LM);
  ShowBool(69 in LM);

  // a choices item
  LColor := TColor.Green;
  LK := [LColor, TColor.Red];
  ShowBool(TColor.Green in LK);
  ShowBool(TColor.Blue in LK);
  ShowBool(TColor.Red in LK);

  // Adam's own forms
  LNode.AddFlag(TFlag.Open);
  LNode.AddFlag(TFlag.Moved);
  ShowBool(TFlag.Open in LNode.Flags);
  ShowBool(TFlag.Done in LNode.Flags);
  ShowBool(TFlag.Moved in LNode.Flags);
  AddTo(LFlags, TFlag.Hidden);
  AddTo(LFlags, TFlag.Hidden);
  ShowBool(TFlag.Hidden in LFlags);
  ShowBool(TFlag.Open in LFlags);

  // an unsigned item
  LU := 4;
  LS := [LU];
  ShowInt(Bits(LS));
end;

begin
  Run();
end.
