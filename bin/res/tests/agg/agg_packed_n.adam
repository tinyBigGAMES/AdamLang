-------------------------------------------------------------------------------
  agg_packed_n.adam - packed(N) (M9e0d, BNF sec 4, his OK 2026-11-16), C's
  #pragma pack(N): every field, parent part and anonymous part aligns to at
  most N (1 2 4 8 16, a constant too), so the record aligns to the smaller
  of its natural alignment and N; align(n) still raises the result; an
  anonymous or inline record takes the tighter of its own N and its
  container's. A field whose type aligns to N or less is never misaligned:
  a var argument takes it, and a string is a field of packed(8). Read back
  as the record's raw bytes.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 14 1 2 3
  | 16 1 2 4 4
  | 16 2
  | 16 hi
  | 16 5 6
  | 8 1 2
  | 8 1 2 3
  | 6 1 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_packed_n;

const
  PACK_FOUR: int32 = 4;

type
  // capped at 2: I at 2, Q at 6, size 14
  TTwo = record packed(2)
    C: int8;
    I: int32;
    Q: int64;
  end;

  // a constant N: Q at 4, H at 12, size 16
  TFour = record packed(PACK_FOUR)
    C: int8;
    Q: int64;
    H: int32;
  end;

  // N above every field's alignment changes nothing: Q at 8
  TSixteen = record packed(16)
    C: int8;
    Q: int64;
  end;

  // packed(8) keeps a string at its alignment
  TNamed = record packed(8)
    C: int8;
    S: string;
  end;

  TInner = record
    I: int32;
    W: int16;
  end;

  // a record field at its capped alignment (N at 2, data 10), then align(8) raises the
  // whole: size 16
  TNest = record packed(2) align(8)
    C: int8;
    N: TInner;
  end;

  // an anonymous packed(2) record in an overlay: I at 2
  TOver = overlay
    record packed(2)
      C: int8;
      I: int32;
    end;
    Q: int64;
  end;

  // an inline packed(2) record: R at 2 (its alignment 2), R.I at 4
  THold = record
    B: int8;
    R: record packed(2)
      C: int8;
      I: int32;
    end;
  end;

  // an anonymous record's own packed(4) inside packed: the tighter, 1 (C at 1, I at 2)
  TTight = record packed
    D: int8;
    overlay
      record packed(4)
        C: int8;
        I: int32;
      end;
    end;
  end;

func Bump(var AN: int32);
begin
  AN += 1;
end;

var
  LTwo: TTwo;
  LFour: TFour;
  LSixteen: TSixteen;
  LNamed: TNamed;
  LNest: TNest;
  LOver: TOver;
  LHold: THold;
  LTight: TTight;
  LRaw: ptr to uint8;

begin
  LTwo.C := 1;
  LTwo.I := 2;
  LTwo.Q := 3;
  LRaw := ptr to uint8(addr of LTwo);
  println("{} {} {} {}", size(TTwo), LRaw[0], LRaw[2], LRaw[6]);

  LFour.C := 1;
  LFour.Q := 2;
  LFour.H := 3;
  // H aligns to 4, within packed(4): a var argument takes it
  Bump(LFour.H);
  LRaw := ptr to uint8(addr of LFour);
  println("{} {} {} {} {}", size(TFour), LRaw[0], LRaw[4], LRaw[12], LFour.H);

  LSixteen.Q := 2;
  LRaw := ptr to uint8(addr of LSixteen);
  println("{} {}", size(TSixteen), LRaw[8]);

  LNamed.S := "hi";
  println("{} {}", size(TNamed), LNamed.S);

  LNest.N.I := 5;
  LNest.N.W := 6;
  LRaw := ptr to uint8(addr of LNest);
  println("{} {} {}", size(TNest), LRaw[2], LRaw[6]);

  LOver.C := 1;
  LOver.I := 2;
  LRaw := ptr to uint8(addr of LOver);
  println("{} {} {}", size(TOver), LRaw[0], LRaw[2]);

  LHold.B := 1;
  LHold.R.C := 2;
  LHold.R.I := 3;
  LRaw := ptr to uint8(addr of LHold);
  println("{} {} {} {}", size(THold), LRaw[0], LRaw[2], LRaw[4]);

  LTight.C := 1;
  LTight.I := 2;
  LRaw := ptr to uint8(addr of LTight);
  println("{} {} {}", size(TTight), LRaw[1], LRaw[2]);
end.
