-------------------------------------------------------------------------------
  agg_set_item_below.adam - A set literal's computed item below its set's
  members (PLAN-SELFHOST S4, twin of agg_set_item_range): a negative value
  in a set of 1..100, in a += on the set, raises EXC_SET_RANGE (11) with
  the value as it is; the set is not changed.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 1
  | start
  | unhandled exception 11: set element -1 is out of range 1..100
@@end
*/

module exe agg_set_item_below;

type
  TMid = set of 1..100;

routine Run();
var
  LM: TMid;
  LX: int32;
begin
  LX := -1;
  println("start");
  LM += [LX];
  println("not reached");
end;

begin
  Run();
end.
