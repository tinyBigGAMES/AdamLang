-------------------------------------------------------------------------------
  agg_err_array_literal.adam - Break step of agg_array_literal (BNF sec 6,
  H4u4). A static array's literal takes exactly its range's count (SM0705
  names both counts, too few and too many); an element is one value, never a
  range a..b (SM0706); an element converts to the element type (SM0200); in
  a const every element folds (SM0202 at the one that does not, a record
  literal's field inside too); a set literal takes no comma before its `]`
  (SM0707, where it meets a set type and on the right of `in`).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_array_literal;

type
  Point = record
    X: int32;
    Y: int32;
  end;

  Triple = array[0..2] of int32;
  Small = set of 0..7;

var
  GValue: int32 = 4;

const
  Bad: array[0..1] of int32 = [1, GValue]; // ERROR SM0202@35: a const array literal's element must be a constant
  BadPoints: array[0..0] of Point = [Point(X: 1, Y: GValue)]; // ERROR SM0202@53: a const array literal's element must be a constant

routine Run();
var
  LT: Triple;
  LS: Small;
  LD: array of int32;
begin
  LT := [1, 2]; // ERROR SM0705@9: an array literal of 2 elements for 'array[0..2] of int32', which takes 3
  LT := [1, 2, 3, 4]; // ERROR SM0705@9: an array literal of 4 elements for 'array[0..2] of int32', which takes 3
  LT := [1..2, 3, 4]; // ERROR SM0706@10: an array literal's element is one value, not a range
  LD := [1, "x", 3]; // ERROR SM0200@13: 'string' does not convert implicitly to 'int32'
  LS := [1, 2,]; // ERROR SM0707@9: a set literal takes no comma before its ']'
  if 3 in [1, 2,] then // ERROR SM0707@11: a set literal takes no comma before its ']'
    LD := [];
  end;
end;

begin
  Run();
end.
