-------------------------------------------------------------------------------
  agg_err_inline.adam - Break step of agg_inline (BNF sec 4 inline record /
  inline overlay, TODO 6): each inline type is its own type, named by its
  member path, so two of one shape do not convert (SM0200); an inline
  overlay holding a string (SM0313); a field an inline type does not have
  (SM0009); an inline overlay written 'packed' (PR0033).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_inline;

type
  TPair = record
    A: record
      X: int32;
    end;
    B: record
      X: int32;
    end;
  end;

  TBad = record
    V: overlay
      S: string; // ERROR SM0313@7: field 'S' of 'TBad.V' cannot share an overlay's storage: 'string' holds a string or dynamic array, hold a ptr to it
    end;
  end;

  TWord = record
    W: overlay packed // ERROR PR0033@16: 'packed' is not written on an overlay
      I: int64;
    end;
  end;

var
  GPair: TPair;
  GValue: int32;

begin
  GPair.A := GPair.B; // ERROR SM0200@14: 'TPair.B' does not convert implicitly to 'TPair.A'
  GValue := GPair.A.Y; // ERROR SM0009@21: 'TPair.A' has no member 'Y'
end.
