-------------------------------------------------------------------------------
  agg_inline.adam - Aggregates: a named field of an inline type (BNF sec 4
  inline record / inline overlay, TODO 6), C's `union { .. } u;`. A
  record's inline overlay holding inline records lays out as C does
  (offsets read back through `addr of`: the overlay at 8, its records at
  its start, the field after it at 24, the record 32 bytes); a value
  written through one member is read through another (U.I over U.Pair); a
  packed inline record has no padding; a whole record copied by `:=`
  copies its inline parts, an inline part assigned whole by `:=` from
  another value of the same field's type; an inline record holding a
  string keeps it managed (copied, released: nothing leaked); an object's
  field of an inline record.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | offset U 8
  | offset U.Str.N 8
  | offset U.Pair.B 2
  | offset After 24
  | size 32
  | pair 7 5
  | low 327687
  | str 9
  | packed 1
  | copy 9 4
  | whole 11
  | name ab 3 / abc 3
  | box 42
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_inline;

type
  TDatum = record
    Tag: int32;
    U: overlay
      I: int64;
      Str: record
        P: ptr;
        N: int32;
      end;
      Pair: record
        A: int16;
        B: int16;
      end;
    end;
    After: int8;
  end;

  TTight = record
    Head: uint8;
    Body: record packed
      A: uint8;
      B: int32;
    end;
  end;

  TNamed = record
    Info: record
      Name: string;
      Count: int64;
    end;
  end;

  TBox = object
    Inner: record
      V: int32;
    end;
  end;

// The offset of the place AField from the place ABase holding it, in bytes
routine Offset(const AField: ptr; const ABase: ptr): int64;
begin
  return ptr to uint8(AField) - ptr to uint8(ABase);
end;

routine Tests();
var
  LD: TDatum;
  LE: TDatum;
  LT: TTight;
  LN: TNamed;
  LM: TNamed;
  LBox: TBox;
begin
  println("offset U {}", Offset(addr of LD.U, addr of LD));
  println("offset U.Str.N {}", Offset(addr of LD.U.Str.N, addr of LD.U));
  println("offset U.Pair.B {}", Offset(addr of LD.U.Pair.B, addr of LD.U));
  println("offset After {}", Offset(addr of LD.After, addr of LD));
  println("size {}", size(TDatum));
  LD.U.Pair.A := 7;
  LD.U.Pair.B := 5;
  println("pair {} {}", LD.U.Pair.A, LD.U.Pair.B);
  println("low {}", LD.U.I & 4294967295);
  LD.U.Str.N := 9;
  println("str {}", LD.U.Str.N);
  println("packed {}", Offset(addr of LT.Body.B, addr of LT.Body));
  LE := LD;
  LD.U.Str.N := 4;
  println("copy {} {}", LE.U.Str.N, LD.U.Str.N);
  LE.U.Str.N := 11;
  LD.U := LE.U;
  println("whole {}", LD.U.Str.N);
  LN.Info.Name := "a" + "b";
  LN.Info.Count := 3;
  LM := LN;
  LN.Info.Name := LN.Info.Name + "c";
  println("name {} {} / {} {}", LM.Info.Name, LM.Info.Count, LN.Info.Name, LN.Info.Count);
  LBox.Inner.V := 42;
  println("box {}", LBox.Inner.V);
end;

begin
  Tests();
end.
