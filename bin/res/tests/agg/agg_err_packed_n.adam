-------------------------------------------------------------------------------
  agg_err_packed_n.adam - Break step of packed(N) (M9e0d, BNF sec 4): N is a
  constant (SM0202) of 1 2 4 8 16 (SM0732); a field whose type aligns above
  N may be misaligned (SM0270 for addr of / a var argument), one at or
  below N is not; a string a packed(N) record may misalign is SM0331;
  packed(N) on an overlay is PR0033 as plain packed is.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_packed_n;

var
  GN: int32;

type
  TThree = record packed(3) // ERROR SM0732@26: packed(3) caps field alignment at 1, 2, 4, 8 or 16 (#pragma pack's values)
    C: int8;
  end;

  TBig = record packed(32) // ERROR SM0732@24: packed(32) caps field alignment at 1, 2, 4, 8 or 16 (#pragma pack's values)
    C: int8;
  end;

  TVar = record packed(GN) // ERROR SM0202@24
    C: int8;
  end;

  TTwo = record packed(2)
    C: int8;
    W: int16;
    I: int32;
  end;

  TNamed = record packed(4)
    C: int8;
    S: string; // ERROR SM0331@5: field 'S' of packed record 'TNamed' cannot be packed: 'string' holds a string or dynamic array
  end;

  TOver = overlay packed(2) // ERROR PR0033@19
    I: int32;
  end;

func Bump(var AN: int32);
begin
  AN += 1;
end;

var
  LTwo: TTwo;
  LW: ptr to int16;
  LI: ptr to int32;

begin
  LW := addr of LTwo.W;
  LI := addr of LTwo.I; // ERROR SM0270@17
  Bump(LTwo.I); // ERROR SM0270@8
end.
