-------------------------------------------------------------------------------
  agg_addr_const.adam - `addr of` a place that cannot be assigned (BNF sec
  4, user 2026-11-12): an element of a const parameter gives a ptr to const
  that shares the block as it is, so two holders of one dynamic array (or
  one string) get the same address and nothing is copied; a read goes
  through it. An assignable place's address still makes the block its
  holder's alone first (copy on write): the write leaves the other holder
  as it was, and the two then have different blocks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | bytes shared
  | read 7
  | after write 7 9
  | bytes apart
  | text shared
  | text read 1
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_addr_const;

import System.SysUtils;

type
  Bytes = array of uint8;

// The address of ABytes' first element: a const parameter's, so a ptr to const
func BytesAt(const ABytes: Bytes): ptr to const uint8;
begin
  return addr of ABytes[0];
end;

// The address of AText's first char, likewise
func TextAt(const AText: string): ptr to const char;
begin
  return addr of AText[0];
end;

// "shared" when AA and AB are one address, else "apart" (the second word given)
func Told(const AA: ptr to const uint8; const AB: ptr to const uint8;
  const AApart: string): string;
begin
  if AA = AB then
    return "shared";
  end;
  return AApart;
end;

func Main();
var
  LA: Bytes;
  LB: Bytes;
  LW: ptr to uint8;
  LS: string;
  LT: string;
begin
  setlength(LA, 4);
  LA[0] := 7;
  // Two holders of one block
  LB := LA;
  println("bytes {}", Told(BytesAt(LA), BytesAt(LB), "copied"));
  println("read {}", BytesAt(LB)^);
  // An assignable element's address: LB's block made its own before the write
  LW := addr of LB[0];
  LW^ := 9;
  println("after write {} {}", LA[0], LB[0]);
  println("bytes {}", Told(BytesAt(LA), BytesAt(LB), "apart"));
  // A string made at run time (a heap block), held twice
  LS := IntToStr(12345);
  LT := LS;
  if TextAt(LS) = TextAt(LT) then
    println("text shared");
  else
    println("text copied");
  end;
  println("text read {}", TextAt(LT)^);
end;

begin
  Main();
end.
