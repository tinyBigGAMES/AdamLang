-------------------------------------------------------------------------------
  agg_err_flexible.adam - Break step of agg_flexible (M9e0b, BNF sec 4): a
  flexible array member starts at 0 (SM0726), holds plain data (SM0727), is
  only a named record's last field (SM0728: not last, in an overlay, a
  variable's type); a record ending in one is no field or array element
  (SM0729); the member is only indexed (SM0730: a copy, len, addr of it).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_flexible;

type
  TLow = record
    N: int32;
    D: array[1..] of int32; // ERROR SM0726@14: a flexible array member starts at 0: write array[0..] of int32
  end;

  TText = record
    N: int32;
    D: array[0..] of string; // ERROR SM0727@22: a flexible array member's elements are plain data: 'string' holds a string, dynamic array, object or owner
  end;

  TMiddle = record
    D: array[0..] of int32; // ERROR SM0728@8: array[0..] of int32 is a flexible array member: only a record's last field has that type
    N: int32;
  end;

  TShare = overlay
    N: int32;
    D: array[0..] of int32; // ERROR SM0728@8: array[0..] of int32 is a flexible array member: only a record's last field has that type
  end;

  TGood = record
    N: int32;
    D: array[0..] of int32;
  end;

  THolder = record
    G: TGood; // ERROR SM0729@8: 'TGood' ends in a flexible array member: it is no field or array element, reach it through a ptr
  end;

  TMany = array[0..3] of TGood; // ERROR SM0729@26: 'TGood' ends in a flexible array member: it is no field or array element, reach it through a ptr

var
  LLoose: array[0..] of int32; // ERROR SM0728@11: array[0..] of int32 is a flexible array member: only a record's last field has that type
  LP: ptr to TGood;
  LQ: ptr to int32;
begin
  LP := nil;
  LQ := addr of LP^.D; // ERROR SM0730@17: the flexible array member 'D' has no size: only an index takes it (D[i]; addr of D[0] is where it starts)
  println("{}", len(LP^.D)); // ERROR SM0730@21: the flexible array member 'D' has no size: only an index takes it (D[i]; addr of D[0] is where it starts)
  LQ := addr of LP^.D[0];
end.
