-------------------------------------------------------------------------------
  agg_record.adam - Aggregates: records (M3.5b). A record local starts
  zeroed; field offsets read back through `addr of` against the C layout
  on Win64 (a parent's fields first, a nested record at its alignment);
  fields written and read by name, through `->`, through `P^.F` (a compound
  form too) and in a module variable; a whole record copied by `:=` and by
  a local's initializer from a deref, each copy independent of its source;
  a nested record assigned whole; a module variable initialized from
  another; a packed record's fields at unaligned offsets, checked byte by
  byte. Values are shown through ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0
  | 0
  | 0
  | 4
  | 8
  | 16
  | 8
  | 12
  | 11
  | -3
  | 300
  | 5000000000
  | 7
  | 5000000005
  | 11
  | 5000000005
  | 99
  | -3
  | 21
  | 22
  | 3
  | 77
  | 77
  | 5
  | 0
  | 68
  | 17
  | 254
  | 287454020
  | -2
  | [Adam Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_record;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  TBase = record
    A: int32;
    B: int8;
  end;

  TChild = record(TBase)
    C: int16;
    D: int64;
  end;

  TOuter = record
    X: int8;
    Inner: TBase;
    Y: int32;
  end;

  TPacked = record packed
    A: int8;
    B: int32;
    C: int16;
  end;

var
  GRec: TChild;
  GPtr: ptr to TChild;
  GBase: TBase;
  GCopy: TBase = GBase;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// The bytes from ARecord's start to AField
routine Gap(const AField: ptr; const ARecord: ptr): int64;
begin
  return ptr to uint8(AField) - ptr to uint8(ARecord);
end;

routine Run();
var
  LZ: TChild;
  LC: TChild;
  LC2: TChild;
  LB: TBase;
  LO: TOuter;
  LPk: TPacked;
  LPc: ptr to TChild;
  LBp: ptr to uint8;
  LFrom: TChild = GPtr^;
begin
  // A record local starts zeroed
  ShowInt(LZ.A);
  ShowInt(LZ.D);

  // Offsets: a parent's fields first, then the child's, each at its alignment
  ShowInt(Gap(addr of LC.A, addr of LC));
  ShowInt(Gap(addr of LC.B, addr of LC));
  ShowInt(Gap(addr of LC.C, addr of LC));
  ShowInt(Gap(addr of LC.D, addr of LC));
  ShowInt(Gap(addr of LO.Inner.B, addr of LO));
  ShowInt(Gap(addr of LO.Y, addr of LO));

  // Fields written and read by name
  LC.A := 11;
  LC.B := -3;
  LC.C := 300;
  LC.D := 5000000000;
  ShowInt(LC.A);
  ShowInt(LC.B);
  ShowInt(LC.C);
  ShowInt(LC.D);

  // Through -> and P^.F, a compound form among them
  LPc := addr of LC;
  LPc->C := 7;
  ShowInt(LC.C);
  LPc^.D += 5;
  ShowInt(LC.D);
  ShowInt(LPc->A);

  // A whole copy, independent of its source
  LC2 := LC;
  LC2.D := 99;
  ShowInt(LC.D);
  ShowInt(LC2.D);
  ShowInt(LC2.B);

  // A nested record assigned whole
  LB.A := 21;
  LB.B := 22;
  LO.Inner := LB;
  LO.X := 1;
  LO.Y := 2;
  LB.A := 0;
  ShowInt(LO.Inner.A);
  ShowInt(LO.Inner.B);
  ShowInt(LO.X + LO.Y);

  // A local's initializer copied from a deref, independent of its source
  ShowInt(LFrom.D);
  LFrom.D := 1;
  ShowInt(GRec.D);

  // A module variable's field; a module variable initialized from another
  GRec.C := 5;
  ShowInt(GRec.C);
  ShowInt(GCopy.A);

  // A packed record: B at bytes 1..4, C at 5..6
  LPk.A := 1;
  LPk.B := 287454020;
  LPk.C := -2;
  LBp := ptr to uint8(addr of LPk);
  ShowInt(LBp[1]);
  ShowInt(LBp[4]);
  ShowInt(LBp[5]);
  ShowInt(LPk.B);
  ShowInt(LPk.C);
end;

begin
  GRec.D := 77;
  GPtr := addr of GRec;
  Run();
end.
