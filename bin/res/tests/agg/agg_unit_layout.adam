-------------------------------------------------------------------------------
  agg_unit_layout.adam - a unit's types whose layout reads constants (bitfield
  widths, packed(N), align(N), an anonymous part's packed(N)) laid out alike
  in the module that imports them: those constants are folded before any
  module lays a type out (M9e: main's size(T) of a unit's T came before the
  unit's own walk, so its bitfields took a unit each and packed(N) was 1)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 4 6 16 12
  | 6 21 -5
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe agg_unit_layout;

@addmodulepath "$P:res/tests/agg/fixtures";

import AggLayoutUnit;

var
  LFlags: UFlags;
begin
  println("{} {} {} {}", size(UFlags), size(UPacked), size(UAligned), size(UPart));
  LFlags.a := 6;
  LFlags.b := 21;
  LFlags.c := -5;
  println("{} {} {}", LFlags.a, LFlags.b, LFlags.c);
end.
