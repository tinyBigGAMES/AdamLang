-------------------------------------------------------------------------------
  agg_bits.adam - Aggregates: bitfields (M3.5e). Each lane width (8, 16, 32,
  64 bits) is viewed through an overlay's raw field, so every write is
  checked bit for bit against the Microsoft rule's layout, neighbours
  included; signed fields read sign-extended, unsigned ones zero-extended;
  a store keeps the value's low bits (a runtime int8 9 into int8 : 4 reads
  -7); `+=`, `-=`, `*=`, postfix and prefix steps wrap at the field's width
  (a prefix step's value is the field after the store); full-width fields
  (int64 : 40 at its maximum, int32 : 32); bool, char, wchar and choices
  bitfields sharing and starting lanes; a module variable's bitfield; a
  bitfield written through `->`. Values are shown through ucrtbase
  (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 237
  | 5
  | -3
  | 1
  | -7
  | 205
  | -6
  | -6
  | -5
  | -8
  | 0
  | 192
  | 7
  | 65520
  | -16
  | 2047
  | 15
  | 65519
  | 120
  | 47
  | 4294967295
  | 2148532223
  | -2048
  | 1048575
  | 1048574
  | 1099511627775
  | -1
  | -1
  | 16777215
  | 549755813887
  | -549755813888
  | 16777215
  | -20
  | 1
  | -20
  | 511
  | 0
  | -2
  | -1
  | -123456789
@@end
*/

module exe agg_bits;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  // One byte: A bits 0-2, B 3-6, T 7
  TLane8 = overlay
    record
      A: uint8 : 3;
      B: int8 : 4;
      T: uint8 : 1;
    end;
    Raw: uint8;
  end;

  // Two bytes: C bits 0-4, D 5-15
  TLane16 = overlay
    record
      C: int16 : 5;
      D: uint16 : 11;
    end;
    Raw: uint16;
  end;

  // Four bytes, two types of one size sharing the lane: Lo bits 0-19, Hi 20-31
  TLane32 = overlay
    record
      Lo: uint32 : 20;
      Hi: int32 : 12;
    end;
    Raw: uint32;
  end;

  // Eight bytes: G bits 0-39, H 40-63
  TLane64 = overlay
    record
      G: int64 : 40;
      H: uint64 : 24;
    end;
    Raw: uint64;
  end;

  TTri = choices(Low = -2, Mid, High);

  // Flag and Ch share byte 0 (bits 0, 1-6), W starts a wchar lane at 2, Tri a choices
  // lane at 4, Full a new int32 lane at 8 (32 more bits do not fit Tri's)
  TMixed = record
    Flag: bool : 1;
    Ch: char : 6;
    W: wchar : 9;
    Tri: TTri : 2;
    Full: int32 : 32;
  end;

var
  GBits: TLane8;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// An 8-bit lane: signed and unsigned fields, a runtime store, compounds and steps
routine Lane8();
var
  L8: TLane8;
  LN: int8;
begin
  L8.A := 5;
  L8.B := -3;
  L8.T := 1;
  ShowInt(L8.Raw);
  ShowInt(L8.A);
  ShowInt(L8.B);
  ShowInt(L8.T);
  LN := 9;
  L8.B := LN;
  ShowInt(L8.B);
  ShowInt(L8.Raw);
  L8.B += 1;
  ShowInt(L8.B);
  ShowInt(L8.B++);
  ShowInt(L8.B);
  L8.B := 7;
  ShowInt(++L8.B);
  L8.A := 7;
  L8.A += 1;
  ShowInt(L8.A);
  ShowInt(L8.Raw);
  L8.A--;
  ShowInt(L8.A);
end;

// A 16-bit lane: the signed field's minimum, the unsigned one's maximum, a wrap
routine Lane16();
var
  L16: TLane16;
  LP: ptr to TLane16;
begin
  L16.C := -16;
  L16.D := 2047;
  ShowInt(L16.Raw);
  ShowInt(L16.C);
  ShowInt(L16.D);
  L16.C -= 1;
  ShowInt(L16.C);
  ShowInt(L16.Raw);
  // Through a ptr: `->` writes, `P^.F` reads
  LP := addr of L16;
  LP->D := 1;
  GBits.B := -1;
  ShowInt(GBits.Raw);
  ShowInt(LP^.Raw);
end;

// A 32-bit lane shared by an unsigned and a signed field
routine Lane32();
var
  L32: TLane32;
begin
  L32.Lo := 1048575;
  L32.Hi := -1;
  ShowInt(L32.Raw);
  L32.Hi := -2048;
  ShowInt(L32.Raw);
  ShowInt(L32.Hi);
  ShowInt(L32.Lo);
  L32.Lo *= 2;
  ShowInt(L32.Lo);
end;

// A 64-bit lane: a field at its maximum, a wrap, the neighbour untouched
routine Lane64();
var
  L64: TLane64;
begin
  L64.G := -1;
  ShowInt(int64(L64.Raw));
  ShowInt(L64.G);
  L64.H := 16777215;
  ShowInt(int64(L64.Raw));
  ShowInt(int64(L64.H));
  L64.G := 549755813887;
  ShowInt(L64.G);
  L64.G += 1;
  ShowInt(L64.G);
  ShowInt(int64(L64.H));
end;

// bool, char, wchar and choices bitfields, and a full-width int32 one
routine Mixed();
var
  LM: TMixed;
begin
  LM.Ch := char(-20);
  ShowInt(int64(LM.Ch));
  LM.Flag := true;
  if LM.Flag then
    ShowInt(1);
  else
    ShowInt(0);
  end;
  ShowInt(int64(LM.Ch));
  LM.W := wchar(511);
  ShowInt(int64(LM.W));
  LM.W++;
  ShowInt(int64(LM.W));
  LM.Tri := TTri(-2);
  ShowInt(int64(LM.Tri));
  LM.Tri := TTri(-1);
  ShowInt(int64(LM.Tri));
  LM.Full := -123456789;
  ShowInt(LM.Full);
end;

begin
  Lane8();
  Lane16();
  Lane32();
  Lane64();
  Mixed();
end.
