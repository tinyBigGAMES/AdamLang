-------------------------------------------------------------------------------
  agg_array_compare_op.adam - Aggregates: arrays of records compare through
  their elements' declared operator (AUD3, BNF sec 6; C++'s std::array /
  std::vector rule): = and <> run the elements' = once per pair until one
  differs (= and <> of 3 equal pairs: 6 calls), the orders run their < both ways (lexicographically); static,
  dynamic and nested arrays; an extension's elements by its parent's
  operators; value parameters of a record holding a text (copies, no leak).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | equal true false
  | calls 6
  | changed false true
  | order true false true false
  | three -1 1 0
  | dynamic true -1
  | nested true
  | parent true false
  | names true false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_array_compare_op;

var
  GCalls: int64;

type
  TKey = record
    K: int64;

    operator =(const A: TKey; const B: TKey): bool;
    begin
      GCalls := GCalls + 1;
      return A.K = B.K;
    end;

    operator <>(const A: TKey; const B: TKey): bool;
    begin
      return A.K <> B.K;
    end;

    operator <(const A: TKey; const B: TKey): bool;
    begin
      return A.K < B.K;
    end;
  end;

  // the parent's operators compare its elements
  TTagged = record(TKey)
    Tag: int64;
  end;

  // value parameters of a record that holds a text: each call gets its own copies
  TName = record
    N: string;

    operator =(A: TName; B: TName): bool;
    begin
      return A.N = B.N;
    end;

    operator <>(A: TName; B: TName): bool;
    begin
      return A.N <> B.N;
    end;
  end;

// A key of AK
routine Key(const AK: int64): TKey;
var
  LKey: TKey;
begin
  LKey.K := AK;
  return LKey;
end;

routine Run();
var
  LA: array[0..2] of TKey;
  LB: array[0..2] of TKey;
  LD: array of TKey;
  LE: array of TKey;
  LG: array[0..1] of array[0..1] of TKey;
  LH: array[0..1] of array[0..1] of TKey;
  LT: array[0..1] of TTagged;
  LU: array[0..1] of TTagged;
  LN: array[0..1] of TName;
  LM: array[0..1] of TName;
  LI: int64;
begin
  for LI := 0 to 2 do
    LA[LI] := Key(LI + 1);
  end;
  LB := LA;
  GCalls := 0;
  println("equal {} {}", LA = LB, LA <> LB);
  println("calls {}", GCalls);
  LB[2] := Key(4);
  println("changed {} {}", LA = LB, LA <> LB);
  println("order {} {} {} {}", LA < LB, LA > LB, LA <= LB, LA >= LB);
  println("three {} {} {}", LA <=> LB, LB <=> LA, LA <=> LA);
  setlength(LD, 2);
  LD[0] := Key(1);
  LD[1] := Key(2);
  LE := [Key(1), Key(2)];
  println("dynamic {} {}", LD = LE, LD <=> [Key(1), Key(2), Key(0)]);
  LG[0][0] := Key(5);
  LG[1][1] := Key(6);
  LH := LG;
  println("nested {}", LG = LH);
  LT[0].K := 1;
  LT[0].Tag := 7;
  LU := LT;
  LU[0].Tag := 8;
  println("parent {} {}", LT = LU, LT <> LU);
  LN[0].N := "ab";
  LN[1].N := "cd";
  LM := LN;
  println("names {} {}", LN = LM, LN <> LM);
end;

begin
  Run();
end.
