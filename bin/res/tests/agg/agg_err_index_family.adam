-------------------------------------------------------------------------------
  agg_err_index_family.adam - Break step of agg_array (BNF sec 4). A static
  array bounded by choices values is indexed by that choices type, one bounded
  by integers by an integer (SM0261 each way), even when both bounds hold the
  same numbers: the bounds' family is part of the array type, so the integer
  array declared first never stands in for the choices one.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_index_family;

type
  Color = choices(Red, Green, Blue);
  ByNumber = array[0..2] of int32;
  ByColor = array[Color.Red..Color.Blue] of int32;

routine Run();
var
  LN: ByNumber;
  LC: ByColor;
begin
  LN[1] := 1;
  LC[Color.Green] := 2;
  LN[Color.Green] := 3; // ERROR SM0261@6: an index is an integer, got 'Color'
  LC[1] := 4; // ERROR SM0261@6: an index of 'array[Color.Red..Color.Blue] of int32' is a 'Color' value, got 'int32'
end;

begin
  Run();
end.
