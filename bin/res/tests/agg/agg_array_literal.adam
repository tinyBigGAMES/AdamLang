-------------------------------------------------------------------------------
  agg_array_literal.adam - Aggregates: array literals (BNF sec 6, H4u4). A
  bracket literal is an array literal where an array type takes it: consts
  (int32s folded into read-only data; a float64 table with an integer
  element and a trailing comma; records; strings; bools), module variables
  (a nested static array, a dynamic array, an empty one), a local's
  initializer, an assignment that reads the target it writes, a static and a
  dynamic argument, a static and a dynamic result, a concatenation element,
  a literal built again on each pass of a loop, chars, and `[]` emptying a
  dynamic array. Every block is freed (Leaked 0).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | primes 2 3 5 7
  | halves 1 2.5 -0.5
  | corners 1 2 -3 4
  | words one two three
  | flags true false true
  | grid 3 4 6
  | list 3 60
  | empty 0
  | triple 4 5
  | swapped 6 5 4
  | middle 12
  | sum 10
  | names 2 ann bo
  | names xy z
  | loop 3 30
  | origin 7 9
  | chars abc
  | cleared 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_array_literal;

type
  Point = record
    X: int32;
    Y: int32;
  end;

  Triple = array[0..2] of int32;

const
  Primes: array[0..3] of int32 = [2, 3, 5, 7];
  Halves: array[1..3] of float64 = [1, 2.5, -0.5,];
  Corners: array[0..1] of Point = [Point(X: 1, Y: 2), Point(X: -3, Y: 4)];
  Words: array[0..2] of string = ["one", "two", "three"];
  Flags: array[0..2] of bool = [true, false, true];

var
  GGrid: array[0..1] of array[0..2] of int16 = [[1, 2, 3], [4, 5, 6]];
  GList: array of int64 = [10, 20, 30];
  GEmpty: array of string = [];

// The sum of AList's elements
routine Sum(const AList: array of int64): int64;
var
  LI: int64;
  LTotal: int64;
begin
  LTotal := 0;
  for LI := 0 to len(AList) - 1 do
    LTotal := LTotal + AList[LI];
  end;
  return LTotal;
end;

// ATriple's middle element
routine Middle(const ATriple: Triple): int32;
begin
  return ATriple[1];
end;

// Two names, as a dynamic array result
routine Names(): array of string;
begin
  return ["ann", "bo"];
end;

// A static array result
routine Origin(): Triple;
begin
  return [7, 8, 9];
end;

routine Run();
var
  LTriple: Triple = [4, 5, 6];
  LNames: array of string;
  LI: int32;
  LLoop: array of int32;
  LChars: array[0..2] of char;
begin
  println("primes {} {} {} {}", Primes[0], Primes[1], Primes[2], Primes[3]);
  println("halves {} {} {}", Halves[1], Halves[2], Halves[3]);
  println("corners {} {} {} {}", Corners[0].X, Corners[0].Y, Corners[1].X, Corners[1].Y);
  println("words {} {} {}", Words[0], Words[1], Words[2]);
  println("flags {} {} {}", Flags[0], Flags[1], Flags[2]);
  println("grid {} {} {}", GGrid[0][2], GGrid[1][0], GGrid[1][2]);
  println("list {} {}", len(GList), Sum(GList));
  println("empty {}", len(GEmpty));
  println("triple {} {}", LTriple[0], Middle(LTriple));
  LTriple := [LTriple[2], LTriple[1], LTriple[0]];
  println("swapped {} {} {}", LTriple[0], LTriple[1], LTriple[2]);
  println("middle {}", Middle([11, 12, 13]));
  println("sum {}", Sum([1, 2, 3, 4]));
  LNames := Names();
  println("names {} {} {}", len(LNames), LNames[0], LNames[1]);
  LNames := ["x" + "y", "z"];
  println("names {} {}", LNames[0], LNames[1]);
  for LI := 1 to 3 do
    LLoop := [LI, LI * 10];
  end;
  println("loop {} {}", LLoop[0], LLoop[1]);
  LTriple := Origin();
  println("origin {} {}", LTriple[0], LTriple[2]);
  LChars := ['a', 'b', 'c'];
  println("chars {}{}{}", LChars[0], LChars[1], LChars[2]);
  LLoop := [];
  println("cleared {}", len(LLoop));
end;

begin
  Run();
end.
