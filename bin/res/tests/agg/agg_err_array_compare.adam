-------------------------------------------------------------------------------
  agg_err_array_compare.adam - Break step of agg_array_compare_op (AUD3):
  an array of records orders only through its elements' declared <, and
  compares by = only through their declared =; SM0252 names the operator
  the elements lack.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_array_compare;

type
  TEq = record
    K: int64;

    operator =(const A: TEq; const B: TEq): bool;
    begin
      return A.K = B.K;
    end;

    operator <>(const A: TEq; const B: TEq): bool;
    begin
      return A.K <> B.K;
    end;
  end;

  TPlain = record
    K: int64;
  end;

var
  GX: array[0..1] of TEq;
  GY: array[0..1] of TEq;
  GP: array of TPlain;
  GQ: array of TPlain;
  GOk: bool;

begin
  GOk := GX = GY;
  GOk := GX > GY; // ERROR SM0252@10: operator '<' cannot compare 'array[0..1] of TEq': records and overlays are not comparable, compare their fields
  GOk := GP = GQ; // ERROR SM0252@10: operator '=' cannot compare 'array of TPlain': records and overlays are not comparable, compare their fields
end.
