-------------------------------------------------------------------------------
  agg_flexible.adam - a flexible array member (M9e0b, BNF sec 4, his OK
  2026-11-16): `Data: array[0..] of T;` as a record's last field has no
  size of its own and aligns the record to T (C's T Data[]): size(TPacket)
  8, Data at 8 (the bytes of Data[0] at 8..15), size(TBytes) 2, Bytes at
  2; elements written and read through a ptr past the record, unchecked; a
  copy of the record copies its fixed part.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 8 2
  | 4 7 8
  | 63 240
  | 10 30 60
  | 4 7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe agg_flexible;

type
  TPacket = record
    Count: int32;
    Kind: uint8;
    Data: array[0..] of float64;
  end;

  TBytes = record
    Length: uint16;
    Bytes: array[0..] of uint8;
  end;

var
  LP: ptr to TPacket;
  LB: ptr to TBytes;
  LRaw: ptr to uint8;
  LCopy: TPacket;
  LI: int32;
  LSum: float64;
begin
  println("{} {}", size(TPacket), size(TBytes));
  LP := ptr to TPacket(getmem(size(TPacket) + 4 * size(float64)));
  LP^.Count := 4;
  LP^.Kind := 7;
  for LI := 0 to 3 do
    LP^.Data[LI] := float64(LI) + 0.5;
  end;
  LSum := 0.0;
  for LI := 0 to LP^.Count - 1 do
    LSum := LSum + LP^.Data[LI];
  end;
  println("{} {} {}", LP^.Count, LP^.Kind, int64(LSum));
  LP^.Data[0] := 1.0;
  LRaw := ptr to uint8(LP);
  println("{} {}", LRaw[15], LRaw[14]);

  LB := ptr to TBytes(getmem(size(TBytes) + 3));
  LB^.Length := 3;
  LB^.Bytes[0] := 10;
  LB^.Bytes[1] := 20;
  LB^.Bytes[2] := 30;
  LRaw := ptr to uint8(LB);
  println("{} {} {}", LRaw[2], LRaw[4], LB^.Bytes[0] + LB^.Bytes[1] + LB^.Bytes[2]);

  LCopy := LP^;
  println("{} {}", LCopy.Count, LCopy.Kind);
  freemem(LP);
  freemem(LB);
end.
