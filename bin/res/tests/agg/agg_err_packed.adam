-------------------------------------------------------------------------------
  agg_err_packed.adam - Break step of a packed record (BNF PLAN-RECORDS M8,
  AUD4 5.2): a field a packed record holds whose type aligns above 1 may be
  misaligned, so nothing binds its address: addr of it, a var argument (a
  routine's or an init's), a set's compound operator on it, a var or pointer
  upcast of a packed extension to its parent part are SM0270. Reached
  directly, through a non-packed record, through -> and through an embed
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe agg_err_packed;

type
  TS = set of 0..15;
  TPk = record packed
    C: int8;
    I: int32;
    S: TS;
    A: array[0..1] of int16;
  end;
  TBase = record
    X: int32;
  end;
  TPe = record(TBase) packed
    Y: int8;
  end;
  TOuter = record
    B: int8;
    P: TPk;
  end;
  THold = object
    embed E: TPk;
  end;
  TTaker = object
    N: int32;
    init(var AN: int32);
    begin
      self.N := AN;
    end;
  end;

routine Bump(var AN: int32);
begin
  AN := AN + 1;
end;

routine Grow(var AB: TBase);
begin
  AB.X := AB.X + 1;
end;

var
  LP: TPk;
  LE: TPe;
  LO: TOuter;
  LQ: ptr to TPk;
  LH: THold;
  LPI: ptr to int32;
  LPS: ptr to int16;
  LPB: ptr to TBase;
  LPE: ptr to TPe;

// An init's var parameter binds its argument's address too
routine Take(): int32;
var
  LT: TTaker(LP.I); // ERROR SM0270@14
begin
  return LT.N;
end;

begin
  LPI := addr of LP.I; // ERROR SM0270@18
  Bump(LP.I); // ERROR SM0270@8
  LP.S += [5]; // ERROR SM0270@3
  LPS := addr of LP.A[1]; // ERROR SM0270@18
  Grow(LE); // ERROR SM0270@8
  LPE := addr of LE;
  LPB := LPE; // ERROR SM0270@10
  Bump(LO.P.I); // ERROR SM0270@8
  LQ := addr of LP;
  Bump(LQ->I); // ERROR SM0270@8
  Bump(LH.I); // ERROR SM0270@8
  println("{}", Take());
end.
