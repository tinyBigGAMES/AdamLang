  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  toml_c_smoke.adam - System.Toml.C over libtomlc17.a (res/libs/vendor):
  the C layouts by size(T) (worked from tomlc17.h on a 64-bit target: str
  8 + 4 + 4 pad = 16, stamp six int16 + int32 + int16 = 18 -> 20, array
  4 + 4 pad + 8 = 16, table 4 + 4 pad + 3 * 8 = 32, the union its widest
  32, datum 4 * 4 + 8 + 32 = 56, result 1 + 7 pad + 56 + 200 + 8 = 272,
  option 1 + 7 pad + 2 * 8 = 24); a document parsed by toml_parse_named
  (results returned through C's hidden pointer), each value kind read by
  toml_seek through its dotted key (string, int64, fp64, bool, array,
  table, a missing key), toml_get on the top table, the source name copied
  into every datum; a malformed document (`a =` with no value) not ok with
  a message; every result freed by toml_free (passed by value).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | size TomlStr 16
  | size TomlStamp 20
  | size TomlArray 16
  | size TomlTable 32
  | size TomlValue 32
  | size TomlDatum 56
  | size TomlResult 272
  | size TomlOption 24
  | ok true
  | title kind 1
  | title adam
  | title len 4
  | title line 1
  | title source smoke.toml
  | level kind 2
  | level 3
  | level line 3
  | ratio kind 3
  | ratio 0.5
  | fast kind 4
  | fast true
  | names kind 9
  | names count 2
  | names 1 bc
  | build kind 10
  | build count 4
  | none kind 0
  | get title kind 1
  | bad ok false
  | bad message true
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe toml_c_smoke;

import System.SysUtils, System.Toml.C;

// ALabel and AValue on one line
routine Show(const ALabel: string; const AValue: int64);
begin
  println("{}", ALabel + " " + IntToStr(AValue));
end;

// ALabel and AText on one line
routine ShowText(const ALabel: string; const AText: string);
begin
  println("{}", ALabel + " " + AText);
end;

// ALabel and true / false on one line
routine ShowBool(const ALabel: string; const AValue: bool);
begin
  if AValue then
    ShowText(ALabel, "true");
  else
    ShowText(ALabel, "false");
  end;
end;

// The bytes of the NUL-terminated text at AText, its NUL not counted
routine CLength(const AText: ptr to const char): int64;
var
  LAt: int64;
begin
  LAt := 0;
  while int32(AText[LAt]) <> 0 do
    LAt := LAt + 1;
  end;
  return LAt;
end;

// The NUL-terminated text at AText as a string; "(nil)" for none
routine CText(const AText: ptr to const char): string;
var
  LText: string;
  LAt: int64;
begin
  if AText = nil then
    return "(nil)";
  end;
  LText := "";
  LAt := 0;
  while int32(AText[LAt]) <> 0 do
    LText := LText + AText[LAt];
    LAt := LAt + 1;
  end;
  return LText;
end;

var
  GDoc: ptr to const char;
  GBad: ptr to const char;
  GResult: TomlResult;
  GDatum: TomlDatum;

begin
  Show("size TomlStr", int64(size(TomlStr)));
  Show("size TomlStamp", int64(size(TomlStamp)));
  Show("size TomlArray", int64(size(TomlArray)));
  Show("size TomlTable", int64(size(TomlTable)));
  Show("size TomlValue", int64(size(TomlValue)));
  Show("size TomlDatum", int64(size(TomlDatum)));
  Show("size TomlResult", int64(size(TomlResult)));
  Show("size TomlOption", int64(size(TomlOption)));

  GDoc := ptr to const char("title = \"adam\"\n[build]\nlevel = 3\nratio = 0.5\nfast = true\nnames = [\"a\", \"bc\"]\n");
  GResult := toml_parse_named(GDoc, int32(CLength(GDoc)), ptr to const char("smoke.toml"));
  ShowBool("ok", GResult.Ok);

  GDatum := toml_seek(GResult.TopTab, ptr to const char("title"));
  Show("title kind", int64(GDatum.Kind));
  ShowText("title", CText(GDatum.Data.Str.Ptr));
  Show("title len", int64(GDatum.Data.Str.Len));
  Show("title line", int64(GDatum.LineNo));
  ShowText("title source", CText(GDatum.Source));

  GDatum := toml_seek(GResult.TopTab, ptr to const char("build.level"));
  Show("level kind", int64(GDatum.Kind));
  Show("level", GDatum.Data.Int64Value);
  Show("level line", int64(GDatum.LineNo));

  GDatum := toml_seek(GResult.TopTab, ptr to const char("build.ratio"));
  Show("ratio kind", int64(GDatum.Kind));
  ShowText("ratio", FloatToStr(GDatum.Data.Float64Value));

  GDatum := toml_seek(GResult.TopTab, ptr to const char("build.fast"));
  Show("fast kind", int64(GDatum.Kind));
  ShowBool("fast", GDatum.Data.BoolValue);

  GDatum := toml_seek(GResult.TopTab, ptr to const char("build.names"));
  Show("names kind", int64(GDatum.Kind));
  Show("names count", int64(GDatum.Data.Arr.Count));
  ShowText("names 1", CText(GDatum.Data.Arr.Elems[1].Data.Str.Ptr));

  GDatum := toml_seek(GResult.TopTab, ptr to const char("build"));
  Show("build kind", int64(GDatum.Kind));
  Show("build count", int64(GDatum.Data.Tab.Count));

  GDatum := toml_seek(GResult.TopTab, ptr to const char("build.none"));
  Show("none kind", int64(GDatum.Kind));

  GDatum := toml_get(GResult.TopTab, ptr to const char("title"));
  Show("get title kind", int64(GDatum.Kind));
  toml_free(GResult);

  GBad := ptr to const char("a =\n");
  GResult := toml_parse(GBad, int32(CLength(GBad)));
  ShowBool("bad ok", GResult.Ok);
  ShowBool("bad message", int32(GResult.ErrMsg[0]) <> 0);
  toml_free(GResult);
end.
