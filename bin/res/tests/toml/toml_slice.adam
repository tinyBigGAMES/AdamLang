-------------------------------------------------------------------------------
  toml_slice.adam - a slice of tomlc17's own parser tests (its test\parser:
  in\<name>.toml copied to fixtures\slice_<name>.toml from AdamLang-Libs'
  vendor\tomlc17-R261003) read by System.TOML.Ext's ParseFile and dumped through
  its API alone (KindOf, Count, KeyAt, TomlQuoteKey, the typed getters, item
  paths) in the form of upstream's parser.c; the expected lines are upstream's
  good\<name>.out as they are. Tables, dotted and quoted keys, arrays,
  arrays of tables, every integer form, booleans, the four date / time kinds
  (millisecond text as parser.c's), literal strings with backslashes and
  quotes. The two failures (e1 a table defined twice, e3 an invalid date)
  print ErrorText: upstream's "(line L)" text placed as Adam places it, at
  file(line,col). Floats are not in the slice (parser.c prints %.16g, Adam
  FloatToStr's shortest form): toml_doc reads one.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  args "<DIR>/fixtures/slice_tab1.toml" "<DIR>/fixtures/slice_array2.toml" "<DIR>/fixtures/slice_x1.toml" "<DIR>/fixtures/slice_5.toml" "<DIR>/fixtures/slice_7.toml" "<DIR>/fixtures/slice_8.toml" "<DIR>/fixtures/slice_12.toml" "<DIR>/fixtures/slice_e1.toml" "<DIR>/fixtures/slice_e3.toml"
  exitcode 0
  | == slice_tab1.toml
  | {
  |   "table-1": {
  |     "key1": {"type": "string", "value": "some string"},
  |     "key2": {"type": "integer", "value": "123"}
  |   },
  |   "table-2": {
  |     "key1": {"type": "string", "value": "another string"},
  |     "key2": {"type": "integer", "value": "456"}
  |   },
  |   "dog": {
  |     "tater.man": {
  |       "type": {
  |         "name": {"type": "string", "value": "pug"}
  |       }
  |     }
  |   }
  | }
  | == slice_array2.toml
  | {
  |   "integers2": [{"type": "integer", "value": "1"}, {"type": "integer", "value": "2"}, {"type": "integer", "value": "3"}],
  |   "integers3": [{"type": "integer", "value": "1"}, {"type": "integer", "value": "2"}]
  | }
  | == slice_x1.toml
  | {
  |   "arr": [{
  |     "subtab": {
  |       "val": {"type": "integer", "value": "1"}
  |     }
  |   }, {
  |     "subtab": {
  |       "val": {"type": "integer", "value": "2"}
  |     }
  |   }]
  | }
  | == slice_5.toml
  | {
  |   "int1": {"type": "integer", "value": "99"},
  |   "int2": {"type": "integer", "value": "42"},
  |   "int3": {"type": "integer", "value": "0"},
  |   "int4": {"type": "integer", "value": "-17"},
  |   "int5": {"type": "integer", "value": "1000"},
  |   "int6": {"type": "integer", "value": "5349221"},
  |   "int7": {"type": "integer", "value": "5349221"},
  |   "int8": {"type": "integer", "value": "12345"},
  |   "hex1": {"type": "integer", "value": "3735928559"},
  |   "hex2": {"type": "integer", "value": "3735928559"},
  |   "hex3": {"type": "integer", "value": "3735928559"},
  |   "oct1": {"type": "integer", "value": "342391"},
  |   "oct2": {"type": "integer", "value": "493"},
  |   "bin1": {"type": "integer", "value": "214"}
  | }
  | == slice_7.toml
  | {
  |   "bool1": {"type": "bool", "value": "true"},
  |   "bool2": {"type": "bool", "value": "false"}
  | }
  | == slice_8.toml
  | {
  |   "odt1": {"type": "datetime", "value": "1979-05-27 07:32:00+00:00"},
  |   "odt2": {"type": "datetime", "value": "1979-05-27 00:32:00-07:00"},
  |   "odt3": {"type": "datetime", "value": "1979-05-27 00:32:00.999-07:00"},
  |   "odt4": {"type": "datetime", "value": "1979-05-27 07:32:00+00:00"},
  |   "ldt1": {"type": "datetime-local", "value": "1979-05-27 07:32:00"},
  |   "ldt2": {"type": "datetime-local", "value": "1979-05-27 00:32:00.999"},
  |   "ld1": {"type": "date-local", "value": "1979-05-27"},
  |   "lt1": {"type": "time-local", "value": "07:32:00"},
  |   "lt2": {"type": "time-local", "value": "00:32:00.999"},
  |   "lower": {"type": "datetime", "value": "1987-07-05 17:45:00+00:00"}
  | }
  | == slice_12.toml
  | {
  |   "winpath": {"type": "string", "value": "C:\\Users\\nodejs\\templates"},
  |   "winpath2": {"type": "string", "value": "\\\\ServerX\\admin$\\system32\\"},
  |   "quoted": {"type": "string", "value": "Tom \"Dubs\" Preston-Werner"},
  |   "regex": {"type": "string", "value": "<\\i\\c*\\s*>"}
  | }
  | == slice_e1.toml
  | <DIR>/fixtures/slice_e1.toml(3,2): table defined more than once
  | == slice_e3.toml
  | <DIR>/fixtures/slice_e3.toml(2,8): invalid date
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe toml_slice;

import System.SysUtils, System.TOML.Ext;

var
  GDoc: TomlDocument;
  GArg: int32;

// AValue in decimal, zero-padded to AWidth digits (as C's %0Nd)
routine Pad(const AValue: int64; const AWidth: int64): string;
var
  LText: string;
begin
  LText := IntToStr(AValue);
  while len(LText) < AWidth do
    LText := "0" + LText;
  end;
  return LText;
end;

// AText as parser.c prints a string or a key: quoted, '"' '\' and the control chars escaped
routine JsonText(const AText: string): string;
var
  LText: string;
  LChar: char;
  LCode: int64;
  LI: int64;
begin
  LText := "\"";
  for LI := 0 to len(AText) - 1 do
    LChar := AText[LI];
    LCode := int64(uint8(LChar));
    if (LChar = '"') or (LChar = '\\') then
      LText := LText + "\\" + LChar;
    else
      if LCode = 8 then
        LText := LText + "\\b";
      else
        if LCode = 9 then
          LText := LText + "\\t";
        else
          if LCode = 10 then
            LText := LText + "\\n";
          else
            if LCode = 12 then
              LText := LText + "\\f";
            else
              if LCode = 13 then
                LText := LText + "\\r";
              else
                if LCode < 32 then
                  LText := LText + "\\u" + LowerCase(IntToHex(uint64(LCode), 4));
                else
                  LText := LText + LChar;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
  return LText + "\"";
end;

// A typed value's text as parser.c prints it
routine Typed(const AType: string; const AValue: string): string;
begin
  return "{\"type\": \"" + AType + "\", \"value\": \"" + AValue + "\"}";
end;

// The milliseconds of AMicroseconds as parser.c prints them: "" for none, else ".mmm"
routine FracText(const AMicroseconds: int64): string;
begin
  if AMicroseconds = 0 then
    return "";
  end;
  return "." + Pad(AMicroseconds div 1000, 3);
end;

// AValue (a date / time) as parser.c prints its kind
routine StampText(const AValue: TomlDateTime): string;
var
  LDate: string;
  LTime: string;
  LOffset: int64;
  LSign: string;
begin
  LDate := Pad(AValue.Year, 4) + "-" + Pad(AValue.Month, 2) + "-" + Pad(AValue.Day, 2);
  LTime := Pad(AValue.Hour, 2) + ":" + Pad(AValue.Minute, 2) + ":" + Pad(AValue.Second, 2) +
    FracText(AValue.Microsecond);
  if AValue.Kind = TomlKind.LocalDate then
    return Typed("date-local", LDate);
  end;
  if AValue.Kind = TomlKind.LocalTime then
    return Typed("time-local", LTime);
  end;
  if AValue.Kind = TomlKind.LocalDateTime then
    return Typed("datetime-local", LDate + " " + LTime);
  end;
  LOffset := AValue.OffsetMinutes;
  LSign := "+";
  if LOffset < 0 then
    LSign := "-";
    LOffset := -LOffset;
  end;
  return Typed("datetime", LDate + " " + LTime + LSign + Pad(LOffset div 60, 2) + ":" +
    Pad(LOffset mod 60, 2));
end;

forward routine DumpValue(const APath: string; const ALevel: int64): string;

// The array at APath as parser.c prints it: its items on one line
routine DumpArray(const APath: string; const ALevel: int64): string;
var
  LCount: int64;
  LText: string;
  LI: int64;
begin
  GDoc.Count(APath, LCount);
  LText := "[";
  for LI := 0 to LCount - 1 do
    if LI > 0 then
      LText := LText + ", ";
    end;
    LText := LText + DumpValue(APath + "[" + IntToStr(LI) + "]", ALevel);
  end;
  return LText + "]";
end;

// The table at APath as parser.c prints it: a key per line, one level deeper
routine DumpTable(const APath: string; const ALevel: int64): string;
var
  LCount: int64;
  LKey: string;
  LChild: string;
  LText: string;
  LI: int64;
begin
  GDoc.Count(APath, LCount);
  LText := "{\n";
  for LI := 0 to LCount - 1 do
    GDoc.KeyAt(APath, LI, LKey);
    LChild := TomlQuoteKey(LKey);
    if APath <> "" then
      LChild := APath + "." + LChild;
    end;
    if LI > 0 then
      LText := LText + ",\n";
    end;
    LText := LText + StringOfChar(' ', (ALevel + 1) * 2) + JsonText(LKey) + ": " +
      DumpValue(LChild, ALevel + 1);
  end;
  return LText + "\n" + StringOfChar(' ', ALevel * 2) + "}";
end;

// The value at APath as parser.c prints it (ALevel the tables it is inside)
routine DumpValue(const APath: string; const ALevel: int64): string;
var
  LKind: TomlKind;
  LText: string;
  LInt: int64;
  LBool: bool;
  LStamp: TomlDateTime;
begin
  LKind := GDoc.KindOf(APath);
  if LKind = TomlKind.String then
    GDoc.GetString(APath, LText);
    return "{\"type\": \"string\", \"value\": " + JsonText(LText) + "}";
  end;
  if LKind = TomlKind.Integer then
    GDoc.GetInt64(APath, LInt);
    return Typed("integer", IntToStr(LInt));
  end;
  if LKind = TomlKind.Boolean then
    GDoc.GetBool(APath, LBool);
    if LBool then
      return Typed("bool", "true");
    end;
    return Typed("bool", "false");
  end;
  if LKind = TomlKind.Array then
    return DumpArray(APath, ALevel);
  end;
  if LKind = TomlKind.Table then
    return DumpTable(APath, ALevel);
  end;
  if GDoc.GetDateTime(APath, LStamp) then
    return StampText(LStamp);
  end;
  return "(" + GDoc.ErrorText() + ")";
end;

begin
  for GArg := 1 to paramcount() do
    println("{}", "== " + ExtractFileName(paramstr(GArg)));
    if GDoc.ParseFile(paramstr(GArg)) then
      println("{}", DumpValue("", 0));
    else
      println("{}", GDoc.ErrorText());
    end;
  end;
end.
