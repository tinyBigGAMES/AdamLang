-------------------------------------------------------------------------------
  toml_doc.adam - System.Toml's TomlDocument: a text parsed, then every value
  kind read by path (string, integer, float, boolean, the four date / time
  kinds, arrays and arrays of arrays, tables and arrays of tables, a quoted
  key), KindOf / Has / Count / KeyAt over them, TomlQuoteKey; every failure
  path with its place: a wrong kind at the value, a missing key at the table
  it was sought in, an index out of range at the array, a bad path with no
  place, a parse error at tomlc17's (line, col), no document; a second parse
  over the first; files (fixtures\: parsed, an error placed in a file, an
  empty file, a missing file, a folder) read by System.Runtime's
  ReadFileBytes. The [Heap] line shows every getmem block freed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  args "<DIR>/fixtures/toml_doc.toml" "<DIR>/fixtures/toml_doc_bad.toml" "<DIR>/fixtures/none.toml" "<DIR>/fixtures/toml_doc_empty.toml" "<DIR>/fixtures"
  exitcode 0
  | parse true []
  | title adam
  | answer 42
  | ratio 0.5
  | fast true
  | born LocalDate 1979-5-27 0:0:0 us 0 tz 0
  | alarm LocalTime 0-0-0 7:32:0 us 500000 tz 0
  | local LocalDateTime 1979-5-27 7:32:0 us 0 tz 0
  | stamp OffsetDateTime 1979-5-27 0:32:0 us 999999 tz -420
  | names count 2
  | names[1] bc
  | grid[0][1] 2
  | grid[1] count 1
  | dotted q
  | host localhost
  | ports[1] 443
  | items count 2
  | items[1].id 2
  | quoted "" []
  | root count 14
  | keys title,answer,ratio,fast,born,alarm,local,stamp,names,grid,dotted.key,,server,items
  | server keys host,ports
  | kinds String,Integer,Float,Boolean,LocalDate,LocalTime,LocalDateTime,OffsetDateTime,Array,Table,Table,Missing,Missing,Missing
  | has true false true
  | quote plain "dotted.key" "a\"b" ""
  | fail string false doc.toml(2,10): "answer" is an integer, not a string
  | fail int false doc.toml(1,9): "title" is a string, not an integer
  | fail float false doc.toml(2,10): "answer" is an integer, not a float
  | fail bool false doc.toml(3,9): "ratio" is a float, not a boolean
  | fail stamp false doc.toml(2,10): "answer" is an integer, not a date or a time
  | fail missing false doc.toml(13,2): "server.nope" not found
  | fail top false doc.toml(1,1): "nope" not found
  | fail table false doc.toml(1,9): "title" is a string, not a table
  | fail array false doc.toml(2,10): "answer" is an integer, not an array
  | fail range false doc.toml(15,9): "server.ports[5]" is out of range (2 items)
  | fail dots false doc.toml: bad path "server..host" at byte 7
  | fail index false doc.toml: bad path "names[x]" at byte 6
  | fail quote false doc.toml: bad path ""open" at byte 5
  | fail count false doc.toml(1,9): "title" is a string, not an array or a table
  | fail key false doc.toml(13,2): "server" has no key 5 (2 keys)
  | fail keyof false doc.toml(9,9): "names" is an array, not a table
  | cleared true []
  | bad false bad.toml(2,2): expect '='
  | bad get false bad.toml: no document has been parsed
  | unnamed false <text>(1,4): missing value
  | fresh false no document has been parsed
  | fresh kind Missing has false
  | again true x 1 has title false
  | file true name file n 7
  | file bad false <DIR>/fixtures/toml_doc_bad.toml(2,9): bad escape char in string
  | file none false <DIR>/fixtures/none.toml: the file cannot be read
  | file empty true count 0
  | file folder false <DIR>/fixtures: the file cannot be read
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe toml_doc;

import System.SysUtils, System.Toml;

var
  GDoc: TomlDocument;
  GOk: bool;
  GText: string;
  GInt: int64;
  GFloat: float64;
  GBool: bool;
  GStamp: TomlDateTime;
  GCount: int64;
  GKey: string;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// The name of AKind as declared
routine KindName(const AKind: TomlKind): string;
begin
  if AKind = TomlKind.String then
    return "String";
  end;
  if AKind = TomlKind.Integer then
    return "Integer";
  end;
  if AKind = TomlKind.Float then
    return "Float";
  end;
  if AKind = TomlKind.Boolean then
    return "Boolean";
  end;
  if AKind = TomlKind.LocalDate then
    return "LocalDate";
  end;
  if AKind = TomlKind.LocalTime then
    return "LocalTime";
  end;
  if AKind = TomlKind.LocalDateTime then
    return "LocalDateTime";
  end;
  if AKind = TomlKind.OffsetDateTime then
    return "OffsetDateTime";
  end;
  if AKind = TomlKind.Array then
    return "Array";
  end;
  if AKind = TomlKind.Table then
    return "Table";
  end;
  return "Missing";
end;

// Every part of AValue on one line
routine StampText(const AValue: TomlDateTime): string;
begin
  return KindName(AValue.Kind) + " " + IntToStr(AValue.Year) + "-" + IntToStr(AValue.Month) + "-" +
    IntToStr(AValue.Day) + " " + IntToStr(AValue.Hour) + ":" + IntToStr(AValue.Minute) + ":" +
    IntToStr(AValue.Second) + " us " + IntToStr(AValue.Microsecond) + " tz " +
    IntToStr(AValue.OffsetMinutes);
end;

// A failing call's line: its label, its result and the document's error
routine ShowFail(const ALabel: string; const AOk: bool);
begin
  println("{}", "fail " + ALabel + " " + BoolText(AOk) + " " + GDoc.ErrorText());
end;

// The keys of the table at APath joined by ','
routine KeysOf(const APath: string): string;
var
  LCount: int64;
  LKey: string;
  LList: string;
  LI: int64;
begin
  LList := "";
  GDoc.Count(APath, LCount);
  for LI := 0 to LCount - 1 do
    GDoc.KeyAt(APath, LI, LKey);
    if LI > 0 then
      LList := LList + ",";
    end;
    LList := LList + LKey;
  end;
  return LList;
end;

// A document of its own: no parse yet, then dropped at the routine's end
routine Fresh();
var
  LDoc: TomlDocument;
  LInt: int64;
  LOk: bool;
begin
  LOk := LDoc.GetInt64("a", LInt);
  println("{}", "fresh " + BoolText(LOk) + " " + LDoc.ErrorText());
  println("{}", "fresh kind " + KindName(LDoc.KindOf("")) + " has " + BoolText(LDoc.Has("")));
end;

begin
  GOk := GDoc.ParseText("title = \"adam\"\nanswer = 42\nratio = 0.5\nfast = true\nborn = 1979-05-27\nalarm = 07:32:00.5\nlocal = 1979-05-27T07:32:00\nstamp = 1979-05-27T00:32:00.999999-07:00\nnames = [\"a\", \"bc\"]\ngrid = [[1, 2], [3]]\n\"dotted.key\" = \"q\"\n\"\" = \"\"\n[server]\nhost = \"localhost\"\nports = [80, 443]\n[[items]]\nid = 1\n[[items]]\nid = 2\n", "doc.toml");
  println("{}", "parse " + BoolText(GOk) + " [" + GDoc.ErrorText() + "]");

  // Every value kind by path
  GDoc.GetString("title", GText);
  println("{}", "title " + GText);
  GDoc.GetInt64("answer", GInt);
  println("{}", "answer " + IntToStr(GInt));
  GDoc.GetFloat64("ratio", GFloat);
  println("{}", "ratio " + FloatToStr(GFloat));
  GDoc.GetBool("fast", GBool);
  println("{}", "fast " + BoolText(GBool));
  GDoc.GetDateTime("born", GStamp);
  println("{}", "born " + StampText(GStamp));
  GDoc.GetDateTime("alarm", GStamp);
  println("{}", "alarm " + StampText(GStamp));
  GDoc.GetDateTime("local", GStamp);
  println("{}", "local " + StampText(GStamp));
  GDoc.GetDateTime("stamp", GStamp);
  println("{}", "stamp " + StampText(GStamp));

  // Arrays, tables, a quoted key, arrays of tables
  GDoc.Count("names", GCount);
  println("{}", "names count " + IntToStr(GCount));
  GDoc.GetString("names[1]", GText);
  println("{}", "names[1] " + GText);
  GDoc.GetInt64("grid[0][1]", GInt);
  println("{}", "grid[0][1] " + IntToStr(GInt));
  GDoc.Count("grid[1]", GCount);
  println("{}", "grid[1] count " + IntToStr(GCount));
  GDoc.GetString("\"dotted.key\"", GText);
  println("{}", "dotted " + GText);
  GDoc.GetString("server.host", GText);
  println("{}", "host " + GText);
  GDoc.GetInt64("server.ports[1]", GInt);
  println("{}", "ports[1] " + IntToStr(GInt));
  GDoc.Count("items", GCount);
  println("{}", "items count " + IntToStr(GCount));
  GDoc.GetInt64("items[1].id", GInt);
  println("{}", "items[1].id " + IntToStr(GInt));
  GText := "x";
  GDoc.GetString(TomlQuoteKey(""), GText);
  println("{}", "quoted " + TomlQuoteKey("") + " [" + GText + "]");

  // The top table's keys, a table's keys, the kinds, Has
  GDoc.Count("", GCount);
  println("{}", "root count " + IntToStr(GCount));
  println("{}", "keys " + KeysOf(""));
  println("{}", "server keys " + KeysOf("server"));
  println("{}", "kinds " + KindName(GDoc.KindOf("title")) + "," + KindName(GDoc.KindOf("answer")) + "," +
    KindName(GDoc.KindOf("ratio")) + "," + KindName(GDoc.KindOf("fast")) + "," +
    KindName(GDoc.KindOf("born")) + "," + KindName(GDoc.KindOf("alarm")) + "," +
    KindName(GDoc.KindOf("local")) + "," + KindName(GDoc.KindOf("stamp")) + "," +
    KindName(GDoc.KindOf("names")) + "," + KindName(GDoc.KindOf("server")) + "," +
    KindName(GDoc.KindOf("")) + "," + KindName(GDoc.KindOf("nope")) + "," +
    KindName(GDoc.KindOf("names[9]")) + "," + KindName(GDoc.KindOf("a..b")));
  println("{}", "has " + BoolText(GDoc.Has("server.host")) + " " + BoolText(GDoc.Has("server.nope")) + " " +
    BoolText(GDoc.Has("")));
  println("{}", "quote " + TomlQuoteKey("plain") + " " + TomlQuoteKey("dotted.key") + " " +
    TomlQuoteKey("a\"b") + " " + TomlQuoteKey(""));

  // Every getter's failure, placed at the value it is about
  ShowFail("string", GDoc.GetString("answer", GText));
  ShowFail("int", GDoc.GetInt64("title", GInt));
  ShowFail("float", GDoc.GetFloat64("answer", GFloat));
  ShowFail("bool", GDoc.GetBool("ratio", GBool));
  ShowFail("stamp", GDoc.GetDateTime("answer", GStamp));
  ShowFail("missing", GDoc.GetInt64("server.nope", GInt));
  ShowFail("top", GDoc.GetInt64("nope", GInt));
  ShowFail("table", GDoc.GetInt64("title.x", GInt));
  ShowFail("array", GDoc.GetInt64("answer[0]", GInt));
  ShowFail("range", GDoc.GetInt64("server.ports[5]", GInt));
  ShowFail("dots", GDoc.GetInt64("server..host", GInt));
  ShowFail("index", GDoc.GetInt64("names[x]", GInt));
  ShowFail("quote", GDoc.GetInt64("\"open", GInt));
  ShowFail("count", GDoc.Count("title", GCount));
  ShowFail("key", GDoc.KeyAt("server", 5, GKey));
  ShowFail("keyof", GDoc.KeyAt("names", 0, GKey));
  GOk := GDoc.GetInt64("answer", GInt);
  println("{}", "cleared " + BoolText(GOk) + " [" + GDoc.ErrorText() + "]");

  // Parse errors at tomlc17's place, then no document
  GOk := GDoc.ParseText("a = 1\nb\n", "bad.toml");
  println("{}", "bad " + BoolText(GOk) + " " + GDoc.ErrorText());
  GOk := GDoc.GetInt64("a", GInt);
  println("{}", "bad get " + BoolText(GOk) + " " + GDoc.ErrorText());
  GOk := GDoc.ParseText("a =\n", "");
  println("{}", "unnamed " + BoolText(GOk) + " " + GDoc.ErrorText());
  Fresh();

  // A second parse over the first
  GDoc.ParseText("title = \"t\"\n", "one.toml");
  GOk := GDoc.ParseText("x = 1\n", "two.toml");
  GDoc.GetInt64("x", GInt);
  println("{}", "again " + BoolText(GOk) + " x " + IntToStr(GInt) + " has title " + BoolText(GDoc.Has("title")));

  // Files: parsed, an error placed in one, missing, empty, a folder
  GOk := GDoc.ParseFile(paramstr(1));
  GDoc.GetString("name", GText);
  GDoc.GetInt64("deep.er.n", GInt);
  println("{}", "file " + BoolText(GOk) + " name " + GText + " n " + IntToStr(GInt));
  GOk := GDoc.ParseFile(paramstr(2));
  println("{}", "file bad " + BoolText(GOk) + " " + GDoc.ErrorText());
  GOk := GDoc.ParseFile(paramstr(3));
  println("{}", "file none " + BoolText(GOk) + " " + GDoc.ErrorText());
  GOk := GDoc.ParseFile(paramstr(4));
  GDoc.Count("", GCount);
  println("{}", "file empty " + BoolText(GOk) + " count " + IntToStr(GCount));
  GOk := GDoc.ParseFile(paramstr(5));
  println("{}", "file folder " + BoolText(GOk) + " " + GDoc.ErrorText());
end.
