-------------------------------------------------------------------------------
  toml_err_hidden.adam - System.TOML.Ext's TOMLDocument keeps its parse state
  to itself: the tomlc17 result, the source name, the last error (read with
  ErrorText) and the parse / kind-check steps are hidden, so a program
  reaching any of them is refused (SM0019). Find and Fail stay public.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe toml_err_hidden;

import System.TOML.C, System.TOML.Ext;

var
  LDoc: TOMLDocument;
  LOk: bool;
  LText: string;
  LResult: toml_result_t;
  LDatum: toml_datum_t;

begin
  LOk := LDoc.Held; // ERROR SM0019@15: 'Held' is hidden in 'TOMLDocument': only the methods of 'TOMLDocument' and of its descendants reach it
  LText := LDoc.SourceName; // ERROR SM0019@17: 'SourceName' is hidden in 'TOMLDocument': only the methods of 'TOMLDocument' and of its descendants reach it
  LText := LDoc.LastError; // ERROR SM0019@17: 'LastError' is hidden in 'TOMLDocument': only the methods of 'TOMLDocument' and of its descendants reach it
  LResult := LDoc.Parsed; // ERROR SM0019@19: 'Parsed' is hidden in 'TOMLDocument': only the methods of 'TOMLDocument' and of its descendants reach it
  LOk := LDoc.DoParse(nil, 0); // ERROR SM0019@15: 'DoParse' is hidden in 'TOMLDocument': only the methods of 'TOMLDocument' and of its descendants reach it
  LOk := LDoc.Expect("a", LDatum, 0, "x"); // ERROR SM0019@15: 'Expect' is hidden in 'TOMLDocument': only the methods of 'TOMLDocument' and of its descendants reach it
  LOk := LDoc.Find("a", LDatum);
  LOk := LDoc.Fail(1, 1, "kept public");
end.
