-------------------------------------------------------------------------------
  lib_extarray_lib.adam - the lib of lib_extarray (PLAN-XML X2c): built only;
  it defines sized arrays the exe binds as external array[0..] of T, as C's
  `extern T x[];` binds a library's array (libxml2's xmlStringText); its
  routines read back what the exe wrote through them
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module lib lib_extarray_lib;

public var
  // The bytes "text" and a 0, as libxml2's xmlStringText holds them
  ExtText: array[0..4] of uint8;
  // Words the exe writes through its external array
  ExtWords: array[0..2] of int32;

// The sum of ExtWords (what the exe stored)
public func ExtWordSum(): int32;
var
  LI: int32;
  LSum: int32;
begin
  LSum := 0;
  for LI := 0 to 2 do
    LSum := LSum + ExtWords[LI];
  end;
  return LSum;
end;

initialize
begin
  ExtText[0] := 116;
  ExtText[1] := 101;
  ExtText[2] := 120;
  ExtText[3] := 116;
  ExtText[4] := 0;
  ExtWords[0] := 1;
  ExtWords[1] := 2;
  ExtWords[2] := 3;
end;

end.
