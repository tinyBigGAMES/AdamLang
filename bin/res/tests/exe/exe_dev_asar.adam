-------------------------------------------------------------------------------
  exe_dev_asar.adam - Adam.Dev.Asar (M11a D5e2, adam --dev-editor's
  archive), imported from the compiler's own src\: its fixture folder
  (a.txt, sub/b.js, an empty folder: fixtures\exe_dev_asar) packed with sub/b.js's
  bytes given in place of the disk's; the archive read back: its count and
  size, the header pickles' four words, the header JSON (members in walk
  order, the empty folder left out, offsets as strings), each file's bytes
  at its offset; a folder that is not there is no archive, no why
*******************************************************************************/

/*
@@test
  kind run
  args "<DIR>/fixtures/exe_dev_asar"
  exitcode 0
  | count 2 bytes 117
  | words 4 100 96 92
  | header {"files":{"a.txt":{"size":5,"offset":"0"},"sub":{"files":{"b.js":{"size":4,"offset":"5"}}}}}
  | a.txt alpha
  | sub/b.js BETA
  | missing false why ''
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_dev_asar;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Dev.Asar;

var
  GDir: string;
  GReplace: AsarReplaceArray;
  GBytes: ByteArray;
  GCount: int64;
  GWhy: string;
  GOk: bool;

// ACount bytes of ABytes from AAt as text
routine DoText(const ABytes: ByteArray; const AAt: int64; const ACount: int64): string;
begin
  return StringFromC(ptr to const char(addr of ABytes[AAt]), ACount);
end;

begin
  GDir := paramstr(1);
  setlength(GReplace, 1);
  GReplace[0].Name := "sub/b.js";
  setlength(GReplace[0].Bytes, 4);
  GReplace[0].Bytes[0] := uint8(66);
  GReplace[0].Bytes[1] := uint8(69);
  GReplace[0].Bytes[2] := uint8(84);
  GReplace[0].Bytes[3] := uint8(65);
  GOk := AsarFromFolder(GDir, GReplace, GBytes, GCount, GWhy);
  if not GOk then
    println("archive failed: {}", GWhy);
    Halt(1);
  end;
  println("count {} bytes {}", GCount, len(GBytes));
  println("words {} {} {} {}", GetLe(GBytes, 0, 4), GetLe(GBytes, 4, 4), GetLe(GBytes, 8, 4),
    GetLe(GBytes, 12, 4));
  println("header {}", DoText(GBytes, 16, int64(GetLe(GBytes, 12, 4))));
  println("a.txt {}", DoText(GBytes, 8 + int64(GetLe(GBytes, 4, 4)), 5));
  println("sub/b.js {}", DoText(GBytes, 8 + int64(GetLe(GBytes, 4, 4)) + 5, 4));
  setlength(GReplace, 0);
  GOk := AsarFromFolder(GDir + "/nothing_here", GReplace, GBytes, GCount, GWhy);
  println("missing {} why '{}'", GOk, GWhy);
end.
