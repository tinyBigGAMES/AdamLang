-------------------------------------------------------------------------------
  dir_conditionals.adam - conditional directives (BNF sec 9): @define /
  @undef in the prologue, in a body and inside a branch; @ifndef taken and
  not; an @elseif chain takes the first true branch only (a later true one
  and @else stay shut); a frame under an inactive parent opens no branch;
  @define in an inactive branch defines nothing; @undef of a symbol never
  defined is silent; a branch can hold declarations
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ifndef undefined: taken
  | ifndef defined: else taken
  | elseif third taken
  | ifdef first taken
  | inactive define ignored
  | undef in body: elseif taken
  | define in a branch holds after it
  | const from the ifndef branch
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dir_conditionals;

@define DIRC_ONE
@define DIRC_TWO
@undef DIRC_TWO
@undef DIRC_NEVER
@define DIRC_THREE

@ifndef DIRC_TWO
const
  CPicked: string = "const from the ifndef branch";
@else
const
  CPicked: string = "wrong const";
@endif

begin
@ifndef DIRC_TWO
  println("ifndef undefined: taken");
@endif
@ifndef DIRC_ONE
  println("wrong 1");
@else
  println("ifndef defined: else taken");
@endif
@ifdef DIRC_TWO
  println("wrong 2");
@elseif DIRC_NONE
  println("wrong 3");
@elseif DIRC_THREE
  println("elseif third taken");
@elseif DIRC_ONE
  println("wrong 4");
@else
  println("wrong 5");
@endif
@ifdef DIRC_ONE
  println("ifdef first taken");
@elseif DIRC_THREE
  println("wrong 6");
@endif
@ifndef DIRC_ONE
@define DIRC_GHOST
@ifdef DIRC_ONE
  println("wrong 7");
@elseif DIRC_THREE
  println("wrong 8");
@else
  println("wrong 9");
@endif
@endif
@ifdef DIRC_GHOST
  println("wrong 10");
@else
  println("inactive define ignored");
@endif
@undef DIRC_ONE
@ifdef DIRC_ONE
  println("wrong 11");
@elseif DIRC_THREE
@define DIRC_LATE
  println("undef in body: elseif taken");
@endif
@ifdef DIRC_LATE
  println("define in a branch holds after it");
@endif
  println("{}", CPicked);
end.
