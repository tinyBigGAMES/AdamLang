  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  exc_guard_jump.adam - A jump out of a guard's protected part runs its
  finally on the way (BNF sec 5, PLAN-ADAM H4t5a): a return out of the body
  (its value read before the finally: the finally's change to the local is
  not returned), a leave and a skip of a loop around the guard, a return out
  of an except part ahead of the finally, nested guards (the inner finally
  first) for a return and for a leave, a string returned from the body (its
  text kept, released once: Leaked 0), a record returned in a register and
  one through the hidden result pointer, a return out of a guard with only
  an except part (nothing to run), and the program block's return out of a
  guard (its finally runs, nothing after it does, exit 0)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | returns finally 99
  | returns 7
  | leaves body 1
  | leaves finally 1
  | leaves finally 2
  | leaves after 2
  | skips body 0
  | skips finally 0
  | skips finally 1
  | skips body 2
  | skips finally 2
  | excepts except
  | excepts finally
  | excepts 3
  | nested inner finally
  | nested outer finally
  | nested 5
  | leave inner finally
  | leave outer finally
  | leave after
  | text finally
  | text 4
  | small finally
  | small 1 2
  | large finally
  | large 10 20 30
  | exceptonly 9
  | main finally
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_guard_jump;

import System.SysUtils;

type
  // Returned in a register (8 bytes)
  Small = record
    A: int32;
    B: int32;
  end;

  // Returned through the hidden result pointer (24 bytes)
  Large = record
    A: int64;
    B: int64;
    C: int64;
  end;

// The value is read before the finally: its change to LN is not returned
func Returns(): int32;
var
  LN: int32;
begin
  LN := 7;
  guard
    return LN;
  finally
    LN := 99;
    println("{}", "returns finally " + IntToStr(LN));
  end;
end;

// A leave of the loop around the guard: the finally runs, then the loop is left
func Leaves();
var
  LI: int32;
begin
  LI := 0;
  while true do
    LI := LI + 1;
    guard
      if LI = 2 then
        leave;
      end;
      println("{}", "leaves body " + IntToStr(LI));
    finally
      println("{}", "leaves finally " + IntToStr(LI));
    end;
  end;
  println("{}", "leaves after " + IntToStr(LI));
end;

// A skip of the loop around the guard: the finally runs on every round
func Skips();
var
  LI: int32;
begin
  for LI := 0 to 2 do
    guard
      if LI = 1 then
        skip;
      end;
      println("{}", "skips body " + IntToStr(LI));
    finally
      println("{}", "skips finally " + IntToStr(LI));
    end;
  end;
end;

// A return out of the except part: the finally runs after it
func Excepts(): int32;
begin
  guard
    raise("boom");
  except
    println("excepts except");
    return 3;
  finally
    println("excepts finally");
  end;
end;

// Nested guards: a return runs the inner finally, then the outer one
func Nested(): int32;
begin
  guard
    guard
      return 5;
    finally
      println("nested inner finally");
    end;
  finally
    println("nested outer finally");
  end;
end;

// A leave out of two guards: both finallys, the inner first, then the loop is left
func NestedLeave();
begin
  while true do
    guard
      guard
        leave;
      finally
        println("leave inner finally");
      end;
    finally
      println("leave outer finally");
    end;
  end;
  println("leave after");
end;

// A string from the body: its text kept through the finally that empties the local
func Text(const AN: int32): string;
var
  LS: string;
begin
  LS := "text " + IntToStr(AN);
  guard
    return LS;
  finally
    LS := "";
    println("text finally");
  end;
end;

// A record out of a guard in a register
func SmallOf(): Small;
var
  LR: Small;
begin
  LR.A := 1;
  LR.B := 2;
  guard
    return LR;
  finally
    println("small finally");
  end;
end;

// A record out of a guard through the hidden result pointer
func LargeOf(): Large;
var
  LR: Large;
begin
  LR.A := 10;
  LR.B := 20;
  LR.C := 30;
  guard
    return LR;
  finally
    println("large finally");
  end;
end;

// A return out of a guard with only an except part: nothing runs on the way
func ExceptOnly(): int32;
begin
  guard
    return 9;
  except
    println("never");
  end;
  return 0;
end;

var
  GSmall: Small;
  GLarge: Large;

begin
  println("{}", "returns " + IntToStr(Returns()));
  Leaves();
  Skips();
  println("{}", "excepts " + IntToStr(Excepts()));
  println("{}", "nested " + IntToStr(Nested()));
  NestedLeave();
  println("{}", Text(4));
  GSmall := SmallOf();
  println("{}", "small " + IntToStr(GSmall.A) + " " + IntToStr(GSmall.B));
  GLarge := LargeOf();
  println("{}", "large " + IntToStr(GLarge.A) + " " + IntToStr(GLarge.B) + " " +
    IntToStr(GLarge.C));
  println("{}", "exceptonly " + IntToStr(ExceptOnly()));
  guard
    return;
  finally
    println("main finally");
  end;
end.
