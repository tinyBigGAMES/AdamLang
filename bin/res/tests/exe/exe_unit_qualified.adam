-------------------------------------------------------------------------------
  exe_unit_qualified.adam - A unit-qualified name (BNF sec 1: Unit.Name)
  lowers as its bare name does: a std routine call through a dotted unit
  (System.SysUtils.UpperCase), a const, a var read, written, stepped and
  taken the address of, a routine call and a routine value through a
  fixture unit, and the runtime's HeapLive / Halt through System.Runtime.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 3
  | upper AB
  | const 7
  | read 3
  | write 8
  | addr 16
  | step 17
  | call 34
  | value 14
  | live true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_unit_qualified;

@addmodulepath "$P:res/tests/exe/fixtures";

import System.SysUtils, System.Runtime, Qualified;

type
  Doubler = func(const AValue: int32): int32;

var
  GAt: ptr to int32;
  GFn: Doubler;

begin
  println("upper {}", System.SysUtils.UpperCase("ab"));
  println("const {}", Qualified.ADAM_QUAL_BASE);
  println("read {}", Qualified.GCount);
  Qualified.GCount := Qualified.GCount + 5;
  println("write {}", Qualified.GCount);
  GAt := addr of Qualified.GCount;
  GAt^ := GAt^ * 2;
  println("addr {}", Qualified.GCount);
  ++Qualified.GCount;
  println("step {}", Qualified.GCount);
  println("call {}", Qualified.Twice(Qualified.GCount));
  GFn := Qualified.Twice;
  println("value {}", GFn(Qualified.ADAM_QUAL_BASE));
  println("live {}", System.Runtime.HeapLive() >= 0);
  System.Runtime.Halt(3);
end.
