-------------------------------------------------------------------------------
  dll_exports.adam - an exe calling a dll Adam built (PLAN-ADAM M8a): its
  routines imported by `external` from the dll itself (its export table),
  its variable read through its export's address; the dll's initialize
  runs before the exe's block (the loader starts it first), its finalize
  and its own heap report after the exe's report (its unload)
*******************************************************************************/

/*
@@test
  kind run
  deps exe.dll_exports_lib
  exitcode 0
  | dll init
  | add 5
  | counter 5
  | counter 7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | dll final 7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_exports;

@addlibrarypath "$P:output/bin/x86_64-windows-gnu/debug";

import System.Runtime;

routine DllAdd(const AA: int32; const AB: int32): int32; external "dll_exports_lib";
routine DllBump(const AStep: int32); external "dll_exports_lib";

var
  LCounter: ptr to int32;

begin
  println("add {}", DllAdd(2, 3));
  LCounter := ptr to int32(FindLoadedFunction("dll_exports_lib.dll", "DllCounter"));
  println("counter {}", LCounter^);
  DllBump(2);
  println("counter {}", LCounter^);
end.
