/*
@@test
  kind dep
@@end
*/

module dll dll_extvar_lib;

public var
  // The variable the exe reads and writes through its import slot
  ExtCount: int32;

// The variable moved on by 2
public func ExtBump(): int32;
begin
  ExtCount := ExtCount + 2;
  return ExtCount;
end;

initialize
begin
  ExtCount := 7;
  println("extvar dll init");
end;

end.
