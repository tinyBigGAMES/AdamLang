/*
@@test
  kind dep
@@end
*/

module lib lib_link_lib;

public var
  // A variable the exe reads and writes through its external declaration
  LinkTotal: int32;

public routine LinkMul(const AA: int32; const AB: int32): int32;
begin
  return AA * AB;
end;

public routine LinkAdd(const AStep: int32): int32;
begin
  LinkTotal := LinkTotal + AStep;
  return LinkTotal;
end;

initialize
begin
  LinkTotal := 10;
  println("link lib init");
end;

finalize
begin
  println("link lib final {}", LinkTotal);
end;

end.
