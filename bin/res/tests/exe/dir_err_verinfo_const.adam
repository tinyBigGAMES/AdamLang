-------------------------------------------------------------------------------
  dir_err_verinfo_const.adam - Break step of a @vi* constant's name (BNF sec
  2, user 2026-11-16): a variable (SM0123), a string constant for a number
  and an integer constant for a text (SM0123), an integer constant past
  65535 (SM0101), a name nothing declares (SM0021), a name a unit does not
  hold (SM0005), neither a literal nor a name (PR0006), an integer constant
  for @exeicon's path (SM0123); a string constant for a text is clean
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe dir_err_verinfo_const;

@addverinfo on;
@vimajor GCount; // ERROR SM0123@10
@viminor ROW_TEXT; // ERROR SM0123@10
@vipatch ROW_BIG; // ERROR SM0101@10
@viproductname ROW_NUM; // ERROR SM0123@16
@videscription RowMissing; // ERROR SM0021@16
@vifilename System.SysUtils.RowNoSuch; // ERROR SM0005@29
@vicompanyname -1; // ERROR PR0006@16
@vicopyright ROW_TEXT;
@exeicon ROW_NUM; // ERROR SM0123@10

import System.SysUtils;

const
  ROW_TEXT: string = "text";
  ROW_BIG: int32 = 70000;
  ROW_NUM: int32 = 3;

var
  GCount: int32;

begin
  GCount := 0;
end.
