-------------------------------------------------------------------------------
  dir_err_exeicon_noimage.adam - Break step of dir_verinfo: an @exeicon
  file whose icon directory counts no image (fixtures\dir_err_exeicon\
  empty.ico, scripts\adam\make_dir_fixtures.py) is LK0007 at its path,
  exit 1, no exe
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/dir_err_exeicon_noimage.adam" "-o" "."
  exitcode 1
  | <DIR>/dir_err_exeicon_noimage.adam(33,10): Error LK0007: @exeicon: the icon file '<DIR>/fixtures/dir_err_exeicon/empty.ico' holds no image
@@end
*/

module exe dir_err_exeicon_noimage;

@exeicon "$P:res/tests/exe/fixtures/dir_err_exeicon/empty.ico";

begin
end.
