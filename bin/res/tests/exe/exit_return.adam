-------------------------------------------------------------------------------
  exit_return.adam - The exit code by `return E;` in an exe's module body
  (BNF sec 5, M8h): E (a call's int32) is stored into the runtime's
  ExitCode and the body ends there, its defer and every teardown running as
  at the body's end (the finalize reads ExitCode set), no Halt called.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 3
  | main
  | defer runs
  | finalize sees 3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exit_return;

var
  GCount: int32;

// AValue's successor: the code the body returns
routine Pick(const AValue: int32): int32;
begin
  return AValue + 1;
end;

finalize
begin
  println("finalize sees {}", ExitCode);
end;

begin
  defer println("defer runs");
  println("main");
  if GCount = 0 then
    return Pick(2);
  end;
  println("not reached");
end.
