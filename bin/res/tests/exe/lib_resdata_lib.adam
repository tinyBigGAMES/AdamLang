  lib_resdata_lib.adam - the lib of lib_resdata (PLAN-ADAM M8d2): built
  only; it adds "libnote" and "shared" (each 25 bytes, 'H' first) and reports
  what it reads in its host
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module lib lib_resdata_lib;

@addresdata "libnote" "$P:res/tests/std/fixtures/std_resdata_text.txt";
@addresdata "shared" "$P:res/tests/std/fixtures/std_resdata_text.txt";

import System.ResData;

// The count, the lib's own key and the shared one as the lib reads them
public func ResLibReport();
begin
  println("lib count {} libnote {} shared {}", ResDataCount(), FindResData("libnote").Size,
    FindResData("shared").Size);
end;

end.
