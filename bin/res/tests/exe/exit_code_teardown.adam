-------------------------------------------------------------------------------
  exit_code_teardown.adam - ExitCode written by a teardown after the exit
  began (BNF sec 5, M8h): the body returns 2, the finalize sets ExitCode to
  7, and the process ends with 7 once every teardown and the heap report
  have run (the runtime's last exit handler ends it with the new value).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 7
  | main
  | finalize sees 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exit_code_teardown;

finalize
begin
  println("finalize sees {}", ExitCode);
  ExitCode := 7;
end;

begin
  println("main");
  return 2;
end.
