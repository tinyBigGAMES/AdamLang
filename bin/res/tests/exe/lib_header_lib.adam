-------------------------------------------------------------------------------
  lib_header_lib.adam - the lib of lib_header (PLAN-ADAM M8g): built only;
  its C header declares its routines and variables with no import
  specifier (a static library links them as they are): a choices type with
  numbered values, a small and a word set, a static array field and
  variable, a char pointer, a const record pointer, a record ending in a flexible array member
  (M9e0b), an unnamed bitfield (M9e0c), a variadic routine
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module lib lib_header_lib;

public type
  Level = choices(Low = 1, Mid = 5, High = 9);
  Small = set of 0..7;
  Wide = set of 0..99;

  Grid = record
    Cells: array[0..3] of int16;
    Mask: Small;
    Tags: Wide;
    Kind: Level;
  end;

  // padding bitfields (M9e0c): C's unnamed uint8_t : 2
  Flags = record
    A: uint8 : 3;
    _: uint8 : 2;
    B: uint8 : 3;
  end;

  // a flexible array member (M9e0b): C's double Data[]
  Packet = record
    N: int32;
    Data: array[0..] of float64;
  end;

public var
  Table: array[0..2] of int32;
  Total: int64;
  Bits: Flags;

public func Fill(const AText: ptr to char; const ACount: int64);
begin
  if ACount > 0 then
    AText^ := 'a';
  end;
end;

public func Count(const AGrid: ptr to const Grid): int32;
begin
  return int32(AGrid^.Cells[0]);
end;

public func First(const APacket: ptr to const Packet): float64;
begin
  return APacket^.Data[0];
end;

public func Sum(const ACount: int32; ...): int64;
var
  LI: int32;
  LSum: int64;
begin
  LSum := 0;
  for LI := 1 to ACount do
    LSum := LSum + varargs.next(int64);
  end;
  return LSum;
end;

end.
