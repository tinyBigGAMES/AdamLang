-------------------------------------------------------------------------------
  dll_tls.adam - DLL extras (PLAN-ADAM M8c): threadstatics inside a dll
  (dll_tls_lib, linked by its import library) used from four threads the exe
  starts. Each thread finds the dll's int32 at its start (100) and raises it
  twice (100 + i + 1, then 100 + 2 (i + 1)); each fills the dll's managed
  copies (a name, a box). As each thread ends the dll's thread callback
  releases its copies, so all four boxes have ended before the joins return;
  the main thread's copy is untouched (100). The dll's finalize sees the 4
  ended, and neither heap report shows a leak.
*******************************************************************************/

/*
@@test
  kind run
  deps exe.dll_tls_lib
  exitcode 0
  | tls dll init
  | thread 0 101 102 6
  | thread 1 102 104 6
  | thread 2 103 106 6
  | thread 3 104 108 6
  | ended 4
  | main 100
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | tls dll final 4
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_tls;

@addlibrarypath "$P:output/lib/x86_64-windows-gnu/debug";
@linklibrary "dll_tls_lib";

import System.SysUtils, System.Runtime;

func TLSHit(const AStep: int32): int32; external "dll_tls_lib";
func TLSFill(const AIndex: int64): int64; external "dll_tls_lib";
func TLSEnded(): int32; external "dll_tls_lib";

var
  // Each thread's index (its argument points at its own element), its handle, and what it
  // saw: its two counts and its name's length
  GIndex: array[0..3] of int64;
  GThreads: array[0..3] of ptr;
  GFirst: array[0..3] of int32;
  GSecond: array[0..3] of int32;
  GLength: array[0..3] of int64;

// One thread's work; AArg points at its index in GIndex
func Worker(const AArg: ptr);
var
  LIndex: ptr to int64;
  LStep: int32;
begin
  LIndex := ptr to int64(AArg);
  LStep := int32(LIndex^) + 1;
  GFirst[LIndex^] := TLSHit(LStep);
  GSecond[LIndex^] := TLSHit(LStep);
  GLength[LIndex^] := TLSFill(LIndex^);
end;

var
  LI: int32;
begin
  for LI := 0 to 3 do
    GIndex[LI] := LI;
  end;
  for LI := 0 to 3 do
    GThreads[LI] := ThreadStart(Worker, ptr(addr of GIndex[LI]));
  end;
  for LI := 0 to 3 do
    ThreadJoin(GThreads[LI]);
  end;
  for LI := 0 to 3 do
    println("thread {} {} {} {}", LI, GFirst[LI], GSecond[LI], GLength[LI]);
  end;
  println("ended {}", TLSEnded());
  println("main {}", TLSHit(0));
end.
