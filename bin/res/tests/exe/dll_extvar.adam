-------------------------------------------------------------------------------
  dll_extvar.adam - an exe reading and writing a dll's variable (PLAN-ADAM
  M8d2): `external "dll_extvar_lib"` on a variable reaches it through its
  import slot (the import library's data import, `__imp_`), so the exe and
  the dll see one variable
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  deps exe.dll_extvar_lib
  exitcode 0
  | extvar dll init
  | exe sees 7
  | bump 42
  | exe sees 42
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_extvar;

@linklibrary "dll_extvar_lib";

var
  ExtCount: int32; external "dll_extvar_lib";

func ExtBump(): int32; external "dll_extvar_lib";

begin
  println("exe sees {}", ExtCount);
  ExtCount := 40;
  println("bump {}", ExtBump());
  println("exe sees {}", ExtCount);
end.
