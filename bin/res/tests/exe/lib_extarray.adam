-------------------------------------------------------------------------------
  lib_extarray.adam - an external variable of array[0..] of T (PLAN-XML X2c,
  C's `extern T x[];`): the lib's sized arrays bound with no size, read and
  written by an index (unchecked, from 0), and `addr of` the whole one is a
  ptr to its first element (C's decay), indexed and written through; the
  lib's routine sees the exe's writes
*******************************************************************************/

/*
@@test
  kind run
  deps exe.lib_extarray_lib
  exitcode 0
  | text 116 101 120 116 0
  | addr 101 0
  | element 120
  | sum 24
  | ptr sum 51 30
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lib_extarray;

@addlibrarypath "$P:output/lib/x86_64-windows-gnu/debug";
@linklibrary "lib_extarray_lib";

var
  ExtText: array[0..] of uint8; external "lib_extarray_lib";
  ExtWords: array[0..] of int32; external "lib_extarray_lib";
  LText: ptr to uint8;
  LWord: ptr to int32;
  LAt: ptr to uint8;

func ExtWordSum(): int32; external "lib_extarray_lib";

begin
  println("text {} {} {} {} {}", ExtText[0], ExtText[1], ExtText[2], ExtText[3], ExtText[4]);
  // the whole array's address: where its elements start
  LText := addr of ExtText;
  println("addr {} {}", LText[1], LText[4]);
  LAt := addr of ExtText[2];
  println("element {}", LAt^);
  ExtWords[1] := 20;
  println("sum {}", ExtWordSum());
  LWord := addr of ExtWords;
  LWord[2] := 30;
  println("ptr sum {} {}", ExtWordSum(), ExtWords[2]);
end.
