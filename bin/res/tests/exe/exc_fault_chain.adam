-------------------------------------------------------------------------------
  exc_fault_chain.adam - the fault chain every Adam runtime in a process
  shares (System.Runtime.FaultChain, PLAN-LINUX64): a chain of the row's
  own (memory that may run, mapped here) found by its stub and nothing
  else; its stub calls the fallback while no runtime holds the slot, the
  first joined runtime's dispatch once one joins, the next one's when the
  first leaves, the fallback again once the last leaves; a pc is taken by
  the runtime whose range holds it; a full chain joins nothing until a
  mapping is added; nothing is left in flight
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | mapped true
  | found true
  | other nil true
  | fallback 42
  | slot 7
  | slot kept 7
  | take hit true
  | take miss true
  | first left false
  | slot moved 8
  | last left true
  | fallback again 42
  | full nil true
  | extended true
  | settled 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_fault_chain;

import System.Runtime.FaultChain;

type
  // The stub's call as a routine value: what it calls answers
  StubFn = func(): int32;

@ifdef TARGET_X86_64_LINUX_GNU
// glibc: memory mapped
func mmap(const AAddress: ptr; const ALength: uint64; const AProtection: int32;
  const AFlags: int32; const AFile: int32; const AOffset: int64): ptr; external "c";

const
  // sys/mman.h: read, write and run; private and anonymous; the stub's stack step (SysV)
  PROT_ALL: int32 = 7;
  MAP_PRIVATE_ANONYMOUS: int32 = 0x22;
  ADAM_ROW_STACK_STEP: uint8 = 8;
@else
// kernel32: memory reserved and committed with its protection
func VirtualAlloc(const AAddress: ptr; const ASize: uint64; const AType: uint32;
  const AProtect: uint32): ptr; external "kernel32";

const
  // winnt.h: commit + reserve, read / write / execute; the stub's stack step (Win64)
  MEM_COMMIT_RESERVE: uint32 = 0x3000;
  PAGE_EXECUTE_READWRITE: uint32 = 0x40;
  ADAM_ROW_STACK_STEP: uint8 = 40;
@endif

// A chain's mapping: ADAM_FAULT_CHAIN_SIZE zeroed bytes that may run
func MapChain(): ptr;
var
  LMap: ptr;
begin
@ifdef TARGET_X86_64_LINUX_GNU
  LMap := mmap(nil, ADAM_FAULT_CHAIN_SIZE, PROT_ALL, MAP_PRIVATE_ANONYMOUS, -1, 0);
  if uint64(LMap) = 0xFFFFFFFFFFFFFFFF then
    return nil;
  end;
  return LMap;
@else
  return VirtualAlloc(nil, ADAM_FAULT_CHAIN_SIZE, MEM_COMMIT_RESERVE, PAGE_EXECUTE_READWRITE);
@endif
end;

// The two dispatches the slot calls through the stub
func Seven(): int32;
begin
  return 7;
end;

func Eight(): int32;
begin
  return 8;
end;

// FaultChainSettle's yield (nothing is in flight: never called)
func NoYield();
begin
  println("yield");
end;

var
  LMap: ptr;
  LMore: ptr;
  LChain: ptr to FaultChain;
  LStub: StubFn;
  LSeven: StubFn;
  LEight: StubFn;
  LFirst: ptr to FaultChainEntry;
  LSecond: ptr to FaultChainEntry;
  LEntries: array[0..376] of ptr to FaultChainEntry;
  LExtra: ptr to FaultChainEntry;
  LAt: int64;
  LI: int64;

begin
  LMap := MapChain();
  println("mapped {}", LMap <> nil);
  if LMap = nil then
    return 1;
  end;
  LStub := StubFn(FaultChainMake(LMap, ADAM_ROW_STACK_STEP));
  LChain := ptr to FaultChain(LMap);
  // the fallback: mov eax, 42; ret
  LAt := 0;
  FaultChainSpareByte(LChain, LAt, 0xB8);
  FaultChainSpareByte(LChain, LAt, 42);
  FaultChainSpareByte(LChain, LAt, 0);
  FaultChainSpareByte(LChain, LAt, 0);
  FaultChainSpareByte(LChain, LAt, 0);
  FaultChainSpareByte(LChain, LAt, 0xC3);
  FaultChainSpareDone(LChain);
  println("found {}", FaultChainOf(ptr(LStub)) = LChain);
  LSeven := Seven;
  LEight := Eight;
  println("other nil {}", FaultChainOf(ptr(LSeven)) = nil);
  println("fallback {}", LStub());
  LFirst := FaultChainJoin(LChain, 0, 0, nil, ptr(LSeven));
  println("slot {}", LStub());
  // a second runtime: its range 0x1000 .. 0x2000, its taker the chain itself (any mark)
  LSecond := FaultChainJoin(LChain, 0x1000, 0x2000, ptr(LChain), ptr(LEight));
  println("slot kept {}", LStub());
  println("take hit {}", FaultChainTake(LChain, 0x1800) = ptr(LChain));
  println("take miss {}", FaultChainTake(LChain, 0x2000) = nil);
  println("first left {}", FaultChainLeave(LChain, LFirst));
  println("slot moved {}", LStub());
  println("last left {}", FaultChainLeave(LChain, LSecond));
  println("fallback again {}", LStub());
  // every entry of the one mapping joined: the next join finds none until one is added
  for LI := 0 to ADAM_FAULT_CHAIN_ENTRIES - 1 do
    LEntries[LI] := FaultChainJoin(LChain, 0, 0, nil, ptr(LSeven));
  end;
  println("full nil {}", FaultChainJoin(LChain, 0, 0, nil, ptr(LSeven)) = nil);
  LMore := MapChain();
  FaultChainExtend(LChain, LMore);
  LExtra := FaultChainJoin(LChain, 0, 0, nil, ptr(LSeven));
  println("extended {}", (LExtra <> nil) and (uint64(LExtra) >= uint64(LMore)));
  FaultChainLeave(LChain, LExtra);
  for LI := 0 to ADAM_FAULT_CHAIN_ENTRIES - 1 do
    FaultChainLeave(LChain, LEntries[LI]);
  end;
  FaultChainSettle(LChain, NoYield);
  println("settled {}", LChain^.InFlight);
end.
