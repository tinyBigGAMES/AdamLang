-------------------------------------------------------------------------------
  exc_message.adam - exccode() / excmsg() read this thread's raise in flight
  (BNF sec 7): 0 and "" before any raise; raise's code 1 and its text, and
  raisecode's own code and text, in the except block; still the last one
  after the guard; a message kept in a variable across the next raise; a
  raised FormatStr text read back each pass of a loop. Leaked 0: every
  message is a reference released.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0 []
  | 1 boom
  | 7 seven
  | 7 seven
  | seven again
  | n1n2n3
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_message;

routine Messages();
var
  LKept: string;
  LAll: string;
  LI: int32;
begin
  println("{} [{}]", exccode(), excmsg());
  guard
    raise("boom");
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    raisecode(7, "seven");
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("{} {}", exccode(), excmsg());
  LKept := excmsg();
  guard
    raise("again");
  except
    println("{} {}", LKept, excmsg());
  end;
  LAll := "";
  for LI := 1 to 3 do
    guard
      raise(FormatStr("n{}", LI));
    except
      LAll := LAll + excmsg();
    end;
  end;
  println("{}", LAll);
end;

begin
  Messages();
end.
