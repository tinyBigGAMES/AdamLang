-------------------------------------------------------------------------------
  exc_message.adam - exccode() / excmsg() read the exception an except body
  handles (BNF sec 7; outside one they are SM0615): raise's code 1 and its
  text, and raisecode's own code and text, in the except block; a message
  kept in a variable across the next raise; a
  raised FormatStr text read back each pass of a loop. Leaked 0: every
  message is a reference released.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | 1 boom
  | 7 seven
  | seven again
  | n1n2n3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_message;

func Messages();
var
  LKept: string;
  LAll: string;
  LI: int32;
begin
  guard
    raise("boom");
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    raisecode(7, "seven");
  except
    println("{} {}", exccode(), excmsg());
    LKept := excmsg();
  end;
  guard
    raise("again");
  except
    println("{} {}", LKept, excmsg());
  end;
  LAll := "";
  for LI := 1 to 3 do
    guard
      raise(FormatStr("n{}", LI));
    except
      LAll := LAll + excmsg();
    end;
  end;
  println("{}", LAll);
end;

begin
  Messages();
end.
