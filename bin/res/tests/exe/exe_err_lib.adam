  exe_err_lib.adam - Break step of exe: adam build on a lib module stops at
  its header (DR0009: lib output comes with M8d), exit 1, nothing written
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/exe_err_lib.adam" "-o" "."
  exitcode 1
  | <DIR>/exe_err_lib.adam(29,1): Error DR0009: adam build makes exe and dll modules so far, and 'exe_err_lib' is a lib module
@@end
*/

module lib exe_err_lib;

end.
