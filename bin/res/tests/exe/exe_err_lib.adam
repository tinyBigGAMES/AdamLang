-------------------------------------------------------------------------------
  exe_err_lib.adam - Break step of exe: adam build -r on a lib module (PLAN-ADAM
  M8d; DR0009 before it): its static libraries are written, nothing runs (a
  lib runs only inside a program that links it): CL0023, a warning, and the
  build's exit code 0
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/exe_err_lib.adam" "-o" "." "-r"
  exitcode 0
  | Warning CL0023: '<OUT>/lib/<CELL>/libexe_err_lib.a' was built but not run: a lib runs only inside a program that links it
@@end
*/

module lib exe_err_lib;

public func ErrLibValue(): int32;
begin
  return 3;
end;

end.
