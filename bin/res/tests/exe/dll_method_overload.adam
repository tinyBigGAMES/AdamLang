-------------------------------------------------------------------------------
  dll_method_overload.adam - overloaded methods across a dll (PLAN-ADAM MO1b): the
  dll's object types declared external, each overload its own symbol: by
  count (Grow, Grow(step), Grow(step, times)), by type (Describe of an
  int64, a float64, a bool), a virtual pair (Measure, Measure(scale))
  through the object, a ref of the parent and the interface; Square
  overriding one of the pair, the other inherited from the dll
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  deps exe.dll_method_overload_lib
  exitcode 0
  | grow 6
  | grow1 9
  | grow2 15
  | describe 1 2 3
  | measure 15 150
  | via 15 30
  | square 100 12
  | square ref 100 12
  | square via 100 8
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_method_overload;

type
  IMeasure = interface
    method Measure(): int64;
    method Measure(const AScale: int64): int64;
  end; external "dll_method_overload_lib";

  Shape = object implements IMeasure
    FSize: int64;

    init(const ASize: int64);
    method Grow(): int64;
    method Grow(const AStep: int64): int64;
    method Grow(const AStep: int64; const ATimes: int64): int64;
    method Describe(const AX: int64): int64;
    method Describe(const AX: float64): int64;
    method Describe(const AX: bool): int64;
    virtual method Measure(): int64;
    virtual method Measure(const AScale: int64): int64;
  end; external "dll_method_overload_lib";

  Square = object(Shape)
    init(const ASize: int64);
    override method Measure(): int64;
  end; external "dll_method_overload_lib";

func Via(const AM: IMeasure; const AScale: int64): string;
begin
  return FormatStr("{} {}", AM.Measure(), AM.Measure(AScale));
end;

func UseShape();
var
  LS: Shape(5);
begin
  println("grow {}", LS.Grow());
  println("grow1 {}", LS.Grow(int64(3)));
  println("grow2 {}", LS.Grow(int64(2), int64(3)));
  println("describe {} {} {}", LS.Describe(int64(7)), LS.Describe(7.5), LS.Describe(true));
  println("measure {} {}", LS.Measure(), LS.Measure(int64(10)));
  println("via {}", Via(LS, 2));
end;

func UseSquare();
var
  LQ: Square(4);
  LR: ref Shape;
begin
  println("square {} {}", LQ.Measure(), LQ.Measure(int64(3)));
  LR := ref Square(4);
  println("square ref {} {}", LR.Measure(), LR.Measure(int64(3)));
  println("square via {}", Via(LQ, 2));
  LR := nil;
end;

begin
  UseShape();
  UseSquare();
end.
