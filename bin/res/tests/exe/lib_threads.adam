-------------------------------------------------------------------------------
  lib_threads.adam - a lib in its host (PLAN-ADAM M8d2): the lib's unit and
  the exe each have a managed threadstatic; each unit's start adds its own
  thread release to the runtime's one list, so a thread the exe starts that
  sets both ends with both copies released (Leaked 0), not only the host's
*******************************************************************************/

/*
@@test
  kind run
  deps exe.lib_threads_lib
  exitcode 0
  | thread 0 lib 0 exe 0
  | thread 1 lib 1 exe 1
  | main lib 9 exe 9
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lib_threads;

@addlibrarypath "$P:output/lib/x86_64-windows-gnu/debug";
@linklibrary "lib_threads_lib";

import System.SysUtils, System.Runtime;

func ThreadsSet(const AIndex: int64); external "lib_threads_lib";
func ThreadsGet(): string; external "lib_threads_lib";

threadstatic
  // The exe's own managed copy per thread
  GExeName: string;

var
  GIndex: array[0..1] of int64;
  GThreads: array[0..1] of ptr;
  GSeen: array[0..1] of string;

// One thread's work: both copies set, then read back; AArg points at its index
func Worker(const AArg: ptr);
var
  LIndex: ptr to int64;
begin
  LIndex := ptr to int64(AArg);
  ThreadsSet(LIndex^);
  GExeName := "exe " + IntToStr(LIndex^);
  GSeen[LIndex^] := ThreadsGet() + " " + GExeName;
end;

var
  LI: int32;
begin
  for LI := 0 to 1 do
    GIndex[LI] := LI;
    GThreads[LI] := ThreadStart(Worker, ptr(addr of GIndex[LI]));
    ThreadJoin(GThreads[LI]);
  end;
  for LI := 0 to 1 do
    println("thread {} {}", LI, GSeen[LI]);
  end;
  ThreadsSet(9);
  GExeName := "exe 9";
  println("main {} {}", ThreadsGet(), GExeName);
end.
