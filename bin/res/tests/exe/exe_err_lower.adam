  exe_err_lower.adam - Break step of exe: adam build stops at what code
  generation does not handle yet (LW0001 at its node), exit 1, no exe
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "<DIR>/exe_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/exe_err_lower.adam(32,24): Error LW0001: code generation does not handle a print argument of type 'int32' yet
@@end
*/

module exe exe_err_lower;

begin
  println("{} apples", 5);
end.
