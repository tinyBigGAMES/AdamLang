-------------------------------------------------------------------------------
  exe_err_lower.adam - Break step of exe: a program that builds clean in
  the front end but whose link cannot finish stops in the backend: an
  external routine with no library, called, names a symbol nothing in the
  program defines, so the linker reports it at that declaration (LK0001),
  exit 1, no exe
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/exe_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/exe_err_lower.adam(34,1): Error LK0001: 'adam_exe_err_lower_nowhere' is used, but nothing in the program defines it
@@end
*/

module exe exe_err_lower;

routine clink adam_exe_err_lower_nowhere(): int32; external;

begin
  println("{}", adam_exe_err_lower_nowhere());
end.
