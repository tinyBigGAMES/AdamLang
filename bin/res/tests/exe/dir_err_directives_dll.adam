  dir_err_directives_dll.adam - Break step of build directives (AUD4 5.8): a
  setting a dll cannot take is the warning SM0103 and is not applied
  (@exeicon, @subsystem gui); @subsystem console, @addverinfo on and a @vi*
  with it are taken
*******************************************************************************/

/*
@@test
  kind check
@@end
*/

module dll dir_err_directives_dll;

@exeicon "$P:res/tests/exe/fixtures/dir_exeicon_noext/app"; // WARN SM0103@1
@subsystem gui; // WARN SM0103@1
@addverinfo on;
@vimajor 65535;
@viproductname "Directives";

end.
