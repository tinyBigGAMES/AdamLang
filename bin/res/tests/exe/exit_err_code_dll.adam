-------------------------------------------------------------------------------
  exit_err_code_dll.adam - Break step of exit_code_unit (BNF sec 5, M8h): a
  dll's own module writing ExitCode is the warning SM0628 (its host owns
  the exit code), a read is not; a value returned from its initialize stays
  SM0611.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module dll exit_err_code_dll;

public func Code(): int32;
begin
  ExitCode := 4; // WARN SM0628@3
  ExitCode += 1; // WARN SM0628@3
  return ExitCode;
end;

initialize
begin
  return 1; // ERROR SM0611@10
end;

end.
