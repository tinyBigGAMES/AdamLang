-------------------------------------------------------------------------------
  dll_halt.adam - DLL extras (PLAN-ADAM M8c): Halt from a dll (dll_halt_lib)
  ends the process with its code (3): nothing after the call runs; the exe's
  exit handlers run first (its heap report), then the dll's at its unload
  (its finalize, then its heap report), each once (BNF sec 1 teardown)
*******************************************************************************/

/*
@@test
  kind run
  deps exe.dll_halt_lib
  exitcode 3
  | halt dll init
  | exe before
  | dll halt 3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | halt dll final
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_halt;

@addlibrarypath "$P:output/lib/x86_64-windows-gnu/debug";
@linklibrary "dll_halt_lib";

routine HaltNow(const ACode: int32); external "dll_halt_lib";

begin
  println("exe before");
  HaltNow(3);
  println("exe after");
end.
