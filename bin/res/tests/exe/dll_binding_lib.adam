  dll_binding_lib.adam - the dll of dll_binding (PLAN-ADAM MO1b0 d): built
  only; its build writes the binding unit dll_binding_lib.adam beside its C
  header: a constant, a record, an interface with a property, an object
  implementing it (init, a virtual, an overloaded pair, a dispatched property
  with a body read), a variable and routines
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_binding_lib;

public const
  STEP: int32 = 3;

public var
  Made: int32;

public type
  Pair = record
    A: int32;
    B: int32;
  end;

  IShape = interface
    method Area(): int32;
    property Sides: int32 read;
  end;

  Shape = object implements IShape
    FSide: int32;

    init(const ASide: int32);
    begin
      self.FSide := ASide;
      Made := Made + 1;
    end;

    virtual method Area(): int32;
    begin
      return self.FSide * self.FSide;
    end;

    method Grow(): int32;
    begin
      self.FSide := self.FSide + STEP;
      return self.FSide;
    end;

    method Grow(const AStep: int32): int32;
    begin
      self.FSide := self.FSide + AStep;
      return self.FSide;
    end;

    virtual property Sides: int32 read
      begin
        return 4;
      end;
  end;

public routine MakePair(const AA: int32; const AB: int32): Pair;
begin
  return Pair(A: AA, B: AB);
end;

public routine Total(const AP: Pair): int32;
begin
  return AP.A + AP.B;
end;

end.
