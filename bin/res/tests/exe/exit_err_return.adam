-------------------------------------------------------------------------------
  exit_err_return.adam - Break step of exit_return (BNF sec 5, M8h): a
  value returned from an initialize, a finalize or a routine with no
  result stays SM0611; a value that does not convert to ExitCode's int32
  (a string) is refused at the value.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe exit_err_return;

// No result: a value is SM0611 here as before
routine Nothing();
begin
  return 1; // ERROR SM0611@10
end;

initialize
begin
  return 1; // ERROR SM0611@10
end;

finalize
begin
  return 1; // ERROR SM0611@10
end;

begin
  Nothing();
  return "three"; // ERROR SM0200@10
end.
