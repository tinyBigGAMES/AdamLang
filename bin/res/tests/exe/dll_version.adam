-------------------------------------------------------------------------------
  dll_version.adam - DLL extras (PLAN-ADAM M8c): @addverinfo on a dll, read
  back as the OS reads it: version.dll finds the version resource of
  dll_version_lib.dll (beside this exe), its VS_FIXEDFILEINFO (file and
  product version 4.5.6.0, file type VFT_DLL), the StringTable 040904B0's
  eight texts (InternalName the file name without its extension) and the
  Translation 0x0409 / 1200
*******************************************************************************/

/*
@@test
  kind run
  deps exe.dll_version_lib
  exitcode 0
  | ok path
  | ok version size
  | ok version read
  | ok fixed signature
  | ok file version 4.5.6.0
  | ok product version 4.5.6.0
  | ok file type dll
  | CompanyName = tinyBigGAMES LLC
  | FileDescription = Dll version row
  | FileVersion = 4.5.6.0
  | InternalName = dll_version_lib
  | LegalCopyright = Copyright (c) 2026 tinyBigGAMES LLC
  | OriginalFilename = dll_version_lib.dll
  | ProductName = Adam Rows
  | ProductVersion = 4.5.6.0
  | ok translation 0409 04B0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_version;

import System.SysUtils, System.IO, System.Windows;

// version.dll's reader: the OS reads the dll's resources
func clink GetFileVersionInfoSizeW(var AFileName: WideBuffer; AHandle: ptr): uint32;
  external "version";
func clink GetFileVersionInfoW(var AFileName: WideBuffer; AHandle: uint32; ALength: uint32;
  AData: ptr): int32; external "version";
func clink VerQueryValueW(AData: ptr; var ASubBlock: WideBuffer; var AValue: ptr;
  var ALength: uint32): int32; external "version";

const
  // VS_FIXEDFILEINFO's signature, where its dwFileType is, VFT_DLL
  ADAM_ROW_FIXED_SIGNATURE: uint64 = 0xFEEF04BD;
  ADAM_ROW_FILE_TYPE_AT: int64 = 36;
  ADAM_ROW_VFT_DLL: uint64 = 2;

var
  GFails: int32;
  // The dll's path and a query's sub-block as Win32 reads them, a value's text
  GPath: WideBuffer;
  GSub: WideBuffer;
  GText: WideBuffer;
  // The version resource as GetFileVersionInfoW copies it
  GData: ByteArray;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// Where AValue (a pointer VerQueryValueW gave) is in GData
func OffsetOf(const AValue: ptr): int64;
begin
  return int64(uint64(AValue) - uint64(addr of GData[0]));
end;

// The value of ASubBlock in GData and its length (VerQueryValueW's: units for a text, bytes
// for binary data); -1 when it is not there
func Query(const ASubBlock: string; var ALength: uint32): int64;
var
  LValue: ptr;
begin
  LValue := nil;
  ALength := 0;
  if not Utf8ToWide(ASubBlock, GSub) then
    return -1;
  end;
  if VerQueryValueW(addr of GData[0], GSub, LValue, ALength) = 0 then
    return -1;
  end;
  return OffsetOf(LValue);
end;

// The text the StringTable 040904B0 holds for AKey, "" when it holds none
func StringOf(const AKey: string): string;
var
  LAt: int64;
  LLength: uint32;
  LI: int64;
begin
  LAt := Query("\\StringFileInfo\\040904B0\\" + AKey, LLength);
  if (LAt < 0) or (LLength = 0) then
    return "";
  end;
  for LI := 0 to int64(LLength) - 1 do
    GText[LI] := uint16(GetLe(GData, LAt + 2 * LI, 2));
  end;
  // LLength counts the NUL
  return WideToUtf8(GText, int32(LLength) - 1);
end;

// "major.minor.patch.build" of a VS_FIXEDFILEINFO version pair at AAt
func VersionAt(const AAt: int64): string;
var
  LHigh: int64;
  LLow: int64;
begin
  LHigh := int64(GetLe(GData, AAt, 4));
  LLow := int64(GetLe(GData, AAt + 4, 4));
  return IntToStr(LHigh shr 16) + "." + IntToStr(LHigh & 0xFFFF) + "." + IntToStr(LLow shr 16) +
    "." + IntToStr(LLow & 0xFFFF);
end;

// The rows (see the header)
func Run();
var
  LSize: uint32;
  LFixed: int64;
  LLength: uint32;
  LAt: int64;
  LKeys: StringArray;
  LI: int64;
begin
  // the dll the row's dep built sits beside this exe
  Check("path", Utf8ToWide(ExtractFileDir(ProgramFilePath()) + "\\dll_version_lib.dll", GPath));
  LSize := GetFileVersionInfoSizeW(GPath, nil);
  Check("version size", LSize > 0);
  if LSize = 0 then
    return;
  end;
  setlength(GData, int64(LSize));
  Check("version read", GetFileVersionInfoW(GPath, 0, LSize, addr of GData[0]) <> 0);
  LFixed := Query("\\", LLength);
  Check("fixed signature", (LFixed >= 0) and (GetLe(GData, LFixed, 4) = ADAM_ROW_FIXED_SIGNATURE));
  if LFixed < 0 then
    return;
  end;
  Check("file version " + VersionAt(LFixed + 8), VersionAt(LFixed + 8) = "4.5.6.0");
  Check("product version " + VersionAt(LFixed + 16), VersionAt(LFixed + 16) = "4.5.6.0");
  Check("file type dll", GetLe(GData, LFixed + ADAM_ROW_FILE_TYPE_AT, 4) = ADAM_ROW_VFT_DLL);
  LKeys := SplitString("CompanyName FileDescription FileVersion InternalName LegalCopyright " +
    "OriginalFilename ProductName ProductVersion", " ");
  for LI := 0 to len(LKeys) - 1 do
    println("{} = {}", LKeys[LI], StringOf(LKeys[LI]));
  end;
  LAt := Query("\\VarFileInfo\\Translation", LLength);
  if (LAt < 0) or (LLength <> 4) then
    Check("translation", false);
  else
    Check("translation " + IntToHex(GetLe(GData, LAt, 2), 4) + " " +
      IntToHex(GetLe(GData, LAt + 2, 2), 4),
      (GetLe(GData, LAt, 2) = 0x0409) and (GetLe(GData, LAt + 2, 2) = 1200));
  end;
end;

begin
  GFails := 0;
  Run();
  if GFails > 0 then
    println("fails {}", GFails);
  end;
end.
