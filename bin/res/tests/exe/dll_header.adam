-------------------------------------------------------------------------------
  dll_header.adam - a dll build writes its C header (PLAN-ADAM M8g):
  dll_header_lib.h in the output folder's lib\<triple>\debug\
  beside its import library, read back here line by line ('>' before each, a
  comment's ends as *\/ and /\*): the include guard, the includes and the
  macros, extern "C" for C++, the struct and union typedefs, every type as
  Adam lays it out with its size, alignment and offset checks, then each
  exported routine and variable with __adam_dllimport (__declspec(dllimport)
  under _WIN32, empty elsewhere: one header text on every target), or a
  comment saying why C cannot declare it
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  deps exe.dll_header_lib
  exitcode 0
  | >/\* dll_header_lib.h - the C interface of the Adam dll dll_header_lib, written by adam: do not edit *\/
  | >
  | >#ifndef __adam_dll_header_lib_h
  | >#define __adam_dll_header_lib_h
  | >
  | >#include <stddef.h>
  | >#include <stdint.h>
  | >#include <stdbool.h>
  | >
  | >#ifndef __adam_c_header
  | >#define __adam_c_header
  | >#ifdef __cplusplus
  | >#define __adam_static_assert static_assert
  | >#define __adam_alignof alignof
  | >#define __adam_alignas alignas
  | >#define __adam_noreturn [[noreturn]]
  | >#else
  | >#define __adam_static_assert _Static_assert
  | >#define __adam_alignof _Alignof
  | >#define __adam_alignas _Alignas
  | >#define __adam_noreturn _Noreturn
  | >#endif
  | >#ifdef _WIN32
  | >#define __adam_dllimport __declspec(dllimport)
  | >#else
  | >#define __adam_dllimport
  | >#endif
  | >#endif
  | >
  | >#ifdef __cplusplus
  | >extern "C" {
  | >#endif
  | >
  | >typedef struct Point Point;
  | >typedef struct Node Node;
  | >typedef struct Packet Packet;
  | >typedef struct Bits Bits;
  | >typedef union Number Number;
  | >
  | >struct Point {
  | >  int32_t X;
  | >  int32_t Y;
  | >};
  | >__adam_static_assert(sizeof(Point) == 8, "Point: Adam's size");
  | >__adam_static_assert(__adam_alignof(Point) == 4, "Point: Adam's alignment");
  | >__adam_static_assert(offsetof(Point, X) == 0, "Point.X: Adam's offset");
  | >__adam_static_assert(offsetof(Point, Y) == 4, "Point.Y: Adam's offset");
  | >
  | >struct Node {
  | >  Node *Next;
  | >  int32_t Value;
  | >};
  | >__adam_static_assert(sizeof(Node) == 16, "Node: Adam's size");
  | >__adam_static_assert(__adam_alignof(Node) == 8, "Node: Adam's alignment");
  | >__adam_static_assert(offsetof(Node, Next) == 0, "Node.Next: Adam's offset");
  | >__adam_static_assert(offsetof(Node, Value) == 8, "Node.Value: Adam's offset");
  | >
  | >typedef int32_t Shade;
  | >enum {
  | >  Shade_Dark = 0,
  | >  Shade_Light = 1
  | >};
  | >
  | >#pragma pack(push, 1)
  | >struct Packet {
  | >  uint8_t Tag;
  | >  uint32_t Size;
  | >};
  | >#pragma pack(pop)
  | >__adam_static_assert(sizeof(Packet) == 5, "Packet: Adam's size");
  | >__adam_static_assert(__adam_alignof(Packet) == 1, "Packet: Adam's alignment");
  | >__adam_static_assert(offsetof(Packet, Tag) == 0, "Packet.Tag: Adam's offset");
  | >__adam_static_assert(offsetof(Packet, Size) == 1, "Packet.Size: Adam's offset");
  | >
  | >struct Bits {
  | >  uint32_t Low : 3;
  | >  uint32_t High : 5;
  | >  int64_t Count;
  | >};
  | >__adam_static_assert(sizeof(Bits) == 16, "Bits: Adam's size");
  | >__adam_static_assert(__adam_alignof(Bits) == 8, "Bits: Adam's alignment");
  | >__adam_static_assert(offsetof(Bits, Count) == 8, "Bits.Count: Adam's offset");
  | >
  | >union Number {
  | >  int64_t I;
  | >  double F;
  | >};
  | >__adam_static_assert(sizeof(Number) == 8, "Number: Adam's size");
  | >__adam_static_assert(__adam_alignof(Number) == 8, "Number: Adam's alignment");
  | >__adam_static_assert(offsetof(Number, I) == 0, "Number.I: Adam's offset");
  | >__adam_static_assert(offsetof(Number, F) == 0, "Number.F: Adam's offset");
  | >
  | >extern __adam_dllimport int32_t Counter;
  | >extern __adam_dllimport Point Origin;
  | >/\* Title: not declared, its type has no C form *\/
  | >extern __adam_dllimport int32_t Add(int32_t AX, int32_t AY);
  | >extern __adam_dllimport Point Mid(Point AA, Point AB);
  | >extern __adam_dllimport void Scale(Point *AP, double AFactor);
  | >extern __adam_dllimport int32_t Walk(const Node *AFirst);
  | >extern __adam_dllimport int32_t Apply(int32_t (*AFn)(int32_t), int32_t AValue);
  | >extern __adam_dllimport bool Pick(Shade AShade, Packet APacket, Bits ABits, Number ANumber);
  | >__adam_noreturn extern __adam_dllimport void Quit(int32_t ACode);
  | >/\* Greet: not declared, the type of parameter AName has no C form *\/
  | >/\* Twice: not declared, C++ linkage (cpplink): its symbol is an Itanium name *\/
  | >
  | >#ifdef __cplusplus
  | >}
  | >#endif
  | >
  | >#endif
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_header;

import System.SysUtils, System.IO;

const
  // The header, from the exe's folder (<output>\bin\<triple>\<mode>)
@ifdef TARGET_X86_64_LINUX_GNU
  HEADER_PATH: string = "$P:../../../lib/x86_64-linux-gnu/debug/dll_header_lib.h";
@else
  HEADER_PATH: string = "$P:../../../lib/x86_64-windows-gnu/debug/dll_header_lib.h";
@endif

var
  GText: string;
  GLines: StringArray;
  GI: int64;

begin
  if not ReadAllText(HEADER_PATH, GText) then
    println("no header");
    return;
  end;
  GLines := SplitString(GText, "\n");
  for GI := 0 to len(GLines) - 1 do
    if (GI < len(GLines) - 1) or (GLines[GI] <> "") then
      // a comment's ends written *\/ and /\*: this file's own comment holds the expected
      // lines
      println(">{}", ReplaceStr(ReplaceStr(GLines[GI], "*/", "*\\/"), "/*", "/\\*"));
    end;
  end;
end.
