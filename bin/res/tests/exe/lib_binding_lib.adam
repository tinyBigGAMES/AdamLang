/*
@@test
  kind dep
@@end
*/

module lib lib_binding_lib;

import System.SysUtils, System.Zlib.Ext;

public const
  LIMIT: int32 = 40 + 2;
  LABEL_TEXT: string = "tab\there \"q\" \\ end\n";
  RATIO: float64 = 1.5;
  HALF: float32 = 0.5f;
  WHOLE: float64 = 2.0;
  FLAG: bool = true;
  LETTER: char = 'A';
  QUOTE_CHAR: char = '\'';
  BIG: uint64 = 18446744073709551615u;
  LOWEST: int64 = -9223372036854775807 - 1;

public type
  Color = choices(Red, Green = 5, Blue);
  Colors = set of Color;
  Point = record
    X: int32;
    Y: int32;
  end;
  Flags = record packed
    A: uint8 : 3;
    B: uint8 : 5;
  end;
  Tagged = record
    Kind: int32;
    u: overlay
      I: int64;
      F: float64;
    end;
  end;
  Grid = array[0..3] of int32;
  PointPtr = ptr to Point;
  Combine = func(const AX: int32; const AY: int32): int32;

public const
  ORIGIN: Point = Point(X: 1, Y: 2);
  PRIMES: Grid = [2, 3, 5, 7];
  WARM: Colors = [Color.Red, Color.Green];
  DEFAULT_COLOR: Color = Color.Blue;

public var
  Greeting: string;
  Calls: int32;

public type
  ICounter = interface
    method Next(): int32;
  end;

  Counter = object implements ICounter
    hidden FValue: int32;
    FStep: int32;

    init(const AStart: int32);
    begin
      self.FValue := AStart;
      self.FStep := 1;
    end;

    done;
    begin
      Calls := Calls + 100;
    end;

    virtual method Next(): int32;
    begin
      self.FValue := self.FValue + self.FStep;
      return self.FValue;
    end;

    method Add(const AX: int32): int32;
    begin
      self.FValue := self.FValue + AX;
      return self.FValue;
    end;

    method Add(const AX: int32; const AY: int32): int32;
    begin
      self.FValue := self.FValue + AX * AY;
      return self.FValue;
    end;

    property Value: int32 read FValue;
    property Twice: int32 read
      begin
        return self.FValue * 2;
      end;
      write(AValue)
      begin
        self.FValue := AValue div 2;
      end;
  end;

public func Sum(const AX: int32; const AY: int32): int32;
begin
  Calls := Calls + 1;
  return AX + AY;
end;

public func Scale(const AX: int64): int64;
begin
  return AX * 10;
end;

public func Scale(const AX: float64): float64;
begin
  return AX * 0.5;
end;

public func Apply(const AF: Combine; const AX: int32; const AY: int32): int32;
begin
  return AF(AX, AY);
end;

public func Words(const AText: string): StringArray;
begin
  return SplitString(AText, " ");
end;

public func FormatCode(const AFormat: ZlibFormat): int32;
begin
  if AFormat = ZlibFormat.Gzip then
    return 1;
  end;
  return 0;
end;

initialize
begin
  Greeting := "hello";
  Calls := 0;
end;

finalize
begin
  println("lib final {}", Calls);
end;

end.
