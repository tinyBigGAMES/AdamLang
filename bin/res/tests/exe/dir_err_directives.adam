  dir_err_directives.adam - Break step of build directives (AUD4 5.8): a
  single-valued directive given twice (SM0102), a value a directive does not
  take, exact case (SM0100), a @vi* number past 65535 (SM0101), a @vi*
  without @addverinfo on (the warning SM0104), @breakpoint in the prologue
  (the warning SM0109), and @addresdata keys: empty or holding a control
  character (SM0119), with the compiler's prefix adam/ (SM0120), added twice
  (SM0121)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe dir_err_directives;

@outputpath "$P:output";
@outputpath "$P:output"; // ERROR SM0102@1
@subsystem Console; // ERROR SM0100@12
@unitTestMode yes; // ERROR SM0100@15
@addverinfo yes; // ERROR SM0100@13
@vimajor 70000; // ERROR SM0101@10  // WARN SM0104@1
@viminor 2; // WARN SM0104@1
@breakpoint; // WARN SM0109@1
@addresdata "" "$P:res/tests/exe/fixtures/MessageUnit.adam"; // ERROR SM0119@13
@addresdata "a\tb" "$P:res/tests/exe/fixtures/MessageUnit.adam"; // ERROR SM0119@13
@addresdata "adam/icon" "$P:res/tests/exe/fixtures/MessageUnit.adam"; // ERROR SM0120@13
@addresdata "hello" "$P:res/tests/exe/fixtures/MessageUnit.adam";
@addresdata "hello" "$P:res/tests/exe/fixtures/MessageUnit.adam"; // ERROR SM0121@13

begin
end.
