-------------------------------------------------------------------------------
  dir_err_copydll_ext.adam - Break step of dir_copydll_noext: a @copydll
  naming another extension (.so on win64) is SM0625 at its path, never
  replaced; the file is not looked for (PLAN-EXT X4)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe dir_err_copydll_ext;

@copydll "$P:res/tests/exe/fixtures/dir_copydll_noext/helper.so"; // ERROR SM0625@10: @copydll names '$P:res/tests/exe/fixtures/dir_copydll_noext/helper.so', which is not a .dll file

begin
end.
