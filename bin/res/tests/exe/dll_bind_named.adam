-------------------------------------------------------------------------------
  dll_bind_named.adam - an import binds from the dll its `external` clause
  names (PLAN-LINUX64 LX6b2): dll_bind_named_a and dll_bind_named_b both
  export DLLWho; the exe names _b, so it calls _b's (2) and its image needs
  _b alone, whichever export table the link reads first
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  deps exe.dll_bind_named_a exe.dll_bind_named_b
  exitcode 0
  | who 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_bind_named;

func DLLWho(): int32; external "dll_bind_named_b";

begin
  println("who {}", DLLWho());
end.
