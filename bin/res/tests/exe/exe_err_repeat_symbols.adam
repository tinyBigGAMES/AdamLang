  exe_err_repeat_symbols.adam - Break step of declarations (AUD5): a name
  declared twice in one scope (SM0004) and a routine declared again with the
  same parameter types (SM0324) are one report each: the repeat takes no
  symbol, so no SM0024 follows
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe exe_err_repeat_symbols;

var
  GTwice: int32 = 1;
  GTwice: int32 = 2; // ERROR SM0004@3

routine Show(AN: int32);
begin
  println("{}", AN);
end;

routine Show(const AN: int32); // ERROR SM0324@1
begin
  println("{}", AN);
end;

begin
  println("{}", GTwice);
end.
