-------------------------------------------------------------------------------
  exe_dev_stamp.adam - Adam.Dev.Stamp (M11a D5e2, adam --dev-editor's
  stamp of editor.exe), imported from the compiler's own src\: a copy of
  this row's own exe stamped twice, first with a US English version
  resource, then with Adam's neutral one and an icon (a one-image .ico the
  row makes): the copy then holds one version resource, neutral (the old
  language removed), the MAINICON group and its one image; a program that
  is not there is not stamped (the Read step)
*******************************************************************************/

/*
@@test
  kind run
  args "<OUT>/bin/<CELL>/exe_dev_stamp.exe" "<OUT>"
  exitcode 0
  | first true
  | second true
  | version 1 language 0
  | group MAINICON language 0
  | icon 1 language 0
  | missing false read true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_dev_stamp;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.Windows, Adam.Backend.Parts, Adam.COFF.Resources,
  Adam.Dev.Stamp, Adam.Dev.Stamp.Step;

type
  // A UTF-16 path on the heap
  RowWide = final object
    Data: WideBuffer;
  end;

var
  GCopy: string;
  GBytes: ByteArray;
  GIcon: ByteArray;
  GList: ImageResourceList;
  GSettings: ref ExeSettings;
  GVersion: ref ImageResource;
  GStep: StampStep;
  GCode: uint32;
  GOk: bool;
  GKind: string;

// EnumResourceLanguagesW's callback: the resource printed with its language
func clink DoLanguage(AModule: uint64; AType: uint64; AName: uint64; ALanguage: uint16;
  AParam: ptr): int32;
begin
  if AName > 0xFFFF then
    println("{} MAINICON language {}", GKind, ALanguage);
  else
    println("{} {} language {}", GKind, AName, ALanguage);
  end;
  return 1;
end;

func clink DoName(AModule: uint64; AType: uint64; AName: uint64; AParam: ptr): int32;
begin
  EnumResourceLanguagesW(AModule, AType, AName, DoLanguage, AParam);
  return 1;
end;

// The copy's resources of the three types printed
func DoList(const APath: string);
var
  LPath: own RowWide;
  LModule: uint64;
begin
  LPath := own RowWide();
  UTF8ToWide(APath, LPath.Data);
  LModule := LoadLibraryExW(LPath.Data, 0, LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE);
  GKind := "version";
  EnumResourceNamesW(LModule, uint64(RT_VERSION), DoName, nil);
  GKind := "group";
  EnumResourceNamesW(LModule, uint64(RT_GROUP_ICON), DoName, nil);
  GKind := "icon";
  EnumResourceNamesW(LModule, uint64(RT_ICON), DoName, nil);
  FreeLibrary(LModule);
end;

// A one-image .ico: ICONDIR, one ICONDIRENTRY (16 x 16, its 4 bytes at 22), the bytes
func DoIcon(): ByteArray;
var
  LIcon: ByteArray;
  LI: int64;
begin
  setlength(LIcon, 26);
  for LI := 0 to 25 do
    LIcon[LI] := 0;
  end;
  PutLe(LIcon, 2, 1, 2);
  PutLe(LIcon, 4, 1, 2);
  LIcon[6] := 16;
  LIcon[7] := 16;
  PutLe(LIcon, 10, 1, 2);
  PutLe(LIcon, 12, 32, 2);
  PutLe(LIcon, 14, 4, 4);
  PutLe(LIcon, 18, 22, 4);
  return LIcon;
end;

begin
  GCopy := paramstr(2) + "/exe_dev_stamp_copy.exe";
  ReadAllBytes(paramstr(1), GBytes);
  WriteAllBytes(GCopy, GBytes);
  GSettings := ref ExeSettings();
  GSettings.VersionInfo := true;
  GSettings.VersionMajor := 1;
  GSettings.VersionMinor := 2;
  GSettings.VersionPatch := 3;
  GSettings.ProductName := "Row";
  GSettings.Description := "Row";
  GSettings.FileName := "exe_dev_stamp_copy.exe";
  GSettings.CompanyName := "Row";
  GSettings.Copyright := "Row";

  // A US English version resource first
  GVersion := VersionResource(GSettings);
  GVersion.Language := 0x0409;
  setlength(GList, 1);
  GList[0] := GVersion;
  println("first {}", StampResources(GCopy, GList, GStep, GCode));

  // Then Adam's neutral one and an icon
  setlength(GList, 0);
  GIcon := DoIcon();
  IconResources(GIcon, GList);
  setlength(GList, len(GList) + 1);
  GList[len(GList) - 1] := VersionResource(GSettings);
  println("second {}", StampResources(GCopy, GList, GStep, GCode));
  DoList(GCopy);

  GOk := StampResources(paramstr(2) + "/exe_dev_stamp_none.exe", GList, GStep, GCode);
  println("missing {} read {}", GOk, GStep = StampStep.Read);
end.
