-------------------------------------------------------------------------------
  dll_implib.adam - an exe linking a dll Adam built through the dll's import
  library (PLAN-ADAM M8b): only the output folder's lib part is a library
  path, so `@linklibrary "dll_implib_lib"` and the routines' `external`
  library are found as libdll_implib_lib.dll.a (BNF sec 2's search takes
  libname.dll.a first), whose imports name dll_implib_lib.dll; the loader
  then starts the dll beside the exe before the exe's block
*******************************************************************************/

/*
@@test
  kind run
  deps exe.dll_implib_lib
  exitcode 0
  | implib dll init
  | mul 42
  | add 13
  | add 20
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | implib dll final 20
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_implib;

@addlibrarypath "$P:output/lib/x86_64-windows-gnu/debug";
@linklibrary "dll_implib_lib";

func ImplibMul(const AA: int32; const AB: int32): int32; external "dll_implib_lib";
func ImplibAdd(const AStep: int32): int32; external "dll_implib_lib";

begin
  println("mul {}", ImplibMul(6, 7));
  println("add {}", ImplibAdd(3));
  println("add {}", ImplibAdd(7));
end.
