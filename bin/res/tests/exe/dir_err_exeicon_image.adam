-------------------------------------------------------------------------------
  dir_err_exeicon_image.adam - Break step of linux_exeicon_entry: an
  @exeicon whose largest image cannot be decoded (fixtures\dir_exeicon_image\
  bad_crc.ico: a PNG frame with a wrong CRC) built for x86_64-linux-gnu,
  where the compiler decodes it (BNF sec 2: an icon with no image the
  compiler can decode is an error at the path): LW0002, exit 1, no exe
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/dir_err_exeicon_image.adam" "-t" "x86_64-linux-gnu" "-o" "."
  exitcode 1
  | <DIR>/dir_err_exeicon_image.adam(34,10): Error LW0002: @exeicon: the largest image of the icon file '<DIR>/fixtures/dir_exeicon_image/bad_crc.ico' cannot be decoded: it is no BMP or PNG image the compiler reads, or it is damaged
@@end
*/

module exe dir_err_exeicon_image;

@exeicon "$P:res/tests/exe/fixtures/dir_exeicon_image/bad_crc.ico";

begin
end.
