  dll_version_lib.adam - the dll of dll_version (PLAN-ADAM M8c): built only;
  @addverinfo on a dll with every @vi* text, so its image carries a version
  resource whose VS_FIXEDFILEINFO says VFT_DLL
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_version_lib;

@addverinfo on;
@vimajor 4;
@viminor 5;
@vipatch 6;
@viproductname "Adam Rows";
@videscription "Dll version row";
@vifilename "dll_version_lib.dll";
@vicompanyname "tinyBigGAMES LLC";
@vicopyright "Copyright (c) 2026 tinyBigGAMES LLC";

// A dll exports something: what the row never calls
public func VersionAnswer(): int32;
begin
  return 42;
end;

end.
