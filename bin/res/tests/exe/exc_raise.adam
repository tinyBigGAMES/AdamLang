-------------------------------------------------------------------------------
  exc_raise.adam - Exceptions: raise (PLAN-SELFHOST S3, BNF sec 5 exception
  stmt), never caught. Two frames below the program block, raise of a text
  made by a concat (a temporary): nothing after it runs; every frame
  between unwinds, innermost first, before the report: the raising frame's
  own managed values released by its cleanup (a ref whose done prints),
  then the frame above it, its guard's finally first (reading its own
  local), then its own cleanup (a string and a ref). What the program
  printed comes first, then the runtime's report, PaskalCPP's line
  `unhandled exception 1: <text>`, and the process ends with exit code 1
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 1
  | start
  | init middle
  | init fail
  | raising thing
  | done fail
  | middle finally middle
  | done middle
  | unhandled exception 1: broken thing
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_raise;

type
  // An object whose done prints: its end shows where an unwind released it
  TNote = object
    Text: string;

    init(const AText: string);
    begin
      self.Text := AText;
      println("init {}", AText);
    end;

    done;
    begin
      println("done {}", self.Text);
    end;
  end;

// The raise, its text a concat's temporary: nothing after it runs, and the ref it holds
// ends as the unwind leaves this frame
func Fail(const AWhat: string);
var
  LNote: ref TNote;
begin
  LNote := ref TNote("fail");
  println("raising {}", AWhat);
  raise("broken " + AWhat);
  println("not reached fail");  // WARN SM0622
end;

// A frame between the raise and the program block: its guard's finally runs as the unwind
// leaves the body, then its own string and ref are released (the ref's done prints)
func Middle();
var
  LText: string;
  LNote: ref TNote;
begin
  LText := "middle";
  LNote := ref TNote(LText);
  guard
    Fail("thing");
    println("not reached middle");
  finally
    println("middle finally {}", LText);
  end;
end;

begin
  println("start");
  Middle();
  println("not reached main");
end.
