-------------------------------------------------------------------------------
  dll_fault.adam - DLL extras (PLAN-ADAM M8c): hardware faults and a raise
  inside a dll (dll_fault_lib) are caught by the dll's own guards, as an
  exe's are (exc_fault): a nil write 3 Access violation, a divide by zero 2
  Divide by zero, a raise 1 with its text, a fault two frames down whose
  finally runs as the dll's frames unwind; the exe goes on after the call
  (4 caught) and nothing leaks on either side
*******************************************************************************/

/*
@@test
  kind run
  deps exe.dll_fault_lib
  exitcode 0
  | dll 3 Access violation
  | dll 2 Divide by zero
  | dll 1 dll text
  | dll inner finally inner text
  | dll 3 Access violation
  | exe caught 4
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_fault;

@addlibrarypath "$P:output/lib/x86_64-windows-gnu/debug";
@linklibrary "dll_fault_lib";

func FaultAll(): int32; external "dll_fault_lib";

begin
  println("exe caught {}", FaultAll());
end.
