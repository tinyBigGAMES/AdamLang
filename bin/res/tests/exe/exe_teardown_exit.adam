-------------------------------------------------------------------------------
  exe_teardown_exit.adam - Teardown at process exit (BNF sec 1) on an exit
  in the middle of the program block: System.Runtime's public Halt (no std
  unit imported for it) ends the program through the exit handlers, as at
  the block's end (the one the block registered first, then the module's
  finalize, its variable released, the heap report), and the exit code is
  Halt's.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 3
  | main
  | late sees set
  | finalize sees set
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_teardown_exit;

import System.Runtime;

var
  GNote: string;

// The exit handler the program block registers: it runs before this module's teardown
routine Late();
begin
  println("late sees {}", GNote);
end;

finalize
begin
  println("finalize sees {}", GNote);
end;

begin
  GNote := "set";
  AtExit(Late);
  println("main");
  Halt(3);
  println("not reached main");
end.
