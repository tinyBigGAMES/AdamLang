-------------------------------------------------------------------------------
  exe_err_public_target.adam - Break step of declarations (AUD5): 'public'
  covers the one declaration after it, so before anything else (another
  'public', the main block) it is PR0024 and only the word is taken (what
  follows parses as without it: the second 'public' still covers its var
  block); a property's write(AValue) with no body is PR0061 at what stands
  in the body's place, the next member parsed whole (pcpp's reports).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe exe_err_public_target;

public public var // ERROR PR0024@8
  GA: int32 = 1;

type
  Box = object
    FN: int32;
    property N: int32 read FN; write(AValue); // ERROR PR0061@45
    method Get(): int32;
    begin
      return self.FN;
    end;
  end;

public
begin // ERROR PR0024@1
  println("{}", GA);
end.
