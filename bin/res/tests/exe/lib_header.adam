-------------------------------------------------------------------------------
  lib_header.adam - a lib build writes its C header (PLAN-ADAM M8g):
  lib_header_lib.h in the output folder's lib\x86_64-windows-gnu\debug\
  beside liblib_header_lib.a, read back here line by line ('>' before each, a
  comment's ends as *\/ and /\*): no import specifier (a static library's
  symbols link as they are), a choices type's numbered values, sets as their
  bits, a static array as C's array, a flexible array member as C's T name[]
  (M9e0b), a variadic routine
*******************************************************************************/

/*
@@test
  kind run
  deps exe.lib_header_lib
  exitcode 0
  | >/\* lib_header_lib.h - the C interface of the Adam lib lib_header_lib, written by adam: do not edit *\/
  | >
  | >#ifndef __adam_lib_header_lib_h
  | >#define __adam_lib_header_lib_h
  | >
  | >#include <stddef.h>
  | >#include <stdint.h>
  | >#include <stdbool.h>
  | >
  | >#ifndef __adam_c_header
  | >#define __adam_c_header
  | >#ifdef __cplusplus
  | >#define __adam_static_assert static_assert
  | >#define __adam_alignof alignof
  | >#define __adam_alignas alignas
  | >#define __adam_noreturn [[noreturn]]
  | >#else
  | >#define __adam_static_assert _Static_assert
  | >#define __adam_alignof _Alignof
  | >#define __adam_alignas _Alignas
  | >#define __adam_noreturn _Noreturn
  | >#endif
  | >#endif
  | >
  | >#ifdef __cplusplus
  | >extern "C" {
  | >#endif
  | >
  | >typedef struct Grid Grid;
  | >typedef struct Packet Packet;
  | >
  | >typedef uint8_t Small;
  | >
  | >typedef struct {
  | >  uint64_t Bits[2];
  | >} Wide;
  | >__adam_static_assert(sizeof(Wide) == 16, "Wide: Adam's size");
  | >__adam_static_assert(__adam_alignof(Wide) == 8, "Wide: Adam's alignment");
  | >
  | >typedef int32_t Level;
  | >enum {
  | >  Level_Low = 1,
  | >  Level_Mid = 5,
  | >  Level_High = 9
  | >};
  | >
  | >struct Grid {
  | >  int16_t Cells[4];
  | >  Small Mask;
  | >  Wide Tags;
  | >  Level Kind;
  | >};
  | >__adam_static_assert(sizeof(Grid) == 40, "Grid: Adam's size");
  | >__adam_static_assert(__adam_alignof(Grid) == 8, "Grid: Adam's alignment");
  | >__adam_static_assert(offsetof(Grid, Cells) == 0, "Grid.Cells: Adam's offset");
  | >__adam_static_assert(offsetof(Grid, Mask) == 8, "Grid.Mask: Adam's offset");
  | >__adam_static_assert(offsetof(Grid, Tags) == 16, "Grid.Tags: Adam's offset");
  | >__adam_static_assert(offsetof(Grid, Kind) == 32, "Grid.Kind: Adam's offset");
  | >
  | >struct Packet {
  | >  int32_t N;
  | >  double Data[];
  | >};
  | >__adam_static_assert(sizeof(Packet) == 8, "Packet: Adam's size");
  | >__adam_static_assert(__adam_alignof(Packet) == 8, "Packet: Adam's alignment");
  | >__adam_static_assert(offsetof(Packet, N) == 0, "Packet.N: Adam's offset");
  | >__adam_static_assert(offsetof(Packet, Data) == 8, "Packet.Data: Adam's offset");
  | >
  | >extern int32_t Table[3];
  | >extern int64_t Total;
  | >extern void Fill(char *AText, int64_t ACount);
  | >extern int32_t Count(const Grid *AGrid);
  | >extern double First(const Packet *APacket);
  | >extern int64_t Sum(int32_t ACount, ...);
  | >
  | >#ifdef __cplusplus
  | >}
  | >#endif
  | >
  | >#endif
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lib_header;

import System.SysUtils, System.IO;

const
  // The header, from the exe's folder (<output>\bin\<triple>\<mode>)
  HEADER_PATH: string = "$P:../../../lib/x86_64-windows-gnu/debug/lib_header_lib.h";

var
  GText: string;
  GLines: StringArray;
  GI: int64;

begin
  if not ReadAllText(HEADER_PATH, GText) then
    println("no header");
    return;
  end;
  GLines := SplitString(GText, "\n");
  for GI := 0 to len(GLines) - 1 do
    if (GI < len(GLines) - 1) or (GLines[GI] <> "") then
      // a comment's ends written *\/ and /\*: this file's own comment holds the expected
      // lines
      println(">{}", ReplaceStr(ReplaceStr(GLines[GI], "*/", "*\\/"), "/*", "/\\*"));
    end;
  end;
end.
