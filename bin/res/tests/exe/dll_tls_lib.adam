-------------------------------------------------------------------------------
  dll_tls_lib.adam - the dll of dll_tls (PLAN-ADAM M8c): built only; its
  threadstatics (an int32 starting at 100, a string, a ref to an object
  whose end it counts) get a copy on every thread that calls into it,
  threads the exe started included; a thread's managed copies are released
  as that thread ends by the dll's own thread callback (its TLS directory's),
  so its finalize counts every thread's object ended and its heap report
  shows nothing leaked
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_tls_lib;

import System.SysUtils;

var
  // How many Box objects have ended (their done), on any thread
  GEnded: int32;

type
  // An object whose end is counted: a thread's box is released with its copies
  Box = object
    Value: int64;

    done;
    begin
      atomicadd(GEnded, 1);
    end;
  end;

threadstatic
  GHits: int32 = 100;
  GName: string = "start";
  GBox: ref Box;

// The calling thread's count raised by AStep, the new count
public func TlsHit(const AStep: int32): int32;
begin
  GHits := GHits + AStep;
  return GHits;
end;

// The calling thread's managed copies given values from AIndex; its name's length
public func TlsFill(const AIndex: int64): int64;
begin
  GName := "name " + IntToStr(AIndex);
  GBox := ref Box;
  GBox.Value := AIndex;
  return len(GName);
end;

// How many boxes have ended so far
public func TlsEnded(): int32;
begin
  return GEnded;
end;

initialize
begin
  println("tls dll init");
end;

finalize
begin
  println("tls dll final {}", GEnded);
end;

end.
