-------------------------------------------------------------------------------
  dir_err_message.adam - Break step of dir_message: an @message error and a
  @message fatal (BNF sec 2) are SM0108 at their severity, each at its '@',
  and the build fails; a hint beside them is still reported
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe dir_err_message;

@message error "dir_err_message: an error from the prologue"; // ERROR SM0108@1: dir_err_message: an error from the prologue

func Run();
begin
  @message hint "dir_err_message: a hint"; // HINT SM0108@3: dir_err_message: a hint
  @message fatal "dir_err_message: a fatal from a body"; // FATAL SM0108@3: dir_err_message: a fatal from a body
end;

begin
  Run();
end.
