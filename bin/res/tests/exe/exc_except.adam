-------------------------------------------------------------------------------
  exc_except.adam - A guard's except part (BNF sec 5, PLAN-ADAM H4t2b0): a
  raise in the body is caught there, the body's rest skipped; no raise skips
  it; a raise in a routine the body calls unwinds that frame first (its
  finally runs); with a finally too, a raise runs the except part then the
  finally, no raise the finally alone; a raise in an except part goes to the
  guard around it (the inner finally first); an empty except part catches;
  a guard in a loop catches each round (3); a string local held across a
  catch is released once (Leaked 0, the last caught raise's text too:
  Halt); a return out of an except part with no finally returns (5).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | caught body
  | caught except
  | caught after
  | clean body
  | clean after
  | fails finally deep
  | deep except
  | both except
  | both finally
  | both body
  | both finally
  | inner except
  | inner finally
  | outer except
  | 7 kept 3
  | returns 5
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_except;

import System.SysUtils;

// Raises AText after its own finally line (the frame between the raise and the catch)
func Fails(const AText: string);
begin
  guard
    raise(AText);
  finally
    println("{}", "fails finally " + AText);
  end;
end;

// One raise from the body caught: the body's rest is skipped
func Caught();
begin
  guard
    println("caught body");
    raise("one");
    println("never");  // WARN SM0622
  except
    println("caught except");
  end;
  println("caught after");
end;

// No raise: the except part is skipped
func Clean();
begin
  guard
    println("clean body");
  except
    println("never");
  end;
  println("clean after");
end;

// A raise from a routine the body calls: its frame unwound (its finally ran) first
func Deep();
begin
  guard
    Fails("deep");
    println("never");
  except
    println("deep except");
  end;
end;

// Both parts: a raise runs the except part, then the finally; none runs the finally alone
func Both(const ARaise: bool);
begin
  guard
    if ARaise then
      raise("both");
    end;
    println("both body");
  except
    println("both except");
  finally
    println("both finally");
  end;
end;

// A raise in an except part goes to the guard around it, the inner finally first
func Nested();
begin
  guard
    guard
      raise("inner");
    except
      println("inner except");
      raise("again");
    finally
      println("inner finally");
    end;
  except
    println("outer except");
  end;
end;

// A string local held across a catch, an empty except part, and a guard in a loop
func Managed(): int32;
var
  LText: string;
  LI: int32;
  LCount: int32;
begin
  LText := IntToStr(7) + " kept";
  guard
    raise(LText);
  except
  end;
  LCount := 0;
  for LI := 1 to 3 do
    guard
      raise("loop " + IntToStr(LI));
    except
      LCount := LCount + 1;
    end;
  end;
  println("{}", LText + " " + IntToStr(LCount));
  return LCount;
end;

// A return out of an except part with no finally: a plain return
func Returns(): int32;
begin
  guard
    raise("returns " + IntToStr(5));
  except
    return 5;
  end;
end;

begin
  Caught();
  Clean();
  Deep();
  Both(true);
  Both(false);
  Nested();
  Managed();
  println("{}", "returns " + IntToStr(Returns()));
end.
