-------------------------------------------------------------------------------
  exe_teardown_order.adam - Teardown at process exit (BNF sec 1): a module's
  finalize and the release of its module variables are one exit handler,
  registered right after its initialize. An exit handler the program block
  registers later (System.Runtime's AtExit, the list C's atexit uses) runs
  first, while the module's variable still holds its text; then the
  finalize, still seeing it; then the variable is released and the heap
  report, registered before every module, runs last with nothing leaked.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | initialize
  | main
  | late sees kept
  | finalize sees kept
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_teardown_order;

import System.Runtime;

var
  GNote: string;

// The exit handler the program block registers: it runs before this module's teardown
routine Late();
begin
  println("late sees {}", GNote);
end;

initialize
begin
  GNote := "kept";
  println("initialize");
end;

finalize
begin
  println("finalize sees {}", GNote);
end;

begin
  println("main");
  AtExit(Late);
end.
