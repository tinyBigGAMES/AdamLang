-------------------------------------------------------------------------------
  lib_threads_lib.adam - the lib of lib_threads (PLAN-ADAM M8d2): built
  only; its unit has a managed threadstatic, released as each thread ends by
  the release its start adds to the runtime's list
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module lib lib_threads_lib;

import System.SysUtils;

threadstatic
  // The lib's own managed copy per thread
  GLibName: string;

// The calling thread's copy set from AIndex
public routine ThreadsSet(const AIndex: int64);
begin
  GLibName := "lib " + IntToStr(AIndex);
end;

// The calling thread's copy
public routine ThreadsGet(): string;
begin
  return GLibName;
end;

end.
