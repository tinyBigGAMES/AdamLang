  dll_exports_lib.adam - the dll of dll_exports (PLAN-ADAM M8a): built only;
  it exports its public routines and its public variable, not its private
  routine; its initialize runs at its load and its finalize at its unload
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_exports_lib;

public var
  // What dll_exports reads through the dll's export of it
  DllCounter: int32;

// Never exported: dll_err_private asks for it
routine DllHidden(): int32;
begin
  return 1;
end;

public routine DllAdd(const AA: int32; const AB: int32): int32;
begin
  return AA + AB + DllHidden() - 1;
end;

public routine DllBump(const AStep: int32);
begin
  DllCounter := DllCounter + AStep;
end;

initialize
begin
  DllCounter := 5;
  println("dll init");
end;

finalize
begin
  println("dll final {}", DllCounter);
end;

end.
