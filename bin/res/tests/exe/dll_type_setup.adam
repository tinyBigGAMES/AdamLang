-------------------------------------------------------------------------------
  dll_type_setup.adam - a dll's library types (PLAN-ADAM MO1b0 b), found by
  their exported names: Shape's, Square's, Point's and IArea's TypeInfo,
  Shape's init, both Grow overloads, its hidden Tidy, Point's Moved; Shape's
  and Square's setup functions (Point has none: no vptr). A setup called on
  zeroed storage writes the vptr: the word before slot 0 is the type's
  exported TypeInfo, slot 0 runs the type's Area (Shape 11, Square's
  override 22); Shape's TypeInfo has no parent and one interface entry,
  IArea's TypeInfo; Square's parent is Shape's
*******************************************************************************/

/*
@@test
  kind run
  deps exe.dll_type_setup_lib
  exitcode 0
  | ping 1
  | ok shape typeinfo
  | ok square typeinfo
  | ok point typeinfo
  | ok iarea typeinfo
  | ok shape init
  | ok grow one
  | ok grow two
  | ok hidden tidy
  | ok square area
  | ok point moved
  | ok point no setup
  | ok shape vtable typeinfo
  | ok shape area 11
  | ok shape no parent
  | ok shape one interface
  | ok shape interface iarea
  | ok square vtable typeinfo
  | ok square area 22
  | ok square parent shape
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_type_setup;

@addlibrarypath "$P:output/bin/x86_64-windows-gnu/debug";

routine Ping(): int32; external "dll_type_setup_lib";

type
  SetupFn = routine(const AObject: ptr);
  AreaFn = routine(const ASelf: ptr): int32;

// The dll's export AName, nil when it has none
routine Find(const AName: ptr to const char): ptr;
begin
  return FindLoadedFunction("dll_type_setup_lib.dll", AName);
end;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
  end;
end;

// The pointer word at AAddress plus AOffset bytes
routine WordAt(const AAddress: ptr; const AOffset: int64): ptr;
begin
  return ptr to ptr(ptr(uint64(AAddress) + uint64(AOffset)))^;
end;

// The vtable a setup ASetup writes into zeroed storage
routine VtableBy(const ASetup: ptr; var AStore: array[0..7] of uint64): ptr;
var
  LSetup: SetupFn;
begin
  LSetup := SetupFn(ASetup);
  LSetup(ptr(addr of AStore[0]));
  return ptr(AStore[0]);
end;

var
  LShapeInfo: ptr;
  LSquareInfo: ptr;
  LAreaInfo: ptr;
  LStore: array[0..7] of uint64;
  LVtable: ptr;
  LArea: AreaFn;

begin
  println("ping {}", Ping());
  LShapeInfo := Find("_ZTIN18dll_type_setup_lib5ShapeE");
  LSquareInfo := Find("_ZTIN18dll_type_setup_lib6SquareE");
  LAreaInfo := Find("_ZTIN18dll_type_setup_lib5IAreaE");
  Check("shape typeinfo", LShapeInfo <> nil);
  Check("square typeinfo", LSquareInfo <> nil);
  Check("point typeinfo", Find("_ZTIN18dll_type_setup_lib5PointE") <> nil);
  Check("iarea typeinfo", LAreaInfo <> nil);
  Check("shape init", Find("_ZN18dll_type_setup_lib5ShapeC1Ei") <> nil);
  Check("grow one", Find("_ZN18dll_type_setup_lib5Shape4GrowEi") <> nil);
  Check("grow two", Find("_ZN18dll_type_setup_lib5Shape4GrowEii") <> nil);
  Check("hidden tidy", Find("_ZN18dll_type_setup_lib5Shape4TidyEv") <> nil);
  Check("square area", Find("_ZN18dll_type_setup_lib6Square4AreaEv") <> nil);
  Check("point moved", Find("_ZN18dll_type_setup_lib5Point5MovedEi") <> nil);
  Check("point no setup", Find("__adam_setup_ZTIN18dll_type_setup_lib5PointE") = nil);
  LVtable := VtableBy(Find("__adam_setup_ZTIN18dll_type_setup_lib5ShapeE"), LStore);
  Check("shape vtable typeinfo", WordAt(LVtable, -8) = LShapeInfo);
  LArea := AreaFn(WordAt(LVtable, 0));
  Check("shape area 11", LArea(ptr(addr of LStore[0])) = 11);
  Check("shape no parent", WordAt(LShapeInfo, 0) = nil);
  Check("shape one interface", uint64(WordAt(LShapeInfo, 16)) = 1);
  Check("shape interface iarea", WordAt(LShapeInfo, 24) = LAreaInfo);
  LStore[0] := 0;
  LVtable := VtableBy(Find("__adam_setup_ZTIN18dll_type_setup_lib6SquareE"), LStore);
  Check("square vtable typeinfo", WordAt(LVtable, -8) = LSquareInfo);
  LArea := AreaFn(WordAt(LVtable, 0));
  Check("square area 22", LArea(ptr(addr of LStore[0])) = 22);
  Check("square parent shape", WordAt(LSquareInfo, 0) = LShapeInfo);
end.
