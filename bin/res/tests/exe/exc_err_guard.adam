-------------------------------------------------------------------------------
  exc_err_guard.adam - Break step of exc_guard: what code generation does
  not handle in a guard yet is LW0001 at its node, never code that skips the
  finally: a return leaving a guard's body, a leave of a loop around the
  guard, a skip of one, an except part. A leave of a loop inside the body
  is fine (exc_guard). adam build stops, exit 1, no exe
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "<DIR>/exc_err_guard.adam" "-o" "."
  exitcode 1
  | <DIR>/exc_err_guard.adam(40,5): Error LW0001: code generation does not handle a return statement that leaves a guard's body yet
  | <DIR>/exc_err_guard.adam(51,7): Error LW0001: code generation does not handle a leave statement that leaves a guard's body yet
  | <DIR>/exc_err_guard.adam(64,7): Error LW0001: code generation does not handle a skip statement that leaves a guard's body yet
  | <DIR>/exc_err_guard.adam(73,3): Error LW0001: code generation does not handle a guard with an except part yet
@@end
*/

module exe exc_err_guard;

routine Returns(): int32;
begin
  guard
    return 1;
  finally
    println("finally");
  end;
  return 0;
end;

routine Leaves();
begin
  while true do
    guard
      leave;
    finally
      println("finally");
    end;
  end;
end;

routine Skips();
var
  LI: int32;
begin
  for LI := 0 to 3 do
    guard
      skip;
    finally
      println("finally");
    end;
  end;
end;

routine Excepts();
begin
  guard
    println("body");
  except
    println("except");
  end;
end;

begin
  Returns();
  Leaves();
  Skips();
  Excepts();
end.
