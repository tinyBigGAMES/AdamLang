-------------------------------------------------------------------------------
  exc_err_guard.adam - Break step of exc_guard: what code generation does
  not handle in a guard yet is LW0001 at its node, never code that skips a
  finally: a guard inside a guard's finally, and a lock inside one (H4t5:
  the finally's funclet would need one of its own, reaching two frames). A
  return, leave or skip out of a guard's body or except part runs its
  finally (exc_guard_jump). adam build stops, exit 1, no exe
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/exc_err_guard.adam" "-o" "."
  exitcode 1
  | <DIR>/exc_err_guard.adam(41,5): Error LW0001: code generation does not handle a guard inside a guard's finally yet
  | <DIR>/exc_err_guard.adam(57,5): Error LW0001: code generation does not handle a lock statement inside a guard's finally yet
@@end
*/

module exe exc_err_guard;

routine Nested();
begin
  guard
    println("body");
  finally
    guard
      println("inner");
    finally
      println("inner finally");
    end;
  end;
end;

var
  GLock: mutex;

routine Locked();
begin
  guard
    println("body");
  finally
    lock (GLock) do
      println("locked");
    end;
  end;
end;

begin
  Nested();
  Locked();
end.
