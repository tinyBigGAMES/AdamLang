-------------------------------------------------------------------------------
  lib_link.adam - an exe linking a lib Adam built (PLAN-ADAM M8d): only the
  output folder's lib part is a library path, so `@linklibrary
  "lib_link_lib"` and the routines' and the variable's `external` library are
  found as liblib_link_lib.a (BNF sec 2's search); the exe uses its own
  runtime, the lib's module object brings its start list entry, which the
  exe's entry runs before its own start: the lib's initialize runs before the
  exe's, its finalize after the exe's, one heap report last
*******************************************************************************/

/*
@@test
  kind run
  deps exe.lib_link_lib
  exitcode 0
  | link lib init
  | link exe init 10
  | mul 42
  | add 13
  | add 20
  | var 25
  | link exe final 25
  | link lib final 25
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lib_link;

@addlibrarypath "$P:output/lib/x86_64-windows-gnu/debug";
@linklibrary "lib_link_lib";

var
  LinkTotal: int32; external "lib_link_lib";

func LinkMul(const AA: int32; const AB: int32): int32; external "lib_link_lib";
func LinkAdd(const AStep: int32): int32; external "lib_link_lib";

initialize
begin
  println("link exe init {}", LinkTotal);
end;

finalize
begin
  println("link exe final {}", LinkTotal);
end;

begin
  println("mul {}", LinkMul(6, 7));
  println("add {}", LinkAdd(3));
  println("add {}", LinkAdd(7));
  LinkTotal := LinkTotal + 5;
  println("var {}", LinkTotal);
end.
