/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/exe_defaults.adam" "-opt" "fast" "--defaults" "-o" "." "-r"
  exitcode 0
  | fast
@@end
*/

module exe exe_defaults;

begin
@ifdef RELEASE_FAST
  println("fast");
@else
  println("not fast");
@endif
end.
