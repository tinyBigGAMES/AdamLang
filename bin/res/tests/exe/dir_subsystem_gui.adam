-------------------------------------------------------------------------------
  dir_subsystem_gui.adam - Directive: @subsystem gui stamps the image's
  Windows subsystem field IMAGE_SUBSYSTEM_WINDOWS_GUI (2) (AUD4 5.8 gap),
  read from the exe's own PE header; with no @exeicon and no @addverinfo
  the image has no resource directory. Its output still reaches the row:
  the runner hands the process its pipes
*******************************************************************************/

/*
@@test
  kind run
  | ok read image
  | ok subsystem gui
  | ok no resources
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dir_subsystem_gui;

@subsystem gui;

import System.SysUtils, System.IO;

const
  // IMAGE_SUBSYSTEM_WINDOWS_GUI; where the PE header's offset is, the subsystem and the
  // resource directory past the signature
  ADAM_ROW_SUBSYSTEM_GUI: uint64 = 2;
  ADAM_ROW_PE_AT: int64 = 0x3C;
  ADAM_ROW_SUBSYSTEM_AT: int64 = 92;
  ADAM_ROW_RESOURCE_AT: int64 = 152;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
  end;
end;

// The rows (see the header)
routine Run();
var
  LImage: ByteArray;
  LPe: int64;
begin
  Check("read image", ReadAllBytes(ProgramFilePath(), LImage));
  LPe := int64(GetLe(LImage, ADAM_ROW_PE_AT, 4));
  Check("subsystem gui", GetLe(LImage, LPe + ADAM_ROW_SUBSYSTEM_AT, 2) = ADAM_ROW_SUBSYSTEM_GUI);
  Check("no resources", GetLe(LImage, LPe + ADAM_ROW_RESOURCE_AT, 8) = 0);
end;

begin
  Run();
end.
