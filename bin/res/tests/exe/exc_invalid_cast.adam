-------------------------------------------------------------------------------
  exc_invalid_cast.adam - a failed `as` (I1, BNF sec 6 O12: PaskalCPP's
  EXC_INVALID_CAST, code 13, "invalid cast: the object is not a T"): an
  object as a type it is not, through a const parameter, a ptr, a ref and
  an own, caught; the same casts to a type the object is pass; a nil ptr
  and a nil ref stay nil and raise nothing; nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | 13 invalid cast: the object is not a TCat
  | 13 invalid cast: the object is not a TCat
  | 13 invalid cast: the object is not a TCat
  | 13 invalid cast: the object is not a TPuppy
  | dog 1
  | dog 2
  | nil ptr
  | nil ref
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_invalid_cast;

type
  TAnimal = object
    Legs: int64;

    virtual const method Name(): string;
    begin
      return "animal";
    end;
  end;

  TDog = object(TAnimal)
    override const method Name(): string;
    begin
      return "dog";
    end;
  end;

  TCat = object(TAnimal)
    Lives: int64;
  end;

  TPuppy = object(TDog)
  end;

  PAnimal = ptr to TAnimal;
  PCat = ptr to TCat;

func Lives(const AAnimal: TAnimal): int64;
begin
  return (AAnimal as TCat).Lives;
end;

func Run();
var
  LDog: TDog;
  LPtr: PAnimal;
  LCat: PCat;
  LRef: ref TAnimal;
  LOwn: own TAnimal;
  LN: int64;
begin
  LPtr := addr of LDog;
  LRef := ref TDog();
  LOwn := own TDog();
  guard
    LN := Lives(LDog);
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LCat := LPtr as TCat;
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LN := (LRef as TCat).Lives;
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    println("{}", (LOwn as TPuppy).Name());
  except
    println("{} {}", exccode(), excmsg());
  end;
  LDog.Legs := 1;
  println("{} {}", (LPtr as TDog)->Name(), (LPtr as TDog)->Legs);
  (LOwn as TDog).Legs := 2;
  println("{} {}", (LOwn as TDog).Name(), (LOwn as TDog).Legs);
  LPtr := nil;
  if (LPtr as TDog) = nil then
    println("nil ptr");
  end;
  LRef := nil;
  if (LRef as TDog) = nil then
    println("nil ref");
  end;
  println("end");
end;

begin
  Run();
end.
