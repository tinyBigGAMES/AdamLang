-------------------------------------------------------------------------------
  dll_header_lib.adam - the dll of dll_header (PLAN-ADAM M8g): built only;
  its C header declares what C can call: routines, variables, a choices
  type, records (a packed one, bitfields, one pointing at itself), an
  overlay, a routine type, var / const / pointer parameters, a noreturn
  routine; a string parameter, a string variable and a cpplink routine are
  each a comment in their place; the private routine is nowhere
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_header_lib;

public type
  Shade = choices(Dark, Light);

  Point = record
    X: int32;
    Y: int32;
  end;

  Packet = record packed
    Tag: uint8;
    Size: uint32;
  end;

  Bits = record
    Low: uint32 : 3;
    High: uint32 : 5;
    Count: int64;
  end;

  Number = overlay
    I: int64;
    F: float64;
  end;

  Callback = routine(const AValue: int32): int32;

public forward type Node;

public type
  Node = record
    Next: ptr to Node;
    Value: int32;
  end;

public var
  Counter: int32;
  Origin: Point;
  Title: string;

// Never in the header: private
routine Hidden(): int32;
begin
  return 1;
end;

public routine Add(const AX: int32; const AY: int32): int32;
begin
  return AX + AY + Hidden() - 1;
end;

public routine Mid(const AA: Point; const AB: Point): Point;
var
  LMid: Point;
begin
  LMid.X := (AA.X + AB.X) div 2;
  LMid.Y := (AA.Y + AB.Y) div 2;
  return LMid;
end;

public routine Scale(var AP: Point; const AFactor: float64);
begin
  AP.X := int32(float64(AP.X) * AFactor);
  AP.Y := int32(float64(AP.Y) * AFactor);
end;

public routine Walk(const AFirst: ptr to const Node): int32;
var
  LAt: ptr to const Node;
  LSum: int32;
begin
  LSum := 0;
  LAt := AFirst;
  while LAt <> nil do
    LSum := LSum + LAt^.Value;
    LAt := LAt^.Next;
  end;
  return LSum;
end;

public routine Apply(const AFn: Callback; const AValue: int32): int32;
begin
  return AFn(AValue);
end;

public routine Pick(const AShade: Shade; const APacket: Packet; const ABits: Bits;
  const ANumber: Number): bool;
begin
  return (AShade = Shade.Light) and (APacket.Size > 0) and (ABits.Count >= 0) and (ANumber.I <> 1);
end;

public routine Quit(const ACode: int32); noreturn;
begin
  Halt(ACode);
end;

public routine Greet(const AName: string): int32;
begin
  return int32(len(AName));
end;

public routine cpplink Twice(const AX: int32): int32;
begin
  return AX * 2;
end;

end.
