-------------------------------------------------------------------------------
  exc_foreign.adam - Exceptions through foreign frames (PLAN-LINUX64 LX4b2):
  a raise in a C library's callback (the C runtime's qsort calling an Adam
  comparator) crosses the C frames between it and the guard that catches
  it, on both targets alike (win64: the C code's .pdata; linux: its
  .eh_frame CFI, glibc's qsort's). The comparator's own managed local is
  released on the way (its cleanup), the caller's finally runs, then its
  except part; a second sort with no raise still works after it
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | compare
  | compare done
  | finally
  | caught 1 bad pair
  | sorted 1 2 3 4
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_foreign;

type
  // C's qsort comparator
  TCompare = func(const AA: ptr; const AB: ptr): int32;

  // An object whose done prints: its end shows the unwind left the comparator's frame
  TNote = object
    Text: string;

    init(const AText: string);
    begin
      self.Text := AText;
    end;

    done;
    begin
      println("{} done", self.Text);
    end;
  end;

@ifdef TARGET_X86_64_LINUX_GNU
func qsort(const ABase: ptr; const ACount: uint64; const ASize: uint64;
  const ACompare: TCompare); external "c";
@else
func qsort(const ABase: ptr; const ACount: uint64; const ASize: uint64;
  const ACompare: TCompare); external "ucrtbase";
@endif

// A comparator that raises on its first call, inside C's qsort
func CompareRaise(const AA: ptr; const AB: ptr): int32;
var
  LNote: ref TNote;
begin
  LNote := ref TNote("compare");
  println("compare");
  raise("bad pair");
  return 0;  // WARN SM0622
end;

// int32 elements in rising order
func CompareInt(const AA: ptr; const AB: ptr): int32;
var
  LA: ptr to int32;
  LB: ptr to int32;
begin
  LA := ptr to int32(AA);
  LB := ptr to int32(AB);
  if LA[0] < LB[0] then
    return -1;
  end;
  if LA[0] > LB[0] then
    return 1;
  end;
  return 0;
end;

var
  GItems: array[0..3] of int32;

begin
  GItems[0] := 3;
  GItems[1] := 1;
  GItems[2] := 4;
  GItems[3] := 2;
  guard
    guard
      qsort(addr of GItems, 4, 4, CompareRaise);
      println("not reached");
    finally
      println("finally");
    end;
  except
    println("caught {} {}", exccode(), excmsg());
  end;
  qsort(addr of GItems, 4, 4, CompareInt);
  println("sorted {} {} {} {}", GItems[0], GItems[1], GItems[2], GItems[3]);
end.
