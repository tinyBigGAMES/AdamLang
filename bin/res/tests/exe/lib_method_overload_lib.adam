-------------------------------------------------------------------------------
  lib_method_overload_lib.adam - the lib of lib_method_overload (PLAN-ADAM MO1b): built only;
  the lib holds its public object types' methods, each overload its own symbol: Shape (overloads by count and by type, a virtual pair, IMeasure's pair) and Square overriding one of the pair
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module lib lib_method_overload_lib;

public type
  IMeasure = interface
    method Measure(): int64;
    method Measure(const AScale: int64): int64;
  end;

  Shape = object implements IMeasure
    FSize: int64;

    init(const ASize: int64);
    begin
      self.FSize := ASize;
    end;

    method Grow(): int64;
    begin
      self.FSize := self.FSize + 1;
      return self.FSize;
    end;

    method Grow(const AStep: int64): int64;
    begin
      self.FSize := self.FSize + AStep;
      return self.FSize;
    end;

    method Grow(const AStep: int64; const ATimes: int64): int64;
    begin
      self.FSize := self.FSize + AStep * ATimes;
      return self.FSize;
    end;

    method Describe(const AX: int64): int64;
    begin
      return 1;
    end;

    method Describe(const AX: float64): int64;
    begin
      return 2;
    end;

    method Describe(const AX: bool): int64;
    begin
      return 3;
    end;

    virtual method Measure(): int64;
    begin
      return self.FSize;
    end;

    virtual method Measure(const AScale: int64): int64;
    begin
      return self.FSize * AScale;
    end;
  end;

  Square = object(Shape)
    init(const ASize: int64);
    begin
      parent.init(ASize);
    end;

    override method Measure(): int64;
    begin
      return self.FSize * 25;
    end;
  end;

end.
