  dir_err_modulepath_missing.adam - an @addmodulepath whose folder is not there is
  SM0626 at its path, as written (BNF sec 2)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe dir_err_modulepath_missing;

@addmodulepath "$P:res/tests/exe/fixtures/dir_gone"; // ERROR SM0626@16: @addmodulepath names '$P:res/tests/exe/fixtures/dir_gone', which does not exist

begin
end.
