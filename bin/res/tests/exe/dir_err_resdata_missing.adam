-------------------------------------------------------------------------------
  dir_err_resdata_missing.adam - an @addresdata whose file is not there is
  SM0626 at its path, as written (BNF sec 2: a path
  directive names something that exists)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe dir_err_resdata_missing;

@addresdata "app/data" "$P:res/tests/exe/fixtures/dir_gone/data.bin"; // ERROR SM0626@24: @addresdata names '$P:res/tests/exe/fixtures/dir_gone/data.bin', which does not exist

begin
end.
