-------------------------------------------------------------------------------
  dll_header_pack_lib.adam - the dll of dll_header_pack (M9e0d): built only;
  a packed(2) record its header writes under #pragma pack(push, 2), and a
  record whose anonymous part packs tighter than the record (C's #pragma
  pack covers a whole definition: no C form, its routine a comment)
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_header_pack_lib;

public type
  Pair = record packed(2)
    Tag: uint8;
    Size: uint32;
    Big: int64;
  end;

  Mixed = record packed(4)
    A: int8;
    overlay
      record packed(2)
        B: int8;
        C: int32;
      end;
    end;
  end;

public func Total(const AP: Pair): int64;
begin
  return int64(AP.Tag) + int64(AP.Size) + AP.Big;
end;

public func Use(const AM: Mixed): int32;
begin
  return AM.C;
end;

end.
