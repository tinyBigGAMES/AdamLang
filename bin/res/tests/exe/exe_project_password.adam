-------------------------------------------------------------------------------
  exe_project_password.adam - ProjectPassword() in a project build: the fixture
  project exe_project_password (a pack password with a blank, longer
  than one keystream word) prints it from its main module and a unit it
  imports, and its exe does not hold the plain text (the compiler writes
  it scrambled); exe_project_password_none (no [pack]) reads ""
  (PLAN-ADAM T4d1; written by scripts\adam\gen_project_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  args "<BIN>/adam.exe" "<OUT>" "<BIN>/res/tests/exe/fixtures"
  exitcode 0
  | password build started true exit 0
  | password run started true exit 0
  | password run [main [Open Sesame! ~0123456789] length 24]
  | password run [unit same true]
  | password run [[Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0]
  | password plain in exe false
  | password_none build started true exit 0
  | password_none run started true exit 0
  | password_none run [none [] length 0]
  | password_none run [[Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0]
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_project_password;

import System.SysUtils, System.Windows;

var
  GAdam: string;
  GOut: string;
  GFixtures: string;
  GArgs: StringArray;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// Adds AText at the end of GArgs
routine Arg(const AText: string);
var
  LCount: int64;
begin
  LCount := len(GArgs);
  setlength(GArgs, LCount + 1);
  GArgs[LCount] := AText;
end;

// Each line of AText after ALabel, in [ ]; the empty part after a last line end is no line
routine ShowText(const ALabel: string; const AText: string);
var
  LParts: StringArray;
  LCount: int64;
  LI: int64;
begin
  LParts := SplitString(AText, "\n");
  LCount := len(LParts);
  if (LCount > 0) and (LParts[LCount - 1] = "") then
    LCount := LCount - 1;
  end;
  for LI := 0 to LCount - 1 do
    println("{}", ALabel + " [" + LParts[LI] + "]");
  end;
end;

// Runs AExe with GArgs (then emptied) in the output folder: whether it started and its exit
// code, then each line it printed (CRs dropped) through ShowText
routine RunTool(const ALabel: string; const AExe: string);
var
  LOutput: string;
  LCode: uint32;
  LOk: bool;
begin
  LOk := RunProcess(AExe, GArgs, GOut, LOutput, LCode);
  setlength(GArgs, 0);
  println("{}", ALabel + " started " + BoolText(LOk) + " exit " + IntToStr(int64(LCode)));
  ShowText(ALabel, ReplaceStr(LOutput, "\r", ""));
end;

// The fixture project exe_project_<AWhat>: its main module built into the output folder and
// run; when APlain is not empty, whether the exe's bytes hold it
routine BuildAndRun(const AWhat: string; const APlain: string);
var
  LExe: string;
  LBytes: string;
begin
  LExe := GOut + "/prj_" + AWhat + ".exe";
  Arg("build");
  Arg("--quiet");
  Arg(GFixtures + "/exe_project_" + AWhat + "/src/prj_" + AWhat + ".adam");
  Arg("-o");
  Arg(GOut);
  RunTool(AWhat + " build", GAdam);
  RunTool(AWhat + " run", LExe);
  if APlain = "" then
    return;
  end;
  if not ReadAllText(LExe, LBytes) then
    println("{}", AWhat + " exe missing");
    return;
  end;
  println("{}", AWhat + " plain in exe " + BoolText(IndexOf(APlain, LBytes, 0) >= 0));
end;

begin
  GAdam := paramstr(1);
  GOut := paramstr(2);
  GFixtures := paramstr(3);
  setlength(GArgs, 0);
  BuildAndRun("password", "Open Sesame! ~0123456789");
  BuildAndRun("password_none", "");
end.
