-------------------------------------------------------------------------------
  exe_routines.adam - Exe: routines calling routines (value parameters, a
  local, results), a routine printing, and the program's own external
  (ucrtbase's exit, which flushes the output first) ending it with the
  code passed through them: 38
*******************************************************************************/

/*
@@test
  kind run
  exitcode 38
  | start
  | from a routine
  | again
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe exe_routines;

func exit(const ACode: int32); external "ucrtbase";

func Code(): int32;
begin
  return 38;
end;

func Pass(const AValue: int32): int32;
var
  LKept: int32;
begin
  LKept := AValue;
  return LKept;
end;

func Say();
begin
  println("from a routine");
end;

begin
  println("start");
  Say();
  println("again");
  exit(Pass(Code()));
end.
