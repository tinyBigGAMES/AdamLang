-------------------------------------------------------------------------------
  dll_type_bind.adam - a dll's object types declared external (PLAN-ADAM
  MO1b0 c): an object built by its library's init, its overloaded Grow
  pair and its virtual called there, its done counted there; a child's
  object through a ref of the parent dispatches to the library's override;
  is tests against the library's TypeInfo; an exe type extending the
  external child (its own vtable over the library's functions, parent
  calls into the library, an itable for the external interface) through
  the interface and the parent
*******************************************************************************/

/*
@@test
  kind run
  deps exe.dll_type_bind_lib
  exitcode 0
  | side 8
  | area 11
  | report 11
  | dones 1
  | square 22
  | is square true
  | is cube false
  | cube 220
  | cube is square true
  | cube is cube true
  | report 220
  | dones 4
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_type_bind;

@addlibrarypath "$P:output/bin/x86_64-windows-gnu/debug";

var
  Dones: int32; external "dll_type_bind_lib";

type
  IArea = interface
    method Area(): int32;
  end; external "dll_type_bind_lib";

  Shape = object implements IArea
    FSide: int32;

    init(const ASide: int32);
    done;
    virtual method Area(): int32;
    method Grow(const AStep: int32);
    method Grow(const AStep: int32; const ATimes: int32);
    method Side(): int32;
  end; external "dll_type_bind_lib";

  Square = object(Shape)
    init(const ASide: int32);
    override method Area(): int32;
  end; external "dll_type_bind_lib";

  Cube = object(Square)
    init(const ASide: int32);
    begin
      parent.init(ASide);
    end;

    override method Area(): int32;
    begin
      return parent.Area() * 10;
    end;
  end;

func Report(const AShape: IArea);
begin
  println("report {}", AShape.Area());
end;

func UseShape();
var
  LS: Shape(3);
begin
  LS.Grow(2);
  LS.Grow(1, 3);
  println("side {}", LS.Side());
  println("area {}", LS.Area());
  Report(LS);
end;

func UseChildren();
var
  LQ: ref Shape;
  LC: ref Shape;
  LCube: Cube(6);
begin
  LQ := ref Square(4);
  println("square {}", LQ.Area());
  println("is square {}", LQ is Square);
  println("is cube {}", LQ is Cube);
  LC := ref Cube(5);
  println("cube {}", LC.Area());
  println("cube is square {}", LC is Square);
  println("cube is cube {}", LC is Cube);
  Report(LCube);
  LQ := nil;
  LC := nil;
end;

begin
  UseShape();
  println("dones {}", Dones);
  UseChildren();
  println("dones {}", Dones);
end.
