-------------------------------------------------------------------------------
  lib_sites.adam - a lib in its host (PLAN-ADAM M8d2): a debug build's leak
  report names each leak's own site. The lib's start and the exe's each add
  their site list to the runtime's list; a unit both share keeps the ids its
  first start gave it, the rest run on, so the lib's leak and the exe's are
  each named at their own line
*******************************************************************************/

/*
@@test
  kind run
  deps exe.lib_sites_lib
  exitcode 0
  | leaked
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 2
  | lib_sites_lib.adam(34,12): 1 leak, 16 bytes, getmem
  |   lib_sites.adam(47,3)
  | lib_sites.adam(48,12): 1 leak, 24 bytes, getmem
@@end
*/

module exe lib_sites;

@addlibrarypath "$P:output/lib/x86_64-windows-gnu/debug";
@linklibrary "lib_sites_lib";

func SitesLeak(); external "lib_sites_lib";

var
  GKept: ptr;

begin
  SitesLeak();
  GKept := getmem(24);
  println("leaked");
end.
