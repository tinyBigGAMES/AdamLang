-------------------------------------------------------------------------------
  exe_err_dll.adam - Break step of exe: adam build on a dll module stops at
  its header (DR0009: dll / lib output comes later), exit 1, nothing written
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--no-banner" "<DIR>/exe_err_dll.adam" "-o" "."
  exitcode 1
  | <DIR>/exe_err_dll.adam(29,1): Error DR0009: adam build makes exe modules so far, and 'exe_err_dll' is a dll module
@@end
*/

module dll exe_err_dll;

end.
