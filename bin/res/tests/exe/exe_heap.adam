-------------------------------------------------------------------------------
  exe_heap.adam - The heap report (M3.8a, PaskalCPP's line): every block
  getmem / resizemem hands out is counted, every one freemem / resizemem to 0
  takes back; getmem(0) is nil and uncounted, freemem(nil) and resizemem
  growing a block count nothing; a block never freed is Leaked. The report
  prints as the process ends, here through a program's own call of
  ucrtbase's exit (the runtime's Halt is the other way, in every other row),
  after the program's text, and the exit code is the program's.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 5
  | nil
  | grown
  | [Adam Heap] Allocs: 3, Frees: 2, Leaked: 1
@@end
*/

module exe exe_heap;

routine puts(const AText: ptr to const char): int32; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";

routine Run();
var
  LA: ptr;
  LB: ptr;
  LC: ptr;
  LZero: ptr;
begin
  // Counted: three blocks out
  LA := getmem(16);
  LB := getmem(32);
  LC := resizemem(nil, 8);

  // Uncounted: an empty getmem, a growing resizemem, freemem of nil
  LZero := getmem(0);
  if LZero = nil then
    puts(ptr to const char("nil"));
  end;
  LB := resizemem(LB, 64);
  if LB <> nil then
    puts(ptr to const char("grown"));
  end;
  freemem(nil);

  // Counted: two blocks back (resizemem to 0 frees); LC is never freed: leaked
  freemem(LA);
  LB := resizemem(LB, 0);
end;

begin
  Run();
  exit(5);
end.
