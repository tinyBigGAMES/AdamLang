/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/exe_defaults_source.adam" "-opt" "fast" "--defaults" "-o" "." "-r"
  exitcode 0
  | safe
@@end
*/

module exe exe_defaults_source;

@optimize safe;

begin
@ifdef RELEASE_SAFE
  println("safe");
@else
  println("not safe");
@endif
end.
