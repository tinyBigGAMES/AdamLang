-------------------------------------------------------------------------------
  exc_index.adam - the index check (M3.11a, DESIGN sec 5: kept at debug and
  safe; his WHAT 2026-11-10: code 14, the set range's wording). A static
  array's index outside its bounds (read and write, below and above), a
  dynamic array's and a text's outside its length (a negative index too), an
  empty one's ("it is empty"), a wstring's counted in units: each raises 14,
  caught; the indexes inside them read and write as before; nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | 1 7
  | 14 index 6 is out of bounds 2..5
  | 14 index 1 is out of bounds 2..5
  | 9
  | 14 index 3 is out of bounds 0..2
  | 14 index -1 is out of bounds 0..2
  | 14 index 0 is out of bounds: it is empty
  | c
  | 14 index 3 is out of bounds 0..2
  | 14 index 5 is out of bounds 0..2
  | 14 index 0 is out of bounds: it is empty
  | 14 index 2 is out of bounds 0..1
  | abd
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_index;

// AValue itself, so no index below is a constant
func Idx(const AValue: int32): int32;
begin
  return AValue;
end;

func Statics();
var
  LA: array[2..5] of int32;
  LV: int32;
begin
  LA[Idx(2)] := 1;
  LA[Idx(5)] := 7;
  println("{} {}", LA[Idx(2)], LA[Idx(5)]);
  guard
    LV := LA[Idx(6)];
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LA[Idx(1)] := 3;
  except
    println("{} {}", exccode(), excmsg());
  end;
end;

func Dynamics();
var
  LD: array of int32;
  LE: array of int32;
  LV: int32;
begin
  setlength(LD, 3);
  LD[Idx(2)] := 9;
  println("{}", LD[Idx(2)]);
  guard
    LV := LD[Idx(3)];
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LD[Idx(-1)] := 4;
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LV := LE[Idx(0)];
  except
    println("{} {}", exccode(), excmsg());
  end;
end;

func Texts();
var
  LS: string;
  LT: string;
  LW: wstring;
  LC: char;
begin
  LS := "abc";
  println("{}", LS[Idx(2)]);
  guard
    LC := LS[Idx(3)];
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LS[Idx(5)] := 'x';
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LC := LT[Idx(0)];
  except
    println("{} {}", exccode(), excmsg());
  end;
  LW := "hi";
  guard
    LW[Idx(2)] := LW[Idx(0)];
  except
    println("{} {}", exccode(), excmsg());
  end;
  LS[Idx(2)] := 'd';
  println("{}", LS);
end;

begin
  Statics();
  Dynamics();
  Texts();
end.
