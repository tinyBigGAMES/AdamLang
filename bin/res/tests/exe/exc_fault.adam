-------------------------------------------------------------------------------
  exc_fault.adam - Exceptions: hardware faults inside a guard (BNF sec 5,
  PaskalCPP's runtime faults) are caught as raises with PaskalCPP's codes and
  texts: a nil write 3 Access violation, an integer div and mod by zero 2
  Divide by zero, MIN div -1 5 Numeric overflow, a stack overflow 4 Stack
  overflow, and a second one caught again (the guard page made again). A fault
  frames down unwinds the frames between: their finally parts run and their
  managed locals are released. A raise after a fault has its own code and
  text; the program goes on after each, nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 3 Access violation
  | 2 Divide by zero
  | 2 Divide by zero
  | 5 Numeric overflow
  | 4 Stack overflow
  | 4 Stack overflow
  | inner finally inner text
  | 3 Access violation
  | 1 after
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_fault;

var
  GZero: int64;
  GMinusOne: int64;
  GMin: int64;
  GNil: ptr to int64;

// A write through a nil pointer: the hardware's access violation
routine WriteNil();
begin
  GNil[0] := 5;
end;

// A recursion with no end: every frame holds 2 KB, so the stack runs out
routine Deep(const AN: int64): int64;
var
  LBuf: array[0..255] of int64;
begin
  LBuf[AN mod 256] := AN;
  return Deep(AN + 1) + LBuf[0];
end;

// A fault two frames down from the guard: this frame's finally runs and its string is
// released as the frames unwind
routine Inner();
var
  LText: string;
begin
  LText := "inner " + "text";
  guard
    WriteNil();
  finally
    println("inner finally {}", LText);
  end;
end;

routine Faults();
var
  LA: int64;
  LV: int64;
begin
  guard
    WriteNil();
  except
    println("{} {}", exccode(), excmsg());
  end;
  LA := 7;
  guard
    LV := LA div GZero;
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LV := LA mod GZero;
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LV := GMin div GMinusOne;
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LV := Deep(0);
  except
    println("{} {}", exccode(), excmsg());
  end;
  // the guard page was made again: a second overflow is caught too
  guard
    LV := Deep(0);
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    Inner();
  except
    println("{} {}", exccode(), excmsg());
  end;
  // a raise after a fault: its own code and text
  guard
    raise("after");
  except
    println("{} {}", exccode(), excmsg());
  end;
end;

begin
  GZero := 0;
  GMinusOne := -1;
  GMin := -9223372036854775807 - 1;
  GNil := nil;
  Faults();
  println("end");
end.
