-------------------------------------------------------------------------------
  exe_leak_site.adam - The leak tracker (M4.L1, debug builds): every live
  heap block is recorded with its size and allocation site, and at exit the
  heap report lists, under its [Heap] line, each site still holding blocks:
  file(line,col): N leaks, B bytes, what, in site id order. Halt (C's exit)
  runs the exit handlers but not a routine's own releases, so Leak's locals
  are planted leaks of each kind: a string, a dynamic array, a ref object,
  a getmem block (an own object's row comes with own's lowering). The exit
  code stays Halt's 0.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | abab 3 1
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 4
  | exe_leak_site.adam(65,12): 1 leak, 21 bytes, string
  | exe_leak_site.adam(66,3): 1 leak, 28 bytes, dynarray of int32
  | exe_leak_site.adam(67,14): 1 leak, 28 bytes, Box
  | exe_leak_site.adam(68,11): 1 leak, 24 bytes, getmem
@@end
*/

module exe exe_leak_site;

import System.Runtime, System.Windows;

type
  // An object a ref holds (its site names the type)
  Box = object
    hidden FValue: int32;

    init(const AValue: int32);
    begin
      self.FValue := AValue;
    end;

    property Value: int32 read FValue;
  end;

// One block of each kind made and never released: the program ends inside the routine
routine Leak();
var
  LText: string;
  LNums: array of int32;
  LShared: ref Box;
  LMem: ptr;
begin
  LText := "ab";
  LText := LText + LText;
  setlength(LNums, 3);
  LShared := ref Box(1);
  LMem := getmem(24);
  println("{} {} {}", LText, len(LNums), LShared.Value);
  Halt(0);
end;

begin
  Leak();
end.
