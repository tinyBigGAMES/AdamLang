-------------------------------------------------------------------------------
  dll_type_setup_lib.adam - the dll of dll_type_setup (PLAN-ADAM MO1b0 b):
  built only; its public object types and interface are library types: it
  exports each one's TypeInfo (data), its members' functions (init, the
  overloaded Grow pair, a hidden method, an override) and each polymorphic
  object type's setup function (__adam_setup + its TypeInfo symbol); the
  plain object type Point gets no setup
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_type_setup_lib;

public type
  IArea = interface
    method Area(): int32;
  end;

  Shape = object implements IArea
    FSide: int32;

    init(const ASide: int32);
    begin
      self.FSide := ASide;
    end;

    virtual method Area(): int32;
    begin
      return 11;
    end;

    method Grow(const AStep: int32);
    begin
      self.FSide := self.FSide + AStep;
      self.Tidy();
    end;

    method Grow(const AStep: int32; const ATimes: int32);
    begin
      self.FSide := self.FSide + AStep * ATimes;
      self.Tidy();
    end;

    hidden method Tidy();
    begin
      if self.FSide < 0 then
        self.FSide := 0;
      end;
    end;
  end;

  Square = object(Shape)
    init(const ASide: int32);
    begin
      parent.init(ASide);
    end;

    override method Area(): int32;
    begin
      return 22;
    end;
  end;

  Point = object
    FX: int32;

    method Moved(const AStep: int32): int32;
    begin
      return self.FX + AStep;
    end;
  end;

// What dll_type_setup imports, so the loader loads the dll before its block
public func Ping(): int32;
begin
  return 1;
end;

end.
