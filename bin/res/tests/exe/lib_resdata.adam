-------------------------------------------------------------------------------
  lib_resdata.adam - a lib in its host (PLAN-ADAM M8d2): @addresdata in a
  lib. The lib's start and the exe's each add their table to the runtime's
  list, read as one set: the lib's key "libnote" (25 bytes) and the exe's
  "exeown" (256) both found from either side, the key both add ("shared")
  the exe's (the last started), listed once, the keys in byte-wise order
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  deps exe.lib_resdata_lib
  exitcode 0
  | lib count 3 libnote 25 shared 256
  | exe count 3 exeown 256 libnote 25 shared 256
  | key exeown
  | key libnote
  | key shared
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lib_resdata;

@linklibrary "lib_resdata_lib";
@addresdata "exeown" "$P:res/tests/std/fixtures/std_resdata_bin.dat";
@addresdata "shared" "$P:res/tests/std/fixtures/std_resdata_bin.dat";

import System.ResData;

func ResLibReport(); external "lib_resdata_lib";

var
  LKey: string;
  LI: int64;
begin
  ResLibReport();
  // a key in a variable: a literal the exe does not add would be SM0122
  LKey := "libnote";
  println("exe count {} exeown {} libnote {} shared {}", ResDataCount(),
    FindResData("exeown").Size, FindResData(LKey).Size, FindResData("shared").Size);
  for LI := 0 to ResDataCount() - 1 do
    println("key {}", ResDataKey(LI));
  end;
end.
