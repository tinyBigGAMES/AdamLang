-------------------------------------------------------------------------------
  exe_project_init.adam - adam init makes an exe, a dll and a lib project in
  the output folder (the folder adam runs in): project.toml as PaskalCPP
  writes it (LF, its three comments, a new 64-byte pack password that
  System.Toml reads back, another for each project), the kind's starter
  module, an empty assets folder (no pack script: adam pack is the one
  way, the same on every target); init on a folder
  that is there is PJ0014; the exe project builds as made and runs
  (PLAN-ADAM T4c; written by scripts\adam\gen_project_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  args "<ADAM>" "<OUT>" "<CELL>"
  exitcode 0
  | init exe started true exit 0
  | init exe [Created exe project prj_init_exe in <OUT>/prj_init_exe]
  | init exe [Build it with: adam build prj_init_exe]
  | toml [# Adam project (https://adamlang.org)]
  | toml [format = 1]
  | toml []
  | toml [# type: exe | dll | lib; main and output are relative to this folder]
  | toml [[project]]
  | toml [name = "prj_init_exe"]
  | toml [type = "exe"]
  | toml [main = "src/prj_init_exe.adam"]
  | toml [output = "output"]
  | toml []
  | toml [# password: printable ASCII; empty or absent = the .rez is not encrypted]
  | toml [[pack]]
  | toml [password = <masked>]
  | main [<open>******************************************************************************<CR>]
  | main [  prj_init_exe.adam - main module of prj_init_exe<CR>]
  | main [<CR>]
  | main [  Description:<CR>]
  | main [  Author:<CR>]
  | main [  Copyright:<CR>]
  | main [  License:<CR>]
  | main [******************************************************************************<close><CR>]
  | main [<CR>]
  | main [module exe prj_init_exe;<CR>]
  | main [<CR>]
  | main [begin<CR>]
  | main [  println("prj_init_exe runs");<CR>]
  | main [end.<CR>]
  | assets true files 0
  | exe password true length 64 printable true
  | again started true exit 1
  | again [Error PJ0014: The folder '<OUT>/prj_init_exe' already exists: a new project needs a folder of its own]
  | init dll started true exit 0
  | init dll [Created dll project prj_init_dll in <OUT>/prj_init_dll]
  | init dll [Build it with: adam build prj_init_dll]
  | dll main [<open>******************************************************************************<CR>]
  | dll main [  prj_init_dll.adam - main module of prj_init_dll<CR>]
  | dll main [<CR>]
  | dll main [  Description:<CR>]
  | dll main [  Author:<CR>]
  | dll main [  Copyright:<CR>]
  | dll main [  License:<CR>]
  | dll main [******************************************************************************<close><CR>]
  | dll main [<CR>]
  | dll main [module dll prj_init_dll;<CR>]
  | dll main [<CR>]
  | dll main [public routine clink prj_init_dll_add(AA: int32; AB: int32): int32;<CR>]
  | dll main [begin<CR>]
  | dll main [  return AA + AB;<CR>]
  | dll main [end;<CR>]
  | dll main [<CR>]
  | dll main [end.<CR>]
  | dll password true length 64 printable true
  | passwords differ true
  | init lib started true exit 0
  | init lib [Created lib project prj_init_lib in <OUT>/prj_init_lib]
  | init lib [Build it with: adam build prj_init_lib]
  | lib main [<open>******************************************************************************<CR>]
  | lib main [  prj_init_lib.adam - main module of prj_init_lib<CR>]
  | lib main [<CR>]
  | lib main [  Description:<CR>]
  | lib main [  Author:<CR>]
  | lib main [  Copyright:<CR>]
  | lib main [  License:<CR>]
  | lib main [******************************************************************************<close><CR>]
  | lib main [<CR>]
  | lib main [module lib prj_init_lib;<CR>]
  | lib main [<CR>]
  | lib main [public routine clink prj_init_lib_add(AA: int32; AB: int32): int32;<CR>]
  | lib main [begin<CR>]
  | lib main [  return AA + AB;<CR>]
  | lib main [end;<CR>]
  | lib main [<CR>]
  | lib main [end.<CR>]
  | build started true exit 0
  | run started true exit 0
  | run [prj_init_exe runs]
  | run [[Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0]
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_project_init;

import System.SysUtils, System.Windows, System.IO, System.Toml;

var
  GAdam: string;
  GOut: string;
  GCell: string;
  GArgs: StringArray;
  GExePassword: string;
  GDllPassword: string;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// Adds AText at the end of GArgs
routine Arg(const AText: string);
var
  LCount: int64;
begin
  LCount := len(GArgs);
  setlength(GArgs, LCount + 1);
  GArgs[LCount] := AText;
end;

// Each line of AText after ALabel, in [ ]: a CR shown as <CR>, a block comment's opener and
// closer as <open> / <close> (this row's expects sit in a block comment); the empty part
// after a last line end is no line
routine ShowText(const ALabel: string; const AText: string);
var
  LText: string;
  LParts: StringArray;
  LCount: int64;
  LI: int64;
begin
  LText := ReplaceStr(AText, "\r", "<CR>");
  LText := ReplaceStr(LText, "/*", "<open>");
  LText := ReplaceStr(LText, "*/", "<close>");
  LParts := SplitString(LText, "\n");
  LCount := len(LParts);
  if (LCount > 0) and (LParts[LCount - 1] = "") then
    LCount := LCount - 1;
  end;
  for LI := 0 to LCount - 1 do
    println("{}", ALabel + " [" + LParts[LI] + "]");
  end;
end;

// The file APath through ShowText; "missing" when it cannot be read
routine ShowFile(const ALabel: string; const APath: string);
var
  LText: string;
begin
  if not ReadAllText(APath, LText) then
    println("{}", ALabel + " missing");
    return;
  end;
  ShowText(ALabel, LText);
end;

// Runs AExe with GArgs (then emptied) in the output folder: whether it started and its exit
// code, then each line it printed (CRs dropped) through ShowText
routine RunTool(const ALabel: string; const AExe: string);
var
  LOutput: string;
  LCode: uint32;
  LOk: bool;
begin
  LOk := RunProcess(AExe, GArgs, GOut, LOutput, LCode);
  setlength(GArgs, 0);
  println("{}", ALabel + " started " + BoolText(LOk) + " exit " + IntToStr(int64(LCode)));
  ShowText(ALabel, ReplaceStr(LOutput, "\r", ""));
end;

// adam init AName AKind in the output folder (--no-banner: its status lines show)
routine RunInit(const ALabel: string; const AName: string; const AKind: string);
begin
  Arg("init");
  Arg("--no-banner");
  Arg(AName);
  Arg(AKind);
  RunTool(ALabel, GAdam);
end;

// Removes what an earlier run of this row left of the project AName in the output folder:
// only what adam init makes, each file by name and each folder only when empty (anything
// else left there makes this row's init fail on it)
routine RemoveProject(const AName: string);
var
  LDir: string;
begin
  LDir := GOut + "/" + AName;
  DeleteFile(LDir + "/project.toml");
  DeleteFile(LDir + "/src/" + AName + ".adam");
  RemoveDir(LDir + "/src");
  RemoveDir(LDir + "/assets");
  RemoveDir(LDir);
end;

// The project.toml of the project AName, its password line masked (a new one every run)
routine ShowProjectFile(const AName: string);
var
  LText: string;
  LParts: StringArray;
  LI: int64;
begin
  if not ReadAllText(GOut + "/" + AName + "/project.toml", LText) then
    println("{}", "toml missing");
    return;
  end;
  LParts := SplitString(LText, "\n");
  for LI := 0 to len(LParts) - 1 do
    if StartsStr("password = ", LParts[LI]) then
      LParts[LI] := "password = <masked>";
    end;
  end;
  ShowText("toml", JoinStrings(LParts, "\n"));
end;

// The pack password of the project AName as System.Toml reads it: found, its length, every
// byte printable ASCII without the blank; the password itself is the result
routine ShowPassword(const ALabel: string; const AName: string): string;
var
  LDoc: TomlDocument;
  LPassword: string;
  LOk: bool;
  LPrintable: bool;
  LByte: int32;
  LI: int64;
begin
  LPassword := "";
  LOk := LDoc.ParseFile(GOut + "/" + AName + "/project.toml");
  if LOk then
    LOk := LDoc.GetString("pack.password", LPassword);
  end;
  LPrintable := true;
  for LI := 0 to len(LPassword) - 1 do
    LByte := int32(uint8(LPassword[LI]));
    if (LByte < 33) or (LByte > 126) then
      LPrintable := false;
    end;
  end;
  println("{}", ALabel + " password " + BoolText(LOk) + " length " + IntToStr(len(LPassword)) +
    " printable " + BoolText(LPrintable));
  return LPassword;
end;

// The project AName's assets folder: read, and how many files it holds
routine ShowAssets(const AName: string);
var
  LFiles: StringArray;
  LOk: bool;
begin
  LOk := GetFiles(GOut + "/" + AName + "/assets", LFiles);
  println("{}", "assets " + BoolText(LOk) + " files " + IntToStr(len(LFiles)));
end;

begin
  GAdam := paramstr(1);
  GOut := paramstr(2);
  GCell := paramstr(3);
  setlength(GArgs, 0);
  RemoveProject("prj_init_exe");
  RemoveProject("prj_init_dll");
  RemoveProject("prj_init_lib");

  // An exe project: every file it holds read back
  RunInit("init exe", "prj_init_exe", "exe");
  ShowProjectFile("prj_init_exe");
  ShowFile("main", GOut + "/prj_init_exe/src/prj_init_exe.adam");
  ShowAssets("prj_init_exe");
  GExePassword := ShowPassword("exe", "prj_init_exe");

  // The same name again: its folder is there, nothing touched
  RunInit("again", "prj_init_exe", "exe");

  // A dll and a lib project: their starters, the dll's own password
  RunInit("init dll", "prj_init_dll", "dll");
  ShowFile("dll main", GOut + "/prj_init_dll/src/prj_init_dll.adam");
  GDllPassword := ShowPassword("dll", "prj_init_dll");
  println("{}", "passwords differ " + BoolText(GExePassword <> GDllPassword));
  RunInit("init lib", "prj_init_lib", "lib");
  ShowFile("lib main", GOut + "/prj_init_lib/src/prj_init_lib.adam");

  // The exe project builds as made, and its program runs
  Arg("build");
  Arg("--quiet");
  Arg(GOut + "/prj_init_exe");
  Arg("-o");
  Arg(GOut);
  RunTool("build", GAdam);
  RunTool("run", GOut + "/bin/" + GCell + "/prj_init_exe.exe");
end.
