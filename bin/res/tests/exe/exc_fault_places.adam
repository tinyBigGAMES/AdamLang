-------------------------------------------------------------------------------
  exc_fault_places.adam - Exceptions: hardware faults (BNF sec 5) taken
  wherever they happen, the same on both targets (PLAN-LINUX64 LX4c): a nil
  read inside a C library's routine (the C runtime's strlen: the C frames
  between unwind to the guard), a stack overflow on a started thread (a
  task, caught by its await's guard; then caught inside the task itself,
  twice), a nil write inside a generator's body (caught by the loop's
  guard), and a nil call (a fault at a pc no code is at). The program goes
  on after each; nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | c frame 3 Access violation
  | await 4 Stack overflow
  | inside 4 Stack overflow
  | inside 4 Stack overflow
  | got 1
  | generator 3 Access violation
  | nil call 3 Access violation
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_fault_places;

@ifdef TARGET_X86_64_LINUX_GNU
func strlen(const AText: ptr to const char): uint64; external "c";
@else
func strlen(const AText: ptr to const char): uint64; external "ucrtbase";
@endif

var
  GNil: ptr to int64;
  GNilText: ptr to const char;
  GNilFunc: func(): int64;
  GV: int64;

// A recursion with no end: every frame holds 2 KB, so the stack runs out
func Deep(const AN: int64): int64;
var
  LBuf: array[0..255] of int64;
begin
  LBuf[AN mod 256] := AN;
  return Deep(AN + 1) + LBuf[0];
end;

// A generator whose second step writes through the nil pointer
func Steps(): sequence of int64;
begin
  yield 1;
  GNil[0] := 2;
  yield 3;
end;

func Faults();
var
  LTask: task;
  LN: int64;
begin
  guard
    GV := int64(strlen(GNilText));
  except
    println("c frame {} {}", exccode(), excmsg());
  end;
  LTask := async begin
    GV := Deep(0);
  end;
  guard
    await LTask;
  except
    println("await {} {}", exccode(), excmsg());
  end;
  LTask := async begin
    guard
      GV := Deep(0);
    except
      println("inside {} {}", exccode(), excmsg());
    end;
    guard
      GV := Deep(0);
    except
      println("inside {} {}", exccode(), excmsg());
    end;
  end;
  await LTask;
  guard
    for LN in Steps() do
      println("got {}", LN);
    end;
  except
    println("generator {} {}", exccode(), excmsg());
  end;
  guard
    GV := GNilFunc();
  except
    println("nil call {} {}", exccode(), excmsg());
  end;
end;

begin
  GNil := nil;
  GNilText := nil;
  GNilFunc := nil;
  Faults();
  println("end");
end.
