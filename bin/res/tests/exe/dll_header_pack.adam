-------------------------------------------------------------------------------
  dll_header_pack.adam - a dll's C header writes packed(N) (M9e0d) as
  #pragma pack(push, N) / pop around the struct, its size, alignment and
  offsets checked as Adam lays them; a record with an anonymous part packed
  tighter has no C form. Read back line by line as dll_header does
*******************************************************************************/

/*
@@test
  kind run
  deps exe.dll_header_pack_lib
  exitcode 0
  | >/\* dll_header_pack_lib.h - the C interface of the Adam dll dll_header_pack_lib, written by adam: do not edit *\/
  | >
  | >#ifndef __adam_dll_header_pack_lib_h
  | >#define __adam_dll_header_pack_lib_h
  | >
  | >#include <stddef.h>
  | >#include <stdint.h>
  | >#include <stdbool.h>
  | >
  | >#ifndef __adam_c_header
  | >#define __adam_c_header
  | >#ifdef __cplusplus
  | >#define __adam_static_assert static_assert
  | >#define __adam_alignof alignof
  | >#define __adam_alignas alignas
  | >#define __adam_noreturn [[noreturn]]
  | >#else
  | >#define __adam_static_assert _Static_assert
  | >#define __adam_alignof _Alignof
  | >#define __adam_alignas _Alignas
  | >#define __adam_noreturn _Noreturn
  | >#endif
  | >#endif
  | >
  | >#ifdef __cplusplus
  | >extern "C" {
  | >#endif
  | >
  | >typedef struct Pair Pair;
  | >
  | >#pragma pack(push, 2)
  | >struct Pair {
  | >  uint8_t Tag;
  | >  uint32_t Size;
  | >  int64_t Big;
  | >};
  | >#pragma pack(pop)
  | >__adam_static_assert(sizeof(Pair) == 14, "Pair: Adam's size");
  | >__adam_static_assert(__adam_alignof(Pair) == 2, "Pair: Adam's alignment");
  | >__adam_static_assert(offsetof(Pair, Tag) == 0, "Pair.Tag: Adam's offset");
  | >__adam_static_assert(offsetof(Pair, Size) == 2, "Pair.Size: Adam's offset");
  | >__adam_static_assert(offsetof(Pair, Big) == 6, "Pair.Big: Adam's offset");
  | >
  | >extern __declspec(dllimport) int64_t Total(Pair AP);
  | >/\* Use: not declared, the type of parameter AM has no C form *\/
  | >
  | >#ifdef __cplusplus
  | >}
  | >#endif
  | >
  | >#endif
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_header_pack;

import System.SysUtils, System.IO;

const
  // The header, from the exe's folder (<output>\bin\<triple>\<mode>)
  HEADER_PATH: string = "$P:../../../lib/x86_64-windows-gnu/debug/dll_header_pack_lib.h";

var
  GText: string;
  GLines: StringArray;
  GI: int64;

begin
  if not ReadAllText(HEADER_PATH, GText) then
    println("no header");
    return;
  end;
  GLines := SplitString(GText, "\n");
  for GI := 0 to len(GLines) - 1 do
    if (GI < len(GLines) - 1) or (GLines[GI] <> "") then
      // a comment's ends written *\/ and /\*: this file's own comment holds the expected
      // lines
      println(">{}", ReplaceStr(ReplaceStr(GLines[GI], "*/", "*\\/"), "/*", "/\\*"));
    end;
  end;
end.
