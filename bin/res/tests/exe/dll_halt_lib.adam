  dll_halt_lib.adam - the dll of dll_halt (PLAN-ADAM M8c): built only; its
  routine calls Halt, which ends the whole process with that code
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_halt_lib;

// The process ended from inside the dll with ACode
public func HaltNow(const ACode: int32);
begin
  println("dll halt {}", ACode);
  Halt(ACode);
end;

initialize
begin
  println("halt dll init");
end;

finalize
begin
  println("halt dll final");
end;

end.
