-------------------------------------------------------------------------------
  dll_resdata.adam - DLL extras (PLAN-ADAM M8c): @addresdata inside a dll.
  The dll (dll_resdata_lib) reads its own key "note" (25 bytes, 'H' first)
  from its own image and finds one key, not the exe's; the exe reads its own
  key "own" (256 bytes) and finds one key, not the dll's
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  deps exe.dll_resdata_lib
  exitcode 0
  | dll count 1
  | dll note 25 first 72
  | dll own false
  | exe count 1
  | exe own 256
  | exe note false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dll_resdata;

@linklibrary "dll_resdata_lib";
@addresdata "own" "$P:res/tests/std/fixtures/std_resdata_bin.dat";

import System.ResData;

func ResCount(): int64; external "dll_resdata_lib";
func ResNoteSize(): int64; external "dll_resdata_lib";
func ResNoteFirst(): int32; external "dll_resdata_lib";
func ResHasOwn(): bool; external "dll_resdata_lib";

var
  LKey: string;
begin
  println("dll count {}", ResCount());
  println("dll note {} first {}", ResNoteSize(), ResNoteFirst());
  println("dll own {}", ResHasOwn());
  println("exe count {}", ResDataCount());
  println("exe own {}", FindResData("own").Size);
  // a key in a variable: a literal the exe does not add would be SM0122
  LKey := "note";
  println("exe note {}", HasResData(LKey));
end.
