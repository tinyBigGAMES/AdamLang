  lib_two_a.adam - lib A of lib_two (PLAN-ADAM M8d): built only; a string
  it keeps lives on the one heap it shares with lib_two's other
  lib and the exe (one runtime: the exe's own)
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module lib lib_two_a;

var
  // Made by its initialize, released by its teardown: the shared heap's report counts it
  GNameA: string;

public func TwoNameA(): int32;
begin
  println("{}!", GNameA);
  return int32(len(GNameA));
end;

initialize
begin
  GNameA := "lib " + "a";
  println("two lib a init");
end;

finalize
begin
  println("two lib a final");
end;

end.
