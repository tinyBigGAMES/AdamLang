-------------------------------------------------------------------------------
  exc_nil_own.adam - the nil owner check (M3.11b, DESIGN sec 5: a nil own
  raises; PaskalCPP's raise_nil_owner: code 3, "access through a nil own /
  ref"). An object reached through a nil ref raises 3, caught: a field read, a
  field write, a method call, a nil ref parameter, a nil ref field of a held
  object, a call's nil ref result; a held ref still reads, writes and calls as
  before; nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 7 show 7
  | done 7
  | 3 access through a nil own / ref
  | 3 access through a nil own / ref
  | 3 access through a nil own / ref
  | 3 access through a nil own / ref
  | 3 access through a nil own / ref
  | 3 access through a nil own / ref
  | 9
  | done 9
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_nil_own;

type
  TBox = object
    Value: int64;
    Next: ref TBox;

    done;
    begin
      println("done {}", self.Value);
    end;

    method Show();
    begin
      println("show {}", self.Value);
    end;
  end;

// A nil ref, from a call
routine NoBox(): ref TBox;
begin
  return nil;
end;

// The value of the object AR holds
routine ValueOf(const AR: ref TBox): int64;
begin
  return AR.Value;
end;

routine Held();
var
  LR: ref TBox;
begin
  LR := ref TBox();
  LR.Value := 7;
  print("{} ", LR.Value);
  LR.Show();
  LR := nil;
end;

routine Nils();
var
  LR: ref TBox;
  LV: int64;
begin
  guard
    LV := LR.Value;
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LR.Value := 5;
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LR.Show();
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LV := ValueOf(LR);
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LV := NoBox().Value;
  except
    println("{} {}", exccode(), excmsg());
  end;
  LR := ref TBox();
  LR.Value := 9;
  guard
    LV := LR.Next.Value;
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("{}", LR.Value);
end;

begin
  Held();
  Nils();
  println("end");
end.
