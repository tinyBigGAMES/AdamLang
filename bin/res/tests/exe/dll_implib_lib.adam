/*
@@test
  kind dep
@@end
*/

module dll dll_implib_lib;

public var
  // A variable: its import library imports it as data
  ImplibTotal: int32;

// Never exported: dll_neg_implib asks for it through the import library
func ImplibHidden(): int32;
begin
  return 0;
end;

public func ImplibMul(const AA: int32; const AB: int32): int32;
begin
  return AA * AB + ImplibHidden();
end;

public func ImplibAdd(const AStep: int32): int32;
begin
  ImplibTotal := ImplibTotal + AStep;
  return ImplibTotal;
end;

initialize
begin
  ImplibTotal := 10;
  println("implib dll init");
end;

finalize
begin
  println("implib dll final {}", ImplibTotal);
end;

end.
