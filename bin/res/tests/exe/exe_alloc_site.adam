-------------------------------------------------------------------------------
  exe_alloc_site.adam - The exe's allocation site table (M3.12b): every
  construct that allocates (a string or wstring made or grown, a dynamic
  array's setlength, literal or element write, ref new, create, getmem,
  resizemem, FormatStr, paramstr) is a site the compiler numbers in source
  order and lists in a read-only table in the exe. The program reads its own
  exe (ProgramPath, ReadFileBytes), finds the table by its magic and version
  and prints its own file's sites back: file(line,col): what, in id order.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | true 4 3
  | exe_alloc_site.adam(135,12): string
  | exe_alloc_site.adam(136,3): wstring
  | exe_alloc_site.adam(137,12): wstring
  | exe_alloc_site.adam(138,3): dynarray of int32
  | exe_alloc_site.adam(139,12): dynarray of int32
  | exe_alloc_site.adam(140,3): dynarray of int32
  | exe_alloc_site.adam(141,11): Box
  | exe_alloc_site.adam(142,3): Point
  | exe_alloc_site.adam(144,11): getmem
  | exe_alloc_site.adam(145,11): resizemem
  | exe_alloc_site.adam(147,12): string
  | exe_alloc_site.adam(148,12): string
  | exe_alloc_site.adam(178,13): string
  | other sites true
  | done
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_alloc_site;

import System.SysUtils, System.Runtime;

type
  // An object ref new makes (its site names the type)
  Box = object
    hidden FValue: int32;

    init(const AValue: int32);
    begin
      self.FValue := AValue;
    end;

    property Value: int32 read FValue;
  end;

  // A record create makes (its site names the type)
  Point = record
    X: int32;
    Y: int32;
  end;

const
  // This row's own file name: only its own sites are printed (the runtime's and the
  // std's change as those units do)
  ADAM_ROW_FILE: string = "exe_alloc_site.adam";

// The little-endian uint32 at AAt in AText
routine Le32(const AText: string; const AAt: int64): int64;
var
  LValue: int64;
  LI: int64;
begin
  LValue := 0;
  for LI := 3 downto 0 do
    LValue := (LValue shl 8) | int64(uint8(AText[AAt + LI]));
  end;
  return LValue;
end;

// The NUL-ended text at AAt in AText
routine TextAt(const AText: string; const AAt: int64): string;
var
  LEnd: int64;
begin
  LEnd := AAt;
  while (LEnd < len(AText)) and (uint8(AText[LEnd]) <> 0) do
    LEnd := LEnd + 1;
  end;
  return Substring(AText, AAt, LEnd - AAt);
end;

// Where the site table starts in AText: its magic AMagic, then its layout's version 1; -1
// when there is none
routine FindTable(const AText: string; const AMagic: string): int64;
var
  LFound: bool;
  LI: int64;
  LJ: int64;
begin
  for LI := 0 to len(AText) - len(AMagic) - 8 do
    LFound := true;
    LJ := 0;
    while LFound and (LJ < len(AMagic)) do
      LFound := AText[LI + LJ] = AMagic[LJ];
      LJ := LJ + 1;
    end;
    if LFound and (Le32(AText, LI + len(AMagic)) = 1) then
      return LI;
    end;
  end;
  return -1;
end;

// One construct of each allocating kind, each on its own line
routine Allocate();
var
  LText: string;
  LWide: wstring;
  LNums: array of int32;
  LBox: ref Box;
  LPoint: ptr to Point;
  LMem: ptr;
begin
  LText := "ab";
  LText := LText + LText;
  setlength(LWide, 2);
  LWide := LWide + LWide;
  setlength(LNums, 3);
  LNums := [4, 5, 6];
  LNums[0] := 7;
  LBox := ref Box(LNums[0]);
  create(LPoint);
  destroy(LPoint);
  LMem := getmem(16);
  LMem := resizemem(LMem, 32);
  freemem(LMem);
  LText := FormatStr("{}-{}", LText, LBox.Value);
  LText := paramstr(0);
  println("{} {} {}", len(LText) > 0, len(LWide), len(LNums));
end;

// The site table in the program's own exe: each of this file's sites printed in id order
routine ShowSites();
var
  LPath: ptr;
  LCount: int64;
  LData: ptr;
  LSize: int64;
  LText: string;
  LMagic: string;
  LTail: string;
  LAt: int64;
  LSites: int64;
  LPool: int64;
  LRecord: int64;
  LFile: string;
  LOwn: int64;
  LI: int64;
begin
  LPath := ProgramPath(LCount);
  LData := ReadFileBytes(ptr to const char(LPath), LSize);
  freemem(LPath);
  LText := StringFromC(ptr to const char(LData), LSize);
  freemem(LData);
  // the magic made as the program runs: whole, it sits nowhere in the exe but the table
  LMagic := "Adam";
  LTail := "Site";
  LMagic := LMagic + LTail;
  LAt := FindTable(LText, LMagic);
  if LAt < 0 then
    println("no site table");
    return;
  end;
  LSites := Le32(LText, LAt + 12);
  LPool := LAt + 16 + LSites * 16;
  LOwn := 0;
  for LI := 0 to LSites - 1 do
    LRecord := LAt + 16 + LI * 16;
    LFile := TextAt(LText, LPool + Le32(LText, LRecord + 8));
    if LFile = ADAM_ROW_FILE then
      println("{}({},{}): {}", LFile, Le32(LText, LRecord), Le32(LText, LRecord + 4),
        TextAt(LText, LPool + Le32(LText, LRecord + 12)));
      LOwn := LOwn + 1;
    end;
  end;
  println("other sites {}", LSites > LOwn);
end;

begin
  Allocate();
  ShowSites();
  println("done");
end.
