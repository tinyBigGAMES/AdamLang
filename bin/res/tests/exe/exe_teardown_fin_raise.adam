-------------------------------------------------------------------------------
  exe_teardown_fin_raise.adam - Teardown at process exit (BNF sec 1): a
  raise in a finalize, which runs inside the exit, is caught by its
  module's teardown and reported as one in the program block is; the exit
  is already under way, so the process then ends at once with exit code 1:
  no exit handler after it runs (no heap report).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 1
  | main
  | finalize
  | unhandled exception 1: in finalize
@@end
*/

module exe exe_teardown_fin_raise;

finalize
begin
  println("finalize");
  raise("in finalize");
end;

begin
  println("main");
end.
