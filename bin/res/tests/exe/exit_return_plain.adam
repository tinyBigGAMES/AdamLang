-------------------------------------------------------------------------------
  exit_return_plain.adam - A plain `return;` in an exe's module body keeps
  ExitCode (BNF sec 5, M8h): the body sets ExitCode, a plain return ends it
  and the process ends with the value set; a constant expression (2 * 3,
  an integer literal's type) converts to ExitCode's int32.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 4
  | set 6
  | set 4
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exit_return_plain;

var
  GLater: bool;

begin
  ExitCode := 2 * 3;
  println("set {}", ExitCode);
  ExitCode := ExitCode - 2;
  println("set {}", ExitCode);
  if not GLater then
    return;
  end;
  return 9;
end.
