-------------------------------------------------------------------------------
  exe_halt_std.adam - The one Halt: a program that imports a std unit
  (System.Windows, as the compiler does) names Halt bare and gets
  System.Runtime's public Halt, called from a routine two calls down. The
  exit handlers run (the module's finalize, its variable released, the
  heap report), the caller's code after the call never runs, and the exit
  code is Halt's.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 5
  | start
  | stopping with 5
  | finalize sees kept
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_halt_std;

import System.Windows;

var
  GNote: string;

// Ends the program from inside a routine: nothing after the Halt runs
routine Stop(const ACode: int32);
begin
  println("stopping with {}", ACode);
  Halt(ACode);
  println("not reached stop");  // WARN SM0622
end;

routine Work();
begin
  Delay(0);
  Stop(5);
  println("not reached work");
end;

finalize
begin
  println("finalize sees {}", GNote);
end;

begin
  GNote := "kept";
  println("start");
  Work();
  println("not reached main");
end.
