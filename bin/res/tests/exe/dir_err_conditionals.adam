-------------------------------------------------------------------------------
  dir_err_conditionals.adam - Break step of dir_conditionals: @endif /
  @elseif / @else with no opener are CD0002; @else or @elseif after a
  frame's @else is CD0003; a conditional directive with no identifier
  after it (a string literal in its place, a keyword) is CD0001; an @ifdef
  never closed is CD0004 at its opener at the end of the file; each at its
  '@', one report per mistake
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe dir_err_conditionals;

@define DIRE_ON

@endif // ERROR CD0002@1: '@endif' has no @ifdef or @ifndef to belong to
@elseif DIRE_ON // ERROR CD0002@1: '@elseif' has no @ifdef or @ifndef to belong to
@else // ERROR CD0002@1: '@else' has no @ifdef or @ifndef to belong to
@ifdef DIRE_ON
@else
@else // ERROR CD0003@1: '@else' after @else: @else is the last branch
@elseif DIRE_ON // ERROR CD0003@1: '@elseif' after @else: @else is the last branch
@endif
@ifndef "DIRE_ON" // ERROR CD0001@1: '@ifndef' needs a symbol (an identifier)
@endif
@define // ERROR CD0001@1: '@define' needs a symbol (an identifier)
@ifdef DIRE_ON // ERROR CD0004@1: the '@ifdef' here is never closed by an @endif

var
  GN: int32;

begin
  GN := 1;
  println("{}", GN);
end.
