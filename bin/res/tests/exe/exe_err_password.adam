-------------------------------------------------------------------------------
  exe_err_password.adam - Break step of exe_project_password (PLAN-ADAM
  T4d1, PaskalCPP's prj_password_err_outside): no project.toml is at or
  above this file, so it is a plain build with no pack password, and
  ProjectPassword() is SM0433 at the call, and nothing more is reported.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe exe_err_password;

var
  GText: string;

begin
  GText := ProjectPassword(); // ERROR SM0433@12: 'ProjectPassword' is only in a project build: the main module of a project.toml and the units it imports
end.
