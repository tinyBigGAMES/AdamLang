-------------------------------------------------------------------------------
  exe_runtime_shadow.adam - An imported unit's export wins over the
  runtime's public name of the same spelling (BNF sec 1, 2026-11-10):
  fixtures\RuntimeShadow.adam exports a const HeapLive, so a bare HeapLive
  is that const.
*******************************************************************************/

/*
@@test
  kind run
  | shadow 42
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_runtime_shadow;

@addmodulepath "$P:res/tests/exe/fixtures";

import RuntimeShadow;

begin
  println("shadow {}", HeapLive);
end.
