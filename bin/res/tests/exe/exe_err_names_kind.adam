-------------------------------------------------------------------------------
  exe_err_names_kind.adam - Break step of names (AUD5): a name no scope
  holds is reported for what it is, at the name (pcpp's reports): a member
  an embed reaches written bare SM0018, a module's name in a type's place
  SM0013 (a choice value there too), a qualified type with parts past its
  module's type SM0008, an external clause's library name that is no const
  SM0326, a choices type's missing value SM0010, the program's own module
  before '.' SM0007, an imported module spelled whole as a value SM0269.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe exe_err_names_kind;

import System.Diagnostics;

type
  Color = choices(Red, Green);
  Counter = object
    Count: int32;
  end;
  Box = object
    embed C: Counter;
    method Put();
    begin
      Count := 1; // ERROR SM0018@7
    end;
  end;
  TA = System; // ERROR SM0013@8
  TB = System.Diagnostics.Stopwatch.Extra; // ERROR SM0008@8
  TD = Red; // ERROR SM0013@8

const
  KOwn: int32 = 1;

routine clink Missing(AN: int32): int32; external CMissing; // ERROR SM0326@51

var
  GK: Color = Color.Blue; // ERROR SM0010@21

begin
  println("{}", exe_err_names_kind.KOwn); // ERROR SM0007@17
  println("{}", System.Diagnostics); // ERROR SM0269@17
  println("{}", System.Diagnostics.GetTimeStamp() > 0);
end.
