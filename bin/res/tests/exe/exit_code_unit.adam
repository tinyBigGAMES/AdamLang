-------------------------------------------------------------------------------
  exit_code_unit.adam - ExitCode set by a unit with no halt (BNF sec 5,
  M8h): the unit's routine writes the runtime's ExitCode (in scope with no
  import, BNF sec 1), the body goes on to its end and the process ends
  with that code.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 5
  | unit sets 5
  | body goes on 5
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exit_code_unit;

@addmodulepath "$P:res/tests/exe/fixtures";
import ExitUnit;

begin
  SetCode(5);
  println("body goes on {}", ExitCode);
end.
