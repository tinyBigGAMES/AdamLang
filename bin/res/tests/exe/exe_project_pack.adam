  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  exe_project_pack.adam - adam pack: a project made in the output folder
  (a [pack] password, assets/a.txt and assets/sub/b.txt) packed into
  output/prj_pack.rez (each entry, the count and the archive printed;
  nothing under --quiet), then built (the build copies the .rez beside
  its exe) and run: its main module reads both entries back from
  $P:prj_pack.rez with ProjectPassword(), and not with a wrong password
  (ZipCrypto); then a.txt changed and packed again updates that copy
  (Updated) and the same exe, not rebuilt, reads the new text
  (PLAN-ADAM T4d2; written by scripts\adam\gen_project_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  args "<ADAM>" "<OUT>" "<CELL>"
  exitcode 0
  | pack started true exit 0
  | pack [Packing <OUT>/prj_pack/assets into <OUT>/prj_pack/output/prj_pack.rez]
  | pack [  a.txt]
  | pack [  sub/b.txt]
  | pack [entries 2]
  | pack [Packed <OUT>/prj_pack/output/prj_pack.rez]
  | quiet started true exit 0
  | build started true exit 0
  | run started true exit 0
  | run [a.txt [alpha]]
  | run [sub/b.txt [bravo]]
  | run [wrong password reads false]
  | run [[Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0]
  | repack started true exit 0
  | repack [Packing <OUT>/prj_pack/assets into <OUT>/prj_pack/output/prj_pack.rez]
  | repack [  a.txt]
  | repack [  sub/b.txt]
  | repack [entries 2]
  | repack [Packed <OUT>/prj_pack/output/prj_pack.rez]
  | repack [Updated <OUT>/prj_pack/output/bin/<CELL>/prj_pack.rez]
  | rerun started true exit 0
  | rerun [a.txt [alpha two]]
  | rerun [sub/b.txt [bravo]]
  | rerun [wrong password reads false]
  | rerun [[Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0]
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_project_pack;

import System.SysUtils, System.Windows, System.IO, System.Process;

var
  GAdam: string;
  GOut: string;
  GCell: string;
  GDir: string;
  GArgs: StringArray;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// Adds AText at the end of GArgs
routine Arg(const AText: string);
var
  LCount: int64;
begin
  LCount := len(GArgs);
  setlength(GArgs, LCount + 1);
  GArgs[LCount] := AText;
end;

// Each line of AText after ALabel, in [ ]; the empty part after a last line end is no line
routine ShowText(const ALabel: string; const AText: string);
var
  LParts: StringArray;
  LCount: int64;
  LI: int64;
begin
  LParts := SplitString(AText, "\n");
  LCount := len(LParts);
  if (LCount > 0) and (LParts[LCount - 1] = "") then
    LCount := LCount - 1;
  end;
  for LI := 0 to LCount - 1 do
    println("{}", ALabel + " [" + LParts[LI] + "]");
  end;
end;

// Runs AExe with GArgs (then emptied) in the output folder: whether it started and its exit
// code, then each line it printed (CRs dropped) through ShowText
routine RunTool(const ALabel: string; const AExe: string);
var
  LOutput: string;
  LCode: uint32;
  LOk: bool;
begin
  LOk := RunProcess(AExe, GArgs, GOut, LOutput, LCode);
  setlength(GArgs, 0);
  println("{}", ALabel + " started " + BoolText(LOk) + " exit " + IntToStr(int64(LCode)));
  ShowText(ALabel, ReplaceStr(LOutput, "\r", ""));
end;

// Writes AText as the file APath below the project, its folder made; false said when it fails
routine Put(const APath: string; const AText: string);
begin
  if not ForceDirectories(ExtractFileDir(GDir + "/" + APath)) or
    not WriteAllText(GDir + "/" + APath, AText) then
    println("{}", "cannot write " + APath);
  end;
end;

// The project's output folder's bin part for the run cell GCell (<triple>/<mode>): where
// its build writes the exe and copies the .rez beside it
routine BinDir(): string;
begin
  return GDir + "/output/bin/" + GCell;
end;

// The archive adam pack writes: <name>.rez in the output folder itself
routine RezPath(): string;
begin
  return GDir + "/output/prj_pack.rez";
end;

// Removes what an earlier run of this row left in the project's folder: each file by name and
// each folder only when empty (anything else left there stays)
routine RemoveProject();
begin
  DeleteFile(GDir + "/project.toml");
  DeleteFile(GDir + "/src/prj_pack.adam");
  DeleteFile(GDir + "/assets/a.txt");
  DeleteFile(GDir + "/assets/sub/b.txt");
  DeleteFile(BinDir() + "/prj_pack.rez");
  DeleteFile(BinDir() + "/prj_pack.exe");
  DeleteFile(RezPath());
  RemoveDir(GDir + "/src");
  RemoveDir(GDir + "/assets/sub");
  RemoveDir(GDir + "/assets");
  RemoveDir(BinDir());
  RemoveDir(ExtractFileDir(BinDir()));
  RemoveDir(GDir + "/output/bin");
  RemoveDir(GDir + "/output");
  RemoveDir(GDir);
end;

begin
  GAdam := paramstr(1);
  GOut := paramstr(2);
  GCell := paramstr(3);
  GDir := GOut + "/prj_pack";
  setlength(GArgs, 0);
  RemoveProject();
  Put("project.toml", "format = 1\n\n[project]\nname = \"prj_pack\"\ntype = \"exe\"\n" +
    "main = \"src/prj_pack.adam\"\n\n[pack]\npassword = \"Pack Me! 12345678\"\n");
  Put("src/prj_pack.adam", "/*******************************************************************************\n  Adam™ Programming Language\n\n  Copyright © 2026-present tinyBigGAMES™ LLC\n  All Rights Reserved.\n\n  https://adamlang.org\n\n  SPDX-License-Identifier: MPL-2.0\n\n  This Source Code Form is subject to the terms of the\n  Mozilla Public License, v. 2.0. If a copy of the MPL\n  was not distributed with this file, You can obtain one\n  at https://mozilla.org/MPL/2.0/.\n-------------------------------------------------------------------------------\n  prj_pack.adam - the main module of the project the row\n  exe\\exe_project_pack makes in the output folder\n*******************************************************************************/\n\nmodule exe prj_pack;\n\nimport System.CustomIO;\n\n// The entry AName of the project's .rez ($P: the exe's folder, where its build copied it) read\n// with APassword: whether it opened and read whole, and its text\nroutine Show(const AName: string; const APassword: string): string;\nvar\n  LIO: IO;\n  LText: string;\nbegin\n  LIO := CreateZipFileIO(\"$P:prj_pack.rez\", AName, APassword);\n  if LIO = nil then\n    return \"\";\n  end;\n  if not IOReadAll(LIO, LText) then\n    LText := \"\";\n  end;\n  IOClose(LIO);\n  return LText;\nend;\n\nbegin\n  println(\"a.txt [{}]\", Show(\"a.txt\", ProjectPassword()));\n  println(\"sub/b.txt [{}]\", Show(\"sub/b.txt\", ProjectPassword()));\n  println(\"wrong password reads {}\", Show(\"a.txt\", \"wrong\") = Show(\"a.txt\", ProjectPassword()));\nend.\n");
  Put("assets/a.txt", "alpha");
  Put("assets/sub/b.txt", "bravo");

  // The pack: its lines, then again under --quiet (none)
  Arg("pack");
  Arg("--no-banner");
  Arg(GDir);
  RunTool("pack", GAdam);
  Arg("pack");
  Arg("--quiet");
  Arg(GDir);
  RunTool("quiet", GAdam);

  // The project built into its output folder (the build copies the .rez beside its exe), and
  // run
  Arg("build");
  Arg("--quiet");
  Arg(GDir);
  RunTool("build", GAdam);
  RunTool("run", BinDir() + "/prj_pack.exe");

  // An asset changed and packed again: the copy beside the exe is updated, and the same exe
  // (not rebuilt) reads the new text
  Put("assets/a.txt", "alpha two");
  Arg("pack");
  Arg("--no-banner");
  Arg(GDir);
  RunTool("repack", GAdam);
  RunTool("rerun", BinDir() + "/prj_pack.exe");
end.
