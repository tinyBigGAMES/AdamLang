-------------------------------------------------------------------------------
  exc_raise_main.adam - Exceptions: a raise in the program block itself
  (PLAN-SELFHOST S3), inside a guard there: the entry's own frame unwinds to
  its catch, its guard's finally first, then the report. A raise nothing
  caught ends the process through the exit (BNF sec 1): after the report
  the module's teardown runs its finalize and releases its variable, then
  the heap report, nothing leaked; the raise's text is a call's result (a
  temporary of the program block)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 1
  | main body
  | main finally
  | unhandled exception 1: main text
  | main finalize
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_raise_main;

var
  GWhat: string;

// The raise's text, a temporary of the program block
func What(): string;
begin
  return GWhat;
end;

finalize
begin
  println("main finalize");
end;

begin
  GWhat := "main text";
  guard
    println("main body");
    raise(What());
    println("not reached body");  // WARN SM0622
  finally
    println("main finally");
  end;
  println("not reached main");  // WARN SM0622
end.
