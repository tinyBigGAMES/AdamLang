-------------------------------------------------------------------------------
  exc_raise_main.adam - Exceptions: a raise in the program block itself
  (PLAN-SELFHOST S3), inside a guard there: the entry's own frame unwinds to
  its catch, its guard's finally first, then the report. A module's
  finalize section never runs after a raise nothing caught (the process
  ends at once, as PaskalCPP's std::_Exit); the raise's text is a call's
  result (a temporary of the program block)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 1
  | main body
  | main finally
  | unhandled exception 1: main text
@@end
*/

module exe exc_raise_main;

var
  GWhat: string;

// The raise's text, a temporary of the program block
routine What(): string;
begin
  return GWhat;
end;

finalize
begin
  println("not reached finalize");
end;

begin
  GWhat := "main text";
  guard
    println("main body");
    raise(What());
    println("not reached body");
  finally
    println("main finally");
  end;
  println("not reached main");
end.
