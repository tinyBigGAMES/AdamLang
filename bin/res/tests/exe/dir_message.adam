-------------------------------------------------------------------------------
  dir_message.adam - @message (BNF sec 2 / 5, AUD3 / AUDIT 2.7): reported at
  compile time (SM0108 at its '@', its own text) at its severity, in the
  prologue and as a statement wherever one stands: a routine never called, a
  match arm, a loop body, the program block; once each, whether or not its
  code runs; one in an inactive @ifdef branch reports nothing. hint and warn
  let the build go on, and the program runs as its statements say.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | before
  | arm 1
  | pass 1
  | pass 2
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe dir_message;

@message hint "dir_message: a hint from the prologue"; // HINT SM0108@1: dir_message: a hint from the prologue
@message warn "dir_message: a warning from the prologue"; // WARN SM0108@1: dir_message: a warning from the prologue
@ifdef DIR_MESSAGE_NEVER
@message error "dir_message: never reported (inactive branch)";
@endif

var
  GI: int32;

func Unused();
begin
  @message hint "dir_message: in a routine never called"; // HINT SM0108@3: dir_message: in a routine never called
end;

func Show(const AN: int32);
begin
  match AN of
    1:
      @message warn "dir_message: in a match arm"; // WARN SM0108@7: dir_message: in a match arm
      println("arm 1");
  else
    println("other");
  end;
end;

begin
  println("before");
  @message hint "dir_message: in the program block"; // HINT SM0108@3: dir_message: in the program block
  Show(1);
  for GI := 1 to 2 do
    @message hint "dir_message: in a loop, reported once"; // HINT SM0108@5: dir_message: in a loop, reported once
    println("pass {}", GI);
  end;
end.
