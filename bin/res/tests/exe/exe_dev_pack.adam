  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  exe_dev_pack.adam - Adam.Dev.Pack (adam --dev-pack, PLAN-LINUX64 PK4),
  imported from the compiler's own src\: in the row's own folder below its
  exe (made the working folder, so the spec is named relative), a tree and
  a spec of two archives: out/a.zip (two files, checksum) and out/b.zip
  (prefix pre, 501 files: a progress line at 500), a stale b.zip.minisig
  planted (removed by the build). DevPack's lines (paths below the spec's
  folder shown relative), PACK OK, both zips there, the stale signature
  gone. Failure paths: no spec given, a spec with an unknown key (PACK
  FAILED with its place, relative). Everything removed at the end. Both
  targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | Pack spec pack.toml
  | [1/2] out/a.zip
  |   2 entries, <NUM> bytes, tested, .sha256
  | [2/2] out/b.zip
  |   500 of 501 entries
  |   501 entries, <NUM> bytes, tested
  | PACK OK
  | result true
  | zips true true
  | stale minisig gone true
  | PACK FAILED - no spec given (adam --dev-pack <spec>.toml)
  | no spec false
  | Pack spec bad.toml
  | PACK FAILED - bad.toml(2,10): unknown key colour
  | bad spec false
  | removed true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_dev_pack;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Dev.Pack;

var
  GDir: string;
  GHome: string;
  GOk: bool;
  GI: int64;

begin
  GHome := CurrentDir();
  GDir := ExeDir() + "/exe_dev_pack_files";
  RemoveDir(GDir, true);
  ForceDirectories(GDir + "/tree/bin");
  ForceDirectories(GDir + "/many");
  ForceDirectories(GDir + "/out");
  WriteAllText(GDir + "/tree/a.txt", "a\n");
  WriteAllText(GDir + "/tree/bin/tool", "#!/bin/sh\n");
  for GI := 0 to 500 do
    WriteAllText(GDir + "/many/f" + IntToStr(GI) + ".txt", IntToStr(GI));
  end;
  WriteAllText(GDir + "/out/b.zip.minisig", "stale");
  WriteAllText(GDir + "/pack.toml",
    "[[archive]]\noutput = \"out/a.zip\"\nroot = \"tree\"\ninclude = [\"**\"]\n" +
    "checksum = true\nunix_mode = { \"bin/tool\" = 0o755 }\n" +
    "[[archive]]\noutput = \"out/b.zip\"\nroot = \"many\"\nprefix = \"pre\"\n" +
    "include = [\"*.txt\"]\n");
  WriteAllText(GDir + "/bad.toml", "[[archive]]\ncolour = 1\n");
  SetCurrentDir(GDir);

  GOk := DevPack("pack.toml");
  println("result {}", GOk);
  println("zips {} {}", FileExists("out/a.zip"), FileExists("out/b.zip"));
  println("stale minisig gone {}", not FileExists("out/b.zip.minisig"));
  GOk := DevPack("");
  println("no spec {}", GOk);
  GOk := DevPack("bad.toml");
  println("bad spec {}", GOk);

  SetCurrentDir(GHome);
  println("removed {}", RemoveDir(GDir, true));
end.
