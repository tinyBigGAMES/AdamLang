-------------------------------------------------------------------------------
  dll_type_bind_lib.adam - the dll of dll_type_bind (PLAN-ADAM MO1b0 c): built
  only; its public types are what dll_type_bind declares external: an
  interface, an object implementing it (init, done, a virtual, an
  overloaded pair, a hidden helper) and a child overriding the virtual;
  each done counts into the public variable Dones
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_type_bind_lib;

public var
  Dones: int32;

public type
  IArea = interface
    method Area(): int32;
  end;

  Shape = object implements IArea
    FSide: int32;

    init(const ASide: int32);
    begin
      self.FSide := ASide;
    end;

    done;
    begin
      Dones := Dones + 1;
    end;

    virtual method Area(): int32;
    begin
      return 11;
    end;

    method Grow(const AStep: int32);
    begin
      self.FSide := self.FSide + AStep;
      self.Tidy();
    end;

    method Grow(const AStep: int32; const ATimes: int32);
    begin
      self.FSide := self.FSide + AStep * ATimes;
      self.Tidy();
    end;

    method Side(): int32;
    begin
      return self.FSide;
    end;

    hidden method Tidy();
    begin
      if self.FSide < 0 then
        self.FSide := 0;
      end;
    end;
  end;

  Square = object(Shape)
    init(const ASide: int32);
    begin
      parent.init(ASide);
    end;

    override method Area(): int32;
    begin
      return 22;
    end;
  end;

end.
