-------------------------------------------------------------------------------
  dll_fault_lib.adam - the dll of dll_fault (PLAN-ADAM M8c): built only; its
  routines fault or raise inside their own guards and catch it there, in the
  dll: a nil write, an integer divide by zero, a raise, and a fault two
  frames down whose finally runs as the dll's frames unwind
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_fault_lib;

var
  GZero: int64;
  GNil: ptr to int64;

// A write through a nil pointer: the hardware's access violation
func WriteNil();
begin
  GNil[0] := 5;
end;

// A fault two frames down from the guard: this frame's finally runs and its string is
// released as the frames unwind
func Inner();
var
  LText: string;
begin
  LText := "inner " + "text";
  guard
    WriteNil();
  finally
    println("dll inner finally {}", LText);
  end;
end;

// Each fault or raise caught by its guard in the dll, its code and text printed; how many
// were caught
public func FaultAll(): int32;
var
  LA: int64;
  LV: int64;
  LCaught: int32;
begin
  LCaught := 0;
  guard
    WriteNil();
  except
    println("dll {} {}", exccode(), excmsg());
    LCaught := LCaught + 1;
  end;
  LA := 7;
  guard
    LV := LA div GZero;
  except
    println("dll {} {}", exccode(), excmsg());
    LCaught := LCaught + 1;
  end;
  guard
    raise("dll text");
  except
    println("dll {} {}", exccode(), excmsg());
    LCaught := LCaught + 1;
  end;
  guard
    Inner();
  except
    println("dll {} {}", exccode(), excmsg());
    LCaught := LCaught + 1;
  end;
  return LCaught;
end;

initialize
begin
  GZero := 0;
  GNil := nil;
end;

end.
