-------------------------------------------------------------------------------
  dir_exeicon_image.adam - the compiler's own .ico decoder (Adam.Backend.Icon,
  imported from the compiler's src\ beside bin\; PLAN-LINUX64 LX3d3c3b2,
  BNF sec 2: @exeicon's largest image on a target whose exe carries no
  icon) on both targets: each fixture of fixtures\dir_exeicon_image
  (scripts\adam\make_icon_fixtures.py, its pixels the truth: the crc-32 of
  the RGBA rows top down and the first pixel) decoded by IconImage, and
  the faults: no directory, no image, cut short (fixtures\dir_err_exeicon),
  a PNG with a wrong CRC and an RLE DIB (BadImage, IconImage's AImage
  empty); dir_exeicon_noext's 1x1 icon too (BGRA 40 80 C0 FF)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | bmp1 None 5x3 crc 707892147 first 0 3 255 0
  | bmp4 None 7x4 crc 2602386396 first 0 3 255 0
  | bmp8 None 9x5 crc 124377618 first 0 3 255 0
  | bmp16 None 6x3 crc 3791323174 first 0 0 0 0
  | bmp24 None 6x6 crc 4068667093 first 221 197 210 255
  | bmp32 None 4x4 crc 1360614063 first 27 83 94 5
  | bmp32mask None 3x3 crc 697090556 first 89 41 234 255
  | png_rgba None 8x8 crc 1131221983 first 151 135 118 9
  | png_pal None 7x5 crc 1098795575 first 0 0 200 0
  | png_grey2 None 9x3 crc 528456684 first 0 0 0 255
  | png_grey16 None 5x4 crc 1239087461 first 0 0 0 255
  | png_greya None 6x4 crc 4160631003 first 0 0 0 0
  | png_rgb16 None 4x4 crc 1355939829 first 0 0 0 255
  | png_adam7 None 11x9 crc 1428092311 first 19 235 142 13
  | multi None 32x32 crc 566674644 first 170 212 4 22
  | bad_crc BadImage 0
  | bad_rle BadImage 0
  | app None 1x1 crc 1799850514 first 192 128 64 255
  | text NoDirectory 0
  | empty NoImage 0
  | cut PastEnd 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dir_exeicon_image;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.Zlib.Ext, Adam.Backend.Icon;

const
  // The fixture folders, from the exe's folder (output\bin\<triple>\<mode>)
  ROW_IMAGES: string = "$P:../../../../res/tests/exe/fixtures/dir_exeicon_image/";
  ROW_FAULTS: string = "$P:../../../../res/tests/exe/fixtures/dir_err_exeicon/";
  ROW_APP: string = "$P:../../../../res/tests/exe/fixtures/dir_exeicon_noext/";

// AFault's name
func FaultText(const AFault: IconFault): string;
begin
  match AFault of
    IconFault.None: return "None";
    IconFault.NoDirectory: return "NoDirectory";
    IconFault.NoImage: return "NoImage";
    IconFault.PastEnd: return "PastEnd";
    IconFault.BadImage: return "BadImage";
  end;
  return "?";
end;

// The icon AName.ico of AFolder decoded and printed: its fault, then (decoded) its size,
// the crc-32 of its RGBA rows and its first pixel, else the decoded bytes' count (0)
func Decode(const AFolder: string; const AName: string);
var
  LFile: ByteArray;
  LImage: ByteArray;
  LPixels: ByteArray;
  LFault: IconFault;
  LI: int64;
begin
  if not ReadAllBytes(ResolvePath(AFolder + AName + ".ico"), LFile) then
    println("{} unreadable", AName);
    return;
  end;
  LFault := IconImage(LFile, LImage);
  if LFault <> IconFault.None then
    println("{} {} {}", AName, FaultText(LFault), len(LImage));
    return;
  end;
  setlength(LPixels, len(LImage) - ADAM_ICON_IMAGE_HEADER);
  for LI := 0 to len(LPixels) - 1 do
    LPixels[LI] := LImage[ADAM_ICON_IMAGE_HEADER + LI];
  end;
  println("{} {} {}x{} crc {} first {} {} {} {}", AName, FaultText(LFault),
    GetLe(LImage, 0, 4), GetLe(LImage, 4, 4), ZlibCrc32(0, LPixels), LPixels[0], LPixels[1],
    LPixels[2], LPixels[3]);
end;

begin
  Decode(ROW_IMAGES, "bmp1");
  Decode(ROW_IMAGES, "bmp4");
  Decode(ROW_IMAGES, "bmp8");
  Decode(ROW_IMAGES, "bmp16");
  Decode(ROW_IMAGES, "bmp24");
  Decode(ROW_IMAGES, "bmp32");
  Decode(ROW_IMAGES, "bmp32mask");
  Decode(ROW_IMAGES, "png_rgba");
  Decode(ROW_IMAGES, "png_pal");
  Decode(ROW_IMAGES, "png_grey2");
  Decode(ROW_IMAGES, "png_grey16");
  Decode(ROW_IMAGES, "png_greya");
  Decode(ROW_IMAGES, "png_rgb16");
  Decode(ROW_IMAGES, "png_adam7");
  Decode(ROW_IMAGES, "multi");
  Decode(ROW_IMAGES, "bad_crc");
  Decode(ROW_IMAGES, "bad_rle");
  Decode(ROW_APP, "app");
  Decode(ROW_FAULTS, "text");
  Decode(ROW_FAULTS, "empty");
  Decode(ROW_FAULTS, "cut");
end.
