-------------------------------------------------------------------------------
  exc_guard.adam - Exceptions: a guard's finally (PLAN-SELFHOST S2), on both
  ways out of its body. Where the body falls through: a leave of a loop
  inside the body (System.Windows' shape) then the finally, which reads a
  var parameter and a local; nested guards, the inner finally first.
  Where an unwind leaves the body: kernel32's RaiseException three frames
  down, the process's unhandled exception filter answering "execute the
  handler" (so the OS unwinds every frame: Win64 SEH's second pass), and
  each finally runs as its frame unwinds, innermost first: two nested
  guards in one frame (the inner finally's own loop, both reading and
  writing the caller's int32 through a var parameter), then a realigned
  frame's (a record aligned 32: its field read back from the rounded
  frame). The filter prints before any finally (the search pass comes
  first); nothing after the raise prints, and the process ends with the
  exception's code. Every line is flushed at once (the process ends
  without the C runtime's exit)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 536870978
  | count finally
  | count 6
  | nested body
  | inner body
  | inner finally
  | after inner
  | outer finally
  | raising
  | filter
  | level2 inner finally loop 3
  | level2 outer finally 11
  | level1 wide 7
  | level1 count 11
@@end
*/

module exe exc_guard;

routine fflush(const AStream: ptr): int32; external "ucrtbase";
routine RaiseException(const ACode: uint32; const AFlags: uint32; const ACount: uint32;
  const AArguments: ptr); external "kernel32";
routine SetUnhandledExceptionFilter(const AFilter: routine(const AInfo: ptr): int32): ptr;
  external "kernel32";

const
  // The raised exception's code (bit 29: an application's own), the process's exit code
  EXC_CODE: uint32 = 0x20000042;
  // The filter's answer: run the handler (the OS's top frame ends the process), so the
  // frames between unwind
  EXC_EXECUTE_HANDLER: int32 = 1;

type
  TWide = record align(32)
    A: int32;
    B: int64;
  end;

var
  GCount: int32;

// ALine printed and flushed at once
routine Say(const ALine: string);
begin
  println("{}", ALine);
  fflush(nil);
end;

// The process's unhandled exception filter: run the handler
routine Filter(const AInfo: ptr): int32;
begin
  Say("filter");
  return EXC_EXECUTE_HANDLER;
end;

// A leave of a loop inside the body, then the finally reading ACount and a local
routine Count(var ACount: int32);
var
  LI: int32;
begin
  LI := 0;
  guard
    while true do
      LI := LI + 1;
      if LI > 3 then
        leave;
      end;
      ACount := ACount + LI;
    end;
  finally
    Say("count finally");
    if (ACount = 6) and (LI = 4) then
      Say("count 6");
    end;
  end;
end;

// Nested guards falling through: the inner finally, then the outer one
routine Nested();
begin
  guard
    Say("nested body");
    guard
      Say("inner body");
    finally
      Say("inner finally");
    end;
    Say("after inner");
  finally
    Say("outer finally");
  end;
end;

// The raise: nothing after it runs
routine Raise();
begin
  Say("raising");
  RaiseException(EXC_CODE, 0, 0, nil);
  Say("not reached raise");
end;

// Two nested guards in one frame, unwound: the inner finally's loop, then the outer one,
// each through the var parameter
routine Level2(var ACount: int32);
var
  LI: int32;
  LSum: int32;
begin
  guard
    guard
      ACount := ACount + 1;
      Raise();
      Say("not reached level2");
    finally
      LSum := 0;
      for LI := 0 to 2 do
        LSum := LSum + LI;
      end;
      if LSum = 3 then
        Say("level2 inner finally loop 3");
      end;
      ACount := ACount + 10;
    end;
  finally
    if ACount = 11 then
      Say("level2 outer finally 11");
    end;
  end;
end;

// A realigned frame, unwound: its aligned local's field and the caller's int32 read back
routine Level1(var ACount: int32);
var
  LWide: TWide;
begin
  LWide.A := 7;
  guard
    Level2(ACount);
    Say("not reached level1");
  finally
    if LWide.A = 7 then
      Say("level1 wide 7");
    end;
    if ACount = 11 then
      Say("level1 count 11");
    end;
  end;
end;

begin
  GCount := 0;
  Count(GCount);
  Nested();
  GCount := 0;
  SetUnhandledExceptionFilter(Filter);
  Level1(GCount);
  Say("not reached main");
end.
