-------------------------------------------------------------------------------
  dll_fault_unload.adam - the process's one fault action as Adam dlls come
  and go (PLAN-LINUX64): two Adam dlls loaded at run time join the fault
  chain the exe made (System.Runtime.FaultChain); each catches its own
  fault, the first is unloaded and the second still catches its own (its
  runtime's, not the exe's), the second is unloaded and the exe's own
  guard still takes a fault, then a fault no guard takes is reported by
  the exe's runtime as before any dll came (nothing reaches an unmapped
  dll's code)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  deps exe.dll_fault_unload_a exe.dll_fault_unload_b
  exitcode 1
  | loaded a true
  | loaded b true
  | a 3 Access violation
  | b 3 Access violation
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | unloaded a true
  | b 3 Access violation
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | unloaded b true
  | exe 3 Access violation
  | unhandled exception 3: Access violation
@@end
*/

module exe dll_fault_unload;

type
  // The dlls' routine: a fault caught in the dll, its code
  FaultFn = func(): int32;

@ifdef TARGET_X86_64_LINUX_GNU
// glibc: a library opened, an export found, a library closed
func dlopen(const AFile: ptr to const char; const AMode: int32): ptr; external "c";
func dlsym(const AHandle: ptr; const AName: ptr to const char): ptr; external "c";
func dlclose(const AHandle: ptr): int32; external "c";

const
  // dlfcn.h: every symbol bound at the load, the library's symbols its own
  RTLD_NOW: int32 = 2;
  RTLD_LOCAL: int32 = 0;
@else
// kernel32: a library loaded, an export found, a library let go
func LoadLibraryA(const AFileName: ptr to const char): ptr; external "kernel32";
func GetProcAddress(const AModule: ptr; const AName: ptr to const char): ptr;
  external "kernel32";
func FreeLibrary(const AModule: ptr): int32; external "kernel32";
@endif

var
  GNil: ptr to int64;

// The dll AStem (no prefix or ending) loaded at run time; nil when it is not
func Load(const AStem: string): ptr;
begin
@ifdef TARGET_X86_64_LINUX_GNU
  return dlopen("lib" + AStem + ".so", RTLD_NOW | RTLD_LOCAL);
@else
  return LoadLibraryA(AStem + ".dll");
@endif
end;

// The export AName of the loaded dll ALibrary
func Find(const ALibrary: ptr; const AName: string): FaultFn;
begin
@ifdef TARGET_X86_64_LINUX_GNU
  return FaultFn(dlsym(ALibrary, AName));
@else
  return FaultFn(GetProcAddress(ALibrary, AName));
@endif
end;

// The loaded dll ALibrary unloaded; true when it went
func Unload(const ALibrary: ptr): bool;
begin
@ifdef TARGET_X86_64_LINUX_GNU
  return dlclose(ALibrary) = 0;
@else
  return FreeLibrary(ALibrary) <> 0;
@endif
end;

var
  LA: ptr;
  LB: ptr;
  LFaultA: FaultFn;
  LFaultB: FaultFn;

begin
  LA := Load("dll_fault_unload_a");
  println("loaded a {}", LA <> nil);
  LB := Load("dll_fault_unload_b");
  println("loaded b {}", LB <> nil);
  if (LA = nil) or (LB = nil) then
    return 2;
  end;
  LFaultA := Find(LA, "FaultInA");
  LFaultB := Find(LB, "FaultInB");
  LFaultA();
  LFaultB();
  FlushOutput();
  println("unloaded a {}", Unload(LA));
  // a's runtime gone: b's fault is still b's own
  LFaultB();
  FlushOutput();
  println("unloaded b {}", Unload(LB));
  // both gone: the exe's guard and its last filter / fault action as before they came
  guard
    GNil[0] := 1;
  except
    println("exe {} {}", exccode(), excmsg());
  end;
  FlushOutput();
  GNil[0] := 2;
  println("never");
end.
