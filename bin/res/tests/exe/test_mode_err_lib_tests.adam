module lib test_mode_err_lib_tests;

/*
  @@test
    kind check
  @@end
*/

public routine Half(AN: int32): int32;
begin
  return AN div 2;
end;

end.

test "never runs" // WARN SM0113@1
begin
  testAssertEqualInt(2, Half(4));
end;
