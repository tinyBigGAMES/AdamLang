-------------------------------------------------------------------------------
  exe_runtime_scope.adam - The runtime's public names are in scope with no
  import (BNF sec 1, 2026-11-10): HeapLive and Halt bare in a module that
  imports nothing, and an own declaration (FlushOutput) wins over the
  runtime's of the same spelling.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 4
  | live true
  | own flush
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exe_runtime_scope;

// The module's own FlushOutput: a bare call means this one, not System.Runtime's
func FlushOutput();
begin
  println("own flush");
end;

begin
  println("live {}", HeapLive() >= 0);
  FlushOutput();
  Halt(4);
end.
