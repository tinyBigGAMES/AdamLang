-------------------------------------------------------------------------------
  exc_raise_init.adam - Exceptions: a raise from a local's initializer
  (PLAN-SELFHOST S3). The local before it holds a ref (its done prints as the
  unwind releases it); the managed locals after it (a string, a ref) never
  got their initializers, so the frame's cleanup finds them empty and
  releases nothing of theirs (every managed slot is made empty before any
  initializer runs). A result routine whose body ends in its raise
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 1
  | init first
  | done first
  | unhandled exception 1: init second
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_raise_init;

type
  // An object whose done prints: its end shows where an unwind released it
  TNote = object
    Text: string;

    init(const AText: string);
    begin
      self.Text := AText;
      println("init {}", AText);
    end;

    done;
    begin
      println("done {}", self.Text);
    end;
  end;

// A text it never gives back: its raise ends it
func Named(const AWhat: string): string;
begin
  raise("init " + AWhat);
end;

// The second local's initializer raises: the first is released, the later ones are empty
func Build();
var
  LFirst: ref TNote = ref TNote("first");
  LSecond: string = Named("second");
  LThird: string = "third";
  LFourth: ref TNote = ref TNote("fourth");
begin
  println("not reached build {} {}", LSecond, LThird);
  LFourth.Text := LFirst.Text;
end;

begin
  Build();
  println("not reached main");
end.
