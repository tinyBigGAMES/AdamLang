-------------------------------------------------------------------------------
  exc_fault_unguarded.adam - Exceptions: a hardware fault outside every guard
  (BNF sec 1, PaskalCPP's report_unguarded_fault) is reported on stderr,
  `unhandled exception 3: Access violation`, and the process ends at once with
  exit code 1: nothing is unwound and no teardown runs (no finalize line, no
  heap report). What was flushed before the fault is kept.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 1
  | before
  | unhandled exception 3: Access violation
@@end
*/

module exe exc_fault_unguarded;

var
  GNil: ptr to int64;

finalize
begin
  println("never finalize");
end;

begin
  println("before");
  FlushOutput();
  GNil := nil;
  GNil[0] := 1;
  println("never");
end.
