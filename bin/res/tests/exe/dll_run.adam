-------------------------------------------------------------------------------
  dll_run.adam - adam build -r on a dll module (PLAN-ADAM M8a): the dll is
  written, nothing runs (a dll runs only inside a program that loads it):
  CL0022, a warning, and the build's exit code 0
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/dll_run.adam" "-o" "." "-r"
  exitcode 0
  | Warning CL0022: '<OUT>/bin/<CELL>/dll_run.dll' was built but not run: a dll runs only inside a program that loads it
@@end
*/

module dll dll_run;

public routine DllRunValue(): int32;
begin
  return 3;
end;

end.
