  dll_fault_unload_a.adam - a dll of dll_fault_unload (PLAN-LINUX64): built
  only; its one routine faults inside its own guard and catches it there,
  in the dll, while the dll b is loaded or gone
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_fault_unload_a;

var
  GNil: ptr to int64;

// A nil write caught by this dll's guard: its code and text printed; the code
public func FaultInA(): int32;
var
  LCode: int32;
begin
  LCode := 0;
  guard
    GNil[0] := 5;
  except
    LCode := exccode();
    println("a {} {}", LCode, excmsg());
  end;
  return LCode;
end;

end.
