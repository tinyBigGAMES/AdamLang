-------------------------------------------------------------------------------
  lib_two.adam - an exe linking two libs Adam built (PLAN-ADAM M8d): each
  lib's module object brings its start list entry, so both start before the
  exe, in link order, and end after it in the reverse order; both run on the
  exe's one runtime: each lib's string is on the exe's heap, and one heap
  report counts every lib's blocks with the exe's
*******************************************************************************/

/*
@@test
  kind run
  deps exe.lib_two_a exe.lib_two_b
  exitcode 0
  | two lib a init
  | two lib b init
  | lib a!
  | a 5
  | lib b!
  | b 5
  | two lib b final
  | two lib a final
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lib_two;

@addlibrarypath "$P:output/lib/x86_64-windows-gnu/debug";
@linklibrary "lib_two_a";
@linklibrary "lib_two_b";

routine TwoNameA(): int32; external "lib_two_a";
routine TwoNameB(): int32; external "lib_two_b";

begin
  println("a {}", TwoNameA());
  println("b {}", TwoNameB());
end.
