-------------------------------------------------------------------------------
  dir_message_unit.adam - @message in an imported unit (AUD3 / AUDIT 2.7):
  the unit fixtures\MessageUnit reports a hint from its prologue and a
  warning from a routine body, at its own file and lines, in every build
  (adamtest deletes the fixture's .acu first, so it is compiled from source
  each run and its markers are required); the program runs as written.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | MessageUnit.Seven() = 7
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe dir_message_unit;

@addmodulepath "$P:res/tests/exe/fixtures";
import MessageUnit;

begin
  println("MessageUnit.Seven() = {}", MessageUnit.Seven());
end.
