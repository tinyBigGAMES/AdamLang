-------------------------------------------------------------------------------
  dir_directive_table.adam - build and conditional directives read through
  the Lexer's directive table (Directive, BNF sec 2): @subsystem and
  @addverinfo take one of their row's two value words, the eight @vi* (a
  number or a text each, version info on) are each given once, and the
  seven conditional directives pick the branches (@define, @undef, @ifdef,
  @ifndef, @elseif, @else, @endif).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | defined
  | not undefined
  | elseif taken
  | else taken
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dir_directive_table;

@subsystem console;
@addverinfo on;
@vimajor 1;
@viminor 2;
@vipatch 3;
@viproductname "Directive table";
@videscription "The directive table row";
@vifilename "dir_directive_table.exe";
@vicompanyname "tinyBigGAMES LLC";
@vicopyright "Copyright 2026";

@define ROW_ONE
@define ROW_TWO
@undef ROW_TWO

begin
@ifdef ROW_ONE
  println("defined");
@endif
@ifndef ROW_TWO
  println("not undefined");
@endif
@ifdef ROW_TWO
  println("wrong branch");
@elseif ROW_ONE
  println("elseif taken");
@endif
@ifdef ROW_TWO
  println("wrong branch");
@else
  println("else taken");
@endif
end.
