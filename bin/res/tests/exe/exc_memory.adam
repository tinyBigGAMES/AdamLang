-------------------------------------------------------------------------------
  exc_memory.adam - the memory check (M3.11c; PaskalCPP's EXC_MEMORY, code
  12, its get_mem / resize_mem / set_length texts). getmem of a negative size
  and of a size no heap gives raise 12, getmem(0) is nil; resizemem of a
  negative or too large size raises 12 with the block kept as it was;
  setlength of a string, a wstring and a dynamic array to a negative length,
  to a length the heap refuses (a literal's block, the variable's own block)
  and to a length past int64's bytes raises 12 with the variable as it was;
  every raise caught; nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 12 negative memory size -1
  | 12 out of memory (4611686018427387904 bytes)
  | getmem 0 nil
  | 12 negative memory size -5
  | 12 out of memory (4611686018427387904 bytes)
  | kept 42
  | 12 negative length -3
  | 12 out of memory (length 4611686018427387904)
  | abc 3
  | 12 out of memory (length 4611686018427387904)
  | abcd 4
  | 12 out of memory (length 9223372036854775807)
  | abcd 4
  | 12 negative length -2
  | 12 out of memory (length 4611686018427387904)
  | wide 0
  | 12 negative length -1
  | 12 out of memory (length 4611686018427387904)
  | 3 30
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe exc_memory;

// getmem: a negative size, a size no heap gives (2^62 bytes), 0
routine GetMems(const AHuge: int64);
var
  LP: ptr;
begin
  guard
    LP := getmem(-1);
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LP := getmem(AHuge);
  except
    println("{} {}", exccode(), excmsg());
  end;
  LP := getmem(0);
  if LP = nil then
    println("getmem 0 nil");
  end;
end;

// resizemem: a negative size and a size no heap gives, the block still the caller's
routine ResizeMems(const AHuge: int64);
var
  LP: ptr;
  LQ: ptr;
  LInts: ptr to int64;
begin
  LP := getmem(16);
  LInts := ptr to int64(LP);
  LInts[0] := 42;
  guard
    LQ := resizemem(LP, -5);
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LQ := resizemem(LP, AHuge);
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("kept {}", LInts[0]);
  freemem(LP);
end;

// setlength of a string: negative, too large on a literal's block, too large on its own
// block, past int64's bytes; the string as it was after each
routine Strings(const AHuge: int64);
var
  LS: string;
begin
  LS := "abc";
  guard
    setlength(LS, -3);
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    setlength(LS, AHuge);
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("{} {}", LS, len(LS));
  LS := LS + "d";
  guard
    setlength(LS, AHuge);
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("{} {}", LS, len(LS));
  guard
    setlength(LS, 9223372036854775807);
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("{} {}", LS, len(LS));
end;

// setlength of a wstring: negative, too large
routine Wides(const AHuge: int64);
var
  LW: wstring;
begin
  guard
    setlength(LW, -2);
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    setlength(LW, AHuge);
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("wide {}", len(LW));
end;

// setlength of a dynamic array: negative, too large; its elements kept
routine Arrays(const AHuge: int64);
var
  LA: array of int64;
begin
  setlength(LA, 3);
  LA[0] := 10;
  LA[1] := 20;
  LA[2] := 30;
  guard
    setlength(LA, -1);
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    setlength(LA, AHuge);
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("{} {}", len(LA), LA[2]);
end;

var
  GHuge: int64;

begin
  GHuge := 4611686018427387904;
  GetMems(GHuge);
  ResizeMems(GHuge);
  Strings(GHuge);
  Wides(GHuge);
  Arrays(GHuge);
  println("end");
end.
