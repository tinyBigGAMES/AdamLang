-------------------------------------------------------------------------------
  dir_err_exeicon_cut.adam - Break step of dir_verinfo: an @exeicon file
  whose one image lies past the file's end (fixtures\dir_err_exeicon\
  cut.ico, the 1x1 icon cut 8 bytes short, scripts\adam\
  make_dir_fixtures.py) is LK0007 at its path, exit 1, no exe
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/dir_err_exeicon_cut.adam" "-o" "."
  exitcode 1
  | <DIR>/dir_err_exeicon_cut.adam(33,10): Error LK0007: @exeicon: the icon file '<DIR>/fixtures/dir_err_exeicon/cut.ico' is cut short: an image lies past its end
@@end
*/

module exe dir_err_exeicon_cut;

@exeicon "$P:res/tests/exe/fixtures/dir_err_exeicon/cut.ico";

begin
end.
