-------------------------------------------------------------------------------
  dir_verinfo.adam - Directive: @addverinfo on with every @vi* and an
  @exeicon, read back as the OS reads them (AUD4 5.8 gap): the image is the
  console subsystem and has a resource directory; version.dll finds the
  version resource, its VS_FIXEDFILEINFO (file and product version
  1.2.3.0), the StringTable 040904B0's eight texts (InternalName the file
  name without its extension, FileVersion / ProductVersion the version)
  and the Translation 0x0409 / 1200; the shell counts one icon
  (fixtures\dir_exeicon_noext\app.ico, scripts\adam\make_dir_fixtures.py)
*******************************************************************************/

/*
@@test
  kind run
  | ok read image
  | ok subsystem console
  | ok resource directory
  | ok path
  | ok version size
  | ok version read
  | ok fixed signature
  | ok file version 1.2.3.0
  | ok product version 1.2.3.0
  | CompanyName = tinyBigGAMES LLC
  | FileDescription = Version info row
  | FileVersion = 1.2.3.0
  | InternalName = dir_verinfo
  | LegalCopyright = Copyright (c) 2026 tinyBigGAMES LLC
  | OriginalFilename = dir_verinfo.exe
  | ProductName = Adam Rows
  | ProductVersion = 1.2.3.0
  | ok translation 0409 04B0
  | ok icons 1
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dir_verinfo;

@addverinfo on;
@vimajor 1;
@viminor 2;
@vipatch 3;
@viproductname "Adam Rows";
@videscription "Version info row";
@vifilename "dir_verinfo.exe";
@vicompanyname "tinyBigGAMES LLC";
@vicopyright "Copyright (c) 2026 tinyBigGAMES LLC";
@exeicon "$P:res/tests/exe/fixtures/dir_exeicon_noext/app.ico";

import System.SysUtils, System.IO, System.Windows;

// version.dll's reader and shell32's icon count: the OS reads the image's resources
routine clink GetFileVersionInfoSizeW(var AFileName: WideBuffer; AHandle: ptr): uint32;
  external "version";
routine clink GetFileVersionInfoW(var AFileName: WideBuffer; AHandle: uint32; ALength: uint32;
  AData: ptr): int32; external "version";
routine clink VerQueryValueW(AData: ptr; var ASubBlock: WideBuffer; var AValue: ptr;
  var ALength: uint32): int32; external "version";
routine clink ExtractIconExW(var AFile: WideBuffer; AIndex: int32; ALarge: ptr; ASmall: ptr;
  AIcons: uint32): uint32; external "shell32";

const
  // IMAGE_SUBSYSTEM_WINDOWS_CUI; where the PE header's offset is, the subsystem and the
  // resource directory past the signature; VS_FIXEDFILEINFO's signature
  ADAM_ROW_SUBSYSTEM_CUI: uint64 = 3;
  ADAM_ROW_PE_AT: int64 = 0x3C;
  ADAM_ROW_SUBSYSTEM_AT: int64 = 92;
  ADAM_ROW_RESOURCE_AT: int64 = 152;
  ADAM_ROW_FIXED_SIGNATURE: uint64 = 0xFEEF04BD;

var
  GFails: int32;
  // The exe's path and a query's sub-block as Win32 reads them, a value's text
  GPath: WideBuffer;
  GSub: WideBuffer;
  GText: WideBuffer;
  // The version resource as GetFileVersionInfoW copies it
  GData: ByteArray;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// Where AValue (a pointer VerQueryValueW gave) is in GData
routine OffsetOf(const AValue: ptr): int64;
begin
  return int64(uint64(AValue) - uint64(addr of GData[0]));
end;

// The value of ASubBlock in GData and its length (VerQueryValueW's: units for a text, bytes
// for binary data); -1 when it is not there
routine Query(const ASubBlock: string; var ALength: uint32): int64;
var
  LValue: ptr;
begin
  LValue := nil;
  ALength := 0;
  if not Utf8ToWide(ASubBlock, GSub) then
    return -1;
  end;
  if VerQueryValueW(addr of GData[0], GSub, LValue, ALength) = 0 then
    return -1;
  end;
  return OffsetOf(LValue);
end;

// The text the StringTable 040904B0 holds for AKey, "" when it holds none
routine StringOf(const AKey: string): string;
var
  LAt: int64;
  LLength: uint32;
  LI: int64;
begin
  LAt := Query("\\StringFileInfo\\040904B0\\" + AKey, LLength);
  if (LAt < 0) or (LLength = 0) then
    return "";
  end;
  for LI := 0 to int64(LLength) - 1 do
    GText[LI] := uint16(GetLe(GData, LAt + 2 * LI, 2));
  end;
  // LLength counts the NUL
  return WideToUtf8(GText, int32(LLength) - 1);
end;

// "major.minor.patch.build" of a VS_FIXEDFILEINFO version pair at AAt
routine VersionAt(const AAt: int64): string;
var
  LHigh: int64;
  LLow: int64;
begin
  LHigh := int64(GetLe(GData, AAt, 4));
  LLow := int64(GetLe(GData, AAt + 4, 4));
  return IntToStr(LHigh shr 16) + "." + IntToStr(LHigh & 0xFFFF) + "." + IntToStr(LLow shr 16) +
    "." + IntToStr(LLow & 0xFFFF);
end;

// The rows (see the header)
routine Run();
var
  LImage: ByteArray;
  LPe: int64;
  LSize: uint32;
  LFixed: int64;
  LLength: uint32;
  LAt: int64;
  LKeys: StringArray;
  LI: int64;
  LIcons: uint32;
begin
  // The image itself: the console subsystem, a resource directory
  Check("read image", ReadAllBytes(ProgramFilePath(), LImage));
  LPe := int64(GetLe(LImage, ADAM_ROW_PE_AT, 4));
  Check("subsystem console",
    GetLe(LImage, LPe + ADAM_ROW_SUBSYSTEM_AT, 2) = ADAM_ROW_SUBSYSTEM_CUI);
  Check("resource directory", GetLe(LImage, LPe + ADAM_ROW_RESOURCE_AT, 4) <> 0);
  // The version resource as the OS reads it
  Check("path", Utf8ToWide(ProgramFilePath(), GPath));
  LSize := GetFileVersionInfoSizeW(GPath, nil);
  Check("version size", LSize > 0);
  if LSize = 0 then
    return;
  end;
  setlength(GData, int64(LSize));
  Check("version read", GetFileVersionInfoW(GPath, 0, LSize, addr of GData[0]) <> 0);
  LFixed := Query("\\", LLength);
  Check("fixed signature", (LFixed >= 0) and (GetLe(GData, LFixed, 4) = ADAM_ROW_FIXED_SIGNATURE));
  if LFixed < 0 then
    return;
  end;
  Check("file version " + VersionAt(LFixed + 8), VersionAt(LFixed + 8) = "1.2.3.0");
  Check("product version " + VersionAt(LFixed + 16), VersionAt(LFixed + 16) = "1.2.3.0");
  LKeys := SplitString("CompanyName FileDescription FileVersion InternalName LegalCopyright " +
    "OriginalFilename ProductName ProductVersion", " ");
  for LI := 0 to len(LKeys) - 1 do
    println("{} = {}", LKeys[LI], StringOf(LKeys[LI]));
  end;
  LAt := Query("\\VarFileInfo\\Translation", LLength);
  if (LAt < 0) or (LLength <> 4) then
    Check("translation", false);
  else
    Check("translation " + IntToHex(GetLe(GData, LAt, 2), 4) + " " +
      IntToHex(GetLe(GData, LAt + 2, 2), 4),
      (GetLe(GData, LAt, 2) = 0x0409) and (GetLe(GData, LAt + 2, 2) = 1200));
  end;
  // The shell's count of the exe's icons (an index of -1 asks for it)
  LIcons := ExtractIconExW(GPath, -1, nil, nil, 0);
  Check("icons " + UIntToStr(uint64(LIcons)), LIcons = 1);
end;

begin
  GFails := 0;
  Run();
  if GFails > 0 then
    println("fails {}", GFails);
  end;
end.
