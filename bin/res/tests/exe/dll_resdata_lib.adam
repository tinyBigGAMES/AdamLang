-------------------------------------------------------------------------------
  dll_resdata_lib.adam - the dll of dll_resdata (PLAN-ADAM M8c): built only;
  its @addresdata key "note" is built into the dll's own image and read back
  inside the dll (System.ResData over its own runtime's table), never the
  exe's keys
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dll_resdata_lib;

@addresdata "note" "$P:res/tests/std/fixtures/std_resdata_text.txt";

import System.ResData;

// How many keys the dll's own table holds
public routine ResCount(): int64;
begin
  return ResDataCount();
end;

// The byte count of the dll's key "note"
public routine ResNoteSize(): int64;
begin
  return FindResData("note").Size;
end;

// The first byte of the dll's key "note"
public routine ResNoteFirst(): int32;
var
  LEntry: ResDataEntry;
begin
  LEntry := FindResData("note");
  return int32(LEntry.Data[0]);
end;

// Whether the dll's table holds the exe's key "own"
public routine ResHasOwn(): bool;
var
  LKey: string;
begin
  // a key in a variable: a literal the dll does not add would be SM0122
  LKey := "own";
  return HasResData(LKey);
end;

end.
