-------------------------------------------------------------------------------
  dll_err_private.adam - Break step of dll_exports (PLAN-ADAM M8a): a dll's
  private routine is not exported, so an exe asking for it is LK0003 at its
  declaration, naming the dll as adam found it
*******************************************************************************/

/*
@@test
  kind cli
  deps exe.dll_exports_lib
  args "build" "--quiet" "<DIR>/dll_err_private.adam" "-o" "."
  exitcode 1
  | <DIR>/dll_err_private.adam(35,1): Error LK0003: routine 'DLLHidden' is not exported by '<BIN>/output/bin/x86_64-windows-gnu/debug/dll_exports_lib.dll'
@@end
*/

module exe dll_err_private;

@addlibrarypath "$P:output/bin/x86_64-windows-gnu/debug";

func DLLHidden(): int32; external "dll_exports_lib";

begin
  println("{}", DLLHidden());
end.
