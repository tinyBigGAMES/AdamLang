-------------------------------------------------------------------------------
  dyn_calls.adam - Dynamic arrays across routines and modules (M3.9b): a
  dynamic array result (assigned, indexed straight off the call, passed on,
  remade in a loop, so its hidden slot releases the previous pass's); a
  const parameter (clink: the callee's own holder; cpplink: by reference, a
  call's temporary too); a value parameter written by the callee (its own
  copy: the caller's array unchanged); a var parameter grown and written (the
  caller's variable changed); `? :` of two arrays; a record holding a
  dynamic array returned and passed by value (the callee's write stays its
  own); module variables, one initialized by a call and grown later, one
  holding strings, released after the finalize chain. The [Heap] line
  counts every block, all freed. Values are shown through ucrtbase
  (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 10
  | 10020
  | 509
  | 52
  | 9
  | 1
  | 2
  | 34
  | 1018
  | 1
  | 303
  | 4004
  | n nm
  | [Heap] Allocs: 12, Frees: 12, Leaked: 0
@@end
*/

module exe dyn_calls;

routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  TBag = record
    Name: string;
    Values: array of int64;
  end;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
var
  LBuf: array[0..31] of char;
begin
  puts(_i64toa(AValue, addr of LBuf[0], 10));
end;

// ACount elements counting up from AFirst
routine Make(const ACount: int32; const AFirst: int64): array of int64;
var
  LA: array of int64;
  LI: int32;
begin
  setlength(LA, ACount);
  for LI := 0 to ACount - 1 do
    LA[LI] := AFirst + LI;
  end;
  return LA;
end;

// The sum of AList's elements (a clink const parameter: the callee's own holder)
routine Total(const AList: array of int64): int64;
var
  LI: int64;
  LSum: int64;
begin
  LSum := 0;
  for LI := 0 to len(AList) - 1 do
    LSum := LSum + AList[LI];
  end;
  return LSum;
end;

// AList with every element doubled (a value parameter written: its own copy)
routine Doubled(AList: array of int64): array of int64;
var
  LI: int64;
begin
  for LI := 0 to len(AList) - 1 do
    AList[LI] := AList[LI] * 2;
  end;
  return AList;
end;

// AValue added at AList's end (a var parameter: the caller's variable grows)
routine Grow(var AList: array of int64; const AValue: int64);
begin
  setlength(AList, len(AList) + 1);
  AList[len(AList) - 1] := AValue;
end;

// AList's length (a cpplink const parameter: by reference)
routine cpplink Count(const AList: array of int64): int64;
begin
  return len(AList);
end;

// ALeft when AFirst, else ARight
routine Pick(const AFirst: bool; const ALeft: array of int64; const ARight: array of int64): array of int64;
begin
  return AFirst ? ALeft : ARight;
end;

// A bag named AName holding AList
routine Bagged(const AName: string; const AList: array of int64): TBag;
var
  LB: TBag;
begin
  LB.Name := AName;
  LB.Values := AList;
  return LB;
end;

// ABag's sum with its first value replaced (a record by value: the callee's own copy)
routine BagSum(ABag: TBag): int64;
begin
  ABag.Values[0] := 1000;
  return Total(ABag.Values);
end;

// Two strings, one of them a block of its own
routine Names(): array of string;
var
  LS: array of string;
begin
  setlength(LS, 2);
  LS[0] := "n";
  LS[1] := LS[0] + "m";
  return LS;
end;

var
  GList: array of int64 = Make(3, 100);
  GNames: array of string;

routine Run();
var
  LA: array of int64;
  LB: array of int64;
  LC: array of int64;
  LBag: TBag;
  LI: int32;
begin
  LA := Make(4, 1);
  ShowInt(Total(LA));
  LB := Doubled(LA);
  ShowInt(Total(LA) * 1000 + Total(LB));
  Grow(LA, 9);
  ShowInt(len(LA) * 100 + LA[4]);
  ShowInt(Count(LA) * 10 + Count(Make(2, 0)));
  ShowInt(Make(3, 7)[2]);
  LC := Pick(true, LA, LB);
  ShowInt(LC[0]);
  LC := Pick(false, LA, LB);
  ShowInt(LC[0]);
  for LI := 0 to 2 do
    LC := Make(LI + 1, LI);
  end;
  ShowInt(len(LC) * 10 + LC[2]);
  LBag := Bagged("bag", LA);
  ShowInt(BagSum(LBag));
  ShowInt(LBag.Values[0]);
  ShowInt(Total(GList));
  Grow(GList, 4);
  ShowInt(len(GList) * 1000 + GList[3]);
  GNames := Names();
  println("{} {}", GNames[0], GNames[1]);
end;

begin
  Run();
end.
