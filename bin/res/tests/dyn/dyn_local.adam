  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  dyn_local.adam - Dynamic arrays in a routine (M3.9a, DESIGN sec 8): locals
  empty to start (len 0); setlength growing (added elements zeroed),
  shrinking (the first kept), to the same length (nothing changes), to 0 and
  to a negative length (raises 12, the array kept: M3.11c); elements of 1, 4 and 8
  bytes written and read (uint8 read unsigned, a uint32 past int32's range);
  a copy that shares its block until either side writes an element (copy on
  write); elements that are strings (a copy's element changed, a char
  written into a copy's string element: both copies made their own), records
  holding a string, dynamic arrays (an element's element written, setlength
  on an element); a record holding a dynamic array copied by `:=`, a static
  array of dynamic arrays, `addr of` an element of a shared array (the
  write form copies first). Cleanup on every exit path (a return from inside
  a loop, the end after leave and skip, a later return): the [Heap]
  line counts every block, all freed. Values are shown through ucrtbase
  (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0
  | 3060
  | 20
  | 21
  | 3000
  | 220
  | 0
  | 10
  | 0
  | 12
  | 3
  | 503
  | 4000000000
  | 3
  | [alpha] [alpha-x] []
  | [gamma] [aXpha-x]
  | 13
  | 7
  | one+ one+
  | 59
  | 36
  | 13
  | 78
  | 4
  | 3
  | r10
  | r20
  | r30
  | [Heap] Allocs: 41, Frees: 41, Leaked: 0
@@end
*/

module exe dyn_local;

func puts(const AText: ptr): int32; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  TItem = record
    Name: string;
    Count: int32;
  end;

  THolder = record
    Title: string;
    Items: array of int32;
  end;

  TPairOfLists = array[0..1] of array of int64;

// AValue in decimal, one line
func ShowInt(const AValue: int64);
var
  LBuf: array[0..31] of char;
begin
  puts(_i64toa(AValue, addr of LBuf[0], 10));
end;

// Elements of 8, 1 and 4 bytes; setlength's forms; a copy written on one side
func Scalars();
var
  LA: array of int64;
  LB: array of int64;
  LBytes: array of uint8;
  LWords: array of uint32;
  LI: int32;
begin
  ShowInt(len(LA));
  setlength(LA, 3);
  LA[0] := 10;
  LA[1] := 20;
  LA[2] := 30;
  ShowInt(len(LA) * 1000 + LA[0] + LA[1] + LA[2]);

  // LB shares LA's block until it writes an element: then it has its own
  LB := LA;
  LB[1] := 21;
  ShowInt(LA[1]);
  ShowInt(LB[1]);

  // Grown: the added elements zeroed; shrunk: the first kept; grown again: zeroed
  setlength(LA, 5);
  ShowInt(LA[2] * 100 + LA[3] + LA[4]);
  setlength(LA, 2);
  ShowInt(len(LA) * 100 + LA[1]);
  setlength(LA, 4);
  ShowInt(LA[2] + LA[3]);
  setlength(LA, 4);
  ShowInt(LA[0]);

  // 0 empties it; a negative length raises 12 and keeps it (M3.11c)
  setlength(LA, 0);
  ShowInt(len(LA));
  setlength(LA, 3);
  guard
    setlength(LA, -1);
  except
    ShowInt(exccode());
  end;
  ShowInt(len(LA));

  setlength(LBytes, 4);
  for LI := 0 to 3 do
    LBytes[LI] := uint8(250 + LI);
  end;
  ShowInt(LBytes[0] + LBytes[3]);
  setlength(LWords, 2);
  LWords[1] := 4000000000;
  ShowInt(int64(LWords[1]));
  ShowInt(len(LB));
end;

// Strings as elements: a copy's element replaced, a char written into a copy's string
func Strings();
var
  LS: array of string;
  LT: array of string;
begin
  setlength(LS, 3);
  LS[0] := "alpha";
  LS[1] := LS[0] + "-x";
  LT := LS;
  LT[0] := "gamma";
  LT[1][1] := 'X';
  println("[{}] [{}] [{}]", LS[0], LS[1], LS[2]);
  println("[{}] [{}]", LT[0], LT[1]);
  setlength(LS, 1);
  ShowInt(len(LS) * 10 + len(LT));
end;

// Records holding a string as elements: a copy's field written
func Records();
var
  LR: array of TItem;
  LQ: array of TItem;
begin
  setlength(LR, 2);
  LR[0].Name := "one";
  LR[0].Count := 1;
  LR[1].Name := LR[0].Name + "+";
  LQ := LR;
  LQ[1].Count := 7;
  ShowInt(LR[1].Count * 10 + LQ[1].Count);
  println("{} {}", LQ[1].Name, LR[1].Name);
end;

// Dynamic arrays as elements: an element's element written in a copy, setlength on a
// copy's element
func Nested();
var
  LN: array of array of int32;
  LM: array of array of int32;
begin
  setlength(LN, 2);
  setlength(LN[0], 3);
  setlength(LN[1], 1);
  LN[0][1] := 5;
  LN[1][0] := 6;
  LM := LN;
  LM[0][1] := 9;
  ShowInt(LN[0][1] * 10 + LM[0][1]);
  ShowInt(len(LM[0]) * 10 + LM[1][0]);
  setlength(LM[1], 3);
  ShowInt(len(LN[1]) * 10 + len(LM[1]));
end;

// A record holding a dynamic array, a static array of them, `addr of` a shared element
func Holders();
var
  LH: THolder;
  LG: THolder;
  LP: TPairOfLists;
  LPtr: ptr to int32;
begin
  LH.Title := "h";
  setlength(LH.Items, 2);
  LH.Items[1] := 7;
  LG := LH;
  LG.Items[1] := 8;
  ShowInt(LH.Items[1] * 10 + LG.Items[1]);
  setlength(LP[1], 2);
  LP[1][0] := 4;
  ShowInt(len(LP[0]) * 10 + LP[1][0]);
  LG := LH;
  LPtr := addr of LG.Items[0];
  LPtr^ := 3;
  ShowInt(LH.Items[0] * 10 + LG.Items[0]);
end;

// An array of strings grown in a loop; AMode 0 returns from inside the loop, 1 and 2
// leave it at its third pass and return later by two different returns
func Paths(const AMode: int32): int32;
var
  LA: array of string;
  LI: int32;
begin
  setlength(LA, 2);
  for LI := 0 to 9 do
    LA[1] := LA[1] + 'x';
    if LI = 1 then
      if AMode = 0 then
        return 10;
      end;
      skip;
    end;
    if LI = 2 then
      leave;
    end;
  end;
  if AMode = 1 then
    return 20;
  end;
  return 30;
end;

func Run();
begin
  Scalars();
  Strings();
  Records();
  Nested();
  Holders();
  if Paths(0) = 10 then
    println("r10");
  end;
  if Paths(1) = 20 then
    println("r20");
  end;
  if Paths(2) = 30 then
    println("r30");
  end;
end;

begin
  Run();
end.
