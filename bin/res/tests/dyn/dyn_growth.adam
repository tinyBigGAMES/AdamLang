-------------------------------------------------------------------------------
  dyn_growth.adam - setlength's geometric growth (SU2.8): a loop growing by
  one (`setlength(X, len(X) + 1)`) on an array of int64, a string, a wstring
  and an array of strings keeps every value; the block keeps room past the
  length, so a shrink inside it then a growth gives zeroed elements / 0 units
  (no stale value comes back), a shrink under half resizes down with the
  first kept; a shared block grown is copied (the other holder keeps its
  length). The [Heap] line: one block per value, a resize is no allocation.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 100000 4999950000
  | 100000 0 99989
  | 20 9 0
  | 100000 65 90 68
  | 100000 0
  | 100000 100001 0
  | w 1000 ok ok
  | n 1000 s
  | [Heap] Allocs: 5, Frees: 5, Leaked: 0
@@end
*/

module exe dyn_growth;

// An array of int64 grown by one 100000 times; shrunk inside its block, then grown: the
// added elements 0; shrunk under half: the first kept, the added elements 0
func Ints();
var
  LA: array of int64;
  LI: int64;
  LSum: int64;
begin
  for LI := 0 to 99999 do
    setlength(LA, len(LA) + 1);
    LA[LI] := LI;
  end;
  LSum := 0;
  for LI := 0 to len(LA) - 1 do
    LSum := LSum + LA[LI];
  end;
  println("{} {}", len(LA), LSum);

  setlength(LA, 99990);
  setlength(LA, 100000);
  LSum := 0;
  for LI := 99990 to 99999 do
    LSum := LSum + LA[LI];
  end;
  println("{} {} {}", len(LA), LSum, LA[99989]);

  setlength(LA, 10);
  setlength(LA, 20);
  LSum := 0;
  for LI := 10 to 19 do
    LSum := LSum + LA[LI];
  end;
  println("{} {} {}", len(LA), LA[9], LSum);
end;

// A string grown by one char 100000 times; shrunk inside its block, then grown: the
// added chars 0; a copy grown gets its own block, the original keeps its length
func Texts();
var
  LS: string;
  LT: string;
  LI: int64;
begin
  for LI := 0 to 99999 do
    setlength(LS, len(LS) + 1);
    LS[LI] := char(uint8(65 + LI mod 26));
  end;
  println("{} {} {} {}", len(LS), int64(uint8(LS[0])), int64(uint8(LS[25])),
    int64(uint8(LS[99999])));

  setlength(LS, 99990);
  setlength(LS, 100000);
  println("{} {}", len(LS), int64(uint8(LS[99995])));

  LT := LS;
  setlength(LT, len(LT) + 1);
  println("{} {} {}", len(LS), len(LT), int64(uint8(LT[100000])));
end;

// A wstring grown by one unit 1000 times; shrunk inside its block, then grown: the added
// units 0
func Wides();
var
  LW: wstring;
  LI: int64;
  LLast: string;
  LZero: string;
begin
  for LI := 0 to 999 do
    setlength(LW, len(LW) + 1);
    LW[LI] := wchar(uint16(97 + LI mod 26));
  end;
  LLast := "bad";
  if LW[999] = wchar(uint16(97 + 999 mod 26)) then
    LLast := "ok";
  end;
  setlength(LW, 990);
  setlength(LW, 1000);
  LZero := "bad";
  if LW[995] = wchar(uint16(0)) then
    LZero := "ok";
  end;
  println("w {} {} {}", len(LW), LLast, LZero);
end;

// An array of strings grown by one 1000 times: every element kept
func Names();
var
  LN: array of string;
  LI: int64;
begin
  for LI := 0 to 999 do
    setlength(LN, len(LN) + 1);
    LN[LI] := "s";
  end;
  println("n {} {}", len(LN), LN[999]);
end;

begin
  Ints();
  Texts();
  Wides();
  Names();
end.
