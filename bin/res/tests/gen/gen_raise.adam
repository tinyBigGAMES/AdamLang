-------------------------------------------------------------------------------
  gen_raise.adam - generators (G1): a raise out of a generator's body is
  raised again at the loop's resume (its next pass), at the first pass too;
  the sequence has ended after it (a later for in runs no pass); a raise
  caught inside the body (its except part yields on)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | got 1
  | got 2
  | caught bad 3
  | caught bad 1
  | kept got 1
  | caught bad 2
  | again done
  | inner 1 99 100
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_raise;

import System.SysUtils;

routine Bad(const AAt: int32): sequence of int32;
var
  LI: int32;
begin
  for LI := 1 to 5 do
    if LI = AAt then
      raise("bad " + IntToStr(LI));
    end;
    yield LI;
  end;
end;

routine Inner(): sequence of int32;
begin
  guard
    yield 1;
    raise("x");
  except
    yield 99;
  end;
  yield 100;
end;

var
  GN: int32;
  GQ: sequence of int32;
  GLine: string;

begin
  guard
    for GN in Bad(3) do
      println("{}", "got " + IntToStr(GN));
    end;
    println("not here");
  except
    println("{}", "caught " + excmsg());
  end;
  guard
    for GN in Bad(1) do
      println("{}", "got " + IntToStr(GN));
    end;
  except
    println("{}", "caught " + excmsg());
  end;
  GQ := Bad(2);
  guard
    for GN in GQ do
      println("{}", "kept got " + IntToStr(GN));
    end;
  except
    println("{}", "caught " + excmsg());
  end;
  GLine := "again";
  for GN in GQ do
    GLine := GLine + " " + IntToStr(GN);
  end;
  println("{}", GLine + " done");
  GLine := "inner";
  for GN in Inner() do
    GLine := GLine + " " + IntToStr(GN);
  end;
  println("{}", GLine);
end.
