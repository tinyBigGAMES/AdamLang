-------------------------------------------------------------------------------
  gen_err_for_in.adam - for in (BNF sec 5, G1): over what is no sequence,
  array, string, wstring or set is SM0722; a variable of another type than
  the elements' is SM0723; a constant as the variable is SM0600; a write to
  the variable in the body (an assignment, a nested loop over it) is SM0602
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe gen_err_for_in;

const
  KN: int32 = 1;

func Evens(): sequence of int32;
begin
  yield 2;
end;

var
  GN: int32;
  GW: int64;
  GA: array[0..1] of int32;
  GS: string;
  GC: char;

begin
  for GN in 5 do // ERROR SM0722
  end;
  for GW in Evens() do // ERROR SM0723
  end;
  for GN in GS do // ERROR SM0723
  end;
  for KN in GA do // ERROR SM0600
  end;
  for GN in GA do
    GN := 3; // ERROR SM0602
    for GN in GA do // ERROR SM0602
    end;
  end;
  for GC in GS do
    println("{}", GC);
  end;
end.
