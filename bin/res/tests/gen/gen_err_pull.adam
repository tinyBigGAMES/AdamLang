-------------------------------------------------------------------------------
  gen_err_pull.adam - generators (BNF sec 7, G1f): pull(S, X) with S no
  sequence, X not of S's element type or a wrong argument count is SM0409;
  X a value or a const parameter is not assignable (SM0255); X a for's
  iterator inside its loop is SM0602
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe gen_err_pull;

func Ints(): sequence of int32;
begin
  yield 1;
end;

func Takes(const AN: int32);
var
  LS: sequence of int32;
  LI: int32;
  LT: string;
  LN: int32;
begin
  LS := Ints();
  pull(5, LN); // ERROR SM0409
  pull(LS, LT); // ERROR SM0409
  pull(LS); // ERROR SM0409
  pull(LS, 5); // ERROR SM0255
  pull(LS, AN); // ERROR SM0255
  for LI := 1 to 2 do
    pull(LS, LI); // ERROR SM0602
  end;
end;

begin
  Takes(1);
end.
