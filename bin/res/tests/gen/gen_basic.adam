-------------------------------------------------------------------------------
  gen_basic.adam - generators (BNF sec 4 / 5, G1) run: a routine's yields
  walked by for in (its arguments copied in at the call), a value parameter
  written in the body, a return ending it early, an empty one, a record T,
  a bool T, skip and leave, a sequence kept in a variable and consumed once
  (a second for in runs no pass), laziness (a call runs none of the body),
  a method generator reading self
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | count 1 2 3 4
  | steps 3 10 17
  | early 1
  | early 1 2
  | nothing done
  | points 1:2 3:2
  | flags yes no
  | skipleave 1 3
  | first 1 2 3
  | second done
  | made
  | lazy start
  | lazy 5
  | upto 1 2 3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_basic;

import System.SysUtils;

type
  Point = record
    X: int32;
    Y: int32;
  end;
  Counter = object
    FMax: int32;
    method Upto(): sequence of int32;
    var
      LI: int32;
    begin
      for LI := 1 to self.FMax do
        yield LI;
      end;
    end;
  end;

// AFrom up to ATo
func Count(const AFrom: int32; const ATo: int32): sequence of int32;
var
  LI: int32;
begin
  for LI := AFrom to ATo do
    yield LI;
  end;
end;

// A value parameter is the body's own copy
func Steps(AStart: int32): sequence of int32;
begin
  while AStart < 20 do
    yield AStart;
    AStart := AStart + 7;
  end;
end;

// A return ends the generator
func Early(const AMax: int32): sequence of int32;
begin
  yield 1;
  if AMax < 5 then
    return;
  end;
  yield 2;
end;

// No yield at all
func Nothing(): sequence of int32;
begin
end;

// A record value, copied out at each pass
func Points(): sequence of Point;
var
  LP: Point;
begin
  LP.X := 1;
  LP.Y := 2;
  yield LP;
  LP.X := 3;
  yield LP;
end;

func Flags(): sequence of bool;
begin
  yield true;
  yield false;
end;

// The body starts at the first pass, not at the call
func Lazy(): sequence of int32;
begin
  println("lazy start");
  yield 5;
end;

func Show(const ATitle: string; const ASeq: sequence of int32);
var
  LN: int32;
  LLine: string;
begin
  LLine := ATitle;
  for LN in ASeq do
    LLine := LLine + " " + IntToStr(LN);
  end;
  println("{}", LLine);
end;

var
  GN: int32;
  GP: Point;
  GB: bool;
  GLine: string;
  GQ: sequence of int32;
  GC: Counter;

begin
  Show("count", Count(1, 4));
  Show("steps", Steps(3));
  Show("early", Early(1));
  Show("early", Early(9));
  GLine := "nothing";
  for GN in Nothing() do
    GLine := GLine + " " + IntToStr(GN);
  end;
  println("{}", GLine + " done");
  GLine := "points";
  for GP in Points() do
    GLine := GLine + " " + IntToStr(GP.X) + ":" + IntToStr(GP.Y);
  end;
  println("{}", GLine);
  GLine := "flags";
  for GB in Flags() do
    if GB then
      GLine := GLine + " yes";
    else
      GLine := GLine + " no";
    end;
  end;
  println("{}", GLine);
  GLine := "skipleave";
  for GN in Count(1, 10) do
    if GN = 2 then
      skip;
    end;
    if GN = 4 then
      leave;
    end;
    GLine := GLine + " " + IntToStr(GN);
  end;
  println("{}", GLine);
  GQ := Count(1, 3);
  Show("first", GQ);
  GLine := "second";
  for GN in GQ do
    GLine := GLine + " " + IntToStr(GN);
  end;
  println("{}", GLine + " done");
  GQ := Lazy();
  println("made");
  Show("lazy", GQ);
  GC.FMax := 3;
  Show("upto", GC.Upto());
end.
