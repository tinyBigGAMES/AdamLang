-------------------------------------------------------------------------------
  gen_thread.adam - generators (G1d) across tasks: a generator made by a
  task (its ramp run there, the sequence its result) walked by the program;
  one walked whole by a task, then walked again by the program (no pass);
  one left by a task's loop (its finally runs there); one begun by the
  program and finished by a task; a body awaiting a task between its
  yields; two tasks each walking a generator of its own at the same time
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | made got 1
  | made got 2
  | made finally
  | walked got 1
  | walked got 2
  | walked got 3
  | walked finally
  | walked again 0
  | left got 1
  | left finally
  | split main 1
  | split task 2
  | split task 3
  | split finally
  | square 1
  | square 4
  | square 9
  | sums 500500 2001000
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_thread;

import System.SysUtils;

// 1 to AN, a finally pending
routine Count(const ATag: string; const AN: int64): sequence of int64;
var
  LI: int64;
begin
  guard
    for LI := 1 to AN do
      yield LI;
    end;
  finally
    println("{}", ATag + " finally");
  end;
end;

// 1 to AN, nothing printed
routine Nums(const AN: int64): sequence of int64;
var
  LI: int64;
begin
  for LI := 1 to AN do
    yield LI;
  end;
end;

// The square of AValue
routine Square(const AValue: int64): int64;
begin
  return AValue * AValue;
end;

// Each square of 1 to 3, each from a task awaited between the yields
routine Squares(): sequence of int64;
var
  LI: int64;
begin
  for LI := 1 to 3 do
    yield await async Square(LI);
  end;
end;

// Every value of ASeq printed after ATag (on the task running it)
routine Drain(const ATag: string; const ASeq: sequence of int64);
var
  LV: int64;
begin
  for LV in ASeq do
    println("{} got {}", ATag, LV);
  end;
end;

// The first value of ASeq printed, then its loop left
routine TakeOne(const ATag: string; const ASeq: sequence of int64);
var
  LV: int64;
begin
  for LV in ASeq do
    println("{} got {}", ATag, LV);
    leave;
  end;
end;

// The rest of ASeq on this task
routine SplitRest(const ASeq: sequence of int64);
var
  LV: int64;
begin
  for LV in ASeq do
    println("split task {}", LV);
  end;
end;

// The sum of 1 to AN, walked on the task running it
routine Sum(const AN: int64): int64;
var
  LV: int64;
  LSum: int64;
begin
  LSum := 0;
  for LV in Nums(AN) do
    LSum := LSum + LV;
  end;
  return LSum;
end;

var
  LMade: task sequence of int64;
  LS: sequence of int64;
  LV: int64;
  LCount: int64;
  LT: task;
  LA: task int64;
  LB: task int64;
begin
  // made on a task, walked here
  LMade := async Count("made", 2);
  LS := await LMade;
  for LV in LS do
    println("made got {}", LV);
  end;

  // walked whole by a task, then here: no pass
  LS := Count("walked", 3);
  LT := async Drain("walked", LS);
  await LT;
  LCount := 0;
  for LV in LS do
    LCount := LCount + 1;
  end;
  println("walked again {}", LCount);

  // left by a task's loop: aborted on that task
  LT := async TakeOne("left", Count("left", 3));
  await LT;

  // begun here, finished by a task
  LS := Count("split", 3);
  for LV in LS do
    println("split main {}", LV);
    LT := async SplitRest(LS);
    await LT;
  end;

  for LV in Squares() do
    println("square {}", LV);
  end;

  LA := async Sum(1000);
  LB := async Sum(2000);
  println("sums {} {}", await LA, await LB);
end.
