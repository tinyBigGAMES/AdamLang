-------------------------------------------------------------------------------
  gen_fast.adam - generators (G1d) at debug and @optimize fast: managed
  values with a pending defer and finally left part way, a raise out of a
  body, a generator walking another, a method generator on a value, and a
  threadstatic read past each yield by a body resumed on a task's thread:
  read straight on in one block (gvn never reuses one address across the
  yield's call) and in a loop holding the yield (licm never hoists it), so
  each read past the switch is the task's GTag (2)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  levels debug fast
  | wa
  | wb
  | w finally
  | w defer
  | fails got 1
  | caught body raised
  | sum 1
  | sum 3
  | sum 6
  | sum 10
  | b1
  | b2
  | main 1
  | task 2
  | task 3
  | main 11
  | task 22
  | task 23
  | main GTag 1
@@end
*/

module exe gen_fast;

import System.SysUtils;

threadstatic
  GTag: int64;

type
  // A value whose method generator names its items
  Bag = object
    Title: string;

    method Items(const ACount: int64): sequence of string;
    var
      LI: int64;
    begin
      for LI := 1 to ACount do
        yield self.Title + IntToStr(LI);
      end;
    end;
  end;

// Managed values, a defer and a finally pending
func Words(const ATag: string): sequence of string;
begin
  defer println("{}", ATag + " defer");
  guard
    yield ATag + "a";
    yield ATag + "b";
    yield ATag + "c";
  finally
    println("{}", ATag + " finally");
  end;
end;

// A raise out of the body after one value
func Fails(): sequence of int64;
begin
  yield 1;
  raise("body raised");
end;

// 1 to AHigh
func Ints(const AHigh: int64): sequence of int64;
var
  LI: int64;
begin
  for LI := 1 to AHigh do
    yield LI;
  end;
end;

// The running sums of Ints(AHigh)
func Sums(const AHigh: int64): sequence of int64;
var
  LV: int64;
  LSum: int64;
begin
  LSum := 0;
  for LV in Ints(AHigh) do
    LSum := LSum + LV;
    yield LSum;
  end;
end;

// GTag read straight on, once before and twice past a yield, one block
func Straight(): sequence of int64;
var
  LA: int64;
  LB: int64;
begin
  LA := GTag;
  yield LA;
  LB := GTag;
  yield LB;
  yield GTag + LA;
end;

// GTag read in a loop holding the yield
func Looped(): sequence of int64;
var
  LI: int64;
begin
  for LI := 1 to 3 do
    yield GTag * 10 + LI;
  end;
end;

// The rest of ASeq on the task's thread, its own GTag 2
func Rest(const ASeq: sequence of int64);
var
  LV: int64;
begin
  GTag := 2;
  for LV in ASeq do
    println("task {}", LV);
  end;
end;

// The first value of ASeq on this thread, the rest on a task's
func Walk(const ASeq: sequence of int64);
var
  LV: int64;
  LT: task;
begin
  for LV in ASeq do
    println("main {}", LV);
    LT := async Rest(ASeq);
    await LT;
  end;
end;

var
  LS: string;
  LV: int64;
  LBag: Bag;
begin
  // one expect at every level: a release build has no heap report
  SetHeapReport(false);
  GTag := 1;
  for LS in Words("w") do
    println("{}", LS);
    if LS = "wb" then
      leave;
    end;
  end;
  guard
    for LV in Fails() do
      println("fails got {}", LV);
    end;
  except
    println("caught {}", excmsg());
  end;
  for LV in Sums(4) do
    println("sum {}", LV);
  end;
  LBag.Title := "b";
  for LS in LBag.Items(2) do
    println("{}", LS);
  end;
  Walk(Straight());
  Walk(Looped());
  println("main GTag {}", GTag);
end.
