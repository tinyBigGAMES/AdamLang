-------------------------------------------------------------------------------
  gen_release.adam - generators (G1d): an unfinished generator released.
  A loop left over a generator that walks another aborts both, inner first
  (the inner finally, then the outer defer); a loop left by a return inside
  a guard aborts the generator before the routine's own finally runs; a
  sequence never started is released without running its body; a sequence
  is consumed once (walked whole or left part way, a second loop runs no
  pass); a raise in the finally an abort runs is raised at the loop's leave;
  a yield in that finally raises (walked whole it is one more value); a
  generator resumed inside its own body raises at its consumer
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | chain got 10
  | inner finally
  | outer defer
  | chain after
  | inner finally
  | scoped finally
  | scoped 1
  | unstarted held
  | once got 1
  | once got 2
  | inner finally
  | once again 0
  | part got 1
  | inner finally
  | part again 0
  | raising got 1
  | caught finally raised
  | full got 1
  | full got 9
  | early got 1
  | caught a yield in a generator being released
  | self got 1
  | caught a generator resumed while it runs
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_release;

import System.SysUtils;

var
  GSelf: sequence of int32;

// Two values, a finally pending between them
routine Inner(): sequence of int32;
begin
  guard
    yield 1;
    yield 2;
  finally
    println("inner finally");
  end;
end;

// Inner's values times ten, a defer pending: aborted at its yield, its loop
// over Inner aborts Inner first
routine Outer(): sequence of int32;
var
  LN: int32;
begin
  defer println("outer defer");
  for LN in Inner() do
    yield LN * 10;
  end;
end;

// The first value of Outer, then the loop left
routine Chain();
var
  LN: int32;
begin
  for LN in Outer() do
    println("chain got {}", LN);
    leave;
  end;
  println("chain after");
end;

// A return out of the loop inside a guard: the generator ends first
routine Scoped(): int32;
var
  LN: int32;
begin
  guard
    for LN in Inner() do
      return LN;
    end;
  finally
    println("scoped finally");
  end;
  return 0;
end;

// Never resumed: its body never runs
routine Never(): sequence of int32;
begin
  println("never ran");
  yield 1;
end;

// A sequence held and released at the scope's end, never started
routine Unstarted();
var
  LS: sequence of int32;
begin
  LS := Never();
  println("unstarted held");
end;

// Walked whole, then walked again: no pass
routine Once();
var
  LS: sequence of int32;
  LN: int32;
  LCount: int32;
begin
  LS := Inner();
  for LN in LS do
    println("once got {}", LN);
  end;
  LCount := 0;
  for LN in LS do
    LCount := LCount + 1;
  end;
  println("once again {}", LCount);
end;

// Left part way (aborted), then walked again: no pass
routine Part();
var
  LS: sequence of int32;
  LN: int32;
  LCount: int32;
begin
  LS := Inner();
  for LN in LS do
    println("part got {}", LN);
    leave;
  end;
  LCount := 0;
  for LN in LS do
    LCount := LCount + 1;
  end;
  println("part again {}", LCount);
end;

// Its finally raises
routine RaisingFinally(): sequence of int32;
begin
  guard
    yield 1;
    yield 2;
  finally
    raise("finally raised");
  end;
end;

// Left at its first value: the abort's finally raises at the leave
routine LeaveRaising();
var
  LN: int32;
begin
  guard
    for LN in RaisingFinally() do
      println("raising got {}", LN);
      leave;
    end;
    println("not reached");
  except
    println("caught {}", excmsg());
  end;
end;

// Its finally yields: one more value when walked whole, a raise when aborted
routine YieldFinally(): sequence of int32;
begin
  guard
    yield 1;
  finally
    yield 9;
  end;
end;

// YieldFinally walked whole
routine FullYield();
var
  LN: int32;
begin
  for LN in YieldFinally() do
    println("full got {}", LN);
  end;
end;

// YieldFinally left at its first value
routine EarlyYield();
var
  LN: int32;
begin
  guard
    for LN in YieldFinally() do
      println("early got {}", LN);
      leave;
    end;
    println("not reached");
  except
    println("caught {}", excmsg());
  end;
end;

// Past its first value it walks GSelf, which is itself
routine SelfWalk(): sequence of int32;
var
  LN: int32;
begin
  yield 1;
  for LN in GSelf do
    yield LN;
  end;
end;

// SelfWalk resumed inside its own body: the raise reaches this loop
routine Reenter();
var
  LN: int32;
begin
  GSelf := SelfWalk();
  guard
    for LN in GSelf do
      println("self got {}", LN);
    end;
  except
    println("caught {}", excmsg());
  end;
end;

begin
  Chain();
  println("scoped {}", Scoped());
  Unstarted();
  Once();
  Part();
  LeaveRaising();
  FullYield();
  EarlyYield();
  Reenter();
end.
