  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  gen_yield_from.adam - generators (BNF sec 5, G1e): yield from S hands every
  value of S on. A recursive tree walk gives its values in order; a chain
  three deep gives each level's values in place, each level's defer run as
  it ends; a loop left mid-chain runs
  every level's defer, innermost first; a raise in the inner sequence
  reaches the outer loop, or a guard around the yield from that catches it
  (the generator then goes on); an ended sequence hands on nothing; an
  array, a string and a set are walked as a for in walks them; elements of
  another type convert to T (an int32 array and sequence into int64);
  strings pass through a chain and an array with nothing leaked; `from`
  followed by ';' or a binary operator is a name, not the delegation
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | tree 1
  | tree 2
  | tree 3
  | tree 4
  | tree 5
  | tree 6
  | tree 7
  | deep 0
  | deep 1
  | deep 2
  | defer L3
  | deep 3
  | defer L2
  | deep 4
  | defer L1
  | mid got 1
  | defer L3
  | defer L2
  | defer L1
  | mid after
  | boom got 1
  | caught inner boom
  | held got 1
  | middle caught inner boom
  | held got 99
  | ended 0
  | array 10
  | array 20
  | text a
  | text b
  | set 2
  | set 5
  | wide 7
  | wide 8
  | wide 30
  | wide 40
  | words one two three four
  | context 5
  | context 6
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_yield_from;

import System.SysUtils;

type
  Smalls = set of 0..7;

// The values ALow .. AHigh in order, as a binary tree walk: the left half,
// the middle, the right half
routine Tree(const ALow: int32; const AHigh: int32): sequence of int32;
var
  LMid: int32;
begin
  if ALow > AHigh then
    return;
  end;
  LMid := (ALow + AHigh) div 2;
  yield from Tree(ALow, LMid - 1);
  yield LMid;
  yield from Tree(LMid + 1, AHigh);
end;

routine Level3(): sequence of int32;
begin
  defer println("defer L3");
  yield 1;
  yield 2;
end;

routine Level2(): sequence of int32;
begin
  defer println("defer L2");
  yield from Level3();
  yield 3;
end;

routine Level1(): sequence of int32;
begin
  defer println("defer L1");
  yield 0;
  yield from Level2();
  yield 4;
end;

// Level2 without its own values first: its first value is Level3's
routine Mid(): sequence of int32;
begin
  defer println("defer L1");
  yield from Level2();
end;

routine Boom(): sequence of int32;
begin
  yield 1;
  raise("inner boom");
end;

routine Passes(): sequence of int32;
begin
  yield from Boom();
  yield 50;
end;

routine Holds(): sequence of int32;
begin
  guard
    yield from Boom();
  except
    println("middle caught {}", excmsg());
  end;
  yield 99;
end;

routine Ended(const AS: sequence of int32): sequence of int32;
begin
  yield from AS;
end;

routine Arrays(): sequence of int32;
var
  LA: array[0..1] of int32;
begin
  LA[0] := 10;
  LA[1] := 20;
  yield from LA;
end;

routine Texts(): sequence of char;
begin
  yield from "ab";
end;

routine Sets(): sequence of int32;
var
  LS: Smalls;
begin
  LS := [5, 2];
  yield from LS;
end;

routine Small32(): sequence of int32;
begin
  yield 7;
  yield 8;
end;

// int32 elements converted to int64: a sequence (walked, not delegated) and
// an array
routine Wide(): sequence of int64;
var
  LA: array[0..1] of int32;
begin
  LA[0] := 30;
  LA[1] := 40;
  yield from Small32();
  yield from LA;
end;

routine Pair(): sequence of string;
begin
  yield "one";
  yield "two";
end;

routine Words(): sequence of string;
var
  LA: array[0..1] of string;
begin
  LA[0] := "three";
  LA[1] := "four";
  yield from Pair();
  yield from LA;
end;

// `from` a name: before ';' and before a binary operator
routine Context(): sequence of int32;
var
  from: int32;
begin
  from := 5;
  yield from;
  yield from + 1;
end;

routine Run();
var
  LN: int32;
  LW: int64;
  LC: char;
  LT: string;
  LText: string;
  LCount: int32;
  LS: sequence of int32;
begin
  for LN in Tree(1, 7) do
    println("tree {}", LN);
  end;
  for LN in Level1() do
    println("deep {}", LN);
  end;
  for LN in Mid() do
    println("mid got {}", LN);
    leave;
  end;
  println("mid after");
  guard
    for LN in Passes() do
      println("boom got {}", LN);
    end;
  except
    println("caught {}", excmsg());
  end;
  for LN in Holds() do
    println("held got {}", LN);
  end;
  LS := Small32();
  for LN in LS do
  end;
  LCount := 0;
  for LN in Ended(LS) do
    LCount := LCount + 1;
  end;
  println("ended {}", LCount);
  for LN in Arrays() do
    println("array {}", LN);
  end;
  for LC in Texts() do
    println("text {}", LC);
  end;
  for LN in Sets() do
    println("set {}", LN);
  end;
  for LW in Wide() do
    println("wide {}", LW);
  end;
  LText := "words";
  for LT in Words() do
    LText := LText + " " + LT;
  end;
  println("{}", LText);
  for LN in Context() do
    println("context {}", LN);
  end;
end;

begin
  Run();
end.
