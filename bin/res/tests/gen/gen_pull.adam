  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  gen_pull.adam - generators (BNF sec 7, G1f): pull(S, X) stores S's next
  value into X and is true, or false once S has ended (X unchanged). Two
  sequences walked side by side (a zip, the unfinished one aborted at its
  release, its defer run; a merge of two sorted ones); pull after the end
  false again; a raise in the body raised at the pull; X a field and an
  element; the statement form skipping a value; a yield from chain; S a
  temporary; a body that drops the last other reference to its own S (the
  pull holds it); a callee walking a borrowed sequence whose body frees the
  caller's string (the caller holds the string it lends); strings with
  nothing leaked
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | zip 0 a
  | zip 2 b
  | zip 4 c
  | letters defer
  | merge 1 2 3 4 5 6 7
  | end true 1
  | end false 1
  | end false 1
  | boom 1
  | caught inner boom
  | place 7 8
  | skip 30
  | chain 1 2 3
  | temp true 5
  | drop 1
  | dropper defer
  | drop 2
  | drop new 100
  | walk orig1 1
  | walk orig1 1
  | pull orig1 1
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_pull;

type
  Pair = record
    First: int32;
    Second: int32;
  end;

var
  GDrop: sequence of int32;
  GText: string;
  GOther: string;

// ACount values from AStart, AStep apart
func Step(const AStart: int32; const AStep: int32; const ACount: int32): sequence of int32;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    yield AStart + LI * AStep;
  end;
end;

func Letters(): sequence of string;
begin
  defer println("letters defer");
  yield "a";
  yield "b";
  yield "c";
  yield "d";
end;

func Boom(): sequence of int32;
begin
  yield 1;
  raise("inner boom");
end;

func Inner(): sequence of int32;
begin
  yield 2;
end;

func Outer(): sequence of int32;
begin
  yield 1;
  yield from Inner();
  yield 3;
end;

// Replaces GDrop, the sequence being resumed, while it runs
func Dropper(): sequence of int32;
begin
  defer println("dropper defer");
  yield 1;
  GDrop := Step(100, 1, 1);
  yield 2;
end;

// Frees GText's string while a consumer runs it
func Writer(): sequence of int32;
begin
  GText := FormatStr("new{}", 2);
  // the same size as the string GText held: its freed block reused
  GOther := FormatStr("XXXX{}", 5);
  yield 1;
end;

// Borrows AText while its loop resumes AS
func Walk(const AText: string; const AS: sequence of int32);
var
  LN: int32;
begin
  for LN in AS do
    println("walk {} {}", AText, LN);
  end;
end;

// The same through a for in over an argument it passes on
func WalkOn(const AText: string; const AS: sequence of int32);
begin
  Walk(AText, AS);
end;

// Borrows AText while a pull resumes AS
func PullOne(const AText: string; const AS: sequence of int32);
var
  LN: int32;
begin
  if pull(AS, LN) then
    println("pull {} {}", AText, LN);
  end;
end;

func Zip();
var
  LA: sequence of int32;
  LB: sequence of string;
  LN: int32;
  LT: string;
begin
  LA := Step(0, 2, 3);
  LB := Letters();
  while pull(LA, LN) and pull(LB, LT) do
    println("zip {} {}", LN, LT);
  end;
end;

func Merge();
var
  LA: sequence of int32;
  LB: sequence of int32;
  LX: int32;
  LY: int32;
  LHasA: bool;
  LHasB: bool;
  LText: string;
begin
  LA := Step(1, 2, 4);
  LB := Step(2, 2, 3);
  LHasA := pull(LA, LX);
  LHasB := pull(LB, LY);
  LText := "merge";
  while LHasA or LHasB do
    if LHasA and ((not LHasB) or (LX <= LY)) then
      LText := FormatStr("{} {}", LText, LX);
      LHasA := pull(LA, LX);
    else
      LText := FormatStr("{} {}", LText, LY);
      LHasB := pull(LB, LY);
    end;
  end;
  println("{}", LText);
end;

func Run();
var
  LS: sequence of int32;
  LN: int32;
  LM: int32;
  LK: int32;
  LMore: bool;
  LPair: Pair;
  LArr: array[0..1] of int32;
begin
  Zip();
  Merge();
  LS := Step(1, 1, 1);
  LMore := pull(LS, LN);
  println("end {} {}", LMore, LN);
  LMore := pull(LS, LN);
  println("end {} {}", LMore, LN);
  LMore := pull(LS, LN);
  println("end {} {}", LMore, LN);
  LS := Boom();
  guard
    while pull(LS, LN) do
      println("boom {}", LN);
    end;
  except
    println("caught {}", excmsg());
  end;
  LS := Step(7, 1, 3);
  pull(LS, LPair.First);
  pull(LS, LArr[1]);
  println("place {} {}", LPair.First, LArr[1]);
  LS := Step(10, 10, 3);
  pull(LS, LN);
  pull(LS, LN);
  pull(LS, LN);
  println("skip {}", LN);
  LS := Outer();
  pull(LS, LN);
  pull(LS, LM);
  pull(LS, LK);
  println("chain {} {} {}", LN, LM, LK);
  LMore := pull(Step(5, 1, 3), LN);
  println("temp {} {}", LMore, LN);
  GDrop := Dropper();
  pull(GDrop, LN);
  println("drop {}", LN);
  pull(GDrop, LN);
  println("drop {}", LN);
  pull(GDrop, LN);
  println("drop new {}", LN);
  GDrop := Step(0, 0, 0);
  GText := FormatStr("orig{}", 1);
  Walk(GText, Writer());
  GText := FormatStr("orig{}", 1);
  WalkOn(GText, Writer());
  GText := FormatStr("orig{}", 1);
  PullOne(GText, Writer());
  GText := "";
  GOther := "";
end;

begin
  Run();
end.
