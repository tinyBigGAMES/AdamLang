-------------------------------------------------------------------------------
  gen_recurse.adam - generators (BNF sec 5, G1e0): a generator calls itself
  with any argument form, each passed as the parameter is across any call:
  a difference, a negation, a div, a call's result, a value (not const)
  parameter, a string built in the call, a record too big for a register
  made by a call. An async block and a for parallel body call their own
  routine with an argument computed from its captured parameter. Values in
  order, nothing leaked
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | down 0
  | down 1
  | down 2
  | down 3
  | neg 2
  | neg -2
  | halve 8
  | halve 4
  | halve 2
  | halve 1
  | ident 2
  | ident 1
  | ident 0
  | value 2
  | value 1
  | value 0
  | spell a
  | spell ax
  | spell axx
  | trio 2 10 100
  | trio 1 10 100
  | trio 0 10 100
  | async 10
  | parallel 10
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_recurse;

type
  Trio = record
    X: int64;
    Y: int64;
    Z: int64;
  end;

var
  GAsync: int64;
  GParallel: int64;

routine Same(const AN: int32): int32;
begin
  return AN;
end;

routine Less(const AT: Trio): Trio;
var
  LT: Trio;
begin
  LT := AT;
  LT.X := LT.X - 1;
  return LT;
end;

// The difference: every level below first, then its own
routine Down(const AN: int32): sequence of int32;
var
  LN: int32;
begin
  if AN > 0 then
    for LN in Down(AN - 1) do
      yield LN;
    end;
  end;
  yield AN;
end;

routine Neg(const AN: int32): sequence of int32;
var
  LN: int32;
begin
  yield AN;
  if AN > 0 then
    for LN in Neg(-AN) do
      yield LN;
    end;
  end;
end;

routine Halve(const AN: int32): sequence of int32;
var
  LN: int32;
begin
  yield AN;
  if AN > 1 then
    for LN in Halve(AN div 2) do
      yield LN;
    end;
  end;
end;

routine Ident(const AN: int32): sequence of int32;
var
  LN: int32;
begin
  yield AN;
  if AN > 0 then
    for LN in Ident(Same(AN - 1)) do
      yield LN;
    end;
  end;
end;

routine Value(AN: int32): sequence of int32;
var
  LN: int32;
begin
  yield AN;
  if AN > 0 then
    for LN in Value(AN - 1) do
      yield LN;
    end;
  end;
end;

routine Spell(const AText: string; const ADepth: int32): sequence of string;
var
  LText: string;
begin
  yield AText;
  if ADepth > 0 then
    for LText in Spell(AText + "x", ADepth - 1) do
      yield LText;
    end;
  end;
end;

routine Trios(const AT: Trio): sequence of Trio;
var
  LT: Trio;
begin
  yield AT;
  if AT.X > 0 then
    for LT in Trios(Less(AT)) do
      yield LT;
    end;
  end;
end;

// Its own routine called from the async block, the argument from the block's copy
routine AsyncSum(const AN: int64);
var
  LTask: task;
begin
  atomicadd(GAsync, AN);
  if AN > 0 then
    LTask := async begin
      AsyncSum(AN - 1);
    end;
    await LTask;
  end;
end;

routine ParallelSum(const AN: int64);
begin
  atomicadd(GParallel, AN);
  if AN > 0 then
    for parallel I := 1 to 1 do
      ParallelSum(AN - I);
    end;
  end;
end;

var
  LN: int32;
  LText: string;
  LT: Trio;
  LStart: Trio;
begin
  for LN in Down(3) do println("down {}", LN); end;
  for LN in Neg(2) do println("neg {}", LN); end;
  for LN in Halve(8) do println("halve {}", LN); end;
  for LN in Ident(2) do println("ident {}", LN); end;
  for LN in Value(2) do println("value {}", LN); end;
  for LText in Spell("a", 2) do println("spell {}", LText); end;
  LStart.X := 2;
  LStart.Y := 10;
  LStart.Z := 100;
  for LT in Trios(LStart) do println("trio {} {} {}", LT.X, LT.Y, LT.Z); end;
  AsyncSum(4);
  println("async {}", atomicload(GAsync));
  ParallelSum(4);
  println("parallel {}", atomicload(GParallel));
end.
