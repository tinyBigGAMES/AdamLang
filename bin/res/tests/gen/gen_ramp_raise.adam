-------------------------------------------------------------------------------
  gen_ramp_raise.adam - a raise in a generator's ramp (G1c3): a parameter's
  copy that raises part way releases the new generator (nothing leaked), its
  end ending only the copies built before it (the later ones never built);
  a generator method's value self whose copy raises the same, its parameter
  ended. A ramp that raises nothing ends every copy, the last built first.
  The order lines are the proof; ends counts every done, the [Heap] line
  shows nothing leaked
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | copy a'
  | copy b'
  | copy c'
  | got a'
  | got b'
  | got c'
  | done c'
  | done b'
  | done a'
  | copy a'
  | done a'
  | caught bad copy
  | copy r'
  | done r'
  | caught bad box
  | ends 13
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_ramp_raise;

var
  Ends: int64;

type
  // A copy of the tag "bad" raises; only a copy says so at its done
  TRes = object
    Tag: string;
    Copied: bool;

    copy(const ASource: TRes);
    begin
      if ASource.Tag = "bad" then
        raise("bad copy");
      end;
      self.Tag := ASource.Tag + "'";
      self.Copied := true;
      println("copy {}", self.Tag);
    end;

    done;
    begin
      Ends := Ends + 1;
      if self.Copied then
        println("done {}", self.Tag);
      end;
    end;
  end;

  // A copy of a bad box raises; its generator method copies a value self
  TBox = object
    Bad: bool;
    Copied: bool;

    copy(const ASource: TBox);
    begin
      if ASource.Bad then
        raise("bad box");
      end;
      self.Bad := ASource.Bad;
      self.Copied := true;
      println("copy box");
    end;

    done;
    begin
      Ends := Ends + 1;
      if self.Copied then
        println("done box");
      end;
    end;

    method Items(const ARes: TRes): sequence of string;
    begin
      yield ARes.Tag;
    end;
  end;

routine Three(const A: TRes; const B: TRes; const C: TRes): sequence of string;
begin
  yield A.Tag;
  yield B.Tag;
  yield C.Tag;
end;

routine RunThree(const ABad: bool);
var
  LA: TRes;
  LB: TRes;
  LC: TRes;
  LS: string;
begin
  LA.Tag := "a";
  if ABad then
    LB.Tag := "bad";
  else
    LB.Tag := "b";
  end;
  LC.Tag := "c";
  guard
    for LS in Three(LA, LB, LC) do
      println("got {}", LS);
    end;
  except
    println("{}", "caught " + excmsg());
  end;
end;

routine RunBox();
var
  LBox: TBox;
  LR: TRes;
  LS: string;
begin
  LBox.Bad := true;
  LR.Tag := "r";
  guard
    for LS in LBox.Items(LR) do
      println("got {}", LS);
    end;
  except
    println("{}", "caught " + excmsg());
  end;
end;

begin
  RunThree(false);
  RunThree(true);
  RunBox();
  println("ends {}", Ends);
end.
