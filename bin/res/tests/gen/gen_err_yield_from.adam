-------------------------------------------------------------------------------
  gen_err_yield_from.adam - generators (BNF sec 5, G1e): yield from over
  what no for in walks is SM0724; over elements that do not convert to the
  generator's T (strings into int32, a sequence of string into a sequence
  of int32) is SM0725; yield from outside a generator's own body is SM0719
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe gen_err_yield_from;

routine Texts(): sequence of string;
begin
  yield "a";
end;

routine Walks(): sequence of int32;
var
  LA: array[0..1] of string;
begin
  yield from 5; // ERROR SM0724
  yield from LA; // ERROR SM0725
  yield from Texts(); // ERROR SM0725
end;

routine Plain(): int32;
begin
  yield from Walks(); // ERROR SM0719
  return 0;
end;

begin
  yield from Walks(); // ERROR SM0719
end.
