-------------------------------------------------------------------------------
  gen_nested.adam - generators (G1) consuming generators: a generator's
  for in over another, two nested loops in one body, three levels deep;
  the outer loop leaving early aborts the middle generator, whose own loop's
  cleanup aborts the inner one (its defer runs), innermost first
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | squares 1 4 9
  | pairs 11 12 21 22
  | deep 2 4 6
  | sq 1
  | sq 4
  | count end
  | squares end
  | after
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_nested;

import System.SysUtils;

func Count(const AMax: int32): sequence of int32;
var
  LI: int32;
begin
  for LI := 1 to AMax do
    yield LI;
  end;
end;

func Squares(const AMax: int32): sequence of int32;
var
  LN: int32;
begin
  for LN in Count(AMax) do
    yield LN * LN;
  end;
end;

func Pairs(): sequence of int32;
var
  LA: int32;
  LB: int32;
begin
  for LA in Count(2) do
    for LB in Count(2) do
      yield LA * 10 + LB;
    end;
  end;
end;

func Doubles(const AMax: int32): sequence of int32;
var
  LN: int32;
begin
  for LN in Squares(AMax) do
    skip;
  end;
  for LN in Count(AMax) do
    yield LN * 2;
  end;
end;

func Logged(const AMax: int32): sequence of int32;
var
  LI: int32;
begin
  defer println("count end");
  for LI := 1 to AMax do
    yield LI;
  end;
end;

func LoggedSquares(const AMax: int32): sequence of int32;
var
  LN: int32;
begin
  defer println("squares end");
  for LN in Logged(AMax) do
    yield LN * LN;
  end;
end;

func Show(const ATitle: string; const ASeq: sequence of int32);
var
  LN: int32;
  LLine: string;
begin
  LLine := ATitle;
  for LN in ASeq do
    LLine := LLine + " " + IntToStr(LN);
  end;
  println("{}", LLine);
end;

var
  GN: int32;

begin
  Show("squares", Squares(3));
  Show("pairs", Pairs());
  Show("deep", Doubles(3));
  for GN in LoggedSquares(5) do
    println("{}", "sq " + IntToStr(GN));
    if GN = 4 then
      leave;
    end;
  end;
  println("after");
end.
