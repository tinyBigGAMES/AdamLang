-------------------------------------------------------------------------------
  gen_managed.adam - generators (G1) over managed values, Leaked 0: a
  sequence of string from a const string argument, a string value
  parameter changed in the body (the caller's unchanged), a dynamic array
  argument walked inside the generator, one left early (its last value and
  copies released), a sequence variable reassigned before its first pass,
  a sequence passed as an argument
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | words x1 x2 x3
  | grow sa sab
  | kept s
  | each a! b!
  | early y1
  | swap v1 v2 v3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_managed;

import System.SysUtils;

routine Words(const APrefix: string): sequence of string;
var
  LI: int32;
begin
  for LI := 1 to 3 do
    yield APrefix + IntToStr(LI);
  end;
end;

routine Grow(AText: string): sequence of string;
begin
  AText := AText + "a";
  yield AText;
  AText := AText + "b";
  yield AText;
end;

routine Each(const AItems: array of string): sequence of string;
var
  LS: string;
begin
  for LS in AItems do
    yield LS + "!";
  end;
end;

routine Join(const ATitle: string; const ASeq: sequence of string): string;
var
  LS: string;
  LLine: string;
begin
  LLine := ATitle;
  for LS in ASeq do
    LLine := LLine + " " + LS;
  end;
  return LLine;
end;

var
  GS: string;
  GText: string;
  GItems: array of string;
  GLine: string;
  GQ: sequence of string;

begin
  println("{}", Join("words", Words("x")));
  GText := "s";
  println("{}", Join("grow", Grow(GText)));
  println("{}", "kept " + GText);
  setlength(GItems, 2);
  GItems[0] := "a";
  GItems[1] := "b";
  println("{}", Join("each", Each(GItems)));
  GLine := "early";
  for GS in Words("y") do
    GLine := GLine + " " + GS;
    leave;
  end;
  println("{}", GLine);
  GQ := Words("u");
  GQ := Words("v");
  println("{}", Join("swap", GQ));
end.
