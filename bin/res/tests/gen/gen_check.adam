-------------------------------------------------------------------------------
  gen_check.adam - generators (BNF sec 4 / 5, G1) check clean: a routine
  and a method whose result is a sequence, yield in its body (in a loop, a
  guard's finally, a defer, a nested block), a plain return, a named
  sequence type, a generator consuming another by for in, `yield` and
  `sequence` still names elsewhere (a variable read, assigned, called)
*******************************************************************************/

/*
@@test
  kind check
@@end
*/

module exe gen_check;

type
  Ints = sequence of int32;
  Counter = object
    FMax: int32;
    method Upto(): sequence of int32;
    var
      LI: int32;
    begin
      for LI := 1 to self.FMax do
        yield LI;
      end;
    end;
  end;

// Yield in a loop, after a guard's finally, from a defer, inside a block; a plain return
routine Evens(const AMax: int32): sequence of int32;
var
  LI: int32;
begin
  defer yield -1;
  for LI := 0 to AMax do
    if LI mod 2 = 0 then
      yield LI;
    end;
  end;
  guard
    yield 100;
  finally
    yield 101;
  end;
  begin
    yield (AMax + 1) * 2;
  end;
  if AMax > 10 then
    return;
  end;
  yield AMax;
end;

// A named sequence type as the result; a generator consuming another
routine Doubled(const AMax: int32): Ints;
var
  LN: int32;
begin
  for LN in Evens(AMax) do
    yield LN * 2;
  end;
end;

// A sequence of strings
routine Words(): sequence of string;
begin
  yield "a";
  yield "b" + "c";
end;

// A routine named yield and a variable named sequence are names as before
routine yield(const AValue: int32): int32;
begin
  return AValue + 1;
end;

routine Names();
var
  sequence: int32;
begin
  sequence := yield(1);
  sequence += 2;
  println("{}", sequence);
end;

var
  GN: int32;
  GS: string;
  GC: Counter;
  GQ: Ints;

begin
  GQ := Doubled(4);
  for GN in GQ do
    println("{}", GN);
  end;
  for GS in Words() do
    println("{}", GS);
  end;
  GC.FMax := 3;
  for GN in GC.Upto() do
    println("{}", GN);
  end;
  Names();
end.
