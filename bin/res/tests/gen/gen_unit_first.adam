/*
@@test
  kind dep
@@end
*/

module exe gen_unit_first;

@addmodulepath "$P:res/tests/gen/fixtures";

import GenUnit;

var
  LS: string;
begin
  for LS in GenTagged("first", 2, 1) do
    println("{}", LS);
  end;
end.
