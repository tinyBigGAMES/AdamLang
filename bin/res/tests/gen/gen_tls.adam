-------------------------------------------------------------------------------
  gen_tls.adam - a generator resumed on another thread past its yield
  (G1d0), at debug and fast: its first value is taken on the program's
  thread, the rest by a task's (the body resumed there). A threadstatic the
  body reads after a yield is the running thread's copy (the task's GTag 2):
  its address is never one value across a call (gvn) nor hoisted out of a
  loop holding one (licm). A threadstatic for iterator is stepped in the
  running thread's copy (the task's starts at 0, so it walks 1 to 3 there;
  the program's stays at 1)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  levels debug fast
  | main 1
  | task 21
  | task 22
  | main 1
  | task 1
  | task 2
  | task 3
  | main GTag 1 GI 1
@@end
*/

module exe gen_tls;

threadstatic
  GTag: int64;
  GI: int64;

// GTag read at the start and in a loop, each past a yield
func Tags(): sequence of int64;
var
  LI: int64;
begin
  yield GTag;
  for LI := 1 to 2 do
    yield GTag * 10 + LI;
  end;
end;

// A threadstatic iterator: the running thread's copy is stepped
func Steps(): sequence of int64;
begin
  for GI := 1 to 3 do
    yield GI;
  end;
end;

// The rest of ASeq walked on the task's thread, its own GTag 2
func Rest(const ASeq: sequence of int64);
var
  LV: int64;
begin
  GTag := 2;
  for LV in ASeq do
    println("task {}", LV);
  end;
end;

// The first value of ASeq on this thread, the rest on a task's
func Walk(const ASeq: sequence of int64);
var
  LV: int64;
  LT: task;
begin
  for LV in ASeq do
    println("main {}", LV);
    LT := async Rest(ASeq);
    await LT;
  end;
end;

begin
  // one expect at every level: a release build has no heap report
  SetHeapReport(false);
  GTag := 1;
  Walk(Tags());
  Walk(Steps());
  println("main GTag {} GI {}", GTag, GI);
end.
