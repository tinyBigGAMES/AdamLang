-------------------------------------------------------------------------------
  gen_lifetime.adam - a sequence of a value object with a copy and a done
  (G1c2): a yield of a call's result moves it into the generator, a yield
  of a local copies it (its copy runs); each yield ends the value the last
  one left, the generator's end ends the last one, a generator that never
  yields ends none (its live word). The for in variable gets its own copy
  each pass. A loop left early aborts the body (its local ended) and the
  generator ends its last value. The order lines are the proof; ends counts
  every done, the [Heap] line shows nothing leaked
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | copy a'
  | done 0
  | got a'
  | done a
  | copy b'
  | done a'
  | got b'
  | done b
  | done b'
  | copy c'
  | copy c''
  | done 0
  | got c''
  | done c
  | done c'
  | done c''
  | none
  | done 0
  | ends 10
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_lifetime;

var
  Ends: int64;

type
  // Built "0" (every local is built), "'" added by each copy
  TRes = object
    Tag: string;

    init();
    begin
      self.Tag := "0";
    end;

    copy(const ASource: TRes);
    begin
      self.Tag := ASource.Tag + "'";
      println("copy {}", self.Tag);
    end;

    done;
    begin
      Ends := Ends + 1;
      println("done {}", self.Tag);
    end;
  end;

// A new value: returning the local moves it
func MakeRes(const ATag: string): TRes;
var
  LRes: TRes;
begin
  LRes.Tag := ATag;
  return LRes;
end;

// Each yield moves a call's result in
func Moves(): sequence of TRes;
begin
  yield MakeRes("a");
  yield MakeRes("b");
end;

// A yield of a local copies it
func Copies(): sequence of TRes;
var
  LR: TRes;
begin
  LR.Tag := "c";
  yield LR;
  yield LR;
end;

// Yields only when asked
func Maybe(const AYield: bool): sequence of TRes;
begin
  if AYield then
    yield MakeRes("m");
  end;
end;

func RunMoves();
var
  LR: TRes;
begin
  for LR in Moves() do
    println("got {}", LR.Tag);
  end;
end;

func RunEarly();
var
  LX: TRes;
begin
  for LX in Copies() do
    println("got {}", LX.Tag);
    leave;
  end;
end;

func RunNone();
var
  LN: TRes;
begin
  for LN in Maybe(false) do
    println("got {}", LN.Tag);
  end;
  println("none");
end;

begin
  RunMoves();
  RunEarly();
  RunNone();
  println("ends {}", Ends);
end.
