-------------------------------------------------------------------------------
  gen_err_yield.adam - generators (BNF sec 5, G1): yield outside a
  generator's own body (a plain routine, the program block, an async block
  or a for parallel's body inside one) is SM0719; return with a value in one
  is SM0720; a var parameter on one is SM0721; a yield value of another type
  is SM0200
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe gen_err_yield;

func Plain(): int32;
begin
  yield 1; // ERROR SM0719
  return 0;
end;

func Inner(): sequence of int32;
begin
  async begin
    yield 2; // ERROR SM0719
  end;
  for parallel LI := 1 to 2 do
    yield LI; // ERROR SM0719
  end;
end;

func Valued(): sequence of int32;
begin
  yield 1;
  return 2; // ERROR SM0720
end;

func ByVar(var AX: int32): sequence of int32; // ERROR SM0721
begin
  yield AX;
end;

func Typed(): sequence of int32;
begin
  yield "text"; // ERROR SM0200
end;

begin
  yield 5; // ERROR SM0719
end.
