-------------------------------------------------------------------------------
  gen_unit.adam - generators from a unit loaded from its .acu (G1d): its dep
  gen_unit_first compiled fixtures\GenUnit and wrote its .acu, so this build
  lowers only its own module (Lowered 1 unit), GenUnit's generators linked
  as its .acu holds them; -r runs the exe: the unit's method generator, its
  public generator walked whole and left part way (its finally runs each
  time), and a generator of this module walking the unit's
*******************************************************************************/

/*
@@test
  kind cli
  deps gen.gen_unit_first
  args "build" "--no-banner" "<DIR>/gen_unit.adam" "-o" "." "-r"
  exitcode 0
  | Parsed 1 unit (<NUM> lines), <NUM> from .acu in <NUM>s
  | Analyzed in <NUM>s
  | Lowered 1 unit (<NUM> routines) in <NUM>s
  | Generated <NUM> bytes of code in <NUM>s
  | Linked gen_unit.exe (libraries: <NUM>) in <NUM>s
  | Built <DIR>/gen_unit.adam -> <OUT>/bin/<CELL>/gen_unit.exe in <NUM>s
  | range 3
  | range 4
  | range 5
  | t3
  | t6
  | t9
  | t finally
  | l3
  | l finally
  | <w10>
  | <w20>
  | <w30>
  | w finally
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_unit;

@addmodulepath "$P:res/tests/gen/fixtures";

import GenUnit;

// The unit's tagged values, each in angle brackets
func Wrapped(const ATag: string): sequence of string;
var
  LS: string;
begin
  for LS in GenTagged(ATag, 30, 10) do
    yield "<" + LS + ">";
  end;
end;

var
  LR: GenRange;
  LV: int64;
  LS: string;
begin
  LR.Low := 3;
  LR.High := 5;
  for LV in LR.Values() do
    println("range {}", LV);
  end;
  for LS in GenTagged("t", 9, 3) do
    println("{}", LS);
  end;
  for LS in GenTagged("l", 9, 3) do
    println("{}", LS);
    leave;
  end;
  for LS in Wrapped("w") do
    println("{}", LS);
  end;
end.
