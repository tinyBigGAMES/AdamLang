-------------------------------------------------------------------------------
  gen_self.adam - generator methods (G1c2): a method generator keeps its
  self as its call reached it. Through a ref the generator holds that ref
  (the object outlives every variable that named it, and a change made
  after the call is seen): a direct call, a virtual one through the
  vtable, an interface's through the itable. A value receiver (a local, a
  ptr's object) is copied into the generator at the call: a change after
  the call is not seen; a self with a copy and a done is copied by its copy
  and its copy ended with the generator. The done lines show when each
  object ends; the [Heap] line shows nothing leaked
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | dropped
  | kept k1 k2
  | done k
  | live n1 n2
  | done n
  | virtual note v
  | done v
  | iface word w
  | done w
  | value b11 b12
  | ptr x91
  | copy r'
  | copied r'!
  | done r'
  | done s
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_self;

import System.SysUtils;

type
  IWords = interface
    method Words(): sequence of string;
  end;

  // Reached through refs: its done shows when the last holder lets go
  TNote = object implements IWords
    Text: string;

    init(const AText: string);
    begin
      self.Text := AText;
    end;

    done;
    begin
      println("done {}", self.Text);
    end;

    method Tags(): sequence of string;
    begin
      yield self.Text + "1";
      yield self.Text + "2";
    end;

    virtual method Kinds(): sequence of string;
    begin
      yield "note " + self.Text;
    end;

    virtual method Words(): sequence of string;
    begin
      yield "word " + self.Text;
    end;
  end;

  // A plain value: copied at the call
  TBag = object
    Base: int64;
    Name: string;

    method Items(const ACount: int64): sequence of string;
    var
      LI: int64;
    begin
      for LI := 1 to ACount do
        yield self.Name + IntToStr(self.Base + LI);
      end;
    end;
  end;

  // A value with a copy and a done: its copy runs at the call, its done at the end
  TRes = object
    Tag: string;

    copy(const ASource: TRes);
    begin
      self.Tag := ASource.Tag + "'";
      println("copy {}", self.Tag);
    end;

    done;
    begin
      println("done {}", self.Tag);
    end;

    method Tags(): sequence of string;
    begin
      yield self.Tag + "!";
    end;
  end;

// Every value of ASeq after ATitle, one line
func Show(const ATitle: string; const ASeq: sequence of string);
var
  LS: string;
  LLine: string;
begin
  LLine := ATitle;
  for LS in ASeq do
    LLine := LLine + " " + LS;
  end;
  println("{}", LLine);
end;

// The only ref lets go before the pass: the generator keeps the object
func RunKept();
var
  LN: ref TNote;
  LQ: sequence of string;
begin
  LN := ref TNote("k");
  LQ := LN.Tags();
  LN := nil;
  println("dropped");
  Show("kept", LQ);
end;

// A change after the call is seen: the generator runs on the object itself
func RunLive();
var
  LN: ref TNote;
  LQ: sequence of string;
begin
  LN := ref TNote("m");
  LQ := LN.Tags();
  LN.Text := "n";
  LN := nil;
  Show("live", LQ);
end;

// Through the vtable
func RunVirtual();
var
  LN: ref TNote;
  LQ: sequence of string;
begin
  LN := ref TNote("v");
  LQ := LN.Kinds();
  LN := nil;
  Show("virtual", LQ);
end;

// Through the itable: the generator holds the object behind the ref I
func RunIface();
var
  LW: ref IWords;
  LQ: sequence of string;
begin
  LW := ref TNote("w");
  LQ := LW.Words();
  LW := nil;
  Show("iface", LQ);
end;

// Value receivers: a change after the call is not seen
func RunValue();
var
  LB: TBag;
  LP: ptr to TBag;
  LQ: sequence of string;
begin
  LB.Base := 10;
  LB.Name := "b";
  LQ := LB.Items(2);
  LB.Base := 90;
  LB.Name := "x";
  Show("value", LQ);
  LP := addr of LB;
  LQ := LP->Items(1);
  LB.Base := 0;
  Show("ptr", LQ);
end;

// Copied by its copy at the call; the last declared (LQ) is released first
func RunCopied();
var
  LR: TRes;
  LQ: sequence of string;
begin
  LR.Tag := "r";
  LQ := LR.Tags();
  LR.Tag := "s";
  Show("copied", LQ);
end;

begin
  RunKept();
  RunLive();
  RunVirtual();
  RunIface();
  RunValue();
  RunCopied();
end.
