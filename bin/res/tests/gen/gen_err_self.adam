-------------------------------------------------------------------------------
  gen_err_self.adam - generator methods (G1c2): a receiver reached through no
  ref is copied into the generator at the call, so its type must copy
  (SM0427, its hint at the done that keeps it from copying) and, for a
  method that does not dispatch, it may not be a descendant of a
  polymorphic type (SM0428: the copy would keep only that part). The same
  calls through a ref, and a dispatched one, are clean
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe gen_err_self;

type
  TLocked = object
    N: int64;

    done; // HINT SM0427
    begin
    end;

    method Items(): sequence of int64;
    begin
      yield self.N;
    end;
  end;

  TPoly = object
    N: int64;

    virtual method Kinds(): sequence of int64;
    begin
      yield self.N;
    end;

    method Items(): sequence of int64;
    begin
      yield self.N;
    end;
  end;

routine UseLocked(): int64;
var
  LL: TLocked;
  LR: ref TLocked;
  LS: int64;
  LT: int64;
begin
  LT := 0;
  for LS in LL.Items() do // ERROR SM0427
    LT := LT + LS;
  end;
  LR := ref TLocked;
  for LS in LR.Items() do
    LT := LT + LS;
  end;
  return LT;
end;

routine UsePoly(var AP: TPoly): int64;
var
  LS: int64;
  LT: int64;
begin
  LT := 0;
  for LS in AP.Items() do // ERROR SM0428
    LT := LT + LS;
  end;
  for LS in AP.Kinds() do
    LT := LT + LS;
  end;
  return LT;
end;

begin
end.
