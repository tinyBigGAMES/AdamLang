-------------------------------------------------------------------------------
  gen_copy_fail.adam - a generator method's self it cannot copy (G1c2): a
  dispatched call on a value of a copyable ancestor (a var parameter) that
  is in fact a descendant ending by a done and declaring no copy. The
  compiler cannot see it there, so the ramp releases the generator (nothing
  leaked) and raises; the ancestor's own value walks as usual
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 1
  | base 1
  | unhandled exception 1: a generator method's object cannot be copied
  | done locked
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_copy_fail;

import System.SysUtils;

type
  TBase = object
    N: int64;

    virtual method Items(const ATag: string): sequence of string;
    begin
      yield ATag + " " + IntToStr(self.N);
    end;
  end;

  // Cannot be copied: a done and no copy
  TLocked = object(TBase)
    done;
    begin
      println("done locked");
    end;

    override method Items(const ATag: string): sequence of string;
    begin
      yield ATag + " locked";
    end;
  end;

func Walk(var ABase: TBase);
var
  LS: string;
begin
  for LS in ABase.Items("base") do
    println("{}", LS);
  end;
end;

var
  GBase: TBase;
  GLocked: TLocked;

begin
  GBase.N := 1;
  Walk(GBase);
  GLocked.N := 5;
  Walk(GLocked);
end.
