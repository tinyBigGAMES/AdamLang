-------------------------------------------------------------------------------
  gen_defer.adam - generators (G1): a generator's pending finally and defer
  run, inner first, when its loop leaves it unfinished by leave, by a return
  out of the routine holding the loop and by a raise out of the loop body,
  and when the loop walks it to its end; a defer in the loop's own body
  runs each pass
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | leave got 1
  | leave got 2
  | leave finally
  | leave defer
  | leave after
  | return got 1
  | return finally
  | return defer
  | return 10
  | raise got 1
  | raise got 2
  | raise got 3
  | raise finally
  | raise defer
  | caught stop
  | full got 1
  | full got 2
  | full got 3
  | full finally
  | full defer
  | full after
  | pass 1
  | pass 2
  | pass 3
  | inner finally
  | inner defer
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe gen_defer;

import System.SysUtils;

func Guarded(const ATag: string): sequence of int32;
begin
  defer println("{}", ATag + " defer");
  guard
    yield 1;
    yield 2;
    yield 3;
  finally
    println("{}", ATag + " finally");
  end;
end;

func LeaveIt();
var
  LN: int32;
begin
  for LN in Guarded("leave") do
    println("{}", "leave got " + IntToStr(LN));
    if LN = 2 then
      leave;
    end;
  end;
  println("leave after");
end;

func ReturnIt(): int32;
var
  LN: int32;
begin
  for LN in Guarded("return") do
    println("{}", "return got " + IntToStr(LN));
    if LN = 1 then
      return 10;
    end;
  end;
  return 0;
end;

func RaiseIt();
var
  LN: int32;
begin
  for LN in Guarded("raise") do
    println("{}", "raise got " + IntToStr(LN));
    if LN = 3 then
      raise("stop");
    end;
  end;
end;

func FullIt();
var
  LN: int32;
begin
  for LN in Guarded("full") do
    println("{}", "full got " + IntToStr(LN));
  end;
  println("full after");
end;

// The loop body's own defer runs at each pass's end; leaving at the third pass
func PassIt();
var
  LN: int32;
begin
  for LN in Guarded("inner") do
    defer println("{}", "pass " + IntToStr(LN));
    if LN = 3 then
      leave;
    end;
  end;
end;

begin
  LeaveIt();
  println("{}", "return " + IntToStr(ReturnIt()));
  guard
    RaiseIt();
  except
    println("{}", "caught " + excmsg());
  end;
  FullIt();
  PassIt();
end.
