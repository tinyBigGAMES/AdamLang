-------------------------------------------------------------------------------
  opt_layout.adam - x86_64 machine cleanup and layout (PLAN-ADAM M6 O20):
  nested loops with a raise path never taken (placed last, the loop bodies
  after their headers, the headers aligned at fast), a chain of tests whose
  jcc over a jmp to the next block is inverted, a swap carried around a
  loop (phi copies whose moves undo each other) and float64 values live
  across calls (callee-saved vector registers at safe and up: saved and
  restored by the prologue and the epilogue, described to the unwinder).
  Pass's call into the runtime keeps every value unknown to every pass
  (GOne is set at run time). Every level runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | loops 1155
  | classes 497
  | fib 102334155
  | floats 1125
@@end
*/

module exe opt_layout;

var
  GOne: int64;

// AN times GOne (1), after a real call into the runtime
routine Pass(const AN: int64): int64;
begin
  FlushOutput();
  return AN * GOne;
end;

// AX times GOne (1.0), after a real call into the runtime
routine PassFloat(const AX: float64): float64;
begin
  FlushOutput();
  return AX * float64(GOne);
end;

// The sum of LI * LJ over 0 <= LJ <= LI < AN (AN is 10), past a raise no value reaches
routine Loops(const AN: int64): int64;
var
  LI: int64;
  LJ: int64;
  LTotal: int64;
begin
  LTotal := 0;
  for LI := 0 to AN - 1 do
    for LJ := 0 to LI do
      if LJ > 1000 then
        raise("never");
      end;
      LTotal := LTotal + LI * LJ;
    end;
  end;
  return LTotal;
end;

// 1 below 0, 2 at 0, 3 below 10, 4 below 100, else 5
routine Classify(const AX: int64): int64;
begin
  if AX < 0 then
    return 1;
  end;
  if AX = 0 then
    return 2;
  end;
  if AX < 10 then
    return 3;
  end;
  if AX < 100 then
    return 4;
  end;
  return 5;
end;

// Classify summed over -3..AN (AN is 120)
routine Classes(const AN: int64): int64;
var
  LI: int64;
  LTotal: int64;
begin
  LTotal := 0;
  for LI := -3 to AN do
    LTotal := LTotal + Classify(LI);
  end;
  return LTotal;
end;

// The AN-th Fibonacci number (AN is 40): two values swapped around the loop
routine Fib(const AN: int64): int64;
var
  LA: int64;
  LB: int64;
  LT: int64;
  LI: int64;
begin
  LA := 0;
  LB := 1;
  for LI := 1 to AN do
    LT := LA + LB;
    LA := LB;
    LB := LT;
  end;
  return LA;
end;

// Three float64 values live across AN calls (AN is 10): each round adds 5 + 6.25 - 12.5,
// then the three are added (11.25)
routine Floats(const AN: int64): float64;
var
  LA: float64;
  LB: float64;
  LC: float64;
  LD: float64;
  LI: int64;
begin
  LA := float64(AN) * 0.5;
  LB := LA + 1.25;
  LC := LB * 2.0;
  LD := 0.0;
  for LI := 1 to AN do
    LD := LD + PassFloat(LA) + LB - LC;
  end;
  return LD + LA + LB + LC;
end;

begin
  SetHeapReport(false);
  GOne := 1;
  println("loops {}", Loops(Pass(10)));
  println("classes {}", Classes(Pass(120)));
  println("fib {}", Fib(Pass(40)));
  println("floats {}", int64(Floats(Pass(10)) * 100.0));
end.
