-------------------------------------------------------------------------------
  opt_sccp.adam - SCCP (PLAN-ADAM M6 O5): at safe, fast and small the
  constants mem2reg leaves are propagated and folded as the machine computes
  them (wraps at the type's width, the hardware's shift-count masks, narrow
  types through int32, converts, floats in their own type), a branch on a
  known compare runs only its taken side (simplifycfg then drops the other
  and the join's one-value phi: one block), a value that stays one constant
  around a loop folds through its phi, and a division by a known zero (or
  the lowest value by -1) is never folded: it stays where it was. Every
  level runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  ir safe| i17 = const int64 90
  ir safe| i30 = const int32 2
  ir safe| ret i30
  ir safe| i56 = add int64 i32, i55
  ir safe| i480 = const int64 5
  ir safe| i118 = const uint8 44
  ir safe| i129 = const uint32 0
  ir safe| i145 = const int32 2
  ir safe| i156 = const int8 -64
  ir safe| i164 = const int32 2
  ir safe| i172 = const uint8 255
  ir safe| i180 = const int64 -3
  ir safe| i204 = const float64 4614500768194494464
  ir safe| i220 = const bool 1
  ir safe| i240 = const bool 0
  ir safe| i249 = const bool 1
  ir safe| i258 = const bool 1
  ir safe| i280 = const int64 0
  ir safe| i282 = const int64 -9223372036854775808
  ir safe| i284 = const int64 -1
  ir safe| i290 = sdiv int64 i278, i280
  ir safe| i296 = sdiv int64 i282, i284
  ir safe| i300 = const int64 3
  ir safe| i319 = srem int64 i311, i313
  ir safe| i323 = const int64 3
  | arith 90
  | choose 2
  | dead 6
  | steady 20
  | wrap 44 0 2 -64
  | convert 2 255 -3 4294967295
  | float 3.25 true false
  | compare true true
  | divide 3 3
@@end
*/

module exe opt_sccp;

// Constants through locals: the whole sum folds to one constant
routine Arith(): int64;
var
  LA: int64;
  LB: int64;
begin
  LA := 6;
  LB := 7;
  return LA * LB + (LA shl 3);
end;

// A branch on a known compare: only its taken side runs
routine Choose(): int32;
var
  LA: int32;
begin
  LA := 4;
  if LA > 10 then
    return 1;
  end;
  return 2;
end;

// The side that never runs does real work: sccp empties its block to a bare ret and the
// join's phi keeps only the edge that runs; simplifycfg drops the block and the phi, the
// add taking the parameter itself
routine Dead(const AValue: int64): int64;
var
  LA: int64;
  LR: int64;
begin
  LA := 4;
  LR := AValue;
  if LA > 10 then
    LR := AValue * 3;
  end;
  return LR + 1;
end;

// LX stays 5 around the loop: its phi folds, the loop itself stays
routine Steady(const ACount: int64): int64;
var
  LI: int64;
  LX: int64;
  LSum: int64;
begin
  LX := 5;
  LSum := 0;
  for LI := 1 to ACount do
    LSum := LSum + LX;
    LX := 5;
  end;
  return LSum + LX;
end;

// uint8 200 + 100 wraps to 44 (computed at int32, cut back); uint32 max + 1 wraps to 0;
// int32 1 shl 33 is 2 (the hardware masks the count to 0..31); int8 -128 shr 1 is -64
// (arithmetic)
routine Wrap8(): uint8;
var
  LA: uint8;
  LB: uint8;
begin
  LA := 200;
  LB := 100;
  LA += LB;
  return LA;
end;

routine Wrap32(): uint32;
var
  LA: uint32;
begin
  LA := 4294967295;
  LA += 1;
  return LA;
end;

routine Masked(): int32;
var
  LV: int32;
  LN: int32;
begin
  LV := 1;
  LN := 33;
  return LV shl LN;
end;

routine Narrow(): int8;
var
  LS: int8;
begin
  LS := -128;
  return int8(LS shr 1);
end;

// float64 2.75 to int32 truncates to 2; int32 -1 to uint8 is 255; float64 -3.5 to int64
// is -3; int32 -1 to uint32 is its bits
routine ToInt(): int32;
var
  LF: float64;
begin
  LF := 2.75;
  return int32(LF);
end;

routine ToByte(): uint8;
var
  LM: int32;
begin
  LM := -1;
  return uint8(LM);
end;

routine ToWide(): int64;
var
  LF: float64;
begin
  LF := -3.5;
  return int64(LF);
end;

routine ToBits(): uint32;
var
  LM: int32;
begin
  LM := -1;
  return uint32(LM);
end;

// 1.5 * 2.0 + 0.25 in float64; float32 0.5 + 0.25 = 0.75 compared; 1.0 / 3.0 compared to
// itself as float32 (no exact third)
routine Floats(): float64;
var
  LF: float64;
  LG: float64;
begin
  LF := 1.5;
  LG := 2.0;
  return LF * LG + 0.25;
end;

routine Single(): bool;
var
  LH: float32;
  LK: float32;
begin
  LH := 0.5f;
  LK := 0.25f;
  return LH + LK = 0.75f;
end;

routine Third(): bool;
var
  LF: float64;
  LG: float64;
begin
  LF := 1.0;
  LG := 3.0;
  return float64(float32(LF / LG)) = LF / LG;
end;

// uint32 max is above 1 as unsigned; int32 -1 is below 1 as signed
routine Unsigned(): bool;
var
  LU: uint32;
begin
  LU := 4294967295;
  return LU > 1;
end;

routine Signed(): bool;
var
  LM: int32;
begin
  LM := -1;
  return LM < 1;
end;

// A division by a known zero and the lowest int64 by -1 are never folded (they fault on
// the machine): they stay; neither runs here, as AFlag and AOther are false (each has
// its own flag: under one flag gvn knows the second test false and drops its division)
routine Divide(const AFlag: bool; const AOther: bool): int64;
var
  LA: int64;
  LZ: int64;
  LLow: int64;
  LMinus: int64;
begin
  LA := 7;
  LZ := 0;
  LLow := -9223372036854775807 - 1;
  LMinus := -1;
  if AFlag then
    return LA div LZ;
  end;
  if AOther then
    return LLow div LMinus;
  end;
  return LA div 2;
end;

routine Remainder(const AFlag: bool): int64;
var
  LA: int64;
  LZ: int64;
begin
  LA := 7;
  LZ := 0;
  if AFlag then
    return LA mod LZ;
  end;
  return LA mod 4;
end;

begin
  SetHeapReport(false);
  println("arith {}", Arith());
  println("choose {}", Choose());
  println("dead {}", Dead(5));
  println("steady {}", Steady(3));
  println("wrap {} {} {} {}", Wrap8(), Wrap32(), Masked(), Narrow());
  println("convert {} {} {} {}", ToInt(), ToByte(), ToWide(), ToBits());
  println("float {} {} {}", Floats(), Single(), Third());
  println("compare {} {}", Unsigned(), Signed());
  println("divide {} {}", Divide(false, false), Remainder(false));
end.
