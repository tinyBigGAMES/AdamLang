-------------------------------------------------------------------------------
  opt_licm.adam - licm (PLAN-ADAM M6 O11): at safe, fast and small what a
  loop does not change moves to its preheader: invariant arithmetic, a
  global's load in a loop that writes no memory, an outer loop's value in
  an inner loop; a load stays where the loop stores to it (a global, a var
  parameter that may be the stored one), a value the loop makes reaches
  its use after the loop (lcssa), and a division by a parameter stays
  behind the println ahead of it. Every level runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | invariant 34
  | global 50
  | stored 6
  | alias 6
  | exit 21
  | nested 126
  | step 1
  | step 2
  | ratio 10
@@end
*/

module exe opt_licm;

var
  GScale: int64;
  GCounter: int64;
  GValue: int64;

// AK * 3 is the same each turn: it moves out
routine Invariant(const AN: int64; const AK: int64): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 1 to AN do
    LTotal := LTotal + AK * 3 + LI;
  end;
  return LTotal;
end;

// Nothing in the loop writes memory: GScale's load moves out
routine Scaled(const AN: int64): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 1 to AN do
    LTotal := LTotal + GScale * LI;
  end;
  return LTotal;
end;

// The loop stores GCounter: its load stays
routine Count(const AN: int64);
var
  LI: int64;
begin
  for LI := 1 to AN do
    GCounter := GCounter + LI;
  end;
end;

// AX and AY may be one place: the store to AX keeps AY's load in the loop
routine Bump(var AX: int64; var AY: int64; const AN: int64): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 1 to AN do
    AX := AX + 1;
    LTotal := LTotal + AY;
  end;
  return LTotal;
end;

// LV is made in the loop and read after it
routine Last(const AN: int64): int64;
var
  LV: int64;
  LI: int64;
begin
  LV := 0;
  LI := 0;
  while LI < AN do
    LV := LI * 7;
    LI := LI + 1;
  end;
  return LV;
end;

// LI * 10 + AK is the inner loop's invariant, AK the outer one's too
routine Nested(const AK: int64): int64;
var
  LTotal: int64;
  LI: int64;
  LJ: int64;
begin
  LTotal := 0;
  for LI := 1 to 3 do
    for LJ := 1 to 2 do
      LTotal := LTotal + LI * 10 + AK;
    end;
  end;
  return LTotal;
end;

// AX div AY may fault: it never moves ahead of the println before it
routine Ratio(const AX: int64; const AY: int64; const AN: int64): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 1 to AN do
    println("step {}", LI);
    LTotal := LTotal + AX div AY;
  end;
  return LTotal;
end;

begin
  SetHeapReport(false);
  println("invariant {}", Invariant(4, 2));
  GScale := 5;
  println("global {}", Scaled(4));
  GCounter := 0;
  Count(3);
  println("stored {}", GCounter);
  GValue := 0;
  println("alias {}", Bump(GValue, GValue, 3));
  println("exit {}", Last(4));
  println("nested {}", Nested(1));
  println("ratio {}", Ratio(5, 1, 2));
end.
