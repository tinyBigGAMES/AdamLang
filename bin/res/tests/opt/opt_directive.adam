-------------------------------------------------------------------------------
  opt_directive.adam - the main module's @optimize sets the build's level
  (PLAN-ADAM M6 O1, BNF's @optimize): this file, built by adam with no -opt
  and run (-r), is a fast build: its defines name release_fast, and its exe
  is in the bin cell of that mode
*******************************************************************************/

/*
@@test
  kind cli
  args "--no-banner" "build" "--quiet" "<DIR>/opt_directive.adam" "-o" "." "-r"
  exitcode 0
  | mode release_fast
  | folder release_fast
@@end
*/

module exe opt_directive;

@optimize fast;

import System.SysUtils;

var
  GMode: string;

begin
  GMode := "none";
@ifdef DEBUG
  GMode := "debug";
@endif
@ifdef RELEASE_SAFE
  GMode := "release_safe";
@endif
@ifdef RELEASE_FAST
  GMode := "release_fast";
@endif
@ifdef RELEASE_SMALL
  GMode := "release_small";
@endif
  println("mode {}", GMode);
  println("folder {}", ExtractFileName(ExtractFileDir(paramstr(0))));
end.
