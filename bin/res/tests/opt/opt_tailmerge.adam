-------------------------------------------------------------------------------
  opt_tailmerge.adam - tailmerge (PLAN-ADAM M6 O16): at small blocks that
  end alike cross-jump into one tail: returns of one computed value after
  different stores (a tail split off its block), whole equal paths, tails
  jumping to a join whose phi takes the same-placed value from both; tails
  that differ only in a constant stay apart, a tail inside a guard stays
  apart from the same tail outside it (its finally still runs once).
  Every level runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | grade 13 13 13 35
  | differ 13 14 0
  | phied 18 18 20
  | same
  | same
  | other 3
  | scoped 13 13
  | hits 6
  | calls 1
@@end
*/

module exe opt_tailmerge;

var
  GBase: int64;
  GHits: int64;
  GCalls: int64;

// Three returns of one value: the first and third paths whole equals, the second's
// store differs (its tail split off)
routine Grade(const AN: int64): int64;
begin
  if AN < 10 then
    GHits := GHits + 1;
    return GBase * 3 + 1;
  end;
  if AN < 20 then
    GHits := GHits + 2;
    return GBase * 3 + 1;
  end;
  if AN < 30 then
    GHits := GHits + 1;
    return GBase * 3 + 1;
  end;
  return AN;
end;

// Tails that differ in a constant stay apart
routine Differ(const AN: int64): int64;
begin
  if AN = 1 then
    return GBase * 3 + 1;
  end;
  if AN = 2 then
    return GBase * 3 + 2;
  end;
  return 0;
end;

// Two paths into a join, its phi taking each one's own sum: they merge; the third's
// sum differs
routine Phied(const AN: int64): int64;
var
  LR: int64;
begin
  if AN = 1 then
    LR := GBase + 5;
  else
    if AN = 2 then
      LR := GBase + 5;
    else
      LR := GBase + 6;
    end;
  end;
  return LR * 2;
end;

// Two equal printing paths
routine Report(const AN: int64);
begin
  if AN = 1 then
    println("same");
    return;
  end;
  if AN = 2 then
    println("same");
    return;
  end;
  println("other {}", AN);
end;

// The same store inside a guard and outside it: never one tail (the guarded one
// unwinds to its finally)
routine Scoped(const AN: int64): int64;
begin
  if AN = 1 then
    guard
      GHits := GHits + 1;
    finally
      GCalls := GCalls + 1;
    end;
    return GBase * 3 + 1;
  end;
  GHits := GHits + 1;
  return GBase * 3 + 1;
end;

begin
  SetHeapReport(false);
  GBase := 4;
  GHits := 0;
  GCalls := 0;
  println("grade {} {} {} {}", Grade(5), Grade(15), Grade(25), Grade(35));
  println("differ {} {} {}", Differ(1), Differ(2), Differ(3));
  println("phied {} {} {}", Phied(1), Phied(2), Phied(3));
  Report(1);
  Report(2);
  Report(3);
  println("scoped {} {}", Scoped(1), Scoped(2));
  println("hits {}", GHits);
  println("calls {}", GCalls);
end.
