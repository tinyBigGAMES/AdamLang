-------------------------------------------------------------------------------
  opt_loopshape.adam - loopshape (PLAN-ADAM M6 O13): at fast a loop whose
  turns are counted from constants is fully unrolled (up and down), one
  counted from a parameter partially unrolled (each copy keeping its exit
  test), a while loop testing at its top rotated, a loop leaving from its
  body (two exits) partially unrolled, and a loop branching on a parameter
  unswitched (both ways). Every level runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | full 36
  | down 55
  | counted 120
  | rotated 4950
  | early 21
  | flag 30
  | noflag 45
@@end
*/

module exe opt_loopshape;

// 1..8 from constants: eight turns, laid out in a row at fast
routine Full(): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 1 to 8 do
    LTotal := LTotal + LI;
  end;
  return LTotal;
end;

// 10 down to 1 from constants: ten turns
routine Down(): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 10 downto 1 do
    LTotal := LTotal + LI;
  end;
  return LTotal;
end;

// A trip count from a parameter: partially unrolled, every copy tests the end
routine Counted(const AN: int64): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 1 to AN do
    LTotal := LTotal + LI;
  end;
  return LTotal;
end;

// A while loop tests at its top: rotated (the first test before the loop)
routine Rotated(const AN: int64): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  LI := 0;
  while LI < AN do
    LTotal := LTotal + LI;
    LI := LI + 1;
  end;
  return LTotal;
end;

// Leaves from its body once LI * LI passes AN: two exits, each copy keeps both
routine Early(const AN: int64): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 1 to 100 do
    if LI * LI > AN then
      leave;
    end;
    LTotal := LTotal + LI;
  end;
  return LTotal;
end;

// AFlag is made outside the loop: unswitched, one loop for each way
routine Flagged(const AN: int64; const AFlag: bool): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 1 to AN do
    if AFlag then
      LTotal := LTotal + LI * 2;
    else
      LTotal := LTotal + LI;
    end;
  end;
  return LTotal;
end;

begin
  SetHeapReport(false);
  println("full {}", Full());
  println("down {}", Down());
  println("counted {}", Counted(15));
  println("rotated {}", Rotated(100));
  println("early {}", Early(40));
  println("flag {}", Flagged(5, true));
  println("noflag {}", Flagged(9, false));
end.
