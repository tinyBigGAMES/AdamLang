-------------------------------------------------------------------------------
  opt_select.adam - x86_64 selection's folding (PLAN-ADAM M6 O19): element
  addresses by a variable index (int64 and int32 arrays: base + index *
  scale; 24-byte records: an index times 24 plus each field's offset; a
  global array by a constant and a variable index), immediates (and, or,
  xor, add, sub, shifts by a constant, a 64-bit constant too wide for one,
  stores of constants), compares fused into their branch (signed, against
  0, unsigned, float orders; a float's <> keeps its setcc pair), division
  and remainder by constants through magic numbers (signed and unsigned,
  32 and 64 bits, negative divisors, a power of two, the largest unsigned
  divisor taken), multiplies by 3 / 5 / 9 (lea), 8 (shl), 7 (imul's
  immediate) and a constant too wide for one, and diamonds and triangles of
  bare jumps (cmov and setcc at fast). Pass's call into the runtime keeps
  every value unknown to every pass (GOne is set at run time). Every level
  runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | addresses 1296
  | imm 878 112345 4294968296
  | stores 42 1099511627520 0
  | compares 2013058110
  | div64 142857 4 -142857 -4 -100000 -3 -62500 -3
  | div32 -41152 -1 -123 17636 -5
  | divu32 571428571 3 4000 0
  | divu64 6148914691236517205 5 2 18446743944
  | mul 37035 61725 111105 98760 86415 53021371281465
  | select 2011466
@@end
*/

module exe opt_select;

type
  Point = record
    X: int64;
    Y: int64;
    Z: int64;
  end;

var
  GOne: int64;
  GTable: array[0..7] of int64;
  GSmall: int64;
  GBig: int64;
  GZero: int64;

// AN times GOne (1), after a real call into the runtime
routine Pass(const AN: int64): int64;
begin
  FlushOutput();
  return AN * GOne;
end;

// Element addresses through arrays, records and a global array (AN is 5)
routine Addresses(const AN: int64): int64;
var
  LA: array[0..15] of int64;
  LB: array[0..15] of int32;
  LP: array[0..3] of Point;
  LI: int64;
  LTotal: int64;
begin
  for LI := 0 to 15 do
    LA[LI] := LI * 3;
    LB[LI] := int32(LI) * 5;
  end;
  for LI := 0 to 3 do
    LP[LI].X := LI + AN;
    LP[LI].Y := LI * 9;
    LP[LI].Z := LI * 8;
  end;
  for LI := 0 to 7 do
    GTable[LI] := LI + 100;
  end;
  LTotal := 0;
  for LI := 0 to 15 do
    LTotal := LTotal + LA[(LI + AN) mod 16] + int64(LB[15 - LI]);
  end;
  for LI := 0 to 3 do
    LTotal := LTotal + LP[LI].X + LP[LI].Y + LP[LI].Z;
  end;
  return LTotal + GTable[3] + GTable[AN];
end;

// Immediates of and / or / xor / sub / shifts, an int32 multiply and add, and a 64-bit
// constant no immediate holds (AN is 1000)
routine Immediates(const AN: int64);
var
  LX: int64;
  LY: int32;
  LZ: int64;
begin
  LX := ((AN + 7) & 0xFF) | 0x100;
  LX := (LX xor 0x55) - 3;
  LX := (LX shl 3) shr 2;
  LY := int32(AN) * 100 + 12345;
  LZ := AN + 0x100000000;
  println("imm {} {} {}", LX, LY, LZ);
end;

// Counts over -AN..AN by signed, zero, unsigned and float compares (AN is 10)
routine Compares(const AN: int64): int64;
var
  LI: int64;
  LCount: int64;
  LU: uint64;
  LF: float64;
begin
  LCount := 0;
  for LI := -AN to AN do
    if LI < 0 then
      LCount := LCount + 1;
    end;
    if LI = 0 then
      LCount := LCount + 100;
    end;
    if LI >= 3 then
      LCount := LCount + 1000;
    end;
    LU := uint64(LI + AN);
    if LU > 15 then
      LCount := LCount + 10000;
    end;
    LF := float64(LI) * 0.5;
    if LF < 1.5 then
      LCount := LCount + 1000000;
    end;
    if LF <> 2.0 then
      LCount := LCount + 100000000;
    end;
  end;
  return LCount;
end;

// Division and remainder by constants at every width and signedness
routine Divide();
var
  LA: int64;
  LB: int64;
  LC: int32;
  LU: uint32;
  LW: uint64;
begin
  LA := Pass(1000003);
  LB := Pass(-1000003);
  println("div64 {} {} {} {} {} {} {} {}", LA div 7, LA mod 7, LB div 7, LB mod 7,
    LA div (-10), LB mod (-10), LB div 16, LB mod 16);
  LC := int32(Pass(-123457));
  println("div32 {} {} {} {} {}", LC div 3, LC mod 3, LC div 1000, LC div (-7), LC mod (-7));
  LU := uint32(Pass(4000000000));
  println("divu32 {} {} {} {}", LU div 7, LU mod 7, LU div 1000000, LU mod 10);
  // 2^64 - 1
  LW := uint64(Pass(0x7FFFFFFFFFFFFFFF)) * 2 + 1;
  println("divu64 {} {} {} {}", LW div 3, LW mod 10, LW div 0x7FFFFFFFFFFFFFFF,
    LW div 1000000007);
end;

// Multiplies by 3 / 5 / 9 (lea), 8 (shl), 7 (an immediate) and a constant no immediate holds
routine Multiply();
var
  LM: int64;
begin
  LM := Pass(12345);
  println("mul {} {} {} {} {} {}", LM * 3, LM * 5, LM * 9, LM * 8, LM * 7, LM * 0x100000001);
end;

// The larger of AA and AB (a diamond)
routine Pick(const AA: int64; const AB: int64): int64;
var
  LR: int64;
begin
  if AA > AB then
    LR := AA;
  else
    LR := AB;
  end;
  return LR;
end;

// AX held to ALow..AHigh (two triangles)
routine Clamp(const AX: int64; const ALow: int64; const AHigh: int64): int64;
var
  LR: int64;
begin
  LR := AX;
  if AX < ALow then
    LR := ALow;
  end;
  if LR > AHigh then
    LR := AHigh;
  end;
  return LR;
end;

// 1 from 10 on, else 0 (a setcc diamond)
routine Flag(const AA: int64): int64;
var
  LR: int64;
begin
  if AA >= 10 then
    LR := 1;
  else
    LR := 0;
  end;
  return LR;
end;

// 0 at 7, else 1 (a setcc of the inverse)
routine Other(const AA: int64): int64;
var
  LR: int64;
begin
  if AA = 7 then
    LR := 0;
  else
    LR := 1;
  end;
  return LR;
end;

// The diamonds over 0..AN (AN is 20)
routine Selects(const AN: int64): int64;
var
  LI: int64;
  LTotal: int64;
begin
  LTotal := 0;
  for LI := 0 to AN do
    LTotal := LTotal + Pick(LI, 10) + Clamp(LI, 3, 15) + Flag(LI) * 1000 + Other(LI) * 100000;
  end;
  return LTotal;
end;

begin
  SetHeapReport(false);
  GOne := 1;
  println("addresses {}", Addresses(Pass(5)));
  Immediates(Pass(1000));
  GSmall := 42;
  GBig := 0xFFFFFFFF00;
  GZero := 0;
  println("stores {} {} {}", GSmall * Pass(1), GBig * Pass(1), GZero * Pass(1));
  println("compares {}", Compares(Pass(10)));
  Divide();
  Multiply();
  println("select {}", Selects(Pass(20)));
end.
