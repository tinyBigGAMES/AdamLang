-------------------------------------------------------------------------------
  opt_schedule.adam - x86_64 list scheduling in blocks (PLAN-ADAM M6 O21):
  independent chains of slow ops (multiply, divide, shifts) the scheduler
  interleaves at fast; a store and a load of one place through two var
  parameters (one variable passed as both: their order kept); stores and
  loads of a local and a global array at indexes known only at run time;
  twelve values live at once (past ADAM_X64_SCHEDULE_PRESSURE); compares
  read by setcc / cmov between other flag writers; a division by a value
  checked first (the check stays ahead of it); float64 chains with a
  division. Pass's call into the runtime keeps every value unknown to every
  pass (GOne is set at run time). Every level runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | chains 600
  | alias 24
  | arrays 2484
  | pressure 1058
  | flags 100294
  | divide 4738
  | floats 6640625
@@end
*/

module exe opt_schedule;

var
  GOne: int64;
  GShared: int64;
  GTable: array[0..7] of int64;

// AN times GOne (1), after a real call into the runtime
routine Pass(const AN: int64): int64;
begin
  FlushOutput();
  return AN * GOne;
end;

// The sum over 1..AN (AN is 10) of LI * 7 + LI div 3 - LI mod 5 + LI shl 2:
// 385 + 15 - 20 + 220
routine Chains(const AN: int64): int64;
var
  LI: int64;
  LTotal: int64;
begin
  LTotal := 0;
  for LI := 1 to AN do
    LTotal := LTotal + LI * 7 + LI div 3 - LI mod 5 + (LI shl 2);
  end;
  return LTotal;
end;

// AX + 1, then AY * 2, then their sum: with one variable (5) as both, 6, 12, 24
routine Bump(var AX: int64; var AY: int64): int64;
begin
  AX := AX + 1;
  AY := AY * 2;
  return AX + AY;
end;

// Each round stores LA[LI], loads it back at LJ (= LI, known at run time), stores
// GTable[LJ] from it and loads GTable[LI]: the sum of 3 * (LI + 100) over 0..7 (AN is 8)
routine Arrays(const AN: int64): int64;
var
  LA: array[0..7] of int64;
  LI: int64;
  LJ: int64;
  LTotal: int64;
begin
  for LI := 0 to 7 do
    LA[LI] := 0;
    GTable[LI] := 0;
  end;
  LTotal := 0;
  for LI := 0 to AN - 1 do
    LJ := LI * GOne;
    LA[LI] := LI + 100;
    LTotal := LTotal + LA[LJ];
    GTable[LJ] := LA[LJ] * 2;
    LTotal := LTotal + GTable[LI];
  end;
  return LTotal;
end;

// Twelve values (AN is 1: 3, 5 .. 25) live at once: the pairs' products (890) and the
// sum (168)
routine Pressure(const AN: int64): int64;
var
  LV1: int64;
  LV2: int64;
  LV3: int64;
  LV4: int64;
  LV5: int64;
  LV6: int64;
  LV7: int64;
  LV8: int64;
  LV9: int64;
  LV10: int64;
  LV11: int64;
  LV12: int64;
begin
  LV1 := AN * 3;
  LV2 := AN * 5;
  LV3 := AN * 7;
  LV4 := AN * 9;
  LV5 := AN * 11;
  LV6 := AN * 13;
  LV7 := AN * 15;
  LV8 := AN * 17;
  LV9 := AN * 19;
  LV10 := AN * 21;
  LV11 := AN * 23;
  LV12 := AN * 25;
  return LV1 * LV12 + LV2 * LV11 + LV3 * LV10 + LV4 * LV9 + LV5 * LV8 + LV6 * LV7 + LV1 +
    LV2 + LV3 + LV4 + LV5 + LV6 + LV7 + LV8 + LV9 + LV10 + LV11 + LV12;
end;

// Over 0..AN - 1 (AN is 20) LX = LI * 7 mod 11: how many are above 5 (9), the largest
// (10) and three times their sum (294), as 9 * 10000 + 10 * 1000 + 294
routine Flags(const AN: int64): int64;
var
  LI: int64;
  LX: int64;
  LMax: int64;
  LSum: int64;
  LCount: int64;
  LBig: bool;
begin
  LMax := -1;
  LSum := 0;
  LCount := 0;
  for LI := 0 to AN - 1 do
    LX := (LI * 7) mod 11;
    LBig := LX > 5;
    if LX > LMax then
      LMax := LX;
    end;
    LSum := LSum + LX * 3;
    if LBig then
      LCount := LCount + 1;
    end;
  end;
  return LCount * 10000 + LMax * 1000 + LSum;
end;

// Over 0..AN (AN is 12) LD = LI mod 7: 1000 div LD + 1000 mod LD where LD is not 0
// (1 .. 5 twice, 6 once: 2 * 2284 + 170)
routine Divide(const AN: int64): int64;
var
  LI: int64;
  LD: int64;
  LTotal: int64;
begin
  LTotal := 0;
  for LI := 0 to AN do
    LD := LI mod 7;
    if LD <> 0 then
      LTotal := LTotal + 1000 div LD + 1000 mod LD;
    end;
  end;
  return LTotal;
end;

// AN is 10: 15, 3.75, 6.25, 39.0625, 3.90625 + 56.25, plus 6.25: 66.40625 (exact)
routine Floats(const AN: int64): float64;
var
  LA: float64;
  LB: float64;
  LC: float64;
  LD: float64;
  LE: float64;
  LF: float64;
begin
  LA := float64(AN);
  LB := LA * 1.5;
  LC := LB / 4.0;
  LD := LA - LC;
  LE := LD * LD;
  LF := LE / LA + LB * LC;
  return LF + LD;
end;

begin
  SetHeapReport(false);
  GOne := 1;
  GShared := Pass(5);
  println("chains {}", Chains(Pass(10)));
  println("alias {}", Bump(GShared, GShared));
  println("arrays {}", Arrays(Pass(8)));
  println("pressure {}", Pressure(Pass(1)));
  println("flags {}", Flags(Pass(20)));
  println("divide {}", Divide(Pass(12)));
  println("floats {}", int64(Floats(Pass(10)) * 100000.0));
end.
