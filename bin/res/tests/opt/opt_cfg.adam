-------------------------------------------------------------------------------
  opt_cfg.adam - simplifycfg (PLAN-ADAM M6 O7): at safe, fast and small the
  blocks nothing runs into go (a branch sccp folded, its arm and a whole
  guard behind it, the guard's scope with them), a block only one other
  jumps to merges into it (Dead and Unguarded end as one block with no
  successor), a bare jump is bypassed (the branch goes straight on),
  and a guard that runs keeps its scope, renumbered to the blocks left, a
  catching one its resume block. Debug keeps every block. Every level runs
  with the same output. The routines are public so each keeps its own body
  (inline and ipo would otherwise fold them into the block and drop them)
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  ir debug| branch i9, b2, b3
  ir debug| scope b14 .. b14 finally f<NUM>
  ir debug| scope b18 .. b20 finally f<NUM>
  ir debug| b20:
  ir debug| jump b21
  ir safe| scope b18 .. b19 finally f<NUM>
  ir safe| branch i112, b19, b21
  ir safe| scope b24 .. b26 catch f<NUM> at b27
  ir safe| b27:
  ir safe| b1 rpo 0 preds - succs - idom - df - ipdom exit loop -
  ir safe| b11 rpo 0 preds - succs - idom - df - ipdom exit loop -
  ir safe| b18 rpo 1 preds b17 succs b19 b21 idom b17 df - ipdom b21 loop -
  | dead 6
  | pick 12 4
  | sum 45
  | unguarded 7
  | finally 6
  | guarded 6
  | finally -1
  | guarded -1
  | caught 2 3
@@end
*/

module exe opt_cfg;

// A branch on a known false: sccp makes it a jump, simplifycfg drops the arm and merges
// the rest into one block
public routine Dead(const AX: int64): int64;
var
  LFlag: bool;
begin
  LFlag := false;
  if LFlag then
    return AX * 7;
  end;
  return AX + 1;
end;

// An arm that only joins: the branch goes straight to the join, whose phi takes the
// value from the branching block
public routine Pick(const AFlag: bool; const AX: int64): int64;
var
  LR: int64;
begin
  LR := AX;
  if AFlag then
    LR := AX * 3;
  end;
  return LR;
end;

// A loop: the block before its header merges into the entry, the header's phis name it
public routine Sum(const ACount: int64): int64;
var
  LSum: int64;
  LI: int64;
begin
  LSum := 0;
  LI := 0;
  while LI < ACount do
    LSum := LSum + LI;
    LI := LI + 1;
  end;
  return LSum;
end;

// A guard nothing runs into: its blocks go, and its scope with them
public routine Unguarded(const AX: int64): int64;
var
  LFlag: bool;
begin
  LFlag := false;
  if LFlag then
    guard
      println("never");
    finally
      println("never finally");
    end;
  end;
  return AX + 2;
end;

// A guard that runs: its scope renumbered to the blocks left, its finally run
public routine Guarded(const AX: int64): int64;
var
  LR: int64;
begin
  LR := AX;
  guard
    if AX > 0 then
      LR := AX * 2;
    end;
  finally
    println("finally {}", LR);
  end;
  return LR;
end;

// A catching guard: its resume block kept
public routine Caught(const AX: int64): int64;
var
  LR: int64;
begin
  LR := 1;
  guard
    if AX > 2 then
      raise("big");
    end;
    LR := 2;
  except
    LR := 3;
  end;
  return LR;
end;

begin
  SetHeapReport(false);
  println("dead {}", Dead(5));
  println("pick {} {}", Pick(true, 4), Pick(false, 4));
  println("sum {}", Sum(10));
  println("unguarded {}", Unguarded(5));
  println("guarded {}", Guarded(3));
  println("guarded {}", Guarded(-1));
  println("caught {} {}", Caught(1), Caught(5));
end.
