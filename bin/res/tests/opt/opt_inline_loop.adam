  opt_inline_loop.adam - inline's cost model and loops (PLAN-ADAM SU2.8 e5):
  a callee with a loop, past safe's budget and within fast's, stays a call
  at fast (its call is paid once per run of the loop), read from adam build
  --emit-ir's .ir: NameStart keeps its own function (f1) at every level,
  each of its two callers calling it. Built at every level and run
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  ir| analysis f1 _ZN15opt_inline_loopL9NameStartEN4adam6stringE
  | name b.txt
  | folder 5
@@end
*/

module exe opt_inline_loop;

import System.SysUtils;

// The start of a path's last name: a loop scanning back for a separator
func NameStart(const APath: string): int64;
var
  LIndex: int64;
  LChar: char;
begin
  LIndex := len(APath);
  while LIndex > 0 do
    LChar := APath[LIndex - 1];
    if (LChar = '/') or (LChar = '\\') or (LChar = ':') then
      leave;
    end;
    LIndex := LIndex - 1;
  end;
  return LIndex;
end;

// The path's last name (NameStart's first caller)
func FileNameOf(const APath: string): string;
var
  LStart: int64;
begin
  LStart := NameStart(APath);
  return Substring(APath, LStart, len(APath) - LStart);
end;

// The length of the path's folder part (NameStart's second caller)
func FolderLength(const APath: string): int64;
begin
  return NameStart(APath);
end;

begin
  SetHeapReport(false);
  println("name {}", FileNameOf("c:/a/b.txt"));
  println("folder {}", FolderLength("c:/a/b.txt"));
end.
