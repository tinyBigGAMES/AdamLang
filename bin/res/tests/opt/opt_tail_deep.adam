-------------------------------------------------------------------------------
  opt_tail_deep.adam - tailrec and tailcall at depth (PLAN-ADAM M6 O15):
  ten million turns of a self call (a value returned, none returned), of a
  call through a routine value and of one with stack arguments, more than
  any stack holds as calls: at safe, fast and small the self calls loop
  and the others leave as jumps, so each finishes in one frame. Debug
  keeps every call a call (DESIGN sec 5), so the row names no debug
*******************************************************************************/

/*
@@test
  kind run
  levels safe fast small
  exitcode 0
  | sum 50000005000000
  | count 10000000
  | bounce 10000000
  | six 54321
@@end
*/

module exe opt_tail_deep;

type
  Step = routine(const AN: int64; const AAcc: int64): int64;
  SixStep = routine(const AN: int64; const AB: int64; const AC: int64; const AD: int64;
    const AE: int64; const AF: int64): int64;

var
  GStep: Step;
  GSix: SixStep;
  GCount: int64;

routine SumTo(const AN: int64; const AAcc: int64): int64;
begin
  if AN = 0 then
    return AAcc;
  end;
  return SumTo(AN - 1, AAcc + AN);
end;

routine CountDown(const AN: int64);
begin
  if AN = 0 then
    return;
  end;
  GCount := GCount + 1;
  CountDown(AN - 1);
end;

routine Bounce(const AN: int64; const AAcc: int64): int64;
begin
  if AN = 0 then
    return AAcc;
  end;
  return GStep(AN - 1, AAcc + 1);
end;

// Ten million rotations of five places: a multiple of five, back where they started
routine Six(const AN: int64; const AB: int64; const AC: int64; const AD: int64;
  const AE: int64; const AF: int64): int64;
begin
  if AN = 0 then
    return AB + AC * 10 + AD * 100 + AE * 1000 + AF * 10000;
  end;
  return GSix(AN - 1, AC, AD, AE, AF, AB);
end;

begin
  SetHeapReport(false);
  GStep := Bounce;
  GSix := Six;
  println("sum {}", SumTo(10000000, 0));
  CountDown(10000000);
  println("count {}", GCount);
  println("bounce {}", Bounce(10000000, 0));
  println("six {}", Six(10000000, 1, 2, 3, 4, 5));
end.
