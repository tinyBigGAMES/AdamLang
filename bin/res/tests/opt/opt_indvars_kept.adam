-------------------------------------------------------------------------------
  opt_indvars_kept.adam - indvars keeps what its ranges do not prove (PLAN-
  ADAM M6 O12): LI runs 0..4 over an array of 0..3, so the index check
  stays at debug and safe and raises code 14 at LI = 4, caught
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe
  exitcode 0
  | 14 index 4 is out of bounds 0..3
@@end
*/

module exe opt_indvars_kept;

// LI reaches 4, one past LA's last index: the check stays
func Over(): int64;
var
  LA: array[0..3] of int64;
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 0 to 4 do
    LA[LI] := LI;
    LTotal := LTotal + LA[LI];
  end;
  return LTotal;
end;

begin
  SetHeapReport(false);
  guard
    println("over {}", Over());
  except
    println("{} {}", exccode(), excmsg());
  end;
end.
