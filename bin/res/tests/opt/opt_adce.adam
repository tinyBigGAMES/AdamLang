-------------------------------------------------------------------------------
  opt_adce.adam - adce (PLAN-ADAM M6 O6): at safe, fast and small a value
  nothing the program does needs is dropped (an unused product, a loop's
  second value carried by phis round the back edge, both arms of a branch
  only a dead value depends on, the branch made a jump past them (then
  simplifycfg merges the join into the entry: one block), a
  division by a constant that cannot fault), while what the program does
  stays: a division by a value that may be zero, a call whose result is
  unused, a loop that does nothing visible (it might not end). Debug keeps
  everything. Every level runs with the same output. The routines are
  public so each keeps its own body (inline and ipo would otherwise fold
  them into the block and drop them); Noisy is still inlined into Calls,
  whose print call stays
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  ir debug| i12 = mul int64 i10, i11
  ir debug| i101 = sdiv int64 i99, i100
  ir safe| i18 = add int64 i1, i4
  ir safe| ret i18
  ir safe| i349 = phi int64 [i32, b2], [i45, b4]
  ir safe| i351 = phi int64 [i36, b2], [i53, b4]
  ir safe| i41 = cmp bool slt i351, i20
  ir safe| ret i349
  ir safe| i61 = param int64 #1
  ir safe| i81 = add int64 i61, i80
  ir safe| i97 = sdiv int64 i83, i86
  ir safe| ret i83
  ir safe| call f8(i386, i387)
  ir safe| ret i116
  ir safe| branch i129, b15, b16
  ir safe| ret i136
  ir safe| b6 rpo 0 preds - succs - idom - df - ipdom exit loop -
  | unused 7
  | carried 45
  | arms 4 4
  | divide 9
  | noisy
  | calls 2
  | spin 7
@@end
*/

module exe opt_adce;

// A value nothing uses: computed at debug, gone at safe
public func Unused(const AX: int64; const AY: int64): int64;
var
  LDead: int64;
begin
  LDead := AX * AY + 3;
  return AX + AY;
end;

// A loop's second value, carried round the back edge, that nothing uses after it: its
// phi cycle goes, the sum's stays
public func Carried(const ACount: int64): int64;
var
  LSum: int64;
  LDead: int64;
  LI: int64;
begin
  LSum := 0;
  LDead := 1;
  LI := 0;
  while LI < ACount do
    LSum := LSum + LI;
    LDead := LDead * 3;
    LI := LI + 1;
  end;
  return LSum;
end;

// A branch only a dead value depends on: both arms go, the branch becomes a jump to the
// join
public func Arms(const AFlag: bool; const AX: int64): int64;
var
  LDead: int64;
begin
  if AFlag then
    LDead := AX * 2;
  else
    LDead := AX * 5;
  end;
  return AX + 1;
end;

// A division by a value that may be zero stays though its result is unused (it faults
// where the debug one does); one by a constant that cannot fault goes
public func Divide(const AX: int64; const AY: int64): int64;
var
  LKept: int64;
  LDead: int64;
begin
  LKept := AX div AY;
  LDead := AX div 4;
  return AX;
end;

public func Noisy(): int64;
begin
  println("noisy");
  return 1;
end;

// A call whose result is unused stays (it prints)
public func Calls(): int64;
var
  LDead: int64;
begin
  LDead := Noisy();
  return 2;
end;

// A loop that does nothing the program sees stays (it might not end)
public func Spin(const ACount: int64): int64;
var
  LI: int64;
begin
  LI := 0;
  while LI < ACount do
    LI := LI + 1;
  end;
  return 7;
end;

begin
  SetHeapReport(false);
  println("unused {}", Unused(3, 4));
  println("carried {}", Carried(10));
  println("arms {} {}", Arms(true, 3), Arms(false, 3));
  println("divide {}", Divide(9, 2));
  println("calls {}", Calls());
  println("spin {}", Spin(1000));
end.
