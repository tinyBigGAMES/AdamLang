-------------------------------------------------------------------------------
  opt_ipo_place.adam - unused results never drop a result place (found
  2026-11-22: safe / small voided Walk's and Span's results, since their
  calls' values go unused while every caller reads the record from the
  place it passed; the ret then lost the place the ABI part loads from).
  Walk gives back a record that fits a register (its pieces), Span one that
  does not (the caller's place); both recurse, so no level inlines them.
  One call of each reads the record, one drops it. Every level runs with
  the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | walk 6 9
  | span 4 10 16
  | log 12
@@end
*/

module exe opt_ipo_place;

type
  Pair = record
    A: int32;
    B: int32;
  end;

  Triple = record
    X: int64;
    Y: int64;
    Z: int64;
  end;

var
  GLog: int64;
  GP: Pair;
  GT: Triple;

// A record in a register (8 bytes): its pieces come back in rax
routine Walk(const AN: int32): Pair;
var
  LP: Pair;
begin
  GLog := GLog + 1;
  if AN = 0 then
    LP.A := 0;
    LP.B := 3;
    return LP;
  end;
  LP := Walk(AN - 1);
  LP.A := LP.A + 2;
  LP.B := LP.B + 2;
  return LP;
end;

// A record past a register (24 bytes): the caller's place
routine Span(const AN: int64): Triple;
var
  LT: Triple;
begin
  GLog := GLog + 1;
  if AN = 0 then
    LT.X := 1;
    LT.Y := 1;
    LT.Z := 1;
    return LT;
  end;
  LT := Span(AN - 1);
  LT.X := LT.X + 1;
  LT.Y := LT.Y + 3;
  LT.Z := LT.Z + 5;
  return LT;
end;

begin
  SetHeapReport(false);
  GLog := 0;
  GP := Walk(3);
  println("walk {} {}", GP.A, GP.B);
  GT := Span(3);
  println("span {} {} {}", GT.X, GT.Y, GT.Z);
  Walk(1);
  Span(1);
  println("log {}", GLog);
end.
