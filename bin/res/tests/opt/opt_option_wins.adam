-------------------------------------------------------------------------------
  opt_option_wins.adam - adam's -opt wins over the main module's @optimize
  (PLAN-ADAM M6 O1, BNF's @optimize, as -t over @target): this file says
  fast, its build says -opt small, so it is a small build (its defines and
  its exe's bin cell); the @optimize it overrides is still checked (clean)
*******************************************************************************/

/*
@@test
  kind cli
  args "--no-banner" "build" "--quiet" "<DIR>/opt_option_wins.adam" "-o" "." "-opt" "small" "-r"
  exitcode 0
  | mode release_small
  | folder release_small
@@end
*/

module exe opt_option_wins;

@optimize fast;

import System.SysUtils;

var
  GMode: string;

begin
  GMode := "none";
@ifdef DEBUG
  GMode := "debug";
@endif
@ifdef RELEASE_SAFE
  GMode := "release_safe";
@endif
@ifdef RELEASE_FAST
  GMode := "release_fast";
@endif
@ifdef RELEASE_SMALL
  GMode := "release_small";
@endif
  println("mode {}", GMode);
  println("folder {}", ExtractFileName(ExtractFileDir(paramstr(0))));
end.
