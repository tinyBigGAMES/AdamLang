-------------------------------------------------------------------------------
  opt_ipo.adam - the interprocedural passes (PLAN-ADAM M6 O17): a parameter
  every call passes the same constant becomes that constant (Depth's step,
  its self calls included; Report's and Guarded's quiet flag, which then
  folds the call of Loud and the guard away, so Loud and the guard's
  funclet are removed), a parameter nothing reads leaves the signature and
  every call (Depth's last), a result no call uses goes (Note), and at
  small two equal bodies merge (Left and Right). Every level runs with the
  same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | depth 12 15
  | merged 139 139
  | report 1
  | report 2
  | guarded 11
  | log 11 trace 0
@@end
*/

module exe opt_ipo;

var
  GLog: int64;
  GTrace: int64;

// Every call passes AStep 3 (its own included); AUnused is never read
routine Depth(const AN: int64; const AStep: int64; const AUnused: int64): int64;
begin
  if AN = 0 then
    return 0;
  end;
  return AStep + Depth(AN - 1, 3, 7);
end;

// Two equal bodies: one function at small
routine Left(const AN: int64): int64;
var
  LR: int64;
  LI: int64;
begin
  LR := 1;
  for LI := 1 to AN do
    LR := LR * 3 + LI;
  end;
  return LR;
end;

routine Right(const AN: int64): int64;
var
  LR: int64;
  LI: int64;
begin
  LR := 1;
  for LI := 1 to AN do
    LR := LR * 3 + LI;
  end;
  return LR;
end;

// Called only where AQuiet is false: never, once Report's flag is a constant
routine Loud(const AN: int64);
begin
  println("loud {}", AN);
end;

// Every call passes AQuiet true
routine Report(const AN: int64; const AQuiet: bool);
begin
  if not AQuiet then
    Loud(AN);
  end;
  println("report {}", AN);
end;

// Every call passes AQuiet true: the guard and its funclet go
routine Guarded(const AN: int64; const AQuiet: bool): int64;
begin
  if not AQuiet then
    guard
      GLog := GLog + AN;
    finally
      GTrace := GTrace + 1;
    end;
  end;
  return AN + 1;
end;

// No call uses its result
routine Note(const AN: int64): int64;
begin
  GLog := GLog + AN;
  return GLog * 2;
end;

begin
  SetHeapReport(false);
  GLog := 0;
  GTrace := 0;
  println("depth {} {}", Depth(4, 3, 1), Depth(5, 3, 2));
  println("merged {} {}", Left(4), Right(4));
  Report(1, true);
  Report(2, true);
  println("guarded {}", Guarded(10, true));
  Note(5);
  Note(6);
  println("log {} trace {}", GLog, GTrace);
end.
