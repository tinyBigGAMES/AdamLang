-------------------------------------------------------------------------------
  opt_inline.adam - inline (PLAN-ADAM M6 O14): at safe, fast and small a
  call whose callee is worth it takes the callee's blocks: a one-block
  leaf, a callee with two returns (its value a phi at the tail), one with
  a slot passed by var (the slot moves to the caller's entry), each
  called in a loop too; a guard's finally (its funclet copied, reaching
  the callee's slot) and a caught raise (the catching scope's resume block
  moved); a recursive call stays a call; another unit's routine
  (System.SysUtils' IsPowerOfTwo) inlined from its body copy. Every level
  runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | square 49
  | larger 9
  | larger 9
  | slot 42
  | turns 44
  | guarded 10
  | caught -1
  | caught 8
  | fact 120
  | power 64
  | power not 12
  | calls 15
@@end
*/

module exe opt_inline;

import System.SysUtils;

var
  GCalls: int64;

// One block, one return
func Square(const AX: int64): int64;
begin
  return AX * AX;
end;

// Two returns: the inlined call's value is a phi of both
func Larger(const AA: int64; const AB: int64): int64;
begin
  if AA > AB then
    return AA;
  end;
  return AB;
end;

// Writes through its var parameter (and counts the calls)
func Bump(var AValue: int64);
begin
  AValue := AValue + 1;
  GCalls := GCalls + 1;
end;

// LValue's address goes to Bump: a slot, moved to the caller's entry when inlined
func WithSlot(const AX: int64): int64;
var
  LValue: int64;
begin
  LValue := AX;
  Bump(LValue);
  return LValue;
end;

// Both callees inlined in a loop: every turn reaches the copies
func Turns(const AN: int64): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 1 to AN do
    LTotal := LTotal + WithSlot(LI) + Square(LI);
  end;
  return LTotal;
end;

// A guard's finally: its funclet reads LValue, the callee's slot, in the caller's frame
func Guarded(const AX: int64): int64;
var
  LValue: int64;
begin
  LValue := AX;
  guard
    LValue := LValue * 2;
  finally
    GCalls := GCalls + LValue;
  end;
  return LValue;
end;

// A caught raise: the catching scope and its resume block move with the copies
func Caught(const AX: int64): int64;
var
  LResult: int64;
begin
  LResult := 0;
  guard
    if AX < 0 then
      raise("negative");
    end;
    LResult := AX;
  except
    LResult := -1;
  end;
  return LResult;
end;

// Calls itself: that call stays a call
func Fact(const AN: int64): int64;
begin
  if AN <= 1 then
    return 1;
  end;
  return AN * Fact(AN - 1);
end;

begin
  SetHeapReport(false);
  println("square {}", Square(7));
  println("larger {}", Larger(3, 9));
  println("larger {}", Larger(9, 3));
  println("slot {}", WithSlot(41));
  println("turns {}", Turns(4));
  println("guarded {}", Guarded(5));
  println("caught {}", Caught(-3));
  println("caught {}", Caught(8));
  println("fact {}", Fact(5));
  if IsPowerOfTwo(64) then
    println("power 64");
  end;
  if not IsPowerOfTwo(12) then
    println("power not 12");
  end;
  println("calls {}", GCalls);
end.
