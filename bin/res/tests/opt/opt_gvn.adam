-------------------------------------------------------------------------------
  opt_gvn.adam - gvn (PLAN-ADAM M6 O9): at safe, fast and small a value
  computed again where an identical one dominates it goes (a commutative
  op's operands in either order, across blocks), a load with no write
  between goes (one after a store is never merged with the one before it:
  it reads the stored value), a pure routine's second call with the same
  arguments goes (one that prints keeps both prints), and an index check
  repeated under an identical one is dropped. Debug keeps every op. Every
  level runs with the same output. The routines are public so each keeps
  its own body (inline and ipo would otherwise fold them into the block
  and drop them); Square and Noisy are still inlined into their callers
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  ir debug| i12 = mul int64 i10, i11
  ir debug| i45 = load int64 i44
  ir debug| i78 = call int64 f5(i77)
  ir debug| i132 = mul int64 i122, i131
  ir safe| i13 = add int64 i9, i9
  ir safe| i34 = add int64 i26, i26
  ir safe| i46 = add int64 i43, i43
  ir safe| i63 = add int64 i55, i57
  ir safe| i79 = add int64 i418, i418
  ir safe| call f<NUM>(i558, i95)
  ir safe| call f<NUM>(i568, i95)
  ir safe| branch i111, b13, b12
  ir safe| unreachable
  ir safe| i120 = load int64 i119
  ir safe| i137 = add int64 i120, i136
  | twice 24
  | across 30 15
  | loads 14
  | stored 12 5
  | pure 72
  | noisy 2
  | noisy 2
  | 4
  | check 30
@@end
*/

module exe opt_gvn;

var
  GValue: int64;
  GTable: array[0..3] of int64;
  GStored: int64;

// x * y and y * x: one mul
public routine Twice(const AX: int64; const AY: int64): int64;
begin
  return (AX * AY) + (AY * AX);
end;

// AX * 3 in the entry and again in a block it dominates: one mul
public routine Across(const AFlag: bool; const AX: int64): int64;
var
  LR: int64;
begin
  LR := AX * 3;
  if AFlag then
    LR := LR + AX * 3;
  end;
  return LR;
end;

// AV read twice with no write between: one load
public routine Loads(var AV: int64): int64;
begin
  return AV + AV;
end;

// AV read, written, read: both loads stay
public routine Stored(var AV: int64): int64;
var
  LA: int64;
begin
  LA := AV;
  AV := 5;
  return LA + AV;
end;

// Pure: computes from its argument alone
public routine Square(const AX: int64): int64;
begin
  return AX * AX;
end;

public routine PureTwice(const AX: int64): int64;
begin
  return Square(AX) + Square(AX);
end;

// Not pure: it prints, so both calls stay
public routine Noisy(const AX: int64): int64;
begin
  println("noisy {}", AX);
  return AX;
end;

public routine NoisyTwice(const AX: int64): int64;
begin
  return Noisy(AX) + Noisy(AX);
end;

// GTable[AI] twice: one index check, one load
public routine Check(const AI: int64): int64;
begin
  return GTable[AI] + GTable[AI] * 2;
end;

begin
  SetHeapReport(false);
  println("twice {}", Twice(3, 4));
  println("across {} {}", Across(true, 5), Across(false, 5));
  GValue := 7;
  println("loads {}", Loads(GValue));
  GValue := 7;
  GStored := Stored(GValue);
  println("stored {} {}", GStored, GValue);
  println("pure {}", PureTwice(6));
  println("{}", NoisyTwice(2));
  GTable[2] := 10;
  println("check {}", Check(2));
end.
