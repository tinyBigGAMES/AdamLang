-------------------------------------------------------------------------------
  opt_mem2reg.adam - mem2reg (PLAN-ADAM M6 O3): at safe, fast and small a
  local only loaded and stored whole becomes SSA values (a diamond's join
  phi, a loop header's phis round the back edge, a float through a phi, a
  value kept across a caught raise), while a slot whose address escapes (a
  var argument), one stored inside a catching scope and one a finally
  funclet reaches stay in memory; debug keeps every slot. Every level runs
  with the same output. The routines are public so each keeps its own body
  (inline and ipo would otherwise fold them into the block and drop them)
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  ir safe| i<NUM> = phi int32 [i<NUM>, b3], [i<NUM>, b2]
  ir safe| ret i<NUM>
  ir safe| i<NUM> = phi int32 [i<NUM>, b5], [i<NUM>, b7]
  ir safe| i<NUM> = phi int32 [i<NUM>, b5], [i<NUM>, b7]
  ir safe| i<NUM> = phi float64 [i<NUM>, b9], [i<NUM>, b10]
  ir safe| i<NUM> = slot ptr 4 align 4
  ir safe| call f4(i<NUM>, i<NUM>)
  ir safe| i<NUM> = slot ptr 4 align 4
  ir safe| ret i<NUM>
  ir safe| i<NUM> = slot ptr 4 align 4
  | pick 1 2
  | sum 45
  | mix 2.5 1.5
  | escape 8
  | caught 3
  | kept 7
  | final 6
@@end
*/

module exe opt_mem2reg;

// A diamond: the join's phi takes each arm's store
public routine Pick(const AFlag: bool): int32;
var
  LValue: int32;
begin
  if AFlag then
    LValue := 1;
  else
    LValue := 2;
  end;
  return LValue;
end;

// A loop: the header's phis carry the sum and the counter round the back edge
public routine Sum(const ACount: int32): int32;
var
  LSum: int32;
  LI: int32;
begin
  LSum := 0;
  LI := 0;
  while LI < ACount do
    LSum := LSum + LI;
    LI := LI + 1;
  end;
  return LSum;
end;

// A float through a phi: stored before the test, again in one arm
public routine Mix(const AFlag: bool): float64;
var
  LValue: float64;
begin
  LValue := 1.5;
  if AFlag then
    LValue := LValue + 1.0;
  end;
  return LValue;
end;

// Recursive with its work after the call (no tail call, so tailrec cannot make it a loop):
// a call of it stays a call wherever its body is inlined (the inliner never copies a
// function into itself), so the var argument's address really escapes
public routine Bump(var AValue: int32; const ASteps: int32);
begin
  if ASteps > 0 then
    Bump(AValue, ASteps - 1);
    AValue := AValue + 1;
  end;
end;

// The slot's address escapes (a var argument): it stays in memory
public routine Escape(): int32;
var
  LValue: int32;
begin
  LValue := 7;
  Bump(LValue, 1);
  return LValue;
end;

// Stored inside a catching scope: it stays a slot, so the raise resumes with what was
// stored before it
public routine Caught(): int32;
var
  LStep: int32;
begin
  LStep := 1;
  guard
    LStep := 3;
    raise("stop");
  except
  end;
  return LStep;
end;

// Stored before the catching scope alone: promoted, the value reaches past the resume
public routine Kept(): int32;
var
  LValue: int32;
begin
  LValue := 7;
  guard
    raise("stop");
  except
  end;
  return LValue;
end;

// A finally funclet reaches the slot (it runs in this frame): it stays in memory
public routine Final(): int32;
var
  LCount: int32;
begin
  LCount := 0;
  guard
    LCount := 5;
  finally
    LCount := LCount + 1;
  end;
  return LCount;
end;

begin
  SetHeapReport(false);
  println("pick {} {}", Pick(true), Pick(false));
  println("sum {}", Sum(10));
  println("mix {} {}", Mix(true), Mix(false));
  println("escape {}", Escape());
  println("caught {}", Caught());
  println("kept {}", Kept());
  println("final {}", Final());
end.
