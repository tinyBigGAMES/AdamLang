-------------------------------------------------------------------------------
  opt_mem2reg.adam - mem2reg (PLAN-ADAM M6 O3): at safe, fast and small a
  local only loaded and stored whole becomes SSA values (a diamond's join
  phi, a loop header's phis round the back edge, a float through a phi, a
  value kept across a caught raise), while a slot whose address escapes (a
  var argument), one stored inside a catching scope and one a finally
  funclet reaches stay in memory; debug keeps every slot. Every level runs
  with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  ir safe| i221 = phi int32 [i11, b3], [i9, b2]
  ir safe| ret i221
  ir safe| i222 = phi int32 [i26, b5], [i37, b7]
  ir safe| i223 = phi int32 [i28, b5], [i41, b7]
  ir safe| i224 = phi float64 [i52, b9], [i58, b10]
  ir safe| i73 = slot ptr 4 align 4
  ir safe| i81 = slot ptr 4 align 4
  ir safe| ret i98
  ir safe| i107 = slot ptr 4 align 4
  | pick 1 2
  | sum 45
  | mix 2.5 1.5
  | escape 8
  | caught 3
  | kept 7
  | final 6
@@end
*/

module exe opt_mem2reg;

// A diamond: the join's phi takes each arm's store
routine Pick(const AFlag: bool): int32;
var
  LValue: int32;
begin
  if AFlag then
    LValue := 1;
  else
    LValue := 2;
  end;
  return LValue;
end;

// A loop: the header's phis carry the sum and the counter round the back edge
routine Sum(const ACount: int32): int32;
var
  LSum: int32;
  LI: int32;
begin
  LSum := 0;
  LI := 0;
  while LI < ACount do
    LSum := LSum + LI;
    LI := LI + 1;
  end;
  return LSum;
end;

// A float through a phi: stored before the test, again in one arm
routine Mix(const AFlag: bool): float64;
var
  LValue: float64;
begin
  LValue := 1.5;
  if AFlag then
    LValue := LValue + 1.0;
  end;
  return LValue;
end;

routine Bump(var AValue: int32);
begin
  AValue := AValue + 1;
end;

// The slot's address escapes (a var argument): it stays in memory
routine Escape(): int32;
var
  LValue: int32;
begin
  LValue := 7;
  Bump(LValue);
  return LValue;
end;

// Stored inside a catching scope: it stays a slot, so the raise resumes with what was
// stored before it
routine Caught(): int32;
var
  LStep: int32;
begin
  LStep := 1;
  guard
    LStep := 3;
    raise("stop");
  except
  end;
  return LStep;
end;

// Stored before the catching scope alone: promoted, the value reaches past the resume
routine Kept(): int32;
var
  LValue: int32;
begin
  LValue := 7;
  guard
    raise("stop");
  except
  end;
  return LValue;
end;

// A finally funclet reaches the slot (it runs in this frame): it stays in memory
routine Final(): int32;
var
  LCount: int32;
begin
  LCount := 0;
  guard
    LCount := 5;
  finally
    LCount := LCount + 1;
  end;
  return LCount;
end;

begin
  SetHeapReport(false);
  println("pick {} {}", Pick(true), Pick(false));
  println("sum {}", Sum(10));
  println("mix {} {}", Mix(true), Mix(false));
  println("escape {}", Escape());
  println("caught {}", Caught());
  println("kept {}", Kept());
  println("final {}", Final());
end.
