-------------------------------------------------------------------------------
  opt_loop_guard.adam - loops inside a guard (Adam.Opt.Loops' loop form;
  found with PLAN-ADAM T2): every block of a protected scope has its unwind
  edge, so a loop there gets its preheader and settles at every level (one
  never settled: each step split off another preheader). A counted while, a
  while true left by leave, a nested pair, and a raise out of a loop caught
  by the guard around it. Built at every level and run.
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | count 10
  | left 7
  | nested 450
  | caught 5 boom
@@end
*/

module exe opt_loop_guard;

var
  GSum: int64;

// AN rounds of a counted while inside a guard
routine Count(const AN: int64): int64;
var
  LK: int64;
begin
  LK := 0;
  guard
    while LK < AN do
      LK := LK + 1;
    end;
  except
    LK := -1;
  end;
  return LK;
end;

// A while true inside a guard, left at AStop
routine Left(const AStop: int64): int64;
var
  LK: int64;
begin
  LK := 0;
  guard
    while true do
      if LK = AStop then
        leave;
      end;
      LK := LK + 1;
    end;
  except
    LK := -1;
  end;
  return LK;
end;

// AN x AN rounds of a nested pair inside a guard, adding the inner index
routine Nested(const AN: int64): int64;
var
  LK: int64;
  LJ: int64;
begin
  GSum := 0;
  LK := 0;
  guard
    while LK < AN do
      LJ := 0;
      while LJ < AN do
        GSum := GSum + LJ;
        LJ := LJ + 1;
      end;
      LK := LK + 1;
    end;
  except
    GSum := -1;
  end;
  return GSum;
end;

// A loop that raises at AAt, the guard around it catching the raise
routine Caught(const AAt: int64);
var
  LK: int64;
begin
  LK := 0;
  guard
    while LK < 100 do
      if LK = AAt then
        raise("boom");
      end;
      LK := LK + 1;
    end;
  except
    println("caught {} {}", LK, excmsg());
  end;
end;

begin
  SetHeapReport(false);
  println("count {}", Count(10));
  println("left {}", Left(7));
  println("nested {}", Nested(10));
  Caught(5);
end.
