  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  opt_ir_analysis.adam - the optimizer's analyses (PLAN-ADAM M6 O2), read
  from adam build --emit-ir's .ir (adamtest's ir lines): a diamond (the join
  post-dominates the test and is in both arms' frontiers), a loop nest (the
  inner loop at depth 2 inside the outer one), a loop on a constant, a
  value's uses, and the program entry's catching scope (an unwind edge into
  the block a caught exception resumes at, the entry still an exit). Built
  at every level and run: the blocks keep their shape at each but the
  constant loop's (sccp folds its branch from safe on, simplifycfg drops
  the block after it and merges the body into the header), the slot's uses are
  debug's alone (mem2reg promotes it at the others)
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  ir| analysis f1 _ZN15opt_ir_analysisL4PickEb
  ir| b2 rpo 2 preds b1 succs b4 idom b1 df b4 ipdom b4 loop -
  ir| b3 rpo 1 preds b1 succs b4 idom b1 df b4 ipdom b4 loop -
  ir| b4 rpo 3 preds b2 b3 succs - idom b1 df - ipdom exit loop -
  ir debug| uses i4: i6 i10 i12 i15
  ir| analysis f2 _ZN15opt_ir_analysisL4GridEii
  ir| b6 rpo 1 preds b5 b11 succs b7 b8 idom b5 df b6 ipdom b8 loop L0
  ir| b9 rpo 4 preds b7 b10 succs b10 b11 idom b7 df b6 b9 ipdom b11 loop L1
  ir| b11 rpo 5 preds b9 succs b6 idom b9 df b6 ipdom b6 loop L0
  ir| loop L0 header b6 parent - depth 1 blocks b6 b7 b9 b10 b11
  ir| loop L1 header b9 parent L0 depth 2 blocks b9 b10
  ir| analysis f3 _ZN15opt_ir_analysisL4SpinEv
  ir debug| b13 rpo 1 preds b12 b14 succs b14 b15 idom b12 df b13 ipdom b15 loop L0
  ir safe| b13 rpo 1 preds b12 b13 succs b13 idom b12 df b13 ipdom - loop L0
  ir safe| loop L0 header b13 parent - depth 1 blocks b13
  ir| program parts
  ir| b1 rpo 0 preds - succs b3 unwind b3 idom - df - ipdom exit loop -
  ir| b3 rpo 1 preds b1 succs - idom b1 df - ipdom exit loop -
  | pick 1 2
  | grid 12
@@end
*/

module exe opt_ir_analysis;

// A diamond: the join post-dominates the test, and each arm's frontier is the join
routine Pick(const AFlag: bool): int32;
var
  LValue: int32;
begin
  if AFlag then
    LValue := 1;
  else
    LValue := 2;
  end;
  return LValue;
end;

// A loop nest: the inner loop's header inside the outer loop's body (depth 2)
routine Grid(const ARows: int32; const ACols: int32): int32;
var
  LSum: int32;
  LI: int32;
  LJ: int32;
begin
  LSum := 0;
  LI := 0;
  while LI < ARows do
    LJ := 0;
    while LJ < ACols do
      LSum := LSum + 1;
      LJ := LJ + 1;
    end;
    LI := LI + 1;
  end;
  return LSum;
end;

// A loop on a constant (never called): at debug its exit edge stays, so the loop block's
// ipdom is the block after the loop; from safe on sccp folds the constant branch, the loop
// has no exit (no ipdom); simplifycfg drops the block after it and merges the body into
// the header, one block jumping to itself
routine Spin();
var
  LTurns: int64;
begin
  LTurns := 0;
  while true do
    LTurns := LTurns + 1;
  end;
end;

begin
  SetHeapReport(false);
  println("pick {} {}", Pick(true), Pick(false));
  println("grid {}", Grid(3, 4));
end.
