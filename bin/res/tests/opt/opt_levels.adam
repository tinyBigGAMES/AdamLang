-------------------------------------------------------------------------------
  opt_levels.adam - the four optimization levels (PLAN-ADAM M6 O1): built and
  run at each (adamtest's levels line: adam build -opt <level>), each build
  lands in its own cell (<triple>/debug, release_safe, release_fast,
  release_small) and defines its level's build-mode symbols (DEBUG, or RELEASE
  and RELEASE_<LEVEL>, BNF sec 9): the mode the defines name is the cell's.
  No level prints a [Heap] line (turned off: a release build has none)
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | cell <CELL>
  | defines <CELL>
  | one mode true
@@end
*/

module exe opt_levels;

import System.SysUtils;

var
  GMode: string;
  GModes: int32;
  GRelease: bool;
  GDir: string;
  GTriple: string;

begin
  SetHeapReport(false);
  GMode := "";
  GModes := 0;
@ifdef DEBUG
  GMode := "debug";
  GModes := GModes + 1;
@endif
@ifdef RELEASE_SAFE
  GMode := "release_safe";
  GModes := GModes + 1;
@endif
@ifdef RELEASE_FAST
  GMode := "release_fast";
  GModes := GModes + 1;
@endif
@ifdef RELEASE_SMALL
  GMode := "release_small";
  GModes := GModes + 1;
@endif
  GRelease := false;
@ifdef RELEASE
  GRelease := true;
@endif
  // the exe is <output>\bin\<triple>\<mode>\opt_levels.exe
  GDir := ExtractFileDir(paramstr(0));
  GTriple := ExtractFileName(ExtractFileDir(GDir));
  println("cell {}/{}", GTriple, ExtractFileName(GDir));
  println("defines {}/{}", GTriple, GMode);
  // exactly one mode, and RELEASE in every mode but debug
  println("one mode {}", (GModes = 1) and (GRelease = (GMode <> "debug")));
end.
