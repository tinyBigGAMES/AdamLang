-------------------------------------------------------------------------------
  opt_kept_facts.adam - the optimizer keeps a function's analysis over a pass
  that changed nothing (Adam.Opt.Pipeline, SU2.8): straight-line code most
  passes leave as it is, a loop with a branch, nested loops and a catching
  guard (unwind edges) each go through passes that change them and passes
  that do not; the compiler's own debug build checks every kept analysis
  against a fresh one (a difference raises, naming the pass). Every level
  runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | mix 22
  | odd 25
  | grid 60
  | caught 3 2
@@end
*/

module exe opt_kept_facts;

// Straight-line: once its values are promoted most passes find nothing to change
public func Mix(const AA: int64; const AB: int64): int64;
begin
  return (AA * 7) + (AB xor 5);
end;

// A loop with a branch: the loop passes change it, the passes after them keep its facts
public func SumOdd(const AN: int64): int64;
var
  LTotal: int64;
  LI: int64;
begin
  LTotal := 0;
  for LI := 1 to AN do
    if (LI mod 2) = 1 then
      LTotal := LTotal + LI;
    end;
  end;
  return LTotal;
end;

// Nested loops: an inner loop's facts inside an outer one's
public func Grid(const AW: int64; const AH: int64): int64;
var
  LTotal: int64;
  LX: int64;
  LY: int64;
begin
  LTotal := 0;
  for LX := 1 to AW do
    for LY := 1 to AH do
      LTotal := LTotal + LX * LY;
    end;
  end;
  return LTotal;
end;

// A catching guard: the unwind edge to its resume block among the kept facts
public func Caught(const AX: int64): int64;
var
  LR: int64;
begin
  LR := 1;
  guard
    if AX > 2 then
      raise("big");
    end;
    LR := 2;
  except
    LR := 3;
  end;
  return LR;
end;

begin
  SetHeapReport(false);
  println("mix {}", Mix(3, 4));
  println("odd {}", SumOdd(9));
  println("grid {}", Grid(3, 4));
  println("caught {} {}", Caught(5), Caught(1));
end.
