-------------------------------------------------------------------------------
  opt_index_kept.adam - the index checks hold at debug and safe (DESIGN sec
  5, PLAN-ADAM M6 O1): a static array's index past its bounds and a dynamic
  array's past its length each raise code 14 at both levels, caught
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe
  exitcode 0
  | 14 index 4 is out of bounds 0..3
  | 14 index 2 is out of bounds 0..1
@@end
*/

module exe opt_index_kept;

// AValue itself, so no index below is a constant
func Idx(const AValue: int32): int32;
begin
  return AValue;
end;

var
  GStatic: array[0..3] of int32;
  GDynamic: array of int32;
  GValue: int32;

begin
  SetHeapReport(false);
  guard
    GValue := GStatic[Idx(4)];
  except
    println("{} {}", exccode(), excmsg());
  end;
  setlength(GDynamic, 2);
  guard
    GValue := GDynamic[Idx(2)];
  except
    println("{} {}", exccode(), excmsg());
  end;
  setlength(GDynamic, 0);
end.
