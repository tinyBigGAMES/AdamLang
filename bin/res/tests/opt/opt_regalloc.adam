-------------------------------------------------------------------------------
  opt_regalloc.adam - the register allocator (PLAN-ADAM M6 O18): eighteen
  values live across calls (callee-saved registers, then spill slots), two
  pairs carried round a loop (the second a swap: its phi copies a cycle the
  parallel move breaks), a sum and its counter live across a call in a
  loop, floats live across calls (vector values kept in their slots around
  them), division (rax / rdx) and shifts by a variable count (rcx) beside
  live values, and a value live into a catching guard's except (kept in its
  slot). Bump's call into the runtime stays a real call at every level, its
  result unknown to every pass (GOne is set at run time). Every level runs
  with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | pressure 2109
  | swap 89 144 5 3
  | across 4950
  | floats ok
  | divide 3 2 -2 -4
  | shift 40 5
  | caught 9 boom
@@end
*/

module exe opt_regalloc;

var
  GOne: int64;

// AN times GOne (1), after a real call into the runtime
routine Bump(const AN: int64): int64;
begin
  FlushOutput();
  return AN * GOne;
end;

// Eighteen values live across the calls that make them: the sum of K * (AN + K)
routine Pressure(const AN: int64): int64;
var
  LA: int64;
  LB: int64;
  LC: int64;
  LD: int64;
  LE: int64;
  LF: int64;
  LG: int64;
  LH: int64;
  LI: int64;
  LJ: int64;
  LK: int64;
  LL: int64;
  LM: int64;
  LN: int64;
  LO: int64;
  LP: int64;
  LQ: int64;
  LR: int64;
begin
  LA := Bump(AN + 1);
  LB := Bump(AN + 2);
  LC := Bump(AN + 3);
  LD := Bump(AN + 4);
  LE := Bump(AN + 5);
  LF := Bump(AN + 6);
  LG := Bump(AN + 7);
  LH := Bump(AN + 8);
  LI := Bump(AN + 9);
  LJ := Bump(AN + 10);
  LK := Bump(AN + 11);
  LL := Bump(AN + 12);
  LM := Bump(AN + 13);
  LN := Bump(AN + 14);
  LO := Bump(AN + 15);
  LP := Bump(AN + 16);
  LQ := Bump(AN + 17);
  LR := Bump(AN + 18);
  return LA + 2 * LB + 3 * LC + 4 * LD + 5 * LE + 6 * LF + 7 * LG + 8 * LH + 9 * LI +
    10 * LJ + 11 * LK + 12 * LL + 13 * LM + 14 * LN + 15 * LO + 16 * LP + 17 * LQ + 18 * LR;
end;

// A Fibonacci pair and a swapped pair round AN turns of a loop
routine Swap(const AN: int64);
var
  LA: int64;
  LB: int64;
  LX: int64;
  LY: int64;
  LT: int64;
  LI: int64;
begin
  LA := 0;
  LB := 1;
  LX := 3;
  LY := 5;
  for LI := 1 to AN do
    LT := LA + LB;
    LA := LB;
    LB := LT;
    LT := LX;
    LX := LY;
    LY := LT;
  end;
  println("swap {} {} {} {}", LA, LB, LX, LY);
end;

// 0 + 1 + .. + AN, each term through a call
routine Across(const AN: int64): int64;
var
  LSum: int64;
  LI: int64;
begin
  LSum := 0;
  for LI := 0 to Bump(AN) do
    LSum := LSum + Bump(LI);
  end;
  return LSum;
end;

// AF * AG + AF + AG with a call between the steps: 7.125 for 1.5 and 2.25
routine Floats(const AF: float64; const AG: float64): bool;
var
  LH: float64;
begin
  LH := AF * AG;
  Bump(1);
  LH := LH + AF;
  Bump(2);
  return LH + AG = 7.125;
end;

// Division and shifts beside values live across them
routine Arith();
var
  LA: int64;
  LB: int64;
  LC: int64;
  LD: int64;
  LE: int64;
begin
  LA := Bump(17);
  LB := Bump(5);
  LC := Bump(-14);
  println("divide {} {} {} {}", LA div LB, LA mod LB, LC div LB, LC mod LB);
  LD := Bump(5);
  LE := Bump(3);
  println("shift {} {}", LD shl LE, (LD shl LE) shr LE);
end;

// LKeep and LTotal read in the except, after the raise
routine Caught(const AN: int64);
var
  LKeep: int64;
  LTotal: int64;
begin
  LKeep := Bump(AN);
  LTotal := 0;
  guard
    LTotal := LKeep + Bump(1);
    raise("boom");
  except
    println("caught {} {}", LKeep + LTotal, excmsg());
  end;
end;

begin
  SetHeapReport(false);
  GOne := 1;
  println("pressure {}", Pressure(0));
  Swap(Bump(11));
  println("across {}", Across(99));
  if Floats(1.5, 2.25) then
    println("floats ok");
  else
    println("floats bad");
  end;
  Arith();
  Caught(4);
end.
