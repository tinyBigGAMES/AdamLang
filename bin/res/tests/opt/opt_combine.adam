-------------------------------------------------------------------------------
  opt_combine.adam - combine (PLAN-ADAM M6 O8): at safe, fast and small
  identities give their operand back (and a phi of two copies is that
  value), x * 2^k is a shl, a signed division by 2^k is shifts rounded
  toward zero, an unsigned one a shr / an and, neg / not pairs cancel, a
  constant goes right (a compare's predicate swapped), adds of constants
  meet, a convert chain that ends where it started goes, an unsigned x > 0
  is x <> 0. Debug keeps every op. Every level runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  ir debug| i38 = mul int64 i36, i37
  ir debug| i45 = sdiv int64 i43, i44
  ir debug| i80 = udiv uint64 i78, i79
  ir safe| ret i1
  ir safe| i23 = const int64 0
  ir safe| i38 = shl int64 i33, i490
  ir safe| i495 = add int64 i40, i494
  ir safe| i45 = sar int64 i495, i496
  ir safe| i52 = sub int64 i47, i503
  ir safe| i80 = shr uint64 i75, i523
  ir safe| i87 = and uint64 i82, i524
  ir safe| i89 = param int64 #0
  ir safe| ret i89
  ir safe| i112 = add int64 i103, i106
  ir safe| i123 = sub int64 i114, i117
  ir safe| i130 = cmp bool sgt i125, i128
  ir safe| i525 = const int64 7
  ir safe| i526 = const int64 -5
  ir safe| ret i152
  ir safe| i164 = convert int64 i159
  ir safe| i176 = cmp bool sge i166, i169
  ir safe| ret i185
  ir safe| i207 = cmp bool ne i202, i206
  ir safe| ret i220
  | ident 9
  | zeros 0
  | mulpow 40 -24
  | div64 -1 -3 1 3 -3
  | div32 -1 -1 2 1
  | udiv 6 4
  | negs 4 4 7 1
  | swap 0 1
  | reassoc 8 -4
  | chain -5 200
  | invert 0 1
  | pick 6 6
  | uzero 0 1
  | self 1
@@end
*/

module exe opt_combine;

// Identities: every op gives AX back
routine Ident(const AX: int64): int64;
begin
  return ((((AX + 0) * 1 - 0) | 0) xor 0) & -1;
end;

// x - x, x xor x, x * 0: zero
routine Zeros(const AX: int64): int64;
begin
  return (AX - AX) + (AX xor AX) + AX * 0;
end;

// x * 8: a shl
routine MulPow(const AX: int64): int64;
begin
  return AX * 8;
end;

// A signed division and remainder by 2^k at 64 bits, rounded toward zero
routine Div64(const AX: int64): int64;
begin
  return AX div 4;
end;

routine Rem64(const AX: int64): int64;
begin
  return AX mod 4;
end;

routine Half64(const AX: int64): int64;
begin
  return AX div 2;
end;

// The same at 32 bits
routine Div32(const AX: int32): int32;
begin
  return AX div 8;
end;

routine Rem32(const AX: int32): int32;
begin
  return AX mod 8;
end;

// An unsigned division and remainder by 16: a shr and an and
routine UDivPow(const AX: uint64): uint64;
begin
  return AX div 16u;
end;

routine URemPow(const AX: uint64): uint64;
begin
  return AX mod 16u;
end;

// neg / not pairs, x - neg y, x + neg y
routine NegNeg(const AX: int64): int64;
begin
  return -(-AX);
end;

routine NotNot(const AX: int64): int64;
begin
  return ~(~AX);
end;

routine SubNeg(const AX: int64; const AY: int64): int64;
begin
  return AX - (-AY);
end;

routine AddNeg(const AX: int64; const AY: int64): int64;
begin
  return AX + (-AY);
end;

// A constant on the left of a compare: it goes right, the predicate swapped
routine Swap(const AX: int64): int64;
begin
  if 10 < AX then
    return 1;
  end;
  return 0;
end;

// (x + 3) + 4 is x + 7; x - 5 is x + -5
routine Reassoc(const AX: int64): int64;
begin
  return (AX + 3) + 4;
end;

routine SubConst(const AX: int64): int64;
begin
  return AX - 5;
end;

// int32 -> int64 -> int32 is the value; uint8 -> int32 -> int64 one convert
routine Chain(const AX: int32): int32;
begin
  return int32(int64(AX));
end;

routine Widen(const AX: uint8): int64;
begin
  return int64(int32(AX));
end;

// not of a compare: the inverse compare
routine Invert(const AX: int64; const AY: int64): int64;
begin
  if not (AX < AY) then
    return 1;
  end;
  return 0;
end;

// A phi of AX and AX + 0: AX itself
routine Pick(const AFlag: bool; const AX: int64): int64;
var
  LR: int64;
begin
  LR := AX;
  if AFlag then
    LR := AX + 0;
  end;
  return LR;
end;

// An unsigned x > 0: x <> 0
routine UZero(const AX: uint64): int64;
begin
  if AX > 0u then
    return 1;
  end;
  return 0;
end;

// A value against itself
routine SelfLe(const AX: int64): int64;
begin
  if AX <= AX then
    return 1;
  end;
  return 0;
end;

begin
  SetHeapReport(false);
  println("ident {}", Ident(9));
  println("zeros {}", Zeros(9));
  println("mulpow {} {}", MulPow(5), MulPow(-3));
  println("div64 {} {} {} {} {}", Div64(-7), Rem64(-7), Div64(7), Rem64(7), Half64(-7));
  println("div32 {} {} {} {}", Div32(-9), Rem32(-9), Div32(17), Rem32(17));
  println("udiv {} {}", UDivPow(100u), URemPow(100u));
  println("negs {} {} {} {}", NegNeg(4), NotNot(4), SubNeg(4, 3), AddNeg(4, 3));
  println("swap {} {}", Swap(7), Swap(11));
  println("reassoc {} {}", Reassoc(1), SubConst(1));
  println("chain {} {}", Chain(-5), Widen(200));
  println("invert {} {}", Invert(2, 3), Invert(3, 2));
  println("pick {} {}", Pick(true, 6), Pick(false, 6));
  println("uzero {} {}", UZero(0u), UZero(5u));
  println("self {}", SelfLe(4));
end.
