-------------------------------------------------------------------------------
  opt_err_place.adam - @optimize keeps @target's place (BNF 2026-11-11, PLAN-
  ADAM M6 O1): the build-mode defines come from it, so inside a conditional
  branch it is CD0013, after the first conditional directive CD0014
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe opt_err_place;

@ifdef ADAM
@optimize fast; // ERROR CD0013@1: @optimize stands outside any conditional branch
@endif
@optimize small; // ERROR CD0014@1: @optimize comes before the first conditional directive

begin
end.
