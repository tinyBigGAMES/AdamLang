-------------------------------------------------------------------------------
  opt_index_dropped.adam - fast and small carry no index check (DESIGN sec 5,
  zig's ReleaseFast; his WHAT 2026-11-11, PLAN-ADAM M6 O1): a static array's
  index one past its bounds reads on into the next field of its record (its
  layout is the language's: the field right after the array), with no raise
*******************************************************************************/

/*
@@test
  kind run
  levels fast small
  exitcode 0
  | past 77
@@end
*/

module exe opt_index_dropped;

type
  Pair = record
    Items: array[0..3] of int32;
    After: int32;
  end;

// AValue itself, so no index below is a constant
routine Idx(const AValue: int32): int32;
begin
  return AValue;
end;

var
  GPair: Pair;

begin
  GPair.After := 77;
  println("past {}", GPair.Items[Idx(4)]);
end.
