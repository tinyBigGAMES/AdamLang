-------------------------------------------------------------------------------
  opt_tail.adam - tailrec and tailcall (PLAN-ADAM M6 O15): at safe, fast
  and small a call of the routine itself at a path's end loops (a value
  returned, none returned, through a return block two paths share); a
  call of another routine at a path's end leaves as a jump: through a
  routine value, with stack arguments that fit (six parameters, rotated,
  so a wrong stack place shows in the digits), one whose stack arguments
  do not fit stays a call, a local passed by var keeps its call (the
  callee reads the caller's frame), a call inside a guard keeps its call
  and the one after it jumps; a runtime routine called last. Every level
  runs with the same output (opt_tail_deep proves the loops and jumps at
  a depth no stack holds)
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | sum 500500
  | count 1000
  | fact 3628800
  | bounce 1000
  | six 21543
  | wide 54321
  | escapes 30
  | guarded 7
  | calls 1
@@end
*/

module exe opt_tail;

type
  Step = routine(const AN: int64; const AAcc: int64): int64;
  SixStep = routine(const AN: int64; const AB: int64; const AC: int64; const AD: int64;
    const AE: int64; const AF: int64): int64;
  Peek = routine(var AValue: int64): int64;

var
  GStep: Step;
  GSix: SixStep;
  GPeek: Peek;
  GCount: int64;
  GCalls: int64;

// A value returned: the call right before its ret
routine SumTo(const AN: int64; const AAcc: int64): int64;
begin
  if AN = 0 then
    return AAcc;
  end;
  return SumTo(AN - 1, AAcc + AN);
end;

// None returned: the call before the function's end
routine CountDown(const AN: int64);
begin
  if AN = 0 then
    return;
  end;
  GCount := GCount + 1;
  CountDown(AN - 1);
end;

// Two paths sharing a return block
routine FactAcc(const AN: int64; const AAcc: int64): int64;
var
  LNext: int64;
begin
  if AN <= 1 then
    return AAcc;
  end;
  LNext := AAcc * AN;
  return FactAcc(AN - 1, LNext);
end;

// Through a routine value (calli): a jump at safe / fast / small
routine Bounce(const AN: int64; const AAcc: int64): int64;
begin
  if AN = 0 then
    return AAcc;
  end;
  return GStep(AN - 1, AAcc + 1);
end;

// Six parameters, two of them on the stack: the callee's fit this function's own incoming
// area; each turn rotates them, the end weighs each place by a digit
routine Six(const AN: int64; const AB: int64; const AC: int64; const AD: int64;
  const AE: int64; const AF: int64): int64;
begin
  if AN = 0 then
    return AB + AC * 10 + AD * 100 + AE * 1000 + AF * 10000;
  end;
  return GSix(AN - 1, AC, AD, AE, AF, AB);
end;

// Two parameters: the six-parameter callee's stack arguments do not fit, a call stays
routine Wide(const AA: int64; const AB: int64): int64;
begin
  return GSix(0, AA, AB, 3, 4, 5);
end;

routine PeekIt(var AValue: int64): int64;
begin
  return AValue;
end;

// LLocal's address goes to the callee: the call stays a call
routine Escapes(const AN: int64): int64;
var
  LLocal: int64;
begin
  LLocal := AN * 3;
  return GPeek(LLocal);
end;

// The call inside the guard stays a call (its finally runs after it), the one after the
// guard jumps
routine Guarded(const AN: int64): int64;
var
  LResult: int64;
begin
  LResult := 0;
  guard
    LResult := Bounce(AN, 0);
  finally
    GCalls := GCalls + 1;
  end;
  return Bounce(LResult, 0);
end;

// A runtime routine called last
routine Finish();
begin
  FlushOutput();
end;

begin
  SetHeapReport(false);
  GStep := Bounce;
  GSix := Six;
  GPeek := PeekIt;
  println("sum {}", SumTo(1000, 0));
  CountDown(1000);
  println("count {}", GCount);
  println("fact {}", FactAcc(10, 1));
  println("bounce {}", Bounce(1000, 0));
  println("six {}", Six(2, 1, 2, 3, 4, 5));
  println("wide {}", Wide(1, 2));
  println("escapes {}", Escapes(10));
  println("guarded {}", Guarded(7));
  println("calls {}", GCalls);
  Finish();
end.
