-------------------------------------------------------------------------------
  opt_sroa.adam - SROA (PLAN-ADAM M6 O4): at safe, fast and small a record
  local reached only at constant offsets is split into one slot per field,
  which mem2reg then makes values (its fields stored and read, a field
  through a diamond, the zeroed start's fill as each field's zero); a
  record passed by var stays whole; a static array indexed by constants is
  split by the second sroa, once sccp (O5) has made its index arithmetic a
  constant Offset, and its elements read as the values stored. Every level
  runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  ir safe| i271 = phi int32 [i23, b2], [i31, b3]
  ir safe| i133 = add int32 i45, i293
  ir safe| i164 = slot ptr 16 align 8
  | point 3 4
  | pick 10 2
  | trio 6
  | zero 0 5
  | passed 8
@@end
*/

module exe opt_sroa;

type
  TPoint = record
    X: int32;
    Y: int64;
  end;

// A record's fields stored and read at constant offsets
routine Point(): int64;
var
  LP: TPoint;
begin
  LP.X := 3;
  LP.Y := 4;
  return LP.X * 10 + LP.Y;
end;

// A field through a diamond: its own phi once split
routine Pick(const AFlag: bool): int64;
var
  LP: TPoint;
begin
  LP.X := 1;
  LP.Y := 2;
  if AFlag then
    LP.X := 10;
  end;
  return LP.X * 100 + LP.Y;
end;

// A static array's elements by constant index: sccp folds the index arithmetic to constant
// Offsets, then the second sroa splits it and mem2reg promotes the elements
routine Trio(): int32;
var
  LA: array[0..2] of int32;
begin
  LA[0] := 1;
  LA[1] := 2;
  LA[2] := 3;
  return LA[0] + LA[1] + LA[2];
end;

// A record local starts zeroed whole (its fields' zeros once split), then one field set
routine Zero(): int64;
var
  LP: TPoint;
begin
  LP.Y := 5;
  return LP.X * 10 + LP.Y;
end;

routine Grow(var AP: TPoint);
begin
  AP.Y := AP.Y + 1;
end;

// Passed by var: its address escapes, it stays whole
routine Passed(): int64;
var
  LP: TPoint;
begin
  LP.X := 0;
  LP.Y := 7;
  Grow(LP);
  return LP.Y;
end;

begin
  SetHeapReport(false);
  println("point {} {}", Point() div 10, Point() mod 10);
  println("pick {} {}", Pick(true) div 100, Pick(true) mod 100);
  println("trio {}", Trio());
  println("zero {} {}", Zero() div 10, Zero() mod 10);
  println("passed {}", Passed());
end.
