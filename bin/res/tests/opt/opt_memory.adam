-------------------------------------------------------------------------------
  opt_memory.adam - memory (PLAN-ADAM M6 O10): at safe, fast and small a
  load right after a store to the same place takes the stored value (two
  var parameters that may be one place keep the second store in between),
  a store written over before anything reads it goes, a small record copy
  becomes scalar moves, a local record's field written and then copied
  over goes, and a store inside a guard that the except reads after a
  raise stays. Every level runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | forward 12
  | alias 2
  | overwrite 2
  | copy 3 4
  | dead 17
  | caught 2
@@end
*/

module exe opt_memory;

type
  Pair = record
    A: int64;
    B: int64;
  end;

var
  GPair: Pair;
  GSrc: Pair;
  GDst: Pair;
  GValue: int64;
  GCount: int64;

// The two fields read back right after they are stored: both loads forwarded
func Forward(var AP: Pair): int64;
begin
  AP.A := 5;
  AP.B := 7;
  return AP.A + AP.B;
end;

// AX and AY may be one place: the load of AX after the store to AY stays
func Alias(var AX: int64; var AY: int64): int64;
begin
  AX := 1;
  AY := 2;
  return AX;
end;

// The first store is written over before anything reads it
func Overwrite();
begin
  GCount := 1;
  GCount := 2;
end;

// A 16-byte record copy: two 8-byte moves
func CopyPair(var ADst: Pair; const ASrc: Pair);
begin
  ADst := ASrc;
end;

// LP.A's first store is copied over before it is read: it goes
func Dead(const ASrc: Pair): int64;
var
  LP: Pair;
begin
  LP.A := 1;
  LP := ASrc;
  LP.B := LP.B + 10;
  return LP.A + LP.B;
end;

// Raises when AX is 0
func Boom(const AX: int64);
begin
  if AX = 0 then
    raise("boom");
  end;
end;

// LP.A := 2 is read by the except after Boom raises: it stays
func Caught(): int64;
var
  LP: Pair;
  LR: int64;
begin
  LP.A := 1;
  LP.B := 0;
  LR := 0;
  guard
    LP.A := 2;
    Boom(LP.B);
    LP.A := 3;
    LR := LP.A;
  except
    LR := LP.A;
  end;
  return LR;
end;

begin
  SetHeapReport(false);
  println("forward {}", Forward(GPair));
  println("alias {}", Alias(GValue, GValue));
  Overwrite();
  println("overwrite {}", GCount);
  GSrc.A := 3;
  GSrc.B := 4;
  CopyPair(GDst, GSrc);
  println("copy {} {}", GDst.A, GDst.B);
  println("dead {}", Dead(GSrc));
  println("caught {}", Caught());
end.
