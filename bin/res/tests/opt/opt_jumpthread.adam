-------------------------------------------------------------------------------
  opt_jumpthread.adam - jumpthread (PLAN-ADAM M6 O16): at safe, fast and
  small a predecessor whose constant decides a block's branch on a phi
  jumps straight to the arm it picks: a short-circuit and / or (the bool
  phi itself), a mode set on two paths and compared with a constant once,
  the compare folded exact to the machine (int32 signed below zero, a
  uint64 past the sign bit unsigned, a float64); a mode also used after
  the branch keeps its block (no thread), a loop condition's and (its
  header never threads). Every level runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | range 6
  | either 2
  | mode 3 80
  | kept 202 107
  | signed 1 2
  | unsigned 1 2
  | float 1 2
  | walk 7 5
@@end
*/

module exe opt_jumpthread;

// A short-circuit and: its bool phi decides the branch
func InRange(const AN: int64): int64;
begin
  if (AN > 3) and (AN < 10) then
    return 1;
  end;
  return 0;
end;

// A short-circuit or
func Either(const AN: int64): int64;
begin
  if (AN = 2) or (AN = 9) then
    return 1;
  end;
  return 0;
end;

// A mode set on two paths, compared with a constant once
func Mode(const AN: int64): int64;
var
  LMode: int64;
begin
  if AN > 5 then
    LMode := 7;
  else
    LMode := 2;
  end;
  if LMode = 7 then
    return AN * 10;
  end;
  return AN;
end;

// The mode used after the branch too: its block stays (no thread)
func ModeKept(const AN: int64): int64;
var
  LMode: int64;
  LOut: int64;
begin
  if AN > 5 then
    LMode := 7;
  else
    LMode := 2;
  end;
  if LMode = 7 then
    LOut := 100;
  else
    LOut := 200;
  end;
  return LOut + LMode;
end;

// A signed int32 below zero: a signed order reads it signed
func SignedPick(const AN: int64): int64;
var
  LValue: int32;
begin
  if AN > 0 then
    LValue := -5;
  else
    LValue := 5;
  end;
  if LValue < 0 then
    return 1;
  end;
  return 2;
end;

// A uint64 past the sign bit: an unsigned order reads its bits
func UnsignedPick(const AN: int64): int64;
var
  LValue: uint64;
begin
  if AN > 0 then
    LValue := 9223372036854775808u;
  else
    LValue := 1u;
  end;
  if LValue > 2u then
    return 1;
  end;
  return 2;
end;

// A float64 compared as a float
func FloatPick(const AN: int64): int64;
var
  LValue: float64;
begin
  if AN > 0 then
    LValue := 1.5;
  else
    LValue := -2.5;
  end;
  if LValue > 0.0 then
    return 1;
  end;
  return 2;
end;

// A loop condition's and: the header never threads, its exit edge may
func Walk(const AN: int64): int64;
var
  LI: int64;
begin
  LI := 0;
  while (LI < AN) and (LI <> 7) do
    LI := LI + 1;
  end;
  return LI;
end;

// The short-circuit rows over 0..14, printed
func Counts();
var
  LRange: int64;
  LEither: int64;
  LI: int64;
begin
  LRange := 0;
  LEither := 0;
  for LI := 0 to 14 do
    LRange := LRange + InRange(LI);
    LEither := LEither + Either(LI);
  end;
  println("range {}", LRange);
  println("either {}", LEither);
end;

begin
  SetHeapReport(false);
  Counts();
  println("mode {} {}", Mode(3), Mode(8));
  println("kept {} {}", ModeKept(3), ModeKept(8));
  println("signed {} {}", SignedPick(1), SignedPick(-1));
  println("unsigned {} {}", UnsignedPick(1), UnsignedPick(0));
  println("float {} {}", FloatPick(1), FloatPick(0));
  println("walk {} {}", Walk(20), Walk(5));
end.
