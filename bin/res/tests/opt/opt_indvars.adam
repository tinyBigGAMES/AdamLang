-------------------------------------------------------------------------------
  opt_indvars.adam - indvars (PLAN-ADAM M6 O12): at safe, fast and small a
  loop's induction variables are read: an index check their range proves
  goes (an int64 iterator up and down, an int32 one widened), an element
  address is a pointer stepped each turn (8-byte and 24-byte elements), a
  while loop's variable after it is the limit it left on (a not-equal test,
  a less test from a constant start), and a variable stepping with the for
  iterator is that iterator plus a difference (a loop that never runs
  keeps its start). Every level runs with the same output
*******************************************************************************/

/*
@@test
  kind run
  levels debug safe fast small
  exitcode 0
  | squares 285
  | narrow 45
  | spread 36
  | leaves 408
  | below 825
  | paired 3313
  | empty 10
@@end
*/

module exe opt_indvars;

type
  Point = record
    X: int64;
    Y: int64;
    Z: int64;
  end;

// LI runs 0..9 in both loops: each index check is proven, each address stepped by 8
func Squares(): int64;
var
  LA: array[0..9] of int64;
  LTotal: int64;
  LI: int64;
begin
  for LI := 0 to 9 do
    LA[LI] := LI * LI;
  end;
  LTotal := 0;
  for LI := 9 downto 0 do
    LTotal := LTotal + LA[LI];
  end;
  return LTotal;
end;

// An int32 iterator over 1..5, widened to index: its range keeps the widening exact
func Narrow(): int32;
var
  LA: array[1..5] of int32;
  LTotal: int32;
  LI: int32;
begin
  for LI := 1 to 5 do
    LA[LI] := LI * 3;
  end;
  LTotal := 0;
  for LI := 1 to 5 do
    LTotal := LTotal + LA[LI];
  end;
  return LTotal;
end;

// A Point is 24 bytes: each field's address steps by 24 a turn
func Spread(): int64;
var
  LP: array[0..3] of Point;
  LTotal: int64;
  LI: int64;
begin
  for LI := 0 to 3 do
    LP[LI].X := LI;
    LP[LI].Y := LI * 2;
    LP[LI].Z := LI * 3;
  end;
  LTotal := 0;
  for LI := 0 to 3 do
    LTotal := LTotal + LP[LI].X + LP[LI].Y + LP[LI].Z;
  end;
  return LTotal;
end;

// The loop leaves when LI is AN: after it LI is AN
func Leaves(const AN: int64): int64;
var
  LI: int64;
  LCount: int64;
begin
  LI := 0;
  LCount := 0;
  while LI <> AN do
    LCount := LCount + 2;
    LI := LI + 1;
  end;
  return LI * 100 + LCount;
end;

// From 3 by one while below 8: LI leaves at 8
func Below(): int64;
var
  LI: int64;
  LTotal: int64;
begin
  LI := 3;
  LTotal := 0;
  while LI < 8 do
    LTotal := LTotal + LI;
    LI := LI + 1;
  end;
  return LI * 100 + LTotal;
end;

// LJ steps with LI from 10: it is LI + 9 (AN = 0: the loop never runs, LJ stays 10)
func Paired(const AN: int64): int64;
var
  LI: int64;
  LJ: int64;
  LTotal: int64;
begin
  LJ := 10;
  LTotal := 0;
  for LI := 1 to AN do
    LTotal := LTotal + LJ;
    LJ := LJ + 1;
  end;
  return LTotal * 100 + LJ;
end;

begin
  SetHeapReport(false);
  println("squares {}", Squares());
  println("narrow {}", Narrow());
  println("spread {}", Spread());
  println("leaves {}", Leaves(4));
  println("below {}", Below());
  println("paired {}", Paired(3));
  println("empty {}", Paired(0));
end.
