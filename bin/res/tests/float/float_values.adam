-------------------------------------------------------------------------------
  float_values.adam - Floats as values (M3.6a). A float local starts +0.0;
  float64 and float32 constants (1.5, -0.0, 0.1, 0.1f, -7.0), an integer
  constant used as a float converted once, as C converts it (3 -> 3.0
  implicitly; through a written cast 16777217 -> 16777216.0f and 2^53 + 1
  -> 2^53 in both widths), a float64 constant cast to float32 rounded
  once; floats as parameters and
  results between Adam routines (the 5th and 6th on the stack, float32 and
  float64 mixed with an integer), a module variable, record fields of both
  widths, a write through a pointer; ucrtbase's sqrt, ldexp (a float and an
  int in one call) and sqrtf. Each float is shown by its IEEE bits read
  back through an overlay (float64 as int64, float32 as uint32), through
  ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0
  | 4609434218613702656
  | -9223372036854775808
  | 4591870180066957722
  | -4603804719079489536
  | 4613937818241073152
  | 1036831949
  | 1266679808
  | 1036831949
  | 4845873199050653696
  | 1509949440
  | 4620833955170484224
  | 1061158912
  | 4612248968380809216
  | 4619004367821864960
  | 1067450368
  | 4621678380100616192
  | 4609047870845172685
  | 4627448617123184640
  | 1069547520
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe float_values;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine sqrt(const AValue: float64): float64; external "ucrtbase";
routine ldexp(const AValue: float64; const AExponent: int32): float64; external "ucrtbase";
routine sqrtf(const AValue: float32): float32; external "ucrtbase";

type
  // A float's bits read back as an integer of its width
  TBits64 = overlay
    F: float64;
    B: int64;
  end;

  TBits32 = overlay
    F: float32;
    B: uint32;
  end;

  // A record with a field of each float width
  TPoint = record
    X: float64;
    Y: float32;
  end;

var
  GF: float64;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue's IEEE bits as an int64, one line
routine Show64(const AValue: float64);
var
  LO: TBits64;
begin
  LO.F := AValue;
  ShowInt(LO.B);
end;

// AValue's IEEE bits as a uint32, one line
routine Show32(const AValue: float32);
var
  LO: TBits32;
begin
  LO.F := AValue;
  ShowInt(LO.B);
end;

// The 5th parameter (a float64 on the stack), the others mixed around it
routine Fifth(const AA: int32; const AB: float64; const AC: float32; const AD: float64;
  const AE: float64; const AF: float32): float64;
begin
  return AE;
end;

// The 6th parameter (a float32 on the stack)
routine Sixth(const AA: int32; const AB: float64; const AC: float32; const AD: float64;
  const AE: float64; const AF: float32): float32;
begin
  return AF;
end;

routine Run();
var
  LZero: float64;
  LF: float64;
  LS: float32;
  LP: TPoint;
  LPtr: ptr to float64;
begin
  // A float local starts +0.0
  Show64(LZero);

  // float64 constants
  Show64(1.5);
  Show64(-0.0);
  Show64(0.1);
  Show64(-7.0);

  // An integer constant used as a float64
  LF := 3;
  Show64(LF);

  // float32: a literal, an integer rounded, a float64 constant rounded once
  Show32(0.1f);
  LS := float32(16777217);
  Show32(LS);
  LS := float32(0.1);
  Show32(LS);

  // 2^53 + 1 in both widths
  LF := float64(9007199254740993);
  Show64(LF);
  LS := float32(9007199254740993);
  Show32(LS);

  // Parameters and results, the 5th and 6th on the stack
  Show64(Fifth(1, 2.5, 0.5f, 4.0, 8.25, 0.75f));
  Show32(Sixth(1, 2.5, 0.5f, 4.0, 8.25, 0.75f));

  // A module variable
  GF := 2.25;
  LF := GF;
  Show64(LF);

  // Record fields of both widths
  LP.X := 6.5;
  LP.Y := 1.25;
  Show64(LP.X);
  Show32(LP.Y);

  // A write through a pointer
  LPtr := addr of LF;
  LPtr^ := 9.75;
  Show64(LF);

  // ucrtbase: a float64 in and out, a float and an int in one call, a float32 in and out
  Show64(sqrt(2.0));
  Show64(ldexp(1.5, 4));
  Show32(sqrtf(2.25f));
end;

begin
  Run();
end.
