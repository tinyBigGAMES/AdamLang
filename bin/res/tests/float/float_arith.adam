module exe float_arith;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  // A float's bits read back as an integer of its width
  TBits64 = overlay
    F: float64;
    B: int64;
  end;

  TBits32 = overlay
    F: float32;
    B: uint32;
  end;

  // A record with a float64 field
  TPoint = record
    X: float64;
    Y: float64;
  end;

var
  GF: float64;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue's IEEE bits as an int64, one line
routine Show64(const AValue: float64);
var
  LO: TBits64;
begin
  LO.F := AValue;
  ShowInt(LO.B);
end;

// AValue's IEEE bits as a uint32, one line
routine Show32(const AValue: float32);
var
  LO: TBits32;
begin
  LO.F := AValue;
  ShowInt(LO.B);
end;

// The square of the hypotenuse: arithmetic on parameters
routine Hyp(const AX: float64; const AY: float64): float64;
begin
  return AX * AX + AY * AY;
end;

// float64: the operators, the IEEE edges, unary minus and plus
routine Run64();
var
  LA: float64;
  LB: float64;
  LZero: float64;
  LM: float64;
  LInf: float64;
  LNaN: float64;
  LT: float64;
  LO: TBits64;
begin
  LA := 0.1;
  LB := 0.2;
  LM := -1.0;
  Show64(LA + LB);
  Show64(LA - LB);
  Show64(LA * LB);
  Show64(LA / LB);

  // A divide by +0.0: +inf, -inf, then 0 / 0 and inf - inf the default NaN
  Show64(1.0 / LZero);
  Show64(LM / LZero);
  Show64(LZero / LZero);
  LInf := 1.0 / LZero;
  Show64(LInf - LInf);

  // A NaN's payload through + (left) and * (right)
  LO.B := 0x7FF8000000000123;
  LNaN := LO.F;
  Show64(LNaN + 1.0);
  Show64(2.0 * LNaN);

  // Unary minus flips the sign bit; +0.0 * -1.0 is -0.0; unary plus
  Show64(-LZero);
  LT := -LZero;
  Show64(-LT);
  Show64(-LA);
  Show64(-LNaN);
  Show64(LZero * LM);
  Show64(+LA);

  // Nested, then parameters
  Show64((LA + LB) * (LA - LB));
  Show64(Hyp(3.0, 4.0));
end;

// float64 compounds on a local, a record field, through a pointer, on a module variable
routine RunCompounds();
var
  LC: float64;
  LP: TPoint;
  LPtr: ptr to float64;
begin
  LC := 1.5;
  LC += 2.25;
  Show64(LC);
  LC -= 0.5;
  Show64(LC);
  LC *= 4.0;
  Show64(LC);
  LC /= 8.0;
  Show64(LC);
  LP.X := 6.5;
  LP.X += 1.0;
  Show64(LP.X);
  LPtr := addr of LC;
  LPtr^ *= 2.0;
  Show64(LC);
  GF := 10.0;
  GF /= 4.0;
  Show64(GF);
end;

// float32: rounded to float32, an overflow, round to even, -0.0f, compounds, a NaN
routine Run32();
var
  LS1: float32;
  LS2: float32;
  LBig: float32;
  LZero: float32;
  LS3: float32;
  LNaN: float32;
  LO: TBits32;
begin
  LS1 := 0.1f;
  LS2 := 0.2f;
  Show32(LS1 + LS2);
  Show32(LS1 - LS2);
  Show32(LS1 * LS2);
  Show32(LS1 / LS2);

  // 2^32 cubed then once more is 2^128: past float32's largest, +inf
  LBig := 65536.0f;
  LBig := LBig * LBig;
  Show32(LBig * LBig * LBig * LBig);
  LBig := 16777216.0f;
  Show32(LBig + 1.0f);
  Show32(-LZero);
  Show32(-LS1);

  // Compounds
  LS3 := 1.0f;
  LS3 /= 3.0f;
  Show32(LS3);
  LS3 *= 3.0f;
  Show32(LS3);
  LS3 += 0.5f;
  Show32(LS3);

  // A NaN's payload through unary minus and +
  LO.B := 0x7FC00123;
  LNaN := LO.F;
  Show32(-LNaN);
  Show32(LNaN + 1.0f);
end;

begin
  Run64();
  RunCompounds();
  Run32();
end.
