-------------------------------------------------------------------------------
  float_err_literal_range.adam - Break step of float literals (AUD5): a
  literal no float64 holds (1e400) is the lexer's LX0006 at it, alone (the
  folder adds no SM0256); a float32 literal past float32 but inside float64
  is the folder's SM0256; the largest float64 is clean
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe float_err_literal_range;

var
  LF: float64;
  LS: float32;

begin
  LF := 1.7976931348623157e308;
  LF := 1e400; // ERROR LX0006@9
  LF := -1e400; // ERROR LX0006@10
  LS := 3.5e38f; // ERROR SM0256@9
end.
