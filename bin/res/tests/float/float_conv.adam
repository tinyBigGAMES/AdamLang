  | -4332462841530417152
  | 4890909195324358656
  | 4643176031446892544
  | 4679239875398991872
  | 4751297606873776128
  | 4895412794951729152
  | 4890909195324358656
  | 4890909195324358657
  | 4617315517961601024
  | 4607182418800017408
  | 1266679808
  | 1602224128
  | 1593835521
  | 3212836864
  | 1333788672
  | 3338665984
  | -2
  | 2
  | -128
  | 65535
  | 4294967295
  | -9223372036854775808
  | 9223372036854774784
  | 9223372036854775808
  | 18446744073709549568
  | 12345
  | -1
  | 3000000000
  | 9223372036854775808
  | 18446742974197923840
  | 1036831949
  | 4591870180174331904
  | 2139095040
  | 9221120393270525952
  | 2147483648
  | 2
  | 10000000000000000000
  | 0
  | 1
  | [Adam Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe float_conv;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine _ui64toa(const AValue: uint64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  // A float's bits read back as an integer of its width, or written through it
  TBits64 = overlay
    F: float64;
    B: int64;
  end;

  TBits32 = overlay
    F: float32;
    B: uint32;
  end;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue in decimal, unsigned, one line
routine ShowU64(const AValue: uint64);
begin
  puts(_ui64toa(AValue, malloc(32), 10));
end;

// AValue's IEEE bits as an int64, one line
routine Show64(const AValue: float64);
var
  LO: TBits64;
begin
  LO.F := AValue;
  ShowInt(LO.B);
end;

// AValue's IEEE bits as a uint32, one line
routine Show32(const AValue: float32);
var
  LO: TBits32;
begin
  LO.F := AValue;
  ShowInt(LO.B);
end;

// Every integer width to float64, at its limits; a small uint64 and a bool
routine ToFloat64();
var
  LI8: int8;
  LI16: int16;
  LI32: int32;
  LI64: int64;
  LU8: uint8;
  LU16: uint16;
  LU32: uint32;
  LU64: uint64;
  LB: bool;
begin
  LI8 := -128;
  Show64(float64(LI8));
  LI16 := -32768;
  Show64(float64(LI16));
  LI32 := -2147483647 - 1;
  Show64(float64(LI32));
  LI64 := -9223372036854775807 - 1;
  Show64(float64(LI64));
  LI64 := 9223372036854775807;
  Show64(float64(LI64));
  LU8 := 255;
  Show64(float64(LU8));
  LU16 := 65535;
  Show64(float64(LU16));
  LU32 := 4294967295;
  Show64(float64(LU32));
  LU64 := 18446744073709551615u;
  Show64(float64(LU64));
  LU64 := 9223372036854775808u;
  Show64(float64(LU64));
  LU64 := 9223372036854776833u;
  Show64(float64(LU64));
  LU64 := 5;
  Show64(float64(LU64));
  LB := true;
  Show64(float64(LB));
end;

// Integers to float32, rounded once
routine ToFloat32();
var
  LI16: int16;
  LI32: int32;
  LI64: int64;
  LU32: uint32;
  LU64: uint64;
begin
  LI32 := 16777217;
  Show32(float32(LI32));
  LU64 := 18446744073709551615u;
  Show32(float32(LU64));
  LU64 := 9223372586610589697u;
  Show32(float32(LU64));
  LI64 := -1;
  Show32(float32(LI64));
  LU32 := 4294967295;
  Show32(float32(LU32));
  LI16 := -32768;
  Show32(float32(LI16));
end;

// Floats to integers, truncated toward zero, at the int64 / uint64 limits
routine ToInteger();
var
  LF: float64;
  LS: float32;
begin
  LF := -2.9;
  ShowInt(int64(int32(LF)));
  LF := 2.9;
  ShowInt(int64(int8(LF)));
  LF := -128.5;
  ShowInt(int64(int8(LF)));
  LF := 65535.9;
  ShowInt(int64(uint16(LF)));
  LF := 4294967295.5;
  ShowInt(int64(uint32(LF)));
  LF := -9223372036854775808.0;
  ShowInt(int64(LF));
  LF := 9223372036854774784.0;
  ShowInt(int64(LF));
  LF := 9223372036854775808.0;
  ShowU64(uint64(LF));
  LF := 18446744073709549568.0;
  ShowU64(uint64(LF));
  LF := 12345.75;
  ShowU64(uint64(LF));
  LS := -1.5f;
  ShowInt(int64(int32(LS)));
  LS := 3000000000.0f;
  ShowInt(int64(uint32(LS)));
  LS := 9223372036854775808.0f;
  ShowU64(uint64(LS));
  LS := 18446742974197923840.0f;
  ShowU64(uint64(LS));
end;

// float64 <-> float32: rounded, exact, an overflow, a NaN's payload, -0.0
routine BetweenFloats();
var
  LF: float64;
  LS: float32;
  LZero: float64;
  LO32: TBits32;
begin
  LF := 0.1;
  Show32(float32(LF));
  LS := 0.1f;
  Show64(float64(LS));
  LF := 1.0e300;
  Show32(float32(LF));
  LO32.B := 0x7FC00123;
  LS := LO32.F;
  Show64(float64(LS));
  LF := -LZero;
  Show32(float32(LF));
end;

// Folded floats used as integers: converted at compile time
routine Folded();
var
  LI: int32;
  LU: uint64;
  LB: bool;
begin
  LI := int32(2.75);
  ShowInt(int64(LI));
  LU := uint64(10000000000000000000.0);
  ShowU64(LU);
  LB := bool(0.0);
  ShowInt(int64(LB));
  LB := bool(0.5);
  ShowInt(int64(LB));
end;

begin
  ToFloat64();
  ToFloat32();
  ToInteger();
  BetweenFloats();
  Folded();
end.
