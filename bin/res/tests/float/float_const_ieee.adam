-------------------------------------------------------------------------------
  float_const_ieee.adam - float constants follow IEEE (BNF sec 6, user
  2026-10-20 "(a)"): a constant float expression with no finite value is
  still a constant: 0.0 / 0.0 and inf - inf are NaN (the positive quiet
  one), a division by a zero an infinity signed by both operands (1.0 /
  -0.0 is -inf), an overflow an infinity, a float32 conversion past its
  range inf, an infinite operand folds on; the run time agrees (its own
  NaN is the hardware's, compared, never printed); a float casts to char
  and wchar
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | nan nan true false
  | inf -inf -inf inf
  | overflow inf inf
  | operand inf nan
  | runtime true inf
  | char 65 66
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe float_const_ieee;

const
  // No finite number: each is still a constant (IEEE)
  KNaN: float64 = 0.0 / 0.0;
  KInfPlus: float64 = 1.0 / 0.0;
  KNaN2: float64 = KInfPlus - KInfPlus;
  KInfMinus: float64 = -1.0 / 0.0;
  KNegZero: float64 = 1.0 / -0.0;
  KInf32: float32 = 1.0f / 0.0f;
  KOver: float64 = 1.0e308 * 10.0;
  KCut32: float32 = float32(1.0e300);
  KOnInf: float64 = KInfPlus + 1.0;
  KZeroInf: float64 = KInfPlus * 0.0;

func Run();
var
  LZero: float64;
  LOne: float64;
begin
  println("{} {} {} {}", KNaN, KNaN2, KNaN <> KNaN, KNaN = KNaN);
  println("{} {} {} {}", KInfPlus, KInfMinus, KNegZero, KInf32);
  println("overflow {} {}", KOver, KCut32);
  println("operand {} {}", KOnInf, KZeroInf);
  // the run time agrees with the folded constants
  LZero := 0.0;
  LOne := 1.0;
  println("runtime {} {}", (LZero / LZero) <> (LZero / LZero), LOne / LZero);
  // a float casts to char and wchar too, truncated toward 0
  println("char {} {}", int32(char(LOne * 65.5)), int32(wchar(LOne * 66.0)));
end;

begin
  Run();
end.
