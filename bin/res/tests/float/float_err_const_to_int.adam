-------------------------------------------------------------------------------
  float_err_const_to_int.adam - a float constant cast to an integer, char
  or wchar type converts only when the type holds its integer part (BNF
  sec 6, truncated toward 0): a NaN, an infinity or a value out of range is
  SM0200 at the cast naming the type's range (char is C's signed 8 bits,
  wchar 16 unsigned); a value whose integer part fits is clean
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe float_err_const_to_int;

const
  KNaN: float64 = 0.0 / 0.0;
  KInf: float64 = 1.0 / 0.0;

var
  LI: int32;
  LB: uint8;
  LC: char;
  LW: wchar;

begin
  LI := int32(KNaN); // ERROR SM0200@9: nan does not fit in 'int32' (-2147483648..2147483647)
  LI := int32(KInf); // ERROR SM0200@9: inf does not fit in 'int32' (-2147483648..2147483647)
  LB := uint8(300.0); // ERROR SM0200@9: 300 does not fit in 'uint8' (0..255)
  LB := uint8(-1.0); // ERROR SM0200@9: -1 does not fit in 'uint8' (0..255)
  LC := char(200.0); // ERROR SM0200@9: 200 does not fit in 'char' (-128..127)
  LW := wchar(-1.0); // ERROR SM0200@9: -1 does not fit in 'wchar' (0..65535)
  LI := int32(-2147483648.5);
  LB := uint8(255.9);
  LC := char(-128.0);
  LW := wchar(65535.0);
end.
