-------------------------------------------------------------------------------
  float_text_exact.adam - FloatToStr (System.SysUtils) writes a float64 as
  C++'s std::format "{}" does (PLAN-SELFHOST S6z): the shortest text that
  reads back, fixed or scientific, whichever is shorter. A float above 2^53
  in fixed form is its exact integer, not its shortest digits padded with
  zeros (-1.4876189388591839e19 is -14876189388591839232). Every expected
  line was printed by C++20's std::format for the same value; below 2^53,
  powers of ten in scientific form, the smallest subnormal, a fraction and a
  small integer as before.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | -14876189388591839232
  | 1152921504606846976
  | 9007199254740992
  | 1e+20
  | 1e+16
  | 123456789012345683968
  | 123456789012345680
  | -99999999999999983616
  | 4e+18
  | 1.5e+17
  | 1e+21
  | 5e-324
  | 0.1
  | 1234567
  | [Adam Heap] Allocs: 245, Frees: 245, Leaked: 0
@@end
*/

module exe float_text_exact;

import System.SysUtils;

// AValue as FloatToStr writes it, on a line of its own
routine Show(const AValue: float64);
begin
  println("{}", FloatToStr(AValue));
end;

begin
  Show(-1.4876189388591839e19);
  Show(1152921504606846976.0);
  Show(9007199254740992.0);
  Show(1e20);
  Show(1e16);
  Show(1.2345678901234568e20);
  Show(123456789012345678.0);
  Show(-9.999999999999999e19);
  Show(4e18);
  Show(1.5e17);
  Show(1e21);
  Show(5e-324);
  Show(0.1);
  Show(1234567.0);
end.
