-------------------------------------------------------------------------------
  float_conditional.adam - `? :` of float64 and float32 values (BNF sec 6):
  each side picked by its condition, only the picked side run, a float
  condition's truth (a NaN true), a nested one, one inside arithmetic and
  as an argument, one carried around a loop (a float phi at the loop head),
  a float32 widened by its own conversion (PLAN-ADAM J2)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | min 1.5
  | max 2.25
  | ran 99
  | picked 3
  | nan true
  | zero false
  | sign -1
  | sign 0
  | sign 1
  | sum 5.25
  | half 0.75
  | loop 7.5
  | f32 0.5
  | f32 wide 2.5
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe float_conditional;

import System.SysUtils;

// Shows ran 99 (it ran), then gives AValue: the side ? : did not pick must not run
func Mark(const AValue: float64): float64;
begin
  println("ran {}", 99);
  return AValue;
end;

// -1.0, 0.0 or 1.0 by AValue's sign (a nested ? :)
func Sign(const AValue: float64): float64;
begin
  return AValue < 0.0 ? -1.0 : (AValue > 0.0 ? 1.0 : 0.0);
end;

// The value passed in
func Same(const AValue: float64): float64;
begin
  return AValue;
end;

var
  LA: float64;
  LB: float64;
  LNan: float64;
  LZero: float64;
  LAcc: float64;
  LF: float32;
  LG: float32;
  LI: int32;
begin
  LA := 1.5;
  LB := 2.25;
  println("min {}", FloatToStr(LA < LB ? LA : LB));
  println("max {}", FloatToStr(LA > LB ? LA : LB));
  println("picked {}", FloatToStr(LA < LB ? Mark(3.0) : Mark(4.0)));
  LZero := 0.0;
  LNan := 0.0 / LZero;
  println("nan {}", BoolToStr(bool(LNan) ? true : false));
  println("zero {}", BoolToStr(bool(LZero) ? true : false));
  println("sign {}", FloatToStr(Sign(-2.0)));
  println("sign {}", FloatToStr(Sign(0.0)));
  println("sign {}", FloatToStr(Sign(8.0)));
  println("sum {}", FloatToStr(1.5 + (LA < LB ? 3.75 : 0.0)));
  println("half {}", FloatToStr(Same(LB > LA ? LA / 2.0 : LB)));
  LAcc := 0.0;
  for LI := 1 to 5 do
    LAcc := LI mod 2 = 1 ? LAcc + 2.0 : LAcc - 0.25;
  end;
  println("loop {}", FloatToStr(LAcc + 2.0));
  LF := 0.5;
  LG := 2.5;
  println("f32 {}", FloatToStr(float64(LF < LG ? LF : LG)));
  println("f32 wide {}", FloatToStr(LF > LG ? float64(LF) : float64(LG)));
end.
