-------------------------------------------------------------------------------
  dbg_symbols.adam - Adam's debug symbols (M11a D2): the compiler's
  Adam.Debug.* units (imported from its own src\) debug dbg_symbols_sample,
  which its dep built, and read its PDB through Debug.Symbols. In order: a
  walk before any load (DB0011); the sample started, its image loaded at
  its ProcessStarted (a module with no debug information, ntdll, DB0010);
  the source file found by three spellings, a file it lacks not; Inner by
  name (its body past the prologue on its first statement line), a comment
  line resolved to the next line with code and that address back to its
  line and routine; a breakpoint there, the stop's stack three routines
  deep by Adam names and lines, each frame's parameters and locals with
  their types and (int32 ones) values read at their register plus offset;
  Inner's types (a record's fields, a static array's count, a pointer's
  element, a choices type's values); the globals by name with values and
  the sample's globals listed; a context not read from a thread (DB0012);
  then the patch out and the sample run to its end
*******************************************************************************/

/*
@@test
  kind run
  deps dbg.dbg_symbols_sample
  args "<OUT>/bin/<CELL>/dbg_symbols_sample.exe"
  exitcode 0
  | walk unloaded false
  | Error DB0011: no module's debug information is loaded
  | started true
  | loaded true
  | no debug information false DB0010
  | file by name '$P:res/tests/dbg/dbg_symbols_sample.adam'
  | file by tail '$P:res/tests/dbg/dbg_symbols_sample.adam'
  | file by full path '$P:res/tests/dbg/dbg_symbols_sample.adam'
  | file missing ''
  | routine true dbg_symbols_sample.Inner body past start true body line 48
  | line 57 true moved to 58
  | back line 58 same true routine dbg_symbols_sample.Inner
  | line 200 false
  | patch true
  | stopped breakpoint at line true
  | walk true deep true
  |   frame 0 dbg_symbols_sample.Inner line 58
  |   frame 1 dbg_symbols_sample.Middle line 71
  |   frame 2 dbg_symbols_sample.Outer line 78
  |   frame 3 dbg_symbols_sample line 85
  | frame 0 variables true
  |   param ACorner Point
  |   param AStep int32 = 4
  |   local LSum int32 = 0
  |   local LParts array of int32
  |   local LAt ptr to Point
  | frame 1 variables true
  |   param AValue int32 = 5
  |   param AFactor int32 = 3
  |   local LCorner Point
  |   local LMood Mood
  | frame 2 variables true
  |   param AValue int32 = 5
  |   local LResult int32 = 0
  | record Point size 8
  |   field X offset 0 int32
  |   field Y offset 4 int32
  | array count 4 size 16 of int32
  | parts 5 15 4 0
  | pointer size 8 to Point
  | choices Mood size 4
  |   Calm = 0
  |   Busy = 1
  |   Done = 2
  | global true dbg_symbols_sample.GTotal int32 = 41
  | global true dbg_symbols_sample.GMood Mood = 1
  | global true dbg_symbols_sample.GName string
  | global missing false
  | sample globals
  |   global dbg_symbols_sample.GMood
  |   global dbg_symbols_sample.GName
  |   global dbg_symbols_sample.GTotal
  | walk unread false
  | Error DB0012: the registers given for thread 0 are not the ones read from it
  | process-exited 0
  | output| symbols 70 1
  | reports 3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dbg_symbols;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Compiler.Diagnostics, Adam.Debug.Target, Adam.Debug.Symbols,
  Adam.Debug.Targets;

const
  // How long one wait for an event may take before the row gives up (ms)
  WAIT_MS: uint32 = 30000;
  // The sample's file as its PDB names it, and the module prefix of its names
  SAMPLE_FILE: string = "$P:res/tests/dbg/dbg_symbols_sample.adam";
  SAMPLE_PREFIX: string = "dbg_symbols_sample.";

var
  GOutput: string;
  GSystemPath: string;
  GSystemBase: uint64;

// The next event a row looks at into AEvent: output is kept in GOutput, a module load is
// resumed (the first one's path and base kept: a module with no Adam debug information),
// thread starts / ends and unloads are passed over. False when none came in WAIT_MS
routine DoNext(const ATarget: ref DebugTarget; var AEvent: DebugEvent): bool;
begin
  while ATarget.NextEvent(AEvent, WAIT_MS) do
    match AEvent.Kind of
      DebugEventKind.Output:
        GOutput := GOutput + AEvent.OutputText;
      DebugEventKind.ModuleLoaded:
        if GSystemPath = "" then
          GSystemPath := AEvent.ModulePath;
          GSystemBase := AEvent.Address;
        end;
        ATarget.Resume(ResumeKind.Continue);
      DebugEventKind.ThreadStarted, DebugEventKind.ThreadExited, DebugEventKind.ModuleUnloaded:
        // nothing to show
    else
      return true;
    end;
  end;
  return false;
end;

// The little-endian integer of ASize bytes (1 .. 8) at AAddress in ATarget, sign-extended
routine DoReadInt(const ATarget: ref DebugTarget; const AAddress: uint64;
  const ASize: int64): int64;
var
  LBytes: ByteArray;
  LValue: uint64;
  LI: int64;
begin
  if (ASize < 1) or (ASize > 8) or (not ATarget.ReadMemory(AAddress, ASize, LBytes)) then
    return -1;
  end;
  LValue := 0;
  for LI := ASize - 1 downto 0 do
    LValue := (LValue << 8) | uint64(LBytes[LI]);
  end;
  if (ASize < 8) and ((LValue & (uint64(1) << uint64(ASize * 8 - 1))) <> 0) then
    return int64(LValue) - int64(uint64(1) << uint64(ASize * 8));
  end;
  return int64(LValue);
end;

// Type ATypeId of AModule as the row shows it: a named type by its name, a pointer / array
// by its element
routine DoTypeText(const ASymbols: ref DebugSymbols; const AModule: uint64;
  const ATypeId: uint64): string;
var
  LType: SymbolType;
begin
  if not ASymbols.TypeOf(AModule, ATypeId, LType) then
    return "no type";
  end;
  if LType.Kind = SymbolTypeKind.Pointer then
    return "ptr to " + DoTypeText(ASymbols, AModule, LType.ElementTypeId);
  end;
  if LType.Kind = SymbolTypeKind.StaticArray then
    return "array of " + DoTypeText(ASymbols, AModule, LType.ElementTypeId);
  end;
  return LType.Name;
end;

// One variable's line: its kind, name, type; an int32's value read where it lives in AFrame
routine DoShowVariable(const ASymbols: ref DebugSymbols; const ATarget: ref DebugTarget;
  const AVariable: SymbolVariable; const AFrame: StackFrame);
var
  LText: string;
  LAddress: uint64;
begin
  LText := DoTypeText(ASymbols, AVariable.Module, AVariable.TypeId);
  if (LText = "int32") and ASymbols.AddressIn(AVariable, AFrame, ATarget.RegisterNames(),
    LAddress) then
    LText := LText + " = " + IntToStr(DoReadInt(ATarget, LAddress, 4));
  end;
  println("  {} {} {}", VariableKindText(AVariable.Kind), AVariable.Name, LText);
end;

// The variables of frame AIndex of AFrames
routine DoShowFrame(const ASymbols: ref DebugSymbols; const ATarget: ref DebugTarget;
  const AFrames: StackFrameArray; const AIndex: int64);
var
  LVariables: SymbolVariableArray;
  LLookup: uint64;
  LOk: bool;
  LI: int64;
begin
  LLookup := AFrames[AIndex].Context.Pc;
  if AIndex > 0 then
    LLookup := LLookup - 1;
  end;
  LOk := ASymbols.Variables(LLookup, LVariables);
  println("frame {} variables {}", AIndex, LOk);
  for LI := 0 to len(LVariables) - 1 do
    DoShowVariable(ASymbols, ATarget, LVariables[LI], AFrames[AIndex]);
  end;
end;

// The local named AName of the routine at AAddress
routine DoLocal(const ASymbols: ref DebugSymbols; const AAddress: uint64; const AName: string;
  var AVariable: SymbolVariable): bool;
var
  LVariables: SymbolVariableArray;
  LI: int64;
begin
  ASymbols.Variables(AAddress, LVariables);
  for LI := 0 to len(LVariables) - 1 do
    if LVariables[LI].Name = AName then
      AVariable := LVariables[LI];
      return true;
    end;
  end;
  return false;
end;

// A global by name with its type and (an int32 / choices) value
routine DoShowGlobal(const ASymbols: ref DebugSymbols; const ATarget: ref DebugTarget;
  const AName: string);
var
  LVariable: SymbolVariable;
  LType: SymbolType;
  LText: string;
  LOk: bool;
begin
  LOk := ASymbols.GlobalByName(AName, LVariable);
  LText := DoTypeText(ASymbols, LVariable.Module, LVariable.TypeId);
  ASymbols.TypeOf(LVariable.Module, LVariable.TypeId, LType);
  if LOk and ((LType.Kind = SymbolTypeKind.Signed) or (LType.Kind = SymbolTypeKind.Choices)) then
    LText := LText + " = " + IntToStr(DoReadInt(ATarget, LVariable.Address, int64(LType.Size)));
  end;
  println("global {} {} {}", LOk, AName, LText);
end;

var
  GReports: ref Diagnostics;
  GTarget: ref DebugTarget;
  GSymbols: ref DebugSymbols;
  GOther: ref DebugSymbols;
  GEvent: DebugEvent;
  GContext: DebugContext;
  GEmptyContext: DebugContext;
  GFrames: StackFrameArray;
  GRoutine: SymbolRoutine;
  GBack: SymbolRoutine;
  GLine: SourceLine;
  GBodyLine: SourceLine;
  GBackLine: SourceLine;
  GVariable: SymbolVariable;
  GType: SymbolType;
  GElement: SymbolType;
  GGlobals: SymbolVariableArray;
  GNames: StringArray;
  GFiles: StringArray;
  GNoArgs: StringArray;
  GAddress: uint64;
  GCount: int64;
  GI: int64;
  GOk: bool;
  GLines: StringArray;

begin
  GReports := ref Diagnostics(100);

  // A walk with nothing loaded
  GOther := DebugSymbolsFor(ADAM_DEBUG_WIN64_TRIPLE);
  GOther.SetDiagnostics(GReports);
  println("walk unloaded {}", GOther.StackWalk(nil, 0, GEmptyContext, 0, GFrames));
  println("{}", GReports.Items[GReports.Count - 1].Display());

  // The sample, held at its start: its image's debug information
  GTarget := DebugTargetFor(ADAM_DEBUG_WIN64_TRIPLE);
  GTarget.SetDiagnostics(GReports);
  GTarget.SetProgram(paramstr(1), GNoArgs);
  GTarget.SetOutputMode(DebugOutputMode.Pipes);
  println("started {}", GTarget.Start());
  DoNext(GTarget, GEvent);
  GSymbols := DebugSymbolsFor(ADAM_DEBUG_WIN64_TRIPLE);
  GSymbols.SetDiagnostics(GReports);
  println("loaded {}", GSymbols.Load(GTarget));
  GTarget.Resume(ResumeKind.Continue);
  // The Entry stop: the first module loaded (ntdll) is there by now
  DoNext(GTarget, GEvent);
  println("no debug information {} {}", GSymbols.LoadModule(GSystemPath, GSystemBase),
    GReports.Items[GReports.Count - 1].Code);

  // The source file by three spellings, and one it lacks
  GFiles := GSymbols.SourceFiles();
  println("file by name '{}'", MatchSourceFile(GFiles, "dbg_symbols_sample.adam"));
  println("file by tail '{}'", MatchSourceFile(GFiles, "tests\\dbg\\dbg_symbols_sample.adam"));
  println("file by full path '{}'", MatchSourceFile(GFiles,
    "C:\\Somewhere\\bin\\res\\tests\\dbg\\DBG_SYMBOLS_SAMPLE.adam"));
  println("file missing '{}'", MatchSourceFile(GFiles, "no_such_file.adam"));

  // Inner by name, its body, a comment line resolved to the next code line and back
  GOk := GSymbols.RoutineByName(SAMPLE_PREFIX + "Inner", GRoutine);
  GSymbols.LineAt(GRoutine.BodyAddress, GBodyLine);
  println("routine {} {} body past start {} body line {}", GOk, GRoutine.Name,
    GRoutine.BodyAddress > GRoutine.Address, GBodyLine.Line);
  GOk := GSymbols.AddressOf(SAMPLE_FILE, 57, GLine);
  println("line 57 {} moved to {}", GOk, GLine.Line);
  GSymbols.LineAt(GLine.Address, GBackLine);
  GSymbols.RoutineAt(GLine.Address, GBack);
  println("back line {} same {} routine {}", GBackLine.Line, GBackLine.Address = GLine.Address,
    GBack.Name);
  println("line 200 {}", GSymbols.AddressOf(SAMPLE_FILE, 200, GBackLine));

  // A breakpoint there; the stop's stack
  println("patch {}", GTarget.AddPatch(GLine.Address));
  GTarget.Resume(ResumeKind.Continue);
  DoNext(GTarget, GEvent);
  println("stopped {} at line {}", DebugStopReasonText(GEvent.Reason),
    GEvent.Address = GLine.Address);
  GTarget.GetContext(GEvent.ThreadId, GContext);
  GOk := GSymbols.StackWalk(GTarget, GEvent.ThreadId, GContext, 0, GFrames);
  println("walk {} deep {}", GOk, len(GFrames) >= 4);
  for GI := 0 to 3 do
    if GI < len(GFrames) then
      println("  frame {} {} line {}", GI, GFrames[GI].Routine.Name, GFrames[GI].Source.Line);
    end;
  end;
  for GI := 0 to 2 do
    if GI < len(GFrames) then
      DoShowFrame(GSymbols, GTarget, GFrames, GI);
    end;
  end;

  // Inner's types: Point by ACorner, the array and the pointer by its locals, Mood by LMood
  DoLocal(GSymbols, GLine.Address, "ACorner", GVariable);
  GSymbols.TypeOf(GVariable.Module, GVariable.TypeId, GType);
  println("record {} size {}", GType.Name, GType.Size);
  for GI := 0 to len(GType.Fields) - 1 do
    println("  field {} offset {} {}", GType.Fields[GI].Name, GType.Fields[GI].Offset,
      DoTypeText(GSymbols, GVariable.Module, GType.Fields[GI].TypeId));
  end;
  DoLocal(GSymbols, GLine.Address, "LParts", GVariable);
  GSymbols.TypeOf(GVariable.Module, GVariable.TypeId, GType);
  GSymbols.TypeOf(GVariable.Module, GType.ElementTypeId, GElement);
  println("array count {} size {} of {}", GType.Count, GType.Size, GElement.Name);
  GSymbols.AddressIn(GVariable, GFrames[0], GTarget.RegisterNames(), GAddress);
  println("parts {} {} {} {}", DoReadInt(GTarget, GAddress, 4), DoReadInt(GTarget, GAddress + 4, 4),
    DoReadInt(GTarget, GAddress + 8, 4), DoReadInt(GTarget, GAddress + 12, 4));
  DoLocal(GSymbols, GLine.Address, "LAt", GVariable);
  GSymbols.TypeOf(GVariable.Module, GVariable.TypeId, GType);
  println("pointer size {} to {}", GType.Size, DoTypeText(GSymbols, GVariable.Module,
    GType.ElementTypeId));
  GSymbols.Variables(GFrames[1].Context.Pc - 1, GGlobals);
  for GI := 0 to len(GGlobals) - 1 do
    if GGlobals[GI].Name = "LMood" then
      GSymbols.TypeOf(GGlobals[GI].Module, GGlobals[GI].TypeId, GType);
    end;
  end;
  println("choices {} size {}", GType.Name, GType.Size);
  for GI := 0 to len(GType.Choices) - 1 do
    println("  {} = {}", GType.Choices[GI].Name, GType.Choices[GI].Value);
  end;

  // The globals by name, then the sample's own among all of them
  DoShowGlobal(GSymbols, GTarget, SAMPLE_PREFIX + "GTotal");
  DoShowGlobal(GSymbols, GTarget, SAMPLE_PREFIX + "GMood");
  DoShowGlobal(GSymbols, GTarget, SAMPLE_PREFIX + "GName");
  println("global missing {}", GSymbols.GlobalByName(SAMPLE_PREFIX + "NoSuchGlobal", GVariable));
  GSymbols.Globals(GGlobals);
  GCount := 0;
  setlength(GNames, len(GGlobals));
  for GI := 0 to len(GGlobals) - 1 do
    if StartsStr(SAMPLE_PREFIX, GGlobals[GI].Name) and
      (GGlobals[GI].Kind = VariableKind.Global) then
      GNames[GCount] := GGlobals[GI].Name;
      GCount := GCount + 1;
    end;
  end;
  setlength(GNames, GCount);
  SortStrings(GNames);
  println("sample globals");
  for GI := 0 to len(GNames) - 1 do
    println("  global {}", GNames[GI]);
  end;

  // Registers no thread gave
  println("walk unread {}", GSymbols.StackWalk(GTarget, 0, GEmptyContext, 0, GFrames));
  println("{}", GReports.Items[GReports.Count - 1].Display());

  // The patch out, the sample run to its end
  GTarget.RemovePatch(GLine.Address);
  GTarget.Resume(ResumeKind.Continue);
  while DoNext(GTarget, GEvent) do
    if GEvent.Kind = DebugEventKind.ProcessExited then
      println("{} {}", DebugEventKindText(GEvent.Kind), GEvent.ExitCode);
      leave;
    end;
    if GTarget.IsHeld() then
      GTarget.Resume(ResumeKind.Continue);
    end;
  end;
  GLines := SplitString(GOutput, "\n");
  for GI := 0 to len(GLines) - 1 do
    if (Trim(GLines[GI]) <> "") and (not StartsStr("[Heap]", Trim(GLines[GI]))) then
      println("output| {}", Trim(GLines[GI]));
    end;
  end;
  GSymbols.Close();
  println("reports {}", GReports.Count);
end.
