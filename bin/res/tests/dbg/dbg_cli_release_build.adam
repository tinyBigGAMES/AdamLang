-------------------------------------------------------------------------------
  dbg_cli_release_build.adam - build -opt fast (M11a D5e3): a release build
  writes the exe and no debug information, exit 0, nothing printed; the
  exe is what dbg_dap's session 6 runs with noDebug (this row is its dep):
  two lines around an @breakpoint, then 7
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--no-banner" "--quiet" "<DIR>/dbg_cli_release_build.adam" "-o" "." "-opt" "fast"
  exitcode 0
@@end
*/

module exe dbg_cli_release_build;

import System.Console;

begin
  println("release start");
  @breakpoint;
  println("release end");
  return 7;
end.
