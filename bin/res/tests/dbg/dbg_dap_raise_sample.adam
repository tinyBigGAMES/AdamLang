-------------------------------------------------------------------------------
  dbg_dap_raise_sample.adam - the dep of dbg_dap's first-chance sessions
  (M11a D6b): the body raises twice, each caught by a guard of its own:
  Fail raises in the first guard's body, then Middle (no guard of its own)
  calls Fail in the second, so that raise is caught a frame above it; a
  fault (a divide by zero) is caught last, the third guard's except part
  printing it. The row sets breakpoints and steps on these lines, so a
  change here moves the row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_dap_raise_sample;

var
  GZero: int64;
  GValue: int64;

// Raises: the first chance a client may stop at
func Fail();
begin
  raise("boom");
end;

// No guard of its own: Fail's raise is caught by its caller's
func Middle();
begin
  Fail();
  println("not here");
end;

begin
  println("start");
  guard
    Fail();
    println("not here either");
  except
    println("caught {}", excmsg());
  end;
  guard
    Middle();
  except
    println("caught again {}", excmsg());
  end;
  guard
    GValue := 7 div GZero;
  except
    println("fault {}", exccode());
  end;
  println("end");
end.
