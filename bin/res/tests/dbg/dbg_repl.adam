-------------------------------------------------------------------------------
  dbg_repl.adam - Adam's console debugger (M11a D4): Adam.Debug.REPL
  (imported from the compiler's own src\) debugs dbg_repl_sample, which
  its dep built, through a scripted DebugREPLIO (each command echoed after
  the prompt, the program's output through the debugger). In order: the
  title, the @breakpoint taken as breakpoint #1 and the run to it (the
  program's line first); h, bl, bt, locals, p (a value, an unknown name),
  f 1 (the caller and its source), f 9; b <line> in the selected frame's
  file, b of an unknown file, b with no line; n, finish (back in the body
  at the line after the call), s (into Add), finish, n, src; c to
  breakpoint #2; bd 1, bd 7, bc, bl; c to
  the end (the program's last line, its exit code); p while not running;
  r (no breakpoint left: held at its entry), n refused there, b file:line
  and one moved to the next line with code, c to it (the new run's line
  first); an unknown command; the end of input (q: the program ended, the
  debugger's exit code 1)
*******************************************************************************/

/*
@@test
  kind run
  deps dbg.dbg_repl_sample
  args "<OUT>/bin/<CELL>/dbg_repl_sample.exe"
  exitcode 0
  | Adam debugger
  | Program: <OUT>/bin/<CELL>/dbg_repl_sample.exe
  | Type h for the commands
  | 1 breakpoint(s) from @breakpoint
  | Stopped (breakpoint) in dbg_repl_sample.Work at dbg_repl_sample.adam:46
  |      44  begin
  |      45    LSum := Add(ACount) + Add(1);
  | >>   46    @breakpoint;
  |      47    GTotal := LSum;
  |      48  end;
  | (dbg) h
  | Commands:
  |   b <file>:<line>  set a breakpoint (b <line>: in the current file)
  |   bl               list the breakpoints
  |   bd <n>           delete breakpoint n
  |   bc               delete every breakpoint
  |   c                continue
  |   n                step over (the next line)
  |   s                step into
  |   finish           step out
  |   bt               the call stack
  |   f <n>            select frame n (locals and p look at it)
  |   locals           the variables of the selected frame
  |   p <expr>         print a name, a field, an element or a target
  |   src              the source around the selected frame
  |   threads          the threads
  |   r                run the program again
  |   Ctrl+C           pause the running program
  |   h                this help
  |   q                quit (ends the program)
  | (dbg) bl
  | Breakpoint #1 at dbg_repl_sample.adam:46
  | (dbg) bt
  | >#0 dbg_repl_sample.Work at dbg_repl_sample.adam:46
  |  #1 dbg_repl_sample at dbg_repl_sample.adam:52
  |  #2 __adam_entry at dbg_repl_sample.adam:50
  | (dbg) locals
  | Params:
  |   ACount: int32 = 3
  | Locals:
  |   LSum: int32 = 6
  | Globals:
  |   GTotal: int32 = 0
  | (dbg) p LSum
  | LSum = 6
  | (dbg) p Nope
  | 'Nope' is no variable here
  | (dbg) f 1
  | >#1 dbg_repl_sample at dbg_repl_sample.adam:52
  |      50  begin
  |      51    println("start");
  | >>   52    Work(3);
  |      53    // the step-in line follows
  |      54    GTotal := Add(GTotal);
  | (dbg) f 9
  | No frame 9 (bt lists them)
  | (dbg) b 56
  | Breakpoint #2 at dbg_repl_sample.adam:56
  | (dbg) b nofile.adam:3
  | No module of the program is named nofile.adam
  | (dbg) b x
  | Usage: b <file>:<line>, or b <line> for the current file
  | (dbg) n
  | Stopped (step) in dbg_repl_sample.Work at dbg_repl_sample.adam:47
  |      45    LSum := Add(ACount) + Add(1);
  |      46    @breakpoint;
  | >>   47    GTotal := LSum;
  |      48  end;
  |      49
  | (dbg) finish
  | Stopped (step) in dbg_repl_sample at dbg_repl_sample.adam:54
  |      52    Work(3);
  |      53    // the step-in line follows
  | >>   54    GTotal := Add(GTotal);
  |      55    GTotal := GTotal + 1;
  |      56    println("total {}", GTotal);
  | (dbg) s
  | Stopped (step) in dbg_repl_sample.Add at dbg_repl_sample.adam:37
  |      35  func Add(const AValue: int32): int32;
  |      36  begin
  | >>   37    return AValue + 1;
  |      38  end;
  |      39
  | (dbg) finish
  | Stopped (step) in dbg_repl_sample at dbg_repl_sample.adam:54
  |      52    Work(3);
  |      53    // the step-in line follows
  | >>   54    GTotal := Add(GTotal);
  |      55    GTotal := GTotal + 1;
  |      56    println("total {}", GTotal);
  | (dbg) n
  | Stopped (step) in dbg_repl_sample at dbg_repl_sample.adam:55
  |      53    // the step-in line follows
  |      54    GTotal := Add(GTotal);
  | >>   55    GTotal := GTotal + 1;
  |      56    println("total {}", GTotal);
  |      57  end.
  | (dbg) src
  |      53    // the step-in line follows
  |      54    GTotal := Add(GTotal);
  | >>   55    GTotal := GTotal + 1;
  |      56    println("total {}", GTotal);
  |      57  end.
  | (dbg) c
  | Stopped (breakpoint) in dbg_repl_sample at dbg_repl_sample.adam:56
  |      54    GTotal := Add(GTotal);
  |      55    GTotal := GTotal + 1;
  | >>   56    println("total {}", GTotal);
  |      57  end.
  | (dbg) bd 1
  | Breakpoint #1 deleted
  | (dbg) bd 7
  | No breakpoint #7 (bl lists them)
  | (dbg) bc
  | All breakpoints deleted
  | (dbg) bl
  | No breakpoints
  | (dbg) c
  | start
  | total 8
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | Program exited with code 0
  | (dbg) p LSum
  | The program is not running: r starts it again
  | (dbg) r
  | Held at entry (no breakpoint would stop it): set one with b, c runs the program
  | (dbg) n
  | The program has not started yet: c runs it
  | (dbg) b dbg_repl_sample.adam:54
  | Breakpoint #3 at dbg_repl_sample.adam:54
  | (dbg) b dbg_repl_sample.adam:53
  | Breakpoint #4 at dbg_repl_sample.adam:53 (code at line 54)
  | (dbg) c
  | Stopped (breakpoint) in dbg_repl_sample at dbg_repl_sample.adam:54
  |      52    Work(3);
  |      53    // the step-in line follows
  | >>   54    GTotal := Add(GTotal);
  |      55    GTotal := GTotal + 1;
  |      56    println("total {}", GTotal);
  | (dbg) xyz
  | Unknown command: xyz (h shows the commands)
  | (dbg) <end of input>
  | run true exit code 1
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dbg_repl;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.Console, Adam.Debug.Targets, Adam.Debug.REPL;

type
  // The REPL's input a script, its output printed: each command echoed after the prompt
  ScriptIO = object(DebugREPLIO)
    FLines: StringArray;
    FAt: int64;

    override method ReadLine(var ALine: string): bool;
    begin
      if self.FAt >= len(self.FLines) then
        ALine := "";
        WriteText("<end of input>\n");
        return false;
      end;
      ALine := self.FLines[self.FAt];
      self.FAt := self.FAt + 1;
      WriteText(ALine + "\n");
      return true;
    end;

    override method Put(const AText: string);
    begin
      WriteText(AText);
    end;

    override const method IsConsole(): bool;
    begin
      return false;
    end;

    method Add(const ALine: string);
    begin
      setlength(self.FLines, len(self.FLines) + 1);
      self.FLines[len(self.FLines) - 1] := ALine;
    end;
  end;

var
  GIO: ref ScriptIO;
  GREPL: ref DebugREPL;
  GArgs: StringArray;
  GOk: bool;

begin
  GIO := ref ScriptIO();
  GIO.FAt := 0;
  GIO.Add("h");
  GIO.Add("bl");
  GIO.Add("bt");
  GIO.Add("locals");
  GIO.Add("p LSum");
  GIO.Add("p Nope");
  GIO.Add("f 1");
  GIO.Add("f 9");
  GIO.Add("b 56");
  GIO.Add("b nofile.adam:3");
  GIO.Add("b x");
  GIO.Add("n");
  GIO.Add("finish");
  GIO.Add("s");
  GIO.Add("finish");
  GIO.Add("n");
  GIO.Add("src");
  GIO.Add("c");
  GIO.Add("bd 1");
  GIO.Add("bd 7");
  GIO.Add("bc");
  GIO.Add("bl");
  GIO.Add("c");
  GIO.Add("p LSum");
  GIO.Add("r");
  GIO.Add("n");
  GIO.Add("b dbg_repl_sample.adam:54");
  GIO.Add("b dbg_repl_sample.adam:53");
  GIO.Add("c");
  GIO.Add("xyz");
  GREPL := ref DebugREPL(ADAM_DEBUG_WIN64_TRIPLE, paramstr(1), GArgs, "dbg_repl_sample.adam");
  GREPL.SetIO(GIO);
  // The compiler's folder (this exe runs from <OUT>\bin\<triple>\<mode>\): the $P: sources
  GREPL.SetProgramFolder(ResolvePath("$P:../../../.."));
  GOk := GREPL.Run();
  println("run {} exit code {}", GOk, GREPL.LastExitCode());
end.
