-------------------------------------------------------------------------------
  dbg_thunk_step.adam - a step into a thunk goes on to the routine it
  reaches (LX4c4): the compiler's Adam.Debug.* units (imported from its own
  src\) debug dbg_thunk_step_sample, which its dep built, through
  Debug.Runtime. A breakpoint on the call of the clink variadic Sum (its
  forwarder to its core): step into lands on Sum's first statement, the
  stack's next frame past the forwarder is the body's line; step out lands
  back on the call's line in the body (past the forwarder); over to the
  next line, the call of Twice through a routine value (its entry): step
  into lands on Twice's statement, out back in the body; then the run to
  its end
*******************************************************************************/

/*
@@test
  kind run
  deps dbg.dbg_thunk_step_sample
  args "<OUT>/bin/<CELL>/dbg_thunk_step_sample.exe"
  exitcode 0
  | launch true entry
  | breakpoint verified true line 60
  | continue true breakpoint id 1 line 60 dbg_thunk_step_sample
  | into true step line 45 dbg_thunk_step_sample.Sum
  | stack true
  |   frame 0 dbg_thunk_step_sample.Sum line 45
  |   frame 1 dbg_thunk_step_sample.Sum.adam_forward line 0
  |   frame 2 dbg_thunk_step_sample line 60
  | out true step line 60 dbg_thunk_step_sample
  | over true step line 61 dbg_thunk_step_sample
  | into true step line 55 dbg_thunk_step_sample.Twice
  | out true step line 61 dbg_thunk_step_sample
  | continue true exited code 0
  | output| 42
  | reports 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dbg_thunk_step;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Compiler.Diagnostics, Adam.Debug.Target, Adam.Debug.Symbols,
  Adam.Debug.Targets, Adam.Debug.Runtime;

const
  // The sample's file as the row names it (MatchSourceFile finds it by its name)
  SAMPLE_FILE: string = "dbg_thunk_step_sample.adam";
  // The line calling Sum directly
  SUM_LINE: int64 = 60;

var
  GReports: ref Diagnostics;
  GRuntime: ref DebugRuntime;

// A stop as the row shows it: its kind, a breakpoint's id, its line and routine
func DoStopText(const AStop: RuntimeStop): string;
var
  LText: string;
begin
  LText := RuntimeStopKindText(AStop.Kind);
  if AStop.Kind = RuntimeStopKind.Breakpoint then
    LText := LText + " id " + IntToStr(AStop.BreakpointId);
  end;
  if AStop.Kind = RuntimeStopKind.Exited then
    return LText + " code " + UIntToStr(uint64(AStop.ExitCode));
  end;
  if AStop.HasLine then
    LText := LText + " line " + UIntToStr(uint64(AStop.Source.Line));
  end;
  return LText + " " + AStop.Routine;
end;

var
  GStop: RuntimeStop;
  GBreakpoint: RuntimeBreakpoint;
  GFrames: StackFrameArray;
  GNoArgs: StringArray;
  GLines: StringArray;
  GOk: bool;
  GI: int64;

begin
  GReports := ref Diagnostics(100);
  GRuntime := ref DebugRuntime(DebugTargetFor(ADAM_DEBUG_WIN64_TRIPLE),
    DebugSymbolsFor(ADAM_DEBUG_WIN64_TRIPLE));
  GRuntime.SetDiagnostics(GReports);

  // The launch, held at the Entry; a breakpoint on the call of Sum and a continue to it
  GOk := GRuntime.Launch(paramstr(1), GNoArgs, DebugOutputMode.Pipes, GStop);
  println("launch {} {}", GOk, RuntimeStopKindText(GStop.Kind));
  GBreakpoint := GRuntime.SetBreakpoint(SAMPLE_FILE, SUM_LINE);
  println("breakpoint verified {} line {}", GBreakpoint.Verified, GBreakpoint.Source.Line);
  GOk := GRuntime.Continue(GStop);
  println("continue {} {}", GOk, DoStopText(GStop));

  // Into Sum through its forwarder; the stack there; out past the forwarder
  GOk := GRuntime.Step(RuntimeStepKind.Into, GStop);
  println("into {} {}", GOk, DoStopText(GStop));
  GOk := GRuntime.StackTrace(GFrames);
  println("stack {}", GOk);
  for GI := 0 to 2 do
    if GI < len(GFrames) then
      println("  frame {} {} line {}", GI, GFrames[GI].Routine.Name, GFrames[GI].Source.Line);
    end;
  end;
  GOk := GRuntime.Step(RuntimeStepKind.Out, GStop);
  println("out {} {}", GOk, DoStopText(GStop));

  // Over to the call through the routine value; into Twice through its entry; out again
  GOk := GRuntime.Step(RuntimeStepKind.Over, GStop);
  println("over {} {}", GOk, DoStopText(GStop));
  GOk := GRuntime.Step(RuntimeStepKind.Into, GStop);
  println("into {} {}", GOk, DoStopText(GStop));
  GOk := GRuntime.Step(RuntimeStepKind.Out, GStop);
  println("out {} {}", GOk, DoStopText(GStop));

  // The breakpoint out, the run to its end
  GRuntime.RemoveBreakpoint(GBreakpoint.Id);
  GOk := GRuntime.Continue(GStop);
  println("continue {} {}", GOk, DoStopText(GStop));
  GLines := SplitString(GRuntime.TakeOutput(), "\n");
  for GI := 0 to len(GLines) - 1 do
    if (Trim(GLines[GI]) <> "") and (not StartsStr("[Heap]", Trim(GLines[GI]))) then
      println("output| {}", Trim(GLines[GI]));
    end;
  end;
  println("reports {}", GReports.Count);
end.
