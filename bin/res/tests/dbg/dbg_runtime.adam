-------------------------------------------------------------------------------
  dbg_runtime.adam - Adam's debugger engine (M11a D3): the compiler's
  Adam.Debug.* units (imported from its own src\) debug
  dbg_runtime_sample, which its dep built, through Debug.Runtime. In
  order: a continue before any program (DB0014); a breakpoint asked for
  before the launch (not verified), the launch to the Entry, the
  breakpoints then (the @breakpoint's mark first, the asked one verified);
  a step from the Entry to the first statement; a breakpoint on the Twice
  line and a continue to it; step into Twice, into AddOne (on its first
  statement, past its locals), the stack and AddOne's scopes; step over,
  out (to Twice), over (both calls passed, back in the body); continue to
  the mark: every local of Values with its type and value, the children
  of the array, record, pointer and bitfield record, the globals (an
  object through its ref and weak, its parent part); evaluate of fields,
  ^, indexes, a qualified global and five that fail; a step from the mark,
  a continue to the asked breakpoint, its removal, the run to the end and
  the calls after it (DB0014)
*******************************************************************************/

/*
@@test
  kind run
  deps dbg.dbg_runtime_sample
  args "<OUT>/bin/<CELL>/dbg_runtime_sample.exe"
  exitcode 0
  | continue false
  | Error DB0014: no program is being debugged
  | asked 1 line 142 verified false
  | launch true entry
  | breakpoint 2 mark true verified true line 129
  | breakpoint 1 mark false verified true line 142
  | step true step line 134 dbg_runtime_sample
  | breakpoint 3 verified true line 140
  | continue true breakpoint id 3 line 140 dbg_runtime_sample
  | into true step line 79 dbg_runtime_sample.Twice
  | into true step line 71 dbg_runtime_sample.AddOne
  | stack true
  |   dbg_runtime_sample.AddOne line 71
  |   dbg_runtime_sample.Twice line 79
  |   dbg_runtime_sample line 140
  | scope Params
  |   AValue: int32 = 5
  | scope Locals
  |   LResult: int32 = 0
  |   LText: string = ""
  | scope Globals
  |   GCircle: ref Circle = {parent: {Name: "disc", Corner: {...}}, Radius: 0.5}
  |   GTitle: string = "runtime"
  |   GTotal: int32 = 0
  |   GWatch: weak Circle = {parent: {Name: "disc", Corner: {...}}, Radius: 0.5}
  | over true step line 72 dbg_runtime_sample.AddOne
  | out true step line 79 dbg_runtime_sample.Twice
  | over true step line 140 dbg_runtime_sample
  | continue true breakpoint id 2 line 129 dbg_runtime_sample.Values
  | params
  |   AStep: int32 = 3
  | locals
  |   LByte: int8 = -5
  |   LWord: uint16 = 65000
  |   LBig: int64 = -1234567890123
  |   LHalf: float32 = 1.5
  |   LReal: float64 = 2.25
  |   LYes: bool = true
  |   LChar: char = 'A'
  |   LWide: wchar = 'B'
  |   LText: string = "say \"hi\""
  |   LWideText: wstring = "wide"
  |   LList: array of int32 = [10, 20, 30] +
  |     [0]: int32 = 10
  |     [1]: int32 = 20
  |     [2]: int32 = 30
  |   LFixed: array[0..2] of int32 = [1, 2, 3] +
  |     [0]: int32 = 1
  |     [1]: int32 = 2
  |     [2]: int32 = 3
  |   LPoint: Point = {X: 3, Y: 4} +
  |     X: int32 = 3
  |     Y: int32 = 4
  |   LAt: ptr to Point = <ADDRESS> +
  |     ^: Point = {X: 3, Y: 4}
  |   LMood: Mood = Busy
  |   LMoods: Moods = [Calm, Done]
  |   LSmall: Small = [2, 5]
  |   LFlags: Flags = {Low: 5, High: 17} +
  |     Low: uint8 = 5
  |     High: uint8 = 17
  | globals
  |   GCircle: ref Circle = {parent: {Name: "disc", Corner: {...}}, Radius: 0.5} +
  |     parent: Shape = {Name: "disc", Corner: {X: 7, Y: 0}}
  |     Radius: float64 = 0.5
  |   GTitle: string = "runtime"
  |   GTotal: int32 = 12
  |   GWatch: weak Circle = {parent: {Name: "disc", Corner: {...}}, Radius: 0.5} +
  |     parent: Shape = {Name: "disc", Corner: {X: 7, Y: 0}}
  |     Radius: float64 = 0.5
  | eval true LPoint.Y = 4
  | eval true LAt^.X = 3
  | eval true LList[2] = 30
  | eval true LFixed[0] = 1
  | eval true GCircle.Name = "disc"
  | eval true GCircle.Corner.X = 7
  | eval true GWatch.Radius = 0.5
  | eval true dbg_runtime_sample.GTotal = 12
  | eval false LList[5] = index 5 is outside array of int32 (0..2)
  | eval false Nope = 'Nope' is no variable here
  | eval false LPoint[1] = Point cannot be indexed
  | eval false LPoint.Z = Point has no field 'Z'
  | eval false LPoint. = 'LPoint.' is not a name followed by fields, indexes and ^
  | pause false
  | over true step line 130 dbg_runtime_sample.Values
  | continue true breakpoint id 1 line 142 dbg_runtime_sample
  | remove true false
  | continue true exited code 0
  | output| runtime 16
  | continue false
  | Error DB0014: no program is being debugged
  | stack false
  | reports 3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dbg_runtime;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Compiler.Diagnostics, Adam.Debug.Target, Adam.Debug.Symbols,
  Adam.Debug.Targets, Adam.Debug.Runtime;

const
  // The sample's file as the row names it (MatchSourceFile finds it by its name)
  SAMPLE_FILE: string = "dbg_runtime_sample.adam";

var
  GReports: ref Diagnostics;
  GRuntime: ref DebugRuntime;

// A stop as the row shows it: its kind, a breakpoint's id, its line and routine
routine DoStopText(const AStop: RuntimeStop): string;
var
  LText: string;
begin
  LText := RuntimeStopKindText(AStop.Kind);
  if AStop.Kind = RuntimeStopKind.Breakpoint then
    LText := LText + " id " + IntToStr(AStop.BreakpointId);
  end;
  if AStop.Kind = RuntimeStopKind.Exited then
    return LText + " code " + UIntToStr(uint64(AStop.ExitCode));
  end;
  if AStop.HasLine then
    LText := LText + " line " + UIntToStr(uint64(AStop.Source.Line));
  end;
  return LText + " " + AStop.Routine;
end;

// A value's line (an address shown as <ADDRESS>: it differs per run), its children's below
// when AOpen
routine DoShowValue(const AValue: RuntimeValue; const AIndent: string; const AOpen: bool);
var
  LChildren: RuntimeValueArray;
  LText: string;
  LMore: string;
  LI: int64;
begin
  LText := AValue.Value;
  if StartsStr("0x", LText) then
    LText := "<ADDRESS>";
  end;
  LMore := "";
  if AOpen and (AValue.Reference <> 0) then
    LMore := " +";
  end;
  println("{}{}: {} = {}{}", AIndent, AValue.Name, AValue.TypeName, LText, LMore);
  if AOpen and GRuntime.Variables(AValue.Reference, LChildren) then
    for LI := 0 to len(LChildren) - 1 do
      DoShowValue(LChildren[LI], AIndent + "  ", false);
    end;
  end;
end;

// The variables of scope AScope of frame 0, each child list opened when AOpen
routine DoShowScope(const AScope: int64; const AOpen: bool);
var
  LScopes: RuntimeScopeArray;
  LValues: RuntimeValueArray;
  LI: int64;
begin
  GRuntime.Scopes(0, LScopes);
  GRuntime.Variables(LScopes[AScope].Reference, LValues);
  for LI := 0 to len(LValues) - 1 do
    DoShowValue(LValues[LI], "  ", AOpen);
  end;
end;

// AText evaluated in frame 0
routine DoEval(const AText: string);
var
  LValue: RuntimeValue;
  LOk: bool;
begin
  LOk := GRuntime.Evaluate(0, AText, LValue);
  println("eval {} {} = {}", LOk, AText, LValue.Value);
end;

var
  GStop: RuntimeStop;
  GBreakpoint: RuntimeBreakpoint;
  GBreakpoints: RuntimeBreakpointArray;
  GFrames: StackFrameArray;
  GScopes: RuntimeScopeArray;
  GValues: RuntimeValueArray;
  GNoArgs: StringArray;
  GLines: StringArray;
  GOk: bool;
  GI: int64;
  GJ: int64;

begin
  GReports := ref Diagnostics(100);
  GRuntime := ref DebugRuntime(DebugTargetFor(ADAM_DEBUG_WIN64_TRIPLE),
    DebugSymbolsFor(ADAM_DEBUG_WIN64_TRIPLE));
  GRuntime.SetDiagnostics(GReports);

  // Nothing to continue yet; a breakpoint that waits for the launch
  println("continue {}", GRuntime.Continue(GStop));
  println("{}", GReports.Items[GReports.Count - 1].Display());
  GBreakpoint := GRuntime.SetBreakpoint(SAMPLE_FILE, 142);
  println("asked {} line {} verified {}", GBreakpoint.Id, GBreakpoint.Line, GBreakpoint.Verified);

  // The launch: held at the Entry, the mark and the asked breakpoint in
  GOk := GRuntime.Launch(paramstr(1), GNoArgs, DebugOutputMode.Pipes, GStop);
  println("launch {} {}", GOk, RuntimeStopKindText(GStop.Kind));
  GBreakpoints := GRuntime.Breakpoints();
  for GI := 0 to len(GBreakpoints) - 1 do
    println("breakpoint {} mark {} verified {} line {}", GBreakpoints[GI].Id,
      GBreakpoints[GI].IsMark, GBreakpoints[GI].Verified, GBreakpoints[GI].Source.Line);
  end;

  // From the Entry to the first statement; a breakpoint on the Twice line
  GOk := GRuntime.Step(RuntimeStepKind.Over, GStop);
  println("step {} {}", GOk, DoStopText(GStop));
  GBreakpoint := GRuntime.SetBreakpoint(SAMPLE_FILE, 140);
  println("breakpoint {} verified {} line {}", GBreakpoint.Id, GBreakpoint.Verified,
    GBreakpoint.Source.Line);
  GOk := GRuntime.Continue(GStop);
  println("continue {} {}", GOk, DoStopText(GStop));

  // Into Twice, into AddOne (past its locals); the stack and the scopes there
  GOk := GRuntime.Step(RuntimeStepKind.Into, GStop);
  println("into {} {}", GOk, DoStopText(GStop));
  GOk := GRuntime.Step(RuntimeStepKind.Into, GStop);
  println("into {} {}", GOk, DoStopText(GStop));
  GOk := GRuntime.StackTrace(GFrames);
  println("stack {}", GOk);
  for GI := 0 to 2 do
    if GI < len(GFrames) then
      println("  {} line {}", GFrames[GI].Routine.Name, GFrames[GI].Source.Line);
    end;
  end;
  GRuntime.Scopes(0, GScopes);
  for GI := 0 to len(GScopes) - 1 do
    println("scope {}", GScopes[GI].Name);
    GRuntime.Variables(GScopes[GI].Reference, GValues);
    for GJ := 0 to len(GValues) - 1 do
      DoShowValue(GValues[GJ], "  ", false);
    end;
  end;

  // Over a line, out to Twice, over the rest of Twice (both calls) back to the body
  GOk := GRuntime.Step(RuntimeStepKind.Over, GStop);
  println("over {} {}", GOk, DoStopText(GStop));
  GOk := GRuntime.Step(RuntimeStepKind.Out, GStop);
  println("out {} {}", GOk, DoStopText(GStop));
  GOk := GRuntime.Step(RuntimeStepKind.Over, GStop);
  println("over {} {}", GOk, DoStopText(GStop));

  // The mark: every value
  GOk := GRuntime.Continue(GStop);
  println("continue {} {}", GOk, DoStopText(GStop));
  println("params");
  DoShowScope(0, true);
  println("locals");
  DoShowScope(1, true);
  println("globals");
  DoShowScope(2, true);
  DoEval("LPoint.Y");
  DoEval("LAt^.X");
  DoEval("LList[2]");
  DoEval("LFixed[0]");
  DoEval("GCircle.Name");
  DoEval("GCircle.Corner.X");
  DoEval("GWatch.Radius");
  DoEval("dbg_runtime_sample.GTotal");
  DoEval("LList[5]");
  DoEval("Nope");
  DoEval("LPoint[1]");
  DoEval("LPoint.Z");
  DoEval("LPoint.");
  println("pause {}", GRuntime.Pause());

  // On from the mark; the asked breakpoint, taken out; the end
  GOk := GRuntime.Step(RuntimeStepKind.Over, GStop);
  println("over {} {}", GOk, DoStopText(GStop));
  GOk := GRuntime.Continue(GStop);
  println("continue {} {}", GOk, DoStopText(GStop));
  println("remove {} {}", GRuntime.RemoveBreakpoint(1), GRuntime.RemoveBreakpoint(999));
  GOk := GRuntime.Continue(GStop);
  println("continue {} {}", GOk, DoStopText(GStop));
  GLines := SplitString(GRuntime.TakeOutput(), "\n");
  for GI := 0 to len(GLines) - 1 do
    if (Trim(GLines[GI]) <> "") and (not StartsStr("[Heap]", Trim(GLines[GI]))) then
      println("output| {}", Trim(GLines[GI]));
    end;
  end;
  println("continue {}", GRuntime.Continue(GStop));
  println("{}", GReports.Items[GReports.Count - 1].Display());
  println("stack {}", GRuntime.StackTrace(GFrames));
  println("reports {}", GReports.Count);
end.
