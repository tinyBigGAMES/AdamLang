-------------------------------------------------------------------------------
  dbg_symbols_sample.adam - the dep of dbg_symbols (M11a D2): a debug
  program three routines deep (the body calls Outer, Outer Middle, Middle
  Inner), each with parameters and locals of a builtin, a record, a
  choices, a static array and a pointer type, and globals of each kind.
  The row stops it on Inner's marked line, so a change here moves the
  row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_symbols_sample;

type
  Point = record
    X: int32;
    Y: int32;
  end;

  Mood = choices(Calm, Busy, Done);

var
  GTotal: int32;
  GName: string;
  GMood: Mood;

// The innermost routine: the row's breakpoint is on its sum line
routine Inner(const ACorner: Point; const AStep: int32): int32;
var
  LSum: int32;
  LParts: array[0..3] of int32;
  LAt: ptr to const Point;
begin
  LParts[0] := ACorner.X;
  LParts[1] := ACorner.Y;
  LParts[2] := AStep;
  LParts[3] := 0;
  LAt := addr of ACorner;
  // the row's breakpoint line is the one below
  LSum := LParts[0] + LParts[1] + LParts[2] + LAt->X;
  return LSum;
end;

routine Middle(const AValue: int32; const AFactor: int32): int32;
var
  LCorner: Point;
  LMood: Mood;
begin
  LCorner.X := AValue;
  LCorner.Y := AValue * AFactor;
  LMood := Mood.Busy;
  GMood := LMood;
  return Inner(LCorner, AFactor + 1);
end;

routine Outer(const AValue: int32): int32;
var
  LResult: int32;
begin
  LResult := Middle(AValue, 3);
  return LResult;
end;

begin
  GName := "symbols";
  GTotal := 41;
  GTotal := GTotal + Outer(5);
  println("{} {} {}", GName, GTotal, int32(GMood));
end.
