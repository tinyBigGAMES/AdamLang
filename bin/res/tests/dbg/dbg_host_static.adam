  dbg_host_static.adam - a host of dbg_dap_host (M11a D6): it imports
  dbg_host_lib's HostWork, so the loader loads the dll before the entry
*******************************************************************************/

/*
@@test
  kind dep
  deps dbg.dbg_host_lib
@@end
*/

module exe dbg_host_static;

@addlibrarypath "$P:output/bin/x86_64-windows-gnu/debug";

func HostWork(const AValue: int32): int32; external "dbg_host_lib";

begin
  println("static {}", HostWork(5));
end.
