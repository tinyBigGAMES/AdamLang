-------------------------------------------------------------------------------
  dbg_cli_host.adam - build -d --host (M11a D6a2): adam builds the dll
  dbg_host_lib, then debugs it in its console debugger inside
  dbg_host_static (its dep), the exe that loads it: the title names both,
  the dll's @breakpoint is the first stop (its lines, its source); then the
  end of input ends the session (adam's exit code the debugger's 1)
*******************************************************************************/

/*
@@test
  kind cli
  deps dbg.dbg_host_static
  args "build" "--no-banner" "--quiet" "<DIR>/dbg_host_lib.adam" "-o" "." "-d" "--host" "<OUT>/bin/<CELL>/dbg_host_static.exe"
  exitcode 1
  | Adam debugger
  | Program: <OUT>/bin/<CELL>/dbg_host_lib.dll
  | Host: <OUT>/bin/<CELL>/dbg_host_static.exe
  | Type h for the commands
  | 1 breakpoint(s) from @breakpoint
  | Stopped (breakpoint) in dbg_host_lib.HostWork at dbg_host_lib.adam:36
  |      34  begin
  |      35    LTwice := AValue * 2;
  | >>   36    @breakpoint;
  |      37    return LTwice + 1;
  |      38  end;
  | (dbg)
@@end
*/

module exe dbg_cli_host;

begin
  println("dbg_cli_host");
end.
