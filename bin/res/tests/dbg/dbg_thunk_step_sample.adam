-------------------------------------------------------------------------------
  dbg_thunk_step_sample.adam - the dep of dbg_thunk_step (LX4c4): a debug
  program calling the clink variadic Sum directly (its forwarder to its
  core, a thunk) and Twice through a routine value (its value entry, a
  thunk). The row's breakpoints are on the two call lines and steps into
  each lands on the callee's first statement, so a change here moves the
  row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_thunk_step_sample;

type
  Step = func(const AValue: int64): int64;

var
  GTotal: int64;
  GStep: Step;

// The ACount int64s after ACount, summed
func Sum(const ACount: int32; ...): int64;
var
  LSum: int64;
  LI: int32;
begin
  LSum := 0;
  for LI := 1 to ACount do
    LSum := LSum + varargs.next(int64);
  end;
  return LSum;
end;

// Twice AValue
func Twice(const AValue: int64): int64;
begin
  return AValue * 2;
end;

begin
  GStep := Twice;
  GTotal := Sum(2, int64(20), int64(1));
  GTotal := GStep(GTotal);
  println("{}", GTotal);
end.
