-------------------------------------------------------------------------------
  dbg_dap_host.adam - Adam's debug adapter in DLL mode (M11a D6): the dll
  dbg_host_lib debugged in the exe that loads it ("host"), over a channel
  of the row's as dbg_dap's (frames' paths in Windows' spelling; <- a response, -> an event; the program's
  output kept and printed as | lines after its session, since a pipe's
  output comes when the program flushes).

  Session 1 (static): the host imports the dll, so its debug information,
  its @breakpoint (new) and the client's breakpoint (changed, verified)
  are in at the launch; configurationDone stops at the client's line in
  HostWork, an argument read, continue to the @breakpoint, continue to the
  end. Session 2 (late): the host loads the dll after its start: the
  client's breakpoint waits unverified (not loaded yet), the load verifies
  it and adds the mark (changed, new), the stops come in the dll's code,
  the FreeLibrary takes the mark out (removed) and the breakpoint back to
  unverified (changed), the host runs to its end. Session 3: a dll with no
  host (error id 1), a host for an exe (error id 2), a dll as the host, a
  host that is no string.
*******************************************************************************/

/*
@@test
  kind run
  deps dbg.dbg_host_lib dbg.dbg_host_static dbg.dbg_host_late
  args "<OUT>/bin/<CELL>/dbg_host_static.exe"
  exitcode 0
  | == static
  | <- initialize
  | <- setBreakpoints
  |    not verified line 35 of dbg_host_lib.adam: no program is being debugged
  | <- launch
  | -> initialized
  | -> breakpoint new verified line 36 of dbg_host_lib.adam
  | -> breakpoint changed verified line 35 of dbg_host_lib.adam
  | <- configurationDone
  | -> stopped breakpoint
  | <- stackTrace
  |    #1 dbg_host_lib.HostWork dbg_host_lib.adam:35
  |    native path true
  | <- evaluate
  |    = 5 (int32)
  | <- continue
  | -> stopped breakpoint
  | <- stackTrace
  |    #1 dbg_host_lib.HostWork dbg_host_lib.adam:36
  |    native path true
  | <- continue
  | -> exited 0
  | -> terminated
  | <- disconnect
  | == exit 0
  |    | static 11
  |    | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  |    | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | == late
  | <- initialize
  | <- launch
  | -> initialized
  | <- setBreakpoints
  |    not verified line 35 of dbg_host_lib.adam: 'dbg_host_lib.dll' is not loaded yet: the breakpoint goes in when its host loads it
  | <- configurationDone
  | -> breakpoint new verified line 36 of dbg_host_lib.adam
  | -> breakpoint changed verified line 35 of dbg_host_lib.adam
  | -> stopped breakpoint
  | <- evaluate
  |    = 4 (int32)
  | <- continue
  | -> stopped breakpoint
  | <- continue
  | -> breakpoint removed id 2
  | -> breakpoint changed not verified line 35 of dbg_host_lib.adam: 'dbg_host_lib.dll' is not loaded yet: the breakpoint goes in when its host loads it
  | -> exited 0
  | -> terminated
  | <- disconnect
  | == exit 0
  |    | before load
  |    | late 9
  |    | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  |    | after free
  |    | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | == refused
  | <- initialize
  | <- launch failed (id 1): '<dir>/dbg_host_lib.dll' is a dll: launch it with "host", the exe that loads it
  | <- launch failed (id 2): '<dir>/dbg_host_static.exe' is a program: "host" is only for a dll
  | <- launch failed: the host '<dir>/dbg_host_lib.dll' is a library: the host must be an exe
  | <- launch failed: launch: the argument 'host' is missing or wrong
  | <- disconnect
  | == exit 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dbg_dap_host;

@addmodulepath "$P:../src";

import System.SysUtils, System.JSON.Ext, Adam.Protocol.Transport, Adam.Debug.DAP;

// A breakpoint as a line: its id when removed, else verified or not, its line, its file, why not
func DoBreakpointText(const ABreakpoint: JSON): string;
var
  LText: string;
begin
  if not ABreakpoint.Has("line") then
    return "id " + IntToStr(ABreakpoint.Get("id").AsInt64());
  end;
  LText := "line " + IntToStr(ABreakpoint.Get("line").AsInt64()) + " of " +
    ABreakpoint.Get("source.name").AsString();
  if ABreakpoint.Get("verified").AsBoolean() then
    return "verified " + LText;
  end;
  return "not verified " + LText + ": " + ABreakpoint.Get("message").AsString();
end;

// A response's body as the row shows it
func DoPrintBody(const ACommand: string; const ABody: JSON);
var
  LItems: array of JSON;
  LI: int64;
begin
  if ACommand = "setBreakpoints" then
    LItems := ABody.Get("breakpoints").Items();
    for LI := 0 to len(LItems) - 1 do
      println("   {}", DoBreakpointText(LItems[LI]));
    end;
  end;
  // the dll's own frame (the host's have no lines of the program)
  if ACommand = "stackTrace" then
    LItems := ABody.Get("stackFrames").Items();
    if len(LItems) > 0 then
      println("   #1 {} {}:{}", LItems[0].Get("name").AsString(),
        LItems[0].Get("source.name").AsString(""), LItems[0].Get("line").AsInt64());
      // the OS's own spelling: an editor matches it to its open tab as text
      println("   native path {}", IndexOf("/", LItems[0].Get("source.path").AsString(""), 0) < 0);
    end;
  end;
  if ACommand = "evaluate" then
    println("   = {} ({})", ABody.Get("result").AsString(), ABody.Get("type").AsString());
  end;
end;

type
  // The client's side (as dbg_dap's, the program's output kept until the session ends)
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FSeq: int64;
    FOutput: string;
    // The programs' folder, '/' separated: shown as <dir> in a message
    FDir: string;

    method Request(const ACommand: string; const AArguments: JSON);
    var
      LRequest: JSON;
      LBody: string;
    begin
      self.FSeq := self.FSeq + 1;
      LRequest.Add("seq", self.FSeq);
      LRequest.Add("type", "request");
      LRequest.Add("command", ACommand);
      LRequest.Add("arguments", AArguments);
      LBody := LRequest.ToString();
      self.FInput := self.FInput + "Content-Length: " + IntToStr(len(LBody)) + "\r\n\r\n" + LBody;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // a client waits for each answer: nothing is sent while the program runs
    override method HasPending(): bool;
    begin
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    method Shown(const AText: string): string;
    begin
      return ReplaceStr(ReplaceStr(AText, "\\", "/"), self.FDir, "<dir>");
    end;

    // One message the adapter wrote, short
    method Print(const ABody: string);
    var
      LMessage: JSON;
      LEvent: string;
    begin
      LMessage := JSON.FromString(ABody);
      if LMessage.Get("type").AsString() = "response" then
        if LMessage.Get("success").AsBoolean() then
          println("<- {}", LMessage.Get("command").AsString());
          DoPrintBody(LMessage.Get("command").AsString(), LMessage.Get("body"));
        else
          if LMessage.Has("body.error.id") then
            println("<- {} failed (id {}): {}", LMessage.Get("command").AsString(),
              LMessage.Get("body.error.id").AsInt64(), self.Shown(LMessage.Get("message").AsString()));
          else
            println("<- {} failed: {}", LMessage.Get("command").AsString(),
              self.Shown(LMessage.Get("message").AsString()));
          end;
        end;
        return;
      end;
      LEvent := LMessage.Get("event").AsString();
      if LEvent = "output" then
        if LMessage.Get("body.category").AsString() = "stdout" then
          self.FOutput := self.FOutput + LMessage.Get("body.output").AsString();
        else
          println("-> output {}: {}", LMessage.Get("body.category").AsString(),
            self.Shown(TrimRight(LMessage.Get("body.output").AsString())));
        end;
        return;
      end;
      if LEvent = "stopped" then
        println("-> stopped {}", LMessage.Get("body.reason").AsString());
        return;
      end;
      if LEvent = "breakpoint" then
        println("-> breakpoint {} {}", LMessage.Get("body.reason").AsString(),
          DoBreakpointText(LMessage.Get("body.breakpoint")));
        return;
      end;
      if LEvent = "exited" then
        println("-> exited {}", LMessage.Get("body.exitCode").AsInt64());
        return;
      end;
      // (thread events: the OS's own worker threads come and go, dbg_dap checks them)
      if LEvent = "thread" then
        return;
      end;
      println("-> {}", LEvent);
    end;
  end;

// A session over AChannel: its exit code, then the program's output lines
func DoServe(const ATitle: string; const AChannel: ref ScriptChannel);
var
  LCode: int32;
  LLines: StringArray;
  LI: int64;
begin
  println("== {}", ATitle);
  LCode := RunDAP(ref ProtocolTransport(AChannel), nil);
  println("== exit {}", LCode);
  LLines := SplitString(ReplaceStr(AChannel.FOutput, "\r", ""), "\n");
  for LI := 0 to len(LLines) - 1 do
    if len(LLines[LI]) > 0 then
      println("   | {}", LLines[LI]);
    end;
  end;
end;

func DoOne(const AKey: string; const AValue: string): JSON;
var
  LJSON: JSON;
begin
  LJSON.Add(AKey, AValue);
  return LJSON;
end;

// A dll launch: the dll, its host ("" none), the program's output through a pipe
func DoLaunchArgs(const AProgram: string; const AHost: string): JSON;
var
  LJSON: JSON;
begin
  LJSON.Add("program", AProgram);
  if len(AHost) > 0 then
    LJSON.Add("host", AHost);
  end;
  LJSON.Add("terminal", false);
  return LJSON;
end;

var
  GC: ref ScriptChannel;
  GNone: JSON;
  GArgs: JSON;
  GDir: string;
  GDLL: string;
  GLines: JSON;

begin
  GDir := ExtractFileDir(paramstr(1));
  GDLL := GDir + "/dbg_host_lib.dll";
  GLines := JSON.FromString("{\"source\": {\"path\": \"dbg_host_lib.adam\"}, " +
    "\"breakpoints\": [{\"line\": 35}]}");

  // Session 1: the dll loaded with its host, before the entry
  GC := ref ScriptChannel();
  GC.FDir := ReplaceStr(GDir, "\\", "/");
  GC.Request("initialize", GNone);
  GC.Request("setBreakpoints", GLines);
  GC.Request("launch", DoLaunchArgs(GDLL, GDir + "/dbg_host_static.exe"));
  GC.Request("configurationDone", GNone);
  GC.Request("stackTrace", GNone);
  GC.Request("evaluate", DoOne("expression", "AValue"));
  GC.Request("continue", GNone);
  GC.Request("stackTrace", GNone);
  GC.Request("continue", GNone);
  GC.Request("disconnect", GNone);
  DoServe("static", GC);

  // Session 2: the dll loaded and unloaded while the host runs
  GC := ref ScriptChannel();
  GC.FDir := ReplaceStr(GDir, "\\", "/");
  GC.Request("initialize", GNone);
  GC.Request("launch", DoLaunchArgs(GDLL, GDir + "/dbg_host_late.exe"));
  GC.Request("setBreakpoints", GLines);
  GC.Request("configurationDone", GNone);
  GC.Request("evaluate", DoOne("expression", "AValue"));
  GC.Request("continue", GNone);
  GC.Request("continue", GNone);
  GC.Request("disconnect", GNone);
  DoServe("late", GC);

  // Session 3: launches DLL mode refuses
  GC := ref ScriptChannel();
  GC.FDir := ReplaceStr(GDir, "\\", "/");
  GC.Request("initialize", GNone);
  GC.Request("launch", DoLaunchArgs(GDLL, ""));
  GC.Request("launch", DoLaunchArgs(GDir + "/dbg_host_static.exe", GDir + "/dbg_host_late.exe"));
  GC.Request("launch", DoLaunchArgs(GDLL, GDLL));
  GArgs := DoOne("program", GDLL);
  GArgs.Add("host", int64(3));
  GC.Request("launch", GArgs);
  GC.Request("disconnect", GNone);
  DoServe("refused", GC);
end.
