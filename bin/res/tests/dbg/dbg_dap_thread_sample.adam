-------------------------------------------------------------------------------
  dbg_dap_thread_sample.adam - the dep of dbg_dap's threads session (M11a
  D6c): the body starts one thread (ThreadStart), waits for its end
  (ThreadJoin) and prints what it did.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_dap_thread_sample;

var
  GDone: int64;

// The thread's work
routine Work(const AArg: ptr);
begin
  GDone := 42;
end;

begin
  ThreadJoin(ThreadStart(Work, nil));
  println("thread did {}", GDone);
end.
