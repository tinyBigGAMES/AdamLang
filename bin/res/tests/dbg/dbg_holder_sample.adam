-------------------------------------------------------------------------------
  dbg_holder_sample.adam - the dep of dbg_holder (F4c): a debug program
  whose module variable GItem and Show's local LItem keep a string in a C
  string field, so each has the compiler's hidden holder of the borrowed
  texts. The row stops it on Show's marked line, so a change here moves the
  row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_holder_sample;

type
  Item = record
    Label: ptr to const char;
    Size: int32;
  end;

var
  GItem: Item;
  GCount: int32;

// A local whose C string field borrows AText: it has a hidden holder
func Show(const AText: string): int32;
var
  LItem: Item;
  LSize: int32;
begin
  LItem.Label := AText;
  LSize := int32(len(AText));
  // the row stops here
  LItem.Size := LSize;
  return LItem.Size;
end;

begin
  GItem.Label := "module";
  GCount := Show("local");
  println("{} {}", GCount, GItem.Label <> nil);
end.
