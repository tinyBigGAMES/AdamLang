  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  dbg_dap.adam - Adam's debug adapter (M11a D5): Adam.Debug.DAP (imported
  from the compiler's own src\) serves scripted clients over a channel of
  the row's (requests in order, each flagged when it is sent while the
  program runs; every message the adapter writes printed short: <- a
  response, -> an event, the program's output lines as | lines).

  Session 1 debugs dbg_dap_sample (its dep): initialize, launch, a file's
  breakpoints (one with code, one past the end), configurationDone runs to
  the @breakpoint (announced as new), threads, the stack, scopes, locals,
  evaluate of a local and of an unknown name, next, continue to the
  client's breakpoint, stepIn into Add, stepOut back, continue to the end
  (exited 0, terminated), a stack asked after the end, disconnect: exit 0.
  Session 2 runs the sample with an argument (it spins): pause sent while
  it runs stops it, a global evaluated, pause while stopped refused,
  terminate sent while it runs ends it, disconnect (sessions 1 and 2 with
  "terminal": false: its output by a pipe, adamTerminalInput refused).
  Session 4 runs it on a terminal of its own (100 x 30): resized, a bad
  size and an input with no text refused, a line typed while it runs is
  read and printed back (its terminal text, VT sequences and all, checked
  for the lines only), input after the end refused. Session 5 runs it with
  noDebug (an editor's Run): its breakpoint answered unverified, the
  @breakpoint and the client's line run past, the program's output and its
  end, pause refused. Session 6 runs dbg_cli_release_build's exe (built at
  -opt fast: no debug information) with noDebug: no DB0010, its lines,
  exit 7 (D5e3). Sessions 7 and 8 debug dbg_dap_raise_sample (D6b):
  with the "all" exception filter each raise and the fault stop at their
  first chance (the stack through the OS's raise up to the sample's lines),
  the filter turned off while stopped; with no filter, next over a raising
  call stops at the except part that catches it, in the same routine or a
  frame above, and next over the faulting line likewise (first: next over
  a line ending in a call stops at the line starting at its return). Every initialize
  lists the one filter. Session 9 runs dbg_dap_thread_sample (D6c): the
  thread events it sends say a thread started and ended, every ended one
  started before (the OS's own worker threads come and go too: facts, no
  count). Session 3 is the bad
  input: no JSON, a request with no command, an unknown request, launch
  with no program / args no list / noDebug no bool / an unknown optimize
  level / a missing exe, requests that need a
  program, setBreakpoints with no path / breakpoints no list, a message
  with a bad header, setExceptionBreakpoints with filters no list and with
  an item that is no name, then the input ends with no disconnect: exit 1.
*******************************************************************************/

/*
@@test
  kind run
  deps dbg.dbg_dap_sample dbg.dbg_cli_release_build dbg.dbg_dap_raise_sample dbg.dbg_dap_thread_sample
  args "<OUT>/bin/<CELL>/dbg_dap_sample.exe"
  exitcode 0
  | == run
  | <- initialize
  |    configurationDone true
  |    exception filter all default false
  | <- launch
  | -> initialized
  | -> breakpoint new verified line 51 of dbg_dap_sample.adam
  | <- setBreakpoints
  |    verified line 58 of dbg_dap_sample.adam
  |    not verified line 9999 of dbg_dap_sample.adam: no code at or after line 9999
  | <- configurationDone
  | -> stopped breakpoint
  | <- threads
  |    main thread listed
  | <- stackTrace
  |    #1 dbg_dap_sample.Work dbg_dap_sample.adam:51
  |    #2 dbg_dap_sample dbg_dap_sample.adam:57
  |    #3 __adam_entry dbg_dap_sample.adam:55
  | <- scopes
  |    Params ref 1
  |    Locals ref 2
  |    Globals ref 3
  | <- variables
  |    LSum: int32 = 6
  | <- evaluate
  |    = 6 (int32)
  | <- evaluate failed: 'Nope' is no variable here
  | <- next
  | -> stopped step
  | <- continue
  | -> stopped breakpoint
  | <- stepIn
  | -> stopped step
  | <- stackTrace
  |    #1 dbg_dap_sample.Add dbg_dap_sample.adam:42
  |    #2 dbg_dap_sample dbg_dap_sample.adam:58
  |    #3 __adam_entry dbg_dap_sample.adam:55
  | <- stepOut
  | -> stopped step
  | <- stackTrace
  |    #1 dbg_dap_sample dbg_dap_sample.adam:58
  |    #2 __adam_entry dbg_dap_sample.adam:55
  | <- continue
  |    | start
  |    | total 7
  |    | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | -> exited 0
  | -> terminated
  | <- stackTrace failed: no program is being debugged
  | <- disconnect
  | == exit 0
  | == pause
  | <- initialize
  |    configurationDone true
  |    exception filter all default false
  | <- launch
  | -> initialized
  | -> breakpoint new verified line 51 of dbg_dap_sample.adam
  | <- configurationDone
  | -> stopped breakpoint
  | <- continue
  | <- pause
  | -> stopped pause
  | <- evaluate
  |    = 7 (int32)
  | <- pause failed: the program is not running
  | <- adamTerminalInput failed: adamTerminalInput failed
  | <- continue
  | <- terminate
  | -> exited 1
  | -> terminated
  | <- disconnect
  | == exit 0
  | == terminal
  | <- initialize
  |    configurationDone true
  |    exception filter all default false
  | <- launch
  | -> initialized
  | -> breakpoint new verified line 51 of dbg_dap_sample.adam
  | <- adamTerminalResize
  | <- adamTerminalResize failed: adamTerminalResize: the argument 'cols' is missing or wrong
  | <- adamTerminalInput failed: adamTerminalInput: the argument 'text' is missing or wrong
  | <- configurationDone
  | -> stopped breakpoint
  | <- continue
  | <- adamTerminalInput
  | -> exited 0
  | -> terminated
  | <- adamTerminalInput failed: no program is being debugged
  | <- disconnect
  |    terminal saw start true
  |    terminal saw got hello true
  | == exit 0
  | == nodebug
  | <- initialize
  |    configurationDone true
  |    exception filter all default false
  | <- launch
  | -> initialized
  | <- setBreakpoints
  |    not verified line 58 of dbg_dap_sample.adam: the program runs without debugging (noDebug): no breakpoints
  | <- configurationDone
  |    | start
  |    | total 7
  |    | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | -> exited 0
  | -> terminated
  | <- pause failed: no program is being debugged
  | <- disconnect
  | == exit 0
  | == release
  | <- initialize
  |    configurationDone true
  |    exception filter all default false
  | <- launch
  | -> initialized
  | <- configurationDone
  |    | release start
  |    | release end
  | -> exited 7
  | -> terminated
  | <- disconnect
  | == exit 0
  | == firstchance
  | <- initialize
  |    configurationDone true
  |    exception filter all default false
  | <- launch
  | -> initialized
  | <- setExceptionBreakpoints
  | <- configurationDone
  | -> stopped exception (exception 0xE0414441 (first chance))
  | <- stackTrace
  |    #1 (no source)
  |    #2 System.Runtime.Win64.PlatformRaise System.Runtime.Win64.adam:634
  |    #3 System.Runtime.RaiseWith System.Runtime.adam:5446
  |    #4 System.Runtime.Raise System.Runtime.adam:5530
  |    #5 dbg_dap_raise_sample.Fail dbg_dap_raise_sample.adam:40
  |    #6 dbg_dap_raise_sample dbg_dap_raise_sample.adam:53
  |    #7 __adam_entry dbg_dap_raise_sample.adam:50
  | <- continue
  | -> stopped exception (exception 0xE0414441 (first chance))
  | <- stackTrace
  |    #1 (no source)
  |    #2 System.Runtime.Win64.PlatformRaise System.Runtime.Win64.adam:634
  |    #3 System.Runtime.RaiseWith System.Runtime.adam:5446
  |    #4 System.Runtime.Raise System.Runtime.adam:5530
  |    #5 dbg_dap_raise_sample.Fail dbg_dap_raise_sample.adam:40
