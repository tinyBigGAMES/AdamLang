  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  dbg_dap.adam - Adam's debug adapter (M11a D5): Adam.Debug.DAP (imported
  from the compiler's own src\) serves scripted clients over a channel of
  the row's (requests in order, each flagged when it is sent while the
  program runs; every message the adapter writes printed short: <- a
  response, -> an event, the program's output lines as | lines).

  Session 1 debugs dbg_dap_sample (its dep): initialize, launch, a file's
  breakpoints (one with code, one past the end), configurationDone runs to
  the @breakpoint (announced as new), threads, the stack, scopes, locals,
  evaluate of a local and of an unknown name, next, continue to the
  client's breakpoint, stepIn into Add, stepOut back, continue to the end
  (exited 0, terminated), a stack asked after the end, disconnect: exit 0.
  Session 2 runs the sample with an argument (it spins): pause sent while
  it runs stops it, a global evaluated, pause while stopped refused,
  terminate sent while it runs ends it, disconnect (sessions 1 and 2 with
  "terminal": false: its output by a pipe, adamTerminalInput refused).
  Session 4 runs it on a terminal of its own (100 x 30): resized, a bad
  size and an input with no text refused, a line typed while it runs is
  read and printed back (its terminal text, VT sequences and all, checked
  for the lines only), input after the end refused. Session 3 is the bad
  input: no JSON, a request with no command, an unknown request, launch
  with no program / args no list / a missing exe, requests that need a
  program, setBreakpoints with no path / breakpoints no list, a message
  with a bad header, then the input ends with no disconnect: exit 1.
*******************************************************************************/

/*
@@test
  kind run
  deps dbg.dbg_dap_sample
  args "<OUT>/bin/<CELL>/dbg_dap_sample.exe"
  exitcode 0
  | == run
  | <- initialize
  |    configurationDone true
  | <- launch
  | -> initialized
  | -> breakpoint new verified line 51 of dbg_dap_sample.adam
  | <- setBreakpoints
  |    verified line 58 of dbg_dap_sample.adam
  |    not verified line 9999 of dbg_dap_sample.adam: no code at or after line 9999
  | <- configurationDone
  | -> stopped breakpoint
  | <- threads
  |    main thread listed
  | <- stackTrace
  |    #1 dbg_dap_sample.Work dbg_dap_sample.adam:51
  |    #2 dbg_dap_sample dbg_dap_sample.adam:57
  |    #3 __adam_entry dbg_dap_sample.adam:55
  | <- scopes
  |    Params ref 1
  |    Locals ref 2
  |    Globals ref 3
  | <- variables
  |    LSum: int32 = 6
  | <- evaluate
  |    = 6 (int32)
  | <- evaluate failed: 'Nope' is no variable here
  | <- next
  | -> stopped step
  | <- continue
  | -> stopped breakpoint
  | <- stepIn
  | -> stopped step
  | <- stackTrace
  |    #1 dbg_dap_sample.Add dbg_dap_sample.adam:42
  |    #2 dbg_dap_sample dbg_dap_sample.adam:58
  |    #3 __adam_entry dbg_dap_sample.adam:55
  | <- stepOut
  | -> stopped step
  | <- stackTrace
  |    #1 dbg_dap_sample dbg_dap_sample.adam:58
  |    #2 __adam_entry dbg_dap_sample.adam:55
  | <- continue
  |    | start
  |    | total 7
  |    | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | -> exited 0
  | -> terminated
  | <- stackTrace failed: no program is being debugged
  | <- disconnect
  | == exit 0
  | == pause
  | <- initialize
  |    configurationDone true
  | <- launch
  | -> initialized
  | -> breakpoint new verified line 51 of dbg_dap_sample.adam
  | <- configurationDone
  | -> stopped breakpoint
  | <- continue
  | <- pause
  | -> stopped pause
  | <- evaluate
  |    = 7 (int32)
  | <- pause failed: the program is not running
  | <- adamTerminalInput failed: adamTerminalInput failed
  | <- continue
  | <- terminate
  | -> exited 1
  | -> terminated
  | <- disconnect
  | == exit 0
  | == terminal
  | <- initialize
  |    configurationDone true
  | <- launch
  | -> initialized
  | -> breakpoint new verified line 51 of dbg_dap_sample.adam
  | <- adamTerminalResize
  | <- adamTerminalResize failed: adamTerminalResize: the argument 'cols' is missing or wrong
  | <- adamTerminalInput failed: adamTerminalInput: the argument 'text' is missing or wrong
  | <- configurationDone
  | -> stopped breakpoint
  | <- continue
  | <- adamTerminalInput
  | -> exited 0
  | -> terminated
  | <- adamTerminalInput failed: no program is being debugged
  | <- disconnect
  |    terminal saw start true
  |    terminal saw got hello true
  | == exit 0
  | == bad
  | -> output stderr: a message that is no DAP request was ignored
  | -> output stderr: a message that is no DAP request was ignored
  | <- frobnicate failed: unknown request 'frobnicate'
  | <- launch failed: launch needs a program: an .adam source or a built exe
  | <- launch failed: launch: the argument 'args' is missing or wrong
  | <- launch failed: the program to debug, '<dir>/dbg_dap_sample.exe.missing.exe', does not exist
  | <- stackTrace failed: no program is being debugged
  | <- continue failed: no program is being debugged
  | <- pause failed: no program is being debugged
  | <- terminate failed: no program is being debugged
  | <- setBreakpoints failed: setBreakpoints: the argument 'source.path' is missing or wrong
  | <- setBreakpoints failed: setBreakpoints: the argument 'breakpoints' is missing or wrong
  | <- setBreakpoints
  | <- threads
  | -> output stderr: a message with a bad header was skipped
  | <- initialize
  |    configurationDone true
  | == exit 1
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dbg_dap;

@addmodulepath "$P:../src";

import System.SysUtils, System.Json, Adam.Protocol.Transport, Adam.Debug.DAP;

// A breakpoint as a line: verified or not, its line, its file, why not
routine DoBreakpointText(const ABreakpoint: Json): string;
var
  LText: string;
begin
  LText := "line " + IntToStr(ABreakpoint.Get("line").AsInt64()) + " of " +
    ABreakpoint.Get("source.name").AsString();
  if ABreakpoint.Get("verified").AsBoolean() then
    return "verified " + LText;
  end;
  return "not verified " + LText + ": " + ABreakpoint.Get("message").AsString();
end;

// A response's body as the row shows it
routine DoPrintBody(const ACommand: string; const ABody: Json);
var
  LItems: array of Json;
  LI: int64;
  LName: string;
begin
  if ACommand = "initialize" then
    println("   configurationDone {}", ABody.Get("supportsConfigurationDoneRequest").AsBoolean());
  end;
  if ACommand = "setBreakpoints" then
    LItems := ABody.Get("breakpoints").Items();
    for LI := 0 to len(LItems) - 1 do
      println("   {}", DoBreakpointText(LItems[LI]));
    end;
  end;
  // (the OS's own worker threads come and go: only the main one is shown)
  if ACommand = "threads" then
    LItems := ABody.Get("threads").Items();
    for LI := 0 to len(LItems) - 1 do
      LName := LItems[LI].Get("name").AsString();
      if EndsStr("(main)", LName) then
        println("   main thread listed");
      end;
    end;
  end;
  if ACommand = "stackTrace" then
    LItems := ABody.Get("stackFrames").Items();
    for LI := 0 to len(LItems) - 1 do
      println("   #{} {} {}:{}", LItems[LI].Get("id").AsInt64(), LItems[LI].Get("name").AsString(),
        LItems[LI].Get("source.name").AsString(""), LItems[LI].Get("line").AsInt64());
    end;
  end;
  if ACommand = "scopes" then
    LItems := ABody.Get("scopes").Items();
    for LI := 0 to len(LItems) - 1 do
      println("   {} ref {}", LItems[LI].Get("name").AsString(),
        LItems[LI].Get("variablesReference").AsInt64());
    end;
  end;
  if ACommand = "variables" then
    LItems := ABody.Get("variables").Items();
    for LI := 0 to len(LItems) - 1 do
      println("   {}: {} = {}", LItems[LI].Get("name").AsString(),
        LItems[LI].Get("type").AsString(), LItems[LI].Get("value").AsString());
    end;
  end;
  if ACommand = "evaluate" then
    println("   = {} ({})", ABody.Get("result").AsString(), ABody.Get("type").AsString());
  end;
end;


type
  // The client's side (see the header)
  ScriptChannel = object(ProtocolChannel)
    FInput: string;
    FAt: int64;
    FStarts: Int64Array;
    FWhileRunning: BoolArray;
    FSeq: int64;
    FOutput: string;
    // The program's folder, '/' separated: shown as <dir> in a message
    FDir: string;
    // A terminal session: the program's text (VT sequences and all) kept whole, never printed
    FTerminal: bool;
    FAll: string;

    // A request of ACommand with AArguments, sent while the program runs when ARunning
    method Request(const ACommand: string; const AArguments: Json; const ARunning: bool);
    var
      LRequest: Json;
    begin
      self.FSeq := self.FSeq + 1;
      LRequest.Add("seq", self.FSeq);
      LRequest.Add("type", "request");
      LRequest.Add("command", ACommand);
      LRequest.Add("arguments", AArguments);
      self.Raw(LRequest.ToString(), ARunning);
    end;

    // ABody framed as it is
    method Raw(const ABody: string; const ARunning: bool);
    begin
      self.RawFramed("Content-Length: " + IntToStr(len(ABody)) + "\r\n\r\n" + ABody, ARunning);
    end;

    // AText sent as it is (its own header)
    method RawFramed(const AText: string; const ARunning: bool);
    var
      LCount: int64;
    begin
      LCount := len(self.FStarts);
      setlength(self.FStarts, LCount + 1);
      setlength(self.FWhileRunning, LCount + 1);
      self.FStarts[LCount] := len(self.FInput);
      self.FWhileRunning[LCount] := ARunning;
      self.FInput := self.FInput + AText;
    end;

    override method ReadBytes(const ABuffer: ptr; const ASize: int64): int64;
    var
      LCount: int64;
      LDest: ptr to uint8;
      LI: int64;
    begin
      LCount := len(self.FInput) - self.FAt;
      if LCount > ASize then
        LCount := ASize;
      end;
      LDest := ptr to uint8(ABuffer);
      for LI := 0 to LCount - 1 do
        LDest[LI] := uint8(self.FInput[self.FAt + LI]);
      end;
      self.FAt := self.FAt + LCount;
      return LCount;
    end;

    // The next message waits only when it is one sent while the program runs (a client
    // waits for each answer otherwise)
    override method HasPending(): bool;
    var
      LI: int64;
    begin
      for LI := 0 to len(self.FStarts) - 1 do
        if self.FStarts[LI] >= self.FAt then
          return self.FWhileRunning[LI];
        end;
      end;
      return false;
    end;

    override method WriteBytes(const ABuffer: ptr to const; const ASize: int64): bool;
    var
      LText: string;
      LAt: int64;
    begin
      LText := StringFromC(ptr to const char(ABuffer), ASize);
      LAt := IndexOf("\r\n\r\n", LText, 0);
      self.Print(Substring(LText, LAt + 4, len(LText) - LAt - 4));
      return true;
    end;

    // The program's output kept until a line is whole
    method TakeLines(const AText: string);
    var
      LAt: int64;
    begin
      if self.FTerminal then
        self.FAll := self.FAll + AText;
        return;
      end;
      self.FOutput := self.FOutput + AText;
      LAt := IndexOf("\n", self.FOutput, 0);
      while LAt >= 0 do
        println("   | {}", TrimRight(Substring(self.FOutput, 0, LAt)));
        self.FOutput := Substring(self.FOutput, LAt + 1, len(self.FOutput) - LAt - 1);
        LAt := IndexOf("\n", self.FOutput, 0);
      end;
    end;

    // One message the adapter wrote, short
    method Print(const ABody: string);
    var
      LMessage: Json;
      LEvent: string;
      LCategory: string;
    begin
      LMessage := Json.FromString(ABody);
      if LMessage.Get("type").AsString() = "response" then
        if LMessage.Get("success").AsBoolean() then
          println("<- {}", LMessage.Get("command").AsString());
          DoPrintBody(LMessage.Get("command").AsString(), LMessage.Get("body"));
        else
          println("<- {} failed: {}", LMessage.Get("command").AsString(),
            ReplaceStr(ReplaceStr(LMessage.Get("message").AsString(), "\\", "/"), self.FDir,
            "<dir>"));
        end;
        return;
      end;
      LEvent := LMessage.Get("event").AsString();
      if LEvent = "output" then
        LCategory := LMessage.Get("body.category").AsString();
        if LCategory = "stdout" then
          self.TakeLines(LMessage.Get("body.output").AsString());
        else
          println("-> output {}: {}", LCategory, TrimRight(LMessage.Get("body.output").AsString()));
        end;
        return;
      end;
      if LEvent = "stopped" then
        if LMessage.Has("body.description") then
          println("-> stopped {} ({})", LMessage.Get("body.reason").AsString(),
            LMessage.Get("body.description").AsString());
        else
          println("-> stopped {}", LMessage.Get("body.reason").AsString());
        end;
        return;
      end;
      if LEvent = "breakpoint" then
        println("-> breakpoint {} {}", LMessage.Get("body.reason").AsString(),
          DoBreakpointText(LMessage.Get("body.breakpoint")));
        return;
      end;
      if LEvent = "exited" then
        println("-> exited {}", LMessage.Get("body.exitCode").AsInt64());
        return;
      end;
      println("-> {}", LEvent);
    end;
  end;

// A session over AChannel: its exit code printed
routine DoServe(const ATitle: string; const AChannel: ref ScriptChannel);
var
  LCode: int32;
begin
  println("== {}", ATitle);
  LCode := RunDap(ref ProtocolTransport(AChannel), nil);
  if AChannel.FTerminal then
    println("   terminal saw start {}", IndexOf("start", AChannel.FAll, 0) >= 0);
    println("   terminal saw got hello {}", IndexOf("got hello", AChannel.FAll, 0) >= 0);
  end;
  println("== exit {}", LCode);
end;

// An object of one key / two keys
routine DoOne(const AKey: string; const AValue: string): Json;
var
  LJson: Json;
begin
  LJson.Add(AKey, AValue);
  return LJson;
end;

routine DoFrame(const AKey: string; const AValue: int64): Json;
var
  LJson: Json;
begin
  LJson.Add(AKey, AValue);
  return LJson;
end;

var
  GC: ref ScriptChannel;
  GNone: Json;
  GArgs: Json;
  GProgram: string;

begin
  GProgram := paramstr(1);

  // Session 1: a whole debug run
  GC := ref ScriptChannel();
  GC.FDir := ReplaceStr(ExtractFileDir(GProgram), "\\", "/");
  GC.Request("initialize", GNone, false);
  GArgs := DoOne("program", GProgram);
  GArgs.Add("terminal", false);
  GC.Request("launch", GArgs, false);
  GArgs := Json.FromString("{\"source\": {\"path\": \"dbg_dap_sample.adam\"}, " +
    "\"breakpoints\": [{\"line\": 58}, {\"line\": 9999}]}");
  GC.Request("setBreakpoints", GArgs, false);
  GC.Request("configurationDone", GNone, false);
  GC.Request("threads", GNone, false);
  GC.Request("stackTrace", GNone, false);
  GC.Request("scopes", DoFrame("frameId", 1), false);
  GC.Request("variables", DoFrame("variablesReference", 2), false);
  GC.Request("evaluate", DoOne("expression", "LSum"), false);
  GC.Request("evaluate", DoOne("expression", "Nope"), false);
  GC.Request("next", GNone, false);
  GC.Request("continue", GNone, false);
  GC.Request("stepIn", GNone, false);
  GC.Request("stackTrace", GNone, false);
  GC.Request("stepOut", GNone, false);
  GC.Request("stackTrace", GNone, false);
  GC.Request("continue", GNone, false);
  GC.Request("stackTrace", GNone, false);
  GC.Request("disconnect", GNone, false);
  DoServe("run", GC);

  // Session 2: pause and terminate while it runs
  GC := ref ScriptChannel();
  GC.FDir := ReplaceStr(ExtractFileDir(GProgram), "\\", "/");
  GC.Request("initialize", GNone, false);
  GArgs := DoOne("program", GProgram);
  GArgs.Add("terminal", false);
  GArgs.BeginArray("args");
  GArgs.Add("spin");
  GArgs.EndArray();
  GC.Request("launch", GArgs, false);
  GC.Request("configurationDone", GNone, false);
  GC.Request("continue", GNone, false);
  GC.Request("pause", GNone, true);
  GC.Request("evaluate", DoOne("expression", "GTotal"), false);
  GC.Request("pause", GNone, false);
  GC.Request("adamTerminalInput", DoOne("text", "x"), false);
  GC.Request("continue", GNone, false);
  GC.Request("terminate", GNone, true);
  GC.Request("disconnect", GNone, false);
  DoServe("pause", GC);

  // Session 4: the program on a terminal of its own: resized, a line typed into it
  GC := ref ScriptChannel();
  GC.FDir := ReplaceStr(ExtractFileDir(GProgram), "\\", "/");
  GC.FTerminal := true;
  GC.Request("initialize", GNone, false);
  GArgs := DoOne("program", GProgram);
  GArgs.Add("terminalCols", int64(100));
  GArgs.Add("terminalRows", int64(30));
  GArgs.BeginArray("args");
  GArgs.Add("echo");
  GArgs.EndArray();
  GC.Request("launch", GArgs, false);
  GArgs := DoFrame("cols", 90);
  GArgs.Add("rows", int64(20));
  GC.Request("adamTerminalResize", GArgs, false);
  GC.Request("adamTerminalResize", DoFrame("cols", 0), false);
  GC.Request("adamTerminalInput", GNone, false);
  GC.Request("configurationDone", GNone, false);
  GC.Request("continue", GNone, false);
  GC.Request("adamTerminalInput", DoOne("text", "hello\r"), true);
  GC.Request("adamTerminalInput", DoOne("text", "late"), false);
  GC.Request("disconnect", GNone, false);
  DoServe("terminal", GC);

  // Session 3: bad input, then the input ends
  GC := ref ScriptChannel();
  GC.FDir := ReplaceStr(ExtractFileDir(GProgram), "\\", "/");
  GC.Raw("not json", false);
  GC.Raw("{\"seq\": 1, \"type\": \"request\"}", false);
  GC.Request("frobnicate", GNone, false);
  GC.Request("launch", GNone, false);
  GArgs := DoOne("program", GProgram);
  GArgs.Add("args", "spin");
  GC.Request("launch", GArgs, false);
  GC.Request("launch", DoOne("program", GProgram + ".missing.exe"), false);
  GC.Request("stackTrace", GNone, false);
  GC.Request("continue", GNone, false);
  GC.Request("pause", GNone, false);
  GC.Request("terminate", GNone, false);
  GC.Request("setBreakpoints", GNone, false);
  GC.Request("setBreakpoints",
    Json.FromString("{\"source\": {\"path\": \"x.adam\"}, \"breakpoints\": 3}"), false);
  GC.Request("setBreakpoints", Json.FromString("{\"source\": {\"path\": \"x.adam\"}}"), false);
  GC.Request("threads", GNone, false);
  GC.RawFramed("Content-Length: lots\r\n\r\n", false);
  GC.Request("initialize", GNone, false);
  DoServe("bad", GC);
end.
