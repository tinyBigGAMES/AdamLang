-------------------------------------------------------------------------------
  dbg_cli_debug.adam - build -d (M11a D4): adam builds this program, then
  debugs it in its console debugger with the arguments after '--'. Its
  input is no console (adamtest's NUL), so the program's output comes
  through the debugger: the title, the @breakpoint as the first
  breakpoint and the run to it (the program's line, its argument, first),
  the stop's source; then the end of input ends the session (q: the
  program ended), adam's exit code the debugger's 1
*******************************************************************************/

/*
@@test
  kind cli
  targets x86_64-windows-gnu
  args "build" "--no-banner" "--quiet" "<DIR>/dbg_cli_debug.adam" "-o" "." "-d" "--" "x"
  exitcode 1
  | Adam debugger
  | Program: <OUT>/bin/<CELL>/dbg_cli_debug.exe
  | Type h for the commands
  | 1 breakpoint(s) from @breakpoint
  | [x]
  | Stopped (breakpoint) in dbg_cli_debug at dbg_cli_debug.adam:51
  |      49    println("[{}]", paramstr(1));
  |      50    FlushOutput();
  | >>   51    @breakpoint;
  |      52    println("after");
  |      53  end.
  | (dbg)
@@end
*/

module exe dbg_cli_debug;

begin
  println("[{}]", paramstr(1));
  FlushOutput();
  @breakpoint;
  println("after");
end.
