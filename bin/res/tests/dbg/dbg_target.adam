-------------------------------------------------------------------------------
  dbg_target.adam - Adam's debug target (M11a D1): the compiler's
  Adam.Debug.* units (imported from its own src\, beside bin\) run in this
  process and debug dbg_target_sample, which its dep built. In order: the
  Win32 records' sizes; a program that does not exist (DB0001); the sample
  launched with its output in a pipe: held at its start (a second Resume is
  DB0003), its Entry stop (the main thread listed, the image's "MZ" read,
  registers read, an unknown thread DB0004), a counted patch on its entry
  address hidden from reads, the Breakpoint stop there with the program
  counter on it, the registers written back as read, a Step past it (the
  patch kept), the patch removed count by count, then its run to the end:
  its output passed through and its exit code 7; last a second launch
  ended by Terminate at its Entry stop (exit code 1)
*******************************************************************************/

/*
@@test
  kind run
  deps dbg.dbg_target_sample
  args "<OUT>/bin/<CELL>/dbg_target_sample.exe"
  exitcode 0
  | sizes 176 1232
  | missing starts false
  | Error DB0001: the program to debug, 'no_such_program.exe', does not exist
  | started true
  | process-started main true image dbg_target_sample.exe base true
  | resume true
  | resume again false
  | Error DB0003: the program is not stopped at an event, so it cannot be resumed
  | stopped entry held true main listed true
  | image starts MZ
  | registers 18 18 pc true sp true
  | unknown thread false
  | Error DB0004: thread 0 is not a thread of the program
  | patch true true patched true hidden true
  | stopped breakpoint at entry true pc on patch true
  | written back true
  | stopped step moved true patch kept true hidden true
  | remove true patched true
  | remove true patched false
  | remove again false
  | process-exited 7 running false next false
  | output| sample args one two
  | output| sample done
  | output heap line true
  | terminate stopped entry
  | process-exited 1
  | reports 3
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dbg_target;

@addmodulepath "$P:../src";

import System.SysUtils, System.Windows.Debug, Adam.Compiler.Diagnostics, Adam.Debug.Target,
  Adam.Debug.Targets;

const
  // How long one wait for an event may take before the row gives up (ms)
  WAIT_MS: uint32 = 30000;

var
  GOutput: string;

// The next event a row looks at into AEvent: output is kept in GOutput, a module load is
// resumed, thread starts / ends and unloads are passed over (how many come is the OS's).
// False when none came in WAIT_MS
routine DoNext(const ATarget: ref DebugTarget; var AEvent: DebugEvent): bool;
begin
  while ATarget.NextEvent(AEvent, WAIT_MS) do
    match AEvent.Kind of
      DebugEventKind.Output:
        GOutput := GOutput + AEvent.OutputText;
      DebugEventKind.ModuleLoaded:
        ATarget.Resume(ResumeKind.Continue);
      DebugEventKind.ThreadStarted, DebugEventKind.ThreadExited, DebugEventKind.ModuleUnloaded:
        // nothing to show
    else
      return true;
    end;
  end;
  return false;
end;

// The last report on AReports, as Diagnostics shows it
routine DoLastReport(const AReports: ref Diagnostics): string;
begin
  return AReports.Items[AReports.Count - 1].Display();
end;

// A new Win64 debug target over AReports for AProgram with AArgs, its output in a pipe
routine DoTarget(const AReports: ref Diagnostics; const AProgram: string;
  const AArgs: StringArray): ref DebugTarget;
var
  LTarget: ref DebugTarget;
begin
  LTarget := DebugTargetFor(ADAM_DEBUG_WIN64_TRIPLE);
  LTarget.SetDiagnostics(AReports);
  LTarget.SetProgram(AProgram, AArgs);
  LTarget.SetOutputMode(DebugOutputMode.Pipes);
  return LTarget;
end;

// True when AThreadId is one of ATarget's threads
routine DoListed(const ATarget: ref DebugTarget; const AThreadId: uint32): bool;
var
  LThreads: DebugThreadIdArray;
  LI: int64;
begin
  LThreads := ATarget.Threads();
  for LI := 0 to len(LThreads) - 1 do
    if LThreads[LI] = AThreadId then
      return true;
    end;
  end;
  return false;
end;

// The sample's output lines, each shown after "output| " but its heap report, which is only
// said to be there (its numbers are the sample's own)
routine DoShowOutput();
var
  LLines: StringArray;
  LLine: string;
  LHeap: bool;
  LI: int64;
begin
  LLines := SplitString(GOutput, "\n");
  LHeap := false;
  for LI := 0 to len(LLines) - 1 do
    LLine := Trim(LLines[LI]);
    if StartsStr("[Heap]", LLine) then
      LHeap := true;
    else
      if LLine <> "" then
        println("output| {}", LLine);
      end;
    end;
  end;
  println("output heap line {}", LHeap);
end;

var
  GReports: ref Diagnostics;
  GTarget: ref DebugTarget;
  GEvent: DebugEvent;
  GContext: DebugContext;
  GBytes: ByteArray;
  GArgs: StringArray;
  GNoArgs: StringArray;
  GEntry: uint64;
  GOriginal: uint8;
  GSample: string;

begin
  println("sizes {} {}", size(DebugEventInfo), size(ThreadContext));
  GReports := ref Diagnostics(100);
  GSample := paramstr(1);

  // A program that is not there
  GTarget := DoTarget(GReports, "no_such_program.exe", GNoArgs);
  println("missing starts {}", GTarget.Start());
  println("{}", DoLastReport(GReports));

  // The sample: held at its start, then its Entry stop
  setlength(GArgs, 2);
  GArgs[0] := "one";
  GArgs[1] := "two";
  GTarget := DoTarget(GReports, GSample, GArgs);
  println("started {}", GTarget.Start());
  DoNext(GTarget, GEvent);
  println("{} main {} image {} base {}", DebugEventKindText(GEvent.Kind),
    GEvent.ThreadId = GTarget.MainThreadId(), ExtractFileName(GTarget.ImagePath()),
    (GEvent.Address = GTarget.ImageBase()) and (GEvent.Address <> 0));
  println("resume {}", GTarget.Resume(ResumeKind.Continue));
  println("resume again {}", GTarget.Resume(ResumeKind.Continue));
  println("{}", DoLastReport(GReports));
  DoNext(GTarget, GEvent);
  println("{} {} held {} main listed {}", DebugEventKindText(GEvent.Kind),
    DebugStopReasonText(GEvent.Reason), GTarget.IsHeld(), DoListed(GTarget, GTarget.MainThreadId()));
  GTarget.ReadMemory(GTarget.ImageBase(), 2, GBytes);
  println("image starts {}{}", char(GBytes[0]), char(GBytes[1]));
  GTarget.GetContext(GTarget.MainThreadId(), GContext);
  println("registers {} {} pc {} sp {}", len(GTarget.RegisterNames()), len(GContext.Registers),
    GContext.Pc <> 0, GContext.Sp <> 0);
  println("unknown thread {}", GTarget.GetContext(0, GContext));
  println("{}", DoLastReport(GReports));

  // A patch at the entry address, added twice (counted), hidden from a read
  GEntry := GTarget.EntryAddress();
  GTarget.ReadMemory(GEntry, 1, GBytes);
  GOriginal := GBytes[0];
  println("patch {} {} patched {} hidden {}", GTarget.AddPatch(GEntry), GTarget.AddPatch(GEntry),
    GTarget.IsPatched(GEntry), GTarget.ReadMemory(GEntry, 1, GBytes) and (GBytes[0] = GOriginal));
  GTarget.Resume(ResumeKind.Continue);
  DoNext(GTarget, GEvent);
  GTarget.GetContext(GEvent.ThreadId, GContext);
  println("{} {} at entry {} pc on patch {}", DebugEventKindText(GEvent.Kind),
    DebugStopReasonText(GEvent.Reason), GEvent.Address = GEntry, GContext.Pc = GEntry);
  println("written back {}", GTarget.SetContext(GEvent.ThreadId, GContext));

  // One instruction past the patch, which stays
  GTarget.Resume(ResumeKind.Step);
  DoNext(GTarget, GEvent);
  GTarget.GetContext(GEvent.ThreadId, GContext);
  println("{} {} moved {} patch kept {} hidden {}", DebugEventKindText(GEvent.Kind),
    DebugStopReasonText(GEvent.Reason), GContext.Pc <> GEntry, GTarget.IsPatched(GEntry),
    GTarget.ReadMemory(GEntry, 1, GBytes) and (GBytes[0] = GOriginal));
  println("remove {} patched {}", GTarget.RemovePatch(GEntry), GTarget.IsPatched(GEntry));
  println("remove {} patched {}", GTarget.RemovePatch(GEntry), GTarget.IsPatched(GEntry));
  println("remove again {}", GTarget.RemovePatch(GEntry));

  // To its end: its exit code and its output
  GTarget.Resume(ResumeKind.Continue);
  DoNext(GTarget, GEvent);
  println("{} {} running {} next {}", DebugEventKindText(GEvent.Kind), GEvent.ExitCode,
    GTarget.IsRunning(), GTarget.NextEvent(GEvent, 0));
  DoShowOutput();

  // Ended by Terminate at its Entry stop
  GTarget := DoTarget(GReports, GSample, GArgs);
  GTarget.Start();
  DoNext(GTarget, GEvent);
  GTarget.Resume(ResumeKind.Continue);
  DoNext(GTarget, GEvent);
  println("terminate {} {}", DebugEventKindText(GEvent.Kind), DebugStopReasonText(GEvent.Reason));
  GTarget.Terminate();
  DoNext(GTarget, GEvent);
  println("{} {}", DebugEventKindText(GEvent.Kind), GEvent.ExitCode);
  println("reports {}", GReports.Count);
end.
