-------------------------------------------------------------------------------
  dbg_target_sample.adam - the dep of dbg_target (M11a D1): the program the
  debugger runs. It prints its arguments and a last line, then ends with
  exit code 7, so a run under the debugger shows its output was passed
  through and its exit code kept
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_target_sample;

var
  GIndex: int32;

begin
  print("sample args");
  for GIndex := 1 to paramcount() do
    print(" {}", paramstr(GIndex));
  end;
  println("");
  println("sample done");
  return 7;
end.
