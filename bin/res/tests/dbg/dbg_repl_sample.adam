-------------------------------------------------------------------------------
  dbg_repl_sample.adam - the dep of dbg_repl (M11a D4): the body prints a
  line, calls Work (whose @breakpoint is the REPL's first breakpoint), then
  calls Add on its own line (a step into lands on Add's statement), adds
  one and prints the total. The row stops and steps on these lines, so a
  change here moves the row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_repl_sample;

var
  GTotal: int32;

// The step-in target
func Add(const AValue: int32): int32;
begin
  return AValue + 1;
end;

// Two calls, then the program's own breakpoint
func Work(const ACount: int32);
var
  LSum: int32;
begin
  LSum := Add(ACount) + Add(1);
  @breakpoint;
  GTotal := LSum;
end;

begin
  println("start");
  Work(3);
  // the step-in line follows
  GTotal := Add(GTotal);
  GTotal := GTotal + 1;
  println("total {}", GTotal);
end.
