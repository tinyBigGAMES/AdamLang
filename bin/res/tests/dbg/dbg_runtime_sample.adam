-------------------------------------------------------------------------------
  dbg_runtime_sample.adam - the dep of dbg_runtime (M11a D3): the body
  calls Twice, Twice calls AddOne twice on one line (AddOne's locals come
  before its first statement), then Values holds a value of every kind
  the debugger writes (integers of each size, floats, bool, char, wchar,
  string, wstring, a dynamic and a static array, a record, a pointer, a
  choices value, two sets, a record of bitfields) at its @breakpoint, and
  the globals hold an object (a ref with a parent part) and a weak to it.
  The row stops and steps on these lines, so a change here moves the
  row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_runtime_sample;

type
  Mood = choices(Calm, Busy, Done);
  Moods = set of Mood;
  Small = set of 1..10;

  Flags = record
    Low: uint8 : 3;
    High: uint8 : 5;
  end;

  Point = record
    X: int32;
    Y: int32;
  end;

  Shape = object
    Name: string;
    Corner: Point;
  end;

  Circle = object(Shape)
    Radius: float64;
  end;

var
  GTotal: int32;
  GTitle: string;
  GCircle: ref Circle;
  GWatch: weak Circle;

// The step-in target: a step into it stops on its first statement, past its locals
routine AddOne(const AValue: int32): int32;
var
  LResult: int32;
  LText: string;
begin
  LResult := AValue + 1;
  LText := "one";
  return LResult;
end;

// Two calls on one line: a step over passes both
routine Twice(const AValue: int32): int32;
begin
  return AddOne(AValue) + AddOne(AValue);
end;

// A value of every kind, shown at the @breakpoint
routine Values(const AStep: int32);
var
  LByte: int8;
  LWord: uint16;
  LBig: int64;
  LHalf: float32;
  LReal: float64;
  LYes: bool;
  LChar: char;
  LWide: wchar;
  LText: string;
  LWideText: wstring;
  LList: array of int32;
  LFixed: array[0..2] of int32;
  LPoint: Point;
  LAt: ptr to Point;
  LMood: Mood;
  LMoods: Moods;
  LSmall: Small;
  LFlags: Flags;
begin
  LByte := -5;
  LWord := 65000;
  LBig := -1234567890123;
  LHalf := 1.5;
  LReal := 2.25;
  LYes := true;
  LChar := 'A';
  LWide := wchar(66);
  LText := "say \"hi\"";
  LWideText := "wide";
  setlength(LList, 3);
  LList[0] := 10;
  LList[1] := 20;
  LList[2] := 30;
  LFixed[0] := 1;
  LFixed[1] := 2;
  LFixed[2] := 3;
  LPoint.X := 3;
  LPoint.Y := 4;
  LAt := addr of LPoint;
  LMood := Mood.Busy;
  LMoods := [Mood.Calm, Mood.Done];
  LSmall := [2, 5];
  LFlags.Low := 5;
  LFlags.High := 17;
  @breakpoint;
  GTotal := GTotal + AStep;
end;

begin
  GTitle := "runtime";
  GCircle := ref Circle();
  GCircle.Name := "disc";
  GCircle.Corner.X := 7;
  GCircle.Radius := 0.5;
  GWatch := GCircle;
  GTotal := Twice(5);
  Values(3);
  GTotal := GTotal + 1;
  println("{} {}", GTitle, GTotal);
end.
