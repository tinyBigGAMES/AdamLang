-------------------------------------------------------------------------------
  dbg_dap_sample.adam - the dep of dbg_dap (M11a D5): the body prints a
  line, calls Work (whose @breakpoint is the adapter's first stop), calls
  Add on its own line, prints the total; given "spin" it then spins until
  the debugger pauses and ends it, given "echo" it reads a line from its
  console and prints it back (the terminal session). The row sets breakpoints and steps
  on these lines, so a change here moves the row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_dap_sample;

import System.Console;

var
  GTotal: int32;
  GSpin: int64;
  GLine: string;

// The step-in target
func Add(const AValue: int32): int32;
begin
  return AValue + 1;
end;

// Two calls, then the program's own breakpoint
func Work(const ACount: int32);
var
  LSum: int32;
begin
  LSum := Add(ACount) + Add(1);
  @breakpoint;
  GTotal := LSum;
end;

begin
  println("start");
  Work(3);
  GTotal := Add(GTotal);
  println("total {}", GTotal);
  // "spin": spin until the debugger ends it (the pause session)
  if (paramcount() > 0) and (paramstr(1) = "spin") then
    while GSpin >= 0 do
      GSpin := GSpin + 1;
    end;
  end;
  // "echo": a line typed into its console printed back (the terminal session)
  if (paramcount() > 0) and (paramstr(1) = "echo") then
    if ReadLn(GLine) then
      println("got {}", GLine);
    end;
  end;
end.
