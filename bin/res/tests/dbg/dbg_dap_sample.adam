-------------------------------------------------------------------------------
  dbg_dap_sample.adam - the dep of dbg_dap (M11a D5): the body prints a
  line, calls Work (whose @breakpoint is the adapter's first stop), calls
  Add on its own line, prints the total; given any argument it then spins
  until the debugger pauses and ends it. The row sets breakpoints and steps
  on these lines, so a change here moves the row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_dap_sample;

var
  GTotal: int32;
  GSpin: int64;

// The step-in target
routine Add(const AValue: int32): int32;
begin
  return AValue + 1;
end;

// Two calls, then the program's own breakpoint
routine Work(const ACount: int32);
var
  LSum: int32;
begin
  LSum := Add(ACount) + Add(1);
  @breakpoint;
  GTotal := LSum;
end;

begin
  println("start");
  Work(3);
  GTotal := Add(GTotal);
  println("total {}", GTotal);
  // any argument: spin until the debugger ends it (the pause row)
  if paramcount() > 0 then
    while GSpin >= 0 do
      GSpin := GSpin + 1;
    end;
  end;
end.
