-------------------------------------------------------------------------------
  dbg_thunk.adam - forwarders are thunks in the debug information (LX4c3b):
  the compiler's Adam.Debug.* units (imported from its own src\) debug
  dbg_thunk_sample, which its dep built and which calls Inner through a
  routine value (Inner's value entry, a forwarder Lowering makes). Inner by
  name is Inner itself (its body on its first statement line, no thunk); a
  breakpoint on its marked line stops in Inner, the stack's next frame is
  the entry: a thunk under its own symbol (never a second Inner), its
  address its start, no line; then the module's body. Then the patch out
  and the sample run to its end
*******************************************************************************/

/*
@@test
  kind run
  deps dbg.dbg_thunk_sample
  args "<OUT>/bin/<CELL>/dbg_thunk_sample.exe"
  exitcode 0
  | started true
  | loaded true
  | routine true dbg_thunk_sample.Inner thunk false body line 44
  | patch true
  | stopped breakpoint at line true
  | walk true deep true
  |   frame 0 dbg_thunk_sample.Inner thunk false line true 44
  |   frame 1 dbg_thunk_sample.Inner.adam_entry thunk true line false 0
  |   frame 2 dbg_thunk_sample thunk false line true 50
  | thunk starts true body at start true
  | process-exited 0
  | output| 42
  | reports 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe dbg_thunk;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Compiler.Diagnostics, Adam.Debug.Target, Adam.Debug.Symbols,
  Adam.Debug.Targets;

const
  // How long one wait for an event may take before the row gives up (ms)
  WAIT_MS: uint32 = 30000;
  // The sample's file as its PDB names it, and the module prefix of its names
  SAMPLE_FILE: string = "$P:res/tests/dbg/dbg_thunk_sample.adam";
  SAMPLE_PREFIX: string = "dbg_thunk_sample.";
  // Inner's marked line (the sample's sum line)
  SAMPLE_LINE: int64 = 44;

var
  GOutput: string;
  GSystemPath: string;
  GSystemBase: uint64;

// The next event a row looks at into AEvent: output is kept in GOutput, a module load is
// resumed (the first one's path and base kept: a module with no Adam debug information),
// thread starts / ends and unloads are passed over. False when none came in WAIT_MS
func DoNext(const ATarget: ref DebugTarget; var AEvent: DebugEvent): bool;
begin
  while ATarget.NextEvent(AEvent, WAIT_MS) do
    match AEvent.Kind of
      DebugEventKind.Output:
        GOutput := GOutput + AEvent.OutputText;
      DebugEventKind.ModuleLoaded:
        if GSystemPath = "" then
          GSystemPath := AEvent.ModulePath;
          GSystemBase := AEvent.Address;
        end;
        ATarget.Resume(ResumeKind.Continue);
      DebugEventKind.ThreadStarted, DebugEventKind.ThreadExited, DebugEventKind.ModuleUnloaded:
        // nothing to show
    else
      return true;
    end;
  end;
  return false;
end;

var
  GReports: ref Diagnostics;
  GTarget: ref DebugTarget;
  GSymbols: ref DebugSymbols;
  GEvent: DebugEvent;
  GContext: DebugContext;
  GFrames: StackFrameArray;
  GRoutine: SymbolRoutine;
  GThunk: SymbolRoutine;
  GLine: SourceLine;
  GBodyLine: SourceLine;
  GNoArgs: StringArray;
  GLookup: uint64;
  GI: int64;
  GOk: bool;
  GLines: StringArray;

begin
  GReports := ref Diagnostics(100);

  // The sample, held at its start: its image's debug information
  GTarget := DebugTargetFor(ADAM_DEBUG_WIN64_TRIPLE);
  GTarget.SetDiagnostics(GReports);
  GTarget.SetProgram(paramstr(1), GNoArgs);
  GTarget.SetOutputMode(DebugOutputMode.Pipes);
  println("started {}", GTarget.Start());
  DoNext(GTarget, GEvent);
  GSymbols := DebugSymbolsFor(ADAM_DEBUG_WIN64_TRIPLE);
  GSymbols.SetDiagnostics(GReports);
  println("loaded {}", GSymbols.Load(GTarget));
  GTarget.Resume(ResumeKind.Continue);
  // The Entry stop
  DoNext(GTarget, GEvent);

  // Inner by name: the routine itself, never its entry
  GOk := GSymbols.RoutineByName(SAMPLE_PREFIX + "Inner", GRoutine);
  GSymbols.LineAt(GRoutine.BodyAddress, GBodyLine);
  println("routine {} {} thunk {} body line {}", GOk, GRoutine.Name, GRoutine.Thunk,
    GBodyLine.Line);

  // A breakpoint on the marked line; the stop's stack through the entry
  GSymbols.AddressOf(SAMPLE_FILE, SAMPLE_LINE, GLine);
  println("patch {}", GTarget.AddPatch(GLine.Address));
  GTarget.Resume(ResumeKind.Continue);
  DoNext(GTarget, GEvent);
  println("stopped {} at line {}", DebugStopReasonText(GEvent.Reason),
    GEvent.Address = GLine.Address);
  GTarget.GetContext(GEvent.ThreadId, GContext);
  GOk := GSymbols.StackWalk(GTarget, GEvent.ThreadId, GContext, 0, GFrames);
  println("walk {} deep {}", GOk, len(GFrames) >= 3);
  for GI := 0 to 2 do
    if GI < len(GFrames) then
      println("  frame {} {} thunk {} line {} {}", GI, GFrames[GI].Routine.Name,
        GFrames[GI].Routine.Thunk, GFrames[GI].HasLine, GFrames[GI].Source.Line);
    end;
  end;

  // The entry by its frame's address: a thunk from its start (no body past it)
  if len(GFrames) > 1 then
    GLookup := GFrames[1].Context.Pc - 1;
    GSymbols.RoutineAt(GLookup, GThunk);
    println("thunk starts {} body at start {}", GThunk.Address <= GLookup,
      GThunk.BodyAddress = GThunk.Address);
  end;

  // The patch out, the sample run to its end
  GTarget.RemovePatch(GLine.Address);
  GTarget.Resume(ResumeKind.Continue);
  while DoNext(GTarget, GEvent) do
    if GEvent.Kind = DebugEventKind.ProcessExited then
      println("{} {}", DebugEventKindText(GEvent.Kind), GEvent.ExitCode);
      leave;
    end;
    if GTarget.IsHeld() then
      GTarget.Resume(ResumeKind.Continue);
    end;
  end;
  GLines := SplitString(GOutput, "\n");
  for GI := 0 to len(GLines) - 1 do
    if (Trim(GLines[GI]) <> "") and (not StartsStr("[Heap]", Trim(GLines[GI]))) then
      println("output| {}", Trim(GLines[GI]));
    end;
  end;
  GSymbols.Close();
  println("reports {}", GReports.Count);
end.
