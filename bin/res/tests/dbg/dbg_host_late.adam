-------------------------------------------------------------------------------
  dbg_host_late.adam - a host of dbg_dap_host (M11a D6): it loads
  dbg_host_lib after its start (LoadLibraryExW, from its own folder), calls
  HostWork through the found function, then unloads it (FreeLibrary)
*******************************************************************************/

/*
@@test
  kind dep
  deps dbg.dbg_host_lib
@@end
*/

module exe dbg_host_late;

import System.Windows;

type
  HostWorkFn = func(const AValue: int32): int32;
  // The dll's UTF-16 name, its 64 KB buffer off the stack
  HostWide = final object
    Data: WideBuffer;
  end;

var
  GName: own HostWide;
  GModule: uint64;
  GWork: HostWorkFn;

begin
  println("before load");
  GName := own HostWide();
  UTF8ToWide("dbg_host_lib.dll", GName.Data);
  GModule := LoadLibraryExW(GName.Data, 0, 0);
  GWork := HostWorkFn(FindLoadedFunction("dbg_host_lib.dll", "HostWork"));
  println("late {}", GWork(4));
  FreeLibrary(GModule);
  println("after free");
end.
