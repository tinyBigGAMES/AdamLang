-------------------------------------------------------------------------------
  dbg_thunk_sample.adam - the dep of dbg_thunk (LX4c3b): a debug program
  calling Inner through a routine value, so the call runs through Inner's
  value entry (a forwarder Lowering makes: the PDB's thunk, never a second
  Inner). The row stops it on Inner's marked line, so a change here moves
  the row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe dbg_thunk_sample;

type
  Step = func(const AValue: int32): int32;

var
  GTotal: int32;
  GStep: Step;

// The routine called through GStep: the row's breakpoint is on its sum line
func Inner(const AValue: int32): int32;
var
  LSum: int32;
begin
  // the row's breakpoint line is the one below
  LSum := AValue + 1;
  return LSum;
end;

begin
  GStep := Inner;
  GTotal := GStep(41);
  println("{}", GTotal);
end.
