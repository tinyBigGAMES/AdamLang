-------------------------------------------------------------------------------
  dbg_cli_host_dll.adam - build -d of a dll with no --host (M11a D6a2): the
  dll is built, then CL0029 (a dll is debugged in the exe that loads it)
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--no-banner" "--quiet" "<DIR>/dbg_host_lib.adam" "-o" "." "-d"
  exitcode 1
  | Error CL0029: '<OUT>/bin/<CELL>/dbg_host_lib.dll' is a dll: debug it with --host <exe>, the program that loads it
@@end
*/

module exe dbg_cli_host_dll;

begin
  println("dbg_cli_host_dll");
end.
