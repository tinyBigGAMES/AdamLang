-------------------------------------------------------------------------------
  dbg_host_lib.adam - the dll of dbg_dap_host (M11a D6): built only; its
  HostWork has a line the row sets a breakpoint on, then its own
  @breakpoint. The row stops on these lines, so a change here moves the
  row's expected lines.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module dll dbg_host_lib;

// The row's breakpoint line, then the dll's own breakpoint
public routine HostWork(const AValue: int32): int32;
var
  LTwice: int32;
begin
  LTwice := AValue * 2;
  @breakpoint;
  return LTwice + 1;
end;

end.
