-------------------------------------------------------------------------------
  dbg_cli_debug_release.adam - build -opt safe -d (M11a D4): a release
  build writes no debug information, so the exe it wrote cannot be debugged
  (CL0025), exit 1, nothing run
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--no-banner" "--quiet" "<DIR>/dbg_cli_debug_release.adam" "-o" "." "-opt" "safe" "-d"
  exitcode 1
  | Error CL0025: '<OUT>/bin/x86_64-windows-gnu/release_safe/dbg_cli_debug_release.exe' was built without debug information, so it cannot be debugged: -d needs a debug build
@@end
*/

module exe dbg_cli_debug_release;

begin
  println("never run");
end.
