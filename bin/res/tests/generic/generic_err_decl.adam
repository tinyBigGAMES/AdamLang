-------------------------------------------------------------------------------
  generic_err_decl.adam - the generic declaration rules (BNF sec 10, PLAN-ADAM
  M10a): a generic routine is never clink nor external (SM0733), a generic
  method never virtual, override or abstract (SM0734); type arguments match
  the generic's parameters, none outside its own declaration, none on a
  type that is not generic (SM0735); a type parameter named twice or like
  a parameter (SM0004)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe generic_err_decl;

import System.SysUtils;

type
  Pair<K, V> = record
    Key: K;
    Value: V;
  end;

  Plain = record
    X: int32;
  end;

  Base = object
    virtual method Show();
    begin
    end;
  end;

  Shape = object
    virtual method Area<T>(): T; // ERROR SM0734@20
    begin
      return 0;
    end;
  end;

  Holder = object
    virtual method Keep<T>(const AItem: T); abstract; // ERROR SM0734@20
  end;

  Twice<T, T> = record // ERROR SM0004@12
    A: int32;
  end;

func clink Ident<T>(const A: T): T; // ERROR SM0733@12
begin
  return A;
end;

func Bound<T>(const A: T): T; external "c"; // ERROR SM0733@6

func Same<T>(const T: int32); // ERROR SM0004@14
begin
end;

var
  LOne: Pair<int32>; // ERROR SM0735@9
  LThree: Pair<int32, int32, int32>; // ERROR SM0735@11
  LBare: Pair; // ERROR SM0735@10
  LPlain: Plain<int32>; // ERROR SM0735@11

begin
end.
