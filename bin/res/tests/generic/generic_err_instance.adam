-------------------------------------------------------------------------------
  generic_err_instance.adam - errors in generic instances (BNF sec 10,
  PLAN-ADAM M10b): an error only an instance has is at the generic's
  line with a hint at the use that made the instance (SM0737); an error
  that does not depend on a type argument is reported once, at the
  template, however many instances there are; an instance needing ever
  bigger instances stops at the depth limit (SM0736)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe generic_err_instance;

import System.SysUtils;

type
  Box<T> = object
    hidden FValue: T;
    method Twice(): T;
    begin
      return self.FValue + self.FValue; // ERROR SM0250@14
    end;
    method Plain(): int32;
    begin
      return "text"; // ERROR SM0200@14
    end;
  end;

  Pair<K, V> = record
    Key: K;
    Value: V;
  end;

  Grow<T> = object
    Next: ptr to Grow<Pair<T, T>>; // ERROR SM0736@23
  end;

var
  GInts: Box<int32>;
  GFlags: Box<bool>; // HINT SM0737@11
  GGrow: Grow<int32>;

begin
  println("{}", GInts.Twice());
end.
