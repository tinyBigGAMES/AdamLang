-------------------------------------------------------------------------------
  generic_routine.adam - generic routines and methods called with their
  type arguments named (BNF sec 10, PLAN-ADAM M10c): one instance per
  argument list (a clone of the generic, each type parameter bound),
  typed and lowered on its own: T's operators decided per instance, var
  parameters of T, a managed T, an instance returning a generic type's
  instance, a generic calling a generic with its own T, a recursive
  instance, overloads by type argument count beside a plain routine of
  the same name, generic methods of a plain object (self through the
  instance), a generic method of a generic object using both type
  parameters, a public and a private generic
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | max 7 9 b
  | swap 2 1 y x
  | pair k 42
  | big 9 30
  | sum 10
  | show1 5
  | show2 s 6
  | plain 7
  | bag 5 15
  | echo e
  | with 3 true
  | twice 42 hihi
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_routine;

import System.SysUtils;

type
  Pair<K, V> = record
    Key: K;
    Value: V;
  end;

  Bag = object
    hidden FTotal: int64;
    method Add<T>(const AValue: T): int64;
    begin
      self.FTotal := self.FTotal + int64(AValue);
      return self.FTotal;
    end;
    method Echo<T>(const AValue: T): T;
    begin
      return AValue;
    end;
  end;

  Box<T> = object
    hidden FValue: T;
    method Put(const AValue: T);
    begin
      self.FValue := AValue;
    end;
    method With<U>(const AOther: U): Pair<T, U>;
    var
      LPair: Pair<T, U>;
    begin
      LPair.Key := self.FValue;
      LPair.Value := AOther;
      return LPair;
    end;
  end;

func Max<T>(const A: T; const B: T): T;
begin
  if A > B then
    return A;
  end;
  return B;
end;

func Swap<T>(var A: T; var B: T);
var
  LTemp: T;
begin
  LTemp := A;
  A := B;
  B := LTemp;
end;

func MakePair<K, V>(const AKey: K; const AValue: V): Pair<K, V>;
var
  LPair: Pair<K, V>;
begin
  LPair.Key := AKey;
  LPair.Value := AValue;
  return LPair;
end;

func Biggest<T>(const A: T; const B: T; const C: T): T;
begin
  return Max<T>(Max<T>(A, B), C);
end;

func Sum<T>(const AN: T): T;
begin
  if AN = 0 then
    return 0;
  end;
  return AN + Sum<T>(AN - 1);
end;

func Show<T>(const A: T);
begin
  println("show1 {}", A);
end;

func Show<T, U>(const A: T; const B: U);
begin
  println("show2 {} {}", A, B);
end;

func Show(const A: int32);
begin
  println("plain {}", A);
end;

public func Twice<T>(const A: T): T;
begin
  return A + A;
end;

var
  GA: int32;
  GB: int32;
  GS: string;
  GT: string;
  GP: Pair<string, int64>;
  GBag: Bag;
  GBox: Box<int32>;
  GQ: Pair<int32, bool>;

begin
  println("max {} {} {}", Max<int32>(3, 7), Max<int64>(9, 2), Max<string>("ab", "b"));
  GA := 1;
  GB := 2;
  Swap<int32>(GA, GB);
  GS := "x";
  GT := "y";
  Swap<string>(GS, GT);
  println("swap {} {} {} {}", GA, GB, GS, GT);
  GP := MakePair<string, int64>("k", 42);
  println("pair {} {}", GP.Key, GP.Value);
  println("big {} {}", Biggest<int32>(4, 9, 6), Biggest<int64>(10, 30, 20));
  println("sum {}", Sum<int64>(4));
  Show<int32>(5);
  Show<string, int32>("s", 6);
  Show(7);
  println("bag {} {}", GBag.Add<int32>(5), GBag.Add<int64>(10));
  println("echo {}", GBag.Echo<string>("e"));
  GBox.Put(3);
  GQ := GBox.With<bool>(true);
  println("with {} {}", GQ.Key, GQ.Value);
  println("twice {} {}", Twice<int32>(21), Twice<string>("hi"));
end.
