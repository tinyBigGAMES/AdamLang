-------------------------------------------------------------------------------
  generic_mangle.adam - a generic routine's instance is named as clang
  names a function template's instance (BNF sec 10, DESIGN sec 2, PLAN-ADAM
  M10e): <name> I <type arguments> E, then the return type and the
  parameters as the template declares them, each type parameter its
  template parameter (T_, T0_), substitutions counted as clang counts
  them (the template's prefix, T_, a dependent pointer, reference, class
  instance, routine type, adam::dynarray and a generic alias, transparent).
  Each instance is made by an Adam call, then reached again by an external
  routine binding the name clang writes for the same C++ template
  (tests\probe\m10e_scratch\mangle.cpp): a wrong name does not link. Two
  clink adapters of one public generic (two routine types) each get a
  symbol of their own
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | adam 7 2.5 3 7
  | adam 7 3 11 5 2.5 7 12 4 4
  | clang 7 2.5 7 7
  | clang 3 7 11 5 2.5 3 12 4 4
  | adapters 8 2.5
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_mangle;

import System.SysUtils;

type
  Point = record
    X: int32;
    Y: int32;
  end;

  Box<T> = record
    V: T;
  end;

  Vec<T> = array of T;

  IntOp = routine(const A: int32; const B: int32): int32;
  RealOp = routine(const A: float64; const B: float64): float64;

public routine Max<T>(const A: T; const B: T): T;
begin
  if A > B then
    return A;
  end;
  return B;
end;

public routine First<T>(const AP: ptr to T): T;
begin
  return AP^;
end;

public routine Swap<T>(var A: T; var B: T);
var
  LTemp: T;
begin
  LTemp := A;
  A := B;
  B := LTemp;
end;

public routine Fill<T>(const AN: int32; const AV: T): T;
begin
  return AV;
end;

public routine GetX<T>(const AA: T): int32;
begin
  return AA.X;
end;

public routine Unbox<T>(const AB: Box<T>): T;
begin
  return AB.V;
end;

public routine Pick<A, B>(const AA: A; const AB: B): B;
begin
  return AB;
end;

public routine Make<T>(const AA: T): Box<T>;
var
  LBox: Box<T>;
begin
  LBox.V := AA;
  return LBox;
end;

public routine Keep<T>(const AA: ptr to T; const AB: ptr to T): ptr to T;
begin
  return AA;
end;

public routine Twice<T>(const AOp: routine(const A: T; const B: T): T; const AA: T): T;
begin
  return AOp(AA, AA);
end;

public routine Len<T>(const AA: array of T): int64;
begin
  return len(AA);
end;

public routine Count<T>(const AV: Vec<T>): int64;
begin
  return len(AV);
end;

public routine Add(const A: int32; const B: int32): int32;
begin
  return A + B;
end;

// The same instances by the names clang writes for them
routine cpplink XMax(const A: int32; const B: int32): int32; external name "_ZN14generic_mangle3MaxIiEET_S1_S1_";
routine cpplink XMaxReal(const A: float64; const B: float64): float64; external name "_ZN14generic_mangle3MaxIdEET_S1_S1_";
routine cpplink XFirst(const AP: ptr to int32): int32; external name "_ZN14generic_mangle5FirstIiEET_PS1_";
routine cpplink XSwap(var A: int32; var B: int32); external name "_ZN14generic_mangle4SwapIiEEvRT_S2_";
routine cpplink XFill(const AN: int32; const AV: int32): int32; external name "_ZN14generic_mangle4FillIiEET_iS1_";
routine cpplink XGetX(const AA: Point): int32; external name "_ZN14generic_mangle4GetXINS_5PointEEEiRKT_";
routine cpplink XUnbox(const AB: Box<int32>): int32; external name "_ZN14generic_mangle5UnboxIiEET_RKNS_3BoxIS1_EE";
routine cpplink XPick(const AA: int32; const AB: float64): float64; external name "_ZN14generic_mangle4PickIidEET0_T_S1_";
routine cpplink XMake(const AA: int32): Box<int32>; external name "_ZN14generic_mangle4MakeIiEENS_3BoxIT_EES2_";
routine cpplink XKeep(const AA: ptr to int32; const AB: ptr to int32): ptr to int32; external name "_ZN14generic_mangle4KeepIiEEPT_S2_S2_";
routine cpplink XTwice(const AOp: IntOp; const AA: int32): int32; external name "_ZN14generic_mangle5TwiceIiEET_PFS1_S1_S1_ES1_";
routine cpplink XLen(const AA: array of int32): int64; external name "_ZN14generic_mangle3LenIiEExRKN4adam8dynarrayIT_EE";
routine cpplink XCount(const AV: array of int32): int64; external name "_ZN14generic_mangle5CountIiEExRKN4adam8dynarrayIT_EE";

var
  GA: int32;
  GB: int32;
  GR: float64;
  GS: float64;
  GPoint: Point;
  GBox: Box<int32>;
  GList: array of int32;
  GInt: IntOp;
  GReal: RealOp;

begin
  GA := 3;
  GB := 7;
  GR := 1.5;
  GS := 2.5;
  GPoint.X := 11;
  GPoint.Y := 12;
  setlength(GList, 4);
  // the instances, made by Adam's own calls
  println("adam {} {} {} {}", Max(GA, GB), Max(GR, GS), First(addr of GA), Fill(1, GB));
  Swap(GA, GB);
  GBox := Make<int32>(5);
  println("adam {} {} {} {} {} {} {} {} {}", GA, GB, GetX(GPoint), Unbox(GBox), Pick(GA, GS),
    Keep(addr of GA, addr of GB)^, Twice<int32>(Add, 6), Len(GList), Count<int32>(GList));
  // the same instances through clang's names
  println("clang {} {} {} {}", XMax(GA, GB), XMaxReal(GR, GS), XFirst(addr of GA), XFill(1, GA));
  XSwap(GA, GB);
  GBox := XMake(5);
  println("clang {} {} {} {} {} {} {} {} {}", GA, GB, XGetX(GPoint), XUnbox(GBox), XPick(GA, GS),
    XKeep(addr of GA, addr of GB)^, XTwice(Add, 6), XLen(GList), XCount(GList));
  // two clink adapters of Max: one symbol each
  GInt := Max;
  GReal := Max;
  println("adapters {} {}", GInt(3, 8), GReal(GR, GS));
end.
