-------------------------------------------------------------------------------
  generic_list_arg.adam - An indexed property's element as a call's argument
  (M7d's fix): List<ByteArray>.Items[i] and List<string>.Items[i] (a dynamic
  array, a text: T looks like what an [ ] reaches into) given to a const
  parameter of a routine and a method that drop the list's items before
  they read the argument: the element is the accessor's result, kept by
  the caller for the call (never anchored as an element of the list),
  nothing leaked
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | bytes 3 sum 6
  | text 'pear' 4
  | method 3 sum 6
  | left 0 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_list_arg;

import System.SysUtils, System.Collections;

type
  // A holder of a list its method empties before reading the argument
  Keeper = object
    Items: ref List<ByteArray>;

    init();
    begin
      self.Items := ref List<ByteArray>();
    end;

    // The list cleared, then the argument summed
    method Drain(const ABytes: ByteArray): int64;
    var
      LSum: int64;
      LI: int64;
    begin
      self.Items.Clear();
      LSum := 0;
      for LI := 0 to len(ABytes) - 1 do
        LSum := LSum + int64(ABytes[LI]);
      end;
      return LSum;
    end;
  end;

var
  GBytes: ref List<ByteArray>;
  GTexts: ref List<string>;

// GBytes cleared, then ABytes summed
routine SumAfterClear(const ABytes: ByteArray);
var
  LSum: int64;
  LI: int64;
begin
  GBytes.Clear();
  LSum := 0;
  for LI := 0 to len(ABytes) - 1 do
    LSum := LSum + int64(ABytes[LI]);
  end;
  println("bytes {} sum {}", len(ABytes), LSum);
end;

// GTexts cleared, then AText shown
routine ShowAfterClear(const AText: string);
begin
  GTexts.Clear();
  println("text '{}' {}", AText, len(AText));
end;

var
  LBytes: ByteArray;
  LKeeper: ref Keeper;
  LI: int64;

begin
  setlength(LBytes, 3);
  for LI := 0 to 2 do
    LBytes[LI] := uint8(LI + 1);
  end;
  GBytes := ref List<ByteArray>();
  GBytes.Add(LBytes);
  SumAfterClear(GBytes.Items[0]);
  GTexts := ref List<string>();
  GTexts.Add("pe" + "ar");
  ShowAfterClear(GTexts.Items[0]);
  LKeeper := ref Keeper();
  LKeeper.Items.Add(LBytes);
  println("method {} sum {}", len(LBytes), LKeeper.Drain(LKeeper.Items.Items[0]));
  println("left {} {}", GBytes.Count, LKeeper.Items.Count);
end.
