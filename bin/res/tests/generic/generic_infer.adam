-------------------------------------------------------------------------------
  generic_infer.adam - generic routines and methods called with their
  type arguments inferred (BNF sec 10, PLAN-ADAM M10d): each type
  parameter takes the type of the arguments in its positions, exactly,
  through ptr to T, array of T and G<T> as well; a plain routine wins a
  tie with an instance, a generic one takes what the plain one does not;
  a parameter not of a type parameter converts as usual; a recursive
  instance inferring itself; a generic method
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | max 7 b
  | first 11
  | deref 99
  | key k 42
  | plain 5
  | generic s
  | generic true
  | echo 3
  | pick a
  | sum 10
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_infer;

import System.SysUtils;

type
  Pair<K, V> = record
    Key: K;
    Value: V;
  end;

  Bag = object
    method Echo<T>(const AValue: T): T;
    begin
      return AValue;
    end;
  end;

func Max<T>(const A: T; const B: T): T;
begin
  if A > B then
    return A;
  end;
  return B;
end;

func First<T>(const AItems: array of T): T;
begin
  return AItems[0];
end;

func Deref<T>(const AP: ptr to T): T;
begin
  return AP^;
end;

func KeyOf<K, V>(const APair: Pair<K, V>): K;
begin
  return APair.Key;
end;

func ValueOf<K, V>(const APair: Pair<K, V>): V;
begin
  return APair.Value;
end;

func Show<T>(const A: T);
begin
  println("generic {}", A);
end;

func Show(const A: int32);
begin
  println("plain {}", A);
end;

func Pick<T>(const A: T; const AIndex: int64): T;
begin
  return A;
end;

func Sum<T>(const AN: T): T;
begin
  if AN = 0 then
    return 0;
  end;
  return AN + Sum(AN - 1);
end;

var
  GItems: array of int32;
  GX: int64;
  GP: Pair<string, int64>;
  GBag: Bag;
  GN: int64;

begin
  println("max {} {}", Max(3, 7), Max("ab", "b"));
  setlength(GItems, 2);
  GItems[0] := 11;
  GItems[1] := 12;
  println("first {}", First(GItems));
  GX := 99;
  println("deref {}", Deref(addr of GX));
  GP.Key := "k";
  GP.Value := 42;
  println("key {} {}", KeyOf(GP), ValueOf(GP));
  Show(5);
  Show("s");
  Show(true);
  println("echo {}", GBag.Echo(3));
  println("pick {}", Pick("a", 2));
  GN := 4;
  println("sum {}", Sum(GN));
end.
