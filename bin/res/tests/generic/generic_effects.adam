-------------------------------------------------------------------------------
  generic_effects.adam - a generic instance's routines have write summaries
  of their own (SU2.8 e4, PLAN-ADAM M10h): a borrowed module variable
  passed to an instance method or a generic routine instance that writes
  nothing is not held (1 holder); the ref an instance method runs through
  is held only when the method drops it (keep 1, drop 2). Holders reads a
  block's holders through its slot
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | look 1
  | look text 1
  | peek 1
  | keep 1
  | drop 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_effects;

type
  Box = object
    FValue: int64;
  end;

var
  GBox: ref Box;

// The holders of ABox's block, read through its slot (a block's first word)
routine Holders(const ABox: ref Box): int64;
var
  LSlot: ptr to const ptr;
  LWords: ptr to int64;
begin
  LSlot := ptr to const ptr(addr of ABox);
  LWords := ptr to int64(LSlot^);
  return LWords[0];
end;

// The holders of GRef's block (Holders' read)
forward routine RefHolders(): int64;

// GRef set to nil
forward routine DropTheRef();

type
  // A generic type whose methods look at a box or at the ref they run through, writing
  // nothing, or drop that ref
  Cell<T> = object
    FItem: T;

    method Look(const ABox: ref Box): int64;
    begin
      return Holders(ABox);
    end;

    // Writes nothing: the ref it runs through is not held
    method KeepRef(): int64;
    begin
      return RefHolders();
    end;

    // Drops the ref it runs through (GRef) and reads its own field after: held
    method DropRef(): int64;
    var
      LCount: int64;
    begin
      LCount := RefHolders();
      DropTheRef();
      return LCount + int64(self.FItem);
    end;
  end;

// A generic routine writing nothing
routine Peek<T>(const AItem: T; const ABox: ref Box): int64;
begin
  return Holders(ABox);
end;

var
  GRef: ref Cell<int64>;

// The holders of ACell's block, read through its slot (Holders' read: the address of a
// parameter, never of GRef, which would be a write of it)
routine CellHolders(const ACell: ref Cell<int64>): int64;
var
  LSlot: ptr to const ptr;
  LWords: ptr to int64;
begin
  LSlot := ptr to const ptr(addr of ACell);
  LWords := ptr to int64(LSlot^);
  return LWords[0];
end;

routine RefHolders(): int64;
begin
  return CellHolders(GRef);
end;

routine DropTheRef();
begin
  GRef := nil;
end;

var
  GCell: Cell<int64>;
  GText: Cell<string>;
begin
  GBox := ref Box();
  GRef := ref Cell<int64>();
  println("look {}", GCell.Look(GBox));
  println("look text {}", GText.Look(GBox));
  println("peek {}", Peek(7, GBox));
  println("keep {}", GRef.KeepRef());
  println("drop {}", GRef.DropRef());
end.
