-------------------------------------------------------------------------------
  generic_templates.adam - generic templates declared and checked once (BNF sec 10,
  PLAN-ADAM M10a): a generic record, object (its methods using T, one of
  them generic itself), interface, overlay, array / pointer / routine
  aliases, a generic routine whose body uses '>' (what depends on T is
  typed per instance, never here), a generic method of a plain object;
  a generic's bare name inside its own declaration, nested type arguments closed by '>>', '<' in an
  expression a type argument list only before '(' or '.', less-than
  otherwise
*******************************************************************************/

/*
@@test
  kind check
@@end
*/

module exe generic_templates;

import System.SysUtils;

type
  Pair<K, V> = record
    Key: K;
    Value: V;
  end;

  Node<T> = object
    hidden FItem: T;
    method Again(): Node;
    begin
      return self;
    end;
  end;

  Nest<T> = record
    Inner: Pair<Pair<T, int32>, ptr to T>;
    Deep: Pair<int32, Pair<T, Pair<T, T>>>;
  end;

  Stack<T> = object
    hidden FItems: array of T;
    hidden FCount: int64;
    method Push(const AItem: T);
    begin
      setlength(self.FItems, self.FCount + 1);
      self.FItems[self.FCount] := AItem;
      self.FCount := self.FCount + 1;
    end;
    method Top(): T;
    begin
      return self.FItems[self.FCount - 1];
    end;
    method Map<R>(const AFn: func(const AItem: T): R): R;
    begin
      return AFn(self.Top());
    end;
  end;

  Source<T> = interface
    method Next(): T;
  end;

  Bits<T> = overlay
    Whole: T;
    Raw: array[0..7] of uint8;
  end;

  Row<T> = array[0..3] of T;
  Cursor<T> = ptr to T;
  Fold<T> = func(const AAcc: T; const AItem: T): T;

  Tools = object
    method Pick<T>(const AFirst: bool; const AA: T; const AB: T): T;
    begin
      if AFirst then
        return AA;
      end;
      return AB;
    end;
  end;

func Max<T>(const A: T; const B: T): T;
begin
  if A > B then
    return A;
  end;
  return B;
end;

func Biggest<T>(const A: T; const B: T; const C: T): T;
var
  LBig: T;
begin
  LBig := Max<T>(A, B);
  return Max<T>(LBig, C);
end;

func Less(const A: int32; const B: int32): bool;
begin
  // '<' before a name and ')' : less-than (no '>' before '(' or '.')
  if (A < B) and (B > A) then
    return true;
  end;
  return A < B;
end;

begin
  println("{}", Less(1, 2));
end.
