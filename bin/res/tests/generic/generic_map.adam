-------------------------------------------------------------------------------
  generic_map.adam - System.Collections' Map<K, V> (PLAN-ADAM M10g): Put
  (a new key last, a held one's value replaced), Get, TryGet, Has, Remove,
  Clear, M[k] read and written, Keys / Values in the order first put (a
  removed key's place gone, a key put again last), string keys, a record's
  key by its '=' and operator hash, a map of lists, 2000 keys with half of
  them removed and put again (the index rebuilt past its tombstones), a map
  read through a const parameter, Get of a missing key (code 1), nothing
  leaked
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | count 3 one 1 two 2 three 3
  | replaced 3 20
  | try true 3 false 3
  | has true false
  | order one two three
  | removed true false 2 one three
  | again one three two
  | values 1 3 22
  | index 7 8
  | point 2 north south
  | lists 2 3 1
  | big 2000 1000 2000 true 1999 0
  | const 3
  | missing 1 the key is not in the map
  | clear 0 false 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_map;

import System.SysUtils, System.Collections;

type
  Point = record
    X: int32;
    Y: int32;

    operator =(const A: Point; const B: Point): bool;
    begin
      return (A.X = B.X) and (A.Y = B.Y);
    end;

    operator <>(const A: Point; const B: Point): bool;
    begin
      return not (A = B);
    end;

    operator hash(const A: Point): uint64;
    begin
      return hash(A.X) xor (hash(A.Y) shl 1);
    end;
  end;

routine At(const AX: int32; const AY: int32): Point;
var
  LPoint: Point;
begin
  LPoint.X := AX;
  LPoint.Y := AY;
  return LPoint;
end;

// The keys of AMap in order, after ALabel, the map read through a const parameter
routine ShowKeys(const ALabel: string; const AMap: Map<string, int32>);
var
  LKeys: array of string;
  LI: int64;
begin
  LKeys := AMap.Keys();
  print("{}", ALabel);
  for LI := 0 to len(LKeys) - 1 do
    print(" {}", LKeys[LI]);
  end;
  println("");
end;

// The count of AMap, read through a const parameter
routine CountOf(const AMap: Map<string, int32>): int64;
begin
  return AMap.Count;
end;

var
  GWords: Map<string, int32>;
  GPoints: Map<Point, string>;
  GLists: Map<int32, List<int32>>;
  GBig: Map<int64, int64>;
  GList: List<int32>;
  GValues: array of int32;
  GValue: int32;
  GFound: bool;
  GI: int64;
  GSum: int64;

begin
  GWords.Put("one", 1);
  GWords.Put("two", 2);
  GWords["three"] := 3;
  println("count {} one {} two {} three {}", GWords.Count, GWords.Get("one"), GWords["two"],
    GWords["three"]);
  GWords.Put("two", 20);
  println("replaced {} {}", GWords.Count, GWords["two"]);
  GValue := 0;
  GFound := GWords.TryGet("three", GValue);
  print("try {} {}", GFound, GValue);
  GFound := GWords.TryGet("four", GValue);
  println(" {} {}", GFound, GValue);
  println("has {} {}", GWords.Has("one"), GWords.Has("ONE"));
  ShowKeys("order", GWords);
  println("removed {} {} {} {} {}", GWords.Remove("two"), GWords.Remove("two"), GWords.Count,
    GWords.Keys()[0], GWords.Keys()[1]);
  GWords["two"] := 22;
  ShowKeys("again", GWords);
  GValues := GWords.Values();
  println("values {} {} {}", GValues[0], GValues[1], GValues[2]);
  GWords["one"] := GWords["one"] + 6;
  println("index {} {}", GWords["one"], GWords["one"] + 1);

  GPoints.Put(At(1, 2), "north");
  GPoints.Put(At(2, 1), "east");
  GPoints[At(2, 1)] := "south";
  println("point {} {} {}", GPoints.Count, GPoints[At(1, 2)], GPoints[At(2, 1)]);

  GList.Add(7);
  GLists.Put(1, GList);
  GList.Add(8);
  GList.Add(9);
  GLists.Put(2, GList);
  println("lists {} {} {}", GLists.Count, GLists[2].Count, GLists[1].Count);

  for GI := 0 to 1999 do
    GBig.Put(GI, GI * 2);
  end;
  print("big {}", GBig.Count);
  for GI := 0 to 999 do
    GBig.Remove(GI * 2);
  end;
  print(" {}", GBig.Count);
  for GI := 0 to 999 do
    GBig.Put(GI * 2, GI);
  end;
  GSum := 0;
  for GI := 0 to 1999 do
    if GBig.Has(GI) then
      GSum := GSum + 1;
    end;
  end;
  println(" {} {} {} {}", GSum, GBig[1] = 2, GBig.Keys()[999], GBig.Keys()[1000]);
  println("const {}", CountOf(GWords));

  guard
    GValue := GWords.Get("nine");
    println("no fault {}", GValue);
  except
    println("missing {} {}", exccode(), excmsg());
  end;

  GWords.Clear();
  println("clear {} {} {}", GWords.Count, GWords.Has("one"), len(GWords.Keys()));
end.
