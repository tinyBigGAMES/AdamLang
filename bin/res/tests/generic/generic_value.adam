-------------------------------------------------------------------------------
  generic_value.adam - generic routines named as values (BNF sec 10,
  PLAN-ADAM M10d2): each takes its type arguments from the routine type
  it converts to (an assignment, a var's init, a routine-type argument,
  a return), its parameters and result unified with the generic's,
  exactly, through ptr to T as well; one generic, two instances by two
  routine types; a parenthesized value; a routine type named by a type;
  a cpplink routine type taking the instance, a clink one (the default)
  its clink adapter; a call's overloads picking the routine-type parameter a generic value
  fits; a generic called through a generic routine-type parameter; two
  generics of one name (T and ptr to T), the routine type picking one
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | max 7 b
  | cpp b
  | init 9
  | apply 12
  | return 8
  | paren 4
  | deref 99
  | make 0
  | use routine 6
  | use int 3
  | twice 10
  | kind 1
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_value;

type
  IntOp = func(const A: int32; const B: int32): int32;
  TextOp = func(const A: string; const B: string): string;

func Max<T>(const A: T; const B: T): T;
begin
  if A > B then
    return A;
  end;
  return B;
end;

func Add<T>(const A: T; const B: T): T;
begin
  return A + B;
end;

func Deref<T>(const A: ptr to T): T;
begin
  return A^;
end;

func Make<T>(): T;
var
  LValue: T;
begin
  return LValue;
end;

func Apply(const AOp: IntOp; const A: int32; const B: int32): int32;
begin
  return AOp(A, B);
end;

func Picker(): IntOp;
begin
  return Max;
end;

func Use(const AOp: IntOp): int32;
begin
  return AOp(2, 6);
end;

func Use(const A: int32): int32;
begin
  return A;
end;

func Twice<T>(const AOp: func(const A: T; const B: T): T; const A: T): T;
begin
  return AOp(A, A);
end;

func Kind<T>(const A: T): int32;
begin
  return 1;
end;

func Kind<T>(const A: ptr to T): int32;
begin
  return 2;
end;

var
  GInt: IntOp;
  GText: TextOp;
  GTextCpp: func cpplink(const A: string; const B: string): string;
  GLong: func(const A: int64; const B: int64): int64;
  GDeref: func(const A: ptr to int64): int64;
  GMake: func(): int32;
  GX: int64;
  GKind: func(const A: int64): int32;

begin
  GInt := Max;
  GText := Max;
  println("max {} {}", GInt(3, 7), GText("ab", "b"));
  GTextCpp := Max;
  println("cpp {}", GTextCpp("ab", "b"));
  begin
    var LOp: IntOp = Add;
    println("init {}", LOp(4, 5));
  end;
  println("apply {}", Apply(Add, 5, 7));
  println("return {}", Picker()(8, 2));
  GLong := (Max);
  println("paren {}", GLong(4, 1));
  GDeref := Deref;
  GX := 99;
  println("deref {}", GDeref(addr of GX));
  GMake := Make;
  println("make {}", GMake());
  println("use routine {}", Use(Max));
  println("use int {}", Use(3));
  println("twice {}", Twice<int32>(Add, 5));
  GKind := Kind;
  println("kind {}", GKind(5));
end.
