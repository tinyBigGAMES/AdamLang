-------------------------------------------------------------------------------
  generic_unit.adam - generics of compiled units (BNF sec 10, PLAN-ADAM
  M10f): its dep generic_unit_first wrote fixtures\GenUnit's and
  GenUnitUser's .acu files; this build loads both (the template bodies
  kept in GenUnit's .acu) and makes its instances in this program:
  instances GenUnitUser's object already holds (Max<int32>, Stack<int32>)
  are one at link, new ones (Max<float64>, Box<string>, Stack<string> by
  Map, Bumped<int32> calling GenUnit's private Bump) are this build's
*******************************************************************************/

/*
@@test
  kind run
  deps generic.generic_unit_first
  exitcode 0
  | GenUnit loaded
  | GenUnitUser loaded
  | max 9 2.5 zz 9
  | box 7 hi
  | stack 3 30 2 2
  | map 2 2
  | bumped 105 101
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_unit;

@addmodulepath "$P:res/tests/generic/fixtures";

import System.SysUtils, System.IO, GenUnit, GenUnitUser;

const
  // Where this build's units are, from the exe's folder (<output>\bin\<triple>\<mode>)
  ACU_DIR: string = "$P:../../../acu/x86_64-windows-gnu/debug/";

// "loaded" when AName's .acu is older than this module's, written by this build
routine UnitSource(const AName: string): string;
begin
  if FileWriteTime(ACU_DIR + AName + ".acu") < FileWriteTime(ACU_DIR + "generic_unit.acu") then
    return "loaded";
  end;
  return "parsed";
end;

routine Text(const AN: int32): string;
begin
  return IntToStr(int64(AN div 10));
end;

var
  GBox: Box<int32>;
  GText: Box<string>;
  GStack: Stack<int32>;
  GMapped: Stack<string>;

begin
  println("GenUnit {}", UnitSource("GenUnit"));
  println("GenUnitUser {}", UnitSource("GenUnitUser"));
  println("max {} {} {} {}", Max(2, 9), Max(2.5, 1.5), Max("a", "zz"), UserMax(9, 4));
  GBox := Wrap(7);
  GText := Wrap("hi");
  println("box {} {}", GBox.V, GText.V);
  GStack.Push(10);
  GStack.Push(20);
  GStack.Push(30);
  println("stack {} {} {} {}", GStack.Count(), GStack.Pop(), GStack.Count(), UserCount());
  GMapped := GStack.Map<string>(Text);
  println("map {} {}", GMapped.Count(), GMapped.Pop());
  println("bumped {} {}", Bumped(5), Bumped(int64(1)));
end.
