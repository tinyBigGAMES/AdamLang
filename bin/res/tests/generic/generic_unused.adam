  generic_unused.adam - a generic nobody instantiates makes no code (BNF sec 10,
  PLAN-ADAM M10a): a program declaring generic types and routines builds and
  runs, the templates' bodies (typed once with T unknown, what depends on
  T typed only per instance) left out of the exe
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_unused;

import System.SysUtils;

type
  Box<T> = object
    hidden FValue: T;
    method Get(): T;
    begin
      return self.FValue;
    end;
    method Twice(): T;
    begin
      return self.FValue + self.FValue;
    end;
  end;

  Pair<K, V> = record
    Key: K;
    Value: V;
  end;

func Max<T>(const A: T; const B: T): T;
begin
  if A > B then
    return A;
  end;
  return B;
end;

begin
  println("ok");
end.
