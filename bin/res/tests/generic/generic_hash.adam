-------------------------------------------------------------------------------
  generic_hash.adam - hash(X) and operator hash (BNF sec 4 / 7, PLAN-ADAM
  M10g): the same value on every target and run (splitmix64: hash(int64(0))
  and hash("abc") as the reference computes them), equal values hash alike
  across widths and blocks (-1 as int8 and int64, 255 as uint8 and int64, a
  string made at run time and a literal, 0.0 and -0.0), every class: bool,
  char, wchar, choices, pointer, ref, string, wstring, set, static and dynamic
  arrays (their order counts, [1, 2] as the reference computes it), a
  record's and an object's declared operator hash (an array of them through
  it, a parent's operator for a child), nothing leaked
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | zero 16294208416658607535 16294208416658607535
  | abc 18346894171988117005 true
  | widths true true true
  | floats true true false
  | scalars true true true true true
  | ptrs true true true
  | texts true true false
  | sets true false
  | arrays 7732466910970564484 7732466910970564484 true false
  | point true true false
  | points true false
  | shape true true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_hash;

type
  Shade = choices(Light, Dark);
  Digits = set of 0..9;

  // = and hash read the same fields (Tag is no part of either)
  Point = record
    X: int32;
    Y: int32;
    Tag: string;

    operator =(const A: Point; const B: Point): bool;
    begin
      return (A.X = B.X) and (A.Y = B.Y);
    end;

    operator <>(const A: Point; const B: Point): bool;
    begin
      return not (A = B);
    end;

    operator hash(const A: Point): uint64;
    begin
      return hash(A.X) xor (hash(A.Y) shl 1);
    end;
  end;

  Shape = object
    Sides: int32;

    operator hash(const A: Shape): uint64;
    begin
      return hash(A.Sides);
    end;
  end;

  Square = object(Shape)
    Size: int32;
  end;

  Node = object
    Value: int32;
  end;

routine MakePoint(const AX: int32; const AY: int32; const ATag: string): Point;
var
  LPoint: Point;
begin
  LPoint.X := AX;
  LPoint.Y := AY;
  LPoint.Tag := ATag;
  return LPoint;
end;

var
  GText: string;
  GWide: wstring;
  GWideToo: wstring;
  GWChar: wchar;
  GWCharToo: wchar;
  GSetA: Digits;
  GSetB: Digits;
  GSetC: Digits;
  GSetD: Digits;
  GZero: float64;
  GNegZero: float64;
  GInt: int32;
  GOther: int32;
  GRef: ref Node;
  GSame: ref Node;
  GNew: ref Node;
  GStatic: array[0..1] of int32;
  GDynamic: array of int32;
  GBack: array of int32;
  GPoints: array of Point;
  GMoved: array of Point;
  GShape: Shape;
  GSquare: Square;

begin
  println("zero {} {}", hash(int64(0)), hash(int32(0)));
  GText := "ab";
  GText := GText + "c";
  println("abc {} {}", hash("abc"), hash(GText) = hash("abc"));
  println("widths {} {} {}", hash(int8(-1)) = hash(int64(-1)), hash(uint8(255)) = hash(int64(255)),
    hash(int16(7)) = hash(uint32(7)));
  GZero := 0.0;
  GNegZero := -GZero;
  println("floats {} {} {}", hash(GZero) = hash(GNegZero), hash(float32(1.5)) = hash(1.5),
    hash(1.5) = hash(2.5));
  GWChar := 'a';
  GWCharToo := 'a';
  println("scalars {} {} {} {} {}", hash(true) = hash(true), hash(true) <> hash(false),
    hash('a') = hash('a'), hash(GWChar) = hash(GWCharToo), hash(Shade.Dark) <> hash(Shade.Light));
  GRef := ref Node();
  GSame := GRef;
  GNew := ref Node();
  GInt := 3;
  println("ptrs {} {} {}", hash(addr of GInt) = hash(addr of GInt), hash(GRef) = hash(GSame),
    hash(GRef) <> hash(GNew));
  GWide := "abc";
  GWideToo := "ab";
  GWideToo := GWideToo + "c";
  println("texts {} {} {}", hash(GWide) = hash(GWideToo), hash("") <> hash(GText),
    hash("ab") = hash("ba"));
  GSetA := [1, 3];
  GSetB := [3, 1];
  GSetC := [1];
  GSetD := [2];
  println("sets {} {}", hash(GSetA) = hash(GSetB), hash(GSetC) = hash(GSetD));
  GStatic[0] := 1;
  GStatic[1] := 2;
  setlength(GDynamic, 2);
  GDynamic[0] := 1;
  GDynamic[1] := 2;
  setlength(GBack, 2);
  GBack[0] := 2;
  GBack[1] := 1;
  println("arrays {} {} {} {}", hash(GStatic), hash(GDynamic), hash(GStatic) = hash(GDynamic),
    hash(GDynamic) = hash(GBack));
  println("point {} {} {}", hash(MakePoint(1, 2, "a")) = hash(MakePoint(1, 2, "b")),
    MakePoint(1, 2, "a") = MakePoint(1, 2, "b"), hash(MakePoint(1, 2, "")) = hash(MakePoint(2, 1, "")));
  setlength(GPoints, 2);
  GPoints[0] := MakePoint(1, 2, "x");
  GPoints[1] := MakePoint(3, 4, "y");
  setlength(GMoved, 2);
  GMoved[0] := MakePoint(3, 4, "y");
  GMoved[1] := MakePoint(1, 2, "x");
  println("points {} {}", hash(GPoints) = hash(GPoints), hash(GPoints) = hash(GMoved));
  GShape.Sides := 4;
  GSquare.Sides := 4;
  GSquare.Size := 9;
  GOther := 4;
  println("shape {} {}", hash(GShape) = hash(GSquare), hash(GShape) = hash(GOther));
end.
