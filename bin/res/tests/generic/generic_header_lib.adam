  generic_header_lib.adam - the lib of generic_header (M10e): built only;
  a public generic routine (no code of its own, nothing exported: its
  instances are made where it is used), one used by its own routines, a
  pointer to a generic record's instance and one by value
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module lib generic_header_lib;

public type
  Box<T> = record
    V: T;
  end;

public func Max<T>(const A: T; const B: T): T;
begin
  if A > B then
    return A;
  end;
  return B;
end;

public func Plain(const AN: int32): int32;
begin
  return Max(AN, 0);
end;

public func Peek(const AB: ptr to Box<int32>): int32;
begin
  return AB^.V;
end;

public func Take(const AB: Box<int32>): int32;
begin
  return AB.V;
end;

end.
