-------------------------------------------------------------------------------
  generic_unit_first.adam - generics of a unit used from another module of
  the build (BNF sec 10, PLAN-ADAM M10f), both units built from source:
  fixtures\GenUnit's generic routines, record and object (a generic method
  of a generic object, a body calling the unit's private routine), and
  fixtures\GenUnitUser making two of the same instances; also the dep of
  generic_unit, so the units' .acu files are in the output folder first
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | max 9 2.5 zz 9
  | box 7 hi
  | stack 3 30 2 2
  | map 2 2
  | bumped 105 101
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_unit_first;

@addmodulepath "$P:res/tests/generic/fixtures";

import System.SysUtils, GenUnit, GenUnitUser;

routine Text(const AN: int32): string;
begin
  return IntToStr(int64(AN div 10));
end;

var
  GBox: Box<int32>;
  GText: Box<string>;
  GStack: Stack<int32>;
  GMapped: Stack<string>;

begin
  println("max {} {} {} {}", Max(2, 9), Max(2.5, 1.5), Max("a", "zz"), UserMax(9, 4));
  GBox := Wrap(7);
  GText := Wrap("hi");
  println("box {} {}", GBox.V, GText.V);
  GStack.Push(10);
  GStack.Push(20);
  GStack.Push(30);
  println("stack {} {} {} {}", GStack.Count(), GStack.Pop(), GStack.Count(), UserCount());
  GMapped := GStack.Map<string>(Text);
  println("map {} {}", GMapped.Count(), GMapped.Pop());
  println("bumped {} {}", Bumped(5), Bumped(int64(1)));
end.
