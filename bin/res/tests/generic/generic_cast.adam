-------------------------------------------------------------------------------
  generic_cast.adam - a cast to a type parameter, T(X), in a generic body
  converts to the instance's type argument as the cast to that type does
  (PLAN-ADAM M9k: cimport writes T(c) for a constant past int beside a
  type parameter): narrowing wraps, an integer to a float, a constant past
  the type keeping its bits (0xFFFF0000 under int32 is -65536)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 44 -5 true
  | 805240832 4294901760
  | -65536 2147483647
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_cast;

func Narrow<T>(const AV: int64): T;
begin
  return T(AV);
end;

func Mask<T>(const AX: T): T;
begin
  return AX & T(4294901760);
end;

func Wide<T>(const AX: T): T;
begin
  return T(4294901760) | AX;
end;

begin
  println("{} {} {}", Narrow<uint8>(300), Narrow<int16>(-5), Narrow<float64>(7) = 7.0);
  println("{} {}", Mask(int32(805240837)), Mask(uint32(4294967295)));
  println("{} {}", Wide(int32(0)), Narrow<int32>(2147483647));
end.
