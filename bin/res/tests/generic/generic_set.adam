-------------------------------------------------------------------------------
  generic_set.adam - System.Collections' Set<T> (PLAN-ADAM M10g): Add (false
  for an item it holds), Has, Remove, Clear, Count, Items in the order added
  (a removed item's place gone), sets of ints, strings and a record by its
  '=' and operator hash, 500 items with every other removed, nothing leaked
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | add true true false 2
  | has true false
  | items 5 3 9
  | remove true false 2 5 9
  | words 2 pear fig
  | cells 2 true false
  | many 500 250 true false
  | clear 0 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_set;

import System.Collections;

type
  Cell = record
    Row: int32;
    Column: int32;

    operator =(const A: Cell; const B: Cell): bool;
    begin
      return (A.Row = B.Row) and (A.Column = B.Column);
    end;

    operator <>(const A: Cell; const B: Cell): bool;
    begin
      return not (A = B);
    end;

    operator hash(const A: Cell): uint64;
    begin
      return hash(A.Row) xor (hash(A.Column) shl 1);
    end;
  end;

routine CellAt(const ARow: int32; const AColumn: int32): Cell;
var
  LCell: Cell;
begin
  LCell.Row := ARow;
  LCell.Column := AColumn;
  return LCell;
end;

var
  GInts: Set<int32>;
  GWords: Set<string>;
  GCells: Set<Cell>;
  GMany: Set<int64>;
  GItems: array of int32;
  GWordItems: array of string;
  GFirst: bool;
  GSecond: bool;
  GThird: bool;
  GI: int64;

begin
  GFirst := GInts.Add(5);
  GSecond := GInts.Add(3);
  GThird := GInts.Add(5);
  println("add {} {} {} {}", GFirst, GSecond, GThird, GInts.Count);
  println("has {} {}", GInts.Has(3), GInts.Has(4));
  GInts.Add(9);
  GItems := GInts.Items();
  println("items {} {} {}", GItems[0], GItems[1], GItems[2]);
  GFirst := GInts.Remove(3);
  GSecond := GInts.Remove(3);
  GItems := GInts.Items();
  println("remove {} {} {} {} {}", GFirst, GSecond, GInts.Count, GItems[0], GItems[1]);

  GWords.Add("pear");
  GWords.Add("fig");
  GWords.Add("pear");
  GWordItems := GWords.Items();
  println("words {} {} {}", GWords.Count, GWordItems[0], GWordItems[1]);

  GCells.Add(CellAt(1, 2));
  GCells.Add(CellAt(2, 1));
  GCells.Add(CellAt(1, 2));
  println("cells {} {} {}", GCells.Count, GCells.Has(CellAt(2, 1)), GCells.Has(CellAt(2, 2)));

  for GI := 0 to 499 do
    GMany.Add(GI);
  end;
  print("many {}", GMany.Count);
  for GI := 0 to 249 do
    GMany.Remove(GI * 2);
  end;
  println(" {} {} {}", GMany.Count, GMany.Has(499), GMany.Has(498));

  GInts.Clear();
  GMany.Clear();
  println("clear {} {}", GInts.Count, GMany.Count);
end.
