-------------------------------------------------------------------------------
  generic_err_routine.adam - errors calling generic routines and methods
  (BNF sec 10, PLAN-ADAM M10c / M10d): a type parameter no argument
  fixes, in a call or a routine value (SM0738), two arguments giving one
  two types (SM0739), the wrong count of type arguments or some for a
  routine that is not generic (SM0735), an error only an instance has at
  the generic's line with a hint at the call that made it (SM0737), an
  instance needing ever bigger ones stopped at the depth limit (SM0736)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe generic_err_routine;

type
  Point = record
    X: int32;
  end;

  Bag = object
    method Echo<T>(const AValue: T): T;
    begin
      return AValue;
    end;
  end;

routine Max<T>(const A: T; const B: T): T;
begin
  if A > B then // ERROR SM0252@6
    return A;
  end;
  return B;
end;

routine Make<T>(): T;
begin
  return 0;
end;

routine Plain(const A: int32): int32;
begin
  return A;
end;

routine Deep<T>(const A: T): int32;
var
  LP: ptr to T;
begin
  return Deep<ptr to T>(LP); // ERROR SM0736@10
end;

var
  GBag: Bag;
  GP: Point;
  GQ: Point;
  GN: int32;
  GL: int64;
  GF: routine(const A: int32; const B: int32): int32;

begin
  GN := Make(); // ERROR SM0738@9
  GN := Max(1, GL); // ERROR SM0739@9
  GF := Max; // ERROR SM0738@9
  GN := Max<int32, int32>(1, 2); // ERROR SM0735@9
  GN := Plain<int32>(1); // ERROR SM0735@9
  GP := Max<Point>(GP, GQ); // HINT SM0737@9
  GN := Deep<int32>(1);
end.
