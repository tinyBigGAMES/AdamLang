-------------------------------------------------------------------------------
  generic_unit_private.adam - a call from another module never picks a
  unit's private overload (PLAN-ADAM M10h, BNF decision row 20): GenPick's
  private Pick(int32) and plain Twice(int32) would take an int32 better
  than the public Pick(int64) and the generic Twice<T>, but only the unit's
  own call meets them
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | pick public int64
  | twice public generic
  | here private int32, private int32
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_unit_private;

@addmodulepath "$P:res/tests/generic/fixtures";

import GenPick;

var
  GSmall: int32;
begin
  GSmall := 1;
  println("pick {}", Pick(GSmall));
  println("twice {}", Twice(GSmall));
  println("here {}", PickHere(GSmall));
end.
