-------------------------------------------------------------------------------
  generic_header.adam - a lib's C header and its generics (BNF sec 10,
  PLAN-ADAM M10e): a public generic routine is a comment (its instances
  are C++ template instances, made where it is used), a generic record's
  instance has no C name (a C++ class template's): a pointer to one is
  void *, one by value leaves its routine a comment, no typedef for it.
  Read back line by line as dll_header does
*******************************************************************************/

/*
@@test
  kind run
  deps generic.generic_header_lib
  exitcode 0
  | >/\* generic_header_lib.h - the C interface of the Adam lib generic_header_lib, written by adam: do not edit *\/
  | >
  | >#ifndef __adam_generic_header_lib_h
  | >#define __adam_generic_header_lib_h
  | >
  | >#include <stddef.h>
  | >#include <stdint.h>
  | >#include <stdbool.h>
  | >
  | >#ifndef __adam_c_header
  | >#define __adam_c_header
  | >#ifdef __cplusplus
  | >#define __adam_static_assert static_assert
  | >#define __adam_alignof alignof
  | >#define __adam_alignas alignas
  | >#define __adam_noreturn [[noreturn]]
  | >#else
  | >#define __adam_static_assert _Static_assert
  | >#define __adam_alignof _Alignof
  | >#define __adam_alignas _Alignas
  | >#define __adam_noreturn _Noreturn
  | >#endif
  | >#endif
  | >
  | >#ifdef __cplusplus
  | >extern "C" {
  | >#endif
  | >
  | >/\* Max: not declared, a generic routine: its instances are C++ template instances (cpplink), made where it is used *\/
  | >extern int32_t Plain(int32_t AN);
  | >extern int32_t Peek(void *AB);
  | >/\* Take: not declared, the type of parameter AB has no C form *\/
  | >
  | >#ifdef __cplusplus
  | >}
  | >#endif
  | >
  | >#endif
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_header;

import System.SysUtils, System.IO;

const
  // The header, from the exe's folder (<output>\bin\<triple>\<mode>)
  HEADER_PATH: string = "$P:../../../lib/x86_64-windows-gnu/debug/generic_header_lib.h";

var
  GText: string;
  GLines: StringArray;
  GI: int64;

begin
  if not ReadAllText(HEADER_PATH, GText) then
    println("no header");
    return;
  end;
  GLines := SplitString(GText, "\n");
  for GI := 0 to len(GLines) - 1 do
    if (GI < len(GLines) - 1) or (GLines[GI] <> "") then
      // a comment's ends written *\/ and /\*: this file's own comment holds the expected
      // lines
      println(">{}", ReplaceStr(ReplaceStr(GLines[GI], "*/", "*\\/"), "/*", "/\\*"));
    end;
  end;
end.
