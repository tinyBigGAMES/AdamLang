-------------------------------------------------------------------------------
  generic_hash_err.adam - Break step of generic_hash (BNF sec 4 / 7,
  PLAN-ADAM M10g): hash(X) of a record with '=' and no operator hash, an
  array of them, an overlay, a weak (SM0741); no argument and two (SM0409);
  an operator hash with two operands (SM0380), none of its type (SM0381),
  giving a bool (SM0382)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe generic_hash_err;

type
  Plain = record
    A: int32;

    operator =(const X: Plain; const Y: Plain): bool;
    begin
      return X.A = Y.A;
    end;

    operator <>(const X: Plain; const Y: Plain): bool;
    begin
      return X.A <> Y.A;
    end;
  end;

  Two = record
    A: int32;

    operator hash(const X: Two; const Y: Two): uint64; // ERROR SM0380: operator 'hash' takes one operand
    begin
      return hash(X.A);
    end;
  end;

  Stranger = record
    A: int32;

    operator hash(const X: int32): uint64; // ERROR SM0381
    begin
      return hash(X);
    end;
  end;

  Truth = record
    A: int32;

    operator hash(const X: Truth): bool; // ERROR SM0382: operator 'hash' gives a uint64, not 'bool'
    begin
      return X.A = 0;
    end;
  end;

  Lap = overlay
    I: int32;
    F: float32;
  end;

  Node = object
    Value: int32;
  end;

routine Refused();
var
  LH: uint64;
  LPlain: Plain;
  LPlains: array of Plain;
  LLap: Lap;
  LRef: ref Node;
  LWeak: weak Node;
begin
  LH := hash(LPlain); // ERROR SM0741@14: 'Plain' has no hash: 'Plain' declares no operator hash (one operand of its type, giving uint64)
  LH := hash(LPlains); // ERROR SM0741@14: 'array of Plain' has no hash: 'Plain' declares no operator hash (one operand of its type, giving uint64)
  LH := hash(LLap); // ERROR SM0741@14: 'Lap' has no hash: hash(X) takes a value '=' compares by its contents (a number, char, bool, choices value, pointer, text, set, array, or a record or object with an operator hash)
  LRef := ref Node();
  LWeak := LRef;
  LH := hash(LWeak); // ERROR SM0741
  LH := hash(); // ERROR SM0409: 'hash' takes (a value)
  LH := hash(1, 2); // ERROR SM0409: 'hash' takes (a value)
  println("{}", LH);
end;

begin
  Refused();
end.
