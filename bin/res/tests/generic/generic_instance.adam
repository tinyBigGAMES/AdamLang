-------------------------------------------------------------------------------
  generic_instance.adam - generic type instances (BNF sec 10, PLAN-ADAM
  M10b): a use G<A, B> makes the instance once (a clone of G, each type
  parameter bound to its argument), typed, laid out and lowered on its
  own: a generic record (nested instances, one shared by two uses), a
  generic object (its methods per instance, T's '+' decided per
  instance, a managed T), a dynamic array of T, an overlay, array /
  pointer / routine aliases, aliases of instances, an interface
  implemented by a plain object, a generic's bare name inside it meaning
  the instance being declared
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | pair 1 one
  | nest 2 two 3
  | same 5
  | box 21 42 hihi
  | stack 3 30 20 10
  | bits 2 1
  | row 7 16
  | cursor 7 8
  | fold 5
  | source 1 2
  | link 1 2
  | sizes 16 8 4
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_instance;

import System.SysUtils;

type
  Pair<K, V> = record
    Key: K;
    Value: V;
  end;

  Box<T> = object
    hidden FValue: T;
    method Put(const AValue: T);
    begin
      self.FValue := AValue;
    end;
    method Get(): T;
    begin
      return self.FValue;
    end;
    method Twice(): T;
    begin
      return self.FValue + self.FValue;
    end;
  end;

  Stack<T> = object
    hidden FItems: array of T;
    hidden FCount: int64;
    method Push(const AItem: T);
    begin
      setlength(self.FItems, self.FCount + 1);
      self.FItems[self.FCount] := AItem;
      self.FCount := self.FCount + 1;
    end;
    method Pop(): T;
    begin
      self.FCount := self.FCount - 1;
      return self.FItems[self.FCount];
    end;
    const method Count(): int64;
    begin
      return self.FCount;
    end;
  end;

  Bits<T> = overlay
    Whole: T;
    Raw: array[0..7] of uint8;
  end;

  Row<T> = array[0..3] of T;
  Cursor<T> = ptr to T;
  Fold<T> = routine(const AAcc: T; const AItem: T): T;

  Source<T> = interface
    method Next(): T;
  end;

  Counter = object implements Source<int32>
    FAt: int32;
    virtual method Next(): int32;
    begin
      self.FAt := self.FAt + 1;
      return self.FAt;
    end;
  end;

  // an alias of an instance (an expression's '<' opens type arguments only before '(' or '.')
  PairWide = Pair<int32, int64>;
  BitsShort = Bits<int16>;
  CursorByte = Cursor<int8>;
  RowInt = Row<int32>;

  Link<T> = object
    Item: T;
    Next: ptr to Link;
    const method After(): T;
    begin
      return self.Next^.Item;
    end;
  end;

routine AddInt(const AAcc: int32; const AItem: int32): int32;
begin
  return AAcc + AItem;
end;

routine Pull(const ASource: Source<int32>): int32;
begin
  return ASource.Next();
end;

var
  GPair: Pair<int32, string>;
  GNest: Pair<Pair<int32, string>, int64>;
  GSame: Pair<int32, string>;
  GInts: Box<int32>;
  GTexts: Box<string>;
  GStack: Stack<int64>;
  GBits: Bits<int64>;
  GRow: Row<int32>;
  GCursor: Cursor<int32>;
  GFold: Fold<int32>;
  GCounter: Counter;
  GFirst: Link<int32>;
  GSecond: Link<int32>;

begin
  GPair.Key := 1;
  GPair.Value := "one";
  println("pair {} {}", GPair.Key, GPair.Value);
  GNest.Key.Key := 2;
  GNest.Key.Value := "two";
  GNest.Value := 3;
  println("nest {} {} {}", GNest.Key.Key, GNest.Key.Value, GNest.Value);
  GSame := GPair;
  GSame.Key := 5;
  println("same {}", GSame.Key);
  GInts.Put(21);
  GTexts.Put("hi");
  println("box {} {} {}", GInts.Get(), GInts.Twice(), GTexts.Twice());
  GStack.Push(10);
  GStack.Push(20);
  GStack.Push(30);
  println("stack {} {} {} {}", GStack.Count(), GStack.Pop(), GStack.Pop(), GStack.Pop());
  GBits.Whole := 258;
  println("bits {} {}", GBits.Raw[0], GBits.Raw[1]);
  GRow[2] := 7;
  println("row {} {}", GRow[2], size(RowInt));
  GCursor := addr of GRow[2];
  GCursor^ := GCursor^ + 1;
  println("cursor 7 {}", GRow[2]);
  GFold := AddInt;
  println("fold {}", GFold(2, 3));
  println("source {} {}", Pull(GCounter), Pull(GCounter));
  GFirst.Item := 1;
  GSecond.Item := 2;
  GFirst.Next := addr of GSecond;
  println("link {} {}", GFirst.Item, GFirst.After());
  println("sizes {} {} {}", size(PairWide), size(BitsShort), size(CursorByte) - 4);
end.
