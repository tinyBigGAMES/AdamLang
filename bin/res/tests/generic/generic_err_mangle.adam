-------------------------------------------------------------------------------
  generic_err_mangle.adam - a generic method's instance and a private
  generic routine's instance are named as clang names them (BNF sec 10,
  PLAN-ADAM M10e): a member template's prefix a substitution after its
  class's (N 4Calc 5Twice I i E E T_ S2_), a const method's K, a private
  routine's internal L name. A public clink routine spelling that name
  takes the same symbol: the instance, met second, is SM0024 at its
  generic, naming it
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe generic_err_mangle;

type
  Calc = object
    method Twice<T>(const AA: T): T; // ERROR SM0024@5: symbol '_ZN18generic_err_mangle4Calc5TwiceIiEET_S2_' is defined twice: 'generic_err_mangle._ZN18generic_err_mangle4Calc5TwiceIiEET_S2_' defines it already
    begin
      return AA + AA;
    end;
    const method Thrice<T>(const AA: T): T; // ERROR SM0024@5: symbol '_ZNK18generic_err_mangle4Calc6ThriceIiEET_S2_' is defined twice: 'generic_err_mangle._ZNK18generic_err_mangle4Calc6ThriceIiEET_S2_' defines it already
    begin
      return AA + AA + AA;
    end;
  end;

func Hidden<T>(const AA: T): T; // ERROR SM0024@1: symbol '_ZN18generic_err_mangleL6HiddenIiEET_S1_' is defined twice: 'generic_err_mangle._ZN18generic_err_mangleL6HiddenIiEET_S1_' defines it already
begin
  return AA;
end;

public func clink _ZN18generic_err_mangle4Calc5TwiceIiEET_S2_(): int32;
begin
  return 0;
end;

public func clink _ZNK18generic_err_mangle4Calc6ThriceIiEET_S2_(): int32;
begin
  return 0;
end;

public func clink _ZN18generic_err_mangleL6HiddenIiEET_S1_(): int32;
begin
  return 0;
end;

var
  GCalc: Calc;
  GA: int32;

begin
  GA := GCalc.Twice<int32>(1) + GCalc.Thrice<int32>(2) + Hidden<int32>(3);
end.
