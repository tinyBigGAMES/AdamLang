-------------------------------------------------------------------------------
  generic_static_param.adam - a static method called through a type
  parameter (BNF sec 10, GS1): `T.Count()` in a generic routine and a
  generic method is judged per instance, so each instance calls its
  argument's static: a descendant's restated one (hiding its parent's) for
  it, the parent's own for the parent, an inherited one reached through the
  descendant; a static's result passed to another static through T.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | count 1 2
  | twice 2 4
  | label base 1 base 2
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_static_param;

import System.SysUtils;

type
  Base = object
    static method Count(): int32;
    begin
      return 1;
    end;

    static method Label(const AN: int32): string;
    begin
      return "base " + IntToStr(AN);
    end;
  end;

  // restates Count (hiding Base's), inherits Label
  Derived = object(Base)
    static method Count(): int32;
    begin
      return 2;
    end;
  end;

  Holder = object
    method Twice<T>(): int32;
    begin
      return T.Count() * 2;
    end;
  end;

func CountOf<T>(): int32;
begin
  return T.Count();
end;

func LabelOf<T>(): string;
begin
  return T.Label(T.Count());
end;

var
  LHolder: Holder;
begin
  println("count {} {}", CountOf<Base>(), CountOf<Derived>());
  println("twice {} {}", LHolder.Twice<Base>(), LHolder.Twice<Derived>());
  println("label {} {}", LabelOf<Base>(), LabelOf<Derived>());
  println("end");
end.
