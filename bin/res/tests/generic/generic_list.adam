-------------------------------------------------------------------------------
  generic_list.adam - System.Collections' List<T> (PLAN-ADAM M10g): Add /
  Insert / Delete, LO[i] read and written, IndexOf / Contains / Remove by
  T's '=', a copy is a value, Sort by T's '<' (ints, strings, a record's
  declared '<', equal keys kept in order), Reverse, RemoveLast, ToArray,
  Clear, a list of lists, a list read through a const parameter, the index
  faults (code 14, the runtime's wording), nothing leaked
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | add 4: 5 3 9 1
  | insert 7: 7 5 4 3 9 1 2
  | delete 6: 8 4 3 9 1 2
  | find 3 -1 true false
  | remove true false
  | sort 5: 1 2 4 8 9
  | orig 5: 8 4 9 1 2
  | reverse 5: 2 1 9 4 8
  | last 8
  | after 4: 2 1 9 4
  | texts 3 apple fig pear
  | clear 0
  | stable e b d a c
  | nest 2 4 9
  | array 5 4
  | fault 14 index 7 is out of bounds 0..3
  | insert fault 14 index 9 is out of bounds 0..4
  | empty 14 index -1 is out of bounds: it is empty
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe generic_list;

import System.SysUtils, System.Collections;

type
  Entry = record
    Key: int32;
    Tag: string;

    operator <(const A: Entry; const B: Entry): bool;
    begin
      return A.Key < B.Key;
    end;
  end;

// "<label> <count>: <items>", the list read through a const parameter
routine Show(const ALabel: string; const AList: List<int32>);
var
  LI: int64;
begin
  print("{} {}:", ALabel, AList.Count);
  for LI := 0 to AList.Count - 1 do
    print(" {}", AList[LI]);
  end;
  println("");
end;

routine AddEntry(var AList: List<Entry>; const AKey: int32; const ATag: string);
var
  LEntry: Entry;
begin
  LEntry.Key := AKey;
  LEntry.Tag := ATag;
  AList.Add(LEntry);
end;

var
  GInts: List<int32>;
  GCopy: List<int32>;
  GTexts: List<string>;
  GEntries: List<Entry>;
  GNest: List<List<int32>>;
  GArray: array of int32;
  GLast: int32;
  GText: string;
  GI: int64;

begin
  GInts.Add(5);
  GInts.Add(3);
  GInts.Add(9);
  GInts.Add(1);
  Show("add", GInts);
  GInts.Insert(0, 7);
  GInts.Insert(5, 2);
  GInts.Insert(2, 4);
  Show("insert", GInts);
  GInts.Delete(1);
  GInts[0] := 8;
  Show("delete", GInts);
  println("find {} {} {} {}", GInts.IndexOf(9), GInts.IndexOf(6), GInts.Contains(1),
    GInts.Contains(6));
  println("remove {} {}", GInts.Remove(3), GInts.Remove(3));
  GCopy := GInts;
  GCopy.Sort();
  Show("sort", GCopy);
  Show("orig", GInts);
  GInts.Reverse();
  Show("reverse", GInts);
  GLast := GInts.RemoveLast();
  println("last {}", GLast);
  Show("after", GInts);

  GTexts.Add("pear");
  GTexts.Add("apple");
  GTexts.Add("fig");
  GTexts.Sort();
  println("texts {} {} {} {}", GTexts.Count, GTexts[0], GTexts[1], GTexts[2]);
  GTexts.Clear();
  println("clear {}", GTexts.Count);

  AddEntry(GEntries, 2, "a");
  AddEntry(GEntries, 1, "b");
  AddEntry(GEntries, 2, "c");
  AddEntry(GEntries, 1, "d");
  AddEntry(GEntries, 0, "e");
  GEntries.Sort();
  println("stable {} {} {} {} {}", GEntries[0].Tag, GEntries[1].Tag, GEntries[2].Tag,
    GEntries[3].Tag, GEntries[4].Tag);

  GNest.Add(GInts);
  GNest.Add(GCopy);
  println("nest {} {} {}", GNest.Count, GNest[0].Count, GNest[1][4]);

  GArray := GCopy.ToArray();
  println("array {} {}", len(GArray), GArray[2]);

  guard
    GI := int64(GInts[7]);
    println("no fault {}", GI);
  except
    println("fault {} {}", exccode(), excmsg());
  end;
  guard
    GInts.Insert(9, 0);
  except
    println("insert fault {} {}", exccode(), excmsg());
  end;
  guard
    GText := GTexts.RemoveLast();
    println("not empty {}", GText);
  except
    println("empty {} {}", exccode(), excmsg());
  end;
end.
