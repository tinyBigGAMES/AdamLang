-------------------------------------------------------------------------------
  generic_err_static_param.adam - Break step of generic_static_param (BNF
  sec 10, GS1): a static called through T is judged per instance, so the
  template alone reports nothing; an instance whose argument has no such
  static reports it at the generic's line (SM0009), with a hint at the call
  that made the instance (SM0737).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe generic_err_static_param;

type
  Plain = object
    X: int32;
  end;

func CountOf<T>(): int32;
begin
  return T.Count(); // ERROR SM0009@12
end;

var
  GN: int32;
begin
  GN := CountOf<Plain>(); // HINT SM0737@9
end.
