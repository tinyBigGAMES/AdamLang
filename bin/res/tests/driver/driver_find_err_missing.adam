-------------------------------------------------------------------------------
  driver_find_err_missing.adam - Driver: a unit no folder has
  (FindUnitNone) is not found, PR0012, after FindUnitB was found in the
  module path's listing (taken once, SU2.8d).
*******************************************************************************/

/*
@@test
  kind cli
  args "check" "--quiet" "<DIR>/driver_find_err_missing.adam"
  exitcode 1
  | <DIR>/driver_find_err_missing.adam(34,19): Error PR0012: the unit 'FindUnitNone' is not found: no 'FindUnitNone.adam' in the importer's folder or the module paths
@@end
*/

module exe driver_find_err_missing;

@addmodulepath "$P:res/tests/driver/fixtures";

import FindUnitB, FindUnitNone;

begin
  println("b {}", FindB());
end.
