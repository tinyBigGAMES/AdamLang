/*
@@test
  kind dep
@@end
*/

module exe acu_roundtrip_first;

@addmodulepath "$P:res/tests/driver/fixtures";

import System.SysUtils, AcuRtUnit;

// The unit's routines and types used as driver\acu_roundtrip uses them
func Show();
var
  LShape: ref AcuRtShape;
  LPoint: AcuRtPoint;
begin
  LShape := AcuRtTriangleOf(6);
  LPoint.X := 1;
  LPoint.Y := 2;
  LPoint := AcuRtMove(LPoint, 3);
  println("{} {} {}", AcuRtName(AcuRtColor.Green), LPoint.X, LPoint.Y);
  println("{}", AcuRtDescribe(LShape));
end;

begin
  Show();
end.
