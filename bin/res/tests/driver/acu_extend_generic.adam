-------------------------------------------------------------------------------
  acu_extend_generic.adam - a unit's public extend taken from its .acu is
  not typed again (EX1): its dep acu_extend_generic_first compiles
  fixtures\ACUExtGenUnit and writes its .acu; this build takes the unit from
  it, so its extend's bodies (generic calls with type arguments, already
  bound to their instances) are used as compiled: a generic method on a
  static call's result and on a local, a generic routine
*******************************************************************************/

/*
@@test
  kind run
  deps driver.acu_extend_generic_first
  exitcode 0
  | owner 15
  | base 6
  | max 9 5
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_extend_generic;

@addmodulepath "$P:res/tests/driver/fixtures";

import ACUExtGenUnit;

var
  GHandle: ExtGenHandle;

begin
  GHandle := ExtGenHandle.Of(5);
  println("owner {}", GHandle.Owner().Value());
  println("base {}", GHandle.Base().Value());
  println("max {} {}", GHandle.AtLeast(9), GHandle.AtLeast(2));
end.
