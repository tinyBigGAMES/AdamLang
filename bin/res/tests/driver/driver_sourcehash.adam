-------------------------------------------------------------------------------
  driver_sourcehash.adam - sourcehash() (BNF sec 7, ACU2): in a program's
  main module a uint64 constant, the hash of the source text of every
  module of the build (never a path or a time, so the same on every host):
  not 0, a typed constant of it equal to the call, and two calls equal.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | nonzero true
  | const same true
  | calls same true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe driver_sourcehash;

const
  // Folded where it is declared, as any constant
  CHash: uint64 = sourcehash();

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

begin
  println("nonzero {}", BoolText(sourcehash() <> 0));
  println("const same {}", BoolText(CHash = sourcehash()));
  println("calls same {}", BoolText(sourcehash() = sourcehash()));
end.
