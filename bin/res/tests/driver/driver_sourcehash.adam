-------------------------------------------------------------------------------
  driver_sourcehash.adam - sourcehash() (BNF sec 7, ACU2 / ACU2b): in a
  program's main module a uint64 constant, the hash of every .adam file in
  the folders the build's modules come from (each file's name and text, in
  name order; never a path or a time, so the same on every host and for
  every target): not 0, a typed constant of it equal to the call, and the
  value this program works out itself from its folders (this test's,
  System.SysUtils' std folder and the runtime's). Its args: the test's
  folder and adam's (<DIR>, <BIN>).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  args "<DIR>" "<BIN>"
  exitcode 0
  | nonzero true
  | const same true
  | calls same true
  | folders' hash true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe driver_sourcehash;

import System.SysUtils, System.IO;

const
  // Folded where it is declared, as any constant
  CHash: uint64 = sourcehash();

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// Every .adam file of the folders AFolders as its name and its text's Fnv1a64, in name
// order, hashed: the definition sourcehash() follows
func FoldersHash(const AFolders: StringArray): uint64;
var
  LEntries: StringArray;
  LFiles: StringArray;
  LText: string;
  LI: int64;
  LJ: int64;
begin
  setlength(LEntries, 0);
  for LI := 0 to len(AFolders) - 1 do
    if GetFiles(AFolders[LI], "*.adam", false, LFiles) then
      for LJ := 0 to len(LFiles) - 1 do
        if ReadAllText(AFolders[LI] + "/" + LFiles[LJ], LText) then
          setlength(LEntries, len(LEntries) + 1);
          LEntries[len(LEntries) - 1] := LFiles[LJ] + "|" + UIntToStr(Fnv1a64(LText));
        end;
      end;
    end;
  end;
  SortStrings(LEntries);
  return Fnv1a64(JoinStrings(LEntries, "\n"));
end;

var
  GFolders: StringArray;

begin
  // This program's modules come from its own folder, the std's and the runtime's
  setlength(GFolders, 3);
  GFolders[0] := paramstr(1);
  GFolders[1] := paramstr(2) + "/res/libs/std";
  GFolders[2] := paramstr(2) + "/res/runtime";
  println("nonzero {}", BoolText(sourcehash() <> 0));
  println("const same {}", BoolText(CHash = sourcehash()));
  println("calls same {}", BoolText(sourcehash() = sourcehash()));
  println("folders' hash {}", BoolText(sourcehash() = FoldersHash(GFolders)));
end.
