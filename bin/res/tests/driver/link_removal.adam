-------------------------------------------------------------------------------
  link_removal.adam - link-time removal (PLAN-ADAM SU2.7): every routine and
  data blob is its own section, and the linker keeps only what the entry
  reaches over relocations, at debug too. KeptPart is called, so its code
  and its string literal are in the exe; GonePart is called by nothing, so
  neither is: its literal's bytes are nowhere in the image. The exe reads
  itself and looks for each literal (the needles are built at run time, so
  no literal of this code holds them whole)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | called SU27-KEPT-ROUTINE
  | kept 1
  | gone 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe link_removal;

import System.SysUtils, System.IO;

const
  // This exe, beside itself in <output>\bin\<triple>\<mode>
  SELF_PATH: string = "$P:link_removal.exe";

// Called: in the image with its literal
routine KeptPart(): string;
begin
  return "SU27-KEPT-ROUTINE";
end;

// Called by nothing: the linker leaves it and its literal out
routine GonePart(): string;
begin
  return "SU27-GONE-ROUTINE";
end;

// 1 when ANeedle's bytes are somewhere in ABytes, else 0
routine Holds(const ABytes: ByteArray; const ANeedle: string): int64;
var
  LI: int64;
  LJ: int64;
  LSame: bool;
begin
  for LI := 0 to len(ABytes) - len(ANeedle) do
    LSame := true;
    for LJ := 0 to len(ANeedle) - 1 do
      if ABytes[LI + LJ] <> uint8(ANeedle[LJ]) then
        LSame := false;
        leave;
      end;
    end;
    if LSame then
      return 1;
    end;
  end;
  return 0;
end;

var
  GBytes: ByteArray;
  GTail: string;

begin
  println("called {}", KeptPart());
  if not ReadAllBytes(SELF_PATH, GBytes) then
    println("cannot read {}", SELF_PATH);
  else
    // The tail apart, so the whole needle is in no literal of this code
    GTail := "ROUTINE";
    println("kept {}", Holds(GBytes, "SU27-KEPT-" + GTail));
    println("gone {}", Holds(GBytes, "SU27-GONE-" + GTail));
  end;
end.
