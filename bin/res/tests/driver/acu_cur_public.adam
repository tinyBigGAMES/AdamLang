-------------------------------------------------------------------------------
  acu_cur_public.adam - a public change in an import recompiles its
  importer (PLAN-ADAM SU2.3): its dep acu_cur_public_first compiled
  AcuCurPubUser against acu_cur_v1's AcuCurPub; this build finds
  acu_cur_v2's, whose public part grew (its interface hash moved), so
  AcuCurPub and AcuCurPubUser are both compiled again (their .acu newer than
  the dep's exe)
*******************************************************************************/

/*
@@test
  kind run
  deps driver.acu_cur_public_first
  exitcode 0
  | AcuCurPub recompiled
  | AcuCurPubUser recompiled
  | value 6
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_cur_public;

@addmodulepath "$P:res/tests/driver/fixtures";
@addmodulepath "$P:res/tests/driver/fixtures/acu_cur_v2";

import System.SysUtils, System.IO, AcuCurPubUser;

const
  // Where this build's units are, and the dep's exe, from the exe's folder (<output>\bin\<triple>\<mode>)
  ACU_DIR: string = "$P:../../../acu/x86_64-windows-gnu/debug/";
  FIRST_EXE: string = "$P:acu_cur_public_first.exe";

// "recompiled" when AName's .acu was written by this build (after the dep's exe), else "kept"
func StateOf(const AName: string): string;
begin
  if FileWriteTime(ACU_DIR + AName + ".acu") > FileWriteTime(FIRST_EXE) then
    return "recompiled";
  end;
  return "kept";
end;

begin
  println("AcuCurPub {}", StateOf("AcuCurPub"));
  println("AcuCurPubUser {}", StateOf("AcuCurPubUser"));
  println("value {}", AcuCurPubUserValue());
end.
