/*
@@test
  kind dep
@@end
*/

module exe acu_refs_first;

@addmodulepath "$P:res/tests/driver/fixtures";

import AcuRefLeft, AcuRefRight;

begin
  println("{} {} {} {}", AcuRefLeftName(), AcuRefLeftSum(), AcuRefRightName(), AcuRefRightSum());
end.
