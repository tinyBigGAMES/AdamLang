-------------------------------------------------------------------------------
  implib_written.adam - adam build of a dll writes its import library
  (PLAN-ADAM M8b): libimplib_written_lib.dll.a in the output folder's
  lib\x86_64-windows-gnu\debug\, read back here byte by byte as link.exe,
  GNU ld and lld read it (llvm-dlltool's member set): the signature; the
  first linker member (each symbol and the member that defines it, in
  member order), the second (the members, the symbols sorted with each one's
  member number); the long-name table (the dll's name, NUL-ended); then the
  members, every one named "/<offset>" (the dll's name): the import
  descriptor object (.idata$2's entry, three ADDR32NB relocations: its import
  lookup table at the start of .idata$4, its name in .idata$6, its import
  address table at the start of .idata$5, both starts section-class (104)
  symbols in section 0; the null descriptor and the null thunk named
  undefined so a linker takes them), the null descriptor (.idata$3), the
  null thunk (.idata$5 and .idata$4, 8 zero bytes each), then one short
  import per export by name (type 0 code, 1 data), sorted, each hint its
  place there. The private routine is nowhere. A member's header is
  "date 0 ids 0 mode 644", a linker member's "0 0 0 0", the long-name
  table's blank (no time stamp)
*******************************************************************************/

/*
@@test
  kind run
  deps driver.implib_written_lib
  exitcode 0
  | signature ok
  | member / 184 [0 0 0 0]
  | member / 196 [0 0 0 0]
  | member // 23 [   ]
  | member /0 [0 0 0 644] object
  | member /0 [0 0 0 644] object
  | member /0 [0 0 0 644] object
  | member /0 [0 0 0 644] 49
  | member /0 [0 0 0 644] 48
  | member /0 [0 0 0 644] 51
  | first 8
  | first __IMPORT_DESCRIPTOR_implib_written_lib m3
  | first __NULL_IMPORT_DESCRIPTOR m4
  | first <DEL>implib_written_lib_NULL_THUNK_DATA m5
  | first Alpha m6
  | first __imp_Alpha m6
  | first Beta m7
  | first __imp_Beta m7
  | first __imp_Counter m8
  | second members 6 symbols 8 offsets ok
  | second Alpha 4
  | second Beta 5
  | second __IMPORT_DESCRIPTOR_implib_written_lib 1
  | second __NULL_IMPORT_DESCRIPTOR 2
  | second __imp_Alpha 4
  | second __imp_Beta 5
  | second __imp_Counter 6
  | second <DEL>implib_written_lib_NULL_THUNK_DATA 3
  | names implib_written_lib.dll<NUL>
  | object m3 machine 8664 sections 2 symbols 10
  | section .idata$2 size 20 flags C0300040
  | reloc 0 type 3 .idata$4
  | reloc 12 type 3 __adam_import_dll_name
  | reloc 16 type 3 .idata$5
  | section .idata$6 size 24 flags C0200040 implib_written_lib.dll
  | symbol .idata$2 section 1 class 3
  | symbol .idata$6 section 2 class 3
  | symbol __IMPORT_DESCRIPTOR_implib_written_lib section 1 class 2
  | symbol __adam_import_dll_name section 2 class 3
  | symbol .idata$4 section 0 class 104
  | symbol .idata$5 section 0 class 104
  | symbol __NULL_IMPORT_DESCRIPTOR section 0 class 2
  | symbol <DEL>implib_written_lib_NULL_THUNK_DATA section 0 class 2
  | object m4 machine 8664 sections 1 symbols 3
  | section .idata$3 size 20 flags C0300040
  | symbol .idata$3 section 1 class 3
  | symbol __NULL_IMPORT_DESCRIPTOR section 1 class 2
  | object m5 machine 8664 sections 2 symbols 5
  | section .idata$5 size 8 flags C0400040
  | section .idata$4 size 8 flags C0400040
  | symbol .idata$5 section 1 class 3
  | symbol .idata$4 section 2 class 3
  | symbol <DEL>implib_written_lib_NULL_THUNK_DATA section 1 class 2
  | import m6 Alpha implib_written_lib.dll machine 8664 type 0 naming 1 hint 0
  | import m7 Beta implib_written_lib.dll machine 8664 type 0 naming 1 hint 1
  | import m8 Counter implib_written_lib.dll machine 8664 type 1 naming 1 hint 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe implib_written;

import System.SysUtils, System.IO;

const
  // The import library, from the exe's folder (<output>\bin\<triple>\<mode>)
  IMPLIB_PATH: string = "$P:../../../lib/x86_64-windows-gnu/debug/libimplib_written_lib.dll.a";
  // An archive's signature and member header (Archive Member Headers)
  SIGNATURE_SIZE: int64 = 8;
  HEADER_SIZE: int64 = 60;
  // COFF: the file header, a section header, a relocation, a symbol (PE Format)
  COFF_HEADER_SIZE: int64 = 20;
  SECTION_SIZE: int64 = 40;
  RELOC_SIZE: int64 = 10;
  SYMBOL_SIZE: int64 = 18;

var
  GBytes: ByteArray;
  // Each member's header offset and data size, in file order (the linker members and the
  // long-name table included)
  GHeaders: Int64Array;
  GSizes: Int64Array;

// The ACount bytes of GBytes at AAt as text (one block copy)
func TextAt(const AAt: int64; const ACount: int64): string;
begin
  if ACount <= 0 then
    return "";
  end;
  return StringFromC(ptr to const char(addr of GBytes[AAt]), ACount);
end;

// The NUL-ended text at AAt of GBytes
func NulTextAt(const AAt: int64): string;
var
  LEnd: int64;
begin
  LEnd := AAt;
  while GBytes[LEnd] <> 0 do
    LEnd := LEnd + 1;
  end;
  return TextAt(AAt, LEnd - AAt);
end;

// AText as this row prints it: a DEL byte as <DEL>, a NUL as <NUL>
func Shown(const AText: string): string;
begin
  return ReplaceStr(ReplaceStr(AText, StringOfChar(char(uint8(0x7F)), 1), "<DEL>"),
    StringOfChar(char(uint8(0)), 1), "<NUL>");
end;

// The big-endian 32-bit value at AAt of GBytes
func Be32(const AAt: int64): int64;
begin
  return (int64(GBytes[AAt]) shl 24) | (int64(GBytes[AAt + 1]) shl 16) |
    (int64(GBytes[AAt + 2]) shl 8) | int64(GBytes[AAt + 3]);
end;

// The little-endian ACount-byte value at AAt of GBytes
func Le(const AAt: int64; const ACount: int64): int64;
begin
  return int64(GetLe(GBytes, AAt, ACount));
end;

// The member index whose header is at AHeaderAt; -1 for none
func MemberAt(const AHeaderAt: int64): int64;
var
  LI: int64;
begin
  for LI := 0 to len(GHeaders) - 1 do
    if GHeaders[LI] = AHeaderAt then
      return LI;
    end;
  end;
  return -1;
end;

// Every member header: "member <name field> <size or object> [<date> <uid> <gid> <mode>]";
// false when a header does not end as one must
func ReadMembers(): bool;
var
  LAt: int64;
  LCount: int64;
  LSize: int64;
  LText: string;
begin
  LAt := SIGNATURE_SIZE;
  LCount := 0;
  setlength(GHeaders, 16);
  setlength(GSizes, 16);
  while LAt < len(GBytes) do
    if (GBytes[LAt + 58] <> 0x60) or (GBytes[LAt + 59] <> 0x0A) then
      println("header end bad at {}", LAt);
      return false;
    end;
    LSize := StrToIntDef(Trim(TextAt(LAt + 48, 10)), -1);
    if LSize < 0 then
      println("header size bad at {}", LAt);
      return false;
    end;
    if LCount = len(GHeaders) then
      setlength(GHeaders, LCount * 2);
      setlength(GSizes, LCount * 2);
    end;
    GHeaders[LCount] := LAt;
    GSizes[LCount] := LSize;
    LCount := LCount + 1;
    LText := "member " + TrimRight(TextAt(LAt, 16));
    // An object starts with its Machine, a short import with 00 00 FF FF
    if (LCount > 3) and (GBytes[LAt + HEADER_SIZE + 2] <> 0xFF) then
      LText := LText + " [" + Trim(TextAt(LAt + 16, 12)) + " " + Trim(TextAt(LAt + 28, 6)) +
        " " + Trim(TextAt(LAt + 34, 6)) + " " + Trim(TextAt(LAt + 40, 8)) + "] object";
    else
      if LCount > 3 then
        LText := LText + " [" + Trim(TextAt(LAt + 16, 12)) + " " + Trim(TextAt(LAt + 28, 6)) +
          " " + Trim(TextAt(LAt + 34, 6)) + " " + Trim(TextAt(LAt + 40, 8)) + "] " + IntToStr(LSize);
      else
        LText := LText + " " + IntToStr(LSize) + " [" + Trim(TextAt(LAt + 16, 12)) + " " +
          Trim(TextAt(LAt + 28, 6)) + " " + Trim(TextAt(LAt + 34, 6)) + " " +
          Trim(TextAt(LAt + 40, 8)) + "]";
      end;
    end;
    println("{}", LText);
    LAt := LAt + HEADER_SIZE + LSize + (LSize & 1);
  end;
  setlength(GHeaders, LCount);
  setlength(GSizes, LCount);
  return true;
end;

// The first linker member: its count, then each symbol and the member at its offset
func ShowFirst();
var
  LAt: int64;
  LCount: int64;
  LName: int64;
  LI: int64;
  LText: string;
begin
  LAt := GHeaders[0] + HEADER_SIZE;
  LCount := Be32(LAt);
  println("first {}", LCount);
  LName := LAt + 4 + 4 * LCount;
  for LI := 0 to LCount - 1 do
    LText := NulTextAt(LName);
    println("first {} m{}", Shown(LText), MemberAt(Be32(LAt + 4 + 4 * LI)));
    LName := LName + len(LText) + 1;
  end;
end;

// The second linker member: its counts, whether its offsets are the members', then each
// sorted symbol and its member number
func ShowSecond();
var
  LAt: int64;
  LMembers: int64;
  LSymbols: int64;
  LOk: string;
  LName: int64;
  LI: int64;
  LText: string;
begin
  LAt := GHeaders[1] + HEADER_SIZE;
  LMembers := Le(LAt, 4);
  LOk := "ok";
  for LI := 0 to LMembers - 1 do
    if Le(LAt + 4 + 4 * LI, 4) <> GHeaders[LI + 3] then
      LOk := "bad";
    end;
  end;
  LAt := LAt + 4 + 4 * LMembers;
  LSymbols := Le(LAt, 4);
  println("second members {} symbols {} offsets {}", LMembers, LSymbols, LOk);
  LName := LAt + 4 + 2 * LSymbols;
  for LI := 0 to LSymbols - 1 do
    LText := NulTextAt(LName);
    println("second {} {}", Shown(LText), Le(LAt + 4 + 2 * LI, 2));
    LName := LName + len(LText) + 1;
  end;
end;

// The name of the COFF symbol record at ASymbol (its 8 bytes, or the text at the string
// table AStrings when its first 4 are 0)
func SymbolName(const ASymbol: int64; const AStrings: int64): string;
begin
  if Le(ASymbol, 4) = 0 then
    return NulTextAt(AStrings + Le(ASymbol + 4, 4));
  end;
  return TrimRight(ReplaceStr(TextAt(ASymbol, 8), StringOfChar(char(uint8(0)), 1), " "));
end;

// The COFF object member AMember: its Machine and counts, each section (name, size, flags,
// its relocations and their symbols; .idata$6's text), each symbol (name, section, class)
func ShowObject(const AMember: int64);
var
  LAt: int64;
  LSections: int64;
  LSymbolsAt: int64;
  LSymbols: int64;
  LStrings: int64;
  LS: int64;
  LHead: int64;
  LRaw: int64;
  LRelocs: int64;
  LR: int64;
  LRecord: int64;
  LText: string;
begin
  LAt := GHeaders[AMember] + HEADER_SIZE;
  LSections := Le(LAt + 2, 2);
  LSymbolsAt := LAt + Le(LAt + 8, 4);
  LSymbols := Le(LAt + 12, 4);
  LStrings := LSymbolsAt + SYMBOL_SIZE * LSymbols;
  println("object m{} machine {} sections {} symbols {}", AMember, IntToHex(uint64(Le(LAt, 2)), 4),
    LSections, LSymbols);
  for LS := 0 to LSections - 1 do
    LHead := LAt + COFF_HEADER_SIZE + SECTION_SIZE * LS;
    LRaw := Le(LHead + 16, 4);
    LText := "section " + TrimRight(ReplaceStr(TextAt(LHead, 8), StringOfChar(char(uint8(0)), 1), " ")) +
      " size " + IntToStr(LRaw) + " flags " + IntToHex(uint64(Le(LHead + 36, 4)), 8);
    if TrimRight(ReplaceStr(TextAt(LHead, 8), StringOfChar(char(uint8(0)), 1), " ")) = ".idata$6" then
      LText := LText + " " + NulTextAt(LAt + Le(LHead + 20, 4));
    end;
    println("{}", LText);
    LRelocs := Le(LHead + 32, 2);
    for LR := 0 to LRelocs - 1 do
      LRecord := LAt + Le(LHead + 24, 4) + RELOC_SIZE * LR;
      println("reloc {} type {} {}", Le(LRecord, 4), Le(LRecord + 8, 2),
        Shown(SymbolName(LSymbolsAt + SYMBOL_SIZE * Le(LRecord + 4, 4), LStrings)));
    end;
  end;
  LS := 0;
  while LS < LSymbols do
    LRecord := LSymbolsAt + SYMBOL_SIZE * LS;
    println("symbol {} section {} class {}", Shown(SymbolName(LRecord, LStrings)),
      Le(LRecord + 12, 2), int64(GBytes[LRecord + 16]));
    // Its auxiliary records follow it
    LS := LS + 1 + int64(GBytes[LRecord + 17]);
  end;
end;

// The short import member AMember: its symbol, its DLL, Machine, import type, name type, hint
func ShowImport(const AMember: int64);
var
  LAt: int64;
  LSymbol: string;
  LDll: string;
  LType: int64;
begin
  LAt := GHeaders[AMember] + HEADER_SIZE;
  LSymbol := NulTextAt(LAt + 20);
  LDll := NulTextAt(LAt + 20 + len(LSymbol) + 1);
  LType := Le(LAt + 18, 2);
  println("import m{} {} {} machine {} type {} naming {} hint {}", AMember, LSymbol, LDll,
    IntToHex(uint64(Le(LAt + 6, 2)), 4), LType & 3, (LType shr 2) & 7, Le(LAt + 16, 2));
end;

// The import library read and shown (see the header)
func ShowLibrary();
var
  LI: int64;
begin
  if not ReadAllBytes(IMPLIB_PATH, GBytes) then
    println("no import library");
    return;
  end;
  if TextAt(0, SIGNATURE_SIZE) = "!<arch>\n" then
    println("signature ok");
  end;
  if not ReadMembers() then
    return;
  end;
  ShowFirst();
  ShowSecond();
  println("names {}", Shown(TextAt(GHeaders[2] + HEADER_SIZE, GSizes[2])));
  for LI := 3 to len(GHeaders) - 1 do
    if GBytes[GHeaders[LI] + HEADER_SIZE + 2] = 0xFF then
      ShowImport(LI);
    else
      ShowObject(LI);
    end;
  end;
end;

begin
  ShowLibrary();
end.
