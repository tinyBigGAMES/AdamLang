-------------------------------------------------------------------------------
  acu_foreign.adam - the shared compiled-unit cache keeps another compiler's
  .acu: a std unit's .acu in res\acu\<triple>\<mode>\ written by another
  compiler (the installed adam, while a stage A or adamtest's own driver
  builds) is never written over; this compiler's goes to the user's cache
  (UserCacheDir\Adam\acu\<triple>\<mode>\), which its next build keeps, and
  the shared one stays the other compiler's, byte for byte. The other
  compiler is planted: the shared .acu's compiler id changed in its header
  (Adam.ACU.Format). Its args: the adam exe, the output root, adam's folder,
  the run cell (<ADAM>, <OUT>, <BIN>, <CELL>). It runs in acu_shared's
  scratch install (<OUT>\shared_cache), made again, LOCALAPPDATA pointed
  into it, so the real std and the real user's cache are never touched. The
  program it builds is named for this exe (+ _prog)
*******************************************************************************/

/*
@@test
  kind run
  args "<ADAM>" "<OUT>" "<BIN>" "<CELL>"
  exitcode 0
  | install true
  | build 0
  | shared written true
  | planted true
  | build 0
  | shared kept true
  | user written true
  | build 0
  | user kept true
  | shared kept true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_foreign;

import System.SysUtils, System.Windows, System.IO, System.Process;

const
  // The scratch install below the output root (acu_shared's, CLAUDE O.1's one named
  // scratch folder)
  SCRATCH_DIR: string = "/shared_cache";
  // The std unit the program imports, and the folders copied into the install
  EDITED_UNIT: string = "System.SysUtils";
  STD_DIR: string = "/res/libs/std";
  RUNTIME_DIR: string = "/res/runtime";
  // The variable the install's adam takes its user cache from (System.Windows'
  // UserCacheDir), and that cache's folder in the install
  USER_CACHE_ENV: string = "LOCALAPPDATA";
  USER_DIR: string = "/user";
  // An .acu's unit section opens with this magic, then a u32 format version, the
  // compiler's version as a counted text, then the u64 compiler id (Adam.ACU.Format)
  ACU_MAGIC: string = "ADAM.ACU";
  ACU_MAGIC_AND_FORMAT: int64 = 12;

var
  GOut: string;
  GBin: string;
  GCell: string;
  GRoot: string;
  GProgram: string;
  GShared: string;
  GUser: string;
  GPlanted: ByteArray;

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// Every .adam file of AFrom copied into ATo (made first); false when one cannot be
func CopySources(const AFrom: string; const ATo: string): bool;
var
  LList: StringArray;
  LBytes: ByteArray;
  LI: int64;
begin
  if not ForceDirectories(ATo) or not GetFiles(AFrom, LList) then
    return false;
  end;
  for LI := 0 to len(LList) - 1 do
    if EndsStr(".adam", LList[LI]) then
      if not ReadAllBytes(AFrom + "/" + LList[LI], LBytes) or
        not WriteAllBytes(ATo + "/" + LList[LI], LBytes) then
        return false;
      end;
    end;
  end;
  return true;
end;

// The scratch install made again: the adam exe AAdam beside a copy of the std and the
// runtime, and the program it builds (GProgram: it imports EDITED_UNIT; the system
// libraries and libc.a, which every image links, are found in the real install's folders)
func Install(const AAdam: string): bool;
var
  LBytes: ByteArray;
  LText: string;
begin
  if not ForceDirectories(GRoot) or not ReadAllBytes(AAdam, LBytes) or
    not WriteAllBytes(GRoot + "/adam.exe", LBytes) then
    return false;
  end;
  if not CopySources(GBin + STD_DIR, GRoot + STD_DIR) or
    not CopySources(GBin + RUNTIME_DIR, GRoot + RUNTIME_DIR) then
    return false;
  end;
  LText := "module exe " + GProgram + ";\n\n@addlibrarypath \"" + GBin + "/res/libs/system/" +
    ExtractFileDir(GCell) + "\";\n@addlibrarypath \"" + GBin + "/res/libs/vendor/" +
    ExtractFileDir(GCell) + "\";\n\nimport " + EDITED_UNIT + ";\n\nbegin\n" +
    "  println(\"{}\", IntToStr(7));\nend.\n";
  return WriteAllText(GRoot + "/" + GProgram + ".adam", LText);
end;

// The install's adam builds the program into the output root: its exit code (255 when it
// cannot be started), its output printed when it fails
func Build(): int64;
var
  LArgs: StringArray;
  LOutput: string;
  LExit: uint32;
begin
  setlength(LArgs, 6);
  LArgs[0] := "build";
  LArgs[1] := "--no-banner";
  LArgs[2] := "--quiet";
  LArgs[3] := GRoot + "/" + GProgram + ".adam";
  LArgs[4] := "-o";
  LArgs[5] := GOut;
  if not RunProcess(GRoot + "/adam.exe", LArgs, GRoot, LOutput, LExit) then
    return 255;
  end;
  if LExit <> 0 then
    println("{}", LOutput);
  end;
  return int64(LExit);
end;

// The index of ACU_MAGIC in ABytes (-1: none)
func MagicAt(const ABytes: ByteArray): int64;
var
  LI: int64;
  LJ: int64;
  LMatch: bool;
begin
  for LI := 0 to len(ABytes) - len(ACU_MAGIC) do
    LMatch := true;
    for LJ := 0 to len(ACU_MAGIC) - 1 do
      if ABytes[LI + LJ] <> uint8(ACU_MAGIC[LJ]) then
        LMatch := false;
        leave;
      end;
    end;
    if LMatch then
      return LI;
    end;
  end;
  return -1;
end;

// The shared .acu made another compiler's: the first byte of its compiler id flipped,
// the file written back and kept in GPlanted; false when it has no unit section
func PlantOther(): bool;
var
  LAt: int64;
  LCount: int64;
  LShift: int64;
  LByte: uint8;
begin
  if not ReadAllBytes(GShared, GPlanted) then
    return false;
  end;
  LAt := MagicAt(GPlanted);
  if LAt < 0 then
    return false;
  end;
  // The compiler version's length: a LEB128 count, then its bytes
  LAt := LAt + ACU_MAGIC_AND_FORMAT;
  LCount := 0;
  LShift := 0;
  repeat
    LByte := GPlanted[LAt];
    LAt := LAt + 1;
    LCount := LCount | (int64(LByte & 127) shl LShift);
    LShift := LShift + 7;
  until LByte < 128;
  LAt := LAt + LCount;
  GPlanted[LAt] := uint8(GPlanted[LAt] xor 255);
  return WriteAllBytes(GShared, GPlanted);
end;

// True when the shared .acu is still the planted one, byte for byte
func SharedKept(): bool;
var
  LBytes: ByteArray;
  LI: int64;
begin
  if not ReadAllBytes(GShared, LBytes) or (len(LBytes) <> len(GPlanted)) then
    return false;
  end;
  for LI := 0 to len(LBytes) - 1 do
    if LBytes[LI] <> GPlanted[LI] then
      return false;
    end;
  end;
  return true;
end;

var
  LUserTime: int64;
begin
  GOut := paramstr(2);
  GBin := paramstr(3);
  GCell := paramstr(4);
  GRoot := GOut + SCRATCH_DIR;
  // This exe's name without ".exe", + "_prog"
  GProgram := ExtractFileName(paramstr(0));
  GProgram := Substring(GProgram, 0, len(GProgram) - 4) + "_prog";
  GShared := GRoot + "/res/acu/" + GCell + "/" + EDITED_UNIT + ".acu";
  GUser := GRoot + USER_DIR + "/Adam/acu/" + GCell + "/" + EDITED_UNIT + ".acu";
  // Both caches' files of the unit are this row's to make: an earlier run's (or
  // acu_shared's) go first, so the first build writes the shared one
  SetFileReadOnly(GShared, false);
  DeleteFile(GShared);
  DeleteFile(GUser);
  println("install {}", BoolText(Install(paramstr(1)) and
    SetEnvironmentVariable(USER_CACHE_ENV, GRoot + USER_DIR)));

  // This compiler's .acu in the shared cache, then made another compiler's
  println("build {}", Build());
  println("shared written {}", BoolText(FileExists(GShared)));
  println("planted {}", BoolText(PlantOther()));

  // The next build compiles the unit (the shared .acu is not its own) into the user's
  // cache and leaves the shared one as it is
  println("build {}", Build());
  println("shared kept {}", BoolText(SharedKept()));
  println("user written {}", BoolText(FileExists(GUser)));

  // And the build after it keeps the user's .acu: its own, current
  LUserTime := FileWriteTime(GUser);
  println("build {}", Build());
  println("user kept {}", BoolText(FileWriteTime(GUser) = LUserTime));
  println("shared kept {}", BoolText(SharedKept()));
end.
