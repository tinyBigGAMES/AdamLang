-------------------------------------------------------------------------------
  acu_lower.adam - a build compiles only what changed (PLAN-ADAM SU2.4b),
  told by its phase lines, no timing: its dep acu_lower_first compiled every
  unit, ACULowPriv from acu_low_v1; this build finds acu_low_v2's, whose
  change is private, so the Lower line counts 2 units: ACULowPriv
  (compiled alone into its .acu) and this main module (always parsed).
  ACULowUser and the runtime's units come from their .acu, neither lowered
  nor generated, their code linked as the .acu holds it; -r runs the exe:
  the new private body's value shows the merged code is current
*******************************************************************************/

/*
@@test
  kind cli
  deps driver.acu_lower_first
  args "build" "--no-banner" "<DIR>/acu_lower.adam" "-o" "." "-r"
  exitcode 0
  | Parsed 1 unit (<NUM> lines), 7 from .acu in <NUM>s
  | Analyzed in <NUM>s
  | Lowered 2 units (<NUM> routines) in <NUM>s
  | Generated <NUM> bytes of code in <NUM>s
  | Linked acu_lower.exe (libraries: 3) in <NUM>s
  | Built <DIR>/acu_lower.adam -> <OUT>/bin/<CELL>/acu_lower.exe in <NUM>s
  | value 42
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_lower;

@addmodulepath "$P:res/tests/driver/fixtures";
@addmodulepath "$P:res/tests/driver/fixtures/acu_low_v2";

import ACULowUser;

begin
  println("value {}", ACULowUserValue());
end.
