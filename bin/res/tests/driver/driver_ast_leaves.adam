-------------------------------------------------------------------------------
  driver_ast_leaves.adam - the AST's leaves (PLAN-ADAM SU2.8d d5): a node
  keeps no children list until its first child, so a leaf costs no list.
  A leaf has no children (ChildCount 0, FirstOf / NthOf 0, CountOf 0),
  ChildAt on it raises the same "no child" fault as an index past a
  parent's last child, ReorderChildren takes an empty order on a leaf
  and refuses any other, the first Attach makes the list (later ones add
  to it), a parent's children reorder, and DumpTree walks through leaves
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | leaf 0 0 0 0
  | leaf childat refused
  | leaf order kept 0
  | leaf order refused
  | parent 2 first second 1 1
  | parent childat refused
  | parent reordered second first
  | dump 3 lines
@@end
*/

module exe driver_ast_leaves;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Compiler.SourceText, Adam.Compiler.AST, Adam.Core.Containers;

// The fault text ChildAt raises for AId's AIndex (its unit keeps the text hidden)
func NoChildText(const AId: int64; const AIndex: int64): string;
begin
  return "AST: no child at that index of node #" + IntToStr(AId) + ", index " + IntToStr(AIndex);
end;

// "refused" when ChildAt(AId, AIndex) raises ChildAt's fault, else what it did
func ChildAtResult(const ATree: ref SyntaxTree; const AId: int64; const AIndex: int64): string;
var
  LResult: string;
  LChild: int64;
begin
  guard
    LChild := ATree.ChildAt(AId, AIndex);
    LResult := "returned " + IntToStr(LChild);
  except
    LResult := "raised " + excmsg();
    if excmsg() = NoChildText(AId, AIndex) then
      LResult := "refused";
    end;
  end;
  return LResult;
end;

// "refused" when ReorderChildren(AId, AOrder) raises, else "kept" and the child count
func OrderResult(const ATree: ref SyntaxTree; const AId: int64; const AOrder: ref NodeList): string;
var
  LResult: string;
begin
  guard
    ATree.ReorderChildren(AId, AOrder);
    LResult := "kept " + IntToStr(ATree.ChildCount(AId));
  except
    LResult := "refused";
  end;
  return LResult;
end;

// How many lines AText has
func LineCount(const AText: string): int64;
var
  LCount: int64;
  LI: int64;
begin
  LCount := 1;
  for LI := 0 to len(AText) - 1 do
    if AText[LI] = '\n' then
      LCount := LCount + 1;
    end;
  end;
  return LCount;
end;

// The text of a node: which one it is
func NameOf(const AId: int64; const AFirst: int64; const ASecond: int64): string;
begin
  if AId = AFirst then
    return "first";
  end;
  if AId = ASecond then
    return "second";
  end;
  return "other";
end;

var
  GTree: ref SyntaxTree;
  GLeaf: int64;
  GParent: int64;
  GFirst: int64;
  GSecond: int64;
  GOrder: ref NodeList;

begin
  SetHeapReport(false);
  GTree := ref SyntaxTree();

  // A new node is a leaf
  GLeaf := GTree.Add(NodeKind.IntLiteral, NoPlace(), 0, 0);
  println("leaf {} {} {} {}", GTree.ChildCount(GLeaf), GTree.FirstOf(GLeaf, NodeRole.Value),
    GTree.NthOf(GLeaf, NodeRole.Value, 1), GTree.CountOf(GLeaf, NodeRole.Value));
  println("leaf childat {}", ChildAtResult(GTree, GLeaf, 0));
  GOrder := ref NodeList();
  println("leaf order {}", OrderResult(GTree, GLeaf, GOrder));
  GOrder.Add(GLeaf);
  println("leaf order {}", OrderResult(GTree, GLeaf, GOrder));

  // The first child makes the list, the second adds to it
  GParent := GTree.Add(NodeKind.Block, NoPlace(), 0, 0);
  GFirst := GTree.AddChild(GParent, NodeRole.Statement, NodeKind.ExpressionStatement, NoPlace(), 0, 0);
  GSecond := GTree.AddChild(GParent, NodeRole.Value, NodeKind.IntLiteral, NoPlace(), 0, 0);
  println("parent {} {} {} {} {}", GTree.ChildCount(GParent),
    NameOf(GTree.ChildAt(GParent, 0), GFirst, GSecond), NameOf(GTree.ChildAt(GParent, 1), GFirst, GSecond),
    GTree.CountOf(GParent, NodeRole.Value), GTree.CountOf(GParent, NodeRole.Statement));
  println("parent childat {}", ChildAtResult(GTree, GParent, 2));

  GOrder := ref NodeList();
  GOrder.Add(GSecond);
  GOrder.Add(GFirst);
  GTree.ReorderChildren(GParent, GOrder);
  println("parent reordered {} {}", NameOf(GTree.ChildAt(GParent, 0), GFirst, GSecond),
    NameOf(GTree.ChildAt(GParent, 1), GFirst, GSecond));

  // The parent and its two leaves
  println("dump {} lines", LineCount(GTree.DumpTree(GParent)));
end.
