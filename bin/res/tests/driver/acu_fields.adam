-------------------------------------------------------------------------------
  acu_fields.adam - a unit taken from its .acu keeps every field its records
  hold (SU2.8d d4: a node record writes only the fields that differ from a
  new node's, numbers as vars, signed ones zigzagged): its dep
  acu_fields_first compiles fixtures\AcuFieldUnit; this build loads it
  (its .acu older than this module's) and reads its folded constants (-7,
  the least int64, -0.0 by its bits), its UTF-8 and UTF-16 texts, its
  record's layout (an array of records written and read back) and its
  objects' vtable (a leaf object here overrides one slot, inherits the
  other). Each value is what it is from source.
*******************************************************************************/

/*
@@test
  kind run
  deps driver.acu_fields_first
  exitcode 0
  | AcuFieldUnit loaded
  | neg -7 -21
  | least -9223372036854775808
  | zero 9223372036854775808
  | text héllo wörld 13
  | wide 4
  | rec 1 -1000 0
  | rec 2 -2000 7
  | rec 3 -3000 14
  | leaf 42
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_fields;

@addmodulepath "$P:res/tests/driver/fixtures";

import System.SysUtils, System.Windows, AcuFieldUnit;

const
  // Where this build's units are, from the exe's folder (<output>\bin\<triple>\<mode>)
  ACU_DIR: string = "$P:../../../acu/x86_64-windows-gnu/debug/";

type
  // One slot overridden here, the other AcuFieldMore's
  AcuFieldLeaf = object(AcuFieldMore)
    override method Kind(): string;
    begin
      return "leaf";
    end;
  end;

// "loaded" when AName's .acu is older than this module's, written by this build
routine UnitSource(const AName: string): string;
begin
  if FileWriteTime(ACU_DIR + AName + ".acu") < FileWriteTime(ACU_DIR + "acu_fields.acu") then
    return "loaded";
  end;
  return "parsed";
end;

// Three records written, then read back: each field where the unit's layout put it
routine ShowRecords();
var
  LRecords: array of AcuFieldRec;
  LI: int64;
begin
  setlength(LRecords, 3);
  for LI := 0 to 2 do
    LRecords[LI].Tag := uint8(LI + 1);
    LRecords[LI].Wide := -(LI + 1) * 1000;
    LRecords[LI].Small := int32(LI * 7);
  end;
  for LI := 0 to 2 do
    println("rec {} {} {}", LRecords[LI].Tag, LRecords[LI].Wide, LRecords[LI].Small);
  end;
end;

// The two slots called through the base type
routine ShowObject(const AObject: ref AcuFieldBase);
begin
  println("{} {}", AObject.Kind(), AObject.Count());
end;

var
  GLeaf: ref AcuFieldLeaf;

begin
  println("AcuFieldUnit {}", UnitSource("AcuFieldUnit"));
  println("neg {} {}", AcuFieldNeg, AcuFieldNeg * 3);
  println("least {}", AcuFieldLeast);
  println("zero {}", Float64ToBits(AcuFieldZero));
  println("text {} {}", AcuFieldText, len(AcuFieldText));
  println("wide {}", len(AcuFieldWide));
  ShowRecords();
  GLeaf := ref AcuFieldLeaf();
  ShowObject(GLeaf);
end.
