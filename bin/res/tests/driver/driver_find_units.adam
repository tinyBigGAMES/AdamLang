/*
@@test
  kind run
  exitcode 0
  | a 11
  | b 31
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe driver_find_units;

@addmodulepath "$P:res/tests/driver/fixtures";

import FindUnitA, FindUnitB;

begin
  println("a {}", FindA());
  println("b {}", FindB());
end.
