-------------------------------------------------------------------------------
  acu_shared.adam - the shared compiled-unit cache (PLAN-ADAM SU2.6): a std
  unit's .acu is in res\acu\<triple>\<mode>\ beside adam.exe, kept by the
  next build, compiled again after its source is edited; when that file
  cannot be written (read-only), the build writes it to the user's cache
  (UserCacheDir\Adam\acu\<triple>\<mode>\) and the next build keeps that one
  (the stale shared one is never written). Its args: the adam exe, the
  output root, adam's folder, the run cell (<ADAM>, <OUT>, <BIN>, <CELL>).
  It runs in a scratch install (<OUT>\shared_cache: a copy of adam.exe, the
  std and the runtime), so the real std is never edited, and points
  LOCALAPPDATA into it for the adam it starts, so no run writes the real
  user's cache. The program it builds is named for this exe (+ _prog)
*******************************************************************************/

/*
@@test
  kind run
  args "<ADAM>" "<OUT>" "<BIN>" "<CELL>"
  exitcode 0
  | install true
  | build 0
  | shared written true
  | build 0
  | shared kept true
  | edit true
  | build 0
  | shared recompiled true
  | read-only true
  | edit true
  | build 0
  | shared kept true
  | user written true
  | build 0
  | user kept true
  | shared kept true
  | writable true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_shared;

import System.SysUtils, System.Windows, System.IO;

const
  // The scratch install below the output root (CLAUDE O.1's one named scratch folder)
  SCRATCH_DIR: string = "/shared_cache";
  // The std unit edited in the install's copy, and the folders copied into it
  EDITED_UNIT: string = "System.SysUtils";
  STD_DIR: string = "/res/libs/std";
  RUNTIME_DIR: string = "/res/runtime";
  // The variable the install's adam takes its user cache from (System.Windows'
  // UserCacheDir), and that cache's folder in the install
  USER_CACHE_ENV: string = "LOCALAPPDATA";
  USER_DIR: string = "/user";

var
  GOut: string;
  GBin: string;
  GCell: string;
  GRoot: string;
  GProgram: string;
  GShared: string;
  GUser: string;
  GEdits: int64;
  GSharedTime: int64;
  GUserTime: int64;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// Every .adam file of AFrom copied into ATo (made first); false when one cannot be
routine CopySources(const AFrom: string; const ATo: string): bool;
var
  LList: StringArray;
  LBytes: ByteArray;
  LI: int64;
begin
  if not ForceDirectories(ATo) or not GetFiles(AFrom, LList) then
    return false;
  end;
  for LI := 0 to len(LList) - 1 do
    if EndsStr(".adam", LList[LI]) then
      if not ReadAllBytes(AFrom + "/" + LList[LI], LBytes) or
        not WriteAllBytes(ATo + "/" + LList[LI], LBytes) then
        return false;
      end;
    end;
  end;
  return true;
end;

// The scratch install made again: the adam exe AAdam beside a copy of the std and the
// runtime, and the program it builds (GProgram: it imports EDITED_UNIT; the system
// libraries it links are found in the real install's folder)
routine Install(const AAdam: string): bool;
var
  LBytes: ByteArray;
  LText: string;
begin
  if not ForceDirectories(GRoot) or not ReadAllBytes(AAdam, LBytes) or
    not WriteAllBytes(GRoot + "/adam.exe", LBytes) then
    return false;
  end;
  if not CopySources(GBin + STD_DIR, GRoot + STD_DIR) or
    not CopySources(GBin + RUNTIME_DIR, GRoot + RUNTIME_DIR) then
    return false;
  end;
  LText := "module exe " + GProgram + ";\n\n@addlibrarypath \"" + GBin + "/res/libs/system/" +
    ExtractFileDir(GCell) + "\";\n\nimport " + EDITED_UNIT + ";\n\nbegin\n" +
    "  println(\"{}\", IntToStr(7));\nend.\n";
  return WriteAllText(GRoot + "/" + GProgram + ".adam", LText);
end;

// The install's adam builds the program into the output root: its exit code (255 when it
// cannot be started), its output printed when it fails
routine Build(): int64;
var
  LArgs: StringArray;
  LOutput: string;
  LExit: uint32;
begin
  setlength(LArgs, 6);
  LArgs[0] := "build";
  LArgs[1] := "--no-banner";
  LArgs[2] := "--quiet";
  LArgs[3] := GRoot + "/" + GProgram + ".adam";
  LArgs[4] := "-o";
  LArgs[5] := GOut;
  if not RunProcess(GRoot + "/adam.exe", LArgs, GRoot, LOutput, LExit) then
    return 255;
  end;
  if LExit <> 0 then
    println("{}", LOutput);
  end;
  return int64(LExit);
end;

// The install's copy of EDITED_UNIT changed (a comment line put first): its .acu is no
// longer current
routine EditUnit(): bool;
var
  LPath: string;
  LText: string;
begin
  LPath := GRoot + STD_DIR + "/" + EDITED_UNIT + ".adam";
  GEdits := GEdits + 1;
  if not ReadAllText(LPath, LText) then
    return false;
  end;
  return WriteAllText(LPath, "// acu_shared edit " + IntToStr(GEdits) + "\n" + LText);
end;

begin
  GOut := paramstr(2);
  GBin := paramstr(3);
  GCell := paramstr(4);
  GRoot := GOut + SCRATCH_DIR;
  // This exe's name without ".exe", + "_prog"
  GProgram := ExtractFileName(paramstr(0));
  GProgram := Substring(GProgram, 0, len(GProgram) - 4) + "_prog";
  GShared := GRoot + "/res/acu/" + GCell + "/" + EDITED_UNIT + ".acu";
  GUser := GRoot + USER_DIR + "/Adam/acu/" + GCell + "/" + EDITED_UNIT + ".acu";
  GEdits := 0;
  // A run stopped half way may have left the shared .acu read-only
  SetFileReadOnly(GShared, false);
  println("install {}", BoolText(Install(paramstr(1)) and
    SetEnvironmentVariable(USER_CACHE_ENV, GRoot + USER_DIR)));

  // Compiled into the shared cache, then kept
  println("build {}", Build());
  println("shared written {}", BoolText(FileExists(GShared)));
  GSharedTime := FileWriteTime(GShared);
  println("build {}", Build());
  println("shared kept {}", BoolText(FileWriteTime(GShared) = GSharedTime));

  // A std edit: compiled again on the next build
  println("edit {}", BoolText(EditUnit()));
  println("build {}", Build());
  println("shared recompiled {}", BoolText(FileWriteTime(GShared) > GSharedTime));

  // A read-only shared .acu: the edit goes to the user's cache, which the next build keeps
  GSharedTime := FileWriteTime(GShared);
  GUserTime := FileWriteTime(GUser);
  println("read-only {}", BoolText(SetFileReadOnly(GShared, true)));
  println("edit {}", BoolText(EditUnit()));
  println("build {}", Build());
  println("shared kept {}", BoolText(FileWriteTime(GShared) = GSharedTime));
  println("user written {}", BoolText(FileWriteTime(GUser) > GUserTime));
  GUserTime := FileWriteTime(GUser);
  println("build {}", Build());
  println("user kept {}", BoolText(FileWriteTime(GUser) = GUserTime));
  println("shared kept {}", BoolText(FileWriteTime(GShared) = GSharedTime));
  println("writable {}", BoolText(SetFileReadOnly(GShared, false)));
end.
