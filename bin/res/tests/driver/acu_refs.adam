-------------------------------------------------------------------------------
  acu_refs.adam - two units taken from their .acu name the same
  declarations of a third many times (SU2.8d: the group reader binds each
  System path and each unit + path once, shared by every member): its dep
  acu_refs_first compiles fixtures\AcuRefBase, AcuRefLeft and AcuRefRight;
  this build loads them (their .acu older than this module's) and this
  module names AcuRefBase's routine and type too. Each value is what it is
  from source.
*******************************************************************************/

/*
@@test
  kind run
  deps driver.acu_refs_first
  exitcode 0
  | AcuRefLeft loaded
  | AcuRefRight loaded
  | left 21
  | right 40
  | main 5
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_refs;

@addmodulepath "$P:res/tests/driver/fixtures";

import System.SysUtils, System.Windows, AcuRefBase, AcuRefLeft, AcuRefRight;

const
  // Where this build's units are, from the exe's folder (<output>\bin\<triple>\<mode>)
  ACU_DIR: string = "$P:../../../acu/x86_64-windows-gnu/debug/";

// "loaded" when AName's .acu is older than this module's, written by this build
routine UnitSource(const AName: string): string;
begin
  if FileWriteTime(ACU_DIR + AName + ".acu") < FileWriteTime(ACU_DIR + "acu_refs.acu") then
    return "loaded";
  end;
  return "parsed";
end;

var
  GPair: AcuRefPair;

begin
  println("AcuRefLeft {}", UnitSource("AcuRefLeft"));
  println("AcuRefRight {}", UnitSource("AcuRefRight"));
  println("{} {}", AcuRefLeftName(), AcuRefLeftSum());
  println("{} {}", AcuRefRightName(), AcuRefRightSum());
  GPair := AcuRefMake(2, 3);
  println("main {}", GPair.A + GPair.B);
end.
