-------------------------------------------------------------------------------
  driver_self_version.adam - adam.exe carries its version and identity from
  Adam.Core.Common and the Adam logo icon (M8f, his word 2026-11-16): the
  row builds this reader and runs it on the adam exe the run uses
  (<ADAM>), which reads that exe's version resource as the OS reads it.
  The version parts are <NUM> (a bump changes no row), printed with a blank
  between them (adamtest's <NUM> reads "0.1" as one decimal); the texts
  are Adam.Core.Common's, the description adam.adam's own
  (ADAM_CLI_DESCRIPTION, the product name + " CLI")
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/driver_self_version.adam" "-o" "." "-r" "--" "<ADAM>"
  exitcode 0
  | ok path
  | ok version size
  | ok version read
  | ok fixed signature
  | file version <NUM> <NUM> <NUM> 0
  | product version <NUM> <NUM> <NUM> 0
  | CompanyName = tinyBigGAMES™ LLC
  | FileDescription = Adam™ CLI
  | FileVersion = <NUM> <NUM> <NUM> 0
  | InternalName = adam
  | LegalCopyright = Copyright © 2026-present tinyBigGAMES™ LLC
  | OriginalFilename = adam exe
  | ProductName = Adam™
  | ProductVersion = <NUM> <NUM> <NUM> 0
  | ok icons 1
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe driver_self_version;

import System.SysUtils, System.IO, System.Windows;

// version.dll's reader and shell32's icon count: the OS reads the image's resources
func clink GetFileVersionInfoSizeW(var AFileName: WideBuffer; AHandle: ptr): uint32;
  external "version";
func clink GetFileVersionInfoW(var AFileName: WideBuffer; AHandle: uint32; ALength: uint32;
  AData: ptr): int32; external "version";
func clink VerQueryValueW(AData: ptr; var ASubBlock: WideBuffer; var AValue: ptr;
  var ALength: uint32): int32; external "version";
func clink ExtractIconExW(var AFile: WideBuffer; AIndex: int32; ALarge: ptr; ASmall: ptr;
  AIcons: uint32): uint32; external "shell32";

const
  // VS_FIXEDFILEINFO's signature
  ADAM_ROW_FIXED_SIGNATURE: uint64 = 0xFEEF04BD;

var
  GFails: int32;
  // The exe's path and a query's sub-block as Win32 reads them, a value's text
  GPath: WideBuffer;
  GSub: WideBuffer;
  GText: WideBuffer;
  // The version resource as GetFileVersionInfoW copies it
  GData: ByteArray;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// Where AValue (a pointer VerQueryValueW gave) is in GData
func OffsetOf(const AValue: ptr): int64;
begin
  return int64(uint64(AValue) - uint64(addr of GData[0]));
end;

// The value of ASubBlock in GData and its length (VerQueryValueW's: units for a text, bytes
// for binary data); -1 when it is not there
func Query(const ASubBlock: string; var ALength: uint32): int64;
var
  LValue: ptr;
begin
  LValue := nil;
  ALength := 0;
  if not Utf8ToWide(ASubBlock, GSub) then
    return -1;
  end;
  if VerQueryValueW(addr of GData[0], GSub, LValue, ALength) = 0 then
    return -1;
  end;
  return OffsetOf(LValue);
end;

// The text the StringTable 040904B0 holds for AKey, "" when it holds none
func StringOf(const AKey: string): string;
var
  LAt: int64;
  LLength: uint32;
  LI: int64;
begin
  LAt := Query("\\StringFileInfo\\040904B0\\" + AKey, LLength);
  if (LAt < 0) or (LLength = 0) then
    return "";
  end;
  for LI := 0 to int64(LLength) - 1 do
    GText[LI] := uint16(GetLe(GData, LAt + 2 * LI, 2));
  end;
  // LLength counts the NUL
  return WideToUtf8(GText, int32(LLength) - 1);
end;

// "major.minor.patch.build" of a VS_FIXEDFILEINFO version pair at AAt
func VersionAt(const AAt: int64): string;
var
  LHigh: int64;
  LLow: int64;
begin
  LHigh := int64(GetLe(GData, AAt, 4));
  LLow := int64(GetLe(GData, AAt + 4, 4));
  return IntToStr(LHigh shr 16) + "." + IntToStr(LHigh & 0xFFFF) + "." + IntToStr(LLow shr 16) +
    "." + IntToStr(LLow & 0xFFFF);
end;

// The rows (see the header)
func Run();
var
  LSize: uint32;
  LFixed: int64;
  LLength: uint32;
  LKeys: StringArray;
  LI: int64;
  LIcons: uint32;
begin
  Check("path", Utf8ToWide(paramstr(1), GPath));
  LSize := GetFileVersionInfoSizeW(GPath, nil);
  Check("version size", LSize > 0);
  if LSize = 0 then
    return;
  end;
  setlength(GData, int64(LSize));
  Check("version read", GetFileVersionInfoW(GPath, 0, LSize, addr of GData[0]) <> 0);
  LFixed := Query("\\", LLength);
  Check("fixed signature", (LFixed >= 0) and (GetLe(GData, LFixed, 4) = ADAM_ROW_FIXED_SIGNATURE));
  if LFixed < 0 then
    return;
  end;
  println("file version {}", ReplaceStr(VersionAt(LFixed + 8), ".", " "));
  println("product version {}", ReplaceStr(VersionAt(LFixed + 16), ".", " "));
  LKeys := SplitString("CompanyName FileDescription FileVersion InternalName LegalCopyright " +
    "OriginalFilename ProductName ProductVersion", " ");
  for LI := 0 to len(LKeys) - 1 do
    println("{} = {}", LKeys[LI], ReplaceStr(StringOf(LKeys[LI]), ".", " "));
  end;
  // The shell's count of the exe's icons (an index of -1 asks for it)
  LIcons := ExtractIconExW(GPath, -1, nil, nil, 0);
  Check("icons " + UIntToStr(uint64(LIcons)), LIcons = 1);
end;

begin
  GFails := 0;
  Run();
  if GFails > 0 then
    println("fails {}", GFails);
  end;
end.
