-------------------------------------------------------------------------------
  acu_cur_private.adam - a private change in an import keeps its importer
  (PLAN-ADAM SU2.3): its dep acu_cur_private_first compiled AcuCurPrivUser
  against acu_cur_v1's AcuCurPriv; this build finds acu_cur_v2's, whose
  change is private, so AcuCurPriv alone is compiled again (its .acu newer
  than the dep's exe) and AcuCurPrivUser's .acu, its import's interface hash
  unmoved, is taken as it is (older). The new private body's value shows
  the build runs the second version
*******************************************************************************/

/*
@@test
  kind run
  deps driver.acu_cur_private_first
  exitcode 0
  | AcuCurPriv recompiled
  | AcuCurPrivUser kept
  | value 42
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_cur_private;

@addmodulepath "$P:res/tests/driver/fixtures";
@addmodulepath "$P:res/tests/driver/fixtures/acu_cur_v2";

import System.SysUtils, System.IO, AcuCurPrivUser;

const
  // Where this build's units are, and the dep's exe, from the exe's folder (<output>\bin\<triple>\<mode>)
  ACU_DIR: string = "$P:../../../acu/x86_64-windows-gnu/debug/";
  FIRST_EXE: string = "$P:acu_cur_private_first.exe";

// "recompiled" when AName's .acu was written by this build (after the dep's exe), else "kept"
func StateOf(const AName: string): string;
begin
  if FileWriteTime(ACU_DIR + AName + ".acu") > FileWriteTime(FIRST_EXE) then
    return "recompiled";
  end;
  return "kept";
end;

begin
  println("AcuCurPriv {}", StateOf("AcuCurPriv"));
  println("AcuCurPrivUser {}", StateOf("AcuCurPrivUser"));
  println("value {}", AcuCurPrivUserValue());
end.
