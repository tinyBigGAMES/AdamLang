-------------------------------------------------------------------------------
  acu_written.adam - adam build writes every unit's .acu (PLAN-ADAM SU2.1,
  SU2.4b, SU2.6): this program's in the output folder's
  acu\x86_64-windows-gnu\debug\, System.Runtime's and an imported std
  unit's in the shared cache beside adam.exe (res\acu\x86_64-windows-gnu\
  debug\); each the unit's COFF object for x64
  (Machine 0x8664): its code in `.text` (code, execute, read: flags
  0x60501020: COMDAT, SU2.7, with the 16-byte alignment bits) and its payload in `.adam`,
  LNK_INFO | LNK_REMOVE with the 1-byte alignment bits (0x00100A00), its
  raw data the payload's magic ADAM.ACU. A unit no build wrote is missing
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | output acu_written.acu machine 8664 .text 60501020 .adam 00100A00 ADAM.ACU
  | shared System.Runtime.acu machine 8664 .text 60501020 .adam 00100A00 ADAM.ACU
  | shared System.SysUtils.acu machine 8664 .text 60501020 .adam 00100A00 ADAM.ACU
  | shared System.Nothing.acu missing
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_written;

import System.SysUtils, System.Windows;

const
  // Where this build's units are, from the exe's folder (<output>\bin\<triple>\<mode>)
  ACU_DIR: string = "$P:../../../acu/x86_64-windows-gnu/debug/";
  // Where the std's and the runtime's are: the shared cache beside adam.exe (<output> is
  // repo\bin\output, adam.exe's folder repo\bin)
  SHARED_DIR: string = "$P:../../../../res/acu/x86_64-windows-gnu/debug/";
  // COFF: the file header's size and fields, a section header's size and fields
  COFF_HEADER_SIZE: int64 = 20;
  COFF_SECTIONS_AT: int64 = 2;
  SECTION_SIZE: int64 = 40;
  SECTION_NAME_SIZE: int64 = 8;
  SECTION_RAW_AT: int64 = 20;
  SECTION_FLAGS_AT: int64 = 36;
  // The payload's first bytes
  ACU_MAGIC_SIZE: int64 = 8;

// The bytes of ABytes from AAt as text, up to ACount bytes or the first zero
routine TextAt(const ABytes: ByteArray; const AAt: int64; const ACount: int64): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  for LI := 0 to ACount - 1 do
    if (AAt + LI >= len(ABytes)) or (ABytes[AAt + LI] = 0) then
      leave;
    end;
    LText := LText + char(ABytes[AAt + LI]);
  end;
  return LText;
end;

// The file offset of the section header named AName in ABytes, a COFF object; -1 when it
// has none
routine SectionAt(const ABytes: ByteArray; const AName: string): int64;
var
  LCount: int64;
  LAt: int64;
  LI: int64;
begin
  LCount := int64(GetLe(ABytes, COFF_SECTIONS_AT, 2));
  for LI := 0 to LCount - 1 do
    LAt := COFF_HEADER_SIZE + LI * SECTION_SIZE;
    if (LAt + SECTION_SIZE <= len(ABytes)) and
      (TextAt(ABytes, LAt, SECTION_NAME_SIZE) = AName) then
      return LAt;
    end;
  end;
  return -1;
end;

// The flags of the section header at AAt of ABytes in hex ("none" when AAt is -1)
routine FlagsAt(const ABytes: ByteArray; const AAt: int64): string;
begin
  if AAt < 0 then
    return "none";
  end;
  return IntToHex(GetLe(ABytes, AAt + SECTION_FLAGS_AT, 4), 8);
end;

// The unit AName's .acu in the folder ADir (APlace names it) as this test reads it (see the
// header)
routine Show(const APlace: string; const ADir: string; const AName: string);
var
  LBytes: ByteArray;
  LCode: int64;
  LInfo: int64;
  LMagic: string;
begin
  if not ReadAllBytes(ADir + AName, LBytes) or (len(LBytes) < COFF_HEADER_SIZE) then
    println("{} {} missing", APlace, AName);
    return;
  end;
  LCode := SectionAt(LBytes, ".text");
  LInfo := SectionAt(LBytes, ".adam");
  LMagic := "none";
  if LInfo >= 0 then
    LMagic := TextAt(LBytes, int64(GetLe(LBytes, LInfo + SECTION_RAW_AT, 4)), ACU_MAGIC_SIZE);
  end;
  println("{} {} machine {} .text {} .adam {} {}", APlace, AName,
    IntToHex(GetLe(LBytes, 0, 2), 4), FlagsAt(LBytes, LCode), FlagsAt(LBytes, LInfo), LMagic);
end;

begin
  Show("output", ACU_DIR, "acu_written.acu");
  Show("shared", SHARED_DIR, "System.Runtime.acu");
  Show("shared", SHARED_DIR, "System.SysUtils.acu");
  Show("shared", SHARED_DIR, "System.Nothing.acu");
end.
