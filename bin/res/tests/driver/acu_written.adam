-------------------------------------------------------------------------------
  acu_written.adam - adam build writes every unit's .acu (PLAN-ADAM SU2.1):
  this program's, System.Runtime's and an imported std unit's are in the
  output folder's acu\x86_64-windows-gnu\debug\, each a COFF object for x64
  (Machine 0x8664) of one section: `.adam`, LNK_INFO | LNK_REMOVE with the
  8-byte alignment bits (0x00400A00), its raw data the payload's magic
  ADAM.ACU. A unit no build wrote is missing
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | acu_written.acu machine 8664 sections 1 .adam 00400A00 ADAM.ACU
  | System.Runtime.acu machine 8664 sections 1 .adam 00400A00 ADAM.ACU
  | System.SysUtils.acu machine 8664 sections 1 .adam 00400A00 ADAM.ACU
  | System.Nothing.acu missing
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_written;

import System.SysUtils, System.Windows;

const
  // Where this build's units are, from the exe's folder (<output>\bin)
  ACU_DIR: string = "$P:../acu/x86_64-windows-gnu/debug/";
  // COFF: the file header's size and fields, a section header's fields
  COFF_HEADER_SIZE: int64 = 20;
  COFF_SECTIONS_AT: int64 = 2;
  SECTION_RAW_AT: int64 = 20;
  SECTION_FLAGS_AT: int64 = 36;
  // The payload's first bytes
  ACU_MAGIC_SIZE: int64 = 8;

// The bytes of ABytes from AAt as text, up to ACount bytes or the first zero
routine TextAt(const ABytes: ByteArray; const AAt: int64; const ACount: int64): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  for LI := 0 to ACount - 1 do
    if (AAt + LI >= len(ABytes)) or (ABytes[AAt + LI] = 0) then
      leave;
    end;
    LText := LText + char(ABytes[AAt + LI]);
  end;
  return LText;
end;

// The unit AName's .acu as this test reads it (see the header)
routine Show(const AName: string);
var
  LBytes: ByteArray;
  LRaw: int64;
begin
  if not ReadAllBytes(ACU_DIR + AName, LBytes) or (len(LBytes) < COFF_HEADER_SIZE + 40) then
    println("{} missing", AName);
    return;
  end;
  LRaw := int64(GetLe(LBytes, COFF_HEADER_SIZE + SECTION_RAW_AT, 4));
  println("{} machine {} sections {} {} {} {}", AName, IntToHex(GetLe(LBytes, 0, 2), 4),
    GetLe(LBytes, COFF_SECTIONS_AT, 2), TextAt(LBytes, COFF_HEADER_SIZE, 8),
    IntToHex(GetLe(LBytes, COFF_HEADER_SIZE + SECTION_FLAGS_AT, 4), 8),
    TextAt(LBytes, LRaw, ACU_MAGIC_SIZE));
end;

begin
  Show("acu_written.acu");
  Show("System.Runtime.acu");
  Show("System.SysUtils.acu");
  Show("System.Nothing.acu");
end.
