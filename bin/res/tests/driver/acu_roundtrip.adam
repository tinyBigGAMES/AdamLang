-------------------------------------------------------------------------------
  acu_roundtrip.adam - a unit taken from its .acu builds and runs as from
  source (PLAN-ADAM SU2.2): its dep acu_roundtrip_first compiles
  fixtures\ACURtUnit and writes its .acu; this build takes the unit from
  that .acu (current: the same compiler, triple, mode and source), so it
  does not write it again, while its own module's .acu is written now. The
  unit's .acu older than this module's shows the unit was loaded (from
  source it would be written after this module's). Its const, choices,
  record, object and override, module variable and routines then give
  what they give from source
*******************************************************************************/

/*
@@test
  kind run
  deps driver.acu_roundtrip_first
  exitcode 0
  | ACURtUnit loaded
  | green 4 23
  | triangle 18
  | square 25 blue 7
  | sum 55
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_roundtrip;

@addmodulepath "$P:res/tests/driver/fixtures";

import System.SysUtils, System.IO, ACURtUnit;

const
  // Where this build's units are, from the exe's folder (<output>\bin\<triple>\<mode>)
  ACU_DIR: string = "$P:../../../acu/x86_64-windows-gnu/debug/";

// "loaded" when ACURtUnit's .acu is older than this module's, written by this build
func UnitSource(): string;
begin
  if FileWriteTime(ACU_DIR + "ACURtUnit.acu") < FileWriteTime(ACU_DIR + "acu_roundtrip.acu") then
    return "loaded";
  end;
  return "parsed";
end;

// The unit's routines and types (acu_roundtrip_first's two lines first)
func Show();
var
  LShape: ref ACURtShape;
  LPoint: ACURtPoint;
  LValues: Int64Array;
begin
  LShape := ACURtTriangleOf(6);
  LPoint.X := 1;
  LPoint.Y := 2;
  LPoint := ACURtMove(LPoint, 3);
  println("{} {} {}", ACURtName(ACURtColor.Green), LPoint.X, LPoint.Y);
  println("{}", ACURtDescribe(LShape));
  LShape := ACURtSquare(5);
  println("{} {} {}", ACURtDescribe(LShape), ACURtName(ACURtColor.Blue), ACU_RT_SCALE);
  setlength(LValues, 3);
  LValues[0] := 1;
  LValues[1] := 2;
  LValues[2] := 3;
  println("sum {}", ACURtSum(LValues));
end;

begin
  println("ACURtUnit {}", UnitSource());
  Show();
end.
