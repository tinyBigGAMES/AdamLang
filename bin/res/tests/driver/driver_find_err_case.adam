-------------------------------------------------------------------------------
  driver_find_err_case.adam - Driver: a unit named in another case than its
  file's (findunitb for fixtures\FindUnitB.adam) is not found (BNF sec 1:
  the file name's case is the module name's), PR0012, though FindUnitA was
  found in that folder first: its listing, taken once (SU2.8d), still
  compares names exactly.
*******************************************************************************/

/*
@@test
  kind cli
  args "check" "--quiet" "<DIR>/driver_find_err_case.adam"
  exitcode 1
  | <DIR>/driver_find_err_case.adam(36,19): Error PR0012: the unit 'findunitb' is not found: no 'findunitb.adam' in the importer's folder or the module paths
@@end
*/

module exe driver_find_err_case;

@addmodulepath "$P:res/tests/driver/fixtures";

import FindUnitA, findunitb;

begin
  println("a {}", FindA());
end.
