-------------------------------------------------------------------------------
  acu_mixed.adam - an exe's bytes never depend on which of its units came
  from .acu (ACU5, PROJECT AD.7): in scratch install A a program importing
  System.SysUtils alone puts part of the std into the shared cache; then a
  program over System.JSON.Ext (its importers above SysUtils, the runtime,
  yyjson) is built there (some units from .acu, the rest parsed), then again
  with A's shared cache removed (every unit parsed): the two exes are
  byte-identical, and A's build of it once more (every unit from .acu) too.
  The same install throughout, so every path the builds see is the same.
  Its args: the adam exe, the output root, adam's folder, the run cell
  (<ADAM>, <OUT>, <BIN>, <CELL>). The install is scratch in
  <OUT>\shared_cache (beside acu_shared's), so the real std is never touched.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu
  args "<ADAM>" "<OUT>" "<BIN>" "<CELL>"
  exitcode 0
  | install a true
  | build a first 0
  | build a mixed 0
  | cache removed true
  | build a fresh 0
  | mixed = fresh true
  | build a cached 0
  | cached = fresh true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_mixed;

@ifndef TARGET_X86_64_WINDOWS_GNU
@message error "acu_mixed runs the win64 adam.exe: build it for x86_64-windows-gnu";
@endif

import System.SysUtils, System.IO, System.Process;

const
  // The scratch install in the output root's one named scratch folder (PROJECT AV.8), and
  // its shared cache
  SCRATCH_A: string = "/shared_cache/mixed_a";
  ACU_DIR: string = "/res/acu";
  STD_DIR: string = "/res/libs/std";
  RUNTIME_DIR: string = "/res/runtime";
  // The two programs' names after this exe's (+ _first, + _json)
  FIRST_SUFFIX: string = "_first";
  JSON_SUFFIX: string = "_json";

var
  GOut: string;
  GBin: string;
  GCell: string;
  GName: string;

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// Every .adam file of AFrom copied into ATo (made first); false when one cannot be
func CopySources(const AFrom: string; const ATo: string): bool;
var
  LList: StringArray;
  LBytes: ByteArray;
  LI: int64;
begin
  if not ForceDirectories(ATo) or not GetFiles(AFrom, LList) then
    return false;
  end;
  for LI := 0 to len(LList) - 1 do
    if EndsStr(".adam", LList[LI]) then
      if not ReadAllBytes(AFrom + "/" + LList[LI], LBytes) or
        not WriteAllBytes(ATo + "/" + LList[LI], LBytes) then
        return false;
      end;
    end;
  end;
  return true;
end;

// The library search lines of a program the install builds (the system and vendor
// libraries are found in the real install's folders)
func LibraryLines(): string;
begin
  return "@addlibrarypath \"" + GBin + "/res/libs/system/" + ExtractFileDir(GCell) +
    "\";\n@addlibrarypath \"" + GBin + "/res/libs/vendor/" + ExtractFileDir(GCell) + "\";\n\n";
end;

// The scratch install ARoot made again from empty: the adam exe AAdam beside a copy of the
// std and the runtime, and the two programs it builds
func Install(const ARoot: string; const AAdam: string): bool;
var
  LBytes: ByteArray;
begin
  if DirectoryExists(ARoot) and not RemoveDir(ARoot, true) then
    return false;
  end;
  if not ForceDirectories(ARoot) or not ReadAllBytes(AAdam, LBytes) or
    not WriteAllBytes(ARoot + "/adam.exe", LBytes) then
    return false;
  end;
  if not CopySources(GBin + STD_DIR, ARoot + STD_DIR) or
    not CopySources(GBin + RUNTIME_DIR, ARoot + RUNTIME_DIR) then
    return false;
  end;
  if not WriteAllText(ARoot + "/" + GName + FIRST_SUFFIX + ".adam", "module exe " + GName +
    FIRST_SUFFIX + ";\n\n" + LibraryLines() + "import System.SysUtils;\n\nbegin\n" +
    "  println(\"{}\", IntToStr(7));\nend.\n") then
    return false;
  end;
  return WriteAllText(ARoot + "/" + GName + JSON_SUFFIX + ".adam", "module exe " + GName +
    JSON_SUFFIX + ";\n\n" + LibraryLines() + "import System.SysUtils, System.JSON.Ext;\n\n" +
    "var\n  LDoc: JSON;\n\nbegin\n  LDoc.Add(\"name\", \"adam\").Add(\"n\", 3);\n" +
    "  println(\"{}\", LDoc.ToString());\nend.\n");
end;

// The install ARoot's adam builds its program AProgram into the output root: its exit code
// (255 when it cannot be started), its output printed when it fails
func Build(const ARoot: string; const AProgram: string): int64;
var
  LArgs: StringArray;
  LOutput: string;
  LExit: uint32;
begin
  setlength(LArgs, 6);
  LArgs[0] := "build";
  LArgs[1] := "--no-banner";
  LArgs[2] := "--quiet";
  LArgs[3] := ARoot + "/" + AProgram + ".adam";
  LArgs[4] := "-o";
  LArgs[5] := GOut;
  if not RunProcess(ARoot + "/adam.exe", LArgs, ARoot, LOutput, LExit) then
    return 255;
  end;
  if LExit <> 0 then
    println("{}", LOutput);
  end;
  return int64(LExit);
end;

// The JSON program's exe as it is now in the output root (empty when it cannot be read)
func JSONExe(): ByteArray;
var
  LBytes: ByteArray;
begin
  setlength(LBytes, 0);
  ReadAllBytes(GOut + "/bin/" + GCell + "/" + GName + JSON_SUFFIX + ".exe", LBytes);
  return LBytes;
end;

// True when AA and AB hold the same bytes (both not empty)
func SameBytes(const AA: ByteArray; const AB: ByteArray): bool;
var
  LI: int64;
begin
  if (len(AA) = 0) or (len(AA) <> len(AB)) then
    return false;
  end;
  for LI := 0 to len(AA) - 1 do
    if AA[LI] <> AB[LI] then
      return false;
    end;
  end;
  return true;
end;

var
  GA: string;
  GMixed: ByteArray;
  GFresh: ByteArray;
  GCached: ByteArray;

begin
  GOut := paramstr(2);
  GBin := paramstr(3);
  GCell := paramstr(4);
  // This exe's name without ".exe"
  GName := ExtractFileName(paramstr(0));
  GName := Substring(GName, 0, len(GName) - 4);
  GA := GOut + SCRATCH_A;

  // A: SysUtils' part of the std into the shared cache, then the JSON program over it
  println("install a {}", BoolText(Install(GA, paramstr(1))));
  println("build a first {}", Build(GA, GName + FIRST_SUFFIX));
  println("build a mixed {}", Build(GA, GName + JSON_SUFFIX));
  GMixed := JSONExe();

  // A with its shared cache removed: the JSON program with every unit parsed
  println("cache removed {}", BoolText(RemoveDir(GA + ACU_DIR, true)));
  println("build a fresh {}", Build(GA, GName + JSON_SUFFIX));
  GFresh := JSONExe();
  println("mixed = fresh {}", BoolText(SameBytes(GMixed, GFresh)));

  // A again: every unit from its .acu
  println("build a cached {}", Build(GA, GName + JSON_SUFFIX));
  GCached := JSONExe();
  println("cached = fresh {}", BoolText(SameBytes(GCached, GFresh)));
end.
