-------------------------------------------------------------------------------
  acu_cur_edit.adam - an edited unit's .acu is not current (PLAN-ADAM
  SU2.3): its dep acu_cur_edit_first built against acu_cur_v1's AcuCurEdit;
  this build finds acu_cur_v2's, whose source is another, so the unit is
  compiled again and its .acu written after the dep's exe; the edit's value
  shows the new code runs
*******************************************************************************/

/*
@@test
  kind run
  deps driver.acu_cur_edit_first
  exitcode 0
  | AcuCurEdit recompiled
  | value 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_cur_edit;

@addmodulepath "$P:res/tests/driver/fixtures/acu_cur_v2";

import System.SysUtils, System.IO, AcuCurEdit;

const
  // Where this build's units are, and the dep's exe, from the exe's folder (<output>\bin\<triple>\<mode>)
  ACU_DIR: string = "$P:../../../acu/x86_64-windows-gnu/debug/";
  FIRST_EXE: string = "$P:acu_cur_edit_first.exe";

// "recompiled" when AName's .acu was written by this build (after the dep's exe), else "kept"
routine StateOf(const AName: string): string;
begin
  if FileWriteTime(ACU_DIR + AName + ".acu") > FileWriteTime(FIRST_EXE) then
    return "recompiled";
  end;
  return "kept";
end;

begin
  println("AcuCurEdit {}", StateOf("AcuCurEdit"));
  println("value {}", AcuCurEditValue());
end.
