module unit driver_dev_docs;

public const
  /// The answer, as the docs show a constant.
  DOCS_ANSWER: int32 = 42;

public type
  /// A point on the grid.
  DocsPoint = record
    /// Across, in cells
    X: int32;
    Y: int32;
  end;

/// The sum of two values.
/// @param AValue the first
/// @param AOther the second, added
///   to the first
/// @returns `AValue + AOther`
/// @example `DocsAdd(1, 2)` gives 3
public func DocsAdd(const AValue: int32; const AOther: int32): int32;
begin
  return AValue + AOther;
end;

public func DocsBare(): int32;
begin
  return DOCS_ANSWER;
end;

// Not public: no entry
func DoDocsHidden(): int32;
begin
  return 0;
end;

public extend DocsPoint
  /// The point's squared length.
  method LengthSquared(): int32;
  begin
    return self.X * self.X + self.Y * self.Y;
  end;
end;

public forward type DocsLater;

public type
  /// Declared after its forward: listed once, here.
  DocsLater = record
    /// Its one field
    Value: int32;
  end;

end.
