-------------------------------------------------------------------------------
  driver_host_parts.adam - LX7a: the compiler's host parts, built for each
  target as adam itself is. The default target (Target.Registry's
  DefaultTriple) is the host's: the triple the program was built for, so a
  linux adam builds linux programs when nothing names a target. The
  debugger's parts (Debug.Targets) are there only on the host that has them
  (win64 today: nil and an empty list on linux, which -d and adam dap report).
  Protocol.Stdio's channel (adam lsp / dap) has a part on both: a line
  written through StdioChannel reaches standard output
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok default is the host's
  | ok default target says so
  | ok debugger parts as the host has them
  | through the stdio channel
  | ok stdio write
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe driver_host_parts;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Target, Adam.Target.Registry, Adam.Debug.Target,
  Adam.Debug.Symbols, Adam.Debug.Targets, Adam.Protocol.Transport, Adam.Protocol.Stdio;

const
  // The triple this program was built for: what its own default must be
@ifdef TARGET_X86_64_LINUX_GNU
  ADAM_ROW_BUILT_FOR: string = "x86_64-linux-gnu";
  ADAM_ROW_HAS_DEBUGGER: bool = false;
@else
  ADAM_ROW_BUILT_FOR: string = "x86_64-windows-gnu";
  ADAM_ROW_HAS_DEBUGGER: bool = true;
@endif
  ADAM_ROW_LINE: string = "through the stdio channel\n";

// "ok <what>" when ACheck holds, else "FAIL <what>"
func DoSay(const ACheck: bool; const AWhat: string);
begin
  if ACheck then
    print("ok {}\n", AWhat);
  else
    print("FAIL {}\n", AWhat);
  end;
end;

var
  LTarget: ref Target;
  LDebugger: bool;
  LChannel: ref StdioChannel;
  LWritten: bool;
  LText: string;

begin
  DoSay(DefaultTriple() = ADAM_ROW_BUILT_FOR, "default is the host's");
  LTarget := FindTarget(ADAM_ROW_BUILT_FOR);
  DoSay((LTarget <> nil) and LTarget.IsDefault(), "default target says so");
  // Both parts or neither, and the list as -d's message names it
  LDebugger := (DebugTargetFor(ADAM_ROW_BUILT_FOR) <> nil) and
    (DebugSymbolsFor(ADAM_ROW_BUILT_FOR) <> nil);
  DoSay((LDebugger = ADAM_ROW_HAS_DEBUGGER) and
    ((KnownDebugTargets() <> "") = ADAM_ROW_HAS_DEBUGGER), "debugger parts as the host has them");
  // print's lines first, so the channel's bytes come after them on standard output
  FlushOutput();
  LChannel := ref StdioChannel();
  LText := ADAM_ROW_LINE;
  LWritten := LChannel.WriteBytes(addr of LText[0], len(LText));
  DoSay(LWritten, "stdio write");
end.
