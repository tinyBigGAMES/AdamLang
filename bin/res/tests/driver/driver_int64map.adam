-------------------------------------------------------------------------------
  driver_int64map.adam - Int64Map (Adam.Core.Containers, SU2.8 e2): its
  keys mixed before they index the table, so a run of ids (a function's
  instructions) does not fill one stretch of it. A run of 1000 keys put
  from an empty map (the table growing on the way) is found whole with
  its values; the 1000 ids after the run and the 1000 below it, looked
  for and not held, all answer the missing value; a key put again keeps
  the count and takes the new value; a negative key and a map with no
  keys answer the missing value
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | run 1000 1000
  | missed 0 0
  | again 7 1000
  | negative -1
  | empty -1
@@end
*/

module exe driver_int64map;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Core.Containers;

const
  // The run's first key: ids well past the table's size, as a module's are
  ADAM_TEST_FIRST: int64 = 50000;
  ADAM_TEST_COUNT: int64 = 1000;

var
  GMap: ref Int64Map;
  GEmpty: ref Int64Map;
  GFound: int64;
  GAbove: int64;
  GBelow: int64;
  GI: int64;

begin
  SetHeapReport(false);
  GMap := ref Int64Map(-1);
  for GI := 0 to ADAM_TEST_COUNT - 1 do
    GMap.Put(ADAM_TEST_FIRST + GI, GI * 2);
  end;
  // every key of the run found with its value
  GFound := 0;
  for GI := 0 to ADAM_TEST_COUNT - 1 do
    if GMap.Find(ADAM_TEST_FIRST + GI) = GI * 2 then
      GFound := GFound + 1;
    end;
  end;
  println("run {} {}", GFound, GMap.Count);
  // the ids just past the run and just below it are not held
  GAbove := 0;
  GBelow := 0;
  for GI := 0 to ADAM_TEST_COUNT - 1 do
    if GMap.Find(ADAM_TEST_FIRST + ADAM_TEST_COUNT + GI) <> -1 then
      GAbove := GAbove + 1;
    end;
    if GMap.Find(ADAM_TEST_FIRST - ADAM_TEST_COUNT + GI) <> -1 then
      GBelow := GBelow + 1;
    end;
  end;
  println("missed {} {}", GAbove, GBelow);
  GMap.Put(ADAM_TEST_FIRST + 500, 7);
  println("again {} {}", GMap.Find(ADAM_TEST_FIRST + 500), GMap.Count);
  println("negative {}", GMap.Find(-5));
  GEmpty := ref Int64Map(-1);
  println("empty {}", GEmpty.Find(ADAM_TEST_FIRST));
end.
