/*
@@test
  kind dep
@@end
*/

module dll implib_written_lib;

public var
  Counter: int32;

func Hidden(): int32;
begin
  return 1;
end;

public func Beta(): int32;
begin
  return Hidden() + 1;
end;

public func Alpha(): int32;
begin
  return 1;
end;

end.
