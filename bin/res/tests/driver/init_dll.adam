-------------------------------------------------------------------------------
  init_dll.adam - adam init prj_initdll makes a dll project that builds as
  made (project.toml's type dll is the build's kind) and writes
  prj_initdll.dll and its import library libprj_initdll.dll.a; a consumer exe links it by
  `@linklibrary` and calls the starter's prj_initdll_add, exit 0,
  its heap report clean
  (PLAN-ADAM M8e; written by scripts\adam\gen_project_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  args "<ADAM>" "<OUT>" "<CELL>"
  exitcode 0
  | init started true exit 0
  | build started true exit 0
  | dll written true
  | import library written true
  | use source written true
  | use build started true exit 0
  | use run started true exit 0
  | use run [add 42]
  | use run [[Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0]
  | use run [[Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0]
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe init_dll;

import System.SysUtils, System.Windows, System.IO, System.Process;

var
  GAdam: string;
  GOut: string;
  GCell: string;
  GArgs: StringArray;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// Adds AText at the end of GArgs
routine Arg(const AText: string);
var
  LCount: int64;
begin
  LCount := len(GArgs);
  setlength(GArgs, LCount + 1);
  GArgs[LCount] := AText;
end;

// Each line of AText after ALabel, in [ ] (the empty part after a last line end is no line)
routine ShowText(const ALabel: string; const AText: string);
var
  LParts: StringArray;
  LCount: int64;
  LI: int64;
begin
  LParts := SplitString(AText, "\n");
  LCount := len(LParts);
  if (LCount > 0) and (LParts[LCount - 1] = "") then
    LCount := LCount - 1;
  end;
  for LI := 0 to LCount - 1 do
    println("{}", ALabel + " [" + LParts[LI] + "]");
  end;
end;

// Runs AExe with GArgs (then emptied) in the output folder: whether it started and its exit
// code, then each line it printed (CRs dropped) through ShowText
routine RunTool(const ALabel: string; const AExe: string);
var
  LOutput: string;
  LCode: uint32;
  LOk: bool;
begin
  LOk := RunProcess(AExe, GArgs, GOut, LOutput, LCode);
  setlength(GArgs, 0);
  println("{}", ALabel + " started " + BoolText(LOk) + " exit " + IntToStr(int64(LCode)));
  ShowText(ALabel, ReplaceStr(LOutput, "\r", ""));
end;

// Whether the file APath (under the output folder) is there
routine ShowWritten(const ALabel: string; const APath: string);
begin
  println("{}", ALabel + " written " + BoolText(FileExists(GOut + "/" + APath)));
end;

// Removes what an earlier run of this row left: the project's files (only what adam init
// makes, each file by name and each folder only when empty), what its build and the
// consumer's wrote, and the consumer's source
routine RemoveLeftovers();
var
  LDir: string;
begin
  LDir := GOut + "/prj_initdll";
  DeleteFile(LDir + "/project.toml");
  DeleteFile(LDir + "/src/prj_initdll.adam");
  RemoveDir(LDir + "/src");
  RemoveDir(LDir + "/assets");
  RemoveDir(LDir);
  DeleteFile(GOut + "/bin/" + GCell + "/prj_initdll.dll");
  DeleteFile(GOut + "/lib/" + GCell + "/libprj_initdll.dll.a");
  DeleteFile(GOut + "/bin/" + GCell + "/prj_initdll_use.exe");
  DeleteFile(GOut + "/prj_initdll_use.adam");
end;

// Writes the consumer's source into the output folder: an exe that finds the project's
// library in the output folder's lib part by `@linklibrary` and calls prj_initdll_add; false
// when it cannot be written
routine WriteUse(): bool;
var
  LLibDir: string;
  LText: string;
begin
  LLibDir := ReplaceStr(GOut + "/lib/" + GCell, "\\", "/");
  LText := "module exe prj_initdll_use;\n\n" +
    "@addlibrarypath \"" + LLibDir + "\";\n" +
    "@linklibrary \"prj_initdll\";\n\n" +
    "routine prj_initdll_add(const AA: int32; const AB: int32): int32; external \"prj_initdll\";\n\n" +
    "begin\n" +
    "  println(\"add {}\", prj_initdll_add(20, 22));\n" +
    "end.\n";
  return WriteAllText(GOut + "/prj_initdll_use.adam", LText);
end;

begin
  GAdam := paramstr(1);
  GOut := paramstr(2);
  GCell := paramstr(3);
  setlength(GArgs, 0);
  RemoveLeftovers();

  // adam init makes the dll project
  Arg("init");
  Arg("--quiet");
  Arg("prj_initdll");
  Arg("dll");
  RunTool("init", GAdam);

  // It builds as made: project.toml's type is the build's kind, and the build writes its files
  Arg("build");
  Arg("--quiet");
  Arg(GOut + "/prj_initdll");
  Arg("-o");
  Arg(GOut);
  RunTool("build", GAdam);
  ShowWritten("dll", "bin/" + GCell + "/prj_initdll.dll");
  ShowWritten("import library", "lib/" + GCell + "/libprj_initdll.dll.a");

  // A consumer exe links it by name and calls its starter routine
  println("use source written {}", BoolText(WriteUse()));
  Arg("build");
  Arg("--quiet");
  Arg(GOut + "/prj_initdll_use.adam");
  Arg("-o");
  Arg(GOut);
  RunTool("use build", GAdam);
  RunTool("use run", GOut + "/bin/" + GCell + "/prj_initdll_use.exe");
end.
