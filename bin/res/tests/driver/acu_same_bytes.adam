-------------------------------------------------------------------------------
  acu_same_bytes.adam - a unit writes the same .acu slice in every tree
  (PLAN-ADAM SU2.3): fixtures\AcuSameA and AcuSameB have one body, only
  the unit's letter in their names (the unit's, its routines') differs,
  so each sits at other node ids of the tree that
  compiles it (one twin after the other, or one loaded from an .acu another
  program wrote). Their .acu payloads past the header (the string pool, the
  node records) must then differ in nothing but the unit's own name: a key
  holding a node id, or a parameter name taken from another signature,
  differs
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | slices same
  | total 10 green 7 has true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_same_bytes;

@addmodulepath "$P:res/tests/driver/fixtures";

import System.SysUtils, System.Windows, AcuSameA, AcuSameB;

const
  // Where this build's units are, from the exe's folder (<output>\bin\<triple>\<mode>)
  ACU_DIR: string = "$P:../../../acu/x86_64-windows-gnu/debug/";
  // The twins' names: the one difference their slices may have
  NAME_A: string = "AcuSameA";
  NAME_B: string = "AcuSameB";
  // The COFF section that holds the payload, a section header's size (PE / COFF)
  SECTION_NAME: string = ".adam";
  SECTION_SIZE: int64 = 40;
  // Compare's answers that are no offset
  SAME: int64 = -1;
  MISSING: int64 = -2;
  SIZES: int64 = -3;

// True when the section header at AAt of AFile is named AName (8 bytes, zero padded)
routine IsSection(const AFile: ByteArray; const AAt: int64; const AName: string): bool;
var
  LI: int64;
begin
  for LI := 0 to 7 do
    if LI < len(AName) then
      if AFile[AAt + LI] <> uint8(AName[LI]) then
        return false;
      end;
    else
      if AFile[AAt + LI] <> 0 then
        return false;
      end;
    end;
  end;
  return true;
end;

// The payload of the .acu at APath: its SECTION_NAME section's bytes; empty when the file
// or the section is missing
routine PayloadOf(const APath: string): ByteArray;
var
  LFile: ByteArray;
  LPayload: ByteArray;
  LCount: int64;
  LTable: int64;
  LAt: int64;
  LSize: int64;
  LStart: int64;
  LI: int64;
  LJ: int64;
begin
  setlength(LPayload, 0);
  if not ReadAllBytes(APath, LFile) then
    return LPayload;
  end;
  // The COFF header: the section count at 2, the optional header's size at 16
  LCount := int64(GetLe(LFile, 2, 2));
  LTable := 20 + int64(GetLe(LFile, 16, 2));
  for LI := 0 to LCount - 1 do
    LAt := LTable + LI * SECTION_SIZE;
    if IsSection(LFile, LAt, SECTION_NAME) then
      // Its raw data's size at 16, its file offset at 20
      LSize := int64(GetLe(LFile, LAt + 16, 4));
      LStart := int64(GetLe(LFile, LAt + 20, 4));
      setlength(LPayload, LSize);
      for LJ := 0 to LSize - 1 do
        LPayload[LJ] := LFile[LStart + LJ];
      end;
      return LPayload;
    end;
  end;
  return LPayload;
end;

// AAt moved past the text at AAt of APayload (its byte count, u32, then its bytes)
routine SkipText(const APayload: ByteArray; var AAt: int64);
begin
  AAt := AAt + 4 + int64(GetLe(APayload, AAt, 4));
end;

// Where the slice of APayload starts (its string pool): past the magic, the format
// version and the header (Adam.Acu.Format's layout)
routine SliceAt(const APayload: ByteArray): int64;
var
  LAt: int64;
  LCount: int64;
  LI: int64;
begin
  LAt := 8 + 4;
  // the compiler's version, its id
  SkipText(APayload, LAt);
  LAt := LAt + 8;
  // the triple, the mode, the predefined symbols, the unit's name, its source's path
  SkipText(APayload, LAt);
  SkipText(APayload, LAt);
  SkipText(APayload, LAt);
  SkipText(APayload, LAt);
  SkipText(APayload, LAt);
  // the source's size, time and hash, the project key, the interface hash
  LAt := LAt + 40;
  // each import's name and interface hash
  LCount := int64(GetLe(APayload, LAt, 4));
  LAt := LAt + 4;
  for LI := 0 to LCount - 1 do
    SkipText(APayload, LAt);
    LAt := LAt + 8;
  end;
  return LAt;
end;

// True when the bytes that differ at AAtA of AA and AAtB of AB are the last letters of
// NAME_A and NAME_B (the twins' own names)
routine IsNameAt(const AA: ByteArray; const AAtA: int64; const AB: ByteArray;
  const AAtB: int64): bool;
var
  LBack: int64;
  LK: int64;
begin
  LBack := len(NAME_A) - 1;
  if (AAtA < LBack) or (AAtB < LBack) then
    return false;
  end;
  for LK := 0 to LBack do
    if AA[AAtA - LBack + LK] <> uint8(NAME_A[LK]) then
      return false;
    end;
    if AB[AAtB - LBack + LK] <> uint8(NAME_B[LK]) then
      return false;
    end;
  end;
  return true;
end;

// SAME when the twins' slices differ in nothing but their names, MISSING when an .acu or
// its payload is not there, SIZES when the slices' sizes differ, else the offset in the
// slice of the first other difference
routine Compare(): int64;
var
  LA: ByteArray;
  LB: ByteArray;
  LAtA: int64;
  LAtB: int64;
  LI: int64;
begin
  LA := PayloadOf(ACU_DIR + NAME_A + ".acu");
  LB := PayloadOf(ACU_DIR + NAME_B + ".acu");
  if (len(LA) = 0) or (len(LB) = 0) then
    return MISSING;
  end;
  LAtA := SliceAt(LA);
  LAtB := SliceAt(LB);
  if (len(LA) - LAtA) <> (len(LB) - LAtB) then
    return SIZES;
  end;
  for LI := 0 to len(LA) - LAtA - 1 do
    if LA[LAtA + LI] <> LB[LAtB + LI] then
      if not IsNameAt(LA, LAtA + LI, LB, LAtB + LI) then
        return LI;
      end;
    end;
  end;
  return SAME;
end;

// The twins' routines, so each is a unit the program uses
routine Use();
var
  LPoints: AcuSameA.AcuSamePoints;
  LShades: AcuSameB.AcuSameShades;
  LBox: ref AcuSameB.AcuSameBox;
  LPoint: AcuSameA.AcuSamePoint;
begin
  setlength(LPoints, 2);
  LPoints[0].X := 1;
  LPoints[0].Y := 2;
  LPoints[1].X := 3;
  LPoints[1].Y := 4;
  LShades[AcuSameB.AcuSameColor.Green].X := 5;
  LBox := ref AcuSameB.AcuSameBox();
  LBox.Corner.X := 2;
  println("total {} green {} has {}", AcuSameA.AcuSameASum(LPoints),
    AcuSameB.AcuSameBGreen(LShades, LBox), AcuSameA.AcuSameAHas(addr of LPoint));
end;

var
  GResult: int64;

begin
  GResult := Compare();
  if GResult = SAME then
    println("slices same");
  else
    if GResult = MISSING then
      println("slices missing");
    else
      if GResult = SIZES then
        println("slices sized apart");
      else
        println("slices differ at {}", GResult);
      end;
    end;
  end;
  Use();
end.
