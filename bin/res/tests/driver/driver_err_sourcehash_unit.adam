-------------------------------------------------------------------------------
  driver_err_sourcehash_unit.adam - Break step of sourcehash() (ACU2): in a
  unit (fixtures\DriverSourceHashUnit) it is SM0771 (a unit's .acu serves
  every program that imports it, so it can hold no one program's hash);
  given an argument it is SM0409 (it takes none).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe driver_err_sourcehash_unit;

@addmodulepath "$P:res/tests/driver/fixtures";

import DriverSourceHashUnit;

begin
  println("{}", HashOfUnit());
  println("{}", sourcehash(1)); // ERROR SM0409@17
end.
