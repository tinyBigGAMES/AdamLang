-------------------------------------------------------------------------------
  acu_moved.adam - the shared compiled-unit cache travels (ACU2 / ACU3): a
  std unit's .acu names its compiler by that compiler's sources (never its
  exe file) and its source by the $P: path below adam's folder (never an
  absolute one), so an install copied elsewhere (another folder, a new
  adam.exe file, every source written again: an unzipped release) takes
  every std unit from the .acu it came with; nor does the .acu name A's
  folder anywhere (a place in a std or runtime file is its key, any other
  file in a shared unit's .acu none, ACU6).
  Install A builds the program
  (the shared .acu written); install B is A copied to another folder with
  A's res\acu; B's build parses the program alone. Its args: the adam exe,
  the output root, adam's folder, the run cell (<ADAM>, <OUT>, <BIN>,
  <CELL>). Both installs are scratch in <OUT>\shared_cache (beside
  acu_shared's install), so the real std is never touched.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu
  args "<ADAM>" "<OUT>" "<BIN>" "<CELL>"
  exitcode 0
  | install a true
  | build a 0
  | shared written true
  | acu names no install folder true
  | install b true
  | acu copied true
  | build b 0
  | b parsed the program alone true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe acu_moved;

@ifndef TARGET_X86_64_WINDOWS_GNU
@message error "acu_moved runs the win64 adam.exe: build it for x86_64-windows-gnu";
@endif

import System.SysUtils, System.IO, System.Process;

const
  // The scratch installs in the output root's one named scratch folder (PROJECT AV.8)
  SCRATCH_A: string = "/shared_cache/moved_a";
  SCRATCH_B: string = "/shared_cache/moved_b";
  // The std unit the program imports, and the folders copied into an install
  IMPORTED_UNIT: string = "System.SysUtils";
  STD_DIR: string = "/res/libs/std";
  RUNTIME_DIR: string = "/res/runtime";
  ACU_DIR: string = "/res/acu/";
  // The phase line of a build that parsed the program alone (every unit from its .acu)
  PARSED_ALONE: string = "Parsed 1 unit (";

var
  GOut: string;
  GBin: string;
  GCell: string;
  GProgram: string;

// true / false as text
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// Every file of AFrom ending in AExt copied into ATo (made first): its bytes written again,
// so each copy is a new file with a new write time; false when one cannot be
func CopyFiles(const AFrom: string; const ATo: string; const AExt: string): bool;
var
  LList: StringArray;
  LBytes: ByteArray;
  LI: int64;
begin
  if not ForceDirectories(ATo) or not GetFiles(AFrom, LList) then
    return false;
  end;
  for LI := 0 to len(LList) - 1 do
    if EndsStr(AExt, LList[LI]) then
      if not ReadAllBytes(AFrom + "/" + LList[LI], LBytes) or
        not WriteAllBytes(ATo + "/" + LList[LI], LBytes) then
        return false;
      end;
    end;
  end;
  return true;
end;

// The scratch install ARoot made again from empty: the adam exe AAdam beside a copy of the
// std and the runtime, and the program it builds (GProgram: it imports IMPORTED_UNIT; the
// system libraries and libc.a are found in the real install's folders)
func Install(const ARoot: string; const AAdam: string): bool;
var
  LBytes: ByteArray;
  LText: string;
begin
  if DirectoryExists(ARoot) and not RemoveDir(ARoot, true) then
    return false;
  end;
  if not ForceDirectories(ARoot) or not ReadAllBytes(AAdam, LBytes) or
    not WriteAllBytes(ARoot + "/adam.exe", LBytes) then
    return false;
  end;
  if not CopyFiles(GBin + STD_DIR, ARoot + STD_DIR, ".adam") or
    not CopyFiles(GBin + RUNTIME_DIR, ARoot + RUNTIME_DIR, ".adam") then
    return false;
  end;
  LText := "module exe " + GProgram + ";\n\n@addlibrarypath \"" + GBin + "/res/libs/system/" +
    ExtractFileDir(GCell) + "\";\n@addlibrarypath \"" + GBin + "/res/libs/vendor/" +
    ExtractFileDir(GCell) + "\";\n\nimport " + IMPORTED_UNIT + ";\n\nbegin\n" +
    "  println(\"{}\", IntToStr(7));\nend.\n";
  return WriteAllText(ARoot + "/" + GProgram + ".adam", LText);
end;

// The install ARoot's adam builds its program into the output root: its exit code (255 when
// it cannot be started), its output in AOutput (printed when it fails)
func Build(const ARoot: string; var AOutput: string): int64;
var
  LArgs: StringArray;
  LExit: uint32;
begin
  setlength(LArgs, 5);
  LArgs[0] := "build";
  LArgs[1] := "--no-banner";
  LArgs[2] := ARoot + "/" + GProgram + ".adam";
  LArgs[3] := "-o";
  LArgs[4] := GOut;
  if not RunProcess(ARoot + "/adam.exe", LArgs, ARoot, AOutput, LExit) then
    return 255;
  end;
  if LExit <> 0 then
    println("{}", AOutput);
  end;
  return int64(LExit);
end;

// True when no .acu in the folder ADir (at least one there) holds the text APath
func NoneNames(const ADir: string; const APath: string): bool;
var
  LList: StringArray;
  LText: string;
  LCount: int64;
  LI: int64;
begin
  if not GetFiles(ADir, LList) then
    return false;
  end;
  LCount := 0;
  for LI := 0 to len(LList) - 1 do
    if EndsStr(".acu", LList[LI]) then
      if not ReadAllText(ADir + "/" + LList[LI], LText) or (IndexOf(APath, LText, 0) >= 0) then
        return false;
      end;
      LCount := LCount + 1;
    end;
  end;
  return LCount > 0;
end;

// True when AOutput holds the phase line of a build that parsed the program alone
func ParsedAlone(const AOutput: string): bool;
var
  LLines: StringArray;
  LI: int64;
begin
  LLines := SplitString(AOutput, "\r\n");
  for LI := 0 to len(LLines) - 1 do
    if StartsStr(PARSED_ALONE, Trim(LLines[LI])) then
      return true;
    end;
  end;
  return false;
end;

var
  GOutput: string;
  GA: string;
  GB: string;

begin
  GOut := paramstr(2);
  GBin := paramstr(3);
  GCell := paramstr(4);
  // This exe's name without ".exe", + "_prog"
  GProgram := ExtractFileName(paramstr(0));
  GProgram := Substring(GProgram, 0, len(GProgram) - 4) + "_prog";
  GA := GOut + SCRATCH_A;
  GB := GOut + SCRATCH_B;

  // A: the shared .acu written by its first build
  println("install a {}", BoolText(Install(GA, paramstr(1))));
  println("build a {}", Build(GA, GOutput));
  println("shared written {}", BoolText(FileExists(GA + ACU_DIR + GCell + "/" + IMPORTED_UNIT + ".acu")));
  // Their places name std / runtime files by their $P: key and no other file, never the
  // install's own path nor its program's (ACU6)
  println("acu names no install folder {}", BoolText(NoneNames(GA + ACU_DIR + GCell, GA)));

  // B: A copied to another folder, a new adam.exe file and every source written again
  println("install b {}", BoolText(Install(GB, paramstr(1))));
  println("acu copied {}", BoolText(CopyFiles(GA + ACU_DIR + GCell, GB + ACU_DIR + GCell, ".acu")));
  println("build b {}", Build(GB, GOutput));
  println("b parsed the program alone {}", BoolText(ParsedAlone(GOutput)));
end.
