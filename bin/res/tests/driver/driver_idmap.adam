-------------------------------------------------------------------------------
  driver_idmap.adam - the compiler's containers over System.Collections
  (Adam.Core.Containers, PLAN-ADAM M10h): a StringIdMap made with 0 finds
  a key put twice by its last id and answers 0 for one it does not hold;
  an Int64List (List<int64>) is written by index, sorted ascending and
  searched, a value one takes its last value off; an index outside the list raises code 14
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | names 7 5 0 2
  | list 10 20 40 2
  | nodes 2 1
  | fault 14
@@end
*/

module exe driver_idmap;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Core.Containers;

var
  GNames: ref StringIdMap;
  GList: ref Int64List;
  GNodes: Int64List;
  GCode: int32;
begin
  SetHeapReport(false);
  GNames := ref StringIdMap(0);
  GNames.Put("text", 3);
  GNames.Put("data", 5);
  GNames.Put("text", 7);
  println("names {} {} {} {}", GNames.Find("text"), GNames.Find("data"), GNames.Find("bss"),
    GNames.Count);
  GList := ref Int64List();
  GList.Add(30);
  GList.Add(10);
  GList.Add(20);
  GList[0] := 40;
  GList.Sort();
  println("list {} {} {} {}", GList[0], GList[1], GList[2], GList.IndexOf(40));
  GNodes.Add(1);
  GNodes.Add(2);
  println("nodes {} {}", GNodes.RemoveLast(), GNodes.Count);
  GCode := 0;
  guard
    GList[3] := 1;
  except
    GCode := exccode();
  end;
  println("fault {}", GCode);
end.
