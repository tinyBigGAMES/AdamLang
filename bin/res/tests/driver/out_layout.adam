-------------------------------------------------------------------------------
  out_layout.adam - adam build's output is split by kind, then by target
  triple and mode (PLAN-ADAM SU2.5): this program runs from the output
  folder's bin\<triple>\<mode>\ (the run cell's, debug), its own .acu is in
  acu\<triple>\<mode>\ beside it, and the bin and acu folders of another
  mode (release_safe) hold none of this build's files. Its args: the output root
  and the run cell (<OUT>, <CELL>)
*******************************************************************************/

/*
@@test
  kind run
  args "<OUT>" "<CELL>"
  exitcode 0
  | exe in bin cell true
  | acu in acu cell true
  | exe in release false
  | acu in release false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe out_layout;

import System.SysUtils, System.Windows;

var
  GOut: string;
  GCell: string;
  GRelease: string;

// true / false as text
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// APath with every '\' as '/', in lower case: two spellings of one Windows path compare equal
routine SamePathText(const APath: string): string;
begin
  return LowerCase(ReplaceStr(APath, "\\", "/"));
end;

begin
  GOut := paramstr(1);
  GCell := paramstr(2);
  // The cell of another mode: <triple>/release_safe
  GRelease := ExtractFileDir(GCell) + "/release_safe";
  println("exe in bin cell {}", BoolText(SamePathText(ExtractFileDir(paramstr(0))) =
    SamePathText(GOut + "/bin/" + GCell)));
  println("acu in acu cell {}", BoolText(FileExists(GOut + "/acu/" + GCell + "/out_layout.acu")));
  println("exe in release {}", BoolText(FileExists(GOut + "/bin/" + GRelease + "/out_layout.exe")));
  println("acu in release {}", BoolText(FileExists(GOut + "/acu/" + GRelease + "/out_layout.acu")));
end.
