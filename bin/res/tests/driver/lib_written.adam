-------------------------------------------------------------------------------
  lib_written.adam - adam build of a lib writes its two static libraries
  (PLAN-ADAM M8d) into the output folder's lib\x86_64-windows-gnu\debug\,
  read back here as every linker reads an ar archive: the signature, then
  the first linker member's symbol index (a big-endian count, the member
  offsets, the NUL-ended names). liblib_written_lib.a indexes the lib's
  public routine, its start (__adam_libstart_<name>) and its module's start
  point, never a runtime unit's; libadamrt.a indexes the runtime's, never
  the lib's
*******************************************************************************/

/*
@@test
  kind run
  deps driver.lib_written_lib
  exitcode 0
  | lib signature ok
  | lib WrittenAdd yes
  | lib __adam_libstart_lib_written_lib yes
  | lib __adam_start_lib_written_lib yes
  | lib __adam_start_System.Runtime no
  | adamrt signature ok
  | adamrt WrittenAdd no
  | adamrt __adam_libstart_lib_written_lib no
  | adamrt __adam_start_lib_written_lib no
  | adamrt __adam_start_System.Runtime yes
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe lib_written;

import System.SysUtils, System.IO;

const
  // The two libraries, from the exe's folder (<output>\bin\<triple>\<mode>)
  LIB_PATH: string = "$P:../../../lib/x86_64-windows-gnu/debug/liblib_written_lib.a";
  ADAMRT_PATH: string = "$P:../../../lib/x86_64-windows-gnu/debug/libadamrt.a";
  // An archive's signature and member header (Archive Member Headers)
  SIGNATURE: string = "!<arch>\n";
  SIGNATURE_SIZE: int64 = 8;
  HEADER_SIZE: int64 = 60;
  // The first byte of a linker member's name ("/")
  SLASH: uint8 = 0x2F;

var
  GBytes: ByteArray;
  // The first linker member's names, in index order
  GNames: StringArray;

// The big-endian 32-bit value at AAt of GBytes
routine Be32(const AAt: int64): int64;
begin
  return (int64(GBytes[AAt]) shl 24) | (int64(GBytes[AAt + 1]) shl 16) |
    (int64(GBytes[AAt + 2]) shl 8) | int64(GBytes[AAt + 3]);
end;

// The NUL-ended text at AAt of GBytes; its end into AEnd (the byte after the NUL)
routine NulTextAt(const AAt: int64; var AEnd: int64): string;
var
  LStart: int64;
  LEnd: int64;
begin
  LStart := AAt;
  LEnd := LStart;
  while GBytes[LEnd] <> 0 do
    LEnd := LEnd + 1;
  end;
  AEnd := LEnd + 1;
  if LEnd = LStart then
    return "";
  end;
  return StringFromC(ptr to const char(addr of GBytes[LStart]), LEnd - LStart);
end;

// The archive at APath read: "<ALabel> signature ok" when it starts as one must, its first
// linker member's names into GNames; false when it cannot be read or is no archive
routine ReadIndex(const ALabel: string; const APath: string): bool;
var
  LData: int64;
  LCount: int64;
  LAt: int64;
  LI: int64;
begin
  setlength(GNames, 0);
  if not ReadAllBytes(APath, GBytes) then
    println("{} cannot be read", ALabel);
    return false;
  end;
  if (len(GBytes) < SIGNATURE_SIZE + HEADER_SIZE) or
    (StringFromC(ptr to const char(addr of GBytes[0]), SIGNATURE_SIZE) <> SIGNATURE) or
    (GBytes[SIGNATURE_SIZE] <> SLASH) then
    println("{} is no archive", ALabel);
    return false;
  end;
  println("{} signature ok", ALabel);
  // The first linker member's data: the count, the offsets, then the names
  LData := SIGNATURE_SIZE + HEADER_SIZE;
  LCount := Be32(LData);
  setlength(GNames, LCount);
  LAt := LData + 4 + 4 * LCount;
  for LI := 0 to LCount - 1 do
    GNames[LI] := NulTextAt(LAt, LAt);
  end;
  return true;
end;

// "<ALabel> <AName> yes" when the index read last names AName, else "... no"
routine ShowHas(const ALabel: string; const AName: string);
var
  LI: int64;
begin
  for LI := 0 to len(GNames) - 1 do
    if GNames[LI] = AName then
      println("{} {} yes", ALabel, AName);
      return;
    end;
  end;
  println("{} {} no", ALabel, AName);
end;

// The four names every row asks the archive labeled ALabel about
routine ShowAll(const ALabel: string);
begin
  ShowHas(ALabel, "WrittenAdd");
  ShowHas(ALabel, "__adam_libstart_lib_written_lib");
  ShowHas(ALabel, "__adam_start_lib_written_lib");
  ShowHas(ALabel, "__adam_start_System.Runtime");
end;

begin
  if ReadIndex("lib", LIB_PATH) then
    ShowAll("lib");
  end;
  if ReadIndex("adamrt", ADAMRT_PATH) then
    ShowAll("adamrt");
  end;
end.
