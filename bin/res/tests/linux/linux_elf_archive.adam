*/

module exe linux_elf_archive;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Compiler.SourceText, Adam.Compiler.Diagnostics,
  Adam.Backend.Ssa, Adam.Backend.Sections, Adam.Backend.Parts, Adam.Backend.Targets,
  Adam.Backend.Archive, Adam.Elf.Reader;

const
  // The triple whose format part writes and reads
  LINUX_TRIPLE: string = "x86_64-linux-gnu";

// ABytes appended to the section AId of ASet
func Put(const ASet: ref SectionSet; const AId: int64; const ABytes: array of uint8);
var
  LI: int64;
begin
  for LI := 0 to len(ABytes) - 1 do
    ASet.SectionAt(AId).Put8(uint64(ABytes[LI]));
  end;
end;

// A new Removable section of AKind named for ASymbol in its kind's group; its id
func Piece(const ASet: ref SectionSet; const AFormat: ref FormatPart; const AKind: SectionKind;
  const ASymbol: string; const AAlign: int64): int64;
var
  LGroup: string;
  LId: int64;
begin
  LGroup := AFormat.SectionNameOf(AKind);
  LId := ASet.AddSection(LGroup + "#" + ASymbol, AKind, AAlign);
  ASet.SectionAt(LId).GroupName := LGroup;
  ASet.SectionAt(LId).Removable := true;
  return LId;
end;

// A set whose routines and data are named with APrefix: code calling an import, data with
// a pointer, zeroed storage, a Shared (COMDAT) routine, an Info section of AInfo bytes
func MakeSet(const AFormat: ref FormatPart; const APrefix: string; const AInfo: int64): ref SectionSet;
var
  LSet: ref SectionSet;
  LId: int64;
  LI: int64;
begin
  LSet := ref SectionSet();
  // <p>_add: lea eax, [rdi + rsi]; ret
  LId := Piece(LSet, AFormat, SectionKind.Code, APrefix + "_add", 16);
  Put(LSet, LId, [0x8D, 0x04, 0x37, 0xC3]);
  LSet.DefineSymbol(APrefix + "_add", LId, 0, 0);
  // <p>_call: sub rsp, 8; call [rip + puts]; add rsp, 8; ret
  LId := Piece(LSet, AFormat, SectionKind.Code, APrefix + "_call", 16);
  Put(LSet, LId, [0x48, 0x83, 0xEC, 0x08, 0xFF, 0x15, 0, 0, 0, 0, 0x48, 0x83, 0xC4, 0x08, 0xC3]);
  LSet.DefineSymbol(APrefix + "_call", LId, 0, 0);
  LSet.AddReloc(LId, 6, RelocKind.Rel32, LSet.ImportSymbol("c", "puts", 0), 0);
  // <p>_table: <p>_add's address
  LId := Piece(LSet, AFormat, SectionKind.Data, APrefix + "_table", 8);
  LSet.SectionAt(LId).PutZeros(8);
  LSet.DefineSymbol(APrefix + "_table", LId, 0, 0);
  LSet.AddReloc(LId, 0, RelocKind.Abs64, LSet.FindSymbol(APrefix + "_add"), 0);
  // <p>_count: 4 zeroed bytes
  LId := Piece(LSet, AFormat, SectionKind.Zeroed, APrefix + "_count", 4);
  LSet.SectionAt(LId).PutZeros(4);
  LSet.DefineSymbol(APrefix + "_count", LId, 0, 0);
  // <p>_shared: mov eax, 7; ret, Shared (COMDAT ANY)
  LId := Piece(LSet, AFormat, SectionKind.Code, APrefix + "_shared", 16);
  LSet.SectionAt(LId).Shared := true;
  Put(LSet, LId, [0xB8, 0x07, 0, 0, 0, 0xC3]);
  LSet.DefineSymbol(APrefix + "_shared", LId, 0, 0);
  // the compiler's own bytes: AInfo of them, 0x41 up
  LId := LSet.AddSection(AFormat.SectionNameOf(SectionKind.Info), SectionKind.Info, 1);
  for LI := 0 to AInfo - 1 do
    LSet.SectionAt(LId).Put8(uint64(0x41 + LI));
  end;
  return LSet;
end;

// ABytes as text (each byte one char)
func TextOf(const ABytes: ByteArray): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  for LI := 0 to len(ABytes) - 1 do
    LText := LText + char(ABytes[LI]);
  end;
  return LText;
end;

// AValues as a byte array
func BytesOf(const AValues: array of uint8): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(AValues));
  for LI := 0 to len(AValues) - 1 do
    LBytes[LI] := AValues[LI];
  end;
  return LBytes;
end;

// "yes" or "no"
func YesNo(const AValue: bool): string;
begin
  if AValue then
    return "yes";
  end;
  return "no";
end;

// The object ABytes as the reader reads it, field by field
func ShowObject(const ABytes: ByteArray);
var
  LReports: ref Diagnostics;
  LObject: ElfObjectData;
  LSection: ElfSection;
  LSymbol: ElfSymbol;
  LReloc: ElfReloc;
  LI: int64;
begin
  LReports := ref Diagnostics(100);
  if not ReadElfObject(ABytes, 0, len(ABytes), "object", NoPlace(), LReports, LObject) then
    LReports.PrintAll();
    return;
  end;
  println("{}", "object type " + IntToStr(LObject.FileType) + " machine 0x" +
    IntToHex(uint64(LObject.Machine), 2) + " flags " + IntToStr(LObject.Flags) + " sections " +
    IntToStr(len(LObject.Sections)) + " symbols " + IntToStr(len(LObject.Symbols)) + " first global " +
    IntToStr(LObject.FirstGlobal) + " relocs " + IntToStr(len(LObject.Relocs)));
  for LI := 0 to len(LObject.Sections) - 1 do
    LSection := LObject.Sections[LI];
    println("{}", "[" + IntToStr(LI) + "] '" + LSection.SectionName + "' type " +
      IntToStr(LSection.SectionType) + " flags 0x" + IntToHex(uint64(LSection.Flags), 1) + " size " +
      IntToStr(LSection.DataSize) + " data " + YesNo(LSection.DataAt <> 0) + " link " +
      IntToStr(LSection.Link) + " info " + IntToStr(LSection.Info) + " align " +
      IntToStr(LSection.Align) + " relocs " + IntToStr(LSection.RelocFirst) + "+" +
      IntToStr(LSection.RelocCount) + " group " + IntToStr(LSection.Group) + " groupflags " +
      IntToStr(LSection.GroupFlags));
  end;
  for LI := 0 to len(LObject.Symbols) - 1 do
    LSymbol := LObject.Symbols[LI];
    println("{}", "sym " + IntToStr(LI) + " '" + LSymbol.SymbolName + "' bind " +
      IntToStr(LSymbol.Bind) + " type " + IntToStr(LSymbol.SymbolType) + " vis " +
      IntToStr(LSymbol.Visibility) + " shndx " + IntToStr(LSymbol.SectionIndex) + " value " +
      IntToStr(LSymbol.SymbolValue) + " size " + IntToStr(LSymbol.SymbolSize));
  end;
  for LI := 0 to len(LObject.Relocs) - 1 do
    LReloc := LObject.Relocs[LI];
    println("{}", "rela [" + IntToStr(LReloc.Section) + "] +" + IntToStr(LReloc.Offset) + " type " +
      IntToStr(LReloc.RelocType) + " '" + LObject.Symbols[LReloc.SymbolIndex].SymbolName +
      "' addend " + IntToStr(LReloc.Addend));
  end;
end;

// ReadSection / ReplaceSection on AFormat's Info section of ABytes, and their refusals
func ShowSections(const AFormat: ref FormatPart; const ABytes: ByteArray);
var
  LBytes: ByteArray;
  LSection: ByteArray;
  LNew: ByteArray;
  LInfo: string;
  LGarbage: ByteArray;
begin
  LBytes := ABytes;
  LInfo := AFormat.SectionNameOf(SectionKind.Info);
  println("{}", "read " + LInfo + " " + YesNo(AFormat.ReadSection(LBytes, LInfo, LSection)) +
    " '" + TextOf(LSection) + "'");
  LNew := BytesOf([0x5A, 0x59, 0x58, 0x57]);
  println("{}", "replace same size " + YesNo(AFormat.ReplaceSection(LBytes, LInfo, LNew)));
  println("{}", "read again " + YesNo(AFormat.ReadSection(LBytes, LInfo, LSection)) + " '" +
    TextOf(LSection) + "'");
  LNew := BytesOf([0x31, 0x32]);
  println("{}", "replace other size " + YesNo(AFormat.ReplaceSection(LBytes, LInfo, LNew)));
  println("{}", "read after refusal '" + TextOf(LSection) + "' " +
    YesNo(AFormat.ReadSection(LBytes, LInfo, LSection)));
  println("{}", "read .nosuch " + YesNo(AFormat.ReadSection(LBytes, ".nosuch", LSection)) +
    " size " + IntToStr(len(LSection)));
  // A .bss section holds no bytes: no section to read
  println("{}", "read .bss " + YesNo(AFormat.ReadSection(LBytes, ".bss", LSection)));
  LGarbage := BytesOf([0x7F, 0x45, 0x4C, 0x46, 1, 1, 1]);
  println("{}", "read garbage " + YesNo(AFormat.ReadSection(LGarbage, LInfo, LSection)));
  println("{}", "replace garbage " + YesNo(AFormat.ReplaceSection(LGarbage, LInfo, LNew)));
end;

// The archive ABytes entry by entry, as ar t and nm -s read it (ADetail: every entry and
// symbol; else counts), every member read by ReadElfObject (totals); ALabel names it
func ShowArchive(const ALabel: string; const ABytes: ByteArray; const ADetail: bool);
var
  LReports: ref Diagnostics;
  LArchive: ArchiveContents;
  LEntry: ArchiveEntry;
  LObject: ElfObjectData;
  LMembers: int64;
  LLong: int64;
  LSections: int64;
  LSymbols: int64;
  LRelocs: int64;
  LGood: int64;
  LI: int64;
  LKind: string;
begin
  LReports := ref Diagnostics(100);
  if not ReadArchiveContents(ABytes, ALabel, NoPlace(), LReports, LArchive) then
    LReports.PrintAll();
    return;
  end;
  LMembers := 0;
  LLong := 0;
  LSections := 0;
  LSymbols := 0;
  LRelocs := 0;
  LGood := 0;
  for LI := 0 to len(LArchive.Entries) - 1 do
    LEntry := LArchive.Entries[LI];
    LKind := "member";
    if LEntry.Kind = ArchiveEntryKind.SymbolIndex then
      LKind := "index";
    end;
    if LEntry.Kind = ArchiveEntryKind.NameTable then
      LKind := "names";
    end;
    if ADetail then
      println("{}", "entry " + LKind + " '" + LEntry.EntryName + "' at " + IntToStr(LEntry.HeaderAt) +
        " size " + IntToStr(LEntry.Size));
    end;
    if LEntry.Kind = ArchiveEntryKind.Member then
      LMembers := LMembers + 1;
      if len(LEntry.EntryName) > 15 then
        LLong := LLong + 1;
      end;
      if ReadElfObject(ABytes, LEntry.DataAt, LEntry.Size, LEntry.EntryName, NoPlace(), LReports,
        LObject) then
        LGood := LGood + 1;
        LSections := LSections + len(LObject.Sections);
        LSymbols := LSymbols + len(LObject.Symbols);
        LRelocs := LRelocs + len(LObject.Relocs);
      end;
    end;
  end;
  LReports.PrintAll();
  println("{}", ALabel + ": " + IntToStr(LMembers) + " members (" + IntToStr(LLong) +
    " long names), " + IntToStr(len(LArchive.Symbols)) + " index symbols; " + IntToStr(LGood) +
    " objects read: " + IntToStr(LSections) + " sections, " + IntToStr(LSymbols) + " symbols, " +
    IntToStr(LRelocs) + " relocations");
  for LI := 0 to len(LArchive.Symbols) - 1 do
    if ADetail or (LArchive.Symbols[LI].SymbolName = "inflate") or
      (LArchive.Symbols[LI].SymbolName = "crc32") or (LArchive.Symbols[LI].SymbolName = "memcpy") or
      (LArchive.Symbols[LI].SymbolName = "strlen") then
      println("{}", "symbol " + LArchive.Symbols[LI].SymbolName + " in " +
        LArchive.Entries[LArchive.Symbols[LI].Member].EntryName);
    end;
  end;
end;

// The static library of two objects written, read back (ReadStaticLibrary) and dumped; the
// archive written beside the program
func ShowLibrary(const AFormat: ref FormatPart; const AFirst: ByteArray; const ASecond: ByteArray);
var
  LObjects: ObjectFileArray;
  LBack: ObjectFileArray;
  LArchive: ByteArray;
  LSame: bool;
  LI: int64;
  LJ: int64;
begin
  setlength(LObjects, 2);
  LObjects[0].MemberName := "lx2b_one";
  LObjects[0].Bytes := AFirst;
  LObjects[1].MemberName := "lx2b_second_with_a_long_name";
  LObjects[1].Bytes := ASecond;
  LArchive := AFormat.WriteStaticLibrary(LObjects);
  println("{}", "library " + AFormat.StaticLibraryName("lx2b") + " " + IntToStr(len(LArchive)) +
    " bytes");
  ShowArchive("library", LArchive, true);
  println("{}", "read back " + YesNo(AFormat.ReadStaticLibrary(LArchive, LBack)) + " " +
    IntToStr(len(LBack)) + " objects");
  for LI := 0 to len(LBack) - 1 do
    LSame := len(LBack[LI].Bytes) = len(LObjects[LI].Bytes);
    if LSame then
      for LJ := 0 to len(LBack[LI].Bytes) - 1 do
        if LBack[LI].Bytes[LJ] <> LObjects[LI].Bytes[LJ] then
          LSame := false;
        end;
      end;
    end;
    println("{}", "object " + LBack[LI].MemberName + " " + IntToStr(len(LBack[LI].Bytes)) +
      " bytes, same " + YesNo(LSame));
  end;
  if not WriteAllBytes("$P:linux_elf_archive.a", LArchive) then
    println("the archive could not be written");
  end;
end;

// The vendor archive at APath (an argument) read whole under its file name
func ShowVendor(const APath: string);
var
  LBytes: ByteArray;
begin
  if not ReadAllBytes(APath, LBytes) then
    println("{}", ExtractFileName(APath) + " cannot be read");
    return;
  end;
  ShowArchive(ExtractFileName(APath), LBytes, false);
end;

// ABytes cut to its first ACount bytes
func Cut(const ABytes: ByteArray; const ACount: int64): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, ACount);
  for LI := 0 to ACount - 1 do
    LBytes[LI] := ABytes[LI];
  end;
  return LBytes;
end;

// ABytes read as the object ALabel: the reports it gives
func Damaged(const ALabel: string; const ABytes: ByteArray);
var
  LReports: ref Diagnostics;
  LObject: ElfObjectData;
begin
  LReports := ref Diagnostics(100);
  if ReadElfObject(ABytes, 0, len(ABytes), ALabel, NoPlace(), LReports, LObject) then
    println("{}", ALabel + " read");
  end;
  LReports.PrintAll();
end;

// The object ABytes damaged in each way the reader reports (EO0001)
func ShowDamaged(const ABytes: ByteArray);
var
  LBytes: ByteArray;
  LTable: int64;
begin
  Damaged("not elf", BytesOf([0x4D, 0x5A, 0x90, 0x00]));
  Damaged("cut header", Cut(ABytes, 40));
  LBytes := ABytes;
  LBytes[4] := 1;
  Damaged("class 32", LBytes);
  LBytes := ABytes;
  LBytes[58] := 40;
  Damaged("entry size", LBytes);
  Damaged("cut table", Cut(ABytes, len(ABytes) - 8));
  // e_shoff (40) names the section header table; section 2's sh_name (+0) and sh_size (+32)
  LTable := int64(GetLe(ABytes, 40, 8));
  LBytes := ABytes;
  PutLe(LBytes, LTable + 2 * 64, 0xFFFF, 4);
  Damaged("section name", LBytes);
  LBytes := ABytes;
  PutLe(LBytes, LTable + 2 * 64 + 32, 0xFFFFFF, 8);
  Damaged("section data", LBytes);
  LBytes := ABytes;
  PutLe(LBytes, 62, 2, 2);
  Damaged("name table", LBytes);
end;

var
  LBackend: ref Backend;
  LFirst: ByteArray;
  LSecond: ByteArray;
begin
  LBackend := BackendFor(LINUX_TRIPLE);
  LFirst := LBackend.Format.WriteObject(MakeSet(LBackend.Format, "lx2b", 4));
  LSecond := LBackend.Format.WriteObject(MakeSet(LBackend.Format, "lx2c", 3));
  ShowObject(LFirst);
  ShowSections(LBackend.Format, LFirst);
  ShowLibrary(LBackend.Format, LFirst, LSecond);
  ShowVendor(paramstr(1));
  ShowVendor(paramstr(2));
  ShowDamaged(LFirst);
  if not WriteAllBytes("$P:linux_elf_archive.o", LFirst) then
    println("the object could not be written");
  end;
end.
