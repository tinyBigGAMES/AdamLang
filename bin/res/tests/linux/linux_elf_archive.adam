  | sym 4 'lx2b_count' bind 1 type 1 vis 0 shndx 5 value 0 size 0
  | sym 5 'lx2b_shared' bind 1 type 2 vis 0 shndx 6 value 0 size 0
  | sym 6 'puts' bind 1 type 0 vis 0 shndx 0 value 0 size 0
  | rela [3] +6 type 9 'puts' addend -4
  | rela [4] +0 type 1 'lx2b_add' addend 0
  | read .adam yes 'ABCD'
  | replace same size yes
  | read again yes 'ZYXW'
  | replace other size no
  | read after refusal 'ZYXW' yes
  | read .nosuch no size 0
  | read .bss no
  | read garbage no
  | replace garbage no
  | library liblx2b.a 3102 bytes
  | entry index '/' at 8 size 150
  | entry names '//' at 218 size 32
  | entry member 'lx2b_one.o' at 310 size 1336
  | entry member 'lx2b_second_with_a_long_name.o' at 1706 size 1336
  | library: 2 members (1 long names), 10 index symbols; 2 objects read: 26 sections, 14 symbols, 4 relocations
  | symbol lx2b_add in lx2b_one.o
  | symbol lx2b_call in lx2b_one.o
  | symbol lx2b_table in lx2b_one.o
  | symbol lx2b_count in lx2b_one.o
  | symbol lx2b_shared in lx2b_one.o
