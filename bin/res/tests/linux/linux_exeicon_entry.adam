-------------------------------------------------------------------------------
  linux_exeicon_entry.adam - @exeicon on x86_64-linux-gnu (PLAN-LINUX64
  LX3d3c3b2, BNF sec 2: an ELF file has no icon): the compiler decodes the
  icon's largest image (fixtures\dir_exeicon_image\multi.ico: a 32x32 BMP,
  a 32x32 PNG that wins the tie by its bit count, a 16x16 BMP) into the
  data entry ADAM_RESDATA_EXEICON_KEY: width and height (uint32 LE), then
  the RGBA rows top down, a zero byte after them (not counted), read back
  with FindResData; window-less (no display needed). The pixels' crc-32
  and first pixel are exe.dir_exeicon_image's multi line
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | entry true size 4104
  | icon 32 x 32 crc 566674644 first 170 212 4 22
  | after 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_exeicon_entry;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_exeicon_entry runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

@exeicon "$P:res/tests/exe/fixtures/dir_exeicon_image/multi.ico";

import System.SysUtils, System.Zlib.Ext, System.ResData;

var
  GEntry: ResDataEntry;
  GPixels: ByteArray;
  GI: int64;

begin
  GEntry := FindResData(ADAM_RESDATA_EXEICON_KEY);
  println("entry {} size {}", HasResData(ADAM_RESDATA_EXEICON_KEY), GEntry.Size);
  if GEntry.Size < ADAM_RESDATA_EXEICON_HEADER then
    return 1;
  end;
  setlength(GPixels, GEntry.Size - ADAM_RESDATA_EXEICON_HEADER);
  for GI := 0 to len(GPixels) - 1 do
    GPixels[GI] := GEntry.Data[ADAM_RESDATA_EXEICON_HEADER + GI];
  end;
  println("icon {} x {} crc {} first {} {} {} {}",
    int64(GEntry.Data[0]) | (int64(GEntry.Data[1]) shl 8),
    int64(GEntry.Data[4]) | (int64(GEntry.Data[5]) shl 8),
    ZlibCRC32(0, GPixels), GPixels[0], GPixels[1], GPixels[2], GPixels[3]);
  println("after {}", GEntry.Data[GEntry.Size]);
end.
