-------------------------------------------------------------------------------
  linux_raylib_screen.adam - a REAL raylib window on x86_64-linux-gnu
  (PLAN-LINUX64, the gap after LX3d3a's display-less row): System.Raylib.C
  over libraylib.a linked against libX11.so.6 and libc.so.6, run through
  RunElf with the environment kept (WSLg's DISPLAY on a win64 host): the
  window comes up (IsWindowReady true) at its size, GL is live (a frame
  cleared green with a red square drawn, the screen read back before
  EndDrawing gives both colours where they were drawn), a second frame
  draws, and CloseWindow lets go (IsWindowReady false after it, AV.9)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ready true
  | size 320 x 200
  | square 230 41 55
  | background 0 228 48
  | second frame ok
  | closed ready false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_raylib_screen;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_raylib_screen runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

import System.SysUtils, System.Raylib.C;

// The colour at (AX, AY) printed as its r g b
routine PrintAt(const ALabel: string; const AShot: Image; const AX: int32; const AY: int32);
var
  LColor: Color;
begin
  LColor := GetImageColor(AShot, AX, AY);
  println("{} {} {} {}", ALabel, LColor.r, LColor.g, LColor.b);
end;

var
  GShot: Image;

begin
  SetTraceLogLevel(LOG_NONE);
  InitWindow(320, 200, "linux_raylib_screen");
  println("ready {}", IsWindowReady());
  if not IsWindowReady() then
    // InitWindow failed: raylib has let go already (no CloseWindow, AV.9)
    return 1;
  end;
  println("size {} x {}", GetScreenWidth(), GetScreenHeight());
  // One frame: cleared green, a red square at the top left, read back before the swap
  BeginDrawing();
  ClearBackground(GREEN);
  DrawRectangle(0, 0, 100, 100, RED);
  // The square is still in raylib's draw batch: drawn out before the screen is read
  rlDrawRenderBatchActive();
  GShot := LoadImageFromScreen();
  PrintAt("square", GShot, 50, 50);
  PrintAt("background", GShot, 250, 150);
  UnloadImage(GShot);
  EndDrawing();
  // A second frame on the same context
  BeginDrawing();
  ClearBackground(BLACK);
  EndDrawing();
  println("second frame ok");
  CloseWindow();
  println("closed ready {}", IsWindowReady());
end.
