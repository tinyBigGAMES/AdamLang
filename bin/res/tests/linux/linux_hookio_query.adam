-------------------------------------------------------------------------------
  linux_hookio_query.adam - System.HookIO's query family on
  x86_64-linux-gnu (PLAN-LINUX64 LX3d3c2b)

  fixtures\liblinux_hookio_c.a asks a registered memory IO and a real file
  of the same bytes access (F_OK / R_OK / W_OK), stat, stat64, lstat,
  lstat64 and the names glibc before 2.33 reached them through (__xstat,
  __lxstat, __xstat64, _STAT_VER 1), and a name beside it that is not there
  (ENOENT; for the IO an unregistered prefix): every slot of the IO's equals the real file's. A read-only IO
  answers W_OK with -1.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ok query register
  | ok query real file
  | ok query size
  | ok query missing ENOENT
  | ok query as real file
  | ok query read-only not writable
  | ok query read-only unregister
  | ok query unregister
  | ok query io close
  | ok query real removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_hookio_query;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_hookio_query runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

@addlibrarypath "$P:res/tests/linux/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO, System.HookIO.Linux64;

func clink linux_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to uint8;
  ACount: clong): int32; external "linux_hookio_c";
func clink linux_hookio_c_sample(ABuffer: ptr to uint8; ACap: clong): clong;
  external "linux_hookio_c";
func clink linux_hookio_c_query(APath: ptr to const char; AMissing: ptr to const char;
  AResults: ptr to int64); external "linux_hookio_c";

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst (the registered IO's) equal ASecond's (the real file's);
// the first that differs is printed
func SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
func RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (glibc's own FILE)
func WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := linux_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// The C fixture's query run over APath and AMissing (a name that is not there): its 16 slots
// in AResults
func QueryC(const APath: string; const AMissing: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMissing: ptr to char;
begin
  LPath := StringToC(APath);
  LMissing := StringToC(AMissing);
  linux_hookio_c_query(LPath, LMissing, AResults);
  freemem(LPath);
  freemem(LMissing);
end;

// access / stat / stat64 / lstat / lstat64 / __xstat / __lxstat / __xstat64 on a registered
// IO, each slot as glibc gives it on a real file of the same bytes; a read-only IO is not
// writable
func TestQuery();
var
  LSample: array[0..63] of uint8;
  LLength: clong;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LReadOnly: IO;
  LReadOnlyPrefix: string;
  LVirtual: array[0..15] of int64;
  LReal: array[0..15] of int64;
begin
  LRealPath := paramstr(0) + ".query.txt";
  LLength := linux_hookio_c_sample(addr of LSample[0], 64);
  LMemory := CreateMemoryIO(addr of LSample[0], int64(LLength), false);
  LPrefix := RegisterIO(LMemory);
  Check("query register", LPrefix <> "");
  Check("query real file", WriteRaw(LRealPath, addr of LSample[0], int64(LLength)));

  // The IO's missing name: a prefix never registered (any name after a registered one is it)
  QueryC(LPrefix + "/q.txt", "io://999999/q.txt", addr of LVirtual[0]);
  QueryC(LRealPath, LRealPath + "x", addr of LReal[0]);
  Check("query size", (LVirtual[4] = int64(LLength)) and (LVirtual[5] = 1) and
    (LVirtual[11] = int64(LLength)));
  Check("query missing ENOENT", (LVirtual[12] = -1) and (LVirtual[13] = int64(ADAM_ERRNO_ENOENT)));
  Check("query as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 16));

  LReadOnly := CreateMemoryIO(addr of LSample[0], int64(LLength), true);
  LReadOnlyPrefix := RegisterIO(LReadOnly);
  QueryC(LReadOnlyPrefix + "/q.txt", "io://999999/q.txt", addr of LVirtual[0]);
  Check("query read-only not writable", (LVirtual[0] = 0) and (LVirtual[1] = 0) and
    (LVirtual[2] = -1) and (LVirtual[4] = int64(LLength)));
  Check("query read-only unregister", UnregisterIO(LReadOnlyPrefix) and IOClose(LReadOnly));

  Check("query unregister", UnregisterIO(LPrefix));
  Check("query io close", IOClose(LMemory));
  Check("query real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestQuery();
  println("done {}", GFails);
end.
