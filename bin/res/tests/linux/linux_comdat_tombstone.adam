-------------------------------------------------------------------------------
  linux_comdat_tombstone.adam - a generic instance two modules of one build
  make (List<string>, its set_Items with a cleanup funclet: a string
  argument), the program's copy kept and fixtures\TombUnit's copy (a COMDAT
  group in its .acu object) discarded on both targets (PLAN-LINUX64 LX3d3f):
  the unit's line table (a Tombstone section) names the discarded copy's
  code and cleanup, and those fields read 0 (Adam.ELF.Foreign's tombstone
  target, Adam.ELF.Linker's DoTombstoned; COFF's M10f) instead of failing
  the link (EF0006) or reaching the kept copy. Then a raise inside the
  unit's guard and one through the kept instance, both caught.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | main [b, two]
  | unit [x, y] 2
  | unit caught: tomb
  | main caught: index
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_comdat_tombstone;

@addmodulepath "$P:res/tests/linux/fixtures";

import System.SysUtils, System.Collections, TombUnit;

var
  GList: List<string>;

begin
  GList.Add("a");
  GList.Add("two");
  // set_Items: the program's own copy of the instance, the one the link keeps
  GList[0] := "b";
  println("main [{}, {}]", GList[0], GList[1]);
  println("unit {} {}", TombJoin("x", "y"), TombCount());
  println("unit caught: {}", TombRaise());
  guard
    GList[5] := "out";
  except
    println("main caught: index");
  end;
end.
