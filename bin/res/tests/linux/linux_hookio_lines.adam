-------------------------------------------------------------------------------
  linux_hookio_lines.adam - System.HookIO's getline / getdelim and seek
  family on x86_64-linux-gnu (PLAN-LINUX64 LX3d3c2b)

  fixtures\liblinux_hookio_c.a reads a registered memory IO and a real file
  of the same text by getline (five calls, the end included, the buffer it
  grows), getdelim on ',' and '\n', __getdelim and getdelim with no buffer
  of its own, then seeks it by fseeko / ftello / fgetpos / fsetpos and their
  64 forms (a place kept and gone back to, from the end, rewind, a place
  before the start EINVAL): every slot of the IO's equals the real file's.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ok lines register
  | ok lines real file
  | ok lines counts
  | ok lines as real file
  | ok seeks place 5
  | ok seeks as real file
  | ok lines unregister
  | ok lines io close
  | ok lines real removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_hookio_lines;

@addlibrarypath "$P:res/tests/linux/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO, System.HookIO.Linux64;

routine clink linux_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to uint8;
  ACount: clong): int32; external "linux_hookio_c";
routine clink linux_hookio_c_sample(ABuffer: ptr to uint8; ACap: clong): clong;
  external "linux_hookio_c";
routine clink linux_hookio_c_lines(APath: ptr to const char; AResults: ptr to int64);
  external "linux_hookio_c";
routine clink linux_hookio_c_seeks(APath: ptr to const char; AResults: ptr to int64);
  external "linux_hookio_c";

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst (the registered IO's) equal ASecond's (the real file's);
// the first that differs is printed
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (glibc's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := linux_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// The C fixture's getline / getdelim run over APath: its 24 slots in AResults
routine LinesC(const APath: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
begin
  LPath := StringToC(APath);
  linux_hookio_c_lines(LPath, AResults);
  freemem(LPath);
end;

// The C fixture's fseeko / fgetpos run over APath: its 17 slots in AResults
routine SeeksC(const APath: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
begin
  LPath := StringToC(APath);
  linux_hookio_c_seeks(LPath, AResults);
  freemem(LPath);
end;

// getline / getdelim / __getdelim and the seek and place family on a registered IO, each slot
// as glibc's own FILE gives it on a real file of the same bytes
routine TestLines();
var
  LSample: array[0..63] of uint8;
  LLength: clong;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..23] of int64;
  LReal: array[0..23] of int64;
begin
  LRealPath := paramstr(0) + ".lines.txt";
  LLength := linux_hookio_c_sample(addr of LSample[0], 64);
  LMemory := CreateMemoryIO(addr of LSample[0], int64(LLength), false);
  LPrefix := RegisterIO(LMemory);
  Check("lines register", LPrefix <> "");
  Check("lines real file", WriteRaw(LRealPath, addr of LSample[0], int64(LLength)));

  LinesC(LPrefix + "/l.txt", addr of LVirtual[0]);
  LinesC(LRealPath, addr of LReal[0]);
  // "alpha\n" (6), "beta,gamma\n" (11), "\n", "last line, no end" (17), then the end
  Check("lines counts", (LVirtual[0] = 6) and (LVirtual[2] = 11) and (LVirtual[4] = 1) and
    (LVirtual[6] = 17) and (LVirtual[8] = -1) and (LVirtual[23] = 0));
  Check("lines as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 24));
  SeeksC(LPrefix + "/l.txt", addr of LVirtual[0]);
  SeeksC(LRealPath, addr of LReal[0]);
  Check("seeks place 5", (LVirtual[1] = 5) and (LVirtual[3] = LVirtual[6]) and
    (LVirtual[10] = LVirtual[12]) and (LVirtual[14] = -1));
  Check("seeks as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 17));

  Check("lines unregister", UnregisterIO(LPrefix));
  Check("lines io close", IOClose(LMemory));
  Check("lines real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestLines();
  println("done {}", GFails);
end.
