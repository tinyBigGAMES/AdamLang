-------------------------------------------------------------------------------
  linux_defines.adam - the front end under x86_64-linux-gnu (PLAN-LINUX64
  LX4h): the target's predefined symbols (TARGET_X86_64, TARGET_LINUX,
  TARGET_GNU, the whole triple TARGET_X86_64_LINUX_GNU, TARGET_64BIT; none
  of x86_64-windows-gnu's: TARGET_WINDOWS, TARGET_X86_64_WINDOWS_GNU), and
  the C types the target sizes: clong / culong 8 bytes (LP64), wchar (C's
  wchar_t) 4 bytes and signed (-1 stays -1), ptr 8
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | TARGET_X86_64 yes
  | TARGET_LINUX yes
  | TARGET_GNU yes
  | TARGET_X86_64_LINUX_GNU yes
  | TARGET_64BIT yes
  | TARGET_WINDOWS no
  | TARGET_X86_64_WINDOWS_GNU no
  | clong 8 culong 8
  | clong high 9223372036854775807
  | wchar 4 signed -1
  | ptr 8
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_defines;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_defines runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

var
  GLong: clong;
  GWide: wchar;
  GMinusOne: int32;

begin
@ifdef TARGET_X86_64
  println("TARGET_X86_64 yes");
@else
  println("TARGET_X86_64 no");
@endif
@ifdef TARGET_LINUX
  println("TARGET_LINUX yes");
@else
  println("TARGET_LINUX no");
@endif
@ifdef TARGET_GNU
  println("TARGET_GNU yes");
@else
  println("TARGET_GNU no");
@endif
@ifdef TARGET_X86_64_LINUX_GNU
  println("TARGET_X86_64_LINUX_GNU yes");
@else
  println("TARGET_X86_64_LINUX_GNU no");
@endif
@ifdef TARGET_64BIT
  println("TARGET_64BIT yes");
@else
  println("TARGET_64BIT no");
@endif
@ifdef TARGET_WINDOWS
  println("TARGET_WINDOWS yes");
@else
  println("TARGET_WINDOWS no");
@endif
@ifdef TARGET_X86_64_WINDOWS_GNU
  println("TARGET_X86_64_WINDOWS_GNU yes");
@else
  println("TARGET_X86_64_WINDOWS_GNU no");
@endif
  println("clong {} culong {}", size(clong), size(culong));
  // the widest clong: 8 bytes hold it (a 4-byte clong could not)
  GLong := 9223372036854775807;
  println("clong high {}", int64(GLong));
  // wchar_t is signed on Linux: -1 converted reads back as -1
  GMinusOne := -1;
  GWide := wchar(GMinusOne);
  println("wchar {} signed {}", size(wchar), int64(GWide));
  println("ptr {}", size(ptr));
end.
