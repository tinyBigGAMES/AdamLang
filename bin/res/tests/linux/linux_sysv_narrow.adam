-------------------------------------------------------------------------------
  linux_sysv_narrow.adam - System V's narrow integer arguments on
  x86_64-linux-gnu (Adam.SysV.ABI's CallLayout.ExtendNarrow): bool, int8 /
  uint8 and int16 / uint16 arguments go to a C callee extended to 32 bits
  by their signedness, in registers and stack slots alike, as clang's
  callees read them. The fields are loaded from a record passed by
  reference, so each argument register held the record's address first
  (its upper bits not zero): fixtures\liblinux_sysv_narrow_c.a sums them
  and turns one byte into a float with no extension of its own.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | sum 65121 float 203
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_sysv_narrow;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_sysv_narrow runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

@addlibrarypath "$P:res/tests/linux/fixtures";

import System.SysUtils;

type
  // The narrow values, read through a reference
  Narrow = record
    a: uint8;
    b: int8;
    c: uint16;
    d: int16;
    e: bool;
    f: uint8;
    g: uint8;
    h: int8;
    i: uint16;
  end;

func clink linux_sysv_narrow_sum(a: uint8; b: int8; c: uint16; d: int16; e: bool; f: uint8;
  g: uint8; h: int8; i: uint16): int32; external "linux_sysv_narrow_c";
func clink linux_sysv_narrow_float(a: uint8): float32; external "linux_sysv_narrow_c";

// Every field to the C sum (each argument register held AValues' address before)
func Sum(const AValues: Narrow): int32;
begin
  return linux_sysv_narrow_sum(AValues.a, AValues.b, AValues.c, AValues.d, AValues.e,
    AValues.f, AValues.g, AValues.h, AValues.i);
end;

// The first byte to the C float
func ToFloat(const AValues: Narrow): float32;
begin
  return linux_sysv_narrow_float(AValues.a);
end;

func Run();
var
  LValues: Narrow;
begin
  LValues := Narrow(a: 203, b: -76, c: 34283, d: 12081, e: true, f: 227, g: 113, h: 85,
    i: 18204);
  println("sum {} float {}", Sum(LValues), int32(ToFloat(LValues)));
end;

begin
  Run();
end.
