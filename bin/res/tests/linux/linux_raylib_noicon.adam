-------------------------------------------------------------------------------
  linux_raylib_noicon.adam - linux_raylib_icon's build with no @exeicon:
  the exe has no ADAM_RESDATA_EXEICON_KEY entry, so System.Raylib.Ext.Linux64's
  XCreateWindow hook sets no _NET_WM_ICON (XGetWindowProperty: type None,
  format 0, no word); a real window (WSLg), released (AV.9)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ready true
  | icon type 0 format 0 words 0
  | closed ready false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_raylib_noicon;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_raylib_noicon runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

import System.SysUtils, System.Zlib.Ext, System.Raylib.C, System.Raylib.Ext;

const
  // dlfcn.h: RTLD_LAZY | RTLD_NOLOAD (GLFW's libX11, already loaded); Xatom.h: XA_CARDINAL
  ROW_RTLD: int32 = 0x00005;
  ROW_XA_CARDINAL: uint64 = 6;

type
  XOpenDisplayFn = func(AName: ptr to const char): ptr;
  XCloseDisplayFn = func(ADisplay: ptr): int32;
  XInternAtomFn = func(ADisplay: ptr; AAtomName: ptr to const char; AOnlyIfExists: int32): uint64;
  XGetWindowPropertyFn = func(ADisplay: ptr; AWindow: uint64; AProperty: uint64;
    ALongOffset: int64; ALongLength: int64; ADelete: int32; AReqType: uint64;
    AActualType: ptr to uint64; AActualFormat: ptr to int32; ANItems: ptr to uint64;
    ABytesAfter: ptr to uint64; AProp: ptr to ptr to uint8): int32;
  XFreeFn = func(AData: ptr): int32;

func dlopen(const AFile: ptr to const char; const AMode: int32): ptr; external "c";
func dlsym(AHandle: ptr; AName: ptr to const char): ptr; external "c";

// The _NET_WM_ICON of raylib's window, read on a connection of the row's own (the
// property is the server's): its type, format and word count, then (when there is one) the
// width / height words and the crc-32 of its ARGB words turned back into RGBA bytes
func PrintIcon();
var
  LX11: ptr;
  LOpen: XOpenDisplayFn;
  LClose: XCloseDisplayFn;
  LIntern: XInternAtomFn;
  LGet: XGetWindowPropertyFn;
  LFree: XFreeFn;
  LDisplay: ptr;
  LWindow: uint64;
  LType: uint64;
  LFormat: int32;
  LCount: uint64;
  LAfter: uint64;
  LData: ptr to uint8;
  LWords: ptr to uint64;
  LId: ptr to const uint64;
  LPixels: ByteArray;
  LI: int64;
  LWord: uint64;
begin
  LX11 := dlopen(ptr to const char("libX11.so.6"), ROW_RTLD);
  if LX11 = nil then
    println("no libX11");
    return;
  end;
  LOpen := XOpenDisplayFn(dlsym(LX11, ptr to const char("XOpenDisplay")));
  LClose := XCloseDisplayFn(dlsym(LX11, ptr to const char("XCloseDisplay")));
  LIntern := XInternAtomFn(dlsym(LX11, ptr to const char("XInternAtom")));
  LGet := XGetWindowPropertyFn(dlsym(LX11, ptr to const char("XGetWindowProperty")));
  LFree := XFreeFn(dlsym(LX11, ptr to const char("XFree")));
  LDisplay := LOpen(nil);
  if LDisplay = nil then
    println("no display");
    return;
  end;
  // raylib's GetWindowHandle points at its copy of the X11 Window id
  LId := ptr to const uint64(GetWindowHandle());
  LWindow := LId^;
  LType := 0;
  LFormat := 0;
  LCount := 0;
  LAfter := 0;
  LData := nil;
  LGet(LDisplay, LWindow, LIntern(LDisplay, ptr to const char("_NET_WM_ICON"), 0), 0,
    0x7FFFFFFF, 0, ROW_XA_CARDINAL, addr of LType, addr of LFormat, addr of LCount,
    addr of LAfter, addr of LData);
  println("icon type {} format {} words {}", LType, LFormat, LCount);
  if (LData <> nil) and (LCount >= 2) then
    // Format 32 items come back as C longs (8 bytes here), one value each
    LWords := ptr to uint64(LData);
    setlength(LPixels, int64(LCount - 2) * 4);
    for LI := 0 to int64(LCount) - 3 do
      LWord := LWords[2 + LI];
      LPixels[LI * 4] := uint8((LWord shr 16) & 255);
      LPixels[LI * 4 + 1] := uint8((LWord shr 8) & 255);
      LPixels[LI * 4 + 2] := uint8(LWord & 255);
      LPixels[LI * 4 + 3] := uint8((LWord shr 24) & 255);
    end;
    println("icon {} x {} crc {}", LWords[0], LWords[1], ZlibCRC32(0, LPixels));
  end;
  if LData <> nil then
    LFree(LData);
  end;
  LClose(LDisplay);
end;

begin
  SetTraceLogLevel(LOG_NONE);
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  InitWindow(64, 64, "linux_raylib_noicon");
  println("ready {}", IsWindowReady());
  if not IsWindowReady() then
    // InitWindow failed: raylib has let go already (no CloseWindow, AV.9)
    return 1;
  end;
  // One frame, so GLFW's requests (the icon's among them) reach the server
  BeginDrawing();
  ClearBackground(BLACK);
  EndDrawing();
  PrintIcon();
  CloseWindow();
  println("closed ready {}", IsWindowReady());
end.
