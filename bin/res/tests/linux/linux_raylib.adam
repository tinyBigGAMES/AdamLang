-------------------------------------------------------------------------------
  linux_raylib.adam - raylib 6.2 on both targets (PLAN-LINUX64 LX3d3a): the
  std unit System.Raylib.C (cimport of raylib.h, raymath.h, rlgl.h) over
  libraylib.a (AdamLang-Libs build-raylib.cmd), the same lines on
  x86_64-windows-gnu and x86_64-linux-gnu (the linux ELF run through RunElf):
  raymath's inline routines as Adam translates them (record literals from
  C's initializer lists, math.h through System.LibC.C: Vector2Add,
  Vector3Length, Vector3CrossProduct, Vector3ToFloatV's array field,
  MatrixTranslate + MatrixDecompose's local array of records), and
  libraylib.a's own routines that need no window: colors by value
  (ColorToInt, Fade), a collision test, a CPU image drawn and read back,
  raylib's seeded random numbers, TextLength
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | add 2 1
  | length 5
  | cross 0 0 1
  | floats 1 2 3
  | identity 1 1 1 1 0
  | decompose 1 2 3 scale 1 1 1
  | color -168430081 fade 127
  | collide true
  | image 4x4 pixel 230 41 55 255
  | random 23 31
  | text 4
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_raylib;

import System.SysUtils, System.Raylib.C;

var
  LSum: Vector2;
  LCross: Vector3;
  LFloats: float3;
  LIdentity: Matrix;
  LTranslation: Vector3;
  LRotation: Quaternion;
  LScale: Vector3;
  LImage: Image;
  LPixel: Color;
  LHit: bool;
begin
  SetTraceLogLevel(LOG_NONE);
  LSum := Vector2Add(Vector2(x: 1.5, y: 2.0), Vector2(x: 0.5, y: -1.0));
  println("add {} {}", LSum.x, LSum.y);
  println("length {}", Vector3Length(Vector3(x: 3.0, y: 4.0, z: 0.0)));
  LCross := Vector3CrossProduct(Vector3(x: 1.0, y: 0.0, z: 0.0), Vector3(x: 0.0, y: 1.0, z: 0.0));
  println("cross {} {} {}", LCross.x, LCross.y, LCross.z);
  LFloats := Vector3ToFloatV(Vector3(x: 1.0, y: 2.0, z: 3.0));
  println("floats {} {} {}", LFloats.v[0], LFloats.v[1], LFloats.v[2]);
  LIdentity := MatrixIdentity();
  println("identity {} {} {} {} {}", LIdentity.m0, LIdentity.m5, LIdentity.m10, LIdentity.m15, LIdentity.m1);
  MatrixDecompose(MatrixTranslate(1.0, 2.0, 3.0), addr of LTranslation, addr of LRotation, addr of LScale);
  println("decompose {} {} {} scale {} {} {}", LTranslation.x, LTranslation.y, LTranslation.z,
    LScale.x, LScale.y, LScale.z);
  println("color {} fade {}", ColorToInt(RAYWHITE), Fade(RED, 0.5).a);
  LHit := CheckCollisionRecs(Rectangle(x: 0.0, y: 0.0, width: 10.0, height: 10.0),
    Rectangle(x: 5.0, y: 5.0, width: 10.0, height: 10.0));
  println("collide {}", LHit);
  LImage := GenImageColor(4, 4, BLUE);
  ImageDrawPixel(addr of LImage, 1, 2, RED);
  LPixel := GetImageColor(LImage, 1, 2);
  println("image {}x{} pixel {} {} {} {}", LImage.width, LImage.height, LPixel.r, LPixel.g, LPixel.b, LPixel.a);
  UnloadImage(LImage);
  SetRandomSeed(42);
  println("random {} {}", GetRandomValue(1, 100), GetRandomValue(1, 100));
  println("text {}", TextLength("adam"));
end.
