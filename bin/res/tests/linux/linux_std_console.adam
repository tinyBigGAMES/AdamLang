-------------------------------------------------------------------------------
  linux_std_console.adam - System.Console the same on both targets with no
  terminal (PLAN-LINUX64 LX5b: System.Console.Linux64 beside
  System.Console.Win64; standard output a pipe, standard input NUL / a
  linux run's /dev/null): no terminal, no escapes, the 80 x 25 default
  size, ReadKey "", AnyKeyPressed false, the waits and Pause return at once,
  ReadLn ends at once (false, ""), WaitForEnter prints its prompt and gives
  false, the Key consts. Each line ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok no terminal
  | ok no escapes
  | ok size default
  | ok read key
  | ok key waiting
  | ok wait returns
  | ok read line
  |
  | Press ENTER to continue...
  | ok wait enter
  | ok key names
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_std_console;

import System.SysUtils, System.Console;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

func Run();
var
  LLine: string;
  LRead: bool;
begin
  Check("no terminal", not IsTerminal());
  Check("no escapes", not EscapesEnabled());
  Check("size default", (GetTerminalWidth() = 80) and (GetTerminalHeight() = 25));
  Check("read key", ReadKey() = "");
  Check("key waiting", not AnyKeyPressed());
  WaitForAnyKey();
  WaitForKey();
  WaitForKey("q");
  Pause();
  Pause(true);
  Check("wait returns", true);
  LLine := "old";
  LRead := ReadLn(LLine);
  Check("read line", not LRead and (LLine = ""));
  Check("wait enter", not WaitForEnter());
  Check("key names", IsEnterKey(KeyEnter) and IsEscapeKey(KeyEscape) and (KeyEnter = "\r") and
    (KeyBackspace = "\x08"));
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
