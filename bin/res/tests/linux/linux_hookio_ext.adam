-------------------------------------------------------------------------------
  linux_hookio_ext.adam - System.HookIO's stdio_ext, stream locks, fwide
  and fileno on x86_64-linux-gnu (PLAN-LINUX64 LX3d3c2b)

  fixtures\liblinux_hookio_c.a asks a registered memory IO and a real file
  of the same bytes, opened "r" then "r+", every stdio_ext question
  (__freading / __fwriting / __freadable / __fwritable / __flbf / __fbufsize
  before and after a fill / __fpending, __fsetlocking), puts a byte and
  purges it (__fpurge: nothing written), sets line buffering, takes the
  recursive stream lock (flockfile / ftrylockfile / funlockfile), and asks
  fwide: every slot of the IO's equals the real file's, fileno's too (a
  handle has a descriptor, LX3d3e0: std_hookio_fd_linux checks its calls).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ok ext register
  | ok ext real file
  | ok ext purged
  | ok ext as real file
  | ok ext fileno
  | ok ext nothing written
  | ok ext unregister
  | ok ext io close
  | ok ext real removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_hookio_ext;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_hookio_ext runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

@addlibrarypath "$P:res/tests/linux/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO, System.HookIO.Linux64;

func clink linux_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to uint8;
  ACount: clong): int32; external "linux_hookio_c";
func clink linux_hookio_c_sample(ABuffer: ptr to uint8; ACap: clong): clong;
  external "linux_hookio_c";
func clink linux_hookio_c_ext(APath: ptr to const char; AResults: ptr to int64);
  external "linux_hookio_c";

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst (the registered IO's) equal ASecond's (the real file's);
// the first that differs is printed
func SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
func RemovePath(const APath: string): bool;
var
  LOk: bool;
begin
  LOk := RemoveFile(APath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (glibc's own FILE)
func WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LResult: int32;
begin
  LResult := linux_hookio_c_writeraw(APath, ABytes, clong(ACount));
  return LResult = 0;
end;

// The C fixture's stdio_ext / locks / fwide run over APath: its 30 slots in AResults
func ExtC(const APath: string; const AResults: ptr to int64);
begin
  linux_hookio_c_ext(APath, AResults);
end;

// stdio_ext, the stream locks, fwide and fileno on a registered IO: each slot as glibc's own
// FILE gives it on a real file of the same bytes (fileno >= 0: a handle has a descriptor)
func TestExt();
var
  LSample: array[0..63] of uint8;
  LLength: clong;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..29] of int64;
  LReal: array[0..29] of int64;
begin
  LRealPath := paramstr(0) + ".ext.txt";
  LLength := linux_hookio_c_sample(addr of LSample[0], 64);
  LMemory := CreateMemoryIO(addr of LSample[0], int64(LLength), false);
  LPrefix := RegisterIO(LMemory);
  Check("ext register", LPrefix <> "");
  Check("ext real file", WriteRaw(LRealPath, addr of LSample[0], int64(LLength)));

  ExtC(LPrefix + "/e.txt", addr of LVirtual[0]);
  ExtC(LRealPath, addr of LReal[0]);
  Check("ext purged", (LVirtual[13] = 81) and (LVirtual[14] = 1) and (LVirtual[17] = 0) and
    (LVirtual[19] = int64(LSample[0])));
  Check("ext as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 28) and
    (LVirtual[29] = LReal[29]));
  Check("ext fileno", (LVirtual[28] = 1) and (LReal[28] = 1));
  Check("ext nothing written", (IOSize(LMemory) = int64(LLength)) and (LSample[0] = uint8('a')));

  Check("ext unregister", UnregisterIO(LPrefix));
  Check("ext io close", IOClose(LMemory));
  Check("ext real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestExt();
  println("done {}", GFails);
end.
