-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
  linux_std_process.adam - System.Process on x86_64-linux-gnu (PLAN-LINUX64
  LX5c: System.Process.Linux64 over posix_spawn, pipes, a pseudo terminal,
  waitpid), with /bin/sh as the program. System.Linux's spawn layouts as
  glibc's; RunProcess: stdout and stderr in the order written, the exit
  code, stdin /dev/null, the working folder, the environment as
  SetEnvironmentVariable left it, arguments passed as they are, a program a
  signal ended (128 + 9), a missing program and a bare name (no PATH
  search) false; RunAttached on this program's stdout after what it wrote
  (flushed first), its exit code; both RunPE forms false at once (no PE
  runs here: the host never asked); CanRunElf; RunElf with pipes: CR LF /
  CR / LF lines, the empty one kept, the last with no end, a line that is
  not UTF-8 read with U+FFFD; a host's StdInput as stdin (its end the end
  of input); a script with no execute bit made executable and run; RunElf
  with a terminal: the host's size, stdin and stdout a terminal that is
  the controlling one, keys typed at Start read, Resize answered, Start and
  Stop once; no host: stdin /dev/null, the default 120 x 30; a host that
  refuses: false, never started. Each line ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ok layouts
  | ok run process
  | ok stdin null
  | ok work dir
  | ok environment
  | ok arguments
  | ok signal
  | ok missing
  | ok no path search
  | before attached
  | attached
  | ok attached
  | ok runpe refused
  | ok runpe capture refused
  | ok can run elf
  | ok elf lines
  | ok elf decode
  | ok elf host input
  | ok elf made executable
  | ok terminal
  | ok terminal host
  | ok terminal no host
  | ok terminal refused
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_std_process;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_std_process runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

import System.SysUtils, System.IO, System.Process, System.Linux;

const
  // The program every run starts
  SH: string = "/bin/sh";

type
  // Every line handed over, in order
  Lines = object implements ProcessOutput
    Items: StringArray;

    virtual method Output(const AText: string);
    var
      LCount: int64;
    begin
      LCount := len(self.Items);
      setlength(self.Items, LCount + 1);
      self.Items[LCount] := AText;
    end;
  end;

  // A host: a 100 x 20 terminal, Keys typed at Start, Input as stdin (0: none), Refuse: refuses
  // to start; counts its starts and stops
  KeysHost = object implements ProcessHost
    Keys: string;
    Input: uint64;
    Refuse: bool;
    Starts: int32;
    Stops: int32;
    Typed: bool;
    Resized: bool;

    virtual method InitialSize(var ACols: int32; var ARows: int32): bool;
    begin
      ACols := 100;
      ARows := 20;
      return true;
    end;

    virtual method StdInput(): uint64;
    begin
      return self.Input;
    end;

    virtual method Start(const ATerminal: ref ProcessTerminal): bool;
    begin
      self.Starts := self.Starts + 1;
      if self.Refuse then
        return false;
      end;
      self.Resized := ATerminal.Resize(100, 20);
      if self.Keys <> "" then
        self.Typed := ATerminal.WriteKeys(self.Keys);
      end;
      return true;
    end;

    virtual method Stop();
    begin
      self.Stops := self.Stops + 1;
    end;
  end;

  // The terminal text handed over, joined
  Screen = object implements ProcessOutput
    Text: string;
    Chunks: int32;

    virtual method Output(const AText: string);
    begin
      self.Text := self.Text + AText;
      self.Chunks := self.Chunks + 1;
    end;
  end;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// sh's arguments running AScript
routine Shell(const AScript: string): StringArray;
var
  LArgs: StringArray;
begin
  setlength(LArgs, 2);
  LArgs[0] := "-c";
  LArgs[1] := AScript;
  return LArgs;
end;

// The lines handed over, each in brackets
routine Joined(const ALines: ref Lines): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  for LI := 0 to len(ALines.Items) - 1 do
    LText := LText + "[" + ALines.Items[LI] + "]";
  end;
  return LText;
end;

// Whether AScreen's text holds AText
routine Holds(const AScreen: ref Screen; const AText: string): bool;
begin
  return IndexOf(AText, AScreen.Text, 0) >= 0;
end;

// U+FFFD as UTF-8 text
routine Replacement(): string;
var
  LText: string;
  LAt: int64;
begin
  LText := "";
  setlength(LText, 4);
  LAt := 0;
  EncodeUtf8Char(LText, LAt, ADAM_SYSUTILS_REPLACEMENT);
  setlength(LText, LAt);
  return LText;
end;

routine Run();
var
  LOut: string;
  LExit: uint32;
  LOk: bool;
  LArgs: StringArray;
  LLines: ref Lines;
  LHost: ref KeysHost;
  LScreen: ref Screen;
  LPath: string;
  LText: ptr to char;
  LFile: int32;
begin
  Check("layouts", (size(sigset_t) = 128) and (size(posix_spawn_file_actions_t) = 80) and
    (size(posix_spawnattr_t) = 336));

  LOk := RunProcess(SH, Shell("echo out; echo err >&2; printf 'x\\ny'; exit 5"), "", LOut, LExit);
  Check("run process", LOk and (LExit = 5) and (LOut = "out\nerr\nx\ny"));
  LOk := RunProcess(SH, Shell("cat; echo end"), "", LOut, LExit);
  Check("stdin null", LOk and (LExit = 0) and (LOut = "end\n"));
  LOk := RunProcess(SH, Shell("pwd"), "/tmp", LOut, LExit);
  Check("work dir", LOk and (LExit = 0) and (LOut = "/tmp\n"));
  SetEnvironmentVariable("ADAM_LX5C_SEEN", "yes");
  LOk := RunProcess(SH, Shell("echo \"$ADAM_LX5C_SEEN\""), "", LOut, LExit);
  Check("environment", LOk and (LExit = 0) and (LOut = "yes\n"));
  setlength(LArgs, 5);
  LArgs[0] := "-c";
  LArgs[1] := "printf '[%s]' \"$1\" \"$2\"";
  LArgs[2] := "sh";
  LArgs[3] := "a b";
  LArgs[4] := "c\"d";
  LOk := RunProcess(SH, LArgs, "", LOut, LExit);
  Check("arguments", LOk and (LExit = 0) and (LOut = "[a b][c\"d]"));
  LOk := RunProcess(SH, Shell("kill -9 $$"), "", LOut, LExit);
  Check("signal", LOk and (LExit = 137));
  LExit := 9;
  LOk := RunProcess("/no/such/program", Shell("exit 0"), "", LOut, LExit);
  Check("missing", (not LOk) and (LExit = 0));
  LOk := RunProcess("sh", Shell("exit 0"), "", LOut, LExit);
  Check("no path search", not LOk);

  println("before attached");
  LOk := RunAttached(SH, Shell("echo attached; exit 4"), "", LExit);
  Check("attached", LOk and (LExit = 4));

  LExit := 9;
  LOk := RunPE(SH, Shell("exit 0"), "", true, LExit);
  Check("runpe refused", (not LOk) and (LExit = 0));
  LHost := ref KeysHost();
  LLines := ref Lines();
  LExit := 9;
  LOk := RunPE(SH, Shell("exit 0"), "", LExit, LLines, ProcessCapture.Pipes, LHost);
  Check("runpe capture refused", (not LOk) and (LExit = 0) and (len(LLines.Items) = 0) and
    (LHost.Starts = 0) and (LHost.Stops = 0));
  Check("can run elf", CanRunElf());

  LLines := ref Lines();
  LOk := RunElf(SH, Shell("printf 'one\\r\\ntwo\\rthree\\n\\nfour'; exit 3"), "", LExit, LLines,
    ProcessCapture.Pipes, nil);
  Check("elf lines", LOk and (LExit = 3) and (Joined(LLines) = "[one][two][three][][four]"));
  LLines := ref Lines();
  LOk := RunElf(SH, Shell("printf '\\377ok\\n'"), "", LExit, LLines, ProcessCapture.Pipes, nil);
  Check("elf decode", LOk and (LExit = 0) and (len(LLines.Items) = 1) and
    (LLines.Items[0] = Replacement() + "ok"));

  LPath := TempDir() + "/adam_lx5c_input.txt";
  LFile := -1;
  if WriteAllText(LPath, "alpha\nbeta\n") then
    LText := StringToC(LPath);
    LFile := open(LText, O_RDONLY);
    freemem(LText);
  end;
  LHost := ref KeysHost();
  LHost.Input := uint64(LFile);
  LLines := ref Lines();
  LOk := (LFile >= 0) and RunElf(SH, Shell("while read L; do echo \"in: $L\"; done"), "", LExit,
    LLines, ProcessCapture.Pipes, LHost);
  if LFile >= 0 then
    close(LFile);
  end;
  DeleteFile(LPath);
  Check("elf host input", LOk and (LExit = 0) and (Joined(LLines) = "[in: alpha][in: beta]") and
    (LHost.Starts = 0) and (LHost.Stops = 0));

  LPath := TempDir() + "/adam_lx5c_script";
  LLines := ref Lines();
  setlength(LArgs, 0);
  LOk := WriteAllText(LPath, "#!/bin/sh\necho script ran\nexit 6\n") and
    RunElf(LPath, LArgs, "", LExit, LLines, ProcessCapture.Pipes, nil);
  DeleteFile(LPath);
  Check("elf made executable", LOk and (LExit = 6) and (Joined(LLines) = "[script ran]"));

  LHost := ref KeysHost();
  LHost.Keys := "abc\r";
  LScreen := ref Screen();
  LOk := RunElf(SH, Shell("stty size; [ -t 0 ] && [ -t 1 ] && echo tty; (exec 3</dev/tty) && " +
    "echo ctty; read L; echo \"got [$L]\""), "", LExit, LScreen, ProcessCapture.Terminal, LHost);
  Check("terminal", LOk and (LExit = 0) and Holds(LScreen, "20 100\r\n") and
    Holds(LScreen, "\ntty\r\n") and Holds(LScreen, "ctty\r\n") and Holds(LScreen, "got [abc]"));
  Check("terminal host", (LHost.Starts = 1) and (LHost.Stops = 1) and LHost.Typed and
    LHost.Resized);

  LScreen := ref Screen();
  LOk := RunElf(SH, Shell("read L; echo \"got [$L] $?\"; [ -t 1 ] && echo out-tty; " +
    "stty size </dev/tty; exit 7"), "", LExit, LScreen, ProcessCapture.Terminal, nil);
  Check("terminal no host", LOk and (LExit = 7) and Holds(LScreen, "got [] 1") and
    Holds(LScreen, "out-tty") and Holds(LScreen, "30 120"));

  LHost := ref KeysHost();
  LHost.Refuse := true;
  LScreen := ref Screen();
  LExit := 9;
  LOk := RunElf(SH, Shell("echo never"), "", LExit, LScreen, ProcessCapture.Terminal, LHost);
  Check("terminal refused", (not LOk) and (LExit = 0) and (LScreen.Chunks = 0) and
    (LHost.Starts = 1) and (LHost.Stops = 0));
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
