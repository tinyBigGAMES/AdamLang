  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  linux_sysv_records.adam - records by value through x86_64-linux-gnu's
  ABI part (Adam.SysV.Abi, imported from the compiler's own src\, beside
  bin\): the eightbyte classes (INTEGER, SSE, both in one record, a short
  last eightbyte), MEMORY past 16 bytes or with an unaligned field (copied
  to the stack, a 16-aligned one at a 16-aligned place), a record whose
  eightbytes do not all fit the registers left going to the stack while a
  later scalar still takes one, and results: in rax / rdx / xmm0 / xmm1,
  the place not passed, or a MEMORY one's place in rdi (PLAN-LINUX64 LX1a2)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | (ptr[16 align 8: i 0+16]): void
  | arg 0 pieces rdi@0+8 rsi@8+8
  | result none
  | outgoing 0
  | (ptr[16 align 8: f 0+16]): void
  | arg 0 pieces xmm0@0+8 xmm1@8+8
  | result none
  | outgoing 0
  | (ptr[8 align 4: i 0+4, f 4+4]): void
  | arg 0 pieces rdi@0+8
  | result none
  | outgoing 0
  | (ptr[12 align 4: f 0+12]): void
  | arg 0 pieces xmm0@0+8 xmm1@8+4
  | result none
  | outgoing 0
  | (ptr[20 align 4: i 0+20]): void
  | arg 0 stack call +0 entry +8 bytes 20
  | result none
  | outgoing 24
  | (ptr[3 align 1: i 0+3]): void
  | arg 0 pieces rdi@0+3
  | result none
  | outgoing 0
  | (ptr[16 align 8: f 0+8, i 8+8]): void
  | arg 0 pieces xmm0@0+8 rdi@8+8
  | result none
  | outgoing 0
  | arg 0 rdi
  | arg 1 rsi
  | arg 2 rdx
  | arg 3 rcx
  | arg 4 r8
  | arg 5 stack call +0 entry +8 bytes 16
  | arg 6 r9
  | result none
  | outgoing 16
  | (ptr[5 align 1 packed: i 0+5]): void
  | arg 0 stack call +0 entry +8 bytes 5
  | result none
  | outgoing 8
  | (result ptr[16 align 8: i 0+16], int64): ptr
  | arg 0 none
  | arg 1 rdi
  | result pieces rax@0+8 rdx@8+8
  | outgoing 0
  | arg 0 rdi
  | arg 1 rsi
  | result rax
  | outgoing 0
  | arg 0 none
  | result pieces xmm0@0+8 rax@8+8
  | outgoing 0
  | arg 0 rdi
  | arg 1 rsi
  | arg 2 rdx
  | arg 3 rcx
  | arg 4 r8
  | arg 5 r9
  | arg 6 stack call +0 entry +8
  | arg 7 stack call +16 entry +24 bytes 32
  | result none
  | outgoing 48
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_sysv_records;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Backend.Ssa, Adam.Backend.Parts, Adam.SysV.Abi;

// An aggregate of ASize bytes aligned to AAlign, its leaves ALeaves' triples (offset,
// bytes, 1 for a float's), each aligned to its own bytes
routine Aggregate(const ASize: int64; const AAlign: int64; const ALeaves: array of int64): ref IrAggregate;
var
  LShape: ref IrAggregate;
  LI: int64;
begin
  LShape := ref IrAggregate(ASize, AAlign);
  LI := 0;
  while LI < len(ALeaves) do
    LShape.AddLeaf(ALeaves[LI], ALeaves[LI + 1], ALeaves[LI + 1], ALeaves[LI + 2] = 1);
    LI := LI + 3;
  end;
  return LShape;
end;

// A signature of AResult: AShaped's aggregates first (each a shaped parameter), then the
// scalars ATypes; with APlace the first aggregate is the result's place
routine Signature(const AResult: IrType; const APlace: bool; const AShaped: array of ref IrAggregate;
  const ATypes: array of IrType): ref IrSignature;
var
  LSignature: ref IrSignature;
  LI: int64;
begin
  LSignature := ref IrSignature(AResult);
  LSignature.ResultPlace := APlace;
  for LI := 0 to len(AShaped) - 1 do
    LSignature.AddShapedParam(AShaped[LI]);
  end;
  for LI := 0 to len(ATypes) - 1 do
    LSignature.AddParam(ATypes[LI]);
  end;
  return LSignature;
end;

// A void signature of AScalars int64 parameters, an aggregate of AShape, then ATail more
routine Mixed(const AScalars: int64; const AShape: ref IrAggregate; const ATail: int64): ref IrSignature;
var
  LSignature: ref IrSignature;
  LI: int64;
begin
  LSignature := ref IrSignature(IrType.Void);
  for LI := 1 to AScalars do
    LSignature.AddParam(IrType.Int64);
  end;
  LSignature.AddShapedParam(AShape);
  for LI := 1 to ATail do
    LSignature.AddParam(IrType.Int64);
  end;
  return LSignature;
end;

// The signature's text, then its layout
routine Show(const AAbi: ref SysVAbi; const ASignature: ref IrSignature; const AText: bool);
begin
  if AText then
    println(ASignature.Text());
  end;
  print(AAbi.LayoutCall(ASignature).Text());
end;

var
  GAbi: ref SysVAbi;

begin
  GAbi := ref SysVAbi();
  // INTEGER, SSE, both in one eightbyte (INTEGER wins), SSE with a short last eightbyte
  Show(GAbi, Signature(IrType.Void, false, [Aggregate(16, 8, [0, 8, 0, 8, 8, 0])], []), true);
  Show(GAbi, Signature(IrType.Void, false, [Aggregate(16, 8, [0, 8, 1, 8, 8, 1])], []), true);
  Show(GAbi, Signature(IrType.Void, false, [Aggregate(8, 4, [0, 4, 0, 4, 4, 1])], []), true);
  Show(GAbi, Signature(IrType.Void, false, [Aggregate(12, 4, [0, 4, 1, 4, 4, 1, 8, 4, 1])], []), true);
  // MEMORY past 16 bytes; a 3-byte INTEGER; SSE then INTEGER
  Show(GAbi, Signature(IrType.Void, false, [Aggregate(20, 4, [0, 4, 0, 4, 4, 0, 8, 4, 0, 12, 4, 0,
    16, 4, 0])], []), true);
  Show(GAbi, Signature(IrType.Void, false, [Aggregate(3, 1, [0, 1, 0, 1, 1, 0, 2, 1, 0])], []), true);
  Show(GAbi, Signature(IrType.Void, false, [Aggregate(16, 8, [0, 8, 1, 8, 8, 0])], []), true);
  // one integer register left: the record to the stack, the next scalar in r9
  Show(GAbi, Mixed(5, Aggregate(16, 8, [0, 8, 0, 8, 8, 0]), 1), false);
  // an unaligned field: MEMORY
  Show(GAbi, Signature(IrType.Void, false, [Aggregate(5, 1, [0, 1, 0, 1, 4, 0])], []), true);
  // results: in rax / rdx (the place not passed), a MEMORY one's place in rdi, SSE + INTEGER
  Show(GAbi, Signature(IrType.Pointer, true, [Aggregate(16, 8, [0, 8, 0, 8, 8, 0])], [IrType.Int64]), true);
  Show(GAbi, Signature(IrType.Pointer, true, [Aggregate(24, 8, [0, 8, 0, 8, 8, 0, 16, 8, 0])],
    [IrType.Int64]), false);
  Show(GAbi, Signature(IrType.Pointer, true, [Aggregate(16, 8, [0, 8, 1, 8, 8, 0])], []), false);
  // a 16-aligned MEMORY record after a stacked scalar: its place rounded to 16
  Show(GAbi, Mixed(7, Aggregate(32, 16, [0, 8, 0, 8, 8, 0, 16, 8, 0, 24, 8, 0]), 0), false);
end.
