-------------------------------------------------------------------------------
  linux_sysv_layout.adam - x86_64-linux-gnu's ABI part (Adam.SysV.Abi,
  imported from the compiler's own src\, beside bin\): its facts, where
  each argument and result of a call goes (integers and floats counted
  apart, the stack past six / eight, no home area, no integer copy of a
  variadic float) and five frames (none, a caller with nothing else to
  keep, plain, realigned, probed)
  (PLAN-LINUX64 LX1a1)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | abi sysv align 16 page 4096 frame rbp
  | saved rbx rbp r12 r13 r14 r15
  | volatile rax rcx rdx rsi rdi r8 r9 r10 r11 xmm0 xmm1 xmm2 xmm3 xmm4 xmm5 xmm6 xmm7 xmm8 xmm9 xmm10 xmm11 xmm12 xmm13 xmm14 xmm15
  | probe rax r10 r11
  | archives 0 libraries c atexit stat fstat lstat stat64 fstat64 lstat64=PlatformCAtExit PlatformCStat PlatformCFstat PlatformCLstat PlatformCStat PlatformCFstat PlatformCLstat
  | tls fs true
  | arg 0 rdi
  | arg 1 xmm0
  | arg 2 rsi
  | arg 3 xmm1
  | arg 4 rdx
  | result rax
  | outgoing 0
  | arg 0 rdi
  | arg 1 rsi
  | arg 2 rdx
  | arg 3 rcx
  | arg 4 r8
  | arg 5 r9
  | arg 6 stack call +0 entry +8
  | arg 7 xmm0
  | arg 8 xmm1
  | arg 9 xmm2
  | arg 10 xmm3
  | arg 11 xmm4
  | arg 12 xmm5
  | arg 13 xmm6
  | arg 14 xmm7
  | arg 15 stack call +8 entry +16
  | result xmm0
  | outgoing 16
  | result none
  | outgoing 0
  | arg 0 rdi
  | arg 1 xmm0
  | arg 2 rsi
  | result rax
  | outgoing 0
  | vectors rax 1
  | alloc 0 outgoing 0 locals +0 0 saved +0 0 return +0 entry +0
  | alloc 8 outgoing 0 locals +0 0 saved +8 0 return +8 entry +8
  | alloc 72 outgoing 32 locals +32 40 saved +72 2 return +88 entry +88
  | alloc 64 outgoing 0 locals +0 64 saved +64 1 return +72 entry +72 realign 32 over rbp
  | alloc 8200 outgoing 0 locals +0 8192 saved +8200 0 return +8200 entry +8200 probe 8200
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_sysv_layout;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Backend.Ssa, Adam.Backend.Parts, Adam.SysV.Abi;

// A signature of AResult with the parameters ATypes, variadic when AVariadic
routine Signature(const AResult: IrType; const ATypes: array of IrType;
  const AVariadic: bool): ref IrSignature;
var
  LSignature: ref IrSignature;
  LI: int64;
begin
  LSignature := ref IrSignature(AResult);
  for LI := 0 to len(ATypes) - 1 do
    LSignature.AddParam(ATypes[LI]);
  end;
  LSignature.Variadic := AVariadic;
  return LSignature;
end;

var
  GAbi: ref SysVAbi;
  GFacts: ref CRuntimeFacts;
  GLocal: ref ThreadLocalFacts;

begin
  GAbi := ref SysVAbi();
  println("abi " + GAbi.AbiName() + " align " + IntToStr(GAbi.StackAlign()) + " page " +
    IntToStr(GAbi.PageBytes()) + " frame " + GAbi.FrameRegister());
  println("saved " + JoinStrings(GAbi.CalleeSaved(), " "));
  println("volatile " + JoinStrings(GAbi.Volatile(), " "));
  println("probe " + JoinStrings(GAbi.ProbeScratch(), " "));
  GFacts := GAbi.CRuntime();
  println("archives " + IntToStr(len(GFacts.Archives)) + " libraries " +
    JoinStrings(GFacts.LibraryNames, " ") + " " + JoinStrings(GFacts.CNames, " ") + "=" +
    JoinStrings(GFacts.StandIns, " "));
  GLocal := GAbi.ThreadLocal();
  println("tls " + GLocal.ThreadRegister + " " + BoolToStr(GLocal.Form = ThreadLocalForm.ThreadPointer));
  // each kind counted on its own
  print(GAbi.LayoutCall(Signature(IrType.Int32, [IrType.Int32, IrType.Float64, IrType.Pointer,
    IrType.Float32, IrType.Int64], false)).Text());
  // past six integers and eight floats: the stack, in order
  print(GAbi.LayoutCall(Signature(IrType.Float64, [IrType.Int64, IrType.Int64, IrType.Int64,
    IrType.Int64, IrType.Int64, IrType.Int64, IrType.Int64, IrType.Float64, IrType.Float64,
    IrType.Float64, IrType.Float64, IrType.Float64, IrType.Float64, IrType.Float64,
    IrType.Float64, IrType.Float64], false)).Text());
  print(GAbi.LayoutCall(Signature(IrType.Void, [], false)).Text());
  // a variadic call: no integer copy of a float
  print(GAbi.LayoutCall(Signature(IrType.Int32, [IrType.Pointer, IrType.Float64, IrType.Int32],
    true)).Text());
  println(GAbi.LayoutFrame(0, 0, 0, 0, 0, false).Text());
  // a caller with nothing else to keep still aligns the stack for its calls (no home area)
  println(GAbi.LayoutFrame(0, 0, 0, 0, 0, true).Text());
  println(GAbi.LayoutFrame(40, 8, 24, 2, 0, true).Text());
  println(GAbi.LayoutFrame(64, 32, 0, 1, 0, false).Text());
  println(GAbi.LayoutFrame(8192, 16, 0, 0, 0, false).Text());
end.
