-------------------------------------------------------------------------------
  linux_sysv_stat64.adam - C's stat64 / fstat64 / lstat64 on
  x86_64-linux-gnu: glibc exports them only from 2.33 (below: __xstat64 and
  kin through libc_nonshared.a, which an Adam image does not carry), so the
  link binds them to the runtime's stand-ins (PlatformCStat / CFstat /
  CLstat, Adam.SysV.Abi), as stat / fstat / lstat are; a large-file C
  library (libxml2) calls these names. A file's kind and size, an open
  descriptor's, a link's own kind (lstat64) and its target's (stat64), a
  missing path's -1
  (PLAN-XML X1b)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ok file written
  | ok stat64
  | ok stat64 regular
  | stat64 size 21
  | ok open
  | ok fstat64
  | fstat64 size 21
  | ok close
  | ok symlink
  | ok lstat64 link
  | ok stat64 through link
  | ok stat64 missing
  | ok link removed
  | ok file removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_sysv_stat64;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_sysv_stat64 runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

import System.SysUtils, System.IO, System.Linux;

// C's large-file names as a C library calls them (libxml2's stat64): glibc exports none of
// them below 2.33, so the link binds them to the runtime's stand-ins (Adam.SysV.Abi)
func clink stat64(const APath: ptr to const char; var AStat: stat): int32; external "c";
func clink fstat64(const AFile: int32; var AStat: stat): int32; external "c";
func clink lstat64(const APath: ptr to const char; var AStat: stat): int32; external "c";

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// A 21-byte file and a link to it, each asked through the three names, then removed
func TestStat64();
var
  LFile: string;
  LLink: string;
  LMissing: string;
  LStat: stat;
  LFd: int32;
begin
  LFile := ExeDir() + "/linux_sysv_stat64.txt";
  LLink := ExeDir() + "/linux_sysv_stat64.lnk";
  Check("file written", WriteAllText(LFile, "stat64 sees 21 bytes."));
  LMissing := LFile + ".missing";

  Check("stat64", stat64(LFile, LStat) = 0);
  Check("stat64 regular", (LStat.st_mode & S_IFMT) = S_IFREG);
  println("stat64 size {}", LStat.st_size);

  LFd := open(LFile, O_RDONLY);
  Check("open", LFd >= 0);
  Check("fstat64", fstat64(LFd, LStat) = 0);
  println("fstat64 size {}", LStat.st_size);
  Check("close", close(LFd) = 0);

  // lstat64 sees the link itself, stat64 follows it to the file
  Check("symlink", symlink(LFile, LLink) = 0);
  Check("lstat64 link", (lstat64(LLink, LStat) = 0) and ((LStat.st_mode & S_IFMT) = S_IFLNK));
  Check("stat64 through link", (stat64(LLink, LStat) = 0) and
    ((LStat.st_mode & S_IFMT) = S_IFREG) and (LStat.st_size = 21));
  Check("stat64 missing", stat64(LMissing, LStat) = -1);

  Check("link removed", DeleteFile(LLink));
  Check("file removed", DeleteFile(LFile));
end;

begin
  GFails := 0;
  TestStat64();
  println("done {}", GFails);
end.
