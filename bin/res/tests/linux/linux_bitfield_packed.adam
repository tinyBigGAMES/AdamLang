-------------------------------------------------------------------------------
  linux_bitfield_packed.adam - bitfields of records under a pack limit on
  x86_64-linux-gnu (System V, BitfieldRule.Itanium: Adam.Compiler.Layout,
  PLAN-LINUX64 LX0b), checked against clang's (fixtures\
  liblinux_bitfield_packed_c.a, the same records in C): a packed bitfield
  takes the next free bit, its bits may pass its type's width (P2's b at
  bits 3..33, P3's at 7..70, nine bytes, P4's b past short's width) and
  its storage is the bytes its bits span, never its type's whole unit (P5
  is two bytes: an int unit at byte 1 would pass its end); packed(2) the
  same (Q3); with no pack limit a bitfield crossing its type's width from
  its unit's start goes on to the next unit (N2). Per record: C's record
  read here, a record made here (a literal) read by C, a field written
  here into C's record (its neighbour kept), a global's constant bytes
  read by C, and the sizes; every record passes and returns by value (a
  bitfield's span is an integer leaf: in registers, never MEMORY).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | P1 c -7 -1000000000
  | P1 adam 5 1073741823
  | P1 write -7 -1073741824
  | P1 global -128 77
  | P1 size 5 501
  | P2 c -3 987654321
  | P2 adam 3 -1073741824
  | P2 write -3 -1
  | P2 global -4 1073741823
  | P2 size 5 501
  | P3 c -50 -1311768467463790320
  | P3 adam 63 9223372036854775807
  | P3 write -50 -2
  | P3 global -64 -9223372036854775808
  | P3 size 9 901
  | P5 c -100 13
  | P5 adam 127 15
  | P5 write -100 6
  | P5 global 1 9
  | P5 size 2 201
  | Q3 c 2 -555555555
  | Q3 adam -4 1
  | Q3 write 2 1073741823
  | Q3 global 1 -2
  | Q3 size 6 602
  | N2 c -1 123456789
  | N2 adam 3 -7
  | N2 write -1 -1073741824
  | N2 global -2 99
  | N2 size 8 804
  | P4 c -9 -3000 77
  | P4 adam 15 -4096 -1
  | P4 write -16 4095 77
  | P4 global -16 4095 -128
  | P4 size 4 401
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_bitfield_packed;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_bitfield_packed runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

@addlibrarypath "$P:res/tests/linux/fixtures";

import System.SysUtils;

type
  P1 = record packed
    a: int8;
    b: int32 : 31;
  end;

  P2 = record packed
    a: int8 : 3;
    b: int32 : 31;
  end;

  P3 = record packed
    a: int8 : 7;
    b: int64 : 64;
  end;

  P5 = record packed
    a: int8;
    b: uint32 : 4;
  end;

  Q3 = record packed(2)
    a: int8 : 3;
    b: int32 : 31;
  end;

  N2 = record
    a: int8 : 3;
    b: int32 : 31;
  end;

  P4 = record packed
    a: int8 : 5;
    b: int16 : 13;
    c: int8;
  end;

func clink lx0b_P1_make(a: int64; b: int64): P1; external "linux_bitfield_packed_c";
func clink lx0b_P1_a(s: P1): int64; external "linux_bitfield_packed_c";
func clink lx0b_P1_b(s: P1): int64; external "linux_bitfield_packed_c";
func clink lx0b_P1_size(): int64; external "linux_bitfield_packed_c";
func clink lx0b_P2_make(a: int64; b: int64): P2; external "linux_bitfield_packed_c";
func clink lx0b_P2_a(s: P2): int64; external "linux_bitfield_packed_c";
func clink lx0b_P2_b(s: P2): int64; external "linux_bitfield_packed_c";
func clink lx0b_P2_size(): int64; external "linux_bitfield_packed_c";
func clink lx0b_P3_make(a: int64; b: int64): P3; external "linux_bitfield_packed_c";
func clink lx0b_P3_a(s: P3): int64; external "linux_bitfield_packed_c";
func clink lx0b_P3_b(s: P3): int64; external "linux_bitfield_packed_c";
func clink lx0b_P3_size(): int64; external "linux_bitfield_packed_c";
func clink lx0b_P5_make(a: int64; b: int64): P5; external "linux_bitfield_packed_c";
func clink lx0b_P5_a(s: P5): int64; external "linux_bitfield_packed_c";
func clink lx0b_P5_b(s: P5): int64; external "linux_bitfield_packed_c";
func clink lx0b_P5_size(): int64; external "linux_bitfield_packed_c";
func clink lx0b_Q3_make(a: int64; b: int64): Q3; external "linux_bitfield_packed_c";
func clink lx0b_Q3_a(s: Q3): int64; external "linux_bitfield_packed_c";
func clink lx0b_Q3_b(s: Q3): int64; external "linux_bitfield_packed_c";
func clink lx0b_Q3_size(): int64; external "linux_bitfield_packed_c";
func clink lx0b_N2_make(a: int64; b: int64): N2; external "linux_bitfield_packed_c";
func clink lx0b_N2_a(s: N2): int64; external "linux_bitfield_packed_c";
func clink lx0b_N2_b(s: N2): int64; external "linux_bitfield_packed_c";
func clink lx0b_N2_size(): int64; external "linux_bitfield_packed_c";
func clink lx0b_P4_make(a: int64; b: int64): P4; external "linux_bitfield_packed_c";
func clink lx0b_P4_a(s: P4): int64; external "linux_bitfield_packed_c";
func clink lx0b_P4_b(s: P4): int64; external "linux_bitfield_packed_c";
func clink lx0b_P4_size(): int64; external "linux_bitfield_packed_c";
func clink lx0b_P4_c(s: P4): int64; external "linux_bitfield_packed_c";
func clink lx0b_P4_make3(a: int64; b: int64; c: int64): P4; external "linux_bitfield_packed_c";

var
  GP1: P1 = P1(a: -128, b: 77);
  GP2: P2 = P2(a: -4, b: 1073741823);
  GP3: P3 = P3(a: -64, b: -9223372036854775807 - 1);
  GP5: P5 = P5(a: 1, b: 9);
  GQ3: Q3 = Q3(a: 1, b: -2);
  GN2: N2 = N2(a: -2, b: 99);
  GP4: P4 = P4(a: -16, b: 4095, c: -128);

// P1: C's record read here, one made here read by C, b written into C's (a kept), the
// global's constant bytes read by C, the sizes (Adam's, C's size * 100 + alignment)
func CheckP1();
var
  LC: P1;
  LAdam: P1;
begin
  LC := lx0b_P1_make(-7, -1000000000);
  println("P1 c {} {}", LC.a, LC.b);
  LAdam := P1(a: 5, b: 1073741823);
  println("P1 adam {} {}", lx0b_P1_a(LAdam), lx0b_P1_b(LAdam));
  LC.b := -1073741824;
  println("P1 write {} {}", lx0b_P1_a(LC), lx0b_P1_b(LC));
  println("P1 global {} {}", lx0b_P1_a(GP1), lx0b_P1_b(GP1));
  println("P1 size {} {}", size(P1), lx0b_P1_size());
end;

// P2: C's record read here, one made here read by C, b written into C's (a kept), the
// global's constant bytes read by C, the sizes (Adam's, C's size * 100 + alignment)
func CheckP2();
var
  LC: P2;
  LAdam: P2;
begin
  LC := lx0b_P2_make(-3, 987654321);
  println("P2 c {} {}", LC.a, LC.b);
  LAdam := P2(a: 3, b: -1073741824);
  println("P2 adam {} {}", lx0b_P2_a(LAdam), lx0b_P2_b(LAdam));
  LC.b := -1;
  println("P2 write {} {}", lx0b_P2_a(LC), lx0b_P2_b(LC));
  println("P2 global {} {}", lx0b_P2_a(GP2), lx0b_P2_b(GP2));
  println("P2 size {} {}", size(P2), lx0b_P2_size());
end;

// P3: C's record read here, one made here read by C, b written into C's (a kept), the
// global's constant bytes read by C, the sizes (Adam's, C's size * 100 + alignment)
func CheckP3();
var
  LC: P3;
  LAdam: P3;
begin
  LC := lx0b_P3_make(-50, -1311768467463790320);
  println("P3 c {} {}", LC.a, LC.b);
  LAdam := P3(a: 63, b: 9223372036854775807);
  println("P3 adam {} {}", lx0b_P3_a(LAdam), lx0b_P3_b(LAdam));
  LC.b := -2;
  println("P3 write {} {}", lx0b_P3_a(LC), lx0b_P3_b(LC));
  println("P3 global {} {}", lx0b_P3_a(GP3), lx0b_P3_b(GP3));
  println("P3 size {} {}", size(P3), lx0b_P3_size());
end;

// P5: C's record read here, one made here read by C, b written into C's (a kept), the
// global's constant bytes read by C, the sizes (Adam's, C's size * 100 + alignment)
func CheckP5();
var
  LC: P5;
  LAdam: P5;
begin
  LC := lx0b_P5_make(-100, 13);
  println("P5 c {} {}", LC.a, LC.b);
  LAdam := P5(a: 127, b: 15);
  println("P5 adam {} {}", lx0b_P5_a(LAdam), lx0b_P5_b(LAdam));
  LC.b := 6;
  println("P5 write {} {}", lx0b_P5_a(LC), lx0b_P5_b(LC));
  println("P5 global {} {}", lx0b_P5_a(GP5), lx0b_P5_b(GP5));
  println("P5 size {} {}", size(P5), lx0b_P5_size());
end;

// Q3: C's record read here, one made here read by C, b written into C's (a kept), the
// global's constant bytes read by C, the sizes (Adam's, C's size * 100 + alignment)
func CheckQ3();
var
  LC: Q3;
  LAdam: Q3;
begin
  LC := lx0b_Q3_make(2, -555555555);
  println("Q3 c {} {}", LC.a, LC.b);
  LAdam := Q3(a: -4, b: 1);
  println("Q3 adam {} {}", lx0b_Q3_a(LAdam), lx0b_Q3_b(LAdam));
  LC.b := 1073741823;
  println("Q3 write {} {}", lx0b_Q3_a(LC), lx0b_Q3_b(LC));
  println("Q3 global {} {}", lx0b_Q3_a(GQ3), lx0b_Q3_b(GQ3));
  println("Q3 size {} {}", size(Q3), lx0b_Q3_size());
end;

// N2: C's record read here, one made here read by C, b written into C's (a kept), the
// global's constant bytes read by C, the sizes (Adam's, C's size * 100 + alignment)
func CheckN2();
var
  LC: N2;
  LAdam: N2;
begin
  LC := lx0b_N2_make(-1, 123456789);
  println("N2 c {} {}", LC.a, LC.b);
  LAdam := N2(a: 3, b: -7);
  println("N2 adam {} {}", lx0b_N2_a(LAdam), lx0b_N2_b(LAdam));
  LC.b := -1073741824;
  println("N2 write {} {}", lx0b_N2_a(LC), lx0b_N2_b(LC));
  println("N2 global {} {}", lx0b_N2_a(GN2), lx0b_N2_b(GN2));
  println("N2 size {} {}", size(N2), lx0b_N2_size());
end;

// P4: three fields, b past short's width between a and c (each write keeps the others)
func CheckP4();
var
  LC: P4;
  LAdam: P4;
begin
  LC := lx0b_P4_make3(-9, -3000, 77);
  println("P4 c {} {} {}", LC.a, LC.b, LC.c);
  LAdam := P4(a: 15, b: -4096, c: -1);
  println("P4 adam {} {} {}", lx0b_P4_a(LAdam), lx0b_P4_b(LAdam), lx0b_P4_c(LAdam));
  LC.b := 4095;
  LC.a := -16;
  println("P4 write {} {} {}", lx0b_P4_a(LC), lx0b_P4_b(LC), lx0b_P4_c(LC));
  println("P4 global {} {} {}", lx0b_P4_a(GP4), lx0b_P4_b(GP4), lx0b_P4_c(GP4));
  println("P4 size {} {}", size(P4), lx0b_P4_size());
end;

begin
  CheckP1();
  CheckP2();
  CheckP3();
  CheckP5();
  CheckQ3();
  CheckN2();
  CheckP4();
end.
