-------------------------------------------------------------------------------
  linux_elf_tls.adam - a C object's thread-locals relaxed to local-exec in an
  x86_64-linux-gnu exe (Adam.ELF.Foreign's TLS relaxations, PLAN-LINUX64
  LX3d2): fixtures\liblx3d2.a (scripts\linux\lx3d2_fixture.sh: gcc -fPIC, one
  __thread variable per model: global-dynamic, local-dynamic (two, through
  DTPOFF32), initial-exec, a .tbss one) linked under a main that calls
  lx3d2_check, prints "lx3d2 ok" (puts: a dynamic exe, entered through
  Adam's _start) and returns the result xor 31 (0 when every variable read
  and wrote right). The image's TLS segment and its imports (no __tls_get_addr:
  every call of it relaxed away), then written beside the program
  (lx3d2_tls) and run on linux through System.Process's RunELF (WSL on
  win64): exit 0. The report: fixtures\liblx3d2bad.a's TLSGD with no call
  after it (EF0004)
*******************************************************************************/

/*
@@test
  kind run
  runs x86_64-linux-gnu
  args "<BIN>/res/tests/linux/fixtures" "<BIN>/res/libs/vendor/x86_64-linux-gnu" "<BIN>/res/libs/system/x86_64-linux-gnu"
  exitcode 0
  | linked: needs libc.so.6
  | tls segment filesz 0x1C memsz 0x1C align 0x8
  | dynsym 'puts'
  | dynsym '__libc_start_main'
  | run on linux: started yes exit 0
  |   [lx3d2 ok]
  | -- reports
  | Error EF0004: 'liblx3d2bad.a(lx3d2bad.o)' holds a thread-local access (relocation type 19) in section '.text#liblx3d2bad.a(lx3d2bad.o)#1.1' at offset 3 in a form it cannot relax to local-exec, which adam does not link
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_elf_tls;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.Process, Adam.Core.Containers, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics, Adam.Backend.SSA, Adam.Backend.Sections, Adam.Backend.Parts,
  Adam.Backend.Targets, Adam.ELF.Reader, System.ELF;

const
  // The triple whose format part links
  LINUX_TRIPLE: string = "x86_64-linux-gnu";
  // The main (GNU as's bytes): push rbx; call lx3d2_check; mov ebx, eax; lea rdi,
  // [rip + lx3d2_msg]; call puts; mov eax, ebx; xor eax, 31; pop rbx; ret
  MAIN_CODE: array[0..26] of uint8 = [0x53, 0xE8, 0, 0, 0, 0, 0x89, 0xC3, 0x48, 0x8D, 0x3D, 0,
    0, 0, 0, 0xE8, 0, 0, 0, 0, 0x89, 0xD8, 0x83, 0xF0, 0x1F, 0x5B, 0xC3];
  // "lx3d2 ok"
  MESSAGE: array[0..8] of uint8 = [0x6C, 0x78, 0x33, 0x64, 0x32, 0x20, 0x6F, 0x6B, 0];

type
  // Every line a run hands over, in order
  Lines = object implements ProcessOutput
    Items: StringArray;

    virtual method Output(const AText: string);
    var
      LCount: int64;
    begin
      LCount := len(self.Items);
      setlength(self.Items, LCount + 1);
      self.Items[LCount] := AText;
    end;
  end;

// MAIN_CODE as a byte array
func MainBytes(): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(MAIN_CODE));
  for LI := 0 to len(MAIN_CODE) - 1 do
    LBytes[LI] := MAIN_CODE[LI];
  end;
  return LBytes;
end;

// "yes" or "no"
func YesNo(const AValue: bool): string;
begin
  if AValue then
    return "yes";
  end;
  return "no";
end;

// A program set entered at lx3d2_main calling ATarget, linking the library ALibrary
func ProgramSet(const ATarget: string; const ALibrary: string): ref SectionSet;
var
  LSet: ref SectionSet;
  LId: int64;
  LMsg: int64;
  LI: int64;
  LBytes: ByteArray;
begin
  LSet := ref SectionSet();
  LId := LSet.AddSection(".text#lx3d2_main", SectionKind.Code, 16);
  LSet.SectionAt(LId).GroupName := ".text";
  LBytes := MainBytes();
  for LI := 0 to len(LBytes) - 1 do
    LSet.SectionAt(LId).Put8(uint64(LBytes[LI]));
  end;
  LSet.DefineSymbol("lx3d2_main", LId, 0, 0);
  LMsg := LSet.AddSection(".rodata#lx3d2_msg", SectionKind.ReadOnly, 1);
  LSet.SectionAt(LMsg).GroupName := ".rodata";
  for LI := 0 to len(MESSAGE) - 1 do
    LSet.SectionAt(LMsg).Put8(uint64(MESSAGE[LI]));
  end;
  LSet.DefineSymbol("lx3d2_msg", LMsg, 0, 0);
  LSet.AddReloc(LId, 2, RelocKind.Rel32, LSet.ReferSymbol(ATarget, 0), 0);
  LSet.AddReloc(LId, 11, RelocKind.Rel32, LSet.FindSymbol("lx3d2_msg"), 0);
  LSet.AddReloc(LId, 16, RelocKind.Rel32, LSet.ReferSymbol("puts", 0), 0);
  setlength(LSet.LinkLibraries, 1);
  setlength(LSet.LinkLibraryNodes, 1);
  LSet.LinkLibraries[0] := ALibrary;
  LSet.LinkLibraryNodes[0] := 0;
  return LSet;
end;

// The folder the program runs in
func HereDir(): string;
begin
  return ExtractFileDir(ProgramFilePath());
end;

// The fixtures, vendor and system folders (the arguments)
func Paths(): StringArray;
var
  LPaths: StringArray;
begin
  setlength(LPaths, 3);
  LPaths[0] := paramstr(1);
  LPaths[1] := paramstr(2);
  LPaths[2] := paramstr(3);
  return LPaths;
end;

// ASet linked by ABackend's format part, entered at lx3d2_main; the image (empty after a
// report, the reports printed)
func Link(const ABackend: ref Backend; const ASet: ref SectionSet): ByteArray;
var
  LReports: ref Diagnostics;
  LLibraries: StringArray;
  LDebug: ByteArray;
  LImage: ByteArray;
begin
  LReports := ref Diagnostics(100);
  LImage := ABackend.Format.LinkExe(ASet, "lx3d2_main", "", Paths(), ABackend.ABI.CRuntime(),
    ref ExeSettings(), nil, LReports, LLibraries, LDebug);
  LReports.PrintAll();
  if len(LImage) > 0 then
    println("{}", "linked: needs " + JoinStrings(LLibraries, ", "));
  end;
  return LImage;
end;

// The u64 / u32 / u16 at AAt of ABytes
func U64(const ABytes: ByteArray; const AAt: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, 8));
end;

func U32(const ABytes: ByteArray; const AAt: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, 4));
end;

func U16(const ABytes: ByteArray; const AAt: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, 2));
end;

// AValue as 0x and hex digits
func Hex(const AValue: int64): string;
begin
  return "0x" + IntToHex(uint64(AValue), 1);
end;

// The NUL-ended text at AAt of ABytes
func TextAt(const ABytes: ByteArray; const AAt: int64): string;
var
  LI: int64;
begin
  LI := AAt;
  while (LI < len(ABytes)) and (ABytes[LI] <> 0) do
    LI := LI + 1;
  end;
  if LI = AAt then
    return "";
  end;
  return StringFromC(ptr to const char(addr of ABytes[AAt]), LI - AAt);
end;

// The image's PT_TLS (see the header)
func ShowTLS(const ABytes: ByteArray);
var
  LAt: int64;
  LI: int64;
begin
  for LI := 0 to U16(ABytes, 56) - 1 do
    LAt := U64(ABytes, 32) + LI * 56;
    if U32(ABytes, LAt) = int64(PT_TLS) then
      println("{}", "tls segment filesz " + Hex(U64(ABytes, LAt + 32)) + " memsz " +
        Hex(U64(ABytes, LAt + 40)) + " align " + Hex(U64(ABytes, LAt + 48)));
    end;
  end;
end;

// Every .dynsym name of the image
func ShowImports(const ABytes: ByteArray);
var
  LReports: ref Diagnostics;
  LObject: ELFObjectData;
  LSym: ELFSection;
  LStr: int64;
  LI: int64;
  LJ: int64;
begin
  LReports := ref Diagnostics(100);
  if not ReadELFObject(ABytes, 0, len(ABytes), "image", NoPlace(), LReports, LObject) then
    LReports.PrintAll();
    return;
  end;
  LStr := 0;
  for LI := 1 to len(LObject.Sections) - 1 do
    if LObject.Sections[LI].SectionName = ".dynstr" then
      LStr := LObject.Sections[LI].DataAt;
    end;
  end;
  for LI := 1 to len(LObject.Sections) - 1 do
    if LObject.Sections[LI].SectionName = ".dynsym" then
      LSym := LObject.Sections[LI];
      for LJ := 1 to (LSym.DataSize div 24) - 1 do
        println("{}", "dynsym '" + TextAt(ABytes, LStr + U32(ABytes, LSym.DataAt + LJ * 24)) + "'");
      end;
    end;
  end;
end;

var
  LBackend: ref Backend;
  LImage: ByteArray;
  LOutput: ref Lines;
  LNone: StringArray;
  LExit: uint32;
  LStarted: bool;
  LI: int64;
begin
  LBackend := BackendFor(LINUX_TRIPLE);
  LImage := Link(LBackend, ProgramSet("lx3d2_check", "lx3d2"));
  if len(LImage) > 0 then
    ShowTLS(LImage);
    ShowImports(LImage);
    if not WriteAllBytes(HereDir() + "/lx3d2_tls", LImage) then
      println("the image could not be written");
    end;
    LOutput := ref Lines();
    setlength(LNone, 0);
    LStarted := RunELF(HereDir() + "/lx3d2_tls", LNone, HereDir(), LExit, LOutput,
      ProcessCapture.Pipes, nil);
    println("{}", "run on linux: started " + YesNo(LStarted) + " exit " + IntToStr(int64(LExit)));
    for LI := 0 to len(LOutput.Items) - 1 do
      println("{}", "  [" + LOutput.Items[LI] + "]");
    end;
  end;
  println("{}", "-- reports");
  Link(LBackend, ProgramSet("lx3d2_bad", "lx3d2bad"));
end.
