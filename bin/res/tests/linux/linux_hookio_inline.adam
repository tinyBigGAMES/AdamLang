-------------------------------------------------------------------------------
  linux_hookio_inline.adam - glibc's inline and fortified stdio over
  System.HookIO on x86_64-linux-gnu (PLAN-LINUX64 LX3d3c2b)

  fixtures\liblinux_hookio_inline_c.a (built at -O3 with _FORTIFY_SOURCE=2
  and glibc's inline forms: its references are __uflow, __overflow,
  __fgets_chk, __vfprintf_chk) reads a registered memory IO and a real file
  of the same bytes by the inline getc_unlocked to the end (feof_unlocked,
  ferror_unlocked: the FILE's own flags), fgets and fread, and writes 5000
  bytes by the inline putc_unlocked (past one area: __overflow mid-way) and
  an fprintf onto a growing memory IO and a new real file: every slot of the
  IOs' equals the real files', the written bytes read back included.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ok inline register
  | ok inline real file
  | ok inline read every byte
  | ok inline read as real file
  | ok inline write every byte
  | ok inline write as real file
  | ok inline written bytes as real file
  | ok inline write unregister
  | ok inline write real removed
  | ok inline unregister
  | ok inline io close
  | ok inline real removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_hookio_inline;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_hookio_inline runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

@addlibrarypath "$P:res/tests/linux/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO, System.HookIO.Linux64;

func clink linux_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to uint8;
  ACount: clong): int32; external "linux_hookio_c";
func clink linux_hookio_c_sample(ABuffer: ptr to uint8; ACap: clong): clong;
  external "linux_hookio_c";
func clink linux_hookio_inline_c_read(APath: ptr to const char; AChunk: int32;
  AResults: ptr to int64); external "linux_hookio_inline_c";
func clink linux_hookio_inline_c_write(APath: ptr to const char; ACount: int32;
  AResults: ptr to int64); external "linux_hookio_inline_c";

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst (the registered IO's) equal ASecond's (the real file's);
// the first that differs is printed
func SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
func RemovePath(const APath: string): bool;
var
  LOk: bool;
begin
  LOk := RemoveFile(APath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (glibc's own FILE)
func WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LResult: int32;
begin
  LResult := linux_hookio_c_writeraw(APath, ABytes, clong(ACount));
  return LResult = 0;
end;

// The inline fixture's read run over APath (fgets / fread chunk 8): its 12 slots in AResults
func InlineReadC(const APath: string; const AResults: ptr to int64);
begin
  linux_hookio_inline_c_read(APath, 8, AResults);
end;

// The inline fixture's write run onto APath (ACount putc_unlocked bytes, then fprintf): its 6
// slots in AResults
func InlineWriteC(const APath: string; const ACount: int32; const AResults: ptr to int64);
begin
  linux_hookio_inline_c_write(APath, ACount, AResults);
end;

// glibc's inline getc_unlocked / putc_unlocked (straight on the FILE's own pointers: a handle's
// empty areas send them to __uflow / __overflow) and the fortified names (__fgets_chk,
// __vfprintf_chk) on registered IOs, each slot as glibc's own FILE gives it on real files
func TestInline();
var
  LSample: array[0..63] of uint8;
  LLength: clong;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LWritten: IO;
  LWrittenPrefix: string;
  LRealWritten: string;
  LVirtual: array[0..11] of int64;
  LReal: array[0..11] of int64;
begin
  LRealPath := paramstr(0) + ".inline.txt";
  LLength := linux_hookio_c_sample(addr of LSample[0], 64);
  LMemory := CreateMemoryIO(addr of LSample[0], int64(LLength), false);
  LPrefix := RegisterIO(LMemory);
  Check("inline register", LPrefix <> "");
  Check("inline real file", WriteRaw(LRealPath, addr of LSample[0], int64(LLength)));

  InlineReadC(LPrefix + "/i.txt", addr of LVirtual[0]);
  InlineReadC(LRealPath, addr of LReal[0]);
  Check("inline read every byte", (LVirtual[0] = int64(LLength)) and (LVirtual[2] = 1) and
    (LVirtual[11] = 0));
  Check("inline read as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 12));

  // 5000 bytes: more than one 4096-byte area, so __overflow runs mid-way
  LRealWritten := paramstr(0) + ".inline_w.bin";
  LWritten := CreateMemoryIO();
  LWrittenPrefix := RegisterIO(LWritten);
  InlineWriteC(LWrittenPrefix + "/w.bin", 5000, addr of LVirtual[0]);
  InlineWriteC(LRealWritten, 5000, addr of LReal[0]);
  Check("inline write every byte", (LVirtual[0] = 5000) and (LVirtual[1] = 11) and
    (LVirtual[5] = 0) and (IOSize(LWritten) = 5011));
  Check("inline write as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 6));
  InlineReadC(LWrittenPrefix + "/w.bin", addr of LVirtual[0]);
  InlineReadC(LRealWritten, addr of LReal[0]);
  Check("inline written bytes as real file", SameSlots(addr of LVirtual[0], addr of LReal[0],
    12));
  Check("inline write unregister", UnregisterIO(LWrittenPrefix) and IOClose(LWritten));
  Check("inline write real removed", RemovePath(LRealWritten));

  Check("inline unregister", UnregisterIO(LPrefix));
  Check("inline io close", IOClose(LMemory));
  Check("inline real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestInline();
  println("done {}", GFails);
end.
