-------------------------------------------------------------------------------
  linux_run_elf.adam - adam build -r of an x86_64-linux-gnu program on a
  host that runs ELF programs (PLAN-LINUX64, the linux Run): on win64 it
  runs through WSL (System.Process' RunELF attached form) on adam's own
  console, its arguments passed as given, its exit code adam's. Also the
  ELF std.std_run_elf and dbg.dbg_dap_elf run (their dep)
*******************************************************************************/

/*
@@test
  kind cli
  runs x86_64-linux-gnu
  args "--no-banner" "build" "--quiet" "<DIR>/linux_run_elf.adam" "-o" "." "-t" "x86_64-linux-gnu" "-r" "--" "one" "two words"
  exitcode 5
  | linux_run_elf 2
  | arg one
  | arg two words
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_run_elf;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_run_elf runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

import System.SysUtils;

var
  GI: int32;

begin
  println("linux_run_elf {}", paramcount());
  for GI := 1 to paramcount() do
    println("arg {}", paramstr(GI));
  end;
  ExitCode := 5;
end.
