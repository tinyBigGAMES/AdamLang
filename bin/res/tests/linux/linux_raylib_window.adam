-------------------------------------------------------------------------------
  linux_raylib_window.adam - a raylib program started on x86_64-linux-gnu
  (PLAN-LINUX64 LX3d3a): System.Raylib.C over libraylib.a linked against
  libX11.so.6 (libX11.abi) and libc.so.6, run through RunELF with no X
  server assumed: DISPLAY is unset first, so GLFW finds no display and
  InitWindow fails the way raylib reports it (IsWindowReady false, the
  program goes on), while raymath and the CPU-side routines still answer
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | before ready false
  | after ready false
  | length 10
  | done
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_raylib_window;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_raylib_window runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

import System.SysUtils, System.Raylib.C;

// glibc's stdlib.h: the variable removed from the program's environment
func clink unsetenv(const AName: ptr to const char): int32; external "c";

begin
  SetTraceLogLevel(LOG_NONE);
  unsetenv("DISPLAY");
  unsetenv("WAYLAND_DISPLAY");
  println("before ready {}", IsWindowReady());
  InitWindow(320, 200, "linux_raylib_window");
  println("after ready {}", IsWindowReady());
  println("length {}", Vector2Length(Vector2(x: 6.0, y: 8.0)));
  // every InitWindow is released by CloseWindow; a failed InitWindow has
  // already let go of the platform, and CloseWindow then would call GL
  // entry points that were never loaded (raylib 6.2 rlglClose), so the
  // release is made whenever the window came up
  if IsWindowReady() then
    CloseWindow();
  end;
  println("done");
end.
