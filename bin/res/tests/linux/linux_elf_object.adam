-------------------------------------------------------------------------------
  linux_elf_object.adam - x86_64-linux-gnu's ELF format part (Adam.Elf.Format
  over Adam.Elf.Writer, imported from the compiler's own src\, beside bin\;
  the backend BackendFor composes) writes a hand-made SectionSet as an
  ELF64 relocatable object, read back here field by field as readelf -aW
  reads it: the header, every section header (the COMDAT group of a Shared
  section first with its member and the member's .rela, SHF_LINK_ORDER on
  an unwind piece going with its function, NOBITS .bss, TLS .tdata,
  SHT_INIT_ARRAY, SHF_EXCLUDE Info), the symbols (locals first, STT_FUNC /
  OBJECT / TLS, one undefined symbol per import name) and the relocations
  (PC32 with A - 4, PLT32 after a call, GOTPCREL of an import, R_64,
  DTPOFF32, an Rva32 as PC32 with A). The object is also written beside
  the program (linux_elf_object.o) for the devbox proof: readelf, and gcc
  linking it into a C program that runs on linux (PLAN-LINUX64 LX2a)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | elf class 2 data 1 version 1 osabi 0 type 1 machine 0x3E ehsize 64 shentsize 64
  | sections 27 shstrndx 26 headers at 8-byte boundary yes
  | [0] '' type 0 flags 0x0 link 0 info 0 align 0 entsize 0 size 0
  | [1] '.group' type 17 flags 0x0 link 24 info 11 align 4 entsize 4 size 16
  | [2] '.text' type 1 flags 0x6 link 0 info 0 align 16 entsize 0 size 4
  | [3] '.text' type 1 flags 0x6 link 0 info 0 align 16 entsize 0 size 27
  | [4] '.rodata' type 1 flags 0x2 link 0 info 0 align 1 entsize 0 size 16
  | [5] '.data' type 1 flags 0x3 link 0 info 0 align 8 entsize 0 size 16
  | [6] '.bss' type 8 flags 0x3 link 0 info 0 align 4 entsize 0 size 4
  | [7] '.tdata' type 1 flags 0x403 link 0 info 0 align 8 entsize 0 size 8
  | [8] '.text' type 1 flags 0x6 link 0 info 0 align 16 entsize 0 size 6
  | [9] '.text' type 1 flags 0x206 link 0 info 0 align 16 entsize 0 size 6
  | [10] 'adam_pdata' type 1 flags 0x202 link 0 info 0 align 4 entsize 0 size 8
  | [11] 'adam_pdata' type 1 flags 0x82 link 2 info 0 align 4 entsize 0 size 8
  | [12] '.eh_frame' type 1 flags 0x82 link 2 info 0 align 8 entsize 0 size 48
  | [13] '.text' type 1 flags 0x6 link 0 info 0 align 16 entsize 0 size 11
  | [14] '.init_array' type 14 flags 0x3 link 0 info 0 align 8 entsize 0 size 8
  | [15] '.adam' type 1 flags 0x80000000 link 0 info 0 align 1 entsize 0 size 4
  | [16] '.rela.text' type 4 flags 0x40 link 24 info 3 align 8 entsize 24 size 72
  | [17] '.rela.data' type 4 flags 0x40 link 24 info 5 align 8 entsize 24 size 48
  | [18] '.rela.text' type 4 flags 0x40 link 24 info 8 align 8 entsize 24 size 24
  | [19] '.relaadam_pdata' type 4 flags 0x240 link 24 info 10 align 8 entsize 24 size 48
  | [20] '.relaadam_pdata' type 4 flags 0x40 link 24 info 11 align 8 entsize 24 size 48
  | [21] '.rela.eh_frame' type 4 flags 0x40 link 24 info 12 align 8 entsize 24 size 24
  | [22] '.rela.text' type 4 flags 0x40 link 24 info 13 align 8 entsize 24 size 24
  | [23] '.rela.init_array' type 4 flags 0x40 link 24 info 14 align 8 entsize 24 size 24
  | [24] '.symtab' type 2 flags 0x0 link 25 info 4 align 8 entsize 24 size 312
  | [25] '.strtab' type 3 flags 0x0 link 0 info 0 align 1 entsize 0 size 129
  | [26] '.shstrtab' type 3 flags 0x0 link 0 info 0 align 1 entsize 0 size 175
  | group [1] flags 1 members 9 10 19
  | sym 0 '' bind 0 type 0 shndx 0 value 0
  | sym 1 'greeting' bind 0 type 1 shndx 4 value 0
  | sym 2 'adam_init' bind 0 type 2 shndx 13 value 0
  | sym 3 'adam_start' bind 0 type 1 shndx 14 value 0
  | sym 4 'adam_add' bind 1 type 2 shndx 2 value 0
  | sym 5 'adam_greet' bind 1 type 2 shndx 3 value 0
  | sym 6 'adam_helper' bind 1 type 0 shndx 0 value 0
  | sym 7 'adam_table' bind 1 type 1 shndx 5 value 0
  | sym 8 'adam_counter' bind 1 type 1 shndx 6 value 0
  | sym 9 'adam_tls' bind 1 type 6 shndx 7 value 0
  | sym 10 'adam_tls_offset' bind 1 type 2 shndx 8 value 0
  | sym 11 'adam_shared' bind 1 type 2 shndx 9 value 0
  | sym 12 'puts' bind 1 type 0 shndx 0 value 0
  | rela [3] +7 type 2 'greeting' addend -4
  | rela [3] +13 type 9 'puts' addend -4
  | rela [3] +18 type 4 'adam_helper' addend -4
  | rela [5] +0 type 1 'adam_add' addend 0
  | rela [5] +8 type 1 'greeting' addend 6
  | rela [8] +1 type 21 'adam_tls' addend 0
  | rela [10] +0 type 2 'adam_shared' addend 0
  | rela [10] +4 type 2 'adam_shared' addend 6
  | rela [11] +0 type 2 'adam_add' addend 0
  | rela [11] +4 type 2 'adam_add' addend 4
  | rela [12] +32 type 2 'adam_add' addend 0
  | rela [13] +2 type 2 'adam_counter' addend -8
  | rela [14] +0 type 1 'adam_init' addend 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_elf_object;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Backend.Ssa, Adam.Backend.Sections, Adam.Backend.Parts,
  Adam.Backend.Targets;

const
  // The triple whose format part writes the object
  LINUX_TRIPLE: string = "x86_64-linux-gnu";
  // A leaf function's .eh_frame piece (Adam.SysV.Unwind's, linux_sysv_unwind's leaf) for a
  // 4-byte function: its FDE's pc_begin a Rel32 at +32, addend 4
  LEAF_FRAME: array[0..47] of uint8 = [
    0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x7A, 0x52, 0x00, 0x01, 0x78, 0x10, 0x01,
    0x1B, 0x0C, 0x07, 0x08, 0x90, 0x01, 0x00, 0x00, 0x14, 0x00, 0x00, 0x00, 0x1C, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
  ];

// ABytes appended to the section AId of ASet
routine Put(const ASet: ref SectionSet; const AId: int64; const ABytes: array of uint8);
var
  LI: int64;
begin
  for LI := 0 to len(ABytes) - 1 do
    ASet.SectionAt(AId).Put8(uint64(ABytes[LI]));
  end;
end;

// A new Removable section of AKind in the group AGroup, named AGroup#ASymbol, with ASymbol
// defined at its start; its id
routine Piece(const ASet: ref SectionSet; const AFormat: ref FormatPart; const AKind: SectionKind;
  const ASymbol: string; const AAlign: int64): int64;
var
  LGroup: string;
  LId: int64;
begin
  LGroup := AFormat.SectionNameOf(AKind);
  LId := ASet.AddSection(LGroup + "#" + ASymbol, AKind, AAlign);
  ASet.SectionAt(LId).GroupName := LGroup;
  ASet.SectionAt(LId).Removable := true;
  return LId;
end;

// An unwind piece of the group AGroup going with the section of ASymbol
routine Partner(const ASet: ref SectionSet; const AGroup: string; const ASymbol: string;
  const AAlign: int64): int64;
var
  LId: int64;
begin
  LId := ASet.AddSection(AGroup + "#" + ASymbol, SectionKind.ReadOnly, AAlign);
  ASet.SectionAt(LId).GroupName := AGroup;
  ASet.SectionAt(LId).Removable := true;
  ASet.SectionAt(LId).Associate := ASet.SymbolAt(ASet.FindSymbol(ASymbol)).SectionId;
  return LId;
end;

// The set: code calling an import and a C routine, data with pointers, zeroed storage, a
// thread-local, a Shared (COMDAT) routine, unwind pieces, a start list entry, an Info section
routine MakeSet(const AFormat: ref FormatPart): ref SectionSet;
var
  LSet: ref SectionSet;
  LId: int64;
  LPuts: int64;
  LText: string;
  LI: int64;
begin
  LSet := ref SectionSet();
  // adam_add: lea eax, [rdi + rsi]; ret
  LId := Piece(LSet, AFormat, SectionKind.Code, "adam_add", 16);
  Put(LSet, LId, [0x8D, 0x04, 0x37, 0xC3]);
  LSet.DefineSymbol("adam_add", LId, 0, 0);
  // adam_greet: sub rsp, 8; lea rdi, [rip + greeting]; call [rip + puts]; call adam_helper;
  // add rsp, 8; ret
  LId := Piece(LSet, AFormat, SectionKind.Code, "adam_greet", 16);
  Put(LSet, LId, [0x48, 0x83, 0xEC, 0x08, 0x48, 0x8D, 0x3D, 0, 0, 0, 0, 0xFF, 0x15, 0, 0, 0, 0,
    0xE8, 0, 0, 0, 0, 0x48, 0x83, 0xC4, 0x08, 0xC3]);
  LSet.DefineSymbol("adam_greet", LId, 0, 0);
  LSet.AddReloc(LId, 7, RelocKind.Rel32, LSet.ReferSymbol("greeting", 0), 0);
  LPuts := LSet.ImportSymbol("c", "puts", 0);
  LSet.AddReloc(LId, 13, RelocKind.Rel32, LPuts, 0);
  LSet.AddReloc(LId, 18, RelocKind.Rel32, LSet.ReferSymbol("adam_helper", 0), 0);
  // greeting: internal text
  LId := Piece(LSet, AFormat, SectionKind.ReadOnly, "greeting", 1);
  LText := "hello from adam";
  for LI := 0 to len(LText) - 1 do
    LSet.SectionAt(LId).Put8(uint64(uint8(LText[LI])));
  end;
  LSet.SectionAt(LId).Put8(0);
  LSet.MakeInternal(LSet.DefineSymbol("greeting", LId, 0, 0));
  // adam_table: adam_add's address, then the greeting's "from adam"
  LId := Piece(LSet, AFormat, SectionKind.Data, "adam_table", 8);
  LSet.SectionAt(LId).PutZeros(16);
  LSet.DefineSymbol("adam_table", LId, 0, 0);
  LSet.AddReloc(LId, 0, RelocKind.Abs64, LSet.FindSymbol("adam_add"), 0);
  LSet.AddReloc(LId, 8, RelocKind.Abs64, LSet.FindSymbol("greeting"), 6);
  // adam_counter: 4 zeroed bytes
  LId := Piece(LSet, AFormat, SectionKind.Zeroed, "adam_counter", 4);
  LSet.SectionAt(LId).PutZeros(4);
  LSet.DefineSymbol("adam_counter", LId, 0, 0);
  // adam_tls: a thread-local of 42
  LId := Piece(LSet, AFormat, SectionKind.ThreadLocal, "adam_tls", 8);
  LSet.SectionAt(LId).Put64(42);
  LSet.DefineSymbol("adam_tls", LId, 0, 0);
  // adam_tls_offset: mov eax, adam_tls's offset in the TLS block; ret
  LId := Piece(LSet, AFormat, SectionKind.Code, "adam_tls_offset", 16);
  Put(LSet, LId, [0xB8, 0, 0, 0, 0, 0xC3]);
  LSet.DefineSymbol("adam_tls_offset", LId, 0, 0);
  LSet.AddReloc(LId, 1, RelocKind.SecRel32, LSet.FindSymbol("adam_tls"), 0);
  // adam_shared: mov eax, 7; ret, Shared (COMDAT ANY), its table piece in its group
  LId := Piece(LSet, AFormat, SectionKind.Code, "adam_shared", 16);
  LSet.SectionAt(LId).Shared := true;
  Put(LSet, LId, [0xB8, 0x07, 0, 0, 0, 0xC3]);
  LSet.DefineSymbol("adam_shared", LId, 0, 0);
  LId := Partner(LSet, "adam_pdata", "adam_shared", 4);
  LSet.SectionAt(LId).PutZeros(8);
  LSet.AddReloc(LId, 0, RelocKind.Rva32, LSet.FindSymbol("adam_shared"), 0);
  LSet.AddReloc(LId, 4, RelocKind.Rva32, LSet.FindSymbol("adam_shared"), 6);
  // adam_add's table piece and its .eh_frame piece (SHF_LINK_ORDER)
  LId := Partner(LSet, "adam_pdata", "adam_add", 4);
  LSet.SectionAt(LId).PutZeros(8);
  LSet.AddReloc(LId, 0, RelocKind.Rva32, LSet.FindSymbol("adam_add"), 0);
  LSet.AddReloc(LId, 4, RelocKind.Rva32, LSet.FindSymbol("adam_add"), 4);
  LId := Partner(LSet, ".eh_frame", "adam_add", 8);
  for LI := 0 to len(LEAF_FRAME) - 1 do
    LSet.SectionAt(LId).Put8(uint64(LEAF_FRAME[LI]));
  end;
  LSet.AddReloc(LId, 32, RelocKind.Rel32, LSet.FindSymbol("adam_add"), 4);
  // adam_init: mov dword [rip + adam_counter], 1; ret (the field 4 bytes before its
  // instruction's end), run by the start list
  LId := Piece(LSet, AFormat, SectionKind.Code, "adam_init", 16);
  Put(LSet, LId, [0xC7, 0x05, 0, 0, 0, 0, 0x01, 0, 0, 0, 0xC3]);
  LSet.MakeInternal(LSet.DefineSymbol("adam_init", LId, 0, 0));
  LSet.AddReloc(LId, 2, RelocKind.Rel32, LSet.FindSymbol("adam_counter"), -4);
  LId := LSet.AddSection(AFormat.StartListGroupOf(StartListPlace.Entry) + "#adam_start",
    SectionKind.ReadOnly, 8);
  LSet.SectionAt(LId).GroupName := AFormat.StartListGroupOf(StartListPlace.Entry);
  LSet.SectionAt(LId).PutZeros(8);
  LSet.MakeInternal(LSet.DefineSymbol("adam_start", LId, 0, 0));
  LSet.AddReloc(LId, 0, RelocKind.Abs64, LSet.FindSymbol("adam_init"), 0);
  // the compiler's own bytes
  LId := LSet.AddSection(AFormat.SectionNameOf(SectionKind.Info), SectionKind.Info, 1);
  Put(LSet, LId, [0x41, 0x44, 0x41, 0x4D]);
  return LSet;
end;

// The NUL-ended name at AAt of ABytes
routine NameAt(const ABytes: ByteArray; const AAt: int64): string;
var
  LText: string;
  LI: int64;
begin
  LText := "";
  LI := AAt;
  while ABytes[LI] <> 0 do
    LText := LText + char(ABytes[LI]);
    LI := LI + 1;
  end;
  return LText;
end;

// "yes" or "no"
routine YesNo(const AValue: bool): string;
begin
  if AValue then
    return "yes";
  end;
  return "no";
end;

// The ACount little-endian bytes at AAt of ABytes
routine Field(const ABytes: ByteArray; const AAt: int64; const ACount: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, ACount));
end;

// The object ABytes read back as readelf reads it (see the header)
routine Show(const ABytes: ByteArray);
var
  LCount: int64;
  LHeaders: int64;
  LNames: int64;
  LAt: int64;
  LI: int64;
  LJ: int64;
  LType: int64;
  LSymtab: int64;
  LStrings: int64;
  LSymbols: int64;
  LSymAt: int64;
  LInfo: int64;
begin
  println("elf class " + IntToStr(ABytes[4]) + " data " + IntToStr(ABytes[5]) + " version " +
    IntToStr(ABytes[6]) + " osabi " + IntToStr(ABytes[7]) + " type " + IntToStr(Field(ABytes, 16, 2)) +
    " machine 0x" + IntToHex(uint64(Field(ABytes, 18, 2)), 2) + " ehsize " +
    IntToStr(Field(ABytes, 52, 2)) + " shentsize " + IntToStr(Field(ABytes, 58, 2)));
  LHeaders := Field(ABytes, 40, 8);
  LCount := Field(ABytes, 60, 2);
  println("sections " + IntToStr(LCount) + " shstrndx " + IntToStr(Field(ABytes, 62, 2)) +
    " headers at 8-byte boundary " + YesNo(LHeaders mod 8 = 0));
  LNames := Field(ABytes, LHeaders + 64 * Field(ABytes, 62, 2) + 24, 8);
  LSymtab := 0;
  for LI := 0 to LCount - 1 do
    LAt := LHeaders + 64 * LI;
    LType := Field(ABytes, LAt + 4, 4);
    if LType = 2 then
      LSymtab := LAt;
    end;
    println("[" + IntToStr(LI) + "] '" + NameAt(ABytes, LNames + Field(ABytes, LAt, 4)) + "' type " +
      IntToStr(LType) + " flags 0x" + IntToHex(uint64(Field(ABytes, LAt + 8, 8)), 1) + " link " +
      IntToStr(Field(ABytes, LAt + 40, 4)) + " info " + IntToStr(Field(ABytes, LAt + 44, 4)) +
      " align " + IntToStr(Field(ABytes, LAt + 48, 8)) + " entsize " +
      IntToStr(Field(ABytes, LAt + 56, 8)) + " size " + IntToStr(Field(ABytes, LAt + 32, 8)));
  end;
  // groups: their flag word and member indices
  for LI := 0 to LCount - 1 do
    LAt := LHeaders + 64 * LI;
    if Field(ABytes, LAt + 4, 4) = 17 then
      LSymAt := Field(ABytes, LAt + 24, 8);
      LInfo := Field(ABytes, LAt + 32, 8) div 4;
      print("group [" + IntToStr(LI) + "] flags " + IntToStr(Field(ABytes, LSymAt, 4)) + " members");
      for LJ := 1 to LInfo - 1 do
        print(" " + IntToStr(Field(ABytes, LSymAt + 4 * LJ, 4)));
      end;
      println("");
    end;
  end;
  LStrings := Field(ABytes, LHeaders + 64 * Field(ABytes, LSymtab + 40, 4) + 24, 8);
  LSymbols := Field(ABytes, LSymtab + 32, 8) div 24;
  for LI := 0 to LSymbols - 1 do
    LSymAt := Field(ABytes, LSymtab + 24, 8) + 24 * LI;
    LInfo := int64(ABytes[LSymAt + 4]);
    println("sym " + IntToStr(LI) + " '" + NameAt(ABytes, LStrings + Field(ABytes, LSymAt, 4)) +
      "' bind " + IntToStr(LInfo shr 4) + " type " + IntToStr(LInfo & 15) + " shndx " +
      IntToStr(Field(ABytes, LSymAt + 6, 2)) + " value " + IntToStr(Field(ABytes, LSymAt + 8, 8)));
  end;
  for LI := 0 to LCount - 1 do
    LAt := LHeaders + 64 * LI;
    if Field(ABytes, LAt + 4, 4) <> 4 then
      skip;
    end;
    for LJ := 0 to Field(ABytes, LAt + 32, 8) div 24 - 1 do
      LSymAt := Field(ABytes, LAt + 24, 8) + 24 * LJ;
      LInfo := Field(ABytes, LSymAt + 8, 8);
      println("rela [" + IntToStr(Field(ABytes, LAt + 44, 4)) + "] +" +
        IntToStr(Field(ABytes, LSymAt, 8)) + " type " + IntToStr(LInfo & 0xFFFFFFFF) + " '" +
        NameAt(ABytes, LStrings + Field(ABytes, Field(ABytes, LSymtab + 24, 8) + 24 * (LInfo shr 32), 4)) +
        "' addend " + IntToStr(Field(ABytes, LSymAt + 16, 8)));
    end;
  end;
end;

var
  LBackend: ref Backend;
  LBytes: ByteArray;
begin
  LBackend := BackendFor(LINUX_TRIPLE);
  LBytes := LBackend.Format.WriteObject(MakeSet(LBackend.Format));
  Show(LBytes);
  if not WriteAllBytes("$P:linux_elf_object.o", LBytes) then
    println("the object could not be written");
  end;
end.
