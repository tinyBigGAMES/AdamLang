-------------------------------------------------------------------------------
  linux_hookio_plain_stream.adam - a program that does not link System.HookIO
  keeps glibc's stream names as they are (PLAN-LINUX64 LX3d3c2c): fopen,
  __wuflow and _IO_padn stay shared imports of libc.so.6 and the build is
  clean (only a hooked link refuses an unhooked stream name, EL0009).
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/linux_hookio_plain_stream.adam" "-o" "." "-t" "x86_64-linux-gnu"
  exitcode 0
@@end
*/

module exe linux_hookio_plain_stream;

routine clink fopen(APath: ptr to const char; AMode: ptr to const char): ptr; external "c";
routine clink fclose(AFile: ptr): int32; external "c";
routine clink __wuflow(AFile: ptr): uint32; external "c";
routine clink _IO_padn(AFile: ptr; APad: int32; ACount: int64): int64; external "c";

var
  LFile: ptr;

begin
  LFile := fopen(ptr to const char("/dev/null"), ptr to const char("rb"));
  if LFile <> nil then
    __wuflow(LFile);
    _IO_padn(LFile, 32, 1);
    fclose(LFile);
  end;
end.
