-------------------------------------------------------------------------------
  linux_elf_dynamic.adam - x86_64-linux-gnu's dynamic link (Adam.ELF.Linker's
  dynamic part over Adam.ELF.Dynamic, imported from the compiler's own src\,
  beside bin\; PLAN-LINUX64 LX3b): a C main (GNU as's bytes) linked against
  glibc through the shipped version table (glibc.abi, the 2.29 floor): Adam
  imports of puts / fflush (routines) and stdout (data) through their slots,
  a foreign-style call of pthread_key_create (its stub: libpthread.so.0
  bound at GLIBC_2.2.5), a foreign .got slot of fegetround (libm.so.6), an
  Abs64 of write in data (R_X86_64_64), the shipped libzlib.a's crc32 (its
  .eh_frame indexed in .eh_frame_hdr), and liblx3b.a (written here): one
  member whose two GOT references are weak, lx3b_absent (nothing defines
  it: 0) and getpid (bound weak from libc.so.6). The image as the reader
  reads it, then its dynamic tables decoded here (.dynamic, .dynsym with
  each version, .gnu.version_r, .rela.dyn, .eh_frame_hdr checked against
  every FDE), then written beside the program (lx3b_dynamic) and run on
  linux through System.Process's RunELF (WSL on win64): it prints "lx3b ok"
  (puts, flushed) and "write", exit 0 when every check of its own passed
  (its runs line: a host that cannot run it, Windows with no WSL, does not
  run the row, said under its PASS).
  The reports: shared data reached without a GOT slot (EL0006), a damaged
  version table (EL0008, then EL0002), one without the start routine
  (EL0008), no version table in the paths (EL0003, then EL0002), an
  .eh_frame record that cannot be read (EL0007); a library spelled "dl"
  with no static file links as the shared libdl.so.2
*******************************************************************************/

/*
@@test
  kind run
  runs x86_64-linux-gnu
  args "<BIN>/res/libs/vendor/x86_64-linux-gnu" "<BIN>/res/libs/system/x86_64-linux-gnu"
  exitcode 0
  | linked: needs libpthread.so.0, libc.so.6, libm.so.6
  | image 18856 bytes type 2 entry 0x403DA0 phnum 8 shnum 20
  | phdr 0x6 flags 4 offset 0x40 vaddr 0x400040 filesz 0x1C0 memsz 0x1C0 align 0x8
  | phdr 0x3 flags 4 offset 0x28B4 vaddr 0x4028B4 filesz 0x1C memsz 0x1C align 0x1
  | phdr 0x1 flags 4 offset 0x0 vaddr 0x400000 filesz 0x2BEC memsz 0x2BEC align 0x1000
  | phdr 0x1 flags 5 offset 0x3000 vaddr 0x403000 filesz 0xDD8 memsz 0xDD8 align 0x1000
  | phdr 0x1 flags 6 offset 0x4000 vaddr 0x404000 filesz 0x170 memsz 0x174 align 0x1000
  | phdr 0x2 flags 6 offset 0x4050 vaddr 0x404050 filesz 0x120 memsz 0x120 align 0x8
  | phdr 0x6474E550 flags 4 offset 0x2BA0 vaddr 0x402BA0 filesz 0x4C memsz 0x4C align 0x4
  | phdr 0x6474E551 flags 6 offset 0x0 vaddr 0x0 filesz 0x0 memsz 0x0 align 0x10
  | [1] '.rodata' type 0x1 flags 0x2 addr 0x400200 size 0x2490 link 0 info 0 entsize 0
  | [2] '.eh_frame' type 0x1 flags 0x2 addr 0x402690 size 0x224 link 0 info 0 entsize 0
  | [3] '.interp' type 0x1 flags 0x2 addr 0x4028B4 size 0x1C link 0 info 0 entsize 0
  | [4] '.dynsym' type 0xB flags 0x2 addr 0x4028D0 size 0xD8 link 5 info 1 entsize 24
  | [5] '.dynstr' type 0x3 flags 0x2 addr 0x4029A8 size 0x81 link 0 info 0 entsize 0
  | [6] '.hash' type 0x5 flags 0x2 addr 0x402A30 size 0x38 link 4 info 0 entsize 4
  | [7] '.gnu.version' type 0x6FFFFFFF flags 0x2 addr 0x402A68 size 0x12 link 4 info 0 entsize 2
  | [8] '.gnu.version_r' type 0x6FFFFFFE flags 0x2 addr 0x402A80 size 0x60 link 5 info 3 entsize 0
  | [9] '.rela.dyn' type 0x4 flags 0x2 addr 0x402AE0 size 0xC0 link 4 info 0 entsize 24
  | [10] '.eh_frame_hdr' type 0x1 flags 0x2 addr 0x402BA0 size 0x4C link 0 info 0 entsize 0
  | [11] '.text' type 0x1 flags 0x6 addr 0x403000 size 0xDC6 link 0 info 0 entsize 0
  | [12] '.plt' type 0x1 flags 0x6 addr 0x403DD0 size 0x8 link 0 info 0 entsize 0
  | [13] '.data' type 0x1 flags 0x3 addr 0x404000 size 0x8 link 0 info 0 entsize 0
  | [14] '.got' type 0x1 flags 0x3 addr 0x404008 size 0x48 link 0 info 0 entsize 0
  | [15] '.dynamic' type 0x6 flags 0x3 addr 0x404050 size 0x120 link 5 info 0 entsize 16
  | [16] '.bss' type 0x8 flags 0x3 addr 0x404170 size 0x4 link 0 info 0 entsize 0
  | [17] '.symtab' type 0x2 flags 0x0 addr 0x0 size 0x1B0 link 18 info 1 entsize 24
  | [18] '.strtab' type 0x3 flags 0x0 addr 0x0 size 0xE2 link 0 info 0 entsize 0
  | [19] '.shstrtab' type 0x3 flags 0x0 addr 0x0 size 0xA3 link 0 info 0 entsize 0
  | dyn NEEDED libpthread.so.0
  | dyn NEEDED libc.so.6
  | dyn NEEDED libm.so.6
  | dyn 0x4 0x402A30
  | dyn 0x5 0x4029A8
  | dyn 0x6 0x4028D0
  | dyn 0xA 0x81
  | dyn 0xB 0x18
  | dyn 0x15 0x0
  | dyn 0x7 0x402AE0
  | dyn 0x8 0xC0
  | dyn 0x9 0x18
  | dyn 0x6FFFFFF0 0x402A68
  | dyn 0x6FFFFFFE 0x402A80
  | dyn 0x6FFFFFFF 0x3
  | dyn 0x1E 0x8
  | dyn 0x6FFFFFFB 0x1
  | dyn 0x0 0x0
  | dynsym 1 'pthread_key_create' bind 1 type 2 shndx 0 version 2
  | dynsym 2 'write' bind 1 type 2 shndx 0 version 3
  | dynsym 3 'fegetround' bind 1 type 2 shndx 0 version 4
  | dynsym 4 'getpid' bind 2 type 2 shndx 0 version 3
  | dynsym 5 'puts' bind 1 type 2 shndx 0 version 3
  | dynsym 6 'stdout' bind 1 type 1 shndx 0 version 3
  | dynsym 7 'fflush' bind 1 type 2 shndx 0 version 3
  | dynsym 8 '__libc_start_main' bind 1 type 2 shndx 0 version 3
  | verneed libpthread.so.0 count 1
  |   vernaux GLIBC_2.2.5 index 2 hash 0x9691A75
  | verneed libc.so.6 count 1
  |   vernaux GLIBC_2.2.5 index 3 hash 0x9691A75
  | verneed libm.so.6 count 1
  |   vernaux GLIBC_2.2.5 index 4 hash 0x9691A75
  | rela 0x404040 type 6 'pthread_key_create' addend 0
  | rela 0x404000 type 1 'write' addend 0
  | rela 0x404008 type 6 'fegetround' addend 0
  | rela 0x404018 type 6 'getpid' addend 0
  | rela 0x404020 type 6 'puts' addend 0
  | rela 0x404028 type 6 'stdout' addend 0
  | rela 0x404030 type 6 'fflush' addend 0
  | rela 0x404048 type 6 '__libc_start_main' addend 0
  | eh_frame_hdr version 1 encodings 0x1B 0x3 0x3B eh_frame 0x402690 fdes 8
  | eh_frame_hdr sorted yes each entry its FDE yes
  | run on linux: started yes exit 0
  |   [lx3b ok]
  |   [write]
  | -- reports
  | Error EL0006: 'stdout' is data of the shared library 'libc.so.6', reached in '.text#lx3b_go' at offset 3 without a GOT slot: an exe reaches shared data only through one (a C object built with -fPIC does)
  | Error EL0008: the C runtime's version table 'lx3b_bad.abi' is damaged at line 2
  | Error EL0002: 'puts' is used, but nothing in the program, its static libraries or the shared libraries of the version tables defines it
  | Error EL0008: the C runtime's version table 'lx3b_nostart.abi' does not hold its start routine '__libc_start_main'
  | Error EL0003: the C runtime's version table 'glibc.abi' is not found: looked in nolibs
  | Error EL0002: 'puts' is used, but nothing in the program, its static libraries or the shared libraries of the version tables defines it
  | Error EL0007: the .eh_frame of '.eh_frame#lx3b_bad' holds a record adam cannot read at offset 0
  | linked: needs libdl.so.2, libc.so.6
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_elf_dynamic;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, System.Process, Adam.Core.Containers, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics, Adam.Backend.SSA, Adam.Backend.Sections, Adam.Backend.Parts,
  Adam.Backend.Targets, Adam.ELF.Reader, System.ELF;

const
  // The triple whose format part links
  LINUX_TRIPLE: string = "x86_64-linux-gnu";
  // The C main (see the header; GNU as's bytes): each check that fails sets a bit of r12d,
  // its result: pthread_key_create 1, fegetround 2, lx3b_absent 4, getpid 8, write 16,
  // crc32 ("lx3b ok" = 0x41ED02C5) 32
  MAIN_CODE: array[0..177] of uint8 = [
    0x53, 0x41, 0x54, 0x48, 0x83, 0xEC, 0x08, 0x45, 0x31, 0xE4, 0x48, 0x8D, 0x3D, 0, 0, 0, 0, 0xFF,
    0x15, 0, 0, 0, 0, 0x48, 0x8B, 0x05, 0, 0, 0, 0, 0x48, 0x8B, 0x38, 0xFF, 0x15, 0, 0, 0, 0, 0x48,
    0x8D, 0x3D, 0, 0, 0, 0, 0x31, 0xF6, 0xE8, 0, 0, 0, 0, 0x85, 0xC0, 0x74, 0x04, 0x41, 0x83, 0xCC,
    0x01, 0xFF, 0x15, 0, 0, 0, 0, 0x85, 0xC0, 0x74, 0x04, 0x41, 0x83, 0xCC, 0x02, 0xE8, 0, 0, 0, 0,
    0x48, 0x85, 0xC0, 0x74, 0x04, 0x41, 0x83, 0xCC, 0x04, 0xE8, 0, 0, 0, 0, 0x48, 0x85, 0xC0, 0x75,
    0x04, 0x41, 0x83, 0xCC, 0x08, 0xBF, 0x01, 0, 0, 0, 0x48, 0x8D, 0x35, 0, 0, 0, 0, 0xBA, 0x06, 0,
    0, 0, 0xFF, 0x15, 0, 0, 0, 0, 0x48, 0x83, 0xF8, 0x06, 0x74, 0x04, 0x41, 0x83, 0xCC, 0x10, 0x31,
    0xFF, 0x48, 0x8D, 0x35, 0, 0, 0, 0, 0xBA, 0x07, 0, 0, 0, 0xFF, 0x15, 0, 0, 0, 0, 0x3D, 0xC5,
    0x02, 0xED, 0x41, 0x74, 0x04, 0x41, 0x83, 0xCC, 0x20, 0x44, 0x89, 0xE0, 0x48, 0x83, 0xC4, 0x08,
    0x41, 0x5C, 0x5B, 0xC3];
  // A routine reading one GOT slot: mov rax, [rip + slot]; ret
  READ_CODE: array[0..7] of uint8 = [0x48, 0x8B, 0x05, 0, 0, 0, 0, 0xC3];

type
  // Every line a run hands over, in order
  Lines = object implements ProcessOutput
    Items: StringArray;

    virtual method Output(const AText: string);
    var
      LCount: int64;
    begin
      LCount := len(self.Items);
      setlength(self.Items, LCount + 1);
      self.Items[LCount] := AText;
    end;
  end;

// MAIN_CODE / READ_CODE as byte arrays
func MainBytes(): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(MAIN_CODE));
  for LI := 0 to len(MAIN_CODE) - 1 do
    LBytes[LI] := MAIN_CODE[LI];
  end;
  return LBytes;
end;

func ReadBytes(): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(READ_CODE));
  for LI := 0 to len(READ_CODE) - 1 do
    LBytes[LI] := READ_CODE[LI];
  end;
  return LBytes;
end;

// "yes" or "no"
func YesNo(const AValue: bool): string;
begin
  if AValue then
    return "yes";
  end;
  return "no";
end;

// ABytes appended to the section AId of ASet
func Put(const ASet: ref SectionSet; const AId: int64; const ABytes: array of uint8);
var
  LI: int64;
begin
  for LI := 0 to len(ABytes) - 1 do
    ASet.SectionAt(AId).Put8(uint64(ABytes[LI]));
  end;
end;

// A Removable section of AKind in AGroup named for ASymbol, ASymbol defined at its start
// holding ABytes (zeros for a zeroed one); its id
func Defined(const ASet: ref SectionSet; const AGroup: string; const AKind: SectionKind;
  const ASymbol: string; const ABytes: array of uint8; const AAlign: int64): int64;
var
  LId: int64;
begin
  LId := ASet.AddSection(AGroup + "#" + ASymbol, AKind, AAlign);
  ASet.SectionAt(LId).GroupName := AGroup;
  ASet.SectionAt(LId).Removable := true;
  if AKind = SectionKind.Zeroed then
    ASet.SectionAt(LId).PutZeros(len(ABytes));
  else
    Put(ASet, LId, ABytes);
  end;
  ASet.DefineSymbol(ASymbol, LId, 0, 0);
  return LId;
end;

// liblx3b.a's member: lx3b_absent_probe and lx3b_getpid_probe, each reading its GOT slot
// (of lx3b_absent / getpid: made weak in the object's bytes, MemberBytes)
func MemberSet(): ref SectionSet;
var
  LSet: ref SectionSet;
  LId: int64;
begin
  LSet := ref SectionSet();
  LId := Defined(LSet, ".text", SectionKind.Code, "lx3b_absent_probe", ReadBytes(), 16);
  LSet.AddReloc(LId, 3, RelocKind.Rel32, LSet.ImportSymbol("c", "lx3b_absent", 0), 0);
  LId := Defined(LSet, ".text", SectionKind.Code, "lx3b_getpid_probe", ReadBytes(), 16);
  LSet.AddReloc(LId, 3, RelocKind.Rel32, LSet.ImportSymbol("c", "getpid", 0), 0);
  return LSet;
end;

// The member's object with its symbols lx3b_absent and getpid made STB_WEAK
func MemberBytes(const ABackend: ref Backend): ByteArray;
var
  LBytes: ByteArray;
  LObject: ELFObjectData;
  LReports: ref Diagnostics;
  LSymtab: int64;
  LName: string;
  LAt: int64;
  LI: int64;
begin
  LBytes := ABackend.Format.WriteObject(MemberSet());
  LReports := ref Diagnostics(100);
  if not ReadELFObject(LBytes, 0, len(LBytes), "member", NoPlace(), LReports, LObject) then
    LReports.PrintAll();
    return LBytes;
  end;
  LSymtab := 0;
  for LI := 1 to len(LObject.Sections) - 1 do
    if LObject.Sections[LI].SectionType = int64(SHT_SYMTAB) then
      LSymtab := LI;
    end;
  end;
  for LI := 1 to len(LObject.Symbols) - 1 do
    LName := LObject.Symbols[LI].SymbolName;
    if (LName = "lx3b_absent") or (LName = "getpid") then
      LAt := LObject.Sections[LSymtab].DataAt + LI * 24 + 4;
      LBytes[LAt] := uint8((int64(STB_WEAK) shl 4) | (int64(LBytes[LAt]) & 0xF));
    end;
  end;
  return LBytes;
end;

// The program (see the header), entered at lx3b_main
func ProgramSet(): ref SectionSet;
var
  LSet: ref SectionSet;
  LMain: int64;
  LId: int64;
begin
  LSet := ref SectionSet();
  LMain := Defined(LSet, ".text", SectionKind.Code, "lx3b_main", MainBytes(), 16);
  LSet.SectionAt(LMain).Removable := false;
  Defined(LSet, ".rodata", SectionKind.ReadOnly, "lx3b_msg", [0x6C, 0x78, 0x33, 0x62, 0x20, 0x6F, 0x6B, 0], 1);
  Defined(LSet, ".rodata", SectionKind.ReadOnly, "lx3b_msg2", [0x77, 0x72, 0x69, 0x74, 0x65, 0x0A], 1);
  Defined(LSet, ".bss", SectionKind.Zeroed, "lx3b_key", [0, 0, 0, 0], 4);
  LId := Defined(LSet, ".data", SectionKind.Data, "lx3b_table", [0, 0, 0, 0, 0, 0, 0, 0], 8);
  LSet.AddReloc(LId, 0, RelocKind.Abs64, LSet.ReferSymbol("write", 0), 0);
  LId := Defined(LSet, ".got", SectionKind.Data, "lx3b_got_fegetround", [0, 0, 0, 0, 0, 0, 0, 0], 8);
  LSet.AddReloc(LId, 0, RelocKind.Abs64, LSet.ReferSymbol("fegetround", 0), 0);
  LSet.AddReloc(LMain, 13, RelocKind.Rel32, LSet.FindSymbol("lx3b_msg"), 0);
  LSet.AddReloc(LMain, 19, RelocKind.Rel32, LSet.ImportSymbol("c", "puts", 0), 0);
  LSet.AddReloc(LMain, 26, RelocKind.Rel32, LSet.ImportSymbol("c", "stdout", 0), 0);
  LSet.AddReloc(LMain, 35, RelocKind.Rel32, LSet.ImportSymbol("c", "fflush", 0), 0);
  LSet.AddReloc(LMain, 42, RelocKind.Rel32, LSet.FindSymbol("lx3b_key"), 0);
  LSet.AddReloc(LMain, 49, RelocKind.Rel32, LSet.ReferSymbol("pthread_key_create", 0), 0);
  LSet.AddReloc(LMain, 63, RelocKind.Rel32, LSet.FindSymbol("lx3b_got_fegetround"), 0);
  LSet.AddReloc(LMain, 76, RelocKind.Rel32, LSet.ReferSymbol("lx3b_absent_probe", 0), 0);
  LSet.AddReloc(LMain, 90, RelocKind.Rel32, LSet.ReferSymbol("lx3b_getpid_probe", 0), 0);
  LSet.AddReloc(LMain, 111, RelocKind.Rel32, LSet.FindSymbol("lx3b_msg2"), 0);
  LSet.AddReloc(LMain, 122, RelocKind.Rel32, LSet.FindSymbol("lx3b_table"), 0);
  LSet.AddReloc(LMain, 141, RelocKind.Rel32, LSet.FindSymbol("lx3b_msg"), 0);
  LSet.AddReloc(LMain, 152, RelocKind.Rel32, LSet.ImportSymbol("zlib", "crc32", 0), 0);
  setlength(LSet.LinkLibraries, 1);
  setlength(LSet.LinkLibraryNodes, 1);
  LSet.LinkLibraries[0] := "lx3b";
  LSet.LinkLibraryNodes[0] := 0;
  return LSet;
end;

// The folder the program runs in
func HereDir(): string;
begin
  return ExtractFileDir(ProgramFilePath());
end;

// This program's folder, then the vendor and system folders (the arguments)
func Paths(): StringArray;
var
  LPaths: StringArray;
begin
  setlength(LPaths, 3);
  LPaths[0] := HereDir();
  LPaths[1] := paramstr(1);
  LPaths[2] := paramstr(2);
  return LPaths;
end;

// ASet linked by ABackend's format part with APaths against ARuntime, entered at AEntry; the
// image (empty after a report, the reports printed)
func Link(const ABackend: ref Backend; const ASet: ref SectionSet; const AEntry: string;
  const APaths: StringArray; const ARuntime: ref CRuntimeFacts): ByteArray;
var
  LReports: ref Diagnostics;
  LSettings: ref ExeSettings;
  LLibraries: StringArray;
  LDebug: ByteArray;
  LImage: ByteArray;
begin
  LReports := ref Diagnostics(100);
  LSettings := ref ExeSettings();
  LImage := ABackend.Format.LinkExe(ASet, AEntry, "", APaths, ARuntime, LSettings, nil, LReports,
    LLibraries, LDebug);
  LReports.PrintAll();
  if len(LImage) > 0 then
    println("{}", "linked: needs " + JoinStrings(LLibraries, ", "));
  end;
  return LImage;
end;

// The u64 / u32 / u16 at AAt of ABytes
func U64(const ABytes: ByteArray; const AAt: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, 8));
end;

func U32(const ABytes: ByteArray; const AAt: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, 4));
end;

func U16(const ABytes: ByteArray; const AAt: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, 2));
end;

// AValue as 0x and hex digits
func Hex(const AValue: int64): string;
begin
  return "0x" + IntToHex(uint64(AValue), 1);
end;

// The NUL-ended text at AAt of ABytes
func TextAt(const ABytes: ByteArray; const AAt: int64): string;
var
  LI: int64;
begin
  LI := AAt;
  while (LI < len(ABytes)) and (ABytes[LI] <> 0) do
    LI := LI + 1;
  end;
  if LI = AAt then
    return "";
  end;
  return StringFromC(ptr to const char(addr of ABytes[AAt]), LI - AAt);
end;

// The image's ELF header and program headers, as readelf -hl gives them
func ShowHeaders(const ABytes: ByteArray);
var
  LAt: int64;
  LI: int64;
begin
  println("{}", "image " + IntToStr(len(ABytes)) + " bytes type " + IntToStr(U16(ABytes, 16)) +
    " entry " + Hex(U64(ABytes, 24)) + " phnum " + IntToStr(U16(ABytes, 56)) + " shnum " +
    IntToStr(U16(ABytes, 60)));
  for LI := 0 to U16(ABytes, 56) - 1 do
    LAt := U64(ABytes, 32) + LI * 56;
    println("{}", "phdr " + Hex(U32(ABytes, LAt)) + " flags " + IntToStr(U32(ABytes, LAt + 4)) +
      " offset " + Hex(U64(ABytes, LAt + 8)) + " vaddr " + Hex(U64(ABytes, LAt + 16)) + " filesz " +
      Hex(U64(ABytes, LAt + 32)) + " memsz " + Hex(U64(ABytes, LAt + 40)) + " align " +
      Hex(U64(ABytes, LAt + 48)));
  end;
end;

// The image's sections as the reader reads them
func ShowSections(const ABytes: ByteArray; var AObject: ELFObjectData): bool;
var
  LReports: ref Diagnostics;
  LSection: ELFSection;
  LI: int64;
begin
  LReports := ref Diagnostics(100);
  if not ReadELFObject(ABytes, 0, len(ABytes), "image", NoPlace(), LReports, AObject) then
    LReports.PrintAll();
    return false;
  end;
  for LI := 1 to len(AObject.Sections) - 1 do
    LSection := AObject.Sections[LI];
    println("{}", "[" + IntToStr(LI) + "] '" + LSection.SectionName + "' type " +
      Hex(LSection.SectionType) + " flags " + Hex(LSection.Flags) + " addr " +
      Hex(LSection.Address) + " size " + Hex(LSection.DataSize) + " link " +
      IntToStr(LSection.Link) + " info " + IntToStr(LSection.Info) + " entsize " +
      IntToStr(LSection.EntrySize));
  end;
  return true;
end;

// The section of AObject named AName; its index, 0 for none
func SectionNamed(const AObject: ELFObjectData; const AName: string): int64;
var
  LI: int64;
begin
  for LI := 1 to len(AObject.Sections) - 1 do
    if AObject.Sections[LI].SectionName = AName then
      return LI;
    end;
  end;
  return 0;
end;

// The name of .dynsym's symbol AIndex
func DynName(const ABytes: ByteArray; const AObject: ELFObjectData; const AIndex: int64): string;
var
  LSym: int64;
  LStr: int64;
begin
  LSym := AObject.Sections[SectionNamed(AObject, ".dynsym")].DataAt;
  LStr := AObject.Sections[SectionNamed(AObject, ".dynstr")].DataAt;
  return TextAt(ABytes, LStr + U32(ABytes, LSym + AIndex * 24));
end;

// The dynamic tables decoded (see the header)
func ShowDynamic(const ABytes: ByteArray; const AObject: ELFObjectData);
var
  LDyn: ELFSection;
  LSym: ELFSection;
  LVer: ELFSection;
  LNeed: ELFSection;
  LRela: ELFSection;
  LStr: int64;
  LAt: int64;
  LAux: int64;
  LTag: int64;
  LCount: int64;
  LI: int64;
  LJ: int64;
begin
  LStr := AObject.Sections[SectionNamed(AObject, ".dynstr")].DataAt;
  LDyn := AObject.Sections[SectionNamed(AObject, ".dynamic")];
  LAt := LDyn.DataAt;
  repeat
    LTag := U64(ABytes, LAt);
    if LTag = DT_NEEDED then
      println("{}", "dyn NEEDED " + TextAt(ABytes, LStr + U64(ABytes, LAt + 8)));
    else
      println("{}", "dyn " + Hex(LTag) + " " + Hex(U64(ABytes, LAt + 8)));
    end;
    LAt := LAt + 16;
  until LTag = DT_NULL;
  LSym := AObject.Sections[SectionNamed(AObject, ".dynsym")];
  LVer := AObject.Sections[SectionNamed(AObject, ".gnu.version")];
  LCount := LSym.DataSize div 24;
  for LI := 1 to LCount - 1 do
    LAt := LSym.DataAt + LI * 24;
    println("{}", "dynsym " + IntToStr(LI) + " '" + DynName(ABytes, AObject, LI) + "' bind " +
      IntToStr(int64(ABytes[LAt + 4]) shr 4) + " type " + IntToStr(int64(ABytes[LAt + 4]) & 0xF) +
      " shndx " + IntToStr(U16(ABytes, LAt + 6)) + " version " +
      IntToStr(U16(ABytes, LVer.DataAt + LI * 2)));
  end;
  LNeed := AObject.Sections[SectionNamed(AObject, ".gnu.version_r")];
  LAt := LNeed.DataAt;
  for LI := 0 to LNeed.Info - 1 do
    println("{}", "verneed " + TextAt(ABytes, LStr + U32(ABytes, LAt + 4)) + " count " +
      IntToStr(U16(ABytes, LAt + 2)));
    LAux := LAt + U32(ABytes, LAt + 8);
    for LJ := 0 to U16(ABytes, LAt + 2) - 1 do
      println("{}", "  vernaux " + TextAt(ABytes, LStr + U32(ABytes, LAux + 8)) + " index " +
        IntToStr(U16(ABytes, LAux + 6)) + " hash " + Hex(U32(ABytes, LAux)));
      LAux := LAux + U32(ABytes, LAux + 12);
    end;
    LAt := LAt + U32(ABytes, LAt + 12);
  end;
  LRela := AObject.Sections[SectionNamed(AObject, ".rela.dyn")];
  for LI := 0 to (LRela.DataSize div 24) - 1 do
    LAt := LRela.DataAt + LI * 24;
    println("{}", "rela " + Hex(U64(ABytes, LAt)) + " type " + IntToStr(U32(ABytes, LAt + 8)) +
      " '" + DynName(ABytes, AObject, U32(ABytes, LAt + 12)) + "' addend " + IntToStr(U64(ABytes, LAt + 16)));
  end;
end;

// .eh_frame_hdr checked: its header, then each entry's FDE (a record whose CIE pointer is not
// 0) and its initial location (pcrel sdata4, clang's) against the entry, the locations
// ascending
func ShowFrameIndex(const ABytes: ByteArray; const AObject: ELFObjectData);
var
  LHdr: ELFSection;
  LCount: int64;
  LLoc: int64;
  LFde: int64;
  LFdeLoc: int64;
  LLast: int64;
  LSorted: bool;
  LMatch: bool;
  LI: int64;
begin
  LHdr := AObject.Sections[SectionNamed(AObject, ".eh_frame_hdr")];
  LCount := U32(ABytes, LHdr.DataAt + 8);
  println("{}", "eh_frame_hdr version " + IntToStr(int64(ABytes[LHdr.DataAt])) + " encodings " +
    Hex(int64(ABytes[LHdr.DataAt + 1])) + " " + Hex(int64(ABytes[LHdr.DataAt + 2])) + " " +
    Hex(int64(ABytes[LHdr.DataAt + 3])) + " eh_frame " +
    Hex(LHdr.Address + 4 + ReadLowBits((U32(ABytes, LHdr.DataAt + 4)), 32, true)) + " fdes " +
    IntToStr(LCount));
  LSorted := true;
  LMatch := true;
  LLast := 0;
  for LI := 0 to LCount - 1 do
    LLoc := LHdr.Address + ReadLowBits((U32(ABytes, LHdr.DataAt + 12 + LI * 8)), 32, true);
    LFde := LHdr.Address + ReadLowBits((U32(ABytes, LHdr.DataAt + 16 + LI * 8)), 32, true);
    // the FDE's pc_begin field sits past its length and CIE pointer
    LFdeLoc := LFde + 8 + ReadLowBits((U32(ABytes, LFde + 8 - 0x400000)), 32, true);
    if (U32(ABytes, LFde + 4 - 0x400000) = 0) or (LFdeLoc <> LLoc) then
      LMatch := false;
    end;
    if LLoc < LLast then
      LSorted := false;
    end;
    LLast := LLoc;
  end;
  println("{}", "eh_frame_hdr sorted " + YesNo(LSorted) + " each entry its FDE " + YesNo(LMatch));
end;

// A one-routine program set entered at lx3b_go whose code reads ATarget (Rel32 at 3: an
// import of ALibrary, "" a plain Undefined name)
func ReadSet(const ALibrary: string; const ATarget: string): ref SectionSet;
var
  LSet: ref SectionSet;
  LId: int64;
  LSymbol: int64;
begin
  LSet := ref SectionSet();
  LId := Defined(LSet, ".text", SectionKind.Code, "lx3b_go", ReadBytes(), 16);
  if ALibrary = "" then
    LSymbol := LSet.ReferSymbol(ATarget, 0);
  else
    LSymbol := LSet.ImportSymbol(ALibrary, ATarget, 0);
  end;
  LSet.AddReloc(LId, 3, RelocKind.Rel32, LSymbol, 0);
  return LSet;
end;

// ABackend's C runtime with its version table named ATable
func RuntimeWith(const ABackend: ref Backend; const ATable: string): ref CRuntimeFacts;
var
  LRuntime: ref CRuntimeFacts;
begin
  LRuntime := ABackend.ABI.CRuntime();
  LRuntime.SharedTable := ATable;
  return LRuntime;
end;

// The reports of the links that fail, and the shared "dl" (see the header)
func ShowReports(const ABackend: ref Backend; const APaths: StringArray);
var
  LSet: ref SectionSet;
  LNowhere: StringArray;
  LId: int64;
begin
  println("{}", "-- reports");
  Link(ABackend, ReadSet("", "stdout"), "lx3b_go", APaths, ABackend.ABI.CRuntime());
  if not WriteAllText(HereDir() + "/lx3b_bad.abi", "# a damaged table\nputs GLIBC_2.2.5 libc.so.6\n") then
    println("the damaged table could not be written");
  end;
  Link(ABackend, ReadSet("", "puts"), "lx3b_go", APaths, RuntimeWith(ABackend, "lx3b_bad.abi"));
  if not WriteAllText(HereDir() + "/lx3b_nostart.abi", "puts GLIBC_2.2.5 libc.so.6 F\n") then
    println("the start-less table could not be written");
  end;
  Link(ABackend, ReadSet("", "puts"), "lx3b_go", APaths, RuntimeWith(ABackend, "lx3b_nostart.abi"));
  setlength(LNowhere, 1);
  LNowhere[0] := "nolibs";
  Link(ABackend, ReadSet("", "puts"), "lx3b_go", LNowhere, ABackend.ABI.CRuntime());
  LSet := ReadSet("", "lx3b_go");
  LId := LSet.AddSection(".eh_frame#lx3b_bad", SectionKind.ReadOnly, 4);
  LSet.SectionAt(LId).GroupName := ".eh_frame";
  Put(LSet, LId, [0x10, 0, 0, 0, 0, 0]);
  Link(ABackend, LSet, "lx3b_go", APaths, ABackend.ABI.CRuntime());
  Link(ABackend, ReadSet("dl", "dlerror"), "lx3b_go", APaths, ABackend.ABI.CRuntime());
end;

var
  LBackend: ref Backend;
  LObjects: ObjectFileArray;
  LImage: ByteArray;
  LObject: ELFObjectData;
  LOutput: ref Lines;
  LNone: StringArray;
  LExit: uint32;
  LStarted: bool;
  LI: int64;
begin
  LBackend := BackendFor(LINUX_TRIPLE);
  setlength(LObjects, 1);
  LObjects[0].MemberName := "lx3b_weak";
  LObjects[0].Bytes := MemberBytes(LBackend);
  if not WriteAllBytes(HereDir() + "/liblx3b.a", LBackend.Format.WriteStaticLibrary(LObjects)) then
    println("the library could not be written");
  end;
  LImage := Link(LBackend, ProgramSet(), "lx3b_main", Paths(), LBackend.ABI.CRuntime());
  if len(LImage) > 0 then
    ShowHeaders(LImage);
    if ShowSections(LImage, LObject) then
      ShowDynamic(LImage, LObject);
      ShowFrameIndex(LImage, LObject);
    end;
    if not WriteAllBytes(HereDir() + "/lx3b_dynamic", LImage) then
      println("the image could not be written");
    end;
    LOutput := ref Lines();
    setlength(LNone, 0);
    LStarted := RunELF(HereDir() + "/lx3b_dynamic", LNone, HereDir(), LExit, LOutput,
      ProcessCapture.Pipes, nil);
    println("{}", "run on linux: started " + YesNo(LStarted) + " exit " + IntToStr(int64(LExit)));
    for LI := 0 to len(LOutput.Items) - 1 do
      println("{}", "  [" + LOutput.Items[LI] + "]");
    end;
  end;
  ShowReports(LBackend, Paths());
end.
