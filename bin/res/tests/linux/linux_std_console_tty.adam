  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  linux_std_console_tty.adam - System.Console.Linux64 on a real terminal
  (PLAN-LINUX64 LX5b): a pseudo terminal (posix_openpt) is made standard
  input and output for the checks, its size set to 120 x 40, keys typed
  into its master side. A terminal with escapes and its size; raw-mode keys
  as Windows gives them (a, an arrow passed over, b, Backspace "\x08",
  Enter "\r", a 2-byte UTF-8 character, Alt+x "x", F1 passed over, z, a
  lone Escape after its wait); AnyKeyPressed before and after; dropped keys
  gone; lines read through the terminal's own line editing (an erased
  character, the end at Ctrl+D); a terminal never closes with the program.
  The real descriptors come back before anything is printed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ok pty
  | ok terminal
  | ok escapes
  | ok size
  | ok nothing waiting
  | ok key waiting
  | ok key a
  | ok key b past arrow
  | ok key backspace
  | ok key enter
  | ok key utf8
  | ok key alt
  | ok key z past f1
  | ok key escape
  | ok nothing left
  | ok keys dropped
  | ok line edited
  | ok line second
  | ok line end
  | ok never closes
  | ok restored
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_std_console_tty;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_std_console_tty runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

import System.SysUtils, System.IO, System.Console, System.Console.Linux64, System.Linux;

const
  // fcntl.h: open for reading and writing, never as the controlling terminal
  O_RDWR: int32 = 2;
  O_NOCTTY: int32 = 0x100;
  // Ctrl+D: a terminal line holding it alone is the end of input
  CTRL_D: string = "\x04";

routine posix_openpt(const AFlags: int32): int32; external "c";
routine grantpt(const AFd: int32): int32; external "c";
routine unlockpt(const AFd: int32): int32; external "c";
routine ptsname(const AFd: int32): ptr to char; external "c";
routine open(const APath: ptr to const char; const AFlags: int32; ...): int32; external "c";
routine write(const AFd: int32; const AData: ptr to const; const ASize: uint64): int64; external "c";
routine dup(const AFd: int32): int32; external "c";
routine dup2(const AFd: int32; const ATarget: int32): int32; external "c";
routine close(const AFd: int32): int32; external "c";

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// AText typed into the terminal's master side, byte by byte, then a moment for the terminal
// to hand it on
routine TypeKeys(const AMaster: int32; const AText: string);
var
  LI: int64;
  LByte: uint8;
begin
  for LI := 0 to len(AText) - 1 do
    LByte := uint8(AText[LI]);
    write(AMaster, addr of LByte, 1);
  end;
  Delay(50);
end;

// The slave's modes with line editing and echo off (and CR kept CR), so keys typed ahead
// arrive as they are; false when they cannot be set
routine KeysAsTyped(const ASlave: int32): bool;
var
  LTerm: termios;
begin
  if tcgetattr(ASlave, LTerm) <> 0 then
    return false;
  end;
  LTerm.c_lflag := LTerm.c_lflag & ~(ICANON | ECHO);
  LTerm.c_iflag := LTerm.c_iflag & ~ICRNL;
  return tcsetattr(ASlave, TCSANOW, addr of LTerm) = 0;
end;

routine Run();
var
  LMaster: int32;
  LSlave: int32;
  LIn: int32;
  LOut: int32;
  LSize: winsize;
  LCanonical: termios;
  LOk: array[0..19] of bool;
  LNames: array[0..19] of string;
  LCount: int32;
  LLine: string;
  LI: int32;
begin
  LMaster := posix_openpt(O_RDWR | O_NOCTTY);
  LSlave := -1;
  if (LMaster >= 0) and (grantpt(LMaster) = 0) and (unlockpt(LMaster) = 0) then
    LSlave := open(ptsname(LMaster), O_RDWR | O_NOCTTY);
  end;
  Check("pty", LSlave >= 0);
  if LSlave < 0 then
    return;
  end;
  LSize.ws_row := 40;
  LSize.ws_col := 120;
  LSize.ws_xpixel := 0;
  LSize.ws_ypixel := 0;
  ioctl(LSlave, TIOCSWINSZ, addr of LSize);
  tcgetattr(LSlave, LCanonical);

  // The terminal becomes standard input and output: nothing is printed until they come back
  FlushOutput();
  LIn := dup(STDIN_FILENO);
  LOut := dup(STDOUT_FILENO);
  dup2(LSlave, STDIN_FILENO);
  dup2(LSlave, STDOUT_FILENO);
  LCount := 0;

  LNames[LCount] := "terminal";
  LOk[LCount] := IsTerminal();
  LCount := LCount + 1;
  LNames[LCount] := "escapes";
  LOk[LCount] := EscapesEnabled();
  LCount := LCount + 1;
  LNames[LCount] := "size";
  LOk[LCount] := (GetTerminalWidth() = 120) and (GetTerminalHeight() = 40);
  LCount := LCount + 1;
  LNames[LCount] := "nothing waiting";
  LOk[LCount] := not AnyKeyPressed();
  LCount := LCount + 1;

  // Keys typed ahead: a, Up, b, Backspace, Enter, U+00E9, Alt+x, F1, z, a lone Escape
  KeysAsTyped(LSlave);
  TypeKeys(LMaster, "a\x1b[Ab\x7f\r\xc3\xa9\x1bx\x1bOPz\x1b");
  LNames[LCount] := "key waiting";
  LOk[LCount] := AnyKeyPressed();
  LCount := LCount + 1;
  LNames[LCount] := "key a";
  LOk[LCount] := ReadKey() = "a";
  LCount := LCount + 1;
  LNames[LCount] := "key b past arrow";
  LOk[LCount] := ReadKey() = "b";
  LCount := LCount + 1;
  LNames[LCount] := "key backspace";
  LOk[LCount] := ReadKey() = KeyBackspace;
  LCount := LCount + 1;
  LNames[LCount] := "key enter";
  LOk[LCount] := IsEnterKey(ReadKey());
  LCount := LCount + 1;
  LNames[LCount] := "key utf8";
  LOk[LCount] := ReadKey() = "\xc3\xa9";
  LCount := LCount + 1;
  LNames[LCount] := "key alt";
  LOk[LCount] := ReadKey() = "x";
  LCount := LCount + 1;
  LNames[LCount] := "key z past f1";
  LOk[LCount] := ReadKey() = "z";
  LCount := LCount + 1;
  LNames[LCount] := "key escape";
  LOk[LCount] := IsEscapeKey(ReadKey());
  LCount := LCount + 1;
  LNames[LCount] := "nothing left";
  LOk[LCount] := not AnyKeyPressed();
  LCount := LCount + 1;

  TypeKeys(LMaster, "qq");
  ConsolePlatformDropKeys();
  LNames[LCount] := "keys dropped";
  LOk[LCount] := not AnyKeyPressed();
  LCount := LCount + 1;

  // Lines: the terminal's own editing (DEL erases the X), then the end at Ctrl+D
  tcsetattr(LSlave, TCSANOW, addr of LCanonical);
  TypeKeys(LMaster, "helX\x7flo\nworld\n" + CTRL_D);
  LLine := "";
  LNames[LCount] := "line edited";
  LOk[LCount] := ReadLn(LLine) and (LLine = "hello");
  LCount := LCount + 1;
  LNames[LCount] := "line second";
  LOk[LCount] := ReadLn(LLine) and (LLine = "world");
  LCount := LCount + 1;
  LNames[LCount] := "line end";
  LOk[LCount] := (not ReadLn(LLine)) and (LLine = "");
  LCount := LCount + 1;
  LNames[LCount] := "never closes";
  LOk[LCount] := not ConsolePlatformClosesWithProgram();
  LCount := LCount + 1;

  dup2(LIn, STDIN_FILENO);
  dup2(LOut, STDOUT_FILENO);
  close(LIn);
  close(LOut);
  close(LSlave);
  close(LMaster);
  for LI := 0 to LCount - 1 do
    Check(LNames[LI], LOk[LI]);
  end;
  Check("restored", isatty(STDOUT_FILENO) = 0);
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
