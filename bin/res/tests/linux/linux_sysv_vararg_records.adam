-------------------------------------------------------------------------------
  linux_sysv_vararg_records.adam - variadic aggregates through the ABI parts
  (Adam.SysV.Abi / Adam.Win64.Abi, imported from the compiler's own src\,
  beside bin\; PLAN-LINUX64 LX1b2): a variadic call site's shaped arguments
  placed as named ones (System V: an SSE + INTEGER record in xmm0 + rsi, a
  MEMORY one copied to the stack, two floats in one vector register, al
  counting the vector registers), and how a variadic function reads each
  one back (LayoutVariadicAggregate): its eightbyte pieces from the
  register save area or its overflow place (aligned to 16 for a 16-aligned
  record, MEMORY for a packed one); Win64: one 8-byte place, the bytes of a
  1 / 2 / 4 / 8-byte record there, any other the address of the caller's copy
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | arg 0 rdi
  | arg 1 pieces xmm0@0+8 rsi@8+8
  | arg 2 stack call +0 entry +8 bytes 24
  | arg 3 pieces xmm1@0+8
  | arg 4 rdx
  | result none
  | outgoing 24
  | vectors rax 2
  | vararg pieces f 0+8 i 8+8 overflow 16 align 8
  | vararg overflow 24 align 8
  | vararg pieces f 0+8 overflow 8 align 8
  | vararg overflow 32 align 16
  | vararg pieces i 0+8 i 8+4 overflow 16 align 8
  | vararg overflow 8 align 8
  | arg 0 rcx
  | arg 1 pieces rdx@0+8
  | arg 2 r8
  | result none
  | outgoing 32
  | vararg overflow 8 align 8
  | vararg by address overflow 8 align 8
  | vararg by address overflow 8 align 8
  | vararg by address overflow 8 align 8
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_sysv_vararg_records;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Backend.Ssa, Adam.Backend.Parts, Adam.SysV.Abi, Adam.Win64.Abi;

// An aggregate of ASize bytes aligned to AAlign, one leaf of ALeaf bytes at AAt (a float's
// when AFloat) and a second of ASecond bytes after it (none: 0)
routine Shape(const ASize: int64; const AAlign: int64; const AAt: int64; const ALeaf: int64;
  const AFloat: bool; const ASecond: int64; const ASecondFloat: bool): ref IrAggregate;
var
  LShape: ref IrAggregate;
begin
  LShape := ref IrAggregate(ASize, AAlign);
  LShape.AddLeaf(AAt, ALeaf, AAlign, AFloat);
  if ASecond > 0 then
    LShape.AddLeaf(AAt + ALeaf, ASecond, AAlign, ASecondFloat);
  end;
  return LShape;
end;

var
  GSysV: ref SysVAbi;
  GWin64: ref Win64Abi;
  GSite: ref IrSignature;
  GMixed: ref IrAggregate;
  GBig: ref IrAggregate;
  GFloats: ref IrAggregate;
  GWide: ref IrAggregate;
  GTwelve: ref IrAggregate;
  GPacked: ref IrAggregate;
  GPair: ref IrAggregate;
  GRgb: ref IrAggregate;

begin
  GSysV := ref SysVAbi();
  GWin64 := ref Win64Abi();
  // { float64; int64 }, { int64 x 3 }, { float32; float32 }, 32 bytes aligned 16,
  // { int32 x 3 }, a packed { uint8; int32 } (its int32 at 1: unaligned)
  GMixed := Shape(16, 8, 0, 8, true, 8, false);
  GBig := Shape(24, 8, 0, 24, false, 0, false);
  GFloats := Shape(8, 4, 0, 4, true, 4, true);
  GWide := Shape(32, 16, 0, 32, false, 0, false);
  GTwelve := Shape(12, 4, 0, 12, false, 0, false);
  GPacked := ref IrAggregate(5, 1);
  GPacked.AddLeaf(0, 1, 1, false);
  GPacked.AddLeaf(1, 4, 4, false);
  // a call site of f(fmt, mixed, big, floats, n): each record placed as a named one
  GSite := ref IrSignature(IrType.Void);
  GSite.Variadic := true;
  GSite.AddParam(IrType.Pointer);
  GSite.AddShapedParam(GMixed);
  GSite.AddShapedParam(GBig);
  GSite.AddShapedParam(GFloats);
  GSite.AddParam(IrType.Int64);
  print(GSysV.LayoutCall(GSite).Text());
  // va_arg of each
  print(GSysV.LayoutVariadicAggregate(GMixed).Text());
  print(GSysV.LayoutVariadicAggregate(GBig).Text());
  print(GSysV.LayoutVariadicAggregate(GFloats).Text());
  print(GSysV.LayoutVariadicAggregate(GWide).Text());
  print(GSysV.LayoutVariadicAggregate(GTwelve).Text());
  print(GSysV.LayoutVariadicAggregate(GPacked).Text());
  // Win64: { int32; int32 } (8 bytes), { uint8 x 3 }, { int32 x 3 }, { float64; int64 }
  GPair := Shape(8, 4, 0, 8, false, 0, false);
  GRgb := Shape(3, 1, 0, 3, false, 0, false);
  GSite := ref IrSignature(IrType.Void);
  GSite.Variadic := true;
  GSite.AddParam(IrType.Pointer);
  GSite.AddShapedParam(GPair);
  GSite.AddShapedParam(GTwelve);
  print(GWin64.LayoutCall(GSite).Text());
  print(GWin64.LayoutVariadicAggregate(GPair).Text());
  print(GWin64.LayoutVariadicAggregate(GRgb).Text());
  print(GWin64.LayoutVariadicAggregate(GTwelve).Text());
  print(GWin64.LayoutVariadicAggregate(GMixed).Text());
end.
