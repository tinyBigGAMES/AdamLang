-------------------------------------------------------------------------------
  linux_hookio_modes.adam - System.HookIO's glibc mode rules on
  x86_64-linux-gnu (PLAN-LINUX64 LX3d3c2b)

  fixtures\liblinux_hookio_c.a (scripts\adam\make_linux_fixtures.cmd)
  opens a registered memory IO and a real file of the same bytes in each of
  glibc's modes (its first letters with + and b, the letters it skips or
  takes, ccs=, x on an existing file, the refused ones) and reports the open,
  its errno, a byte, the orientation and what the stream may do: every slot
  of the IO's equals the real file's. Then fopen64, freopen(NULL) to "r+b"
  (the start again, writable) and freopen64 onto a second IO, against the
  same on two real files.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ok modes register
  | ok modes real files
  | ok mode [r] as real file
  | ok mode [rb] as real file
  | ok mode [r+] as real file
  | ok mode [rq] as real file
  | ok mode [r++] as real file
  | ok mode [rx] as real file
  | ok mode [rbcSTN] as real file
  | ok mode [rme] as real file
  | ok mode [r,ccs=UTF-8] as real file
  | ok mode [r+,ccs=UTF-8] as real file
  | ok mode [r,ccs=NOSUCH] as real file
  | ok mode [wx] as real file
  | ok mode [w+x] as real file
  | ok mode [ax] as real file
  | ok mode [a+x] as real file
  | ok mode [  r] as real file
  | ok mode [] as real file
  | ok mode [q] as real file
  | ok mode [b] as real file
  | ok mode [+r] as real file
  | ok reopen kept
  | ok reopen as real file
  | ok modes unregister
  | ok modes io close
  | ok modes real removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_hookio_modes;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "linux_hookio_modes runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

@addlibrarypath "$P:res/tests/linux/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO, System.HookIO.Linux64;

func clink linux_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to uint8;
  ACount: clong): int32; external "linux_hookio_c";
func clink linux_hookio_c_sample(ABuffer: ptr to uint8; ACap: clong): clong;
  external "linux_hookio_c";
func clink linux_hookio_c_mode(APath: ptr to const char; AMode: ptr to const char;
  AResults: ptr to int64); external "linux_hookio_c";
func clink linux_hookio_c_reopen(APath: ptr to const char; AOther: ptr to const char;
  AResults: ptr to int64); external "linux_hookio_c";

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst (the registered IO's) equal ASecond's (the real file's);
// the first that differs is printed
func SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
func RemovePath(const APath: string): bool;
var
  LOk: bool;
begin
  LOk := RemoveFile(APath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (glibc's own FILE)
func WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LResult: int32;
begin
  LResult := linux_hookio_c_writeraw(APath, ABytes, clong(ACount));
  return LResult = 0;
end;

// The C fixture's fopen of APath in AMode: its 7 slots in AResults
func ModeC(const APath: string; const AMode: string; const AResults: ptr to int64);
begin
  linux_hookio_c_mode(APath, AMode, AResults);
end;

// The C fixture's fopen64 / freopen(NULL) / freopen64 run from APath onto AOther: its 9 slots
func ReopenC(const APath: string; const AOther: string; const AResults: ptr to int64);
begin
  linux_hookio_c_reopen(APath, AOther, AResults);
end;

// Mode AIndex of the CModeCount glibc modes tried: the three first letters with + and b, the
// letters glibc skips (q, a second +, c / S / T / N) or takes for nothing an IO shows (x with r,
// m, e), ccs= (a wide stream; an unknown charset), x on an existing file (EEXIST), and the
// refused ones (a first letter not r / w / a, a leading space, an empty mode)
func ModeOf(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "r";
  end;
  if AIndex = 1 then
    return "rb";
  end;
  if AIndex = 2 then
    return "r+";
  end;
  if AIndex = 3 then
    return "rq";
  end;
  if AIndex = 4 then
    return "r++";
  end;
  if AIndex = 5 then
    return "rx";
  end;
  if AIndex = 6 then
    return "rbcSTN";
  end;
  if AIndex = 7 then
    return "rme";
  end;
  if AIndex = 8 then
    return "r,ccs=UTF-8";
  end;
  if AIndex = 9 then
    return "r+,ccs=UTF-8";
  end;
  if AIndex = 10 then
    return "r,ccs=NOSUCH";
  end;
  if AIndex = 11 then
    return "wx";
  end;
  if AIndex = 12 then
    return "w+x";
  end;
  if AIndex = 13 then
    return "ax";
  end;
  if AIndex = 14 then
    return "a+x";
  end;
  if AIndex = 15 then
    return "  r";
  end;
  if AIndex = 16 then
    return "";
  end;
  if AIndex = 17 then
    return "q";
  end;
  if AIndex = 18 then
    return "b";
  end;
  return "+r";
end;

const
  CModeCount: int32 = 20;

// glibc's mode rules and the reopen family on a registered IO, each slot as glibc's own FILE
// gives it on a real file of the same bytes
func TestModes();
var
  LSample: array[0..63] of uint8;
  LOtherBytes: array[0..2] of uint8;
  LLength: clong;
  LMemory: IO;
  LOtherIO: IO;
  LPrefix: string;
  LOtherPrefix: string;
  LRealPath: string;
  LRealOther: string;
  LVirtual: array[0..8] of int64;
  LReal: array[0..8] of int64;
  LI: int32;
begin
  LRealPath := paramstr(0) + ".modes.txt";
  LRealOther := paramstr(0) + ".other.txt";
  LLength := linux_hookio_c_sample(addr of LSample[0], 64);
  LOtherBytes[0] := uint8('O');
  LOtherBytes[1] := uint8('t');
  LOtherBytes[2] := uint8('h');
  LMemory := CreateMemoryIO(addr of LSample[0], int64(LLength), false);
  LPrefix := RegisterIO(LMemory);
  LOtherIO := CreateMemoryIO(addr of LOtherBytes[0], 3, false);
  LOtherPrefix := RegisterIO(LOtherIO);
  Check("modes register", (LPrefix <> "") and (LOtherPrefix <> ""));
  Check("modes real files", WriteRaw(LRealPath, addr of LSample[0], int64(LLength)) and
    WriteRaw(LRealOther, addr of LOtherBytes[0], 3));

  for LI := 0 to CModeCount - 1 do
    ModeC(LPrefix + "/m.txt", ModeOf(LI), addr of LVirtual[0]);
    ModeC(LRealPath, ModeOf(LI), addr of LReal[0]);
    Check("mode [" + ModeOf(LI) + "] as real file", SameSlots(addr of LVirtual[0],
      addr of LReal[0], 7));
  end;

  ReopenC(LPrefix + "/m.txt", LOtherPrefix + "/o.txt", addr of LVirtual[0]);
  ReopenC(LRealPath, LRealOther, addr of LReal[0]);
  Check("reopen kept", (LVirtual[1] = 1) and (LVirtual[5] = 1) and (LVirtual[8] = 0));
  Check("reopen as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 9));

  Check("modes unregister", UnregisterIO(LPrefix) and UnregisterIO(LOtherPrefix));
  Check("modes io close", IOClose(LMemory) and IOClose(LOtherIO));
  Check("modes real removed", RemovePath(LRealPath) and RemovePath(LRealOther));
end;

begin
  GFails := 0;
  TestModes();
  println("done {}", GFails);
end.
