-------------------------------------------------------------------------------
  linux_std_io.adam - System.IO the same on both targets (PLAN-LINUX64 LX5a:
  System.IO.Linux64 beside System.IO.Win64; the targets line builds it for
  both with -t, the linux one run through RunELF): folders made (nested, one,
  refusals), the whole-file reads and writes (System.IO's own, a 1048583-byte
  file byte for byte), a file's kind / size / write time and a folder's
  refusals, ReplaceFile, GetFiles / GetDirectories in byte order, ResolvePath
  ($P: folding, '\\' read as '/', a base folder, $R: / "" / a prefix alone
  ""), SamePath, SystemDir, UserCacheDir's form, ExeDir, TempDir,
  RenameFile, SetFileReadOnly, the environment variables, SecureRandomBytes,
  the clocks and Delay, RemoveDir's refusals. Each line ok or FAIL with its
  name; everything made is removed at the end.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok made
  | ok forced again
  | ok forced folder
  | ok dir exists
  | ok dir missing parent
  | ok created
  | ok created again
  | ok text written
  | ok text kind
  | ok text size
  | ok text read
  | ok write time
  | ok folder size
  | ok folder time
  | ok folder not file
  | ok big written
  | ok big read
  | ok big same
  | ok replaced
  | ok replaced text
  | ok replaced source gone
  | ok replace onto folder
  | ok files B.txt,one.txt,two.txt
  | ok dirs a,c
  | ok missing list
  | ok resolve fold
  | ok resolve end
  | ok resolve slashes
  | ok resolve base
  | ok resolve r
  | ok resolve empty
  | ok resolve prefix only
  | ok same path
  | ok other path
  | ok system dir
  | ok cache dir
  | ok exe dir
  | ok temp dir
  | ok renamed
  | ok rename onto file refused
  | ok rename missing refused
  | ok read-only
  | ok read-only folder refused
  | ok env set
  | ok env replaced
  | ok env empty
  | ok env unset
  | ok remove full refused
  | ok remove file refused
  | ok random 64
  | ok random 0
  | ok tick
  | ok perf
  | ok frequency
  | ok delay 0
  | ok cleaned
  | ok delete folder
  | ok folders removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_std_io;

import System.SysUtils, System.IO;

const
  // More than any one read the platform does, and no power of two
  BIG_COUNT: int64 = 1048583;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// ACount bytes, each from its index, in a pattern no chunk size divides
func PatternBytes(const ACount: int64): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, ACount);
  for LI := 0 to ACount - 1 do
    LBytes[LI] := uint8((LI * 31 + 7) mod 251);
  end;
  return LBytes;
end;

// True when AFirst and ASecond hold the same bytes
func SameBytes(const AFirst: ByteArray; const ASecond: ByteArray): bool;
var
  LI: int64;
begin
  if len(AFirst) <> len(ASecond) then
    return false;
  end;
  for LI := 0 to len(AFirst) - 1 do
    if AFirst[LI] <> ASecond[LI] then
      return false;
    end;
  end;
  return true;
end;

// True when some byte of ABytes is not 0
func AnySet(const ABytes: ByteArray): bool;
var
  LI: int64;
begin
  for LI := 0 to len(ABytes) - 1 do
    if ABytes[LI] <> 0 then
      return true;
    end;
  end;
  return false;
end;

// The files / folders made and read back
func RunFiles(const ADir: string);
var
  LText: string;
  LBig: ByteArray;
  LRead: ByteArray;
  LList: StringArray;
  LHad: bool;
begin
  Check("made", ForceDirectories(ADir + "/a/b"));
  Check("forced again", ForceDirectories(ADir + "/a/b"));
  Check("forced folder", DirectoryExists(ADir + "/a/b") and not FileExists(ADir + "/a/b"));
  Check("dir exists", not CreateDir(ADir + "/a"));
  Check("dir missing parent", not CreateDir(ADir + "/none/x"));
  LHad := DirectoryExists(ADir + "/c");
  Check("created", (CreateDir(ADir + "/c") <> LHad) and DirectoryExists(ADir + "/c"));
  Check("created again", not CreateDir(ADir + "/c"));
  Check("text written", WriteAllText(ADir + "/a/one.txt", "hello"));
  Check("text kind", FileExists(ADir + "/a/one.txt") and not DirectoryExists(ADir + "/a/one.txt"));
  Check("text size", FileSize(ADir + "/a/one.txt") = 5);
  Check("text read", ReadAllText(ADir + "/a/one.txt", LText) and (LText = "hello"));
  Check("write time", FileWriteTime(ADir + "/a/one.txt") > 0);
  Check("folder size", FileSize(ADir + "/a") = -1);
  Check("folder time", FileWriteTime(ADir + "/a") = -1);
  Check("folder not file", not FileExists(ADir + "/a") and not ReadAllText(ADir + "/a", LText));
  LBig := PatternBytes(BIG_COUNT);
  Check("big written", WriteAllBytes(ADir + "/a/two.txt", LBig));
  Check("big read", ReadAllBytes(ADir + "/a/two.txt", LRead));
  Check("big same", SameBytes(LBig, LRead) and (FileSize(ADir + "/a/two.txt") = BIG_COUNT));
  Check("replaced", WriteAllText(ADir + "/a/B.txt", "new") and
    WriteAllText(ADir + "/a/tmp.txt", "newer") and
    ReplaceFile(ADir + "/a/tmp.txt", ADir + "/a/B.txt"));
  Check("replaced text", ReadAllText(ADir + "/a/B.txt", LText) and (LText = "newer"));
  Check("replaced source gone", not FileExists(ADir + "/a/tmp.txt"));
  Check("replace onto folder", not ReplaceFile(ADir + "/a/B.txt", ADir + "/c"));
  Check("files B.txt,one.txt,two.txt", GetFiles(ADir + "/a", LList) and
    (JoinStrings(LList, ",") = "B.txt,one.txt,two.txt"));
  Check("dirs a,c", GetDirectories(ADir, LList) and (JoinStrings(LList, ",") = "a,c"));
  Check("missing list", not GetFiles(ADir + "/none", LList) and (len(LList) = 0));
end;

// The path rules
func RunPaths(const ADir: string);
var
  LFolded: string;
  LCache: string;
begin
  LFolded := ResolvePath("$P:x/./y/../z");
  Check("resolve fold", (LFolded <> "") and (LFolded = ResolvePath("$P:x/z")));
  Check("resolve end", EndsStr("/x/z", LFolded));
  Check("resolve slashes", ResolvePath("$P:x\\y\\..\\z") = LFolded);
  Check("resolve base", ResolvePath("q/r", ADir) = ADir + "/q/r");
  Check("resolve r", ResolvePath("$R:x") = "");
  Check("resolve empty", ResolvePath("  ") = "");
  Check("resolve prefix only", ResolvePath("$P:") = "");
  Check("same path", SamePath(ADir + "/a/./one.txt", ADir + "/a/b/../one.txt"));
  Check("other path", not SamePath(ADir + "/a/one.txt", ADir + "/a/two.txt"));
  Check("system dir", DirectoryExists(SystemDir()));
  LCache := UserCacheDir();
  Check("cache dir", (LCache = "") or (ResolvePath(LCache) = LCache));
end;

// The generator and the clocks
func RunClocks();
var
  LBytes: ByteArray;
  LTick: int64;
  LCounter: int64;
begin
  Check("random 64", SecureRandomBytes(64, LBytes) and (len(LBytes) = 64) and AnySet(LBytes));
  Check("random 0", SecureRandomBytes(0, LBytes) and (len(LBytes) = 0));
  LTick := TickCountMs();
  LCounter := PerformanceCounter();
  Delay(40);
  // The tick count's step may be one timer tick (about 16 ms on Windows)
  Check("tick", TickCountMs() - LTick >= 20);
  Check("perf", (PerformanceCounter() - LCounter) * 1000 div PerformanceFrequency() >= 39);
  Check("frequency", PerformanceFrequency() > 0);
  LTick := TickCountMs();
  Delay(0);
  Delay(-5);
  Check("delay 0", TickCountMs() - LTick < 1000);
end;

// ExeDir / TempDir, RenameFile, SetFileReadOnly, the environment, RemoveDir's refusals
func RunMore(const ADir: string);
begin
  Check("exe dir", (ExeDir() <> "") and (ResolvePath("$P:x") = ExeDir() + "/x"));
  Check("temp dir", DirectoryExists(TempDir()) and (ResolvePath(TempDir()) = TempDir()));
  Check("renamed", RenameFile(ADir + "/a/one.txt", ADir + "/a/three.txt") and
    FileExists(ADir + "/a/three.txt") and not FileExists(ADir + "/a/one.txt"));
  Check("rename onto file refused", not RenameFile(ADir + "/a/three.txt", ADir + "/a/two.txt"));
  Check("rename missing refused", not RenameFile(ADir + "/a/none.txt", ADir + "/a/x.txt"));
  Check("read-only", SetFileReadOnly(ADir + "/a/three.txt", true) and
    SetFileReadOnly(ADir + "/a/three.txt", false));
  Check("read-only folder refused", not SetFileReadOnly(ADir + "/a", true));
  Check("env set", SetEnvironmentVariable("ADAM_LX5A_VAR", "v1") and
    (GetEnvironmentVariable("ADAM_LX5A_VAR") = "v1"));
  Check("env replaced", SetEnvironmentVariable("ADAM_LX5A_VAR", "v2") and
    (GetEnvironmentVariable("ADAM_LX5A_VAR") = "v2"));
  Check("env empty", not SetEnvironmentVariable("", "v") and
    SetEnvironmentVariable("ADAM_LX5A_VAR", "") and (GetEnvironmentVariable("ADAM_LX5A_VAR") = ""));
  Check("env unset", GetEnvironmentVariable("ADAM_LX5A_NEVER_SET") = "");
  Check("remove full refused", not RemoveDir(ADir + "/a"));
  Check("remove file refused", not RemoveDir(ADir + "/a/two.txt"));
end;

func Run();
var
  LDir: string;
begin
  LDir := ResolvePath("$P:linux_std_io_d");
  RunFiles(LDir);
  RunPaths(LDir);
  RunMore(LDir);
  RunClocks();
  Check("cleaned", DeleteFile(LDir + "/a/three.txt") and DeleteFile(LDir + "/a/two.txt") and
    DeleteFile(LDir + "/a/B.txt") and not FileExists(LDir + "/a/three.txt"));
  Check("delete folder", not DeleteFile(LDir + "/a"));
  Check("folders removed", RemoveDir(LDir + "/a/b") and RemoveDir(LDir + "/a") and
    RemoveDir(LDir + "/c") and RemoveDir(LDir) and not DirectoryExists(LDir));
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
