-------------------------------------------------------------------------------
  linux_raven.adam - Raven v0.3.0 on both targets (PLAN-LINUX64 LX3d3b): the
  std unit System.Raven.C (cimport of Raven.h) over libraven.a (AdamLang-Libs
  build-raven.cmd), the same lines on x86_64-windows-gnu and x86_64-linux-gnu
  (the linux ELF run through RunELF): Rinit_ex with a headless null backend
  (no OS window, no GPU: Raven's own path for headless runs and tests), a
  window with a VBox holding a label and a button, a frame drawn, the tree
  and the texts read back, a text changed, then Rshutdown; on linux the
  program links libX11.so.6 (libX11.abi) and libraven.a's general-dynamic
  TLS is relaxed to local-exec (LX3d2)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | init 1
  | window true title raven window
  | children 2 vbox true
  | frame 1
  | label changed button true
  | frame 1
  | done
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_raven;

import System.SysUtils, System.Raven.C;

var
  LDesc: RInitDesc;
  LWindow: Rid;
  LBox: Rid;
  LLabel: Rid;
  LButton: Rid;
begin
  LDesc.backend := R_BACKEND_NULL;
  LDesc.app_name := "linux_raven";
  LDesc.headless := 1;
  LDesc.disable_render_thread := 1;
  println("init {}", Rinit_ex(addr of LDesc));
  LWindow := Rwindow_create("raven window", 320, 200, R_WINDOW_DEFAULT);
  LBox := Rwidget_create(R_WIDGET_VBOX);
  LLabel := Rwidget_add_child(LBox, Rlabel_create("hello"));
  LButton := Rwidget_add_child(LBox, Rbutton_create("press"));
  Rwindow_set_content(LWindow, LBox);
  println("window {} title {}", LWindow <> 0, StringFromC(Rwindow_get_title(LWindow)));
  println("children {} vbox {}", Rwidget_get_child_count(LBox), Rwidget_get_type(LBox) = R_WIDGET_VBOX);
  println("frame {}", Rdraw_frame());
  Rlabel_set_text(LLabel, "changed");
  println("label {} button {}", StringFromC(Rlabel_get_text(LLabel)), LButton <> 0);
  println("frame {}", Rdraw_frame());
  Rshutdown();
  println("done");
end.
