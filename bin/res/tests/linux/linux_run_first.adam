-------------------------------------------------------------------------------
  linux_run_first.adam - the first Adam program linked for x86_64-linux-gnu
  and run there (PLAN-LINUX64 LX3c: the targets line builds it for both
  targets with -t, the linux one run through RunELF), the same lines on
  both (parity): threadstatics (an int64 and a string: ELF TLS local-exec,
  each a fixed offset from the thread pointer), an Adam variadic routine
  reading records by value (LX1b2: a 16-byte { float64; int64 }, an 8-byte
  { float32; float32 }, a 5-byte and a 24-byte record, in registers and
  on the stack) and the C library's sprintf (LX1b: the vector register
  count, integers, a string and doubles)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | tls 42 seven 43 seven!
  | 1 | 2.5 -7 | 0.5 0.25 | 1 2 3 4 5 | 10 20 30 | 99
  | sum 168
  | c: 12 -34 adam 1.50 0.25 9
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_run_first;

import System.SysUtils;

@ifdef TARGET_X86_64_LINUX_GNU
func sprintf(const ABuffer: ptr; const AFormat: ptr to const char; ...): int32; external "c";
@else
func sprintf(const ABuffer: ptr; const AFormat: ptr to const char; ...): int32; external "msvcrt";
@endif

type
  TMixed = record
    D: float64;
    N: int64;
  end;

  TFloats = record
    X: float32;
    Y: float32;
  end;

  TFive = record
    A: uint8;
    B: uint8;
    C: uint8;
    D: uint8;
    E: uint8;
  end;

  TBig = record
    A: int64;
    B: int64;
    C: int64;
  end;

threadstatic
  // The running thread's copies (local-exec on linux, the indexed block on win64)
  GCount: int64;
  GName: string;

// The records after ATag, then an int32, printed on one line; their integers summed with
// ATag and the int32
func Show(const ATag: int32; ...): int64;
var
  LM: TMixed;
  LF: TFloats;
  LV: TFive;
  LB: TBig;
  LE: int32;
begin
  LM := varargs.next(TMixed);
  LF := varargs.next(TFloats);
  LV := varargs.next(TFive);
  LB := varargs.next(TBig);
  LE := varargs.next(int32);
  println("{} | {} {} | {} {} | {} {} {} {} {} | {} {} {} | {}", ATag, LM.D, LM.N, LF.X, LF.Y,
    LV.A, LV.B, LV.C, LV.D, LV.E, LB.A, LB.B, LB.C, LE);
  return int64(ATag) + LM.N + int64(LV.A) + int64(LV.B) + int64(LV.C) + int64(LV.D) +
    int64(LV.E) + LB.A + LB.B + LB.C + int64(LE);
end;

// The threadstatics set, then read back and changed through their places
func ShowTLS();
var
  LFirst: int64;
  LName: string;
begin
  GCount := 42;
  GName := "seven";
  LFirst := GCount;
  LName := GName;
  GCount := GCount + 1;
  GName := GName + "!";
  println("tls {} {} {} {}", LFirst, LName, GCount, GName);
end;

var
  GM: TMixed;
  GF: TFloats;
  GV: TFive;
  GB: TBig;
  GText: array[0..127] of char;

begin
  ShowTLS();
  GM.D := 2.5;
  GM.N := -7;
  GF.X := 0.5;
  GF.Y := 0.25;
  GV.A := 1;
  GV.B := 2;
  GV.C := 3;
  GV.D := 4;
  GV.E := 5;
  GB.A := 10;
  GB.B := 20;
  GB.C := 30;
  println("sum {}", Show(1, GM, GF, GV, GB, 99));
  sprintf(addr of GText, ptr to const char("c: %d %d %s %.2f %.2f %d"), int32(12), int32(-34),
    ptr to const char("adam"), 1.5, 0.25, int32(9));
  println("{}", StringFromC(ptr to const char(addr of GText)));
end.
