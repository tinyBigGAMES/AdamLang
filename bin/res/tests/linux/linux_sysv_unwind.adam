-------------------------------------------------------------------------------
  linux_sysv_unwind.adam - x86_64-linux-gnu's .eh_frame (Adam.SysV.Unwind,
  imported from the compiler's own src\, beside bin\): one piece per
  function going with its code, a CIE (version 1, "zR", code alignment 1,
  data alignment -8, return address column 16, pcrel sdata4 FDE pointers,
  the CFA at entry rsp + 8) then the FDE: its start a Rel32 (addend 4), its
  byte count, per prologue step its advance (one byte, then advance_loc2
  past 255), a push's CFA offset and register, the reservation's offset, a
  realigned frame's frame register; a leaf with no steps (PLAN-LINUX64
  LX1c)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | piece .eh_frame#push group .eh_frame 56 bytes
  | 14 00 00 00 00 00 00 00 01 7a 52 00 01 78 10 01
  | 1b 0c 07 08 90 01 00 00 1c 00 00 00 1c 00 00 00
  | 00 00 00 00 20 00 00 00 00 41 0e 10 86 02 41 0e
  | 18 83 03 44 0e 30 00 00
  | reloc +32 rel32 push +4
  | piece .eh_frame#realign group .eh_frame 56 bytes
  | 14 00 00 00 00 00 00 00 01 7a 52 00 01 78 10 01
  | 1b 0c 07 08 90 01 00 00 1c 00 00 00 1c 00 00 00
  | 00 00 00 00 90 01 00 00 00 41 0e 10 86 02 03 2b
  | 01 0e 50 44 0d 06 00 00
  | reloc +32 rel32 realign +4
  | piece .eh_frame#leaf group .eh_frame 48 bytes
  | 14 00 00 00 00 00 00 00 01 7a 52 00 01 78 10 01
  | 1b 0c 07 08 90 01 00 00 14 00 00 00 1c 00 00 00
  | 00 00 00 00 05 00 00 00 00 00 00 00 00 00 00 00
  | reloc +32 rel32 leaf +4
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_sysv_unwind;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Backend.Sections, Adam.Backend.Parts, Adam.SysV.Unwind;

// A prologue step of AAction (ABytes, ARegister) ending at AEndsAt
func Step(const AAction: PrologueAction; const ABytes: int64; const ARegister: string;
  const AEndsAt: int64): ref PrologueStep;
var
  LStep: ref PrologueStep;
begin
  LStep := ref PrologueStep(AAction);
  LStep.Bytes := ABytes;
  LStep.RegisterName := ARegister;
  LStep.EndsAt := AEndsAt;
  return LStep;
end;

// Two lowercase hex digits of AByte
func Hex(const AByte: uint8): string;
begin
  return LowerCase(IntToHex(uint64(AByte), 2));
end;

// A function AName of ACount code bytes and the steps ASteps through FrameInfo, its piece's
// name, group and bytes (16 a line) and its relocations shown
func Show(const AName: string; const ACount: int64; const ASteps: array of ref PrologueStep);
var
  LSet: ref SectionSet;
  LCode: ref FunctionCode;
  LText: int64;
  LPiece: ref Section;
  LReloc: ref SectionReloc;
  LLine: string;
  LI: int64;
begin
  LSet := ref SectionSet();
  LText := LSet.AddSection(".text", SectionKind.Code, 16);
  LSet.SectionAt(LText).PutZeros(ACount);
  LCode := ref FunctionCode(AName);
  LCode.SymbolId := LSet.DefineSymbol(AName, LText, 0, 0);
  LCode.ByteCount := ACount;
  LCode.Frame := ref FrameLayout();
  for LI := 0 to len(ASteps) - 1 do
    LCode.AddStep(ASteps[LI]);
  end;
  FrameInfo(LCode, LSet);
  LPiece := LSet.SectionAt(LSet.FindSection(ADAM_SYSV_EH_FRAME + "#" + AName));
  println("piece " + LPiece.SectionName + " group " + LPiece.GroupName + " " + IntToStr(LPiece.Size()) + " bytes");
  LLine := "";
  for LI := 0 to LPiece.Size() - 1 do
    if LLine <> "" then
      LLine := LLine + " ";
    end;
    LLine := LLine + Hex(LPiece.Bytes[LI]);
    if (LI mod 16 = 15) or (LI = LPiece.Size() - 1) then
      println(LLine);
      LLine := "";
    end;
  end;
  for LI := 0 to LPiece.RelocCount - 1 do
    LReloc := LPiece.RelocAt(LI);
    println("reloc +" + IntToStr(LReloc.Offset) + " " + RelocKindText(LReloc.Kind) + " " +
      LSet.SymbolAt(LReloc.Symbol).SymbolName + " +" + IntToStr(LReloc.Addend));
  end;
end;

begin
  // push rbp; push rbx; sub rsp, 24
  Show("push", 32, [Step(PrologueAction.SaveRegister, 0, "rbp", 1),
    Step(PrologueAction.SaveRegister, 0, "rbx", 2), Step(PrologueAction.Allocate, 24, "", 6)]);
  // push rbp; a 64-byte reservation ending past 255 bytes (advance_loc2); mov rbp, rsp
  Show("realign", 400, [Step(PrologueAction.SaveRegister, 0, "rbp", 1),
    Step(PrologueAction.Allocate, 64, "", 300), Step(PrologueAction.SetFrame, 0, "rbp", 304)]);
  // a leaf: no steps
  Show("leaf", 5, []);
end.
