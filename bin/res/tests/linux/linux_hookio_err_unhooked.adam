-------------------------------------------------------------------------------
  linux_hookio_err_unhooked.adam - the ELF linker refuses a hooked link that
  keeps a stream name of glibc's (PLAN-LINUX64 LX3d3c2c): the program links
  System.HookIO (its fopen and the rest of the hooks are the program's own)
  and calls __wuflow and _IO_padn, glibc names that take a FILE * which
  System.HookIO does not hook, so a handle would reach glibc's own code:
  EL0009 at each declaration. puts takes no stream and links as ever.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/linux_hookio_err_unhooked.adam" "-o" "." "-t" "x86_64-linux-gnu"
  exitcode 1
  | <DIR>/linux_hookio_err_unhooked.adam(38,1): Error EL0009: '__wuflow' takes a C stream (FILE *), which System.HookIO in this program does not hook: a stream System.HookIO opened would reach the C runtime's own code
  | <DIR>/linux_hookio_err_unhooked.adam(39,1): Error EL0009: '_IO_padn' takes a C stream (FILE *), which System.HookIO in this program does not hook: a stream System.HookIO opened would reach the C runtime's own code
@@end
*/

module exe linux_hookio_err_unhooked;

import System.SysUtils, System.CustomIO, System.HookIO, System.HookIO.Linux64;

func clink __wuflow(AFile: ptr): uint32; external "c";
func clink _IO_padn(AFile: ptr; APad: int32; ACount: int64): int64; external "c";
func clink puts(AText: ptr to const char): int32; external "c";

var
  LFile: ptr;

begin
  LFile := fopen(ptr to const char("io://1/x"), ptr to const char("rb"));
  if LFile <> nil then
    __wuflow(LFile);
    _IO_padn(LFile, 32, 1);
    fclose(LFile);
  end;
  puts(ptr to const char("never"));
end.
