-------------------------------------------------------------------------------
  linux_pl_mpeg.adam - pl_mpeg on both targets (PLAN-LINUX64 LX3d3c1): the
  std unit System.pl_mpeg.C (cimport of pl_mpeg.h + AdamLang-Libs'
  plm_utf8.h / plm_stream.h) over libpl_mpeg.a (AdamLang-Libs
  build-pl_mpeg.cmd), the same lines on x86_64-windows-gnu and
  x86_64-linux-gnu (the linux ELF run through RunElf). The fixture
  fixtures/lx3d3c1.mpg (scripts/linux/lx3d3c1_fixture.sh: 1 s of 64x48 video
  at 25 fps + MP2 audio at 44100 Hz) is opened three ways: by its UTF-8 path
  (plm_create_with_filename_utf8), from memory (plm_create_with_memory) and
  through Adam callbacks (plm_create_with_stream: size_t parameters as
  uint64 on both targets); each one's headers read, every video frame and
  audio frame decoded and counted, the first frame's size and top-left luma
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | file 64x48 fps 25 rate 44100 video 1 audio 1
  | file frames 25 first 64x48 luma 16 sound 39
  | memory frames 25 first 64x48 luma 16 sound 39
  | stream frames 25 first 64x48 luma 16 sound 39
  | missing nil
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_pl_mpeg;

import System.SysUtils, System.pl_mpeg.C;

type
  // The bytes plm_create_with_stream reads through StreamRead / StreamSeek
  StreamSource = record
    Data: ptr to uint8;
    Count: int64;
    At: int64;
  end;

var
  LPath: string;
  LName: ptr to char;
  LMissing: ptr to char;
  LBytes: ptr;
  LCount: int64;
  LPlm: ptr to plm_t;
  LSource: StreamSource;
  LStream: plm_stream_t;

// Up to ACount bytes of the source at AUser copied to ADest from its place on; the number
// copied (0 at the end)
func clink StreamRead(AUser: ptr; ADest: ptr; ACount: uint64): uint64;
var
  LSource: ptr to StreamSource;
  LTake: int64;
begin
  LSource := ptr to StreamSource(AUser);
  LTake := LSource^.Count - LSource^.At;
  if LTake > int64(ACount) then
    LTake := int64(ACount);
  end;
  if LTake <= 0 then
    return 0;
  end;
  CopyBytes(ptr to uint8(ADest), LSource^.Data + LSource^.At, LTake);
  LSource^.At := LSource^.At + LTake;
  return uint64(LTake);
end;

// The source at AUser moved to the byte APosition: 1 when it is inside the data
func clink StreamSeek(AUser: ptr; APosition: uint64): int32;
var
  LSource: ptr to StreamSource;
begin
  LSource := ptr to StreamSource(AUser);
  if int64(APosition) > LSource^.Count then
    return 0;
  end;
  LSource^.At := int64(APosition);
  return 1;
end;

// Every video and audio frame of APlm decoded: their counts, the first frame's size and its
// top-left luma, under AName; then APlm destroyed
func Decode(const AName: string; const APlm: ptr to plm_t);
var
  LFrame: ptr to plm_frame_t;
  LFrames: int32;
  LSounds: int32;
  LFirst: string;
begin
  if APlm = nil then
    println("{} nil", AName);
    return;
  end;
  plm_set_audio_enabled(APlm, 1);
  LFrames := 0;
  LFirst := "none";
  LFrame := plm_decode_video(APlm);
  while LFrame <> nil do
    if LFrames = 0 then
      LFirst := IntToStr(LFrame^.width) + "x" + IntToStr(LFrame^.height) + " luma " +
        IntToStr(LFrame^.y.data^);
    end;
    LFrames := LFrames + 1;
    LFrame := plm_decode_video(APlm);
  end;
  LSounds := 0;
  while plm_decode_audio(APlm) <> nil do
    LSounds := LSounds + 1;
  end;
  println("{} frames {} first {} sound {}", AName, LFrames, LFirst, LSounds);
  plm_destroy(APlm);
end;

begin
  LPath := ExtractFileDir(ProgramFilePath()) + "/../../../../res/tests/linux/fixtures/lx3d3c1.mpg";

  // the path as C text (StringToC's blocks freed at the end)
  LName := StringToC(LPath);
  LMissing := StringToC(LPath + ".none");

  // by name: the headers, then the decode
  LPlm := plm_create_with_filename_utf8(ptr to const char(LName));
  if LPlm = nil then
    println("{}", "file did not open");
    freemem(LName);
    freemem(LMissing);
    return 1;
  end;
  if plm_has_headers(LPlm) <> 0 then
    println("file {}x{} fps {} rate {} video {} audio {}", plm_get_width(LPlm),
      plm_get_height(LPlm), int32(plm_get_framerate(LPlm)), plm_get_samplerate(LPlm),
      plm_get_num_video_streams(LPlm), plm_get_num_audio_streams(LPlm));
  end;
  Decode("file", LPlm);

  // from memory: the runtime's whole-file read (freed here, pl_mpeg never frees it)
  LBytes := ReadFileBytes(ptr to const char(LName), LCount);
  Decode("memory", plm_create_with_memory(ptr to uint8(LBytes), uint64(LCount), 0));

  // through Adam callbacks over the same bytes
  LSource.Data := ptr to uint8(LBytes);
  LSource.Count := LCount;
  LSource.At := 0;
  LStream.read := StreamRead;
  LStream.seek := StreamSeek;
  LStream.length := uint64(LCount);
  LStream.user := addr of LSource;
  Decode("stream", plm_create_with_stream(addr of LStream));
  freemem(LBytes);

  // a missing file opens nothing
  Decode("missing", plm_create_with_filename_utf8(ptr to const char(LMissing)));
  freemem(LName);
  freemem(LMissing);
end.
