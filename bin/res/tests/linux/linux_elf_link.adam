  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  linux_elf_link.adam - x86_64-linux-gnu's static link (Adam.Elf.Linker over
  Adam.Elf.Foreign, imported from the compiler's own src\, beside bin\;
  PLAN-LINUX64 LX3a): a program set (an entry that needs no C library: its
  checks, then Linux's write and exit system calls) linked with liblx3a.a
  (two objects ElfFormat writes: one pulled by a routine its import needs,
  its unused routine removed, its GOT reference through a local slot; the
  other never pulled) and the shipped libzlib.a (crc32.o: clang's
  .rodata, PC32 / PLT32, its .eh_frame cut into pieces, its .comment and
  .llvm_addrsig dropped; its FDEs indexed in .eh_frame_hdr, LX3b); the
  start list's .init_array entry laid between
  the entry's bounds; a C identifier section's __start_ / __stop_ bounds
  and its self-relative Rva32 field, its removed function's piece gone; an
  Abs64 pointer in data; a zeroed flag. The image as the reader reads it
  (its program headers decoded here, sections, symbols, as readelf -lSsW
  gives them), the entry's checks done here on the bytes, then written
  beside the program (lx3a_static) for the devbox proof: it runs on linux,
  prints "ok", exit 0. The link's reports: a library found nowhere
  (EL0003), one named with a folder (EL0004), a symbol nothing defines
  (EL0002), a member of another machine (EF0002), a thread-local access
  adam cannot relax (EF0004: a TLSGD outside the general-dynamic sequence), a
  name a second unit defines (EF0003)
*******************************************************************************/

/*
@@test
  kind run
  args "<BIN>/res/libs/vendor/x86_64-linux-gnu" "<BIN>/res/libs/system/x86_64-linux-gnu"
  exitcode 0
  | library liblx3a.a 1692 bytes
  | image 18096 bytes type 2 machine 0x3E entry 0x403000 phoff 64 shoff 17264 phnum 5 shnum 13 shstrndx 12
  | phdr 0x1 flags 4 offset 0x0 vaddr 0x400000 filesz 0x2864 memsz 0x2864 align 0x1000
  | phdr 0x1 flags 5 offset 0x3000 vaddr 0x403000 filesz 0xDC1 memsz 0xDC1 align 0x1000
  | phdr 0x1 flags 6 offset 0x4000 vaddr 0x404000 filesz 0x40 memsz 0x44 align 0x1000
  | phdr 0x6474E550 flags 4 offset 0x2818 vaddr 0x402818 filesz 0x4C memsz 0x4C align 0x4
  | phdr 0x6474E551 flags 6 offset 0x0 vaddr 0x0 filesz 0x0 memsz 0x0 align 0x10
  | [1] '.rodata' type 1 flags 0x2 addr 0x400160 size 0x2490 align 16
  | [2] 'lx3a_table' type 1 flags 0x2 addr 0x4025F0 size 0x4 align 4
  | [3] '.eh_frame' type 1 flags 0x2 addr 0x4025F4 size 0x224 align 4
  | [4] '.eh_frame_hdr' type 1 flags 0x2 addr 0x402818 size 0x4C align 4
  | [5] '.text' type 1 flags 0x6 addr 0x403000 size 0xDC1 align 16
  | [6] 'adam_start_bounds' type 1 flags 0x3 addr 0x404000 size 0x18 align 8
  | [7] '.data' type 1 flags 0x3 addr 0x404018 size 0x10 align 8
  | [8] '.got' type 1 flags 0x3 addr 0x404028 size 0x18 align 8
  | [9] '.bss' type 8 flags 0x3 addr 0x404040 size 0x4 align 4
  | [10] '.symtab' type 2 flags 0x0 addr 0x0 size 0x1E0 align 8
  | [11] '.strtab' type 3 flags 0x0 addr 0x0 size 0xE0 align 1
  | [12] '.shstrtab' type 3 flags 0x0 addr 0x0 size 0x6E align 1
  | symbols 20 first global 1
  | sym 'lx3a_start' bind 1 type 2 shndx 5 value 0x403000
  | sym 'lx3a_first' bind 1 type 1 shndx 6 value 0x404000
  | sym 'lx3a_last' bind 1 type 1 shndx 6 value 0x404010
  | sym 'lx3a_init' bind 1 type 2 shndx 5 value 0x4030E0
  | sym 'lx3a_flag' bind 1 type 1 shndx 9 value 0x404040
  | sym 'lx3a_msg' bind 1 type 1 shndx 1 value 0x400160
  | sym 'lx3a_ok' bind 1 type 1 shndx 1 value 0x400165
  | sym 'lx3a_ptr' bind 1 type 1 shndx 7 value 0x404018
  | sym 'lx3a_value' bind 1 type 1 shndx 7 value 0x404020
  | sym 'lx3a_read' bind 1 type 2 shndx 5 value 0x403100
  | sym 'lx3a_twice' bind 1 type 2 shndx 5 value 0x4030F0
  | sym 'crc32' bind 1 type 2 shndx 5 value 0x403A00
  | sym 'get_crc_table' bind 1 type 2 shndx 5 value 0x403110
  | sym 'crc32_z' bind 1 type 2 shndx 5 value 0x403120
  | sym 'crc32_combine_gen64' bind 1 type 2 shndx 5 value 0x403A10
  | sym 'crc32_combine_gen' bind 1 type 2 shndx 5 value 0x403AC0
  | sym 'crc32_combine_op' bind 1 type 2 shndx 5 value 0x403B70
  | sym 'crc32_combine64' bind 1 type 2 shndx 5 value 0x403BD0
  | sym 'crc32_combine' bind 1 type 2 shndx 5 value 0x403CD0
  | start bounds size 24, first 0x404000 last 0x404010
  | the entry between them 0x4030E0, lx3a_init 0x4030E0
  | lx3a_table size 4, entry 0x403000 = lx3a_start 0x403000
  | lx3a_ptr holds 0x404020, lx3a_value 0x404020
  | lx3a_unused 0x0 lx3a_dead 0x0 lx3a_never 0x0 crc32 yes .init_array 0
  | -- reports
  | Error EL0003: library 'nosuchlib' is not found: looked for libnosuchlib.a, nosuchlib.a in nolibs
  | Error EL0004: library 'a/b' names a folder: a library is named by its file name and found in the library paths
  | Error EL0002: 'lx3a_missing' is used, but nothing in the program, its static libraries or the shared libraries of the version tables defines it
  | Error EF0002: 'lx3a_arm' is built for machine 0x28 as file type 1: the target links relocatable objects (type 1) for machine 0x3E
  | Error EF0004: 'lx3a_tlsgd' holds a thread-local access (relocation type 19) in section '.text#lx3a_tlsgd#1.2' at offset 3 in a form it cannot relax to local-exec, which adam does not link
  | Error EF0003: 'lx3a_twice' is defined twice: 'lx3a_two' defines it again
  | Error EF0003: 'lx3a_read' is defined twice: 'lx3a_two' defines it again
  | Error EF0003: 'lx3a_value' is defined twice: 'lx3a_two' defines it again
  | Error EF0003: 'lx3a_unused' is defined twice: 'lx3a_two' defines it again
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_elf_link;

@addmodulepath "$P:../src";

import System.SysUtils, System.IO, Adam.Core.Containers, Adam.Compiler.SourceText,
  Adam.Compiler.Diagnostics, Adam.Backend.Ssa, Adam.Backend.Sections, Adam.Backend.Parts,
  Adam.Backend.Targets, Adam.Elf.Reader, System.Elf;

const
  // The triple whose format part links
  LINUX_TRIPLE: string = "x86_64-linux-gnu";
  // The entry's code (GNU as's bytes for the checks; see the header): each check that
  // fails sets a bit of r15d, the exit code
  ENTRY_CODE: array[0..222] of uint8 = [
    0x45, 0x31, 0xFF, 0x48, 0x8D, 0x1D, 0, 0, 0, 0, 0x4C, 0x8D, 0x25, 0, 0, 0, 0,
    0x4C, 0x89, 0xE0, 0x48, 0x29, 0xD8, 0x48, 0x83, 0xF8, 0x10, 0x74, 0x04, 0x41, 0x80, 0xCF, 0x01,
    0xFF, 0x53, 0x08, 0x83, 0x3D, 0, 0, 0, 0, 0x07, 0x74, 0x04, 0x41, 0x80, 0xCF, 0x02,
    0xBF, 0x15, 0, 0, 0, 0xFF, 0x15, 0, 0, 0, 0, 0x83, 0xF8, 0x2A, 0x74, 0x04, 0x41, 0x80, 0xCF, 0x04,
    0x31, 0xFF, 0x48, 0x8D, 0x35, 0, 0, 0, 0, 0xBA, 0x05, 0, 0, 0, 0xFF, 0x15, 0, 0, 0, 0,
    0x3D, 0x86, 0xA6, 0x10, 0x36, 0x74, 0x04, 0x41, 0x80, 0xCF, 0x08,
    0x48, 0x8D, 0x05, 0, 0, 0, 0, 0x48, 0x8D, 0x0D, 0, 0, 0, 0, 0x48, 0x29, 0xC8,
    0x48, 0x83, 0xF8, 0x04, 0x74, 0x04, 0x41, 0x80, 0xCF, 0x10,
    0x48, 0x63, 0x11, 0x48, 0x01, 0xCA, 0x48, 0x8D, 0x05, 0, 0, 0, 0, 0x48, 0x39, 0xC2,
    0x74, 0x04, 0x41, 0x80, 0xCF, 0x20, 0xE8, 0, 0, 0, 0, 0x48, 0x83, 0xF8, 0x55,
    0x74, 0x04, 0x41, 0x80, 0xCF, 0x40, 0x48, 0x8B, 0x05, 0, 0, 0, 0, 0x48, 0x8B, 0x00,
    0x48, 0x83, 0xF8, 0x55, 0x74, 0x04, 0x41, 0x80, 0xCF, 0x80, 0x45, 0x85, 0xFF, 0x75, 0x18,
    0xB8, 0x01, 0, 0, 0, 0xBF, 0x01, 0, 0, 0, 0x48, 0x8D, 0x35, 0, 0, 0, 0, 0xBA, 0x03, 0, 0, 0,
    0x0F, 0x05, 0x44, 0x89, 0xFF, 0xB8, 0x3C, 0, 0, 0, 0x0F, 0x05];

// "yes" or "no"
routine YesNo(const AValue: bool): string;
begin
  if AValue then
    return "yes";
  end;
  return "no";
end;

// ABytes appended to the section AId of ASet
routine Put(const ASet: ref SectionSet; const AId: int64; const ABytes: array of uint8);
var
  LI: int64;
begin
  for LI := 0 to len(ABytes) - 1 do
    ASet.SectionAt(AId).Put8(uint64(ABytes[LI]));
  end;
end;

// A new section of AKind in AGroup named for ASymbol, Removable as ARemovable, ASymbol
// defined at its start; its id
routine Piece(const ASet: ref SectionSet; const AGroup: string; const AKind: SectionKind;
  const ASymbol: string; const AAlign: int64; const ARemovable: bool): int64;
var
  LId: int64;
begin
  LId := ASet.AddSection(AGroup + "#" + ASymbol, AKind, AAlign);
  ASet.SectionAt(LId).GroupName := AGroup;
  ASet.SectionAt(LId).Removable := ARemovable;
  return LId;
end;

// ARemovable code / data piece named ASymbol holding ABytes, ASymbol defined at its start
routine Defined(const ASet: ref SectionSet; const AGroup: string; const AKind: SectionKind;
  const ASymbol: string; const ABytes: array of uint8; const AAlign: int64): int64;
var
  LId: int64;
begin
  LId := Piece(ASet, AGroup, AKind, ASymbol, AAlign, true);
  if AKind = SectionKind.Zeroed then
    ASet.SectionAt(LId).PutZeros(len(ABytes));
  else
    Put(ASet, LId, ABytes);
  end;
  ASet.DefineSymbol(ASymbol, LId, 0, 0);
  return LId;
end;

// liblx3a.a's first member: lx3a_twice (lea eax, [rdi + rdi]; ret), lx3a_read (its value
// through its GOT slot: mov rax, [rip + slot]; mov rax, [rax]; ret), lx3a_value (0x55),
// lx3a_unused (ret)
routine LibrarySet(): ref SectionSet;
var
  LSet: ref SectionSet;
  LId: int64;
begin
  LSet := ref SectionSet();
  Defined(LSet, ".text", SectionKind.Code, "lx3a_twice", [0x8D, 0x04, 0x3F, 0xC3], 16);
  LId := Defined(LSet, ".text", SectionKind.Code, "lx3a_read",
    [0x48, 0x8B, 0x05, 0, 0, 0, 0, 0x48, 0x8B, 0x00, 0xC3], 16);
  Defined(LSet, ".data", SectionKind.Data, "lx3a_value", [0x55, 0, 0, 0, 0, 0, 0, 0], 8);
  LSet.AddReloc(LId, 3, RelocKind.Rel32, LSet.ImportSymbol("c", "lx3a_value", 0), 0);
  Defined(LSet, ".text", SectionKind.Code, "lx3a_unused", [0xC3], 16);
  return LSet;
end;

// liblx3a.a's second member, never pulled: lx3a_never (ret)
routine OtherSet(): ref SectionSet;
var
  LSet: ref SectionSet;
begin
  LSet := ref SectionSet();
  Defined(LSet, ".text", SectionKind.Code, "lx3a_never", [0xC3], 16);
  return LSet;
end;

// The program set (see the header)
routine ProgramSet(): ref SectionSet;
var
  LSet: ref SectionSet;
  LStart: int64;
  LDead: int64;
  LId: int64;
  LI: int64;
begin
  LSet := ref SectionSet();
  LStart := Piece(LSet, ".text", SectionKind.Code, "lx3a_start", 16, true);
  for LI := 0 to len(ENTRY_CODE) - 1 do
    LSet.SectionAt(LStart).Put8(uint64(ENTRY_CODE[LI]));
  end;
  LSet.DefineSymbol("lx3a_start", LStart, 0, 0);
  // the start list: its two bounds and one entry between them
  Defined(LSet, "adam_start_bounds", SectionKind.Data, "lx3a_first", [0, 0, 0, 0, 0, 0, 0, 0], 8);
  Defined(LSet, "adam_start_bounds", SectionKind.Data, "lx3a_last", [0, 0, 0, 0, 0, 0, 0, 0], 8);
  LId := Piece(LSet, ".init_array", SectionKind.Data, "lx3a_entry", 8, false);
  LSet.SectionAt(LId).PutZeros(8);
  LSet.AddReloc(LId, 0, RelocKind.Abs64, LSet.ReferSymbol("lx3a_init", 0), 0);
  // lx3a_init: mov dword [rip + lx3a_flag], 7; ret
  LId := Defined(LSet, ".text", SectionKind.Code, "lx3a_init",
    [0xC7, 0x05, 0, 0, 0, 0, 0x07, 0, 0, 0, 0xC3], 16);
  LSet.AddReloc(LId, 2, RelocKind.Rel32, LSet.ReferSymbol("lx3a_flag", 0), -4);
  Defined(LSet, ".bss", SectionKind.Zeroed, "lx3a_flag", [0, 0, 0, 0], 4);
  LDead := Defined(LSet, ".text", SectionKind.Code, "lx3a_dead", [0xC3], 16);
  Defined(LSet, ".rodata", SectionKind.ReadOnly, "lx3a_msg", [0x68, 0x65, 0x6C, 0x6C, 0x6F], 1);
  Defined(LSet, ".rodata", SectionKind.ReadOnly, "lx3a_ok", [0x6F, 0x6B, 0x0A], 1);
  LId := Defined(LSet, ".data", SectionKind.Data, "lx3a_ptr", [0, 0, 0, 0, 0, 0, 0, 0], 8);
  LSet.AddReloc(LId, 0, RelocKind.Abs64, LSet.ReferSymbol("lx3a_value", 0), 0);
  // a table in a C identifier section: one self-relative entry per function
  LId := Piece(LSet, "lx3a_table", SectionKind.ReadOnly, "start", 4, true);
  LSet.SectionAt(LId).PutZeros(4);
  LSet.SectionAt(LId).Associate := LStart;
  LSet.AddReloc(LId, 0, RelocKind.Rva32, LSet.FindSymbol("lx3a_start"), 0);
  LId := Piece(LSet, "lx3a_table", SectionKind.ReadOnly, "dead", 4, true);
  LSet.SectionAt(LId).PutZeros(4);
  LSet.SectionAt(LId).Associate := LDead;
  LSet.AddReloc(LId, 0, RelocKind.Rva32, LSet.FindSymbol("lx3a_dead"), 0);
  // the entry's references
  LSet.AddReloc(LStart, 0x06, RelocKind.Rel32, LSet.FindSymbol("lx3a_first"), 0);
  LSet.AddReloc(LStart, 0x0D, RelocKind.Rel32, LSet.FindSymbol("lx3a_last"), 0);
  LSet.AddReloc(LStart, 0x26, RelocKind.Rel32, LSet.FindSymbol("lx3a_flag"), -1);
  LSet.AddReloc(LStart, 0x38, RelocKind.Rel32, LSet.ImportSymbol("lx3a", "lx3a_twice", 0), 0);
  LSet.AddReloc(LStart, 0x4A, RelocKind.Rel32, LSet.FindSymbol("lx3a_msg"), 0);
  LSet.AddReloc(LStart, 0x55, RelocKind.Rel32, LSet.ImportSymbol("zlib", "crc32", 0), 0);
  LSet.AddReloc(LStart, 0x67, RelocKind.Rel32, LSet.ReferSymbol("__stop_lx3a_table", 0), 0);
  LSet.AddReloc(LStart, 0x6E, RelocKind.Rel32, LSet.ReferSymbol("__start_lx3a_table", 0), 0);
  LSet.AddReloc(LStart, 0x88, RelocKind.Rel32, LSet.FindSymbol("lx3a_start"), 0);
  LSet.AddReloc(LStart, 0x96, RelocKind.Rel32, LSet.ReferSymbol("lx3a_read", 0), 0);
  LSet.AddReloc(LStart, 0xA7, RelocKind.Rel32, LSet.FindSymbol("lx3a_ptr"), 0);
  LSet.AddReloc(LStart, 0xCA, RelocKind.Rel32, LSet.FindSymbol("lx3a_ok"), 0);
  return LSet;
end;

// The folder the program runs in
routine HereDir(): string;
begin
  return ExtractFileDir(ProgramFilePath());
end;

// The library paths: the program's folder (liblx3a.a), then AVendor and ASystem (the C
// runtime's version table: an undefined name is looked up there, LX3b)
routine Paths(const AVendor: string; const ASystem: string): StringArray;
var
  LPaths: StringArray;
begin
  setlength(LPaths, 3);
  LPaths[0] := HereDir();
  LPaths[1] := AVendor;
  LPaths[2] := ASystem;
  return LPaths;
end;

// ASet linked by ABackend's format part with APaths, entered at AEntry; the image (empty
// after a report, the reports printed)
routine Link(const ABackend: ref Backend; const ASet: ref SectionSet; const AEntry: string;
  const APaths: StringArray): ByteArray;
var
  LReports: ref Diagnostics;
  LSettings: ref ExeSettings;
  LLibraries: StringArray;
  LDebug: ByteArray;
  LImage: ByteArray;
begin
  LReports := ref Diagnostics(100);
  LSettings := ref ExeSettings();
  LImage := ABackend.Format.LinkExe(ASet, AEntry, "", APaths, ABackend.Abi.CRuntime(), LSettings,
    nil, LReports, LLibraries, LDebug);
  LReports.PrintAll();
  return LImage;
end;

// The u64 / u32 / u16 at AAt of ABytes
routine U64(const ABytes: ByteArray; const AAt: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, 8));
end;

routine U32(const ABytes: ByteArray; const AAt: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, 4));
end;

routine U16(const ABytes: ByteArray; const AAt: int64): int64;
begin
  return int64(GetLe(ABytes, AAt, 2));
end;

// AValue as 0x and hex digits
routine Hex(const AValue: int64): string;
begin
  return "0x" + IntToHex(uint64(AValue), 1);
end;

// The image's ELF header and program headers, as readelf -hl gives them
routine ShowHeaders(const ABytes: ByteArray);
var
  LCount: int64;
  LAt: int64;
  LI: int64;
begin
  println("{}", "image " + IntToStr(len(ABytes)) + " bytes type " + IntToStr(U16(ABytes, 16)) +
    " machine " + Hex(U16(ABytes, 18)) + " entry " + Hex(U64(ABytes, 24)) + " phoff " +
    IntToStr(U64(ABytes, 32)) + " shoff " + IntToStr(U64(ABytes, 40)) + " phnum " +
    IntToStr(U16(ABytes, 56)) + " shnum " + IntToStr(U16(ABytes, 60)) + " shstrndx " +
    IntToStr(U16(ABytes, 62)));
  LCount := U16(ABytes, 56);
  for LI := 0 to LCount - 1 do
    LAt := U64(ABytes, 32) + LI * 56;
    println("{}", "phdr " + Hex(U32(ABytes, LAt)) + " flags " + IntToStr(U32(ABytes, LAt + 4)) +
      " offset " + Hex(U64(ABytes, LAt + 8)) + " vaddr " + Hex(U64(ABytes, LAt + 16)) + " filesz " +
      Hex(U64(ABytes, LAt + 32)) + " memsz " + Hex(U64(ABytes, LAt + 40)) + " align " +
      Hex(U64(ABytes, LAt + 48)));
  end;
end;

// The image's sections and symbols as the reader reads them; the address of the symbol
// named AName (0: none) into AAddress
routine ShowSections(const ABytes: ByteArray; var AObject: ElfObjectData);
var
  LReports: ref Diagnostics;
  LSection: ElfSection;
  LSymbol: ElfSymbol;
  LI: int64;
begin
  LReports := ref Diagnostics(100);
  if not ReadElfObject(ABytes, 0, len(ABytes), "image", NoPlace(), LReports, AObject) then
    LReports.PrintAll();
    return;
  end;
  for LI := 1 to len(AObject.Sections) - 1 do
    LSection := AObject.Sections[LI];
    println("{}", "[" + IntToStr(LI) + "] '" + LSection.SectionName + "' type " +
      IntToStr(LSection.SectionType) + " flags " + Hex(LSection.Flags) + " addr " +
      Hex(LSection.Address) + " size " + Hex(LSection.DataSize) + " align " + IntToStr(LSection.Align));
  end;
  println("{}", "symbols " + IntToStr(len(AObject.Symbols)) + " first global " +
    IntToStr(AObject.FirstGlobal));
  for LI := 1 to len(AObject.Symbols) - 1 do
    LSymbol := AObject.Symbols[LI];
    println("{}", "sym '" + LSymbol.SymbolName + "' bind " + IntToStr(LSymbol.Bind) + " type " +
      IntToStr(LSymbol.SymbolType) + " shndx " + IntToStr(LSymbol.SectionIndex) + " value " +
      Hex(LSymbol.SymbolValue));
  end;
end;

// The address of AObject's symbol named AName; 0 for none
routine AddressOf(const AObject: ElfObjectData; const AName: string): int64;
var
  LI: int64;
begin
  for LI := 0 to len(AObject.Symbols) - 1 do
    if AObject.Symbols[LI].SymbolName = AName then
      return AObject.Symbols[LI].SymbolValue;
    end;
  end;
  return 0;
end;

// The section of AObject named AName; its index, 0 for none
routine SectionNamed(const AObject: ElfObjectData; const AName: string): int64;
var
  LI: int64;
begin
  for LI := 1 to len(AObject.Sections) - 1 do
    if AObject.Sections[LI].SectionName = AName then
      return LI;
    end;
  end;
  return 0;
end;

// The image's facts the entry checks on linux, checked here on the bytes (an address A's
// file offset is A - 0x400000)
routine ShowChecks(const ABytes: ByteArray; const AObject: ElfObjectData);
var
  LStart: int64;
  LBounds: int64;
  LTable: int64;
  LEntry: int64;
  LValue: int64;
  LField: int64;
begin
  LStart := AddressOf(AObject, "lx3a_start");
  LBounds := SectionNamed(AObject, "adam_start_bounds");
  println("{}", "start bounds size " + IntToStr(AObject.Sections[LBounds].DataSize) +
    ", first " + Hex(AddressOf(AObject, "lx3a_first")) + " last " + Hex(AddressOf(AObject, "lx3a_last")));
  LEntry := U64(ABytes, AddressOf(AObject, "lx3a_first") + 8 - 0x400000);
  println("{}", "the entry between them " + Hex(LEntry) + ", lx3a_init " +
    Hex(AddressOf(AObject, "lx3a_init")));
  LTable := SectionNamed(AObject, "lx3a_table");
  LField := AObject.Sections[LTable].Address;
  LValue := ReadLowBits(U32(ABytes, LField - 0x400000), 32, true);
  println("{}", "lx3a_table size " + IntToStr(AObject.Sections[LTable].DataSize) + ", entry " +
    Hex(LField + LValue) + " = lx3a_start " + Hex(LStart));
  println("{}", "lx3a_ptr holds " + Hex(U64(ABytes, AddressOf(AObject, "lx3a_ptr") - 0x400000)) +
    ", lx3a_value " + Hex(AddressOf(AObject, "lx3a_value")));
  println("{}", "lx3a_unused " + Hex(AddressOf(AObject, "lx3a_unused")) + " lx3a_dead " +
    Hex(AddressOf(AObject, "lx3a_dead")) + " lx3a_never " + Hex(AddressOf(AObject, "lx3a_never")) +
    " crc32 " + YesNo(AddressOf(AObject, "crc32") <> 0) + " .init_array " +
    IntToStr(SectionNamed(AObject, ".init_array")));
end;

// A one-routine program set entered at lx3a_go, the call's target named ATarget through
// an import of ALibrary ("" a plain Undefined name)
routine CallSet(const ALibrary: string; const ATarget: string): ref SectionSet;
var
  LSet: ref SectionSet;
  LId: int64;
  LSymbol: int64;
begin
  LSet := ref SectionSet();
  LId := Defined(LSet, ".text", SectionKind.Code, "lx3a_go", [0xFF, 0x15, 0, 0, 0, 0, 0xC3], 16);
  if ALibrary = "" then
    LSymbol := LSet.ReferSymbol(ATarget, 0);
  else
    LSymbol := LSet.ImportSymbol(ALibrary, ATarget, 0);
  end;
  LSet.AddReloc(LId, 2, RelocKind.Rel32, LSymbol, 0);
  return LSet;
end;

// The reports of the links that fail (see the header)
routine ShowReports(const ABackend: ref Backend; const APaths: StringArray;
  const AMember: ByteArray);
var
  LSet: ref SectionSet;
  LReports: ref Diagnostics;
  LBytes: ByteArray;
  LObject: ElfObjectData;
  LRela: int64;
  LNodes: ref StringIdMap;
  LNowhere: StringArray;
begin
  println("{}", "-- reports");
  // searched in a folder that is not there (the report names it)
  setlength(LNowhere, 1);
  LNowhere[0] := "nolibs";
  Link(ABackend, CallSet("nosuchlib", "lx3a_f"), "lx3a_go", LNowhere);
  Link(ABackend, CallSet("a/b", "lx3a_g"), "lx3a_go", APaths);
  Link(ABackend, CallSet("", "lx3a_missing"), "lx3a_go", APaths);
  // a unit object of another machine, one with a TLSGD relocation, then a name defined by
  // two units
  LNodes := ref StringIdMap(0);
  LBytes := AMember;
  PutLe(LBytes, 18, 0x28, 2);
  LReports := ref Diagnostics(100);
  ABackend.Format.MergeObject(ref SectionSet(), LBytes, "lx3a_arm", 0, LNodes, nil, LReports);
  LReports.PrintAll();
  LBytes := AMember;
  LReports := ref Diagnostics(100);
  if ReadElfObject(LBytes, 0, len(LBytes), "member", NoPlace(), LReports, LObject) then
    LRela := SectionNamed(LObject, ".rela.text");
    PutLe(LBytes, LObject.Sections[LRela].DataAt + 8, uint64(R_X86_64_TLSGD), 4);
  end;
  ABackend.Format.MergeObject(ref SectionSet(), LBytes, "lx3a_tlsgd", 0, LNodes, nil, LReports);
  LReports.PrintAll();
  LSet := ref SectionSet();
  LReports := ref Diagnostics(100);
  ABackend.Format.MergeObject(LSet, AMember, "lx3a_one", 0, LNodes, nil, LReports);
  ABackend.Format.MergeObject(LSet, AMember, "lx3a_two", 0, LNodes, nil, LReports);
  LReports.PrintAll();
end;

var
  LBackend: ref Backend;
  LObjects: ObjectFileArray;
  LLibrary: ByteArray;
  LImage: ByteArray;
  LObject: ElfObjectData;
  LPaths: StringArray;
begin
  LBackend := BackendFor(LINUX_TRIPLE);
  setlength(LObjects, 2);
  LObjects[0].MemberName := "lx3a_lib";
  LObjects[0].Bytes := LBackend.Format.WriteObject(LibrarySet());
  LObjects[1].MemberName := "lx3a_more";
  LObjects[1].Bytes := LBackend.Format.WriteObject(OtherSet());
  LLibrary := LBackend.Format.WriteStaticLibrary(LObjects);
  println("{}", "library liblx3a.a " + IntToStr(len(LLibrary)) + " bytes");
  if not WriteAllBytes(HereDir() + "/liblx3a.a", LLibrary) then
    println("the library could not be written");
  end;
  LPaths := Paths(paramstr(1), paramstr(2));
  LImage := Link(LBackend, ProgramSet(), "lx3a_start", LPaths);
  if len(LImage) > 0 then
    ShowHeaders(LImage);
    ShowSections(LImage, LObject);
    ShowChecks(LImage, LObject);
    if not WriteAllBytes(HereDir() + "/lx3a_static", LImage) then
      println("the image could not be written");
    end;
  end;
  ShowReports(LBackend, LPaths, LObjects[0].Bytes);
end.
