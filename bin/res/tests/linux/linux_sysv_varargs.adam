-------------------------------------------------------------------------------
  linux_sysv_varargs.adam - variadic calls and functions through
  x86_64-linux-gnu's ABI part (Adam.SysV.ABI, imported from the compiler's
  own src\, beside bin\): a variadic call sets al to the vector registers
  its arguments take; a variadic function homes every argument register
  in a 176-byte register save area, keeps the va_list state after it,
  gp_offset / fp_offset past its fixed parameters' registers and its
  first stacked variadic argument past its stacked fixed ones
  (PLAN-LINUX64 LX1b)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | arg 0 rdi
  | arg 1 xmm0
  | arg 2 xmm1
  | arg 3 xmm2
  | arg 4 rsi
  | result rax
  | outgoing 0
  | vectors rax 3
  | home rdi entry +0
  | home rsi entry +8
  | home rdx entry +16
  | home rcx entry +24
  | home r8 entry +32
  | home r9 entry +40
  | home xmm0 entry +48
  | home xmm1 entry +64
  | home xmm2 entry +80
  | home xmm3 entry +96
  | home xmm4 entry +112
  | home xmm5 entry +128
  | home xmm6 entry +144
  | home xmm7 entry +160
  | first entry +8
  | save 200 state +176 gp 8 fp 48
  | home rdi entry +0
  | home rsi entry +8
  | home rdx entry +16
  | home rcx entry +24
  | home r8 entry +32
  | home r9 entry +40
  | home xmm0 entry +48
  | home xmm1 entry +64
  | home xmm2 entry +80
  | home xmm3 entry +96
  | home xmm4 entry +112
  | home xmm5 entry +128
  | home xmm6 entry +144
  | home xmm7 entry +160
  | first entry +16
  | save 200 state +176 gp 48 fp 64
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe linux_sysv_varargs;

@addmodulepath "$P:../src";

import System.SysUtils, Adam.Backend.SSA, Adam.Backend.Parts, Adam.SysV.ABI;

// A variadic signature of AResult with the parameters ATypes
func Variadic(const AResult: IRType; const ATypes: array of IRType): ref IRSignature;
var
  LSignature: ref IRSignature;
  LI: int64;
begin
  LSignature := ref IRSignature(AResult);
  for LI := 0 to len(ATypes) - 1 do
    LSignature.AddParam(ATypes[LI]);
  end;
  LSignature.Variadic := true;
  return LSignature;
end;

var
  GABI: ref SysVABI;

begin
  GABI := ref SysVABI();
  // a call site of printf(fmt, 1.0, 2.0, 3.0, n): al = 3
  print(GABI.LayoutCall(Variadic(IRType.Int32, [IRType.Pointer, IRType.Float64, IRType.Float64,
    IRType.Float64, IRType.Int64])).Text());
  // func(const AFormat: ptr; ...): one integer register named
  print(GABI.LayoutVarargs(Variadic(IRType.Void, [IRType.Pointer])).Text());
  // seven integers (the seventh stacked) and a float named
  print(GABI.LayoutVarargs(Variadic(IRType.Void, [IRType.Int64, IRType.Int64, IRType.Int64,
    IRType.Int64, IRType.Int64, IRType.Int64, IRType.Int64, IRType.Float64])).Text());
end.
