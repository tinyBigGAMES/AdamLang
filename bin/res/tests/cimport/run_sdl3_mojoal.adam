-------------------------------------------------------------------------------
  run_sdl3_mojoal.adam - adam cimport: the real-world proof: SDL3 and mojoAL
  imported whole (the std units System.SDL3.C / System.MojoAL.C), linked as the
  static libsdl3.a + libmojoal.a (and SDL's system DLLs, the unit's own
  @linklibrary list) and called: SDL init, hints, a record by pointer, a
  function-like macro with a pointer cast; OpenAL's device, context,
  buffer and source on SDL's dummy audio driver (no device needed)
  (PLAN-ADAM M9i; written by scripts\adam\gen_cimport_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok sdl init
  | ok sdl hint
  | ok audio drivers
  | ok rect intersection
  | ok iconv macro
  | ok al device
  | ok al context
  | ok al version
  | ok al buffer
  | ok al source
  | ok al error
  | ok al teardown
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe run_sdl3_mojoal;

import System.SysUtils, System.SDL3.C, System.MojoAL.C;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

var
  LA: SDL_Rect;
  LB: SDL_Rect;
  LR: SDL_Rect;
  LWide: ptr to Uint16;
  LDevice: ptr to ALCdevice;
  LContext: ptr to ALCcontext;
  LVersion: ptr to const ALchar;
  LSamples: array[0..63] of int16;
  LBuffer: ALuint;
  LSource: ALuint;
  LBound: ALint;
  LI: int64;
begin
  GFails := 0;
  // no device is needed: SDL's dummy audio driver plays nowhere
  Check("sdl init", SDL_Init(0));
  Check("sdl hint", SDL_SetHint(SDL_HINT_AUDIO_DRIVER, "dummy"));
  Check("audio drivers", SDL_GetNumAudioDrivers() > 0);
  LA := SDL_Rect(x: 0, y: 0, w: 10, h: 10);
  LB := SDL_Rect(x: 5, y: 5, w: 10, h: 10);
  Check("rect intersection", SDL_GetRectIntersection(addr of LA, addr of LB, addr of LR) and
    (LR.x = 5) and (LR.y = 5) and (LR.w = 5) and (LR.h = 5));
  // a function-like macro with a pointer cast (SDL_reinterpret_cast(Uint16 *, ..)). "UCS-2"
  // is the converter's: SDL's own on win64 is big-endian, so on x86_64 'A' (0x0041) reads
  // 0x4100; on linux SDL hands it to glibc's iconv, whose UCS-2 is the host's order (0x0041)
  LWide := SDL_iconv_utf8_ucs2("Ad");
@ifdef TARGET_X86_64_LINUX_GNU
  Check("iconv macro", (LWide <> nil) and (LWide[0] = 0x0041) and (LWide[1] = 0x0064) and
    (LWide[2] = 0));
@else
  Check("iconv macro", (LWide <> nil) and (LWide[0] = 0x4100) and (LWide[1] = 0x6400) and
    (LWide[2] = 0));
@endif
  SDL_free(LWide);
  // mojoAL starts SDL's audio itself at the first device
  LDevice := alcOpenDevice(nil);
  Check("al device", LDevice <> nil);
  LContext := alcCreateContext(LDevice, nil);
  Check("al context", (LContext <> nil) and (int32(alcMakeContextCurrent(LContext)) = ALC_TRUE));
  LVersion := alGetString(AL_VERSION);
  Check("al version", (LVersion <> nil) and StartsStr("1.1", StringFromC(LVersion)));
  for LI := 0 to 63 do
    LSamples[LI] := int16(LI * 100);
  end;
  alGenBuffers(1, addr of LBuffer);
  alBufferData(LBuffer, AL_FORMAT_MONO16, addr of LSamples, ALsizei(len(LSamples) * 2), 22050);
  Check("al buffer", int32(alIsBuffer(LBuffer)) = AL_TRUE);
  alGenSources(1, addr of LSource);
  alSourcei(LSource, AL_BUFFER, ALint(LBuffer));
  alGetSourcei(LSource, AL_BUFFER, addr of LBound);
  Check("al source", ALuint(LBound) = LBuffer);
  Check("al error", alGetError() = AL_NO_ERROR);
  alDeleteSources(1, addr of LSource);
  alDeleteBuffers(1, addr of LBuffer);
  alcMakeContextCurrent(nil);
  alcDestroyContext(LContext);
  Check("al teardown", int32(alcCloseDevice(LDevice)) = ALC_TRUE);
  SDL_Quit();
  println("done {}", GFails);
end.
