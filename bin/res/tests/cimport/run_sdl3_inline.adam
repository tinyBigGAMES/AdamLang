-------------------------------------------------------------------------------
  run_sdl3_inline.adam - adam cimport: SDL's own inline routines (SDL_rect.h,
  SDL_endian.h, SDL_bits.h, SDL_stdinc.h) as System.SDL3.C translates them,
  called for a spread of values (edges included) against the same routines
  compiled from SDL's headers (rs_sdl_inline in libcimport_sdl.a)
  (PLAN-ADAM M9j4b; written by scripts\adam\gen_cimport_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok SDL_PointInRect
  | ok SDL_PointInRectFloat
  | ok SDL_RectEmpty
  | ok SDL_RectEmptyFloat
  | ok SDL_RectsEqual
  | ok SDL_RectsEqualFloat
  | ok SDL_RectsEqualEpsilon
  | ok SDL_RectToFRect
  | ok SDL_SwapFloat
  | ok SDL_MostSignificantBitIndex32
  | ok SDL_HasExactlyOneBitSet32
  | ok SDL_size_mul_check_overflow
  | ok SDL_size_mul_check_overflow_builtin
  | ok SDL_size_add_check_overflow
  | ok SDL_size_add_check_overflow_builtin
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe run_sdl3_inline;

@addlibrarypath "$P:res/tests/cimport/fixtures";

import System.SysUtils, System.SDL3.C;

// C's result of case AWhich for AV: SDL's own inline routines compiled from its headers
routine clink rs_sdl_inline(const AWhich: int32; const AV: int32): int64; external "cimport_sdl";

// A bool as C's 0 / 1
routine Bit(const AValue: bool): int64;
begin
  if AValue then
    return 1;
  end;
  return 0;
end;

// The Adam translations' result of case AWhich for AV (rs_sdl_inline's cases)
routine AdamCase(const AWhich: int32; const AV: int32): int64;
var
  LP: SDL_Point;
  LR: SDL_Rect;
  LR2: SDL_Rect;
  LFP: SDL_FPoint;
  LFR: SDL_FRect;
  LFR2: SDL_FRect;
  LM: uint64;
  LF: float32;
  LBits: ptr to uint32;
  LOk: bool;
begin
  LR := SDL_Rect(x: 0, y: 0, w: 10, h: 10);
  LFR := SDL_FRect(x: 0.0f, y: 0.0f, w: 10.0f, h: 10.0f);
  LM := 0u;
  if AWhich = 0 then
    LP.x := AV;
    LP.y := AV - 1;
    return Bit(SDL_PointInRect(addr of LP, addr of LR)) * 100 + Bit(SDL_PointInRect(nil, addr of LR)) * 10 +
      Bit(SDL_PointInRect(addr of LP, nil));
  end;
  if AWhich = 1 then
    LFP.x := float32(AV) * 0.5f;
    LFP.y := float32(AV);
    return Bit(SDL_PointInRectFloat(addr of LFP, addr of LFR)) * 100 +
      Bit(SDL_PointInRectFloat(nil, addr of LFR)) * 10 + Bit(SDL_PointInRectFloat(addr of LFP, nil));
  end;
  if AWhich = 2 then
    LR.w := AV;
    LR.h := AV - 1;
    return Bit(SDL_RectEmpty(addr of LR)) * 10 + Bit(SDL_RectEmpty(nil));
  end;
  if AWhich = 3 then
    LFR.w := float32(AV) * 0.5f;
    LFR.h := float32(AV) - 0.5f;
    return Bit(SDL_RectEmptyFloat(addr of LFR)) * 10 + Bit(SDL_RectEmptyFloat(nil));
  end;
  if AWhich = 4 then
    LR := SDL_Rect(x: AV, y: 1, w: 2, h: 3);
    LR2 := LR;
    LR2.h := ((AV & 1) <> 0) ? 3 : 4;
    return Bit(SDL_RectsEqual(addr of LR, addr of LR2)) * 100 + Bit(SDL_RectsEqual(addr of LR, nil)) * 10 +
      Bit(SDL_RectsEqual(addr of LR, addr of LR));
  end;
  if AWhich = 5 then
    LFR.x := float32(AV);
    LFR2 := LFR;
    LFR2.x := LFR.x + float32(AV & 3) * 0.0000001f;
    return Bit(SDL_RectsEqualFloat(addr of LFR, addr of LFR2)) * 100 +
      Bit(SDL_RectsEqualFloat(nil, addr of LFR2)) * 10 + Bit(SDL_RectsEqualFloat(addr of LFR, addr of LFR));
  end;
  if AWhich = 6 then
    LFR2 := LFR;
    LFR2.w := LFR.w + 1.0f;
    return Bit(SDL_RectsEqualEpsilon(addr of LFR, addr of LFR2, float32(AV & 3) * 0.5f)) * 10 +
      Bit(SDL_RectsEqualEpsilon(addr of LFR, nil, 1.0f));
  end;
  if AWhich = 7 then
    LR := SDL_Rect(x: AV, y: -AV, w: AV * 2, h: 7);
    SDL_RectToFRect(addr of LR, addr of LFR);
    return int64(LFR.x) + int64(LFR.y) * 3 + int64(LFR.w) * 7 + int64(LFR.h) * 11;
  end;
  if AWhich = 8 then
    LF := SDL_SwapFloat(float32(AV) + 0.5f);
    LBits := ptr to uint32(addr of LF);
    return int64(LBits^);
  end;
  if AWhich = 9 then
    return SDL_MostSignificantBitIndex32(uint32(AV));
  end;
  if AWhich = 10 then
    return Bit(SDL_HasExactlyOneBitSet32(uint32(AV)));
  end;
  if AWhich = 11 then
    LOk := SDL_size_mul_check_overflow(uint64(int64(AV)), 0x4000000000000000u, addr of LM);
    return Bit(LOk) * 1000 + int64(LM & 0xFFu);
  end;
  if AWhich = 12 then
    LOk := SDL_size_mul_check_overflow_builtin(uint64(int64(AV)), 0x4000000000000000u, addr of LM);
    return Bit(LOk) * 1000 + int64(LM & 0xFFu);
  end;
  if AWhich = 13 then
    LOk := SDL_size_add_check_overflow(uint64(int64(AV)), 0xFFFFFFFFFFFFFFF0u, addr of LM);
    return Bit(LOk) * 100000 + int64(LM & 0xFFFFu);
  end;
  LOk := SDL_size_add_check_overflow_builtin(uint64(int64(AV)), 0xFFFFFFFFFFFFFFF0u, addr of LM);
  return Bit(LOk) * 100000 + int64(LM & 0xFFFFu);
end;

const
  NAMES: array[0..14] of string = ["SDL_PointInRect", "SDL_PointInRectFloat", "SDL_RectEmpty",
    "SDL_RectEmptyFloat", "SDL_RectsEqual", "SDL_RectsEqualFloat", "SDL_RectsEqualEpsilon",
    "SDL_RectToFRect", "SDL_SwapFloat", "SDL_MostSignificantBitIndex32", "SDL_HasExactlyOneBitSet32",
    "SDL_size_mul_check_overflow", "SDL_size_mul_check_overflow_builtin",
    "SDL_size_add_check_overflow", "SDL_size_add_check_overflow_builtin"];
  // a spread through each routine's edges: 0, signs, the rect's bounds (10), powers of two, the
  // widest values every case's arithmetic holds (0x3FFFFFFF * 2, -0x40000000 = bit 31 alone)
  VALUES: array[0..12] of int32 = [-0x40000000, -7, -1, 0, 1, 2, 3, 4, 9, 10, 11, 12, 0x3FFFFFFF];

var
  LFails: int32;
  LSame: bool;
  LWhich: int32;
  LI: int32;
begin
  LFails := 0;
  for LWhich := 0 to 14 do
    LSame := true;
    for LI := 0 to 12 do
      if AdamCase(LWhich, VALUES[LI]) <> rs_sdl_inline(LWhich, VALUES[LI]) then
        LSame := false;
      end;
    end;
    if LSame then
      println("ok {}", NAMES[LWhich]);
    else
      println("FAIL {}", NAMES[LWhich]);
      LFails := LFails + 1;
    end;
  end;
  println("done {}", LFails);
end.
