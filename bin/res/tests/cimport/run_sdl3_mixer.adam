-------------------------------------------------------------------------------
  run_sdl3_mixer.adam - adam cimport: SDL3_mixer through its std unit, whose
  header includes SDL's (System.SDL3.C imported for SDL_AudioSpec /
  SDL_IOStream): a mixer with no audio device, a WAV decoded from memory
  through SDL's IOStream, a 1 kHz sine track rendered by MIX_Generate and
  its peak checked (static libsdl3_mixer.a + libsdl3.a)
  (PLAN-ADAM M9i; written by scripts\adam\gen_cimport_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok mix init
  | ok mix version
  | ok decoders
  | ok mixer
  | ok mixer format
  | ok wav from memory
  | ok wav duration
  | ok sine
  | ok track
  | ok generate
  | ok samples
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe run_sdl3_mixer;

import System.SysUtils, System.SDL3.C, System.SDL3_mixer.C;

const
  // A WAV file: 16-bit mono PCM at 8000 Hz, 8 samples (44-byte header + 16 bytes of data)
  WAV_BYTES: array[0..59] of uint8 = [
    82, 73, 70, 70, 52, 0, 0, 0, 87, 65, 86, 69,
    102, 109, 116, 32, 16, 0, 0, 0, 1, 0, 1, 0, 64, 31, 0, 0, 128, 62, 0, 0, 2, 0, 16, 0,
    100, 97, 116, 97, 16, 0, 0, 0,
    0, 0, 232, 3, 208, 7, 184, 11, 160, 15, 136, 19, 112, 23, 88, 27];

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when the decoder list names AName
func HasDecoder(const AName: string): bool;
var
  LI: int32;
begin
  for LI := 0 to MIX_GetNumAudioDecoders() - 1 do
    if StringFromC(MIX_GetAudioDecoder(LI)) = AName then
      return true;
    end;
  end;
  return false;
end;

var
  LSpec: SDL_AudioSpec;
  LGot: SDL_AudioSpec;
  LMixer: ptr to MIX_Mixer;
  LWAV: ptr to MIX_Audio;
  LSine: ptr to MIX_Audio;
  LTrack: ptr to MIX_Track;
  LWAVBytes: array[0..59] of uint8;
  LBuffer: array[0..4799] of float32;
  LMixed: int32;
  LPeak: float32;
  LI: int64;
begin
  GFails := 0;
  Check("mix init", MIX_Init());
  // the header's SDL_MIXER_VERSION, SDL_VERSIONNUM(3, 2, 4) folded by adam cimport
  Check("mix version", MIX_Version() = SDL_MIXER_VERSION);
  Check("decoders", HasDecoder("WAV") and HasDecoder("STBVORBIS") and HasDecoder("DRMP3"));
  // a mixer with no audio device: MIX_Generate renders it into a buffer
  LSpec := SDL_AudioSpec(format: SDL_AUDIO_F32, channels: 1, freq: 48000);
  LMixer := MIX_CreateMixer(addr of LSpec);
  Check("mixer", LMixer <> nil);
  Check("mixer format", MIX_GetMixerFormat(LMixer, addr of LGot) and (LGot.freq = 48000) and
    (LGot.channels = 1));
  // a WAV read from memory through SDL's IOStream (System.SDL3.C's type)
  LWAVBytes := WAV_BYTES;
  LWAV := MIX_LoadAudio_IO(LMixer, SDL_IOFromConstMem(addr of LWAVBytes, 60), true, true);
  Check("wav from memory", LWAV <> nil);
  Check("wav duration", MIX_GetAudioDuration(LWAV) = 8);
  LSine := MIX_CreateSineWaveAudio(LMixer, 1000, 0.5f, 100);
  Check("sine", LSine <> nil);
  LTrack := MIX_CreateTrack(LMixer);
  Check("track", (LTrack <> nil) and MIX_SetTrackAudio(LTrack, LSine) and MIX_PlayTrack(LTrack, 0));
  // 100 ms of the 1 kHz sine at 48 kHz: 4800 frames, its peak the amplitude
  LMixed := MIX_Generate(LMixer, addr of LBuffer, 4800 * 4);
  Check("generate", LMixed = 4800 * 4);
  LPeak := 0.0f;
  for LI := 0 to 4799 do
    if LBuffer[LI] > LPeak then
      LPeak := LBuffer[LI];
    end;
  end;
  Check("samples", (LPeak > 0.45f) and (LPeak < 0.55f));
  MIX_DestroyAudio(LWAV);
  MIX_DestroyAudio(LSine);
  MIX_DestroyMixer(LMixer);
  MIX_Quit();
  println("done {}", GFails);
end.
