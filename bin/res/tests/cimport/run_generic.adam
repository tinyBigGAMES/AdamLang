-------------------------------------------------------------------------------
  run_generic.adam - adam cimport: the header's helper macros no bound
  routine types (min, clamp, a bit field, a mask, a version number, a
  fourcc of four type parameters, a flag test, unary and div / mod) as
  System.RunCalls.C writes them, generic routines, called with int32,
  int64, uint32 and uint8 arguments against C's own results
  (rc_c_generic in libcimport_run.a)
  (PLAN-ADAM M9k; written by scripts\adam\gen_cimport_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  deps cimport.run_calls_unit
  exitcode 0
  | ok min
  | ok min64
  | ok clamp
  | ok field
  | ok mask
  | ok version
  | ok fourcc
  | ok flagged
  | ok neg
  | ok divmod
  | ok min8
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe run_generic;

// The unit cimport.run_calls_unit wrote into the output root, adam's working folder
@addmodulepath ".";
@addlibrarypath "$P:res/tests/cimport/fixtures";

import System.SysUtils, System.RunCalls.C;

// The generic routines' result of case AWhich for AV (rc_c_generic's cases, the same types)
routine AdamCase(const AWhich: int32; const AV: int64): int64;
begin
  if AWhich = 0 then
    return RC_MIN(int32(AV), 3);
  end;
  if AWhich = 1 then
    return RC_MIN(AV * 1000000000, int64(5));
  end;
  if AWhich = 2 then
    return RC_CLAMP(int32(AV), -2, 9);
  end;
  if AWhich = 3 then
    return RC_FIELD(uint32(AV + 100) * 0x01010101u);
  end;
  if AWhich = 4 then
    return RC_MASK(int32(AV & 7) + 1);
  end;
  if AWhich = 5 then
    return RC_VERSION(int32(AV), 2, 3);
  end;
  if AWhich = 6 then
    return RC_FOURCC(65, int32(AV), AV + 1, 68);
  end;
  if AWhich = 7 then
    return RC_FLAGGED(uint32(AV + 100) << 24);
  end;
  if AWhich = 8 then
    return RC_NEG(int32(AV));
  end;
  if AWhich = 9 then
    return RC_DIVMOD(int32(AV));
  end;
  return RC_MIN(uint8(AV + 100), uint8(104));
end;

const
  NAMES: array[0..10] of string = ["min", "min64", "clamp", "field", "mask", "version", "fourcc",
    "flagged", "neg", "divmod", "min8"];
  VALUES: array[0..7] of int64 = [-7, -1, 0, 1, 3, 4, 9, 12];

var
  LFails: int32;
  LSame: bool;
  LWhich: int32;
  LI: int32;
begin
  LFails := 0;
  for LWhich := 0 to 10 do
    LSame := true;
    for LI := 0 to 7 do
      if AdamCase(LWhich, VALUES[LI]) <> rc_c_generic(LWhich, VALUES[LI]) then
        LSame := false;
      end;
    end;
    if LSame then
      println("ok {}", NAMES[LWhich]);
    else
      println("FAIL {}", NAMES[LWhich]);
      LFails := LFails + 1;
    end;
  end;
  println("done {}", LFails);
end.
