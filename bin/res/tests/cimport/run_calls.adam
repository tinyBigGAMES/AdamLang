-------------------------------------------------------------------------------
  run_calls.adam - adam cimport: the unit cimport.run_calls_unit wrote, built and called:
  ints, floats, records by value both ways (8 bytes in a register, 16 and 20
  through memory), a callback of the header's routine type, enum consts, a
  variadic call, an external variable, narrow results, stack arguments
  ([renames] of a routine and a variable: their external clauses name C's
  symbols, M9e0a); M9e: bitfields both ways, a #pragma pack record, an
  anonymous union, a flexible array member, sizes against C's sizeof, an
  asm label; M9f: macros as a const, a string, a record and routines (PLAN-ADAM M9d / M9e / M9f; written by scripts\adam\gen_cimport_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  deps cimport.run_calls_unit
  exitcode 0
  | ok add
  | ok scale
  | ok vec by value
  | ok span returned
  | ok big by value
  | ok sum
  | ok callback
  | ok enum
  | ok fill
  | ok varargs
  | ok variable
  | ok narrow result
  | ok short
  | ok stack args
  | ok bitfields to C
  | ok bitfields from C
  | ok packed
  | ok anonymous union
  | ok flexible array
  | ok sizes
  | ok asm label
  | ok macro const
  | ok macro string
  | ok macro record
  | ok macro routine
  | ok macro places
  | ok macro builtins
  | ok macro overflow
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe run_calls;

// The unit cimport.run_calls_unit wrote into the output root, adam's working folder
@addmodulepath ".";
@addlibrarypath "$P:res/tests/cimport/fixtures";

import System.SysUtils, System.RunCalls.C;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// M9j2: rc_m_cell's sequence through the Adam translations of the same macros
func CellRun(const ACell: ptr to rc_cell; const AV: int32): int32;
var
  LT: int32;
begin
  LT := RC_CELL_VALUE(ACell) * 1000 + RC_CELL_LINKED(ACell);
  RC_CELL_SET(ACell, AV);
  RC_CELL_MIX(ACell, 5);
  RC_CELL_DIV(ACell, 3);
  RC_CELL_BUMP(ACell);
  LT := LT + RC_CELL_STEP(ACell);
  RC_CELL_CLEAR(ACell);
  return LT + ACell^.value * 7 + int32(ACell^.small) + ACell^.slots[0] * 11 + ACell^.slots[2] * 13 +
    int32(ACell^.next = nil);
end;

// M9j2: rc_m_bits' sum through the Adam translations
func BitsRun(const AV: uint64): uint64;
begin
  return uint64(RC_SWAP16(uint16(AV))) + uint64(RC_SWAP32(uint32(AV))) + RC_SWAP64(AV) +
    uint64(RC_MSB(uint32(AV) | 1u) * 3) + uint64(RC_CTZLL(AV | 0x8000000000000000u) * 5) +
    uint64(RC_POP(uint32(AV)) * 7);
end;

// M9j2: an overflow macro's result and stored value, Adam's against C's
func OvSame(const AA: uint64; const AB: uint64; const AMul: bool): bool;
var
  LAdam: uint64;
  LC: uint64;
  LGot: int32;
begin
  LAdam := 7u;
  LC := 9u;
  if AMul then
    LGot := RC_MUL_OV(AA, AB, addr of LAdam);
  else
    LGot := RC_ADD_OV(AA, AB, addr of LAdam);
  end;
  return (LGot = rc_m_ov(AA, AB, addr of LC, int32(AMul))) and (LAdam = LC);
end;

// rc_fold's callback: the running total plus the value times the scale AUser points at
func clink Fold(AAcc: int32; AValue: int32; AUser: ptr): int32;
var
  LScale: ptr to int32;
begin
  LScale := ptr to int32(AUser);
  return AAcc + AValue * LScale^;
end;

var
  LA: vec2;
  LB: vec2;
  LV: vec2;
  LText: string;
  LSpan: span;
  LBigA: big;
  LBigB: big;
  LBig: big;
  LValues: array[0..4] of int32;
  LScale: int32;
  LBuffer: array[0..15] of char;
  LI: int32;
  LBits: rc_bits;
  LPacked: rc_packed;
  LVariant: rc_variant;
  LFlex: ptr to rc_flex;
  LCellA: rc_cell;
  LCellB: rc_cell;
  LNext: rc_cell;
  LMax: uint64;
begin
  Check("add", Add(40, 2) = 42);
  Check("scale", rc_scale(2.5, 4.0) = 10.0);

  LA.x := 1.5;
  LA.y := 2.0;
  LB.x := 0.5;
  LB.y := -1.0;
  LV := rc_vec_add(LA, LB);
  Check("vec by value", (LV.x = 2.0) and (LV.y = 1.0));

  LText := "hello";
  LSpan := rc_span_of(LText);
  Check("span returned", (LSpan.length = 5) and (StringFromC(LSpan.text) = "hello"));

  LBigA.a := 1;
  LBigA.b := 2;
  LBigA.c := 3;
  LBigA.d := 4;
  LBigA.e := 5;
  LBigB.a := 10;
  LBigB.b := 20;
  LBigB.c := 30;
  LBigB.d := 40;
  LBigB.e := 50;
  LBig := rc_big_sum(LBigA, LBigB);
  Check("big by value", (LBig.a = 11) and (LBig.b = 22) and (LBig.c = 33) and (LBig.d = 44) and
    (LBig.e = 55) and (LBigA.e = 5));

  for LI := 0 to 4 do
    LValues[LI] := LI + 1;
  end;
  Check("sum", rc_sum(addr of LValues[0], 5) = 15);
  LScale := 2;
  Check("callback", rc_fold(addr of LValues[0], 5, Fold, addr of LScale) = 30);
  Check("enum", (rc_apply(MODE_ADD, 6, 7) = 13) and (rc_apply(MODE_MUL, 6, 7) = 42));

  rc_fill(addr of LBuffer[0], 16);
  Check("fill", StringFromC(addr of LBuffer[0]) = "filled");
  Check("varargs", rc_sum_args(3, 10, 20, 30) = 60);

  Counter := 5;
  rc_bump();
  rc_bump();
  Check("variable", Counter = 7);
  Check("narrow result", rc_low_byte(4660) = 52);
  Check("short", rc_neg_short(12) = -12);
  Check("stack args", rc_mixed(1, 2.0, 3, 4.0, 5, 6.0) = 21);

  // M9e: bitfields placed by the target's rule on both sides
  LBits.a := 5;
  LBits.b := 17;
  LBits.c := -3;
  LBits.s := 300;
  Check("bitfields to C", rc_bits_value(addr of LBits) = 5 + 170 - 300 + 300000);
  rc_bits_set(addr of LBits);
  Check("bitfields from C", (LBits.a = 6) and (LBits.b = 21) and (LBits.c = -5) and
    (LBits.s = 400));
  LPacked.c := char(1);
  LPacked.i := 1000;
  LPacked.s := 20;
  Check("packed", rc_packed_sum(addr of LPacked) = 1021);
  LVariant.kind := 1;
  LVariant.d := 2.5;
  Check("anonymous union", rc_variant_value(addr of LVariant) = 2.5);
  LFlex := ptr to rc_flex(getmem(size(rc_flex) + 3 * size(int32)));
  LFlex^.len := 3;
  LFlex^.data[0] := 4;
  LFlex^.data[1] := 5;
  LFlex^.data[2] := 6;
  Check("flexible array", rc_flex_sum(LFlex) = 15);
  freemem(LFlex);
  Check("sizes", (rc_layout(0) = size(rc_bits)) and (rc_layout(1) = size(rc_packed)) and
    (rc_layout(2) = size(rc_variant)) and (rc_layout(3) = size(rc_flex)));
  Check("asm label", rc_asm(14) = 42);
  Check("macro const", RC_LIMIT = 100);
  Check("macro string", RC_NAME = "runcalls");
  Check("macro record", (RC_ORIGIN.x = 1.5f) and (RC_ORIGIN.y = -2.0f));
  Check("macro routine", (RC_ADD3(1, 2) = 6) and (RC_SCALE2(1.5, 2.0f) = 6.0));
  // M9j2
  LNext.value := 0;
  LNext.small := 0;
  LNext.next := nil;
  LCellA.value := 41;
  LCellA.small := 250;
  LCellA.next := addr of LNext;
  LCellA.slots[0] := 3;
  LCellA.slots[1] := 4;
  LCellA.slots[2] := 5;
  LCellB := LCellA;
  Check("macro places", (CellRun(addr of LCellA, 100) = rc_m_cell(addr of LCellB, 100)) and
    (LCellA.value = LCellB.value) and (LCellA.small = LCellB.small) and
    (LCellA.slots[0] = LCellB.slots[0]) and (LCellA.slots[2] = LCellB.slots[2]) and
    (LCellA.next = nil) and (LCellB.next = nil));
  Check("macro builtins", (BitsRun(0x0123456789ABCDEFu) = rc_m_bits(0x0123456789ABCDEFu)) and
    (BitsRun(1u) = rc_m_bits(1u)) and (BitsRun(0xFFFF0000u) = rc_m_bits(0xFFFF0000u)));
  LMax := 0xFFFFFFFFFFFFFFFFu;
  Check("macro overflow", OvSame(1u, 2u, false) and OvSame(LMax, 1u, false) and
    OvSame(LMax, 0u, false) and OvSame(3u, 5u, true) and OvSame(0u, LMax, true) and
    OvSame(0x100000000u, 0x100000000u, true) and OvSame(LMax, 2u, true) and OvSame(LMax, 1u, true));
  println("done {}", GFails);
end.
