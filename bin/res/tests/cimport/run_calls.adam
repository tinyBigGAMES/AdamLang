-------------------------------------------------------------------------------
  run_calls.adam - adam cimport: the unit cimport.run_calls_unit wrote, built and called:
  ints, floats, records by value both ways (8 bytes in a register, 16 and 20
  through memory), a callback of the header's routine type, enum consts, a
  variadic call, an external variable, narrow results, stack arguments
  ([renames] of a routine and a variable: their external clauses name C's
  symbols, M9e0a); M9e: bitfields both ways, a #pragma pack record, an
  anonymous union, a flexible array member, sizes against C's sizeof, an
  asm label; M9f: macros as a const, a string, a record and routines (PLAN-ADAM M9d / M9e / M9f; written by scripts\adam\gen_cimport_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  deps cimport.run_calls_unit
  exitcode 0
  | ok add
  | ok scale
  | ok vec by value
  | ok span returned
  | ok big by value
  | ok sum
  | ok callback
  | ok enum
  | ok fill
  | ok varargs
  | ok variable
  | ok narrow result
  | ok short
  | ok stack args
  | ok bitfields to C
  | ok bitfields from C
  | ok packed
  | ok anonymous union
  | ok flexible array
  | ok sizes
  | ok asm label
  | ok macro const
  | ok macro string
  | ok macro record
  | ok macro routine
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe run_calls;

// The unit cimport.run_calls_unit wrote into the output root, adam's working folder
@addmodulepath ".";
@addlibrarypath "$P:res/tests/cimport/fixtures";

import System.SysUtils, System.RunCalls.C;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// rc_fold's callback: the running total plus the value times the scale AUser points at
routine clink Fold(AAcc: int32; AValue: int32; AUser: ptr): int32;
var
  LScale: ptr to int32;
begin
  LScale := ptr to int32(AUser);
  return AAcc + AValue * LScale^;
end;

var
  LA: vec2;
  LB: vec2;
  LV: vec2;
  LText: ptr to char;
  LSpan: span;
  LBigA: big;
  LBigB: big;
  LBig: big;
  LValues: array[0..4] of int32;
  LScale: int32;
  LBuffer: array[0..15] of char;
  LI: int32;
  LBits: rc_bits;
  LPacked: rc_packed;
  LVariant: rc_variant;
  LFlex: ptr to rc_flex;
begin
  Check("add", Add(40, 2) = 42);
  Check("scale", rc_scale(2.5, 4.0) = 10.0);

  LA.x := 1.5;
  LA.y := 2.0;
  LB.x := 0.5;
  LB.y := -1.0;
  LV := rc_vec_add(LA, LB);
  Check("vec by value", (LV.x = 2.0) and (LV.y = 1.0));

  LText := StringToC("hello");
  LSpan := rc_span_of(LText);
  Check("span returned", (LSpan.length = 5) and (StringFromC(LSpan.text) = "hello"));
  freemem(LText);

  LBigA.a := 1;
  LBigA.b := 2;
  LBigA.c := 3;
  LBigA.d := 4;
  LBigA.e := 5;
  LBigB.a := 10;
  LBigB.b := 20;
  LBigB.c := 30;
  LBigB.d := 40;
  LBigB.e := 50;
  LBig := rc_big_sum(LBigA, LBigB);
  Check("big by value", (LBig.a = 11) and (LBig.b = 22) and (LBig.c = 33) and (LBig.d = 44) and
    (LBig.e = 55) and (LBigA.e = 5));

  for LI := 0 to 4 do
    LValues[LI] := LI + 1;
  end;
  Check("sum", rc_sum(addr of LValues[0], 5) = 15);
  LScale := 2;
  Check("callback", rc_fold(addr of LValues[0], 5, Fold, addr of LScale) = 30);
  Check("enum", (rc_apply(MODE_ADD, 6, 7) = 13) and (rc_apply(MODE_MUL, 6, 7) = 42));

  rc_fill(addr of LBuffer[0], 16);
  Check("fill", StringFromC(addr of LBuffer[0]) = "filled");
  Check("varargs", rc_sum_args(3, 10, 20, 30) = 60);

  Counter := 5;
  rc_bump();
  rc_bump();
  Check("variable", Counter = 7);
  Check("narrow result", rc_low_byte(4660) = 52);
  Check("short", rc_neg_short(12) = -12);
  Check("stack args", rc_mixed(1, 2.0, 3, 4.0, 5, 6.0) = 21);

  // M9e: bitfields placed by the target's rule on both sides
  LBits.a := 5;
  LBits.b := 17;
  LBits.c := -3;
  LBits.s := 300;
  Check("bitfields to C", rc_bits_value(addr of LBits) = 5 + 170 - 300 + 300000);
  rc_bits_set(addr of LBits);
  Check("bitfields from C", (LBits.a = 6) and (LBits.b = 21) and (LBits.c = -5) and
    (LBits.s = 400));
  LPacked.c := char(1);
  LPacked.i := 1000;
  LPacked.s := 20;
  Check("packed", rc_packed_sum(addr of LPacked) = 1021);
  LVariant.kind := 1;
  LVariant.d := 2.5;
  Check("anonymous union", rc_variant_value(addr of LVariant) = 2.5);
  LFlex := ptr to rc_flex(getmem(size(rc_flex) + 3 * size(int32)));
  LFlex^.len := 3;
  LFlex^.data[0] := 4;
  LFlex^.data[1] := 5;
  LFlex^.data[2] := 6;
  Check("flexible array", rc_flex_sum(LFlex) = 15);
  freemem(LFlex);
  Check("sizes", (rc_layout(0) = size(rc_bits)) and (rc_layout(1) = size(rc_packed)) and
    (rc_layout(2) = size(rc_variant)) and (rc_layout(3) = size(rc_flex)));
  Check("asm label", rc_asm(14) = 42);
  Check("macro const", RC_LIMIT = 100);
  Check("macro string", RC_NAME = "runcalls");
  Check("macro record", (RC_ORIGIN.x = 1.5f) and (RC_ORIGIN.y = -2.0f));
  Check("macro routine", (RC_ADD3(1, 2) = 6) and (RC_SCALE2(1.5, 2.0f) = 6.0));
  println("done {}", GFails);
end.
