  run_inline.adam - adam cimport: the header's static inline routines as
  System.RunCalls.C translates them (every statement form, locals hoisted, a
  local union / struct, const arrays, a shadowing local, calls in dependency
  order, clang's builtins) called for a spread of values against C's own
  results (rc_c_inline in libcimport_run.a)
  (PLAN-ADAM M9j4; written by scripts\adam\gen_cimport_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  deps cimport.run_calls_unit
  exitcode 0
  | ok clamp
  | ok sign
  | ok sum_to
  | ok skip
  | ok down
  | ok do
  | ok forever
  | ok in_rect
  | ok origin
  | ok swap
  | ok swap_float
  | ok pair
  | ok lookup
  | ok shadow
  | ok calls
  | ok msb
  | ok mul_ok
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe run_inline;

// The unit cimport.run_calls_unit wrote into the output root, adam's working folder
@addmodulepath ".";
@addlibrarypath "$P:res/tests/cimport/fixtures";

import System.SysUtils, System.RunCalls.C;

// The Adam translations' result of case AWhich for AV (rc_c_inline's cases, C's own)
func AdamCase(const AWhich: int32; const AV: int32): int64;
var
  LP: rc_pt;
  LR: rc_rect;
  LM: uint64;
  LOk: int32;
begin
  if AWhich = 0 then
    return rc_i_clamp(AV);
  end;
  if AWhich = 1 then
    return rc_i_sign(AV);
  end;
  if AWhich = 2 then
    return rc_i_sum_to(AV);
  end;
  if AWhich = 3 then
    return rc_i_skip(AV);
  end;
  if AWhich = 4 then
    return rc_i_down(AV);
  end;
  if AWhich = 5 then
    return rc_i_do(AV);
  end;
  if AWhich = 6 then
    return rc_i_forever(AV);
  end;
  if AWhich = 7 then
    LP.x := AV;
    LP.y := AV - 1;
    LR.x := 0;
    LR.y := 0;
    LR.w := 10;
    LR.h := 10;
    return rc_i_in_rect(addr of LP, addr of LR) * 10 + rc_i_in_rect(nil, addr of LR);
  end;
  if AWhich = 8 then
    LP.x := AV;
    LP.y := AV + 1;
    rc_i_origin(addr of LP);
    return LP.x * 100 + LP.y + 7;
  end;
  if AWhich = 9 then
    return int64(rc_i_swap(uint32(AV)));
  end;
  if AWhich = 10 then
    return int64(rc_i_swap_float(rc_i_swap_float(float32(AV) + float32(0.5))) * float32(2.0));
  end;
  if AWhich = 11 then
    return rc_i_pair(AV, AV * 3);
  end;
  if AWhich = 12 then
    return rc_i_lookup(AV & 1) + rc_i_lookup(2);
  end;
  if AWhich = 13 then
    return rc_i_shadow(AV);
  end;
  if AWhich = 14 then
    return rc_i_calls(AV);
  end;
  if AWhich = 15 then
    return rc_i_msb(uint32(AV) | 1u);
  end;
  LM := 0u;
  LOk := rc_i_mul_ok(uint64(AV), 0x4000000000000000u, addr of LM);
  return int64(LOk) * 1000 + int64(LM & 0xFFu);
end;

const
  NAMES: array[0..16] of string = ["clamp", "sign", "sum_to", "skip", "down", "do", "forever",
    "in_rect", "origin", "swap", "swap_float", "pair", "lookup", "shadow", "calls", "msb",
    "mul_ok"];
  VALUES: array[0..7] of int32 = [-7, -1, 0, 1, 3, 4, 9, 12];

var
  LFails: int32;
  LSame: bool;
  LWhich: int32;
  LI: int32;
begin
  LFails := 0;
  for LWhich := 0 to 16 do
    LSame := true;
    for LI := 0 to 7 do
      if AdamCase(LWhich, VALUES[LI]) <> rc_c_inline(LWhich, VALUES[LI]) then
        LSame := false;
      end;
    end;
    if LSame then
      println("ok {}", NAMES[LWhich]);
    else
      println("FAIL {}", NAMES[LWhich]);
      LFails := LFails + 1;
    end;
  end;
  println("done {}", LFails);
end.
