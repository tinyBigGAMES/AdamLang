-------------------------------------------------------------------------------
  run_sdl3_generic.adam - adam cimport: SDL's helper macros no bound routine
  types (pixel format and colorspace fields and tests, audio format bits,
  min / max / clamp, fourcc, version numbers, window positions, time units,
  byte swaps) as System.SDL3.C's generic routines, instantiated with the
  argument types SDL's users pass and called for a spread of values (real
  pixel formats, colorspaces, audio formats) against the same macros
  compiled from SDL's headers (rs_sdl_macro in libcimport_sdl.a)
  (PLAN-ADAM M9k; written by scripts\adam\gen_cimport_rows.py)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok SDL_PIXELTYPE
  | ok SDL_PIXELORDER
  | ok SDL_PIXELLAYOUT
  | ok SDL_PIXELFLAG
  | ok SDL_BITSPERPIXEL
  | ok SDL_ISPIXELFORMAT_INDEXED
  | ok SDL_ISPIXELFORMAT_PACKED
  | ok SDL_ISPIXELFORMAT_ARRAY
  | ok SDL_ISPIXELFORMAT_10BIT
  | ok SDL_ISPIXELFORMAT_FLOAT
  | ok SDL_ISPIXELFORMAT_ALPHA
  | ok SDL_ISPIXELFORMAT_FOURCC
  | ok SDL_COLORSPACETYPE
  | ok SDL_COLORSPACERANGE
  | ok SDL_COLORSPACECHROMA
  | ok SDL_COLORSPACEPRIMARIES
  | ok SDL_COLORSPACETRANSFER
  | ok SDL_COLORSPACEMATRIX
  | ok SDL_ISCOLORSPACE_MATRIX_BT601
  | ok SDL_ISCOLORSPACE_MATRIX_BT709
  | ok SDL_ISCOLORSPACE_MATRIX_BT2020_NCL
  | ok SDL_ISCOLORSPACE_FULL_RANGE
  | ok SDL_ISCOLORSPACE_LIMITED_RANGE
  | ok SDL_AUDIO_BITSIZE
  | ok SDL_AUDIO_BYTESIZE
  | ok SDL_AUDIO_ISFLOAT
  | ok SDL_AUDIO_ISBIGENDIAN
  | ok SDL_AUDIO_ISLITTLEENDIAN
  | ok SDL_AUDIO_ISSIGNED
  | ok SDL_AUDIO_ISINT
  | ok SDL_AUDIO_ISUNSIGNED
  | ok SDL_min
  | ok SDL_max
  | ok SDL_clamp
  | ok SDL_DEFINE_PIXELFORMAT
  | ok SDL_FOURCC
  | ok SDL_DEFINE_COLORSPACE
  | ok SDL_VERSIONNUM
  | ok SDL_VERSIONNUM_MAJOR
  | ok SDL_VERSIONNUM_MINOR
  | ok SDL_VERSIONNUM_MICRO
  | ok SDL_VERSION_ATLEAST
  | ok SDL_WINDOWPOS_CENTERED_DISPLAY
  | ok SDL_WINDOWPOS_ISCENTERED
  | ok SDL_WINDOWPOS_UNDEFINED_DISPLAY
  | ok SDL_WINDOWPOS_ISUNDEFINED
  | ok SDL_BUTTON_MASK
  | ok SDL_SCANCODE_TO_KEYCODE
  | ok SDL_MS_TO_NS
  | ok SDL_SECONDS_TO_NS
  | ok SDL_US_TO_NS
  | ok SDL_NS_TO_MS
  | ok SDL_NS_TO_SECONDS
  | ok SDL_NS_TO_US
  | ok SDL_Swap16LE
  | ok SDL_Swap32LE
  | ok SDL_Swap64LE
  | ok SDL_Swap16BE
  | ok SDL_Swap32BE
  | ok SDL_Swap64BE
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe run_sdl3_generic;

@ifdef TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/cimport/fixtures/x86_64-linux-gnu";
@else
@addlibrarypath "$P:res/tests/cimport/fixtures/x86_64-windows-gnu";
@endif

import System.SysUtils, System.SDL3.C;

// C's result of case AWhich for AV: SDL's helper macros compiled from its headers
func clink rs_sdl_macro(const AWhich: int32; const AV: int64): int64; external "cimport_sdl";

// The generic routines' result of case AWhich for AV (rs_sdl_macro's cases, the same types)
func AdamCase(const AWhich: int32; const AV: int64): int64;
begin
  if AWhich = 0 then
    return int64(SDL_PIXELTYPE(uint32(AV)));
  end;
  if AWhich = 1 then
    return int64(SDL_PIXELORDER(uint32(AV)));
  end;
  if AWhich = 2 then
    return int64(SDL_PIXELLAYOUT(uint32(AV)));
  end;
  if AWhich = 3 then
    return int64(SDL_PIXELFLAG(uint32(AV)));
  end;
  if AWhich = 4 then
    return int64(SDL_BITSPERPIXEL(uint32(AV)));
  end;
  if AWhich = 5 then
    return int64(SDL_ISPIXELFORMAT_INDEXED(uint32(AV)));
  end;
  if AWhich = 6 then
    return int64(SDL_ISPIXELFORMAT_PACKED(uint32(AV)));
  end;
  if AWhich = 7 then
    return int64(SDL_ISPIXELFORMAT_ARRAY(uint32(AV)));
  end;
  if AWhich = 8 then
    return int64(SDL_ISPIXELFORMAT_10BIT(uint32(AV)));
  end;
  if AWhich = 9 then
    return int64(SDL_ISPIXELFORMAT_FLOAT(uint32(AV)));
  end;
  if AWhich = 10 then
    return int64(SDL_ISPIXELFORMAT_ALPHA(uint32(AV)));
  end;
  if AWhich = 11 then
    return int64(SDL_ISPIXELFORMAT_FOURCC(uint32(AV)));
  end;
  if AWhich = 12 then
    return int64(SDL_COLORSPACETYPE(uint32(AV)));
  end;
  if AWhich = 13 then
    return int64(SDL_COLORSPACERANGE(uint32(AV)));
  end;
  if AWhich = 14 then
    return int64(SDL_COLORSPACECHROMA(uint32(AV)));
  end;
  if AWhich = 15 then
    return int64(SDL_COLORSPACEPRIMARIES(uint32(AV)));
  end;
  if AWhich = 16 then
    return int64(SDL_COLORSPACETRANSFER(uint32(AV)));
  end;
  if AWhich = 17 then
    return int64(SDL_COLORSPACEMATRIX(uint32(AV)));
  end;
  if AWhich = 18 then
    return int64(SDL_ISCOLORSPACE_MATRIX_BT601(uint32(AV)));
  end;
  if AWhich = 19 then
    return int64(SDL_ISCOLORSPACE_MATRIX_BT709(uint32(AV)));
  end;
  if AWhich = 20 then
    return int64(SDL_ISCOLORSPACE_MATRIX_BT2020_NCL(uint32(AV)));
  end;
  if AWhich = 21 then
    return int64(SDL_ISCOLORSPACE_FULL_RANGE(uint32(AV)));
  end;
  if AWhich = 22 then
    return int64(SDL_ISCOLORSPACE_LIMITED_RANGE(uint32(AV)));
  end;
  if AWhich = 23 then
    return int64(SDL_AUDIO_BITSIZE(uint16(AV)));
  end;
  if AWhich = 24 then
    return int64(SDL_AUDIO_BYTESIZE(uint16(AV)));
  end;
  if AWhich = 25 then
    return int64(SDL_AUDIO_ISFLOAT(uint16(AV)));
  end;
  if AWhich = 26 then
    return int64(SDL_AUDIO_ISBIGENDIAN(uint16(AV)));
  end;
  if AWhich = 27 then
    return int64(SDL_AUDIO_ISLITTLEENDIAN(uint16(AV)));
  end;
  if AWhich = 28 then
    return int64(SDL_AUDIO_ISSIGNED(uint16(AV)));
  end;
  if AWhich = 29 then
    return int64(SDL_AUDIO_ISINT(uint16(AV)));
  end;
  if AWhich = 30 then
    return int64(SDL_AUDIO_ISUNSIGNED(uint16(AV)));
  end;
  if AWhich = 31 then
    return int64(SDL_min(int32(AV), 4));
  end;
  if AWhich = 32 then
    return int64(SDL_max(int32(AV), 4));
  end;
  if AWhich = 33 then
    return int64(SDL_clamp(int32(AV), 0, 9));
  end;
  if AWhich = 34 then
    return int64(SDL_DEFINE_PIXELFORMAT(int32(AV & 15), 3, 2, 32, 4));
  end;
  if AWhich = 35 then
    return int64(SDL_FOURCC(AV, AV + 1, 65, 66));
  end;
  if AWhich = 36 then
    return int64(SDL_DEFINE_COLORSPACE(1, int32(AV & 3), 2, 3, 4, 1));
  end;
  if AWhich = 37 then
    return int64(SDL_VERSIONNUM(int32(AV & 7), 2, 18));
  end;
  if AWhich = 38 then
    return int64(SDL_VERSIONNUM_MAJOR(int32((AV & 0xFFFF) * 1003)));
  end;
  if AWhich = 39 then
    return int64(SDL_VERSIONNUM_MINOR(int32((AV & 0xFFFF) * 1003)));
  end;
  if AWhich = 40 then
    return int64(SDL_VERSIONNUM_MICRO(int32((AV & 0xFFFF) * 1003)));
  end;
  if AWhich = 41 then
    return int64(SDL_VERSION_ATLEAST(3, int32(AV & 7), 0));
  end;
  if AWhich = 42 then
    return int64(SDL_WINDOWPOS_CENTERED_DISPLAY(int32(AV & 3)));
  end;
  if AWhich = 43 then
    return int64(SDL_WINDOWPOS_ISCENTERED(int32(AV)));
  end;
  if AWhich = 44 then
    return int64(SDL_WINDOWPOS_UNDEFINED_DISPLAY(int32(AV & 3)));
  end;
  if AWhich = 45 then
    return int64(SDL_WINDOWPOS_ISUNDEFINED(int32(AV)));
  end;
  if AWhich = 46 then
    return int64(SDL_BUTTON_MASK(int32(AV & 7) + 1));
  end;
  if AWhich = 47 then
    return int64(SDL_SCANCODE_TO_KEYCODE(uint32(AV & 255)));
  end;
  if AWhich = 48 then
    return int64(SDL_MS_TO_NS(uint64(AV & 1023)));
  end;
  if AWhich = 49 then
    return int64(SDL_SECONDS_TO_NS(uint64(AV & 1023)));
  end;
  if AWhich = 50 then
    return int64(SDL_US_TO_NS(uint64(AV & 1023)));
  end;
  if AWhich = 51 then
    return int64(SDL_NS_TO_MS(uint64(AV & 0xFFFFFFFF) * 1000));
  end;
  if AWhich = 52 then
    return int64(SDL_NS_TO_SECONDS(uint64(AV & 0xFFFFFFFF) * 1000));
  end;
  if AWhich = 53 then
    return int64(SDL_NS_TO_US(uint64(AV & 0xFFFFFFFF) * 1000));
  end;
  if AWhich = 54 then
    return int64(SDL_Swap16LE(uint16(AV)));
  end;
  if AWhich = 55 then
    return int64(SDL_Swap32LE(uint32(AV)));
  end;
  if AWhich = 56 then
    return int64(int64(SDL_Swap64LE(uint64(AV))));
  end;
  if AWhich = 57 then
    return int64(SDL_Swap16BE(uint16(AV)));
  end;
  if AWhich = 58 then
    return int64(SDL_Swap32BE(uint32(AV)));
  end;
  if AWhich = 59 then
    return int64(int64(SDL_Swap64BE(uint64(AV))));
  end;
  return -1;
end;

const
  NAMES: array[0..59] of string = ["SDL_PIXELTYPE", "SDL_PIXELORDER", "SDL_PIXELLAYOUT", "SDL_PIXELFLAG", "SDL_BITSPERPIXEL", "SDL_ISPIXELFORMAT_INDEXED", "SDL_ISPIXELFORMAT_PACKED", "SDL_ISPIXELFORMAT_ARRAY", "SDL_ISPIXELFORMAT_10BIT", "SDL_ISPIXELFORMAT_FLOAT", "SDL_ISPIXELFORMAT_ALPHA", "SDL_ISPIXELFORMAT_FOURCC", "SDL_COLORSPACETYPE", "SDL_COLORSPACERANGE", "SDL_COLORSPACECHROMA", "SDL_COLORSPACEPRIMARIES", "SDL_COLORSPACETRANSFER", "SDL_COLORSPACEMATRIX", "SDL_ISCOLORSPACE_MATRIX_BT601", "SDL_ISCOLORSPACE_MATRIX_BT709", "SDL_ISCOLORSPACE_MATRIX_BT2020_NCL", "SDL_ISCOLORSPACE_FULL_RANGE", "SDL_ISCOLORSPACE_LIMITED_RANGE", "SDL_AUDIO_BITSIZE", "SDL_AUDIO_BYTESIZE", "SDL_AUDIO_ISFLOAT", "SDL_AUDIO_ISBIGENDIAN", "SDL_AUDIO_ISLITTLEENDIAN", "SDL_AUDIO_ISSIGNED", "SDL_AUDIO_ISINT", "SDL_AUDIO_ISUNSIGNED", "SDL_min", "SDL_max", "SDL_clamp", "SDL_DEFINE_PIXELFORMAT", "SDL_FOURCC", "SDL_DEFINE_COLORSPACE", "SDL_VERSIONNUM", "SDL_VERSIONNUM_MAJOR", "SDL_VERSIONNUM_MINOR", "SDL_VERSIONNUM_MICRO", "SDL_VERSION_ATLEAST", "SDL_WINDOWPOS_CENTERED_DISPLAY", "SDL_WINDOWPOS_ISCENTERED", "SDL_WINDOWPOS_UNDEFINED_DISPLAY", "SDL_WINDOWPOS_ISUNDEFINED", "SDL_BUTTON_MASK", "SDL_SCANCODE_TO_KEYCODE", "SDL_MS_TO_NS", "SDL_SECONDS_TO_NS", "SDL_US_TO_NS", "SDL_NS_TO_MS", "SDL_NS_TO_SECONDS", "SDL_NS_TO_US", "SDL_Swap16LE", "SDL_Swap32LE", "SDL_Swap64LE", "SDL_Swap16BE", "SDL_Swap32BE", "SDL_Swap64BE"];
  VALUES: array[0..18] of int64 = [-7, -1, 0, 1, 3, 4, 9, 12, 0x16462004, 0x13000801, 0x32595559, 0x16372004, 0x1A001010, 0x120005A0, 0x2210A505, 0x8010, 0x9120, 0x2FFF0003, 0x1FFF0000];

var
  LFails: int32;
  LSame: bool;
  LWhich: int32;
  LI: int32;
begin
  LFails := 0;
  for LWhich := 0 to 59 do
    LSame := true;
    for LI := 0 to 18 do
      if AdamCase(LWhich, VALUES[LI]) <> rs_sdl_macro(LWhich, VALUES[LI]) then
        LSame := false;
      end;
    end;
    if LSame then
      println("ok {}", NAMES[LWhich]);
    else
      println("FAIL {}", NAMES[LWhich]);
      LFails := LFails + 1;
    end;
  end;
  println("done {}", LFails);
end.
