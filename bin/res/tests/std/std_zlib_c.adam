-------------------------------------------------------------------------------
  std_zlib_c.adam - System.Zlib.C and System.Minizip.C, the raw C
  surface: the linked zlib's version, every record's size against the size
  C gives it on the target (ROW_C_*: clang / gcc over the same headers;
  culong 4 bytes on win64, 8 on linux), crc32 / adler32 / get_crc_table on known
  values, and the one-shot compress2 / uncompress through a ptr to uLongf
  (their failure path: a destination too small, Z_BUF_ERROR).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | version 1.4
  | size z_stream as C
  | size zip_fileinfo as C
  | size unz_global_info64 as C
  | size unz_file_info64 as C
  | size unz64_file_pos as C
  | size zlib_filefunc64_def as C
  | crc32 3421780262
  | crc32 nil 0
  | adler32 152961502
  | table[1] 1996959894
  | bound true
  | compress2 0
  | smaller true
  | uncompress 0
  | length 140
  | same true
  | small dest -5
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_zlib_c;

import System.SysUtils, System.Zlib.C, System.Minizip.C;

// ALabel and AValue on one line
routine Show(const ALabel: string; const AValue: int64);
begin
  println("{} {}", ALabel, AValue);
end;

// ALabel and "as C" when ASize is C's size AC of the record, else both sizes
routine ShowSize(const ALabel: string; const ASize: int64; const AC: int64);
begin
  if ASize = AC then
    println("{} as C", ALabel);
  else
    println("{} {}, C {}", ALabel, ASize, AC);
  end;
end;

// ALabel and true / false on one line
routine ShowBool(const ALabel: string; const AValue: bool);
begin
  if AValue then
    println("{}", ALabel + " true");
  else
    println("{}", ALabel + " false");
  end;
end;

// The NUL-terminated text at AText as a string
routine CText(const AText: ptr to const char): string;
var
  LText: string;
  LAt: int64;
begin
  LText := "";
  LAt := 0;
  while int32(AText[LAt]) <> 0 do
    LText := LText + AText[LAt];
    LAt := LAt + 1;
  end;
  return LText;
end;

const
@ifdef TARGET_X86_64_LINUX_GNU
  // The records' sizes as C gives them on the target (LP64: culong 8 bytes)
  ROW_C_Z_STREAM: int64 = 112;
  ROW_C_ZIP_FILEINFO: int64 = 48;
  ROW_C_UNZ_GLOBAL_INFO64: int64 = 16;
  ROW_C_UNZ_FILE_INFO64: int64 = 136;
  ROW_C_UNZ64_FILE_POS: int64 = 16;
  ROW_C_ZLIB_FILEFUNC64_DEF: int64 = 64;
@else
  // The records' sizes as C gives them on the target (LLP64: culong 4 bytes)
  ROW_C_Z_STREAM: int64 = 88;
  ROW_C_ZIP_FILEINFO: int64 = 36;
  ROW_C_UNZ_GLOBAL_INFO64: int64 = 16;
  ROW_C_UNZ_FILE_INFO64: int64 = 88;
  ROW_C_UNZ64_FILE_POS: int64 = 16;
  ROW_C_ZLIB_FILEFUNC64_DEF: int64 = 64;
@endif
  // The check value of every CRC-32 / Adler-32 catalogue
  CHECK_TEXT: string = "123456789";
  // ten times 14 bytes
  BODY_TEXT: string = "adam over zlibadam over zlibadam over zlibadam over zlibadam over zlibadam over zlibadam over zlibadam over zlibadam over zlibadam over zlib";

var
  GCheck: array[0..8] of uint8;
  GBody: array[0..139] of uint8;
  GPacked: array[0..255] of uint8;
  GBack: array[0..255] of uint8;
  GPackedLen: culong;
  GBackLen: culong;
  GTable: ptr to const uint32;
  GSame: bool;
  GI: int64;

begin
  println("{}", "version " + CText(zlibVersion()));
  ShowSize("size z_stream", size(z_stream), ROW_C_Z_STREAM);
  ShowSize("size zip_fileinfo", size(zip_fileinfo), ROW_C_ZIP_FILEINFO);
  ShowSize("size unz_global_info64", size(unz_global_info64), ROW_C_UNZ_GLOBAL_INFO64);
  ShowSize("size unz_file_info64", size(unz_file_info64), ROW_C_UNZ_FILE_INFO64);
  ShowSize("size unz64_file_pos", size(unz64_file_pos), ROW_C_UNZ64_FILE_POS);
  ShowSize("size zlib_filefunc64_def", size(zlib_filefunc64_def), ROW_C_ZLIB_FILEFUNC64_DEF);

  for GI := 0 to 8 do
    GCheck[GI] := uint8(CHECK_TEXT[GI]);
  end;
  Show("crc32", int64(crc32(0, addr of GCheck[0], 9)));
  Show("crc32 nil", int64(crc32(0, nil, 0)));
  Show("adler32", int64(adler32(1, addr of GCheck[0], 9)));
  GTable := get_crc_table();
  Show("table[1]", int64(GTable[1]));

  for GI := 0 to 139 do
    GBody[GI] := uint8(BODY_TEXT[GI]);
  end;
  ShowBool("bound", compressBound(140) >= 140);
  GPackedLen := 256;
  Show("compress2", int64(compress2(addr of GPacked[0], addr of GPackedLen, addr of GBody[0], 140,
    Z_BEST_COMPRESSION)));
  ShowBool("smaller", GPackedLen < 140);
  GBackLen := 256;
  Show("uncompress", int64(uncompress(addr of GBack[0], addr of GBackLen, addr of GPacked[0], GPackedLen)));
  Show("length", int64(GBackLen));
  GSame := true;
  for GI := 0 to 139 do
    if GBack[GI] <> GBody[GI] then
      GSame := false;
    end;
  end;
  ShowBool("same", GSame);
  // Failure path: 10 bytes of room for 140
  GBackLen := 10;
  Show("small dest", int64(uncompress(addr of GBack[0], addr of GBackLen, addr of GPacked[0], GPackedLen)));
end.
