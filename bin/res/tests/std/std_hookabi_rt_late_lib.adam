-------------------------------------------------------------------------------
  std_hookabi_rt_late_lib.adam - the shared object std_hookabi_rt_late loads
  after its hook is installed (PLAN-LINUX64 LX4f2): built only. Its
  initialize (the object's constructor, run inside dlopen) reads getenv, a
  call of it reads getenv, and it gives getenv's address as it binds it:
  each through its own import of getenv, which the program's interposer
  stub answers.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

@ifndef TARGET_X86_64_LINUX_GNU
@message error "std_hookabi_rt_late_lib is built for x86_64-linux-gnu only";
@endif

module dll std_hookabi_rt_late_lib;

// glibc: the environment read, two C texts compared
func getenv(const AName: ptr to const char): ptr to const char; external "c";
func strcmp(const ALeft: ptr to const char; const ARight: ptr to const char): int32;
  external "c";

var
  // What getenv answered the constructor
  GInitHooked: bool;

// True when getenv answers "hooked" for STD_HOOKABI_LATE
func Hooked(): bool;
var
  LValue: ptr to const char;
begin
  LValue := getenv("STD_HOOKABI_LATE");
  return (LValue <> nil) and (strcmp(LValue, "hooked") = 0);
end;

// True when the constructor's getenv was the hook's
public func LateInitHooked(): bool;
begin
  return GInitHooked;
end;

// True when a call's getenv is the hook's
public func LateCallHooked(): bool;
begin
  return Hooked();
end;

// getenv's address as this object binds it
public func LateAddress(): ptr;
begin
  return ptr(getenv);
end;

initialize
begin
  GInitHooked := Hooked();
end;

end.
