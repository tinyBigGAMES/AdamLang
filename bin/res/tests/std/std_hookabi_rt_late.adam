  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  std_hookabi_rt_late.adam - System.HookABI's run-time level reaching an
  object loaded after the install (PLAN-LINUX64 LX4f2, x86_64-linux-gnu: the
  exe's interposer stub of each hook name): a hook of getenv answers
  "hooked" for STD_HOOKABI_LATE; std_hookabi_rt_late_lib, dlopen'd with
  RTLD_LOCAL after the install, sees the hook in its constructor and in a
  call, and binds getenv's address to the program's own (the stub); after
  the uninstall its calls are real again.

  Each row prints ok or FAIL with its name; the last is `done <failures>`.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  deps std.std_hookabi_rt_late_lib
  exitcode 0
  | ok set real
  | ok install
  | ok load
  | ok late constructor hooked
  | ok late call hooked
  | ok late address is the program's
  | ok uninstall
  | ok late call real
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | ok close
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

@ifndef TARGET_X86_64_LINUX_GNU
@message error "std_hookabi_rt_late runs on x86_64-linux-gnu only";
@endif

module exe std_hookabi_rt_late;

import System.HookABI;

type
  // getenv's C signature, and the library's answers
  GetenvFn = func(const AName: ptr to const char): ptr to const char;
  AskFn = func(): bool;
  AddressFn = func(): ptr;

// glibc: the environment read and set, two C texts compared, a library opened, an export
// found, a library closed
func getenv(const AName: ptr to const char): ptr to const char; external "c";
func setenv(const AName: ptr to const char; const AValue: ptr to const char;
  const AReplace: int32): int32; external "c";
func strcmp(const ALeft: ptr to const char; const ARight: ptr to const char): int32;
  external "c";
func dlopen(const AFile: ptr to const char; const AMode: int32): ptr; external "c";
func dlsym(const AHandle: ptr; const AName: ptr to const char): ptr; external "c";
func dlclose(const AHandle: ptr): int32; external "c";

const
  // dlfcn.h: every symbol bound at the load, the library's symbols its own
  RTLD_NOW: int32 = 2;
  RTLD_LOCAL: int32 = 0;

var
  // The real getenv the replacement calls (the record's Original), the failures seen
  GOriginal: ptr;
  GReplacement: GetenvFn;
  GFails: int64;

// The replacement: "hooked" for STD_HOOKABI_LATE, else the real getenv
func HookGetenv(const AName: ptr to const char): ptr to const char;
var
  LReal: GetenvFn;
begin
  if (AName <> nil) and (strcmp(AName, "STD_HOOKABI_LATE") = 0) then
    return "hooked";
  end;
  LReal := GetenvFn(GOriginal);
  return LReal(AName);
end;

// AName printed as ok or FAIL (a failure counted)
func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The library's export AName asked (false when it has none)
func Ask(const AHandle: ptr; const AName: ptr to const char): bool;
var
  LProc: ptr;
  LAsk: AskFn;
begin
  LProc := dlsym(AHandle, AName);
  if LProc = nil then
    return false;
  end;
  LAsk := AskFn(LProc);
  return LAsk();
end;

// The library's getenv address (nil when it has no such export)
func LibraryAddress(const AHandle: ptr): ptr;
var
  LProc: ptr;
  LAddress: AddressFn;
begin
  LProc := dlsym(AHandle, "LateAddress");
  if LProc = nil then
    return nil;
  end;
  LAddress := AddressFn(LProc);
  return LAddress();
end;

var
  LHook: Hook;
  LLibrary: ptr;

begin
  GFails := 0;
  GReplacement := HookGetenv;
  Check("set real", setenv("STD_HOOKABI_LATE", "real", 1) = 0);
  Check("install", HookInstall(LHook, "getenv", ptr(GReplacement)));
  GOriginal := LHook.Original;
  LLibrary := dlopen("libstd_hookabi_rt_late_lib.so", RTLD_NOW | RTLD_LOCAL);
  Check("load", LLibrary <> nil);
  if LLibrary <> nil then
    Check("late constructor hooked", Ask(LLibrary, "LateInitHooked"));
    Check("late call hooked", Ask(LLibrary, "LateCallHooked"));
    Check("late address is the program's", LibraryAddress(LLibrary) = ptr(getenv));
  end;
  Check("uninstall", HookUninstall(LHook) and (LHook.State = nil));
  if LLibrary <> nil then
    Check("late call real", not Ask(LLibrary, "LateCallHooked"));
    Check("close", dlclose(LLibrary) = 0);
  end;
  println("done {}", GFails);
end.
