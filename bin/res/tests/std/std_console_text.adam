-------------------------------------------------------------------------------
  std_console_text.adam - System.Console's text by display columns
  (PLAN-CONSOLE C2): DisplayWidth (ASCII 1, CJK 2, an emoji 2, a combining
  mark 0, a byte that is not UTF-8 1), PadText left / center / right with a
  wide pad, RuleText, ProgressBarText (clamped, total 0, and a product past
  int64 kept exact), SpinnerFrame (negative frames too), and the writers
  HorizontalRule / WritePadded on a pipe (no sequences). Each row prints ok
  or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok width ascii
  | ok width wide
  | ok width combining
  | ok width bad byte
  | ok pad left
  | ok pad center right
  | ok pad too long
  | ok pad wide
  | ok rule
  | ok bar half
  | ok bar ends
  | ok bar clamped
  | ok bar exact
  | ok spinner
  | ==========
  | ********************************************************************************
  | ---x
  | ab..
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_console_text;

import System.SysUtils, System.Console;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

routine Run();
var
  LBad: string;
begin
  Check("width ascii", (DisplayWidth("abc") = 3) and (DisplayWidth("") = 0));
  Check("width wide", (DisplayWidth("日本") = 4) and (DisplayWidth("😀") = 2));
  Check("width combining", DisplayWidth("éx") = 2);
  LBad := "ab";
  LBad[0] := char(0xFF);
  Check("width bad byte", DisplayWidth(LBad) = 2);
  Check("pad left", (PadText("ab", 5) = "ab   ") and (PadText("ab", 5, ".") = "ab..."));
  Check("pad center right", (PadText("ab", 6, ".", TextAlign.Center) = "..ab..") and
    (PadText("ab", 5, ".", TextAlign.Center) = ".ab..") and
    (PadText("ab", 6, ".", TextAlign.Right) = "....ab"));
  Check("pad too long", (PadText("abcdef", 3) = "abcdef") and (PadText("ab", -1, "-") = "ab"));
  Check("pad wide", (PadText("ab", 5, "日") = "ab日 ") and (PadText("日", 4) = "日  ") and
    (PadText("a", 3, "") = "a  "));
  Check("rule", (RuleText("-", 5) = "-----") and (RuleText("", 3) = "   ") and
    (RuleText("=", 0) = ""));
  Check("bar half", ProgressBarText(5, 10, 10) = "[=====     ]  50%");
  Check("bar ends", (ProgressBarText(0, 10, 4) = "[    ]   0%") and
    (ProgressBarText(10, 10, 4) = "[====] 100%") and (ProgressBarText(3, 0, 4) = "[    ]   0%"));
  Check("bar clamped", (ProgressBarText(15, 10, 4) = "[====] 100%") and
    (ProgressBarText(-1, 10, 4) = "[    ]   0%") and (ProgressBarText(1, 2, -3) = "[]  50%"));
  // (2^62 - 1) / (2^63 - 1) is just under a half: 4 of 10 columns, 49%
  Check("bar exact", ProgressBarText(4611686018427387903, 9223372036854775807, 10) =
    "[====      ]  49%");
  Check("spinner", (SpinnerFrame(0) = "|") and (SpinnerFrame(1) = "/") and
    (SpinnerFrame(2) = "-") and (SpinnerFrame(3) = "\\") and (SpinnerFrame(5) = "/") and
    (SpinnerFrame(-1) = "\\"));
  HorizontalRule("=", 10);
  HorizontalRule("*", 0);
  WritePadded("x", 4, "-", TextAlign.Right);
  WriteText(CsiLf);
  WritePadded("ab", 4, ".");
  WriteText(CsiLf);
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
