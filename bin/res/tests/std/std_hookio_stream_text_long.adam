module exe std_hookio_stream_text_long;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@endif
  ;

routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_longcount(): int32; external "std_hookio_c";
routine clink std_hookio_c_longsample(AIndex: int32; ABuffer: ptr to uint8; ACap: clong): clong;
  external "std_hookio_c";
routine clink std_hookio_c_textlong(APath: ptr to const char; AMode: ptr to const char;
  AResults: ptr to int64); external "std_hookio_c";
routine clink std_hookio_c_seekfail(APath: ptr to const char; AMode: ptr to const char;
  AResults: ptr to int64); external "std_hookio_c";

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// A text read mode by index: "rt", "r", "rb"
routine TextReadMode(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "rt";
  end;
  if AIndex = 1 then
    return "r";
  end;
  return "rb";
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// The fixture's long read of APath in AMode: its 95 slots in AResults
routine TextLongC(const APath: string; const AMode: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_textlong(LPath, LMode, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// The fixture's refused-seek run on APath in AMode: its 6 slots in AResults
routine SeekFailC(const APath: string; const AMode: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_seekfail(LPath, LMode, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// Every long sample through "rt", "r" and "rb" on a registered memory IO and on a real file of
// the same bytes: every slot equals the real file's
routine TestStreamTextLong();
var
  LSample: array[0..8191] of uint8;
  LLength: clong;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..94] of int64;
  LReal: array[0..94] of int64;
  LFail: array[0..5] of int64;
  LRealFail: array[0..5] of int64;
  LIndex: int32;
  LMode: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".textlong.txt";
  for LIndex := 0 to std_hookio_c_longcount() - 1 do
    LLength := std_hookio_c_longsample(LIndex, addr of LSample[0], 8192);
    Check("long sample " + IntToStr(LIndex), LLength > 0);
    LMemory := CreateMemoryIO(addr of LSample[0], int64(LLength), true);
    LPrefix := RegisterIO(LMemory);
    Check("long real file " + IntToStr(LIndex), WriteRaw(LRealPath, addr of LSample[0],
      int64(LLength)));
    for LMode := 0 to 2 do
      LName := "long " + IntToStr(LIndex) + " " + TextReadMode(LMode);
      TextLongC(LPrefix + "/l.txt", TextReadMode(LMode), addr of LVirtual[0]);
      TextLongC(LRealPath, TextReadMode(LMode), addr of LReal[0]);
      Check(LName + " closed", LVirtual[94] = 0);
      Check(LName + " as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 95));
      if (LIndex = 0) and (LMode = 0) then
        // 600 bytes, 150 of them "\r\n": one fread gives 450 translated bytes on Windows,
        // all 600 where text mode is the bytes as they are
@ifdef TARGET_X86_64_WINDOWS_GNU
        Check(LName + " translated", (LVirtual[0] = 450) and (LVirtual[1] = 1));
@else
        Check(LName + " as it is", (LVirtual[0] = 600) and (LVirtual[1] = 1));
@endif
      end;
      SeekFailC(LPrefix + "/l.txt", TextReadMode(LMode), addr of LFail[0]);
      SeekFailC(LRealPath, TextReadMode(LMode), addr of LRealFail[0]);
      Check(LName + " seek fail closed", LFail[5] = 0);
      Check(LName + " seek fail as real file", SameSlots(addr of LFail[0],
        addr of LRealFail[0], 6));
    end;
    Check("long unregister " + IntToStr(LIndex), UnregisterIO(LPrefix));
    Check("long io close " + IntToStr(LIndex), IOClose(LMemory));
  end;
  Check("long real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestStreamTextLong();
  println("done {}", GFails);
end.
