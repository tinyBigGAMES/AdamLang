-------------------------------------------------------------------------------
  std_hookio_reopen.adam - System.HookIO's freopen and stream lock calls
  (PaskalCPP's std_hookio_reopen)

  freopen on a HookIO handle reopens it in place: the same FILE* comes back
  and reads the other registered IO; a reopen in "w" mode empties its IO
  and the bytes written land there. The failures leave the stream closed,
  as C's freopen does: a virtual path nothing answers fails with ENOENT and
  HookIO no longer knows the stream (FileIO nil). A real path keeps the
  address too: the handle then holds the disk file (a folder source's
  entry, closed with the stream: the heap line proves it) by fopen's rules:
  w creates it and leaves errno as the caller had it, a appends, x refuses
  a file that exists, r a missing one (ENOENT), as does a missing folder; a
  bare name is the current folder's. A real FILE reopened on a real path is
  the C runtime's. No path: ucrt refuses it (EBADF) before it touches the
  stream, which stays open. _lock_file / _unlock_file are nothing on a
  handle; _pclose refuses one (-1, EBADF) and it stays open.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok register
  | ok reopen same address
  | ok reopen reads second
  | ok reopen write mode third
  | ok reopen missing
  | ok reopen real path same address
  | ok reopen real path wrote
  | ok reopen real append
  | ok reopen real exclusive
  | ok reopen real removed
  | ok reopen real missing
  | ok reopen real no folder
  | ok reopen real bare name
  | ok bare removed
  | ok real file reopen
  | ok real removed
  | ok no path
  | ok lock nothing
  | ok pclose
  | ok unregister
  | ok io close
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_reopen;

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The hooked fopen of APath in AMode
routine Open(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LResult: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LResult := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LResult;
end;

// The hooked freopen of AFile onto APath in AMode; errno after it in AError (0 before)
routine Reopen(const APath: string; const AMode: string; const AFile: ptr;
  var AError: int32): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LResult: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  SetCErrno(0);
  LResult := freopen(LPath, LMode, AFile);
  AError := CErrno();
  freemem(LPath);
  freemem(LMode);
  return LResult;
end;

// AText written to AFile through the hooked fputs
routine Put(const AFile: ptr; const AText: string);
var
  LText: ptr to char;
begin
  LText := StringToC(AText);
  fputs(LText, AFile);
  freemem(LText);
end;

// Writes AText into what APath names, through the hooked fopen / fputs / fclose
routine Fill(const APath: string; const AText: string);
var
  LFile: ptr;
begin
  LFile := Open(APath, "w");
  Put(LFile, AText);
  fclose(LFile);
end;

// True when AFile's next bytes are AText, read one fgetc at a time
routine Reads(const AFile: ptr; const AText: string): bool;
var
  LI: int64;
begin
  for LI := 0 to len(AText) - 1 do
    if fgetc(AFile) <> int32(uint8(AText[LI])) then
      return false;
    end;
  end;
  return true;
end;

// True when APath, opened afresh, holds exactly AText
routine Holds(const APath: string; const AText: string): bool;
var
  LFile: ptr;
  LResult: bool;
begin
  LFile := Open(APath, "r");
  if LFile = nil then
    return false;
  end;
  LResult := Reads(LFile, AText) and (fgetc(LFile) = ADAM_HOOKIO_EOF);
  fclose(LFile);
  return LResult;
end;

// True when a file is at APath
routine IsFile(const APath: string): bool;
var
  LPath: ptr to char;
  LSize: int64;
  LKind: int32;
begin
  LPath := StringToC(APath);
  LKind := PathKind(LPath, LSize);
  freemem(LPath);
  return LKind = ADAM_PATH_FILE;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// The bare name AName made full from the working folder (the runtime's FullPath): where C's
// fopen of AName puts it, whatever folder the program's exe is in
routine WorkingPath(const AName: string): string;
var
  LName: ptr to char;
  LFull: ptr;
  LCount: int64;
  LPath: string;
begin
  LName := StringToC(AName);
  LFull := FullPath(LName, LCount);
  freemem(LName);
  LPath := StringFromC(ptr to const char(LFull), LCount);
  freemem(LFull);
  return LPath;
end;

// Reopens onto registered IOs: in place, a new mode, a path nothing answers
routine TestVirtual(const AFirst: string; const ASecond: string);
var
  LFile: ptr;
  LAgain: ptr;
  LError: int32;
begin
  // In place: the same address, now reading the other IO from its start
  LFile := Open(AFirst, "r");
  fgetc(LFile);
  LAgain := Reopen(ASecond, "r", LFile, LError);
  Check("reopen same address", (LAgain = LFile) and (LError = 0));
  Check("reopen reads second", Reads(LAgain, "second") and
    (fgetc(LAgain) = ADAM_HOOKIO_EOF));

  // A new mode: "w" empties the IO, the write lands there
  LAgain := Reopen(ASecond, "w", LAgain, LError);
  Put(LAgain, "third");
  fclose(LAgain);
  Check("reopen write mode third", Holds(ASecond, "third"));

  // Nothing answers the path: ENOENT, the stream closed and forgotten
  LFile := Open(AFirst, "r");
  LAgain := Reopen("io://999999/missing.txt", "r", LFile, LError);
  Check("reopen missing", (LAgain = nil) and (LError = ADAM_ERRNO_ENOENT) and
    (FileIO(LFile) = nil));
end;

// Reopens onto real paths: the disk file by fopen's rules, kept at the stream's address
routine TestReal(const AFirst: string; const AReal: string);
var
  LFile: ptr;
  LAgain: ptr;
  LError: int32;
  LBare: string;
begin
  // w creates it; errno is left as the caller had it
  LFile := Open(AFirst, "r");
  LAgain := Reopen(AReal, "w", LFile, LError);
  Check("reopen real path same address", (LAgain = LFile) and (LError = 0) and
    (FileIO(LAgain) <> nil));
  Put(LAgain, "disk");
  fclose(LAgain);
  Check("reopen real path wrote", Holds(AReal, "disk"));

  // a appends to what the file holds
  LFile := Open(AFirst, "r");
  LAgain := Reopen(AReal, "a", LFile, LError);
  Put(LAgain, "+more");
  fclose(LAgain);
  Check("reopen real append", Holds(AReal, "disk+more"));

  // x refuses a file that exists; r refuses one that does not
  LFile := Open(AFirst, "r");
  LAgain := Reopen(AReal, "wx", LFile, LError);
  Check("reopen real exclusive", (LAgain = nil) and (LError = ADAM_ERRNO_EEXIST) and
    (FileIO(LFile) = nil));
  Check("reopen real removed", RemovePath(AReal));
  LFile := Open(AFirst, "r");
  LAgain := Reopen(AReal, "r", LFile, LError);
  Check("reopen real missing", (LAgain = nil) and (LError = ADAM_ERRNO_ENOENT) and
    (not IsFile(AReal)));

  // A folder that does not exist: ENOENT
  LFile := Open(AFirst, "r");
  LAgain := Reopen(AReal + ".none/x.txt", "w", LFile, LError);
  Check("reopen real no folder", (LAgain = nil) and (LError = ADAM_ERRNO_ENOENT));

  // A bare name is the working folder's (a run row's is adamtest's output root, not its
  // exe's folder)
  LBare := "std_hookio_reopen_bare.txt";
  LFile := Open(AFirst, "r");
  LAgain := Reopen(LBare, "w", LFile, LError);
  Put(LAgain, "here");
  fclose(LAgain);
  Check("reopen real bare name", (LAgain = LFile) and
    Holds(WorkingPath(LBare), "here"));
  Check("bare removed", RemovePath(WorkingPath(LBare)));

  // A real FILE on a real path: the C runtime's freopen
  LFile := Open(AReal, "w");
  LAgain := Reopen(AReal, "r", LFile, LError);
  Check("real file reopen", (LAgain <> nil) and (FileIO(LAgain) = nil));
  fclose(LAgain);
  Check("real removed", RemovePath(AReal));
end;

// No path, the stream lock calls and _pclose: the stream stays open
routine TestKept(const AFirst: string);
var
  LFile: ptr;
  LAgain: ptr;
  LError: int32;
  LResult: int32;
begin
  // No path: ucrt's EBADF (common_freopen), before the stream is touched
  LFile := Open(AFirst, "r");
  SetCErrno(0);
  LAgain := freopen(nil, ptr to const char("r"), LFile);
  LError := CErrno();
  Check("no path", (LAgain = nil) and (LError = ADAM_ERRNO_EBADF) and Reads(LFile, "first"));
  fclose(LFile);

  // The stream lock calls: nothing on a handle, reading goes on
  LFile := Open(AFirst, "r");
  _lock_file(LFile);
  Check("lock nothing", Reads(LFile, "first"));
  _unlock_file(LFile);
  fclose(LFile);

  // A handle is never a pipe: _pclose refuses it as ucrt refuses any stream _popen did not
  // open, and it stays open
  LFile := Open(AFirst, "r");
  SetCErrno(0);
  LResult := _pclose(LFile);
  LError := CErrno();
  Check("pclose", (LResult = -1) and (LError = ADAM_ERRNO_EBADF) and Reads(LFile, "first"));
  fclose(LFile);
end;

routine TestReopen();
var
  LFirst: IO;
  LSecond: IO;
  LFirstPrefix: string;
  LSecondPrefix: string;
  LFirstPath: string;
  LSecondPath: string;
begin
  LFirst := CreateMemoryIO();
  LSecond := CreateMemoryIO();
  LFirstPrefix := RegisterIO(LFirst);
  LSecondPrefix := RegisterIO(LSecond);
  Check("register", (LFirstPrefix <> "") and (LSecondPrefix <> ""));
  LFirstPath := LFirstPrefix + "/first.txt";
  LSecondPath := LSecondPrefix + "/second.txt";
  Fill(LFirstPath, "first");
  Fill(LSecondPath, "second");

  TestVirtual(LFirstPath, LSecondPath);
  TestReal(LFirstPath, paramstr(0) + ".reopen.txt");
  TestKept(LFirstPath);

  Check("unregister", UnregisterIO(LFirstPrefix) and UnregisterIO(LSecondPrefix));
  Check("io close", IOClose(LFirst) and IOClose(LSecond));
end;

begin
  GFails := 0;
  TestReopen();
  println("done {}", GFails);
end.
