-------------------------------------------------------------------------------
  std_raylib_frame.adam - System.Raylib.Ext's frame window, hidden (PLAN-LINUX64
  LX3d3c3b1, PaskalCPP's std_raylib_ext_frame; on the Window object since
  PLAN-RAVENAPI R10); the window-less rules are std_raylib_frame_rules'
  (both targets). The screen is read back by Window.Snapshot inside the
  frame, after its drawing.

  A Window opens at Window.ScaledFrameSize of its own scale (any monitor),
  a second Window(...) shares it (one window per program), a frame drawn
  sets the camera's zoom to window units per base unit and keeps the mouse
  in the frame. RestoreClip: the window widened to twice the frame's aspect (bars
  left and right), the clip turned off inside a frame and a red fill drawn
  far past it, the screen read back: with RestoreClip the left bar
  keeps the bar colour, the centre is red; the control row (no
  RestoreClip) shows the same fill reaching the bar.
  Camera3D.Begin: the window made square (the 16:9 letterbox has bars
  above and below), a 9 x 9 cube seen orthographically 18 units high lands
  on its base rect (base 115..205 x 45..135, the frame colour around it),
  the top bar keeps the bar colour; the control row (raylib's BeginMode3D)
  draws it larger (the window's aspect and height); after Camera3D.End a
  base-unit square lands at the frame's origin and a fill far past the
  frame stops at the letterbox; a perspective cube is centred.
  IntegerScale: off by default and Letterbox is the fit rule; on, in a
  window between multiples, Letterbox is the
  integer rule, the camera's zoom a whole number, the mouse in the frame,
  and the screen read back shows the bar left of the letterbox and the
  frame inside it; off again, the fit rule. ToggleBorderless: undecorated
  at its own monitor's place and size, then back at its place and size. Closed: after CloseWindow
  (DestroyWindow's hook) Width / Height, the camera's zoom and Letterbox
  are 0, the frame calls do nothing, a colour and the
  integer scale set before the close are kept, a new frame window opens
  with SetZoom(2) at twice the base size x the DPI scale, a zoom set
  on the open window resizes it at once, the zoom is kept over the close,
  and a plain raylib window opened right after a frame's close (no frame
  call between) is not taken for the frame, nor held by a Window value (one
  made and dropped leaves it open); in it Camera3D.Begin is raylib's
  BeginMode3D.

  Each row prints ok or FAIL with its name; the last is `done <failures>`.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok frame window opens
  | ok frame base size
  | ok frame dpi scale
  | ok window at scaled size
  | ok second window shares the first
  | ok frame camera zoom
  | ok frame mouse in frame
  | ok window widened
  | ok unclipped fill reaches the bar
  | ok restored clip keeps the bar
  | ok window made square
  | ok 3d ortho cube at its base rect
  | ok 3d outside the cube is the frame
  | ok 3d top bar kept
  | ok after 3d the frame camera
  | ok plain mode3d takes the window aspect
  | ok after 3d the clip
  | ok 3d perspective centred
  | ok integer scale off by default
  | ok fit frame letterbox
  | ok window between multiples
  | ok integer frame letterbox
  | ok integer zoom whole
  | ok integer mouse in frame
  | ok integer bar and frame on screen
  | ok integer off is fit again
  | ok borderless on
  | ok borderless on its monitor
  | ok borderless off back at its size
  | ok borderless off back at its place
  | ok closed no frame
  | ok closed frame calls do nothing
  | ok closed colours kept
  | ok closed integer scale kept
  | ok reopened
  | ok zoomed window size
  | ok zoom applied to the open window
  | ok closed zoom kept
  | ok plain window after close no frame
  | ok plain window value not ready
  | ok plain window not a Window's
  | ok plain window 3d is raylib's
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raylib_frame;

import System.Raylib.C, System.Raylib.Ext;

var
  GFails: int32;
  // The frame window (Ready false while none is open)
  GWin: Window;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// Float results compared to a thousandth (they are whole or half units)
func Near(const AGot: float32; const AWant: float32): bool;
begin
  return (AGot - AWant < 0.001f) and (AWant - AGot < 0.001f);
end;

func SameRect(const AA: Rectangle; const AB: Rectangle): bool;
begin
  return Near(AA.x, AB.x) and Near(AA.y, AB.y) and Near(AA.width, AB.width) and
    Near(AA.height, AB.height);
end;

func EmptyRect(const ARect: Rectangle): bool;
begin
  return Near(ARect.x, 0.0f) and Near(ARect.y, 0.0f) and Near(ARect.width, 0.0f) and
    Near(ARect.height, 0.0f);
end;

func SameColor(const AA: Color; const AB: Color): bool;
begin
  return (AA.r = AB.r) and (AA.g = AB.g) and (AA.b = AB.b);
end;

// One drawn frame with nothing in it (the window system's events polled)
func PollFrame();
begin
  BeginDrawing();
  EndDrawing();
end;

// Polls the window until its size is ASize (the window system's resize is seen once events
// are polled), at most 120 frames
func WaitWindowSize(const ASize: Vector2): bool;
var
  LTry: int32;
begin
  LTry := 0;
  while ((float32(GetScreenWidth()) <> ASize.x) or (float32(GetScreenHeight()) <> ASize.y)) and
    (LTry < 120) do
    PollFrame();
    LTry := LTry + 1;
  end;
  return (float32(GetScreenWidth()) = ASize.x) and (float32(GetScreenHeight()) = ASize.y);
end;

// Polls until the window and its framebuffer are AWidth x AHeight (no HIGHDPI: the two are
// equal), at most 120 frames
func WaitWindowAndRender(const AWidth: int32; const AHeight: int32): bool;
var
  LTry: int32;
begin
  LTry := 0;
  while ((GetScreenWidth() <> AWidth) or (GetScreenHeight() <> AHeight) or
    (GetRenderWidth() <> AWidth) or (GetRenderHeight() <> AHeight)) and (LTry < 120) do
    PollFrame();
    LTry := LTry + 1;
  end;
  return (GetScreenWidth() = AWidth) and (GetScreenHeight() = AHeight) and
    (GetRenderWidth() = AWidth) and (GetRenderHeight() = AHeight);
end;

// One frame with the clip turned off inside it (EndScissorMode), then back on when ARestore
// (RestoreClip), then a red fill far past the frame: the screen read back inside the frame, the pixels at (AX, AY) and at the window's centre given back
func ShotFill(const ARestore: bool; const AX: int32; const AY: int32; var AAt: Color;
  var ACentre: Color);
var
  LShot: ImageRes;
begin
  GWin.BeginFrame();
  EndScissorMode();
  if ARestore then
    GWin.RestoreClip();
  end;
  Draw.Rect(Rectangle(x: -1000.0f, y: -1000.0f, width: 5000.0f, height: 5000.0f), RED);
  LShot := GWin.Snapshot();
  AAt := GetImageColor(LShot.Handle(), AX, AY);
  ACentre := GetImageColor(LShot.Handle(), LShot.Width() div 2, LShot.Height() div 2);
  GWin.EndFrame();
end;

// RestoreClip: in a window twice the frame's aspect (bars left and right), a fill after
// it stays in the frame; without it (the control row) the same fill reaches the bar
func TestRestoreClip();
var
  LWant: int32;
  LTry: int32;
  LBar: Color;
  LCentre: Color;
  LBarX: int32;
begin
  LWant := GetScreenWidth() * 2;
  SetWindowSize(LWant, GetScreenHeight());
  LTry := 0;
  while (GetScreenWidth() <> LWant) and (LTry < 120) do
    PollFrame();
    LTry := LTry + 1;
  end;
  Check("window widened", GetScreenWidth() = LWant);
  // Inside the left bar: a quarter of its width in
  LBarX := int32(Window.LetterboxRect(GetScreenWidth(), GetScreenHeight(), 320, 180).x) div 4;
  ShotFill(false, LBarX, GetScreenHeight() div 2, LBar, LCentre);
  Check("unclipped fill reaches the bar", SameColor(LBar, RED) and SameColor(LCentre, RED));
  ShotFill(true, LBarX, GetScreenHeight() div 2, LBar, LCentre);
  Check("restored clip keeps the bar", SameColor(LBar, GWin.BarColor) and
    SameColor(LCentre, RED));
end;

func At(const AX: float32; const AY: float32; const AZ: float32): Vector3;
begin
  return Vector3(x: AX, y: AY, z: AZ);
end;

// Looking at the origin along -z: orthographic 18 units high (10 base units each in the
// frame's 180), or perspective with a 45 degree fovy
func CubeCamera(const AOrtho: bool): Camera3D;
var
  LCamera: Camera3D;
begin
  LCamera.position := At(0.0f, 0.0f, 10.0f);
  LCamera.target := At(0.0f, 0.0f, 0.0f);
  LCamera.up := At(0.0f, 1.0f, 0.0f);
  if AOrtho then
    LCamera.fovy := 18.0f;
    LCamera.projection := CAMERA_ORTHOGRAPHIC;
  else
    LCamera.fovy := 45.0f;
    LCamera.projection := CAMERA_PERSPECTIVE;
  end;
  return LCamera;
end;

// One frame: a red 9 x 9 cube at the origin through Camera3D.Begin (AFrameMode) or
// raylib's own BeginMode3D (the control), then a blue 8 x 8 square at the frame's origin or,
// with AFlood, a green fill far past the frame; the screen read back inside the frame
func CubeShot(const AFrameMode: bool; const AOrtho: bool; const AFlood: bool): ImageRes;
var
  LCamera: Camera3D;
  LShot: ImageRes;
begin
  // A plain raylib window (no frame) draws between raylib's own BeginDrawing / EndDrawing
  if GWin.Ready() then
    GWin.BeginFrame();
  else
    BeginDrawing();
  end;
  LCamera := CubeCamera(AOrtho);
  if AFrameMode then
    LCamera.Begin();
  else
    BeginMode3D(LCamera);
  end;
  DrawCube(At(0.0f, 0.0f, 0.0f), 9.0f, 9.0f, 1.0f, RED);
  if AFrameMode then
    Camera3D.End();
  else
    EndMode3D();
  end;
  if AFlood then
    DrawRectangle(-1000, -1000, 5000, 5000, GREEN);
  else
    DrawRectangle(0, 0, 8, 8, BLUE);
  end;
  if GWin.Ready() then
    LShot := GWin.Snapshot();
    GWin.EndFrame();
  else
    // raylib's batch drawn, then the screen read (Window.Snapshot's way)
    rlDrawRenderBatchActive();
    LShot := ImageRes.Adopt(LoadImageFromScreen());
    EndDrawing();
  end;
  return LShot;
end;

// The pixel of AShot at the frame's base point (ABX, ABY), through the camera the last
// BeginFrame set
func FramePixel(const AShot: ImageRes; const ABX: float32; const ABY: float32): Color;
var
  LCamera: Camera2D;
begin
  LCamera := GWin.Camera();
  return GetImageColor(AShot.Handle(), int32(LCamera.offset.x + ABX * LCamera.zoom),
    int32(LCamera.offset.y + ABY * LCamera.zoom));
end;

// The pixel of AShot halfway down the top bar, at the window's centre
func TopBarPixel(const AShot: ImageRes): Color;
begin
  return GetImageColor(AShot.Handle(), AShot.Width() div 2, int32(GWin.Camera().offset.y) div 2);
end;

// Camera3D.Begin in a square window (bars above and below the 16:9 letterbox): the scene
// takes the letterbox's pixels and the base size's aspect; raylib's BeginMode3D (the control)
// takes the whole window's
func TestFrame3D();
var
  LSide: int32;
  LShot: ImageRes;
begin
  LSide := GetScreenHeight();
  SetWindowSize(LSide, LSide);
  Check("window made square", WaitWindowAndRender(LSide, LSide));

  // 18 units over the base height of 180: the cube is base 115..205 x 45..135
  LShot := CubeShot(true, true, false);
  Check("3d ortho cube at its base rect", SameColor(FramePixel(LShot, 160.0f, 90.0f), RED) and
    SameColor(FramePixel(LShot, 120.0f, 50.0f), RED) and
    SameColor(FramePixel(LShot, 200.0f, 130.0f), RED));
  Check("3d outside the cube is the frame",
    SameColor(FramePixel(LShot, 100.0f, 90.0f), GWin.Color) and
    SameColor(FramePixel(LShot, 160.0f, 30.0f), GWin.Color));
  Check("3d top bar kept", SameColor(TopBarPixel(LShot), GWin.BarColor));
  Check("after 3d the frame camera", SameColor(FramePixel(LShot, 4.0f, 4.0f), BLUE));

  // raylib's BeginMode3D: 18 units over the whole window's height, so the cube is base
  // 80..240 x 10..170, past the points the frame left clear
  LShot := CubeShot(false, true, false);
  Check("plain mode3d takes the window aspect", SameColor(FramePixel(LShot, 100.0f, 90.0f), RED) and
    SameColor(FramePixel(LShot, 160.0f, 30.0f), RED));

  LShot := CubeShot(true, true, true);
  Check("after 3d the clip", SameColor(TopBarPixel(LShot), GWin.BarColor) and
    SameColor(FramePixel(LShot, 4.0f, 4.0f), GREEN));

  LShot := CubeShot(true, false, false);
  Check("3d perspective centred", SameColor(FramePixel(LShot, 160.0f, 90.0f), RED) and
    SameColor(TopBarPixel(LShot), GWin.BarColor));
end;

// In a plain window (no frame) Camera3D.Begin is raylib's BeginMode3D: the same pixels at a
// few points of the cube's edge and around it
func SamePlain3D(): bool;
var
  LFrame: ImageRes;
  LPlain: ImageRes;
  LSame: bool;
begin
  LFrame := CubeShot(true, true, false);
  LPlain := CubeShot(false, true, false);
  LSame := SameColor(GetImageColor(LFrame.Handle(), 80, 45), GetImageColor(LPlain.Handle(), 80, 45)) and
    SameColor(GetImageColor(LFrame.Handle(), 20, 45), GetImageColor(LPlain.Handle(), 20, 45)) and
    SameColor(GetImageColor(LFrame.Handle(), 80, 10), GetImageColor(LPlain.Handle(), 80, 10)) and
    SameColor(GetImageColor(LFrame.Handle(), 80, 45), RED);
  return LSame;
end;

// One empty frame (the frame colour inside the letterbox, the bars around it), the screen
// read back inside the frame
func EmptyShot(): ImageRes;
var
  LShot: ImageRes;
begin
  GWin.BeginFrame();
  LShot := GWin.Snapshot();
  GWin.EndFrame();
  return LShot;
end;

// IntegerScale in a 1000 x 600 window, between the 3x (960 x 540) and 4x multiples of
// 320 x 180 and taller than 16:9: the fit rule has bars above and below, the integer rule
// bars on every side
func TestIntegerScale();
var
  LBox: Rectangle;
  LShot: ImageRes;
  LMiddle: int32;
  LLeft: int32;
  LRight: int32;
  LMouse: Vector2;
begin
  Check("integer scale off by default", not GWin.IntegerScale);
  SetWindowSize(1000, 600);
  LBox := Window.LetterboxRect(1000, 600, 320, 180);
  Check("fit frame letterbox", WaitWindowAndRender(1000, 600) and
    SameRect(GWin.Letterbox(), Window.LetterboxRect(GetScreenWidth(), GetScreenHeight(), 320, 180)));
  Check("window between multiples", (GetScreenWidth() = 1000) and (GetScreenHeight() = 600) and
    (GetRenderWidth() = 1000) and (GetRenderHeight() = 600));

  GWin.IntegerScale := true;
  LShot := EmptyShot();
  LBox := GWin.Letterbox();
  Check("integer frame letterbox",
    SameRect(LBox, Window.IntegerLetterboxRect(GetScreenWidth(), GetScreenHeight(), 320, 180)) and
    SameRect(LBox, Window.IntegerLetterboxRect(1000, 600, 320, 180)));
  Check("integer zoom whole", Near(GWin.Camera().zoom, 3.0f));
  LMouse := Mouse.FramePosition();
  Check("integer mouse in frame", (LMouse.x >= 0.0f) and (LMouse.x <= 319.0f) and
    (LMouse.y >= 0.0f) and (LMouse.y <= 179.0f));
  // Whole pixels: the first and last frame columns are the frame colour, the columns just
  // outside them the bar colour
  LMiddle := LShot.Height() div 2;
  LLeft := int32(LBox.x);
  LRight := int32(LBox.x + LBox.width) - 1;
  Check("integer bar and frame on screen",
    SameColor(GetImageColor(LShot.Handle(), LLeft - 1, LMiddle), GWin.BarColor) and
    SameColor(GetImageColor(LShot.Handle(), LLeft, LMiddle), GWin.Color) and
    SameColor(GetImageColor(LShot.Handle(), LRight, LMiddle), GWin.Color) and
    SameColor(GetImageColor(LShot.Handle(), LRight + 1, LMiddle), GWin.BarColor));

  GWin.IntegerScale := false;
  LShot := EmptyShot();
  LBox := Window.LetterboxRect(GetScreenWidth(), GetScreenHeight(), 320, 180);
  Check("integer off is fit again", (not GWin.IntegerScale) and
    SameRect(GWin.Letterbox(), LBox) and Near(GWin.Camera().zoom, LBox.width / 320.0f));
end;

// Borderless: undecorated over the monitor the window is on (its own place and size, never the
// whole desktop), the frame letterboxed in it; off again, back at its place and size
func TestBorderless();
var
  LMonitor: int32;
  LPlace: Vector2;
  LBefore: Vector2;
  LSize: Vector2;
  LWhere: Vector2;
begin
  LMonitor := GetCurrentMonitor();
  LBefore := Vector2(x: float32(GetScreenWidth()), y: float32(GetScreenHeight()));
  LWhere := GWin.Position();
  LSize := Vector2(x: float32(GetMonitorWidth(LMonitor)), y: float32(GetMonitorHeight(LMonitor)));
  GWin.ToggleBorderless();
  Check("borderless on", GWin.Borderless() and WaitWindowSize(LSize));
  LPlace := GetMonitorPosition(LMonitor);
  Check("borderless on its monitor", (GWin.Position().x = LPlace.x) and
    (GWin.Position().y = LPlace.y));
  GWin.ToggleBorderless();
  Check("borderless off back at its size", (not GWin.Borderless()) and WaitWindowSize(LBefore));
  Check("borderless off back at its place", (GWin.Position().x = LWhere.x) and
    (GWin.Position().y = LWhere.y));
end;

func TestWindow();
var
  LSize: Vector2;
  LMouse: Vector2;
  LCamera: Camera2D;
  LSecond: Window;
begin
  GWin := Window.Config().Size(320, 180).Title("std_raylib_frame").Flags([WindowFlag.Hidden]).Open();
  Check("frame window opens", GWin.Ready());
  if not GWin.Ready() then
    return;
  end;
  Check("frame base size", (GWin.Width() = 320) and (GWin.Height() = 180));
  Check("frame dpi scale", Near(GWin.Scale(), float32(GWin.Dpi()) / 96.0f));

  // One frame first: the window system's resize is seen once events are polled (EndFrame)
  GWin.BeginFrame();
  DrawRectangle(10, 10, 20, 20, RED);
  GWin.EndFrame();
  LSize := Window.ScaledFrameSize(320, 180, GWin.Dpi());
  Check("window at scaled size", WaitWindowSize(LSize));
  // raylib's one window per program: a second Window(...) shares the open one, its base size kept
  LSecond := Window(640, 360, "std_raylib_frame");
  Check("second window shares the first", LSecond.Ready() and (LSecond.Handle() = GWin.Handle()) and
    (LSecond.Width() = 320) and (LSecond.Height() = 180));

  // A frame at the window's settled size: its camera and mouse
  GWin.BeginFrame();
  GWin.EndFrame();
  LCamera := GWin.Camera();
  Check("frame camera zoom", Near(LCamera.zoom,
    Window.LetterboxRect(GetScreenWidth(), GetScreenHeight(), 320, 180).width / 320.0f));
  LMouse := Mouse.FramePosition();
  Check("frame mouse in frame", (LMouse.x >= 0.0f) and (LMouse.x <= 319.0f) and
    (LMouse.y >= 0.0f) and (LMouse.y <= 179.0f));
  TestRestoreClip();
  TestFrame3D();
  TestIntegerScale();
  TestBorderless();
  // Settings of the program's, kept over the close (TestClosed)
  GWin.BarColor := DARKBLUE;
  GWin.IntegerScale := true;
  // The program closes raylib's window itself: the frame learns it is gone
  CloseWindow();
end;

// A Window value made and dropped while a plain raylib window is open
func DropWindowValue();
var
  LView: Window;
begin
  Check("plain window value not ready", not LView.Ready());
end;

// After CloseWindow the frame is closed too: no base size, the frame calls do nothing, the
// colours kept; a new frame window opens again
func TestClosed();
begin
  Check("closed no frame", (not GWin.Ready()) and (GWin.Width() = 0) and (GWin.Height() = 0) and
    Near(GWin.Camera().zoom, 0.0f) and EmptyRect(GWin.Letterbox()));
  GWin.BeginFrame();
  GWin.EndFrame();
  GWin.RestoreClip();
  GWin.ToggleBorderless();
  GWin.ToggleFullscreen();
  Check("closed frame calls do nothing", not IsWindowReady());
  Check("closed colours kept", SameColor(GWin.BarColor, DARKBLUE));
  Check("closed integer scale kept", GWin.IntegerScale);
  GWin.IntegerScale := false;
  // Zoomed: the window at base x 2 x the DPI scale, the base size as it is
  GWin.SetZoom(2.0f);
  // The short form opens with the frame's settings as they are (a WindowConfig sets its own)
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  GWin := Window(200, 100, "std_raylib_frame");
  Check("reopened", GWin.Ready() and (GWin.Width() = 200) and (GWin.Height() = 100));
  if GWin.Ready() then
    Check("zoomed window size", WaitWindowSize(Window.ScaledFrameSize(400, 200, GWin.Dpi())) and
      (GWin.Width() = 200) and (GWin.Height() = 100));
    // A zoom set with the frame open resizes the window at once
    GWin.SetZoom(3.0f);
    Check("zoom applied to the open window",
      WaitWindowSize(Window.ScaledFrameSize(600, 300, GWin.Dpi())));
    CloseWindow();
  end;
  Check("closed zoom kept", Near(GWin.Zoom(), 3.0f));
  GWin.SetZoom(1.0f);
  // A plain raylib window right after the frame's close, no frame call between: never taken
  // for the frame
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  InitWindow(160, 90, "std_raylib_frame");
  Check("plain window after close no frame", IsWindowReady() and (not GWin.Ready()) and
    (GWin.Width() = 0));
  // A Window value made and dropped holds no plain window: the program's own stays open
  DropWindowValue();
  Check("plain window not a Window's", IsWindowReady());
  if IsWindowReady() then
    Check("plain window 3d is raylib's", SamePlain3D());
    CloseWindow();
  end;
end;

begin
  GFails := 0;
  Log.Level(LogLevel.None);
  TestWindow();
  TestClosed();
  println("done {}", GFails);
end.
