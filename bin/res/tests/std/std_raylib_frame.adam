  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  std_raylib_frame.adam - System.Raylib's frame window, hidden (PLAN-LINUX64
  LX3d3c3b1, PaskalCPP's std_raylib_ext_frame); the window-less rules are
  std_raylib_frame_rules' (both targets).

  InitFrameWindow opens at GetScaledFrameSize of its own GetFrameDpi (any
  monitor), a second one is refused, a frame drawn sets the camera's zoom
  to window units per base unit and keeps the mouse in the frame.
  RestoreFrameClip: the window widened to twice the frame's aspect (bars
  left and right), the clip turned off inside a frame and a red fill drawn
  far past it, the screen read back: with RestoreFrameClip the left bar
  keeps the bar colour, the centre is red; the control row (no
  RestoreFrameClip) shows the same fill reaching the bar.
  BeginFrameMode3D: the window made square (the 16:9 letterbox has bars
  above and below), a 9 x 9 cube seen orthographically 18 units high lands
  on its base rect (base 115..205 x 45..135, the frame colour around it),
  the top bar keeps the bar colour; the control row (raylib's BeginMode3D)
  draws it larger (the window's aspect and height); after EndFrameMode3D a
  base-unit square lands at the frame's origin and a fill far past the
  frame stops at the letterbox; a perspective cube is centred.
  SetFrameIntegerScale: off by default and GetFrameLetterbox is the fit
  rule; on, in a window between multiples, GetFrameLetterbox is the
  integer rule, the camera's zoom a whole number, the mouse in the frame,
  and the screen read back shows the bar left of the letterbox and the
  frame inside it; off again, the fit rule. Closed: after CloseWindow
  (DestroyWindow's hook) GetFrameWidth / Height, the camera's zoom and
  GetFrameLetterbox are 0, the frame calls do nothing, a colour and the
  integer scale set before the close are kept, a new frame window opens
  with SetFrameZoom(2) at twice the base size x the DPI scale, a zoom set
  on the open window resizes it at once, the zoom is kept over the close,
  and a plain raylib window opened right after a frame's close (no frame
  call between) is not taken for the frame; in it BeginFrameMode3D is
  raylib's BeginMode3D.

  Each row prints ok or FAIL with its name; the last is `done <failures>`.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu
  exitcode 0
  | ok frame window opens
  | ok frame base size
  | ok frame dpi scale
  | ok window at scaled size
  | ok second window refused
  | ok frame camera zoom
  | ok frame mouse in frame
  | ok window widened
  | ok unclipped fill reaches the bar
  | ok restored clip keeps the bar
  | ok window made square
  | ok 3d ortho cube at its base rect
  | ok 3d outside the cube is the frame
  | ok 3d top bar kept
  | ok after 3d the frame camera
  | ok plain mode3d takes the window aspect
  | ok after 3d the clip
  | ok 3d perspective centred
  | ok integer scale off by default
  | ok fit frame letterbox
  | ok window between multiples
  | ok integer frame letterbox
  | ok integer zoom whole
  | ok integer mouse in frame
  | ok integer bar and frame on screen
  | ok integer off is fit again
  | ok closed no frame
  | ok closed frame calls do nothing
  | ok closed colours kept
  | ok closed integer scale kept
  | ok reopened
  | ok zoomed window size
  | ok zoom applied to the open window
  | ok closed zoom kept
  | ok plain window after close no frame
  | ok plain window 3d is raylib's
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raylib_frame;

@ifndef TARGET_X86_64_WINDOWS_GNU
@message error "std_raylib_frame runs on x86_64-windows-gnu only: build it with -t x86_64-windows-gnu";
@endif

import System.Raylib.C, System.Raylib;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// Float results compared to a thousandth (they are whole or half units)
routine Near(const AGot: float32; const AWant: float32): bool;
begin
  return (AGot - AWant < 0.001f) and (AWant - AGot < 0.001f);
end;

routine SameRect(const AA: Rectangle; const AB: Rectangle): bool;
begin
  return Near(AA.x, AB.x) and Near(AA.y, AB.y) and Near(AA.width, AB.width) and
    Near(AA.height, AB.height);
end;

routine EmptyRect(const ARect: Rectangle): bool;
begin
  return Near(ARect.x, 0.0f) and Near(ARect.y, 0.0f) and Near(ARect.width, 0.0f) and
    Near(ARect.height, 0.0f);
end;

routine SameColor(const AA: Color; const AB: Color): bool;
begin
  return (AA.r = AB.r) and (AA.g = AB.g) and (AA.b = AB.b);
end;

// One drawn frame with nothing in it (the window system's events polled)
routine PollFrame();
begin
  BeginDrawing();
  EndDrawing();
end;

// Polls the window until its size is ASize (the window system's resize is seen once events
// are polled), at most 120 frames
routine WaitWindowSize(const ASize: Vector2): bool;
var
  LTry: int32;
begin
  LTry := 0;
  while ((float32(GetScreenWidth()) <> ASize.x) or (float32(GetScreenHeight()) <> ASize.y)) and
    (LTry < 120) do
    PollFrame();
    LTry := LTry + 1;
  end;
  return (float32(GetScreenWidth()) = ASize.x) and (float32(GetScreenHeight()) = ASize.y);
end;

// Polls until the window and its framebuffer are AWidth x AHeight (no HIGHDPI: the two are
// equal), at most 120 frames
routine WaitWindowAndRender(const AWidth: int32; const AHeight: int32): bool;
var
  LTry: int32;
begin
  LTry := 0;
  while ((GetScreenWidth() <> AWidth) or (GetScreenHeight() <> AHeight) or
    (GetRenderWidth() <> AWidth) or (GetRenderHeight() <> AHeight)) and (LTry < 120) do
    PollFrame();
    LTry := LTry + 1;
  end;
  return (GetScreenWidth() = AWidth) and (GetScreenHeight() = AHeight) and
    (GetRenderWidth() = AWidth) and (GetRenderHeight() = AHeight);
end;

// One frame with the clip turned off inside it (EndScissorMode), then back on when ARestore
// (RestoreFrameClip), then a red fill far past the frame: the screen read back before
// EndDrawing, the pixels at (AX, AY) and at the window's centre given back
routine ShotFill(const ARestore: bool; const AX: int32; const AY: int32; var AAt: Color;
  var ACentre: Color);
var
  LShot: Image;
begin
  BeginDrawing();
  BeginFrame();
  EndScissorMode();
  if ARestore then
    RestoreFrameClip();
  end;
  DrawRectangle(-1000, -1000, 5000, 5000, RED);
  EndFrame();
  LShot := LoadImageFromScreen();
  AAt := GetImageColor(LShot, AX, AY);
  ACentre := GetImageColor(LShot, LShot.width div 2, LShot.height div 2);
  UnloadImage(LShot);
  EndDrawing();
end;

// RestoreFrameClip: in a window twice the frame's aspect (bars left and right), a fill after
// it stays in the frame; without it (the control row) the same fill reaches the bar
routine TestRestoreClip();
var
  LWant: int32;
  LTry: int32;
  LBar: Color;
  LCentre: Color;
  LBarX: int32;
begin
  LWant := GetScreenWidth() * 2;
  SetWindowSize(LWant, GetScreenHeight());
  LTry := 0;
  while (GetScreenWidth() <> LWant) and (LTry < 120) do
    PollFrame();
    LTry := LTry + 1;
  end;
  Check("window widened", GetScreenWidth() = LWant);
  // Inside the left bar: a quarter of its width in
  LBarX := int32(GetLetterboxRect(GetScreenWidth(), GetScreenHeight(), 320, 180).x) div 4;
  ShotFill(false, LBarX, GetScreenHeight() div 2, LBar, LCentre);
  Check("unclipped fill reaches the bar", SameColor(LBar, RED) and SameColor(LCentre, RED));
  ShotFill(true, LBarX, GetScreenHeight() div 2, LBar, LCentre);
  Check("restored clip keeps the bar", SameColor(LBar, GetFrameBarColor()) and
    SameColor(LCentre, RED));
end;

routine At(const AX: float32; const AY: float32; const AZ: float32): Vector3;
begin
  return Vector3(x: AX, y: AY, z: AZ);
end;

// Looking at the origin along -z: orthographic 18 units high (10 base units each in the
// frame's 180), or perspective with a 45 degree fovy
routine CubeCamera(const AOrtho: bool): Camera3D;
var
  LCamera: Camera3D;
begin
  LCamera.position := At(0.0f, 0.0f, 10.0f);
  LCamera.target := At(0.0f, 0.0f, 0.0f);
  LCamera.up := At(0.0f, 1.0f, 0.0f);
  if AOrtho then
    LCamera.fovy := 18.0f;
    LCamera.projection := CAMERA_ORTHOGRAPHIC;
  else
    LCamera.fovy := 45.0f;
    LCamera.projection := CAMERA_PERSPECTIVE;
  end;
  return LCamera;
end;

// One frame: a red 9 x 9 cube at the origin through BeginFrameMode3D (AFrameMode) or
// raylib's own BeginMode3D (the control), then a blue 8 x 8 square at the frame's origin or,
// with AFlood, a green fill far past the frame; the screen read back before EndDrawing (the
// caller unloads it)
routine CubeShot(const AFrameMode: bool; const AOrtho: bool; const AFlood: bool): Image;
var
  LShot: Image;
begin
  BeginDrawing();
  BeginFrame();
  if AFrameMode then
    BeginFrameMode3D(CubeCamera(AOrtho));
  else
    BeginMode3D(CubeCamera(AOrtho));
  end;
  DrawCube(At(0.0f, 0.0f, 0.0f), 9.0f, 9.0f, 1.0f, RED);
  if AFrameMode then
    EndFrameMode3D();
  else
    EndMode3D();
  end;
  if AFlood then
    DrawRectangle(-1000, -1000, 5000, 5000, GREEN);
  else
    DrawRectangle(0, 0, 8, 8, BLUE);
  end;
  EndFrame();
  LShot := LoadImageFromScreen();
  EndDrawing();
  return LShot;
end;

// The pixel of AShot at the frame's base point (ABX, ABY), through the camera the last
// BeginFrame set
routine FramePixel(const AShot: Image; const ABX: float32; const ABY: float32): Color;
var
  LCamera: Camera2D;
begin
  LCamera := GetFrameCamera();
  return GetImageColor(AShot, int32(LCamera.offset.x + ABX * LCamera.zoom),
    int32(LCamera.offset.y + ABY * LCamera.zoom));
end;

// The pixel of AShot halfway down the top bar, at the window's centre
routine TopBarPixel(const AShot: Image): Color;
begin
  return GetImageColor(AShot, AShot.width div 2, int32(GetFrameCamera().offset.y) div 2);
end;

// BeginFrameMode3D in a square window (bars above and below the 16:9 letterbox): the scene
// takes the letterbox's pixels and the base size's aspect; raylib's BeginMode3D (the control)
// takes the whole window's
routine TestFrame3D();
var
  LSide: int32;
  LShot: Image;
begin
  LSide := GetScreenHeight();
  SetWindowSize(LSide, LSide);
  Check("window made square", WaitWindowAndRender(LSide, LSide));

  // 18 units over the base height of 180: the cube is base 115..205 x 45..135
  LShot := CubeShot(true, true, false);
  Check("3d ortho cube at its base rect", SameColor(FramePixel(LShot, 160.0f, 90.0f), RED) and
    SameColor(FramePixel(LShot, 120.0f, 50.0f), RED) and
    SameColor(FramePixel(LShot, 200.0f, 130.0f), RED));
  Check("3d outside the cube is the frame",
    SameColor(FramePixel(LShot, 100.0f, 90.0f), GetFrameColor()) and
    SameColor(FramePixel(LShot, 160.0f, 30.0f), GetFrameColor()));
  Check("3d top bar kept", SameColor(TopBarPixel(LShot), GetFrameBarColor()));
  Check("after 3d the frame camera", SameColor(FramePixel(LShot, 4.0f, 4.0f), BLUE));
  UnloadImage(LShot);

  // raylib's BeginMode3D: 18 units over the whole window's height, so the cube is base
  // 80..240 x 10..170, past the points the frame left clear
  LShot := CubeShot(false, true, false);
  Check("plain mode3d takes the window aspect", SameColor(FramePixel(LShot, 100.0f, 90.0f), RED) and
    SameColor(FramePixel(LShot, 160.0f, 30.0f), RED));
  UnloadImage(LShot);

  LShot := CubeShot(true, true, true);
  Check("after 3d the clip", SameColor(TopBarPixel(LShot), GetFrameBarColor()) and
    SameColor(FramePixel(LShot, 4.0f, 4.0f), GREEN));
  UnloadImage(LShot);

  LShot := CubeShot(true, false, false);
  Check("3d perspective centred", SameColor(FramePixel(LShot, 160.0f, 90.0f), RED) and
    SameColor(TopBarPixel(LShot), GetFrameBarColor()));
  UnloadImage(LShot);
end;

// In a plain window (no frame) BeginFrameMode3D is raylib's BeginMode3D: the same pixels at a
// few points of the cube's edge and around it
routine SamePlain3D(): bool;
var
  LFrame: Image;
  LPlain: Image;
  LSame: bool;
begin
  LFrame := CubeShot(true, true, false);
  LPlain := CubeShot(false, true, false);
  LSame := SameColor(GetImageColor(LFrame, 80, 45), GetImageColor(LPlain, 80, 45)) and
    SameColor(GetImageColor(LFrame, 20, 45), GetImageColor(LPlain, 20, 45)) and
    SameColor(GetImageColor(LFrame, 80, 10), GetImageColor(LPlain, 80, 10)) and
    SameColor(GetImageColor(LFrame, 80, 45), RED);
  UnloadImage(LFrame);
  UnloadImage(LPlain);
  return LSame;
end;

// One empty frame (the frame colour inside the letterbox, the bars around it), the screen
// read back before EndDrawing (the caller unloads it)
routine EmptyShot(): Image;
var
  LShot: Image;
begin
  BeginDrawing();
  BeginFrame();
  EndFrame();
  LShot := LoadImageFromScreen();
  EndDrawing();
  return LShot;
end;

// SetFrameIntegerScale in a 1000 x 600 window, between the 3x (960 x 540) and 4x multiples of
// 320 x 180 and taller than 16:9: the fit rule has bars above and below, the integer rule
// bars on every side
routine TestIntegerScale();
var
  LBox: Rectangle;
  LShot: Image;
  LMiddle: int32;
  LLeft: int32;
  LRight: int32;
  LMouse: Vector2;
begin
  Check("integer scale off by default", not IsFrameIntegerScale());
  SetWindowSize(1000, 600);
  LBox := GetLetterboxRect(1000, 600, 320, 180);
  Check("fit frame letterbox", WaitWindowAndRender(1000, 600) and
    SameRect(GetFrameLetterbox(), GetLetterboxRect(GetScreenWidth(), GetScreenHeight(), 320, 180)));
  Check("window between multiples", (GetScreenWidth() = 1000) and (GetScreenHeight() = 600) and
    (GetRenderWidth() = 1000) and (GetRenderHeight() = 600));

  SetFrameIntegerScale(true);
  LShot := EmptyShot();
  LBox := GetFrameLetterbox();
  Check("integer frame letterbox",
    SameRect(LBox, GetIntegerLetterboxRect(GetScreenWidth(), GetScreenHeight(), 320, 180)) and
    SameRect(LBox, GetIntegerLetterboxRect(1000, 600, 320, 180)));
  Check("integer zoom whole", Near(GetFrameCamera().zoom, 3.0f));
  LMouse := GetFrameMousePosition();
  Check("integer mouse in frame", (LMouse.x >= 0.0f) and (LMouse.x <= 319.0f) and
    (LMouse.y >= 0.0f) and (LMouse.y <= 179.0f));
  // Whole pixels: the first and last frame columns are the frame colour, the columns just
  // outside them the bar colour
  LMiddle := LShot.height div 2;
  LLeft := int32(LBox.x);
  LRight := int32(LBox.x + LBox.width) - 1;
  Check("integer bar and frame on screen",
    SameColor(GetImageColor(LShot, LLeft - 1, LMiddle), GetFrameBarColor()) and
    SameColor(GetImageColor(LShot, LLeft, LMiddle), GetFrameColor()) and
    SameColor(GetImageColor(LShot, LRight, LMiddle), GetFrameColor()) and
    SameColor(GetImageColor(LShot, LRight + 1, LMiddle), GetFrameBarColor()));
  UnloadImage(LShot);

  SetFrameIntegerScale(false);
  LShot := EmptyShot();
  UnloadImage(LShot);
  LBox := GetLetterboxRect(GetScreenWidth(), GetScreenHeight(), 320, 180);
  Check("integer off is fit again", (not IsFrameIntegerScale()) and
    SameRect(GetFrameLetterbox(), LBox) and Near(GetFrameCamera().zoom, LBox.width / 320.0f));
end;

routine TestWindow();
var
  LSize: Vector2;
  LMouse: Vector2;
  LCamera: Camera2D;
begin
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  Check("frame window opens", InitFrameWindow(320, 180, "std_raylib_frame"));
  if not IsWindowReady() then
    return;
  end;
  Check("frame base size", (GetFrameWidth() = 320) and (GetFrameHeight() = 180));
  Check("frame dpi scale", Near(GetFrameScale(), float32(GetFrameDpi()) / 96.0f));

  // One frame first: the window system's resize is seen once events are polled (EndDrawing)
  BeginDrawing();
  BeginFrame();
  DrawRectangle(10, 10, 20, 20, RED);
  EndFrame();
  EndDrawing();
  LSize := GetScaledFrameSize(320, 180, GetFrameDpi());
  Check("window at scaled size", WaitWindowSize(LSize));
  Check("second window refused", not InitFrameWindow(320, 180, "std_raylib_frame"));

  // A frame at the window's settled size: its camera and mouse
  BeginDrawing();
  BeginFrame();
  EndFrame();
  EndDrawing();
  LCamera := GetFrameCamera();
  Check("frame camera zoom", Near(LCamera.zoom,
    GetLetterboxRect(GetScreenWidth(), GetScreenHeight(), 320, 180).width / 320.0f));
  LMouse := GetFrameMousePosition();
  Check("frame mouse in frame", (LMouse.x >= 0.0f) and (LMouse.x <= 319.0f) and
    (LMouse.y >= 0.0f) and (LMouse.y <= 179.0f));
  TestRestoreClip();
  TestFrame3D();
  TestIntegerScale();
  // Settings of the program's, kept over the close (TestClosed)
  SetFrameBarColor(DARKBLUE);
  SetFrameIntegerScale(true);
  CloseWindow();
end;

// After CloseWindow the frame is closed too: no base size, the frame calls do nothing, the
// colours kept; a new frame window opens again
routine TestClosed();
begin
  Check("closed no frame", (GetFrameWidth() = 0) and (GetFrameHeight() = 0) and
    Near(GetFrameCamera().zoom, 0.0f) and EmptyRect(GetFrameLetterbox()));
  BeginFrame();
  EndFrame();
  RestoreFrameClip();
  ToggleFrameFullscreen();
  Check("closed frame calls do nothing", not IsWindowReady());
  Check("closed colours kept", SameColor(GetFrameBarColor(), DARKBLUE));
  Check("closed integer scale kept", IsFrameIntegerScale());
  SetFrameIntegerScale(false);
  // Zoomed: the window at base x 2 x the DPI scale, the base size as it is
  SetFrameZoom(2.0f);
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  Check("reopened", InitFrameWindow(200, 100, "std_raylib_frame") and (GetFrameWidth() = 200) and
    (GetFrameHeight() = 100));
  if IsWindowReady() then
    Check("zoomed window size", WaitWindowSize(GetScaledFrameSize(400, 200, GetFrameDpi())) and
      (GetFrameWidth() = 200) and (GetFrameHeight() = 100));
    // A zoom set with the frame open resizes the window at once
    SetFrameZoom(3.0f);
    Check("zoom applied to the open window",
      WaitWindowSize(GetScaledFrameSize(600, 300, GetFrameDpi())));
    CloseWindow();
  end;
  Check("closed zoom kept", Near(GetFrameZoom(), 3.0f));
  SetFrameZoom(1.0f);
  // A plain raylib window right after the frame's close, no frame call between: never taken
  // for the frame
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  InitWindow(160, 90, "std_raylib_frame");
  Check("plain window after close no frame", IsWindowReady() and (GetFrameWidth() = 0));
  if IsWindowReady() then
    Check("plain window 3d is raylib's", SamePlain3D());
    CloseWindow();
  end;
end;

begin
  GFails := 0;
  SetTraceLogLevel(LOG_NONE);
  TestWindow();
  TestClosed();
  println("done {}", GFails);
end.
