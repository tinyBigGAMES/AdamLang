-------------------------------------------------------------------------------
  std_sysutils_sort.adam - System.SysUtils' SortStrings, a merge sort

  SortStrings orders by UTF-8 bytes as unsigned values, a prefix first,
  stable, in n log n (it was an insertion sort). Sorted: an empty list,
  one item, an ordered and a reversed list, equal items, a prefix before
  its longer text, a high UTF-8 byte after every ASCII one, an odd count
  (a run with no partner), and 3000 items whose order is checked pair by
  pair. Each row prints ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok empty
  | ok one
  | ok ordered
  | ok reversed
  | ok equal
  | ok prefix
  | ok utf8 after ascii
  | ok odd count
  | ok many in order
  | ok many count
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_sysutils_sort;

import System.SysUtils;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The list sorted, its items joined with '|'
routine Sorted(const AList: StringArray): string;
var
  LList: StringArray;
begin
  LList := AList;
  SortStrings(LList);
  return JoinStrings(LList, "|");
end;

routine TestMany();
var
  LList: StringArray;
  LI: int64;
  LOk: bool;
begin
  // 3000 texts in a scrambled order (I * 7919 mod 3000 visits every I once)
  setlength(LList, 3000);
  for LI := 0 to 2999 do
    LList[LI] := IntToStr((LI * 7919) mod 3000 + 100000);
  end;
  SortStrings(LList);
  LOk := true;
  for LI := 1 to len(LList) - 1 do
    if not (LList[LI - 1] < LList[LI]) then
      LOk := false;
    end;
  end;
  Check("many in order", LOk);
  Check("many count", (len(LList) = 3000) and (LList[0] = "100000") and (LList[2999] = "102999"));
end;

var
  LEmpty: StringArray;

begin
  GFails := 0;
  setlength(LEmpty, 0);
  Check("empty", Sorted(LEmpty) = "");
  Check("one", Sorted(["a"]) = "a");
  Check("ordered", Sorted(["a", "b", "c"]) = "a|b|c");
  Check("reversed", Sorted(["d", "c", "b", "a"]) = "a|b|c|d");
  Check("equal", Sorted(["b", "a", "b", "a"]) = "a|a|b|b");
  Check("prefix", Sorted(["abc", "ab", "a"]) = "a|ab|abc");
  Check("utf8 after ascii", Sorted(["é", "z", "A"]) = "A|z|é");
  Check("odd count", Sorted(["e", "a", "d", "b", "c"]) = "a|b|c|d|e");
  TestMany();
  println("done {}", GFails);
end.
