-------------------------------------------------------------------------------
  std_windows_sdk.adam - the Windows SDK records the std's Windows units share, in
  the SDK's own names and as Win64 lays them out (AD.5a, SN2): System.Windows'
  FILETIME .. PROCESS_INFORMATION, System.Windows.Debug's DEBUG_EVENT (its union
  u) .. STACKFRAME64, sizes and the offsets a caller writes; the kernel32 routines
  each declared once, in System.Windows, reached by importing it.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | size FILETIME 8
  | size WIN32_FIND_DATAW 592
  | size WIN32_FILE_ATTRIBUTE_DATA 36
  | size SECURITY_ATTRIBUTES 24
  | size STARTUPINFOW 104
  | at STARTUPINFOW.hStdInput 80
  | size PROCESS_INFORMATION 24
  | at PROCESS_INFORMATION.dwThreadId 20
  | size EXCEPTION_RECORD 152
  | size CREATE_PROCESS_DEBUG_INFO 72
  | size DEBUG_EVENT 176
  | at DEBUG_EVENT.u 16
  | at DEBUG_EVENT.u.CreateProcessInfo.lpStartAddress 64
  | size CONTEXT 1232
  | size IMAGEHLP_LINEW64 40
  | size SOURCEFILEW 16
  | size ADDRESS64 16
  | size STACKFRAME64 264
  | handle ok
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_windows_sdk;

import System.SysUtils, System.Windows, System.Windows.Debug;

var
  GStartup: STARTUPINFOW;
  GInfo: PROCESS_INFORMATION;
  GEvent: DEBUG_EVENT;
  GMode: uint32;

// AField's offset in the record at ARecord
routine DoAt(const AField: ptr to const; const ARecord: ptr to const): int64;
begin
  return int64(uint64(AField) - uint64(ARecord));
end;

begin
  println("size FILETIME {}", size(FILETIME));
  println("size WIN32_FIND_DATAW {}", size(WIN32_FIND_DATAW));
  println("size WIN32_FILE_ATTRIBUTE_DATA {}", size(WIN32_FILE_ATTRIBUTE_DATA));
  println("size SECURITY_ATTRIBUTES {}", size(SECURITY_ATTRIBUTES));
  println("size STARTUPINFOW {}", size(STARTUPINFOW));
  println("at STARTUPINFOW.hStdInput {}", DoAt(addr of GStartup.hStdInput, addr of GStartup));
  println("size PROCESS_INFORMATION {}", size(PROCESS_INFORMATION));
  println("at PROCESS_INFORMATION.dwThreadId {}", DoAt(addr of GInfo.dwThreadId, addr of GInfo));
  println("size EXCEPTION_RECORD {}", size(EXCEPTION_RECORD));
  println("size CREATE_PROCESS_DEBUG_INFO {}", size(CREATE_PROCESS_DEBUG_INFO));
  println("size DEBUG_EVENT {}", size(DEBUG_EVENT));
  println("at DEBUG_EVENT.u {}", DoAt(addr of GEvent.u, addr of GEvent));
  println("at DEBUG_EVENT.u.CreateProcessInfo.lpStartAddress {}", DoAt(addr of GEvent.u.CreateProcessInfo.lpStartAddress, addr of GEvent));
  println("size CONTEXT {}", size(CONTEXT));
  println("size IMAGEHLP_LINEW64 {}", size(IMAGEHLP_LINEW64));
  println("size SOURCEFILEW {}", size(SOURCEFILEW));
  println("size ADDRESS64 {}", size(ADDRESS64));
  println("size STACKFRAME64 {}", size(STACKFRAME64));
  // one declaration of each kernel32 routine, System.Windows' (AD.5a)
  if GetStdHandle(STD_OUTPUT_HANDLE) <> 0 then
    GMode := 0;
    GetConsoleMode(GetStdHandle(STD_OUTPUT_HANDLE), GMode);
    println("handle ok");
  end;
end.
