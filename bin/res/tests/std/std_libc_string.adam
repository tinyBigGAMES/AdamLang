  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  std_libc_string.adam - System.LibC.C's string routines from libc.a
  (res/libs/vendor/<triple>, musl's src/string built by AdamLang-Libs): each
  called on an input whose result is known (a returned pointer by its offset
  into the searched buffer, a buffer by its NUL-terminated text), strtok_r
  and strsep walking a list; then the binding: memcpy, memset, strcmp and
  strlen (the runtime's own, System.Runtime.LibC) and memcmp / memmove are
  not the platform C runtime's functions of those names, so every call in
  the image is libc.a's (PLAN-ADAM J2)
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok memcpy
  | ok memmove
  | ok memset
  | ok memcmp
  | ok memchr
  | ok memrchr
  | ok memmem
  | ok memccpy
  | ok mempcpy
  | ok strcpy
  | ok strcat
  | ok strncat
  | ok strncpy
  | ok strcmp
  | ok strncmp
  | ok strchr
  | ok strrchr
  | ok strchrnul
  | ok strspn
  | ok strpbrk
  | ok strstr
  | ok strlen
  | ok stpcpy
  | ok stpncpy
  | ok strlcpy
  | ok strlcat
  | ok strtok_r
  | ok strsep
  | bound memcpy libc
  | bound memset libc
  | bound strcmp libc
  | bound strlen libc
  | bound memcmp libc
  | bound memmove libc
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_libc_string;

import System.LibC.C;

type
  Buffer = array[0..7] of char;
  CopyFn = routine clink(p1: ptr; p2: ptr to const; p3: size_t): ptr;
  FillFn = routine clink(p1: ptr; p2: int32; p3: size_t): ptr;
  CompareFn = routine clink(p1: ptr to const char; p2: ptr to const char): int32;
  LengthFn = routine clink(p1: ptr to const char): size_t;
  BytesFn = routine clink(p1: ptr to const; p2: ptr to const; p3: size_t): int32;

var
  // the searched text, "banana" (one buffer: a result is its offset into it)
  GS: Buffer;

// ok / FAIL with AName
routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
  end;
end;

// True when the NUL-terminated text in ABuffer is AText
routine Same(const ABuffer: Buffer; const AText: ptr to const char): bool;
begin
  return strcmp(addr of ABuffer[0], AText) = 0;
end;

// The offset of AAt into GS; -1 for nil
routine Off(const AAt: ptr to const): int64;
begin
  if AAt = nil then
    return -1;
  end;
  return int64(uint64(AAt) - uint64(ptr to const(addr of GS[0])));
end;

// libc when AMine (the image's function) is not the platform C runtime's ACName
routine Bound(const AName: string; const AMine: ptr; const ACName: ptr to const char);
begin
  if AMine <> FindCRuntimeFunction(ACName) then
    println("bound {} libc", AName);
  else
    println("bound {} platform", AName);
  end;
end;

var
  LA: Buffer;
  LB: Buffer;
  LList: array[0..15] of char;
  LSave: ptr to char;
  LCursor: ptr to char;
  LWord: ptr to char;
  LCount: int32;
  LCopy: CopyFn;
  LFill: FillFn;
  LCompare: CompareFn;
  LLength: LengthFn;
  LBytes: BytesFn;
begin
  strcpy(addr of GS[0], "banana");
  Check("memcpy", (memcpy(ptr(addr of LA[0]), ptr to const char("hello"), 6) = ptr(addr of LA[0])) and (Same(LA, "hello")));
  Check("memmove", (memmove(ptr(addr of LA[1]), ptr to const(addr of LA[0]), 4) <> nil) and (Same(LA, "hhell")));
  Check("memset", (memset(ptr(addr of LA[0]), 122, 3) <> nil) and (Same(LA, "zzzll")));
  Check("memcmp", (memcmp(ptr to const char("abc"), ptr to const char("abd"), 3) < 0) and
    (memcmp(ptr to const char("abc"), ptr to const char("abd"), 2) = 0));
  Check("memchr", (Off(memchr(ptr to const(addr of GS[0]), 110, 6)) = 2) and (memchr(ptr to const(addr of GS[0]), 120, 6) = nil));
  Check("memrchr", (Off(memrchr(ptr to const(addr of GS[0]), 110, 6)) = 4) and (memrchr(ptr to const(addr of GS[0]), 120, 6) = nil));
  Check("memmem", (Off(memmem(ptr to const(addr of GS[0]), 6, ptr to const char("nan"), 3)) = 2) and (memmem(ptr to const(addr of GS[0]), 6, ptr to const char("nab"), 3) = nil));
  Check("memccpy", (memccpy(ptr(addr of LA[0]), ptr to const char("ab:cd"), 58, 5) = ptr(addr of LA[3])) and (Same(LA, "ab:ll")));
  Check("mempcpy", (mempcpy(ptr(addr of LA[0]), ptr to const char("xy"), 2) = ptr(addr of LA[2])) and (Same(LA, "xy:ll")));
  Check("strcpy", (strcpy(addr of LA[0], "cat") = addr of LA[0]) and (Same(LA, "cat")));
  Check("strcat", (strcat(addr of LA[0], "s") = addr of LA[0]) and (Same(LA, "cats")));
  Check("strncat", (strncat(addr of LA[0], "!!!", 1) = addr of LA[0]) and (Same(LA, "cats!")));
  Check("strncpy", (strncpy(addr of LB[0], "dog", 6) = addr of LB[0]) and (Same(LB, "dog") and (int32(LB[5]) = 0)));
  Check("strcmp", (strcmp("abc", "abd") < 0) and (strcmp("abc", "abc") = 0));
  Check("strncmp", (strncmp("abc", "abd", 2) = 0) and (strncmp("b", "a", 1) > 0));
  Check("strchr", (Off(strchr(addr of GS[0], 110)) = 2) and (strchr(addr of GS[0], 120) = nil));
  Check("strrchr", (Off(strrchr(addr of GS[0], 97)) = 5) and (strrchr(addr of GS[0], 120) = nil));
  Check("strchrnul", (Off(strchrnul(addr of GS[0], 120)) = 6) and (Off(strchrnul(addr of GS[0], 110)) = 2));
  Check("strspn", (strspn("aabbc", "ab") = 4) and (strcspn("aabbc", "c") = 4));
  Check("strpbrk", (Off(strpbrk(addr of GS[0], "xn")) = 2) and (strpbrk(addr of GS[0], "xy") = nil));
  Check("strstr", (Off(strstr(addr of GS[0], "ana")) = 1) and (strstr(addr of GS[0], "nab") = nil));
  Check("strlen", (strlen("banana") = 6) and (strnlen("banana", 3) = 3));
  Check("stpcpy", (stpcpy(addr of LA[0], "ab") = addr of LA[2]) and (Same(LA, "ab")));
  Check("stpncpy", (stpncpy(addr of LA[0], "xyz", 2) = addr of LA[2]) and (Same(LA, "xy")));
  Check("strlcpy", (strlcpy(addr of LB[0], "longer", 4) = 6) and (Same(LB, "lon")));
  Check("strlcat", (strlcat(addr of LB[0], "gest", 8) = 7) and (Same(LB, "longest")));
  // strtok_r: the words of "a,b,,c" (empty fields skipped), its place kept in LSave
  strcpy(addr of LList[0], "a,b,,c");
  LCount := 0;
  LWord := strtok_r(addr of LList[0], ",", addr of LSave);
  while LWord <> nil do
    LCount := LCount + 1;
    LWord := strtok_r(nil, ",", addr of LSave);
  end;
  Check("strtok_r", LCount = 3);
  // strsep: the fields of "a,b,,c" (the empty one kept)
  strcpy(addr of LList[0], "a,b,,c");
  LCursor := addr of LList[0];
  LCount := 0;
  while strsep(addr of LCursor, ",") <> nil do
    LCount := LCount + 1;
  end;
  Check("strsep", LCount = 4);
  LCopy := memcpy;
  Bound("memcpy", ptr(LCopy), "memcpy");
  LFill := memset;
  Bound("memset", ptr(LFill), "memset");
  LCompare := strcmp;
  Bound("strcmp", ptr(LCompare), "strcmp");
  LLength := strlen;
  Bound("strlen", ptr(LLength), "strlen");
  LBytes := memcmp;
  Bound("memcmp", ptr(LBytes), "memcmp");
  LCopy := memmove;
  Bound("memmove", ptr(LCopy), "memmove");
end.
