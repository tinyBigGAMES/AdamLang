-------------------------------------------------------------------------------
  std_hookio_refused.adam - System.HookIO's refusals (PaskalCPP's std_hookio
  TestRefused)

  Paths and modes refused before any stream is asked, and the registry's own
  refusals: an unregistered prefix, prefix 0, a leading zero and a prefix
  that is no number are missing files (ENOENT); a leading "./" (once or
  more, or ".\") names the same path, anything else before the scheme makes
  a plain path (the C runtime's); w+ on a read-only IO is EACCES and leaves
  the IO as it was; ucrt's mode rules (an unknown letter, a second +, x
  without w: EINVAL; spaces and the letters that change nothing are taken);
  x on a registered IO, which always exists, is EEXIST; nil registers
  nothing, and only a registered prefix, exactly, unregisters.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok unregistered prefix
  | ok prefix zero
  | ok prefix leading zero
  | ok prefix not a number
  | ok prefix behind ./
  | ok prefix behind ././
  | ok prefix behind .\ too
  | ok prefix behind a folder is plain
  | ok mode w+ read-only EACCES
  | ok mode unknown letter refused
  | ok mode second plus refused
  | ok mode x without w refused
  | ok mode flags taken
  | ok mode x on a registered io EEXIST
  | ok register nil io
  | ok register nil source
  | ok unregister
  | ok unregister twice
  | ok unregister not a prefix
  | ok refused io close
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_refused;

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// A failed open: nil, and errno is AError (cleared before the call by the caller, so the
// value is the call's own). A stream that opened anyway is closed (the row fails)
routine Failed(const AFile: ptr; const AErrno: int32; const AError: int32): bool;
begin
  if AFile <> nil then
    fclose(AFile);
    return false;
  end;
  return AErrno = AError;
end;

// fopen of an Adam text path and mode (their C copies freed after the call)
routine OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

// True when APath opens in AMode and its first byte, read with fgetc, is AFirst (the handle
// closed again)
routine OpensWith(const APath: string; const AMode: string; const AFirst: uint8): bool;
var
  LFile: ptr;
  LOk: bool;
begin
  LFile := OpenPath(APath, AMode);
  if LFile = nil then
    return false;
  end;
  LOk := fgetc(LFile) = int32(AFirst);
  fclose(LFile);
  return LOk;
end;

// errno after an open of APath in AMode that must fail (a stream that opened anyway closed,
// -1 then)
routine OpenError(const APath: string; const AMode: string): int32;
var
  LFile: ptr;
  LError: int32;
begin
  SetCErrno(0);
  LFile := OpenPath(APath, AMode);
  LError := CErrno();
  if LFile <> nil then
    fclose(LFile);
    return -1;
  end;
  return LError;
end;

// Paths and modes refused before any stream is asked, and the registry's own refusals
routine TestRefused();
var
  LData: array[0..3] of uint8;
  LMemory: IO;
  LPrefix: string;
  LFile: ptr;
  LError: int32;
begin
  LData[0] := 1;
  LData[1] := 2;
  LData[2] := 3;
  LData[3] := 4;
  LMemory := CreateMemoryIO(addr of LData[0], 4, true);
  LPrefix := RegisterIO(LMemory);

  Check("unregistered prefix", OpenError("io://999999/x.bin", "rb") = ADAM_ERRNO_ENOENT);
  Check("prefix zero", OpenError("io://0/x.bin", "rb") = ADAM_ERRNO_ENOENT);
  Check("prefix leading zero", OpenError("io://0" + Substring(LPrefix, 5, len(LPrefix) - 5) +
    "/x.bin", "rb") = ADAM_ERRNO_ENOENT);
  Check("prefix not a number", OpenError("io://abc/x.bin", "rb") = ADAM_ERRNO_ENOENT);

  // A leading "./", once or more, names the same path (a C library joining a folder with no
  // root and a name writes it so: raylib's textures); ".\" is the same step on Windows
  Check("prefix behind ./", OpensWith("./" + LPrefix + "/x.bin", "rb", 1));
  Check("prefix behind ././", OpensWith("././" + LPrefix + "/x.bin", "rb", 1));
  Check("prefix behind .\\ too", OpensWith(".\\" + LPrefix + "/x.bin", "rb", 1));
  // Anything else before the scheme is a plain path: the C runtime's (a ':' in a folder name
  // on Windows)
  LFile := OpenPath("x/" + LPrefix + "/x.bin", "rb");
  Check("prefix behind a folder is plain", LFile = nil);
  if LFile <> nil then
    fclose(LFile);
  end;

  // w+ empties: on a read-only IO refused as on a read-only file, the IO kept
  SetCErrno(0);
  LFile := OpenPath(LPrefix + "/x.bin", "w+b");
  LError := CErrno();
  Check("mode w+ read-only EACCES", Failed(LFile, LError, ADAM_ERRNO_EACCES) and
    (IOSize(LMemory) = 4) and (LData[3] = 4));

  // ucrt's mode rules: an unknown letter, a second +, x with any first letter but w
  Check("mode unknown letter refused", OpenError(LPrefix + "/x.bin", "rq") = ADAM_ERRNO_EINVAL);
  Check("mode second plus refused", OpenError(LPrefix + "/x.bin", "r++") = ADAM_ERRNO_EINVAL);
  Check("mode x without w refused", OpenError(LPrefix + "/x.bin", "rx") = ADAM_ERRNO_EINVAL);
  // Leading spaces, then the letters that change nothing an IO shows: c, S, T, N, spaces
  Check("mode flags taken", OpensWith(LPrefix + "/x.bin", "  rbcSTN N ", 1));
  // A registered IO always exists: a creating x open of it fails
  Check("mode x on a registered io EEXIST", OpenError(LPrefix + "/x.bin", "wxb") =
    ADAM_ERRNO_EEXIST);

  Check("register nil io", RegisterIO(nil) = "");
  Check("register nil source", RegisterIOSource(nil) = "");

  Check("unregister", UnregisterIO(LPrefix));
  Check("unregister twice", not UnregisterIO(LPrefix));
  Check("unregister not a prefix", not UnregisterIO(LPrefix + "/x.bin"));
  Check("refused io close", IOClose(LMemory));
end;

begin
  GFails := 0;
  TestRefused();
  println("done {}", GFails);
end.
