-------------------------------------------------------------------------------
  std_hookabi_fopen_linux.adam - System.HookABI on x86_64-linux-gnu
  (PLAN-LINUX64 LX4g, std_hookabi_fopen's linux twin): fopen hooked by a
  public routine of its name, counting its calls and calling the real fopen
  it found once with HookReal through its own routine type. The hook binds
  the program's own call and the call inside libtomlc17.a
  (toml_parse_file_ex); the real function is glibc's (libc.so.6), not the
  hook, and a call through it is not hooked. HookReal's library form looks
  in the named library alone: glibc's libresolv.so.2, opened at run time,
  gives its own ns_makecanon and no fopen (it defines none). Failure paths:
  a C name the C runtime lacks and a library not loaded (nil, the slot left
  nil).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | own open true
  | calls 1
  | toml ok true
  | calls 2
  | real found true
  | real is hook false
  | real open true
  | calls 2
  | unknown nil true
  | unknown slot nil true
  | library missing nil true
  | libresolv loaded true
  | libresolv routine true
  | libresolv fopen nil true
  | calls 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

@ifndef TARGET_X86_64_LINUX_GNU
@message error "std_hookabi_fopen_linux runs on x86_64-linux-gnu only (win64: std_hookabi_fopen)";
@endif

module exe std_hookabi_fopen_linux;

import System.SysUtils, System.HookABI, System.TOML.C;

type
  FopenFn = func(const APath: ptr to const char; const AMode: ptr to const char): ptr;

func fputs(const AText: ptr to const char; const AStream: ptr): int32; external "c";
func fclose(const AStream: ptr): int32; external "c";
func dlopen(const AFile: ptr to const char; const AMode: int32): ptr; external "c";
func dlclose(const AHandle: ptr): int32; external "c";

const
  // dlfcn.h: every symbol bound at the load
  RTLD_NOW: int32 = 2;

// Every fopen below opens std_hookabi_fopen_linux.toml, the file the program writes first
var
  // The hook's slot of the real fopen (HookReal's), and the calls the hook saw
  GRealFopen: ptr;
  GCalls: int64;
  GNone: ptr;
  GMissing: ptr;
  GResolvRoutine: ptr;
  GResolvFopen: ptr;
  GLibrary: ptr;
  GFile: ptr;
  GResult: toml_result_t;
  GHook: FopenFn;
  GReal: FopenFn;

// The hook: C's fopen, counted, then the real one
public func fopen(const APath: ptr to const char; const AMode: ptr to const char): ptr;
var
  LReal: FopenFn;
begin
  GCalls := GCalls + 1;
  LReal := FopenFn(HookReal(GRealFopen, ptr to const char("fopen")));
  return LReal(APath, AMode);
end;

// AValue as true / false
func BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// ALabel and AValue on one line
func ShowBool(const ALabel: string; const AValue: bool);
begin
  println("{}", ALabel + " " + BoolText(AValue));
end;

// The hook's count so far
func ShowCalls();
begin
  println("calls {}", GCalls);
end;

begin
  // The program's own call
  GFile := fopen(ptr to const char("std_hookabi_fopen_linux.toml"), ptr to const char("w"));
  ShowBool("own open", GFile <> nil);
  ShowCalls();
  fputs(ptr to const char("count = 3"), GFile);
  fclose(GFile);

  // tomlc17's call, inside libtomlc17.a
  GResult := toml_parse_file_ex(ptr to const char("std_hookabi_fopen_linux.toml"));
  ShowBool("toml ok", GResult.ok);
  toml_free(GResult);
  ShowCalls();

  // The real fopen: found, not the hook, and a call through it is not hooked
  ShowBool("real found", GRealFopen <> nil);
  GHook := fopen;
  ShowBool("real is hook", GRealFopen = ptr(GHook));
  GReal := FopenFn(GRealFopen);
  GFile := GReal(ptr to const char("std_hookabi_fopen_linux.toml"), ptr to const char("r"));
  ShowBool("real open", GFile <> nil);
  fclose(GFile);
  ShowCalls();

  // Nothing found: the slot stays nil
  ShowBool("unknown nil", HookReal(GNone, ptr to const char("adam_no_such_function")) = nil);
  ShowBool("unknown slot nil", GNone = nil);
  ShowBool("library missing nil", HookReal(GMissing, ptr to const char("libadam_no_such.so"),
    ptr to const char("fopen")) = nil);

  // A library opened at run time: looked in alone
  GLibrary := dlopen(ptr to const char("libresolv.so.2"), RTLD_NOW);
  ShowBool("libresolv loaded", GLibrary <> nil);
  ShowBool("libresolv routine", HookReal(GResolvRoutine, ptr to const char("libresolv.so.2"),
    ptr to const char("ns_makecanon")) <> nil);
  ShowBool("libresolv fopen nil", HookReal(GResolvFopen, ptr to const char("libresolv.so.2"),
    ptr to const char("fopen")) = nil);
  dlclose(GLibrary);
  ShowCalls();
end.
