-------------------------------------------------------------------------------
  std_raven_text.adam - System.Raven.Ext's Adam forms of Raven's text calls
  (PLAN-LINUX64 LX3d3f3a): a layout built from XML text on Raven's null
  backend; FindWidget finds its named widgets and gives R_INVALID_ID for a
  name it lacks; SetWidgetText / WidgetText round-trip a label's, a check
  box's, a text input's and a text editor's text (a non-ASCII one too); a
  button's text is set but has no reading form (""); SetWidgetAttribute
  takes a known attribute and refuses an unknown one (false).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | init true
  | found true true true true true missing true
  | label [Hello] true
  | check [Agree] true
  | input [Grüße] true
  | editor [line 1|line 2] true
  | button set true read []
  | attribute true
  | unknown false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raven_text;

import System.SysUtils, System.Raven.C, System.Raven.Ext;

const
  LAYOUT: string = "<VBox><Label Name=\"title\" Text=\"x\"/><Checkbox Name=\"agree\" Text=\"x\"/>" +
    "<TextInput Name=\"name\"/><TextEditor Name=\"code\"/><Button Name=\"go\" Text=\"x\"/></VBox>";

var
  LDesc: RInitDesc;
  LRoot: Rid;
  LLayout: ptr to char;
  LLabel: Rid;
  LCheck: Rid;
  LInput: Rid;
  LEditor: Rid;
  LButton: Rid;
  LOk: bool;
begin
  ReportRavenErrors();
  LDesc.backend := R_BACKEND_NULL;
  LDesc.app_name := "std_raven_text";
  LDesc.headless := R_TRUE;
  LDesc.disable_render_thread := R_TRUE;
  println("init {}", Rinit_ex(addr of LDesc) <> 0);
  LLayout := StringToC(LAYOUT);
  LRoot := Rwidget_create_from_xml(LLayout, uint64(len(LAYOUT)));
  freemem(LLayout);
  LLabel := FindWidget(LRoot, "title");
  LCheck := FindWidget(LRoot, "agree");
  LInput := FindWidget(LRoot, "name");
  LEditor := FindWidget(LRoot, "code");
  LButton := FindWidget(LRoot, "go");
  println("found {} {} {} {} {} missing {}", LLabel <> R_INVALID_ID, LCheck <> R_INVALID_ID,
    LInput <> R_INVALID_ID, LEditor <> R_INVALID_ID, LButton <> R_INVALID_ID,
    FindWidget(LRoot, "nobody") = R_INVALID_ID);
  LOk := SetWidgetText(LLabel, "Hello");
  println("label [{}] {}", WidgetText(LLabel), LOk);
  LOk := SetWidgetText(LCheck, "Agree");
  println("check [{}] {}", WidgetText(LCheck), LOk);
  LOk := SetWidgetText(LInput, "Grüße");
  println("input [{}] {}", WidgetText(LInput), LOk);
  LOk := SetWidgetText(LEditor, "line 1\nline 2");
  println("editor [{}] {}", StringReplace(WidgetText(LEditor), "\n", "|"), LOk);
  LOk := SetWidgetText(LButton, "Go");
  println("button set {} read [{}]", LOk, WidgetText(LButton));
  println("attribute {}", SetWidgetAttribute(LLabel, "Visibility", "Collapsed"));
  println("unknown {}", SetWidgetAttribute(LLabel, "NoSuchAttribute", "1"));
  Rwidget_destroy(LRoot);
  Rshutdown();
end.
