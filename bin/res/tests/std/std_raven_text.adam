-------------------------------------------------------------------------------
  std_raven_text.adam - System.Raven.Ext's UIWidget text forms (PLAN-LINUX64
  LX3d3f3a, on UIWidget since PLAN-RAVENAPI V2): a layout built from XML
  text on Raven's null backend; Find<UIWidget> finds its named widgets, Has
  is false for a name it lacks; Text(S) / Text() round-trip a label's, a
  check box's, a text input's and a text editor's text (a non-ASCII one
  too); a button's text is set but has no reading form (""); Attribute
  takes a known attribute and refuses an unknown one (false).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | init true
  | found true true true true true missing true
  | label [Hello] true
  | check [Agree] true
  | input [Grüße] true
  | editor [line 1|line 2] true
  | button set true read []
  | attribute true
  | unknown false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raven_text;

import System.SysUtils, System.Raven.C, System.Raven.Ext;

const
  LAYOUT: string = "<VBox><Label Name=\"title\" Text=\"x\"/><Checkbox Name=\"agree\" Text=\"x\"/>" +
    "<TextInput Name=\"name\"/><TextEditor Name=\"code\"/><Button Name=\"go\" Text=\"x\"/></VBox>";

var
  LDesc: RInitDesc;
  LRoot: UIWidget;
  LLabel: UIWidget;
  LCheck: UIWidget;
  LInput: UIWidget;
  LEditor: UIWidget;
  LButton: UIWidget;
  LOk: bool;
begin
  UIErrors.Report();
  LDesc.backend := R_BACKEND_NULL;
  LDesc.app_name := "std_raven_text";
  LDesc.headless := R_TRUE;
  LDesc.disable_render_thread := R_TRUE;
  println("init {}", Rinit_ex(addr of LDesc) <> 0);
  LRoot := UIWidget.FromXmlText(LAYOUT);
  LLabel := LRoot.Find<UIWidget>("title");
  LCheck := LRoot.Find<UIWidget>("agree");
  LInput := LRoot.Find<UIWidget>("name");
  LEditor := LRoot.Find<UIWidget>("code");
  LButton := LRoot.Find<UIWidget>("go");
  println("found {} {} {} {} {} missing {}", LLabel.IsValid(), LCheck.IsValid(), LInput.IsValid(),
    LEditor.IsValid(), LButton.IsValid(), not LRoot.Has<UIWidget>("nobody"));
  LOk := LLabel.Text("Hello");
  println("label [{}] {}", LLabel.Text(), LOk);
  LOk := LCheck.Text("Agree");
  println("check [{}] {}", LCheck.Text(), LOk);
  LOk := LInput.Text("Grüße");
  println("input [{}] {}", LInput.Text(), LOk);
  LOk := LEditor.Text("line 1\nline 2");
  println("editor [{}] {}", ReplaceStr(LEditor.Text(), "\n", "|"), LOk);
  LOk := LButton.Text("Go");
  println("button set {} read [{}]", LOk, LButton.Text());
  println("attribute {}", LLabel.Attribute("Visibility", "Collapsed"));
  println("unknown {}", LLabel.Attribute("NoSuchAttribute", "1"));
  LRoot.Destroy();
  Rshutdown();
end.
