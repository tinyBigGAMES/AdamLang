-------------------------------------------------------------------------------
  std_io_writetime.adam - System.IO's FileWriteTime (ACU4): nanoseconds
  since 1970-01-01 UTC on every target, so a file seen from two hosts gives
  one value: a file just written is within a minute of the OS clock read
  the same way (win64 GetSystemTimeAsFileTime, linux clock_gettime
  CLOCK_REALTIME), a file written after it is not older, a folder and a
  missing path are -1. Each line ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok near clock
  | ok later not older
  | ok folder
  | ok missing
  | ok cleaned
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_io_writetime;

import System.SysUtils, System.IO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.Windows.SDK
@elseif TARGET_X86_64_LINUX_GNU
  , System.Linux
@endif
  ;

const
  // The row's exe lands in repo\bin\output\bin\<triple>\<mode>: `$P:` is that folder
  CDir: string = "$P:std_io_writetime_dir";
  CFirst: string = "$P:std_io_writetime_dir/first.txt";
  CSecond: string = "$P:std_io_writetime_dir/second.txt";
  CMissing: string = "$P:std_io_writetime_dir/missing.txt";
  // How far a file's write time may be from the clock read after it
  CSlackNs: int64 = 60000000000;
@ifdef TARGET_X86_64_WINDOWS_GNU
  // FILETIME's ticks (100 ns since 1601-01-01 UTC) at 1970-01-01 UTC, and ns per tick
  CEpochTicks: int64 = 116444736000000000;
  CTickNs: int64 = 100;
@elseif TARGET_X86_64_LINUX_GNU
  // time.h's CLOCK_REALTIME
  CRealTime: int32 = 0;
@endif

@ifdef TARGET_X86_64_WINDOWS_GNU
func GetSystemTimeAsFileTime(var AFileTime: FILETIME); external "kernel32";
@endif

// The OS clock as nanoseconds since 1970-01-01 UTC, read without System.IO
func ClockNs(): int64;
var
@ifdef TARGET_X86_64_WINDOWS_GNU
  LTime: FILETIME;
@elseif TARGET_X86_64_LINUX_GNU
  LTime: timespec;
@endif
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  GetSystemTimeAsFileTime(LTime);
  return (int64((uint64(LTime.dwHighDateTime) shl 32) | uint64(LTime.dwLowDateTime)) -
    CEpochTicks) * CTickNs;
@elseif TARGET_X86_64_LINUX_GNU
  clock_gettime(CRealTime, LTime);
  return LTime.tv_sec * 1000000000 + LTime.tv_nsec;
@endif
end;

// One check's line: ok or FAIL with its name
func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
  end;
end;

var
  GFirst: int64;
  GSecond: int64;
  GClock: int64;

begin
  if DirectoryExists(CDir) then
    RemoveDir(CDir, true);
  end;
  ForceDirectories(CDir);
  WriteAllText(CFirst, "first");
  GFirst := FileWriteTime(CFirst);
  GClock := ClockNs();
  Check("near clock", (GFirst > 0) and (GFirst - GClock < CSlackNs) and
    (GClock - GFirst < CSlackNs));
  WriteAllText(CSecond, "second");
  GSecond := FileWriteTime(CSecond);
  Check("later not older", GSecond >= GFirst);
  Check("folder", FileWriteTime(CDir) = -1);
  Check("missing", FileWriteTime(CMissing) = -1);
  Check("cleaned", RemoveDir(CDir, true) and not DirectoryExists(CDir));
end.
