-------------------------------------------------------------------------------
  std_io_jobs.adam - System.IO's jobs added for raylib's file routines
  (PLAN-RAVENAPI R9, sec 7): IsPathAbsolute by the target's rule,
  CurrentDir / SetCurrentDir (a relative path then found there, refusals,
  back), IsFileHidden (a dot file on linux, ProgramData's hidden attribute
  on windows), CopyFile (new, refused onto an existing file unless asked,
  overwrite, never onto itself, a missing source, a folder target, a
  3145735-byte file byte for byte), RenameFile into the system temp folder
  (another file system under WSL: a copy and a removal) and GetFiles with
  masks, case aside, and subfolders. Each line ok or FAIL with its name;
  everything made is removed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok made
  | ok name abs exe
  | ok name abs rel
  | ok name abs form
  | ok name abs not
  | ok cwd form
  | ok cwd set
  | ok cwd relative
  | ok cwd missing
  | ok cwd file
  | ok cwd back
  | ok hidden yes
  | ok hidden no
  | ok hidden missing
  | ok copy new
  | ok copy text
  | ok copy exists refused
  | ok copy overwrite
  | ok copy self refused
  | ok copy self kept
  | ok copy missing
  | ok copy onto folder
  | ok copy big
  | ok move
  | ok move source gone
  | ok move text
  | ok find flat w.jpg,x.png
  | ok find deep w.jpg,x.png,b/y.PNG
  | ok find all v.txt,w.jpg,x.png
  | ok find missing
  | ok cleaned
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_io_jobs;

import System.SysUtils, System.IO;

var
  GFails: int64;

// One line: ok or FAIL with AName
func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// ACount bytes, each from its index, in a pattern no chunk size divides
func PatternBytes(const ACount: int64): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, ACount);
  for LI := 0 to ACount - 1 do
    LBytes[LI] := uint8((LI * 7 + LI div 251) & 0xFF);
  end;
  return LBytes;
end;

// True when the two byte arrays are the same
func SameBytes(const ALeft: ByteArray; const ARight: ByteArray): bool;
var
  LI: int64;
begin
  if len(ALeft) <> len(ARight) then
    return false;
  end;
  for LI := 0 to len(ALeft) - 1 do
    if ALeft[LI] <> ARight[LI] then
      return false;
    end;
  end;
  return true;
end;

// IsPathAbsolute by the target's own rule (the same check names on both)
func RunAbsolute();
begin
  Check("name abs exe", IsPathAbsolute(ExeDir()));
  Check("name abs rel", not IsPathAbsolute("a/b.txt") and not IsPathAbsolute(""));
@ifdef TARGET_X86_64_WINDOWS_GNU
  Check("name abs form", IsPathAbsolute("C:\\x") and IsPathAbsolute("d:/x") and
    IsPathAbsolute("\\\\server\\share"));
  Check("name abs not", not IsPathAbsolute("C:x") and not IsPathAbsolute("\\x"));
@else
  Check("name abs form", IsPathAbsolute("/x") and IsPathAbsolute("\\x"));
  Check("name abs not", not IsPathAbsolute("C:\\x") and not IsPathAbsolute("x/"));
@endif
end;

// The working folder moved into ADir and back
func RunCurrent(const ADir: string);
var
  LStart: string;
  LText: string;
begin
  LStart := CurrentDir();
  Check("cwd form", (LStart <> "") and DirectoryExists(LStart) and IsPathAbsolute(LStart));
  Check("cwd set", SetCurrentDir(ADir) and SamePath(CurrentDir(), ADir));
  Check("cwd relative", ReadAllText("one.txt", LText) and (LText = "abc"));
  Check("cwd missing", not SetCurrentDir(ADir + "/nope") and SamePath(CurrentDir(), ADir));
  Check("cwd file", not SetCurrentDir(ADir + "/one.txt"));
  Check("cwd back", SetCurrentDir(LStart) and SamePath(CurrentDir(), LStart));
end;

// A hidden item, a plain one, a missing one
func RunHidden(const ADir: string);
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  // ProgramData is made hidden by Windows' own setup on every install
  Check("hidden yes", IsFileHidden(GetEnvironmentVariable("ProgramData")));
@else
  Check("hidden yes", WriteAllText(ADir + "/.dot", "x") and IsFileHidden(ADir + "/.dot") and
    DeleteFile(ADir + "/.dot"));
@endif
  Check("hidden no", not IsFileHidden(ADir + "/one.txt"));
  Check("hidden missing", not IsFileHidden(ADir + "/nope.txt"));
end;

// CopyFile's cases, then RenameFile into the system temp folder
func RunCopy(const ADir: string);
var
  LText: string;
  LBig: ByteArray;
  LBack: ByteArray;
  LMoved: string;
begin
  Check("copy new", CopyFile(ADir + "/one.txt", ADir + "/two.txt", false));
  Check("copy text", ReadAllText(ADir + "/two.txt", LText) and (LText = "abc"));
  Check("copy exists refused", WriteAllText(ADir + "/one.txt", "defg") and
    not CopyFile(ADir + "/one.txt", ADir + "/two.txt", false) and
    ReadAllText(ADir + "/two.txt", LText) and (LText = "abc"));
  Check("copy overwrite", CopyFile(ADir + "/one.txt", ADir + "/two.txt", true) and
    ReadAllText(ADir + "/two.txt", LText) and (LText = "defg"));
  Check("copy self refused", not CopyFile(ADir + "/one.txt", ADir + "/one.txt", true));
  Check("copy self kept", ReadAllText(ADir + "/one.txt", LText) and (LText = "defg"));
  Check("copy missing", not CopyFile(ADir + "/nope.txt", ADir + "/three.txt", true) and
    not FileExists(ADir + "/three.txt"));
  Check("copy onto folder", ForceDirectories(ADir + "/a") and
    not CopyFile(ADir + "/one.txt", ADir + "/a", true));
  LBig := PatternBytes(3145735);
  Check("copy big", WriteAllBytes(ADir + "/big.bin", LBig) and
    CopyFile(ADir + "/big.bin", ADir + "/big2.bin", false) and
    ReadAllBytes(ADir + "/big2.bin", LBack) and SameBytes(LBig, LBack));
  LMoved := TempDir() + "/std_io_jobs_moved.txt";
  DeleteFile(LMoved);
  Check("move", RenameFile(ADir + "/two.txt", LMoved));
  Check("move source gone", not FileExists(ADir + "/two.txt"));
  Check("move text", ReadAllText(LMoved, LText) and (LText = "defg") and DeleteFile(LMoved));
end;

// GetFiles with masks (case aside) and subfolders
func RunFind(const ADir: string);
var
  LList: StringArray;
begin
  ForceDirectories(ADir + "/a/b");
  WriteAllText(ADir + "/a/x.png", "x");
  WriteAllText(ADir + "/a/w.jpg", "w");
  WriteAllText(ADir + "/a/v.txt", "v");
  WriteAllText(ADir + "/a/b/y.PNG", "y");
  WriteAllText(ADir + "/a/b/z.txt", "z");
  GetFiles(ADir + "/a", "*.png;*.JPG", false, LList);
  Check("find flat " + JoinStrings(LList, ","), true);
  GetFiles(ADir + "/a", "*.png;;*.jpg", true, LList);
  Check("find deep " + JoinStrings(LList, ","), true);
  GetFiles(ADir + "/a", "", false, LList);
  Check("find all " + JoinStrings(LList, ","), true);
  Check("find missing", not GetFiles(ADir + "/nope", "*", true, LList) and (len(LList) = 0));
end;

func Run();
var
  LDir: string;
begin
  LDir := ResolvePath("$P:std_io_jobs_d");
  Check("made", ForceDirectories(LDir) and WriteAllText(LDir + "/one.txt", "abc"));
  RunAbsolute();
  RunCurrent(LDir);
  RunHidden(LDir);
  RunCopy(LDir);
  RunFind(LDir);
  Check("cleaned", DeleteFile(LDir + "/a/b/y.PNG") and DeleteFile(LDir + "/a/b/z.txt") and
    RemoveDir(LDir + "/a/b") and DeleteFile(LDir + "/a/x.png") and DeleteFile(LDir + "/a/w.jpg") and
    DeleteFile(LDir + "/a/v.txt") and RemoveDir(LDir + "/a") and DeleteFile(LDir + "/one.txt") and
    DeleteFile(LDir + "/big.bin") and DeleteFile(LDir + "/big2.bin") and RemoveDir(LDir));
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
