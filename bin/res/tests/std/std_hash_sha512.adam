module exe std_hash_sha512;

import System.SysUtils, System.Hash;

// The SHA-512 digest of AText as hex
func Digest(const AText: string): string;
begin
  return DigestToHex(ComputeHash(HashKind.SHA512, AText));
end;

// AText given to a hasher in pieces of ASize bytes: the one-call digest?
func InPieces(const AText: string; const ASize: int64): bool;
var
  LHash: Hasher;
  LAt: int64;
  LCount: int64;
begin
  LHash := Hasher(HashKind.SHA512);
  LAt := 0;
  while LAt < len(AText) do
    LCount := ASize;
    if LAt + LCount > len(AText) then
      LCount := len(AText) - LAt;
    end;
    LHash.Update(Substring(AText, LAt, LCount));
    LAt := LAt + LCount;
  end;
  return DigestToHex(LHash.Final()) = Digest(AText);
end;

var
  GHash: Hasher;
  GText: string;
  GFirst: string;
  GBytes: ByteArray;
  GRun: int64;
  GSizes: array[0..5] of int64;
  // FIPS 180-4's two-block message (112 bytes: its length field starts a second block)
  GTwo: string;
  GI: int64;

begin
  println("empty {}", Digest(""));
  println("abc {}", Digest("abc"));
  GTwo := "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
  println("two blocks {}", Digest(GTwo));
  GSizes := [111, 112, 127, 128, 129, 1000];
  for GI := 0 to 5 do
    GRun := GSizes[GI];
    println("a x {} {}", GRun, Digest(StringOfChar('a', GRun)));
  end;

  // the same digest whatever the pieces, across the block edges
  GText := StringOfChar('a', 1000);
  println("pieces 1 {}", InPieces(GText, 1));
  println("pieces 7 {}", InPieces(GText, 7));
  println("pieces 128 {}", InPieces(GText, 128));

  // Final starts the hasher over: the same input gives the same digest again
  GHash := Hasher(HashKind.SHA512);
  GHash.Update("abc");
  GFirst := DigestToHex(GHash.Final());
  GHash.Update("abc");
  println("again {}", DigestToHex(GHash.Final()) = GFirst);

  // Update over memory: a buffer a C library or a file read filled
  setlength(GBytes, 3);
  GBytes[0] := 0x61;
  GBytes[1] := 0x62;
  GBytes[2] := 0x63;
  GHash.Update(addr of GBytes[0], 3);
  println("memory {}", DigestToHex(GHash.Final()) = GFirst);

  println("size {}", len(ComputeHash(HashKind.SHA512, GBytes)));
  println("kind {}", nameof(GHash.Kind()));
  println("utf8 {}", Digest("Adam ü€"));
end.
