  | ok llround
  | ok llroundf
  | ok log
  | ok logf
  | ok log10
  | ok log10f
  | ok log1p
  | ok log1pf
  | ok log2
  | ok log2f
  | ok logb
  | ok logbf
  | ok lrint
  | ok lrintf
  | ok lround
  | ok lroundf
  | ok modf
  | ok modff
  | ok nan
  | ok nanf
  | ok nearbyint
  | ok nearbyintf
  | ok nextafter
  | ok nextafterf
  | ok pow
  | ok powf
  | ok remainder
  | ok remainderf
  | ok remquo
  | ok remquof
  | ok rint
  | ok rintf
  | ok round
  | ok roundf
  | ok scalbln
  | ok scalblnf
  | ok scalbn
  | ok scalbnf
  | ok sin
  | ok sinf
  | ok sinh
  | ok sinhf
  | ok sqrt
  | ok sqrtf
  | ok tan
  | ok tanf
  | ok tanh
  | ok tanhf
