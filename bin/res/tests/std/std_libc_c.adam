module exe std_libc_c;

import System.LibC.C;

var
  GFails: int32;
  GExp: int32;
  GQuo: int32;
  GSign: int32;
  GInt: float64;
  GIntF: float32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// Within 1e-12 of AWant, relative past 1
routine Near(const AGot: float64; const AWant: float64): bool;
begin
  return fabs(AGot - AWant) <= 1.0e-12 * fmax(1.0, fabs(AWant));
end;

// A float32 result within 1e-5 of AWant, relative past 1
routine NearF(const AGot: float32; const AWant: float64): bool;
begin
  return fabs(float64(AGot) - AWant) <= 1.0e-5 * fmax(1.0, fabs(AWant));
end;

// A NaN is the one value unequal to itself
routine IsNaN(const AX: float64): bool;
begin
  return AX <> AX;
end;

begin
  GFails := 0;
  Check("acos", Near(acos(0.5), 1.0471975511965979));
  Check("acosf", NearF(acosf(0.5f), 1.0471975511965979));
  Check("acosh", Near(acosh(2.0), 1.3169578969248166));
  Check("acoshf", NearF(acoshf(2.0f), 1.3169578969248166));
  Check("asin", Near(asin(0.5), 0.5235987755982989));
  Check("asinf", NearF(asinf(0.5f), 0.5235987755982989));
  Check("asinh", Near(asinh(1.0), 0.881373587019543));
  Check("asinhf", NearF(asinhf(1.0f), 0.881373587019543));
  Check("atan", Near(atan(1.0), 0.7853981633974483));
  Check("atanf", NearF(atanf(1.0f), 0.7853981633974483));
  Check("atan2", Near(atan2(1.0, 2.0), 0.4636476090008061));
  Check("atan2f", NearF(atan2f(1.0f, 2.0f), 0.4636476090008061));
  Check("atanh", Near(atanh(0.5), 0.5493061443340548));
  Check("atanhf", NearF(atanhf(0.5f), 0.5493061443340548));
  Check("cbrt", Near(cbrt(27.0), 3.0));
  Check("cbrtf", NearF(cbrtf(27.0f), 3.0));
  Check("ceil", Near(ceil(2.25), 3.0));
  Check("ceilf", NearF(ceilf(2.25f), 3.0));
  Check("copysign", Near(copysign(3.0, -1.0), -3.0));
  Check("copysignf", NearF(copysignf(3.0f, -1.0f), -3.0));
  Check("cos", Near(cos(1.0), 0.5403023058681398));
  Check("cosf", NearF(cosf(1.0f), 0.5403023058681398));
  Check("cosh", Near(cosh(1.0), 1.5430806348152437));
  Check("coshf", NearF(coshf(1.0f), 1.5430806348152437));
  Check("erf", Near(erf(0.5), 0.5204998778130465));
  Check("erff", NearF(erff(0.5f), 0.5204998778130465));
  Check("erfc", Near(erfc(0.5), 0.4795001221869535));
  Check("erfcf", NearF(erfcf(0.5f), 0.4795001221869535));
  Check("exp", Near(exp(1.0), 2.718281828459045));
  Check("expf", NearF(expf(1.0f), 2.718281828459045));
  Check("exp2", Near(exp2(10.0), 1024.0));
  Check("exp2f", NearF(exp2f(10.0f), 1024.0));
  Check("expm1", Near(expm1(0.25), 0.2840254166877415));
  Check("expm1f", NearF(expm1f(0.25f), 0.2840254166877415));
  Check("fabs", Near(fabs(-2.5), 2.5));
  Check("fabsf", NearF(fabsf(-2.5f), 2.5));
  Check("fdim", Near(fdim(5.0, 3.0), 2.0));
  Check("fdimf", NearF(fdimf(5.0f, 3.0f), 2.0));
  Check("floor", Near(floor(-2.5), -3.0));
  Check("floorf", NearF(floorf(-2.5f), -3.0));
  Check("fma", Near(fma(2.0, 3.0, 4.0), 10.0));
  Check("fmaf", NearF(fmaf(2.0f, 3.0f, 4.0f), 10.0));
  Check("fmax", Near(fmax(2.0, 3.0), 3.0));
  Check("fmaxf", NearF(fmaxf(2.0f, 3.0f), 3.0));
  Check("fmin", Near(fmin(2.0, 3.0), 2.0));
  Check("fminf", NearF(fminf(2.0f, 3.0f), 2.0));
  Check("fmod", Near(fmod(7.5, 2.0), 1.5));
  Check("fmodf", NearF(fmodf(7.5f, 2.0f), 1.5));
  Check("frexp", Near(frexp(8.0, addr of GExp), 0.5) and (GExp = 4));
  Check("frexpf", NearF(frexpf(8.0f, addr of GExp), 0.5) and (GExp = 4));
  Check("hypot", Near(hypot(3.0, 4.0), 5.0));
  Check("hypotf", NearF(hypotf(3.0f, 4.0f), 5.0));
  Check("ilogb", ilogb(1024.0) = 10);
  Check("ilogbf", ilogbf(1024.0f) = 10);
  Check("ldexp", Near(ldexp(0.75, 4), 12.0));
  Check("ldexpf", NearF(ldexpf(0.75f, 4), 12.0));
  Check("lgamma", Near(lgamma(5.0), 3.178053830347945));
  Check("lgammaf", NearF(lgammaf(5.0f), 3.178053830347945));
  Check("llrint", llrint(2.5) = 2);
  Check("llrintf", llrintf(3.5f) = 4);
  Check("llround", llround(2.5) = 3);
  Check("llroundf", llroundf(-2.5f) = -3);
  Check("log", Near(log(10.0), 2.302585092994046));
  Check("logf", NearF(logf(10.0f), 2.302585092994046));
  Check("log10", Near(log10(1000.0), 3.0));
  Check("log10f", NearF(log10f(1000.0f), 3.0));
  Check("log1p", Near(log1p(0.25), 0.22314355131420976));
  Check("log1pf", NearF(log1pf(0.25f), 0.22314355131420976));
  Check("log2", Near(log2(1024.0), 10.0));
  Check("log2f", NearF(log2f(1024.0f), 10.0));
  Check("logb", Near(logb(1024.0), 10.0));
  Check("logbf", NearF(logbf(1024.0f), 10.0));
  Check("lrint", lrint(3.5) = 4);
  Check("lrintf", lrintf(2.5f) = 2);
  Check("lround", lround(-2.5) = -3);
  Check("lroundf", lroundf(2.5f) = 3);
  Check("modf", Near(modf(3.25, addr of GInt), 0.25) and Near(GInt, 3.0));
  Check("modff", NearF(modff(3.25f, addr of GIntF), 0.25) and NearF(GIntF, 3.0));
  Check("nan", IsNaN(nan(ptr to const char(""))));
  Check("nanf", IsNaN(nanf(ptr to const char(""))));
  Check("nearbyint", Near(nearbyint(2.5), 2.0));
  Check("nearbyintf", NearF(nearbyintf(2.5f), 2.0));
  Check("nextafter", nextafter(1.0, 2.0) = 1.0 + ldexp(1.0, -52));
  Check("nextafterf", nextafterf(1.0f, 2.0f) = 1.0f + ldexpf(1.0f, -23));
  Check("pow", Near(pow(2.0, 0.5), 1.4142135623730951));
  Check("powf", NearF(powf(2.0f, 0.5f), 1.4142135623730951));
  Check("remainder", Near(remainder(7.0, 2.0), -1.0));
  Check("remainderf", NearF(remainderf(7.0f, 2.0f), -1.0));
  Check("remquo", Near(remquo(7.0, 2.0, addr of GQuo), -1.0) and (GQuo = 4));
  Check("remquof", NearF(remquof(7.0f, 2.0f, addr of GQuo), -1.0) and (GQuo = 4));
  Check("rint", Near(rint(2.5), 2.0));
  Check("rintf", NearF(rintf(2.5f), 2.0));
  Check("round", Near(round(2.5), 3.0));
  Check("roundf", NearF(roundf(2.5f), 3.0));
  Check("scalbln", Near(scalbln(1.0, 10), 1024.0));
  Check("scalblnf", NearF(scalblnf(1.0f, 10), 1024.0));
  Check("scalbn", Near(scalbn(1.0, -1), 0.5));
  Check("scalbnf", NearF(scalbnf(1.0f, -1), 0.5));
  Check("sin", Near(sin(1.0), 0.8414709848078965));
  Check("sinf", NearF(sinf(1.0f), 0.8414709848078965));
  Check("sinh", Near(sinh(1.0), 1.1752011936438014));
  Check("sinhf", NearF(sinhf(1.0f), 1.1752011936438014));
  Check("sqrt", Near(sqrt(2.0), 1.4142135623730951));
  Check("sqrtf", NearF(sqrtf(2.0f), 1.4142135623730951));
  Check("tan", Near(tan(1.0), 1.5574077246549023));
  Check("tanf", NearF(tanf(1.0f), 1.5574077246549023));
  Check("tanh", Near(tanh(0.5), 0.46211715726000974));
  Check("tanhf", NearF(tanhf(0.5f), 0.46211715726000974));
  Check("tgamma", Near(tgamma(5.0), 24.0));
  Check("tgammaf", NearF(tgammaf(5.0f), 24.0));
  Check("trunc", Near(trunc(-2.7), -2.0));
  Check("truncf", NearF(truncf(-2.7f), -2.0));
  Check("j0", Near(j0(1.0), 0.7651976865579666));
  Check("j1", Near(j1(1.0), 0.4400505857449335));
  Check("jn", Near(jn(2, 1.0), 0.11490348493190047));
  Check("y0", Near(y0(1.0), 0.08825696421567696));
  Check("y1", Near(y1(1.0), -0.7812128213002887));
  Check("yn", Near(yn(2, 1.0), -1.6506826068162543));
  Check("drem", Near(drem(7.0, 2.0), -1.0));
  Check("dremf", NearF(dremf(7.0f, 2.0f), -1.0));
  Check("finite", (finite(1.0) <> 0) and (finite(HUGE_VAL) = 0));
  Check("finitef", (finitef(1.0f) <> 0) and (finitef(INFINITY) = 0));
  Check("scalb", Near(scalb(1.0, 10.0), 1024.0));
  Check("scalbf", NearF(scalbf(1.0f, 10.0f), 1024.0));
  Check("significand", Near(significand(12.0), 1.5));
  Check("significandf", NearF(significandf(12.0f), 1.5));
  Check("lgamma_r", Near(lgamma_r(-0.5, addr of GSign), 1.265512123484645) and (GSign = -1));
  Check("lgammaf_r", NearF(lgammaf_r(-0.5f, addr of GSign), 1.265512123484645) and (GSign = -1));
  Check("j0f", NearF(j0f(1.0f), 0.7651976865579666));
  Check("j1f", NearF(j1f(1.0f), 0.4400505857449335));
  Check("jnf", NearF(jnf(2, 1.0f), 0.11490348493190047));
  Check("y0f", NearF(y0f(1.0f), 0.08825696421567696));
  Check("y1f", NearF(y1f(1.0f), -0.7812128213002887));
  Check("ynf", NearF(ynf(2, 1.0f), -1.6506826068162543));
  Check("exp10", Near(exp10(3.0), 1000.0));
  Check("exp10f", NearF(exp10f(3.0f), 1000.0));
  Check("pow10", Near(pow10(2.0), 100.0));
  Check("pow10f", NearF(pow10f(2.0f), 100.0));
  Check("M_PI", Near(M_PI, 4.0 * atan(1.0)));
  Check("M_E", Near(M_E, exp(1.0)));
  Check("M_SQRT2", Near(M_SQRT2, sqrt(2.0)));
  Check("NAN", IsNaN(float64(NAN)));
  Check("INFINITY", (INFINITY > HUGE) and (HUGE_VAL = float64(HUGE_VALF)));
  Check("FP_ILOGBNAN", ilogb(float64(NAN)) = FP_ILOGBNAN);
  Check("FP_ILOGB0", ilogb(0.0) = FP_ILOGB0);
  println("done {}", GFails);
end.
