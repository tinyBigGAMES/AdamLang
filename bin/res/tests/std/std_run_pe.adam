-------------------------------------------------------------------------------
  std_run_pe.adam - System.Process' RunPE capture form over pipes
  (StdApp.Utils' CaptureConsoleOutput): std_run_pe_sample's lines one by
  one, CR LF / CR / LF each ending a line, the empty line kept, its stderr
  line in the order written, the text after the last line end handed over
  as the last line (the sample's "four" has no end, so its own debug heap
  report's line joins it, as a terminal would show it), its exit code; a
  host's StdInput as the program's stdin (a file: its end is the program's
  end of input), the host never started or stopped (pipes); no host: NUL
  (echo reads nothing: its one line is its own debug heap report's); a program that is no file: false, exit code 0,
  nothing handed over. The heap report proves the runs leave nothing.
*******************************************************************************/

/*
@@test
  kind run
  deps std.std_run_pe_sample
  args "<OUT>/bin/<CELL>/std_run_pe_sample.exe"
  exitcode 0
  | lines started true exit 7
  |   [one]
  |   [two]
  |   [three]
  |   []
  |   [err line]
  |   [four[Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0]
  | echo started true exit 3
  |   [in: alpha]
  |   [in: beta]
  |   [in: last no end]
  |   [[Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0]
  |   host starts 0 stops 0
  | no host started true exit 3 lines 1
  | missing started false exit 0 lines 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_run_pe;

import System.SysUtils, System.Windows.SDK, System.Windows, System.IO, System.Process;

type
  // Every line handed over, in order
  Lines = object implements ProcessOutput
    Items: StringArray;

    virtual method Output(const AText: string);
    var
      LCount: int64;
    begin
      LCount := len(self.Items);
      setlength(self.Items, LCount + 1);
      self.Items[LCount] := AText;
    end;
  end;

  // A host whose stdin is an open file; counts its starts and stops
  FileHost = object implements ProcessHost
    Input: uint64;
    Starts: int32;
    Stops: int32;

    virtual method InitialSize(var ACols: int32; var ARows: int32): bool;
    begin
      return false;
    end;

    virtual method StdInput(): uint64;
    begin
      return self.Input;
    end;

    virtual method Start(const ATerminal: ref ProcessTerminal): bool;
    begin
      self.Starts := self.Starts + 1;
      return true;
    end;

    virtual method Stop();
    begin
      self.Stops := self.Stops + 1;
    end;
  end;

var
  GSample: string;
  GArgs: StringArray;
  GLines: ref Lines;
  GHost: ref FileHost;
  GExit: uint32;
  GStarted: bool;
  GName: own WideBox;
  GAttributes: SECURITY_ATTRIBUTES;

func Show(const ATitle: string);
var
  LI: int64;
begin
  println("{} started {} exit {}", ATitle, GStarted, GExit);
  for LI := 0 to len(GLines.Items) - 1 do
    println("  [{}]", GLines.Items[LI]);
  end;
end;

begin
  GSample := paramstr(1);
  setlength(GArgs, 1);

  GArgs[0] := "lines";
  GLines := ref Lines();
  GStarted := RunPE(GSample, GArgs, "", GExit, GLines, ProcessCapture.Pipes, nil);
  Show("lines");

  // stdin from a file the host holds open
  WriteAllText("std_run_pe_input.txt", "alpha\r\nbeta\nlast no end");
  GName := own WideBox();
  UTF8ToWide("std_run_pe_input.txt", GName.Data);
  GAttributes.nLength := uint32(size(SECURITY_ATTRIBUTES));
  GHost := ref FileHost();
  GHost.Input := CreateFileW(GName.Data, GENERIC_READ, FILE_SHARE_READ, GAttributes,
    OPEN_EXISTING, 0, 0);
  GArgs[0] := "echo";
  GLines := ref Lines();
  GStarted := RunPE(GSample, GArgs, "", GExit, GLines, ProcessCapture.Pipes, GHost);
  Show("echo");
  println("  host starts {} stops {}", GHost.Starts, GHost.Stops);
  CloseHandle(GHost.Input);
  DeleteFile("std_run_pe_input.txt");

  GLines := ref Lines();
  GStarted := RunPE(GSample, GArgs, "", GExit, GLines, ProcessCapture.Pipes, nil);
  println("no host started {} exit {} lines {}", GStarted, GExit, len(GLines.Items));

  GExit := 99;
  GLines := ref Lines();
  GStarted := RunPE(ExtractFileDir(GSample) + "/std_run_pe_none.exe", GArgs, "", GExit, GLines,
    ProcessCapture.Pipes, nil);
  println("missing started {} exit {} lines {}", GStarted, GExit, len(GLines.Items));
end.
