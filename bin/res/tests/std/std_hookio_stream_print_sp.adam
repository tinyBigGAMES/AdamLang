-------------------------------------------------------------------------------
  std_hookio_stream_print_sp.adam - ucrt's validating and positional print
  forms System.HookIO.Win64 parses as ucrt's output processors do
  (PLAN-LINUX64 LX3d3c2e): __stdio_common_vfprintf_s / _p and
  __stdio_common_vfwprintf_s / _p, and the standard form's refused size
  letters. Every format the validation refuses (%n, a format ending inside
  a conversion, a flag after the width, a digit after a size letter, a
  second size letter, 'N', '%' inside a conversion, an unknown letter, a
  size with no integer size), the positional parameters (%N$ in any order,
  '*' widths and precisions by index, literals before the first one, %%,
  a format with no conversion, a nonpositional format, a '+' read into an
  index) and the ones it refuses (a mix of both kinds, a missing position,
  a parameter named with two types or sizes, index 0, past _ARGMAX, past
  long's range), on a handle over a memory IO and on a real file beside
  the program: every print's count, errno, the parameter checks it failed
  (a thread's invalid parameter handler counts them) and the bytes
  written equal the real file's.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok sp ran
  | ok sp as real file
  | ok sp positional text
  | ok sp refused n
  | ok sp unregister
  | ok sp io close
  | ok sp real removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_print_sp;

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO, System.HookIO.Win64;

// ucrt's handler of a failed parameter check for this thread (it comes before the process's)
func _set_thread_local_invalid_parameter_handler(const AHandler: func(
  const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64)): ptr;
  external "ucrtbase";

const
  // The slots Steps fills: three per print, the file's size, its bytes
  CSlots: int32 = 1300;
  // The first slot of the file's bytes, and how many are compared
  CBytesAt: int32 = 200;
  CBytes: int32 = 1024;

var
  GFails: int32;
  // The failed parameter checks so far
  GInvalid: int64;
  // Where Steps puts its next slot
  GResults: ptr to int64;
  GAt: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The thread's invalid parameter handler: counts the call and returns (the call then returns
// its failure)
func OnInvalid(const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64);
begin
  GInvalid := GInvalid + 1;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
func SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// AText as UTF-16 with its terminating 0 unit
func WideText(const AText: string): wstring;
var
  LWide: wstring;
  LAt: int64;
  LIndex: int64;
  LCode: uint32;
begin
  setlength(LWide, (len(AText) * 2) + 2);
  LAt := 0;
  LIndex := 0;
  while LIndex < len(AText) do
    LCode := DecodeUTF8Char(AText, LIndex);
    EncodeUTF16Char(LWide, LAt, LCode);
  end;
  EncodeUTF16Char(LWide, LAt, 0);
  setlength(LWide, LAt);
  return LWide;
end;

// The standard form over this routine's own variadic arguments
func Print(const AFile: ptr; const AFormat: ptr to const char; ...): int32;
begin
  return __stdio_common_vfprintf(0, AFile, AFormat, nil, varargs.clist());
end;

// The validating form (fprintf_s)
func PrintS(const AFile: ptr; const AFormat: ptr to const char; ...): int32;
begin
  return __stdio_common_vfprintf_s(0, AFile, AFormat, nil, varargs.clist());
end;

// The positional form (_fprintf_p)
func PrintP(const AFile: ptr; const AFormat: ptr to const char; ...): int32;
begin
  return __stdio_common_vfprintf_p(0, AFile, AFormat, nil, varargs.clist());
end;

// The wide validating form (fwprintf_s)
func WidePrintS(const AFile: ptr; const AFormat: ptr to const wchar; ...): int32;
begin
  return __stdio_common_vfwprintf_s(0, AFile, AFormat, nil, varargs.clist());
end;

// The wide positional form (_fwprintf_p)
func WidePrintP(const AFile: ptr; const AFormat: ptr to const wchar; ...): int32;
begin
  return __stdio_common_vfwprintf_p(0, AFile, AFormat, nil, varargs.clist());
end;

// AValue into the next slot
func Put(const AValue: int64);
begin
  GResults[GAt] := AValue;
  GAt := GAt + 1;
end;

// A print begins: errno 0, the failed checks so far
func Start(): int64;
begin
  SetCErrno(0);
  return GInvalid;
end;

// A print's slots: its count, errno, the failed parameter checks since ABefore
func Answer(const ACount: int32; const ABefore: int64);
begin
  Put(int64(ACount));
  Put(int64(CErrno()));
  Put(GInvalid - ABefore);
end;

// C's truth value of AFlag
func Flag(const AFlag: bool): int64;
begin
  if AFlag then
    return 1;
  end;
  return 0;
end;

// The narrow validating prints
func StepsValidation(const AFile: ptr);
var
  LBefore: int64;
  LCount: int32;
begin
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("a%d-%s|%5.2f|%%|%-6x|%+i\n"), 42,
    ptr to const char("xy"), 3.14159, 255, 7), LBefore);
  LCount := -5;
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("xy%n"), addr of LCount), LBefore);
  Put(int64(LCount));
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("ab%")), LBefore);
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("c%5")), LBefore);
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("d%5-d"), 1), LBefore);
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("e%l5d"), 1), LBefore);
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("f%Nd"), 1), LBefore);
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("g%5%"), 1), LBefore);
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("h%k"), 1), LBefore);
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("i%Ld"), 1), LBefore);
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("j%hld"), 1), LBefore);
  LBefore := Start();
  Answer(PrintS(AFile, ptr to const char("k%.%"), 1), LBefore);
end;

// The standard form's failed parameter checks ('N', a second size letter) and what it reads
// where the validation refuses
func StepsStandard(const AFile: ptr);
var
  LBefore: int64;
begin
  LBefore := Start();
  Answer(Print(AFile, ptr to const char("l%Nd"), 1), LBefore);
  LBefore := Start();
  Answer(Print(AFile, ptr to const char("m%hld"), 1), LBefore);
  LBefore := Start();
  Answer(Print(AFile, ptr to const char("n%5%|%5-d|\n"), 3), LBefore);
end;

// The narrow positional prints
func StepsPositional(const AFile: ptr);
var
  LBefore: int64;
begin
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("%2$s %1$d\n"), 7, ptr to const char("hi")), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("%1$*2$d|%1$-*3$d|\n"), 42, 6, 5), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("pre%2$d %1$d\n"), 1, 2), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("o%1$d %d"), 1, 2), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("p%d %1$d"), 5, 6), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("q%1$d %3$d"), 1, 2, 3), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("r%1$d %1$s"), 1), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("s%1$lld %1$d"), int64(1)), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("t%0$d"), 1), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("u%101$d"), 1), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("%d+%s\n"), 9, ptr to const char("z")), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("v%1$d%%%2$c\n"), 4, int32(81)), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("w100%% plain\n")), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("x%1$p %1$x"), ptr(addr of GAt)), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("%1$.3f %2$e\n"), 1.5, 2.25), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("%1$.*2$f|%3$#o\n"), 3.14159, 2, 8), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("%1$d %+2$d\n"), 3, 4), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("y%99999999999d"), 1), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("z%1$d %99999999999$d"), 1), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("A%1$Ld"), 1), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("B%2$d"), 1, 2), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("C%1$n"), addr of GAt), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("D%1$*1$d"), 4), LBefore);
  LBefore := Start();
  Answer(PrintP(AFile, ptr to const char("E%1$s %1$5s\n"), ptr to const char("ok")), LBefore);
end;

// The wide validating and positional prints
func StepsWide(const AFile: ptr);
var
  LBefore: int64;
  LCount: int32;
  LPlain: wstring;
  LCounted: wstring;
  LFlagLate: wstring;
  LOrdered: wstring;
  LMixed: wstring;
  LWord: wstring;
  LOther: wstring;
begin
  LPlain := WideText("w%d %ls|%3c\n");
  LCounted := WideText("w%n");
  LFlagLate := WideText("w%5-d");
  LOrdered := WideText("%2$ls %1$d\n");
  LMixed := WideText("w%1$d %1$ls");
  LWord := WideText("uv");
  LOther := WideText("ab");
  LBefore := Start();
  Answer(WidePrintS(AFile, addr of LPlain[0], 5, addr of LWord[0], int32(87)), LBefore);
  LCount := -5;
  LBefore := Start();
  Answer(WidePrintS(AFile, addr of LCounted[0], addr of LCount), LBefore);
  Put(int64(LCount));
  LBefore := Start();
  Answer(WidePrintS(AFile, addr of LFlagLate[0], 1), LBefore);
  LBefore := Start();
  Answer(WidePrintP(AFile, addr of LOrdered[0], 8, addr of LOther[0]), LBefore);
  LBefore := Start();
  Answer(WidePrintP(AFile, addr of LMixed[0], 1), LBefore);
end;

// Every print on the stream opened at APath (w+b), its slots in AResults, then the file's
// size and bytes
func Steps(const APath: string; const AResults: ptr to int64);
var
  LFile: ptr;
  LBuffer: array[0..1023] of uint8;
  LSize: int64;
  LI: int32;
begin
  for LI := 0 to CSlots - 1 do
    AResults[LI] := -99;
  end;
  GResults := AResults;
  GAt := 0;
  LFile := fopen(APath, ptr to const char("w+b"));
  Put(Flag(LFile <> nil));
  if LFile = nil then
    return;
  end;
  StepsValidation(LFile);
  StepsStandard(LFile);
  StepsPositional(LFile);
  StepsWide(LFile);
  // the file's bytes
  GAt := CBytesAt;
  Put(int64(fflush(LFile)));
  Put(int64(fseek(LFile, 0, 2)));
  LSize := int64(ftell(LFile));
  Put(LSize);
  Put(int64(fseek(LFile, 0, 0)));
  for LI := 0 to CBytes - 1 do
    LBuffer[LI] := 0;
  end;
  Put(fread(addr of LBuffer[0], 1, CBytes, LFile));
  for LI := 0 to CBytes - 1 do
    Put(int64(LBuffer[LI]));
  end;
  Put(int64(fclose(LFile)));
end;

// Deletes the file at APath; false when it is not deleted
func RemovePath(const APath: string): bool;
var
  LOk: bool;
begin
  LOk := RemoveFile(APath);
  return LOk;
end;

// The prints on a handle over a memory IO and on a real file: every slot equal
func TestPrintSp();
var
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..1299] of int64;
  LReal: array[0..1299] of int64;
begin
  LRealPath := paramstr(0) + ".sp.bin";
  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  RemovePath(LRealPath);
  Steps(LPrefix + "/s.bin", addr of LVirtual[0]);
  Steps(LRealPath, addr of LReal[0]);
  Check("sp ran", (LVirtual[0] = 1) and (LReal[0] = 1) and (LReal[CBytesAt + 1] = 0));
  Check("sp as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], CSlots));
  // the first positional print, "%2$s %1$d\n" over 7 and "hi": 5 units, no errno, no check
  Check("sp positional text", (LReal[47] = 5) and (LReal[48] = 0) and (LReal[49] = 0));
  // the refused "xy%n" (validation): -1, EINVAL, one failed check, the count untouched
  Check("sp refused n", (LReal[4] = -1) and (LReal[5] = 22) and (LReal[6] = 1) and
    (LReal[7] = -5));
  Check("sp unregister", UnregisterIO(LPrefix));
  Check("sp io close", IOClose(LMemory));
  Check("sp real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  GInvalid := 0;
  _set_thread_local_invalid_parameter_handler(OnInvalid);
  TestPrintSp();
  println("done {}", GFails);
end.
