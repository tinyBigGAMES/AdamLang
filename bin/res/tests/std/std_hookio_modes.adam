  | ok mode 'at+'
  | ok mode 'wt'
  | ok mode 'at'
  | ok mode 'wxb'
  | ok mode 'wtx'
  | ok mode '  rb'
  | ok mode 'r b'
  | ok mode 'rb '
  | ok mode 'r b '
  | ok mode 'rbt'
  | ok mode 'rbb'
  | ok mode 'rtt'
  | ok mode 'rc'
  | ok mode 'rn'
  | ok mode 'rcn'
  | ok mode 'rcc'
  | ok mode 'rS'
  | ok mode 'rR'
  | ok mode 'rSR'
  | ok mode 'rRR'
  | ok mode 'rT'
  | ok mode 'rTT'
  | ok mode 'rN'
  | ok mode 'rNN'
  | ok mode 'rbcSTN'
  | ok mode 'rDD'
  | ok mode 'rD'
  | ok mode 'rbD'
