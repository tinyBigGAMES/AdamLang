-------------------------------------------------------------------------------
  std_hookio_modes.adam - System.HookIO's mode strings (PaskalCPP's
  std_hookio TestModes)

  Every mode string ucrt's fopen parses, opened from C (the fixture's
  std_hookio_c_mode) on a folder-source entry (mode.v in the exe's folder)
  and on a real file beside it (mode.r): first with both holding "a\r\nb"
  and a Ctrl-Z (a text read gives "a\nb" and stops at the Ctrl-Z; a text
  open with + drops it), then with both missing. Every slot (opened,
  errno, the read, ftell, fputc, ferror, fclose) and the bytes left behind
  equal the real file's; one ok line per mode, each failed check of a mode
  printed as its own FAIL line. Then x on a registered IO (always there:
  EEXIST). The ccs= opens wait for the wide streams.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok modes folder
  | ok modes source
  | ok mode 'r'
  | ok mode 'rb'
  | ok mode 'rt'
  | ok mode 'r+'
  | ok mode 'r+b'
  | ok mode 'rb+'
  | ok mode 'w+'
  | ok mode 'w+b'
  | ok mode 'wb+'
  | ok mode 'a+'
  | ok mode 'a+b'
  | ok mode 'ab+'
  | ok mode 'w+x'
  | ok mode 'a+x'
  | ok mode 'w'
  | ok mode 'wb'
  | ok mode 'a'
  | ok mode 'ab'
  | ok mode 'wx'
  | ok mode 'wbx'
  | ok mode 'ax'
  | ok mode 'rx'
  | ok mode 'r+x'
  | ok mode ' r'
  | ok mode 'rq'
  | ok mode 'r++'
  | ok mode 'rtb'
  | ok mode 'R'
  | ok mode 'x'
  | ok mode ''
  | ok mode 'r+t'
  | ok mode 'rt+'
  | ok mode 'w+t'
  | ok mode 'wt+'
  | ok mode 'a+t'
  | ok mode 'at+'
  | ok mode 'wt'
  | ok mode 'at'
  | ok mode 'wxb'
  | ok mode 'wtx'
  | ok mode '  rb'
  | ok mode 'r b'
  | ok mode 'rb '
  | ok mode 'r b '
  | ok mode 'rbt'
  | ok mode 'rbb'
  | ok mode 'rtt'
  | ok mode 'rc'
  | ok mode 'rn'
  | ok mode 'rcn'
  | ok mode 'rcc'
  | ok mode 'rS'
  | ok mode 'rR'
  | ok mode 'rSR'
  | ok mode 'rRR'
  | ok mode 'rT'
  | ok mode 'rTT'
  | ok mode 'rN'
  | ok mode 'rNN'
  | ok mode 'rbcSTN'
  | ok mode 'rDD'
  | ok mode 'rD'
  | ok mode 'rbD'
  | ok mode 'rtD'
  | ok mode 'r+D'
  | ok mode 'wD'
  | ok mode 'wbD'
  | ok mode 'w+D'
  | ok mode 'w+tD'
  | ok mode 'aD'
  | ok mode 'a+D'
  | ok mode 'wxD'
  | ok mode 'r,'
  | ok mode 'r,ccs'
  | ok mode 'r, ccs = FOO'
  | ok mode 'r,ccx=UTF-8'
  | ok mode 'r,CCS=UTF-8'
  | ok mode 'r,ccs=UTF-8x'
  | ok mode 'wx' registered EEXIST
  | ok modes memory unregister
  | ok modes memory close
  | ok modes unregister
  | ok modes source close
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_modes;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

routine clink std_hookio_c_dirlen(APath: ptr to const char): clong; external "std_hookio_c";
routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_samebytes(AFirst: ptr to const char; ASecond: ptr to const char):
  int32; external "std_hookio_c";
routine clink std_hookio_c_mode(APath: ptr to const char; AMode: ptr to const char;
  AResults: ptr to int64); external "std_hookio_c";

const
  // std_hookio_c_mode's result slots
  CSlots: int32 = 9;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// One check of a case: nothing when it held, else a FAIL line naming it, counted in ABad
routine Part(const AName: string; const APart: string; const AOk: bool; var ABad: int32);
begin
  if not AOk then
    println("FAIL {} {}", AName, APart);
    ABad := ABad + 1;
  end;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// The length of APath's folder part (the C fixture's); -1 when it has none
routine DirLength(const APath: string): int64;
var
  LPath: ptr to char;
  LResult: clong;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_dirlen(LPath);
  freemem(LPath);
  return int64(LResult);
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// Deletes the file at APath; false when it is not deleted (it may not be there)
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// True when the two real files hold the same bytes, or neither exists (the C fixture's)
routine SameBytes(const AFirst: string; const ASecond: string): bool;
var
  LFirst: ptr to char;
  LSecond: ptr to char;
  LResult: int32;
begin
  LFirst := StringToC(AFirst);
  LSecond := StringToC(ASecond);
  LResult := std_hookio_c_samebytes(LFirst, LSecond);
  freemem(LFirst);
  freemem(LSecond);
  return LResult = 1;
end;

// The C fixture's open of APath in AMode and what the handle then allows: its slots in
// AResults
routine ModeC(const APath: string; const AMode: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_mode(LPath, LMode, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// One mode string: the entry APrefix/mode.v (the file AFolder/mode.v) against the real file
// AFolder/mode.r, both present with the sample, then both missing
routine CheckMode(const APrefix: string; const AFolder: string; const AMode: string);
var
  LSample: array[0..4] of uint8;
  LVirtualFile: string;
  LRealFile: string;
  LName: string;
  LPass: string;
  LVirtual: array[0..8] of int64;
  LReal: array[0..8] of int64;
  LRound: int32;
  LBad: int32;
begin
  LBad := 0;
  LName := "mode '" + AMode + "'";
  LSample[0] := uint8('a');
  LSample[1] := 13;
  LSample[2] := 10;
  LSample[3] := uint8('b');
  LSample[4] := 26;
  LVirtualFile := AFolder + "/mode.v";
  LRealFile := AFolder + "/mode.r";
  for LRound := 0 to 1 do
    RemovePath(LVirtualFile);
    RemovePath(LRealFile);
    LPass := "missing";
    if LRound = 0 then
      LPass := "present";
      Part(LName, "present io file", WriteRaw(LVirtualFile, addr of LSample[0], 5), LBad);
      Part(LName, "present real file", WriteRaw(LRealFile, addr of LSample[0], 5), LBad);
    end;
    ModeC(APrefix + "/mode.v", AMode, addr of LVirtual[0]);
    ModeC(LRealFile, AMode, addr of LReal[0]);
    Part(LName, LPass + " as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], CSlots),
      LBad);
    Part(LName, LPass + " bytes as real file", SameBytes(LVirtualFile, LRealFile), LBad);
  end;
  RemovePath(LVirtualFile);
  RemovePath(LRealFile);
  if LBad = 0 then
    println("ok {}", LName);
  end;
  GFails := GFails + LBad;
end;

// Mode strings as ucrt's fopen parses them, every one against a real fopen of the same string
// on a file of the same bytes in the same folder: the accepted forms, the refused ones
// (EINVAL), x (EEXIST when the file is there), spaces, text forms, each flag's once-only rule,
// the hints, D (the file gone after the close), the encoding part's own refusals. Then x on a
// registered IO
routine TestModes();
var
  LExe: string;
  LFolder: string;
  LLength: int64;
  LSource: IOSource;
  LPrefix: string;
  LMemory: IO;
  LMemoryPrefix: string;
  LVirtual: array[0..8] of int64;
begin
  LExe := paramstr(0);
  LLength := DirLength(LExe);
  Check("modes folder", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LFolder := Substring(LExe, 0, LLength);
  LSource := CreateFolderIOSource(LFolder);
  LPrefix := RegisterIOSource(LSource);
  Check("modes source", (LSource <> nil) and (LPrefix <> ""));

  CheckMode(LPrefix, LFolder, "r");
  CheckMode(LPrefix, LFolder, "rb");
  CheckMode(LPrefix, LFolder, "rt");
  CheckMode(LPrefix, LFolder, "r+");
  CheckMode(LPrefix, LFolder, "r+b");
  CheckMode(LPrefix, LFolder, "rb+");
  CheckMode(LPrefix, LFolder, "w+");
  CheckMode(LPrefix, LFolder, "w+b");
  CheckMode(LPrefix, LFolder, "wb+");
  CheckMode(LPrefix, LFolder, "a+");
  CheckMode(LPrefix, LFolder, "a+b");
  CheckMode(LPrefix, LFolder, "ab+");
  CheckMode(LPrefix, LFolder, "w+x");
  CheckMode(LPrefix, LFolder, "a+x");
  CheckMode(LPrefix, LFolder, "w");
  CheckMode(LPrefix, LFolder, "wb");
  CheckMode(LPrefix, LFolder, "a");
  CheckMode(LPrefix, LFolder, "ab");
  CheckMode(LPrefix, LFolder, "wx");
  CheckMode(LPrefix, LFolder, "wbx");
  CheckMode(LPrefix, LFolder, "ax");
  CheckMode(LPrefix, LFolder, "rx");
  CheckMode(LPrefix, LFolder, "r+x");
  CheckMode(LPrefix, LFolder, " r");
  CheckMode(LPrefix, LFolder, "rq");
  CheckMode(LPrefix, LFolder, "r++");
  CheckMode(LPrefix, LFolder, "rtb");
  CheckMode(LPrefix, LFolder, "R");
  CheckMode(LPrefix, LFolder, "x");
  CheckMode(LPrefix, LFolder, "");
  // ucrt: text forms, spaces, each flag's once-only rule, the hints, x only with w
  CheckMode(LPrefix, LFolder, "r+t");
  CheckMode(LPrefix, LFolder, "rt+");
  CheckMode(LPrefix, LFolder, "w+t");
  CheckMode(LPrefix, LFolder, "wt+");
  CheckMode(LPrefix, LFolder, "a+t");
  CheckMode(LPrefix, LFolder, "at+");
  CheckMode(LPrefix, LFolder, "wt");
  CheckMode(LPrefix, LFolder, "at");
  CheckMode(LPrefix, LFolder, "wxb");
  CheckMode(LPrefix, LFolder, "wtx");
  CheckMode(LPrefix, LFolder, "  rb");
  CheckMode(LPrefix, LFolder, "r b");
  CheckMode(LPrefix, LFolder, "rb ");
  CheckMode(LPrefix, LFolder, "r b ");
  CheckMode(LPrefix, LFolder, "rbt");
  CheckMode(LPrefix, LFolder, "rbb");
  CheckMode(LPrefix, LFolder, "rtt");
  CheckMode(LPrefix, LFolder, "rc");
  CheckMode(LPrefix, LFolder, "rn");
  CheckMode(LPrefix, LFolder, "rcn");
  CheckMode(LPrefix, LFolder, "rcc");
  CheckMode(LPrefix, LFolder, "rS");
  CheckMode(LPrefix, LFolder, "rR");
  CheckMode(LPrefix, LFolder, "rSR");
  CheckMode(LPrefix, LFolder, "rRR");
  CheckMode(LPrefix, LFolder, "rT");
  CheckMode(LPrefix, LFolder, "rTT");
  CheckMode(LPrefix, LFolder, "rN");
  CheckMode(LPrefix, LFolder, "rNN");
  CheckMode(LPrefix, LFolder, "rbcSTN");
  CheckMode(LPrefix, LFolder, "rDD");
  // D: the file is gone after the close, present or created
  CheckMode(LPrefix, LFolder, "rD");
  CheckMode(LPrefix, LFolder, "rbD");
  CheckMode(LPrefix, LFolder, "rtD");
  CheckMode(LPrefix, LFolder, "r+D");
  CheckMode(LPrefix, LFolder, "wD");
  CheckMode(LPrefix, LFolder, "wbD");
  CheckMode(LPrefix, LFolder, "w+D");
  CheckMode(LPrefix, LFolder, "w+tD");
  CheckMode(LPrefix, LFolder, "aD");
  CheckMode(LPrefix, LFolder, "a+D");
  CheckMode(LPrefix, LFolder, "wxD");
  // The encoding part's own refusals
  CheckMode(LPrefix, LFolder, "r,");
  CheckMode(LPrefix, LFolder, "r,ccs");
  CheckMode(LPrefix, LFolder, "r, ccs = FOO");
  CheckMode(LPrefix, LFolder, "r,ccx=UTF-8");
  CheckMode(LPrefix, LFolder, "r,CCS=UTF-8");
  CheckMode(LPrefix, LFolder, "r,ccs=UTF-8x");

  // x on a registered IO: the IO is always there
  LMemory := CreateMemoryIO();
  LMemoryPrefix := RegisterIO(LMemory);
  ModeC(LMemoryPrefix + "/x.txt", "wx", addr of LVirtual[0]);
  Check("mode 'wx' registered EEXIST", (LVirtual[0] = 0) and (LVirtual[1] = ADAM_ERRNO_EEXIST));
  Check("modes memory unregister", UnregisterIO(LMemoryPrefix));
  Check("modes memory close", IOClose(LMemory));

  Check("modes unregister", UnregisterIO(LPrefix));
  Check("modes source close", IOSourceClose(LSource));
end;

begin
  GFails := 0;
  TestModes();
  println("done {}", GFails);
end.
