-------------------------------------------------------------------------------
  std_hookio_path_source.adam - System.HookIO's path source (PaskalCPP's
  std_hookio TestPathSource)

  A folder source over the program's own folder holds ps_entry.txt
  ("ENTRY"). While it is the path source, a plain path naming that entry
  ("ps_entry.txt", "./ps_entry.txt", "/ps_entry.txt", ".\ps_entry.txt"),
  opened from C, opens the entry; a plain path the source has no entry for
  (the real file's full path) opens the real file; a name neither has fails
  as a missing file. The source's own open of its entry and CustomIO's file
  IO of the plain name mean the disk (the file IO finds the file only when
  the current folder is the program's). nil unsets it: the rooted name
  opens nothing, the plain name only the current folder's file.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok path source folder
  | ok path source entry file
  | ok path source real file
  | ok path source made
  | ok path source set
  | ok path source plain name
  | ok path source dot name
  | ok path source rooted name
  | ok path source backslash name
  | ok path source missing entry -> real
  | ok path source neither -> missing
  | ok path source own open
  | ok path source own close
  | ok path source file IO means the disk
  | ok path source unset
  | ok path source unset rooted name
  | ok path source unset plain name
  | ok path source close
  | ok path source entry removed
  | ok path source real removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_path_source;

@ifdef TARGET_X86_64_WINDOWS_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

routine clink std_hookio_c_read(APath: ptr to const char; ABuffer: ptr to uint8; ACap: clong;
  AReportSize: ptr to clong): clong; external "std_hookio_c";
routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_dirlen(APath: ptr to const char): clong; external "std_hookio_c";

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The length of APath's folder part (the C fixture's); -1 when it has none
routine DirLength(const APath: string): int64;
var
  LPath: ptr to char;
  LResult: clong;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_dirlen(LPath);
  freemem(LPath);
  return int64(LResult);
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// APath read whole by C's fopen / fread (the C fixture's) into ABuffer (64 bytes): the count,
// -1 when the open fails
routine ReadC(const APath: string; const ABuffer: ptr to uint8): int64;
var
  LPath: ptr to char;
  LSize: clong;
  LCount: clong;
begin
  LPath := StringToC(APath);
  LSize := 0;
  LCount := std_hookio_c_read(LPath, ABuffer, 64, addr of LSize);
  freemem(LPath);
  return int64(LCount);
end;

routine TestPathSource();
var
  LExe: string;
  LFolder: string;
  LLength: int64;
  LSource: IOSource;
  LSample: array[0..4] of uint8;
  LBuffer: array[0..63] of uint8;
  LCount: int64;
  LInCurrent: bool;
  LEntryIO: IO;
  LFileIO: IO;
  LRealPath: string;
begin
  LExe := paramstr(0);
  LLength := DirLength(LExe);
  Check("path source folder", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LFolder := Substring(LExe, 0, LLength);
  LSample[0] := uint8('E');
  LSample[1] := uint8('N');
  LSample[2] := uint8('T');
  LSample[3] := uint8('R');
  LSample[4] := uint8('Y');
  Check("path source entry file", WriteRaw(LFolder + "/ps_entry.txt", addr of LSample[0], 5));
  LRealPath := LExe + ".psreal.txt";
  Check("path source real file", WriteRaw(LRealPath, addr of LSample[0], 3));
  // A plain relative name reaches the real file too when the current folder is the
  // program's: the rows that tell the two apart need to know
  LInCurrent := ReadC("ps_entry.txt", addr of LBuffer[0]) = 5;
  LSource := CreateFolderIOSource(LFolder);
  Check("path source made", LSource <> nil);
  if LSource = nil then
    return;
  end;
  Check("path source set", SetIOPathSource(LSource));

  LBuffer[0] := 0;
  LCount := ReadC("ps_entry.txt", addr of LBuffer[0]);
  Check("path source plain name", (LCount = 5) and (LBuffer[0] = uint8('E')) and
    (LBuffer[4] = uint8('Y')));
  LCount := ReadC("./ps_entry.txt", addr of LBuffer[0]);
  Check("path source dot name", LCount = 5);
  LCount := ReadC("/ps_entry.txt", addr of LBuffer[0]);
  Check("path source rooted name", LCount = 5);
  // '\' separates on x86_64-windows-gnu only; on x86_64-linux-gnu it is a name byte, so the
  // name is neither the entry nor a disk file
  LCount := ReadC(".\\ps_entry.txt", addr of LBuffer[0]);
@ifdef TARGET_X86_64_LINUX_GNU
  Check("path source backslash name", LCount = -1);
@else
  Check("path source backslash name", LCount = 5);
@endif
  LBuffer[0] := 0;
  LCount := ReadC(LRealPath, addr of LBuffer[0]);
  Check("path source missing entry -> real", (LCount = 3) and (LBuffer[0] = uint8('E')) and
    (LBuffer[2] = uint8('T')));
  LCount := ReadC("ps_nowhere.txt", addr of LBuffer[0]);
  Check("path source neither -> missing", LCount = -1);

  // The source's own open of its entry: the disk, no recursion
  LEntryIO := IOSourceOpen(LSource, "ps_entry.txt");
  Check("path source own open", (LEntryIO <> nil) and (IOSize(LEntryIO) = 5));
  if LEntryIO <> nil then
    Check("path source own close", IOClose(LEntryIO));
  else
    Check("path source own close", false);
  end;
  // CustomIO's file IO of the plain name: the disk, never the entry
  LFileIO := CreateFileIO("ps_entry.txt", FileMode.Read);
  Check("path source file IO means the disk", (LFileIO <> nil) = LInCurrent);
  if LFileIO <> nil then
    IOClose(LFileIO);
  end;

  Check("path source unset", SetIOPathSource(nil));
  LCount := ReadC("/ps_entry.txt", addr of LBuffer[0]);
  Check("path source unset rooted name", LCount = -1);
  LCount := ReadC("ps_entry.txt", addr of LBuffer[0]);
  Check("path source unset plain name", (LInCurrent and (LCount = 5)) or
    ((not LInCurrent) and (LCount = -1)));
  Check("path source close", IOSourceClose(LSource));
  Check("path source entry removed", RemovePath(LFolder + "/ps_entry.txt"));
  Check("path source real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestPathSource();
  println("done {}", GFails);
end.
