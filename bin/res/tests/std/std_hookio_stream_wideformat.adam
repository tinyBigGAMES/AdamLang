-------------------------------------------------------------------------------
  std_hookio_stream_wideformat.adam - the wide printf / scanf side of
  System.HookIO from C (PaskalCPP's std_hookio TestStreamWideFormat, with
  Adam's ccs= cases)

  The C fixture's std_hookio_c_wformat writes with fwprintf and vfwprintf
  (an int, a wide string with a character past ASCII, a narrow char, a
  float, a wide char), rewinds and reads it back with fwscanf and vfwscanf
  (a number, a counted word, a skipped set and a wide char, a literal line
  end, then fgetwc and a scan at the end), under the "C" and ".UTF8"
  locales, on a handle over a memory IO and on a real file: in w+, w+b and
  w+t as pcpp's row, then in the three ccs= update modes (UTF-8, UTF-16LE,
  UNICODE). Every step's value, errno, ferror, fwide and ftell, the close
  and the bytes written equal the real file's. Each real run starts on a
  fresh descriptor slot (ucrt keeps a slot's UTF-8 read state until the
  slot is made again: std_hookio_stream_wideread's FreshDescriptor). Then
  std_hookio_c_wformat_ilseq runs ucrt's printf write rules in the same
  modes and locales: a wide string's character the stream cannot write
  ('?' and on), a format literal it cannot write (-1), a pad before such a
  character, a lone surrogate, a narrow print's wide string it cannot
  convert (-1 after its pad), formats ucrt refuses ('N', a width past
  long's range, %n while disabled: -1 after what came before) and a wide
  print's narrow-held text (%hs, a float). One line per case: ok when
  every check of it held, else a FAIL line per check that did not.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok wide format reset file
  | ok wide format C w+
  | ok wide format C w+b
  | ok wide format C w+t
  | ok wide format C w+, ccs=UTF-8
  | ok wide format C w+, ccs=UTF-16LE
  | ok wide format C w+, ccs=UNICODE
  | ok wide format .UTF8 w+
  | ok wide format .UTF8 w+b
  | ok wide format .UTF8 w+t
  | ok wide format .UTF8 w+, ccs=UTF-8
  | ok wide format .UTF8 w+, ccs=UTF-16LE
  | ok wide format .UTF8 w+, ccs=UNICODE
  | ok wide ilseq C w+
  | ok wide ilseq C w+b
  | ok wide ilseq C w+t
  | ok wide ilseq C w+, ccs=UTF-8
  | ok wide ilseq C w+, ccs=UTF-16LE
  | ok wide ilseq C w+, ccs=UNICODE
  | ok wide ilseq .UTF8 w+
  | ok wide ilseq .UTF8 w+b
  | ok wide ilseq .UTF8 w+t
  | ok wide ilseq .UTF8 w+, ccs=UTF-8
  | ok wide ilseq .UTF8 w+, ccs=UTF-16LE
  | ok wide ilseq .UTF8 w+, ccs=UNICODE
  | ok wide format real removed
  | ok wide format reset removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_wideformat;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@endif
  ;

routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_wformat(APath: ptr to const char; AMode: ptr to const char;
  ALocale: ptr to const char; AResults: ptr to int64); external "std_hookio_c";
routine clink std_hookio_c_wformat_ilseq(APath: ptr to const char; AMode: ptr to const char;
  ALocale: ptr to const char; AResults: ptr to int64); external "std_hookio_c";

const
  // std_hookio_c_wformat's and std_hookio_c_wformat_ilseq's result slots, all compared (72:
  // the locale was set, 73: the open succeeded, 74: the close, 75..140: the bytes read back)
  CSlots: int32 = 141;
  // The modes UpdateMode names
  CModes: int32 = 6;
  // The one byte of the reset file FreshDescriptor reads ('x')
  CResetByte: uint8 = 120;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// One check of a case: nothing when it held, else a FAIL line naming it, counted in ABad
routine Part(const AName: string; const APart: string; const AOk: bool; var ABad: int32);
begin
  if not AOk then
    println("FAIL {} {}", AName, APart);
    ABad := ABad + 1;
  end;
end;

// The end of a case: its ok line when no check of it failed; the failures counted
routine Finish(const AName: string; const ABad: int32);
begin
  if ABad = 0 then
    println("ok {}", AName);
  end;
  GFails := GFails + ABad;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// The locales the wide rows run under: "C", then ucrt's UTF-8 one
routine WideLocale(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "C";
  end;
  return ".UTF8";
end;

// The update mode number AIndex: text by default, b, t (pcpp's three), then the three ccs=
// update modes
routine UpdateMode(const AIndex: int32): string;
begin
  if AIndex = 1 then
    return "w+b";
  end;
  if AIndex = 2 then
    return "w+t";
  end;
  if AIndex = 3 then
    return "w+, ccs=UTF-8";
  end;
  if AIndex = 4 then
    return "w+, ccs=UTF-16LE";
  end;
  if AIndex = 5 then
    return "w+, ccs=UNICODE";
  end;
  return "w+";
end;

// The fixture's sequence AKind on APath in AMode under ALocale (0: the write-and-scan one, 1:
// the write rules one): its slots in AResults
routine FormatC(const AKind: int32; const APath: string; const AMode: string;
  const ALocale: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
  LLocale: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LLocale := StringToC(ALocale);
  if AKind = 0 then
    std_hookio_c_wformat(LPath, LMode, LLocale, AResults);
  else
    std_hookio_c_wformat_ilseq(LPath, LMode, LLocale, AResults);
  end;
  freemem(LPath);
  freemem(LMode);
  freemem(LLocale);
end;

// A UTF-8 read of the 1-byte ASCII file at APath through the C runtime's own FILE, closed
// again: the descriptor slot the next real open takes is left as a fresh one is (its UTF-8
// read changed no character count and began at 0); whether it read the byte
routine FreshDescriptor(const APath: string): bool;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LMode := StringToC("r, ccs=UTF-8");
  LFile := fopen(LPath, LMode);
  LOk := LFile <> nil;
  if LOk then
    LOk := fgetwc(LFile) = uint16(CResetByte);
    fclose(LFile);
  end;
  freemem(LPath);
  freemem(LMode);
  return LOk;
end;

// One case: the fixture's sequence AKind (FormatC) in UpdateMode(AMode) under locale ALocale, on
// a new memory IO and on the real file at ARealPath (removed first; its descriptor made fresh
// by the reset file at AResetPath)
routine FormatCase(const AKind: int32; const ARealPath: string; const AResetPath: string;
  const ALocale: int32; const AMode: int32);
var
  LMemory: IO;
  LPrefix: string;
  LName: string;
  LBad: int32;
  LVirtual: array[0..140] of int64;
  LReal: array[0..140] of int64;
begin
  LBad := 0;
  LName := "wide format " + WideLocale(ALocale) + " " + UpdateMode(AMode);
  if AKind = 1 then
    LName := "wide ilseq " + WideLocale(ALocale) + " " + UpdateMode(AMode);
  end;
  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  // A real file left by an earlier case is gone first; none is there before the first
  RemovePath(ARealPath);
  FormatC(AKind, LPrefix + "/f.txt", UpdateMode(AMode), WideLocale(ALocale),
    addr of LVirtual[0]);
  Part(LName, "fresh descriptor", FreshDescriptor(AResetPath), LBad);
  FormatC(AKind, ARealPath, UpdateMode(AMode), WideLocale(ALocale), addr of LReal[0]);
  Part(LName, "ran", (LVirtual[72] = 1) and (LVirtual[73] = 1) and (LReal[72] = 1) and
    (LReal[73] = 1), LBad);
  Part(LName, "as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], CSlots), LBad);
  Part(LName, "unregister", UnregisterIO(LPrefix), LBad);
  Part(LName, "io close", IOClose(LMemory), LBad);
  Finish(LName, LBad);
end;

// The wide printf / scanf side from C on a virtual file and on a real file, both fixture
// sequences under both locales, in every mode UpdateMode names
routine TestStreamWideFormat();
var
  LReset: array[0..0] of uint8;
  LRealPath: string;
  LResetPath: string;
  LKind: int32;
  LLocale: int32;
  LMode: int32;
begin
  LRealPath := paramstr(0) + ".wformat.txt";
  LResetPath := paramstr(0) + ".wfreset.txt";
  LReset[0] := CResetByte;
  Check("wide format reset file", WriteRaw(LResetPath, addr of LReset[0], 1));
  for LKind := 0 to 1 do
    for LLocale := 0 to 1 do
      for LMode := 0 to CModes - 1 do
        FormatCase(LKind, LRealPath, LResetPath, LLocale, LMode);
      end;
    end;
  end;
  Check("wide format real removed", RemovePath(LRealPath));
  Check("wide format reset removed", RemovePath(LResetPath));
end;

begin
  GFails := 0;
  TestStreamWideFormat();
  println("done {}", GFails);
end.
