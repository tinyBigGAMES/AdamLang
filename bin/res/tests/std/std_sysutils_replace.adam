-------------------------------------------------------------------------------
  std_sysutils_replace.adam - System.SysUtils' ReplaceStr and NormalizePath
  (PLAN-LINUX64 LX3d3f3a, helpers the examples shared): every occurrence
  replaced left to right, a replacement never searched again, an empty
  pattern changing nothing, CR LF to LF and back; paths with . and ..
  resolved as text, both separators taken, a root kept, a leading .. kept
  in a relative path and dropped at a root, empty parts dropped. The same
  lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | all [b-n-n-n-n-n-]
  | twice [aa-aa]
  | none [banana]
  | empty [banana]
  | lf [a|b|c] crlf [a.b.c] back true
  | tiles [res/assets/tilesets/tinytown.png]
  | mixed [a/c/d]
  | root [/b]
  | up [../../x]
  | rooted up [/x]
  | empty parts [a/b]
  | blank []
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_sysutils_replace;

import System.SysUtils;

var
  LText: string;
  LUnix: string;
begin
  println("all [{}]", ReplaceStr("banana", "a", "-n-"));
  println("twice [{}]", ReplaceStr("a-a", "a", "aa"));
  println("none [{}]", ReplaceStr("banana", "x", "y"));
  println("empty [{}]", ReplaceStr("banana", "", "y"));
  LText := "a\r\nb\r\nc";
  LUnix := ReplaceStr(LText, "\r\n", "\n");
  println("lf [{}] crlf [{}] back {}", ReplaceStr(LUnix, "\n", "|"),
    ReplaceStr(LText, "\r\n", "."), ReplaceStr(LUnix, "\n", "\r\n") = LText);
  println("tiles [{}]", NormalizePath("res/assets/maps/../tilesets/./tinytown.png"));
  println("mixed [{}]", NormalizePath("a\\b\\..\\c/d"));
  println("root [{}]", NormalizePath("/a/../b"));
  println("up [{}]", NormalizePath("../../x"));
  println("rooted up [{}]", NormalizePath("/../x"));
  println("empty parts [{}]", NormalizePath("a//b/"));
  println("blank [{}]", NormalizePath(""));
end.
