-------------------------------------------------------------------------------
  std_hookio_stream_pos.adam - ucrt's stream names System.HookIO.Win64
  builds as ucrt's own sources do (PLAN-LINUX64 LX3d3c2d): fgetpos /
  fsetpos, _getw / _putw, clearerr_s, fread_s (a fit, a buffer too small,
  no buffer, no bytes), fread / fwrite's parameter checks, freopen_s,
  _wfreopen, _wfreopen_s and freopen's checks before the stream is touched
  (no path, an empty one, no mode, no result), on a handle over a memory
  IO and on a real file beside the program: every step's value, errno,
  the parameter checks it failed (a thread's invalid parameter handler
  counts them) and the bytes read equal the real file's.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok pos ran
  | ok pos as real file
  | ok pos unregister
  | ok pos io close
  | ok pos real removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_pos;

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO, System.HookIO.Win64;

// ucrt's handler of a failed parameter check for this thread (it comes before the process's)
func _set_thread_local_invalid_parameter_handler(const AHandler: func(
  const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64)): ptr;
  external "ucrtbase";

const
  // The slots Steps fills
  CSlots: int32 = 70;
  // The bytes written first
  CText: string = "ABCDEFGHIJKLMNOPQRST";

var
  GFails: int32;
  // The failed parameter checks so far
  GInvalid: int64;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The thread's invalid parameter handler: counts the call and returns (the call then returns
// its failure)
func OnInvalid(const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64);
begin
  GInvalid := GInvalid + 1;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
func SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// AText as UTF-16 with its terminating 0 unit
func WideText(const AText: string): wstring;
var
  LWide: wstring;
  LAt: int64;
  LIndex: int64;
  LCode: uint32;
begin
  setlength(LWide, (len(AText) * 2) + 2);
  LAt := 0;
  LIndex := 0;
  while LIndex < len(AText) do
    LCode := DecodeUTF8Char(AText, LIndex);
    EncodeUTF16Char(LWide, LAt, LCode);
  end;
  EncodeUTF16Char(LWide, LAt, 0);
  setlength(LWide, LAt);
  return LWide;
end;

// The failed parameter checks since ABefore
func InvalidSince(const ABefore: int64): int64;
begin
  return GInvalid - ABefore;
end;

// C's truth value of AFlag
func Flag(const AFlag: bool): int64;
begin
  if AFlag then
    return 1;
  end;
  return 0;
end;

// Every step on the stream opened at APath (w+b), its slots in AResults
func Steps(const APath: string; const AResults: ptr to int64);
var
  LWidePath: wstring;
  LWideRead: wstring;
  LWideUpdate: wstring;
  LFile: ptr;
  LAgain: ptr;
  LPlace: int64;
  LBuffer: array[0..15] of uint8;
  LBefore: int64;
  LI: int32;
begin
  for LI := 0 to CSlots - 1 do
    AResults[LI] := -99;
  end;
  LWidePath := WideText(APath);
  LWideRead := WideText("rb");
  LWideUpdate := WideText("r+b");
  LFile := fopen(APath, ptr to const char("w+b"));
  AResults[0] := Flag(LFile <> nil);
  if LFile = nil then
    return;
  end;
  AResults[1] := fwrite(ptr(ptr to const char(CText)), 1, len(CText), LFile);
  // fgetpos / fsetpos
  LPlace := -1;
  AResults[2] := fgetpos(LFile, addr of LPlace);
  AResults[3] := LPlace;
  LPlace := 3;
  AResults[4] := fsetpos(LFile, addr of LPlace);
  AResults[5] := fgetc(LFile);
  AResults[6] := fgetpos(LFile, addr of LPlace);
  AResults[7] := LPlace;
  LBefore := GInvalid;
  SetCErrno(0);
  AResults[8] := fsetpos(LFile, nil);
  AResults[9] := CErrno();
  AResults[10] := InvalidSince(LBefore);
  // _putw at the end, _getw back, then _getw at the end
  AResults[11] := fseek(LFile, 0, 2);
  AResults[12] := _putw(0x34333231, LFile);
  AResults[13] := ferror(LFile);
  AResults[14] := fseek(LFile, 20, 0);
  AResults[15] := _getw(LFile);
  AResults[16] := feof(LFile);
  AResults[17] := _getw(LFile);
  AResults[18] := feof(LFile);
  // clearerr_s
  AResults[19] := clearerr_s(LFile);
  AResults[20] := feof(LFile);
  AResults[21] := ferror(LFile);
  // fread_s that fits
  AResults[22] := fseek(LFile, 0, 0);
  for LI := 0 to 15 do
    LBuffer[LI] := 0;
  end;
  AResults[23] := fread_s(addr of LBuffer[0], 8, 1, 8, LFile);
  AResults[24] := int64(LBuffer[0]);
  AResults[25] := int64(LBuffer[7]);
  AResults[26] := ftell(LFile);
  // fread_s past its buffer: the buffer filled, ERANGE, one failed check
  AResults[27] := fseek(LFile, 0, 0);
  LBefore := GInvalid;
  SetCErrno(0);
  AResults[28] := fread_s(addr of LBuffer[0], 8, 1, 16, LFile);
  AResults[29] := CErrno();
  AResults[30] := InvalidSince(LBefore);
  AResults[31] := int64(LBuffer[0]);
  AResults[32] := int64(LBuffer[7]);
  AResults[33] := int64(LBuffer[8]);
  AResults[34] := ftell(LFile);
  AResults[35] := ferror(LFile);
  // _fread_nolock_s past its buffer from inside the buffer (the buffer's piece is too big)
  LBefore := GInvalid;
  SetCErrno(0);
  AResults[36] := _fread_nolock_s(addr of LBuffer[0], 4, 1, 12, LFile);
  AResults[37] := CErrno();
  AResults[38] := InvalidSince(LBefore);
  AResults[39] := ftell(LFile);
  // fread_s with no buffer, then no bytes
  LBefore := GInvalid;
  SetCErrno(0);
  AResults[40] := fread_s(nil, 8, 1, 4, LFile);
  AResults[41] := CErrno();
  AResults[42] := InvalidSince(LBefore);
  LBefore := GInvalid;
  AResults[43] := fread_s(nil, 8, 1, 0, LFile);
  AResults[44] := InvalidSince(LBefore);
  // fread's count past size_t, fwrite with no buffer
  LBefore := GInvalid;
  SetCErrno(0);
  AResults[45] := fread(addr of LBuffer[0], 4, 0x4000000000000000, LFile);
  AResults[46] := CErrno();
  AResults[47] := InvalidSince(LBefore);
  LBefore := GInvalid;
  SetCErrno(0);
  AResults[48] := fwrite(nil, 1, 4, LFile);
  AResults[49] := CErrno();
  AResults[50] := InvalidSince(LBefore);
  // freopen_s onto the same path for reading
  LAgain := nil;
  AResults[51] := freopen_s(addr of LAgain, APath, ptr to const char("rb"), LFile);
  AResults[52] := Flag(LAgain = LFile);
  AResults[53] := fgetc(LFile);
  // freopen's checks before the stream is touched: no path, an empty one, no mode
  SetCErrno(0);
  AResults[54] := Flag(freopen(nil, ptr to const char("rb"), LFile) = nil);
  AResults[55] := CErrno();
  AResults[56] := fgetc(LFile);
  SetCErrno(0);
  AResults[57] := Flag(freopen("", ptr to const char("rb"), LFile) = nil);
  AResults[58] := CErrno();
  AResults[59] := fgetc(LFile);
  LBefore := GInvalid;
  SetCErrno(0);
  AResults[60] := Flag(freopen(APath, nil, LFile) = nil);
  AResults[61] := CErrno();
  AResults[62] := InvalidSince(LBefore);
  AResults[63] := fgetc(LFile);
  // freopen_s with no result: refused before the stream (EINVAL), the stream reads on
  LBefore := GInvalid;
  AResults[64] := freopen_s(nil, APath, ptr to const char("rb"), LFile);
  AResults[65] := InvalidSince(LBefore) * 1000 + fgetc(LFile);
  // _wfreopen, then _wfreopen_s for update
  AResults[66] := Flag(_wfreopen(addr of LWidePath[0], addr of LWideRead[0], LFile) = LFile) *
    1000 + fgetc(LFile);
  LAgain := nil;
  AResults[67] := _wfreopen_s(addr of LAgain, addr of LWidePath[0], addr of LWideUpdate[0],
    LFile);
  AResults[68] := Flag(LAgain = LFile) * 1000 + fgetc(LFile);
  AResults[69] := fclose(LFile);
end;

// Deletes the file at APath; false when it is not deleted
func RemovePath(const APath: string): bool;
var
  LOk: bool;
begin
  LOk := RemoveFile(APath);
  return LOk;
end;

// The steps on a handle over a memory IO and on a real file: every slot equal
func TestPos();
var
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..69] of int64;
  LReal: array[0..69] of int64;
begin
  LRealPath := paramstr(0) + ".pos.bin";
  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  RemovePath(LRealPath);
  Steps(LPrefix + "/p.bin", addr of LVirtual[0]);
  Steps(LRealPath, addr of LReal[0]);
  Check("pos ran", (LVirtual[0] = 1) and (LReal[0] = 1) and (LReal[69] = 0));
  Check("pos as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], CSlots));
  Check("pos unregister", UnregisterIO(LPrefix));
  Check("pos io close", IOClose(LMemory));
  Check("pos real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  GInvalid := 0;
  _set_thread_local_invalid_parameter_handler(OnInvalid);
  TestPos();
  println("done {}", GFails);
end.
