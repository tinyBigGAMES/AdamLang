-------------------------------------------------------------------------------
  std_sysutils_join.adam - System.SysUtils' JoinStrings, sized once

  JoinStrings sizes its text once and fills it in place (a growing
  text + part copied the text so far on every part). Joined: an empty list,
  one string, several with a separator of several bytes, an empty separator,
  empty strings between separators, a sub-range (AFirst / ACount), multibyte
  UTF-8 kept byte for byte, and 2000 parts whose length adds up exactly.
  Each row prints ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok empty list
  | ok one string
  | ok separator
  | ok no separator
  | ok empty parts
  | ok sub-range
  | ok sub-range none
  | ok utf-8
  | ok many parts
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_sysutils_join;

import System.SysUtils;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

func Run();
var
  LList: StringArray;
  LMany: StringArray;
  LText: string;
  LI: int64;
begin
  setlength(LList, 0);
  Check("empty list", JoinStrings(LList, ", ") = "");
  setlength(LList, 1);
  LList[0] := "alpha";
  Check("one string", JoinStrings(LList, ", ") = "alpha");
  setlength(LList, 3);
  LList[1] := "beta";
  LList[2] := "gamma";
  Check("separator", JoinStrings(LList, " :: ") = "alpha :: beta :: gamma");
  Check("no separator", JoinStrings(LList, "") = "alphabetagamma");
  LList[1] := "";
  Check("empty parts", JoinStrings(LList, ",") = "alpha,,gamma");
  LList[1] := "beta";
  Check("sub-range", JoinStrings(LList, "-", 1, 2) = "beta-gamma");
  Check("sub-range none", JoinStrings(LList, "-", 2, 0) = "");
  LList[0] := "Grüße";
  LList[1] := "日本";
  LList[2] := "😀";
  Check("utf-8", JoinStrings(LList, "·") = "Grüße·日本·😀");
  setlength(LMany, 2000);
  for LI := 0 to 1999 do
    LMany[LI] := IntToStr(LI);
  end;
  LText := JoinStrings(LMany, ",");
  // 10 one-digit, 90 two-digit, 900 three-digit, 1000 four-digit parts and 1999 commas
  Check("many parts", (len(LText) = 10 + 180 + 2700 + 4000 + 1999) and
    StartsStr("0,1,2,", LText) and EndsStr("1998,1999", LText));
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
