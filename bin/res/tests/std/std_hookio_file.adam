-------------------------------------------------------------------------------
  std_hookio_file.adam - System.HookIO over a registered file IO, and the
  open family's other names (PaskalCPP's std_hookio TestFile and
  TestTargetNames)

  A file IO over the program's own exe registered under a prefix, beside
  the C runtime's own open of the same path: the handle is HookIO's, the
  real FILE is not, and the bytes read through the handle (its IO, and
  fread on the handle) equal fread's on the real FILE. Then fopen_s and
  _wfopen: a virtual path opens a handle, an unregistered one is a missing
  file (fopen_s returns ENOENT), a real path goes to the C runtime, and a
  wide path holding a lone surrogate is a missing file.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok file register
  | ok file open ours
  | ok real path not ours
  | ok file bytes equal real
  | ok file fread equals real
  | ok file close
  | ok real close
  | ok file unregister
  | ok file io close
  | ok names register
  | ok fopen_s virtual
  | ok fopen_s missing
  | ok fopen_s real
  | ok wfopen virtual
  | ok wfopen missing
  | ok wfopen real
  | ok wfopen lone surrogate
  | ok names unregister
  | ok names io close
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_file;

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when the first ACount bytes at AFirst and ASecond are equal
routine SameBytes(const AFirst: ptr; const ASecond: ptr; const ACount: int64): bool;
var
  LFirst: ptr to uint8;
  LSecond: ptr to uint8;
  LI: int64;
begin
  LFirst := ptr to uint8(AFirst);
  LSecond := ptr to uint8(ASecond);
  for LI := 0 to ACount - 1 do
    if LFirst[LI] <> LSecond[LI] then
      return false;
    end;
  end;
  return true;
end;

// fopen of an Adam text path and mode (their C copies freed after the call)
routine OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

// fopen_s of an Adam text path and mode: its result, the stream in AFile
routine OpenPathS(var AFile: ptr; const APath: string; const AMode: string): int32;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LResult := fopen_s(addr of AFile, LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LResult;
end;

// AText (ASCII and UTF-8 alike, as UTF-16) followed by the extra unit AExtra when it is not 0,
// and the terminating 0 unit
routine WideText(const AText: string; const AExtra: uint32): wstring;
var
  LWide: wstring;
  LAt: int64;
  LIndex: int64;
  LCode: uint32;
begin
  setlength(LWide, (len(AText) * 2) + 2);
  LAt := 0;
  LIndex := 0;
  while LIndex < len(AText) do
    LCode := DecodeUtf8Char(AText, LIndex);
    EncodeUtf16Char(LWide, LAt, LCode);
  end;
  if AExtra <> 0 then
    EncodeUtf16Char(LWide, LAt, AExtra);
  end;
  EncodeUtf16Char(LWide, LAt, 0);
  setlength(LWide, LAt);
  return LWide;
end;

// _wfopen of an Adam text path (with the extra unit AExtra when it is not 0) and mode
routine OpenWide(const APath: string; const AExtra: uint32; const AMode: string): ptr;
var
  LPath: wstring;
  LMode: wstring;
begin
  LPath := WideText(APath, AExtra);
  LMode := WideText(AMode, 0);
  return _wfopen(addr of LPath[0], addr of LMode[0]);
end;

// A registered file IO over the program's own file, beside the C runtime's own open of the
// same path
routine TestFile();
var
  LSelf: IO;
  LStream: IO;
  LPrefix: string;
  LFile: ptr;
  LReal: ptr;
  LVirtual: array[0..3] of uint8;
  LBytes: array[0..3] of uint8;
  LHandle: array[0..3] of uint8;
  LOk: bool;
begin
  LSelf := CreateFileIO(paramstr(0), FileMode.Read);
  LPrefix := RegisterIO(LSelf);
  Check("file register", (LSelf <> nil) and (LPrefix <> ""));

  LFile := OpenPath(LPrefix + "/self.bin", "rb");
  Check("file open ours", FileIO(LFile) = LSelf);
  LReal := OpenPath(paramstr(0), "rb");
  Check("real path not ours", (LReal <> nil) and (FileIO(LReal) = nil));

  LStream := FileIO(LFile);
  LOk := (LStream <> nil) and (LReal <> nil);
  if LOk then
    LOk := IOSeek(LStream, 0, SeekOrigin.FromStart) = 0;
  end;
  if LOk then
    LOk := IORead(LStream, addr of LVirtual[0], 4) = 4;
  end;
  if LOk then
    LOk := fread(addr of LBytes[0], 1, 4, LReal) = 4;
  end;
  Check("file bytes equal real", LOk and SameBytes(addr of LVirtual[0], addr of LBytes[0], 4));
  // The handle reads from its own place, 0, whatever its IO's place is now
  Check("file fread equals real", (fread(addr of LHandle[0], 1, 4, LFile) = 4) and
    SameBytes(addr of LHandle[0], addr of LBytes[0], 4));

  Check("file close", (LFile <> nil) and (fclose(LFile) = 0));
  Check("real close", (LReal <> nil) and (fclose(LReal) = 0));
  Check("file unregister", UnregisterIO(LPrefix));
  Check("file io close", IOClose(LSelf));
end;

// fopen_s and _wfopen: a virtual path, a missing one, a real one; a wide path that does not
// convert to UTF-8 (a lone surrogate) is a missing file
routine TestNames();
var
  LData: array[0..3] of uint8;
  LMemory: IO;
  LPrefix: string;
  LFile: ptr;
  LResult: int32;
  LError: int32;
begin
  LData[0] := 1;
  LData[1] := 2;
  LData[2] := 3;
  LData[3] := 4;
  LMemory := CreateMemoryIO(addr of LData[0], 4, true);
  LPrefix := RegisterIO(LMemory);
  Check("names register", LPrefix <> "");

  LFile := nil;
  LResult := OpenPathS(LFile, LPrefix + "/x.bin", "rb");
  Check("fopen_s virtual", (LResult = 0) and (FileIO(LFile) = LMemory) and (fclose(LFile) = 0));
  LFile := ptr(LMemory);
  LResult := OpenPathS(LFile, "io://999999/x.bin", "rb");
  Check("fopen_s missing", (LResult = ADAM_ERRNO_ENOENT) and (LFile = nil));
  LFile := nil;
  LResult := OpenPathS(LFile, paramstr(0), "rb");
  Check("fopen_s real", (LResult = 0) and (LFile <> nil) and (FileIO(LFile) = nil) and
    (fclose(LFile) = 0));

  LFile := OpenWide(LPrefix + "/x.bin", 0, "rb");
  Check("wfopen virtual", (FileIO(LFile) = LMemory) and (fclose(LFile) = 0));
  SetCErrno(0);
  LFile := OpenWide("io://999999/x.bin", 0, "rb");
  LError := CErrno();
  Check("wfopen missing", (LFile = nil) and (LError = ADAM_ERRNO_ENOENT));
  LFile := OpenWide(paramstr(0), 0, "rb");
  Check("wfopen real", (LFile <> nil) and (FileIO(LFile) = nil) and (fclose(LFile) = 0));
  SetCErrno(0);
  LFile := OpenWide(LPrefix + "/x", 0xD800, "rb");
  LError := CErrno();
  Check("wfopen lone surrogate", (LFile = nil) and (LError = ADAM_ERRNO_ENOENT));

  Check("names unregister", UnregisterIO(LPrefix));
  Check("names io close", IOClose(LMemory));
end;

begin
  GFails := 0;
  TestFile();
  TestNames();
  println("done {}", GFails);
end.
