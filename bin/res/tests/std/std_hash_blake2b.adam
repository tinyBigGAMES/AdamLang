-------------------------------------------------------------------------------
  std_hash_blake2b.adam - System.Hash's BLAKE2b-512 (RFC 7693, unkeyed):
  the empty input and "abc" (RFC 7693 Appendix A), runs of 'a' around the
  128-byte block edge (127, 128: a full last block kept for Final's flag,
  129), two blocks (255, 256) and past them (1000); input in pieces of 1, 7
  and 128 bytes giving the one-call digest, a hasher used again after Final,
  Update over memory, the digest size, Kind(), UTF-8 text. Digests checked
  against Python's hashlib. The same lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | empty 786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce
  | abc ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923
  | a x 127 94596b9d6199c807c40ae1a935f3633ba5a8dd5655f7f1bd44f5285b1ce8dbb0054771eba409539df85a963296d28788807105153c90fa3ec3d761228e90f8b8
  | a x 128 fc6c71f688f43ea7d60817478808f3cac753e61571865c95adbc2d9122c943a76b92c2cb1047ef3fe7bf6e436ec1d0a99a9e5b216780bf7fed9d7ca91d3a8f3b
  | a x 129 55e6e0eb418149a8af92fd9ddc99254781b2f522a131b4f4d984404b71a00e1167b8124d5dcddd4c6977b299392335d6edd303da6d344d74bbef2d38101b232b
  | a x 255 792ea4793169359d36f13f472d4b427b40c663c680f47932a0cf3a110e6d84305f46825da8ada4d83a6247bb09fb3bb1b5781186a81b2aff8c9c39a597e447dd
  | a x 256 0eee13d0c73a2710c5015a8b4be0a16120bb88f826b662951ffe4b3b81441cfdce1f712c58e237dba72a0dad7f9c86b9745ea0b4b3b850ff3a260fb7df9d3e81
  | a x 1000 d6a69459fe93fc6b9537ed4336e5099e0dcca3e97290a412500ed7a0daffb03d80cf3650a20e0591f748e10c3c534945ee83d5f2c9722f1a68d98b8c01af23fd
  | pieces 1 true
  | pieces 7 true
  | pieces 128 true
  | again true
  | memory true
  | size 64
  | kind BLAKE2B512
  | utf8 7231203e00dbefee0f1f1b3de50548957c5585323c13e56cbab96ea93015073e48ef0fbb7fa1158bb64c177c38ea9da18d27d1de4e1935802ae5bf43f86368dc
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hash_blake2b;

import System.SysUtils, System.Hash;

// The BLAKE2b-512 digest of AText as hex
func Digest(const AText: string): string;
begin
  return DigestToHex(ComputeHash(HashKind.BLAKE2B512, AText));
end;

// AText given to a hasher in pieces of ASize bytes: the one-call digest?
func InPieces(const AText: string; const ASize: int64): bool;
var
  LHash: Hasher;
  LAt: int64;
  LCount: int64;
begin
  LHash := Hasher(HashKind.BLAKE2B512);
  LAt := 0;
  while LAt < len(AText) do
    LCount := ASize;
    if LAt + LCount > len(AText) then
      LCount := len(AText) - LAt;
    end;
    LHash.Update(Substring(AText, LAt, LCount));
    LAt := LAt + LCount;
  end;
  return DigestToHex(LHash.Final()) = Digest(AText);
end;

var
  GHash: Hasher;
  GText: string;
  GFirst: string;
  GBytes: ByteArray;
  GRun: int64;
  GSizes: array[0..5] of int64;
  GI: int64;

begin
  println("empty {}", Digest(""));
  println("abc {}", Digest("abc"));
  GSizes := [127, 128, 129, 255, 256, 1000];
  for GI := 0 to 5 do
    GRun := GSizes[GI];
    println("a x {} {}", GRun, Digest(StringOfChar('a', GRun)));
  end;

  // the same digest whatever the pieces, across the block edges
  GText := StringOfChar('a', 1000);
  println("pieces 1 {}", InPieces(GText, 1));
  println("pieces 7 {}", InPieces(GText, 7));
  println("pieces 128 {}", InPieces(GText, 128));

  // Final starts the hasher over: the same input gives the same digest again
  GHash := Hasher(HashKind.BLAKE2B512);
  GHash.Update("abc");
  GFirst := DigestToHex(GHash.Final());
  GHash.Update("abc");
  println("again {}", DigestToHex(GHash.Final()) = GFirst);

  // Update over memory: a buffer a C library or a file read filled
  setlength(GBytes, 3);
  GBytes[0] := 0x61;
  GBytes[1] := 0x62;
  GBytes[2] := 0x63;
  GHash.Update(addr of GBytes[0], 3);
  println("memory {}", DigestToHex(GHash.Final()) = GFirst);

  println("size {}", len(ComputeHash(HashKind.BLAKE2B512, GBytes)));
  println("kind {}", nameof(GHash.Kind()));
  println("utf8 {}", Digest("Adam ü€"));
end.
