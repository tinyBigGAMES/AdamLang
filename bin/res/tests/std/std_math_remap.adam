-------------------------------------------------------------------------------
  std_math_remap.adam - System.Math's InverseLerp and Remap (PLAN-RAVENAPI
  R9: raymath's scalar Normalize / Remap jobs): a value's fraction between
  two ends, reversed ends, equal ends giving 0, Remap between ranges and
  past them (never clamped), the float32 forms. The same lines on both
  targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | inverse true true true true
  | remap true true true
  | float32 true true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_math_remap;

import System.Math;

begin
  println("inverse {} {} {} {}", InverseLerp(0.0, 10.0, 2.5) = 0.25,
    InverseLerp(10.0, 0.0, 2.5) = 0.75, InverseLerp(5.0, 5.0, 7.0) = 0.0,
    InverseLerp(0.0, 10.0, 15.0) = 1.5);
  println("remap {} {} {}", Remap(5.0, 0.0, 10.0, 100.0, 200.0) = 150.0,
    Remap(15.0, 0.0, 10.0, 0.0, 1.0) = 1.5, Remap(2.0, 2.0, 2.0, 7.0, 9.0) = 7.0);
  println("float32 {} {}", InverseLerp(float32(1.0), float32(3.0), float32(2.0)) = float32(0.5),
    Remap(float32(1.0), float32(0.0), float32(2.0), float32(-4.0), float32(4.0)) = float32(0.0));
end.
