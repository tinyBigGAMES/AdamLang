module exe std_hookio_stream_setvbuf;

@ifdef TARGET_X86_64_WINDOWS_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_svsample(ABuffer: ptr to uint8; ACap: clong): clong;
  external "std_hookio_c";
routine clink std_hookio_c_svcount(): int32; external "std_hookio_c";
routine clink std_hookio_c_setvbuf(APath: ptr to const char; AMode: ptr to const char;
  AVariant: int32; AResults: ptr to int64); external "std_hookio_c";
routine clink std_hookio_c_frcount(): int32; external "std_hookio_c";
routine clink std_hookio_c_fflushread(APath: ptr to const char; AMode: ptr to const char;
  AVariant: int32; AResults: ptr to int64); external "std_hookio_c";
routine clink std_hookio_c_svstdout(APath: ptr to const char; AResults: ptr to int64);
  external "std_hookio_c";

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// A read mode by index: "rt", "r", "rb"
routine TextReadMode(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "rt";
  end;
  if AIndex = 1 then
    return "r";
  end;
  return "rb";
end;

// The C fixture's setvbuf variant AVariant on APath in AMode: its 37 slots in AResults
routine SetvbufC(const APath: string; const AMode: string; const AVariant: int32;
  const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_setvbuf(LPath, LMode, AVariant, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// The C fixture's fflush of a reading stream, variant AVariant on APath in AMode: its 14
// slots in AResults
routine FflushReadC(const APath: string; const AMode: string; const AVariant: int32;
  const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_fflushread(LPath, LMode, AVariant, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// The C fixture's line-buffered stdout before a fill of APath: its 3 slots in AResults
routine SvStdoutC(const APath: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
begin
  LPath := StringToC(APath);
  std_hookio_c_svstdout(LPath, AResults);
  freemem(LPath);
end;

// setvbuf / setbuf from C on a virtual file and on a real file of the same 10000 bytes, every
// variant through "rt", "r" and "rb": every slot equals the real file's, the caller's array
// included. Variant 23 on Linux (setvbuf while glibc reads ungot bytes from its backup area)
// has no real twin: glibc reads freed memory there and aborts at fclose; the handle keeps the
// stream where the caller stands. Then fflush on a reading handle against a real file, and
// stdout's flush before a line-buffered fill
routine TestStreamSetvbuf();
var
  LSample: array[0..9999] of uint8;
  LLength: clong;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..36] of int64;
  LReal: array[0..36] of int64;
  LOut: array[0..2] of int64;
  LRealOut: array[0..2] of int64;
  LFlush: array[0..13] of int64;
  LRealFlush: array[0..13] of int64;
  LVariant: int32;
  LMode: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".setvbuf.txt";
  LLength := std_hookio_c_svsample(addr of LSample[0], 10000);
  Check("setvbuf sample", LLength = 10000);
  LMemory := CreateMemoryIO(addr of LSample[0], int64(LLength), true);
  LPrefix := RegisterIO(LMemory);
  Check("setvbuf real file", WriteRaw(LRealPath, addr of LSample[0], int64(LLength)));
  for LVariant := 0 to std_hookio_c_svcount() - 1 do
    for LMode := 0 to 2 do
      LName := "setvbuf " + IntToStr(LVariant) + " " + TextReadMode(LMode);
      SetvbufC(LPrefix + "/v.txt", TextReadMode(LMode), LVariant, addr of LVirtual[0]);
      Check(LName + " closed", LVirtual[36] = 0);
      if LVariant = 23 then
@ifdef TARGET_X86_64_LINUX_GNU
        // The stream stays where the caller stands: the ungot 'Z' first (ftell 2 after it),
        // then the file from byte 2 (fread's first byte), and an fseek lands on its byte
        Check(LName + " keeps the stream", (LVirtual[0] = 0) and (LVirtual[3] = 90) and
          (LVirtual[4] = 2) and (LVirtual[6] = 250) and (LVirtual[8] = 252) and
          (LVirtual[20] = int64(LSample[7001])));
@else
        // ucrt has a real twin here: the stream is the real file's
        SetvbufC(LRealPath, TextReadMode(LMode), LVariant, addr of LReal[0]);
        Check(LName + " keeps the stream", SameSlots(addr of LVirtual[0], addr of LReal[0], 37));
@endif
      else
        SetvbufC(LRealPath, TextReadMode(LMode), LVariant, addr of LReal[0]);
        Check(LName + " as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 37));
      end;
    end;
  end;
  for LVariant := 0 to std_hookio_c_frcount() - 1 do
    for LMode := 0 to 2 do
      LName := "fflush read " + IntToStr(LVariant) + " " + TextReadMode(LMode);
      FflushReadC(LPrefix + "/v.txt", TextReadMode(LMode), LVariant, addr of LFlush[0]);
      FflushReadC(LRealPath, TextReadMode(LMode), LVariant, addr of LRealFlush[0]);
      Check(LName + " closed", LFlush[13] = 0);
      Check(LName + " as real file", SameSlots(addr of LFlush[0], addr of LRealFlush[0], 14));
    end;
  end;
  SvStdoutC(LPrefix + "/v.txt", addr of LOut[0]);
  SvStdoutC(LRealPath, addr of LRealOut[0]);
@ifdef TARGET_X86_64_LINUX_GNU
  // glibc flushes stdout before a line-buffered fill: measured, and the first byte read
  Check("setvbuf stdout as real file", SameSlots(addr of LOut[0], addr of LRealOut[0], 3) and
    (LOut[0] = 1) and (LOut[1] = 1) and (LOut[2] = int64(LSample[0])));
@else
  Check("setvbuf stdout as real file", SameSlots(addr of LOut[0], addr of LRealOut[0], 3));
@endif
  Check("setvbuf unregister", UnregisterIO(LPrefix));
  Check("setvbuf io close", IOClose(LMemory));
  Check("setvbuf real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestStreamSetvbuf();
  println("done {}", GFails);
end.
