-------------------------------------------------------------------------------
  std_zlib_crc.adam - System.Zlib's ZlibCrc32: the catalogue check value,
  a crc carried over two pieces equal to the whole, the empty array (the
  start value back), and 300000 bytes (the value Python's zlib.crc32
  gives for bytes(i % 251 for i in range(300000))).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | check 3421780262
  | carried 3421780262
  | empty 0
  | empty carried 3421780262
  | large 824308248
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_zlib_crc;

import System.SysUtils, System.Zlib;

// ALabel and AValue on one line
routine Show(const ALabel: string; const AValue: int64);
begin
  println("{} {}", ALabel, AValue);
end;

// AText's bytes as a byte array
routine TextBytes(const AText: string): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(AText));
  for LI := 0 to len(AText) - 1 do
    LBytes[LI] := uint8(AText[LI]);
  end;
  return LBytes;
end;

var
  GEmpty: ByteArray;
  GLarge: ByteArray;
  GCrc: uint32;
  GI: int64;

begin
  Show("check", int64(ZlibCrc32(0, TextBytes("123456789"))));
  GCrc := ZlibCrc32(0, TextBytes("12345"));
  Show("carried", int64(ZlibCrc32(GCrc, TextBytes("6789"))));
  setlength(GEmpty, 0);
  Show("empty", int64(ZlibCrc32(0, GEmpty)));
  Show("empty carried", int64(ZlibCrc32(3421780262, GEmpty)));
  setlength(GLarge, 300000);
  for GI := 0 to 299999 do
    GLarge[GI] := uint8(GI mod 251);
  end;
  Show("large", int64(ZlibCrc32(0, GLarge)));
end.
