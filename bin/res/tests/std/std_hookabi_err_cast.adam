-------------------------------------------------------------------------------
  std_hookabi_err_cast.adam - the routine value cast (BNF sec 6, a hook's
  FopenFn(P)) takes the untyped ptr only: an integer or a typed pointer
  cast to a routine type, and a routine value cast to an integer, are
  refused.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe std_hookabi_err_cast;

type
  TFn = func(const AN: int32): int32;

var
  LF: TFn;
  LN: int64;
  LP: ptr to int32;

begin
  LF := TFn(LN); // ERROR SM0264@13: 'int64' cannot be cast to 'func(const int32): int32'
  LF := TFn(LP); // ERROR SM0264@13: 'ptr to int32' cannot be cast to 'func(const int32): int32'
  LN := int64(LF); // ERROR SM0264@15: 'func(const int32): int32' cannot be cast to 'int64'
end.
