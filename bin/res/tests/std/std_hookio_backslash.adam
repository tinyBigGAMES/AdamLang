-------------------------------------------------------------------------------
  std_hookio_backslash.adam - HookIO's scheme with the target's separators
  (found PLAN-XML X3a: libxml2 turns every '/' into '\' before _wopen on
  x86_64-windows-gnu): on x86_64-windows-gnu "io:\\N\a\b" (and with "\" /
  "/" mixed, after a leading ".\") is virtual, prefix N, rest "/a/b", and
  reads the registered IO through fopen as "io://N/a/b" does; on
  x86_64-linux-gnu, where '\' is a byte of a name, the same text is a plain
  name (not virtual). Both: "io://N/a/b" is virtual with rest "/a/b";
  "io:/N" and "io:" alone are not virtual.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok slash
  | ok backslash
  | ok mixed
  | ok current folder
  | ok short
  | ok read
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_backslash;

import System.SysUtils, System.CustomIO, System.HookIO, System.HookIO.Core
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

const
  TEXT: string = "hello";

// "ok <what>" when AGood, else "BAD <what>"
routine Check(const AGood: bool; const AWhat: string);
begin
  if AGood then
    println("ok {}", AWhat);
  else
    println("BAD {}", AWhat);
  end;
end;

// Whether APath parses as virtual with prefix AId and rest ARest
routine Parses(const APath: string; const AId: uint64; const ARest: string): bool;
var
  LId: uint64;
  LRest: string;
begin
  if not HookIOParse(APath, HookIOSkipCurrentFolder(APath), LId, LRest) then
    return false;
  end;
  return (LId = AId) and (LRest = ARest);
end;

// The text at APath read through C's fopen / fread (the hooked calls); "" when it cannot open
routine ReadThroughC(const APath: string): string;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
  LBuffer: string;
  LCount: int64;
begin
  LPath := StringToC(APath);
  LMode := StringToC("rb");
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  if LFile = nil then
    return "";
  end;
  setlength(LBuffer, 64);
  LCount := fread(ptr(addr of LBuffer[0]), 1, 64, LFile);
  fclose(LFile);
  return Substring(LBuffer, 0, LCount);
end;

var
  LText: string;
  LIO: IO;
  LPrefix: string;
  LId: uint64;
  LIdValue: int64;
  LNumber: string;
  LWindows: bool;
begin
@ifdef TARGET_X86_64_WINDOWS_GNU
  LWindows := true;
@else
  LWindows := false;
@endif
  LText := TEXT;
  LIO := CreateMemoryIO(ptr(addr of LText[0]), len(LText), true);
  LPrefix := RegisterIO(LIO);
  LNumber := Substring(LPrefix, 5, len(LPrefix) - 5);
  LIdValue := 0;
  TryStrToInt(LNumber, LIdValue);
  LId := uint64(LIdValue);

  Check(Parses(LPrefix + "/a/b", LId, "/a/b") and HookIOIsVirtual(LPrefix + "/a/b"), "slash");
  if LWindows then
    Check(Parses("io:\\\\" + LNumber + "\\a\\b", LId, "/a/b"), "backslash");
    Check(Parses("io:\\/" + LNumber + "/a\\b", LId, "/a/b"), "mixed");
    Check(HookIOIsVirtual(".\\io:\\\\" + LNumber + "\\a"), "current folder");
  else
    Check(not HookIOIsVirtual("io:\\\\" + LNumber + "\\a\\b"), "backslash");
    Check(not HookIOIsVirtual("io:\\/" + LNumber + "/a\\b"), "mixed");
    Check(not HookIOIsVirtual(".\\io:\\\\" + LNumber + "\\a"), "current folder");
  end;
  Check((not HookIOIsVirtual("io:/" + LNumber)) and (not HookIOIsVirtual("io:")), "short");

  // The registered IO read through C's file calls by the separators the target takes
  if LWindows then
    Check(ReadThroughC("io:\\\\" + LNumber + "\\doc.txt") = TEXT, "read");
  else
    Check(ReadThroughC(LPrefix + "/doc.txt") = TEXT, "read");
  end;
  UnregisterIO(LPrefix);
  IOClose(LIO);
end.
