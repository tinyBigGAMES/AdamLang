-------------------------------------------------------------------------------
  std_run_pe_sample.adam - the program std_run_pe / std_run_pe_terminal run
  through System.Process' RunPE capture form, its job by its argument:
  lines (line ends of every form, a stderr line between, a last line with
  no end, exit code 7: written raw with WriteFile, so the bytes are exactly
  these), echo (each stdin line back as "in: <line>" to the end of input,
  exit code 3), size (its terminal's size), keys (one line read,
  "got [<line>]": a pseudo console trims a line's trailing spaces).
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

module exe std_run_pe_sample;

import System.SysUtils, System.Windows.SDK, System.Windows, System.Console;

var
  GLine: string;

// AText written to the standard handle AWhich as it is (no newline translation, no buffering)
func WriteRaw(const AWhich: uint32; const AText: string);
var
  LWritten: uint32;
begin
  WriteFile(GetStdHandle(AWhich), ptr to const(addr of AText[0]), uint32(len(AText)), LWritten,
    nil);
end;

begin
  if paramstr(1) = "lines" then
    WriteRaw(STD_OUTPUT_HANDLE, "one\r\ntwo\rthree\n\n");
    WriteRaw(STD_ERROR_HANDLE, "err line\n");
    WriteRaw(STD_OUTPUT_HANDLE, "four");
    ExitCode := 7;
  end;
  if paramstr(1) = "echo" then
    while ReadLn(GLine) do
      println("in: {}", GLine);
    end;
    ExitCode := 3;
  end;
  if paramstr(1) = "size" then
    println("size {} {}", GetTerminalWidth(), GetTerminalHeight());
  end;
  if paramstr(1) = "keys" then
    ReadLn(GLine);
    println("got [{}]", GLine);
  end;
end.
