-------------------------------------------------------------------------------
  std_hash.adam - System.Hash (PLAN-RAVENAPI R9: raylib's ComputeMD5 /
  ComputeSHA1 / ComputeSHA256 jobs): each kind on the empty input, "abc",
  FIPS 180-4's 56-byte message and runs of 'a' around the padding edges
  (55, 56: the length field in the next block, 63, 64, 65) and past a
  block (1000); input in pieces giving the one-call digest, a hasher used
  again after Final, Update over memory, digest sizes, Kind(), UTF-8 text.
  The same lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | md5 empty d41d8cd98f00b204e9800998ecf8427e
  | md5 abc 900150983cd24fb0d6963f7d28e17f72
  | md5 fips 8215ef0796a20bcaaae116d3876c664a
  | md5 55 ef1772b6dff9a122358552954ad0df65
  | md5 56 3b0c8ac703f828b04c6c197006d17218
  | md5 63 b06521f39153d618550606be297466d5
  | md5 64 014842d480b571495a4a0363793f7367
  | md5 65 c743a45e0d2e6a95cb859adae0248435
  | md5 1000 cabe45dcc9ae5b66ba86600cca6b8ba8
  | sha1 empty da39a3ee5e6b4b0d3255bfef95601890afd80709
  | sha1 abc a9993e364706816aba3e25717850c26c9cd0d89d
  | sha1 fips 84983e441c3bd26ebaae4aa1f95129e5e54670f1
  | sha1 55 c1c8bbdc22796e28c0e15163d20899b65621d65a
  | sha1 56 c2db330f6083854c99d4b5bfb6e8f29f201be699
  | sha1 63 03f09f5b158a7a8cdad920bddc29b81c18a551f5
  | sha1 64 0098ba824b5c16427bd7a1122a5a442a25ec644d
  | sha1 65 11655326c708d70319be2610e8a57d9a5b959d3b
  | sha1 1000 291e9a6c66994949b57ba5e650361e98fc36b1ba
  | sha256 empty e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
  | sha256 abc ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
  | sha256 fips 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
  | sha256 55 9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318
  | sha256 56 b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a
  | sha256 63 7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34
  | sha256 64 ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb
  | sha256 65 635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0
  | sha256 1000 41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3
  | pieces true reuse true memory true size 16 20 32
  | kind true utf8 f83e039796c6453a10f5519e39fd113901572316a1a8ea07cb525d2801dfd074
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hash;

import System.SysUtils, System.Hash;

// AChar repeated ACount times
func Run(const AChar: char; const ACount: int64): string;
begin
  return StringOfChar(AChar, ACount);
end;

// Every line of one kind, AName its label
func ShowKind(const AName: string; const AKind: HashKind);
const
  // The runs of 'a' around the padding's edges
  ADAM_TEST_SIZES: array[0..4] of int64 = [55, 56, 63, 64, 65];
var
  LI: int64;
begin
  println("{} empty {}", AName, DigestToHex(ComputeHash(AKind, "")));
  println("{} abc {}", AName, DigestToHex(ComputeHash(AKind, "abc")));
  println("{} fips {}", AName, DigestToHex(ComputeHash(AKind,
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")));
  for LI := 0 to 4 do
    println("{} {} {}", AName, ADAM_TEST_SIZES[LI],
      DigestToHex(ComputeHash(AKind, Run('a', ADAM_TEST_SIZES[LI]))));
  end;
  println("{} 1000 {}", AName, DigestToHex(ComputeHash(AKind, Run('a', 1000))));
end;

var
  LHasher: Hasher;
  LWhole: string;
  LPieces: bool;
  LReuse: bool;
  LMemory: bool;
  LBytes: ByteArray;
  LI: int64;
begin
  ShowKind("md5", HashKind.MD5);
  ShowKind("sha1", HashKind.SHA1);
  ShowKind("sha256", HashKind.SHA256);
  // 1000 bytes given 1, 2, 3 .. at a time: the digest of them joined
  LHasher := Hasher(HashKind.SHA256);
  LWhole := "";
  LI := 1;
  while len(LWhole) + LI <= 1000 do
    LHasher.Update(Run(char(uint8(0x40 + LI mod 26)), LI));
    LWhole := LWhole + Run(char(uint8(0x40 + LI mod 26)), LI);
    LI := LI + 1;
  end;
  LPieces := DigestToHex(LHasher.Final()) = DigestToHex(ComputeHash(HashKind.SHA256, LWhole));
  // Final starts it over: the next digest is of the next input alone
  LHasher.Update("abc");
  LReuse := DigestToHex(LHasher.Final()) = DigestToHex(ComputeHash(HashKind.SHA256, "abc"));
  // Memory a C library filled: the same digest as the same bytes in an array
  setlength(LBytes, 3);
  LBytes[0] := 0x61;
  LBytes[1] := 0x62;
  LBytes[2] := 0x63;
  LHasher.Update(addr of LBytes[0], len(LBytes));
  LMemory := DigestToHex(LHasher.Final()) = DigestToHex(ComputeHash(HashKind.SHA256, LBytes));
  println("pieces {} reuse {} memory {} size {} {} {}", LPieces, LReuse, LMemory,
    len(ComputeHash(HashKind.MD5, "x")), len(ComputeHash(HashKind.SHA1, "x")),
    len(ComputeHash(HashKind.SHA256, "x")));
  LHasher := Hasher(HashKind.SHA1);
  println("kind {} utf8 {}", LHasher.Kind() = HashKind.SHA1, DigestToHex(ComputeHash(HashKind.SHA256, "Grüße")));
end.
