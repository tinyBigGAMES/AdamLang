-------------------------------------------------------------------------------
  std_sysutils_case.adam - System.SysUtils' jobs added for raylib's text
  routines (PLAN-RAVENAPI R9, sec 7): IsFileNameValid's portable rule
  (every refusal, the 255-byte edge, names that only look like devices),
  PascalCase / CamelCase / SnakeCase over their word rule (separators, a
  capital after a small letter or digit, a run of capitals, UTF-8 kept),
  ReplaceBetween and Between (R10: the slot read, raylib's GetTextBetween;
  the first markers, a missing one, an empty marker, an empty slot), and
  the code point routines: StringToCodepoints /
  StringFromCodepoints both ways (values no character has made U+FFFD),
  Utf8Length, DecodeUtf8CharBefore walking back over valid and malformed
  text. The same lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | names true false false false false false false false false false false false false false true true true false true true
  | pascal [HelloWorld] [XmlFile] [PlayerScoreMax] [] [GrüßeWelt]
  | camel [playerScore] [helloWorld]
  | snake [player_score] [my_http_server2_go] [already_snake] [a_b]
  | between [<b>new</b>] [a[Z]b[y]] [a[x] [a[x]]
  | slot [hi] [x] [] [] [] []
  | codes 5 71 114 252 223 101 back true
  | from 4 11 true
  | length 5 7 0 3
  | walk 128512@3 252@1 97@0
  | bad 65533@1 97@0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_sysutils_case;

import System.SysUtils;

var
  LCodes: CodepointArray;
  LText: string;
  LAt: int64;
  LFirst: uint32;
  LSecond: uint32;
  LThird: uint32;
  LFirstAt: int64;
  LSecondAt: int64;
begin
  print("names {} {} {} {}", IsFileNameValid("save1.sav"), IsFileNameValid(""),
    IsFileNameValid("."), IsFileNameValid(".."));
  print(" {} {} {} {} {}", IsFileNameValid("a/b"), IsFileNameValid("a\\b"), IsFileNameValid("a:b"),
    IsFileNameValid("x?"), IsFileNameValid("tab\t"));
  print(" {} {} {} {} {}", IsFileNameValid("name."), IsFileNameValid("name "), IsFileNameValid("CON"),
    IsFileNameValid("con.txt"), IsFileNameValid("COM1.log"));
  println(" {} {} {} {} {} {}", IsFileNameValid("COM0"), IsFileNameValid("CONSOLE"),
    IsFileNameValid(StringOfChar('a', 255)), IsFileNameValid(StringOfChar('a', 256)),
    IsFileNameValid(".profile"), IsFileNameValid("Grüße.txt"));
  println("pascal [{}] [{}] [{}] [{}] [{}]", PascalCase("hello_world"), PascalCase("XMLFile"),
    PascalCase("player score-max"), PascalCase(""), PascalCase("grüße_welt"));
  println("camel [{}] [{}]", CamelCase("Player Score"), CamelCase("hello_world"));
  println("snake [{}] [{}] [{}] [{}]", SnakeCase("PlayerScore"), SnakeCase("myHTTPServer2Go"),
    SnakeCase("already_snake"), SnakeCase("__a__b"));
  println("between [{}] [{}] [{}] [{}]", ReplaceBetween("<b>old</b>", "<b>", "</b>", "new"),
    ReplaceBetween("a[x]b[y]", "[", "]", "Z"), ReplaceBetween("a[x", "[", "]", "Z"),
    ReplaceBetween("a[x]", "", "]", "Z"));
  println("slot [{}] [{}] [{}] [{}] [{}] [{}]", Between("<b>hi</b>", "<b>", "</b>"),
    Between("a[x]b[y]", "[", "]"), Between("a[x", "[", "]"), Between("a]x", "[", "]"),
    Between("a[x]", "", "]"), Between("a[]b", "[", "]"));
  LCodes := StringToCodepoints("Grüße");
  println("codes {} {} {} {} {} {} back {}", len(LCodes), LCodes[0], LCodes[1], LCodes[2],
    LCodes[3], LCodes[4], StringFromCodepoints(LCodes) = "Grüße");
  // A letter, a lone surrogate, a value past U+10FFFF, an emoji: 1 + 3 + 3 + 4 bytes
  setlength(LCodes, 4);
  LCodes[0] := 0x41;
  LCodes[1] := 0xD800;
  LCodes[2] := 0x110000;
  LCodes[3] := 0x1F600;
  LText := StringFromCodepoints(LCodes);
  println("from {} {} {}", Utf8Length(LText), len(LText), IsUtf8(LText));
  LText := "a" + StringOfChar(char(uint8(0xFF)), 1) + "b";
  println("length {} {} {} {}", Utf8Length("Grüße"), len("Grüße"), Utf8Length(""), Utf8Length(LText));
  LText := "aü😀";
  LAt := len(LText);
  LFirst := DecodeUtf8CharBefore(LText, LAt);
  LFirstAt := LAt;
  LSecond := DecodeUtf8CharBefore(LText, LAt);
  LSecondAt := LAt;
  LThird := DecodeUtf8CharBefore(LText, LAt);
  println("walk {}@{} {}@{} {}@{}", LFirst, LFirstAt, LSecond, LSecondAt, LThird, LAt);
  LText := "a" + StringOfChar(char(uint8(0x80)), 1);
  LAt := len(LText);
  LFirst := DecodeUtf8CharBefore(LText, LAt);
  LFirstAt := LAt;
  LSecond := DecodeUtf8CharBefore(LText, LAt);
  println("bad {}@{} {}@{}", LFirst, LFirstAt, LSecond, LAt);
end.
