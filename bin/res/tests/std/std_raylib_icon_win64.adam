-------------------------------------------------------------------------------
  std_raylib_icon_win64.adam - System.Raylib.Ext.Win64's program icon and its
  watch over the window's first seconds (PLAN-LINUX64 LX3d3f4: a program busy
  when the shell asked for its taskbar icon kept the generic one).

  A hidden raylib window: it holds the @exeicon icon, big and small as
  their own copies; frames read at a normal pace keep those handles; a
  stall (nothing read for 0.6 s) and then frames give it new handles (the
  change that makes the shell take the icon again); after the program's
  own SetWindowIcon a stall leaves the program's icon on the window. The
  window is closed at the end (AV.9).

  Each row prints ok or FAIL with its name; the last is `done <failures>`.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu
  exitcode 0
  | ok icon window opens
  | ok icon stamped
  | ok icon small own copy
  | ok icon kept without a stall
  | ok icon restamped after a stall
  | ok icon program own set
  | ok icon program own kept after a stall
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raylib_icon_win64;

@ifndef TARGET_X86_64_WINDOWS_GNU
@message error "std_raylib_icon_win64 runs on x86_64-windows-gnu only: build it with -t x86_64-windows-gnu";
@endif

// The icon the window must carry ($P: is adam.exe's folder)
@exeicon "$P:res/assets/icons/adam.ico";

import System.SysUtils, System.Windows, System.Raylib.C, System.Raylib.Ext;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The icon the window holds (ICON_BIG or ICON_SMALL), as WM_GETICON answers
func IconOf(const AWindow: uint64; const AKind: uint64): uint64;
begin
  return uint64(SendMessageW(AWindow, WM_GETICON, AKind, 0));
end;

// Frames drawn for ASeconds at a normal pace: each EndDrawing reads the window's messages,
// so the watch's timer ticks with no gap
func Frames(const ASeconds: float64);
var
  LEnd: float64;
begin
  LEnd := GetTime() + ASeconds;
  while GetTime() < LEnd do
    BeginDrawing();
    ClearBackground(BLACK);
    EndDrawing();
  end;
end;

var
  LWindow: uint64;
  LBig: uint64;
  LSmall: uint64;
  LOwn: Image;
  LOwnIcon: uint64;
  LRestamped: uint64;

begin
  SetTraceLogLevel(LOG_NONE);
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  InitWindow(160, 90, "std_raylib_icon_win64");
  Check("icon window opens", IsWindowReady());
  if not IsWindowReady() then
    println("done {}", GFails);
    return 1;
  end;
  LWindow := uint64(GetWindowHandle());
  Frames(0.2);
  LBig := IconOf(LWindow, ICON_BIG);
  LSmall := IconOf(LWindow, ICON_SMALL);
  Check("icon stamped", LBig <> 0);
  Check("icon small own copy", (LSmall <> 0) and (LSmall <> LBig));

  // Messages read all along: the same handles
  Frames(0.5);
  Check("icon kept without a stall", (IconOf(LWindow, ICON_BIG) = LBig) and
    (IconOf(LWindow, ICON_SMALL) = LSmall));

  // A stall (no message read), then frames: new handles, so the shell looks again
  WaitTime(0.6);
  Frames(0.3);
  LRestamped := IconOf(LWindow, ICON_BIG);
  Check("icon restamped after a stall", (LRestamped <> 0) and (LRestamped <> LBig) and
    (IconOf(LWindow, ICON_SMALL) <> 0) and (IconOf(LWindow, ICON_SMALL) <> LSmall));

  // The program's own icon wins, stall or not
  LOwn := GenImageColor(32, 32, RED);
  SetWindowIcon(LOwn);
  UnloadImage(LOwn);
  LOwnIcon := IconOf(LWindow, ICON_BIG);
  Check("icon program own set", (LOwnIcon <> 0) and (LOwnIcon <> LRestamped));
  WaitTime(0.6);
  Frames(0.3);
  Check("icon program own kept after a stall", IconOf(LWindow, ICON_BIG) = LOwnIcon);

  CloseWindow();
  println("done {}", GFails);
end.
