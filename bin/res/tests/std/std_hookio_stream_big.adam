-------------------------------------------------------------------------------
  std_hookio_stream_big.adam - System.HookIO past 4 GiB from C
  (PaskalCPP's std_hookio TestStreamBig)

  A stream of 5 GiB + 32 that stores nothing (CreateIO; each byte made
  from its place) registered under a prefix. The C fixture seeks it from
  the start past 4 GiB, from the end and from the current place by the
  64-bit names (_fseeki64 / _ftelli64, and fseeko64 / ftello64, which
  MinGW's import library aliases to them), reads the bytes there with
  fgetc / getc, and reads ftell's long at a place past 4 GiB (32 bits on
  Windows: -1, EINVAL as ucrt's; 64 bits on linux: the place), slot for slot as the C runtime gives it
  on a real file (the program itself, seeked past its end).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok big register
  | ok big seek from start past 4 GiB
  | ok big fgetc past 4 GiB
  | ok big ftell past 4 GiB
  | ok big ftell long as real file
  | ok big seek from end 64
  | ok big seek from current 64
  | ok big getc near end
  | ok big unregister
  | ok big io close
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_big;

@ifdef TARGET_X86_64_WINDOWS_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

func clink std_hookio_c_big(APath: ptr to const char; AOffset: int64;
  AResults: ptr to int64); external "std_hookio_c";
func clink std_hookio_c_tellpast(APath: ptr to const char; AOffset: int64;
  AResults: ptr to int64); external "std_hookio_c";

type
  // A stream past 4 GiB that stores nothing: it reports CBigSize and makes each byte from its
  // place (BigByte)
  BigData = record
    Position: int64;
  end;

const
  // 5 GiB + 32: past what a 32-bit long or a 32-bit unsigned reaches
  CBigSize: int64 = 5368709152;
  // 4 GiB + 7: where the C fixture seeks first
  CBigOffset: int64 = 4294967303;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The byte the big stream holds at APlace
func BigByte(const APlace: int64): uint8;
begin
  return uint8(APlace mod 251);
end;

func BigRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64;
  var AState: IOState): int64;
var
  LBig: ptr to BigData;
  LOut: ptr to uint8;
  LCount: int64;
  LI: int64;
begin
  LBig := ptr to BigData(AUserData);
  LOut := ptr to uint8(ABuffer);
  LCount := CBigSize - LBig->Position;
  if LCount > ASize then
    LCount := ASize;
  end;
  if LCount < 0 then
    LCount := 0;
  end;
  for LI := 0 to LCount - 1 do
    LOut[LI] := BigByte(LBig->Position + LI);
  end;
  LBig->Position := LBig->Position + LCount;
  if LCount < ASize then
    AState := IOState.Eof;
  end;
  return LCount;
end;

func BigSeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
var
  LBig: ptr to BigData;
  LTarget: int64;
begin
  LBig := ptr to BigData(AUserData);
  LTarget := AOffset;
  if AOrigin = SeekOrigin.FromCurrent then
    LTarget := LBig->Position + AOffset;
  end;
  if AOrigin = SeekOrigin.FromEnd then
    LTarget := CBigSize + AOffset;
  end;
  if (LTarget < 0) or (LTarget > CBigSize) then
    return -1;
  end;
  LBig->Position := LTarget;
  return LTarget;
end;

func BigTell(const AUserData: ptr): int64;
var
  LBig: ptr to BigData;
begin
  LBig := ptr to BigData(AUserData);
  return LBig->Position;
end;

func BigSize(const AUserData: ptr): int64;
begin
  return CBigSize;
end;

// The C fixture's 64-bit run over APath from AOffset: its 7 slots in AResults
func BigC(const APath: string; const AResults: ptr to int64);
begin
  std_hookio_c_big(APath, CBigOffset, AResults);
end;

// The C fixture's ftell past 4 GiB on APath: its 3 slots in AResults
func TellPastC(const APath: string; const AResults: ptr to int64);
begin
  std_hookio_c_tellpast(APath, CBigOffset, AResults);
end;

// The 64-bit forms from C over a stream past 4 GiB (CreateIO, nothing stored): a seek from the
// start, the end and the current place by the 64-bit names, the bytes there, and ftell's long
// at a place past 4 GiB, also against a real file (the program itself) seeked to the same
// place
func TestStreamBig();
var
  LBig: BigData;
  LCallbacks: IOInterface;
  LStream: IO;
  LPrefix: string;
  LResults: array[0..6] of int64;
  LTellVirtual: array[0..2] of int64;
  LTellReal: array[0..2] of int64;
begin
  LBig.Position := 0;
  LCallbacks.Read := BigRead;
  LCallbacks.Write := nil;
  LCallbacks.Seek := BigSeek;
  LCallbacks.Tell := BigTell;
  LCallbacks.Size := BigSize;
  LCallbacks.Flush := nil;
  LCallbacks.Close := nil;
  LCallbacks.Truncate := nil;
  LStream := CreateIO(LCallbacks, ptr(addr of LBig));
  LPrefix := RegisterIO(LStream);
  Check("big register", LPrefix <> "");

  BigC(LPrefix + "/big.bin", addr of LResults[0]);
  Check("big seek from start past 4 GiB", LResults[0] = CBigOffset);
  Check("big fgetc past 4 GiB", LResults[1] = int64(BigByte(CBigOffset)));
@ifdef TARGET_X86_64_LINUX_GNU
  // long is 64 bits: the place after the fgetc, errno untouched
  Check("big ftell past 4 GiB", (LResults[2] = CBigOffset + 1) and (LResults[3] = 0));
@else
  // long is 32 bits: the place does not fit
  Check("big ftell past 4 GiB", (LResults[2] = -1) and (LResults[3] = int64(ADAM_ERRNO_EINVAL)));
@endif

  // ftell's long past 4 GiB, every slot as the C runtime gives it on a real file (the program
  // itself, seeked past its end to the same place)
  TellPastC(LPrefix + "/big.bin", addr of LTellVirtual[0]);
  TellPastC(paramstr(0), addr of LTellReal[0]);
  Check("big ftell long as real file", (LTellVirtual[0] = LTellReal[0]) and
    (LTellVirtual[1] = LTellReal[1]) and (LTellVirtual[2] = LTellReal[2]));
  Check("big seek from end 64", LResults[4] = CBigSize - 16);
  Check("big seek from current 64", LResults[5] = CBigSize - 11);
  Check("big getc near end", LResults[6] = int64(BigByte(CBigSize - 11)));

  Check("big unregister", UnregisterIO(LPrefix));
  Check("big io close", IOClose(LStream));
end;

begin
  GFails := 0;
  TestStreamBig();
  println("done {}", GFails);
end.
