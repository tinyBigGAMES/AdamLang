-------------------------------------------------------------------------------
  std_hookio_stream_direct.adam - System.HookIO's stream calls on a handle
  (PaskalCPP's std_hookio TestStreamDirect)

  The stream family called on a handle straight from Adam, each edge the C
  fixture does not reach: the seek origins and bounds (before the start and
  past a fixed IO's end EINVAL, the place kept), ftell, fgetc then ungetc
  (the byte comes back, ftell moves back), feof only once a read stops
  short, clearerr, a write on a read-only handle (EBADF, ferror), fileno
  (no descriptor: EBADF), setvbuf (a valid mode taken, a bad one -1 with
  EINVAL); then fputc / fputs on an append handle, a read
  there refused as ucrt's _filbuf refuses a writing stream (ferror, errno
  untouched), the bytes landing at fclose.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok direct open
  | ok direct seek end
  | ok direct ftell at end
  | ok direct seek set
  | ok direct ftell after set
  | ok direct seek cur
  | ok direct ftell after cur
  | ok direct seek before start
  | ok direct place after failed seek
  | ok direct seek past end refused
  | ok direct fgetc
  | ok direct ftell after getc
  | ok direct ungetc
  | ok direct ftell after ungetc
  | ok direct fgetc after ungetc
  | ok direct fread 3
  | ok direct bytes 1..3
  | ok direct not eof yet
  | ok direct fread to end
  | ok direct eof set
  | ok direct fread at end
  | ok direct no error
  | ok direct clearerr
  | ok direct write refused
  | ok direct error after bad write
  | ok direct fileno
  | ok direct setvbuf
  | ok direct setvbuf bad mode
  | ok direct close
  | ok direct unregister
  | ok direct io close
  | ok direct write open
  | ok direct fputc
  | ok direct fputs
  | ok direct read refused
  | ok direct write close
  | ok direct wrote bytes
  | ok direct write unregister
  | ok direct write io close
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_direct;

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// fopen of an Adam text path and mode (their C copies freed after the call)
routine OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

// The stream family on a read handle over a fixed memory IO of the digits 0 .. 9 (bytes 48 ..
// 57)
routine TestStreamRead();
var
  LData: array[0..9] of uint8;
  LByte: array[0..9] of uint8;
  LMemory: IO;
  LPrefix: string;
  LFile: ptr;
  LError: int32;
  LOk: bool;
  LI: int32;
begin
  for LI := 0 to 9 do
    LData[LI] := uint8(48 + LI);
  end;
  LMemory := CreateMemoryIO(addr of LData[0], 10, true);
  LPrefix := RegisterIO(LMemory);

  LFile := OpenPath(LPrefix + "/x.bin", "rb");
  Check("direct open", (LFile <> nil) and (FileIO(LFile) = LMemory));
  // Every row below takes the handle: without one they are not run, so the run fails as rows
  // instead of crashing in the C runtime
  if (LFile = nil) or (FileIO(LFile) = nil) then
    if LFile <> nil then
      fclose(LFile);
    end;
    Check("direct handle rows", false);
    UnregisterIO(LPrefix);
    IOClose(LMemory);
    return;
  end;

  // Seek to the end, ftell is the size; seek within; before the start fails
  Check("direct seek end", fseek(LFile, 0, ADAM_HOOKIO_SEEK_END) = 0);
  Check("direct ftell at end", ftell(LFile) = 10);
  Check("direct seek set", fseek(LFile, 3, ADAM_HOOKIO_SEEK_SET) = 0);
  Check("direct ftell after set", ftell(LFile) = 3);
  Check("direct seek cur", fseek(LFile, 2, ADAM_HOOKIO_SEEK_CUR) = 0);
  Check("direct ftell after cur", ftell(LFile) = 5);
  SetCErrno(0);
  LOk := fseek(LFile, -1, ADAM_HOOKIO_SEEK_SET) = -1;
  LError := CErrno();
  Check("direct seek before start", LOk and (LError = ADAM_ERRNO_EINVAL));
  // That failed seek left the place where it was
  Check("direct place after failed seek", ftell(LFile) = 5);
  // A read-only fixed IO refuses a target past its end (EINVAL): HookIO reports what the IO
  // allows, it does not invent room
  SetCErrno(0);
  LOk := fseek(LFile, 20, ADAM_HOOKIO_SEEK_SET) = -1;
  LError := CErrno();
  Check("direct seek past end refused", LOk and (LError = ADAM_ERRNO_EINVAL));

  // fgetc then ungetc: the byte comes back next, and ungetc moves ftell back
  rewind(LFile);
  Check("direct fgetc", fgetc(LFile) = 48);
  Check("direct ftell after getc", ftell(LFile) = 1);
  Check("direct ungetc", ungetc(48, LFile) = 48);
  Check("direct ftell after ungetc", ftell(LFile) = 0);
  Check("direct fgetc after ungetc", fgetc(LFile) = 48);

  // The next 3 bytes (place 1 -> 4); feof is not set until a read stops short
  Check("direct fread 3", fread(addr of LByte[0], 1, 3, LFile) = 3);
  Check("direct bytes 1..3", (LByte[0] = 49) and (LByte[1] = 50) and (LByte[2] = 51));
  Check("direct not eof yet", feof(LFile) = 0);
  // 6 bytes left (place 4 -> 10): ask for 8, get 6, feof set
  Check("direct fread to end", fread(addr of LByte[0], 1, 8, LFile) = 6);
  Check("direct eof set", feof(LFile) <> 0);
  // A read fully at the end gives 0
  Check("direct fread at end", fread(addr of LByte[0], 1, 4, LFile) = 0);
  Check("direct no error", ferror(LFile) = 0);
  clearerr(LFile);
  Check("direct clearerr", feof(LFile) = 0);

  // A write on a read-only handle fails with EBADF, ferror set
  SetCErrno(0);
  LOk := fwrite(addr of LData[0], 1, 1, LFile) = 0;
  LError := CErrno();
  Check("direct write refused", LOk and (LError = ADAM_ERRNO_EBADF));
  Check("direct error after bad write", ferror(LFile) <> 0);

  // fileno has no descriptor
  SetCErrno(0);
  LOk := fileno(LFile) = -1;
  LError := CErrno();
  Check("direct fileno", LOk and (LError = ADAM_ERRNO_EBADF));
  // setvbuf takes a valid mode (4 is _IONBF) and nothing else: ucrt -1 with EINVAL, glibc EOF
  // with errno untouched (measured on a real FILE)
  Check("direct setvbuf", setvbuf(LFile, nil, 4, 0) = 0);
  SetCErrno(0);
  LOk := setvbuf(LFile, nil, 99, 0) = -1;
  LError := CErrno();
@ifdef TARGET_X86_64_WINDOWS_GNU
  Check("direct setvbuf bad mode", LOk and (LError = ADAM_ERRNO_EINVAL));
@else
  Check("direct setvbuf bad mode", LOk and (LError = 0));
@endif

  Check("direct close", fclose(LFile) = 0);
  Check("direct unregister", UnregisterIO(LPrefix));
  Check("direct io close", IOClose(LMemory));
end;

// A writable handle: a fresh growable IO opened "ab" (a registered IO refuses "wb"). fputc /
// fputs write into the FILE's buffer; a read on it is refused; fclose writes the bytes
routine TestStreamWrite();
var
  LByte: array[0..9] of uint8;
  LMemory: IO;
  LPrefix: string;
  LFile: ptr;
  LError: int32;
  LOk: bool;
begin
  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  LFile := OpenPath(LPrefix + "/w.bin", "ab");
  Check("direct write open", (LFile <> nil) and (FileIO(LFile) = LMemory));
  if (LFile = nil) or (FileIO(LFile) = nil) then
    if LFile <> nil then
      fclose(LFile);
    end;
    Check("direct write handle rows", false);
    UnregisterIO(LPrefix);
    IOClose(LMemory);
    return;
  end;
  // 'Z' (90), then "ab"
  Check("direct fputc", fputc(90, LFile) = 90);
  Check("direct fputs", fputs(ptr to const char("ab"), LFile) >= 0);
  // The written bytes are in the buffer: a real ucrt FILE would hand back a stale buffer byte,
  // the handle refuses as ucrt's _filbuf does (ferror, errno untouched)
  SetCErrno(0);
  LOk := fread(addr of LByte[0], 1, 1, LFile) = 0;
  LError := CErrno();
  Check("direct read refused", LOk and (LError = 0) and (ferror(LFile) <> 0));
  Check("direct write close", fclose(LFile) = 0);
  LOk := IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0;
  if LOk then
    LOk := IORead(LMemory, addr of LByte[0], 3) = 3;
  end;
  Check("direct wrote bytes", LOk and (LByte[0] = 90) and (LByte[1] = 97) and (LByte[2] = 98));
  Check("direct write unregister", UnregisterIO(LPrefix));
  Check("direct write io close", IOClose(LMemory));
end;

begin
  GFails := 0;
  TestStreamRead();
  TestStreamWrite();
  println("done {}", GFails);
end.
