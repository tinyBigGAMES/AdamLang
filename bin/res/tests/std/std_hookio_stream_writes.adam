module exe std_hookio_stream_writes;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_wsample(ABuffer: ptr to uint8; ACap: clong): clong;
  external "std_hookio_c";
routine clink std_hookio_c_wcount(): int32; external "std_hookio_c";
routine clink std_hookio_c_wundefined(AVariant: int32): int32; external "std_hookio_c";
routine clink std_hookio_c_writes(APath: ptr to const char; AMode: ptr to const char;
  AVariant: int32; ADefined: int32; AResults: ptr to int64); external "std_hookio_c";

const
  // The write modes WriteMode names
  CWriteModes: int32 = 12;
  // The fixture's result slots: 0 .. 44 the records, 45 fclose, 46 .. 47 what another reader
  // sees after it
  CSlots: int32 = 48;
  // The sample's size
  CSample: int64 = 6000;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// One check of a case: nothing when it held, else a FAIL line naming it, counted in ABad
routine Part(const AName: string; const APart: string; const AOk: bool; var ABad: int32);
begin
  if not AOk then
    println("FAIL {} {}", AName, APart);
    ABad := ABad + 1;
  end;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// The C fixture's write sequence AVariant on APath in AMode (ADefined: with the call C
// requires made): its slots in AResults
routine WritesC(const APath: string; const AMode: string; const AVariant: int32;
  const ADefined: int32; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_writes(LPath, LMode, AVariant, ADefined, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// A write mode by index: "r+t", "r+", "r+b" (update), "at", "a", "ab" (write only), "w+t",
// "w+", "w+b", "a+t", "a+", "a+b" (update); a mode with neither t nor b is text in ucrt
routine WriteMode(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "r+t";
  end;
  if AIndex = 1 then
    return "r+";
  end;
  if AIndex = 2 then
    return "r+b";
  end;
  if AIndex = 3 then
    return "at";
  end;
  if AIndex = 4 then
    return "a";
  end;
  if AIndex = 5 then
    return "ab";
  end;
  if AIndex = 6 then
    return "w+t";
  end;
  if AIndex = 7 then
    return "w+";
  end;
  if AIndex = 8 then
    return "w+b";
  end;
  if AIndex = 9 then
    return "a+t";
  end;
  if AIndex = 10 then
    return "a+";
  end;
  return "a+b";
end;

// True when WriteMode(AIndex) reads as well as writes (a + mode)
routine WriteModeUpdates(const AIndex: int32): bool;
begin
  return (AIndex < 3) or (AIndex >= 6);
end;

// One case: AVariant in WriteMode(AMode), the handle's form AForm (0: the sequence as it is;
// 1: with the call C requires) when the variant is undefined (ADefined 1), against the real
// file with that call made
routine WritesCase(const ASample: ptr to uint8; const ARealPath: string; const AVariant: int32;
  const AMode: int32; const AForm: int32; const ADefined: int32);
var
  LMemory: IO;
  LPrefix: string;
  LVirtual: array[0..47] of int64;
  LReal: array[0..47] of int64;
  LName: string;
  LBad: int32;
begin
  LBad := 0;
  LName := "writes " + IntToStr(AVariant) + " " + WriteMode(AMode);
  if ADefined <> 0 then
    if AForm = 0 then
      LName := LName + " undefined";
    else
      LName := LName + " defined";
    end;
  end;
  LMemory := CreateMemoryIO();
  Part(LName, "io", (IOWrite(LMemory, ptr(ASample), CSample) = CSample) and
    (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0), LBad);
  LPrefix := RegisterIO(LMemory);
  Part(LName, "real file", WriteRaw(ARealPath, ASample, CSample), LBad);
  WritesC(LPrefix + "/w.txt", WriteMode(AMode), AVariant, AForm, addr of LVirtual[0]);
  WritesC(ARealPath, WriteMode(AMode), AVariant, ADefined, addr of LReal[0]);
  Part(LName, "closed", LVirtual[45] = 0, LBad);
  Part(LName, "as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], CSlots), LBad);
  Part(LName, "unregister", UnregisterIO(LPrefix), LBad);
  Part(LName, "io close", IOClose(LMemory), LBad);
  if LBad = 0 then
    println("ok {}", LName);
  end;
  GFails := GFails + LBad;
end;

// The write side from C on a virtual file and on a real file of the same bytes, through every
// write mode, text and binary: every slot equals the real file's. A variant C leaves
// undefined runs on the update modes only, in both forms. The setvbuf variants (3 .. 5) and
// the fprintf one (6) wait for setvbuf and the printf family
routine TestStreamWrites();
var
  LSample: array[0..5999] of uint8;
  LLength: clong;
  LRealPath: string;
  LVariant: int32;
  LMode: int32;
  LForm: int32;
  LDefined: int32;
begin
  LRealPath := paramstr(0) + ".writes.txt";
  LLength := std_hookio_c_wsample(addr of LSample[0], 6000);
  Check("writes sample", int64(LLength) = CSample);
  for LVariant := 0 to std_hookio_c_wcount() - 1 do
    if (LVariant < 3) or (LVariant > 6) then
      LDefined := std_hookio_c_wundefined(LVariant);
      for LMode := 0 to CWriteModes - 1 do
        if (LDefined = 0) or WriteModeUpdates(LMode) then
          for LForm := 0 to LDefined do
            WritesCase(addr of LSample[0], LRealPath, LVariant, LMode, LForm, LDefined);
          end;
        end;
      end;
    end;
  end;
  Check("writes real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestStreamWrites();
  println("done {}", GFails);
end.
