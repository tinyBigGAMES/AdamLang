-------------------------------------------------------------------------------
  std_hookio_exit_flush.adam - System.HookIO's exit flush (PaskalCPP's
  std_hookio TestExitFlush)

  A handle on a memory IO over C's own array is left open with "EXITFLUSH"
  still in ucrt's buffer, and its IO stays registered; a D handle on a
  folder-source entry is left open too. The C fixture's exit check, which
  std_hookio_c_exitarm registers with atexit before any HookIO open, runs
  after the exit flush (registered at the first open: it runs first) and
  ends the program with exit code 97 when the bytes did not land in the
  array, 96 when the D file was not removed. Once both pass it calls the
  program's release, which closes the two FILEs (std_hookio_c_exitclose:
  module variables and HookIO's open list are still there, since each
  module's teardown runs after every exit handler registered later, BNF
  sec 1), unregisters and closes what the rows left open, so the heap
  report at the very end counts none of it.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok exit flush armed
  | ok exit flush left open
  | ok exit temp folder
  | ok exit temp file
  | ok exit temp left open
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_exit_flush;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

routine clink std_hookio_c_exitarray(): ptr to uint8; external "std_hookio_c";
routine clink std_hookio_c_exitarm(ARelease: routine()): int32; external "std_hookio_c";
routine clink std_hookio_c_exitleave(APath: ptr to const char): int32; external "std_hookio_c";
routine clink std_hookio_c_exittemp(APath: ptr to const char; ARealFile: ptr to const char):
  int32; external "std_hookio_c";
routine clink std_hookio_c_exitclose(): int32; external "std_hookio_c";
routine clink std_hookio_c_dirlen(APath: ptr to const char): clong; external "std_hookio_c";
routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";

var
  GFails: int32;
  // What the exit rows leave open, for the release
  GExitMemory: IO;
  GExitPrefix: string;
  GExitSource: IOSource;
  GExitSourcePrefix: string;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The exit check's release, run after it passed: closes the two FILEs the exit rows left
// open (the exit flush already ran on them), then unregisters and closes their IO and
// source, so the heap report at exit counts none of it
routine ExitRelease();
begin
  if std_hookio_c_exitclose() <> 0 then
    println("FAIL exit close");
  end;
  if GExitPrefix <> "" then
    if not UnregisterIO(GExitPrefix) then
      println("FAIL exit unregister");
    end;
  end;
  if GExitMemory <> nil then
    if not IOClose(GExitMemory) then
      println("FAIL exit io close");
    end;
    GExitMemory := nil;
  end;
  if GExitSourcePrefix <> "" then
    if not UnregisterIO(GExitSourcePrefix) then
      println("FAIL exit source unregister");
    end;
  end;
  if GExitSource <> nil then
    if not IOSourceClose(GExitSource) then
      println("FAIL exit source close");
    end;
    GExitSource := nil;
  end;
end;

// The C fixture's open of APath that writes "EXITFLUSH" and leaves the FILE open; 0 when
// both worked
routine LeaveC(const APath: string): int32;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_exitleave(LPath);
  freemem(LPath);
  return LResult;
end;

// The length of APath's folder part (the C fixture's); -1 when it has none
routine DirLength(const APath: string): int64;
var
  LPath: ptr to char;
  LResult: clong;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_dirlen(LPath);
  freemem(LPath);
  return int64(LResult);
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// The C fixture's "rD" open of APath left open; ARealFile must be gone at exit
routine TempC(const APath: string; const ARealFile: string): int32;
var
  LPath: ptr to char;
  LReal: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LReal := StringToC(ARealFile);
  LResult := std_hookio_c_exittemp(LPath, LReal);
  freemem(LPath);
  freemem(LReal);
  return LResult;
end;

// The exit flush: a handle on a memory IO over C's own array is left open with "EXITFLUSH"
// still in ucrt's buffer, and its IO stays registered; a D handle on a folder-source entry
// is left open too. Both are kept in globals for the release
routine TestExitFlush();
var
  LExe: string;
  LLength: int64;
  LFolder: string;
  LSample: array[0..2] of uint8;
begin
  // Read / write over C's array (it never grows: 16 bytes hold the 9)
  GExitMemory := CreateMemoryIO(ptr(std_hookio_c_exitarray()), 16);
  GExitPrefix := RegisterIO(GExitMemory);
  Check("exit flush left open", LeaveC(GExitPrefix + "/x.bin") = 0);
  LExe := paramstr(0);
  LLength := DirLength(LExe);
  Check("exit temp folder", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LFolder := Substring(LExe, 0, LLength);
  GExitSource := CreateFolderIOSource(LFolder);
  GExitSourcePrefix := RegisterIOSource(GExitSource);
  LSample[0] := uint8('a');
  LSample[1] := uint8('b');
  LSample[2] := uint8('c');
  Check("exit temp file", WriteRaw(LFolder + "/exit.tmp", addr of LSample[0], 3));
  Check("exit temp left open", TempC(GExitSourcePrefix + "/exit.tmp", LFolder + "/exit.tmp") = 0);
end;

begin
  GFails := 0;
  // Before any HookIO open: the exit check must run after the exit flush
  GExitMemory := nil;
  GExitPrefix := "";
  GExitSource := nil;
  GExitSourcePrefix := "";
  Check("exit flush armed", std_hookio_c_exitarm(ExitRelease) = 0);
  TestExitFlush();
  println("done {}", GFails);
end.
