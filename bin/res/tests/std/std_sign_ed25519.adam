-------------------------------------------------------------------------------
  std_sign_ed25519.adam - System.Sign's Ed25519 (RFC 8032): test vectors
  1, 2 and 3 of RFC 8032 sec 7.1 (public key, signature, verified) and a
  1000-byte message (its signature from a big-integer reference), the
  same signature twice (deterministic); failure paths: a changed message,
  a flipped signature byte, another key, S + L (the same point, not
  canonical: RFC 8032 sec 5.1.7 refuses it), short signature / key / seed,
  the empty message against a signature of another. Both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | v1 public d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a
  | v1 signature e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b
  | v1 verify true
  | v2 public 3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c
  | v2 signature 92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00
  | v2 verify true
  | v3 public fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025
  | v3 signature 6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a
  | v3 verify true
  | long signature 97943dc3a0fdf5fed713ac650720f61ea0efa784d4812e0ce9a2df673c986b4e3cf58eeb90ced07698fffd248434830d111990e5e62b299bc4651c9427015f07
  | long verify true
  | same twice true
  | changed message false
  | flipped signature false
  | other key false
  | S plus L false
  | short signature false
  | short key false
  | short seed 0
  | empty message false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_sign_ed25519;

import System.SysUtils, System.Hash, System.Sign;

// The value of one lowercase hex digit
func Digit(const AChar: char): int32;
begin
  if (AChar >= '0') and (AChar <= '9') then
    return int32(uint8(AChar)) - 48;
  end;
  return int32(uint8(AChar)) - 87;
end;

// The bytes AHex spells (two lowercase hex digits each)
func Hex(const AHex: string): ByteArray;
var
  LOut: ByteArray;
  LI: int64;
begin
  setlength(LOut, len(AHex) div 2);
  for LI := 0 to len(LOut) - 1 do
    LOut[LI] := uint8(Digit(AHex[2 * LI]) * 16 + Digit(AHex[2 * LI + 1]));
  end;
  return LOut;
end;

// A test vector: its public key, its signature, the signature checked
func Vector(const AName: string; const ASeed: string; const AMessage: string);
var
  LSeed: ByteArray;
  LMessage: ByteArray;
  LPublic: ByteArray;
  LSignature: ByteArray;
begin
  LSeed := Hex(ASeed);
  LMessage := Hex(AMessage);
  LPublic := Ed25519PublicKey(LSeed);
  LSignature := Ed25519Sign(LMessage, LSeed);
  println("{} public {}", AName, DigestToHex(LPublic));
  println("{} signature {}", AName, DigestToHex(LSignature));
  println("{} verify {}", AName, Ed25519Verify(LMessage, LSignature, LPublic));
end;

var
  GSeed: ByteArray;
  GPublic: ByteArray;
  GOther: ByteArray;
  GLong: ByteArray;
  GSignature: ByteArray;
  GBad: ByteArray;
  GEmpty: ByteArray;
  GCarry: int32;
  GI: int64;

begin
  Vector("v1", "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60", "");
  Vector("v2", "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb", "72");
  Vector("v3", "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7", "af82");

  // 1000 bytes 0, 1, .. 255, 0, .. under vector 1's seed
  GSeed := Hex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60");
  GPublic := Ed25519PublicKey(GSeed);
  setlength(GLong, 1000);
  for GI := 0 to 999 do
    GLong[GI] := uint8(GI & 255);
  end;
  GSignature := Ed25519Sign(GLong, GSeed);
  println("long signature {}", DigestToHex(GSignature));
  println("long verify {}", Ed25519Verify(GLong, GSignature, GPublic));
  println("same twice {}", DigestToHex(Ed25519Sign(GLong, GSeed)) = DigestToHex(GSignature));

  GLong[500] := uint8(GLong[500] xor 1);
  println("changed message {}", Ed25519Verify(GLong, GSignature, GPublic));
  GLong[500] := uint8(GLong[500] xor 1);
  GBad := GSignature;
  GBad[10] := uint8(GBad[10] xor 0x40);
  println("flipped signature {}", Ed25519Verify(GLong, GBad, GPublic));
  GOther := Ed25519PublicKey(Hex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"));
  println("other key {}", Ed25519Verify(GLong, GSignature, GOther));

  // S + L: the same scalar mod L, but not below L, so refused (byte-wise add with carry)
  GBad := GSignature;
  GCarry := 0;
  GOther := Hex("edd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010");
  for GI := 0 to 31 do
    GCarry := GCarry + int32(GBad[32 + GI]) + int32(GOther[GI]);
    GBad[32 + GI] := uint8(GCarry & 255);
    GCarry := GCarry shr 8;
  end;
  println("S plus L {}", Ed25519Verify(GLong, GBad, GPublic));

  setlength(GBad, 63);
  for GI := 0 to 62 do
    GBad[GI] := GSignature[GI];
  end;
  println("short signature {}", Ed25519Verify(GLong, GBad, GPublic));
  println("short key {}", Ed25519Verify(GLong, GSignature, Hex("d75a98")));
  println("short seed {}", len(Ed25519Sign(GLong, Hex("9d61"))));
  println("empty message {}", Ed25519Verify(GEmpty, GSignature, GPublic));
end.
