-------------------------------------------------------------------------------
  std_hookio_stream_nolock.adam - ucrt's _nolock names on System.HookIO
  (PaskalCPP's std_hookio TestStreamNoLock, its byte variant)

  The C fixture runs ucrt's lock-free byte names (_fputc_nolock,
  _putc_nolock, _fwrite_nolock, _fflush_nolock, _fseek_nolock,
  _fgetc_nolock, _getc_nolock, _ungetc_nolock, _fread_nolock,
  _ftell_nolock, _fseeki64_nolock, _ftelli64_nolock, _fclose_nolock) under
  the "C" and ".UTF8" locales and each update mode (w+, w+b, w+t), on a
  handle over a memory IO and on a real file beside the program: every
  step (its value, errno, ferror, fwide, ftell and errno after it) and the
  bytes read back equal the real file's.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok nolock 0 C w+ ran
  | ok nolock 0 C w+ as real file
  | ok nolock 0 C w+ unregister
  | ok nolock 0 C w+ io close
  | ok nolock 0 C w+b ran
  | ok nolock 0 C w+b as real file
  | ok nolock 0 C w+b unregister
  | ok nolock 0 C w+b io close
  | ok nolock 0 C w+t ran
  | ok nolock 0 C w+t as real file
  | ok nolock 0 C w+t unregister
  | ok nolock 0 C w+t io close
  | ok nolock 0 .UTF8 w+ ran
  | ok nolock 0 .UTF8 w+ as real file
  | ok nolock 0 .UTF8 w+ unregister
  | ok nolock 0 .UTF8 w+ io close
  | ok nolock 0 .UTF8 w+b ran
  | ok nolock 0 .UTF8 w+b as real file
  | ok nolock 0 .UTF8 w+b unregister
  | ok nolock 0 .UTF8 w+b io close
  | ok nolock 0 .UTF8 w+t ran
  | ok nolock 0 .UTF8 w+t as real file
  | ok nolock 0 .UTF8 w+t unregister
  | ok nolock 0 .UTF8 w+t io close
  | ok nolock real removed
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_nolock;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

routine clink std_hookio_c_nolock(APath: ptr to const char; AMode: ptr to const char;
  ALocale: ptr to const char; AVariant: int32; AResults: ptr to int64); external "std_hookio_c";

const
  // The fixture's result slots: 72 the locale set, 73 the open, 74 the close, 75 .. 140 the
  // bytes read back
  CSlots: int32 = 141;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// The locales the rows run under: "C" and Windows' UTF-8 one
routine Locale(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "C";
  end;
  return ".UTF8";
end;

// The update modes the rows run in: Windows text by default, b and t
routine UpdateMode(const AIndex: int32): string;
begin
  if AIndex = 1 then
    return "w+b";
  end;
  if AIndex = 2 then
    return "w+t";
  end;
  return "w+";
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// The C fixture's _nolock run (the byte variant) on APath in AMode under ALocale: its slots in
// AResults
routine NoLockC(const APath: string; const AMode: string; const ALocale: string;
  const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
  LLocale: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LLocale := StringToC(ALocale);
  std_hookio_c_nolock(LPath, LMode, LLocale, 0, AResults);
  freemem(LPath);
  freemem(LMode);
  freemem(LLocale);
end;

// The lock-free byte names from C under each locale and update mode, on a handle over a memory
// IO and on a real file: every step and the bytes written equal the real file's
routine TestStreamNoLock();
var
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LName: string;
  LVirtual: array[0..140] of int64;
  LReal: array[0..140] of int64;
  LLocale: int32;
  LMode: int32;
begin
  LRealPath := paramstr(0) + ".nolock.txt";
  for LLocale := 0 to 1 do
    for LMode := 0 to 2 do
      LName := "nolock 0 " + Locale(LLocale) + " " + UpdateMode(LMode);
      LMemory := CreateMemoryIO();
      LPrefix := RegisterIO(LMemory);
      RemovePath(LRealPath);
      NoLockC(LPrefix + "/n.txt", UpdateMode(LMode), Locale(LLocale), addr of LVirtual[0]);
      NoLockC(LRealPath, UpdateMode(LMode), Locale(LLocale), addr of LReal[0]);
      Check(LName + " ran", (LVirtual[72] = 1) and (LVirtual[73] = 1) and (LReal[72] = 1) and
        (LReal[73] = 1));
      Check(LName + " as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], CSlots));
      Check(LName + " unregister", UnregisterIO(LPrefix));
      Check(LName + " io close", IOClose(LMemory));
    end;
  end;
  Check("nolock real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestStreamNoLock();
  println("done {}", GFails);
end.
