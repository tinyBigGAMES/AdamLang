-------------------------------------------------------------------------------
  std_runtime_folder.adam - System.Runtime's ListFolder and FileLocalTime

  A folder made in output (two files, one named outside ASCII, an empty
  one, two subfolders) is listed by ListFolder: its names sorted (the
  system's order is no contract), each block's count and its closing NUL
  checked, "." and ".." never listed; the same folder with a trailing '/',
  a subfolder and an empty folder (a block of count 0, never nil); a
  missing folder and a file give nil. FileLocalTime reads a file's and the
  folder's last write time as plausible local fields, a file written later
  never reads earlier, and a missing path gives false with every field 0.
  Everything made is removed at the end. Each row prints ok or FAIL with
  its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok made
  | names [a.txt,b ü€.txt,empty,sub]
  | ok names block
  | slash [a.txt,b ü€.txt,empty,sub]
  | ok slash block
  | sub [c.txt]
  | ok sub block
  | empty []
  | ok empty block
  | missing [<nil>]
  | ok missing block
  | file [<nil>]
  | ok file block
  | ok time read
  | ok time fields
  | ok time folder
  | ok time later
  | ok time missing
  | ok cleaned
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_runtime_folder;

import System.SysUtils, System.Runtime, System.Windows, System.IO;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The names in a ListFolder block (ACount bytes, a NUL after each), sorted
func NamesOf(const ABlock: ptr; const ACount: int64): StringArray;
var
  LText: string;
  LNames: StringArray;
  LName: string;
  LCount: int64;
  LI: int64;
begin
  LText := StringFromC(ptr to const char(ABlock), ACount);
  setlength(LNames, 0);
  LCount := 0;
  LName := "";
  for LI := 0 to ACount - 1 do
    if int32(LText[LI]) = 0 then
      setlength(LNames, LCount + 1);
      LNames[LCount] := LName;
      LCount := LCount + 1;
      LName := "";
    else
      LName := LName + LText[LI];
    end;
  end;
  SortStrings(LNames);
  return LNames;
end;

// The names ListFolder gives for APath, sorted and joined with ",", or "<nil>" when it
// gives nil. AOk: a nil came with ACount 0, else the block's last name ends in a NUL and a
// NUL follows the ACount bytes
func Listed(const APath: string; var AOk: bool): string;
var
  LPath: ptr to char;
  LBlock: ptr;
  LCount: int64;
  LBytes: ptr to uint8;
  LNames: StringArray;
begin
  LPath := StringToC(APath);
  LBlock := ListFolder(ptr to const char(LPath), LCount);
  freemem(LPath);
  if LBlock = nil then
    AOk := LCount = 0;
    return "<nil>";
  end;
  LBytes := ptr to uint8(LBlock);
  AOk := LBytes[LCount] = 0;
  if (LCount > 0) and (LBytes[LCount - 1] <> 0) then
    AOk := false;
  end;
  LNames := NamesOf(LBlock, LCount);
  freemem(LBlock);
  return JoinStrings(LNames, ",");
end;

// FileLocalTime of APath as one number, year to second (yyyymmddhhmmss); AOk its result
// and every field in its range; -1 when it gives false with every field 0
func Stamp(const APath: string; var AOk: bool): int64;
var
  LPath: ptr to char;
  LRead: bool;
  LYear: int32;
  LMonth: int32;
  LDay: int32;
  LHour: int32;
  LMinute: int32;
  LSecond: int32;
begin
  LPath := StringToC(APath);
  LRead := FileLocalTime(ptr to const char(LPath), LYear, LMonth, LDay, LHour, LMinute,
    LSecond);
  freemem(LPath);
  if not LRead then
    AOk := (LYear = 0) and (LMonth = 0) and (LDay = 0) and (LHour = 0) and (LMinute = 0) and
      (LSecond = 0);
    return -1;
  end;
  AOk := (LYear >= 2026) and (LYear < 2200) and (LMonth >= 1) and (LMonth <= 12) and
    (LDay >= 1) and (LDay <= 31) and (LHour >= 0) and (LHour <= 23) and (LMinute >= 0) and
    (LMinute <= 59) and (LSecond >= 0) and (LSecond <= 59);
  return ((((int64(LYear) * 100 + int64(LMonth)) * 100 + int64(LDay)) * 100 +
    int64(LHour)) * 100 + int64(LMinute)) * 100 + int64(LSecond);
end;

func TestFolder();
var
  LDir: string;
  LOk: bool;
  LFirst: int64;
  LFolder: int64;
  LLater: int64;
  LMissing: int64;
begin
  LDir := ResolvePath("$P:std_runtime_folder_d");
  Check("made", ForceDirectories(LDir + "/sub") and ForceDirectories(LDir + "/empty") and
    WriteAllText(LDir + "/a.txt", "hello") and WriteAllText(LDir + "/b ü€.txt", "") and
    WriteAllText(LDir + "/sub/c.txt", "x"));
  println("names [{}]", Listed(LDir, LOk));
  Check("names block", LOk);
  println("slash [{}]", Listed(LDir + "/", LOk));
  Check("slash block", LOk);
  println("sub [{}]", Listed(LDir + "/sub", LOk));
  Check("sub block", LOk);
  println("empty [{}]", Listed(LDir + "/empty", LOk));
  Check("empty block", LOk);
  println("missing [{}]", Listed(LDir + "/none", LOk));
  Check("missing block", LOk);
  println("file [{}]", Listed(LDir + "/a.txt", LOk));
  Check("file block", LOk);

  LFirst := Stamp(LDir + "/a.txt", LOk);
  Check("time read", LFirst > 0);
  Check("time fields", LOk);
  LFolder := Stamp(LDir, LOk);
  Check("time folder", LOk and (LFolder > 0));
  LLater := -1;
  if WriteAllText(LDir + "/sub/later.txt", "later") then
    LLater := Stamp(LDir + "/sub/later.txt", LOk);
  end;
  Check("time later", LOk and (LLater >= LFirst));
  LMissing := Stamp(LDir + "/none.txt", LOk);
  Check("time missing", LOk and (LMissing = -1));

  Check("cleaned", DeleteFile(LDir + "/a.txt") and DeleteFile(LDir + "/b ü€.txt") and
    DeleteFile(LDir + "/sub/c.txt") and DeleteFile(LDir + "/sub/later.txt") and
    RemoveDir(LDir + "/sub") and RemoveDir(LDir + "/empty") and RemoveDir(LDir));
end;

begin
  GFails := 0;
  TestFolder();
  println("done {}", GFails);
end.
