-------------------------------------------------------------------------------
  std_hookio_runtime_stat.adam - Adam's own file queries mean the real file
  system on every target while a path source is active (PLAN-LINUX64
  LX3d3e2): FileExists / FileSize / DirectoryExists of a name only the
  source holds answer the disk (missing), while C's fopen of that name opens
  the source's entry; a real file and folder are found, the same on
  x86_64-windows-gnu and x86_64-linux-gnu.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok source set
  | ok source entry opens in C
  | ok entry not a real file
  | ok entry has no real size
  | ok entry not a real folder
  | ok real file found
  | ok real folder found
  | ok source unset
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_runtime_stat;

@ifdef TARGET_X86_64_WINDOWS_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.IO, System.CustomIO, System.HookIO;

func clink std_hookio_c_read(APath: ptr to const char; ABuffer: ptr to uint8; ACap: clong;
  AReportSize: ptr to clong): clong; external "std_hookio_c";
func clink std_hookio_c_dirlen(APath: ptr to const char): clong; external "std_hookio_c";

const
  ADAM_TEST_ZIP: string = "$P:../../../../res/tests/std/fixtures/std_customio_stored.zip";
  // The fixture's one entry (12 bytes), on no disk the row runs from
  ADAM_TEST_ENTRY: string = "hello.txt";
  ADAM_TEST_SIZE: int64 = 12;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// APath read whole by C's fopen / fread (the C fixture's) into ABuffer (64 bytes): the count,
// -1 when the open fails
func ReadC(const APath: string; const ABuffer: ptr to uint8): int64;
var
  LSize: clong;
  LCount: clong;
begin
  LSize := 0;
  LCount := std_hookio_c_read(APath, ABuffer, 64, addr of LSize);
  return int64(LCount);
end;

// The program's own folder (the C fixture's split of its path), "" when it has none
func ExeFolder(): string;
var
  LExe: string;
  LLength: int64;
begin
  LExe := paramstr(0);
  LLength := int64(std_hookio_c_dirlen(LExe));
  if LLength <= 0 then
    return "";
  end;
  return Substring(LExe, 0, LLength);
end;

var
  LZip: IOSource;
  LBuffer: array[0..63] of uint8;
begin
  LZip := CreateZipIOSource(ADAM_TEST_ZIP);
  Check("source set", (LZip <> nil) and SetIOPathSource(LZip));
  Check("source entry opens in C", ReadC(ADAM_TEST_ENTRY, addr of LBuffer[0]) = ADAM_TEST_SIZE);
  // Adam's own queries are no hook's: the name is on no disk
  Check("entry not a real file", not FileExists(ADAM_TEST_ENTRY));
  Check("entry has no real size", FileSize(ADAM_TEST_ENTRY) = -1);
  Check("entry not a real folder", not DirectoryExists(ADAM_TEST_ENTRY));
  Check("real file found", FileExists(paramstr(0)) and (FileSize(paramstr(0)) > 0));
  Check("real folder found", DirectoryExists(ExeFolder()));
  Check("source unset", SetIOPathSource(nil));
  IOSourceClose(LZip);
  println("done {}", GFails);
end.
