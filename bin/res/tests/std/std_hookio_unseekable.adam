-------------------------------------------------------------------------------
  std_hookio_unseekable.adam - a HookIO handle on an IO that cannot seek (no
  Seek callback) behaves as ucrt's FILE on a real pipe (PLAN-LINUX64
  LX3d3c3x): each case runs the same steps on a real pipe (_pipe + _fdopen,
  which the hooks hand to ucrt) holding the same bytes, and the two
  transcripts (every value, errno and ftell) must match: fseek / ftell with no
  data (the descriptor's place is only a number: the end is 0, a target
  before the start is EINVAL and keeps it), reads with seeks between them
  (reads never move the place; fseek drops the buffer, so its bytes are gone,
  but for the binary fast track inside the buffer), a scan (the stand-in's
  bytes given back) and writes (text and binary: the bytes the pipe gets).
  The pinned values of the no-data table are checked too. A model-only case
  covers lowio's pipe lookahead: a text read whose last byte is '\r' keeps the
  byte after it for the next read.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok seek rt
  | ok seek rb
  | ok seek pinned
  | ok read rt
  | ok read rb
  | ok fast track rb
  | ok fast track rt
  | ok set in buffer rb
  | ok set in buffer rt
  | ok set past buffer rb
  | ok set past buffer rt
  | ok scan rt
  | ok write wt
  | ok write wb
  | ok lookahead other byte
  | ok lookahead newline
  | ok lookahead at the end
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_unseekable;

@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO, System.HookIO.Win64;

routine _pipe(const AFds: ptr to int32; const ASize: uint32; const AMode: int32): int32;
  external "ucrtbase";
routine _fdopen(const AFd: int32; const AMode: ptr to const char): ptr; external "ucrtbase";
routine _write(const AFd: int32; const AData: ptr to const; const ASize: uint32): int32;
  external "ucrtbase";
routine _read(const AFd: int32; const AData: ptr; const ASize: uint32): int32;
  external "ucrtbase";
routine _close(const AFd: int32): int32; external "ucrtbase";
routine _setmode(const AFd: int32; const AMode: int32): int32; external "ucrtbase";
routine clink std_hookio_c_fscanf_file(AFile: ptr; AValue: ptr to int32): int32;
  external "std_hookio_c";

const
  ADAM_TEST_O_TEXT: int32 = 0x4000;
  ADAM_TEST_O_BINARY: int32 = 0x8000;
  ADAM_TEST_DATA: string = "ab\r\ncd\r\nefgh";
  ADAM_TEST_SCAN: string = "12 34";

type
  // The model's pipe: Data read from Place on, at most Chunk bytes per read (0: no limit);
  // Written collects what a write gives it
  Feed = record
    Data: array of uint8;
    Place: int64;
    Chunk: int64;
    Written: array of uint8;
  end;

  // A case's steps, run on one FILE
  Steps = choices(Seek, Read, FastTrack, SetInBuffer, SetPastBuffer, Scan, Write);

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

routine FeedRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64;
  var AState: IOState): int64;
var
  LFeed: ptr to Feed;
  LOut: ptr to uint8;
  LCount: int64;
  LMost: int64;
begin
  LFeed := ptr to Feed(AUserData);
  LOut := ptr to uint8(ABuffer);
  LMost := ASize;
  if (LFeed->Chunk > 0) and (LMost > LFeed->Chunk) then
    LMost := LFeed->Chunk;
  end;
  LCount := 0;
  while (LCount < LMost) and (LFeed->Place < len(LFeed->Data)) do
    LOut[LCount] := LFeed->Data[LFeed->Place];
    LFeed->Place := LFeed->Place + 1;
    LCount := LCount + 1;
  end;
  if LCount = 0 then
    AState := IOState.Eof;
  end;
  return LCount;
end;

routine FeedWrite(const AUserData: ptr; const ABuffer: ptr to const; const ASize: int64;
  var AState: IOState): int64;
var
  LFeed: ptr to Feed;
  LIn: ptr to const uint8;
  LAt: int64;
  LI: int64;
begin
  LFeed := ptr to Feed(AUserData);
  LIn := ptr to const uint8(ABuffer);
  LAt := len(LFeed->Written);
  setlength(LFeed->Written, LAt + ASize);
  for LI := 0 to ASize - 1 do
    LFeed->Written[LAt + LI] := LIn[LI];
  end;
  return ASize;
end;

// The bytes of AText
routine Bytes(const AText: string): array of uint8;
var
  LBytes: array of uint8;
  LI: int64;
begin
  setlength(LBytes, len(AText));
  for LI := 0 to len(AText) - 1 do
    LBytes[LI] := uint8(AText[LI]);
  end;
  return LBytes;
end;

// ABytes as text, each byte a number
routine Show(const ABytes: array of uint8): string;
var
  LText: string;
  LI: int64;
begin
  LText := "[";
  for LI := 0 to len(ABytes) - 1 do
    LText := LText + IntToStr(ABytes[LI]) + " ";
  end;
  return LText + "]";
end;

routine TellStep(const AFile: ptr): string;
var
  LTell: clong;
begin
  SetCErrno(0);
  LTell := ftell(AFile);
  return FormatStr("tell {} {}; ", LTell, CErrno());
end;

routine SeekStep(const AFile: ptr; const AOffset: clong; const AOrigin: int32): string;
var
  LSeek: int32;
begin
  SetCErrno(0);
  LSeek := fseek(AFile, AOffset, AOrigin);
  return FormatStr("seek({}, {}) {} {}; ", AOffset, AOrigin, LSeek, CErrno()) + TellStep(AFile);
end;

routine GetStep(const AFile: ptr): string;
var
  LChar: int32;
begin
  LChar := fgetc(AFile);
  return FormatStr("get {}; ", LChar) + TellStep(AFile);
end;

// Every byte left, then feof / ferror
routine RestStep(const AFile: ptr): string;
var
  LText: string;
  LChar: int32;
begin
  LText := "rest";
  LChar := fgetc(AFile);
  while LChar <> -1 do
    LText := LText + " " + IntToStr(LChar);
    LChar := fgetc(AFile);
  end;
  return LText + FormatStr("; eof {} err {}; ", feof(AFile) <> 0, ferror(AFile) <> 0) +
    TellStep(AFile);
end;

// The steps of ASteps on a reading AFile
routine ReadSteps(const AFile: ptr; const ASteps: Steps): string;
var
  LText: string;
  LBuffer: array[0..15] of uint8;
  LGot: int64;
  LValue: int32;
  LScan: int32;
begin
  LText := "";
  if ASteps = Steps.Seek then
    LText := SeekStep(AFile, 0, 2) + SeekStep(AFile, 5, 0) + SeekStep(AFile, 3, 1) +
      SeekStep(AFile, -2, 2) + SeekStep(AFile, -9, 0);
    return LText;
  end;
  if ASteps = Steps.Scan then
    LValue := 77;
    SetCErrno(0);
    LScan := std_hookio_c_fscanf_file(AFile, addr of LValue);
    LText := FormatStr("scan {} {} {}; ", LScan, LValue, CErrno()) + TellStep(AFile);
    LValue := 77;
    LScan := std_hookio_c_fscanf_file(AFile, addr of LValue);
    LText := LText + FormatStr("scan {} {}; ", LScan, LValue) + TellStep(AFile);
    return LText + RestStep(AFile);
  end;
  LText := GetStep(AFile);
  if ASteps = Steps.Read then
    LGot := fread(addr of LBuffer[0], 1, 3, AFile);
    LText := LText + FormatStr("fread {} {} {} {}; ", LGot, LBuffer[0], LBuffer[1], LBuffer[2]) +
      TellStep(AFile);
    LText := LText + SeekStep(AFile, 0, 0) + GetStep(AFile) + SeekStep(AFile, 2, 1) +
      GetStep(AFile) + SeekStep(AFile, 0, 2) + GetStep(AFile);
  end;
  if ASteps = Steps.FastTrack then
    LText := LText + SeekStep(AFile, 0, 1) + GetStep(AFile);
  end;
  if ASteps = Steps.SetInBuffer then
    LText := LText + SeekStep(AFile, 0, 0) + GetStep(AFile);
  end;
  if ASteps = Steps.SetPastBuffer then
    LText := LText + SeekStep(AFile, 20, 0) + GetStep(AFile);
  end;
  return LText + RestStep(AFile);
end;

// The steps of a writing AFile; the bytes written are the caller's to read
routine WriteSteps(const AFile: ptr): string;
var
  LText: string;
  LLine: ptr to char;
begin
  LLine := StringToC("hi\nyo");
  LText := FormatStr("puts {}; ", fputs(LLine, AFile) >= 0) + TellStep(AFile);
  LText := LText + FormatStr("flush {}; ", fflush(AFile)) + TellStep(AFile);
  LText := LText + SeekStep(AFile, 3, 0);
  LText := LText + FormatStr("puts {}; ", fputs(LLine, AFile) >= 0) + TellStep(AFile);
  freemem(LLine);
  return LText;
end;

// A case on a real pipe: its read end opened in AMode (_pipe in AFlag) after AData was written
// and the write end closed (Seek keeps the write end open with nothing written)
routine RealRead(const AData: string; const AFlag: int32; const AMode: string;
  const ASteps: Steps): string;
var
  LFds: array[0..1] of int32;
  LBytes: array of uint8;
  LMode: ptr to char;
  LPipe: ptr;
  LText: string;
begin
  if _pipe(addr of LFds[0], 4096, AFlag) <> 0 then
    return "no pipe";
  end;
  if ASteps <> Steps.Seek then
    // The bytes go into the pipe as they are (a text write end would add a '\r' per '\n')
    _setmode(LFds[1], ADAM_TEST_O_BINARY);
    LBytes := Bytes(AData);
    if len(LBytes) > 0 then
      _write(LFds[1], addr of LBytes[0], uint32(len(LBytes)));
    end;
    _close(LFds[1]);
  end;
  LMode := StringToC(AMode);
  LPipe := _fdopen(LFds[0], LMode);
  freemem(LMode);
  LText := ReadSteps(LPipe, ASteps);
  fclose(LPipe);
  if ASteps = Steps.Seek then
    _close(LFds[1]);
  end;
  return LText;
end;

// A registered IO over AFeed (Read, and Write when AWrites; never Seek / Tell / Size), opened in
// AMode; nil when the open failed
routine OpenFeed(const AFeed: ptr to Feed; const AWrites: bool; const AMode: string;
  var AIO: IO; var APrefix: string): ptr;
var
  LCallbacks: IOInterface;
  LName: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LCallbacks.Read := FeedRead;
  if AWrites then
    LCallbacks.Write := FeedWrite;
  end;
  AIO := CreateIO(LCallbacks, ptr(AFeed));
  APrefix := RegisterIO(AIO);
  LName := StringToC(APrefix + "/pipe");
  LMode := StringToC(AMode);
  LFile := fopen(LName, LMode);
  freemem(LName);
  freemem(LMode);
  return LFile;
end;

routine CloseFeed(const AFile: ptr; const AIO: IO; const APrefix: string);
begin
  if AFile <> nil then
    fclose(AFile);
  end;
  UnregisterIO(APrefix);
  IOClose(AIO);
end;

// The same case on the model
routine ModelRead(const AData: string; const AMode: string; const ASteps: Steps): string;
var
  LFeed: Feed;
  LIO: IO;
  LPrefix: string;
  LFile: ptr;
  LText: string;
begin
  LFeed.Data := Bytes(AData);
  LFeed.Place := 0;
  LFeed.Chunk := 0;
  LFile := OpenFeed(addr of LFeed, false, AMode, LIO, LPrefix);
  LText := "no open";
  if LFile <> nil then
    LText := ReadSteps(LFile, ASteps);
  end;
  CloseFeed(LFile, LIO, LPrefix);
  return LText;
end;

// A read case on both; the two transcripts must match
routine Both(const AName: string; const AData: string; const AText: bool; const ASteps: Steps);
var
  LReal: string;
  LModel: string;
begin
  if AText then
    LReal := RealRead(AData, ADAM_TEST_O_TEXT, "rt", ASteps);
    LModel := ModelRead(AData, "rt", ASteps);
  else
    LReal := RealRead(AData, ADAM_TEST_O_BINARY, "rb", ASteps);
    LModel := ModelRead(AData, "rb", ASteps);
  end;
  Check(AName, LReal = LModel);
  if LReal <> LModel then
    println("  real  {}", LReal);
    println("  model {}", LModel);
  end;
end;

// A write case on both: the transcripts, then the bytes the pipe got
routine BothWrite(const AName: string; const AText: bool);
var
  LFds: array[0..1] of int32;
  LMode: string;
  LModeC: ptr to char;
  LPipe: ptr;
  LReal: string;
  LGot: array[0..63] of uint8;
  LCount: int32;
  LRealBytes: array of uint8;
  LI: int64;
  LFeed: Feed;
  LIO: IO;
  LPrefix: string;
  LFile: ptr;
  LModel: string;
  LFlag: int32;
begin
  LMode := "wb";
  LFlag := ADAM_TEST_O_BINARY;
  if AText then
    LMode := "wt";
    LFlag := ADAM_TEST_O_TEXT;
  end;
  LReal := "no pipe";
  if _pipe(addr of LFds[0], 4096, LFlag) = 0 then
    LModeC := StringToC(LMode);
    LPipe := _fdopen(LFds[1], LModeC);
    freemem(LModeC);
    LReal := WriteSteps(LPipe);
    fclose(LPipe);
    // The bytes as the pipe holds them (a text read end would drop the '\r' of a "\r\n")
    _setmode(LFds[0], ADAM_TEST_O_BINARY);
    LCount := _read(LFds[0], addr of LGot[0], 64);
    _close(LFds[0]);
    if LCount > 0 then
      setlength(LRealBytes, LCount);
      for LI := 0 to LCount - 1 do
        LRealBytes[LI] := LGot[LI];
      end;
    end;
    LReal := LReal + Show(LRealBytes);
  end;
  LFeed.Place := 0;
  LFeed.Chunk := 0;
  LFile := OpenFeed(addr of LFeed, true, LMode, LIO, LPrefix);
  LModel := "no open";
  if LFile <> nil then
    LModel := WriteSteps(LFile);
    fclose(LFile);
    LFile := nil;
    LModel := LModel + Show(LFeed.Written);
  end;
  CloseFeed(LFile, LIO, LPrefix);
  Check(AName, LReal = LModel);
  if LReal <> LModel then
    println("  real  {}", LReal);
    println("  model {}", LModel);
  end;
end;

// Model only: a text read in chunks of AChunk bytes over AData, every byte fgetc gives
routine Lookahead(const AData: string; const AChunk: int64): string;
var
  LFeed: Feed;
  LIO: IO;
  LPrefix: string;
  LFile: ptr;
  LText: string;
begin
  LFeed.Data := Bytes(AData);
  LFeed.Place := 0;
  LFeed.Chunk := AChunk;
  LFile := OpenFeed(addr of LFeed, false, "rt", LIO, LPrefix);
  LText := "no open";
  if LFile <> nil then
    LText := RestStep(LFile);
  end;
  CloseFeed(LFile, LIO, LPrefix);
  return LText;
end;

begin
  Both("seek rt", "", true, Steps.Seek);
  Both("seek rb", "", false, Steps.Seek);
  // The pinned no-data table (measured on ucrt): the end is 0, places are numbers only
  Check("seek pinned", ModelRead("", "rb", Steps.Seek) =
    "seek(0, 2) 0 0; tell 0 0; seek(5, 0) 0 0; tell 5 0; seek(3, 1) 0 0; tell 8 0; " +
    "seek(-2, 2) -1 22; tell 8 0; seek(-9, 0) -1 22; tell 8 0; ");
  Both("read rt", ADAM_TEST_DATA, true, Steps.Read);
  Both("read rb", ADAM_TEST_DATA, false, Steps.Read);
  Both("fast track rb", ADAM_TEST_DATA, false, Steps.FastTrack);
  Both("fast track rt", ADAM_TEST_DATA, true, Steps.FastTrack);
  Both("set in buffer rb", ADAM_TEST_DATA, false, Steps.SetInBuffer);
  Both("set in buffer rt", ADAM_TEST_DATA, true, Steps.SetInBuffer);
  Both("set past buffer rb", ADAM_TEST_DATA, false, Steps.SetPastBuffer);
  Both("set past buffer rt", ADAM_TEST_DATA, true, Steps.SetPastBuffer);
  Both("scan rt", ADAM_TEST_SCAN, true, Steps.Scan);
  BothWrite("write wt", true);
  BothWrite("write wb", false);
  // lowio's pipe lookahead: "ab\r" then "xy" (the '\r' kept, 'x' handed to the next read);
  // "ab\r" then "\ncd" (the pair is one '\n'); a last '\r' with nothing after it stays
  Check("lookahead other byte", Lookahead("ab\rxy", 3) =
    "rest 97 98 13 120 121; eof true err false; tell 0 0; ");
  Check("lookahead newline", Lookahead("ab\r\ncd", 3) =
    "rest 97 98 10 99 100; eof true err false; tell 0 0; ");
  Check("lookahead at the end", Lookahead("ab\r", 3) =
    "rest 97 98 13; eof true err false; tell 0 0; ");
  println("done {}", GFails);
  ExitCode := GFails;
end.
