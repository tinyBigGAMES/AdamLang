-------------------------------------------------------------------------------
  std_sysutils_pathglob.adam - System.SysUtils' MatchesPathGlob: `**` takes
  none or more whole parts (at the start, the middle, the end, alone, two
  in a row), `*` and `?` stay inside one part (never across a `/`), a mask
  with no `/` names a top-level file only, `\` read as `/` on both sides,
  case-sensitive, literal parts, the empty path and mask. Both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | 1 [README.md] true
  | 2 [docs/a.md] false
  | 3 [docs/a.md] true
  | 4 [a.md] true
  | 5 [x/y/z/a.md] true
  | 6 [bin/res/a.adam] true
  | 7 [bin/res] true
  | 8 [bin/resx/a] false
  | 9 [projects/adam/output/x.exe] true
  | 10 [projects/a/b/output/x] false
  | 11 [a/__pycache__/b/c.pyc] true
  | 12 [__pycache__/c.pyc] true
  | 13 [a/b/c] true
  | 14 [a/c] true
  | 15 [a/b/d] false
  | 16 [a/b/c] true
  | 17 [anything/at/all] true
  | 18 [bin/adam] true
  | 19 [bin/x/adam] false
  | 20 [bin/adam] true
  | 21 [bin/a/m] false
  | 22 [bin\adam] true
  | 23 [bin/adam] true
  | 24 [Bin/adam] false
  | 25 [bin/adam.exe] false
  | 26 [] true
  | 27 [] true
  | 28 [a] false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_sysutils_pathglob;

import System.SysUtils;

// One case: its number, its path and what MatchesPathGlob says (the masks are not printed:
// one such as two stars, a slash, a star ends a block comment, so no expect line may hold it)
func Show(const ACase: int32; const APath: string; const AMask: string);
begin
  println("{} [{}] {}", ACase, APath, MatchesPathGlob(APath, AMask));
end;

begin
  Show(1, "README.md", "*.md");
  Show(2, "docs/a.md", "*.md");
  Show(3, "docs/a.md", "**/*.md");
  Show(4, "a.md", "**/*.md");
  Show(5, "x/y/z/a.md", "**/*.md");
  Show(6, "bin/res/a.adam", "bin/res/**");
  Show(7, "bin/res", "bin/res/**");
  Show(8, "bin/resx/a", "bin/res/**");
  Show(9, "projects/adam/output/x.exe", "projects/*/output/**");
  Show(10, "projects/a/b/output/x", "projects/*/output/**");
  Show(11, "a/__pycache__/b/c.pyc", "**/__pycache__/**");
  Show(12, "__pycache__/c.pyc", "**/__pycache__/**");
  Show(13, "a/b/c", "a/**/c");
  Show(14, "a/c", "a/**/c");
  Show(15, "a/b/d", "a/**/c");
  Show(16, "a/b/c", "a/**/**/c");
  Show(17, "anything/at/all", "**");
  Show(18, "bin/adam", "bin/*");
  Show(19, "bin/x/adam", "bin/*");
  Show(20, "bin/adam", "bin/a?am");
  Show(21, "bin/a/m", "bin/a?m");
  Show(22, "bin\\adam", "bin/adam");
  Show(23, "bin/adam", "bin\\adam");
  Show(24, "Bin/adam", "bin/adam");
  Show(25, "bin/adam.exe", "bin/adam");
  Show(26, "", "");
  Show(27, "", "*");
  Show(28, "a", "");
end.
