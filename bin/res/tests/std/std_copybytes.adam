-------------------------------------------------------------------------------
  std_copybytes.adam - System.Runtime's CopyBytes (one block copy through the
  platform's copy, SU2.8d)

  1048583 pattern bytes (an odd count, no power of two) copied whole are the
  same byte for byte; a copy into the middle of an array changes only the
  bytes it names; a count of 0 and of -1 change nothing; a copy into an
  array that shares its block with another (an assignment) leaves the other
  as it was (addr of makes the block the variable's own: copy on write); a
  copy out of a const parameter's elements (Adam.COFF.Format's ReadSection
  form) is the same as its source. Each row prints ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok big same
  | ok middle copied
  | ok middle kept
  | ok zero count
  | ok negative count
  | ok shared kept
  | ok shared copied
  | ok const source
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_copybytes;

import System.SysUtils, System.Runtime;

const
  // More than a page and no power of two
  BIG_COUNT: int64 = 1048583;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// ACount bytes, each from its index and ASeed, in a pattern no block size divides
func PatternBytes(const ACount: int64; const ASeed: int64): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, ACount);
  for LI := 0 to ACount - 1 do
    LBytes[LI] := uint8((LI * 31 + ASeed) mod 251);
  end;
  return LBytes;
end;

// True when AFirst and ASecond hold the same bytes
func SameBytes(const AFirst: ByteArray; const ASecond: ByteArray): bool;
var
  LI: int64;
begin
  if len(AFirst) <> len(ASecond) then
    return false;
  end;
  for LI := 0 to len(AFirst) - 1 do
    if AFirst[LI] <> ASecond[LI] then
      return false;
    end;
  end;
  return true;
end;

// ASource's ACount bytes from AAt, copied out of the const parameter's elements
func SliceOf(const ASource: ByteArray; const AAt: int64; const ACount: int64): ByteArray;
var
  LSlice: ByteArray;
begin
  setlength(LSlice, ACount);
  if ACount > 0 then
    CopyBytes(addr of LSlice[0], addr of ASource[AAt], ACount);
  end;
  return LSlice;
end;

func Run();
var
  LSource: ByteArray;
  LTarget: ByteArray;
  LTwin: ByteArray;
  LBefore: ByteArray;
  LSlice: ByteArray;
  LOk: bool;
  LI: int64;
begin
  // The whole block
  LSource := PatternBytes(BIG_COUNT, 7);
  setlength(LTarget, BIG_COUNT);
  CopyBytes(addr of LTarget[0], addr of LSource[0], BIG_COUNT);
  Check("big same", SameBytes(LSource, LTarget));

  // Bytes 100 .. 199 of a 300-byte array from the source's 5 .. 104; the rest stays
  LTarget := PatternBytes(300, 3);
  LBefore := PatternBytes(300, 3);
  CopyBytes(addr of LTarget[100], addr of LSource[5], 100);
  LOk := true;
  for LI := 0 to 99 do
    if LTarget[100 + LI] <> LSource[5 + LI] then
      LOk := false;
    end;
  end;
  Check("middle copied", LOk);
  LOk := true;
  for LI := 0 to 299 do
    if ((LI < 100) or (LI > 199)) and (LTarget[LI] <> LBefore[LI]) then
      LOk := false;
    end;
  end;
  Check("middle kept", LOk);

  // No bytes for a count of 0 or less
  LTarget := PatternBytes(16, 3);
  CopyBytes(addr of LTarget[0], addr of LSource[0], 0);
  Check("zero count", SameBytes(LTarget, PatternBytes(16, 3)));
  CopyBytes(addr of LTarget[0], addr of LSource[0], -1);
  Check("negative count", SameBytes(LTarget, PatternBytes(16, 3)));

  // A block shared by an assignment: the copy makes it the target's own first
  LTwin := PatternBytes(64, 11);
  LTarget := LTwin;
  CopyBytes(addr of LTarget[0], addr of LSource[0], 64);
  Check("shared kept", SameBytes(LTwin, PatternBytes(64, 11)));
  LOk := true;
  for LI := 0 to 63 do
    if LTarget[LI] <> LSource[LI] then
      LOk := false;
    end;
  end;
  Check("shared copied", LOk);

  // Out of a const parameter's elements
  LSlice := SliceOf(LSource, 1000, 4096);
  LOk := len(LSlice) = 4096;
  for LI := 0 to len(LSlice) - 1 do
    if LSlice[LI] <> LSource[1000 + LI] then
      LOk := false;
    end;
  end;
  Check("const source", LOk);
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
