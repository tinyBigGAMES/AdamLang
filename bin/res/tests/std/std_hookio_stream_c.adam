-------------------------------------------------------------------------------
  std_hookio_stream_c.adam - System.HookIO's stream family from C
  (PaskalCPP's std_hookio TestStreamC)

  The C fixture (libstd_hookio_c.a) reads a virtual file and the program's
  own real file through one stdio sequence: fopen, fseek to the end, ftell,
  rewind, fgetc, ungetc, fread, ferror, feof, fclose. Both give the same
  bytes and the same ftell size, so a handle answers as ucrt's FILE does
  and a real FILE goes on to the C runtime. fgets from C over a virtual
  text file splits a long line at its buffer; fwrite / fputc / fflush from
  C land their bytes in a writable memory IO.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok stream C register
  | ok stream C read virtual
  | ok stream C ftell size virtual
  | ok stream C virtual bytes
  | ok stream C read real
  | ok stream C real bytes
  | ok stream C real size
  | ok stream C unregister
  | ok stream C io close
  | ok stream C fgets lines
  | ok stream C fgets text
  | ok stream C text unregister
  | ok stream C text io close
  | ok stream C write count
  | ok stream C write landed
  | ok stream C write bytes
  | ok stream C write unregister
  | ok stream C write io close
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_c;

@ifdef TARGET_X86_64_WINDOWS_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

func clink std_hookio_c_read(APath: ptr to const char; ABuffer: ptr to uint8; ACap: clong;
  AReportSize: ptr to clong): clong; external "std_hookio_c";
func clink std_hookio_c_readtext(APath: ptr to const char; AText: ptr to char;
  ACap: clong): clong; external "std_hookio_c";
func clink std_hookio_c_write(APath: ptr to const char; AByte: int32;
  ACount: clong): clong; external "std_hookio_c";

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when the first ACount bytes at AFirst and ASecond are equal
func SameBytes(const AFirst: ptr; const ASecond: ptr; const ACount: int64): bool;
var
  LFirst: ptr to uint8;
  LSecond: ptr to uint8;
  LI: int64;
begin
  LFirst := ptr to uint8(AFirst);
  LSecond := ptr to uint8(ASecond);
  for LI := 0 to ACount - 1 do
    if LFirst[LI] <> LSecond[LI] then
      return false;
    end;
  end;
  return true;
end;

// The C fixture's read of APath (64 bytes at most into ABuffer): its byte count, or -1;
// ASize the size its ftell reported
func ReadC(const APath: string; const ABuffer: ptr to uint8; var ASize: clong): clong;
var
  LSize: clong;
  LCount: clong;
begin
  LSize := -1;
  LCount := std_hookio_c_read(APath, ABuffer, 64, addr of LSize);
  ASize := LSize;
  return LCount;
end;

// The C fixture's fgets read of the text file APath into AText (64 bytes): its line count, or
// -1
func ReadTextC(const APath: string; const AText: ptr to char): clong;
var
  LLines: clong;
begin
  LLines := std_hookio_c_readtext(APath, AText, 64);
  return LLines;
end;

// The C fixture's write of ACount copies of AByte to APath: the count written, or -1
func WriteC(const APath: string; const AByte: int32; const ACount: clong): clong;
var
  LWritten: clong;
begin
  LWritten := std_hookio_c_write(APath, AByte, ACount);
  return LWritten;
end;

// The stream family from C, one fixture for both: a virtual file and the program's own real
// file give the same bytes and the same ftell size; fgets splits a long line; a C write to a
// virtual file lands in the IO
func TestStreamC();
var
  LSource: array[0..63] of uint8;
  LVirtual: array[0..63] of uint8;
  LReal: array[0..63] of uint8;
  LTextBytes: array[0..63] of uint8;
  LCheck: array[0..39] of uint8;
  LTextOut: array[0..63] of char;
  LMemory: IO;
  LTarget: IO;
  LPrefix: string;
  LWritePrefix: string;
  LText: string;
  LVirtualCount: clong;
  LRealCount: clong;
  LVirtualSize: clong;
  LRealSize: clong;
  LLines: clong;
  LWritten: clong;
  LCount: int64;
  LOk: bool;
  LI: int32;
begin
  // A memory IO of known bytes, a NUL among them (binary data)
  for LI := 0 to 63 do
    LSource[LI] := uint8(65 + (LI mod 26));
  end;
  LSource[4] := 0;
  LMemory := CreateMemoryIO(addr of LSource[0], 64, true);
  LPrefix := RegisterIO(LMemory);
  Check("stream C register", LPrefix <> "");

  // The C fixture reads the virtual file, then the program's own real file; both run fseek /
  // ftell / rewind / fgetc / ungetc / fread / ferror / feof
  LVirtualCount := ReadC(LPrefix + "/data.bin", addr of LVirtual[0], LVirtualSize);
  Check("stream C read virtual", LVirtualCount = 64);
  Check("stream C ftell size virtual", LVirtualSize = 64);
  Check("stream C virtual bytes",
    (LVirtualCount = 64) and SameBytes(addr of LVirtual[0], addr of LSource[0], 64));

  LRealCount := ReadC(paramstr(0), addr of LReal[0], LRealSize);
  Check("stream C read real", LRealCount = 64);
  // The real file's first 64 bytes, read through CustomIO, must equal the C fixture's read of
  // it (same calls, a real FILE this time)
  LTarget := CreateFileIO(paramstr(0), FileMode.Read);
  LOk := (LRealCount = 64) and (LTarget <> nil);
  if LOk then
    LOk := IORead(LTarget, addr of LSource[0], 64) = 64;
  end;
  Check("stream C real bytes", LOk and SameBytes(addr of LReal[0], addr of LSource[0], 64));
  Check("stream C real size", (LTarget <> nil) and (int64(LRealSize) = IOSize(LTarget)));
  if LTarget <> nil then
    IOClose(LTarget);
  end;

  Check("stream C unregister", UnregisterIO(LPrefix));
  Check("stream C io close", IOClose(LMemory));

  // fgets from C over a virtual text file: a 6-byte buffer splits the long line, so "ab",
  // "cdefg", "hij" and "k" (each line with its newline) are 4 reads, joined back unchanged
  LText := "ab\ncdefghij\nk";
  LCount := len(LText);
  for LI := 0 to int32(LCount) - 1 do
    LTextBytes[LI] := uint8(LText[LI]);
  end;
  LMemory := CreateMemoryIO(addr of LTextBytes[0], LCount, true);
  LPrefix := RegisterIO(LMemory);
  LLines := ReadTextC(LPrefix + "/t.txt", addr of LTextOut[0]);
  Check("stream C fgets lines", LLines = 4);
  Check("stream C fgets text", (LLines = 4) and (StringFromC(addr of LTextOut[0]) = LText));
  Check("stream C text unregister", UnregisterIO(LPrefix));
  Check("stream C text io close", IOClose(LMemory));

  // C writes 40 bytes to a writable memory IO through fwrite / fputc / fflush
  LTarget := CreateMemoryIO();
  LWritePrefix := RegisterIO(LTarget);
  LWritten := WriteC(LWritePrefix + "/out.bin", 88, 40);
  Check("stream C write count", LWritten = 40);
  LOk := IOSeek(LTarget, 0, SeekOrigin.FromStart) = 0;
  if LOk then
    LOk := IORead(LTarget, addr of LCheck[0], 40) = 40;
  end;
  Check("stream C write landed", LOk);
  LCount := 0;
  for LI := 0 to 39 do
    if LCheck[LI] = 88 then
      LCount := LCount + 1;
    end;
  end;
  Check("stream C write bytes", LCount = 40);
  Check("stream C write unregister", UnregisterIO(LWritePrefix));
  Check("stream C write io close", IOClose(LTarget));
end;

begin
  GFails := 0;
  TestStreamC();
  println("done {}", GFails);
end.
