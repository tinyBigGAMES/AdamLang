-------------------------------------------------------------------------------
  std_ccallback_thread.adam - CCallback<T> (CB1, BNF sec 6) called on a
  thread C made (win64: CreateThread; x86_64-linux-gnu: pthread_create), a
  thread Adam never entered: the callback's outer chain entry enters it
  (its threadstatics, threaded code) and holds its last catching scope. The
  thread's closure counts in a captured local, builds a string there (a
  heap block made and freed on that thread), and runs a nested callback
  (C's qsort with a comparator closure: the inner entry on a thread now
  entered); two threads one after another (each entered and left again).
  The same lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | thread 1 text run 1 sorted 1 2 3 4
  | thread 2 text run 2 sorted 1 2 3 4
  | runs 2 last run 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_ccallback_thread;

import System.SysUtils;

type
  // C's qsort comparator
  Compare = func(const AA: ptr to const int32; const AB: ptr to const int32): int32;
@ifdef TARGET_X86_64_LINUX_GNU
  // pthread_create's start routine
  ThreadMain = func(const AArg: ptr): ptr;
@else
  // CreateThread's start routine (LPTHREAD_START_ROUTINE)
  ThreadMain = func(const AArg: ptr): uint32;
@endif

@ifdef TARGET_X86_64_LINUX_GNU
func qsort(const ABase: ptr; const ACount: uint64; const ASize: uint64;
  const ACompare: Compare); external "c";
func pthread_create(var AThread: uint64; const AAttributes: ptr; const AStart: ThreadMain;
  const AArg: ptr): int32; external "c";
func pthread_join(const AThread: uint64; const AResult: ptr): int32; external "c";
@else
func qsort(const ABase: ptr; const ACount: uint64; const ASize: uint64;
  const ACompare: Compare); external "ucrtbase";
func CreateThread(const AAttributes: ptr; const AStackSize: uint64; const AStart: ThreadMain;
  const AArg: ptr; const AFlags: uint32; const AThreadId: ptr): uint64; external "kernel32";
func WaitForSingleObject(const AHandle: uint64; const AMilliseconds: uint32): uint32;
  external "kernel32";
func CloseHandle(const AHandle: uint64): int32; external "kernel32";

const
  // WaitForSingleObject's wait with no end (winbase.h)
  INFINITE: uint32 = 0xFFFFFFFF;
@endif

var
  GItems: array[0..3] of int32;

// AMain run on a new thread C makes, waited for: true when it started
func RunOnCThread(const AMain: ThreadMain): bool;
var
  LThread: uint64;
begin
@ifdef TARGET_X86_64_LINUX_GNU
  LThread := 0;
  if pthread_create(LThread, nil, AMain, nil) <> 0 then
    return false;
  end;
  pthread_join(LThread, nil);
@else
  LThread := CreateThread(nil, 0, AMain, nil, 0, nil);
  if LThread = 0 then
    return false;
  end;
  WaitForSingleObject(LThread, INFINITE);
  CloseHandle(LThread);
@endif
  return true;
end;

var
  LRuns: int64;
  LLast: string;
  LCompare: CCallback<Compare>;
  LMain: CCallback<ThreadMain>;
  LI: int64;

begin
  LRuns := 0;
  LCompare := CCallback<Compare>(func(const AA: ptr to const int32; const AB: ptr to const int32): int32
    begin
      return AA^ - AB^;
    end);
  // the thread's closure: a count, a string made there, a nested callback
@ifdef TARGET_X86_64_LINUX_GNU
  LMain := CCallback<ThreadMain>(func(const AArg: ptr): ptr
    begin
      LRuns := LRuns + 1;
      LLast := "run " + IntToStr(LRuns);
      GItems[0] := 3;
      GItems[1] := 1;
      GItems[2] := 4;
      GItems[3] := 2;
      qsort(addr of GItems, 4, 4, LCompare.Func());
      return nil;
    end);
@else
  LMain := CCallback<ThreadMain>(func(const AArg: ptr): uint32
    begin
      LRuns := LRuns + 1;
      LLast := "run " + IntToStr(LRuns);
      GItems[0] := 3;
      GItems[1] := 1;
      GItems[2] := 4;
      GItems[3] := 2;
      qsort(addr of GItems, 4, 4, LCompare.Func());
      return 0;
    end);
@endif
  for LI := 1 to 2 do
    if not RunOnCThread(LMain.Func()) then
      println("no thread");
    end;
    println("thread {} text {} sorted {} {} {} {}", LI, LLast, GItems[0], GItems[1], GItems[2],
      GItems[3]);
  end;
  println("runs {} last {}", LRuns, LLast);
end.
