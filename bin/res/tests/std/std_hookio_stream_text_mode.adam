module exe std_hookio_stream_text_mode;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

routine clink std_hookio_c_read(APath: ptr to const char; ABuffer: ptr to uint8; ACap: clong;
  AReportSize: ptr to clong): clong; external "std_hookio_c";
routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_textcount(): int32; external "std_hookio_c";
routine clink std_hookio_c_textsample(AIndex: int32; ABuffer: ptr to uint8; ACap: clong): clong;
  external "std_hookio_c";
routine clink std_hookio_c_textread(APath: ptr to const char; AMode: ptr to const char;
  AResults: ptr to int64); external "std_hookio_c";
routine clink std_hookio_c_textwrite(APath: ptr to const char; AMode: ptr to const char;
  AResults: ptr to int64); external "std_hookio_c";
routine clink std_hookio_c_textupdate(APath: ptr to const char; AResults: ptr to int64);
  external "std_hookio_c";

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

routine SameBytes(const AFirst: ptr; const ASecond: ptr; const ACount: int64): bool;
var
  LFirst: ptr to uint8;
  LSecond: ptr to uint8;
  LI: int64;
begin
  LFirst := ptr to uint8(AFirst);
  LSecond := ptr to uint8(ASecond);
  for LI := 0 to ACount - 1 do
    if LFirst[LI] <> LSecond[LI] then
      return false;
    end;
  end;
  return true;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// True when AIO's bytes equal the real file at APath's (read "rb" by C)
routine SameAsRealFile(const AIO: IO; const APath: string): bool;
var
  LVirtual: array[0..63] of uint8;
  LReal: array[0..63] of uint8;
  LPath: ptr to char;
  LRealSize: clong;
  LReport: clong;
  LSize: int64;
begin
  LPath := StringToC(APath);
  LRealSize := std_hookio_c_read(LPath, addr of LReal[0], 64, addr of LReport);
  freemem(LPath);
  LSize := IOSize(AIO);
  if (LRealSize < 0) or (LSize <> int64(LRealSize)) or (LSize > 64) then
    return false;
  end;
  if IOSeek(AIO, 0, SeekOrigin.FromStart) <> 0 then
    return false;
  end;
  if IORead(AIO, ptr(addr of LVirtual[0]), LSize) <> LSize then
    return false;
  end;
  return SameBytes(ptr(addr of LVirtual[0]), ptr(addr of LReal[0]), LSize);
end;

// A read mode by index: "rt", "r", "rb"
routine TextReadMode(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "rt";
  end;
  if AIndex = 1 then
    return "r";
  end;
  return "rb";
end;

// An append mode by index: "at", "a", "ab"
routine TextWriteMode(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "at";
  end;
  if AIndex = 1 then
    return "a";
  end;
  return "ab";
end;

// The C fixture's text reads of APath in AMode: its 122 slots in AResults
routine TextReadC(const APath: string; const AMode: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_textread(LPath, LMode, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// The C fixture's text writes of APath in AMode: its 7 slots in AResults
routine TextWriteC(const APath: string; const AMode: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_textwrite(LPath, LMode, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// The C fixture's "r+t" write at the end of APath: its 4 slots in AResults
routine TextUpdateC(const APath: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
begin
  LPath := StringToC(APath);
  std_hookio_c_textupdate(LPath, AResults);
  freemem(LPath);
end;

// Text mode from C on a virtual file and on a real file of the same bytes. Every sample
// through "rt", "r" and "rb": every read slot equals the real file's. The write forms through
// "at", "a" and "ab": the same slots, and the IO holds the real file's bytes. "r+t" writing at
// the end of a text that ends in a Ctrl-Z: the same
routine TestStreamTextMode();
var
  LSample: array[0..63] of uint8;
  LLength: clong;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..121] of int64;
  LReal: array[0..121] of int64;
  LIndex: int32;
  LMode: int32;
  LName: string;
  LWritten: int64;
  LPlace: int64;
begin
  LRealPath := paramstr(0) + ".textmode.txt";
  for LIndex := 0 to std_hookio_c_textcount() - 1 do
    LLength := std_hookio_c_textsample(LIndex, addr of LSample[0], 64);
    Check("text sample " + IntToStr(LIndex), LLength > 0);
    LMemory := CreateMemoryIO(addr of LSample[0], int64(LLength), true);
    LPrefix := RegisterIO(LMemory);
    Check("text real file " + IntToStr(LIndex), WriteRaw(LRealPath, addr of LSample[0],
      int64(LLength)));
    for LMode := 0 to 2 do
      LName := "text " + IntToStr(LIndex) + " " + TextReadMode(LMode);
      TextReadC(LPrefix + "/t.txt", TextReadMode(LMode), addr of LVirtual[0]);
      TextReadC(LRealPath, TextReadMode(LMode), addr of LReal[0]);
      Check(LName + " closed", LVirtual[121] = 0);
      Check(LName + " as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 122));
      if (LIndex = 0) and (LMode = 0) then
        // "12\r\n34\rx\r\r\ny", Ctrl-Z, "z\r\n": translated up to the Ctrl-Z on Windows, as it
        // is on Linux
@ifdef TARGET_X86_64_WINDOWS_GNU
        Check(LName + " translated", (LVirtual[0] = 10) and (LVirtual[5] = 10) and
          (LVirtual[8] = 13) and (LVirtual[12] = int64(uint8('y'))));
@else
        Check(LName + " as it is", (LVirtual[0] = 16) and (LVirtual[5] = 13) and
          (LVirtual[6] = 10));
@endif
      end;
    end;
    Check("text unregister " + IntToStr(LIndex), UnregisterIO(LPrefix));
    Check("text io close " + IntToStr(LIndex), IOClose(LMemory));
  end;

  for LMode := 0 to 2 do
    LName := "text write " + TextWriteMode(LMode);
    LMemory := CreateMemoryIO();
    LPrefix := RegisterIO(LMemory);
    // A fresh real file for the append: it may not exist yet
    RemovePath(LRealPath);
    TextWriteC(LPrefix + "/w.txt", TextWriteMode(LMode), addr of LVirtual[0]);
    TextWriteC(LRealPath, TextWriteMode(LMode), addr of LReal[0]);
    Check(LName + " closed", LVirtual[6] = 0);
    Check(LName + " as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 7));
    Check(LName + " bytes as real file", SameAsRealFile(LMemory, LRealPath));
    if LMode = 0 then
      // "a\nb\r\n" "\n" "c\n" "9\n": text mode writes each '\n' as "\r\n" and keeps the '\r'
      // before one ("a\r\nb\r\r\n\r\nc\r\n9\r\n", 15 bytes)
@ifdef TARGET_X86_64_WINDOWS_GNU
      Check(LName + " size", IOSize(LMemory) = 15);
@else
      Check(LName + " size", IOSize(LMemory) = 10);
@endif
    end;
    Check(LName + " unregister", UnregisterIO(LPrefix));
    Check(LName + " io close", IOClose(LMemory));
  end;

  // "xy" and a Ctrl-Z (the last sample), updated at its end
  LLength := std_hookio_c_textsample(std_hookio_c_textcount() - 1, addr of LSample[0], 64);
  LMemory := CreateMemoryIO();
  LWritten := IOWrite(LMemory, ptr(addr of LSample[0]), int64(LLength));
  LPlace := IOSeek(LMemory, 0, SeekOrigin.FromStart);
  Check("text update io", (LWritten = int64(LLength)) and (LPlace = 0));
  LPrefix := RegisterIO(LMemory);
  Check("text update real file", WriteRaw(LRealPath, addr of LSample[0], int64(LLength)));
  TextUpdateC(LPrefix + "/u.txt", addr of LVirtual[0]);
  TextUpdateC(LRealPath, addr of LReal[0]);
  Check("text update closed", LVirtual[3] = 0);
  Check("text update as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 4));
  Check("text update bytes as real file", SameAsRealFile(LMemory, LRealPath));
  Check("text update unregister", UnregisterIO(LPrefix));
  Check("text update io close", IOClose(LMemory));
  Check("text real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestStreamTextMode();
  println("done {}", GFails);
end.
