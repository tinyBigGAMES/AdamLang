-------------------------------------------------------------------------------
  std_hookio_fd_dup_win64.adam - a HookIO handle's CRT descriptor on win64,
  duplicated (PLAN-LINUX64 LX3d3e3a2): _dup giving a number that shares the
  file pointer while its lowio state is its own (its text mode, copied at
  the dup); _dup2 onto a FILE's number making that FILE read the source's
  file, onto a lowio open's number, onto a free number, onto itself, and its
  refusals (a closed source, a target outside the table: EBADF and the
  handler); _fdopen of a dup (its FILE on the number's text mode, fclose
  closing the number) and of a FILE's own number; the opener's fclose with a
  dup left (the IO lives on); a bad _fdopen mode (EINVAL and the handler);
  mingw's oldnames dup / dup2 / fdopen from C (libstd_hookio_c.a) reaching
  the hooks, and a real file's descriptor left to ucrt.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu
  exitcode 0
  | ok dup place shared
  | ok dup own text mode
  | ok dup2 follow file
  | ok dup2 follow lowio
  | ok dup2 free number
  | ok dup2 refused
  | ok fdopen of a dup
  | ok fdopen of fileno
  | ok fdopen refused
  | ok opener closed dup left
  | ok oldnames dup
  | ok real file ucrt
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_fd_dup_win64;

@ifndef TARGET_X86_64_WINDOWS_GNU
@message error "std_hookio_fd_dup_win64 runs on x86_64-windows-gnu only: build it with -t x86_64-windows-gnu";
@endif

@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";

import System.Windows, System.SysUtils, System.Runtime, System.CustomIO, System.HookIO,
  System.HookIO.Win64;

// ucrt's handler of a failed parameter check for this thread (it comes before the process's)
routine _set_thread_local_invalid_parameter_handler(const AHandler: routine(
  const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64)): ptr;
  external "ucrtbase";
// ucrt's remove of a real file
routine remove(const APath: ptr to const char): int32; external "ucrtbase";
// The fixture's descriptor duplicated by a C library's names (mingw's oldnames dup / dup2 /
// fdopen, reaching ucrt's _dup / _dup2 / _fdopen)
routine clink std_hookio_c_lowio_dup(APath: ptr to const char; AResults: ptr to int64);
  external "std_hookio_c";

const
  // ucrt's errno.h
  EBADF: int32 = 9;
  EINVAL: int32 = 22;
  SEEK_SET: int32 = 0;
  SEEK_CUR: int32 = 1;
  ADAM_TEST_ZIP: string = "$P:../../../../res/tests/std/fixtures/std_customio_stored.zip";
  ADAM_TEST_SIZE: int64 = 12;

var
  GFails: int32;
  // The failed parameter checks so far
  GInvalid: int64;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The thread's invalid parameter handler: counts the call and returns (the call then returns
// its failure)
routine OnInvalid(const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64);
begin
  GInvalid := GInvalid + 1;
end;

// A call's failure as ucrt's failed parameter check gives it: -1, errno AError and one more
// handler call since ABefore
routine RefusedWith(const AAnswer: int64; const AError: int32; const ABefore: int64): bool;
begin
  return (AAnswer = -1) and (CErrno() = AError) and (GInvalid = ABefore + 1);
end;

// _open of an Adam text path (its C copy freed after the call)
routine OpenFd(const APath: string; const AFlags: int32): int32;
var
  LPath: ptr to char;
  LFile: int32;
begin
  LPath := StringToC(APath);
  LFile := _open(LPath, AFlags, int32(_S_IREAD | _S_IWRITE));
  freemem(LPath);
  return LFile;
end;

// fopen of an Adam text path and mode
routine OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

// A read / write memory IO of its own holding "a\r\nb" (the bytes copied in: the IO outlives
// this routine), registered (its name in APrefix)
routine TextMemory(var APrefix: string): IO;
var
  LText: array[0..3] of uint8;
  LMemory: IO;
begin
  LText[0] := 97u;
  LText[1] := 13u;
  LText[2] := 10u;
  LText[3] := 98u;
  LMemory := CreateMemoryIO();
  IOWrite(LMemory, addr of LText[0], 4);
  IOSeek(LMemory, 0, SeekOrigin.FromStart);
  APrefix := RegisterIO(LMemory);
  return LMemory;
end;

// A read / write memory IO of its own holding "XY", registered (its name in APrefix)
routine OtherMemory(var APrefix: string): IO;
var
  LText: array[0..1] of uint8;
  LMemory: IO;
begin
  LText[0] := 88u;
  LText[1] := 89u;
  LMemory := CreateMemoryIO();
  IOWrite(LMemory, addr of LText[0], 2);
  IOSeek(LMemory, 0, SeekOrigin.FromStart);
  APrefix := RegisterIO(LMemory);
  return LMemory;
end;

// _dup: one file pointer for both numbers, each closing on its own; then a dup's own text mode
// (copied at the dup, changed apart from the other number)
routine TestDup(const APrefix: string);
var
  LFd: int32;
  LDup: int32;
  LDup2: int32;
  LBuffer: array[0..7] of uint8;
  LOk: bool;
begin
  LFd := OpenFd(APrefix, _O_RDONLY | _O_BINARY);
  LDup := _dup(LFd);
  LOk := (LFd >= 0) and (LDup >= 0) and (LDup <> LFd) and (_read(LFd, addr of LBuffer[0], 1u) = 1) and
    (LBuffer[0] = 97u) and (_telli64(LDup) = 1) and (_read(LDup, addr of LBuffer[0], 1u) = 1) and
    (LBuffer[0] = 13u) and (_telli64(LFd) = 2) and (_close(LDup) = 0) and (_telli64(LFd) = 2) and
    (_close(LFd) = 0);
  Check("dup place shared", LOk);
  // The dup in text mode reads "a\nb", the first number stays binary; a dup of the dup copies
  // its text mode
  LFd := OpenFd(APrefix, _O_RDONLY | _O_BINARY);
  LDup := _dup(LFd);
  LOk := (LDup >= 0) and (_setmode(LDup, _O_TEXT) = _O_BINARY) and
    (_setmode(LFd, _O_BINARY) = _O_BINARY) and (_read(LDup, addr of LBuffer[0], 8u) = 3) and
    (LBuffer[1] = 10u) and (_lseeki64(LFd, 0, SEEK_SET) = 0) and
    (_read(LFd, addr of LBuffer[0], 8u) = 4) and (LBuffer[1] = 13u);
  LDup2 := _dup(LDup);
  LOk := LOk and (LDup2 >= 0) and (_setmode(LDup2, _O_BINARY) = _O_TEXT) and
    (_setmode(LDup, _O_TEXT) = _O_TEXT) and (_close(LDup2) = 0) and (_close(LDup) = 0) and
    (_close(LFd) = 0);
  Check("dup own text mode", LOk);
end;

// _dup2 onto a FILE's number (the FILE then reads the source's file, its own IO left), onto a
// lowio open's number, onto a free number, onto itself; the refusals
routine TestDup2(const APrefix: string);
var
  LOther: IO;
  LOtherPrefix: string;
  LFd: int32;
  LTarget: int32;
  LFile: ptr;
  LBuffer: array[0..7] of uint8;
  LOk: bool;
  LBefore: int64;
begin
  LOther := OtherMemory(LOtherPrefix);
  LFile := OpenPath(LOtherPrefix, "rb");
  LFd := OpenFd(APrefix, _O_RDONLY | _O_BINARY);
  LOk := (LFile <> nil) and (LFd >= 0) and (_dup2(LFd, _fileno(LFile)) = 0) and
    (fread(addr of LBuffer[0], 1, 8, LFile) = 4) and (LBuffer[0] = 97u) and (LBuffer[3] = 98u) and
    (_telli64(LFd) = 4) and (fclose(LFile) = 0) and (_telli64(LFd) = 4) and (IOSize(LOther) = 2);
  Check("dup2 follow file", LOk);
  // A lowio open's number reads the source's bytes at the shared place
  LTarget := OpenFd(LOtherPrefix, _O_RDONLY | _O_BINARY);
  LOk := (LTarget >= 0) and (_lseeki64(LFd, 1, SEEK_SET) = 1) and (_dup2(LFd, LTarget) = 0) and
    (_read(LTarget, addr of LBuffer[0], 1u) = 1) and (LBuffer[0] = 13u) and (_telli64(LFd) = 2) and
    (_close(LTarget) = 0) and (_telli64(LFd) = 2);
  Check("dup2 follow lowio", LOk);
  // A number no one holds (a dup's, closed) gets the source; dup2 onto itself does nothing
  LTarget := _dup(LFd);
  LOk := (LTarget >= 0) and (_close(LTarget) = 0) and (_dup2(LFd, LTarget) = 0) and
    (_lseeki64(LTarget, 0, SEEK_CUR) = 2) and (_read(LTarget, addr of LBuffer[0], 1u) = 1) and
    (LBuffer[0] = 10u) and (_telli64(LFd) = 3) and (_dup2(LFd, LFd) = 0) and (_close(LTarget) = 0);
  Check("dup2 free number", LOk);
  // A target outside ucrt's table; a closed source
  LBefore := GInvalid;
  LOk := RefusedWith(_dup2(LFd, -1), EBADF, LBefore) and
    RefusedWith(_dup2(LFd, 8192), EBADF, LBefore + 1);
  LFile := OpenPath(APrefix, "rb");
  LTarget := _fileno(LFile);
  LOk := LOk and (_close(LTarget) = 0) and RefusedWith(_dup(LTarget), EBADF, LBefore + 2) and
    RefusedWith(_dup2(LTarget, LFd), EBADF, LBefore + 3) and (fclose(LFile) = -1) and
    (_close(LFd) = 0);
  Check("dup2 refused", LOk);
  UnregisterIO(LOtherPrefix);
  IOClose(LOther);
end;

// _fdopen of a dup (its FILE on the number's text mode and file pointer, fclose closing the
// number) and of a FILE's own number; a bad or missing mode, a closed number
routine TestFdopen(const APrefix: string);
var
  LFd: int32;
  LDup: int32;
  LFile: ptr;
  LSecond: ptr;
  LBuffer: array[0..7] of uint8;
  LOk: bool;
  LBefore: int64;
begin
  LFd := OpenFd(APrefix, _O_RDONLY | _O_BINARY);
  LDup := _dup(LFd);
  LFile := _fdopen(LDup, "rb");
  LOk := (LFile <> nil) and (_fileno(LFile) = LDup) and (_setmode(_fileno(LFile), _O_TEXT) = _O_BINARY) and
    (fread(addr of LBuffer[0], 1, 8, LFile) = 3) and (LBuffer[1] = 10u) and (_telli64(LFd) = 4) and
    (fclose(LFile) = 0);
  LBefore := GInvalid;
  LOk := LOk and RefusedWith(_close(LDup), EBADF, LBefore) and (_telli64(LFd) = 4) and
    (_close(LFd) = 0);
  Check("fdopen of a dup", LOk);
  // A second FILE on a FILE's own number: one lowio state (its _setmode is the first FILE's
  // too); its fclose closes the number under the first FILE (that fclose EBADF, the handler)
  LFile := OpenPath(APrefix, "rb");
  LSecond := _fdopen(_fileno(LFile), "rb");
  LOk := (LFile <> nil) and (LSecond <> nil) and (_fileno(LSecond) = _fileno(LFile)) and
    (_setmode(_fileno(LSecond), _O_TEXT) = _O_BINARY) and (_setmode(_fileno(LFile), _O_TEXT) = _O_TEXT) and
    (fread(addr of LBuffer[0], 1, 8, LSecond) = 3) and (fclose(LSecond) = 0);
  LBefore := GInvalid;
  LOk := LOk and (fclose(LFile) = -1) and (CErrno() = EBADF) and (GInvalid = LBefore + 1);
  Check("fdopen of fileno", LOk);
  // ucrt checks the mode first (EINVAL, the handler), then the number
  LFd := OpenFd(APrefix, _O_RDONLY | _O_BINARY);
  LBefore := GInvalid;
  LOk := (_fdopen(LFd, nil) = nil) and (CErrno() = EINVAL) and (GInvalid = LBefore + 1) and
    (_fdopen(LFd, "q") = nil) and (CErrno() = EINVAL) and (GInvalid = LBefore + 2);
  LDup := _dup(LFd);
  LOk := LOk and (_close(LDup) = 0) and (_close(LFd) = 0) and (_fdopen(LFd, "rb") = nil) and
    (CErrno() = EBADF) and (GInvalid = LBefore + 3);
  Check("fdopen refused", LOk);
end;

// The FILE that opened a zip entry closed while a dup of its number is left: the entry's IO
// lives on with the dup, at the shared place, and closes with it
routine TestOpenerClosed(const APrefix: string);
var
  LFile: ptr;
  LDup: int32;
  LBuffer: array[0..15] of uint8;
  LOk: bool;
begin
  LFile := OpenPath(APrefix + "/hello.txt", "rb");
  LDup := -1;
  if LFile <> nil then
    LDup := _dup(_fileno(LFile));
  end;
  LOk := (LDup >= 0) and (fread(addr of LBuffer[0], 1, 1, LFile) = 1) and (fclose(LFile) = 0) and
    (_lseeki64(LDup, 0, SEEK_CUR) = ADAM_TEST_SIZE) and (_lseeki64(LDup, 0, SEEK_SET) = 0) and
    (_read(LDup, addr of LBuffer[0], 16u) = int32(ADAM_TEST_SIZE)) and (_close(LDup) = 0);
  Check("opener closed dup left", LOk);
end;

// mingw's oldnames dup / dup2 / fdopen from C on a lowio open of the memory IO
routine TestOldnames(const APrefix: string);
var
  LPath: ptr to char;
  LResults: array[0..7] of int64;
begin
  LPath := StringToC(APrefix);
  std_hookio_c_lowio_dup(LPath, addr of LResults[0]);
  freemem(LPath);
  Check("oldnames dup", (LResults[0] >= 0) and (LResults[1] >= 0) and (LResults[1] <> LResults[0]) and
    (LResults[2] = 1) and (LResults[3] = 1) and (LResults[4] = 0) and (LResults[5] = 13) and
    (LResults[6] = 0) and (LResults[7] = 0));
end;

// A real file's descriptor: ucrt's _dup / _dup2 / _fdopen
routine TestReal();
var
  LPath: string;
  LCPath: ptr to char;
  LFd: int32;
  LDup: int32;
  LFile: ptr;
  LText: array[0..2] of uint8;
  LOk: bool;
begin
  LText[0] := 97u;
  LText[1] := 98u;
  LText[2] := 99u;
  LPath := paramstr(0) + ".fddup.txt";
  LFd := OpenFd(LPath, _O_RDWR | _O_CREAT | _O_TRUNC | _O_BINARY);
  LDup := _dup(LFd);
  LOk := (LFd >= 0) and (LDup >= 0) and (_write(LFd, addr of LText[0], 3u) = 3) and
    (_telli64(LDup) = 3) and (_dup2(LFd, LDup) = 0) and (_close(LDup) = 0);
  LFile := _fdopen(LFd, "rb");
  LOk := LOk and (LFile <> nil) and (fclose(LFile) = 0);
  LCPath := StringToC(LPath);
  LOk := LOk and (remove(LCPath) = 0);
  freemem(LCPath);
  Check("real file ucrt", LOk);
end;

var
  LZip: IOSource;
  LZipPrefix: string;
  LMemory: IO;
  LPrefix: string;
begin
  _set_thread_local_invalid_parameter_handler(OnInvalid);
  LZip := CreateZipIOSource(ADAM_TEST_ZIP);
  LZipPrefix := RegisterIOSource(LZip);
  LMemory := TextMemory(LPrefix);
  TestDup(LPrefix);
  TestDup2(LPrefix);
  TestFdopen(LPrefix);
  TestOpenerClosed(LZipPrefix);
  TestOldnames(LPrefix);
  TestReal();
  UnregisterIO(LPrefix);
  IOClose(LMemory);
  UnregisterIO(LZipPrefix);
  IOSourceClose(LZip);
  println("done {}", GFails);
end.
