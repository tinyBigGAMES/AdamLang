-------------------------------------------------------------------------------
  std_raylib_video.adam - System.Raylib's MPEG-1 video player (PLAN-LINUX64
  LX3d3c3c, PaskalCPP's std_raylib_ext TestVideo) over the fixture's
  video.mpg (MP2 audio) and video_silent.mpg (none), extracted beside the
  program.

  Window-less first (a video loads and plays before InitWindow): the file,
  IO and zip forms give pl_mpeg's own facts of the same file (size, frame
  rate, duration + one frame, audio, sample rate); the IO form leaves its
  IO open; ten fixed steps reach pl_mpeg's own time after the same steps; a
  video that does not loop stops at its end and says so through the
  callback (Playing, then Stopped); pause and stop; a looping one wraps and
  plays on; the volume is clamped; the silent one plays to its end; a
  missing file, a missing entry and a file that is no MPEG fail to open and
  every routine takes the empty video. No frame is uploaded with no window
  (the GPU / CPU choice waits for one).
  Then a hidden window: the first frame drawn into a render texture of the
  video's size equals pl_mpeg's own CPU conversion of it (within rounding),
  through the shader or the CPU path, whichever this GL gives.

  Each row prints ok or FAIL with its name; the last is `done <failures>`.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok video real files
  | ok video file valid
  | ok video file pl_mpeg reads it
  | ok video file size as pl_mpeg
  | ok video file frame rate as pl_mpeg
  | ok video file duration as pl_mpeg
  | ok video file audio as pl_mpeg
  | ok video file sample rate as pl_mpeg
  | ok video io valid
  | ok video io pl_mpeg reads it
  | ok video io size as pl_mpeg
  | ok video io frame rate as pl_mpeg
  | ok video io duration as pl_mpeg
  | ok video io audio as pl_mpeg
  | ok video io sample rate as pl_mpeg
  | ok video io close
  | ok video zip valid
  | ok video zip pl_mpeg reads it
  | ok video zip size as pl_mpeg
  | ok video zip frame rate as pl_mpeg
  | ok video zip duration as pl_mpeg
  | ok video zip audio as pl_mpeg
  | ok video zip sample rate as pl_mpeg
  | ok video starts stopped
  | ok video steps time as pl_mpeg
  | ok video no window no shader decided
  | ok video not looping
  | ok video playing
  | ok video callback playing
  | ok video play again no callback
  | ok video stopped at end
  | ok video callback stopped
  | ok video paused
  | ok video stopped
  | ok video looping
  | ok video volume
  | ok video volume clamped
  | ok video volume floor
  | ok video looped plays on
  | ok video silent valid
  | ok video silent pl_mpeg reads it
  | ok video silent size as pl_mpeg
  | ok video silent frame rate as pl_mpeg
  | ok video silent duration as pl_mpeg
  | ok video silent audio as pl_mpeg
  | ok video silent stopped at end
  | ok video missing file
  | ok video missing entry
  | ok video not mpeg
  | ok video empty answers
  | ok video window opens
  | ok video first frame as pl_mpeg
  | ok video real files removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raylib_video;

import System.SysUtils, System.CustomIO, System.LibC.C, System.Raylib.C, System.Raylib,
  System.pl_mpeg.C;

const
  // The fixture: raylib_ext's assets (video.mpg, video_silent.mpg, image.png ..)
  ZIP_PATH: string = "$P:../../../../res/tests/std/fixtures/std_raylib_io.zip";

type
  // pl_mpeg's facts of a file (PlmFacts)
  PlmFactList = array[0..5] of float64;

var
  GFails: int32;
  // The video status callback's record: how many calls, the last status
  GStatusCalls: int32;
  GStatusLast: VideoStatus;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

routine WriteAllBytes(const APath: string; const ABytes: ByteArray): bool;
var
  LFile: IO;
  LOk: bool;
begin
  LFile := CreateFileIO(APath, FileMode.Write);
  if LFile = nil then
    return false;
  end;
  LOk := true;
  if len(ABytes) > 0 then
    LOk := IOWriteFull(LFile, addr of ABytes[0], len(ABytes)) = len(ABytes);
  end;
  return IOClose(LFile) and LOk;
end;

// Removes the real file at APath (through a folder source on its folder)
routine DeleteFile(const APath: string): bool;
var
  LFolder: IOSource;
  LOk: bool;
begin
  LFolder := CreateFolderIOSource(ExtractFileDir(APath));
  if LFolder = nil then
    return false;
  end;
  LOk := IOSourceRemove(LFolder, ExtractFileName(APath));
  return IOSourceClose(LFolder) and LOk;
end;

// The zip entry AEntry copied to a real file at APath
routine Extract(const AEntry: string; const APath: string): bool;
var
  LIO: IO;
  LAll: string;
  LBytes: ByteArray;
  LI: int64;
  LOk: bool;
begin
  LIO := CreateZipFileIO(ZIP_PATH, AEntry);
  if LIO = nil then
    return false;
  end;
  LOk := IOReadAll(LIO, LAll);
  IOClose(LIO);
  if not LOk then
    return false;
  end;
  setlength(LBytes, len(LAll));
  for LI := 0 to len(LAll) - 1 do
    LBytes[LI] := uint8(LAll[LI]);
  end;
  return WriteAllBytes(APath, LBytes);
end;

// pl_mpeg's own read of an MPEG-1 file, the reference the rows compare against: AFacts gets
// width, height, frame rate, duration, audio streams, sample rate; false when pl_mpeg cannot
// open it
routine PlmFacts(const APath: string; var AFacts: PlmFactList): bool;
var
  LName: ptr to char;
  LPlm: ptr to plm_t;
begin
  LName := StringToC(APath);
  LPlm := plm_create_with_filename(LName);
  freemem(LName);
  if LPlm = nil then
    return false;
  end;
  AFacts[0] := float64(plm_get_width(LPlm));
  AFacts[1] := float64(plm_get_height(LPlm));
  AFacts[2] := plm_get_framerate(LPlm);
  AFacts[3] := plm_get_duration(LPlm);
  AFacts[4] := float64(plm_get_num_audio_streams(LPlm));
  AFacts[5] := float64(plm_get_samplerate(LPlm));
  plm_destroy(LPlm);
  return true;
end;

// The reference's decode callbacks: raylib's player decodes video and audio, so the
// reference does too (its time then moves the same way)
routine clink PlmOnVideo(self_: ptr to plm_t; frame: ptr to plm_frame_t; user: ptr);
begin
end;

routine clink PlmOnAudio(self_: ptr to plm_t; samples: ptr to plm_samples_t; user: ptr);
begin
end;

// pl_mpeg's time after ASteps decode steps of AStep seconds from the start (-1 when it
// cannot open the file)
routine PlmTime(const APath: string; const ASteps: int32; const AStep: float64): float64;
var
  LName: ptr to char;
  LPlm: ptr to plm_t;
  LTime: float64;
  LI: int32;
begin
  LName := StringToC(APath);
  LPlm := plm_create_with_filename(LName);
  freemem(LName);
  if LPlm = nil then
    return -1.0;
  end;
  plm_set_video_decode_callback(LPlm, PlmOnVideo, nil);
  plm_set_audio_decode_callback(LPlm, PlmOnAudio, nil);
  for LI := 1 to ASteps do
    plm_decode(LPlm, AStep);
  end;
  LTime := plm_get_time(LPlm);
  plm_destroy(LPlm);
  return LTime;
end;

// The largest colour-channel difference between AImage (RGBA8, the video's size) and
// pl_mpeg's own CPU conversion (plm_frame_to_rgba) of the file's first frame; -1 when either
// is missing or the sizes differ. The shader path does the same Rec. 601 matrix in float,
// pl_mpeg in integer steps: a few units of rounding apart, never a different picture.
routine PlmFrameDiff(const AImage: Image; const APath: string): int32;
var
  LName: ptr to char;
  LPlm: ptr to plm_t;
  LFrame: ptr to plm_frame_t;
  LOwn: ptr to uint8;
  LDrawn: ptr to uint8;
  LSize: int64;
  LI: int64;
  LDiff: int32;
  LMax: int32;
begin
  LName := StringToC(APath);
  LPlm := plm_create_with_filename(LName);
  freemem(LName);
  if LPlm = nil then
    return -1;
  end;
  LMax := -1;
  LFrame := plm_decode_video(LPlm);
  if (LFrame <> nil) and (AImage.data <> nil) then
    if (AImage.format = PIXELFORMAT_UNCOMPRESSED_R8G8B8A8) and
      (AImage.width = int32(LFrame^.width)) and (AImage.height = int32(LFrame^.height)) then
      LSize := int64(LFrame^.width) * int64(LFrame^.height) * 4;
      LOwn := ptr to uint8(getmem(LSize));
      memset(LOwn, 255, uint64(LSize));
      plm_frame_to_rgba(LFrame, LOwn, int32(LFrame^.width) * 4);
      LDrawn := ptr to uint8(AImage.data);
      LMax := 0;
      for LI := 0 to LSize - 1 do
        // The alpha bytes are not compared
        if LI mod 4 <> 3 then
          LDiff := int32(LOwn[LI]) - int32(LDrawn[LI]);
          if LDiff < 0 then
            LDiff := -LDiff;
          end;
          if LDiff > LMax then
            LMax := LDiff;
          end;
        end;
      end;
      freemem(LOwn);
    end;
  end;
  plm_destroy(LPlm);
  return LMax;
end;

// The video status callback: every change counted, the last one kept
routine OnVideoStatus(const AStatus: VideoStatus; const AName: ptr to const char);
begin
  GStatusCalls := GStatusCalls + 1;
  GStatusLast := AStatus;
end;

// A video's facts against pl_mpeg's own read of the same file
routine CheckVideoFacts(const AName: string; const AVideo: Video; const APath: string);
var
  LFacts: PlmFactList;
begin
  Check(AName + " valid", IsVideoValid(AVideo));
  Check(AName + " pl_mpeg reads it", PlmFacts(APath, LFacts));
  Check(AName + " size as pl_mpeg", (float64(AVideo.width) = LFacts[0]) and
    (float64(AVideo.height) = LFacts[1]));
  Check(AName + " frame rate as pl_mpeg", GetVideoFrameRate(AVideo) = LFacts[2]);
  // pl_mpeg's duration is the last frame's start; the video plays one frame past it
  Check(AName + " duration as pl_mpeg", GetVideoDuration(AVideo) = LFacts[3] + 1.0 / LFacts[2]);
  Check(AName + " audio as pl_mpeg", HasVideoAudio(AVideo) = (LFacts[4] > 0.0));
  if LFacts[4] > 0.0 then
    Check(AName + " sample rate as pl_mpeg", float64(GetVideoSampleRate(AVideo)) = LFacts[5]);
  end;
end;

// Plays AVideo for ASteps fixed steps of 0.04 s
routine StepVideo(const AVideo: Video; const ASteps: int32);
var
  LI: int32;
begin
  for LI := 1 to ASteps do
    UpdateVideo(AVideo, 0.04);
  end;
end;

// Everything that needs no window
routine TestWindowless(const APath: string; const ASilentPath: string; const ANotVideo: string);
var
  LVideo: Video;
  LEmpty: Video;
  LIO: IO;
begin
  // The three forms
  LVideo := LoadVideo(APath);
  CheckVideoFacts("video file", LVideo, APath);
  UnloadVideo(LVideo);
  LIO := CreateZipFileIO(ZIP_PATH, "video.mpg");
  LVideo := LoadVideoIO(LIO, "video.mpg");
  CheckVideoFacts("video io", LVideo, APath);
  UnloadVideo(LVideo);
  Check("video io close", (LIO <> nil) and IOClose(LIO));
  LVideo := LoadVideoZip(ZIP_PATH, "video.mpg", "");
  CheckVideoFacts("video zip", LVideo, APath);

  // Ten fixed steps: pl_mpeg's own time after the same steps
  Check("video starts stopped", (GetVideoStatus(LVideo) = VideoStatus.VideoStopped) and
    (GetVideoTime(LVideo) = 0.0));
  PlayVideo(LVideo);
  StepVideo(LVideo, 10);
  Check("video steps time as pl_mpeg", GetVideoTime(LVideo) = PlmTime(APath, 10, 0.04));
  Check("video no window no shader decided", not IsVideoShaderUsed(LVideo));
  UnloadVideo(LVideo);

  // Not looping: stops at its end, the callback says Playing then Stopped
  LVideo := LoadVideo(APath);
  GStatusCalls := 0;
  SetVideoStatusCallback(LVideo, OnVideoStatus);
  SetVideoLooping(LVideo, false);
  Check("video not looping", not IsVideoLooping(LVideo));
  PlayVideo(LVideo);
  Check("video playing", IsVideoPlaying(LVideo) and
    (GetVideoStatus(LVideo) = VideoStatus.VideoPlaying));
  Check("video callback playing", (GStatusCalls = 1) and
    (GStatusLast = VideoStatus.VideoPlaying));
  PlayVideo(LVideo);
  Check("video play again no callback", GStatusCalls = 1);
  StepVideo(LVideo, 75);
  Check("video stopped at end", (not IsVideoPlaying(LVideo)) and
    (GetVideoStatus(LVideo) = VideoStatus.VideoStopped));
  Check("video callback stopped", (GStatusCalls = 2) and
    (GStatusLast = VideoStatus.VideoStopped));
  PlayVideo(LVideo);
  PauseVideo(LVideo);
  Check("video paused", GetVideoStatus(LVideo) = VideoStatus.VideoPaused);
  StopVideo(LVideo);
  Check("video stopped", (GetVideoStatus(LVideo) = VideoStatus.VideoStopped) and
    (GetVideoTime(LVideo) = 0.0));
  UnloadVideo(LVideo);

  // Looping: past its end it wraps and plays on
  LVideo := LoadVideo(APath);
  SetVideoLooping(LVideo, true);
  Check("video looping", IsVideoLooping(LVideo));
  SetVideoVolume(LVideo, 0.5f);
  Check("video volume", GetVideoVolume(LVideo) = 0.5f);
  SetVideoVolume(LVideo, 2.0f);
  Check("video volume clamped", GetVideoVolume(LVideo) = 1.0f);
  SetVideoVolume(LVideo, -1.0f);
  Check("video volume floor", GetVideoVolume(LVideo) = 0.0f);
  PlayVideo(LVideo);
  StepVideo(LVideo, 75);
  Check("video looped plays on", IsVideoPlaying(LVideo) and
    (GetVideoTime(LVideo) < GetVideoDuration(LVideo)));
  UnloadVideo(LVideo);

  // No audio track: plays silently to its end
  LVideo := LoadVideo(ASilentPath);
  CheckVideoFacts("video silent", LVideo, ASilentPath);
  PlayVideo(LVideo);
  StepVideo(LVideo, 75);
  Check("video silent stopped at end", GetVideoStatus(LVideo) = VideoStatus.VideoStopped);
  UnloadVideo(LVideo);

  // What does not open
  LVideo := LoadVideo(paramstr(0) + ".missing.mpg");
  Check("video missing file", not IsVideoValid(LVideo));
  UnloadVideo(LVideo);
  LVideo := LoadVideoZip(ZIP_PATH, "missing.mpg", "");
  Check("video missing entry", not IsVideoValid(LVideo));
  UnloadVideo(LVideo);
  LVideo := LoadVideo(ANotVideo);
  Check("video not mpeg", not IsVideoValid(LVideo));
  UnloadVideo(LVideo);

  // The empty video: every routine does nothing, giving 0, false or VideoStopped
  PlayVideo(LEmpty);
  UpdateVideo(LEmpty);
  UpdateVideo(LEmpty, 0.04);
  PauseVideo(LEmpty);
  StopVideo(LEmpty);
  SetVideoLooping(LEmpty, true);
  SetVideoVolume(LEmpty, 0.5f);
  SetVideoStatusCallback(LEmpty, OnVideoStatus);
  DrawVideo(LEmpty, 0, 0, WHITE);
  Check("video empty answers", (not IsVideoValid(LEmpty)) and
    (GetVideoStatus(LEmpty) = VideoStatus.VideoStopped) and (not IsVideoLooping(LEmpty)) and
    (GetVideoVolume(LEmpty) = 0.0f) and (GetVideoFrameRate(LEmpty) = 0.0) and
    (GetVideoDuration(LEmpty) = 0.0) and (GetVideoTime(LEmpty) = 0.0) and
    (not HasVideoAudio(LEmpty)) and (GetVideoSampleRate(LEmpty) = 0) and
    (not IsVideoShaderUsed(LEmpty)) and (LEmpty.width = 0) and (LEmpty.height = 0));
  UnloadVideo(LEmpty);
end;

// The first frame drawn into a render texture of the video's size, read back, against
// pl_mpeg's own conversion
routine TestFirstFrame(const APath: string);
var
  LVideo: Video;
  LTarget: RenderTexture2D;
  LImage: Image;
  LDiff: int32;
begin
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  InitWindow(160, 90, "std_raylib_video");
  Check("video window opens", IsWindowReady());
  if not IsWindowReady() then
    return;
  end;
  LVideo := LoadVideo(APath);
  PlayVideo(LVideo);
  UpdateVideo(LVideo, 0.001);
  LTarget := LoadRenderTexture(LVideo.width, LVideo.height);
  BeginTextureMode(LTarget);
  ClearBackground(BLACK);
  DrawVideo(LVideo, 0, 0, WHITE);
  EndTextureMode();
  LImage := LoadImageFromTexture(LTarget.texture);
  // A render texture's rows come back bottom first
  ImageFlipVertical(addr of LImage);
  LDiff := PlmFrameDiff(LImage, APath);
  Check("video first frame as pl_mpeg", (LDiff >= 0) and (LDiff <= 4));
  UnloadImage(LImage);
  UnloadRenderTexture(LTarget);
  UnloadVideo(LVideo);
  CloseWindow();
end;

var
  LPath: string;
  LSilentPath: string;
  LNotVideo: string;

begin
  SetTraceLogLevel(LOG_NONE);
  InitAudioDevice();
  LPath := paramstr(0) + ".video.mpg";
  LSilentPath := paramstr(0) + ".silent.mpg";
  LNotVideo := paramstr(0) + ".notvideo.mpg";
  Check("video real files", Extract("video.mpg", LPath) and
    Extract("video_silent.mpg", LSilentPath) and Extract("image.png", LNotVideo));
  TestWindowless(LPath, LSilentPath, LNotVideo);
  TestFirstFrame(LPath);
  if IsAudioDeviceReady() then
    CloseAudioDevice();
  end;
  Check("video real files removed", DeleteFile(LPath) and DeleteFile(LSilentPath) and
    DeleteFile(LNotVideo));
  println("done {}", GFails);
end.
