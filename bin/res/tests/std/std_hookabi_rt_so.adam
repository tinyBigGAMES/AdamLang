-------------------------------------------------------------------------------
  std_hookabi_rt_so.adam - a hooking shared object unloaded by its host
  (PLAN-LINUX64 LX4f2, x86_64-linux-gnu): std_hookabi_rt_so_lib, dlopen'd,
  installs a hook of getenv through its own runtime (the GOT path: its
  table is empty), so the program's own getenv answers "so-hooked"; the
  program dlcloses it with the hook still installed: its unload gives every
  slot back, and the program's getenv is real again (nothing reaches the
  unmapped object).

  Each row prints ok or FAIL with its name; the last is `done <failures>`.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  deps std.std_hookabi_rt_so_lib
  exitcode 0
  | ok set real
  | ok load
  | ok install
  | ok own call hooked
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | ok close
  | ok own call real
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

@ifndef TARGET_X86_64_LINUX_GNU
@message error "std_hookabi_rt_so runs on x86_64-linux-gnu only";
@endif

module exe std_hookabi_rt_so;

type
  // The library's install
  InstallFn = func(): bool;

// glibc: the environment read and set, two C texts compared, a library opened, an export
// found, a library closed
func getenv(const AName: ptr to const char): ptr to const char; external "c";
func setenv(const AName: ptr to const char; const AValue: ptr to const char;
  const AReplace: int32): int32; external "c";
func strcmp(const ALeft: ptr to const char; const ARight: ptr to const char): int32;
  external "c";
func dlopen(const AFile: ptr to const char; const AMode: int32): ptr; external "c";
func dlsym(const AHandle: ptr; const AName: ptr to const char): ptr; external "c";
func dlclose(const AHandle: ptr): int32; external "c";

const
  // dlfcn.h: every symbol bound at the load, the library's symbols its own
  RTLD_NOW: int32 = 2;
  RTLD_LOCAL: int32 = 0;

var
  // The failures seen
  GFails: int64;

// AName printed as ok or FAIL (a failure counted)
func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when the program's own getenv of STD_HOOKABI_SO answers AWant
func OwnIs(const AWant: ptr to const char): bool;
var
  LValue: ptr to const char;
begin
  LValue := getenv("STD_HOOKABI_SO");
  return (LValue <> nil) and (strcmp(LValue, AWant) = 0);
end;

var
  LLibrary: ptr;
  LProc: ptr;
  LInstall: InstallFn;

begin
  GFails := 0;
  Check("set real", setenv("STD_HOOKABI_SO", "real", 1) = 0);
  LLibrary := dlopen("libstd_hookabi_rt_so_lib.so", RTLD_NOW | RTLD_LOCAL);
  Check("load", LLibrary <> nil);
  if LLibrary <> nil then
    LProc := dlsym(LLibrary, "SoInstall");
    LInstall := InstallFn(LProc);
    Check("install", (LProc <> nil) and LInstall());
    Check("own call hooked", OwnIs("so-hooked"));
    Check("close", dlclose(LLibrary) = 0);
  end;
  Check("own call real", OwnIs("real"));
  println("done {}", GFails);
end.
