-------------------------------------------------------------------------------
  std_hookio_zip.adam - System.HookIO over a registered zip IOSource
  (PaskalCPP's std_hookio TestZip)

  A zip IOSource (res\tests\std\fixtures\std_customio_stored.zip, the
  CustomIO rows' fixture) registered under a prefix: entries opened through
  it (the handle owns the entry's IO), the bytes equal CreateZipFileIO's
  (read through the entry's IO and with fread on the handle), a nested
  entry, and every refusal of an entry: missing (ENOENT), a mode the source
  does not offer (EACCES), a path the source refuses (ENOENT), ucrt's D on a
  source that cannot remove entries (EACCES; glibc has no D: the entry
  opens), and any open after the unregister (ENOENT).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok zip register
  | ok zip open ours
  | ok zip entry size
  | ok zip entry bytes
  | ok zip fread entry
  | ok zip direct close
  | ok zip close
  | ok zip nested entry
  | ok zip nested close
  | ok zip missing entry
  | ok zip mode not offered
  | ok zip refused path
  | ok zip mode letter D
  | ok zip unregister
  | ok zip open after unregister
  | ok zip source close
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_zip;

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when the first ACount bytes at AFirst and ASecond are equal
func SameBytes(const AFirst: ptr; const ASecond: ptr; const ACount: int64): bool;
var
  LFirst: ptr to uint8;
  LSecond: ptr to uint8;
  LI: int64;
begin
  LFirst := ptr to uint8(AFirst);
  LSecond := ptr to uint8(ASecond);
  for LI := 0 to ACount - 1 do
    if LFirst[LI] <> LSecond[LI] then
      return false;
    end;
  end;
  return true;
end;

// A failed open: nil, and errno is AError (cleared before the call by the caller, so the
// value is the call's own). A stream that opened anyway is closed (the row fails)
func Failed(const AFile: ptr; const AErrno: int32; const AError: int32): bool;
begin
  if AFile <> nil then
    fclose(AFile);
    return false;
  end;
  return AErrno = AError;
end;

// fopen of an Adam text path and mode (their C copies freed after the call)
func OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

// A registered zip IOSource: entries opened through it (the handle owns the entry's IO), bytes
// equal CreateZipFileIO's, every refusal of an entry
func TestZip();
var
  LZip: IOSource;
  LStream: IO;
  LDirect: IO;
  LPrefix: string;
  LFile: ptr;
  LVirtual: array[0..11] of uint8;
  LBytes: array[0..11] of uint8;
  LHandle: array[0..11] of uint8;
  LOk: bool;
  LError: int32;
begin
  LZip := CreateZipIOSource("$P:../../../../res/tests/std/fixtures/std_customio_stored.zip");
  LPrefix := RegisterIOSource(LZip);
  Check("zip register", (LZip <> nil) and (LPrefix <> ""));

  LFile := OpenPath(LPrefix + "/hello.txt", "rb");
  LStream := FileIO(LFile);
  Check("zip open ours", LStream <> nil);
  Check("zip entry size", (LStream <> nil) and (IOSize(LStream) = 12));
  LDirect := CreateZipFileIO("$P:../../../../res/tests/std/fixtures/std_customio_stored.zip", "hello.txt");
  LOk := (LStream <> nil) and (LDirect <> nil);
  if LOk then
    LOk := IORead(LStream, addr of LVirtual[0], 12) = 12;
  end;
  if LOk then
    LOk := IORead(LDirect, addr of LBytes[0], 12) = 12;
  end;
  Check("zip entry bytes", LOk and SameBytes(addr of LVirtual[0], addr of LBytes[0], 12));
  // The handle reads from its own place, 0: its entry IO seeks back
  Check("zip fread entry", (fread(addr of LHandle[0], 1, 12, LFile) = 12) and
    SameBytes(addr of LHandle[0], addr of LBytes[0], 12));
  Check("zip direct close", (LDirect <> nil) and IOClose(LDirect));
  Check("zip close", (LFile <> nil) and (fclose(LFile) = 0));

  LFile := OpenPath(LPrefix + "/data/bytes.bin", "rb");
  Check("zip nested entry", (FileIO(LFile) <> nil) and (IOSize(FileIO(LFile)) = 256));
  Check("zip nested close", (LFile <> nil) and (fclose(LFile) = 0));

  SetCErrno(0);
  LFile := OpenPath(LPrefix + "/missing.txt", "rb");
  LError := CErrno();
  Check("zip missing entry", Failed(LFile, LError, ADAM_ERRNO_ENOENT));

  SetCErrno(0);
  LFile := OpenPath(LPrefix + "/hello.txt", "r+b");
  LError := CErrno();
  Check("zip mode not offered", Failed(LFile, LError, ADAM_ERRNO_EACCES));

  SetCErrno(0);
  LFile := OpenPath(LPrefix + "/../hello.txt", "rb");
  LError := CErrno();
  Check("zip refused path", Failed(LFile, LError, ADAM_ERRNO_ENOENT));

  // ucrt's D asks DELETE access: a source that cannot remove entries refuses it; glibc has
  // no D (a letter it skips): the entry opens
  SetCErrno(0);
  LFile := OpenPath(LPrefix + "/hello.txt", "rbD");
@ifdef TARGET_X86_64_LINUX_GNU
  Check("zip mode letter D", LFile <> nil);
  if LFile <> nil then
    fclose(LFile);
  end;
@else
  LError := CErrno();
  Check("zip mode letter D", Failed(LFile, LError, ADAM_ERRNO_EACCES));
@endif

  Check("zip unregister", UnregisterIO(LPrefix));
  SetCErrno(0);
  LFile := OpenPath(LPrefix + "/hello.txt", "rb");
  LError := CErrno();
  Check("zip open after unregister", Failed(LFile, LError, ADAM_ERRNO_ENOENT));
  Check("zip source close", IOSourceClose(LZip));
end;

begin
  GFails := 0;
  TestZip();
  println("done {}", GFails);
end.
