-------------------------------------------------------------------------------
  std_cstring.adam - System.SysUtils' CString and CStringArray (F5): a
  string's text kept as a C string for as long as the object lives, for a
  pointer C keeps. A CString: its Ptr read by C (strlen), its Text and
  Length, "" as an empty C string (never nil) whose OrNil is nil (a set
  text's OrNil its Ptr, for C's NULL-means-none slots), a copy sharing the same
  text, which outlives the original's reassignment and the source string's.
  A CStringArray: built empty (its Ptr at one nil) and from a list, Count,
  Item, Ptr walked to its nil as C walks an argv, a text added after, and a
  copy that grows apart from its original; then a C struct field that
  keeps a CString's pointer past the call that stored it.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | text 5 hello hello 5
  | empty 0 false 0
  | ornil true true
  | copy same true
  | kept 4 kept
  | outlives 6 joined
  | none 0 nil true
  | list 3 a bb ccc
  | walk 3 a bb ccc
  | added 4 dddd nil true
  | apart 4 5 eeeee
  | kept 7 settled
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_cstring;

import System.SysUtils;

@ifdef TARGET_X86_64_LINUX_GNU
func strlen(const AText: ptr to const char): uint64; external "c";
@else
func strlen(const AText: ptr to const char): uint64; external "ucrtbase";
@endif

type
  // A struct C would keep a name pointer in
  Entry = record
    Name: ptr to const char;
  end;

var
  GEntry: ptr to Entry;

// A C-side store: the pointer is kept in a block that outlives the call
func Register(const AName: ptr to const char);
begin
  GEntry := ptr to Entry(getmem(size(Entry)));
  GEntry^.Name := AName;
end;

// The texts of a NUL-ended pointer list, walked as C walks an argv
func Walk(const AList: ptr to ptr to const char): string;
var
  LResult: string;
  LCount: int64;
  LI: int64;
begin
  LResult := "";
  LCount := 0;
  LI := 0;
  while AList[LI] <> nil do
    LResult := LResult + " " + StringFromC(AList[LI]);
    LCount := LCount + 1;
    LI := LI + 1;
  end;
  return IntToStr(LCount) + LResult;
end;

// A CString made of a text built at run time (no literal behind it)
func Joined(): CString;
var
  LText: string;
begin
  LText := "jo" + "ined";
  return CString(LText);
end;

var
  LText: CString;
  LCopy: CString;
  LEmpty: CString;
  LSource: string;
  LKept: CString;
  LList: CStringArray;
  LNone: CStringArray;
  LMore: CStringArray;
  LSecond: CStringArray;
  LNames: StringArray;
  LName: CString;
begin
  LText := CString("hello");
  println("text {} {} {} {}", strlen(LText.Ptr), StringFromC(LText.Ptr), LText.Text, LText.Length);
  LEmpty := CString("");
  println("empty {} {} {}", strlen(LEmpty.Ptr), LEmpty.Ptr = nil, LEmpty.Length);
  println("ornil {} {}", LEmpty.OrNil = nil, LText.OrNil = LText.Ptr);

  // A copy shares the text; it lives on after the original and the source change
  LSource := "ke" + "pt";
  LKept := CString(LSource);
  LCopy := LKept;
  println("copy same {}", LCopy.Ptr = LKept.Ptr);
  LKept := CString("other");
  LSource := "changed";
  println("kept {} {}", strlen(LCopy.Ptr), StringFromC(LCopy.Ptr));
  LText := Joined();
  println("outlives {} {}", strlen(LText.Ptr), StringFromC(LText.Ptr));

  // Lists
  LNone := CStringArray();
  println("none {} nil {}", LNone.Count, LNone.Ptr^ = nil);
  setlength(LNames, 3);
  LNames[0] := "a";
  LNames[1] := "b" + "b";
  LNames[2] := "ccc";
  LList := CStringArray(LNames);
  println("list {} {} {} {}", LList.Count, StringFromC(LList.Item[0]), StringFromC(LList.Item[1]),
    StringFromC(LList.Item[2]));
  println("walk {}", Walk(LList.Ptr));
  LList.Add("dddd");
  println("added {} {} nil {}", LList.Count, StringFromC(LList.Item[3]), LList.Ptr[4] = nil);
  LMore := LList;
  LSecond := LList;
  LSecond.Add("eeeee");
  println("apart {} {} {}", LMore.Count, LSecond.Count, StringFromC(LSecond.Item[4]));

  // C keeps the pointer past the call that stored it
  LName := CString("sett" + "led");
  Register(LName.Ptr);
  println("kept {} {}", strlen(GEntry^.Name), StringFromC(GEntry^.Name));
  freemem(GEntry);
end.
