-------------------------------------------------------------------------------
  std_run_pe_terminal.adam - System.Process' RunPE capture form through a
  pseudo console (StdApp.Utils' CaptureConsolePTY): the program's terminal
  text as it comes (VT sequences included: the console may put one between
  any two characters, its title for one, so they are taken out before what
  the text must hold is checked); a host's InitialSize is the terminal's size, its Start comes
  before any output with the run's ProcessTerminal (keys typed there reach
  the program's ReadLn; Resize answers), its Stop once the program ended;
  a host that refuses at Start: false, the program never started, no Stop
  of a host that never started; no host: the program still runs (its
  stdin NUL: ReadLn ends at once), its exit code kept.
*******************************************************************************/

/*
@@test
  kind run
  deps std.std_run_pe_sample
  args "<OUT>/bin/<CELL>/std_run_pe_sample.exe"
  exitcode 0
  | size started true exit 0 holds size 100 20 true
  |   starts 1 stops 1 output before start false
  | keys started true exit 0 holds got [abc] true
  |   starts 1 stops 1 keys true resize true
  | refused started false exit 0 output 0
  |   starts 1 stops 0
  | no host started true exit 7 holds three true
  | no host keys started true exit 0 holds got [] true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_run_pe_terminal;

import System.SysUtils, System.Process;

type
  // A host with a size that types Keys at Start (Refuse: refuses to start)
  KeysHost = object implements ProcessHost
    Keys: string;
    Refuse: bool;
    Starts: int32;
    Stops: int32;
    Typed: bool;
    Resized: bool;

    virtual method InitialSize(var ACols: int32; var ARows: int32): bool;
    begin
      ACols := 100;
      ARows := 20;
      return true;
    end;

    virtual method StdInput(): uint64;
    begin
      return 0;
    end;

    virtual method Start(const ATerminal: ref ProcessTerminal): bool;
    begin
      self.Starts := self.Starts + 1;
      if self.Refuse then
        return false;
      end;
      self.Resized := ATerminal.Resize(100, 20);
      if self.Keys <> "" then
        self.Typed := ATerminal.WriteKeys(self.Keys);
      end;
      return true;
    end;

    virtual method Stop();
    begin
      self.Stops := self.Stops + 1;
    end;
  end;

  // The terminal text handed over, joined; whether any came before the host started
  Screen = object implements ProcessOutput
    Text: string;
    Chunks: int32;
    Host: ref KeysHost;
    Early: bool;

    virtual method Output(const AText: string);
    begin
      if (self.Host <> nil) and (self.Host.Starts = 0) then
        self.Early := true;
      end;
      self.Text := self.Text + AText;
      self.Chunks := self.Chunks + 1;
    end;
  end;

var
  GSample: string;
  GArgs: StringArray;
  GScreen: ref Screen;
  GHost: ref KeysHost;
  GExit: uint32;
  GStarted: bool;

// AText without its VT sequences: CSI (ESC [ .. a final byte 0x40..0x7E), OSC (ESC ] .. BEL, or
// ESC and the string terminator's byte), any other ESC with the byte after it
routine Plain(const AText: string): string;
var
  LText: string;
  LAt: int64;
  LOut: int64;
  LByte: uint8;
begin
  LText := AText;
  LOut := 0;
  LAt := 0;
  while LAt < len(AText) do
    LByte := uint8(AText[LAt]);
    if (LByte = 27) and (LAt + 1 < len(AText)) then
      LByte := uint8(AText[LAt + 1]);
      LAt := LAt + 2;
      if LByte = 91 then
        // CSI: parameters and intermediates, then its final byte
        while (LAt < len(AText)) and ((uint8(AText[LAt]) < 64) or (uint8(AText[LAt]) > 126)) do
          LAt := LAt + 1;
        end;
        LAt := LAt + 1;
      end;
      if LByte = 93 then
        // OSC: to BEL, or to the ESC of its string terminator (and the byte after it)
        while (LAt < len(AText)) and (uint8(AText[LAt]) <> 7) and (uint8(AText[LAt]) <> 27) do
          LAt := LAt + 1;
        end;
        if (LAt < len(AText)) and (uint8(AText[LAt]) = 27) then
          LAt := LAt + 1;
        end;
        LAt := LAt + 1;
      end;
    else
      LText[LOut] := AText[LAt];
      LOut := LOut + 1;
      LAt := LAt + 1;
    end;
  end;
  setlength(LText, LOut);
  return LText;
end;

// Whether the screen text, its VT sequences taken out, holds AText
routine Holds(const AText: string): bool;
begin
  return IndexOf(AText, Plain(GScreen.Text), 0) >= 0;
end;

routine Run(const AMode: string; const AHost: ref KeysHost);
begin
  GArgs[0] := AMode;
  GScreen := ref Screen();
  GScreen.Host := AHost;
  GExit := 99;
  GStarted := RunPE(GSample, GArgs, "", GExit, GScreen, ProcessCapture.Terminal, AHost);
end;

begin
  GSample := paramstr(1);
  setlength(GArgs, 1);

  GHost := ref KeysHost();
  Run("size", GHost);
  println("size started {} exit {} holds size 100 20 {}", GStarted, GExit, Holds("size 100 20"));
  println("  starts {} stops {} output before start {}", GHost.Starts, GHost.Stops, GScreen.Early);

  GHost := ref KeysHost();
  GHost.Keys := "abc\r";
  Run("keys", GHost);
  println("keys started {} exit {} holds got [abc] {}", GStarted, GExit, Holds("got [abc]"));
  println("  starts {} stops {} keys {} resize {}", GHost.Starts, GHost.Stops, GHost.Typed,
    GHost.Resized);

  GHost := ref KeysHost();
  GHost.Refuse := true;
  Run("lines", GHost);
  println("refused started {} exit {} output {}", GStarted, GExit, GScreen.Chunks);
  println("  starts {} stops {}", GHost.Starts, GHost.Stops);

  Run("lines", nil);
  println("no host started {} exit {} holds three {}", GStarted, GExit, Holds("three"));

  Run("keys", nil);
  println("no host keys started {} exit {} holds got [] {}", GStarted, GExit, Holds("got []"));

  GScreen := nil;
  GHost := nil;
end.
