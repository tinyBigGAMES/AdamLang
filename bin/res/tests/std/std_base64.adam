-------------------------------------------------------------------------------
  std_base64.adam - System.Base64 (PLAN-RAVENAPI R9: raylib's
  EncodeDataBase64 / DecodeDataBase64 jobs): RFC 4648 sec 10's vectors,
  every byte value there and back, text both ways, decoding with the
  padding left off and whitespace between, and each refusal: a byte
  outside the alphabet, '=' too early, a lone last character, data after
  the padding, padding past a group, padding alone. The same lines on both
  targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | enc [] []
  | enc [f] [Zg==]
  | enc [fo] [Zm8=]
  | enc [foo] [Zm9v]
  | enc [foob] [Zm9vYg==]
  | enc [fooba] [Zm9vYmE=]
  | enc [foobar] [Zm9vYmFy]
  | bytes AAECAwQFBgcICQoLDA0ODxAR 344 back true
  | dec [Adam] true
  | nopad [fo] true
  | spaced [foobar] true
  | bad char false [] bad pad false lone false pad after false extra pad false only pad false
  | utf8 [R3LDvMOfZQ==] [Grüße] true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_base64;

import System.SysUtils, System.Base64;

const
  // RFC 4648 sec 10's inputs
  ADAM_TEST_INPUTS: array[0..6] of string = ["", "f", "fo", "foo", "foob", "fooba", "foobar"];

var
  LBytes: ByteArray;
  LBack: ByteArray;
  LText: string;
  LEncoded: string;
  LOk: bool;
  LSame: bool;
  LI: int64;
begin
  for LI := 0 to 6 do
    println("enc [{}] [{}]", ADAM_TEST_INPUTS[LI], Base64Encode(ADAM_TEST_INPUTS[LI]));
  end;
  setlength(LBytes, 256);
  for LI := 0 to 255 do
    LBytes[LI] := uint8(LI);
  end;
  LEncoded := Base64Encode(LBytes);
  LOk := Base64Decode(LEncoded, LBack);
  LSame := LOk and (len(LBack) = 256);
  for LI := 0 to len(LBack) - 1 do
    if LBack[LI] <> uint8(LI) then
      LSame := false;
    end;
  end;
  println("bytes {} {} back {}", Substring(LEncoded, 0, 24), len(LEncoded), LSame);
  LOk := Base64Decode("QWRhbQ==", LText);
  println("dec [{}] {}", LText, LOk);
  LOk := Base64Decode("Zm8", LText);
  println("nopad [{}] {}", LText, LOk);
  LOk := Base64Decode(" Zm9v\r\nYmFy\t", LText);
  println("spaced [{}] {}", LText, LOk);
  print("bad char {} [{}]", Base64Decode("Zm9v*mFy", LText), LText);
  print(" bad pad {}", Base64Decode("Z===", LText));
  print(" lone {}", Base64Decode("Zm9vY", LText));
  print(" pad after {}", Base64Decode("Zg==Zg==", LText));
  print(" extra pad {}", Base64Decode("Zg===", LText));
  println(" only pad {}", Base64Decode("====", LText));
  LEncoded := Base64Encode("Grüße");
  LOk := Base64Decode(LEncoded, LText);
  println("utf8 [{}] [{}] {}", LEncoded, LText, LOk);
end.
