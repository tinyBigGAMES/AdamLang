-------------------------------------------------------------------------------
  std_cpplink_raylib.adam - std's public routines link by C++ (Itanium)
  names (PLAN-LINUX64 LX3d3c2f), so a C library's plain names of the same
  spelling stay the library's: a program over System.IO and
  System.Raylib.C calls both FileExists and both DirectoryExists, std's
  over Adam strings and raylib's own over C strings, on the program's file,
  a missing one and the working folder.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | std file true missing false folder true
  | raylib file true missing false folder true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_cpplink_raylib;

import System.SysUtils, System.IO, System.Raylib.C;

// raylib's FileExists and DirectoryExists over APath, a missing path and AFolder
func RaylibChecks(const APath: string; const AFolder: string);
var
  LPath: ptr to char;
  LMissing: ptr to char;
  LFolder: ptr to char;
begin
  LPath := StringToC(APath);
  LMissing := StringToC(APath + ".none");
  LFolder := StringToC(AFolder);
  println("raylib file {} missing {} folder {}", System.Raylib.C.FileExists(LPath),
    System.Raylib.C.FileExists(LMissing), System.Raylib.C.DirectoryExists(LFolder));
  freemem(LPath);
  freemem(LMissing);
  freemem(LFolder);
end;

var
  LPath: string;

begin
  LPath := paramstr(0);
  println("std file {} missing {} folder {}", System.IO.FileExists(LPath),
    System.IO.FileExists(LPath + ".none"), System.IO.DirectoryExists("."));
  RaylibChecks(LPath, ".");
end.
