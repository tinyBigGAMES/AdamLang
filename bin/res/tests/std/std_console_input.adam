-------------------------------------------------------------------------------
  std_console_input.adam - System.Console's keyboard with no console
  (PLAN-CONSOLE C3; adamtest's standard input is NUL): ReadKey gives "",
  AnyKeyPressed false, WaitForAnyKey / WaitForKey / Pause return at once,
  ReadLn ends at once (false, ""), WaitForEnter prints its prompt and gives
  false (a quit word never matches an empty line); IsEnterKey / IsEscapeKey
  by the Key consts. Each row prints ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok read key
  | ok key waiting
  | ok wait returns
  | ok read line
  |
  | Press ENTER to continue...
  | ok wait enter
  |
  | Quit?
  | ok wait enter quit
  | ok key names
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_console_input;

import System.SysUtils, System.Console;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

routine Run();
var
  LLine: string;
  LRead: bool;
begin
  Check("read key", ReadKey() = "");
  Check("key waiting", not AnyKeyPressed());
  WaitForAnyKey();
  WaitForKey();
  WaitForKey("q");
  Pause();
  Pause(true);
  Pause(true, TextColor.Yellow, "Go on?");
  Check("wait returns", true);
  LLine := "old";
  LRead := ReadLn(LLine);
  Check("read line", not LRead and (LLine = ""));
  Check("wait enter", not WaitForEnter());
  Check("wait enter quit", not WaitForEnter("Quit?", "q"));
  Check("key names", IsEnterKey(KeyEnter) and IsEscapeKey(KeyEscape) and not IsEnterKey("a") and
    not IsEscapeKey(KeyEnter) and (KeyBackspace = "\x08"));
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
