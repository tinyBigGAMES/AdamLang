-------------------------------------------------------------------------------
  std_hookabi_rt_gconv.adam - System.HookABI's run-time level reaching an
  object glibc loads on its own (PLAN-LINUX64 LX4f2, x86_64-linux-gnu): a
  counting hook of __strcasecmp (the program calls it nowhere) sees the
  calls of glibc's UTF-16 gconv module, which iconv_open loads through
  glibc's internal dlopen and whose init compares the charset names through
  its own import; after the uninstall a new conversion counts nothing.

  Each row prints ok or FAIL with its name; the last is `done <failures>`.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ok install
  | ok open
  | ok module call hooked
  | ok close
  | ok uninstall
  | ok reopen
  | ok module call real
  | ok reclose
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

@ifndef TARGET_X86_64_LINUX_GNU
@message error "std_hookabi_rt_gconv runs on x86_64-linux-gnu only";
@endif

module exe std_hookabi_rt_gconv;

import System.HookABI;

type
  // __strcasecmp's C signature
  CompareFn = func(const ALeft: ptr to const char; const ARight: ptr to const char): int32;

// glibc: a conversion opened (its gconv modules loaded) and closed
func iconv_open(const ATo: ptr to const char; const AFrom: ptr to const char): ptr;
  external "c";
func iconv_close(const AConversion: ptr): int32; external "c";

const
  // iconv_open's failure, (iconv_t) -1
  ICONV_FAILED: uint64 = 0xFFFFFFFFFFFFFFFF;

var
  // The real __strcasecmp (the record's Original), the calls the counting replacement saw,
  // the failures seen
  GOriginal: ptr;
  GReplacement: CompareFn;
  GCalls: int64;
  GFails: int64;

// The counting replacement: a call counted, the real __strcasecmp's answer
func HookCompare(const ALeft: ptr to const char; const ARight: ptr to const char): int32;
var
  LReal: CompareFn;
begin
  GCalls := GCalls + 1;
  LReal := CompareFn(GOriginal);
  return LReal(ALeft, ARight);
end;

// AName printed as ok or FAIL (a failure counted)
func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

var
  LHook: Hook;
  LConversion: ptr;
  LBefore: int64;

begin
  GFails := 0;
  GCalls := 0;
  GReplacement := HookCompare;
  Check("install", HookInstall(LHook, "__strcasecmp", ptr(GReplacement)));
  GOriginal := LHook.Original;
  LBefore := GCalls;
  LConversion := iconv_open("UTF-16//", "UTF-8//");
  Check("open", uint64(LConversion) <> ICONV_FAILED);
  Check("module call hooked", GCalls > LBefore);
  Check("close", iconv_close(LConversion) = 0);
  Check("uninstall", HookUninstall(LHook) and (LHook.State = nil));
  LBefore := GCalls;
  LConversion := iconv_open("UTF-16//", "UTF-8//");
  Check("reopen", uint64(LConversion) <> ICONV_FAILED);
  Check("module call real", GCalls = LBefore);
  Check("reclose", iconv_close(LConversion) = 0);
  println("done {}", GFails);
end.
