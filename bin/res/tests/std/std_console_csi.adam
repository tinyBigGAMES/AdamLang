-------------------------------------------------------------------------------
  std_console_csi.adam - System.Console's sequences and modes (PLAN-CONSOLE
  C1): every Csi routine against its bytes (positions 0-based, counts <= 0
  giving ""), the SGR forms (standard, bright, 256, Rgb), the title's
  control characters dropped, a few Csi consts, TextColorAt clamped, the
  escape mode round trip; on a pipe (adamtest's) IsTerminal is false, Auto
  writes no sequence, On does, Off does not, and the size is 80 x 25. Each
  row prints ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok position
  | ok position clamped
  | ok column
  | ok moves
  | ok moves zero
  | ok scroll insert delete
  | ok chars
  | ok standard colors
  | ok bright colors
  | ok palette
  | ok rgb
  | ok rgb default
  | ok title
  | ok consts
  | ok color at
  | ok mode default
  | ok mode round trip
  | ok not terminal
  | ok size
  | ab
  | cd
  | ok on writes
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_console_csi;

import System.SysUtils, System.Console;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

routine Run();
var
  LGold: Rgb(255, 215, 0);
  LSmall: Rgb(1, 2, 3);
  LBlack: Rgb;
begin
  Check("position", CsiCursorPosition(4, 2) = "\x1b[3;5H");
  Check("position clamped", CsiCursorPosition(-3, -1) = "\x1b[1;1H");
  Check("column", (CsiCursorColumn(0) = "\x1b[1G") and (CsiCursorColumn(-5) = "\x1b[1G") and
    (CsiCursorColumn(9) = "\x1b[10G"));
  Check("moves", (CsiCursorUp(2) = "\x1b[2A") and (CsiCursorDown(3) = "\x1b[3B") and
    (CsiCursorForward(4) = "\x1b[4C") and (CsiCursorBack(5) = "\x1b[5D"));
  Check("moves zero", (CsiCursorUp(0) = "") and (CsiCursorDown(-1) = "") and
    (CsiCursorForward(0) = "") and (CsiCursorBack(-2) = ""));
  Check("scroll insert delete", (CsiScrollUp(1) = "\x1b[1S") and (CsiScrollDown(2) = "\x1b[2T") and
    (CsiInsertLines(3) = "\x1b[3L") and (CsiDeleteLines(4) = "\x1b[4M"));
  Check("chars", (CsiInsertChars(1) = "\x1b[1@") and (CsiDeleteChars(2) = "\x1b[2P") and
    (CsiEraseChars(3) = "\x1b[3X") and (CsiEraseChars(0) = ""));
  Check("standard colors", (CsiForeground(TextColor.Red) = "\x1b[31m") and
    (CsiBackground(TextColor.Black) = "\x1b[40m") and (CsiForeground(TextColor.White) = "\x1b[37m"));
  Check("bright colors", (CsiForeground(TextColor.BrightBlack) = "\x1b[90m") and
    (CsiBackground(TextColor.BrightWhite) = "\x1b[107m"));
  Check("palette", (CsiForeground256(238) = "\x1b[38;5;238m") and
    (CsiBackground256(0) = "\x1b[48;5;0m"));
  Check("rgb", (CsiForeground(LGold) = "\x1b[38;2;255;215;0m") and
    (CsiBackground(LSmall) = "\x1b[48;2;1;2;3m"));
  Check("rgb default", CsiForeground(LBlack) = "\x1b[38;2;0;0;0m");
  Check("title", CsiTitle("a\tb" + "\x07" + "c" + "\x7F" + "d") = "\x1b]0;abcd\x07");
  Check("consts", (CsiClearLine = "\x1b[2K") and (CsiResetFormat = "\x1b[0m") and
    (CsiHideCursor = "\x1b[?25l") and (KeyEnter = "\r") and (KeyEscape = "\x1b"));
  Check("color at", (TextColorAt(1) = TextColor.Red) and (TextColorAt(-4) = TextColor.Black) and
    (TextColorAt(99) = TextColor.BrightWhite));
  Check("mode default", GetEscapeMode() = EscapeMode.Auto);
  SetEscapeMode(EscapeMode.Off);
  Check("mode round trip", (GetEscapeMode() = EscapeMode.Off) and not EscapesEnabled());
  SetEscapeMode(EscapeMode.Auto);
  Check("not terminal", not IsTerminal() and not EscapesEnabled());
  Check("size", (GetTerminalWidth() = 80) and (GetTerminalHeight() = 25));
  // Auto on a pipe: the text alone
  WriteText("a");
  SetBold();
  SetForegroundColor(TextColor.Green);
  WriteText("b");
  ResetFormat();
  WriteText(CsiLf);
  // Off: the text alone
  SetEscapeMode(EscapeMode.Off);
  WriteText("c");
  WriteEscape(CsiBold);
  ClearLine();
  WriteText("d" + CsiLf);
  SetEscapeMode(EscapeMode.On);
  Check("on writes", EscapesEnabled());
  SetEscapeMode(EscapeMode.Auto);
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
