-------------------------------------------------------------------------------
  std_process_openurl.adam - System.Process' OpenUrl refusals (PLAN-RAVENAPI
  R9: raylib's OpenURL job, Raven's Ropen_url): no text, no scheme, a drive
  letter (a path, never run), a scheme not starting with a letter, a bad
  scheme byte. A URL that opens a browser is no row (it would open one on
  the machine running the tests). The same lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | refused false false false false false
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_process_openurl;

import System.Process;

begin
  println("refused {} {} {} {} {}", OpenUrl(""), OpenUrl("adamlang.org"),
    OpenUrl("C:\\Windows\\notepad.exe"), OpenUrl("1http://x"), OpenUrl("ht_tp://x"));
end.
