-------------------------------------------------------------------------------
  std_link_err_missing.adam - a `@linklibrary` naming a library in no
  library path: BNF sec 2's search finds none, EX0002 at the directive's
  string (as an `external` clause's library), naming the files looked for
  in each folder; the build fails, though no routine of it is called.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/std_link_err_missing.adam" "-o" "."
  exitcode 1
  | <DIR>/std_link_err_missing.adam(33,14): Error EX0002: library 'adamnosuchlib' is not found: looked for libadamnosuchlib.dll.a, adamnosuchlib.dll.a, libadamnosuchlib.a, adamnosuchlib.lib, libadamnosuchlib.dll, adamnosuchlib.dll in <BIN>/res/libs/vendor/x86_64-windows-gnu; <BIN>/res/libs/system/x86_64-windows-gnu; <SYS>
@@end
*/

module exe std_link_err_missing;

@linklibrary "adamnosuchlib";

begin
  println("{}", "never");
end.
