-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
  std_run_attached.adam - System.Process' RunAttached the same on both
  targets (PLAN-LINUX64 LX5c): the program runs on this program's own
  stdout after the text this program wrote before it (flushed first, so the
  order on a shared stdout is kept), its exit code; a missing program false
  with exit code 0. The program: cmd.exe on x86_64-windows-gnu (named with
  '/': its argv[0] reaches it with '\'), /bin/sh on x86_64-linux-gnu.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | before attached
  | attached
  | ok attached
  | ok missing
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_run_attached;

import System.SysUtils, System.IO, System.Process;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

func Run();
var
  LShell: string;
  LArgs: StringArray;
  LExit: uint32;
  LOk: bool;
begin
  setlength(LArgs, 2);
@ifdef TARGET_X86_64_WINDOWS_GNU
  // Named with '/' as Adam paths are: argv[0] must reach cmd with '\' (else "/cmd.exe" reads as /c)
  LShell := SystemDir() + "/cmd.exe";
  LArgs[0] := "/c";
  LArgs[1] := "echo attached& exit 4";
@else
  LShell := "/bin/sh";
  LArgs[0] := "-c";
  LArgs[1] := "echo attached; exit 4";
@endif
  println("before attached");
  LOk := RunAttached(LShell, LArgs, "", LExit);
  Check("attached", LOk and (LExit = 4));
  LExit := 9;
  LOk := RunAttached(LShell + ".missing", LArgs, "", LExit);
  Check("missing", (not LOk) and (LExit = 0));
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
