  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  std_raylib_io.adam - System.Raylib.Ext's IO loading with no window or audio
  device (PLAN-LINUX64 LX3d3c3a, PaskalCPP's std_raylib_ext; on the object
  layer since PLAN-RAVENAPI R10): every IO load is compared with raylib's
  own file-name form on a real file of the same bytes (written beside this
  program, removed after): what the file-name form gives, the IO form
  gives, on both targets. The layer's IO forms (ImageRes.FromIO,
  WaveRes.FromIO ..) register the IO with System.HookIO for the call and
  hand raylib's file-name loader its `io://` path; raylib's loaders the
  layer has no IO form for (file data and text, image sequences, raw
  pixels) are driven the same way here, through HookIO's RegisterIO.

  Data: raylib's LoadFileData and LoadFileText over a memory IO (bytes with a
  NUL and a CRLF in them, text-mode edge cases: a lone CR, CR CR LF, a
  Ctrl-Z), a file IO and a zip entry; an empty IO as an empty file; a
  failing IO, and nil, as a missing file (nil, size 0). Images: png, a
  two-frame gif, a still png through the sequence loader, raw pixels with a
  header, none, one too long and too few pixels; a failing IO. Waves: wav
  and ogg. Assets.Mount: plain names load from the zip source, an IO form's
  own path still reaches its IO, Unmount restores raylib's own files, a
  path source the program set itself is kept. raylib's log is off
  (Log.Level(LogLevel.None)), so the output is the rows alone.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok data real files
  | ok data memory binary as path
  | ok text memory binary as path
  | ok data memory binary close
  | ok data memory text as path
  | ok text memory crlf as path
  | ok data memory again as path
  | ok data memory close
  | ok data file as path
  | ok text file as path
  | ok data file close
  | ok data zip real file
  | ok data zip as path
  | ok data zip size 80
  | ok data zip close
  | ok text edges real files
  | ok text edges as path
  | ok data edges as path
  | ok text edges close
  | ok text ctrl-z alone as path
  | ok text ctrl-z close
  | ok text edges removed
  | ok data empty as path
  | ok text empty as path
  | ok data empty close
  | ok data failing as missing as path
  | ok text failing as the C runtime gives
  | ok data failing close
  | ok data nil as missing as path
  | ok text nil as missing as path
  | ok data nil size 0
  | ok data real files removed
  | ok image real files
  | ok image png loaded
  | ok image png as path
  | ok image png close
  | ok image anim frames
  | ok image anim as path
  | ok image anim close
  | ok image anim still as path
  | ok image anim still close
  | ok image raw header as path
  | ok image raw no header as path
  | ok image raw header too long as path
  | ok image raw too small as path
  | ok image raw close
  | ok image failing as missing
  | ok image failing close
  | ok image real files removed
  | ok wave real files
  | ok wave wav loaded
  | ok wave wav as path
  | ok wave ogg loaded
  | ok wave ogg as path
  | ok wave failing as missing
  | ok wave close
  | ok wave real files removed
  | ok source made
  | ok source set
  | ok source plain data
  | ok source plain data as entry
  | ok source plain text with dot slash
  | ok source plain image
  | ok source io form still its own
  | ok source missing entry
  | ok source cleared
  | ok source not routed after clear
  | ok source program's own kept
  | ok source program's own still routes
  | ok source all unset
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raylib_io;

import System.SysUtils, System.CustomIO, System.HookIO, System.Raylib.C,
  System.Raylib.Ext;

const
  // The fixture: raylib_ext's assets (image.png, anim.gif, raw.bin, tone.wav, sfx.ogg ..)
  ZIP_PATH: string = "$P:../../../../res/tests/std/fixtures/std_raylib_io.zip";
  // The memory IO's bytes: a NUL inside and a CRLF (a text read of a file may treat them
  // as its C runtime does)
  TEXT_BYTES: array[0..15] of uint8 = [0x6C, 0x69, 0x6E, 0x65, 0x31, 0x0D, 0x0A, 0x6C,
    0x69, 0x6E, 0x65, 0x32, 0x0A, 0x65, 0x6E, 0x64];
  BINARY_BYTES: array[0..6] of uint8 = [0x61, 0x00, 0x62, 0xFF, 0x0D, 0x0A, 0x63];
  // Text-mode edge cases: a lone CR, CR CR LF, a Ctrl-Z inside; and a Ctrl-Z alone
  EDGE_BYTES: array[0..9] of uint8 = [0x61, 0x0D, 0x62, 0x0D, 0x0D, 0x0A, 0x63, 0x1A,
    0x64, 0x0A];
  CTRLZ_BYTES: array[0..0] of uint8 = [0x1A];

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The bytes of a constant table, as an array a memory IO can sit on
func TextBytes(): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(TEXT_BYTES));
  for LI := 0 to len(TEXT_BYTES) - 1 do
    LBytes[LI] := TEXT_BYTES[LI];
  end;
  return LBytes;
end;

func BinaryBytes(): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(BINARY_BYTES));
  for LI := 0 to len(BINARY_BYTES) - 1 do
    LBytes[LI] := BINARY_BYTES[LI];
  end;
  return LBytes;
end;

func EdgeBytes(): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(EDGE_BYTES));
  for LI := 0 to len(EDGE_BYTES) - 1 do
    LBytes[LI] := EDGE_BYTES[LI];
  end;
  return LBytes;
end;

func CtrlZBytes(): ByteArray;
var
  LBytes: ByteArray;
begin
  setlength(LBytes, 1);
  LBytes[0] := CTRLZ_BYTES[0];
  return LBytes;
end;

// ABytes into a new real file at APath (through CustomIO's file IO, on every target)
func WriteAllBytes(const APath: string; const ABytes: ByteArray): bool;
var
  LFile: IO;
  LOk: bool;
begin
  LFile := CreateFileIO(APath, FileMode.Write);
  if LFile = nil then
    return false;
  end;
  LOk := true;
  if len(ABytes) > 0 then
    LOk := IOWriteFull(LFile, addr of ABytes[0], len(ABytes)) = len(ABytes);
  end;
  return IOClose(LFile) and LOk;
end;

// Removes the real file at APath (through a folder source on its folder)
func DeleteFile(const APath: string): bool;
var
  LFolder: IOSource;
  LOk: bool;
begin
  LFolder := CreateFolderIOSource(ExtractFileDir(APath));
  if LFolder = nil then
    return false;
  end;
  LOk := IOSourceRemove(LFolder, ExtractFileName(APath));
  return IOSourceClose(LFolder) and LOk;
end;

// A memory IO over ABytes (they must outlive it); an empty array gives an empty IO
func MemoryOf(var ABytes: ByteArray): IO;
begin
  if len(ABytes) = 0 then
    return CreateMemoryIO();
  end;
  return CreateMemoryIO(addr of ABytes[0], len(ABytes), true);
end;

// AIO's bytes read straight through CustomIO (apart from System.Raylib.Ext's reader) into a new
// real file at APath
func CopyToFile(const AIO: IO; const APath: string): bool;
var
  LAll: string;
  LBytes: ByteArray;
  LI: int64;
begin
  if AIO = nil then
    return false;
  end;
  IOSeek(AIO, 0, SeekOrigin.FromStart);
  if not IOReadAll(AIO, LAll) then
    return false;
  end;
  setlength(LBytes, len(LAll));
  for LI := 0 to len(LAll) - 1 do
    LBytes[LI] := uint8(LAll[LI]);
  end;
  return WriteAllBytes(APath, LBytes);
end;

// The zip entry AEntry copied to a real file at APath
func Extract(const AEntry: string; const APath: string): bool;
var
  LIO: IO;
  LOk: bool;
begin
  LIO := CreateZipFileIO(ZIP_PATH, AEntry);
  LOk := CopyToFile(LIO, APath);
  if LIO <> nil then
    IOClose(LIO);
  end;
  return LOk;
end;

// Two LoadFileData results: both nil, or both set with the same size and the same bytes
func SameData(const AFirst: ptr to uint8; const AFirstSize: int32;
  const ASecond: ptr to uint8; const ASecondSize: int32): bool;
var
  LI: int64;
begin
  if (AFirst = nil) or (ASecond = nil) then
    return (AFirst = nil) and (ASecond = nil) and (AFirstSize = ASecondSize);
  end;
  if AFirstSize <> ASecondSize then
    return false;
  end;
  for LI := 0 to AFirstSize - 1 do
    if AFirst[LI] <> ASecond[LI] then
      return false;
    end;
  end;
  return true;
end;

// Two LoadFileText results: both nil, or the same text
func SameText(const AFirst: ptr to char; const ASecond: ptr to char): bool;
begin
  if (AFirst = nil) or (ASecond = nil) then
    return (AFirst = nil) and (ASecond = nil);
  end;
  return StringFromC(AFirst) = StringFromC(ASecond);
end;

// Two images: the same size, format and mipmaps, and the same pixel bytes (AFrames frames of
// them, for an image sequence); two empty images too
func SameImage(const AFirst: Image; const ASecond: Image; const AFrames: int32): bool;
var
  LSize: int64;
begin
  if (AFirst.data = nil) or (ASecond.data = nil) then
    return (AFirst.data = nil) and (ASecond.data = nil);
  end;
  if (AFirst.width <> ASecond.width) or (AFirst.height <> ASecond.height) or
    (AFirst.format <> ASecond.format) or (AFirst.mipmaps <> ASecond.mipmaps) then
    return false;
  end;
  LSize := int64(GetPixelDataSize(AFirst.width, AFirst.height, AFirst.format)) * AFrames;
  return SameData(ptr to uint8(AFirst.data), int32(LSize), ptr to uint8(ASecond.data),
    int32(LSize));
end;

// Two waves: the same facts and the same sample bytes; two empty waves too
func SameWave(const AFirst: Wave; const ASecond: Wave): bool;
var
  LSize: int64;
begin
  if (AFirst.data = nil) or (ASecond.data = nil) then
    return (AFirst.data = nil) and (ASecond.data = nil);
  end;
  if (AFirst.frameCount <> ASecond.frameCount) or (AFirst.sampleRate <> ASecond.sampleRate) or
    (AFirst.sampleSize <> ASecond.sampleSize) or (AFirst.channels <> ASecond.channels) then
    return false;
  end;
  LSize := int64(AFirst.frameCount) * int64(AFirst.channels) * int64(AFirst.sampleSize div 8);
  return SameData(ptr to uint8(AFirst.data), int32(LSize), ptr to uint8(ASecond.data),
    int32(LSize));
end;

// A Read callback that always fails: the IO is in error at once
func FailingRead(const AUserData: ptr; const ABuffer: ptr; const ASize: int64;
  var AState: IOState): int64;
begin
  AState := IOState.Error;
  return 0;
end;

// An IO whose every read is an error, for the "as a missing file" rows
func FailingIO(): IO;
var
  LCallbacks: IOInterface;
begin
  LCallbacks.Read := FailingRead;
  LCallbacks.Write := nil;
  LCallbacks.Seek := nil;
  LCallbacks.Tell := nil;
  LCallbacks.Size := nil;
  LCallbacks.Flush := nil;
  LCallbacks.Close := nil;
  LCallbacks.Truncate := nil;
  return CreateIO(LCallbacks, nil);
end;

// AIO registered with System.HookIO for one raylib call: the `io://<n>` prefix its paths open
// it by; one that cannot be registered (nil, no room) gets `io://0`, a prefix no registration
// gives, so raylib opens a missing file (the layer's own rule)
func IOPrefix(const AIO: IO): string;
var
  LPrefix: string;
begin
  LPrefix := RegisterIO(AIO);
  if len(LPrefix) = 0 then
    return "io://0";
  end;
  return LPrefix;
end;

// Ends IOPrefix's registration
func EndIO(const APrefix: string);
begin
  if APrefix <> "io://0" then
    UnregisterIO(APrefix);
  end;
end;

// raylib's LoadFileData over AIO (the IO's bytes as raylib reads a file)
func DataOfIO(const AIO: IO; var ASize: int32): ptr to uint8;
var
  LPrefix: string;
  LData: ptr to uint8;
begin
  LPrefix := IOPrefix(AIO);
  LData := LoadFileData(LPrefix + "/file", addr of ASize);
  EndIO(LPrefix);
  return LData;
end;

// raylib's LoadFileText over AIO (text mode, as raylib reads a text file)
func TextOfIO(const AIO: IO): ptr to char;
var
  LPrefix: string;
  LText: ptr to char;
begin
  LPrefix := IOPrefix(AIO);
  LText := LoadFileText(LPrefix + "/file");
  EndIO(LPrefix);
  return LText;
end;

// raylib's LoadImageAnim over AIO, a file of type AType
func AnimOfIO(const AIO: IO; const AType: string; var AFrames: int32): Image;
var
  LPrefix: string;
  LImage: Image;
begin
  LPrefix := IOPrefix(AIO);
  LImage := LoadImageAnim(LPrefix + "/file" + AType, addr of AFrames);
  EndIO(LPrefix);
  return LImage;
end;

// raylib's LoadImageRaw over AIO
func RawOfIO(const AIO: IO; const AWidth: int32; const AHeight: int32; const AFormat: int32;
  const AHeaderSize: int32): Image;
var
  LPrefix: string;
  LImage: Image;
begin
  LPrefix := IOPrefix(AIO);
  LImage := LoadImageRaw(LPrefix + "/file", AWidth, AHeight, AFormat, AHeaderSize);
  EndIO(LPrefix);
  return LImage;
end;

// raylib's LoadFileData over AIO against LoadFileData on the real file APath
func CheckData(const AName: string; const AIO: IO; const APath: string);
var
  LViaIO: ptr to uint8;
  LViaPath: ptr to uint8;
  LIOSize: int32;
  LPathSize: int32;
begin
  LIOSize := -1;
  LPathSize := -1;
  LViaIO := DataOfIO(AIO, LIOSize);
  LViaPath := LoadFileData(APath, addr of LPathSize);
  Check(AName + " as path", SameData(LViaIO, LIOSize, LViaPath, LPathSize));
  if LViaIO <> nil then
    UnloadFileData(LViaIO);
  end;
  if LViaPath <> nil then
    UnloadFileData(LViaPath);
  end;
end;

// raylib's LoadFileText over AIO against LoadFileText on the real file APath
func CheckText(const AName: string; const AIO: IO; const APath: string);
var
  LViaIO: ptr to char;
  LViaPath: ptr to char;
begin
  LViaIO := TextOfIO(AIO);
  LViaPath := LoadFileText(APath);
  Check(AName + " as path", SameText(LViaIO, LViaPath));
  if LViaIO <> nil then
    UnloadFileText(LViaIO);
  end;
  if LViaPath <> nil then
    UnloadFileText(LViaPath);
  end;
end;

// raylib's LoadFileText over a failing IO, against each C runtime's truth (see TestData)
func CheckFailingText(const AIO: IO; const AMissing: string);
var
  LViaIO: ptr to char;
  LViaPath: ptr to char;
  LOk: bool;
begin
  LViaIO := TextOfIO(AIO);
@ifdef TARGET_X86_64_LINUX_GNU
  LViaPath := nil;
  LOk := (LViaIO <> nil) and (len(StringFromC(LViaIO)) = 0) and (LViaPath = nil);
@else
  LViaPath := LoadFileText(AMissing);
  LOk := SameText(LViaIO, LViaPath);
  if LViaPath <> nil then
    UnloadFileText(LViaPath);
  end;
@endif
  Check("text failing as the C runtime gives", LOk);
  if LViaIO <> nil then
    UnloadFileText(LViaIO);
  end;
end;

// The data loaders over memory, file and zip IOs, empty, failing and nil
func TestData();
var
  LPath: string;
  LBinaryPath: string;
  LEmptyPath: string;
  LZipPath: string;
  LMissing: string;
  LEdgesPath: string;
  LCtrlZPath: string;
  LText: ByteArray;
  LBinary: ByteArray;
  LEdges: ByteArray;
  LCtrlZ: ByteArray;
  LNone: ByteArray;
  LMemory: IO;
  LFile: IO;
  LZip: IO;
  LFailing: IO;
  LSize: int32;
  LData: ptr to uint8;
begin
  LPath := paramstr(0) + ".text.txt";
  LBinaryPath := paramstr(0) + ".binary.bin";
  LEmptyPath := paramstr(0) + ".empty.bin";
  LZipPath := paramstr(0) + ".zip.bin";
  LMissing := paramstr(0) + ".missing.bin";
  LEdgesPath := paramstr(0) + ".edges.txt";
  LCtrlZPath := paramstr(0) + ".ctrlz.txt";
  LText := TextBytes();
  LBinary := BinaryBytes();
  LEdges := EdgeBytes();
  LCtrlZ := CtrlZBytes();
  Check("data real files", WriteAllBytes(LPath, LText) and WriteAllBytes(LBinaryPath, LBinary)
    and WriteAllBytes(LEmptyPath, LNone));

  LMemory := MemoryOf(LBinary);
  CheckData("data memory binary", LMemory, LBinaryPath);
  CheckText("text memory binary", LMemory, LBinaryPath);
  Check("data memory binary close", IOClose(LMemory));

  LMemory := MemoryOf(LText);
  CheckData("data memory text", LMemory, LPath);
  CheckText("text memory crlf", LMemory, LPath);
  // Read twice: the IO is read from its start each time
  CheckData("data memory again", LMemory, LPath);
  Check("data memory close", IOClose(LMemory));

  LFile := CreateFileIO(LPath, FileMode.Read);
  CheckData("data file", LFile, LPath);
  CheckText("text file", LFile, LPath);
  Check("data file close", (LFile <> nil) and IOClose(LFile));

  LZip := CreateZipFileIO(ZIP_PATH, "raw.bin");
  Check("data zip real file", CopyToFile(LZip, LZipPath));
  CheckData("data zip", LZip, LZipPath);
  LSize := -1;
  LData := DataOfIO(LZip, LSize);
  Check("data zip size 80", (LData <> nil) and (LSize = 80));
  if LData <> nil then
    UnloadFileData(LData);
  end;
  Check("data zip close", (LZip <> nil) and IOClose(LZip));

  // The text-mode edge cases, each against raylib's own text read
  Check("text edges real files", WriteAllBytes(LEdgesPath, LEdges) and
    WriteAllBytes(LCtrlZPath, LCtrlZ));
  LMemory := MemoryOf(LEdges);
  CheckText("text edges", LMemory, LEdgesPath);
  CheckData("data edges", LMemory, LEdgesPath);
  Check("text edges close", IOClose(LMemory));
  LMemory := MemoryOf(LCtrlZ);
  CheckText("text ctrl-z alone", LMemory, LCtrlZPath);
  Check("text ctrl-z close", IOClose(LMemory));
  Check("text edges removed", DeleteFile(LEdgesPath) and DeleteFile(LCtrlZPath));

  LMemory := MemoryOf(LNone);
  CheckData("data empty", LMemory, LEmptyPath);
  CheckText("text empty", LMemory, LEmptyPath);
  Check("data empty close", IOClose(LMemory));

  LFailing := FailingIO();
  CheckData("data failing as missing", LFailing, LMissing);
  // raylib's LoadFileText sizes a file by ftell as an unsigned int: on an IO that cannot seek,
  // glibc's ftell is -1 (size 0xFFFFFFFF, an empty text after the failed read), the win64
  // model's the place (0: nil, as a missing file)
  CheckFailingText(LFailing, LMissing);
  Check("data failing close", IOClose(LFailing));
  CheckData("data nil as missing", nil, LMissing);
  CheckText("text nil as missing", nil, LMissing);
  LSize := -1;
  Check("data nil size 0", (DataOfIO(nil, LSize) = nil) and (LSize = 0));

  Check("data real files removed", DeleteFile(LPath) and DeleteFile(LBinaryPath) and
    DeleteFile(LEmptyPath) and DeleteFile(LZipPath));
end;

// The image loaders, each against its file-name form on the fixture's entry copied to a
// real file
func TestImages();
var
  LPNG: string;
  LGIF: string;
  LRaw: string;
  LMissing: string;
  LIO: IO;
  LFailing: IO;
  LViaIO: Image;
  LViaPath: Image;
  // The layer's own IO form (released with its last copy)
  LImageIO: ImageRes;
  LIOFrames: int32;
  LPathFrames: int32;
begin
  LPNG := paramstr(0) + ".image.png";
  LGIF := paramstr(0) + ".anim.gif";
  LRaw := paramstr(0) + ".raw.bin";
  LMissing := paramstr(0) + ".missing.png";
  Check("image real files", Extract("image.png", LPNG) and Extract("anim.gif", LGIF) and
    Extract("raw.bin", LRaw));

  LIO := CreateZipFileIO(ZIP_PATH, "image.png");
  LImageIO := ImageRes.FromIO(LIO, ".png");
  LViaPath := LoadImage(LPNG);
  Check("image png loaded", LImageIO.IsValid());
  Check("image png as path", SameImage(LImageIO.Handle(), LViaPath, 1));
  UnloadImage(LViaPath);
  Check("image png close", (LIO <> nil) and IOClose(LIO));

  LIO := CreateZipFileIO(ZIP_PATH, "anim.gif");
  LIOFrames := -1;
  LPathFrames := -1;
  LViaIO := AnimOfIO(LIO, ".gif", LIOFrames);
  LViaPath := LoadImageAnim(LGIF, addr of LPathFrames);
  Check("image anim frames", (LIOFrames = 2) and (LIOFrames = LPathFrames));
  Check("image anim as path", SameImage(LViaIO, LViaPath, LIOFrames));
  UnloadImage(LViaIO);
  UnloadImage(LViaPath);
  Check("image anim close", (LIO <> nil) and IOClose(LIO));
  // A still image through the sequence loader, against the path form on the same png
  LIO := CreateZipFileIO(ZIP_PATH, "image.png");
  LIOFrames := -1;
  LPathFrames := -1;
  LViaIO := AnimOfIO(LIO, ".png", LIOFrames);
  LViaPath := LoadImageAnim(LPNG, addr of LPathFrames);
  Check("image anim still as path", (LIOFrames = LPathFrames) and SameImage(LViaIO, LViaPath, 1));
  UnloadImage(LViaIO);
  UnloadImage(LViaPath);
  Check("image anim still close", (LIO <> nil) and IOClose(LIO));

  LIO := CreateZipFileIO(ZIP_PATH, "raw.bin");
  // 4 x 4 RGBA after the 16-byte header; the pixels alone; more than it holds
  LViaIO := RawOfIO(LIO, 4, 4, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 16);
  LViaPath := LoadImageRaw(LRaw, 4, 4, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 16);
  Check("image raw header as path", IsImageValid(LViaIO) and SameImage(LViaIO, LViaPath, 1));
  UnloadImage(LViaIO);
  UnloadImage(LViaPath);
  LViaIO := RawOfIO(LIO, 4, 4, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 0);
  LViaPath := LoadImageRaw(LRaw, 4, 4, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 0);
  Check("image raw no header as path", SameImage(LViaIO, LViaPath, 1));
  UnloadImage(LViaIO);
  UnloadImage(LViaPath);
  LViaIO := RawOfIO(LIO, 4, 4, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 64);
  LViaPath := LoadImageRaw(LRaw, 4, 4, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 64);
  Check("image raw header too long as path", SameImage(LViaIO, LViaPath, 1));
  UnloadImage(LViaIO);
  UnloadImage(LViaPath);
  LViaIO := RawOfIO(LIO, 16, 16, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 0);
  LViaPath := LoadImageRaw(LRaw, 16, 16, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 0);
  Check("image raw too small as path", (not IsImageValid(LViaIO)) and
    SameImage(LViaIO, LViaPath, 1));
  UnloadImage(LViaIO);
  UnloadImage(LViaPath);
  Check("image raw close", (LIO <> nil) and IOClose(LIO));

  LFailing := FailingIO();
  LImageIO := ImageRes.FromIO(LFailing, ".png");
  LViaPath := LoadImage(LMissing);
  Check("image failing as missing", SameImage(LImageIO.Handle(), LViaPath, 1));
  Check("image failing close", IOClose(LFailing));

  Check("image real files removed", DeleteFile(LPNG) and DeleteFile(LGIF) and DeleteFile(LRaw));
end;

// WaveRes.FromIO on the zip entry AEntry against LoadWave on its real copy APath
func CheckWave(const AName: string; const AEntry: string; const AFileType: string;
  const APath: string);
var
  LIO: IO;
  LViaIO: WaveRes;
  LViaPath: Wave;
begin
  LIO := CreateZipFileIO(ZIP_PATH, AEntry);
  LViaIO := WaveRes.FromIO(LIO, AFileType);
  LViaPath := LoadWave(APath);
  Check(AName + " loaded", LViaIO.IsValid());
  Check(AName + " as path", SameWave(LViaIO.Handle(), LViaPath));
  UnloadWave(LViaPath);
  if LIO <> nil then
    IOClose(LIO);
  end;
end;

// The wave loader (no audio device needed): wav and ogg, a failing IO
func TestWaves();
var
  LWAV: string;
  LOGG: string;
  LMissing: string;
  LFailing: IO;
  LViaIO: WaveRes;
  LViaPath: Wave;
begin
  LWAV := paramstr(0) + ".tone.wav";
  LOGG := paramstr(0) + ".sfx.ogg";
  LMissing := paramstr(0) + ".missing.wav";
  Check("wave real files", Extract("tone.wav", LWAV) and Extract("sfx.ogg", LOGG));
  CheckWave("wave wav", "tone.wav", ".wav", LWAV);
  CheckWave("wave ogg", "sfx.ogg", ".ogg", LOGG);
  LFailing := FailingIO();
  LViaIO := WaveRes.FromIO(LFailing, ".wav");
  LViaPath := LoadWave(LMissing);
  Check("wave failing as missing", SameWave(LViaIO.Handle(), LViaPath));
  Check("wave close", IOClose(LFailing));
  Check("wave real files removed", DeleteFile(LWAV) and DeleteFile(LOGG));
end;

// LoadFileData of a plain name: the size, 0 when it does not load
func PlainSize(const AName: string): int32;
var
  LData: ptr to uint8;
  LSize: int32;
begin
  LSize := 0;
  LData := LoadFileData(AName, addr of LSize);
  if LData = nil then
    return 0;
  end;
  UnloadFileData(LData);
  return LSize;
end;

// Assets.Mount: raylib's plain names load from the zip; Unmount restores raylib's own files
func TestSource();
var
  LSource: IOSource;
  LOwn: IOSource;
  LIO: IO;
  LText: ptr to char;
  LImage: Image;
  LEntrySize: int32;
begin
  LSource := CreateZipIOSource(ZIP_PATH);
  LOwn := CreateZipIOSource(ZIP_PATH);
  LIO := CreateZipFileIO(ZIP_PATH, "raw.bin");
  Check("source made", (LSource <> nil) and (LOwn <> nil) and (LIO <> nil));
  Check("source set", Assets.Mount(LSource) and Assets.Mounted());
  Check("source plain data", PlainSize("raw.bin") = 80);
  // The same name in any of raylib's spellings: a '\', a leading "./" or '/'
  LEntrySize := PlainSize("./model\\model.bin");
  Check("source plain data as entry", (LEntrySize = 104) and (PlainSize("/model/model.bin") = 104));
  LText := LoadFileText("./model/model.gltf");
  Check("source plain text with dot slash", (LText <> nil) and
    (len(StringFromC(LText)) > 0));
  if LText <> nil then
    UnloadFileText(LText);
  end;
  LImage := LoadImage("image.png");
  Check("source plain image", IsImageValid(LImage));
  UnloadImage(LImage);
  // An IO form while a source is set: its own io:// path reaches its IO, not the source
  LImage := RawOfIO(LIO, 4, 4, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 16);
  Check("source io form still its own", IsImageValid(LImage));
  UnloadImage(LImage);
  Check("source missing entry", PlainSize("no/such.bin") = 0);
  Assets.Unmount();
  Check("source cleared", not Assets.Mounted());
  Check("source not routed after clear", PlainSize("raw.bin") = 0);
  // A path source the program set itself is not unset by Unmount
  Check("source program's own kept", Assets.Mount(LSource) and SetIOPathSource(LOwn));
  Assets.Unmount();
  Check("source program's own still routes", PlainSize("raw.bin") = 80);
  Check("source all unset", SetIOPathSource(nil) and (PlainSize("raw.bin") = 0) and
    IOClose(LIO) and IOSourceClose(LSource) and IOSourceClose(LOwn));
end;

begin
  Log.Level(LogLevel.None);
  TestData();
  TestImages();
  TestWaves();
  TestSource();
  println("done {}", GFails);
end.
