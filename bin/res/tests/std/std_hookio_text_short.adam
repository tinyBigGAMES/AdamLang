-------------------------------------------------------------------------------
  std_hookio_text_short.adam - a text handle's short write (System.HookIO's
  DoWriteTextLocked: ucrt's lowio counts back over the source)

  A text handle (r+, neither t nor b) on a memory IO over the row's own
  16 bytes, of which the IO takes only N (CreateMemoryIO over caller
  memory writes what fits), fwrites 4096 bytes of "aaa\n": one buffer's
  size, so it goes straight to lowio, which writes "aaa\r\n" per 4 bytes.
  fwrite's count is the source bytes whose whole translation landed (a
  '\n' cut after its '\r' is not counted), ferror is set, errno is EIO,
  or ENOSPC when nothing landed; the bytes landed are the translation's
  first N, the next one untouched; fclose gives 0 (no buffer was made).
  Worked by hand: N 0 -> 0, 4 -> 3, 5 -> 4, 7 -> 6, 9 -> 7, 10 -> 8.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok short 0 count 0
  | ok short 4 count 3
  | ok short 5 count 4
  | ok short 7 count 6
  | ok short 9 count 7
  | ok short 10 count 8
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_text_short;

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

const
  // The source's size: one ucrt buffer, so fwrite hands it to lowio whole
  CSource: int64 = 4096;
  // The row's memory behind the IO, and the byte it is filled with first
  CSinkSize: int64 = 16;
  CUntouched: uint8 = 0xEE;

var
  GFails: int32;
  GSink: array[0..15] of uint8;

// One check of a case: nothing when it held, else a FAIL line naming it, counted in ABad
routine Part(const AName: string; const APart: string; const AOk: bool; var ABad: int32);
begin
  if not AOk then
    println("FAIL {} {}", AName, APart);
    ABad := ABad + 1;
  end;
end;

// fopen of an Adam text path and mode (their C copies freed after the call)
routine OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

// Byte AIndex of the source's translation: "aaa\r\n" over and over
routine RawByte(const AIndex: int64): uint8;
var
  LAt: int64;
begin
  LAt := AIndex mod 5;
  if LAt = 3 then
    return 13;
  end;
  if LAt = 4 then
    return 10;
  end;
  return uint8('a');
end;

// True when the sink holds the translation's first ACount bytes and the byte after them is
// untouched
routine Landed(const ACount: int64): bool;
var
  LI: int64;
begin
  for LI := 0 to ACount - 1 do
    if GSink[LI] <> RawByte(LI) then
      println("  byte {}: {} for {}", LI, GSink[LI], RawByte(LI));
      return false;
    end;
  end;
  if ACount < CSinkSize then
    if GSink[ACount] <> CUntouched then
      println("  byte {} written: {}", ACount, GSink[ACount]);
      return false;
    end;
  end;
  return true;
end;

// One case: the IO takes ATake bytes; fwrite must count ACount and set AErrno
routine ShortCase(const ASource: ptr to uint8; const ATake: int64; const ACount: int64;
  const AErrno: int32);
var
  LMemory: IO;
  LPrefix: string;
  LFile: ptr;
  LName: string;
  LGot: int64;
  LError: int32;
  LI: int32;
  LBad: int32;
begin
  LBad := 0;
  LName := "short " + IntToStr(ATake) + " count " + IntToStr(ACount);
  for LI := 0 to 15 do
    GSink[LI] := CUntouched;
  end;
  LMemory := CreateMemoryIO(ptr(addr of GSink[0]), ATake);
  Part(LName, "io", LMemory <> nil, LBad);
  LPrefix := RegisterIO(LMemory);
  Part(LName, "register", LPrefix <> "", LBad);
  LFile := OpenPath(LPrefix + "/s.txt", "r+");
  Part(LName, "opened", FileIO(LFile) = LMemory, LBad);
  if LFile <> nil then
    SetCErrno(0);
    LGot := fwrite(ptr(ASource), 1, CSource, LFile);
    LError := CErrno();
    if LGot <> ACount then
      println("  fwrite {}", LGot);
    end;
    Part(LName, "fwrite", LGot = ACount, LBad);
    Part(LName, "errno", LError = AErrno, LBad);
    Part(LName, "ferror", ferror(LFile) <> 0, LBad);
    Part(LName, "landed", Landed(ATake), LBad);
    Part(LName, "fclose", fclose(LFile) = 0, LBad);
  end;
  Part(LName, "unregister", UnregisterIO(LPrefix), LBad);
  Part(LName, "io close", IOClose(LMemory), LBad);
  if LBad = 0 then
    println("ok {}", LName);
  end;
  GFails := GFails + LBad;
end;

// The cuts: nothing, inside the first "\r\n", right after it, inside the next 'a's, inside
// the second "\r\n", right after it
routine TestTextShort();
var
  LSource: array[0..4095] of uint8;
  LI: int32;
begin
  for LI := 0 to 4095 do
    LSource[LI] := uint8('a');
    if (LI mod 4) = 3 then
      LSource[LI] := 10;
    end;
  end;
  ShortCase(addr of LSource[0], 0, 0, ADAM_ERRNO_ENOSPC);
  ShortCase(addr of LSource[0], 4, 3, ADAM_ERRNO_EIO);
  ShortCase(addr of LSource[0], 5, 4, ADAM_ERRNO_EIO);
  ShortCase(addr of LSource[0], 7, 6, ADAM_ERRNO_EIO);
  ShortCase(addr of LSource[0], 9, 7, ADAM_ERRNO_EIO);
  ShortCase(addr of LSource[0], 10, 8, ADAM_ERRNO_EIO);
end;

begin
  GFails := 0;
  TestTextShort();
  println("done {}", GFails);
end.
