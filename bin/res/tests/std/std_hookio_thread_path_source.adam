-------------------------------------------------------------------------------
  std_hookio_thread_path_source.adam - System.HookIO's thread path source
  (PaskalCPP's std_hookio TestThreadPathSource)

  tp_entry.txt in the program's folder holds "PROG": the program's path
  source is a folder source over that folder. The thread's own is a source
  of the row's own (CreateIOSource over memory) whose tp_entry.txt holds
  "THRD" (pcpp's put a second file in the exe folder's parent; Adam's rows
  write only into the output folder). "/tp_entry.txt" is the name read from
  C (a plain path whose real file, at the root, is not there). While the
  thread's source is set this thread reads "THRD" and another thread still
  "PROG"; nil gives this thread the program's again; with no program path
  source the thread's still answers here and another thread finds nothing;
  setting one replaces the one before.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok thread source folder
  | ok thread source program file
  | ok thread source made
  | ok thread source program set
  | ok thread source none -> program
  | ok thread source get none
  | ok thread source set
  | ok thread source get
  | ok thread source this thread
  | ok thread source other thread -> program
  | ok thread source unset
  | ok thread source get unset
  | ok thread source unset -> program
  | ok thread source program unset
  | ok thread source alone set
  | ok thread source alone this thread
  | ok thread source alone other thread -> missing
  | ok thread source replace first
  | ok thread source replaced -> program folder
  | ok thread source replace second
  | ok thread source replaced -> memory
  | ok thread source last unset
  | ok thread source none -> missing
  | ok thread source program close
  | ok thread source thread close
  | ok thread source program removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_thread_path_source;

@ifdef TARGET_X86_64_WINDOWS_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

func clink std_hookio_c_read(APath: ptr to const char; ABuffer: ptr to uint8; ACap: clong;
  AReportSize: ptr to clong): clong; external "std_hookio_c";
func clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
func clink std_hookio_c_dirlen(APath: ptr to const char): clong; external "std_hookio_c";

const
  // The one entry of the row's memory source
  ADAM_TP_ENTRY_NAME: string = "tp_entry.txt";
  ADAM_TP_ENTRY_SIZE: int64 = 4;

type
  // A read on a thread of its own: the path, and what it read (the count, the first byte)
  ReadApart = record
    Path: string;
    Count: int64;
    First: uint8;
  end;

var
  GFails: int32;
  // The memory source's entry bytes ("THRD"); its user pointer
  GThreadBytes: array[0..3] of uint8;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The length of APath's folder part (the C fixture's); -1 when it has none
func DirLength(const APath: string): int64;
var
  LResult: clong;
begin
  LResult := std_hookio_c_dirlen(APath);
  return int64(LResult);
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
func WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LResult: int32;
begin
  LResult := std_hookio_c_writeraw(APath, ABytes, clong(ACount));
  return LResult = 0;
end;

// Deletes the file at APath; false when it is not deleted
func RemovePath(const APath: string): bool;
var
  LOk: bool;
begin
  LOk := RemoveFile(APath);
  return LOk;
end;

// APath read whole by C's fopen / fread (the C fixture's) into ABuffer (64 bytes): the count,
// -1 when the open fails
func ReadC(const APath: string; const ABuffer: ptr to uint8): int64;
var
  LSize: clong;
  LCount: clong;
begin
  LSize := 0;
  LCount := std_hookio_c_read(APath, ABuffer, 64, addr of LSize);
  return int64(LCount);
end;

// The memory source's Open: its one entry, read-only, over the user pointer's bytes
func MemoryOpen(const AUserData: ptr; const APath: string; const AMode: FileMode): IO;
begin
  if (APath <> ADAM_TP_ENTRY_NAME) or (AMode <> FileMode.Read) then
    return nil;
  end;
  return CreateMemoryIO(AUserData, ADAM_TP_ENTRY_SIZE, true);
end;

// The memory source's Exists: only its one entry
func MemoryExists(const AUserData: ptr; const APath: string): bool;
begin
  return APath = ADAM_TP_ENTRY_NAME;
end;

// The memory source's Size: its one entry's, else -1
func MemorySize(const AUserData: ptr; const APath: string): int64;
begin
  if APath = ADAM_TP_ENTRY_NAME then
    return ADAM_TP_ENTRY_SIZE;
  end;
  return -1;
end;

// The memory source's Close: it holds nothing of its own
func MemoryClose(const AUserData: ptr): bool;
begin
  return true;
end;

// A source holding one entry, tp_entry.txt, over GThreadBytes
func CreateMemorySource(): IOSource;
var
  LInterface: IOSourceInterface;
begin
  LInterface.Open := MemoryOpen;
  LInterface.Exists := MemoryExists;
  LInterface.Size := MemorySize;
  LInterface.Close := MemoryClose;
  LInterface.Remove := nil;
  return CreateIOSource(LInterface, ptr(addr of GThreadBytes[0]));
end;

// The thread of ReadApartCount: the hooked read of its record's path
func ReadApartRun(const AArg: ptr);
var
  LRead: ptr to ReadApart;
  LBuffer: array[0..63] of uint8;
begin
  LRead := ptr to ReadApart(AArg);
  LBuffer[0] := 0;
  LRead->Count := ReadC(LRead->Path, addr of LBuffer[0]);
  if LRead->Count > 0 then
    LRead->First := LBuffer[0];
  end;
end;

// A hooked read of APath on a thread of its own, waited for: the count ReadC gives (-1 also
// when the thread cannot start), the first byte read in AFirst
func ReadApartCount(const APath: string; var AFirst: uint8): int64;
var
  LRead: ReadApart;
  LThread: ptr;
begin
  LRead.Path := APath;
  LRead.Count := -1;
  LRead.First := 0;
  LThread := ThreadStart(ReadApartRun, ptr(addr of LRead));
  if LThread = nil then
    return -1;
  end;
  ThreadJoin(LThread);
  AFirst := LRead.First;
  return LRead.Count;
end;

func TestThreadPathSource();
var
  LExe: string;
  LFolder: string;
  LLength: int64;
  LProgramSource: IOSource;
  LThreadSource: IOSource;
  LProgramBytes: array[0..3] of uint8;
  LBuffer: array[0..63] of uint8;
  LCount: int64;
  LFirst: uint8;
begin
  LExe := paramstr(0);
  LLength := DirLength(LExe);
  Check("thread source folder", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LFolder := Substring(LExe, 0, LLength);
  LProgramBytes[0] := uint8('P');
  LProgramBytes[1] := uint8('R');
  LProgramBytes[2] := uint8('O');
  LProgramBytes[3] := uint8('G');
  GThreadBytes[0] := uint8('T');
  GThreadBytes[1] := uint8('H');
  GThreadBytes[2] := uint8('R');
  GThreadBytes[3] := uint8('D');
  Check("thread source program file", WriteRaw(LFolder + "/" + ADAM_TP_ENTRY_NAME,
    addr of LProgramBytes[0], 4));
  LProgramSource := CreateFolderIOSource(LFolder);
  LThreadSource := CreateMemorySource();
  Check("thread source made", (LProgramSource <> nil) and (LThreadSource <> nil));
  if (LProgramSource = nil) or (LThreadSource = nil) then
    return;
  end;

  Check("thread source program set", SetIOPathSource(LProgramSource));
  LBuffer[0] := 0;
  LCount := ReadC("/tp_entry.txt", addr of LBuffer[0]);
  Check("thread source none -> program", (LCount = 4) and (LBuffer[0] = uint8('P')));

  Check("thread source get none", GetIOThreadPathSource() = nil);
  Check("thread source set", SetIOThreadPathSource(LThreadSource));
  Check("thread source get", GetIOThreadPathSource() = LThreadSource);
  LBuffer[0] := 0;
  LCount := ReadC("/tp_entry.txt", addr of LBuffer[0]);
  Check("thread source this thread", (LCount = 4) and (LBuffer[0] = uint8('T')) and
    (LBuffer[3] = uint8('D')));
  LFirst := 0;
  LCount := ReadApartCount("/tp_entry.txt", LFirst);
  Check("thread source other thread -> program", (LCount = 4) and (LFirst = uint8('P')));

  Check("thread source unset", SetIOThreadPathSource(nil));
  Check("thread source get unset", GetIOThreadPathSource() = nil);
  LBuffer[0] := 0;
  LCount := ReadC("/tp_entry.txt", addr of LBuffer[0]);
  Check("thread source unset -> program", (LCount = 4) and (LBuffer[0] = uint8('P')));

  Check("thread source program unset", SetIOPathSource(nil));
  Check("thread source alone set", SetIOThreadPathSource(LThreadSource));
  LBuffer[0] := 0;
  LCount := ReadC("/tp_entry.txt", addr of LBuffer[0]);
  Check("thread source alone this thread", (LCount = 4) and (LBuffer[0] = uint8('T')));
  LFirst := 0;
  LCount := ReadApartCount("/tp_entry.txt", LFirst);
  Check("thread source alone other thread -> missing", LCount = -1);

  // A second set replaces the first: the program's folder, then the memory source
  Check("thread source replace first", SetIOThreadPathSource(LProgramSource));
  LBuffer[0] := 0;
  LCount := ReadC("/tp_entry.txt", addr of LBuffer[0]);
  Check("thread source replaced -> program folder", (LCount = 4) and (LBuffer[0] = uint8('P')));
  Check("thread source replace second", SetIOThreadPathSource(LThreadSource));
  LBuffer[0] := 0;
  LCount := ReadC("/tp_entry.txt", addr of LBuffer[0]);
  Check("thread source replaced -> memory", (LCount = 4) and (LBuffer[0] = uint8('T')));

  Check("thread source last unset", SetIOThreadPathSource(nil));
  LCount := ReadC("/tp_entry.txt", addr of LBuffer[0]);
  Check("thread source none -> missing", LCount = -1);

  Check("thread source program close", IOSourceClose(LProgramSource));
  Check("thread source thread close", IOSourceClose(LThreadSource));
  Check("thread source program removed", RemovePath(LFolder + "/" + ADAM_TP_ENTRY_NAME));
end;

begin
  GFails := 0;
  TestThreadPathSource();
  println("done {}", GFails);
end.
