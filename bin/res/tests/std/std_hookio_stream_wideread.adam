*/

module exe std_hookio_stream_wideread;

@ifdef TARGET_X86_64_WINDOWS_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_wrsample(AVariant: int32; ABuffer: ptr to uint8;
  ACap: clong): clong; external "std_hookio_c";
routine clink std_hookio_c_wideread(APath: ptr to const char; AMode: ptr to const char;
  ALocale: ptr to const char; AVariant: int32; AResults: ptr to int64); external "std_hookio_c";

const
  // std_hookio_c_wideread's variants, its result slots and the slots compared (72: the locale
  // was set, 73: the open succeeded)
  CVariants: int32 = 12;
  CSlots: int32 = 75;
  // The modes ReadMode names, and the room a sample takes
  CModes: int32 = 6;
  CSampleRoom: int64 = 6000;
  // The one byte of the reset file FreshDescriptor reads ('x')
  CResetByte: uint8 = 120;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// One check of a case: nothing when it held, else a FAIL line naming it, counted in ABad
routine Part(const AName: string; const APart: string; const AOk: bool; var ABad: int32);
begin
  if not AOk then
    println("FAIL {} {}", AName, APart);
    ABad := ABad + 1;
  end;
end;

// The end of a case: its ok line when no check of it failed; the failures counted
routine Finish(const AName: string; const ABad: int32);
begin
  if ABad = 0 then
    println("ok {}", AName);
  end;
  GFails := GFails + ABad;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// The locales the wide rows run under: "C", then ucrt's UTF-8 one
routine WideLocale(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "C";
  end;
  return ".UTF8";
end;

// The locale setlocale is given for the locale named AIndex in the lines: ".UTF8" is ucrt's
// UTF-8 locale; on x86_64-linux-gnu glibc's C.UTF-8
routine LocaleName(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "C";
  end;
@ifdef TARGET_X86_64_LINUX_GNU
  return "C.UTF-8";
@else
  return ".UTF8";
@endif
end;

// The read mode number AIndex: text by default, b, t (pcpp's three), then the three ccs= text
// modes
routine ReadMode(const AIndex: int32): string;
begin
  if AIndex = 1 then
    return "rb";
  end;
  if AIndex = 2 then
    return "rt";
  end;
  if AIndex = 3 then
    return "r, ccs=UTF-8";
  end;
  if AIndex = 4 then
    return "r, ccs=UTF-16LE";
  end;
  if AIndex = 5 then
    return "r, ccs=UNICODE";
  end;
  return "r";
end;

// The fixture's sequence AVariant on APath in AMode under ALocale: its slots in AResults
routine ReadC(const APath: string; const AMode: string; const ALocale: string;
  const AVariant: int32; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
  LLocale: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LLocale := StringToC(ALocale);
  std_hookio_c_wideread(LPath, LMode, LLocale, AVariant, AResults);
  freemem(LPath);
  freemem(LMode);
  freemem(LLocale);
end;

// A UTF-8 read of the 1-byte ASCII file at APath through the C runtime's own FILE, closed
// again: the descriptor slot the next real open takes is left as a fresh one is (its UTF-8
// read changed no character count and began at 0); whether it read the byte
routine FreshDescriptor(const APath: string): bool;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LMode := StringToC("r, ccs=UTF-8");
  LFile := fopen(LPath, LMode);
  LOk := LFile <> nil;
  if LOk then
    LOk := fgetwc(LFile) = uint16(CResetByte);
    fclose(LFile);
  end;
  freemem(LPath);
  freemem(LMode);
  return LOk;
end;

// One case: variant AVariant in ReadMode(AMode) under locale ALocale, on a new memory IO
// holding the sample's ALength bytes at ASample and on the real file of the same bytes (its
// descriptor made fresh first by the reset file at AResetPath)
routine ReadCase(const ARealPath: string; const AResetPath: string; const ASample: ptr to uint8;
  const ALength: int64; const AVariant: int32; const ALocale: int32; const AMode: int32);
var
  LMemory: IO;
  LPrefix: string;
  LName: string;
  LBad: int32;
  LVirtual: array[0..140] of int64;
  LReal: array[0..140] of int64;
begin
  LBad := 0;
  LName := "wide read " + IntToStr(AVariant) + " " + WideLocale(ALocale) + " " +
    ReadMode(AMode);
  LMemory := CreateMemoryIO();
  Part(LName, "io", (IOWrite(LMemory, ptr(ASample), ALength) = ALength) and
    (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0), LBad);
  LPrefix := RegisterIO(LMemory);
  Part(LName, "real file", WriteRaw(ARealPath, ASample, ALength), LBad);
  ReadC(LPrefix + "/r.txt", ReadMode(AMode), LocaleName(ALocale), AVariant,
    addr of LVirtual[0]);
  Part(LName, "fresh descriptor", FreshDescriptor(AResetPath), LBad);
  ReadC(ARealPath, ReadMode(AMode), LocaleName(ALocale), AVariant, addr of LReal[0]);
  Part(LName, "ran", (LVirtual[72] = 1) and (LVirtual[73] = 1) and (LReal[72] = 1) and
    (LReal[73] = 1), LBad);
  Part(LName, "as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], CSlots), LBad);
  Part(LName, "unregister", UnregisterIO(LPrefix), LBad);
  Part(LName, "io close", IOClose(LMemory), LBad);
  Finish(LName, LBad);
end;

// The wide input side from C on a virtual file and on a real file of each variant's sample,
// under both locales, in every mode ReadMode names
routine TestStreamWideRead();
var
  LSample: array[0..5999] of uint8;
  LReset: array[0..0] of uint8;
  LLength: int64;
  LRealPath: string;
  LResetPath: string;
  LVariant: int32;
  LLocale: int32;
  LMode: int32;
begin
  LRealPath := paramstr(0) + ".wread.txt";
  LResetPath := paramstr(0) + ".wreset.txt";
  LReset[0] := CResetByte;
  Check("wide read reset file", WriteRaw(LResetPath, addr of LReset[0], 1));
  for LVariant := 0 to CVariants - 1 do
    LLength := int64(std_hookio_c_wrsample(LVariant, addr of LSample[0], clong(CSampleRoom)));
    Check("wide read sample " + IntToStr(LVariant), LLength > 0);
    for LLocale := 0 to 1 do
      for LMode := 0 to CModes - 1 do
        ReadCase(LRealPath, LResetPath, addr of LSample[0], LLength, LVariant, LLocale, LMode);
      end;
    end;
  end;
  Check("wide read real removed", RemovePath(LRealPath));
  Check("wide read reset removed", RemovePath(LResetPath));
end;

begin
  GFails := 0;
  TestStreamWideRead();
  println("done {}", GFails);
end.
