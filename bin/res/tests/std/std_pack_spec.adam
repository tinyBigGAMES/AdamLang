-------------------------------------------------------------------------------
  std_pack_spec.adam - System.Pack's Packer.LoadSpec: a good spec (name /
  version put in, two archives: the flat form and the source form, every
  relative path taken from the SPEC's folder: outputs, roots, source paths,
  the signing key; the default store globs) loaded and its outputs checked;
  then each wrong spec refused at its line and column with its reason: an
  unknown key at the top, in [[archive]], in [[archive.source]] and in
  [sign]; no [[archive]]; archive not an array; an archive with no output,
  with no include, with both forms; a glob with `..`, an absolute glob, an
  absolute prefix part `..`; unix_mode of 0, past 0o7777, as a string, not
  a table; checksum not a bool; [sign] with no seckey; a TOML syntax error;
  a spec that is not there. A refused spec holds no archive. Discover and
  Build with no spec loaded fail. The spec files are written in the row's
  own folder below its exe and removed at the end. Both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | good true
  | good name Adam version 0.1.0 archives 2
  | good output 0 true
  | good output 1 true
  | unknown top false
  | unknown top reason (4,10): unknown key colour
  | unknown archive false
  | unknown archive reason (6,10): unknown key outptu
  | unknown source false
  | unknown source reason (8,8): unknown key paht
  | unknown sign false
  | unknown sign reason (3,7): unknown key key
  | no archive false
  | no archive reason (1,1): the spec has no [[archive]]
  | archive not array false
  | archive not array reason (1,11): archive is not an array
  | no output false
  | no output reason (1,3): archive[0] has no output
  | no include false
  | no include reason (1,3): archive[0] has no include
  | both forms false
  | both forms reason (1,3): archive[0] has both source tables and root / prefix / include
  | dotdot glob false
  | dotdot glob reason (3,12): bad glob ../x/a
  | absolute glob false
  | absolute glob reason (3,12): bad glob C:/x/a
  | dotdot prefix false
  | dotdot prefix reason (3,10): bad prefix a/../b
  | mode zero false
  | mode zero reason (4,25): 0 is no unix mode (1 .. 0o7777)
  | mode high false
  | mode high reason (4,25): 4096 is no unix mode (1 .. 0o7777)
  | mode string false
  | mode string reason (4,25): "archive[0].unix_mode."bin/a"" is a string, not an integer
  | mode not table false
  | mode not table reason (4,13): archive[0].unix_mode is not a table
  | checksum not bool false
  | checksum not bool reason (4,12): "archive[0].checksum" is an integer, not a boolean
  | no seckey false
  | no seckey reason (1,2): [sign] has no seckey
  | syntax error false
  | syntax error reason (1,10): missing ']]'
  | missing spec false
  | refused holds none 0
  | discover without spec false no spec is loaded
  | build without spec false no spec is loaded
  | removed true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_pack_spec;

import System.SysUtils, System.IO, System.Pack;

var
  GDir: string;
  GSpec: string;
  GPacker: Packer;
  GEntries: PackEntries;
  GOk: bool;

// The spec text ALines (one string, `|` between lines) written to the row's spec file and
// loaded: its result, and its reason after the spec's file name when AReason
func Try(const ALabel: string; const ALines: string; const AReason: bool);
var
  LError: string;
  LAt: int64;
begin
  WriteAllText(GSpec, ReplaceStr(ALines, "|", "\n"));
  println("{} {}", ALabel, GPacker.LoadSpec(GSpec));
  if AReason then
    LError := GPacker.ErrorText();
    LAt := IndexOf("s.toml", LError, 0);
    println("{} reason {}", ALabel, Substring(LError, LAt + 6, len(LError) - LAt - 6));
  end;
end;

begin
  GDir := ExeDir() + "/std_pack_spec_files";
  RemoveDir(GDir, true);
  CreateDir(GDir);
  GSpec := GDir + "/s.toml";

  Try("good", "name = \"Adam\"|version = \"0.1.0\"|[sign]|seckey = \"keys/a.key\"|" +
    "[[archive]]|output = \"out/{name}-{version}.zip\"|root = \"tree\"|include = [\"**\"]|" +
    "unix_mode = { \"bin/adam\" = 0o755 }|checksum = true|" +
    "[[archive]]|output = \"two.zip\"|exclude = [\"**/*.bak\"]|[[archive.source]]|" +
    "path = \"tree/res\"|prefix = \"res\"|include = [\"**/*.adam\"]", false);
  println("good name {} version {} archives {}", GPacker.SpecName(), GPacker.SpecVersion(),
    GPacker.ArchiveCount());
  println("good output 0 {}", SamePath(GPacker.ArchiveOutput(0), GDir + "/out/Adam-0.1.0.zip"));
  println("good output 1 {}", SamePath(GPacker.ArchiveOutput(1), GDir + "/two.zip"));

  Try("unknown top", "name = \"a\"|[[archive]]|output = \"x.zip\"|colour = 1", true);
  Try("unknown archive", "[[archive]]|output = \"x.zip\"|include = [\"*\"]|||outptu = 1", true);
  Try("unknown source", "[[archive]]|output = \"x.zip\"|[[archive.source]]|path = \"a\"|" +
    "include = [\"*\"]|[[archive.source]]|include = [\"*\"]|paht = \"b\"", true);
  Try("unknown sign", "[sign]|seckey = \"k\"|key = 1|[[archive]]|output = \"x.zip\"|" +
    "include = [\"*\"]", true);
  Try("no archive", "name = \"a\"", true);
  Try("archive not array", "archive = \"x\"", true);
  Try("no output", "[[archive]]|include = [\"*\"]", true);
  Try("no include", "[[archive]]|output = \"x.zip\"", true);
  Try("both forms", "[[archive]]|output = \"x.zip\"|root = \"a\"|[[archive.source]]|" +
    "include = [\"*\"]", true);
  Try("dotdot glob", "[[archive]]|output = \"x.zip\"|include = [\"../x/a\"]", true);
  Try("absolute glob", "[[archive]]|output = \"x.zip\"|include = [\"C:/x/a\"]", true);
  Try("dotdot prefix", "[[archive]]|output = \"x.zip\"|prefix = \"a/../b\"|include = [\"*\"]",
    true);
  Try("mode zero", "[[archive]]|output = \"x.zip\"|include = [\"*\"]|" +
    "unix_mode = { \"bin/a\" = 0 }", true);
  Try("mode high", "[[archive]]|output = \"x.zip\"|include = [\"*\"]|" +
    "unix_mode = { \"bin/a\" = 0o10000 }", true);
  Try("mode string", "[[archive]]|output = \"x.zip\"|include = [\"*\"]|" +
    "unix_mode = { \"bin/a\" = \"0755\" }", true);
  Try("mode not table", "[[archive]]|output = \"x.zip\"|include = [\"*\"]|" +
    "unix_mode = 493", true);
  Try("checksum not bool", "[[archive]]|output = \"x.zip\"|include = [\"*\"]|checksum = 1",
    true);
  Try("no seckey", "[sign]|trusted_comment = \"t\"|[[archive]]|output = \"x.zip\"|" +
    "include = [\"*\"]", true);
  Try("syntax error", "[[archive]|output = ", true);
  println("missing spec {}", GPacker.LoadSpec(GDir + "/none.toml"));
  println("refused holds none {}", GPacker.ArchiveCount());

  GOk := GPacker.Discover(0, GEntries);
  println("discover without spec {} {}", GOk, GPacker.ErrorText());
  GOk := GPacker.Build(nil, nil);
  println("build without spec {} {}", GOk, GPacker.ErrorText());

  println("removed {}", RemoveDir(GDir, true));
end.
