-------------------------------------------------------------------------------
  std_customio_entryinfo.adam - System.CustomIO's GetZipEntryInfo over the
  zip fixtures

  GetZipEntryInfo reads an entry's size and CRC-32 from the central
  directory of the fixtures in res\tests\std\fixtures (git-ignored, written
  by the dev-side gen_zips.py): stored, nested, empty, deflated, ZIP64,
  data before the archive, a large deflated entry. Each CRC is checked
  against the CRC of the entry's own bytes, read through CreateZipFileIO
  (System.Zlib's ZlibCrc32), so no expected CRC is written by hand. An
  encrypted entry's info reads with the right, a wrong or no password (the
  directory is never encrypted); an entry whose CRC does not match its
  data still has its info (only opening it fails). A missing entry, a
  folder, a refused path, "", a missing archive and a file that is no zip
  give false and leave the record as it was. pcpp's own zipinfo row packs
  its archives with ZipDirectoryContents, so it is ported with the writer.
  Each row prints ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok info hello
  | ok info hello size
  | ok info hello crc
  | ok info empty
  | ok info empty crc
  | ok info nested
  | ok info deflated
  | ok info zip64
  | ok info prefixed
  | ok info large
  | ok info secret right
  | ok info secret wrong
  | ok info secret none
  | ok info secret same
  | ok info secret crc
  | ok info bad crc reads
  | ok info bad crc no open
  | ok info missing
  | ok info folder
  | ok info refused
  | ok info empty path
  | ok info missing archive
  | ok info no zip
  | ok info failures kept
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_customio_entryinfo;

import System.SysUtils, System.Zlib, System.CustomIO;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The CRC-32 of an entry's bytes, read whole through CreateZipFileIO; -1 when it does not
// open or read
routine EntryCrc(const APath: string; const AEntry: string; const APassword: string): int64;
var
  LIO: IO;
  LText: string;
  LBytes: ByteArray;
  LOk: bool;
  LI: int64;
begin
  LIO := CreateZipFileIO(APath, AEntry, APassword);
  if LIO = nil then
    return -1;
  end;
  LText := "";
  LOk := IOReadAll(LIO, LText);
  IOClose(LIO);
  if not LOk then
    return -1;
  end;
  setlength(LBytes, len(LText));
  for LI := 0 to len(LText) - 1 do
    LBytes[LI] := uint8(LText[LI]);
  end;
  return int64(ZlibCrc32(0, LBytes));
end;

// True when GetZipEntryInfo finds AEntry with ASize bytes and the CRC of its own bytes
routine InfoMatches(const APath: string; const AEntry: string; const ASize: int64): bool;
var
  LInfo: ZipEntryInfo;
begin
  if not GetZipEntryInfo(APath, AEntry, "", LInfo) then
    return false;
  end;
  return (LInfo.Size = ASize) and (int64(LInfo.Crc) = EntryCrc(APath, AEntry, ""));
end;

routine TestEntryInfo();
var
  LStored: string;
  LSecret: string;
  LInfo: ZipEntryInfo;
  LWrong: ZipEntryInfo;
  LNone: ZipEntryInfo;
  LBad: ZipEntryInfo;
  LKept: ZipEntryInfo;
  LOk: bool;
begin
  LStored := "$P:../res/tests/std/fixtures/std_customio_stored.zip";
  LSecret := "$P:../res/tests/std/fixtures/std_customio_password.zip";

  // The directory's size and CRC, the CRC the entry's own bytes have
  Check("info hello", GetZipEntryInfo(LStored, "hello.txt", "", LInfo));
  Check("info hello size", LInfo.Size = 12);
  Check("info hello crc", int64(LInfo.Crc) = EntryCrc(LStored, "hello.txt", ""));
  Check("info empty", GetZipEntryInfo(LStored, "empty.txt", "", LInfo) and (LInfo.Size = 0));
  Check("info empty crc", LInfo.Crc = uint32(0));
  Check("info nested", InfoMatches(LStored, "data/bytes.bin", 256));
  Check("info deflated", InfoMatches("$P:../res/tests/std/fixtures/std_customio_deflated.zip", "text.txt", 8200));
  Check("info zip64", InfoMatches("$P:../res/tests/std/fixtures/std_customio_zip64.zip", "z64/b.bin", 4096));
  Check("info prefixed", InfoMatches("$P:../res/tests/std/fixtures/std_customio_prefixed.zip", "top.txt", 4));
  Check("info large", InfoMatches("$P:../res/tests/std/fixtures/std_customio_large.zip", "big_text.txt", 2400000));

  // An encrypted entry: the directory is never encrypted
  Check("info secret right", GetZipEntryInfo(LSecret, "secret.txt", "pcpp-secret", LInfo));
  Check("info secret wrong", GetZipEntryInfo(LSecret, "secret.txt", "wrong-pass", LWrong));
  Check("info secret none", GetZipEntryInfo(LSecret, "secret.txt", "", LNone));
  Check("info secret same", (LInfo.Size = 11) and (LWrong.Size = 11) and (LNone.Size = 11) and
    (LWrong.Crc = LInfo.Crc) and (LNone.Crc = LInfo.Crc));
  Check("info secret crc", int64(LInfo.Crc) = EntryCrc(LSecret, "secret.txt", "pcpp-secret"));

  // A CRC that does not match the data: the info reads, the entry does not open
  Check("info bad crc reads", GetZipEntryInfo("$P:../res/tests/std/fixtures/std_customio_badcrc.zip", "bad.txt", "", LBad));
  Check("info bad crc no open", EntryCrc("$P:../res/tests/std/fixtures/std_customio_badcrc.zip", "bad.txt", "") = -1);

  // Every failure leaves the record as it was
  LKept.Size := -7;
  LKept.Crc := 99;
  Check("info missing", not GetZipEntryInfo(LStored, "missing.txt", "", LKept));
  Check("info folder", not GetZipEntryInfo(LStored, "data", "", LKept));
  Check("info refused", not GetZipEntryInfo(LStored, "../hello.txt", "", LKept));
  Check("info empty path", not GetZipEntryInfo(LStored, "", "", LKept));
  Check("info missing archive", not GetZipEntryInfo("$P:../res/tests/std/fixtures/std_customio_none.zip", "hello.txt", "", LKept));
  Check("info no zip", not GetZipEntryInfo("$P:../res/tests/std/std_customio_entryinfo.adam", "hello.txt", "", LKept));
  LOk := (LKept.Size = -7) and (LKept.Crc = uint32(99));
  Check("info failures kept", LOk);
end;

begin
  GFails := 0;
  TestEntryInfo();
  println("{}", "done " + IntToStr(int64(GFails)));
end.
