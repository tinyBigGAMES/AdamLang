-------------------------------------------------------------------------------
  std_hookio_stream_text.adam - the printf family on a HookIO handle
  (PaskalCPP's std_hookio TestStreamText)

  C's fprintf, a vfprintf through a va_list and mingw's own fprintf write
  "a1|bx|c3|" through a handle the C library opens "ab"; then a handle the
  program opens "ab" itself is printed to by the same C family (pcpp's C++
  pair: Adam has no C++, and UCRT inlines printf, so the fixture makes the
  calls), "d4|ey|". The IO holds the 15 bytes in order.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok print C fprintf
  | ok print C vfprintf
  | ok print C third form
  | ok print C close
  | ok print open
  | ok print own fprintf
  | ok print own vfprintf
  | ok print close
  | ok print text
  | ok print unregister
  | ok print io close
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_text;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

routine clink std_hookio_c_print(APath: ptr to const char; AResults: ptr to int64);
  external "std_hookio_c";
routine clink std_hookio_c_fprintf_file(AFile: ptr): int32; external "std_hookio_c";
routine clink std_hookio_c_vfprintf_file(AFile: ptr): int32; external "std_hookio_c";

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

routine SameBytes(const AFirst: ptr; const ASecond: ptr; const ACount: int64): bool;
var
  LFirst: ptr to uint8;
  LSecond: ptr to uint8;
  LI: int64;
begin
  LFirst := ptr to uint8(AFirst);
  LSecond := ptr to uint8(ASecond);
  for LI := 0 to ACount - 1 do
    if LFirst[LI] <> LSecond[LI] then
      return false;
    end;
  end;
  return true;
end;

// fopen of an Adam text path and mode (their C copies freed after the call)
routine OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

// True when AIO holds exactly the text AExpect, read from its start
routine HoldsText(const AIO: IO; const AExpect: string): bool;
var
  LText: array[0..63] of uint8;
  LExpect: ptr to char;
  LSize: int64;
  LOk: bool;
begin
  LSize := IOSize(AIO);
  if (LSize <> int64(len(AExpect))) or (LSize > 64) then
    return false;
  end;
  if IOSeek(AIO, 0, SeekOrigin.FromStart) <> 0 then
    return false;
  end;
  if IORead(AIO, ptr(addr of LText[0]), LSize) <> LSize then
    return false;
  end;
  LExpect := StringToC(AExpect);
  LOk := SameBytes(ptr(addr of LText[0]), ptr(LExpect), LSize);
  freemem(LExpect);
  return LOk;
end;

// The printf family through a handle the C library opens and through one the program opens,
// both "ab" on one registered memory IO
routine TestStreamText();
var
  LTarget: IO;
  LPrefix: string;
  LPath: ptr to char;
  LFile: ptr;
  LPrint: array[0..3] of int64;
begin
  LTarget := CreateMemoryIO();
  LPrefix := RegisterIO(LTarget);
  LPath := StringToC(LPrefix + "/log.txt");
  std_hookio_c_print(LPath, addr of LPrint[0]);
  freemem(LPath);
  Check("print C fprintf", LPrint[0] = 3);
  Check("print C vfprintf", LPrint[1] = 3);
  Check("print C third form", LPrint[2] = 3);
  Check("print C close", LPrint[3] = 0);

  LFile := OpenPath(LPrefix + "/log.txt", "ab");
  Check("print open", (LFile <> nil) and (FileIO(LFile) = LTarget));
  if (LFile = nil) or (FileIO(LFile) = nil) then
    if LFile <> nil then
      fclose(LFile);
    end;
    Check("print handle rows", false);
  else
    Check("print own fprintf", std_hookio_c_fprintf_file(LFile) = 3);
    Check("print own vfprintf", std_hookio_c_vfprintf_file(LFile) = 3);
    Check("print close", fclose(LFile) = 0);
  end;
  Check("print text", HoldsText(LTarget, "a1|bx|c3|d4|ey|"));
  Check("print unregister", UnregisterIO(LPrefix));
  Check("print io close", IOClose(LTarget));
end;

begin
  GFails := 0;
  TestStreamText();
  println("done {}", GFails);
end.
