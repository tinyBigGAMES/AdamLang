-------------------------------------------------------------------------------
  std_hookio_stat_win64.adam - ucrt's stat family on a virtual path on win64
  (PLAN-LINUX64 LX3d3e3c, the parity of linux's stat / __xstat hooks): _stat32,
  _stat32i64, _stat64i32, _stat64 and _wstat32 .. _wstat64 of a zip entry and
  of a registered IO (a regular file of its size, read for everyone, write
  when the entry takes a write open, execute for a .exe name, one link),
  a missing entry ENOENT, a nil buffer ucrt's failed
  parameter check (EINVAL, the handler) before the file is looked at, and a
  real path left to ucrt.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu
  exitcode 0
  | ok stat kinds zip
  | ok stat read-only zip
  | ok wstat kinds zip
  | ok stat writable memory
  | ok stat executable name
  | ok stat missing
  | ok stat nil buffer
  | ok wstat nil buffer
  | ok stat real ucrt
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stat_win64;

@ifndef TARGET_X86_64_WINDOWS_GNU
@message error "std_hookio_stat_win64 runs on x86_64-windows-gnu only: build it with -t x86_64-windows-gnu";
@endif

import System.Windows, System.SysUtils, System.Runtime, System.CustomIO, System.HookIO,
  System.HookIO.Win64;

// ucrt's handler of a failed parameter check for this thread (it comes before the process's)
func _set_thread_local_invalid_parameter_handler(const AHandler: func(
  const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64)): ptr;
  external "ucrtbase";

const
  // ucrt's errno.h
  ENOENT: int32 = 2;
  EINVAL: int32 = 22;
  // A regular file's read bits for owner, group and other, and its write bits
  ADAM_TEST_READ_BITS: uint16 = 0x0124;
  ADAM_TEST_WRITE_BITS: uint16 = 0x0092;
  ADAM_TEST_EXEC_BITS: uint16 = 0x0049;
  ADAM_TEST_ZIP: string = "$P:../../../../res/tests/std/fixtures/std_customio_stored.zip";
  ADAM_TEST_SIZE: int64 = 12;

var
  GFails: int32;
  // The failed parameter checks so far
  GInvalid: int64;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The thread's invalid parameter handler: counts the call and returns
func OnInvalid(const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64);
begin
  GInvalid := GInvalid + 1;
end;

// True when AMode is a regular file's with read bits for all and the write bits exactly when
// AWrite asks (execute exactly when AExec does)
func ModeIs(const AMode: uint16; const AWrite: bool; const AExec: bool): bool;
var
  LOk: bool;
begin
  LOk := ((AMode & _S_IFMT) = _S_IFREG) and ((AMode & ADAM_TEST_READ_BITS) = ADAM_TEST_READ_BITS);
  LOk := LOk and (((AMode & ADAM_TEST_WRITE_BITS) = ADAM_TEST_WRITE_BITS) = AWrite) and
    (((AMode & ADAM_TEST_WRITE_BITS) = 0) = (not AWrite));
  LOk := LOk and (((AMode & ADAM_TEST_EXEC_BITS) = ADAM_TEST_EXEC_BITS) = AExec) and
    (((AMode & ADAM_TEST_EXEC_BITS) = 0) = (not AExec));
  return LOk;
end;

// The four narrow records of APath: each a regular file of ASize bytes, one link, write as
// AWrite, execute as AExec
func KindsOf(const APath: string; const ASize: int64; const AWrite: bool;
  const AExec: bool): bool;
var
  LPath: ptr to char;
  L32: System.Windows._stat32;
  L32i64: System.Windows._stat32i64;
  L64i32: System.Windows._stat64i32;
  L64: System.Windows._stat64;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := (_stat32(LPath, addr of L32) = 0) and (_stat32i64(LPath, addr of L32i64) = 0) and
    (_stat64i32(LPath, addr of L64i32) = 0) and (_stat64(LPath, addr of L64) = 0);
  freemem(LPath);
  if not LOk then
    return false;
  end;
  return ModeIs(L32.st_mode, AWrite, AExec) and (int64(L32.st_size) = ASize) and (L32.st_nlink = 1) and
    ModeIs(L32i64.st_mode, AWrite, AExec) and (L32i64.st_size = ASize) and
    ModeIs(L64i32.st_mode, AWrite, AExec) and (int64(L64i32.st_size) = ASize) and
    ModeIs(L64.st_mode, AWrite, AExec) and (L64.st_size = ASize) and (L64.st_nlink = 1);
end;

// The four wide records of APath, as KindsOf
func WideKindsOf(const APath: string; const ASize: int64): bool;
var
  LWide: own WideBox;
  L32: System.Windows._stat32;
  L32i64: System.Windows._stat32i64;
  L64i32: System.Windows._stat64i32;
  L64: System.Windows._stat64;
  LPath: ptr to const wchar;
begin
  LWide := own WideBox();
  Utf8ToWide(APath, LWide.Data);
  LPath := ptr to const wchar(addr of LWide.Data[0]);
  if (_wstat32(LPath, addr of L32) <> 0) or (_wstat32i64(LPath, addr of L32i64) <> 0) or
    (_wstat64i32(LPath, addr of L64i32) <> 0) or (_wstat64(LPath, addr of L64) <> 0) then
    return false;
  end;
  return ModeIs(L32.st_mode, false, false) and (int64(L32.st_size) = ASize) and
    ModeIs(L32i64.st_mode, false, false) and (L32i64.st_size = ASize) and
    ModeIs(L64i32.st_mode, false, false) and (int64(L64i32.st_size) = ASize) and
    ModeIs(L64.st_mode, false, false) and (L64.st_size = ASize);
end;

// _stat64 of APath with ABuf: the answer, errno after it in AError
func StatOf(const APath: string; const ABuf: ptr; var AError: int32): int32;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  SetCErrno(0);
  LResult := _stat64(LPath, ABuf);
  AError := CErrno();
  freemem(LPath);
  return LResult;
end;

var
  LZip: IOSource;
  LPrefix: string;
  LMemory: IO;
  LMemoryPrefix: string;
  LData: array[0..4] of uint8;
  L64: System.Windows._stat64;
  LError: int32;
  LBefore: int64;
  LWide: own WideBox;
begin
  _set_thread_local_invalid_parameter_handler(OnInvalid);
  LZip := CreateZipIOSource(ADAM_TEST_ZIP);
  LPrefix := RegisterIOSource(LZip);
  Check("stat kinds zip", KindsOf(LPrefix + "/hello.txt", ADAM_TEST_SIZE, false, false));
  Check("stat read-only zip", (StatOf(LPrefix + "/hello.txt", addr of L64, LError) = 0) and
    ((L64.st_mode & ADAM_TEST_WRITE_BITS) = 0));
  Check("wstat kinds zip", WideKindsOf(LPrefix + "/hello.txt", ADAM_TEST_SIZE));
  // A registered memory IO of 5 bytes: writable, and every name under its prefix is it
  for LError := 0 to 4 do
    LData[LError] := uint8(65 + LError);
  end;
  LMemory := CreateMemoryIO(addr of LData[0], 5, false);
  LMemoryPrefix := RegisterIO(LMemory);
  Check("stat writable memory", KindsOf(LMemoryPrefix + "/data.bin", 5, true, false));
  Check("stat executable name", KindsOf(LMemoryPrefix + "/tool.EXE", 5, true, true));
  Check("stat missing", (StatOf(LPrefix + "/missing.txt", addr of L64, LError) = -1) and (LError = ENOENT));
  // ucrt checks the buffer before it looks at the file: a missing one is refused the same way
  LBefore := GInvalid;
  Check("stat nil buffer", (StatOf(LPrefix + "/hello.txt", nil, LError) = -1) and (LError = EINVAL) and
    (StatOf(LPrefix + "/missing.txt", nil, LError) = -1) and (LError = EINVAL) and
    (GInvalid = LBefore + 2));
  LWide := own WideBox();
  Utf8ToWide(LPrefix + "/hello.txt", LWide.Data);
  LBefore := GInvalid;
  SetCErrno(0);
  Check("wstat nil buffer", (_wstat64(ptr to const wchar(addr of LWide.Data[0]), nil) = -1) and
    (CErrno() = EINVAL) and (GInvalid = LBefore + 1));
  Check("stat real ucrt", (StatOf(paramstr(0), addr of L64, LError) = 0) and
    ((L64.st_mode & _S_IFMT) = _S_IFREG) and (L64.st_size > 0));
  UnregisterIO(LMemoryPrefix);
  IOClose(LMemory);
  UnregisterIO(LPrefix);
  IOSourceClose(LZip);
  println("done {}", GFails);
end.
