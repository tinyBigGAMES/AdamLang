-------------------------------------------------------------------------------
  std_raylib_frame_rules.adam - System.Raylib.Ext's frame rules with no window
  (PLAN-LINUX64 LX3d3c3b1, PaskalCPP's std_raylib_ext_frame), on both
  targets.

  GetScaledFrameSize (base x DPI / 96, rounded; 120 DPI gives 562.5,
  rounded away from zero), GetLetterboxRect (a window of the frame's
  aspect, a wider one: bars left and right, a taller one: bars above and
  below, a resize, a size of 0: the whole window), GetIntegerLetterboxRect
  (an exact multiple fills the window, a size between multiples takes the
  lower one centred, odd bars round down, the smaller side decides, a
  window below the base size gets the fit rule, a size of 0: the whole
  window) and GetFramePoint (a point through the letterbox in base units,
  clamped to the frame in a bar and past the edge, an empty letterbox:
  0, 0).

  Refused before any window exists: a base size of 0 x 0 or a negative one
  (false, no window, GetFrameWidth 0, GetFrameLetterbox empty); the zoom is
  1 by default, and a zoom of 0 or a negative one is taken as 1. With no
  frame window GetFrameDpi is 96 and the frame calls do nothing.

  Each row prints ok or FAIL with its name; the last is `done <failures>`.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok scaled 96
  | ok scaled 144
  | ok scaled 120 rounded
  | ok scaled 192
  | ok letterbox same aspect
  | ok letterbox wider window
  | ok letterbox taller window
  | ok letterbox resized
  | ok letterbox zero window
  | ok letterbox zero base
  | ok integer exact multiple
  | ok integer between multiples
  | ok integer odd bars round down
  | ok integer height decides
  | ok integer below base is fit
  | ok integer zero window
  | ok integer zero base
  | ok point centre
  | ok point left bar clamped
  | ok point past edge clamped
  | ok point empty letterbox
  | ok refused 0 x 0
  | ok refused negative
  | ok no window after refusal
  | ok no frame letterbox after refusal
  | ok no frame dpi 96
  | ok no frame calls do nothing
  | ok zoom default 1
  | ok zoom 0 is 1
  | ok zoom negative is 1
  | ok zoom kept
  | ok colours default
  | ok colours set before a window
  | ok integer scale set before a window
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raylib_frame_rules;

import System.Raylib.C, System.Raylib.Ext;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// Float results compared to a thousandth (they are whole or half units)
func Near(const AGot: float32; const AWant: float32): bool;
begin
  return (AGot - AWant < 0.001f) and (AWant - AGot < 0.001f);
end;

func CheckSize(const AName: string; const AGot: Vector2; const AWidth: float32;
  const AHeight: float32);
begin
  Check(AName, Near(AGot.x, AWidth) and Near(AGot.y, AHeight));
end;

func CheckRect(const AName: string; const AGot: Rectangle; const AX: float32; const AY: float32;
  const AWidth: float32; const AHeight: float32);
begin
  Check(AName, Near(AGot.x, AX) and Near(AGot.y, AY) and Near(AGot.width, AWidth) and
    Near(AGot.height, AHeight));
end;

func EmptyRect(const ARect: Rectangle): bool;
begin
  return Near(ARect.x, 0.0f) and Near(ARect.y, 0.0f) and Near(ARect.width, 0.0f) and
    Near(ARect.height, 0.0f);
end;

func SameColor(const AA: Color; const AB: Color): bool;
begin
  return (AA.r = AB.r) and (AA.g = AB.g) and (AA.b = AB.b) and (AA.a = AB.a);
end;

func TestRules();
var
  LBox: Rectangle;
  LEmpty: Rectangle;
  LPoint: Vector2;
begin
  CheckSize("scaled 96", GetScaledFrameSize(800, 450, 96), 800.0f, 450.0f);
  CheckSize("scaled 144", GetScaledFrameSize(800, 450, 144), 1200.0f, 675.0f);
  CheckSize("scaled 120 rounded", GetScaledFrameSize(800, 450, 120), 1000.0f, 563.0f);
  CheckSize("scaled 192", GetScaledFrameSize(800, 450, 192), 1600.0f, 900.0f);

  CheckRect("letterbox same aspect", GetLetterboxRect(1920, 1080, 800, 450), 0.0f, 0.0f, 1920.0f,
    1080.0f);
  CheckRect("letterbox wider window", GetLetterboxRect(1920, 1080, 800, 600), 240.0f, 0.0f,
    1440.0f, 1080.0f);
  CheckRect("letterbox taller window", GetLetterboxRect(800, 800, 800, 450), 0.0f, 175.0f, 800.0f,
    450.0f);
  CheckRect("letterbox resized", GetLetterboxRect(1000, 450, 800, 450), 100.0f, 0.0f, 800.0f,
    450.0f);
  CheckRect("letterbox zero window", GetLetterboxRect(0, 1080, 800, 450), 0.0f, 0.0f, 0.0f,
    1080.0f);
  CheckRect("letterbox zero base", GetLetterboxRect(640, 480, 0, 450), 0.0f, 0.0f, 640.0f, 480.0f);

  // 320 x 180: 4x is 1280 x 720, 3x is 960 x 540
  CheckRect("integer exact multiple", GetIntegerLetterboxRect(1280, 720, 320, 180), 0.0f, 0.0f,
    1280.0f, 720.0f);
  CheckRect("integer between multiples", GetIntegerLetterboxRect(1366, 768, 320, 180), 43.0f,
    24.0f, 1280.0f, 720.0f);
  CheckRect("integer odd bars round down", GetIntegerLetterboxRect(1283, 723, 320, 180), 1.0f,
    1.0f, 1280.0f, 720.0f);
  CheckRect("integer height decides", GetIntegerLetterboxRect(1920, 800, 320, 180), 320.0f, 40.0f,
    1280.0f, 720.0f);
  // Below one base size: GetLetterboxRect(200, 90, 320, 180), never empty
  CheckRect("integer below base is fit", GetIntegerLetterboxRect(200, 90, 320, 180), 20.0f, 0.0f,
    160.0f, 90.0f);
  CheckRect("integer zero window", GetIntegerLetterboxRect(0, 1080, 320, 180), 0.0f, 0.0f, 0.0f,
    1080.0f);
  CheckRect("integer zero base", GetIntegerLetterboxRect(640, 480, 0, 180), 0.0f, 0.0f, 640.0f,
    480.0f);

  LBox := GetLetterboxRect(1920, 1080, 800, 600);
  LPoint.x := 960.0f;
  LPoint.y := 540.0f;
  CheckSize("point centre", GetFramePoint(LPoint, LBox, 800, 600), 400.0f, 300.0f);
  LPoint.x := 100.0f;
  CheckSize("point left bar clamped", GetFramePoint(LPoint, LBox, 800, 600), 0.0f, 300.0f);
  LPoint.x := 1900.0f;
  LPoint.y := 1100.0f;
  CheckSize("point past edge clamped", GetFramePoint(LPoint, LBox, 800, 600), 799.0f, 599.0f);
  LEmpty.x := 0.0f;
  LEmpty.y := 0.0f;
  LEmpty.width := 0.0f;
  LEmpty.height := 0.0f;
  CheckSize("point empty letterbox", GetFramePoint(LPoint, LEmpty, 800, 600), 0.0f, 0.0f);
end;

func TestRefused();
var
  LCamera: Camera2D;
  LWasOff: bool;
begin
  Check("refused 0 x 0", not InitFrameWindow(0, 0, "std_raylib_frame_rules"));
  Check("refused negative", not InitFrameWindow(-5, 450, "std_raylib_frame_rules"));
  Check("no window after refusal", (not IsWindowReady()) and (GetFrameWidth() = 0) and
    (GetFrameHeight() = 0));
  Check("no frame letterbox after refusal", EmptyRect(GetFrameLetterbox()));
  Check("no frame dpi 96", (GetFrameDpi() = 96) and Near(GetFrameScale(), 1.0f));
  // With no frame window BeginFrame / EndFrame / RestoreFrameClip do nothing (no raylib call
  // that needs a window), and the frame's camera and mouse stay zero
  BeginFrame();
  RestoreFrameClip();
  EndFrame();
  ToggleFrameFullscreen();
  LCamera := GetFrameCamera();
  Check("no frame calls do nothing", (not IsWindowReady()) and Near(LCamera.zoom, 0.0f) and
    Near(GetFrameMousePosition().x, 0.0f) and Near(GetFrameMousePosition().y, 0.0f));
  Check("zoom default 1", Near(GetFrameZoom(), 1.0f));
  SetFrameZoom(0.0f);
  Check("zoom 0 is 1", Near(GetFrameZoom(), 1.0f));
  SetFrameZoom(-2.0f);
  Check("zoom negative is 1", Near(GetFrameZoom(), 1.0f));
  SetFrameZoom(2.5f);
  Check("zoom kept", Near(GetFrameZoom(), 2.5f));
  SetFrameZoom(1.0f);
  Check("colours default", SameColor(GetFrameColor(), WHITE) and SameColor(GetFrameBarColor(), BLACK));
  SetFrameColor(RED);
  SetFrameBarColor(DARKGRAY);
  Check("colours set before a window", SameColor(GetFrameColor(), RED) and
    SameColor(GetFrameBarColor(), DARKGRAY));
  LWasOff := not IsFrameIntegerScale();
  SetFrameIntegerScale(true);
  Check("integer scale set before a window", LWasOff and IsFrameIntegerScale());
  SetFrameIntegerScale(false);
end;

begin
  GFails := 0;
  SetTraceLogLevel(LOG_NONE);
  TestRules();
  TestRefused();
  println("done {}", GFails);
end.
