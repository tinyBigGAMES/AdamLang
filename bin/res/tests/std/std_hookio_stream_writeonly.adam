-------------------------------------------------------------------------------
  std_hookio_stream_writeonly.adam - reads on a write-only System.HookIO
  stream from C (PaskalCPP's std_hookio TestStreamWriteOnly)

  Reads on a write-only stream ("at", "a", "ab") and fread / fwrite
  counts whose product overflows size_t, from C on a virtual file and on a
  real file: every slot equals the real file's (ucrt: fgetc refused by
  _filbuf, errno untouched; fread past a buffer EBADF from lowio; the
  overflow EINVAL, no ferror). Then a read with a written byte in the
  buffer, where a real ucrt FILE hands back whatever its buffer holds:
  refused as _filbuf refuses (EOF, ferror). Last, fscanf on the write-only
  stream, then over an ungot byte (ucrt refuses the ungetc, and its scan
  through _filbuf): every slot equals the real file's.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok write only at stale 0 io
  | ok write only at stale 0 real file
  | ok write only at stale 0 closed
  | ok write only at stale 0 as real file
  | ok write only at stale 0 unregister
  | ok write only at stale 0 io close
  | ok write only at stale 1 io
  | ok write only at stale 1 real file
  | ok write only at stale 1 closed
  | ok write only at stale 1 as real file
  | ok write only at stale 1 refused
  | ok write only at stale 1 unregister
  | ok write only at stale 1 io close
  | ok write only scan at io
  | ok write only scan at real file
  | ok write only scan at closed
  | ok write only scan at as real file
  | ok write only scan at unregister
  | ok write only scan at io close
  | ok write only a stale 0 io
  | ok write only a stale 0 real file
  | ok write only a stale 0 closed
  | ok write only a stale 0 as real file
  | ok write only a stale 0 unregister
  | ok write only a stale 0 io close
  | ok write only a stale 1 io
  | ok write only a stale 1 real file
  | ok write only a stale 1 closed
  | ok write only a stale 1 as real file
  | ok write only a stale 1 refused
  | ok write only a stale 1 unregister
  | ok write only a stale 1 io close
  | ok write only scan a io
  | ok write only scan a real file
  | ok write only scan a closed
  | ok write only scan a as real file
  | ok write only scan a unregister
  | ok write only scan a io close
  | ok write only ab stale 0 io
  | ok write only ab stale 0 real file
  | ok write only ab stale 0 closed
  | ok write only ab stale 0 as real file
  | ok write only ab stale 0 unregister
  | ok write only ab stale 0 io close
  | ok write only ab stale 1 io
  | ok write only ab stale 1 real file
  | ok write only ab stale 1 closed
  | ok write only ab stale 1 as real file
  | ok write only ab stale 1 refused
  | ok write only ab stale 1 unregister
  | ok write only ab stale 1 io close
  | ok write only scan ab io
  | ok write only scan ab real file
  | ok write only scan ab closed
  | ok write only scan ab as real file
  | ok write only scan ab unregister
  | ok write only scan ab io close
  | ok write only real removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_writeonly;

@ifdef TARGET_X86_64_WINDOWS_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_wsample(ABuffer: ptr to uint8; ACap: clong): clong;
  external "std_hookio_c";
routine clink std_hookio_c_wronly(APath: ptr to const char; AMode: ptr to const char;
  AStale: int32; AResults: ptr to int64); external "std_hookio_c";
routine clink std_hookio_c_wscan(APath: ptr to const char; AMode: ptr to const char;
  AResults: ptr to int64); external "std_hookio_c";

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// The C fixture's reads on a write-only stream, APath in AMode (AStale: then a read with a
// written byte in the buffer): its slots in AResults
routine WriteOnlyC(const APath: string; const AMode: string; const AStale: int32;
  const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_wronly(LPath, LMode, AStale, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// The C fixture's fscanf on a write-only stream, APath in AMode, then over an ungot byte: its
// 11 slots in AResults
routine WriteOnlyScanC(const APath: string; const AMode: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_wscan(LPath, LMode, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// A write-only mode by index: "at", "a" (text: a mode with neither t nor b is text in ucrt),
// "ab"
routine WriteOnlyMode(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "at";
  end;
  if AIndex = 1 then
    return "a";
  end;
  return "ab";
end;

// Reads on a write-only stream (every write-only mode) and fread / fwrite counts whose
// product overflows size_t, from C on a virtual file and on a real file: every slot equals the
// real file's. Then a read with a written byte in the buffer (the handle only: a real ucrt
// FILE hands back whatever its buffer holds there), refused as _filbuf refuses (EOF, ferror).
// Per mode, last, fscanf on the write-only stream and over an ungot byte, against the real file
routine TestStreamWriteOnly();
var
  LSample: array[0..5999] of uint8;
  LLength: clong;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..19] of int64;
  LReal: array[0..19] of int64;
  LMode: int32;
  LStale: int32;
  LName: string;
begin
  LRealPath := paramstr(0) + ".wronly.txt";
  LLength := std_hookio_c_wsample(addr of LSample[0], 6000);
  for LMode := 0 to 2 do
    for LStale := 0 to 1 do
      LName := "write only " + WriteOnlyMode(LMode) + " stale " + IntToStr(LStale);
      LMemory := CreateMemoryIO();
      Check(LName + " io", (IOWrite(LMemory, ptr(addr of LSample[0]), int64(LLength)) =
        int64(LLength)) and (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0));
      LPrefix := RegisterIO(LMemory);
      Check(LName + " real file", WriteRaw(LRealPath, addr of LSample[0], int64(LLength)));
      WriteOnlyC(LPrefix + "/o.txt", WriteOnlyMode(LMode), LStale, addr of LVirtual[0]);
      Check(LName + " closed", LVirtual[16] = 0);
      WriteOnlyC(LRealPath, WriteOnlyMode(LMode), 0, addr of LReal[0]);
      Check(LName + " as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 17));
      if LStale = 1 then
        Check(LName + " refused", (LVirtual[17] = int64(uint8('w'))) and (LVirtual[18] = -1) and
          (LVirtual[19] = 1));
      end;
      Check(LName + " unregister", UnregisterIO(LPrefix));
      Check(LName + " io close", IOClose(LMemory));
    end;
    // fscanf on the write-only stream, then over an ungot byte
    LName := "write only scan " + WriteOnlyMode(LMode);
    LMemory := CreateMemoryIO();
    Check(LName + " io", (IOWrite(LMemory, ptr(addr of LSample[0]), int64(LLength)) =
      int64(LLength)) and (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0));
    LPrefix := RegisterIO(LMemory);
    Check(LName + " real file", WriteRaw(LRealPath, addr of LSample[0], int64(LLength)));
    WriteOnlyScanC(LPrefix + "/s.txt", WriteOnlyMode(LMode), addr of LVirtual[0]);
    WriteOnlyScanC(LRealPath, WriteOnlyMode(LMode), addr of LReal[0]);
    Check(LName + " closed", LVirtual[10] = 0);
    Check(LName + " as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 11));
    Check(LName + " unregister", UnregisterIO(LPrefix));
    Check(LName + " io close", IOClose(LMemory));
  end;
  Check("write only real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestStreamWriteOnly();
  println("done {}", GFails);
end.
