-------------------------------------------------------------------------------
  std_zlib_roundtrip.adam - System.Zlib's ZlibDeflate / ZlibInflate: a
  text in each framing (Raw, Zlib, Gzip: gzip's magic 1f 8b, zlib's first
  byte 78), 300000 bytes (output grown many times past ADAM_ZLIB_CHUNK),
  the empty array and level 0 (stored, larger than its input), each back
  byte for byte. Failure paths: a stream cut short, zlib framing over gzip
  data and a raw stream of garbage (zlib's own messages), a level zlib
  refuses (its code, no message).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | raw true true true
  | zlib true true true
  | zlib first 120
  | gzip true true true
  | gzip magic 31 139
  | large true true true
  | large smaller true
  | empty true true true
  | empty back 0
  | stored true true true
  | stored larger true
  | cut false zlib: the compressed data ends early
  | cut empty true
  | header false zlib: incorrect header check
  | garbage false zlib: invalid block type
  | level false zlib: error -2
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_zlib_roundtrip;

import System.SysUtils, System.Zlib, System.Zlib.C;

// AValue as true / false
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// AText's bytes as a byte array
routine TextBytes(const AText: string): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(AText));
  for LI := 0 to len(AText) - 1 do
    LBytes[LI] := uint8(AText[LI]);
  end;
  return LBytes;
end;

// True when AFirst and ASecond hold the same bytes
routine SameBytes(const AFirst: ByteArray; const ASecond: ByteArray): bool;
var
  LI: int64;
begin
  if len(AFirst) <> len(ASecond) then
    return false;
  end;
  for LI := 0 to len(AFirst) - 1 do
    if AFirst[LI] <> ASecond[LI] then
      return false;
    end;
  end;
  return true;
end;

// AData deflated at ALevel in AFormat into APacked and inflated back: "<label> <deflate ok>
// <inflate ok> <same bytes>"
routine RoundTrip(const ALabel: string; const AData: ByteArray; const AFormat: ZlibFormat;
  const ALevel: int32; var APacked: ByteArray);
var
  LBack: ByteArray;
  LError: string;
  LPacked: bool;
  LInflated: bool;
begin
  LPacked := ZlibDeflate(AData, AFormat, ALevel, APacked, LError);
  LInflated := ZlibInflate(APacked, AFormat, LBack, LError);
  println("{}", ALabel + " " + BoolText(LPacked) + " " + BoolText(LInflated) + " " +
    BoolText(SameBytes(AData, LBack)));
end;

// AData inflated in AFormat: "<label> <ok> <error text>"
routine Refused(const ALabel: string; const AData: ByteArray; const AFormat: ZlibFormat;
  var ABack: ByteArray);
var
  LError: string;
begin
  println("{}", ALabel + " " + BoolText(ZlibInflate(AData, AFormat, ABack, LError)) + " " +
    LError);
end;

const
  BODY_TEXT: string = "adam over zlib, adam over zlib, adam over zlib, adam over zlib";

var
  GText: ByteArray;
  GLarge: ByteArray;
  GEmpty: ByteArray;
  GPacked: ByteArray;
  GCut: ByteArray;
  GBack: ByteArray;
  GError: string;
  GI: int64;

begin
  GText := TextBytes(BODY_TEXT);
  RoundTrip("raw", GText, ZlibFormat.Raw, Z_DEFAULT_COMPRESSION, GPacked);
  RoundTrip("zlib", GText, ZlibFormat.Zlib, Z_DEFAULT_COMPRESSION, GPacked);
  println("{}", "zlib first " + IntToStr(int64(GPacked[0])));
  RoundTrip("gzip", GText, ZlibFormat.Gzip, Z_BEST_COMPRESSION, GPacked);
  println("{}", "gzip magic " + IntToStr(int64(GPacked[0])) + " " + IntToStr(int64(GPacked[1])));

  setlength(GLarge, 300000);
  for GI := 0 to 299999 do
    GLarge[GI] := uint8(GI mod 251);
  end;
  RoundTrip("large", GLarge, ZlibFormat.Zlib, Z_DEFAULT_COMPRESSION, GPacked);
  println("{}", "large smaller " + BoolText(len(GPacked) < len(GLarge)));

  setlength(GEmpty, 0);
  RoundTrip("empty", GEmpty, ZlibFormat.Gzip, Z_DEFAULT_COMPRESSION, GPacked);
  ZlibInflate(GPacked, ZlibFormat.Gzip, GBack, GError);
  println("{}", "empty back " + IntToStr(len(GBack)));
  RoundTrip("stored", GText, ZlibFormat.Raw, 0, GPacked);
  println("{}", "stored larger " + BoolText(len(GPacked) > len(GText)));

  // Failure paths
  ZlibDeflate(GLarge, ZlibFormat.Zlib, Z_DEFAULT_COMPRESSION, GPacked, GError);
  setlength(GCut, len(GPacked) - 10);
  for GI := 0 to len(GCut) - 1 do
    GCut[GI] := GPacked[GI];
  end;
  Refused("cut", GCut, ZlibFormat.Zlib, GBack);
  println("{}", "cut empty " + BoolText(len(GBack) = 0));
  ZlibDeflate(GText, ZlibFormat.Gzip, Z_DEFAULT_COMPRESSION, GPacked, GError);
  Refused("header", GPacked, ZlibFormat.Zlib, GBack);
  // A raw block header 11b (BTYPE 3) is no block type
  setlength(GCut, 4);
  for GI := 0 to 3 do
    GCut[GI] := 255;
  end;
  Refused("garbage", GCut, ZlibFormat.Raw, GBack);
  println("{}", "level " + BoolText(ZlibDeflate(GText, ZlibFormat.Raw, 42, GPacked, GError)) +
    " " + GError);
end.
