-------------------------------------------------------------------------------
  std_raylib_colorhex.adam - System.Raylib.Ext's Color.Hex (PLAN-LINUX64
  LX3d3f3a, on the object layer since PLAN-RAVENAPI R10): the long and short forms with and without alpha, either case,
  the # optional; a wrong length or a character that is no hex digit gives
  the default colour. No window: raylib's types only.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | 56 189 248 255
  | 245 184 61 128
  | 255 136 0 255
  | 255 136 0 136
  | 171 205 239 255
  | 1 2 3 4
  | 9 9 9 9
  | 9 9 9 9
  | 9 9 9 9
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raylib_colorhex;

import System.SysUtils, System.Raylib.C, System.Raylib.Ext;

const
  MISSING: Color = Color(r: 9, g: 9, b: 9, a: 9);

func Show(const AHex: string);
var
  LColor: Color;
begin
  LColor := Color.Hex(AHex, MISSING);
  println("{} {} {} {}", LColor.r, LColor.g, LColor.b, LColor.a);
end;

begin
  Show("#38BDF8");
  Show("#F5B83D80");
  Show("#F80");
  Show("F808");
  Show("#abcdef");
  Show("01020304");
  Show("#12345");
  Show("#GG0000");
  Show("");
end.
