-------------------------------------------------------------------------------
  std_ccallback_err_type.adam - Break step of CCallback<T> (CB1, BNF sec 6):
  a C callback's thunk is made for a plain func type only. __adam_cthunk /
  __adam_closureof over a type that is no func type, over a variadic one and
  over a closure type is SM0767; over a func type of more parameters than a
  thunk's chain entry takes (64) SM0768.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe std_ccallback_err_type;

type
  CVariadic = func(const AFormat: ptr to const char; ...): int32;
  Closure = ref func(const AN: int32): int32;
  Wide = func(const A0: int32; const A1: int32; const A2: int32; const A3: int32; const A4: int32; const A5: int32; const A6: int32; const A7: int32; const A8: int32; const A9: int32; const A10: int32; const A11: int32; const A12: int32; const A13: int32; const A14: int32; const A15: int32; const A16: int32; const A17: int32; const A18: int32; const A19: int32; const A20: int32; const A21: int32; const A22: int32; const A23: int32; const A24: int32; const A25: int32; const A26: int32; const A27: int32; const A28: int32; const A29: int32; const A30: int32; const A31: int32; const A32: int32; const A33: int32; const A34: int32; const A35: int32; const A36: int32; const A37: int32; const A38: int32; const A39: int32; const A40: int32; const A41: int32; const A42: int32; const A43: int32; const A44: int32; const A45: int32; const A46: int32; const A47: int32; const A48: int32; const A49: int32; const A50: int32; const A51: int32; const A52: int32; const A53: int32; const A54: int32; const A55: int32; const A56: int32; const A57: int32; const A58: int32; const A59: int32; const A60: int32; const A61: int32; const A62: int32; const A63: int32; const A64: int32);

var
  LCode: ptr;
  LBad: __adam_closureof(int32); // ERROR SM0767@26

begin
  LCode := __adam_cthunk(int32); // ERROR SM0767@26
  LCode := __adam_cthunk(CVariadic); // ERROR SM0767@26
  LCode := __adam_cthunk(Closure); // ERROR SM0767@26
  LCode := __adam_cthunk(Wide); // ERROR SM0768@26
end.
