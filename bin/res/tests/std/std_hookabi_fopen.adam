-------------------------------------------------------------------------------
  std_hookabi_fopen.adam - System.HookAbi: fopen hooked by a public routine
  of its name, counting its calls and calling the real fopen it found once
  with HookReal through its own routine type (FopenFn(P), BNF sec 6). The
  hook binds the program's own call and the call inside libtomlc17.a
  (toml_parse_file_ex); the real function is not the hook and a call
  through it is not hooked, nor is a DLL's fopen loaded at run time
  (msvcrt.dll, found with HookReal's library form once it is loaded).
  Failure paths: a C name the C runtime lacks and a library not loaded
  (nil, the slot left nil).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | own open true
  | calls 1
  | toml ok true
  | calls 2
  | real found true
  | real is hook false
  | real open true
  | calls 2
  | unknown nil true
  | unknown slot nil true
  | library missing nil true
  | msvcrt loaded true
  | msvcrt fopen true
  | msvcrt is real false
  | msvcrt open true
  | calls 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookabi_fopen;

import System.SysUtils, System.HookAbi, System.Toml.C;

type
  FopenFn = routine(const APath: ptr to const char; const AMode: ptr to const char): ptr;
  FcloseFn = routine(const AStream: ptr): int32;

routine fputs(const AText: ptr to const char; const AStream: ptr): int32; external "ucrtbase";
routine fclose(const AStream: ptr): int32; external "ucrtbase";
routine LoadLibraryA(const AFileName: ptr to const char): uint64; external "kernel32";

// Every fopen below opens std_hookabi_fopen.toml, the file the program writes first
var
  // The hook's slot of the real fopen (HookReal's), and the calls the hook saw
  GRealFopen: ptr;
  GCalls: int64;
  GNone: ptr;
  GMissing: ptr;
  GMsFopen: ptr;
  GMsFclose: ptr;
  GFile: ptr;
  GResult: toml_result_t;
  GHook: FopenFn;
  GReal: FopenFn;
  GMsOpen: FopenFn;
  GMsClose: FcloseFn;

// The hook: C's fopen, counted, then the real one
public routine fopen(const APath: ptr to const char; const AMode: ptr to const char): ptr;
var
  LReal: FopenFn;
begin
  GCalls := GCalls + 1;
  LReal := FopenFn(HookReal(GRealFopen, ptr to const char("fopen")));
  return LReal(APath, AMode);
end;

// AValue as true / false
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

// ALabel and AValue on one line
routine ShowBool(const ALabel: string; const AValue: bool);
begin
  println("{}", ALabel + " " + BoolText(AValue));
end;

// The hook's count so far
routine ShowCalls();
begin
  println("calls {}", GCalls);
end;

begin
  // The program's own call
  GFile := fopen(ptr to const char("std_hookabi_fopen.toml"), ptr to const char("w"));
  ShowBool("own open", GFile <> nil);
  ShowCalls();
  fputs(ptr to const char("count = 3"), GFile);
  fclose(GFile);

  // tomlc17's call, inside libtomlc17.a
  GResult := toml_parse_file_ex(ptr to const char("std_hookabi_fopen.toml"));
  ShowBool("toml ok", GResult.ok);
  toml_free(GResult);
  ShowCalls();

  // The real fopen: found, not the hook, and a call through it is not hooked
  ShowBool("real found", GRealFopen <> nil);
  GHook := fopen;
  ShowBool("real is hook", GRealFopen = ptr(GHook));
  GReal := FopenFn(GRealFopen);
  GFile := GReal(ptr to const char("std_hookabi_fopen.toml"), ptr to const char("r"));
  ShowBool("real open", GFile <> nil);
  fclose(GFile);
  ShowCalls();

  // Nothing found: the slot stays nil
  ShowBool("unknown nil", HookReal(GNone, ptr to const char("adam_no_such_function")) = nil);
  ShowBool("unknown slot nil", GNone = nil);
  ShowBool("library missing nil", HookReal(GMissing, ptr to const char("adam_no_such.dll"),
    ptr to const char("fopen")) = nil);

  // A DLL loaded at run time: its fopen is its own, not hooked
  ShowBool("msvcrt loaded", LoadLibraryA(ptr to const char("msvcrt.dll")) <> 0);
  ShowBool("msvcrt fopen", HookReal(GMsFopen, ptr to const char("msvcrt.dll"),
    ptr to const char("fopen")) <> nil);
  ShowBool("msvcrt is real", GMsFopen = GRealFopen);
  GMsOpen := FopenFn(GMsFopen);
  GMsClose := FcloseFn(HookReal(GMsFclose, ptr to const char("msvcrt.dll"),
    ptr to const char("fclose")));
  GFile := GMsOpen(ptr to const char("std_hookabi_fopen.toml"), ptr to const char("r"));
  ShowBool("msvcrt open", GFile <> nil);
  GMsClose(GFile);
  ShowCalls();
end.
