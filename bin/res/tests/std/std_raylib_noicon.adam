-------------------------------------------------------------------------------
  std_raylib_noicon.adam - System.Raylib.Ext's program icon, the build with no
  @exeicon (PLAN-LINUX64 LX3d3c3b1, PaskalCPP's std_raylib_ext_noicon):
  raylib's window keeps the platform's default, no icon set; WM_GETICON
  gives none, big or small (std_raylib_icon checks the build with one).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu
  exitcode 0
  | ok window
  | ok no big icon
  | ok no small icon
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raylib_noicon;

@ifndef TARGET_X86_64_WINDOWS_GNU
@message error "std_raylib_noicon runs on x86_64-windows-gnu only: build it with -t x86_64-windows-gnu";
@endif

import System.Windows.SDK, System.Windows, System.Raylib.C, System.Raylib.Ext;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// Whether raylib's window has an icon of AWhich (ICON_BIG / ICON_SMALL): WM_GETICON
func HasIcon(const AWhich: uint64): bool;
begin
  return SendMessageW(uint64(GetWindowHandle()), WM_GETICON, AWhich, 0) <> 0;
end;

begin
  GFails := 0;
  SetTraceLogLevel(LOG_NONE);
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  InitWindow(64, 64, "std_raylib_noicon");
  Check("window", IsWindowReady());
  if IsWindowReady() then
    Check("no big icon", not HasIcon(ICON_BIG));
    Check("no small icon", not HasIcon(ICON_SMALL));
    CloseWindow();
  end;
  println("done {}", GFails);
end.
