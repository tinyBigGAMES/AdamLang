-------------------------------------------------------------------------------
  std_hookio_temporary.adam - System.HookIO's D files (PaskalCPP's
  std_hookio TestTemporary)

  ucrt's D beyond the mode rows: two handles on a folder-source entry
  (temp.v in the exe's folder) against two on a real file beside it
  (temp.r), opened from C (the fixture's std_hookio_c_temppair): every slot
  and what is left behind equal the real file's (the file goes at its last
  D close; a D handle and a plain one refuse each other). Then a read-only
  file (D asks DELETE access: EACCES), a source that cannot remove an
  entry (a zip: EACCES, a missing entry still ENOENT) and a registered IO
  (no file behind it: nothing removed, a plain handle and a D one coexist).
  A D handle left open at exit is std_hookio_exit_flush's.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok temp folder
  | ok temp source
  | ok temp 'rD' then 'rD'
  | ok temp 'rD' then 'rbD'
  | ok temp 'r+D' then 'rD'
  | ok temp 'wD' then 'r+D'
  | ok temp 'rD' then 'r'
  | ok temp 'rD' then 'w'
  | ok temp 'r' then 'rD'
  | ok temp 'r+' then 'wD'
  | ok temp 'r' then 'r'
  | ok temp read-only files
  | ok temp read-only as real file
  | ok temp read-only writable again
  | ok temp read-only left as real file
  | ok temp unregister
  | ok temp source close
  | ok temp zip register
  | ok temp zip refused
  | ok temp zip missing
  | ok temp zip entry kept
  | ok temp zip unregister
  | ok temp zip close
  | ok temp memory io
  | ok temp memory opened
  | ok temp memory closed
  | ok temp memory kept
  | ok temp memory still registered
  | ok temp memory unregister
  | ok temp memory close
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_temporary;

@ifdef TARGET_X86_64_WINDOWS_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

func clink std_hookio_c_dirlen(APath: ptr to const char): clong; external "std_hookio_c";
func clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
func clink std_hookio_c_samebytes(AFirst: ptr to const char; ASecond: ptr to const char):
  int32; external "std_hookio_c";
func clink std_hookio_c_mode(APath: ptr to const char; AMode: ptr to const char;
  AResults: ptr to int64); external "std_hookio_c";
func clink std_hookio_c_temppair(APath: ptr to const char; AFirst: ptr to const char;
  ASecond: ptr to const char; AResults: ptr to int64); external "std_hookio_c";
func clink std_hookio_c_readonly(APath: ptr to const char; AOn: int32): int32;
  external "std_hookio_c";

const
  // std_hookio_c_mode's result slots
  CModeSlots: int32 = 9;
  // std_hookio_c_temppair's result slots
  CPairSlots: int32 = 8;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// One check of a case: nothing when it held, else a FAIL line naming it, counted in ABad
func Part(const AName: string; const APart: string; const AOk: bool; var ABad: int32);
begin
  if not AOk then
    println("FAIL {} {}", AName, APart);
    ABad := ABad + 1;
  end;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
func SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// A failed open: nil, and errno is AError (cleared before the call by the caller, so the
// value is the call's own). A stream that opened anyway is closed (the row fails)
func Failed(const AFile: ptr; const AErrno: int32; const AError: int32): bool;
begin
  if AFile <> nil then
    fclose(AFile);
    return false;
  end;
  return AErrno = AError;
end;

// fopen of an Adam text path and mode (passed straight to C for the call)
func OpenPath(const APath: string; const AMode: string): ptr;
var
  LFile: ptr;
begin
  LFile := fopen(APath, AMode);
  return LFile;
end;

// The length of APath's folder part (the C fixture's); -1 when it has none
func DirLength(const APath: string): int64;
var
  LResult: clong;
begin
  LResult := std_hookio_c_dirlen(APath);
  return int64(LResult);
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
func WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LResult: int32;
begin
  LResult := std_hookio_c_writeraw(APath, ABytes, clong(ACount));
  return LResult = 0;
end;

// Deletes the file at APath; false when it is not deleted (it may not be there)
func RemovePath(const APath: string): bool;
var
  LOk: bool;
begin
  LOk := RemoveFile(APath);
  return LOk;
end;

// True when the two real files hold the same bytes, or neither exists (the C fixture's)
func SameBytes(const AFirst: string; const ASecond: string): bool;
var
  LResult: int32;
begin
  LResult := std_hookio_c_samebytes(AFirst, ASecond);
  return LResult = 1;
end;

// Sets (AOn 1) or clears (AOn 0) the read-only attribute of the real file APath (the C
// fixture's); false when it failed
func ReadOnly(const APath: string; const AOn: int32): bool;
var
  LResult: int32;
begin
  LResult := std_hookio_c_readonly(APath, AOn);
  return LResult = 0;
end;

// The C fixture's open of APath in AMode and what the handle then allows: its slots in
// AResults
func ModeC(const APath: string; const AMode: string; const AResults: ptr to int64);
begin
  std_hookio_c_mode(APath, AMode, AResults);
end;

// The C fixture's two handles on APath, AFirst then ASecond: their slots in AResults
func PairC(const APath: string; const AFirst: string; const ASecond: string;
  const AResults: ptr to int64);
begin
  std_hookio_c_temppair(APath, AFirst, ASecond, AResults);
end;

// Two handles on the entry APrefix/temp.v (the file AFolder/temp.v) against two on the real
// file AFolder/temp.r, both holding "abc" first: every slot and what is left behind equal the
// real file's
func CheckTempPair(const APrefix: string; const AFolder: string; const AFirst: string;
  const ASecond: string);
var
  LSample: array[0..2] of uint8;
  LVirtualFile: string;
  LRealFile: string;
  LName: string;
  LVirtual: array[0..7] of int64;
  LReal: array[0..7] of int64;
  LBad: int32;
begin
  LBad := 0;
  LSample[0] := uint8('a');
  LSample[1] := uint8('b');
  LSample[2] := uint8('c');
  LVirtualFile := AFolder + "/temp.v";
  LRealFile := AFolder + "/temp.r";
  LName := "temp '" + AFirst + "' then '" + ASecond + "'";
  Part(LName, "io file", WriteRaw(LVirtualFile, addr of LSample[0], 3), LBad);
  Part(LName, "real file", WriteRaw(LRealFile, addr of LSample[0], 3), LBad);
  PairC(APrefix + "/temp.v", AFirst, ASecond, addr of LVirtual[0]);
  PairC(LRealFile, AFirst, ASecond, addr of LReal[0]);
  Part(LName, "as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], CPairSlots),
    LBad);
  Part(LName, "left as real file", SameBytes(LVirtualFile, LRealFile), LBad);
  RemovePath(LVirtualFile);
  RemovePath(LRealFile);
  if LBad = 0 then
    println("ok {}", LName);
  end;
  GFails := GFails + LBad;
end;

// ucrt's D beyond the mode rows: the share rules between handles, a read-only file (D asks
// DELETE access), a source that cannot remove (a zip), and a registered IO (no file behind
// it: nothing removed)
func TestTemporary();
var
  LExe: string;
  LFolder: string;
  LLength: int64;
  LSource: IOSource;
  LPrefix: string;
  LSample: array[0..2] of uint8;
  LVirtualFile: string;
  LRealFile: string;
  LVirtual: array[0..8] of int64;
  LReal: array[0..8] of int64;
  LZip: IOSource;
  LZipPrefix: string;
  LMemory: IO;
  LMemoryPrefix: string;
  LFile: ptr;
  LSecond: ptr;
  LIO: IO;
  LError: int32;
  LOk: bool;
begin
  LExe := paramstr(0);
  LLength := DirLength(LExe);
  Check("temp folder", LLength > 0);
  if LLength <= 0 then
    return;
  end;
  LFolder := Substring(LExe, 0, LLength);
  LSource := CreateFolderIOSource(LFolder);
  LPrefix := RegisterIOSource(LSource);
  Check("temp source", (LSource <> nil) and (LPrefix <> ""));

  CheckTempPair(LPrefix, LFolder, "rD", "rD");
  CheckTempPair(LPrefix, LFolder, "rD", "rbD");
  CheckTempPair(LPrefix, LFolder, "r+D", "rD");
  CheckTempPair(LPrefix, LFolder, "wD", "r+D");
  CheckTempPair(LPrefix, LFolder, "rD", "r");
  CheckTempPair(LPrefix, LFolder, "rD", "w");
  CheckTempPair(LPrefix, LFolder, "r", "rD");
  CheckTempPair(LPrefix, LFolder, "r+", "wD");
  CheckTempPair(LPrefix, LFolder, "r", "r");

  // A read-only file: D asks DELETE access
  LSample[0] := uint8('a');
  LSample[1] := uint8('b');
  LSample[2] := uint8('c');
  LVirtualFile := LFolder + "/temp.v";
  LRealFile := LFolder + "/temp.r";
  LOk := WriteRaw(LVirtualFile, addr of LSample[0], 3);
  LOk := WriteRaw(LRealFile, addr of LSample[0], 3) and LOk;
  LOk := ReadOnly(LVirtualFile, 1) and LOk;
  LOk := ReadOnly(LRealFile, 1) and LOk;
  Check("temp read-only files", LOk);
  ModeC(LPrefix + "/temp.v", "rD", addr of LVirtual[0]);
  ModeC(LRealFile, "rD", addr of LReal[0]);
  Check("temp read-only as real file", SameSlots(addr of LVirtual[0], addr of LReal[0],
    CModeSlots));
  LOk := ReadOnly(LVirtualFile, 0);
  LOk := ReadOnly(LRealFile, 0) and LOk;
  Check("temp read-only writable again", LOk);
  Check("temp read-only left as real file", SameBytes(LVirtualFile, LRealFile));
  RemovePath(LVirtualFile);
  RemovePath(LRealFile);

  Check("temp unregister", UnregisterIO(LPrefix));
  Check("temp source close", IOSourceClose(LSource));

  // A source that cannot remove an entry: refused as a file ucrt cannot delete (EACCES); a
  // missing entry is still missing (ENOENT)
  LZip := CreateZipIOSource("$P:../../../../res/tests/std/fixtures/std_customio_stored.zip");
  LZipPrefix := RegisterIOSource(LZip);
  Check("temp zip register", (LZip <> nil) and (LZipPrefix <> ""));
  SetCErrno(0);
  LFile := OpenPath(LZipPrefix + "/hello.txt", "rD");
  LError := CErrno();
  Check("temp zip refused", Failed(LFile, LError, ADAM_ERRNO_EACCES));
  SetCErrno(0);
  LFile := OpenPath(LZipPrefix + "/missing.txt", "rD");
  LError := CErrno();
  Check("temp zip missing", Failed(LFile, LError, ADAM_ERRNO_ENOENT));
  LFile := OpenPath(LZipPrefix + "/hello.txt", "rb");
  LIO := FileIO(LFile);
  Check("temp zip entry kept", (LIO <> nil) and (fclose(LFile) = 0));
  Check("temp zip unregister", UnregisterIO(LZipPrefix));
  Check("temp zip close", IOSourceClose(LZip));

  // A registered IO: nothing is removed, a plain handle and a D one coexist
  LMemory := CreateMemoryIO();
  Check("temp memory io", IOWrite(LMemory, ptr(addr of LSample[0]), 3) = 3);
  LMemoryPrefix := RegisterIO(LMemory);
  LFile := OpenPath(LMemoryPrefix + "/m.txt", "rD");
  LSecond := OpenPath(LMemoryPrefix + "/m.txt", "rb");
  LIO := FileIO(LFile);
  LOk := LIO = LMemory;
  LIO := FileIO(LSecond);
  LOk := (LIO = LMemory) and LOk;
  Check("temp memory opened", LOk);
  LOk := (LFile <> nil) and (fclose(LFile) = 0);
  LOk := (LSecond <> nil) and (fclose(LSecond) = 0) and LOk;
  Check("temp memory closed", LOk);
  Check("temp memory kept", IOSize(LMemory) = 3);
  LFile := OpenPath(LMemoryPrefix + "/m.txt", "rb");
  LIO := FileIO(LFile);
  Check("temp memory still registered", (LIO = LMemory) and (fclose(LFile) = 0));
  Check("temp memory unregister", UnregisterIO(LMemoryPrefix));
  Check("temp memory close", IOClose(LMemory));
end;

begin
  GFails := 0;
  TestTemporary();
  println("done {}", GFails);
end.
