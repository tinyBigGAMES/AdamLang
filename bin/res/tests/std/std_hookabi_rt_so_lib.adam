-------------------------------------------------------------------------------
  std_hookabi_rt_so_lib.adam - the hooking shared object std_hookabi_rt_so
  loads (PLAN-LINUX64 LX4f2): built only. Its runtime's hook table is empty
  (a shared object's link makes no interposer stubs), so its install of
  getenv patches the GOT slots of every object loaded at the install, its
  host's included; its unload (dlclose) gives every slot back what it held.
*******************************************************************************/

/*
@@test
  kind dep
@@end
*/

@ifndef TARGET_X86_64_LINUX_GNU
@message error "std_hookabi_rt_so_lib is built for x86_64-linux-gnu only";
@endif

module dll std_hookabi_rt_so_lib;

import System.HookABI;

type
  // getenv's C signature
  GetenvFn = func(const AName: ptr to const char): ptr to const char;

func strcmp(const ALeft: ptr to const char; const ARight: ptr to const char): int32;
  external "c";

var
  // The install's record, the replacement as a value
  GHook: Hook;
  GReplacement: GetenvFn;

// The replacement: "so-hooked" for STD_HOOKABI_SO, else the real getenv
func HookGetenv(const AName: ptr to const char): ptr to const char;
var
  LReal: GetenvFn;
begin
  if (AName <> nil) and (strcmp(AName, "STD_HOOKABI_SO") = 0) then
    return "so-hooked";
  end;
  LReal := GetenvFn(GHook.Original);
  return LReal(AName);
end;

// True when getenv's hook is installed (left installed: the unload gives the slots back)
public func SoInstall(): bool;
begin
  GReplacement := HookGetenv;
  return HookInstall(GHook, "getenv", ptr(GReplacement));
end;

end.
