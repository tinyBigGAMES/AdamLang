-------------------------------------------------------------------------------
  std_hookio_stream_scan.adam - fscanf from C on a System.HookIO stream
  (PaskalCPP's std_hookio TestStreamScan)

  fscanf from C on a virtual text file and on a real file of the same text,
  by every scan name ucrt has (mingw's __mingw_fscanf, vfscanf, the secure
  fscanf_s): the numbers, the place and feof after each scan are what the
  real file gives. Then one scan past more whitespace than one stand-in
  window holds (the window grows), against the real file too.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok scan real file
  | ok scan mingw counts
  | ok scan mingw values
  | ok scan mingw places
  | ok scan mingw feof
  | ok scan mingw as real file
  | ok scan vfscanf counts
  | ok scan vfscanf values
  | ok scan vfscanf places
  | ok scan vfscanf feof
  | ok scan vfscanf as real file
  | ok scan fscanf_s counts
  | ok scan fscanf_s values
  | ok scan fscanf_s places
  | ok scan fscanf_s feof
  | ok scan fscanf_s as real file
  | ok scan real removed
  | ok scan unregister
  | ok scan io close
  | ok scan long real file
  | ok scan long value
  | ok scan long place
  | ok scan long as real file
  | ok scan long real removed
  | ok scan long unregister
  | ok scan long io close
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_scan;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@endif
  ;

// ABytes is the C side's unsigned char *: this row writes C text only, so it is declared as
// the text it is handed (the same pointer at the C boundary)
routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const char;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_scan(APath: ptr to const char; AVariant: int32;
  AResults: ptr to int64); external "std_hookio_c";
routine clink std_hookio_c_scanlong(APath: ptr to const char; AResults: ptr to int64);
  external "std_hookio_c";

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// The C text AText (its bytes up to the NUL) into a new real file at APath (the C runtime's
// own FILE)
routine WriteRealFile(const APath: string; const AText: ptr to char): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, AText, clong(CTextLength(AText)));
  freemem(LPath);
  return LResult = 0;
end;

// The C fixture's scans of APath by the scan name AVariant picks: its 13 slots in AResults
routine ScanC(const APath: string; const AVariant: int32; const AResults: ptr to int64);
var
  LPath: ptr to char;
begin
  LPath := StringToC(APath);
  std_hookio_c_scan(LPath, AVariant, AResults);
  freemem(LPath);
end;

// The C fixture's one "%d" past a long run of spaces in APath: its 5 slots in AResults
routine ScanLongC(const APath: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
begin
  LPath := StringToC(APath);
  std_hookio_c_scanlong(LPath, AResults);
  freemem(LPath);
end;

// One variant of std_hookio_c_scan over "12 34 56;x" on the virtual file and on the real one:
// the known values, then every slot against the real file's
routine CheckScan(const AName: string; const AVirtualPath: string; const ARealPath: string;
  const AVariant: int32);
var
  LVirtual: array[0..12] of int64;
  LReal: array[0..12] of int64;
begin
  ScanC(AVirtualPath, AVariant, addr of LVirtual[0]);
  ScanC(ARealPath, AVariant, addr of LReal[0]);
  Check(AName + " counts", (LVirtual[0] = 2) and (LVirtual[5] = 1) and (LVirtual[9] = 1));
  Check(AName + " values", (LVirtual[1] = 12) and (LVirtual[2] = 34) and (LVirtual[6] = 56) and
    (LVirtual[10] = int64(uint8('x'))));
  Check(AName + " places", (LVirtual[3] = 5) and (LVirtual[7] = 8) and
    (LVirtual[8] = int64(uint8(';'))) and (LVirtual[12] = 10));
  Check(AName + " feof", (LVirtual[4] = 0) and (LVirtual[11] = 1));
  Check(AName + " as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 13));
end;

// fscanf from C on a virtual text file and on a real file of the same text, by every scan
// name ucrt has: the numbers, and the place and feof after each scan are what the real file
// gives. Then one scan past more whitespace than one stand-in window holds (the window
// grows), against the real file too
routine TestStreamScan();
var
  LText: ptr to char;
  LLong: ptr to char;
  LMemory: IO;
  LLongMemory: IO;
  LPrefix: string;
  LLongPrefix: string;
  LRealPath: string;
  LLongRealPath: string;
  LVirtual: array[0..4] of int64;
  LReal: array[0..4] of int64;
begin
  LText := StringToC("12 34 56;x");
  LMemory := CreateMemoryIO(ptr(LText), CTextLength(LText), true);
  LPrefix := RegisterIO(LMemory);
  LRealPath := paramstr(0) + ".scan.txt";
  Check("scan real file", WriteRealFile(LRealPath, LText));
  CheckScan("scan mingw", LPrefix + "/n.txt", LRealPath, 0);
  CheckScan("scan vfscanf", LPrefix + "/n.txt", LRealPath, 1);
  CheckScan("scan fscanf_s", LPrefix + "/n.txt", LRealPath, 2);
  Check("scan real removed", RemovePath(LRealPath));
  Check("scan unregister", UnregisterIO(LPrefix));
  Check("scan io close", IOClose(LMemory));
  freemem(LText);

  // 10000 spaces, then "77!": the scan skips more than one stand-in window
  LLong := StringToC(StringOfChar(' ', 10000) + "77!");
  LLongMemory := CreateMemoryIO(ptr(LLong), CTextLength(LLong), true);
  LLongPrefix := RegisterIO(LLongMemory);
  LLongRealPath := paramstr(0) + ".scanlong.txt";
  Check("scan long real file", WriteRealFile(LLongRealPath, LLong));
  ScanLongC(LLongPrefix + "/s.txt", addr of LVirtual[0]);
  ScanLongC(LLongRealPath, addr of LReal[0]);
  Check("scan long value", (LVirtual[0] = 1) and (LVirtual[1] = 77));
  Check("scan long place", (LVirtual[2] = 10002) and (LVirtual[3] = 0) and
    (LVirtual[4] = int64(uint8('!'))));
  Check("scan long as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], 5));
  Check("scan long real removed", RemovePath(LLongRealPath));
  Check("scan long unregister", UnregisterIO(LLongPrefix));
  Check("scan long io close", IOClose(LLongMemory));
  freemem(LLong);
end;

begin
  GFails := 0;
  TestStreamScan();
  println("done {}", GFails);
end.
