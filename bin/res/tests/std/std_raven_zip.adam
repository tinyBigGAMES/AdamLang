-------------------------------------------------------------------------------
  std_raven_zip.adam - System.Raven.Ext's file loading through HookIO (PLAN-LINUX64
  LX3d3e, PaskalCPP's std_raven_zip): Raven's own calls read bin\assets.zip,
  the same lines on x86_64-windows-gnu and x86_64-linux-gnu (the linux ELF
  run through RunElf). Raven runs headless on its null backend. Through an
  io:// prefix of the zip (RegisterIOSource): the theme
  res/assets/ui/raven_theme.xml loads as "Teal" and becomes the theme, and
  the window res/assets/ui/raven_demo.xml is built with its named widgets,
  its image (../images/paskalcpp.png) and title font
  (../fonts/KenneyMiniSquareMono.ttf) read relative to it from the same zip
  with no error. With the zip as this thread's path source
  (SetIOThreadPathSource) the entries load by their own names: the window
  again and the logo as a 512 x 512 texture. The zip opened with a wrong
  password reads nothing: the theme is Raven's FILE_NOT_FOUND line.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | init true
  | prefix theme Teal use 1
  | prefix window true title Raven over raylib logo true name true
  | source window true title Raven over raylib
  | source texture 512 x 512
  | [Raven] R_ERROR_FILE_NOT_FOUND (R_SEVERITY_ERROR): theme: cannot read 'res/assets/ui/raven_theme.xml'
  | wrong password theme none true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raven_zip;

import System.SysUtils, System.CustomIO, System.HookIO, System.Raven.C, System.Raven.Ext;

const
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";
  ASSETS_PASSWORD: string = "Adam";

routine clink OnError(ACode: RError; ASeverity: RSeverity; ADetail: ptr to const char);
begin
  println("[Raven] {} ({}): {}", StringFromC(Rerror_to_string(ACode)),
    StringFromC(Rseverity_to_string(ASeverity)), StringFromC(ADetail));
end;

// The demo window's title text, or "none"
routine Title(const AWindow: Rid): string;
var
  LTitle: Rid;
begin
  LTitle := Rwidget_find(AWindow, "title");
  if LTitle = R_INVALID_ID then
    return "none";
  end;
  return StringFromC(Rlabel_get_text(LTitle));
end;

// A Raven call's path: AText as a NUL-ended C copy the caller frees
routine CPath(const AText: string): ptr to char;
begin
  return StringToC(AText);
end;

var
  LDesc: RInitDesc;
  LZip: IOSource;
  LWrong: IOSource;
  LPrefix: string;
  LPath: ptr to char;
  LTheme: ptr to const char;
  LWindow: Rid;
  LTexture: Rid;
  LWidth: int32;
  LHeight: int32;
begin
  Rerror_set_callback(OnError);
  LDesc.backend := R_BACKEND_NULL;
  LDesc.app_name := "std_raven_zip";
  LDesc.headless := R_TRUE;
  LDesc.disable_render_thread := R_TRUE;
  println("init {}", Rinit_ex(addr of LDesc) <> 0);
  LZip := CreateZipIOSource(ASSETS_ZIP, ASSETS_PASSWORD);

  // An io:// prefix: every C runtime open of "<prefix>/<entry>" reads the zip
  LPrefix := RegisterIOSource(LZip);
  LPath := CPath(LPrefix + "/res/assets/ui/raven_theme.xml");
  LTheme := Rtheme_load(LPath);
  freemem(LPath);
  println("prefix theme {} use {}", StringFromC(LTheme), Rtheme_use(LTheme));
  LPath := CPath(LPrefix + "/res/assets/ui/raven_demo.xml");
  LWindow := Rwindow_create_from_xml_file(LPath);
  freemem(LPath);
  println("prefix window {} title {} logo {} name {}", LWindow <> R_INVALID_ID, Title(LWindow),
    Rwidget_find(LWindow, "logo") <> R_INVALID_ID, Rwidget_find(LWindow, "name") <> R_INVALID_ID);
  Rwindow_destroy(LWindow);
  UnregisterIO(LPrefix);

  // The zip as this thread's path source: entries by their own names
  SetIOThreadPathSource(LZip);
  LWindow := Rwindow_create_from_xml_file("res/assets/ui/raven_demo.xml");
  println("source window {} title {}", LWindow <> R_INVALID_ID, Title(LWindow));
  Rwindow_destroy(LWindow);
  LTexture := Rtexture_create_from_file("res/assets/images/paskalcpp.png");
  LWidth := 0;
  LHeight := 0;
  Rtexture_get_size(LTexture, addr of LWidth, addr of LHeight);
  println("source texture {} x {}", LWidth, LHeight);

  // A wrong password: no entry can be read
  LWrong := CreateZipIOSource(ASSETS_ZIP, "not the password");
  SetIOThreadPathSource(LWrong);
  println("wrong password theme none {}", Rtheme_load("res/assets/ui/raven_theme.xml") = nil);
  SetIOThreadPathSource(nil);

  Rshutdown();
  IOSourceClose(LWrong);
  IOSourceClose(LZip);
end.
