-------------------------------------------------------------------------------
  std_windows_files.adam - System.Windows' whole-file routines (ReadAllBytes,
  ReadAllText, WriteAllBytes, WriteAllText)

  In a folder made in output: 1048583 bytes (more than any chunk, an odd
  count) written and read back equal byte for byte, their size the file's;
  an empty array written as an empty file and read back empty; a text with
  CRLF, LF and UTF-8 written and read back equal, as bytes the same count;
  a shorter text written over a longer one replaces it (no tail kept); a
  missing file and the folder itself read as false (empty), a file in a
  missing folder is not written. Everything made is removed at the end.
  Each row prints ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok made
  | ok big written
  | ok big read
  | ok big same
  | ok big size
  | ok empty written
  | ok empty read
  | ok text written
  | ok text read
  | ok text bytes
  | ok replaced
  | ok missing bytes
  | ok missing text
  | ok folder bytes
  | ok folder write
  | ok cleaned
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_windows_files;

import System.SysUtils, System.Windows, System.IO;

const
  // More than any one read the platform does, and no power of two
  BIG_COUNT: int64 = 1048583;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// ACount bytes, each from its index, in a pattern no chunk size divides
routine PatternBytes(const ACount: int64): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, ACount);
  for LI := 0 to ACount - 1 do
    LBytes[LI] := uint8((LI * 31 + 7) mod 251);
  end;
  return LBytes;
end;

// True when AFirst and ASecond hold the same bytes
routine SameBytes(const AFirst: ByteArray; const ASecond: ByteArray): bool;
var
  LI: int64;
begin
  if len(AFirst) <> len(ASecond) then
    return false;
  end;
  for LI := 0 to len(AFirst) - 1 do
    if AFirst[LI] <> ASecond[LI] then
      return false;
    end;
  end;
  return true;
end;

routine Run();
var
  LDir: string;
  LBig: ByteArray;
  LRead: ByteArray;
  LEmpty: ByteArray;
  LText: string;
  LBack: string;
begin
  LDir := ResolvePath("$P:std_windows_files_d");
  Check("made", ForceDirectories(LDir));
  LBig := PatternBytes(BIG_COUNT);
  Check("big written", WriteAllBytes(LDir + "/big.bin", LBig));
  Check("big read", ReadAllBytes(LDir + "/big.bin", LRead));
  Check("big same", SameBytes(LBig, LRead));
  Check("big size", FileSize(LDir + "/big.bin") = BIG_COUNT);
  setlength(LEmpty, 0);
  Check("empty written", WriteAllBytes(LDir + "/empty.bin", LEmpty) and
    (FileSize(LDir + "/empty.bin") = 0));
  Check("empty read", ReadAllBytes(LDir + "/empty.bin", LRead) and (len(LRead) = 0));
  LText := "line one\r\nzwei ü€\nend";
  Check("text written", WriteAllText(LDir + "/text.txt", LText));
  Check("text read", ReadAllText(LDir + "/text.txt", LBack) and (LBack = LText));
  Check("text bytes", ReadAllBytes(LDir + "/text.txt", LRead) and (len(LRead) = len(LText)));
  Check("replaced", WriteAllText(LDir + "/text.txt", "short") and
    ReadAllText(LDir + "/text.txt", LBack) and (LBack = "short"));
  Check("missing bytes", not ReadAllBytes(LDir + "/none.bin", LRead) and (len(LRead) = 0));
  LBack := "stale";
  Check("missing text", not ReadAllText(LDir + "/none.txt", LBack) and (LBack = ""));
  Check("folder bytes", not ReadAllBytes(LDir, LRead) and (len(LRead) = 0));
  Check("folder write", not WriteAllBytes(LDir + "/no/such.bin", LBig));
  Check("cleaned", DeleteFile(LDir + "/big.bin") and DeleteFile(LDir + "/empty.bin") and
    DeleteFile(LDir + "/text.txt") and RemoveDir(LDir));
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
