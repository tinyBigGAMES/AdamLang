-------------------------------------------------------------------------------
  std_hookio_fd_dup_real_win64.adam - a real file's descriptor (one ucrt
  opened itself) put by _dup2 on a HookIO handle's CRT descriptor on win64
  (PLAN-LINUX64 LX3d3e3a3): a FILE holding the number reads and writes the
  real file from there (its own IO left), the file pointer shared with the
  source (moved by ucrt's own calls on it) and with a _dup of the number; the
  number's text mode the source's, ucrt's own text mode of the source kept;
  _fstat64 / _get_osfhandle / _commit / _chsize_s / _filelengthi64 on the
  real file; an _fdopen FILE riding a lowio open's number following it; a
  lowio-only number given back to ucrt; a source that is not open refused
  once (EBADF, the handler) with the FILE left as it was.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu
  exitcode 0
  | ok real onto file
  | ok real place shared
  | ok real text mode
  | ok real file calls
  | ok real onto fdopen rider
  | ok real onto lowio given back
  | ok real dup2 refused
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_fd_dup_real_win64;

@ifndef TARGET_X86_64_WINDOWS_GNU
@message error "std_hookio_fd_dup_real_win64 runs on x86_64-windows-gnu only: build it with -t x86_64-windows-gnu";
@endif

import System.Windows, System.SysUtils, System.Runtime, System.CustomIO, System.HookIO,
  System.HookIO.Win64;

// ucrt's handler of a failed parameter check for this thread (it comes before the process's)
routine _set_thread_local_invalid_parameter_handler(const AHandler: routine(
  const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64)): ptr;
  external "ucrtbase";
// ucrt's remove of a real file
routine remove(const APath: ptr to const char): int32; external "ucrtbase";

const
  // ucrt's errno.h
  EBADF: int32 = 9;
  SEEK_SET: int32 = 0;
  SEEK_CUR: int32 = 1;
  SEEK_END: int32 = 2;

var
  GFails: int32;
  // The failed parameter checks so far
  GInvalid: int64;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The thread's invalid parameter handler: counts the call and returns (the call then returns
// its failure)
routine OnInvalid(const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64);
begin
  GInvalid := GInvalid + 1;
end;

// _open of an Adam text path (its C copy freed after the call)
routine OpenFd(const APath: string; const AFlags: int32): int32;
var
  LPath: ptr to char;
  LFile: int32;
begin
  LPath := StringToC(APath);
  LFile := _open(LPath, AFlags, int32(_S_IREAD | _S_IWRITE));
  freemem(LPath);
  return LFile;
end;

// fopen of an Adam text path and mode
routine OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

// ucrt's remove of a real file at an Adam text path
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := remove(LPath) = 0;
  freemem(LPath);
  return LOk;
end;

// A read / write memory IO of its own holding "XY", registered (its name in APrefix)
routine OtherMemory(var APrefix: string): IO;
var
  LText: array[0..1] of uint8;
  LMemory: IO;
begin
  LText[0] := 88u;
  LText[1] := 89u;
  LMemory := CreateMemoryIO();
  IOWrite(LMemory, addr of LText[0], 2);
  IOSeek(LMemory, 0, SeekOrigin.FromStart);
  APrefix := RegisterIO(LMemory);
  return LMemory;
end;

// A real file (a path beside the exe) ucrt opens itself (no handle's path: the hooks pass it
// to ucrt), read / write, binary unless AText, holding "abc" ("a\nb" in text mode: "a\r\nb"
// on disk), its place back at the start
routine RealFile(const APath: string; const AText: bool): int32;
var
  LText: array[0..2] of uint8;
  LFlags: int32;
  LFd: int32;
begin
  LFlags := _O_RDWR | _O_CREAT | _O_TRUNC | _O_BINARY;
  LText[0] := 97u;
  LText[1] := 98u;
  LText[2] := 99u;
  if AText then
    LFlags := _O_RDWR | _O_CREAT | _O_TRUNC | _O_TEXT;
    LText[1] := 10u;
    LText[2] := 98u;
  end;
  LFd := OpenFd(APath, LFlags);
  if LFd >= 0 then
    _write(LFd, addr of LText[0], 3u);
    _lseeki64(LFd, 0, SEEK_SET);
  end;
  return LFd;
end;

// _dup2 of a real file onto a FILE's number: the FILE reads the real file (its memory IO
// left), at the place it shares with the source; a _dup of the number shares it too; the
// FILE's fclose closes the number, the source lives on
routine TestOntoFile(const APrefix: string; const AOther: IO);
var
  LPath: string;
  LReal: int32;
  LFile: ptr;
  LDup: int32;
  LBuffer: array[0..7] of uint8;
  LOk: bool;
begin
  LPath := paramstr(0) + ".fdreal1.txt";
  LReal := RealFile(LPath, false);
  LFile := OpenPath(APrefix, "rb");
  LOk := (LReal >= 0) and (LFile <> nil) and (_dup2(LReal, _fileno(LFile)) = 0) and
    (fread(addr of LBuffer[0], 1, 8, LFile) = 3) and (LBuffer[0] = 97u) and (LBuffer[2] = 99u) and
    (_telli64(LReal) = 3) and (IOSize(AOther) = 2);
  LDup := -1;
  if LFile <> nil then
    LDup := _dup(_fileno(LFile));
  end;
  LOk := LOk and (LDup >= 0) and (_lseeki64(LDup, 1, SEEK_SET) = 1) and (_telli64(LReal) = 1) and
    (_read(LDup, addr of LBuffer[0], 8u) = 2) and (LBuffer[0] = 98u) and (_close(LDup) = 0) and
    (fclose(LFile) = 0) and (_telli64(LReal) = 3) and (_close(LReal) = 0) and RemovePath(LPath);
  Check("real onto file", LOk);
end;

// The file pointer is the OS file object's: ucrt's own lseek on the source moves the place
// the number reads from; a FILE's write lands in the real file where the source sees it
routine TestPlaceShared(const APrefix: string);
var
  LPath: string;
  LReal: int32;
  LFile: ptr;
  LZ: array[0..0] of uint8;
  LBuffer: array[0..7] of uint8;
  LOk: bool;
begin
  LZ[0] := 90u;
  LPath := paramstr(0) + ".fdreal2.txt";
  LReal := RealFile(LPath, false);
  LFile := OpenPath(APrefix, "r+b");
  LOk := (LReal >= 0) and (LFile <> nil) and (_dup2(LReal, _fileno(LFile)) = 0) and
    (_lseeki64(LReal, 1, SEEK_SET) = 1) and (_read(_fileno(LFile), addr of LBuffer[0], 1u) = 1) and
    (LBuffer[0] = 98u) and (_telli64(LReal) = 2) and (_lseeki64(LReal, 0, SEEK_END) = 3) and
    (fwrite(addr of LZ[0], 1, 1, LFile) = 1) and (fflush(LFile) = 0) and (_telli64(LReal) = 4) and
    (_lseeki64(LReal, 0, SEEK_SET) = 0) and (_read(LReal, addr of LBuffer[0], 8u) = 4) and
    (LBuffer[3] = 90u) and (fclose(LFile) = 0) and (_close(LReal) = 0) and RemovePath(LPath);
  Check("real place shared", LOk);
end;

// The number takes the source's text mode (ucrt's _dup2 copies it); ucrt's own text mode of
// the source stays (the description's duplicate is binary, the model translates)
routine TestTextMode(const APrefix: string);
var
  LPath: string;
  LReal: int32;
  LFile: ptr;
  LBuffer: array[0..7] of uint8;
  LOk: bool;
begin
  LPath := paramstr(0) + ".fdreal3.txt";
  LReal := RealFile(LPath, true);
  LFile := OpenPath(APrefix, "rb");
  LOk := (LReal >= 0) and (LFile <> nil) and (_dup2(LReal, _fileno(LFile)) = 0) and
    (_setmode(_fileno(LFile), _O_BINARY) = _O_TEXT) and (_setmode(_fileno(LFile), _O_TEXT) = _O_BINARY) and
    (_read(_fileno(LFile), addr of LBuffer[0], 8u) = 3) and (LBuffer[1] = 10u) and
    (_telli64(LReal) = 4) and (_setmode(LReal, _O_TEXT) = _O_TEXT) and
    (_lseeki64(LReal, 0, SEEK_SET) = 0) and (_read(LReal, addr of LBuffer[0], 8u) = 3) and
    (LBuffer[1] = 10u) and (fclose(LFile) = 0) and (_close(LReal) = 0) and RemovePath(LPath);
  Check("real text mode", LOk);
end;

// _fstat64 (the real file's own record), _get_osfhandle (its OS handle), _commit, _chsize_s and
// _filelengthi64 on the number run on the real file
routine TestFileCalls(const APrefix: string);
var
  LPath: string;
  LReal: int32;
  LFile: ptr;
  LStat: System.Windows._stat64;
  LOk: bool;
begin
  LPath := paramstr(0) + ".fdreal4.txt";
  LReal := RealFile(LPath, false);
  LFile := OpenPath(APrefix, "r+b");
  LOk := (LReal >= 0) and (LFile <> nil) and (_dup2(LReal, _fileno(LFile)) = 0) and
    (_fstat64(_fileno(LFile), ptr(addr of LStat)) = 0) and (LStat.st_size = 3) and
    ((LStat.st_mode & _S_IFMT) = _S_IFREG) and (LStat.st_mtime <> 0) and
    (_get_osfhandle(_fileno(LFile)) <> -1) and (_commit(_fileno(LFile)) = 0) and
    (_chsize_s(_fileno(LFile), 1) = 0) and (_filelengthi64(LReal) = 1) and
    (_filelengthi64(_fileno(LFile)) = 1) and (fclose(LFile) = 0) and (_close(LReal) = 0) and
    RemovePath(LPath);
  Check("real file calls", LOk);
end;

// An _fdopen FILE riding a lowio open's number: the number is held, so it follows the real
// file and the FILE reads it; the FILE's fclose closes the number
routine TestFdopenRider(const APrefix: string);
var
  LPath: string;
  LReal: int32;
  LNumber: int32;
  LFile: ptr;
  LBuffer: array[0..7] of uint8;
  LOk: bool;
  LBefore: int64;
begin
  LPath := paramstr(0) + ".fdreal5.txt";
  LReal := RealFile(LPath, false);
  LNumber := OpenFd(APrefix, _O_RDONLY | _O_BINARY);
  LFile := nil;
  if LNumber >= 0 then
    LFile := _fdopen(LNumber, "rb");
  end;
  LOk := (LReal >= 0) and (LFile <> nil) and (_dup2(LReal, LNumber) = 0) and
    (fread(addr of LBuffer[0], 1, 8, LFile) = 3) and (LBuffer[0] = 97u) and (fclose(LFile) = 0);
  LBefore := GInvalid;
  LOk := LOk and (_close(LNumber) = -1) and (CErrno() = EBADF) and (GInvalid = LBefore + 1) and
    (_close(LReal) = 0) and RemovePath(LPath);
  Check("real onto fdopen rider", LOk);
end;

// A lowio-only number (an open no FILE rides) is given back to ucrt: from there it is ucrt's
// own number on the real file (its reads, its OS handle, its close), the memory IO left
routine TestLowioGivenBack(const APrefix: string; const AOther: IO);
var
  LPath: string;
  LReal: int32;
  LNumber: int32;
  LBuffer: array[0..7] of uint8;
  LOk: bool;
begin
  LPath := paramstr(0) + ".fdreal6.txt";
  LReal := RealFile(LPath, false);
  LNumber := OpenFd(APrefix, _O_RDONLY | _O_BINARY);
  LOk := (LReal >= 0) and (LNumber >= 0) and (_dup2(LReal, LNumber) = 0) and
    (_read(LNumber, addr of LBuffer[0], 8u) = 3) and (LBuffer[2] = 99u) and (_telli64(LReal) = 3) and
    (_get_osfhandle(LNumber) <> -1) and (_close(LNumber) = 0) and (IOSize(AOther) = 2) and
    (_close(LReal) = 0) and RemovePath(LPath);
  Check("real onto lowio given back", LOk);
end;

// A source that is not open: ucrt's EBADF with its handler run once, the FILE left on its
// own IO (it still reads "XY"). The FILE's number is taken first: a _fileno after the close
// would reserve the freed number itself
routine TestRefused(const APrefix: string);
var
  LPath: string;
  LReal: int32;
  LFile: ptr;
  LBuffer: array[0..7] of uint8;
  LOk: bool;
  LBefore: int64;
  LTarget: int32;
begin
  LPath := paramstr(0) + ".fdreal7.txt";
  LReal := RealFile(LPath, false);
  LFile := OpenPath(APrefix, "rb");
  LTarget := -1;
  if LFile <> nil then
    LTarget := _fileno(LFile);
  end;
  LOk := (LReal >= 0) and (LTarget >= 0) and (LTarget <> LReal) and (_close(LReal) = 0);
  LBefore := GInvalid;
  LOk := LOk and (_dup2(LReal, LTarget) = -1) and (CErrno() = EBADF) and
    (GInvalid = LBefore + 1) and (fread(addr of LBuffer[0], 1, 8, LFile) = 2) and
    (LBuffer[0] = 88u) and (fclose(LFile) = 0) and RemovePath(LPath);
  Check("real dup2 refused", LOk);
end;

var
  LMemory: IO;
  LPrefix: string;
begin
  _set_thread_local_invalid_parameter_handler(OnInvalid);
  LMemory := OtherMemory(LPrefix);
  TestOntoFile(LPrefix, LMemory);
  TestPlaceShared(LPrefix);
  TestTextMode(LPrefix);
  TestFileCalls(LPrefix);
  TestFdopenRider(LPrefix);
  TestLowioGivenBack(LPrefix, LMemory);
  TestRefused(LPrefix);
  UnregisterIO(LPrefix);
  IOClose(LMemory);
  println("done {}", GFails);
end.
