-------------------------------------------------------------------------------
  std_math_log.adam - System.Math's exponential and logarithms: Exp, Ln,
  Log2 and Log10, float64 and float32. Exp and Ln undo each other; Log2 of a
  power of two and Log10 of a power of ten are exact; the edges are the C
  library's: Ln / Log2 / Log10 of 0 is -infinity, of a negative value NaN,
  Exp past ~709.78 +infinity and far below 0 exactly 0. Run on both targets
  (the C runtime's log family differs between ucrt and glibc, the answers
  must not).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | exp 1.000000 2.718282 0.367879 5.000000
  | exp edges true true
  | ln 0.000000 1.000000 2.302585 -0.693147
  | ln edges true true true
  | log2 10.000000 -1.000000 0.500000
  | log10 3.000000 -2.000000 0.301030
  | log edges true true true true
  | float32 2.718282 2.079442 3.000000 2.000000
  | float32 edges true true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_math_log;

import System.Math;

var
  LZero: float64;
  LMinusOne: float64;
  LBig: float64;
  LZero32: float32;
  LValue: float64;

begin
  // Variables, so nothing is folded at compile time: the calls themselves answer
  LZero := 0.0;
  LMinusOne := -1.0;
  LBig := 1000.0;
  LZero32 := 0.0f;
  // Exp: e^0, e^1, e^-1, and Ln's inverse
  println("exp {:.6f} {:.6f} {:.6f} {:.6f}", Exp(LZero), Exp(1.0), Exp(LMinusOne), Exp(Ln(5.0)));
  // Past the largest float64 it is +infinity; far below 0 it is exactly 0
  println("exp edges {} {}", Exp(LBig) > 1.0e308, Exp(-LBig) = 0.0);
  // Ln: of 1, of e, of 10, of a half
  println("ln {:.6f} {:.6f} {:.6f} {:.6f}", Ln(1.0), Ln(Exp(1.0)), Ln(10.0), Ln(0.5));
  // Ln of 0 is -infinity, of a negative value NaN (unequal to itself), of NaN NaN
  LValue := Ln(LMinusOne);
  println("ln edges {} {} {}", Ln(LZero) < -1.0e308, LValue <> LValue, Ln(NaN) <> Ln(NaN));
  // Log2 / Log10: exact at powers, and a root
  println("log2 {:.6f} {:.6f} {:.6f}", Log2(1024.0), Log2(0.5), Log2(Sqrt(2.0)));
  println("log10 {:.6f} {:.6f} {:.6f}", Log10(1000.0), Log10(0.01), Log10(2.0));
  LValue := Log10(LMinusOne);
  println("log edges {} {} {} {}", Log2(LZero) < -1.0e308, Log10(LZero) < -1.0e308,
    Log2(LMinusOne) <> Log2(LMinusOne), LValue <> LValue);
  // The float32 overloads, computed in float32
  println("float32 {:.6f} {:.6f} {:.6f} {:.6f}", Exp(1.0f), Ln(8.0f), Log2(8.0f), Log10(100.0f));
  println("float32 edges {} {}", Ln(LZero32) < float32(-1.0e38), Exp(LZero32) = 1.0f);
end.
