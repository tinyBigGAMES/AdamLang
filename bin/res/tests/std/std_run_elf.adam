-------------------------------------------------------------------------------
  std_run_elf.adam - System.Process' RunElf attached form and ElfCommand
  the same on both targets (PLAN-LINUX64, the linux Run): the ELF
  linux.linux_run_elf built (its dep) runs on this program's own stdout
  after the text this program wrote before it, its argument passed, its
  exit code; ElfCommand names a program with the ELF's argument last (on
  win64 WSL's launcher, on linux64 the ELF itself); a missing ELF false
  with exit code 0
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  runs x86_64-linux-gnu
  deps linux.linux_run_elf
  exitcode 0
  | before elf
  | linux_run_elf 1
  | arg attached
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | ok elf
  | ok command
  | ok missing
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_run_elf;

import System.SysUtils, System.IO, System.Process;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

func Run();
var
  LElf: string;
  LArgs: StringArray;
  LExe: string;
  LCommand: StringArray;
  LExit: uint32;
  LOk: bool;
begin
  // The dep's ELF: <OUT>/bin/x86_64-linux-gnu/debug/linux_run_elf, beside this cell's folder
  LElf := ExtractFileDir(ExtractFileDir(ExtractFileDir(paramstr(0)))) +
    "/x86_64-linux-gnu/debug/linux_run_elf";
  setlength(LArgs, 1);
  LArgs[0] := "attached";
  println("before elf");
  LExit := 0;
  LOk := RunElf(LElf, LArgs, ExtractFileDir(LElf), LExit);
  Check("elf", LOk and (LExit = 5));
  LExe := "";
  LOk := ElfCommand(LElf, LArgs, ExtractFileDir(LElf), true, LExe, LCommand);
  Check("command", LOk and (len(LExe) > 0) and (len(LCommand) > 0) and
    (LCommand[len(LCommand) - 1] = "attached"));
  LExit := 9;
  LOk := RunElf(LElf + ".missing", LArgs, "", LExit);
  Check("missing", (not LOk) and (LExit = 0));
end;

begin
  Run();
  println("done {}", GFails);
end.
