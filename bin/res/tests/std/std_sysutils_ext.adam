-------------------------------------------------------------------------------
  std_sysutils_ext.adam - System.SysUtils' ExtractFileExt (PLAN-EXT X2)

  The name part's text from its last '.', the '.' included, as Delphi's:
  none, one, several dots, a '.' in a folder name only, a trailing '.', a
  name that starts with '.', '\' and drive separators, `$P:` paths; and
  ChangeFileExt replaces exactly what ExtractFileExt reads (one scan, both
  agree). Each row prints ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok none
  | ok one
  | ok several dots
  | ok folder dot only
  | ok folder dot and name dot
  | ok trailing dot
  | ok leading dot
  | ok backslash folder dot
  | ok drive
  | ok empty
  | ok $P: none
  | ok $P: one
  | ok $P: folder dot only
  | ok change agrees
  | ok change agrees none
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_sysutils_ext;

import System.SysUtils;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

func Run();
begin
  Check("none", ExtractFileExt("hello") = "");
  Check("one", ExtractFileExt("hello.adam") = ".adam");
  Check("several dots", ExtractFileExt("archive.tar.gz") = ".gz");
  Check("folder dot only", ExtractFileExt("my.src/hello") = "");
  Check("folder dot and name dot", ExtractFileExt("my.src/hello.world.adam") = ".adam");
  Check("trailing dot", ExtractFileExt("hello.") = ".");
  Check("leading dot", ExtractFileExt("dir/.profile") = ".profile");
  Check("backslash folder dot", ExtractFileExt("c:\\my.dir\\hello") = "");
  Check("drive", ExtractFileExt("c:hello.txt") = ".txt");
  Check("empty", ExtractFileExt("") = "");
  Check("$P: none", ExtractFileExt("$P:hello") = "");
  Check("$P: one", ExtractFileExt("$P:../../res/hello.rez") = ".rez");
  Check("$P: folder dot only", ExtractFileExt("$P:../res.d/hello") = "");
  Check("change agrees", ChangeFileExt("a.b/c.d.e", "") + ExtractFileExt("a.b/c.d.e") = "a.b/c.d.e");
  Check("change agrees none", ChangeFileExt("a.b/c", "") + ExtractFileExt("a.b/c") = "a.b/c");
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
