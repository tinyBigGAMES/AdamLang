-------------------------------------------------------------------------------
  std_hookio_work_folder.adam - System.HookIO's working folder (the C
  runtime's chdir / getcwd hooked) and CustomIO's IOSourceFolderExists:
  folders of a zip source (no folder entries needed), of a folder source and
  of a source of the row's own (its Folder callback, and one with none).
  Then, with the shared assets.zip as the path source, chdir into one of its
  folders makes it the working folder: getcwd reports it (into a buffer, a
  too small one ERANGE, a nil one malloc'd), a relative fopen opens the
  sibling there (raylib's OBJ loader reads its .mtl so), ".." climbs, a
  chdir to a folder nowhere fails and keeps it, a real chdir lets the
  program's own apply again (the relative name then missing). The same
  through a registered source's io:// folder.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | zip true true false false false
  | folder true false false
  | own true false none false
  | mounted true
  | chdir 0 res/assets/models/alien
  | open true # Exported
  | small true range true
  | malloc res/assets/models/alien
  | up 0 res/assets/models open true
  | nowhere -1 res/assets/models
  | real 0 true open false
  | io 0 true open true
  | back 0 true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_work_folder;

import System.SysUtils, System.Runtime, System.IO, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

@ifdef TARGET_X86_64_WINDOWS_GNU
// ucrt's free (getcwd's malloc'd buffer)
func clink free(const APointer: ptr); external "ucrtbase";
@elseif TARGET_X86_64_LINUX_GNU
// glibc's free (getcwd's malloc'd buffer)
func clink free(const APointer: ptr); external "c";
@endif

const
  // bin\assets.zip beside adam, from output\bin\<triple>\<mode>
  ASSETS_ZIP: string = "$P:../../../../assets.zip";

// The row's own source: one folder ("res"), no entries
func OwnFolder(const AUserData: ptr; const APath: string): bool;
begin
  return APath = "res";
end;

func OwnExists(const AUserData: ptr; const APath: string): bool;
begin
  return false;
end;

// The working folder getcwd reports ("" for a failure)
func Cwd(): string;
var
  LBuffer: array[0..511] of char;
begin
  if getcwd(addr of LBuffer[0], 512) = nil then
    return "";
  end;
  return StringFromC(addr of LBuffer[0]);
end;

// The first ACount bytes of APath read through C's fopen ("" when it does not open)
func Head(const APath: string; const ACount: int64): string;
var
  LFile: ptr;
  LBuffer: array[0..63] of char;
  LRead: int64;
begin
  LFile := fopen(APath, "rb");
  if LFile = nil then
    return "";
  end;
  LRead := fread(addr of LBuffer[0], 1, ACount, LFile);
  fclose(LFile);
  return StringFromC(addr of LBuffer[0], LRead);
end;

func Run();
var
  LZip: IOSource;
  LFolder: IOSource;
  LOwn: IOSource;
  LBare: IOSource;
  LInterface: IOSourceInterface;
  LSmall: array[0..3] of char;
  LMade: ptr to char;
  LReal: string;
  LPrefix: string;
begin
  LZip := CreateZipIOSource(ASSETS_ZIP, "Adam");
  println("zip {} {} {} {} {}", IOSourceFolderExists(LZip, "res/assets/models"),
    IOSourceFolderExists(LZip, "res/assets/models/alien"),
    IOSourceFolderExists(LZip, "res/assets/nope"),
    IOSourceFolderExists(LZip, "res/assets/models/robot.glb"), IOSourceFolderExists(LZip, ""));

  LFolder := CreateFolderIOSource("$P:../../../..");
  println("folder {} {} {}", IOSourceFolderExists(LFolder, "res"),
    IOSourceFolderExists(LFolder, "no_such_folder"), IOSourceFolderExists(nil, "res"));
  IOSourceClose(LFolder);

  LInterface.Exists := OwnExists;
  LInterface.Folder := OwnFolder;
  LOwn := CreateIOSource(LInterface, nil);
  LInterface.Folder := nil;
  LBare := CreateIOSource(LInterface, nil);
  println("own {} {} none {}", IOSourceFolderExists(LOwn, "res"),
    IOSourceFolderExists(LOwn, "lib"), IOSourceFolderExists(LBare, "res"));
  IOSourceClose(LOwn);
  IOSourceClose(LBare);

  println("mounted {}", SetIOPathSource(LZip));
  println("chdir {} {}", chdir("./res/assets/models/alien"), Cwd());
  println("open {} {}", len(Head("alien.mtl", 10)) = 10, Head("alien.mtl", 10));
  println("small {} range {}", getcwd(addr of LSmall[0], 4) = nil, CErrno() = ADAM_ERRNO_ERANGE);
  LMade := getcwd(nil, 0);
  println("malloc {}", StringFromC(LMade));
  free(LMade);
  println("up {} {} open {}", chdir(".."), Cwd(), len(Head("alien/alien.mtl", 4)) = 4);
  println("nowhere {} {}", chdir("no_such_folder_anywhere"), Cwd());

  // A real folder: the program's own working folder applies again
  LReal := ExeDir();
  println("real {} {} open {}", chdir(LReal), Cwd() <> "res/assets/models",
    len(Head("alien/alien.mtl", 4)) = 4);
  SetIOPathSource(nil);

  LPrefix := RegisterIOSource(LZip);
  println("io {} {} open {}", chdir(LPrefix + "/res/assets/models"),
    Cwd() = LPrefix + "/res/assets/models", len(Head("robot.glb", 4)) = 4);
  println("back {} {}", chdir(LReal), Cwd() <> LPrefix + "/res/assets/models");
  UnregisterIO(LPrefix);
  IOSourceClose(LZip);
end;

begin
  Run();
end.
