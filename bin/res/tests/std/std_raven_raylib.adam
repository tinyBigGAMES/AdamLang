-------------------------------------------------------------------------------
  std_raven_raylib.adam - System.Raven.Raylib, a Raven user interface inside
  a raylib program (PLAN-LINUX64 LX3d3d, PaskalCPP's raven_raylib).

  With no window: InitRaven refuses, UpdateRaven says Raven is not running,
  CreateRavenTexture gives R_INVALID_ID.
  Then a hidden window: Raven starts on its host platform, a second start
  is refused; a UI window holds one button whose control colours are pure
  red; three UpdateRaven frames run; a render texture the game clears to
  black has no red until DrawRaven draws Raven's frame over it. Raven's
  clipboard is raylib's both ways (the clipboard's text is put back after).
  A raylib render texture becomes a Raven texture, is pointed at another
  one, and a texture Raven made from its own pixels is never re-pointed;
  destroying the linked Raven texture leaves raylib's texture drawing; a
  texture of id 0 is refused. CloseRaven ends Raven (UpdateRaven false),
  InitRaven starts it again and CloseRaven ends it again.

  Each row prints ok or FAIL with its name; the last is `done <failures>`.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok raven no window
  | ok raven update not running
  | ok raven texture not running
  | ok raven window opens
  | ok raven starts
  | ok raven host platform
  | ok raven second start refused
  | ok raven ui window
  | ok raven frames run
  | ok raven game alone has no red
  | ok raven draws over the game
  | ok raven clipboard to raylib
  | ok raven clipboard from raylib
  | ok raven texture linked
  | ok raven texture relinked
  | ok raven own texture not relinked
  | ok raven linked texture destroyed
  | ok raven raylib texture still draws
  | ok raven no texture refused
  | ok raven closes
  | ok raven update after close
  | ok raven starts again
  | ok raven closes again
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raven_raylib;

import System.SysUtils, System.Raylib.C, System.Raylib.Ext, System.Raven.C, System.Raven.Raylib;

const
  WIDTH: int32 = 320;
  HEIGHT: int32 = 180;
  // How far a pixel may be from a colour and still be it (blending, rounding)
  NEAR: int32 = 60;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

func IsNear(const AValue: uint8; const ATarget: uint8): bool;
begin
  return (int32(AValue) - int32(ATarget) <= NEAR) and (int32(ATarget) - int32(AValue) <= NEAR);
end;

// Whether the target's pixels hold one near AColor
func TargetHas(const ATarget: RenderTexture2D; const AColor: Color): bool;
var
  LImage: Image;
  LX: int32;
  LY: int32;
  LPixel: Color;
  LFound: bool;
begin
  LImage := LoadImageFromTexture(ATarget.texture);
  LFound := false;
  for LY := 0 to LImage.height - 1 do
    for LX := 0 to LImage.width - 1 do
      LPixel := GetImageColor(LImage, LX, LY);
      if IsNear(LPixel.r, AColor.r) and IsNear(LPixel.g, AColor.g) and IsNear(LPixel.b, AColor.b) then
        LFound := true;
      end;
    end;
  end;
  UnloadImage(LImage);
  return LFound;
end;

// One game frame into the target: cleared to black, Raven's frame over it when AWithRaven
func DrawGame(const ATarget: RenderTexture2D; const AUi: Rid; const AWithRaven: bool);
begin
  BeginTextureMode(ATarget);
  ClearBackground(BLACK);
  if AWithRaven then
    DrawRaven(AUi);
  end;
  EndTextureMode();
end;

func TestNoWindow();
var
  LNone: Texture2D;
begin
  Check("raven no window", not InitRaven("std_raven_raylib"));
  Check("raven update not running", not UpdateRaven(1));
  Check("raven texture not running", CreateRavenTexture(LNone) = R_INVALID_ID);
end;

// Raven's clipboard both ways, the clipboard's text put back after
func TestClipboard();
var
  LText: ptr to const char;
  LSaved: string;
begin
  LText := GetClipboardText();
  LSaved := "";
  if LText <> nil then
    LSaved := StringFromC(LText);
  end;
  Rclipboard_set_text("adam raven to raylib");
  Check("raven clipboard to raylib", StringFromC(GetClipboardText()) = "adam raven to raylib");
  SetClipboardText("adam raylib to raven");
  Check("raven clipboard from raylib", StringFromC(Rclipboard_get_text()) = "adam raylib to raven");
  SetClipboardText(LSaved);
end;

func TestTextures(const ATarget: RenderTexture2D);
var
  LOther: RenderTexture2D;
  LRaven: Rid;
  LOwn: Rid;
  LPixels: array[0..63] of uint8;
  LNone: Texture2D;
begin
  LRaven := CreateRavenTexture(ATarget.texture);
  Check("raven texture linked", (LRaven <> R_INVALID_ID) and (Rtexture_is_valid(LRaven) <> 0));
  LOther := LoadRenderTexture(64, 64);
  Check("raven texture relinked", SetRavenTexture(LRaven, LOther.texture));
  LOwn := Rtexture_create_from_pixels(addr of LPixels[0], 4, 4);
  Check("raven own texture not relinked", (LOwn <> R_INVALID_ID) and
    (not SetRavenTexture(LOwn, LOther.texture)));
  Rtexture_destroy(LOwn);
  Rtexture_destroy(LRaven);
  Check("raven linked texture destroyed", Rtexture_is_valid(LRaven) = 0);
  // raylib's texture is still raylib's: it draws green into the target
  BeginTextureMode(LOther);
  ClearBackground(GREEN);
  EndTextureMode();
  BeginTextureMode(ATarget);
  ClearBackground(BLACK);
  DrawTexture(LOther.texture, 0, 0, WHITE);
  EndTextureMode();
  Check("raven raylib texture still draws", TargetHas(ATarget, GREEN));
  Check("raven no texture refused", CreateRavenTexture(LNone) = R_INVALID_ID);
  UnloadRenderTexture(LOther);
end;

func TestWindow();
var
  LUi: Rid;
  LButton: Rid;
  LTarget: RenderTexture2D;
  LFrame: int32;
  LFramesRun: bool;
begin
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  InitWindow(WIDTH, HEIGHT, "std_raven_raylib");
  Check("raven window opens", IsWindowReady());
  if not IsWindowReady() then
    return;
  end;
  Check("raven starts", InitRaven("std_raven_raylib"));
  Check("raven host platform", Rhost_platform_is_active() = R_TRUE);
  Check("raven second start refused", not InitRaven("std_raven_raylib again"));

  LUi := Rwindow_create("std_raven_raylib", WIDTH, HEIGHT, Ruint(R_WINDOW_DEFAULT));
  LButton := Rbutton_create("Raven");
  // Pure red whatever state or style the button is drawn in
  Rwidget_set_color(LButton, R_COLOR_CONTROL, 1.0f, 0.0f, 0.0f, 1.0f);
  Rwidget_set_color(LButton, R_COLOR_CONTROL_HOVERED, 1.0f, 0.0f, 0.0f, 1.0f);
  Rwidget_set_color(LButton, R_COLOR_CONTROL_PRESSED, 1.0f, 0.0f, 0.0f, 1.0f);
  Rwidget_set_color(LButton, R_COLOR_ACCENT, 1.0f, 0.0f, 0.0f, 1.0f);
  Rwidget_set_color(LButton, R_COLOR_ACCENT_HOVERED, 1.0f, 0.0f, 0.0f, 1.0f);
  Rwidget_set_color(LButton, R_COLOR_ACCENT_PRESSED, 1.0f, 0.0f, 0.0f, 1.0f);
  Rwindow_set_content(LUi, LButton);
  Check("raven ui window", (LUi <> R_INVALID_ID) and (LButton <> R_INVALID_ID));
  LFramesRun := true;
  for LFrame := 1 to 3 do
    if not UpdateRaven(LUi) then
      LFramesRun := false;
    end;
  end;
  Check("raven frames run", LFramesRun);

  LTarget := LoadRenderTexture(WIDTH, HEIGHT);
  DrawGame(LTarget, LUi, false);
  Check("raven game alone has no red", not TargetHas(LTarget, RED));
  DrawGame(LTarget, LUi, true);
  Check("raven draws over the game", TargetHas(LTarget, Color(r: 255, g: 0, b: 0, a: 255)));

  TestClipboard();
  TestTextures(LTarget);

  CloseRaven();
  Check("raven closes", Ris_initialized() = 0);
  Check("raven update after close", not UpdateRaven(LUi));
  LFramesRun := InitRaven("std_raven_raylib");
  if LFramesRun then
    LUi := Rwindow_create("std_raven_raylib", WIDTH, HEIGHT, Ruint(R_WINDOW_DEFAULT));
    LFramesRun := UpdateRaven(LUi);
  end;
  Check("raven starts again", LFramesRun);
  CloseRaven();
  Check("raven closes again", Ris_initialized() = 0);
  UnloadRenderTexture(LTarget);
  CloseWindow();
end;

begin
  SetTraceLogLevel(LOG_NONE);
  TestNoWindow();
  TestWindow();
  println("done {}", GFails);
end.
