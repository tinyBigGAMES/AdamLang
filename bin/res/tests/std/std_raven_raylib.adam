-------------------------------------------------------------------------------
  std_raven_raylib.adam - System.Raven.Raylib's RaylibHost, a Raven user
  interface inside a raylib program (PLAN-LINUX64 LX3d3d; PLAN-RAVENAPI V10).

  With no window: a host does not start, its Update says Raven is not
  running, its Texture is empty.
  Then a hidden frame window: the host starts Raven on its host platform, a
  second host is refused; a UI window holds one button whose control colours
  are pure red; three Update frames run; a render texture the game clears to
  black has no red until the host's Draw draws Raven's frame over it.
  Raven's clipboard is raylib's both ways (the clipboard's text is put back
  after). A raylib render texture becomes a Raven texture, is retargeted at
  another one, and a texture Raven made from its own pixels is never
  retargeted; letting go of the linked Raven texture destroys it and leaves
  raylib's texture drawing; an empty texture is refused. raylib's colours
  turn into Raven's and back. Close ends Raven (Update false), a new host
  starts it again, and its last copy going ends it again.

  Each row prints ok or FAIL with its name; the last is `done <failures>`.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok raven no window
  | ok raven update not running
  | ok raven texture not running
  | ok raven window opens
  | ok raven starts
  | ok raven host platform
  | ok raven second start refused
  | ok raven ui window
  | ok raven frames run
  | ok raven game alone has no red
  | ok raven draws over the game
  | ok raven clipboard to raylib
  | ok raven clipboard from raylib
  | ok raven texture linked
  | ok raven texture retargeted
  | ok raven own texture not retargeted
  | ok raven linked texture destroyed
  | ok raven raylib texture still draws
  | ok raven no texture refused
  | ok raven colour to raven
  | ok raven colour to raylib
  | ok raven closes
  | ok raven update after close
  | ok raven starts again
  | ok raven ends with its last copy
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raven_raylib;

import System.SysUtils, System.Raylib.C, System.Raylib.Ext, System.Raven.C, System.Raven.Ext,
  System.Raven.Raylib;

const
  WIDTH: int32 = 320;
  HEIGHT: int32 = 180;
  // How far a pixel may be from a colour and still be it (blending, rounding)
  NEAR: int32 = 60;

var
  GFails: int32;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

func IsNear(const AValue: uint8; const ATarget: uint8): bool;
begin
  return (int32(AValue) - int32(ATarget) <= NEAR) and (int32(ATarget) - int32(AValue) <= NEAR);
end;

// Whether the target's pixels hold one near AColor
func TargetHas(const ATarget: RenderTextureRes; const AColor: Color): bool;
var
  LImage: Image;
  LX: int32;
  LY: int32;
  LPixel: Color;
  LFound: bool;
begin
  LImage := LoadImageFromTexture(ATarget.Handle().texture);
  LFound := false;
  for LY := 0 to LImage.height - 1 do
    for LX := 0 to LImage.width - 1 do
      LPixel := GetImageColor(LImage, LX, LY);
      if IsNear(LPixel.r, AColor.r) and IsNear(LPixel.g, AColor.g) and IsNear(LPixel.b, AColor.b) then
        LFound := true;
      end;
    end;
  end;
  UnloadImage(LImage);
  return LFound;
end;

// One game frame into the target: cleared to black, Raven's frame over it when AWithRaven
func DrawGame(const AHost: RaylibHost; const ATarget: RenderTextureRes; const AUI: UIWindow;
  const AWithRaven: bool);
begin
  BeginTextureMode(ATarget.Handle());
  ClearBackground(BLACK);
  if AWithRaven then
    AHost.Draw(AUI);
  end;
  EndTextureMode();
end;

func TestNoWindow();
var
  LNone: Window;
  LHost: RaylibHost;
begin
  LHost := RaylibHost(LNone, "std_raven_raylib");
  Check("raven no window", not LHost.IsValid() and (Ris_initialized() = 0));
  Check("raven update not running", not LHost.Update(UIWindow.Wrap(1)));
  Check("raven texture not running", not LHost.Texture(TextureRes()).IsValid());
end;

// Raven's clipboard both ways, the clipboard's text put back after
func TestClipboard();
var
  LText: ptr to const char;
  LSaved: string;
begin
  LText := GetClipboardText();
  LSaved := "";
  if LText <> nil then
    LSaved := StringFromC(LText);
  end;
  Rclipboard_set_text("adam raven to raylib");
  Check("raven clipboard to raylib", StringFromC(GetClipboardText()) = "adam raven to raylib");
  SetClipboardText("adam raylib to raven");
  Check("raven clipboard from raylib", StringFromC(Rclipboard_get_text()) = "adam raylib to raven");
  SetClipboardText(LSaved);
end;

func TestTextures(const AHost: RaylibHost; const ATarget: RenderTextureRes);
var
  LOther: RenderTextureRes;
  LRaven: UITextureRes;
  LRavenId: Rid;
  LOwn: UITextureRes;
  LPixels: array[0..63] of uint8;
begin
  LRaven := AHost.Texture(ATarget);
  LRavenId := LRaven.Id();
  Check("raven texture linked", LRaven.IsValid() and (Rtexture_is_valid(LRavenId) <> 0));
  LOther := RenderTextureRes(64, 64);
  Check("raven texture retargeted", AHost.Retarget(LRaven, LOther));
  LOwn := UITextureRes.Adopt(Rtexture_create_from_pixels(addr of LPixels[0], 4, 4));
  Check("raven own texture not retargeted", LOwn.IsValid() and not AHost.Retarget(LOwn, LOther));
  LOwn := UITextureRes();
  // The last copy of the linked texture goes: Raven destroys it, raylib's stays
  LRaven := UITextureRes();
  Check("raven linked texture destroyed", Rtexture_is_valid(LRavenId) = 0);
  // raylib's texture is still raylib's: it draws green into the target
  BeginTextureMode(LOther.Handle());
  ClearBackground(GREEN);
  EndTextureMode();
  BeginTextureMode(ATarget.Handle());
  ClearBackground(BLACK);
  DrawTexture(LOther.Handle().texture, 0, 0, WHITE);
  EndTextureMode();
  Check("raven raylib texture still draws", TargetHas(ATarget, GREEN));
  Check("raven no texture refused", not AHost.Texture(TextureRes()).IsValid());
end;

func TestColors();
var
  LColor: UIColor;
  LBack: Color;
begin
  LColor := Color(r: 255, g: 0, b: 51, a: 255).ToRaven();
  Check("raven colour to raven", (LColor.r = 1.0f) and (LColor.g = 0.0f) and (LColor.b = 0.2f) and
    (LColor.a = 1.0f));
  LBack := UIColor(r: 0.5f, g: 1.5f, b: -1.0f, a: 1.0f).ToRaylib();
  Check("raven colour to raylib", (LBack.r = 128) and (LBack.g = 255) and (LBack.b = 0) and
    (LBack.a = 255));
end;

func TestWindow();
var
  LWin: Window;
  LHost: RaylibHost;
  LSecond: RaylibHost;
  LUI: UIWindow;
  LButton: UIButton;
  LTarget: RenderTextureRes;
  LFrame: int32;
  LFramesRun: bool;
begin
  LWin := Window.Config().Size(WIDTH, HEIGHT).Title("std_raven_raylib").Flags([WindowFlag.Hidden])
    .Open();
  Check("raven window opens", LWin.Ready());
  if not LWin.Ready() then
    return;
  end;
  LHost := RaylibHost(LWin, "std_raven_raylib");
  Check("raven starts", LHost.IsValid() and LHost.App().IsValid());
  Check("raven host platform", UIHost.Active());
  LSecond := RaylibHost(LWin, "std_raven_raylib again");
  Check("raven second start refused", not LSecond.IsValid() and LHost.IsValid());
  LUI := UIWindow.Create("std_raven_raylib", WIDTH, HEIGHT);
  LButton := UIButton.Create("Raven");
  // Pure red whatever state or style the button is drawn in
  LButton.Color(UIColorRole.Control, UIColor.FromRGBA(255, 0, 0, 255))
    .Color(UIColorRole.ControlHovered, UIColor.FromRGBA(255, 0, 0, 255))
    .Color(UIColorRole.ControlPressed, UIColor.FromRGBA(255, 0, 0, 255))
    .Color(UIColorRole.Accent, UIColor.FromRGBA(255, 0, 0, 255))
    .Color(UIColorRole.AccentHovered, UIColor.FromRGBA(255, 0, 0, 255))
    .Color(UIColorRole.AccentPressed, UIColor.FromRGBA(255, 0, 0, 255));
  LUI.Content(LButton);
  Check("raven ui window", LUI.IsValid() and LButton.IsValid());
  LFramesRun := true;
  for LFrame := 1 to 3 do
    if not LHost.Update(LUI) then
      LFramesRun := false;
    end;
  end;
  Check("raven frames run", LFramesRun);
  LTarget := RenderTextureRes(WIDTH, HEIGHT);
  DrawGame(LHost, LTarget, LUI, false);
  Check("raven game alone has no red", not TargetHas(LTarget, RED));
  DrawGame(LHost, LTarget, LUI, true);
  Check("raven draws over the game", TargetHas(LTarget, Color(r: 255, g: 0, b: 0, a: 255)));
  TestClipboard();
  TestTextures(LHost, LTarget);
  TestColors();
  LHost.Close();
  Check("raven closes", (Ris_initialized() = 0) and not LHost.IsValid());
  Check("raven update after close", not LHost.Update(LUI));
  LHost := RaylibHost(LWin, "std_raven_raylib");
  LFramesRun := LHost.IsValid();
  if LFramesRun then
    LUI := UIWindow.Create("std_raven_raylib", WIDTH, HEIGHT);
    LFramesRun := LHost.Update(LUI);
  end;
  Check("raven starts again", LFramesRun);
  LHost := RaylibHost();
  Check("raven ends with its last copy", Ris_initialized() = 0);
end;

begin
  SetTraceLogLevel(LOG_NONE);
  TestNoWindow();
  TestWindow();
  println("done {}", GFails);
end.
