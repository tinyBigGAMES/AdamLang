-------------------------------------------------------------------------------
  std_ccallback.adam - CCallback<T> (CB1, BNF sec 6): a capturing closure as
  a plain C function pointer of the func type T. C's qsort sorts through a
  comparator closure that counts its calls in a captured local; the same
  callback called from Adam through Func(); a copy shares the thunk (still
  valid once the original is reassigned); a routine named as the closure; an
  empty CCallback (IsValid false, Func nil); a raise in the closure crosses
  the thunk and qsort's C frames to the guard that catches it; many
  callbacks made and let go (each thunk freed with its last copy, the slots
  used again). The same lines on both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | sorted 1 2 3 4 5 6 7 8 calls true
  | direct -1 1 0
  | copy true true 1
  | routine 8 7 6 5 4 3 2 1
  | empty false true
  | caught 1 bad pair
  | many 1000 true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_ccallback;

import System.SysUtils;

type
  // C's qsort comparator, a plain func type: the callback's T
  Compare = func(const AA: ptr to const int32; const AB: ptr to const int32): int32;

@ifdef TARGET_X86_64_LINUX_GNU
func qsort(const ABase: ptr; const ACount: uint64; const ASize: uint64;
  const ACompare: Compare); external "c";
@else
func qsort(const ABase: ptr; const ACount: uint64; const ASize: uint64;
  const ACompare: Compare); external "ucrtbase";
@endif

// int32 elements in falling order: a routine as the callback's closure
func Falling(const AA: ptr to const int32; const AB: ptr to const int32): int32;
begin
  return AB^ - AA^;
end;

var
  GItems: array[0..7] of int32;

// GItems as one line after ALabel
func Show(const ALabel: string);
begin
  println("{} {} {} {} {} {} {} {} {}", ALabel, GItems[0], GItems[1], GItems[2], GItems[3],
    GItems[4], GItems[5], GItems[6], GItems[7]);
end;

// GItems filled out of order
func Fill();
begin
  GItems[0] := 5;
  GItems[1] := 2;
  GItems[2] := 8;
  GItems[3] := 1;
  GItems[4] := 7;
  GItems[5] := 3;
  GItems[6] := 6;
  GItems[7] := 4;
end;

var
  LCalls: int64;
  LCompare: CCallback<Compare>;
  LCopy: CCallback<Compare>;
  LEmpty: CCallback<Compare>;
  LFunc: Compare;
  LA: int32;
  LB: int32;
  LI: int64;
  LMade: int64;

begin
  // a closure capturing LCalls, sorting through C's qsort
  LCalls := 0;
  LCompare := CCallback<Compare>(func(const AA: ptr to const int32; const AB: ptr to const int32): int32
    begin
      LCalls := LCalls + 1;
      return AA^ - AB^;
    end);
  Fill();
  qsort(addr of GItems, 8, 4, LCompare.Func());
  println("sorted {} {} {} {} {} {} {} {} calls {}", GItems[0], GItems[1], GItems[2], GItems[3],
    GItems[4], GItems[5], GItems[6], GItems[7], LCalls > 0);

  // the same thunk called from Adam, as C calls it
  LFunc := LCompare.Func();
  LA := 1;
  LB := 2;
  println("direct {} {} {}", LFunc(addr of LA, addr of LB), LFunc(addr of LB, addr of LA),
    LFunc(addr of LA, addr of LA));

  // a copy shares the thunk: the original reassigned, the copy still calls the closure
  LCopy := LCompare;
  LCompare := CCallback<Compare>();
  LCalls := 0;
  LFunc := LCopy.Func();
  LFunc(addr of LA, addr of LB);
  println("copy {} {} {}", LCopy.IsValid(), not LCompare.IsValid(), LCalls);

  // a routine named as the closure
  LCompare := CCallback<Compare>(Falling);
  Fill();
  qsort(addr of GItems, 8, 4, LCompare.Func());
  Show("routine");

  // an empty one
  println("empty {} {}", LEmpty.IsValid(), LEmpty.Func() = nil);

  // a raise in the closure: through the thunk and qsort's C frames to the guard
  LCompare := CCallback<Compare>(func(const AA: ptr to const int32; const AB: ptr to const int32): int32
    begin
      raise("bad pair");
      return 0;  // WARN SM0622
    end);
  Fill();
  guard
    qsort(addr of GItems, 8, 4, LCompare.Func());
    println("not reached");
  except
    println("caught {} {}", exccode(), excmsg());
  end;

  // many made and let go: each thunk back on the free list with its last copy
  LMade := 0;
  for LI := 1 to 1000 do
    LCopy := CCallback<Compare>(func(const AA: ptr to const int32; const AB: ptr to const int32): int32
      begin
        return int32(LI);
      end);
    LFunc := LCopy.Func();
    if LFunc(addr of LA, addr of LB) = int32(LI) then
      LMade := LMade + 1;
    end;
  end;
  println("many {} {}", LMade, LCopy.IsValid());
end.
