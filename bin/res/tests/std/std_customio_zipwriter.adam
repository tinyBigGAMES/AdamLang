-------------------------------------------------------------------------------
  std_customio_zipwriter.adam - System.CustomIO's ZipWriter and ZipTest: an
  archive written entry by entry (a text file deflated, a stored file, a
  file with Unix mode 0x1ED (octal 755) and one with 0x1A4 (octal 644), a
  ZipCrypto entry), each entry's EntryCRC / EntrySize against zlib's crc32
  of its bytes, then read back through minizip's own file layer: method,
  made-by (0 for a plain entry, 3 = Unix for a moded one), the external
  attributes' high half (S_IFREG | mode: 0x81ED / 0x81A4, 0 plain), the
  bytes. ZipTest finds it whole (its names in order; the ZipCrypto entry
  with its password, refused without it). Failure paths: AddFile before
  Open, Open while open, a missing file, Close twice, an archive in a
  missing folder; ZipTest on a missing file, on a file that is no zip, and
  on a copy with one byte of a stored entry changed (its CRC: the entry
  named). Every file in the row's own folder below its exe, removed at the
  end. Both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | add before open false no archive is open
  | open true
  | open again false
  | add a.txt true size 61 crc true
  | add b.bin true size 300 crc true
  | add run.sh true
  | add data.txt true
  | add secret.txt true
  | add missing false
  | close true
  | close again false no archive is open
  | entry a.txt method 8 madeby 0 attr 0 same true
  | entry b.bin method 0 madeby 0 attr 0 same true
  | entry bin/run.sh method 8 madeby 3 attr 81ED same true
  | entry bin/data.txt method 0 madeby 3 attr 81A4 same true
  | entry secret.txt method 8 madeby 0 attr 0 same false
  | test with password true 5
  | names a.txt b.bin bin/run.sh bin/data.txt secret.txt
  | test without password false
  | test reason names the entry true
  | missing folder open false
  | test missing false cannot open true
  | test no zip false not valid true
  | damaged written true
  | test damaged false
  | damaged reason names b.bin true
  | removed true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_customio_zipwriter;

import System.SysUtils, System.IO, System.CustomIO, System.Zlib.Ext, System.Zlib.C,
  System.Minizip.C;

const
  // 61 bytes
  A_TEXT: string = "adam over minizip, adam over minizip, adam over minizip, adam";

var
  GDir: string;
  GZip: string;
  GWriter: ZipWriter;
  GBytes: ByteArray;
  GNames: StringArray;
  GI: int64;
  GOk: bool;
  GLine: string;

// The bytes of AText
func Bytes(const AText: string): ByteArray;
var
  LBytes: ByteArray;
  LI: int64;
begin
  setlength(LBytes, len(AText));
  for LI := 0 to len(AText) - 1 do
    LBytes[LI] := uint8(AText[LI]);
  end;
  return LBytes;
end;

// One added file: its result, and its size and CRC when ASize >= 0 (zlib's crc32 of ABytes)
func ShowAdd(const ALabel: string; const AOk: bool; const ABytes: ByteArray);
begin
  println("add {} {} size {} crc {}", ALabel, AOk, GWriter.EntrySize(),
    GWriter.EntryCRC() = ZlibCRC32(0, ABytes));
end;

// The NUL-terminated text at AText as a string
func CText(const AText: ptr to const char): string;
var
  LText: string;
  LAt: int64;
begin
  LText := "";
  LAt := 0;
  while int32(AText[LAt]) <> 0 do
    LText := LText + AText[LAt];
    LAt := LAt + 1;
  end;
  return LText;
end;

// Every entry of the archive at APath listed through minizip's own file layer: name,
// method, made-by's high byte, the external attributes' high half in hex, and whether its
// bytes (read without a password) are the file's AExpect[i]
func ListArchive(const APath: string; const AExpect: StringArray);
var
  LPath: CString;
  LUnzip: unzFile;
  LInfo: unz_file_info64;
  LName: array[0..255] of char;
  LBuffer: array[0..1023] of uint8;
  LGot: int32;
  LRead: string;
  LStatus: int32;
  LIndex: int64;
  LJ: int64;
begin
  LPath := CString(APath);
  LUnzip := unzOpen64(LPath.Ptr);
  LIndex := 0;
  LStatus := unzGoToFirstFile(LUnzip);
  while LStatus = UNZ_OK do
    unzGetCurrentFileInfo64(LUnzip, addr of LInfo, addr of LName[0], 256, nil, 0, nil, 0);
    LRead := "";
    if unzOpenCurrentFile(LUnzip) = UNZ_OK then
      LGot := unzReadCurrentFile(LUnzip, ptr(addr of LBuffer[0]), 1024);
      while LGot > 0 do
        for LJ := 0 to int64(LGot) - 1 do
          LRead := LRead + char(LBuffer[LJ]);
        end;
        LGot := unzReadCurrentFile(LUnzip, ptr(addr of LBuffer[0]), 1024);
      end;
      unzCloseCurrentFile(LUnzip);
    end;
    println("entry {} method {} madeby {} attr {} same {}", CText(addr of LName[0]),
      LInfo.compression_method, uint64(LInfo.version) shr 8,
      IntToHex(uint64(LInfo.external_fa) shr 16, 1), LRead = AExpect[LIndex]);
    LIndex := LIndex + 1;
    LStatus := unzGoToNextFile(LUnzip);
  end;
  unzClose(LUnzip);
end;

// Where the bytes of AText first stand in ABytes, -1 when nowhere
func FindRun(const ABytes: ByteArray; const AText: string): int64;
var
  LI: int64;
  LJ: int64;
  LSame: bool;
begin
  for LI := 0 to len(ABytes) - len(AText) do
    LSame := true;
    for LJ := 0 to len(AText) - 1 do
      if ABytes[LI + LJ] <> uint8(AText[LJ]) then
        LSame := false;
      end;
    end;
    if LSame then
      return LI;
    end;
  end;
  return -1;
end;

// 300 bytes: 0 .. 255, then 0 .. 43
func Binary(): string;
var
  LText: string;
  LI: int64;
begin
  setlength(LText, 300);
  for LI := 0 to 299 do
    LText[LI] := char(uint8(LI & 0xFF));
  end;
  return LText;
end;

var
  GExpect: StringArray;
  GPos: int64;

begin
  GDir := ExeDir() + "/std_customio_zipwriter_files";
  RemoveDir(GDir, true);
  CreateDir(GDir);
  CreateDir(GDir + "/bin");
  WriteAllText(GDir + "/a.txt", A_TEXT);
  WriteAllText(GDir + "/b.bin", Binary());
  WriteAllText(GDir + "/bin/run.sh", "#!/bin/sh\necho adam\n");
  WriteAllText(GDir + "/bin/data.txt", "STOREDSTOREDSTORED");
  WriteAllText(GDir + "/secret.txt", "a secret, a secret");
  GZip := GDir + "/w.zip";

  GOk := GWriter.AddFile(GDir + "/a.txt", "a.txt");
  println("add before open {} {}", GOk, GWriter.ErrorText());
  println("open {}", GWriter.Open(GZip));
  println("open again {}", GWriter.Open(GZip));
  ShowAdd("a.txt", GWriter.AddFile(GDir + "/a.txt", "a.txt"), Bytes(A_TEXT));
  ShowAdd("b.bin", GWriter.AddFile(GDir + "/b.bin", "b.bin", ZipEntryMethod.Store, 0, "", nil), Bytes(Binary()));
  println("add run.sh {}", GWriter.AddFile(GDir + "/bin/run.sh", "bin/run.sh",
    ZipEntryMethod.Deflate, 0x1ED, "", nil));
  println("add data.txt {}", GWriter.AddFile(GDir + "/bin/data.txt", "bin/data.txt",
    ZipEntryMethod.Store, 0x1A4, "", nil));
  println("add secret.txt {}", GWriter.AddFile(GDir + "/secret.txt", "secret.txt",
    ZipEntryMethod.Deflate, 0, "pw", nil));
  println("add missing {}", GWriter.AddFile(GDir + "/none.txt", "none.txt"));
  println("close {}", GWriter.Close());
  GOk := GWriter.Close();
  println("close again {} {}", GOk, GWriter.ErrorText());

  setlength(GExpect, 5);
  GExpect[0] := A_TEXT;
  GExpect[1] := Binary();
  GExpect[2] := "#!/bin/sh\necho adam\n";
  GExpect[3] := "STOREDSTOREDSTORED";
  GExpect[4] := "a secret, a secret";
  ListArchive(GZip, GExpect);

  GOk := ZipTest(GZip, "pw", GNames);
  println("test with password {} {}", GOk, len(GNames));
  GLine := "names";
  for GI := 0 to len(GNames) - 1 do
    GLine := GLine + " " + GNames[GI];
  end;
  println("{}", GLine);
  println("test without password {}", ZipTest(GZip, "", GNames));
  println("test reason names the entry {}", IndexOf("secret.txt", ZipLastError(), 0) >= 0);

  println("missing folder open {}", GWriter.Open(GDir + "/none/x.zip"));
  GOk := ZipTest(GDir + "/none.zip", "", GNames);
  println("test missing {} cannot open {}", GOk,
    StartsStr("cannot open the archive", ZipLastError()));
  GOk := ZipTest(GDir + "/a.txt", "", GNames);
  println("test no zip {} not valid {}", GOk,
    IndexOf("is not a valid zip archive", ZipLastError(), 0) >= 0);

  // A copy with one byte of b.bin's stored data changed: its bytes 98 .. 106 ("bcdefghij"),
  // found in the archive, the first made 'X'
  ReadAllBytes(GZip, GBytes);
  GPos := FindRun(GBytes, "bcdefghij");
  GBytes[GPos] := uint8('X');
  println("damaged written {}", WriteAllBytes(GDir + "/damaged.zip", GBytes));
  println("test damaged {}", ZipTest(GDir + "/damaged.zip", "", GNames));
  println("damaged reason names b.bin {}", IndexOf("the entry b.bin", ZipLastError(), 0) >= 0);

  println("removed {}", RemoveDir(GDir, true));
end.
