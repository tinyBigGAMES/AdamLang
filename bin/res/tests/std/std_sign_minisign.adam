-------------------------------------------------------------------------------
  std_sign_minisign.adam - System.Sign's MinisignKey: a secret key file
  with a fixed seed loaded (id, public key text), a file signed and its
  .minisig compared line by line with minisign's format as a reference
  implementation writes it (prehashed ED over BLAKE2b-512, the global
  signature over the trusted comment), verified; the public key saved and
  loaded alone (verifies, cannot sign); failure paths: a changed file, a
  changed trusted comment, another key, no signature file, a key file that
  is no key; a generated key (random) saved, reloaded and used. Every file
  beside the row's exe, removed at the end. Both targets.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | key loaded true
  | key id 0102030405060708
  | public RWQBAgMEBQYHCAOhB7/zzhC+HXDdGOdLwJln5NYwm6UNXx3chmQSVTG4
  | signed true
  | sig line untrusted comment: signature from minisign secret key
  | sig line RUQBAgMEBQYHCHdsIfDSwMwQCPCSH390IgJpsQz3a69AQeh/RsTq88qLwymOziuIo7WjDVsM86PIMoX48i9hFMMFw2szPai/zgE=
  | sig line trusted comment: adam 0.1.0	x86_64-linux
  | sig line jIAAKQrVxKe0Z9EZbNV68pSMt8HhnUNwNVmvaBB+WREZgl+RqKMKHKlX4tfju7sctEyiRGVVZWoyKL9lFeUWAw==
  | verify true
  | public file true
  | public only verify true
  | public only sign false
  | changed file false
  | changed comment false
  | other key false
  | no signature false
  | generated true
  | generated id 16
  | generated round true
  | generated reload true
  | bad key file false
  | cleaned true
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_sign_minisign;

import System.SysUtils, System.IO, System.Sign;

const
  // seed 0, 1 .. 31, key id 1 .. 8, its public key: the packer's T1 secret key blob
  C_SECRET: string = "VDEBAgMEBQYHCAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fA6EHv/POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg=";
  C_TRUSTED: string = "adam 0.1.0\tx86_64-linux";

var
  GDir: string;
  GFile: string;
  GText: string;
  GLines: StringArray;
  GKey: MinisignKey;
  GPublic: MinisignKey;
  GOther: MinisignKey;
  GAgain: MinisignKey;
  GI: int64;

begin
  GDir := ExeDir();
  GFile := GDir + "/std_sign_minisign.dat";
  WriteAllText(GDir + "/std_sign_minisign.key", "untrusted comment: test key\n" + C_SECRET + "\n");
  GText := "";
  for GI := 1 to 50 do
    GText := GText + "adam release payload\n";
  end;
  WriteAllText(GFile, GText);

  println("key loaded {}", GKey.LoadSecretKey(GDir + "/std_sign_minisign.key"));
  println("key id {}", GKey.KeyIdText());
  println("public {}", GKey.PublicKeyText());
  println("signed {}", GKey.SignFile(GFile, C_TRUSTED, ""));
  ReadAllText(GFile + ".minisig", GText);
  GLines := SplitString(GText, "\n");
  for GI := 0 to 3 do
    println("sig line {}", GLines[GI]);
  end;
  println("verify {}", GKey.VerifyFile(GFile, ""));

  // the public half alone
  println("public file {}", GKey.SavePublicKey(GDir + "/std_sign_minisign.pub") and
    GPublic.LoadPublicKey(GDir + "/std_sign_minisign.pub"));
  println("public only verify {}", GPublic.VerifyFile(GFile, ""));
  println("public only sign {}", GPublic.SignFile(GFile, "", ""));

  // a changed file, a changed trusted comment, another key, no signature
  WriteAllText(GFile, GText + "x");
  println("changed file {}", GKey.VerifyFile(GFile, ""));
  GKey.SignFile(GFile, C_TRUSTED, "");
  ReadAllText(GFile + ".minisig", GText);
  WriteAllText(GFile + ".minisig", ReplaceStr(GText, "adam 0.1.0", "adam 0.1.1"));
  println("changed comment {}", GKey.VerifyFile(GFile, ""));
  GKey.SignFile(GFile, C_TRUSTED, "");
  GOther.Generate();
  println("other key {}", GOther.VerifyFile(GFile, GFile + ".minisig"));
  println("no signature {}", GKey.VerifyFile(GFile, GDir + "/std_sign_minisign.none"));

  // a generated key: saved, reloaded, signs what the reloaded public half verifies
  println("generated {}", GOther.HasSecret() and GOther.HasPublic());
  println("generated id {}", len(GOther.KeyIdText()));
  println("generated round {}", GOther.SaveSecretKey(GDir + "/std_sign_minisign_gen.key") and
    GAgain.LoadSecretKey(GDir + "/std_sign_minisign_gen.key") and
    (GAgain.PublicKeyText() = GOther.PublicKeyText()));
  println("generated reload {}", GAgain.SignFile(GFile, "", "") and GOther.VerifyFile(GFile, ""));
  WriteAllText(GDir + "/std_sign_minisign_bad.key", "untrusted comment: no key\nAAAA\n");
  println("bad key file {}", GAgain.LoadSecretKey(GDir + "/std_sign_minisign_bad.key"));

  println("cleaned {}", DeleteFile(GFile) and DeleteFile(GFile + ".minisig") and
    DeleteFile(GDir + "/std_sign_minisign.key") and DeleteFile(GDir + "/std_sign_minisign.pub") and
    DeleteFile(GDir + "/std_sign_minisign_gen.key") and DeleteFile(GDir + "/std_sign_minisign_bad.key"));
end.
