-------------------------------------------------------------------------------
  std_io_executable.adam - System.IO's SetFileExecutable(APath) (RT4, his
  name 2026-11-27: a linux adam wrote its exe with no execute bit): a new
  file written by WriteAllText; on x86_64-linux-gnu its execute bits are
  cleared first (a file system that keeps no unix modes, WSL's /mnt/c,
  shows them all set and cannot clear them: that start is taken as it is),
  then it has an execute bit beside each read bit after, its other bits
  kept; on x86_64-windows-gnu the call is true and changes nothing; a
  folder and a missing path are refused. Each line ok or FAIL with its
  name; everything made is removed.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok made
  | ok not executable before
  | ok set
  | ok executable after
  | ok folder refused
  | ok missing refused
  | ok cleaned
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_io_executable;

import System.SysUtils, System.IO
@ifdef TARGET_X86_64_LINUX_GNU
  , System.Linux
@endif
  ;

const
  // The row's exe lands in repo\bin\output\bin\<triple>\<mode>: `$P:` is that folder
  CFile: string = "$P:std_io_executable_file.txt";
  CDir: string = "$P:std_io_executable_dir";
  CMissing: string = "$P:std_io_executable_missing.txt";

var
  GFails: int32;

// One line: ok or FAIL with AName
func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

@ifdef TARGET_X86_64_LINUX_GNU
// APath's permission bits (no file type), 0xFFFFFFFF when it cannot be read
func ModeOf(const APath: string): uint32;
var
  LStat: System.Linux.stat;
begin
  if __xstat(_STAT_VER, ResolvePath(APath), LStat) <> 0 then
    return 0xFFFFFFFF;
  end;
  return LStat.st_mode & ~S_IFMT;
end;

// True when AMode has an execute bit beside each read bit, and no other bit than ABefore's
// and those
func ExecuteBeside(const ABefore: uint32; const AMode: uint32): bool;
var
  LWant: uint32;
begin
  LWant := ABefore;
  if (ABefore & S_IRUSR) <> 0 then
    LWant := LWant | S_IXUSR;
  end;
  if (ABefore & S_IRGRP) <> 0 then
    LWant := LWant | S_IXGRP;
  end;
  if (ABefore & S_IROTH) <> 0 then
    LWant := LWant | S_IXOTH;
  end;
  return AMode = LWant;
end;
@endif

var
  GBefore: uint32;

begin
  GBefore := 0;
  Check("made", WriteAllText(CFile, "not a program") and CreateDir(CDir));
@ifdef TARGET_X86_64_LINUX_GNU
  GBefore := ModeOf(CFile);
  if GBefore <> 0xFFFFFFFF then
    chmod(ResolvePath(CFile), GBefore & ~(S_IXUSR | S_IXGRP | S_IXOTH));
    GBefore := ModeOf(CFile);
  end;
  // No execute bit now, or a file system keeping no modes (every bit shown, none cleared)
  Check("not executable before", (GBefore <> 0xFFFFFFFF) and
    (((GBefore & (S_IXUSR | S_IXGRP | S_IXOTH)) = 0) or ExecuteBeside(GBefore, GBefore)));
@else
  Check("not executable before", true);
@endif
  Check("set", SetFileExecutable(CFile));
@ifdef TARGET_X86_64_LINUX_GNU
  Check("executable after", ExecuteBeside(GBefore, ModeOf(CFile)));
@else
  Check("executable after", FileExists(CFile));
@endif
  Check("folder refused", not SetFileExecutable(CDir));
  Check("missing refused", not SetFileExecutable(CMissing));
  Check("cleaned", DeleteFile(CFile) and RemoveDir(CDir, false));
  println("done {}", GFails);
end.
