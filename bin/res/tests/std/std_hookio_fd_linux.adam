-------------------------------------------------------------------------------
  std_hookio_fd_linux.adam - a HookIO handle's file descriptor on linux
  (PLAN-LINUX64 LX3d3e0, the model Raven v0.3.0 needs: fstat(fileno(f))
  S_ISREG before it reads a file, open + fstat + mmap + close for a font):
  fileno of a zip entry handle and the descriptor calls on it (fstat a
  regular file of the entry's size, read / lseek / pread on the stream's
  own place, close making the number and the stream's own calls EBADF,
  fclose then EOF / EBADF as glibc's); open(2) of an io:// name and of a path source's name (fstat,
  read, mmap bytes = the entry, every refusal: offset, shared writable,
  missing, O_DIRECTORY, write rights on a zip, O_EXCL), a registered memory
  IO opened read-write (write / pwrite / pread / lseek, the IO's own bytes
  and size), and a real file's and stdout's descriptors left to glibc.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-linux-gnu
  exitcode 0
  | ok fileno handle
  | ok fstat handle
  | ok fread after fstat
  | ok fd read
  | ok fd pread
  | ok fd pread past end
  | ok fd lseek
  | ok fd close ends stream calls
  | ok fclose after close
  | ok open io
  | ok open read all
  | ok mmap bytes
  | ok mmap refused
  | ok close open
  | ok open path source
  | ok open refused
  | ok open memory rw
  | ok memory bytes
  | ok real file glibc
  | ok stdout glibc
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_fd_linux;

@ifndef TARGET_X86_64_LINUX_GNU
@message error "std_hookio_fd_linux runs on x86_64-linux-gnu only: build it with -t x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO, System.HookIO.Linux64;

var
  stdout: ptr; external "c";

routine munmap(const AAddress: ptr; const ALength: uint64): int32; external "c";
routine unlink(const APath: ptr to const char): int32; external "c";

const
  // fcntl.h / unistd.h / sys/mman.h / sys/stat.h / errno.h (x86_64 glibc)
  O_RDONLY: int32 = 0;
  O_WRONLY: int32 = 1;
  O_RDWR: int32 = 2;
  O_CREAT: int32 = 0x40;
  O_EXCL: int32 = 0x80;
  O_TRUNC: int32 = 0x200;
  O_DIRECTORY: int32 = 0x10000;
  SEEK_SET: int32 = 0;
  SEEK_CUR: int32 = 1;
  SEEK_END: int32 = 2;
  SEEK_DATA: int32 = 3;
  PROT_READ: int32 = 1;
  PROT_WRITE: int32 = 2;
  MAP_SHARED: int32 = 1;
  MAP_PRIVATE: int32 = 2;
  S_IFMT: uint32 = 0xF000u;
  S_IFREG: uint32 = 0x8000u;
  ENOENT: int32 = 2;
  EBADF: int32 = 9;
  EACCES: int32 = 13;
  EEXIST: int32 = 17;
  ENOTDIR: int32 = 20;
  EINVAL: int32 = 22;
  ENODEV: int32 = 19;
  ADAM_TEST_MAP_FAILED: uint64 = 18446744073709551615u;
  ADAM_TEST_ZIP: string = "$P:../../../../res/tests/std/fixtures/std_customio_stored.zip";
  ADAM_TEST_SIZE: int64 = 12;

type
  // glibc's struct stat (x86_64, 144 bytes)
  StatBuf = record
    st_dev: uint64;
    st_ino: uint64;
    st_nlink: uint64;
    st_mode: uint32;
    st_uid: uint32;
    st_gid: uint32;
    pad0: int32;
    st_rdev: uint64;
    st_size: int64;
    st_blksize: int64;
    st_blocks: int64;
    st_atime: int64;
    st_atimensec: int64;
    st_mtime: int64;
    st_mtimensec: int64;
    st_ctime: int64;
    st_ctimensec: int64;
    reserved: array[0..2] of int64;
  end;

var
  GFails: int32;
  // The entry's own bytes (CreateZipFileIO), what every read is compared with
  GBytes: array[0..11] of uint8;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when the ACount bytes at AData are the entry's from AFrom
routine SameAs(const AData: ptr; const AFrom: int64; const ACount: int64): bool;
var
  LData: ptr to uint8;
  LI: int64;
begin
  LData := ptr to uint8(AData);
  for LI := 0 to ACount - 1 do
    if LData[LI] <> GBytes[AFrom + LI] then
      return false;
    end;
  end;
  return true;
end;

// A call's failure: -1 and errno AError (errno cleared by the caller before the call)
routine FailedWith(const AAnswer: int64; const AError: int32): bool;
begin
  return (AAnswer = -1) and (CErrno() = AError);
end;

// open(2) of an Adam text path (its C copy freed after the call)
routine OpenFd(const APath: string; const AFlags: int32): int32;
var
  LPath: ptr to char;
  LFile: int32;
begin
  LPath := StringToC(APath);
  LFile := open(LPath, AFlags, 420);
  freemem(LPath);
  return LFile;
end;

// fopen of an Adam text path and mode
routine OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

// fstat of AFile: a regular file of ASize bytes
routine RegularOf(const AFile: int32; const ASize: int64): bool;
var
  LStat: StatBuf;
begin
  if fstat(AFile, addr of LStat) <> 0 then
    return false;
  end;
  return ((LStat.st_mode & S_IFMT) = S_IFREG) and (LStat.st_size = ASize);
end;

// fileno of a zip entry handle and the descriptor calls on it
routine TestFileno(const APrefix: string);
var
  LFile: ptr;
  LFd: int32;
  LBuffer: array[0..15] of uint8;
begin
  LFile := OpenPath(APrefix + "/hello.txt", "rb");
  LFd := fileno(LFile);
  Check("fileno handle", (LFile <> nil) and (LFd >= 0) and (fileno(LFile) = LFd));
  Check("fstat handle", RegularOf(LFd, ADAM_TEST_SIZE));
  Check("fread after fstat", (fread(addr of LBuffer[0], 1, ADAM_TEST_SIZE, LFile) = ADAM_TEST_SIZE)
    and SameAs(addr of LBuffer[0], 0, ADAM_TEST_SIZE));
  // The descriptor is the stream's own: fread left its place at the end
  Check("fd read", (lseek(LFd, 0, SEEK_CUR) = ADAM_TEST_SIZE) and (lseek(LFd, 0, SEEK_SET) = 0) and
    (read(LFd, addr of LBuffer[0], 5u) = 5) and SameAs(addr of LBuffer[0], 0, 5) and
    (lseek(LFd, 0, SEEK_CUR) = 5));
  Check("fd pread", (pread(LFd, addr of LBuffer[0], 4u, 2) = 4) and SameAs(addr of LBuffer[0], 2, 4) and
    (lseek(LFd, 0, SEEK_CUR) = 5));
  SetCErrno(0);
  Check("fd pread past end", (pread(LFd, addr of LBuffer[0], 4u, 100) = 0) and (CErrno() = 0) and
    FailedWith(pread(LFd, addr of LBuffer[0], 4u, -1), EINVAL));
  SetCErrno(0);
  Check("fd lseek", (lseek(LFd, 0, SEEK_END) = ADAM_TEST_SIZE) and
    (lseek(LFd, -2, SEEK_CUR) = ADAM_TEST_SIZE - 2) and FailedWith(lseek(LFd, 0, SEEK_DATA), EINVAL));
  // close(2) of a fileno descriptor: the number unusable, the stream's next fill too (its
  // buffer is used up: glibc's read on a closed _fileno fails, the error flag set), and
  // fclose's close fails as glibc's does
  SetCErrno(0);
  Check("fd close ends stream calls", (close(LFd) = 0) and
    FailedWith(read(LFd, addr of LBuffer[0], 1u), EBADF) and FailedWith(close(LFd), EBADF) and
    (fread(addr of LBuffer[0], 1, 1, LFile) = 0) and (ferror(LFile) <> 0) and (CErrno() = EBADF));
  SetCErrno(0);
  Check("fclose after close", FailedWith(fclose(LFile), EBADF) and FailedWith(close(LFd), EBADF));
end;

// open(2) of an io:// name: fstat, read, mmap, close
routine TestOpen(const APrefix: string);
var
  LFd: int32;
  LBuffer: array[0..15] of uint8;
  LMap: ptr;
  LBad: ptr;
  LShared: ptr;
  LBadError: int32;
begin
  LFd := OpenFd(APrefix + "/hello.txt", O_RDONLY);
  Check("open io", (LFd >= 0) and RegularOf(LFd, ADAM_TEST_SIZE));
  Check("open read all", (read(LFd, addr of LBuffer[0], 16u) = ADAM_TEST_SIZE) and
    SameAs(addr of LBuffer[0], 0, ADAM_TEST_SIZE) and (read(LFd, addr of LBuffer[0], 16u) = 0));
  LMap := mmap(nil, uint64(ADAM_TEST_SIZE), PROT_READ, MAP_PRIVATE, LFd, 0);
  Check("mmap bytes", (uint64(LMap) <> ADAM_TEST_MAP_FAILED) and SameAs(LMap, 0, ADAM_TEST_SIZE) and
    (lseek(LFd, 0, SEEK_CUR) = ADAM_TEST_SIZE) and (munmap(LMap, uint64(ADAM_TEST_SIZE)) = 0));
  SetCErrno(0);
  LBad := mmap(nil, uint64(ADAM_TEST_SIZE), PROT_READ, MAP_PRIVATE, LFd, 1);
  LBadError := CErrno();
  SetCErrno(0);
  LShared := mmap(nil, uint64(ADAM_TEST_SIZE), PROT_READ | PROT_WRITE, MAP_SHARED, LFd, 0);
  Check("mmap refused", (uint64(LBad) = ADAM_TEST_MAP_FAILED) and (LBadError = EINVAL) and
    (uint64(LShared) = ADAM_TEST_MAP_FAILED) and (CErrno() = EACCES));
  SetCErrno(0);
  Check("close open", (close(LFd) = 0) and FailedWith(read(LFd, addr of LBuffer[0], 1u), EBADF));
end;

// open(2) of a path source's name, and the refusals of a virtual open
routine TestOpenSource(const AZip: IOSource; const APrefix: string);
var
  LFd: int32;
  LBuffer: array[0..15] of uint8;
  LOk: bool;
begin
  SetIOThreadPathSource(AZip);
  LFd := OpenFd("hello.txt", O_RDONLY);
  LOk := (LFd >= 0) and RegularOf(LFd, ADAM_TEST_SIZE) and (pread(LFd, addr of LBuffer[0], 12u, 0) = 12) and
    SameAs(addr of LBuffer[0], 0, ADAM_TEST_SIZE);
  Check("open path source", LOk and (close(LFd) = 0));
  SetIOThreadPathSource(nil);
  SetCErrno(0);
  LOk := FailedWith(OpenFd(APrefix + "/missing.txt", O_RDONLY), ENOENT);
  SetCErrno(0);
  LOk := LOk and FailedWith(OpenFd(APrefix + "/hello.txt", O_RDONLY | O_DIRECTORY), ENOTDIR);
  SetCErrno(0);
  LOk := LOk and FailedWith(OpenFd(APrefix + "/hello.txt", O_RDWR), EACCES);
  SetCErrno(0);
  LOk := LOk and FailedWith(OpenFd(APrefix + "/hello.txt", O_RDONLY | O_CREAT | O_EXCL), EEXIST);
  SetCErrno(0);
  LOk := LOk and FailedWith(OpenFd(APrefix + "/hello.txt", 3), EINVAL);
  Check("open refused", LOk);
end;

// A registered memory IO opened read-write: write / pwrite / pread / lseek on its own bytes
routine TestMemory();
var
  LMemory: IO;
  LPrefix: string;
  LFd: int32;
  LText: array[0..4] of uint8;
  LBack: array[0..4] of uint8;
  LShared: ptr;
  LOk: bool;
begin
  LText[0] := 104u;
  LText[1] := 101u;
  LText[2] := 108u;
  LText[3] := 108u;
  LText[4] := 111u;
  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  LFd := OpenFd(LPrefix, O_RDWR | O_TRUNC);
  LOk := (LFd >= 0) and (write(LFd, addr of LText[0], 5u) = 5) and (lseek(LFd, 0, SEEK_SET) = 0) and
    (read(LFd, addr of LBack[0], 5u) = 5) and (LBack[0] = 104u) and (LBack[4] = 111u);
  // pwrite at 0 leaves the place at the end
  LText[0] := 106u;
  LOk := LOk and (pwrite(LFd, addr of LText[0], 1u, 0) = 1) and (lseek(LFd, 0, SEEK_CUR) = 5) and
    (pread(LFd, addr of LBack[0], 2u, 0) = 2) and (LBack[0] = 106u) and (LBack[1] = 101u) and
    RegularOf(LFd, 5);
  SetCErrno(0);
  LShared := mmap(nil, 5u, PROT_READ | PROT_WRITE, MAP_SHARED, LFd, 0);
  LOk := LOk and (uint64(LShared) = ADAM_TEST_MAP_FAILED) and (CErrno() = ENODEV);
  Check("open memory rw", LOk and (close(LFd) = 0));
  // The IO holds what the descriptor wrote
  LOk := (IOSize(LMemory) = 5) and (IOSeek(LMemory, 0, SeekOrigin.FromStart) = 0) and
    (IORead(LMemory, addr of LBack[0], 5) = 5) and (LBack[0] = 106u) and (LBack[4] = 111u);
  Check("memory bytes", LOk);
  UnregisterIO(LPrefix);
  IOClose(LMemory);
end;

// A real file's descriptor and stdout's: glibc's
routine TestReal();
var
  LPath: string;
  LCPath: ptr to char;
  LFd: int32;
  LText: array[0..2] of uint8;
  LBack: array[0..2] of uint8;
  LOk: bool;
begin
  LText[0] := 97u;
  LText[1] := 98u;
  LText[2] := 99u;
  LPath := paramstr(0) + ".fdreal.txt";
  LFd := OpenFd(LPath, O_WRONLY | O_CREAT | O_TRUNC);
  LOk := (LFd >= 0) and (write(LFd, addr of LText[0], 3u) = 3) and (close(LFd) = 0);
  LFd := OpenFd(LPath, O_RDONLY);
  LOk := LOk and (LFd >= 0) and RegularOf(LFd, 3) and (read(LFd, addr of LBack[0], 3u) = 3) and
    (LBack[0] = 97u) and (LBack[2] = 99u) and (close(LFd) = 0);
  LCPath := StringToC(LPath);
  LOk := LOk and (unlink(LCPath) = 0);
  freemem(LCPath);
  Check("real file glibc", LOk);
  Check("stdout glibc", fileno(stdout) = 1);
end;

var
  LZip: IOSource;
  LDirect: IO;
  LPrefix: string;
begin
  LDirect := CreateZipFileIO(ADAM_TEST_ZIP, "hello.txt");
  if (LDirect = nil) or (IORead(LDirect, addr of GBytes[0], ADAM_TEST_SIZE) <> ADAM_TEST_SIZE) then
    println("FAIL fixture");
    GFails := GFails + 1;
  end;
  IOClose(LDirect);
  LZip := CreateZipIOSource(ADAM_TEST_ZIP);
  LPrefix := RegisterIOSource(LZip);
  TestFileno(LPrefix);
  TestOpen(LPrefix);
  TestOpenSource(LZip, LPrefix);
  TestMemory();
  TestReal();
  UnregisterIO(LPrefix);
  IOSourceClose(LZip);
  println("done {}", GFails);
end.
