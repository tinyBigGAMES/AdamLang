-------------------------------------------------------------------------------
  std_minizip_link.adam - a program over System.Minizip.C alone: it calls
  no zlib routine itself, yet its deflated entry needs zlib's deflate and
  inflate inside libminizip.a. libzlib.a comes from the unit's
  `@linklibrary "zlib"` (BNF sec 2: a unit adds a library to the one
  build), linked after libminizip.a. One entry written and read back.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | zip true 0 0 0 0
  | unz true 0 0 22
  | text adam over minizip only
  | close 0 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_minizip_link;

import System.SysUtils, System.Minizip.C;

// AValue as true / false
routine BoolText(const AValue: bool): string;
begin
  if AValue then
    return "true";
  end;
  return "false";
end;

const
  // 22 bytes; Z_DEFLATED and Z_DEFAULT_COMPRESSION written out: no zlib unit imported
  BODY_TEXT: string = "adam over minizip only";
  DEFLATED: int32 = 8;
  DEFAULT_LEVEL: int32 = -1;

var
  GZip: ptr;
  GUnzip: ptr;
  GBody: array[0..21] of uint8;
  GBuffer: array[0..63] of uint8;
  GText: string;
  GNew: int32;
  GWrite: int32;
  GClose: int32;
  GOpen: int32;
  GRead: int32;
  GI: int64;

begin
  for GI := 0 to 21 do
    GBody[GI] := uint8(BODY_TEXT[GI]);
  end;
  GZip := zipOpen64(ptr to const char("std_minizip_link.zip"), APPEND_STATUS_CREATE);
  GNew := zipOpenNewFileInZip64(GZip, ptr to const char("only.txt"), nil, nil, 0, nil, 0, nil,
    DEFLATED, DEFAULT_LEVEL, 0);
  GWrite := zipWriteInFileInZip(GZip, addr of GBody[0], 22);
  GClose := zipCloseFileInZip(GZip);
  println("{}", "zip " + BoolText(GZip <> nil) + " " + IntToStr(int64(GNew)) + " " +
    IntToStr(int64(GWrite)) + " " + IntToStr(int64(GClose)) + " " +
    IntToStr(int64(zipClose(GZip, nil))));

  GUnzip := unzOpen64(ptr to const char("std_minizip_link.zip"));
  GOpen := unzGoToFirstFile(GUnzip);
  GRead := unzOpenCurrentFile(GUnzip);
  println("{}", "unz " + BoolText(GUnzip <> nil) + " " + IntToStr(int64(GOpen)) + " " +
    IntToStr(int64(GRead)) + " " +
    IntToStr(int64(unzReadCurrentFile(GUnzip, addr of GBuffer[0], 64))));
  GText := "";
  for GI := 0 to 21 do
    GText := GText + char(GBuffer[GI]);
  end;
  println("{}", "text " + GText);
  println("{}", "close " + IntToStr(int64(unzCloseCurrentFile(GUnzip))) + " " +
    IntToStr(int64(unzClose(GUnzip))));
end.
