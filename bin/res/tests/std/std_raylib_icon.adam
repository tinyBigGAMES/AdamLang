-------------------------------------------------------------------------------
  std_raylib_icon.adam - System.Raylib's program icon (PLAN-LINUX64
  LX3d3c3b1, PaskalCPP's std_raylib_ext): `import System.Raylib;` gives a
  raylib window the icon @exeicon stamps with no call of the program's
  (CreateWindowExW's hook): WM_GETICON gives one, big and small. The
  build with no @exeicon: std_raylib_noicon.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu
  exitcode 0
  | ok window
  | ok big icon
  | ok small icon
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_raylib_icon;

@ifndef TARGET_X86_64_WINDOWS_GNU
@message error "std_raylib_icon runs on x86_64-windows-gnu only: build it with -t x86_64-windows-gnu";
@endif

@exeicon "$P:res/tests/exe/fixtures/dir_exeicon_noext/app.ico";

import System.Windows, System.Raylib.C, System.Raylib;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// Whether raylib's window has an icon of AWhich (ICON_BIG / ICON_SMALL): WM_GETICON
routine HasIcon(const AWhich: uint64): bool;
begin
  return SendMessageW(uint64(GetWindowHandle()), WM_GETICON, AWhich, 0) <> 0;
end;

begin
  GFails := 0;
  SetTraceLogLevel(LOG_NONE);
  SetConfigFlags(uint32(FLAG_WINDOW_HIDDEN));
  InitWindow(64, 64, "std_raylib_icon");
  Check("window", IsWindowReady());
  if IsWindowReady() then
    Check("big icon", HasIcon(ICON_BIG));
    Check("small icon", HasIcon(ICON_SMALL));
    CloseWindow();
  end;
  println("done {}", GFails);
end.
