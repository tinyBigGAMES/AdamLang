  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  std_minizip_zip.adam - System.Minizip.C over minizip's default file
  layer: a zip written (a.txt deflated with a date through zip_fileinfo,
  b.bin stored through zipOpenNewFileInZip4_64, a global comment), listed
  (unzGetGlobalInfo64, every entry's unz_file_info64: method, size, crc
  checked by System.Zlib's ZlibCrc32 over the bytes read back, the date
  back from DOS form) and read (unzOpenCurrentFile3's method, a place kept
  and gone back to). Failure paths: a name the zip lacks
  (END_OF_LIST_OF_FILE) and a zip that does not exist (nil).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | zip open true
  | a.txt new 0
  | a.txt write 0
  | a.txt close 0
  | b.bin new 0
  | b.bin write 0
  | b.bin close 0
  | zip close 0
  | unz open true
  | entries 2
  | comment 8
  | entry a.txt method 8 size 61 crc true
  | date 2026 10 8 12 34 56
  | entry b.bin method 0 size 300 crc true
  | date 1980 -1 0 0 0 0
  | locate b.bin 0
  | locate none -100
  | back at b.bin true
  | read b.bin 300 same true
  | open3 a.txt 0 method 8
  | read a.txt adam over minizip, adam over minizip, adam over minizip, adam
  | close entry 0
  | unz close 0
  | missing true
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_minizip_zip;

import System.SysUtils, System.Zlib, System.Zlib.C, System.Minizip.C;

// ALabel and AValue on one line
routine Show(const ALabel: string; const AValue: int64);
begin
  println("{} {}", ALabel, AValue);
end;

// The NUL-terminated text at AText as a string
routine CText(const AText: ptr to const char): string;
var
  LText: string;
  LAt: int64;
begin
  LText := "";
  LAt := 0;
  while int32(AText[LAt]) <> 0 do
    LText := LText + AText[LAt];
    LAt := LAt + 1;
  end;
  return LText;
end;

const
  // deflateInit's memory level (zutil.h DEF_MEM_LEVEL, no public header names it)
  MEM_LEVEL: int32 = 8;
  // 61 bytes
  A_TEXT: string = "adam over minizip, adam over minizip, adam over minizip, adam";

var
  GZip: ptr;
  GUnzip: ptr;
  GDate: zip_fileinfo;
  GGlobal: unz_global_info64;
  GInfo: unz_file_info64;
  GPos: unz64_file_pos;
  GName: array[0..255] of char;
  GBuffer: array[0..511] of uint8;
  GText: array[0..60] of uint8;
  GBin: array[0..299] of uint8;
  GRead: ByteArray;
  GCount: int32;
  GMethod: int32;
  GCode: int32;
  GSame: bool;
  GI: int64;

// The current entry's bytes read whole into GRead (up to GBuffer's size); its count
routine ReadEntry(): int64;
var
  LCount: int32;
  LI: int64;
begin
  LCount := unzReadCurrentFile(GUnzip, addr of GBuffer[0], 512);
  setlength(GRead, 0);
  if LCount <= 0 then
    return int64(LCount);
  end;
  setlength(GRead, LCount);
  for LI := 0 to int64(LCount) - 1 do
    GRead[LI] := GBuffer[LI];
  end;
  return int64(LCount);
end;

// The current entry listed: its name, method, size and its crc against ZlibCrc32 of its
// bytes, then its date as minizip gives it back
routine ListEntry();
begin
  unzGetCurrentFileInfo64(GUnzip, addr of GInfo, addr of GName[0], 256, nil, 0, nil, 0);
  unzOpenCurrentFile(GUnzip);
  ReadEntry();
  unzCloseCurrentFile(GUnzip);
  println("entry {} method {} size {} crc {}", CText(addr of GName[0]),
    GInfo.compression_method, GInfo.uncompressed_size, uint32(GInfo.crc) = ZlibCrc32(0, GRead));
  println("date {} {} {} {} {} {}", GInfo.tmu_date.tm_year, GInfo.tmu_date.tm_mon,
    GInfo.tmu_date.tm_mday, GInfo.tmu_date.tm_hour, GInfo.tmu_date.tm_min,
    GInfo.tmu_date.tm_sec);
end;

begin
  for GI := 0 to 60 do
    GText[GI] := uint8(A_TEXT[GI]);
  end;
  for GI := 0 to 299 do
    GBin[GI] := uint8(GI mod 256);
  end;
  // 2026-11-08 12:34:56 (tm_mon counts from 0); dosDate 0: the date is tmz_date
  GDate.tmz_date.tm_year := 2026;
  GDate.tmz_date.tm_mon := 10;
  GDate.tmz_date.tm_mday := 8;
  GDate.tmz_date.tm_hour := 12;
  GDate.tmz_date.tm_min := 34;
  GDate.tmz_date.tm_sec := 56;
  GDate.dosDate := 0;
  GDate.internal_fa := 0;
  GDate.external_fa := 0;

  GZip := zipOpen64(ptr to const char("std_minizip_zip.zip"), APPEND_STATUS_CREATE);
  println("zip open {}", GZip <> nil);
  Show("a.txt new", int64(zipOpenNewFileInZip64(GZip, ptr to const char("a.txt"), addr of GDate,
    nil, 0, nil, 0, nil, Z_DEFLATED, Z_DEFAULT_COMPRESSION, 0)));
  Show("a.txt write", int64(zipWriteInFileInZip(GZip, addr of GText[0], 61)));
  Show("a.txt close", int64(zipCloseFileInZip(GZip)));
  Show("b.bin new", int64(zipOpenNewFileInZip4_64(GZip, ptr to const char("b.bin"), nil, nil, 0,
    nil, 0, nil, 0, 0, 0, -MAX_WBITS, MEM_LEVEL,
    Z_DEFAULT_STRATEGY, nil, 0, 0, 0, 0)));
  Show("b.bin write", int64(zipWriteInFileInZip(GZip, addr of GBin[0], 300)));
  Show("b.bin close", int64(zipCloseFileInZip(GZip)));
  Show("zip close", int64(zipClose(GZip, ptr to const char("adam zip"))));

  GUnzip := unzOpen64(ptr to const char("std_minizip_zip.zip"));
  println("unz open {}", GUnzip <> nil);
  unzGetGlobalInfo64(GUnzip, addr of GGlobal);
  Show("entries", int64(GGlobal.number_entry));
  Show("comment", int64(GGlobal.size_comment));
  GCode := unzGoToFirstFile(GUnzip);
  while GCode = UNZ_OK do
    ListEntry();
    GCode := unzGoToNextFile(GUnzip);
  end;

  Show("locate b.bin", int64(unzLocateFile(GUnzip, ptr to const char("b.bin"), 1)));
  unzGetFilePos64(GUnzip, addr of GPos);
  Show("locate none", int64(unzLocateFile(GUnzip, ptr to const char("none"), 1)));
  unzGoToFirstFile(GUnzip);
  unzGoToFilePos64(GUnzip, addr of GPos);
  unzGetCurrentFileInfo64(GUnzip, addr of GInfo, addr of GName[0], 256, nil, 0, nil, 0);
  println("back at b.bin {}", CText(addr of GName[0]) = "b.bin");
  unzOpenCurrentFile(GUnzip);
  GCount := int32(ReadEntry());
  unzCloseCurrentFile(GUnzip);
  GSame := len(GRead) = 300;
  if GSame then
    for GI := 0 to 299 do
      if GRead[GI] <> GBin[GI] then
        GSame := false;
      end;
    end;
  end;
  println("read b.bin {} same {}", GCount, GSame);

  unzLocateFile(GUnzip, ptr to const char("a.txt"), 1);
  GMethod := -1;
  GCode := unzOpenCurrentFile3(GUnzip, addr of GMethod, nil, 0, nil);
  println("open3 a.txt {} method {}", GCode, GMethod);
  ReadEntry();
  for GI := 0 to len(GRead) - 1 do
    GName[GI] := char(GRead[GI]);
  end;
  GName[len(GRead)] := char(0);
  println("read a.txt {}", CText(addr of GName[0]));
  Show("close entry", int64(unzCloseCurrentFile(GUnzip)));
  Show("unz close", int64(unzClose(GUnzip)));
  println("missing {}", unzOpen64(ptr to const char("std_minizip_missing.zip")) = nil);
end.
