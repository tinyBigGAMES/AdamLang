-------------------------------------------------------------------------------
  std_hookio_stream_flush.adam - fflush(NULL) on System.HookIO handles
  (PaskalCPP's std_hookio TestStreamFlush)

  A writable stream that keeps nothing and counts what reaches it (bytes
  written, Flush calls) opened "ab": fflush(NULL) writes a handle's
  buffered byte and runs its IO's Flush, fflush of the handle runs it
  again, _lock_file / _unlock_file leave the handle working, and fclose
  writes the two bytes still buffered (3 in all, as ucrt). Then getc on a
  read handle over two bytes: both, then EOF with feof set.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok flush open
  | ok flush putc
  | ok flush all
  | ok flush all reached handle
  | ok flush one
  | ok lock file no-op
  | ok unlock file no-op
  | ok flush close
  | ok flush wrote
  | ok flush unregister
  | ok flush io close
  | ok getc open
  | ok getc first
  | ok getc second
  | ok getc at end
  | ok getc close
  | ok getc unregister
  | ok getc io close
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_flush;

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

type
  // A writable stream that keeps nothing and counts what reaches it: the bytes written and its
  // Flush calls
  CountData = record
    Position: int64;
    Written: int64;
    Flushes: int32;
  end;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// fopen of an Adam text path and mode (their C copies freed after the call)
routine OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

routine CountWrite(const AUserData: ptr; const ABuffer: ptr; const ASize: int64;
  var AState: IOState): int64;
var
  LCount: ptr to CountData;
begin
  LCount := ptr to CountData(AUserData);
  LCount->Position := LCount->Position + ASize;
  if LCount->Position > LCount->Written then
    LCount->Written := LCount->Position;
  end;
  return ASize;
end;

routine CountSeek(const AUserData: ptr; const AOffset: int64; const AOrigin: SeekOrigin): int64;
var
  LCount: ptr to CountData;
  LTarget: int64;
begin
  LCount := ptr to CountData(AUserData);
  LTarget := AOffset;
  if AOrigin = SeekOrigin.FromCurrent then
    LTarget := LCount->Position + AOffset;
  end;
  if AOrigin = SeekOrigin.FromEnd then
    LTarget := LCount->Written + AOffset;
  end;
  if (LTarget < 0) or (LTarget > LCount->Written) then
    return -1;
  end;
  LCount->Position := LTarget;
  return LTarget;
end;

routine CountTell(const AUserData: ptr): int64;
var
  LCount: ptr to CountData;
begin
  LCount := ptr to CountData(AUserData);
  return LCount->Position;
end;

routine CountSize(const AUserData: ptr): int64;
var
  LCount: ptr to CountData;
begin
  LCount := ptr to CountData(AUserData);
  return LCount->Written;
end;

routine CountFlush(const AUserData: ptr; var AState: IOState): bool;
var
  LCount: ptr to CountData;
begin
  LCount := ptr to CountData(AUserData);
  LCount->Flushes := LCount->Flushes + 1;
  return true;
end;

// fflush(NULL) reaches a HookIO handle (its IO's Flush runs), getc / putc from Adam, and
// _lock_file / _unlock_file do nothing on ours
routine TestStreamFlush();
var
  LCount: CountData;
  LCallbacks: IOInterface;
  LStream: IO;
  LPrefix: string;
  LFile: ptr;
  LData: array[0..3] of uint8;
  LMemory: IO;
  LFlushes: int32;
begin
  LCount.Position := 0;
  LCount.Written := 0;
  LCount.Flushes := 0;
  LCallbacks.Read := nil;
  LCallbacks.Write := CountWrite;
  LCallbacks.Seek := CountSeek;
  LCallbacks.Tell := CountTell;
  LCallbacks.Size := CountSize;
  LCallbacks.Flush := CountFlush;
  LCallbacks.Close := nil;
  LCallbacks.Truncate := nil;
  LStream := CreateIO(LCallbacks, ptr(addr of LCount));
  LPrefix := RegisterIO(LStream);
  LFile := OpenPath(LPrefix + "/count.bin", "ab");
  Check("flush open", (LFile <> nil) and (FileIO(LFile) = LStream));
  if (LFile = nil) or (FileIO(LFile) = nil) then
    if LFile <> nil then
      fclose(LFile);
    end;
    Check("flush handle rows", false);
  else
    Check("flush putc", putc(int32('q'), LFile) = int32('q'));
    LFlushes := LCount.Flushes;
    Check("flush all", fflush(nil) = 0);
    Check("flush all reached handle", LCount.Flushes = LFlushes + 1);
    Check("flush one", (fflush(LFile) = 0) and (LCount.Flushes = LFlushes + 2));
    _lock_file(LFile);
    Check("lock file no-op", fputc(int32('r'), LFile) = int32('r'));
    _unlock_file(LFile);
    Check("unlock file no-op", fputc(int32('s'), LFile) = int32('s'));
    Check("flush close", fclose(LFile) = 0);
  end;
  // ucrt: the byte flushed by fflush(NULL), then the two fclose wrote
  Check("flush wrote", LCount.Written = 3);
  Check("flush unregister", UnregisterIO(LPrefix));
  Check("flush io close", IOClose(LStream));

  // getc from Adam on a read handle
  LData[0] := 7;
  LData[1] := 9;
  LData[2] := 0;
  LData[3] := 0;
  LMemory := CreateMemoryIO(ptr(addr of LData[0]), 2, true);
  LPrefix := RegisterIO(LMemory);
  LFile := OpenPath(LPrefix + "/g.bin", "rb");
  Check("getc open", (LFile <> nil) and (FileIO(LFile) = LMemory));
  if (LFile = nil) or (FileIO(LFile) = nil) then
    if LFile <> nil then
      fclose(LFile);
    end;
    Check("getc handle rows", false);
  else
    Check("getc first", getc(LFile) = 7);
    Check("getc second", getc(LFile) = 9);
    Check("getc at end", (getc(LFile) = ADAM_HOOKIO_EOF) and (feof(LFile) <> 0));
    Check("getc close", fclose(LFile) = 0);
  end;
  Check("getc unregister", UnregisterIO(LPrefix));
  Check("getc io close", IOClose(LMemory));
end;

begin
  GFails := 0;
  TestStreamFlush();
  println("done {}", GFails);
end.
