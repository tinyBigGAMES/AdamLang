-------------------------------------------------------------------------------
  std_windows_forcedirs.adam - System.Windows' ForceDirectories on a deep path

  In output: a path 32 folders deep, none of them there, made in one call
  (a walk that recursed, each frame holding its WideBuffers, ran the stack
  out); every folder on its way is there afterwards; made again it is still
  a success; a file in the way and "" are false. Everything made is removed
  at the end. Each row prints ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok deep made
  | ok every level
  | ok made again
  | ok file in the way
  | ok empty path
  | ok cleaned
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_windows_forcedirs;

import System.SysUtils, System.Windows;

const
  // Deep enough that a recursion holding WideBuffers runs past the stack
  DEPTH: int64 = 32;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The folder ALevel deep under ARoot (0: ARoot itself)
routine LevelDir(const ARoot: string; const ALevel: int64): string;
var
  LDir: string;
  LI: int64;
begin
  LDir := ARoot;
  for LI := 1 to ALevel do
    LDir := LDir + "/d" + IntToStr(LI);
  end;
  return LDir;
end;

routine Run();
var
  LRoot: string;
  LDeep: string;
  LAll: bool;
  LGone: bool;
  LI: int64;
begin
  LRoot := ResolvePath("$P:std_windows_forcedirs_d");
  LDeep := LevelDir(LRoot, DEPTH);
  Check("deep made", ForceDirectories(LDeep));
  LAll := true;
  for LI := 0 to DEPTH do
    if not DirectoryExists(LevelDir(LRoot, LI)) then
      LAll := false;
    end;
  end;
  Check("every level", LAll);
  Check("made again", ForceDirectories(LDeep));
  Check("file in the way", WriteAllText(LDeep + "/f.txt", "x") and
    not ForceDirectories(LDeep + "/f.txt/sub"));
  Check("empty path", not ForceDirectories(""));
  LGone := DeleteFile(LDeep + "/f.txt");
  for LI := DEPTH downto 0 do
    if not RemoveDir(LevelDir(LRoot, LI)) then
      LGone := false;
    end;
  end;
  Check("cleaned", LGone);
end;

begin
  GFails := 0;
  Run();
  println("done {}", GFails);
end.
