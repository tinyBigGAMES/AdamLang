-------------------------------------------------------------------------------
  std_hookio_stream_wide.adam - the wide output side of System.HookIO from C
  (PaskalCPP's std_hookio TestStreamWide, with Adam's ccs= cases)

  The C fixture's wide write sequences (std_hookio_c_widewrite's 12
  variants: fputwc / putwc / fputws, narrow calls mixed in, fwide, buffer
  modes, fseek, append, characters a locale cannot map, surrogates) under
  the "C" and ".UTF8" locales, on a virtual file and on a real file: in w
  (variant 8 w+, variant 9 a) with b and with t as pcpp's row, then in the
  three ccs= text modes (UTF-8, UTF-16LE, UNICODE: the BOM written,
  lowio's conversion, ftell in UTF-16, the byte calls and fprintf refused
  with EINVAL). Every step's value, errno, ferror, fwide and ftell, fclose
  and the bytes that landed equal the real file's. Then a second open of
  one file in an appending or updating ccs= mode (the BOM read at the
  open), a UTF-16BE BOM (the open refused with EINVAL), a narrow fscanf of
  a ccs= stream (EOF with EINVAL, nothing read) and its fgetc / fgets /
  ungetc (each refused with EINVAL; on x86_64-linux-gnu, where glibc takes
  ccs= only right after a ',', those three are a plain byte open, scan and
  byte calls). One line per case: ok when every
  check of it held, else a FAIL line per check that did not.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | ok wide 0 C w
  | ok wide 0 C wb
  | ok wide 0 C wt
  | ok wide 0 C w, ccs=UTF-8
  | ok wide 0 C w, ccs=UTF-16LE
  | ok wide 0 C w, ccs=UNICODE
  | ok wide 0 .UTF8 w
  | ok wide 0 .UTF8 wb
  | ok wide 0 .UTF8 wt
  | ok wide 0 .UTF8 w, ccs=UTF-8
  | ok wide 0 .UTF8 w, ccs=UTF-16LE
  | ok wide 0 .UTF8 w, ccs=UNICODE
  | ok wide 1 C w
  | ok wide 1 C wb
  | ok wide 1 C wt
  | ok wide 1 C w, ccs=UTF-8
  | ok wide 1 C w, ccs=UTF-16LE
  | ok wide 1 C w, ccs=UNICODE
  | ok wide 1 .UTF8 w
  | ok wide 1 .UTF8 wb
  | ok wide 1 .UTF8 wt
  | ok wide 1 .UTF8 w, ccs=UTF-8
  | ok wide 1 .UTF8 w, ccs=UTF-16LE
  | ok wide 1 .UTF8 w, ccs=UNICODE
  | ok wide 2 C w
  | ok wide 2 C wb
  | ok wide 2 C wt
  | ok wide 2 C w, ccs=UTF-8
  | ok wide 2 C w, ccs=UTF-16LE
  | ok wide 2 C w, ccs=UNICODE
  | ok wide 2 .UTF8 w
  | ok wide 2 .UTF8 wb
  | ok wide 2 .UTF8 wt
  | ok wide 2 .UTF8 w, ccs=UTF-8
  | ok wide 2 .UTF8 w, ccs=UTF-16LE
  | ok wide 2 .UTF8 w, ccs=UNICODE
  | ok wide 3 C w
  | ok wide 3 C wb
  | ok wide 3 C wt
  | ok wide 3 C w, ccs=UTF-8
  | ok wide 3 C w, ccs=UTF-16LE
  | ok wide 3 C w, ccs=UNICODE
  | ok wide 3 .UTF8 w
  | ok wide 3 .UTF8 wb
  | ok wide 3 .UTF8 wt
  | ok wide 3 .UTF8 w, ccs=UTF-8
  | ok wide 3 .UTF8 w, ccs=UTF-16LE
  | ok wide 3 .UTF8 w, ccs=UNICODE
  | ok wide 4 C w
  | ok wide 4 C wb
  | ok wide 4 C wt
  | ok wide 4 C w, ccs=UTF-8
  | ok wide 4 C w, ccs=UTF-16LE
  | ok wide 4 C w, ccs=UNICODE
  | ok wide 4 .UTF8 w
  | ok wide 4 .UTF8 wb
  | ok wide 4 .UTF8 wt
  | ok wide 4 .UTF8 w, ccs=UTF-8
  | ok wide 4 .UTF8 w, ccs=UTF-16LE
  | ok wide 4 .UTF8 w, ccs=UNICODE
  | ok wide 5 C w
  | ok wide 5 C wb
  | ok wide 5 C wt
  | ok wide 5 C w, ccs=UTF-8
  | ok wide 5 C w, ccs=UTF-16LE
  | ok wide 5 C w, ccs=UNICODE
  | ok wide 5 .UTF8 w
  | ok wide 5 .UTF8 wb
  | ok wide 5 .UTF8 wt
  | ok wide 5 .UTF8 w, ccs=UTF-8
  | ok wide 5 .UTF8 w, ccs=UTF-16LE
  | ok wide 5 .UTF8 w, ccs=UNICODE
  | ok wide 6 C w
  | ok wide 6 C wb
  | ok wide 6 C wt
  | ok wide 6 C w, ccs=UTF-8
  | ok wide 6 C w, ccs=UTF-16LE
  | ok wide 6 C w, ccs=UNICODE
  | ok wide 6 .UTF8 w
  | ok wide 6 .UTF8 wb
  | ok wide 6 .UTF8 wt
  | ok wide 6 .UTF8 w, ccs=UTF-8
  | ok wide 6 .UTF8 w, ccs=UTF-16LE
  | ok wide 6 .UTF8 w, ccs=UNICODE
  | ok wide 7 C w
  | ok wide 7 C wb
  | ok wide 7 C wt
  | ok wide 7 C w, ccs=UTF-8
  | ok wide 7 C w, ccs=UTF-16LE
  | ok wide 7 C w, ccs=UNICODE
  | ok wide 7 .UTF8 w
  | ok wide 7 .UTF8 wb
  | ok wide 7 .UTF8 wt
  | ok wide 7 .UTF8 w, ccs=UTF-8
  | ok wide 7 .UTF8 w, ccs=UTF-16LE
  | ok wide 7 .UTF8 w, ccs=UNICODE
  | ok wide 8 C w+
  | ok wide 8 C w+b
  | ok wide 8 C w+t
  | ok wide 8 C w+, ccs=UTF-8
  | ok wide 8 C w+, ccs=UTF-16LE
  | ok wide 8 C w+, ccs=UNICODE
  | ok wide 8 .UTF8 w+
  | ok wide 8 .UTF8 w+b
  | ok wide 8 .UTF8 w+t
  | ok wide 8 .UTF8 w+, ccs=UTF-8
  | ok wide 8 .UTF8 w+, ccs=UTF-16LE
  | ok wide 8 .UTF8 w+, ccs=UNICODE
  | ok wide 9 C a
  | ok wide 9 C ab
  | ok wide 9 C at
  | ok wide 9 C a, ccs=UTF-8
  | ok wide 9 C a, ccs=UTF-16LE
  | ok wide 9 C a, ccs=UNICODE
  | ok wide 9 .UTF8 a
  | ok wide 9 .UTF8 ab
  | ok wide 9 .UTF8 at
  | ok wide 9 .UTF8 a, ccs=UTF-8
  | ok wide 9 .UTF8 a, ccs=UTF-16LE
  | ok wide 9 .UTF8 a, ccs=UNICODE
  | ok wide 10 C w
  | ok wide 10 C wb
  | ok wide 10 C wt
  | ok wide 10 C w, ccs=UTF-8
  | ok wide 10 C w, ccs=UTF-16LE
  | ok wide 10 C w, ccs=UNICODE
  | ok wide 10 .UTF8 w
  | ok wide 10 .UTF8 wb
  | ok wide 10 .UTF8 wt
  | ok wide 10 .UTF8 w, ccs=UTF-8
  | ok wide 10 .UTF8 w, ccs=UTF-16LE
  | ok wide 10 .UTF8 w, ccs=UNICODE
  | ok wide 11 C w
  | ok wide 11 C wb
  | ok wide 11 C wt
  | ok wide 11 C w, ccs=UTF-8
  | ok wide 11 C w, ccs=UTF-16LE
  | ok wide 11 C w, ccs=UNICODE
  | ok wide 11 .UTF8 w
  | ok wide 11 .UTF8 wb
  | ok wide 11 .UTF8 wt
  | ok wide 11 .UTF8 w, ccs=UTF-8
  | ok wide 11 .UTF8 w, ccs=UTF-16LE
  | ok wide 11 .UTF8 w, ccs=UNICODE
  | ok wide bom a, ccs=UTF-8 then a, ccs=UNICODE
  | ok wide bom a, ccs=UTF-8 then r+, ccs=UNICODE
  | ok wide bom a, ccs=UTF-8 then a+, ccs=UTF-8
  | ok wide bom a, ccs=UTF-16LE then a, ccs=UNICODE
  | ok wide bom a, ccs=UTF-16LE then r+, ccs=UNICODE
  | ok wide bom a, ccs=UTF-16LE then a+, ccs=UTF-8
  | ok wide bom a, ccs=UNICODE then a, ccs=UNICODE
  | ok wide bom a, ccs=UNICODE then r+, ccs=UNICODE
  | ok wide bom a, ccs=UNICODE then a+, ccs=UTF-8
  | ok wide utf-16be bom
  | ok wide narrow fscanf
  | ok wide narrow byte calls
  | ok wide real removed
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_stream_wide;

@ifdef TARGET_X86_64_WINDOWS_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";
@elseif TARGET_X86_64_LINUX_GNU
@addlibrarypath "$P:res/tests/std/fixtures/x86_64-linux-gnu";
@endif

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@elseif TARGET_X86_64_LINUX_GNU
  , System.HookIO.Linux64
@endif
  ;

routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_widewrite(APath: ptr to const char; AMode: ptr to const char;
  ALocale: ptr to const char; AVariant: int32; AResults: ptr to int64); external "std_hookio_c";
routine clink std_hookio_c_fscanf_file(AFile: ptr; AValue: ptr to int32): int32;
  external "std_hookio_c";

type
  // Four bytes of a file's start
  FileStart = array[0..3] of uint8;

const
  // std_hookio_c_widewrite's variants and result slots (72: the locale was set, 73: the open
  // succeeded)
  CVariants: int32 = 12;
  CSlots: int32 = 141;
  // The modes WideMode names per variant
  CModes: int32 = 6;
  // The ccs= modes of a BOM case's first and second open (BomFirst, BomSecond)
  CBomModes: int32 = 3;
  // A UTF-16BE BOM and one character after it
  CBigEndian: FileStart = [0xFE, 0xFF, 0x00, 0x41];
  // A number in UTF-8 text with its newline
  CNumber: FileStart = [0x31, 0x32, 0x0D, 0x0A];

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// One check of a case: nothing when it held, else a FAIL line naming it, counted in ABad
routine Part(const AName: string; const APart: string; const AOk: bool; var ABad: int32);
begin
  if not AOk then
    println("FAIL {} {}", AName, APart);
    ABad := ABad + 1;
  end;
end;

// The end of a case: its ok line when no check of it failed; the failures counted
routine Finish(const AName: string; const ABad: int32);
begin
  if ABad = 0 then
    println("ok {}", AName);
  end;
  GFails := GFails + ABad;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// The locales the wide rows run under: "C", then ucrt's UTF-8 one
routine WideLocale(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "C";
  end;
  return ".UTF8";
end;

// The locale setlocale is given for the locale named AIndex in the lines: ".UTF8" is ucrt's
// UTF-8 locale; on x86_64-linux-gnu glibc's C.UTF-8
routine LocaleName(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "C";
  end;
@ifdef TARGET_X86_64_LINUX_GNU
  return "C.UTF-8";
@else
  return ".UTF8";
@endif
end;

// The mode of wide variant AVariant, number AIndex: w (variant 8: w+, so its fseek block reads;
// variant 9: a), then with b, with t (pcpp's three), then the three ccs= text modes
routine WideMode(const AVariant: int32; const AIndex: int32): string;
var
  LBase: string;
begin
  LBase := "w";
  if AVariant = 8 then
    LBase := "w+";
  end;
  if AVariant = 9 then
    LBase := "a";
  end;
  if AIndex = 1 then
    return LBase + "b";
  end;
  if AIndex = 2 then
    return LBase + "t";
  end;
  if AIndex = 3 then
    return LBase + ", ccs=UTF-8";
  end;
  if AIndex = 4 then
    return LBase + ", ccs=UTF-16LE";
  end;
  if AIndex = 5 then
    return LBase + ", ccs=UNICODE";
  end;
  return LBase;
end;

// A BOM case's first open: variant 9's append on the empty file (the BOM written, none for
// UNICODE, whose "a" open stays ANSI)
routine BomFirst(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "a, ccs=UTF-8";
  end;
  if AIndex = 1 then
    return "a, ccs=UTF-16LE";
  end;
  return "a, ccs=UNICODE";
end;

// A BOM case's second open, on the file the first left: the BOM read at the open
routine BomSecond(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "a, ccs=UNICODE";
  end;
  if AIndex = 1 then
    return "r+, ccs=UNICODE";
  end;
  return "a+, ccs=UTF-8";
end;

// The fixture's sequence AVariant on APath in AMode under ALocale: its slots in AResults
routine WideC(const APath: string; const AMode: string; const ALocale: string;
  const AVariant: int32; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
  LLocale: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LLocale := StringToC(ALocale);
  std_hookio_c_widewrite(LPath, LMode, LLocale, AVariant, AResults);
  freemem(LPath);
  freemem(LMode);
  freemem(LLocale);
end;

// The fixture's sequence on the virtual file and on the real file: both ran (the locale set,
// the file opened) and every slot is equal; the checks counted in ABad
routine WidePair(const AName: string; const APrefix: string; const ARealPath: string;
  const AMode: string; const ALocale: string; const AVariant: int32; var ABad: int32);
var
  LVirtual: array[0..140] of int64;
  LReal: array[0..140] of int64;
begin
  WideC(APrefix + "/w.txt", AMode, ALocale, AVariant, addr of LVirtual[0]);
  WideC(ARealPath, AMode, ALocale, AVariant, addr of LReal[0]);
  Part(AName, "ran", (LVirtual[72] = 1) and (LVirtual[73] = 1) and (LReal[72] = 1) and
    (LReal[73] = 1), ABad);
  Part(AName, "as real file", SameSlots(addr of LVirtual[0], addr of LReal[0], CSlots), ABad);
end;

// One case: variant AVariant in WideMode(AVariant, AMode) under locale ALocale, on a new
// memory IO and a new real file
routine WideCase(const ARealPath: string; const AVariant: int32; const ALocale: int32;
  const AMode: int32);
var
  LMemory: IO;
  LPrefix: string;
  LName: string;
  LBad: int32;
begin
  LBad := 0;
  LName := "wide " + IntToStr(AVariant) + " " + WideLocale(ALocale) + " " +
    WideMode(AVariant, AMode);
  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  RemovePath(ARealPath);
  WidePair(LName, LPrefix, ARealPath, WideMode(AVariant, AMode), LocaleName(ALocale), AVariant,
    LBad);
  Part(LName, "unregister", UnregisterIO(LPrefix), LBad);
  Part(LName, "io close", IOClose(LMemory), LBad);
  Finish(LName, LBad);
end;

// One BOM case: BomFirst(AFirst) with variant 9, then BomSecond(ASecond) with variant 0 on the
// same virtual file and the same real file
routine BomCase(const ARealPath: string; const AFirst: int32; const ASecond: int32);
var
  LMemory: IO;
  LPrefix: string;
  LName: string;
  LBad: int32;
begin
  LBad := 0;
  LName := "wide bom " + BomFirst(AFirst) + " then " + BomSecond(ASecond);
  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  RemovePath(ARealPath);
  WidePair(LName + " first", LPrefix, ARealPath, BomFirst(AFirst), "C", 9, LBad);
  WidePair(LName + " second", LPrefix, ARealPath, BomSecond(ASecond), "C", 0, LBad);
  Part(LName, "unregister", UnregisterIO(LPrefix), LBad);
  Part(LName, "io close", IOClose(LMemory), LBad);
  Finish(LName, LBad);
end;

// fopen of APath in AMode (the hook: a virtual path opens a handle, a real one the C runtime's
// FILE), closed again at once: whether it opened, and errno right after it (cleared first)
routine OpenProbe(const APath: string; const AMode: string; var AOpened: bool;
  var AErrno: int32);
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  SetCErrno(0);
  LFile := fopen(LPath, LMode);
  AErrno := CErrno();
  AOpened := LFile <> nil;
  if AOpened then
    fclose(LFile);
  end;
  freemem(LPath);
  freemem(LMode);
end;

// A narrow fscanf("%d") of APath opened "r, ccs=UTF-8": AOpened, then its value, errno (cleared
// first) and the number it left (77 going in)
routine ScanProbe(const APath: string; var AOpened: bool; var AResult: int32;
  var AErrno: int32; var AValue: int32);
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
  LValue: int32;
begin
  LPath := StringToC(APath);
  LMode := StringToC("r, ccs=UTF-8");
  LFile := fopen(LPath, LMode);
  AOpened := LFile <> nil;
  AResult := 0;
  AErrno := 0;
  AValue := 0;
  if AOpened then
    LValue := 77;
    SetCErrno(0);
    AResult := std_hookio_c_fscanf_file(LFile, addr of LValue);
    AErrno := CErrno();
    AValue := LValue;
    fclose(LFile);
  end;
  freemem(LPath);
  freemem(LMode);
end;

// A memory IO holding ABytes, registered (its prefix in APrefix), and the real file at
// ARealPath holding the same bytes; the checks counted in ABad
routine StartPair(const AName: string; const ABytes: FileStart; const ARealPath: string;
  var AMemory: IO; var APrefix: string; var ABad: int32);
var
  LBytes: FileStart;
begin
  LBytes := ABytes;
  AMemory := CreateMemoryIO();
  Part(AName, "io", (IOWrite(AMemory, ptr(addr of LBytes[0]), 4) = 4) and
    (IOSeek(AMemory, 0, SeekOrigin.FromStart) = 0), ABad);
  APrefix := RegisterIO(AMemory);
  Part(AName, "real file", WriteRaw(ARealPath, addr of LBytes[0], 4), ABad);
end;

// A UTF-16BE BOM (FE FF) refuses a ccs= open that reads it: no FILE and EINVAL, on the virtual
// file as on the real one
routine WideBigEndian(const ARealPath: string);
var
  LMemory: IO;
  LPrefix: string;
  LName: string;
  LBad: int32;
  LVirtualOpened: bool;
  LVirtualErrno: int32;
  LRealOpened: bool;
  LRealErrno: int32;
begin
  LBad := 0;
  LName := "wide utf-16be bom";
  StartPair(LName, CBigEndian, ARealPath, LMemory, LPrefix, LBad);
  OpenProbe(LPrefix + "/w.txt", "r, ccs=UNICODE", LVirtualOpened, LVirtualErrno);
  OpenProbe(ARealPath, "r, ccs=UNICODE", LRealOpened, LRealErrno);
@ifdef TARGET_X86_64_LINUX_GNU
  // glibc takes ccs= only right after the ',' (", ccs=" names no charset): a plain byte open
  Part(LName, "refused", LVirtualOpened and LRealOpened, LBad);
  Part(LName, "errno", LVirtualErrno = LRealErrno, LBad);
@else
  Part(LName, "refused", (not LVirtualOpened) and (not LRealOpened), LBad);
  Part(LName, "errno", (LVirtualErrno = LRealErrno) and (LRealErrno = ADAM_ERRNO_EINVAL),
    LBad);
@endif
  Part(LName, "unregister", UnregisterIO(LPrefix), LBad);
  Part(LName, "io close", IOClose(LMemory), LBad);
  Finish(LName, LBad);
end;

// A narrow fscanf of a ccs= stream: EOF with EINVAL and nothing read, on the virtual file as on
// the real one (ucrt's input processor validates the stream first)
routine WideScan(const ARealPath: string);
var
  LMemory: IO;
  LPrefix: string;
  LName: string;
  LBad: int32;
  LOpened: array[0..1] of bool;
  LResult: array[0..1] of int32;
  LErrno: array[0..1] of int32;
  LValue: array[0..1] of int32;
begin
  LBad := 0;
  LName := "wide narrow fscanf";
  StartPair(LName, CNumber, ARealPath, LMemory, LPrefix, LBad);
  ScanProbe(LPrefix + "/w.txt", LOpened[0], LResult[0], LErrno[0], LValue[0]);
  ScanProbe(ARealPath, LOpened[1], LResult[1], LErrno[1], LValue[1]);
  Part(LName, "opened", LOpened[0] and LOpened[1], LBad);
  Part(LName, "as real file", (LResult[0] = LResult[1]) and (LErrno[0] = LErrno[1]) and
    (LValue[0] = LValue[1]), LBad);
@ifdef TARGET_X86_64_LINUX_GNU
  // glibc: ", ccs=" names no charset, so the byte stream's scan reads the number
  Part(LName, "refused", (LResult[1] = 1) and (LErrno[1] = 0) and (LValue[1] = 12), LBad);
@else
  Part(LName, "refused", (LResult[1] = ADAM_HOOKIO_EOF) and (LErrno[1] = ADAM_ERRNO_EINVAL) and
    (LValue[1] = 77), LBad);
@endif
  Part(LName, "unregister", UnregisterIO(LPrefix), LBad);
  Part(LName, "io close", IOClose(LMemory), LBad);
  Finish(LName, LBad);
end;

// fgetc, fgets and ungetc of APath opened "r, ccs=UTF-8" (ucrt validates the stream first in
// each): AOpened, then each call's answer (fgets: 1 for text, 0 for none) and errno right after
// it (cleared first), into AResults[0 .. 5]
routine ByteProbe(const APath: string; var AOpened: bool; const AResults: ptr to int32);
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
  LText: array[0..7] of char;
begin
  LPath := StringToC(APath);
  LMode := StringToC("r, ccs=UTF-8");
  LFile := fopen(LPath, LMode);
  AOpened := LFile <> nil;
  if AOpened then
    SetCErrno(0);
    AResults[0] := fgetc(LFile);
    AResults[1] := CErrno();
    SetCErrno(0);
    AResults[2] := 0;
    if fgets(addr of LText[0], 8, LFile) <> nil then
      AResults[2] := 1;
    end;
    AResults[3] := CErrno();
    SetCErrno(0);
    AResults[4] := ungetc(65, LFile);
    AResults[5] := CErrno();
    fclose(LFile);
  end;
  freemem(LPath);
  freemem(LMode);
end;

// The byte calls of a ccs= stream: fgetc and ungetc EOF, fgets no text, each with EINVAL, on
// the virtual file as on the real one
routine WideBytes(const ARealPath: string);
var
  LMemory: IO;
  LPrefix: string;
  LName: string;
  LBad: int32;
  LOpened: array[0..1] of bool;
  LVirtual: array[0..5] of int32;
  LReal: array[0..5] of int32;
  LI: int32;
  LSame: bool;
begin
  LBad := 0;
  LName := "wide narrow byte calls";
  StartPair(LName, CNumber, ARealPath, LMemory, LPrefix, LBad);
  ByteProbe(LPrefix + "/w.txt", LOpened[0], addr of LVirtual[0]);
  ByteProbe(ARealPath, LOpened[1], addr of LReal[0]);
  Part(LName, "opened", LOpened[0] and LOpened[1], LBad);
  LSame := true;
  for LI := 0 to 5 do
    if LVirtual[LI] <> LReal[LI] then
      println("  call {}: io {} real {}", LI, LVirtual[LI], LReal[LI]);
      LSame := false;
    end;
  end;
  Part(LName, "as real file", LSame, LBad);
@ifdef TARGET_X86_64_LINUX_GNU
  // glibc: ", ccs=" names no charset, so the byte calls read and give back as on any file
  Part(LName, "refused", (LReal[0] = 49) and (LReal[1] = 0) and (LReal[2] = 1) and
    (LReal[3] = 0) and (LReal[4] = 65) and (LReal[5] = 0), LBad);
@else
  Part(LName, "refused", (LReal[0] = ADAM_HOOKIO_EOF) and (LReal[1] = ADAM_ERRNO_EINVAL) and
    (LReal[2] = 0) and (LReal[3] = ADAM_ERRNO_EINVAL) and (LReal[4] = ADAM_HOOKIO_EOF) and
    (LReal[5] = ADAM_ERRNO_EINVAL), LBad);
@endif
  Part(LName, "unregister", UnregisterIO(LPrefix), LBad);
  Part(LName, "io close", IOClose(LMemory), LBad);
  Finish(LName, LBad);
end;

// The wide output side from C on a virtual file and on a real file under both locales, in
// every mode WideMode names; then the BOM cases, the UTF-16BE refusal, the narrow scan and the
// byte calls of a ccs= stream
routine TestStreamWide();
var
  LRealPath: string;
  LVariant: int32;
  LLocale: int32;
  LMode: int32;
  LFirst: int32;
  LSecond: int32;
begin
  LRealPath := paramstr(0) + ".wide.txt";
  for LVariant := 0 to CVariants - 1 do
    for LLocale := 0 to 1 do
      for LMode := 0 to CModes - 1 do
        WideCase(LRealPath, LVariant, LLocale, LMode);
      end;
    end;
  end;
  for LFirst := 0 to CBomModes - 1 do
    for LSecond := 0 to CBomModes - 1 do
      BomCase(LRealPath, LFirst, LSecond);
    end;
  end;
  WideBigEndian(LRealPath);
  WideScan(LRealPath);
  WideBytes(LRealPath);
  Check("wide real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestStreamWide();
  println("done {}", GFails);
end.
