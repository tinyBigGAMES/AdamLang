-------------------------------------------------------------------------------
  std_hookio_fd_mode_win64.adam - a HookIO handle's CRT descriptor on win64,
  its mode and size (PLAN-LINUX64 LX3d3e3a): _setmode changing lowio's text
  mode in place (every old mode answered as ucrt's _setmode_nolock answers
  it, a bad mode EINVAL and the handler, the stream on the number reading in
  the new mode); _chsize / _chsize_s growing an IO with zero bytes and
  cutting it, the place kept and a text mode set back, the refusals (a size
  below 0 EINVAL and the handler, a read-only zip entry EACCES whichever
  way); _get_osfhandle answering INVALID_HANDLE_VALUE for an open number
  with no OS handle (errno kept, no handler); a closed number EBADF and the
  handler for each; mingw's oldnames setmode / chsize from C
  (libstd_hookio_c.a) reaching the hooks, and a real file's descriptor left
  to ucrt.
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu
  exitcode 0
  | ok setmode modes
  | ok setmode text read
  | ok setmode refused
  | ok setmode stream
  | ok chsize grow
  | ok chsize grow text
  | ok chsize cut
  | ok chsize refused
  | ok chsize read-only
  | ok osfhandle handle
  | ok closed number
  | ok oldnames mode
  | ok real file ucrt
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_fd_mode_win64;

@ifndef TARGET_X86_64_WINDOWS_GNU
@message error "std_hookio_fd_mode_win64 runs on x86_64-windows-gnu only: build it with -t x86_64-windows-gnu";
@endif

@addlibrarypath "$P:res/tests/std/fixtures/x86_64-windows-gnu";

import System.Windows, System.SysUtils, System.Runtime, System.CustomIO, System.HookIO,
  System.HookIO.Win64;

// ucrt's handler of a failed parameter check for this thread (it comes before the process's)
func _set_thread_local_invalid_parameter_handler(const AHandler: func(
  const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64)): ptr;
  external "ucrtbase";
// ucrt's remove of a real file
func remove(const APath: ptr to const char): int32; external "ucrtbase";
// The fixture's descriptor mode and size changed by a C library's names (mingw's oldnames
// setmode / chsize, libcextras aliases of ucrt's _setmode / _chsize imports)
func clink std_hookio_c_lowio_mode(APath: ptr to const char; ASize: clong;
  AResults: ptr to int64); external "std_hookio_c";

const
  // ucrt's errno.h
  EBADF: int32 = 9;
  EACCES: int32 = 13;
  EINVAL: int32 = 22;
  SEEK_SET: int32 = 0;
  SEEK_CUR: int32 = 1;
  SEEK_END: int32 = 2;
  ADAM_TEST_ZIP: string = "$P:../../../../res/tests/std/fixtures/std_customio_stored.zip";
  ADAM_TEST_SIZE: int64 = 12;

var
  GFails: int32;
  // The failed parameter checks so far
  GInvalid: int64;

func Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// The thread's invalid parameter handler: counts the call and returns (the call then returns
// its failure)
func OnInvalid(const AExpression: ptr to const wchar; const AFunction: ptr to const wchar;
  const AFile: ptr to const wchar; const ALine: uint32; const AReserved: uint64);
begin
  GInvalid := GInvalid + 1;
end;

// A call's failure: -1 and errno AError (errno cleared by the caller before the call)
func FailedWith(const AAnswer: int64; const AError: int32): bool;
begin
  return (AAnswer = -1) and (CErrno() = AError);
end;

// A call's failure as ucrt's failed parameter check gives it: -1, errno AError and one more
// handler call since ABefore
func RefusedWith(const AAnswer: int64; const AError: int32; const ABefore: int64): bool;
begin
  return FailedWith(AAnswer, AError) and (GInvalid = ABefore + 1);
end;

// _open of an Adam text path (passed straight to C for the call)
func OpenFd(const APath: string; const AFlags: int32): int32;
var
  LFile: int32;
begin
  LFile := _open(APath, AFlags, int32(_S_IREAD | _S_IWRITE));
  return LFile;
end;

// fopen of an Adam text path and mode
func OpenPath(const APath: string; const AMode: string): ptr;
var
  LFile: ptr;
begin
  LFile := fopen(APath, AMode);
  return LFile;
end;

// A read / write memory IO of its own holding "a\r\nb" (the bytes copied in: the IO outlives
// this routine), registered (its name in APrefix)
func TextMemory(var APrefix: string): IO;
var
  LText: array[0..3] of uint8;
  LMemory: IO;
begin
  LText[0] := 97u;
  LText[1] := 13u;
  LText[2] := 10u;
  LText[3] := 98u;
  LMemory := CreateMemoryIO();
  IOWrite(LMemory, addr of LText[0], 4);
  IOSeek(LMemory, 0, SeekOrigin.FromStart);
  APrefix := RegisterIO(LMemory);
  return LMemory;
end;

// True when AMemory's bytes from AFrom to its end are all 0, and it holds ASize of them
func ZerosFrom(const AMemory: IO; const AFrom: int64; const ASize: int64): bool;
var
  LByte: array[0..0] of uint8;
  LI: int64;
begin
  if (IOSize(AMemory) <> ASize) or (IOSeek(AMemory, AFrom, SeekOrigin.FromStart) <> AFrom) then
    return false;
  end;
  for LI := AFrom to ASize - 1 do
    if (IORead(AMemory, addr of LByte[0], 1) <> 1) or (LByte[0] <> 0u) then
      return false;
    end;
  end;
  return true;
end;

// _setmode on a lowio open's descriptor: each old mode as ucrt answers it, a text read after
// a binary one, a bad mode refused; then a stream's descriptor
func TestSetmode();
var
  LMemory: IO;
  LPrefix: string;
  LFd: int32;
  LBuffer: array[0..7] of uint8;
  LFile: ptr;
  LOk: bool;
  LBefore: int64;
begin
  LMemory := TextMemory(LPrefix);
  LFd := OpenFd(LPrefix, _O_RDONLY | _O_BINARY);
  // UTF-16 answers _O_WTEXT whichever flag set it (setmode.cpp)
  LOk := (LFd >= 0) and (_setmode(LFd, _O_TEXT) = _O_BINARY) and (_setmode(LFd, _O_U8TEXT) = _O_TEXT) and
    (_setmode(LFd, _O_U16TEXT) = _O_U8TEXT) and (_setmode(LFd, _O_WTEXT) = _O_WTEXT) and
    (_setmode(LFd, _O_BINARY) = _O_WTEXT) and (_setmode(LFd, _O_BINARY) = _O_BINARY);
  Check("setmode modes", LOk);
  // Binary reads the four bytes; text mode from the start reads "a\nb"
  LOk := (_read(LFd, addr of LBuffer[0], 8u) = 4) and (LBuffer[1] = 13u) and
    (_setmode(LFd, _O_TEXT) = _O_BINARY) and (_lseeki64(LFd, 0, SEEK_SET) = 0) and
    (_read(LFd, addr of LBuffer[0], 8u) = 3) and (LBuffer[0] = 97u) and (LBuffer[1] = 10u) and
    (LBuffer[2] = 98u);
  Check("setmode text read", LOk);
  SetCErrno(0);
  LBefore := GInvalid;
  Check("setmode refused", RefusedWith(_setmode(LFd, 0x1234), EINVAL, LBefore) and
    RefusedWith(_setmode(LFd, 0), EINVAL, LBefore + 1) and (_setmode(LFd, _O_TEXT) = _O_TEXT) and
    (_close(LFd) = 0));
  // A binary stream's descriptor set to text before the first fill: fread reads "a\nb"
  LFile := OpenPath(LPrefix, "rb");
  LOk := (LFile <> nil) and (_setmode(_fileno(LFile), _O_TEXT) = _O_BINARY) and
    (fread(addr of LBuffer[0], 1, 8, LFile) = 3) and (LBuffer[0] = 97u) and (LBuffer[1] = 10u) and
    (LBuffer[2] = 98u) and (fclose(LFile) = 0);
  Check("setmode stream", LOk);
  UnregisterIO(LPrefix);
  IOClose(LMemory);
end;

// _chsize / _chsize_s on a read-write memory IO: grown with zeros (a text descriptor's mode set
// back), cut, the place kept; the refusals
func TestChsize(const APrefix: string);
var
  LMemory: IO;
  LPrefix: string;
  LFd: int32;
  LText: array[0..4] of uint8;
  LFile: ptr;
  LOk: bool;
  LBefore: int64;
begin
  LText[0] := 104u;
  LText[1] := 101u;
  LText[2] := 108u;
  LText[3] := 108u;
  LText[4] := 111u;
  LMemory := CreateMemoryIO();
  LPrefix := RegisterIO(LMemory);
  // Read-write, binary (a _creat would take _fmode's default text mode)
  LFd := OpenFd(LPrefix, _O_RDWR | _O_BINARY);
  LOk := (LFd >= 0) and (_write(LFd, addr of LText[0], 5u) = 5) and (_chsize(LFd, 8) = 0) and
    (_telli64(LFd) = 5) and ZerosFrom(LMemory, 5, 8) and (_filelengthi64(LFd) = 8);
  Check("chsize grow", LOk);
  // The zeros are written binary: a text descriptor keeps its mode
  LOk := (_setmode(LFd, _O_TEXT) = _O_BINARY) and (_chsize_s(LFd, 10) = 0) and ZerosFrom(LMemory, 5, 10) and
    (_setmode(LFd, _O_BINARY) = _O_TEXT) and (_telli64(LFd) = 5);
  Check("chsize grow text", LOk);
  // A cut keeps the place (a memory IO never sits past its end, so the cut stays above it);
  // the same size again changes nothing
  LOk := (_chsize_s(LFd, 7) = 0) and (IOSize(LMemory) = 7) and (_telli64(LFd) = 5) and
    (_filelengthi64(LFd) = 7) and (_chsize(LFd, 7) = 0) and (IOSize(LMemory) = 7);
  Check("chsize cut", LOk);
  SetCErrno(0);
  LBefore := GInvalid;
  LOk := (_chsize_s(LFd, -1) = EINVAL) and (CErrno() = EINVAL) and (GInvalid = LBefore + 1);
  SetCErrno(0);
  LOk := LOk and RefusedWith(_chsize(LFd, -1), EINVAL, LBefore + 1) and (IOSize(LMemory) = 7);
  Check("chsize refused", LOk and (_close(LFd) = 0));
  UnregisterIO(LPrefix);
  IOClose(LMemory);
  // A zip entry handle reads only: neither way changes it, EACCES with no handler
  LFile := OpenPath(APrefix + "/hello.txt", "rb");
  LFd := _fileno(LFile);
  SetCErrno(0);
  LBefore := GInvalid;
  LOk := (LFile <> nil) and (_chsize_s(LFd, ADAM_TEST_SIZE + 4) = EACCES) and (CErrno() = EACCES);
  SetCErrno(0);
  LOk := LOk and FailedWith(_chsize(LFd, 3), EACCES) and (_filelengthi64(LFd) = ADAM_TEST_SIZE) and
    (_telli64(LFd) = 0) and (GInvalid = LBefore) and (fclose(LFile) = 0);
  Check("chsize read-only", LOk);
end;

// _get_osfhandle of a handle's descriptor: no OS handle behind it, errno kept; then every call
// of this atom on a closed number
func TestOsfhandle(const APrefix: string);
var
  LFile: ptr;
  LFd: int32;
  LOk: bool;
  LBefore: int64;
begin
  LFile := OpenPath(APrefix + "/hello.txt", "rb");
  LFd := _fileno(LFile);
  SetCErrno(0);
  LBefore := GInvalid;
  Check("osfhandle handle", (LFile <> nil) and (_get_osfhandle(LFd) = -1) and (CErrno() = 0) and
    (GInvalid = LBefore));
  SetCErrno(0);
  LBefore := GInvalid;
  LOk := (_close(LFd) = 0) and RefusedWith(_get_osfhandle(LFd), EBADF, LBefore) and
    RefusedWith(_setmode(LFd, _O_TEXT), EBADF, LBefore + 1);
  SetCErrno(0);
  LOk := LOk and (_chsize_s(LFd, 1) = EBADF) and (CErrno() = EBADF) and (GInvalid = LBefore + 3);
  SetCErrno(0);
  LOk := LOk and RefusedWith(_chsize(LFd, 1), EBADF, LBefore + 3);
  Check("closed number", LOk);
  // The stream's own close on a closed number: EOF and the handler, as std_hookio_fd_win64
  fclose(LFile);
end;

// mingw's oldnames setmode / chsize from C on a read-write memory IO
func TestOldnames();
var
  LMemory: IO;
  LPrefix: string;
  LResults: array[0..5] of int64;
begin
  LMemory := TextMemory(LPrefix);
  std_hookio_c_lowio_mode(LPrefix, 6, addr of LResults[0]);
  Check("oldnames mode", (LResults[0] >= 0) and (LResults[1] = int64(_O_BINARY)) and
    (LResults[2] = int64(_O_TEXT)) and (LResults[3] = 0) and (LResults[4] = 6) and (LResults[5] = 0) and
    ZerosFrom(LMemory, 4, 6));
  UnregisterIO(LPrefix);
  IOClose(LMemory);
end;

// A real file's descriptor: ucrt's (a real OS handle, its own mode and size)
func TestReal();
var
  LPath: string;
  LFd: int32;
  LText: array[0..2] of uint8;
  LOk: bool;
begin
  LText[0] := 97u;
  LText[1] := 98u;
  LText[2] := 99u;
  LPath := paramstr(0) + ".fdmode.txt";
  LFd := OpenFd(LPath, _O_RDWR | _O_CREAT | _O_TRUNC | _O_BINARY);
  LOk := (LFd >= 0) and (_write(LFd, addr of LText[0], 3u) = 3) and (_get_osfhandle(LFd) <> -1) and
    (_setmode(LFd, _O_TEXT) = _O_BINARY) and (_chsize_s(LFd, 1) = 0) and (_filelengthi64(LFd) = 1) and
    (_close(LFd) = 0);
  LOk := LOk and (remove(LPath) = 0);
  Check("real file ucrt", LOk);
end;

var
  LZip: IOSource;
  LPrefix: string;
begin
  _set_thread_local_invalid_parameter_handler(OnInvalid);
  LZip := CreateZipIOSource(ADAM_TEST_ZIP);
  LPrefix := RegisterIOSource(LZip);
  TestSetmode();
  TestChsize(LPrefix);
  TestOsfhandle(LPrefix);
  TestOldnames();
  TestReal();
  UnregisterIO(LPrefix);
  IOSourceClose(LZip);
  println("done {}", GFails);
end.
