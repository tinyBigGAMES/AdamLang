-------------------------------------------------------------------------------
  std_hookio_query.adam - System.HookIO's query family (PaskalCPP's
  std_hookio_query)

  The query names answer a virtual path as fopen would find it: the file
  exists when an open of it can succeed, its size is the IO's, it is
  writable when a write open that empties nothing ("r+") succeeds, it has
  no times. A registered memory IO ("hello"), entries of a registered zip
  IOSource (std_customio_stored.zip: hello.txt, 12 bytes), a missing entry,
  and a real file of the same bytes. Called directly: _access (0, 6, 2 on
  the zip entry the zip will not open for writing, 4, a bad mode), the
  oldnames access, mingw's stat64i32 and GetFileAttributesA (NORMAL,
  READONLY, INVALID_FILE_ATTRIBUTES with ERROR_FILE_NOT_FOUND). Then from C
  (std_hookio_c_query: the dllimport _access, mingw's stat and
  GetFileAttributesA through its import slot, as raylib's file queries
  reach them; pcpp's rows went through raylib, which Adam has no unit for).
  Each answer for a real path is the C runtime's own.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok register
  | ok real file
  | ok _access memory exists
  | ok _access memory read write
  | ok _access zip entry write refused
  | ok _access zip entry read
  | ok _access zip missing
  | ok _access bad mode
  | ok _access unregistered prefix
  | ok _access real
  | ok access memory exists
  | ok access zip missing
  | ok access real
  | ok stat memory
  | ok stat zip entry
  | ok stat zip missing
  | ok stat real
  | ok attributes memory
  | ok attributes zip entry
  | ok attributes zip missing
  | ok attributes real
  | ok c query memory
  | ok c query zip entry
  | ok c query zip missing
  | ok c query real
  | ok real removed
  | ok unregister memory
  | ok unregister zip
  | ok io close
  | ok source close
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_query;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@endif
  ;

routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_query(APath: ptr to const char; AResults: ptr to int64);
  external "std_hookio_c";
routine clink GetLastError(): uint32; external "kernel32";

const
  // sys/stat.h's file type mask, regular file and owner write bit; the errno values the
  // rows expect (ucrt's errno.h); ERROR_FILE_NOT_FOUND
  ADAM_QUERY_S_IFMT: uint16 = 0xF000;
  ADAM_QUERY_S_IFREG: uint16 = 0x8000;
  ADAM_QUERY_S_IWRITE: uint16 = 0x0080;
  ADAM_QUERY_ENOENT: int32 = 2;
  ADAM_QUERY_EACCES: int32 = 13;
  ADAM_QUERY_EINVAL: int32 = 22;
  ADAM_QUERY_ERROR_FILE_NOT_FOUND: uint32 = 2;
  ADAM_QUERY_INVALID: uint32 = 0xFFFFFFFF;

type
  // ucrt's struct _stat64i32 as Win64 lays it out (48 bytes)
  StatBuffer = record
    Device: uint32;
    Inode: uint16;
    ModeBits: uint16;
    LinkCount: int16;
    OwnerId: int16;
    GroupId: int16;
    RawDevice: uint32;
    ByteSize: int32;
    AccessTime: int64;
    ModifyTime: int64;
    ChangeTime: int64;
  end;

var
  GFails: int32;
  // The memory IO's bytes ("hello")
  GText: array[0..4] of uint8;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// _access on APath with AMode: the result, errno after it in AError (0 before)
routine AccessOf(const APath: string; const AMode: int32; var AError: int32): int32;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  SetCErrno(0);
  LResult := _access(LPath, AMode);
  AError := CErrno();
  freemem(LPath);
  return LResult;
end;

// The oldnames access on APath with AMode: the result, errno after it in AError
routine PlainAccessOf(const APath: string; const AMode: int32; var AError: int32): int32;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  SetCErrno(0);
  LResult := access(LPath, AMode);
  AError := CErrno();
  freemem(LPath);
  return LResult;
end;

// stat64i32 on APath into AStat: the result, errno after it in AError
routine StatOf(const APath: string; var AStat: StatBuffer; var AError: int32): int32;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  SetCErrno(0);
  LResult := stat64i32(LPath, ptr(addr of AStat));
  AError := CErrno();
  freemem(LPath);
  return LResult;
end;

// GetFileAttributesA on APath: its result, GetLastError after it in ALastError (when the
// result is INVALID_FILE_ATTRIBUTES; else 0)
routine AttributesOf(const APath: string; var ALastError: uint32): uint32;
var
  LPath: ptr to char;
  LResult: uint32;
begin
  LPath := StringToC(APath);
  LResult := GetFileAttributesA(LPath);
  ALastError := 0;
  if LResult = ADAM_QUERY_INVALID then
    ALastError := GetLastError();
  end;
  freemem(LPath);
  return LResult;
end;

// The C fixture's queries of APath into AResults (8 slots)
routine QueryC(const APath: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
begin
  LPath := StringToC(APath);
  std_hookio_c_query(LPath, AResults);
  freemem(LPath);
end;

// AOk (the slots' check) handed back; when it failed, every one of AResults' 8 slots is printed
routine SameQuery(const AName: string; const AResults: ptr to int64; const AOk: bool): bool;
var
  LI: int32;
begin
  if not AOk then
    for LI := 0 to 7 do
      println("  {} slot {}: {}", AName, LI, AResults[LI]);
    end;
  end;
  return AOk;
end;

// _access, the oldnames access, stat64i32 and GetFileAttributesA called directly
routine TestDirect(const AMemory: string; const AZip: string; const AReal: string);
var
  LStat: StatBuffer;
  LResult: int32;
  LError: int32;
  LLast: uint32;
begin
  Check("_access memory exists", AccessOf(AMemory + "/a", 0, LError) = 0);
  Check("_access memory read write", AccessOf(AMemory + "/a", 6, LError) = 0);
  LResult := AccessOf(AZip + "/hello.txt", 2, LError);
  Check("_access zip entry write refused", (LResult = -1) and (LError = ADAM_QUERY_EACCES));
  Check("_access zip entry read", AccessOf(AZip + "/hello.txt", 4, LError) = 0);
  LResult := AccessOf(AZip + "/missing.txt", 0, LError);
  Check("_access zip missing", (LResult = -1) and (LError = ADAM_QUERY_ENOENT));
  LResult := AccessOf(AMemory + "/a", 1, LError);
  Check("_access bad mode", (LResult = -1) and (LError = ADAM_QUERY_EINVAL));
  LResult := AccessOf("io://999999/a.txt", 0, LError);
  Check("_access unregistered prefix", (LResult = -1) and (LError = ADAM_QUERY_ENOENT));
  Check("_access real", AccessOf(AReal, 0, LError) = 0);
  Check("access memory exists", PlainAccessOf(AMemory + "/a", 0, LError) = 0);
  LResult := PlainAccessOf(AZip + "/missing.txt", 0, LError);
  Check("access zip missing", (LResult = -1) and (LError = ADAM_QUERY_ENOENT));
  Check("access real", PlainAccessOf(AReal, 0, LError) = 0);

  LResult := StatOf(AMemory + "/a", LStat, LError);
  Check("stat memory", (LResult = 0) and (LStat.ByteSize = 5) and
    ((LStat.ModeBits & ADAM_QUERY_S_IFMT) = ADAM_QUERY_S_IFREG) and
    ((LStat.ModeBits & ADAM_QUERY_S_IWRITE) <> 0) and (LStat.LinkCount = 1));
  LResult := StatOf(AZip + "/hello.txt", LStat, LError);
  Check("stat zip entry", (LResult = 0) and (LStat.ByteSize = 12) and
    ((LStat.ModeBits & ADAM_QUERY_S_IFMT) = ADAM_QUERY_S_IFREG) and
    ((LStat.ModeBits & ADAM_QUERY_S_IWRITE) = 0));
  LResult := StatOf(AZip + "/missing.txt", LStat, LError);
  Check("stat zip missing", (LResult = -1) and (LError = ADAM_QUERY_ENOENT));
  LResult := StatOf(AReal, LStat, LError);
  Check("stat real", (LResult = 0) and (LStat.ByteSize = 5));

  Check("attributes memory", AttributesOf(AMemory + "/a", LLast) = 0x80);
  Check("attributes zip entry", AttributesOf(AZip + "/hello.txt", LLast) = 0x1);
  Check("attributes zip missing", (AttributesOf(AZip + "/missing.txt", LLast) =
    ADAM_QUERY_INVALID) and (LLast = ADAM_QUERY_ERROR_FILE_NOT_FOUND));
  Check("attributes real", AttributesOf(AReal, LLast) <> ADAM_QUERY_INVALID);
end;

// The same queries from C code (the fixture's), through C's own declarations
routine TestFromC(const AMemory: string; const AZip: string; const AReal: string);
var
  LResults: array[0..7] of int64;
begin
  QueryC(AMemory + "/a", addr of LResults[0]);
  Check("c query memory", SameQuery("memory", addr of LResults[0], (LResults[0] = 0) and
    (LResults[2] = 0) and (LResults[4] = 5) and ((LResults[5] & 0xF000) = 0x8000) and
    (LResults[6] = 0x80)));
  QueryC(AZip + "/hello.txt", addr of LResults[0]);
  Check("c query zip entry", SameQuery("zip entry", addr of LResults[0], (LResults[0] = 0) and
    (LResults[2] = 0) and (LResults[4] = 12) and ((LResults[5] & 0x0080) = 0) and
    (LResults[6] = 0x1)));
  QueryC(AZip + "/missing.txt", addr of LResults[0]);
  Check("c query zip missing", SameQuery("zip missing", addr of LResults[0],
    (LResults[0] = -1) and (LResults[1] = 2) and (LResults[2] = -1) and (LResults[3] = 2) and
    (LResults[6] = 0xFFFFFFFF) and (LResults[7] = 2)));
  QueryC(AReal, addr of LResults[0]);
  Check("c query real", SameQuery("real", addr of LResults[0], (LResults[0] = 0) and
    (LResults[2] = 0) and (LResults[4] = 5) and (LResults[6] <> 0xFFFFFFFF)));
end;

routine TestQuery();
var
  LMemory: IO;
  LZip: IOSource;
  LMemoryPrefix: string;
  LZipPrefix: string;
  LRealPath: string;
begin
  GText[0] := uint8('h');
  GText[1] := uint8('e');
  GText[2] := uint8('l');
  GText[3] := uint8('l');
  GText[4] := uint8('o');
  LMemory := CreateMemoryIO(ptr(addr of GText[0]), 5, true);
  LMemoryPrefix := RegisterIO(LMemory);
  LZip := CreateZipIOSource("$P:../../../../res/tests/std/fixtures/std_customio_stored.zip");
  LZipPrefix := RegisterIOSource(LZip);
  Check("register", (LMemoryPrefix <> "") and (LZipPrefix <> ""));
  LRealPath := paramstr(0) + ".query.txt";
  Check("real file", WriteRaw(LRealPath, addr of GText[0], 5));

  TestDirect(LMemoryPrefix, LZipPrefix, LRealPath);
  TestFromC(LMemoryPrefix, LZipPrefix, LRealPath);

  Check("real removed", RemovePath(LRealPath));
  Check("unregister memory", UnregisterIO(LMemoryPrefix));
  Check("unregister zip", UnregisterIO(LZipPrefix));
  Check("io close", IOClose(LMemory));
  Check("source close", IOSourceClose(LZip));
end;

begin
  GFails := 0;
  TestQuery();
  println("done {}", GFails);
end.
