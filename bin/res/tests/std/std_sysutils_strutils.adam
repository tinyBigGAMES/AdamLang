-------------------------------------------------------------------------------
  std_sysutils_strutils.adam - System.SysUtils' TrimLeft, StartsText and
  StrToIntDef (PaskalCPP's StrUtils routines Adam lacked)

  TrimLeft cuts the bytes at or below the space at the start only (inside
  and trailing blanks, UTF-8 text stay; all blanks and "" give ""). StartsText
  compares a prefix with A..Z and a..z as one: an empty prefix starts
  anything, a longer one nothing, a UTF-8 byte only itself. StrToIntDef
  gives the number TryStrToInt reads, else the default (int64's ends
  included). Each row prints ok or FAIL with its name.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok trim left
  | ok trim left all blanks
  | ok trim left empty
  | ok trim left none
  | ok trim left utf8
  | ok starts
  | ok starts case
  | ok starts case text
  | ok starts empty
  | ok starts empty both
  | ok starts longer
  | ok starts miss
  | ok starts utf8
  | ok starts utf8 case
  | ok def bad
  | ok def good
  | ok def minus
  | ok def empty
  | ok def int64
  | ok def int64 max
  | ok def int64 over
  | done 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_sysutils_strutils;

import System.SysUtils;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

begin
  GFails := 0;
  Check("trim left", TrimLeft(" \t a b  ") = "a b  ");
  Check("trim left all blanks", TrimLeft(" \t\r\n") = "");
  Check("trim left empty", TrimLeft("") = "");
  Check("trim left none", TrimLeft("ab ") = "ab ");
  Check("trim left utf8", TrimLeft("  café") = "café");

  Check("starts", StartsText("sp", "spawn"));
  Check("starts case", StartsText("SP", "spawn"));
  Check("starts case text", StartsText("sp", "SPAWN"));
  Check("starts empty", StartsText("", "spawn"));
  Check("starts empty both", StartsText("", ""));
  Check("starts longer", not StartsText("spawns", "spawn"));
  Check("starts miss", not StartsText("sw", "spawn"));
  Check("starts utf8", StartsText("CAFé", "café au lait"));
  // Only A..Z fold: É (C3 89) is not é (C3 A9)
  Check("starts utf8 case", not StartsText("CAFÉ", "café"));

  Check("def bad", StrToIntDef("12x", -1) = -1);
  Check("def good", StrToIntDef("5", -1) = 5);
  Check("def minus", StrToIntDef("-42", 0) = -42);
  Check("def empty", StrToIntDef("", 7) = 7);
  Check("def int64", StrToIntDef("-5000000000", 0) = -5000000000);
  Check("def int64 max", StrToIntDef("9223372036854775807", 0) = 9223372036854775807);
  Check("def int64 over", StrToIntDef("9223372036854775808", 3) = 3);
  println("done {}", GFails);
end.
