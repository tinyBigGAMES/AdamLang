-------------------------------------------------------------------------------
  std_hookio_memory.adam - System.HookIO over a registered memory IO
  (PaskalCPP's std_hookio TestMemory)

  A read-only memory IO registered under a prefix: two handles of their own
  on one stream, the name after the prefix optional, the bytes the
  caller's, w on the read-only IO refused (EACCES), the IO kept open by
  closing its handles. Then fread and fwrite on handles: each handle reads
  from its own place, whole items are counted, a short read at the end
  counts no partial item, a read-only handle writes nothing; on a growing
  memory IO w+ writes at the handle's place, a reads back what was
  written, a appends at the end.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | ok register io
  | ok register io prefix form
  | ok memory open ours
  | ok memory second open own handle
  | ok memory name optional
  | ok memory bytes through handle
  | ok memory first close
  | ok memory write on read-only refused
  | ok memory close
  | ok memory bare close
  | ok memory close keeps io
  | ok memory unregister
  | ok memory io close
  | ok stream register
  | ok stream fread
  | ok stream fread own place
  | ok stream fread items
  | ok stream fread short at end
  | ok stream fwrite refused on read handle
  | ok stream read closes
  | ok stream write open
  | ok stream fwrite
  | ok stream fwrite items
  | ok stream fread what was written
  | ok stream fwrite appends
  | ok stream write closes
  | ok stream unregister
  | ok stream io close
  | done 0
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe std_hookio_memory;

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO;

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when the first ACount bytes at AFirst and ASecond are equal
routine SameBytes(const AFirst: ptr; const ASecond: ptr; const ACount: int64): bool;
var
  LFirst: ptr to uint8;
  LSecond: ptr to uint8;
  LI: int64;
begin
  LFirst := ptr to uint8(AFirst);
  LSecond := ptr to uint8(ASecond);
  for LI := 0 to ACount - 1 do
    if LFirst[LI] <> LSecond[LI] then
      return false;
    end;
  end;
  return true;
end;

// True when the ACount bytes at ABuffer count up from AFirst
routine CountsFrom(const ABuffer: ptr; const AFirst: int32; const ACount: int64): bool;
var
  LBytes: ptr to uint8;
  LI: int64;
begin
  LBytes := ptr to uint8(ABuffer);
  for LI := 0 to ACount - 1 do
    if int64(LBytes[LI]) <> int64(AFirst) + LI then
      return false;
    end;
  end;
  return true;
end;

// A failed open: nil, and errno is AError (cleared before the call by the caller, so the
// value is the call's own). A stream that opened anyway is closed (the row fails)
routine Failed(const AFile: ptr; const AErrno: int32; const AError: int32): bool;
begin
  if AFile <> nil then
    fclose(AFile);
    return false;
  end;
  return AErrno = AError;
end;

// fopen of an Adam text path and mode (their C copies freed after the call)
routine OpenPath(const APath: string; const AMode: string): ptr;
var
  LPath: ptr to char;
  LMode: ptr to char;
  LFile: ptr;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  LFile := fopen(LPath, LMode);
  freemem(LPath);
  freemem(LMode);
  return LFile;
end;

// A registered memory IO: two handles of their own on one stream, the name after the prefix
// optional, the bytes the caller's, w on the read-only IO refused (EACCES), the IO kept open
// by closing its handles
routine TestMemory();
var
  LData: array[0..7] of uint8;
  LCopy: array[0..7] of uint8;
  LMemory: IO;
  LStream: IO;
  LPrefix: string;
  LFile: ptr;
  LSecond: ptr;
  LBare: ptr;
  LOk: bool;
  LError: int32;
  LI: int32;
begin
  for LI := 0 to 7 do
    LData[LI] := uint8(40 + LI);
  end;
  LMemory := CreateMemoryIO(addr of LData[0], 8, true);
  LPrefix := RegisterIO(LMemory);
  Check("register io", LPrefix <> "");
  Check("register io prefix form", StartsStr("io://", LPrefix));

  LFile := OpenPath(LPrefix + "/song.ogg", "rb");
  Check("memory open ours", (LFile <> nil) and (FileIO(LFile) = LMemory));
  LSecond := OpenPath(LPrefix + "/song.ogg", "rb");
  Check("memory second open own handle",
    (LSecond <> nil) and (LSecond <> LFile) and (FileIO(LSecond) = LMemory));
  LBare := OpenPath(LPrefix, "r");
  Check("memory name optional", FileIO(LBare) = LMemory);

  LStream := FileIO(LFile);
  LOk := LStream <> nil;
  if LOk then
    LOk := IOSeek(LStream, 0, SeekOrigin.FromStart) = 0;
  end;
  if LOk then
    LOk := IORead(LStream, addr of LCopy[0], 8) = 8;
  end;
  Check("memory bytes through handle", LOk and SameBytes(addr of LCopy[0], addr of LData[0], 8));
  Check("memory first close", (LFile <> nil) and (fclose(LFile) = 0));

  // A read-only IO cannot be emptied: refused as a read-only file is
  SetCErrno(0);
  LFile := OpenPath(LPrefix + "/song.ogg", "wb");
  LError := CErrno();
  Check("memory write on read-only refused", Failed(LFile, LError, ADAM_ERRNO_EACCES));

  Check("memory close", (LSecond <> nil) and (fclose(LSecond) = 0));
  Check("memory bare close", (LBare <> nil) and (fclose(LBare) = 0));
  LFile := OpenPath(LPrefix + "/song.ogg", "rb");
  Check("memory close keeps io", (LFile <> nil) and (fclose(LFile) = 0) and (IOSize(LMemory) = 8));

  Check("memory unregister", UnregisterIO(LPrefix));
  Check("memory io close", IOClose(LMemory));
end;

// fread and fwrite on handles: each read handle has its own place and counts whole items; a
// read-only handle writes nothing; w+ writes at its place, a appends at the IO's end
routine TestStream();
var
  LData: array[0..7] of uint8;
  LSource: array[0..9] of uint8;
  LBuffer: array[0..15] of uint8;
  LMemory: IO;
  LGrow: IO;
  LPrefix: string;
  LFirst: ptr;
  LSecond: ptr;
  LWrite: ptr;
  LRead: ptr;
  LAppend: ptr;
  LI: int32;
begin
  for LI := 0 to 7 do
    LData[LI] := uint8(40 + LI);
  end;
  for LI := 0 to 9 do
    LSource[LI] := uint8(1 + LI);
  end;
  LMemory := CreateMemoryIO(addr of LData[0], 8, true);
  LPrefix := RegisterIO(LMemory);
  LFirst := OpenPath(LPrefix + "/a.bin", "rb");
  LSecond := OpenPath(LPrefix + "/a.bin", "rb");
  Check("stream register", (LPrefix <> "") and (LFirst <> nil) and (LSecond <> nil));

  Check("stream fread", (fread(addr of LBuffer[0], 1, 3, LFirst) = 3) and
    CountsFrom(addr of LBuffer[0], 40, 3));
  Check("stream fread own place", (fread(addr of LBuffer[0], 1, 2, LSecond) = 2) and
    CountsFrom(addr of LBuffer[0], 40, 2));
  // Two items of 2 bytes from place 3: 43 .. 46
  Check("stream fread items", (fread(addr of LBuffer[0], 2, 2, LFirst) = 2) and
    CountsFrom(addr of LBuffer[0], 43, 4));
  // One byte is left at place 7: no whole item of 4
  Check("stream fread short at end", fread(addr of LBuffer[0], 4, 1, LFirst) = 0);
  Check("stream fwrite refused on read handle", fwrite(addr of LSource[0], 1, 1, LSecond) = 0);
  Check("stream read closes", (fclose(LFirst) = 0) and (fclose(LSecond) = 0) and
    UnregisterIO(LPrefix) and IOClose(LMemory));

  LGrow := CreateMemoryIO();
  LPrefix := RegisterIO(LGrow);
  LWrite := OpenPath(LPrefix + "/out.bin", "w+b");
  Check("stream write open", (LWrite <> nil) and (FileIO(LWrite) = LGrow));
  Check("stream fwrite", (fwrite(addr of LSource[0], 1, 4, LWrite) = 4) and (IOSize(LGrow) = 4));
  // Three items of 2 bytes after the first 4: the IO holds 1 .. 10
  Check("stream fwrite items", (fwrite(addr of LSource[0], 2, 3, LWrite) = 3) and
    (IOSize(LGrow) = 10));
  LRead := OpenPath(LPrefix + "/out.bin", "rb");
  Check("stream fread what was written", (fread(addr of LBuffer[0], 1, 10, LRead) = 10) and
    CountsFrom(addr of LBuffer[0], 1, 4) and CountsFrom(addr of LBuffer[4], 1, 6));
  LAppend := OpenPath(LPrefix, "ab");
  Check("stream fwrite appends", (fwrite(addr of LSource[0], 1, 2, LAppend) = 2) and
    (IOSize(LGrow) = 12));
  Check("stream write closes", (fclose(LWrite) = 0) and (fclose(LRead) = 0) and
    (fclose(LAppend) = 0));
  Check("stream unregister", UnregisterIO(LPrefix));
  Check("stream io close", IOClose(LGrow));
end;

begin
  GFails := 0;
  TestMemory();
  TestStream();
  println("done {}", GFails);
end.
