module exe std_hookio_stream_text_unget;

@addlibrarypath "$P:res/tests/std/fixtures";

import System.SysUtils, System.Runtime, System.CustomIO, System.HookIO
@ifdef TARGET_X86_64_WINDOWS_GNU
  , System.HookIO.Win64
@endif
  ;

routine clink std_hookio_c_writeraw(APath: ptr to const char; ABytes: ptr to const uint8;
  ACount: clong): int32; external "std_hookio_c";
routine clink std_hookio_c_textcount(): int32; external "std_hookio_c";
routine clink std_hookio_c_textsample(AIndex: int32; ABuffer: ptr to uint8; ACap: clong): clong;
  external "std_hookio_c";
routine clink std_hookio_c_longcount(): int32; external "std_hookio_c";
routine clink std_hookio_c_longsample(AIndex: int32; ABuffer: ptr to uint8; ACap: clong): clong;
  external "std_hookio_c";
routine clink std_hookio_c_textunget(APath: ptr to const char; AMode: ptr to const char;
  AResults: ptr to int64); external "std_hookio_c";

var
  GFails: int32;

routine Check(const AName: string; const AOk: bool);
begin
  if AOk then
    println("ok {}", AName);
  else
    println("FAIL {}", AName);
    GFails := GFails + 1;
  end;
end;

// True when ACount slots of AFirst equal ASecond's; on a difference the first differing slot
// is printed, so a FAIL row names what differs
routine SameSlots(const AFirst: ptr to int64; const ASecond: ptr to int64;
  const ACount: int32): bool;
var
  LI: int32;
begin
  for LI := 0 to ACount - 1 do
    if AFirst[LI] <> ASecond[LI] then
      println("  slot {}: io {} real {}", LI, AFirst[LI], ASecond[LI]);
      return false;
    end;
  end;
  return true;
end;

// Deletes the file at APath; false when it is not deleted
routine RemovePath(const APath: string): bool;
var
  LPath: ptr to char;
  LOk: bool;
begin
  LPath := StringToC(APath);
  LOk := RemoveFile(LPath);
  freemem(LPath);
  return LOk;
end;

// ACount bytes at ABytes into a new real file at APath (the C runtime's own FILE)
routine WriteRaw(const APath: string; const ABytes: ptr to uint8; const ACount: int64): bool;
var
  LPath: ptr to char;
  LResult: int32;
begin
  LPath := StringToC(APath);
  LResult := std_hookio_c_writeraw(LPath, ABytes, clong(ACount));
  freemem(LPath);
  return LResult = 0;
end;

// A read mode by index: "rt", "r", "rb"
routine TextReadMode(const AIndex: int32): string;
begin
  if AIndex = 0 then
    return "rt";
  end;
  if AIndex = 1 then
    return "r";
  end;
  return "rb";
end;

// The C fixture's ungetc and scans on APath in AMode: its 53 slots in AResults
routine TextUngetC(const APath: string; const AMode: string; const AResults: ptr to int64);
var
  LPath: ptr to char;
  LMode: ptr to char;
begin
  LPath := StringToC(APath);
  LMode := StringToC(AMode);
  std_hookio_c_textunget(LPath, LMode, AResults);
  freemem(LPath);
  freemem(LMode);
end;

// ungetc and scans from C on a virtual file and on a real file of the same bytes, every short
// and long sample through "rt", "r" and "rb": every slot equals the real file's (Windows text
// mode: ungetc into ucrt's buffer, a second one refused at its front, a scan's look-ahead that
// refills it)
routine TestStreamTextUnget();
var
  LSample: array[0..8191] of uint8;
  LLength: clong;
  LMemory: IO;
  LPrefix: string;
  LRealPath: string;
  LVirtual: array[0..52] of int64;
  LReal: array[0..52] of int64;
  LIndex: int32;
  LMode: int32;
  LName: string;
  LShort: int32;
  LTotal: int32;
begin
  LRealPath := paramstr(0) + ".textunget.txt";
  LShort := std_hookio_c_textcount();
  LTotal := LShort + std_hookio_c_longcount();
  for LIndex := 0 to LTotal - 1 do
    if LIndex < LShort then
      LLength := std_hookio_c_textsample(LIndex, addr of LSample[0], 8192);
      LName := "unget " + IntToStr(LIndex);
    else
      LLength := std_hookio_c_longsample(LIndex - LShort, addr of LSample[0], 8192);
      LName := "unget long " + IntToStr(LIndex - LShort);
    end;
    Check(LName + " sample", LLength > 0);
    LMemory := CreateMemoryIO(addr of LSample[0], int64(LLength), true);
    LPrefix := RegisterIO(LMemory);
    Check(LName + " real file", WriteRaw(LRealPath, addr of LSample[0], int64(LLength)));
    for LMode := 0 to 2 do
      TextUngetC(LPrefix + "/g.txt", TextReadMode(LMode), addr of LVirtual[0]);
      TextUngetC(LRealPath, TextReadMode(LMode), addr of LReal[0]);
      Check(LName + " " + TextReadMode(LMode) + " closed", LVirtual[52] = 0);
      Check(LName + " " + TextReadMode(LMode) + " as real file", SameSlots(addr of LVirtual[0],
        addr of LReal[0], 53));
    end;
    if LIndex = LTotal - 1 then
      // The number that ends the first big fill: both values scanned
      Check(LName + " scanned", (LVirtual[42] = 2) and (LVirtual[43] = 12345) and
        (LVirtual[44] = 67));
    end;
    Check(LName + " unregister", UnregisterIO(LPrefix));
    Check(LName + " io close", IOClose(LMemory));
  end;
  Check("unget real removed", RemovePath(LRealPath));
end;

begin
  GFails := 0;
  TestStreamTextUnget();
  println("done {}", GFails);
end.
