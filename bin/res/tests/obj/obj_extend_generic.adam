-------------------------------------------------------------------------------
  obj_extend_generic.adam - extend of a generic type (BNF sec 3 / 10, F1):
  `extend List<T>` adds to every List instance (T bound per instance),
  `extend List<int32>` to that instance only, `extend Map<string, V>` to
  every Map keyed by string (V bound per instance); each extend's instance
  is made, checked and compiled for the instances code uses. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | last 30 c
  | total 60
  | twice 4
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_extend_generic;

import System.Collections;

extend List<T>
  const method Last(): T;
  begin
    return self.Items[self.Count - 1];
  end;
end;

extend List<int32>
  const method Total(): int32;
  var
    LI: int64;
    LSum: int32;
  begin
    LSum := 0;
    for LI := 0 to self.Count - 1 do
      LSum := LSum + self.Items[LI];
    end;
    return LSum;
  end;
end;

extend Map<string, V>
  const method TwiceCount(): int64;
  begin
    return self.Count * 2;
  end;
end;

var
  GInts: List<int32>;
  GTexts: List<string>;
  GMap: Map<string, int32>;

begin
  GInts.Add(10);
  GInts.Add(20);
  GInts.Add(30);
  GTexts.Add("a");
  GTexts.Add("c");
  println("last {} {}", GInts.Last(), GTexts.Last());
  println("total {}", GInts.Total());
  GMap.Put("x", 1);
  GMap.Put("y", 2);
  println("twice {}", GMap.TwiceCount());
  println("end");
end.
