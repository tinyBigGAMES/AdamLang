-------------------------------------------------------------------------------
  obj_interface_is_as.adam - is / as to and from interfaces (I3, BNF sec 6
  O12): an object, a ptr, a ref and an own tested for an interface its
  dynamic type implements (at its level or a level above, or a child
  interface of it), an interface value tested for an object type and for
  another interface; `as` from an object to an interface (the object's
  itable word for it, found in its dynamic type's TypeInfo entries), from an
  interface to an object (the word moved back to the object) and between
  interfaces, keeping X's kind (a place, ptr to, ref: nil stays nil); a
  failed `as` raises code 13 with the type's name. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | base named true shape true count false
  | cube named true shape true count true
  | plain named false
  | ptr shape true count true
  | nil false
  | ref count true named true
  | own shape true
  | iface cube true base true plain false count true
  | as base 6
  | as cube 27 bump 4
  | ptr cube 27
  | nil stays nil
  | ref count 4
  | ref back cube 27
  | ref nil stays nil
  | own named base
  | cube back 3
  | 13 invalid cast: the object is not a ICount
  | 13 invalid cast: the object is not a TCube
  | 13 invalid cast: the object is not a ICount
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_interface_is_as;

type
  INamed = interface
    const method Name(): string;
  end;

  IShape = interface(INamed)
    method Area(): int64;
  end;

  ICount = interface
    method Bump(): int64;
  end;

  TPlain = object
    Tag: int64;

    virtual method Area(): int64;
    begin
      return 1;
    end;
  end;

  TBase = object implements IShape
    Side: int64;

    init();
    begin
      self.Side := 2;
    end;

    virtual const method Name(): string;
    begin
      return "base";
    end;

    virtual method Area(): int64;
    begin
      return self.Side * 3;
    end;
  end;

  TCube = object(TBase) implements ICount
    N: int64;

    init();
    begin
      self.Side := 3;
      self.N := 3;
    end;

    override const method Name(): string;
    begin
      return "cube";
    end;

    override method Area(): int64;
    begin
      return self.Side * self.Side * self.Side;
    end;

    virtual method Bump(): int64;
    begin
      self.N := self.N + 1;
      return self.N;
    end;
  end;

  PBase = ptr to TBase;
  PShape = ptr to IShape;
  PCount = ptr to ICount;
  PCube = ptr to TCube;

func Tests(const ALabel: string; const AObject: TBase);
begin
  println("{} named {} shape {} count {}", ALabel, AObject is INamed, AObject is IShape, AObject is ICount);
end;

func Plain(const AObject: TPlain);
begin
  println("plain named {}", AObject is INamed);
end;

func Iface(const AShape: IShape; const APlain: INamed);
begin
  println("iface cube {} base {} plain {} count {}", AShape is TCube, AShape is TBase, APlain is TCube,
    AShape is ICount);
end;

func Casts(var AShape: IShape; const ABase: INamed);
begin
  println("as base {}", (ABase as TBase).Area());
  println("as cube {} bump {}", (AShape as TCube).Area(), (AShape as ICount).Bump());
end;

func Run();
var
  LBase: TBase;
  LCube: TCube;
  LPlain: TPlain;
  LPtr: PBase;
  LNil: PBase;
  LShapeP: PShape;
  LCubeP: PCube;
  LRef: ref IShape;
  LCount: ref ICount;
  LBack: ref TCube;
  LNoRef: ref IShape;
  LOwn: own TBase;
  LN: int64;
begin
  Tests("base", LBase);
  Tests("cube", LCube);
  Plain(LPlain);
  LPtr := addr of LCube;
  LNil := nil;
  println("ptr shape {} count {}", LPtr is IShape, LPtr is ICount);
  println("nil {}", LNil is IShape);
  LRef := ref TCube();
  println("ref count {} named {}", LRef is ICount, LRef is INamed);
  LOwn := own TBase();
  println("own shape {}", LOwn is IShape);
  Iface(LCube, LBase);
  Casts(LCube, LBase);
  LShapeP := LPtr as IShape;
  LCubeP := LShapeP as TCube;
  println("ptr cube {}", LCubeP->Area());
  LShapeP := LNil as IShape;
  if LShapeP = nil then
    println("nil stays nil");
  end;
  LCount := LRef as ICount;
  LRef := nil;
  println("ref count {}", LCount.Bump());
  LBack := LCount as TCube;
  LCount := nil;
  println("ref back cube {}", LBack.Area());
  LNoRef := nil;
  LCount := LNoRef as ICount;
  if LCount = nil then
    println("ref nil stays nil");
  end;
  println("own named {}", (LOwn as INamed).Name());
  LShapeP := addr of LCube;
  println("cube back {}", (LShapeP as TCube)->Side);
  LPtr := addr of LBase;
  guard
    LN := (LPtr as ICount)->Bump();
  except
    println("{} {}", exccode(), excmsg());
  end;
  guard
    LN := (LOwn as TCube).N;
  except
    println("{} {}", exccode(), excmsg());
  end;
  LRef := ref TBase();
  guard
    LCount := LRef as ICount;
  except
    println("{} {}", exccode(), excmsg());
  end;
  println("end");
end;

begin
  Run();
end.
