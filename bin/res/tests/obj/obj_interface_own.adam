-------------------------------------------------------------------------------
  obj_interface_own.adam - own I / ref I (I3, BNF sec 4 owner type, DESIGN
  sec 8): an interface value held by a ref or an own is its itable word's
  address; its counts and its end go through the object the word moves back
  to (the itable's offset). A ref of an object converted to a ref of an
  interface it implements (TBox past a plain parent part: the word is not at
  0), shared, released, converted to the parent interface (one word); an own
  built in place and moved; a ref and an own interface in an object's
  fields and in a dynamic array; a ref interface given to a ref interface
  parameter (a ref of the object too: moved to the word); nil stays nil.
  Interface properties run through the itable's accessor slots (a read, a
  write, a compound, an override below the implementing level). Every
  object ends once (its done), nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | show a 9 3
  | side 5
  | shared 25
  | named a
  | done a
  | show b 4 2
  | box 4
  | done b
  | cube 8 side 2
  | grown 7 343
  | nil ref
  | bump 1
  | bump 2
  | done d
  | held e 1
  | array f 1 g 8
  | done g
  | done f
  | done e
  | done h
  | done c
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_interface_own;

type
  INamed = interface
    const method Name(): string;
  end;

  IShape = interface(INamed)
    method Area(): int64;
    property Side: int64 read; write;
  end;

  ICount = interface
    method Bump(): int64;
  end;

  TData = object
    Tag: int64;
  end;

  TBox = object(TData) implements IShape, ICount
    FSide: int64;
    FLabel: string;
    N: int64;

    init(const ASide: int64; const ALabel: string);
    begin
      self.FSide := ASide;
      self.FLabel := ALabel;
    end;

    done;
    begin
      println("done {}", self.FLabel);
    end;

    virtual const method Name(): string;
    begin
      return self.FLabel;
    end;

    virtual method Area(): int64;
    begin
      return self.FSide * self.FSide;
    end;

    virtual property Side: int64 read FSide; write FSide;

    virtual method Bump(): int64;
    begin
      self.N := self.N + 1;
      return self.N;
    end;
  end;

  TCube = object(TBox)
    init(const ASide: int64; const ALabel: string);
    begin
      parent.init(ASide, ALabel);
    end;

    override method Area(): int64;
    begin
      return self.FSide * self.FSide * self.FSide;
    end;
  end;

  THolder = object
    Shape: ref IShape;
    Count: own ICount;
  end;

routine Show(const AShape: ref IShape);
begin
  println("show {} {} {}", AShape.Name(), AShape.Area(), AShape.Side);
end;

routine MakeShape(const ASide: int64; const ALabel: string): ref IShape;
begin
  return ref TBox(ASide, ALabel);
end;

routine Tests();
var
  LR: ref IShape;
  LR2: ref IShape;
  LN: ref INamed;
  LBox: ref TBox;
  LO: own ICount;
  LH: THolder;
  LArr: array of ref IShape;
  LNone: ref IShape;
begin
  LR := MakeShape(3, "a");
  Show(LR);
  LR.Side := 5;
  println("side {}", LR.Side);
  LR2 := LR;
  LR := nil;
  println("shared {}", LR2.Area());
  LN := LR2;
  LR2 := nil;
  println("named {}", LN.Name());
  LN := nil;
  LBox := ref TBox(2, "b");
  LR := LBox;
  Show(LBox);
  LBox := nil;
  println("box {}", LR.Area());
  LR := ref TCube(2, "c");
  println("cube {} side {}", LR.Area(), LR.Side);
  LR.Side += 5;
  println("grown {} {}", LR.Side, LR.Area());
  LNone := nil;
  if LNone = nil then
    println("nil ref");
  end;
  LO := own TBox(1, "d");
  println("bump {}", LO.Bump());
  println("bump {}", LO.Bump());
  LO := nil;
  LH.Shape := ref TBox(1, "e");
  LH.Count := own TBox(1, "h");
  println("held {} {}", LH.Shape.Name(), LH.Count.Bump());
  setlength(LArr, 2);
  LArr[0] := ref TBox(1, "f");
  LArr[1] := ref TCube(2, "g");
  println("array {} {} {} {}", LArr[0].Name(), LArr[0].Area(), LArr[1].Name(), LArr[1].Area());
end;

begin
  Tests();
  println("end");
end.
