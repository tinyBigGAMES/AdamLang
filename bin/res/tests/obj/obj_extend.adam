-------------------------------------------------------------------------------
  obj_extend.adam - extend (BNF sec 3, F1): methods, const and static methods
  and operators added to a record, an object and a choices type declared
  elsewhere, one reached through an alias of its target, and a record of
  another unit (ExtendShapes.Box) given methods and operators by that unit's
  public extend. An extend's methods reach the target's members through
  self, call each other and the target's own; a const method runs on a
  value a call made. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | make 3 4
  | dot 11
  | scaled 6 8
  | sum 14
  | plus 7 10
  | temp 25
  | bump 12
  | paint red blue
  | box 6 same
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_extend;

@addmodulepath "$P:res/tests/obj/fixtures";

import ExtendShapes;

type
  Vec2 = record
    X: int32;
    Y: int32;
  end;

  Vec2Alias = Vec2;

  Counter = object
    FValue: int64;

    const method Get(): int64;
    begin
      return self.FValue;
    end;
  end;

  Paint = choices(Red, Green, Blue);

extend Vec2
  static method Make(const AX: int32; const AY: int32): Vec2;
  var
    LV: Vec2;
  begin
    LV.X := AX;
    LV.Y := AY;
    return LV;
  end;

  const method Dot(const AOther: Vec2): int32;
  begin
    return self.X * AOther.X + self.Y * AOther.Y;
  end;

  method Scale(const AK: int32);
  begin
    self.X := self.X * AK;
    self.Y := self.Y * AK;
  end;

  operator +(const A: Vec2; const B: Vec2): Vec2;
  begin
    return Vec2.Make(A.X + B.X, A.Y + B.Y);
  end;
end;

// through an alias: the same Vec2
extend Vec2Alias
  const method Sum(): int32;
  begin
    return self.X + self.Y;
  end;
end;

extend Counter
  method Bump(const AN: int64);
  begin
    self.FValue := self.Get() + AN;
  end;
end;

extend Paint
  const method Name(): string;
  begin
    if self = Paint.Red then
      return "red";
    end;
    if self = Paint.Green then
      return "green";
    end;
    return "blue";
  end;
end;

var
  GA: Vec2;
  GB: Vec2;
  GC: Vec2;
  GCounter: Counter;
  GPaint: Paint;
  GBox: Box;
  GOther: Box;

begin
  GA := Vec2.Make(3, 4);
  println("make {} {}", GA.X, GA.Y);
  GB := Vec2.Make(1, 2);
  println("dot {}", GA.Dot(GB));
  GA.Scale(2);
  println("scaled {} {}", GA.X, GA.Y);
  println("sum {}", GA.Sum());
  GC := GB + Vec2.Make(6, 8);
  println("plus {} {}", GC.X, GC.Y);
  println("temp {}", Vec2.Make(3, 4).Dot(Vec2.Make(3, 4)));
  GCounter.FValue := 5;
  GCounter.Bump(7);
  println("bump {}", GCounter.Get());
  GPaint := Paint.Blue;
  println("paint {} {}", Paint.Red.Name(), GPaint.Name());
  GBox.W := 2;
  GBox.H := 3;
  GOther.W := 3;
  GOther.H := 2;
  if GBox = GOther then
    println("box {} same", GBox.Area());
  else
    println("box {} differ", GBox.Area());
  end;
  println("end");
end.
