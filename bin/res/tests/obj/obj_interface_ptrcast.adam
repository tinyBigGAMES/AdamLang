-------------------------------------------------------------------------------
  obj_interface_ptrcast.adam - pointer casts back down and across (BNF
  sec 6 pointer cast, I3: an interface is a virtual base, so the address
  moves): a ptr to an interface cast back to its object (ptr to TSquare,
  ptr to TBase) and to a plain parent past the vptr (TData under TCounted);
  across to another interface the object has (IShape to IPrintable) and to
  one it lacks (nil, never a raise: `as` is the checked form); a ptr to a
  polymorphic object cast to an interface its static type does not name;
  a ptr to a parent object cast down to its descendant; nil stays nil on
  every path.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | back 4
  | base 16
  | cross 4
  | lacks true
  | down 4
  | object cross 4
  | data 9 9
  | nil true true true
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe obj_interface_ptrcast;

type
  IShape = interface
    method Area(): int32;
  end;
  IPrintable = interface
    method Show(): int32;
  end;
  ICount = interface
    method Count(): int32;
  end;
  TBase = object implements IShape
    virtual method Area(): int32;
    begin
      return 1;
    end;
  end;
  TSquare = object(TBase) implements IPrintable
    S: int32;
    override method Area(): int32;
    begin
      return self.S * self.S;
    end;
    virtual method Show(): int32;
    begin
      return self.S;
    end;
  end;
  TData = object
    D: int64;
  end;
  TCounted = object(TData) implements ICount
    virtual method Count(): int32;
    begin
      return int32(self.D);
    end;
  end;

routine Run();
var
  LSq: TSquare;
  LCounted: TCounted;
  LSqP: ptr to TSquare;
  LBaseP: ptr to TBase;
  LShape: ptr to IShape;
  LPrint: ptr to IPrintable;
  LCount: ptr to ICount;
  LDataP: ptr to TData;
begin
  LSq.S := 4;
  LSqP := addr of LSq;
  LShape := LSqP;
  LSqP := ptr to TSquare(LShape);
  println("back {}", LSqP^.S);
  LBaseP := ptr to TBase(LShape);
  println("base {}", LBaseP^.Area());
  LPrint := ptr to IPrintable(LShape);
  println("cross {}", LPrint^.Show());
  LCount := ptr to ICount(LShape);
  println("lacks {}", LCount = nil);
  LSqP := ptr to TSquare(LBaseP);
  println("down {}", LSqP^.S);
  LPrint := ptr to IPrintable(LBaseP);
  println("object cross {}", LPrint^.Show());
  LCounted.D := 9;
  LCount := addr of LCounted;
  LDataP := ptr to TData(LCount);
  println("data {} {}", LDataP^.D, LCount^.Count());
  LShape := nil;
  LSqP := ptr to TSquare(LShape);
  LPrint := ptr to IPrintable(LShape);
  LBaseP := nil;
  LSqP := ptr to TSquare(LBaseP);
  println("nil {} {} {}", LSqP = nil, LPrint = nil, ptr to IPrintable(LBaseP) = nil);
end;

begin
  Run();
end.
