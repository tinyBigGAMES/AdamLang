-------------------------------------------------------------------------------
  obj_virtual.adam - virtual dispatch (M3.10d, BNF sec 4 object members): a
  polymorphic object's vptr names its type's vtable, one function per slot,
  and a virtual, override, final or abstract method is called through it.
  Dispatched: through a value, through self in an inherited method, through
  a ref of an ancestor holding a descendant (each level's own answer). Not
  dispatched: parent.M(), which runs the parent's own method. An override
  final closes Kind at TPuppy, whose Legs is TDog's slot inherited; an
  abstract Area gets its body in TSquare; Scaled (two arguments) and Corner
  (a record result through the hidden pointer) go through the vtable too.
  As in C++, an init and a done see their own level: TDog's object says
  "animal" while its TAnimal part is built and after its own done ran
  (asked through the plain KindNow: a virtual called through self in an
  init or a done is SM0348, BNF sec 4, as it would not dispatch). A
  polymorphic field (TKennel.Pet) and module variable (GPup) are built and
  ended with their holder; a ref of TAnimal holding a TDog or a TPuppy runs
  the whole chain of dones when it lets go.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | init animal animal
  | init dog dog
  | start
  | pip is a puppy
  | 4
  | init animal animal
  | init animal animal
  | init dog dog
  | generic is a animal
  | 0
  | rex is a dog
  | 4
  | values end
  | done dog dog
  | done animal animal
  | done animal animal
  | init animal animal
  | init dog dog
  | bit is a puppy
  | 4
  | kind puppy
  | init animal animal
  | init dog dog
  | done dog dog
  | done animal animal
  | max is a dog
  | 4
  | kind dog
  | done dog dog
  | done animal animal
  | 9
  | 19
  | 3
  | 4
  | refs end
  | init animal animal
  | init dog dog
  | fido is a dog
  | 4
  | holders end
  | done dog dog
  | done animal animal
  | end
  | done dog dog
  | done animal animal
  | [Heap] Allocs: 3, Frees: 3, Leaked: 0
@@end
*/

module exe obj_virtual;

func puts(const AText: ptr): int32; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

// AValue in decimal, one line
func ShowInt(const AValue: int64);
var
  LBuf: array[0..31] of char;
begin
  puts(_i64toa(AValue, addr of LBuf[0], 10));
end;

type
  // 16 bytes: a result of it comes back through the hidden pointer
  TPoint = record
    X: int64;
    Y: int64;
  end;

  TAnimal = object
    Name: string;

    init();
    begin
      self.Name := "?";
      println("init animal {}", self.KindNow());
    end;

    done;
    begin
      println("done animal {}", self.KindNow());
    end;

    virtual method Kind(): string;
    begin
      return "animal";
    end;

    virtual method Legs(): int64;
    begin
      return 0;
    end;

    // Kind asked through a plain method (an init or a done calls no virtual through self,
    // SM0348): it answers for the level the object is at
    method KindNow(): string;
    begin
      return self.Kind();
    end;

    // Its calls through self reach the object's own level
    method Describe();
    begin
      println("{} is a {}", self.Name, self.Kind());
      ShowInt(self.Legs());
    end;
  end;

  TDog = object(TAnimal)
    init();
    begin
      println("init dog {}", self.KindNow());
    end;

    done;
    begin
      println("done dog {}", self.KindNow());
    end;

    override method Kind(): string;
    begin
      return "dog";
    end;

    override method Legs(): int64;
    begin
      return parent.Legs() + 4;
    end;
  end;

  // A third level: Kind closed here, Legs is TDog's slot inherited
  TPuppy = object(TDog)
    override final method Kind(): string;
    begin
      return "puppy";
    end;
  end;

  TShape = object
    virtual method Area(): int64; abstract;

    virtual method Scaled(const AFactor: int64; const AOffset: int64): int64;
    begin
      return self.Area() * AFactor + AOffset;
    end;

    virtual method Corner(): TPoint;
    var
      LP: TPoint;
    begin
      LP.X := 0;
      LP.Y := 0;
      return LP;
    end;
  end;

  TSquare = object(TShape)
    Side: int64;

    override method Area(): int64;
    begin
      return self.Side * self.Side;
    end;

    override method Corner(): TPoint;
    var
      LP: TPoint;
    begin
      LP.X := self.Side;
      LP.Y := self.Side + 1;
      return LP;
    end;
  end;

  // A plain object holding a polymorphic one: built and ended with it
  TKennel = object
    Pet: TDog;
  end;

var
  GPup: TPuppy;

func Show(const AAnimal: ref TAnimal);
begin
  AAnimal.Describe();
  println("kind {}", AAnimal.Kind());
end;

func Values();
var
  LA: TAnimal;
  LD: TDog;
begin
  LA.Name := "generic";
  LD.Name := "rex";
  LA.Describe();
  LD.Describe();
  println("values end");
end;

func Refs();
var
  LR: ref TAnimal;
  LS: ref TShape;
  LQ: ref TSquare;
  LP: TPoint;
begin
  LR := ref TPuppy;
  LR.Name := "bit";
  Show(LR);
  LR := ref TDog;
  LR.Name := "max";
  Show(LR);
  LR := nil;
  LQ := ref TSquare;
  LQ.Side := 3;
  LS := LQ;
  LQ := nil;
  ShowInt(LS.Area());
  ShowInt(LS.Scaled(2, 1));
  LP := LS.Corner();
  ShowInt(LP.X);
  ShowInt(LP.Y);
  println("refs end");
end;

func Holders();
var
  LK: TKennel;
begin
  LK.Pet.Name := "fido";
  LK.Pet.Describe();
  println("holders end");
end;

begin
  println("start");
  GPup.Name := "pip";
  GPup.Describe();
  Values();
  Refs();
  Holders();
  println("end");
end.
