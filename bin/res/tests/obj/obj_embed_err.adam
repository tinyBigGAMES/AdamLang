  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  obj_embed_err.adam - Break step of obj_embed_deep (M3.10f, BNF sec 4
  embed decl). Every level of an object's chain is one depth: a name an
  own-level and a parent-level embed both hold is SM0370, as is a name two
  embeds of embeds hold at one depth (two embeds of one type included); the
  message names both paths. A hidden embed is reached where a hidden field
  is (SM0019 outside its type's methods), at any depth; an embedded type's
  hidden members stay hidden. An embed holds a record, an overlay or an
  object (SM0369). A path named in full, a nearer depth, and a hidden embed
  reached from its own type's method are fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_embed_err;

type
  TA = record
    X: int64;
    Only: int64;
  end;

  TB = record
    X: int64;
  end;

  TParentLevel = object
    embed A: TA;
  end;

  // A at the parent's level and B at its own: both depth 1
  TBoth = object(TParentLevel)
    embed B: TB;
  end;

  TWrapA = object
    embed A: TA;
  end;

  TWrapB = object
    embed B: TB;
  end;

  // X two embeds down through each wrap: both depth 2
  TDeep = object
    embed WA: TWrapA;
    embed WB: TWrapB;
  end;

  // Two embeds of one type: everything they hold is reached twice
  TTwice = object
    embed First: TWrapA;
    embed Second: TWrapA;
  end;

  THidden = object
    hidden embed Inner: TA;

    method Reach(): int64;
    begin
      return self.Only;
    end;
  end;

  // The hidden embed one level down
  THolder = object
    embed Held: THidden;
  end;

  TSecret = object
    hidden FValue: int64;
  end;

  TShowsSecret = object
    embed Secret: TSecret;
  end;

  TNumber = object
    embed N: int64; // ERROR SM0369@14: embed 'N' holds 'int64': an embed is a record, an overlay or an object, whose members its object reaches
  end;

routine Run();
var
  LBoth: TBoth;
  LDeep: TDeep;
  LTwice: TTwice;
  LHidden: THidden;
  LHolder: THolder;
  LShows: TShowsSecret;
  LN: int64;
begin
  LN := LBoth.X; // ERROR SM0370@9: 'X' is reached through two embeds, 'B' and 'A': name one, as LBoth.B.X
  LN := LBoth.A.X;
  LN := LBoth.Only;
  LN := LDeep.X; // ERROR SM0370@9: 'X' is reached through two embeds, 'WA.A' and 'WB.B': name one, as LDeep.WA.A.X
  LN := LDeep.WA.X;
  LN := LDeep.Only;
  LN := LTwice.Only; // ERROR SM0370@9: 'Only' is reached through two embeds, 'First.A' and 'Second.A': name one, as LTwice.First.A.Only
  LN := LTwice.Second.Only;
  LN := LHidden.Only; // ERROR SM0019@9: 'Inner' is hidden in 'THidden': only the methods of 'THidden' and of its descendants reach it
  LN := LHidden.Reach();
  LN := LHolder.Only; // ERROR SM0019@9: 'Inner' is hidden in 'THidden': only the methods of 'THidden' and of its descendants reach it
  LN := LHolder.Reach();
  LN := LShows.FValue; // ERROR SM0019@9: 'FValue' is hidden in 'TSecret': only the methods of 'TSecret' and of its descendants reach it
end;

begin
  Run();
end.
