-------------------------------------------------------------------------------
  obj_own.adam - own T (BNF sec 4 owner type): the sole owner of an object on
  the heap

  own T(...) builds the object (its init run); its fields and methods are
  reached through it; a field array goes as a var argument; a call's result
  and return of a local move it (no copy: SM0427); it converts to a ref of
  it; nil is no object. Its done runs exactly once, when its last owner
  ends: at a variable's scope end, at an assignment over it, at the ref it
  became.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | built 7
  | read 7
  | bumped 8
  | filled 3
  | done 8
  | made 41
  | done 41
  | done 5
  | moved 5
  | ref 9
  | done 9
  | over 1
  | done 1
  | over 2
  | held 3
  | done 3
  | nil true
  | done 2
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_own;

type
  Units = array[0..7] of uint16;

  TBox = object
    Value: int64;
    Data: Units;

    init(const AValue: int64);
    begin
      self.Value := AValue;
    end;

    done;
    begin
      println("done {}", self.Value);
    end;

    method Bump();
    begin
      self.Value := self.Value + 1;
    end;
  end;

  THolder = object
    Item: own TBox;
  end;

// Fills AUnits' first ACount units with 1 .. ACount, the count back (a var argument)
routine Fill(var AUnits: Units; const ACount: int64): int64;
var
  LI: int64;
begin
  for LI := 0 to ACount - 1 do
    AUnits[LI] := uint16(LI + 1);
  end;
  return ACount;
end;

// A local own, moved out by return
routine Make(const AValue: int64): own TBox;
var
  LBox: own TBox;
begin
  LBox := own TBox(AValue);
  println("made {}", LBox.Value);
  return LBox;
end;

// A value parameter takes the own a call moves into it
routine Take(ABox: own TBox): int64;
begin
  return ABox.Value;
end;

routine Run();
var
  LBox: own TBox;
  LMade: own TBox;
  LShared: ref TBox;
  LOver: own TBox;
  LTaken: int64;
  LHolder: own THolder;
begin
  LBox := own TBox(7);
  println("built {}", LBox.Value);
  println("read {}", LBox.Value);
  LBox.Bump();
  println("bumped {}", LBox.Value);
  println("filled {}", Fill(LBox.Data, 3) + int64(LBox.Data[2]) - 3);
  LBox := nil;
  LMade := Make(41);
  LMade := nil;
  // The parameter owns it: its done runs as Take ends, before the print
  LTaken := Take(own TBox(5));
  println("moved {}", LTaken);
  LShared := own TBox(9);
  println("ref {}", LShared.Value);
  LShared := nil;
  LOver := own TBox(1);
  println("over {}", LOver.Value);
  LOver := own TBox(2);
  println("over {}", LOver.Value);
  // An own field: its object ends with the object holding it
  LHolder := own THolder();
  LHolder.Item := own TBox(3);
  println("held {}", LHolder.Item.Value);
  LHolder := nil;
  println("nil {}", LBox = nil);
end;

begin
  Run();
  println("end");
end.
