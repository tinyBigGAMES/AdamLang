  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  obj_copy.adam - copy decls (M3.10g, BNF sec 4 O5): every copy of a value of
  a type with a copy decl runs it (an assignment from a place: the copy built,
  then the old value ended; a local's initializer; a value argument, ended by
  the callee; a result copied out of a module variable), never a move (a
  call's result, `return` of a local, an argument that is a call's result); a
  const parameter binds the value (no copy); `LA := LA` copies before the old
  value ends. A type with no copy decl that holds one copies part by part (a
  field by its type's copy, the rest as it is), its parent part by the
  parent's copy, a static array element by element; a copied polymorphic
  object keeps its own type's vptr. The order lines are the proof; ends
  counts every done, the [Heap] line shows nothing leaked.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | copy item 1
  | copy item 6
  | b 6
  | copy item 6
  | show 6
  | peek 5
  | copy item 6
  | a 6 c 1
  | copy ra'
  | done b0
  | b ra'
  | copy ra''
  | show ra''
  | done ra''
  | show r!
  | done r!
  | done ra'
  | b r!
  | copy ra'
  | done ra
  | a ra'
  | done r!
  | done ra'
  | copy rp'
  | done q0
  | q 3 rp' rn
  | done rp'
  | done rp
  | copy base 10
  | copy own 10 2
  | own 10 2
  | copy base 40
  | no 40 5
  | copy item 11
  | copy item 21
  | y 11 21
  | kid 101
  | copy rk'
  | copy rk'
  | done r0
  | r rk' s rk'
  | done rk'
  | done rk'
  | ends 13
  | done rk
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_copy;

var
  Ends: int64;

type
  // A copy decl and no done: every copy runs it (one more than its source)
  TItem = object
    V: int64;

    copy(const ASource: TItem);
    begin
      self.V := ASource.V + 1;
      println("copy item {}", self.V);
    end;
  end;

  // A copy, a done and a text: each copy runs once, each value ends once
  TRes = object
    Tag: string;

    copy(const ASource: TRes);
    begin
      self.Tag := ASource.Tag + "'";
      println("copy {}", self.Tag);
    end;

    done;
    begin
      Ends := Ends + 1;
      println("done {}", self.Tag);
    end;
  end;

  // No copy decl: copied part by part (Res by its copy, N and Name as they are)
  TPair = object
    N: int64;
    Res: TRes;
    Name: string;
  end;

  // A parent with a copy: its part is copied by it in both descendants
  TBase = object
    B: int64;

    copy(const ASource: TBase);
    begin
      self.B := ASource.B * 10;
      println("copy base {}", self.B);
    end;
  end;

  TOwnCopy = object(TBase)
    C: int64;

    copy(const ASource: TOwnCopy);
    begin
      // the parent part is copied before the body runs
      println("copy own {} {}", self.B, ASource.C);
      self.C := ASource.C;
    end;
  end;

  TNoCopy = object(TBase)
    D: int64;
  end;

  // A polymorphic copy: a descendant with none keeps its own vptr
  TPoly = object
    P: int64;

    copy(const ASource: TPoly);
    begin
      self.P := ASource.P + 100;
    end;

    virtual method Kind(): string;
    begin
      return "poly";
    end;
  end;

  TKid = object(TPoly)
    override method Kind(): string;
    begin
      return "kid";
    end;
  end;

var
  Kept: TRes;

func ShowItem(AItem: TItem);
begin
  println("show {}", AItem.V);
end;

func Peek(const AItem: TItem);
begin
  println("peek {}", AItem.V);
end;

func ShowRes(ARes: TRes);
begin
  println("show {}", ARes.Tag);
end;

func MakeRes(const ATag: string): TRes;
var
  LRes: TRes;
begin
  LRes.Tag := ATag + "!";
  return LRes;
end;

func KeptCopy(): TRes;
begin
  return Kept;
end;

func SetKept(const ATag: string);
begin
  Kept.Tag := ATag + "k";
end;

func Items();
var
  LA: TItem;
  LB: TItem;
  LC: TItem = LA;
begin
  LA.V := 5;
  LB := LA;
  println("b {}", LB.V);
  ShowItem(LA);
  Peek(LA);
  LA := LA;
  println("a {} c {}", LA.V, LC.V);
end;

func Resources(const ATag: string);
var
  LA: TRes;
  LB: TRes;
begin
  LA.Tag := ATag + "a";
  LB.Tag := "b0";
  LB := LA;
  println("b {}", LB.Tag);
  ShowRes(LB);
  ShowRes(MakeRes(ATag));
  LB := MakeRes(ATag);
  println("b {}", LB.Tag);
  LA := LA;
  println("a {}", LA.Tag);
end;

func Pairs(const ATag: string);
var
  LP: TPair;
  LQ: TPair;
begin
  LP.N := 3;
  LP.Res.Tag := ATag + "p";
  LP.Name := ATag + "n";
  LQ.Res.Tag := "q0";
  LQ := LP;
  println("q {} {} {}", LQ.N, LQ.Res.Tag, LQ.Name);
end;

func Bases();
var
  LO: TOwnCopy;
  LP: TOwnCopy;
  LN: TNoCopy;
  LM: TNoCopy;
begin
  LO.B := 1;
  LO.C := 2;
  LP := LO;
  println("own {} {}", LP.B, LP.C);
  LN.B := 4;
  LN.D := 5;
  LM := LN;
  println("no {} {}", LM.B, LM.D);
end;

func Arrays();
var
  LX: array[0..1] of TItem;
  LY: array[0..1] of TItem;
begin
  LX[0].V := 10;
  LX[1].V := 20;
  LY := LX;
  println("y {} {}", LY[0].V, LY[1].V);
end;

func Polys();
var
  LK: TKid;
  LL: TKid;
begin
  LK.P := 1;
  LL := LK;
  println("{} {}", LL.Kind(), LL.P);
end;

func Results();
var
  LS: TRes = Kept;
  LR: TRes;
begin
  LR.Tag := "r0";
  LR := KeptCopy();
  println("r {} s {}", LR.Tag, LS.Tag);
end;

begin
  Ends := 0;
  Items();
  Resources("r");
  Pairs("r");
  Bases();
  Arrays();
  Polys();
  SetKept("r");
  Results();
  println("ends {}", Ends);
end.
