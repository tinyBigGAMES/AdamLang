-------------------------------------------------------------------------------
  obj_is_as.adam - `is` and `as` (I1, BNF sec 6 O12): the dynamic type
  through RTTI, one TypeInfo per type its unit defines (the fixture unit
  IsAsShapes declares TThing, TShape, TCircle; this one TSquare and
  TTile below them). `X is T` on a const parameter, a var parameter, self,
  a ptr (nil is never a T), a ref and an own; a plain (non-polymorphic) root
  type in the chain; `X as T` of an object (a place: a field written
  through it, a method run on it), of a ptr (nil stays nil), of a ref (its
  object kept by the ref it lands in) and of an own (its object). The
  [Heap] line counts every block, all freed.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | circle true
  | square false
  | shape true
  | thing true
  | tile square true
  | self square true
  | var tile true
  | ptr true false
  | nil false
  | ref true false
  | own true
  | area 48
  | side 9
  | radius 5
  | nil stays nil
  | ref area 12
  | own area 75
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_is_as;

@addmodulepath "$P:res/tests/obj/fixtures";

import IsAsShapes;

type
  TSquare = object(TShape)
    Side: int64;

    override const method Area(): int64;
    begin
      return self.Side * self.Side;
    end;

    const method SelfIsSquare(): bool;
    begin
      return self is TSquare;
    end;
  end;

  TTile = object(TSquare)
    Colour: int64;
  end;

  PShape = ptr to TShape;
  PCircle = ptr to TCircle;

routine Kinds(const AShape: TShape);
begin
  println("circle {}", AShape is TCircle);
  println("square {}", AShape is TSquare);
  println("shape {}", AShape is TShape);
  println("thing {}", AShape is TThing);
end;

routine TileKind(const AShape: TShape);
begin
  println("tile square {}", AShape is TSquare);
end;

routine Grow(var AShape: TShape);
begin
  println("var tile {}", AShape is TTile);
  (AShape as TSquare).Side := 3;
end;

routine Run();
var
  LCircle: TCircle;
  LTile: TTile;
  LPtr: PShape;
  LNil: PShape;
  LAsPtr: PCircle;
  LRef: ref TShape;
  LKept: ref TCircle;
  LOwn: own TShape;
begin
  LCircle.Radius := 4;
  Kinds(LCircle);
  TileKind(LTile);
  println("self square {}", LTile.SelfIsSquare());
  Grow(LTile);
  LPtr := addr of LCircle;
  LNil := nil;
  println("ptr {} {}", LPtr is TCircle, LPtr is TSquare);
  println("nil {}", LNil is TShape);
  LRef := MakeCircle(2);
  println("ref {} {}", LRef is TCircle, LRef is TSquare);
  LOwn := own TCircle();
  println("own {}", LOwn is TCircle);
  println("area {}", (LPtr as TCircle)->Area());
  println("side {}", (LTile as TSquare).Area());
  (LPtr as TCircle)->Radius := 5;
  println("radius {}", LCircle.Radius);
  LAsPtr := LNil as TCircle;
  if LAsPtr = nil then
    println("nil stays nil");
  end;
  LKept := LRef as TCircle;
  LRef := nil;
  println("ref area {}", LKept.Area());
  (LOwn as TCircle).Radius := 5;
  println("own area {}", (LOwn as TCircle).Area());
  println("end");
end;

begin
  Run();
end.
