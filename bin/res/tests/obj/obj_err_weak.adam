-------------------------------------------------------------------------------
  obj_err_weak.adam - Break step of obj_own_held (M3.10g, BNF sec 7):
  alive(W) and lock(W) take one weak (SM0409: a ref, an int, no argument, two
  arguments); a weak's object is reached through lock (SM0360). alive of a
  weak and lock of a weak are fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_weak;

type
  TItem = object
    V: int64;
  end;

routine Tests(const AR: ref TItem; const AW: weak TItem);
var
  LOk: bool;
  LN: int64;
  LR: ref TItem;
begin
  LOk := alive(AR); // ERROR SM0409@16: 'alive' takes (weak)
  LOk := alive(LN); // ERROR SM0409@16: 'alive' takes (weak)
  LOk := alive(); // ERROR SM0409@10: 'alive' takes (weak)
  LR := lock(AW, AW); // ERROR SM0409@9: 'lock' takes (weak)
  LR := lock(AR); // ERROR SM0409@14: 'lock' takes (weak)
  LN := AW.V; // ERROR SM0360@9: 'AW.V': a weak may watch an object that is gone: read it through lock(AW), which is nil then
  LOk := alive(AW);
  LR := lock(AW);
end;

begin
end.
