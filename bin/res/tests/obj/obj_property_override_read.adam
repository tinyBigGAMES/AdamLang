-------------------------------------------------------------------------------
  obj_property_override_read.adam - an override property may restate its
  read only (BNF sec 4 property decl): the base's write runs for it,
  through the object itself, a var parameter of the base type
  (dispatched), and an interface whose property has a write; a level below
  may give its own write again (TCube), and that one runs
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | [sq]
  | [ab]
  | base ab
  | [x] x
  | [cd]
  | 10 [y]
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_property_override_read;

type
  INamed = interface
    property Name: string read; write;
  end;
  TShape = object implements INamed
    FName: string;
    virtual property Name: string read FName; write FName;
  end;
  TSquare = object(TShape)
    override property Name: string read
      begin
        return "[" + self.FName + "]";
      end;
  end;
  TCube = object(TSquare)
    FWrites: int32;
    override property Name: string read
      begin
        return "[" + self.FName + "]";
      end;
      write(AValue)
      begin
        self.FWrites += 5;
        self.FName := AValue;
      end;
  end;

routine Rename(var AShape: TShape; const AName: string);
begin
  AShape.Name := AName;
end;

routine Through(var AName: INamed; const AName2: string);
begin
  AName.Name := AName2;
  println("{} {}", AName.Name, AName2);
end;

routine Run();
var
  LSq: TSquare;
  LCube: TCube;
begin
  LSq.Name := "sq";
  println("{}", LSq.Name);
  LSq.Name := "ab";
  println("{}", LSq.Name);
  Rename(LSq, "ab");
  println("base {}", LSq.FName);
  Through(LSq, "x");
  Rename(LCube, "cd");
  println("{}", LCube.Name);
  LCube.Name := "y";
  println("{} {}", LCube.FWrites, LCube.Name);
end;

begin
  Run();
end.
