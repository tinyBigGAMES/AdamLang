-------------------------------------------------------------------------------
  obj_ref_temp.adam - a temporary ends with its full expression, as C++ ends
  it (pcpp's truth, its oracle the same body): a ref made in place for an
  argument is done before what follows it runs, in an expression statement,
  an if condition (before the branch), a while condition (on every pass,
  before the body), a repeat's until condition, a for's bounds (once both
  are stored), a local's initializer, an assignment's source, and each time
  a loop runs its statement again. A ref a variable takes lives on until the
  variable lets it go; a record result's string ends with its statement.
  Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | stmt
  | done stmt
  | after stmt
  | done cond
  | in then
  | done w
  | body 0
  | done w
  | body 1
  | done w
  | repeat body
  | done r
  | done f
  | for 1
  | done init
  | first init
  | done assign
  | assign?
  | loop
  | done loop
  | loop
  | done loop
  | pair! 2
  | kept
  | done kept
  | end
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_ref_temp;

type
  TNote = object
    Text: string;

    init(const AText: string);
    begin
      self.Text := AText;
    end;

    done;
    begin
      println("done {}", self.Text);
    end;
  end;

  TPair = record
    Name: string;
    Size: int32;
  end;

// The note's text (the argument is borrowed: the caller's temporary keeps it)
routine TextOf(const ANote: ref TNote): string;
begin
  return ANote.Text;
end;

// A record holding a string, returned by value (its result a temporary)
routine MakePair(const AName: string): TPair;
var
  LPair: TPair;
begin
  LPair.Name := AName + "!";
  LPair.Size := 2;
  return LPair;
end;

// A local's initializer is a full expression of its own
routine Initialized();
var
  LText: string = TextOf(ref TNote("init"));
begin
  println("first {}", LText);
end;

routine Run();
var
  LI: int32;
  LText: string;
  LKept: ref TNote;
begin
  // an expression statement
  println("{}", TextOf(ref TNote("stmt")));
  println("after stmt");

  // an if condition: ended before the branch runs
  if TextOf(ref TNote("cond")) = "cond" then
    println("in then");
  end;

  // a while condition: ended on every pass, before the body
  LI := 0;
  while (TextOf(ref TNote("w")) = "w") and (LI < 2) do
    println("body {}", LI);
    LI := LI + 1;
  end;

  // a repeat's until condition
  repeat
    println("repeat body");
  until TextOf(ref TNote("r")) = "r";

  // the for bounds: ended once both are stored
  for LI := 1 to int32(len(TextOf(ref TNote("f")))) do
    println("for {}", LI);
  end;

  // a local initializer
  Initialized();

  // an assignment, and the same statement run twice
  LText := TextOf(ref TNote("assign")) + "?";
  println("{}", LText);
  for LI := 1 to 2 do
    println("{}", TextOf(ref TNote("loop")));
  end;

  // a ref taken by a variable lives on; a record result's string ends with its statement
  LKept := ref TNote("kept");
  println("{} {}", MakePair("pair").Name, MakePair("pair").Size);
  println("{}", TextOf(LKept));
  LKept := nil;
  println("end");
end;

begin
  Run();
end.
