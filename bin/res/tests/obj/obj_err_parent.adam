-------------------------------------------------------------------------------
  obj_err_parent.adam - a parent of the wrong kind (BNF sec 4, SM0308):
  an object's parent is an object, never a scalar alias, a record or a
  choices (no crash laying it out); a record's parent is a record, never
  a scalar alias, a choices or an object; a right parent is clean
*******************************************************************************/

module exe obj_err_parent;

/*
@@test
  kind error
@@end
*/

type
  TCount = int32;
  TColor = choices(Red, Green);
  TRec = record
    Z: int32;
  end;
  TObj = object
    W: int32;
  end;
  TO1 = object(TCount) // ERROR SM0308@16: 'int32' is no object type: an object's parent is an object
    X: int32;
  end;
  TO2 = object(TRec) // ERROR SM0308@16: 'TRec' is no object type: an object's parent is an object
    X: int32;
  end;
  TO3 = object(TColor) // ERROR SM0308@16: 'TColor' is no object type: an object's parent is an object
    X: int32;
  end;
  TR1 = record(TCount) // ERROR SM0308@16: 'int32' is no record type: a record's parent is a record
    X: int32;
  end;
  TR2 = record(TColor) // ERROR SM0308@16: 'TColor' is no record type: a record's parent is a record
    X: int32;
  end;
  TR3 = record(TObj) // ERROR SM0308@16: 'TObj' is no record type: a record's parent is a record
    X: int32;
  end;
  TGood = object(TObj)
    X: int32;
  end;
  TGoodRec = record(TRec)
    X: int32;
  end;

begin
end.
