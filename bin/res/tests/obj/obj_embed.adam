-------------------------------------------------------------------------------
  obj_embed.adam - Embeds (PLAN-SELFHOST S1): an embed is a field, built,
  copied and freed as one. The embed named itself (`self.Place := APlace`,
  X.Place.F); its members reached as the object's own: a bound property, a
  property read through its accessor, a const method, a method that changes
  the embed, a record embed's fields read and written; through self, a ptr
  (P->M) and a ref; an embed declared at the parent's level; a polymorphic
  embed whose method dispatches, `parent.M()` of an embed's M dispatching
  as any E.M() does; an object with an embed holding a text copied (stays
  independent), and refs to such objects kept in a dynamic array. The [Heap]
  line counts every block, all freed. Values are shown through ucrtbase
  (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | a.adam a.adam
  | 1207
  | 24
  | 15
  | 5
  | none
  | 1516
  | a.adam
  | 20
  | 21
  | 26
  | 43
  | 4
  | n.adam n.adam
  | 63
  | 105
  | 105105
  | 5
  | 12
  | a.adam
  | 1303
  | end
  | [Heap] Allocs: 3, Frees: 3, Leaked: 0
@@end
*/

module exe obj_embed;

routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  // A place: a file and a line (built empty: no place)
  TPlace = object
    hidden FFile: string;
    hidden FLine: int32;

    init();
    begin
      self.FFile := "";
      self.FLine := 0;
    end;

    init(const AFile: string; const ALine: int32);
    begin
      self.FFile := AFile;
      self.FLine := ALine;
    end;

    property FileName: string read FFile;
    property Line: int32 read FLine;

    // Read through its accessor (no bound field)
    property Twice: int32
      read
      begin
        return self.FLine * 2;
      end;

    const method IsNone(): bool;
    begin
      return self.FFile = "";
    end;

    method Move(const ABy: int32);
    begin
      self.FLine := self.FLine + ABy;
    end;
  end;

  TSpan = record
    Start: int64;
    Stop: int64;
  end;

  // Two embeds: an object holding a text and a record
  TDiag = object
    Code: int32;
    embed Place: TPlace;
    embed Span: TSpan;

    init();
    begin
      self.Code := 0;
    end;

    init(const ACode: int32; const APlace: TPlace);
    begin
      self.Code := ACode;
      self.Place := APlace;
    end;

    // self.X of an embed's X
    const method Where(): string;
    begin
      return self.FileName;
    end;
  end;

  // An embed at the parent's level
  TNote = object(TDiag)
    Extra: int32;

    const method Report(): int64;
    begin
      return int64(self.Line) * 10 + int64(self.Extra);
    end;
  end;

  // A polymorphic embedded type
  TVoice = object
    Level: int64;

    virtual method Speak(): int64;
    begin
      return 100 + self.Level;
    end;
  end;

  THolder = object
    Tag: int64;
    embed Voice: TVoice;
  end;

  THolderKid = object(THolder)
    // parent.Speak() is the embed's Speak (parent.Voice.Speak()): it dispatches
    method Ask(): int64;
    begin
      return parent.Speak() * 1000 + self.Speak();
    end;
  end;

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
var
  LBuf: array[0..31] of char;
begin
  puts(_i64toa(AValue, addr of LBuf[0], 10));
end;

// The embed named itself and its members reached as the object's own: on a
// value, a copy, through a ptr and a ref
routine Diags();
var
  LPlace: TPlace("a.adam", 12);
  LD: TDiag(7, LPlace);
  LE: TDiag;
  LP: ptr to TDiag;
  LR: ref TDiag;
begin
  println("{} {}", LD.FileName, LD.Place.FileName);
  ShowInt(LD.Line * 100 + LD.Code);
  ShowInt(LD.Twice);
  LD.Move(3);
  ShowInt(LD.Line);
  LD.Start := 4;
  LD.Stop := 9;
  ShowInt(LD.Span.Stop - LD.Start);
  if LE.IsNone() then
    println("none");
  end;
  LE := LD;
  LE.Move(1);
  ShowInt(LD.Line * 100 + LE.Line);
  println("{}", LE.Where());
  LP := addr of LD;
  LP->Move(5);
  ShowInt(LP->Line);
  LR := ref TDiag(9, LPlace);
  ShowInt(LR.Line + LR.Code);
  LR.Move(1);
  ShowInt(LR.Twice);
end;

// An embed declared at the parent's level
routine Notes();
var
  LPlace: TPlace("n.adam", 4);
  LN: TNote;
begin
  LN.Place := LPlace;
  LN.Extra := 3;
  ShowInt(LN.Report());
  ShowInt(LN.Line);
  LN.Move(2);
  println("{} {}", LN.Where(), LN.FileName);
  ShowInt(LN.Report());
end;

// A polymorphic embed: its method dispatches, from the object and from parent
routine Voices();
var
  LK: THolderKid;
begin
  LK.Level := 5;
  ShowInt(LK.Speak());
  ShowInt(LK.Ask());
  ShowInt(LK.Voice.Level);
end;

// Refs to objects with an embed kept in a dynamic array (as Diagnostics keeps them)
routine Arrays();
var
  LPlace: TPlace("a.adam", 12);
  LA: array of ref TDiag;
begin
  setlength(LA, 2);
  LA[1] := ref TDiag(3, LPlace);
  ShowInt(LA[1].Line);
  println("{}", LA[1].FileName);
  LA[1].Move(1);
  ShowInt(LA[1].Line * 100 + LA[1].Code);
end;

routine Run();
begin
  Diags();
  Notes();
  Voices();
  Arrays();
  println("end");
end;

begin
  Run();
end.
