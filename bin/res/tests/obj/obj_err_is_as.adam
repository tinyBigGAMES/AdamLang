-------------------------------------------------------------------------------
  obj_err_is_as.adam - Break step of obj_is_as (I1, BNF sec 6 O12). X is a
  polymorphic object or a ptr / own / ref of one (SM0271: a plain object, a
  record, an int); T is an object or an interface type (SM0272); a weak is
  tested after lock (SM0275); a test no object passes is an error: two
  branches of one chain, a final type that is no T (SM0273), and a value
  that holds exactly its declared type (SM0274: a local, a field, a call's
  result). `X as T` of a const X is const (SM0255). A const parameter, a
  ptr, a ref, self, an upcast and `X as T` itself are fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_is_as;

type
  TPlain = object
    N: int64;
  end;

  TRec = record
    N: int64;
  end;

  TBase = object
    virtual method Go();
    begin
    end;
  end;

  TLeft = object(TBase)
    N: int64;
  end;

  TRight = object(TBase)
  end;

  TEnd = final object(TBase)
  end;

  THolder = object
    Base: TBase;
  end;

routine MakeBase(): TBase;
var
  LB: TBase;
begin
  return LB;
end;

routine Tests(const ABase: TBase; const ALeft: TLeft; const AEnd: TEnd; const AP: ptr to TBase;
  const AR: ref TBase; const AW: weak TBase);
var
  LPlain: TPlain;
  LRec: TRec;
  LN: int64;
  LBase: TBase;
  LHolder: THolder;
  LOk: bool;
begin
  LOk := LPlain is TBase; // ERROR SM0271@10: 'LPlain' tests a polymorphic object (one with a virtual method) or a ptr to, own or ref of one; 'LPlain' is 'TPlain'
  LOk := LRec is TBase; // ERROR SM0271@10: 'LRec' tests a polymorphic object (one with a virtual method) or a ptr to, own or ref of one; 'LRec' is 'TRec'
  LOk := LN is TBase; // ERROR SM0271@10: 'LN' tests a polymorphic object (one with a virtual method) or a ptr to, own or ref of one; 'LN' is 'int64'
  LOk := ABase is TRec; // ERROR SM0272@19: 'is TRec': 'TRec' is not an object or an interface type
  LOk := ABase is int64; // ERROR SM0272@19: 'is int64': 'int64' is not an object or an interface type
  LOk := AW is TLeft; // ERROR SM0275@10: 'AW' is a weak: test lock(AW) instead
  LOk := ALeft is TRight; // ERROR SM0273@10: 'ALeft is TRight' never holds: a 'TLeft' is never a 'TRight'
  LOk := AEnd is TLeft; // ERROR SM0273@10: 'AEnd is TLeft' never holds: a 'TEnd' is never a 'TLeft'
  LOk := LBase is TLeft; // ERROR SM0274@10: 'LBase' holds exactly a 'TBase', never a 'TLeft': only a var or const parameter, a deref, self, or a ptr, own or ref may hold a descendant
  LOk := LHolder.Base is TLeft; // ERROR SM0274@10: 'LHolder.Base' holds exactly a 'TBase', never a 'TLeft': only a var or const parameter, a deref, self, or a ptr, own or ref may hold a descendant
  LOk := MakeBase() is TLeft; // ERROR SM0274@10: 'MakeBase()' holds exactly a 'TBase', never a 'TLeft': only a var or const parameter, a deref, self, or a ptr, own or ref may hold a descendant
  LOk := ABase is TLeft;
  LOk := AP is TLeft;
  LOk := AR is TRight;
  LOk := ALeft is TBase;
  LOk := (ABase as TLeft) is TLeft;
  (ABase as TLeft).N := 1; // ERROR SM0255@3: '(ABase as TLeft).N' cannot be assigned
end;

begin
end.
