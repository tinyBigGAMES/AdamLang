-------------------------------------------------------------------------------
  obj_member_names.adam - what the AUD4 5.1 checks still allow (BNF sec 3 / 4): a
  method reusing a parent method's name (overriding a virtual one, hiding a
  plain one) and a property a parent property's; inits overloading; a record
  whose operator, an object whose field and methods name their own type, a
  record behind `forward type`; parent.<member>; a const method through a
  const object; a polymorphic object passed on var / const; a final object
  and a variable copied whole; ++ on a property (C#'s rule).
*******************************************************************************/

/*
@@test
  kind check
@@end
*/

module exe obj_member_names;

type
  TA = object
    X: int32;
    FP: int32;
    init();
    begin
      self.X := 0;
    end;
    init(const AX: int32);
    begin
      self.X := AX;
    end;
    virtual method Show();
    begin
    end;
    method Plain(): int32;
    begin
      return 1;
    end;
    const method Peek(): int32;
    begin
      return self.X;
    end;
    property P: int32 read FP; write FP;
  end;
  TB = object(TA)
    FQ: int32;
    Next: ptr to TB;
    override method Show();
    begin
      parent.Show();
      self.X := parent.Plain();
    end;
    method Plain(): int32;
    begin
      return 2;
    end;
    method Same(const AOther: TB): bool;
    begin
      return self.X = AOther.X;
    end;
  end;
  TVec = record
    X: int64;
    operator +(const A: TVec; const B: TVec): TVec;
    var
      LR: TVec;
    begin
      LR.X := A.X + B.X;
      return LR;
    end;
  end;
  TF = final object(TA)
  end;

forward type TNode;
type
  TNode = record
    Value: int32;
    Next: ptr to TNode;
  end;

routine Look(const AA: TA): int32;
begin
  return AA.Peek();
end;

routine PassOn(var AA: TA): int32;
begin
  return Look(AA);
end;

routine CopyFinal(const AF: TF): TF;
begin
  return AF;
end;

routine Main();
var
  LA: TA;
  LB: TA;
  LF: TF;
begin
  LB := LA;
  LF := CopyFinal(LF);
  LA.P++;
  LA.P += PassOn(LA);
end;

begin
  Main();
end.
