-------------------------------------------------------------------------------
  obj_array_lifetime.adam - static arrays of objects that are built or ended
  (M3.10g): a local array is built element by element from the first (each
  element's init, a polymorphic element's vptr set: its virtual method runs
  its own type's) and ended from the last at the routine's exit; an array
  field of an object is built and ended with its parts; a nested array
  (array of arrays) walks every element; a ref's object holding an array
  field ends it with the ref's last holder; a module variable array is built
  at the entry and ended after the program block. The order lines are the
  proof; the [Heap] line shows nothing leaked.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | init 1
  | init 2
  | main
  | init 1
  | init 2
  | init 3
  | init 4
  | init 5
  | init 6
  | init 7
  | kind cell
  | kind cell
  | grid 7
  | done 7
  | done 6
  | done 5
  | done 4
  | done 3
  | done 2
  | done 1
  | init 1
  | init 2
  | init box
  | done box
  | done 2
  | done 1
  | init 1
  | init 2
  | init box
  | box 2
  | done box
  | done 2
  | done 1
  | end
  | done 2
  | done 1
  | [Heap] Allocs: 1, Frees: 1, Leaked: 0
@@end
*/

module exe obj_array_lifetime;

var
  Counter: int64;

type
  TShape = object
    virtual method Kind(): string;
    begin
      return "shape";
    end;
  end;

  // A polymorphic element: its vptr is its own type's once built
  TCell = object(TShape)
    Id: int64;

    init();
    begin
      Counter := Counter + 1;
      self.Id := Counter;
      println("init {}", self.Id);
    end;

    done;
    begin
      println("done {}", self.Id);
    end;

    override method Kind(): string;
    begin
      return "cell";
    end;
  end;

  // An array field: built after the parent part, ended before the box's done returns
  TBox = object
    Cells: array[0..1] of TCell;

    init();
    begin
      println("init box");
    end;

    done;
    begin
      println("done box");
    end;
  end;

var
  Kept: array[0..1] of TCell;

func Locals();
var
  LCells: array[0..2] of TCell;
  LGrid: array[0..1] of array[0..1] of TCell;
begin
  println("kind {}", LCells[0].Kind());
  println("kind {}", LCells[2].Kind());
  println("grid {}", LGrid[1][1].Id);
end;

func Field();
var
  LBox: TBox;
begin
end;

func Held();
var
  LBox: ref TBox;
begin
  LBox := ref TBox();
  println("box {}", LBox.Cells[1].Id);
end;

begin
  println("main");
  Counter := 0;
  Locals();
  Counter := 0;
  Field();
  Counter := 0;
  Held();
  println("end");
end.
