-------------------------------------------------------------------------------
  obj_ref_object.adam - ref objects (BNF sec 4, F2a0): a `ref object` lives
  only in a ref block, reached through ref / own / weak values; a descendant
  of one is one without the word, a plain object may be a ref object's
  parent; its methods, init and done run as any object's; a const parameter
  of the ref object's own type takes the object through a ref; refs of it in
  an array and a field. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | base 1
  | shape 2 area 6
  | shape 2 area 6
  | owned 5
  | done 5
  | alive true
  | named 3
  | done 3
  | alive false
  | sum 10
  | done 4
  | done 6
  | done 1
  | done 2
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_ref_object;

type
  // a plain object as a ref object's parent
  Named = object
    Id: int64;

    const method Show();
    begin
      println("named {}", self.Id);
    end;
  end;

  Shape = ref object(Named)
    W: int64;
    H: int64;

    init(const AId: int64; const AW: int64; const AH: int64);
    begin
      self.Id := AId;
      self.W := AW;
      self.H := AH;
    end;

    done;
    begin
      println("done {}", self.Id);
    end;

    const method Area(): int64;
    begin
      return self.W * self.H;
    end;
  end;

  // a descendant of a ref object is one (the word not repeated)
  Square = object(Shape)
    init(const AId: int64; const AS: int64);
    begin
      parent.init(AId, AS, AS);
    end;
  end;

  Board = object
    Pieces: array[0..1] of ref Shape;
  end;

func Report(const AShape: ref Shape);
begin
  println("shape {} area {}", AShape.Id, AShape.Area());
end;

var
  LBase: ref Shape;
  LCopy: ref Shape;
  LOwned: own Shape;
  LWatch: weak Shape;
  LBoard: ref Board;
  LSquare: ref Square;

begin
  LBase := ref Shape(1, 1, 1);
  println("base {}", LBase.Area());
  LCopy := ref Shape(2, 2, 3);
  Report(LCopy);
  Report(LCopy);
  LOwned := own Shape(5, 1, 1);
  println("owned {}", LOwned.Id);
  LOwned := nil;
  LSquare := ref Square(3, 2);
  LWatch := LSquare;
  println("alive {}", alive(LWatch));
  LSquare.Show();
  LSquare := nil;
  println("alive {}", alive(LWatch));
  LBoard := ref Board();
  LBoard.Pieces[0] := ref Shape(4, 2, 2);
  LBoard.Pieces[1] := ref Shape(6, 3, 2);
  println("sum {}", LBoard.Pieces[0].Area() + LBoard.Pieces[1].Area());
  LBoard := nil;
  LBase := nil;
  LCopy := nil;
  println("end");
end.
