-------------------------------------------------------------------------------
  obj_err_extend.adam - break step of obj_extend (BNF sec 3, F1): an extend's
  target must be a record, object, overlay or choices type (SM0748), a
  generic one named with its type arguments (SM0735); it takes methods and
  operators only, no field, init, property, virtual word or hidden member
  (SM0749); a name its target has is SM0750; one name added by two extends
  of a module is SM0751 at the later one; a type parameter named twice is SM0752; a
  unit's private extend is not seen by its importer (SM0009).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_extend;

@addmodulepath "$P:res/tests/obj/fixtures";

import System.Collections, ExtendShapes;

type
  Pt = record
    X: int32;
  end;

  Num = int32;

extend Num // ERROR SM0748@8
  method A();
  begin
  end;
end;

extend List // ERROR SM0735@8
  method A();
  begin
  end;
end;

extend Map<K, K> // ERROR SM0752@15
  method A();
  begin
  end;
end;

extend Pt
  Y: int32; // ERROR SM0749@3

  init(); // ERROR SM0749@3
  begin
  end;

  virtual method V(); // ERROR SM0749@3
  begin
  end;

  method X(); // ERROR SM0750@3
  begin
  end;

  method Twice();
  begin
  end;
end;

extend Pt
  method Twice(); // ERROR SM0751@3
  begin
  end;
end;

var
  GP: Pt;
  GBox: Box;

begin
  GP.Twice();
  println("{}", GBox.Secret()); // ERROR SM0009@22
end.
