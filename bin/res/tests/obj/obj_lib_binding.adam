-------------------------------------------------------------------------------
  obj_lib_binding.adam - a lib build writes its binding unit (PLAN-ADAM MO1b0 d):
  lib_binding_lib.adam in the output folder's lib\x86_64-windows-gnu\debug\
  beside its C header, read back here line by line ('>' before each), and
  imported here in place of writing the lib's declarations out again: its
  constants, types, variables, routines and its external object type used;
  the lib's initialize / finalize run beside the binding unit of the same
  name (their machinery symbols keyed apart: MO1b0 d1)
*******************************************************************************/

/*
@@test
  kind run
  deps exe.lib_binding_lib
  exitcode 0
  | >// lib_binding_lib.adam - the Adam binding of the Adam lib lib_binding_lib, written by adam: do not edit
  | >
  | >module unit lib_binding_lib;
  | >
  | >import System.SysUtils, System.Zlib.Ext;
  | >
  | >public const
  | >  LIMIT: int32 = 42;
  | >  LABEL_TEXT: string = "tab\there \"q\" \\ end\n";
  | >  RATIO: float64 = 1.5;
  | >  HALF: float32 = 0.5f;
  | >  WHOLE: float64 = 2.0;
  | >  FLAG: bool = true;
  | >  LETTER: char = 'A';
  | >  QUOTE_CHAR: char = '\'';
  | >  BIG: uint64 = 18446744073709551615u;
  | >  LOWEST: int64 = -9223372036854775807 - 1;
  | >
  | >public type
  | >  Color = choices(Red = 0, Green = 5, Blue = 6);
  | >  Colors = set of Color;
  | >  Point = record
  | >    X: int32;
  | >    Y: int32;
  | >  end;
  | >  Flags = record packed
  | >    A: uint8 : 3;
  | >    B: uint8 : 5;
  | >  end;
  | >  Tagged = record
  | >    Kind: int32;
  | >    u: overlay
  | >      I: int64;
  | >      F: float64;
  | >    end;
  | >  end;
  | >  Grid = array[0..3] of int32;
  | >  PointPtr = ptr to Point;
  | >  Combine = routine(const AX: int32; const AY: int32): int32;
  | >
  | >public const
  | >  ORIGIN: Point = Point(X: 1, Y: 2);
  | >  PRIMES: Grid = [2, 3, 5, 7];
  | >  WARM: Colors = [Color.Red, Color.Green];
  | >  DEFAULT_COLOR: Color = Color.Blue;
  | >
  | >public var
  | >  Greeting: string; external "lib_binding_lib";
  | >  Calls: int32; external "lib_binding_lib";
  | >
  | >public type
  | >  ICounter = interface
  | >    method Next(): int32;
  | >  end; external "lib_binding_lib";
  | >
  | >  Counter = object implements ICounter
  | >    hidden FValue: int32;
  | >    FStep: int32;
  | >    init(const AStart: int32);
  | >    done;
  | >    virtual method Next(): int32;
  | >    method Add(const AX: int32): int32;
  | >    method Add(const AX: int32; const AY: int32): int32;
  | >    property Value: int32 read FValue;
  | >    property Twice: int32 read; write(AValue);
  | >  end; external "lib_binding_lib";
  | >
  | >public routine Sum(const AX: int32; const AY: int32): int32; external "lib_binding_lib";
  | >public routine cpplink Scale(const AX: int64): int64; external "lib_binding_lib";
  | >public routine cpplink Scale(const AX: float64): float64; external "lib_binding_lib";
  | >public routine Apply(const AF: Combine; const AX: int32; const AY: int32): int32; external "lib_binding_lib";
  | >public routine Words(const AText: string): StringArray; external "lib_binding_lib";
  | >public routine FormatCode(const AFormat: ZlibFormat): int32; external "lib_binding_lib";
  | >
  | >end.
  | limit 42 ratio 1.5 half 0.5 whole 2 flag true
  | letter A quote '
  | label true
  | big 18446744073709551615 lowest -9223372036854775808
  | origin 1 2
  | primes 7
  | warm true false
  | default Blue
  | greeting hello
  | sum 5
  | scale 40 1.5
  | apply 42
  | words 3
  | format 1
  | next 6
  | add 10
  | add2 16
  | value 16
  | twice 40
  | via 21
  | calls 101
  | lib final 101
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_lib_binding;

@addmodulepath "$P:output/lib/x86_64-windows-gnu/debug";
@addlibrarypath "$P:output/lib/x86_64-windows-gnu/debug";

import System.SysUtils, System.IO, System.Zlib.Ext, lib_binding_lib;

const
  // The binding unit, from the exe's folder (<output>\bin\<triple>\<mode>)
  BINDING_PATH: string = "$P:../../../lib/x86_64-windows-gnu/debug/lib_binding_lib.adam";

routine Mul(const AX: int32; const AY: int32): int32;
begin
  return AX * AY;
end;

routine PrintBinding();
var
  LText: string;
  LLines: StringArray;
  LI: int64;
begin
  if not ReadAllText(BINDING_PATH, LText) then
    println("no binding");
    return;
  end;
  LLines := SplitString(LText, "\n");
  for LI := 0 to len(LLines) - 1 do
    if (LI < len(LLines) - 1) or (LLines[LI] <> "") then
      println(">{}", LLines[LI]);
    end;
  end;
end;

routine NextOf(const ACounter: ICounter): int32;
begin
  return ACounter.Next();
end;

routine UseCounter();
var
  LC: Counter(5);
begin
  println("next {}", LC.Next());
  println("add {}", LC.Add(4));
  println("add2 {}", LC.Add(2, 3));
  println("value {}", LC.Value);
  LC.Twice := 40;
  println("twice {}", LC.Twice);
  println("via {}", NextOf(LC));
end;

begin
  PrintBinding();
  println("limit {} ratio {} half {} whole {} flag {}", LIMIT, RATIO, HALF, WHOLE, FLAG);
  println("letter {} quote {}", LETTER, QUOTE_CHAR);
  println("label {}", LABEL_TEXT = "tab\there \"q\" \\ end\n");
  println("big {} lowest {}", BIG, LOWEST);
  println("origin {} {}", ORIGIN.X, ORIGIN.Y);
  println("primes {}", PRIMES[3]);
  println("warm {} {}", Color.Green in WARM, Color.Blue in WARM);
  println("default {}", DEFAULT_COLOR);
  println("greeting {}", Greeting);
  println("sum {}", Sum(2, 3));
  println("scale {} {}", Scale(int64(4)), Scale(3.0));
  println("apply {}", Apply(Mul, 6, 7));
  println("words {}", len(Words("a b c")));
  println("format {}", FormatCode(ZlibFormat.Gzip));
  UseCounter();
  println("calls {}", Calls);
end.
