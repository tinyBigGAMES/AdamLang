-------------------------------------------------------------------------------
  obj_method_overload.adam - method overloads (MO1, BNF sec 4): methods of
  one name in one type overload by parameter count and types, a call picks
  one as a routine call does (by count, by type; a text one beside an int64
  one). A level's methods join its parent's set (OV1): TDerived's
  Plain(string) beside TBase's Plain(int64); TDerived overrides Show(int64) and adds
  Show(int64, int64), Show(string) is still TBase's; a call through a var
  TBase dispatches each overload to its own slot; parent.Show picks among
  the parent level's set. An interface's overloaded methods are each a slot
  of their own, fulfilled by the object's overloads and by an embed's (one
  forward per overload). A const method overload is picked through a const
  object. A generic method overloads with a plain one, the plain one winning
  a tie. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | add 15 17 hi!
  | derived int 5
  | base int 5
  | base text x
  | derived pair 3
  | derived int 7
  | base int 7
  | base text y
  | derived plain p
  | base plain 1
  | base plain 3
  | put int 4
  | put text four
  | embed int 6
  | embed text six
  | const 9 3
  | plain 2
  | generic
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_method_overload;

type
  TCalc = object
    FBase: int64;

    method Add(const AN: int64): int64;
    begin
      return self.FBase + AN;
    end;

    method Add(const AA: int64; const AB: int64): int64;
    begin
      return self.FBase + AA + AB;
    end;

    method Add(const AS: string): string;
    begin
      return AS + "!";
    end;
  end;

  TBase = object
    virtual method Show(const AN: int64);
    begin
      println("base int {}", AN);
    end;

    virtual method Show(const AS: string);
    begin
      println("base text {}", AS);
    end;

    method Plain(const AN: int64);
    begin
      println("base plain {}", AN);
    end;
  end;

  TDerived = object(TBase)
    override method Show(const AN: int64);
    begin
      println("derived int {}", AN);
      parent.Show(AN);
    end;

    method Show(const AA: int64; const AB: int64);
    begin
      println("derived pair {}", AA + AB);
    end;

    method Plain(const AS: string);
    begin
      println("derived plain {}", AS);
      parent.Plain(1);
    end;
  end;

  IPut = interface
    method Put(const AN: int64);
    method Put(const AS: string);
  end;

  TPrinter = object implements IPut
    virtual method Put(const AN: int64);
    begin
      println("put int {}", AN);
    end;

    virtual method Put(const AS: string);
    begin
      println("put text {}", AS);
    end;
  end;

  TPutter = object
    method Put(const AS: string);
    begin
      println("embed text {}", AS);
    end;

    method Put(const AN: int64);
    begin
      println("embed int {}", AN);
    end;
  end;

  THolder = object implements IPut
    embed P: TPutter;
  end;

  TConst = object
    FValue: int64;

    const method Get(const AN: int64): int64;
    begin
      return self.FValue + AN;
    end;

    method Get(const AS: string): int64;
    begin
      self.FValue := 0;
      return 0;
    end;
  end;

  TPick = object
    method Name<T>(const AV: T);
    begin
      println("generic");
    end;

    method Name(const AV: int64);
    begin
      println("plain {}", AV);
    end;
  end;

// Each overload of Show through a TBase dispatches to its own slot
func Shows(var AB: TBase);
var
  LN: int64;
begin
  LN := 7;
  AB.Show(LN);
  AB.Show("y");
end;

// Each overload of Put through the interface
func Puts(const AP: IPut; const AN: int64; const AS: string);
begin
  AP.Put(AN);
  AP.Put(AS);
end;

// A const method overload through a const object
func ReadConst(const AC: TConst; const AN: int64): int64;
begin
  return AC.Get(AN);
end;

func Tests();
var
  LCalc: TCalc;
  LDerived: TDerived;
  LPrinter: TPrinter;
  LHolder: THolder;
  LConst: TConst;
  LPick: TPick;
  LN: int64;
begin
  LCalc.FBase := 10;
  LN := 5;
  println("add {} {} {}", LCalc.Add(LN), LCalc.Add(LN, 2), LCalc.Add("hi"));
  LDerived.Show(LN);
  LDerived.Show("x");
  LDerived.Show(1, 2);
  Shows(LDerived);
  LDerived.Plain("p");
  LDerived.Plain(3);
  Puts(LPrinter, 4, "four");
  Puts(LHolder, 6, "six");
  LConst.FValue := 6;
  println("const {} {}", ReadConst(LConst, 3), LConst.Get(LN) - 8);
  LN := 2;
  LPick.Name(LN);
  LPick.Name("s");
end;

begin
  Tests();
  println("end");
end.
