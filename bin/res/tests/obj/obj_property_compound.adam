-------------------------------------------------------------------------------
  obj_property_compound.adam - compound assignments on properties of every
  type the place path takes (M3.10e4, BNF sec 4: X OP= v reads, operates
  and writes, the object, the value, the current value, then the write, each
  once). Text's write has a body: += passes it the joined text, which ends
  with its statement (Leaked 0); += of itself reads it once. Shout reads
  through a body (a text the caller holds) and writes its field. Small's
  write takes a one-lane set, Big's a set of several lanes (by copy); both
  read and write through bodies or fields. At is a typed ptr moved by += /
  -= through its write's body. Body is a virtual text property, += through
  a ref.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | abcd
  | abcdabcd
  | abcdabcd!?
  | 3
  | [2, 5]
  | [3, 150]
  | 30
  | 20
  | 30
  | xy
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_property_compound;

type
  TSmall = set of 0..7;
  TBig = set of 0..199;

  TBag = object
    FText: string;
    FWrites: int32;
    FSmall: TSmall;
    FBig: TBig;
    FAt: ptr to int32;

    property Text: string read FText;
      write (AValue)
      begin
        self.FText := AValue;
        self.FWrites += 1;
      end;
    property Shout: string
      read
      begin
        return self.FText + "!";
      end;
      write FText;
    property Small: TSmall read FSmall;
      write (AValue)
      begin
        self.FSmall := AValue;
      end;
    property Big: TBig
      read
      begin
        return self.FBig;
      end;
      write (AValue)
      begin
        self.FBig := AValue;
      end;
    property At: ptr to int32 read FAt;
      write (AValue)
      begin
        self.FAt := AValue;
      end;
  end;

  TNote = object
    FBody: string;

    virtual property Body: string read FBody; write FBody;
  end;

// Every form through a value
func Values();
var
  LB: TBag;
  LArr: array[0..3] of int32;
begin
  LB.Text := "ab";
  LB.Text += "cd";
  println("{}", LB.Text);
  LB.Text += LB.Text;
  println("{}", LB.Text);
  LB.Shout += "?";
  println("{}", LB.FText);
  println("{}", LB.FWrites);
  LB.Small := [1, 2];
  LB.Small += [5];
  LB.Small -= [1];
  println("{}", LB.Small);
  LB.Big := [150];
  LB.Big += [3, 199];
  LB.Big *= [3, 150];
  println("{}", LB.Big);
  LArr[0] := 10;
  LArr[1] := 20;
  LArr[2] := 30;
  LArr[3] := 40;
  LB.At := addr of LArr[0];
  LB.At += 2;
  println("{}", LB.At^);
  LB.At -= 1;
  println("{}", LB.At^);
  LB.At++;
  println("{}", LB.At^);
end;

// A virtual text property, through a ref
func Refs();
var
  LN: ref TNote;
begin
  LN := ref TNote;
  LN.Body := "x";
  LN.Body += "y";
  println("{}", LN.Body);
end;

begin
  Values();
  Refs();
  println("end");
end.
