-------------------------------------------------------------------------------
  obj_err_construct.adam - value construction's errors (BNF sec 4, RAVENAPI
  VC1): arguments no init takes (two arguments, SM0351), an object whose
  every init takes arguments built with none (SM0349), the arguments fitting
  two inits (SM0352), and one argument no init takes, which stays a cast of
  a value no cast takes (SM0264).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_construct;

type
  Counter = object
    hidden FValue: int64;

    init(const AValue: int64);
    begin
      self.FValue := AValue;
    end;

    init(const AValue: float64);
    begin
      self.FValue := int64(AValue);
    end;
  end;

var
  LC: Counter(1.5);
begin
  LC := Counter(1, 2); // ERROR SM0351@9
  LC := Counter(); // ERROR SM0349@9
  LC := Counter(int32(3)); // ERROR SM0352@9
  LC := Counter("text"); // ERROR SM0264@17
end.
