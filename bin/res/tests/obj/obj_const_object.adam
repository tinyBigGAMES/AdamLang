-------------------------------------------------------------------------------
  obj_const_object.adam - a const parameter of a polymorphic object type
  takes a descendant whole (BNF sec 6), never a copy of its static type's
  bytes: `as` reaches the descendant's field through it (reads and the
  address is the caller's), a virtual call runs the override, a method's
  own const parameter too, and a nested call passes it on unchanged.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | r 2
  | same true
  | circle 2
  | method 2
  | nested 2
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe obj_const_object;

type
  TShape = object
    virtual method Name(): string;
    begin
      return "shape";
    end;
  end;
  TCircle = object(TShape)
    R: int32;
    override method Name(): string;
    begin
      return "circle";
    end;
  end;
  TProbe = object
    method Radius(const AShape: TShape): int32;
    begin
      return (AShape as TCircle).R;
    end;
  end;

var
  GAddress: uint64;

routine Inner(const AShape: TShape): int32;
begin
  return (AShape as TCircle).R;
end;

routine Describe(const AShape: TShape);
var
  LP: ptr to const TShape;
  LProbe: TProbe;
begin
  LP := addr of AShape;
  println("r {}", (AShape as TCircle).R);
  println("same {}", uint64(LP) = GAddress);
  println("{} {}", AShape.Name(), (AShape as TCircle).R);
  println("method {}", LProbe.Radius(AShape));
  println("nested {}", Inner(AShape));
end;

routine Run();
var
  LC: TCircle;
  LP: ptr to TCircle;
begin
  LC.R := 2;
  LP := addr of LC;
  GAddress := uint64(LP);
  Describe(LC);
end;

begin
  Run();
end.
