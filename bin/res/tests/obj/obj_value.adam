-------------------------------------------------------------------------------
  obj_value.adam - Objects by value and plain methods (M3.10a): an object
  local, field, dynamic array element and module variable, zeroed; methods
  that change their object, const methods, a method calling another through
  self; a copy that stays independent; `P->M()` and `P^.M()` through a ptr;
  a string field changed by a method (old value returned); a descendant
  whose method hides its parent's and reaches it by parent.M(), an inherited
  method running on the descendant (not virtual: its own level's Bump) and
  inherited fields through self; objects as fields; a method writing an
  element of a shared dynamic array (copy on write) and a const method
  reading one (no copy). The [Heap] line counts every block, all freed.
  Values are shown through ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 7
  | 14
  | 708
  | 11
  | a b!
  | b! a!
  | 1022
  | 44
  | 410
  | 607
  | 14
  | x
  | 22
  | [Heap] Allocs: 5, Frees: 5, Leaked: 0
@@end
*/

module exe obj_value;

func puts(const AText: ptr): int32; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

type
  TCounter = object
    Count: int32;
    Name: string;

    method Bump(const AStep: int32);
    begin
      self.Count := self.Count + AStep;
    end;

    const method Twice(): int32;
    begin
      return self.Count * 2;
    end;

    // The old name; the new one is AName and a '!'
    method Rename(const AName: string): string;
    var
      LOld: string;
    begin
      LOld := self.Name;
      self.Name := AName + "!";
      return LOld;
    end;

    method BumpTwice(const AStep: int32);
    begin
      self.Bump(AStep);
      self.Bump(AStep);
    end;
  end;

  TNamed = object(TCounter)
    Tag: int64;

    // Hides TCounter.Bump; reaches it through parent
    method Bump(const AStep: int32);
    begin
      parent.Bump(AStep * 10);
      self.Tag := self.Tag + 1;
    end;

    const method Total(): int64;
    begin
      return self.Tag * 1000 + self.Count;
    end;
  end;

  TPair = object
    Left: TCounter;
    Right: TCounter;
  end;

var
  GCounter: TCounter;

// AValue in decimal, one line
func ShowInt(const AValue: int64);
var
  LBuf: array[0..31] of char;
begin
  puts(_i64toa(AValue, addr of LBuf[0], 10));
end;

// A local changed by its methods, a copy, a ptr to one
func Values();
var
  LC: TCounter;
  LD: TCounter;
  LP: ptr to TCounter;
begin
  LC.Bump(3);
  LC.BumpTwice(2);
  ShowInt(LC.Count);
  ShowInt(LC.Twice());
  LD := LC;
  LD.Bump(1);
  ShowInt(LC.Count * 100 + LD.Count);
  LP := addr of LD;
  LP->Bump(2);
  LP^.Bump(1);
  ShowInt(LD.Count);
end;

// A string field changed by a method that returns the old one
func Strings();
var
  LC: TCounter;
  LOld: string;
begin
  LC.Name := "a";
  LOld := LC.Rename("b");
  println("{} {}", LOld, LC.Name);
  LOld := LC.Rename(LOld);
  println("{} {}", LOld, LC.Name);
end;

// A descendant: its own Bump (parent.Bump inside), an inherited method and const method
func Inherited();
var
  LN: TNamed;
begin
  LN.Bump(2);
  LN.BumpTwice(1);
  ShowInt(LN.Total());
  ShowInt(LN.Twice());
end;

// Objects as fields and as dynamic array elements
func Fields();
var
  LP: TPair;
  LA: array of TCounter;
  LB: array of TCounter;
begin
  LP.Left.Bump(4);
  LP.Right.BumpTwice(5);
  ShowInt(LP.Left.Count * 100 + LP.Right.Count);
  setlength(LA, 2);
  LA[1].Bump(6);
  LB := LA;
  LB[1].Bump(1);
  ShowInt(LA[1].Count * 100 + LB[1].Count);
  ShowInt(LB[1].Twice());
  LA[0].Name := "x";
  println("{}", LA[0].Rename("y"));
end;

// A module variable
func ModuleVariable();
begin
  GCounter.Bump(9);
  GCounter.BumpTwice(1);
  ShowInt(GCounter.Twice());
end;

func Run();
begin
  Values();
  Strings();
  Inherited();
  Fields();
  ModuleVariable();
end;

begin
  Run();
end.
