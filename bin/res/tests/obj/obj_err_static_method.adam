-------------------------------------------------------------------------------
  obj_err_static_method.adam - break step of obj_static_method (BNF sec 3,
  J3d): a static method takes no virtual / override / final / const word
  and no abstract (PR0072); it names no self or parent (SM0745); an
  instance member named through its type (SM0746) and a static method
  reached through a value (SM0747) are errors; a static and an instance
  method never share a name in one type (SM0004); a hidden static is
  reached only from its type's methods (SM0019); an interface declares none
  (PR0034).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_static_method;

type
  TWords = object
    virtual static method A(); // ERROR PR0072@5
    begin
    end;

    static const method B(); // ERROR PR0072@12
    begin
    end;

    static method C(); abstract; // ERROR PR0072@24
  end;

  TThing = object
    FValue: int64;

    static method NoSelf(): int64;
    begin
      return self.FValue; // ERROR SM0745@14
    end;

    static method NoParent();
    begin
      parent.Run(); // ERROR SM0745@7
    end;

    method Run();
    begin
    end;

    hidden static method Inner(): int64;
    begin
      return 1;
    end;

    static method Twin();
    begin
    end;

    method Twin(const AN: int64); // ERROR SM0004@5
    begin
    end;
  end;

  IShape = interface
    static method Area(): int64; // ERROR PR0034@5
  end;

routine Tests();
var
  LThing: TThing;
  LN: int64;
begin
  TThing.Run(); // ERROR SM0746@10
  LN := TThing.FValue; // ERROR SM0746@16
  LN := LThing.NoSelf(); // ERROR SM0747@16
  LN := TThing.Inner(); // ERROR SM0019@16
end;

begin
  Tests();
end.
