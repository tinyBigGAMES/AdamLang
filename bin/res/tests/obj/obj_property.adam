-------------------------------------------------------------------------------
  obj_property.adam - properties (M3.10e, BNF sec 4 object members): read
  F / read block, write F / write (AValue) block, indexed and default,
  through a value, self and a ref. Count is its field (read and write bound
  to FCount): assigned, compound-assigned and stepped as the field is.
  Split reads FLow and writes FHigh, so a compound reads one and writes the
  other. Twice has a body on both sides (compound and both steps go through
  them). Name reads its field and writes through a body; Greeting's read
  makes a text the caller holds (taken by an assignment). Items is the
  default indexed property (X[i], X.Items[i], compound and step on it).
  Pair reads a record through a body (the hidden result) and writes its
  field. Virtual properties dispatch through the vtable: TAnimal's bound
  Title and Level get functions in their slots, TDog overrides them with
  bodies (Level clamps at 9), Legs is abstract in TAnimal; through a ref of
  TAnimal holding a TDog, then a TBird.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 5
  | 8
  | 0
  | 7
  | 3
  | 12
  | 24
  | 50
  | 101
  | 404
  | 806
  | rex!
  | max! hi max!
  | hi max!
  | 12
  | 34
  | 807
  | 10
  | 3
  | 13
  | hi pip!
  | 9
  | dog fido
  | 4
  | 12
  | 13
  | tom
  | 2
  | end
  | [Adam Heap] Allocs: 12, Frees: 12, Leaked: 0
@@end
*/

module exe obj_property;

routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
var
  LBuf: array[0..31] of char;
begin
  puts(_i64toa(AValue, addr of LBuf[0], 10));
end;

type
  // 16 bytes: a value of it comes back through the hidden pointer
  TPair = record
    A: int64;
    B: int64;
  end;

  TBox = object
    FCount: int32;
    FLow: int32;
    FHigh: int32;
    FName: string;
    FItems: array of int64;
    FPair: TPair;

    init();
    begin
      setlength(self.FItems, 3);
    end;

    // The field itself: read and write bound to FCount
    property Count: int32 read FCount; write FCount;

    // Reads FLow, writes FHigh: never the same storage
    property Split: int32 read FLow; write FHigh;

    // A body on both sides: the stored value is twice what was written
    property Twice: int32
      read
      begin
        return self.FCount * 2;
      end;
      write (AValue)
      begin
        self.FCount := AValue + AValue;
      end;

    // A text read from its field, written through a body
    property Name: string read FName;
      write (AValue)
      begin
        self.FName := AValue + "!";
      end;

    // A text made by its read (a temporary the caller holds)
    property Greeting: string
      read
      begin
        return "hi " + self.FName;
      end;

    // The default indexed property over FItems
    property Items[AIndex: int64]: int64
      read
      begin
        return self.FItems[AIndex];
      end;
      write (AValue)
      begin
        self.FItems[AIndex] := AValue;
      end;
      default;

    // A record read through a body, written to its field
    property Pair: TPair
      read
      begin
        return self.FPair;
      end;
      write FPair;

    // Properties through self
    method Bump();
    begin
      self.Count := self.Count + 1;
      self.Items[1] := self.Items[1] + 10;
    end;
  end;

  TAnimal = object
    FName: string;
    FLevel: int32;

    virtual property Title: string read FName;
    virtual property Level: int32 read FLevel; write FLevel;
    virtual property Legs: int32 read abstract;
  end;

  TDog = object(TAnimal)
    override property Title: string
      read
      begin
        return "dog " + self.FName;
      end;

    override property Level: int32 read FLevel;
      write (AValue)
      begin
        if AValue > 9 then
          self.FLevel := 9;
        else
          self.FLevel := AValue;
        end;
      end;

    override property Legs: int32
      read
      begin
        return 4;
      end;
  end;

  TBird = object(TAnimal)
    override property Legs: int32
      read
      begin
        return 2;
      end;
  end;

// Every form through a value
routine Values();
var
  LB: TBox;
  LP: TPair;
  LS: string;
begin
  LB.Count := 5;
  ShowInt(LB.Count);
  LB.Count += 2;
  LB.Count++;
  ShowInt(LB.Count);
  LB.Split := 7;
  ShowInt(LB.Split);
  ShowInt(LB.FHigh);
  LB.Split += 3;
  ShowInt(LB.FHigh);
  LB.Twice := 6;
  ShowInt(LB.FCount);
  ShowInt(LB.Twice);
  LB.Twice += 1;
  ShowInt(LB.FCount);
  ShowInt(++LB.Twice);
  ShowInt(LB.Twice--);
  ShowInt(LB.FCount);
  LB.Name := "rex";
  println("{}", LB.Name);
  LS := "max";
  LB.Name := LS;
  println("{} {}", LB.Name, LB.Greeting);
  LS := LB.Greeting;
  println("{}", LS);
  LB[0] := 11;
  LB.Items[2] := 33;
  LB[0] += 1;
  LB[2]++;
  ShowInt(LB[0]);
  ShowInt(LB.Items[2]);
  LB.Bump();
  ShowInt(LB.Count);
  ShowInt(LB[1]);
  LP.A := 1;
  LP.B := 2;
  LB.Pair := LP;
  LP.A := 0;
  LP := LB.Pair;
  ShowInt(LP.A + LP.B);
end;

// Through a ref, and virtual properties through a ref of the ancestor
routine Refs();
var
  LR: ref TBox;
  LA: ref TAnimal;
begin
  LR := ref TBox;
  LR.Count := 4;
  LR[1] := 9;
  LR.Name := "pip";
  ShowInt(LR.Count + LR[1]);
  println("{}", LR.Greeting);
  LA := ref TDog;
  LA.Level := 12;
  ShowInt(LA.Level);
  LA.FName := "fido";
  println("{}", LA.Title);
  ShowInt(LA.Legs);
  LA := ref TBird;
  LA.FName := "tom";
  LA.Level := 12;
  ShowInt(LA.Level);
  LA.Level += 1;
  ShowInt(LA.Level);
  println("{}", LA.Title);
  ShowInt(LA.Legs);
end;

begin
  Values();
  Refs();
  println("end");
end.
