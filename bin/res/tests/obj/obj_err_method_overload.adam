-------------------------------------------------------------------------------
  obj_err_method_overload.adam - break step of obj_method_overload (MO1, BNF
  sec 4): a method with the parameter types of an earlier one of its name is
  no overload, whatever its names, modes and result (SM0324); a call no
  overload takes (SM0402: a level hides its parent's plain methods of the
  name); an ancestor's virtual method of the same parameter types needs
  override (SM0332), another overload of the name needs none; an override
  of no virtual method of its parameter types (SM0333) or of other modes
  (SM0334); a hidden overload (SM0019) and a method that may change a const
  object (SM0426) are judged on the overload the call picks; an interface's
  overload no method takes the parameter types of (SM0364).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_method_overload;

type
  TSame = object
    method M(const AN: int64): int64;
    begin
      return AN;
    end;

    method M(var AX: int64): string; // ERROR SM0324@5
    begin
      return "";
    end;
  end;

  TParent = object
    method Plain(const AN: int64);
    begin
    end;

    virtual method V(const AN: int64);
    begin
    end;
  end;

  TChild = object(TParent)
    method Plain(const AS: string);
    begin
    end;

    method Plain(const AS: string; const AT: string);
    begin
    end;

    method V(const AN: int64); // ERROR SM0332@12
    begin
    end;

    virtual method V(const AS: string);
    begin
    end;
  end;

  TOver = object(TParent)
    override method V(const AN: int32); // ERROR SM0333@5
    begin
    end;
  end;

  TMode = object(TParent)
    override method V(var AN: int64); // ERROR SM0334@21
    begin
    end;
  end;

  THide = object
    method Put(const AN: int64);
    begin
    end;

    hidden method Put(const AS: string);
    begin
    end;
  end;

  TConstGet = object
    const method Get(const AN: int64): int64;
    begin
      return AN;
    end;

    method Get(const AS: string): int64;
    begin
      return 0;
    end;
  end;

  IBoth = interface
    method Put(const AN: int64);
    method Put(const AS: string);
  end;

  TOnly = object implements IBoth // ERROR SM0364@29
    virtual method Put(const AN: int64);
    begin
    end;
  end;

routine Uses(const AC: TConstGet);
var
  LChild: TChild;
  LHide: THide;
  LN: int64;
begin
  LN := 1;
  LChild.Plain(LN); // ERROR SM0402@3
  LHide.Put(LN);
  LHide.Put("s"); // ERROR SM0019@9
  LN := AC.Get(LN);
  LN := AC.Get("s"); // ERROR SM0426@9
end;

routine Run();
var
  LGet: TConstGet;
begin
  Uses(LGet);
end;

begin
  Run();
end.
