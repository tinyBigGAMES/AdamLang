-------------------------------------------------------------------------------
  obj_err_slice.adam - a polymorphic object where it may be a descendant
  (BNF sec 4 O5, AUD4 5.1): copied by value out of a var or const parameter,
  a deref or an as, it would keep only its static part (SM0428); assigned
  whole through a var parameter, a deref or self, only that part would change
  (SM0429). A final object holds exactly its type (obj_member_names).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_slice;

type
  TA = object
    N: int32;
    virtual method M();
    begin
    end;
    method Reset();
    var
      LB: TA;
    begin
      self := LB; // ERROR SM0429@7
    end;
  end;
  TB = object(TA)
  end;

routine CopyAs(var AA: TA);
var
  LB: TB;
begin
  LB := AA as TB; // ERROR SM0428@9
end;

routine CopyDeref(const AP: ptr to TA);
var
  LA: TA;
begin
  LA := AP^; // ERROR SM0428@9
end;

routine CopyParam(const AB: TA): TA;
begin
  return AB; // ERROR SM0428@10
end;

routine SetDeref(const AP: ptr to TA);
var
  LB: TA;
begin
  AP^ := LB; // ERROR SM0429@3
end;

routine SetVar(var AA: TA);
var
  LB: TA;
begin
  AA := LB; // ERROR SM0429@3
end;

begin
end.
