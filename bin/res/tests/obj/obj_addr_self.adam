-------------------------------------------------------------------------------
  obj_addr_self.adam - `addr of self` in a method that may change its object
  is a ptr to its type (BNF sec 4 / 6): a plain object method and a record's
  extend method write through it, also as a C-style `ptr to T` argument; a
  const method's `addr of self` reads through its ptr to const. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | obj 2 rec 11 arg 7 read 2
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_addr_self;

type
  Pos = record
    X: int32;
  end;

  Counter = object
    FN: int64;

    method Bump();
    var
      LP: ptr to Counter;
    begin
      LP := addr of self;
      LP^.FN := LP^.FN + 1;
    end;

    const method Peek(): int64;
    var
      LP: ptr to const Counter;
    begin
      LP := addr of self;
      return LP^.FN;
    end;
  end;

// A C-style routine changing its argument through a pointer (raylib's UpdateCamera)
func Grow(const AP: ptr to Pos; const AN: int32);
begin
  AP^.X := AP^.X + AN;
end;

extend Pos
  method Bump();
  var
    LP: ptr to Pos;
  begin
    LP := addr of self;
    LP^.X := LP^.X + 10;
  end;

  method GrowBy(const AN: int32);
  begin
    Grow(addr of self, AN);
  end;
end;

var
  GC: Counter;
  GP: Pos;
  GQ: Pos;
begin
  GC.Bump();
  GC.Bump();
  GP.X := 1;
  GP.Bump();
  GQ.X := 2;
  GQ.GrowBy(5);
  println("obj {} rec {} arg {} read {}", GC.FN, GP.X, GQ.X, GC.Peek());
end.
