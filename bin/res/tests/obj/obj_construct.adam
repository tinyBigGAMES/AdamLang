-------------------------------------------------------------------------------
  obj_construct.adam - value construction (BNF sec 4, RAVENAPI VC1): T(args)
  in an expression builds a value of the object type T by the init its
  arguments pick. Assigned (each init: none, one, two arguments), a method
  called on one (a temporary ended at its statement's end), returned from a
  routine, passed as an argument, built in a loop (each run starts from
  nothing); a type running code where it ends built, moved and ended once
  each (a temporary ended at its statement's end, after its line printed,
  the old value at its
  reassignment, its variable's first value too); a type with no init as
  T() (its zero value); a plain one
  with an init taking arguments; a value of T given to T(x) no init takes
  is still a cast (a copy).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | assigned a=1 b=7 none=0
  | temporary tmp=3
  | returned made=4
  | argument arg=2
  | loop loop3
  | tracked 5 built 1 ended 1
  | temporary tracked 6 built 2 ended 1
  | reassigned 9 built 5 ended 5
  | plain 0 0
  | pair 1 2
  | cast b=7 b=7
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_construct;

import System.SysUtils;

var
  GBuilt: int32;
  GEnded: int32;

type
  // Inits picked by their arguments
  Counter = object
    hidden FName: string;
    hidden FValue: int32;

    init();
    begin
      self.FName := "none";
      self.FValue := 0;
    end;

    init(const AName: string);
    begin
      self.FName := AName;
      self.FValue := 1;
    end;

    init(const AName: string; const AValue: int32);
    begin
      self.FName := AName;
      self.FValue := AValue;
    end;

    const method Text(): string;
    begin
      return self.FName + "=" + IntToStr(self.FValue);
    end;
  end;

  // Runs code where it ends (a done, no copy: it can only be moved)
  Tracked = object
    hidden FId: int32;

    init(const AId: int32);
    begin
      self.FId := AId;
      GBuilt := GBuilt + 1;
    end;

    const method Id(): int32;
    begin
      return self.FId;
    end;

    done;
    begin
      GEnded := GEnded + 1;
    end;
  end;

  // No init: T() is its zero value
  Plain = object
    X: int32;
    Y: int32;
  end;

  // Plain bytes, built by an init taking arguments
  Pair = object
    A: int32;
    B: int32;

    init(const AA: int32; const AB: int32);
    begin
      self.A := AA;
      self.B := AB;
    end;
  end;

// A routine's result built by a construction
func Make(const AValue: int32): Counter;
begin
  return Counter("made", AValue);
end;

// A construction given as an argument
func Show(const ACounter: Counter): string;
begin
  return ACounter.Text();
end;

var
  LA: Counter;
  LB: Counter;
  LC: Counter;
  LD: Counter;
  LT: Tracked(0);
  LP: Plain;
  LQ: Pair(0, 0);
  LI: int32;
begin
  GBuilt := 0;
  GEnded := 0;
  LA := Counter("a");
  LB := Counter("b", 7);
  LC := Counter();
  println("assigned {} {} {}", LA.Text(), LB.Text(), LC.Text());
  println("temporary {}", Counter("tmp", 3).Text());
  LC := Make(4);
  println("returned {}", LC.Text());
  println("argument {}", Show(Counter("arg", 2)));
  for LI := 1 to 3 do
    LC := Counter("loop" + IntToStr(LI));
  end;
  println("loop {}", Substring(LC.Text(), 0, 5));

  // moved, never copied; each value ended once
  GBuilt := 0;
  GEnded := 0;
  LT := Tracked(5);
  println("tracked {} built {} ended {}", LT.Id(), GBuilt, GEnded);
  println("temporary tracked {} built {} ended {}", Tracked(6).Id(), GBuilt, GEnded);
  for LI := 7 to 9 do
    LT := Tracked(LI);
  end;
  println("reassigned {} built {} ended {}", LT.Id(), GBuilt, GEnded);

  LP := Plain();
  println("plain {} {}", LP.X, LP.Y);
  LQ := Pair(1, 2);
  println("pair {} {}", LQ.A, LQ.B);
  LD := Counter(LB);
  println("cast {} {}", LD.Text(), LB.Text());
end.
