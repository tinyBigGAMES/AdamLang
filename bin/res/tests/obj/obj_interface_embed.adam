-------------------------------------------------------------------------------
  obj_interface_embed.adam - an embed's method fulfils an interface the
  object implements (I4, BNF sec 4 embed decl): the object forwards to it,
  no virtual needed. The itable slot runs a forward that moves self to the
  embed (past a plain parent part and a field) and calls the embed's
  method with the arguments and the result as they are (a text result, a
  const method, an argument); an embed of an embed (two steps); a level
  above's embed (TCube implements it again, TBox's embed answers); an own
  method and an embed's in one interface; an embed's virtual method (its
  own body: the embed holds exactly its type); a ref interface over such
  an object. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | area 9 measure
  | scaled 20
  | bump 1 2
  | tag 7
  | cube area 4 measure
  | cube bump 1
  | ref area 16 measure
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_interface_embed;

type
  IShape = interface
    method Area(): int64;
    const method Name(): string;
    method Scaled(const AFactor: int64; const AExtra: int64): int64;
  end;

  ICount = interface
    method Bump(): int64;
    const method Tag(): int64;
  end;

  TMeasure = object
    FSide: int64;

    method Area(): int64;
    begin
      return self.FSide * self.FSide;
    end;

    const method Name(): string;
    begin
      return "measure";
    end;

    virtual method Scaled(const AFactor: int64; const AExtra: int64): int64;
    begin
      return self.FSide * AFactor + AExtra;
    end;
  end;

  TCounter = object
    N: int64;

    method Bump(): int64;
    begin
      self.N := self.N + 1;
      return self.N;
    end;
  end;

  TInner = object
    Pad: int64;
    embed C: TCounter;
  end;

  TData = object
    Value: int64;
  end;

  TBox = object(TData) implements IShape, ICount
    FTag: int64;
    embed M: TMeasure;
    embed I: TInner;

    virtual const method Tag(): int64;
    begin
      return self.FTag;
    end;
  end;

  TCube = object(TBox) implements IShape
  end;

routine Show(const AShape: IShape);
begin
  println("area {} {}", AShape.Area(), AShape.Name());
end;

routine Counts(const ACount: ICount);
var
  LFirst: int64;
begin
  LFirst := ACount.Bump();
  println("bump {} {}", LFirst, ACount.Bump());
  println("tag {}", ACount.Tag());
end;

routine Tests();
var
  LBox: TBox;
  LCube: TCube;
  LShape: ptr to IShape;
  LCount: ptr to ICount;
  LRef: ref IShape;
  LHeld: ref TBox;
begin
  LBox.M.FSide := 3;
  LBox.FTag := 7;
  Show(LBox);
  LShape := addr of LBox;
  println("scaled {}", LShape->Scaled(6, 2));
  Counts(LBox);
  LCube.M.FSide := 2;
  LShape := addr of LCube;
  println("cube area {} {}", LShape->Area(), LShape->Name());
  LCount := addr of LCube;
  println("cube bump {}", LCount->Bump());
  LHeld := ref TBox();
  LHeld.M.FSide := 4;
  LRef := LHeld;
  LHeld := nil;
  println("ref area {} {}", LRef.Area(), LRef.Name());
end;

begin
  Tests();
  println("end");
end.
