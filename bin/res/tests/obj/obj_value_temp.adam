-------------------------------------------------------------------------------
  obj_value_temp.adam - a value object that ends by a done, returned by value
  (pcpp's truth, its oracle the same body): `return LLocal` moves the local
  out (it is never ended in the callee, with two candidate locals too); a
  result used in a statement, a member read, a const argument or an if
  condition is done when its full expression ends; a local's initializer
  takes the result (one done, at the local's end); an assignment ends the
  old object, then takes the result. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | init pa
  | init pb
  | done pb
  | init discard
  | done discard
  | after discard
  | init member
  | member
  | done member
  | after member
  | init arg
  | show arg
  | done arg
  | after arg
  | init cond
  | done cond
  | in then
  | init init
  | first init
  | done init
  | after init
  | init old
  | init new
  | done old
  | assigned new
  | done new
  | after assign
  | pick pa
  | done pa
  | end
  | [Adam Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_value_temp;

type
  TNote = object
    Text: string;

    init(const AText: string);
    begin
      self.Text := AText;
      println("init {}", self.Text);
    end;

    done;
    begin
      println("done {}", self.Text);
    end;
  end;

// A local moved out: never ended here
routine MakeNote(const AText: string): TNote;
var
  LNote: TNote(AText);
begin
  return LNote;
end;

// Two candidate locals: the one returned moves out, the other ends here
routine PickNote(const AFirst: bool): TNote;
var
  LA: TNote("pa");
  LB: TNote("pb");
begin
  if AFirst then
    return LA;
  end;
  return LB;
end;

routine Show(const ANote: TNote);
begin
  println("show {}", ANote.Text);
end;

// A local's initializer takes the result
routine Initialized();
var
  LNote: TNote = MakeNote("init");
begin
  println("first {}", LNote.Text);
end;

// An assignment ends the old object, then takes the result
routine Assigned();
var
  LNote: TNote("old");
begin
  LNote := MakeNote("new");
  println("assigned {}", LNote.Text);
end;

routine Run();
var
  LP: TNote = PickNote(true);
begin
  MakeNote("discard");
  println("after discard");
  println("{}", MakeNote("member").Text);
  println("after member");
  Show(MakeNote("arg"));
  println("after arg");
  if MakeNote("cond").Text = "cond" then
    println("in then");
  end;
  Initialized();
  println("after init");
  Assigned();
  println("after assign");
  println("pick {}", LP.Text);
end;

begin
  Run();
  println("end");
end.
