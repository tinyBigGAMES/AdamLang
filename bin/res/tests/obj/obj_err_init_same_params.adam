-------------------------------------------------------------------------------
  obj_err_init_same_params.adam - Break step of inits (AUD5): inits overload
  by parameter types (BNF sec 4), so a second init with the same types (the
  names and const make no difference) is SM0324 at it, and a second copy
  SM0354; neither is reported again as a symbol defined twice (SM0024); an
  init with other parameter types is clean
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_init_same_params;

type
  TA = object
    N: int32;
    init(const AX: int32);
    begin
      self.N := AX;
    end;
    init(AY: int32); // ERROR SM0324@5
    begin
      self.N := AY;
    end;
    init(const AX: int32; const AY: int32);
    begin
      self.N := AX + AY;
    end;
    copy(const ASource: TA);
    begin
      self.N := ASource.N;
    end;
    copy(const ASource: TA); // ERROR SM0354@5
    begin
      self.N := ASource.N;
    end;
  end;

begin
end.
