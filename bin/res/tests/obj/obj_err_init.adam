-------------------------------------------------------------------------------
  obj_err_init.adam - Break step of obj_init_lead (BNF sec 4 D3, O5): one
  done per type (SM0341); init / copy (SM0342) and done (SM0343) are never
  called by name; parent.init(...) is an init's first statement (SM0344)
  and never in a copy (SM0356); self.F.init(...) in declaration order, each
  field once (SM0345), a misplaced one ending the leads (a later one is a
  call by name); a lead call's arguments name no self, parent or local
  (SM0346); a parent or field with no init without arguments is built by a
  lead call of every init and the copy (SM0347); a virtual method through
  self in an init, a copy or a done (SM0348); a lead call on a field that
  is no object (SM0350) or with arguments no init takes (SM0351).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_init;

type
  NeedsArg = object
    FV: int32;

    init(const AV: int32);
    begin
      self.FV := AV;
    end;
  end;

  TwoDones = object
    done;
    begin
    end;

    done; // ERROR SM0341@5: 'TwoDones' declares done twice: an object has one done
    begin
    end;
  end;

  LateParent = object(NeedsArg)
    FA: NeedsArg;

    init(const AV: int32);
    begin
      self.FA.init(AV);
      parent.init(AV); // ERROR SM0344@7: parent.init(...) is the first statement of an init
    end;
  end;

  Order = object
    FA: NeedsArg;
    FB: NeedsArg;

    init();
    begin
      self.FB.init(1);
      self.FA.init(2); // ERROR SM0345@7: self.FA.init(...) comes after self.FB.init(...): fields are built in declaration order
    end;

    init(const AV: int32);
    begin
      self.FA.init(AV);
      self.FA.init(AV); // ERROR SM0345@7: self.FA.init(...) is written twice: a field is built once
      self.FB.init(AV); // ERROR SM0342@7: init runs when an object is built: it is never called (only parent.init(...) and self.<field>.init(...) begin an init)
    end;
  end;

  Early = object
    FA: NeedsArg;
    FN: int32;

    init(const AV: int32);
    begin
      self.FA.init(self.FN); // ERROR SM0346@20: 'self' does not exist yet: the arguments of self.FA.init(...) run before the object is built
    end;

    init();
    var
      LX: int32;
    begin
      self.FA.init(LX); // ERROR SM0346@20: 'LX' does not exist yet: the arguments of self.FA.init(...) run before the object is built
    end;
  end;

  Missing = object(NeedsArg)
    FA: NeedsArg;

    init(); // ERROR SM0347@5: 'NeedsArg' has no init without arguments: begin every init of 'Missing' with parent.init(...) // ERROR SM0347@5: field 'FA': 'NeedsArg' has no init without arguments: begin every init of 'Missing' with self.FA.init(...)
    begin
    end;
  end;

  NoInits = object(NeedsArg) // ERROR SM0347@20: 'NeedsArg' has no init without arguments: begin every init of 'NoInits' with parent.init(...)
    FA: NeedsArg; // ERROR SM0347@5: field 'FA': 'NeedsArg' has no init without arguments: begin every init of 'NoInits' with self.FA.init(...)
  end;

  CopyLead = object
    FA: NeedsArg;

    init();
    begin
      self.FA.init(1);
    end;

    copy(const ASource: CopyLead); // ERROR SM0347@5: field 'FA': 'NeedsArg' has no init without arguments: begin every init of 'CopyLead' with self.FA.init(...)
    begin
    end;
  end;

  CopyParent = object(NeedsArg)
    init();
    begin
      parent.init(1);
    end;

    copy(const ASource: CopyParent);
    begin
      parent.init(2); // ERROR SM0356@7: a copy copies the parent part by the parent's own copy: parent.init(...) is not written in a copy
    end;
  end;

  NotObject = object
    FI: int32;
    FA: NeedsArg;

    init();
    begin
      self.FI.init(1); // ERROR SM0350@7: 'int32' takes no init arguments: only an object has an init
      self.FA.init("x"); // ERROR SM0351@7: no init of 'NeedsArg' takes (string)
    end;
  end;

  Talker = object
    init();
    begin
      self.Speak(); // ERROR SM0348@7: 'Speak' is virtual: in an init, a copy or a done a call does not dispatch, call a plain method or parent.Speak()
    end;

    done;
    begin
      self.Speak(); // ERROR SM0348@7: 'Speak' is virtual: in an init, a copy or a done a call does not dispatch, call a plain method or parent.Speak()
    end;

    virtual method Speak();
    begin
    end;

    method Talk();
    begin
      self.Speak();
    end;
  end;

routine Run();
var
  LN: NeedsArg(1);
  LT: Talker;
begin
  LN.init(2); // ERROR SM0342@3: init runs when an object is built: it is never called (only parent.init(...) and self.<field>.init(...) begin an init)
  LT.done(); // ERROR SM0343@3: done runs when an object ends: it is never called
  LN.copy(LN); // ERROR SM0342@3: copy runs when an object is copied (:=, a value argument): it is never called
end;

begin
  Run();
end.
