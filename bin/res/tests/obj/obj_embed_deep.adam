-------------------------------------------------------------------------------
  obj_embed_deep.adam - Embeds of embeds (M3.10f, BNF sec 4: a name the
  object's chain does not declare is searched in the embeds of every level
  of the chain, then in theirs, depth by depth). X.M of an embed's embed's M
  is X.E.F.M: a field read and written, a bound property, a property read
  through its accessor, a const method and a method that changes the inner
  embed, all three depths deep; an embed declared at the parent's level
  whose own embed holds the member; a ptr (P->M) and a ref; an own-level
  embed (depth 1) wins over a name two embeds down (depth 2); an inner embed holding a text
  copied with its object (stays independent) and freed with it. The [Heap]
  line counts every block, all freed.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 7
  | 9
  | 18
  | 12
  | core.adam
  | false
  | 40
  | 41
  | 5
  | 10
  | 100
  | 102
  | core.adam
  | copy.adam
  | 77
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_embed_deep;

type
  // The innermost part: a record
  TCell = record
    Value: int64;
  end;

  // A middle part: an object embedding the record, a text, accessors and methods
  TCore = object
    hidden FFile: string;
    hidden FHits: int64;
    embed Cell: TCell;

    init();
    begin
      self.FFile := "";
      self.FHits := 0;
    end;

    property FileName: string read FFile; write FFile;
    property Hits: int64 read FHits;

    // Read through its accessor (no bound field)
    property Double: int64
      read
      begin
        return self.Value * 2;
      end;

    const method IsEmpty(): bool;
    begin
      return self.FFile = "";
    end;

    method Hit(const ABy: int64);
    begin
      self.FHits := self.FHits + ABy;
    end;

    // A name TOuter's own embed Side holds nearer (depth 1 against depth 2)
    Depth: int64;
  end;

  // A level between: an object embedding the core
  TShell = object
    embed Core: TCore;
  end;

  // The nearer holder of Depth
  TSide = record
    Depth: int64;
  end;

  // The parent level declares the embed; its child reaches through it
  TBase = object
    embed Shell: TShell;
  end;

  // Three depths: Shell (the parent's), then Core, then Cell
  TOuter = object(TBase)
    Tag: int64;
    embed Side: TSide;

    init();
    begin
      self.Tag := 0;
    end;

    // self.X of an embed's embed's X
    method Bump();
    begin
      self.Value := self.Value + 1;
    end;
  end;

  POuter = ptr to TOuter;

func Show(const AO: ref TOuter);
begin
  println("{}", AO.Value);
end;

func Run();
var
  LO: TOuter;
  LCopy: TOuter;
  LP: POuter;
  LR: ref TOuter;
begin
  LO.Value := 7;
  println("{}", LO.Value);
  LO.Value := LO.Value + 2;
  println("{}", LO.Value);
  println("{}", LO.Double);
  LO.Hit(12);
  println("{}", LO.Hits);
  LO.FileName := "core.adam";
  println("{}", LO.FileName);
  println("{}", LO.IsEmpty());
  LO.Value := 40;
  println("{}", LO.Shell.Core.Cell.Value);
  LO.Bump();
  println("{}", LO.Value);
  LP := addr of LO;
  LP->Value := 5;
  println("{}", LP->Value);
  LO.Depth := 1;
  println("{}", LO.Side.Depth * 10 + LO.Shell.Core.Depth);
  LR := ref TOuter();
  LR.Value := 100;
  println("{}", LR.Value);
  LR.Bump();
  LR.Bump();
  Show(LR);
  LCopy := LO;
  LCopy.FileName := "copy.adam";
  println("{}", LO.FileName);
  println("{}", LCopy.FileName);
  LCopy.Shell.Core.Cell.Value := 77;
  println("{}", LCopy.Value);
  println("end");
end;

begin
  Run();
end.
