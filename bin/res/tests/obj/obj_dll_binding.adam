-------------------------------------------------------------------------------
  obj_dll_binding.adam - a dll build writes its binding unit (PLAN-ADAM MO1b0 d):
  dll_binding_lib.adam in the output folder's lib\x86_64-windows-gnu\debug\
  beside its C header, read back here line by line ('>' before each), and
  imported here in place of writing the dll's declarations out again: its
  constant, record, variable, routines and external object type used (the
  overloaded pair, the virtual and the dispatched property through the
  interface), the record's operator and the object's extend bound as
  external extends (F1b)
*******************************************************************************/

/*
@@test
  kind run
  deps exe.dll_binding_lib
  exitcode 0
  | >// dll_binding_lib.adam - the Adam binding of the Adam dll dll_binding_lib, written by adam: do not edit
  | >
  | >module unit dll_binding_lib;
  | >
  | >public const
  | >  STEP: int32 = 3;
  | >
  | >public var
  | >  Made: int32; external "dll_binding_lib";
  | >
  | >public type
  | >  Pair = record
  | >    A: int32;
  | >    B: int32;
  | >  end;
  | >
  | >public extend Pair
  | >  operator +(const AX: Pair; const AY: Pair): Pair;
  | >end; external "dll_binding_lib";
  | >
  | >public type
  | >  IShape = interface
  | >    method Area(): int32;
  | >    property Sides: int32 read;
  | >  end; external "dll_binding_lib";
  | >
  | >  Shape = object implements IShape
  | >    FSide: int32;
  | >    init(const ASide: int32);
  | >    virtual method Area(): int32;
  | >    method Grow(): int32;
  | >    method Grow(const AStep: int32): int32;
  | >    virtual property Sides: int32 read;
  | >  end; external "dll_binding_lib";
  | >
  | >public func MakePair(const AA: int32; const AB: int32): Pair; external "dll_binding_lib";
  | >public func Total(const AP: Pair): int32; external "dll_binding_lib";
  | >
  | >public extend Shape
  | >  const method Double(): int32;
  | >end; external "dll_binding_lib";
  | >
  | >end.
  | step 3
  | pair 7
  | area 25
  | grow 8
  | grow2 18
  | sides 4
  | double 36
  | via 324 4
  | made 1
  | plus 10
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_dll_binding;

@addmodulepath "$P:output/lib/x86_64-windows-gnu/debug";
@addlibrarypath "$P:output/bin/x86_64-windows-gnu/debug";

import System.SysUtils, System.IO, dll_binding_lib;

const
  // The binding unit, from the exe's folder (<output>\bin\<triple>\<mode>)
  BINDING_PATH: string = "$P:../../../lib/x86_64-windows-gnu/debug/dll_binding_lib.adam";

func PrintBinding();
var
  LText: string;
  LLines: StringArray;
  LI: int64;
begin
  if not ReadAllText(BINDING_PATH, LText) then
    println("no binding");
    return;
  end;
  LLines := SplitString(LText, "\n");
  for LI := 0 to len(LLines) - 1 do
    if (LI < len(LLines) - 1) or (LLines[LI] <> "") then
      println(">{}", LLines[LI]);
    end;
  end;
end;

func Report(const AShape: IShape);
begin
  println("via {} {}", AShape.Area(), AShape.Sides);
end;

func UseShape();
var
  LS: Shape(5);
begin
  println("area {}", LS.Area());
  println("grow {}", LS.Grow());
  println("grow2 {}", LS.Grow(10));
  println("sides {}", LS.Sides);
  println("double {}", LS.Double());
  Report(LS);
end;

begin
  PrintBinding();
  println("step {}", STEP);
  println("pair {}", Total(MakePair(3, 4)));
  UseShape();
  println("made {}", Made);
  println("plus {}", Total(MakePair(1, 2) + MakePair(3, 4)));
end.
