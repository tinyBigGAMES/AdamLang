-------------------------------------------------------------------------------
  obj_err_lower.adam - Break step of obj (M3.10a): every object form whose
  atom is later stops adam build with LW0001 at its node, never dropped: an
  init and a done (M3.10b), a virtual method (M3.10d), a local of a type
  with an init (its lifetime), a local of a polymorphic type (its vptr), an
  object holding a ref, a dynamic array whose elements need an init (setlength
  builds them). Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "<DIR>/obj_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/obj_err_lower.adam(45,5): Error LW0001: code generation does not handle an init method yet
  | <DIR>/obj_err_lower.adam(50,5): Error LW0001: code generation does not handle a done method yet
  | <DIR>/obj_err_lower.adam(57,5): Error LW0001: code generation does not handle the method 'Area' yet
  | <DIR>/obj_err_lower.adam(69,3): Error LW0001: code generation does not handle the lifetime of type 'TBuilt' yet
  | <DIR>/obj_err_lower.adam(70,3): Error LW0001: code generation does not handle the lifetime of type 'TShape' yet
  | <DIR>/obj_err_lower.adam(71,3): Error LW0001: code generation does not handle the owners in type 'THolder' yet
  | <DIR>/obj_err_lower.adam(72,3): Error LW0001: code generation does not handle the lifetime of type 'TBuilt' yet
@@end
*/

module exe obj_err_lower;

type
  TBuilt = object
    X: int32;

    init();
    begin
      self.X := 1;
    end;

    done;
    begin
      self.X := 0;
    end;
  end;

  TShape = object
    virtual method Area(): int32;
    begin
      return 1;
    end;
  end;

  THolder = object
    Item: ref TBuilt;
  end;

routine Forms();
var
  LB: TBuilt;
  LS: TShape;
  LH: THolder;
  LA: array of TBuilt;
begin
  setlength(LA, 1);
end;

begin
  Forms();
end.
