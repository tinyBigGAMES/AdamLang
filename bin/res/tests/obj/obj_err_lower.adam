-------------------------------------------------------------------------------
  obj_err_lower.adam - Break step of obj (M3.10a .. M3.10d): every object
  form whose atom is later stops adam build with LW0001 at its node, never
  dropped: an object holding an own (M3.10c holds refs), a dynamic array
  whose elements need an init and a done (setlength builds no element yet),
  the vtable of an object that implements an interface (its per-object
  tables: M3.10f) and of one with a virtual property (M3.10e). The local of
  TBuilt is built and ended (M3.10b) and the polymorphic TShape gets its
  vtable (M3.10d): neither reports anything. Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "<DIR>/obj_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/obj_err_lower.adam(87,3): Error LW0001: code generation does not handle the owners in type 'THolder' yet
  | <DIR>/obj_err_lower.adam(88,3): Error LW0001: code generation does not handle the interfaces of type 'TRuler' yet
  | <DIR>/obj_err_lower.adam(89,3): Error LW0001: code generation does not handle the virtual property 'Title' yet
  | <DIR>/obj_err_lower.adam(90,3): Error LW0001: code generation does not handle the lifetime of type 'TBuilt' yet
@@end
*/

module exe obj_err_lower;

type
  TBuilt = object
    X: int32;

    init();
    begin
      self.X := 1;
    end;

    done;
    begin
      self.X := 0;
    end;
  end;

  TShape = object
    virtual method Area(): int32;
    begin
      return 1;
    end;
  end;

  THolder = object
    Item: own TBuilt;
  end;

  IMeasure = interface
    method Size(): int32;
  end;

  TRuler = object implements IMeasure
    virtual method Size(): int32;
    begin
      return 2;
    end;
  end;

  TNamed = object
    FName: string;
    virtual property Title: string read FName;
  end;

routine Forms();
var
  LB: TBuilt;
  LS: TShape;
  LH: THolder;
  LR: TRuler;
  LN: TNamed;
  LA: array of TBuilt;
begin
  setlength(LA, 1);
end;

begin
  Forms();
end.
