-------------------------------------------------------------------------------
  obj_err_lower.adam - Break step of obj (M3.10a .. M3.10e): every object
  form whose atom is later stops adam build with LW0001 at its node, never
  dropped: a property read through an interface (its itable's accessor
  slots: I3). An object implementing an interface lowers (I2:
  obj_interface): TRuler's local gets its itable. An object holding an own
  (THolder) lowers as one holding a ref (obj_own). Properties lower in
  every form (M3.10e3 / e4: obj_property_bits, obj_property_compound: a
  bitfield, a text += through a write's body). TBuilt's local is built and
  ended (M3.10b), and so is a dynamic array of them, element by element
  (M3.10g g5: obj_dynarray_lifetime, setlength on LA); the polymorphic
  TShape gets its vtable (M3.10d) and so does TNamed with its virtual
  property (M3.10e): none reports anything. Every local's slot is made
  before any is initialized (PLAN-SELFHOST S3); the setlength on LA that
  the array's refusal used to stop now lowers: it builds LA's one element,
  which ends at the routine's exit with the other locals. The one refusal
  is AM.Size in Measure. Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/obj_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/obj_err_lower.adam(88,10): Error LW0001: code generation does not handle a property read or written through the interface 'IMeasure' yet
@@end
*/

module exe obj_err_lower;

type
  TBuilt = object
    X: int32;

    init();
    begin
      self.X := 1;
    end;

    done;
    begin
      self.X := 0;
    end;
  end;

  TShape = object
    virtual method Area(): int32;
    begin
      return 1;
    end;
  end;

  THolder = object
    Item: own TBuilt;
  end;

  IMeasure = interface
    property Size: int32 read;
  end;

  TRuler = object implements IMeasure
    FSize: int32;
    virtual property Size: int32 read FSize;
  end;

  TNamed = object
    FName: string;
    virtual property Title: string read FName;
  end;

routine Measure(const AM: IMeasure): int32;
begin
  return AM.Size;
end;

routine Forms();
var
  LB: TBuilt;
  LS: TShape;
  LH: THolder;
  LR: TRuler;
  LN: TNamed;
  LA: array of TBuilt;
begin
  setlength(LA, 1);
  LR.FSize := Measure(LR);
end;

begin
  Forms();
end.
