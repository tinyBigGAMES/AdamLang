-------------------------------------------------------------------------------
  obj_err_lower.adam - Break step of obj (M3.10a .. M3.10e): every object
  form whose atom is later stops adam build with LW0001 at its node, never
  dropped: an object holding an own (M3.10c holds refs), a dynamic array
  whose elements need an init and a done (setlength builds no element yet),
  the vtable of an object that implements an interface (its per-object
  tables: M3.10f). Properties lower in every form (M3.10e3 / e4:
  obj_property_bits, obj_property_compound: a bitfield, a text += through
  a write's body). TBuilt's local is built and
  ended (M3.10b), the polymorphic TShape gets its vtable (M3.10d) and so
  does TNamed with its virtual property (M3.10e): none reports anything.
  Every local's slot is made before any is initialized (PLAN-SELFHOST S3),
  so the slot refusals (the owner, the array) come before the vtable's (the
  interface), and a local refused at its declaration is not reported again
  at its use (setlength on LA). Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/obj_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/obj_err_lower.adam(92,3): Error LW0001: code generation does not handle the owners in type 'THolder' yet
  | <DIR>/obj_err_lower.adam(95,3): Error LW0001: code generation does not handle the lifetime of type 'TBuilt' yet
  | <DIR>/obj_err_lower.adam(93,3): Error LW0001: code generation does not handle the interfaces of type 'TRuler' yet
@@end
*/

module exe obj_err_lower;

type
  TBuilt = object
    X: int32;

    init();
    begin
      self.X := 1;
    end;

    done;
    begin
      self.X := 0;
    end;
  end;

  TShape = object
    virtual method Area(): int32;
    begin
      return 1;
    end;
  end;

  THolder = object
    Item: own TBuilt;
  end;

  IMeasure = interface
    method Size(): int32;
  end;

  TRuler = object implements IMeasure
    virtual method Size(): int32;
    begin
      return 2;
    end;
  end;

  TNamed = object
    FName: string;
    virtual property Title: string read FName;
  end;

routine Forms();
var
  LB: TBuilt;
  LS: TShape;
  LH: THolder;
  LR: TRuler;
  LN: TNamed;
  LA: array of TBuilt;
begin
  setlength(LA, 1);
end;

begin
  Forms();
end.
