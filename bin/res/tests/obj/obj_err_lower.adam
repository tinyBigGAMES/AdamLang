-------------------------------------------------------------------------------
  obj_err_lower.adam - Break step of obj (M3.10a, M3.10b): every object form
  whose atom is later stops adam build with LW0001 at its node, never
  dropped: a virtual method (M3.10d), a local of a polymorphic type (its
  vptr), an object holding an own (M3.10c holds refs), a dynamic array whose elements
  need an init and a done (setlength builds no element yet). The local of
  TBuilt is built and ended (M3.10b) and reports nothing. Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "<DIR>/obj_err_lower.adam" "-o" "."
  exitcode 1
  | <DIR>/obj_err_lower.adam(54,5): Error LW0001: code generation does not handle the method 'Area' yet
  | <DIR>/obj_err_lower.adam(67,3): Error LW0001: code generation does not handle the lifetime of type 'TShape' yet
  | <DIR>/obj_err_lower.adam(68,3): Error LW0001: code generation does not handle the owners in type 'THolder' yet
  | <DIR>/obj_err_lower.adam(69,3): Error LW0001: code generation does not handle the lifetime of type 'TBuilt' yet
@@end
*/

module exe obj_err_lower;

type
  TBuilt = object
    X: int32;

    init();
    begin
      self.X := 1;
    end;

    done;
    begin
      self.X := 0;
    end;
  end;

  TShape = object
    virtual method Area(): int32;
    begin
      return 1;
    end;
  end;

  THolder = object
    Item: own TBuilt;
  end;

routine Forms();
var
  LB: TBuilt;
  LS: TShape;
  LH: THolder;
  LA: array of TBuilt;
begin
  setlength(LA, 1);
end;

begin
  Forms();
end.
