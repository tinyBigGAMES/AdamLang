-------------------------------------------------------------------------------
  obj_err_type_self.adam - a type naming itself in its own declaration (BNF sec 3,
  AUD4 5.1): a type is complete only after it, so an alias, an array, a
  pointer or a record field's routine type that names it needs
  `forward type` first (SM0003); its own routines and an object's body may
  name it (obj_member_names).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_type_self;

type
  TAlias = TAlias; // ERROR SM0003@12
  TGrid = array of TGrid; // ERROR SM0003@20
  TList = ptr to TList; // ERROR SM0003@18
  TShape = record
    Sides: int32;
    Area: routine(AS: ptr to TShape): int32; // ERROR SM0003@30
  end;

begin
end.
