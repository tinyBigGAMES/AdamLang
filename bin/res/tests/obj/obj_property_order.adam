-------------------------------------------------------------------------------
  obj_property_order.adam - a property bound to its field is written in
  BNF sec 4's order (PLAN-ADAM AUD1 c): `X := v` evaluates the object
  then the value, `X OP= v` the object, the value, the current value,
  each once; an int property, a string property (:= and +=), a set
  property, a record property, each on an array element picked by a call.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | index
  | value 5
  | index
  | value 1
  | 6
  | index
  | text b
  | index
  | text c
  | bc
  | index
  | value 3
  | true
  | index
  | value 4
  | 4
  | [Heap] Allocs: 1, Frees: 1, Leaked: 0
@@end
*/

module exe obj_property_order;

type
  TColor = choices(Red, Green, Blue);
  TColors = set of TColor;
  TPoint = record
    X: int32;
    Y: int32;
  end;
  TTemp = object
    FC: int32;
    FLog: string;
    FSet: TColors;
    FAt: TPoint;
    property Celsius: int32 read FC; write FC;
    property Log: string read FLog; write FLog;
    property Colors: TColors read FSet; write FSet;
    property At: TPoint read FAt; write FAt;
  end;

func Pick(const AValue: int32): int32;
begin
  println("value {}", AValue);
  return AValue;
end;

func Text(const AValue: string): string;
begin
  println("text {}", AValue);
  return AValue;
end;

func Colors(): TColors;
begin
  println("value 3");
  return [TColor.Blue];
end;

func Point(): TPoint;
begin
  println("value 4");
  return TPoint(X: 4, Y: 0);
end;

func Idx(): int32;
begin
  println("index");
  return 1;
end;

func Run();
var
  LA: array[0..1] of TTemp;
begin
  LA[Idx()].Celsius := Pick(5);
  LA[Idx()].Celsius += Pick(1);
  println("{}", LA[1].Celsius);
  LA[Idx()].Log := Text("b");
  LA[Idx()].Log += Text("c");
  println("{}", LA[1].Log);
  LA[Idx()].Colors += Colors();
  println("{}", TColor.Blue in LA[1].Colors);
  LA[Idx()].At := Point();
  println("{}", LA[1].At.X);
end;

begin
  Run();
end.
