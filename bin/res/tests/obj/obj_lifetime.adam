-------------------------------------------------------------------------------
  obj_lifetime.adam - init / done (M3.10b, BNF sec 4 D3): an object is built
  parent part first, then its fields in declaration order, then its init's
  body (an init with arguments and the one taking none, SEM's pick); it
  ends in reverse: its done's body, its fields from the last, its parent
  part. Locals end at the routine's exit, the last declared first; a type
  with no init or done of its own still builds and ends the fields that
  have them; a done that returns early still ends its parts; a module
  variable is built at the entry before the program block and ended after
  it. The order lines are the proof; the [Heap] line shows nothing
  leaked.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | init base
  | init part
  | init part
  | init widget g
  | main
  | init base
  | init part
  | init part
  | init widget a
  | init base
  | init part
  | init part
  | init widget anon
  | init part
  | scope
  | done part
  | done widget anon
  | done part
  | done part
  | done base
  | done widget a
  | done second
  | done part
  | done base
  | init part
  | done part
  | end
  | done widget g
  | done second
  | done part
  | done base
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe obj_lifetime;

type
  TPart = object
    Tag: string;

    init();
    begin
      self.Tag := "part";
      println("init part");
    end;

    done;
    begin
      println("done {}", self.Tag);
    end;
  end;

  TBase = object
    Label: string;

    init();
    begin
      self.Label := "base";
      println("init base");
    end;

    done;
    begin
      println("done base");
    end;
  end;

  TWidget = object(TBase)
    First: TPart;
    Second: TPart;
    Name: string;

    init(const AName: string);
    begin
      self.Name := AName;
      self.Second.Tag := "second";
      println("init widget {}", AName);
    end;

    init();
    begin
      self.Name := "anon";
      println("init widget anon");
    end;

    done;
    begin
      println("done widget {}", self.Name);
    end;
  end;

  // No init or done of its own: its field is built and ended all the same
  TNoInit = object
    P: TPart;
  end;

  // A done that returns early: its field is still ended
  TEarly = object
    Skip: bool;
    Inner: TPart;

    done;
    begin
      if self.Skip then
        return;
      end;
      println("done early");
    end;
  end;

var
  GW: TWidget("g");

routine Scope();
var
  LA: TWidget("a");
  LB: TWidget;
  LN: TNoInit;
begin
  println("scope");
end;

routine Early();
var
  LE: TEarly;
begin
  LE.Skip := true;
end;

begin
  println("main");
  Scope();
  Early();
  println("end");
end.
