-------------------------------------------------------------------------------
  obj_err_parent_word.adam - parent in a method (BNF sec 4, AUD4 5.1): only as
  parent.<member> (SM0016 for parent as a value), and only in a method of a
  type that has a parent (SM0012).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_parent_word;

type
  TA = object
    Z: int32;
    method Show(): int32;
    begin
      return parent.Show(); // ERROR SM0012@14
    end;
    method Get(): int32;
    begin
      return parent.Z; // ERROR SM0012@14
    end;
  end;
  TB = object(TA)
    method Copy(): TA;
    begin
      return parent; // ERROR SM0016@14
    end;
  end;

begin
end.
