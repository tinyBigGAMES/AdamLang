-------------------------------------------------------------------------------
  obj_err_property_use.adam - Break step of obj_property's uses (M3.10e2, BNF
  sec 4 property decl, PaskalCPP's O9 / O10 texts). A read changes nothing of
  self: no assignment, ++ or method call through self (SM0373; a const
  method and another object are fine). Read through self in its own read, or
  assigned through self in its own write, a property runs that accessor
  again forever (SM0374; another object's is fine). A property is no
  storage: no addr of (SM0376), no var argument (SM0405); ++ / -- run its
  read and write (his rule, 2026-11-10). An assignment to a property is a
  statement (SM0377). An indexed property is reached through its index
  (SM0378).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_property_use;

type
  TBox = object
    FX: int32;
    FY: int32;

    method Bump();
    begin
      self.FX := self.FX + 1;
    end;

    const method Peek(): int32;
    begin
      return self.FX;
    end;

    property X: int32 read FX; write FX;
    property Changes: int32
      read
      begin
        self.FX := 2; // ERROR SM0373@9: the read of 'Changes' cannot change 'self.FX': a read changes nothing of its object
        self.FY++; // ERROR SM0373@9: the read of 'Changes' cannot change 'self.FY': a read changes nothing of its object
        self.Bump(); // ERROR SM0373@9: the read of 'Changes' cannot call method 'self.Bump' through self: a read changes nothing of its object
        return self.Peek();
      end;
    property Again: int32
      read
      begin
        return self.Again; // ERROR SM0374@21: the read of 'Again' reads the property again, forever: read its field
      end;
      write (AValue)
      begin
        self.Again := AValue; // ERROR SM0374@14: the write of 'Again' assigns the property again, forever: assign its field
      end;
    property Items[AI: int32]: int32
      read
      begin
        if AI > 0 then
          return self.Items[AI - 1]; // ERROR SM0374@23: the read of 'Items' reads the property again, forever: read its field
        end;
        return AI;
      end;
    property Other: int32
      read
      var
        LBox: TBox;
      begin
        LBox.FX := 3;
        return LBox.Other + self.FX;
      end;
  end;

routine Take(var AV: int32);
begin
  AV := 1;
end;

routine Forms();
var
  LB: TBox;
  LP: ptr to int32;
  LV: int32;
begin
  LP := addr of LB.X; // ERROR SM0376@17: 'LB.X' is a property, not storage: addr of needs a variable (read it into one, or assign the property)
  Take(LB.X); // ERROR SM0405@8: var parameter 'AV' needs a variable of type 'int32'
  LV := LB.X := 1; // ERROR SM0377@9: an assignment to property 'X' is a statement: its write has no value
  LV := LB.Items; // ERROR SM0378@12: property 'Items' is indexed: write LB.Items[<index>]
  LB.X++;
  --LB.X;
  LV := LB.Items[2] + LB.Other;
end;

begin
  Forms();
end.
