-------------------------------------------------------------------------------
  obj_err_member_names.adam - member names (BNF sec 4, AUD4 5.1): a type's own
  members never share a name but methods (they overload, MO1: one with the
  parameter types of an earlier one is SM0324), nor do an overlay's or a
  choices' values (SM0004 at the later one); a field, method or property reuses no name of the parent chain, an
  inline record's members included (SM0309), but a method may reuse a parent
  method's name and a property a parent property's (obj_member_names).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_member_names;

type
  TDup = object
    method Put(const AN: int32);
    begin
    end;
    method Put(var AN: int32); // ERROR SM0324@5: 'TDup' has a method 'Put' with these parameter types already (line 34): methods overload by parameter types
    begin
    end;
  end;
  TFieldDup = object
    Put: int32;
    method Put(); // ERROR SM0004@5
    begin
    end;
  end;
  TColor = choices(Red, Green, Red); // ERROR SM0004@32
  TVariant = overlay
    A: int32;
    record
      A: int16; // ERROR SM0004@7
      B: int16;
    end;
  end;
  TA = object
    X: int32;
    method Show();
    begin
    end;
  end;
  TB = object(TA)
    X: int32; // ERROR SM0309@5
    Show: int32; // ERROR SM0309@5
  end;
  TC = object(TA)
    method X(): int32; // ERROR SM0309@5
    begin
      return 1;
    end;
  end;
  TMid = object(TA)
    Y: int32;
  end;
  TGrand = object(TMid)
    method X(); // ERROR SM0309@5
    begin
    end;
  end;
  TBase = object
    A: int32;
  end;
  TKid = object(TBase)
    FB: int32;
    property A: int32 read FB; // ERROR SM0309@5
  end;
  TRBase = record
    A: int32;
  end;
  TRMid = record(TRBase)
    B: int32;
  end;
  TR = record(TRMid)
    A: int32; // ERROR SM0309@5
    overlay
      B: int32; // ERROR SM0309@7
      F: float32;
    end;
  end;

begin
end.
