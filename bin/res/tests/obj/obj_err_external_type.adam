-------------------------------------------------------------------------------
  obj_err_external_type.adam - break step of obj_external_type (MO1b0a, BNF
  sec 3 / 4): a member of an external type with a body (PR0068); only an
  object or an interface type is external (PR0069); its clause names no
  symbol (PR0070); a generic type is never external (PR0071); a member of a
  plain object ending at its heading still wants its body (PR0001); an
  external type names its library (SM0743), extends only an external type
  of that library (SM0744) and is declared at module level only (SM0742).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_external_type;

type
  TBody = object
    method M(const AN: int64): int64;
    begin // ERROR PR0068@5
      return AN;
    end;
  end; external "obj_ext_lib";

  TRecord = record
    X: int64;
  end; external "obj_ext_lib"; // ERROR PR0069@8

  TGeneric<T> = object
    method M(const AX: T);
  end; external "obj_ext_lib"; // ERROR PR0071@8

  TNamed = object
    method M();
  end; external "obj_ext_lib" name "sym"; // ERROR PR0070@36

  TPlain = object
    method M();
  end; // ERROR PR0001@3

  TNoLib = object
    method M();
  end; external; // ERROR SM0743@8

  TBase = object
    virtual method V();
    begin
    end;
  end;

  TChildOf = object(TBase) // ERROR SM0744@3
    override method V();
  end; external "obj_ext_lib";

func Make();
type
  TInner = object // ERROR SM0742@3
    method M();
  end; external "obj_ext_lib";
begin
end;

begin
  Make();
end.
