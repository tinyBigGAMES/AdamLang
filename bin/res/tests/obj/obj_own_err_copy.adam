-------------------------------------------------------------------------------
  obj_own_err_copy.adam - Break step of obj_own (BNF sec 4 owner type, sec 6
  SM0427). An own moves, never copies: an own place given by value (:=, a
  value argument, a conversion to ref, return of a var parameter) is
  SM0427. A construction, a call's result, nil, return of a
  local and a const parameter (it binds) are fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_own_err_copy;

type
  TBox = object
    Value: int64;
  end;

routine Take(ABox: own TBox): int64;
begin
  return ABox.Value;
end;

routine Peek(const ABox: own TBox): int64;
begin
  return ABox.Value;
end;

routine Give(var ABox: own TBox): own TBox;
begin
  return ABox; // ERROR SM0427@10: 'ABox' would be copied here, and 'own TBox' cannot be copied: an own moves only from a call, a construction or return of a local
end;

routine Fresh(): own TBox;
var
  LBox: own TBox;
begin
  LBox := own TBox();
  return LBox;
end;

routine Run();
var
  LA: own TBox;
  LB: own TBox;
  LR: ref TBox;
  LN: int64;
begin
  LA := own TBox();
  LB := LA; // ERROR SM0427@9: 'LA' would be copied here, and 'own TBox' cannot be copied: an own moves only from a call, a construction or return of a local
  LN := Take(LA); // ERROR SM0427@14: 'LA' would be copied here, and 'own TBox' cannot be copied: an own moves only from a call, a construction or return of a local
  LR := LA; // ERROR SM0427@9: 'LA' would be copied here, and 'own TBox' cannot be copied: an own moves only from a call, a construction or return of a local
  LN := Peek(LA);
  LB := Fresh();
  LB := nil;
  LN := Take(own TBox());
  LN := LN + Give(LA).Value;
end;

begin
  Run();
end.
