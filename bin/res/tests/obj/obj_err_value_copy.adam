-------------------------------------------------------------------------------
  obj_err_value_copy.adam - Break step of obj_value_temp (M3.8g0b1,
  M3.10g): a value object that ends by a done and declares no copy is MOVED
  from a call's result or a returned local, never copied (BNF sec 4 O5): a
  local initialized from another local, an assignment from a local and a
  return of a const parameter are each SM0427 at the value, a hint at the
  done.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_value_copy;

type
  TNote = object
    Text: string;

    init(const AText: string);
    begin
      self.Text := AText;
    end;

    done; // HINT SM0427@5: 'TNote' ends by a done and declares no copy // HINT SM0427@5: 'TNote' ends by a done and declares no copy // HINT SM0427@5: 'TNote' ends by a done and declares no copy
    begin
      println("done {}", self.Text);
    end;
  end;

// A parameter is no local of the routine: returning it would copy it
routine Echo(const ANote: TNote): TNote;
begin
  return ANote; // ERROR SM0427@10: 'ANote' would be copied here, and 'TNote' cannot be copied: give it a copy, or move it (a call, a construction or return of a local)
end;

routine Run();
var
  LA: TNote("a");
  LB: TNote = LA; // ERROR SM0427@15: 'LA' would be copied here, and 'TNote' cannot be copied: give it a copy, or move it (a call, a construction or return of a local)
  LC: TNote("c");
begin
  LC := LA; // ERROR SM0427@9: 'LA' would be copied here, and 'TNote' cannot be copied: give it a copy, or move it (a call, a construction or return of a local)
  println("{}", Echo(LA).Text);
end;

begin
  Run();
end.
