-------------------------------------------------------------------------------
  obj_err_value_copy.adam - Break step of obj_value_temp (M3.8g0b1): a value
  object that ends by a done is MOVED from a call's result or a returned
  local, never copied yet (copy decls are later work): a local initialized
  from another local, an assignment from a local and a return of a
  parameter each stop adam build with LW0001 at their node, never dropped.
  Exit 1, no exe.
*******************************************************************************/

/*
@@test
  kind cli
  args "build" "--quiet" "<DIR>/obj_err_value_copy.adam" "-o" "."
  exitcode 1
  | <DIR>/obj_err_value_copy.adam(55,10): Error LW0001: code generation does not handle the lifetime of type 'TNote' yet
  | <DIR>/obj_err_value_copy.adam(61,15): Error LW0001: code generation does not handle the lifetime of type 'TNote' yet
  | <DIR>/obj_err_value_copy.adam(64,3): Error LW0001: code generation does not handle the lifetime of type 'TNote' yet
@@end
*/

module exe obj_err_value_copy;

type
  TNote = object
    Text: string;

    init(const AText: string);
    begin
      self.Text := AText;
    end;

    done;
    begin
      println("done {}", self.Text);
    end;
  end;

// A parameter is no local of the routine: returning it would copy it
routine Echo(const ANote: TNote): TNote;
begin
  return ANote;
end;

routine Run();
var
  LA: TNote("a");
  LB: TNote = LA;
  LC: TNote("c");
begin
  LC := LA;
  println("{}", Echo(LA).Text);
end;

begin
  Run();
end.
