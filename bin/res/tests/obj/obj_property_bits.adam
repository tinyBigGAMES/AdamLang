-------------------------------------------------------------------------------
  obj_property_bits.adam - properties bound to bitfields (M3.10e3, BNF sec 4:
  a bound field of the property's type, a bitfield too). Low, Signed and On
  read and write their bitfield: assigned, compound-assigned and stepped
  through its lane (a step past the width wraps, a signed one keeps its
  sign rule), the neighbours' bits as they were. High reads its bitfield and
  writes through a body; Into reads through a body and writes its bitfield.
  A virtual property bound to a bitfield gets functions made from it in its
  slots (TBase), TChild overrides its read; through a ref of TBase.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 5
  | 7
  | 0
  | -3
  | 9
  | true
  | 6 9 true
  | 5
  | 7
  | 30
  | 60
  | 20
  | 3
  | 3
  | 107
  | 9 7
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_property_bits;

type
  TFlags = object
    FLow: uint16 : 3;
    FSigned: int16 : 5;
    FOn: bool : 1;
    FHigh: uint16 : 6;

    property Low: uint16 read FLow; write FLow;
    property Signed: int16 read FSigned; write FSigned;
    property On: bool read FOn; write FOn;
    property High: uint16 read FHigh;
      write (AValue)
      begin
        self.FHigh := uint16(AValue + 1);
      end;
    property Into: uint16
      read
      begin
        return uint16(self.FLow * 10);
      end;
      write FHigh;
  end;

  TBase = object
    FTag: uint32 : 4;
    FBits: uint32 : 5;

    virtual property Bits: uint32 read FBits; write FBits;
    property Tag: uint32 read FTag; write FTag;
  end;

  TChild = object(TBase)
    override property Bits: uint32
      read
      begin
        return self.FBits + 100;
      end;
      write FBits;
  end;

// Every form through a value
func Values();
var
  LF: TFlags;
begin
  LF.Low := 5;
  println("{}", LF.Low);
  LF.Low += 2;
  println("{}", LF.Low);
  LF.Low++;
  println("{}", LF.Low);
  LF.Signed := -3;
  println("{}", LF.Signed);
  LF.Signed -= 20;
  println("{}", LF.Signed);
  LF.On := true;
  println("{}", LF.On);
  LF.Low := 6;
  println("{} {} {}", LF.Low, LF.Signed, LF.On);
  LF.High := 4;
  println("{}", LF.High);
  LF.High += 1;
  println("{}", LF.High);
  LF.Into := 30;
  println("{}", LF.FHigh);
  println("{}", LF.Into);
end;

// A virtual property bound to a bitfield, through a ref of the ancestor
func Refs();
var
  LA: ref TBase;
begin
  LA := ref TBase;
  LA.Tag := 3;
  LA.Bits := 20;
  println("{}", LA.Bits);
  LA.Bits += 15;
  println("{}", LA.Bits);
  println("{}", LA.Tag);
  LA := ref TChild;
  LA.Bits := 7;
  println("{}", LA.Bits);
  LA.Tag := 9;
  println("{} {}", LA.Tag, LA.FBits);
end;

begin
  Values();
  Refs();
  println("end");
end.
