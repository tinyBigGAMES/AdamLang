-------------------------------------------------------------------------------
  obj_overload_join.adam - a derived type's methods join its parent chain's
  overload set of their name (OV1, BNF sec 4): TLabel's Color(string) beside
  TWidget's Color(int64, int64) and Color(int64), each called through a
  TLabel, bare inside TLabel's own methods too; a method of the same
  parameter types replaces the parent's (Size); the pick ranks across the
  levels (Put(int32) of TLabel over Put(int64) of TWidget for an int32, the
  parent's for an int64); statics join as well (TLabel.Create() beside the
  inherited Create(int64)) and a restated static replaces (Kinds); a parent
  fluent `self` method keeps the derived type in a chain. Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | color role 1 2
  | color role 3
  | label color red
  | label size 4 5
  | label put32 7
  | widget put64 8
  | color role 9 9
  | create 0 label 1
  | kinds 2 1
  | color role 5 5
  | label color blue
  | chain blue
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_overload_join;

type
  TWidget = object
    FKind: int64;

    method Color(const ARole: int64; const AValue: int64): self;
    begin
      println("color role {} {}", ARole, AValue);
      return self;
    end;

    method Color(const ARole: int64): int64;
    begin
      println("color role {}", ARole);
      return ARole;
    end;

    method Size(const AW: int64; const AH: int64);
    begin
      println("widget size {} {}", AW, AH);
    end;

    method Put(const AN: int64);
    begin
      println("widget put64 {}", AN);
    end;

    static method Create(const AKind: int64): TWidget;
    var
      LW: TWidget;
    begin
      LW.FKind := AKind;
      return LW;
    end;

    static method Kinds(): int64;
    begin
      return 1;
    end;
  end;

  TLabel = object(TWidget)
    FText: string;

    method Color(const AName: string): self;
    begin
      self.FText := AName;
      println("label color {}", AName);
      return self;
    end;

    method Size(const AW: int64; const AH: int64);
    begin
      println("label size {} {}", AW, AH);
    end;

    method Put(const AN: int32);
    begin
      println("label put32 {}", AN);
    end;

    method Inside();
    begin
      // the parent's overload, through self inside the derived type
      self.Color(9, 9);
    end;

    static method Create(): TLabel;
    var
      LL: TLabel;
    begin
      LL.FKind := 1;
      return LL;
    end;

    static method Kinds(): int64;
    begin
      return 2;
    end;
  end;

var
  LLabel: TLabel;
  LWidget: TWidget;
  LN32: int32;
  LN64: int64;
  LRole: int64;
begin
  LLabel.Color(1, 2);
  LRole := LLabel.Color(3);
  LLabel.Color("red");
  LLabel.Size(4, 5);
  LN32 := 7;
  LN64 := 8;
  LLabel.Put(LN32);
  LLabel.Put(LN64);
  LLabel.Inside();
  LWidget := TLabel.Create(LRole - 3);
  LLabel := TLabel.Create();
  println("create {} label {}", LWidget.FKind, LLabel.FKind);
  println("kinds {} {}", TLabel.Kinds(), TWidget.Kinds());
  LLabel.Color(5, 5).Color("blue");
  println("chain {}", LLabel.FText);
end.
