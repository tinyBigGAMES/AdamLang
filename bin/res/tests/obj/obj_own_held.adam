  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  obj_own_held.adam - owners held in objects and arrays, and weak T
  (M3.10g, BNF sec 4 owner type, sec 7 alive / lock): an own field of an
  object ends its object with the holder; a ref held in a static array
  field; a weak watches a ref's object without keeping it (alive true while
  a ref holds it, false after the last ref goes, the block freed only once
  the weak lets go too); lock(W) gives a ref that keeps the object (nil once
  it is gone); a weak copied, passed by value, returned, compared with nil
  and with another, assigned nil; a weak field and an array of weaks in an
  object, released with it; a ref's object holding a weak to itself (no
  cycle: the weak keeps nothing alive). The [Heap] line shows every block
  freed.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | own 7
  | done 7
  | refs 1 2
  | done 1
  | done 2
  | alive true
  | lock 5
  | still true
  | done 5
  | alive false
  | lock nil true
  | copy false
  | passed true
  | returned true
  | same true
  | nil false
  | done 6
  | fields true true true
  | done 9
  | fields false false false
  | self 4
  | done 4
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_own_held;

type
  TItem = object
    V: int64;

    init(const AV: int64);
    begin
      self.V := AV;
    end;

    done;
    begin
      println("done {}", self.V);
    end;
  end;

  TOwner = object
    Item: own TItem;
  end;

  TRefs = object
    Items: array[0..1] of ref TItem;
  end;

  TWatch = object
    One: weak TItem;
    Many: array[0..1] of weak TItem;
  end;

  // a ref's object watching itself: the weak keeps nothing, so the last ref ends it
  TSelf = object
    Me: weak TSelf;
    V: int64;

    done;
    begin
      println("done {}", self.V);
    end;
  end;

func Owned();
var
  LO: TOwner;
begin
  LO.Item := own TItem(7);
  println("own {}", LO.Item.V);
end;

func Refs();
var
  LR: TRefs;
begin
  LR.Items[0] := ref TItem(1);
  LR.Items[1] := ref TItem(2);
  println("refs {} {}", LR.Items[0].V, LR.Items[1].V);
end;

func IsAlive(AW: weak TItem): bool;
begin
  return alive(AW);
end;

func Echo(const AW: weak TItem): weak TItem;
begin
  return AW;
end;

func Weaks();
var
  LR: ref TItem;
  LW: weak TItem;
  LCopy: weak TItem;
  LL: ref TItem;
begin
  LR := ref TItem(5);
  LW := LR;
  println("alive {}", alive(LW));
  LL := lock(LW);
  println("lock {}", LL.V);
  LR := nil;
  println("still {}", alive(LW));
  LL := nil;
  println("alive {}", alive(LW));
  LL := lock(LW);
  println("lock nil {}", LL = nil);
  LCopy := LW;
  println("copy {}", alive(LCopy));
  LR := ref TItem(6);
  LW := LR;
  println("passed {}", IsAlive(LW));
  println("returned {}", alive(Echo(LW)));
  LCopy := LW;
  println("same {}", LCopy = LW);
  LW := nil;
  println("nil {}", alive(LW));
  LR := nil;
end;

func Fields();
var
  LR: ref TItem;
  LW: TWatch;
begin
  LR := ref TItem(9);
  LW.One := LR;
  LW.Many[0] := LR;
  LW.Many[1] := LR;
  println("fields {} {} {}", alive(LW.One), alive(LW.Many[0]), alive(LW.Many[1]));
  LR := nil;
  println("fields {} {} {}", alive(LW.One), alive(LW.Many[0]), alive(LW.Many[1]));
end;

func Selfish();
var
  LS: ref TSelf;
begin
  LS := ref TSelf();
  LS.Me := LS;
  LS.V := 4;
  println("self {}", lock(LS.Me).V);
end;

begin
  Owned();
  Refs();
  Weaks();
  Fields();
  Selfish();
  println("end");
end.
