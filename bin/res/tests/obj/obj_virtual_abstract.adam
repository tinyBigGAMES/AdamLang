-------------------------------------------------------------------------------
  obj_virtual_abstract.adam - Break step of obj_virtual (M3.10d): an
  abstract method's vtable slot holds the runtime's AbstractCall. While
  TImpl's TBase part is built, its vptr is TBase's (as in C++), so TBase's
  init calling the abstract Hook (through the plain Start: a virtual called
  through self in an init is SM0348) reaches that slot: "abstract method
  called", exit 1, the heap report still printed, nothing after it runs.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 1
  | init base
  | abstract method called
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe obj_virtual_abstract;

type
  TBase = object
    init();
    begin
      println("init base");
      self.Start();
      println("not reached");
    end;

    virtual method Hook(); abstract;

    // Hook called through a plain method, as an init may (SM0348)
    method Start();
    begin
      self.Hook();
    end;
  end;

  TImpl = object(TBase)
    override method Hook();
    begin
      println("hook impl");
    end;
  end;

func Run();
var
  LI: TImpl;
begin
  LI.Hook();
  println("not reached");
end;

begin
  Run();
  println("not reached");
end.
