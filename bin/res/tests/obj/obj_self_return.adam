-------------------------------------------------------------------------------
  obj_self_return.adam - `: self` return type (BNF sec 3 method decl, F7): a
  method returning self hands back its receiver, no copy, typed as the
  receiver expression's static type. A chain on a value object works on one
  place and keeps the derived type (Caption after Widget's Name); a dispatched
  override returns self too; a field of the chain is the receiver's own place
  (read and written); assigning the call copies; a temporary receiver lives
  through its chain; a ref's chain is the same object (ref Button, assigned
  back into its own variable); a ptr's chain (`P->M()`) is the ptr. Nothing
  leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | chain ok 3 OK
  | ok 5
  | place 9
  | copy copy other
  | temp T
  | temp copy m 4
  | ref r R 4
  | ptr 11 P
  | w 2
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_self_return;

type
  Widget = object
    FName: string;
    FSize: int64;

    method Name(const AName: string): self;
    begin
      self.FName := AName;
      return self;
    end;

    method Size(const ASize: int64): self;
    begin
      self.FSize := ASize;
      return self;
    end;

    virtual method Grow(const AStep: int64): self;
    begin
      self.FSize := self.FSize + AStep;
      return self;
    end;

    const method Show(): self;
    begin
      println("{} {}", self.FName, self.FSize);
      return self;
    end;
  end;

  Button = object(Widget)
    FLabel: string;

    method Caption(const AText: string): self;
    begin
      self.FLabel := AText;
      return self;
    end;

    override method Grow(const AStep: int64): self;
    begin
      self.FSize := self.FSize + AStep * 2;
      return self;
    end;
  end;

// A Button named AName, handed back by value: a temporary receiver for a chain
func MakeButton(const AName: string): Button;
var
  LB: Button;
begin
  LB.Name(AName);
  return LB;
end;

var
  LB: Button;
  LC: Button;
  LW: Widget;
  LR: ref Button;
  LP: ptr to Button;
begin
  // Widget's Name and Size hand back a Button here: Caption follows them
  LB.Name("ok").Size(3).Caption("OK");
  println("chain {} {} {}", LB.FName, LB.FSize, LB.FLabel);
  // Button's override runs (dispatched), then Show on the same object
  LB.Grow(1).Show();
  // the call is LB's own place: its field written through it
  LB.Size(7).FSize := 9;
  println("place {}", LB.FSize);
  // assigning the call copies: LC is a Button of its own
  LC := LB.Name("copy");
  LC.Name("other");
  println("copy {} {}", LB.FName, LC.FName);
  // a temporary receiver: the chain's field read from it, then a copy of it kept
  println("temp {}", MakeButton("t").Caption("T").FLabel);
  LC := MakeButton("m").Size(4);
  println("temp copy {} {}", LC.FName, LC.FSize);
  // a ref's chain is the ref: the one object, assigned back into its own variable
  LR := ref Button;
  LR.Name("r").Caption("R").Size(2);
  LR := LR.Grow(1);
  println("ref {} {} {}", LR.FName, LR.FLabel, LR.FSize);
  // a ptr's chain is the ptr
  LP := addr of LB;
  LP->Size(11)->Caption("P");
  println("ptr {} {}", LB.FSize, LB.FLabel);
  // Widget's own Grow on a Widget
  LW.Name("w").Grow(2).Show();
  println("end");
end.
