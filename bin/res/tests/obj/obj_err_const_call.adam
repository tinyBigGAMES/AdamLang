-------------------------------------------------------------------------------
  obj_err_const_call.adam - a const object (BNF sec 4, AUD4 5.1): a method that may
  change it is never called through it (SM0426), nor is its property
  written (SM0255): a const parameter, a field of one, an element of a const
  array.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_const_call;

type
  TA = object
    N: int32;
    FN: int32;
    method Bump();
    begin
      self.N := self.N + 1;
    end;
    property P: int32 read FN; write FN;
  end;
  THolder = object
    Inner: TA;
  end;
  TList = array[0..1] of TA;

func Touch(const AA: TA; const AH: THolder; const AL: TList);
begin
  AA.Bump(); // ERROR SM0426@3
  AH.Inner.Bump(); // ERROR SM0426@3
  AL[1].Bump(); // ERROR SM0426@3
  AA.P := 1; // ERROR SM0255@3
end;

begin
end.
