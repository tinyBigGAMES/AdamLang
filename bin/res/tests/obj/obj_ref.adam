-------------------------------------------------------------------------------
  obj_ref.adam - ref T (M3.10c, BNF sec 4 owner type, sec 6 owner new): a
  shared owner of an object on the heap. `ref T(args)` builds it through its
  init, `ref T` through the one taking none; a copy shares it, and the last
  holder letting go (nil, a new value, its scope ending) runs its done, ends
  its fields and frees it. Reached through it: a field read and write, a
  method call, a chain `LH.Next.Next.Value`. A ref is a parameter, a result,
  a field of an object, an element of a static and a dynamic array, and
  compares with nil and with another ref (the same object). A ref of a
  descendant goes into a ref of its ancestor and still frees the whole
  object. The done lines show when each one ends; the [Adam Heap] line shows
  nothing leaked.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | starts nil
  | init a
  | a still held
  | show a2
  | init b
  | done a2
  | a released
  | sharing end
  | done b
  | 1
  | 2
  | 3
  | 6
  | done node
  | 1
  | done node
  | 2
  | done node
  | 3
  | chain end
  | init h
  | show h
  | init s0
  | show s0
  | init d0
  | same
  | differ
  | show d0
  | peek d0
  | fields end
  | done d0
  | done s0
  | done h
  | init n
  | 7
  | done tag
  | 7
  | ancestor end
  | done n
  | end
  | [Adam Heap] Allocs: 11, Frees: 11, Leaked: 0
@@end
*/

module exe obj_ref;

routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
var
  LBuf: array[0..31] of char;
begin
  puts(_i64toa(AValue, addr of LBuf[0], 10));
end;

type
  TNote = object
    Text: string;

    init(const AText: string);
    begin
      self.Text := AText;
      println("init {}", AText);
    end;

    done;
    begin
      println("done {}", self.Text);
    end;

    method Show();
    begin
      println("show {}", self.Text);
    end;
  end;

  // A chain through refs: releasing the head releases the rest in turn
  TNode = object
    Value: int64;
    Next: ref TNode;

    done;
    begin
      println("done node");
      ShowInt(self.Value);
    end;
  end;

  THolder = object
    Item: ref TNote;
  end;

  TTag = object
    Id: int64;

    done;
    begin
      println("done tag");
      ShowInt(self.Id);
    end;
  end;

  // A descendant with a managed field: freed whole through a ref of TTag
  TBigTag = object(TTag)
    Note: string;
  end;

routine Make(const AText: string): ref TNote;
begin
  return ref TNote(AText);
end;

routine Peek(const AR: ref TNote);
begin
  AR.Show();
  println("peek {}", AR.Text);
end;

routine Sharing();
var
  LA: ref TNote;
  LB: ref TNote;
begin
  if LA = nil then
    println("starts nil");
  end;
  LA := ref TNote("a");
  LB := LA;
  LA := nil;
  println("a still held");
  LB.Text := "a2";
  LB.Show();
  LB := ref TNote("b");
  println("a released");
  LA := LB;
  LB := nil;
  println("sharing end");
end;

routine Chain();
var
  LHead: ref TNode;
  LN: ref TNode;
  LSum: int64;
begin
  LHead := ref TNode;
  LHead.Value := 1;
  LN := ref TNode;
  LN.Value := 2;
  LHead.Next := LN;
  LN := ref TNode;
  LN.Value := 3;
  LHead.Next.Next := LN;
  LN := nil;
  ShowInt(LHead.Value);
  ShowInt(LHead.Next.Value);
  ShowInt(LHead.Next.Next.Value);
  LSum := 0;
  LN := LHead;
  while LN <> nil do
    LSum := LSum + LN.Value;
    LN := LN.Next;
  end;
  ShowInt(LSum);
  LHead := nil;
  println("chain end");
end;

routine Fields();
var
  LH: THolder;
  LS: array[0..1] of ref TNote;
  LD: array of ref TNote;
begin
  LH.Item := Make("h");
  LH.Item.Show();
  LS[0] := Make("s0");
  LS[1] := LS[0];
  LS[0] := nil;
  LS[1].Show();
  setlength(LD, 2);
  LD[0] := Make("d0");
  LD[1] := LD[0];
  if LD[0] = LD[1] then
    println("same");
  end;
  if LH.Item <> LD[0] then
    println("differ");
  end;
  Peek(LD[1]);
  setlength(LD, 1);
  println("fields end");
end;

routine Ancestor();
var
  LBig: ref TBigTag;
  LT: ref TTag;
begin
  LBig := ref TBigTag;
  LBig.Id := 7;
  LBig.Note := Make("n").Text;
  LT := LBig;
  LBig := nil;
  ShowInt(LT.Id);
  LT := nil;
  println("ancestor end");
end;

begin
  Sharing();
  Chain();
  Fields();
  Ancestor();
  println("end");
end.
