-------------------------------------------------------------------------------
  obj_err_property.adam - Break step of obj_property (M3.10e, BNF sec 4
  object members, PaskalCPP's rules). A bound accessor names a field of its
  object's chain (SM0371: no such member, or a method), of the property's
  type exactly (SM0372); default goes on an indexed property (SM0379: none
  on a plain one), one per type (SM0379: a second one). A parent's field
  binds, a write's value takes the property's type, and one default with
  its index is fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_property;

type
  TBase = object
    FKept: int64;
  end;

  TBad = object(TBase)
    FN: int32;
    FText: string;

    method Peek(): int32;
    begin
      return self.FN;
    end;

    property Missing: int32 read FNone; // ERROR SM0371@29: property 'Missing' binds 'FNone', which is no field of 'TBad': name a field, or write the accessor with a body
    property Method: int32 read Peek; // ERROR SM0371@28: property 'Method' binds 'Peek', which is no field of 'TBad': name a field, or write the accessor with a body
    property Wrong: int64 read FN; // ERROR SM0372@27: property 'Wrong' is 'int64', and its field 'FN' is 'int32': a bound field has the property's type
    property Typed: int32 read FN; write FText; // ERROR SM0372@36: property 'Typed' is 'int32', and its field 'FText' is 'string': a bound field has the property's type
    property Inherited: int64 read FKept; write FKept;
    property Valued: int32 read FN;
      write (AValue)
      begin
        self.FN := AValue + 1;
      end;
    property Plain: int32 read FN; default; // ERROR SM0379@5: property 'Plain' has no index: default names an indexed property, which X[i] means
    property First[AIndex: int64]: int32
      read
      begin
        return self.FN;
      end;
      default;
    property Second[AIndex: int64]: int32 // ERROR SM0379@5: property 'Second' is a second default of 'TBad': 'First' is its default already
      read
      begin
        return self.FN;
      end;
      default;
  end;

begin
end.
