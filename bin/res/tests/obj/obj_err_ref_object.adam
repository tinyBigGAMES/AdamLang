-------------------------------------------------------------------------------
  obj_err_ref_object.adam - break step of obj_ref_object (BNF sec 4, F2a0): a
  ref object is never held as a value (SM0758 at the type): an object field,
  an embed, a value parameter, a result, a variable, a descendant's
  variable, a static or dynamic array of one; a const parameter of it, a
  ref / weak field and an array of refs are fine. A plain object's self in a
  func literal is SM0755 (it may be a value or an embed).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_ref_object;

type
  Item = ref object
    V: int64;
  end;

  Child = object(Item)
  end;

  Plain = object
    V: int64;

    method Wire();
    var
      LF: ref func(): int64;
    begin
      LF := func(): int64 begin return self.V; end; // ERROR SM0755@40
    end;
  end;

  Holder = object
    Slot: Item; // ERROR SM0758@11
  end;

  Wrap = object
    embed Inner: Item; // ERROR SM0758@18
  end;

  Keeps = object
    One: ref Item;
    Two: weak Item;
    Many: array of ref Item;
  end;

func Take(const AItem: Item);
begin
end;

func ByValue(AItem: Item); // ERROR SM0758@21
begin
end;

func Give(): Item; // ERROR SM0758@14
begin
  while true do
  end;
end;

var
  GItem: Item; // ERROR SM0758@10
  GChild: Child; // ERROR SM0758@11
  GArray: array[0..1] of Item; // ERROR SM0758@11
  GList: array of Child; // ERROR SM0758@10
  GRef: ref Item;

begin
end.
