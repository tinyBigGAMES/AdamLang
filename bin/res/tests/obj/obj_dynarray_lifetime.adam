-------------------------------------------------------------------------------
  obj_dynarray_lifetime.adam - dynamic arrays of value objects whose type runs
  code where they are built, copied or ended (M3.10g g5): setlength builds
  each added element from the first (its init, a polymorphic element's vptr:
  its virtual method runs its own type's) and ends each dropped one from the
  last (its done); a block two arrays share is copied on the first write by
  the elements' copy, element by element; the last holder's release ends
  every element, the last first; an array field of a ref's object ends with
  its object, after the object's done. The order lines are the proof; the
  [Heap] line shows nothing leaked.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | init 1
  | init 2
  | init 3
  | done 3
  | done 2
  | last 1
  | done 1
  | init 1
  | init 2
  | copy 101
  | copy 102
  | a 1 b 50
  | done 102
  | done 50
  | done 2
  | done 1
  | init 1
  | done bag
  | done 1
  | kind cell
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_dynarray_lifetime;

var
  Counter: int64;

type
  // Built, copied and ended by its own code
  TItem = object
    Id: int64;

    init();
    begin
      Counter := Counter + 1;
      self.Id := Counter;
      println("init {}", self.Id);
    end;

    copy(const ASource: TItem);
    begin
      self.Id := ASource.Id + 100;
      println("copy {}", self.Id);
    end;

    done;
    begin
      println("done {}", self.Id);
    end;
  end;

  // A ref's object holding an array of items: they end after its done
  TBag = object
    Items: array of TItem;

    done;
    begin
      println("done bag");
    end;
  end;

  TShape = object
    virtual method Kind(): string;
    begin
      return "shape";
    end;
  end;

  // A polymorphic element with no init: only its vptr is set as it is built
  TCell = object(TShape)
    override method Kind(): string;
    begin
      return "cell";
    end;
  end;

routine Grow();
var
  LItems: array of TItem;
begin
  setlength(LItems, 2);
  setlength(LItems, 3);
  setlength(LItems, 1);
  println("last {}", LItems[0].Id);
end;

routine Share();
var
  LA: array of TItem;
  LB: array of TItem;
begin
  setlength(LA, 2);
  LB := LA;
  LB[0].Id := 50;
  println("a {} b {}", LA[0].Id, LB[0].Id);
  setlength(LB, 0);
  setlength(LA, 0);
end;

routine Bag();
var
  LBag: ref TBag;
begin
  LBag := ref TBag();
  setlength(LBag.Items, 1);
end;

routine Shapes();
var
  LCells: array of TCell;
begin
  setlength(LCells, 2);
  println("kind {}", LCells[1].Kind());
end;

begin
  Counter := 0;
  Grow();
  Counter := 0;
  Share();
  Counter := 0;
  Bag();
  Shapes();
  println("end");
end.
