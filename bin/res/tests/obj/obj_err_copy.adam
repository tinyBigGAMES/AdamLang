-------------------------------------------------------------------------------
  obj_err_copy.adam - Break step of obj_copy (BNF sec 4 O5): a copy decl
  takes one const parameter of its own type (SM0353), one per type
  (SM0354), and its type's parent must be copyable (SM0355, a hint at the
  reason). A value whose type cannot be copied (a done and no copy, in
  itself or a part) is SM0427 where it would be copied, a hint at the
  reason (the done, or the part holding one); a call's result, a
  construction, return of a local and a const parameter are fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_copy;

type
  TNote = object
    Text: string;

    done; // HINT SM0427@5: 'TNote' ends by a done and declares no copy // HINT SM0427@5: 'TNote' ends by a done and declares no copy // HINT SM0427@5: 'TNote' ends by a done and declares no copy // HINT SM0427@5: 'TNote' ends by a done and declares no copy // HINT SM0427@5: 'TNote' ends by a done and declares no copy
    begin
      self.Text := "";
    end;
  end;

  TWrap = object
    Note: TNote; // HINT SM0427@5: 'TWrap' holds a 'TNote' here, which cannot be copied
  end;

  TTwice = object
    V: int64;

    copy(const ASource: TTwice);
    begin
      self.V := ASource.V;
    end;

    copy(const ASource: TTwice; const AExtra: int64); // ERROR SM0354@5: 'TTwice' declares a copy already: one copy per type // ERROR SM0353@5: a copy takes one const parameter of its own type: copy(const ASource: TTwice)
    begin
      self.V := AExtra;
    end;
  end;

  TNotConst = object
    copy(ASource: TNotConst); // ERROR SM0353@5: a copy takes one const parameter of its own type: copy(const ASource: TNotConst)
    begin
    end;
  end;

  TOtherType = object
    copy(const ASource: int64); // ERROR SM0353@5: a copy takes one const parameter of its own type: copy(const ASource: TOtherType)
    begin
    end;
  end;

  TKid = object(TNote)
    copy(const ASource: TKid); // ERROR SM0355@5: 'TNote' cannot be copied, so its descendant 'TKid' cannot declare a copy
    begin
    end;
  end;

routine Keep(ANote: TNote);
begin
end;

routine Look(const ANote: TNote);
begin
end;

routine Make(): TNote;
var
  LNote: TNote;
begin
  return LNote;
end;

routine Echo(const ANote: TNote): TNote;
begin
  return ANote; // ERROR SM0427@10: 'ANote' would be copied here, and 'TNote' cannot be copied: give it a copy, or move it (a call, a construction or return of a local)
end;

routine Run();
var
  LA: TNote;
  LB: TNote = LA; // ERROR SM0427@15: 'LA' would be copied here, and 'TNote' cannot be copied: give it a copy, or move it (a call, a construction or return of a local)
  LW: TWrap;
  LX: TWrap;
begin
  LB := LA; // ERROR SM0427@9: 'LA' would be copied here, and 'TNote' cannot be copied: give it a copy, or move it (a call, a construction or return of a local)
  Keep(LA); // ERROR SM0427@8: 'LA' would be copied here, and 'TNote' cannot be copied: give it a copy, or move it (a call, a construction or return of a local)
  Look(LA);
  LB := Make();
  Keep(Make());
  LX := LW; // ERROR SM0427@9: 'LW' would be copied here, and 'TWrap' cannot be copied: give it a copy, or move it (a call, a construction or return of a local)
end;

begin
  Run();
end.
