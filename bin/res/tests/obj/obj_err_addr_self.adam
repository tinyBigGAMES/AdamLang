-------------------------------------------------------------------------------
  obj_err_addr_self.adam - `addr of` in a const method (BNF sec 4 / 6): self
  and every place of its own storage (a field, a field's element) give a ptr
  to const there, so a ptr to its type is SM0200; through a pointer field it
  is another object's storage and stays writable.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_addr_self;

type
  Pos = record
    X: int32;
  end;

  Holder = object
    FPos: Pos;
    FItems: array[0..1] of int32;
    FOther: ptr to Pos;

    const method Whole(): int32;
    var
      LP: ptr to Holder;
    begin
      LP := addr of self; // ERROR SM0200@13
      return 0;
    end;

    const method Field(): int32;
    var
      LP: ptr to Pos;
    begin
      LP := addr of self.FPos; // ERROR SM0200@13
      return 0;
    end;

    const method Element(): int32;
    var
      LP: ptr to int32;
    begin
      LP := addr of self.FItems[1]; // ERROR SM0200@13
      return 0;
    end;

    const method Other(): int32;
    var
      LP: ptr to int32;
    begin
      LP := addr of self.FOther^.X;
      return LP^;
    end;
  end;

begin
end.
