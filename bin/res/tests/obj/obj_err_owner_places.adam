  obj_err_owner_places.adam - Break step of objects (AUD5): an owner or an
  object held by a record is SM0357 at the field's type, an own of a type
  that is no object SM0358 at that type, an init's result type PR0059 at
  the type (pcpp's places)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_owner_places;

type
  TO = object
    N: int32;
    init(): int32; // ERROR PR0059@13
    begin
    end;
  end;

  TR = record
    A: TO; // ERROR SM0357@8
    B: own TO; // ERROR SM0357@8
  end;

var
  LI: own int32; // ERROR SM0358@11

begin
end.
