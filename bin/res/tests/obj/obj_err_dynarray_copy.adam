-------------------------------------------------------------------------------
  obj_err_dynarray_copy.adam - Break step of obj_dynarray_lifetime (BNF sec 4
  O5): a dynamic array copies as its elements do, so an array of a type that
  ends by a done and declares no copy cannot be copied (SM0427, a hint at the
  done); a call's result moves, and setlength of such an array is fine.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_dynarray_copy;

type
  TNote = object
    Id: int64;

    done; // HINT SM0427@5: 'TNote' ends by a done and declares no copy
    begin
      self.Id := 0;
    end;
  end;

func Make(): array of TNote;
var
  LNotes: array of TNote;
begin
  setlength(LNotes, 2);
  return LNotes;
end;

func Run();
var
  LA: array of TNote;
  LB: array of TNote;
begin
  LA := Make();
  LB := LA; // ERROR SM0427@9: 'LA' would be copied here, and 'array of TNote' cannot be copied: give it a copy, or move it (a call, a construction or return of a local)
end;

begin
  Run();
end.
