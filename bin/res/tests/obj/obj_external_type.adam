-------------------------------------------------------------------------------
  obj_external_type.adam - external object types (MO1b0a, BNF sec 3 / 4):
  types another binary has (a dll's or a static lib's), each followed by
  `external "lib";`: every member a heading only (init, done, overloaded
  methods, a virtual and its override, an interface's overloads, a
  property over a field), a parent and an interface external from the same
  library. The front end takes them clean.
*******************************************************************************/

/*
@@test
  kind check
@@end
*/

module exe obj_external_type;

type
  IShape = interface
    method Area(): int64;
    method Area(const AScale: int64): int64;
  end; external "obj_ext_lib";

  TCounter = object implements IShape
    Total: int64;

    init(const AStart: int64);
    done;
    method Add(const AX: int32): int64;
    method Add(const AX: float64): int64;
    method Add(const AX: int32; const AY: int32): int64;
    virtual method Kind(): string;
    virtual method Area(): int64;
    virtual method Area(const AScale: int64): int64;
    property Count: int64 read Total;
  end; external "obj_ext_lib";

  TBigCounter = object(TCounter)
    init(const AStart: int64);
    override method Kind(): string;
  end; external "obj_ext_lib";

begin
end.
