-------------------------------------------------------------------------------
  obj_init_lead.adam - An init's lead calls (BNF sec 4 D3): parent.init(...)
  builds the parent part and self.F.init(...) the type's own fields with
  the init their arguments pick (overloads included), parameters in the
  arguments; a part no lead call builds takes its init without arguments;
  a field whose type declares no init takes an empty lead call (it builds
  nothing); a copy's leads build its fields (its parent part is copied);
  an abstract parent is built by its lead call. The
  order lines are the proof: parent first, then the fields in declaration
  order, then the init's body; done in reverse.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | base 10
  | part 6
  | part 7
  | kid 5
  | base 1
  | part 2
  | part 0
  | kid 0
  | base copy 10
  | part 106
  | part 107
  | kid copy
  | 10 6 7 0
  | 1 2 0 0
  | 10 106 107 0
  | shape 3
  | square 3
  | area 9
  | done part 107
  | done part 106
  | done base 10
  | done part 0
  | done part 2
  | done base 1
  | done part 7
  | done part 6
  | done base 10
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_init_lead;

type
  Base = object
    FV: int32;

    init(const AV: int32);
    begin
      self.FV := AV;
      println("base {}", AV);
    end;

    copy(const ASource: Base);
    begin
      self.FV := ASource.FV;
      println("base copy {}", ASource.FV);
    end;

    done;
    begin
      println("done base {}", self.FV);
    end;
  end;

  Part = object
    FP: int32;

    init();
    begin
      self.FP := 0;
      println("part 0");
    end;

    init(const AP: int32);
    begin
      self.FP := AP;
      println("part {}", AP);
    end;

    copy(const ASource: Part);
    begin
      self.FP := ASource.FP;
      println("part copy {}", ASource.FP);
    end;

    done;
    begin
      println("done part {}", self.FP);
    end;
  end;

  Plain = object
    FN: int32;
  end;

  Kid = object(Base)
    FPart: Part;
    FOther: Part;
    FPlain: Plain;

    init(const AV: int32);
    begin
      parent.init(AV * 2);
      self.FPart.init(AV + 1);
      self.FOther.init(AV + 2);
      self.FPlain.init();
      println("kid {}", AV);
    end;

    init();
    begin
      parent.init(1);
      self.FPart.init(2);
      println("kid 0");
    end;

    copy(const ASource: Kid);
    begin
      self.FPart.init(ASource.FPart.FP + 100);
      self.FOther.init(ASource.FOther.FP + 100);
      self.FPlain.init();
      println("kid copy");
    end;
  end;

  Shape = object
    FSide: int32;

    init(const ASide: int32);
    begin
      self.FSide := ASide;
      println("shape {}", ASide);
    end;

    virtual method Area(): int32; abstract;
  end;

  Square = object(Shape)
    init(const ASide: int32);
    begin
      parent.init(ASide);
      println("square {}", ASide);
    end;

    override method Area(): int32;
    begin
      return self.FSide * self.FSide;
    end;
  end;

func Show();
var
  LS: Square(3);
begin
  println("area {}", LS.Area());
end;

func Run();
var
  LK: Kid(5);
  LZ: Kid();
  LC: Kid = LK;
begin
  println("{} {} {} {}", LK.FV, LK.FPart.FP, LK.FOther.FP, LK.FPlain.FN);
  println("{} {} {} {}", LZ.FV, LZ.FPart.FP, LZ.FOther.FP, LZ.FPlain.FN);
  println("{} {} {} {}", LC.FV, LC.FPart.FP, LC.FOther.FP, LC.FPlain.FN);
  Show();
end;

begin
  Run();
end.
