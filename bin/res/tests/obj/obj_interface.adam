-------------------------------------------------------------------------------
  obj_interface.adam - interfaces (I2, BNF sec 4 interface type, DESIGN
  sec 8): an object holds one itable word per interface it implements, an
  interface value is that word's address and its itable (one per concrete
  type) names the concrete type's implementations. Calls through a const
  parameter, a var parameter and a ptr to (nil stays nil) of an interface;
  a parent interface's method through the child interface, and the child
  interface given where its parent is wanted; an override below the
  implementing level runs (TSquare); a level above supplies the method
  (TBorrow over TPlain's Show); two interfaces on one object (two words);
  a level that implements again an interface a level above implements
  shares its word (TCube); an object with a plain parent (TCounted over
  TData: the vptr at 0, the parent after it), its parent part reached by a
  const parameter of the parent too; an object field converted; self
  given as an interface; a const method and arguments through the itable.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | base 6 base
  | square 16 square
  | cube 27 cube
  | borrow 7
  | named base
  | named square
  | named via shape square
  | count 3 bump 4
  | data 5
  | count 4 bump 5
  | ptr 16 square
  | nil stays nil
  | scaled 54
  | field 6 base
  | self 16 square
  | var 16
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_interface;

type
  INamed = interface
    const method Name(): string;
  end;

  IShape = interface(INamed)
    method Area(): int64;
    method Scaled(const AFactor: int64; const AExtra: int64): int64;
  end;

  ICount = interface
    method Count(): int64;
    method Bump(): int64;
  end;

  IShow = interface
    method Show(): int64;
  end;

// TSquare.ShowSelf gives self to it
forward routine Report(const ALabel: string; const AShape: IShape);

type
  TBase = object implements IShape
    Side: int64;

    init();
    begin
      self.Side := 2;
    end;

    virtual const method Name(): string;
    begin
      return "base";
    end;

    virtual method Area(): int64;
    begin
      return self.Side * 3;
    end;

    virtual method Scaled(const AFactor: int64; const AExtra: int64): int64;
    begin
      return self.Area() * AFactor + AExtra;
    end;
  end;

  TSquare = object(TBase)
    init();
    begin
      self.Side := 4;
    end;

    override const method Name(): string;
    begin
      return "square";
    end;

    override method Area(): int64;
    begin
      return self.Side * self.Side;
    end;

    method ShowSelf();
    begin
      Report("self", self);
    end;
  end;

  TCube = object(TSquare) implements IShape, ICount
    N: int64;

    init();
    begin
      self.Side := 3;
      self.N := 1;
    end;

    override const method Name(): string;
    begin
      return "cube";
    end;

    override method Area(): int64;
    begin
      return self.Side * self.Side * self.Side;
    end;

    virtual method Count(): int64;
    begin
      return self.N;
    end;

    virtual method Bump(): int64;
    begin
      self.N := self.N + 1;
      return self.N;
    end;
  end;

  TPlain = object
    virtual method Show(): int64;
    begin
      return 7;
    end;
  end;

  TBorrow = object(TPlain) implements IShow
  end;

  TData = object
    Value: int64;
  end;

  TCounted = object(TData) implements ICount
    N: int64;

    virtual method Count(): int64;
    begin
      return self.N;
    end;

    virtual method Bump(): int64;
    begin
      self.N := self.N + 1;
      return self.N;
    end;
  end;

  THolder = object
    Tag: int64;
    Item: TBase;
  end;

routine Report(const ALabel: string; const AShape: IShape);
begin
  println("{} {} {}", ALabel, AShape.Area(), AShape.Name());
end;

routine Named(const ANamed: INamed);
begin
  println("named {}", ANamed.Name());
end;

routine NamedVia(const AShape: IShape);
begin
  println("named via shape {}", AShape.Name());
end;

routine Counts(const ACount: ICount);
var
  LBefore: int64;
begin
  LBefore := ACount.Count();
  println("count {} bump {}", LBefore, ACount.Bump());
end;

routine Data(const AData: TData);
begin
  println("data {}", AData.Value);
end;

routine Through(const AShape: ptr to IShape);
begin
  if AShape = nil then
    println("nil stays nil");
    return;
  end;
  println("ptr {} {}", AShape->Area(), AShape->Name());
end;

routine VarShape(var AShape: IShape);
begin
  println("var {}", AShape.Area());
end;

routine Tests();
var
  LBase: TBase;
  LSquare: TSquare;
  LCube: TCube;
  LBorrow: TBorrow;
  LCounted: TCounted;
  LHolder: THolder;
  LShow: ptr to IShow;
  LP: ptr to IShape;
  LNone: ptr to TSquare;
begin
  Report("base", LBase);
  Report("square", LSquare);
  Report("cube", LCube);
  LShow := addr of LBorrow;
  println("borrow {}", LShow->Show());
  Named(LBase);
  Named(LSquare);
  NamedVia(LSquare);
  LCube.N := 3;
  Counts(LCube);
  LCounted.Value := 5;
  LCounted.N := 4;
  Data(LCounted);
  Counts(LCounted);
  LP := addr of LSquare;
  Through(LP);
  LNone := nil;
  Through(LNone);
  println("scaled {}", LP->Scaled(3, 6));
  LHolder.Tag := 1;
  Report("field", LHolder.Item);
  LSquare.ShowSelf();
  VarShape(LSquare);
end;

begin
  Tests();
  println("end");
end.
