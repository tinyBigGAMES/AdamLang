-------------------------------------------------------------------------------
  obj_operator.adam - declared operators (I5, BNF sec 4 operator decl): a
  record's and an object's operators run for `a OP b`, `-a`, = / <> (a
  pair), < <= > >= and `in`, each a routine called with the operands as its
  arguments (by value or const). Several of one symbol: the one the
  operands' exact types pick (TVec * int64, TVec * float64, int64 * TVec);
  either operand's type may declare it; a record extension's value runs
  its parent's operator; nested operators, one in a condition, a member of
  an operator's result, an operator in another operator's body; a text
  result and an object result that runs a done (moved out, ended once).
  Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | add 4 6
  | sub -2 -2
  | neg -1 -2
  | scale 2 4
  | scalef 4 6
  | lscale 3 6
  | div 1 1 mod 1 0 half 0.5
  | eq true false ne false true
  | lt true le true gt false ge true
  | chain 7 10
  | x 4
  | in true false
  | ext 11 22
  | name ab-cd
  | made a+b
  | done a+b
  | temp a+b
  | done a+b
  | done b
  | done a
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_operator;

type
  TVec = record
    X: int64;
    Y: int64;

    operator +(const A: TVec; const B: TVec): TVec;
    var
      LR: TVec;
    begin
      LR.X := A.X + B.X;
      LR.Y := A.Y + B.Y;
      return LR;
    end;

    operator -(const A: TVec; const B: TVec): TVec;
    var
      LR: TVec;
    begin
      LR.X := A.X - B.X;
      LR.Y := A.Y - B.Y;
      return LR;
    end;

    // the unary minus
    operator -(const A: TVec): TVec;
    var
      LR: TVec;
    begin
      LR.X := -A.X;
      LR.Y := -A.Y;
      return LR;
    end;

    operator *(const A: TVec; const AFactor: int64): TVec;
    var
      LR: TVec;
    begin
      LR.X := A.X * AFactor;
      LR.Y := A.Y * AFactor;
      return LR;
    end;

    operator *(const A: TVec; const AFactor: float64): TVec;
    var
      LR: TVec;
    begin
      LR.X := int64(float64(A.X) * AFactor);
      LR.Y := int64(float64(A.Y) * AFactor);
      return LR;
    end;

    // the declaring type on the right; its body runs the operator above
    operator *(const AFactor: int64; const A: TVec): TVec;
    begin
      return A * AFactor;
    end;

    operator div(const A: TVec; const B: int64): int64;
    begin
      return (A.X + A.Y) div B;
    end;

    operator mod(const A: TVec; const B: int64): int64;
    begin
      return (A.X + A.Y) mod B;
    end;

    operator /(const A: TVec; const B: TVec): float64;
    begin
      return float64(A.X) / float64(B.X);
    end;

    operator =(const A: TVec; const B: TVec): bool;
    begin
      return (A.X = B.X) and (A.Y = B.Y);
    end;

    operator <>(const A: TVec; const B: TVec): bool;
    begin
      return not (A = B);
    end;

    operator <(const A: TVec; const B: TVec): bool;
    begin
      return A.X * A.X + A.Y * A.Y < B.X * B.X + B.Y * B.Y;
    end;

    operator <=(const A: TVec; const B: TVec): bool;
    begin
      return not (B < A);
    end;

    operator >(const A: TVec; const B: TVec): bool;
    begin
      return B < A;
    end;

    operator >=(const A: TVec; const B: TVec): bool;
    begin
      return not (A < B);
    end;
  end;

  // `in` declared by the right operand's type
  TBox = record
    Low: TVec;
    High: TVec;

    operator in(const P: TVec; const ABox: TBox): bool;
    begin
      return (P.X >= ABox.Low.X) and (P.X <= ABox.High.X) and (P.Y >= ABox.Low.Y) and
        (P.Y <= ABox.High.Y);
    end;
  end;

  // an extension's value runs its parent's operator (a const operand takes it)
  TVec3 = record(TVec)
    Z: int64;
  end;

  // a text result
  TName = object
    Text: string;

    operator -(const A: TName; const B: TName): string;
    begin
      return A.Text + "-" + B.Text;
    end;
  end;

  // an object that runs a done: an operator's result moves out, ended once
  TNote = object
    Text: string;

    done;
    begin
      println("done {}", self.Text);
    end;

    operator +(const A: TNote; const B: TNote): TNote;
    var
      LR: TNote;
    begin
      LR.Text := A.Text + "+" + B.Text;
      return LR;
    end;
  end;

func Vec(const AX: int64; const AY: int64): TVec;
var
  LR: TVec;
begin
  LR.X := AX;
  LR.Y := AY;
  return LR;
end;

// a local built from an operator's result (moved in, ended once as the routine ends)
func Made(const AA: TNote; const AB: TNote);
var
  LC: TNote = AA + AB;
begin
  println("made {}", LC.Text);
end;

// a temporary result: ended as its full expression ends
func Notes();
var
  LA: TNote;
  LB: TNote;
begin
  LA.Text := "a";
  LB.Text := "b";
  Made(LA, LB);
  println("temp {}", (LA + LB).Text);
end;

var
  GA: TVec;
  GB: TVec;
  GC: TVec;
  GBox: TBox;
  GE: TVec3;
  GF: TVec3;
  GN1: TName;
  GN2: TName;
  GFactor: int64;
  GHalf: float64;

begin
  GA := Vec(1, 2);
  GB := Vec(3, 4);
  GC := GA + GB;
  println("add {} {}", GC.X, GC.Y);
  GC := GA - GB;
  println("sub {} {}", GC.X, GC.Y);
  GC := -GA;
  println("neg {} {}", GC.X, GC.Y);
  GFactor := 2;
  GC := GA * GFactor;
  println("scale {} {}", GC.X, GC.Y);
  GHalf := 1.5;
  GC := GB * GHalf;
  println("scalef {} {}", GC.X, GC.Y);
  GFactor := 3;
  GC := GFactor * GA;
  println("lscale {} {}", GC.X, GC.Y);
  GFactor := 2;
  println("div {} {} mod {} {} half {}", GA div GFactor, GB div 4, GB mod GFactor, GA mod 3, GA / Vec(2, 0));
  println("eq {} {} ne {} {}", GA = Vec(1, 2), GA = GB, GA <> Vec(1, 2), GA <> GB);
  println("lt {} le {} gt {} ge {}", GA < GB, GA <= GA, GA > GB, GB >= GA);
  GC := GA + GB + GA * GFactor - Vec(0, 0);
  if GC = Vec(6, 10) then
    GC := GC + Vec(1, 0);
  end;
  println("chain {} {}", GC.X, GC.Y);
  println("x {}", (GA + GB).X);
  GBox.Low := Vec(0, 0);
  GBox.High := Vec(2, 2);
  println("in {} {}", GA in GBox, GB in GBox);
  GE.X := 1;
  GE.Y := 2;
  GE.Z := 9;
  GF.X := 10;
  GF.Y := 20;
  GF.Z := 9;
  GC := GE + GF;
  println("ext {} {}", GC.X, GC.Y);
  GN1.Text := "ab";
  GN2.Text := "cd";
  println("name {}", GN1 - GN2);
  Notes();
  println("end");
end.
