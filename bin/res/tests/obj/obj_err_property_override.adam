-------------------------------------------------------------------------------
  obj_err_property_override.adam - an override property keeps the type,
  index and write of the one it overrides (SM0334, BNF sec 4): a write the
  base has not, another type; restating its read only is clean (the base's
  write runs for it)
*******************************************************************************/

module exe obj_err_property_override;

/*
@@test
  kind error
@@end
*/

type
  TBase = object
    FA: int32;
    FB: int32;
    virtual property A: int32 read FA;
    virtual property B: int32 read FB; write FB;
  end;
  TAdds = object(TBase)
    override property A: int32 read FA; write FA; // ERROR SM0334@5: 'A' must have the type, index and write of 'TBase.A' it overrides
  end;
  TRetype = object(TBase)
    override property B: int64 read // ERROR SM0334@5: 'B' must have the type, index and write of 'TBase.B' it overrides
      begin
        return 0;
      end;
  end;
  TReads = object(TBase)
    override property B: int32 read
      begin
        return self.FB + 1;
      end;
  end;

begin
end.
