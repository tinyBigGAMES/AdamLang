  at https://mozilla.org/MPL/2.0/.
-------------------------------------------------------------------------------
  obj_err_operator.adam - Break step of obj_operator (I5, BNF sec 4 operator
  decl). A symbol a type cannot declare, or '...' (PR0062); two operands, or
  one for `-` (SM0380); an operand by var (SM0384); none of the declaring
  type (SM0381); a comparison or in that gives no bool (SM0382); one symbol
  with one set of operand types twice (SM0383, a hint at the first); = with
  no <> beside it (SM0386). A use no declared operator takes (SM0430, a hint
  at each) or several take alike (SM0431, a hint at each); self / parent
  where no object is: an operator, a plain routine, a module body (SM0011).
  A record that declares no operator for a comparison is still SM0252.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_operator;

type
  TBad = record
    N: int64;

    operator :=(const A: TBad; const B: TBad): TBad; // ERROR PR0062@14: ':=' is not an operator a type declares: + - * / div mod = <> < <= > >= in hash
    begin
      return A;
    end;

    operator -(const A: TBad; ...): TBad; // ERROR PR0062@5: an operator takes its operands only: no '...'
    begin
      return A;
    end;

    operator +(const A: TBad): TBad; // ERROR SM0380@5: operator '+' takes two operands
    begin
      return A;
    end;

    operator -(const A: TBad; const B: TBad; const C: TBad): TBad; // ERROR SM0380@5: operator '-' takes one operand (the unary minus) or two
    begin
      return A;
    end;

    operator *(var A: TBad; const B: TBad): TBad; // ERROR SM0384@16: operator '*' takes its operands by value or const, not var ('A')
    begin
      return A;
    end;

    operator div(const A: int64; const B: int64): int64; // ERROR SM0381@5: operator 'div' of 'TBad' takes no 'TBad': one of its operands is the type that declares it
    begin
      return A;
    end;

    operator <(const A: TBad; const B: TBad): int64; // ERROR SM0382@47: operator '<' gives a bool, not 'int64'
    begin
      return 0;
    end;

    operator mod(const A: TBad; const B: int64): int64; // HINT SM0383@5: operator 'mod' of 'TBad' is declared here
    begin
      return B;
    end;

    operator mod(const A: TBad; const B: int64): int64; // ERROR SM0383@5: operator 'mod' of 'TBad' is declared twice with these operand types
    begin
      return B;
    end;

    operator =(const A: TBad; const B: TBad): bool; // ERROR SM0386@5: operator '=' of 'TBad' needs its pair: declare operator '<>' with the same operand types
    begin
      return true;
    end;

    operator /(const A: TBad; const B: TBad): TBad;
    begin
      print(self.N); // ERROR SM0011@13: 'self' names no object here: an operator has no self, its operands are its parameters
      return A;
    end;
  end;

  TTake = record
    N: int64;

    operator +(const A: TTake; const B: int64): TTake; // HINT SM0430@5: operator '+' of 'TTake' takes (TTake, int64)
    begin
      return A;
    end;

    operator +(const A: TTake; const B: bool): TTake; // HINT SM0430@5: operator '+' of 'TTake' takes (TTake, bool)
    begin
      return A;
    end;
  end;

  TBase = record
    N: int64;
  end;

  TAmb = record(TBase)
    M: int64;

    operator +(const A: TAmb; const B: TBase): int64; // HINT SM0431@5: operator '+' of 'TAmb' takes (TAmb, TBase)
    begin
      return 1;
    end;

    operator +(const A: TBase; const B: TAmb): int64; // HINT SM0431@5: operator '+' of 'TAmb' takes (TBase, TAmb)
    begin
      return 2;
    end;
  end;

  TPlain = record
    N: int64;
  end;

func Plain(): int64;
begin
  return self.N; // ERROR SM0011@10: 'self' names no object here: only a method, an init, a copy, a done or a property accessor of a type has one
end;

var
  GTake: TTake;
  GAmb: TAmb;
  GP: TPlain;
  GQ: TPlain;
  GN: int64;
  GOk: bool;

begin
  GTake := GTake + "text"; // ERROR SM0430@12: no operator '+' declared for these operands takes (TTake, string)
  GN := GAmb + GAmb; // ERROR SM0431@9: several operators '+' take (TAmb, TAmb) alike: give the operands their exact parameter types
  GOk := GP = GQ; // ERROR SM0252@10: operator '=' cannot compare 'TPlain': records and overlays are not comparable, compare their fields
  GN := parent.N; // ERROR SM0011@9: 'parent' names no object here: only a method, an init, a copy, a done or a property accessor of a type has one
end.
