-------------------------------------------------------------------------------
  obj_err_self_return.adam - `: self` misused (BNF sec 3 method decl, F7): a
  method returning self returns only `return self;` (SM0762: a bare return,
  another value); an override returns self exactly when the method it
  overrides does (SM0763, both ways); self as a type anywhere else is SM0764:
  a static's or an interface's method, a routine's result, a
  parameter, a variable. `return (self);` is self.
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_self_return;

type
  Base = object
    FN: int64;

    method A(): self;
    begin
      return; // ERROR SM0762@7
    end;

    method B(const AX: int64): self;
    begin
      if AX > 0 then
        return self;
      end;
      return (self);
    end;

    method C(): self;
    var
      LB: Base;
    begin
      return LB; // ERROR SM0762@14
    end;

    virtual method D(): self;
    begin
      return self;
    end;

    virtual method E(): int64;
    begin
      return 1;
    end;

    static method F(): self; // ERROR SM0764@19
    begin
    end;
  end;

  Derived = object(Base)
    override method D(): int64; // ERROR SM0763@21
    begin
      return 2;
    end;

    override method E(): self; // ERROR SM0763@21
    begin
      return self;
    end;
  end;

  Face = interface
    method G(): self; // ERROR SM0764@12
  end;

func H(const AP: self); // ERROR SM0764@18
begin
end;

func K(): self; // ERROR SM0764@11
begin
  return 1;
end;

var
  LV: self; // ERROR SM0764@7

begin
end.
