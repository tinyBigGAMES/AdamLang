-------------------------------------------------------------------------------
  obj_static_method.adam - static methods (BNF sec 3, J3d): a method with no
  self, called through its type's name (TCounter.Make(..)), a unit's type
  (StaticShapes.Shape.Square()) and the bare type an import brings in, and by
  its bare name inside its type's methods (a static's and an instance
  method's), a descendant's included. Statics of one name overload among
  themselves; a hidden one is reached inside its type; a generic one infers
  its type argument. Named as a value it is a routine
  with no self (routine cpplink: a member function's linkage). Nothing leaks.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | make 5
  | twice 6 abab
  | both 50
  | bump 7
  | pick 3 b
  | four 4
  | shapes 4 6 4
  | value 52
  | end
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe obj_static_method;

@addmodulepath "$P:res/tests/obj/fixtures";

import StaticShapes;

type
  TCounter = object
    FValue: int64;

    static method Make(const AStart: int64): TCounter;
    var
      LCounter: TCounter;
    begin
      LCounter.FValue := AStart;
      return LCounter;
    end;

    static method Twice(const AN: int64): int64;
    begin
      return AN * 2;
    end;

    static method Twice(const AS: string): string;
    begin
      return AS + AS;
    end;

    hidden static method Secret(): int64;
    begin
      return 42;
    end;

    // bare statics inside a static method, the hidden one too
    static method Both(const AN: int64): int64;
    begin
      return Twice(AN) + Secret();
    end;

    // a bare static inside an instance method
    method Bump(): int64;
    begin
      self.FValue := self.FValue + Twice(1);
      return self.FValue;
    end;

    static method Pick<T>(const AFirst: T; const ASecond: T; const ATakeFirst: bool): T;
    begin
      if ATakeFirst then
        return AFirst;
      end;
      return ASecond;
    end;
  end;

  // a descendant reaches its parent's statics bare
  TChild = object(TCounter)
    static method Four(): int64;
    begin
      return Twice(2);
    end;
  end;

routine Tests();
var
  LCounter: TCounter;
  LValue: routine cpplink(const AN: int64): int64;
  LSquare: StaticShapes.Shape;
  LHex: Shape;
begin
  LCounter := TCounter.Make(5);
  println("make {}", LCounter.FValue);
  println("twice {} {}", TCounter.Twice(3), TCounter.Twice("ab"));
  println("both {}", TCounter.Both(4));
  println("bump {}", LCounter.Bump());
  println("pick {} {}", TCounter.Pick(3, 9, true), TCounter.Pick("a", "b", false));
  println("four {}", TChild.Four());
  LSquare := StaticShapes.Shape.Square();
  LHex := Shape.Polygon(6);
  println("shapes {} {} {}", LSquare.FSides, LHex.FSides, Shape.Square().FSides);
  LValue := TCounter.Both;
  println("value {}", LValue(5));
end;

begin
  Tests();
  println("end");
end.
