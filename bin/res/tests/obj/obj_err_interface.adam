-------------------------------------------------------------------------------
  obj_err_interface.adam - Break step of obj_interface (I2, BNF sec 4
  interface type, PLAN-OBJECT O7): an object never names an interface as
  its parent (SM0308: implements does); an interface is never held by value
  (SM0338); only interfaces follow implements (SM0362), each once (SM0363);
  every method and property of an interface and of its parent is
  implemented (SM0364, at the interface's name) by a virtual one (SM0365)
  with the same signature or shape (SM0366) that is not hidden (SM0367); an
  interface repeats no method of its parent (SM0368). A level above
  supplying the method, and an override of it, are fine; so is an embed's
  method (I4), unless two embeds of one depth hold it (SM0370), it is
  hidden (SM0367), of another signature (SM0366) or const (SM0389).
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe obj_err_interface;

type
  IGo = interface
    method Go(const AN: int64): int64;
  end;

  ISized = interface
    property Size: int64 read;
  end;

  IMore = interface(IGo)
    method Go(const AN: int64): int64; // ERROR SM0368@5: method 'Go' of interface 'IMore' is already declared by its parent 'IGo'
    method More();
  end;

  TPlainObj = object
    N: int64;
  end;

  TAsParent = object(IGo) // ERROR SM0308@22: 'IGo' is an interface: an object never names it as its parent, write 'implements IGo'
  end;

  TNotIntf = object implements TPlainObj // ERROR SM0362@32: 'TPlainObj' is not an interface: implements names interfaces only
  end;

  TTwice = object implements IGo, IGo // ERROR SM0363@35: 'IGo' is named twice after implements of 'TTwice'
    virtual method Go(const AN: int64): int64;
    begin
      return AN;
    end;
  end;

  TMissing = object implements IGo // ERROR SM0364@32: 'TMissing' does not implement 'IGo.Go': declare virtual method Go with its parameters and result
  end;

  TMissingSize = object implements ISized // ERROR SM0364@36: 'TMissingSize' does not implement 'ISized.Size': declare virtual property Size with its type and accessors
  end;

  TMissingMore = object implements IMore // ERROR SM0364@36: 'TMissingMore' does not implement 'IMore.More': declare virtual method More with its parameters and result
    virtual method Go(const AN: int64): int64;
    begin
      return AN;
    end;
  end;

  TPlainGo = object implements IGo // ERROR SM0365@32: 'TPlainGo.Go' implements 'IGo.Go': write 'virtual method Go'
    method Go(const AN: int64): int64;
    begin
      return AN;
    end;
  end;

  TOtherGo = object implements IGo // ERROR SM0366@32: 'TOtherGo.Go' does not implement 'IGo.Go': its parameter modes, types and result differ
    virtual method Go(var AN: int64): int64;
    begin
      return AN;
    end;
  end;

  THiddenGo = object implements IGo // ERROR SM0367@33: 'THiddenGo.Go' implements 'IGo.Go': an interface member is never hidden
    hidden virtual method Go(const AN: int64): int64;
    begin
      return AN;
    end;
  end;

  TUpper = object
    virtual method Go(const AN: int64): int64;
    begin
      return AN;
    end;
  end;

  TBorrowGo = object(TUpper) implements IGo
  end;

  TOverGo = object(TBorrowGo)
    override method Go(const AN: int64): int64;
    begin
      return AN + 1;
    end;
  end;

  // An embed's method fulfils an interface (I4, no virtual needed): TEmbedGo is fine;
  // two embeds of one depth holding it, a hidden one, another signature and another
  // const are not
  TGoer = object
    method Go(const AN: int64): int64;
    begin
      return AN;
    end;
  end;

  THiddenGoer = object
    hidden method Go(const AN: int64): int64;
    begin
      return AN;
    end;
  end;

  TOtherGoer = object
    method Go(const AN: int32): int64;
    begin
      return AN;
    end;
  end;

  TConstGoer = object
    const method Go(const AN: int64): int64;
    begin
      return AN;
    end;
  end;

  TEmbedGo = object implements IGo
    embed G: TGoer;
  end;

  TTwoGo = object implements IGo // ERROR SM0370@30: 'IGo.Go' is reached through two embeds of 'TTwoGo', 'A' and 'B': declare virtual method Go to choose one
    embed A: TGoer;
    embed B: TGoer;
  end;

  THideGo = object implements IGo // ERROR SM0367@31: 'THiddenGoer.Go' implements 'IGo.Go': an interface member is never hidden
    embed H: THiddenGoer;
  end;

  TSigGo = object implements IGo // ERROR SM0366@30: 'TOtherGoer.Go' does not implement 'IGo.Go': its parameter modes, types and result differ
    embed O: TOtherGoer;
  end;

  TConstGo = object implements IGo // ERROR SM0389@32: 'Go' must be a method that is not const, as 'Go' of 'IGo' is: an override or an implementing method keeps the const of the method it continues
    embed C: TConstGoer;
  end;

routine Tests(const AGo: IGo);
var
  LGo: IGo; // ERROR SM0338@8: 'IGo' is an interface: it is reached through var, const, ptr to, own or ref, never held by value or created
  LBorrow: TBorrowGo;
  LOver: TOverGo;
  LN: int64;
begin
  LN := AGo.Go(1) + LBorrow.Go(2) + LOver.Go(3);
end;

begin
end.
