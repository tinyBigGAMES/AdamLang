-------------------------------------------------------------------------------
  flow_for.adam - Flow: for to / downto (M3.3c2), PaskalCPP's contract: the
  iterator takes the start, the end is evaluated once, the loop runs while
  the iterator has not passed it and stops AT it. An empty range keeps the
  start; one pass; to and downto, the iterator ending at the end; int8 to
  127 and down to -128, uint8 to 255 and down to 0, char to 127 (never a
  step past the type's last value); a choices iterator both ways; the end's
  call runs once and a later change of what it read is unseen; skip runs
  the step, leave keeps the iterator where it was; nested fors; a value
  parameter and a var parameter as the iterator. Values are shown through
  ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 5
  | 7
  | 7
  | 55
  | 10
  | 3
  | 2
  | 1
  | 1
  | 3
  | 127
  | 3
  | -128
  | 6
  | 255
  | 3
  | 0
  | 3
  | 127
  | 0
  | 1
  | 2
  | 2
  | 1
  | 77
  | 6
  | 3
  | 9
  | 7
  | 12
  | 10
  | 4
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe flow_for;

type
  K = choices(Red, Green, Blue);

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue, after showing 77: proves how many times a for's end is evaluated
routine EndAt(const AValue: int32): int32;
begin
  ShowInt(77);
  return AValue;
end;

// AN + (AN - 1) + ... + 1: a value parameter as the iterator, its start read from itself
routine Countdown(AN: int32): int32;
var
  LSum: int32;
begin
  LSum := 0;
  for AN := AN downto 1 do
    LSum += AN;
  end;
  return LSum;
end;

// Runs AI from 1 to 4: a var parameter as the iterator, seen by the caller after
routine Fill(var AI: int32);
begin
  for AI := 1 to 4 do
  end;
end;

routine Run();
var
  LI: int32;
  LN: int32;
  LSum: int32;
  LCount: int32;
  LI8: int8;
  LU8: uint8;
  LC: char;
  LK: K;
begin
  // an empty range: the body never runs, the iterator keeps the start
  LI := 99;
  for LI := 5 to 3 do
    ShowInt(100);
  end;
  ShowInt(LI);
  // one pass; the iterator ends at the end
  for LI := 7 to 7 do
    ShowInt(LI);
  end;
  ShowInt(LI);
  // to: 1 + ... + 10, the iterator ending AT the end, not past it
  LSum := 0;
  for LI := 1 to 10 do
    LSum += LI;
  end;
  ShowInt(LSum);
  ShowInt(LI);
  // downto
  for LI := 3 downto 1 do
    ShowInt(LI);
  end;
  ShowInt(LI);
  // the type's last value: int8 up to 127 and down to -128, uint8 up to 255 and down to 0
  LCount := 0;
  for LI8 := 125 to 127 do
    LCount += 1;
  end;
  ShowInt(LCount);
  ShowInt(LI8);
  LCount := 0;
  for LI8 := -126 downto -128 do
    LCount += 1;
  end;
  ShowInt(LCount);
  ShowInt(LI8);
  LCount := 0;
  for LU8 := 250 to 255 do
    LCount += 1;
  end;
  ShowInt(LCount);
  ShowInt(LU8);
  LCount := 0;
  for LU8 := 2 downto 0 do
    LCount += 1;
  end;
  ShowInt(LCount);
  ShowInt(LU8);
  // char (signed: up to 127) and a choices iterator both ways
  LCount := 0;
  for LC := char(125) to char(127) do
    LCount += 1;
  end;
  ShowInt(LCount);
  ShowInt(int32(LC));
  for LK := K(0) to K(2) do
    ShowInt(int64(LK));
  end;
  for LK := K(2) downto K(1) do
    ShowInt(int64(LK));
  end;
  // the end evaluated once: its call runs once (77), a later change of what it read is unseen
  LSum := 0;
  for LI := 1 to EndAt(3) do
    LSum += LI;
  end;
  ShowInt(LSum);
  LN := 3;
  LCount := 0;
  for LI := 1 to LN do
    LN := 10;
    LCount += 1;
  end;
  ShowInt(LCount);
  // skip runs the step; leave keeps the iterator where it was
  LSum := 0;
  for LI := 1 to 10 do
    if LI % 2 = 0 then
      skip;
    end;
    if LI = 7 then
      leave;
    end;
    LSum += LI;
  end;
  ShowInt(LSum);
  ShowInt(LI);
  // nested fors: a 3 x 4 count
  LCount := 0;
  for LI := 1 to 3 do
    for LN := 1 to 4 do
      LCount += 1;
    end;
  end;
  ShowInt(LCount);
  // a value parameter and a var parameter as the iterator
  ShowInt(Countdown(4));
  LI := 0;
  Fill(LI);
  ShowInt(LI);
end;

begin
  Run();
  exit(0);
end.
