-------------------------------------------------------------------------------
  flow_if.adam - Flow: if / else (M3.3a). An if without else taken and not
  taken; both sides of an if / else; ifs nested in both sides of another;
  an else-if chain with a return on every side (no join); a return on one
  side while the other falls through; ifs in a row; a bool variable as the
  condition and an empty then side; a short-circuit condition whose right
  side runs only when the left holds; an if in the program block whose
  taken side returns, ending the program. Values are shown through
  ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 1
  | 3
  | 4
  | 7
  | 8
  | 10
  | -1
  | 0
  | 1
  | 3
  | 10
  | 2
  | 0
  | 14
  | 99
  | 17
  | 18
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe flow_if;

routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine puts(const AText: ptr): int32; external "ucrtbase";
routine _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";

// AValue in decimal, one line
routine ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// The sign of AValue: an else-if chain with a return on every side
routine Sign(const AValue: int32): int32;
begin
  if AValue < 0 then
    return -1;
  else
    if AValue = 0 then
      return 0;
    else
      return 1;
    end;
  end;
end;

// AValue, at most ALimit: a return on one side, the other falls through
routine Clamp(const AValue: int32; const ALimit: int32): int32;
begin
  if AValue > ALimit then
    return ALimit;
  end;
  return AValue;
end;

// How many of AA, AB and AC are positive: ifs without else in a row
routine Positives(const AA: int32; const AB: int32; const AC: int32): int32;
var
  LCount: int32;
begin
  LCount := 0;
  if AA > 0 then
    LCount += 1;
  end;
  if AB > 0 then
    LCount += 1;
  end;
  if AC > 0 then
    LCount += 1;
  end;
  return LCount;
end;

// AValue, after showing 99: proves when a condition's right side runs
routine Noisy(const AValue: bool): bool;
begin
  ShowInt(99);
  return AValue;
end;

routine Run();
var
  LA: int32;
  LB: int32;
  LFlag: bool;
begin
  // if without else: taken, then not taken; the statement after both runs
  LA := 5;
  if LA > 3 then
    ShowInt(1);
  end;
  if LA > 7 then
    ShowInt(2);
  end;
  ShowInt(3);
  // if / else: the then side, then the else side
  if LA = 5 then
    ShowInt(4);
  else
    ShowInt(5);
  end;
  if LA <> 5 then
    ShowInt(6);
  else
    ShowInt(7);
  end;
  // nested: an inner if in both sides of the outer one
  LB := 2;
  if LA > 0 then
    if LB > 1 then
      ShowInt(8);
    else
      ShowInt(9);
    end;
    ShowInt(10);
  else
    if LB > 1 then
      ShowInt(11);
    end;
  end;
  // an else-if chain with a return on every side
  ShowInt(Sign(-7));
  ShowInt(Sign(0));
  ShowInt(Sign(42));
  // a return on one side, the other falls through
  ShowInt(Clamp(3, 10));
  ShowInt(Clamp(30, 10));
  // ifs without else in a row
  ShowInt(Positives(1, -1, 2));
  ShowInt(Positives(-1, -2, -3));
  // a bool variable as the condition; an empty then side
  LFlag := LA > 4;
  if LFlag then
  else
    ShowInt(12);
  end;
  if not LFlag then
    ShowInt(13);
  else
    ShowInt(14);
  end;
  // a short-circuit condition: Noisy runs only when the left side holds
  if (LA > 10) and Noisy(true) then
    ShowInt(15);
  end;
  if (LA > 0) and Noisy(false) then
    ShowInt(16);
  else
    ShowInt(17);
  end;
end;

begin
  Run();
  // an if in the program block: its taken side returns, ending the program
  if Sign(-1) < 0 then
    ShowInt(18);
    return;
  end;
  ShowInt(19);
  exit(0);
end.
