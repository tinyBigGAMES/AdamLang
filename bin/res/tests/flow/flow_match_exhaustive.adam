-------------------------------------------------------------------------------
  flow_match_exhaustive.adam - an exhaustive match ends the path (BNF sec 5,
  XM1): a match on a choices value with no else, covering every value (a
  range label too), every arm returning or raising, needs no return after
  it; one at the end of an if's branch ends that branch; a statement after
  one is unreachable (SM0622); a value outside the names (an integer cast)
  raises code 16 instead of falling off; a match whose arms leave the match
  itself goes on after it (no SM0622 after it); an else opts out
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | red green blue
  | warm cool cool
  | 1 3
  | 16 match has no arm for value 7
  | 16 match has no arm for value -1
  | raised Blue
  | left 3
  | other other
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe flow_match_exhaustive;

type
  Color = choices(Red, Green, Blue);

// Every value covered, every arm returning: no return after the match
func ColorName(const AColor: Color): string;
begin
  match AColor of
    Color.Red: return "red";
    Color.Green: return "green";
    Color.Blue: return "blue";
  end;
end;

// A range label covers the rest; the match ends the if's else branch
func Warmth(const AColor: Color): string;
begin
  if AColor = Color.Red then
    return "warm";
  else
    match AColor of
      Color.Red: return "warm";
      Color.Green..Color.Blue: return "cool";
    end;
  end;
end;

// A statement after an exhaustive match never runs
func Rank(const AColor: Color): int32;
begin
  match AColor of
    Color.Red: return 1;
    Color.Green, Color.Blue: return 3;
  end;
  return 99;  // WARN SM0622
end;

// An arm may end by raising
func Check(const AColor: Color): int32;
begin
  match AColor of
    Color.Red, Color.Green: return 0;
    Color.Blue: raise("raised Blue");
  end;
end;

// Arms that leave the match go on after it: the statements after it run
func Left(): int32;
var
  LCount: int32;
  LColor: Color;
begin
  LCount := 0;
  for LColor := Color.Red to Color.Blue do
    match LColor of
      Color.Red: leave;
      Color.Green: leave;
      Color.Blue: leave;
    end;
    LCount := LCount + 1;
  end;
  return LCount;
end;

// An else opts out: a value outside the names takes it
func WithElse(const AColor: Color): string;
begin
  match AColor of
    Color.Red: return "red";
    Color.Green, Color.Blue: return "green or blue";
  else
    return "other";
  end;
end;

// The value AValue cast to Color (outside its names for 5, 7, 9, -1)
func AsColor(const AValue: int32): Color;
begin
  return Color(AValue);
end;

func Trap(const AValue: int32);
begin
  guard
    println("{}", ColorName(AsColor(AValue)));
  except
    println("{} {}", exccode(), excmsg());
  end;
end;

begin
  println("{} {} {}", ColorName(Color.Red), ColorName(Color.Green), ColorName(Color.Blue));
  println("{} {} {}", Warmth(Color.Red), Warmth(Color.Green), Warmth(Color.Blue));
  println("{} {}", Rank(Color.Red), Rank(Color.Blue));
  Trap(7);
  Trap(-1);
  guard
    println("{}", Check(Color.Blue));
  except
    println("{}", excmsg());
  end;
  println("left {}", Left());
  println("{} {}", WithElse(AsColor(5)), WithElse(AsColor(9)));
end.
