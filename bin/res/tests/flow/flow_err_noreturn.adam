-------------------------------------------------------------------------------
  flow_err_noreturn.adam - a noreturn routine that can return: a body that
  reaches its end (SM0623, a while true a leave leaves included), a return in
  its body (SM0624), and a forward and its full routine that disagree on
  noreturn (SM0306). A while true a leave leaves still lets a valued routine
  reach its end (SM0612)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe flow_err_noreturn;

func EndsNot(); noreturn; // ERROR SM0623: 'EndsNot' is noreturn but its body can reach its end
begin
  println("x");
end;

func Returns(const AFlag: bool); noreturn;
begin
  if AFlag then
    return; // ERROR SM0624: return in 'Returns', which is noreturn: it never returns to its caller
  end;
  raise("x");
end;

func LeftLoop(); noreturn; // ERROR SM0623: 'LeftLoop' is noreturn but its body can reach its end
begin
  while true do
    leave;
  end;
end;

func LeftValued(): int32; // ERROR SM0612: missing return: 'LeftValued' can reach its end without returning a value
begin
  while true do
    if true then
      leave;
    end;
  end;
end;

forward func Differ();
func Differ(); noreturn; // ERROR SM0306: forward and full declaration of 'Differ' differ: one is noreturn, the other is not (forward at line 60)
begin
  raise("x");
end;

begin
end.
