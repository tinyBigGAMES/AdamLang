-------------------------------------------------------------------------------
  flow_for_in.adam - for in (BNF sec 5, G1) over arrays, strings and sets:
  a static array's and a dynamic array's elements (managed ones included),
  a string's chars, a wstring's wchars, a set's members low to high (a
  range set and a choices set), a record array's elements; skip and leave;
  the value walked as it was at the loop's start (a change in the body is
  not seen); a call's result walked and released; nested loops; an empty
  string and array run no pass
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | static 1 2 3
  | dynamic ab cd ef
  | chars x y z
  | wide p q
  | range 1 3 6
  | colors 0 2
  | records 1:a 2:b
  | skip 1 3
  | leave 1 2
  | snapshot 1 2 3 after 9
  | text snapshot a b after zz
  | list snapshot one two after 1
  | set snapshot 2 4 after 4
  | made m a d e
  | nested 1a 1b 2a 2b
  | empty done
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe flow_for_in;

import System.SysUtils;

type
  Trio = array[0..2] of int32;
  Small = set of 0..7;
  Color = choices(Red, Green, Blue);
  Colors = set of Color;
  Pair = record
    Num: int32;
    Tag: string;
  end;

// A static array's, a dynamic array's (strings), a string's and a wstring's elements
routine Arrays();
var
  LA: Trio;
  LD: array of string;
  LS: string;
  LW: wstring;
  LN: int32;
  LT: string;
  LC: char;
  LWc: wchar;
  LLine: string;
begin
  LA := [1, 2, 3];
  LLine := "static";
  for LN in LA do
    LLine := LLine + " " + IntToStr(LN);
  end;
  println("{}", LLine);
  setlength(LD, 3);
  LD[0] := "ab";
  LD[1] := "c" + "d";
  LD[2] := "ef";
  LLine := "dynamic";
  for LT in LD do
    LLine := LLine + " " + LT;
  end;
  println("{}", LLine);
  LS := "xyz";
  LLine := "chars";
  for LC in LS do
    LLine := LLine + " " + LC;
  end;
  println("{}", LLine);
  LW := "pq";
  print("wide");
  for LWc in LW do
    print(" {}", LWc);
  end;
  println("");
end;

// A set's members, low to high
routine Sets();
var
  LR: Small;
  LK: Colors;
  LI: int32;
  LColor: Color;
  LLine: string;
begin
  LR := [6, 1, 3];
  LLine := "range";
  for LI in LR do
    LLine := LLine + " " + IntToStr(LI);
  end;
  println("{}", LLine);
  LK := [Color.Blue, Color.Red];
  LLine := "colors";
  for LColor in LK do
    LLine := LLine + " " + IntToStr(int32(LColor));
  end;
  println("{}", LLine);
end;

// A record array's elements, each copied with its string
routine Records();
var
  LP: array[0..1] of Pair;
  LE: Pair;
  LLine: string;
begin
  LP[0].Num := 1;
  LP[0].Tag := "a";
  LP[1].Num := 2;
  LP[1].Tag := "b";
  LLine := "records";
  for LE in LP do
    LLine := LLine + " " + IntToStr(LE.Num) + ":" + LE.Tag;
  end;
  println("{}", LLine);
end;

// skip goes to the next element, leave ends the loop
routine Jumps();
var
  LA: Trio;
  LN: int32;
  LLine: string;
begin
  LA := [1, 2, 3];
  LLine := "skip";
  for LN in LA do
    if LN = 2 then
      skip;
    end;
    LLine := LLine + " " + IntToStr(LN);
  end;
  println("{}", LLine);
  LLine := "leave";
  for LN in LA do
    LLine := LLine + " " + IntToStr(LN);
    if LN = 2 then
      leave;
    end;
  end;
  println("{}", LLine);
end;

// The value is walked as it was at the loop's start: a change in the body is not seen
routine Snapshots();
var
  LA: Trio;
  LS: string;
  LD: array of string;
  LR: Small;
  LN: int32;
  LC: char;
  LT: string;
  LI: int32;
  LLine: string;
begin
  LA := [1, 2, 3];
  LLine := "snapshot";
  for LN in LA do
    LLine := LLine + " " + IntToStr(LN);
    LA[2] := 9;
  end;
  println("{}", LLine + " after " + IntToStr(LA[2]));
  LS := "ab";
  LLine := "text snapshot";
  for LC in LS do
    LLine := LLine + " " + LC;
    LS := "zz";
  end;
  println("{}", LLine + " after " + LS);
  setlength(LD, 2);
  LD[0] := "one";
  LD[1] := "two";
  LLine := "list snapshot";
  for LT in LD do
    LLine := LLine + " " + LT;
    setlength(LD, 1);
  end;
  println("{}", LLine + " after " + IntToStr(len(LD)));
  LR := [2, 4];
  LLine := "set snapshot";
  for LI in LR do
    LLine := LLine + " " + IntToStr(LI);
    LR := [];
  end;
  println("{}", LLine + " after " + IntToStr(LI));
end;

// A call's result is walked, then released
routine Made(): string;
begin
  return "ma" + "de";
end;

// Nested loops, a call's result, an empty string and an empty array
routine Others();
var
  LC: char;
  LN: int32;
  LT: string;
  LA: Trio;
  LS: string;
  LD: array of string;
  LLine: string;
begin
  LLine := "made";
  for LC in Made() do
    LLine := LLine + " " + LC;
  end;
  println("{}", LLine);
  LA := [1, 2, 0];
  LS := "ab";
  LLine := "nested";
  for LN in LA do
    if LN = 0 then
      leave;
    end;
    for LC in LS do
      LLine := LLine + " " + IntToStr(LN) + LC;
    end;
  end;
  println("{}", LLine);
  LS := "";
  for LC in LS do
    println("never");
  end;
  for LT in LD do
    println("never");
  end;
  println("empty done");
end;

begin
  Arrays();
  Sets();
  Records();
  Jumps();
  Snapshots();
  Others();
end.
