-------------------------------------------------------------------------------
  flow_loop.adam - Flow: while and repeat / until (M3.3b). A while of zero,
  one and many passes; a repeat runs its body once before the test; two
  nested whiles; leave and skip in the inner loop of two (the outer one
  goes on); skip in a repeat goes to its until test (which may end it),
  leave leaves it; a return from a while body and from a repeat body.
  Values are shown through ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 0
  | 1
  | 55
  | 5
  | 12
  | 12
  | 6
  | 6
  | 12
  | 5
  | 8
  | 3
  | 4
  | 5
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe flow_loop;

func malloc(const ASize: uint64): ptr; external "ucrtbase";
func puts(const AText: ptr): int32; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
func exit(const ACode: int32); external "ucrtbase";

// AValue in decimal, one line
func ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// The first N whose square is over ALimit: a return from a while body
func FirstOver(const ALimit: int32): int32;
var
  LN: int32;
begin
  LN := 1;
  while true do
    if LN * LN > ALimit then
      return LN;
    end;
    LN += 1;
  end;
end;

// How many decimal digits AValue has: a return from a repeat body
func Digits(const AValue: int32): int32;
var
  LN: int32;
  LCount: int32;
begin
  LN := AValue;
  LCount := 0;
  repeat
    LCount += 1;
    LN := LN div 10;
    if LN = 0 then
      return LCount;
    end;
  until false;
  return -1;
end;

func Run();
var
  LI: int32;
  LJ: int32;
  LSum: int32;
begin
  // while: zero passes, one pass, many passes
  LI := 0;
  while LI > 0 do
    ShowInt(100);
  end;
  ShowInt(LI);
  LI := 1;
  while LI > 0 do
    ShowInt(LI);
    LI -= 1;
  end;
  LI := 0;
  LSum := 0;
  while LI < 10 do
    LI += 1;
    LSum += LI;
  end;
  ShowInt(LSum);
  // repeat: the body runs once before the test; then until ends it after four passes
  LI := 5;
  repeat
    ShowInt(LI);
  until LI > 0;
  LI := 0;
  repeat
    LI += 3;
  until LI >= 10;
  ShowInt(LI);
  // nested whiles: a 3 x 4 count
  LSum := 0;
  LI := 0;
  while LI < 3 do
    LJ := 0;
    while LJ < 4 do
      LSum += 1;
      LJ += 1;
    end;
    LI += 1;
  end;
  ShowInt(LSum);
  // leave and skip in the inner loop of two: the inner skips odd LJ and leaves at 6, the
  // outer goes on (2 + 4 summed per outer pass)
  LSum := 0;
  LI := 0;
  while LI < 2 do
    LI += 1;
    LJ := 0;
    while true do
      LJ += 1;
      if LJ = 6 then
        leave;
      end;
      if LJ % 2 = 1 then
        skip;
      end;
      LSum += LJ;
    end;
    ShowInt(LJ);
  end;
  ShowInt(LSum);
  // a repeat: skip goes to the until test, leave leaves it (1 + 3 + 4 summed)
  LI := 0;
  LSum := 0;
  repeat
    LI += 1;
    if LI = 2 then
      skip;
    end;
    if LI = 5 then
      leave;
    end;
    LSum += LI;
  until LI >= 8;
  ShowInt(LI);
  ShowInt(LSum);
  // skip to an until test that ends the repeat
  LI := 0;
  repeat
    LI += 1;
    skip;
  until LI = 3;
  ShowInt(LI);
  // a return from a while body and from a repeat body
  ShowInt(FirstOver(10));
  ShowInt(Digits(12345));
end;

begin
  Run();
  exit(0);
end.
