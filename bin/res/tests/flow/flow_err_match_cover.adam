-------------------------------------------------------------------------------
  flow_err_match_cover.adam - a match on a choices value with no else, every
  arm ending the path, that is the end of its routine but leaves values
  uncovered is SM0772 at the match naming them (BNF sec 5, XM1), not SM0612
  or SM0623 at the routine: at the body's end, at an if branch's end, in a
  noreturn routine. A match with a statement after it may cover only some
  values (SM0606, a warning); one whose arm falls through keeps SM0606 and
  the routine's SM0612
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe flow_err_match_cover;

type
  Color = choices(Red, Green, Blue, Yellow);

func Pick(const AColor: Color): int32;
begin
  match AColor of // ERROR SM0772: match on 'Color' does not cover: Blue, Yellow, so 'Pick' can reach its end through it
    Color.Red: return 1;
    Color.Green: return 2;
  end;
end;

func InIf(const AFlag: bool; const AColor: Color): int32;
begin
  if AFlag then
    return 0;
  else
    match AColor of // ERROR SM0772: match on 'Color' does not cover: Yellow, so 'InIf' can reach its end through it
      Color.Red..Color.Blue: return 1;
    end;
  end;
end;

func Never(const AColor: Color); noreturn;
begin
  match AColor of // ERROR SM0772: match on 'Color' does not cover: Red, so 'Never' can reach its end through it
    Color.Green, Color.Blue, Color.Yellow: raise("never");
  end;
end;

func NotTail(const AColor: Color): int32;
begin
  match AColor of // WARN SM0606: match on 'Color' does not cover: Yellow
    Color.Red, Color.Green, Color.Blue: return 1;
  end;
  return 0;
end;

func ArmFalls(const AColor: Color): int32; // ERROR SM0612: missing return: 'ArmFalls' can reach its end without returning a value
var
  LValue: int32;
begin
  LValue := 0;
  match AColor of // WARN SM0606: match on 'Color' does not cover: Yellow
    Color.Red, Color.Green: return 1;
    Color.Blue: LValue := 2;
  end;
end;

begin
end.
