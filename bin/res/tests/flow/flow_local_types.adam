-------------------------------------------------------------------------------
  flow_local_types.adam - type blocks in a routine and among statements (BNF
  sec 3 routine body, sec 5): a routine's own record, alias, object (a
  method, a done, a string field, is / as through its TypeInfo) and a record
  with operators; the same type name local to two routines; a type block as
  a statement in the program block, a loop body, a nested block, a match arm
  and a method body (a method takes only var blocks: PR0025); one name declared in two sibling blocks of one routine
  (each its own type); no leak.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | pair 17
  | small 7
  | note hi 2
  | is true true
  | as 3
  | done hi
  | vec 4 6 eq true
  | one 1
  | two 2 2
  | body 7
  | loop 1 2
  | block 10 ab
  | arm 5
  | sib 3
  | sib x y
  | method 9
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe flow_local_types;

type
  TBox = object
    N: int64;

    const method Twice(): int64;
    begin
      type
        TStep = record
          K: int64;
        end;
      var LStep: TStep;
      LStep.K := self.N;
      type TMore = int64;
      var LMore: TMore = LStep.K * 2 + 1;
      return LMore;
    end;
  end;

// A routine's own types: a record, an alias, an object with a method, a done and a string
routine Pairs(AN: int32): int32;
type
  TPair = record
    A: int32;
    B: int32;
  end;
  TSmall = int8;
  TNote = object
    S: string;
    N: int64;

    const method Show();
    begin
      println("note {} {}", self.S, self.N);
    end;

    done;
    begin
      println("done {}", self.S);
    end;
  end;
  TRoot = object
    K: int64;

    virtual const method Kind(): int64;
    begin
      return self.K;
    end;
  end;
  TLeaf = object(TRoot)
    M: int64;
  end;
var
  LPair: TPair;
  LSmall: TSmall;
  LNote: TNote;
  LLeaf: TLeaf;
  LRoot: ptr to TRoot;
begin
  LPair.A := AN;
  LPair.B := 12;
  println("pair {}", LPair.A + LPair.B);
  LSmall := 7;
  println("small {}", LSmall);
  LNote.S := "hi";
  LNote.N := 2;
  LNote.Show();
  LRoot := addr of LLeaf;
  println("is {} {}", LRoot is TLeaf, LRoot is TRoot);
  (LRoot as TLeaf)->M := 3;
  println("as {}", LLeaf.M);
  return 0;
end;

// A record with operators, local to a routine
routine Vecs();
type
  TVec = record
    X: int64;
    Y: int64;

    operator +(const A: TVec; const B: TVec): TVec;
    var
      LR: TVec;
    begin
      LR.X := A.X + B.X;
      LR.Y := A.Y + B.Y;
      return LR;
    end;

    operator =(const A: TVec; const B: TVec): bool;
    begin
      return (A.X = B.X) and (A.Y = B.Y);
    end;

    operator <>(const A: TVec; const B: TVec): bool;
    begin
      return (A.X <> B.X) or (A.Y <> B.Y);
    end;
  end;
var
  LA: TVec;
  LB: TVec;
  LC: TVec;
begin
  LA.X := 1;
  LA.Y := 2;
  LB.X := 3;
  LB.Y := 4;
  LC := LA + LB;
  println("vec {} {} eq {}", LC.X, LC.Y, LC = LA + LB);
end;

// The same type name local to two routines: each its own type
routine One();
type
  TSame = record
    V: int64;
  end;
var
  LS: TSame;
begin
  LS.V := 1;
  println("one {}", LS.V);
end;

routine Two();
type
  TSame = record
    V: int64;
    W: int64;
  end;
var
  LS: TSame;
begin
  LS.V := 2;
  LS.W := 2;
  println("two {} {}", LS.V, LS.W);
end;

// One name in two sibling blocks of one routine: an object with a method in the first, a
// record of two strings in the second
routine Siblings();
begin
  begin
    type
      TSib = object
        N: int64;

        const method Get(): int64;
        begin
          return self.N;
        end;
      end;
    var LS: TSib;
    LS.N := 3;
    println("sib {}", LS.Get());
  end;
  begin
    type
      TSib = record
        A: string;
        B: string;
      end;
    var LS: TSib;
    LS.A := "x";
    LS.B := "y";
    println("sib {} {}", LS.A, LS.B);
  end;
end;

var
  LI: int32;
  LK: int32;
  LBox: TBox;

begin
  Pairs(5);
  Vecs();
  One();
  Two();
  type TByte = int8;
  var LT: TByte = 7;
  println("body {}", LT);
  print("loop");
  for LI := 1 to 2 do
    type TStep = int32;
    var LD: TStep = LI;
    print(" {}", LD);
  end;
  println("");
  begin
    type
      TText = record
        S: string;
      end;
    var LE: int32 = 10;
    var LText: TText;
    LText.S := "ab";
    println("block {} {}", LE, LText.S);
  end;
  LK := 1;
  match LK of
    1:
      type TArm = int64;
      var LY: TArm = 5;
      println("arm {}", LY);
  end;
  Siblings();
  LBox.N := 4;
  println("method {}", LBox.Twice());
end.
