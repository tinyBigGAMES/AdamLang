-------------------------------------------------------------------------------
  flow_unreachable.adam - statements after one that ends the path (SM0622, a
  warning, once per list at the first dead statement): after a return, a
  raise, a leave, a skip and an if whose both branches return. A routine
  whose path ends in a return before its dead tail has no SM0612 (its end is
  unreachable). The dead statements never run
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  | after return 5
  | after if 1 2
  | after leave 3
  | after skip 4
  | after raise caught
@@end
*/

module exe flow_unreachable;

// A dead tail after the return: no missing return, one warning at its first statement
func AfterReturn(): int32;
var
  LValue: int32;
begin
  LValue := 5;
  return LValue;
  LValue := 6;  // WARN SM0622
  LValue := 7;
end;

// Both branches return, so the if ends the path
func AfterIf(const AFlag: bool): int32;
begin
  if AFlag then
    return 1;
  else
    return 2;
  end;
  return 3;  // WARN SM0622
end;

// A leave ends its loop body's path
func AfterLeave(): int32;
var
  LCount: int32;
begin
  LCount := 0;
  while true do
    LCount := LCount + 3;
    leave;
    LCount := LCount + 100;  // WARN SM0622
  end;
  return LCount;
end;

// A skip ends its loop body's path
func AfterSkip(): int32;
var
  LCount: int32;
  LI: int32;
begin
  LCount := 0;
  for LI := 1 to 4 do
    LCount := LCount + 1;
    skip;
    LCount := LCount + 100;  // WARN SM0622
  end;
  return LCount;
end;

// A raise ends the path of the guarded statements
func AfterRaise(): string;
var
  LText: string;
begin
  LText := "not caught";
  guard
    raise("boom");
    LText := "after the raise";  // WARN SM0622
  except
    LText := "caught";
  end;
  return LText;
end;

begin
  SetHeapReport(false);
  println("after return {}", AfterReturn());
  println("after if {} {}", AfterIf(true), AfterIf(false));
  println("after leave {}", AfterLeave());
  println("after skip {}", AfterSkip());
  println("after raise {}", AfterRaise());
end.
