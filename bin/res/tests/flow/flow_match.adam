-------------------------------------------------------------------------------
  flow_match.adam - Flow: match (M3.3d2), PaskalCPP's contract: the subject
  evaluated once, the labels tested in source order, the first that holds
  entering its arm, no fall through to the next arm. A label list, two
  ranges in one arm, a negative range, the else; a match with no else and
  no arm holding; the subject's call runs once; a char subject (signed on
  win64: char(200)..char(30) holds char(10) and char(240)); uint8 and uint64
  subjects compared unsigned (labels past int64's range); a choices subject
  naming every value; a return from an arm; a leave from an arm to the
  match's end; in a loop, skip goes on with the loop and leave only leaves
  the match. Values are shown through ucrtbase (_i64toa + puts).
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | 1
  | 9
  | 2
  | 2
  | 3
  | 9
  | 4
  | 77
  | 3
  | 1
  | 2
  | 3
  | 3
  | 4
  | 2
  | 3
  | 2
  | 1
  | 3
  | 1
  | 2
  | 1
  | 0
  | 21
  | 23
  | 15
  | 6
  | [Heap] Allocs: 0, Frees: 0, Leaked: 0
@@end
*/

module exe flow_match;

type
  K = choices(Red, Green, Blue);

func malloc(const ASize: uint64): ptr; external "ucrtbase";
func puts(const AText: ptr): int32; external "ucrtbase";
func _i64toa(const AValue: int64; const ABuffer: ptr; const ARadix: int32): ptr; external "ucrtbase";
func exit(const ACode: int32); external "ucrtbase";

// AValue in decimal, one line
func ShowInt(const AValue: int64);
begin
  puts(_i64toa(AValue, malloc(32), 10));
end;

// AValue, after showing 77: proves how many times a match's subject is evaluated
func SubjectAt(const AValue: int32): int32;
begin
  ShowInt(77);
  return AValue;
end;

// The arm AN falls in: a list, two ranges in one arm, a negative range, else 9
func Classify(const AN: int32): int32;
var
  LArm: int32;
begin
  LArm := 0;
  match AN of
    1, 3, 5: LArm := 1;
    10..19, 30..39: LArm := 2;
    -5..-1: LArm := 3;
  else
    LArm := 9;
  end;
  return LArm;
end;

// The arm the char AC falls in; char(200)..char(30) is -56..30 where char is signed
func CharArm(const AC: char): int32;
var
  LArm: int32;
begin
  LArm := 0;
  match AC of
    'a'..'z': LArm := 1;
    '0'..'9': LArm := 2;
    char(200)..char(30): LArm := 3;
  else
    LArm := 4;
  end;
  return LArm;
end;

// The arm the byte AB falls in: 100..200 holds 150 only when compared unsigned
func ByteArm(const AB: uint8): int32;
var
  LArm: int32;
begin
  LArm := 0;
  match AB of
    0..99: LArm := 1;
    100..200: LArm := 2;
  else
    LArm := 3;
  end;
  return LArm;
end;

// The arm AU falls in, its labels past int64's range
func WideArm(const AU: uint64): int32;
var
  LArm: int32;
begin
  LArm := 0;
  match AU of
    1u..9223372036854775808u: LArm := 1;
    18446744073709551600u..18446744073709551615u: LArm := 2;
  else
    LArm := 3;
  end;
  return LArm;
end;

// The arm the choice AK falls in, every value named
func ColorArm(const AK: K): int32;
var
  LArm: int32;
begin
  LArm := 0;
  match AK of
    K.Red: LArm := 1;
    K.Green, K.Blue: LArm := 2;
  end;
  return LArm;
end;

// 1 when AN is 7 (a return from inside an arm), else 0 after the match
func IsSeven(const AN: int32): int32;
begin
  match AN of
    7: return 1;
  end;
  return 0;
end;

func Run();
var
  LI: int32;
  LN: int32;
  LSum: int32;
begin
  // a list, ranges, a negative range and the else
  ShowInt(Classify(3));
  ShowInt(Classify(4));
  ShowInt(Classify(19));
  ShowInt(Classify(30));
  ShowInt(Classify(-5));
  ShowInt(Classify(0));
  // no else: no arm holds, the match does nothing
  LN := 4;
  match LN of
    1..3: ShowInt(100);
  end;
  ShowInt(LN);
  // the subject's call runs once, whatever labels are tested
  match SubjectAt(12) of
    1..5: ShowInt(1);
    7, 8, 9: ShowInt(2);
    10..15: ShowInt(3);
  end;
  // a char subject, signed on win64
  ShowInt(CharArm('q'));
  ShowInt(CharArm('5'));
  ShowInt(CharArm(char(10)));
  ShowInt(CharArm(char(240)));
  ShowInt(CharArm(char(40)));
  // uint8 and uint64 subjects compare unsigned
  ShowInt(ByteArm(150));
  ShowInt(ByteArm(250));
  ShowInt(WideArm(18446744073709551610u));
  ShowInt(WideArm(9223372036854775808u));
  ShowInt(WideArm(0u));
  // a choices subject
  ShowInt(ColorArm(K.Red));
  ShowInt(ColorArm(K.Blue));
  // a return from an arm
  ShowInt(IsSeven(7));
  ShowInt(IsSeven(8));
  // a leave from an arm goes to the match's end
  LN := 2;
  match LN of
    2:
      ShowInt(21);
      if LN = 2 then
        leave;
      end;
      ShowInt(22);
  end;
  ShowInt(23);
  // in a loop: skip goes on with the loop, leave only leaves the match
  LSum := 0;
  for LI := 1 to 6 do
    match LI of
      2, 4: skip;
      5: leave;
    end;
    LSum += LI;
  end;
  ShowInt(LSum);
  ShowInt(LI);
end;

begin
  Run();
  exit(0);
end.
