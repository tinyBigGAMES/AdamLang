-------------------------------------------------------------------------------
  flow_err_effects.adam - Break step of statements and values (AUD4 5.6): an
  '=' statement (PR0048, that one report), a statement with no effect
  (SM0613; an assignment, a call, ++ and await do something), a record
  literal's fields out of their declared order (SM0416, a parent's fields
  first), an intrinsic named as a value (SM0423) and exccode() / excmsg()
  outside an except body (SM0615)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe flow_err_effects;

type
  TP = record
    X: int32;
    Y: int32;
  end;
  TQ = record(TP)
    Z: int32;
  end;

var
  LN: int32;
  LP: TP;
  LQ: TQ;
  LS: string;

func Bump(): int32;
begin
  LN := LN + 1;
  return LN;
end;

func Report();
begin
  println("{}", excmsg()); // ERROR SM0615@17
end;

begin
  LN = 5; // ERROR PR0048@3
  LN + 1; // ERROR SM0613@3
  LN; // ERROR SM0613@3
  (LN * 2); // ERROR SM0613@4
  Bump();
  LN := 1;
  LN++;
  LP := TP(Y: 1, X: 2); // ERROR SM0416@18
  LP := TP(X: 1, Y: 2);
  LQ := TQ(Z: 3, X: 1); // ERROR SM0416@18
  LQ := TQ(X: 1, Y: 2, Z: 3);
  LN := len; // ERROR SM0423@9
  LN := paramcount; // ERROR SM0423@9
  LN := paramcount();
  LN := exccode(); // ERROR SM0615@9
  guard
    raise("boom");
  except
    println("{} {}", exccode(), excmsg());
    LS := excmsg();
  end;
end.
