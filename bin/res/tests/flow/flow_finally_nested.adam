-------------------------------------------------------------------------------
  flow_finally_nested.adam - protected regions inside a finally (BNF sec 5,
  B1: nested funclets): a guard (its finally and its except part), a lock,
  a defer, a for in over a sequence and a yield from inside a guard's
  finally, each on both ways out of the guard's body: where it falls
  through (the finally lowered in the routine) and where a raise unwinds it
  (the finally a funclet, the regions inside it funclets of the funclet).
  A raise inside the finally caught inside it; a nested finally reading the
  routine's locals two and three levels up, the routine's frame realigned
  (a record aligned 32); a lock let go of by an unwind inside the finally;
  a generator the finally's loop leaves aborted (its defer runs); the
  managed temporaries of every level released
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | inner finally local 2
  | caught inner
  | inner finally local 2
  | caught inner
  | caller guard body
  | depth3 7 40
  | caught three
  | caught two
  | depth3 7 40
  | caught three
  | caught two
  | caller deep
  | in lock held
  | caught in lock
  | after lock free
  | in lock held
  | caught in lock
  | after lock free
  | caller lock body
  | loop sum 6
  | gen done
  | deferred on raise
  | caught in loop 1
  | deferred sum 6
  | loop sum 6
  | gen done
  | deferred on raise
  | caught in loop 1
  | deferred sum 6
  | caller loop body
  | outer 10
  | outer 1
  | outer 2
  | outer 10
  | outer 1
  | outer 2
  | caller gen body
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe flow_finally_nested;

import System.SysUtils;

type
  // A frame holding one is realigned to 32
  Wide = record align(32)
    A: int32;
    B: int64;
  end;

var
  GLock: mutex;

// 1 .. ACount
routine Numbers(const ACount: int32): sequence of int32;
var
  LI: int32;
begin
  for LI := 1 to ACount do
    yield LI;
  end;
end;

// 1, 2; its defer runs when it ends or is aborted
routine Counted(): sequence of int32;
begin
  defer println("gen done");
  yield 1;
  yield 2;
end;

// True when a trylock takes GLock
routine Probe(): bool;
begin
  trylock (GLock) do
    return true;
  end;
  return false;
end;

// "free" or "held": GLock asked from another thread
routine FreeText(): string;
var
  LFree: task bool;
begin
  LFree := async Probe();
  if await LFree then
    return "free";
  end;
  return "held";
end;

// A guard inside the finally: its own finally (run by the raise its body makes) reads the
// routine's locals, its except part catches the raise
routine GuardIn(const ARaise: bool);
var
  LCount: int32;
  LText: string;
begin
  LCount := 1;
  LText := "local";
  guard
    if ARaise then
      raise("guard body");
    end;
  finally
    guard
      guard
        LCount := LCount + 1;
        raise("inner");
      finally
        println("{}", "inner finally " + LText + " " + IntToStr(LCount));
      end;
    except
      println("{}", "caught " + excmsg());
    end;
  end;
end;

// Three levels: a finally inside a finally inside the finally, reading the realigned
// frame's record
routine Deep(const ARaise: bool);
var
  LWide: Wide;
begin
  LWide.A := 7;
  LWide.B := 40;
  guard
    if ARaise then
      raise("deep");
    end;
  finally
    guard
      guard
        raise("two");
      finally
        guard
          guard
            raise("three");
          finally
            println("{}", "depth3 " + IntToStr(LWide.A) + " " + IntToStr(LWide.B));
          end;
        except
          println("{}", "caught " + excmsg());
        end;
      end;
    except
      println("{}", "caught " + excmsg());
    end;
  end;
end;

// A lock inside the finally, left by a raise: the mutex is let go of
routine LockIn(const ARaise: bool);
begin
  guard
    if ARaise then
      raise("lock body");
    end;
  finally
    guard
      lock (GLock) do
        println("{}", "in lock " + FreeText());
        raise("in lock");
      end;
    except
      println("{}", "caught " + excmsg());
    end;
    println("{}", "after lock " + FreeText());
  end;
end;

// A defer and two for in loops over sequences inside the finally: one left by a leave,
// one by a raise (its generator aborted, the defer around it run)
routine LoopIn(const ARaise: bool);
var
  LN: int32;
  LSum: int32;
begin
  LSum := 0;
  guard
    if ARaise then
      raise("loop body");
    end;
  finally
    defer println("{}", "deferred sum " + IntToStr(LSum));
    for LN in Numbers(5) do
      if LN = 4 then
        leave;
      end;
      LSum := LSum + LN;
    end;
    println("{}", "loop sum " + IntToStr(LSum));
    guard
      defer println("deferred on raise");
      for LN in Counted() do
        raise("in loop " + IntToStr(LN));
      end;
    except
      println("{}", "caught " + excmsg());
    end;
  end;
end;

// A yield from inside a generator's finally
routine Outer(const ARaise: bool): sequence of int32;
begin
  guard
    yield 10;
    if ARaise then
      raise("gen body");
    end;
  finally
    yield from Numbers(2);
  end;
end;

routine Consume(const ARaise: bool);
var
  LN: int32;
begin
  for LN in Outer(ARaise) do
    println("{}", "outer " + IntToStr(LN));
  end;
end;

begin
  GuardIn(false);
  guard
    GuardIn(true);
  except
    println("{}", "caller " + excmsg());
  end;
  Deep(false);
  guard
    Deep(true);
  except
    println("{}", "caller " + excmsg());
  end;
  LockIn(false);
  guard
    LockIn(true);
  except
    println("{}", "caller " + excmsg());
  end;
  LoopIn(false);
  guard
    LoopIn(true);
  except
    println("{}", "caller " + excmsg());
  end;
  Consume(false);
  guard
    Consume(true);
  except
    println("{}", "caller " + excmsg());
  end;
end.
