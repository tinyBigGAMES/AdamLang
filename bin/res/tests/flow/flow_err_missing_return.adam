-------------------------------------------------------------------------------
  flow_err_missing_return.adam - SM0612 still holds where the end can be
  reached: an if with no else, a return only inside a loop, a leave before
  the return (the path leaves the loop and falls off the end), and a list
  whose first ending statement is a leave, not a return
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe flow_err_missing_return;

func NoElse(const AFlag: bool): int32; // ERROR SM0612: missing return: 'NoElse' can reach its end without returning a value
begin
  if AFlag then
    return 1;
  end;
end;

func InLoop(const ACount: int32): int32; // ERROR SM0612: missing return: 'InLoop' can reach its end without returning a value
var
  LI: int32;
begin
  for LI := 1 to ACount do
    return LI;
  end;
end;

func LeaveFirst(): int32; // ERROR SM0612: missing return: 'LeaveFirst' can reach its end without returning a value
begin
  while true do
    leave;
    return 1; // WARN SM0622
  end;
end;

begin
end.
