-------------------------------------------------------------------------------
  flow_defer.adam - defer (BNF sec 5, D1): a deferred statement runs when
  the statement list holding it ends, by any way out: its end, a return (the
  value kept), a leave / skip of a loop around it, a raise; several run last
  first; it reads its variables as they are when it runs; in a loop's
  statements it runs at each pass's end; in a block it runs as the block
  ends; one with nothing after it runs at once; a begin .. end statement is
  deferred whole; a managed local it reads is released after it runs; a
  variable named defer still reads and assigns
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | body
  | deferred
  | three
  | two
  | one
  | value 7 log returned
  | sees 2
  | pass 1
  | end 1
  | end 2
  | pass 3
  | end 3
  | left 4
  | cleanup
  | caught inside
  | in block
  | block done
  | after block
  | at once
  | next
  | first
  | second
  | text kept
  | named 5
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe flow_defer;

import System.SysUtils;

var
  GLog: string;

// The deferred statement runs after the rest of the list
routine Basic();
begin
  defer println("deferred");
  println("body");
end;

// Three defers run last first
routine Order();
begin
  defer println("one");
  defer println("two");
  defer println("three");
end;

// A return's value is kept while the deferred statement runs
routine Valued(): int32;
begin
  defer GLog := "returned";
  GLog := "set";
  return 7;
end;

// The deferred statement reads its variable as it is when it runs
routine Sees();
var
  LX: int32;
begin
  LX := 1;
  defer println("{}", "sees " + IntToStr(LX));
  LX := 2;
end;

// Each pass runs its own defer: at the pass's end and on a skip; a leave runs it too
routine Passes();
var
  LI: int32;
begin
  for LI := 1 to 3 do
    defer println("{}", "end " + IntToStr(LI));
    if LI = 2 then
      skip;
    end;
    println("{}", "pass " + IntToStr(LI));
  end;
  LI := 0;
  while true do
    LI := LI + 1;
    defer
      if LI = 4 then
        println("{}", "left " + IntToStr(LI));
      end;
    if LI = 4 then
      leave;
    end;
  end;
end;

// A raise out of the list runs the deferred statement on its way out
routine Raises();
begin
  defer println("cleanup");
  raise("inside");
end;

// A block's defer runs as the block ends; one with nothing after it runs at once; a
// begin .. end statement is deferred whole; a deferred managed local is released after
routine Scopes();
var
  LText: string;
begin
  begin
    defer println("block done");
    println("in block");
  end;
  println("after block");
  begin
    defer println("at once");
  end;
  println("next");
  begin
    defer begin
      println("first");
      println("second");
    end;
  end;
  LText := "text " + "kept";
  defer println("{}", LText);
end;

// A variable named defer is no defer statement
routine Named();
var
  defer: int32;
begin
  defer := 5;
  println("{}", "named " + IntToStr(defer));
end;

begin
  Basic();
  Order();
  println("{}", "value " + IntToStr(Valued()) + " log " + GLog);
  Sees();
  Passes();
  guard
    Raises();
  except
    println("{}", "caught " + excmsg());
  end;
  Scopes();
  Named();
end.
