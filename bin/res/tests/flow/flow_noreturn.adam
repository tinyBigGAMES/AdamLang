-------------------------------------------------------------------------------
  flow_noreturn.adam - routines written noreturn and while true loops no leave
  leaves end the path (BNF sec 3): a valued routine ending in a noreturn call
  or such a loop has no SM0612, a statement after one is SM0622 (a warning).
  A noreturn forward is called before its full routine; a noreturn body ends
  in a raise or an endless loop; a leave in a nested loop leaves only that
  one; an external routine is noreturn too (the C library's exit ends the program
  with exit code 7). The dead statements never run. Lowered, a noreturn call
  (a routine's, an external's) ends its block in an unreachable, with no jump
  after it (PLAN-ADAM M6 O9)
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 7
  ir| call f6(i8)
  ir| unreachable
  ir| callx x1(i<NUM>)
  ir| unreachable
  | pick 1
  | checked 8
  | first even 8
  | first over 32
  | nested 3
  | caught caught
  | valued caught
@@end
*/

module exe flow_noreturn;

@ifdef TARGET_X86_64_LINUX_GNU
routine exit(const ACode: int32); noreturn; external "c";
@else
routine exit(const ACode: int32); noreturn; external "ucrtbase";
@endif

// Called before its full routine below, which agrees on noreturn
forward routine Fail(const AText: string); noreturn;

// A noreturn call ends the path: no missing return after it
routine Pick(const AFlag: bool): int32;
begin
  if AFlag then
    return 1;
  end;
  Fail("no pick");
end;

// A statement after a noreturn call never runs
routine Checked(const AValue: int32): int32;
var
  LText: string;
begin
  LText := "live";
  if AValue < 0 then
    Fail("negative");
    LText := "dead";  // WARN SM0622
  end;
  return AValue * 2;
end;

// A while true no leave leaves ends the path: its return is the only way out
routine FirstEven(const AStart: int32): int32;
var
  LValue: int32;
begin
  LValue := AStart;
  while true do
    if (LValue mod 2) = 0 then
      return LValue;
    end;
    LValue := LValue + 1;
  end;
end;

// Parentheses around true change nothing; the statement after the loop never runs
routine FirstOver(const ALimit: int32): int32;
var
  LValue: int32;
begin
  LValue := 1;
  while (true) do
    LValue := LValue * 2;
    if LValue > ALimit then
      return LValue;
    end;
  end;
  return 0;  // WARN SM0622
end;

// The inner loop's leave leaves the inner loop: the outer one still never completes
routine Nested(): int32;
var
  LCount: int32;
begin
  LCount := 0;
  while true do
    while true do
      LCount := LCount + 1;
      leave;
    end;
    if LCount >= 3 then
      return LCount;
    end;
  end;
end;

// A noreturn body ending in a raise
routine Fail(const AText: string); noreturn;
begin
  raise(AText);
end;

// A noreturn body ending in an endless loop (never called)
routine Spin(); noreturn;
begin
  while true do
  end;
end;

// A valued noreturn routine: it never reaches its end, so no SM0612
routine FailValue(): int32; noreturn;
begin
  Fail("valued");
end;

// The raise of a noreturn call caught by its caller's guard
routine Caught(): string;
var
  LText: string;
  LValue: int32;
begin
  LText := "not caught";
  guard
    LValue := Pick(false);
    LText := "picked";
  except
    LText := "caught";
  end;
  return LText;
end;

// The same through the valued noreturn routine
routine CaughtValue(): string;
var
  LText: string;
  LValue: int32;
begin
  LText := "not caught";
  guard
    LValue := FailValue();
    LText := "returned";
  except
    LText := "caught";
  end;
  return LText;
end;

begin
  SetHeapReport(false);
  println("pick {}", Pick(true));
  println("checked {}", Checked(4));
  println("first even {}", FirstEven(7));
  println("first over {}", FirstOver(20));
  println("nested {}", Nested());
  println("caught {}", Caught());
  println("valued {}", CaughtValue());
  exit(7);
  println("never");  // WARN SM0622
end.
