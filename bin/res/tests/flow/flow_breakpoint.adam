-------------------------------------------------------------------------------
  flow_breakpoint.adam - @breakpoint among statements (BNF sec 5, DESIGN sec
  9): its line gets code of its own (a mark, one nop), the address the
  debugger stops at; nothing changes at run time. Three of them (a routine
  called in a loop, a match arm, the program block) each keep their mark at
  every optimization level: no pass removes, moves or merges one (an inlined
  copy may add more).
*******************************************************************************/

/*
@@test
  kind run
  targets x86_64-windows-gnu x86_64-linux-gnu
  exitcode 0
  levels debug safe fast small
  ir| mark
  ir| mark
  ir| mark
  | step 1
  | step 2
  | arm 3
  | end
@@end
*/

module exe flow_breakpoint;

var
  GI: int64;
  GSum: int64;

// One step, its line marked
func Step(const AN: int64);
begin
  @breakpoint;
  GSum := GSum + AN;
  println("step {}", AN);
end;

begin
  // one expect for every level: a release build prints no heap report
  SetHeapReport(false);
  for GI := 1 to 2 do
    Step(GI);
  end;
  match GSum of
    3:
      @breakpoint;
      println("arm {}", GSum);
  else
    println("other");
  end;
  @breakpoint;
  println("end");
end.
