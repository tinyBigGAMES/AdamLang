-------------------------------------------------------------------------------
  flow_err_defer.adam - defer (BNF sec 5, D1): a deferred statement cannot
  return, leave or skip out of itself (SM0717), a leave / skip of a loop
  inside it is fine; it is never a declaration (SM0718)
*******************************************************************************/

/*
@@test
  kind error
@@end
*/

module exe flow_err_defer;

func Returns(): int32;
begin
  defer return 1; // ERROR SM0717
  return 2;
end;

func Jumps();
var
  LI: int32;
begin
  for LI := 1 to 2 do
    defer leave; // ERROR SM0717
    defer begin
      skip; // ERROR SM0717
    end;
    defer
      while true do
        leave;
      end;
  end;
end;

func Declares();
begin
  defer var LX: int32; // ERROR SM0718
  println("x");
end;

begin
  Returns();
  Jumps();
  Declares();
end.
