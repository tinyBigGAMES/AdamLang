-------------------------------------------------------------------------------
  flow_stmt_locals.adam - var / const blocks among statements (BNF sec 5;
  found with PLAN-ADAM T2): a block ends before a statement that starts with
  a name (`LX := ..`, `println(..)`), in a loop's body and in an if's then;
  each pass through the declaration starts it again: its initializer re-run,
  a record holding a string zeroed (the last pass's string released), an
  object with a done ended before it is built again (and at the routine's
  end); a constant among statements; no leak.
*******************************************************************************/

/*
@@test
  kind run
  exitcode 0
  | x 6
  | x 7
  | x 8
  | n 0 s ab
  | n 0 s ab
  | c 7
  | then 2
  | pass 1
  | done
  | pass 2
  | after
  | done
  | [Heap] Allocs: <NUM>, Frees: <NUM>, Leaked: 0
@@end
*/

module exe flow_stmt_locals;

type
  TPair = record
    N: int32;
    S: string;
  end;

  // An object whose done says so
  TNote = object
    done;
    begin
      println("done");
    end;
  end;

routine Tests();
var
  LI: int32;
begin
  for LI := 1 to 3 do
    var LX: int32 = 5;
    LX := LX + LI;
    println("x {}", LX);
  end;
  for LI := 1 to 2 do
    var LP: TPair;
    println("n {} s {}", LP.N, LP.S + "ab");
    LP.N := 9;
    LP.S := "zz" + "y";
  end;
  const LC: int32 = 7;
  println("c {}", LC);
  if LI > 0 then
    var LT: int32;
    LT := LI;
    println("then {}", LT);
  end;
  for LI := 1 to 2 do
    var LNote: TNote;
    println("pass {}", LI);
  end;
  println("after");
end;

begin
  Tests();
end.
