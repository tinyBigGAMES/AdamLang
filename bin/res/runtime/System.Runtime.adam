  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.Runtime.adam - The runtime every Adam program carries (DESIGN sec 8)

  The compiler loads this unit into every program as an implicit import;
  Semantics writes its routines into what needs them: print / println run
  WriteText with their text, an exe's block ends with Halt(0), getmem /
  resizemem / freemem / paramcount run GetMem / ResizeMem / FreeMem /
  ParamCount. M2's first slice: text to stdout and the process exit, over
  ucrtbase (which initializes itself at load: no C runtime startup object);
  M3.7e the heap and the argument count. M4 grows it.
  Its routines are private: the compiler calls them and no program names
  them, so they never meet a program's or a std unit's of the same name.
*******************************************************************************/

module unit System.Runtime;

// ucrtbase: the C runtime's stream table (1 = stdout), its writer, its exit
routine __acrt_iob_func(const AIndex: uint32): ptr; external "ucrtbase";
routine fwrite(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AStream: ptr): int64; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";

// ucrtbase: the C heap; the process's arguments, split from its command line by
// _configure_narrow_argv (a C program's startup code calls it: an Adam exe has none, so
// the runtime does, once, before it reads them; mode 1 = unexpanded, no wildcards)
routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine realloc(const APointer: ptr; const ASize: uint64): ptr; external "ucrtbase";
routine free(const APointer: ptr); external "ucrtbase";
routine _configure_narrow_argv(const AMode: int32): int32; external "ucrtbase";
routine __p___argc(): ptr to int32; external "ucrtbase";

var
  // True once the process's arguments are split (ReadyArguments)
  GArgumentsReady: bool;

// Writes the ACount bytes at AText to stdout as they are
routine WriteText(const AText: ptr; const ACount: int64);
var
  LStream: ptr;
begin
  LStream := __acrt_iob_func(1);
  fwrite(AText, 1, ACount, LStream);
end;

// Ends the process with the exit code ACode (stdout flushed by ucrtbase)
routine Halt(const ACode: int32);
begin
  exit(ACode);
end;

// getmem(N): N bytes from the heap, uninitialized (running out raises once exceptions
// exist, M3.11)
routine GetMem(const ASize: int64): ptr;
begin
  return malloc(uint64(ASize));
end;

// resizemem(P, N): the block at P grown or shrunk to N bytes, its contents kept up to the
// smaller size, maybe moved (the new address); nil P allocates
routine ResizeMem(const APointer: ptr; const ASize: int64): ptr;
begin
  return realloc(APointer, uint64(ASize));
end;

// freemem(P): the block at P back to the heap; nil does nothing
routine FreeMem(const APointer: ptr);
begin
  free(APointer);
end;

// The process's arguments split from its command line, the first time it is asked
routine ReadyArguments();
begin
  if not GArgumentsReady then
    _configure_narrow_argv(1);
    GArgumentsReady := true;
  end;
end;

// paramcount(): the number of command-line arguments after the program's name
routine ParamCount(): int32;
var
  LCount: ptr to int32;
begin
  ReadyArguments();
  LCount := __p___argc();
  return LCount^ - 1;
end;

end.
