-------------------------------------------------------------------------------
  System.Runtime.adam - The runtime every Adam program carries (DESIGN sec 8)

  The compiler loads this unit into every program as an implicit import;
  Semantics writes its routines into what needs them: print / println run
  WriteText with their text, an exe's block ends with Halt(0). M2's first
  slice: text to stdout and the process exit, over ucrtbase (which
  initializes itself at load: no C runtime startup object). M4 grows it.
  Its routines are private: the compiler calls them and no program names
  them, so they never meet a program's or a std unit's of the same name.
*******************************************************************************/

module unit System.Runtime;

// ucrtbase: the C runtime's stream table (1 = stdout), its writer, its exit
routine __acrt_iob_func(const AIndex: uint32): ptr; external "ucrtbase";
routine fwrite(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AStream: ptr): int64; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";

// Writes the ACount bytes at AText to stdout as they are
routine WriteText(const AText: ptr; const ACount: int64);
var
  LStream: ptr;
begin
  LStream := __acrt_iob_func(1);
  fwrite(AText, 1, ACount, LStream);
end;

// Ends the process with the exit code ACode (stdout flushed by ucrtbase)
routine Halt(const ACode: int32);
begin
  exit(ACode);
end;

end.
