-------------------------------------------------------------------------------
  System.Runtime.adam - The runtime every Adam program carries (DESIGN sec 8)

  The compiler loads this unit into every program as an implicit import;
  Semantics writes its routines into what needs them: print / println run
  WriteText with their text, an exe's block ends with Halt(0), getmem /
  resizemem / freemem / paramcount run GetMem / ResizeMem / FreeMem /
  ParamCount. The heap routines count every block they hand out and take
  back, and PaskalCPP's heap report prints as the process ends (any exit).
  M4 grows it.

  It is the same on every target and names no OS: every OS call goes
  through a Platform routine of the target's platform unit
  (Target.RuntimeUnit: System.Runtime.Win64 on x86_64-windows-gnu), which
  the compiler loads with it as its implicit import. A new target adds its
  platform unit; this file does not change.
  Its routines are private: the compiler calls them and no program names
  them, so they never meet a program's or a std unit's of the same name.
*******************************************************************************/

module unit System.Runtime;

var
  // The heap report's counts (Adam's own report, split as PaskalCPP's detail_report_leaks):
  // every block the heap routines below hand out, and every one they take back; a count is
  // never negative
  GAllocs: uint64;
  GFrees: uint64;

// Writes the ACount bytes at AText to stdout as they are
routine WriteText(const AText: ptr; const ACount: int64);
begin
  PlatformWrite(AText, ACount);
end;

// Writes the digits of AMagnitude to stdout in decimal, a '-' before them when ANegative
routine WriteDecimal(const AMagnitude: uint64; const ANegative: bool);
var
  LDigits: array[0..23] of char;
  LAt: int64;
  LRest: uint64;
begin
  // The digits are written from the end of LDigits back toward its start
  LAt := 24;
  LRest := AMagnitude;
  repeat
    LAt := LAt - 1;
    LDigits[LAt] := char(48 + int64(LRest mod 10));
    LRest := LRest div 10;
  until LRest = 0;
  if ANegative then
    LAt := LAt - 1;
    LDigits[LAt] := '-';
  end;
  PlatformWrite(addr of LDigits[LAt], 24 - LAt);
end;

// Writes AValue to stdout in decimal, a '-' before a negative one
routine WriteInt(const AValue: int64);
begin
  // The magnitude is taken as uint64 so the most negative int64 has one too
  if AValue < 0 then
    WriteDecimal(uint64(0) - uint64(AValue), true);
  else
    WriteDecimal(uint64(AValue), false);
  end;
end;

// Writes AValue to stdout in decimal
routine WriteUInt(const AValue: uint64);
begin
  WriteDecimal(AValue, false);
end;

// The heap report, Adam's own line: `[Adam Heap] Allocs: N, Frees: N, Leaked: N` (DESIGN
// sec 8: Adam's debug diagnostic, not PaskalCPP's `[Heap]`; every build is a debug build until
// M6's levels, a release build will not print it). The leak is signed: a block freed that was
// never counted shows as negative, not wrapped
routine ReportHeap();
begin
  print("[Adam Heap] Allocs: ");
  WriteUInt(GAllocs);
  print(", Frees: ");
  WriteUInt(GFrees);
  print(", Leaked: ");
  WriteInt(int64(GAllocs) - int64(GFrees));
  println();
end;

// Ends the process with the exit code ACode (the heap report runs as it ends, see the
// initialize section)
routine Halt(const ACode: int32);
begin
  PlatformExit(ACode);
end;

// getmem(N): N bytes from the heap, uninitialized, counted; 0 bytes is nil, uncounted
// (running out raises once exceptions exist, M3.11)
routine GetMem(const ASize: int64): ptr;
var
  LBlock: ptr;
begin
  if ASize <= 0 then
    return nil;
  end;
  LBlock := PlatformAlloc(ASize);
  if LBlock <> nil then
    GAllocs := GAllocs + 1;
  end;
  return LBlock;
end;

// resizemem(P, N): the block at P grown or shrunk to N bytes, its contents kept up to the
// smaller size, maybe moved (the new address); nil P allocates (counted), N of 0 frees P
// (counted) and is nil
routine ResizeMem(const APointer: ptr; const ASize: int64): ptr;
var
  LBlock: ptr;
begin
  if APointer = nil then
    return GetMem(ASize);
  end;
  if ASize <= 0 then
    PlatformFree(APointer);
    GFrees := GFrees + 1;
    return nil;
  end;
  LBlock := PlatformResize(APointer, ASize);
  return LBlock;
end;

// freemem(P): the block at P back to the heap, counted; nil does nothing
routine FreeMem(const APointer: ptr);
begin
  if APointer = nil then
    return;
  end;
  PlatformFree(APointer);
  GFrees := GFrees + 1;
end;

// A string value is nil (the empty string) or the address of its block: the ref count
// (int64; -1 for a literal's block, constant data never counted or freed), the length in
// bytes (int64), the UTF-8 bytes, a 0. Strings are values (DESIGN sec 8): blocks are
// shared and every holder counts once; a block whose count drops to 0 goes back to the
// heap. The compiler calls StrRelease / StrAssign / StrWrite / StrTake / StrConcat /
// StrFromChar / StrLength / StrCompare / StrUnique / StrSetLength (AST RuntimeRoutine); a
// write into a string's bytes first makes its block the variable's alone (StrUnique: copy
// on write); StrConcat and StrFromChar hand back a reference the caller holds (the
// compiler keeps it in a hidden slot, released at the routine's exit).

// The length in bytes of the string AText (nil: 0)
routine StrLength(const AText: ptr): int64;
var
  LHeader: ptr to int64;
begin
  if AText = nil then
    return 0;
  end;
  LHeader := ptr to int64(AText);
  return LHeader[1];
end;

// A new string block of ALength bytes (its ref count 1, its bytes after the header for the
// caller to fill, the 0 after them written); nil for 0 bytes
routine StrNew(const ALength: int64): ptr;
var
  LBlock: ptr;
  LHeader: ptr to int64;
  LBytes: ptr to uint8;
begin
  if ALength <= 0 then
    return nil;
  end;
  LBlock := GetMem(16 + ALength + 1);
  LHeader := ptr to int64(LBlock);
  LHeader[0] := 1;
  LHeader[1] := ALength;
  LBytes := ptr to uint8(LBlock);
  LBytes[16 + ALength] := 0;
  return LBlock;
end;

// One more holder of the string AText (nil and a literal's block count nothing)
routine StrAddRef(const AText: ptr);
var
  LHeader: ptr to int64;
begin
  if AText = nil then
    return;
  end;
  LHeader := ptr to int64(AText);
  if LHeader[0] >= 0 then
    LHeader[0] := LHeader[0] + 1;
  end;
end;

// One holder less of the string AText: its block freed when it was the last (nil and a
// literal's block count nothing)
routine StrRelease(const AText: ptr);
var
  LHeader: ptr to int64;
begin
  if AText = nil then
    return;
  end;
  LHeader := ptr to int64(AText);
  if LHeader[0] < 0 then
    return;
  end;
  LHeader[0] := LHeader[0] - 1;
  if LHeader[0] = 0 then
    FreeMem(AText);
  end;
end;

// The string AText stored into the string variable at ASlot: a holder added to AText
// before the old value is released, so storing a variable's own value keeps it
routine StrAssign(const ASlot: ptr to ptr; const AText: ptr);
var
  LOld: ptr;
begin
  StrAddRef(AText);
  LOld := ASlot^;
  ASlot^ := AText;
  StrRelease(LOld);
end;

// The string AText, a reference the caller already holds, stored into the string slot at
// ASlot (a hidden one: a concatenation's or a char's string), its old value released
routine StrTake(const ASlot: ptr to ptr; const AText: ptr);
var
  LOld: ptr;
begin
  LOld := ASlot^;
  ASlot^ := AText;
  StrRelease(LOld);
end;

// ALeft followed by ARight, a reference the caller holds: a new block, or the one side
// itself (one more holder) when the other is empty; nil when both are
routine StrConcat(const ALeft: ptr; const ARight: ptr): ptr;
var
  LLeftLength: int64;
  LRightLength: int64;
  LBlock: ptr;
  LTo: ptr to uint8;
  LFrom: ptr to uint8;
begin
  LLeftLength := StrLength(ALeft);
  LRightLength := StrLength(ARight);
  if LRightLength = 0 then
    StrAddRef(ALeft);
    return ALeft;
  end;
  if LLeftLength = 0 then
    StrAddRef(ARight);
    return ARight;
  end;
  LBlock := StrNew(LLeftLength + LRightLength);
  LTo := ptr to uint8(LBlock);
  LFrom := ptr to uint8(ALeft);
  PlatformCopy(addr of LTo[16], addr of LFrom[16], LLeftLength);
  LFrom := ptr to uint8(ARight);
  PlatformCopy(addr of LTo[16 + LLeftLength], addr of LFrom[16], LRightLength);
  return LBlock;
end;

// The one-char string of AChar, a reference the caller holds
routine StrFromChar(const AChar: char): ptr;
var
  LBlock: ptr;
  LTo: ptr to char;
begin
  LBlock := StrNew(1);
  LTo := ptr to char(LBlock);
  LTo[16] := AChar;
  return LBlock;
end;

// ALeft against ARight byte by byte, each byte unsigned, then the shorter first (as
// PaskalCPP's std::string compares): -1, 0 or 1 as ALeft is below, equal to or above ARight
routine StrCompare(const ALeft: ptr; const ARight: ptr): int32;
var
  LLeftLength: int64;
  LRightLength: int64;
  LCount: int64;
  LLeftBytes: ptr to uint8;
  LRightBytes: ptr to uint8;
  LI: int64;
begin
  if ALeft = ARight then
    return 0;
  end;
  LLeftLength := StrLength(ALeft);
  LRightLength := StrLength(ARight);
  LCount := LLeftLength;
  if LRightLength < LCount then
    LCount := LRightLength;
  end;
  LLeftBytes := ptr to uint8(ALeft);
  LRightBytes := ptr to uint8(ARight);
  // the bytes start after the 16-byte header; LCount is 0 when either side is nil
  for LI := 0 to LCount - 1 do
    if LLeftBytes[16 + LI] <> LRightBytes[16 + LI] then
      if LLeftBytes[16 + LI] < LRightBytes[16 + LI] then
        return -1;
      end;
      return 1;
    end;
  end;
  if LLeftLength < LRightLength then
    return -1;
  end;
  if LLeftLength > LRightLength then
    return 1;
  end;
  return 0;
end;

// The string in the string variable at ASlot made its holder's alone before a write into
// its bytes (copy on write): a block shared with another holder, or a literal's constant
// one, is copied into a new block the slot then holds (the old one released); the block
// the slot holds after, nil for the empty string
routine StrUnique(const ASlot: ptr to ptr): ptr;
var
  LText: ptr;
  LHeader: ptr to int64;
  LCopy: ptr;
  LTo: ptr to uint8;
  LFrom: ptr to uint8;
begin
  LText := ASlot^;
  if LText = nil then
    return nil;
  end;
  LHeader := ptr to int64(LText);
  if LHeader[0] = 1 then
    return LText;
  end;
  LCopy := StrNew(LHeader[1]);
  LTo := ptr to uint8(LCopy);
  LFrom := ptr to uint8(LText);
  PlatformCopy(addr of LTo[16], addr of LFrom[16], LHeader[1]);
  ASlot^ := LCopy;
  StrRelease(LText);
  return LCopy;
end;

// setlength(S, N) on the string variable at ASlot: N bytes after it, the first kept up to
// the smaller length and any added ones 0 (std::string's resize); the same length changes
// nothing; 0 is the empty string, nil (a negative N raises once exceptions exist, M3.11:
// until then it empties the string too). A block shared or constant is not grown in place:
// the new one is the slot's own
routine StrSetLength(const ASlot: ptr to ptr; const ALength: int64);
var
  LOld: ptr;
  LOldLength: int64;
  LKept: int64;
  LHeader: ptr to int64;
  LBlock: ptr;
  LTo: ptr to uint8;
  LFrom: ptr to uint8;
  LI: int64;
begin
  LOld := ASlot^;
  LOldLength := StrLength(LOld);
  if ALength = LOldLength then
    return;
  end;
  if ALength <= 0 then
    ASlot^ := nil;
    StrRelease(LOld);
    return;
  end;
  LKept := LOldLength;
  if ALength < LKept then
    LKept := ALength;
  end;
  LHeader := ptr to int64(LOld);
  if (LOld <> nil) and (LHeader[0] = 1) then
    // the slot's own block: resized where it is (maybe moved), its bytes kept
    LBlock := ResizeMem(LOld, 16 + ALength + 1);
    LHeader := ptr to int64(LBlock);
    LHeader[1] := ALength;
  else
    LBlock := StrNew(ALength);
    if LKept > 0 then
      LTo := ptr to uint8(LBlock);
      LFrom := ptr to uint8(LOld);
      PlatformCopy(addr of LTo[16], addr of LFrom[16], LKept);
    end;
    StrRelease(LOld);
  end;
  LTo := ptr to uint8(LBlock);
  for LI := LKept to ALength - 1 do
    LTo[16 + LI] := 0;
  end;
  LTo[16 + ALength] := 0;
  ASlot^ := LBlock;
end;

// Writes the bytes of the string AText to stdout (nil writes nothing)
routine StrWrite(const AText: ptr);
var
  LHeader: ptr to int64;
  LBytes: ptr to uint8;
begin
  if AText = nil then
    return;
  end;
  LHeader := ptr to int64(AText);
  LBytes := ptr to uint8(AText);
  PlatformWrite(addr of LBytes[16], LHeader[1]);
end;

// paramcount(): the number of command-line arguments after the program's name
routine ParamCount(): int32;
begin
  return PlatformArgCount() - 1;
end;

// The heap report is registered to run as the process ends, by whatever exit (PaskalCPP
// prints it from a static destructor, so a program's own exit call prints it too); this
// section runs before every other module's, so the report runs after theirs
initialize
begin
  PlatformAtExit(ReportHeap);
end;

end.
