  (RUNTIME-EXCEPTION.md).
-------------------------------------------------------------------------------
  System.Runtime.adam - The runtime every Adam program carries (DESIGN sec 8)

  The compiler loads this unit into every program as an implicit import;
  Semantics writes its routines into what needs them: print / println /
  FormatStr run SinkText with their text, an exe's block ends with Halt(0), getmem /
  resizemem / freemem / paramcount / paramstr run GetMem / ResizeMem /
  FreeMem / ParamCount / ParamStr. The heap routines count every block they
  hand out and take back, and PaskalCPP's heap report prints as the process
  ends (any exit).
  M4 grows it.

  It is the same on every target and names no OS: every OS call goes
  through a Platform routine of the target's platform unit
  (Target.RuntimeUnit: System.Runtime.Win64 on x86_64-windows-gnu), which
  the compiler loads with it as its implicit import. A new target adds its
  platform unit; this file does not change.
  Its routines are private: the compiler calls them and no program names
  them, so they never meet a program's or a std unit's of the same name.
  The exceptions (user 2026-11-07), public to a program that imports
  System.Runtime: SetHeapReport turns its heap report off (adam.exe does,
  unless --heap is given); HeapLive tells how many heap blocks are live now
  (a row's proof that a temporary ended); FlushOutput writes out what
  stdout still holds, so a line is seen as it is printed even when stdout
  is a file or a pipe (adam.exe's phase lines); CopyBytes copies a block
  of bytes in one go (the platform's copy: the compiler's and the std's
  one byte copy); ReadFileBytes reads a file
  whole into a getmem block (System.Toml's file parse: the std's one
  target-neutral file read);
  FindCRuntimeFunction and FindLoadedFunction find a C function by name, the
  C runtime's or a loaded library's (System.HookAbi's HookReal). ThreadStart
  and ThreadJoin start a thread and wait for its end; LockCreate, LockEnter,
  LockLeave and LockFree are the OS's lock (H4t2b). The type VarKind is what
  varargs.kind(I) answers with (M3.8h).

  Threads: every routine here may run on any thread at once. The heap counts
  and every string, dynamic array and ref count change only through the
  atomics (BNF sec 7); the raise in flight is threadstatic, one per thread;
  a started thread runs inside its own catching scope (ThreadRun).
*******************************************************************************/

module unit System.Runtime;

// The Unicode tables print's text specs read (M3.8f4; generated from libc++'s)
import System.Runtime.Unicode;

@ifdef DEBUG
var
  // The heap report's counts (Adam's own report, split as PaskalCPP's detail_report_leaks):
  // every block the heap routines below hand out, and every one they take back; a count is
  // never negative. Every thread counts into them, so they change only through atomicadd.
  // A debug build's alone (DESIGN sec 8, PROJECT AD.10): a release build counts nothing
  GAllocs: uint64;
  GFrees: uint64;
  // The heap report prints as the process ends (set in the initialize section; a program
  // turns it off with SetHeapReport)
  GHeapReport: bool;
@endif

var
  // 0 until a thread reports a raise nothing caught (Unhandled): the first one that takes
  // it (atomicswap) reports and ends the process, any other waits for that end
  GUnhandled: int32;
  // 0 until Halt or Unhandled starts the exit (atomicswap): the exit handlers (each module's
  // teardown, BNF sec 1) run once, so a second exit asked from inside them (a Halt or a raise
  // in a finalize) ends the process at once (PlatformQuit) instead of running them again
  GExiting: int32;
  // The program's release of the calling thread's managed threadstatics (the compiler's,
  // handed over by the entry: SetThreadRelease; nil when the program has none), run as each
  // thread but the main one ends (ThreadEnded)
  GThreadRelease: routine();
  // The tasks whose thread is running their call, counted from TaskStart until the thread's
  // last step (TaskLeave): the exit waits until none is left (TaskWait)
  GTasksRunning: int64;
  // The threads of detached tasks (no await joined them) that ended their call: ThreadStart
  // blocks linked through their first word (dead once the thread runs), joined later
  // (TaskReap as a task starts, TaskWait at the exit); GTaskReapHeld is the list's lock
  // (1 held), taken by atomicswap
  GTaskReap: ptr;
  GTaskReapHeld: int32;

threadstatic
  // The raise in flight on this thread (RaiseWith): its code (PaskalCPP's: 1 for raise, 11
  // for a set item out of range) and its text, a string value this holds one reference to
  // (nil: the empty text); read by Unhandled. Each thread has its own (H4t2b), released as
  // the thread ends (ThreadEnded; the main one's at Halt)
  GRaiseCode: int32;
  GRaiseText: ptr;
  // True while MemoryFail builds its text on this thread: an allocation failing inside it
  // raises with the empty text (no block needed) instead of failing again without end
  GMemoryFailing: bool;
  // This thread's mark: its address names the thread as a mutex's owner (MutexWords.Owner),
  // no OS call needed; never read or written
  GMutexSelf: uint8;
  // On a task's thread: true while it is counted in GTasksRunning (TaskRun's start until
  // TaskLeave), and its own ThreadStart block once known (TaskWait never joins itself)
  GTaskCounted: bool;
  GTaskSelf: ptr;
  // How many for parallel bodies this thread is running (ParallelWork): a for parallel
  // that gives no workers' count runs on this thread alone while it is above 0 (a nested
  // one, T2)
  GParallelDepth: int64;
  // The object of the task whose call this thread runs (TaskRun; a for parallel's workers
  // take their run's, ParallelWork): cancelled() reads its cancel word, T3; nil on a thread
  // that runs none. Never counted: the call's thread holds the task while it runs
  GTaskCurrent: ptr;
  // The allocation site of the construct this thread is running (M3.12b): the compiled code
  // stores its id (1 .. the exe's site table count, in source order) right before a runtime
  // call that may allocate and 0 right after it, so every block DoGetMem makes inside that
  // call (the runtime's own helpers' included) belongs to the construct; 0 is "runtime",
  // a block the runtime makes outside such a call (a thread block). The compiler
  // finds it by name (Semantics' ADAM_SEMANTICS_RUNTIME_ALLOC_SITE). Debug builds only
  // (BNF sec 9 DEBUG): a release build stores no site and has no GAllocSite
@ifdef DEBUG
  GAllocSite: int32;
@endif

type
  // A mutex's bytes (BNF sec 4; the target lays out ADAM_TARGET_*_MUTEX_SIZE / _ALIGN as
  // this record): State 0 free, 1 held, 2 held with a thread waiting (or that may be);
  // Count the times its owner took it (recursive); Owner the owner's mark (GMutexSelf's
  // address), nil while free. All zero is free: a mutex needs no init
  MutexWords = record
    State: int32;
    Count: int32;
    Owner: ptr;
  end;

// Writes the ACount bytes at AText to stderr (AError) or stdout as they are
routine WriteTo(const AText: ptr; const ACount: int64; const AError: bool);
begin
  if AError then
    PlatformWriteError(AText, ACount);
  else
    PlatformWrite(AText, ACount);
  end;
end;

// The digits of AMagnitude in decimal, a '-' before them when ANegative, written into the
// 24 chars at ABuffer so they end at its end; the index of the first
routine DecimalText(const ABuffer: ptr to char; const AMagnitude: uint64;
  const ANegative: bool): int64;
var
  LAt: int64;
  LRest: uint64;
begin
  // The digits are written from the end of ABuffer back toward its start
  LAt := 24;
  LRest := AMagnitude;
  repeat
    LAt := LAt - 1;
    ABuffer[LAt] := char(48 + int64(LRest mod 10));
    LRest := LRest div 10;
  until LRest = 0;
  if ANegative then
    LAt := LAt - 1;
    ABuffer[LAt] := '-';
  end;
  return LAt;
end;

// Writes the digits of AMagnitude in decimal to stderr (AError) or stdout, a '-' before
// them when ANegative
routine WriteDecimalTo(const AMagnitude: uint64; const ANegative: bool; const AError: bool);
var
  LDigits: array[0..23] of char;
  LAt: int64;
begin
  LAt := DecimalText(addr of LDigits[0], AMagnitude, ANegative);
  WriteTo(addr of LDigits[LAt], 24 - LAt, AError);
end;

// Writes AValue in decimal to stderr (AError) or stdout, a '-' before a negative one
routine WriteIntTo(const AValue: int64; const AError: bool);
begin
  // The magnitude is taken as uint64 so the most negative int64 has one too
  if AValue < 0 then
    WriteDecimalTo(uint64(0) - uint64(AValue), true, AError);
  else
    WriteDecimalTo(uint64(AValue), false, AError);
  end;
end;

// Writes the C string AText (its bytes up to its NUL) to stderr
routine WriteErrorC(const AText: ptr to const char);
var
  LCount: int64;
begin
  LCount := 0;
  while AText[LCount] <> '\0' do
    LCount := LCount + 1;
  end;
  PlatformWriteError(ptr(AText), LCount);
end;

// The heap report: `[Heap] Allocs: N, Frees: N, Leaked: N` (DESIGN sec 8: Adam's debug
// diagnostic, a debug build's alone: a release build prints none and counts nothing). The
// leak is signed: a block freed that was never counted shows as negative, not wrapped. A task
// a module's teardown started is waited for first in every build (TaskWait again: the
// entry's own ran before every teardown), so the counts are the whole program's. A debug
// build lists under it each site still holding blocks (M4.L1, DoReportLeaks)
forward routine TaskWait();
@ifdef DEBUG
forward routine DoReportLeaks();
@endif

routine ReportHeap();
begin
  TaskWait();
@ifdef DEBUG
  if not GHeapReport then
    return;
  end;
  println("[Heap] Allocs: {}, Frees: {}, Leaked: {}", atomicload(GAllocs),
    atomicload(GFrees), int64(atomicload(GAllocs)) - int64(atomicload(GFrees)));
  DoReportLeaks();
@endif
end;

// AOn: the heap report prints as the process ends (the start); off: it does not (a release
// build has no report: nothing to turn). A runtime routine a program may name (see the
// header)
public routine SetHeapReport(const AOn: bool);
begin
@ifdef DEBUG
  GHeapReport := AOn;
@endif
end;

// How many heap blocks are live right now: the allocations counted so far less the frees,
// signed as the heap report's leak is (a row proves a temporary ended with its statement by
// it); 0 in a release build, which counts nothing. A runtime routine a program may name (see
// the header)
public routine HeapLive(): int64;
begin
@ifdef DEBUG
  return int64(atomicload(GAllocs)) - int64(atomicload(GFrees));
@else
  return 0;
@endif
end;

// What the program printed and stdout still holds, written out now. A runtime routine a
// program may name (see the header)
public routine FlushOutput();
begin
  PlatformFlush();
end;

// ACount bytes from ASource to ADest, which do not overlap (nothing for a count of 0 or
// less), in one block through the platform's copy (C's memcpy on every target the runtime
// has). A runtime routine a program may name (see the header): the one byte copy, the
// compiler's and the std's
public routine CopyBytes(const ADest: ptr to uint8; const ASource: ptr to const uint8;
  const ACount: int64);
begin
  if ACount > 0 then
    PlatformCopy(ptr(ADest), ptr(ASource), ACount);
  end;
end;

// Declared below, with the strings
forward routine StrRelease(const AText: ptr);

// Ends the process with the exit code ACode through the exit handlers (each module's
// teardown, then the heap report, which the entry registered first: BNF sec 1). Public: the
// one Halt every program calls, on every target (an exe's block also ends through it). The last raise
// an except part caught on this thread is released first: a thread keeps its raise in flight
// until its next raise or its end (ThreadEnded's for a started thread, this for the main one),
// so the report counts it as given back. Asked again from inside the exit handlers (GExiting),
// the process ends at once with ACode
public routine Halt(const ACode: int32); noreturn;
begin
  StrRelease(GRaiseText);
  GRaiseText := nil;
  if atomicswap(GExiting, 1) <> 0 then
    PlatformQuit(ACode);
  end;
  PlatformExit(ACode);
end;

const
  // The memory check's code (M3.11c): PaskalCPP's EXC_MEMORY, the code its get_mem /
  // resize_mem / set_length raise with
  ADAM_RUNTIME_EXC_MEMORY: int32 = 12;
  // int64's highest value: a block's byte count past it is no block any heap holds
  ADAM_RUNTIME_INT64_MAX: int64 = 9223372036854775807;

// Raised with code 12 and the text ABefore, AValue's digits, AAfter (below, with the other
// raises); it never returns
forward routine MemoryFail(const ABefore: ptr to const char; const AValue: int64;
  const AAfter: ptr to const char); noreturn;

@ifdef DEBUG
// Declared below: the mutex the tracker holds, ACount bytes zeroed
forward routine MutexEnter(const AMutex: ptr);
forward routine MutexLeave(const AMutex: ptr);
forward routine ZeroBytes(const AAddress: ptr; const ACount: int64);

// The leak tracker (M4.L1; debug builds only, BNF sec 9 DEBUG: a release build compiles
// none of it). Every live heap block's byte count, allocation site (GAllocSite as it is
// made) and the return addresses it was made under (M4.L2, the platform's
// PlatformCaptureFrames) sit in an open-addressed table keyed by the block's address,
// beside the blocks, never a header in them; the table's own memory comes straight from
// the platform (neither counted nor tracked) and one mutex guards it. At exit the heap
// report lists, under its [Heap] line, each site still holding blocks and its first such
// block's frames as file:line, from the exe's code-address line table (DoReportLeaks)
type
  // One slot: the block's address (nil: never used), its byte count (-1: the block was
  // freed; the address is kept so a later probe walks past it), its site id (0: the
  // runtime's own, made outside any compiled construct), its serial (the tracker's count
  // of blocks made when it was: the lower, the earlier) and up to 8 return addresses, the
  // innermost first (nil past the last)
  TrackSlot = record
    Block: ptr;
    Size: int64;
    Site: int32;
    Serial: int64;
    Frames: array[0..7] of ptr;
  end;

const
  // The table's first slot count; a power of two, doubled once used slots (live and freed)
  // would pass half of it
  ADAM_RUNTIME_TRACK_START: int64 = 4096;
  // A slot's frame count (TrackSlot.Frames' length)
  ADAM_RUNTIME_TRACK_FRAMES: int32 = 8;
  // The frames of the tracker's own a capture leaves out: DoTrackAdd / DoTrackResize, then
  // DoGetMem / DoResizeMem
  ADAM_RUNTIME_TRACK_SKIP: int32 = 2;
  // The line table's first 8 bytes (Adam.Backend.Generate's LineTableMaker) and a file
  // record's runtime flag (its frames are the runtime's own: a leak's frames skip them)
  ADAM_RUNTIME_LINES_MAGIC: string = "AdamLine";
  ADAM_RUNTIME_LINES_RUNTIME: int64 = 1;

var
  GTrackSlots: ptr to TrackSlot;
  GTrackCapacity: int64;
  GTrackUsed: int64;
  // The blocks made so far (each slot's serial)
  GTrackSerial: int64;
  // The blocks the tracker had no room for (its table could not grow): the report says so
  GTrackLost: int64;
  GTrackMutex: MutexWords;
  // The exe's site list (Lowering's __adam_sitelist, SU2.4), handed over by the entry
  // (HeapSiteList): a uint64 count, then the address of each unit's allocation site table
  // (__adam_allocsites_<unit>), in the program's module order; nil until then. Each table
  // (version 3, Lowering's DoSiteTable): 8 magic bytes, version, its site count, its
  // unit's code-address line table's address (__adam_lines_<unit>), the base word (its
  // first site's id less 1, written here), then 16-byte records and their text pool. Site
  // id I is record I - base of the table whose base < I <= base + count
  GSiteList: ptr to const uint8;
  // Every unit's sites (the last id)
  GSiteCount: int64;

const
  // A site table's header bytes, where its count, its line table's address and its base
  // word are, and a record's bytes (Lowering's DoSiteTable)
  ADAM_RUNTIME_SITES_HEADER: int64 = 32;
  ADAM_RUNTIME_SITES_COUNT: int64 = 12;
  ADAM_RUNTIME_SITES_LINES: int64 = 16;
  ADAM_RUNTIME_SITES_BASE: int64 = 24;
  ADAM_RUNTIME_SITES_RECORD: int64 = 16;

// Declared below: a table's little-endian 8-byte values
forward routine DoTableValue(const ATable: ptr to const uint8; const AAt: int64;
  const ACount: int64): uint64;

// The site table AIndex (0-based) of the site list
routine DoSiteTableAt(const AIndex: int64): ptr to uint8;
begin
  return ptr to uint8(DoTableValue(GSiteList, 8 + AIndex * 8, 8));
end;

// How many site tables the site list holds (0 before HeapSiteList)
routine DoSiteTables(): int64;
begin
  if GSiteList = nil then
    return 0;
  end;
  return int64(DoTableValue(GSiteList, 0, 8));
end;

// AValue's low 4 bytes written little-endian at AAt of ATable
routine DoPutTableWord(const ATable: ptr to uint8; const AAt: int64; const AValue: int64);
var
  LBits: uint64;
  LI: int64;
begin
  LBits := uint64(AValue);
  for LI := 0 to 3 do
    ATable[AAt + LI] := uint8(LBits & 255);
    LBits := LBits shr 8;
  end;
end;

// A debug build's entry hands over its exe's site list (M4.L1; the compiler calls it,
// Semantics' ADAM_SEMANTICS_RUNTIME_HEAP_SITES): each table's base word written as the
// tables are walked in order, so the ids run on from one unit to the next (the order
// Lowering numbered them in when the program was one module)
routine HeapSiteList(const AList: ptr);
var
  LTable: ptr to uint8;
  LCount: int64;
  LI: int64;
begin
  GSiteList := ptr to const uint8(AList);
  GSiteCount := 0;
  for LI := 0 to DoSiteTables() - 1 do
    LTable := DoSiteTableAt(LI);
    LCount := int64(DoTableValue(ptr to const uint8(LTable), ADAM_RUNTIME_SITES_COUNT, 4));
    DoPutTableWord(LTable, ADAM_RUNTIME_SITES_BASE, GSiteCount);
    GSiteCount := GSiteCount + LCount;
  end;
end;

// The slot at AFrom's fields copied into the slot at ATo
routine DoTrackCopy(const ATo: ptr to TrackSlot; const AFrom: ptr to TrackSlot);
var
  LI: int64;
begin
  ATo^.Block := AFrom^.Block;
  ATo^.Size := AFrom^.Size;
  ATo^.Site := AFrom^.Site;
  ATo^.Serial := AFrom^.Serial;
  for LI := 0 to 7 do
    ATo^.Frames[LI] := AFrom^.Frames[LI];
  end;
end;

// The home slot of ABlock in a table of ACapacity (a power of two) slots: the address
// without its always-zero low bits, its high bits folded in
routine DoTrackHome(const ABlock: ptr; const ACapacity: int64): int64;
var
  LKey: uint64;
begin
  LKey := uint64(ABlock) shr 4;
  LKey := LKey xor (LKey shr 17) xor (LKey shr 31);
  return int64(LKey & uint64(ACapacity - 1));
end;

// The live block ASource describes put into the table ASlots of ACapacity slots, in the
// first never-used or freed slot from its block's home; true when that slot was never used
// (one more used slot)
routine DoTrackPut(const ASlots: ptr to TrackSlot; const ACapacity: int64;
  const ASource: ptr to TrackSlot): bool;
var
  LAt: int64;
  LSlot: ptr to TrackSlot;
  LFresh: bool;
begin
  LAt := DoTrackHome(ASource^.Block, ACapacity);
  LSlot := addr of ASlots[LAt];
  while (LSlot^.Block <> nil) and (LSlot^.Size >= 0) do
    LAt := (LAt + 1) & (ACapacity - 1);
    LSlot := addr of ASlots[LAt];
  end;
  LFresh := LSlot^.Block = nil;
  DoTrackCopy(LSlot, ASource);
  return LFresh;
end;

// The table made twice as large (ADAM_RUNTIME_TRACK_START the first time), its live slots
// moved in and its freed ones dropped; false when the platform has no room (the table as it
// was). The caller holds the mutex
routine DoTrackGrow(): bool;
var
  LCapacity: int64;
  LSlots: ptr to TrackSlot;
  LOld: ptr to TrackSlot;
  LUsed: int64;
  LI: int64;
begin
  LCapacity := GTrackCapacity * 2;
  if LCapacity = 0 then
    LCapacity := ADAM_RUNTIME_TRACK_START;
  end;
  LSlots := ptr to TrackSlot(PlatformAlloc(LCapacity * size(TrackSlot)));
  if LSlots = nil then
    return false;
  end;
  ZeroBytes(ptr(LSlots), LCapacity * size(TrackSlot));
  LUsed := 0;
  for LI := 0 to GTrackCapacity - 1 do
    LOld := addr of GTrackSlots[LI];
    if (LOld^.Block <> nil) and (LOld^.Size >= 0) then
      DoTrackPut(LSlots, LCapacity, LOld);
      LUsed := LUsed + 1;
    end;
  end;
  if GTrackSlots <> nil then
    PlatformFree(ptr(GTrackSlots));
  end;
  GTrackSlots := LSlots;
  GTrackCapacity := LCapacity;
  GTrackUsed := LUsed;
  return true;
end;

// The block ASource describes recorded live; the table grown first when it would pass
// half full, and when it cannot grow and holds one free slot or less the block is counted
// lost instead (a probe always meets a never-used slot). The caller holds the mutex
routine DoTrackInsert(const ASource: ptr to TrackSlot);
begin
  if (GTrackUsed + 1) * 2 > GTrackCapacity then
    if not DoTrackGrow() then
      if GTrackUsed + 2 > GTrackCapacity then
        GTrackLost := GTrackLost + 1;
        return;
      end;
    end;
  end;
  if DoTrackPut(GTrackSlots, GTrackCapacity, ASource) then
    GTrackUsed := GTrackUsed + 1;
  end;
end;

// The live slot of ABlock; nil when the table holds none (a block it had no room for). The
// caller holds the mutex
routine DoTrackFind(const ABlock: ptr): ptr to TrackSlot;
var
  LAt: int64;
  LSlot: ptr to TrackSlot;
begin
  if GTrackCapacity = 0 then
    return nil;
  end;
  LAt := DoTrackHome(ABlock, GTrackCapacity);
  LSlot := addr of GTrackSlots[LAt];
  while LSlot^.Block <> nil do
    if (LSlot^.Block = ABlock) and (LSlot^.Size >= 0) then
      return LSlot;
    end;
    LAt := (LAt + 1) & (GTrackCapacity - 1);
    LSlot := addr of GTrackSlots[LAt];
  end;
  return nil;
end;

// A block DoGetMem made: ABlock, ASize bytes, at this thread's allocation site, under the
// frames it was asked from (captured before the mutex is taken; only at a compiled site:
// the report prints no frames under the runtime's own, site 0), the next serial
routine DoTrackAdd(const ABlock: ptr; const ASize: int64);
var
  LNew: TrackSlot;
begin
  ZeroBytes(ptr(addr of LNew), size(TrackSlot));
  LNew.Block := ABlock;
  LNew.Size := ASize;
  LNew.Site := GAllocSite;
  if LNew.Site <> 0 then
    PlatformCaptureFrames(ADAM_RUNTIME_TRACK_SKIP, ADAM_RUNTIME_TRACK_FRAMES,
      ptr(addr of LNew.Frames[0]));
  end;
  MutexEnter(ptr(addr of GTrackMutex));
  GTrackSerial := GTrackSerial + 1;
  LNew.Serial := GTrackSerial;
  DoTrackInsert(addr of LNew);
  MutexLeave(ptr(addr of GTrackMutex));
end;

// The block at ABlock freed: its slot marked freed
routine DoTrackRemove(const ABlock: ptr);
var
  LSlot: ptr to TrackSlot;
begin
  MutexEnter(ptr(addr of GTrackMutex));
  LSlot := DoTrackFind(ABlock);
  if LSlot <> nil then
    LSlot^.Size := -1;
  end;
  MutexLeave(ptr(addr of GTrackMutex));
end;

// The block at AOld resized to ASize bytes, now at ANew (maybe AOld): its byte count
// updated; its site and frames AGrower's when AGrower has a site (the construct that grew
// it, this thread's allocation site and frames), else the ones it had; its serial kept (a
// block the table had no room for takes the next). The caller holds the mutex across the
// platform's resize too: a moved block's old address is free once the resize returns, and
// another thread given it must not record it before its old slot is marked freed here
routine DoTrackMove(const AOld: ptr; const ANew: ptr; const ASize: int64;
  const AGrower: ptr to TrackSlot);
var
  LSlot: ptr to TrackSlot;
  LNew: TrackSlot;
  LI: int64;
begin
  LSlot := DoTrackFind(AOld);
  if LSlot <> nil then
    DoTrackCopy(addr of LNew, LSlot);
  else
    ZeroBytes(ptr(addr of LNew), size(TrackSlot));
    GTrackSerial := GTrackSerial + 1;
    LNew.Serial := GTrackSerial;
  end;
  if AGrower^.Site <> 0 then
    LNew.Site := AGrower^.Site;
    for LI := 0 to 7 do
      LNew.Frames[LI] := AGrower^.Frames[LI];
    end;
  end;
  LNew.Block := ANew;
  LNew.Size := ASize;
  if (LSlot <> nil) and (AOld = ANew) then
    DoTrackCopy(LSlot, addr of LNew);
  else
    if LSlot <> nil then
      LSlot^.Size := -1;
    end;
    DoTrackInsert(addr of LNew);
  end;
end;

// DoResizeMem's debug form: the block at APointer resized by the platform to ASize bytes
// with the mutex held across it (DoTrackMove), the growing construct's site and frames
// (when it set a site) captured before; the new address, nil when the heap cannot
routine DoTrackResize(const APointer: ptr; const ASize: int64): ptr;
var
  LGrower: TrackSlot;
  LBlock: ptr;
begin
  ZeroBytes(ptr(addr of LGrower), size(TrackSlot));
  LGrower.Site := GAllocSite;
  if LGrower.Site <> 0 then
    PlatformCaptureFrames(ADAM_RUNTIME_TRACK_SKIP, ADAM_RUNTIME_TRACK_FRAMES,
      ptr(addr of LGrower.Frames[0]));
  end;
  MutexEnter(ptr(addr of GTrackMutex));
  LBlock := PlatformResize(APointer, ASize);
  if LBlock <> nil then
    DoTrackMove(APointer, LBlock, ASize, addr of LGrower);
  end;
  MutexLeave(ptr(addr of GTrackMutex));
  return LBlock;
end;

// The little-endian unsigned value of ACount (4 or 8) bytes at AAt in the table ATable
routine DoTableValue(const ATable: ptr to const uint8; const AAt: int64;
  const ACount: int64): uint64;
var
  LValue: uint64;
  LI: int64;
begin
  LValue := 0u;
  for LI := ACount - 1 downto 0 do
    LValue := (LValue shl 8) | uint64(ATable[AAt + LI]);
  end;
  return LValue;
end;

// The little-endian uint32 at AAt in the table ATable (a site table or a line table)
routine DoTableWord(const ATable: ptr to const uint8; const AAt: int64): int64;
begin
  return int64(DoTableValue(ATable, AAt, 4));
end;

// The site table holding the site id ASite (see GSiteList), its record's byte offset in it
// (ARecord) and its text pool's (APool); nil for site 0 or an id no table holds
routine DoSiteRecord(const ASite: int64; var ARecord: int64; var APool: int64): ptr to const uint8;
var
  LTable: ptr to const uint8;
  LBase: int64;
  LCount: int64;
  LI: int64;
begin
  for LI := 0 to DoSiteTables() - 1 do
    LTable := ptr to const uint8(DoSiteTableAt(LI));
    LBase := DoTableWord(LTable, ADAM_RUNTIME_SITES_BASE);
    LCount := DoTableWord(LTable, ADAM_RUNTIME_SITES_COUNT);
    if (ASite > LBase) and (ASite <= LBase + LCount) then
      ARecord := ADAM_RUNTIME_SITES_HEADER + (ASite - LBase - 1) * ADAM_RUNTIME_SITES_RECORD;
      APool := ADAM_RUNTIME_SITES_HEADER + LCount * ADAM_RUNTIME_SITES_RECORD;
      return LTable;
    end;
  end;
  return nil;
end;

// The line table of the site table ATable: nil when it holds none or the table at its
// address does not start with ADAM_RUNTIME_LINES_MAGIC
routine DoLinesOf(const ATable: ptr to const uint8): ptr to const uint8;
var
  LLines: ptr to const uint8;
  LI: int64;
begin
  LLines := ptr to const uint8(DoTableValue(ATable, ADAM_RUNTIME_SITES_LINES, 8));
  if LLines = nil then
    return nil;
  end;
  for LI := 0 to len(ADAM_RUNTIME_LINES_MAGIC) - 1 do
    if LLines[LI] <> uint8(ADAM_RUNTIME_LINES_MAGIC[LI]) then
      return nil;
    end;
  end;
  return LLines;
end;

// The row of the line table ALines' function record AFunction (at its byte offset)
// holding the code AOffset bytes from its start: the last of its rows starting at or
// before it; -1 when none does
routine DoLineRow(const ALines: ptr to const uint8; const AFunction: int64;
  const AOffset: int64): int64;
var
  LRows: int64;
  LFirst: int64;
  LCount: int64;
  LRow: int64;
  LI: int64;
begin
  // header 24 bytes, functions 24 each, files 8 each, then the rows, 16 each
  // (LineTableMaker)
  LRows := 24 + DoTableWord(ALines, 12) * 24 + DoTableWord(ALines, 16) * 8;
  LFirst := DoTableWord(ALines, AFunction + 12);
  LCount := DoTableWord(ALines, AFunction + 16);
  LRow := -1;
  LI := 0;
  while (LI < LCount) and (DoTableWord(ALines, LRows + (LFirst + LI) * 16) <= AOffset) do
    LRow := LRows + (LFirst + LI) * 16;
    LI := LI + 1;
  end;
  return LRow;
end;

// The place of the frame AFrame (a return address) in the line table ALines (see
// DoFramePlace); AFound true when one of its functions holds the frame
routine DoFrameIn(const ALines: ptr to const uint8; const AFrame: uint64; var AFound: bool;
  var AFile: ptr to const char; var ALine: int64; var AColumn: int64): bool;
var
  LFiles: int64;
  LPool: int64;
  LFunction: int64;
  LStart: uint64;
  LRow: int64;
  LFile: int64;
  LI: int64;
begin
  AFound := false;
  LFiles := 24 + DoTableWord(ALines, 12) * 24;
  LPool := LFiles + DoTableWord(ALines, 16) * 8 + DoTableWord(ALines, 20) * 16;
  for LI := 0 to DoTableWord(ALines, 12) - 1 do
    LFunction := 24 + LI * 24;
    LStart := DoTableValue(ALines, LFunction, 8);
    if (AFrame > LStart) and (AFrame - LStart <= uint64(DoTableWord(ALines, LFunction + 8))) then
      AFound := true;
      LRow := DoLineRow(ALines, LFunction, int64(AFrame - LStart) - 1);
      if LRow < 0 then
        return false;
      end;
      LFile := LFiles + DoTableWord(ALines, LRow + 12) * 8;
      if (DoTableWord(ALines, LRow + 4) = 0) or
        ((DoTableWord(ALines, LFile + 4) & ADAM_RUNTIME_LINES_RUNTIME) <> 0) then
        return false;
      end;
      AFile := ptr to const char(addr of ALines[LPool + DoTableWord(ALines, LFile)]);
      ALine := DoTableWord(ALines, LRow + 4);
      AColumn := DoTableWord(ALines, LRow + 8);
      return true;
    end;
  end;
  return false;
end;

// The place of the frame AFrame (a return address): the call it returns to (the byte
// before it), its file's name (AFile), line (ALine) and column (AColumn), from the line
// table of the unit whose code holds it; false for an address no unit's line table holds
// (the C runtime's, the OS's, the program's entry), a row of line 0, or a file of the
// runtime's own
routine DoFramePlace(const AFrame: uint64; var AFile: ptr to const char; var ALine: int64;
  var AColumn: int64): bool;
var
  LLines: ptr to const uint8;
  LFound: bool;
  LPlaced: bool;
  LI: int64;
begin
  for LI := 0 to DoSiteTables() - 1 do
    LLines := DoLinesOf(ptr to const uint8(DoSiteTableAt(LI)));
    if LLines <> nil then
      LPlaced := DoFrameIn(LLines, AFrame, LFound, AFile, ALine, AColumn);
      if LFound then
        return LPlaced;
      end;
    end;
  end;
  return false;
end;

// True when the NUL-ended texts AFirst and ASecond are the same
routine DoSameCText(const AFirst: ptr to const char; const ASecond: ptr to const char): bool;
var
  LI: int64;
begin
  LI := 0;
  while AFirst[LI] = ASecond[LI] do
    if AFirst[LI] = '\0' then
      return true;
    end;
    LI := LI + 1;
  end;
  return false;
end;

// The NUL-ended text at the byte offset AOffset of the site table ATable's pool (APool)
routine DoSiteText(const ATable: ptr to const uint8; const APool: int64;
  const AOffset: int64): ptr to const char;
begin
  return ptr to const char(addr of ATable[APool + AOffset]);
end;

// One leak line: the site's place and what it allocates (site id ASite), else `runtime`
// for site 0 or one no site table holds; ALeaks blocks, ABytes bytes
routine DoLeakLine(const ASite: int64; const ALeaks: int64; const ABytes: int64);
var
  LTable: ptr to const uint8;
  LRecord: int64;
  LPool: int64;
  LNoun: ptr to const char;
begin
  LNoun := ptr to const char("leaks");
  if ALeaks = 1 then
    LNoun := ptr to const char("leak");
  end;
  LTable := DoSiteRecord(ASite, LRecord, LPool);
  if LTable = nil then
    println("runtime: {} {}, {} bytes", ALeaks, LNoun, ABytes);
    return;
  end;
  // a record: line, column, file's text, what's text (Lowering's DoSiteTable)
  println("{}({},{}): {} {}, {} bytes, {}",
    DoSiteText(LTable, LPool, DoTableWord(LTable, LRecord + 8)),
    DoTableWord(LTable, LRecord), DoTableWord(LTable, LRecord + 4), ALeaks, LNoun, ABytes,
    DoSiteText(LTable, LPool, DoTableWord(LTable, LRecord + 12)));
end;

const
  // The words of one site's tally (DoReportLeaks): its block count, its bytes, the serial
  // of its earliest block and that block's 8 frames
  ADAM_RUNTIME_TALLY_WORDS: int64 = 11;

// The live slot ASlot counted into its site's tally at ATally (ADAM_RUNTIME_TALLY_WORDS
// words): one more block, its bytes, and its serial and frames when it is the site's
// earliest so far
routine DoTallySlot(const ATally: ptr to int64; const ASlot: ptr to TrackSlot);
var
  LI: int64;
begin
  if (ATally[0] = 0) or (ASlot^.Serial < ATally[2]) then
    ATally[2] := ASlot^.Serial;
    for LI := 0 to 7 do
      ATally[3 + LI] := int64(uint64(ASlot^.Frames[LI]));
    end;
  end;
  ATally[0] := ATally[0] + 1;
  ATally[1] := ATally[1] + ASlot^.Size;
end;

// Under the leak line of site ASite: its earliest block's
// frames (ATally's, DoTallySlot), innermost first, each `  file(line,col)` (DoFramePlace;
// a frame it has no place for left out); the first one shown left out too when it is the
// site's own line (the leak line says it), so the frames are its callers; nothing without
// the line table
routine DoLeakFrames(const ATally: ptr to int64; const ASite: int64);
var
  LTable: ptr to const uint8;
  LRecord: int64;
  LPool: int64;
  LSiteFile: ptr to const char;
  LSiteLine: int64;
  LFile: ptr to const char;
  LLine: int64;
  LColumn: int64;
  LShown: int64;
  LI: int64;
begin
  LTable := DoSiteRecord(ASite, LRecord, LPool);
  if (LTable = nil) or (DoLinesOf(LTable) = nil) then
    return;
  end;
  LSiteFile := DoSiteText(LTable, LPool, DoTableWord(LTable, LRecord + 8));
  LSiteLine := DoTableWord(LTable, LRecord);
  LShown := 0;
  LI := 0;
  while (LI < 8) and (ATally[3 + LI] <> 0) do
    if DoFramePlace(uint64(ATally[3 + LI]), LFile, LLine, LColumn) then
      if (LShown > 0) or (LLine <> LSiteLine) or not DoSameCText(LFile, LSiteFile) then
        println("  {}({},{})", LFile, LLine, LColumn);
      end;
      LShown := LShown + 1;
    end;
    LI := LI + 1;
  end;
end;

// Under the [Heap] line: each site still holding blocks, in site id order (0, the
// runtime's own, first), with its block count and bytes, a compiled site's earliest block's
// frames under it (DoLeakFrames); then the blocks the tracker had no room for, if any. The
// tally is taken under the mutex, printed after it
routine DoReportLeaks();
var
  LCount: int64;
  LTally: ptr to int64;
  LSlot: ptr to TrackSlot;
  LSite: int64;
  LI: int64;
begin
  LCount := GSiteCount;
  // ADAM_RUNTIME_TALLY_WORDS words per site id 0 .. LCount
  LTally := ptr to int64(PlatformAlloc((LCount + 1) * ADAM_RUNTIME_TALLY_WORDS * 8));
  if LTally = nil then
    return;
  end;
  ZeroBytes(ptr(LTally), (LCount + 1) * ADAM_RUNTIME_TALLY_WORDS * 8);
  MutexEnter(ptr(addr of GTrackMutex));
  for LI := 0 to GTrackCapacity - 1 do
    LSlot := addr of GTrackSlots[LI];
    if (LSlot^.Block <> nil) and (LSlot^.Size >= 0) then
      LSite := int64(LSlot^.Site);
      if (LSite < 0) or (LSite > LCount) then
        LSite := 0;
      end;
      DoTallySlot(addr of LTally[LSite * ADAM_RUNTIME_TALLY_WORDS], LSlot);
    end;
  end;
  MutexLeave(ptr(addr of GTrackMutex));
  for LI := 0 to LCount do
    LSite := LI * ADAM_RUNTIME_TALLY_WORDS;
    if LTally[LSite] > 0 then
      DoLeakLine(LI, LTally[LSite], LTally[LSite + 1]);
      if LI > 0 then
        DoLeakFrames(addr of LTally[LSite], LI);
      end;
    end;
  end;
  if GTrackLost > 0 then
    println("untracked: {} blocks (the leak tracker had no room)", GTrackLost);
  end;
  PlatformFree(ptr(LTally));
end;
@endif

// ASize (above 0) bytes from the heap, uninitialized (counted and tracked in a debug
// build); nil when the heap cannot give them (nothing counted). The one allocation every
// block goes through: GetMem raises on its nil, setlength's shapes raise their own text on
// it
routine DoGetMem(const ASize: int64): ptr;
var
  LBlock: ptr;
begin
  LBlock := PlatformAlloc(ASize);
@ifdef DEBUG
  if LBlock <> nil then
    atomicadd(GAllocs, 1u);
    DoTrackAdd(LBlock, ASize);
  end;
@endif
  return LBlock;
end;

// The block at APointer (not nil) resized to ASize (above 0) bytes, maybe moved (the new
// address; tracked in a debug build); nil when the heap cannot (the block as it was). The
// one resize every block goes through
routine DoResizeMem(const APointer: ptr; const ASize: int64): ptr;
var
  LBlock: ptr;
begin
@ifdef DEBUG
  LBlock := DoTrackResize(APointer, ASize);
@else
  LBlock := PlatformResize(APointer, ASize);
@endif
  return LBlock;
end;

// The block at APointer (not nil) back to the heap (counted and its slot freed in a debug
// build). The one free every block goes through
routine DoFreeMem(const APointer: ptr);
begin
@ifdef DEBUG
  DoTrackRemove(APointer);
@endif
  PlatformFree(APointer);
@ifdef DEBUG
  atomicadd(GFrees, 1u);
@endif
end;

// getmem(N): N bytes from the heap, uninitialized, counted; 0 bytes is nil, uncounted. A
// negative N raises code 12 `negative memory size N`, a heap that cannot give N bytes `out
// of memory (N bytes)` (PaskalCPP's get_mem)
routine GetMem(const ASize: int64): ptr;
var
  LBlock: ptr;
begin
  if ASize = 0 then
    return nil;
  end;
  if ASize < 0 then
    MemoryFail(ptr to const char("negative memory size "), ASize, ptr to const char(""));
  end;
  LBlock := DoGetMem(ASize);
  if LBlock = nil then
    MemoryFail(ptr to const char("out of memory ("), ASize, ptr to const char(" bytes)"));
  end;
  return LBlock;
end;

// resizemem(P, N): the block at P grown or shrunk to N bytes, its contents kept up to the
// smaller size, maybe moved (the new address); nil P allocates (counted), N of 0 frees P
// (counted) and is nil. A negative N raises code 12 `negative memory size N`, a heap that
// cannot give N bytes `out of memory (N bytes)` with the block at P as it was (PaskalCPP's
// resize_mem)
routine ResizeMem(const APointer: ptr; const ASize: int64): ptr;
var
  LBlock: ptr;
begin
  if ASize < 0 then
    MemoryFail(ptr to const char("negative memory size "), ASize, ptr to const char(""));
  end;
  if APointer = nil then
    return GetMem(ASize);
  end;
  if ASize = 0 then
    DoFreeMem(APointer);
    return nil;
  end;
  LBlock := DoResizeMem(APointer, ASize);
  if LBlock = nil then
    MemoryFail(ptr to const char("out of memory ("), ASize, ptr to const char(" bytes)"));
  end;
  return LBlock;
end;

// The bytes a block of ALength (above 0) items of AItem bytes takes, its 16-byte header and
// AExtra items more (a text's 0 unit) included; -1 when that passes int64's range (no heap
// holds it: setlength's `out of memory (length N)`)
routine DoBlockBytes(const ALength: int64; const AItem: int64; const AExtra: int64): int64;
begin
  if AItem <= 0 then
    return 16;
  end;
  if ALength > (ADAM_RUNTIME_INT64_MAX - 16) div AItem - AExtra then
    return -1;
  end;
  return 16 + (ALength + AExtra) * AItem;
end;

// The bytes setlength resizes the slot's own block to, from the block's usable bytes
// ACapacity (PlatformBlockSize) and the ABytes (DoBlockBytes) its new length takes: 0 when
// the block stays as it is (it holds ABytes and is not under half used). A growth asks for
// half again the capacity (ABytes when that is more), so a loop growing by one is amortized
// O(1) per step (std::vector's geometric growth); a shrink under half the capacity asks for
// ABytes, so a grow / shrink pair at one length never resizes every time
routine DoSetLengthBytes(const ACapacity: int64; const ABytes: int64): int64;
var
  LGrown: int64;
begin
  if ABytes <= ACapacity then
    if ABytes > ACapacity div 2 then
      return 0;
    end;
    return ABytes;
  end;
  // half again, past int64's range only for a block no heap holds: then ABytes
  if ACapacity div 2 > ADAM_RUNTIME_INT64_MAX - ACapacity then
    return ABytes;
  end;
  LGrown := ACapacity + ACapacity div 2;
  if LGrown < ABytes then
    LGrown := ABytes;
  end;
  return LGrown;
end;

// The slot's own block at ABlock (count 1, not nil) made to hold ABytes (DoBlockBytes) by
// DoSetLengthBytes' rule: the block itself when it already does, else resized (maybe
// moved); a growth the heap refuses at the geometric size is asked once more for ABytes
// exactly; nil when the heap cannot give ABytes (the block as it was)
routine DoSetLengthBlock(const ABlock: ptr; const ABytes: int64): ptr;
var
  LAsk: int64;
  LResized: ptr;
begin
  LAsk := DoSetLengthBytes(PlatformBlockSize(ABlock), ABytes);
  if LAsk = 0 then
    return ABlock;
  end;
  LResized := DoResizeMem(ABlock, LAsk);
  if (LResized = nil) and (LAsk > ABytes) then
    LResized := DoResizeMem(ABlock, ABytes);
  end;
  return LResized;
end;

// setlength's failure for the length ALength (PaskalCPP's raise_length): code 12, `negative
// length N` for a negative one, else `out of memory (length N)` (the heap cannot hold it);
// it never returns
routine LengthFail(const ALength: int64); noreturn;
begin
  if ALength < 0 then
    MemoryFail(ptr to const char("negative length "), ALength, ptr to const char(""));
  end;
  MemoryFail(ptr to const char("out of memory (length "), ALength, ptr to const char(")"));
end;

// freemem(P): the block at P back to the heap, counted; nil does nothing
routine FreeMem(const APointer: ptr);
begin
  if APointer = nil then
    return;
  end;
  DoFreeMem(APointer);
end;

const
  // The first block ReadFileBytes reads into; it doubles as the file needs
  ADAM_RUNTIME_READ_START: int64 = 65536;

// Reads the open file AHandle (PlatformOpenFile's) to its end into the heap block ABlock
// (ASize bytes, doubled as needed), ACount the bytes read, a 0 written after them. False
// when a read fails or there is no room (ABlock is then still the caller's to free)
routine DoReadOpenFile(const AHandle: uint64; var ABlock: ptr; var ASize: int64;
  var ACount: int64): bool;
var
  LGrown: ptr;
  LBytes: ptr to uint8;
  LGot: int64;
  LDone: bool;
  LOk: bool;
begin
  LDone := false;
  LOk := false;
  while not LDone do
    // One byte is always kept free for the 0 after the bytes
    if ACount + 1 >= ASize then
      // the heap's resize without ResizeMem's raise: no room is this routine's false, the
      // block as it was (the caller closes the file and frees it)
      LGrown := DoResizeMem(ABlock, ASize * 2);
      if LGrown = nil then
        return false;
      end;
      ABlock := LGrown;
      ASize := ASize * 2;
    end;
    LBytes := ptr to uint8(ABlock);
    LGot := PlatformReadFile(AHandle, ptr(addr of LBytes[ACount]), ASize - 1 - ACount);
    if LGot < 0 then
      LDone := true;
    else
      if LGot = 0 then
        LBytes[ACount] := 0;
        LOk := true;
        LDone := true;
      else
        ACount := ACount + LGot;
      end;
    end;
  end;
  return LOk;
end;

// The bytes of the file at the NUL-terminated UTF-8 path APath (relative to the working
// folder), read whole into a block from the heap (getmem's, counted: the caller frees it
// with freemem), ACount of them, then a 0 (so they read as a NUL-terminated text too). Nil
// (ACount 0) when the file cannot be opened or read, or there is no room; an empty file is
// a block holding the 0 alone
public routine ReadFileBytes(const APath: ptr to const char; var ACount: int64): ptr;
var
  LHandle: uint64;
  LBlock: ptr;
  LSize: int64;
  LRead: bool;
begin
  ACount := 0;
  if not PlatformOpenFile(APath, LHandle) then
    return nil;
  end;
  LSize := ADAM_RUNTIME_READ_START;
  // DoGetMem, not GetMem: no room is this routine's nil, never a raise past the open file
  LBlock := DoGetMem(LSize);
  LRead := false;
  if LBlock <> nil then
    LRead := DoReadOpenFile(LHandle, LBlock, LSize, ACount);
  end;
  PlatformCloseFile(LHandle);
  if not LRead then
    FreeMem(LBlock);
    ACount := 0;
    return nil;
  end;
  return LBlock;
end;

// The C runtime's definition of the C name AName (NUL-terminated): the one a program's
// routine of that name stands in for (the platform unit's PlatformFindCRuntime); nil when
// the C runtime has none
public routine FindCRuntimeFunction(const AName: ptr to const char): ptr;
begin
  return PlatformFindCRuntime(AName);
end;

// The function AName (NUL-terminated) of the library ALibrary (its NUL-terminated UTF-8
// file name) when the process has that library loaded (it is never loaded here); nil when
// it is not loaded or has no function of that name (the platform unit's PlatformFindLoaded)
public routine FindLoadedFunction(const ALibrary: ptr to const char;
  const AName: ptr to const char): ptr;
begin
  return PlatformFindLoaded(ALibrary, AName);
end;

// The file at the NUL-terminated UTF-8 path APath (relative to the working folder) opened in
// the mode AMode (ADAM_FILE_READ: it must exist, read only; ADAM_FILE_WRITE: created or
// emptied; ADAM_FILE_READ_WRITE: it must exist, kept; ADAM_FILE_APPEND: created when missing,
// kept), at place 0; AHandle is its handle for the *FileHandle routines. The handle writes
// straight through (nothing buffered); an open file is never renamed or removed under it.
// False (AHandle 0) when it cannot be opened so (missing, a folder, no access)
public routine OpenFileHandle(const APath: ptr to const char; const AMode: int32;
  var AHandle: uint64): bool;
begin
  return PlatformOpenFileMode(APath, AMode, AHandle);
end;

// Up to ACount bytes (above 0) of the file AHandle read into ABuffer at its place: the bytes
// read (fewer than asked is no end yet: read again), 0 at its end, -1 when the read fails
public routine ReadFileHandle(const AHandle: uint64; const ABuffer: ptr; const ACount: int64): int64;
begin
  return PlatformReadFile(AHandle, ABuffer, ACount);
end;

// Up to ACount bytes (above 0) of ABuffer written to the file AHandle at its place (past its
// end: the gap reads as zeros): the bytes written (fewer than asked: write the rest again),
// -1 when the write fails
public routine WriteFileHandle(const AHandle: uint64; const ABuffer: ptr; const ACount: int64): int64;
begin
  return PlatformWriteFile(AHandle, ABuffer, ACount);
end;

// The place of the file AHandle moved to AOffset from AOrigin (ADAM_SEEK_START / CURRENT /
// END): the new place; -1 (the place kept) when it would lie before the start. Past the end
// is a place
public routine SeekFileHandle(const AHandle: uint64; const AOffset: int64; const AOrigin: int32): int64;
begin
  return PlatformSeekFile(AHandle, AOffset, AOrigin);
end;

// The size in bytes of the file AHandle, -1 when it cannot be read
public routine FileHandleSize(const AHandle: uint64): int64;
begin
  return PlatformFileSize(AHandle);
end;

// The size of the file AHandle (open for writing) set to ASize bytes: shorter drops the
// tail, longer reads as zeros; its place is kept. False when it cannot be set
public routine TruncateFileHandle(const AHandle: uint64; const ASize: int64): bool;
begin
  return PlatformTruncateFile(AHandle, ASize);
end;

// Closes the file AHandle (OpenFileHandle's)
public routine CloseFileHandle(const AHandle: uint64);
begin
  PlatformCloseFile(AHandle);
end;

// What is at the NUL-terminated UTF-8 path APath (relative to the working folder), a link
// followed to its target (as C's stat): ADAM_PATH_FILE (ASize its size in bytes),
// ADAM_PATH_FOLDER, or ADAM_PATH_NONE (nothing there, a link whose target is gone, or a path
// that cannot be read); ASize is 0 but for a file
public routine PathKind(const APath: ptr to const char; var ASize: int64): int32;
begin
  return PlatformPathKind(APath, ASize);
end;

// True when the NUL-terminated UTF-8 path APath (relative to the working folder) is itself a
// link to elsewhere (a symbolic link; on Windows a junction too), read without following
// it; PathKind gives a link to a folder as ADAM_PATH_FOLDER, so a walk that must not loop
// asks this too and skips a folder that is a link. False for anything else, nothing there,
// or a path that cannot be read
public routine PathIsLink(const APath: ptr to const char): bool;
begin
  return PlatformPathIsLink(APath);
end;

// Deletes the file at the NUL-terminated UTF-8 path APath (relative to the working folder);
// false when it is not deleted (missing, a folder, read only, or a file the OS keeps while
// it is open)
public routine RemoveFile(const APath: ptr to const char): bool;
begin
  return PlatformRemoveFile(APath);
end;

// The names in the folder at the NUL-terminated UTF-8 path APath (relative to the working
// folder; "." and ".." left out), UTF-8, each followed by a NUL, in a block from the heap
// (getmem's, counted: the caller frees it with freemem), ACount bytes (their NULs counted; 0
// for an empty folder), then one more NUL. In the system's order: sort them for an order
// that holds everywhere. Nil (ACount 0) when APath is no folder that can be listed
// (missing, a file, no access) or there is no room
public routine ListFolder(const APath: ptr to const char; var ACount: int64): ptr;
var
  LNeed: int64;
  LBlock: ptr;
  LBytes: ptr to uint8;
  LGot: int64;
begin
  ACount := 0;
  LNeed := PlatformListFolder(APath, nil, 0);
  while LNeed >= 0 do
    // The names' bytes and the closing NUL
    LBlock := DoGetMem(LNeed + 1);
    if LBlock = nil then
      return nil;
    end;
    LGot := PlatformListFolder(APath, ptr to char(LBlock), LNeed);
    if (LGot >= 0) and (LGot <= LNeed) then
      LBytes := ptr to uint8(LBlock);
      LBytes[LGot] := 0;
      ACount := LGot;
      return LBlock;
    end;
    // The folder changed between the two listings: again with the room it takes now (-1,
    // gone or no longer listable, ends the loop)
    FreeMem(LBlock);
    LNeed := LGot;
  end;
  return nil;
end;

// The last write time of the file or folder at the NUL-terminated UTF-8 path APath
// (relative to the working folder) as the local time of that date (the time zone's
// daylight rule for its year, as C's localtime): AYear, AMonth 1..12, ADay 1..31, AHour
// 0..23, AMinute and ASecond 0..59. False (every field 0) when it cannot be read
public routine FileLocalTime(const APath: ptr to const char; var AYear: int32;
  var AMonth: int32; var ADay: int32; var AHour: int32; var AMinute: int32;
  var ASecond: int32): bool;
begin
  return PlatformFileLocalTime(APath, AYear, AMonth, ADay, AHour, AMinute, ASecond);
end;

// The path of the program's exe, UTF-8, in a block from the heap (getmem's, counted: the
// caller frees it with freemem), ACount bytes then a NUL. Nil (ACount 0) when it cannot be
// read or there is no room
public routine ProgramPath(var ACount: int64): ptr;
var
  LNeed: int64;
  LBlock: ptr;
begin
  ACount := 0;
  LNeed := PlatformExePath(nil, 0);
  if LNeed <= 0 then
    return nil;
  end;
  LBlock := DoGetMem(LNeed + 1);
  if LBlock = nil then
    return nil;
  end;
  if PlatformExePath(ptr to char(LBlock), LNeed + 1) <> LNeed then
    FreeMem(LBlock);
    return nil;
  end;
  ACount := LNeed;
  return LBlock;
end;

// The NUL-terminated UTF-8 path APath made full: a relative path joined to the working
// folder, "." and ".." folded as text (the disk is never touched), in the system's own
// spelling (its separator; a path that names nothing is made full too). UTF-8, in a block
// from the heap (getmem's, counted: the caller frees it with freemem), ACount bytes then a
// NUL. Nil (ACount 0) when it cannot be made (a path that is not valid UTF-8) or there is
// no room
public routine FullPath(const APath: ptr to const char; var ACount: int64): ptr;
var
  LNeed: int64;
  LBlock: ptr;
begin
  ACount := 0;
  LNeed := PlatformFullPath(APath, nil, 0);
  if LNeed <= 0 then
    return nil;
  end;
  LBlock := DoGetMem(LNeed + 1);
  if LBlock = nil then
    return nil;
  end;
  // The working folder can change between the two calls: a different size is a failure
  if PlatformFullPath(APath, ptr to char(LBlock), LNeed + 1) <> LNeed then
    FreeMem(LBlock);
    return nil;
  end;
  ACount := LNeed;
  return LBlock;
end;

public const
  // The modes OpenFileHandle opens a file in (C's "rb", "wb", "r+b", "ab"), and the origins
  // SeekFileHandle counts from (C's SEEK_SET, SEEK_CUR, SEEK_END)
  ADAM_FILE_READ: int32 = ADAM_PLATFORM_MODE_READ;
  ADAM_FILE_WRITE: int32 = ADAM_PLATFORM_MODE_WRITE;
  ADAM_FILE_READ_WRITE: int32 = ADAM_PLATFORM_MODE_READ_WRITE;
  ADAM_FILE_APPEND: int32 = ADAM_PLATFORM_MODE_APPEND;
  ADAM_SEEK_START: int32 = ADAM_PLATFORM_SEEK_START;
  ADAM_SEEK_CURRENT: int32 = ADAM_PLATFORM_SEEK_CURRENT;
  ADAM_SEEK_END: int32 = ADAM_PLATFORM_SEEK_END;
  // What PathKind finds at a path: nothing, a file, a folder
  ADAM_PATH_NONE: int32 = ADAM_PLATFORM_PATH_NONE;
  ADAM_PATH_FILE: int32 = ADAM_PLATFORM_PATH_FILE;
  ADAM_PATH_FOLDER: int32 = ADAM_PLATFORM_PATH_FOLDER;
  // C's errno values (the target's C runtime's, its platform unit's) that InstallHook /
  // UninstallHook report: no module defines the name, out of memory, a slot not writable,
  // the name already hooked, a name or argument refused; System.HookIO's stream that
  // failed (EIO), a hook whose real function the C runtime lacks (ENOSYS), a handle refused
  // its read or write (EBADF), a write that put nothing (ENOSPC), bytes that are no
  // character in the stream's encoding (EILSEQ), a print format's number past int's range
  // (ERANGE) and a queried size past what a stat's field holds (EOVERFLOW)
  ADAM_ERRNO_ENOENT: int32 = ADAM_PLATFORM_ENOENT;
  ADAM_ERRNO_EIO: int32 = ADAM_PLATFORM_EIO;
  ADAM_ERRNO_EBADF: int32 = ADAM_PLATFORM_EBADF;
  ADAM_ERRNO_ENOSPC: int32 = ADAM_PLATFORM_ENOSPC;
  ADAM_ERRNO_ENOSYS: int32 = ADAM_PLATFORM_ENOSYS;
  ADAM_ERRNO_ENOMEM: int32 = ADAM_PLATFORM_ENOMEM;
  ADAM_ERRNO_EACCES: int32 = ADAM_PLATFORM_EACCES;
  ADAM_ERRNO_EEXIST: int32 = ADAM_PLATFORM_EEXIST;
  ADAM_ERRNO_EINVAL: int32 = ADAM_PLATFORM_EINVAL;
  ADAM_ERRNO_EILSEQ: int32 = ADAM_PLATFORM_EILSEQ;
  ADAM_ERRNO_ERANGE: int32 = ADAM_PLATFORM_ERANGE;
  ADAM_ERRNO_EOVERFLOW: int32 = ADAM_PLATFORM_EOVERFLOW;

// The calling thread's C errno (what C functions and System.HookAbi report; the platform
// unit's PlatformErrno)
public routine CErrno(): int32;
begin
  return PlatformErrno();
end;

// The calling thread's C errno set to AValue (the platform unit's PlatformSetErrno)
public routine SetCErrno(const AValue: int32);
begin
  PlatformSetErrno(AValue);
end;

// AHandler run as the process ends, by whatever exit (the runtime's Halt, a program's own exit
// call, C's exit), the last one registered first: one list with C's atexit (the platform unit's
// PlatformAtExit). The heap report is the first registered, so it runs after every other one
public routine AtExit(const AHandler: routine());
begin
  PlatformAtExit(AHandler);
end;

// A run-time hook installed (the platform unit's PlatformHookInstall; System.HookAbi's
// HookInstall is the API): the C name AName's import slot in every loaded module takes
// AReplacement, and so does every module the process loads later. 0 with AOriginal (the
// function the slots reached before) and AState (the hook's record) set; else C's errno
// value of the failure (ADAM_ERRNO_*), nothing installed
public routine InstallHook(const AName: ptr to const char; const AReplacement: ptr;
  var AOriginal: ptr; var AState: ptr): int32;
begin
  return PlatformHookInstall(AName, AReplacement, AOriginal, AState);
end;

// A run-time hook uninstalled (the platform unit's PlatformHookUninstall): every slot it
// wrote whose module is still loaded gets back exactly what it held. 0 with AState nil;
// else C's errno value of the failure (ADAM_ERRNO_*)
public routine UninstallHook(var AState: ptr): int32;
begin
  return PlatformHookUninstall(AState);
end;

// A string value is nil (the empty string) or the address of its block: the ref count
// (int64; -1 for a literal's block, constant data never counted or freed), the length in
// bytes (int64), the UTF-8 bytes, a 0. Strings are values (DESIGN sec 8): blocks are
// shared and every holder counts once; a block whose count drops to 0 goes back to the
// heap. A wstring's block is the same with UTF-16 units (2 bytes each) for bytes: its
// length counts units, a 0 unit ends it. The routines that depend on the unit size are
// Text* routines taking it (1 or 2), each with a Str* and a WStr* twin; the others serve
// both. The compiler calls StrRelease / StrAssign / SinkStr / StrTake / StrConcat /
// StrFromChar / StrLength / StrCompare / StrUnique / StrSetLength, the WStr* twins and
// WStrToUtf8, StrAddRef (a value parameter's own copy, a returned text), ManagedRelease and
// ManagedAssign (the managed values inside a record or a static array) (AST
// RuntimeRoutine); a write into a text's units first makes its block the variable's alone
// (StrUnique / WStrUnique: copy on write); StrConcat, StrFromChar, WStrConcat,
// WStrFromChar, WStrToUtf8 and a routine's text result hand back a reference the caller
// holds (the compiler keeps it in a hidden slot, released at the routine's exit).
//
// A dynamic array value is nil (no elements) or the address of its block: the ref count
// (int64), the length in elements (int64), the elements, zeroed when the block is made (no
// 0 element after them). StrAddRef, StrTake and StrLength serve it as they serve a text;
// what reaches its elements takes its ELEMENT MAP, written by the compiler per array type:
// the element's size in bytes (int64), its element routines (TArrElementMap: the build, the
// copy and the end of an element whose type runs code there, each nil when it runs none),
// then the element type's managed map. A MANAGED MAP
// places the managed values a value holds at fixed offsets: an int64 count of runs, then
// per run four int64: its first value's offset, the run's count of values, the bytes from
// one to the next, and its element word: 0 for texts, else the byte offset from the map's
// own start to the element map of the dynamic arrays the run holds (the compiler writes it
// after the runs, in the same blob). The compiler calls ArrRelease / ArrAssign /
// ArrUnique / ArrSetLength (AST RuntimeRoutine); a write into an element first makes the
// block the variable's alone (ArrUnique: copy on write).

// The length of the string, wstring or dynamic array AText in its units (bytes, UTF-16
// units, elements; nil: 0)
routine StrLength(const AText: ptr): int64;
var
  LHeader: ptr to int64;
begin
  if AText = nil then
    return 0;
  end;
  LHeader := ptr to int64(AText);
  return LHeader[1];
end;

// The heap block ABlock (16 + (ALength + 1) * AUnit bytes) made a text block of ALength
// (above 0) units: its ref count 1, its length, the 0 unit after its units (TextNew's and
// setlength's new blocks)
routine DoTextReady(const ABlock: ptr; const ALength: int64; const AUnit: int64);
var
  LHeader: ptr to int64;
  LBytes: ptr to uint8;
  LI: int64;
begin
  LHeader := ptr to int64(ABlock);
  LHeader[0] := 1;
  LHeader[1] := ALength;
  LBytes := ptr to uint8(ABlock);
  for LI := 0 to AUnit - 1 do
    LBytes[16 + ALength * AUnit + LI] := 0;
  end;
end;

// A new text block of ALength units of AUnit bytes each (1: a string's bytes, 2: a
// wstring's UTF-16 units): its ref count 1, its units after the header for the caller to
// fill, the 0 unit after them written; nil for 0 units
routine TextNew(const ALength: int64; const AUnit: int64): ptr;
var
  LBlock: ptr;
begin
  if ALength <= 0 then
    return nil;
  end;
  LBlock := GetMem(16 + (ALength + 1) * AUnit);
  DoTextReady(LBlock, ALength, AUnit);
  return LBlock;
end;

// One more holder of the string AText (nil and a literal's block count nothing). Holders
// on other threads may add and drop at the same time, so the count changes through
// atomicadd; a literal's count is negative and never changes, so a plain read tells it
routine StrAddRef(const AText: ptr);
var
  LHeader: ptr to int64;
begin
  if AText = nil then
    return;
  end;
  LHeader := ptr to int64(AText);
  if LHeader[0] >= 0 then
    atomicadd(LHeader[0], 1);
  end;
end;

// One holder less of the string AText: its block freed when it was the last (nil and a
// literal's block count nothing). The holder whose atomicadd took the count from 1 to 0
// is the last, on whichever thread it is
routine StrRelease(const AText: ptr);
var
  LHeader: ptr to int64;
begin
  if AText = nil then
    return;
  end;
  LHeader := ptr to int64(AText);
  if LHeader[0] < 0 then
    return;
  end;
  if atomicadd(LHeader[0], -1) = 1 then
    FreeMem(AText);
  end;
end;

// The string AText stored into the string variable at ASlot: a holder added to AText
// before the old value is released, so storing a variable's own value keeps it
routine StrAssign(const ASlot: ptr to ptr; const AText: ptr);
var
  LOld: ptr;
begin
  StrAddRef(AText);
  LOld := ASlot^;
  ASlot^ := AText;
  StrRelease(LOld);
end;

// The string AText, a reference the caller already holds, stored into the string slot at
// ASlot (a hidden one: a concatenation's or a char's string), its old value released
routine StrTake(const ASlot: ptr to ptr; const AText: ptr);
var
  LOld: ptr;
begin
  LOld := ASlot^;
  ASlot^ := AText;
  StrRelease(LOld);
end;

// ACount bytes at AAddress set to 0 (the platform's: a byte loop at the debug level costs
// the leak tracker's every slot and table)
routine ZeroBytes(const AAddress: ptr; const ACount: int64);
begin
  if ACount > 0 then
    PlatformZero(AAddress, ACount);
  end;
end;

// The element map a managed map's element word AWord names (AWord bytes from the map
// AMap's start)
routine ElementMapAt(const AMap: ptr to int64; const AWord: int64): ptr to int64;
var
  LBytes: ptr to uint8;
begin
  LBytes := ptr to uint8(AMap);
  return ptr to int64(addr of LBytes[AWord]);
end;

forward routine ArrRelease(const AArray: ptr; const AElement: ptr to int64);
forward routine RefRelease(const ABlock: ptr);
forward routine IntfRelease(const AWord: ptr);
forward routine IntfAddRef(const AWord: ptr);
forward routine WeakAddRef(const ABlock: ptr);
forward routine WeakRelease(const ABlock: ptr);

// The managed values of the value at AAddress released, as its type's managed map AMap
// places them (see the layout above): a text by StrRelease, a ref by RefRelease (element
// word 1), a weak by WeakRelease (word 2), a dynamic array by ArrRelease with its element
// map
routine ManagedRelease(const AAddress: ptr; const AMap: ptr to int64);
var
  LBytes: ptr to uint8;
  LRun: int64;
  LAt: int64;
  LWord: int64;
  LValue: ptr;
  LI: int64;
begin
  LBytes := ptr to uint8(AAddress);
  for LRun := 0 to AMap[0] - 1 do
    LAt := AMap[1 + LRun * 4];
    LWord := AMap[4 + LRun * 4];
    for LI := 0 to AMap[2 + LRun * 4] - 1 do
      LValue := (ptr to ptr(addr of LBytes[LAt]))^;
      if LWord = 0 then
        StrRelease(LValue);
      else
        if LWord = 1 then
          RefRelease(LValue);
        else
          if LWord = 2 then
            WeakRelease(LValue);
          else
            if LWord = 3 then
              IntfRelease(LValue);
            else
              ArrRelease(LValue, ElementMapAt(AMap, LWord));
            end;
          end;
        end;
      end;
      LAt := LAt + AMap[3 + LRun * 4];
    end;
  end;
end;

// create(P) (BNF sec 7): a block of ASize bytes (a record's or an overlay's size), every
// byte 0, counted as getmem's; a type of size 0 still gets a block of one byte, so the
// pointer is never nil after a create (a heap with no room raises getmem's code 12)
routine CreateMem(const ASize: int64): ptr;
var
  LSize: int64;
  LBlock: ptr;
begin
  LSize := ASize;
  if LSize < 1 then
    LSize := 1;
  end;
  LBlock := GetMem(LSize);
  ZeroBytes(LBlock, LSize);
  return LBlock;
end;

// destroy(P) (BNF sec 7): the block P points at given back, counted as freemem's, after the
// managed values of its type released over the type's managed map AMap (nil: it holds
// none); a nil P does nothing (the compiler writes nil into P after the call)
routine DestroyMem(const APointer: ptr; const AMap: ptr to int64);
begin
  if APointer = nil then
    return;
  end;
  if AMap <> nil then
    ManagedRelease(APointer, AMap);
  end;
  FreeMem(APointer);
end;

// One more holder of each managed value of the value at AAddress, as the managed map AMap
// places them (texts, refs and dynamic arrays count their holders alike: StrAddRef; a weak
// by WeakAddRef, element word 2; an own I / ref I by IntfAddRef, element word 3)
routine ManagedAddRef(const AAddress: ptr; const AMap: ptr to int64);
var
  LBytes: ptr to uint8;
  LRun: int64;
  LAt: int64;
  LWord: int64;
  LI: int64;
begin
  LBytes := ptr to uint8(AAddress);
  for LRun := 0 to AMap[0] - 1 do
    LAt := AMap[1 + LRun * 4];
    LWord := AMap[4 + LRun * 4];
    for LI := 0 to AMap[2 + LRun * 4] - 1 do
      if LWord = 2 then
        WeakAddRef((ptr to ptr(addr of LBytes[LAt]))^);
      else
        if LWord = 3 then
          IntfAddRef((ptr to ptr(addr of LBytes[LAt]))^);
        else
          StrAddRef((ptr to ptr(addr of LBytes[LAt]))^);
        end;
      end;
      LAt := LAt + AMap[3 + LRun * 4];
    end;
  end;
end;

// The value at ASource (ASize bytes, its managed values placed by the managed map AMap)
// copied over the value at ADest: a holder added to each source value before each old one
// of ADest is released, then the bytes copied, so copying a value onto itself keeps them
routine ManagedAssign(const ADest: ptr; const ASource: ptr; const ASize: int64; const AMap: ptr to int64);
begin
  ManagedAddRef(ASource, AMap);
  ManagedRelease(ADest, AMap);
  if ADest <> ASource then
    PlatformCopy(ADest, ASource, ASize);
  end;
end;

// A ref value is nil or the address of its block: the ref count (int64), the weak count
// (int64), its type's REF DESCRIPTOR (ptr), then the object, 24 bytes in, zeroed when the
// block is made and then built by one of its inits. A REF DESCRIPTOR is written by the
// compiler per object type: the object's size in bytes (int64), its done (a routine on
// self; nil when the type declares none), then the type's managed map. StrAddRef counts a
// holder of a ref as of a text; the compiler calls RefNew, RefRelease and RefAssign (AST
// RuntimeRoutine). In a managed map a run of refs has the element word 1, a run of weaks 2,
// a run of own I / ref I 3 (an element map's offset never is any: the runs come before it).
// An own I / ref I value (I3) is nil or the address of its object's itable word for I: the
// itable's word 0 moves it back to the object, the block's header is before that
// (IntfBlock); it is counted on that block (IntfAddRef, IntfRelease, IntfAssign).
// A weak value (BNF sec 4 owner type) is nil or the address of a ref block it watches: the
// weak count holds one for each weak and one for all the refs together (RefNew's 1, given
// back by the release that ends the object), so the block is freed by whichever comes
// last, the object's end or the last weak's release; the object is alive while its ref
// count is above 0 (WeakAlive), and lock(W) adds a ref only while it is (WeakLock)
type
  TRefDone = routine(const ASelf: ptr);

  TRefDescriptor = record
    Size: int64;
    Done: TRefDone;
  end;

// A new ref block for the object type whose ref descriptor ADescriptor is: its ref count
// 1, its weak count 1 (the refs' own: see the layout above), its object's bytes zeroed for
// the caller to build
routine RefNew(const ADescriptor: ptr): ptr;
var
  LDescriptor: ptr to TRefDescriptor;
  LSize: int64;
  LBlock: ptr;
  LHeader: ptr to int64;
  LSlots: ptr to ptr;
begin
  LDescriptor := ptr to TRefDescriptor(ADescriptor);
  LSize := 24 + LDescriptor->Size;
  LBlock := GetMem(LSize);
  ZeroBytes(LBlock, LSize);
  LHeader := ptr to int64(LBlock);
  LHeader[0] := 1;
  LHeader[1] := 1;
  LSlots := ptr to ptr(LBlock);
  LSlots[2] := ADescriptor;
  return LBlock;
end;

// One holder less of the ref ABlock: when it was the last, its object ended (its done,
// then its managed values: the descriptor's map) and the refs' weak count given back
// (WeakRelease: the block freed unless a weak still watches it); nil does nothing
routine RefRelease(const ABlock: ptr);
var
  LHeader: ptr to int64;
  LSlots: ptr to ptr;
  LDescriptor: ptr to TRefDescriptor;
  LWords: ptr to int64;
  LBytes: ptr to uint8;
  LObject: ptr;
  LDone: TRefDone;
begin
  if ABlock = nil then
    return;
  end;
  // The holder whose atomicadd took the count from 1 to 0 ends the object (any thread)
  LHeader := ptr to int64(ABlock);
  if atomicadd(LHeader[0], -1) <> 1 then
    return;
  end;
  LSlots := ptr to ptr(ABlock);
  LDescriptor := ptr to TRefDescriptor(LSlots[2]);
  LWords := ptr to int64(LSlots[2]);
  LBytes := ptr to uint8(ABlock);
  LObject := addr of LBytes[24];
  LDone := LDescriptor->Done;
  if LDone <> nil then
    LDone(LObject);
  end;
  ManagedRelease(LObject, ptr to int64(addr of LWords[2]));
  WeakRelease(ABlock);
end;

// The ref ABlock stored into the ref variable at ASlot: a holder added to ABlock before
// the old value is released, so storing a variable's own value keeps it
routine RefAssign(const ASlot: ptr to ptr; const ABlock: ptr);
var
  LOld: ptr;
begin
  StrAddRef(ABlock);
  LOld := ASlot^;
  ASlot^ := ABlock;
  RefRelease(LOld);
end;

// The ref block of the own I / ref I value AWord (I3): nil for nil, else the object its
// itable's word 0 (the offset back to the object) moves it to, less the block's header
routine IntfBlock(const AWord: ptr): ptr;
var
  LTable: ptr to int64;
  LBytes: ptr to uint8;
begin
  if AWord = nil then
    return nil;
  end;
  LTable := (ptr to ptr to int64(AWord))^;
  LBytes := ptr to uint8(AWord);
  return addr of LBytes[LTable[0] - 24];
end;

// One more holder of the own I / ref I AWord: its object's block counted (StrAddRef's
// count, as a ref's); nil does nothing
routine IntfAddRef(const AWord: ptr);
begin
  StrAddRef(IntfBlock(AWord));
end;

// One holder less of the own I / ref I AWord: its object's block released (RefRelease: the
// last ends the object through its block's descriptor); nil does nothing
routine IntfRelease(const AWord: ptr);
begin
  RefRelease(IntfBlock(AWord));
end;

// The own I / ref I AWord stored into the variable at ASlot: a holder added to AWord
// before the old value is released, so storing a variable's own value keeps it
routine IntfAssign(const ASlot: ptr to ptr; const AWord: ptr);
var
  LOld: ptr;
begin
  IntfAddRef(AWord);
  LOld := ASlot^;
  ASlot^ := AWord;
  IntfRelease(LOld);
end;

// One more weak watching the ref block ABlock (BNF sec 4 weak T); nil does nothing
routine WeakAddRef(const ABlock: ptr);
var
  LHeader: ptr to int64;
begin
  if ABlock = nil then
    return;
  end;
  LHeader := ptr to int64(ABlock);
  atomicadd(LHeader[1], 1);
end;

// One weak less watching the ref block ABlock (or the refs' own count, from RefRelease):
// the block freed when it was the last (its object ended already: the refs' count goes
// only after the end); nil does nothing. The holder whose atomicadd took the count from 1
// to 0 frees it, on whichever thread it is
routine WeakRelease(const ABlock: ptr);
var
  LHeader: ptr to int64;
begin
  if ABlock = nil then
    return;
  end;
  LHeader := ptr to int64(ABlock);
  if atomicadd(LHeader[1], -1) = 1 then
    FreeMem(ABlock);
  end;
end;

// The ref block ABlock stored into the weak variable at ASlot: a weak added to ABlock
// before the old value's is released, so storing a variable's own value keeps it
routine WeakAssign(const ASlot: ptr to ptr; const ABlock: ptr);
var
  LOld: ptr;
begin
  WeakAddRef(ABlock);
  LOld := ASlot^;
  ASlot^ := ABlock;
  WeakRelease(LOld);
end;

// alive(W) (BNF sec 7): true while the object the weak ABlock watches still exists (its
// ref count above 0); nil is never alive
routine WeakAlive(const ABlock: ptr): bool;
var
  LHeader: ptr to int64;
begin
  if ABlock = nil then
    return false;
  end;
  LHeader := ptr to int64(ABlock);
  return atomicload(LHeader[0]) > 0;
end;

// lock(W) (BNF sec 7): a ref holding the object the weak ABlock watches (its block, one
// more ref holder the caller owns), nil once the object is gone. The count only grows from
// a value above 0 (atomiccas), so a release on another thread that takes it to 0 is never
// undone
routine WeakLock(const ABlock: ptr): ptr;
var
  LHeader: ptr to int64;
  LCount: int64;
begin
  if ABlock = nil then
    return nil;
  end;
  LHeader := ptr to int64(ABlock);
  LCount := atomicload(LHeader[0]);
  while LCount > 0 do
    if atomiccas(LHeader[0], LCount, LCount + 1) then
      return ABlock;
    end;
    LCount := atomicload(LHeader[0]);
  end;
  return nil;
end;

// What an abstract method's vtable slot holds: a call that reaches it (only an abstract
// object's own init or done can make one) says so and ends the process with exit code 1
// (it raises once exceptions exist, M3.11)
routine AbstractCall();
begin
  println("abstract method called");
  Halt(1);
end;

// The element routines an element map starts with (see the layout above): the element's
// size, then the routines of an element whose type runs code where it is built (an init, a
// vptr), copied (a copy decl) or ended (a done), each nil when it runs none there. Build
// builds the zeroed element at AElement; CopyOne builds the zeroed element at ADest as a
// copy of the one at ASource (its managed values each one more holder); EndOne ends the
// element at AElement, its managed values then released by the map. An element that ends
// by an EndOne with no CopyOne cannot be copied (BNF sec 4 O5)
type
  TArrBuild = routine(const AElement: ptr);
  TArrCopy = routine(const ADest: ptr; const ASource: ptr);
  TArrEnd = routine(const AElement: ptr);

  TArrElementMap = record
    Size: int64;
    Build: TArrBuild;
    CopyOne: TArrCopy;
    EndOne: TArrEnd;
  end;

const
  // The words of an element map before its element type's managed map
  ADAM_RUNTIME_ELEMENT_HEAD: int64 = 4;

// The address of element AIndex of the dynamic array block ABlock, whose element map
// AElement gives the element's size
routine ArrElementAt(const ABlock: ptr; const AElement: ptr to int64; const AIndex: int64): ptr;
var
  LBytes: ptr to uint8;
begin
  LBytes := ptr to uint8(ABlock);
  return addr of LBytes[16 + AIndex * AElement[0]];
end;

// What a copy of the elements of a dynamic array whose elements cannot be copied (an
// EndOne and no CopyOne, BNF sec 4 O5) does: Semantics never copies such an array (SM0427),
// so only a write through another name into a block a borrowed parameter's holder still
// shares reaches it; it says so and ends the process with exit code 1 (it raises once
// exceptions exist, M3.11)
routine ArrCopyFail(); noreturn;
begin
  println("the elements of a dynamic array that cannot be copied were copied");
  Halt(1);
end;

// The ACount elements from element AFirst of the dynamic array block ABlock ended, the last
// first (the reverse of their build), as its element map AElement says: each by its EndOne
// when it has one, then its managed values released; nothing for elements that run no code
// and hold no managed value
routine ArrEndElements(const ABlock: ptr; const AElement: ptr to int64; const AFirst: int64;
  const ACount: int64);
var
  LRoutines: ptr to TArrElementMap;
  LMap: ptr to int64;
  LEnd: TArrEnd;
  LAt: ptr;
  LI: int64;
begin
  LRoutines := ptr to TArrElementMap(AElement);
  LEnd := LRoutines->EndOne;
  LMap := addr of AElement[ADAM_RUNTIME_ELEMENT_HEAD];
  if (LEnd = nil) and (LMap[0] = 0) then
    return;
  end;
  for LI := AFirst + ACount - 1 downto AFirst do
    LAt := ArrElementAt(ABlock, AElement, LI);
    if LEnd <> nil then
      LEnd(LAt);
    end;
    if LMap[0] <> 0 then
      ManagedRelease(LAt, LMap);
    end;
  end;
end;

// The ACount zeroed elements from element AFirst of the dynamic array block ABlock built,
// the first first, by the element map AElement's Build (nothing when it has none)
routine ArrBuildElements(const ABlock: ptr; const AElement: ptr to int64; const AFirst: int64;
  const ACount: int64);
var
  LRoutines: ptr to TArrElementMap;
  LBuild: TArrBuild;
  LI: int64;
begin
  LRoutines := ptr to TArrElementMap(AElement);
  LBuild := LRoutines->Build;
  if LBuild = nil then
    return;
  end;
  for LI := AFirst to AFirst + ACount - 1 do
    LBuild(ArrElementAt(ABlock, AElement, LI));
  end;
end;

// The first ACount elements of the dynamic array block ASource copied into the zeroed first
// ACount of the block ADest (both of the element map AElement), the first first: each by
// its CopyOne when it has one, else (an element that ends by no code) its bytes, each of
// its managed values then one more holder; an element that cannot be copied fails
// (ArrCopyFail)
routine ArrCopyElements(const ADest: ptr; const ASource: ptr; const AElement: ptr to int64;
  const ACount: int64);
var
  LRoutines: ptr to TArrElementMap;
  LCopy: TArrCopy;
  LMap: ptr to int64;
  LI: int64;
begin
  if ACount <= 0 then
    return;
  end;
  LRoutines := ptr to TArrElementMap(AElement);
  LCopy := LRoutines->CopyOne;
  if LCopy <> nil then
    for LI := 0 to ACount - 1 do
      LCopy(ArrElementAt(ADest, AElement, LI), ArrElementAt(ASource, AElement, LI));
    end;
    return;
  end;
  if LRoutines->EndOne <> nil then
    ArrCopyFail();
  end;
  PlatformCopy(ArrElementAt(ADest, AElement, 0), ArrElementAt(ASource, AElement, 0), ACount * AElement[0]);
  LMap := addr of AElement[ADAM_RUNTIME_ELEMENT_HEAD];
  if LMap[0] = 0 then
    return;
  end;
  for LI := 0 to ACount - 1 do
    ManagedAddRef(ArrElementAt(ADest, AElement, LI), LMap);
  end;
end;

// The heap block ABlock (16 + ALength * AElement[0] bytes) made a dynamic array block of
// ALength (above 0) elements of the element map AElement: its ref count 1, its length, its
// elements zeroed, not built (ArrNew's and setlength's new blocks: their callers copy or
// build them)
routine DoArrReady(const ABlock: ptr; const ALength: int64; const AElement: ptr to int64);
var
  LHeader: ptr to int64;
begin
  LHeader := ptr to int64(ABlock);
  LHeader[0] := 1;
  LHeader[1] := ALength;
  ZeroBytes(ArrElementAt(ABlock, AElement, 0), ALength * AElement[0]);
end;

// A new dynamic array block of ALength elements of the element map AElement: its ref count
// 1, its elements zeroed, not built (ArrUnique copies into them); nil for no elements
routine ArrNew(const ALength: int64; const AElement: ptr to int64): ptr;
var
  LBlock: ptr;
begin
  if ALength <= 0 then
    return nil;
  end;
  LBlock := GetMem(16 + ALength * AElement[0]);
  DoArrReady(LBlock, ALength, AElement);
  return LBlock;
end;

// One holder less of the dynamic array AArray (its element map AElement): when it was the
// last, its elements are ended (ArrEndElements) and its block freed (nil: nothing)
routine ArrRelease(const AArray: ptr; const AElement: ptr to int64);
var
  LHeader: ptr to int64;
begin
  if AArray = nil then
    return;
  end;
  // The holder whose atomicadd took the count from 1 to 0 ends the array (any thread)
  LHeader := ptr to int64(AArray);
  if atomicadd(LHeader[0], -1) = 1 then
    ArrEndElements(AArray, AElement, 0, LHeader[1]);
    FreeMem(AArray);
  end;
end;

// The dynamic array AArray (its element map AElement) stored into the variable at ASlot: a
// holder added to AArray before the old value is released, so storing a variable's own
// value keeps it
routine ArrAssign(const ASlot: ptr to ptr; const AArray: ptr; const AElement: ptr to int64);
var
  LOld: ptr;
begin
  StrAddRef(AArray);
  LOld := ASlot^;
  ASlot^ := AArray;
  ArrRelease(LOld, AElement);
end;

// The dynamic array in the variable at ASlot (its element map AElement) made its holder's
// alone before a write into an element (copy on write): a block shared with another holder
// is copied into a new block the slot then holds (ArrCopyElements: each element by its
// type's copy, or its bytes with its managed values one more holder), the old block
// released; the block the slot holds after (nil: no elements)
routine ArrUnique(const ASlot: ptr to ptr; const AElement: ptr to int64): ptr;
var
  LArray: ptr;
  LHeader: ptr to int64;
  LCopy: ptr;
begin
  LArray := ASlot^;
  if LArray = nil then
    return nil;
  end;
  LHeader := ptr to int64(LArray);
  if atomicload(LHeader[0]) = 1 then
    return LArray;
  end;
  LCopy := ArrNew(LHeader[1], AElement);
  ArrCopyElements(LCopy, LArray, AElement, LHeader[1]);
  ASlot^ := LCopy;
  ArrRelease(LArray, AElement);
  return LCopy;
end;

// setlength(A, N) on the dynamic array variable at ASlot (its element map AElement): N
// elements after it, the first kept up to the smaller length and any added ones zeroed,
// then built (ArrBuildElements: std::vector's resize); the dropped ones ended
// (ArrEndElements); the same length changes nothing; 0 is no elements, nil. A
// negative N raises code 12 `negative length N`, a length the heap cannot hold `out of
// memory (length N)` (PaskalCPP's set_length), the array then as it was. A shared block is
// not changed in place: the new one is the slot's own, its kept elements copied
// (ArrCopyElements)
routine ArrSetLength(const ASlot: ptr to ptr; const ALength: int64; const AElement: ptr to int64);
var
  LOld: ptr;
  LOldLength: int64;
  LKept: int64;
  LBytes: int64;
  LHeader: ptr to int64;
  LBlock: ptr;
begin
  if ALength < 0 then
    LengthFail(ALength);
  end;
  LOld := ASlot^;
  LOldLength := StrLength(LOld);
  if ALength = LOldLength then
    return;
  end;
  if ALength = 0 then
    ASlot^ := nil;
    ArrRelease(LOld, AElement);
    return;
  end;
  LBytes := DoBlockBytes(ALength, AElement[0], 0);
  if LBytes < 0 then
    LengthFail(ALength);
  end;
  LKept := LOldLength;
  if ALength < LKept then
    LKept := ALength;
  end;
  LHeader := ptr to int64(LOld);
  if (LOld <> nil) and (atomicload(LHeader[0]) = 1) then
    // the slot's own block: the dropped elements released, then grown or shrunk by
    // DoSetLengthBlock (maybe moved, maybe kept as it is: room past the length is how a
    // loop growing by one stays O(1) a step), its kept elements as they were, the added
    // ones zeroed. A growth the
    // heap refuses has dropped nothing yet, so the array is as it was; a shrink it refuses
    // keeps the larger block, which holds the shorter array as well
    ArrEndElements(LOld, AElement, LKept, LOldLength - LKept);
    LBlock := DoSetLengthBlock(LOld, LBytes);
    if LBlock = nil then
      if ALength > LOldLength then
        LengthFail(ALength);
      end;
      LBlock := LOld;
    end;
    LHeader := ptr to int64(LBlock);
    LHeader[1] := ALength;
    ZeroBytes(ArrElementAt(LBlock, AElement, LKept), (ALength - LKept) * AElement[0]);
    ArrBuildElements(LBlock, AElement, LKept, ALength - LKept);
  else
    // a new block, through DoGetMem so no room raises setlength's own text
    LBlock := DoGetMem(LBytes);
    if LBlock = nil then
      LengthFail(ALength);
    end;
    DoArrReady(LBlock, ALength, AElement);
    ArrCopyElements(LBlock, LOld, AElement, LKept);
    ArrBuildElements(LBlock, AElement, LKept, ALength - LKept);
    ArrRelease(LOld, AElement);
  end;
  ASlot^ := LBlock;
end;

// ALeft followed by ARight (texts of AUnit-byte units), a reference the caller holds: a
// new block, or the one side itself (one more holder) when the other is empty; nil when
// both are
routine TextConcat(const ALeft: ptr; const ARight: ptr; const AUnit: int64): ptr;
var
  LLeftLength: int64;
  LRightLength: int64;
  LBlock: ptr;
  LTo: ptr to uint8;
  LFrom: ptr to uint8;
begin
  LLeftLength := StrLength(ALeft);
  LRightLength := StrLength(ARight);
  if LRightLength = 0 then
    StrAddRef(ALeft);
    return ALeft;
  end;
  if LLeftLength = 0 then
    StrAddRef(ARight);
    return ARight;
  end;
  LBlock := TextNew(LLeftLength + LRightLength, AUnit);
  LTo := ptr to uint8(LBlock);
  LFrom := ptr to uint8(ALeft);
  PlatformCopy(addr of LTo[16], addr of LFrom[16], LLeftLength * AUnit);
  LFrom := ptr to uint8(ARight);
  PlatformCopy(addr of LTo[16 + LLeftLength * AUnit], addr of LFrom[16], LRightLength * AUnit);
  return LBlock;
end;

// The string ALeft followed by the string ARight (TextConcat's, one byte a unit)
routine StrConcat(const ALeft: ptr; const ARight: ptr): ptr;
begin
  return TextConcat(ALeft, ARight, 1);
end;

// The wstring ALeft followed by the wstring ARight (TextConcat's, a UTF-16 unit each)
routine WStrConcat(const ALeft: ptr; const ARight: ptr): ptr;
begin
  return TextConcat(ALeft, ARight, 2);
end;

// The one-char string of AChar, a reference the caller holds
routine StrFromChar(const AChar: char): ptr;
var
  LBlock: ptr;
  LTo: ptr to char;
begin
  LBlock := TextNew(1, 1);
  LTo := ptr to char(LBlock);
  LTo[16] := AChar;
  return LBlock;
end;

// The one-unit wstring of AChar, a reference the caller holds (its unit after the 16-byte
// header: unit 8)
routine WStrFromChar(const AChar: wchar): ptr;
var
  LBlock: ptr;
  LTo: ptr to wchar;
begin
  LBlock := TextNew(1, 2);
  LTo := ptr to wchar(LBlock);
  LTo[8] := AChar;
  return LBlock;
end;

// Unit AIndex of the non-empty text block AText (AUnit-byte units after its 16-byte
// header), unsigned: a string's byte, a wstring's UTF-16 unit
routine TextUnitAt(const AText: ptr; const AUnit: int64; const AIndex: int64): uint32;
var
  LBytes: ptr to uint8;
  LUnits: ptr to uint16;
begin
  if AUnit = 2 then
    LUnits := ptr to uint16(AText);
    return LUnits[8 + AIndex];
  end;
  LBytes := ptr to uint8(AText);
  return LBytes[16 + AIndex];
end;

// ALeft against ARight (texts of AUnit-byte units) unit by unit, each unit unsigned, then
// the shorter first (as PaskalCPP's std::string / std::wstring compare): -1, 0 or 1 as
// ALeft is below, equal to or above ARight
routine TextCompare(const ALeft: ptr; const ARight: ptr; const AUnit: int64): int32;
var
  LLeftLength: int64;
  LRightLength: int64;
  LCount: int64;
  LLeftUnit: uint32;
  LRightUnit: uint32;
  LI: int64;
begin
  if ALeft = ARight then
    return 0;
  end;
  LLeftLength := StrLength(ALeft);
  LRightLength := StrLength(ARight);
  LCount := LLeftLength;
  if LRightLength < LCount then
    LCount := LRightLength;
  end;
  // LCount is 0 when either side is nil, so TextUnitAt only reads a block
  for LI := 0 to LCount - 1 do
    LLeftUnit := TextUnitAt(ALeft, AUnit, LI);
    LRightUnit := TextUnitAt(ARight, AUnit, LI);
    if LLeftUnit <> LRightUnit then
      if LLeftUnit < LRightUnit then
        return -1;
      end;
      return 1;
    end;
  end;
  if LLeftLength < LRightLength then
    return -1;
  end;
  if LLeftLength > LRightLength then
    return 1;
  end;
  return 0;
end;

// The string ALeft against the string ARight (TextCompare's, byte by byte)
routine StrCompare(const ALeft: ptr; const ARight: ptr): int32;
begin
  return TextCompare(ALeft, ARight, 1);
end;

// The wstring ALeft against the wstring ARight (TextCompare's, UTF-16 unit by unit)
routine WStrCompare(const ALeft: ptr; const ARight: ptr): int32;
begin
  return TextCompare(ALeft, ARight, 2);
end;

// The text (of AUnit-byte units) in the variable at ASlot made its holder's alone before a
// write into its units (copy on write): a block shared with another holder, or a
// literal's constant one, is copied into a new block the slot then holds (the old one
// released); the block the slot holds after, nil for the empty text
routine TextUnique(const ASlot: ptr to ptr; const AUnit: int64): ptr;
var
  LText: ptr;
  LHeader: ptr to int64;
  LCopy: ptr;
  LTo: ptr to uint8;
  LFrom: ptr to uint8;
begin
  LText := ASlot^;
  if LText = nil then
    return nil;
  end;
  LHeader := ptr to int64(LText);
  if atomicload(LHeader[0]) = 1 then
    return LText;
  end;
  LCopy := TextNew(LHeader[1], AUnit);
  LTo := ptr to uint8(LCopy);
  LFrom := ptr to uint8(LText);
  PlatformCopy(addr of LTo[16], addr of LFrom[16], LHeader[1] * AUnit);
  ASlot^ := LCopy;
  StrRelease(LText);
  return LCopy;
end;

// The string variable at ASlot made its own before a write into its bytes (TextUnique's)
routine StrUnique(const ASlot: ptr to ptr): ptr;
begin
  return TextUnique(ASlot, 1);
end;

// The wstring variable at ASlot made its own before a write into its units (TextUnique's)
routine WStrUnique(const ASlot: ptr to ptr): ptr;
begin
  return TextUnique(ASlot, 2);
end;

// setlength(S, N) on the text variable at ASlot (AUnit-byte units): N units after it, the
// first kept up to the smaller length and any added ones 0 (std::string's / wstring's
// resize); the same length changes nothing; 0 is the empty text, nil. A negative N raises
// code 12 `negative length N`, a length the heap cannot hold `out of memory (length N)`
// (PaskalCPP's set_length), the text then as it was. A block shared or constant is not
// grown in place: the new one is the slot's own
routine TextSetLength(const ASlot: ptr to ptr; const ALength: int64; const AUnit: int64);
var
  LOld: ptr;
  LOldLength: int64;
  LKept: int64;
  LBytes: int64;
  LHeader: ptr to int64;
  LBlock: ptr;
  LTo: ptr to uint8;
  LFrom: ptr to uint8;
begin
  if ALength < 0 then
    LengthFail(ALength);
  end;
  LOld := ASlot^;
  LOldLength := StrLength(LOld);
  if ALength = LOldLength then
    return;
  end;
  if ALength = 0 then
    ASlot^ := nil;
    StrRelease(LOld);
    return;
  end;
  // the units and the 0 unit after them
  LBytes := DoBlockBytes(ALength, AUnit, 1);
  if LBytes < 0 then
    LengthFail(ALength);
  end;
  LKept := LOldLength;
  if ALength < LKept then
    LKept := ALength;
  end;
  LHeader := ptr to int64(LOld);
  if (LOld <> nil) and (atomicload(LHeader[0]) = 1) then
    // the slot's own block: grown or shrunk by DoSetLengthBlock (maybe moved, maybe kept
    // as it is: room past the length is how a loop growing by one stays O(1) a step), its
    // units kept. A growth
    // the heap refuses leaves the text as it was; a shrink it refuses keeps the larger
    // block, which holds the shorter text and its 0 unit as well
    LBlock := DoSetLengthBlock(LOld, LBytes);
    if LBlock = nil then
      if ALength > LOldLength then
        LengthFail(ALength);
      end;
      LBlock := LOld;
    end;
    LHeader := ptr to int64(LBlock);
    LHeader[1] := ALength;
  else
    // a new block, through DoGetMem so no room raises setlength's own text
    LBlock := DoGetMem(LBytes);
    if LBlock = nil then
      LengthFail(ALength);
    end;
    DoTextReady(LBlock, ALength, AUnit);
    if LKept > 0 then
      LTo := ptr to uint8(LBlock);
      LFrom := ptr to uint8(LOld);
      PlatformCopy(addr of LTo[16], addr of LFrom[16], LKept * AUnit);
    end;
    StrRelease(LOld);
  end;
  // the added units and the 0 unit after them
  LTo := ptr to uint8(LBlock);
  ZeroBytes(ptr(addr of LTo[16 + LKept * AUnit]), (ALength + 1 - LKept) * AUnit);
  ASlot^ := LBlock;
end;

// setlength(S, N) on the string variable at ASlot (TextSetLength's, N bytes)
routine StrSetLength(const ASlot: ptr to ptr; const ALength: int64);
begin
  TextSetLength(ASlot, ALength, 1);
end;

// setlength(S, N) on the wstring variable at ASlot (TextSetLength's, N UTF-16 units)
routine WStrSetLength(const ASlot: ptr to ptr; const ALength: int64);
begin
  TextSetLength(ASlot, ALength, 2);
end;

// The code point at unit AIndex of the ALength UTF-16 units at AText, and in AUnits the
// units it takes: a surrogate pair is one code point (2 units), an unpaired surrogate
// U+FFFD (1 unit), as PaskalCPP's utf8() decodes
routine Utf16CodeAt(const AText: ptr to const uint16; const ALength: int64;
  const AIndex: int64; var AUnits: int64): uint32;
var
  LHigh: uint32;
  LLow: uint32;
begin
  AUnits := 1;
  LHigh := uint32(AText[AIndex]);
  if (LHigh < 0xD800) or (LHigh > 0xDFFF) then
    return LHigh;
  end;
  if (LHigh > 0xDBFF) or (AIndex + 1 >= ALength) then
    return 0xFFFD;
  end;
  LLow := uint32(AText[AIndex + 1]);
  if (LLow < 0xDC00) or (LLow > 0xDFFF) then
    return 0xFFFD;
  end;
  AUnits := 2;
  return 0x10000 + ((LHigh - 0xD800) shl 10) + (LLow - 0xDC00);
end;

// The units of the wstring AText (its block's text, 16 bytes in)
routine WStrUnits(const AText: ptr): ptr to const uint16;
var
  LBytes: ptr to uint8;
begin
  LBytes := ptr to uint8(AText);
  return ptr to const uint16(addr of LBytes[16]);
end;

// The code point at unit AIndex of the wstring AText (ALength units), and in AUnits the
// units it takes (Utf16CodeAt's rule)
routine WStrCodeAt(const AText: ptr; const ALength: int64; const AIndex: int64;
  var AUnits: int64): uint32;
begin
  return Utf16CodeAt(WStrUnits(AText), ALength, AIndex, AUnits);
end;

// The UTF-8 bytes the code point ACode takes (1 .. 4)
routine Utf8Size(const ACode: uint32): int64;
begin
  if ACode < 0x80 then
    return 1;
  end;
  if ACode < 0x800 then
    return 2;
  end;
  if ACode < 0x10000 then
    return 3;
  end;
  return 4;
end;

// The code point ACode written as UTF-8 at ATo[AAt] (Utf8Size bytes), AAt moved past them
routine Utf8Put(const ATo: ptr to uint8; var AAt: int64; const ACode: uint32);
var
  LSize: int64;
  LLead: uint32;
  LShift: uint32;
  LI: int64;
begin
  LSize := Utf8Size(ACode);
  if LSize = 1 then
    ATo[AAt] := uint8(ACode);
    AAt := AAt + 1;
    return;
  end;
  // the lead byte: the size's marker bits over the code's top bits; then 6 bits a byte
  LLead := 0xF0;
  LShift := 18;
  if LSize = 2 then
    LLead := 0xC0;
    LShift := 6;
  end;
  if LSize = 3 then
    LLead := 0xE0;
    LShift := 12;
  end;
  ATo[AAt] := uint8(LLead | (ACode shr LShift));
  for LI := 1 to LSize - 1 do
    ATo[AAt + LI] := uint8(0x80 | ((ACode shr (6 * (LSize - 1 - LI))) & 0x3F));
  end;
  AAt := AAt + LSize;
end;

// utf8(W): the wstring AText as a UTF-8 string, a reference the caller holds (an unpaired
// surrogate becomes U+FFFD, as PaskalCPP's utf8() writes it); nil for the empty wstring
routine WStrToUtf8(const AText: ptr): ptr;
var
  LLength: int64;
  LSize: int64;
  LUnits: int64;
  LAt: int64;
  LBlock: ptr;
  LTo: ptr to uint8;
  LI: int64;
begin
  LLength := StrLength(AText);
  // the UTF-8 size first, then the bytes into a block of exactly that size
  LSize := 0;
  LI := 0;
  while LI < LLength do
    LSize := LSize + Utf8Size(WStrCodeAt(AText, LLength, LI, LUnits));
    LI := LI + LUnits;
  end;
  LBlock := TextNew(LSize, 1);
  if LBlock = nil then
    return nil;
  end;
  LTo := ptr to uint8(LBlock);
  LAt := 16;
  LI := 0;
  while LI < LLength do
    Utf8Put(LTo, LAt, WStrCodeAt(AText, LLength, LI, LUnits));
    LI := LI + LUnits;
  end;
  return LBlock;
end;

// A print sink (M3.8f2b): where the pieces of a print, a println or a FormatStr go. nil is
// stdout; else the address of a string variable the pieces are added to, its block that
// variable's alone (FormatStr's hidden slot, which starts each call empty). Each Sink*
// routine writes one print form into a sink, so print, println and FormatStr share each
// conversion

// The ACount bytes at AText written to the print sink ASink as they are (to stdout even
// when there are none)
routine SinkText(const ASink: ptr to ptr; const AText: ptr; const ACount: int64);
var
  LOld: int64;
  LTo: ptr to uint8;
begin
  if ASink = nil then
    PlatformWrite(AText, ACount);
    return;
  end;
  if ACount <= 0 then
    return;
  end;
  // the string grows by ACount bytes, which are copied in after its old ones
  LOld := StrLength(ASink^);
  StrSetLength(ASink, LOld + ACount);
  LTo := ptr to uint8(ASink^);
  PlatformCopy(addr of LTo[16 + LOld], AText, ACount);
end;

// The C string AText (its bytes up to its NUL) written to the print sink ASink
routine SinkLiteral(const ASink: ptr to ptr; const AText: ptr to const char);
var
  LCount: int64;
begin
  LCount := 0;
  while AText[LCount] <> '\0' do
    LCount := LCount + 1;
  end;
  SinkText(ASink, ptr(AText), LCount);
end;

// print's form of a string: its bytes to the print sink ASink (nil writes nothing)
routine SinkStr(const ASink: ptr to ptr; const AText: ptr);
var
  LHeader: ptr to int64;
  LBytes: ptr to uint8;
begin
  if AText = nil then
    return;
  end;
  LHeader := ptr to int64(AText);
  LBytes := ptr to uint8(AText);
  SinkText(ASink, addr of LBytes[16], LHeader[1]);
end;

// print's form of a signed integer: AValue in decimal, a '-' before a negative one, to the
// print sink ASink
routine SinkInt(const ASink: ptr to ptr; const AValue: int64);
var
  LDigits: array[0..23] of char;
  LAt: int64;
begin
  // The magnitude is taken as uint64 so the most negative int64 has one too
  if AValue < 0 then
    LAt := DecimalText(addr of LDigits[0], uint64(0) - uint64(AValue), true);
  else
    LAt := DecimalText(addr of LDigits[0], uint64(AValue), false);
  end;
  SinkText(ASink, addr of LDigits[LAt], 24 - LAt);
end;

// print's form of an unsigned integer: AValue in decimal to the print sink ASink
routine SinkUInt(const ASink: ptr to ptr; const AValue: uint64);
var
  LDigits: array[0..23] of char;
  LAt: int64;
begin
  LAt := DecimalText(addr of LDigits[0], AValue, false);
  SinkText(ASink, addr of LDigits[LAt], 24 - LAt);
end;

// The code points of the ACount UTF-16 units at AText written to the print sink ASink as
// UTF-8 (an unpaired surrogate U+FFFD, Utf16CodeAt's rule), through a buffer written as it
// fills
routine SinkUtf16(const ASink: ptr to ptr; const AText: ptr to const uint16; const ACount: int64);
var
  LBuffer: array[0..255] of uint8;
  LAt: int64;
  LI: int64;
  LUnits: int64;
  LCode: uint32;
begin
  LAt := 0;
  LI := 0;
  while LI < ACount do
    // a code point takes at most 4 bytes: the buffer is written before one could pass its end
    if LAt > 252 then
      SinkText(ASink, addr of LBuffer[0], LAt);
      LAt := 0;
    end;
    LCode := Utf16CodeAt(AText, ACount, LI, LUnits);
    Utf8Put(addr of LBuffer[0], LAt, LCode);
    LI := LI + LUnits;
  end;
  if LAt > 0 then
    SinkText(ASink, addr of LBuffer[0], LAt);
  end;
end;

// print's form of a bool: "true" or "false" to the print sink ASink
routine SinkBool(const ASink: ptr to ptr; const AValue: bool);
begin
  if AValue then
    SinkLiteral(ASink, ptr to const char("true"));
  else
    SinkLiteral(ASink, ptr to const char("false"));
  end;
end;

// print's form of a char: its byte to the print sink ASink
routine SinkChar(const ASink: ptr to ptr; const AValue: char);
var
  LByte: array[0..0] of char;
begin
  LByte[0] := AValue;
  SinkText(ASink, addr of LByte[0], 1);
end;

// print's form of a wchar: its code point as UTF-8 (a surrogate alone U+FFFD) to the print
// sink ASink
routine SinkWideChar(const ASink: ptr to ptr; const AValue: wchar);
var
  LUnit: array[0..0] of uint16;
begin
  LUnit[0] := uint16(AValue);
  SinkUtf16(ASink, addr of LUnit[0], 1);
end;

// print's form of a wstring: its text as UTF-8 to the print sink ASink (nil, the empty one,
// writes nothing)
routine SinkWideText(const ASink: ptr to ptr; const AText: ptr);
begin
  if AText = nil then
    return;
  end;
  SinkUtf16(ASink, WStrUnits(AText), StrLength(AText));
end;

// print's form of a ptr to char: the C string's bytes up to its NUL to the print sink
// ASink; nil writes "nil"
routine SinkCText(const ASink: ptr to ptr; const AText: ptr to const char);
begin
  if AText = nil then
    SinkLiteral(ASink, ptr to const char("nil"));
    return;
  end;
  SinkLiteral(ASink, AText);
end;

// print's form of a ptr to wchar: the C wide string's units up to its NUL as UTF-8 to the
// print sink ASink; nil writes "nil"
routine SinkWideCText(const ASink: ptr to ptr; const AText: ptr to const wchar);
var
  LUnits: ptr to const uint16;
  LCount: int64;
begin
  if AText = nil then
    SinkLiteral(ASink, ptr to const char("nil"));
    return;
  end;
  LUnits := ptr to const uint16(AText);
  LCount := 0;
  while LUnits[LCount] <> 0 do
    LCount := LCount + 1;
  end;
  SinkUtf16(ASink, LUnits, LCount);
end;

// print's form of any other pointer (a routine value and nil too): "0x" and the address in
// lowercase hex, no leading zeros (nil "0x0"), to the print sink ASink
routine SinkAddress(const ASink: ptr to ptr; const AValue: ptr);
var
  LDigits: array[0..17] of char;
  LAt: int64;
  LRest: uint64;
  LDigit: int64;
begin
  // The digits are written from the end of LDigits back toward its start, "0x" before them
  LAt := 18;
  LRest := uint64(AValue);
  repeat
    LAt := LAt - 1;
    LDigit := int64(LRest & 0xF);
    if LDigit < 10 then
      LDigits[LAt] := char(48 + LDigit);
    else
      LDigits[LAt] := char(87 + LDigit);
    end;
    LRest := LRest shr 4;
  until LRest = 0;
  LDigits[LAt - 1] := 'x';
  LDigits[LAt - 2] := '0';
  LAt := LAt - 2;
  SinkText(ASink, addr of LDigits[LAt], 18 - LAt);
end;

// print's form of a choices value: the name of the value numbered ANumber, else the type's
// name and the number, `TypeName(N)`, to the print sink ASink. ATable is the type's names
// table, in int64 words: [value count, type name length, the type name's bytes packed 8 to
// a word, then per value: its number, its name length, the name's bytes packed the same way]
routine SinkChoice(const ASink: ptr to ptr; const ANumber: int64; const ATable: ptr to const int64);
var
  LCount: int64;
  LAt: int64;
  LI: int64;
begin
  LCount := ATable[0];
  // the first value's entry follows the type name's words
  LAt := 2 + (ATable[1] + 7) div 8;
  for LI := 1 to LCount do
    if ATable[LAt] = ANumber then
      SinkText(ASink, ptr(addr of ATable[LAt + 2]), ATable[LAt + 1]);
      return;
    end;
    LAt := LAt + 2 + (ATable[LAt + 1] + 7) div 8;
  end;
  SinkText(ASink, ptr(addr of ATable[2]), ATable[1]);
  SinkLiteral(ASink, ptr to const char("("));
  SinkInt(ASink, ANumber);
  SinkLiteral(ASink, ptr to const char(")"));
end;

// A placeholder's spec as the compiler writes it for the SinkSpec* routines below (M3.8f3;
// libc++'s parsed std-format-spec), in int64 words: [0] the fill's UTF-8 bytes packed
// little-endian, [1] their count (0: a space), [2] the alignment (ADAM_SPEC_ALIGN_*), [3]
// the sign (ADAM_SPEC_SIGN_*), [4] 1 for `#`, [5] the width as written (0: none), [6] the
// type letter's byte (0: none; `?` the debug form), [7] the precision as written (-1: none,
// M3.8f4). A width or a precision an argument gives comes as an operand of its own
// (SpecWidth's result; -1: the written one)
const
  ADAM_SPEC_ALIGN_DEFAULT: int64 = 0;
  ADAM_SPEC_ALIGN_LEFT: int64 = 1;
  ADAM_SPEC_ALIGN_CENTER: int64 = 2;
  ADAM_SPEC_ALIGN_RIGHT: int64 = 3;
  // `0` with no alignment written: zeros between the sign and prefix and the digits
  ADAM_SPEC_ALIGN_ZERO: int64 = 4;
  ADAM_SPEC_SIGN_MINUS: int64 = 0;
  ADAM_SPEC_SIGN_PLUS: int64 = 1;
  ADAM_SPEC_SIGN_SPACE: int64 = 2;
  // A width libc++ takes from an argument at most (__format::__number_max)
  ADAM_SPEC_WIDTH_MAX: int64 = 2147483647;
  // How SpecWidth's argument is typed: a signed integer, an unsigned one, no integer
  ADAM_SPEC_WIDTH_SIGNED: int64 = 0;
  ADAM_SPEC_WIDTH_UNSIGNED: int64 = 1;
  ADAM_SPEC_WIDTH_NO_INTEGER: int64 = 2;

// The width a placeholder's `{}` width takes from its argument, AValue's bits typed as
// AKind says (ADAM_SPEC_WIDTH_*), checked as libc++ checks it when the format runs (a
// negative one, one past ADAM_SPEC_WIDTH_MAX and an argument of no integer type raise its
// text; a choices value's width is only checked here)
routine SpecWidth(const AValue: int64; const AKind: int64): int64;
begin
  if AKind = ADAM_SPEC_WIDTH_NO_INTEGER then
    raise("Replacement argument isn't a standard signed or unsigned integer type");
  end;
  if (AKind = ADAM_SPEC_WIDTH_SIGNED) and (AValue < 0) then
    raise("An argument index may not have a negative value");
  end;
  // an unsigned value past int64's range has its top bit set: it is past the maximum too
  if (AValue < 0) or (AValue > ADAM_SPEC_WIDTH_MAX) then
    raise("The value of the argument index exceeds its maximum value");
  end;
  return AValue;
end;

// The width the spec ASpec pads to: AWidth when an argument gave one (0 or more), else the
// written one (0: none)
routine DoSpecWidth(const ASpec: ptr to const int64; const AWidth: int64): int64;
begin
  if AWidth >= 0 then
    return AWidth;
  end;
  return ASpec[5];
end;

// The fill AFill (its ASize UTF-8 bytes packed little-endian) written ACount times to the
// print sink ASink, through a buffer written as it fills
routine DoSpecFill(const ASink: ptr to ptr; const AFill: int64; const ASize: int64;
  const ACount: int64);
var
  LBuffer: array[0..255] of uint8;
  LAt: int64;
  LI: int64;
  LJ: int64;
begin
  LAt := 0;
  for LI := 1 to ACount do
    // a fill takes at most 4 bytes: the buffer is written before one could pass its end
    if LAt > 252 then
      SinkText(ASink, addr of LBuffer[0], LAt);
      LAt := 0;
    end;
    for LJ := 0 to ASize - 1 do
      LBuffer[LAt] := uint8((uint64(AFill) shr (8 * LJ)) & 0xFF);
      LAt := LAt + 1;
    end;
  end;
  if LAt > 0 then
    SinkText(ASink, addr of LBuffer[0], LAt);
  end;
end;

// The fill of the spec ASpec written ACount times to the print sink ASink (a space when
// none was written)
routine DoSpecFillOf(const ASink: ptr to ptr; const ASpec: ptr to const int64; const ACount: int64);
begin
  if ASpec[1] = 0 then
    DoSpecFill(ASink, 32, 1, ACount);
  else
    DoSpecFill(ASink, ASpec[0], ASpec[1], ACount);
  end;
end;

// The code point at AText[AAt] of the ACount UTF-8 bytes at AText, read as libc++'s
// __code_point_view<char> reads it (Table 3-7's well-formed sequences, tested after
// decoding); AAt moves past what was read. AValid false for an ill-formed sequence: U+FFFD
// then, AAt past the sequence when its lead byte's length fits and its bytes are
// continuations (an overlong form, a surrogate, past U+10FFFF), else past the one byte
routine DoUtf8Consume(const AText: ptr to const uint8; const ACount: int64; var AAt: int64;
  var AValid: bool): uint32;
var
  LLead: uint32;
  LSize: int64;
  LValue: uint32;
  LI: int64;
begin
  LLead := uint32(AText[AAt]);
  AValid := true;
  if LLead < 0x80 then
    AAt := AAt + 1;
    return LLead;
  end;
  // the sequence's length from the lead byte's leading 1 bits (2 .. 4; any other is none)
  LSize := 0;
  LValue := 0;
  if (LLead & 0xE0) = 0xC0 then
    LSize := 2;
    LValue := LLead & 0x1F;
  end;
  if (LLead & 0xF0) = 0xE0 then
    LSize := 3;
    LValue := LLead & 0x0F;
  end;
  if (LLead & 0xF8) = 0xF0 then
    LSize := 4;
    LValue := LLead & 0x07;
  end;
  AValid := false;
  if (LSize = 0) or (ACount - AAt < LSize) then
    AAt := AAt + 1;
    return 0xFFFD;
  end;
  for LI := 1 to LSize - 1 do
    if (AText[AAt + LI] & 0xC0) <> 0x80 then
      AAt := AAt + 1;
      return 0xFFFD;
    end;
    LValue := (LValue shl 6) | (uint32(AText[AAt + LI]) & 0x3F);
  end;
  AAt := AAt + LSize;
  // an overlong form, a surrogate, a value past the last code point: consumed, ill-formed
  if (LSize = 2) and (LValue < 0x80) then
    return 0xFFFD;
  end;
  if (LSize = 3) and ((LValue < 0x800) or ((LValue >= 0xD800) and (LValue <= 0xDFFF))) then
    return 0xFFFD;
  end;
  if (LSize = 4) and ((LValue < 0x10000) or (LValue > 0x10FFFF)) then
    return 0xFFFD;
  end;
  AValid := true;
  return LValue;
end;

// The rules of libc++'s __extended_grapheme_cluster_break (UAX #29's extended grapheme
// cluster boundaries) in force between two code points: none, GB9c (an indic conjunct),
// GB11 (an emoji zwj sequence), GB12 / GB13 (regional indicator pairs); the GB11 states;
// the GB9c states
const
  ADAM_CLUSTER_RULE_NONE: int64 = 0;
  ADAM_CLUSTER_RULE_INDIC: int64 = 1;
  ADAM_CLUSTER_RULE_EMOJI: int64 = 2;
  ADAM_CLUSTER_RULE_REGIONAL: int64 = 3;
  ADAM_CLUSTER_EMOJI_PICTOGRAPHIC: int64 = 0;
  ADAM_CLUSTER_EMOJI_EXTEND: int64 = 1;
  ADAM_CLUSTER_EMOJI_ZWJ: int64 = 2;
  ADAM_CLUSTER_INDIC_CONSONANT: int64 = 0;
  ADAM_CLUSTER_INDIC_LINKER: int64 = 1;

type
  // Where the cluster rules stand (libc++'s __extended_grapheme_cluster_break): the code
  // point before the next one and its break property (ADAM_UNICODE_GCB_*), the rule in
  // force (ADAM_CLUSTER_RULE_*), the GB11 and the GB9c state
  ClusterBreak = record
    PrevCode: uint32;
    PrevProperty: int64;
    Rule: int64;
    EmojiState: int64;
    IndicState: int64;
  end;

// The cluster rules started at the code point ACode (libc++'s constructor: an emoji, a
// regional indicator or an indic consonant starts its rule)
routine DoClusterStart(var ABreak: ClusterBreak; const ACode: uint32);
begin
  ABreak.PrevCode := ACode;
  ABreak.PrevProperty := GraphemeProperty(ACode);
  ABreak.Rule := ADAM_CLUSTER_RULE_NONE;
  ABreak.EmojiState := ADAM_CLUSTER_EMOJI_PICTOGRAPHIC;
  ABreak.IndicState := ADAM_CLUSTER_INDIC_CONSONANT;
  if ABreak.PrevProperty = ADAM_UNICODE_GCB_EXTENDED_PICTOGRAPHIC then
    ABreak.Rule := ADAM_CLUSTER_RULE_EMOJI;
    return;
  end;
  if ABreak.PrevProperty = ADAM_UNICODE_GCB_REGIONAL_INDICATOR then
    ABreak.Rule := ADAM_CLUSTER_RULE_REGIONAL;
    return;
  end;
  if IndicProperty(ACode) = ADAM_UNICODE_INCB_CONSONANT then
    ABreak.Rule := ADAM_CLUSTER_RULE_INDIC;
  end;
end;

// True when the break property AProperty is a control's: CR, LF, Control (GB4 / GB5)
routine DoClusterControl(const AProperty: int64): bool;
begin
  return (AProperty = ADAM_UNICODE_GCB_CR) or (AProperty = ADAM_UNICODE_GCB_LF) or
    (AProperty = ADAM_UNICODE_GCB_CONTROL);
end;

// True when a cluster breaks before the code point ANext (break property AProperty) with no
// rule in force (libc++'s __evaluate_none: GB3 .. GB999); a GB9c, GB11 or GB12 start sets
// its rule
routine DoClusterNone(var ABreak: ClusterBreak; const ANext: uint32; const AProperty: int64): bool;
var
  LPrev: int64;
begin
  LPrev := ABreak.PrevProperty;
  // GB3: CR LF; GB4 / GB5: around any other control
  if (LPrev = ADAM_UNICODE_GCB_CR) and (AProperty = ADAM_UNICODE_GCB_LF) then
    return false;
  end;
  if DoClusterControl(LPrev) or DoClusterControl(AProperty) then
    return true;
  end;
  // GB6 .. GB8: Hangul syllable sequences
  if (LPrev = ADAM_UNICODE_GCB_L) and ((AProperty = ADAM_UNICODE_GCB_L) or
    (AProperty = ADAM_UNICODE_GCB_V) or (AProperty = ADAM_UNICODE_GCB_LV) or
    (AProperty = ADAM_UNICODE_GCB_LVT)) then
    return false;
  end;
  if ((LPrev = ADAM_UNICODE_GCB_LV) or (LPrev = ADAM_UNICODE_GCB_V)) and
    ((AProperty = ADAM_UNICODE_GCB_V) or (AProperty = ADAM_UNICODE_GCB_T)) then
    return false;
  end;
  if ((LPrev = ADAM_UNICODE_GCB_LVT) or (LPrev = ADAM_UNICODE_GCB_T)) and
    (AProperty = ADAM_UNICODE_GCB_T) then
    return false;
  end;
  // GB9 / GB9a / GB9b: before Extend, ZWJ, SpacingMark; after Prepend
  if (AProperty = ADAM_UNICODE_GCB_EXTEND) or (AProperty = ADAM_UNICODE_GCB_ZWJ) or
    (AProperty = ADAM_UNICODE_GCB_SPACINGMARK) or (LPrev = ADAM_UNICODE_GCB_PREPEND) then
    return false;
  end;
  // GB9c, GB11, GB12 / GB13 start their rule at the code point they break before
  if IndicProperty(ANext) = ADAM_UNICODE_INCB_CONSONANT then
    ABreak.Rule := ADAM_CLUSTER_RULE_INDIC;
    ABreak.IndicState := ADAM_CLUSTER_INDIC_CONSONANT;
    return true;
  end;
  if AProperty = ADAM_UNICODE_GCB_EXTENDED_PICTOGRAPHIC then
    ABreak.Rule := ADAM_CLUSTER_RULE_EMOJI;
    ABreak.EmojiState := ADAM_CLUSTER_EMOJI_PICTOGRAPHIC;
    return true;
  end;
  if AProperty = ADAM_UNICODE_GCB_REGIONAL_INDICATOR then
    ABreak.Rule := ADAM_CLUSTER_RULE_REGIONAL;
  end;
  // GB999
  return true;
end;

// True when a cluster breaks before ANext under GB9c (libc++'s
// __evaluate_GB9c_indic_conjunct_break: a consonant, extends and linkers, a consonant after
// a linker; anything else ends the rule)
routine DoClusterIndic(var ABreak: ClusterBreak; const ANext: uint32; const AProperty: int64): bool;
var
  LIndic: int64;
begin
  LIndic := IndicProperty(ANext);
  if LIndic <> ADAM_UNICODE_INCB_NONE then
    if LIndic = ADAM_UNICODE_INCB_EXTEND then
      return false;
    end;
    if LIndic = ADAM_UNICODE_INCB_LINKER then
      ABreak.IndicState := ADAM_CLUSTER_INDIC_LINKER;
      return false;
    end;
    if (LIndic = ADAM_UNICODE_INCB_CONSONANT) and (ABreak.IndicState = ADAM_CLUSTER_INDIC_LINKER) then
      ABreak.IndicState := ADAM_CLUSTER_INDIC_CONSONANT;
      return false;
    end;
  end;
  ABreak.Rule := ADAM_CLUSTER_RULE_NONE;
  return DoClusterNone(ABreak, ANext, AProperty);
end;

// True when a cluster breaks before ANext under GB11 (libc++'s __evaluate_GB11_emoji: a
// pictograph, its extends, a ZWJ, the next pictograph)
routine DoClusterEmoji(var ABreak: ClusterBreak; const ANext: uint32; const AProperty: int64): bool;
begin
  if ABreak.EmojiState = ADAM_CLUSTER_EMOJI_ZWJ then
    if AProperty = ADAM_UNICODE_GCB_EXTENDED_PICTOGRAPHIC then
      ABreak.EmojiState := ADAM_CLUSTER_EMOJI_PICTOGRAPHIC;
      return false;
    end;
    ABreak.Rule := ADAM_CLUSTER_RULE_NONE;
    return DoClusterNone(ABreak, ANext, AProperty);
  end;
  if AProperty = ADAM_UNICODE_GCB_EXTEND then
    ABreak.EmojiState := ADAM_CLUSTER_EMOJI_EXTEND;
    return false;
  end;
  if AProperty = ADAM_UNICODE_GCB_ZWJ then
    ABreak.EmojiState := ADAM_CLUSTER_EMOJI_ZWJ;
    return false;
  end;
  ABreak.Rule := ADAM_CLUSTER_RULE_NONE;
  return DoClusterNone(ABreak, ANext, AProperty);
end;

// True when a cluster breaks before the code point ANext (libc++'s operator(): the rule in
// force decides); ANext is then the code point before the next one
routine DoClusterBreaks(var ABreak: ClusterBreak; const ANext: uint32): bool;
var
  LProperty: int64;
  LResult: bool;
begin
  LProperty := GraphemeProperty(ANext);
  if ABreak.Rule = ADAM_CLUSTER_RULE_INDIC then
    LResult := DoClusterIndic(ABreak, ANext, LProperty);
  else
    if ABreak.Rule = ADAM_CLUSTER_RULE_EMOJI then
      LResult := DoClusterEmoji(ABreak, ANext, LProperty);
    else
      if ABreak.Rule = ADAM_CLUSTER_RULE_REGIONAL then
        // GB12 / GB13: two regional indicators pair, the rule ends either way
        ABreak.Rule := ADAM_CLUSTER_RULE_NONE;
        if LProperty = ADAM_UNICODE_GCB_REGIONAL_INDICATOR then
          LResult := false;
        else
          LResult := DoClusterNone(ABreak, ANext, LProperty);
        end;
      else
        LResult := DoClusterNone(ABreak, ANext, LProperty);
      end;
    end;
  end;
  ABreak.PrevCode := ANext;
  ABreak.PrevProperty := LProperty;
  return LResult;
end;

// The columns of the grapheme clusters of the ACount UTF-8 bytes at AText from AFrom
// (libc++'s __estimate_column_width_grapheme_clustering): each cluster its first code
// point's estimated width (EstimatedWidth). ADown (a precision) stops before the cluster
// that would pass AMaximum, else (a width) it stops once past AMaximum; ALast the byte
// the counted clusters end at. AFrom is below ACount
routine DoClusterColumns(const AText: ptr to const uint8; const AFrom: int64; const ACount: int64;
  const AMaximum: int64; const ADown: bool; var ALast: int64): int64;
var
  LBreak: ClusterBreak;
  LAt: int64;
  LValid: bool;
  LCode: uint32;
  LPosition: int64;
  LWidth: int64;
  LColumns: int64;
begin
  LColumns := 0;
  ALast := AFrom;
  LAt := AFrom;
  // the first code point starts the rules (libc++'s view constructor reads it)
  DoClusterStart(LBreak, DoUtf8Consume(AText, ACount, LAt, LValid));
  while (ALast <> ACount) and (LColumns <= AMaximum) do
    // one cluster: the code point the rules stand at, then each up to the next break
    LCode := LBreak.PrevCode;
    LPosition := LAt;
    while LAt < ACount do
      if DoClusterBreaks(LBreak, DoUtf8Consume(AText, ACount, LAt, LValid)) then
        leave;
      end;
      LPosition := LAt;
    end;
    LWidth := EstimatedWidth(LCode);
    if ADown and (LColumns + LWidth > AMaximum) then
      return LColumns;
    end;
    LColumns := LColumns + LWidth;
    ALast := LPosition;
  end;
  return LColumns;
end;

// The columns the ACount UTF-8 bytes at AText take, at most AMaximum (libc++'s
// __estimate_column_width; ADown its rounding down, a precision's, else up, a width's,
// which may pass AMaximum by one cluster): ASCII one column a byte, the rest by
// DoClusterColumns; an ASCII byte before a non-ASCII one is left to the clusters (it may
// start one). ALast the byte the counted text ends at (AText's end when it all counts)
routine DoSpecColumns(const AText: ptr to const uint8; const ACount: int64; const AMaximum: int64;
  const ADown: bool; var ALast: int64): int64;
var
  LMaximum: int64;
  LAt: int64;
begin
  ALast := 0;
  if (ACount = 0) or (AMaximum = 0) then
    return 0;
  end;
  LMaximum := AMaximum;
  LAt := 0;
  if AText[0] < 0x80 then
    repeat
      LMaximum := LMaximum - 1;
      LAt := LAt + 1;
      if LAt = ACount then
        ALast := ACount;
        return ACount;
      end;
      if LMaximum = 0 then
        if AText[LAt] < 0x80 then
          ALast := LAt;
          return LAt;
        end;
        leave;
      end;
    until AText[LAt] >= 0x80;
    // the last ASCII byte goes back to the clusters with its column
    LAt := LAt - 1;
    LMaximum := LMaximum + 1;
  end;
  return LAt + DoClusterColumns(AText, LAt, ACount, LMaximum, ADown, ALast);
end;

// The precision the spec ASpec cuts a text to: APrecision when an argument gave one (0 or
// more), else the written one (-1: none)
routine DoSpecPrecision(const ASpec: ptr to const int64; const APrecision: int64): int64;
begin
  if APrecision >= 0 then
    return APrecision;
  end;
  return ASpec[7];
end;

// The ACount bytes of text at AText, ASize columns, written to the print sink ASink in the
// width of the spec ASpec (AWidth: an argument's width, -1 none), the fill before and after
// it as the alignment says (by default after: a text is left aligned); libc++'s __write
routine DoSpecPadded(const ASink: ptr to ptr; const AText: ptr; const ACount: int64;
  const ASize: int64; const ASpec: ptr to const int64; const AWidth: int64);
var
  LFill: int64;
  LBefore: int64;
begin
  LFill := DoSpecWidth(ASpec, AWidth) - ASize;
  if LFill <= 0 then
    SinkText(ASink, AText, ACount);
    return;
  end;
  LBefore := 0;
  if ASpec[2] = ADAM_SPEC_ALIGN_CENTER then
    LBefore := LFill div 2;
  end;
  if ASpec[2] = ADAM_SPEC_ALIGN_RIGHT then
    LBefore := LFill;
  end;
  DoSpecFillOf(ASink, ASpec, LBefore);
  SinkText(ASink, AText, ACount);
  DoSpecFillOf(ASink, ASpec, LFill - LBefore);
end;

// The ACount bytes of text at AText written to the print sink ASink in the width of the
// spec ASpec (AWidth: an argument's width, -1 none) by their display width (libc++'s
// __write_string_no_precision: DoSpecColumns, rounding up)
routine SinkSpecText(const ASink: ptr to ptr; const AText: ptr; const ACount: int64;
  const ASpec: ptr to const int64; const AWidth: int64);
var
  LWidth: int64;
  LLast: int64;
begin
  LWidth := DoSpecWidth(ASpec, AWidth);
  if LWidth = 0 then
    SinkText(ASink, AText, ACount);
    return;
  end;
  DoSpecPadded(ASink, AText, ACount, DoSpecColumns(ptr to const uint8(AText), ACount, LWidth, false, LLast),
    ASpec, AWidth);
end;

// The ACount bytes of text at AText written to the print sink ASink with the spec ASpec
// (AWidth / APrecision: an argument's width / precision, -1 none): with a precision cut to
// the clusters that fit in it (libc++'s __truncate: DoSpecColumns, rounding down), padded
// by the columns kept; else SinkSpecText's (libc++'s __write_string)
routine DoSpecString(const ASink: ptr to ptr; const AText: ptr to const uint8; const ACount: int64;
  const ASpec: ptr to const int64; const AWidth: int64; const APrecision: int64);
var
  LPrecision: int64;
  LLast: int64;
  LSize: int64;
begin
  LPrecision := DoSpecPrecision(ASpec, APrecision);
  if LPrecision < 0 then
    SinkSpecText(ASink, ptr(AText), ACount, ASpec, AWidth);
    return;
  end;
  LSize := DoSpecColumns(AText, ACount, LPrecision, true, LLast);
  DoSpecPadded(ASink, ptr(AText), LLast, LSize, ASpec, AWidth);
end;

// The code AValue written to the print sink ASink after the escape's opening APrefix
// ("\u{" or "\x{"): its shortest lowercase hex, then "}" (libc++'s
// __write_escaped_code_unit)
routine DoEscapeHex(const ASink: ptr to ptr; const APrefix: ptr to const char; const AValue: uint32);
var
  LDigits: array[0..7] of char;
  LAt: int64;
  LRest: uint32;
  LDigit: uint32;
begin
  SinkLiteral(ASink, APrefix);
  LAt := 8;
  LRest := AValue;
  repeat
    LAt := LAt - 1;
    LDigit := LRest & 0xF;
    if LDigit < 10 then
      LDigits[LAt] := char(48 + LDigit);
    else
      LDigits[LAt] := char(87 + LDigit);
    end;
    LRest := LRest shr 4;
  until LRest = 0;
  SinkText(ASink, addr of LDigits[LAt], 8 - LAt);
  SinkLiteral(ASink, ptr to const char("}"));
end;

// True when the well-formed code point ACode is written to the print sink ASink as an
// escape ([format.string.escaped]/2, libc++'s __is_escaped_sequence_written): \t \n \r,
// the quote AApostrophe names (\' in a char's form, \" in a string's; the other one as it
// is), \\, a space as it is; one the escaped output table names (NeedsEscape), or an
// extending one right after an escape (ALastEscaped), as \u{hex}. False: the caller copies
// it as it is
routine DoEscapeWritten(const ASink: ptr to ptr; const ACode: uint32; const ALastEscaped: bool;
  const AApostrophe: bool): bool;
begin
  if ACode = 9 then
    SinkLiteral(ASink, ptr to const char("\\t"));
    return true;
  end;
  if ACode = 10 then
    SinkLiteral(ASink, ptr to const char("\\n"));
    return true;
  end;
  if ACode = 13 then
    SinkLiteral(ASink, ptr to const char("\\r"));
    return true;
  end;
  if ACode = 39 then
    if AApostrophe then
      SinkLiteral(ASink, ptr to const char("\\'"));
    else
      SinkLiteral(ASink, ptr to const char("'"));
    end;
    return true;
  end;
  if ACode = 34 then
    if AApostrophe then
      SinkLiteral(ASink, ptr to const char("\""));
    else
      SinkLiteral(ASink, ptr to const char("\\\""));
    end;
    return true;
  end;
  if ACode = 92 then
    SinkLiteral(ASink, ptr to const char("\\\\"));
    return true;
  end;
  if ACode = 32 then
    SinkLiteral(ASink, ptr to const char(" "));
    return true;
  end;
  if NeedsEscape(ACode) or (ALastEscaped and (GraphemeProperty(ACode) = ADAM_UNICODE_GCB_EXTEND)) then
    DoEscapeHex(ASink, ptr to const char("\\u{"), ACode);
    return true;
  end;
  return false;
end;

// The ACount UTF-8 bytes at AText written to the print sink ASink as the debug form's
// escaped text (libc++'s __escape): each well-formed code point by DoEscapeWritten or as it
// is, each byte of an ill-formed sequence as \x{hex}. AApostrophe: a char's form (\'),
// else a string's (\"). An extending first code point is escaped too (as after an escape)
routine DoSpecEscape(const ASink: ptr to ptr; const AText: ptr to const uint8; const ACount: int64;
  const AApostrophe: bool);
var
  LEscaped: bool;
  LAt: int64;
  LFirst: int64;
  LCode: uint32;
  LValid: bool;
  LI: int64;
begin
  LEscaped := true;
  LAt := 0;
  while LAt < ACount do
    LFirst := LAt;
    LCode := DoUtf8Consume(AText, ACount, LAt, LValid);
    if LValid then
      LEscaped := DoEscapeWritten(ASink, LCode, LEscaped, AApostrophe);
      if not LEscaped then
        SinkText(ASink, ptr(addr of AText[LFirst]), LAt - LFirst);
      end;
    else
      for LI := LFirst to LAt - 1 do
        DoEscapeHex(ASink, ptr to const char("\\x{"), uint32(AText[LI]));
      end;
    end;
  end;
end;

// The ACount UTF-8 bytes at AText written to the print sink ASink as the string formatter
// writes them with the spec ASpec (AWidth / APrecision: an argument's width / precision, -1
// none): the debug form `?` its escaped text in double quotes (written into a string of its
// own first, libc++'s __format_escaped_string), then DoSpecString
routine DoSpecStringOf(const ASink: ptr to ptr; const AText: ptr to const uint8; const ACount: int64;
  const ASpec: ptr to const int64; const AWidth: int64; const APrecision: int64);
var
  LText: ptr;
  LBytes: ptr to uint8;
begin
  if ASpec[6] <> 63 then
    DoSpecString(ASink, AText, ACount, ASpec, AWidth, APrecision);
    return;
  end;
  LText := nil;
  SinkLiteral(addr of LText, ptr to const char("\""));
  DoSpecEscape(addr of LText, AText, ACount, false);
  SinkLiteral(addr of LText, ptr to const char("\""));
  LBytes := ptr to uint8(LText);
  DoSpecString(ASink, ptr to const uint8(addr of LBytes[16]), StrLength(LText), ASpec, AWidth, APrecision);
  StrRelease(LText);
end;

// An integer of magnitude AMagnitude (ANegative: below 0) written to the print sink ASink
// as libc++'s __format_integer writes it: the sign ('-' when negative, else ASpec's '+' or
// ' '), with AAlternate the base's prefix (0b / 0B, 0 before a nonzero octal, 0x / 0X), the
// digits in the base of the type letter ALetter ('b' 'B' 'o' 'x' 'X', any other decimal; X's
// uppercase); then zeros between the prefix and the digits (ADAM_SPEC_ALIGN_ZERO), or the
// fill around it all (by default before: a number is right aligned), to the spec's width
routine DoSpecInteger(const ASink: ptr to ptr; const AMagnitude: uint64; const ANegative: bool;
  const ALetter: int64; const AAlternate: bool; const ASpec: ptr to const int64;
  const AWidth: int64);
var
  LText: array[0..71] of char;
  LBase: uint64;
  LUpper: bool;
  LAt: int64;
  LEnd: int64;
  LStart: int64;
  LRest: uint64;
  LDigit: int64;
  LFill: int64;
  LBefore: int64;
begin
  LBase := 10;
  if (ALetter = 98) or (ALetter = 66) then
    LBase := 2;
  end;
  if ALetter = 111 then
    LBase := 8;
  end;
  if (ALetter = 120) or (ALetter = 88) then
    LBase := 16;
  end;
  LUpper := ALetter = 88;
  // [sign][prefix] at the start of LText
  LAt := 0;
  if ANegative then
    LText[0] := '-';
    LAt := 1;
  else
    if ASpec[3] = ADAM_SPEC_SIGN_PLUS then
      LText[0] := '+';
      LAt := 1;
    end;
    if ASpec[3] = ADAM_SPEC_SIGN_SPACE then
      LText[0] := ' ';
      LAt := 1;
    end;
  end;
  if AAlternate and ((LBase <> 8) or (AMagnitude <> 0)) and (LBase <> 10) then
    LText[LAt] := '0';
    LAt := LAt + 1;
    // binary and hex name their base after the 0, in the type letter's case
    if LBase <> 8 then
      LText[LAt] := char(ALetter);
      LAt := LAt + 1;
    end;
  end;
  // The digits are written from the end of LText back toward the prefix (64 at most)
  LEnd := 72;
  LStart := LEnd;
  LRest := AMagnitude;
  repeat
    LStart := LStart - 1;
    LDigit := int64(LRest mod LBase);
    if LDigit < 10 then
      LText[LStart] := char(48 + LDigit);
    else
      if LUpper then
        LText[LStart] := char(55 + LDigit);
      else
        LText[LStart] := char(87 + LDigit);
      end;
    end;
    LRest := LRest div LBase;
  until LRest = 0;
  LFill := DoSpecWidth(ASpec, AWidth) - LAt - (LEnd - LStart);
  if LFill < 0 then
    LFill := 0;
  end;
  if ASpec[2] = ADAM_SPEC_ALIGN_ZERO then
    if LAt > 0 then
      SinkText(ASink, addr of LText[0], LAt);
    end;
    DoSpecFill(ASink, 48, 1, LFill);
    SinkText(ASink, addr of LText[LStart], LEnd - LStart);
    return;
  end;
  LBefore := LFill;
  if ASpec[2] = ADAM_SPEC_ALIGN_LEFT then
    LBefore := 0;
  end;
  if ASpec[2] = ADAM_SPEC_ALIGN_CENTER then
    LBefore := LFill div 2;
  end;
  DoSpecFillOf(ASink, ASpec, LBefore);
  if LAt > 0 then
    SinkText(ASink, addr of LText[0], LAt);
  end;
  SinkText(ASink, addr of LText[LStart], LEnd - LStart);
  DoSpecFillOf(ASink, ASpec, LFill - LBefore);
end;

// print's form of an integer with the spec ASpec (AWidth: an argument's width, -1 none) to
// the print sink ASink: AValue's bits, signed unless AUnsigned; `c` the char of that code (a
// value outside char's range, -128 .. 127 signed, 0 .. 127 unsigned, raises libc++'s text),
// a text in the width; any other type letter DoSpecInteger's
routine SinkSpecInt(const ASink: ptr to ptr; const AValue: int64; const AUnsigned: bool;
  const ASpec: ptr to const int64; const AWidth: int64);
var
  LByte: array[0..0] of char;
  LOutside: bool;
begin
  if ASpec[6] = 99 then
    if AUnsigned then
      LOutside := (AValue < 0) or (AValue > 127);
    else
      LOutside := (AValue < -128) or (AValue > 127);
    end;
    if LOutside then
      raise("Integral value outside the range of the char type");
    end;
    LByte[0] := char(AValue & 0xFF);
    SinkSpecText(ASink, addr of LByte[0], 1, ASpec, AWidth);
    return;
  end;
  if AUnsigned or (AValue >= 0) then
    DoSpecInteger(ASink, uint64(AValue), false, ASpec[6], ASpec[4] <> 0, ASpec, AWidth);
  else
    // the magnitude is taken as uint64 so the most negative int64 has one too
    DoSpecInteger(ASink, uint64(0) - uint64(AValue), true, ASpec[6], ASpec[4] <> 0, ASpec,
      AWidth);
  end;
end;

// print's form of a bool with the spec ASpec (AWidth: an argument's width, -1 none) to the
// print sink ASink: no type letter or `s` its text ("true" / "false") in the width, any
// other its number (1 / 0) by SinkSpecInt
routine SinkSpecBool(const ASink: ptr to ptr; const AValue: bool; const ASpec: ptr to const int64;
  const AWidth: int64);
var
  LNumber: int64;
begin
  if (ASpec[6] = 0) or (ASpec[6] = 115) then
    if AValue then
      SinkSpecText(ASink, ptr(ptr to const char("true")), 4, ASpec, AWidth);
    else
      SinkSpecText(ASink, ptr(ptr to const char("false")), 5, ASpec, AWidth);
    end;
    return;
  end;
  LNumber := 0;
  if AValue then
    LNumber := 1;
  end;
  SinkSpecInt(ASink, LNumber, true, ASpec, AWidth);
end;

// print's form of a char with the spec ASpec (AWidth: an argument's width, -1 none) to the
// print sink ASink: no type letter or `c` its byte in the width; the debug form `?` its
// escaped byte in apostrophes (written into a string of its own first), padded by its
// bytes (libc++'s __format_escaped_char); any other its code as an unsigned number
// (libc++'s: a char as an integer is its unsigned value) by SinkSpecInt
routine SinkSpecChar(const ASink: ptr to ptr; const AValue: char; const ASpec: ptr to const int64;
  const AWidth: int64);
var
  LByte: array[0..0] of char;
  LText: ptr;
  LBytes: ptr to uint8;
begin
  LByte[0] := AValue;
  if (ASpec[6] = 0) or (ASpec[6] = 99) then
    SinkSpecText(ASink, addr of LByte[0], 1, ASpec, AWidth);
    return;
  end;
  if ASpec[6] = 63 then
    LText := nil;
    SinkLiteral(addr of LText, ptr to const char("'"));
    DoSpecEscape(addr of LText, ptr to const uint8(addr of LByte[0]), 1, true);
    SinkLiteral(addr of LText, ptr to const char("'"));
    LBytes := ptr to uint8(LText);
    DoSpecPadded(ASink, addr of LBytes[16], StrLength(LText), StrLength(LText), ASpec, AWidth);
    StrRelease(LText);
    return;
  end;
  SinkSpecInt(ASink, int64(uint8(AValue)), true, ASpec, AWidth);
end;

// print's form of a pointer with the spec ASpec (AWidth: an argument's width, -1 none) to
// the print sink ASink: its address in hex after 0x (`P`: uppercase, after 0X), as libc++'s
// pointer formatter writes it (DoSpecInteger, the prefix always)
routine SinkSpecAddress(const ASink: ptr to ptr; const AValue: ptr; const ASpec: ptr to const int64;
  const AWidth: int64);
begin
  if ASpec[6] = 80 then
    DoSpecInteger(ASink, uint64(AValue), false, 88, true, ASpec, AWidth);
  else
    DoSpecInteger(ASink, uint64(AValue), false, 120, true, ASpec, AWidth);
  end;
end;

// print's form of a string with the spec ASpec (AWidth / APrecision: an argument's width /
// precision, -1 none) to the print sink ASink: its bytes by the string formatter
// (DoSpecStringOf; nil, the empty string, has none)
routine SinkSpecStr(const ASink: ptr to ptr; const AText: ptr; const ASpec: ptr to const int64;
  const AWidth: int64; const APrecision: int64);
var
  LBytes: ptr to uint8;
begin
  if AText = nil then
    DoSpecStringOf(ASink, nil, 0, ASpec, AWidth, APrecision);
    return;
  end;
  LBytes := ptr to uint8(AText);
  DoSpecStringOf(ASink, ptr to const uint8(addr of LBytes[16]), StrLength(AText), ASpec, AWidth,
    APrecision);
end;

// The string AText (a scratch string a text form was written into) written to the print
// sink ASink by SinkSpecStr with the spec ASpec, then released: every text form is its
// UTF-8 text to the string formatter, as std::format sees it
routine DoSpecScratch(const ASink: ptr to ptr; const AText: ptr; const ASpec: ptr to const int64;
  const AWidth: int64; const APrecision: int64);
begin
  SinkSpecStr(ASink, AText, ASpec, AWidth, APrecision);
  StrRelease(AText);
end;

// print's form of a wstring with the spec ASpec (AWidth / APrecision: an argument's width /
// precision, -1 none) to the print sink ASink: its UTF-8 text (SinkWideText's: an unpaired
// surrogate U+FFFD) by the string formatter
routine SinkSpecWideText(const ASink: ptr to ptr; const AText: ptr; const ASpec: ptr to const int64;
  const AWidth: int64; const APrecision: int64);
var
  LText: ptr;
begin
  LText := nil;
  SinkWideText(addr of LText, AText);
  DoSpecScratch(ASink, LText, ASpec, AWidth, APrecision);
end;

// print's form of a wchar with the spec ASpec (AWidth / APrecision: an argument's width /
// precision, -1 none) to the print sink ASink: its UTF-8 text (SinkWideChar's: a surrogate
// alone U+FFFD) by the string formatter, the debug form in double quotes as std::format
// formats a wchar converted to UTF-8 text
routine SinkSpecWideChar(const ASink: ptr to ptr; const AValue: wchar; const ASpec: ptr to const int64;
  const AWidth: int64; const APrecision: int64);
var
  LText: ptr;
begin
  LText := nil;
  SinkWideChar(addr of LText, AValue);
  DoSpecScratch(ASink, LText, ASpec, AWidth, APrecision);
end;

// print's form of a ptr to char with the spec ASpec (AWidth / APrecision: an argument's
// width / precision, -1 none) to the print sink ASink: SinkCText's text (nil "nil") by the
// string formatter
routine SinkSpecCText(const ASink: ptr to ptr; const AText: ptr to const char;
  const ASpec: ptr to const int64; const AWidth: int64; const APrecision: int64);
var
  LText: ptr;
begin
  LText := nil;
  SinkCText(addr of LText, AText);
  DoSpecScratch(ASink, LText, ASpec, AWidth, APrecision);
end;

// print's form of a ptr to wchar with the spec ASpec (AWidth / APrecision: an argument's
// width / precision, -1 none) to the print sink ASink: SinkWideCText's UTF-8 text (nil
// "nil") by the string formatter
routine SinkSpecWideCText(const ASink: ptr to ptr; const AText: ptr to const wchar;
  const ASpec: ptr to const int64; const AWidth: int64; const APrecision: int64);
var
  LText: ptr;
begin
  LText := nil;
  SinkWideCText(addr of LText, AText);
  DoSpecScratch(ASink, LText, ASpec, AWidth, APrecision);
end;

// print's form of a choices value with the spec ASpec (AWidth / APrecision: an argument's
// width / precision, -1 none) to the print sink ASink: SinkChoice's text (written into a
// string of its own first) by the string formatter
routine SinkSpecChoice(const ASink: ptr to ptr; const ANumber: int64; const ATable: ptr to const int64;
  const ASpec: ptr to const int64; const AWidth: int64; const APrecision: int64);
var
  LText: ptr;
begin
  LText := nil;
  SinkChoice(addr of LText, ANumber, ATable);
  DoSpecScratch(ASink, LText, ASpec, AWidth, APrecision);
end;

// A wchar element of a range that writes no type and no element spec (M3.8f6), to the print
// sink ASink in the debug form PaskalCPP's wchar formatter takes there: its UTF-8 text
// (SinkWideChar's: a surrogate alone U+FFFD) escaped as a char's, in apostrophes (`?`
// itself quotes a wchar as a string: SinkSpecWideChar)
routine SinkDebugWideChar(const ASink: ptr to ptr; const AValue: wchar);
var
  LText: ptr;
  LBytes: ptr to uint8;
begin
  LText := nil;
  SinkWideChar(addr of LText, AValue);
  LBytes := ptr to uint8(LText);
  SinkLiteral(ASink, ptr to const char("'"));
  DoSpecEscape(ASink, ptr to const uint8(addr of LBytes[16]), StrLength(LText), true);
  SinkLiteral(ASink, ptr to const char("'"));
  StrRelease(LText);
end;

// A ptr to char element of a range that writes no type and no element spec (M3.8f6), to the
// print sink ASink in the debug form PaskalCPP's C text formatter takes there: nil as
// `nil` (SinkCText's text, not quoted), any other its text as `?` writes it (SinkSpecCText
// with the debug spec ASpec)
routine SinkDebugCText(const ASink: ptr to ptr; const AText: ptr to const char;
  const ASpec: ptr to const int64);
begin
  if AText = nil then
    SinkCText(ASink, nil);
    return;
  end;
  SinkSpecCText(ASink, AText, ASpec, -1, -1);
end;

// A ptr to wchar element of a range that writes no type and no element spec (M3.8f6), to
// the print sink ASink in the debug form PaskalCPP's C text formatter takes there: nil as
// `nil` (SinkWideCText's text, not quoted), any other its UTF-8 text as `?` writes it
// (SinkSpecWideCText with the debug spec ASpec)
routine SinkDebugWideCText(const ASink: ptr to ptr; const AText: ptr to const wchar;
  const ASpec: ptr to const int64);
begin
  if AText = nil then
    SinkWideCText(ASink, nil);
    return;
  end;
  SinkSpecWideCText(ASink, AText, ASpec, -1, -1);
end;

// The integer AValue in decimal ("-" first when negative) written into ABuffer at AAt; AAt
// moves past it
routine DoFloatPutInt(const ABuffer: ptr to char; var AAt: int64; const AValue: int64);
var
  LDigits: array[0..19] of char;
  LCount: int64;
  LRest: int64;
begin
  LRest := AValue;
  if LRest < 0 then
    ABuffer[AAt] := '-';
    AAt := AAt + 1;
    LRest := -LRest;
  end;
  // The digits come out last first; they are written back in order
  LCount := 0;
  repeat
    LDigits[LCount] := char(48 + LRest mod 10);
    LCount := LCount + 1;
    LRest := LRest div 10;
  until LRest = 0;
  while LCount > 0 do
    LCount := LCount - 1;
    ABuffer[AAt] := LDigits[LCount];
    AAt := AAt + 1;
  end;
end;

// Whether the ACount digits at ADigits, the decimal point at APoint (0.D1D2.. times ten to
// APoint), read back as the float whose bits (the sign cleared) are ABits: a float32 when
// AShort (read straight to float32), else a float64
routine DoFloatReadsBack(const ADigits: ptr to const char; const ACount: int64; const APoint: int64;
  const ABits: uint64; const AShort: bool): bool;
var
  LText: array[0..39] of char;
  LAt: int64;
  LI: int64;
  LValue64: float64;
  LValue32: float32;
  LWords64: ptr to const uint64;
  LWords32: ptr to const uint32;
begin
  // The text is the digits as one integer scaled by a power of ten: D1D2..Dn "e" (APoint - n)
  for LI := 0 to ACount - 1 do
    LText[LI] := ADigits[LI];
  end;
  LAt := ACount;
  LText[LAt] := 'e';
  LAt := LAt + 1;
  DoFloatPutInt(addr of LText[0], LAt, APoint - ACount);
  LText[LAt] := '\0';
  if AShort then
    LValue32 := PlatformParseFloat32(addr of LText[0]);
    LWords32 := ptr to const uint32(addr of LValue32);
    return uint64(LWords32[0]) = ABits;
  end;
  LValue64 := PlatformParseFloat64(addr of LText[0]);
  LWords64 := ptr to const uint64(addr of LValue64);
  return LWords64[0] = ABits;
end;

// The ACount digits at ADigits (0.D1D2.. times ten to APoint) moved one unit up in their
// last place: a carry out of the first digit makes them 1 0 0 .. with APoint one higher
routine DoFloatDigitsUp(const ADigits: ptr to char; const ACount: int64; var APoint: int64);
var
  LAt: int64;
begin
  LAt := ACount - 1;
  while (LAt >= 0) and (ADigits[LAt] = '9') do
    ADigits[LAt] := '0';
    LAt := LAt - 1;
  end;
  if LAt < 0 then
    ADigits[0] := '1';
    APoint := APoint + 1;
    return;
  end;
  ADigits[LAt] := char(int64(ADigits[LAt]) + 1);
end;

// The exponent AExponent written into AText at AAt as std::to_chars writes a decimal one:
// "e", its sign, then two digits at least ("e+05", "e-123"); AAt moves past it
routine DoFloatPutExponent(const AText: ptr to char; var AAt: int64; const AExponent: int64);
var
  LMagnitude: int64;
begin
  AText[AAt] := 'e';
  AAt := AAt + 1;
  LMagnitude := AExponent;
  if LMagnitude < 0 then
    AText[AAt] := '-';
    LMagnitude := -LMagnitude;
  else
    AText[AAt] := '+';
  end;
  AAt := AAt + 1;
  if LMagnitude < 10 then
    AText[AAt] := '0';
    AAt := AAt + 1;
  end;
  DoFloatPutInt(AText, AAt, LMagnitude);
end;

// The digits D1..Dn at ADigits (D1 not '0', Dn not '0' unless n = 1) of the value
// D1.D2..Dn times ten to AExponent, written fixed ("1500", "1.5", "0.015") or scientific
// ("1.5e+16", "1e-05": two exponent digits at least), whichever is shorter, fixed on a tie:
// the choice std::to_chars makes for its shortest form; into AText at AAt (23 bytes at
// most), AAt moved past it
routine DoFloatShortText(const ADigits: ptr to const char; const ACount: int64;
  const AExponent: int64; const AText: ptr to char; var AAt: int64);
var
  LFixed: int64;
  LScientific: int64;
  LMagnitude: int64;
  LI: int64;
begin
  // The fixed text's length: the digits padded with zeros up to the point, the digits with
  // the point among them, or "0." and zeros before the digits
  if AExponent >= 0 then
    if ACount <= AExponent + 1 then
      LFixed := AExponent + 1;
    else
      LFixed := ACount + 1;
    end;
  else
    LFixed := ACount + 1 - AExponent;
  end;
  // The scientific text's length: the digits, the point when there is more than one digit,
  // "e", the sign and the exponent's digits (two at least, three past 99)
  LMagnitude := AExponent;
  if LMagnitude < 0 then
    LMagnitude := -LMagnitude;
  end;
  LScientific := ACount + 4;
  if ACount > 1 then
    LScientific := LScientific + 1;
  end;
  if LMagnitude >= 100 then
    LScientific := LScientific + 1;
  end;
  if LFixed <= LScientific then
    if AExponent >= 0 then
      for LI := 0 to AExponent do
        if LI < ACount then
          AText[AAt] := ADigits[LI];
        else
          AText[AAt] := '0';
        end;
        AAt := AAt + 1;
      end;
      if ACount > AExponent + 1 then
        AText[AAt] := '.';
        AAt := AAt + 1;
        for LI := AExponent + 1 to ACount - 1 do
          AText[AAt] := ADigits[LI];
          AAt := AAt + 1;
        end;
      end;
    else
      AText[AAt] := '0';
      AText[AAt + 1] := '.';
      AAt := AAt + 2;
      for LI := 2 to -AExponent do
        AText[AAt] := '0';
        AAt := AAt + 1;
      end;
      for LI := 0 to ACount - 1 do
        AText[AAt] := ADigits[LI];
        AAt := AAt + 1;
      end;
    end;
    return;
  end;
  AText[AAt] := ADigits[0];
  AAt := AAt + 1;
  if ACount > 1 then
    AText[AAt] := '.';
    AAt := AAt + 1;
    for LI := 1 to ACount - 1 do
      AText[AAt] := ADigits[LI];
      AAt := AAt + 1;
    end;
  end;
  DoFloatPutExponent(AText, AAt, AExponent);
end;

// A finite float, not 0, written as the fewest digits that read back as the same float
// (std::format's shortest round trip): AValue is the value (the digits are its
// magnitude's), ABits its magnitude's bits, AShort a float32 widened. Per count of digits,
// the nearest decimal of that many digits is tried, then the next one up; a float64 reads
// back from 17 digits at most, a float32 from 9, so the last count always does; into AText
// at AAt (DoFloatShortText), AAt moved past it
routine DoFloatShortest(const AValue: float64; const ABits: uint64; const AShort: bool;
  const AText: ptr to char; var AAt: int64);
var
  LDigits: array[0..31] of char;
  LMost: int64;
  LCount: int64;
  LPoint: int32;
  LPlace: int64;
  LFound: bool;
begin
  LMost := 17;
  if AShort then
    LMost := 9;
  end;
  LCount := 0;
  LPlace := 0;
  LFound := false;
  while (not LFound) and (LCount < LMost) do
    LCount := LCount + 1;
    if not PlatformFloatDigits(AValue, int32(LCount), addr of LDigits[0], 32, LPoint) then
      raise("print: the C runtime gave no digits for a float");
    end;
    LPlace := int64(LPoint);
    LFound := DoFloatReadsBack(addr of LDigits[0], LCount, LPlace, ABits, AShort);
    if not LFound then
      // The nearest decimal can miss where the next one up does not: a power of two's gap
      // below is half its gap above
      DoFloatDigitsUp(addr of LDigits[0], LCount, LPlace);
      LFound := DoFloatReadsBack(addr of LDigits[0], LCount, LPlace, ABits, AShort);
    end;
  end;
  // Zeros at the end say nothing (a step up that carried leaves them)
  while (LCount > 1) and (LDigits[LCount - 1] = '0') do
    LCount := LCount - 1;
  end;
  DoFloatShortText(addr of LDigits[0], LCount, LPlace - 1, AText, AAt);
end;

// A finite float, not 0, in its shortest round-trip form (DoFloatShortest: AValue, ABits,
// AShort as there) to the print sink ASink
routine DoWriteFloat(const ASink: ptr to ptr; const AValue: float64; const ABits: uint64;
  const AShort: bool);
var
  LText: array[0..39] of char;
  LAt: int64;
begin
  LAt := 0;
  DoFloatShortest(AValue, ABits, AShort, addr of LText[0], LAt);
  SinkText(ASink, addr of LText[0], LAt);
end;

// print's form of a float64: "inf" or "nan", "0", else the fewest digits that read back as
// the same value (DoWriteFloat); a "-" first whenever the sign bit is set ("-0", "-inf",
// "-nan"), as std::format writes them; to the print sink ASink
routine SinkFloat64(const ASink: ptr to ptr; const AValue: float64);
var
  LWords: ptr to const uint64;
  LBits: uint64;
  LMagnitude: uint64;
begin
  LWords := ptr to const uint64(addr of AValue);
  LBits := LWords[0];
  LMagnitude := LBits & 0x7FFFFFFFFFFFFFFF;
  if (LBits shr 63) <> 0 then
    SinkLiteral(ASink, ptr to const char("-"));
  end;
  // An exponent of all ones: an infinity when the fraction is 0, else a NaN
  if LMagnitude >= 0x7FF0000000000000 then
    if LMagnitude = 0x7FF0000000000000 then
      SinkLiteral(ASink, ptr to const char("inf"));
    else
      SinkLiteral(ASink, ptr to const char("nan"));
    end;
    return;
  end;
  if LMagnitude = 0 then
    SinkLiteral(ASink, ptr to const char("0"));
    return;
  end;
  DoWriteFloat(ASink, AValue, LMagnitude, false);
end;

// print's form of a float32, as SinkFloat64's (its digits are the fewest that read back
// as the same float32), to the print sink ASink
routine SinkFloat32(const ASink: ptr to ptr; const AValue: float32);
var
  LWords: ptr to const uint32;
  LBits: uint32;
  LMagnitude: uint32;
begin
  LWords := ptr to const uint32(addr of AValue);
  LBits := LWords[0];
  LMagnitude := LBits & 0x7FFFFFFF;
  if (LBits shr 31) <> 0 then
    SinkLiteral(ASink, ptr to const char("-"));
  end;
  // An exponent of all ones: an infinity when the fraction is 0, else a NaN
  if LMagnitude >= 0x7F800000 then
    if LMagnitude = 0x7F800000 then
      SinkLiteral(ASink, ptr to const char("inf"));
    else
      SinkLiteral(ASink, ptr to const char("nan"));
    end;
    return;
  end;
  if LMagnitude = 0 then
    SinkLiteral(ASink, ptr to const char("0"));
    return;
  end;
  DoWriteFloat(ASink, float64(AValue), uint64(LMagnitude), true);
end;

// The float spec forms (M3.8f5; libc++'s formatter_floating_point.h over std::to_chars):
// e E f F g G with a precision work from the float's exact decimal expansion, rounded to
// nearest with a tie to even as to_chars rounds; a A from its bits
const
  // The most significant digits worked out: a float64 has 767 at most, every one past them
  // is 0 (written as trailing zeros, libc++'s __num_trailing_zeros)
  ADAM_SPEC_FLOAT_SIGNIFICANT: int64 = 800;
  // The most digits after the point worked out: a float64's fraction ends within 1074
  // (libc++'s __traits<double>::__max_fractional; a float32's within 149)
  ADAM_SPEC_FLOAT_FRACTION: int64 = 1074;
  // The decimal base the integral part is cut into (9 digits a word)
  ADAM_SPEC_FLOAT_CHUNK: uint32 = 1000000000;

type
  // A finite float's exact decimal expansion (DoFloatExpand), read digit by digit from the
  // first (DoFloatNextDigit): the integral part's digits, most significant first (none when
  // it is 0), Taken of them read; then the fraction, the big number Fraction (FractionCount
  // uint32 words, least significant first, no zero word on top) over 2 to Shift
  FloatExpansion = record
    Integral: array[0..319] of char;
    IntegralCount: int64;
    Taken: int64;
    Fraction: array[0..39] of uint32;
    FractionCount: int64;
    Shift: int64;
  end;

// The big number at AWords (ACount uint32 words, least significant first) without the zero
// words on top
routine DoBigTrim(const AWords: ptr to uint32; var ACount: int64);
begin
  while (ACount > 0) and (AWords[ACount - 1] = 0) do
    ACount := ACount - 1;
  end;
end;

// The big number at AWords set to AValue times 2 to AShift (ACount its words after)
routine DoBigSet(const AWords: ptr to uint32; var ACount: int64; const AValue: uint64;
  const AShift: int64);
var
  LWord: int64;
  LBit: int64;
  LLow: uint64;
  LHigh: uint64;
  LI: int64;
begin
  LWord := AShift div 32;
  LBit := AShift mod 32;
  for LI := 0 to LWord - 1 do
    AWords[LI] := 0;
  end;
  // AValue's 64 bits moved up LBit (under 32) span three words
  LLow := AValue shl LBit;
  LHigh := 0;
  if LBit > 0 then
    LHigh := AValue shr (64 - LBit);
  end;
  AWords[LWord] := uint32(LLow & 0xFFFFFFFF);
  AWords[LWord + 1] := uint32(LLow shr 32);
  AWords[LWord + 2] := uint32(LHigh);
  ACount := LWord + 3;
  DoBigTrim(AWords, ACount);
end;

// The big number at AWords (ACount words) multiplied by AFactor; a carry adds a word
routine DoBigMulSmall(const AWords: ptr to uint32; var ACount: int64; const AFactor: uint32);
var
  LCarry: uint64;
  LProduct: uint64;
  LI: int64;
begin
  LCarry := 0;
  for LI := 0 to ACount - 1 do
    LProduct := uint64(AWords[LI]) * uint64(AFactor) + LCarry;
    AWords[LI] := uint32(LProduct & 0xFFFFFFFF);
    LCarry := LProduct shr 32;
  end;
  if LCarry <> 0 then
    AWords[ACount] := uint32(LCarry);
    ACount := ACount + 1;
  end;
end;

// The big number at AWords (ACount words) divided by ADivisor (not 0), from the top word
// down; the remainder
routine DoBigDivSmall(const AWords: ptr to uint32; var ACount: int64; const ADivisor: uint32): uint32;
var
  LRest: uint64;
  LCurrent: uint64;
  LI: int64;
begin
  LRest := 0;
  LI := ACount - 1;
  while LI >= 0 do
    LCurrent := (LRest shl 32) | uint64(AWords[LI]);
    AWords[LI] := uint32(LCurrent div uint64(ADivisor));
    LRest := LCurrent mod uint64(ADivisor);
    LI := LI - 1;
  end;
  DoBigTrim(AWords, ACount);
  return uint32(LRest);
end;

// The bits of the big number at AWords (ACount words) from bit AShift up, taken off it
// (it keeps the bits below AShift): the caller knows they are fewer than 32
routine DoBigTakeAbove(const AWords: ptr to uint32; var ACount: int64; const AShift: int64): uint32;
var
  LWord: int64;
  LBit: int64;
  LValue: uint64;
begin
  LWord := AShift div 32;
  LBit := AShift mod 32;
  if LWord >= ACount then
    return 0;
  end;
  LValue := uint64(AWords[LWord]) shr LBit;
  if (LBit > 0) and (LWord + 1 < ACount) then
    LValue := LValue | (uint64(AWords[LWord + 1]) shl (32 - LBit));
  end;
  AWords[LWord] := uint32(uint64(AWords[LWord]) & ((uint64(1) shl LBit) - 1));
  ACount := LWord + 1;
  DoBigTrim(AWords, ACount);
  return uint32(LValue & 0xFFFFFFFF);
end;

// The 9-digit word AValue written into AText at AAt: all 9 digits when AFull (a word
// below the top one), else without leading zeros; AAt moves past them
routine DoFloatPutChunk(const AText: ptr to char; var AAt: int64; const AValue: uint32;
  const AFull: bool);
var
  LDigits: array[0..8] of char;
  LCount: int64;
  LRest: int64;
begin
  LCount := 0;
  LRest := int64(AValue);
  repeat
    LDigits[LCount] := char(48 + LRest mod 10);
    LCount := LCount + 1;
    LRest := LRest div 10;
  until LRest = 0;
  if AFull then
    while LCount < 9 do
      LDigits[LCount] := '0';
      LCount := LCount + 1;
    end;
  end;
  while LCount > 0 do
    LCount := LCount - 1;
    AText[AAt] := LDigits[LCount];
    AAt := AAt + 1;
  end;
end;

// AExpansion set to the exact decimal expansion of the finite float64 whose magnitude's
// bits are ABits: the value is its mantissa times 2 to its power; a power below 0 splits
// it into the integral part and the fraction over 2 to the power's magnitude
routine DoFloatExpand(var AExpansion: FloatExpansion; const ABits: uint64);
var
  LWords: array[0..39] of uint32;
  LCount: int64;
  LChunks: array[0..39] of uint32;
  LChunkCount: int64;
  LBiased: int64;
  LMantissa: uint64;
  LPower: int64;
  LWhole: uint64;
  LPart: uint64;
  LI: int64;
begin
  LBiased := int64(ABits shr 52);
  LMantissa := ABits & 0xFFFFFFFFFFFFF;
  if LBiased = 0 then
    LPower := -1074;
  else
    LMantissa := LMantissa | 0x10000000000000;
    LPower := LBiased - 1075;
  end;
  AExpansion.IntegralCount := 0;
  AExpansion.Taken := 0;
  AExpansion.FractionCount := 0;
  AExpansion.Shift := 0;
  if LPower >= 0 then
    DoBigSet(addr of LWords[0], LCount, LMantissa, LPower);
  else
    AExpansion.Shift := -LPower;
    LWhole := 0;
    LPart := LMantissa;
    if AExpansion.Shift < 64 then
      LWhole := LMantissa shr AExpansion.Shift;
      LPart := LMantissa - (LWhole shl AExpansion.Shift);
    end;
    DoBigSet(addr of LWords[0], LCount, LWhole, 0);
    DoBigSet(addr of AExpansion.Fraction[0], AExpansion.FractionCount, LPart, 0);
  end;
  // The integral part's digits: cut into 9-digit words from the bottom, written top first
  LChunkCount := 0;
  while LCount > 0 do
    LChunks[LChunkCount] := DoBigDivSmall(addr of LWords[0], LCount, ADAM_SPEC_FLOAT_CHUNK);
    LChunkCount := LChunkCount + 1;
  end;
  LI := LChunkCount - 1;
  while LI >= 0 do
    DoFloatPutChunk(addr of AExpansion.Integral[0], AExpansion.IntegralCount, LChunks[LI],
      LI < LChunkCount - 1);
    LI := LI - 1;
  end;
end;

// The next digit of the expansion AExpansion: an integral digit while one is left, then a
// fraction digit (the fraction times 10, the bits at its shift and above); 0 past the end
routine DoFloatNextDigit(var AExpansion: FloatExpansion): int64;
var
  LDigit: int64;
begin
  if AExpansion.Taken < AExpansion.IntegralCount then
    LDigit := int64(AExpansion.Integral[AExpansion.Taken]) - 48;
    AExpansion.Taken := AExpansion.Taken + 1;
    return LDigit;
  end;
  if AExpansion.FractionCount = 0 then
    return 0;
  end;
  DoBigMulSmall(addr of AExpansion.Fraction[0], AExpansion.FractionCount, 10);
  return int64(DoBigTakeAbove(addr of AExpansion.Fraction[0], AExpansion.FractionCount,
    AExpansion.Shift));
end;

// True when the digits of AExpansion not read yet hold one that is not 0
routine DoFloatRestNonzero(const AExpansion: FloatExpansion): bool;
var
  LI: int64;
begin
  for LI := AExpansion.Taken to AExpansion.IntegralCount - 1 do
    if AExpansion.Integral[LI] <> '0' then
      return true;
    end;
  end;
  return AExpansion.FractionCount > 0;
end;

// True when the digits read from AExpansion, the last one ALast, round up: the next digit
// above 5, or 5 with a digit not 0 after it, or 5 exactly with an odd last digit (a tie to
// even: to_chars' rounding of the exact value)
routine DoFloatRoundsUp(var AExpansion: FloatExpansion; const ALast: int64): bool;
var
  LNext: int64;
begin
  LNext := DoFloatNextDigit(AExpansion);
  if LNext <> 5 then
    return LNext > 5;
  end;
  if DoFloatRestNonzero(AExpansion) then
    return true;
  end;
  return (ALast mod 2) = 1;
end;

// The digits in AText[AStart] .. AText[AEnd - 1] (a '.' among them skipped) moved one unit
// up in their last place; true when it carried out of the first (every digit now '0')
routine DoFloatCarry(const AText: ptr to char; const AStart: int64; const AEnd: int64): bool;
var
  LAt: int64;
begin
  LAt := AEnd - 1;
  while LAt >= AStart do
    if AText[LAt] <> '.' then
      if AText[LAt] <> '9' then
        AText[LAt] := char(int64(AText[LAt]) + 1);
        return false;
      end;
      AText[LAt] := '0';
    end;
    LAt := LAt - 1;
  end;
  return true;
end;

// The first ACount significant digits of AExpansion (ACount at least 1), rounded, into
// ADigits; AExponent the power of ten of the first (the rounded value is D1.D2.. times ten
// to it; 0 for the value 0, whose digits are all '0')
routine DoFloatSignificant(var AExpansion: FloatExpansion; const ACount: int64;
  const ADigits: ptr to char; var AExponent: int64);
var
  LFirst: int64;
  LI: int64;
begin
  if (AExpansion.IntegralCount = 0) and (AExpansion.FractionCount = 0) then
    for LI := 0 to ACount - 1 do
      ADigits[LI] := '0';
    end;
    AExponent := 0;
    return;
  end;
  // The first digit that is not 0: the integral part's first, else after the fraction's zeros
  if AExpansion.IntegralCount > 0 then
    AExponent := AExpansion.IntegralCount - 1;
    LFirst := DoFloatNextDigit(AExpansion);
  else
    AExponent := 0;
    repeat
      LFirst := DoFloatNextDigit(AExpansion);
      AExponent := AExponent - 1;
    until LFirst <> 0;
  end;
  ADigits[0] := char(48 + LFirst);
  for LI := 1 to ACount - 1 do
    ADigits[LI] := char(48 + DoFloatNextDigit(AExpansion));
  end;
  if DoFloatRoundsUp(AExpansion, int64(ADigits[ACount - 1]) - 48) then
    // 9.99.. up is 10.0..: one digit 1 and the rest 0, a power of ten higher
    if DoFloatCarry(ADigits, 0, ACount) then
      ADigits[0] := '1';
      AExponent := AExponent + 1;
    end;
  end;
end;

// AExpansion fixed with APrecision digits after the point (to_chars' chars_format::fixed)
// into AText at AAt, AAt moved past it; the digits past ADAM_SPEC_FLOAT_FRACTION (all 0)
// counted in ATrailing instead
routine DoFloatFixed(var AExpansion: FloatExpansion; const APrecision: int64;
  const AText: ptr to char; var AAt: int64; var ATrailing: int64);
var
  LStart: int64;
  LCount: int64;
  LI: int64;
begin
  LStart := AAt;
  if AExpansion.IntegralCount = 0 then
    AText[AAt] := '0';
    AAt := AAt + 1;
  end;
  while AExpansion.Taken < AExpansion.IntegralCount do
    AText[AAt] := char(48 + DoFloatNextDigit(AExpansion));
    AAt := AAt + 1;
  end;
  LCount := APrecision;
  if LCount > ADAM_SPEC_FLOAT_FRACTION then
    ATrailing := LCount - ADAM_SPEC_FLOAT_FRACTION;
    LCount := ADAM_SPEC_FLOAT_FRACTION;
  end;
  if LCount > 0 then
    AText[AAt] := '.';
    AAt := AAt + 1;
    for LI := 1 to LCount do
      AText[AAt] := char(48 + DoFloatNextDigit(AExpansion));
      AAt := AAt + 1;
    end;
  end;
  if DoFloatRoundsUp(AExpansion, int64(AText[AAt - 1]) - 48) then
    // 99.9 up is 100.0: a 1 goes before the digits, now all 0
    if DoFloatCarry(AText, LStart, AAt) then
      LI := AAt;
      while LI > LStart do
        AText[LI] := AText[LI - 1];
        LI := LI - 1;
      end;
      AText[LStart] := '1';
      AAt := AAt + 1;
    end;
  end;
end;

// AExpansion scientific with APrecision digits after the point (to_chars'
// chars_format::scientific: "d.ddde+XX") into AText at AAt, AAt moved past it; the digits
// past ADAM_SPEC_FLOAT_SIGNIFICANT (all 0) counted in ATrailing instead
routine DoFloatScientific(var AExpansion: FloatExpansion; const APrecision: int64;
  const AText: ptr to char; var AAt: int64; var ATrailing: int64);
var
  LDigits: array[0..799] of char;
  LCount: int64;
  LExponent: int64;
  LI: int64;
begin
  LCount := APrecision + 1;
  if LCount > ADAM_SPEC_FLOAT_SIGNIFICANT then
    ATrailing := LCount - ADAM_SPEC_FLOAT_SIGNIFICANT;
    LCount := ADAM_SPEC_FLOAT_SIGNIFICANT;
  end;
  DoFloatSignificant(AExpansion, LCount, addr of LDigits[0], LExponent);
  AText[AAt] := LDigits[0];
  AAt := AAt + 1;
  if APrecision > 0 then
    AText[AAt] := '.';
    AAt := AAt + 1;
    for LI := 1 to LCount - 1 do
      AText[AAt] := LDigits[LI];
      AAt := AAt + 1;
    end;
  end;
  DoFloatPutExponent(AText, AAt, LExponent);
end;

// AExpansion in to_chars' chars_format::general with the precision APrecision (0 as 1):
// APrecision significant digits, fixed when the exponent X of the rounded value is below
// the precision and -4 or above, else scientific; the zeros at the end of the fraction,
// and a point left alone, dropped. Into AText at AAt, AAt moved past it
routine DoFloatGeneral(var AExpansion: FloatExpansion; const APrecision: int64;
  const AText: ptr to char; var AAt: int64);
var
  LDigits: array[0..799] of char;
  LPrecision: int64;
  LCount: int64;
  LExponent: int64;
  LI: int64;
begin
  LPrecision := APrecision;
  if LPrecision = 0 then
    LPrecision := 1;
  end;
  LCount := LPrecision;
  if LCount > ADAM_SPEC_FLOAT_SIGNIFICANT then
    LCount := ADAM_SPEC_FLOAT_SIGNIFICANT;
  end;
  DoFloatSignificant(AExpansion, LCount, addr of LDigits[0], LExponent);
  while (LCount > 1) and (LDigits[LCount - 1] = '0') do
    LCount := LCount - 1;
  end;
  if (LExponent < LPrecision) and (LExponent >= -4) then
    if LExponent >= 0 then
      for LI := 0 to LExponent do
        if LI < LCount then
          AText[AAt] := LDigits[LI];
        else
          AText[AAt] := '0';
        end;
        AAt := AAt + 1;
      end;
      if LCount > LExponent + 1 then
        AText[AAt] := '.';
        AAt := AAt + 1;
        for LI := LExponent + 1 to LCount - 1 do
          AText[AAt] := LDigits[LI];
          AAt := AAt + 1;
        end;
      end;
    else
      AText[AAt] := '0';
      AText[AAt + 1] := '.';
      AAt := AAt + 2;
      for LI := 2 to -LExponent do
        AText[AAt] := '0';
        AAt := AAt + 1;
      end;
      for LI := 0 to LCount - 1 do
        AText[AAt] := LDigits[LI];
        AAt := AAt + 1;
      end;
    end;
    return;
  end;
  AText[AAt] := LDigits[0];
  AAt := AAt + 1;
  if LCount > 1 then
    AText[AAt] := '.';
    AAt := AAt + 1;
    for LI := 1 to LCount - 1 do
      AText[AAt] := LDigits[LI];
      AAt := AAt + 1;
    end;
  end;
  DoFloatPutExponent(AText, AAt, LExponent);
end;

// The hex digit AValue (0 .. 15) written lower case into AText at AAt; AAt moves past it
routine DoFloatPutHexit(const AText: ptr to char; var AAt: int64; const AValue: int64);
begin
  if AValue < 10 then
    AText[AAt] := char(48 + AValue);
  else
    AText[AAt] := char(87 + AValue);
  end;
  AAt := AAt + 1;
end;

// The finite float whose magnitude's bits are ABits (a float32's when AShort) in to_chars'
// chars_format::hex, lower case, no "0x": the leading hexit (1, 0 for a subnormal and 0),
// the fraction's hexits (13 for a float64, 6 for a float32: its 23 bits moved up one), "p"
// and the binary exponent ("1.8p+1", "0p+0"). No precision (APrecision -1): the hexits
// without the zeros at their end. A precision below the count: rounded to nearest, a tie
// to even (the leading hexit can become 2); one above it: the zeros past the hexits
// counted in ATrailing. Into AText at AAt, AAt moved past it
routine DoFloatHex(const ABits: uint64; const AShort: bool; const APrecision: int64;
  const AText: ptr to char; var AAt: int64; var ATrailing: int64);
var
  LBiased: int64;
  LFraction: uint64;
  LHexits: int64;
  LBias: int64;
  LLead: uint64;
  LPower: int64;
  LDrop: int64;
  LValue: uint64;
  LHalf: uint64;
  LI: int64;
begin
  if AShort then
    LBiased := int64((ABits shr 23) & 0xFF);
    LFraction := (ABits & 0x7FFFFF) shl 1;
    LHexits := 6;
    LBias := 127;
  else
    LBiased := int64((ABits shr 52) & 0x7FF);
    LFraction := ABits & 0xFFFFFFFFFFFFF;
    LHexits := 13;
    LBias := 1023;
  end;
  LLead := 1;
  LPower := LBiased - LBias;
  if LBiased = 0 then
    LLead := 0;
    LPower := 1 - LBias;
    if LFraction = 0 then
      LPower := 0;
    end;
  end;
  if (APrecision >= 0) and (APrecision < LHexits) then
    LDrop := 4 * (LHexits - APrecision);
    LValue := (LLead shl (4 * LHexits)) | LFraction;
    LHalf := uint64(1) shl (LDrop - 1);
    if ((LValue & LHalf) <> 0) and
      (((LValue & (LHalf - 1)) <> 0) or (((LValue shr LDrop) & 1) <> 0)) then
      LValue := LValue + (uint64(1) shl LDrop);
    end;
    LValue := LValue shr LDrop;
    LHexits := APrecision;
    LLead := LValue shr (4 * LHexits);
    LFraction := LValue & ((uint64(1) shl (4 * LHexits)) - 1);
  end;
  if APrecision > LHexits then
    ATrailing := APrecision - LHexits;
  end;
  if APrecision < 0 then
    while (LHexits > 0) and ((LFraction & 0xF) = 0) do
      LFraction := LFraction shr 4;
      LHexits := LHexits - 1;
    end;
  end;
  DoFloatPutHexit(AText, AAt, int64(LLead));
  if LHexits > 0 then
    AText[AAt] := '.';
    AAt := AAt + 1;
    LI := LHexits - 1;
    while LI >= 0 do
      DoFloatPutHexit(AText, AAt, int64((LFraction shr (4 * LI)) & 0xF));
      LI := LI - 1;
    end;
  end;
  AText[AAt] := 'p';
  AAt := AAt + 1;
  if LPower < 0 then
    AText[AAt] := '-';
    LPower := -LPower;
  else
    AText[AAt] := '+';
  end;
  AAt := AAt + 1;
  DoFloatPutInt(AText, AAt, LPower);
end;

// The finite float AValue (widened; ABits its own magnitude's bits, a float32's when
// AShort) in the form of the type letter AType with the precision APrecision (-1: none),
// lower case, into AText at AAt (libc++'s __format_buffer): a A hex; no type and no
// precision the shortest round trip; e E scientific, f F fixed, g G and no type with a
// precision general, a missing precision 6. AAt moves past it; ATrailing the zeros to
// write before the exponent (or at the end)
routine DoFloatBody(const AValue: float64; const ABits: uint64; const AShort: bool;
  const AType: int64; const APrecision: int64; const AText: ptr to char; var AAt: int64;
  var ATrailing: int64);
var
  LExpansion: FloatExpansion;
  LWords: ptr to const uint64;
  LPrecision: int64;
begin
  if (AType = 97) or (AType = 65) then
    DoFloatHex(ABits, AShort, APrecision, AText, AAt, ATrailing);
    return;
  end;
  if (AType = 0) and (APrecision < 0) then
    if ABits = 0 then
      AText[AAt] := '0';
      AAt := AAt + 1;
      return;
    end;
    DoFloatShortest(AValue, ABits, AShort, AText, AAt);
    return;
  end;
  LPrecision := APrecision;
  if LPrecision < 0 then
    LPrecision := 6;
  end;
  LWords := ptr to const uint64(addr of AValue);
  DoFloatExpand(LExpansion, LWords[0] & 0x7FFFFFFFFFFFFFFF);
  if (AType = 101) or (AType = 69) then
    DoFloatScientific(LExpansion, LPrecision, AText, AAt, ATrailing);
    return;
  end;
  if (AType = 102) or (AType = 70) then
    DoFloatFixed(LExpansion, LPrecision, AText, AAt, ATrailing);
    return;
  end;
  DoFloatGeneral(LExpansion, LPrecision, AText, AAt);
end;

// The text AText[AFrom] .. AText[ACount - 1] to the print sink ASink with ATrailing zeros
// before the exponent at AExponentAt (ACount: none, the zeros at the end)
routine DoFloatWriteBody(const ASink: ptr to ptr; const AText: ptr to char; const AFrom: int64;
  const ACount: int64; const ATrailing: int64; const AExponentAt: int64);
begin
  if AExponentAt > AFrom then
    SinkText(ASink, addr of AText[AFrom], AExponentAt - AFrom);
  end;
  DoSpecFill(ASink, 48, 1, ATrailing);
  if ACount > AExponentAt then
    SinkText(ASink, addr of AText[AExponentAt], ACount - AExponentAt);
  end;
end;

// A float's text, ACount bytes at AText (its sign the first ASignCount) and ATrailing zeros
// before the exponent at AExponentAt, written to the print sink ASink in the width of the
// spec ASpec (AWidth: an argument's width, -1 none): `0` pads with zeros after the sign
// (never an infinity or a NaN, ANonFinite: they align right), else the fill around it all
// (by default before: a number is right aligned)
routine DoSpecFloatPadded(const ASink: ptr to ptr; const AText: ptr to char; const ACount: int64;
  const ASignCount: int64; const ATrailing: int64; const AExponentAt: int64;
  const ASpec: ptr to const int64; const AWidth: int64; const ANonFinite: bool);
var
  LFill: int64;
  LAlign: int64;
  LBefore: int64;
begin
  LFill := DoSpecWidth(ASpec, AWidth) - ACount - ATrailing;
  if LFill < 0 then
    LFill := 0;
  end;
  LAlign := ASpec[2];
  if (LAlign = ADAM_SPEC_ALIGN_ZERO) and ANonFinite then
    LAlign := ADAM_SPEC_ALIGN_RIGHT;
  end;
  if LAlign = ADAM_SPEC_ALIGN_ZERO then
    if ASignCount > 0 then
      SinkText(ASink, AText, ASignCount);
    end;
    DoSpecFill(ASink, 48, 1, LFill);
    DoFloatWriteBody(ASink, AText, ASignCount, ACount, ATrailing, AExponentAt);
    return;
  end;
  LBefore := LFill;
  if LAlign = ADAM_SPEC_ALIGN_LEFT then
    LBefore := 0;
  end;
  if LAlign = ADAM_SPEC_ALIGN_CENTER then
    LBefore := LFill div 2;
  end;
  DoSpecFillOf(ASink, ASpec, LBefore);
  DoFloatWriteBody(ASink, AText, 0, ACount, ATrailing, AExponentAt);
  DoSpecFillOf(ASink, ASpec, LFill - LBefore);
end;

// True when the type letter AType writes a float upper case (A E F G)
routine DoFloatUpper(const AType: int64): bool;
begin
  return (AType = 65) or (AType = 69) or (AType = 70) or (AType = 71);
end;

// `#` on the float text AText (ACount bytes, the sign the first ASignCount, the exponent
// at AExponentAt, the point at APoint: AExponentAt when none), libc++'s alternate form: a
// point always (before the exponent), and for g G (AType) the zeros a precision of
// APrecision (-1: none, 6) keeps, added to ATrailing
routine DoFloatAlternate(const AText: ptr to char; var ACount: int64; const ASignCount: int64;
  var AExponentAt: int64; var APoint: int64; const AType: int64; const APrecision: int64;
  var ATrailing: int64);
var
  LWanted: int64;
  LHave: int64;
  LI: int64;
begin
  if APoint = AExponentAt then
    LI := ACount;
    while LI > AExponentAt do
      AText[LI] := AText[LI - 1];
      LI := LI - 1;
    end;
    AText[AExponentAt] := '.';
    ACount := ACount + 1;
    AExponentAt := AExponentAt + 1;
  end;
  if (AType <> 103) and (AType <> 71) then
    return;
  end;
  // printf's %#g: P digits in all (P the precision, 6 without one, 1 for 0): fixed keeps P
  // less the integral digits after the point, scientific P - 1
  LWanted := 6;
  if APrecision >= 0 then
    LWanted := APrecision;
  end;
  if LWanted < 1 then
    LWanted := 1;
  end;
  if AExponentAt = ACount then
    LWanted := LWanted - (APoint - ASignCount);
  else
    LWanted := LWanted - 1;
  end;
  LHave := AExponentAt - APoint - 1;
  if LHave < LWanted then
    ATrailing := ATrailing + LWanted - LHave;
  end;
end;

// print's form of a float with the spec ASpec (AWidth / APrecision: an argument's width /
// precision, -1 none) to the print sink ASink (libc++'s __format_floating_point): AValue
// the value widened to float64, ABits its own magnitude's bits (a float32's when AShort).
// The sign (`-`, `+`, ` `), "inf" / "nan" for a value that is not finite, else the form of
// the type letter (DoFloatBody); upper case for A E F G; `#` (DoFloatAlternate); the width
// (DoSpecFloatPadded)
routine DoSpecFloat(const ASink: ptr to ptr; const AValue: float64; const ABits: uint64;
  const AShort: bool; const ASpec: ptr to const int64; const AWidth: int64;
  const APrecision: int64);
var
  LText: array[0..1399] of char;
  LWords: ptr to const uint64;
  LBits: uint64;
  LMagnitude: uint64;
  LType: int64;
  LPrecision: int64;
  LSignCount: int64;
  LAt: int64;
  LTrailing: int64;
  LExponentAt: int64;
  LPoint: int64;
  LLetter: char;
  LI: int64;
begin
  LWords := ptr to const uint64(addr of AValue);
  LBits := LWords[0];
  LMagnitude := LBits & 0x7FFFFFFFFFFFFFFF;
  LType := ASpec[6];
  LPrecision := DoSpecPrecision(ASpec, APrecision);
  LAt := 0;
  if (LBits shr 63) <> 0 then
    LText[0] := '-';
    LAt := 1;
  else
    if ASpec[3] = ADAM_SPEC_SIGN_PLUS then
      LText[0] := '+';
      LAt := 1;
    end;
    if ASpec[3] = ADAM_SPEC_SIGN_SPACE then
      LText[0] := ' ';
      LAt := 1;
    end;
  end;
  LSignCount := LAt;
  // An exponent of all ones: an infinity when the fraction is 0, else a NaN
  if LMagnitude >= 0x7FF0000000000000 then
    if LMagnitude = 0x7FF0000000000000 then
      LText[LAt] := 'i';
      LText[LAt + 1] := 'n';
      LText[LAt + 2] := 'f';
    else
      LText[LAt] := 'n';
      LText[LAt + 1] := 'a';
      LText[LAt + 2] := 'n';
    end;
    if DoFloatUpper(LType) then
      for LI := LAt to LAt + 2 do
        LText[LI] := char(int64(LText[LI]) - 32);
      end;
    end;
    LAt := LAt + 3;
    DoSpecFloatPadded(ASink, addr of LText[0], LAt, LSignCount, 0, LAt, ASpec, AWidth, true);
    return;
  end;
  LTrailing := 0;
  DoFloatBody(AValue, ABits, AShort, LType, LPrecision, addr of LText[0], LAt, LTrailing);
  // The exponent's letter and the point (libc++'s __float_result; none: the end)
  LLetter := 'e';
  if (LType = 97) or (LType = 65) then
    LLetter := 'p';
  end;
  LExponentAt := LSignCount;
  while (LExponentAt < LAt) and (LText[LExponentAt] <> LLetter) do
    LExponentAt := LExponentAt + 1;
  end;
  LPoint := LSignCount;
  while (LPoint < LExponentAt) and (LText[LPoint] <> '.') do
    LPoint := LPoint + 1;
  end;
  if ASpec[4] <> 0 then
    DoFloatAlternate(addr of LText[0], LAt, LSignCount, LExponentAt, LPoint, LType, LPrecision,
      LTrailing);
  end;
  if DoFloatUpper(LType) then
    // the hexits a .. f and the exponent's letter
    for LI := LSignCount to LAt - 1 do
      if (LText[LI] >= 'a') and (LText[LI] <= 'z') then
        LText[LI] := char(int64(LText[LI]) - 32);
      end;
    end;
  end;
  DoSpecFloatPadded(ASink, addr of LText[0], LAt, LSignCount, LTrailing, LExponentAt, ASpec,
    AWidth, false);
end;

// print's form of a float64 with the spec ASpec (AWidth / APrecision: an argument's width /
// precision, -1 none) to the print sink ASink (DoSpecFloat)
routine SinkSpecFloat64(const ASink: ptr to ptr; const AValue: float64; const ASpec: ptr to const int64;
  const AWidth: int64; const APrecision: int64);
var
  LWords: ptr to const uint64;
begin
  LWords := ptr to const uint64(addr of AValue);
  DoSpecFloat(ASink, AValue, LWords[0] & 0x7FFFFFFFFFFFFFFF, false, ASpec, AWidth, APrecision);
end;

// print's form of a float32 with the spec ASpec (AWidth / APrecision: an argument's width /
// precision, -1 none) to the print sink ASink (DoSpecFloat over the value widened, exactly)
routine SinkSpecFloat32(const ASink: ptr to ptr; const AValue: float32; const ASpec: ptr to const int64;
  const AWidth: int64; const APrecision: int64);
var
  LWords: ptr to const uint32;
begin
  LWords := ptr to const uint32(addr of AValue);
  DoSpecFloat(ASink, float64(AValue), uint64(LWords[0] & 0x7FFFFFFF), true, ASpec, AWidth,
    APrecision);
end;

// The raise in flight set to the code ACode and the text AText, whose reference it takes
// over (the caller's hold becomes the raise's), then the runtime's exception raised
// (PlatformRaise); it never returns. The entry's catching scope catches it, and its catch
// block reports it (Unhandled)
routine RaiseWith(const ACode: int32; const AText: ptr); noreturn;
begin
  StrRelease(GRaiseText);
  GRaiseText := AText;
  GRaiseCode := ACode;
  PlatformRaise();
end;

// exccode(): the code of this thread's raise in flight (the last one raised, caught or not;
// 0 before any)
routine ExcCode(): int32;
begin
  return GRaiseCode;
end;

// excmsg(): the text of this thread's raise in flight (the last one raised, caught or not;
// "" before any), a reference the caller holds
routine ExcMsg(): ptr;
begin
  StrAddRef(GRaiseText);
  return GRaiseText;
end;

// raise(S): the raise in flight is S with PaskalCPP's code for raise (1, EXC_SOFTWARE),
// its text held (a reference added: the raising frame's own release of S runs as it
// unwinds), then raised (RaiseWith); it never returns
routine Raise(const AText: ptr); noreturn;
begin
  StrAddRef(AText);
  RaiseWith(1, AText);
end;

// raisecode(C, S): the raise in flight is S with the code ACode, its text held (Raise's
// rule), then raised (RaiseWith); it never returns
routine RaiseCode(const ACode: int32; const AText: ptr); noreturn;
begin
  StrAddRef(AText);
  RaiseWith(ACode, AText);
end;

const
  // PaskalCPP's codes for a typed pack's failed read (pcpp_runtime.h EXC_VARARGS_TYPE /
  // EXC_VARARGS_INDEX)
  ADAM_RUNTIME_EXC_VARARGS_TYPE: int32 = 8;
  ADAM_RUNTIME_EXC_VARARGS_INDEX: int32 = 9;

public type
  // What a typed pack's argument is (BNF sec 6 varargs.kind(I)): one value per type a
  // cpplink pack carries, a builtin by its own name (CLong / CULong: C's long, Ptr: the
  // untyped ptr), any other type by what it is (Pointer: a typed pointer, Choices: a value
  // of a choices type, Routine: a routine value, Own / Ref / Weak: an owner). The compiler
  // numbers a pack item's kind by these names (Lowering DoPackKindNumber), never by order
  VarKind = choices(
    Int8, Int16, Int32, Int64, UInt8, UInt16, UInt32, UInt64, CLong, CULong, Float32,
    Float64, Bool, Char, WChar, String, WString, Ptr, Pointer, StaticArray, DynamicArray,
    Set, Choices, Record, Object, Interface, Overlay, Routine, Own, Ref, Weak, Task);

type
  // A typed pack's header as the compiler builds it (Adam.Backend.Lowering
  // DoPackArguments): its items, their count, the cursor next reads at
  PackHeader = record
    Items: ptr;
    Count: int32;
    Cursor: int32;
  end;

  // One item of a typed pack (Lowering DoPackItemBytes, 40 bytes): the argument's type
  // tag (FNV-1a 64 of its text and module), the address of the caller's copy of it, its
  // type's text (a C string, for a raise's message), its VarKind's number and its facts:
  // what the kind alone does not tell, a read-only block of int64 words by kind (Lowering
  // DoPackFactWords), nil for every other kind. Pointer: [the VarKind number of what print
  // writes for it: Char its C string, WChar its C wide string, Ptr its address]; Choices:
  // [the value's byte size, then the type's names table, SinkChoice's ATable];
  // StaticArray: [its element count, the element's size, the element's VarKind number (-1:
  // one no pack names), then the element's own facts]; Set: [its lowest member, its
  // highest, the member's VarKind number, then the member's own facts] (its place holds its
  // bytes: bit i member low + i). A range's element facts start at word 3 either way
  PackEntry = record
    Tag: uint64;
    Place: ptr;
    TypeName: ptr to const char;
    Kind: int64;
    Facts: ptr to const int64;
  end;

// The item varargs.next / get / kind (AMember, its name) reads in the pack whose header is
// AHeader: argument AIndex (zero-based), its type checked against AWanted (the wanted
// type's tag; AWantedName its text) unless AWanted is 0 (kind: no type is wanted). An index
// outside the pack raises EXC_VARARGS_INDEX, another stored type EXC_VARARGS_TYPE, with
// pcpp's texts (pcpp_runtime.cpp VaRaiseIndex / VaRaiseType); the item's address
routine PackItem(const AHeader: ptr; const AIndex: int32; const AMember: ptr to const char;
  const AWanted: uint64; const AWantedName: ptr to const char): ptr;
var
  LHeader: ptr to PackHeader;
  LItems: ptr to PackEntry;
begin
  LHeader := ptr to PackHeader(AHeader);
  if (AIndex < 0) or (AIndex >= LHeader->Count) then
    raisecode(ADAM_RUNTIME_EXC_VARARGS_INDEX,
      FormatStr("varargs.{}: argument {} does not exist (count {})", AMember, AIndex,
        LHeader->Count));
  end;
  LItems := ptr to PackEntry(LHeader->Items);
  if (AWanted <> 0) and (LItems[AIndex].Tag <> AWanted) then
    raisecode(ADAM_RUNTIME_EXC_VARARGS_TYPE,
      FormatStr("varargs.{}({}): argument {} is {}", AMember, AWantedName, AIndex,
        LItems[AIndex].TypeName));
  end;
  return addr of LItems[AIndex];
end;

const
  // How a run-time format numbers its arguments so far (FormatRun; libc++'s
  // basic_format_parse_context __indexing_): neither yet, by index `{n}`, in order `{}`
  ADAM_RUNTIME_FORMAT_UNKNOWN: int32 = 0;
  ADAM_RUNTIME_FORMAT_MANUAL: int32 = 1;
  ADAM_RUNTIME_FORMAT_AUTOMATIC: int32 = 2;

  // The largest argument index a format may write (libc++'s __number_max, INT32_MAX)
  ADAM_RUNTIME_FORMAT_NUMBER_MAX: int64 = 2147483647;

// The bytes AText[AFrom .. ATo - 1] of a run-time format written to the print sink ASink as
// they are (nothing when the run is empty)
routine DoRunText(const ASink: ptr to ptr; const AText: ptr to const char; const AFrom: int64;
  const ATo: int64);
begin
  if ATo > AFrom then
    SinkText(ASink, ptr(addr of AText[AFrom]), ATo - AFrom);
  end;
end;

// A number of a run-time format that starts at AText[AAt] (a digit), AAt moved past it:
// libc++'s __parse_number (up to 10 digits, the value at most
// ADAM_RUNTIME_FORMAT_NUMBER_MAX, else libc++'s raise)
routine DoRunNumber(const AText: ptr to const char; const ACount: int64; var AAt: int64): int64;
var
  LValue: int64;
  LDigits: int64;
begin
  LValue := 0;
  LDigits := 0;
  while (AAt < ACount) and (AText[AAt] >= '0') and (AText[AAt] <= '9') do
    // past 10 digits the value always overflows; 10 digits are checked against the maximum
    if LDigits = 10 then
      raise("The numeric value of the format specifier is too large");
    end;
    LValue := LValue * 10 + (int64(uint8(AText[AAt])) - 48);
    LDigits := LDigits + 1;
    AAt := AAt + 1;
  end;
  if LValue > ADAM_RUNTIME_FORMAT_NUMBER_MAX then
    raise("The numeric value of the format specifier is too large");
  end;
  return LValue;
end;

// The manual argument index of a run-time format that starts at AText[AAt] (a digit),
// AAt moved past it: libc++'s __parse_zero (a '0' is index 0, alone) and __parse_manual
// (DoRunNumber)
routine DoRunIndex(const AText: ptr to const char; const ACount: int64; var AAt: int64): int64;
begin
  if AText[AAt] = '0' then
    AAt := AAt + 1;
    return 0;
  end;
  return DoRunNumber(AText, ACount, AAt);
end;

// The argument id of a run-time format at AText[AAt] (AAt < ACount), AAt moved past it:
// libc++'s __parse_arg_id, for a replacement field and for a nested width or precision
// alike: before a '}' or a ':' the next one in order (AIndexing / ANext: libc++'s
// next_arg_id), else an index (DoRunIndex; check_arg_id), the two numberings never mixed
routine DoRunArgId(const AText: ptr to const char; const ACount: int64; var AAt: int64;
  var AIndexing: int32; var ANext: int64): int64;
var
  LIndex: int64;
begin
  if (AText[AAt] = '}') or (AText[AAt] = ':') then
    if AIndexing = ADAM_RUNTIME_FORMAT_MANUAL then
      raise("Using automatic argument numbering in manual argument numbering mode");
    end;
    AIndexing := ADAM_RUNTIME_FORMAT_AUTOMATIC;
    LIndex := ANext;
    ANext := ANext + 1;
    return LIndex;
  end;
  if (AText[AAt] < '0') or (AText[AAt] > '9') then
    raise("The argument index starts with an invalid character");
  end;
  LIndex := DoRunIndex(AText, ACount, AAt);
  if AIndexing = ADAM_RUNTIME_FORMAT_AUTOMATIC then
    raise("Using manual argument numbering in automatic argument numbering mode");
  end;
  AIndexing := ADAM_RUNTIME_FORMAT_MANUAL;
  return LIndex;
end;

// The number of the choices value at APlace, read at the byte size AFacts[0] gives (signed,
// as Lowering's DoIrType makes a choices value)
routine DoRunChoiceNumber(const APlace: ptr; const AFacts: ptr to const int64): int64;
var
  LNumber: int64;
begin
  match AFacts[0] of
    1: LNumber := int64(ptr to int8(APlace)^);
    2: LNumber := int64(ptr to int16(APlace)^);
    4: LNumber := int64(ptr to int32(APlace)^);
  else
    LNumber := ptr to int64(APlace)^;
  end;
  return LNumber;
end;

// print's form of the choices value at APlace under a run-time format: its number
// (DoRunChoiceNumber), its name from the names table after AFacts[0] (SinkChoice)
routine DoRunChoice(const ASink: ptr to ptr; const APlace: ptr; const AFacts: ptr to const int64);
begin
  SinkChoice(ASink, DoRunChoiceNumber(APlace, AFacts), addr of AFacts[1]);
end;

// print's form of the typed pointer AValue under a run-time format, by its target's kind
// (AFacts[0]): to char its C string, to wchar its C wide string, any other its address
routine DoRunPointer(const ASink: ptr to ptr; const AValue: ptr; const AFacts: ptr to const int64);
var
  LTarget: VarKind;
begin
  LTarget := VarKind(AFacts[0]);
  if LTarget = VarKind.Char then
    SinkCText(ASink, ptr to const char(AValue));
    return;
  end;
  if LTarget = VarKind.WChar then
    SinkWideCText(ASink, ptr to const wchar(AValue));
    return;
  end;
  SinkAddress(ASink, AValue);
end;

// The pack item AItem written to the print sink ASink in its print form, by its kind,
// through the Sink* routine print's own build-time path calls for that form (the same
// text). Lowering packs no other kind under a run-time format (SEM refuses an unprintable
// argument; a range goes through DoRunRange): any other is an invariant broken
routine DoRunValue(const ASink: ptr to ptr; const AItem: ptr to PackEntry);
var
  LPlace: ptr;
begin
  LPlace := AItem->Place;
  match VarKind(AItem->Kind) of
    VarKind.Int8: SinkInt(ASink, int64(ptr to int8(LPlace)^));
    VarKind.Int16: SinkInt(ASink, int64(ptr to int16(LPlace)^));
    VarKind.Int32: SinkInt(ASink, int64(ptr to int32(LPlace)^));
    VarKind.Int64: SinkInt(ASink, ptr to int64(LPlace)^);
    VarKind.UInt8: SinkUInt(ASink, uint64(ptr to uint8(LPlace)^));
    VarKind.UInt16: SinkUInt(ASink, uint64(ptr to uint16(LPlace)^));
    VarKind.UInt32: SinkUInt(ASink, uint64(ptr to uint32(LPlace)^));
    VarKind.UInt64: SinkUInt(ASink, ptr to uint64(LPlace)^);
    VarKind.CLong: SinkInt(ASink, int64(ptr to clong(LPlace)^));
    VarKind.CULong: SinkUInt(ASink, uint64(ptr to culong(LPlace)^));
    VarKind.Float32: SinkFloat32(ASink, ptr to float32(LPlace)^);
    VarKind.Float64: SinkFloat64(ASink, ptr to float64(LPlace)^);
    VarKind.Bool: SinkBool(ASink, ptr to bool(LPlace)^);
    VarKind.Char: SinkChar(ASink, ptr to char(LPlace)^);
    VarKind.WChar: SinkWideChar(ASink, ptr to wchar(LPlace)^);
    VarKind.String: SinkStr(ASink, ptr to ptr(LPlace)^);
    VarKind.WString: SinkWideText(ASink, ptr to ptr(LPlace)^);
    VarKind.Ptr, VarKind.Routine: SinkAddress(ASink, ptr to ptr(LPlace)^);
    VarKind.Pointer: DoRunPointer(ASink, ptr to ptr(LPlace)^, AItem->Facts);
    VarKind.Choices: DoRunChoice(ASink, LPlace, AItem->Facts);
  else
    raise(FormatStr("FormatRun: a pack item of type {} under a run-time format",
      AItem->TypeName));
  end;
end;

const
  // The formatter a run-time placeholder's argument takes (DoRunFormOf, by its kind: the one
  // the build-time path takes by its type's PrintForm, libc++'s formatter<T>): integral,
  // bool, char, floating point, pointer, string (every text form and a choices value)
  ADAM_RUNTIME_FORMAT_FORM_INTEGER: int64 = 0;
  ADAM_RUNTIME_FORMAT_FORM_BOOL: int64 = 1;
  ADAM_RUNTIME_FORMAT_FORM_CHAR: int64 = 2;
  ADAM_RUNTIME_FORMAT_FORM_FLOAT: int64 = 3;
  ADAM_RUNTIME_FORMAT_FORM_POINTER: int64 = 4;
  ADAM_RUNTIME_FORMAT_FORM_STRING: int64 = 5;

  // The fields a formatter's spec reads, as bits (libc++'s __fields; the type letter and
  // the rule that the spec ends at its '}' hold for every formatter here)
  ADAM_RUNTIME_FORMAT_FIELD_SIGN: int64 = 1;
  ADAM_RUNTIME_FORMAT_FIELD_ALTERNATE: int64 = 2;
  ADAM_RUNTIME_FORMAT_FIELD_ZERO: int64 = 4;
  ADAM_RUNTIME_FORMAT_FIELD_PRECISION: int64 = 8;
  ADAM_RUNTIME_FORMAT_FIELD_LOCALE: int64 = 16;

  // libc++'s field sets: __fields_integral (sign, #, 0, L: an integer, a bool, a char),
  // __fields_floating_point (those and a precision), __fields_pointer (0),
  // __fields_string (a precision) and __fields_bool (L: what __validate leaves a bool or a
  // char written as text)
  ADAM_RUNTIME_FORMAT_FIELDS_INTEGRAL: int64 = 23;
  ADAM_RUNTIME_FORMAT_FIELDS_FLOAT: int64 = 31;
  ADAM_RUNTIME_FORMAT_FIELDS_POINTER: int64 = 4;
  ADAM_RUNTIME_FORMAT_FIELDS_STRING: int64 = 8;
  ADAM_RUNTIME_FORMAT_FIELDS_BOOL: int64 = 16;

type
  // A run-time placeholder's spec as DoRunSpec reads it: Words its words as the SinkSpec*
  // routines read them (the ADAM_SPEC_* layout: what Lowering's DoSpecData writes for the
  // build-time path), WidthArgument / PrecisionArgument the argument a nested `{}` / `{n}`
  // names (-1: none), SignWritten a sign written (`-` too: libc++'s __validate tells it from
  // none), Localized `L` (read and left out of the words, as the build-time path does)
  RunSpec = record
    Words: array[0..7] of int64;
    WidthArgument: int64;
    PrecisionArgument: int64;
    SignWritten: bool;
    Localized: bool;
  end;

// A run-time placeholder's spec with nothing written: no fill, the default align, the
// default sign, no `#`, no width, no type letter, no precision
routine DoRunEmptySpec(): RunSpec;
var
  LSpec: RunSpec;
begin
  LSpec.Words[0] := 0;
  LSpec.Words[1] := 0;
  LSpec.Words[2] := ADAM_SPEC_ALIGN_DEFAULT;
  LSpec.Words[3] := ADAM_SPEC_SIGN_MINUS;
  LSpec.Words[4] := 0;
  LSpec.Words[5] := 0;
  LSpec.Words[6] := 0;
  LSpec.Words[7] := -1;
  LSpec.WidthArgument := -1;
  LSpec.PrecisionArgument := -1;
  LSpec.SignWritten := false;
  LSpec.Localized := false;
  return LSpec;
end;

// The bytes of the UTF-8 code point at AText[AAt] (AAt < ACount), 0 when it is malformed:
// libc++'s __code_point_view<char>::__consume (a lone continuation byte, a lead byte of
// five ones or more, a sequence cut short or broken, an overlong form, a surrogate, a value
// past U+10FFFF)
routine DoRunCodePoint(const AText: ptr to const char; const ACount: int64; const AAt: int64): int64;
var
  LLead: int64;
  LLength: int64;
  LValue: int64;
  LByte: int64;
  LI: int64;
begin
  LLead := int64(uint8(AText[AAt]));
  if LLead < 0x80 then
    return 1;
  end;
  // the count of leading 1 bits is the sequence's length; the lead byte's value bits follow
  LLength := 0;
  LValue := 0;
  if (LLead & 0xE0) = 0xC0 then
    LLength := 2;
    LValue := LLead & 0x1F;
  end;
  if (LLead & 0xF0) = 0xE0 then
    LLength := 3;
    LValue := LLead & 0x0F;
  end;
  if (LLead & 0xF8) = 0xF0 then
    LLength := 4;
    LValue := LLead & 0x07;
  end;
  if (LLength = 0) or (AAt + LLength > ACount) then
    return 0;
  end;
  for LI := 1 to LLength - 1 do
    LByte := int64(uint8(AText[AAt + LI]));
    if (LByte & 0xC0) <> 0x80 then
      return 0;
    end;
    LValue := (LValue shl 6) | (LByte & 0x3F);
  end;
  if (LLength = 2) and (LValue < 0x80) then
    return 0;
  end;
  if (LLength = 3) and ((LValue < 0x800) or ((LValue >= 0xD800) and (LValue <= 0xDFFF))) then
    return 0;
  end;
  if (LLength = 4) and ((LValue < 0x10000) or (LValue > 0x10FFFF)) then
    return 0;
  end;
  return LLength;
end;

// The alignment the character AChar writes into AAlign (`<` `^` `>`, ADAM_SPEC_ALIGN_*);
// false for any other
routine DoRunAlignOf(const AChar: char; var AAlign: int64): bool;
begin
  if AChar = '<' then
    AAlign := ADAM_SPEC_ALIGN_LEFT;
    return true;
  end;
  if AChar = '^' then
    AAlign := ADAM_SPEC_ALIGN_CENTER;
    return true;
  end;
  if AChar = '>' then
    AAlign := ADAM_SPEC_ALIGN_RIGHT;
    return true;
  end;
  return false;
end;

// Fill and align at AText[AAt] (AAt < ACount) into ASpec, AAt moved past them: libc++'s
// __parse_fill_align (UTF-8): the code point there is consumed first (malformed: libc++'s
// raise), then one code point and an align character set both (a `{` fill raises), an
// align character alone the alignment
routine DoRunFillAlign(const AText: ptr to const char; const ACount: int64; var AAt: int64;
  var ASpec: RunSpec);
var
  LLength: int64;
  LAlign: int64;
  LFill: int64;
  LI: int64;
begin
  LLength := DoRunCodePoint(AText, ACount, AAt);
  if LLength = 0 then
    raise("The format specifier contains malformed Unicode characters");
  end;
  if (AAt + LLength < ACount) and DoRunAlignOf(AText[AAt + LLength], LAlign) then
    if (LLength = 1) and (AText[AAt] = '{') then
      raise("The fill option contains an invalid value");
    end;
    // the fill's bytes packed little-endian, as Lowering's DoSpecData packs them
    LFill := 0;
    for LI := 0 to LLength - 1 do
      LFill := LFill | (int64(uint8(AText[AAt + LI])) shl (8 * LI));
    end;
    ASpec.Words[0] := LFill;
    ASpec.Words[1] := LLength;
    ASpec.Words[2] := LAlign;
    AAt := AAt + LLength + 1;
    return;
  end;
  if DoRunAlignOf(AText[AAt], LAlign) then
    ASpec.Words[2] := LAlign;
    AAt := AAt + 1;
  end;
end;

// The argument id of a nested width or precision (its `{` passed) at AText[AAt], AAt moved
// past its `}`: libc++'s __format_spec::__parse_arg_id (DoRunArgId between its checks), in
// the replacement fields' own numbering (AIndexing / ANext)
routine DoRunNestedId(const AText: ptr to const char; const ACount: int64; var AAt: int64;
  var AIndexing: int32; var ANext: int64): int64;
var
  LId: int64;
begin
  if AAt = ACount then
    raise("End of input while parsing an argument index");
  end;
  LId := DoRunArgId(AText, ACount, AAt, AIndexing, ANext);
  if (AAt = ACount) or (AText[AAt] <> '}') then
    raise("The argument index is invalid");
  end;
  AAt := AAt + 1;
  return LId;
end;

// The width at AText[AAt] (AAt < ACount) into ASpec, AAt moved past it: libc++'s
// __parse_width: a leading `0` raises, `{id}` an argument's (DoRunNestedId), digits the
// written one, anything else none
routine DoRunWidth(const AText: ptr to const char; const ACount: int64; var AAt: int64;
  var ASpec: RunSpec; var AIndexing: int32; var ANext: int64);
begin
  if AText[AAt] = '0' then
    raise("The width option should not have a leading zero");
  end;
  if AText[AAt] = '{' then
    AAt := AAt + 1;
    ASpec.WidthArgument := DoRunNestedId(AText, ACount, AAt, AIndexing, ANext);
    return;
  end;
  if (AText[AAt] >= '0') and (AText[AAt] <= '9') then
    ASpec.Words[5] := DoRunNumber(AText, ACount, AAt);
  end;
end;

// The precision at AText[AAt] (AAt < ACount) into ASpec, AAt moved past it: libc++'s
// __parse_precision: nothing without a `.`; after it `{id}` an argument's
// (DoRunNestedId), digits the written one, the end or anything else libc++'s raise
routine DoRunPrecision(const AText: ptr to const char; const ACount: int64; var AAt: int64;
  var ASpec: RunSpec; var AIndexing: int32; var ANext: int64);
begin
  if AText[AAt] <> '.' then
    return;
  end;
  AAt := AAt + 1;
  if AAt = ACount then
    raise("End of input while parsing format specifier precision");
  end;
  if AText[AAt] = '{' then
    AAt := AAt + 1;
    ASpec.PrecisionArgument := DoRunNestedId(AText, ACount, AAt, AIndexing, ANext);
    return;
  end;
  if (AText[AAt] < '0') or (AText[AAt] > '9') then
    raise("The precision option does not contain a value or an argument index");
  end;
  ASpec.Words[7] := DoRunNumber(AText, ACount, AAt);
end;

// True when AChar is a type letter libc++'s __parse_type reads
routine DoRunTypeLetter(const AChar: char): bool;
begin
  return (AChar = 'A') or (AChar = 'B') or (AChar = 'E') or (AChar = 'F') or (AChar = 'G') or
    (AChar = 'X') or (AChar = 'a') or (AChar = 'b') or (AChar = 'c') or (AChar = 'd') or
    (AChar = 'e') or (AChar = 'f') or (AChar = 'g') or (AChar = 'o') or (AChar = 'p') or
    (AChar = 'P') or (AChar = 's') or (AChar = 'x') or (AChar = '?');
end;

// The std-format-spec of a run-time placeholder at AText[AAt] into ASpec, AAt moved past
// it: libc++'s __parser::__parse as it runs when the format runs. A field the formatter's
// AFields (ADAM_RUNTIME_FORMAT_FIELD_*) does not hold is not read at all, so what it would
// have read stops the spec there (no type letter reads it: "should consume the input"); a
// nested width or precision takes its argument id in the fields' numbering (AIndexing /
// ANext). Each part that ends the text ends the spec
routine DoRunSpec(const AText: ptr to const char; const ACount: int64; var AAt: int64;
  const AFields: int64; var ASpec: RunSpec; var AIndexing: int32; var ANext: int64);
begin
  if (AAt = ACount) or (AText[AAt] = '}') then
    return;
  end;
  DoRunFillAlign(AText, ACount, AAt, ASpec);
  if AAt = ACount then
    return;
  end;
  if ((AFields & ADAM_RUNTIME_FORMAT_FIELD_SIGN) <> 0) and
    ((AText[AAt] = '-') or (AText[AAt] = '+') or (AText[AAt] = ' ')) then
    ASpec.SignWritten := true;
    if AText[AAt] = '+' then
      ASpec.Words[3] := ADAM_SPEC_SIGN_PLUS;
    end;
    if AText[AAt] = ' ' then
      ASpec.Words[3] := ADAM_SPEC_SIGN_SPACE;
    end;
    AAt := AAt + 1;
    if AAt = ACount then
      return;
    end;
  end;
  if ((AFields & ADAM_RUNTIME_FORMAT_FIELD_ALTERNATE) <> 0) and (AText[AAt] = '#') then
    ASpec.Words[4] := 1;
    AAt := AAt + 1;
    if AAt = ACount then
      return;
    end;
  end;
  if ((AFields & ADAM_RUNTIME_FORMAT_FIELD_ZERO) <> 0) and (AText[AAt] = '0') then
    // libc++'s `0` takes effect only where no alignment was written
    if ASpec.Words[2] = ADAM_SPEC_ALIGN_DEFAULT then
      ASpec.Words[2] := ADAM_SPEC_ALIGN_ZERO;
    end;
    AAt := AAt + 1;
    if AAt = ACount then
      return;
    end;
  end;
  DoRunWidth(AText, ACount, AAt, ASpec, AIndexing, ANext);
  if AAt = ACount then
    return;
  end;
  if (AFields & ADAM_RUNTIME_FORMAT_FIELD_PRECISION) <> 0 then
    DoRunPrecision(AText, ACount, AAt, ASpec, AIndexing, ANext);
    if AAt = ACount then
      return;
    end;
  end;
  if ((AFields & ADAM_RUNTIME_FORMAT_FIELD_LOCALE) <> 0) and (AText[AAt] = 'L') then
    ASpec.Localized := true;
    AAt := AAt + 1;
    if AAt = ACount then
      return;
    end;
  end;
  if DoRunTypeLetter(AText[AAt]) then
    ASpec.Words[6] := int64(uint8(AText[AAt]));
    AAt := AAt + 1;
  end;
  if (AAt < ACount) and (AText[AAt] <> '}') then
    raise("The format specifier should consume the input or end with a '}'");
  end;
end;

// libc++'s raise for an option AOption the formatter AId (libc++'s __id) refuses in the
// form its type letter picked (__throw_invalid_option_format_error)
routine DoRunOptionRaise(const AId: ptr to const char; const AOption: ptr to const char);
  noreturn;
begin
  raise(FormatStr("The format specifier for {} does not allow the {} option", AId, AOption));
end;

// libc++'s raise for a type letter the formatter AId refuses
// (__throw_invalid_type_format_error)
routine DoRunTypeRaise(const AId: ptr to const char); noreturn;
begin
  raise(FormatStr("The type option contains an invalid value for {} formatting argument", AId));
end;

// The spec ASpec checked against __fields_bool for the formatter AId, as libc++'s
// __validate checks a bool or a char written as text (an integer by `c` too): the sign,
// `#`, zero padding and a precision in that order, each refused by its own text
// (__fields_bool holds `L` alone, so `L` passes; its default type mask takes every letter)
routine DoRunValidate(const ASpec: RunSpec; const AId: ptr to const char);
begin
  if ASpec.SignWritten then
    DoRunOptionRaise(AId, ptr to const char("sign"));
  end;
  if ASpec.Words[4] <> 0 then
    DoRunOptionRaise(AId, ptr to const char("alternate form"));
  end;
  if ASpec.Words[2] = ADAM_SPEC_ALIGN_ZERO then
    DoRunOptionRaise(AId, ptr to const char("zero-padding"));
  end;
  if (ASpec.Words[7] <> -1) or (ASpec.PrecisionArgument >= 0) then
    DoRunOptionRaise(AId, ptr to const char("precision"));
  end;
end;

// True when the type letter byte AType writes an integer's digits (b B o d x X)
routine DoRunIntegerLetter(const AType: int64): bool;
var
  LLetter: char;
begin
  LLetter := char(AType & 0xFF);
  return (LLetter = 'b') or (LLetter = 'B') or (LLetter = 'o') or (LLetter = 'd') or
    (LLetter = 'x') or (LLetter = 'X');
end;

// The spec ASpec read for the formatter AForm (ADAM_RUNTIME_FORMAT_FORM_*) checked by its
// type letter as libc++'s __process_parsed_integer / _bool / _char / _floating_point,
// __process_display_type_pointer and _string check it, each refusal by its own text
routine DoRunProcess(const AForm: int64; const ASpec: RunSpec);
var
  LType: int64;
  LLetter: char;
begin
  LType := ASpec.Words[6];
  LLetter := char(LType & 0xFF);
  if AForm = ADAM_RUNTIME_FORMAT_FORM_INTEGER then
    if LLetter = 'c' then
      DoRunValidate(ASpec, ptr to const char("an integer"));
      return;
    end;
    if (LType <> 0) and (not DoRunIntegerLetter(LType)) then
      DoRunTypeRaise(ptr to const char("an integer"));
    end;
    return;
  end;
  if AForm = ADAM_RUNTIME_FORMAT_FORM_BOOL then
    if (LType = 0) or (LLetter = 's') then
      DoRunValidate(ASpec, ptr to const char("a bool"));
      return;
    end;
    if not DoRunIntegerLetter(LType) then
      DoRunTypeRaise(ptr to const char("a bool"));
    end;
    return;
  end;
  if AForm = ADAM_RUNTIME_FORMAT_FORM_CHAR then
    if (LType = 0) or (LLetter = 'c') or (LLetter = '?') then
      DoRunValidate(ASpec, ptr to const char("a character"));
      return;
    end;
    if not DoRunIntegerLetter(LType) then
      DoRunTypeRaise(ptr to const char("a character"));
    end;
    return;
  end;
  if AForm = ADAM_RUNTIME_FORMAT_FORM_FLOAT then
    if (LType <> 0) and (LLetter <> 'a') and (LLetter <> 'A') and (LLetter <> 'e') and
      (LLetter <> 'E') and (LLetter <> 'f') and (LLetter <> 'F') and (LLetter <> 'g') and
      (LLetter <> 'G') then
      DoRunTypeRaise(ptr to const char("a floating-point"));
    end;
    return;
  end;
  if AForm = ADAM_RUNTIME_FORMAT_FORM_POINTER then
    if (LType <> 0) and (LLetter <> 'p') and (LLetter <> 'P') then
      DoRunTypeRaise(ptr to const char("a pointer"));
    end;
    return;
  end;
  // the string formatter: every text form and a choices value
  if (LType <> 0) and (LLetter <> 's') and (LLetter <> '?') then
    raise("The type option contains an invalid value for a string formatting argument");
  end;
end;

// The formatter (ADAM_RUNTIME_FORMAT_FORM_*) the pack item AItem takes under a run-time
// format, by its kind: the one the build-time path takes for its type (a typed pointer by
// what print writes for it: AItem's Facts). Any other kind is an invariant broken, as in
// DoRunValue
routine DoRunFormOf(const AItem: ptr to PackEntry): int64;
var
  LForm: int64;
  LTarget: VarKind;
begin
  match VarKind(AItem->Kind) of
    VarKind.Int8, VarKind.Int16, VarKind.Int32, VarKind.Int64, VarKind.UInt8, VarKind.UInt16,
      VarKind.UInt32, VarKind.UInt64, VarKind.CLong, VarKind.CULong:
      LForm := ADAM_RUNTIME_FORMAT_FORM_INTEGER;
    VarKind.Float32, VarKind.Float64: LForm := ADAM_RUNTIME_FORMAT_FORM_FLOAT;
    VarKind.Bool: LForm := ADAM_RUNTIME_FORMAT_FORM_BOOL;
    VarKind.Char: LForm := ADAM_RUNTIME_FORMAT_FORM_CHAR;
    VarKind.WChar, VarKind.String, VarKind.WString, VarKind.Choices:
      LForm := ADAM_RUNTIME_FORMAT_FORM_STRING;
    VarKind.Ptr, VarKind.Routine: LForm := ADAM_RUNTIME_FORMAT_FORM_POINTER;
    VarKind.Pointer: LForm := ADAM_RUNTIME_FORMAT_FORM_POINTER;
  else
    raise(FormatStr("FormatRun: a pack item of type {} under a run-time format",
      AItem->TypeName));
  end;
  if VarKind(AItem->Kind) = VarKind.Pointer then
    // a ptr to char / wchar prints its C text: the string formatter's
    LTarget := VarKind(AItem->Facts[0]);
    if (LTarget = VarKind.Char) or (LTarget = VarKind.WChar) then
      LForm := ADAM_RUNTIME_FORMAT_FORM_STRING;
    end;
  end;
  return LForm;
end;

// The fields the formatter AForm's spec reads (libc++'s __fields_integral for an integer, a
// bool and a char, __fields_floating_point, __fields_pointer, __fields_string)
routine DoRunFieldsOf(const AForm: int64): int64;
begin
  if AForm = ADAM_RUNTIME_FORMAT_FORM_FLOAT then
    return ADAM_RUNTIME_FORMAT_FIELDS_FLOAT;
  end;
  if AForm = ADAM_RUNTIME_FORMAT_FORM_POINTER then
    return ADAM_RUNTIME_FORMAT_FIELDS_POINTER;
  end;
  if AForm = ADAM_RUNTIME_FORMAT_FORM_STRING then
    return ADAM_RUNTIME_FORMAT_FIELDS_STRING;
  end;
  return ADAM_RUNTIME_FORMAT_FIELDS_INTEGRAL;
end;

// The value of the pack item AItem when it is an integer (Int8 .. UInt64, CLong, CULong)
// into AValue (its bits as int64) and AUnsigned (an unsigned type); false for any other kind
routine DoRunInteger(const AItem: ptr to PackEntry; var AValue: int64; var AUnsigned: bool): bool;
var
  LPlace: ptr;
  LKind: VarKind;
begin
  LPlace := AItem->Place;
  LKind := VarKind(AItem->Kind);
  match LKind of
    VarKind.Int8: AValue := int64(ptr to int8(LPlace)^);
    VarKind.Int16: AValue := int64(ptr to int16(LPlace)^);
    VarKind.Int32: AValue := int64(ptr to int32(LPlace)^);
    VarKind.Int64: AValue := ptr to int64(LPlace)^;
    VarKind.UInt8: AValue := int64(ptr to uint8(LPlace)^);
    VarKind.UInt16: AValue := int64(ptr to uint16(LPlace)^);
    VarKind.UInt32: AValue := int64(ptr to uint32(LPlace)^);
    VarKind.UInt64: AValue := int64(ptr to uint64(LPlace)^);
    VarKind.CLong: AValue := int64(ptr to clong(LPlace)^);
    VarKind.CULong: AValue := int64(ptr to culong(LPlace)^);
  else
    return false;
  end;
  AUnsigned := (LKind = VarKind.UInt8) or (LKind = VarKind.UInt16) or
    (LKind = VarKind.UInt32) or (LKind = VarKind.UInt64) or (LKind = VarKind.CULong);
  return true;
end;

// The width or precision a nested `{}` / `{n}` takes from argument AId of the pack at APack:
// libc++'s __substitute_arg_id when the format runs (an id past the pack raises its text),
// the value checked by SpecWidth as the build-time path checks it (a negative one, one past
// the maximum, and no integer raise)
routine DoRunCount(const APack: ptr; const AId: int64): int64;
var
  LHeader: ptr to PackHeader;
  LItems: ptr to PackEntry;
  LValue: int64;
  LUnsigned: bool;
begin
  LHeader := ptr to PackHeader(APack);
  if AId >= int64(LHeader->Count) then
    raise("The argument index value is too large for the number of arguments supplied");
  end;
  LItems := ptr to PackEntry(LHeader->Items);
  if not DoRunInteger(addr of LItems[AId], LValue, LUnsigned) then
    return SpecWidth(0, ADAM_SPEC_WIDTH_NO_INTEGER);
  end;
  if LUnsigned then
    return SpecWidth(LValue, ADAM_SPEC_WIDTH_UNSIGNED);
  end;
  return SpecWidth(LValue, ADAM_SPEC_WIDTH_SIGNED);
end;

// The typed pointer AValue written with the spec words AWords (AWidth / APrecision: an
// argument's, -1 none) to the print sink ASink, by its target's kind (AFacts[0]): to char
// SinkSpecCText, to wchar SinkSpecWideCText, any other SinkSpecAddress
routine DoRunSpecPointer(const ASink: ptr to ptr; const AValue: ptr; const AFacts: ptr to const int64;
  const AWords: ptr to const int64; const AWidth: int64; const APrecision: int64);
var
  LTarget: VarKind;
begin
  LTarget := VarKind(AFacts[0]);
  if LTarget = VarKind.Char then
    SinkSpecCText(ASink, ptr to const char(AValue), AWords, AWidth, APrecision);
    return;
  end;
  if LTarget = VarKind.WChar then
    SinkSpecWideCText(ASink, ptr to const wchar(AValue), AWords, AWidth, APrecision);
    return;
  end;
  SinkSpecAddress(ASink, AValue, AWords, AWidth);
end;

// The pack item AItem written with the spec words AWords (AWidth / APrecision: an
// argument's, -1 none) to the print sink ASink by the SinkSpec* routine the build-time path
// calls for its type (Lowering's DoSpecWriter / DoPrintSpecOf): the same text
routine DoRunSpecValue(const ASink: ptr to ptr; const AItem: ptr to PackEntry;
  const AWords: ptr to const int64; const AWidth: int64; const APrecision: int64);
var
  LPlace: ptr;
  LFacts: ptr to const int64;
  LValue: int64;
  LUnsigned: bool;
begin
  if DoRunInteger(AItem, LValue, LUnsigned) then
    SinkSpecInt(ASink, LValue, LUnsigned, AWords, AWidth);
    return;
  end;
  LPlace := AItem->Place;
  LFacts := AItem->Facts;
  match VarKind(AItem->Kind) of
    VarKind.Float32: SinkSpecFloat32(ASink, ptr to float32(LPlace)^, AWords, AWidth, APrecision);
    VarKind.Float64: SinkSpecFloat64(ASink, ptr to float64(LPlace)^, AWords, AWidth, APrecision);
    VarKind.Bool: SinkSpecBool(ASink, ptr to bool(LPlace)^, AWords, AWidth);
    VarKind.Char: SinkSpecChar(ASink, ptr to char(LPlace)^, AWords, AWidth);
    VarKind.WChar: SinkSpecWideChar(ASink, ptr to wchar(LPlace)^, AWords, AWidth, APrecision);
    VarKind.String: SinkSpecStr(ASink, ptr to ptr(LPlace)^, AWords, AWidth, APrecision);
    VarKind.WString: SinkSpecWideText(ASink, ptr to ptr(LPlace)^, AWords, AWidth, APrecision);
    VarKind.Ptr, VarKind.Routine: SinkSpecAddress(ASink, ptr to ptr(LPlace)^, AWords, AWidth);
    VarKind.Pointer: DoRunSpecPointer(ASink, ptr to ptr(LPlace)^, LFacts, AWords, AWidth,
      APrecision);
    VarKind.Choices: SinkSpecChoice(ASink, DoRunChoiceNumber(LPlace, LFacts), addr of LFacts[1],
      AWords, AWidth, APrecision);
  else
    raise(FormatStr("FormatRun: a pack item of type {} under a run-time format",
      AItem->TypeName));
  end;
end;

type
  // One range level of a run-time placeholder as DoRunRangeParse reads it (libc++'s
  // range_formatter::parse): Spec its own spec as Lowering's DoSpecData writes a range
  // level's (fill, align, the written width or WidthArgument; Words[6] its type: 0, 's',
  // or '?' for ?s), ClearBrackets `n`, Under an element spec written after its ':',
  // ElementAt where its element's spec starts with ElementIndexing / ElementNext the
  // argument numbering there (a nested range level is read again from them each time an
  // element of it is written), Element the spec of an element that is no range and
  // ElementPlain that it writes nothing
  RunRange = record
    Spec: RunSpec;
    ClearBrackets: bool;
    Under: bool;
    ElementAt: int64;
    ElementIndexing: int32;
    ElementNext: int64;
    Element: RunSpec;
    ElementPlain: bool;
  end;

// True when a pack item of the VarKind number AKind is a range a run-time format writes
// element by element (a static array, a set: their facts carry every level below them)
routine DoRunIsRange(const AKind: int64): bool;
begin
  return (VarKind(AKind) = VarKind.StaticArray) or (VarKind(AKind) = VarKind.Set);
end;

// The element of a range whose facts are AFacts (a static array's or a set's: the element's
// VarKind number at word 2, its own facts from word 3) as a pack item at APlace,
// ATypeName the range argument's type text (for an invariant's raise). A scalar element's
// facts are never read
routine DoRunElementEntry(const APlace: ptr; const AFacts: ptr to const int64;
  const ATypeName: ptr to const char): PackEntry;
var
  LEntry: PackEntry;
begin
  LEntry.Tag := 0;
  LEntry.Place := APlace;
  LEntry.TypeName := ATypeName;
  LEntry.Kind := AFacts[2];
  LEntry.Facts := addr of AFacts[3];
  return LEntry;
end;

// A range level's own spec at AText[AAt] into ARange.Spec / ClearBrackets, AAt moved past
// it: libc++'s __parser::__parse with __fields_range as it runs when the format runs:
// nothing at the end, a '}' or a ':' (the range fill takes no ':'); then fill and align,
// the width (DoRunWidth: a leading '0' raises, `{id}` in the fields' numbering AIndexing /
// ANext) and `n`, each ending the spec when the text ends. No sign, `#`, `0`, precision,
// `L` or type is read here (range_formatter reads its type itself: DoRunRangeType)
routine DoRunRangeOwn(const AText: ptr to const char; const ACount: int64; var AAt: int64;
  var ARange: RunRange; var AIndexing: int32; var ANext: int64);
begin
  if (AAt = ACount) or (AText[AAt] = '}') or (AText[AAt] = ':') then
    return;
  end;
  DoRunFillAlign(AText, ACount, AAt, ARange.Spec);
  if AAt = ACount then
    return;
  end;
  DoRunWidth(AText, ACount, AAt, ARange.Spec, AIndexing, ANext);
  if AAt = ACount then
    return;
  end;
  if AText[AAt] = 'n' then
    ARange.ClearBrackets := true;
    AAt := AAt + 1;
  end;
end;

// A range level's type at AText[AAt] (AAt < ACount) into ARange.Spec.Words[6], AAt moved
// past it: libc++'s range_formatter::__parse_type: `m` refused (no element here is a pair),
// `s` and `?s` only for a range of chars (AElementKind, a VarKind number), each refusal by
// libc++'s text; anything else no type
routine DoRunRangeType(const AText: ptr to const char; const ACount: int64; var AAt: int64;
  const AElementKind: int64; var ARange: RunRange);
begin
  if AText[AAt] = 'm' then
    raise("Type m requires a pair or a tuple with two elements");
  end;
  if AText[AAt] = 's' then
    if VarKind(AElementKind) <> VarKind.Char then
      raise("Type s requires character type as formatting argument");
    end;
    ARange.Spec.Words[6] := int64(uint8('s'));
    AAt := AAt + 1;
    return;
  end;
  if AText[AAt] = '?' then
    AAt := AAt + 1;
    if (AAt = ACount) or (AText[AAt] <> 's') then
      raise("The format specifier should consume the input or end with a '}'");
    end;
    if VarKind(AElementKind) <> VarKind.Char then
      raise("Type ?s requires character type as formatting argument");
    end;
    ARange.Spec.Words[6] := int64(uint8('?'));
    AAt := AAt + 1;
  end;
end;

// The range-format-spec of a range level whose facts are AFacts at AText[AAt] into ARange,
// AAt moved past it: libc++'s range_formatter::parse as it runs when the format runs, its
// checks in its order and its texts: the level's own spec (DoRunRangeOwn), its type
// (DoRunRangeType; `n` taking effect after it), then a ':' and the element's spec read by
// the element's own formatter (a range element: its level, read here in full, DoRunRangeParse
// again; any other: DoRunSpec over its formatter's fields, checked by DoRunProcess),
// anything else but the field's '}' libc++'s raise; last the type's own refusals (s / ?s
// with `n` or an element spec). The text ending before the field's '}' ends the parse
// (libc++'s __parse_empty_range_underlying_spec: the field's '}' check raises after).
// Nested widths take their argument ids in the fields' numbering (AIndexing / ANext)
routine DoRunRangeParse(const AText: ptr to const char; const ACount: int64; var AAt: int64;
  const AFacts: ptr to const int64; const ATypeName: ptr to const char; var ARange: RunRange;
  var AIndexing: int32; var ANext: int64);
var
  LElement: PackEntry;
  LNested: RunRange;
  LForm: int64;
  LStart: int64;
  LType: char;
begin
  ARange.Spec := DoRunEmptySpec();
  ARange.ClearBrackets := false;
  ARange.Under := false;
  ARange.Element := DoRunEmptySpec();
  ARange.ElementPlain := true;
  LElement := DoRunElementEntry(nil, AFacts, ATypeName);
  DoRunRangeOwn(AText, ACount, AAt, ARange, AIndexing, ANext);
  if AAt < ACount then
    DoRunRangeType(AText, ACount, AAt, LElement.Kind, ARange);
  end;
  ARange.ElementAt := AAt;
  ARange.ElementIndexing := AIndexing;
  ARange.ElementNext := ANext;
  if AAt = ACount then
    return;
  end;
  ARange.Under := AText[AAt] = ':';
  if ARange.Under then
    AAt := AAt + 1;
    ARange.ElementAt := AAt;
  else
    if AText[AAt] <> '}' then
      raise("The format specifier should consume the input or end with a '}'");
    end;
  end;
  // the element's formatter reads its spec (libc++'s __underlying_.parse), even with no ':'
  // (then at the '}': it reads nothing)
  if DoRunIsRange(LElement.Kind) then
    DoRunRangeParse(AText, ACount, AAt, LElement.Facts, ATypeName, LNested, AIndexing, ANext);
  else
    LForm := DoRunFormOf(addr of LElement);
    LStart := AAt;
    DoRunSpec(AText, ACount, AAt, DoRunFieldsOf(LForm), ARange.Element, AIndexing, ANext);
    DoRunProcess(LForm, ARange.Element);
    ARange.ElementPlain := AAt = LStart;
  end;
  if (AAt < ACount) and (AText[AAt] <> '}') then
    raise("The format specifier should consume the input or end with a '}'");
  end;
  LType := char(ARange.Spec.Words[6] & 0xFF);
  if ARange.Spec.Words[6] = 0 then
    return;
  end;
  if ARange.ClearBrackets then
    if LType = 's' then
      raise("The n option and type s can't be used together");
    end;
    raise("The n option and type ?s can't be used together");
  end;
  if ARange.Under then
    if LType = 's' then
      raise("Type s and an underlying format specification can't be used together");
    end;
    raise("Type ?s and an underlying format specification can't be used together");
  end;
end;

// The pack item AItem, an element of a range that writes no type and no element spec, to
// the print sink ASink in the debug form libc++'s range_formatter sets on its element's
// formatter (__set_debug_format) as PaskalCPP's formatters take it, the build-time path's
// DoPrintDebugOf: a char, a string and a wstring as `?` writes them (DoRunSpecValue); a
// wchar SinkDebugWideChar; a ptr to char / wchar SinkDebugCText / SinkDebugWideCText with
// the `?` spec's words; every other kind, a choices value too, its own text (DoRunValue)
routine DoRunDebug(const ASink: ptr to ptr; const AItem: ptr to PackEntry);
var
  LSpec: RunSpec;
  LWords: ptr to const int64;
  LKind: VarKind;
  LTarget: VarKind;
begin
  LSpec := DoRunEmptySpec();
  LSpec.Words[6] := int64(uint8('?'));
  LWords := ptr to const int64(addr of LSpec.Words[0]);
  LKind := VarKind(AItem->Kind);
  if (LKind = VarKind.Char) or (LKind = VarKind.String) or (LKind = VarKind.WString) then
    DoRunSpecValue(ASink, AItem, LWords, -1, -1);
    return;
  end;
  if LKind = VarKind.WChar then
    SinkDebugWideChar(ASink, ptr to wchar(AItem->Place)^);
    return;
  end;
  if LKind = VarKind.Pointer then
    LTarget := VarKind(AItem->Facts[0]);
    if LTarget = VarKind.Char then
      SinkDebugCText(ASink, ptr to const char(ptr to ptr(AItem->Place)^), LWords);
      return;
    end;
    if LTarget = VarKind.WChar then
      SinkDebugWideCText(ASink, ptr to const wchar(ptr to ptr(AItem->Place)^), LWords);
      return;
    end;
  end;
  DoRunValue(ASink, AItem);
end;

// A range level of a run-time format (its spec at AText[AAt], numbered from AIndexing /
// ANext) and its every element, written (DoRunRange below)
forward routine DoRunRange(const ASink: ptr to ptr; const AText: ptr to const char;
  const ACount: int64; const AAt: int64; const AIndexing: int32; const ANext: int64;
  const AItem: ptr to PackEntry; const APack: ptr);

// The element AElement of a range level read as ARange to the print sink ASink, as the
// build-time path's DoRangeElement / DoRangeValue write one: a range element of a level
// with no type its own level (DoRunRange from ARange.ElementAt and its numbering); with `s` /
// `?s` a char in its own text; with an element spec its spec (one that writes nothing: its
// own text; a nested width / precision taken now, per element, as libc++ formats each:
// DoRunCount from the pack at APack); with none the debug form (DoRunDebug)
routine DoRunRangeElement(const ASink: ptr to ptr; const AText: ptr to const char;
  const ACount: int64; const ARange: RunRange; const AElement: ptr to PackEntry; const APack: ptr);
var
  LSpec: RunSpec;
  LWidth: int64;
  LPrecision: int64;
begin
  if (ARange.Spec.Words[6] = 0) and DoRunIsRange(AElement->Kind) then
    DoRunRange(ASink, AText, ACount, ARange.ElementAt, ARange.ElementIndexing, ARange.ElementNext,
      AElement, APack);
    return;
  end;
  if (ARange.Spec.Words[6] <> 0) or (ARange.Under and ARange.ElementPlain) then
    DoRunValue(ASink, AElement);
    return;
  end;
  if not ARange.Under then
    DoRunDebug(ASink, AElement);
    return;
  end;
  LSpec := ARange.Element;
  LWidth := -1;
  if LSpec.WidthArgument >= 0 then
    LWidth := DoRunCount(APack, LSpec.WidthArgument);
  end;
  LPrecision := -1;
  if LSpec.PrecisionArgument >= 0 then
    LPrecision := DoRunCount(APack, LSpec.PrecisionArgument);
  end;
  DoRunSpecValue(ASink, AElement, ptr to const int64(addr of LSpec.Words[0]), LWidth, LPrecision);
end;

// The elements of the range pack item AItem (a static array: its elements at its place,
// one stride apart; a set: its members, ascending, from its bytes' bits) to the print sink
// ASink as libc++'s range_formatter writes them with the level read as ARange: `s` / `?s`
// one after another; else `[` and `]` around them unless `n`, ", " between them; each by
// DoRunRangeElement (a set's member as a pack item at a scratch word holding its value:
// every member kind is read from its low bytes, x86_64 being little-endian)
routine DoRunRangeElements(const ASink: ptr to ptr; const AText: ptr to const char;
  const ACount: int64; const ARange: RunRange; const AItem: ptr to PackEntry; const APack: ptr);
var
  LFacts: ptr to const int64;
  LBytes: ptr to uint8;
  LSequence: bool;
  LBrackets: bool;
  LFirst: bool;
  LMember: int64;
  LElement: PackEntry;
  LI: int64;
begin
  LFacts := AItem->Facts;
  LBytes := ptr to uint8(AItem->Place);
  LSequence := ARange.Spec.Words[6] = 0;
  LBrackets := LSequence and (not ARange.ClearBrackets);
  if LBrackets then
    SinkLiteral(ASink, ptr to const char("["));
  end;
  LFirst := true;
  if VarKind(AItem->Kind) = VarKind.Set then
    for LI := 0 to LFacts[1] - LFacts[0] do
      // the member's bit: bit LI mod 8 of byte LI div 8
      if ((int64(LBytes[LI shr 3]) shr (LI & 7)) & 1) <> 0 then
        if LSequence and (not LFirst) then
          SinkLiteral(ASink, ptr to const char(", "));
        end;
        LFirst := false;
        LMember := LFacts[0] + LI;
        LElement := DoRunElementEntry(ptr(addr of LMember), LFacts, AItem->TypeName);
        DoRunRangeElement(ASink, AText, ACount, ARange, addr of LElement, APack);
      end;
    end;
  else
    for LI := 0 to LFacts[0] - 1 do
      if LSequence and (LI > 0) then
        SinkLiteral(ASink, ptr to const char(", "));
      end;
      LElement := DoRunElementEntry(ptr(addr of LBytes[LI * LFacts[1]]), LFacts, AItem->TypeName);
      DoRunRangeElement(ASink, AText, ACount, ARange, addr of LElement, APack);
    end;
  end;
  if LBrackets then
    SinkLiteral(ASink, ptr to const char("]"));
  end;
end;

// The range pack item AItem (a static array or a set) to the print sink ASink with its
// level's spec at AText[AAt], read again from the argument numbering it started at
// (AIndexing / ANext: the field's own read checked it already, DoRunField) as the
// build-time path's DoPrintRangeOf writes it: with a width or `?s` the width first (an
// argument's: DoRunCount, before the elements, as std::format reads a range's spec), then
// the elements into a scratch string, then that string by the string formatter with the
// level's spec (SinkSpecStr: fill, align, width, `?s` the debug form, no precision), the
// scratch released however the writing ends; else the elements straight to ASink
routine DoRunRange(const ASink: ptr to ptr; const AText: ptr to const char;
  const ACount: int64; const AAt: int64; const AIndexing: int32; const ANext: int64;
  const AItem: ptr to PackEntry; const APack: ptr);
var
  LRange: RunRange;
  LAt: int64;
  LIndexing: int32;
  LNext: int64;
  LWidth: int64;
  LScratch: ptr;
begin
  LAt := AAt;
  LIndexing := AIndexing;
  LNext := ANext;
  DoRunRangeParse(AText, ACount, LAt, AItem->Facts, AItem->TypeName, LRange, LIndexing, LNext);
  if (LRange.Spec.Words[5] = 0) and (LRange.Spec.WidthArgument < 0) and
    (char(LRange.Spec.Words[6] & 0xFF) <> '?') then
    DoRunRangeElements(ASink, AText, ACount, LRange, AItem, APack);
    return;
  end;
  LWidth := -1;
  if LRange.Spec.WidthArgument >= 0 then
    LWidth := DoRunCount(APack, LRange.Spec.WidthArgument);
  end;
  LScratch := nil;
  guard
    DoRunRangeElements(addr of LScratch, AText, ACount, LRange, AItem, APack);
    SinkSpecStr(ASink, LScratch, ptr to const int64(addr of LRange.Spec.Words[0]), LWidth, -1);
  finally
    StrRelease(LScratch);
  end;
end;

// The argument AItem of a replacement field (no range) written by its format-spec at
// AText[AAt], AAt moved past the spec: the spec read by the argument's formatter
// (DoRunSpec, its nested widths in the fields' numbering AIndexing / ANext); nothing
// written: its plain print form (DoRunValue); else the spec checked (DoRunProcess) and the
// argument written by it (DoRunSpecValue), an argument's width / precision taken then
// (DoRunCount from the pack at APack)
routine DoRunScalarField(const ASink: ptr to ptr; const AText: ptr to const char;
  const ACount: int64; var AAt: int64; const AItem: ptr to PackEntry; const APack: ptr;
  var AIndexing: int32; var ANext: int64);
var
  LStart: int64;
  LForm: int64;
  LSpec: RunSpec;
  LWidth: int64;
  LPrecision: int64;
begin
  LForm := DoRunFormOf(AItem);
  LSpec := DoRunEmptySpec();
  LStart := AAt;
  DoRunSpec(AText, ACount, AAt, DoRunFieldsOf(LForm), LSpec, AIndexing, ANext);
  if AAt = LStart then
    DoRunValue(ASink, AItem);
    return;
  end;
  DoRunProcess(LForm, LSpec);
  // libc++ takes the width first, then the precision, as the field is formatted
  LWidth := -1;
  if LSpec.WidthArgument >= 0 then
    LWidth := DoRunCount(APack, LSpec.WidthArgument);
  end;
  LPrecision := -1;
  if LSpec.PrecisionArgument >= 0 then
    LPrecision := DoRunCount(APack, LSpec.PrecisionArgument);
  end;
  DoRunSpecValue(ASink, AItem, ptr to const int64(addr of LSpec.Words[0]), LWidth, LPrecision);
end;

// The range argument AItem (a static array or a set) of a replacement field written by its
// range-format-spec at AText[AAt], AAt moved past the spec: read in full first
// (DoRunRangeParse: every refusal raised before anything is written, the fields' numbering
// AIndexing / ANext moved past its nested ids, as libc++ parses before it formats), then
// written (DoRunRange) from where it started and the numbering it started from
routine DoRunRangeField(const ASink: ptr to ptr; const AText: ptr to const char;
  const ACount: int64; var AAt: int64; const AItem: ptr to PackEntry; const APack: ptr;
  var AIndexing: int32; var ANext: int64);
var
  LRange: RunRange;
  LStart: int64;
  LIndexing: int32;
  LNext: int64;
begin
  LStart := AAt;
  LIndexing := AIndexing;
  LNext := ANext;
  DoRunRangeParse(AText, ACount, AAt, AItem->Facts, AItem->TypeName, LRange, AIndexing, ANext);
  DoRunRange(ASink, AText, ACount, LStart, LIndexing, LNext, AItem, APack);
end;

// The replacement field of a run-time format whose text after its '{' starts at
// AText[AAt], its argument written from the pack at APack (FormatRun): libc++'s
// __handle_replacement_field, its checks in its order and its raises' texts: the argument
// index (DoRunArgId), the index ending at ':' or '}', within the pack, then the argument
// written by its format-spec (a range DoRunRangeField, any other DoRunScalarField; nested
// widths in the same numbering), then the field's closing '}'. The offset after it
routine DoRunField(const ASink: ptr to ptr; const AText: ptr to const char; const ACount: int64;
  const AAt: int64; const APack: ptr; var AIndexing: int32; var ANext: int64): int64;
var
  LHeader: ptr to PackHeader;
  LItems: ptr to PackEntry;
  LItem: ptr to PackEntry;
  LAt: int64;
  LIndex: int64;
begin
  LAt := AAt;
  LIndex := DoRunArgId(AText, ACount, LAt, AIndexing, ANext);
  if (LAt = ACount) or ((AText[LAt] <> ':') and (AText[LAt] <> '}')) then
    raise("The argument index should end with a ':' or a '}'");
  end;
  if AText[LAt] = ':' then
    LAt := LAt + 1;
  end;
  LHeader := ptr to PackHeader(APack);
  if LIndex >= int64(LHeader->Count) then
    raise("The argument index value is too large for the number of arguments supplied");
  end;
  LItems := ptr to PackEntry(LHeader->Items);
  LItem := addr of LItems[LIndex];
  if DoRunIsRange(LItem->Kind) then
    DoRunRangeField(ASink, AText, ACount, LAt, LItem, APack, AIndexing, ANext);
  else
    DoRunScalarField(ASink, AText, ACount, LAt, LItem, APack, AIndexing, ANext);
  end;
  // libc++ formats the argument before it looks for the field's '}'
  if (LAt = ACount) or (AText[LAt] <> '}') then
    raise("The replacement field misses a terminating '}'");
  end;
  return LAt + 1;
end;

// print / println / FormatStr with a format known only at run time (BNF sec 7, M3.8i):
// the string AFormat walked as libc++'s __vformat_to walks it, its text written to the
// print sink ASink, each replacement field's argument from the typed pack at APack (the
// call's arguments after the format, Lowering DoPackArguments) in its print form
// (DoRunField); `{{` and `}}` one brace each. A text that does not fit its arguments
// raises with code 1 and libc++'s std::format_error text (the caller writes into a
// scratch string first, so nothing reaches stdout before the raise)
routine FormatRun(const ASink: ptr to ptr; const AFormat: ptr; const APack: ptr);
var
  LBytes: ptr to uint8;
  LHeader: ptr to int64;
  LText: ptr to const char;
  LCount: int64;
  LAt: int64;
  LStart: int64;
  LIndexing: int32;
  LNext: int64;
begin
  if AFormat = nil then
    return;
  end;
  // a string's block: its reference count and length (int64 each), then its bytes
  LBytes := ptr to uint8(AFormat);
  LHeader := ptr to int64(AFormat);
  LText := ptr to const char(addr of LBytes[16]);
  LCount := LHeader[1];
  LAt := 0;
  LStart := 0;
  LIndexing := ADAM_RUNTIME_FORMAT_UNKNOWN;
  LNext := 0;
  // LStart is where the text not yet written begins; each brace writes it up to itself
  while LAt < LCount do
    if LText[LAt] = '{' then
      if LAt + 1 = LCount then
        raise("The format string terminates at a '{'");
      end;
      if LText[LAt + 1] = '{' then
        DoRunText(ASink, LText, LStart, LAt + 1);
        LAt := LAt + 2;
      else
        DoRunText(ASink, LText, LStart, LAt);
        LAt := DoRunField(ASink, LText, LCount, LAt + 1, APack, LIndexing, LNext);
      end;
      LStart := LAt;
    else
      if LText[LAt] = '}' then
        if (LAt + 1 = LCount) or (LText[LAt + 1] <> '}') then
          raise("The format string contains an invalid escape sequence");
        end;
        DoRunText(ASink, LText, LStart, LAt + 1);
        LAt := LAt + 2;
        LStart := LAt;
      else
        LAt := LAt + 1;
      end;
    end;
  end;
  DoRunText(ASink, LText, LStart, LCount);
end;

// A new string of the C string AText's bytes (up to its NUL), a reference the caller
// holds; nil for an empty one
routine TextOfC(const AText: ptr to const char): ptr;
var
  LLength: int64;
  LBlock: ptr;
  LTo: ptr to uint8;
begin
  LLength := 0;
  while AText[LLength] <> '\0' do
    LLength := LLength + 1;
  end;
  if LLength = 0 then
    return nil;
  end;
  LBlock := TextNew(LLength, 1);
  LTo := ptr to uint8(LBlock);
  PlatformCopy(addr of LTo[16], ptr(AText), LLength);
  return LBlock;
end;

// A new string of AValue's decimal digits, a '-' before a negative one, a reference the
// caller holds
routine IntText(const AValue: int64): ptr;
var
  LDigits: array[0..23] of char;
  LAt: int64;
  LRest: uint64;
  LBlock: ptr;
  LTo: ptr to uint8;
begin
  // The magnitude is taken as uint64 so the most negative int64 has one too; the digits
  // are written from the end of LDigits back toward its start
  if AValue < 0 then
    LRest := uint64(0) - uint64(AValue);
  else
    LRest := uint64(AValue);
  end;
  LAt := 24;
  repeat
    LAt := LAt - 1;
    LDigits[LAt] := char(48 + int64(LRest mod 10));
    LRest := LRest div 10;
  until LRest = 0;
  if AValue < 0 then
    LAt := LAt - 1;
    LDigits[LAt] := '-';
  end;
  LBlock := TextNew(24 - LAt, 1);
  LTo := ptr to uint8(LBlock);
  PlatformCopy(addr of LTo[16], addr of LDigits[LAt], 24 - LAt);
  return LBlock;
end;

// ALeft followed by ARight, both references taken over (released here), a reference the
// caller holds
routine TextJoinTaken(const ALeft: ptr; const ARight: ptr): ptr;
var
  LJoined: ptr;
begin
  LJoined := StrConcat(ALeft, ARight);
  StrRelease(ALeft);
  StrRelease(ARight);
  return LJoined;
end;

// A set literal's item computed at run time (AValue) that lies outside its set's members
// ALow..AHigh: raised with PaskalCPP's code and text for it (EXC_SET_RANGE 11, `set element
// N is out of range L..H`, pcpp's raise_set_range); it never returns. An item converts
// implicitly to the set's element type (SEM), so its value always fits int64 (pcpp's
// `set element above ...` form has no Adam source that reaches it)
routine SetRange(const AValue: int64; const ALow: int64; const AHigh: int64); noreturn;
var
  LText: ptr;
begin
  LText := TextJoinTaken(TextOfC(ptr to const char("set element ")), IntText(AValue));
  LText := TextJoinTaken(LText, TextOfC(ptr to const char(" is out of range ")));
  LText := TextJoinTaken(LText, IntText(ALow));
  LText := TextJoinTaken(LText, TextOfC(ptr to const char("..")));
  LText := TextJoinTaken(LText, IntText(AHigh));
  RaiseWith(11, LText);
end;

const
  // The index check's code (M3.11a, his WHAT 2026-11-10: after PaskalCPP's 13; PaskalCPP
  // checks no index)
  ADAM_RUNTIME_EXC_INDEX: int32 = 14;

// A static array's index AIndex (widened to int64) outside its bounds ALow..AHigh, the
// compiler's index check found (Lowering's cold block): raised with code 14, `index N is
// out of bounds L..H` (the set range's wording); it never returns
routine IndexFail(const AIndex: int64; const ALow: int64; const AHigh: int64); noreturn;
var
  LText: ptr;
begin
  LText := TextJoinTaken(TextOfC(ptr to const char("index ")), IntText(AIndex));
  LText := TextJoinTaken(LText, TextOfC(ptr to const char(" is out of bounds ")));
  LText := TextJoinTaken(LText, IntText(ALow));
  LText := TextJoinTaken(LText, TextOfC(ptr to const char("..")));
  LText := TextJoinTaken(LText, IntText(AHigh));
  RaiseWith(ADAM_RUNTIME_EXC_INDEX, LText);
end;

// The index AIndex outside the units or elements of ABlock (a string's, a wstring's or a
// dynamic array's block, nil when empty: its length StrLength's), the compiler's index check
// found: raised with code 14, `index N is out of bounds 0..H` (H the last index), or `index
// N is out of bounds: it is empty`; it never returns
routine IndexFailIn(const AIndex: int64; const ABlock: ptr); noreturn;
var
  LLength: int64;
  LText: ptr;
begin
  LLength := StrLength(ABlock);
  if LLength = 0 then
    LText := TextJoinTaken(TextOfC(ptr to const char("index ")), IntText(AIndex));
    LText := TextJoinTaken(LText, TextOfC(ptr to const char(" is out of bounds: it is empty")));
    RaiseWith(ADAM_RUNTIME_EXC_INDEX, LText);
  end;
  IndexFail(AIndex, 0, LLength - 1);
end;

const
  // The hardware faults' codes (PaskalCPP's EXC_DIV_BY_ZERO, EXC_ACCESS_VIOLATION,
  // EXC_STACK_OVERFLOW, EXC_INTEGER_OVERFLOW, EXC_ILLEGAL_INSTRUCTION, EXC_BUS_ERROR,
  // EXC_UNKNOWN: the platform's fault kinds). Access violation is also the nil owner
  // check's code (M3.11b: PaskalCPP's raise_nil_owner raises with it)
  ADAM_RUNTIME_EXC_DIVIDE: int32 = ADAM_PLATFORM_FAULT_DIVIDE;
  ADAM_RUNTIME_EXC_ACCESS_VIOLATION: int32 = ADAM_PLATFORM_FAULT_ACCESS;
  ADAM_RUNTIME_EXC_STACK_OVERFLOW: int32 = ADAM_PLATFORM_FAULT_STACK;
  ADAM_RUNTIME_EXC_OVERFLOW: int32 = ADAM_PLATFORM_FAULT_OVERFLOW;
  ADAM_RUNTIME_EXC_INSTRUCTION: int32 = ADAM_PLATFORM_FAULT_INSTRUCTION;
  ADAM_RUNTIME_EXC_BUS: int32 = ADAM_PLATFORM_FAULT_BUS;
  // The longest fault report line FaultUnhandled builds (PaskalCPP's 96-byte buffer)
  ADAM_RUNTIME_FAULT_LINE: int64 = 96;

// An object reached through a nil ref (a field, a method's self), the compiler's nil owner
// check found (Lowering's cold block): raised with code 3, `access through a nil own / ref`
// (PaskalCPP's raise_nil_owner); it never returns
routine NilOwnerFail(); noreturn;
begin
  RaiseWith(ADAM_RUNTIME_EXC_ACCESS_VIOLATION,
    TextOfC(ptr to const char("access through a nil own / ref")));
end;

// The text of the hardware fault code ACode, the same on every target (PaskalCPP's
// fault_text)
routine FaultText(const ACode: int32): ptr to const char;
begin
  if ACode = ADAM_RUNTIME_EXC_DIVIDE then
    return ptr to const char("Divide by zero");
  end;
  if ACode = ADAM_RUNTIME_EXC_ACCESS_VIOLATION then
    return ptr to const char("Access violation");
  end;
  if ACode = ADAM_RUNTIME_EXC_STACK_OVERFLOW then
    return ptr to const char("Stack overflow");
  end;
  if ACode = ADAM_RUNTIME_EXC_OVERFLOW then
    return ptr to const char("Numeric overflow");
  end;
  if ACode = ADAM_RUNTIME_EXC_INSTRUCTION then
    return ptr to const char("Illegal instruction");
  end;
  if ACode = ADAM_RUNTIME_EXC_BUS then
    return ptr to const char("Bus error");
  end;
  return ptr to const char("Hardware exception");
end;

// A guard's except part's first act (Lowering's DoGuard calls it): a hardware fault the
// guard's filter took (PlatformFaultTaken) becomes the raise in flight, its code and text
// PaskalCPP's (FaultText), so exccode / excmsg and a reraise see it as any raise (BNF sec
// 5); after a raise nothing changes. A caught stack overflow's guard page is made again
routine FaultTaken();
var
  LCode: int32;
begin
  LCode := PlatformFaultTaken();
  if LCode = 0 then
    return;
  end;
  StrRelease(GRaiseText);
  GRaiseText := TextOfC(FaultText(LCode));
  GRaiseCode := LCode;
end;

// A hardware fault no guard took (the platform's last filter, PlatformAtFault), reported as
// PaskalCPP's report_unguarded_fault does, the same on every target: `unhandled exception
// <code>: <text>` and a newline to stderr in one system call, then the process ends at once
// with exit code 1. Nothing was unwound and no teardown runs (BNF sec 1); the line is built
// in a fixed buffer with no heap or stdio call (the faulting code may hold their locks, a
// stack overflow left little stack); output the program had not flushed stays lost
routine FaultUnhandled(const ACode: int32);
var
  LLine: array[0..95] of char;
  LDigits: array[0..11] of char;
  LLength: int64;
  LCount: int64;
  LValue: uint32;
  LText: ptr to const char;
  LPrefix: ptr to const char;
  LI: int64;
begin
  LLength := 0;
  LPrefix := ptr to const char("unhandled exception ");
  LI := 0;
  while LPrefix[LI] <> '\0' do
    LLine[LLength] := LPrefix[LI];
    LLength := LLength + 1;
    LI := LI + 1;
  end;
  // the code in decimal, its digits found last first
  LValue := uint32(ACode);
  LCount := 0;
  repeat
    LDigits[LCount] := char(48 + int64(LValue mod 10));
    LCount := LCount + 1;
    LValue := LValue div 10;
  until (LValue = 0) or (LCount > 11);
  while LCount > 0 do
    LCount := LCount - 1;
    LLine[LLength] := LDigits[LCount];
    LLength := LLength + 1;
  end;
  LLine[LLength] := ':';
  LLine[LLength + 1] := ' ';
  LLength := LLength + 2;
  // the text cut where only its newline still fits
  LText := FaultText(ACode);
  LI := 0;
  while (LText[LI] <> '\0') and (LLength < ADAM_RUNTIME_FAULT_LINE - 1) do
    LLine[LLength] := LText[LI];
    LLength := LLength + 1;
    LI := LI + 1;
  end;
  LLine[LLength] := '\n';
  LLength := LLength + 1;
  PlatformWriteErrorDirect(ptr(addr of LLine[0]), LLength);
  PlatformTerminate(1);
end;

const
  // A failed `as`'s code (I1, BNF sec 6 is / as): PaskalCPP's EXC_INVALID_CAST
  ADAM_RUNTIME_EXC_INVALID_CAST: int32 = 13;
  // The words of a TypeInfo (I1, Lowering's DoTypeInfo): a polymorphic object type's or an
  // interface's read-only blob, word 0 its parent's TypeInfo (nil at a root), word 1 its
  // name (zero-terminated, as source writes the type), word 2 the count of its interface
  // entries (I3; 0 for an interface), then per entry two words: an interface's TypeInfo
  // and the offset of the object's itable word for it from the object's start (every
  // interface the type or a level above implements); a vtable's word before slot 0 holds
  // its type's TypeInfo
  ADAM_RUNTIME_TYPEINFO_PARENT: int64 = 0;
  ADAM_RUNTIME_TYPEINFO_NAME: int64 = 1;
  ADAM_RUNTIME_TYPEINFO_ENTRIES: int64 = 2;

// True when the object type whose TypeInfo is AInfo is the type whose TypeInfo is ATarget,
// or a descendant of it (`X is T`, a checked `as`): ATarget is met walking AInfo's parents
routine IsInstance(const AInfo: ptr; const ATarget: ptr): bool;
var
  LAt: ptr to ptr;
begin
  LAt := ptr to ptr(AInfo);
  while LAt <> nil do
    if ptr(LAt) = ATarget then
      return true;
    end;
    LAt := ptr to ptr(LAt[ADAM_RUNTIME_TYPEINFO_PARENT]);
  end;
  return false;
end;

// The offset of the itable word for the interface whose TypeInfo is ATarget in an object
// of the type whose TypeInfo is AInfo (`X is I`, `X as I`, I3), -1 when the type implements
// no such interface: the first entry whose interface is ATarget or a child interface of it
// (an interface's itable starts with its parent's slots: one word serves both)
routine InterfaceOffset(const AInfo: ptr; const ATarget: ptr): int64;
var
  LWords: ptr to ptr;
  LCounts: ptr to int64;
  LCount: int64;
  LI: int64;
  LAt: ptr to ptr;
begin
  LWords := ptr to ptr(AInfo);
  LCounts := ptr to int64(AInfo);
  LCount := LCounts[ADAM_RUNTIME_TYPEINFO_ENTRIES];
  for LI := 0 to LCount - 1 do
    LAt := ptr to ptr(LWords[ADAM_RUNTIME_TYPEINFO_ENTRIES + 1 + LI * 2]);
    while LAt <> nil do
      if ptr(LAt) = ATarget then
        return LCounts[ADAM_RUNTIME_TYPEINFO_ENTRIES + 2 + LI * 2];
      end;
      LAt := ptr to ptr(LAt[ADAM_RUNTIME_TYPEINFO_PARENT]);
    end;
  end;
  return -1;
end;

// A failed `as` (the object is no T, T's TypeInfo ATarget): raised with code 13, `invalid
// cast: the object is not a T` (PaskalCPP's EXC_INVALID_CAST); it never returns
routine InvalidCast(const ATarget: ptr); noreturn;
var
  LWords: ptr to ptr;
begin
  LWords := ptr to ptr(ATarget);
  RaiseWith(ADAM_RUNTIME_EXC_INVALID_CAST, TextJoinTaken(TextOfC(ptr to const char(
    "invalid cast: the object is not a ")), TextOfC(ptr to const char(LWords[ADAM_RUNTIME_TYPEINFO_NAME]))));
end;

// The memory check's raise (getmem / resizemem / setlength: PaskalCPP's EXC_MEMORY texts):
// code 12 with the text ABefore, AValue's digits, AAfter; it never returns. The text takes
// blocks of its own, so a heap with no room at all could fail again while it is built:
// that second failure (GMemoryFailing) raises code 12 with the empty text, which needs no
// block, so it ends instead of failing again without end
routine MemoryFail(const ABefore: ptr to const char; const AValue: int64;
  const AAfter: ptr to const char); noreturn;
var
  LText: ptr;
begin
  if GMemoryFailing then
    GMemoryFailing := false;
    RaiseWith(ADAM_RUNTIME_EXC_MEMORY, nil);
  end;
  GMemoryFailing := true;
  LText := TextJoinTaken(TextOfC(ABefore), IntText(AValue));
  LText := TextJoinTaken(LText, TextOfC(AAfter));
  GMemoryFailing := false;
  RaiseWith(ADAM_RUNTIME_EXC_MEMORY, LText);
end;

// A raise nothing caught, reported as PaskalCPP's runtime reports it (report_unhandled):
// what the program wrote to stdout flushed first, then `unhandled exception <code>: <text>`
// and a newline to stderr, then the process ends with exit code 1 through Halt, so the exit
// handlers run (BNF sec 1: each module's teardown, then the heap report; a raise inside a
// teardown ends the process at once). The frames between the raise and the entry are unwound
// before it runs (their finally and cleanup funclets ran). The entry's catching scope runs it
// on the main thread, a module teardown's in its finalize, ThreadRun's on a started one, each
// with its own raise in flight; when two threads get here, the first reports and ends the
// process and the other waits for that end, so one whole report is all that is printed (a
// task's thread that waits leaves the running tasks first: the exit never waits for it)
forward routine TaskLeave();

routine Unhandled();
var
  LHeader: ptr to int64;
  LBytes: ptr to uint8;
begin
  if atomicswap(GUnhandled, 1) <> 0 then
    TaskLeave();
    while true do
      PlatformSleep(1000);
    end;
  end;
  PlatformFlush();
  WriteErrorC(ptr to const char("unhandled exception "));
  WriteIntTo(int64(GRaiseCode), true);
  WriteErrorC(ptr to const char(": "));
  if GRaiseText <> nil then
    LHeader := ptr to int64(GRaiseText);
    LBytes := ptr to uint8(GRaiseText);
    PlatformWriteError(addr of LBytes[16], LHeader[1]);
  end;
  WriteErrorC(ptr to const char("\n"));
  Halt(1);
end;

const
  // The block ThreadStart hands out per thread: its entry (ptr), its argument (ptr), then
  // its OS handle (uint64)
  ADAM_RUNTIME_THREAD_BLOCK: int64 = 24;

public type
  // A started thread's entry (ThreadStart): a routine of one pointer, the argument
  // ThreadStart was given; the thread ends when it returns
  ThreadEntry = routine(const AArg: ptr);

// A started thread's own start (PlatformThreadStart runs it on the new thread): its entry
// and argument read from ABlock (ThreadStart's), then the entry called. The compiler gives
// this routine the last catching scope the entry has (Lowering's DoCatchAll, its catch
// Unhandled), so a raise nothing in the entry catches is reported and ends the process as
// on the main thread, and a hardware fault no guard took goes on to the platform's last
// filter (FaultUnhandled) as there. What the thread holds in its threadstatics is released
// as it ends (ThreadEnded)
routine ThreadRun(const ABlock: ptr);
var
  LSlots: ptr to ptr;
  LEntry: ThreadEntry;
  LArg: ptr;
begin
  LSlots := ptr to ptr(ABlock);
  LEntry := ThreadEntry(LSlots[0]);
  LArg := LSlots[1];
  LEntry(LArg);
end;

// The compiler's release of a thread's managed threadstatics, ARelease (the entry hands it
// over before the program's first statement, when the program has one), kept for
// ThreadEnded
routine SetThreadRelease(const ARelease: routine());
begin
  GThreadRelease := ARelease;
end;

// Run on each thread but the main one as it ends, whoever started it (the platform's thread
// end, PlatformAtThreadEnd): its raise in flight released, then the program's managed
// threadstatics (GThreadRelease), as the main thread's are at the program's end
routine ThreadEnded();
var
  LRelease: routine();
begin
  StrRelease(GRaiseText);
  GRaiseText := nil;
  GRaiseCode := 0;
  LRelease := GThreadRelease;
  if ptr(LRelease) <> nil then
    LRelease();
  end;
end;

// A new thread running AEntry(AArg), started at once: its handle for ThreadJoin, or nil
// when it could not be started (no room, or the OS refused). Every started thread is
// joined: ThreadJoin waits for its end and frees what the handle holds. A runtime routine a
// program may name (see the header)
public routine ThreadStart(const AEntry: ThreadEntry; const AArg: ptr): ptr;
var
  LBlock: ptr;
  LSlots: ptr to ptr;
  LWords: ptr to uint64;
  LHandle: uint64;
begin
  LBlock := DoGetMem(ADAM_RUNTIME_THREAD_BLOCK);
  if LBlock = nil then
    return nil;
  end;
  // The entry and its argument are in place before the thread starts; the OS handle is
  // written after it, into the word the thread never reads
  LSlots := ptr to ptr(LBlock);
  LSlots[0] := ptr(AEntry);
  LSlots[1] := AArg;
  LWords := ptr to uint64(LBlock);
  LWords[2] := 0;
  LHandle := PlatformThreadStart(ThreadRun, LBlock);
  if LHandle = 0 then
    FreeMem(LBlock);
    return nil;
  end;
  LWords[2] := LHandle;
  return LBlock;
end;

// Waits for the thread AThread (ThreadStart's) to end, then frees what its handle holds;
// nil does nothing. A runtime routine a program may name (see the header)
public routine ThreadJoin(const AThread: ptr);
var
  LWords: ptr to uint64;
begin
  if AThread = nil then
    return;
  end;
  LWords := ptr to uint64(AThread);
  PlatformThreadJoin(LWords[2]);
  FreeMem(AThread);
end;

// The thread AThread (ThreadStart's, non-nil) joined only if it has ended already, never
// waiting: true with what its handle holds freed; false leaves it as it was
routine ThreadTryJoin(const AThread: ptr): bool;
var
  LWords: ptr to uint64;
begin
  LWords := ptr to uint64(AThread);
  if not PlatformThreadTryJoin(LWords[2]) then
    return false;
  end;
  FreeMem(AThread);
  return true;
end;

// The thread AThread (ThreadStart's, non-nil) never joined: its handle given back and what
// it holds freed while the thread may still run (a task's thread doing so for itself as
// the process ends from it: TaskLeave)
routine ThreadDetach(const AThread: ptr);
var
  LWords: ptr to uint64;
begin
  LWords := ptr to uint64(AThread);
  PlatformThreadDetach(LWords[2]);
  FreeMem(AThread);
end;

public type
  // A for parallel's body (the compiler's, one per loop, T2): its frame (the addresses of
  // the routine's variables it uses), the iterator's value as 64 bits, the worker running
  // it (0 .. ACount - 1) and the workers' count; true when the body ran `leave`
  ParallelEntry = routine(const AFrame: ptr; const AValue: int64; const AWorker: int64;
    const ACount: int64): bool;

const
  // The words of a for parallel's run (ParallelRun's block, shared by its workers): its
  // body (ptr), its frame (ptr), the first value, the step (1 or -1), the last iteration's
  // index (counted from 0: the span), the iterations of one chunk, the chunks, the workers,
  // the next chunk to take (atomicadd), the stop word (1 once a leave or a raise stops new
  // iterations), the raised word (1 once a raise is kept), that raise's code and text (a
  // string value it holds one reference to)
  ADAM_RUNTIME_PARALLEL_ENTRY: int64 = 0;
  ADAM_RUNTIME_PARALLEL_FRAME: int64 = 1;
  ADAM_RUNTIME_PARALLEL_FIRST: int64 = 2;
  ADAM_RUNTIME_PARALLEL_STEP: int64 = 3;
  ADAM_RUNTIME_PARALLEL_SPAN: int64 = 4;
  ADAM_RUNTIME_PARALLEL_CHUNK: int64 = 5;
  ADAM_RUNTIME_PARALLEL_CHUNKS: int64 = 6;
  ADAM_RUNTIME_PARALLEL_WORKERS: int64 = 7;
  ADAM_RUNTIME_PARALLEL_NEXT: int64 = 8;
  ADAM_RUNTIME_PARALLEL_STOP: int64 = 9;
  ADAM_RUNTIME_PARALLEL_RAISED: int64 = 10;
  ADAM_RUNTIME_PARALLEL_CODE: int64 = 11;
  ADAM_RUNTIME_PARALLEL_TEXT: int64 = 12;
  // The task whose call runs the loop (its starter's GTaskCurrent, T3): every worker's
  // cancelled() reads it
  ADAM_RUNTIME_PARALLEL_TASK: int64 = 13;
  ADAM_RUNTIME_PARALLEL_WORDS: int64 = 14;
  // ParallelRun's flags (the compiler's): a downto loop, unsigned bounds, a workers' count
  // written
  ADAM_RUNTIME_PARALLEL_DOWNTO: int64 = 1;
  ADAM_RUNTIME_PARALLEL_UNSIGNED: int64 = 2;
  ADAM_RUNTIME_PARALLEL_GIVEN: int64 = 4;
  // The chunks a worker's share is cut into (a worker that is done early takes another)
  ADAM_RUNTIME_PARALLEL_SHARE: uint64 = 16;

// One worker of the for parallel AShared (ParallelRun's block), the worker AWorker: chunk
// after chunk taken until none is left or the stop word is set, each iteration's value
// handed to the body (a leave sets the stop word: no new iteration starts). A raise in the
// body sets it too; the first one is kept (its code and a reference to its text) for
// ParallelRun to raise again once every worker is done
routine ParallelWork(const AShared: ptr; const AWorker: int64);
var
  LWords: ptr to int64;
  LSlots: ptr to ptr;
  LEntry: ParallelEntry;
  LFrame: ptr;
  LFirst: uint64;
  LDown: bool;
  LSpan: uint64;
  LChunk: uint64;
  LChunks: uint64;
  LCount: int64;
  LTaken: uint64;
  LLow: uint64;
  LHigh: uint64;
  LK: uint64;
  LValue: uint64;
  LTask: ptr;
begin
  LWords := ptr to int64(AShared);
  LSlots := ptr to ptr(AShared);
  // the run's task is this worker's while it works (the starter's own included)
  LTask := GTaskCurrent;
  GTaskCurrent := LSlots[ADAM_RUNTIME_PARALLEL_TASK];
  LEntry := ParallelEntry(LSlots[ADAM_RUNTIME_PARALLEL_ENTRY]);
  LFrame := LSlots[ADAM_RUNTIME_PARALLEL_FRAME];
  LFirst := uint64(LWords[ADAM_RUNTIME_PARALLEL_FIRST]);
  LDown := LWords[ADAM_RUNTIME_PARALLEL_STEP] < 0;
  LSpan := uint64(LWords[ADAM_RUNTIME_PARALLEL_SPAN]);
  LChunk := uint64(LWords[ADAM_RUNTIME_PARALLEL_CHUNK]);
  LChunks := uint64(LWords[ADAM_RUNTIME_PARALLEL_CHUNKS]);
  LCount := LWords[ADAM_RUNTIME_PARALLEL_WORKERS];
  GParallelDepth := GParallelDepth + 1;
  guard
    while atomicload(LWords[ADAM_RUNTIME_PARALLEL_STOP]) = 0 do
      LTaken := uint64(atomicadd(LWords[ADAM_RUNTIME_PARALLEL_NEXT], 1));
      if LTaken >= LChunks then
        leave;
      end;
      // the chunk's indexes: LTaken * LChunk never passes the span (LChunks = span /
      // chunk + 1), its last one cut at the span with no overflow
      LLow := LTaken * LChunk;
      LHigh := LSpan;
      if LSpan - LLow >= LChunk then
        LHigh := LLow + LChunk - 1;
      end;
      LK := LLow;
      while atomicload(LWords[ADAM_RUNTIME_PARALLEL_STOP]) = 0 do
        // the value in 64 bits, wrapping (an unsigned bound past int64's range included)
        if LDown then
          LValue := LFirst - LK;
        else
          LValue := LFirst + LK;
        end;
        if LEntry(LFrame, int64(LValue), AWorker, LCount) then
          atomicstore(LWords[ADAM_RUNTIME_PARALLEL_STOP], 1);
          leave;
        end;
        if LK = LHigh then
          leave;
        end;
        LK := LK + 1;
      end;
    end;
  except
    if atomicswap(LWords[ADAM_RUNTIME_PARALLEL_RAISED], 1) = 0 then
      StrAddRef(GRaiseText);
      LSlots[ADAM_RUNTIME_PARALLEL_TEXT] := GRaiseText;
      LWords[ADAM_RUNTIME_PARALLEL_CODE] := int64(GRaiseCode);
    end;
    atomicstore(LWords[ADAM_RUNTIME_PARALLEL_STOP], 1);
  end;
  GParallelDepth := GParallelDepth - 1;
  GTaskCurrent := LTask;
end;

// A started worker's thread (ThreadStart's entry): its block holds ParallelRun's block and
// the worker's index
routine ParallelThread(const ABlock: ptr);
var
  LSlots: ptr to ptr;
  LWords: ptr to int64;
begin
  LSlots := ptr to ptr(ABlock);
  LWords := ptr to int64(ABlock);
  ParallelWork(LSlots[0], LWords[1]);
end;

// `for parallel [(W)] I := A to|downto B do .. end;` (BNF sec 5, T2): the body AEntry run
// once per value from AFirst to ALast (AFlags: downto, unsigned bounds, a workers' count
// given; the bounds as 64 bits), over its frame AFrame, by the workers: AWorkers when it
// is given (below 1: 1), else the processors' count (PlatformCpuCount), one alone inside
// another for parallel's body; never more than the iterations when none is given. The
// calling thread is worker 0; the others are threads started here (one that cannot start
// leaves its share to the rest) and joined before this returns, so every iteration has
// ended (the barrier). Then the first raise a body made is raised again here
public routine ParallelRun(const AEntry: ParallelEntry; const AFrame: ptr; const AFirst: int64;
  const ALast: int64; const AFlags: int64; const AWorkers: int64);
var
  LUnsigned: bool;
  LSpan: uint64;
  LStep: int64;
  LWorkers: int64;
  LChunk: uint64;
  LShared: ptr;
  LWords: ptr to int64;
  LSlots: ptr to ptr;
  LBlocks: ptr to ptr;
  LIndexes: ptr to int64;
  LThreads: ptr to ptr;
  LStarted: int64;
  LI: int64;
  LCode: int32;
  LText: ptr;
begin
  LUnsigned := (AFlags & ADAM_RUNTIME_PARALLEL_UNSIGNED) <> 0;
  if (AFlags & ADAM_RUNTIME_PARALLEL_DOWNTO) = 0 then
    if (LUnsigned and (uint64(AFirst) > uint64(ALast))) or ((not LUnsigned) and (AFirst > ALast)) then
      return;
    end;
    LSpan := uint64(ALast) - uint64(AFirst);
    LStep := 1;
  else
    if (LUnsigned and (uint64(AFirst) < uint64(ALast))) or ((not LUnsigned) and (AFirst < ALast)) then
      return;
    end;
    LSpan := uint64(AFirst) - uint64(ALast);
    LStep := -1;
  end;
  if (AFlags & ADAM_RUNTIME_PARALLEL_GIVEN) <> 0 then
    LWorkers := AWorkers;
    if LWorkers < 1 then
      LWorkers := 1;
    end;
  else
    LWorkers := 1;
    if GParallelDepth = 0 then
      LWorkers := PlatformCpuCount();
    end;
    if LWorkers < 1 then
      LWorkers := 1;
    end;
    // the iterations are the span + 1
    if uint64(LWorkers - 1) > LSpan then
      LWorkers := int64(LSpan) + 1;
    end;
  end;
  LChunk := LSpan div uint64(LWorkers) div ADAM_RUNTIME_PARALLEL_SHARE + 1;
  LShared := DoGetMem(ADAM_RUNTIME_PARALLEL_WORDS * 8);
  if LShared = nil then
    MemoryFail(ptr to const char("a for parallel's run of "), ADAM_RUNTIME_PARALLEL_WORDS * 8,
      ptr to const char(" bytes"));
  end;
  LWords := ptr to int64(LShared);
  LSlots := ptr to ptr(LShared);
  LSlots[ADAM_RUNTIME_PARALLEL_ENTRY] := ptr(AEntry);
  LSlots[ADAM_RUNTIME_PARALLEL_FRAME] := AFrame;
  LWords[ADAM_RUNTIME_PARALLEL_FIRST] := AFirst;
  LWords[ADAM_RUNTIME_PARALLEL_STEP] := LStep;
  LWords[ADAM_RUNTIME_PARALLEL_SPAN] := int64(LSpan);
  LWords[ADAM_RUNTIME_PARALLEL_CHUNK] := int64(LChunk);
  LWords[ADAM_RUNTIME_PARALLEL_CHUNKS] := int64(LSpan div LChunk + 1);
  LWords[ADAM_RUNTIME_PARALLEL_WORKERS] := LWorkers;
  LWords[ADAM_RUNTIME_PARALLEL_NEXT] := 0;
  LWords[ADAM_RUNTIME_PARALLEL_STOP] := 0;
  LWords[ADAM_RUNTIME_PARALLEL_RAISED] := 0;
  LWords[ADAM_RUNTIME_PARALLEL_CODE] := 0;
  LSlots[ADAM_RUNTIME_PARALLEL_TEXT] := nil;
  LSlots[ADAM_RUNTIME_PARALLEL_TASK] := GTaskCurrent;
  // the other workers' blocks (two words each: the run, the index) and threads
  LStarted := 0;
  LBlocks := nil;
  LThreads := nil;
  if LWorkers > 1 then
    LBlocks := ptr to ptr(DoGetMem((LWorkers - 1) * 16));
    LThreads := ptr to ptr(DoGetMem((LWorkers - 1) * 8));
  end;
  if (LBlocks <> nil) and (LThreads <> nil) then
    LIndexes := ptr to int64(LBlocks);
    for LI := 1 to LWorkers - 1 do
      LBlocks[(LI - 1) * 2] := LShared;
      LIndexes[(LI - 1) * 2 + 1] := LI;
      LThreads[LI - 1] := ThreadStart(ParallelThread, ptr(addr of LBlocks[(LI - 1) * 2]));
      if LThreads[LI - 1] = nil then
        leave;
      end;
      LStarted := LStarted + 1;
    end;
  end;
  ParallelWork(LShared, 0);
  for LI := 0 to LStarted - 1 do
    ThreadJoin(LThreads[LI]);
  end;
  if LBlocks <> nil then
    FreeMem(ptr(LBlocks));
  end;
  if LThreads <> nil then
    FreeMem(ptr(LThreads));
  end;
  LCode := int32(LWords[ADAM_RUNTIME_PARALLEL_CODE]);
  LText := LSlots[ADAM_RUNTIME_PARALLEL_TEXT];
  if LWords[ADAM_RUNTIME_PARALLEL_RAISED] <> 0 then
    FreeMem(LShared);
    // the kept reference goes to the new raise
    RaiseWith(LCode, LText);
  end;
  FreeMem(LShared);
end;

const
  // A task's object (BNF sec 4 task type: the part of its ref block past the header, its
  // descriptor the compiler's per call site, its done TaskDone) as words: the thread running
  // its call (ptr, ThreadStart's, written atomically once it started; nil when none could
  // start), its state (int64: one of the ADAM_RUNTIME_TASK_* states, written last by the
  // call's thread, atomically), whether its thread was taken (int64: 1 once an await joined
  // it or the thread, its call ended with no await joining, detached itself), the code of
  // the raise its call ended with (int64), that raise's text (a string value it holds one
  // reference to: the descriptor's map releases it), its entry (ptr: the compiler's routine
  // of one pointer for the call site, which reads the call's arguments from the object, runs
  // the call and stores its result there), its cancel word (int64: 1 once cancel(T) asked
  // its call to stop, T3; atomic), then the compiler's words: the arguments' copies and the
  // result, from word 7 on
  ADAM_RUNTIME_TASK_THREAD: int64 = 0;
  ADAM_RUNTIME_TASK_STATE: int64 = 1;
  ADAM_RUNTIME_TASK_JOINED: int64 = 2;
  ADAM_RUNTIME_TASK_CODE: int64 = 3;
  ADAM_RUNTIME_TASK_TEXT: int64 = 4;
  ADAM_RUNTIME_TASK_ENTRY: int64 = 5;
  ADAM_RUNTIME_TASK_CANCEL: int64 = 6;
  // A task's states: its call still running, ended with its result stored, ended by a raise,
  // ended by a raise an await has raised again (a task whose call raised ends the program at
  // its last release only while no await saw that raise: TaskDone)
  ADAM_RUNTIME_TASK_RUNNING: int64 = 0;
  ADAM_RUNTIME_TASK_ENDED: int64 = 1;
  ADAM_RUNTIME_TASK_RAISED: int64 = 2;
  ADAM_RUNTIME_TASK_CAUGHT: int64 = 3;

// The object of the task ABlock (a non-nil task value: its ref block), past the header
routine TaskObject(const ABlock: ptr): ptr;
var
  LBytes: ptr to uint8;
begin
  LBytes := ptr to uint8(ABlock);
  return addr of LBytes[24];
end;

// The ref block of the task object AObject (TaskObject's inverse)
routine TaskBlock(const AObject: ptr): ptr;
var
  LBytes: ptr to uint8;
begin
  LBytes := ptr to uint8(AObject);
  return addr of LBytes[-24];
end;

// GTaskReap's lock taken (spinning: it is held only for list steps that never wait)
routine TaskReapEnter();
begin
  while atomicswap(GTaskReapHeld, 1) <> 0 do
    PlatformSleep(0);
  end;
end;

// GTaskReap's lock let go
routine TaskReapLeave();
begin
  atomicstore(GTaskReapHeld, 0);
end;

// The detached task thread AThread (ThreadStart's), its call ended, put on GTaskReap to be
// joined later; its first word (the entry ThreadRun read as the thread began) is the link
routine TaskReapAdd(const AThread: ptr);
var
  LSlots: ptr to ptr;
begin
  LSlots := ptr to ptr(AThread);
  TaskReapEnter();
  LSlots[0] := GTaskReap;
  GTaskReap := AThread;
  TaskReapLeave();
end;

// Every thread on GTaskReap that has ended joined and freed, never waiting (a thread still
// in its last steps stays on the list): run as a task starts, so a program that keeps
// starting detached tasks holds only the threads still ending
routine TaskReap();
var
  LThread: ptr;
  LNext: ptr;
  LSlots: ptr to ptr;
  LKept: ptr;
begin
  TaskReapEnter();
  LThread := GTaskReap;
  LKept := nil;
  while LThread <> nil do
    LSlots := ptr to ptr(LThread);
    LNext := LSlots[0];
    if not ThreadTryJoin(LThread) then
      LSlots[0] := LKept;
      LKept := LThread;
    end;
    LThread := LNext;
  end;
  GTaskReap := LKept;
  TaskReapLeave();
end;

// The calling thread leaves the running tasks (nothing on a thread that is not a counted
// task's): its own thread detached first when it holds itself (GTaskSelf: the process ends
// from this thread, which must never wait to join itself), then its count dropped
routine TaskLeave();
var
  LSelf: ptr;
begin
  if GTaskSelf <> nil then
    LSelf := GTaskSelf;
    GTaskSelf := nil;
    ThreadDetach(LSelf);
  end;
  if GTaskCounted then
    GTaskCounted := false;
    atomicadd(GTasksRunning, -1);
  end;
end;

// The exit's wait for the tasks (the entry's exit handler, registered after every module's
// initialize so it runs before every teardown; ReportHeap's first step too): the calling
// thread leaves the running tasks itself (a task's thread may end the process), then waits
// until no task's call is running, then joins every detached thread (each past its last
// count step, so a join waits only for its OS end: its threadstatics released, ThreadEnded).
// A task still running keeps the process waiting (BNF sec 4: a discarded task runs to its
// end)
routine TaskWait();
var
  LThread: ptr;
  LNext: ptr;
  LSlots: ptr to ptr;
begin
  TaskLeave();
  while atomicload(GTasksRunning) > 0 do
    PlatformSleep(1);
  end;
  TaskReapEnter();
  LThread := GTaskReap;
  GTaskReap := nil;
  TaskReapLeave();
  while LThread <> nil do
    LSlots := ptr to ptr(LThread);
    LNext := LSlots[0];
    ThreadJoin(LThread);
    LThread := LNext;
  end;
end;

// A task's thread (ThreadStart runs it with the task's object AObject; it is counted in
// GTasksRunning): its entry called inside a catching scope of its own; the state then
// written, ENDED once the entry has stored the result, or RAISED with the raise's code and
// text kept (a reference added: the raise in flight is the thread's own, released as it
// ends). Then its thread is taken: an await that joined it first keeps it, else the task is
// detached and this thread holds itself (GTaskSelf) until it is on GTaskReap. Then the
// thread's own reference released (TaskStart's): the last one ends the task here (TaskDone,
// which may end the process: TaskLeave then detaches GTaskSelf); then it leaves the count
routine TaskRun(const AObject: ptr);
var
  LWords: ptr to int64;
  LSlots: ptr to ptr;
  LEntry: ThreadEntry;
  LThread: ptr;
begin
  GTaskCounted := true;
  LWords := ptr to int64(AObject);
  LSlots := ptr to ptr(AObject);
  LEntry := ThreadEntry(LSlots[ADAM_RUNTIME_TASK_ENTRY]);
  GTaskCurrent := AObject;
  guard
    LEntry(AObject);
    atomicstore(LWords[ADAM_RUNTIME_TASK_STATE], ADAM_RUNTIME_TASK_ENDED);
  except
    StrAddRef(GRaiseText);
    LSlots[ADAM_RUNTIME_TASK_TEXT] := GRaiseText;
    LWords[ADAM_RUNTIME_TASK_CODE] := int64(GRaiseCode);
    atomicstore(LWords[ADAM_RUNTIME_TASK_STATE], ADAM_RUNTIME_TASK_RAISED);
  end;
  GTaskCurrent := nil;
  // TaskStart writes the thread once ThreadStart has returned it: a call that ended before
  // that waits for it, so the thread taken below is the real one
  LThread := atomicload(LSlots[ADAM_RUNTIME_TASK_THREAD]);
  while LThread = nil do
    PlatformSleep(0);
    LThread := atomicload(LSlots[ADAM_RUNTIME_TASK_THREAD]);
  end;
  if atomicswap(LWords[ADAM_RUNTIME_TASK_JOINED], 1) = 0 then
    GTaskSelf := LThread;
  end;
  RefRelease(TaskBlock(AObject));
  if GTaskSelf <> nil then
    GTaskSelf := nil;
    TaskReapAdd(LThread);
  end;
  TaskLeave();
end;

// `async F(..)`'s start, once the compiler has filled the new task ABlock (its entry, the
// arguments' copies): the detached threads that have ended joined first (TaskReap); then
// the thread's own reference added (released as its call ends: a task nothing else holds
// still runs to its end, detached), the task counted as running and its thread started
// (TaskRun), the thread written last. A thread that cannot be started ends the task at once
// as if its call had raised (code 1, the text saying so; its reference and count taken
// back), so its await raises that; nothing else changes
routine TaskStart(const ABlock: ptr);
var
  LObject: ptr;
  LWords: ptr to int64;
  LSlots: ptr to ptr;
  LThread: ptr;
  LHeader: ptr to int64;
begin
  TaskReap();
  LObject := TaskObject(ABlock);
  LWords := ptr to int64(LObject);
  LSlots := ptr to ptr(LObject);
  LHeader := ptr to int64(ABlock);
  atomicadd(LHeader[0], 1);
  atomicadd(GTasksRunning, 1);
  LThread := ThreadStart(TaskRun, LObject);
  if LThread = nil then
    // The caller still holds the task: taking the thread's reference back never ends it
    atomicadd(LHeader[0], -1);
    atomicadd(GTasksRunning, -1);
    LSlots[ADAM_RUNTIME_TASK_TEXT] := TextOfC(ptr to const char("a task's thread could not be started"));
    LWords[ADAM_RUNTIME_TASK_CODE] := 1;
    atomicstore(LWords[ADAM_RUNTIME_TASK_STATE], ADAM_RUNTIME_TASK_RAISED);
    return;
  end;
  atomicstore(LSlots[ADAM_RUNTIME_TASK_THREAD], LThread);
end;

// The task object AObject's thread joined once: the caller that sets its JOINED word first
// joins the thread (ThreadJoin, which frees its handle); any other waits until the call's
// thread has written its state
routine TaskJoin(const AObject: ptr);
var
  LWords: ptr to int64;
  LSlots: ptr to ptr;
begin
  LWords := ptr to int64(AObject);
  LSlots := ptr to ptr(AObject);
  if atomicswap(LWords[ADAM_RUNTIME_TASK_JOINED], 1) = 0 then
    ThreadJoin(LSlots[ADAM_RUNTIME_TASK_THREAD]);
    return;
  end;
  while atomicload(LWords[ADAM_RUNTIME_TASK_STATE]) = ADAM_RUNTIME_TASK_RUNNING do
    PlatformSleep(1);
  end;
end;

// `await T` (BNF sec 6): waits for the call of the task ABlock to end, then raises again
// what it raised (its code and text, a reference added for the new raise; the state CAUGHT
// from then on: an await saw it, so the task's last release does not end the program);
// returns when it ended with its result, which the compiler then reads from the object. A
// nil task raises (code 1)
routine TaskAwait(const ABlock: ptr);
var
  LObject: ptr;
  LWords: ptr to int64;
  LSlots: ptr to ptr;
begin
  if ABlock = nil then
    RaiseWith(1, TextOfC(ptr to const char("await of a nil task")));
  end;
  LObject := TaskObject(ABlock);
  LWords := ptr to int64(LObject);
  LSlots := ptr to ptr(LObject);
  TaskJoin(LObject);
  if atomicload(LWords[ADAM_RUNTIME_TASK_STATE]) = ADAM_RUNTIME_TASK_RAISED then
    atomicstore(LWords[ADAM_RUNTIME_TASK_STATE], ADAM_RUNTIME_TASK_CAUGHT);
  end;
  if atomicload(LWords[ADAM_RUNTIME_TASK_STATE]) = ADAM_RUNTIME_TASK_CAUGHT then
    StrAddRef(LSlots[ADAM_RUNTIME_TASK_TEXT]);
    RaiseWith(int32(LWords[ADAM_RUNTIME_TASK_CODE]), LSlots[ADAM_RUNTIME_TASK_TEXT]);
  end;
end;

// `cancel(T)` (BNF sec 7, T3): asks the call of the task ABlock to stop, its cancel word
// set; nothing is stopped here (the call reads cancelled() and returns or raises as it
// sees fit). A nil task: nothing
routine TaskCancel(const ABlock: ptr);
var
  LWords: ptr to int64;
begin
  if ABlock = nil then
    return;
  end;
  LWords := ptr to int64(TaskObject(ABlock));
  atomicstore(LWords[ADAM_RUNTIME_TASK_CANCEL], 1);
end;

// `cancelled(T)` (BNF sec 7, T3): true once cancel(T) ran on the task ABlock; false for a
// nil task
routine TaskCancelled(const ABlock: ptr): bool;
var
  LWords: ptr to int64;
begin
  if ABlock = nil then
    return false;
  end;
  LWords := ptr to int64(TaskObject(ABlock));
  return atomicload(LWords[ADAM_RUNTIME_TASK_CANCEL]) <> 0;
end;

// `cancelled()` (BNF sec 7, T3): the cancel word of the task whose call this thread runs
// (GTaskCurrent); false on a thread that runs none
routine TaskCancelledSelf(): bool;
var
  LWords: ptr to int64;
begin
  if GTaskCurrent = nil then
    return false;
  end;
  LWords := ptr to int64(GTaskCurrent);
  return atomicload(LWords[ADAM_RUNTIME_TASK_CANCEL]) <> 0;
end;

// `ready(T)` (BNF sec 7): true once the call of the task ABlock has ended (its result
// stored, or raised), without waiting; false for a nil task
routine TaskReady(const ABlock: ptr): bool;
var
  LWords: ptr to int64;
begin
  if ABlock = nil then
    return false;
  end;
  LWords := ptr to int64(TaskObject(ABlock));
  return atomicload(LWords[ADAM_RUNTIME_TASK_STATE]) <> ADAM_RUNTIME_TASK_RUNNING;
end;

// A task's done (its descriptor's: RefRelease runs it on the object AObject as the last
// handle goes; the descriptor's map then releases the text, the arguments and the result).
// Its call has ended by then (the task's own thread holds a reference until its state is
// written: TaskRun), so nothing waits here; this may run on that thread. A call that raised
// with no await seeing it (still RAISED, not CAUGHT) ends the program as on a raise nothing
// caught (Unhandled, with that raise's code and text)
routine TaskDone(const AObject: ptr);
var
  LWords: ptr to int64;
  LSlots: ptr to ptr;
begin
  LWords := ptr to int64(AObject);
  LSlots := ptr to ptr(AObject);
  if atomicload(LWords[ADAM_RUNTIME_TASK_STATE]) = ADAM_RUNTIME_TASK_RAISED then
    StrAddRef(LSlots[ADAM_RUNTIME_TASK_TEXT]);
    StrRelease(GRaiseText);
    GRaiseText := LSlots[ADAM_RUNTIME_TASK_TEXT];
    GRaiseCode := int32(LWords[ADAM_RUNTIME_TASK_CODE]);
    Unhandled();
  end;
end;

// A new lock, free, from the heap (counted: LockFree gives it back), or nil when there is
// no room. One thread holds it at a time: LockEnter waits until it is free. It is not
// recursive (a thread entering a lock it holds waits forever). It is the OS's own lock, its
// size the platform's (PlatformLockSize). A runtime routine a program may name (see the
// header)
public routine LockCreate(): ptr;
var
  LLock: ptr;
begin
  LLock := DoGetMem(PlatformLockSize());
  if LLock = nil then
    return nil;
  end;
  PlatformLockInit(LLock);
  return LLock;
end;

// Waits until the lock ALock (LockCreate's) is free, then holds it. A runtime routine a
// program may name (see the header)
public routine LockEnter(const ALock: ptr);
begin
  PlatformLockEnter(ALock);
end;

// Lets go of the lock ALock, which this thread holds. A runtime routine a program may name
// (see the header)
public routine LockLeave(const ALock: ptr);
begin
  PlatformLockLeave(ALock);
end;

// The lock ALock (LockCreate's) back to the heap: no thread holds it or waits for it; nil
// does nothing. A runtime routine a program may name (see the header)
public routine LockFree(const ALock: ptr);
begin
  if ALock = nil then
    return;
  end;
  PlatformLockDone(ALock);
  FreeMem(ALock);
end;

// Takes the mutex state at AWords: 0 to 1 when it is free; else it is marked 2 (a thread
// may wait, so whoever lets go wakes one) and this thread sleeps on it until it is free, up
// to AMilliseconds (negative: no end, 0: the one try). True when taken. The state is left 2
// after a timeout: the next let go wakes a thread for nothing, which reads it again
routine DoMutexTake(const AWords: ptr to MutexWords; const AMilliseconds: int64): bool;
var
  LStart: int64;
  LLeft: int64;
begin
  if atomiccas(AWords^.State, 0, 1) then
    return true;
  end;
  if AMilliseconds = 0 then
    return false;
  end;
  LStart := PlatformMilliseconds();
  // Swapped to 2 and it was 0: free, taken (as held with a waiter, the safe side)
  while atomicswap(AWords^.State, 2) <> 0 do
    if AMilliseconds < 0 then
      PlatformWaitWord(addr of AWords^.State, 2, -1);
    else
      LLeft := AMilliseconds - (PlatformMilliseconds() - LStart);
      if LLeft <= 0 then
        return false;
      end;
      PlatformWaitWord(addr of AWords^.State, 2, LLeft);
    end;
  end;
  return true;
end;

// lock (BNF sec 5): holds the mutex at AMutex (MutexWords), waiting while another thread
// holds it; the thread holding it takes it again (its count)
routine MutexEnter(const AMutex: ptr);
var
  LWords: ptr to MutexWords;
  LSelf: ptr;
begin
  LWords := ptr to MutexWords(AMutex);
  LSelf := addr of GMutexSelf;
  // Only this thread ever writes its own mark there, so a match is never stale
  if atomicload(LWords^.Owner) = LSelf then
    LWords^.Count := LWords^.Count + 1;
    return;
  end;
  DoMutexTake(LWords, -1);
  atomicstore(LWords^.Owner, LSelf);
  LWords^.Count := 1;
end;

// trylock (BNF sec 5): holds the mutex at AMutex when it can, trying once (AMilliseconds
// 0 or less) or waiting up to AMilliseconds; true when held (taken again by the thread
// holding it, as MutexEnter)
routine MutexTryEnter(const AMutex: ptr; const AMilliseconds: int64): bool;
var
  LWords: ptr to MutexWords;
  LSelf: ptr;
  LWait: int64;
begin
  LWords := ptr to MutexWords(AMutex);
  LSelf := addr of GMutexSelf;
  if atomicload(LWords^.Owner) = LSelf then
    LWords^.Count := LWords^.Count + 1;
    return true;
  end;
  LWait := AMilliseconds;
  if LWait < 0 then
    LWait := 0;
  end;
  if not DoMutexTake(LWords, LWait) then
    return false;
  end;
  atomicstore(LWords^.Owner, LSelf);
  LWords^.Count := 1;
  return true;
end;

// The end of a lock's or a taken trylock's statements (every way out): the mutex at AMutex,
// which this thread holds, let go once; free after its last take, a waiting thread woken
routine MutexLeave(const AMutex: ptr);
var
  LWords: ptr to MutexWords;
begin
  LWords := ptr to MutexWords(AMutex);
  LWords^.Count := LWords^.Count - 1;
  if LWords^.Count > 0 then
    return;
  end;
  atomicstore(LWords^.Owner, nil);
  if atomicswap(LWords^.State, 0) = 2 then
    PlatformWakeWord(addr of LWords^.State);
  end;
end;

// paramcount(): the number of command-line arguments after the program's name
routine ParamCount(): int32;
begin
  return PlatformArgCount() - 1;
end;

// paramstr(N): the process's argument N (0 its own name), a string the caller holds; an N
// below 0 or past the last argument, or an empty argument, is "" (nil)
routine ParamStr(const AIndex: int32): ptr;
var
  LArg: ptr to const char;
  LLength: int64;
  LBlock: ptr;
  LTo: ptr to uint8;
begin
  if (AIndex < 0) or (AIndex >= PlatformArgCount()) then
    return nil;
  end;
  LArg := PlatformArg(AIndex);
  LLength := 0;
  while LArg[LLength] <> '\0' do
    LLength := LLength + 1;
  end;
  if LLength = 0 then
    return nil;
  end;
  LBlock := TextNew(LLength, 1);
  LTo := ptr to uint8(LBlock);
  PlatformCopy(addr of LTo[16], ptr(LArg), LLength);
  return LBlock;
end;

const
  // SplitMix64 (ProjectKeyWord): the state's step (the golden ratio's 64-bit fraction) and
  // the mix's two multipliers
  ADAM_PROJECT_KEY_GAMMA: uint64 = 0x9E3779B97F4A7C15;
  ADAM_PROJECT_KEY_MUL1: uint64 = 0xBF58476D1CE4E5B9;
  ADAM_PROJECT_KEY_MUL2: uint64 = 0x94D049BB133111EB;

// One SplitMix64 step: AState moves on by the gamma, the word is the state mixed. The one
// keystream of a project's pack password: the compiler scrambles with it (Adam.Driver.Project
// ScramblePassword), ProjectPassword undoes it (a XOR is its own inverse)
public routine ProjectKeyWord(var AState: uint64): uint64;
var
  LZ: uint64;
begin
  AState := AState + ADAM_PROJECT_KEY_GAMMA;
  LZ := AState;
  LZ := (LZ xor (LZ shr 30)) * ADAM_PROJECT_KEY_MUL1;
  LZ := (LZ xor (LZ shr 27)) * ADAM_PROJECT_KEY_MUL2;
  return LZ xor (LZ shr 31);
end;

// ProjectPassword(): a project build's pack password, a string the caller holds. AData is
// the constant string block of its scrambled bytes the compiler wrote (nil: no password, ""),
// each byte XOR the keystream AKey seeds (ProjectKeyWord: a word per 8 bytes, its bytes taken
// low first)
routine ProjectPassword(const AData: ptr; const AKey: uint64): ptr;
var
  LHeader: ptr to int64;
  LFrom: ptr to uint8;
  LTo: ptr to uint8;
  LLength: int64;
  LBlock: ptr;
  LState: uint64;
  LWord: uint64;
  LI: int64;
begin
  if AData = nil then
    return nil;
  end;
  LHeader := ptr to int64(AData);
  LLength := LHeader[1];
  if LLength <= 0 then
    return nil;
  end;
  LFrom := ptr to uint8(AData);
  LBlock := TextNew(LLength, 1);
  LTo := ptr to uint8(LBlock);
  LState := AKey;
  LWord := 0;
  for LI := 0 to LLength - 1 do
    if (LI mod 8) = 0 then
      LWord := ProjectKeyWord(LState);
    end;
    LTo[16 + LI] := uint8(LFrom[16 + LI] xor uint8((LWord shr (8 * (LI mod 8))) & 255));
  end;
  return LBlock;
end;

// The heap report turned on; the entry registers it (ReportHeap) as the first exit handler,
// before any module's initialize, so it runs after every module's teardown, by whatever exit
// (BNF sec 1). The thread end is registered with the platform here, before any other thread
// can start, and the report of a hardware fault no guard takes (FaultUnhandled)
initialize
begin
@ifdef DEBUG
  GHeapReport := true;
@endif
  PlatformAtThreadEnd(ThreadEnded);
  PlatformAtFault(FaultUnhandled);
end;

end.
