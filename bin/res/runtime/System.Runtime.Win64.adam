-------------------------------------------------------------------------------
  System.Runtime.Win64.adam - The platform routines of x86_64-windows-gnu

  System.Runtime holds the runtime's logic and names no OS; every OS call it
  needs is one of the Platform routines here. The compiler loads the unit
  its target names (Target.RuntimeUnit) with the runtime, as the runtime's
  implicit import. Another target is another unit with the same routines
  (x86_64-linux-gnu: System.Runtime.Linux64 over libc), never an edit to
  System.Runtime. This one is over ucrtbase, which initializes itself at
  load: an Adam exe carries no C runtime startup object.
*******************************************************************************/

module unit System.Runtime.Win64;

// ucrtbase: the stream table (1 = stdout), its writer, the process exit
routine __acrt_iob_func(const AIndex: uint32): ptr; external "ucrtbase";
routine fwrite(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AStream: ptr): int64; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";
// ucrtbase's exit-time handler list (C's atexit is in the static C runtime, which an Adam
// exe does not carry; ucrtbase exports the list as _crt_atexit)
routine _crt_atexit(const AHandler: routine()): int32; external "ucrtbase";

// ucrtbase: the C heap
routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine realloc(const APointer: ptr; const ASize: uint64): ptr; external "ucrtbase";
routine free(const APointer: ptr); external "ucrtbase";
routine memcpy(const ADest: ptr; const ASource: ptr; const ACount: uint64): ptr; external "ucrtbase";

// ucrtbase: the process's arguments, split from its command line by
// _configure_narrow_argv (a C program's startup code calls it: an Adam exe has none, so
// this unit does, once, before it reads them; mode 1 = unexpanded, no wildcards)
routine _configure_narrow_argv(const AMode: int32): int32; external "ucrtbase";
routine __p___argc(): ptr to int32; external "ucrtbase";

// ucrtbase: the language handler of a frame whose unwind data holds a scope table (C's
// __try / __finally, Microsoft's "x64 exception handling": each entry a range of the
// frame's code and the handler run when an unwind leaves it)
routine __C_specific_handler(const ARecord: ptr; const AFrame: ptr; const AContext: ptr;
  const ADispatch: ptr): int32; external "ucrtbase";

var
  // True once the process's arguments are split (DoReadyArguments)
  GArgumentsReady: bool;

// Writes the ACount bytes at AText to stdout as they are
exported routine PlatformWrite(const AText: ptr; const ACount: int64);
var
  LStream: ptr;
begin
  LStream := __acrt_iob_func(1);
  fwrite(AText, 1, ACount, LStream);
end;

// Ends the process with the exit code ACode (stdout flushed by ucrtbase)
exported routine PlatformExit(const ACode: int32);
begin
  exit(ACode);
end;

// AHandler run when the process ends through exit, however it is called (the runtime's
// Halt or a program's own call of ucrtbase's exit), the last one registered first
exported routine PlatformAtExit(const AHandler: routine());
begin
  _crt_atexit(AHandler);
end;

// ASize bytes from the heap, uninitialized; nil when there is no room
exported routine PlatformAlloc(const ASize: int64): ptr;
begin
  return malloc(uint64(ASize));
end;

// The block at APointer grown or shrunk to ASize bytes, its contents kept up to the
// smaller size, maybe moved (the new address); nil APointer allocates
exported routine PlatformResize(const APointer: ptr; const ASize: int64): ptr;
begin
  return realloc(APointer, uint64(ASize));
end;

// The block at APointer back to the heap; nil does nothing
exported routine PlatformFree(const APointer: ptr);
begin
  free(APointer);
end;

// ACount bytes copied from ASource to ADest (the two do not overlap)
exported routine PlatformCopy(const ADest: ptr; const ASource: ptr; const ACount: int64);
begin
  memcpy(ADest, ASource, uint64(ACount));
end;

// The handler the OS calls for a frame whose unwind data holds a guard's scope table (the
// compiler names it as the frame's handler: an image's own code, so an unwind data's RVA
// reaches it): ucrtbase's scope table handler, given the dispatcher's four arguments as they
// came (ARecord the exception, AFrame the frame's establisher, AContext the machine state,
// ADispatch the dispatcher's context, whose handler data is the table). Its disposition
// (0 continue search, 1 continue execution)
exported routine PlatformFrameHandler(const ARecord: ptr; const AFrame: ptr; const AContext: ptr;
  const ADispatch: ptr): int32;
begin
  return __C_specific_handler(ARecord, AFrame, AContext, ADispatch);
end;

// The process's arguments split from its command line, the first time it is asked
routine DoReadyArguments();
begin
  if not GArgumentsReady then
    _configure_narrow_argv(1);
    GArgumentsReady := true;
  end;
end;

// The number of the process's arguments, its own name included (C's argc)
exported routine PlatformArgCount(): int32;
var
  LCount: ptr to int32;
begin
  DoReadyArguments();
  LCount := __p___argc();
  return LCount^;
end;

end.
