-------------------------------------------------------------------------------
  System.Runtime.Win64.adam - The platform routines of x86_64-windows-gnu

  System.Runtime holds the runtime's logic and names no OS; every OS call it
  needs is one of the Platform routines here. The compiler loads the unit
  its target names (Target.RuntimeUnit) with the runtime, as the runtime's
  implicit import. Another target is another unit with the same routines
  (x86_64-linux-gnu: System.Runtime.Linux64 over libc), never an edit to
  System.Runtime. This one is over ucrtbase, which initializes itself at
  load: an Adam exe carries no C runtime startup object.
*******************************************************************************/

module unit System.Runtime.Win64;

// ucrtbase: the stream table (1 = stdout, 2 = stderr), its writer and flush, the process
// exit (exit runs the exit-time handlers, _exit ends at once: no handler, no flush)
routine __acrt_iob_func(const AIndex: uint32): ptr; external "ucrtbase";
routine fwrite(const ABuffer: ptr; const ASize: int64; const ACount: int64;
  const AStream: ptr): int64; external "ucrtbase";
routine fflush(const AStream: ptr): int32; external "ucrtbase";
routine exit(const ACode: int32); external "ucrtbase";
routine _exit(const ACode: int32); external "ucrtbase";
// ucrtbase's exit-time handler list (C's atexit is in the static C runtime, which an Adam
// exe does not carry; ucrtbase exports the list as _crt_atexit)
routine _crt_atexit(const AHandler: routine()): int32; external "ucrtbase";

// ucrtbase: the C heap
routine malloc(const ASize: uint64): ptr; external "ucrtbase";
routine realloc(const APointer: ptr; const ASize: uint64): ptr; external "ucrtbase";
routine free(const APointer: ptr); external "ucrtbase";
routine memcpy(const ADest: ptr; const ASource: ptr; const ACount: uint64): ptr; external "ucrtbase";

// ucrtbase: the process's arguments, split from its command line by
// _configure_narrow_argv (a C program's startup code calls it: an Adam exe has none, so
// this unit does, once, before it reads them; mode 1 = unexpanded, no wildcards)
routine _configure_narrow_argv(const AMode: int32): int32; external "ucrtbase";
routine __p___argc(): ptr to int32; external "ucrtbase";
routine __p___argv(): ptr to ptr; external "ucrtbase";

// ucrtbase: the language handler of a frame whose unwind data holds a scope table (C's
// __try / __finally, Microsoft's "x64 exception handling": each entry a range of the
// frame's code and the handler run when an unwind leaves it)
routine __C_specific_handler(const ARecord: ptr; const AFrame: ptr; const AContext: ptr;
  const ADispatch: ptr): int32; external "ucrtbase";

// kernel32: raises a software exception of the code ACode through the OS's dispatcher (the
// frames' handlers see it as they see a hardware fault); AFlags 1 = it cannot be continued
routine RaiseException(const ACode: uint32; const AFlags: uint32; const ACount: uint32;
  const AArguments: ptr); external "kernel32";

// kernel32: text in a code page as UTF-16 (ACount -1: through its NUL, converted too; AWide
// nil: the units it needs), a path made full (the units it needs, its NUL counted, when
// ASize is too small; 0 when it fails), a file opened, read and closed by its handle
routine MultiByteToWideChar(const ACodePage: uint32; const AFlags: uint32;
  const AText: ptr to const char; const ACount: int32; const AWide: ptr to uint16;
  const AWideCount: int32): int32; external "kernel32";
routine GetFullPathNameW(const AFileName: ptr to uint16; const ASize: uint32;
  const ABuffer: ptr to uint16; const AFilePart: ptr): uint32; external "kernel32";
routine CreateFileW(const AFileName: ptr to uint16; const AAccess: uint32; const AShare: uint32;
  const AAttributes: ptr; const ADisposition: uint32; const AFlags: uint32;
  const ATemplate: uint64): uint64; external "kernel32";
routine ReadFile(const AFile: uint64; const ABuffer: ptr; const AToRead: uint32;
  var ARead: uint32; const AOverlapped: ptr): int32; external "kernel32";
routine CloseHandle(const AHandle: uint64): int32; external "kernel32";

type
  // WIN32_FILE_ATTRIBUTE_DATA (GetFileAttributesExW's GetFileExInfoStandard): the attributes,
  // three FILETIMEs (each its low then high 32 bits), the size's high then low 32 bits
  PlatformAttributeData = record
    Attributes: uint32;
    CreationLow: uint32;
    CreationHigh: uint32;
    AccessLow: uint32;
    AccessHigh: uint32;
    WriteLow: uint32;
    WriteHigh: uint32;
    SizeHigh: uint32;
    SizeLow: uint32;
  end;

  // FILETIME: 100-nanosecond steps since 1601-01-01 UTC, its low then high 32 bits
  PlatformFileTime = record
    Low: uint32;
    High: uint32;
  end;

  // WIN32_FIND_DATAW (FindFirstFileW / FindNextFileW): the attributes, three FILETIMEs, the
  // size's high then low 32 bits, two reserved words, the name (NUL-terminated UTF-16, at
  // most 260 units) and the 8.3 name
  PlatformFindData = record
    Attributes: uint32;
    Creation: PlatformFileTime;
    Access: PlatformFileTime;
    Written: PlatformFileTime;
    SizeHigh: uint32;
    SizeLow: uint32;
    Reserved0: uint32;
    Reserved1: uint32;
    FileName: array[0..259] of uint16;
    ShortName: array[0..13] of uint16;
  end;

  // BY_HANDLE_FILE_INFORMATION (GetFileInformationByHandle): the attributes, three
  // FILETIMEs, the volume's serial number, the size's high then low 32 bits, the link count
  // and the file index's high then low 32 bits
  PlatformHandleData = record
    Attributes: uint32;
    Creation: PlatformFileTime;
    Access: PlatformFileTime;
    Written: PlatformFileTime;
    VolumeSerial: uint32;
    SizeHigh: uint32;
    SizeLow: uint32;
    Links: uint32;
    IndexHigh: uint32;
    IndexLow: uint32;
  end;

  // SYSTEMTIME: a date and time in fields (Month 1..12, DayOfWeek 0 = Sunday)
  PlatformSystemTime = record
    Year: uint16;
    Month: uint16;
    DayOfWeek: uint16;
    Day: uint16;
    Hour: uint16;
    Minute: uint16;
    Second: uint16;
    Milliseconds: uint16;
  end;

// kernel32: the file calls of an open handle beyond reading: a write at its place, its place
// moved (ANewPlace the place after), its size, its end set at its place; a path's attributes
// and size read without opening it (AInfoLevel 0, GetFileExInfoStandard), a file deleted by
// its path (a folder, a read-only file or one open without delete sharing is refused); the
// path of a module's file (0 the exe's; the units written, ASize when the buffer was too
// small); UTF-16 as text in a code page (ACount 0: the bytes it needs)
routine WriteFile(const AFile: uint64; const ABuffer: ptr; const AToWrite: uint32;
  var AWritten: uint32; const AOverlapped: ptr): int32; external "kernel32";
routine SetFilePointerEx(const AFile: uint64; const ADistance: int64; var ANewPlace: int64;
  const AMethod: uint32): int32; external "kernel32";
routine GetFileSizeEx(const AFile: uint64; var ASize: int64): int32; external "kernel32";
// kernel32: an open handle's attributes, size and identity (a link opened is its target)
routine GetFileInformationByHandle(const AFile: uint64; var AInfo: PlatformHandleData): int32;
  external "kernel32";
routine SetEndOfFile(const AFile: uint64): int32; external "kernel32";
routine GetFileAttributesExW(const AFileName: ptr to uint16; const AInfoLevel: int32;
  var AData: PlatformAttributeData): int32; external "kernel32";
routine DeleteFileW(const AFileName: ptr to uint16): int32; external "kernel32";
routine GetModuleFileNameW(const AModule: uint64; const ABuffer: ptr to uint16;
  const ASize: uint32): uint32; external "kernel32";
routine WideCharToMultiByte(const ACodePage: uint32; const AFlags: uint32;
  const AWide: ptr to uint16; const AWideCount: int32; const AText: ptr to char;
  const ACount: int32; const ADefault: ptr; const AUsedDefault: ptr): int32; external "kernel32";

// kernel32: a folder listed (FindFirstFileW over "<folder>\*" gives its first entry and a
// find handle, ADAM_PLATFORM_INVALID_HANDLE when there is none; FindNextFileW the next, 0 at
// the end (GetLastError ADAM_PLATFORM_ERROR_NO_MORE_FILES) or on a failure; FindClose ends
// it); the calling thread's last error; a FILETIME as UTC fields, and UTC fields as the
// local time of that date (nil: the current time zone, its daylight rule for that year)
routine FindFirstFileW(const AFileName: ptr to uint16; var AData: PlatformFindData): uint64;
  external "kernel32";
routine FindNextFileW(const AFind: uint64; var AData: PlatformFindData): int32;
  external "kernel32";
routine FindClose(const AFind: uint64): int32; external "kernel32";
routine GetLastError(): uint32; external "kernel32";
routine FileTimeToSystemTime(var AFileTime: PlatformFileTime;
  var ASystemTime: PlatformSystemTime): int32; external "kernel32";
routine SystemTimeToTzSpecificLocalTime(const ATimeZone: ptr; var AUniversal: PlatformSystemTime;
  var ALocal: PlatformSystemTime): int32; external "kernel32";

// kernel32: the handle of a DLL already loaded into the process (0 when it is not: it never
// loads one), and the address of an export of a loaded DLL by its name (nil when it has
// none)
routine GetModuleHandleW(const AModuleName: ptr to uint16): uint64; external "kernel32";
routine GetProcAddress(const AModule: uint64; const AProcName: ptr to const char): ptr;
  external "kernel32";

// kernel32: the process's own handle (a pseudo handle, never closed), its loaded modules
// (their load addresses in load order; ANeeded: the bytes the whole list takes), the module
// holding an address with its load count raised (AFlags 4: AAddress is an address in it; 0
// when no loaded module holds it), a load count lowered, a page's protection changed
// (AOldProtect: the one it had)
routine GetCurrentProcess(): uint64; external "kernel32";
routine K32EnumProcessModules(const AProcess: uint64; const AModules: ptr to uint64;
  const ASize: uint32; var ANeeded: uint32): int32; external "kernel32";
routine GetModuleHandleExW(const AFlags: uint32; const AAddress: ptr; var AModule: uint64): int32;
  external "kernel32";
routine FreeLibrary(const AModule: uint64): int32; external "kernel32";
routine VirtualProtect(const AAddress: ptr; const ASize: uint64; const ANewProtect: uint32;
  var AOldProtect: uint32): int32; external "kernel32";
// kernel32: a slim reader / writer lock (a pointer-sized variable, 0 = free) taken and
// given back exclusively
routine AcquireSRWLockExclusive(var ALock: uint64); external "kernel32";
routine ReleaseSRWLockExclusive(var ALock: uint64); external "kernel32";
// The threads (PlatformThreadStart, PlatformThreadJoin, PlatformSleep)
routine CreateThread(const AAttributes: ptr; const AStackSize: uint64;
  const AStart: routine(AParameter: ptr): uint32; const AParameter: ptr; const AFlags: uint32;
  const AThreadId: ptr): uint64; external "kernel32";
routine WaitForSingleObject(const AHandle: uint64; const AMilliseconds: uint32): uint32;
  external "kernel32";
routine Sleep(const AMilliseconds: uint32); external "kernel32";
// ntdll: the address wait under kernel32's WaitOnAddress (PlatformWaitWord /
// PlatformWakeWord): sleeps while the ASize bytes at AAddress equal those at ACompare, up
// to ATimeout (an int64 in 100 ns units, negative: relative; nil: no end); an NTSTATUS
// back (0 woken, STATUS_TIMEOUT when the time ran out); wakes one thread sleeping on
// AAddress
routine RtlWaitOnAddress(const AAddress: ptr; const ACompare: ptr; const ASize: uint64;
  const ATimeout: ptr): int32; external "ntdll";
routine RtlWakeAddressSingle(const AAddress: ptr); external "ntdll";
// kernel32: milliseconds since the system started (PlatformMilliseconds)
routine GetTickCount64(): uint64; external "kernel32";

// ucrtbase: the calling thread's errno, two C strings compared (0 when equal), a C
// string's length
routine _errno(): ptr to int32; external "ucrtbase";
routine strcmp(const ALeft: ptr to const char; const ARight: ptr to const char): int32;
  external "ucrtbase";
routine strlen(const AText: ptr to const char): uint64; external "ucrtbase";

// ucrtbase: a float64's leading decimal digits, correctly rounded, and the decimal point's
// place (PlatformFloatDigits); a decimal text read back as a float64 / float32, rounded to
// nearest (PlatformParseFloat64 / PlatformParseFloat32)
routine _ecvt_s(const ABuffer: ptr to char; const ASize: uint64; const AValue: float64;
  const ACount: int32; const ADecimal: ptr to int32; const ASign: ptr to int32): int32;
  external "ucrtbase";
routine strtod(const AText: ptr to const char; const AEnd: ptr): float64; external "ucrtbase";
routine strtof(const AText: ptr to const char; const AEnd: ptr): float32; external "ucrtbase";

type
  // The loader's DLL notification (LdrRegisterDllNotification's callback): AReason 1 a DLL
  // was loaded, 2 one is unloading; AData its LDR_DLL_NOTIFICATION_DATA (Flags, FullDllName,
  // BaseDllName, DllBase, SizeOfImage); it runs inside the loader's lock
  PlatformDllNotification = routine(const AReason: uint32; const AData: ptr; const AContext: ptr);

  // What a thread PlatformThreadStart made runs first (System.Runtime's ThreadRun), given
  // the block it was started with
  PlatformThreadRun = routine(const ABlock: ptr);

  // One import slot a run-time hook wrote: the slot, what it held, the load address of the
  // module it is in (a module that went away is never written again)
  PlatformHookSlot = record
    Address: ptr to uint64;
    Old: uint64;
    Base: uint64;
  end;

  // A run-time hook: its C name (a copy, NUL-terminated), the replacement, every slot it
  // wrote (Slots: SlotCount of SlotCapacity used); Removing: its slots are being put back,
  // a module loaded now is not patched with it
  PlatformHookEntry = record
    Name: ptr to char;
    Replacement: uint64;
    Slots: ptr to PlatformHookSlot;
    SlotCount: int64;
    SlotCapacity: int64;
    Removing: bool;
  end;

// ntdll: the loader's DLL notification registered (0 = success, an NTSTATUS otherwise);
// ACookie: what unregisters it (never done: it stays for the process's life)
routine LdrRegisterDllNotification(const AFlags: uint32;
  const ANotification: PlatformDllNotification; const AContext: ptr; var ACookie: ptr): int32;
  external "ntdll";

const
  // The exception code of a raise: a customer code (bit 29 set), severity error (bits 30-31),
  // "ADA" in its low bytes, never one the OS or another runtime uses for its own
  ADAM_PLATFORM_RAISE_CODE: uint32 = 0xE0414441;
  // RaiseException's flag of an exception that cannot be continued
  ADAM_PLATFORM_NONCONTINUABLE: uint32 = 1;
  // MultiByteToWideChar's code page of UTF-8, and its flag that fails on invalid UTF-8
  ADAM_PLATFORM_UTF8: uint32 = 65001;
  ADAM_PLATFORM_UTF8_STRICT: uint32 = 8;
  // CreateFileW's read access, read sharing, open-only disposition and plain attributes,
  // and the handle it returns when it cannot open
  ADAM_PLATFORM_GENERIC_READ: uint32 = 0x80000000;
  ADAM_PLATFORM_SHARE_READ: uint32 = 1;
  ADAM_PLATFORM_OPEN_EXISTING: uint32 = 3;
  ADAM_PLATFORM_ATTRIBUTE_NORMAL: uint32 = 0x80;
  ADAM_PLATFORM_INVALID_HANDLE: uint64 = 0xFFFFFFFFFFFFFFFF;
  // The most bytes one ReadFile is asked for (its count is 32-bit)
  ADAM_PLATFORM_READ_CHUNK: int64 = 0x40000000;
  // CreateFileW for a file opened in a mode (PlatformOpenFileMode): write access, attribute
  // reading (a write-only handle's size), write sharing beside read sharing (never delete
  // sharing: an open file is not renamed or removed, as with C's fopen), and the
  // create-or-empty / create-or-keep dispositions
  ADAM_PLATFORM_GENERIC_WRITE: uint32 = 0x40000000;
  ADAM_PLATFORM_READ_ATTRIBUTES: uint32 = 0x80;
  ADAM_PLATFORM_SHARE_WRITE: uint32 = 2;
  ADAM_PLATFORM_CREATE_ALWAYS: uint32 = 2;
  ADAM_PLATFORM_OPEN_ALWAYS: uint32 = 4;
  // GetFileAttributesExW's info level of WIN32_FILE_ATTRIBUTE_DATA (GetFileExInfoStandard),
  // and the attribute bit of a folder
  ADAM_PLATFORM_FILE_EX_INFO_STANDARD: int32 = 0;
  ADAM_PLATFORM_ATTRIBUTE_DIRECTORY: uint32 = 0x10;
  // The attribute bit of a reparse point, and the reparse tags (WIN32_FIND_DATAW's
  // dwReserved0) of the two that are links: a symbolic link (IO_REPARSE_TAG_SYMLINK) and a
  // junction (IO_REPARSE_TAG_MOUNT_POINT); other tags (a cloud file placeholder, a
  // deduplicated file) are the file or folder itself
  ADAM_PLATFORM_ATTRIBUTE_REPARSE_POINT: uint32 = 0x400;
  ADAM_PLATFORM_REPARSE_TAG_SYMLINK: uint32 = 0xA000000C;
  ADAM_PLATFORM_REPARSE_TAG_MOUNT_POINT: uint32 = 0xA0000003;
  // CreateFileW for a link followed to its target (PlatformPathKind): delete sharing beside
  // read and write sharing (the open only reads attributes, so it is never in the way), and
  // the flag that lets a folder open as well as a file
  ADAM_PLATFORM_SHARE_DELETE: uint32 = 4;
  ADAM_PLATFORM_FLAG_BACKUP_SEMANTICS: uint32 = 0x02000000;
  // GetLastError's ERROR_NO_MORE_FILES: FindNextFileW reached the folder's end
  ADAM_PLATFORM_ERROR_NO_MORE_FILES: uint32 = 18;
  // The UTF-16 units of the "\*" a folder's path takes for FindFirstFileW (its NUL apart)
  ADAM_PLATFORM_FIND_SUFFIX: int64 = 2;
  // The UTF-16 units GetModuleFileNameW is first given; doubled while the path does not fit
  ADAM_PLATFORM_MODULE_PATH_START: uint32 = 260;
  // The UTF-16 units of the long-path prefixes "\\?\" and "\\?\UNC\"
  ADAM_PLATFORM_LONG_PREFIX: int64 = 4;
  ADAM_PLATFORM_UNC_PREFIX: int64 = 8;
  // A loaded PE32+ module (the PE format): "MZ" at 0, the signature's offset at 0x3C,
  // "PE\0\0" there, the optional header 24 bytes after it (its magic first), its data
  // directories 112 bytes into it, 8 bytes each (an RVA at 0, a size in bytes at 4), the
  // import table's the second
  ADAM_PLATFORM_DOS_MAGIC: uint16 = 0x5A4D;
  ADAM_PLATFORM_SIGNATURE_POINTER_AT: uint64 = 0x3C;
  ADAM_PLATFORM_PE_SIGNATURE: uint32 = 0x00004550;
  ADAM_PLATFORM_OPTIONAL_AT: uint64 = 24;
  ADAM_PLATFORM_PE32PLUS: uint16 = 0x20B;
  ADAM_PLATFORM_DIRECTORIES_AT: uint64 = 112;
  ADAM_PLATFORM_DIRECTORY_SIZE: uint64 = 8;
  ADAM_PLATFORM_DIRECTORY_IMPORT: uint64 = 1;
  ADAM_PLATFORM_DIRECTORY_BYTES_AT: uint64 = 4;
  // An import directory entry (20 bytes; one whose name RVA is 0 ends the table): its
  // lookup table's RVA at 0, the DLL name's at 12, its address table's at 16. A lookup /
  // address entry is 8 bytes (0 ends a table): bit 63 an import by ordinal, else bits 0..30
  // the RVA of a hint / name entry, whose name follows its 2-byte hint
  ADAM_PLATFORM_IMPORT_ENTRY_SIZE: uint64 = 20;
  ADAM_PLATFORM_IMPORT_LOOKUP_AT: uint64 = 0;
  ADAM_PLATFORM_IMPORT_NAME_AT: uint64 = 12;
  ADAM_PLATFORM_IMPORT_ADDRESS_AT: uint64 = 16;
  ADAM_PLATFORM_THUNK_SIZE: uint64 = 8;
  ADAM_PLATFORM_IMPORT_BY_ORDINAL: uint64 = 0x8000000000000000;
  ADAM_PLATFORM_HINT_NAME_RVA: uint64 = 0x7FFFFFFF;
  ADAM_PLATFORM_HINT_SIZE: uint64 = 2;
  // GetModuleHandleExW's flag of an address in the module, VirtualProtect's read / write
  // protection, the bytes of an address (an import slot, a module list's entry)
  ADAM_PLATFORM_MODULE_FROM_ADDRESS: uint32 = 4;
  ADAM_PLATFORM_PAGE_READWRITE: uint32 = 4;
  ADAM_PLATFORM_ADDRESS_SIZE: uint64 = 8;
  // The loader's notification reasons, and where LDR_DLL_NOTIFICATION_DATA holds DllBase
  // (after the 4-byte Flags padded to 8 and the two name pointers)
  ADAM_PLATFORM_DLL_LOADED: uint32 = 1;
  ADAM_PLATFORM_DLL_UNLOADED: uint32 = 2;
  ADAM_PLATFORM_DLL_BASE_AT: uint64 = 24;
  // The module list's first room (entries) and how often it is read again when the process
  // loaded more modules meanwhile
  ADAM_PLATFORM_MODULES_FIRST: int64 = 256;
  ADAM_PLATFORM_MODULES_TRIES: int64 = 4;
  ADAM_PLATFORM_MODULES_EXTRA: int64 = 16;

public const
  // C's errno values (ucrt's errno.h) a run-time hook reports (System.Runtime's
  // ADAM_ERRNO_*): no module defines the name, out of memory, a slot not writable, the name
  // already hooked, a name or argument refused
  ADAM_PLATFORM_ENOENT: int32 = 2;
  ADAM_PLATFORM_ENOMEM: int32 = 12;
  ADAM_PLATFORM_EACCES: int32 = 13;
  ADAM_PLATFORM_EEXIST: int32 = 17;
  ADAM_PLATFORM_EINVAL: int32 = 22;
  // The file modes PlatformOpenFileMode takes (System.Runtime's ADAM_FILE_*): read, write,
  // read write, append
  ADAM_PLATFORM_MODE_READ: int32 = 0;
  ADAM_PLATFORM_MODE_WRITE: int32 = 1;
  ADAM_PLATFORM_MODE_READ_WRITE: int32 = 2;
  ADAM_PLATFORM_MODE_APPEND: int32 = 3;
  // The origins PlatformSeekFile takes (System.Runtime's ADAM_SEEK_*): Win32's FILE_BEGIN,
  // FILE_CURRENT, FILE_END
  ADAM_PLATFORM_SEEK_START: int32 = 0;
  ADAM_PLATFORM_SEEK_CURRENT: int32 = 1;
  ADAM_PLATFORM_SEEK_END: int32 = 2;
  // What PlatformPathKind finds at a path (System.Runtime's ADAM_PATH_*): nothing (or a path
  // that cannot be read), a file, a folder
  ADAM_PLATFORM_PATH_NONE: int32 = 0;
  ADAM_PLATFORM_PATH_FILE: int32 = 1;
  ADAM_PLATFORM_PATH_FOLDER: int32 = 2;

var
  // True once the process's arguments are split (DoReadyArguments); the lock (an SRWLOCK,
  // zero is free) makes the split run once when threads ask at the same time
  GArgumentsReady: bool;
  GArgumentsLock: uint64;
  // The run-time hooks (PlatformHookInstall). The run lock makes installs and uninstalls run
  // one at a time and may be held while the loader's lock is taken; the table lock guards
  // the entries and their slots and is never held while the loader's lock is taken (the DLL
  // notification takes it inside the loader's lock). Order: run lock, loader, table lock.
  // GHookEntries: GHookEntryCount entry addresses of GHookEntryCapacity; GHookNotified: the
  // loader's notification is registered (GHookCookie its cookie)
  GHookRunLock: uint64;
  GHookTableLock: uint64;
  GHookEntries: ptr to uint64;
  GHookEntryCount: int64;
  GHookEntryCapacity: int64;
  GHookNotified: bool;
  GHookCookie: ptr;
  // System.Runtime's thread end (PlatformAtThreadEnd: registered at its start, before any
  // thread but the main one runs), run on each thread but the main one as it ends
  // (PlatformThreadCallback); nil until then
  GThreadEnd: routine();

// Writes the ACount bytes at AText to stdout as they are
public routine PlatformWrite(const AText: ptr; const ACount: int64);
var
  LStream: ptr;
begin
  LStream := __acrt_iob_func(1);
  fwrite(AText, 1, ACount, LStream);
end;

// Writes the ACount bytes at AText to stderr as they are (unbuffered)
public routine PlatformWriteError(const AText: ptr; const ACount: int64);
var
  LStream: ptr;
begin
  LStream := __acrt_iob_func(2);
  fwrite(AText, 1, ACount, LStream);
end;

// What was written to stdout and is still in its buffer written out
public routine PlatformFlush();
begin
  fflush(__acrt_iob_func(1));
end;

// Ends the process with the exit code ACode (stdout flushed by ucrtbase)
public routine PlatformExit(const ACode: int32);
begin
  exit(ACode);
end;

// Ends the process at once with the exit code ACode: no exit-time handler runs and no
// stream is flushed (PaskalCPP's std::_Exit after an unhandled raise)
public routine PlatformQuit(const ACode: int32);
begin
  _exit(ACode);
end;

// Raises the runtime's exception (ADAM_PLATFORM_RAISE_CODE, not continuable): the
// dispatcher walks the frames for one whose scope catches it, then unwinds the frames in
// between (their finally and cleanup funclets run); it never returns
public routine PlatformRaise();
begin
  RaiseException(ADAM_PLATFORM_RAISE_CODE, ADAM_PLATFORM_NONCONTINUABLE, 0, nil);
end;

// The filter of the entry's catching scope (C's __except filter, called by
// __C_specific_handler as the exception is dispatched): APointers is the
// EXCEPTION_POINTERS (its first word the EXCEPTION_RECORD, whose first DWORD is the code),
// AFrame the entry's frame. 1 (execute the handler: caught) for the runtime's own
// exception, 0 (continue the search) for any other, which goes on to the OS as it did before
public routine PlatformCatch(const APointers: ptr; const AFrame: ptr): int32;
var
  LPointers: ptr to ptr;
  LRecord: ptr to uint32;
begin
  LPointers := ptr to ptr(APointers);
  LRecord := ptr to uint32(LPointers[0]);
  if LRecord[0] = ADAM_PLATFORM_RAISE_CODE then
    return 1;
  end;
  return 0;
end;

// AHandler run when the process ends through exit, however it is called (the runtime's
// Halt or a program's own call of ucrtbase's exit), the last one registered first
public routine PlatformAtExit(const AHandler: routine());
begin
  _crt_atexit(AHandler);
end;

const
  // The loader's reason for a thread's end (winnt.h's DLL_THREAD_DETACH), the one reason
  // PlatformThreadCallback acts on
  ADAM_PLATFORM_DLL_THREAD_DETACH: uint32 = 3;

// AHandler run on each thread but the main one as it ends (PlatformThreadCallback), the
// thread's own last code: its threadstatics are still there to release
public routine PlatformAtThreadEnd(const AHandler: routine());
begin
  GThreadEnd := AHandler;
end;

// The exe's thread callback (the compiler names it as the PE TLS directory's callback): the
// loader calls it as the process starts and ends and as each thread starts and ends
// (AModule the image, AReason winnt.h's DLL_* reason, AReserved unused), on that thread. A
// thread's end (DLL_THREAD_DETACH: a thread that returned or called ExitThread, whoever
// started it) runs the registered thread end (PlatformAtThreadEnd); the main thread ends
// with the process, which runs nothing here (the program's end released its copies)
public routine PlatformThreadCallback(const AModule: ptr; const AReason: uint32;
  const AReserved: ptr);
var
  LEnd: routine();
begin
  if AReason <> ADAM_PLATFORM_DLL_THREAD_DETACH then
    return;
  end;
  LEnd := GThreadEnd;
  if ptr(LEnd) <> nil then
    LEnd();
  end;
end;

// ASize bytes from the heap, uninitialized; nil when there is no room
public routine PlatformAlloc(const ASize: int64): ptr;
begin
  return malloc(uint64(ASize));
end;

// The block at APointer grown or shrunk to ASize bytes, its contents kept up to the
// smaller size, maybe moved (the new address); nil APointer allocates
public routine PlatformResize(const APointer: ptr; const ASize: int64): ptr;
begin
  return realloc(APointer, uint64(ASize));
end;

// The block at APointer back to the heap; nil does nothing
public routine PlatformFree(const APointer: ptr);
begin
  free(APointer);
end;

// ACount bytes copied from ASource to ADest (the two do not overlap)
public routine PlatformCopy(const ADest: ptr; const ASource: ptr; const ACount: int64);
begin
  memcpy(ADest, ASource, uint64(ACount));
end;

// The handler the OS calls for a frame whose unwind data holds a guard's scope table (the
// compiler names it as the frame's handler: an image's own code, so an unwind data's RVA
// reaches it): ucrtbase's scope table handler, given the dispatcher's four arguments as they
// came (ARecord the exception, AFrame the frame's establisher, AContext the machine state,
// ADispatch the dispatcher's context, whose handler data is the table). Its disposition
// (0 continue search, 1 continue execution)
public routine PlatformFrameHandler(const ARecord: ptr; const AFrame: ptr; const AContext: ptr;
  const ADispatch: ptr): int32;
begin
  return __C_specific_handler(ARecord, AFrame, AContext, ADispatch);
end;

const
  // WaitForSingleObject's INFINITE: wait until the object is signaled, however long
  ADAM_PLATFORM_WAIT_INFINITE: uint32 = 0xFFFFFFFF;
  // A lock's size in bytes (an SRWLOCK: one pointer-sized word, zero is free)
  ADAM_PLATFORM_LOCK_SIZE: int64 = 8;
  // The bytes of the word PlatformWaitWord sleeps on (an int32)
  ADAM_PLATFORM_WAIT_WORD_SIZE: uint64 = 4;
  // RtlWaitOnAddress's time unit per millisecond (100 ns), and the most milliseconds that
  // fit an int64 of them (a longer wait has no end)
  ADAM_PLATFORM_WAIT_UNITS: int64 = 10000;
  ADAM_PLATFORM_WAIT_MOST: int64 = 922337203685477;

// The OS's start of a thread PlatformThreadStart made (CreateThread's start routine):
// AParameter is its two-word block from the C heap (the run routine, then its block), freed
// here before the run routine is called on this thread; the thread's exit code is 0
routine DoThreadProc(AParameter: ptr): uint32;
var
  LSlots: ptr to ptr;
  LRun: PlatformThreadRun;
  LBlock: ptr;
begin
  LSlots := ptr to ptr(AParameter);
  LRun := PlatformThreadRun(LSlots[0]);
  LBlock := LSlots[1];
  free(AParameter);
  LRun(LBlock);
  return 0;
end;

// A new thread that runs ARun(ABlock) (System.Runtime's ThreadRun), started at once: its
// handle (PlatformThreadJoin's), or 0 when it could not be started (no room, or the OS
// refused)
public routine PlatformThreadStart(const ARun: routine(const ABlock: ptr); const ABlock: ptr): uint64;
var
  LSlots: ptr to ptr;
  LHandle: uint64;
begin
  LSlots := ptr to ptr(malloc(16));
  if LSlots = nil then
    return 0;
  end;
  LSlots[0] := ptr(ARun);
  LSlots[1] := ABlock;
  LHandle := CreateThread(nil, 0, DoThreadProc, ptr(LSlots), 0, nil);
  if LHandle = 0 then
    free(ptr(LSlots));
  end;
  return LHandle;
end;

// Waits for the thread AThread (PlatformThreadStart's) to end, then closes its handle
public routine PlatformThreadJoin(const AThread: uint64);
begin
  WaitForSingleObject(AThread, ADAM_PLATFORM_WAIT_INFINITE);
  CloseHandle(AThread);
end;

// The calling thread sleeps for AMilliseconds
public routine PlatformSleep(const AMilliseconds: uint32);
begin
  Sleep(AMilliseconds);
end;

// A lock's size in bytes (System.Runtime's LockCreate takes that many from the heap)
public routine PlatformLockSize(): int64;
begin
  return ADAM_PLATFORM_LOCK_SIZE;
end;

// The lock at ALock (PlatformLockSize bytes) made free: an SRWLOCK's zero
public routine PlatformLockInit(const ALock: ptr);
var
  LWord: ptr to uint64;
begin
  LWord := ptr to uint64(ALock);
  LWord^ := 0;
end;

// Waits until the lock at ALock is free, then holds it (exclusively)
public routine PlatformLockEnter(const ALock: ptr);
var
  LWord: ptr to uint64;
begin
  LWord := ptr to uint64(ALock);
  AcquireSRWLockExclusive(LWord^);
end;

// Lets go of the lock at ALock, which the calling thread holds
public routine PlatformLockLeave(const ALock: ptr);
var
  LWord: ptr to uint64;
begin
  LWord := ptr to uint64(ALock);
  ReleaseSRWLockExclusive(LWord^);
end;

// The lock at ALock no longer used (no thread holds it or waits for it): an SRWLOCK holds
// nothing of the OS's, so nothing is given back
public routine PlatformLockDone(const ALock: ptr);
begin
  return;
end;

// Sleeps while the int32 at AWord holds AExpected, up to AMilliseconds (negative: no end).
// It may wake early or for nothing: the caller reads the word again
public routine PlatformWaitWord(const AWord: ptr; const AExpected: int32;
  const AMilliseconds: int64);
var
  LExpected: int32;
  LTimeout: int64;
begin
  LExpected := AExpected;
  if (AMilliseconds < 0) or (AMilliseconds > ADAM_PLATFORM_WAIT_MOST) then
    RtlWaitOnAddress(AWord, addr of LExpected, ADAM_PLATFORM_WAIT_WORD_SIZE, nil);
    return;
  end;
  // Relative to now: a negative count of 100 ns units
  LTimeout := -(AMilliseconds * ADAM_PLATFORM_WAIT_UNITS);
  RtlWaitOnAddress(AWord, addr of LExpected, ADAM_PLATFORM_WAIT_WORD_SIZE, addr of LTimeout);
end;

// Wakes one thread sleeping on the word at AWord (PlatformWaitWord), if one is
public routine PlatformWakeWord(const AWord: ptr);
begin
  RtlWakeAddressSingle(AWord);
end;

// Milliseconds since a fixed point (the system's start), never going back: only a
// difference of two means anything
public routine PlatformMilliseconds(): int64;
begin
  return int64(GetTickCount64());
end;

// The ACount (1 .. 17) leading decimal digits of AValue's magnitude (finite, not 0),
// correctly rounded, written to ADigits (ASize bytes, at least ACount + 1), and the place of
// the decimal point: the magnitude is 0.D1D2.. times ten to the ADecimalPoint. False when
// the C runtime refused (linux64's is glibc's ecvt_r)
public routine PlatformFloatDigits(const AValue: float64; const ACount: int32;
  const ADigits: ptr to char; const ASize: int64; var ADecimalPoint: int32): bool;
var
  LDecimal: int32;
  LSign: int32;
begin
  if _ecvt_s(ADigits, uint64(ASize), AValue, ACount, addr of LDecimal, addr of LSign) <> 0 then
    return false;
  end;
  ADecimalPoint := LDecimal;
  return true;
end;

// The decimal text AText (C's strtod form, NUL-terminated) as the nearest float64
public routine PlatformParseFloat64(const AText: ptr to const char): float64;
begin
  return strtod(AText, nil);
end;

// The decimal text AText (C's strtof form, NUL-terminated) as the nearest float32 (read
// straight to float32: through a float64 it would round twice)
public routine PlatformParseFloat32(const AText: ptr to const char): float32;
begin
  return strtof(AText, nil);
end;

// The process's arguments split from its command line, the first time it is asked
routine DoReadyArguments();
begin
  // Taken on every ask: two threads asking first at once would split the command line
  // twice, one reading argv while the other rebuilds it
  AcquireSRWLockExclusive(GArgumentsLock);
  if not GArgumentsReady then
    _configure_narrow_argv(1);
    GArgumentsReady := true;
  end;
  ReleaseSRWLockExclusive(GArgumentsLock);
end;

// The number of the process's arguments, its own name included (C's argc)
public routine PlatformArgCount(): int32;
var
  LCount: ptr to int32;
begin
  DoReadyArguments();
  LCount := __p___argc();
  return LCount^;
end;

// The process's argument AIndex (0 its own name, C's argv[AIndex]): its NUL-terminated
// bytes, ucrtbase's own (never freed); AIndex is in 0 .. PlatformArgCount() - 1
public routine PlatformArg(const AIndex: int32): ptr to const char;
var
  LSlot: ptr to ptr;
  LArgs: ptr to ptr;
begin
  DoReadyArguments();
  LSlot := __p___argv();
  LArgs := ptr to ptr(LSlot^);
  return ptr to const char(LArgs[int64(AIndex)]);
end;

// The NUL-terminated UTF-8 text at AText as NUL-terminated UTF-16 in a new block from the C
// heap (the caller frees it); nil when the text is not valid UTF-8 or there is no room
routine DoWideOf(const AText: ptr to const char): ptr to uint16;
var
  LCount: int32;
  LWide: ptr to uint16;
begin
  LCount := MultiByteToWideChar(ADAM_PLATFORM_UTF8, ADAM_PLATFORM_UTF8_STRICT, AText, -1, nil, 0);
  if LCount <= 0 then
    return nil;
  end;
  LWide := ptr to uint16(malloc(uint64(LCount) * 2));
  if LWide = nil then
    return nil;
  end;
  if MultiByteToWideChar(ADAM_PLATFORM_UTF8, ADAM_PLATFORM_UTF8_STRICT, AText, -1, LWide,
    LCount) <> LCount then
    free(ptr(LWide));
    return nil;
  end;
  return LWide;
end;

// The NUL-terminated UTF-16 path at ARelative made full by the OS (the working folder, '/'
// as '\', "." and ".." resolved) in a new block from the C heap, ACount its units with the
// NUL; nil when the OS cannot make it full or there is no room
routine DoFullOf(const ARelative: ptr to uint16; var ACount: int64): ptr to uint16;
var
  LNeeded: uint32;
  LFull: ptr to uint16;
  LWritten: uint32;
begin
  ACount := 0;
  LNeeded := GetFullPathNameW(ARelative, 0, nil, nil);
  if LNeeded = 0 then
    return nil;
  end;
  LFull := ptr to uint16(malloc(uint64(LNeeded) * 2));
  if LFull = nil then
    return nil;
  end;
  // Success returns the units written without the NUL. The first call's size is an upper
  // bound (a ".." folds the path shorter), so success is any count that fit; 0 is a failure,
  // LNeeded or more a path that grew in between
  LWritten := GetFullPathNameW(ARelative, LNeeded, LFull, nil);
  if (LWritten = 0) or (LWritten >= LNeeded) then
    free(ptr(LFull));
    return nil;
  end;
  ACount := int64(LWritten) + 1;
  return LFull;
end;

// True when the full path AFull (ACount units with its NUL) already has a "\\?\" or "\\.\"
// prefix, which the file API takes as it is
routine DoHasDevicePrefix(const AFull: ptr to uint16; const ACount: int64): bool;
begin
  if ACount < 5 then
    return false;
  end;
  if (AFull[0] <> 0x5C) or (AFull[1] <> 0x5C) or (AFull[3] <> 0x5C) then
    return false;
  end;
  return (AFull[2] = 0x3F) or (AFull[2] = 0x2E);
end;

// True when the full path AFull (ACount units with its NUL) is a UNC path (\\server\share)
routine DoIsUncPath(const AFull: ptr to uint16; const ACount: int64): bool;
begin
  if ACount < 3 then
    return false;
  end;
  return (AFull[0] = 0x5C) and (AFull[1] = 0x5C);
end;

// The NUL-terminated UTF-8 path at APath as the file API takes it at any length: made full
// (DoFullOf), with the long-path prefix (X:\... -> \\?\X:\..., \\server\share ->
// \\?\UNC\server\share; a path already \\?\ or \\.\ stays as it is), NUL-terminated UTF-16
// in a new block from the C heap (the caller frees it); nil when it cannot be made
routine DoLongPathOf(const APath: ptr to const char): ptr to uint16;
var
  LRelative: ptr to uint16;
  LFull: ptr to uint16;
  LCount: int64;
  LLong: ptr to uint16;
  LAt: int64;
  LFrom: int64;
begin
  LRelative := DoWideOf(APath);
  if LRelative = nil then
    return nil;
  end;
  LFull := DoFullOf(LRelative, LCount);
  free(ptr(LRelative));
  if LFull = nil then
    return nil;
  end;
  if DoHasDevicePrefix(LFull, LCount) then
    return LFull;
  end;
  LLong := ptr to uint16(malloc(uint64(LCount + ADAM_PLATFORM_UNC_PREFIX) * 2));
  if LLong = nil then
    free(ptr(LFull));
    return nil;
  end;
  // "\\?\" first, then "UNC\" for a UNC path, whose own leading "\\" is dropped
  LLong[0] := 0x5C;
  LLong[1] := 0x5C;
  LLong[2] := 0x3F;
  LLong[3] := 0x5C;
  LAt := ADAM_PLATFORM_LONG_PREFIX;
  LFrom := 0;
  if DoIsUncPath(LFull, LCount) then
    LLong[4] := 0x55;
    LLong[5] := 0x4E;
    LLong[6] := 0x43;
    LLong[7] := 0x5C;
    LAt := ADAM_PLATFORM_UNC_PREFIX;
    LFrom := 2;
  end;
  // The full path's units from LFrom, its NUL included
  memcpy(ptr(addr of LLong[LAt]), ptr(addr of LFull[LFrom]), uint64(LCount - LFrom) * 2);
  free(ptr(LFull));
  return LLong;
end;

// Opens the file at the NUL-terminated UTF-8 path APath for reading (relative to the working
// folder, at any length); AHandle is its handle for PlatformReadFile / PlatformCloseFile.
// False (AHandle 0) when it cannot be opened (missing, a folder, no access, a path that is
// not valid UTF-8)
public routine PlatformOpenFile(const APath: ptr to const char; var AHandle: uint64): bool;
var
  LPath: ptr to uint16;
begin
  AHandle := 0;
  LPath := DoLongPathOf(APath);
  if LPath = nil then
    return false;
  end;
  AHandle := CreateFileW(LPath, ADAM_PLATFORM_GENERIC_READ, ADAM_PLATFORM_SHARE_READ, nil,
    ADAM_PLATFORM_OPEN_EXISTING, ADAM_PLATFORM_ATTRIBUTE_NORMAL, 0);
  free(ptr(LPath));
  if AHandle = ADAM_PLATFORM_INVALID_HANDLE then
    AHandle := 0;
    return false;
  end;
  return true;
end;

// Up to ACount bytes (ACount above 0) of the file AHandle (PlatformOpenFile's) read into
// ABuffer at its current place: the bytes read, 0 at its end, -1 when the read fails
public routine PlatformReadFile(const AHandle: uint64; const ABuffer: ptr; const ACount: int64): int64;
var
  LWant: int64;
  LRead: uint32;
begin
  LWant := ACount;
  if LWant > ADAM_PLATFORM_READ_CHUNK then
    LWant := ADAM_PLATFORM_READ_CHUNK;
  end;
  LRead := 0;
  if ReadFile(AHandle, ABuffer, uint32(LWant), LRead, nil) = 0 then
    return -1;
  end;
  return int64(LRead);
end;

// Closes the file AHandle (PlatformOpenFile's or PlatformOpenFileMode's)
public routine PlatformCloseFile(const AHandle: uint64);
begin
  CloseHandle(AHandle);
end;

// CreateFileW's access and disposition for System.Runtime's file mode AMode (read: it must
// exist; write: created or emptied; read write: it must exist, kept; append: created when
// missing, kept); false for a value that is no mode. Every mode reads its attributes (its
// size)
routine DoModeAccess(const AMode: int32; var AAccess: uint32; var ADisposition: uint32): bool;
begin
  if AMode = ADAM_PLATFORM_MODE_READ then
    AAccess := ADAM_PLATFORM_GENERIC_READ;
    ADisposition := ADAM_PLATFORM_OPEN_EXISTING;
    return true;
  end;
  if AMode = ADAM_PLATFORM_MODE_WRITE then
    AAccess := ADAM_PLATFORM_GENERIC_WRITE | ADAM_PLATFORM_READ_ATTRIBUTES;
    ADisposition := ADAM_PLATFORM_CREATE_ALWAYS;
    return true;
  end;
  if AMode = ADAM_PLATFORM_MODE_READ_WRITE then
    AAccess := ADAM_PLATFORM_GENERIC_READ | ADAM_PLATFORM_GENERIC_WRITE;
    ADisposition := ADAM_PLATFORM_OPEN_EXISTING;
    return true;
  end;
  if AMode = ADAM_PLATFORM_MODE_APPEND then
    AAccess := ADAM_PLATFORM_GENERIC_WRITE | ADAM_PLATFORM_READ_ATTRIBUTES;
    ADisposition := ADAM_PLATFORM_OPEN_ALWAYS;
    return true;
  end;
  return false;
end;

// Opens the file at the NUL-terminated UTF-8 path APath (relative to the working folder, at
// any length) in System.Runtime's file mode AMode, shared for reading and writing (never
// for deleting, as C's fopen); AHandle is its handle, at place 0. False (AHandle 0) when it
// cannot be opened so (missing for read / read write, a folder, no access, not valid UTF-8,
// no mode)
public routine PlatformOpenFileMode(const APath: ptr to const char; const AMode: int32;
  var AHandle: uint64): bool;
var
  LPath: ptr to uint16;
  LAccess: uint32;
  LDisposition: uint32;
begin
  AHandle := 0;
  LAccess := 0;
  LDisposition := 0;
  if not DoModeAccess(AMode, LAccess, LDisposition) then
    return false;
  end;
  LPath := DoLongPathOf(APath);
  if LPath = nil then
    return false;
  end;
  AHandle := CreateFileW(LPath, LAccess, ADAM_PLATFORM_SHARE_READ | ADAM_PLATFORM_SHARE_WRITE,
    nil, LDisposition, ADAM_PLATFORM_ATTRIBUTE_NORMAL, 0);
  free(ptr(LPath));
  if AHandle = ADAM_PLATFORM_INVALID_HANDLE then
    AHandle := 0;
    return false;
  end;
  return true;
end;

// Up to ACount bytes (ACount above 0) of ABuffer written to the file AHandle at its place
// (past its end: the gap reads as zeros): the bytes written, -1 when the write fails
public routine PlatformWriteFile(const AHandle: uint64; const ABuffer: ptr; const ACount: int64): int64;
var
  LWant: int64;
  LWritten: uint32;
begin
  LWant := ACount;
  if LWant > ADAM_PLATFORM_READ_CHUNK then
    LWant := ADAM_PLATFORM_READ_CHUNK;
  end;
  LWritten := 0;
  if WriteFile(AHandle, ABuffer, uint32(LWant), LWritten, nil) = 0 then
    return -1;
  end;
  return int64(LWritten);
end;

// Moves the place of the file AHandle to AOffset from AOrigin (ADAM_PLATFORM_SEEK_*: the
// start, the place, the end): the new place, -1 when it cannot move there (before the
// start); past the end is a place
public routine PlatformSeekFile(const AHandle: uint64; const AOffset: int64; const AOrigin: int32): int64;
var
  LPlace: int64;
begin
  if (AOrigin < ADAM_PLATFORM_SEEK_START) or (AOrigin > ADAM_PLATFORM_SEEK_END) then
    return -1;
  end;
  LPlace := 0;
  if SetFilePointerEx(AHandle, AOffset, LPlace, uint32(AOrigin)) = 0 then
    return -1;
  end;
  return LPlace;
end;

// The size in bytes of the file AHandle, -1 when it cannot be read
public routine PlatformFileSize(const AHandle: uint64): int64;
var
  LSize: int64;
begin
  LSize := 0;
  if GetFileSizeEx(AHandle, LSize) = 0 then
    return -1;
  end;
  return LSize;
end;

// Sets the size of the file AHandle (open for writing) to ASize bytes: shorter drops the
// tail, longer reads as zeros; its place is kept (it may then lie past the end). False when
// it cannot be set
public routine PlatformTruncateFile(const AHandle: uint64; const ASize: int64): bool;
var
  LPlace: int64;
  LAt: int64;
  LOk: bool;
begin
  LPlace := 0;
  LAt := 0;
  if SetFilePointerEx(AHandle, 0, LPlace, uint32(ADAM_PLATFORM_SEEK_CURRENT)) = 0 then
    return false;
  end;
  if SetFilePointerEx(AHandle, ASize, LAt, uint32(ADAM_PLATFORM_SEEK_START)) = 0 then
    return false;
  end;
  LOk := SetEndOfFile(AHandle) <> 0;
  // The place goes back where it was, whatever the result
  SetFilePointerEx(AHandle, LPlace, LAt, uint32(ADAM_PLATFORM_SEEK_START));
  return LOk;
end;

// True when the NUL-terminated UTF-16 long path APath is itself a link, read without
// following it: a symbolic link or a junction (its reparse tag, FindFirstFileW on the path
// itself). False for anything else, nothing there, or a path that cannot be read
routine DoIsLinkAt(const APath: ptr to uint16): bool;
var
  LData: PlatformFindData;
  LFind: uint64;
begin
  LFind := FindFirstFileW(APath, LData);
  if LFind = ADAM_PLATFORM_INVALID_HANDLE then
    return false;
  end;
  FindClose(LFind);
  if (LData.Attributes & ADAM_PLATFORM_ATTRIBUTE_REPARSE_POINT) = 0 then
    return false;
  end;
  return (LData.Reserved0 = ADAM_PLATFORM_REPARSE_TAG_SYMLINK) or
    (LData.Reserved0 = ADAM_PLATFORM_REPARSE_TAG_MOUNT_POINT);
end;

// What a link at the NUL-terminated UTF-16 long path APath leads to, as PlatformPathKind
// gives it: the path opened (CreateFileW follows every link on the way to its target; the
// backup-semantics flag opens a folder too) and the open handle's attributes and size read.
// A link whose target is gone, or one the OS refuses to open, is ADAM_PLATFORM_PATH_NONE, as
// C's stat says of it
routine DoLinkedKindOf(const APath: ptr to uint16; var ASize: int64): int32;
var
  LHandle: uint64;
  LInfo: PlatformHandleData;
  LRead: int32;
begin
  ASize := 0;
  LHandle := CreateFileW(APath, ADAM_PLATFORM_READ_ATTRIBUTES,
    ADAM_PLATFORM_SHARE_READ | ADAM_PLATFORM_SHARE_WRITE | ADAM_PLATFORM_SHARE_DELETE, nil,
    ADAM_PLATFORM_OPEN_EXISTING, ADAM_PLATFORM_FLAG_BACKUP_SEMANTICS, 0);
  if LHandle = ADAM_PLATFORM_INVALID_HANDLE then
    return ADAM_PLATFORM_PATH_NONE;
  end;
  LRead := GetFileInformationByHandle(LHandle, LInfo);
  CloseHandle(LHandle);
  if LRead = 0 then
    return ADAM_PLATFORM_PATH_NONE;
  end;
  if (LInfo.Attributes & ADAM_PLATFORM_ATTRIBUTE_DIRECTORY) <> 0 then
    return ADAM_PLATFORM_PATH_FOLDER;
  end;
  ASize := int64((uint64(LInfo.SizeHigh) shl 32) | uint64(LInfo.SizeLow));
  return ADAM_PLATFORM_PATH_FILE;
end;

// What is at the NUL-terminated UTF-16 long path APath, as PlatformPathKind gives it: its
// attributes read without opening it; a link (its own attributes say nothing of its target:
// a file symlink reads as a file of size 0) is followed to what it leads to
routine DoPathKindAt(const APath: ptr to uint16; var ASize: int64): int32;
var
  LData: PlatformAttributeData;
begin
  ASize := 0;
  if GetFileAttributesExW(APath, ADAM_PLATFORM_FILE_EX_INFO_STANDARD, LData) = 0 then
    return ADAM_PLATFORM_PATH_NONE;
  end;
  if (LData.Attributes & ADAM_PLATFORM_ATTRIBUTE_REPARSE_POINT) <> 0 then
    if DoIsLinkAt(APath) then
      return DoLinkedKindOf(APath, ASize);
    end;
  end;
  if (LData.Attributes & ADAM_PLATFORM_ATTRIBUTE_DIRECTORY) <> 0 then
    return ADAM_PLATFORM_PATH_FOLDER;
  end;
  ASize := int64((uint64(LData.SizeHigh) shl 32) | uint64(LData.SizeLow));
  return ADAM_PLATFORM_PATH_FILE;
end;

// What is at the NUL-terminated UTF-8 path APath (relative to the working folder, at any
// length), a link followed to its target: ADAM_PLATFORM_PATH_FILE (ASize its size in
// bytes), ADAM_PLATFORM_PATH_FOLDER, or ADAM_PLATFORM_PATH_NONE (nothing there, a link
// whose target is gone, a path that is not valid UTF-8, or one the OS refuses to read);
// ASize is 0 but for a file
public routine PlatformPathKind(const APath: ptr to const char; var ASize: int64): int32;
var
  LPath: ptr to uint16;
  LKind: int32;
begin
  ASize := 0;
  LPath := DoLongPathOf(APath);
  if LPath = nil then
    return ADAM_PLATFORM_PATH_NONE;
  end;
  LKind := DoPathKindAt(LPath, ASize);
  free(ptr(LPath));
  return LKind;
end;

// True when the NUL-terminated UTF-8 path APath (relative to the working folder, at any
// length) is itself a link, read without following it: a symbolic link or a junction (its
// reparse tag, FindFirstFileW on the path itself). False for anything else, nothing there,
// or a path that cannot be read
public routine PlatformPathIsLink(const APath: ptr to const char): bool;
var
  LPath: ptr to uint16;
  LLink: bool;
begin
  LPath := DoLongPathOf(APath);
  if LPath = nil then
    return false;
  end;
  LLink := DoIsLinkAt(LPath);
  free(ptr(LPath));
  return LLink;
end;

// Deletes the file at the NUL-terminated UTF-8 path APath (relative to the working folder,
// at any length); false when it is not deleted (missing, a folder, read only, open without
// delete sharing, a path that is not valid UTF-8)
public routine PlatformRemoveFile(const APath: ptr to const char): bool;
var
  LPath: ptr to uint16;
  LOk: bool;
begin
  LPath := DoLongPathOf(APath);
  if LPath = nil then
    return false;
  end;
  LOk := DeleteFileW(LPath) <> 0;
  free(ptr(LPath));
  return LOk;
end;

// The find pattern of the folder at the NUL-terminated UTF-8 path APath: its long path
// (DoLongPathOf) with "\*" after it (only "*" when it ends in a '\', a drive's root), as
// NUL-terminated UTF-16 in a new block from the C heap (the caller frees it); nil when it
// cannot be made
routine DoFindPatternOf(const APath: ptr to const char): ptr to uint16;
var
  LLong: ptr to uint16;
  LCount: int64;
  LPattern: ptr to uint16;
  LAt: int64;
begin
  LLong := DoLongPathOf(APath);
  if LLong = nil then
    return nil;
  end;
  LCount := 0;
  while LLong[LCount] <> 0 do
    LCount := LCount + 1;
  end;
  LPattern := ptr to uint16(malloc(uint64(LCount + ADAM_PLATFORM_FIND_SUFFIX + 1) * 2));
  if LPattern = nil then
    free(ptr(LLong));
    return nil;
  end;
  memcpy(ptr(LPattern), ptr(LLong), uint64(LCount) * 2);
  free(ptr(LLong));
  LAt := LCount;
  if (LCount = 0) or (LPattern[LCount - 1] <> 0x5C) then
    LPattern[LAt] := 0x5C;
    LAt := LAt + 1;
  end;
  LPattern[LAt] := 0x2A;
  LPattern[LAt + 1] := 0;
  return LPattern;
end;

// True when the find entry AData names "." or ".." (the folder itself, its parent)
routine DoIsDotEntry(const AData: PlatformFindData): bool;
begin
  if AData.FileName[0] <> 0x2E then
    return false;
  end;
  if AData.FileName[1] = 0 then
    return true;
  end;
  return (AData.FileName[1] = 0x2E) and (AData.FileName[2] = 0);
end;

// Every name in the folder at the NUL-terminated UTF-8 path APath (relative to the working
// folder, at any length; "." and ".." left out), in the OS's order, as UTF-8 with a NUL
// after each: the bytes they take, their NULs counted (0 for an empty folder), written into
// AText while they fit in its ASize bytes (AText nil: only counted), so AText holds them all
// when the result is at most ASize. -1 when APath is no folder that can be listed (missing,
// a file, no access, a path that is not valid UTF-8) or the listing fails part way
public routine PlatformListFolder(const APath: ptr to const char; const AText: ptr to char;
  const ASize: int64): int64;
var
  LPattern: ptr to uint16;
  LFind: uint64;
  LData: PlatformFindData;
  LTotal: int64;
  LBytes: int32;
  LOk: bool;
begin
  LPattern := DoFindPatternOf(APath);
  if LPattern = nil then
    return -1;
  end;
  LFind := FindFirstFileW(LPattern, LData);
  free(ptr(LPattern));
  if LFind = ADAM_PLATFORM_INVALID_HANDLE then
    return -1;
  end;
  LTotal := 0;
  LOk := true;
  while true do
    if not DoIsDotEntry(LData) then
      // The name's bytes with its NUL (-1: the units up to and with the NUL)
      LBytes := WideCharToMultiByte(ADAM_PLATFORM_UTF8, 0, addr of LData.FileName[0], -1, nil,
        0, nil, nil);
      if LBytes <= 0 then
        LOk := false;
        leave;
      end;
      if (AText <> nil) and (LTotal + int64(LBytes) <= ASize) then
        WideCharToMultiByte(ADAM_PLATFORM_UTF8, 0, addr of LData.FileName[0], -1,
          addr of AText[LTotal], LBytes, nil, nil);
      end;
      LTotal := LTotal + int64(LBytes);
    end;
    if FindNextFileW(LFind, LData) = 0 then
      LOk := GetLastError() = ADAM_PLATFORM_ERROR_NO_MORE_FILES;
      leave;
    end;
  end;
  FindClose(LFind);
  if not LOk then
    return -1;
  end;
  return LTotal;
end;

// The last write time of the file or folder at the NUL-terminated UTF-8 path APath
// (relative to the working folder, at any length) as the local time of that date (the time
// zone's daylight rule for its year, as C's localtime): AYear, AMonth 1..12, ADay 1..31,
// AHour 0..23, AMinute and ASecond 0..59. False (every field 0) when it cannot be read
public routine PlatformFileLocalTime(const APath: ptr to const char; var AYear: int32;
  var AMonth: int32; var ADay: int32; var AHour: int32; var AMinute: int32;
  var ASecond: int32): bool;
var
  LPath: ptr to uint16;
  LData: PlatformAttributeData;
  LRead: int32;
  LWritten: PlatformFileTime;
  LUniversal: PlatformSystemTime;
  LLocal: PlatformSystemTime;
begin
  AYear := 0;
  AMonth := 0;
  ADay := 0;
  AHour := 0;
  AMinute := 0;
  ASecond := 0;
  LPath := DoLongPathOf(APath);
  if LPath = nil then
    return false;
  end;
  LRead := GetFileAttributesExW(LPath, ADAM_PLATFORM_FILE_EX_INFO_STANDARD, LData);
  free(ptr(LPath));
  if LRead = 0 then
    return false;
  end;
  LWritten.Low := LData.WriteLow;
  LWritten.High := LData.WriteHigh;
  if FileTimeToSystemTime(LWritten, LUniversal) = 0 then
    return false;
  end;
  if SystemTimeToTzSpecificLocalTime(nil, LUniversal, LLocal) = 0 then
    return false;
  end;
  AYear := int32(LLocal.Year);
  AMonth := int32(LLocal.Month);
  ADay := int32(LLocal.Day);
  AHour := int32(LLocal.Hour);
  AMinute := int32(LLocal.Minute);
  ASecond := int32(LLocal.Second);
  return true;
end;

// The path of the program's exe as UTF-8 into AText (ASize bytes; a NUL after the path when
// path and NUL fit, else nothing written): the bytes the path takes, its NUL not counted; 0
// when it cannot be read
public routine PlatformExePath(const AText: ptr to char; const ASize: int64): int64;
var
  LUnits: uint32;
  LWide: ptr to uint16;
  LGot: uint32;
  LBytes: int32;
begin
  LUnits := ADAM_PLATFORM_MODULE_PATH_START;
  while true do
    LWide := ptr to uint16(malloc(uint64(LUnits) * 2));
    if LWide = nil then
      return 0;
    end;
    LGot := GetModuleFileNameW(0, LWide, LUnits);
    if LGot = 0 then
      free(ptr(LWide));
      return 0;
    end;
    // A path that fills the buffer may have been cut: try again with twice the room
    if LGot < LUnits then
      leave;
    end;
    free(ptr(LWide));
    LUnits := LUnits * 2;
  end;
  LBytes := WideCharToMultiByte(ADAM_PLATFORM_UTF8, 0, LWide, int32(LGot), nil, 0, nil, nil);
  if (LBytes > 0) and (AText <> nil) and (int64(LBytes) < ASize) then
    WideCharToMultiByte(ADAM_PLATFORM_UTF8, 0, LWide, int32(LGot), AText, LBytes, nil, nil);
    AText[LBytes] := char(0);
  end;
  free(ptr(LWide));
  if LBytes < 0 then
    return 0;
  end;
  return int64(LBytes);
end;

// The NUL-terminated UTF-8 path APath made full (the working folder joined to a relative
// path, '/' as '\', "." and ".." folded as text: the disk is never touched; DoFullOf) as
// UTF-8 into AText (ASize bytes; a NUL after the path when path and NUL fit, else nothing
// written): the bytes the full path takes, its NUL not counted; 0 when it cannot be made (a
// path that is not valid UTF-8, or no room)
public routine PlatformFullPath(const APath: ptr to const char; const AText: ptr to char;
  const ASize: int64): int64;
var
  LRelative: ptr to uint16;
  LFull: ptr to uint16;
  LCount: int64;
  LBytes: int32;
begin
  LRelative := DoWideOf(APath);
  if LRelative = nil then
    return 0;
  end;
  LFull := DoFullOf(LRelative, LCount);
  free(ptr(LRelative));
  if LFull = nil then
    return 0;
  end;
  // LCount counts the NUL: the path's own units are one fewer
  LBytes := WideCharToMultiByte(ADAM_PLATFORM_UTF8, 0, LFull, int32(LCount - 1), nil, 0, nil,
    nil);
  if (LBytes > 0) and (AText <> nil) and (int64(LBytes) < ASize) then
    WideCharToMultiByte(ADAM_PLATFORM_UTF8, 0, LFull, int32(LCount - 1), AText, LBytes, nil,
      nil);
    AText[LBytes] := char(0);
  end;
  free(ptr(LFull));
  if LBytes < 0 then
    return 0;
  end;
  return int64(LBytes);
end;

// The export AName of the DLL ALibrary (a NUL-terminated UTF-8 file name, "kernel32.dll")
// when the process has it loaded (it is never loaded here); nil when it is not loaded, has
// no export of that name, or ALibrary is no valid UTF-8
public routine PlatformFindLoaded(const ALibrary: ptr to const char;
  const AName: ptr to const char): ptr;
var
  LWide: ptr to uint16;
  LModule: uint64;
begin
  LWide := DoWideOf(ALibrary);
  if LWide = nil then
    return nil;
  end;
  LModule := GetModuleHandleW(LWide);
  free(ptr(LWide));
  if LModule = 0 then
    return nil;
  end;
  return GetProcAddress(LModule, AName);
end;

// The C runtime's definition of the C name AName: the C runtime DLL's export of that name.
// The DLL is ucrtbase.dll (the one zig's windows-gnu C links against, Adam.Win64.Abi's
// CRuntimeFacts), loaded with every Adam exe, and looked in alone (another loaded DLL such
// as msvcrt.dll can export a name of another meaning); nil when it has none
public routine PlatformFindCRuntime(const AName: ptr to const char): ptr;
begin
  return PlatformFindLoaded(ptr to const char("ucrtbase.dll"), AName);
end;

// The calling thread's C errno (ucrtbase's: what C functions report)
public routine PlatformErrno(): int32;
var
  LAt: ptr to int32;
begin
  LAt := _errno();
  return LAt^;
end;

// The calling thread's C errno set to AValue
public routine PlatformSetErrno(const AValue: int32);
var
  LAt: ptr to int32;
begin
  LAt := _errno();
  LAt^ := AValue;
end;

// The run-time hooks (PlatformHookInstall / PlatformHookUninstall, PaskalCPP's HookABI run-time
// level): a hook writes its replacement into the import address table entry (the slot) of
// its C name in every loaded module, under VirtualProtect, records each slot and what it
// held, and puts exactly that back into every recorded slot whose module is still loaded.
// Modules loaded later are patched as they load, through the loader's DLL notification
// (which sees every load); unloads drop their slots. Calls that do not go through a slot
// (inside the defining module, a link-time hook's own symbol) are the link-time level's.

// The 16-bit value AOffset bytes past the address AAt (a loaded module's bytes, read where
// they lie)
routine DoHookRead16(const AAt: uint64; const AOffset: uint64): uint16;
var
  LAt: ptr to uint16;
begin
  LAt := ptr to uint16(AAt + AOffset);
  return LAt^;
end;

// The 32-bit value AOffset bytes past the address AAt
routine DoHookRead32(const AAt: uint64; const AOffset: uint64): uint32;
var
  LAt: ptr to uint32;
begin
  LAt := ptr to uint32(AAt + AOffset);
  return LAt^;
end;

// The 64-bit value AOffset bytes past the address AAt
routine DoHookRead64(const AAt: uint64; const AOffset: uint64): uint64;
var
  LAt: ptr to uint64;
begin
  LAt := ptr to uint64(AAt + AOffset);
  return LAt^;
end;

// The address of the import directory table of the PE32+ module loaded at ABase; 0 when it
// is no such module or imports nothing
routine DoHookImportTable(const ABase: uint64): uint64;
var
  LHeaders: uint64;
  LDirectory: uint64;
begin
  if ABase = 0 then
    return 0;
  end;
  if DoHookRead16(ABase, 0) <> ADAM_PLATFORM_DOS_MAGIC then
    return 0;
  end;
  LHeaders := ABase + uint64(DoHookRead32(ABase, ADAM_PLATFORM_SIGNATURE_POINTER_AT));
  if DoHookRead32(LHeaders, 0) <> ADAM_PLATFORM_PE_SIGNATURE then
    return 0;
  end;
  if DoHookRead16(LHeaders, ADAM_PLATFORM_OPTIONAL_AT) <> ADAM_PLATFORM_PE32PLUS then
    return 0;
  end;
  LDirectory := LHeaders + ADAM_PLATFORM_OPTIONAL_AT + ADAM_PLATFORM_DIRECTORIES_AT +
    (ADAM_PLATFORM_DIRECTORY_IMPORT * ADAM_PLATFORM_DIRECTORY_SIZE);
  if (DoHookRead32(LDirectory, 0) = 0) or
    (DoHookRead32(LDirectory, ADAM_PLATFORM_DIRECTORY_BYTES_AT) = 0) then
    return 0;
  end;
  return ABase + uint64(DoHookRead32(LDirectory, 0));
end;

// True when the lookup entry AEntry of the module loaded at ABase imports the C name AName
// by name (an import by ordinal names nothing)
routine DoHookNamedEntry(const ABase: uint64; const AEntry: uint64;
  const AName: ptr to const char): bool;
var
  LName: ptr to const char;
begin
  if (AEntry & ADAM_PLATFORM_IMPORT_BY_ORDINAL) <> 0 then
    return false;
  end;
  LName := ptr to const char(ABase + (AEntry & ADAM_PLATFORM_HINT_NAME_RVA) +
    ADAM_PLATFORM_HINT_SIZE);
  return strcmp(LName, AName) = 0;
end;

// The import slot number AIndex (from 0) of the C name AName in the module loaded at
// ABase, counted over every DLL it imports from; nil when it has fewer. A descriptor with
// no lookup table is skipped (its entries cannot be told apart). The module stays loaded
// meanwhile (pinned, or inside the loader's notification). Only the lookup tables are
// read, so a slot written never changes what a later call finds.
routine DoHookImportSlot(const ABase: uint64; const AName: ptr to const char;
  const AIndex: int64): ptr to uint64;
var
  LDescriptor: uint64;
  LLookup: uint64;
  LSlot: uint64;
  LEntry: uint64;
  LFound: int64;
begin
  LDescriptor := DoHookImportTable(ABase);
  if LDescriptor = 0 then
    return nil;
  end;
  LFound := 0;
  while DoHookRead32(LDescriptor, ADAM_PLATFORM_IMPORT_NAME_AT) <> 0 do
    if DoHookRead32(LDescriptor, ADAM_PLATFORM_IMPORT_LOOKUP_AT) <> 0 then
      LLookup := ABase + uint64(DoHookRead32(LDescriptor, ADAM_PLATFORM_IMPORT_LOOKUP_AT));
      LSlot := ABase + uint64(DoHookRead32(LDescriptor, ADAM_PLATFORM_IMPORT_ADDRESS_AT));
      LEntry := DoHookRead64(LLookup, 0);
      while LEntry <> 0 do
        if DoHookNamedEntry(ABase, LEntry, AName) then
          if LFound = AIndex then
            return ptr to uint64(LSlot);
          end;
          LFound := LFound + 1;
        end;
        LLookup := LLookup + ADAM_PLATFORM_THUNK_SIZE;
        LSlot := LSlot + ADAM_PLATFORM_THUNK_SIZE;
        LEntry := DoHookRead64(LLookup, 0);
      end;
    end;
    LDescriptor := LDescriptor + ADAM_PLATFORM_IMPORT_ENTRY_SIZE;
  end;
  return nil;
end;

// AValue stored in the import slot ASlot: its page made writable for the store, its
// protection put back after it (one aligned 8-byte store: a thread calling through the slot
// meanwhile reads the old or the new value, never a mix); false when the protection cannot
// be changed (nothing written then)
routine DoHookWriteSlot(const ASlot: ptr to uint64; const AValue: uint64): bool;
var
  LSlot: ptr to uint64;
  LOld: uint32;
  LUnused: uint32;
begin
  LSlot := ASlot;
  LOld := 0;
  LUnused := 0;
  if VirtualProtect(LSlot, ADAM_PLATFORM_ADDRESS_SIZE, ADAM_PLATFORM_PAGE_READWRITE, LOld) = 0 then
    return false;
  end;
  LSlot^ := AValue;
  VirtualProtect(LSlot, ADAM_PLATFORM_ADDRESS_SIZE, LOld, LUnused);
  return true;
end;

// Every loaded module's load address in load order, in a block malloc gave (the caller
// frees it), ACount of them; nil and 0 when they cannot be listed
routine DoHookModules(var ACount: int64): ptr to uint64;
var
  LModules: ptr to uint64;
  LRoom: int64;
  LNeeded: uint32;
  LTry: int64;
begin
  ACount := 0;
  LRoom := ADAM_PLATFORM_MODULES_FIRST;
  for LTry := 1 to ADAM_PLATFORM_MODULES_TRIES do
    LModules := ptr to uint64(malloc(uint64(LRoom) * ADAM_PLATFORM_ADDRESS_SIZE));
    if LModules = nil then
      return nil;
    end;
    LNeeded := 0;
    if K32EnumProcessModules(GetCurrentProcess(), LModules,
      uint32(uint64(LRoom) * ADAM_PLATFORM_ADDRESS_SIZE), LNeeded) = 0 then
      free(LModules);
      return nil;
    end;
    if uint64(LNeeded) <= (uint64(LRoom) * ADAM_PLATFORM_ADDRESS_SIZE) then
      ACount := int64(uint64(LNeeded) div ADAM_PLATFORM_ADDRESS_SIZE);
      return LModules;
    end;
    // More modules loaded meanwhile: room for them and a few more, then read again
    free(LModules);
    LRoom := int64(uint64(LNeeded) div ADAM_PLATFORM_ADDRESS_SIZE) + ADAM_PLATFORM_MODULES_EXTRA;
  end;
  return nil;
end;

// The module holding the address AAddress, its load count raised so it cannot unload until
// DoHookUnpin; 0 when no loaded module holds it
routine DoHookPin(const AAddress: uint64): uint64;
var
  LModule: uint64;
begin
  LModule := 0;
  if GetModuleHandleExW(ADAM_PLATFORM_MODULE_FROM_ADDRESS, ptr to uint8(AAddress), LModule) = 0 then
    return 0;
  end;
  return LModule;
end;

// The load count DoHookPin raised lowered again (nothing for 0)
routine DoHookUnpin(const AModule: uint64);
begin
  if AModule <> 0 then
    FreeLibrary(AModule);
  end;
end;

// Where the hook AEntry recorded the slot at the address ASlot; -1 when it did not
routine DoHookSlotIndex(const AEntry: ptr to PlatformHookEntry; const ASlot: uint64): int64;
var
  LI: int64;
begin
  for LI := 0 to AEntry->SlotCount - 1 do
    if uint64(AEntry->Slots[LI].Address) = ASlot then
      return LI;
    end;
  end;
  return -1;
end;

// The slot ASlot (holding AOld, in the module loaded at ABase) recorded in the hook AEntry;
// false when its list cannot grow (nothing recorded then)
routine DoHookAddSlot(const AEntry: ptr to PlatformHookEntry; const ASlot: ptr to uint64;
  const AOld: uint64; const ABase: uint64): bool;
var
  LEntry: ptr to PlatformHookEntry;
  LRoom: int64;
  LSlots: ptr to PlatformHookSlot;
  LAt: int64;
begin
  LEntry := AEntry;
  if LEntry->SlotCount = LEntry->SlotCapacity then
    LRoom := (LEntry->SlotCapacity * 2) + 4;
    LSlots := ptr to PlatformHookSlot(realloc(LEntry->Slots,
      uint64(LRoom) * uint64(size(PlatformHookSlot))));
    if LSlots = nil then
      return false;
    end;
    LEntry->Slots := LSlots;
    LEntry->SlotCapacity := LRoom;
  end;
  LAt := LEntry->SlotCount;
  LEntry->Slots[LAt].Address := ASlot;
  LEntry->Slots[LAt].Old := AOld;
  LEntry->Slots[LAt].Base := ABase;
  LEntry->SlotCount := LAt + 1;
  return true;
end;

// The slot number AIndex of the hook AEntry dropped from its record (the others keep their
// order)
routine DoHookDropSlot(const AEntry: ptr to PlatformHookEntry; const AIndex: int64);
var
  LEntry: ptr to PlatformHookEntry;
  LI: int64;
begin
  LEntry := AEntry;
  for LI := AIndex to LEntry->SlotCount - 2 do
    LEntry->Slots[LI] := LEntry->Slots[LI + 1];
  end;
  LEntry->SlotCount := LEntry->SlotCount - 1;
end;

// Every slot of the hook AEntry in the module loaded at ABase dropped (the module is
// unloading)
routine DoHookDropModule(const AEntry: ptr to PlatformHookEntry; const ABase: uint64);
var
  LI: int64;
begin
  LI := 0;
  while LI < AEntry->SlotCount do
    if AEntry->Slots[LI].Base = ABase then
      DoHookDropSlot(AEntry, LI);
    else
      LI := LI + 1;
    end;
  end;
end;

// Every slot of the hook AEntry's name in the module loaded at ABase not yet recorded:
// recorded, then written with the replacement. The caller holds the table lock and keeps
// the module loaded. 0, or ENOMEM when a slot could not be recorded, EACCES when one could
// not be written (that slot left as it was, unrecorded)
routine DoHookPatchModule(const AEntry: ptr to PlatformHookEntry; const ABase: uint64): int32;
var
  LIndex: int64;
  LSlot: ptr to uint64;
begin
  if AEntry->Removing then
    return 0;
  end;
  LIndex := 0;
  LSlot := DoHookImportSlot(ABase, AEntry->Name, LIndex);
  while LSlot <> nil do
    if DoHookSlotIndex(AEntry, uint64(LSlot)) < 0 then
      if not DoHookAddSlot(AEntry, LSlot, LSlot^, ABase) then
        return ADAM_PLATFORM_ENOMEM;
      end;
      if not DoHookWriteSlot(LSlot, AEntry->Replacement) then
        DoHookDropSlot(AEntry, AEntry->SlotCount - 1);
        return ADAM_PLATFORM_EACCES;
      end;
    end;
    LIndex := LIndex + 1;
    LSlot := DoHookImportSlot(ABase, AEntry->Name, LIndex);
  end;
  return 0;
end;

// The hook AEntry written into every loaded module, each pinned meanwhile: 0, or ENOMEM /
// EACCES when a slot could not be recorded / written (the ones that were stay recorded)
routine DoHookApply(const AEntry: ptr to PlatformHookEntry): int32;
var
  LModules: ptr to uint64;
  LCount: int64;
  LI: int64;
  LModule: uint64;
  LCode: int32;
begin
  LModules := DoHookModules(LCount);
  LCode := 0;
  LI := 0;
  while (LCode = 0) and (LI < LCount) do
    LModule := DoHookPin(LModules[LI]);
    if LModule <> 0 then
      AcquireSRWLockExclusive(GHookTableLock);
      LCode := DoHookPatchModule(AEntry, LModule);
      ReleaseSRWLockExclusive(GHookTableLock);
      DoHookUnpin(LModule);
    end;
    LI := LI + 1;
  end;
  free(LModules);
  return LCode;
end;

// The slot at the address ASlot of the hook AEntry: dropped when its module is gone (or
// another module took its place); with ARestore written back first and dropped once it
// is back. Its module is pinned meanwhile, and the slot looked up again once it is (a
// module that unloaded meanwhile had its slots dropped by the notification).
routine DoHookVisitSlot(const AEntry: ptr to PlatformHookEntry; const ASlot: uint64;
  const ARestore: bool);
var
  LModule: uint64;
  LAt: int64;
begin
  LModule := DoHookPin(ASlot);
  AcquireSRWLockExclusive(GHookTableLock);
  LAt := DoHookSlotIndex(AEntry, ASlot);
  if LAt >= 0 then
    if (LModule = 0) or (LModule <> AEntry->Slots[LAt].Base) then
      DoHookDropSlot(AEntry, LAt);
    else
      if ARestore and DoHookWriteSlot(AEntry->Slots[LAt].Address, AEntry->Slots[LAt].Old) then
        DoHookDropSlot(AEntry, LAt);
      end;
    end;
  end;
  ReleaseSRWLockExclusive(GHookTableLock);
  DoHookUnpin(LModule);
end;

// Every slot of the hook AEntry visited (DoHookVisitSlot): 0 when none is left (without
// ARestore: always), EACCES when one could not go back, ENOMEM when they could not be
// listed. The caller holds the run lock, not the table lock.
routine DoHookVisitSlots(const AEntry: ptr to PlatformHookEntry; const ARestore: bool): int32;
var
  LSlots: ptr to uint64;
  LCount: int64;
  LI: int64;
  LLeft: int64;
begin
  // The addresses first: a visit drops slots from the record as it goes
  AcquireSRWLockExclusive(GHookTableLock);
  LCount := AEntry->SlotCount;
  LSlots := ptr to uint64(malloc((uint64(LCount) + 1) * ADAM_PLATFORM_ADDRESS_SIZE));
  if LSlots <> nil then
    for LI := 0 to LCount - 1 do
      LSlots[LI] := uint64(AEntry->Slots[LI].Address);
    end;
  end;
  ReleaseSRWLockExclusive(GHookTableLock);
  if LSlots = nil then
    return ADAM_PLATFORM_ENOMEM;
  end;
  for LI := 0 to LCount - 1 do
    DoHookVisitSlot(AEntry, LSlots[LI], ARestore);
  end;
  free(LSlots);
  AcquireSRWLockExclusive(GHookTableLock);
  LLeft := AEntry->SlotCount;
  ReleaseSRWLockExclusive(GHookTableLock);
  if ARestore and (LLeft > 0) then
    return ADAM_PLATFORM_EACCES;
  end;
  return 0;
end;

// What the C name AName's slots reach: the value of its first import slot in load order;
// when no module imports it yet, the first module's export of it; 0 when none has it
routine DoHookOriginal(const AName: ptr to const char): uint64;
var
  LModules: ptr to uint64;
  LCount: int64;
  LI: int64;
  LModule: uint64;
  LSlot: ptr to uint64;
  LFound: uint64;
begin
  LModules := DoHookModules(LCount);
  LFound := 0;
  LI := 0;
  while (LFound = 0) and (LI < LCount) do
    LModule := DoHookPin(LModules[LI]);
    if LModule <> 0 then
      LSlot := DoHookImportSlot(LModule, AName, 0);
      if LSlot <> nil then
        LFound := LSlot^;
      end;
      DoHookUnpin(LModule);
    end;
    LI := LI + 1;
  end;
  LI := 0;
  while (LFound = 0) and (LI < LCount) do
    LFound := uint64(GetProcAddress(LModules[LI], AName));
    LI := LI + 1;
  end;
  free(LModules);
  return LFound;
end;

// The loader's DLL notification: a module being loaded gets every hook written into it (it
// cannot unload while the loader holds its lock), one unloading has its slots dropped. Only
// the module it names is touched: none is listed, pinned or freed here, and the run lock is
// never taken (an install holds it while the loader's lock is taken).
routine DoHookNotification(const AReason: uint32; const AData: ptr; const AContext: ptr);
var
  LBase: uint64;
  LI: int64;
  LEntry: ptr to PlatformHookEntry;
begin
  if (GHookEntryCount = 0) or (AData = nil) then
    return;
  end;
  LBase := DoHookRead64(uint64(AData), ADAM_PLATFORM_DLL_BASE_AT);
  if LBase = 0 then
    return;
  end;
  AcquireSRWLockExclusive(GHookTableLock);
  for LI := 0 to GHookEntryCount - 1 do
    LEntry := ptr to PlatformHookEntry(GHookEntries[LI]);
    // A slot that cannot be recorded or written keeps the loader's value
    if AReason = ADAM_PLATFORM_DLL_LOADED then
      DoHookPatchModule(LEntry, LBase);
    end;
    if AReason = ADAM_PLATFORM_DLL_UNLOADED then
      DoHookDropModule(LEntry, LBase);
    end;
  end;
  ReleaseSRWLockExclusive(GHookTableLock);
end;

// The loader's DLL notification registered once (the first install): true when it is in
// place; false leaves a hook to patch only the modules loaded now. The caller holds the run
// lock.
routine DoHookEnsureNotification(): bool;
begin
  if GHookNotified then
    return true;
  end;
  if LdrRegisterDllNotification(0, DoHookNotification, nil, GHookCookie) <> 0 then
    return false;
  end;
  GHookNotified := true;
  return true;
end;

// Where the hook whose record is at the address AEntry is among the hooks; -1 when it is
// not one (the caller holds the table lock)
routine DoHookEntryIndex(const AEntry: uint64): int64;
var
  LI: int64;
begin
  for LI := 0 to GHookEntryCount - 1 do
    if GHookEntries[LI] = AEntry then
      return LI;
    end;
  end;
  return -1;
end;

// Where the hook of the C name AName is among the hooks; -1 when none has it (the caller
// holds the table lock)
routine DoHookNameIndex(const AName: ptr to const char): int64;
var
  LI: int64;
  LEntry: ptr to PlatformHookEntry;
begin
  for LI := 0 to GHookEntryCount - 1 do
    LEntry := ptr to PlatformHookEntry(GHookEntries[LI]);
    if strcmp(LEntry->Name, AName) = 0 then
      return LI;
    end;
  end;
  return -1;
end;

// The hook AEntry added to the hooks; false when their list cannot grow (the caller holds
// the table lock)
routine DoHookJoin(const AEntry: ptr to PlatformHookEntry): bool;
var
  LRoom: int64;
  LEntries: ptr to uint64;
begin
  if GHookEntryCount = GHookEntryCapacity then
    LRoom := (GHookEntryCapacity * 2) + 4;
    LEntries := ptr to uint64(realloc(GHookEntries, uint64(LRoom) * ADAM_PLATFORM_ADDRESS_SIZE));
    if LEntries = nil then
      return false;
    end;
    GHookEntries := LEntries;
    GHookEntryCapacity := LRoom;
  end;
  GHookEntries[GHookEntryCount] := uint64(AEntry);
  GHookEntryCount := GHookEntryCount + 1;
  return true;
end;

// The hook AEntry taken out of the hooks (the others keep their order; the caller holds the
// table lock)
routine DoHookLeave(const AEntry: ptr to PlatformHookEntry);
var
  LAt: int64;
  LI: int64;
begin
  LAt := DoHookEntryIndex(uint64(AEntry));
  if LAt < 0 then
    return;
  end;
  for LI := LAt to GHookEntryCount - 2 do
    GHookEntries[LI] := GHookEntries[LI + 1];
  end;
  GHookEntryCount := GHookEntryCount - 1;
end;

// A new hook record of the C name AName (copied) and AReplacement, with no slot; nil when
// out of memory
routine DoHookNewEntry(const AName: ptr to const char; const AReplacement: ptr): ptr to PlatformHookEntry;
var
  LLength: int64;
  LName: ptr to char;
  LI: int64;
  LEntry: ptr to PlatformHookEntry;
begin
  LLength := int64(strlen(AName));
  LName := ptr to char(malloc(uint64(LLength) + 1));
  if LName = nil then
    return nil;
  end;
  // The name's bytes and its NUL
  for LI := 0 to LLength do
    LName[LI] := AName[LI];
  end;
  LEntry := ptr to PlatformHookEntry(malloc(uint64(size(PlatformHookEntry))));
  if LEntry = nil then
    free(LName);
    return nil;
  end;
  LEntry->Name := LName;
  LEntry->Replacement := uint64(AReplacement);
  LEntry->Slots := nil;
  LEntry->SlotCount := 0;
  LEntry->SlotCapacity := 0;
  LEntry->Removing := false;
  return LEntry;
end;

// The hook record AEntry freed with its name and its slot list
routine DoHookFreeEntry(const AEntry: ptr to PlatformHookEntry);
begin
  free(AEntry->Name);
  free(AEntry->Slots);
  free(AEntry);
end;

// The hook AEntry, which could not be written everywhere, undone: every slot it wrote put
// back (what cannot go back keeps the replacement), taken out of the hooks and freed. The
// caller holds the run lock.
routine DoHookAbandon(const AEntry: ptr to PlatformHookEntry);
var
  LEntry: ptr to PlatformHookEntry;
begin
  LEntry := AEntry;
  AcquireSRWLockExclusive(GHookTableLock);
  LEntry->Removing := true;
  ReleaseSRWLockExclusive(GHookTableLock);
  DoHookVisitSlots(LEntry, true);
  AcquireSRWLockExclusive(GHookTableLock);
  DoHookLeave(LEntry);
  ReleaseSRWLockExclusive(GHookTableLock);
  DoHookFreeEntry(LEntry);
end;

// PlatformHookInstall's work under the run lock: AOriginal and AEntry set when it returns 0
routine DoHookInstallLocked(const AName: ptr to const char; const AReplacement: ptr;
  var AOriginal: uint64; var AEntry: ptr to PlatformHookEntry): int32;
var
  LFound: int64;
  LJoined: bool;
  LCode: int32;
begin
  AcquireSRWLockExclusive(GHookTableLock);
  LFound := DoHookNameIndex(AName);
  ReleaseSRWLockExclusive(GHookTableLock);
  if LFound >= 0 then
    return ADAM_PLATFORM_EEXIST;
  end;
  AOriginal := DoHookOriginal(AName);
  if AOriginal = 0 then
    return ADAM_PLATFORM_ENOENT;
  end;
  // The notification is in place before the hook joins: a DLL loaded after it joins is
  // patched only by the notification
  DoHookEnsureNotification();
  AEntry := DoHookNewEntry(AName, AReplacement);
  if AEntry = nil then
    return ADAM_PLATFORM_ENOMEM;
  end;
  // Joined before the apply, so a module loaded during it is patched by the notification
  // with this hook, never missed
  AcquireSRWLockExclusive(GHookTableLock);
  LJoined := DoHookJoin(AEntry);
  ReleaseSRWLockExclusive(GHookTableLock);
  if not LJoined then
    DoHookFreeEntry(AEntry);
    AEntry := nil;
    return ADAM_PLATFORM_ENOMEM;
  end;
  LCode := DoHookApply(AEntry);
  if LCode <> 0 then
    DoHookAbandon(AEntry);
    AEntry := nil;
  end;
  return LCode;
end;

// A run-time hook installed (System.Runtime's InstallHook): the C name AName's import slot
// in every loaded module takes AReplacement, and so does every module loaded later. 0 with
// AOriginal (what the slots reached) and AState (the hook's record) set; else C's errno
// value of the failure, nothing installed: EINVAL (nil or empty AName, nil AReplacement),
// EEXIST (AState is set, or AName is hooked already), ENOENT (no loaded module imports or
// exports AName), EACCES (a slot could not be written: every slot written is put back),
// ENOMEM. Installs and uninstalls run one at a time.
public routine PlatformHookInstall(const AName: ptr to const char; const AReplacement: ptr;
  var AOriginal: ptr; var AState: ptr): int32;
var
  LOriginal: uint64;
  LEntry: ptr to PlatformHookEntry;
  LCode: int32;
begin
  if (AName = nil) or (AReplacement = nil) then
    return ADAM_PLATFORM_EINVAL;
  end;
  if strlen(AName) = 0 then
    return ADAM_PLATFORM_EINVAL;
  end;
  if AState <> nil then
    return ADAM_PLATFORM_EEXIST;
  end;
  LOriginal := 0;
  LEntry := nil;
  AcquireSRWLockExclusive(GHookRunLock);
  LCode := DoHookInstallLocked(AName, AReplacement, LOriginal, LEntry);
  ReleaseSRWLockExclusive(GHookRunLock);
  if LCode <> 0 then
    return LCode;
  end;
  AOriginal := ptr to uint8(LOriginal);
  AState := LEntry;
  return 0;
end;

// PlatformHookUninstall's work under the run lock
routine DoHookUninstallLocked(const AState: ptr): int32;
var
  LEntry: ptr to PlatformHookEntry;
  LCode: int32;
begin
  LEntry := nil;
  AcquireSRWLockExclusive(GHookTableLock);
  if DoHookEntryIndex(uint64(AState)) >= 0 then
    LEntry := ptr to PlatformHookEntry(AState);
    // Removing: a module loaded now is not patched with it while its slots go back
    LEntry->Removing := true;
  end;
  ReleaseSRWLockExclusive(GHookTableLock);
  if LEntry = nil then
    return ADAM_PLATFORM_EINVAL;
  end;
  LCode := DoHookVisitSlots(LEntry, true);
  if LCode <> 0 then
    // Still installed: a later uninstall (or this one again) finishes it
    AcquireSRWLockExclusive(GHookTableLock);
    LEntry->Removing := false;
    ReleaseSRWLockExclusive(GHookTableLock);
    return LCode;
  end;
  AcquireSRWLockExclusive(GHookTableLock);
  DoHookLeave(LEntry);
  ReleaseSRWLockExclusive(GHookTableLock);
  DoHookFreeEntry(LEntry);
  return 0;
end;

// A run-time hook uninstalled (System.Runtime's UninstallHook): every slot it wrote whose
// module is still loaded gets back exactly what it held; nothing else is written. 0 with
// AState nil; else C's errno value: EINVAL (AState is no installed hook), EACCES (a slot
// could not be written back: the hook stays installed, the slots that went back stay back),
// ENOMEM
public routine PlatformHookUninstall(var AState: ptr): int32;
var
  LCode: int32;
begin
  if AState = nil then
    return ADAM_PLATFORM_EINVAL;
  end;
  AcquireSRWLockExclusive(GHookRunLock);
  LCode := DoHookUninstallLocked(AState);
  ReleaseSRWLockExclusive(GHookRunLock);
  if LCode = 0 then
    AState := nil;
  end;
  return LCode;
end;

end.
