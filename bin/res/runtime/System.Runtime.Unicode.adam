// The extended grapheme cluster break property of the code point ACode (ADAM_UNICODE_GCB_*):
// libc++'s __get_property
public func GraphemeProperty(const ACode: uint32): int64;
var
  LKey: uint32;
  LLow: int64;
  LHigh: int64;
  LMiddle: int64;
  LEntry: uint32;
begin
  LKey := (ACode shl 11) | 0x7FF;
  LLow := 0;
  LHigh := 1501;
  while LLow < LHigh do
    LMiddle := (LLow + LHigh) div 2;
    if ADAM_UNICODE_GRAPHEME_ENTRIES[LMiddle] <= LKey then
      LLow := LMiddle + 1;
    else
      LHigh := LMiddle;
    end;
  end;
  if LLow = 0 then
    return ADAM_UNICODE_GCB_NONE;
  end;
  LEntry := ADAM_UNICODE_GRAPHEME_ENTRIES[LLow - 1];
  // the range's upper bound: its lower bound plus its size
  if ACode <= (LEntry shr 11) + ((LEntry shr 4) & 0x7F) then
    return int64(LEntry & 0xF);
  end;
  return ADAM_UNICODE_GCB_NONE;
end;

// The indic conjunct break property of the code point ACode (ADAM_UNICODE_INCB_*):
// libc++'s __get_property
public func IndicProperty(const ACode: uint32): int64;
var
  LKey: uint32;
  LLow: int64;
  LHigh: int64;
  LMiddle: int64;
  LEntry: uint32;
begin
  LKey := (ACode shl 11) | 0x7FF;
  LLow := 0;
  LHigh := 403;
  while LLow < LHigh do
    LMiddle := (LLow + LHigh) div 2;
    if ADAM_UNICODE_INDIC_ENTRIES[LMiddle] <= LKey then
      LLow := LMiddle + 1;
    else
      LHigh := LMiddle;
    end;
  end;
  if LLow = 0 then
    return ADAM_UNICODE_INCB_NONE;
  end;
  LEntry := ADAM_UNICODE_INDIC_ENTRIES[LLow - 1];
  // the range's upper bound: its lower bound plus its size
  if ACode <= (LEntry shr 11) + ((LEntry shr 2) & 0x1FF) then
    return int64(LEntry & 0x3);
  end;
  return ADAM_UNICODE_INCB_NONE;
end;

// The columns the code point ACode is estimated to take (1 or 2): libc++'s
// __estimated_width; past ADAM_UNICODE_WIDTH_UPPER always 1
public func EstimatedWidth(const ACode: uint32): int64;
var
  LKey: uint32;
  LLow: int64;
  LHigh: int64;
  LMiddle: int64;
  LEntry: uint32;
begin
  if ACode > ADAM_UNICODE_WIDTH_UPPER then
    return 1;
  end;
  if ACode < (ADAM_UNICODE_WIDTH_ENTRIES[0] shr 14) then
    return 1;
  end;
  LKey := (ACode shl 14) | 0x3FFF;
  LLow := 0;
  LHigh := 110;
  while LLow < LHigh do
    LMiddle := (LLow + LHigh) div 2;
    if ADAM_UNICODE_WIDTH_ENTRIES[LMiddle] <= LKey then
      LLow := LMiddle + 1;
    else
      LHigh := LMiddle;
    end;
  end;
  if LLow = 0 then
    return 1;
  end;
  LEntry := ADAM_UNICODE_WIDTH_ENTRIES[LLow - 1];
  if ACode <= (LEntry shr 14) + (LEntry & 0x3FFF) then
    return 2;
  end;
  return 1;
end;

// True when the code point ACode is one the debug form writes as \u{...}: its
// General_Category is a Separator or an Other (libc++'s __needs_escape; the gap
// ADAM_UNICODE_ESCAPE_GAP_* never, from ADAM_UNICODE_ESCAPE_END always)
public func NeedsEscape(const ACode: uint32): bool;
var
  LKey: uint32;
  LLow: int64;
  LHigh: int64;
  LMiddle: int64;
  LEntry: uint32;
begin
  if (ACode >= ADAM_UNICODE_ESCAPE_GAP_FIRST) and (ACode <= ADAM_UNICODE_ESCAPE_GAP_LAST) then
    return false;
  end;
  if ACode >= ADAM_UNICODE_ESCAPE_END then
    return true;
  end;
  LKey := (ACode shl 14) | 0x3FFF;
  LLow := 0;
  LHigh := 735;
  while LLow < LHigh do
    LMiddle := (LLow + LHigh) div 2;
    if ADAM_UNICODE_ESCAPE_ENTRIES[LMiddle] <= LKey then
      LLow := LMiddle + 1;
    else
      LHigh := LMiddle;
    end;
  end;
  if LLow = 0 then
    return false;
  end;
  LEntry := ADAM_UNICODE_ESCAPE_ENTRIES[LLow - 1];
  return ACode <= (LEntry shr 14) + (LEntry & 0x3FFF);
end;

