-------------------------------------------------------------------------------
  System.Runtime.LibC.adam - The pure C routines the runtime calls (a block
  of bytes copied or filled, two C strings compared, a C string's length):
  libc.a's (res/libs/vendor/<triple>/libc.a, Adam's own C library: upstream
  musl built by AdamLang-Libs with the same flags for every target), never
  a platform C runtime's, so every image binds them there: the runtime's
  calls, its platform unit's, System.LibC.C's and a linked vendor
  library's alike (one definition of each name in a link). What is
  OS-facing or keeps state (malloc / free, FILE stdio, errno, exit) stays
  the platform unit's, over the platform's own C runtime.
  The same on every target; imports nothing. The runtime's platform units
  import it (System.Runtime.Win64; System.Runtime.Linux64 next).
*******************************************************************************/

module unit System.Runtime.LibC;

// libc.a: ACount bytes copied from ASource to ADest (no overlap) / set to AValue's low byte
public routine memcpy(const ADest: ptr; const ASource: ptr; const ACount: uint64): ptr; external "c";
public routine memset(const ADest: ptr; const AValue: int32; const ACount: uint64): ptr; external "c";

// libc.a: two C strings compared (0 when equal, else the sign of the first byte that
// differs, as unsigned char), a C string's length (its NUL not counted)
public routine strcmp(const ALeft: ptr to const char; const ARight: ptr to const char): int32;
  external "c";
public routine strlen(const AText: ptr to const char): uint64; external "c";

end.
